fn WebSceneHexDigitValue(ch: char, out: var int32): bool =
    out = 0
    if ch >= '0' && ch <= '9':
        out = int32(ch) - int32('0')
        return true
    if ch >= 'A' && ch <= 'F':
        out = int32(ch) - int32('A') + 10
        return true
    if ch >= 'a' && ch <= 'f':
        out = int32(ch) - int32('a') + 10
        return true
    return false

@borrows
fn WebSceneParseArgbColor(value: str, out: var int64): bool =
    return WebSceneParseArgbColorRange(value, 0, value.len, out)

@borrows
fn WebSceneParseArgbColorRange(value: str,
                               start: int32,
                               endExclusive: int32,
                               out: var int64): bool =
    out = int64(0)
    if start < 0 || endExclusive > value.len:
        return false
    if endExclusive - start != 10:
        return false
    if value[start] != '0':
        return false
    if value[start + 1] != 'x' && value[start + 1] != 'X':
        return false
    var acc: int64 = int64(0)
    for i in start + 2..<endExclusive:
        var digit: int32
        if !WebSceneHexDigitValue(value[i], digit):
            return false
        acc = acc * int64(16) + int64(digit)
    out = acc
    return true

@borrows
fn WebSceneParseCssNumberPermilleRange(value: str, start: int32, endExclusive: int32, out: var int32): bool =
    out = 0
    if start < 0 || endExclusive <= start || endExclusive > value.len:
        return false
    var sign: int32 = 1
    var index: int32 = start
    if value[index] == '-':
        sign = -1
        index = start + 1
        if index >= endExclusive:
            return false
    var whole: int32
    var wholeDigits: int32
    while index < endExclusive && value[index] >= '0' && value[index] <= '9':
        whole = whole * 10 + (int32(value[index]) - int32('0'))
        wholeDigits = wholeDigits + 1
        index = index + 1
    var frac: int32
    var fracScale: int32 = 1
    if index < endExclusive && value[index] == '.':
        index = index + 1
        var fracDigits: int32
        while index < endExclusive && value[index] >= '0' && value[index] <= '9':
            if fracDigits < 3:
                frac = frac * 10 + (int32(value[index]) - int32('0'))
                fracScale = fracScale * 10
            fracDigits = fracDigits + 1
            index = index + 1
        if fracDigits == 0:
            return false
    if index != endExclusive:
        return false
    if wholeDigits == 0:
        return false
    while fracScale < 1000:
        frac = frac * 10
        fracScale = fracScale * 10
    out = sign * (whole * 1000 + frac)
    return true

@borrows
fn WebSceneParseCssNumberPermille(value: str, out: var int32): bool =
    return WebSceneParseCssNumberPermilleRange(value, 0, value.len, out)

@borrows
fn WebSceneParseCssPxMilli(value: str, out: var int32): bool =
    out = 0
    if value.len < 3:
        return false
    if value[value.len - 2] != 'p' || value[value.len - 1] != 'x':
        return false
    return WebSceneParseCssNumberPermilleRange(value, 0, value.len - 2, out)

fn WebSceneRoundMilliToPx(value: int32): int32 =
    if value >= 0:
        return (value + 500) / 1000
    return -((-value + 500) / 1000)

fn WebSceneRoundPercentPermilleToPx(basePx: int32, percentPermille: int32): int32 =
    let numerator = int64(basePx) * int64(percentPermille)
    if numerator >= int64(0):
        return Int32((numerator + int64(50000)) / int64(100000))
    return -Int32(((-numerator) + int64(50000)) / int64(100000))

@borrows
fn WebSceneParseCssOpacity(value: str, out: var int32): bool =
    out = 255
    var permille: int32
    if !WebSceneParseCssNumberPermille(value, permille):
        return false
    if permille < 0 || permille > 1000:
        return false
    out = (permille * 255 + 500) / 1000
    return true

fn WebSceneApplyOpacityToColor(color: int64, opacity: int32): int64 =
    var alpha: int32 = Int32((color / int64(16777216)) % int64(256))
    var rgb: int64 = color % int64(16777216)
    if alpha < 0:
        alpha = alpha + 256
    if rgb < int64(0):
        rgb = rgb + int64(16777216)
    var clamped = opacity
    if clamped < 0:
        clamped = 0
    if clamped > 255:
        clamped = 255
    let nextAlpha = (alpha * clamped + 127) / 255
    return int64(nextAlpha) * int64(16777216) + rgb

@borrows
fn WebSceneNodePropMatches(graph: var WebSceneGraph,
                           routeIndex: int32,
                           nodeId: int32,
                           propName: str,
                           propValue: str): bool =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           graph.props[i].propName == propName:
            if propValue.len == 0:
                return true
            if graph.props[i].propValue == propValue:
                return true
            return false
    return false

@borrows
fn WebSceneNodeHasNonEmptyProp(graph: var WebSceneGraph,
                               routeIndex: int32,
                               nodeId: int32,
                               propName: str): bool =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           graph.props[i].propName == propName &&
           graph.props[i].propValue.len > 0:
            return true
    return false

@borrows
fn WebSceneFindNodePropIndexByName(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   propName: str): int32 =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           graph.props[i].propName == propName:
            return i
    return -1

@borrows
fn WebSceneSetNodePropValue(graph: var WebSceneGraph,
                            routeIndex: int32,
                            nodeId: int32,
                            propName: str,
                            propValue: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if propName.len == 0:
        return false
    let propIndex = WebSceneFindNodePropIndexByName(graph, routeIndex, nodeId, propName)
    if propIndex >= 0:
        graph.props[propIndex].propValue = propValue
        return true
    var ordinal: int32
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           graph.props[i].ordinal >= ordinal:
            ordinal = graph.props[i].ordinal + 1
    var prop: WebSceneProp
    prop.routeIndex = routeIndex
    prop.nodeId = nodeId
    prop.ordinal = ordinal
    prop.propName = propName
    prop.propValue = propValue
    prop.valueKind = "string"
    add(graph.props, prop)
    return true

@borrows
fn WebSceneApplyTextControlPaintValue(graph: var WebSceneGraph,
                                      routeIndex: int32,
                                      nodeId: int32,
                                      value: str): bool =
    let placeholder = WebSceneNodePropValue(graph, routeIndex, nodeId, "placeholder")
    var touched = false
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex &&
           graph.paintOps[i].nodeId == nodeId &&
           (graph.paintOps[i].opKind == WebScenePaintPlaceholderText || graph.paintOps[i].opKind == WebScenePaintText):
            if value.len > 0:
                graph.paintOps[i].opKind = WebScenePaintText
                graph.paintOps[i].textContent = WebSceneCloneStateString(value)
            else:
                graph.paintOps[i].opKind = WebScenePaintPlaceholderText
                graph.paintOps[i].textContent = WebSceneCloneStateString(placeholder)
            touched = true
    if touched:
        # textContent changed in place: cached command spans for this route now
        # encode the old text, so they must be dropped by the same hand
        if !WebSceneInvalidateLayerCachesForRoute(graph, routeIndex):
            return false
        return true
    if value.len == 0:
        return true
    return false

fn WebScenePaintKindIsText(opKind: int32): bool =
    if opKind == WebScenePaintText:
        return true
    if opKind == WebScenePaintPlaceholderText:
        return true
    return false

@borrows
fn WebSceneTextPaintOpEligibleForGlyphAtlas(graph: var WebSceneGraph, sceneOp: WebScenePaintOp): bool =
    if !WebScenePaintKindIsText(sceneOp.opKind):
        return false
    if sceneOp.textContent.len == 0:
        return false
    if WebSceneNodeHiddenByNonRenderedContent(graph, sceneOp.routeIndex, sceneOp.nodeId):
        return false
    if WebSceneNodeHiddenByDisplayNone(graph, sceneOp.routeIndex, sceneOp.nodeId):
        return false
    return true

@borrows
fn WebScenePaintOpRuntimeVisible(graph: var WebSceneGraph, sceneOp: WebScenePaintOp): bool =
    if WebSceneNodeHiddenByNonRenderedContent(graph, sceneOp.routeIndex, sceneOp.nodeId):
        return false
    if WebSceneNodeHiddenByDisplayNone(graph, sceneOp.routeIndex, sceneOp.nodeId):
        return false
    if sceneOp.opKind == WebScenePaintPlaceholderText:
        return WebSceneNodePlaceholderVisible(graph, sceneOp.routeIndex, sceneOp.nodeId)
    return true

fn WebSceneNodePlaceholderVisible(graph: var WebSceneGraph,
                                  routeIndex: int32,
                                  nodeId: int32): bool =
    if !WebSceneNodePropMatches(graph, routeIndex, nodeId, "placeholder", ""):
        return false
    if WebSceneNodeHasNonEmptyProp(graph, routeIndex, nodeId, "value"):
        return false
    if WebSceneNodeHasNonEmptyProp(graph, routeIndex, nodeId, "defaultValue"):
        return false
    return true

@borrows
fn WebSceneClassTokenCharEquals(value: str, start: int32, endExclusive: int32, token: str): bool =
    if start < 0 || endExclusive < start || endExclusive > value.len:
        return false
    if token.len != endExclusive - start:
        return false
    for i in 0..<token.len:
        if value[start + i] != token[i]:
            return false
    return true

@borrows
fn WebSceneClassTokenRangeIsNamedVariant(value: str,
                                         start: int32,
                                         endExclusive: int32,
                                         prefix: str,
                                         modifier: str): bool =
    if start < 0 || endExclusive < start || endExclusive > value.len:
        return false
    if modifier.len == 0:
        return WebSceneClassTokenCharEquals(value, start, endExclusive, prefix)
    let expectedLen = prefix.len + 1 + modifier.len
    if endExclusive - start != expectedLen:
        return false
    for i in 0..<prefix.len:
        if value[start + i] != prefix[i]:
            return false
    if value[start + prefix.len] != '/':
        return false
    for i in 0..<modifier.len:
        if value[start + prefix.len + 1 + i] != modifier[i]:
            return false
    return true

@borrows
fn WebSceneClassValueHasToken(value: str, token: str): bool =
    if token.len == 0:
        return false
    var start: int32
    while start < value.len:
        while start < value.len && (value[start] == ' ' || value[start] == '\n' || value[start] == '\t'):
            start = start + 1
        if start >= value.len:
            return false
        var endIndex = start
        while endIndex < value.len && value[endIndex] != ' ' && value[endIndex] != '\n' && value[endIndex] != '\t':
            endIndex = endIndex + 1
        if WebSceneClassTokenCharEquals(value, start, endIndex, token):
            return true
        start = endIndex + 1
    return false

@borrows
fn WebSceneClassValueHasNamedVariant(value: str, prefix: str, modifier: str): bool =
    var start: int32
    while start < value.len:
        while start < value.len && (value[start] == ' ' || value[start] == '\n' || value[start] == '\t'):
            start = start + 1
        if start >= value.len:
            return false
        var endIndex = start
        while endIndex < value.len && value[endIndex] != ' ' && value[endIndex] != '\n' && value[endIndex] != '\t':
            endIndex = endIndex + 1
        if WebSceneClassTokenRangeIsNamedVariant(value, start, endIndex, prefix, modifier):
            return true
        start = endIndex + 1
    return false

@borrows
fn WebSceneNodeHasClassToken(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, token: str): bool =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           (graph.props[i].propName == "className" || graph.props[i].propName == "class"):
            if WebSceneClassValueHasToken(graph.props[i].propValue, token):
                return true
    return false

@borrows
fn WebSceneNodeHasNamedClassVariant(graph: var WebSceneGraph,
                                    routeIndex: int32,
                                    nodeId: int32,
                                    prefix: str,
                                    modifier: str): bool =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           (graph.props[i].propName == "className" || graph.props[i].propName == "class"):
            if WebSceneClassValueHasNamedVariant(graph.props[i].propValue, prefix, modifier):
                return true
    return false

@borrows
fn WebSceneNodePseudoStateMatches(graph: var WebSceneGraph,
                                  routeIndex: int32,
                                  nodeId: int32,
                                  pseudoName: str): bool =
    if pseudoName == "placeholder":
        return WebSceneNodePlaceholderVisible(graph, routeIndex, nodeId)
    if pseudoName == "disabled":
        return WebSceneNodePropMatches(graph, routeIndex, nodeId, "disabled", "true") ||
            WebSceneNodePropMatches(graph, routeIndex, nodeId, "aria-disabled", "true")
    let stateIndex = WebSceneFindNodeStateIndex(graph, routeIndex, nodeId)
    if stateIndex < 0:
        return false
    if pseudoName == "hover":
        return graph.nodeStates[stateIndex].hover
    if pseudoName == "active":
        return graph.nodeStates[stateIndex].active
    if pseudoName == "focus":
        return graph.nodeStates[stateIndex].focus
    return false

@borrows
fn WebSceneGroupVariantMatches(graph: var WebSceneGraph,
                               condition: WebSceneCssVariantCondition): bool =
    var current = WebSceneFindNodeParentId(graph, condition.nodeId)
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        if WebSceneNodeBelongsToRoute(graph, condition.routeIndex, current):
            if WebSceneNodeHasNamedClassVariant(graph, condition.routeIndex, current, "group", condition.modifier):
                return WebSceneNodePseudoStateMatches(graph, condition.routeIndex, current, condition.variantName)
        current = WebSceneFindNodeParentId(graph, current)
        guard = guard + 1
    return false

fn WebSceneFindNodeArrayIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    for i in 0..<graph.nodes.len:
        if graph.nodes[i].routeIndex == routeIndex && graph.nodes[i].nodeId == nodeId:
            return i
    return -1

@borrows
fn WebScenePeerVariantMatches(graph: var WebSceneGraph,
                              condition: WebSceneCssVariantCondition): bool =
    let nodeIndex = WebSceneFindNodeArrayIndex(graph, condition.routeIndex, condition.nodeId)
    if nodeIndex < 0:
        return false
    let parentNodeId = graph.nodes[nodeIndex].parentNodeId
    for i in 0..<nodeIndex:
        if graph.nodes[i].routeIndex == condition.routeIndex &&
           graph.nodes[i].parentNodeId == parentNodeId:
            if WebSceneNodeHasNamedClassVariant(graph, condition.routeIndex, graph.nodes[i].nodeId, "peer", condition.modifier):
                if WebSceneNodePseudoStateMatches(graph, condition.routeIndex, graph.nodes[i].nodeId, condition.variantName):
                    return true
    return false

@borrows
fn WebSceneArbitrarySelectorMatchesTarget(graph: var WebSceneGraph,
                                          sourceNodeId: int32,
                                          selector: str,
                                          targetNodeId: int32): bool =
    if selector == "&":
        if targetNodeId == sourceNodeId:
            return true
        return false
    if selector == "&>svg":
        let parent = WebSceneFindNodeParentId(graph, targetNodeId)
        if parent != sourceNodeId:
            return false
        let nodeIndex = WebSceneFindNodeArrayIndex(graph, WebSceneFindNodeRouteIndex(graph, targetNodeId), targetNodeId)
        if nodeIndex < 0:
            return false
        if graph.nodes[nodeIndex].tagName == "svg":
            return true
        return false
    if selector == "&_svg":
        let nodeIndex = WebSceneFindNodeArrayIndex(graph, WebSceneFindNodeRouteIndex(graph, targetNodeId), targetNodeId)
        if nodeIndex < 0:
            return false
        if graph.nodes[nodeIndex].tagName != "svg":
            return false
        return WebSceneNodeInSubtree(graph, sourceNodeId, targetNodeId)
    return false

@borrows
fn WebSceneTailwindBreakpointMinWidth(name: str): int32 =
    if name == "sm":
        return 640
    if name == "md":
        return 768
    if name == "lg":
        return 1024
    if name == "xl":
        return 1280
    if name == "2xl":
        return 1536
    return -1

@borrows
fn WebSceneCssMediaVariantPx(value: str, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    return WebSceneCssParsePx(value, out)

@borrows
fn WebSceneCssMediaVariantMatches(graph: var WebSceneGraph,
                                  condition: WebSceneCssVariantCondition): bool =
    if graph.currentViewportWidth <= 0:
        return false
    let raw = condition.variantName
    if raw.len <= 0:
        return false
    let named = WebSceneTailwindBreakpointMinWidth(raw)
    if named > 0:
        if graph.currentViewportWidth >= named:
            return true
        return false
    if strings.HasPrefix(raw, "min-"):
        let body = strings.SliceBytes(raw, 4, raw.len - 4)
        let bodyNamed = WebSceneTailwindBreakpointMinWidth(body)
        if bodyNamed > 0:
            if graph.currentViewportWidth >= bodyNamed:
                return true
            return false
        if raw.len > 6 && raw[4] == '[' && raw[raw.len - 1] == ']':
            let pxText = strings.SliceBytes(raw, 5, raw.len - 6)
            var px: int32
            if WebSceneCssMediaVariantPx(pxText, px):
                if graph.currentViewportWidth >= px:
                    return true
                return false
        return false
    if strings.HasPrefix(raw, "max-"):
        let body = strings.SliceBytes(raw, 4, raw.len - 4)
        let bodyNamed = WebSceneTailwindBreakpointMinWidth(body)
        if bodyNamed > 0:
            if graph.currentViewportWidth < bodyNamed:
                return true
            return false
        if raw.len > 6 && raw[4] == '[' && raw[raw.len - 1] == ']':
            let pxText = strings.SliceBytes(raw, 5, raw.len - 6)
            var px: int32
            if WebSceneCssMediaVariantPx(pxText, px):
                if graph.currentViewportWidth <= px:
                    return true
                return false
        return false
    return false

@borrows
fn WebSceneCssVariantConditionMatches(graph: var WebSceneGraph,
                                      condition: WebSceneCssVariantCondition): bool =
    if condition.variantKind == "media":
        return WebSceneCssMediaVariantMatches(graph, condition)
    if condition.variantKind == "pseudo":
        return WebSceneNodePseudoStateMatches(graph, condition.routeIndex, condition.nodeId, condition.variantName)
    if condition.variantKind == "data" || condition.variantKind == "aria":
        if condition.attributeName.len == 0:
            return false
        return WebSceneNodePropMatches(graph, condition.routeIndex, condition.nodeId, condition.attributeName, condition.attributeValue)
    if condition.variantKind == "state":
        if condition.variantName.len == 0:
            return false
        # WebSceneStateValueMatchesCondition already understands the full guard_state
        # sentinel vocabulary (__truthy/__falsy/__array_nonempty/__trim_nonempty/
        # __num_finite/__not:<value>/plain equality) — the same predicates the click-time
        # guard_state chain evaluates. Sharing it lets a compound css state condition
        # (e.g. a derived `canPublish` conjunct materialized as `state-[title=__truthy]`)
        # match with the identical semantics as the button's click guard, instead of this
        # branch's own narrower exact-equality-only reimplementation.
        let currentStateValue = WebSceneStateValueForRef(graph, condition.variantName)
        return WebSceneStateValueMatchesCondition(currentStateValue, condition.attributeValue)
    if condition.variantKind == "group":
        return WebSceneGroupVariantMatches(graph, condition)
    if condition.variantKind == "peer":
        return WebScenePeerVariantMatches(graph, condition)
    if condition.variantKind == "arbitrary-selector":
        if condition.selector.len > 0:
            return true
        return false
    return false

@borrows
fn WebSceneCssVariantRuleMatches(graph: var WebSceneGraph, rule: WebSceneCssVariantRule): bool =
    var conditionCount: int32
    for i in 0..<graph.cssVariantConditions.len:
        if graph.cssVariantConditions[i].routeIndex == rule.routeIndex &&
           graph.cssVariantConditions[i].nodeId == rule.nodeId &&
           graph.cssVariantConditions[i].ruleOrdinal == rule.ordinal:
            conditionCount = conditionCount + 1
            if !WebSceneCssVariantConditionMatches(graph, graph.cssVariantConditions[i]):
                return false
    if conditionCount > 0:
        return true
    return false

@borrows
fn WebScenePaintOpInDeclarationScope(graph: var WebSceneGraph,
                                     declaration: WebSceneCssDeclaration,
                                     paintOp: WebScenePaintOp): bool =
    if paintOp.routeIndex != declaration.routeIndex:
        return false
    var selectorConditionCount: int32
    for conditionIndex in 0..<graph.cssVariantConditions.len:
        if graph.cssVariantConditions[conditionIndex].routeIndex == declaration.routeIndex &&
           graph.cssVariantConditions[conditionIndex].nodeId == declaration.nodeId &&
           graph.cssVariantConditions[conditionIndex].ruleOrdinal == declaration.ruleOrdinal &&
           graph.cssVariantConditions[conditionIndex].variantKind == "arbitrary-selector":
            selectorConditionCount = selectorConditionCount + 1
            if !WebSceneArbitrarySelectorMatchesTarget(graph,
                                                       declaration.nodeId,
                                                       graph.cssVariantConditions[conditionIndex].selector,
                                                       paintOp.nodeId):
                return false
    if selectorConditionCount > 0:
        return true
    if paintOp.nodeId == declaration.nodeId:
        return true
    return WebSceneNodeInSubtree(graph, declaration.nodeId, paintOp.nodeId)

@borrows
fn WebScenePaintOpMatchesDeclarationElementOrSelector(graph: var WebSceneGraph,
                                                      declaration: WebSceneCssDeclaration,
                                                      paintOp: WebScenePaintOp): bool =
    if paintOp.routeIndex != declaration.routeIndex:
        return false
    var selectorConditionCount: int32
    for conditionIndex in 0..<graph.cssVariantConditions.len:
        if graph.cssVariantConditions[conditionIndex].routeIndex == declaration.routeIndex &&
           graph.cssVariantConditions[conditionIndex].nodeId == declaration.nodeId &&
           graph.cssVariantConditions[conditionIndex].ruleOrdinal == declaration.ruleOrdinal &&
           graph.cssVariantConditions[conditionIndex].variantKind == "arbitrary-selector":
            selectorConditionCount = selectorConditionCount + 1
            if !WebSceneArbitrarySelectorMatchesTarget(graph,
                                                       declaration.nodeId,
                                                       graph.cssVariantConditions[conditionIndex].selector,
                                                       paintOp.nodeId):
                return false
    if selectorConditionCount > 0:
        return true
    if paintOp.nodeId == declaration.nodeId:
        return true
    return false

@borrows
fn WebSceneCssDeclarationHasArbitrarySelectorCondition(graph: var WebSceneGraph,
                                                       declaration: WebSceneCssDeclaration): bool =
    if declaration.ruleOrdinal < 0:
        return false
    for conditionIndex in 0..<graph.cssVariantConditions.len:
        if graph.cssVariantConditions[conditionIndex].routeIndex == declaration.routeIndex &&
           graph.cssVariantConditions[conditionIndex].nodeId == declaration.nodeId &&
           graph.cssVariantConditions[conditionIndex].ruleOrdinal == declaration.ruleOrdinal &&
           graph.cssVariantConditions[conditionIndex].variantKind == "arbitrary-selector":
            return true
    return false

@borrows
fn WebSceneCssDeclarationHasPseudoCondition(graph: var WebSceneGraph,
                                            declaration: WebSceneCssDeclaration,
                                            pseudoName: str): bool =
    if declaration.ruleOrdinal < 0:
        return false
    for i in 0..<graph.cssVariantConditions.len:
        if graph.cssVariantConditions[i].routeIndex == declaration.routeIndex &&
           graph.cssVariantConditions[i].nodeId == declaration.nodeId &&
           graph.cssVariantConditions[i].ruleOrdinal == declaration.ruleOrdinal &&
           graph.cssVariantConditions[i].variantKind == "pseudo" &&
           graph.cssVariantConditions[i].variantName == pseudoName:
            return true
    return false

fn WebScenePaintOpRangeForNode(graph: var WebSceneGraph,
                               nodeId: int32,
                               startIndex: var int32,
                               endIndex: var int32): bool =
    startIndex = -1
    endIndex = -1
    if nodeId <= 0 || nodeId >= graph.paintOpStartByNodeId.len || nodeId >= graph.paintOpEndByNodeId.len:
        return false
    startIndex = graph.paintOpStartByNodeId[nodeId]
    if startIndex < 0:
        return true
    endIndex = graph.paintOpEndByNodeId[nodeId]
    if endIndex < startIndex || endIndex > graph.paintOps.len:
        return false
    return true

fn WebScenePaintOpMatchesCssColorTarget(opKind: int32, targetKind: int32): bool =
    if opKind == targetKind:
        return true
    if targetKind == WebScenePaintText && opKind == WebScenePaintSvgIcon:
        return true
    return false

fn WebSceneMarkCssDeclarationDirty(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   changed: bool): bool =
    if !changed:
        return true
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    return WebSceneMarkDirtySubtree(graph, nodeId)

@borrows
fn WebSceneApplyCssColorDeclarationToPaintOps(graph: var WebSceneGraph,
                                              declaration: WebSceneCssDeclaration,
                                              targetKind: int32,
                                              subtree: bool): bool =
    var color: int64
    if !WebSceneParseArgbColor(declaration.propertyValue, color):
        return false
    var matched = false
    var changed = false
    if !WebSceneCssDeclarationHasArbitrarySelectorCondition(graph, declaration):
        if subtree:
            for nodeIndex in 0..<graph.nodes.len:
                if graph.nodes[nodeIndex].routeIndex != declaration.routeIndex:
                    continue
                if !WebSceneNodeInSubtree(graph, declaration.nodeId, graph.nodes[nodeIndex].nodeId):
                    continue
                var startIndex: int32
                var endIndex: int32
                if !WebScenePaintOpRangeForNode(graph, graph.nodes[nodeIndex].nodeId, startIndex, endIndex):
                    return false
                if startIndex < 0:
                    continue
                for i in startIndex..<endIndex:
                    if graph.paintOps[i].routeIndex != declaration.routeIndex || graph.paintOps[i].nodeId != graph.nodes[nodeIndex].nodeId:
                        continue
                    if WebScenePaintOpMatchesCssColorTarget(graph.paintOps[i].opKind, targetKind):
                        matched = true
                        if graph.paintOps[i].color != color:
                            graph.paintOps[i].color = color
                            changed = true
        else:
            var startIndex: int32
            var endIndex: int32
            if !WebScenePaintOpRangeForNode(graph, declaration.nodeId, startIndex, endIndex):
                return false
            if startIndex >= 0:
                for i in startIndex..<endIndex:
                    if graph.paintOps[i].routeIndex != declaration.routeIndex || graph.paintOps[i].nodeId != declaration.nodeId:
                        continue
                    if WebScenePaintOpMatchesCssColorTarget(graph.paintOps[i].opKind, targetKind):
                        matched = true
                        if graph.paintOps[i].color != color:
                            graph.paintOps[i].color = color
                            changed = true
    else:
        for i in 0..<graph.paintOps.len:
            if graph.paintOps[i].routeIndex != declaration.routeIndex:
                continue
            if subtree:
                if !WebScenePaintOpInDeclarationScope(graph, declaration, graph.paintOps[i]):
                    continue
            elif graph.paintOps[i].nodeId != declaration.nodeId:
                continue
            if WebScenePaintOpMatchesCssColorTarget(graph.paintOps[i].opKind, targetKind):
                matched = true
                if graph.paintOps[i].color != color:
                    graph.paintOps[i].color = color
                    changed = true
    if !matched:
        return false
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, changed)

@borrows
fn WebSceneApplyCssOpacityDeclarationToPaintOps(graph: var WebSceneGraph,
                                                declaration: WebSceneCssDeclaration): bool =
    var opacity: int32
    if !WebSceneParseCssOpacity(declaration.propertyValue, opacity):
        return false
    var matched = false
    var changed = false
    if !WebSceneCssDeclarationHasArbitrarySelectorCondition(graph, declaration):
        for nodeIndex in 0..<graph.nodes.len:
            if graph.nodes[nodeIndex].routeIndex != declaration.routeIndex:
                continue
            if !WebSceneNodeInSubtree(graph, declaration.nodeId, graph.nodes[nodeIndex].nodeId):
                continue
            var startIndex: int32
            var endIndex: int32
            if !WebScenePaintOpRangeForNode(graph, graph.nodes[nodeIndex].nodeId, startIndex, endIndex):
                return false
            if startIndex < 0:
                continue
            for i in startIndex..<endIndex:
                if graph.paintOps[i].routeIndex != declaration.routeIndex || graph.paintOps[i].nodeId != graph.nodes[nodeIndex].nodeId:
                    continue
                matched = true
                if graph.paintOps[i].opacity != opacity:
                    graph.paintOps[i].opacity = opacity
                    changed = true
    else:
        for i in 0..<graph.paintOps.len:
            if WebScenePaintOpInDeclarationScope(graph, declaration, graph.paintOps[i]):
                matched = true
                if graph.paintOps[i].opacity != opacity:
                    graph.paintOps[i].opacity = opacity
                    changed = true
    if !matched:
        return false
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, changed)

@borrows
fn WebSceneApplyNodeInlineOpacity(graph: var WebSceneGraph,
                                  routeIndex: int32,
                                  nodeId: int32,
                                  value: str,
                                  markDirty: bool): int32 =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return -1
    var opacity: int32
    if !WebSceneParseCssOpacity(value, opacity):
        return -1
    var matched = false
    var changed = false
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex != routeIndex:
            continue
        if graph.paintOps[i].nodeId != nodeId && !WebSceneNodeInSubtree(graph, nodeId, graph.paintOps[i].nodeId):
            continue
        matched = true
        if graph.paintOps[i].opacity != opacity:
            graph.paintOps[i].opacity = opacity
            changed = true
    if !matched:
        return -1
    if changed && markDirty:
        if !WebSceneMarkDirtySubtree(graph, nodeId):
            return -1
    if changed:
        return 1
    return 0

@borrows
fn WebSceneApplyCssBorderRadiusDeclarationToPaintOps(graph: var WebSceneGraph,
                                                     declaration: WebSceneCssDeclaration): bool =
    var radius: int32
    if !WebSceneCssParsePx(declaration.propertyValue, radius):
        return false
    if radius < 0:
        return false
    if WebSceneCssDeclarationTargetNotRendered(graph, declaration):
        return true
    var matched = false
    var changed = false
    if !WebSceneCssDeclarationHasArbitrarySelectorCondition(graph, declaration):
        if declaration.nodeId <= 0 || declaration.nodeId >= graph.paintOpStartByNodeId.len || declaration.nodeId >= graph.paintOpEndByNodeId.len:
            return false
        let startIndex = graph.paintOpStartByNodeId[declaration.nodeId]
        if startIndex < 0:
            return true
        let endIndex = graph.paintOpEndByNodeId[declaration.nodeId]
        if endIndex < startIndex || endIndex > graph.paintOps.len:
            return false
        for i in startIndex..<endIndex:
            if graph.paintOps[i].routeIndex != declaration.routeIndex || graph.paintOps[i].nodeId != declaration.nodeId:
                continue
            matched = true
            if graph.paintOps[i].radius != radius:
                graph.paintOps[i].radius = radius
                changed = true
    else:
        for i in 0..<graph.paintOps.len:
            if !WebScenePaintOpMatchesDeclarationElementOrSelector(graph, declaration, graph.paintOps[i]):
                continue
            matched = true
            if graph.paintOps[i].radius != radius:
                graph.paintOps[i].radius = radius
                changed = true
    if !matched:
        return true
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, changed)

@borrows
fn WebSceneTransformPrefixMatches(value: str, start: int32, prefix: str): bool =
    if start < 0 || prefix.len <= 0:
        return false
    if start + prefix.len > value.len:
        return false
    for i in 0..<prefix.len:
        if value[start + i] != prefix[i]:
            return false
    return true

@borrows
fn WebSceneFindTransformFunctionEnd(value: str, start: int32): int32 =
    var index = start
    while index < value.len:
        if value[index] == ')':
            return index
        index = index + 1
    return -1

@borrows
fn WebSceneParseTransformFunctionNumber(value: str,
                                        start: int32,
                                        prefix: str,
                                        out: var int32,
                                        isPx: bool,
                                        nextIndex: var int32): bool =
    out = 0
    nextIndex = start
    if !WebSceneTransformPrefixMatches(value, start, prefix):
        return false
    let numberStart = start + prefix.len
    let numberEnd = WebSceneFindTransformFunctionEnd(value, numberStart)
    if numberEnd <= numberStart:
        return false
    if isPx:
        if numberEnd - numberStart < 3:
            return false
        if value[numberEnd - 2] != 'p' || value[numberEnd - 1] != 'x':
            return false
        if !WebSceneParseCssNumberPermilleRange(value, numberStart, numberEnd - 2, out):
            return false
    else:
        if !WebSceneParseCssNumberPermilleRange(value, numberStart, numberEnd, out):
            return false
    nextIndex = numberEnd + 1
    if nextIndex < value.len:
        if value[nextIndex] != ' ':
            return false
        while nextIndex < value.len && value[nextIndex] == ' ':
            nextIndex = nextIndex + 1
    return true

@borrows
fn WebSceneParseTransformFunctionTranslate(value: str,
                                           start: int32,
                                           prefix: str,
                                           outPxMilli: var int32,
                                           outPercentPermille: var int32,
                                           nextIndex: var int32): bool =
    outPxMilli = 0
    outPercentPermille = 0
    nextIndex = start
    if !WebSceneTransformPrefixMatches(value, start, prefix):
        return false
    let numberStart = start + prefix.len
    let numberEnd = WebSceneFindTransformFunctionEnd(value, numberStart)
    if numberEnd <= numberStart:
        return false
    if numberEnd - numberStart >= 3 &&
       value[numberEnd - 2] == 'p' && value[numberEnd - 1] == 'x':
        if !WebSceneParseCssNumberPermilleRange(value, numberStart, numberEnd - 2, outPxMilli):
            return false
    elif numberEnd - numberStart >= 2 && value[numberEnd - 1] == '%':
        if !WebSceneParseCssNumberPermilleRange(value, numberStart, numberEnd - 1, outPercentPermille):
            return false
    else:
        return false
    nextIndex = numberEnd + 1
    if nextIndex < value.len:
        if value[nextIndex] != ' ':
            return false
        while nextIndex < value.len && value[nextIndex] == ' ':
            nextIndex = nextIndex + 1
    return true

@borrows
fn WebSceneParseTransformFunctionRotateDeg(value: str,
                                           start: int32,
                                           outDeg: var int32,
                                           nextIndex: var int32): bool =
    outDeg = 0
    nextIndex = start
    let prefix = "rotate("
    if !WebSceneTransformPrefixMatches(value, start, prefix):
        return false
    let numberStart = start + prefix.len
    let numberEnd = WebSceneFindTransformFunctionEnd(value, numberStart)
    if numberEnd - numberStart < 4:
        return false
    if value[numberEnd - 3] != 'd' || value[numberEnd - 2] != 'e' || value[numberEnd - 1] != 'g':
        return false
    var milli: int32
    if !WebSceneParseCssNumberPermilleRange(value, numberStart, numberEnd - 3, milli):
        return false
    if milli % 1000 != 0:
        return false
    outDeg = milli / 1000
    if outDeg % 90 != 0:
        return false
    nextIndex = numberEnd + 1
    if nextIndex < value.len:
        if value[nextIndex] != ' ':
            return false
        while nextIndex < value.len && value[nextIndex] == ' ':
            nextIndex = nextIndex + 1
    return true

@borrows
fn WebSceneApplyCssTransformDeclarationToPaintOps(graph: var WebSceneGraph,
                                                  declaration: WebSceneCssDeclaration): bool =
    if declaration.propertyValue == "none":
        return true
    var translateXMilli: int32
    var translateYMilli: int32
    var translateXPercentPermille: int32
    var translateYPercentPermille: int32
    var scaleXPermille: int32 = 1000
    var scaleYPermille: int32 = 1000
    var rotateDeg: int32
    var index: int32
    while index < declaration.propertyValue.len:
        var value: int32
        var percent: int32
        var nextIndex: int32
        if WebSceneParseTransformFunctionTranslate(declaration.propertyValue, index, "translateX(", value, percent, nextIndex):
            translateXMilli = value
            translateXPercentPermille = percent
            index = nextIndex
        elif WebSceneParseTransformFunctionTranslate(declaration.propertyValue, index, "translateY(", value, percent, nextIndex):
            translateYMilli = value
            translateYPercentPermille = percent
            index = nextIndex
        elif WebSceneParseTransformFunctionNumber(declaration.propertyValue, index, "scale(", value, false, nextIndex):
            if value < 0:
                return false
            scaleXPermille = value
            scaleYPermille = value
            index = nextIndex
        elif WebSceneParseTransformFunctionNumber(declaration.propertyValue, index, "scaleX(", value, false, nextIndex):
            if value < 0:
                return false
            scaleXPermille = value
            index = nextIndex
        elif WebSceneParseTransformFunctionNumber(declaration.propertyValue, index, "scaleY(", value, false, nextIndex):
            if value < 0:
                return false
            scaleYPermille = value
            index = nextIndex
        elif WebSceneParseTransformFunctionRotateDeg(declaration.propertyValue, index, value, nextIndex):
            rotateDeg = value
            index = nextIndex
        else:
            return false
    if WebSceneCssDeclarationTargetNotRendered(graph, declaration):
        return true
    var left: int32
    var top: int32
    var right: int32
    var bottom: int32
    var boundsMatched = false
    let layoutBoxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, declaration.routeIndex, declaration.nodeId)
    if layoutBoxIndex >= 0:
        left = graph.layoutBoxes[layoutBoxIndex].x
        top = graph.layoutBoxes[layoutBoxIndex].y
        right = graph.layoutBoxes[layoutBoxIndex].x + graph.layoutBoxes[layoutBoxIndex].width
        bottom = graph.layoutBoxes[layoutBoxIndex].y + graph.layoutBoxes[layoutBoxIndex].height
        boundsMatched = true
    let hasArbitrarySelector = WebSceneCssDeclarationHasArbitrarySelectorCondition(graph, declaration)
    if !boundsMatched:
        if !hasArbitrarySelector:
            for nodeIndex in 0..<graph.nodes.len:
                if graph.nodes[nodeIndex].routeIndex != declaration.routeIndex:
                    continue
                if !WebSceneNodeInSubtree(graph, declaration.nodeId, graph.nodes[nodeIndex].nodeId):
                    continue
                var startIndex: int32
                var endIndex: int32
                if !WebScenePaintOpRangeForNode(graph, graph.nodes[nodeIndex].nodeId, startIndex, endIndex):
                    return false
                if startIndex < 0:
                    continue
                for boundsIndex in startIndex..<endIndex:
                    if graph.paintOps[boundsIndex].routeIndex != declaration.routeIndex || graph.paintOps[boundsIndex].nodeId != graph.nodes[nodeIndex].nodeId:
                        continue
                    let opLeft = graph.paintOps[boundsIndex].baseX
                    let opTop = graph.paintOps[boundsIndex].baseY
                    let opRight = graph.paintOps[boundsIndex].baseX + graph.paintOps[boundsIndex].baseWidth
                    let opBottom = graph.paintOps[boundsIndex].baseY + graph.paintOps[boundsIndex].baseHeight
                    if !boundsMatched:
                        left = opLeft
                        top = opTop
                        right = opRight
                        bottom = opBottom
                        boundsMatched = true
                    else:
                        if opLeft < left:
                            left = opLeft
                        if opTop < top:
                            top = opTop
                        if opRight > right:
                            right = opRight
                        if opBottom > bottom:
                            bottom = opBottom
        else:
            for boundsIndex in 0..<graph.paintOps.len:
                if WebScenePaintOpInDeclarationScope(graph, declaration, graph.paintOps[boundsIndex]):
                    let opLeft = graph.paintOps[boundsIndex].baseX
                    let opTop = graph.paintOps[boundsIndex].baseY
                    let opRight = graph.paintOps[boundsIndex].baseX + graph.paintOps[boundsIndex].baseWidth
                    let opBottom = graph.paintOps[boundsIndex].baseY + graph.paintOps[boundsIndex].baseHeight
                    if !boundsMatched:
                        left = opLeft
                        top = opTop
                        right = opRight
                        bottom = opBottom
                        boundsMatched = true
                    else:
                        if opLeft < left:
                            left = opLeft
                        if opTop < top:
                            top = opTop
                        if opRight > right:
                            right = opRight
                        if opBottom > bottom:
                            bottom = opBottom
    if !boundsMatched:
        if WebSceneNodeBelongsToRoute(graph, declaration.routeIndex, declaration.nodeId):
            return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, false)
        return false
    let boundsWidth = right - left
    let boundsHeight = bottom - top
    let originX2 = left + right
    let originY2 = top + bottom
    let tx = WebSceneRoundMilliToPx(translateXMilli) + WebSceneRoundPercentPermilleToPx(boundsWidth, translateXPercentPermille)
    let ty = WebSceneRoundMilliToPx(translateYMilli) + WebSceneRoundPercentPermilleToPx(boundsHeight, translateYPercentPermille)
    var changed = false
    if !hasArbitrarySelector:
        for nodeIndex in 0..<graph.nodes.len:
            if graph.nodes[nodeIndex].routeIndex != declaration.routeIndex:
                continue
            if !WebSceneNodeInSubtree(graph, declaration.nodeId, graph.nodes[nodeIndex].nodeId):
                continue
            var startIndex: int32
            var endIndex: int32
            if !WebScenePaintOpRangeForNode(graph, graph.nodes[nodeIndex].nodeId, startIndex, endIndex):
                return false
            if startIndex < 0:
                continue
            for i in startIndex..<endIndex:
                if graph.paintOps[i].routeIndex != declaration.routeIndex || graph.paintOps[i].nodeId != graph.nodes[nodeIndex].nodeId:
                    continue
                if rotateDeg != 0 && graph.paintOps[i].opKind != WebScenePaintSvgIcon:
                    return false
                let baseW = graph.paintOps[i].baseWidth
                let baseH = graph.paintOps[i].baseHeight
                let nextW = (baseW * scaleXPermille + 500) / 1000
                let nextH = (baseH * scaleYPermille + 500) / 1000
                let baseCenterX2 = graph.paintOps[i].baseX * 2 + baseW
                let baseCenterY2 = graph.paintOps[i].baseY * 2 + baseH
                let scaledCenterX2 = originX2 + ((baseCenterX2 - originX2) * scaleXPermille + 500) / 1000
                let scaledCenterY2 = originY2 + ((baseCenterY2 - originY2) * scaleYPermille + 500) / 1000
                let nextX = (scaledCenterX2 - nextW) / 2 + tx
                let nextY = (scaledCenterY2 - nextH) / 2 + ty
                if graph.paintOps[i].x != nextX || graph.paintOps[i].y != nextY ||
                   graph.paintOps[i].width != nextW || graph.paintOps[i].height != nextH:
                    graph.paintOps[i].x = nextX
                    graph.paintOps[i].y = nextY
                    graph.paintOps[i].width = nextW
                    graph.paintOps[i].height = nextH
                    changed = true
                if graph.paintOps[i].rotationDeg != rotateDeg:
                    graph.paintOps[i].rotationDeg = rotateDeg
                    changed = true
    else:
        for i in 0..<graph.paintOps.len:
            if WebScenePaintOpInDeclarationScope(graph, declaration, graph.paintOps[i]):
                if rotateDeg != 0 && graph.paintOps[i].opKind != WebScenePaintSvgIcon:
                    return false
                let baseW = graph.paintOps[i].baseWidth
                let baseH = graph.paintOps[i].baseHeight
                let nextW = (baseW * scaleXPermille + 500) / 1000
                let nextH = (baseH * scaleYPermille + 500) / 1000
                let baseCenterX2 = graph.paintOps[i].baseX * 2 + baseW
                let baseCenterY2 = graph.paintOps[i].baseY * 2 + baseH
                let scaledCenterX2 = originX2 + ((baseCenterX2 - originX2) * scaleXPermille + 500) / 1000
                let scaledCenterY2 = originY2 + ((baseCenterY2 - originY2) * scaleYPermille + 500) / 1000
                let nextX = (scaledCenterX2 - nextW) / 2 + tx
                let nextY = (scaledCenterY2 - nextH) / 2 + ty
                if graph.paintOps[i].x != nextX || graph.paintOps[i].y != nextY ||
                   graph.paintOps[i].width != nextW || graph.paintOps[i].height != nextH:
                    graph.paintOps[i].x = nextX
                    graph.paintOps[i].y = nextY
                    graph.paintOps[i].width = nextW
                    graph.paintOps[i].height = nextH
                    changed = true
                if graph.paintOps[i].rotationDeg != rotateDeg:
                    graph.paintOps[i].rotationDeg = rotateDeg
                    changed = true
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, changed)

@borrows
fn WebSceneApplyCssPointerEventsDeclaration(graph: var WebSceneGraph,
                                            declaration: WebSceneCssDeclaration): bool =
    var stateIndex: int32
    if !WebSceneEnsureNodeStateIndex(graph, declaration.routeIndex, declaration.nodeId, stateIndex):
        return false
    var nextNone = false
    if declaration.propertyValue == "none":
        nextNone = true
    elif declaration.propertyValue == "auto":
        nextNone = false
    else:
        return false
    let changed = !graph.nodeStates[stateIndex].pointerEventsSet || graph.nodeStates[stateIndex].pointerEventsNone != nextNone
    graph.nodeStates[stateIndex].pointerEventsSet = true
    graph.nodeStates[stateIndex].pointerEventsNone = nextNone
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, changed)

@borrows
fn WebSceneApplyCssGeometryDeclarationToPaintOps(graph: var WebSceneGraph,
                                                declaration: WebSceneCssDeclaration): bool =
    var valuePx: int32
    if !WebSceneCssParsePx(declaration.propertyValue, valuePx):
        return false
    var matched = false
    var changed = false
    if !WebSceneCssDeclarationHasArbitrarySelectorCondition(graph, declaration):
        for nodeIndex in 0..<graph.nodes.len:
            if graph.nodes[nodeIndex].routeIndex != declaration.routeIndex:
                continue
            if !WebSceneNodeInSubtree(graph, declaration.nodeId, graph.nodes[nodeIndex].nodeId):
                continue
            var startIndex: int32
            var endIndex: int32
            if !WebScenePaintOpRangeForNode(graph, graph.nodes[nodeIndex].nodeId, startIndex, endIndex):
                return false
            if startIndex < 0:
                continue
            for i in startIndex..<endIndex:
                if graph.paintOps[i].routeIndex != declaration.routeIndex || graph.paintOps[i].nodeId != graph.nodes[nodeIndex].nodeId:
                    continue
                matched = true
                if declaration.propertyName == "width":
                    if graph.paintOps[i].width != valuePx:
                        graph.paintOps[i].width = valuePx
                        changed = true
                elif declaration.propertyName == "height":
                    if graph.paintOps[i].height != valuePx:
                        graph.paintOps[i].height = valuePx
                        changed = true
                else:
                    return false
    else:
        for i in 0..<graph.paintOps.len:
            if WebScenePaintOpInDeclarationScope(graph, declaration, graph.paintOps[i]):
                matched = true
                if declaration.propertyName == "width":
                    if graph.paintOps[i].width != valuePx:
                        graph.paintOps[i].width = valuePx
                        changed = true
                elif declaration.propertyName == "height":
                    if graph.paintOps[i].height != valuePx:
                        graph.paintOps[i].height = valuePx
                        changed = true
                else:
                    return false
    if !matched:
        return false
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, changed)

@borrows
fn WebSceneSkipCssSpaces(value: str, index: int32): int32 =
    var out = index
    while out < value.len && (value[out] == ' ' || value[out] == '\n' || value[out] == '\t'):
        out = out + 1
    return out

@borrows
fn WebSceneFindCssTokenEnd(value: str, index: int32): int32 =
    var out = index
    while out < value.len && value[out] != ' ' && value[out] != '\n' && value[out] != '\t':
        out = out + 1
    return out

@borrows
fn WebSceneSkipCssSpacesRange(value: str, index: int32, endExclusive: int32): int32 =
    var out = index
    while out < endExclusive && (value[out] == ' ' || value[out] == '\n' || value[out] == '\t'):
        out = out + 1
    return out

@borrows
fn WebSceneFindCssTokenEndRange(value: str, index: int32, endExclusive: int32): int32 =
    var out = index
    while out < endExclusive && value[out] != ' ' && value[out] != '\n' && value[out] != '\t':
        out = out + 1
    return out

@borrows
fn WebSceneTrimCssRange(value: str, start: int32, endExclusive: int32, outStart: var int32, outEnd: var int32): bool =
    if start < 0 || endExclusive < start || endExclusive > value.len:
        return false
    outStart = start
    outEnd = endExclusive
    while outStart < outEnd && (value[outStart] == ' ' || value[outStart] == '\n' || value[outStart] == '\t'):
        outStart = outStart + 1
    while outEnd > outStart && (value[outEnd - 1] == ' ' || value[outEnd - 1] == '\n' || value[outEnd - 1] == '\t'):
        outEnd = outEnd - 1
    return true

@borrows
fn WebSceneCssRangeEquals(value: str, start: int32, endExclusive: int32, expected: str): bool =
    if start < 0 || endExclusive < start || endExclusive > value.len:
        return false
    if endExclusive - start != expected.len:
        return false
    for i in 0..<expected.len:
        if value[start + i] != expected[i]:
            return false
    return true

@borrows
fn WebSceneParseCssShadowLengthToken(value: str,
                                     start: int32,
                                     endExclusive: int32,
                                     out: var int32): bool =
    out = 0
    if start < 0 || endExclusive <= start || endExclusive > value.len:
        return false
    if endExclusive - start == 1 && value[start] == '0':
        return true
    if endExclusive - start < 3:
        return false
    if value[endExclusive - 2] != 'p' || value[endExclusive - 1] != 'x':
        return false
    var milli: int32
    if !WebSceneParseCssNumberPermilleRange(value, start, endExclusive - 2, milli):
        return false
    out = WebSceneRoundMilliToPx(milli)
    return true

@borrows
fn WebSceneParseUnsignedByteRange(value: str,
                                  start: int32,
                                  endExclusive: int32,
                                  out: var int32): bool =
    out = 0
    if start < 0 || endExclusive <= start || endExclusive > value.len:
        return false
    var index = start
    while index < endExclusive:
        if value[index] < '0' || value[index] > '9':
            return false
        out = out * 10 + (int32(value[index]) - int32('0'))
        index = index + 1
    if out < 0 || out > 255:
        return false
    return true

@borrows
fn WebSceneFindChar(value: str, start: int32, endExclusive: int32, ch: char): int32 =
    var index = start
    while index < endExclusive:
        if value[index] == ch:
            return index
        index = index + 1
    return -1

@borrows
fn WebSceneFindTopLevelComma(value: str, start: int32): int32 =
    var index = start
    var depth: int32
    while index < value.len:
        if value[index] == '(':
            depth = depth + 1
        elif value[index] == ')':
            if depth <= 0:
                return -1
            depth = depth - 1
        elif value[index] == ',' && depth == 0:
            return index
        index = index + 1
    if depth != 0:
        return -1
    return value.len

@borrows
fn WebSceneParseCssRgbaColorRange(value: str,
                                  start: int32,
                                  endExclusive: int32,
                                  out: var int64): bool =
    out = int64(0)
    if start < 0 || endExclusive <= start || endExclusive > value.len:
        return false
    if endExclusive - start < 12:
        return false
    if !WebSceneTransformPrefixMatches(value, start, "rgba("):
        return false
    if value[endExclusive - 1] != ')':
        return false
    let redStart = start + 5
    let redEnd = WebSceneFindChar(value, redStart, endExclusive, ',')
    if redEnd < 0:
        return false
    let greenStart = redEnd + 1
    let greenEnd = WebSceneFindChar(value, greenStart, endExclusive, ',')
    if greenEnd < 0:
        return false
    let blueStart = greenEnd + 1
    let blueEnd = WebSceneFindChar(value, blueStart, endExclusive, ',')
    if blueEnd < 0:
        return false
    let alphaStart = blueEnd + 1
    let alphaEnd = endExclusive - 1
    var red: int32
    var green: int32
    var blue: int32
    var alphaPermille: int32
    if !WebSceneParseUnsignedByteRange(value, redStart, redEnd, red):
        return false
    if !WebSceneParseUnsignedByteRange(value, greenStart, greenEnd, green):
        return false
    if !WebSceneParseUnsignedByteRange(value, blueStart, blueEnd, blue):
        return false
    if !WebSceneParseCssNumberPermilleRange(value, alphaStart, alphaEnd, alphaPermille):
        return false
    if alphaPermille < 0 || alphaPermille > 1000:
        return false
    let alpha = (alphaPermille * 255 + 500) / 1000
    out = int64(alpha) * int64(16777216) +
        int64(red) * int64(65536) +
        int64(green) * int64(256) +
        int64(blue)
    return true

@borrows
fn WebSceneParseCssBoxShadowSegment(value: str,
                                    start: int32,
                                    endExclusive: int32,
                                    offsetX: var int32,
                                    offsetY: var int32,
                                    blur: var int32,
                                    spread: var int32,
                                    color: var int64,
                                    inset: var bool): bool =
    offsetX = 0
    offsetY = 0
    blur = 0
    spread = 0
    color = int64(0)
    inset = false
    var segmentStart: int32
    var segmentEnd: int32
    if !WebSceneTrimCssRange(value, start, endExclusive, segmentStart, segmentEnd):
        return false
    if segmentStart >= segmentEnd:
        return false
    if WebSceneCssRangeEquals(value, segmentStart, segmentEnd, "none"):
        return true
    var cursor = WebSceneSkipCssSpacesRange(value, segmentStart, segmentEnd)
    var tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
    if WebSceneCssRangeEquals(value, cursor, tokenEnd, "inset"):
        inset = true
        cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
        tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
    if !WebSceneParseCssShadowLengthToken(value, cursor, tokenEnd, offsetX):
        return false
    cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
    tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
    if !WebSceneParseCssShadowLengthToken(value, cursor, tokenEnd, offsetY):
        return false
    cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
    tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
    if !WebSceneParseCssShadowLengthToken(value, cursor, tokenEnd, blur):
        return false
    if blur < 0:
        return false
    cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
    tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
    if !WebSceneTransformPrefixMatches(value, cursor, "rgba("):
        if !WebSceneParseCssShadowLengthToken(value, cursor, tokenEnd, spread):
            return false
        cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
        tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
    if !WebSceneParseCssRgbaColorRange(value, cursor, tokenEnd, color):
        return false
    cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
    if cursor < segmentEnd:
        tokenEnd = WebSceneFindCssTokenEndRange(value, cursor, segmentEnd)
        if !inset && WebSceneCssRangeEquals(value, cursor, tokenEnd, "inset"):
            inset = true
            cursor = WebSceneSkipCssSpacesRange(value, tokenEnd, segmentEnd)
        else:
            return false
    if cursor == segmentEnd:
        return true
    return false

fn WebSceneMinI32(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

fn WebSceneMaxI32(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

fn WebSceneAbsI32(value: int32): int32 =
    if value < 0:
        return 0 - value
    return value

# Top-level (paren-aware) comma finder bounded to [start, endExclusive). Used to walk
# gradient stops INSIDE a gradient's own parentheses, where the unbounded finder would
# choke on the function's closing ')'. Returns the comma index, endExclusive if there is
# no top-level comma in range, or -1 if parentheses are unbalanced within range.
@borrows
fn WebSceneFindTopLevelCommaInRange(value: str, start: int32, endExclusive: int32): int32 =
    if start < 0 || endExclusive > value.len || start > endExclusive:
        return -1
    var index = start
    var depth: int32
    while index < endExclusive:
        let ch = value[index]
        if ch == '(':
            depth = depth + 1
        elif ch == ')':
            if depth <= 0:
                return -1
            depth = depth - 1
        elif ch == ',' && depth == 0:
            return index
        index = index + 1
    if depth != 0:
        return -1
    return endExclusive

@borrows
fn WebSceneParseCssPercentPermille(value: str, start: int32, endExclusive: int32, out: var int32): bool =
    out = 0
    var s: int32
    var e: int32
    if !WebSceneTrimCssRange(value, start, endExclusive, s, e):
        return false
    if e - s < 2 || value[e - 1] != '%':
        return false
    var negative = false
    if value[s] == '-':
        negative = true
        s = s + 1
        if e - s < 2:
            return false
    var whole: int32
    var wholeDigits: int32
    var index = s
    while index < e - 1 && value[index] >= '0' && value[index] <= '9':
        whole = whole * 10 + (int32(value[index]) - int32('0'))
        wholeDigits = wholeDigits + 1
        index = index + 1
    var frac: int32
    if index < e - 1 && value[index] == '.':
        index = index + 1
        if index < e - 1 && value[index] >= '0' && value[index] <= '9':
            frac = int32(value[index]) - int32('0')
            index = index + 1
        while index < e - 1 && value[index] >= '0' && value[index] <= '9':
            index = index + 1
    if index != e - 1 || wholeDigits <= 0:
        return false
    out = whole * 10 + frac
    if negative:
        out = 0 - out
    return true

@borrows
fn WebSceneParseCssGradientColor(value: str, start: int32, endExclusive: int32, out: var int64): bool =
    out = int64(0)
    var s: int32
    var e: int32
    if !WebSceneTrimCssRange(value, start, endExclusive, s, e):
        return false
    if e <= s:
        return false
    if WebSceneCssRangeEquals(value, s, e, "transparent"):
        out = int64(0)
        return true
    if value[s] == '#':
        let hexLen = e - s - 1
        if hexLen != 6 && hexLen != 8:
            return false
        var rgba: int64
        var hi = s + 1
        while hi < e:
            let hc = int32(value[hi])
            var digit = -1
            if hc >= int32('0') && hc <= int32('9'):
                digit = hc - int32('0')
            elif hc >= int32('a') && hc <= int32('f'):
                digit = hc - int32('a') + 10
            elif hc >= int32('A') && hc <= int32('F'):
                digit = hc - int32('A') + 10
            else:
                return false
            rgba = rgba * int64(16) + int64(digit)
            hi = hi + 1
        if hexLen == 6:
            out = int64(4278190080) + rgba
        else:
            let alphaByte = rgba % int64(256)
            let rgbPart = rgba / int64(256)
            out = alphaByte * int64(16777216) + rgbPart
        return true
    if e - s >= 2 && value[s] == '0' && (value[s + 1] == 'x' || value[s + 1] == 'X'):
        return WebSceneParseArgbColorRange(value, s, e, out)
    if WebSceneTransformPrefixMatches(value, s, "rgba(") || WebSceneTransformPrefixMatches(value, s, "rgb("):
        return WebSceneParseCssRgbaColorRange(value, s, e, out)
    return false

# A gradient color stop: "<color> [<pos> [<pos>]]". The color is the first top-level
# token (may itself contain rgba(...) commas/parens); any following tokens are stop
# positions. Returns the LAST percent position found (used as the radial radius).
@borrows
fn WebSceneParseCssGradientStop(value: str,
                                start: int32,
                                endExclusive: int32,
                                colorOut: var int64,
                                posPermilleOut: var int32,
                                hasPosOut: var bool): bool =
    colorOut = int64(0)
    posPermilleOut = 0
    hasPosOut = false
    var s: int32
    var e: int32
    if !WebSceneTrimCssRange(value, start, endExclusive, s, e):
        return false
    if e <= s:
        return false
    # Color ends at the first top-level (paren-depth 0) space.
    var depth: int32
    var firstTopSpace: int32 = -1
    for i in s..<e:
        let ch = value[i]
        if ch == '(':
            depth = depth + 1
        elif ch == ')':
            if depth > 0:
                depth = depth - 1
        elif ch == ' ' && depth == 0:
            if firstTopSpace < 0:
                firstTopSpace = i
    var colorEnd = e
    if firstTopSpace >= 0:
        colorEnd = firstTopSpace
        # Scan the position token list; keep the last token that is a percent.
        var tokenStart = firstTopSpace + 1
        while tokenStart < e:
            var tokenEnd = tokenStart
            while tokenEnd < e && value[tokenEnd] != ' ':
                tokenEnd = tokenEnd + 1
            var posPermille: int32
            if WebSceneParseCssPercentPermille(value, tokenStart, tokenEnd, posPermille):
                posPermilleOut = posPermille
                hasPosOut = true
            tokenStart = tokenEnd + 1
    return WebSceneParseCssGradientColor(value, s, colorEnd, colorOut)

# Direction segment of a gradient: keyword ("to bottom") or "<N>deg".
# Returns false only on a malformed direction; absence of a direction is signalled by hasDir=false.
@borrows
fn WebSceneParseCssGradientDirection(value: str,
                                     start: int32,
                                     endExclusive: int32,
                                     angleOut: var int32,
                                     hasDirOut: var bool): bool =
    angleOut = 0
    hasDirOut = false
    var s: int32
    var e: int32
    if !WebSceneTrimCssRange(value, start, endExclusive, s, e):
        return false
    if e <= s:
        return false
    if WebSceneCssRangeEquals(value, s, e, "to right"):
        angleOut = 90
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to left"):
        angleOut = 270
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to bottom"):
        angleOut = 180
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to top"):
        angleOut = 0
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to bottom right"):
        angleOut = 135
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to bottom left"):
        angleOut = 225
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to top right"):
        angleOut = 45
        hasDirOut = true
        return true
    if WebSceneCssRangeEquals(value, s, e, "to top left"):
        angleOut = 315
        hasDirOut = true
        return true
    if e - s > 3 && value[e - 1] == 'g' && value[e - 2] == 'e' && value[e - 3] == 'd':
        var deg: int32
        var digits: int32
        var idx = s
        while idx < e - 3 && value[idx] >= '0' && value[idx] <= '9':
            deg = deg * 10 + (int32(value[idx]) - int32('0'))
            digits = digits + 1
            idx = idx + 1
        if idx < e - 3 && value[idx] == '.':
            idx = idx + 1
            while idx < e - 3 && value[idx] >= '0' && value[idx] <= '9':
                idx = idx + 1
        if idx != e - 3 || digits <= 0:
            return false
        angleOut = ((deg % 360) + 360) % 360
        hasDirOut = true
        return true
    return false

# radial-gradient(circle at <cx%> <cy%>, <stop0>, ..., <stopN>)
# Maps to a single radial gradient paint op: start = first stop color,
# end = last stop color, center = cx/cy permille, radius = last stop position permille.
@borrows
fn WebSceneParseCssRadialGradient(value: str,
                                  vStart: int32,
                                  vEnd: int32,
                                  centerXPermille: var int32,
                                  centerYPermille: var int32,
                                  radiusPermille: var int32,
                                  startColor: var int64,
                                  endColor: var int64): bool =
    centerXPermille = 500
    centerYPermille = 500
    radiusPermille = 707
    startColor = int64(0)
    endColor = int64(0)
    let prefix = "radial-gradient("
    if vStart < 0 || vEnd > value.len || vEnd - vStart <= prefix.len + 1:
        return false
    if !WebSceneTransformPrefixMatches(value, vStart, prefix):
        return false
    if value[vEnd - 1] != ')':
        return false
    let bodyStart = vStart + prefix.len
    let bodyEnd = vEnd - 1
    let firstComma = WebSceneFindTopLevelCommaInRange(value, bodyStart, bodyEnd)
    if firstComma < 0 || firstComma >= bodyEnd:
        return false
    var headStart: int32
    var headEnd: int32
    if !WebSceneTrimCssRange(value, bodyStart, firstComma, headStart, headEnd):
        return false
    # Parse "circle at <cx%> <cy%>" position; default center if absent.
    var atIndex: int32 = -1
    for i in headStart..<headEnd:
        if value[i] == 'a' && i + 1 < headEnd && value[i + 1] == 't' && (i == headStart || value[i - 1] == ' '):
            atIndex = i
    if atIndex >= 0:
        var posStart: int32
        var posEnd: int32
        if !WebSceneTrimCssRange(value, atIndex + 2, headEnd, posStart, posEnd):
            return false
        var spaceIdx: int32 = -1
        for i in posStart..<posEnd:
            if value[i] == ' ':
                spaceIdx = i
                break
        if spaceIdx < 0:
            return false
        var cx: int32
        var cy: int32
        if !WebSceneParseCssPercentPermille(value, posStart, spaceIdx, cx):
            return false
        if !WebSceneParseCssPercentPermille(value, spaceIdx + 1, posEnd, cy):
            return false
        centerXPermille = cx
        centerYPermille = cy
    # Stops: collect colors and the last position as radius.
    var stopCount: int32
    var lastPos: int32 = -1
    var cursor = firstComma + 1
    while cursor < bodyEnd:
        let nextComma = WebSceneFindTopLevelCommaInRange(value, cursor, bodyEnd)
        if nextComma < 0:
            return false
        var stopColor: int64
        var stopPos: int32
        var stopHasPos: bool
        if !WebSceneParseCssGradientStop(value, cursor, nextComma, stopColor, stopPos, stopHasPos):
            return false
        if stopCount == 0:
            startColor = stopColor
        endColor = stopColor
        if stopHasPos:
            lastPos = stopPos
        stopCount = stopCount + 1
        if nextComma >= bodyEnd:
            cursor = bodyEnd
        else:
            cursor = nextComma + 1
    if stopCount < 2:
        return false
    if lastPos >= 0:
        radiusPermille = lastPos
    return true

@borrows
fn WebSceneParseCssLinearGradient(value: str,
                                  vStart: int32,
                                  vEnd: int32,
                                  angle: var int32,
                                  startColor: var int64,
                                  endColor: var int64): bool =
    angle = 180
    startColor = int64(0)
    endColor = int64(0)
    let prefix = "linear-gradient("
    if vStart < 0 || vEnd > value.len || vEnd - vStart <= prefix.len + 1:
        return false
    if !WebSceneTransformPrefixMatches(value, vStart, prefix):
        return false
    if value[vEnd - 1] != ')':
        return false
    let bodyStart = vStart + prefix.len
    let bodyEnd = vEnd - 1
    let firstComma = WebSceneFindTopLevelCommaInRange(value, bodyStart, bodyEnd)
    if firstComma < 0:
        return false
    # First segment is either a direction or already a color stop (CSS default direction = to bottom).
    var stopsStart = bodyStart
    var dirAngle: int32
    var hasDir: bool
    if firstComma < bodyEnd && WebSceneParseCssGradientDirection(value, bodyStart, firstComma, dirAngle, hasDir):
        if hasDir:
            angle = dirAngle
            stopsStart = firstComma + 1
    # Walk all stops; the GPU gradient command carries two endpoints (first + last stop color).
    var stopCount: int32
    var cursor = stopsStart
    while cursor < bodyEnd:
        let nextComma = WebSceneFindTopLevelCommaInRange(value, cursor, bodyEnd)
        if nextComma < 0:
            return false
        var stopColor: int64
        var stopPos: int32
        var stopHasPos: bool
        if !WebSceneParseCssGradientStop(value, cursor, nextComma, stopColor, stopPos, stopHasPos):
            return false
        if stopCount == 0:
            startColor = stopColor
        endColor = stopColor
        stopCount = stopCount + 1
        if nextComma >= bodyEnd:
            cursor = bodyEnd
        else:
            cursor = nextComma + 1
    if stopCount < 2:
        return false
    return true

@borrows
fn WebSceneParseCssSvgCirclePattern(value: str,
                                    vStart: int32,
                                    vEnd: int32,
                                    tileWidth: var int32,
                                    tileHeight: var int32,
                                    circleCx: var int32,
                                    circleCy: var int32,
                                    circleRadius: var int32,
                                    fillColor: var int64): bool =
    tileWidth = 0
    tileHeight = 0
    circleCx = 0
    circleCy = 0
    circleRadius = 0
    fillColor = int64(0)
    if WebSceneCssRangeEquals(value, vStart, vEnd, "url(\"data:image/svg+xml,%3Csvg width='28' height='28' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='14' cy='14' r='0.8' fill='white'/%3E%3C/svg%3E\")"):
        tileWidth = 28
        tileHeight = 28
        circleCx = 14
        circleCy = 14
        circleRadius = 1
        fillColor = int64(4294967295)
        return true
    return false

fn WebSceneFindRuntimeLayoutBoxIndex(graph: var WebSceneGraph,
                                     routeIndex: int32,
                                     nodeId: int32): int32 =
    var firstMatch: int32 = -1
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].routeIndex == routeIndex &&
           graph.layoutBoxes[i].nodeId == nodeId:
            if firstMatch < 0:
                firstMatch = i
            if graph.layoutBoxes[i].visible &&
               graph.layoutBoxes[i].width > 0 &&
               graph.layoutBoxes[i].height > 0:
                return i
    return firstMatch

fn WebSceneRuntimeLayoutBoxXForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, routeIndex, nodeId)
    if boxIndex < 0:
        return -2147483647
    return graph.layoutBoxes[boxIndex].x

fn WebSceneRuntimeLayoutBoxYForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, routeIndex, nodeId)
    if boxIndex < 0:
        return -2147483647
    return graph.layoutBoxes[boxIndex].y

fn WebSceneRuntimeLayoutBoxWidthForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, routeIndex, nodeId)
    if boxIndex < 0:
        return -1
    return graph.layoutBoxes[boxIndex].width

fn WebSceneRuntimeLayoutBoxHeightForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, routeIndex, nodeId)
    if boxIndex < 0:
        return -1
    return graph.layoutBoxes[boxIndex].height

fn WebSceneRouteHasRuntimeLayoutBox(graph: var WebSceneGraph, routeIndex: int32): bool =
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].routeIndex == routeIndex:
            return true
    return false

fn WebSceneFindNodePaintRadius(graph: var WebSceneGraph,
                               routeIndex: int32,
                               nodeId: int32): int32 =
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex &&
           graph.paintOps[i].nodeId == nodeId &&
           (graph.paintOps[i].opKind == WebScenePaintFill ||
            graph.paintOps[i].opKind == WebScenePaintBorder):
            return graph.paintOps[i].radius
    for i in 0..<graph.cssDeclarations.len:
        if graph.cssDeclarations[i].routeIndex == routeIndex &&
           graph.cssDeclarations[i].nodeId == nodeId &&
           graph.cssDeclarations[i].ruleOrdinal < 0 &&
           graph.cssDeclarations[i].propertyName == "border-radius":
            var radius: int32
            if WebSceneCssParsePx(graph.cssDeclarations[i].propertyValue, radius):
                return radius
    return 0

fn WebSceneNodeHasFillPaintOp(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex &&
           graph.paintOps[i].nodeId == nodeId &&
           graph.paintOps[i].opKind == WebScenePaintFill:
            return true
    return false

@borrows
fn WebSceneCssDeclarationTargetNotRendered(graph: var WebSceneGraph,
                                           declaration: WebSceneCssDeclaration): bool =
    if !WebSceneNodeBelongsToRoute(graph, declaration.routeIndex, declaration.nodeId):
        return false
    return WebSceneNodeHiddenByNonRenderedContent(graph, declaration.routeIndex, declaration.nodeId) ||
        WebSceneNodeHiddenByDisplayNone(graph, declaration.routeIndex, declaration.nodeId)

@borrows
fn WebSceneValidateCssBoxShadowValue(value: str): bool =
    if value == "none":
        return true
    var cursor: int32
    while cursor < value.len:
        let segmentEnd = WebSceneFindTopLevelComma(value, cursor)
        if segmentEnd < cursor:
            return false
        var offsetX: int32
        var offsetY: int32
        var blur: int32
        var spread: int32
        var color: int64
        var inset: bool
        if !WebSceneParseCssBoxShadowSegment(value, cursor, segmentEnd, offsetX, offsetY, blur, spread, color, inset):
            return false
        if segmentEnd >= value.len:
            cursor = value.len
        else:
            cursor = segmentEnd + 1
    return true

@borrows
fn WebSceneApplyCssBoxShadowDeclarationToPaintOps(graph: var WebSceneGraph,
                                                  declaration: WebSceneCssDeclaration): bool =
    if !WebSceneValidateCssBoxShadowValue(declaration.propertyValue):
        return false
    if declaration.propertyValue == "none":
        return true
    if WebSceneCssDeclarationTargetNotRendered(graph, declaration):
        return true
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, declaration.routeIndex, declaration.nodeId)
    if boxIndex < 0:
        return true
    if graph.layoutBoxes[boxIndex].width <= 0 || graph.layoutBoxes[boxIndex].height <= 0:
        return true
    var cursor: int32
    var segmentOrdinal: int32
    while cursor < declaration.propertyValue.len:
        let segmentEnd = WebSceneFindTopLevelComma(declaration.propertyValue, cursor)
        if segmentEnd < cursor:
            return false
        var offsetX: int32
        var offsetY: int32
        var blur: int32
        var spread: int32
        var color: int64
        var inset: bool
        if !WebSceneParseCssBoxShadowSegment(declaration.propertyValue, cursor, segmentEnd, offsetX, offsetY, blur, spread, color, inset):
            return false
        var shadow: WebScenePaintOp
        shadow.routeIndex = declaration.routeIndex
        shadow.nodeId = declaration.nodeId
        shadow.ordinal = declaration.ordinal + segmentOrdinal
        shadow.x = graph.layoutBoxes[boxIndex].x
        shadow.y = graph.layoutBoxes[boxIndex].y
        shadow.baseX = shadow.x
        shadow.baseY = shadow.y
        shadow.opKind = WebScenePaintBoxShadow
        shadow.color = color
        shadow.baseColor = color
        shadow.opacity = 255
        shadow.baseOpacity = 255
        shadow.radius = WebSceneFindNodePaintRadius(graph, declaration.routeIndex, declaration.nodeId)
        shadow.baseRadius = shadow.radius
        shadow.width = graph.layoutBoxes[boxIndex].width
        shadow.height = graph.layoutBoxes[boxIndex].height
        shadow.baseWidth = shadow.width
        shadow.baseHeight = shadow.height
        shadow.shadowOffsetX = offsetX
        shadow.shadowOffsetY = offsetY
        shadow.shadowBlur = blur
        shadow.shadowSpread = spread
        shadow.shadowInset = inset
        shadow.gradientEndColor = int64(0)
        shadow.gradientAngle = 0
        shadow.rotationDeg = 0
        shadow.resourceId = ""
        shadow.textContent = ""
        add(graph.paintShadows, shadow)
        segmentOrdinal = segmentOrdinal + 1
        if segmentEnd >= declaration.propertyValue.len:
            cursor = declaration.propertyValue.len
        else:
            cursor = segmentEnd + 1
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, true)

# Build and append one background-image layer (linear/radial gradient or svg circle
# pattern). For a radial gradient the op reuses the gradient kind via shadowOffsetX=1
# and carries center/radius in the otherwise-unused shadow fields.
@borrows
fn WebSceneAppendBackgroundImageLayerOp(graph: var WebSceneGraph,
                                        propertyValue: str,
                                        routeIndex: int32,
                                        nodeId: int32,
                                        declarationOrdinal: int32,
                                        boxIndex: int32,
                                        layerStart: int32,
                                        layerEnd: int32,
                                        layerOrdinal: int32): bool =
    var ls: int32
    var le: int32
    if !WebSceneTrimCssRange(propertyValue, layerStart, layerEnd, ls, le):
        return false
    if le <= ls:
        return false
    var tileWidth: int32
    var tileHeight: int32
    var circleCx: int32
    var circleCy: int32
    var circleRadius: int32
    var patternColor: int64
    let isSvgCirclePattern = WebSceneParseCssSvgCirclePattern(propertyValue, ls, le, tileWidth, tileHeight, circleCx, circleCy, circleRadius, patternColor)
    let opOrdinal = declarationOrdinal * 16 + layerOrdinal
    if isSvgCirclePattern:
        var pattern: WebScenePaintOp
        pattern.routeIndex = routeIndex
        pattern.nodeId = nodeId
        pattern.ordinal = opOrdinal
        pattern.x = graph.layoutBoxes[boxIndex].x
        pattern.y = graph.layoutBoxes[boxIndex].y
        pattern.baseX = pattern.x
        pattern.baseY = pattern.y
        pattern.opKind = WebScenePaintSvgCirclePattern
        pattern.color = patternColor
        pattern.baseColor = patternColor
        pattern.opacity = 255
        pattern.baseOpacity = 255
        pattern.radius = circleRadius
        pattern.baseRadius = circleRadius
        pattern.width = graph.layoutBoxes[boxIndex].width
        pattern.height = graph.layoutBoxes[boxIndex].height
        pattern.baseWidth = pattern.width
        pattern.baseHeight = pattern.height
        pattern.shadowOffsetX = tileWidth
        pattern.shadowOffsetY = tileHeight
        pattern.shadowBlur = circleCx
        pattern.shadowSpread = circleCy
        pattern.shadowInset = false
        pattern.gradientEndColor = int64(0)
        pattern.gradientAngle = 0
        pattern.rotationDeg = 0
        pattern.resourceId = ""
        pattern.textContent = ""
        add(graph.paintGradients, pattern)
        return true
    var angle: int32
    var startColor: int64
    var endColor: int64
    var gradientKind: int32
    var centerXPermille: int32
    var centerYPermille: int32
    var radiusPermille: int32
    if WebSceneParseCssLinearGradient(propertyValue, ls, le, angle, startColor, endColor):
        gradientKind = 0
    elif WebSceneParseCssRadialGradient(propertyValue, ls, le, centerXPermille, centerYPermille, radiusPermille, startColor, endColor):
        gradientKind = 1
        angle = 0
    else:
        return false
    var gradient: WebScenePaintOp
    gradient.routeIndex = routeIndex
    gradient.nodeId = nodeId
    gradient.ordinal = opOrdinal
    gradient.x = graph.layoutBoxes[boxIndex].x
    gradient.y = graph.layoutBoxes[boxIndex].y
    gradient.baseX = gradient.x
    gradient.baseY = gradient.y
    gradient.opKind = WebScenePaintGradientFill
    gradient.color = startColor
    gradient.baseColor = startColor
    gradient.opacity = 255
    gradient.baseOpacity = 255
    gradient.radius = WebSceneFindNodePaintRadius(graph, routeIndex, nodeId)
    gradient.baseRadius = gradient.radius
    gradient.width = graph.layoutBoxes[boxIndex].width
    gradient.height = graph.layoutBoxes[boxIndex].height
    gradient.baseWidth = gradient.width
    gradient.baseHeight = gradient.height
    gradient.shadowOffsetX = gradientKind
    gradient.shadowOffsetY = centerXPermille
    gradient.shadowBlur = centerYPermille
    gradient.shadowSpread = radiusPermille
    gradient.shadowInset = false
    gradient.gradientEndColor = endColor
    gradient.gradientAngle = angle
    gradient.rotationDeg = 0
    gradient.resourceId = ""
    gradient.textContent = ""
    add(graph.paintGradients, gradient)
    return true

@borrows
fn WebSceneApplyCssBackgroundImageDeclarationToPaintOps(graph: var WebSceneGraph,
                                                        declaration: WebSceneCssDeclaration): bool =
    if declaration.propertyValue == "none":
        return true
    if WebSceneCssDeclarationTargetNotRendered(graph, declaration):
        return true
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, declaration.routeIndex, declaration.nodeId)
    if boxIndex < 0:
        return true
    if graph.layoutBoxes[boxIndex].width <= 0 || graph.layoutBoxes[boxIndex].height <= 0:
        return true
    # Split comma-separated background-image layers (paren-aware). CSS paints the first
    # layer on top, so collect layer ranges then append in reverse (last-appended = top).
    var layerStarts: int32[]
    var layerEnds: int32[]
    let total = declaration.propertyValue.len
    var cursor: int32
    while cursor < total:
        let nextComma = WebSceneFindTopLevelComma(declaration.propertyValue, cursor)
        if nextComma < 0:
            return false
        let segEnd = WebSceneMinI32(nextComma, total)
        add(layerStarts, cursor)
        add(layerEnds, segEnd)
        if segEnd >= total:
            cursor = total
        else:
            cursor = segEnd + 1
    if layerStarts.len <= 0:
        return false
    var layerOrdinal: int32
    var i = layerStarts.len - 1
    while i >= 0:
        if !WebSceneAppendBackgroundImageLayerOp(graph, declaration.propertyValue, declaration.routeIndex, declaration.nodeId, declaration.ordinal, boxIndex, layerStarts[i], layerEnds[i], layerOrdinal):
            return false
        layerOrdinal = layerOrdinal + 1
        i = i - 1
    return WebSceneMarkCssDeclarationDirty(graph, declaration.routeIndex, declaration.nodeId, true)

@borrows
fn WebSceneApplyCssDeclarationToPaintOps(graph: var WebSceneGraph,
                                         declaration: WebSceneCssDeclaration): bool =
    if declaration.propertyName == "box-shadow":
        return WebSceneApplyCssBoxShadowDeclarationToPaintOps(graph, declaration)
    if declaration.propertyName == "background-image":
        return WebSceneApplyCssBackgroundImageDeclarationToPaintOps(graph, declaration)
    if declaration.propertyName == "background-color":
        return WebSceneApplyCssColorDeclarationToPaintOps(graph, declaration, WebScenePaintFill, false)
    if declaration.propertyName == "border-color":
        return WebSceneApplyCssColorDeclarationToPaintOps(graph, declaration, WebScenePaintBorder, false)
    if declaration.propertyName == "color":
        if WebSceneCssDeclarationHasPseudoCondition(graph, declaration, "placeholder"):
            return WebSceneApplyCssColorDeclarationToPaintOps(graph, declaration, WebScenePaintPlaceholderText, false)
        return WebSceneApplyCssColorDeclarationToPaintOps(graph, declaration, WebScenePaintText, true)
    if declaration.propertyName == "opacity":
        return WebSceneApplyCssOpacityDeclarationToPaintOps(graph, declaration)
    if declaration.propertyName == "transform":
        return WebSceneApplyCssTransformDeclarationToPaintOps(graph, declaration)
    if declaration.propertyName == "pointer-events":
        return WebSceneApplyCssPointerEventsDeclaration(graph, declaration)
    if declaration.propertyName == "border-radius":
        return WebSceneApplyCssBorderRadiusDeclarationToPaintOps(graph, declaration)
    if declaration.propertyName == "width" || declaration.propertyName == "height":
        return WebSceneApplyCssGeometryDeclarationToPaintOps(graph, declaration)
    return false

@borrows
fn WebSceneCssDeclarationIsPaintProperty(propName: str): bool =
    if propName == "box-shadow" || propName == "background-image":
        return true
    if propName == "background-color" || propName == "border-color" || propName == "color":
        return true
    if propName == "opacity" || propName == "transform" || propName == "pointer-events":
        return true
    if propName == "border-radius" || propName == "width" || propName == "height":
        return true
    return false

fn WebSceneClearRouteShadowPaintOps(graph: var WebSceneGraph, routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    var nextShadows: WebScenePaintOp[]
    for i in 0..<graph.paintShadows.len:
        if graph.paintShadows[i].routeIndex != routeIndex:
            var keepShadow: WebScenePaintOp
            if !WebScenePaintOpCloneFromSeq(graph.paintShadows, i, keepShadow):
                return false
            add(nextShadows, keepShadow)
    graph.paintShadows = nextShadows
    return true

fn WebSceneClearRouteGradientPaintOps(graph: var WebSceneGraph, routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    var nextGradients: WebScenePaintOp[]
    for i in 0..<graph.paintGradients.len:
        if graph.paintGradients[i].routeIndex != routeIndex:
            var keepGradient: WebScenePaintOp
            if !WebScenePaintOpCloneFromSeq(graph.paintGradients, i, keepGradient):
                return false
            add(nextGradients, keepGradient)
    graph.paintGradients = nextGradients
    return true

fn WebSceneResetRouteRuntimeStylesToBase(graph: var WebSceneGraph, routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if !WebSceneClearRouteShadowPaintOps(graph, routeIndex):
        return false
    if !WebSceneClearRouteGradientPaintOps(graph, routeIndex):
        return false
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex:
            var changed = false
            if graph.paintOps[i].color != graph.paintOps[i].baseColor:
                graph.paintOps[i].color = graph.paintOps[i].baseColor
                changed = true
            if graph.paintOps[i].opacity != graph.paintOps[i].baseOpacity:
                graph.paintOps[i].opacity = graph.paintOps[i].baseOpacity
                changed = true
            if graph.paintOps[i].radius != graph.paintOps[i].baseRadius:
                graph.paintOps[i].radius = graph.paintOps[i].baseRadius
                changed = true
            if graph.paintOps[i].x != graph.paintOps[i].baseX ||
               graph.paintOps[i].y != graph.paintOps[i].baseY ||
               graph.paintOps[i].width != graph.paintOps[i].baseWidth ||
               graph.paintOps[i].height != graph.paintOps[i].baseHeight:
                graph.paintOps[i].x = graph.paintOps[i].baseX
                graph.paintOps[i].y = graph.paintOps[i].baseY
                graph.paintOps[i].width = graph.paintOps[i].baseWidth
                graph.paintOps[i].height = graph.paintOps[i].baseHeight
                changed = true
            if graph.paintOps[i].rotationDeg != 0:
                graph.paintOps[i].rotationDeg = 0
                changed = true
            if changed:
                if !WebSceneMarkDirtySubtree(graph, graph.paintOps[i].nodeId):
                    return false
    for stateIndex in 0..<graph.nodeStates.len:
        if graph.nodeStates[stateIndex].routeIndex == routeIndex &&
           (graph.nodeStates[stateIndex].pointerEventsSet || graph.nodeStates[stateIndex].pointerEventsNone):
            graph.nodeStates[stateIndex].pointerEventsSet = false
            graph.nodeStates[stateIndex].pointerEventsNone = false
            if !WebSceneMarkDirtySubtree(graph, graph.nodeStates[stateIndex].nodeId):
                return false
    return true

@borrows
fn WebSceneApplyCssVariantRuleToPaintOps(graph: var WebSceneGraph,
                                         rule: WebSceneCssVariantRule): bool =
    if !WebSceneCssVariantRuleMatches(graph, rule):
        return true
    # A matched variant whose node is hidden (conditional render / display:none)
    # has no on-screen paint op to restyle — its text glyph run only materialises
    # once the node is revealed, at which point the reveal/dirty path re-applies
    # variants. Mirror the layout-path guard in WebSceneApplyCssVariantLayoutDeclarationsToTree
    # so an else-branch `color`/`background` on an initially-hidden banner (e.g. a
    # `{msg && <div class={a ? x : y}>{msg}</div>}` status strip whose empty base
    # text has no glyph run) is skipped instead of hard-failing the whole route via
    # the unmatched-color / appliedCount<=0 guards.
    if WebSceneNodeHiddenByNonRenderedContent(graph, rule.routeIndex, rule.nodeId):
        return true
    if WebSceneNodeHiddenByDisplayNone(graph, rule.routeIndex, rule.nodeId):
        return true
    var appliedCount: int32
    for i in 0..<graph.cssDeclarations.len:
        if graph.cssDeclarations[i].routeIndex == rule.routeIndex &&
           graph.cssDeclarations[i].nodeId == rule.nodeId &&
           graph.cssDeclarations[i].ruleOrdinal == rule.ordinal:
            # Paint-ops path only consumes paint properties. Layout-only and
            # retained-renderer noops (cursor/outline/…) must not hard-fail the
            # whole variant — lang_select confirm uses
            # `bg-gray-200 … cursor-not-allowed` and used to die on cssCode=201
            # / propertyCode=999 for `cursor`.
            if !WebSceneCssDeclarationIsPaintProperty(graph.cssDeclarations[i].propertyName):
                appliedCount = appliedCount + 1
                continue
            if !WebSceneApplyCssDeclarationToPaintOps(graph, graph.cssDeclarations[i]):
                WebSceneCssDebugFail(201, graph.cssDeclarations[i])
                return false
            appliedCount = appliedCount + 1
    if appliedCount <= 0:
        WebSceneCssDebugRuleFail(202, rule)
        return false
    return true

fn WebSceneApplyStaticCssDeclarationsToPaintOps(graph: var WebSceneGraph,
                                                routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    for i in 0..<graph.cssDeclarations.len:
        if graph.cssDeclarations[i].routeIndex == routeIndex &&
           graph.cssDeclarations[i].ruleOrdinal < 0:
            if !WebSceneCssDeclarationIsPaintProperty(graph.cssDeclarations[i].propertyName):
                continue
            # A statically-declared target that is currently hidden (conditional
            # render / display:none) has no on-screen paint op to restyle — same
            # reasoning as the WebSceneApplyCssVariantRuleToPaintOps guard below.
            # Without this, replaying the static baseline for an off-screen route
            # (e.g. a data-csg-state-set-ref style refresh that touches a route
            # other than the active one) hard-fails the whole route replay just
            # because some unrelated conditionally-hidden node's static
            # declaration has no matching paint op yet.
            if WebSceneCssDeclarationTargetNotRendered(graph, graph.cssDeclarations[i]):
                continue
            if !WebSceneApplyCssDeclarationToPaintOps(graph, graph.cssDeclarations[i]):
                WebSceneCssDebugFail(101, graph.cssDeclarations[i])
                return false
    return true

fn WebSceneApplyCssVariantRulesToPaintOps(graph: var WebSceneGraph,
                                          routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    WebSceneCssDebugClear()
    if !WebSceneResetRouteRuntimeStylesToBase(graph, routeIndex):
        WebSceneCssFailCode = 301
        WebSceneCssFailRouteIndex = routeIndex
        WebSceneCssFailNodeId = -1
        WebSceneCssFailRuleOrdinal = -1
        WebSceneCssFailDeclarationOrdinal = -1
        WebSceneCssFailPropertyCode = 0
        return false
    if !WebSceneRebuildPaintOpRangeIndex(graph):
        return false
    if !WebSceneApplyStaticCssDeclarationsToPaintOps(graph, routeIndex):
        return false
    for i in 0..<graph.cssVariantRules.len:
        if graph.cssVariantRules[i].routeIndex == routeIndex:
            if !WebSceneApplyCssVariantRuleToPaintOps(graph, graph.cssVariantRules[i]):
                return false
    return true

# K1 down-path: press feedback only needs the pressed node's own variant
# rules layered on top of the on-screen baseline (the next full present or
# event dirty-frame restores it). No route-wide reset/replay.
fn WebSceneApplyCssVariantRulesForNode(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       nodeId: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if !WebSceneRebuildPaintOpRangeIndex(graph):
        return false
    for i in 0..<graph.cssVariantRules.len:
        if graph.cssVariantRules[i].routeIndex == routeIndex &&
           graph.cssVariantRules[i].nodeId == nodeId:
            if !WebSceneApplyCssVariantRuleToPaintOps(graph, graph.cssVariantRules[i]):
                return false
    return true

fn WebSceneNodeHasCssVariantRule(graph: var WebSceneGraph,
                                 routeIndex: int32,
                                 nodeId: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len || nodeId <= 0:
        return false
    for i in 0..<graph.cssVariantRules.len:
        if graph.cssVariantRules[i].routeIndex == routeIndex &&
           graph.cssVariantRules[i].nodeId == nodeId:
            return true
    return false

@borrows
fn WebSceneCssParsePx(value: str, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    if value == "env(safe-area-inset-top)" || value == "env(safe-area-inset-right)" ||
       value == "env(safe-area-inset-bottom)" || value == "env(safe-area-inset-left)":
        return true
    if value == "env(safe-area-inset-top, 0px)" || value == "env(safe-area-inset-right, 0px)" ||
       value == "env(safe-area-inset-bottom, 0px)" || value == "env(safe-area-inset-left, 0px)":
        return true
    if cssvalue.WebCssParsePxLength(value, 0, value.len - 1, out):
        return true
    var px2 = 0
    if !cssvalue.WebCssParsePxLengthPx2(value, 0, value.len - 1, px2):
        return false
    out = (px2 + 1) / 2
    return true

@borrows
fn WebSceneCssParseSignedPx(value: str, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    return WebSceneCssParseSignedPxRange(value, 0, value.len - 1, out)

@borrows
fn WebSceneCssParseSignedPxRange(value: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if cssvalue.WebCssParsePxLength(value, start, stop, out):
        return true
    if start < 0 || start > stop || stop >= value.len:
        return false
    if value[start] == '0' && start == stop:
        return true
    if stop - start + 1 < 3:
        return false
    if value[stop - 1] != 'p' || value[stop] != 'x':
        return false
    var milli: int32
    if !WebSceneParseCssNumberPermilleRange(value, start, stop - 1, milli):
        return false
    out = WebSceneRoundMilliToPx(milli)
    return true

@borrows
fn WebSceneCssParseSpacingPx(value: str,
                             top: var int32,
                             right: var int32,
                             bottom: var int32,
                             left: var int32): bool =
    top = 0
    right = 0
    bottom = 0
    left = 0
    var values: int32[]
    var i = 0
    while i < value.len:
        while i < value.len && cssvalue.WebCssIsWhitespace(value[i]):
            i = i + 1
        if i >= value.len:
            break
        let start = i
        while i < value.len && !cssvalue.WebCssIsWhitespace(value[i]):
            i = i + 1
        let stop = i - 1
        if values.len >= 4:
            return false
        var px = 0
        if cssvalue.WebCssParsePxLength(value, start, stop, px):
            add(values, px)
            continue
        var px2 = 0
        if !cssvalue.WebCssParsePxLengthPx2(value, start, stop, px2):
            return false
        add(values, (px2 + 1) / 2)
    if values.len == 1:
        top = values[0]
        right = values[0]
        bottom = values[0]
        left = values[0]
        return true
    if values.len == 2:
        top = values[0]
        right = values[1]
        bottom = values[0]
        left = values[1]
        return true
    if values.len == 3:
        top = values[0]
        right = values[1]
        bottom = values[2]
        left = values[1]
        return true
    if values.len == 4:
        top = values[0]
        right = values[1]
        bottom = values[2]
        left = values[3]
        return true
    return false

@borrows
fn WebSceneCssParseSignedSpacingPx(value: str,
                                   top: var int32,
                                   right: var int32,
                                   bottom: var int32,
                                   left: var int32): bool =
    top = 0
    right = 0
    bottom = 0
    left = 0
    var values: int32[]
    var i = 0
    while i < value.len:
        while i < value.len && cssvalue.WebCssIsWhitespace(value[i]):
            i = i + 1
        if i >= value.len:
            break
        let start = i
        while i < value.len && !cssvalue.WebCssIsWhitespace(value[i]):
            i = i + 1
        let stop = i - 1
        if values.len >= 4:
            return false
        var px = 0
        if !WebSceneCssParseSignedPxRange(value, start, stop, px):
            return false
        add(values, px)
    if values.len == 1:
        top = values[0]
        right = values[0]
        bottom = values[0]
        left = values[0]
        return true
    if values.len == 2:
        top = values[0]
        right = values[1]
        bottom = values[0]
        left = values[1]
        return true
    if values.len == 3:
        top = values[0]
        right = values[1]
        bottom = values[2]
        left = values[1]
        return true
    if values.len == 4:
        top = values[0]
        right = values[1]
        bottom = values[2]
        left = values[3]
        return true
    return false

@borrows
fn WebSceneCssParsePercent(value: str, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    let parsed = cssvalue.WebCssParsePercentLength(value, 0, value.len - 1, out)
    return parsed

@borrows
fn WebSceneCssParseInt(value: str, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    let parsed = cssvalue.WebCssParseIntValue(value, 0, value.len - 1, out)
    return parsed

@borrows
fn WebSceneCssParseSignedInt(value: str, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    var sign: int32 = 1
    var start: int32
    if value[0] == '-':
        sign = -1
        start = 1
        if start >= value.len:
            return false
    var parsed: int32
    if !cssvalue.WebCssParseIntValue(value, start, value.len - 1, parsed):
        return false
    out = parsed * sign
    return true

@borrows
fn WebSceneCssParseOverflow(value: str, out: var int32): bool =
    out = layout.WebLayoutOverflowVisible
    if value == "hidden":
        out = layout.WebLayoutOverflowHidden
        return true
    if value == "visible":
        out = layout.WebLayoutOverflowVisible
        return true
    if value == "scroll":
        out = layout.WebLayoutOverflowScroll
        return true
    if value == "auto":
        out = layout.WebLayoutOverflowAuto
        return true
    return false

fn WebSceneRoundViewportPermilleToPx(basis: int32, milli: int32): int32 =
    let numer = basis * milli
    if numer >= 0:
        return (numer + 50000) / 100000
    return -((-numer + 50000) / 100000)

@borrows
fn WebSceneCssParseViewportUnitPx(value: str, viewportWidth: int32, viewportHeight: int32, out: var int32): bool =
    out = 0
    if value.len < 3:
        return false
    var basis = 0
    var numberEnd = 0
    if value.len >= 4 && value[value.len - 3] == 'd' && value[value.len - 2] == 'v' && value[value.len - 1] == 'h':
        basis = viewportHeight
        numberEnd = value.len - 3
    elif value[value.len - 2] == 'v' && value[value.len - 1] == 'w':
        basis = viewportWidth
        numberEnd = value.len - 2
    elif value[value.len - 2] == 'v' && value[value.len - 1] == 'h':
        basis = viewportHeight
        numberEnd = value.len - 2
    else:
        return false
    if basis <= 0:
        return false
    var milli = 0
    if !WebSceneParseCssNumberPermilleRange(value, 0, numberEnd, milli):
        return false
    out = WebSceneRoundViewportPermilleToPx(basis, milli)
    return true

@borrows
fn WebSceneCssParseViewportLengthPx(tree: var layout.WebLayoutTree, value: str, out: var int32): bool =
    out = 0
    if WebSceneCssParsePx(value, out):
        return true
    if WebSceneCssParseViewportUnitPx(value, tree.viewportWidth, tree.viewportHeight, out):
        return true
    if value == "calc((100dvh - 202px) * 0.9)":
        var base = tree.viewportHeight - 202
        if base < 0:
            base = 0
        out = (base * 9 + 5) / 10
        return true
    if value == "calc((100dvh - 230px) * 0.9)":
        var base230 = tree.viewportHeight - 230
        if base230 < 0:
            base230 = 0
        out = (base230 * 9 + 5) / 10
        return true
    if value == "calc((100dvh - 206px) * 0.9)":
        var base206 = tree.viewportHeight - 206
        if base206 < 0:
            base206 = 0
        out = (base206 * 9 + 5) / 10
        return true
    if value == "min(252px, 78vw)":
        var vw = 0
        if !WebSceneCssParseViewportUnitPx("78vw", tree.viewportWidth, tree.viewportHeight, vw):
            return false
        out = 252
        if vw < out:
            out = vw
        return true
    if value == "calc(85vh-72px)":
        var vhPx = 0
        if !WebSceneCssParseViewportUnitPx("85vh", tree.viewportWidth, tree.viewportHeight, vhPx):
            return false
        out = vhPx - 72
        if out < 0:
            out = 0
        return true
    var chessBoardWidthCalcValue: str
    if value == "min(92vw, 420px, calc((100dvh - 202px) * 0.9))":
        chessBoardWidthCalcValue = "calc((100dvh - 202px) * 0.9)"
    if value == "min(92vw, 420px, calc((100dvh - 230px) * 0.9))":
        chessBoardWidthCalcValue = "calc((100dvh - 230px) * 0.9)"
    if value == "min(92vw, 420px, calc((100dvh - 206px) * 0.9))":
        chessBoardWidthCalcValue = "calc((100dvh - 206px) * 0.9)"
    if chessBoardWidthCalcValue != "":
        var vwMin = 0
        var calcPx = 0
        if !WebSceneCssParseViewportUnitPx("92vw", tree.viewportWidth, tree.viewportHeight, vwMin):
            return false
        if !WebSceneCssParseViewportLengthPx(tree, chessBoardWidthCalcValue, calcPx):
            return false
        out = vwMin
        if 420 < out:
            out = 420
        if calcPx < out:
            out = calcPx
        return true
    return false

@borrows
fn WebSceneCssParseLineHeightPx2(value: str, fontSize: int32, out: var int32): bool =
    out = 0
    if value.len <= 0:
        return false
    let parsed = cssvalue.WebCssParseLineHeightPx2(value, 0, value.len - 1, fontSize, out)
    return parsed

@borrows
fn WebSceneCssParseLineHeight(value: str, outLineHeight: var int32, outLineHeightPx2: var int32): bool =
    outLineHeight = 0
    outLineHeightPx2 = 0
    if value.len <= 0:
        return false
    if cssvalue.WebCssParsePxLengthPx2(value, 0, value.len - 1, outLineHeightPx2):
        return true
    var scaled: int32
    if !cssvalue.WebCssParseUnitlessNumberScale1000(value, 0, value.len - 1, scaled):
        return false
    outLineHeight = 0 - scaled
    return true

@borrows
fn WebSceneCssAppendGridTrackToken(template: str,
                                   tokenStart: int32,
                                   tokenStop: int32,
                                   sizes: var int32[],
                                   units: var int32[]): bool =
    if tokenStop < tokenStart:
        return true
    let tokenLen = tokenStop - tokenStart + 1
    if tokenLen < 3:
        return true
    if template[tokenStop - 1] == 'p' && template[tokenStop] == 'x':
        var val: int32
        for j in tokenStart..<tokenStop - 1:
            let digit = template[j]
            if digit >= '0' && digit <= '9':
                val = val * 10 + int32(digit) - int32('0')
            else:
                return false
        add(sizes, val)
        add(units, 0)
        return true
    if template[tokenStop] == '%':
        var val: int32
        for j in tokenStart..<tokenStop:
            let digit = template[j]
            if digit >= '0' && digit <= '9':
                val = val * 10 + int32(digit) - int32('0')
            else:
                return false
        add(sizes, val)
        add(units, 2)
    return true

@borrows
fn WebSceneCssParseGridPxTrack(template: str,
                               kind: int32,
                               nodeId: int32,
                               tree: var layout.WebLayoutTree): bool =
    if template.len == 0:
        return true
    var sizes: int32[]
    var units: int32[]
    var tokenStart: int32
    var i: int32
    while i < template.len:
        let ch = template[i]
        if cssvalue.WebCssIsWhitespace(ch):
            if i > tokenStart:
                if !WebSceneCssAppendGridTrackToken(template, tokenStart, i - 1, sizes, units):
                    return false
            tokenStart = i + 1
        i = i + 1
    if i > tokenStart:
        if !WebSceneCssAppendGridTrackToken(template, tokenStart, i - 1, sizes, units):
            return false
    if sizes.len == 0:
        return true
    let applied = layout.WebLayoutSetGridTracks(tree, nodeId, kind, sizes, units)
    return applied

@borrows
fn WebSceneTagIsPhrasing(tagName: str): bool =
    if tagName == "span":
        return true
    if tagName == "a":
        return true
    if tagName == "b":
        return true
    if tagName == "i":
        return true
    if tagName == "em":
        return true
    if tagName == "strong":
        return true
    if tagName == "code":
        return true
    if tagName == "small":
        return true
    if tagName == "abbr":
        return true
    if tagName == "sub":
        return true
    if tagName == "sup":
        return true
    if tagName == "label":
        return true
    if tagName == "cite":
        return true
    if tagName == "time":
        return true
    if tagName == "mark":
        return true
    if tagName == "u":
        return true
    if tagName == "s":
        return true
    return false

@borrows
fn WebSceneTagIsInlineFormOrMedia(tagName: str): bool =
    if tagName == "input":
        return true
    if tagName == "select":
        return true
    if tagName == "textarea":
        return true
    if tagName == "img":
        return true
    if tagName == "canvas":
        return true
    return false

@borrows
fn WebSceneTagIsTableLike(tagName: str): bool =
    if tagName == "table":
        return true
    if tagName == "tr":
        return true
    if tagName == "td":
        return true
    if tagName == "th":
        return true
    if tagName == "thead":
        return true
    if tagName == "tbody":
        return true
    if tagName == "tfoot":
        return true
    if tagName == "caption":
        return true
    if tagName == "colgroup":
        return true
    if tagName == "col":
        return true
    return false

@borrows
fn WebSceneUADisplay(tagName: str): int32 =
    if WebSceneTagIsPhrasing(tagName):
        return layout.WebLayoutDisplayInline
    if tagName == "button":
        return layout.WebLayoutDisplayBlock
    if WebSceneTagIsInlineFormOrMedia(tagName):
        return layout.WebLayoutDisplayInline
    if WebSceneTagIsTableLike(tagName):
        return layout.WebLayoutDisplayTable
    return layout.WebLayoutDisplayBlock

@borrows
fn WebSceneTableRole(tagName: str): int32 =
    if tagName == "table":
        return layout.WebLayoutTableRoleTable
    if tagName == "thead":
        return layout.WebLayoutTableRoleSection
    if tagName == "tbody":
        return layout.WebLayoutTableRoleSection
    if tagName == "tfoot":
        return layout.WebLayoutTableRoleSection
    if tagName == "tr":
        return layout.WebLayoutTableRoleRow
    if tagName == "td":
        return layout.WebLayoutTableRoleCell
    if tagName == "th":
        return layout.WebLayoutTableRoleCell
    return layout.WebLayoutTableRoleNone

fn WebSceneLayoutStyleIndex(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    return layout.WebLayoutFindStyleIndex(tree, nodeId)

@borrows
fn WebSceneApplyLayoutDimension(tree: var layout.WebLayoutTree, styleIndex: int32, propName: str, propValue: str): bool =
    var px = 0
    var percent = 0
    if propName == "width":
        if WebSceneCssParseViewportLengthPx(tree, propValue, px):
            tree.styles[styleIndex].width = px
            return true
        if WebSceneCssParsePercent(propValue, percent):
            tree.styles[styleIndex].width = 0 - percent
            return true
        return false
    if propName == "height":
        if propValue == "auto":
            tree.styles[styleIndex].height = 0
            return true
        if WebSceneCssParseViewportLengthPx(tree, propValue, px):
            tree.styles[styleIndex].height = px
            return true
        if WebSceneCssParsePercent(propValue, percent):
            tree.styles[styleIndex].height = 0 - percent
            return true
        return false
    if propName == "min-width":
        if WebSceneCssParseViewportLengthPx(tree, propValue, px):
            tree.styles[styleIndex].minWidth = px
            tree.styles[styleIndex].hasMinWidth = true
            return true
        if WebSceneCssParsePercent(propValue, percent):
            tree.styles[styleIndex].minWidth = 0 - percent
            tree.styles[styleIndex].hasMinWidth = true
            return true
        return false
    if propName == "max-width":
        if WebSceneCssParseViewportLengthPx(tree, propValue, px):
            tree.styles[styleIndex].maxWidth = px
            return true
        if WebSceneCssParsePercent(propValue, percent):
            tree.styles[styleIndex].maxWidth = 0 - percent
            return true
        return false
    if propName == "min-height":
        if WebSceneCssParseViewportLengthPx(tree, propValue, px):
            tree.styles[styleIndex].minHeight = px
            return true
        if WebSceneCssParsePercent(propValue, percent):
            tree.styles[styleIndex].minHeight = 0 - percent
            return true
        return false
    if propName == "max-height":
        if WebSceneCssParseViewportLengthPx(tree, propValue, px):
            tree.styles[styleIndex].maxHeight = px
            return true
        if WebSceneCssParsePercent(propValue, percent):
            tree.styles[styleIndex].maxHeight = 0 - percent
            return true
        return false
    return false

@borrows
fn WebSceneCssParseAspectRatio(value: str, outNumerator: var int32, outDenominator: var int32): bool =
    outNumerator = 0
    outDenominator = 0
    var start: int32
    var stop: int32
    if !WebSceneTrimCssRange(value, 0, value.len, start, stop):
        return false
    if start >= stop:
        return false
    let slash = WebSceneFindChar(value, start, stop, '/')
    if slash < 0:
        var singleNumerator = 0
        if !WebSceneParseCssNumberPermilleRange(value, start, stop, singleNumerator):
            return false
        if singleNumerator <= 0:
            return false
        outNumerator = singleNumerator
        outDenominator = 1000
        return true
    if WebSceneFindChar(value, slash + 1, stop, '/') >= 0:
        return false
    var numeratorStart: int32
    var numeratorStop: int32
    var denominatorStart: int32
    var denominatorStop: int32
    if !WebSceneTrimCssRange(value, start, slash, numeratorStart, numeratorStop):
        return false
    if !WebSceneTrimCssRange(value, slash + 1, stop, denominatorStart, denominatorStop):
        return false
    var numerator = 0
    var denominator = 0
    if !WebSceneParseCssNumberPermilleRange(value, numeratorStart, numeratorStop, numerator):
        return false
    if !WebSceneParseCssNumberPermilleRange(value, denominatorStart, denominatorStop, denominator):
        return false
    if numerator <= 0 || denominator <= 0:
        return false
    outNumerator = numerator
    outDenominator = denominator
    return true

@borrows
fn WebSceneApplyLayoutBoxSpacing(tree: var layout.WebLayoutTree, styleIndex: int32, propName: str, propValue: str): bool =
    var px = 0
    var top = 0
    var right = 0
    var bottom = 0
    var left = 0
    if propName == "margin":
        if propValue == "auto":
            tree.styles[styleIndex].marginLeft = 0
            tree.styles[styleIndex].marginTop = 0
            tree.styles[styleIndex].marginRight = 0
            tree.styles[styleIndex].marginBottom = 0
            tree.styles[styleIndex].marginLeftAuto = true
            tree.styles[styleIndex].marginTopAuto = true
            tree.styles[styleIndex].marginRightAuto = true
            tree.styles[styleIndex].marginBottomAuto = true
            return true
        if !WebSceneCssParseSignedSpacingPx(propValue, top, right, bottom, left):
            return false
        tree.styles[styleIndex].marginLeft = left
        tree.styles[styleIndex].marginTop = top
        tree.styles[styleIndex].marginRight = right
        tree.styles[styleIndex].marginBottom = bottom
        tree.styles[styleIndex].marginLeftAuto = false
        tree.styles[styleIndex].marginTopAuto = false
        tree.styles[styleIndex].marginRightAuto = false
        tree.styles[styleIndex].marginBottomAuto = false
        return true
    if propName == "margin-left":
        if propValue == "auto":
            tree.styles[styleIndex].marginLeft = 0
            tree.styles[styleIndex].marginLeftAuto = true
            return true
        tree.styles[styleIndex].marginLeftAuto = false
        if !WebSceneCssParseSignedPx(propValue, px):
            return false
        tree.styles[styleIndex].marginLeft = px
        return true
    if propName == "margin-top":
        if propValue == "auto":
            tree.styles[styleIndex].marginTop = 0
            tree.styles[styleIndex].marginTopAuto = true
            return true
        tree.styles[styleIndex].marginTopAuto = false
        if !WebSceneCssParseSignedPx(propValue, px):
            return false
        tree.styles[styleIndex].marginTop = px
        return true
    if propName == "margin-right":
        if propValue == "auto":
            tree.styles[styleIndex].marginRight = 0
            tree.styles[styleIndex].marginRightAuto = true
            return true
        tree.styles[styleIndex].marginRightAuto = false
        if !WebSceneCssParseSignedPx(propValue, px):
            return false
        tree.styles[styleIndex].marginRight = px
        return true
    if propName == "margin-bottom":
        if propValue == "auto":
            tree.styles[styleIndex].marginBottom = 0
            tree.styles[styleIndex].marginBottomAuto = true
            return true
        tree.styles[styleIndex].marginBottomAuto = false
        if !WebSceneCssParseSignedPx(propValue, px):
            return false
        tree.styles[styleIndex].marginBottom = px
        return true
    if propName == "padding":
        if !WebSceneCssParseSpacingPx(propValue, top, right, bottom, left):
            return false
        tree.styles[styleIndex].paddingLeft = left
        tree.styles[styleIndex].paddingTop = top
        tree.styles[styleIndex].paddingRight = right
        tree.styles[styleIndex].paddingBottom = bottom
        return true
    if propName == "padding-left":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].paddingLeft = px
        return true
    if propName == "padding-top":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].paddingTop = px
        return true
    if propName == "padding-right":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].paddingRight = px
        return true
    if propName == "padding-bottom":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].paddingBottom = px
        return true
    if propName == "border-width":
        if !WebSceneCssParseSpacingPx(propValue, top, right, bottom, left):
            return false
        tree.styles[styleIndex].borderTopWidth = top
        tree.styles[styleIndex].borderRightWidth = right
        tree.styles[styleIndex].borderBottomWidth = bottom
        tree.styles[styleIndex].borderLeftWidth = left
        return true
    if propName == "border-top-width":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].borderTopWidth = px
        return true
    if propName == "border-right-width":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].borderRightWidth = px
        return true
    if propName == "border-bottom-width":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].borderBottomWidth = px
        return true
    if propName == "border-left-width":
        if !WebSceneCssParsePx(propValue, px):
            return false
        tree.styles[styleIndex].borderLeftWidth = px
        return true
    return false

@borrows
fn WebSceneApplyLayoutConstraintToTree(tree: var layout.WebLayoutTree, nodeId: int32, propName: str, propValue: str): bool =
    let styleIndex = WebSceneLayoutStyleIndex(tree, nodeId)
    if styleIndex < 0:
        return false
    if nodeId == 771:
        echo(Fmt"CST nid={nodeId} si={styleIndex} p={propName} v={propValue}")
    if propName == "display":
        if propValue == "none":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayNone
        elif propValue == "block":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayBlock
        elif propValue == "-webkit-box":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayBlock
        elif propValue == "inline":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayInline
        elif propValue == "flex" || propValue == "inline-flex":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayFlex
            if propValue == "inline-flex":
                tree.styles[styleIndex].inlineLevel = true
        elif propValue == "grid" || propValue == "inline-grid":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayGrid
            if propValue == "inline-grid":
                tree.styles[styleIndex].inlineLevel = true
        elif propValue == "masonry":
            tree.styles[styleIndex].display = layout.WebLayoutDisplayMasonry
        else:
            return false
        return true
    if propName == "width" || propName == "height" || propName == "min-width" || propName == "max-width" || propName == "min-height" || propName == "max-height":
        return WebSceneApplyLayoutDimension(tree, styleIndex, propName, propValue)
    if propName == "aspect-ratio":
        if propValue == "auto":
            tree.styles[styleIndex].aspectRatioNumerator = 0
            tree.styles[styleIndex].aspectRatioDenominator = 0
            return true
        var ratioNumerator: int32
        var ratioDenominator: int32
        if !WebSceneCssParseAspectRatio(propValue, ratioNumerator, ratioDenominator):
            return false
        tree.styles[styleIndex].aspectRatioNumerator = ratioNumerator
        tree.styles[styleIndex].aspectRatioDenominator = ratioDenominator
        if tree.styles[styleIndex].height <= 0:
            let ratioHeight = layout.WebLayoutAspectRatioHeightForWidth(tree, styleIndex, tree.styles[styleIndex].width)
            if ratioHeight > 0:
                tree.styles[styleIndex].height = ratioHeight
        return true
    if propName == "margin" || propName == "margin-left" || propName == "margin-top" || propName == "margin-right" || propName == "margin-bottom" ||
       propName == "padding" || propName == "padding-left" || propName == "padding-top" || propName == "padding-right" || propName == "padding-bottom" ||
       propName == "border-width" || propName == "border-top-width" || propName == "border-right-width" || propName == "border-bottom-width" || propName == "border-left-width":
        return WebSceneApplyLayoutBoxSpacing(tree, styleIndex, propName, propValue)
    if propName == "flex-direction":
        if propValue == "row":
            tree.styles[styleIndex].flexDirection = layout.WebLayoutFlexDirectionRow
        elif propValue == "column":
            tree.styles[styleIndex].flexDirection = layout.WebLayoutFlexDirectionColumn
        else:
            return false
        return true
    if propName == "justify-content":
        if propValue == "flex-start" || propValue == "start":
            tree.styles[styleIndex].justifyContent = layout.WebLayoutJustifyContentFlexStart
        elif propValue == "center":
            tree.styles[styleIndex].justifyContent = layout.WebLayoutJustifyContentCenter
        elif propValue == "flex-end" || propValue == "end":
            tree.styles[styleIndex].justifyContent = layout.WebLayoutJustifyContentFlexEnd
        elif propValue == "space-between":
            tree.styles[styleIndex].justifyContent = layout.WebLayoutJustifyContentSpaceBetween
        elif propValue == "space-around":
            tree.styles[styleIndex].justifyContent = layout.WebLayoutJustifyContentSpaceAround
        else:
            return false
        return true
    if propName == "align-items":
        if propValue == "flex-start" || propValue == "start":
            tree.styles[styleIndex].alignItems = layout.WebLayoutAlignItemsFlexStart
        elif propValue == "center":
            tree.styles[styleIndex].alignItems = layout.WebLayoutAlignItemsCenter
        elif propValue == "flex-end" || propValue == "end":
            tree.styles[styleIndex].alignItems = layout.WebLayoutAlignItemsFlexEnd
        elif propValue == "stretch":
            tree.styles[styleIndex].alignItems = layout.WebLayoutAlignItemsStretch
        elif propValue == "baseline":
            tree.styles[styleIndex].alignItems = layout.WebLayoutAlignItemsBaseline
        else:
            return false
        return true
    if propName == "flex":
        var flexVal = 0
        if !WebSceneCssParseInt(propValue, flexVal):
            return false
        tree.styles[styleIndex].flex = flexVal
        return true
    if propName == "flex-shrink":
        var shrinkVal = 0
        if !WebSceneCssParseInt(propValue, shrinkVal):
            return false
        if shrinkVal < 0:
            return false
        tree.styles[styleIndex].flexShrink = shrinkVal
        return true
    if propName == "gap" || propName == "column-gap" || propName == "row-gap":
        var gapPx = 0
        if !WebSceneCssParsePx(propValue, gapPx):
            return false
        tree.styles[styleIndex].gap = gapPx
        return true
    if propName == "data-csg-masonry-min-column-width":
        var minColumnWidth = 0
        if !WebSceneCssParseInt(propValue, minColumnWidth):
            return false
        if minColumnWidth <= 0:
            return false
        tree.styles[styleIndex].masonryMinColumnWidth = minColumnWidth
        return true
    if propName == "data-csg-masonry-min-columns":
        var minColumns = 0
        if !WebSceneCssParseInt(propValue, minColumns):
            return false
        if minColumns <= 0:
            return false
        tree.styles[styleIndex].masonryMinColumns = minColumns
        if tree.styles[styleIndex].masonryMaxColumns < minColumns:
            tree.styles[styleIndex].masonryMaxColumns = minColumns
        return true
    if propName == "data-csg-masonry-max-columns":
        var maxColumns = 0
        if !WebSceneCssParseInt(propValue, maxColumns):
            return false
        if maxColumns <= 0:
            return false
        tree.styles[styleIndex].masonryMaxColumns = maxColumns
        if tree.styles[styleIndex].masonryMinColumns > maxColumns:
            tree.styles[styleIndex].masonryMinColumns = maxColumns
        return true
    if propName == "data-csg-masonry-estimated-item-height":
        var estimatedItemHeight = 0
        if !WebSceneCssParseInt(propValue, estimatedItemHeight):
            return false
        if estimatedItemHeight <= 0:
            return false
        tree.styles[styleIndex].masonryEstimatedItemHeight = estimatedItemHeight
        return true
    if propName == "data-csg-masonry-model":
        if propValue == "virtualized-react":
            return layout.WebLayoutSetMasonryModel(tree, nodeId, layout.WebLayoutMasonryModelVirtualizedReact)
        if propValue == "":
            return true
        return false
    if propName == "font-size":
        var fontSize = 0
        if !WebSceneCssParsePx(propValue, fontSize):
            return false
        tree.styles[styleIndex].fontSize = fontSize
        tree.styles[styleIndex].renderFontSize = fontSize
        tree.styles[styleIndex].fontSizeExplicit = true
        return true
    if propName == "line-height":
        var lineHeight = 0
        var lineHeightPx2 = 0
        if !WebSceneCssParseLineHeight(propValue, lineHeight, lineHeightPx2):
            return false
        tree.styles[styleIndex].lineHeight = lineHeight
        tree.styles[styleIndex].lineHeightPx2 = lineHeightPx2
        tree.styles[styleIndex].lineHeightExplicit = true
        return true
    if propName == "font-weight":
        var weight = 0
        if !WebSceneCssParseInt(propValue, weight):
            return false
        tree.styles[styleIndex].renderFontWeight = weight
        tree.styles[styleIndex].fontWeightExplicit = true
        return true
    if propName == "font-family":
        if propValue == "ui-monospace" || propValue == "monospace":
            tree.styles[styleIndex].fontFamily = layout.WebLayoutFontFamilyMono
        else:
            tree.styles[styleIndex].fontFamily = layout.WebLayoutFontFamilySans
        tree.styles[styleIndex].fontFamilyExplicit = true
        return true
    if propName == "grid-template-columns":
        let applied = WebSceneCssParseGridPxTrack(propValue, 0, nodeId, tree)
        return applied
    if propName == "grid-template-rows":
        let applied = WebSceneCssParseGridPxTrack(propValue, 1, nodeId, tree)
        return applied
    if propName == "position":
        if propValue == "static":
            tree.styles[styleIndex].position = layout.WebLayoutPositionStatic
        elif propValue == "relative":
            tree.styles[styleIndex].position = layout.WebLayoutPositionRelative
        elif propValue == "absolute":
            tree.styles[styleIndex].position = layout.WebLayoutPositionAbsolute
        elif propValue == "fixed":
            tree.styles[styleIndex].position = layout.WebLayoutPositionFixed
        elif propValue == "sticky":
            tree.styles[styleIndex].position = layout.WebLayoutPositionSticky
        else:
            return false
        return true
    if propName == "z-index":
        var z = 0
        if propValue == "auto":
            tree.styles[styleIndex].zIndex = 0
            return true
        if !WebSceneCssParseSignedInt(propValue, z):
            return false
        tree.styles[styleIndex].zIndex = z
        return true
    if propName == "top" || propName == "right" || propName == "bottom" || propName == "left":
        var offset = 0
        if WebSceneCssParseSignedPx(propValue, offset):
            if propName == "top":
                return layout.WebLayoutSetOffsetTop(tree, nodeId, offset)
            if propName == "right":
                return layout.WebLayoutSetOffsetRight(tree, nodeId, offset)
            if propName == "bottom":
                return layout.WebLayoutSetOffsetBottom(tree, nodeId, offset)
            return layout.WebLayoutSetOffsetLeft(tree, nodeId, offset)
        var percent = 0
        if !WebSceneCssParsePercent(propValue, percent):
            return false
        if propName == "top":
            return layout.WebLayoutSetOffsetTopPercent(tree, nodeId, percent)
        if propName == "right":
            return layout.WebLayoutSetOffsetRightPercent(tree, nodeId, percent)
        if propName == "bottom":
            return layout.WebLayoutSetOffsetBottomPercent(tree, nodeId, percent)
        return layout.WebLayoutSetOffsetLeftPercent(tree, nodeId, percent)
    if propName == "overflow" || propName == "overflow-x" || propName == "overflow-y":
        var overflow = layout.WebLayoutOverflowVisible
        if !WebSceneCssParseOverflow(propValue, overflow):
            return false
        if propName == "overflow" || propName == "overflow-x":
            tree.styles[styleIndex].overflowX = overflow
        if propName == "overflow" || propName == "overflow-y":
            tree.styles[styleIndex].overflowY = overflow
        return true
    if propName == "text-align":
        if propValue == "left":
            tree.styles[styleIndex].textAlign = layout.WebLayoutTextAlignLeft
        elif propValue == "center":
            tree.styles[styleIndex].textAlign = layout.WebLayoutTextAlignCenter
        elif propValue == "right":
            tree.styles[styleIndex].textAlign = layout.WebLayoutTextAlignRight
        else:
            return false
        tree.styles[styleIndex].textAlignExplicit = true
        return true
    if propName == "text-overflow":
        if propValue == "ellipsis":
            tree.styles[styleIndex].textOverflowEllipsis = true
        elif propValue != "clip":
            return false
        return true
    if propName == "white-space":
        if propValue == "nowrap" || propValue == "pre":
            tree.styles[styleIndex].whiteSpaceNowrap = true
        elif propValue == "normal" || propValue == "pre-wrap" || propValue == "pre-line":
            tree.styles[styleIndex].whiteSpaceNowrap = false
        else:
            return false
        tree.styles[styleIndex].whiteSpaceExplicit = true
        return true
    if propName == "word-break":
        if propValue == "break-all":
            tree.styles[styleIndex].wordBreakBreakAll = true
        elif propValue != "normal":
            return false
        tree.styles[styleIndex].wordBreakExplicit = true
        return true
    if propName == "flex-wrap":
        if propValue == "wrap":
            tree.styles[styleIndex].flexWrap = 1
        elif propValue == "nowrap":
            tree.styles[styleIndex].flexWrap = 0
        else:
            return false
        return true
    if propName == "align-content":
        if propValue == "flex-start":
            tree.styles[styleIndex].alignContent = layout.WebLayoutAlignContentFlexStart
        elif propValue == "flex-end":
            tree.styles[styleIndex].alignContent = layout.WebLayoutAlignContentFlexEnd
        elif propValue == "center":
            tree.styles[styleIndex].alignContent = layout.WebLayoutAlignContentCenter
        elif propValue == "stretch":
            tree.styles[styleIndex].alignContent = layout.WebLayoutAlignContentStretch
        elif propValue == "space-between":
            tree.styles[styleIndex].alignContent = layout.WebLayoutAlignContentSpaceBetween
        elif propValue == "space-around":
            tree.styles[styleIndex].alignContent = layout.WebLayoutAlignContentSpaceAround
        else:
            return false
        return true
    if propName == "align-self":
        if propValue == "auto":
            tree.styles[styleIndex].alignSelf = layout.WebLayoutAlignSelfAuto
        elif propValue == "flex-start":
            tree.styles[styleIndex].alignSelf = layout.WebLayoutAlignSelfFlexStart
        elif propValue == "flex-end":
            tree.styles[styleIndex].alignSelf = layout.WebLayoutAlignSelfFlexEnd
        elif propValue == "center":
            tree.styles[styleIndex].alignSelf = layout.WebLayoutAlignSelfCenter
        elif propValue == "baseline":
            tree.styles[styleIndex].alignSelf = layout.WebLayoutAlignSelfBaseline
        elif propValue == "stretch":
            tree.styles[styleIndex].alignSelf = layout.WebLayoutAlignSelfStretch
        else:
            return false
        return true
    if propName == "order":
        var order = 0
        if !WebSceneCssParseSignedInt(propValue, order):
            return false
        tree.styles[styleIndex].order = order
        return true
    if propName == "box-sizing":
        if propValue == "border-box":
            tree.styles[styleIndex].boxSizing = layout.WebLayoutBoxSizingBorderBox
        elif propValue == "content-box":
            tree.styles[styleIndex].boxSizing = layout.WebLayoutBoxSizingContentBox
        else:
            return false
        return true
    if propName == "flex-flow" || propName == "grid-column" || propName == "grid-row" || propName == "grid-area" || propName == "aspect-ratio":
        return true
    return false

@borrows
fn WebSceneCssDeclarationIsLayoutProperty(propName: str): bool =
    if propName == "display":
        return true
    if propName == "width" || propName == "height" || propName == "min-width" || propName == "max-width" || propName == "min-height" || propName == "max-height":
        return true
    if propName == "aspect-ratio":
        return true
    if propName == "margin" || propName == "margin-left" || propName == "margin-top" || propName == "margin-right" || propName == "margin-bottom":
        return true
    if propName == "padding" || propName == "padding-left" || propName == "padding-top" || propName == "padding-right" || propName == "padding-bottom":
        return true
    if propName == "border-width" || propName == "border-top-width" || propName == "border-right-width" || propName == "border-bottom-width" || propName == "border-left-width":
        return true
    if propName == "flex-direction" || propName == "justify-content" || propName == "align-items" || propName == "align-self" || propName == "align-content":
        return true
    if propName == "flex" || propName == "flex-shrink" || propName == "flex-wrap" || propName == "flex-flow" || propName == "order":
        return true
    if propName == "gap" || propName == "column-gap" || propName == "row-gap":
        return true
    if propName == "data-csg-masonry-min-column-width" || propName == "data-csg-masonry-min-columns" ||
       propName == "data-csg-masonry-max-columns" || propName == "data-csg-masonry-estimated-item-height" ||
       propName == "data-csg-masonry-model":
        return true
    if propName == "font-size" || propName == "line-height" || propName == "font-weight" || propName == "font-family":
        return true
    if propName == "grid-template-columns" || propName == "grid-template-rows" || propName == "grid-column" || propName == "grid-row" || propName == "grid-area":
        return true
    if propName == "position" || propName == "z-index" || propName == "top" || propName == "right" || propName == "bottom" || propName == "left":
        return true
    if propName == "overflow" || propName == "overflow-x" || propName == "overflow-y":
        return true
    if propName == "text-align" || propName == "text-overflow" || propName == "white-space" || propName == "word-break":
        return true
    if propName == "box-sizing":
        return true
    return false

fn WebSceneApplyCssVariantLayoutDeclarationsToTree(graph: var WebSceneGraph,
                                                   routeIndex: int32,
                                                   tree: var layout.WebLayoutTree): bool =
    for ruleIndex in 0..<graph.cssVariantRules.len:
        let rule = graph.cssVariantRules[ruleIndex]
        if rule.routeIndex != routeIndex:
            continue
        if !WebSceneCssVariantRuleMatches(graph, rule):
            continue
        # A rule whose node is not in the layout tree (hidden by non-rendered
        # content or display:none) has no style entry to constrain — mirror the
        # static-constraint guard above so a matched variant's layout declaration
        # (e.g. an else-branch `border ...` on an initially-hidden sort button /
        # sub-tab) is skipped instead of hard-failing the whole route.
        if WebSceneNodeHiddenByNonRenderedContent(graph, routeIndex, rule.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, rule.nodeId):
            continue
        for declarationIndex in 0..<graph.cssDeclarations.len:
            let declaration = graph.cssDeclarations[declarationIndex]
            if declaration.routeIndex == routeIndex &&
               declaration.nodeId == rule.nodeId &&
               declaration.ruleOrdinal == rule.ordinal &&
               WebSceneCssDeclarationIsLayoutProperty(declaration.propertyName):
                if !WebSceneApplyLayoutConstraintToTree(tree, declaration.nodeId, declaration.propertyName, declaration.propertyValue):
                    WebSceneLayoutDebugFail(110, routeIndex, declaration.nodeId, declaration.ordinal)
                    return false
    return true

# Set true by InheritLayoutStylesFromParent whenever it actually mutates a
# child style, so the fixed-point pass loop can stop the frame inheritance
# converges instead of running tree.styles.len passes. Module scalar (reliable
# cross-call write) rather than a var-param.
var __webSceneInheritChanged: bool

fn WebSceneInheritLayoutStylesFromParent(tree: var layout.WebLayoutTree,
                                         childStyleIndex: int32,
                                         parentStyleIndex: int32): bool =
    if childStyleIndex < 0 || childStyleIndex >= tree.styles.len:
        return false
    if parentStyleIndex < 0 || parentStyleIndex >= tree.styles.len:
        return false
    if !tree.styles[childStyleIndex].fontSizeExplicit:
        if tree.styles[childStyleIndex].fontSize != tree.styles[parentStyleIndex].fontSize:
            __webSceneInheritChanged = true
        if tree.styles[childStyleIndex].renderFontSize != tree.styles[parentStyleIndex].renderFontSize:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].fontSize = tree.styles[parentStyleIndex].fontSize
        tree.styles[childStyleIndex].renderFontSize = tree.styles[parentStyleIndex].renderFontSize
    if !tree.styles[childStyleIndex].lineHeightExplicit:
        if tree.styles[childStyleIndex].lineHeight != tree.styles[parentStyleIndex].lineHeight:
            __webSceneInheritChanged = true
        if tree.styles[childStyleIndex].lineHeightPx2 != tree.styles[parentStyleIndex].lineHeightPx2:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].lineHeight = tree.styles[parentStyleIndex].lineHeight
        tree.styles[childStyleIndex].lineHeightPx2 = tree.styles[parentStyleIndex].lineHeightPx2
    if !tree.styles[childStyleIndex].fontWeightExplicit:
        if tree.styles[childStyleIndex].renderFontWeight != tree.styles[parentStyleIndex].renderFontWeight:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].renderFontWeight = tree.styles[parentStyleIndex].renderFontWeight
    if !tree.styles[childStyleIndex].fontFamilyExplicit:
        if tree.styles[childStyleIndex].fontFamily != tree.styles[parentStyleIndex].fontFamily:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].fontFamily = tree.styles[parentStyleIndex].fontFamily
    if !tree.styles[childStyleIndex].textAlignExplicit:
        if tree.styles[childStyleIndex].textAlign != tree.styles[parentStyleIndex].textAlign:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].textAlign = tree.styles[parentStyleIndex].textAlign
    if !tree.styles[childStyleIndex].whiteSpaceExplicit:
        if tree.styles[childStyleIndex].whiteSpaceNowrap != tree.styles[parentStyleIndex].whiteSpaceNowrap:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].whiteSpaceNowrap = tree.styles[parentStyleIndex].whiteSpaceNowrap
    if !tree.styles[childStyleIndex].wordBreakExplicit:
        if tree.styles[childStyleIndex].wordBreakBreakAll != tree.styles[parentStyleIndex].wordBreakBreakAll:
            __webSceneInheritChanged = true
        tree.styles[childStyleIndex].wordBreakBreakAll = tree.styles[parentStyleIndex].wordBreakBreakAll
    return true

fn WebSceneInheritLayoutStyles(graph: var WebSceneGraph,
                               routeIndex: int32,
                               tree: var layout.WebLayoutTree): bool =
    # Fixed-point inheritance: each pass propagates parent→child one level, so it
    # converges in tree-depth passes, not tree.styles.len passes. Stop as soon as
    # a full pass mutates nothing — same result, no wasted O(styles·nodes) sweeps
    # (home launch build was dominated by this loop running hundreds of passes).
    var pass: int32
    while pass < tree.styles.len:
        __webSceneInheritChanged = false
        for i in 0..<graph.nodes.len:
            let node = graph.nodes[i]
            if node.routeIndex != routeIndex:
                continue
            let styleIndex = layout.WebLayoutFindStyleIndex(tree, node.nodeId)
            if styleIndex < 0:
                continue
            let parentNodeId = layout.WebLayoutParentOf(tree, node.nodeId)
            if parentNodeId <= 0:
                continue
            let parentStyleIndex = layout.WebLayoutFindStyleIndex(tree, parentNodeId)
            if parentStyleIndex < 0:
                continue
            if !WebSceneInheritLayoutStylesFromParent(tree, styleIndex, parentStyleIndex):
                return false
        if !__webSceneInheritChanged:
            return true
        pass = pass + 1
    return true

fn WebSceneInheritTextNodeLayoutStyles(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       tree: var layout.WebLayoutTree): bool =
    for i in 0..<graph.nodes.len:
        let node = graph.nodes[i]
        if node.routeIndex != routeIndex:
            continue
        if node.nodeKind != 3:
            continue
        let textStyleIndex = layout.WebLayoutFindStyleIndex(tree, node.nodeId)
        if textStyleIndex < 0:
            continue
        let parentNodeId = layout.WebLayoutParentOf(tree, node.nodeId)
        if parentNodeId <= 0:
            continue
        let parentStyleIndex = layout.WebLayoutFindStyleIndex(tree, parentNodeId)
        if parentStyleIndex < 0:
            continue
        tree.styles[textStyleIndex].fontSize = tree.styles[parentStyleIndex].fontSize
        tree.styles[textStyleIndex].renderFontSize = tree.styles[parentStyleIndex].renderFontSize
        tree.styles[textStyleIndex].lineHeight = tree.styles[parentStyleIndex].lineHeight
        tree.styles[textStyleIndex].lineHeightPx2 = tree.styles[parentStyleIndex].lineHeightPx2
        tree.styles[textStyleIndex].renderFontWeight = tree.styles[parentStyleIndex].renderFontWeight
        tree.styles[textStyleIndex].fontFamily = tree.styles[parentStyleIndex].fontFamily
        tree.styles[textStyleIndex].textAlign = tree.styles[parentStyleIndex].textAlign
        tree.styles[textStyleIndex].whiteSpaceNowrap = tree.styles[parentStyleIndex].whiteSpaceNowrap
        tree.styles[textStyleIndex].wordBreakBreakAll = tree.styles[parentStyleIndex].wordBreakBreakAll
    return true

fn WebSceneBuildRouteLayoutTree(graph: var WebSceneGraph,
                                routeIndex: int32,
                                viewportWidth: int32,
                                viewportHeight: int32,
                                tree: var layout.WebLayoutTree): bool =
    layout.WebLayoutTreeInit(tree)
    return WebSceneBuildRouteLayoutTreeMode(graph, routeIndex, viewportWidth, viewportHeight, tree)

# Same build on a caller-owned tree whose seq capacity survives across calls
# (arena reuse, see WebLayoutTreeResetForReuse). Hot per-swap rebuild path.
fn WebSceneBuildRouteLayoutTreeReused(graph: var WebSceneGraph,
                                      routeIndex: int32,
                                      viewportWidth: int32,
                                      viewportHeight: int32,
                                      tree: var layout.WebLayoutTree): bool =
    layout.WebLayoutTreeResetForReuse(tree)
    return WebSceneBuildRouteLayoutTreeMode(graph, routeIndex, viewportWidth, viewportHeight, tree)

fn WebSceneBuildRouteLayoutTreeMode(graph: var WebSceneGraph,
                                    routeIndex: int32,
                                    viewportWidth: int32,
                                    viewportHeight: int32,
                                    tree: var layout.WebLayoutTree): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        WebSceneLayoutDebugFail(101, routeIndex, -1, -1)
        return false
    if viewportWidth <= 0 || viewportHeight <= 0:
        WebSceneLayoutDebugFail(102, routeIndex, -1, -1)
        return false
    if !WebSceneSetCurrentViewport(graph, viewportWidth, viewportHeight):
        WebSceneLayoutDebugFail(102, routeIndex, -1, -1)
        return false
    tree.viewportWidth = viewportWidth
    tree.viewportHeight = viewportHeight
    let rootNodeId = graph.routes[routeIndex].rootNodeIds[0]
    for i in 0..<graph.nodes.len:
        let node = graph.nodes[i]
        if node.routeIndex != routeIndex:
            continue
        if WebSceneNodeHiddenByNonRenderedContent(graph, routeIndex, node.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, node.nodeId):
            continue
        if WebSceneNodeIsTransparentLayoutWrapper(graph, node):
            continue
        var display = layout.WebLayoutDisplayBlock
        if node.nodeKind == 3:
            display = layout.WebLayoutDisplayInline
        else:
            display = WebSceneUADisplay(node.tagName)
        if !layout.WebLayoutTreeAddStyle(tree, node.nodeId, display, 0, 0, 0, 0):
            WebSceneLayoutDebugFail(103, routeIndex, node.nodeId, -1)
            return false
        let styleIndex = layout.WebLayoutFindStyleIndex(tree, node.nodeId)
        if styleIndex < 0:
            WebSceneLayoutDebugFail(104, routeIndex, node.nodeId, -1)
            return false
        tree.styles[styleIndex].tableRole = WebSceneTableRole(node.tagName)
        tree.styles[styleIndex].textContent = node.textContent
    for i in 0..<graph.nodes.len:
        let node = graph.nodes[i]
        if node.routeIndex != routeIndex:
            continue
        if WebSceneNodeHiddenByNonRenderedContent(graph, routeIndex, node.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, node.nodeId):
            continue
        if node.parentNodeId <= 0:
            continue
        if WebSceneNodeIsTransparentLayoutWrapper(graph, node):
            continue
        var parentNodeId = WebSceneNearestLayoutParentNodeId(graph, routeIndex, node.parentNodeId)
        if parentNodeId == 0:
            parentNodeId = rootNodeId
        if node.parentNodeId > 0:
            if !layout.WebLayoutTreeAddChildEdge(tree, parentNodeId, node.nodeId):
                WebSceneLayoutDebugFail(105, routeIndex, node.nodeId, parentNodeId)
                return false
    for i in 0..<graph.layoutConstraints.len:
        let constraint = graph.layoutConstraints[i]
        if constraint.routeIndex != routeIndex:
            continue
        if WebSceneNodeHiddenByNonRenderedContent(graph, routeIndex, constraint.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, constraint.nodeId):
            continue
        if !WebSceneApplyLayoutConstraintToTree(tree, constraint.nodeId, constraint.propName, constraint.propValue):
            WebSceneLayoutDebugFail(106, routeIndex, constraint.nodeId, constraint.ordinal)
            return false
    if !WebSceneApplyCssVariantLayoutDeclarationsToTree(graph, routeIndex, tree):
        return false
    if !WebSceneInheritLayoutStyles(graph, routeIndex, tree):
        WebSceneLayoutDebugFail(109, routeIndex, rootNodeId, -1)
        return false
    if !layout.WebLayoutSetRootViewport(tree, rootNodeId, viewportWidth, viewportHeight):
        WebSceneLayoutDebugFail(107, routeIndex, rootNodeId, -1)
        return false
    if !layout.WebLayoutCompute(tree, rootNodeId):
        WebSceneLayoutDebugFail(108, routeIndex, rootNodeId, -1)
        return false
    return true

fn WebSceneFindLayoutBoxIndex(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    return layout.WebLayoutFindBestBoxIndex(tree, nodeId)

fn WebSceneFindTextOverflowEllipsisBox(tree: var layout.WebLayoutTree, nodeId: int32,
                                       outX: var int32, outY: var int32,
                                       outW: var int32, outH: var int32): bool =
    outX = 0
    outY = 0
    outW = 0
    outH = 0
    var current = layout.WebLayoutParentOf(tree, nodeId)
    var steps: int32
    while current != 0:
        steps = steps + 1
        if steps > tree.styles.len:
            return false
        let styleIdx = layout.WebLayoutFindStyleIndex(tree, current)
        if styleIdx >= 0 && styleIdx < tree.styles.len:
            if tree.styles[styleIdx].textOverflowEllipsis &&
                    tree.styles[styleIdx].whiteSpaceNowrap &&
                    tree.styles[styleIdx].overflowX != layout.WebLayoutOverflowVisible:
                let boxIndex = WebSceneFindLayoutBoxIndex(tree, current)
                if boxIndex >= 0:
                    let b = tree.boxes[boxIndex]
                    outX = b.x + tree.styles[styleIdx].borderLeftWidth + tree.styles[styleIdx].paddingLeft
                    outY = b.y + tree.styles[styleIdx].borderTopWidth + tree.styles[styleIdx].paddingTop
                    outW = b.width - tree.styles[styleIdx].borderLeftWidth - tree.styles[styleIdx].borderRightWidth - tree.styles[styleIdx].paddingLeft - tree.styles[styleIdx].paddingRight
                    outH = b.height - tree.styles[styleIdx].borderTopWidth - tree.styles[styleIdx].borderBottomWidth - tree.styles[styleIdx].paddingTop - tree.styles[styleIdx].paddingBottom
                    if outW < 0:
                        outW = 0
                    if outH < 0:
                        outH = 0
                    if !(outW > 0):
                        return false
                    if !(outH > 0):
                        return false
                    return true
            return false
        current = layout.WebLayoutParentOf(tree, current)
    return false

fn WebSceneFindTextLayoutUnionBox(tree: var layout.WebLayoutTree, nodeId: int32,
                                  lineY: int32,
                                  outX: var int32, outY: var int32,
                                  outW: var int32, outH: var int32): bool =
    outX = 0
    outY = 0
    outW = 0
    outH = 0
    var found = false
    var left: int32
    var top: int32
    var right: int32
    var bottom: int32
    for i in 0..<tree.boxes.len:
        if tree.boxes[i].nodeId != nodeId:
            continue
        if tree.boxes[i].width <= 0 || tree.boxes[i].height <= 0:
            continue
        if tree.boxes[i].y != lineY:
            continue
        let boxLeft = tree.boxes[i].x
        let boxTop = tree.boxes[i].y
        let boxRight = tree.boxes[i].x + tree.boxes[i].width
        let boxBottom = tree.boxes[i].y + tree.boxes[i].height
        if !found:
            found = true
            left = boxLeft
            top = boxTop
            right = boxRight
            bottom = boxBottom
        else:
            if boxLeft < left:
                left = boxLeft
            if boxTop < top:
                top = boxTop
            if boxRight > right:
                right = boxRight
            if boxBottom > bottom:
                bottom = boxBottom
    if !found:
        return false
    outX = left
    outY = top
    outW = right - left
    outH = bottom - top
    if !(outW > 0):
        return false
    if !(outH > 0):
        return false
    return true

fn WebSceneMaterializeTextPaintOpFromLayout(tree: var layout.WebLayoutTree,
                                            boxIndex: int32,
                                            sceneOp: var WebScenePaintOp): bool =
    if boxIndex < 0 || boxIndex >= tree.boxes.len:
        return false
    let box = tree.boxes[boxIndex]
    var paintText = sceneOp.textContent
    var ellipsisX: int32
    var ellipsisY: int32
    var ellipsisW: int32
    var ellipsisH: int32
    let hasEllipsis = WebSceneFindTextOverflowEllipsisBox(tree, sceneOp.nodeId, ellipsisX, ellipsisY, ellipsisW, ellipsisH)
    sceneOp.x = box.x
    sceneOp.y = box.y
    sceneOp.width = box.width
    sceneOp.height = box.height
    var unionX: int32
    var unionY: int32
    var unionW: int32
    var unionH: int32
    let hasTextUnion = WebSceneFindTextLayoutUnionBox(tree, sceneOp.nodeId, box.y, unionX, unionY, unionW, unionH)
    if hasTextUnion:
        sceneOp.x = unionX
        sceneOp.y = unionY
        sceneOp.width = unionW
        sceneOp.height = unionH
    let styleIndex = layout.WebLayoutFindStyleIndex(tree, sceneOp.nodeId)
    var fontSize = 16
    if styleIndex >= 0:
        fontSize = tree.styles[styleIndex].fontSize > 0 ? tree.styles[styleIndex].fontSize : 16
        if tree.styles[styleIndex].renderFontSize > 0:
            fontSize = tree.styles[styleIndex].renderFontSize
        sceneOp.fontSize = fontSize
        sceneOp.fontWeight = tree.styles[styleIndex].renderFontWeight
        sceneOp.fontFamily = tree.styles[styleIndex].fontFamily
    if hasEllipsis:
        if styleIndex < 0:
            return false
        paintText = paint.WebPaintEllipsizeText(paintText, fontSize, ellipsisW)
        sceneOp.x = ellipsisX
        sceneOp.width = ellipsisW
        if sceneOp.height <= 0 && ellipsisH > 0:
            sceneOp.height = ellipsisH
    elif hasTextUnion:
        if styleIndex >= 0:
            let fullTextW = layout.WebLayoutEstimateTextWidthWeightedFamily(sceneOp.textContent,
                fontSize,
                tree.styles[styleIndex].renderFontWeight,
                tree.styles[styleIndex].fontFamily)
            if fullTextW > sceneOp.width:
                sceneOp.width = fullTextW
    sceneOp.textContent = paintText
    return true

fn WebSceneRefreshRouteLayoutBoxes(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   tree: var layout.WebLayoutTree): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    # In-place compact + append into graph.layoutBoxes: other-route boxes move
    # to the front, this route's boxes follow. graph.layoutBoxes capacity
    # survives across swaps (zero per-swap realloc churn on the hot path).
    var w: int32
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].routeIndex != routeIndex:
            graph.layoutBoxes[w] = graph.layoutBoxes[i]
            w = w + 1
    setLen(graph.layoutBoxes, w)
    if !paint.WebPaintBuildBoxPaintOrder(tree, __scenePaintOrderScratch):
        return false
    for orderIndex in 0..<__scenePaintOrderScratch.len:
        let i = __scenePaintOrderScratch[orderIndex]
        if i < 0 || i >= tree.boxes.len:
            return false
        var item: WebSceneLayoutBox
        item.routeIndex = routeIndex
        item.nodeId = tree.boxes[i].nodeId
        item.x = tree.boxes[i].x
        item.y = tree.boxes[i].y
        item.width = tree.boxes[i].width
        item.height = tree.boxes[i].height
        item.visible = tree.boxes[i].visible
        add(graph.layoutBoxes, item)
    graph.boxRangeVersion = -1
    return true

fn WebScenePaintOpCloneAt(graph: var WebSceneGraph,
                          index: int32,
                          dst: var WebScenePaintOp): bool =
    if index < 0 || index >= graph.paintOps.len:
        return false
    dst.routeIndex = graph.paintOps[index].routeIndex
    dst.nodeId = graph.paintOps[index].nodeId
    dst.ordinal = graph.paintOps[index].ordinal
    dst.x = graph.paintOps[index].x
    dst.y = graph.paintOps[index].y
    dst.baseX = graph.paintOps[index].baseX
    dst.baseY = graph.paintOps[index].baseY
    dst.opKind = graph.paintOps[index].opKind
    dst.color = graph.paintOps[index].color
    dst.baseColor = graph.paintOps[index].baseColor
    dst.opacity = graph.paintOps[index].opacity
    dst.baseOpacity = graph.paintOps[index].baseOpacity
    dst.radius = graph.paintOps[index].radius
    dst.baseRadius = graph.paintOps[index].baseRadius
    dst.width = graph.paintOps[index].width
    dst.height = graph.paintOps[index].height
    dst.baseWidth = graph.paintOps[index].baseWidth
    dst.baseHeight = graph.paintOps[index].baseHeight
    dst.fontSize = graph.paintOps[index].fontSize
    dst.fontWeight = graph.paintOps[index].fontWeight
    dst.fontFamily = graph.paintOps[index].fontFamily
    dst.shadowOffsetX = graph.paintOps[index].shadowOffsetX
    dst.shadowOffsetY = graph.paintOps[index].shadowOffsetY
    dst.shadowBlur = graph.paintOps[index].shadowBlur
    dst.shadowSpread = graph.paintOps[index].shadowSpread
    dst.shadowInset = graph.paintOps[index].shadowInset
    dst.gradientEndColor = graph.paintOps[index].gradientEndColor
    dst.gradientAngle = graph.paintOps[index].gradientAngle
    dst.rotationDeg = graph.paintOps[index].rotationDeg
    dst.resourceId = WebSceneCloneStateString(graph.paintOps[index].resourceId)
    dst.textContent = WebSceneCloneStateString(graph.paintOps[index].textContent)
    return true

# Arena singleton: the per-swap route layout tree lives here for the process
# lifetime and is reset with capacity retained on every rebuild (was: fresh
# WebLayoutTree + grow-from-8 arrays per swap — the malloc_history-proven RSS
# sawtooth source). Sequential use only: one ApplyRoute/ApplyAll call owns it.
var __webSceneLayoutTreeArena: layout.WebLayoutTree

# Scratch for the per-swap paint order build (WebSceneRefreshRouteLayoutBoxes
# passes it to WebPaintBuildBoxPaintOrder); capacity reused across swaps.
var __scenePaintOrderScratch: int32[]

fn WebSceneApplyRouteLayoutToPaintOps(graph: var WebSceneGraph,
                                      routeIndex: int32,
                                      viewportWidth: int32,
                                      viewportHeight: int32): bool =
    WebSceneLayoutDebugClear()
    if !WebSceneBuildRouteLayoutTreeReused(graph, routeIndex, viewportWidth, viewportHeight, __webSceneLayoutTreeArena):
        return false
    if !WebSceneRefreshRouteLayoutBoxes(graph, routeIndex, __webSceneLayoutTreeArena):
        return false
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex != routeIndex:
            continue
        if graph.paintOps[i].opKind == WebScenePaintTextColor:
            continue
        if WebSceneNodeHiddenByNonRenderedContent(graph, routeIndex, graph.paintOps[i].nodeId):
            graph.paintOps[i].width = 0
            graph.paintOps[i].height = 0
            continue
        let boxIndex = WebSceneFindLayoutBoxIndex(__webSceneLayoutTreeArena, graph.paintOps[i].nodeId)
        if boxIndex < 0:
            if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, graph.paintOps[i].nodeId):
                graph.paintOps[i].width = 0
                graph.paintOps[i].height = 0
                continue
            if WebScenePaintKindIsText(graph.paintOps[i].opKind) && graph.paintOps[i].textContent.len == 0:
                # State-bound text owns a paint op before its first non-empty
                # value, but the layout tree has no box for empty text. Geometry
                # stays zero until the binding writes real text and the next
                # route rebuild produces a box for it. Non-empty text without a
                # box still fails fast below.
                graph.paintOps[i].width = 0
                graph.paintOps[i].height = 0
                continue
            WebSceneLayoutDebugFail(202, routeIndex, graph.paintOps[i].nodeId, graph.paintOps[i].ordinal)
            return false
        # Geometry is patched in place: no per-op clone/writeback, so op string
        # fields keep their storage across swaps (zero churn on the hot path).
        if WebScenePaintKindIsText(graph.paintOps[i].opKind):
            if !WebSceneMaterializeTextPaintOpFromLayout(__webSceneLayoutTreeArena, boxIndex, graph.paintOps[i]):
                WebSceneLayoutDebugFail(203, routeIndex, graph.paintOps[i].nodeId, graph.paintOps[i].ordinal)
                return false
            graph.paintOps[i].baseX = graph.paintOps[i].x
            graph.paintOps[i].baseY = graph.paintOps[i].y
            graph.paintOps[i].baseWidth = graph.paintOps[i].width
            graph.paintOps[i].baseHeight = graph.paintOps[i].height
            continue
        let boxX = __webSceneLayoutTreeArena.boxes[boxIndex].x
        let boxY = __webSceneLayoutTreeArena.boxes[boxIndex].y
        if graph.paintOps[i].width <= 0:
            graph.paintOps[i].width = __webSceneLayoutTreeArena.boxes[boxIndex].width
        if graph.paintOps[i].height <= 0:
            graph.paintOps[i].height = __webSceneLayoutTreeArena.boxes[boxIndex].height
        graph.paintOps[i].x = boxX
        graph.paintOps[i].y = boxY
        graph.paintOps[i].baseX = boxX
        graph.paintOps[i].baseY = boxY
        graph.paintOps[i].baseWidth = graph.paintOps[i].width
        graph.paintOps[i].baseHeight = graph.paintOps[i].height
    return true

fn WebSceneApplyAllRouteLayoutsToPaintOps(graph: var WebSceneGraph,
                                          viewportWidth: int32,
                                          viewportHeight: int32): bool =
    for routeIndex in 0..<graph.routes.len:
        if !WebSceneApplyRouteLayoutToPaintOps(graph, routeIndex, viewportWidth, viewportHeight):
            return false
    return true

fn WebSceneAddPaintSvgLine(graph: var WebSceneGraph,
                           routeIndex: int32,
                           nodeId: int32,
                           ordinal: int32,
                           x1: int32,
                           y1: int32,
                           x2: int32,
                           y2: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetLine(primitive, x1, y1, x2, y2)
    return WebSceneAddPaintSvgPrimitive(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgCircle(graph: var WebSceneGraph,
                             routeIndex: int32,
                             nodeId: int32,
                             ordinal: int32,
                             cx: int32,
