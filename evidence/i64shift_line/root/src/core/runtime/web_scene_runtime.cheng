        return -1
    return atlas.glyphs[index].glyphId

fn WebSceneGlyphAtlasGlyphFontGlyphIndexAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.glyphs.len:
