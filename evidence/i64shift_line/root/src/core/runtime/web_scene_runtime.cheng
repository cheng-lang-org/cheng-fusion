fn WebSceneGlyphAtlasRunIdForPaint(atlas: var WebSceneGlyphAtlas,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   ordinal: int32): int32 =
    let index = WebSceneGlyphAtlasFindRunForPaintIndex(atlas, routeIndex, nodeId, ordinal)
    if index < 0:
        return -1
    return atlas.runs[index].glyphRunId

