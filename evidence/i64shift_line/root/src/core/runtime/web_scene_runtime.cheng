fn WebSceneFindLayerCacheIndex(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    for i in 0..<graph.layerCaches.len:
        if graph.layerCaches[i].routeIndex == routeIndex && graph.layerCaches[i].layerId == layerId:
            return i
    return -1

fn WebSceneLayerCacheSetPaintBoundsAt(graph: var WebSceneGraph, cacheIndex: int32, rect: var WebSceneRect): bool =
    if cacheIndex < 0 || cacheIndex >= graph.layerCaches.len:
        return false
    graph.layerCaches[cacheIndex].paintBounds.x = rect.x
    graph.layerCaches[cacheIndex].paintBounds.y = rect.y
    graph.layerCaches[cacheIndex].paintBounds.width = rect.width
    graph.layerCaches[cacheIndex].paintBounds.height = rect.height
    graph.layerCaches[cacheIndex].paintBounds.empty = rect.empty
    return true

fn WebSceneLayerCacheSetDirtyRectAt(graph: var WebSceneGraph, cacheIndex: int32, rect: var WebSceneRect): bool =
    if cacheIndex < 0 || cacheIndex >= graph.layerCaches.len:
        return false
    graph.layerCaches[cacheIndex].dirtyRect.x = rect.x
    graph.layerCaches[cacheIndex].dirtyRect.y = rect.y
    graph.layerCaches[cacheIndex].dirtyRect.width = rect.width
    graph.layerCaches[cacheIndex].dirtyRect.height = rect.height
    graph.layerCaches[cacheIndex].dirtyRect.empty = rect.empty
    return true

fn WebSceneLayerCacheClearDirtyRectAt(graph: var WebSceneGraph, cacheIndex: int32): bool =
    if cacheIndex < 0 || cacheIndex >= graph.layerCaches.len:
        return false
    graph.layerCaches[cacheIndex].dirtyRect.x = 0
    graph.layerCaches[cacheIndex].dirtyRect.y = 0
    graph.layerCaches[cacheIndex].dirtyRect.width = 0
    graph.layerCaches[cacheIndex].dirtyRect.height = 0
    graph.layerCaches[cacheIndex].dirtyRect.empty = true
    return true

fn WebSceneInvalidateLayerCacheAt(graph: var WebSceneGraph,
                                  cacheIndex: int32,
                                  buffer: var WebScenePaintCommandBuffer): bool =
    if cacheIndex < 0 || cacheIndex >= graph.layerCaches.len:
        return false
    if buffer.routeIndex != graph.layerCaches[cacheIndex].routeIndex || buffer.layerId != graph.layerCaches[cacheIndex].layerId:
        return false
    var bounds: WebSceneRect
    if !WebScenePaintCommandBounds(buffer, bounds):
        return false
    if bounds.empty && !graph.layerCaches[cacheIndex].paintBounds.empty:
        bounds.x = graph.layerCaches[cacheIndex].paintBounds.x
        bounds.y = graph.layerCaches[cacheIndex].paintBounds.y
        bounds.width = graph.layerCaches[cacheIndex].paintBounds.width
        bounds.height = graph.layerCaches[cacheIndex].paintBounds.height
        bounds.empty = graph.layerCaches[cacheIndex].paintBounds.empty
    let layerIndex = WebSceneFindLayerIndex(graph,
                                            graph.layerCaches[cacheIndex].routeIndex,
                                            graph.layerCaches[cacheIndex].layerId)
    if layerIndex < 0:
        return false
    if !WebSceneRectIntersectCurrentViewportForLayer(graph,
                                                     graph.layers[layerIndex].offsetX,
                                                     graph.layers[layerIndex].offsetY,
                                                     bounds):
        return false
    graph.layerCaches[cacheIndex].valid = false
    graph.layerCaches[cacheIndex].version = graph.version
    WebSceneLayerCacheSetDirtyRectAt(graph, cacheIndex, bounds)
    return true

fn WebSceneSubtreeHasLayerNode(graph: var WebSceneGraph,
                               routeIndex: int32,
                               rootNodeId: int32,
                               layerId: int32): bool =
    for i in 0..<graph.nodes.len:
        if graph.nodes[i].routeIndex == routeIndex &&
           graph.nodes[i].layerId == layerId &&
           WebSceneNodeInSubtree(graph, rootNodeId, graph.nodes[i].nodeId):
            return true
    return false

fn WebSceneAppendRouteLayersForCompositor(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          subtreeRootNodeId: int32,
                                          frame: var WebSceneCompositorFrame): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if subtreeRootNodeId > 0 && !WebSceneNodeBelongsToRoute(graph, routeIndex, subtreeRootNodeId):
        return false
    var targetCount = 0
    for i in 0..<graph.layers.len:
        if graph.layers[i].routeIndex == routeIndex:
            if subtreeRootNodeId <= 0 || WebSceneSubtreeHasLayerNode(graph, routeIndex, subtreeRootNodeId, graph.layers[i].layerId):
                targetCount = targetCount + 1
    var appendedLayerIds: int32[]
    while appendedLayerIds.len < targetCount:
        var bestIndex = -1
        for i in 0..<graph.layers.len:
            if graph.layers[i].routeIndex == routeIndex:
                if subtreeRootNodeId <= 0 || WebSceneSubtreeHasLayerNode(graph, routeIndex, subtreeRootNodeId, graph.layers[i].layerId):
                    if !WebSceneLayerIdInList(appendedLayerIds, graph.layers[i].layerId):
                        if bestIndex < 0:
                            bestIndex = i
                        elif graph.layers[i].ordinal < graph.layers[bestIndex].ordinal:
                            bestIndex = i
                        elif graph.layers[i].ordinal == graph.layers[bestIndex].ordinal && graph.layers[i].layerId < graph.layers[bestIndex].layerId:
                            bestIndex = i
        if bestIndex < 0:
            return false
        if !WebSceneAppendCompositorLayerScope(graph,
                                              routeIndex,
                                              graph.layers[bestIndex].layerId,
                                              graph.layers[bestIndex].ordinal,
                                              subtreeRootNodeId,
                                              frame):
            return false
        add(appendedLayerIds, graph.layers[bestIndex].layerId)
    return true

