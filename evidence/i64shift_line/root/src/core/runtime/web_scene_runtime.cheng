# Any normalized CSS gradient angle in [0,360) is renderable: the host computes the
# gradient axis endpoints from the angle via trig, so arbitrary degrees are supported.
fn WebSceneGradientAngleSupported(angle: int32): bool =
    return angle >= 0 && angle < 360

@borrows
fn WebSceneGpuCommandHostFieldsValid(command: WebSceneGpuCommand): bool =
    if !WebSceneGpuCommandKindSupported(command.kind):
        return false
    if command.width < 0 || command.height < 0:
        return false
    if command.kind == WebSceneGpuFillText:
        if command.fontAtlasId <= 0:
            return false
        if command.glyphRunId <= 0:
            return false
        if command.glyphRunGlyphCount < 0:
            return false
        if command.glyphSdfAtlasId <= 0:
            return false
    if command.kind == WebSceneGpuBoxShadow:
        if command.iconPrimitiveCount < 0:
            return false
        if command.glyphSdfAtlasId != 0 && command.glyphSdfAtlasId != 1:
            return false
    if command.kind == WebSceneGpuGradientFill:
        if !WebSceneGradientAngleSupported(command.iconKind):
            return false
        if command.fontAtlasId < 0:
            return false
    if command.kind == WebSceneGpuSvgCirclePattern:
        if command.imageId <= 0 || command.iconKind <= 0:
            return false
        if command.iconPrimitiveCount < 0 || command.svgDisplayListId < 0:
            return false
        if command.fontAtlasId <= 0:
            return false
    if command.kind == WebSceneGpuDrawMediaSurface:
        if command.fontAtlasId < 1 || command.fontAtlasId > 3:
            return false
        if command.glyphRunId != command.fontAtlasId:
            return false
        if command.glyphRunGlyphCount < 1 || command.glyphRunGlyphCount > 2:
            return false
        if command.glyphSdfAtlasId < 1 || command.glyphSdfAtlasId > 3:
            return false
        if command.rotationDeg < WebSceneMediaPlaybackClosed || command.rotationDeg > WebSceneMediaPlaybackPublished:
            return false
        if command.imageId <= 0 || command.iconKind <= 0 || command.iconPrimitiveCount <= 0 || command.svgDisplayListId <= 0:
            return false
        return true
    if command.rotationDeg % 90 != 0:
        return false
    return true

fn WebSceneEncodeGpuCommandHostBatch(buffer: var WebSceneGpuCommandBuffer, words: var int32[]): bool =
    words = []
    for i in 0..<buffer.commands.len:
        let command = buffer.commands[i]
        if !WebSceneGpuCommandHostFieldsValid(command):
            return false
        add(words, command.kind)
        add(words, command.routeIndex)
        add(words, command.layerId)
        add(words, command.x)
        add(words, command.y)
        add(words, command.width)
        add(words, command.height)
        add(words, command.color)
        add(words, command.imageId)
        add(words, command.iconKind)
        add(words, command.iconPrimitiveCount)
        add(words, command.svgDisplayListId)
        add(words, command.fontAtlasId)
        add(words, command.glyphRunId)
        add(words, command.glyphRunGlyphCount)
        add(words, command.glyphSdfAtlasId)
        add(words, command.rotationDeg)
    if words.len == buffer.commands.len * WebSceneGpuHostBatchStrideI32:
        return true
    return false

fn WebSceneEncodeCompositorFrameCommandsHostBatch(frame: var WebSceneCompositorFrame,
                                                  words: var int32[]): bool =
    words = []
    for commandIndex in 0..<frame.commands.len:
        let command = frame.commands[commandIndex]
        if !WebSceneGpuCommandHostFieldsValid(command):
            return false
        add(words, command.kind)
        add(words, command.routeIndex)
        add(words, command.layerId)
        add(words, command.x)
        add(words, command.y)
        add(words, command.width)
        add(words, command.height)
        add(words, command.color)
        add(words, command.imageId)
        add(words, command.iconKind)
        add(words, command.iconPrimitiveCount)
        add(words, command.svgDisplayListId)
        add(words, command.fontAtlasId)
        add(words, command.glyphRunId)
        add(words, command.glyphRunGlyphCount)
        add(words, command.glyphSdfAtlasId)
        add(words, command.rotationDeg)
    if words.len == frame.commands.len * WebSceneGpuHostBatchStrideI32:
        return true
    return false

fn WebSceneEncodeCompositorFrameLayersHostBatch(frame: var WebSceneCompositorFrame,
                                                words: var int32[]): bool =
    words = []
    var nextCommandStart = 0
    for layerIndex in 0..<frame.layers.len:
        let transitionAction = frame.layers[layerIndex].transitionAction
        let routeIndex = frame.layers[layerIndex].routeIndex
        let layerId = frame.layers[layerIndex].layerId
        let cacheRouteIndex = frame.layers[layerIndex].cacheRouteIndex
        let cacheLayerId = frame.layers[layerIndex].cacheLayerId
        let commandStart = frame.layers[layerIndex].commandStart
        let commandCount = frame.layers[layerIndex].commandCount
        if transitionAction != 0 &&
           transitionAction != WebSceneLayerTransitionReuse &&
           transitionAction != WebSceneLayerTransitionReplace &&
           transitionAction != WebSceneLayerTransitionDrop:
            return false
        if routeIndex < 0 || layerId <= 0:
            return false
        if cacheRouteIndex < 0 || cacheLayerId <= 0:
            return false
        if frame.layers[layerIndex].dirtyRect.width < 0 || frame.layers[layerIndex].dirtyRect.height < 0:
            return false
        if commandStart != nextCommandStart:
            return false
        if commandCount < 0 || commandStart + commandCount > frame.commands.len:
            return false
        if transitionAction == WebSceneLayerTransitionReuse && commandCount != 0:
            return false
        if transitionAction == WebSceneLayerTransitionDrop && commandCount != 0:
            return false
        add(words, transitionAction)
        add(words, routeIndex)
        add(words, layerId)
        add(words, cacheRouteIndex)
        add(words, cacheLayerId)
        add(words, frame.layers[layerIndex].ordinal)
        add(words, frame.layers[layerIndex].offsetX)
        add(words, frame.layers[layerIndex].offsetY)
        add(words, frame.layers[layerIndex].previousOffsetX)
        add(words, frame.layers[layerIndex].previousOffsetY)
        add(words, frame.layers[layerIndex].dirtyRect.x)
        add(words, frame.layers[layerIndex].dirtyRect.y)
        add(words, frame.layers[layerIndex].dirtyRect.width)
        add(words, frame.layers[layerIndex].dirtyRect.height)
        if frame.layers[layerIndex].dirtyRect.empty:
            add(words, 1)
        else:
            add(words, 0)
        add(words, commandStart)
        add(words, commandCount)
        nextCommandStart = commandStart + commandCount
    if nextCommandStart != frame.commands.len:
        return false
    if words.len == frame.layers.len * WebSceneCompositorHostLayerStrideI32:
        return true
    return false

fn WebSceneEncodeCompositorFrameHostBatch(frame: var WebSceneCompositorFrame,
                                          layerWords: var int32[],
                                          commandWords: var int32[]): bool =
    layerWords = []
    commandWords = []
    if frame.routeIndex < 0:
        return false
    if !WebSceneEncodeCompositorFrameLayersHostBatch(frame, layerWords):
        return false
    if !WebSceneEncodeCompositorFrameCommandsHostBatch(frame, commandWords):
        return false
    let expectedLayerWords = frame.layers.len * WebSceneCompositorHostLayerStrideI32
    let expectedCommandWords = frame.commands.len * WebSceneGpuHostBatchStrideI32
    if layerWords.len != expectedLayerWords:
        return false
    if commandWords.len != expectedCommandWords:
        return false
    return true

# Byte-direct sibling of WebSceneEncodeGpuCommandHostBatch: writes straight
# into a caller-sized rawbytes.Bytes instead of growing an int32[] that the
# caller must then repack. bytes must already be sized to
# buffer.commands.len * WebSceneGpuHostBatchStrideI32 * 4 bytes.
fn WebSceneEncodeGpuCommandHostBatchBytes(buffer: var WebSceneGpuCommandBuffer, bytes: var rawbytes.Bytes): bool =
    let expectedBytes = buffer.commands.len * WebSceneGpuHostBatchStrideI32 * 4
    if rawbytes.BytesLen(bytes) != expectedBytes:
        return false
    for i in 0..<buffer.commands.len:
        let command = buffer.commands[i]
        if !WebSceneGpuCommandHostFieldsValid(command):
            return false
        let base = i * WebSceneGpuHostBatchStrideI32 * 4
        WebSceneHostBatchPackI32(bytes, base, command.kind)
        WebSceneHostBatchPackI32(bytes, base + 4, command.routeIndex)
        WebSceneHostBatchPackI32(bytes, base + 8, command.layerId)
        WebSceneHostBatchPackI32(bytes, base + 12, command.x)
        WebSceneHostBatchPackI32(bytes, base + 16, command.y)
        WebSceneHostBatchPackI32(bytes, base + 20, command.width)
        WebSceneHostBatchPackI32(bytes, base + 24, command.height)
        WebSceneHostBatchPackI32(bytes, base + 28, command.color)
        WebSceneHostBatchPackI32(bytes, base + 32, command.imageId)
        WebSceneHostBatchPackI32(bytes, base + 36, command.iconKind)
        WebSceneHostBatchPackI32(bytes, base + 40, command.iconPrimitiveCount)
        WebSceneHostBatchPackI32(bytes, base + 44, command.svgDisplayListId)
        WebSceneHostBatchPackI32(bytes, base + 48, command.fontAtlasId)
        WebSceneHostBatchPackI32(bytes, base + 52, command.glyphRunId)
        WebSceneHostBatchPackI32(bytes, base + 56, command.glyphRunGlyphCount)
        WebSceneHostBatchPackI32(bytes, base + 60, command.glyphSdfAtlasId)
        WebSceneHostBatchPackI32(bytes, base + 64, command.rotationDeg)
    return true

# Byte-direct sibling of WebSceneEncodeCompositorFrameCommandsHostBatch.
# bytes must already be sized to
# frame.commands.len * WebSceneGpuHostBatchStrideI32 * 4 bytes.
fn WebSceneEncodeCompositorFrameCommandsHostBatchBytes(frame: var WebSceneCompositorFrame,
                                                        bytes: var rawbytes.Bytes): bool =
    let expectedBytes = frame.commands.len * WebSceneGpuHostBatchStrideI32 * 4
    if rawbytes.BytesLen(bytes) != expectedBytes:
        return false
    for commandIndex in 0..<frame.commands.len:
        let command = frame.commands[commandIndex]
        if !WebSceneGpuCommandHostFieldsValid(command):
            return false
        let base = commandIndex * WebSceneGpuHostBatchStrideI32 * 4
        WebSceneHostBatchPackI32(bytes, base, command.kind)
        WebSceneHostBatchPackI32(bytes, base + 4, command.routeIndex)
        WebSceneHostBatchPackI32(bytes, base + 8, command.layerId)
        WebSceneHostBatchPackI32(bytes, base + 12, command.x)
        WebSceneHostBatchPackI32(bytes, base + 16, command.y)
        WebSceneHostBatchPackI32(bytes, base + 20, command.width)
        WebSceneHostBatchPackI32(bytes, base + 24, command.height)
        WebSceneHostBatchPackI32(bytes, base + 28, command.color)
        WebSceneHostBatchPackI32(bytes, base + 32, command.imageId)
        WebSceneHostBatchPackI32(bytes, base + 36, command.iconKind)
        WebSceneHostBatchPackI32(bytes, base + 40, command.iconPrimitiveCount)
        WebSceneHostBatchPackI32(bytes, base + 44, command.svgDisplayListId)
        WebSceneHostBatchPackI32(bytes, base + 48, command.fontAtlasId)
        WebSceneHostBatchPackI32(bytes, base + 52, command.glyphRunId)
        WebSceneHostBatchPackI32(bytes, base + 56, command.glyphRunGlyphCount)
        WebSceneHostBatchPackI32(bytes, base + 60, command.glyphSdfAtlasId)
        WebSceneHostBatchPackI32(bytes, base + 64, command.rotationDeg)
    return true

# Byte-direct sibling of WebSceneEncodeCompositorFrameLayersHostBatch. Carries
# the frame.routeIndex guard that WebSceneEncodeCompositorFrameHostBatch used
# to apply before delegating, since callers now invoke this directly whether
# or not the frame carries any GPU commands. bytes must already be sized to
# frame.layers.len * WebSceneCompositorHostLayerStrideI32 * 4 bytes.
fn WebSceneEncodeCompositorFrameLayersHostBatchBytes(frame: var WebSceneCompositorFrame,
                                                      bytes: var rawbytes.Bytes): bool =
    let expectedBytes = frame.layers.len * WebSceneCompositorHostLayerStrideI32 * 4
    if rawbytes.BytesLen(bytes) != expectedBytes:
        return false
    if frame.routeIndex < 0:
        return false
    var nextCommandStart = 0
    for layerIndex in 0..<frame.layers.len:
        let transitionAction = frame.layers[layerIndex].transitionAction
        let routeIndex = frame.layers[layerIndex].routeIndex
        let layerId = frame.layers[layerIndex].layerId
        let cacheRouteIndex = frame.layers[layerIndex].cacheRouteIndex
        let cacheLayerId = frame.layers[layerIndex].cacheLayerId
        let commandStart = frame.layers[layerIndex].commandStart
        let commandCount = frame.layers[layerIndex].commandCount
        if transitionAction != 0 &&
           transitionAction != WebSceneLayerTransitionReuse &&
           transitionAction != WebSceneLayerTransitionReplace &&
           transitionAction != WebSceneLayerTransitionDrop:
            return false
        if routeIndex < 0 || layerId <= 0:
            return false
        if cacheRouteIndex < 0 || cacheLayerId <= 0:
            return false
        if frame.layers[layerIndex].dirtyRect.width < 0 || frame.layers[layerIndex].dirtyRect.height < 0:
            return false
        if commandStart != nextCommandStart:
            return false
        if commandCount < 0 || commandStart + commandCount > frame.commands.len:
            return false
        if transitionAction == WebSceneLayerTransitionReuse && commandCount != 0:
            return false
        if transitionAction == WebSceneLayerTransitionDrop && commandCount != 0:
            return false
        let base = layerIndex * WebSceneCompositorHostLayerStrideI32 * 4
        WebSceneHostBatchPackI32(bytes, base, transitionAction)
        WebSceneHostBatchPackI32(bytes, base + 4, routeIndex)
        WebSceneHostBatchPackI32(bytes, base + 8, layerId)
        WebSceneHostBatchPackI32(bytes, base + 12, cacheRouteIndex)
        WebSceneHostBatchPackI32(bytes, base + 16, cacheLayerId)
        WebSceneHostBatchPackI32(bytes, base + 20, frame.layers[layerIndex].ordinal)
        WebSceneHostBatchPackI32(bytes, base + 24, frame.layers[layerIndex].offsetX)
        WebSceneHostBatchPackI32(bytes, base + 28, frame.layers[layerIndex].offsetY)
        WebSceneHostBatchPackI32(bytes, base + 32, frame.layers[layerIndex].previousOffsetX)
        WebSceneHostBatchPackI32(bytes, base + 36, frame.layers[layerIndex].previousOffsetY)
        WebSceneHostBatchPackI32(bytes, base + 40, frame.layers[layerIndex].dirtyRect.x)
        WebSceneHostBatchPackI32(bytes, base + 44, frame.layers[layerIndex].dirtyRect.y)
        WebSceneHostBatchPackI32(bytes, base + 48, frame.layers[layerIndex].dirtyRect.width)
        WebSceneHostBatchPackI32(bytes, base + 52, frame.layers[layerIndex].dirtyRect.height)
        if frame.layers[layerIndex].dirtyRect.empty:
            WebSceneHostBatchPackI32(bytes, base + 56, 1)
        else:
            WebSceneHostBatchPackI32(bytes, base + 56, 0)
        WebSceneHostBatchPackI32(bytes, base + 60, commandStart)
        WebSceneHostBatchPackI32(bytes, base + 64, commandCount)
        nextCommandStart = commandStart + commandCount
    if nextCommandStart != frame.commands.len:
        return false
    return true

fn WebSceneEncodeGlyphSdfAtlasHostBatch(atlas: var WebSceneGlyphAtlas, words: var int32[]): bool =
    words = []
    if atlas.fonts.len <= 0:
        return false
    if atlas.atlasWidth <= 0 || atlas.atlasHeight <= 0:
        return false
    let pixelCount = WebSceneGlyphAtlasSdfPixelCount(atlas)
    if pixelCount <= 0:
        return false
    if pixelCount != atlas.atlasWidth * atlas.atlasHeight:
        return false
    var usedFontCount = 0
    for fontIndex in 0..<atlas.fonts.len:
        let fontEntry = atlas.fonts[fontIndex]
        if fontEntry.glyphCount <= 0:
            continue
        if fontEntry.fontAtlasId <= 0 || fontEntry.sdfAtlasId <= 0:
            return false
        if fontEntry.sdfSpreadPx <= 0 || fontEntry.sdfPxRange <= 0:
            return false
        usedFontCount = usedFontCount + 1
    if usedFontCount <= 0:
        return false
    let wordCount = usedFontCount * WebSceneGlyphSdfAtlasHostStrideI32
    setLen(words, wordCount)
    var wordIndex = 0
    for fontIndex in 0..<atlas.fonts.len:
        let fontEntry = atlas.fonts[fontIndex]
        if fontEntry.glyphCount <= 0:
            continue
        words[wordIndex] = fontEntry.sdfAtlasId
        words[wordIndex + 1] = atlas.atlasWidth
        words[wordIndex + 2] = atlas.atlasHeight
        words[wordIndex + 3] = 0
        words[wordIndex + 4] = pixelCount
        words[wordIndex + 5] = fontEntry.fontAtlasId
        words[wordIndex + 6] = fontEntry.sdfSpreadPx
        words[wordIndex + 7] = fontEntry.sdfPxRange
        wordIndex = wordIndex + WebSceneGlyphSdfAtlasHostStrideI32
    return wordIndex == wordCount

fn WebSceneGlyphSdfAtlasHostEntryCount(atlas: var WebSceneGlyphAtlas): int32 =
    var usedFontCount: int32
    for fontIndex in 0..<atlas.fonts.len:
        if atlas.fonts[fontIndex].glyphCount > 0:
            usedFontCount = usedFontCount + 1
    return usedFontCount

fn WebSceneGlyphSdfAtlasHostWordCount(atlas: var WebSceneGlyphAtlas): int32 =
    return WebSceneGlyphSdfAtlasHostEntryCount(atlas) * WebSceneGlyphSdfAtlasHostStrideI32

fn WebSceneGlyphSdfAtlasHostWordAt(atlas: var WebSceneGlyphAtlas, wordIndex: int32, outValue: var int32): bool =
    if wordIndex < 0:
        return false
    if atlas.fonts.len <= 0:
        return false
    if atlas.atlasWidth <= 0 || atlas.atlasHeight <= 0:
        return false
    let pixelCount = WebSceneGlyphAtlasSdfPixelCount(atlas)
    if pixelCount <= 0:
        return false
    if pixelCount != atlas.atlasWidth * atlas.atlasHeight:
        return false
    var entryOrdinal: int32
    for fontIndex in 0..<atlas.fonts.len:
        let fontEntry = atlas.fonts[fontIndex]
        if fontEntry.glyphCount <= 0:
            continue
        if fontEntry.fontAtlasId <= 0 || fontEntry.sdfAtlasId <= 0:
            return false
        if fontEntry.sdfSpreadPx <= 0 || fontEntry.sdfPxRange <= 0:
            return false
        let entryStart = entryOrdinal * WebSceneGlyphSdfAtlasHostStrideI32
        let fieldIndex = wordIndex - entryStart
        if fieldIndex >= 0 && fieldIndex < WebSceneGlyphSdfAtlasHostStrideI32:
            if fieldIndex == 0:
                outValue = fontEntry.sdfAtlasId
                return true
            if fieldIndex == 1:
                outValue = atlas.atlasWidth
                return true
            if fieldIndex == 2:
                outValue = atlas.atlasHeight
                return true
            if fieldIndex == 3:
                outValue = 0
                return true
            if fieldIndex == 4:
                outValue = pixelCount
                return true
            if fieldIndex == 5:
                outValue = fontEntry.fontAtlasId
                return true
            if fieldIndex == 6:
                outValue = fontEntry.sdfSpreadPx
                return true
            if fieldIndex == 7:
                outValue = fontEntry.sdfPxRange
                return true
            return false
        entryOrdinal = entryOrdinal + 1
    return false

fn WebSceneGlyphSdfGlyphHostWordCount(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.glyphs.len * WebSceneGlyphSdfGlyphHostStrideI32

fn WebSceneGlyphSdfRunHostWordCount(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.runs.len * WebSceneGlyphSdfRunHostStrideI32

fn WebSceneGlyphSdfRunGlyphHostWordCount(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.runGlyphs.len * WebSceneGlyphSdfRunGlyphHostStrideI32

fn WebSceneGlyphSdfGlyphHostWordAt(atlas: var WebSceneGlyphAtlas, wordIndex: int32, outValue: var int32): bool =
    if wordIndex < 0:
        return false
    let glyphIndex = wordIndex / WebSceneGlyphSdfGlyphHostStrideI32
    let fieldIndex = wordIndex % WebSceneGlyphSdfGlyphHostStrideI32
    if glyphIndex < 0 || glyphIndex >= atlas.glyphs.len:
        return false
    let glyph = atlas.glyphs[glyphIndex]
    if glyph.glyphId <= 0 || glyph.sdfAtlasId <= 0 || glyph.fontAtlasId <= 0:
        return false
    if glyph.glyphId != glyphIndex + 1:
        return false
    if glyph.atlasX < 0 || glyph.atlasY < 0 || glyph.width <= 0 || glyph.height <= 0:
        return false
    if glyph.atlasX + glyph.width > atlas.atlasWidth || glyph.atlasY + glyph.height > atlas.atlasHeight:
        return false
    if glyph.advance <= 0 || glyph.sdfPixelStart < 0 || glyph.sdfPixelCount != glyph.width * glyph.height:
        return false
    if glyph.sdfPixelStart != glyph.atlasY * atlas.atlasWidth + glyph.atlasX:
        return false
    let pixelCount = WebSceneGlyphAtlasSdfPixelCount(atlas)
    let lastRowStart = glyph.sdfPixelStart + (glyph.height - 1) * atlas.atlasWidth
    if lastRowStart + glyph.width > pixelCount:
        return false
    if fieldIndex == 0:
        outValue = glyph.glyphId
        return true
    if fieldIndex == 1:
        outValue = glyph.sdfAtlasId
        return true
    if fieldIndex == 2:
        outValue = glyph.atlasX
        return true
    if fieldIndex == 3:
        outValue = glyph.atlasY
        return true
    if fieldIndex == 4:
        outValue = glyph.width
        return true
    if fieldIndex == 5:
        outValue = glyph.height
        return true
    if fieldIndex == 6:
        outValue = glyph.advance
        return true
    if fieldIndex == 7:
        outValue = glyph.fontAtlasId
        return true
    if fieldIndex == 8:
        outValue = glyph.sdfPixelStart
        return true
    if fieldIndex == 9:
        outValue = glyph.sdfPixelCount
        return true
    if fieldIndex == 10:
        outValue = glyph.codepoint
        return true
    if fieldIndex == 11:
        outValue = glyph.fontSize
        return true
    return false

fn WebSceneGlyphSdfRunHostWordAt(atlas: var WebSceneGlyphAtlas, wordIndex: int32, outValue: var int32): bool =
    if wordIndex < 0:
        return false
    let runIndex = wordIndex / WebSceneGlyphSdfRunHostStrideI32
    let fieldIndex = wordIndex % WebSceneGlyphSdfRunHostStrideI32
    if runIndex < 0 || runIndex >= atlas.runs.len:
        return false
    let run = atlas.runs[runIndex]
    if run.glyphRunId <= 0 || run.fontAtlasId <= 0 || run.sdfAtlasId <= 0:
        return false
    if run.glyphStart < 0 || run.glyphCount <= 0 || run.glyphStart + run.glyphCount > atlas.runGlyphs.len:
        return false
    if run.advanceWidth <= 0:
        return false
    if fieldIndex == 0:
        outValue = run.glyphRunId
        return true
    if fieldIndex == 1:
        outValue = run.fontAtlasId
        return true
    if fieldIndex == 2:
        outValue = run.sdfAtlasId
        return true
    if fieldIndex == 3:
        outValue = run.glyphStart
        return true
    if fieldIndex == 4:
        outValue = run.glyphCount
        return true
    if fieldIndex == 5:
        outValue = run.advanceWidth
        return true
    if fieldIndex == 6:
        outValue = run.routeIndex
        return true
    if fieldIndex == 7:
        outValue = run.nodeId
        return true
    if fieldIndex == 8:
        outValue = run.ordinal
        return true
    return false

fn WebSceneGlyphSdfRunGlyphHostWordAt(atlas: var WebSceneGlyphAtlas, wordIndex: int32, outValue: var int32): bool =
    if wordIndex < 0:
        return false
    let runGlyphIndex = wordIndex / WebSceneGlyphSdfRunGlyphHostStrideI32
    let fieldIndex = wordIndex % WebSceneGlyphSdfRunGlyphHostStrideI32
    if runGlyphIndex < 0 || runGlyphIndex >= atlas.runGlyphs.len:
        return false
    let runGlyph = atlas.runGlyphs[runGlyphIndex]
    if runGlyph.glyphId <= 0 || runGlyph.advance <= 0:
        return false
    let glyphIndex = runGlyph.glyphId - 1
    if glyphIndex < 0 || glyphIndex >= atlas.glyphs.len:
        return false
    if atlas.glyphs[glyphIndex].glyphId != runGlyph.glyphId:
        return false
    if atlas.glyphs[glyphIndex].advance != runGlyph.advance:
        return false
    if fieldIndex == 0:
        outValue = runGlyph.glyphId
        return true
    if fieldIndex == 1:
        outValue = runGlyph.advance
        return true
    return false

fn WebSceneEncodeGlyphSdfMetadataHostBatch(atlas: var WebSceneGlyphAtlas,
                                           glyphWords: var int32[],
                                           runWords: var int32[],
                                           runGlyphWords: var int32[]): bool =
    glyphWords = []
    runWords = []
    runGlyphWords = []
    if atlas.atlasWidth <= 0 || atlas.atlasHeight <= 0:
        return false
    let pixelCount = WebSceneGlyphAtlasSdfPixelCount(atlas)
    if pixelCount != atlas.atlasWidth * atlas.atlasHeight:
        return false
    if atlas.glyphs.len <= 0 || atlas.runs.len <= 0 || atlas.runGlyphs.len <= 0:
        return false
    let glyphWordCount = atlas.glyphs.len * WebSceneGlyphSdfGlyphHostStrideI32
    let runWordCount = atlas.runs.len * WebSceneGlyphSdfRunHostStrideI32
    let runGlyphWordCount = atlas.runGlyphs.len * WebSceneGlyphSdfRunGlyphHostStrideI32
    setLen(glyphWords, glyphWordCount)
    setLen(runWords, runWordCount)
    setLen(runGlyphWords, runGlyphWordCount)
    for glyphIndex in 0..<atlas.glyphs.len:
        let glyph = atlas.glyphs[glyphIndex]
        if glyph.glyphId <= 0 || glyph.sdfAtlasId <= 0 || glyph.fontAtlasId <= 0:
            return false
        if glyph.glyphId != glyphIndex + 1:
            return false
        if glyph.atlasX < 0 || glyph.atlasY < 0 || glyph.width <= 0 || glyph.height <= 0:
            return false
        if glyph.atlasX + glyph.width > atlas.atlasWidth || glyph.atlasY + glyph.height > atlas.atlasHeight:
            return false
        if glyph.advance <= 0 || glyph.sdfPixelStart < 0 || glyph.sdfPixelCount != glyph.width * glyph.height:
            return false
        if glyph.sdfPixelStart != glyph.atlasY * atlas.atlasWidth + glyph.atlasX:
            return false
        let lastRowStart = glyph.sdfPixelStart + (glyph.height - 1) * atlas.atlasWidth
        if lastRowStart + glyph.width > pixelCount:
            return false
        let glyphBase = glyphIndex * WebSceneGlyphSdfGlyphHostStrideI32
        glyphWords[glyphBase] = glyph.glyphId
        glyphWords[glyphBase + 1] = glyph.sdfAtlasId
        glyphWords[glyphBase + 2] = glyph.atlasX
        glyphWords[glyphBase + 3] = glyph.atlasY
        glyphWords[glyphBase + 4] = glyph.width
        glyphWords[glyphBase + 5] = glyph.height
        glyphWords[glyphBase + 6] = glyph.advance
        glyphWords[glyphBase + 7] = glyph.fontAtlasId
        glyphWords[glyphBase + 8] = glyph.sdfPixelStart
        glyphWords[glyphBase + 9] = glyph.sdfPixelCount
        glyphWords[glyphBase + 10] = glyph.codepoint
        glyphWords[glyphBase + 11] = glyph.fontSize
    for runIndex in 0..<atlas.runs.len:
        let run = atlas.runs[runIndex]
        if run.glyphRunId <= 0 || run.fontAtlasId <= 0 || run.sdfAtlasId <= 0:
            return false
        if run.glyphStart < 0 || run.glyphCount <= 0 || run.glyphStart + run.glyphCount > atlas.runGlyphs.len:
            return false
        if run.advanceWidth <= 0:
            return false
        let runBase = runIndex * WebSceneGlyphSdfRunHostStrideI32
        runWords[runBase] = run.glyphRunId
        runWords[runBase + 1] = run.fontAtlasId
        runWords[runBase + 2] = run.sdfAtlasId
        runWords[runBase + 3] = run.glyphStart
        runWords[runBase + 4] = run.glyphCount
        runWords[runBase + 5] = run.advanceWidth
        runWords[runBase + 6] = run.routeIndex
        runWords[runBase + 7] = run.nodeId
        runWords[runBase + 8] = run.ordinal
    for runGlyphIndex in 0..<atlas.runGlyphs.len:
        let runGlyph = atlas.runGlyphs[runGlyphIndex]
        if runGlyph.glyphId <= 0 || runGlyph.advance <= 0:
            return false
        let glyphIndex = runGlyph.glyphId - 1
        if glyphIndex < 0:
            return false
        if glyphIndex >= atlas.glyphs.len:
            return false
        if atlas.glyphs[glyphIndex].glyphId != runGlyph.glyphId:
            return false
        if atlas.glyphs[glyphIndex].advance != runGlyph.advance:
            return false
        let runGlyphBase = runGlyphIndex * WebSceneGlyphSdfRunGlyphHostStrideI32
        runGlyphWords[runGlyphBase] = runGlyph.glyphId
        runGlyphWords[runGlyphBase + 1] = runGlyph.advance
    if glyphWords.len != glyphWordCount:
        return false
    if runWords.len != runWordCount:
        return false
    if runGlyphWords.len != runGlyphWordCount:
        return false
    return true

fn WebSceneLoadPrecomputedGlyphSdfAtlasHostBatches(graph: var WebSceneGraph,
                                                   atlas: var WebSceneGlyphAtlas,
                                                   atlasWords: int32[],
                                                   glyphWords: int32[],
                                                   runWords: int32[],
                                                   runGlyphWords: int32[],
                                                   pixels: uint8[]): bool =
    return WebSceneLoadPrecomputedGlyphSdfAtlasHostBatchesCore(graph, atlas, atlasWords, glyphWords, runWords, runGlyphWords, pixels, pixels.len, true)

fn WebSceneLoadPrecomputedGlyphSdfAtlasHostBatchesWithoutPixels(graph: var WebSceneGraph,
                                                                atlas: var WebSceneGlyphAtlas,
                                                                atlasWords: int32[],
                                                                glyphWords: int32[],
                                                                runWords: int32[],
                                                                runGlyphWords: int32[],
                                                                pixelCount: int32): bool =
    var pixels: uint8[]
    return WebSceneLoadPrecomputedGlyphSdfAtlasHostBatchesCore(graph, atlas, atlasWords, glyphWords, runWords, runGlyphWords, pixels, pixelCount, false)

fn WebSceneLoadPrecomputedGlyphSdfAtlasHostBatchesCore(graph: var WebSceneGraph,
                                                       atlas: var WebSceneGlyphAtlas,
                                                       atlasWords: int32[],
                                                       glyphWords: int32[],
                                                       runWords: int32[],
                                                       runGlyphWords: int32[],
                                                       pixels: uint8[],
                                                       suppliedPixelCount: int32,
                                                       loadPixels: bool): bool =
    WebSceneGlyphAtlasDebugClear()
    WebSceneGlyphAtlasInit(atlas)
    if atlasWords.len <= 0 || glyphWords.len <= 0 || runWords.len <= 0 || runGlyphWords.len <= 0 || suppliedPixelCount <= 0:
        WebSceneGlyphAtlasDebugFail(701, -1, -1, -1, atlasWords.len)
        return false
    if atlasWords.len % WebSceneGlyphSdfAtlasHostStrideI32 != 0:
        WebSceneGlyphAtlasDebugFail(702, -1, -1, -1, atlasWords.len)
        return false
    if glyphWords.len % WebSceneGlyphSdfGlyphHostStrideI32 != 0:
        WebSceneGlyphAtlasDebugFail(703, -1, -1, -1, glyphWords.len)
        return false
    if runWords.len % WebSceneGlyphSdfRunHostStrideI32 != 0:
        WebSceneGlyphAtlasDebugFail(704, -1, -1, -1, runWords.len)
        return false
    if runGlyphWords.len % WebSceneGlyphSdfRunGlyphHostStrideI32 != 0:
        WebSceneGlyphAtlasDebugFail(705, -1, -1, -1, runGlyphWords.len)
        return false
    let atlasEntryCount = atlasWords.len / WebSceneGlyphSdfAtlasHostStrideI32
    let glyphCount = glyphWords.len / WebSceneGlyphSdfGlyphHostStrideI32
    let runCount = runWords.len / WebSceneGlyphSdfRunHostStrideI32
    let runGlyphCount = runGlyphWords.len / WebSceneGlyphSdfRunGlyphHostStrideI32
    if atlasEntryCount <= 0 || glyphCount <= 0 || runCount <= 0 || runGlyphCount <= 0:
        WebSceneGlyphAtlasDebugFail(706, -1, -1, -1, runCount)
        return false
    setLen(atlas.fonts, atlasEntryCount)
    setLen(atlas.glyphs, glyphCount)
    setLen(atlas.runGlyphs, runGlyphCount)
    setLen(atlas.runs, runCount)

    var expectedAtlasWidth: int32
    var expectedAtlasHeight: int32
    var expectedPixelCount: int32
    for entryIndex in 0..<atlasEntryCount:
        let base = entryIndex * WebSceneGlyphSdfAtlasHostStrideI32
        let sdfAtlasId = atlasWords[base]
        let atlasWidth = atlasWords[base + 1]
        let atlasHeight = atlasWords[base + 2]
        let pixelStart = atlasWords[base + 3]
        let pixelCount = atlasWords[base + 4]
        let fontAtlasId = atlasWords[base + 5]
        let spreadPx = atlasWords[base + 6]
        let pxRange = atlasWords[base + 7]
        if sdfAtlasId <= 0 || atlasWidth <= 0 || atlasHeight <= 0 || pixelStart != 0 || pixelCount <= 0:
            WebSceneGlyphAtlasDebugFail(711, -1, -1, entryIndex, sdfAtlasId)
            return false
        if fontAtlasId <= 0 || spreadPx <= 0 || pxRange <= 0:
            WebSceneGlyphAtlasDebugFail(712, -1, -1, entryIndex, fontAtlasId)
            return false
        if pixelCount != atlasWidth * atlasHeight:
            WebSceneGlyphAtlasDebugFail(713, -1, -1, entryIndex, pixelCount)
            return false
        if entryIndex == 0:
            expectedAtlasWidth = atlasWidth
            expectedAtlasHeight = atlasHeight
            expectedPixelCount = pixelCount
        elif atlasWidth != expectedAtlasWidth || atlasHeight != expectedAtlasHeight || pixelCount != expectedPixelCount:
            WebSceneGlyphAtlasDebugFail(714, -1, -1, entryIndex, atlasWidth)
            return false
        if WebSceneGlyphAtlasFindFontIndex(atlas, fontAtlasId) >= 0:
            WebSceneGlyphAtlasDebugFail(715, -1, -1, entryIndex, fontAtlasId)
            return false
        let resourceIndex = WebSceneFontResourceIndexForAtlasId(graph, fontAtlasId)
        if resourceIndex < 0:
            WebSceneGlyphAtlasDebugFail(716, -1, -1, entryIndex, fontAtlasId)
            return false
        let resource = graph.resources[resourceIndex]
        var entry: WebSceneGlyphAtlasFontEntry
        entry.resourceId = resource.resourceId
        entry.fontAtlasId = fontAtlasId
        entry.sdfAtlasId = sdfAtlasId
        entry.sdfSpreadPx = spreadPx
        entry.sdfPxRange = pxRange
        entry.fontWeight = resource.fontWeight
        entry.fontFamily = resource.fontFamily
        entry.glyphStart = -1
        entry.glyphCount = 0
        font.WebFontInitEmpty(entry.face)
        atlas.fonts[entryIndex] = entry
    if suppliedPixelCount != expectedPixelCount:
        WebSceneGlyphAtlasDebugFail(721, -1, -1, -1, suppliedPixelCount)
        return false
    atlas.atlasWidth = expectedAtlasWidth
    atlas.atlasHeight = expectedAtlasHeight
    atlas.sdfPixelCount = expectedPixelCount
    atlas.sdfPixels = []
    if loadPixels:
        setLen(atlas.sdfPixels, pixels.len)
        for pixelIndex in 0..<pixels.len:
            atlas.sdfPixels[pixelIndex] = pixels[pixelIndex]
        WebSceneGlyphAtlasBumpSdfPixelVersion(atlas)

    for glyphIndex in 0..<glyphCount:
        let base = glyphIndex * WebSceneGlyphSdfGlyphHostStrideI32
        var glyph: WebSceneGlyphAtlasGlyphEntry
        glyph.glyphId = glyphWords[base]
        glyph.sdfAtlasId = glyphWords[base + 1]
        glyph.atlasX = glyphWords[base + 2]
        glyph.atlasY = glyphWords[base + 3]
        glyph.width = glyphWords[base + 4]
        glyph.height = glyphWords[base + 5]
        glyph.advance = glyphWords[base + 6]
        glyph.fontAtlasId = glyphWords[base + 7]
        glyph.sdfPixelStart = glyphWords[base + 8]
        glyph.sdfPixelCount = glyphWords[base + 9]
        glyph.codepoint = glyphWords[base + 10]
        glyph.fontSize = glyphWords[base + 11]
        if glyph.glyphId != glyphIndex + 1:
            WebSceneGlyphAtlasDebugFail(733, -1, -1, glyphIndex, glyph.glyphId)
            return false
        let fontIndex = WebSceneGlyphAtlasFindFontIndex(atlas, glyph.fontAtlasId)
        if fontIndex < 0:
            WebSceneGlyphAtlasDebugFail(731, -1, -1, glyphIndex, glyph.fontAtlasId)
            return false
        let fontEntry = atlas.fonts[fontIndex]
        if glyph.sdfAtlasId != fontEntry.sdfAtlasId:
            WebSceneGlyphAtlasDebugFail(732, -1, -1, glyphIndex, glyph.sdfAtlasId)
            return false
        glyph.sdfSpreadPx = fontEntry.sdfSpreadPx
        glyph.sdfPxRange = fontEntry.sdfPxRange
        glyph.glyphIndex = 0
        atlas.glyphs[glyphIndex] = glyph
        var updatedFontEntry = atlas.fonts[fontIndex]
        if updatedFontEntry.glyphCount == 0:
            updatedFontEntry.glyphStart = glyphIndex
        updatedFontEntry.glyphCount = updatedFontEntry.glyphCount + 1
        atlas.fonts[fontIndex] = updatedFontEntry

    for runGlyphIndex in 0..<runGlyphCount:
        let base = runGlyphIndex * WebSceneGlyphSdfRunGlyphHostStrideI32
        var runGlyph: WebSceneGlyphRunGlyph
        runGlyph.glyphId = runGlyphWords[base]
        runGlyph.advance = runGlyphWords[base + 1]
        atlas.runGlyphs[runGlyphIndex] = runGlyph

    var previousPaintIndex = -1
    for runIndex in 0..<runCount:
        var paintIndex = -1
        let base = runIndex * WebSceneGlyphSdfRunHostStrideI32
        var run: WebSceneGlyphRun
        run.glyphRunId = runWords[base]
        run.fontAtlasId = runWords[base + 1]
        run.sdfAtlasId = runWords[base + 2]
        run.glyphStart = runWords[base + 3]
        run.glyphCount = runWords[base + 4]
        run.advanceWidth = runWords[base + 5]
        run.routeIndex = runWords[base + 6]
        run.nodeId = runWords[base + 7]
        run.ordinal = runWords[base + 8]
        if run.routeIndex < 0 || run.nodeId <= 0 || run.ordinal < 0:
            WebSceneGlyphAtlasDebugFail(741, run.routeIndex, run.nodeId, run.ordinal, runIndex)
            return false
        if run.glyphRunId != runIndex + 1 || run.fontAtlasId <= 0 || run.sdfAtlasId <= 0:
            WebSceneGlyphAtlasDebugFail(743, run.routeIndex, run.nodeId, run.ordinal, run.glyphRunId)
            return false
        if run.glyphStart < 0 || run.glyphCount <= 0 || run.glyphStart + run.glyphCount > atlas.runGlyphs.len:
            WebSceneGlyphAtlasDebugFail(744, run.routeIndex, run.nodeId, run.ordinal, run.glyphStart)
            return false
        if run.advanceWidth <= 0:
            WebSceneGlyphAtlasDebugFail(745, run.routeIndex, run.nodeId, run.ordinal, run.advanceWidth)
            return false
        let runFontIndex = WebSceneGlyphAtlasFindFontIndex(atlas, run.fontAtlasId)
        if runFontIndex < 0:
            WebSceneGlyphAtlasDebugFail(746, run.routeIndex, run.nodeId, run.ordinal, run.fontAtlasId)
            return false
        if atlas.fonts[runFontIndex].sdfAtlasId != run.sdfAtlasId:
            WebSceneGlyphAtlasDebugFail(747, run.routeIndex, run.nodeId, run.ordinal, run.sdfAtlasId)
            return false
        var cursor = previousPaintIndex + 1
        while cursor < graph.paintOps.len:
            let sceneOp = graph.paintOps[cursor]
            if sceneOp.routeIndex == run.routeIndex && sceneOp.nodeId == run.nodeId && sceneOp.ordinal == run.ordinal:
                paintIndex = cursor
                break
            cursor = cursor + 1
        if paintIndex < 0:
            WebSceneGlyphAtlasDebugFail(741, -1, -1, runIndex, runCount)
            return false
        let sceneOp = graph.paintOps[paintIndex]
        if !WebScenePaintKindIsText(sceneOp.opKind):
            WebSceneGlyphAtlasDebugFail(742, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.opKind)
            return false
        previousPaintIndex = paintIndex
        atlas.runs[runIndex] = run

    for runGlyphIndex in 0..<atlas.runGlyphs.len:
        let runGlyph = atlas.runGlyphs[runGlyphIndex]
        if runGlyph.glyphId <= 0 || runGlyph.advance <= 0:
            WebSceneGlyphAtlasDebugFail(753, -1, -1, runGlyphIndex, runGlyph.glyphId)
            return false
        let glyphIndex = runGlyph.glyphId - 1
        if glyphIndex < 0 || glyphIndex >= atlas.glyphs.len:
            WebSceneGlyphAtlasDebugFail(754, -1, -1, runGlyphIndex, runGlyph.glyphId)
            return false
        if atlas.glyphs[glyphIndex].glyphId != runGlyph.glyphId || atlas.glyphs[glyphIndex].advance != runGlyph.advance:
            WebSceneGlyphAtlasDebugFail(755, -1, -1, runGlyphIndex, runGlyph.glyphId)
            return false
    return true

fn WebSceneGlyphAtlasHydratePrecomputedFontFacesAndPackCursor(graph: var WebSceneGraph,
                                                              atlas: var WebSceneGlyphAtlas): bool =
    var maxBottom = atlas.atlasHeight
    var lastRowY = 0
    for glyphIndex in 0..<atlas.glyphs.len:
        let glyph = atlas.glyphs[glyphIndex]
        let bottom = glyph.atlasY + glyph.height
        if bottom > maxBottom:
            maxBottom = bottom
        if glyph.atlasY > lastRowY:
            lastRowY = glyph.atlasY
    var nextX = 0
    var rowHeight = 0
    for glyphIndex in 0..<atlas.glyphs.len:
        let glyph = atlas.glyphs[glyphIndex]
        if glyph.atlasY != lastRowY:
            continue
        let right = glyph.atlasX + glyph.width
        if right > nextX:
            nextX = right
        if glyph.height > rowHeight:
            rowHeight = glyph.height
    if nextX >= atlas.atlasWidth:
        nextX = 0
        lastRowY = lastRowY + rowHeight
        rowHeight = 0
    atlas.glyphPackX = nextX
    atlas.glyphPackY = lastRowY
    atlas.glyphPackRowHeight = rowHeight
    atlas.atlasHeight = maxBottom
    for fontIndex in 0..<atlas.fonts.len:
        var entry = atlas.fonts[fontIndex]
        let resourceIndex = WebSceneFontResourceIndexForAtlasId(graph, entry.fontAtlasId)
        if resourceIndex < 0:
            WebSceneGlyphAtlasDebugFail(797, -1, -1, fontIndex, entry.fontAtlasId)
            return false
        var face: font.WebFontFace
        if !WebSceneLoadFontResourceFace(graph.resources[resourceIndex], face):
            WebSceneGlyphAtlasDebugFail(798, -1, -1, fontIndex, entry.fontAtlasId)
            return false
        entry.face = face
        atlas.fonts[fontIndex] = entry
    return true

fn WebSceneInt32WordsEqual(left: int32[], right: int32[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn WebSceneFontResourceIndexForAtlasId(graph: var WebSceneGraph, fontAtlasId: int32): int32 =
    if fontAtlasId <= 0:
        return -1
    for i in 0..<graph.resources.len:
        let resource = graph.resources[i]
        if resource.fontWeight <= 0:
            continue
        if resource.resourceKind != "font_subset":
            return -1
        if WebSceneResourceIdHash31(resource.resourceId) == fontAtlasId:
            return i
    return -1

fn WebSceneBuildGpuCommandsFromCompositorFrame(frame: var WebSceneCompositorFrame,
                                               gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    WebSceneGpuCommandBufferInit(gpuBuffer)
    if frame.routeIndex < 0:
        return false
    gpuBuffer.routeIndex = frame.routeIndex
    gpuBuffer.layerId = 0
    var nextCommandStart = 0
    for layerIndex in 0..<frame.layers.len:
        let start = frame.layers[layerIndex].commandStart
        let count = frame.layers[layerIndex].commandCount
        if start < 0 || count < 0:
            return false
        if start != nextCommandStart:
            return false
        if start + count > frame.commands.len:
            return false
        nextCommandStart = start + count
    if nextCommandStart != frame.commands.len:
        return false
    for commandIndex in 0..<frame.commands.len:
        let command = frame.commands[commandIndex]
        if !WebSceneGpuCommandKindSupported(command.kind):
            return false
        if command.width < 0 || command.height < 0:
            return false
        add(gpuBuffer.commands, command)
    return true

fn WebSceneGpuCommandTextAt(buffer: var WebSceneGpuCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
        return ""
    return buffer.commands[index].textContent

fn WebSceneGpuCommandIconPrimitiveCountAt(buffer: var WebSceneGpuCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return -1
    return buffer.commands[index].iconPrimitiveCount

fn WebSceneBuildGpuCommandsFromPaintCommands(paintBuffer: var WebScenePaintCommandBuffer,
                                             gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    WebSceneGpuCommandBufferInit(gpuBuffer)
    if paintBuffer.routeIndex < 0:
        return false
    gpuBuffer.routeIndex = paintBuffer.routeIndex
    gpuBuffer.layerId = paintBuffer.layerId
    for i in 0..<paintBuffer.ops.len:
        if !WebSceneAppendGpuCommandFromPaintOp(paintBuffer.routeIndex, paintBuffer.layerId, paintBuffer.ops[i], gpuBuffer.commands):
            return false
    return true

fn WebSceneBuildGpuCommandsFromPaintCommandsWithImageAtlas(paintBuffer: var WebScenePaintCommandBuffer,
                                                           atlas: var WebSceneImageAtlas,
                                                           gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    if !WebSceneBuildGpuCommandsFromPaintCommands(paintBuffer, gpuBuffer):
        return false
    for i in 0..<gpuBuffer.commands.len:
        if gpuBuffer.commands[i].kind == WebSceneGpuDrawImage:
            if WebSceneImageAtlasFindTextureIndex(atlas, gpuBuffer.commands[i].imageId) < 0:
                return false
    return true

fn WebSceneBuildActiveRouteGpuCommandsWithAtlases(graph: var WebSceneGraph,
                                                  layerId: int32,
                                                  imageAtlas: var WebSceneImageAtlas,
                                                  svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                  gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    if graph.activeRouteIndex < 0:
        return false
    return WebSceneBuildRouteLayerGpuCommandsWithAtlases(graph, graph.activeRouteIndex, layerId, imageAtlas, svgAtlas, gpuBuffer)

fn WebSceneBuildRouteLayerGpuCommandsWithAtlases(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 layerId: int32,
                                                 imageAtlas: var WebSceneImageAtlas,
                                                 svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                 gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    return WebSceneBuildSceneGpuCommandsScopedWithAtlases(graph, routeIndex, layerId, 0, imageAtlas, svgAtlas, gpuBuffer)

fn WebSceneAppendGradientGpuCommandsForNodeWithAtlases(graph: var WebSceneGraph,
                                                       routeIndex: int32,
                                                       layerId: int32,
                                                       subtreeRootNodeId: int32,
                                                       nodeId: int32,
                                                       imageAtlas: var WebSceneImageAtlas,
                                                       svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                       commands: var WebSceneGpuCommand[]): bool =
    for i in 0..<graph.paintGradients.len:
        let sceneOp = graph.paintGradients[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        let nodeLayerId = WebSceneFindNodeLayerId(graph, sceneOp.nodeId)
        if nodeLayerId < 0:
            return false
        if layerId > 0 && nodeLayerId != layerId:
            continue
        if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, sceneOp.nodeId):
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        if !WebSceneAppendGpuCommandFromScenePaintOpWithAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, commands):
            return false
    return true

fn WebSceneAppendShadowGpuCommandsForNodeWithAtlases(graph: var WebSceneGraph,
                                                     routeIndex: int32,
                                                     layerId: int32,
                                                     subtreeRootNodeId: int32,
                                                     nodeId: int32,
                                                     imageAtlas: var WebSceneImageAtlas,
                                                     svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                     commands: var WebSceneGpuCommand[]): bool =
    for i in 0..<graph.paintShadows.len:
        let sceneOp = graph.paintShadows[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        let nodeLayerId = WebSceneFindNodeLayerId(graph, sceneOp.nodeId)
        if nodeLayerId < 0:
            return false
        if layerId > 0 && nodeLayerId != layerId:
            continue
        if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, sceneOp.nodeId):
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        if !WebSceneAppendGpuCommandFromScenePaintOpWithAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, commands):
            return false
    return true

fn WebSceneAppendNodeGpuCommandsWithAtlases(graph: var WebSceneGraph,
                                            routeIndex: int32,
                                            layerId: int32,
                                            subtreeRootNodeId: int32,
                                            nodeId: int32,
                                            imageAtlas: var WebSceneImageAtlas,
                                            svgAtlas: var WebSceneSvgDisplayListAtlas,
                                            commands: var WebSceneGpuCommand[]): bool =
    let nodeLayerId = WebSceneFindNodeLayerId(graph, nodeId)
    if nodeLayerId < 0:
        return false
    if layerId > 0 && nodeLayerId != layerId:
        return true
    if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, nodeId):
        return true
    if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, nodeId):
        return true
    if !WebSceneAppendShadowGpuCommandsForNodeWithAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, commands):
        return false
    var backgroundAppended = false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        if sceneOp.opKind != WebScenePaintFill:
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        if !WebSceneAppendGpuCommandFromScenePaintOpWithAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, commands):
            return false
        if !WebSceneAppendGradientGpuCommandsForNodeWithAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, commands):
            return false
        backgroundAppended = true
    if !backgroundAppended:
        if !WebSceneAppendGradientGpuCommandsForNodeWithAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, commands):
            return false
    if !WebSceneAppendMediaSurfaceGpuCommandsForNode(graph, routeIndex, nodeId, nodeLayerId, commands):
        return false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        if sceneOp.opKind == WebScenePaintFill:
            continue
        if WebScenePaintImageCoveredByMediaSurface(graph, sceneOp):
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        if !WebSceneAppendGpuCommandFromScenePaintOpWithAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, commands):
            return false
    return true

fn WebSceneNodeIdListContains(nodeIds: var int32[], nodeId: int32): bool =
    for i in 0..<nodeIds.len:
        if nodeIds[i] == nodeId:
            return true
    return false

fn WebSceneBuildRoutePaintNodeOrder(graph: var WebSceneGraph,
                                    routeIndex: int32,
                                    nodeOrder: var int32[]): bool =
    nodeOrder = []
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    var layoutBoxCount = 0
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].routeIndex != routeIndex:
            continue
        layoutBoxCount = layoutBoxCount + 1
        let nodeId = graph.layoutBoxes[i].nodeId
        if !WebSceneNodeIdListContains(nodeOrder, nodeId):
            add(nodeOrder, nodeId)
    if layoutBoxCount > 0:
        return true
    for i in 0..<graph.nodes.len:
        if graph.nodes[i].routeIndex != routeIndex:
            continue
        add(nodeOrder, graph.nodes[i].nodeId)
    return true

fn WebSceneBuildSceneGpuCommandsScopedWithAtlases(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 layerId: int32,
                                                 subtreeRootNodeId: int32,
                                                 imageAtlas: var WebSceneImageAtlas,
                                                 svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                 gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    WebSceneGpuCommandBufferInit(gpuBuffer)
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if layerId > 0 && WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return false
    if subtreeRootNodeId > 0 && !WebSceneNodeBelongsToRoute(graph, routeIndex, subtreeRootNodeId):
        return false
    gpuBuffer.routeIndex = routeIndex
    gpuBuffer.layerId = layerId
    var nodeOrder: int32[]
    if !WebSceneBuildRoutePaintNodeOrder(graph, routeIndex, nodeOrder):
        return false
    for i in 0..<nodeOrder.len:
        let nodeId = nodeOrder[i]
        if !WebSceneAppendNodeGpuCommandsWithAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, gpuBuffer.commands):
            return false
    return true

fn WebSceneBuildActiveRouteGpuCommandsWithFullAtlases(graph: var WebSceneGraph,
                                                      layerId: int32,
                                                      imageAtlas: var WebSceneImageAtlas,
                                                      svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                      glyphAtlas: var WebSceneGlyphAtlas,
                                                      gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    if graph.activeRouteIndex < 0:
        return false
    return WebSceneBuildRouteLayerGpuCommandsWithFullAtlases(graph, graph.activeRouteIndex, layerId, imageAtlas, svgAtlas, glyphAtlas, gpuBuffer)

fn WebSceneBuildRouteLayerGpuCommandsWithFullAtlases(graph: var WebSceneGraph,
                                                     routeIndex: int32,
                                                     layerId: int32,
                                                     imageAtlas: var WebSceneImageAtlas,
                                                     svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                     glyphAtlas: var WebSceneGlyphAtlas,
                                                     gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    return WebSceneBuildSceneGpuCommandsScopedWithFullAtlases(graph, routeIndex, layerId, 0, imageAtlas, svgAtlas, glyphAtlas, gpuBuffer)

fn WebSceneAppendGradientGpuCommandsForNodeWithFullAtlases(graph: var WebSceneGraph,
                                                           routeIndex: int32,
                                                           layerId: int32,
                                                           subtreeRootNodeId: int32,
                                                           nodeId: int32,
                                                           imageAtlas: var WebSceneImageAtlas,
                                                           svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                           glyphAtlas: var WebSceneGlyphAtlas,
                                                           commands: var WebSceneGpuCommand[]): bool =
    if nodeId <= 0 || nodeId >= graph.paintGradientStartByNodeId.len || nodeId >= graph.paintGradientEndByNodeId.len:
        return false
    let startIndex = graph.paintGradientStartByNodeId[nodeId]
    if startIndex < 0:
        return true
    let endIndex = graph.paintGradientEndByNodeId[nodeId]
    if endIndex < startIndex || endIndex > graph.paintGradients.len:
        return false
    for i in startIndex..<endIndex:
        let sceneOp = graph.paintGradients[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        let nodeLayerId = WebSceneFindNodeLayerId(graph, sceneOp.nodeId)
        if nodeLayerId < 0:
            return false
        if layerId > 0 && nodeLayerId != layerId:
            continue
        if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, sceneOp.nodeId):
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        if !WebSceneAppendGpuCommandFromScenePaintOpWithFullAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, glyphAtlas, commands):
            return false
    return true

fn WebSceneAppendShadowGpuCommandsForNodeWithFullAtlases(graph: var WebSceneGraph,
                                                         routeIndex: int32,
                                                         layerId: int32,
                                                         subtreeRootNodeId: int32,
                                                         nodeId: int32,
                                                         imageAtlas: var WebSceneImageAtlas,
                                                         svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                         glyphAtlas: var WebSceneGlyphAtlas,
                                                         commands: var WebSceneGpuCommand[]): bool =
    if nodeId <= 0 || nodeId >= graph.paintShadowStartByNodeId.len || nodeId >= graph.paintShadowEndByNodeId.len:
        return false
    let startIndex = graph.paintShadowStartByNodeId[nodeId]
    if startIndex < 0:
        return true
    let endIndex = graph.paintShadowEndByNodeId[nodeId]
    if endIndex < startIndex || endIndex > graph.paintShadows.len:
        return false
    for i in startIndex..<endIndex:
        let sceneOp = graph.paintShadows[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        let nodeLayerId = WebSceneFindNodeLayerId(graph, sceneOp.nodeId)
        if nodeLayerId < 0:
            return false
        if layerId > 0 && nodeLayerId != layerId:
            continue
        if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, sceneOp.nodeId):
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        if !WebSceneAppendGpuCommandFromScenePaintOpWithFullAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, glyphAtlas, commands):
            return false
    return true

fn WebSceneAppendNodeGpuCommandsWithFullAtlases(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                layerId: int32,
                                                subtreeRootNodeId: int32,
                                                nodeId: int32,
                                                imageAtlas: var WebSceneImageAtlas,
                                                svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                glyphAtlas: var WebSceneGlyphAtlas,
                                                commands: var WebSceneGpuCommand[]): bool =
    let nodeLayerId = WebSceneFindNodeLayerId(graph, nodeId)
    if nodeLayerId < 0:
        return false
    if layerId > 0 && nodeLayerId != layerId:
        return true
    if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, nodeId):
        return true
    if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, nodeId):
        return true
    if nodeId <= 0 || nodeId >= graph.paintOpStartByNodeId.len || nodeId >= graph.paintOpEndByNodeId.len:
        return false
    if !WebSceneAppendShadowGpuCommandsForNodeWithFullAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, glyphAtlas, commands):
        return false
    var backgroundAppended = false
    let startIndex = graph.paintOpStartByNodeId[nodeId]
    let endIndex = graph.paintOpEndByNodeId[nodeId]
    if startIndex >= 0 && (endIndex < startIndex || endIndex > graph.paintOps.len):
        return false
    if startIndex >= 0:
        for i in startIndex..<endIndex:
            let sceneOp = graph.paintOps[i]
            if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
                continue
            if sceneOp.opKind != WebScenePaintFill:
                continue
            if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
                continue
            if !WebSceneAppendGpuCommandFromScenePaintOpWithFullAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, glyphAtlas, commands):
                return false
            if !WebSceneAppendGradientGpuCommandsForNodeWithFullAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, glyphAtlas, commands):
                return false
            backgroundAppended = true
    if !backgroundAppended:
        if !WebSceneAppendGradientGpuCommandsForNodeWithFullAtlases(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, imageAtlas, svgAtlas, glyphAtlas, commands):
            return false
    if !WebSceneAppendMediaSurfaceGpuCommandsForNode(graph, routeIndex, nodeId, nodeLayerId, commands):
        return false
    if startIndex >= 0:
        for i in startIndex..<endIndex:
            let sceneOp = graph.paintOps[i]
            if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
                continue
            if sceneOp.opKind == WebScenePaintFill:
                continue
            if WebScenePaintImageCoveredByMediaSurface(graph, sceneOp):
                continue
            if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
                continue
            if !WebSceneAppendGpuCommandFromScenePaintOpWithFullAtlases(sceneOp, nodeLayerId, imageAtlas, svgAtlas, glyphAtlas, commands):
                return false
    return true

fn WebSceneBuildSceneGpuCommandsScopedWithFullAtlases(graph: var WebSceneGraph,
                                                     routeIndex: int32,
                                                     layerId: int32,
                                                     subtreeRootNodeId: int32,
                                                     imageAtlas: var WebSceneImageAtlas,
                                                     svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                     glyphAtlas: var WebSceneGlyphAtlas,
                                                     gpuBuffer: var WebSceneGpuCommandBuffer): bool =
    WebSceneGpuCommandBufferInit(gpuBuffer)
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if layerId > 0 && WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return false
    if subtreeRootNodeId > 0 && !WebSceneNodeBelongsToRoute(graph, routeIndex, subtreeRootNodeId):
        return false
    if !WebSceneRebuildPaintCommandRangeIndexes(graph):
        return false
    gpuBuffer.routeIndex = routeIndex
    gpuBuffer.layerId = layerId
    var nodeOrder: int32[]
    if !WebSceneBuildRoutePaintNodeOrder(graph, routeIndex, nodeOrder):
        return false
    for i in 0..<nodeOrder.len:
        let nodeId = nodeOrder[i]
        if !WebSceneAppendNodeGpuCommandsWithFullAtlases(graph,
                                                         routeIndex,
                                                         layerId,
                                                         subtreeRootNodeId,
                                                         nodeId,
                                                         imageAtlas,
                                                         svgAtlas,
                                                         glyphAtlas,
                                                         gpuBuffer.commands):
            return false
    return true

fn WebSceneBuildImageAtlasFromResources(graph: var WebSceneGraph, atlas: var WebSceneImageAtlas): bool =
    WebSceneImageAtlasInit(atlas)
    for i in 0..<graph.resources.len:
        let resource = graph.resources[i]
        if resource.pixelCount == 0:
            continue
        if resource.width <= 0 || resource.height <= 0:
            return false
        let expected = resource.width * resource.height
        if expected <= 0:
            return false
        if resource.pixelCount != expected || resource.pixels.len != expected:
            return false
        let textureId = WebSceneResourceIdHash31(resource.resourceId)
        if textureId <= 0:
            return false
        if WebSceneImageAtlasFindTextureIndex(atlas, textureId) >= 0:
            return false
        var entry: WebSceneImageAtlasEntry
        entry.resourceKind = resource.resourceKind
        entry.resourceId = resource.resourceId
        entry.textureId = textureId
        entry.width = resource.width
        entry.height = resource.height
        entry.pixelStart = atlas.pixels.len
        entry.pixelCount = resource.pixelCount
        add(atlas.entries, entry)
        for pixelIndex in 0..<resource.pixels.len:
            add(atlas.pixels, resource.pixels[pixelIndex])
    return true

fn WebSceneImageAtlasTextureCount(atlas: var WebSceneImageAtlas): int32 =
    return atlas.entries.len

fn WebSceneImageAtlasTextureIdAt(atlas: var WebSceneImageAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return -1
    return atlas.entries[index].textureId

fn WebSceneImageAtlasResourceIdAt(atlas: var WebSceneImageAtlas, index: int32): str =
    if index < 0 || index >= atlas.entries.len:
        return ""
    return atlas.entries[index].resourceId

fn WebSceneImageAtlasWidthAt(atlas: var WebSceneImageAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return 0
    return atlas.entries[index].width

fn WebSceneImageAtlasHeightAt(atlas: var WebSceneImageAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return 0
    return atlas.entries[index].height

fn WebSceneImageAtlasPixelCountAt(atlas: var WebSceneImageAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return 0
    return atlas.entries[index].pixelCount

fn WebSceneImageAtlasPixelAt(atlas: var WebSceneImageAtlas, index: int32, pixelIndex: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return 0
    if pixelIndex < 0 || pixelIndex >= atlas.entries[index].pixelCount:
        return 0
    let atlasPixelIndex = atlas.entries[index].pixelStart + pixelIndex
    if atlasPixelIndex < 0 || atlasPixelIndex >= atlas.pixels.len:
        return 0
    return atlas.pixels[atlasPixelIndex]

fn WebSceneEncodeImageAtlasHostBatch(atlas: var WebSceneImageAtlas,
                                     entryWords: var int32[],
                                     pixelWords: var int32[]): bool =
    entryWords = []
    pixelWords = []
    for i in 0..<atlas.entries.len:
        let entry = atlas.entries[i]
        if entry.textureId <= 0 || entry.width <= 0 || entry.height <= 0:
            return false
        if entry.pixelStart < 0 || entry.pixelCount <= 0:
            return false
        if entry.pixelStart + entry.pixelCount > atlas.pixels.len:
            return false
        if entry.pixelCount != entry.width * entry.height:
            return false
        add(entryWords, entry.textureId)
        add(entryWords, entry.width)
        add(entryWords, entry.height)
        add(entryWords, entry.pixelStart)
        add(entryWords, entry.pixelCount)
    for pixelIndex in 0..<atlas.pixels.len:
        add(pixelWords, atlas.pixels[pixelIndex])
    let entryWordCountValid = entryWords.len == atlas.entries.len * WebSceneImageAtlasHostStrideI32
    let pixelWordCountValid = pixelWords.len == atlas.pixels.len
    if !(entryWordCountValid):
        return false
    if !(pixelWordCountValid):
        return false
    return true

@borrows
fn WebSceneImageAtlasTextureIdForResource(atlas: var WebSceneImageAtlas, resourceId: str): int32 =
    let textureId = WebSceneResourceIdHash31(resourceId)
    if textureId <= 0:
        return -1
    if WebSceneImageAtlasFindTextureIndex(atlas, textureId) < 0:
        if WebSceneIsStateImageResourceId(resourceId):
            return textureId
        return -1
    return textureId

fn WebSceneImageAtlasFindTextureIndex(atlas: var WebSceneImageAtlas, textureId: int32): int32 =
    for i in 0..<atlas.entries.len:
        if atlas.entries[i].textureId == textureId:
            return i
    return -1

fn WebSceneBuildSvgDisplayListAtlasFromPaintOps(graph: var WebSceneGraph,
                                                atlas: var WebSceneSvgDisplayListAtlas): bool =
    WebSceneSvgDisplayListAtlasInit(atlas)
    WebSceneSvgAtlasDebugClear()
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if sceneOp.opKind != WebScenePaintSvgIcon:
            continue
        if sceneOp.resourceId.len == 0:
            WebSceneSvgAtlasDebugFail(301, i, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.resourceId)
            return false
        if WebSceneFindResourceIndex(graph, "svg_icon", sceneOp.resourceId) < 0:
            WebSceneSvgAtlasDebugFail(302, i, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.resourceId)
            return false
        let primitiveCount = WebScenePaintSvgPrimitiveCount(graph, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if primitiveCount <= 0:
            WebSceneSvgAtlasDebugFail(303, i, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.resourceId)
            return false
        let existingResourceIndex = WebSceneSvgDisplayListFindResourceIndex(atlas, sceneOp.resourceId)
        var entryResourceId = WebSceneCloneStateString(sceneOp.resourceId)
        if existingResourceIndex >= 0:
            if WebSceneSvgDisplayListMatchesScenePaintOp(graph, sceneOp, atlas, existingResourceIndex):
                continue
            var uniqueId = strings.ConcatStr(sceneOp.resourceId, "#")
            uniqueId = strings.ConcatStr(uniqueId, strings.IntToStr(sceneOp.routeIndex))
            uniqueId = strings.ConcatStr(uniqueId, ":")
            uniqueId = strings.ConcatStr(uniqueId, strings.IntToStr(sceneOp.nodeId))
            uniqueId = strings.ConcatStr(uniqueId, ":")
            uniqueId = strings.ConcatStr(uniqueId, strings.IntToStr(sceneOp.ordinal))
            graph.paintOps[i].resourceId = WebSceneCloneStateString(uniqueId)
            entryResourceId = uniqueId
        let displayListId = atlas.entries.len + 1
        if displayListId <= 0:
            WebSceneSvgAtlasDebugFail(305, i, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.resourceId)
            return false
        if WebSceneSvgDisplayListFindIndex(atlas, displayListId) >= 0:
            WebSceneSvgAtlasDebugFail(306, i, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.resourceId)
            return false
        var entry: WebSceneSvgDisplayListEntry
        entry.resourceId = entryResourceId
        entry.displayListId = displayListId
        entry.primitiveStart = atlas.primitives.len
        entry.primitiveCount = primitiveCount
        add(atlas.entries, entry)
        for primitiveIndex in 0..<graph.paintSvgPrimitives.len:
            if graph.paintSvgPrimitives[primitiveIndex].routeIndex == sceneOp.routeIndex &&
               graph.paintSvgPrimitives[primitiveIndex].nodeId == sceneOp.nodeId &&
               graph.paintSvgPrimitives[primitiveIndex].ordinal == sceneOp.ordinal:
                add(atlas.primitives, graph.paintSvgPrimitives[primitiveIndex].primitive)
    return true

fn WebSceneSvgDisplayListCount(atlas: var WebSceneSvgDisplayListAtlas): int32 =
    return atlas.entries.len

fn WebSceneSvgDisplayListIdAt(atlas: var WebSceneSvgDisplayListAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return -1
    return atlas.entries[index].displayListId

fn WebSceneSvgDisplayListResourceIdAt(atlas: var WebSceneSvgDisplayListAtlas, index: int32): str =
    if index < 0 || index >= atlas.entries.len:
        return ""
    return atlas.entries[index].resourceId

fn WebSceneSvgDisplayListPrimitiveCountAt(atlas: var WebSceneSvgDisplayListAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return 0
    return atlas.entries[index].primitiveCount

fn WebSceneSvgDisplayListPrimitiveKindAt(atlas: var WebSceneSvgDisplayListAtlas,
                                         index: int32,
                                         primitiveIndex: int32): int32 =
    if index < 0 || index >= atlas.entries.len:
        return -1
    if primitiveIndex < 0 || primitiveIndex >= atlas.entries[index].primitiveCount:
        return -1
    let atlasPrimitiveIndex = atlas.entries[index].primitiveStart + primitiveIndex
    if atlasPrimitiveIndex < 0 || atlasPrimitiveIndex >= atlas.primitives.len:
        return -1
    return atlas.primitives[atlasPrimitiveIndex].kind

@borrows
fn WebSceneSvgPrimitiveHostFieldsValid(primitive: paint.PaintSvgPrimitive): bool =
    if primitive.kind == paint.PaintSvgPrimitiveLine:
        return true
    if primitive.kind == paint.PaintSvgPrimitiveCircle:
        if !(primitive.rx > 0):
            return false
        if !(primitive.ry > 0):
            return false
        if !(primitive.rx == primitive.ry):
            return false
        return true
    if primitive.kind == paint.PaintSvgPrimitiveEllipse:
        if !(primitive.rx > 0):
            return false
        if !(primitive.ry > 0):
            return false
        return true
    if primitive.kind == paint.PaintSvgPrimitiveRect:
        if !(primitive.x2 > 0):
            return false
        if !(primitive.y2 > 0):
            return false
        return true
    if primitive.kind == paint.PaintSvgPrimitiveTriangle:
        let dx1 = primitive.x2 - primitive.x1
        let dy1 = primitive.y2 - primitive.y1
        let dx2 = primitive.cx - primitive.x1
        let dy2 = primitive.cy - primitive.y1
        return dx1 * dy2 - dy1 * dx2 != 0
    if primitive.kind == paint.PaintSvgPrimitiveFillMarker:
        return true
    return false

fn WebSceneEncodeSvgDisplayListHostBatch(atlas: var WebSceneSvgDisplayListAtlas,
                                         entryWords: var int32[],
                                         primitiveWords: var int32[]): bool =
    entryWords = []
    primitiveWords = []
    for i in 0..<atlas.entries.len:
        let entry = atlas.entries[i]
        if entry.displayListId <= 0 || entry.primitiveStart < 0 || entry.primitiveCount <= 0:
            return false
        if entry.primitiveStart + entry.primitiveCount > atlas.primitives.len:
            return false
        add(entryWords, entry.displayListId)
        add(entryWords, entry.primitiveStart)
        add(entryWords, entry.primitiveCount)
    for primitiveIndex in 0..<atlas.primitives.len:
        let primitive = atlas.primitives[primitiveIndex]
        if !WebSceneSvgPrimitiveHostFieldsValid(primitive):
            return false
        add(primitiveWords, primitive.kind)
        add(primitiveWords, primitive.x1)
        add(primitiveWords, primitive.y1)
        add(primitiveWords, primitive.x2)
        add(primitiveWords, primitive.y2)
        add(primitiveWords, primitive.cx)
        add(primitiveWords, primitive.cy)
        add(primitiveWords, primitive.rx)
        add(primitiveWords, primitive.ry)
    let entryWordCountValid = entryWords.len == atlas.entries.len * WebSceneSvgDisplayListEntryHostStrideI32
    let primitiveWordCountValid = primitiveWords.len == atlas.primitives.len * WebSceneSvgPrimitiveHostStrideI32
    if !(entryWordCountValid):
        return false
    if !(primitiveWordCountValid):
        return false
    return true

@borrows
fn WebSceneSvgDisplayListIdForResource(atlas: var WebSceneSvgDisplayListAtlas, resourceId: str): int32 =
    let index = WebSceneSvgDisplayListFindResourceIndex(atlas, resourceId)
    if index < 0:
        return -1
    return atlas.entries[index].displayListId

@borrows
fn WebSceneSvgDisplayListPrimitiveCountForResource(atlas: var WebSceneSvgDisplayListAtlas, resourceId: str): int32 =
    let index = WebSceneSvgDisplayListFindResourceIndex(atlas, resourceId)
    if index < 0:
        return 0
    return atlas.entries[index].primitiveCount

@borrows
fn WebSceneSvgDisplayListFindResourceIndex(atlas: var WebSceneSvgDisplayListAtlas, resourceId: str): int32 =
    for i in 0..<atlas.entries.len:
        if atlas.entries[i].resourceId == resourceId:
            return i
    return -1

fn WebSceneSvgDisplayListFindIndex(atlas: var WebSceneSvgDisplayListAtlas, displayListId: int32): int32 =
    for i in 0..<atlas.entries.len:
        if atlas.entries[i].displayListId == displayListId:
            return i
    return -1

@borrows
fn WebSceneSvgDisplayListMatchesScenePaintOp(graph: var WebSceneGraph,
                                             sceneOp: WebScenePaintOp,
                                             atlas: var WebSceneSvgDisplayListAtlas,
                                             entryIndex: int32): bool =
    if entryIndex < 0 || entryIndex >= atlas.entries.len:
        return false
    let primitiveCount = WebScenePaintSvgPrimitiveCount(graph, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
    if primitiveCount != atlas.entries[entryIndex].primitiveCount:
        return false
    var matched = 0
    for primitiveIndex in 0..<graph.paintSvgPrimitives.len:
        if graph.paintSvgPrimitives[primitiveIndex].routeIndex == sceneOp.routeIndex &&
           graph.paintSvgPrimitives[primitiveIndex].nodeId == sceneOp.nodeId &&
           graph.paintSvgPrimitives[primitiveIndex].ordinal == sceneOp.ordinal:
            let atlasPrimitiveIndex = atlas.entries[entryIndex].primitiveStart + matched
            if atlasPrimitiveIndex < 0 || atlasPrimitiveIndex >= atlas.primitives.len:
                return false
            if !WebSceneSvgPrimitiveEqual(graph.paintSvgPrimitives[primitiveIndex].primitive, atlas.primitives[atlasPrimitiveIndex]):
                return false
            matched = matched + 1
    if matched == primitiveCount:
        return true
    return false

@borrows
fn WebSceneSvgPrimitiveEqual(left: paint.PaintSvgPrimitive, right: paint.PaintSvgPrimitive): bool =
    if left.kind != right.kind:
        return false
    if left.x1 != right.x1 || left.y1 != right.y1:
        return false
    if left.x2 != right.x2 || left.y2 != right.y2:
        return false
    if left.cx != right.cx || left.cy != right.cy:
        return false
    if left.rx != right.rx || left.ry != right.ry:
        return false
    return true

fn WebSceneBuildGlyphAtlasFromPaintOps(graph: var WebSceneGraph,
                                       atlas: var WebSceneGlyphAtlas): bool =
    WebSceneGlyphAtlasDebugClear()
    WebSceneGlyphAtlasInit(atlas)
    if !WebSceneGlyphAtlasAppendFontResources(graph, atlas):
        return false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if !WebSceneTextPaintOpEligibleForGlyphAtlas(graph, sceneOp):
            continue
        if !WebSceneGlyphAtlasAppendTextRun(sceneOp, atlas):
            return false
    if !WebSceneGlyphAtlasCompactSdfPixels(atlas):
        return false
    return true

fn WebSceneGlyphAtlasAppendFontResources(graph: var WebSceneGraph,
                                         atlas: var WebSceneGlyphAtlas): bool =
    for i in 0..<graph.resources.len:
        let resource = graph.resources[i]
        if resource.fontWeight <= 0:
            continue
        if !(resource.resourceKind == "font_subset"):
            WebSceneGlyphAtlasDebugFail(1, -1, -1, i, 0)
            return false
        if resource.resourceId.len == 0:
            WebSceneGlyphAtlasDebugFail(2, -1, -1, i, 0)
            return false
        let fontAtlasId = WebSceneResourceIdHash31(resource.resourceId)
        if fontAtlasId <= 0:
            WebSceneGlyphAtlasDebugFail(3, -1, -1, i, 0)
            return false
        let sdfAtlasId = atlas.fonts.len + 1
        var face: font.WebFontFace
        if !WebSceneLoadFontResourceFace(resource, face):
            WebSceneGlyphAtlasDebugFail(4, -1, -1, i, 0)
            return false
        if WebSceneGlyphAtlasFindFontIndex(atlas, fontAtlasId) >= 0:
            WebSceneGlyphAtlasDebugFail(5, -1, -1, i, 0)
            return false
        var entry: WebSceneGlyphAtlasFontEntry
        entry.resourceId = resource.resourceId
        entry.fontAtlasId = fontAtlasId
        entry.sdfAtlasId = sdfAtlasId
        entry.sdfSpreadPx = WebSceneGlyphSdfSpreadPx
        entry.sdfPxRange = WebSceneGlyphSdfPxRange
        entry.fontWeight = resource.fontWeight
        entry.fontFamily = resource.fontFamily
        entry.glyphStart = -1
        entry.glyphCount = 0
        entry.face = face
        add(atlas.fonts, entry)
    return true

@borrows
fn WebSceneLoadFontResourceFace(resource: WebSceneResource,
                                face: var font.WebFontFace): bool =
    font.WebFontInitEmpty(face)
    if resource.resourceKind != "font_subset":
        return false
    if resource.fontBytes.len > 0:
        return font.WebFontLoadSfnt(share(resource.fontBytes), face)
    if resource.data.len > 0:
        return font.WebFontLoadSfntBase64(share(resource.data), face)
    return false

fn WebSceneGlyphAtlasCompactSdfPixels(atlas: var WebSceneGlyphAtlas): bool =
    if atlas.glyphs.len <= 0 || atlas.atlasHeight <= 0:
        return true
    if atlas.atlasWidth <= 0:
        return false
    var maxRight: int32
    var maxBottom: int32
    for i in 0..<atlas.glyphs.len:
        let glyph = atlas.glyphs[i]
        if glyph.width <= 0 || glyph.height <= 0:
            return false
        if glyph.atlasX < 0 || glyph.atlasY < 0:
            return false
        let right = glyph.atlasX + glyph.width
        let bottom = glyph.atlasY + glyph.height
        if right > atlas.atlasWidth || bottom > atlas.atlasHeight:
            return false
        if right > maxRight:
            maxRight = right
        if bottom > maxBottom:
            maxBottom = bottom
    if maxRight <= 0 || maxBottom <= 0:
        return false
    let oldWidth = atlas.atlasWidth
    let oldPixelCount = oldWidth * atlas.atlasHeight
    if oldPixelCount <= 0 || atlas.sdfPixels.len < oldPixelCount:
        return false
    if maxRight == atlas.atlasWidth && maxBottom == atlas.atlasHeight:
        atlas.sdfPixelCount = atlas.sdfPixels.len
        return true
    let compactPixelCount = maxRight * maxBottom
    if compactPixelCount <= 0:
        return false
    var compactPixels: uint8[]
    setLen(compactPixels, compactPixelCount)
    var compactWriteIndex = 0
    for y in 0..<maxBottom:
        let oldRow = y * oldWidth
        for x in 0..<maxRight:
            let oldIndex = oldRow + x
            if oldIndex < 0 || oldIndex >= atlas.sdfPixels.len:
                return false
            compactPixels[compactWriteIndex] = atlas.sdfPixels[oldIndex]
            compactWriteIndex = compactWriteIndex + 1
    if compactWriteIndex != compactPixelCount:
        return false
    atlas.sdfPixels = compactPixels
    atlas.atlasWidth = maxRight
    atlas.atlasHeight = maxBottom
    atlas.sdfPixelCount = compactPixelCount
    WebSceneGlyphAtlasBumpSdfPixelVersion(atlas)
    for i in 0..<atlas.glyphs.len:
        var glyph = atlas.glyphs[i]
        glyph.sdfPixelStart = glyph.atlasY * atlas.atlasWidth + glyph.atlasX
        if glyph.sdfPixelStart < 0 || glyph.sdfPixelStart >= atlas.sdfPixels.len:
            return false
        atlas.glyphs[i] = glyph
    return true

@borrows
fn WebSceneGlyphAtlasAppendTextRun(sceneOp: WebScenePaintOp,
                                   atlas: var WebSceneGlyphAtlas): bool =
    var fontSize = sceneOp.fontSize
    if fontSize <= 0:
        fontSize = 16
    var fontWeight = sceneOp.fontWeight
    if fontWeight <= 0:
        fontWeight = 400
    var fontFamily = sceneOp.fontFamily
    if fontFamily < 0:
        fontFamily = layout.WebLayoutFontFamilySans
    if WebSceneGlyphAtlasFindRunForPaintIndex(atlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal) >= 0:
        WebSceneGlyphAtlasDebugFail(23, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
        return false
    var run: WebSceneGlyphRun
    run.routeIndex = sceneOp.routeIndex
    run.nodeId = sceneOp.nodeId
    run.ordinal = sceneOp.ordinal
    run.glyphRunId = atlas.runs.len + 1
    run.fontAtlasId = 0
    run.sdfAtlasId = 0
    run.glyphStart = atlas.runGlyphs.len
    run.glyphCount = 0
    run.advanceWidth = 0
    var cursor: int32
    while cursor < sceneOp.textContent.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(sceneOp.textContent, cursor, sceneOp.textContent.len, codepoint, nextIndex):
            WebSceneGlyphAtlasDebugFail(24, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
            return false
        if nextIndex <= cursor:
            WebSceneGlyphAtlasDebugFail(25, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, codepoint)
            return false
        if codepoint == 10:
            WebSceneGlyphAtlasDebugFail(26, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, codepoint)
            return false
        if WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint):
            cursor = nextIndex
            continue
        let glyphCodepoint = WebSceneGlyphAtlasNormalizeTextCodepoint(codepoint)
        let fontIndex = WebSceneGlyphAtlasFindFontIndexForCodepointWeighted(atlas, glyphCodepoint, fontSize, fontWeight, fontFamily)
        if fontIndex < 0:
            # No packed face covers this codepoint (真缺字). Render a .notdef box
            # and keep going — a single missing glyph must not abort the whole
            # atlas build and freeze the route. When the run has already pinned a
            # (possibly non-default) face, synthesize the box on that same face so
            # the run stays single-atlas (box sdfAtlasId == run.sdfAtlasId) instead
            # of orphaning a cross-atlas box on the default face; an unpinned run
            # (run.fontAtlasId == 0) falls back to the default face. A genuinely
            # broken atlas (no face at all) still hard-fails (let it crash).
            var ndFontIndex = WebSceneGlyphAtlasFindFontIndex(atlas, run.fontAtlasId)
            if ndFontIndex < 0:
                ndFontIndex = WebSceneGlyphAtlasDefaultFontIndex(atlas)
            if ndFontIndex < 0:
                WebSceneGlyphAtlasDebugFail(27, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
                return false
            if !WebSceneGlyphAtlasAppendNotdefRunGlyph(atlas, run, ndFontIndex, glyphCodepoint, fontSize):
                WebSceneGlyphAtlasDebugFail(27, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
                return false
            cursor = nextIndex
            continue
        let fontAtlasId = atlas.fonts[fontIndex].fontAtlasId
        let sdfAtlasId = atlas.fonts[fontIndex].sdfAtlasId
        if fontAtlasId <= 0 || sdfAtlasId <= 0:
            WebSceneGlyphAtlasDebugFail(21, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
            return false
        if !atlas.fonts[fontIndex].face.loaded || atlas.fonts[fontIndex].face.unitsPerEm <= 0:
            WebSceneGlyphAtlasDebugFail(22, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
            return false
        let fontGlyphIndex = font.WebFontGlyphIndexForCodepoint(atlas.fonts[fontIndex].face, glyphCodepoint)
        if fontGlyphIndex <= 0:
            # The weighted font matched by family/weight but its cmap has no glyph
            # for this codepoint. Substitute a .notdef box on that same face so the
            # run stays single-atlas, then continue instead of aborting the build.
            if !WebSceneGlyphAtlasAppendNotdefRunGlyph(atlas, run, fontIndex, glyphCodepoint, fontSize):
                WebSceneGlyphAtlasDebugFail(27, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
                return false
            cursor = nextIndex
            continue
        let advance = font.WebFontScaledAdvance(atlas.fonts[fontIndex].face, fontGlyphIndex, fontSize)
        if advance <= 0:
            WebSceneGlyphAtlasDebugFail(28, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
            return false
        var glyphIndex = WebSceneGlyphAtlasFindGlyphIndex(atlas, fontAtlasId, glyphCodepoint, fontSize)
        if glyphIndex < 0:
            let glyphId = atlas.glyphs.len + 1
            if glyphId <= 0:
                WebSceneGlyphAtlasDebugFail(29, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
                return false
            if !WebSceneGlyphAtlasAppendGlyph(fontIndex, fontAtlasId, glyphId, fontGlyphIndex, glyphCodepoint, fontSize, advance, atlas):
                WebSceneGlyphAtlasDebugFail(30, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
                return false
            glyphIndex = atlas.glyphs.len - 1
        var runGlyph: WebSceneGlyphRunGlyph
        runGlyph.glyphId = atlas.glyphs[glyphIndex].glyphId
        runGlyph.advance = advance
        if run.glyphCount == 0:
            run.fontAtlasId = fontAtlasId
            run.sdfAtlasId = sdfAtlasId
        add(atlas.runGlyphs, runGlyph)
        run.glyphCount = run.glyphCount + 1
        run.advanceWidth = run.advanceWidth + advance
        cursor = nextIndex
    if run.glyphCount <= 0 || run.fontAtlasId <= 0 || run.sdfAtlasId <= 0:
        WebSceneGlyphAtlasDebugFail(20, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
        return false
    add(atlas.runs, run)
    return true

fn WebSceneGlyphAtlasEnsureGlyphForCodepoint(atlas: var WebSceneGlyphAtlas,
                                             codepoint: int32,
                                             fontSize: int32): bool =
    return WebSceneGlyphAtlasEnsureGlyphForCodepointWeighted(atlas, codepoint, fontSize, 400, layout.WebLayoutFontFamilySans)

fn WebSceneGlyphAtlasEnsureGlyphForCodepointWeighted(atlas: var WebSceneGlyphAtlas,
                                                     codepoint: int32,
                                                     fontSize: int32,
                                                     fontWeight: int32,
                                                     fontFamily: int32): bool =
    if WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint):
        return true
    var glyphCodepoint = WebSceneGlyphAtlasNormalizeTextCodepoint(codepoint)
    if glyphCodepoint <= 0 || glyphCodepoint == 10:
        WebSceneGlyphAtlasDebugFail(772, -1, -1, -1, glyphCodepoint)
        return false
    var resolvedFontSize = fontSize
    if resolvedFontSize <= 0:
        resolvedFontSize = 16
    var resolvedFontWeight = fontWeight
    if resolvedFontWeight <= 0:
        resolvedFontWeight = 400
    var resolvedFontFamily = fontFamily
    if resolvedFontFamily < 0:
        resolvedFontFamily = layout.WebLayoutFontFamilySans
    if WebSceneGlyphAtlasFindGlyphIndexForRequest(atlas, glyphCodepoint, resolvedFontSize, resolvedFontWeight, resolvedFontFamily, 0) >= 0:
        return true
    let fontIndex = WebSceneGlyphAtlasFindFontIndexForCodepointWeighted(atlas, glyphCodepoint, resolvedFontSize, resolvedFontWeight, resolvedFontFamily)
    if fontIndex < 0:
        # No packed face covers this codepoint. This shared ensure feeds both glyph
        # inventory and on-demand run building, so substitute a .notdef box on a
        # loaded face instead of returning false and wedging the route refresh.
        var ndFontIndex = WebSceneGlyphAtlasDefaultFontIndex(atlas)
        if ndFontIndex < 0 && atlas.fonts.len > 0:
            ndFontIndex = 0
        if ndFontIndex < 0:
            WebSceneGlyphAtlasDebugFail(773, -1, -1, -1, glyphCodepoint)
            return false
        if WebSceneGlyphAtlasEnsureNotdefGlyph(atlas, ndFontIndex, glyphCodepoint, resolvedFontSize) < 0:
            WebSceneGlyphAtlasDebugFail(773, -1, -1, -1, glyphCodepoint)
            return false
        WebSceneGlyphAtlasDebugNotdef(glyphCodepoint)
        return true
    let fontAtlasId = atlas.fonts[fontIndex].fontAtlasId
    if fontAtlasId <= 0:
        WebSceneGlyphAtlasDebugFail(774, -1, -1, -1, glyphCodepoint)
        return false
    if !atlas.fonts[fontIndex].face.loaded || atlas.fonts[fontIndex].face.unitsPerEm <= 0:
        WebSceneGlyphAtlasDebugFail(775, -1, -1, -1, glyphCodepoint)
        return false
    let fontGlyphIndex = font.WebFontGlyphIndexForCodepoint(atlas.fonts[fontIndex].face, glyphCodepoint)
    if fontGlyphIndex <= 0:
        WebSceneGlyphAtlasDebugFail(776, -1, -1, -1, glyphCodepoint)
        return false
    let advance = font.WebFontScaledAdvance(atlas.fonts[fontIndex].face, fontGlyphIndex, resolvedFontSize)
    if advance <= 0:
        WebSceneGlyphAtlasDebugFail(777, -1, -1, -1, glyphCodepoint)
        return false
    let glyphId = atlas.glyphs.len + 1
    if glyphId <= 0:
        WebSceneGlyphAtlasDebugFail(778, -1, -1, -1, glyphCodepoint)
        return false
    if !WebSceneGlyphAtlasAppendGlyph(fontIndex, fontAtlasId, glyphId, fontGlyphIndex, glyphCodepoint, resolvedFontSize, advance, atlas):
        WebSceneGlyphAtlasDebugFail(779, -1, -1, -1, glyphCodepoint)
        return false
    return true

@borrows
fn WebSceneGlyphAtlasAppendGlyphInventoryText(atlas: var WebSceneGlyphAtlas,
                                              fontSize: int32,
                                              text: str): bool =
    return WebSceneGlyphAtlasAppendGlyphInventoryTextWeighted(atlas, fontSize, 400, layout.WebLayoutFontFamilySans, text)

@borrows
fn WebSceneGlyphAtlasAppendGlyphInventoryTextWeighted(atlas: var WebSceneGlyphAtlas,
                                                      fontSize: int32,
                                                      fontWeight: int32,
                                                      fontFamily: int32,
                                                      text: str): bool =
    var cursor: int32
    while cursor < text.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(text, cursor, text.len, codepoint, nextIndex):
            WebSceneGlyphAtlasDebugFail(790, -1, -1, -1, 0)
            return false
        if nextIndex <= cursor || codepoint == 10:
            WebSceneGlyphAtlasDebugFail(791, -1, -1, -1, codepoint)
            return false
        if !WebSceneGlyphAtlasEnsureGlyphForCodepointWeighted(atlas, codepoint, fontSize, fontWeight, fontFamily):
            return false
        cursor = nextIndex
    return true

fn WebSceneGlyphAtlasAppendGlyphInventoryCodepoints(atlas: var WebSceneGlyphAtlas,
                                                    fontSize: int32,
                                                    codepoints: var int32[]): bool =
    return WebSceneGlyphAtlasAppendGlyphInventoryCodepointsWeighted(atlas, fontSize, 400, layout.WebLayoutFontFamilySans, codepoints)

fn WebSceneGlyphAtlasAppendGlyphInventoryCodepointsWeighted(atlas: var WebSceneGlyphAtlas,
                                                           fontSize: int32,
                                                           fontWeight: int32,
                                                           fontFamily: int32,
                                                           codepoints: var int32[]): bool =
    for i in 0..<codepoints.len:
        if !WebSceneGlyphAtlasEnsureGlyphForCodepointWeighted(atlas, codepoints[i], fontSize, fontWeight, fontFamily):
            return false
    return true

fn WebSceneNodeIsTextControlTag(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    let nodeIndex = WebSceneFindNodeArrayIndex(graph, routeIndex, nodeId)
    if nodeIndex < 0:
        return false
    if graph.nodes[nodeIndex].tagName == "input":
        return true
    if graph.nodes[nodeIndex].tagName == "textarea":
        return true
    return false

@borrows
fn WebSceneGlyphAtlasAppendTextInputGlyphInventory(graph: var WebSceneGraph,
                                                   atlas: var WebSceneGlyphAtlas,
                                                   inventoryText: str): bool =
    if inventoryText.len <= 0:
        WebSceneGlyphAtlasDebugFail(792, -1, -1, -1, 0)
        return false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if !WebScenePaintKindIsText(sceneOp.opKind):
            continue
        if !WebSceneNodeIsTextControlTag(graph, sceneOp.routeIndex, sceneOp.nodeId):
            continue
        var fontSize = sceneOp.fontSize
        if fontSize <= 0:
            fontSize = 16
        if !WebSceneGlyphAtlasAppendGlyphInventoryTextWeighted(atlas, fontSize, sceneOp.fontWeight, sceneOp.fontFamily, inventoryText):
            return false
    return true

@borrows
fn WebSceneGlyphAtlasAppendStateTextGlyphInventory(graph: var WebSceneGraph,
                                                   atlas: var WebSceneGlyphAtlas,
                                                   inventoryText: str): bool =
    if inventoryText.len <= 0:
        WebSceneGlyphAtlasDebugFail(793, -1, -1, -1, 0)
        return false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if !WebScenePaintKindIsText(sceneOp.opKind):
            continue
        let nodeIndex = WebSceneFindNodeIndex(graph, sceneOp.routeIndex, sceneOp.nodeId)
        if nodeIndex < 0:
            WebSceneGlyphAtlasDebugFail(794, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
            return false
        let stateBoundText = graph.nodes[nodeIndex].textStateRef.len > 0
        let stateConditionalText = WebSceneNodeHasStateConditionAncestor(graph, sceneOp.routeIndex, sceneOp.nodeId)
        if !stateBoundText && !stateConditionalText:
            continue
        var fontSize = sceneOp.fontSize
        if fontSize <= 0:
            fontSize = 16
        if stateBoundText:
            if !WebSceneGlyphAtlasAppendGlyphInventoryTextWeighted(atlas, fontSize, sceneOp.fontWeight, sceneOp.fontFamily, inventoryText):
                return false
        if stateConditionalText && sceneOp.textContent.len > 0:
            if !WebSceneGlyphAtlasAppendGlyphInventoryTextWeighted(atlas, fontSize, sceneOp.fontWeight, sceneOp.fontFamily, sceneOp.textContent):
                return false
    return true

fn WebSceneGlyphAtlasAppendStateTextGlyphInventoryCodepoints(graph: var WebSceneGraph,
                                                             atlas: var WebSceneGlyphAtlas,
                                                             codepoints: var int32[]): bool =
    if codepoints.len <= 0:
        WebSceneGlyphAtlasDebugFail(795, -1, -1, -1, 0)
        return false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if !WebScenePaintKindIsText(sceneOp.opKind):
            continue
        let nodeIndex = WebSceneFindNodeIndex(graph, sceneOp.routeIndex, sceneOp.nodeId)
        if nodeIndex < 0:
            WebSceneGlyphAtlasDebugFail(796, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
            return false
        let stateBoundText = graph.nodes[nodeIndex].textStateRef.len > 0
        let stateConditionalText = WebSceneNodeHasStateConditionAncestor(graph, sceneOp.routeIndex, sceneOp.nodeId)
        if !stateBoundText && !stateConditionalText:
            continue
        var fontSize = sceneOp.fontSize
        if fontSize <= 0:
            fontSize = 16
        if stateBoundText:
            if !WebSceneGlyphAtlasAppendGlyphInventoryCodepointsWeighted(atlas, fontSize, sceneOp.fontWeight, sceneOp.fontFamily, codepoints):
                return false
        if stateConditionalText && sceneOp.textContent.len > 0:
            if !WebSceneGlyphAtlasAppendGlyphInventoryTextWeighted(atlas, fontSize, sceneOp.fontWeight, sceneOp.fontFamily, sceneOp.textContent):
                return false
    return true

fn WebSceneGlyphAtlasNormalizeTextCodepoint(codepoint: int32): int32 =
    if codepoint == 9 || codepoint == 13:
        return 32
    return codepoint

fn WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint: int32): bool =
    if codepoint >= 0xFE00 && codepoint <= 0xFE0F:
        return true
    if codepoint >= 0xE0100 && codepoint <= 0xE01EF:
        return true
    return false

@borrows
fn WebSceneGlyphAtlasTextCodepointCount(text: str): int32 =
    var cursor: int32
    var count: int32
    while cursor < text.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(text, cursor, text.len, codepoint, nextIndex):
            return -1
        if nextIndex <= cursor || codepoint == 10:
            return -1
        if WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint):
            cursor = nextIndex
            continue
        count = count + 1
        cursor = nextIndex
    return count

@borrows
fn WebSceneGlyphAtlasInferFontSizeFromGlyph(glyph: WebSceneGlyphAtlasGlyphEntry): int32 =
    let denom = 2 * WebSceneGlyphSdfScale
    if denom <= 0 || glyph.width <= 0 || glyph.width != glyph.height:
        return 0
    if glyph.width % denom != 0:
        return 0
    return glyph.width / denom

fn WebSceneGlyphAtlasSdfFontSizeForFontSize(fontSize: int32): int32 =
    if fontSize <= 0:
        return WebSceneGlyphSdfCanonicalFontSize
    if WebSceneGlyphSdfCanonicalFontSize <= 0:
        return fontSize
    return WebSceneGlyphSdfCanonicalFontSize

fn WebSceneGlyphAtlasHydratePrecomputedGlyphRunMetadata(graph: var WebSceneGraph,
                                                        atlas: var WebSceneGlyphAtlas,
                                                        runIndex: int32,
                                                        requireExact: bool): int32 =
    if runIndex < 0 || runIndex >= atlas.runs.len:
        WebSceneGlyphAtlasDebugFail(760, -1, -1, -1, runIndex)
        return -1
    let run = atlas.runs[runIndex]
    let paintIndex = WebSceneFindPaintOpIndex(graph, run.routeIndex, run.nodeId, run.ordinal)
    if paintIndex < 0:
        WebSceneGlyphAtlasDebugFail(761, run.routeIndex, run.nodeId, run.ordinal, runIndex)
        return -1
    let sceneOp = graph.paintOps[paintIndex]
    if !WebScenePaintKindIsText(sceneOp.opKind):
        WebSceneGlyphAtlasDebugFail(762, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.opKind)
        return -1
    let codepointCount = WebSceneGlyphAtlasTextCodepointCount(sceneOp.textContent)
    if codepointCount < 0 || codepointCount != run.glyphCount:
        if requireExact:
            WebSceneGlyphAtlasDebugFail(763, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, codepointCount)
            return -1
        return 0
    var cursor: int32
    var glyphOffset: int32
    while cursor < sceneOp.textContent.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(sceneOp.textContent, cursor, sceneOp.textContent.len, codepoint, nextIndex):
            if !requireExact:
                return 0
            WebSceneGlyphAtlasDebugFail(764, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
            return -1
        if nextIndex <= cursor || codepoint == 10:
            if !requireExact:
                return 0
            WebSceneGlyphAtlasDebugFail(765, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, codepoint)
            return -1
        if WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint):
            cursor = nextIndex
            continue
        let runGlyphIndex = run.glyphStart + glyphOffset
        if runGlyphIndex < 0 || runGlyphIndex >= atlas.runGlyphs.len:
            WebSceneGlyphAtlasDebugFail(766, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, runGlyphIndex)
            return -1
        let runGlyph = atlas.runGlyphs[runGlyphIndex]
        let glyphIndex = WebSceneGlyphAtlasFindGlyphIdIndex(atlas, runGlyph.glyphId)
        if glyphIndex < 0:
            WebSceneGlyphAtlasDebugFail(767, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, runGlyph.glyphId)
            return -1
        var glyph = atlas.glyphs[glyphIndex]
        if glyph.advance != runGlyph.advance:
            if !requireExact:
                return 0
            WebSceneGlyphAtlasDebugFail(768, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, runGlyph.glyphId)
            return -1
        if glyphOffset == 0 &&
           (glyph.fontAtlasId != run.fontAtlasId || glyph.sdfAtlasId != run.sdfAtlasId):
            if !requireExact:
                return 0
            WebSceneGlyphAtlasDebugFail(768, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, runGlyph.glyphId)
            return -1
        if glyph.fontSize <= 0:
            if !requireExact:
                return 0
            WebSceneGlyphAtlasDebugFail(769, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyph.fontSize)
            return -1
        let glyphCodepoint = WebSceneGlyphAtlasNormalizeTextCodepoint(codepoint)
        if glyph.codepoint != 0 && glyph.codepoint != glyphCodepoint:
            if !requireExact:
                return 0
            WebSceneGlyphAtlasDebugFail(770, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
            return -1
        glyph.codepoint = glyphCodepoint
        atlas.glyphs[glyphIndex] = glyph
        glyphOffset = glyphOffset + 1
        cursor = nextIndex
    return 1

fn WebSceneGlyphAtlasHydratePrecomputedGlyphMetadata(graph: var WebSceneGraph,
                                                     atlas: var WebSceneGlyphAtlas): bool =
    for runIndex in 0..<atlas.runs.len:
        let status = WebSceneGlyphAtlasHydratePrecomputedGlyphRunMetadata(graph, atlas, runIndex, false)
        if status < 0:
            return false
    return true

fn WebSceneGlyphAtlasHydratePrecomputedGlyphMetadataForRoute(graph: var WebSceneGraph,
                                                             atlas: var WebSceneGlyphAtlas,
                                                             routeIndex: int32): bool =
    var touched = false
    for runIndex in 0..<atlas.runs.len:
        if atlas.runs[runIndex].routeIndex == routeIndex:
            let status = WebSceneGlyphAtlasHydratePrecomputedGlyphRunMetadata(graph, atlas, runIndex, false)
            if status < 0:
                return false
            if status > 0:
                touched = true
    return true

fn WebSceneGlyphAtlasHydratePrecomputedGlyphMetadataForNode(graph: var WebSceneGraph,
                                                            atlas: var WebSceneGlyphAtlas,
                                                            routeIndex: int32,
                                                            nodeId: int32): bool =
    for runIndex in 0..<atlas.runs.len:
        if atlas.runs[runIndex].routeIndex == routeIndex && atlas.runs[runIndex].nodeId == nodeId:
            let status = WebSceneGlyphAtlasHydratePrecomputedGlyphRunMetadata(graph, atlas, runIndex, true)
            if status < 0:
                return false
    return true

# Drop one run and reclaim its runGlyph slice, keeping the flat runGlyphs array
# contiguous by shifting the glyphStart of every run that sat past the removed
# block. Used by the state-text rebind path to replace a stale run in place
# instead of leaking a duplicate run per rebind (unbounded runs/runGlyphs growth
# that re-uploaded the whole glyph metadata batch every frame).
fn WebSceneGlyphAtlasRemoveRunAt(atlas: var WebSceneGlyphAtlas, removeIndex: int32): bool =
    if removeIndex < 0 || removeIndex >= atlas.runs.len:
        return false
    let removed = atlas.runs[removeIndex]
    let gStart = removed.glyphStart
    let gCount = removed.glyphCount
    if gStart < 0 || gCount < 0 || gStart + gCount > atlas.runGlyphs.len:
        return false
    var nextRunGlyphs: WebSceneGlyphRunGlyph[]
    for i in 0..<atlas.runGlyphs.len:
        if i >= gStart && i < gStart + gCount:
            continue
        add(nextRunGlyphs, atlas.runGlyphs[i])
    atlas.runGlyphs = nextRunGlyphs
    var nextRuns: WebSceneGlyphRun[]
    for i in 0..<atlas.runs.len:
        if i == removeIndex:
            continue
        var r: WebSceneGlyphRun
        if !WebSceneGlyphRunCloneFromSeq(atlas.runs, i, r):
            return false
        if r.glyphStart > gStart:
            r.glyphStart = r.glyphStart - gCount
        add(nextRuns, r)
    atlas.runs = nextRuns
    return true

@borrows
fn WebSceneGlyphAtlasAppendExistingGlyphTextRun(sceneOp: WebScenePaintOp,
                                                atlas: var WebSceneGlyphAtlas): bool =
    if !WebScenePaintKindIsText(sceneOp.opKind):
        WebSceneGlyphAtlasDebugFail(780, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.opKind)
        return false
    # empty text legitimately has no run (dynamic rebind/cleared search render
    # nothing) — failing here turned blank card titles into a permanent
    # present-retry loop (fail 787, heat loop two)
    if sceneOp.textContent.len == 0:
        return true
    let baseRunIndex = WebSceneGlyphAtlasFindRunForPaintIndex(atlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
    var baseFontAtlasId: int32
    var baseSdfAtlasId: int32
    if baseRunIndex >= 0:
        let baseRun = atlas.runs[baseRunIndex]
        baseFontAtlasId = baseRun.fontAtlasId
        baseSdfAtlasId = baseRun.sdfAtlasId
        if baseFontAtlasId <= 0 || baseSdfAtlasId <= 0:
            WebSceneGlyphAtlasDebugFail(782, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, baseFontAtlasId)
            return false
    var fontSize = sceneOp.fontSize
    if fontSize <= 0:
        fontSize = 16
    var fontWeight = sceneOp.fontWeight
    if fontWeight <= 0:
        fontWeight = 400
    var fontFamily = sceneOp.fontFamily
    if fontFamily < 0:
        fontFamily = layout.WebLayoutFontFamilySans
    var run: WebSceneGlyphRun
    run.routeIndex = sceneOp.routeIndex
    run.nodeId = sceneOp.nodeId
    run.ordinal = sceneOp.ordinal
    run.glyphRunId = atlas.runs.len + 1
    run.fontAtlasId = 0
    run.sdfAtlasId = 0
    run.glyphStart = atlas.runGlyphs.len
    run.glyphCount = 0
    run.advanceWidth = 0
    var cursor: int32
    # Local memo for the run.fontAtlasId/fontSize fast-path lookups below
    # (built lazily by WebSceneGlyphAtlasFindGlyphIndexCached on first use,
    # once run.fontAtlasId is pinned) — see WebSceneGlyphAtlasSyncRunLookupCache.
    var glyphLookupCacheSlots: int32[]
    var glyphLookupCacheBuiltUpTo: int32
    while cursor < sceneOp.textContent.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(sceneOp.textContent, cursor, sceneOp.textContent.len, codepoint, nextIndex):
            WebSceneGlyphAtlasDebugFail(783, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
            return false
        if nextIndex <= cursor || codepoint == 10:
            WebSceneGlyphAtlasDebugFail(784, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, codepoint)
            return false
        if WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint):
            cursor = nextIndex
            continue
        let glyphCodepoint = WebSceneGlyphAtlasNormalizeTextCodepoint(codepoint)
        var glyphIndex: int32
        if run.glyphCount == 0:
            if baseFontAtlasId > 0:
                glyphIndex = WebSceneGlyphAtlasFindGlyphIndex(atlas, baseFontAtlasId, glyphCodepoint, fontSize)
            else:
                glyphIndex = -1
            if glyphIndex < 0 && baseSdfAtlasId > 0:
                glyphIndex = WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, glyphCodepoint, fontSize, baseSdfAtlasId)
            if glyphIndex < 0:
                glyphIndex = WebSceneGlyphAtlasFindGlyphIndexForRequest(atlas, glyphCodepoint, fontSize, fontWeight, fontFamily, 0)
        else:
            glyphIndex = WebSceneGlyphAtlasFindGlyphIndexCached(atlas, run.fontAtlasId, glyphCodepoint, fontSize, glyphLookupCacheSlots, glyphLookupCacheBuiltUpTo)
            if glyphIndex < 0:
                glyphIndex = WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, glyphCodepoint, fontSize, run.sdfAtlasId)
            if glyphIndex < 0:
                glyphIndex = WebSceneGlyphAtlasFindGlyphIndexForRequest(atlas, glyphCodepoint, fontSize, fontWeight, fontFamily, 0)
        if glyphIndex < 0:
            # Dynamic (runtime state / typed) text can carry codepoints that were
            # never pre-baked into the precomputed atlas (e.g. a geocoded address).
            # When a real font face actually covers the codepoint (device hydrates
            # faces after loading the precomputed atlas), rasterize the real glyph on
            # demand and re-resolve; mid-run resolves stay pinned to the run's own
            # font so the whole run keeps one sdf atlas. Codepoints that no face
            # covers skip this on-demand raster and fall to the .notdef box below,
            # which substitutes exactly once on the run's own face — routing them
            # through the shared ensure here would instead mint an orphan .notdef box
            # on the default face and double-count the substitution.
            if WebSceneGlyphAtlasFindFontIndexForCodepointWeighted(atlas, glyphCodepoint, fontSize, fontWeight, fontFamily) >= 0:
                if WebSceneGlyphAtlasEnsureGlyphForCodepointWeighted(atlas, glyphCodepoint, fontSize, fontWeight, fontFamily):
                    if run.glyphCount == 0:
                        glyphIndex = WebSceneGlyphAtlasFindGlyphIndexForRequest(atlas, glyphCodepoint, fontSize, fontWeight, fontFamily, 0)
                    else:
                        glyphIndex = WebSceneGlyphAtlasFindGlyphIndexCached(atlas, run.fontAtlasId, glyphCodepoint, fontSize, glyphLookupCacheSlots, glyphLookupCacheBuiltUpTo)
        if glyphIndex < 0:
            # Runtime dynamic text (state binding / geocoded address) can carry a
            # codepoint no packed face covers. Bind a .notdef box to the run's own
            # face (or the default face before the run is pinned) so the whole run
            # keeps one sdf atlas, then continue. Only a broken atlas (no usable
            # face at all) still hard-fails below (let it crash).
            var ndFontIndex = WebSceneGlyphAtlasFindFontIndex(atlas, run.fontAtlasId)
            if ndFontIndex < 0:
                ndFontIndex = WebSceneGlyphAtlasDefaultFontIndex(atlas)
            if ndFontIndex >= 0:
                let ndIdx = WebSceneGlyphAtlasEnsureNotdefGlyph(atlas, ndFontIndex, glyphCodepoint, fontSize)
                if ndIdx >= 0:
                    WebSceneGlyphAtlasDebugNotdef(glyphCodepoint)
                    glyphIndex = ndIdx
        if glyphIndex < 0:
            WebSceneGlyphAtlasDebugFail(785, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
            return false
        let glyph = atlas.glyphs[glyphIndex]
        if glyph.advance <= 0:
            WebSceneGlyphAtlasDebugFail(786, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCodepoint)
            return false
        if run.glyphCount == 0:
            run.fontAtlasId = glyph.fontAtlasId
            run.sdfAtlasId = glyph.sdfAtlasId
        var runGlyph: WebSceneGlyphRunGlyph
        runGlyph.glyphId = glyph.glyphId
        runGlyph.advance = glyph.advance
        add(atlas.runGlyphs, runGlyph)
        run.glyphCount = run.glyphCount + 1
        run.advanceWidth = run.advanceWidth + glyph.advance
        cursor = nextIndex
    if run.glyphCount <= 0 || run.advanceWidth <= 0 || run.fontAtlasId <= 0 || run.sdfAtlasId <= 0:
        WebSceneGlyphAtlasDebugFail(787, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, 0)
        return false
    add(atlas.runs, run)
    return true

fn WebSceneRefreshStateTextGlyphRunsForRoute(graph: var WebSceneGraph,
                                             atlas: var WebSceneGlyphAtlas,
                                             routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if sceneOp.routeIndex != routeIndex:
            continue
        if sceneOp.opKind != WebScenePaintText:
            continue
        if sceneOp.textContent.len <= 0:
            continue
        if WebSceneNodeHiddenByNonRenderedContent(graph, sceneOp.routeIndex, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, sceneOp.routeIndex, sceneOp.nodeId):
            continue
        if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
            continue
        let nodeIndex = WebSceneFindNodeIndex(graph, sceneOp.routeIndex, sceneOp.nodeId)
        if nodeIndex < 0:
            return false
        let existingRunIndex = WebSceneGlyphAtlasFindRunForPaintIndex(atlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if existingRunIndex >= 0:
            let hydrateStatus = WebSceneGlyphAtlasHydratePrecomputedGlyphRunMetadata(graph, atlas, existingRunIndex, false)
            if hydrateStatus < 0:
                return false
            if hydrateStatus > 0:
                continue
            # The bound text changed (glyph count differs from the run), so the
            # existing run is stale. Rebuild it in place: append the fresh run
            # first (the still-present stale run pins the base font/sdf atlas so
            # the run keeps one atlas), inherit the stale run's glyphRunId so the
            # host keeps its GPU-side run binding across rebinds, then drop the
            # stale run. This keeps exactly one run per (route,node,ordinal)
            # instead of leaking a duplicate every rebind — which had grown the
            # runs/runGlyphs batch unbounded and re-uploaded it whole each frame.
            let preservedRunId = atlas.runs[existingRunIndex].glyphRunId
            if !WebSceneGlyphAtlasAppendExistingGlyphTextRun(sceneOp, atlas):
                return false
            atlas.runs[atlas.runs.len - 1].glyphRunId = preservedRunId
            if !WebSceneGlyphAtlasRemoveRunAt(atlas, existingRunIndex):
                return false
            continue
        if !WebSceneGlyphAtlasAppendExistingGlyphTextRun(sceneOp, atlas):
            return false
    return true

fn WebSceneRefreshTextInputGlyphRun(graph: var WebSceneGraph,
                                    atlas: var WebSceneGlyphAtlas,
                                    routeIndex: int32,
                                    nodeId: int32): bool =
    var touched = false
    for i in 0..<graph.paintOps.len:
        let sceneOp = graph.paintOps[i]
        if sceneOp.routeIndex == routeIndex &&
           sceneOp.nodeId == nodeId &&
           WebScenePaintKindIsText(sceneOp.opKind):
            if !WebSceneGlyphAtlasAppendExistingGlyphTextRun(sceneOp, atlas):
                return false
            touched = true
    return touched

fn WebSceneGlyphAtlasFindFontIndexForCodepoint(atlas: var WebSceneGlyphAtlas,
                                               codepoint: int32,
                                               fontSize: int32): int32 =
    return WebSceneGlyphAtlasFindFontIndexForCodepointWeighted(atlas, codepoint, fontSize, 400, layout.WebLayoutFontFamilySans)

fn WebSceneGlyphAtlasResolveRequestedFontWeight(fontWeight: int32): int32 =
    if fontWeight <= 0:
        return 400
    if fontWeight > 1000:
        return 1000
    return fontWeight

fn WebSceneGlyphAtlasResolveRequestedFontFamily(fontFamily: int32): int32 =
    if fontFamily == layout.WebLayoutFontFamilyMono:
        return layout.WebLayoutFontFamilyMono
    return layout.WebLayoutFontFamilySans

fn WebSceneGlyphAtlasAbsDelta(left: int32, right: int32): int32 =
    if left >= right:
        return left - right
    return right - left

fn WebSceneGlyphAtlasFontRequestShouldReplace(atlas: var WebSceneGlyphAtlas,
                                              bestFontIndex: int32,
                                              candidateFontIndex: int32,
                                              fontWeight: int32,
                                              fontFamily: int32): bool =
    if candidateFontIndex < 0 || candidateFontIndex >= atlas.fonts.len:
        return bestFontIndex < 0
    if bestFontIndex < 0 || bestFontIndex >= atlas.fonts.len:
        return true
    let requestedWeight = WebSceneGlyphAtlasResolveRequestedFontWeight(fontWeight)
    let requestedFamily = WebSceneGlyphAtlasResolveRequestedFontFamily(fontFamily)
    let bestFamily = WebSceneGlyphAtlasResolveRequestedFontFamily(atlas.fonts[bestFontIndex].fontFamily)
    let candidateFamily = WebSceneGlyphAtlasResolveRequestedFontFamily(atlas.fonts[candidateFontIndex].fontFamily)
    let bestFamilyMismatch = bestFamily != requestedFamily
    let candidateFamilyMismatch = candidateFamily != requestedFamily
    if candidateFamilyMismatch != bestFamilyMismatch:
        return !candidateFamilyMismatch
    let bestWeight = WebSceneGlyphAtlasResolveRequestedFontWeight(atlas.fonts[bestFontIndex].fontWeight)
    let candidateWeight = WebSceneGlyphAtlasResolveRequestedFontWeight(atlas.fonts[candidateFontIndex].fontWeight)
    let bestScore = WebSceneGlyphAtlasAbsDelta(bestWeight, requestedWeight)
    let candidateScore = WebSceneGlyphAtlasAbsDelta(candidateWeight, requestedWeight)
    if candidateScore < bestScore:
        return true
    if candidateScore > bestScore:
        return false
    if requestedWeight >= 600:
        return candidateWeight > bestWeight
    return candidateWeight < bestWeight

fn WebSceneGlyphAtlasFontRequestScore(atlas: var WebSceneGlyphAtlas,
                                      fontIndex: int32,
                                      fontWeight: int32,
                                      fontFamily: int32): int32 =
    if fontIndex < 0 || fontIndex >= atlas.fonts.len:
        return 2000000000
    let requestedWeight = WebSceneGlyphAtlasResolveRequestedFontWeight(fontWeight)
    let requestedFamily = WebSceneGlyphAtlasResolveRequestedFontFamily(fontFamily)
    let entryWeight = WebSceneGlyphAtlasResolveRequestedFontWeight(atlas.fonts[fontIndex].fontWeight)
    let entryFamily = WebSceneGlyphAtlasResolveRequestedFontFamily(atlas.fonts[fontIndex].fontFamily)
    var score = WebSceneGlyphAtlasAbsDelta(entryWeight, requestedWeight)
    if entryFamily != requestedFamily:
        score = score + 100000
    return score

fn WebSceneGlyphAtlasFindFontIndexForCodepointWeighted(atlas: var WebSceneGlyphAtlas,
                                                       codepoint: int32,
                                                       fontSize: int32,
                                                       fontWeight: int32,
                                                       fontFamily: int32): int32 =
    var glyphCodepoint = codepoint
    if codepoint == 9 || codepoint == 13:
        glyphCodepoint = 32
    var resolvedFontSize = fontSize
    if resolvedFontSize <= 0:
        resolvedFontSize = 16
    var bestFontIndex = -1
    for fontIndex in 0..<atlas.fonts.len:
        if !atlas.fonts[fontIndex].face.loaded || atlas.fonts[fontIndex].face.unitsPerEm <= 0:
            continue
        let fontGlyphIndex = font.WebFontGlyphIndexForCodepoint(atlas.fonts[fontIndex].face, glyphCodepoint)
        if fontGlyphIndex <= 0:
            continue
        if font.WebFontScaledAdvance(atlas.fonts[fontIndex].face, fontGlyphIndex, resolvedFontSize) <= 0:
            continue
        if WebSceneGlyphAtlasFontRequestShouldReplace(atlas, bestFontIndex, fontIndex, fontWeight, fontFamily):
            bestFontIndex = fontIndex
    return bestFontIndex

@borrows
fn WebSceneGlyphAtlasFindFontIndexForTextRun(atlas: var WebSceneGlyphAtlas,
                                             text: str): int32 =
    if text.len == 0:
        return WebSceneGlyphAtlasDefaultFontIndex(atlas)
    for fontIndex in 0..<atlas.fonts.len:
        if WebSceneGlyphAtlasFontCoversTextRun(atlas, fontIndex, text):
            return fontIndex
    return -1

@borrows
fn WebSceneGlyphAtlasFontCoversTextRun(atlas: var WebSceneGlyphAtlas,
                                       fontIndex: int32,
                                       text: str): bool =
    if fontIndex < 0 || fontIndex >= atlas.fonts.len:
        return false
    var face: font.WebFontFace
    if !layout.WebLayoutCopyFontFace(atlas.fonts[fontIndex].face, face):
        return false
    if !face.loaded || face.unitsPerEm <= 0:
        return false
    let fontSize = 16
    var cursor: int32
    while cursor < text.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(text, cursor, text.len, codepoint, nextIndex):
            return false
        if nextIndex <= cursor:
            return false
        if codepoint == 10:
            return false
        if WebSceneGlyphAtlasCodepointIsVariationSelector(codepoint):
            cursor = nextIndex
            continue
        let glyphCodepoint = WebSceneGlyphAtlasNormalizeTextCodepoint(codepoint)
        let fontGlyphIndex = font.WebFontGlyphIndexForCodepoint(face, glyphCodepoint)
        if fontGlyphIndex <= 0:
            return false
        if font.WebFontScaledAdvance(face, fontGlyphIndex, fontSize) <= 0:
            return false
        cursor = nextIndex
    return true

@borrows
fn WebSceneDecodeTextCodepoint(text: str,
                               startIndex: int32,
                               endIndex: int32,
                               outCodepoint: var int32,
                               outNextIndex: var int32): bool =
    outCodepoint = 0
    outNextIndex = startIndex
    if startIndex < 0 || startIndex >= text.len:
        return false
    var endAt: int32
    endAt = endIndex
    if endAt > text.len:
        endAt = text.len
    if startIndex >= endAt:
        return false
    let first = Int32(text[startIndex])
    if first > 255:
        outCodepoint = first
        outNextIndex = startIndex + 1
        return true
    let b0 = first & 255
    if b0 <= 127:
        outCodepoint = b0
        outNextIndex = startIndex + 1
        return true
    if b0 >= 192 && b0 < 224:
        if startIndex + 1 >= endAt:
            return false
        let b1 = Int32(text[startIndex + 1]) & 255
        if (b1 & 192) != 128:
            return false
        outCodepoint = ((b0 & 31) << 6) | (b1 & 63)
        outNextIndex = startIndex + 2
        return true
    if b0 >= 224 && b0 < 240:
        if startIndex + 2 >= endAt:
            return false
        let b1 = Int32(text[startIndex + 1]) & 255
        let b2 = Int32(text[startIndex + 2]) & 255
        if (b1 & 192) != 128 || (b2 & 192) != 128:
            return false
        outCodepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
        outNextIndex = startIndex + 3
        return true
    if b0 >= 240 && b0 < 248:
        if startIndex + 3 >= endAt:
            return false
        let b1 = Int32(text[startIndex + 1]) & 255
        let b2 = Int32(text[startIndex + 2]) & 255
        let b3 = Int32(text[startIndex + 3]) & 255
        if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128:
            return false
        outCodepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
        outNextIndex = startIndex + 4
        return true
    return false

fn WebSceneGlyphNotdefSetPoint(outline: var font.WebFontGlyphOutline,
                               pointIndex: int32,
                               x: int32, y: int32, endContour: bool) =
    var p: font.WebFontGlyphPoint
    p.x = x
    p.y = y
    p.onCurve = true
    p.endContour = endContour
    outline.points[pointIndex] = p

# Synthesize the .notdef tofu box directly in the face's design units: an outer
# rectangle plus an inset inner rectangle. The two contours render hollow under
# the existing even-odd SDF rasterizer (WebSceneGlyphSdfInsideMaskScanline), so a
# missing codepoint draws a visible empty box exactly like a browser. This is
# deliberately font-independent — the shipped face's own glyph 0 has an empty
# outline and advance 0, which would draw nothing and re-trigger a hard failure.
fn WebSceneGlyphAtlasBuildNotdefBoxOutline(face: var font.WebFontFace,
                                           outline: var font.WebFontGlyphOutline): bool =
    font.WebFontGlyphOutlineInit(outline)
    if !face.loaded || face.unitsPerEm <= 0:
        return false
    let em = face.unitsPerEm
    let x0 = em / 8
    let x1 = em * 5 / 8
    let y0 = 0
    let y1 = em * 5 / 8
    let inset = em / 16
    if x1 - x0 <= 2 * inset || y1 - y0 <= 2 * inset:
        return false
    outline.simple = true
    outline.contourCount = 2
    outline.pointCount = 8
    outline.xMin = x0
    outline.yMin = y0
    outline.xMax = x1
    outline.yMax = y1
    setLen(outline.points, 8)
    WebSceneGlyphNotdefSetPoint(outline, 0, x0, y0, false)
    WebSceneGlyphNotdefSetPoint(outline, 1, x1, y0, false)
    WebSceneGlyphNotdefSetPoint(outline, 2, x1, y1, false)
    WebSceneGlyphNotdefSetPoint(outline, 3, x0, y1, true)
    WebSceneGlyphNotdefSetPoint(outline, 4, x0 + inset, y0 + inset, false)
    WebSceneGlyphNotdefSetPoint(outline, 5, x1 - inset, y0 + inset, false)
    WebSceneGlyphNotdefSetPoint(outline, 6, x1 - inset, y1 - inset, false)
    WebSceneGlyphNotdefSetPoint(outline, 7, x0 + inset, y1 - inset, true)
    return true

fn WebSceneGlyphAtlasAppendGlyph(fontIndex: int32,
                                 fontAtlasId: int32,
                                 glyphId: int32,
                                 fontGlyphIndex: int32,
                                 codepoint: int32,
                                 fontSize: int32,
                                 advance: int32,
                                 atlas: var WebSceneGlyphAtlas): bool =
    if fontIndex < 0 || fontIndex >= atlas.fonts.len:
        return false
    if atlas.atlasWidth <= 0:
        return false
    let sdfFontSize = WebSceneGlyphAtlasSdfFontSizeForFontSize(fontSize)
    var cellSize = sdfFontSize * 2 * WebSceneGlyphSdfScale
    if cellSize <= 0:
        return false
    if cellSize > atlas.atlasWidth:
        return false
    if atlas.glyphPackX < 0 || atlas.glyphPackY < 0 || atlas.glyphPackRowHeight < 0:
        return false
    let cellIndex = atlas.glyphs.len
    var glyph: WebSceneGlyphAtlasGlyphEntry
    glyph.fontAtlasId = fontAtlasId
    glyph.glyphId = glyphId
    glyph.glyphIndex = fontGlyphIndex
    glyph.sdfAtlasId = atlas.fonts[fontIndex].sdfAtlasId
    glyph.sdfSpreadPx = atlas.fonts[fontIndex].sdfSpreadPx
    glyph.sdfPxRange = atlas.fonts[fontIndex].sdfPxRange
    glyph.codepoint = codepoint
    glyph.fontSize = fontSize
    glyph.advance = advance
    let sharedBitmapIndex = WebSceneGlyphAtlasFindGlyphSdfBitmapIndex(atlas, fontAtlasId, codepoint, sdfFontSize)
    if sharedBitmapIndex >= 0:
        let sharedGlyph = atlas.glyphs[sharedBitmapIndex]
        glyph.atlasX = sharedGlyph.atlasX
        glyph.atlasY = sharedGlyph.atlasY
        glyph.width = sharedGlyph.width
        glyph.height = sharedGlyph.height
        glyph.sdfPixelStart = sharedGlyph.sdfPixelStart
        glyph.sdfPixelCount = sharedGlyph.sdfPixelCount
        add(atlas.glyphs, glyph)
        if atlas.fonts[fontIndex].glyphCount == 0:
            atlas.fonts[fontIndex].glyphStart = cellIndex
        atlas.fonts[fontIndex].glyphCount = atlas.fonts[fontIndex].glyphCount + 1
        return true
    if atlas.glyphPackRowHeight <= 0:
        atlas.glyphPackRowHeight = cellSize
    if atlas.glyphPackX + cellSize > atlas.atlasWidth:
        atlas.glyphPackX = 0
        atlas.glyphPackY = atlas.glyphPackY + atlas.glyphPackRowHeight
        atlas.glyphPackRowHeight = cellSize
    elif cellSize > atlas.glyphPackRowHeight:
        atlas.glyphPackRowHeight = cellSize
    glyph.atlasX = atlas.glyphPackX
    glyph.atlasY = atlas.glyphPackY
    glyph.width = cellSize
    glyph.height = cellSize
    glyph.sdfPixelStart = glyph.atlasY * atlas.atlasWidth + glyph.atlasX
    glyph.sdfPixelCount = 0
    var outline: font.WebFontGlyphOutline
    if !font.WebFontGlyphOutlineRead(atlas.fonts[fontIndex].face, fontGlyphIndex, outline):
        return false
    if !WebSceneGlyphAtlasAppendGlyphSdfPixels(fontIndex, outline, glyph, atlas):
        return false
    add(atlas.glyphs, glyph)
    if atlas.fonts[fontIndex].glyphCount == 0:
        atlas.fonts[fontIndex].glyphStart = cellIndex
    atlas.fonts[fontIndex].glyphCount = atlas.fonts[fontIndex].glyphCount + 1
    atlas.glyphPackX = atlas.glyphPackX + cellSize
    let atlasBottom = glyph.atlasY + cellSize
    if atlasBottom > atlas.atlasHeight:
        atlas.atlasHeight = atlasBottom
    return true

# Pack a synthesized .notdef box cell into the atlas. Mirrors WebSceneGlyphAtlasAppendGlyph
# but rasterizes the design-unit tofu box instead of reading the font's own outline,
# and stamps glyphIndex 0 to mark it as the missing-glyph substitution. Each distinct
# missing codepoint keys its own cell (no shared-bitmap dedup) so lookups stay透明.
fn WebSceneGlyphAtlasAppendNotdefGlyph(fontIndex: int32,
                                       fontAtlasId: int32,
                                       glyphId: int32,
                                       codepoint: int32,
                                       fontSize: int32,
                                       advance: int32,
                                       atlas: var WebSceneGlyphAtlas): bool =
    if fontIndex < 0 || fontIndex >= atlas.fonts.len:
        return false
    if atlas.atlasWidth <= 0:
        return false
    let sdfFontSize = WebSceneGlyphAtlasSdfFontSizeForFontSize(fontSize)
    var cellSize = sdfFontSize * 2 * WebSceneGlyphSdfScale
    if cellSize <= 0:
        return false
    if cellSize > atlas.atlasWidth:
        return false
    if atlas.glyphPackX < 0 || atlas.glyphPackY < 0 || atlas.glyphPackRowHeight < 0:
        return false
    let cellIndex = atlas.glyphs.len
    var glyph: WebSceneGlyphAtlasGlyphEntry
    glyph.fontAtlasId = fontAtlasId
    glyph.glyphId = glyphId
    glyph.glyphIndex = 0
    glyph.sdfAtlasId = atlas.fonts[fontIndex].sdfAtlasId
    glyph.sdfSpreadPx = atlas.fonts[fontIndex].sdfSpreadPx
    glyph.sdfPxRange = atlas.fonts[fontIndex].sdfPxRange
    glyph.codepoint = codepoint
    glyph.fontSize = fontSize
    glyph.advance = advance
    if atlas.glyphPackRowHeight <= 0:
        atlas.glyphPackRowHeight = cellSize
    if atlas.glyphPackX + cellSize > atlas.atlasWidth:
        atlas.glyphPackX = 0
        atlas.glyphPackY = atlas.glyphPackY + atlas.glyphPackRowHeight
        atlas.glyphPackRowHeight = cellSize
    elif cellSize > atlas.glyphPackRowHeight:
        atlas.glyphPackRowHeight = cellSize
    glyph.atlasX = atlas.glyphPackX
    glyph.atlasY = atlas.glyphPackY
    glyph.width = cellSize
    glyph.height = cellSize
    glyph.sdfPixelStart = glyph.atlasY * atlas.atlasWidth + glyph.atlasX
    glyph.sdfPixelCount = 0
    var outline: font.WebFontGlyphOutline
    if !WebSceneGlyphAtlasBuildNotdefBoxOutline(atlas.fonts[fontIndex].face, outline):
        return false
    if !WebSceneGlyphAtlasAppendGlyphSdfPixels(fontIndex, outline, glyph, atlas):
        return false
    add(atlas.glyphs, glyph)
    if atlas.fonts[fontIndex].glyphCount == 0:
        atlas.fonts[fontIndex].glyphStart = cellIndex
    atlas.fonts[fontIndex].glyphCount = atlas.fonts[fontIndex].glyphCount + 1
    atlas.glyphPackX = atlas.glyphPackX + cellSize
    let atlasBottom = glyph.atlasY + cellSize
    if atlasBottom > atlas.atlasHeight:
        atlas.atlasHeight = atlasBottom
    return true

# Find-or-append the .notdef box for a missing codepoint keyed by the real code
# point, so every existing (fontAtlasId, codepoint, fontSize) lookup transparently
# resolves the box. The box advance comes from the codepoint class (not the font's
# glyph-0 zero advance) to keep layout width stable. Returns the atlas.glyphs index,
# or -1 if the face cannot produce a box (broken face — let the caller crash loudly).
fn WebSceneGlyphAtlasEnsureNotdefGlyph(atlas: var WebSceneGlyphAtlas,
                                       fontIndex: int32,
                                       codepoint: int32,
                                       fontSize: int32): int32 =
    if fontIndex < 0 || fontIndex >= atlas.fonts.len:
        return -1
    let fontAtlasId = atlas.fonts[fontIndex].fontAtlasId
    let existing = WebSceneGlyphAtlasFindGlyphIndex(atlas, fontAtlasId, codepoint, fontSize)
    if existing >= 0:
        return existing
    let advance = WebSceneGlyphAdvanceForCodepoint(codepoint, fontSize)
    if advance <= 0:
        return -1
    let glyphId = atlas.glyphs.len + 1
    if glyphId <= 0:
        return -1
    if !WebSceneGlyphAtlasAppendNotdefGlyph(fontIndex, fontAtlasId, glyphId, codepoint, fontSize, advance, atlas):
        return -1
    return atlas.glyphs.len - 1

# Append a .notdef box run glyph, binding the run to the box's font on the first
# glyph so a whole run keeps a single sdf atlas. Records the non-latch substitution
# count. Returns false only when the box cannot be synthesized (broken face).
fn WebSceneGlyphAtlasAppendNotdefRunGlyph(atlas: var WebSceneGlyphAtlas,
                                          run: var WebSceneGlyphRun,
                                          fontIndex: int32,
                                          codepoint: int32,
                                          fontSize: int32): bool =
    if fontIndex < 0:
        return false
    let ndGlyphIndex = WebSceneGlyphAtlasEnsureNotdefGlyph(atlas, fontIndex, codepoint, fontSize)
    if ndGlyphIndex < 0:
        return false
    WebSceneGlyphAtlasDebugNotdef(codepoint)
    let glyph = atlas.glyphs[ndGlyphIndex]
    if run.glyphCount == 0:
        run.fontAtlasId = glyph.fontAtlasId
        run.sdfAtlasId = glyph.sdfAtlasId
    var runGlyph: WebSceneGlyphRunGlyph
    runGlyph.glyphId = glyph.glyphId
    runGlyph.advance = glyph.advance
    add(atlas.runGlyphs, runGlyph)
    run.glyphCount = run.glyphCount + 1
    run.advanceWidth = run.advanceWidth + glyph.advance
    return true

fn WebSceneScaleDesignToPx(value: int32, fontSize: int32, unitsPerEm: int32): int32 =
    if fontSize <= 0 || unitsPerEm <= 0:
        return 0
    let numer = int64(value) * int64(fontSize)
    let denom = int64(unitsPerEm)
    if numer >= int64(0):
        return int32((numer + denom / int64(2)) / denom)
    return int32((numer - denom / int64(2)) / denom)

fn WebSceneIntSqrt(value: int32): int32 =
    if value <= 0:
        return 0
    var root = 0
    while (root + 1) * (root + 1) <= value:
        root = root + 1
    return root

fn WebSceneGlyphSdfContainsAtPixel(outline: var font.WebFontGlyphOutline,
                                   px: int32,
                                   py: int32,
                                   baselineY: int32,
                                   fontSize: int32,
                                   unitsPerEm: int32,
                                   spreadPx: int32): bool =
    let denom = int64(fontSize * 2 * WebSceneGlyphSdfScale)
    let gxNumer = int64(((px - spreadPx) * 2) + 1) * int64(unitsPerEm)
    let gyNumer = int64(((baselineY - py) * 2) - 1) * int64(unitsPerEm)
    let gx = raster.RasterFloorDivI64(gxNumer, denom)
    let gy = raster.RasterFloorDivI64(gyNumer, denom)
    return raster.RasterGlyphOutlineContainsPoint(outline, gx, gy)

# Scanline inside-mask: one crossing-threshold pass per row instead of the
# per-pixel even-odd walk over every edge (O(cell*E) vs O(cell^2*E)). For each
# row, an edge crossing gy flips parity at all gx < T where T is the exact
# integer threshold reproducing RasterGlyphEdgeCrosses' comparison, so the mask
# is byte-identical to the per-pixel path.
fn WebSceneGlyphSdfInsideMaskScanline(outline: var font.WebFontGlyphOutline,
                                      cellSize: int32,
                                      baselineY: int32,
                                      fontSize: int32,
                                      unitsPerEm: int32,
                                      spreadPx: int32,
                                      insideMask: var int32[]) =
    let denom = int64(fontSize * 2 * WebSceneGlyphSdfScale)
    var gxs: int32[]
    setLen(gxs, cellSize)
    setLen(insideMask, cellSize * cellSize)
    for px in 0..<cellSize:
        let gxNumer = int64(((px - spreadPx) * 2) + 1) * int64(unitsPerEm)
        gxs[px] = raster.RasterFloorDivI64(gxNumer, denom)
    var thresholds: int32[]
    setLen(thresholds, outline.pointCount)
    for py in 0..<cellSize:
        let rowBase = py * cellSize
        let gyNumer = int64(((baselineY - py) * 2) - 1) * int64(unitsPerEm)
        let gy = raster.RasterFloorDivI64(gyNumer, denom)
        var thresholdCount = 0
        var contourStart = 0
        var bad = false
        var i = 0
        while i < outline.pointCount && !bad:
            let p0 = outline.points[i]
            var nextIndex = i + 1
            if p0.endContour:
                nextIndex = contourStart
                contourStart = i + 1
            if nextIndex < 0 || nextIndex >= outline.pointCount:
                bad = true
            else:
                let p1 = outline.points[nextIndex]
                if p0.y != p1.y:
                    let above0 = p0.y > gy
                    let above1 = p1.y > gy
                    if above0 != above1:
                        let dy = p1.y - p0.y
                        var numer = int64(p0.x) * int64(dy) + int64(gy - p0.y) * int64(p1.x - p0.x)
                        var d = int64(dy)
                        if d < int64(0):
                            numer = int64(0) - numer
                            d = int64(0) - d
                        let t = raster.RasterCeilDivI64(numer, d)
                        # insertion sort ascending; crossing counts stay small per row
                        thresholds[thresholdCount] = t
                        var k = thresholdCount
                        while k > 0 && thresholds[k - 1] > thresholds[k]:
                            let tmp = thresholds[k - 1]
                            thresholds[k - 1] = thresholds[k]
                            thresholds[k] = tmp
                            k = k - 1
                        thresholdCount = thresholdCount + 1
            i = i + 1
        if bad:
            for px in 0..<cellSize:
                insideMask[rowBase + px] = 0
        else:
            let n = thresholdCount
            var j = 0
            for px in 0..<cellSize:
                while j < n && thresholds[j] <= gxs[px]:
                    j = j + 1
                if (n - j) % 2 != 0:
                    insideMask[rowBase + px] = 1
                else:
                    insideMask[rowBase + px] = 0

fn WebSceneClampByte(value: int32): int32 =
    if value < 0:
        return 0
    if value > 255:
        return 255
    return value

fn WebSceneGlyphSdfPixelValue(outline: var font.WebFontGlyphOutline,
                              px: int32,
                              py: int32,
                              cellSize: int32,
                              baselineY: int32,
                              fontSize: int32,
                              unitsPerEm: int32,
                              spreadPx: int32,
                              pxRange: int32): int32 =
    if pxRange <= 0:
        return 0
    let inside = WebSceneGlyphSdfContainsAtPixel(outline, px, py, baselineY, fontSize, unitsPerEm, spreadPx)
    let maxSq = pxRange * pxRange
    var bestSq = maxSq + 1
    var dy = 0 - pxRange
    while dy <= pxRange:
        var dx = 0 - pxRange
        while dx <= pxRange:
            let nx = px + dx
            let ny = py + dy
            var otherInside = false
            if nx >= 0 && ny >= 0 && nx < cellSize && ny < cellSize:
                otherInside = WebSceneGlyphSdfContainsAtPixel(outline, nx, ny, baselineY, fontSize, unitsPerEm, spreadPx)
            if otherInside != inside:
                let distSq = dx * dx + dy * dy
                if distSq < bestSq:
                    bestSq = distSq
            dx = dx + 1
        dy = dy + 1
    if bestSq > maxSq:
        if inside:
            return 255
        return 0
    var dist = WebSceneIntSqrt(bestSq)
    if dist > pxRange:
        dist = pxRange
    if inside:
        return WebSceneClampByte(128 + (dist * 127) / pxRange)
    return WebSceneClampByte(128 - (dist * 128) / pxRange)

fn WebSceneGlyphSdfColumnDistance(mask: var int32[], cellSize: int32, target: int32, g: var int32[]) =
    let inf = cellSize + cellSize
    for x in 0..<cellSize:
        var d = inf
        for y in 0..<cellSize:
            let idx = y * cellSize + x
            var isTarget = false
            if target != 0:
                isTarget = mask[idx] != 0
            else:
                isTarget = mask[idx] == 0
            if isTarget:
                d = 0
            elif d < inf:
                d = d + 1
            g[idx] = d
        d = inf
        var yy = cellSize - 1
        while yy >= 0:
            let idx = yy * cellSize + x
            if g[idx] == 0:
                d = 0
            elif d < inf:
                d = d + 1
            if d < g[idx]:
                g[idx] = d
            yy = yy - 1

fn WebSceneGlyphSdfRowEnvelopeDistSq(g: var int32[], cellSize: int32, out: var int32[]) =
    let inf = cellSize + cellSize
    let infSq = inf * inf + inf * inf
    var s: int32[]
    var t: int32[]
    setLen(s, cellSize)
    setLen(t, cellSize)
    for y in 0..<cellSize:
        let rowBase = y * cellSize
        var q = 0 - 1
        for u in 0..<cellSize:
            let gu = g[rowBase + u]
            if gu < inf:
                var keepPopping = true
                while q >= 0 && keepPopping:
                    let i = s[q]
                    let gi = g[rowBase + i]
                    let du = t[q] - u
                    let di = t[q] - i
                    if du * du + gu * gu < di * di + gi * gi:
                        q = q - 1
                    else:
                        keepPopping = false
                if q < 0:
                    q = 0
                    s[0] = u
                    t[0] = 0
                else:
                    let i = s[q]
                    let gi = g[rowBase + i]
                    let w = (u * u - i * i + gu * gu - gi * gi) / (2 * (u - i)) + 1
                    if w < cellSize:
                        q = q + 1
                        s[q] = u
                        t[q] = w
        if q < 0:
            for x in 0..<cellSize:
                out[rowBase + x] = infSq
        else:
            var xx = cellSize - 1
            while xx >= 0:
                var dropping = true
                while q > 0 && dropping:
                    if xx < t[q]:
                        q = q - 1
                    else:
                        dropping = false
                let i = s[q]
                let gi = g[rowBase + i]
                let dx = xx - i
                out[rowBase + xx] = dx * dx + gi * gi
                xx = xx - 1

fn WebSceneGlyphSdfPixelValueFromDistSq(inside: bool, bestSq: int32, pxRange: int32): int32 =
    if pxRange <= 0:
        return 0
    let maxSq = pxRange * pxRange
    if bestSq > maxSq:
        if inside:
            return 255
        return 0
    var dist = WebSceneIntSqrt(bestSq)
    if dist > pxRange:
        dist = pxRange
    if inside:
        return WebSceneClampByte(128 + (dist * 127) / pxRange)
    return WebSceneClampByte(128 - (dist * 128) / pxRange)

fn WebSceneGlyphSdfMaskAt(mask: var int32[], cellSize: int32, px: int32, py: int32): bool =
    if px < 0 || py < 0 || px >= cellSize || py >= cellSize:
        return false
    let index = py * cellSize + px
    if index < 0 || index >= mask.len:
        return false
    if mask[index] != 0:
        return true
    return false

fn WebSceneGlyphSdfPixelValueFromMask(mask: int32[],
                                      px: int32,
                                      py: int32,
                                      cellSize: int32,
                                      pxRange: int32): int32 =
    if pxRange <= 0:
        return 0
    let inside = WebSceneGlyphSdfMaskAt(mask, cellSize, px, py)
    let maxSq = pxRange * pxRange
    var bestSq = maxSq + 1
    var dy = 0 - pxRange
    while dy <= pxRange:
        var dx = 0 - pxRange
        while dx <= pxRange:
            let otherInside = WebSceneGlyphSdfMaskAt(mask, cellSize, px + dx, py + dy)
            if otherInside != inside:
                let distSq = dx * dx + dy * dy
                if distSq < bestSq:
                    bestSq = distSq
            dx = dx + 1
        dy = dy + 1
    if bestSq > maxSq:
        if inside:
            return 255
        return 0
    var dist = WebSceneIntSqrt(bestSq)
    if dist > pxRange:
        dist = pxRange
    if inside:
        return WebSceneClampByte(128 + (dist * 127) / pxRange)
    return WebSceneClampByte(128 - (dist * 128) / pxRange)

@borrows
fn WebSceneGlyphAtlasAppendGlyphSdfPixels(fontIndex: int32,
                                          outline: var font.WebFontGlyphOutline,
                                          glyph: var WebSceneGlyphAtlasGlyphEntry,
                                          atlas: var WebSceneGlyphAtlas): bool =
    if !atlas.fonts[fontIndex].face.loaded || atlas.fonts[fontIndex].face.unitsPerEm <= 0:
        return false
    if glyph.width <= 0 || glyph.height <= 0 || glyph.width != glyph.height:
        return false
    let cellSize = glyph.width
    let expected = cellSize * cellSize
    if expected <= 0:
        return false
    var pixels: uint8[]
    setLen(pixels, expected)
    let sdfFontSize = WebSceneGlyphAtlasInferFontSizeFromGlyph(glyph)
    if sdfFontSize <= 0:
        return false
    if outline.pointCount <= 0:
        for px in 0..<expected:
            pixels[px] = uint8(0)
    else:
        var drawable: font.WebFontGlyphOutline
        if !raster.RasterGlyphFlattenQuadratics(outline, drawable):
            return false
        let ascenderPx = WebSceneScaleDesignToPx(atlas.fonts[fontIndex].face.ascender, sdfFontSize, atlas.fonts[fontIndex].face.unitsPerEm) * WebSceneGlyphSdfScale
        let baselineY = glyph.sdfSpreadPx + ascenderPx
        var insideMask: int32[]
        setLen(insideMask, expected)
        WebSceneGlyphSdfInsideMaskScanline(drawable, cellSize, baselineY, sdfFontSize, atlas.fonts[fontIndex].face.unitsPerEm, glyph.sdfSpreadPx, insideMask)
        if insideMask.len != expected:
            return false
        var colG: int32[]
        var distToOutside: int32[]
        var distToInside: int32[]
        setLen(colG, expected)
        setLen(distToOutside, expected)
        setLen(distToInside, expected)
        WebSceneGlyphSdfColumnDistance(insideMask, cellSize, 0, colG)
        WebSceneGlyphSdfRowEnvelopeDistSq(colG, cellSize, distToOutside)
        WebSceneGlyphSdfColumnDistance(insideMask, cellSize, 1, colG)
        WebSceneGlyphSdfRowEnvelopeDistSq(colG, cellSize, distToInside)
        for py in 0..<cellSize:
            for px in 0..<cellSize:
                let maskIdx = py * cellSize + px
                let inside = insideMask[maskIdx] != 0
                var bestSq: int32
                if inside:
                    bestSq = distToOutside[maskIdx]
                    var border = px + 1
                    if cellSize - px < border:
                        border = cellSize - px
                    if py + 1 < border:
                        border = py + 1
                    if cellSize - py < border:
                        border = cellSize - py
                    if border * border < bestSq:
                        bestSq = border * border
                else:
                    bestSq = distToInside[maskIdx]
                pixels[maskIdx] = uint8(WebSceneGlyphSdfPixelValueFromDistSq(inside, bestSq, glyph.sdfPxRange))
    if pixels.len != expected:
        return false
    let requiredPixels = (glyph.atlasY + glyph.height) * atlas.atlasWidth
    if requiredPixels <= 0:
        return false
    if atlas.sdfPixels.len <= 0 && atlas.sdfPixelCount > 0:
        return false
    if atlas.sdfPixels.len < requiredPixels:
        setLen(atlas.sdfPixels, requiredPixels)
    atlas.sdfPixelCount = atlas.sdfPixels.len
    glyph.sdfPixelStart = glyph.atlasY * atlas.atlasWidth + glyph.atlasX
    glyph.sdfPixelCount = pixels.len
    for py in 0..<glyph.height:
        for px in 0..<glyph.width:
            let srcIndex = py * glyph.width + px
            let dstIndex = (glyph.atlasY + py) * atlas.atlasWidth + glyph.atlasX + px
            if srcIndex < 0 || srcIndex >= pixels.len || dstIndex < 0 || dstIndex >= atlas.sdfPixels.len:
                return false
            atlas.sdfPixels[dstIndex] = pixels[srcIndex]
    WebSceneGlyphAtlasBumpSdfPixelVersion(atlas)
    if !(glyph.sdfPixelStart >= 0):
        return false
    if !(glyph.sdfPixelStart < atlas.sdfPixels.len):
        return false
    return true

fn WebSceneGlyphAdvanceForCodepoint(codepoint: int32, fontSize: int32): int32 =
    if fontSize <= 0:
        return 0
    if codepoint == 32:
        return fontSize / 4
    if codepoint >= 0 && codepoint < 128:
        return fontSize * 3 / 5
    return fontSize

fn WebSceneGlyphAtlasFontCount(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.fonts.len

fn WebSceneGlyphAtlasGlyphCount(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.glyphs.len

fn WebSceneGlyphAtlasRunCount(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.runs.len

fn WebSceneGlyphAtlasWidth(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.atlasWidth

fn WebSceneGlyphAtlasHeight(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.atlasHeight

fn WebSceneGlyphAtlasFontIdAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.fonts.len:
        return -1
    return atlas.fonts[index].fontAtlasId

fn WebSceneGlyphAtlasFontSdfAtlasIdAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
