    op.fontWeight = 0
    op.fontFamily = 0
    op.shadowOffsetX = 0
    op.shadowOffsetY = 0
    op.shadowBlur = 0
    op.shadowSpread = 0
    op.shadowInset = false
    op.gradientEndColor = int64(0)
    op.gradientAngle = 0
    op.rotationDeg = 0
    # Borrowed inputs are cloned into owned values at the managed store sites.
    op.resourceId = strings.CloneStr(resourceId)
    op.textContent = strings.CloneStr(textContent)
    add(graph.paintOps, op)
    graph.paintOpRangeIndexSynced = false
