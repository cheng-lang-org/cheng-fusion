fn WebScenePaintSvgPrimitiveCloneFromSeq(seq: var WebScenePaintSvgPrimitive[], index: int32, dst: var WebScenePaintSvgPrimitive): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
