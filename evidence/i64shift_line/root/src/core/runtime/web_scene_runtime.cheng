    return graph.mediaAssets.len

fn WebSceneMediaPlaybackSlotCount(graph: var WebSceneGraph): int32 =
    return graph.mediaPlaybackSlots.len

# S3 peer 透传 accessors: per-slot publisher endpoint (empty host = local/bundled content).
fn WebSceneMediaPlaybackSlotPeerHostAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaPlaybackSlots.len:
        return ""
    return graph.mediaPlaybackSlots[index].peerHost

fn WebSceneMediaPlaybackSlotPeerPortAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaPlaybackSlots.len:
        return 0
    return graph.mediaPlaybackSlots[index].peerPort

fn WebSceneMediaPlaybackSlotIdAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaPlaybackSlots.len:
        return ""
    return graph.mediaPlaybackSlots[index].slotId

# S3 feed prewarm plan skeleton: first maxN slots with non-empty peerHost.
# Returns filled count (0..maxN). outHost0/1 + outPort0/1 carry the plan;
# maxN is clamped to 2 (visible-card budget for the initial skeleton).
# Pure graph scan — no dial. Host/env gate owns async es_open.
fn WebSceneMediaCollectFeedPrewarmPeers(graph: var WebSceneGraph,
                                        maxN: int32,
                                        outHost0: var str,
                                        outPort0: var int32,
                                        outHost1: var str,
                                        outPort1: var int32): int32 =
    outHost0 = ""
    outPort0 = 0
    outHost1 = ""
    outPort1 = 0
    var limit: int32
    limit = maxN
    if limit > 2:
        limit = 2
    if limit <= 0:
        return 0
    var filled: int32
    for i in 0..<graph.mediaPlaybackSlots.len:
        if filled >= limit:
            break
        let host = graph.mediaPlaybackSlots[i].peerHost
        if host.len == 0:
            continue
        var port: int32
        port = graph.mediaPlaybackSlots[i].peerPort
        if port <= 0:
            port = 38000
        # Dedupe identical host:port (same publisher on multiple cards).
        if filled >= 1 && outHost0 == host && outPort0 == port:
            continue
        if filled == 0:
            outHost0 = host
            outPort0 = port
        else:
            outHost1 = host
            outPort1 = port
        filled = filled + 1
    return filled

fn WebSceneMediaControlActionCount(graph: var WebSceneGraph): int32 =
    return graph.mediaControlActions.len

fn WebSceneMediaReceiptCount(graph: var WebSceneGraph): int32 =
    return graph.mediaReceipts.len

fn WebSceneMediaLifecycleEventCount(graph: var WebSceneGraph): int32 =
    return graph.mediaLifecycleEvents.len

fn WebSceneCssVariantRuleCount(graph: var WebSceneGraph): int32 =
    return graph.cssVariantRules.len

fn WebSceneCssVariantConditionCount(graph: var WebSceneGraph): int32 =
    return graph.cssVariantConditions.len

fn WebSceneCssDeclarationCount(graph: var WebSceneGraph): int32 =
    return graph.cssDeclarations.len

fn WebSceneLayerCount(graph: var WebSceneGraph): int32 =
    return graph.layers.len

fn WebSceneResourceCount(graph: var WebSceneGraph): int32 =
    return graph.resources.len

fn WebSceneLayoutCount(graph: var WebSceneGraph): int32 =
    return graph.layoutConstraints.len

fn WebScenePaintCount(graph: var WebSceneGraph): int32 =
    return graph.paintOps.len

fn WebScenePaintRouteIndexAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.paintOps.len:
        return -1
    return graph.paintOps[index].routeIndex

fn WebScenePaintNodeIdAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.paintOps.len:
        return -1
    return graph.paintOps[index].nodeId

fn WebScenePaintOrdinalAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.paintOps.len:
        return -1
    return graph.paintOps[index].ordinal

fn WebScenePaintKindAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.paintOps.len:
        return -1
    return graph.paintOps[index].opKind

fn WebSceneDirtyCount(graph: var WebSceneGraph): int32 =
    return graph.dirtySpans.len

fn WebSceneLayerCacheCount(graph: var WebSceneGraph): int32 =
    return graph.layerCaches.len

fn WebSceneActiveRouteIndex(graph: var WebSceneGraph): int32 =
    return graph.activeRouteIndex

fn WebSceneVersion(graph: var WebSceneGraph): int32 =
    return graph.version

fn WebSceneStateVersion(graph: var WebSceneGraph): int32 =
    return graph.stateVersion

fn WebSceneRouteStateVersion(graph: var WebSceneGraph, routeIndex: int32): int32 =
    if routeIndex < 0 || routeIndex >= graph.routes.len || routeIndex >= graph.routeStateVersions.len:
        return -1
    return graph.routeStateVersions[routeIndex]

fn WebSceneAddStateRouteDependency(graph: var WebSceneGraph, stateRef: str, routeIndex: int32): bool =
    if stateRef.len == 0 || routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    add(graph.stateDependencyRefs, stateRef)
    add(graph.stateDependencyRoutes, routeIndex)
    return true

@borrows
fn WebSceneMarkStateRouteDependencies(graph: var WebSceneGraph, stateRef: str) =
    if stateRef.len == 0:
        return
    for i in 0..<graph.stateDependencyRefs.len:
        if graph.stateDependencyRefs[i] == stateRef:
            let routeIndex = graph.stateDependencyRoutes[i]
            if routeIndex >= 0 && routeIndex < graph.routeStateVersions.len:
                graph.routeStateVersions[routeIndex] = graph.routeStateVersions[routeIndex] + 1

fn WebSceneSetCurrentViewport(graph: var WebSceneGraph, viewportWidth: int32, viewportHeight: int32): bool =
    if viewportWidth <= 0 || viewportHeight <= 0:
        return false
    graph.currentViewportWidth = viewportWidth
    graph.currentViewportHeight = viewportHeight
    return true

fn WebSceneCurrentViewportWidth(graph: var WebSceneGraph): int32 =
    return graph.currentViewportWidth

fn WebSceneCurrentViewportHeight(graph: var WebSceneGraph): int32 =
    return graph.currentViewportHeight

@borrows
fn WebSceneFindRouteIndex(graph: var WebSceneGraph, routeId: str): int32 =
    for i in 0..<graph.routes.len:
        if graph.routes[i].routeId == routeId:
            return graph.routes[i].routeIndex
    return -1

fn WebSceneAddRoute(graph: var WebSceneGraph, routeId: str, rootNodeId: int32, layerId: int32, outRouteIndex: var int32): bool =
    if routeId.len == 0:
        return false
    if WebSceneFindRouteIndex(graph, routeId) >= 0:
        return false
    var route: WebSceneRoute
    route.routeId = routeId
    route.routeIndex = graph.routes.len
    route.rootNodeIds = []
    if rootNodeId > 0:
        add(route.rootNodeIds, rootNodeId)
    route.layerId = layerId
    add(graph.routes, route)
    add(graph.routeStateVersions, 0)
    outRouteIndex = route.routeIndex
    return true

@borrows
fn WebSceneAddRouteExpectedIndex(graph: var WebSceneGraph, routeId: str, rootNodeId: int32, layerId: int32, expectedRouteIndex: int32): bool =
    if routeId.len == 0:
        return false
    if expectedRouteIndex < 0:
        return false
    if expectedRouteIndex != graph.routes.len:
        return false
    if WebSceneFindRouteIndex(graph, routeId) >= 0:
        return false
    var route: WebSceneRoute
    route.routeId = routeId
    route.routeIndex = expectedRouteIndex
    route.rootNodeIds = []
    if rootNodeId > 0:
        add(route.rootNodeIds, rootNodeId)
    route.layerId = layerId
    add(graph.routes, route)
    add(graph.routeStateVersions, 0)
    if graph.routes.len == expectedRouteIndex + 1:
        return true
    return false

fn WebSceneAddRouteRoot(graph: var WebSceneGraph, routeIndex: int32, rootNodeId: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if rootNodeId <= 0:
        return false
    add(graph.routes[routeIndex].rootNodeIds, rootNodeId)
    return true

@borrows
fn WebSceneAddLayer(graph: var WebSceneGraph, routeIndex: int32, layerId: int32, name: str, ordinal: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if layerId <= 0:
        return false
    if name.len == 0:
        return false
    if WebSceneFindLayerIndex(graph, routeIndex, layerId) >= 0:
        return false
    var layer: WebSceneLayer
    layer.routeIndex = routeIndex
    layer.layerId = layerId
    layer.name = name
    layer.ordinal = ordinal
    layer.offsetX = 0
    layer.offsetY = 0
    add(graph.layers, layer)
    return true

fn WebSceneSetLayerOffset(graph: var WebSceneGraph,
                          routeIndex: int32,
                          layerId: int32,
                          offsetX: int32,
                          offsetY: int32): bool =
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, layerId)
    if layerIndex < 0:
        return false
    let previousOffsetX = graph.layers[layerIndex].offsetX
    let previousOffsetY = graph.layers[layerIndex].offsetY
    if previousOffsetX == offsetX && previousOffsetY == offsetY:
        return true
    graph.layers[layerIndex].offsetX = offsetX
    graph.layers[layerIndex].offsetY = offsetY
    graph.version = graph.version + 1
    return WebSceneAppendDirtyLayerMove(graph, routeIndex, layerId, previousOffsetX, previousOffsetY)

fn WebSceneScrollLayer(graph: var WebSceneGraph, routeIndex: int32, layerId: int32, deltaX: int32, deltaY: int32): bool =
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, layerId)
    if layerIndex < 0:
        return false
    return WebSceneSetLayerOffset(graph,
                                  routeIndex,
                                  layerId,
                                  graph.layers[layerIndex].offsetX + deltaX,
                                  graph.layers[layerIndex].offsetY + deltaY)

fn WebSceneContentLayerId(routeIndex: int32): int32 =
    return routeIndex * 100 + 1

fn WebSceneRouteContentScrollMax(graph: var WebSceneGraph, routeIndex: int32): int32 =
    let contentLayerId = WebSceneContentLayerId(routeIndex)
    let contentHeight = WebSceneLayerCachePaintBoundsHeight(graph, routeIndex, contentLayerId)
    let viewportHeight = graph.currentViewportHeight
    if contentHeight <= viewportHeight:
        return 0
    return contentHeight - viewportHeight

fn WebSceneSetContentScrollY(graph: var WebSceneGraph, routeIndex: int32, scrollY: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    let contentLayerId = WebSceneContentLayerId(routeIndex)
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, contentLayerId)
    if layerIndex < 0:
        return false
    var clampedScrollY = scrollY
    if clampedScrollY < 0:
        clampedScrollY = 0
    let scrollMax = WebSceneRouteContentScrollMax(graph, routeIndex)
    if clampedScrollY > scrollMax:
        clampedScrollY = scrollMax
    return WebSceneSetLayerOffset(graph,
                                  routeIndex,
                                  contentLayerId,
                                  graph.layers[layerIndex].offsetX,
                                  0 - clampedScrollY)

fn WebSceneRouteContentScrollY(graph: var WebSceneGraph, routeIndex: int32): int32 =
    let contentLayerId = WebSceneContentLayerId(routeIndex)
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, contentLayerId)
    if layerIndex < 0:
        return 0
    return 0 - graph.layers[layerIndex].offsetY

fn WebSceneAddResource(graph: var WebSceneGraph,
                       resourceKind: str,
                       resourceId: str,
                       source: str,
                       data: str,
                       hash: str,
                       byteSize: int32,
                       fontWeight: int32,
                       fontFamily: int32): bool =
    if resourceKind.len == 0:
        return false
    if resourceId.len == 0:
        return false
    if byteSize < 0:
        return false
    if fontWeight < 0 || fontFamily < 0:
        return false
    if WebSceneFindResourceIndex(graph, resourceKind, resourceId) >= 0:
        return false
    var resource: WebSceneResource
    resource.ordinal = graph.resources.len
    resource.resourceKind = resourceKind
    resource.resourceId = resourceId
    resource.source = source
    resource.data = data
    resource.hash = hash
    resource.byteSize = byteSize
    resource.fontWeight = fontWeight
    resource.fontFamily = fontFamily
    resource.width = 0
    resource.height = 0
    resource.pixelCount = 0
    resource.pixels = []
    resource.fontBytes = []
    add(graph.resources, resource)
    return true

fn WebSceneAddResourceShell(graph: var WebSceneGraph,
                            resourceKind: str,
                            resourceId: str,
                            outResourceIndex: var int32): bool =
    outResourceIndex = -1
    if resourceKind.len == 0:
        return false
    if resourceId.len == 0:
        return false
    if WebSceneFindResourceIndex(graph, resourceKind, resourceId) >= 0:
        return false
    var resource: WebSceneResource
    resource.ordinal = graph.resources.len
    resource.resourceKind = resourceKind
    resource.resourceId = resourceId
    resource.source = ""
    resource.data = ""
    resource.hash = ""
    resource.byteSize = 0
    resource.fontWeight = 0
    resource.fontFamily = 0
    resource.width = 0
    resource.height = 0
    resource.pixelCount = 0
    resource.pixels = []
    resource.fontBytes = []
    add(graph.resources, resource)
    outResourceIndex = resource.ordinal
    return true

@borrows
fn WebSceneAddResourceEntry(graph: var WebSceneGraph,
                            resourceKind: str,
                            resourceId: str): bool =
    if WebSceneAddResourceEntryStatus(graph, resourceKind, resourceId) == 0:
        return true
    return false

@borrows
fn WebSceneAddResourceEntryStatus(graph: var WebSceneGraph,
                                  resourceKind: str,
                                  resourceId: str): int32 =
    if resourceKind.len == 0:
        return 1
    if resourceId.len == 0:
        return 2
    if WebSceneFindResourceIndex(graph, resourceKind, resourceId) >= 0:
        return 3
    var resource: WebSceneResource
    resource.ordinal = graph.resources.len
    # Borrowed inputs are cloned into owned values at the managed store site.
    resource.resourceKind = strings.CloneStr(resourceKind)
    resource.resourceId = strings.CloneStr(resourceId)
    resource.source = ""
    resource.data = ""
    resource.hash = ""
    resource.byteSize = 0
    resource.fontWeight = 0
    resource.fontFamily = 0
    resource.width = 0
    resource.height = 0
    resource.pixelCount = 0
    resource.pixels = []
    resource.fontBytes = []
    add(graph.resources, resource)
    return 0

fn WebSceneResourceIndexValid(graph: var WebSceneGraph, resourceIndex: int32): bool =
    if !(resourceIndex >= 0):
        return false
    if !(resourceIndex < graph.resources.len):
        return false
    return true

fn WebSceneSetResourceSourceAt(graph: var WebSceneGraph, resourceIndex: int32, source: str): bool =
    if !WebSceneResourceIndexValid(graph, resourceIndex):
        return false
    var resource = graph.resources[resourceIndex]
    resource.source = source
    graph.resources[resourceIndex] = resource
    return true

fn WebSceneSetResourceDataAt(graph: var WebSceneGraph, resourceIndex: int32, data: str): bool =
    if !WebSceneResourceIndexValid(graph, resourceIndex):
        return false
    var resource = graph.resources[resourceIndex]
    resource.data = data
    graph.resources[resourceIndex] = resource
    return true

fn WebSceneSetResourceHashAt(graph: var WebSceneGraph, resourceIndex: int32, hash: str): bool =
    if !WebSceneResourceIndexValid(graph, resourceIndex):
        return false
    var resource = graph.resources[resourceIndex]
    resource.hash = hash
    graph.resources[resourceIndex] = resource
    return true

fn WebSceneSetResourceMetricsAt(graph: var WebSceneGraph,
                                resourceIndex: int32,
                                byteSize: int32,
                                fontWeight: int32,
                                fontFamily: int32): bool =
    if !WebSceneResourceIndexValid(graph, resourceIndex):
        return false
    if byteSize < 0:
        return false
    if fontWeight < 0 || fontFamily < 0:
        return false
    var resource = graph.resources[resourceIndex]
    resource.byteSize = byteSize
    resource.fontWeight = fontWeight
    resource.fontFamily = fontFamily
    graph.resources[resourceIndex] = resource
    return true

fn WebSceneSetResourceRasterPixelsAt(graph: var WebSceneGraph,
                                     resourceIndex: int32,
                                     width: int32,
                                     height: int32,
                                     pixels: var int32[]): bool =
    if !WebSceneResourceIndexValid(graph, resourceIndex):
        return false
    if width <= 0 || height <= 0:
        return false
    let expected = width * height
    if expected <= 0 || pixels.len != expected:
        return false
    var resource = graph.resources[resourceIndex]
    resource.width = width
    resource.height = height
    resource.pixelCount = pixels.len
    resource.pixels = []
    for i in 0..<pixels.len:
        add(resource.pixels, pixels[i])
    if resource.pixels.len != expected:
        return false
    graph.resources[resourceIndex] = resource
    return true

@borrows
fn WebSceneSetResourceRasterPixels(graph: var WebSceneGraph,
                                   resourceKind: str,
                                   resourceId: str,
                                   width: int32,
                                   height: int32,
                                   pixels: int32[]): bool =
    if width <= 0 || height <= 0:
        return false
    let expected = width * height
    if expected <= 0:
        return false
    if pixels.len != expected:
        return false
    let resourceIndex = WebSceneFindResourceIndex(graph, resourceKind, resourceId)
    if resourceIndex < 0:
        return false
    var resource = graph.resources[resourceIndex]
    resource.width = width
    resource.height = height
    resource.pixelCount = pixels.len
    resource.pixels = []
    for i in 0..<pixels.len:
        add(resource.pixels, pixels[i])
    if resource.pixels.len != expected:
        return false
    graph.resources[resourceIndex] = resource
    return true

@borrows
fn WebSceneSetResourceFontBytes(graph: var WebSceneGraph,
                                resourceKind: str,
                                resourceId: str,
                                bytes: int32[]): bool =
    if bytes.len <= 0:
        return false
    let resourceIndex = WebSceneFindResourceIndex(graph, resourceKind, resourceId)
    if resourceIndex < 0:
        return false
    var resource = graph.resources[resourceIndex]
    if resource.resourceKind != "font_subset":
        return false
    resource.fontBytes = []
    for i in 0..<bytes.len:
        let value = bytes[i]
        if value < 0 || value > 255:
            return false
        add(resource.fontBytes, value)
    if resource.fontBytes.len != bytes.len:
        return false
    resource.byteSize = bytes.len
    graph.resources[resourceIndex] = resource
    return true

@borrows
fn WebSceneAddNodeWithStateBindingsStatus(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          nodeId: int32,
                                          parentNodeId: int32,
                                          nodeKind: int32,
                                          tagName: str,
                                          textContent: str,
                                          layerId: int32,
                                          conditionalStateRef: str,
                                          conditionalStateValue: str,
                                          textStateRef: str): int32 =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return 1
    if nodeId <= 0:
        return 2
    if WebSceneFindNodeRouteIndex(graph, nodeId) >= 0:
        return 3
    if parentNodeId > 0 && !WebSceneNodeBelongsToRoute(graph, routeIndex, parentNodeId):
        return 4
    if layerId > 0 && WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return 5
    if !WebSceneEnsureNodeLookupCapacity(graph, nodeId):
        return 8
    let beforeCount = graph.nodes.len
    var node: WebSceneNode
    node.nodeId = nodeId
    node.parentNodeId = parentNodeId
    node.routeIndex = routeIndex
    node.nodeKind = nodeKind
    # Borrowed inputs are cloned into owned values at the managed store sites.
    node.tagName = strings.CloneStr(tagName)
    node.textContent = strings.CloneStr(textContent)
    node.layerId = layerId
    node.conditionalStateRef = strings.CloneStr(conditionalStateRef)
    node.conditionalStateValue = strings.CloneStr(conditionalStateValue)
    node.textStateRef = strings.CloneStr(textStateRef)
    add(graph.nodes, node)
    if graph.nodes.len != beforeCount + 1:
        return 6
    if !WebSceneRegisterNodeLookup(graph, graph.nodes[beforeCount], beforeCount):
        return 8
    if WebSceneFindNodeRouteIndex(graph, nodeId) != routeIndex:
        return 7
    return 0

@borrows
fn WebSceneAddNodeWithStateConditionStatus(graph: var WebSceneGraph,
                                           routeIndex: int32,
                                           nodeId: int32,
                                           parentNodeId: int32,
                                           nodeKind: int32,
                                           tagName: str,
                                           textContent: str,
                                           layerId: int32,
                                           conditionalStateRef: str,
                                           conditionalStateValue: str): int32 =
    return WebSceneAddNodeWithStateBindingsStatus(graph, routeIndex, nodeId, parentNodeId, nodeKind, tagName, textContent, layerId, conditionalStateRef, conditionalStateValue, "")

@borrows
fn WebSceneAddNodeStatus(graph: var WebSceneGraph,
                         routeIndex: int32,
                         nodeId: int32,
                         parentNodeId: int32,
                         nodeKind: int32,
                         tagName: str,
                         textContent: str,
                         layerId: int32): int32 =
    return WebSceneAddNodeWithStateConditionStatus(graph, routeIndex, nodeId, parentNodeId, nodeKind, tagName, textContent, layerId, "", "")

@borrows
fn WebSceneAddNode(graph: var WebSceneGraph,
                   routeIndex: int32,
                   nodeId: int32,
                   parentNodeId: int32,
                   nodeKind: int32,
                   tagName: str,
                   textContent: str,
                   layerId: int32): bool =
    if WebSceneAddNodeStatus(graph, routeIndex, nodeId, parentNodeId, nodeKind, tagName, textContent, layerId) == 0:
        return true
    return false

fn WebSceneFindPropIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, ordinal: int32): int32 =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex && graph.props[i].nodeId == nodeId && graph.props[i].ordinal == ordinal:
            return i
    return -1

@borrows
fn WebSceneFindPropNameIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, propName: str): int32 =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           graph.props[i].propName == propName:
            return i
    return -1

@borrows
fn WebSceneNodePropValue(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, propName: str): str =
    let propIndex = WebSceneFindPropNameIndex(graph, routeIndex, nodeId, propName)
    if propIndex < 0:
        return ""
    return graph.props[propIndex].propValue

fn WebSceneAddProp(graph: var WebSceneGraph,
                   routeIndex: int32,
                   nodeId: int32,
                   ordinal: int32,
                   propName: str,
                   propValue: str,
                   valueKind: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0:
        return false
    if propName.len == 0:
        return false
    if WebSceneFindPropIndex(graph, routeIndex, nodeId, ordinal) >= 0:
        return false
    var prop: WebSceneProp
    prop.routeIndex = routeIndex
    prop.nodeId = nodeId
    prop.ordinal = ordinal
    prop.propName = propName
    prop.propValue = propValue
    prop.valueKind = valueKind
    add(graph.props, prop)
    return true

fn WebSceneAddPropKnownLoadedNode(graph: var WebSceneGraph,
                                  routeIndex: int32,
                                  nodeId: int32,
                                  ordinal: int32,
                                  propName: str,
                                  propValue: str,
                                  valueKind: str): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0 || ordinal < 0:
        return false
    if propName.len == 0:
        return false
    var prop: WebSceneProp
    prop.routeIndex = routeIndex
    prop.nodeId = nodeId
    prop.ordinal = ordinal
    prop.propName = propName
    prop.propValue = propValue
    prop.valueKind = valueKind
    add(graph.props, prop)
    return true

fn WebSceneFindEventHandlerIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, ordinal: int32): int32 =
    for i in 0..<graph.eventHandlers.len:
        if graph.eventHandlers[i].routeIndex == routeIndex && graph.eventHandlers[i].nodeId == nodeId && graph.eventHandlers[i].ordinal == ordinal:
            return i
    return -1

@borrows
fn WebSceneAddEventHandler(graph: var WebSceneGraph,
                           routeIndex: int32,
                           nodeId: int32,
                           ordinal: int32,
                           propOrdinal: int32,
                           propName: str,
                           eventName: str,
                           handler: str,
                           valueKind: str): bool =
    return WebSceneAddEventHandlerWithAction(graph,
                                             routeIndex,
                                             nodeId,
                                             ordinal,
                                             propOrdinal,
                                             propName,
                                             eventName,
                                             handler,
                                             valueKind,
                                             "",
                                             "",
                                             "")

@borrows
fn WebSceneAddEventHandlerWithAction(graph: var WebSceneGraph,
                                     routeIndex: int32,
                                     nodeId: int32,
                                     ordinal: int32,
                                     propOrdinal: int32,
                                     propName: str,
                                     eventName: str,
                                     handler: str,
                                     valueKind: str,
                                     actionKind: str,
                                     stateRef: str,
                                     effect: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0 || propOrdinal < 0:
        return false
    if propName.len == 0 || eventName.len == 0:
        return false
    if WebSceneFindEventHandlerIndex(graph, routeIndex, nodeId, ordinal) >= 0:
        return false
    var eventHandler: WebSceneEventHandler
    eventHandler.routeIndex = routeIndex
    eventHandler.nodeId = nodeId
    eventHandler.ordinal = ordinal
    eventHandler.propOrdinal = propOrdinal
    # Borrowed inputs are cloned into owned values at the managed store sites.
    eventHandler.propName = strings.CloneStr(propName)
    eventHandler.eventName = strings.CloneStr(eventName)
    eventHandler.handler = strings.CloneStr(handler)
    eventHandler.valueKind = strings.CloneStr(valueKind)
    eventHandler.actionKind = strings.CloneStr(actionKind)
    eventHandler.stateRef = strings.CloneStr(stateRef)
    eventHandler.effect = strings.CloneStr(effect)
    add(graph.eventHandlers, eventHandler)
    WebSceneInvalidateInteractionIndex(graph)
    return true

fn WebSceneAddEventHandlerKnownLoadedNode(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          nodeId: int32,
                                          ordinal: int32,
                                          propOrdinal: int32,
                                          propName: str,
                                          eventName: str,
                                          handler: str,
                                          valueKind: str,
                                          actionKind: str,
                                          stateRef: str,
                                          effect: str): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0 || ordinal < 0 || propOrdinal < 0:
        return false
    if propName.len == 0 || eventName.len == 0:
        return false
    var eventHandler: WebSceneEventHandler
    eventHandler.routeIndex = routeIndex
    eventHandler.nodeId = nodeId
    eventHandler.ordinal = ordinal
    eventHandler.propOrdinal = propOrdinal
    eventHandler.propName = propName
    eventHandler.eventName = eventName
    eventHandler.handler = handler
    eventHandler.valueKind = valueKind
    eventHandler.actionKind = actionKind
    eventHandler.stateRef = stateRef
    eventHandler.effect = effect
    add(graph.eventHandlers, eventHandler)
    WebSceneInvalidateInteractionIndex(graph)
    return true

fn WebSceneFindHitTargetIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, ordinal: int32): int32 =
    for i in 0..<graph.hitTargets.len:
        if graph.hitTargets[i].routeIndex == routeIndex && graph.hitTargets[i].nodeId == nodeId && graph.hitTargets[i].ordinal == ordinal:
            return i
    return -1

fn WebSceneAddHitTarget(graph: var WebSceneGraph,
                        routeIndex: int32,
                        nodeId: int32,
                        ordinal: int32,
                        propOrdinal: int32,
                        targetKind: str,
                        actionName: str,
                        eventName: str,
                        targetRouteIndex: int32,
                        label: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0 || propOrdinal < -1:
        return false
    if targetKind.len == 0 || actionName.len == 0:
        return false
    if targetRouteIndex < -1 || targetRouteIndex >= graph.routes.len:
        return false
    if WebSceneFindHitTargetIndex(graph, routeIndex, nodeId, ordinal) >= 0:
        return false
    var hitTarget: WebSceneHitTarget
    hitTarget.routeIndex = routeIndex
    hitTarget.nodeId = nodeId
    hitTarget.ordinal = ordinal
    hitTarget.propOrdinal = propOrdinal
    hitTarget.targetKind = targetKind
    hitTarget.actionName = actionName
    hitTarget.eventName = eventName
    hitTarget.targetRouteIndex = targetRouteIndex
    hitTarget.label = label
    add(graph.hitTargets, hitTarget)
    return true

fn WebSceneAddHitTargetKnownLoadedNode(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       nodeId: int32,
                                       ordinal: int32,
                                       propOrdinal: int32,
                                       targetKind: str,
                                       actionName: str,
                                       eventName: str,
                                       targetRouteIndex: int32,
                                       label: str): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0 || ordinal < 0 || propOrdinal < -1:
        return false
    if targetKind.len == 0 || actionName.len == 0:
        return false
    if targetRouteIndex < -1 || targetRouteIndex >= graph.routes.len:
        return false
    var hitTarget: WebSceneHitTarget
    hitTarget.routeIndex = routeIndex
    hitTarget.nodeId = nodeId
    hitTarget.ordinal = ordinal
    hitTarget.propOrdinal = propOrdinal
    hitTarget.targetKind = targetKind
    hitTarget.actionName = actionName
    hitTarget.eventName = eventName
    hitTarget.targetRouteIndex = targetRouteIndex
    hitTarget.label = label
    add(graph.hitTargets, hitTarget)
    return true

fn WebSceneMediaAssetKindAllowed(kindCode: int32): bool =
    if kindCode == 1:
        return true
    if kindCode == 2:
        return true
    if kindCode == 3:
        return true
    return false

@borrows
fn WebSceneMediaControlActionAllowed(actionKind: str): bool =
    if actionKind == "OpenAsset":
        return true
    if actionKind == "Play":
        return true
    if actionKind == "Pause":
        return true
    if actionKind == "Seek":
        return true
    if actionKind == "ShareAsset":
        return true
    if actionKind == "EditAsset":
        return true
    if actionKind == "PublishAsset":
        return true
    return false

@borrows
fn WebSceneMediaActionKindCode(actionKind: str): int32 =
    if actionKind == "OpenAsset":
        return 1
    elif actionKind == "Play":
        return 2
    elif actionKind == "Pause":
        return 3
    elif actionKind == "Seek":
        return 4
    elif actionKind == "ShareAsset":
        return 5
    elif actionKind == "EditAsset":
        return 6
    elif actionKind == "PublishAsset":
        return 7
    elif actionKind == "LoadedMetadata":
        return 8
    elif actionKind == "Waiting":
        return 9
    elif actionKind == "Playing":
        return 10
    elif actionKind == "TimeUpdate":
        return 11
    elif actionKind == "Ended":
        return 12
    return 0

@borrows
fn WebSceneMediaControlActionAllowedForKind(kindCode: int32, actionKind: str): bool =
    if !WebSceneMediaControlActionAllowed(actionKind):
        return false
    if actionKind == "OpenAsset" || actionKind == "ShareAsset" || actionKind == "EditAsset" || actionKind == "PublishAsset":
        return true
    if kindCode == 1 || kindCode == 3:
        if actionKind == "Play":
            return true
        if actionKind == "Pause":
            return true
        if actionKind == "Seek":
            return true
        return false
    return false

@borrows
fn WebSceneMediaControlGuardMatchesAsset(guard: str, assetCid: str): bool =
    let prefix = "assetCid:"
    if !strings.HasPrefix(guard, prefix):
        return false
    if guard.len != prefix.len + assetCid.len:
        return false
    var i = 0
    while i < assetCid.len:
        if guard[prefix.len + i] != assetCid[i]:
            return false
        i = i + 1
    return true

@borrows
fn WebSceneLocalMediaSourceValid(source: str): bool =
    if strings.HasPrefix(source, "file://"):
        return source.len > "file://".len
    if strings.HasPrefix(source, "/"):
        return source.len > 1
    return false

@borrows
fn WebSceneMediaMimeMatchesKind(kindCode: int32, mime: str): bool =
    if kindCode == 1:
        return strings.HasPrefix(mime, "video/")
    if kindCode == 2:
        return strings.HasPrefix(mime, "image/")
    if kindCode == 3:
        return strings.HasPrefix(mime, "audio/")
    return false

@borrows
fn WebSceneFindMediaAssetIndex(graph: var WebSceneGraph, assetFactId: str): int32 =
    for i in 0..<graph.mediaAssets.len:
        if graph.mediaAssets[i].assetFactId == assetFactId:
            return i
    return -1

@borrows
fn WebSceneFindMediaPlaybackSlotIndex(graph: var WebSceneGraph, slotId: str): int32 =
    for i in 0..<graph.mediaPlaybackSlots.len:
        if graph.mediaPlaybackSlots[i].slotId == slotId:
            return i
    return -1

fn WebSceneFindMediaPlaybackSlotIndexForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    for i in 0..<graph.mediaPlaybackSlots.len:
        if graph.mediaPlaybackSlots[i].routeIndex == routeIndex &&
           graph.mediaPlaybackSlots[i].nodeId == nodeId:
            return i
    return -1

fn WebSceneFindMediaPlaybackSlotIndexForNodeOrAncestor(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    var current = nodeId
    while current > 0:
        let slotIndex = WebSceneFindMediaPlaybackSlotIndexForNode(graph, routeIndex, current)
        if slotIndex >= 0:
            return slotIndex
        current = WebSceneFindNodeParentId(graph, current)
    return -1

@borrows
fn WebScenePaintImageCoveredByMediaSurface(graph: var WebSceneGraph, sceneOp: WebScenePaintOp): bool =
    if sceneOp.opKind != WebScenePaintImage:
        return false
    return WebSceneFindMediaPlaybackSlotIndexForNodeOrAncestor(graph, sceneOp.routeIndex, sceneOp.nodeId) >= 0

@borrows
fn WebSceneFindMediaControlActionIndex(graph: var WebSceneGraph, slotId: str, actionKind: str): int32 =
    for i in 0..<graph.mediaControlActions.len:
        if graph.mediaControlActions[i].slotId == slotId && graph.mediaControlActions[i].actionKind == actionKind:
            return i
    return -1

@borrows
fn WebSceneMediaAssetValid(asset: WebSceneMediaAsset): bool =
    if asset.assetFactId.len == 0 || asset.assetCid.len == 0 || asset.bundleCid.len == 0:
        return false
    if asset.mime.len == 0 || asset.codec.len == 0 || asset.durationMs.len == 0:
        return false
    if !WebSceneMediaAssetKindAllowed(asset.kindCode):
        return false
    if asset.transport == "local-file":
        if !WebSceneLocalMediaSourceValid(asset.assetCid):
            return false
        if !WebSceneMediaMimeMatchesKind(asset.kindCode, asset.mime):
            return false
        if asset.posterCid.len == 0 || asset.initSegmentCid.len == 0 || asset.keyframeIndex.len == 0:
            return false
        return true
    if asset.transport != "moq":
        return false
    if asset.fecScheme.len == 0 || asset.contentSignature.len == 0:
        return false
    if asset.catalogCid.len == 0 || asset.catalogKey.len == 0:
        return false
    if asset.rebuildTemplateCid.len == 0 || asset.rebuildTemplateKey.len == 0:
        return false
    if asset.objectCount <= 0 || asset.dropletCount <= 0:
        return false
    if asset.objectTargetBytes <= 0 || asset.sourceBlockBytes <= 0:
        return false
    if asset.initSegmentByteLength <= 0:
        return false
    if asset.kindCode == 1:
        if !strings.HasPrefix(asset.mime, "video/"):
            return false
        if asset.posterCid.len == 0 || asset.initSegmentCid.len == 0 || asset.keyframeIndex.len == 0:
            return false
    elif asset.kindCode == 2:
        if !strings.HasPrefix(asset.mime, "image/"):
            return false
        if asset.posterCid.len == 0 || asset.initSegmentCid.len == 0 || asset.keyframeIndex.len == 0:
            return false
    elif asset.kindCode == 3:
        if !strings.HasPrefix(asset.mime, "audio/"):
            return false
        if asset.posterCid.len == 0 || asset.initSegmentCid.len == 0 || asset.keyframeIndex.len == 0:
            return false
    return true

fn WebSceneAddMediaAsset(graph: var WebSceneGraph, asset: WebSceneMediaAsset): bool =
    if !WebSceneMediaAssetValid(asset):
        return false
    if WebSceneFindMediaAssetIndex(graph, asset.assetFactId) >= 0:
        return false
    add(graph.mediaAssets, asset)
    return true

@borrows
fn WebSceneAddMediaPlaybackSlot(graph: var WebSceneGraph, slot: WebSceneMediaPlaybackSlot): bool =
    if slot.slotId.len == 0 || slot.assetFactId.len == 0 || slot.assetCid.len == 0 || slot.manifestCid.len == 0:
        return false
    if slot.nodeTemplate.len == 0 || slot.stateRef.len == 0:
        return false
    if slot.providerKind != "media-decode-provider":
        return false
    if slot.decodeProvider.len == 0 || slot.textureProvider.len == 0 || slot.audioProvider.len == 0:
        return false
    if WebSceneMediaSurfaceObjectFitHostCode(slot.objectFit) <= 0:
        return false
    let assetIndex = WebSceneFindMediaAssetIndex(graph, slot.assetFactId)
    if assetIndex < 0:
        return false
    if graph.mediaAssets[assetIndex].assetCid != slot.assetCid:
        return false
    if !WebSceneNodeBelongsToRoute(graph, slot.routeIndex, slot.nodeId):
        return false
    if WebSceneFindMediaPlaybackSlotIndex(graph, slot.slotId) >= 0:
        return false
    var stored: WebSceneMediaPlaybackSlot
    stored.slotId = slot.slotId
    stored.assetFactId = slot.assetFactId
    stored.assetCid = slot.assetCid
    stored.manifestCid = slot.manifestCid
    stored.nodeTemplate = slot.nodeTemplate
    stored.routeIndex = slot.routeIndex
    stored.nodeId = slot.nodeId
    stored.providerKind = slot.providerKind
    stored.stateRef = slot.stateRef
    stored.decodeProvider = slot.decodeProvider
    stored.textureProvider = slot.textureProvider
    stored.audioProvider = slot.audioProvider
    stored.objectFit = slot.objectFit
    stored.peerHost = slot.peerHost
    stored.peerPort = slot.peerPort
    stored.playbackState = WebSceneMediaPlaybackClosed
    stored.seekPositionMs = 0
    add(graph.mediaPlaybackSlots, stored)
    return true

@borrows
fn WebSceneRefreshMediaControlGuardsForSlot(graph: var WebSceneGraph, slotId: str, assetCid: str): bool =
    if slotId.len == 0 || assetCid.len == 0:
        return false
    let nextGuard = Fmt"assetCid:{assetCid}"
    for i in 0..<graph.mediaControlActions.len:
        if graph.mediaControlActions[i].slotId == slotId:
            graph.mediaControlActions[i].guard = WebSceneCloneStateString(nextGuard)
    return true

@borrows
fn WebSceneUpdateLocalMediaPlaybackSlot(graph: var WebSceneGraph,
                                        slotId: str,
                                        sourceUri: str,
                                        mime: str,
                                        kindCode: int32): bool =
    if slotId.len == 0 || !WebSceneLocalMediaSourceValid(sourceUri):
        return false
    if !WebSceneMediaAssetKindAllowed(kindCode) || !WebSceneMediaMimeMatchesKind(kindCode, mime):
        return false
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, slotId)
    if slotIndex < 0:
        return false
    let assetIndex = WebSceneFindMediaAssetIndex(graph, graph.mediaPlaybackSlots[slotIndex].assetFactId)
    if assetIndex < 0:
        return false
    if graph.mediaAssets[assetIndex].kindCode != kindCode:
        return false
    let sameIdentity = graph.mediaPlaybackSlots[slotIndex].assetCid == sourceUri &&
                       graph.mediaAssets[assetIndex].assetCid == sourceUri &&
                       graph.mediaAssets[assetIndex].mime == mime &&
                       graph.mediaAssets[assetIndex].kindCode == kindCode
    graph.mediaAssets[assetIndex].assetCid = sourceUri
    graph.mediaAssets[assetIndex].bundleCid = "local-file"
    graph.mediaAssets[assetIndex].mime = mime
    graph.mediaAssets[assetIndex].kindCode = kindCode
    graph.mediaAssets[assetIndex].durationMs = "0"
    graph.mediaAssets[assetIndex].codec = "local-file"
    graph.mediaAssets[assetIndex].posterCid = sourceUri
    graph.mediaAssets[assetIndex].initSegmentCid = "local-file"
    graph.mediaAssets[assetIndex].initSegmentByteLength = 1
    graph.mediaAssets[assetIndex].keyframeIndex = "local-file"
    graph.mediaAssets[assetIndex].transport = "local-file"
    graph.mediaAssets[assetIndex].fecScheme = "local-file"
    graph.mediaAssets[assetIndex].contentSignature = "local-file"
    graph.mediaAssets[assetIndex].catalogCid = "local-file"
    graph.mediaAssets[assetIndex].catalogKey = "local-file"
    graph.mediaAssets[assetIndex].rebuildTemplateCid = "local-file"
    graph.mediaAssets[assetIndex].rebuildTemplateKey = "local-file"
    graph.mediaAssets[assetIndex].objectTargetBytes = 1
    graph.mediaAssets[assetIndex].sourceBlockBytes = 1
    graph.mediaAssets[assetIndex].objectCount = 1
    graph.mediaAssets[assetIndex].dropletCount = 1
    if !WebSceneMediaAssetValid(graph.mediaAssets[assetIndex]):
        return false
    graph.mediaPlaybackSlots[slotIndex].assetCid = sourceUri
    graph.mediaPlaybackSlots[slotIndex].manifestCid = "local-file"
    if !sameIdentity:
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackOpened
    if !WebSceneRefreshMediaControlGuardsForSlot(graph, slotId, sourceUri):
        return false
    return true

fn WebSceneAddMediaControlAction(graph: var WebSceneGraph, control: WebSceneMediaControlAction): bool =
    if control.slotId.len == 0 || control.actionKind.len == 0 || control.payloadSchema.len == 0:
        return false
    if control.dispatch != "event-queue":
        return false
    if control.guard.len == 0 || control.trace.len == 0:
        return false
    if !WebSceneMediaControlActionAllowed(control.actionKind):
        return false
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, control.slotId)
    if slotIndex < 0:
        return false
    let assetIndex = WebSceneFindMediaAssetIndex(graph, graph.mediaPlaybackSlots[slotIndex].assetFactId)
    if assetIndex < 0:
        return false
    if !WebSceneMediaControlGuardMatchesAsset(control.guard, graph.mediaAssets[assetIndex].assetCid):
        return false
    if !WebSceneMediaControlActionAllowedForKind(graph.mediaAssets[assetIndex].kindCode, control.actionKind):
        return false
    if WebSceneFindMediaControlActionIndex(graph, control.slotId, control.actionKind) >= 0:
        return false
    add(graph.mediaControlActions, control)
    return true

@borrows
fn WebSceneMediaSlotPlaybackState(graph: var WebSceneGraph, slotId: str): int32 =
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, slotId)
    if slotIndex < 0:
        return -1
    return graph.mediaPlaybackSlots[slotIndex].playbackState

# S6: read accessor for seekPositionMs, mirroring WebSceneMediaSlotPlaybackState above.
@borrows
fn WebSceneMediaSlotSeekPositionMs(graph: var WebSceneGraph, slotId: str): int32 =
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, slotId)
    if slotIndex < 0:
        return -1
    return graph.mediaPlaybackSlots[slotIndex].seekPositionMs

fn WebSceneHasActiveRouteMediaPlayback(graph: var WebSceneGraph): bool =
    if graph.activeRouteIndex < 0:
        return false
    for i in 0..<graph.mediaPlaybackSlots.len:
        let slot = graph.mediaPlaybackSlots[i]
        if slot.routeIndex == graph.activeRouteIndex:
            if slot.playbackState == WebSceneMediaPlaybackPlaying ||
               slot.playbackState == WebSceneMediaPlaybackSeeked:
                return true
    return false

fn WebSceneMediaReceiptAssetCidAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaReceipts.len:
        return ""
    return graph.mediaReceipts[index].assetCid

fn WebSceneMediaReceiptKindCodeAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaReceipts.len:
        return 0
    return graph.mediaReceipts[index].kindCode

fn WebSceneMediaReceiptStatusCodeAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaReceipts.len:
        return 0
    return graph.mediaReceipts[index].statusCode

fn WebSceneMediaReceiptPlaybackStateAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaReceipts.len:
        return -1
    return graph.mediaReceipts[index].playbackState

fn WebSceneMediaReceiptActionKindAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaReceipts.len:
        return ""
    return graph.mediaReceipts[index].actionKind

fn WebSceneMediaReceiptActionKindCodeAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaReceipts.len:
        return 0
    return WebSceneMediaActionKindCode(graph.mediaReceipts[index].actionKind)

fn WebSceneMediaReceiptTraceAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaReceipts.len:
        return ""
    return graph.mediaReceipts[index].trace

fn WebSceneMediaReceiptAudioProviderAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaReceipts.len:
        return ""
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, graph.mediaReceipts[index].slotId)
    if slotIndex < 0:
        return ""
    return graph.mediaPlaybackSlots[slotIndex].audioProvider

fn WebSceneMediaReceiptAudioProviderHashAt(graph: var WebSceneGraph, index: int32): int32 =
    let audioProvider = WebSceneMediaReceiptAudioProviderAt(graph, index)
    if len(audioProvider) <= 0:
        return -1
    return WebSceneResourceIdHash31(audioProvider)

fn WebSceneMediaLifecycleEventKindAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return ""
    return graph.mediaLifecycleEvents[index].eventKind

fn WebSceneMediaLifecycleEventAssetCidAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return ""
    return graph.mediaLifecycleEvents[index].assetCid

fn WebSceneMediaLifecycleEventPayloadAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return ""
    return graph.mediaLifecycleEvents[index].payload

fn WebSceneMediaLifecycleEventReceiptIndexAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return -1
    return graph.mediaLifecycleEvents[index].receiptIndex

fn WebSceneMediaLifecycleEventResultStateCodeAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return -1
    return graph.mediaLifecycleEvents[index].resultStateCode

fn WebSceneMediaLifecycleEventObjectCountAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return -1
    return graph.mediaLifecycleEvents[index].objectCount

fn WebSceneMediaLifecycleEventDropletCountAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return -1
    return graph.mediaLifecycleEvents[index].dropletCount

@borrows
fn WebSceneAppendMediaReceipt(graph: var WebSceneGraph, slotId: str, actionKind: str, assetCid: str, kindCode: int32, playbackState: int32, trace: str): bool =
    var receipt: WebSceneMediaEventReceipt
    receipt.slotId = WebSceneCloneStateString(slotId)
    receipt.actionKind = WebSceneCloneStateString(actionKind)
    receipt.assetCid = WebSceneCloneStateString(assetCid)
    receipt.kindCode = kindCode
    receipt.statusCode = WebSceneMediaReceiptOk
    receipt.playbackState = playbackState
    receipt.trace = WebSceneCloneStateString(trace)
    add(graph.mediaReceipts, receipt)
    return true

@borrows
fn WebSceneMediaLifecycleAction(actionKind: str): bool =
    if actionKind == "OpenAsset":
        return true
    if actionKind == "EditAsset":
        return true
    if actionKind == "PublishAsset":
        return true
    if actionKind == "LoadedMetadata":
        return true
    if actionKind == "Waiting":
        return true
    if actionKind == "Playing":
        return true
    if actionKind == "TimeUpdate":
        return true
    if actionKind == "Ended":
        return true
    return false

@borrows
fn WebSceneMediaDomLifecycleEvent(actionKind: str): bool =
    if actionKind == "LoadedMetadata":
        return true
    if actionKind == "Waiting":
        return true
    if actionKind == "Playing":
        return true
    if actionKind == "TimeUpdate":
        return true
    if actionKind == "Ended":
        return true
    return false

@borrows
fn WebSceneMediaDomLifecycleResultState(currentState: int32, actionKind: str): int32 =
    if actionKind == "LoadedMetadata":
        if currentState == WebSceneMediaPlaybackClosed:
            return WebSceneMediaPlaybackOpened
        return currentState
    if actionKind == "Playing":
        return WebSceneMediaPlaybackPlaying
    if actionKind == "Ended":
        return WebSceneMediaPlaybackPaused
    if currentState == WebSceneMediaPlaybackClosed:
        return WebSceneMediaPlaybackOpened
    return currentState

@borrows
fn WebSceneAppendMediaLifecycleEvent(graph: var WebSceneGraph,
                                     receiptIndex: int32,
                                     eventKind: str,
                                     slot: WebSceneMediaPlaybackSlot,
                                     asset: WebSceneMediaAsset,
                                     control: WebSceneMediaControlAction,
                                     payload: str,
                                     sourceStateCode: int32,
                                     resultStateCode: int32): bool =
    if receiptIndex < 0 || receiptIndex >= graph.mediaReceipts.len:
        return false
    if !WebSceneMediaLifecycleAction(eventKind):
        return false
    if control.payloadSchema.len == 0:
        return false
    if eventKind == "EditAsset" || eventKind == "PublishAsset":
        if payload.len == 0:
            return false
    var event: WebSceneMediaLifecycleEvent
    event.receiptIndex = receiptIndex
    event.eventKind = eventKind
    event.slotId = slot.slotId
    event.assetCid = asset.assetCid
    event.bundleCid = asset.bundleCid
    event.manifestCid = slot.manifestCid
    event.kindCode = asset.kindCode
    event.payloadSchema = control.payloadSchema
    event.payload = payload
    event.dispatch = control.dispatch
    event.guard = control.guard
    event.sourceStateCode = sourceStateCode
    event.resultStateCode = resultStateCode
    event.statusCode = WebSceneMediaReceiptOk
    event.trace = control.trace
    if eventKind == "OpenAsset":
        if payload.len != 0:
            return false
        if asset.transport == "moq":
            if asset.objectCount <= 0 || asset.dropletCount <= 0:
                return false
            event.payload = slot.manifestCid
            event.transport = asset.transport
            event.objectCount = asset.objectCount
            event.dropletCount = asset.dropletCount
        elif asset.transport == "local-file":
            if !WebSceneLocalMediaSourceValid(asset.assetCid):
                return false
            event.payload = asset.assetCid
            event.transport = asset.transport
            event.objectCount = 1
            event.dropletCount = 1
        else:
            return false
    elif eventKind == "PublishAsset":
        if payload != asset.assetCid:
            return false
        if asset.transport != "moq":
            return false
        if asset.objectCount <= 0 || asset.dropletCount <= 0:
            return false
        event.transport = asset.transport
        event.objectCount = asset.objectCount
        event.dropletCount = asset.dropletCount
    else:
        event.transport = ""
        event.objectCount = 0
        event.dropletCount = 0
    add(graph.mediaLifecycleEvents, event)
    return true

# Parse a Seek payload/effect-segment value into a millisecond target: base-10 digits
# only, no sign and no decimal point (a seek target is always a non-negative millisecond
# offset) — same digit-accumulation shape as WebSceneParseCssNumberPermilleRange above,
# narrowed to the integer case this call site actually needs.
@borrows
fn WebSceneParseMediaSeekPositionMs(value: str, out: var int32): bool =
    out = 0
    if value.len == 0:
        return false
    var index: int32
    var digits: int32
    while index < value.len && value[index] >= '0' && value[index] <= '9':
        out = out * 10 + (int32(value[index]) - int32('0'))
        digits = digits + 1
        index = index + 1
    if index != value.len || digits == 0:
        return false
    return true

@borrows
fn WebSceneApplyMediaControlWithPayload(graph: var WebSceneGraph, slotId: str, actionKind: str, payload: str): bool =
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, slotId)
    if slotIndex < 0:
        return false
    let controlIndex = WebSceneFindMediaControlActionIndex(graph, slotId, actionKind)
    if controlIndex < 0:
        return false
    let assetIndex = WebSceneFindMediaAssetIndex(graph, graph.mediaPlaybackSlots[slotIndex].assetFactId)
    if assetIndex < 0:
        return false
    if !WebSceneMediaControlActionAllowedForKind(graph.mediaAssets[assetIndex].kindCode, actionKind):
        return false
    if actionKind == "OpenAsset":
        if payload.len != 0:
            return false
    elif actionKind == "EditAsset":
        if payload.len == 0:
            return false
    elif actionKind == "PublishAsset":
        if payload != graph.mediaAssets[assetIndex].assetCid:
            return false
    let previousState = graph.mediaPlaybackSlots[slotIndex].playbackState
    if actionKind == "OpenAsset":
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackOpened
    elif actionKind == "Play":
        if graph.mediaPlaybackSlots[slotIndex].playbackState == WebSceneMediaPlaybackClosed:
            return false
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackPlaying
    elif actionKind == "Pause":
        if graph.mediaPlaybackSlots[slotIndex].playbackState == WebSceneMediaPlaybackClosed:
            return false
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackPaused
    elif actionKind == "Seek":
        if graph.mediaPlaybackSlots[slotIndex].playbackState == WebSceneMediaPlaybackClosed:
            return false
        # payload is optional (existing no-payload callers keep triggering the bare state
        # transition below); a non-empty payload must be a valid ms target — a malformed
        # one fails the whole call instead of silently discarding it.
        if payload.len > 0:
            var seekMs: int32
            if !WebSceneParseMediaSeekPositionMs(payload, seekMs):
                return false
            graph.mediaPlaybackSlots[slotIndex].seekPositionMs = seekMs
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackSeeked
    elif actionKind == "ShareAsset":
        if graph.mediaPlaybackSlots[slotIndex].playbackState == WebSceneMediaPlaybackClosed:
            return false
    elif actionKind == "EditAsset":
        if graph.mediaPlaybackSlots[slotIndex].playbackState == WebSceneMediaPlaybackClosed:
            return false
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackEdited
    elif actionKind == "PublishAsset":
        if graph.mediaPlaybackSlots[slotIndex].playbackState == WebSceneMediaPlaybackClosed:
            return false
        graph.mediaPlaybackSlots[slotIndex].playbackState = WebSceneMediaPlaybackPublished
    else:
        return false
    if !WebSceneAppendMediaReceipt(graph,
                                   slotId,
                                   actionKind,
                                   graph.mediaAssets[assetIndex].assetCid,
                                   graph.mediaAssets[assetIndex].kindCode,
                                   graph.mediaPlaybackSlots[slotIndex].playbackState,
                                   graph.mediaControlActions[controlIndex].trace):
        return false
    if WebSceneMediaLifecycleAction(actionKind):
        return WebSceneAppendMediaLifecycleEvent(graph,
                                                graph.mediaReceipts.len - 1,
                                                actionKind,
                                                graph.mediaPlaybackSlots[slotIndex],
                                                graph.mediaAssets[assetIndex],
                                                graph.mediaControlActions[controlIndex],
                                                payload,
                                                previousState,
                                                graph.mediaPlaybackSlots[slotIndex].playbackState)
    return true

@borrows
fn WebSceneApplyMediaControl(graph: var WebSceneGraph, slotId: str, actionKind: str): bool =
    if actionKind == "EditAsset" || actionKind == "PublishAsset":
        return false
    return WebSceneApplyMediaControlWithPayload(graph, slotId, actionKind, "")

@borrows
fn WebSceneApplyMediaControlForNode(graph: var WebSceneGraph,
                                    routeIndex: int32,
                                    nodeId: int32,
                                    actionKind: str,
                                    markDirty: bool): int32 =
    let slotIndex = WebSceneFindMediaPlaybackSlotIndexForNodeOrAncestor(graph, routeIndex, nodeId)
    if slotIndex < 0:
        return -1
    let slotNodeId = graph.mediaPlaybackSlots[slotIndex].nodeId
    let previousState = graph.mediaPlaybackSlots[slotIndex].playbackState
    if !WebSceneApplyMediaControl(graph, graph.mediaPlaybackSlots[slotIndex].slotId, actionKind):
        return -1
    if markDirty && previousState != graph.mediaPlaybackSlots[slotIndex].playbackState:
        if !WebSceneMarkDirtySubtree(graph, slotNodeId):
            return -1
    return 1

# S6: same shape as WebSceneApplyMediaControlForNode above, but resolves the slot by an
# EXPLICIT slotId instead of walking up from (routeIndex, nodeId) — a drag-handle/progress
# control is typically a SIBLING of the media node in the DOM tree (a controls overlay),
# not a descendant, so WebSceneFindMediaPlaybackSlotIndexForNodeOrAncestor would miss it —
# and forwards payload (the Seek ms target) through to WithPayload instead of the bare
# no-payload wrapper.
@borrows
fn WebSceneApplyMediaControlForSlotWithPayload(graph: var WebSceneGraph,
                                               slotId: str,
                                               actionKind: str,
                                               payload: str,
                                               markDirty: bool): int32 =
    let slotIndex = WebSceneFindMediaPlaybackSlotIndex(graph, slotId)
    if slotIndex < 0:
        return -1
    let slotNodeId = graph.mediaPlaybackSlots[slotIndex].nodeId
    let previousState = graph.mediaPlaybackSlots[slotIndex].playbackState
    if !WebSceneApplyMediaControlWithPayload(graph, slotId, actionKind, payload):
        return -1
    if markDirty && previousState != graph.mediaPlaybackSlots[slotIndex].playbackState:
        if !WebSceneMarkDirtySubtree(graph, slotNodeId):
            return -1
    return 1

@borrows
fn WebSceneApplyMediaLifecycleEventForNode(graph: var WebSceneGraph,
                                           routeIndex: int32,
                                           nodeId: int32,
                                           actionKind: str,
                                           markDirty: bool): int32 =
    if !WebSceneMediaDomLifecycleEvent(actionKind):
        return -1
    let slotIndex = WebSceneFindMediaPlaybackSlotIndexForNodeOrAncestor(graph, routeIndex, nodeId)
    if slotIndex < 0:
        return -1
    let assetIndex = WebSceneFindMediaAssetIndex(graph, graph.mediaPlaybackSlots[slotIndex].assetFactId)
    if assetIndex < 0:
        return -1
    if graph.mediaAssets[assetIndex].kindCode != 1 && graph.mediaAssets[assetIndex].kindCode != 3:
        return -1
    let previousState = graph.mediaPlaybackSlots[slotIndex].playbackState
    let resultState = WebSceneMediaDomLifecycleResultState(previousState, actionKind)
    graph.mediaPlaybackSlots[slotIndex].playbackState = resultState
    let actionKindForTrace = WebSceneCloneStateString(actionKind)
    let trace = Fmt"dom:{routeIndex}:{nodeId}:{actionKindForTrace}"
    if !WebSceneAppendMediaReceipt(graph,
                                   graph.mediaPlaybackSlots[slotIndex].slotId,
                                   actionKind,
                                   graph.mediaAssets[assetIndex].assetCid,
                                   graph.mediaAssets[assetIndex].kindCode,
                                   resultState,
                                   trace):
        return -1
    var control: WebSceneMediaControlAction
    control.slotId = graph.mediaPlaybackSlots[slotIndex].slotId
    control.actionKind = WebSceneCloneStateString(actionKind)
    control.payloadSchema = "unimaker.media.dom.lifecycle.runtime.v1"
    control.dispatch = "event-queue"
    control.guard = Fmt"assetCid:{graph.mediaAssets[assetIndex].assetCid}"
    control.trace = trace
    if !WebSceneAppendMediaLifecycleEvent(graph,
                                          graph.mediaReceipts.len - 1,
                                          actionKind,
                                          graph.mediaPlaybackSlots[slotIndex],
                                          graph.mediaAssets[assetIndex],
                                          control,
                                          Fmt"dom:{actionKind}",
                                          previousState,
                                          resultState):
        return -1
    if markDirty && previousState != resultState:
        if !WebSceneMarkDirtySubtree(graph, nodeId):
            return -1
    return 1

fn WebSceneMediaSurfaceCommandBufferInit(buffer: var WebSceneMediaSurfaceCommandBuffer) =
    buffer.routeIndex = -1
    buffer.commands = []

@borrows
fn WebSceneMediaSurfaceKindForAsset(asset: WebSceneMediaAsset): str =
    if asset.kindCode == 1:
        return "video-first-frame-texture"
    if asset.kindCode == 2:
        return "image-raster-texture"
    if asset.kindCode == 3:
        return "audio-cover-texture"
    return ""

fn WebSceneAppendMediaSurfaceCommandForSlot(graph: var WebSceneGraph,
                                            slotIndex: int32,
                                            buffer: var WebSceneMediaSurfaceCommandBuffer): bool =
    if slotIndex < 0 || slotIndex >= graph.mediaPlaybackSlots.len:
        return false
    let slot = graph.mediaPlaybackSlots[slotIndex]
    if slot.routeIndex != buffer.routeIndex:
        return true
    let assetIndex = WebSceneFindMediaAssetIndex(graph, slot.assetFactId)
    if assetIndex < 0:
        return true
    let asset = graph.mediaAssets[assetIndex]
    if asset.assetCid != slot.assetCid:
        return true
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, slot.routeIndex, slot.nodeId)
    if boxIndex < 0:
        return true
    let box = graph.layoutBoxes[boxIndex]
    if !box.visible || box.width <= 0 || box.height <= 0:
        return true
    let layerId = WebSceneFindNodeLayerId(graph, slot.nodeId)
    if layerId < 0:
        return true
    let surfaceKind = WebSceneMediaSurfaceKindForAsset(asset)
    if surfaceKind.len == 0:
        return true
    var command: WebSceneMediaSurfaceCommand
    command.slotId = slot.slotId
    command.assetCid = asset.assetCid
    command.manifestCid = slot.manifestCid
    command.posterCid = asset.posterCid
    command.kindCode = asset.kindCode
    command.routeIndex = slot.routeIndex
    command.nodeId = slot.nodeId
    command.layerId = layerId
    command.x = box.x
    command.y = box.y
    command.width = box.width
    command.height = box.height
    command.playbackState = graph.mediaPlaybackSlots[slotIndex].playbackState
    command.surfaceKind = surfaceKind
    command.decodeProvider = slot.decodeProvider
    command.textureProvider = slot.textureProvider
    command.audioProvider = slot.audioProvider
    command.objectFit = slot.objectFit
    command.peerHost = slot.peerHost
    command.peerPort = slot.peerPort
    if asset.kindCode == 1:
        wsVideoCmdAddedTotal = wsVideoCmdAddedTotal + 1
        wsVideoCmdLastNode = slot.nodeId
    add(buffer.commands, command)
    return true

fn WebSceneBuildRouteMediaSurfaceCommands(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          buffer: var WebSceneMediaSurfaceCommandBuffer): bool =
    WebSceneMediaSurfaceCommandBufferInit(buffer)
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if graph.activeRouteIndex != routeIndex:
        return false
    if !WebSceneRouteHasRuntimeLayoutBox(graph, routeIndex):
        return false
    buffer.routeIndex = routeIndex
    for i in 0..<graph.mediaPlaybackSlots.len:
        if !WebSceneAppendMediaSurfaceCommandForSlot(graph, i, buffer):
            return false
    return true

fn WebSceneBuildActiveRouteMediaSurfaceCommands(graph: var WebSceneGraph,
                                                buffer: var WebSceneMediaSurfaceCommandBuffer): bool =
    if graph.activeRouteIndex < 0:
        return false
    return WebSceneBuildRouteMediaSurfaceCommands(graph, graph.activeRouteIndex, buffer)

fn WebSceneAppendMediaSurfaceGpuCommandsForNode(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                nodeId: int32,
                                                layerId: int32,
                                                commands: var WebSceneGpuCommand[]): bool =
    if graph.activeRouteIndex != routeIndex:
        return true
    for slotIndex in 0..<graph.mediaPlaybackSlots.len:
        let slot = graph.mediaPlaybackSlots[slotIndex]
        if slot.routeIndex != routeIndex || slot.nodeId != nodeId:
            continue
        let assetIndex = WebSceneFindMediaAssetIndex(graph, slot.assetFactId)
        if assetIndex < 0:
            return false
        let asset = graph.mediaAssets[assetIndex]
        if asset.assetCid != slot.assetCid:
            return false
        let surfaceKind = WebSceneMediaSurfaceKindForAsset(asset)
        if surfaceKind.len == 0:
            continue
        let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, slot.routeIndex, slot.nodeId)
        if boxIndex < 0:
            continue
        let box = graph.layoutBoxes[boxIndex]
        if !box.visible || box.width <= 0 || box.height <= 0:
            continue
        let surfaceKindCode = WebSceneMediaSurfaceKindHostCode(surfaceKind)
        let textureProviderCode = WebSceneMediaSurfaceTextureProviderHostCode(slot.textureProvider)
        let objectFitCode = WebSceneMediaSurfaceObjectFitHostCode(slot.objectFit)
        if surfaceKindCode <= 0 || surfaceKindCode != asset.kindCode || textureProviderCode <= 0 || objectFitCode <= 0:
            return false
        let slotHash = WebSceneResourceIdHash31(slot.slotId)
        let assetHash = WebSceneResourceIdHash31(asset.assetCid)
        let manifestHash = WebSceneResourceIdHash31(slot.manifestCid)
        let posterHash = WebSceneResourceIdHash31(asset.posterCid)
        if slotHash <= 0 || assetHash <= 0 || manifestHash <= 0 || posterHash <= 0:
            return false
        var command: WebSceneGpuCommand
        command.routeIndex = routeIndex
        command.layerId = layerId
        command.kind = WebSceneGpuDrawMediaSurface
        command.x = box.x
        command.y = box.y
        command.width = box.width
        command.height = box.height
        command.color = 0
        command.imageId = slotHash
        command.iconKind = assetHash
        command.iconPrimitiveCount = manifestHash
        command.svgDisplayListId = posterHash
        command.fontAtlasId = asset.kindCode
        command.glyphRunId = surfaceKindCode
        command.glyphRunGlyphCount = textureProviderCode
        command.glyphSdfAtlasId = objectFitCode
        command.rotationDeg = slot.playbackState
        command.textContent = ""
        if !WebSceneGpuCommandHostFieldsValid(command):
            return false
        add(commands, command)
    return true

var wsVideoCmdAddedTotal: int32
var wsVideoCmdLastNode: int32 = -1
fn WebSceneVideoCmdAddedTotal(): int32 = wsVideoCmdAddedTotal
fn WebSceneVideoCmdLastNode(): int32 = wsVideoCmdLastNode

# --- #31 诊断(只读,镜像 WebSceneAppendMediaSurfaceCommandForSlot 守卫) ---
# 返回 active route 上第一个视频 slot(kindCode==1)卡在哪个守卫:
# 0=会合成 / 2370 路由不符 / 2376 cid 失配 / 2380 找不到 box / 2382 box 不可见 / 2384 无 layer
# -10 无 active route / -20 无视频 slot
fn WebSceneMediaActiveVideoSlotGuard(graph: var WebSceneGraph): int32 =
    if graph.activeRouteIndex < 0:
        return -10
    for i in 0..<graph.mediaPlaybackSlots.len:
        let slot = graph.mediaPlaybackSlots[i]
        let assetIndex = WebSceneFindMediaAssetIndex(graph, slot.assetFactId)
        if assetIndex < 0:
            continue
        let asset = graph.mediaAssets[assetIndex]
        if asset.kindCode != 1:
            continue
        if slot.routeIndex != graph.activeRouteIndex:
            return 2370
        if asset.assetCid != slot.assetCid:
            return 2376
        let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, slot.routeIndex, slot.nodeId)
        if boxIndex < 0:
            return 2380
        let box = graph.layoutBoxes[boxIndex]
        if !box.visible || box.width <= 0 || box.height <= 0:
            return 2382
        let layerId = WebSceneFindNodeLayerId(graph, slot.nodeId)
        if layerId < 0:
            return 2384
        return 0
    return -20

fn WebSceneMediaActiveVideoSlotNode(graph: var WebSceneGraph): int32 =
    if graph.activeRouteIndex < 0:
        return -1
    for i in 0..<graph.mediaPlaybackSlots.len:
        let slot = graph.mediaPlaybackSlots[i]
        let assetIndex = WebSceneFindMediaAssetIndex(graph, slot.assetFactId)
        if assetIndex < 0:
            continue
        if graph.mediaAssets[assetIndex].kindCode != 1:
            continue
        return slot.nodeId
    return -1

fn WebSceneMediaPlaybackSlotCountAll(graph: var WebSceneGraph): int32 =
    return graph.mediaPlaybackSlots.len

fn WebSceneMediaActiveRouteIndex(graph: var WebSceneGraph): int32 =
    return graph.activeRouteIndex

fn WebSceneMediaSurfaceCommandCount(buffer: var WebSceneMediaSurfaceCommandBuffer): int32 =
    return buffer.commands.len

@borrows
fn WebSceneFindMediaSurfaceCommandIndex(buffer: var WebSceneMediaSurfaceCommandBuffer, slotId: str): int32 =
    if slotId.len == 0:
        return -1
    for i in 0..<buffer.commands.len:
        if buffer.commands[i].slotId == slotId:
            return i
    return -1

fn WebSceneMediaSurfaceSlotIdAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
        return ""
    return buffer.commands[index].slotId

fn WebSceneMediaSurfaceAssetCidAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
        return ""
    return buffer.commands[index].assetCid

fn WebSceneMediaSurfaceManifestCidAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
        return ""
    return buffer.commands[index].manifestCid

fn WebSceneMediaSurfacePosterCidAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
        return ""
    return buffer.commands[index].posterCid

fn WebSceneMediaSurfaceKindCodeAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return 0
    return buffer.commands[index].kindCode

fn WebSceneMediaSurfaceNodeIdAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
