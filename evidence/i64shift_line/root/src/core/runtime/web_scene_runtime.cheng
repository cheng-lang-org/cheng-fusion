        paintShadowEndByNodeId: int32[]
        paintGradientStartByNodeId: int32[]
        paintGradientEndByNodeId: int32[]
        paintSvgPrimitives: WebScenePaintSvgPrimitive[]
        paintSvgPrimitiveStartByNodeId: int32[]
        paintSvgPrimitiveEndByNodeId: int32[]
        layoutBoxes: WebSceneLayoutBox[]
        routeEdges: WebSceneRouteEdge[]
        layerCaches: WebSceneLayerCache[]
        dirtySpans: WebSceneDirtySpan[]
        nodeParentById: int32[]
        nodeRouteById: int32[]
        nodeIndexById: int32[]
        nodeNonRenderedById: int32[]
        nodeDisplayNoneById: int32[]
        activeRouteIndex: int32
        currentViewportWidth: int32
        currentViewportHeight: int32
        version: int32
        stateVersion: int32
        # K1 interaction index: route edges + click handlers merged into one
        # (routeIndex,nodeId)-sorted table for binary-search ancestor walks;
        # box route ranges bound hit scans to the active route. Each index is
        # invalidated only by its own topology mutations; paint/style dirtiness
        # does not change these tables.
        interactionRouteIds: int32[]
        interactionNodeIds: int32[]
        interactionKinds: int32[]
        interactionPayloads: int32[]
        interactionVersion: int32
        boxRangeRouteIds: int32[]
        boxRangeStarts: int32[]
        boxRangeEnds: int32[]
        boxRangeVersion: int32
        # K2 event-handler index: all handlers keyed by (routeIndex,nodeId),
        # stable by handler index, for O(log n) event dispatch on any eventName.
        eventHandlerIndexRouteIds: int32[]
        eventHandlerIndexNodeIds: int32[]
        eventHandlerIndexHandlerIds: int32[]
        eventHandlerIndexVersion: int32
        # K3 text-input node index: deduped (routeIndex,nodeId) set of nodes
        # whose handlers accept text input, sorted by route, for descendant search.
        textInputRouteIds: int32[]
        textInputNodeIds: int32[]
        textInputNodeVersion: int32

    WebSceneGraphCapacityPlan =
        routes: int32
        layers: int32
        nodes: int32
        props: int32
        eventHandlers: int32
        hitTargets: int32
        mediaAssets: int32
        mediaPlaybackSlots: int32
