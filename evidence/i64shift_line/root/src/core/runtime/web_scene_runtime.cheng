                                                     bounds):
        return false
    var gpuBuffer: WebSceneGpuCommandBuffer
    if !WebSceneBuildSceneGpuCommandsScopedWithFullAtlases(graph, routeIndex, layerId, subtreeRootNodeId, imageAtlas, svgAtlas, glyphAtlas, gpuBuffer):
        return false
    if bounds.empty || gpuBuffer.commands.len == 0:
        return true
    var layer: WebSceneCompositorLayer
    layer.routeIndex = routeIndex
    layer.layerId = layerId
    layer.cacheRouteIndex = routeIndex
    layer.cacheLayerId = layerId
    layer.transitionAction = 0
    layer.ordinal = ordinal
    layer.offsetX = graph.layers[layerIndex].offsetX
    layer.offsetY = graph.layers[layerIndex].offsetY
    layer.previousOffsetX = graph.layers[layerIndex].offsetX
    layer.previousOffsetY = graph.layers[layerIndex].offsetY
    WebSceneRectInit(layer.dirtyRect)
    layer.commandStart = frame.commands.len
    layer.commandCount = gpuBuffer.commands.len
    add(frame.layers, layer)
    let layerFrameIndex = frame.layers.len - 1
    WebSceneCompositorLayerSetDirtyRectAt(frame, layerFrameIndex, bounds)
    for i in 0..<gpuBuffer.commands.len:
        var gpuCommand: WebSceneGpuCommand
        if !WebSceneGpuCommandCloneAt(gpuBuffer, i, gpuCommand):
            return false
        add(frame.commands, gpuCommand)
    return true

fn WebSceneAppendCompositorLayerScopeWithAtlases(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 layerId: int32,
                                                 ordinal: int32,
