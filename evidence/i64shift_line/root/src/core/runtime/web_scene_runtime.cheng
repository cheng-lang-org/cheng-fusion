fn WebSceneLayoutDebugClear() =
    WebSceneLayoutFailCode = 0
    WebSceneLayoutFailRouteIndex = -1
    WebSceneLayoutFailNodeId = -1
    WebSceneLayoutFailOrdinal = -1

fn WebSceneLayoutDebugFail(code: int32, routeIndex: int32, nodeId: int32, ordinal: int32) =
    WebSceneLayoutFailCode = code
    WebSceneLayoutFailRouteIndex = routeIndex
    WebSceneLayoutFailNodeId = nodeId
    WebSceneLayoutFailOrdinal = ordinal

fn WebSceneLastLayoutFailCode(): int32 =
    return WebSceneLayoutFailCode

@borrows
fn WebSceneCssPropertyDebugCode(propertyName: str): int32 =
    if propertyName == "transform":
        return 1
    if propertyName == "box-shadow":
        return 2
    if propertyName == "background-image":
        return 3
    if propertyName == "background-color":
        return 4
    if propertyName == "border-color":
        return 5
    if propertyName == "color":
        return 6
    if propertyName == "opacity":
        return 7
    if propertyName == "pointer-events":
        return 8
    if propertyName == "width":
        return 9
    if propertyName == "height":
        return 10
    return 999

fn WebSceneCssDebugClear() =
    WebSceneCssFailCode = 0
    WebSceneCssFailRouteIndex = -1
    WebSceneCssFailNodeId = -1
    WebSceneCssFailRuleOrdinal = -1
    WebSceneCssFailDeclarationOrdinal = -1
    WebSceneCssFailPropertyCode = 0

@borrows
fn WebSceneCssDebugFail(code: int32, declaration: WebSceneCssDeclaration) =
    WebSceneCssFailCode = code
    WebSceneCssFailRouteIndex = declaration.routeIndex
    WebSceneCssFailNodeId = declaration.nodeId
    WebSceneCssFailRuleOrdinal = declaration.ruleOrdinal
    WebSceneCssFailDeclarationOrdinal = declaration.ordinal
    WebSceneCssFailPropertyCode = WebSceneCssPropertyDebugCode(declaration.propertyName)

@borrows
fn WebSceneCssDebugRuleFail(code: int32, rule: WebSceneCssVariantRule) =
    WebSceneCssFailCode = code
    WebSceneCssFailRouteIndex = rule.routeIndex
    WebSceneCssFailNodeId = rule.nodeId
    WebSceneCssFailRuleOrdinal = rule.ordinal
    WebSceneCssFailDeclarationOrdinal = -1
    WebSceneCssFailPropertyCode = 0

fn WebSceneLastCssFailCode(): int32 =
    return WebSceneCssFailCode

fn WebSceneLastCssFailRouteIndex(): int32 =
    return WebSceneCssFailRouteIndex

fn WebSceneLastCssFailNodeId(): int32 =
    return WebSceneCssFailNodeId

fn WebSceneLastCssFailRuleOrdinal(): int32 =
    return WebSceneCssFailRuleOrdinal

fn WebSceneLastCssFailDeclarationOrdinal(): int32 =
    return WebSceneCssFailDeclarationOrdinal

fn WebSceneLastCssFailPropertyCode(): int32 =
    return WebSceneCssFailPropertyCode

fn WebSceneLastLayoutFailRouteIndex(): int32 =
    return WebSceneLayoutFailRouteIndex

fn WebSceneLastLayoutFailNodeId(): int32 =
    return WebSceneLayoutFailNodeId

fn WebSceneLastLayoutFailOrdinal(): int32 =
    return WebSceneLayoutFailOrdinal

fn WebSceneGlyphAtlasDebugClear() =
    WebSceneGlyphAtlasFailCode = 0
    WebSceneGlyphAtlasFailRouteIndex = -1
    WebSceneGlyphAtlasFailNodeId = -1
    WebSceneGlyphAtlasFailOrdinal = -1
    WebSceneGlyphAtlasFailCodepoint = 0
    WebSceneGlyphAtlasNotdefCount = 0
    WebSceneGlyphAtlasNotdefLastCodepoint = 0

fn WebSceneGlyphAtlasDebugFail(code: int32, routeIndex: int32, nodeId: int32,
                               ordinal: int32, codepoint: int32) =
    if WebSceneGlyphAtlasFailCode != 0:
        return
    WebSceneGlyphAtlasFailCode = code
    WebSceneGlyphAtlasFailRouteIndex = routeIndex
    WebSceneGlyphAtlasFailNodeId = nodeId
    WebSceneGlyphAtlasFailOrdinal = ordinal
    WebSceneGlyphAtlasFailCodepoint = codepoint

fn WebSceneLastGlyphAtlasFailCode(): int32 =
    return WebSceneGlyphAtlasFailCode

fn WebSceneLastGlyphAtlasFailRouteIndex(): int32 =
    return WebSceneGlyphAtlasFailRouteIndex

fn WebSceneLastGlyphAtlasFailNodeId(): int32 =
    return WebSceneGlyphAtlasFailNodeId

fn WebSceneLastGlyphAtlasFailOrdinal(): int32 =
    return WebSceneGlyphAtlasFailOrdinal

fn WebSceneLastGlyphAtlasFailCodepoint(): int32 =
    return WebSceneGlyphAtlasFailCodepoint

# .notdef substitution is a real browser rendering (tofu box), not a failure, so
# it is tracked with an independent non-latch counter instead of the first-error
# latch above. Every substituted codepoint bumps the count and records the last
# codepoint so desktop repro/device diag can assert exactly which glyphs fell back.
fn WebSceneGlyphAtlasDebugNotdef(codepoint: int32) =
    WebSceneGlyphAtlasNotdefCount = WebSceneGlyphAtlasNotdefCount + 1
    WebSceneGlyphAtlasNotdefLastCodepoint = codepoint

fn WebSceneGlyphAtlasNotdefSubstitutionCount(): int32 =
    return WebSceneGlyphAtlasNotdefCount

fn WebSceneGlyphAtlasNotdefLastSubstitutedCodepoint(): int32 =
    return WebSceneGlyphAtlasNotdefLastCodepoint

fn WebSceneSvgAtlasDebugClear() =
    WebSceneSvgAtlasFailCode = 0
    WebSceneSvgAtlasFailPaintIndex = -1
    WebSceneSvgAtlasFailRouteIndex = -1
    WebSceneSvgAtlasFailNodeId = -1
    WebSceneSvgAtlasFailOrdinal = -1
    WebSceneSvgAtlasFailResourceHash = 0

@borrows
fn WebSceneSvgAtlasDebugFail(code: int32, paintIndex: int32, routeIndex: int32, nodeId: int32, ordinal: int32, resourceId: str) =
    WebSceneSvgAtlasFailCode = code
    WebSceneSvgAtlasFailPaintIndex = paintIndex
    WebSceneSvgAtlasFailRouteIndex = routeIndex
    WebSceneSvgAtlasFailNodeId = nodeId
    WebSceneSvgAtlasFailOrdinal = ordinal
    if resourceId.len > 0:
        WebSceneSvgAtlasFailResourceHash = WebSceneResourceIdHash31(resourceId)
    else:
        WebSceneSvgAtlasFailResourceHash = 0

fn WebSceneLastSvgAtlasFailCode(): int32 =
    return WebSceneSvgAtlasFailCode

fn WebSceneLastSvgAtlasFailPaintIndex(): int32 =
    return WebSceneSvgAtlasFailPaintIndex

fn WebSceneLastSvgAtlasFailRouteIndex(): int32 =
    return WebSceneSvgAtlasFailRouteIndex

fn WebSceneLastSvgAtlasFailNodeId(): int32 =
    return WebSceneSvgAtlasFailNodeId

fn WebSceneLastSvgAtlasFailOrdinal(): int32 =
    return WebSceneSvgAtlasFailOrdinal

fn WebSceneLastSvgAtlasFailResourceHash(): int32 =
    return WebSceneSvgAtlasFailResourceHash

fn WebSceneNodeHasLayoutConstraint(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    for i in 0..<graph.layoutConstraints.len:
        if graph.layoutConstraints[i].routeIndex == routeIndex && graph.layoutConstraints[i].nodeId == nodeId:
            return true
    return false

fn WebSceneNodeHasPaintOp(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex && graph.paintOps[i].nodeId == nodeId:
            return true
    return false

fn WebSceneNodeHasDisplayNoneConstraint(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if nodeId <= 0 || nodeId >= graph.nodeDisplayNoneById.len:
        return false
    if graph.nodeRouteById[nodeId] != routeIndex:
        return false
    if graph.nodeDisplayNoneById[nodeId] != 0:
        return true
    return false

fn WebSceneNodeHasUnsatisfiedStateCondition(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if nodeId <= 0 || nodeId >= graph.nodeIndexById.len:
        return false
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return false
    if graph.nodes[nodeIndex].routeIndex != routeIndex:
        return false
    if graph.nodes[nodeIndex].conditionalStateRef.len == 0:
        return false
    let currentValue = WebSceneStateValueForRef(graph, graph.nodes[nodeIndex].conditionalStateRef)
    return !WebSceneStateValueMatchesCondition(currentValue, graph.nodes[nodeIndex].conditionalStateValue)
    return false

fn WebSceneFindUnsatisfiedStateConditionNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    var current = nodeId
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        if WebSceneNodeHasUnsatisfiedStateCondition(graph, routeIndex, current):
            return current
        current = WebSceneFindNodeParentId(graph, current)
        guard = guard + 1
    return 0

@borrows
fn WebSceneNodeConditionalStateRefAt(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): str =
    if nodeId <= 0 || nodeId >= graph.nodeIndexById.len:
        return ""
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return ""
    if graph.nodes[nodeIndex].routeIndex != routeIndex:
        return ""
    return graph.nodes[nodeIndex].conditionalStateRef

fn WebSceneNodeConditionalStateValueAt(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): str =
    if nodeId <= 0 || nodeId >= graph.nodeIndexById.len:
        return ""
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return ""
    if graph.nodes[nodeIndex].routeIndex != routeIndex:
        return ""
    return graph.nodes[nodeIndex].conditionalStateValue

@borrows
fn WebSceneStateConditionWitnessValue(expectedValueRaw: str): str =
    if expectedValueRaw.len == 0:
        return "true"
    if expectedValueRaw == "__truthy":
        return "true"
    if expectedValueRaw == "__falsy":
        return "false"
    if expectedValueRaw == "__array_nonempty":
        return "[\"_\"]"
    if strings.HasPrefix(expectedValueRaw, "__array_length_lt:"):
        # Any bound >= 1 is satisfied by the empty array (0 items < N).
        return "[]"
    if strings.HasPrefix(expectedValueRaw, "__array_length_gte:"):
        let gteWitnessBoundRaw = strings.SliceBytes(expectedValueRaw, 19, expectedValueRaw.len - 19)
        var gteWitnessBound: int32
        if !WebSceneParseEffectInt32(gteWitnessBoundRaw, gteWitnessBound):
            return ""
        var witness = "["
        var witnessIndex: int32
        while witnessIndex < gteWitnessBound:
            if witnessIndex > 0:
                witness = strings.ConcatStr(witness, ",")
            witness = strings.ConcatStr(witness, "\"_\"")
            witnessIndex = witnessIndex + 1
        witness = strings.ConcatStr(witness, "]")
        return witness
    if expectedValueRaw == "__num_positive":
        return "1"
    if expectedValueRaw == "__trim_nonempty":
        return "_"
    if strings.HasPrefix(expectedValueRaw, "__num_gt:"):
        # 界的整数部分+1 恒大于原界(向零截断): N=0→"1", N=2.7→"3", N=-2.5→"-1"。
        let numGtBoundRaw = strings.SliceBytes(expectedValueRaw, 9, expectedValueRaw.len - 9)
        var numGtBoundInt: int32
        if !WebSceneParseLeadingSignedInt32(numGtBoundRaw, numGtBoundInt):
            return ""
        return strings.IntToStr(numGtBoundInt + 1)
    if expectedValueRaw == "__num_finite":
        return "1"
    if strings.HasPrefix(expectedValueRaw, "__not:"):
        let inner = strings.SliceBytes(expectedValueRaw, 6, expectedValueRaw.len - 6)
        if inner.len == 0 || inner == "__truthy":
            return "false"
        if inner == "__falsy":
            return "true"
        if strings.HasPrefix(inner, "__not:"):
            let nested = strings.SliceBytes(inner, 6, inner.len - 6)
            return WebSceneStateConditionWitnessValue(nested)
        if inner == "false":
            return "true"
        return "false"
    if strings.HasPrefix(expectedValueRaw, "__eq_or:"):
        let rest = strings.SliceBytes(expectedValueRaw, 8, expectedValueRaw.len - 8)
        let colon = WebSceneStateIndexOfByte(rest, ':', 0)
        if colon < 0:
            return ""
        return strings.SliceBytes(rest, colon + 1, rest.len - colon - 1)
    if strings.HasPrefix(expectedValueRaw, "__eq_any:"):
        let listRaw = strings.SliceBytes(expectedValueRaw, 9, expectedValueRaw.len - 9)
        let bar = WebSceneStateIndexOfByte(listRaw, '|', 0)
        if bar < 0:
            return listRaw
        return strings.SliceBytes(listRaw, 0, bar)
    if strings.HasPrefix(expectedValueRaw, "__substr_of:"):
        return ""
    return expectedValueRaw

fn WebSceneNodeHiddenByStateCondition(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    var current = nodeId
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        if WebSceneNodeHasUnsatisfiedStateCondition(graph, routeIndex, current):
            return true
        current = WebSceneFindNodeParentId(graph, current)
        guard = guard + 1
    return false

fn WebSceneNodeHasStateConditionAncestor(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    var current = nodeId
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        if current >= graph.nodeIndexById.len:
            return false
        let nodeIndex = graph.nodeIndexById[current]
        if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
            return false
        if graph.nodes[nodeIndex].routeIndex != routeIndex:
            return false
        if graph.nodes[nodeIndex].conditionalStateRef.len > 0:
            return true
        current = graph.nodes[nodeIndex].parentNodeId
        guard = guard + 1
    return false

fn WebSceneNodeHiddenByDisplayNone(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if WebSceneNodeHiddenByStateCondition(graph, routeIndex, nodeId):
        return true
    var current = nodeId
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        if WebSceneNodeHasDisplayNoneConstraint(graph, routeIndex, current):
            return true
        current = WebSceneFindNodeParentId(graph, current)
        guard = guard + 1
    return false

@borrows
fn WebSceneTagIsNonRenderedContent(tagName: str): bool =
    if tagName == "style":
        return true
    if tagName == "script":
        return true
    if tagName == "template":
        return true
    return false

fn WebSceneNodeHiddenByNonRenderedContent(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    var current = nodeId
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        if current < graph.nodeRouteById.len &&
           graph.nodeRouteById[current] == routeIndex &&
           graph.nodeNonRenderedById[current] != 0:
            return true
        current = WebSceneFindNodeParentId(graph, current)
        guard = guard + 1
    return false

@borrows
fn WebSceneNodeIsTransparentLayoutWrapper(graph: var WebSceneGraph, node: WebSceneNode): bool =
    if node.nodeKind == 3:
        return false
    if node.tagName == "fragment":
        return true
    if node.tagName != "" || node.textContent != "":
        return false
    if WebSceneNodeHasLayoutConstraint(graph, node.routeIndex, node.nodeId):
        return false
    if WebSceneNodeHasPaintOp(graph, node.routeIndex, node.nodeId):
        return false
    return true

fn WebSceneNodeIdIsTransparentLayoutWrapper(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if nodeId <= 0 || nodeId >= graph.nodeIndexById.len:
        return false
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return false
    if graph.nodes[nodeIndex].routeIndex == routeIndex:
        return WebSceneNodeIsTransparentLayoutWrapper(graph, graph.nodes[nodeIndex])
    return false

fn WebSceneNearestLayoutParentNodeId(graph: var WebSceneGraph, routeIndex: int32, parentNodeId: int32): int32 =
    var current = parentNodeId
    while current > 0:
        if !WebSceneNodeIdIsTransparentLayoutWrapper(graph, routeIndex, current):
            return current
        current = WebSceneFindNodeParentId(graph, current)
    return 0

fn WebSceneGraphInit(graph: var WebSceneGraph) =
    graph.routes = []
    graph.layers = []
    graph.nodes = []
    graph.props = []
    graph.eventHandlers = []
    graph.hitTargets = []
    graph.mediaAssets = []
    graph.mediaPlaybackSlots = []
    graph.mediaControlActions = []
    graph.mediaReceipts = []
    graph.mediaLifecycleEvents = []
    graph.cssVariantRules = []
    graph.cssVariantConditions = []
    graph.cssDeclarations = []
    graph.nodeStates = []
    graph.stateEntries = []
    graph.stateDependencyRefs = []
    graph.stateDependencyRoutes = []
    graph.routeStateVersions = []
    graph.storageEntries = []
    graph.resources = []
    graph.layoutConstraints = []
    graph.paintOps = []
    graph.paintShadows = []
    graph.paintGradients = []
    graph.paintOpStartByNodeId = []
    graph.paintOpEndByNodeId = []
    graph.paintOpRangeIndexSynced = false
    graph.paintShadowStartByNodeId = []
    graph.paintShadowEndByNodeId = []
    graph.paintGradientStartByNodeId = []
    graph.paintGradientEndByNodeId = []
    graph.paintSvgPrimitives = []
    graph.paintSvgPrimitiveStartByNodeId = []
    graph.paintSvgPrimitiveEndByNodeId = []
    graph.layoutBoxes = []
    graph.routeEdges = []
    graph.layerCaches = []
    graph.dirtySpans = []
    graph.nodeParentById = []
    graph.nodeRouteById = []
    graph.nodeIndexById = []
    graph.nodeNonRenderedById = []
    graph.nodeDisplayNoneById = []
    graph.activeRouteIndex = -1
    graph.currentViewportWidth = 0
    graph.currentViewportHeight = 0
    graph.version = 0
    graph.stateVersion = 0
    graph.interactionVersion = -1
    graph.eventHandlerIndexVersion = -1
    graph.textInputNodeVersion = -1
    graph.boxRangeVersion = -1

fn WebSceneEnsureNodeLookupCapacity(graph: var WebSceneGraph, nodeId: int32): bool =
    if nodeId <= 0:
        return false
    while graph.nodeParentById.len <= nodeId:
        add(graph.nodeParentById, -1)
        add(graph.nodeRouteById, -1)
        add(graph.nodeIndexById, -1)
        add(graph.nodeNonRenderedById, 0)
        add(graph.nodeDisplayNoneById, 0)
    if graph.nodeParentById.len <= nodeId:
        return false
    if graph.nodeRouteById.len <= nodeId:
        return false
    if graph.nodeIndexById.len <= nodeId:
        return false
    if graph.nodeNonRenderedById.len <= nodeId:
        return false
    if graph.nodeDisplayNoneById.len <= nodeId:
        return false
    return true

@borrows
fn WebSceneRegisterNodeLookup(graph: var WebSceneGraph, node: WebSceneNode, nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return false
    if !WebSceneEnsureNodeLookupCapacity(graph, node.nodeId):
        return false
    if graph.nodeIndexById[node.nodeId] >= 0:
        return false
    graph.nodeParentById[node.nodeId] = node.parentNodeId
    graph.nodeRouteById[node.nodeId] = node.routeIndex
    graph.nodeIndexById[node.nodeId] = nodeIndex
    if WebSceneTagIsNonRenderedContent(node.tagName):
        graph.nodeNonRenderedById[node.nodeId] = 1
    else:
        graph.nodeNonRenderedById[node.nodeId] = 0
    return true

fn WebSceneMarkNodeDisplayNoneLookup(graph: var WebSceneGraph, nodeId: int32): bool =
    if nodeId <= 0:
        return false
    if nodeId >= graph.nodeDisplayNoneById.len:
        return false
    if graph.nodeIndexById[nodeId] < 0:
        return false
    graph.nodeDisplayNoneById[nodeId] = 1
    return true

