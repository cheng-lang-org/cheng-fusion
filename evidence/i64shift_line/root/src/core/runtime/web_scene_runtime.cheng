fn WebSceneCssDeclarationCloneFromSeq(seq: var WebSceneCssDeclaration[], index: int32, dst: var WebSceneCssDeclaration): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.ruleOrdinal = seq[index].ruleOrdinal
    dst.ordinal = seq[index].ordinal
    dst.propertyName = WebSceneCloneStateString(seq[index].propertyName)
    dst.propertyValue = WebSceneCloneStateString(seq[index].propertyValue)
    dst.important = seq[index].important
    return true

fn WebSceneLayoutBoxCloneFromSeq(seq: var WebSceneLayoutBox[], index: int32, dst: var WebSceneLayoutBox): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.x = seq[index].x
    dst.y = seq[index].y
    dst.width = seq[index].width
    dst.height = seq[index].height
    dst.visible = seq[index].visible
    return true

fn WebSceneGlyphRunCloneFromSeq(seq: var WebSceneGlyphRun[], index: int32, dst: var WebSceneGlyphRun): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.ordinal = seq[index].ordinal
    dst.glyphRunId = seq[index].glyphRunId
    dst.fontAtlasId = seq[index].fontAtlasId
    dst.sdfAtlasId = seq[index].sdfAtlasId
    dst.glyphStart = seq[index].glyphStart
    dst.glyphCount = seq[index].glyphCount
    dst.advanceWidth = seq[index].advanceWidth
    return true

fn WebSceneNodeRemarkEntryCloneFromSeq(seq: var WebSceneNodeRemarkEntry[], index: int32, dst: var WebSceneNodeRemarkEntry): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.peerId = WebSceneCloneStateString(seq[index].peerId)
    dst.remark = WebSceneCloneStateString(seq[index].remark)
    return true

fn WebSceneProfileAddressRecordCloneFromSeq(seq: var WebSceneProfileAddressRecord[], index: int32, dst: var WebSceneProfileAddressRecord): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.id = WebSceneCloneStateString(seq[index].id)
    dst.receiver = WebSceneCloneStateString(seq[index].receiver)
    dst.phone = WebSceneCloneStateString(seq[index].phone)
    dst.region = WebSceneCloneStateString(seq[index].region)
    dst.detail = WebSceneCloneStateString(seq[index].detail)
    dst.tag = WebSceneCloneStateString(seq[index].tag)
    dst.isDefault = seq[index].isDefault
    return true

@borrows
fn WebSceneSetStateValueInternal(graph: var WebSceneGraph, stateRef: str, value: str, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    let stateIndex = WebSceneFindStateIndex(graph, stateRef)
    if stateIndex >= 0:
        if graph.stateEntries[stateIndex].value == value:
            return 0
        let storedValue = WebSceneCloneStateString(value)
        graph.stateEntries[stateIndex].value = WebSceneCloneStateString(storedValue)
        WebSceneMarkStateRouteDependencies(graph, stateRef)
        WebSceneRefreshTextBindingsForState(graph, stateRef, storedValue)
        if WebSceneRefreshImageSrcBindingsForStateStatus(graph, stateRef, storedValue) < 0:
            return -1
        if WebSceneRefreshStateSetBindingsForState(graph, stateRef, storedValue, markDirty) < 0:
            return -1
        if WebSceneRefreshProfileAddressListsForStateChange(graph, stateRef, markDirty) < 0:
            return -1
        if markDirty:
            if !WebSceneMarkStateDirty(graph):
                return -1
        return 1
    var entry: WebSceneStateEntry
    entry.stateRef = WebSceneCloneStateString(stateRef)
    entry.value = WebSceneCloneStateString(value)
    add(graph.stateEntries, entry)
    let addedStateIndex = graph.stateEntries.len - 1
    WebSceneMarkStateRouteDependencies(graph, stateRef)
    WebSceneRefreshTextBindingsForState(graph, graph.stateEntries[addedStateIndex].stateRef, graph.stateEntries[addedStateIndex].value)
    if WebSceneRefreshImageSrcBindingsForStateStatus(graph, graph.stateEntries[addedStateIndex].stateRef, graph.stateEntries[addedStateIndex].value) < 0:
        return -1
    if WebSceneRefreshStateSetBindingsForState(graph, graph.stateEntries[addedStateIndex].stateRef, graph.stateEntries[addedStateIndex].value, markDirty) < 0:
        return -1
    if WebSceneRefreshProfileAddressListsForStateChange(graph, graph.stateEntries[addedStateIndex].stateRef, markDirty) < 0:
        return -1
    if markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    return 1

@borrows
fn WebSceneSetStateValue(graph: var WebSceneGraph, stateRef: str, value: str): bool =
    if WebSceneSetStateValueInternal(graph, stateRef, value, true) >= 0:
        return true
    return false

# Populate the initial state table at scene load without running any binding
# refresh. The materialized node text / paint ops / visibility already reflect
# each route's static state, so refreshing text bindings here would overwrite
# statically-labelled nodes (e.g. tab buttons carrying textStateRef of an
# overloaded global state like `tab`) with the global seed value and break their
# glyph runs. Seeding only fills stateEntries so runtime visibility conditions
# evaluate against real values; later set: effects still refresh via the normal
# WebSceneSetStateValueInternal path.
@borrows
fn WebSceneSeedStateValue(graph: var WebSceneGraph, stateRef: str, value: str): bool =
    if stateRef.len == 0:
        return false
    let stateIndex = WebSceneFindStateIndex(graph, stateRef)
    if stateIndex >= 0:
        graph.stateEntries[stateIndex].value = WebSceneCloneStateString(value)
        return true
    var entry: WebSceneStateEntry
    entry.stateRef = WebSceneCloneStateString(stateRef)
    entry.value = WebSceneCloneStateString(value)
    add(graph.stateEntries, entry)
    return true

@borrows
fn WebSceneToggleStateValueInternal(graph: var WebSceneGraph, stateRef: str, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if current == "true":
        return WebSceneSetStateValueInternal(graph, stateRef, "false", markDirty)
    return WebSceneSetStateValueInternal(graph, stateRef, "true", markDirty)

@borrows
fn WebSceneToggleStateValue(graph: var WebSceneGraph, stateRef: str): bool =
    if WebSceneToggleStateValueInternal(graph, stateRef, true) >= 0:
        return true
    return false

@borrows
fn WebSceneMorePanelTouchRefState(refName: str, fieldName: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("objref:", refName), ":"), fieldName)

fn WebSceneMorePanelPageTransformValue(page: int32): str =
    let offset = page * 100
    return strings.ConcatStr(strings.ConcatStr("translateX(-", strings.IntToStr(offset)), "%)")

@borrows
fn WebSceneRefreshMorePanelPageTransformForRoute(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 pageRef: str,
                                                 page: int32,
                                                 markDirty: bool): int32 =
    let nextTransform = WebSceneMorePanelPageTransformValue(page)
    var matched: bool
    var touched: bool
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].propName == "data-csg-more-panel-page-transform-ref" &&
           graph.props[i].propValue == pageRef:
            matched = true
            let nodeId = graph.props[i].nodeId
            let setStatus = WebSceneSetLatestStaticCssDeclarationValue(graph, routeIndex, nodeId, "transform", nextTransform)
            if setStatus < 0:
                return -1
            if setStatus > 0:
                let declarationIndex = WebSceneFindLatestStaticCssDeclarationIndex(graph, routeIndex, nodeId, "transform")
                if declarationIndex < 0:
                    return -1
                if WebSceneRouteHasRuntimeLayoutBox(graph, routeIndex):
                    if !WebSceneRebuildPaintOpRangeIndex(graph):
                        return -1
                    if !WebSceneApplyCssTransformDeclarationToPaintOps(graph, graph.cssDeclarations[declarationIndex]):
                        return -1
                elif markDirty:
                    if !WebSceneMarkRouteDirty(graph, routeIndex):
                        return -1
                touched = true
    if !matched:
        return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneMorePanelPageCount(graph: var WebSceneGraph, pagesRef: str, outCount: var int32): bool =
    let raw = WebSceneStateValueForRef(graph, pagesRef)
    if raw.len == 0:
        return false
    return WebSceneJsonTopLevelArrayItemCount(raw, outCount)

@borrows
@borrow_result
fn WebSceneMorePanelEffectPart(segment: str, prefix: str, ordinal: int32): str =
    if !WebSceneStrStartsWith(segment, prefix):
        return strings.SliceBytes(segment, 0, 0)
    var partStart = prefix.len
    var partOrdinal: int32
    var i = partStart
    while i <= segment.len:
        if i == segment.len || segment[i] == ':':
            if partOrdinal == ordinal:
                return strings.SliceBytes(segment, partStart, i - partStart)
            partOrdinal = partOrdinal + 1
            partStart = i + 1
        i = i + 1
    return strings.SliceBytes(segment, 0, 0)

@borrows
fn WebSceneApplyMorePanelTouchStartEffectSegment(graph: var WebSceneGraph,
                                                 segment: str,
                                                 xMilli: int32,
                                                 yMilli: int32): int32 =
    let prefix = "more_panel_touch_start:"
    let pageRef = WebSceneMorePanelEffectPart(segment, prefix, 0)
    let pagesRef = WebSceneMorePanelEffectPart(segment, prefix, 1)
    let touchRef = WebSceneMorePanelEffectPart(segment, prefix, 2)
    if pageRef.len == 0 || pagesRef.len == 0 || touchRef.len == 0:
        return -1
    var pageCount: int32
    if !WebSceneMorePanelPageCount(graph, pagesRef, pageCount):
        return -1
    var status = WebSceneSetStateValueInternal(graph, "ref:touchClickSuppressed", "false", false)
    if status < 0:
        return -1
    if pageCount <= 1:
        return WebSceneSetStateValueInternal(graph, WebSceneMorePanelTouchRefState(touchRef, "present"), "false", false)
    status = WebSceneSetStateValueInternal(graph, WebSceneMorePanelTouchRefState(touchRef, "present"), "true", false)
    if status < 0:
        return -1
    status = WebSceneSetStateValueInternal(graph, WebSceneMorePanelTouchRefState(touchRef, "xMilli"), strings.IntToStr(xMilli), false)
    if status < 0:
        return -1
    return WebSceneSetStateValueInternal(graph, WebSceneMorePanelTouchRefState(touchRef, "yMilli"), strings.IntToStr(yMilli), false)

@borrows
fn WebSceneApplyMorePanelTouchCancelEffectSegment(graph: var WebSceneGraph, segment: str): int32 =
    let prefix = "more_panel_touch_cancel:"
    let touchRef = WebSceneMorePanelEffectPart(segment, prefix, 0)
    if touchRef.len == 0:
        return -1
    return WebSceneSetStateValueInternal(graph, WebSceneMorePanelTouchRefState(touchRef, "present"), "false", false)

@borrows
fn WebSceneApplyMorePanelTouchEndEffectSegment(graph: var WebSceneGraph,
                                               routeIndex: int32,
                                               segment: str,
                                               xMilli: int32,
                                               yMilli: int32,
                                               markDirty: bool): int32 =
    let prefix = "more_panel_touch_end:"
    let pageRef = WebSceneMorePanelEffectPart(segment, prefix, 0)
    let pagesRef = WebSceneMorePanelEffectPart(segment, prefix, 1)
    let touchRef = WebSceneMorePanelEffectPart(segment, prefix, 2)
    if pageRef.len == 0 || pagesRef.len == 0 || touchRef.len == 0:
        return -1
    let presentRef = WebSceneMorePanelTouchRefState(touchRef, "present")
    let present = WebSceneStateValueForRef(graph, presentRef)
    var status = WebSceneSetStateValueInternal(graph, presentRef, "false", false)
    if status < 0:
        return -1
    if present != "true":
        return status
    var pageCount: int32
    if !WebSceneMorePanelPageCount(graph, pagesRef, pageCount):
        return -1
    if pageCount <= 1:
        return status
    var startX: int32
    var startY: int32
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, WebSceneMorePanelTouchRefState(touchRef, "xMilli")), startX):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, WebSceneMorePanelTouchRefState(touchRef, "yMilli")), startY):
        return -1
    let deltaX = xMilli - startX
    let deltaY = yMilli - startY
    if WebSceneAbsI32(deltaX) < 42000 || WebSceneAbsI32(deltaX) <= WebSceneAbsI32(deltaY):
        return status
    let suppressStatus = WebSceneSetStateValueInternal(graph, "ref:touchClickSuppressed", "true", false)
    if suppressStatus < 0:
        return -1
    var currentPage: int32
    let currentRaw = WebSceneStateValueForRef(graph, pageRef)
    if currentRaw.len > 0:
        if !WebSceneParseEffectInt32(currentRaw, currentPage):
            return -1
    var nextPage = currentPage
    if deltaX < 0:
        nextPage = WebSceneMinI32(currentPage + 1, pageCount - 1)
    else:
        nextPage = WebSceneMaxI32(currentPage - 1, 0)
    let pageStatus = WebSceneSetStateValueInternal(graph, pageRef, strings.IntToStr(nextPage), false)
    if pageStatus < 0:
        return -1
    let transformStatus = WebSceneRefreshMorePanelPageTransformForRoute(graph, routeIndex, pageRef, nextPage, markDirty)
    if transformStatus < 0:
        return -1
    if pageStatus > 0 || transformStatus > 0 || suppressStatus > 0:
        return 1
    return status

@borrows
fn WebSceneConversationRowItemIdAllowed(itemId: str): bool =
    if itemId.len == 0:
        return false
    for i in 0..<itemId.len:
        let ch = itemId[i]
        if ch >= 'A' && ch <= 'Z':
            continue
        if ch >= 'a' && ch <= 'z':
            continue
        if ch >= '0' && ch <= '9':
            continue
        if ch == '_' || ch == '-':
            continue
        return false
    return true

@borrows
fn WebSceneConversationRowParseSingleItemEffect(segment: str, prefix: str, outItemId: var str): bool =
    if !WebSceneStrStartsWith(segment, prefix):
        return false
    let itemId = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    if !WebSceneConversationRowItemIdAllowed(itemId):
        return false
    if WebSceneFindEffectChar(itemId, ':', 0) >= 0:
        return false
    outItemId = itemId
    return true

@borrows
fn WebSceneConversationRowParseEndEffect(segment: str, outItemId: var str, outMode: var str): bool =
    let prefix = "conversation_row_pointer_end:"
    if !WebSceneStrStartsWith(segment, prefix):
        return false
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return false
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return false
    let itemId = strings.SliceBytes(body, 0, colon)
    let mode = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    if !WebSceneConversationRowItemIdAllowed(itemId):
        return false
    if mode != "up" && mode != "cancel":
        return false
    outItemId = itemId
    outMode = mode
    return true

@borrows
fn WebSceneConversationRowParseClickEffect(segment: str,
                                           outStateRef: var str,
                                           outItemId: var str,
                                           outRouteId: var str): bool =
    let prefix = "conversation_row_click:"
    if !WebSceneStrStartsWith(segment, prefix):
        return false
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let firstColon = WebSceneFindEffectChar(body, ':', 0)
    if firstColon <= 0 || firstColon >= body.len - 1:
        return false
    let secondColon = WebSceneFindEffectChar(body, ':', firstColon + 1)
    if secondColon <= firstColon + 1 || secondColon >= body.len - 1:
        return false
    if WebSceneFindEffectChar(body, ':', secondColon + 1) >= 0:
        return false
    let stateRef = strings.SliceBytes(body, 0, firstColon)
    let itemId = strings.SliceBytes(body, firstColon + 1, secondColon - firstColon - 1)
    let routeId = strings.SliceBytes(body, secondColon + 1, body.len - secondColon - 1)
    if stateRef != "selectedId":
        return false
    if routeId != "message_thread":
        return false
    if !WebSceneConversationRowItemIdAllowed(itemId):
        return false
    outStateRef = stateRef
    outItemId = itemId
    outRouteId = routeId
    return true

@borrows
fn WebSceneConversationRowParseDeleteEffect(segment: str,
                                            outConversationsRef: var str,
                                            outSelectedRef: var str,
                                            outItemId: var str): bool =
    let prefix = "conversation_row_delete:"
    if !WebSceneStrStartsWith(segment, prefix):
        return false
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let firstColon = WebSceneFindEffectChar(body, ':', 0)
    if firstColon <= 0 || firstColon >= body.len - 1:
        return false
    let secondColon = WebSceneFindEffectChar(body, ':', firstColon + 1)
    if secondColon <= firstColon + 1 || secondColon >= body.len - 1:
        return false
    if WebSceneFindEffectChar(body, ':', secondColon + 1) >= 0:
        return false
    let conversationsRef = strings.SliceBytes(body, 0, firstColon)
    let selectedRef = strings.SliceBytes(body, firstColon + 1, secondColon - firstColon - 1)
    let itemId = strings.SliceBytes(body, secondColon + 1, body.len - secondColon - 1)
    if conversationsRef != "conversations":
        return false
    if selectedRef != "selectedId":
        return false
    if !WebSceneConversationRowItemIdAllowed(itemId):
        return false
    outConversationsRef = conversationsRef
    outSelectedRef = selectedRef
    outItemId = itemId
    return true

@borrows
fn WebSceneParseSignedEffectInt32(raw: str, out: var int32): bool =
    if raw.len == 0:
        return false
    var sign: int32 = 1
    var index: int32
    if raw[0] == '-':
        sign = -1
        index = 1
        if raw.len == 1:
            return false
    var value: int64
    while index < raw.len:
        let ch = raw[index]
        if !WebSceneIsAsciiDigit(ch):
            return false
        value = value * int64(10) + int64(WebSceneAsciiDigitValue(ch))
        if value > int64(2147483647):
            return false
        index = index + 1
    out = int32(value) * sign
    return true

@borrows
fn WebSceneConversationRowStateRef(itemId: str, fieldName: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("conversationRow:", itemId), ":"), fieldName)

fn WebSceneConversationRowOffsetTransformValue(offsetPx: int32): str =
    return strings.ConcatStr(strings.ConcatStr("translateX(", strings.IntToStr(offsetPx)), "px)")

@borrows
fn WebSceneConversationRowOffsetValue(graph: var WebSceneGraph, itemId: str, outOffset: var int32): bool =
    outOffset = 0
    let raw = WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "offsetX"))
    if raw.len == 0:
        return true
    return WebSceneParseSignedEffectInt32(raw, outOffset)

@borrows
fn WebSceneRefreshConversationRowTransformForRoute(graph: var WebSceneGraph,
                                                   routeIndex: int32,
                                                   itemId: str,
                                                   offsetPx: int32,
                                                   markDirty: bool): int32 =
    let nextTransform = WebSceneConversationRowOffsetTransformValue(offsetPx)
    var matched: bool
    var touched: bool
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].propName == "data-csg-conversation-row-offset-id" &&
           graph.props[i].propValue == itemId:
            matched = true
            let nodeId = graph.props[i].nodeId
            let setStatus = WebSceneSetLatestStaticCssDeclarationValue(graph, routeIndex, nodeId, "transform", nextTransform)
            if setStatus < 0:
                return -1
            if setStatus > 0:
                let declarationIndex = WebSceneFindLatestStaticCssDeclarationIndex(graph, routeIndex, nodeId, "transform")
                if declarationIndex < 0:
                    return -1
                if WebSceneRouteHasRuntimeLayoutBox(graph, routeIndex):
                    if !WebSceneRebuildPaintOpRangeIndex(graph):
                        return -1
                    if !WebSceneApplyCssTransformDeclarationToPaintOps(graph, graph.cssDeclarations[declarationIndex]):
                        return -1
                elif markDirty:
                    if !WebSceneMarkRouteDirty(graph, routeIndex):
                        return -1
                touched = true
    if !matched:
        return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneSetConversationRowOffset(graph: var WebSceneGraph,
                                    routeIndex: int32,
                                    itemId: str,
                                    offsetPx: int32,
                                    markDirty: bool): int32 =
    var minOffsetPx = -92
    if itemId == "home_categories":
        minOffsetPx = -600
    let clamped = WebSceneMaxI32(minOffsetPx, WebSceneMinI32(0, offsetPx))
    var touched: bool
    let stateStatus = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "offsetX"), strings.IntToStr(clamped), false)
    if stateStatus < 0:
        return -1
    if stateStatus > 0:
        touched = true
    let transformStatus = WebSceneRefreshConversationRowTransformForRoute(graph, routeIndex, itemId, clamped, markDirty)
    if transformStatus < 0:
        return -1
    if transformStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyConversationRowPointerDownEffectSegment(graph: var WebSceneGraph,
                                                        segment: str,
                                                        xMilli: int32,
                                                        yMilli: int32): int32 =
    var itemId: str
    if !WebSceneConversationRowParseSingleItemEffect(segment, "conversation_row_pointer_down:", itemId):
        return -1
    var status = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "startXMilli"), strings.IntToStr(xMilli), false)
    if status < 0:
        return -1
    status = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "startYMilli"), strings.IntToStr(yMilli), false)
    if status < 0:
        return -1
    status = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "axisLock"), "null", false)
    if status < 0:
        return -1
    status = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "dragging"), "true", false)
    if status < 0:
        return -1
    return WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "moved"), "false", false)

@borrows
fn WebSceneApplyConversationRowPointerMoveEffectSegment(graph: var WebSceneGraph,
                                                        routeIndex: int32,
                                                        segment: str,
                                                        xMilli: int32,
                                                        yMilli: int32,
                                                        markDirty: bool): int32 =
    var itemId: str
    if !WebSceneConversationRowParseSingleItemEffect(segment, "conversation_row_pointer_move:", itemId):
        return -1
    if WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "dragging")) != "true":
        return 0
    var startX: int32
    var startY: int32
    if !WebSceneParseSignedEffectInt32(WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "startXMilli")), startX):
        return -1
    if !WebSceneParseSignedEffectInt32(WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "startYMilli")), startY):
        return -1
    let deltaX = xMilli - startX
    let deltaY = yMilli - startY
    var axisLock = WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "axisLock"))
    if axisLock.len == 0 || axisLock == "null":
        if WebSceneAbsI32(deltaX) < 8000 && WebSceneAbsI32(deltaY) < 8000:
            return 0
        axisLock = WebSceneAbsI32(deltaX) > WebSceneAbsI32(deltaY) ? "x" : "y"
        let axisStatus = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "axisLock"), axisLock, false)
        if axisStatus < 0:
            return -1
    elif axisLock != "x" && axisLock != "y":
        return -1
    if axisLock != "x":
        return 0
    let movedStatus = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "moved"), "true", false)
    if movedStatus < 0:
        return -1
    let offsetPx = WebSceneMaxI32(-92, WebSceneMinI32(0, WebSceneRoundMilliToPx(deltaX)))
    return WebSceneSetConversationRowOffset(graph, routeIndex, itemId, offsetPx, markDirty)

@borrows
fn WebSceneApplyConversationRowPointerEndEffectSegment(graph: var WebSceneGraph,
                                                       routeIndex: int32,
                                                       segment: str,
                                                       markDirty: bool): int32 =
    var itemId: str
    var mode: str
    if !WebSceneConversationRowParseEndEffect(segment, itemId, mode):
        return -1
    let dragging = WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "dragging"))
    if mode == "up" && dragging != "true":
        return 0
    var touched: bool
    var status = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "dragging"), "false", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "axisLock"), "null", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    if mode == "up" && WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "moved")) != "true":
        if touched && markDirty:
            if !WebSceneMarkStateDirty(graph):
                return -1
        if touched:
            return 1
        return 0
    var offsetPx: int32
    if !WebSceneConversationRowOffsetValue(graph, itemId, offsetPx):
        return -1
    if itemId == "home_categories" && mode == "up" &&
       WebSceneStateValueForRef(graph, WebSceneConversationRowStateRef(itemId, "moved")) == "true":
        let suppressStatus = WebSceneSetStateValueInternal(graph, "ref:touchClickSuppressed", "true", false)
        if suppressStatus < 0:
            return -1
    var snapOffset: int32
    if itemId == "home_categories":
        snapOffset = offsetPx
    elif WebSceneAbsI32(offsetPx) >= 38:
        snapOffset = -92
    let offsetStatus = WebSceneSetConversationRowOffset(graph, routeIndex, itemId, snapOffset, false)
    if offsetStatus < 0:
        return -1
    if offsetStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyConversationRowClickEffectSegment(graph: var WebSceneGraph,
                                                  routeIndex: int32,
                                                  segment: str,
                                                  markDirty: bool): int32 =
    var stateRef: str
    var itemId: str
    var routeId: str
    if !WebSceneConversationRowParseClickEffect(segment, stateRef, itemId, routeId):
        return -1
    var offsetPx: int32
    if !WebSceneConversationRowOffsetValue(graph, itemId, offsetPx):
        return -1
    if WebSceneAbsI32(offsetPx) > 8:
        return WebSceneSetConversationRowOffset(graph, routeIndex, itemId, 0, markDirty)
    var touched: bool
    let selectStatus = WebSceneSetStateValueInternal(graph, stateRef, itemId, false)
    if selectStatus < 0:
        return -1
    if selectStatus > 0:
        touched = true
    let previousRoute = graph.activeRouteIndex
    if !WebSceneSetActiveRouteById(graph, routeId):
        return -1
    if graph.activeRouteIndex != previousRoute:
        touched = true
    if touched:
        return 1
    return 0

@borrows
fn WebSceneHideConversationRowForRoute(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       itemId: str,
                                       markDirty: bool): int32 =
    var matched: bool
    var touched: bool
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].propName == "data-csg-conversation-row-offset-id" &&
           graph.props[i].propValue == itemId:
            matched = true
            let nodeId = graph.props[i].nodeId
            let displayStatus = WebSceneSetOrAddLayoutConstraintValue(graph, routeIndex, nodeId, "display", "none")
            if displayStatus < 0:
                return -1
            if displayStatus > 0:
                touched = true
    if !matched:
        return -1
    if !touched:
        return 0
    if WebSceneRouteHasRuntimeLayoutBox(graph, routeIndex):
        if graph.currentViewportWidth > 0 && graph.currentViewportHeight > 0:
            if !WebSceneApplyRouteLayoutToPaintOps(graph, routeIndex, graph.currentViewportWidth, graph.currentViewportHeight):
                return -1
        elif markDirty:
            if !WebSceneMarkRouteDirty(graph, routeIndex):
                return -1
    elif markDirty:
        if !WebSceneMarkRouteDirty(graph, routeIndex):
            return -1
    return 1

@borrows
fn WebSceneApplyConversationRowDeleteEffectSegment(graph: var WebSceneGraph,
                                                   routeIndex: int32,
                                                   segment: str,
                                                   markDirty: bool): int32 =
    var conversationsRef: str
    var selectedRef: str
    var itemId: str
    if !WebSceneConversationRowParseDeleteEffect(segment, conversationsRef, selectedRef, itemId):
        return -1
    let currentConversations = WebSceneStateValueForRef(graph, conversationsRef)
    var nextConversations: str
    var removed: bool
    if !WebSceneJsonArrayRemoveObjectById(currentConversations, itemId, nextConversations, removed):
        return -1
    if !removed:
        return -1
    var touched: bool
    let conversationsStatus = WebSceneSetStateValueInternal(graph, conversationsRef, nextConversations, false)
    if conversationsStatus < 0:
        return -1
    if conversationsStatus > 0:
        touched = true
    if !WebSceneWriteStorageValue(graph, WebSceneSocialConversationsStorageKey, nextConversations, touched):
        return -1
    if WebSceneStateValueForRef(graph, selectedRef) == itemId:
        let selectedStatus = WebSceneSetStateValueInternal(graph, selectedRef, "null", false)
        if selectedStatus < 0:
            return -1
        if selectedStatus > 0:
            touched = true
    let offsetStatus = WebSceneSetStateValueInternal(graph, WebSceneConversationRowStateRef(itemId, "offsetX"), "0", false)
    if offsetStatus < 0:
        return -1
    if offsetStatus > 0:
        touched = true
    let hideStatus = WebSceneHideConversationRowForRoute(graph, routeIndex, itemId, markDirty)
    if hideStatus < 0:
        return -1
    if hideStatus > 0:
        touched = true
    if itemId == "ASI_BOT":
        if !WebSceneWriteStorageValue(graph, WebSceneAsiBotDismissedStorageKey, "1", touched):
            return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneStrStartsWith(value: str, prefix: str): bool =
    if prefix.len > value.len:
        return false
    if strings.SliceBytes(value, 0, prefix.len) == prefix:
        return true
    return false

@borrows
fn WebSceneStrStartsWithAt(value: str, prefix: str, start: int32): bool =
    if start < 0:
        return false
    if prefix.len == 0:
        return true
    if start + prefix.len > value.len:
        return false
    return strings.SliceBytes(value, start, prefix.len) == prefix

@borrows
fn WebSceneStrContains(value: str, needle: str): bool =
    if needle.len == 0:
        return true
    if needle.len > value.len:
        return false
    var index: int32
    while index + needle.len <= value.len:
        if strings.SliceBytes(value, index, needle.len) == needle:
            return true
        index = index + 1
    return false

@borrows
fn WebSceneFindEffectChar(value: str, ch: char, start: int32): int32 =
    var index = start
    while index < value.len:
        if value[index] == ch:
            return index
        index = index + 1
    return -1

fn WebSceneSocialAppIdCharAllowed(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    if ch == '_' || ch == '-':
        return true
    return false

@borrows
fn WebSceneSocialAppIdAllowed(appId: str): bool =
    if appId.len == 0:
        return false
    for i in 0..<appId.len:
        if !WebSceneSocialAppIdCharAllowed(appId[i]):
            return false
    return true

@borrows
fn WebSceneSocialAppListContains(apps: var str[], appId: str): bool =
    for i in 0..<apps.len:
        if apps[i] == appId:
            return true
    return false

@borrows
fn WebSceneParseSocialAppsState(raw: str, apps: var str[]): bool =
    setLen(apps, 0)
    if raw.len == 0:
        return true
    if raw.len < 2 || raw[0] != '[' || raw[raw.len - 1] != ']':
        return false
    var pos: int32 = 1
    let endPos = raw.len - 1
    while pos < endPos:
        if raw[pos] != '"':
            return false
        pos = pos + 1
        let appStart = pos
        while pos < endPos && raw[pos] != '"':
            if raw[pos] == '\\':
                return false
            pos = pos + 1
        if pos >= endPos || raw[pos] != '"':
            return false
        let appId = strings.SliceBytes(raw, appStart, pos - appStart)
        if !WebSceneSocialAppIdAllowed(appId):
            return false
        if !WebSceneSocialAppListContains(apps, appId):
            add(apps, WebSceneCloneStateString(appId))
        pos = pos + 1
        if pos < endPos:
            if raw[pos] != ',':
                return false
            pos = pos + 1
    return true

fn WebSceneEncodeSocialAppsState(apps: var str[]): str =
    var out = "["
    for i in 0..<apps.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, "\"")
        out = strings.ConcatStr(out, apps[i])
        out = strings.ConcatStr(out, "\"")
    out = strings.ConcatStr(out, "]")
    return out

@borrows
fn WebSceneSkipJsonWhitespace(raw: str, pos: int32): int32 =
    var i = pos
    while i < raw.len:
        let ch = raw[i]
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r':
            i = i + 1
        else:
            return i
    return i

@borrows
fn WebSceneJsonTopLevelArrayItemCount(raw: str, outCount: var int32): bool =
    outCount = 0
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = pos + 1
    var depth: int32
    var inString: bool
    var escaped: bool
    var itemStarted: bool
    var afterComma: bool
    while pos < raw.len:
        let ch = raw[pos]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
            pos = pos + 1
            continue
        if ch == '"':
            inString = true
            itemStarted = true
            afterComma = false
        elif ch == '[' || ch == '{':
            depth = depth + 1
            itemStarted = true
            afterComma = false
        elif ch == ']':
            if depth == 0:
                if afterComma:
                    return false
                if itemStarted:
                    outCount = outCount + 1
                pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
                return pos == raw.len
            depth = depth - 1
        elif ch == '}':
            if depth <= 0:
                return false
            depth = depth - 1
        elif ch == ',' && depth == 0:
            if !itemStarted:
                return false
            outCount = outCount + 1
            itemStarted = false
            afterComma = true
        elif ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r':
            ch
        else:
            itemStarted = true
            afterComma = false
        pos = pos + 1
    return false

fn WebSceneJsonStringArrayAppendEscapedChar(out: str, ch: char): str =
    if ch == '"':
        return strings.ConcatStr(out, "\\\"")
    if ch == '\\':
        return strings.ConcatStr(out, "\\\\")
    if ch == '\n':
        return strings.ConcatStr(out, "\\n")
    if ch == '\r':
        return strings.ConcatStr(out, "\\r")
    if ch == '\t':
        return strings.ConcatStr(out, "\\t")
    return strings.ConcatStr(out, strings.CharToStr(ch))

@borrows
fn WebSceneJsonStringArrayParseString(raw: str, pos: var int32, out: var str): bool =
    if pos >= raw.len || raw[pos] != '"':
        return false
    pos = pos + 1
    out = ""
    while pos < raw.len:
        let ch = raw[pos]
        if ch == '"':
            pos = pos + 1
            return true
        if ch == '\\':
            pos = pos + 1
            if pos >= raw.len:
                return false
            let esc = raw[pos]
            if esc == '"':
                out = strings.ConcatStr(out, "\"")
            elif esc == '\\':
                out = strings.ConcatStr(out, "\\")
            elif esc == '/':
                out = strings.ConcatStr(out, "/")
            elif esc == 'b':
                out = strings.ConcatStr(out, strings.CharToStr(char(8)))
            elif esc == 'f':
                out = strings.ConcatStr(out, strings.CharToStr(char(12)))
            elif esc == 'n':
                out = strings.ConcatStr(out, "\n")
            elif esc == 'r':
                out = strings.ConcatStr(out, "\r")
            elif esc == 't':
                out = strings.ConcatStr(out, "\t")
            elif esc == 'u':
                if pos + 4 >= raw.len:
                    return false
                var code: int32
                for k in 0..<4:
                    let d = raw[pos + 1 + k]
                    if d >= '0' && d <= '9':
                        code = code * 16 + int32(d) - int32('0')
                    elif d >= 'a' && d <= 'f':
                        code = code * 16 + int32(d) - int32('a') + 10
                    elif d >= 'A' && d <= 'F':
                        code = code * 16 + int32(d) - int32('A') + 10
                    else:
                        return false
                if code > 255:
                    return false
                out = strings.ConcatStr(out, strings.CharToStr(char(code)))
                pos = pos + 4
            else:
                return false
        else:
            if int32(ch) < 32:
                return false
            let charStart: int32 = pos
            let charLen: int32 = 1
            out = strings.ConcatStr(out, strings.SliceBytes(raw, charStart, charLen))
        pos = pos + 1
    return false

@borrows
fn WebSceneJsonTrimRightWhitespace(raw: str, startPos: int32, endPos: int32): int32 =
    var endIndex = endPos
    while endIndex > startPos:
        let ch = raw[endIndex - 1]
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r':
            endIndex = endIndex - 1
        else:
            return endIndex
    return endIndex

fn WebSceneJsonHexDigitAllowed(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    if ch >= 'A' && ch <= 'F':
        return true
    return false

@borrows
fn WebSceneJsonSkipStringValue(raw: str, pos: var int32): bool =
    if pos >= raw.len || raw[pos] != '"':
        return false
    pos = pos + 1
    while pos < raw.len:
        let ch = raw[pos]
        if ch == '"':
            pos = pos + 1
            return true
        if ch == '\\':
            pos = pos + 1
            if pos >= raw.len:
                return false
            if raw[pos] == 'u':
                if pos + 4 >= raw.len:
                    return false
                for k in 0..<4:
                    if !WebSceneJsonHexDigitAllowed(raw[pos + 1 + k]):
                        return false
                pos = pos + 4
        elif int32(ch) < 32:
            return false
        pos = pos + 1
    return false

@borrows
fn WebSceneJsonSkipContainerValue(raw: str, pos: var int32): bool =
    if pos >= raw.len:
        return false
    if raw[pos] != '{' && raw[pos] != '[':
        return false
    var stack: char[]
    add(stack, raw[pos])
    pos = pos + 1
    while pos < raw.len:
        let ch = raw[pos]
        if ch == '"':
            if !WebSceneJsonSkipStringValue(raw, pos):
                return false
            continue
        elif ch == '{' || ch == '[':
            add(stack, ch)
        elif ch == '}' || ch == ']':
            if stack.len <= 0:
                return false
            let expectedOpen = ch == '}' ? '{' : '['
            if stack[stack.len - 1] != expectedOpen:
                return false
            setLen(stack, stack.len - 1)
            if stack.len == 0:
                pos = pos + 1
                return true
        pos = pos + 1
    return false

@borrows
fn WebSceneJsonSkipValue(raw: str, startPos: int32, outEndPos: var int32): bool =
    var pos = WebSceneSkipJsonWhitespace(raw, startPos)
    if pos >= raw.len:
        return false
    let ch = raw[pos]
    if ch == '"':
        if !WebSceneJsonSkipStringValue(raw, pos):
            return false
        outEndPos = pos
        return true
    if ch == '{' || ch == '[':
        if !WebSceneJsonSkipContainerValue(raw, pos):
            return false
        outEndPos = pos
        return true
    let valueStart = pos
    while pos < raw.len:
        let item = raw[pos]
        if item == ',' || item == ']' || item == '}' || item == ' ' || item == '\t' || item == '\n' || item == '\r':
            break
        pos = pos + 1
    if pos == valueStart:
        return false
    outEndPos = pos
    return true

@borrows
fn WebSceneJsonObjectStringFieldMatchStatus(raw: str,
                                            startPos: int32,
                                            endPos: int32,
                                            fieldName: str,
                                            expectedValue: str): int32 =
    var pos = WebSceneSkipJsonWhitespace(raw, startPos)
    if pos >= endPos || raw[pos] != '{':
        return -1
    pos = pos + 1
    var sawField: bool
    while pos < endPos:
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= endPos:
            return -1
        if raw[pos] == '}':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            if pos != endPos:
                return -1
            if sawField:
                return 0
            return -1
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return -1
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= endPos || raw[pos] != ':':
            return -1
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        let valueStart = pos
        var valueEnd: int32
        if !WebSceneJsonSkipValue(raw, valueStart, valueEnd):
            return -1
        if key == fieldName:
            sawField = true
            var valuePos = valueStart
            var stringValue: str
            if !WebSceneJsonStringArrayParseString(raw, valuePos, stringValue):
                return -1
            valuePos = WebSceneSkipJsonWhitespace(raw, valuePos)
            if valuePos != valueEnd:
                return -1
            if stringValue == expectedValue:
                return 1
        pos = WebSceneSkipJsonWhitespace(raw, valueEnd)
        if pos >= endPos:
            return -1
        if raw[pos] == ',':
            pos = pos + 1
        elif raw[pos] == '}':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            if pos != endPos:
                return -1
            if sawField:
                return 0
            return -1
        else:
            return -1
    return -1

@borrows
fn WebSceneJsonArrayRemoveObjectById(raw: str,
                                     itemId: str,
                                     outRaw: var str,
                                     outRemoved: var bool): bool =
    outRaw = "[]"
    outRemoved = false
    if !WebSceneConversationRowItemIdAllowed(itemId):
        return false
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        return pos == raw.len
    var keptCount: int32
    var nextRaw = "["
    while pos < raw.len:
        let itemStart = WebSceneSkipJsonWhitespace(raw, pos)
        var itemEnd: int32
        if !WebSceneJsonSkipValue(raw, itemStart, itemEnd):
            return false
        let trimmedEnd = WebSceneJsonTrimRightWhitespace(raw, itemStart, itemEnd)
        let matchStatus = WebSceneJsonObjectStringFieldMatchStatus(raw, itemStart, trimmedEnd, "id", itemId)
        if matchStatus < 0:
            return false
        if matchStatus == 1:
            outRemoved = true
        else:
            if keptCount > 0:
                nextRaw = strings.ConcatStr(nextRaw, ",")
            nextRaw = strings.ConcatStr(nextRaw, strings.SliceBytes(raw, itemStart, trimmedEnd - itemStart))
            keptCount = keptCount + 1
        pos = WebSceneSkipJsonWhitespace(raw, itemEnd)
        if pos >= raw.len:
            return false
        if raw[pos] == ',':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        elif raw[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            if pos != raw.len:
                return false
            outRaw = strings.ConcatStr(nextRaw, "]")
            return true
        else:
            return false
    return false

@borrows
fn WebSceneParseJsonStringArrayState(raw: str, items: var str[]): bool =
    setLen(items, 0)
    if raw.len == 0:
        return true
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = pos + 1
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos < raw.len && raw[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        return pos == raw.len
    while pos < raw.len:
        var item: str
        if !WebSceneJsonStringArrayParseString(raw, pos, item):
            return false
        add(items, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            return pos == raw.len
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

fn WebSceneEncodeJsonStringArrayState(items: var str[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, "\"")
        for j in 0..<items[i].len:
            out = WebSceneJsonStringArrayAppendEscapedChar(out, items[i][j])
        out = strings.ConcatStr(out, "\"")
    out = strings.ConcatStr(out, "]")
    return out

@borrows
fn WebSceneJsonNumberArrayParseInt(raw: str, pos: var int32, out: var int32): bool =
    let start = pos
    while pos < raw.len && WebSceneIsAsciiDigit(raw[pos]):
        pos = pos + 1
    if pos == start:
        return false
    let text = strings.SliceBytes(raw, start, pos - start)
    return WebSceneParseEffectInt32(text, out)

@borrows
fn WebSceneParseJsonNumberArrayState(raw: str, items: var int32[]): bool =
    setLen(items, 0)
    if raw.len == 0:
        return true
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = pos + 1
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos < raw.len && raw[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        return pos == raw.len
    while pos < raw.len:
        var item: int32
        if !WebSceneJsonNumberArrayParseInt(raw, pos, item):
            return false
        add(items, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            return pos == raw.len
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

fn WebSceneEncodeJsonNumberArrayState(items: var int32[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, strings.IntToStr(items[i]))
    out = strings.ConcatStr(out, "]")
    return out

fn WebSceneJsonNumberArrayContains(items: var int32[], value: int32): bool =
    for i in 0..<items.len:
        if items[i] == value:
            return true
    return false

@borrows
fn WebSceneToggleJsonNumberSetStateInternal(graph: var WebSceneGraph, stateRef: str, item: int32, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    var items: int32[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if !WebSceneParseJsonNumberArrayState(current, items):
        return -1
    var nextItems: int32[]
    var removed: bool
    for i in 0..<items.len:
        if items[i] == item:
            removed = true
        else:
            if !WebSceneJsonNumberArrayContains(nextItems, items[i]):
                add(nextItems, items[i])
    if !removed:
        add(nextItems, item)
    let nextValue = WebSceneEncodeJsonNumberArrayState(nextItems)
    return WebSceneSetStateValueInternal(graph, stateRef, nextValue, markDirty)

@borrows
fn WebSceneSetJsonNumberSetItemStateInternal(graph: var WebSceneGraph,
                                             stateRef: str,
                                             item: int32,
                                             selected: bool,
                                             markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    var items: int32[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if !WebSceneParseJsonNumberArrayState(current, items):
        return -1
    var nextItems: int32[]
    var hadItem: bool
    for i in 0..<items.len:
        if items[i] == item:
            hadItem = true
            if selected && !WebSceneJsonNumberArrayContains(nextItems, items[i]):
                add(nextItems, items[i])
        else:
            if !WebSceneJsonNumberArrayContains(nextItems, items[i]):
                add(nextItems, items[i])
    if selected && !hadItem:
        add(nextItems, item)
    if selected == hadItem && nextItems.len == items.len:
        return 0
    let nextValue = WebSceneEncodeJsonNumberArrayState(nextItems)
    return WebSceneSetStateValueInternal(graph, stateRef, nextValue, markDirty)

@borrows
fn WebSceneAppendStringArrayStateValueInternal(graph: var WebSceneGraph, stateRef: str, value: str, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    var items: str[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if !WebSceneParseJsonStringArrayState(current, items):
        return -1
    add(items, WebSceneCloneStateString(value))
    let nextValue = WebSceneEncodeJsonStringArrayState(items)
    return WebSceneSetStateValueInternal(graph, stateRef, nextValue, markDirty)

@borrows
fn WebSceneAppendStringArrayStateValue(graph: var WebSceneGraph, stateRef: str, value: str): bool =
    if WebSceneAppendStringArrayStateValueInternal(graph, stateRef, value, true) >= 0:
        return true
    return false

@borrows
@borrow_result
fn WebSceneTrimAsciiWhitespace(value: str): str =
    var start: int32
    var stop = value.len
    while start < stop && WebSceneAsciiWhitespace(value[start]):
        start = start + 1
    while stop > start && WebSceneAsciiWhitespace(value[stop - 1]):
        stop = stop - 1
    return strings.SliceBytes(value, start, stop - start)

@borrows
fn WebSceneJsonEncodeString(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        out = WebSceneJsonStringArrayAppendEscapedChar(out, value[i])
    out = strings.ConcatStr(out, "\"")
    return out

@borrows
fn WebSceneJsonArrayAppendValue(raw: str, value: str, outRaw: var str): bool =
    outRaw = "[]"
    let current = WebSceneTrimAsciiWhitespace(raw)
    if current.len == 0:
        outRaw = strings.ConcatStr(strings.ConcatStr("[", WebSceneCloneStateString(value)), "]")
        return true
    var pos = WebSceneSkipJsonWhitespace(current, 0)
    if pos >= current.len || current[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(current, pos + 1)
    if pos < current.len && current[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(current, pos + 1)
        if pos != current.len:
            return false
        outRaw = strings.ConcatStr(strings.ConcatStr("[", WebSceneCloneStateString(value)), "]")
        return true
    var next = "["
    var itemIndex: int32
    while pos < current.len:
        let itemStart = WebSceneSkipJsonWhitespace(current, pos)
        var itemEnd: int32
        if !WebSceneJsonSkipValue(current, itemStart, itemEnd):
            return false
        let trimmedEnd = WebSceneJsonTrimRightWhitespace(current, itemStart, itemEnd)
        if itemIndex > 0:
            next = strings.ConcatStr(next, ",")
        next = strings.ConcatStr(next, WebSceneCloneStateString(strings.SliceBytes(current, itemStart, trimmedEnd - itemStart)))
        itemIndex = itemIndex + 1
        pos = WebSceneSkipJsonWhitespace(current, itemEnd)
        if pos >= current.len:
            return false
        if current[pos] == ',':
            pos = WebSceneSkipJsonWhitespace(current, pos + 1)
            if pos < current.len && current[pos] == ']':
                return false
            continue
        if current[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(current, pos + 1)
            if pos != current.len:
                return false
            next = strings.ConcatStr(next, ",")
            next = strings.ConcatStr(next, WebSceneCloneStateString(value))
            next = strings.ConcatStr(next, "]")
            outRaw = next
            return true
        return false
    return false

@borrows
fn WebSceneParsePositiveDecimalCents(raw: str, outCents: var int32): bool =
    outCents = 0
    let value = WebSceneTrimAsciiWhitespace(raw)
    if value.len == 0:
        return false
    var i: int32
    if value[0] == '+':
        i = 1
    elif value[0] == '-':
        return false
    if i >= value.len:
        return false
    var hadDigit: bool
    var whole: int64
    while i < value.len && WebSceneIsAsciiDigit(value[i]):
        hadDigit = true
        whole = whole * int64(10) + int64(WebSceneAsciiDigitValue(value[i]))
        if whole > int64(21474836):
            return false
        i = i + 1
    var frac: int32
    var fracDigits: int32
    var roundUp: bool
    if i < value.len && value[i] == '.':
        i = i + 1
        while i < value.len && WebSceneIsAsciiDigit(value[i]):
            hadDigit = true
            if fracDigits == 0:
                frac = WebSceneAsciiDigitValue(value[i]) * 10
            elif fracDigits == 1:
                frac = frac + WebSceneAsciiDigitValue(value[i])
            elif fracDigits == 2:
                if WebSceneAsciiDigitValue(value[i]) >= 5:
                    roundUp = true
            elif WebSceneAsciiDigitValue(value[i]) > 0:
                roundUp = true
            fracDigits = fracDigits + 1
            i = i + 1
        if fracDigits == 0:
            frac = 0
    if !hadDigit || i != value.len:
        return false
    var cents64 = whole * int64(100) + int64(frac)
    if roundUp:
        cents64 = cents64 + int64(1)
    if cents64 <= int64(0) || cents64 > int64(2147483647):
        return false
    outCents = int32(cents64)
    return true

fn WebSceneEncodeCentsFixed2(cents: int32): str =
    let whole = cents / 100
    let frac = cents % 100
    var fracText = strings.IntToStr(frac)
    if frac < 10:
        fracText = strings.ConcatStr("0", fracText)
    return strings.ConcatStr(strings.ConcatStr(strings.IntToStr(whole), "."), fracText)

@borrows
fn WebSceneChatMessageNextId(graph: var WebSceneGraph, messagesRef: str, currentMessages: str, outId: var int32): bool =
    let nextRef = strings.ConcatStr(WebSceneCloneStateString(messagesRef), ".__nextId")
    let nextIndex = WebSceneFindStateIndex(graph, nextRef)
    if nextIndex >= 0:
        if !WebSceneParseEffectInt32(graph.stateEntries[nextIndex].value, outId):
            return false
    else:
        var count: int32
        if !WebSceneJsonTopLevelArrayItemCount(currentMessages, count):
            count = 0
        outId = count + 1
    if outId <= 0 || outId >= 2147483647:
        return false
    return true

fn WebSceneEncodeRedPacketMessage(nextId: int32, content: str, amountText: str): str =
    let id = strings.ConcatStr("msg_", strings.IntToStr(nextId))
    let timestamp = strings.Int64ToStr(int64(1700000000000) + int64(nextId))
    var out = "{"
    out = strings.ConcatStr(out, "\"id\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(id))
    out = strings.ConcatStr(out, ",\"timestamp\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"sender\":\"me\",\"type\":\"redPacket\",\"content\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"status\":\"pending\",\"statusUpdatedAt\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"extra\":{\"redPacketAmount\":")
    out = strings.ConcatStr(out, amountText)
    out = strings.ConcatStr(out, ",\"redPacketMessage\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, "}}")
    return out

@borrows
fn WebSceneEncodeLocationMessage(nextId: int32, content: str): str =
    let id = strings.ConcatStr("msg_", strings.IntToStr(nextId))
    let timestamp = strings.Int64ToStr(int64(1700000000000) + int64(nextId))
    var out = "{"
    out = strings.ConcatStr(out, "\"id\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(id))
    out = strings.ConcatStr(out, ",\"timestamp\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"sender\":\"me\",\"type\":\"location\",\"content\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"status\":\"pending\",\"statusUpdatedAt\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"extra\":{\"locationName\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"capturedAt\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, "}}")
    return out

@borrows
fn WebSceneEncodeTextMessage(nextId: int32, content: str): str =
    let id = strings.ConcatStr("msg_", strings.IntToStr(nextId))
    let timestamp = strings.Int64ToStr(int64(1700000000000) + int64(nextId))
    var out = "{"
    out = strings.ConcatStr(out, "\"id\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(id))
    out = strings.ConcatStr(out, ",\"timestamp\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"sender\":\"me\",\"type\":\"text\",\"content\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"status\":\"pending\",\"statusUpdatedAt\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, "}")
    return out

@borrows
fn WebSceneJsonParseLiteral(raw: str, pos: var int32, literal: str): bool =
    if literal.len == 0 || pos + literal.len > raw.len:
        return false
    for i in 0..<literal.len:
        if raw[pos + i] != literal[i]:
            return false
    pos = pos + literal.len
    return true

@borrows
fn WebSceneJsonParseBool(raw: str, pos: var int32, out: var bool): bool =
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if WebSceneJsonParseLiteral(raw, pos, "true"):
        out = true
        return true
    if WebSceneJsonParseLiteral(raw, pos, "false"):
        out = false
        return true
    return false

@borrows
fn WebSceneNodeRemarkEntryIndex(items: var WebSceneNodeRemarkEntry[], peerId: str): int32 =
    for i in 0..<items.len:
        if items[i].peerId == peerId:
            return i
    return -1

@borrows
fn WebSceneParseNodeRemarkObjectState(raw: str, items: var WebSceneNodeRemarkEntry[]): bool =
    setLen(items, 0)
    if raw.len == 0:
        return true
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == '}':
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        return pos == raw.len
    while pos < raw.len:
        var peerId: str
        if !WebSceneJsonStringArrayParseString(raw, pos, peerId):
            return false
        if !WebSceneNodeDetailPeerIdAllowed(peerId):
            return false
        if WebSceneNodeRemarkEntryIndex(items, peerId) >= 0:
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        var remark: str
        if !WebSceneJsonStringArrayParseString(raw, pos, remark):
            return false
        remark = WebSceneTrimAsciiWhitespace(remark)
        if remark.len > 0:
            var entry: WebSceneNodeRemarkEntry
            entry.peerId = peerId
            entry.remark = remark
            add(items, entry)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            return pos == raw.len
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

fn WebSceneEncodeNodeRemarkObjectState(items: var WebSceneNodeRemarkEntry[]): str =
    var out = "{"
    var emitted: int32
    for i in 0..<items.len:
        let peerId = items[i].peerId
        let remark = WebSceneTrimAsciiWhitespace(items[i].remark)
        if peerId.len == 0 || remark.len == 0:
            continue
        if emitted > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, WebSceneJsonEncodeString(peerId))
        out = strings.ConcatStr(out, ":")
        out = strings.ConcatStr(out, WebSceneJsonEncodeString(remark))
        emitted = emitted + 1
    out = strings.ConcatStr(out, "}")
    return out

@borrows
fn WebSceneNodeRemarkCurrentItems(graph: var WebSceneGraph,
                                  remarksRef: str,
                                  storageKey: str,
                                  items: var WebSceneNodeRemarkEntry[]): bool =
    var raw = WebSceneStateValueForRef(graph, remarksRef)
    if raw.len == 0 && storageKey.len > 0:
        raw = WebSceneStorageValueForKey(graph, storageKey)
    return WebSceneParseNodeRemarkObjectState(raw, items)

@borrows
fn WebSceneNodeRemarkValueForPeer(items: var WebSceneNodeRemarkEntry[], peerId: str): str =
    let index = WebSceneNodeRemarkEntryIndex(items, peerId)
    if index < 0:
        return ""
    return items[index].remark

fn WebSceneNodeRemarkTitle(peerId: str, remark: str): str =
    let trimmed = WebSceneTrimAsciiWhitespace(remark)
    if trimmed.len == 0:
        return peerId
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("(", trimmed), ")"), peerId)

fn WebSceneNodeRemarkSubtitle(peerId: str, remark: str): str =
    let trimmed = WebSceneTrimAsciiWhitespace(remark)
    if trimmed.len == 0:
        return "点击设置备注"
    return peerId

@borrows
fn WebSceneSetNodeRemarkState(graph: var WebSceneGraph,
                              stateRef: str,
                              value: str,
                              touched: var bool): bool =
    let status = WebSceneSetStateValueInternal(graph, stateRef, value, false)
    if status < 0:
        return false
    if status > 0:
        touched = true
    return true

@borrows
fn WebSceneRefreshNodeRemarkVisibleState(graph: var WebSceneGraph,
                                         peerId: str,
                                         remark: str,
                                         draftRef: str,
                                         editingRef: str,
                                         touched: var bool): bool =
    # Spec migration: under @borrows the ref/peer/remark formals are borrow
    # views and the state/key builders consume owned values; clone at each
    # edge (storage-station precedent).
    if !WebSceneSetNodeRemarkState(graph, "remark", strings.CloneStr(remark), touched):
        return false
    if !WebSceneSetNodeRemarkState(graph, strings.CloneStr(draftRef), strings.CloneStr(remark), touched):
        return false
    if !WebSceneSetNodeRemarkState(graph, strings.CloneStr(editingRef), "false", touched):
        return false
    if !WebSceneSetNodeRemarkState(graph, "title", WebSceneNodeRemarkTitle(strings.CloneStr(peerId), strings.CloneStr(remark)), touched):
        return false
    if !WebSceneSetNodeRemarkState(graph, "subtitle", WebSceneNodeRemarkSubtitle(strings.CloneStr(peerId), strings.CloneStr(remark)), touched):
        return false
    return true

@borrows
fn WebSceneApplyNodeRemarkCancelEffectSegment(graph: var WebSceneGraph,
                                              segment: str,
                                              markDirty: bool): int32 =
    let prefix = "node_remark_cancel:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let remarksRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let draftRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let editingRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let peerRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    if remarksRef.len == 0 || draftRef.len == 0 || editingRef.len == 0 || peerRef.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 4).len > 0:
        return -1
    let peerId = WebSceneStateValueForRef(graph, peerRef)
    if !WebSceneNodeDetailPeerIdAllowed(peerId):
        return -1
    var items: WebSceneNodeRemarkEntry[]
    if !WebSceneNodeRemarkCurrentItems(graph, remarksRef, "", items):
        return -1
    let remark = WebSceneNodeRemarkValueForPeer(items, peerId)
    var touched: bool
    if !WebSceneRefreshNodeRemarkVisibleState(graph, peerId, remark, draftRef, editingRef, touched):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyNodeRemarkSaveEffectSegment(graph: var WebSceneGraph,
                                            segment: str,
                                            markDirty: bool): int32 =
    let prefix = "node_remark_save:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let remarksRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let draftRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let editingRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let peerRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let storageKey = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    if remarksRef.len == 0 || draftRef.len == 0 || editingRef.len == 0 || peerRef.len == 0 || storageKey.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 5).len > 0:
        return -1
    let peerId = WebSceneStateValueForRef(graph, peerRef)
    if !WebSceneNodeDetailPeerIdAllowed(peerId):
        return -1
    let remark = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, draftRef))
    var items: WebSceneNodeRemarkEntry[]
    if !WebSceneNodeRemarkCurrentItems(graph, remarksRef, storageKey, items):
        return -1
    let index = WebSceneNodeRemarkEntryIndex(items, peerId)
    if remark.len == 0:
        if index >= 0:
            var nextItems: WebSceneNodeRemarkEntry[]
            for i in 0..<items.len:
                if i != index:
                    var keepRemark: WebSceneNodeRemarkEntry
                    if !WebSceneNodeRemarkEntryCloneFromSeq(items, i, keepRemark):
                        return false
                    add(nextItems, keepRemark)
            items = nextItems
    elif index >= 0:
        items[index].remark = WebSceneCloneStateString(remark)
    else:
        var entry: WebSceneNodeRemarkEntry
        entry.peerId = WebSceneCloneStateString(peerId)
        entry.remark = WebSceneCloneStateString(remark)
        add(items, entry)
    let encoded = WebSceneEncodeNodeRemarkObjectState(items)
    var touched: bool
    if !WebSceneSetNodeRemarkState(graph, remarksRef, encoded, touched):
        return -1
    if !WebSceneWriteStorageValue(graph, storageKey, encoded, touched):
        return -1
    if !WebSceneRefreshNodeRemarkVisibleState(graph, peerId, remark, draftRef, editingRef, touched):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyNodeRemarkKeyDownEffectSegment(graph: var WebSceneGraph,
                                               segment: str,
                                               eventKey: str,
                                               markDirty: bool): int32 =
    let prefix = "node_remark_keydown:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let remarksRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let draftRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let editingRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let peerRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let storageKey = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    if remarksRef.len == 0 || draftRef.len == 0 || editingRef.len == 0 || peerRef.len == 0 || storageKey.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 5).len > 0:
        return -1
    if eventKey == "Escape":
        var cancelEffect = "node_remark_cancel:"
        cancelEffect = strings.ConcatStr(cancelEffect, remarksRef)
        cancelEffect = strings.ConcatStr(cancelEffect, ":")
        cancelEffect = strings.ConcatStr(cancelEffect, draftRef)
        cancelEffect = strings.ConcatStr(cancelEffect, ":")
        cancelEffect = strings.ConcatStr(cancelEffect, editingRef)
        cancelEffect = strings.ConcatStr(cancelEffect, ":")
        cancelEffect = strings.ConcatStr(cancelEffect, peerRef)
        return WebSceneApplyNodeRemarkCancelEffectSegment(graph, cancelEffect, markDirty)
    if eventKey == "Enter":
        var saveEffect = "node_remark_save:"
        saveEffect = strings.ConcatStr(saveEffect, remarksRef)
        saveEffect = strings.ConcatStr(saveEffect, ":")
        saveEffect = strings.ConcatStr(saveEffect, draftRef)
        saveEffect = strings.ConcatStr(saveEffect, ":")
        saveEffect = strings.ConcatStr(saveEffect, editingRef)
        saveEffect = strings.ConcatStr(saveEffect, ":")
        saveEffect = strings.ConcatStr(saveEffect, peerRef)
        saveEffect = strings.ConcatStr(saveEffect, ":")
        saveEffect = strings.ConcatStr(saveEffect, storageKey)
        return WebSceneApplyNodeRemarkSaveEffectSegment(graph, saveEffect, markDirty)
    return 0

fn WebSceneProfileAddressReset(record: var WebSceneProfileAddressRecord) =
    record.id = ""
    record.receiver = ""
    record.phone = ""
    record.region = ""
    record.detail = ""
    record.tag = ""
    record.isDefault = false

@borrows
fn WebSceneParseProfileAddressRecord(raw: str, pos: var int32, out: var WebSceneProfileAddressRecord): bool =
    WebSceneProfileAddressReset(out)
    var seenId: bool
    var seenReceiver: bool
    var seenPhone: bool
    var seenRegion: bool
    var seenDetail: bool
    var seenTag: bool
    var seenDefault: bool
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == '}':
        return false
    while pos < raw.len:
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        if key == "id":
            if seenId:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.id):
                return false
            seenId = true
        elif key == "receiver":
            if seenReceiver:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.receiver):
                return false
            seenReceiver = true
        elif key == "phone":
            if seenPhone:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.phone):
                return false
            seenPhone = true
        elif key == "region":
            if seenRegion:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.region):
                return false
            seenRegion = true
        elif key == "detail":
            if seenDetail:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.detail):
                return false
            seenDetail = true
        elif key == "tag":
            if seenTag:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.tag):
                return false
            seenTag = true
        elif key == "isDefault":
            if seenDefault:
                return false
            if !WebSceneJsonParseBool(raw, pos, out.isDefault):
                return false
            seenDefault = true
        else:
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            pos = pos + 1
            return seenId && seenReceiver && seenPhone && seenRegion && seenDetail && seenTag && seenDefault
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneParseProfileAddressArrayState(raw: str, items: var WebSceneProfileAddressRecord[]): bool =
    setLen(items, 0)
    if raw.len == 0:
        return true
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        return pos == raw.len
    while pos < raw.len:
        var item: WebSceneProfileAddressRecord
        if !WebSceneParseProfileAddressRecord(raw, pos, item):
            return false
        add(items, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            return pos == raw.len
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

fn WebSceneAppendProfileAddressStringField(out: str, key: str, value: str, comma: bool): str =
    var next = out
    if comma:
        next = strings.ConcatStr(next, ",")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(key))
    next = strings.ConcatStr(next, ":")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(value))
    return next

fn WebSceneAppendProfileAddressBoolField(out: str, key: str, value: bool, comma: bool): str =
    var next = out
    if comma:
        next = strings.ConcatStr(next, ",")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(key))
    next = strings.ConcatStr(next, ":")
    if value:
        next = strings.ConcatStr(next, "true")
    else:
        next = strings.ConcatStr(next, "false")
    return next

@borrows
fn WebSceneEncodeProfileAddressRecord(record: WebSceneProfileAddressRecord): str =
    var out = "{"
    # Spec migration: a managed field read yields a borrow view, and a borrowed
    # actual cannot bind a non-var non-@borrows formal. Clone each field-read
    # source into an owned value (storage-station precedent).
    out = WebSceneAppendProfileAddressStringField(out, "id", strings.CloneStr(record.id), false)
    out = WebSceneAppendProfileAddressStringField(out, "receiver", strings.CloneStr(record.receiver), true)
    out = WebSceneAppendProfileAddressStringField(out, "phone", strings.CloneStr(record.phone), true)
    out = WebSceneAppendProfileAddressStringField(out, "region", strings.CloneStr(record.region), true)
    out = WebSceneAppendProfileAddressStringField(out, "detail", strings.CloneStr(record.detail), true)
    out = WebSceneAppendProfileAddressStringField(out, "tag", strings.CloneStr(record.tag), true)
    out = WebSceneAppendProfileAddressBoolField(out, "isDefault", record.isDefault, true)
    out = strings.ConcatStr(out, "}")
    return out

fn WebSceneEncodeProfileAddressArrayState(items: var WebSceneProfileAddressRecord[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, WebSceneEncodeProfileAddressRecord(items[i]))
    out = strings.ConcatStr(out, "]")
    return out

# ===== CHT mechanism 12: WebSceneIceCandidateRecord[] KV codec =====
# Same production JSON-object-per-element scheme as WebSceneProfileAddressRecord above (hand-audited
# field list, exhaustive key dispatch, no unknown-key tolerance) — a fresh field-by-field encoder, not
# a JS-host convenience like JSON.stringify (this produces Cheng source consumed only by the Cheng
# runtime's own parser). `sdpMLineIndex` is parsed as an unsigned decimal (a WebRTC m-line index is
# never negative), guarded by `sdpMLineIndexPresent` for lossless round-trip of the "field omitted"
# case (0 is a real, legitimate m-line index, not a sentinel for "absent").

@borrows
fn WebSceneJsonIceCandidateParseInt64(raw: str, pos: var int32, out: var int64): bool =
    let start = pos
    while pos < raw.len && WebSceneIsAsciiDigit(raw[pos]):
        pos = pos + 1
    if pos == start:
        return false
    var acc = int64(0)
    var i = start
    while i < pos:
        acc = acc * int64(10) + int64(WebSceneAsciiDigitValue(raw[i]))
        i = i + 1
    out = acc
    return true

fn WebSceneIceCandidateReset(record: var WebSceneIceCandidateRecord) =
    record.candidate = ""
    record.sdpMid = ""
    record.sdpMLineIndexPresent = false
    record.sdpMLineIndex = int64(0)

@borrows
fn WebSceneParseIceCandidateRecord(raw: str, pos: var int32, out: var WebSceneIceCandidateRecord): bool =
    WebSceneIceCandidateReset(out)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    var seenCandidate = false
    var seenSdpMid = false
    var seenSdpMLineIndexPresent = false
    var seenSdpMLineIndex = false
    if pos < raw.len && raw[pos] == '}':
        return false
    while pos < raw.len:
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        if key == "candidate":
            if seenCandidate:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.candidate):
                return false
            seenCandidate = true
        elif key == "sdpMid":
            if seenSdpMid:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.sdpMid):
                return false
            seenSdpMid = true
        elif key == "sdpMLineIndexPresent":
            if seenSdpMLineIndexPresent:
                return false
            if !WebSceneJsonParseBool(raw, pos, out.sdpMLineIndexPresent):
                return false
            seenSdpMLineIndexPresent = true
        elif key == "sdpMLineIndex":
            if seenSdpMLineIndex:
                return false
            if !WebSceneJsonIceCandidateParseInt64(raw, pos, out.sdpMLineIndex):
                return false
            seenSdpMLineIndex = true
        else:
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            pos = pos + 1
            return seenCandidate && seenSdpMid && seenSdpMLineIndexPresent && seenSdpMLineIndex
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneAppendIceCandidateStringField(out: str, key: str, value: str, comma: bool): str =
    var next = out
    if comma:
        next = strings.ConcatStr(next, ",")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(key))
    next = strings.ConcatStr(next, ":")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(value))
    return next

fn WebSceneAppendIceCandidateBoolField(out: str, key: str, value: bool, comma: bool): str =
    var next = out
    if comma:
        next = strings.ConcatStr(next, ",")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(key))
    next = strings.ConcatStr(next, ":")
    if value:
        next = strings.ConcatStr(next, "true")
    else:
        next = strings.ConcatStr(next, "false")
    return next

fn WebSceneAppendIceCandidateInt64Field(out: str, key: str, value: int64, comma: bool): str =
    var next = out
    if comma:
        next = strings.ConcatStr(next, ",")
    next = strings.ConcatStr(next, WebSceneJsonEncodeString(key))
    next = strings.ConcatStr(next, ":")
    next = strings.ConcatStr(next, strings.Int64ToStr(value))
    return next

@borrows
fn WebSceneEncodeIceCandidateRecord(record: WebSceneIceCandidateRecord): str =
    var out = "{"
    out = WebSceneAppendIceCandidateStringField(out, "candidate", record.candidate, false)
    out = WebSceneAppendIceCandidateStringField(out, "sdpMid", record.sdpMid, true)
    out = WebSceneAppendIceCandidateBoolField(out, "sdpMLineIndexPresent", record.sdpMLineIndexPresent, true)
    out = WebSceneAppendIceCandidateInt64Field(out, "sdpMLineIndex", record.sdpMLineIndex, true)
    out = strings.ConcatStr(out, "}")
    return out

@borrows
fn WebSceneParseIceCandidateArrayState(raw: str, items: var WebSceneIceCandidateRecord[]): bool =
    setLen(items, 0)
    if raw.len == 0:
        return true
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        return pos == raw.len
    while pos < raw.len:
        var item: WebSceneIceCandidateRecord
        if !WebSceneParseIceCandidateRecord(raw, pos, item):
            return false
        add(items, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
            return pos == raw.len
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

fn WebSceneEncodeIceCandidateArrayState(items: var WebSceneIceCandidateRecord[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, WebSceneEncodeIceCandidateRecord(items[i]))
    out = strings.ConcatStr(out, "]")
    return out

# ===== CHT mechanism 14: WebSceneWebRtcIceConfigRecord (struct box-ref) KV codec =====
# Singular counterpart to the mechanism-12 array-of-struct codec above — hand-audited field-by-
# field encode/decode, no unknown-key tolerance, exhaustive key dispatch. `WebSceneWebRtcParseString
# ArrayAt`/`WebSceneWebRtcEncodeStringArray` are POSITION-based (parse advances `pos` past the `]`
# rather than requiring the whole `raw` to be consumed) because `stunUrls`/`urls` are NESTED fields
# inside a bigger object, not a standalone top-level KV value (contrast
# WebSceneParseJsonStringArrayState, which owns the entire `raw` string).

@borrows
fn WebSceneWebRtcParseStringArrayAt(raw: str, pos: var int32, out: var str[]): bool =
    setLen(out, 0)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
        return true
    while pos < raw.len:
        var item: str
        if !WebSceneJsonStringArrayParseString(raw, pos, item):
            return false
        add(out, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = pos + 1
            return true
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneWebRtcEncodeStringArray(items: str[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, WebSceneJsonEncodeString(items[i]))
    out = strings.ConcatStr(out, "]")
    return out

fn WebSceneWebRtcTurnServerReset(record: var WebSceneWebRtcTurnServerRecord) =
    record.url = ""
    record.username = ""
    record.credential = ""

@borrows
fn WebSceneParseWebRtcTurnServerRecord(raw: str, pos: var int32, out: var WebSceneWebRtcTurnServerRecord): bool =
    WebSceneWebRtcTurnServerReset(out)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    var seenUrl = false
    var seenUsername = false
    var seenCredential = false
    if pos < raw.len && raw[pos] == '}':
        return false
    while pos < raw.len:
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        if key == "url":
            if seenUrl:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.url):
                return false
            seenUrl = true
        elif key == "username":
            if seenUsername:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.username):
                return false
            seenUsername = true
        elif key == "credential":
            if seenCredential:
                return false
            if !WebSceneJsonStringArrayParseString(raw, pos, out.credential):
                return false
            seenCredential = true
        else:
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            pos = pos + 1
            return seenUrl && seenUsername && seenCredential
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneEncodeWebRtcTurnServerRecord(record: WebSceneWebRtcTurnServerRecord): str =
    var out = "{"
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("url"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(record.url))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("username"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(record.username))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("credential"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(record.credential))
    out = strings.ConcatStr(out, "}")
    return out

@borrows
fn WebSceneParseWebRtcTurnServerArrayAt(raw: str, pos: var int32, out: var WebSceneWebRtcTurnServerRecord[]): bool =
    setLen(out, 0)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
        return true
    while pos < raw.len:
        var item: WebSceneWebRtcTurnServerRecord
        if !WebSceneParseWebRtcTurnServerRecord(raw, pos, item):
            return false
        add(out, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = pos + 1
            return true
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneEncodeWebRtcTurnServerArray(items: WebSceneWebRtcTurnServerRecord[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, WebSceneEncodeWebRtcTurnServerRecord(items[i]))
    out = strings.ConcatStr(out, "]")
    return out

fn WebSceneWebRtcIceServerReset(record: var WebSceneWebRtcIceServerRecord) =
    setLen(record.urls, 0)
    record.username = ""
    record.credential = ""

# `urls` is the ONLY required field on the real RTCIceServer (`username`/`credential` are `?`,
# TS-optional — absent decodes to "", the SAME optional-string convention used throughout this
# file, e.g. WebSceneProfileAddressRecord). A duplicate `urls` key still fails closed (matches
# every other exhaustive-key parser in this file); a duplicate optional key is tolerated
# (last-write-wins), consistent with `urls` being the sole audited-mandatory field.
@borrows
fn WebSceneParseWebRtcIceServerRecord(raw: str, pos: var int32, out: var WebSceneWebRtcIceServerRecord): bool =
    WebSceneWebRtcIceServerReset(out)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    var seenUrls = false
    if pos < raw.len && raw[pos] == '}':
        return false
    while pos < raw.len:
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        if key == "urls":
            if seenUrls:
                return false
            if !WebSceneWebRtcParseStringArrayAt(raw, pos, out.urls):
                return false
            seenUrls = true
        elif key == "username":
            if !WebSceneJsonStringArrayParseString(raw, pos, out.username):
                return false
        elif key == "credential":
            if !WebSceneJsonStringArrayParseString(raw, pos, out.credential):
                return false
        else:
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            pos = pos + 1
            return seenUrls
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneEncodeWebRtcIceServerRecord(record: WebSceneWebRtcIceServerRecord): str =
    var out = "{"
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("urls"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneWebRtcEncodeStringArray(record.urls))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("username"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(record.username))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("credential"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(record.credential))
    out = strings.ConcatStr(out, "}")
    return out

@borrows
fn WebSceneParseWebRtcIceServerArrayAt(raw: str, pos: var int32, out: var WebSceneWebRtcIceServerRecord[]): bool =
    setLen(out, 0)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
        return true
    while pos < raw.len:
        var item: WebSceneWebRtcIceServerRecord
        if !WebSceneParseWebRtcIceServerRecord(raw, pos, item):
            return false
        add(out, item)
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == ']':
            pos = pos + 1
            return true
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneEncodeWebRtcIceServerArray(items: WebSceneWebRtcIceServerRecord[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, WebSceneEncodeWebRtcIceServerRecord(items[i]))
    out = strings.ConcatStr(out, "]")
    return out

# `record.present` is intentionally left untouched by Reset (caller-controlled: Reset is also
# called mid-parse-failure to wipe partial field writes, where clobbering `present` would be
# wrong for a caller re-using an already-loaded record). WebSceneParseWebRtcIceConfigState below
# is the sole owner of `present`'s value.
fn WebSceneWebRtcIceConfigReset(record: var WebSceneWebRtcIceConfigRecord) =
    record.relayOnly = false
    setLen(record.stunUrls, 0)
    setLen(record.turnServers, 0)
    setLen(record.iceServers, 0)
    record.expiresAtMsPresent = false
    record.expiresAtMs = int64(0)

@borrows
fn WebSceneParseWebRtcIceConfigRecord(raw: str, pos: var int32, out: var WebSceneWebRtcIceConfigRecord): bool =
    WebSceneWebRtcIceConfigReset(out)
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    var seenRelayOnly = false
    var seenStunUrls = false
    var seenTurnServers = false
    var seenIceServers = false
    if pos < raw.len && raw[pos] == '}':
        return false
    while pos < raw.len:
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        if key == "relayOnly":
            if seenRelayOnly:
                return false
            if !WebSceneJsonParseBool(raw, pos, out.relayOnly):
                return false
            seenRelayOnly = true
        elif key == "stunUrls":
            if seenStunUrls:
                return false
            if !WebSceneWebRtcParseStringArrayAt(raw, pos, out.stunUrls):
                return false
            seenStunUrls = true
        elif key == "turnServers":
            if seenTurnServers:
                return false
            if !WebSceneParseWebRtcTurnServerArrayAt(raw, pos, out.turnServers):
                return false
            seenTurnServers = true
        elif key == "iceServers":
            if seenIceServers:
                return false
            if !WebSceneParseWebRtcIceServerArrayAt(raw, pos, out.iceServers):
                return false
            seenIceServers = true
        elif key == "expiresAtMsPresent":
            if !WebSceneJsonParseBool(raw, pos, out.expiresAtMsPresent):
                return false
        elif key == "expiresAtMs":
            if !WebSceneJsonIceCandidateParseInt64(raw, pos, out.expiresAtMs):
                return false
        else:
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            pos = pos + 1
            return seenRelayOnly && seenStunUrls && seenTurnServers && seenIceServers
        if raw[pos] != ',':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
    return false

@borrows
fn WebSceneEncodeWebRtcIceConfigRecord(record: WebSceneWebRtcIceConfigRecord): str =
    var out = "{"
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("relayOnly"))
    out = strings.ConcatStr(out, ":")
    if record.relayOnly:
        out = strings.ConcatStr(out, "true")
    else:
        out = strings.ConcatStr(out, "false")
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("stunUrls"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneWebRtcEncodeStringArray(record.stunUrls))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("turnServers"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneEncodeWebRtcTurnServerArray(record.turnServers))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("iceServers"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, WebSceneEncodeWebRtcIceServerArray(record.iceServers))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("expiresAtMsPresent"))
    out = strings.ConcatStr(out, ":")
    if record.expiresAtMsPresent:
        out = strings.ConcatStr(out, "true")
    else:
        out = strings.ConcatStr(out, "false")
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString("expiresAtMs"))
    out = strings.ConcatStr(out, ":")
    out = strings.ConcatStr(out, strings.Int64ToStr(record.expiresAtMs))
    out = strings.ConcatStr(out, "}")
    return out

# Top-level KV round-trip state pair (mirrors WebSceneParseIceCandidateArrayState/WebSceneEncode
# IceCandidateArrayState's "own the whole raw string" contract, singular instead of array). The
# empty-string KV sentinel is the SOLE persistence-level presence signal (never a separate KV key)
# — `record.present` is set here, exactly once, as the in-memory cache of that fact.
@borrows
fn WebSceneParseWebRtcIceConfigState(raw: str, out: var WebSceneWebRtcIceConfigRecord): bool =
    WebSceneWebRtcIceConfigReset(out)
    out.present = false
    if raw.len == 0:
        return true
    var pos = 0
    if !WebSceneParseWebRtcIceConfigRecord(raw, pos, out):
        WebSceneWebRtcIceConfigReset(out)
        return false
    pos = WebSceneSkipJsonWhitespace(raw, pos)
    if pos != raw.len:
        WebSceneWebRtcIceConfigReset(out)
        return false
    out.present = true
    return true

@borrows
fn WebSceneEncodeWebRtcIceConfigState(record: WebSceneWebRtcIceConfigRecord): str =
    if !record.present:
        return ""
    return WebSceneEncodeWebRtcIceConfigRecord(record)

fn WebSceneProfileAddressEnsureSingleDefault(items: var WebSceneProfileAddressRecord[]) =
    if items.len == 0:
        return
    for i in 0..<items.len:
        if items[i].isDefault:
            return
    items[0].isDefault = true

fn WebSceneProfileAddressStateRef(draftRef: str, field: str): str =
    return strings.ConcatStr(strings.ConcatStr(draftRef, "."), field)

@borrows
fn WebSceneReadProfileAddressDraft(graph: var WebSceneGraph,
                                   draftRef: str,
                                   out: var WebSceneProfileAddressRecord): bool =
    WebSceneProfileAddressReset(out)
    # Spec migration: under @borrows draftRef is a borrow view and the state
    # ref builder consumes its formals; clone once at entry (storage-station
    # precedent).
    out.receiver = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "receiver")))
    out.phone = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "phone")))
    out.region = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "region")))
    out.detail = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "detail")))
    out.tag = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "tag")))
    out.isDefault = WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "isDefault")), "true")
    return true

@borrows
fn WebSceneProfileAddressDraftComplete(record: WebSceneProfileAddressRecord): bool =
    return record.receiver.len > 0 && record.phone.len > 0 && record.region.len > 0 && record.detail.len > 0

@borrows
fn WebSceneSetProfileAddressStateValue(graph: var WebSceneGraph,
                                       stateRef: str,
                                       value: str,
                                       touched: var bool): bool =
    let status = WebSceneSetStateValueInternal(graph, stateRef, value, false)
    if status < 0:
        return false
    if status > 0:
        touched = true
    return true

@borrows
fn WebSceneClearProfileAddressDraft(graph: var WebSceneGraph,
                                    draftRef: str,
                                    touched: var bool): bool =
    # Spec migration: under @borrows draftRef is a borrow view and the state
    # ref builder consumes its formals; clone once at entry.
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "receiver"), "", touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "phone"), "", touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "region"), "", touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "detail"), "", touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "tag"), "", touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "isDefault"), "false", touched):
        return false
    return true

@borrows
fn WebSceneProfileAddressEditingIdActive(editingId: str): bool =
    if editingId.len == 0:
        return false
    if editingId == "false" || editingId == "null":
        return false
    return true

@borrows
fn WebSceneProfileAddressNextId(graph: var WebSceneGraph, addressesRef: str, itemCount: int32): int32 =
    let counterRef = strings.ConcatStr(WebSceneCloneStateString(addressesRef), ".__nextId")
    var nextId: int32
    if WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, counterRef), nextId):
        if nextId > 0:
            return nextId
    return itemCount + 1

@borrows
fn WebSceneSetProfileAddressStateAndStorage(graph: var WebSceneGraph,
                                            addressesRef: str,
                                            storageKey: str,
                                            encoded: str,
                                            touched: var bool): bool =
    if storageKey.len == 0:
        return false
    if !WebSceneSetProfileAddressStateValue(graph, addressesRef, encoded, touched):
        return false
    return WebSceneWriteStorageValue(graph, storageKey, encoded, touched)

@borrows
fn WebSceneApplyProfileAddressSaveEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "profile_address_save:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let addressesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let draftRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let editingRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let editorRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let errorRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let incompleteMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    let storageKey = WebSceneEffectPartAfterPrefix(segment, prefix, 6)
    if addressesRef.len == 0 || draftRef.len == 0 || editingRef.len == 0 || editorRef.len == 0 || errorRef.len == 0 || incompleteMessage.len == 0 || storageKey.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 7).len > 0:
        return -1

    var draft: WebSceneProfileAddressRecord
    if !WebSceneReadProfileAddressDraft(graph, draftRef, draft):
        return -1
    if !WebSceneProfileAddressDraftComplete(draft):
        return WebSceneSetStateValueInternal(graph, errorRef, incompleteMessage, markDirty)

    var items: WebSceneProfileAddressRecord[]
    if !WebSceneParseProfileAddressArrayState(WebSceneStateValueForRef(graph, addressesRef), items):
        return -1
    let editingId = WebSceneStateValueForRef(graph, editingRef)
    let editingActive = WebSceneProfileAddressEditingIdActive(editingId)
    var targetId = WebSceneCloneStateString(editingId)
    let draftIsDefault = draft.isDefault
    if editingActive:
        var found: bool
        for i in 0..<items.len:
            if items[i].id == editingId:
                items[i].receiver = draft.receiver
                items[i].phone = draft.phone
                items[i].region = draft.region
                items[i].detail = draft.detail
                items[i].tag = draft.tag
                items[i].isDefault = draft.isDefault
                found = true
        if !found:
            return -1
    else:
        let nextId = WebSceneProfileAddressNextId(graph, addressesRef, items.len)
        targetId = strings.ConcatStr("addr_", strings.IntToStr(nextId))
        draft.id = targetId
        add(items, draft)

    if draftIsDefault:
        for i in 0..<items.len:
            items[i].isDefault = items[i].id == targetId
    else:
        WebSceneProfileAddressEnsureSingleDefault(items)

    var touched: bool
    let encoded = WebSceneEncodeProfileAddressArrayState(items)
    if !WebSceneSetProfileAddressStateAndStorage(graph, addressesRef, storageKey, encoded, touched):
        return -1
    if !editingActive:
        let counterRef = strings.ConcatStr(addressesRef, ".__nextId")
        if !WebSceneSetProfileAddressStateValue(graph, counterRef, strings.IntToStr(items.len + 1), touched):
            return -1
    if !WebSceneSetProfileAddressStateValue(graph, editorRef, "false", touched):
        return -1
    if !WebSceneSetProfileAddressStateValue(graph, editingRef, "false", touched):
        return -1
    if !WebSceneClearProfileAddressDraft(graph, draftRef, touched):
        return -1
    if !WebSceneSetProfileAddressStateValue(graph, errorRef, "", touched):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

fn WebSceneRebuildNodeLookupTables(graph: var WebSceneGraph): bool =
    graph.nodeParentById = []
    graph.nodeRouteById = []
    graph.nodeIndexById = []
    graph.nodeNonRenderedById = []
    graph.nodeDisplayNoneById = []
    for i in 0..<graph.nodes.len:
        if !WebSceneRegisterNodeLookup(graph, graph.nodes[i], i):
            return false
    return true

fn WebSceneProfileAddressNodeIdInList(ids: var int32[], nodeId: int32): bool =
    for i in 0..<ids.len:
        if ids[i] == nodeId:
            return true
    return false

fn WebSceneCollectProfileAddressGeneratedNodeIds(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 containerNodeId: int32,
                                                 ids: var int32[]) =
    setLen(ids, 0)
    let containerText = strings.IntToStr(containerNodeId)
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].propName == "data-csg-profile-address-generated-container" &&
           graph.props[i].propValue == containerText:
            if !WebSceneProfileAddressNodeIdInList(ids, graph.props[i].nodeId):
                add(ids, graph.props[i].nodeId)

fn WebSceneClearProfileAddressGeneratedNodes(graph: var WebSceneGraph,
                                             routeIndex: int32,
                                             containerNodeId: int32): int32 =
    var ids: int32[]
    WebSceneCollectProfileAddressGeneratedNodeIds(graph, routeIndex, containerNodeId, ids)
    if ids.len == 0:
        return 0
    var nextNodes: WebSceneNode[]
    for i in 0..<graph.nodes.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.nodes[i].nodeId):
            var keepNode: WebSceneNode
            if !WebSceneNodeCloneFromSeq(graph.nodes, i, keepNode):
                return -1
            add(nextNodes, keepNode)
    graph.nodes = nextNodes
    var nextProps: WebSceneProp[]
    for i in 0..<graph.props.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.props[i].nodeId):
            var keepProp: WebSceneProp
            if !WebScenePropCloneFromSeq(graph.props, i, keepProp):
                return -1
            add(nextProps, keepProp)
    graph.props = nextProps
    var nextHandlers: WebSceneEventHandler[]
    for i in 0..<graph.eventHandlers.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.eventHandlers[i].nodeId):
            var keepHandler: WebSceneEventHandler
            if !WebSceneEventHandlerCloneFromSeq(graph.eventHandlers, i, keepHandler):
                return -1
            add(nextHandlers, keepHandler)
    graph.eventHandlers = nextHandlers
    var nextTargets: WebSceneHitTarget[]
    for i in 0..<graph.hitTargets.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.hitTargets[i].nodeId):
            var keepTarget: WebSceneHitTarget
            if !WebSceneHitTargetCloneFromSeq(graph.hitTargets, i, keepTarget):
                return -1
            add(nextTargets, keepTarget)
    graph.hitTargets = nextTargets
    var nextNodeStates: WebSceneNodeState[]
    for i in 0..<graph.nodeStates.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.nodeStates[i].nodeId):
            var keepNodeState: WebSceneNodeState
            if !WebSceneNodeStateCloneFromSeq(graph.nodeStates, i, keepNodeState):
                return -1
            add(nextNodeStates, keepNodeState)
    graph.nodeStates = nextNodeStates
    var nextLayouts: WebSceneLayoutConstraint[]
    for i in 0..<graph.layoutConstraints.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.layoutConstraints[i].nodeId):
            var keepLayout: WebSceneLayoutConstraint
            if !WebSceneLayoutConstraintCloneFromSeq(graph.layoutConstraints, i, keepLayout):
                return -1
            add(nextLayouts, keepLayout)
    graph.layoutConstraints = nextLayouts
    var nextPaintOps: WebScenePaintOp[]
    for i in 0..<graph.paintOps.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.paintOps[i].nodeId):
            var keepPaintOp: WebScenePaintOp
            if !WebScenePaintOpCloneFromSeq(graph.paintOps, i, keepPaintOp):
                return -1
            add(nextPaintOps, keepPaintOp)
    graph.paintOps = nextPaintOps
    graph.paintOpRangeIndexSynced = false
    var nextShadows: WebScenePaintOp[]
    for i in 0..<graph.paintShadows.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.paintShadows[i].nodeId):
            var keepShadowOp: WebScenePaintOp
            if !WebScenePaintOpCloneFromSeq(graph.paintShadows, i, keepShadowOp):
                return -1
            add(nextShadows, keepShadowOp)
    graph.paintShadows = nextShadows
    var nextGradients: WebScenePaintOp[]
    for i in 0..<graph.paintGradients.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.paintGradients[i].nodeId):
            var keepGradientOp: WebScenePaintOp
            if !WebScenePaintOpCloneFromSeq(graph.paintGradients, i, keepGradientOp):
                return -1
            add(nextGradients, keepGradientOp)
    graph.paintGradients = nextGradients
    var nextPrimitives: WebScenePaintSvgPrimitive[]
    for i in 0..<graph.paintSvgPrimitives.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.paintSvgPrimitives[i].nodeId):
            var keepPrimitive: WebScenePaintSvgPrimitive
            if !WebScenePaintSvgPrimitiveCloneFromSeq(graph.paintSvgPrimitives, i, keepPrimitive):
                return -1
            add(nextPrimitives, keepPrimitive)
    graph.paintSvgPrimitives = nextPrimitives
    var nextCss: WebSceneCssDeclaration[]
    for i in 0..<graph.cssDeclarations.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.cssDeclarations[i].nodeId):
            var keepCss: WebSceneCssDeclaration
            if !WebSceneCssDeclarationCloneFromSeq(graph.cssDeclarations, i, keepCss):
                return -1
            add(nextCss, keepCss)
    graph.cssDeclarations = nextCss
    var nextBoxes: WebSceneLayoutBox[]
    for i in 0..<graph.layoutBoxes.len:
        if !WebSceneProfileAddressNodeIdInList(ids, graph.layoutBoxes[i].nodeId):
            var keepBox: WebSceneLayoutBox
            if !WebSceneLayoutBoxCloneFromSeq(graph.layoutBoxes, i, keepBox):
                return -1
            add(nextBoxes, keepBox)
    graph.layoutBoxes = nextBoxes
    graph.boxRangeVersion = -1
    if !WebSceneRebuildNodeLookupTables(graph):
        return -1
    WebSceneInvalidateInteractionIndex(graph)
    return 1

fn WebSceneNextProfileAddressDynamicNodeId(graph: var WebSceneGraph): int32 =
    var nextId = 1
    for i in 0..<graph.nodes.len:
        if graph.nodes[i].nodeId >= nextId:
            nextId = graph.nodes[i].nodeId + 1
    return nextId

@borrows
fn WebSceneAddProfileAddressGeneratedNode(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          parentNodeId: int32,
                                          nodeId: int32,
                                          nodeKind: int32,
                                          tagName: str,
                                          textContent: str,
                                          layerId: int32,
                                          containerNodeId: int32): bool =
    if WebSceneAddNodeWithStateBindingsStatus(graph, routeIndex, nodeId, parentNodeId, nodeKind, tagName, textContent, layerId, "", "", "") != 0:
        return false
    return WebSceneAddPropKnownLoadedNode(graph,
                                          routeIndex,
                                          nodeId,
                                          100000,
                                          "data-csg-profile-address-generated-container",
                                          strings.IntToStr(containerNodeId),
                                          "string")

@borrows
fn WebSceneAddProfileAddressLayout(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   ordinal: int32,
                                   propName: str,
                                   propValue: str): bool =
    return WebSceneAddLayoutConstraintKnownLoadedNode(graph, routeIndex, nodeId, ordinal, propName, propValue)

@borrows
fn WebSceneAddProfileAddressTextNode(graph: var WebSceneGraph,
                                     routeIndex: int32,
                                     parentNodeId: int32,
                                     nextNodeId: var int32,
                                     textContent: str,
                                     color: int64,
                                     fontSize: int32,
                                     fontWeight: int32,
                                     layerId: int32,
                                     containerNodeId: int32): bool =
    let nodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, parentNodeId, nodeId, 3, "", textContent, layerId, containerNodeId):
        return false
    if !WebSceneAddPaintOpAt(graph, routeIndex, nodeId, 0, 0, 0, WebScenePaintText, color, 0, 0, 0, "", textContent):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, nodeId, 0, "font-size", strings.ConcatStr(strings.IntToStr(fontSize), "px")):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, nodeId, 1, "line-height", strings.ConcatStr(strings.IntToStr(fontSize + 5), "px")):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, nodeId, 2, "font-weight", strings.IntToStr(fontWeight)):
        return false
    return true

@borrows
fn WebSceneAddProfileAddressTextLine(graph: var WebSceneGraph,
                                     routeIndex: int32,
                                     parentNodeId: int32,
                                     nextNodeId: var int32,
                                     textContent: str,
                                     color: int64,
                                     fontSize: int32,
                                     fontWeight: int32,
                                     layerId: int32,
                                     containerNodeId: int32): bool =
    let lineNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, parentNodeId, lineNodeId, 2, "div", "", layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, lineNodeId, 0, "display", "block"):
        return false
    return WebSceneAddProfileAddressTextNode(graph, routeIndex, lineNodeId, nextNodeId, textContent, color, fontSize, fontWeight, layerId, containerNodeId)

@borrows
fn WebSceneProfileAddressLine1(record: WebSceneProfileAddressRecord): str =
    var out = strings.ConcatStr(strings.ConcatStr(record.receiver, "  "), record.phone)
    if record.isDefault:
        out = strings.ConcatStr(out, "  默认")
    return out

@borrows
fn WebSceneProfileAddressLine2(record: WebSceneProfileAddressRecord): str =
    var out: str
    if record.tag.len > 0:
        out = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("[", record.tag), "] "), "")
    out = strings.ConcatStr(out, record.region)
    if record.detail.len > 0:
        out = strings.ConcatStr(strings.ConcatStr(out, " "), record.detail)
    return out

@borrows
fn WebSceneAddProfileAddressClickAction(graph: var WebSceneGraph,
                                        routeIndex: int32,
                                        nodeId: int32,
                                        handler: str,
                                        stateRef: str,
                                        effect: str,
                                        label: str): bool =
    if !WebSceneAddEventHandlerWithAction(graph,
                                          routeIndex,
                                          nodeId,
                                          0,
                                          0,
                                          "onClick",
                                          "click",
                                          handler,
                                          "event_handler",
                                          "state_delta",
                                          stateRef,
                                          effect):
        return false
    # Spec migration: under @borrows the label formal is a borrow view, and a
    # borrowed actual cannot bind a non-var non-@borrows formal. Clone into an
    # owned value (storage-station precedent, ResourceEntryStatus family).
    return WebSceneAddHitTarget(graph, routeIndex, nodeId, 0, 0, "event",
                                "onClick", "click", -1, strings.CloneStr(label))

fn WebSceneAddProfileAddressEmptyState(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       containerNodeId: int32,
                                       nextNodeId: var int32,
                                       layerId: int32): bool =
    let emptyNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, containerNodeId, emptyNodeId, 2, "div", "", layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, emptyNodeId, 0, "display", "flex"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, emptyNodeId, 1, "flex-direction", "column"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, emptyNodeId, 2, "align-items", "center"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, emptyNodeId, 3, "justify-content", "center"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, emptyNodeId, 4, "height", "360px"):
        return false
    if !WebSceneAddProfileAddressTextLine(graph, routeIndex, emptyNodeId, nextNodeId, "暂无收货地址", int64(4288455599), 14, 400, layerId, containerNodeId):
        return false
    return WebSceneAddProfileAddressTextLine(graph, routeIndex, emptyNodeId, nextNodeId, "添加后下单会优先使用", int64(4288455599), 12, 400, layerId, containerNodeId)

@borrows
fn WebSceneAddProfileAddressCard(graph: var WebSceneGraph,
                                 routeIndex: int32,
                                 containerNodeId: int32,
                                 nextNodeId: var int32,
                                 record: WebSceneProfileAddressRecord,
                                 itemIndex: int32,
                                 layerId: int32,
                                 storageKey: str): bool =
    let cardNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, containerNodeId, cardNodeId, 2, "div", "", layerId, containerNodeId):
        return false
    if !WebSceneAddPaintOpAt(graph, routeIndex, cardNodeId, 0, 0, 0, WebScenePaintFill, int64(4294967295), 8, 0, 0, "", ""):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, cardNodeId, 0, "display", "block"):
        return false
    if itemIndex == 0:
        if !WebSceneAddProfileAddressLayout(graph, routeIndex, cardNodeId, 1, "margin-top", "8px"):
            return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, cardNodeId, 2, "margin-left", "12px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, cardNodeId, 3, "margin-right", "12px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, cardNodeId, 4, "margin-bottom", "8px"):
        return false

    let bodyNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, cardNodeId, bodyNodeId, 2, "button", "", layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, bodyNodeId, 0, "display", "block"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, bodyNodeId, 1, "width", "100%"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, bodyNodeId, 2, "padding-top", "12px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, bodyNodeId, 3, "padding-right", "16px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, bodyNodeId, 4, "padding-bottom", "12px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, bodyNodeId, 5, "padding-left", "16px"):
        return false
    let editEffect = Fmt"profile_address_edit:addresses:addressDraft:editingAddressId:showAddressEditor:addressError:{record.id}"
    if !WebSceneAddProfileAddressClickAction(graph, routeIndex, bodyNodeId, "openEditAddress", "addresses", editEffect, "编辑地址"):
        return false
    if !WebSceneAddProfileAddressTextLine(graph, routeIndex, bodyNodeId, nextNodeId, WebSceneProfileAddressLine1(record), int64(4279310375), 15, 600, layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressTextLine(graph, routeIndex, bodyNodeId, nextNodeId, WebSceneProfileAddressLine2(record), int64(4285231744), 13, 400, layerId, containerNodeId):
        return false

    let footerNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, cardNodeId, footerNodeId, 2, "div", "", layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, footerNodeId, 0, "display", "flex"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, footerNodeId, 1, "align-items", "center"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, footerNodeId, 2, "padding-top", "8px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, footerNodeId, 3, "padding-right", "16px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, footerNodeId, 4, "padding-bottom", "8px"):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, footerNodeId, 5, "padding-left", "16px"):
        return false

    let defaultNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, footerNodeId, defaultNodeId, 2, "button", "", layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, defaultNodeId, 0, "margin-right", "20px"):
        return false
    let defaultEffect = Fmt"profile_address_set_default:addresses:{record.id}:{storageKey}"
    if !WebSceneAddProfileAddressClickAction(graph, routeIndex, defaultNodeId, "handleSetDefaultAddress", "addresses", defaultEffect, "设为默认地址"):
        return false
    var defaultText = "设为默认"
    if record.isDefault:
        defaultText = "默认地址"
    if !WebSceneAddProfileAddressTextNode(graph, routeIndex, defaultNodeId, nextNodeId, defaultText, int64(4287323382), 12, 500, layerId, containerNodeId):
        return false

    let editNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, footerNodeId, editNodeId, 2, "button", "", layerId, containerNodeId):
        return false
    if !WebSceneAddProfileAddressLayout(graph, routeIndex, editNodeId, 0, "margin-right", "16px"):
        return false
    if !WebSceneAddProfileAddressClickAction(graph, routeIndex, editNodeId, "openEditAddress", "addresses", editEffect, "编辑地址"):
        return false
    if !WebSceneAddProfileAddressTextNode(graph, routeIndex, editNodeId, nextNodeId, "编辑", int64(4285231744), 12, 400, layerId, containerNodeId):
        return false

    let deleteNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    if !WebSceneAddProfileAddressGeneratedNode(graph, routeIndex, footerNodeId, deleteNodeId, 2, "button", "", layerId, containerNodeId):
        return false
    let deleteEffect = Fmt"profile_address_delete:addresses:{record.id}:{storageKey}"
    if !WebSceneAddProfileAddressClickAction(graph, routeIndex, deleteNodeId, "handleDeleteAddress", "addresses", deleteEffect, "删除地址"):
        return false
    return WebSceneAddProfileAddressTextNode(graph, routeIndex, deleteNodeId, nextNodeId, "删除", int64(4285231744), 12, 400, layerId, containerNodeId)

@borrows
fn WebSceneNodeHasAncestorStateCondition(graph: var WebSceneGraph,
                                         routeIndex: int32,
                                         nodeId: int32,
                                         stateRef: str): bool =
    var current = nodeId
    var guard: int32
    while current > 0 && guard <= graph.nodes.len:
        let nodeIndex = WebSceneFindNodeIndex(graph, routeIndex, current)
        if nodeIndex < 0:
            return false
        if graph.nodes[nodeIndex].conditionalStateRef == stateRef:
            return true
        current = graph.nodes[nodeIndex].parentNodeId
        guard = guard + 1
    return false

@borrows
fn WebSceneRefreshProfileAddressListContainer(graph: var WebSceneGraph,
                                              routeIndex: int32,
                                              containerNodeId: int32,
                                              addressesRef: str,
                                              markDirty: bool): int32 =
    if !WebSceneNodeHasAncestorStateCondition(graph, routeIndex, containerNodeId, "showAddresses"):
        return 0
    var items: WebSceneProfileAddressRecord[]
    if !WebSceneParseProfileAddressArrayState(WebSceneStateValueForRef(graph, addressesRef), items):
        return -1
    let storageKey = WebSceneNodePropValue(graph, routeIndex, containerNodeId, "data-csg-profile-address-storage-key")
    if storageKey.len == 0:
        return -1
    let clearStatus = WebSceneClearProfileAddressGeneratedNodes(graph, routeIndex, containerNodeId)
    if clearStatus < 0:
        return -1
    var nextNodeId = WebSceneNextProfileAddressDynamicNodeId(graph)
    let layerId = WebSceneNodeLayerId(graph, containerNodeId)
    if items.len == 0:
        if !WebSceneAddProfileAddressEmptyState(graph, routeIndex, containerNodeId, nextNodeId, layerId):
            return -1
    else:
        for i in 0..<items.len:
            if !WebSceneAddProfileAddressCard(graph, routeIndex, containerNodeId, nextNodeId, items[i], i, layerId, storageKey):
                return -1
    graph.version = graph.version + 1
    WebSceneInvalidateInteractionIndex(graph)
    if markDirty:
        if !WebSceneMarkRouteDirty(graph, routeIndex):
            return -1
    return 1

@borrows
fn WebSceneRefreshProfileAddressListsForStateChange(graph: var WebSceneGraph,
                                                    stateRef: str,
                                                    markDirty: bool): int32 =
    if stateRef != "addresses" && stateRef != "showAddresses":
        return 0
    var touched: bool
    var routeIndexes: int32[]
    var nodeIds: int32[]
    var addressRefs: str[]
    for i in 0..<graph.props.len:
        if graph.props[i].propName != "data-csg-profile-address-list-ref":
            continue
        let addressesRef = graph.props[i].propValue
        if addressesRef.len == 0:
            return -1
        if stateRef != "showAddresses" && stateRef != addressesRef:
            continue
        add(routeIndexes, graph.props[i].routeIndex)
        add(nodeIds, graph.props[i].nodeId)
        add(addressRefs, WebSceneCloneStateString(addressesRef))
    for i in 0..<nodeIds.len:
        let status = WebSceneRefreshProfileAddressListContainer(graph, routeIndexes[i], nodeIds[i], addressRefs[i], markDirty)
        if status < 0:
            return -1
        if status > 0:
            touched = true
    if touched:
        return 1
    return 0

fn WebSceneHydrateProfileAddressStorageBindings(graph: var WebSceneGraph, markDirty: bool): int32 =
    var touched: bool
    var addressRefs: str[]
    var storageValues: str[]
    for i in 0..<graph.props.len:
        if graph.props[i].propName != "data-csg-profile-address-list-ref":
            continue
        let addressesRef = graph.props[i].propValue
        let storageKey = WebSceneNodePropValue(graph, graph.props[i].routeIndex, graph.props[i].nodeId, "data-csg-profile-address-storage-key")
        if addressesRef.len == 0 || storageKey.len == 0:
            return -1
        let storageIndex = WebSceneFindStorageIndex(graph, storageKey)
        if storageIndex < 0:
            continue
        var parsed: WebSceneProfileAddressRecord[]
        if !WebSceneParseProfileAddressArrayState(graph.storageEntries[storageIndex].value, parsed):
            return -1
        add(addressRefs, WebSceneCloneStateString(addressesRef))
        add(storageValues, WebSceneCloneStateString(graph.storageEntries[storageIndex].value))
    for i in 0..<addressRefs.len:
        if !WebSceneSetProfileAddressStateValue(graph, addressRefs[i], storageValues[i], touched):
            return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneFindProfileAddressIndexById(items: var WebSceneProfileAddressRecord[], id: str): int32 =
    for i in 0..<items.len:
        if items[i].id == id:
            return i
    return -1

@borrows
fn WebSceneWriteProfileAddressDraft(graph: var WebSceneGraph,
                                    draftRef: str,
                                    record: WebSceneProfileAddressRecord,
                                    touched: var bool): bool =
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "receiver"), strings.CloneStr(record.receiver), touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "phone"), strings.CloneStr(record.phone), touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "region"), strings.CloneStr(record.region), touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "detail"), strings.CloneStr(record.detail), touched):
        return false
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "tag"), strings.CloneStr(record.tag), touched):
        return false
    var defaultValue = "false"
    if record.isDefault:
        defaultValue = "true"
    if !WebSceneSetProfileAddressStateValue(graph, WebSceneProfileAddressStateRef(strings.CloneStr(draftRef), "isDefault"), defaultValue, touched):
        return false
    return true

@borrows
fn WebSceneApplyProfileAddressEditEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "profile_address_edit:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let addressesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let draftRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let editingRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let editorRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let errorRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let id = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    if addressesRef.len == 0 || draftRef.len == 0 || editingRef.len == 0 || editorRef.len == 0 || errorRef.len == 0 || id.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 6).len > 0:
        return -1
    var items: WebSceneProfileAddressRecord[]
    if !WebSceneParseProfileAddressArrayState(WebSceneStateValueForRef(graph, addressesRef), items):
        return -1
    let index = WebSceneFindProfileAddressIndexById(items, id)
    if index < 0:
        return -1
    var touched: bool
    if !WebSceneSetProfileAddressStateValue(graph, editingRef, id, touched):
        return -1
    if !WebSceneWriteProfileAddressDraft(graph, draftRef, items[index], touched):
        return -1
    if !WebSceneSetProfileAddressStateValue(graph, errorRef, "", touched):
        return -1
    if !WebSceneSetProfileAddressStateValue(graph, editorRef, "true", touched):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyProfileAddressSetDefaultEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "profile_address_set_default:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let addressesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let id = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let storageKey = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    if addressesRef.len == 0 || id.len == 0 || storageKey.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 3).len > 0:
        return -1
    var items: WebSceneProfileAddressRecord[]
    if !WebSceneParseProfileAddressArrayState(WebSceneStateValueForRef(graph, addressesRef), items):
        return -1
    if WebSceneFindProfileAddressIndexById(items, id) < 0:
        return -1
    for i in 0..<items.len:
        items[i].isDefault = items[i].id == id
    var touched: bool
    if !WebSceneSetProfileAddressStateAndStorage(graph, addressesRef, storageKey, WebSceneEncodeProfileAddressArrayState(items), touched):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyProfileAddressDeleteEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "profile_address_delete:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let addressesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let id = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let storageKey = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    if addressesRef.len == 0 || id.len == 0 || storageKey.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 3).len > 0:
        return -1
    var items: WebSceneProfileAddressRecord[]
    if !WebSceneParseProfileAddressArrayState(WebSceneStateValueForRef(graph, addressesRef), items):
        return -1
    var nextItems: WebSceneProfileAddressRecord[]
    var removed: bool
    for i in 0..<items.len:
        if items[i].id == id:
            removed = true
        else:
            var keepAddress: WebSceneProfileAddressRecord
            if !WebSceneProfileAddressRecordCloneFromSeq(items, i, keepAddress):
                return -1
            add(nextItems, keepAddress)
    if !removed:
        return -1
    WebSceneProfileAddressEnsureSingleDefault(nextItems)
    var touched: bool
    if !WebSceneSetProfileAddressStateAndStorage(graph, addressesRef, storageKey, WebSceneEncodeProfileAddressArrayState(nextItems), touched):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneParseProductCsvLine(line: str, fields: var str[]): bool =
    setLen(fields, 0)
    var current: str
    var inQuotes: bool
    var i: int32
    while i < line.len:
        let ch = line[i]
        if inQuotes:
            if ch == '"' && i + 1 < line.len && line[i + 1] == '"':
                current = strings.ConcatStr(current, "\"")
                i = i + 1
            elif ch == '"':
                inQuotes = false
            else:
                current = strings.ConcatStr(current, strings.CharToStr(ch))
        else:
            if ch == '"':
                inQuotes = true
            elif ch == ',':
                add(fields, current)
                current = ""
            else:
                current = strings.ConcatStr(current, strings.CharToStr(ch))
        i = i + 1
    add(fields, current)
    return true

@borrows
fn WebSceneAnalyzeProductCsvText(csvText: str,
                                 productCount: var int32,
                                 skuCount: var int32,
                                 firstTitle: var str): bool =
    productCount = 0
    skuCount = 0
    firstTitle = ""
    var titles: str[]
    var lineStart: int32
    var sawHeader: bool
    while lineStart <= csvText.len:
        var lineEnd = lineStart
        while lineEnd < csvText.len && csvText[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        let line = strings.SliceBytes(csvText, lineStart, lineEnd - lineStart)
        if WebSceneTrimAsciiWhitespace(line).len > 0:
            if !sawHeader:
                sawHeader = true
            else:
                var fields: str[]
                if !WebSceneParseProductCsvLine(line, fields):
                    return false
                if fields.len >= 6:
                    let title = fields[0]
                    if title.len > 0:
                        if firstTitle.len == 0:
                            firstTitle = WebSceneCloneStateString(title)
                        if !WebSceneJsonStringArrayContains(titles, title):
                            add(titles, WebSceneCloneStateString(title))
                        skuCount = skuCount + 1
        if lineEnd >= csvText.len:
            break
        lineStart = lineEnd + 1
    productCount = titles.len
    return true

@borrows
fn WebSceneSetProductCsvPreviewField(graph: var WebSceneGraph,
                                     stateRef: str,
                                     value: str,
                                     touched: var bool): bool =
    let status = WebSceneSetStateValueInternal(graph, stateRef, value, false)
    if status < 0:
        return false
    if status > 0:
        touched = true
    return true

@borrows
fn WebSceneApplyProductCsvSelectionInternal(graph: var WebSceneGraph,
                                            displayName: str,
                                            csvText: str,
                                            uploadHint: str,
                                            markDirty: bool): int32 =
    var touched: bool
    var status = WebSceneSetStateValueInternal(graph, "csvFileName", displayName, false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "csvError", "", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "csvPreview", "", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    if !WebSceneSetProductCsvPreviewField(graph, "csvPreview.productCount", "", touched):
        return -1
    if !WebSceneSetProductCsvPreviewField(graph, "csvPreview.skuCount", "", touched):
        return -1
    if !WebSceneSetProductCsvPreviewField(graph, "csvPreview.firstTitle", "", touched):
        return -1
    status = WebSceneSetStateValueInternal(graph, "csvText", csvText, false)
    if status < 0:
        return -1
    if status > 0:
        touched = true

    var productCount: int32
    var skuCount: int32
    var firstTitle: str
    if !WebSceneAnalyzeProductCsvText(csvText, productCount, skuCount, firstTitle):
        status = WebSceneSetStateValueInternal(graph, "csvError", uploadHint, false)
        if status < 0:
            return -1
        if status > 0:
            touched = true
    elif productCount == 0:
        status = WebSceneSetStateValueInternal(graph, "csvError", uploadHint, false)
        if status < 0:
            return -1
        if status > 0:
            touched = true
    else:
        status = WebSceneSetStateValueInternal(graph, "csvPreview", "true", false)
        if status < 0:
            return -1
        if status > 0:
            touched = true
        if !WebSceneSetProductCsvPreviewField(graph, "csvPreview.productCount", strings.IntToStr(productCount), touched):
            return -1
        if !WebSceneSetProductCsvPreviewField(graph, "csvPreview.skuCount", strings.IntToStr(skuCount), touched):
            return -1
        if !WebSceneSetProductCsvPreviewField(graph, "csvPreview.firstTitle", firstTitle, touched):
            return -1

    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyProductCsvSelection(graph: var WebSceneGraph,
                                    displayName: str,
                                    csvText: str,
                                    uploadHint: str): bool =
    if WebSceneApplyProductCsvSelectionInternal(graph, displayName, csvText, uploadHint, true) >= 0:
        return true
    return false

@borrows
fn WebSceneJsonStringArrayContains(items: var str[], value: str): bool =
    for i in 0..<items.len:
        if items[i] == value:
            return true
    return false

@borrows
fn WebSceneCollectStaticArrayItemValuesForRoute(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                arrayName: str,
                                                itemField: str,
                                                outItems: var str[]): bool =
    setLen(outItems, 0)
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if arrayName.len == 0 || itemField.len == 0:
        return false
    let itemPropName = strings.ConcatStr("data-csg-static-item-", itemField)
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex != routeIndex:
            continue
        if graph.props[i].propName != "data-csg-static-array":
            continue
        if graph.props[i].propValue != arrayName:
            continue
        let itemValue = WebSceneNodePropValue(graph, routeIndex, graph.props[i].nodeId, itemPropName)
        if itemValue.len == 0:
            return false
        if !WebSceneJsonStringArrayContains(outItems, itemValue):
            add(outItems, itemValue)
    return true

fn WebSceneJsonStringArrayHasDuplicates(items: var str[]): bool =
    for i in 0..<items.len:
        for j in i + 1..<items.len:
            if items[i] == items[j]:
                return true
    return false

fn WebSceneStringArrayContainsAll(items: var str[], required: var str[]): bool =
    for i in 0..<required.len:
        if !WebSceneJsonStringArrayContains(items, required[i]):
            return false
    return true

@borrows
fn WebSceneToggleAllStaticStringSetStateInternal(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 stateRef: str,
                                                 arrayName: str,
                                                 itemField: str,
                                                 markDirty: bool): int32 =
    if stateRef.len == 0 || arrayName.len == 0 || itemField.len == 0:
        return -1
    var allItems: str[]
    if !WebSceneCollectStaticArrayItemValuesForRoute(graph, routeIndex, arrayName, itemField, allItems):
        return -1
    var currentItems: str[]
    if !WebSceneParseJsonStringArrayState(WebSceneStateValueForRef(graph, stateRef), currentItems):
        return -1
    if WebSceneJsonStringArrayHasDuplicates(currentItems):
        return -1
    if currentItems.len == allItems.len && WebSceneStringArrayContainsAll(currentItems, allItems):
        var emptyItems: str[]
        return WebSceneSetStringArrayStateValueInternal(graph, stateRef, emptyItems, markDirty)
    return WebSceneSetStringArrayStateValueInternal(graph, stateRef, allItems, markDirty)

@borrows
fn WebSceneApplyStringSetToggleAllStaticEffectSegmentForRoute(graph: var WebSceneGraph,
                                                              routeIndex: int32,
                                                              segment: str,
                                                              markDirty: bool): int32 =
    let prefix = "string_set_toggle_all_static:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let firstColon = WebSceneFindEffectChar(body, ':', 0)
    if firstColon <= 0 || firstColon >= body.len - 1:
        return -1
    let secondColon = WebSceneFindEffectChar(body, ':', firstColon + 1)
    if secondColon <= firstColon + 1 || secondColon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', secondColon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, firstColon)
    let arrayName = strings.SliceBytes(body, firstColon + 1, secondColon - firstColon - 1)
    let itemField = strings.SliceBytes(body, secondColon + 1, body.len - secondColon - 1)
    return WebSceneToggleAllStaticStringSetStateInternal(graph, routeIndex, stateRef, arrayName, itemField, markDirty)

@borrows
fn WebSceneAddUniqueTrimmedStringArrayStateInternal(graph: var WebSceneGraph,
                                                    stateRef: str,
                                                    draftRef: str,
                                                    markDirty: bool): int32 =
    if stateRef.len == 0 || draftRef.len == 0:
        return -1
    let draftValue = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, draftRef))
    if draftValue.len == 0:
        return 0
    var items: str[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if !WebSceneParseJsonStringArrayState(current, items):
        return -1
    if WebSceneJsonStringArrayContains(items, draftValue):
        return 0
    add(items, WebSceneCloneStateString(draftValue))
    let nextValue = WebSceneEncodeJsonStringArrayState(items)
    var touched: bool
    let arrayStatus = WebSceneSetStateValueInternal(graph, stateRef, nextValue, false)
    if arrayStatus < 0:
        return -1
    if arrayStatus > 0:
        touched = true
    let draftStatus = WebSceneSetStateValueInternal(graph, draftRef, "", false)
    if draftStatus < 0:
        return -1
    if draftStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneAddUniqueTrimmedStringArrayState(graph: var WebSceneGraph, stateRef: str, draftRef: str): bool =
    if WebSceneAddUniqueTrimmedStringArrayStateInternal(graph, stateRef, draftRef, true) >= 0:
        return true
    return false

@borrows
fn WebSceneRemoveStringArrayStateIndexInternal(graph: var WebSceneGraph, stateRef: str, removeIndex: int32, markDirty: bool): int32 =
    if stateRef.len == 0 || removeIndex < 0:
        return -1
    var items: str[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if !WebSceneParseJsonStringArrayState(current, items):
        return -1
    if removeIndex >= items.len:
        return 0
    var nextItems: str[]
    for i in 0..<items.len:
        if i != removeIndex:
            add(nextItems, WebSceneCloneStateString(items[i]))
    let nextValue = WebSceneEncodeJsonStringArrayState(nextItems)
    return WebSceneSetStateValueInternal(graph, stateRef, nextValue, markDirty)

@borrows
fn WebSceneRemoveStringArrayStateIndex(graph: var WebSceneGraph, stateRef: str, removeIndex: int32): bool =
    if WebSceneRemoveStringArrayStateIndexInternal(graph, stateRef, removeIndex, true) >= 0:
        return true
    return false

@borrows
fn WebSceneSetStringArrayStateValueInternal(graph: var WebSceneGraph, stateRef: str, items: var str[], markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    var previousItems: str[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if current.len > 0:
        if !WebSceneParseJsonStringArrayState(current, previousItems):
            previousItems = []
    let nextValue = WebSceneEncodeJsonStringArrayState(items)
    var status = WebSceneSetStateValueInternal(graph, stateRef, nextValue, markDirty)
    if status < 0:
        return -1
    var touched = status
    var i: int32
    while i < items.len:
        var itemRef = strings.ConcatStr(stateRef, ".")
        itemRef = strings.ConcatStr(itemRef, strings.IntToStr(i))
        let itemStatus = WebSceneSetStateValueInternal(graph, itemRef, items[i], markDirty)
        if itemStatus < 0:
            return -1
        if itemStatus > 0:
            touched = 1
        i = i + 1
    while i < previousItems.len:
        var clearRef = strings.ConcatStr(stateRef, ".")
        clearRef = strings.ConcatStr(clearRef, strings.IntToStr(i))
        let clearStatus = WebSceneSetStateValueInternal(graph, clearRef, "", markDirty)
        if clearStatus < 0:
            return -1
        if clearStatus > 0:
            touched = 1
        i = i + 1
    return touched

@borrows
fn WebSceneMediaSelectionKindAllowed(mediaKind: str): bool =
    if mediaKind == "content":
        return true
    if mediaKind == "movie":
        return true
    if mediaKind == "graphic":
        return true
    if mediaKind == "music":
        return true
    if mediaKind == "novel":
        return true
    return false

@borrows
fn WebSceneMediaSelectionReplaceExisting(mediaKind: str): bool =
    return mediaKind == "movie"

@borrows
fn WebSceneMediaSelectionPayloadForMediaPayload(mediaKind: str, payload: str): str =
    if mediaKind == "content" || mediaKind == "movie":
        return ""
    return strings.ConcatStr(payload, "")

@borrows
fn WebSceneMediaSelectionPayloadForPreview(mediaKind: str, payload: str): str =
    if mediaKind == "graphic":
        if WebSceneStrStartsWith(payload, "data:image/"):
            return strings.ConcatStr(payload, "")
    return ""

@borrows
fn WebSceneMediaSelectionDynamicPreviewValue(stateRef: str): str =
    if stateRef.len == 0:
        return ""
    return WebSceneStateImageResourceId(stateRef)

@borrows
fn WebSceneMediaSelectionDisplayNameFromPayload(payload: str): str =
    var displayName: str
    if WebSceneJsonObjectStringField(payload, "displayName", displayName):
        return displayName
    if WebSceneJsonObjectStringField(payload, "name", displayName):
        return displayName
    return ""

@borrows
fn WebSceneMediaSelectionFileValueFromPayload(payload: str, outValue: var str): bool =
    var fileValue: str
    if WebSceneJsonObjectStringField(payload, "uri", fileValue):
        if fileValue.len > 0:
            outValue = fileValue
            return true
    if WebSceneJsonObjectStringField(payload, "path", fileValue):
        if fileValue.len > 0:
            outValue = fileValue
            return true
    if WebSceneJsonObjectStringField(payload, "media", fileValue):
        if fileValue.len > 0:
            outValue = fileValue
            return true
    if WebSceneJsonObjectStringField(payload, "data", fileValue):
        if fileValue.len > 0:
            outValue = fileValue
            return true
    var pos = WebSceneSkipJsonWhitespace(payload, 0)
    if pos < payload.len && payload[pos] == '{':
        return false
    outValue = payload
    return true

fn WebSceneApplyMediaSelectionStringArray(graph: var WebSceneGraph, stateRef: str, value: str, replaceExisting: bool): int32 =
    var items: str[]
    if replaceExisting:
        add(items, WebSceneCloneStateString(value))
    else:
        let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
        if current.len > 0 && !WebSceneParseJsonStringArrayState(current, items):
            return -1
        add(items, WebSceneCloneStateString(value))
    return WebSceneSetStringArrayStateValueInternal(graph, stateRef, items, false)

@borrows
fn WebSceneApplyMediaSelectionPayloadWithPreview(graph: var WebSceneGraph, mediaKind: str, payload: str, previewReady: bool): bool =
    if !WebSceneMediaSelectionKindAllowed(mediaKind):
        return false
    if payload.len == 0:
        return false
    var fileValue: str
    if !WebSceneMediaSelectionFileValueFromPayload(payload, fileValue):
        return false
    if fileValue.len == 0:
        return false
    let replaceExisting = WebSceneMediaSelectionReplaceExisting(mediaKind)
    let mediaPayload = WebSceneMediaSelectionPayloadForMediaPayload(mediaKind, fileValue)
    var mediaPreview = WebSceneMediaSelectionPayloadForPreview(mediaKind, fileValue)
    if mediaPreview.len == 0 && previewReady:
        mediaPreview = WebSceneMediaSelectionDynamicPreviewValue("mediaPreviews")
    var touched: bool
    var status = WebSceneApplyMediaSelectionStringArray(graph, "mediaFiles", fileValue, replaceExisting)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneApplyMediaSelectionStringArray(graph, "mediaPayloads", mediaPayload, replaceExisting)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneApplyMediaSelectionStringArray(graph, "mediaPreviews", mediaPreview, replaceExisting)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneApplyMediaSelectionStringArray(graph, "mediaAspectRatios", "1", replaceExisting)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneApplyMediaSelectionStringArray(graph, "mediaFastEntries", "", replaceExisting)
    if status < 0:
        return false
    if status > 0:
        touched = true
    let displayName = WebSceneMediaSelectionDisplayNameFromPayload(payload)
    status = WebSceneApplyMediaSelectionStringArray(graph, "mediaDisplayNames", displayName, replaceExisting)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "isPreparingMedia", "false", false)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "publishError", "", false)
    if status < 0:
        return false
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "edgeFilterSummary", "", false)
    if status < 0:
        return false
    if status > 0:
        touched = true
    if touched:
        if !WebSceneMarkStateDirty(graph):
            return false
    return true

@borrows
fn WebSceneApplyMediaSelectionPayload(graph: var WebSceneGraph, mediaKind: str, payload: str): bool =
    return WebSceneApplyMediaSelectionPayloadWithPreview(graph, mediaKind, payload, false)

fn WebSceneApplySocialAppEffect(graph: var WebSceneGraph, actionKind: str, appId: str, markDirty: bool): int32 =
    if !WebSceneSocialAppIdAllowed(appId):
        return -1
    var apps: str[]
    let current = WebSceneStateValueForRef(graph, WebSceneSocialAppsStateRef)
    if !WebSceneParseSocialAppsState(current, apps):
        return -1
    if actionKind == "add":
        if WebSceneSocialAppListContains(apps, appId):
            return 0
        add(apps, WebSceneCloneStateString(appId))
    elif actionKind == "remove":
        var nextApps: str[]
        for i in 0..<apps.len:
            if apps[i] != appId:
                if !WebSceneSocialAppListContains(nextApps, apps[i]):
                    add(nextApps, WebSceneCloneStateString(apps[i]))
        apps = nextApps
    elif actionKind == "toggle":
        if WebSceneSocialAppListContains(apps, appId):
            var nextApps: str[]
            for i in 0..<apps.len:
                if apps[i] != appId:
                    if !WebSceneSocialAppListContains(nextApps, apps[i]):
                        add(nextApps, WebSceneCloneStateString(apps[i]))
            apps = nextApps
        else:
            add(apps, WebSceneCloneStateString(appId))
    else:
        return -1
    let nextValue = WebSceneEncodeSocialAppsState(apps)
    let status = WebSceneSetStateValueInternal(graph, WebSceneSocialAppsStateRef, nextValue, markDirty)
    if status < 0:
        return -1
    return status

@borrows
fn WebSceneSocialAppStateValueAbsent(value: str): bool =
    return value.len == 0 ||
        value == "false" ||
        value == "true" ||
        value == "null" ||
        value == "undefined"

@borrows
fn WebSceneApplySocialAppStateEffect(graph: var WebSceneGraph, actionKind: str, stateRef: str, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    let appId = WebSceneStateValueForRef(graph, stateRef)
    if WebSceneSocialAppStateValueAbsent(appId):
        return -1
    return WebSceneApplySocialAppEffect(graph, strings.CloneStr(actionKind), strings.CloneStr(appId), markDirty)

fn WebSceneApplyStringListToggleEffect(graph: var WebSceneGraph, stateRef: str, item: str, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    if !WebSceneSocialAppIdAllowed(item):
        return -1
    var items: str[]
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    if !WebSceneParseSocialAppsState(current, items):
        return -1
    if WebSceneSocialAppListContains(items, item):
        var nextItems: str[]
        for i in 0..<items.len:
            if items[i] != item:
                if !WebSceneSocialAppListContains(nextItems, items[i]):
                    add(nextItems, WebSceneCloneStateString(items[i]))
        items = nextItems
    else:
        add(items, WebSceneCloneStateString(item))
    let nextValue = WebSceneEncodeSocialAppsState(items)
    let status = WebSceneSetStateValueInternal(graph, strings.CloneStr(stateRef), nextValue, markDirty)
    if status < 0:
        return -1
    return status

@borrows
fn WebSceneApplySocialAppEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let body = strings.SliceBytes(segment, 11, segment.len - 11)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    let actionKind = strings.SliceBytes(body, 0, colon)
    let appId = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    if actionKind == "add_state":
        return WebSceneApplySocialAppStateEffect(graph, "add", appId, markDirty)
    if actionKind == "remove_state":
        return WebSceneApplySocialAppStateEffect(graph, "remove", appId, markDirty)
    if actionKind == "toggle_state":
        return WebSceneApplySocialAppStateEffect(graph, "toggle", appId, markDirty)
    return WebSceneApplySocialAppEffect(graph, strings.CloneStr(actionKind), strings.CloneStr(appId), markDirty)

@borrows
fn WebSceneApplyStringListEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "string_list_toggle:"
    let stateRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let item = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    if stateRef.len == 0 || item.len == 0:
        return -1
    return WebSceneApplyStringListToggleEffect(graph, strings.CloneStr(stateRef), strings.CloneStr(item), markDirty)

@borrows
fn WebSceneApplyStringValueToggleEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "string_value_toggle:"
    let stateRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let value = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    if stateRef.len == 0 || value.len == 0:
        return -1
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    var nextValue = WebSceneCloneStateString(value)
    if current == value:
        nextValue = ""
    let status = WebSceneSetStateValueInternal(graph, strings.CloneStr(stateRef), nextValue, markDirty)
    if status < 0:
        return -1
    return status

@borrows
fn WebSceneApplyStringArrayRemoveIndexEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "string_array_remove_index:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, colon)
    let indexText = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    var removeIndex: int32
    if !WebSceneParseEffectInt32(indexText, removeIndex):
        return -1
    return WebSceneRemoveStringArrayStateIndexInternal(graph, stateRef, removeIndex, markDirty)

@borrows
fn WebSceneApplyStringArrayAddUniqueTrimEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "string_array_add_unique_trim:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, colon)
    let draftRef = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    return WebSceneAddUniqueTrimmedStringArrayStateInternal(graph, stateRef, draftRef, markDirty)

@borrows
fn WebSceneApplyProfileDomainTransferEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "profile_domain_transfer:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let targetRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let domainRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let showRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let errorRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let invalidMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    if targetRef.len == 0 || domainRef.len == 0 || showRef.len == 0 || errorRef.len == 0 || invalidMessage.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 5).len > 0:
        return -1
    let target = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, targetRef))
    if target.len < 6:
        return WebSceneSetStateValueInternal(graph, errorRef, invalidMessage, markDirty)

    var touched: bool
    let domainStatus = WebSceneSetStateValueInternal(graph, domainRef, "", false)
    if domainStatus < 0:
        return -1
    if domainStatus > 0:
        touched = true
    let targetStatus = WebSceneSetStateValueInternal(graph, targetRef, "", false)
    if targetStatus < 0:
        return -1
    if targetStatus > 0:
        touched = true
    let showStatus = WebSceneSetStateValueInternal(graph, showRef, "false", false)
    if showStatus < 0:
        return -1
    if showStatus > 0:
        touched = true
    let errorStatus = WebSceneSetStateValueInternal(graph, errorRef, "", false)
    if errorStatus < 0:
        return -1
    if errorStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyDoudizhuCardClickEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "doudizhu_card_click:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, colon)
    let cardIdText = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    var cardId: int32
    if !WebSceneParseEffectInt32(cardIdText, cardId):
        return -1
    if WebSceneStateValueForRef(graph, "ref:suppressNextClickRef") == "true":
        return WebSceneSetStateValueInternal(graph, "ref:suppressNextClickRef", "false", false)
    let myTurn = WebSceneStateValueForRef(graph, "isMyTurn")
    if myTurn.len > 0 && myTurn != "true":
        return 0
    if WebSceneStateValueForRef(graph, "roomBusy") == "true":
        return 0
    var touched: bool
    let toastStatus = WebSceneSetStateValueInternal(graph, "toast", "null", false)
    if toastStatus < 0:
        return -1
    if toastStatus > 0:
        touched = true
    let selectedStatus = WebSceneToggleJsonNumberSetStateInternal(graph, stateRef, cardId, false)
    if selectedStatus < 0:
        return -1
    if selectedStatus > 0:
        touched = true
        let visualStatus = WebSceneRefreshStateSetStyleBindingsForState(graph, stateRef, WebSceneStateValueForRef(graph, stateRef), false)
        if visualStatus < 0:
            return -1
        if visualStatus > 0:
            touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyDoudizhuCardDragBeginEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "doudizhu_card_drag_begin:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, colon)
    let cardIdText = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    var cardId: int32
    if !WebSceneParseEffectInt32(cardIdText, cardId):
        return -1
    let myTurn = WebSceneStateValueForRef(graph, "isMyTurn")
    if myTurn.len > 0 && myTurn != "true":
        return 0
    if WebSceneStateValueForRef(graph, "roomBusy") == "true":
        return 0
    var currentItems: int32[]
    if !WebSceneParseJsonNumberArrayState(WebSceneStateValueForRef(graph, stateRef), currentItems):
        return -1
    let shouldSelect = !WebSceneJsonNumberArrayContains(currentItems, cardId)
    var touched: bool
    var status = WebSceneSetStateValueInternal(graph, "toast", "null", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "ref:suppressNextClickRef", "true", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "ref:dragSelectActive", "true", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    var shouldSelectText = "false"
    if shouldSelect:
        shouldSelectText = "true"
    status = WebSceneSetStateValueInternal(graph, "ref:dragSelectShouldSelect", shouldSelectText, false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    var touchedItems: int32[]
    add(touchedItems, cardId)
    status = WebSceneSetStateValueInternal(graph, "ref:dragSelectTouchedIds", WebSceneEncodeJsonNumberArrayState(touchedItems), false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetJsonNumberSetItemStateInternal(graph, stateRef, cardId, shouldSelect, false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
        let visualStatus = WebSceneRefreshStateSetStyleBindingsForState(graph, stateRef, WebSceneStateValueForRef(graph, stateRef), false)
        if visualStatus < 0:
            return -1
        if visualStatus > 0:
            touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyDoudizhuCardDragEnterAtEffectSegment(graph: var WebSceneGraph,
                                                     routeIndex: int32,
                                                     segment: str,
                                                     xMilli: int32,
                                                     yMilli: int32,
                                                     markDirty: bool): int32 =
    let prefix = "doudizhu_card_drag_enter_at:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, colon)
    let cardIdPropName = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    if stateRef.len == 0 || cardIdPropName.len == 0:
        return -1
    if WebSceneStateValueForRef(graph, "ref:dragSelectActive") != "true":
        return 0
    let cardNodeId = WebSceneFindTopNodeWithPropAtPointMilli(graph, routeIndex, cardIdPropName, xMilli, yMilli)
    if cardNodeId < 0:
        return -1
    if cardNodeId == 0:
        return 0
    var cardId: int32
    if !WebSceneParseEffectInt32(WebSceneNodePropValue(graph, routeIndex, cardNodeId, cardIdPropName), cardId):
        return 0
    var touchedItems: int32[]
    if !WebSceneParseJsonNumberArrayState(WebSceneStateValueForRef(graph, "ref:dragSelectTouchedIds"), touchedItems):
        return -1
    if WebSceneJsonNumberArrayContains(touchedItems, cardId):
        return 0
    let shouldSelectText = WebSceneStateValueForRef(graph, "ref:dragSelectShouldSelect")
    if shouldSelectText != "true" && shouldSelectText != "false":
        return -1
    let shouldSelect = shouldSelectText == "true"
    add(touchedItems, cardId)
    var touched: bool
    var status = WebSceneSetStateValueInternal(graph, "ref:dragSelectTouchedIds", WebSceneEncodeJsonNumberArrayState(touchedItems), false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, "toast", "null", false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetJsonNumberSetItemStateInternal(graph, stateRef, cardId, shouldSelect, false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
        let visualStatus = WebSceneRefreshStateSetStyleBindingsForState(graph, stateRef, WebSceneStateValueForRef(graph, stateRef), false)
        if visualStatus < 0:
            return -1
        if visualStatus > 0:
            touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

fn WebScenePublishTagEffectCharAllowed(ch: char): bool =
    if ch == ':' || ch == ';' || ch == '#':
        return false
    if WebSceneAsciiWhitespace(ch):
        return false
    return true

@borrows
fn WebScenePublishTagAllowed(tag: str): bool =
    if tag.len < 2:
        return false
    for i in 0..<tag.len:
        if !WebScenePublishTagEffectCharAllowed(tag[i]):
            return false
    return true

fn WebSceneAsciiWhitespace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

@borrows
fn WebScenePublishTagBoundaryAfterAt(value: str, index: int32): bool =
    if index >= value.len:
        return true
    let ch = value[index]
    if WebSceneAsciiWhitespace(ch):
        return true
    return ch == '#' ||
        ch == ',' ||
        ch == '.' ||
        ch == '!' ||
        ch == '?' ||
        ch == ';' ||
        ch == ':' ||
        WebSceneStrStartsWithAt(value, "，", index) ||
        WebSceneStrStartsWithAt(value, "。", index) ||
        WebSceneStrStartsWithAt(value, "！", index) ||
        WebSceneStrStartsWithAt(value, "？", index) ||
        WebSceneStrStartsWithAt(value, "；", index) ||
        WebSceneStrStartsWithAt(value, "：", index) ||
        WebSceneStrStartsWithAt(value, "、", index)

@borrows
fn WebScenePublishTagBoundaryBeforeAt(value: str, index: int32): bool =
    if index <= 0:
        return true
    return WebSceneAsciiWhitespace(value[index - 1])

@borrows
fn WebScenePublishTagTokenEnd(value: str, start: int32): int32 =
    var i = start
    while i < value.len:
        if WebScenePublishTagBoundaryAfterAt(value, i):
            return i
        i = i + 1
    return i

fn WebSceneAsciiCharEqualFold(a: char, b: char): bool =
    if a == b:
        return true
    if a >= 'A' && a <= 'Z':
        return char(int32(a) + 32) == b
    if b >= 'A' && b <= 'Z':
        return a == char(int32(b) + 32)
    return false

@borrows
fn WebSceneSliceEqualsAsciiFold(value: str, start: int32, length: int32, expected: str): bool =
    if length != expected.len:
        return false
    if start < 0 || length < 0 || start + length > value.len:
        return false
    for i in 0..<length:
        if !WebSceneAsciiCharEqualFold(value[start + i], expected[i]):
            return false
    return true

@borrows
fn WebScenePublishTagTokenMatches(value: str, hashIndex: int32, tag: str): bool =
    if hashIndex < 0 || hashIndex >= value.len:
        return false
    if value[hashIndex] != '#':
        return false
    if !WebScenePublishTagBoundaryBeforeAt(value, hashIndex):
        return false
    let tokenStart = hashIndex + 1
    let tokenEnd = WebScenePublishTagTokenEnd(value, tokenStart)
    if tokenEnd - tokenStart < 2:
        return false
    return WebSceneSliceEqualsAsciiFold(value, tokenStart, tokenEnd - tokenStart, tag)

@borrows
fn WebScenePublishTagListContains(tags: var str[], tag: str): bool =
    for i in 0..<tags.len:
        if WebSceneSliceEqualsAsciiFold(tags[i], 0, tags[i].len, tag):
            return true
    return false

@borrows
fn WebScenePublishTagUniqueCount(value: str): int32 =
    var tags: str[]
    var i: int32
    while i < value.len:
        if value[i] == '#' && WebScenePublishTagBoundaryBeforeAt(value, i):
            let tokenStart = i + 1
            let tokenEnd = WebScenePublishTagTokenEnd(value, tokenStart)
            if tokenEnd - tokenStart >= 2:
                let token = strings.SliceBytes(value, tokenStart, tokenEnd - tokenStart)
                if !WebScenePublishTagListContains(tags, token):
                    add(tags, WebSceneCloneStateString(token))
            i = tokenEnd
        else:
            i = i + 1
    return tags.len

@borrows
fn WebScenePublishTagContains(value: str, tag: str): bool =
    var i: int32
    while i < value.len:
        if value[i] == '#' && WebScenePublishTagTokenMatches(value, i, tag):
            return true
        i = i + 1
    return false

@borrows
fn WebScenePublishTagRemove(value: str, tag: str): str =
    var out: str
    var segmentStart: int32
    var i: int32
    while i < value.len:
        if value[i] == '#' && WebScenePublishTagTokenMatches(value, i, tag):
            if i > segmentStart:
                out = strings.ConcatStr(out, strings.SliceBytes(value, segmentStart, i - segmentStart))
            var skipEnd = WebScenePublishTagTokenEnd(value, i + 1)
            if skipEnd < value.len && WebSceneAsciiWhitespace(value[skipEnd]):
                skipEnd = skipEnd + 1
            i = skipEnd
            segmentStart = skipEnd
        else:
            i = i + 1
    if segmentStart < value.len:
        out = strings.ConcatStr(out, strings.SliceBytes(value, segmentStart, value.len - segmentStart))
    return out

@borrows
fn WebScenePublishTagAppend(value: str, tag: str): str =
    var out = WebSceneCloneStateString(value)
    if out.len > 0 && !WebSceneAsciiWhitespace(out[out.len - 1]):
        out = strings.ConcatStr(out, " ")
    out = strings.ConcatStr(out, "#")
    out = strings.ConcatStr(out, WebSceneCloneStateString(tag))
    return strings.ConcatStr(out, " ")

@borrows
fn WebScenePublishTopicBoundaryAt(value: str, index: int32): bool =
    if index < 0 || index >= value.len:
        return true
    let ch = value[index]
    if WebSceneAsciiWhitespace(ch):
        return true
    return ch == ',' ||
        ch == '.' ||
        ch == '!' ||
        ch == '?' ||
        ch == ';' ||
        ch == ':' ||
        WebSceneStrStartsWithAt(value, "，", index) ||
        WebSceneStrStartsWithAt(value, "。", index) ||
        WebSceneStrStartsWithAt(value, "！", index) ||
        WebSceneStrStartsWithAt(value, "？", index) ||
        WebSceneStrStartsWithAt(value, "；", index) ||
        WebSceneStrStartsWithAt(value, "：", index) ||
        WebSceneStrStartsWithAt(value, "、", index)

@borrows
fn WebSceneEncodePublishTagTrigger(startChars: int32, endChars: int32, draft: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.IntToStr(startChars), ":"), strings.IntToStr(endChars)), strings.ConcatStr(":", draft))

@borrows
fn WebScenePublishTagTriggerStateForCursor(value: str, cursorChars: int32): str =
    if cursorChars <= 0:
        return ""
    let cursorByte = WebSceneUtf8ByteOffsetForCharIndex(value, cursorChars)
    if cursorByte <= 0 || cursorByte > value.len:
        return ""
    var startByte = cursorByte - 1
    while startByte >= 0 && !WebScenePublishTopicBoundaryAt(value, startByte):
        startByte = startByte - 1
    startByte = startByte + 1
    if startByte >= cursorByte:
        return ""
    let token = strings.SliceBytes(value, startByte, cursorByte - startByte)
    if token.len <= 0 || token[0] != '#':
        return ""
    for i in 1..<token.len:
        if token[i] == '#':
            return ""
    let draft = strings.SliceBytes(token, 1, token.len - 1)
    let prefix = strings.SliceBytes(value, 0, startByte)
    let startChars = WebSceneUtf8CharCount(prefix)
    if startChars < 0:
        return ""
    return WebSceneEncodePublishTagTrigger(startChars, cursorChars, draft)

@borrows
fn WebSceneSelectionStartForTextNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, value: str): int32 =
    var selectionStart: int32
    let rawSelection = WebSceneNodePropValue(graph, routeIndex, nodeId, "selectionStart")
    if rawSelection.len > 0:
        if !WebSceneParseEffectInt32(rawSelection, selectionStart):
            return -1
    else:
        selectionStart = WebSceneUtf8CharCount(value)
        if selectionStart < 0:
            return -1
    let charCount = WebSceneUtf8CharCount(value)
    if charCount < 0:
        return -1
    if selectionStart < 0:
        return 0
    if selectionStart > charCount:
        return charCount
    return selectionStart

@borrows
fn WebSceneFindTextInputNodeForStateRef(graph: var WebSceneGraph, routeIndex: int32, stateRef: str): int32 =
    for i in 0..<graph.eventHandlers.len:
        if graph.eventHandlers[i].routeIndex == routeIndex &&
           graph.eventHandlers[i].stateRef == stateRef &&
           WebSceneEventHandlerAcceptsTextInput(graph.eventHandlers[i]):
            return graph.eventHandlers[i].nodeId
    return -1

@borrows
fn WebSceneApplyTextInputResetEffectSegment(graph: var WebSceneGraph,
                                            routeIndex: int32,
                                            segment: str,
                                            markDirty: bool): int32 =
    let prefix = "text_input_reset:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let stateRef = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    if stateRef.len == 0:
        return -1
    if WebSceneFindEffectChar(stateRef, ':', 0) >= 0:
        return -1
    let inputNodeId = WebSceneFindTextInputNodeForStateRef(graph, routeIndex, stateRef)
    if inputNodeId <= 0:
        return -1
    if !WebSceneApplyNodeTextInputValueWithSelection(graph, routeIndex, inputNodeId, "", 0, markDirty):
        return -1
    return 1

@borrows
fn WebSceneApplyPublishTagCursorEffectSegment(graph: var WebSceneGraph,
                                              routeIndex: int32,
                                              nodeId: int32,
                                              segment: str,
                                              markDirty: bool): int32 =
    let prefix = "publish_tag_cursor:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let contentRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let triggerRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    if contentRef.len == 0 || triggerRef.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 2).len > 0:
        return -1
    let content = WebSceneStateValueForRef(graph, contentRef)
    let selectionStart = WebSceneSelectionStartForTextNode(graph, routeIndex, nodeId, content)
    if selectionStart < 0:
        return -1
    let trigger = WebScenePublishTagTriggerStateForCursor(content, selectionStart)
    let status = WebSceneSetStateValueInternal(graph, triggerRef, trigger, markDirty)
    if status < 0:
        return -1
    return status

@borrows
fn WebSceneApplyPublishTopicMarkerEffectSegment(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                segment: str,
                                                markDirty: bool): int32 =
    let prefix = "publish_topic_marker:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let contentRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let triggerRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    if contentRef.len == 0 || triggerRef.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 2).len > 0:
        return -1
    let inputNodeId = WebSceneFindTextInputNodeForStateRef(graph, routeIndex, contentRef)
    if inputNodeId <= 0:
        return -1
    let content = WebSceneStateValueForRef(graph, contentRef)
    let selectionStart = WebSceneSelectionStartForTextNode(graph, routeIndex, inputNodeId, content)
    if selectionStart < 0:
        return -1
    let cursorByte = WebSceneUtf8ByteOffsetForCharIndex(content, selectionStart)
    if cursorByte < 0 || cursorByte > content.len:
        return -1
    let prefixText = strings.SliceBytes(content, 0, cursorByte)
    let suffixText = strings.SliceBytes(content, cursorByte, content.len - cursorByte)
    var separator: str
    if prefixText.len > 0 && !WebSceneAsciiWhitespace(prefixText[prefixText.len - 1]):
        separator = " "
    let nextContent = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(prefixText, separator), "#"), suffixText)
    let prefixChars = WebSceneUtf8CharCount(prefixText)
    let separatorChars = WebSceneUtf8CharCount(separator)
    if prefixChars < 0 || separatorChars < 0:
        return -1
    let triggerStart = prefixChars + separatorChars
    let nextCursor = triggerStart + 1
    var touched: bool
    var status = WebSceneSetStateValueInternal(graph, contentRef, nextContent, false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneSetStateValueInternal(graph, triggerRef, WebSceneEncodePublishTagTrigger(triggerStart, nextCursor, ""), false)
    if status < 0:
        return -1
    if status > 0:
        touched = true
    if !WebSceneSetNodePropValue(graph, routeIndex, inputNodeId, "value", nextContent):
        return -1
    if !WebSceneSetNodePropValue(graph, routeIndex, inputNodeId, "selectionStart", strings.IntToStr(nextCursor)):
        return -1
    if !WebSceneApplyTextControlPaintValue(graph, routeIndex, inputNodeId, nextContent):
        return -1
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyPublishTagToggleEffect(graph: var WebSceneGraph, stateRef: str, tag: str, markDirty: bool): int32 =
    if stateRef.len == 0:
        return -1
    if !WebScenePublishTagAllowed(tag):
        return -1
    let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
    var nextValue = WebSceneCloneStateString(current)
    if WebScenePublishTagContains(current, tag):
        nextValue = WebScenePublishTagRemove(current, tag)
    elif WebScenePublishTagUniqueCount(current) < 5:
        nextValue = WebScenePublishTagAppend(current, tag)
    let contentStatus = WebSceneSetStateValueInternal(graph, stateRef, nextValue, false)
    if contentStatus < 0:
        return -1
    var touched = contentStatus > 0
    if WebSceneFindStateIndex(graph, "activeTagTrigger") >= 0:
        let triggerStatus = WebSceneSetStateValueInternal(graph, "activeTagTrigger", "", false)
        if triggerStatus < 0:
            return -1
        if triggerStatus > 0:
            touched = true
    if touched:
        if markDirty:
            if !WebSceneMarkStateDirty(graph):
                return -1
        return 1
    return 0

@borrows
fn WebSceneApplyPublishTagEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "publish_tag_toggle:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let stateRef = strings.SliceBytes(body, 0, colon)
    let tag = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    if stateRef.len == 0 || tag.len == 0:
        return -1
    return WebSceneApplyPublishTagToggleEffect(graph, stateRef, tag, markDirty)

fn WebSceneDappSlowPlaybackFormatTenths(tenths: int32): str =
    let whole = tenths / 10
    let frac = tenths % 10
    if frac == 0:
        return strings.IntToStr(whole)
    return strings.ConcatStr(strings.ConcatStr(strings.IntToStr(whole), "."), strings.IntToStr(frac))

@borrows
fn WebSceneParseDappSlowPlaybackPermille(value: str, out: var int32): bool =
    var start: int32
    var stop = value.len
    while start < stop && WebSceneAsciiWhitespace(value[start]):
        start = start + 1
    while stop > start && WebSceneAsciiWhitespace(value[stop - 1]):
        stop = stop - 1
    if start >= stop:
        return false
    if value[start] == '+':
        start = start + 1
        if start >= stop:
            return false
    return WebSceneParseCssNumberPermilleRange(value, start, stop, out)

@borrows
fn WebSceneDappSlowPlaybackNormalizedDraft(raw: str, draftPresent: bool): str =
    if raw.len == 0:
        if draftPresent:
            return "1"
        return "300"
    var permille: int32
    if !WebSceneParseDappSlowPlaybackPermille(raw, permille):
        return "300"
    var tenths: int32
    if permille >= 0:
        tenths = (permille + 50) / 100
    else:
        tenths = (permille - 50) / 100
    if tenths < 10:
        tenths = 10
    if tenths > 5000:
        tenths = 5000
    return WebSceneDappSlowPlaybackFormatTenths(tenths)

@borrows
fn WebSceneApplyDappSlowPlaybackCommitEffect(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let body = strings.SliceBytes(segment, 26, segment.len - 26)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    let settingsRef = strings.SliceBytes(body, 0, colon)
    let draftRef = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    if settingsRef.len == 0 || draftRef.len == 0:
        return -1
    let draftIndex = WebSceneFindStateIndex(graph, draftRef)
    var rawDraft = "300"
    if draftIndex >= 0:
        rawDraft = graph.stateEntries[draftIndex].value
    let normalized = WebSceneDappSlowPlaybackNormalizedDraft(rawDraft, draftIndex >= 0)
    let settingsStatus = WebSceneSetStateValueInternal(graph, settingsRef, normalized, markDirty)
    if settingsStatus < 0:
        return -1
    let draftStatus = WebSceneSetStateValueInternal(graph, draftRef, normalized, markDirty)
    if draftStatus < 0:
        return -1
    if settingsStatus > 0 || draftStatus > 0:
        return 1
    return 0

@borrows
fn WebSceneEffectPartAfterPrefix(effect: str, prefix: str, ordinal: int32): str =
    if ordinal < 0:
        return ""
    if !WebSceneStrStartsWith(effect, prefix):
        return ""
    let rest = strings.SliceBytes(effect, prefix.len, effect.len - prefix.len)
    var partStart: int32
    var partOrdinal: int32
    var i: int32
    while i <= rest.len:
        if i == rest.len:
            if partOrdinal == ordinal:
                return strings.SliceBytes(rest, partStart, i - partStart)
            return ""
        if strings.SliceBytes(rest, i, 1) == ":":
            if partOrdinal == ordinal:
                return strings.SliceBytes(rest, partStart, i - partStart)
            partOrdinal = partOrdinal + 1
            partStart = i + 1
        i = i + 1
    return ""

@borrows
fn WebSceneApplyDistanceUnitToggleEffect(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "distance_unit_toggle:"
    let unitRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let inputRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let labelRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let kmInput = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let meterInput = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    if unitRef.len == 0 || inputRef.len == 0 || labelRef.len == 0 || kmInput.len == 0 || meterInput.len == 0:
        return -1
    let currentUnit = WebSceneStateValueForRef(graph, unitRef)
    var nextUnit = "m"
    var nextInput = meterInput
    var nextLabel = "m"
    if currentUnit == "m":
        nextUnit = "km"
        nextInput = kmInput
        nextLabel = "km"
    var touched: bool
    let unitStatus = WebSceneSetStateValueInternal(graph, unitRef, nextUnit, false)
    if unitStatus < 0:
        return -1
    if unitStatus > 0:
        touched = true
    let inputStatus = WebSceneSetStateValueInternal(graph, inputRef, nextInput, false)
    if inputStatus < 0:
        return -1
    if inputStatus > 0:
        touched = true
    let labelStatus = WebSceneSetStateValueInternal(graph, labelRef, nextLabel, false)
    if labelStatus < 0:
        return -1
    if labelStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

fn WebSceneIsAsciiDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn WebSceneAsciiDigitValue(ch: char): int32 =
    return int32(ch) - int32('0')

@borrows
fn WebSceneParseEffectInt32(raw: str, out: var int32): bool =
    if raw.len == 0:
        return false
    var i: int32
    var value: int64
    while i < raw.len:
        let ch = raw[i]
        if !WebSceneIsAsciiDigit(ch):
            return false
        value = value * int64(10) + int64(WebSceneAsciiDigitValue(ch))
        if value > int64(2147483647):
            return false
        i = i + 1
    out = int32(value)
    return true

@borrows
fn WebSceneParseSignedDecimalMilli(raw: str, out: var int32): bool =
    if raw.len == 0:
        return false
    var i: int32
    var negative: bool
    if raw[0] == '+':
        i = 1
    elif raw[0] == '-':
        negative = true
        i = 1
    if i >= raw.len:
        return false
    var hadDigit: bool
    var value: int64
    while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
        hadDigit = true
        value = value * int64(10) + int64(WebSceneAsciiDigitValue(raw[i])) * int64(1000)
        if value > int64(2147483647):
            return false
        i = i + 1
    if i < raw.len && raw[i] == '.':
        i = i + 1
        var scale: int64 = 100
        var fracDigits: int32
        while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
            hadDigit = true
            if fracDigits >= 3:
                return false
            value = value + int64(WebSceneAsciiDigitValue(raw[i])) * scale
            scale = scale / int64(10)
            fracDigits = fracDigits + 1
            i = i + 1
    if !hadDigit || i != raw.len:
        return false
    if negative:
        value = 0 - value
    if value < int64(-2147483648) || value > int64(2147483647):
        return false
    out = int32(value)
    return true

@borrows
fn WebSceneApplyBaziCalculateEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "bazi_calculate:"
    let resultRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let activeDayunIdxRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let yearRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let monthRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let dayRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let hourRef = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    let minuteRef = WebSceneEffectPartAfterPrefix(segment, prefix, 6)
    let genderRef = WebSceneEffectPartAfterPrefix(segment, prefix, 7)
    let timezoneRef = WebSceneEffectPartAfterPrefix(segment, prefix, 8)
    let longitudeRef = WebSceneEffectPartAfterPrefix(segment, prefix, 9)
    let useTrueSolarTimeRef = WebSceneEffectPartAfterPrefix(segment, prefix, 10)
    let lateZiBoundaryRef = WebSceneEffectPartAfterPrefix(segment, prefix, 11)
    let currentYearRaw = WebSceneEffectPartAfterPrefix(segment, prefix, 12)
    if resultRef.len == 0 || activeDayunIdxRef.len == 0 || yearRef.len == 0 || monthRef.len == 0 || dayRef.len == 0 || hourRef.len == 0 || minuteRef.len == 0 || genderRef.len == 0 || timezoneRef.len == 0 || longitudeRef.len == 0 || useTrueSolarTimeRef.len == 0 || lateZiBoundaryRef.len == 0 || currentYearRaw.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 13).len > 0:
        return -1
    var year: int32
    var month: int32
    var day: int32
    var hour: int32
    var minute: int32
    var currentYear: int32
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, yearRef), year):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, monthRef), month):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, dayRef), day):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, hourRef), hour):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, minuteRef), minute):
        return -1
    if !WebSceneParseEffectInt32(currentYearRaw, currentYear):
        return -1
    var gender = WebSceneStateValueForRef(graph, genderRef)
    if gender != "男" && gender != "女":
        return -1
    var timezone = WebSceneStateValueForRef(graph, timezoneRef)
    if timezone.len == 0:
        timezone = "Asia/Shanghai"
    let longitudeRaw = WebSceneStateValueForRef(graph, longitudeRef)
    var longitudeMilli: int32
    var hasLongitude: bool
    if longitudeRaw.len > 0:
        if !WebSceneParseSignedDecimalMilli(longitudeRaw, longitudeMilli):
            return -1
        hasLongitude = true
    let useTrueSolarTime = WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, useTrueSolarTimeRef), "true")
    var lateZiBoundary = WebSceneStateValueForRef(graph, lateZiBoundaryRef)
    if lateZiBoundary.len == 0:
        lateZiBoundary = "00:00"
    if lateZiBoundary != "00:00" && lateZiBoundary != "23:00":
        return -1
    var resultJson: str
    var activeDayunIdx: int32
    if !bazi.AstrologyBaziBuildResultJson(year,
                                           month,
                                           day,
                                           hour,
                                           minute,
                                           gender,
                                           timezone,
                                           longitudeMilli,
                                           hasLongitude,
                                           useTrueSolarTime,
                                           lateZiBoundary,
                                           currentYear,
                                           resultJson,
                                           activeDayunIdx):
        return -1
    var touched: bool
    let resultStatus = WebSceneSetStateValueInternal(graph, resultRef, resultJson, false)
    if resultStatus < 0:
        return -1
    if resultStatus > 0:
        touched = true
    if activeDayunIdx >= 0:
        let idxStatus = WebSceneSetStateValueInternal(graph, activeDayunIdxRef, strings.IntToStr(activeDayunIdx), false)
        if idxStatus < 0:
            return -1
        if idxStatus > 0:
            touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyZiweiCalculateEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "ziwei_calculate:"
    let resultRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let yearRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let monthRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let dayRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let shichenRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let genderRef = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    let calendarTypeRef = WebSceneEffectPartAfterPrefix(segment, prefix, 6)
    let minuteRef = WebSceneEffectPartAfterPrefix(segment, prefix, 7)
    let timezoneRef = WebSceneEffectPartAfterPrefix(segment, prefix, 8)
    let longitudeRef = WebSceneEffectPartAfterPrefix(segment, prefix, 9)
    let useTrueSolarTimeRef = WebSceneEffectPartAfterPrefix(segment, prefix, 10)
    let lateZiBoundaryRef = WebSceneEffectPartAfterPrefix(segment, prefix, 11)
    if resultRef.len == 0 || yearRef.len == 0 || monthRef.len == 0 || dayRef.len == 0 || shichenRef.len == 0 || genderRef.len == 0 || calendarTypeRef.len == 0 || minuteRef.len == 0 || timezoneRef.len == 0 || longitudeRef.len == 0 || useTrueSolarTimeRef.len == 0 || lateZiBoundaryRef.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 12).len > 0:
        return -1
    var year: int32
    var month: int32
    var day: int32
    var shichen: int32
    var minute: int32
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, yearRef), year):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, monthRef), month):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, dayRef), day):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, shichenRef), shichen):
        return -1
    if !WebSceneParseEffectInt32(WebSceneStateValueForRef(graph, minuteRef), minute):
        return -1
    let gender = WebSceneStateValueForRef(graph, genderRef)
    if gender != "男" && gender != "女":
        return -1
    let calendarType = WebSceneStateValueForRef(graph, calendarTypeRef)
    if calendarType != "solar" && calendarType != "lunar":
        return -1
    var timezone = WebSceneStateValueForRef(graph, timezoneRef)
    if timezone.len == 0:
        timezone = "Asia/Shanghai"
    let longitudeRaw = WebSceneStateValueForRef(graph, longitudeRef)
    var longitudeMilli: int32
    var hasLongitude: bool
    if longitudeRaw.len > 0:
        if !WebSceneParseSignedDecimalMilli(longitudeRaw, longitudeMilli):
            return -1
        hasLongitude = true
    let useTrueSolarTime = WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, useTrueSolarTimeRef), "true")
    var lateZiBoundary = WebSceneStateValueForRef(graph, lateZiBoundaryRef)
    if lateZiBoundary.len == 0:
        lateZiBoundary = "00:00"
    if lateZiBoundary != "00:00" && lateZiBoundary != "23:00":
        return -1
    var resultJson: str
    if !ziwei.AstrologyZiweiBuildResultJson(year,
                                             month,
                                             day,
                                             shichen,
                                             gender,
                                             calendarType,
                                             minute,
                                             timezone,
                                             longitudeMilli,
                                             hasLongitude,
                                             useTrueSolarTime,
                                             lateZiBoundary,
                                             resultJson):
        return -1
    let resultStatus = WebSceneSetStateValueInternal(graph, resultRef, resultJson, false)
    if resultStatus < 0:
        return -1
    if resultStatus > 0 && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if resultStatus > 0:
        return 1
    return 0

@borrows
fn WebSceneJsonObjectFieldRawValue(raw: str, fieldName: str, outValue: var str): bool =
    var pos = WebSceneSkipJsonWhitespace(raw, 0)
    if pos >= raw.len || raw[pos] != '{':
        return false
    pos = pos + 1
    while pos < raw.len:
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len:
            return false
        if raw[pos] == '}':
            return false
        var key: str
        if !WebSceneJsonStringArrayParseString(raw, pos, key):
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            return false
        pos = WebSceneSkipJsonWhitespace(raw, pos + 1)
        let valueStart = pos
        var valueEnd: int32
        if !WebSceneJsonSkipValue(raw, valueStart, valueEnd):
            return false
        if key == fieldName:
            let trimmedEnd = WebSceneJsonTrimRightWhitespace(raw, valueStart, valueEnd)
            outValue = strings.SliceBytes(raw, valueStart, trimmedEnd - valueStart)
            return true
        pos = WebSceneSkipJsonWhitespace(raw, valueEnd)
        if pos >= raw.len:
            return false
        if raw[pos] == ',':
            pos = pos + 1
        else:
            return false
    return false

@borrows
fn WebSceneJsonObjectStringField(raw: str, fieldName: str, outValue: var str): bool =
    var rawValue: str
    if !WebSceneJsonObjectFieldRawValue(raw, fieldName, rawValue):
        return false
    var pos: int32
    if !WebSceneJsonStringArrayParseString(rawValue, pos, outValue):
        return false
    return pos == rawValue.len

@borrows
fn WebSceneJsonObjectInt32Field(raw: str, fieldName: str, outValue: var int32): bool =
    var rawValue: str
    if !WebSceneJsonObjectFieldRawValue(raw, fieldName, rawValue):
        return false
    return WebSceneParseEffectInt32(rawValue, outValue)

@borrows
fn WebSceneJsonArrayPrependValue(raw: str, value: str, outRaw: var str): bool =
    outRaw = "[]"
    let current = WebSceneTrimAsciiWhitespace(raw)
    if current.len == 0:
        outRaw = strings.ConcatStr(strings.ConcatStr("[", WebSceneCloneStateString(value)), "]")
        return true
    var pos = WebSceneSkipJsonWhitespace(current, 0)
    if pos >= current.len || current[pos] != '[':
        return false
    pos = WebSceneSkipJsonWhitespace(current, pos + 1)
    if pos < current.len && current[pos] == ']':
        pos = WebSceneSkipJsonWhitespace(current, pos + 1)
        if pos != current.len:
            return false
        outRaw = strings.ConcatStr(strings.ConcatStr("[", WebSceneCloneStateString(value)), "]")
        return true
    var next = strings.ConcatStr("[", WebSceneCloneStateString(value))
    while pos < current.len:
        let itemStart = WebSceneSkipJsonWhitespace(current, pos)
        var itemEnd: int32
        if !WebSceneJsonSkipValue(current, itemStart, itemEnd):
            return false
        let trimmedEnd = WebSceneJsonTrimRightWhitespace(current, itemStart, itemEnd)
        next = strings.ConcatStr(next, ",")
        next = strings.ConcatStr(next, WebSceneCloneStateString(strings.SliceBytes(current, itemStart, trimmedEnd - itemStart)))
        pos = WebSceneSkipJsonWhitespace(current, itemEnd)
        if pos >= current.len:
            return false
        if current[pos] == ',':
            pos = WebSceneSkipJsonWhitespace(current, pos + 1)
            if pos < current.len && current[pos] == ']':
                return false
            continue
        if current[pos] == ']':
            pos = WebSceneSkipJsonWhitespace(current, pos + 1)
            if pos != current.len:
                return false
            outRaw = strings.ConcatStr(next, "]")
            return true
        return false
    return false

@borrows
fn WebSceneApplyAstrologyArchiveSaveEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "astrology_archive_save:"
    let kind = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    if kind != "bazi" && kind != "ziwei":
        return -1
    let archivesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let archiveHintRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let resultRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let yearRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let monthRef = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    let dayRef = WebSceneEffectPartAfterPrefix(segment, prefix, 6)
    # bazi parts: 7=hour 8=minute 9=gender 10=timezone 11=longitude 12=useTrueSolarTime
    #             13=lateZiBoundary 14=bindDidOnSave 15=didUser 16=currentYear
    # ziwei parts: 7=shichen 8=minute 9=gender 10=calendarType 11=timezone 12=longitude
    #              13=useTrueSolarTime 14=lateZiBoundary 15=bindDidOnSave 16=didUser
    var calendarTypeRef: str
    var bindDidOnSaveRef: str
    var didUserRef: str
    if kind == "bazi":
        bindDidOnSaveRef = WebSceneEffectPartAfterPrefix(segment, prefix, 14)
        didUserRef = WebSceneEffectPartAfterPrefix(segment, prefix, 15)
        if WebSceneEffectPartAfterPrefix(segment, prefix, 16).len == 0:
            return -1
    else:
        calendarTypeRef = WebSceneEffectPartAfterPrefix(segment, prefix, 10)
        bindDidOnSaveRef = WebSceneEffectPartAfterPrefix(segment, prefix, 15)
        didUserRef = WebSceneEffectPartAfterPrefix(segment, prefix, 16)
        if calendarTypeRef.len == 0:
            return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 17).len > 0:
        return -1
    if archivesRef.len == 0 || archiveHintRef.len == 0 || resultRef.len == 0 || yearRef.len == 0 || monthRef.len == 0 || dayRef.len == 0 || bindDidOnSaveRef.len == 0 || didUserRef.len == 0:
        return -1
    let resultJson = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, resultRef))
    if resultJson.len == 0:
        return 0
    var inputJson: str
    if !WebSceneJsonObjectFieldRawValue(resultJson, "input", inputJson):
        return -1
    var profileJson: str
    if !WebSceneJsonObjectFieldRawValue(resultJson, "profile", profileJson):
        return -1
    var birthYear: int32
    var birthMonth: int32
    var birthDay: int32
    var birthHour: int32
    var birthMinute: int32
    if !WebSceneJsonObjectInt32Field(inputJson, "year", birthYear):
        return -1
    if !WebSceneJsonObjectInt32Field(inputJson, "month", birthMonth):
        return -1
    if !WebSceneJsonObjectInt32Field(inputJson, "day", birthDay):
        return -1
    if !WebSceneJsonObjectInt32Field(inputJson, "hour", birthHour):
        return -1
    if !WebSceneJsonObjectInt32Field(inputJson, "minute", birthMinute):
        return -1
    var gender: str
    if !WebSceneJsonObjectStringField(inputJson, "gender", gender):
        return -1
    var timezone: str
    if !WebSceneJsonObjectStringField(inputJson, "timezone", timezone):
        return -1
    var longitudeMilli: int32
    var hasLongitude: bool
    var longitudeRaw: str
    if WebSceneJsonObjectFieldRawValue(inputJson, "longitude", longitudeRaw):
        if !WebSceneParseSignedDecimalMilli(longitudeRaw, longitudeMilli):
            return -1
        hasLongitude = true
    var useTrueSolarTimeRaw: str
    if !WebSceneJsonObjectFieldRawValue(profileJson, "useTrueSolarTime", useTrueSolarTimeRaw):
        return -1
    let useTrueSolarTime = useTrueSolarTimeRaw == "true"
    var lateZiBoundary: str
    if !WebSceneJsonObjectStringField(profileJson, "lateZiBoundary", lateZiBoundary):
        return -1
    let nowMs = times.EpochTimeMs()
    var touched: bool
    var guideJson: str
    if !archiveguide.AstrologyArchiveDailyGuideJson(birthYear,
                                                      birthMonth,
                                                      birthDay,
                                                      birthHour,
                                                      birthMinute,
                                                      gender,
                                                      timezone,
                                                      longitudeMilli,
                                                      hasLongitude,
                                                      useTrueSolarTime,
                                                      lateZiBoundary,
                                                      nowMs,
                                                      guideJson):
        let failHint = strings.ConcatStr("日参考生成失败，未保存档案：不支持的时区 ", timezone)
        let failStatus = WebSceneSetStateValueInternal(graph, archiveHintRef, failHint, false)
        if failStatus < 0:
            return -1
        if failStatus > 0:
            touched = true
        if touched && markDirty:
            if !WebSceneMarkStateDirty(graph):
                return -1
        if touched:
            return 1
        return 0
    let yearText = WebSceneStateValueForRef(graph, yearRef)
    let monthText = WebSceneStateValueForRef(graph, monthRef)
    let dayText = WebSceneStateValueForRef(graph, dayRef)
    var title = strings.ConcatStr(yearText, "年")
    title = strings.ConcatStr(title, monthText)
    title = strings.ConcatStr(title, "月")
    title = strings.ConcatStr(title, dayText)
    title = strings.ConcatStr(title, "日")
    if kind == "bazi":
        title = strings.ConcatStr(title, " 八字")
    else:
        var calendarPrefix = "农历"
        if WebSceneStateValueForRef(graph, calendarTypeRef) == "solar":
            calendarPrefix = "阳历"
        title = strings.ConcatStr(strings.ConcatStr(calendarPrefix, " "), strings.ConcatStr(title, " 紫微"))
    let bindDidOnSave = WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, bindDidOnSaveRef), "true")
    let didUser = WebSceneStateValueForRef(graph, didUserRef)
    let currentArchives = WebSceneStateValueForRef(graph, archivesRef)
    var itemCount: int32
    if !WebSceneJsonTopLevelArrayItemCount(currentArchives, itemCount):
        itemCount = 0
    let nowMsText = strings.Int64ToStr(nowMs)
    var recordId = strings.ConcatStr("astro_", nowMsText)
    recordId = strings.ConcatStr(recordId, "_")
    recordId = strings.ConcatStr(recordId, strings.IntToStr(itemCount))
    var record = strings.ConcatStr("{\"id\":", WebSceneJsonEncodeString(recordId))
    record = strings.ConcatStr(record, ",\"type\":")
    record = strings.ConcatStr(record, WebSceneJsonEncodeString(kind))
    record = strings.ConcatStr(record, ",\"title\":")
    record = strings.ConcatStr(record, WebSceneJsonEncodeString(title))
    record = strings.ConcatStr(record, ",\"input\":")
    record = strings.ConcatStr(record, inputJson)
    record = strings.ConcatStr(record, ",\"profile\":")
    record = strings.ConcatStr(record, profileJson)
    record = strings.ConcatStr(record, ",\"chart\":")
    record = strings.ConcatStr(record, resultJson)
    if bindDidOnSave && didUser.len > 0:
        record = strings.ConcatStr(record, ",\"didUser\":")
        record = strings.ConcatStr(record, WebSceneJsonEncodeString(didUser))
    record = strings.ConcatStr(record, ",\"dailyGuide\":")
    record = strings.ConcatStr(record, guideJson)
    record = strings.ConcatStr(record, ",\"createdAt\":")
    record = strings.ConcatStr(record, nowMsText)
    record = strings.ConcatStr(record, ",\"updatedAt\":")
    record = strings.ConcatStr(record, nowMsText)
    record = strings.ConcatStr(record, "}")
    var nextArchives: str
    if !WebSceneJsonArrayPrependValue(currentArchives, record, nextArchives):
        nextArchives = strings.ConcatStr(strings.ConcatStr("[", record), "]")
    let archivesStatus = WebSceneSetStateValueInternal(graph, archivesRef, nextArchives, false)
    if archivesStatus < 0:
        return -1
    if archivesStatus > 0:
        touched = true
    var hint = "已保存到本地档案"
    if bindDidOnSave && didUser.len > 0:
        hint = "已保存到本地档案，并绑定当前 DID 用户"
    let hintStatus = WebSceneSetStateValueInternal(graph, archiveHintRef, hint, false)
    if hintStatus < 0:
        return -1
    if hintStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyChatRedPacketSendEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "chat_red_packet_send:"
    let messagesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let amountRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let messageRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let redPacketModalRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let morePanelRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let defaultGreeting = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    if messagesRef.len == 0 || amountRef.len == 0 || messageRef.len == 0 || redPacketModalRef.len == 0 || morePanelRef.len == 0 || defaultGreeting.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 6).len > 0:
        return -1
    var cents: int32
    if !WebSceneParsePositiveDecimalCents(WebSceneStateValueForRef(graph, amountRef), cents):
        return 0
    let rawGreeting = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, messageRef))
    var content = rawGreeting
    if content.len == 0:
        content = WebSceneCloneStateString(defaultGreeting)
    let currentMessages = WebSceneStateValueForRef(graph, messagesRef)
    var nextId: int32
    if !WebSceneChatMessageNextId(graph, messagesRef, currentMessages, nextId):
        return -1
    let amountText = WebSceneEncodeCentsFixed2(cents)
    let messageJson = WebSceneEncodeRedPacketMessage(nextId, content, amountText)
    var nextMessages: str
    if !WebSceneJsonArrayAppendValue(currentMessages, messageJson, nextMessages):
        return -1
    var touched: bool
    let messagesStatus = WebSceneSetStateValueInternal(graph, messagesRef, nextMessages, false)
    if messagesStatus < 0:
        return -1
    if messagesStatus > 0:
        touched = true
    let nextIdRef = strings.ConcatStr(messagesRef, ".__nextId")
    let nextIdStatus = WebSceneSetStateValueInternal(graph, nextIdRef, strings.IntToStr(nextId + 1), false)
    if nextIdStatus < 0:
        return -1
    if nextIdStatus > 0:
        touched = true
    let amountStatus = WebSceneSetStateValueInternal(graph, amountRef, "", false)
    if amountStatus < 0:
        return -1
    if amountStatus > 0:
        touched = true
    let messageStatus = WebSceneSetStateValueInternal(graph, messageRef, defaultGreeting, false)
    if messageStatus < 0:
        return -1
    if messageStatus > 0:
        touched = true
    let modalStatus = WebSceneSetStateValueInternal(graph, redPacketModalRef, "false", false)
    if modalStatus < 0:
        return -1
    if modalStatus > 0:
        touched = true
    let panelStatus = WebSceneSetStateValueInternal(graph, morePanelRef, "false", false)
    if panelStatus < 0:
        return -1
    if panelStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

# Host ABI: bool cheng_host_social_dm_send(const char*, const char*, const char*).
# Desktop/smoke: weak false in program_support_host_runtime. Android APK must
# provide a strong JNI wrapper to Kotlin socialDmSend.
@importc("cheng_host_social_dm_send")
fn cheng_host_social_dm_send(peerId: cstring, conversationId: cstring, messageJson: cstring): bool

fn WebSceneChatTextSendCallHost(peerId: str, conversationId: str, payload: str): bool =
    return cheng_host_social_dm_send(strToCStringTemp(peerId), strToCStringTemp(conversationId), strToCStringTemp(payload))

@borrows
fn WebSceneChatTextSendAddAddr(items: var str[], addr: str) =
    let trimmed = WebSceneTrimAsciiWhitespace(addr)
    if trimmed.len == 0:
        return
    for i in 0..<items.len:
        if items[i] == trimmed:
            return
    add(items, WebSceneCloneStateString(trimmed))

@borrows
fn WebSceneChatTextSendCollectAddrsFromArrayRaw(arrayRaw: str, items: var str[]) =
    var parsed: str[]
    if !WebSceneParseJsonStringArrayState(arrayRaw, parsed):
        return
    for i in 0..<parsed.len:
        WebSceneChatTextSendAddAddr(items, parsed[i])

@borrows
fn WebSceneChatTextSendCollectAddrsFromObject(obj: str, items: var str[]) =
    var raw: str
    if WebSceneJsonObjectFieldRawValue(obj, "seedAddrs", raw):
        WebSceneChatTextSendCollectAddrsFromArrayRaw(raw, items)
    if WebSceneJsonObjectFieldRawValue(obj, "multiaddrs", raw):
        WebSceneChatTextSendCollectAddrsFromArrayRaw(raw, items)
    if WebSceneJsonObjectFieldRawValue(obj, "addresses", raw):
        WebSceneChatTextSendCollectAddrsFromArrayRaw(raw, items)
    if WebSceneJsonObjectFieldRawValue(obj, "addrs", raw):
        WebSceneChatTextSendCollectAddrsFromArrayRaw(raw, items)

@borrows
fn WebSceneChatTextSendCollectAddrsFromPeerArray(arrayRaw: str, peerId: str, items: var str[]) =
    if peerId.len == 0:
        return
    var pos = WebSceneSkipJsonWhitespace(arrayRaw, 0)
    if pos >= arrayRaw.len || arrayRaw[pos] != '[':
        return
    pos = WebSceneSkipJsonWhitespace(arrayRaw, pos + 1)
    if pos < arrayRaw.len && arrayRaw[pos] == ']':
        return
    while pos < arrayRaw.len:
        let itemStart = WebSceneSkipJsonWhitespace(arrayRaw, pos)
        var itemEnd: int32
        if !WebSceneJsonSkipValue(arrayRaw, itemStart, itemEnd):
            return
        let trimmedEnd = WebSceneJsonTrimRightWhitespace(arrayRaw, itemStart, itemEnd)
        let obj = strings.SliceBytes(arrayRaw, itemStart, trimmedEnd - itemStart)
        var objPeer: str
        var matched: bool
        if WebSceneJsonObjectStringField(obj, "peerId", objPeer) && objPeer == peerId:
            matched = true
        var objId: str
        if WebSceneJsonObjectStringField(obj, "id", objId) && objId == peerId:
            matched = true
        if matched:
            WebSceneChatTextSendCollectAddrsFromObject(obj, items)
        pos = WebSceneSkipJsonWhitespace(arrayRaw, itemEnd)
        if pos < arrayRaw.len && arrayRaw[pos] == ',':
            pos = pos + 1
        elif pos < arrayRaw.len && arrayRaw[pos] == ']':
            return
        else:
            return

@borrows
fn WebSceneChatTextSendCollectAddrsFromConversationArray(arrayRaw: str, conversationId: str, peerId: str, items: var str[]) =
    var pos = WebSceneSkipJsonWhitespace(arrayRaw, 0)
    if pos >= arrayRaw.len || arrayRaw[pos] != '[':
        return
    pos = WebSceneSkipJsonWhitespace(arrayRaw, pos + 1)
    if pos < arrayRaw.len && arrayRaw[pos] == ']':
        return
    while pos < arrayRaw.len:
        let itemStart = WebSceneSkipJsonWhitespace(arrayRaw, pos)
        var itemEnd: int32
        if !WebSceneJsonSkipValue(arrayRaw, itemStart, itemEnd):
            return
        let trimmedEnd = WebSceneJsonTrimRightWhitespace(arrayRaw, itemStart, itemEnd)
        let obj = strings.SliceBytes(arrayRaw, itemStart, trimmedEnd - itemStart)
        var matched: bool
        var objId: str
        if WebSceneJsonObjectStringField(obj, "id", objId):
            if (conversationId.len > 0 && objId == conversationId) || (peerId.len > 0 && objId == peerId):
                matched = true
        var objPeer: str
        if WebSceneJsonObjectStringField(obj, "peerId", objPeer) && peerId.len > 0 && objPeer == peerId:
            matched = true
        if matched:
            WebSceneChatTextSendCollectAddrsFromObject(obj, items)
        pos = WebSceneSkipJsonWhitespace(arrayRaw, itemEnd)
        if pos < arrayRaw.len && arrayRaw[pos] == ',':
            pos = pos + 1
        elif pos < arrayRaw.len && arrayRaw[pos] == ']':
            return
        else:
            return

@borrows
fn WebSceneChatTextSendCollectAddrsFromSnapshot(raw: str, peerId: str, items: var str[]) =
    var discovered: str
    if WebSceneJsonObjectFieldRawValue(raw, "discoveredPeers", discovered):
        var peers: str
        if WebSceneJsonObjectFieldRawValue(discovered, "peers", peers):
            WebSceneChatTextSendCollectAddrsFromPeerArray(peers, peerId, items)
    var peersTop: str
    if WebSceneJsonObjectFieldRawValue(raw, "peers", peersTop):
        WebSceneChatTextSendCollectAddrsFromPeerArray(peersTop, peerId, items)
    var connected: str
    if WebSceneJsonObjectFieldRawValue(raw, "connectedPeersInfo", connected):
        WebSceneChatTextSendCollectAddrsFromPeerArray(connected, peerId, items)
    WebSceneChatTextSendCollectAddrsFromPeerArray(raw, peerId, items)
    WebSceneChatTextSendCollectAddrsFromObject(raw, items)

@borrows
fn WebSceneChatTextSendResolvePeerId(graph: var WebSceneGraph): str =
    let chatId = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, "chatId"))
    if WebSceneStrStartsWith(chatId, "dm:"):
        return WebSceneTrimAsciiWhitespace(strings.SliceBytes(chatId, 3, chatId.len - 3))
    if WebSceneStrStartsWith(chatId, "group:"):
        return ""
    let nodePeer = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, "nodeDetailPeerId"))
    if nodePeer.len > 0:
        return nodePeer
    let peer = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, "peerId"))
    if peer.len > 0:
        return peer
    return chatId

@borrows
fn WebSceneChatTextSendResolveConversationId(graph: var WebSceneGraph, peerId: str): str =
    let chatId = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, "chatId"))
    if chatId.len > 0:
        return chatId
    if peerId.len > 0:
        return strings.ConcatStr("dm:", peerId)
    return ""

@borrows
fn WebSceneChatTextSendResolveAddrsJson(graph: var WebSceneGraph, peerId: str, conversationId: str): str =
    var items: str[]
    var raw = WebSceneStateValueForRef(graph, "seedAddrs")
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromArrayRaw(raw, items)
    raw = WebSceneStateValueForRef(graph, "multiaddrs")
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromArrayRaw(raw, items)
    raw = WebSceneStateValueForRef(graph, "conversations")
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromConversationArray(raw, conversationId, peerId, items)
    raw = WebSceneStorageValueForKey(graph, WebSceneSocialConversationsStorageKey)
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromConversationArray(raw, conversationId, peerId, items)
    raw = WebSceneStateValueForRef(graph, "networkDiscoverySnapshot")
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromSnapshot(raw, peerId, items)
    raw = WebSceneStateValueForRef(graph, "discoveredPeers")
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromSnapshot(raw, peerId, items)
    raw = WebSceneStateValueForRef(graph, "nodesLastRaw")
    if raw.len > 0:
        WebSceneChatTextSendCollectAddrsFromSnapshot(raw, peerId, items)
    return WebSceneWebRtcEncodeStringArray(items)

@borrows
fn WebSceneChatTextSendHostPayload(messageJson: str, conversationId: str, addrsJson: str): str =
    var messageId: str
    if !WebSceneJsonObjectStringField(messageJson, "id", messageId):
        messageId = ""
    var content: str
    if !WebSceneJsonObjectStringField(messageJson, "content", content):
        content = ""
    var timestamp: str
    if !WebSceneJsonObjectFieldRawValue(messageJson, "timestamp", timestamp):
        timestamp = "0"
    var out = "{\"kind\":\"social\",\"entity\":\"dm\",\"op\":\"send\",\"type\":\"text\",\"messageType\":\"text\",\"messageId\":"
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(messageId))
    out = strings.ConcatStr(out, ",\"mid\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(messageId))
    out = strings.ConcatStr(out, ",\"id\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(messageId))
    out = strings.ConcatStr(out, ",\"conversationId\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(conversationId))
    out = strings.ConcatStr(out, ",\"text\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"body\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"content\":")
    out = strings.ConcatStr(out, WebSceneJsonEncodeString(content))
    out = strings.ConcatStr(out, ",\"sender\":\"me\",\"status\":\"pending\",\"timestamp\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"timestampMs\":")
    out = strings.ConcatStr(out, timestamp)
    out = strings.ConcatStr(out, ",\"seedAddrs\":")
    out = strings.ConcatStr(out, addrsJson)
    out = strings.ConcatStr(out, ",\"multiaddrs\":")
    out = strings.ConcatStr(out, addrsJson)
    out = strings.ConcatStr(out, "}")
    return out

@borrows
fn WebSceneApplyChatTextSendEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "chat_text_send:"
    let messagesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let inputRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let morePanelRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    if messagesRef.len == 0 || inputRef.len == 0 || morePanelRef.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 3).len > 0:
        return -1
    let content = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, inputRef))
    if content.len == 0:
        return 0
    let currentMessages = WebSceneStateValueForRef(graph, messagesRef)
    var nextId: int32
    if !WebSceneChatMessageNextId(graph, messagesRef, currentMessages, nextId):
        return -1
    let messageJson = WebSceneEncodeTextMessage(nextId, content)
    let peerId = WebSceneChatTextSendResolvePeerId(graph)
    let conversationId = WebSceneChatTextSendResolveConversationId(graph, peerId)
    let isGroup = WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, "isGroup"), "true")
    if !isGroup && peerId.len > 0 && conversationId.len > 0:
        let addrsJson = WebSceneChatTextSendResolveAddrsJson(graph, peerId, conversationId)
        let hostPayload = WebSceneChatTextSendHostPayload(messageJson, conversationId, addrsJson)
        if !WebSceneChatTextSendCallHost(peerId, conversationId, hostPayload):
            return 0
    var nextMessages: str
    if !WebSceneJsonArrayAppendValue(currentMessages, messageJson, nextMessages):
        return -1
    var touched: bool
    let messagesStatus = WebSceneSetStateValueInternal(graph, messagesRef, nextMessages, false)
    if messagesStatus < 0:
        return -1
    if messagesStatus > 0:
        touched = true
    let nextIdRef = strings.ConcatStr(messagesRef, ".__nextId")
    let nextIdStatus = WebSceneSetStateValueInternal(graph, nextIdRef, strings.IntToStr(nextId + 1), false)
    if nextIdStatus < 0:
        return -1
    if nextIdStatus > 0:
        touched = true
    let inputStatus = WebSceneSetStateValueInternal(graph, inputRef, "", false)
    if inputStatus < 0:
        return -1
    if inputStatus > 0:
        touched = true
    let panelStatus = WebSceneSetStateValueInternal(graph, morePanelRef, "false", false)
    if panelStatus < 0:
        return -1
    if panelStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyChatVoiceMessageUnsupportedEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "chat_voice_message_unsupported:"
    let busyRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let hintRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let unsupportedMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    if busyRef.len == 0 || hintRef.len == 0 || unsupportedMessage.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 3).len > 0:
        return -1
    if WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, busyRef), "true"):
        return 0
    let hintStatus = WebSceneSetStateValueInternal(graph, hintRef, unsupportedMessage, false)
    if hintStatus < 0:
        return -1
    if hintStatus > 0 && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    return hintStatus

@borrows
fn WebSceneApplyChatSpeechInputStartUnsupportedEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "chat_speech_input_start_unsupported:"
    let busyRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let supportedRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let asiRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let hintRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let asrUnsupportedMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let recordingUnsupportedMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    if busyRef.len == 0 || supportedRef.len == 0 || asiRef.len == 0 || hintRef.len == 0 || asrUnsupportedMessage.len == 0 || recordingUnsupportedMessage.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 6).len > 0:
        return -1
    if WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, busyRef), "true"):
        return 0
    if WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, supportedRef), "true"):
        return -1
    var nextHint = recordingUnsupportedMessage
    if WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, asiRef), "true"):
        nextHint = asrUnsupportedMessage
    let hintStatus = WebSceneSetStateValueInternal(graph, hintRef, nextHint, false)
    if hintStatus < 0:
        return -1
    if hintStatus > 0 && markDirty:
        if !WebSceneMarkStateDirty(graph):
        return -1
    return hintStatus

@borrows
fn WebSceneApplyChatVideoCallUnsupportedEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "chat_video_call_unsupported:"
    let hintRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let unsupportedMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    if hintRef.len == 0 || unsupportedMessage.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 2).len > 0:
        return -1
    let hintStatus = WebSceneSetStateValueInternal(graph, hintRef, unsupportedMessage, false)
    if hintStatus < 0:
        return -1
    if hintStatus > 0 && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    return hintStatus

@borrows
fn WebSceneApplyChatMessagesScrollStickToBottomEffectSegment(graph: var WebSceneGraph,
                                                             routeIndex: int32,
                                                             nodeId: int32,
                                                             segment: str,
                                                             markDirty: bool): int32 =
    let prefix = "chat_messages_scroll_stick_to_bottom:"
    let stickRefName = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let thresholdRaw = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    if stickRefName.len == 0 || thresholdRaw.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 2).len > 0:
        return -1
    if WebSceneFindEffectChar(stickRefName, ':', 0) >= 0:
        return -1
    let stickRef = strings.ConcatStr("ref:", stickRefName)
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return -1
    var threshold: int32
    if !WebSceneParseEffectInt32(thresholdRaw, threshold):
        return -1
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, routeIndex, nodeId)
    if boxIndex < 0:
        return -1
    let clientHeight = graph.layoutBoxes[boxIndex].height
    if clientHeight <= 0:
        return -1
    let layerId = WebSceneFindNodeLayerId(graph, nodeId)
    if layerId <= 0:
        return -1
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, layerId)
    if layerIndex < 0:
        return -1
    var scrollTop = 0 - graph.layers[layerIndex].offsetY
    if scrollTop < 0:
        scrollTop = 0
    var subtreeCommands: WebScenePaintCommandBuffer
    if !WebSceneBuildRoutePaintCommandsScoped(graph, routeIndex, layerId, nodeId, subtreeCommands, false):
        return -1
    var subtreeBounds: WebSceneRect
    if !WebScenePaintCommandBounds(subtreeCommands, subtreeBounds):
        return -1
    var scrollHeight = clientHeight
    if !subtreeBounds.empty:
        scrollHeight = subtreeBounds.height
    if scrollHeight < clientHeight:
        scrollHeight = clientHeight
    var distanceFromBottom = scrollHeight - scrollTop - clientHeight
    if distanceFromBottom < 0:
        distanceFromBottom = 0
    var nextValue = "false"
    if distanceFromBottom <= threshold:
        nextValue = "true"
    let status = WebSceneSetStateValueInternal(graph, stickRef, nextValue, false)
    if status < 0:
        return -1
    if status > 0 && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    return status

@borrows
fn WebSceneApplyChatLocationSendEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "chat_location_send:"
    let messagesRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let locationNameRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let fetchingRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let hintRef = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let locationModalRef = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let morePanelRef = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    let noGpsMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 6)
    let manualSentMessage = WebSceneEffectPartAfterPrefix(segment, prefix, 7)
    if messagesRef.len == 0 || locationNameRef.len == 0 || fetchingRef.len == 0 || hintRef.len == 0 || locationModalRef.len == 0 || morePanelRef.len == 0 || noGpsMessage.len == 0 || manualSentMessage.len == 0:
        return -1
    if WebSceneEffectPartAfterPrefix(segment, prefix, 8).len > 0:
        return -1
    if WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, fetchingRef), "true"):
        return 0
    let fallbackName = WebSceneTrimAsciiWhitespace(WebSceneStateValueForRef(graph, locationNameRef))
    var touched: bool
    if fallbackName.len == 0:
        let fetchingStatus = WebSceneSetStateValueInternal(graph, fetchingRef, "false", false)
        if fetchingStatus < 0:
            return -1
        if fetchingStatus > 0:
            touched = true
        let hintStatus = WebSceneSetStateValueInternal(graph, hintRef, noGpsMessage, false)
        if hintStatus < 0:
            return -1
        if hintStatus > 0:
            touched = true
        if touched && markDirty:
            if !WebSceneMarkStateDirty(graph):
                return -1
        if touched:
            return 1
        return 0
    let currentMessages = WebSceneStateValueForRef(graph, messagesRef)
    var nextId: int32
    if !WebSceneChatMessageNextId(graph, messagesRef, currentMessages, nextId):
        return -1
    let messageJson = WebSceneEncodeLocationMessage(nextId, fallbackName)
    var nextMessages: str
    if !WebSceneJsonArrayAppendValue(currentMessages, messageJson, nextMessages):
        return -1
    let messagesStatus = WebSceneSetStateValueInternal(graph, messagesRef, nextMessages, false)
    if messagesStatus < 0:
        return -1
    if messagesStatus > 0:
        touched = true
    let nextIdRef = strings.ConcatStr(messagesRef, ".__nextId")
    let nextIdStatus = WebSceneSetStateValueInternal(graph, nextIdRef, strings.IntToStr(nextId + 1), false)
    if nextIdStatus < 0:
        return -1
    if nextIdStatus > 0:
        touched = true
    let fetchingStatus = WebSceneSetStateValueInternal(graph, fetchingRef, "false", false)
    if fetchingStatus < 0:
        return -1
    if fetchingStatus > 0:
        touched = true
    let hintStatus = WebSceneSetStateValueInternal(graph, hintRef, manualSentMessage, false)
    if hintStatus < 0:
        return -1
    if hintStatus > 0:
        touched = true
    let modalStatus = WebSceneSetStateValueInternal(graph, locationModalRef, "false", false)
    if modalStatus < 0:
        return -1
    if modalStatus > 0:
        touched = true
    let panelStatus = WebSceneSetStateValueInternal(graph, morePanelRef, "false", false)
    if panelStatus < 0:
        return -1
    if panelStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

fn WebSceneNodeDetailPeerIdCharAllowed(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= 'a' && ch <= 'z':
        return true
    return ch == '_' || ch == '-'

@borrows
fn WebSceneNodeDetailPeerIdAllowed(peerId: str): bool =
    if peerId.len == 0:
        return false
    for i in 0..<peerId.len:
        if !WebSceneNodeDetailPeerIdCharAllowed(peerId[i]):
            return false
    return true

@borrows
fn WebSceneApplyHomeNodeDetailEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "home_node_detail:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let peerId = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    if !WebSceneNodeDetailPeerIdAllowed(peerId):
        return -1
    var touched: bool
    let peerStatus = WebSceneSetStateValueInternal(graph, "nodeDetailPeerId", peerId, false)
    if peerStatus < 0:
        return -1
    if peerStatus > 0:
        touched = true

    var currentKey: int32
    let keyIndex = WebSceneFindStateIndex(graph, "nodeDetailRequestKey")
    if keyIndex >= 0:
        if !WebSceneParseEffectInt32(graph.stateEntries[keyIndex].value, currentKey):
            return -1
    if currentKey >= 2147483647:
        return -1
    let keyStatus = WebSceneSetStateValueInternal(graph, "nodeDetailRequestKey", strings.IntToStr(currentKey + 1), false)
    if keyStatus < 0:
        return -1
    if keyStatus > 0:
        touched = true

    let tabStatus = WebSceneSetStateValueInternal(graph, "currentTab", "nodes", false)
    if tabStatus < 0:
        return -1
    if tabStatus > 0:
        touched = true

    let beforeRoute = graph.activeRouteIndex
    if !WebSceneSetActiveRouteById(graph, "node_detail"):
        return -1
    let routeChanged = graph.activeRouteIndex != beforeRoute
    if touched && markDirty && !routeChanged:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched || routeChanged:
        return 1
    return 0

@borrows
fn WebSceneParseNonNegativeDecimalMilli(raw: str, out: var int32): bool =
    if raw.len == 0:
        return false
    var i: int32
    var hadDigit: bool
    var value: int64
    while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
        hadDigit = true
        value = value * int64(10) + int64(WebSceneAsciiDigitValue(raw[i])) * int64(1000)
        if value > int64(2147483647):
            return false
        i = i + 1
    if i < raw.len && raw[i] == '.':
        i = i + 1
        var scale: int64 = 100
        var fracDigits: int32
        while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
            hadDigit = true
            if fracDigits >= 3:
                return false
            value = value + int64(WebSceneAsciiDigitValue(raw[i])) * scale
            scale = scale / int64(10)
            fracDigits = fracDigits + 1
            if value > int64(2147483647):
                return false
            i = i + 1
    if !hadDigit || i != raw.len:
        return false
    out = int32(value)
    return true

fn WebSceneEncodeTenthsStateValue(tenths: int32): str =
    let whole = tenths / 10
    let frac = tenths % 10
    if frac == 0:
        return strings.IntToStr(whole)
    return strings.ConcatStr(strings.ConcatStr(strings.IntToStr(whole), "."), strings.IntToStr(frac))

@borrows
fn WebSceneDecimalFractionHasNonZero(raw: str, startIndex: int32, endIndex: int32): bool =
    if startIndex < 0 || endIndex <= startIndex:
        return false
    for i in range(startIndex, endIndex):
        if raw[i] != '0':
            return true
    return false

@borrows
fn WebSceneDecimalFractionAtLeastHalf(raw: str, startIndex: int32, endIndex: int32): bool =
    if startIndex < 0 || endIndex <= startIndex:
        return false
    return raw[startIndex] >= '5'

@borrows
fn WebSceneParseDistanceRangeRoundedDisplay(raw: str,
                                            minValue: int32,
                                            maxValue: int32,
                                            stepValue: int32,
                                            out: var int32): bool =
    if raw.len == 0 || stepValue <= 0:
        return false
    var i: int32
    var negative: bool
    if raw[0] == '+':
        i = 1
    elif raw[0] == '-':
        negative = true
        i = 1
    if i >= raw.len:
        return false
    var hadDigit: bool
    var intPart: int64
    var overflow: bool
    let overflowGuard = int64(maxValue) + int64(stepValue) + int64(1)
    while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
        hadDigit = true
        if !overflow:
            intPart = intPart * int64(10) + int64(WebSceneAsciiDigitValue(raw[i]))
            if intPart > overflowGuard:
                overflow = true
        i = i + 1
    var fracStart: int32 = -1
    var fracEnd: int32 = -1
    if i < raw.len && raw[i] == '.':
        i = i + 1
        fracStart = i
        while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
            hadDigit = true
            i = i + 1
        fracEnd = i
    if !hadDigit || i != raw.len:
        return false
    if negative:
        out = minValue
        return true
    if overflow || intPart > int64(maxValue):
        out = maxValue
        return true
    if intPart < int64(minValue):
        out = minValue
        return true
    if intPart == int64(maxValue) && WebSceneDecimalFractionHasNonZero(raw, fracStart, fracEnd):
        out = maxValue
        return true
    var quotient = int32(intPart) / stepValue
    let remainder = int32(intPart) % stepValue
    let twiceRemainder = remainder * 2
    var roundUp: bool
    if twiceRemainder >= stepValue:
        roundUp = true
    elif twiceRemainder + 2 > stepValue:
        roundUp = WebSceneDecimalFractionAtLeastHalf(raw, fracStart, fracEnd)
    if roundUp:
        quotient = quotient + 1
    var rounded = quotient * stepValue
    if rounded < minValue:
        rounded = minValue
    if rounded > maxValue:
        rounded = maxValue
    out = rounded
    return true

@borrows
fn WebSceneApplyDistanceRangeBlurEffect(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "distance_range_blur:"
    let unitRef = WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let inputRef = WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let metersRef = WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let kmMinRaw = WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let kmMaxRaw = WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let mMinRaw = WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    let mMaxRaw = WebSceneEffectPartAfterPrefix(segment, prefix, 6)
    if unitRef.len == 0 || inputRef.len == 0 || metersRef.len == 0:
        return -1
    var kmMin: int32
    var kmMax: int32
    var mMin: int32
    var mMax: int32
    if !WebSceneParseEffectInt32(kmMinRaw, kmMin):
        return -1
    if !WebSceneParseEffectInt32(kmMaxRaw, kmMax):
        return -1
    if !WebSceneParseEffectInt32(mMinRaw, mMin):
        return -1
    if !WebSceneParseEffectInt32(mMaxRaw, mMax):
        return -1
    let currentUnit = WebSceneStateValueForRef(graph, unitRef)
    let unitIsMeters = currentUnit == "m"
    let minValue = unitIsMeters ? mMin : kmMin
    let maxValue = unitIsMeters ? mMax : kmMax
    let stepValue = unitIsMeters ? 100 : 1
    let rawInput = WebSceneStateValueForRef(graph, inputRef)
    var rounded = minValue
    if rawInput.len > 0 && !WebSceneParseDistanceRangeRoundedDisplay(rawInput, minValue, maxValue, stepValue, rounded):
        rounded = minValue
    var meters = rounded
    if !unitIsMeters:
        meters = rounded * 1000
    let inputText = strings.IntToStr(rounded)
    let metersText = strings.IntToStr(meters)
    var touched: bool
    let inputStatus = WebSceneSetStateValueInternal(graph, inputRef, inputText, false)
    if inputStatus < 0:
        return -1
    if inputStatus > 0:
        touched = true
    let metersStatus = WebSceneSetStateValueInternal(graph, metersRef, metersText, false)
    if metersStatus < 0:
        return -1
    if metersStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyDistanceSliderXEffectSegment(graph: var WebSceneGraph,
                                             routeIndex: int32,
                                             nodeId: int32,
                                             segment: str,
                                             xMilli: int32,
                                             markDirty: bool): int32 =
    let prefix = "distance_slider_x:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let firstColon = WebSceneFindEffectChar(body, ':', 0)
    if firstColon <= 0:
        return -1
    let secondColon = WebSceneFindEffectChar(body, ':', firstColon + 1)
    if secondColon <= firstColon + 1:
        return -1
    if WebSceneFindEffectChar(body, ':', secondColon + 1) >= 0:
        return -1
    let valueRef = strings.SliceBytes(body, 0, firstColon)
    let minRef = strings.SliceBytes(body, firstColon + 1, secondColon - firstColon - 1)
    let maxRef = strings.SliceBytes(body, secondColon + 1, body.len - secondColon - 1)
    if valueRef.len == 0 || minRef.len == 0 || maxRef.len == 0:
        return -1
    let boxIndex = WebSceneFindRuntimeLayoutBoxIndex(graph, routeIndex, nodeId)
    if boxIndex < 0:
        return -1
    if !graph.layoutBoxes[boxIndex].visible || graph.layoutBoxes[boxIndex].width <= 0:
        return -1
    var minMilli: int32
    var maxMilli: int32
    if !WebSceneParseNonNegativeDecimalMilli(WebSceneStateValueForRef(graph, minRef), minMilli):
        return -1
    if !WebSceneParseNonNegativeDecimalMilli(WebSceneStateValueForRef(graph, maxRef), maxMilli):
        return -1
    if maxMilli < minMilli:
        return -1
    let leftMilli = graph.layoutBoxes[boxIndex].x * 1000
    let widthMilli = graph.layoutBoxes[boxIndex].width * 1000
    if widthMilli <= 0:
        return -1
    var clampedXMilli = xMilli
    if clampedXMilli < leftMilli:
        clampedXMilli = leftMilli
    let rightMilli = leftMilli + widthMilli
    if clampedXMilli > rightMilli:
        clampedXMilli = rightMilli
    let rangeMilli = maxMilli - minMilli
    var nextMilli = minMilli
    if rangeMilli > 0:
        nextMilli = minMilli + int32((int64(clampedXMilli - leftMilli) * int64(rangeMilli)) / int64(widthMilli))
    let nextTenths = (nextMilli + 50) / 100
    let nextValue = WebSceneEncodeTenthsStateValue(nextTenths)
    let status = WebSceneSetStateValueInternal(graph, valueRef, nextValue, markDirty)
    if status < 0:
        return -1
    return status

@borrows
fn WebSceneUtf8CharCount(text: str): int32 =
    var cursor: int32
    var count: int32
    while cursor < text.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(text, cursor, text.len, codepoint, nextIndex):
            return -1
        if nextIndex <= cursor:
            return -1
        count = count + 1
        cursor = nextIndex
    return count

@borrows
fn WebSceneUtf8ByteOffsetForCharIndex(text: str, charIndex: int32): int32 =
    if charIndex <= 0:
        return 0
    var cursor: int32
    var count: int32
    while cursor < text.len && count < charIndex:
        var codepoint: int32
        var nextIndex: int32
        if !WebSceneDecodeTextCodepoint(text, cursor, text.len, codepoint, nextIndex):
            return -1
        if nextIndex <= cursor:
            return -1
        count = count + 1
        cursor = nextIndex
    if count == charIndex:
        return cursor
    return text.len

@borrows
fn WebSceneLicensePlateActiveIndex(graph: var WebSceneGraph, activeIndexRef: str, value: str): int32 =
    let charCount = WebSceneUtf8CharCount(value)
    if charCount < 0:
        return -1
    var activeIndex: int32
    let rawActiveIndex = WebSceneStateValueForRef(graph, activeIndexRef)
    if rawActiveIndex.len == 0 || !WebSceneParseEffectInt32(rawActiveIndex, activeIndex):
        activeIndex = charCount < 7 ? charCount : 6
    if activeIndex < 0:
        activeIndex = 0
    if activeIndex > charCount:
        activeIndex = charCount
    if activeIndex > 6:
        activeIndex = 6
    return activeIndex

@borrows
fn WebSceneLicensePlateReplaceOrAppend(value: str, activeIndex: int32, key: str, outValue: var str): bool =
    outValue = WebSceneCloneStateString(value)
    let charCount = WebSceneUtf8CharCount(value)
    if charCount < 0:
        return false
    if charCount >= 7 && activeIndex >= charCount:
        return true
    if activeIndex < charCount:
        let startByte = WebSceneUtf8ByteOffsetForCharIndex(value, activeIndex)
        let endByte = WebSceneUtf8ByteOffsetForCharIndex(value, activeIndex + 1)
        if startByte < 0 || endByte < startByte || endByte > value.len:
            return false
        let prefix = strings.SliceBytes(value, 0, startByte)
        let suffix = strings.SliceBytes(value, endByte, value.len - endByte)
        outValue = strings.ConcatStr(strings.ConcatStr(WebSceneCloneStateString(prefix), WebSceneCloneStateString(key)), WebSceneCloneStateString(suffix))
        return true
    outValue = strings.ConcatStr(WebSceneCloneStateString(value), WebSceneCloneStateString(key))
    return true

@borrows
fn WebSceneApplyLicensePlateKeyEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "license_plate_key:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let firstColon = WebSceneFindEffectChar(body, ':', 0)
    if firstColon <= 0:
        return -1
    let secondColon = WebSceneFindEffectChar(body, ':', firstColon + 1)
    if secondColon <= firstColon + 1:
        return -1
    if WebSceneFindEffectChar(body, ':', secondColon + 1) >= 0:
        return -1
    let valueRef = strings.SliceBytes(body, 0, firstColon)
    let activeIndexRef = strings.SliceBytes(body, firstColon + 1, secondColon - firstColon - 1)
    let key = strings.SliceBytes(body, secondColon + 1, body.len - secondColon - 1)
    if valueRef.len == 0 || activeIndexRef.len == 0 || key.len == 0:
        return -1
    let currentValue = WebSceneStateValueForRef(graph, valueRef)
    let activeIndex = WebSceneLicensePlateActiveIndex(graph, activeIndexRef, currentValue)
    if activeIndex < 0:
        return -1
    var nextValue: str
    if !WebSceneLicensePlateReplaceOrAppend(currentValue, activeIndex, key, nextValue):
        return -1
    let currentCharCount = WebSceneUtf8CharCount(currentValue)
    if currentCharCount < 0:
        return -1
    if currentCharCount >= 7 && activeIndex >= currentCharCount:
        return 0
    var touched: bool
    let valueStatus = WebSceneSetStateValueInternal(graph, valueRef, nextValue, false)
    if valueStatus < 0:
        return -1
    if valueStatus > 0:
        touched = true
    if activeIndex < 6:
        let activeStatus = WebSceneSetStateValueInternal(graph, activeIndexRef, strings.IntToStr(activeIndex + 1), false)
        if activeStatus < 0:
            return -1
        if activeStatus > 0:
            touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneApplyLicensePlateDeleteEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    let prefix = "license_plate_delete:"
    if !WebSceneStrStartsWith(segment, prefix):
        return -1
    let body = strings.SliceBytes(segment, prefix.len, segment.len - prefix.len)
    let colon = WebSceneFindEffectChar(body, ':', 0)
    if colon <= 0 || colon >= body.len - 1:
        return -1
    if WebSceneFindEffectChar(body, ':', colon + 1) >= 0:
        return -1
    let valueRef = strings.SliceBytes(body, 0, colon)
    let activeIndexRef = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
    if valueRef.len == 0 || activeIndexRef.len == 0:
        return -1
    let currentValue = WebSceneStateValueForRef(graph, valueRef)
    let charCount = WebSceneUtf8CharCount(currentValue)
    if charCount < 0:
        return -1
    if charCount == 0:
        return 0
    var activeIndex = WebSceneLicensePlateActiveIndex(graph, activeIndexRef, currentValue)
    if activeIndex < 0:
        return -1
    var removeIndex = activeIndex
    var nextActiveIndex = activeIndex
    if activeIndex == charCount:
        removeIndex = activeIndex - 1
        nextActiveIndex = activeIndex - 1
        if nextActiveIndex < 0:
            nextActiveIndex = 0
    let startByte = WebSceneUtf8ByteOffsetForCharIndex(currentValue, removeIndex)
    let endByte = WebSceneUtf8ByteOffsetForCharIndex(currentValue, removeIndex + 1)
    if startByte < 0 || endByte < startByte || endByte > currentValue.len:
        return -1
    let prefixValue = strings.SliceBytes(currentValue, 0, startByte)
    let suffixValue = strings.SliceBytes(currentValue, endByte, currentValue.len - endByte)
    let nextValue = strings.ConcatStr(prefixValue, suffixValue)
    var touched: bool
    let valueStatus = WebSceneSetStateValueInternal(graph, valueRef, nextValue, false)
    if valueStatus < 0:
        return -1
    if valueStatus > 0:
        touched = true
    let activeStatus = WebSceneSetStateValueInternal(graph, activeIndexRef, strings.IntToStr(nextActiveIndex), false)
    if activeStatus < 0:
        return -1
    if activeStatus > 0:
        touched = true
    if touched && markDirty:
        if !WebSceneMarkStateDirty(graph):
            return -1
    if touched:
        return 1
    return 0

@borrows
fn WebSceneEventEffectGuardAnyGroupStatus(graph: var WebSceneGraph, group: str): int32 =
    # One AND-group of a guard_any segment: comma-separated `ref=pred` terms.
    # Returns 1 when every term matches, 0 when a well-formed term honestly
    # fails, -1 on malformed input (empty group, empty term, or a term without
    # a '=' after a non-empty ref).
    if group.len == 0:
        return -1
    var allMatch = true
    var start = 0
    while start <= group.len:
        var stop = start
        while stop < group.len && group[stop] != ',':
            stop = stop + 1
        let term = strings.SliceBytes(group, start, stop - start)
        let eq = WebSceneFindEffectChar(term, '=', 0)
        if eq <= 0:
            return -1
        let stateRef = strings.SliceBytes(term, 0, eq)
        let expected = strings.SliceBytes(term, eq + 1, term.len - eq - 1)
        let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
        if !WebSceneStateValueMatchesCondition(current, expected):
            allMatch = false
        if stop >= group.len:
            break
        start = stop + 1
    if allMatch:
        return 1
    return 0

@borrows
fn WebSceneEventEffectGuardAnyPasses(graph: var WebSceneGraph, body: str): bool =
    # guard_any body: `|`-separated OR groups of `,`-separated AND terms. The
    # event is allowed when at least one group fully matches. Every group is
    # parsed even after a pass so a malformed group anywhere blocks the event —
    # a broken guard must never silently unlock.
    if body.len == 0:
        return false
    var anyGroupPassed = false
    var groupStart = 0
    while groupStart <= body.len:
        var groupStop = groupStart
        while groupStop < body.len && body[groupStop] != '|':
            groupStop = groupStop + 1
        let group = strings.SliceBytes(body, groupStart, groupStop - groupStart)
        let groupStatus = WebSceneEventEffectGuardAnyGroupStatus(graph, group)
        if groupStatus < 0:
            return false
        if groupStatus > 0:
            anyGroupPassed = true
        if groupStop >= body.len:
            break
        groupStart = groupStop + 1
    return anyGroupPassed

fn WebSceneGuardRefChar(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    if ch == '_' || ch == '$' || ch == '.':
        return true
    return false

# guard_when 段 body(`<modeRef>=<modeCond>:<内层guard>`)里 when 条件与内层 guard 的分界。
# when 条件本身可含 ':'(__not:csv), 因此从左扫描: 第一个使剩余部分是合法内层 guard
# (嵌套 guard_when: 或 <ref>=<cond>)的 ':' 才是分界。生成端(materializer
# sceneGuardWithWhenClause)保证 when 条件是等值字面量或 __not:<字面量>, 不含 ":<ref>=" 形态。
@borrows
fn WebSceneGuardWhenSplitIndex(body: str): int32 =
    var i: int32
    while i < body.len:
        if body[i] == ':':
            let rest = strings.SliceBytes(body, i + 1, body.len - i - 1)
            if WebSceneStrStartsWith(rest, "guard_when:"):
                return i
            var refLen: int32
            while refLen < rest.len && WebSceneGuardRefChar(rest[refLen]):
                refLen = refLen + 1
            if refLen > 0 && refLen < rest.len && rest[refLen] == '=':
                return i
        i = i + 1
    return -1

@borrows
fn WebSceneEventEffectGuardPassesWithKey(graph: var WebSceneGraph, segment: str, eventKey: str): bool =
    if WebSceneStrStartsWith(segment, "guard_state:"):
        let body = strings.SliceBytes(segment, 12, segment.len - 12)
        let eq = WebSceneFindEffectChar(body, '=', 0)
        if eq <= 0:
            return false
        let stateRef = strings.SliceBytes(body, 0, eq)
        let expected = strings.SliceBytes(body, eq + 1, body.len - eq - 1)
        let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
        return WebSceneStateValueMatchesCondition(current, expected)
    if WebSceneStrStartsWith(segment, "guard_when:"):
        # 条件参与 guard: 仅当 when 状态匹配 when 条件时内层 guard 才参与判定, 否则整段
        # 视为通过(publish_product 双模式发布门: csv guard 组只在 mode=csv 时生效,
        # manual 组只在 mode=__not:csv 时生效)。
        let whenBody = strings.SliceBytes(segment, 11, segment.len - 11)
        let split = WebSceneGuardWhenSplitIndex(whenBody)
        if split <= 0:
            return false
        let whenClause = strings.SliceBytes(whenBody, 0, split)
        let innerGuard = strings.SliceBytes(whenBody, split + 1, whenBody.len - split - 1)
        let whenEq = WebSceneFindEffectChar(whenClause, '=', 0)
        if whenEq <= 0:
            return false
        let whenRef = strings.SliceBytes(whenClause, 0, whenEq)
        let whenExpected = strings.SliceBytes(whenClause, whenEq + 1, whenClause.len - whenEq - 1)
        if !WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, whenRef), whenExpected):
            return true
        if WebSceneStrStartsWith(innerGuard, "guard_when:"):
            return WebSceneEventEffectGuardPassesWithKey(graph, innerGuard, eventKey)
        let innerEq = WebSceneFindEffectChar(innerGuard, '=', 0)
        if innerEq <= 0:
            return false
        let innerRef = strings.SliceBytes(innerGuard, 0, innerEq)
        let innerExpected = strings.SliceBytes(innerGuard, innerEq + 1, innerGuard.len - innerEq - 1)
        return WebSceneStateValueMatchesCondition(WebSceneStateValueForRef(graph, innerRef), innerExpected)
    if WebSceneStrStartsWith(segment, "guard_any:"):
        let anyBody = strings.SliceBytes(segment, 10, segment.len - 10)
        return WebSceneEventEffectGuardAnyPasses(graph, anyBody)
    if WebSceneStrStartsWith(segment, "guard_key:"):
        if eventKey.len == 0:
            return false
        let expectedKey = strings.SliceBytes(segment, 10, segment.len - 10)
        return eventKey == expectedKey
    return true

@borrows
fn WebSceneEventEffectGuardsPass(graph: var WebSceneGraph, effect: str): bool =
    return WebSceneEventEffectGuardsPassWithKey(graph, effect, "")

@borrows
fn WebSceneEventEffectGuardsPassWithKey(graph: var WebSceneGraph, effect: str, eventKey: str): bool =
    if effect.len == 0:
        return true
    var start = 0
    while start <= effect.len:
        var stop = start
        while stop < effect.len && effect[stop] != ';':
            stop = stop + 1
        let segment = strings.SliceBytes(effect, start, stop - start)
        if !WebSceneEventEffectGuardPassesWithKey(graph, segment, eventKey):
            return false
        if stop >= effect.len:
            return true
        start = stop + 1
    return true

@borrows
fn WebSceneApplyEventEffectSegment(graph: var WebSceneGraph, segment: str, markDirty: bool): int32 =
    if segment.len == 0:
        return 0
    if WebSceneStrStartsWith(segment, "guard_state:"):
        return 0
    if WebSceneStrStartsWith(segment, "guard_when:"):
        return 0
    if WebSceneStrStartsWith(segment, "guard_any:"):
        return 0
    if WebSceneStrStartsWith(segment, "guard_key:"):
        return 0
    if WebSceneStrStartsWith(segment, "route:"):
        return 0
    if WebSceneStrStartsWith(segment, "invoke:"):
        return 0
    if WebSceneStrStartsWith(segment, "compiled:"):
        # executed by the generated CHT dispatcher in the app-module event ladder;
        # inert here so non-CHT apply paths don't error on it (same as invoke: was).
        return 0
    if WebSceneStrStartsWith(segment, "text_input:"):
        return 0
    if WebSceneStrStartsWith(segment, "no_op:"):
        return 0
    if segment == "stop-propagation":
        return 0
    if segment == "prevent-default":
        return 0
    if WebSceneStrStartsWith(segment, "home_node_detail:"):
        return WebSceneApplyHomeNodeDetailEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "social_app:"):
        return WebSceneApplySocialAppEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_list_toggle:"):
        return WebSceneApplyStringListEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_value_toggle:"):
        return WebSceneApplyStringValueToggleEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_array_add_unique_trim:"):
        return WebSceneApplyStringArrayAddUniqueTrimEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_domain_transfer:"):
        return WebSceneApplyProfileDomainTransferEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "node_remark_cancel:"):
        return WebSceneApplyNodeRemarkCancelEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "node_remark_save:"):
        return WebSceneApplyNodeRemarkSaveEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_save:"):
        return WebSceneApplyProfileAddressSaveEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_edit:"):
        return WebSceneApplyProfileAddressEditEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_set_default:"):
        return WebSceneApplyProfileAddressSetDefaultEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_delete:"):
        return WebSceneApplyProfileAddressDeleteEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "bazi_calculate:"):
        return WebSceneApplyBaziCalculateEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "ziwei_calculate:"):
        return WebSceneApplyZiweiCalculateEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "astrology_archive_save:"):
        return WebSceneApplyAstrologyArchiveSaveEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_red_packet_send:"):
        return WebSceneApplyChatRedPacketSendEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_text_send:"):
        return WebSceneApplyChatTextSendEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_voice_message_unsupported:"):
        return WebSceneApplyChatVoiceMessageUnsupportedEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_speech_input_start_unsupported:"):
        return WebSceneApplyChatSpeechInputStartUnsupportedEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_video_call_unsupported:"):
        return WebSceneApplyChatVideoCallUnsupportedEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_location_send:"):
        return WebSceneApplyChatLocationSendEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_array_remove_index:"):
        return WebSceneApplyStringArrayRemoveIndexEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "doudizhu_card_drag_begin:"):
        return WebSceneApplyDoudizhuCardDragBeginEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "doudizhu_card_click:"):
        return WebSceneApplyDoudizhuCardClickEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "conversation_row_click:"):
        return WebSceneApplyConversationRowClickEffectSegment(graph, graph.activeRouteIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "conversation_row_delete:"):
        return WebSceneApplyConversationRowDeleteEffectSegment(graph, graph.activeRouteIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "publish_tag_toggle:"):
        return WebSceneApplyPublishTagEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "dapp_slow_playback_commit:"):
        return WebSceneApplyDappSlowPlaybackCommitEffect(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "distance_unit_toggle:"):
        return WebSceneApplyDistanceUnitToggleEffect(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "distance_range_blur:"):
        return WebSceneApplyDistanceRangeBlurEffect(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "license_plate_key:"):
        return WebSceneApplyLicensePlateKeyEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "license_plate_delete:"):
        return WebSceneApplyLicensePlateDeleteEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_set_toggle_all_static:"):
        return WebSceneApplyStringSetToggleAllStaticEffectSegmentForRoute(graph, graph.activeRouteIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "toggle:"):
        let stateRef = strings.SliceBytes(segment, 7, segment.len - 7)
        let status = WebSceneToggleStateValueInternal(graph, stateRef, markDirty)
        if status < 0:
            return -1
        return status
    if WebSceneStrStartsWith(segment, "set:"):
        let eq = WebSceneFindEffectChar(segment, '=', 4)
        if eq <= 4:
            return -1
        let stateRef = strings.SliceBytes(segment, 4, eq - 4)
        let value = strings.SliceBytes(segment, eq + 1, segment.len - eq - 1)
        let status = WebSceneSetStateValueInternal(graph, stateRef, value, markDirty)
        if status < 0:
            return -1
        return status
    if WebSceneStrStartsWith(segment, "external-publish:"):
        let publishKind = strings.SliceBytes(segment, 17, segment.len - 17)
        if WebSceneSetStateValueInternal(graph, "computerUseLastPublishKind", publishKind, markDirty) < 0:
            return -1
        if WebSceneSetStateValueInternal(graph, "computerUseLastPublishAdmitted", "1", markDirty) < 0:
            return -1
        return 1
    return -1

@borrows
fn WebSceneApplyEventEffectSegmentForNode(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          nodeId: int32,
                                          segment: str,
                                          markDirty: bool): int32 =
    if WebSceneStrStartsWith(segment, "text_input_reset:"):
        nodeId
        return WebSceneApplyTextInputResetEffectSegment(graph, routeIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "publish_tag_cursor:"):
        return WebSceneApplyPublishTagCursorEffectSegment(graph, routeIndex, nodeId, segment, markDirty)
    if WebSceneStrStartsWith(segment, "publish_topic_marker:"):
        return WebSceneApplyPublishTopicMarkerEffectSegment(graph, routeIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "style:opacity="):
        let value = strings.SliceBytes(segment, 14, segment.len - 14)
        return WebSceneApplyNodeInlineOpacity(graph, routeIndex, nodeId, value, markDirty)
    if WebSceneStrStartsWith(segment, "media_lifecycle:"):
        let body = strings.SliceBytes(segment, 16, segment.len - 16)
        var actionKind = body
        var condition = ""
        let colon = WebSceneFindEffectChar(body, ':', 0)
        if colon >= 0:
            actionKind = strings.SliceBytes(body, 0, colon)
            condition = strings.SliceBytes(body, colon + 1, body.len - colon - 1)
        if actionKind == "Seek":
            # S6 (video-seek-scrub-blueprint.md §1.3): media_lifecycle:Seek:<slotId>:<ms> —
            # a drag-handle/progress control's segment carries the target slotId explicitly
            # (see WebSceneApplyMediaControlForSlotWithPayload's doc comment for why: it is
            # commonly a DOM sibling of the media node, not a descendant, so the ancestor
            # walk every other branch here relies on cannot find it). No DOM state guard —
            # unlike the other media_lifecycle actions, Seek never routed through that guard
            # (it always fell into WebSceneApplyMediaLifecycleEventForNode, which rejects
            # "Seek" outright — see WebSceneMediaDomLifecycleEvent — so this is a genuinely
            # new, not a reinterpreted, code path).
            let sep = WebSceneFindEffectChar(condition, ':', 0)
            if sep <= 0:
                return -1
            let seekSlotId = strings.SliceBytes(condition, 0, sep)
            let seekPayload = strings.SliceBytes(condition, sep + 1, condition.len - sep - 1)
            return WebSceneApplyMediaControlForSlotWithPayload(graph, seekSlotId, actionKind, seekPayload, markDirty)
        if condition.len > 0:
            let eq = WebSceneFindEffectChar(condition, '=', 0)
            if eq <= 0:
                return -1
            let stateRef = strings.SliceBytes(condition, 0, eq)
            let expected = strings.SliceBytes(condition, eq + 1, condition.len - eq - 1)
            let current = WebSceneStateValueForRef(graph, strings.CloneStr(stateRef))
            if !WebSceneStateValueMatchesCondition(current, expected):
                return 0
        if actionKind == "OpenAsset":
            return WebSceneApplyMediaControlForNode(graph, routeIndex, nodeId, actionKind, markDirty)
        return WebSceneApplyMediaLifecycleEventForNode(graph, routeIndex, nodeId, actionKind, markDirty)
    if WebSceneStrStartsWith(segment, "chat_messages_scroll_stick_to_bottom:"):
        return WebSceneApplyChatMessagesScrollStickToBottomEffectSegment(graph, routeIndex, nodeId, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_set_toggle_all_static:"):
        return WebSceneApplyStringSetToggleAllStaticEffectSegmentForRoute(graph, routeIndex, segment, markDirty)
    return WebSceneApplyEventEffectSegment(graph, segment, markDirty)

@borrows
fn WebSceneApplyEventEffectSegmentForNodeWithKey(graph: var WebSceneGraph,
                                                 routeIndex: int32,
                                                 nodeId: int32,
                                                 segment: str,
                                                 eventKey: str,
                                                 markDirty: bool): int32 =
    routeIndex
    nodeId
    if WebSceneStrStartsWith(segment, "node_remark_keydown:"):
        return WebSceneApplyNodeRemarkKeyDownEffectSegment(graph, segment, eventKey, markDirty)
    return WebSceneApplyEventEffectSegmentForNode(graph, routeIndex, nodeId, segment, markDirty)

@borrows
fn WebSceneApplyEventEffectSegmentForNodeWithPointer(graph: var WebSceneGraph,
                                                     routeIndex: int32,
                                                     nodeId: int32,
                                                     segment: str,
                                                     xMilli: int32,
                                                     yMilli: int32,
                                                     markDirty: bool): int32 =
    yMilli
    if WebSceneStrStartsWith(segment, "more_panel_touch_start:"):
        return WebSceneApplyMorePanelTouchStartEffectSegment(graph, segment, xMilli, yMilli)
    if WebSceneStrStartsWith(segment, "more_panel_touch_end:"):
        return WebSceneApplyMorePanelTouchEndEffectSegment(graph, routeIndex, segment, xMilli, yMilli, markDirty)
    if WebSceneStrStartsWith(segment, "more_panel_touch_cancel:"):
        return WebSceneApplyMorePanelTouchCancelEffectSegment(graph, segment)
    if WebSceneStrStartsWith(segment, "distance_slider_x:"):
        return WebSceneApplyDistanceSliderXEffectSegment(graph, routeIndex, nodeId, segment, xMilli, markDirty)
    if WebSceneStrStartsWith(segment, "doudizhu_card_drag_enter_at:"):
        nodeId
        return WebSceneApplyDoudizhuCardDragEnterAtEffectSegment(graph, routeIndex, segment, xMilli, yMilli, markDirty)
    if WebSceneStrStartsWith(segment, "conversation_row_pointer_down:"):
        return WebSceneApplyConversationRowPointerDownEffectSegment(graph, segment, xMilli, yMilli)
    if WebSceneStrStartsWith(segment, "conversation_row_pointer_move:"):
        return WebSceneApplyConversationRowPointerMoveEffectSegment(graph, routeIndex, segment, xMilli, yMilli, markDirty)
    if WebSceneStrStartsWith(segment, "conversation_row_pointer_end:"):
        return WebSceneApplyConversationRowPointerEndEffectSegment(graph, routeIndex, segment, markDirty)
    return WebSceneApplyEventEffectSegmentForNode(graph, routeIndex, nodeId, segment, markDirty)

@borrows
fn WebSceneEffectValueUsesEventTarget(rawValue: str): bool =
    return rawValue == "e.target.value" ||
        rawValue == "event.target.value" ||
        rawValue == "e.currentTarget.value" ||
        rawValue == "event.currentTarget.value"

