fn WebSceneAddPaintSvgLineKnownPaintOp(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       nodeId: int32,
                                       ordinal: int32,
                                       x1: int32,
                                       y1: int32,
                                       x2: int32,
                                       y2: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetLine(primitive, x1, y1, x2, y2)
    return WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgCircleKnownPaintOp(graph: var WebSceneGraph,
                                         routeIndex: int32,
                                         nodeId: int32,
                                         ordinal: int32,
                                         cx: int32,
                                         cy: int32,
                                         r: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetCircle(primitive, cx, cy, r)
    return WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgEllipseKnownPaintOp(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          nodeId: int32,
                                          ordinal: int32,
                                          cx: int32,
                                          cy: int32,
                                          rx: int32,
                                          ry: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetEllipse(primitive, cx, cy, rx, ry)
    return WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgRectKnownPaintOp(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       nodeId: int32,
                                       ordinal: int32,
                                       x: int32,
                                       y: int32,
                                       width: int32,
                                       height: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetRect(primitive, x, y, width, height)
    return WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgTriangleKnownPaintOp(graph: var WebSceneGraph,
                                           routeIndex: int32,
                                           nodeId: int32,
                                           ordinal: int32,
                                           x1: int32,
                                           y1: int32,
                                           x2: int32,
                                           y2: int32,
                                           x3: int32,
                                           y3: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetTriangle(primitive, x1, y1, x2, y2, x3, y3)
    return WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgFill(graph: var WebSceneGraph,
                           routeIndex: int32,
                           nodeId: int32,
                           ordinal: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetFillMarker(primitive)
    return WebSceneAddPaintSvgPrimitive(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgFillKnownPaintOp(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       nodeId: int32,
                                       ordinal: int32): bool =
    var primitive: paint.PaintSvgPrimitive
    paint.PaintSvgPrimitiveSetFillMarker(primitive)
    return WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph, routeIndex, nodeId, ordinal, primitive)

fn WebSceneAddPaintSvgPrimitive(graph: var WebSceneGraph,
                                routeIndex: int32,
                                nodeId: int32,
                                ordinal: int32,
                                primitive: paint.PaintSvgPrimitive): bool =
    let paintIndex = WebSceneFindPaintOpIndex(graph, routeIndex, nodeId, ordinal)
    if paintIndex < 0:
        return false
    if graph.paintOps[paintIndex].opKind != WebScenePaintSvgIcon:
        return false
    if primitive.kind <= 0:
        return false
    var item: WebScenePaintSvgPrimitive
    item.routeIndex = routeIndex
    item.nodeId = nodeId
    item.ordinal = ordinal
    item.primitive = primitive
    add(graph.paintSvgPrimitives, item)
    return true

fn WebSceneAddPaintSvgPrimitiveKnownPaintOp(graph: var WebSceneGraph,
                                            routeIndex: int32,
                                            nodeId: int32,
                                            ordinal: int32,
                                            primitive: paint.PaintSvgPrimitive): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0 || ordinal < 0:
        return false
    if primitive.kind <= 0:
        return false
    var item: WebScenePaintSvgPrimitive
    item.routeIndex = routeIndex
    item.nodeId = nodeId
    item.ordinal = ordinal
    item.primitive = primitive
    add(graph.paintSvgPrimitives, item)
    return true

fn WebScenePaintCommandBufferInit(buffer: var WebScenePaintCommandBuffer) =
    buffer.routeIndex = -1
    buffer.layerId = 0
    buffer.ops = []

fn WebSceneGpuCommandBufferInit(buffer: var WebSceneGpuCommandBuffer) =
    buffer.routeIndex = -1
    buffer.layerId = 0
    buffer.commands = []

fn WebSceneLayerTransitionPlanInit(plan: var WebSceneLayerTransitionPlan) =
    plan.fromRouteIndex = -1
    plan.toRouteIndex = -1
    plan.actions = []

fn WebSceneImageAtlasInit(atlas: var WebSceneImageAtlas) =
    atlas.entries = []
    atlas.pixels = []

fn WebSceneImageAtlasReleasePixelStorage(atlas: var WebSceneImageAtlas) =
    atlas.pixels = []

fn WebSceneGraphReleaseRasterResourcePixelStorage(graph: var WebSceneGraph) =
    for i in 0..<graph.resources.len:
        if graph.resources[i].pixelCount <= 0:
            continue
        var resource = graph.resources[i]
        resource.pixels = []
        graph.resources[i] = resource

fn WebSceneSvgDisplayListAtlasInit(atlas: var WebSceneSvgDisplayListAtlas) =
    atlas.entries = []
    atlas.primitives = []

fn WebSceneGlyphAtlasInit(atlas: var WebSceneGlyphAtlas) =
    atlas.fonts = []
    atlas.glyphs = []
    atlas.runs = []
    atlas.runGlyphs = []
    atlas.sdfPixels = []
    atlas.sdfPixelCount = 0
    atlas.sdfPixelVersion = 0
    atlas.atlasWidth = 4096
    atlas.atlasHeight = 0
    atlas.glyphPackX = 0
    atlas.glyphPackY = 0
    atlas.glyphPackRowHeight = 0

fn WebSceneGlyphAtlasBumpSdfPixelVersion(atlas: var WebSceneGlyphAtlas) =
    atlas.sdfPixelVersion = atlas.sdfPixelVersion + 1

fn WebSceneCompositorFrameInit(frame: var WebSceneCompositorFrame) =
    frame.routeIndex = -1
    frame.layers = []
    frame.commands = []

fn WebSceneRectInit(rect: var WebSceneRect) =
    rect.x = 0
    rect.y = 0
    rect.width = 0
    rect.height = 0
    rect.empty = true

fn WebSceneRectSet(rect: var WebSceneRect, x: int32, y: int32, width: int32, height: int32): bool =
    if width < 0 || height < 0:
        return false
    rect.x = x
    rect.y = y
    rect.width = width
    rect.height = height
    rect.empty = width == 0 || height == 0
    return true

fn WebSceneRectInclude(rect: var WebSceneRect, x: int32, y: int32, width: int32, height: int32): bool =
    if width < 0 || height < 0:
        return false
    if width == 0 || height == 0:
        return true
    let right = x + width
    let bottom = y + height
    if rect.empty:
        rect.x = x
        rect.y = y
        rect.width = width
        rect.height = height
        rect.empty = false
        return true
    var left = rect.x
    var top = rect.y
    var currentRight = rect.x + rect.width
    var currentBottom = rect.y + rect.height
    if x < left:
        left = x
    if y < top:
        top = y
    if right > currentRight:
        currentRight = right
    if bottom > currentBottom:
        currentBottom = bottom
    rect.x = left
    rect.y = top
    rect.width = currentRight - left
    rect.height = currentBottom - top
    rect.empty = false
    return true

fn WebSceneRectIntersectCurrentViewportForLayer(graph: var WebSceneGraph,
                                                offsetX: int32,
                                                offsetY: int32,
                                                rect: var WebSceneRect): bool =
    if rect.empty:
        return true
    let viewportWidth = graph.currentViewportWidth
    let viewportHeight = graph.currentViewportHeight
    if viewportWidth <= 0 || viewportHeight <= 0:
        return true
    let viewportX = 0 - offsetX
    let viewportY = 0 - offsetY
    let viewportRight = viewportX + viewportWidth
    let viewportBottom = viewportY + viewportHeight
    var left = rect.x
    var top = rect.y
    var right = rect.x + rect.width
    var bottom = rect.y + rect.height
    if viewportX > left:
        left = viewportX
    if viewportY > top:
        top = viewportY
    if viewportRight < right:
        right = viewportRight
    if viewportBottom < bottom:
        bottom = viewportBottom
    if right <= left || bottom <= top:
        WebSceneRectInit(rect)
        return true
    rect.x = left
    rect.y = top
    rect.width = right - left
    rect.height = bottom - top
    rect.empty = false
    return true

fn WebSceneRectEmpty(rect: var WebSceneRect): bool =
    return rect.empty

fn WebSceneRectX(rect: var WebSceneRect): int32 =
    return rect.x

fn WebSceneRectY(rect: var WebSceneRect): int32 =
    return rect.y

fn WebSceneRectWidth(rect: var WebSceneRect): int32 =
    return rect.width

fn WebSceneRectHeight(rect: var WebSceneRect): int32 =
    return rect.height

fn WebScenePaintCommandCount(buffer: var WebScenePaintCommandBuffer): int32 =
    return buffer.ops.len

fn WebScenePaintCommandKindAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.ops.len:
        return -1
    return buffer.ops[index].kind

fn WebScenePaintCommandColorAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.ops.len:
        return 0
    return buffer.ops[index].color

fn WebScenePaintCommandTextAt(buffer: var WebScenePaintCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.ops.len:
        return ""
    return buffer.ops[index].text.text

fn WebScenePaintCommandIconKindAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.ops.len:
        return -1
    return buffer.ops[index].icon.kind

fn WebScenePaintCommandIconPrimitiveCountAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.ops.len:
        return -1
    return buffer.ops[index].icon.primitives.len

fn WebScenePaintCommandRectAt(buffer: var WebScenePaintCommandBuffer, index: int32, rect: var WebSceneRect): bool =
    WebSceneRectInit(rect)
    if index < 0 || index >= buffer.ops.len:
        return false
    let op = buffer.ops[index]
    if op.kind == paint.PaintOpKindClipRect:
        return WebSceneRectSet(rect, op.clipRect.x, op.clipRect.y, op.clipRect.width, op.clipRect.height)
    if op.kind == paint.PaintOpKindBoxShadow:
        if op.shadowInset:
            return WebSceneRectSet(rect, op.rect.x, op.rect.y, op.rect.width, op.rect.height)
        let grow = op.shadowSpread + op.shadowBlur
        let shadowWidth = op.rect.width + grow * 2
        let shadowHeight = op.rect.height + grow * 2
        if shadowWidth < 0 || shadowHeight < 0:
            return false
        return WebSceneRectSet(rect,
                               op.rect.x + op.shadowOffsetX - grow,
                               op.rect.y + op.shadowOffsetY - grow,
                               shadowWidth,
                               shadowHeight)
    if op.kind == paint.PaintOpKindFillRect || op.kind == paint.PaintOpKindStrokeRect || op.kind == paint.PaintOpKindFillText || op.kind == paint.PaintOpKindStrokeText || op.kind == paint.PaintOpKindDrawImage || op.kind == paint.PaintOpKindGradientFill || op.kind == paint.PaintOpKindTextShadow || op.kind == paint.PaintOpKindIcon:
        return WebSceneRectSet(rect, op.rect.x, op.rect.y, op.rect.width, op.rect.height)
    return false

fn WebScenePaintCommandBounds(buffer: var WebScenePaintCommandBuffer, rect: var WebSceneRect): bool =
    WebSceneRectInit(rect)
    for i in 0..<buffer.ops.len:
        var commandRect: WebSceneRect
        if !WebScenePaintCommandRectAt(buffer, i, commandRect):
            return false
        if !commandRect.empty:
            if !WebSceneRectInclude(rect, commandRect.x, commandRect.y, commandRect.width, commandRect.height):
                return false
    return true

fn WebScenePaintCommandRectXAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    var rect: WebSceneRect
    if !WebScenePaintCommandRectAt(buffer, index, rect):
        return 0
    return rect.x

fn WebScenePaintCommandRectYAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    var rect: WebSceneRect
    if !WebScenePaintCommandRectAt(buffer, index, rect):
        return 0
    return rect.y

fn WebScenePaintCommandRectWidthAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    var rect: WebSceneRect
    if !WebScenePaintCommandRectAt(buffer, index, rect):
        return 0
    return rect.width

fn WebScenePaintCommandRectHeightAt(buffer: var WebScenePaintCommandBuffer, index: int32): int32 =
    var rect: WebSceneRect
    if !WebScenePaintCommandRectAt(buffer, index, rect):
        return 0
    return rect.height

