@borrows
fn WebSceneCompositorLayerSetDirtyRectAt(frame: var WebSceneCompositorFrame,
                                         layerIndex: int32,
                                         rect: WebSceneRect): bool =
    if layerIndex < 0 || layerIndex >= frame.layers.len:
        return false
    frame.layers[layerIndex].dirtyRect.x = rect.x
    frame.layers[layerIndex].dirtyRect.y = rect.y
    frame.layers[layerIndex].dirtyRect.width = rect.width
    frame.layers[layerIndex].dirtyRect.height = rect.height
    frame.layers[layerIndex].dirtyRect.empty = rect.empty
    return true

fn WebSceneFindLayerIndex(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    for i in 0..<graph.layers.len:
        if graph.layers[i].routeIndex == routeIndex && graph.layers[i].layerId == layerId:
            return i
    return -1

@borrows
fn WebSceneFindResourceIndex(graph: var WebSceneGraph, resourceKind: str, resourceId: str): int32 =
    for i in 0..<graph.resources.len:
        if graph.resources[i].resourceKind == resourceKind && graph.resources[i].resourceId == resourceId:
            return i
    return -1

fn WebSceneFindLayoutConstraintIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, ordinal: int32): int32 =
    for i in 0..<graph.layoutConstraints.len:
        if graph.layoutConstraints[i].routeIndex == routeIndex && graph.layoutConstraints[i].nodeId == nodeId && graph.layoutConstraints[i].ordinal == ordinal:
            return i
    return -1

fn WebSceneFindPaintOpIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, ordinal: int32): int32 =
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex && graph.paintOps[i].nodeId == nodeId && graph.paintOps[i].ordinal == ordinal:
            return i
    return -1

fn WebScenePaintKindSupported(opKind: int32): bool =
    if opKind == WebScenePaintFill:
        return true
    if opKind == WebScenePaintBorder:
        return true
    if opKind == WebScenePaintTextColor:
        return true
    if opKind == WebScenePaintText:
        return true
    if opKind == WebScenePaintPlaceholderText:
        return true
    if opKind == WebScenePaintSvgIcon:
        return true
    if opKind == WebScenePaintImage:
        return true
    if opKind == WebScenePaintBoxShadow:
        return true
    if opKind == WebScenePaintGradientFill:
        return true
    if opKind == WebScenePaintSvgCirclePattern:
        return true
    return false

fn WebSceneGpuCommandKindSupported(kind: int32): bool =
    if kind == WebSceneGpuFillRect:
        return true
    if kind == WebSceneGpuStrokeRect:
        return true
    if kind == WebSceneGpuFillText:
        return true
    if kind == WebSceneGpuDrawImage:
        return true
    if kind == WebSceneGpuDrawIcon:
        return true
    if kind == WebSceneGpuSetClip:
        return true
    if kind == WebSceneGpuBoxShadow:
        return true
    if kind == WebSceneGpuGradientFill:
        return true
    if kind == WebSceneGpuSvgCirclePattern:
        return true
    if kind == WebSceneGpuDrawMediaSurface:
        return true
    return false

fn WebSceneLayerTransitionActionSupported(action: int32): bool =
    if action == 0:
        return true
    if action == WebSceneLayerTransitionReuse:
        return true
    if action == WebSceneLayerTransitionReplace:
        return true
    if action == WebSceneLayerTransitionDrop:
        return true
    return false

@borrows
fn WebSceneNodeBelongsToRoute(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if WebSceneFindNodeRouteIndex(graph, nodeId) == routeIndex:
        return true
    return false

fn WebSceneFindNodeLayerId(graph: var WebSceneGraph, nodeId: int32): int32 =
    if nodeId <= 0 || nodeId >= graph.nodeIndexById.len:
        return -1
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return -1
    if graph.nodes[nodeIndex].nodeId == nodeId:
        return graph.nodes[nodeIndex].layerId
    return -1

@borrows
fn WebSceneNodeInSubtree(graph: var WebSceneGraph, rootNodeId: int32, nodeId: int32): bool =
    if rootNodeId <= 0 || nodeId <= 0:
        return false
    var current = nodeId
    while current > 0:
        if current == rootNodeId:
            return true
        current = WebSceneFindNodeParentId(graph, current)
    return false

@borrows
fn WebSceneFindNodeParentId(graph: var WebSceneGraph, nodeId: int32): int32 =
    if nodeId <= 0 || nodeId >= graph.nodeParentById.len:
        return -1
    if graph.nodeIndexById[nodeId] < 0:
        return -1
    return graph.nodeParentById[nodeId]
    return -1

fn WebSceneColorInt32(color: int64): int32 =
    return Int32(color)

@borrows
fn WebScenePaintIconKindForResource(resourceId: str): int32 =
    if resourceId == "Globe":
        return paint.PaintIconKindGlobe
    if resourceId == "Check":
        return paint.PaintIconKindCheck
    if resourceId == "X":
        return paint.PaintIconKindX
    if resourceId == "Menu":
        return paint.PaintIconKindMenu
    if resourceId == "Search":
        return paint.PaintIconKindSearch
    if resourceId == "ChevronRight":
        return paint.PaintIconKindChevronRight
    if resourceId == "Plus":
        return paint.PaintIconKindPlus
    if resourceId == "ArrowLeft":
        return paint.PaintIconKindArrowLeft
    return -1

@borrows
fn WebSceneResourceIdHash31(resourceId: str): int32 =
    if resourceId.len == 0:
        return -1
    var hash: uint64 = UInt64(216613626)
    for i in 0..<resourceId.len:
        let ch = UInt64(Int32(resourceId[i]) & 255)
        hash = (hash * UInt64(16777619) + ch) & UInt64(2147483647)
    let out = Int32(hash)
    if out <= 0:
        return 1
    return out

fn WebSceneFindNodeRouteIndex(graph: var WebSceneGraph, nodeId: int32): int32 =
    if nodeId <= 0 || nodeId >= graph.nodeRouteById.len:
        return -1
    return graph.nodeRouteById[nodeId]
    return -1

fn WebSceneBuildRoutePaintCommandsScoped(graph: var WebSceneGraph, routeIndex: int32, layerId: int32, subtreeRootNodeId: int32, buffer: var WebScenePaintCommandBuffer, skipRangeIndexRebuild: bool = false): bool =
    WebScenePaintCommandBufferInit(buffer)
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if layerId > 0 && WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return false
    if subtreeRootNodeId > 0 && !WebSceneNodeBelongsToRoute(graph, routeIndex, subtreeRootNodeId):
        return false
    if !skipRangeIndexRebuild:
        # Range indexes are a pure function of graph.paintOps/paintShadows/
        # paintGradients + nodeIndexById; callers that already rebuilt them
        # for this exact graph state (e.g. one dirty-span batch fanning out
        # to several layers, see WebSceneInvalidateLayerCachesForDirtySpans)
        # pass skipRangeIndexRebuild=true instead of redoing this graph-wide
        # O(paintOps+paintShadows+paintGradients+nodes) rebuild per layer.
        if !WebSceneRebuildPaintCommandRangeIndexes(graph):
            return false
    buffer.routeIndex = routeIndex
    buffer.layerId = layerId
    var nodeOrder: int32[]
    if !WebSceneBuildRoutePaintNodeOrder(graph, routeIndex, nodeOrder):
        return false
    for i in 0..<nodeOrder.len:
        if !WebSceneAppendNodePaintCommands(graph,
                                            routeIndex,
                                            layerId,
                                            subtreeRootNodeId,
                                            nodeOrder[i],
                                            buffer.ops):
            return false
    return true
