# production_held_exec_spawn.cheng - typed production held-exec boundary.
#
# This module is intentionally free of raw pointers and FFI. The runtime
# provider owns execveat, argv/env construction, the inherited one-shot
# channel, pidfd lifetime and wait-status validation. Cheng callers receive
# only exact content identities and a terminal result.

import std/strings
import std/system
import cheng/std/bytes_layout as layout

const
    CsgCoreProductionHeldExecSpawnLinuxX64: str = "linux-x86_64"
    CsgCoreProductionHeldExecSpawnUnavailableHardRed: str =
        "HARD_RED:production_held_exec_linux_spawn_unavailable"

type
    CsgCoreProductionHeldExecClaimResult =
        session: int32 = -1
        childPid: int32 = -1
        childUid: uint32
        childGid: uint32
        claimReceiptCid: str

    CsgCoreProductionHeldExecSpawnResult =
        childProcessIdentityCid: str
        terminalReceiptCid: str
        observedOutputCid: str
        outputBytes: uint64
        exitCode: int32

fn csgCoreProductionHeldExecDigestCid(
        digest0: uint64,
        digest1: uint64,
        digest2: uint64,
        digest3: uint64): str =
    if digest0 == uint64(0) && digest1 == uint64(0) &&
       digest2 == uint64(0) && digest3 == uint64(0):
        return ""
    var digest: layout.FixedBytes32
    for byteIndex in 0..<32:
        let limbIndex = byteIndex / 8
        var limb = digest0
        if limbIndex == 1:
            limb = digest1
        elif limbIndex == 2:
            limb = digest2
        elif limbIndex == 3:
            limb = digest3
        digest.data[byteIndex] = uint8(
            (limb >> uint64((byteIndex % 8) * 8)) & uint64(255))
    return "sha256:" + layout.FixedBytes32Hex(digest)

fn csgCoreProductionHeldExecParentError(errorCode: int32): str =
    if errorCode == system.RuntimeHeldExecParentErrLinuxX64Required:
        return "held_exec_parent_linux_x86_64_required"
    if errorCode == system.RuntimeHeldExecParentErrTicketMaterialInvalid:
        return "held_exec_parent_ticket_material_invalid"
    if errorCode == system.RuntimeHeldExecParentErrSocketpairFailed:
        return "held_exec_parent_socketpair_failed"
    if errorCode == system.RuntimeHeldExecParentErrTicketSendFailed:
        return "held_exec_parent_ticket_send_failed"
    if errorCode == system.RuntimeHeldExecParentErrArgvBuildFailed:
        return "held_exec_parent_argv_build_failed"
    if errorCode == system.RuntimeHeldExecParentErrRetainedFdAlias:
        return "held_exec_parent_retained_fd_alias"
    if errorCode == system.RuntimeHeldExecParentErrForkFailed:
        return "held_exec_parent_fork_failed"
    if errorCode == system.RuntimeHeldExecParentErrPidfdOpenFailed:
        return "held_exec_parent_pidfd_open_failed"
    if errorCode == system.RuntimeHeldExecParentErrClaimInvalid:
        return "held_exec_parent_claim_invalid"
    if errorCode == system.RuntimeHeldExecParentErrAdmissionAckFailed:
        return "held_exec_parent_admission_ack_failed"
    if errorCode == system.RuntimeHeldExecParentErrPlanInvalid:
        return "held_exec_parent_plan_invalid"
    if errorCode == system.RuntimeHeldExecParentErrPlanReceiptInvalid:
        return "held_exec_parent_plan_receipt_invalid"
    if errorCode == system.RuntimeHeldExecParentErrPlanAckFailed:
        return "held_exec_parent_plan_ack_failed"
    if errorCode == system.RuntimeHeldExecParentErrTerminalMissing:
        return "held_exec_parent_terminal_missing"
    if errorCode == system.RuntimeHeldExecParentErrTerminalInvalid:
        return "held_exec_parent_terminal_invalid"
    if errorCode == system.RuntimeHeldExecParentErrReceiptProjectionFailed:
        return "held_exec_parent_receipt_projection_failed"
    if errorCode == system.RuntimeHeldExecParentErrBundleUnavailable:
        return "held_exec_parent_bundle_unavailable"
    if errorCode == system.RuntimeHeldExecParentErrChildExitNonzero:
        return "held_exec_parent_child_exit_nonzero"
    if errorCode == system.RuntimeHeldExecParentErrRetainedVerityInvalid:
        return "held_exec_parent_retained_verity_invalid"
    if errorCode == system.RuntimeHeldExecParentErrLauncherIdentityInvalid:
        return "held_exec_parent_launcher_identity_invalid"
    if errorCode == system.RuntimeHeldExecParentErrOutputPathNotAbsolute:
        return "held_exec_parent_output_path_not_absolute"
    if errorCode == system.RuntimeHeldExecParentErrOutputPathDigestInvalid:
        return "held_exec_parent_output_path_digest_invalid"
    if errorCode == system.RuntimeHeldExecParentErrArgvDigestInvalid:
        return "held_exec_parent_argv_digest_invalid"
    if errorCode == system.RuntimeHeldExecParentErrEnvironmentDigestInvalid:
        return "held_exec_parent_environment_digest_invalid"
    if errorCode == system.RuntimeHeldExecParentErrEntropyFailed:
        return "held_exec_parent_entropy_failed"
    if errorCode == system.RuntimeHeldExecParentErrNonceInvalid:
        return "held_exec_parent_nonce_invalid"
    if errorCode == system.RuntimeHeldExecParentErrSessionUnavailable:
        return "held_exec_parent_session_unavailable"
    if errorCode == system.RuntimeHeldExecParentErrSessionState:
        return "held_exec_parent_session_state"
    if errorCode == system.RuntimeHeldExecParentErrOwnerClaimInvalid:
        return "held_exec_parent_owner_claim_invalid"
    if errorCode == system.RuntimeHeldExecParentErrDecisionSendFailed:
        return "held_exec_parent_decision_send_failed"
    return CsgCoreProductionHeldExecSpawnUnavailableHardRed

@borrows
fn CsgCoreProductionHeldExecBeginClaimInto(
        retainedBinaryFd: int32,
        outputPath: str,
        out: var CsgCoreProductionHeldExecClaimResult,
        err: var str): bool =
    out = CsgCoreProductionHeldExecClaimResult()
    let runtimeResult = system.RuntimeHeldExecParentBeginClaim(
        retainedBinaryFd, outputPath)
    if runtimeResult.status != 1:
        err = strings.CloneStr(
            csgCoreProductionHeldExecParentError(
                runtimeResult.errorCode))
        return false
    let claimReceiptCid = csgCoreProductionHeldExecDigestCid(
        runtimeResult.claimReceipt0,
        runtimeResult.claimReceipt1,
        runtimeResult.claimReceipt2,
        runtimeResult.claimReceipt3)
    if runtimeResult.session <= 0 || runtimeResult.childPid <= 0 ||
       claimReceiptCid.len != 71:
        err = "production_held_exec_spawn_e_claim_projection_invalid"
        return false
    out.session = runtimeResult.session
    out.childPid = runtimeResult.childPid
    out.childUid = runtimeResult.childUid
    out.childGid = runtimeResult.childGid
    out.claimReceiptCid = strings.CloneStr(claimReceiptCid)
    err = ""
    return true

fn CsgCoreProductionHeldExecAbortUnresolvedInto(
        session: int32,
        err: var str): bool =
    let runtimeResult = system.RuntimeHeldExecParentAbortUnresolved(session)
    if runtimeResult.status != 1:
        err = strings.CloneStr(
            csgCoreProductionHeldExecParentError(
                runtimeResult.errorCode))
        return false
    err = ""
    return true

# Compatibility symbol for old callers. It cannot issue authority because it
# lacks the child terminal receipt by construction.
fn CsgCoreProductionHeldExecLinuxSpawnAndObserveInto(
        retainedBinaryFd: int32,
        outChildProcessIdentityCid: var str,
        err: var str): bool =
    let _retainedBinaryFd = retainedBinaryFd
    outChildProcessIdentityCid = ""
    err = strings.CloneStr(
        CsgCoreProductionHeldExecSpawnUnavailableHardRed)
    return false
