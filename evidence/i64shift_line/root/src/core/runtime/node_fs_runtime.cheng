# node_fs_runtime.cheng
# Node.js Buffer and filesystem runtime for Cheng Web runtime.
# Provides: NodeBuffer type, file read/write FFI stubs

import std/seqs
import std/strings

# ============================================================
# String conversion helpers (FFI bridges to C runtime exports)
# ============================================================

@importc("cheng_str_to_cstring_temp_bridge")
fn cheng_str_to_cstring_native(text: str): ptr

@importc("cheng_cstrlen")
fn cheng_cstrlen_native(s: ptr): int32

@importc("driver_c_str_from_utf8_copy_bridge")
fn cheng_str_from_utf8_native(raw: ptr, count: int32): str

# ============================================================
# 1. NodeBuffer type (pure Cheng)
# ============================================================

type NodeBuffer =
    data: int32[]
    length: int32
    offset: int32

# Allocate a buffer of given size
fn NodeBufferAlloc(size: int32): NodeBuffer =
    var buf: NodeBuffer
    buf.length = size
    buf.offset = 0
    if size > 0:
        setLen(buf.data, size)
    return buf

# Create buffer from int32 array
fn NodeBufferFrom(data: int32[]): NodeBuffer =
    var buf: NodeBuffer
    buf.data = data
    buf.length = len(data)
    buf.offset = 0
    return buf

# Create buffer from string bytes
fn NodeBufferFromString(s: str): NodeBuffer =
    let n: int32 = len(s)
    var data: int32[]
    if n > 0:
        setLen(data, n)
        var i: int32
        while i < n:
            data[i] = int32(s[i])
            i += 1
    return NodeBufferFrom(data)

# Convert buffer to string
fn NodeBufferToString(buf: var NodeBuffer): str =
    if buf.length == 0:
        return ""
    var result: str
    var i: int32
    while i < buf.length:
        let byteVal: int32 = buf.data[buf.offset + i]
        result = Fmt"{result}{strings.CharToStr(char(byteVal))}"
        i += 1
    return result

# Get byte at index
fn NodeBufferGet(buf: var NodeBuffer, index: int32): int32 =
    if index < 0 || index >= buf.length:
        return 0
    return buf.data[buf.offset + index]

# Set byte at index
fn NodeBufferSet(buf: var NodeBuffer, index: int32, value: int32) =
    if index >= 0 && index < buf.length:
        buf.data[buf.offset + index] = value

# ============================================================
# 2. FileSystem APIs (FFI stubs)
# ============================================================

@importc("cheng_fs_read_file")
fn cheng_fs_read_file_native(path: ptr): ptr

fn nodeFsReadFile(path: str): str =
    let cpath: ptr = cheng_str_to_cstring_native(path)
    let result: ptr = cheng_fs_read_file_native(cpath)
    if result == nil:
        return ""
    let count: int32 = cheng_cstrlen_native(result)
    return cheng_str_from_utf8_native(result, count)

@importc("cheng_fs_write_file")
fn cheng_fs_write_file_native(path: ptr, data: ptr): int32

fn nodeFsWriteFile(path: str, data: str): bool =
    let cpath: ptr = cheng_str_to_cstring_native(path)
    let cdata: ptr = cheng_str_to_cstring_native(data)
    return cheng_fs_write_file_native(cpath, cdata) == 0

# ============================================================
# 3. Crypto/third-party stubs
# ============================================================

# bip39.mnemonicToSeed stub: returns 64-byte empty seed
# Real BIP39 would do PBKDF2-SHA512; app needs native implementation for production
fn NodeBip39MnemonicToSeed(mnemonic: str): NodeBuffer =
    return NodeBufferAlloc(64)

# ethers.Wallet stub: returns a wallet handle ID
fn NodeEthersWalletCreate(privateKey: str): int32 =
    return 1

# bitcoin.payments.p2pkh stub: returns a payment object handle
fn NodeBitcoinPaymentsP2pkh(): int32 =
    return 1  # payment object handle

# bitcoin.payments.p2pkh.payment.data stub
fn NodeBitcoinPaymentData(paymentId: int32): NodeBuffer =
    var buf: NodeBuffer
    NodeBufferAlloc(32, buf)
    return buf

# ECPair.fromPrivateKey stub: returns key pair handle
fn NodeECPairFromPrivateKey(privateKey: NodeBuffer): int32 =
    return 1  # key pair handle

# ethers.formatEther(value): format wei (18 decimals) to ether string
# e.g. "1000000000000000000" -> "1.0"
# e.g. "1234567890123456789" -> "1.234567890123456789"
# e.g. "0" -> "0.0"
# e.g. "-1000000000000000000" -> "-1.0"
fn NodeEthersFormatEther(value: str): str =
    let n: int32 = len(value)
    if n == 0: return "0.0"

    # Handle sign
    var signOff: int32
    if n > 0 && value[0] == '-':
        signOff = 1

    # Strip leading zeros
    var firstDigit: int32 = signOff
    while firstDigit < n && value[firstDigit] == '0':
        firstDigit = firstDigit + 1

    # All zeros
    if firstDigit >= n:
        if signOff > 0: return "-0.0"
        return "0.0"

    let digits: int32 = n - firstDigit

    # Build result with sign
    var result: str
    if signOff > 0: result = "-"

    if digits <= 18:
        # Whole part is 0
        result = Fmt"{result}0."
        # Pad leading zeros in decimal part
        var pad: int32 = 18 - digits
        var j: int32
        while j < pad:
            result = Fmt"{result}0"
            j = j + 1
        # Append decimal digits, trimming trailing zeros
        var lastNonZero: int32 = n - 1
        while lastNonZero >= firstDigit && value[lastNonZero] == '0':
            lastNonZero = lastNonZero - 1
        if lastNonZero < firstDigit:
            result = Fmt"{result}0"
        else:
            var i: int32 = firstDigit
            while i <= lastNonZero:
                result = Fmt"{result}{strings.SliceBytes(value, i, 1)}"
                i = i + 1
    else:
        # More than 18 digits: has non-zero whole part
        let wholeLen: int32 = digits - 18
        var wholeEnd: int32 = firstDigit + wholeLen
        var i: int32 = firstDigit
        while i < wholeEnd:
            result = Fmt"{result}{strings.SliceBytes(value, i, 1)}"
            i = i + 1
        result = Fmt"{result}."
        # Append decimal digits, trimming trailing zeros
        var lastNonZero: int32 = n - 1
        while lastNonZero >= i && value[lastNonZero] == '0':
            lastNonZero = lastNonZero - 1
        if lastNonZero < i:
            result = Fmt"{result}0"
        else:
            var j: int32 = i
            while j <= lastNonZero:
                result = Fmt"{result}{strings.SliceBytes(value, j, 1)}"
                j = j + 1

    return result


# ============================================================
# 4. fs.mkdir (FFI stub)
# ============================================================

@importc("cheng_fs_mkdir")
fn cheng_fs_mkdir_native(path: ptr, mode: int32): int32

fn nodeFsMkdir(path: str, mode: int32): bool =
    let cpath = cheng_str_to_cstring_native(path)
    return cheng_fs_mkdir_native(cpath, mode) == 0

# ethers.formatUnits(value, decimals): format token units with variable decimals
# e.g. formatUnits("1000000000000000000", 18) -> "1.0"
# e.g. formatUnits("12345", 2) -> "123.45"
# e.g. formatUnits("0", 18) -> "0.0"
# Decimals clamped to [0, 256]
fn NodeEthersFormatUnits(value: str, decimals: int32): str =
    let n: int32 = len(value)
    if n == 0: return "0.0"

    # Clamp decimals to valid range
    var dec: int32 = decimals
    if dec < 0: dec = 0
    if dec > 256: dec = 256

    # Handle sign
    var signOff: int32
    if n > 0 && value[0] == '-':
        signOff = 1

    # Strip leading zeros
    var firstDigit: int32 = signOff
    while firstDigit < n && value[firstDigit] == '0':
        firstDigit = firstDigit + 1

    # All zeros
    if firstDigit >= n:
        if signOff > 0: return "-0.0"
        return "0.0"

    let digits: int32 = n - firstDigit

    # Build result with sign
    var result: str
    if signOff > 0: result = "-"

    if digits <= dec:
        # Whole part is 0
        result = Fmt"{result}0."
        # Pad leading zeros in decimal part
        var pad: int32 = dec - digits
        var j: int32
        while j < pad:
            result = Fmt"{result}0"
            j = j + 1
        # Append decimal digits, trimming trailing zeros
        var lastNonZero: int32 = n - 1
        while lastNonZero >= firstDigit && value[lastNonZero] == '0':
            lastNonZero = lastNonZero - 1
        if lastNonZero < firstDigit:
            result = Fmt"{result}0"
        else:
            var i: int32 = firstDigit
            while i <= lastNonZero:
                result = Fmt"{result}{strings.SliceBytes(value, i, 1)}"
                i = i + 1
    else:
        # More than dec digits: has non-zero whole part
        let wholeLen: int32 = digits - dec
        var wholeEnd: int32 = firstDigit + wholeLen
        var i: int32 = firstDigit
        while i < wholeEnd:
            result = Fmt"{result}{strings.SliceBytes(value, i, 1)}"
            i = i + 1
        result = Fmt"{result}."
        # Append decimal digits, trimming trailing zeros
        var lastNonZero: int32 = n - 1
        while lastNonZero >= i && value[lastNonZero] == '0':
            lastNonZero = lastNonZero - 1
        if lastNonZero < i:
            result = Fmt"{result}0"
        else:
            var j: int32 = i
            while j <= lastNonZero:
                result = Fmt"{result}{strings.SliceBytes(value, j, 1)}"
                j = j + 1

    return result
