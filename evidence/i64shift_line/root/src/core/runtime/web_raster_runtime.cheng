                                          faceCount: int32,
                                          weight0: int32,
                                          weight1: int32,
                                          weight2: int32,
                                          weight3: int32): bool =
    return RasterPaintOpsWithFontCascade4WeightedFamily(surface, ops, face0, face1, face2, face3, faceCount,
        weight0, weight1, weight2, weight3, 0, 0, 0, 0)

