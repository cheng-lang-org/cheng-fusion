                bestScore = candidateScore7
                bestWeight = candidateWeight7
                bestFaceIndex = 7
                bestGlyphIndex = glyph7
    if bestFaceIndex < 0:
        return false
    outFaceIndex = bestFaceIndex
    outGlyphIndex = bestGlyphIndex
    return true

fn RasterFontCascadeSelectWeightedFamily8(face0: var font.WebFontFace,
                                          face1: var font.WebFontFace,
                                          face2: var font.WebFontFace,
                                          face3: var font.WebFontFace,
                                          face4: var font.WebFontFace,
                                          face5: var font.WebFontFace,
                                          face6: var font.WebFontFace,
                                          face7: var font.WebFontFace,
                                          faceCount: int32,
                                          codepoint: int32,
                                          weight0: int32,
                                          weight1: int32,
                                          weight2: int32,
                                          weight3: int32,
                                          weight4: int32,
                                          weight5: int32,
                                          weight6: int32,
                                          weight7: int32,
                                          family0: int32,
                                          family1: int32,
                                          family2: int32,
                                          family3: int32,
                                          family4: int32,
                                          family5: int32,
                                          family6: int32,
                                          family7: int32,
                                          requestedWeight: int32,
                                          requestedFamily: int32,
                                          outFaceIndex: var int32,
                                          outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if RasterNormalizeFontFamily(requestedFamily) != 1:
        return RasterFontCascadeSelectWeighted8(face0, face1, face2, face3, face4, face5, face6, face7, faceCount, codepoint,
            weight0, weight1, weight2, weight3, weight4, weight5, weight6, weight7, requestedWeight, outFaceIndex, outGlyphIndex)
    let targetWeight = RasterNormalizeFontWeight(requestedWeight)
    var bestScore = 2147483647
    var bestWeight = 400
    var bestFaceIndex = -1
    var bestGlyphIndex = 0
    if faceCount >= 1 && RasterNormalizeFontFamily(family0) == 1:
        let glyph0 = font.WebFontGlyphIndexForCodepoint(face0, codepoint)
        if glyph0 > 0:
            let candidateWeight0 = RasterNormalizeFontWeight(weight0)
            let candidateScore0 = RasterAbsInt32(candidateWeight0 - targetWeight)
            bestScore = candidateScore0
            bestWeight = candidateWeight0
            bestFaceIndex = 0
            bestGlyphIndex = glyph0
    if faceCount >= 2 && RasterNormalizeFontFamily(family1) == 1:
        let glyph1 = font.WebFontGlyphIndexForCodepoint(face1, codepoint)
        if glyph1 > 0:
            let candidateWeight1 = RasterNormalizeFontWeight(weight1)
            let candidateScore1 = RasterAbsInt32(candidateWeight1 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore1, candidateWeight1, targetWeight):
                bestScore = candidateScore1
                bestWeight = candidateWeight1
                bestFaceIndex = 1
                bestGlyphIndex = glyph1
    if faceCount >= 3 && RasterNormalizeFontFamily(family2) == 1:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(face2, codepoint)
        if glyph2 > 0:
            let candidateWeight2 = RasterNormalizeFontWeight(weight2)
            let candidateScore2 = RasterAbsInt32(candidateWeight2 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore2, candidateWeight2, targetWeight):
                bestScore = candidateScore2
                bestWeight = candidateWeight2
                bestFaceIndex = 2
                bestGlyphIndex = glyph2
    if faceCount >= 4 && RasterNormalizeFontFamily(family3) == 1:
        let glyph3 = font.WebFontGlyphIndexForCodepoint(face3, codepoint)
        if glyph3 > 0:
            let candidateWeight3 = RasterNormalizeFontWeight(weight3)
            let candidateScore3 = RasterAbsInt32(candidateWeight3 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore3, candidateWeight3, targetWeight):
                bestScore = candidateScore3
                bestWeight = candidateWeight3
                bestFaceIndex = 3
                bestGlyphIndex = glyph3
    if faceCount >= 5 && RasterNormalizeFontFamily(family4) == 1:
        let glyph4 = font.WebFontGlyphIndexForCodepoint(face4, codepoint)
        if glyph4 > 0:
            let candidateWeight4 = RasterNormalizeFontWeight(weight4)
            let candidateScore4 = RasterAbsInt32(candidateWeight4 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore4, candidateWeight4, targetWeight):
                bestScore = candidateScore4
                bestWeight = candidateWeight4
                bestFaceIndex = 4
                bestGlyphIndex = glyph4
    if faceCount >= 6 && RasterNormalizeFontFamily(family5) == 1:
        let glyph5 = font.WebFontGlyphIndexForCodepoint(face5, codepoint)
        if glyph5 > 0:
            let candidateWeight5 = RasterNormalizeFontWeight(weight5)
            let candidateScore5 = RasterAbsInt32(candidateWeight5 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore5, candidateWeight5, targetWeight):
                bestScore = candidateScore5
                bestWeight = candidateWeight5
                bestFaceIndex = 5
                bestGlyphIndex = glyph5
    if faceCount >= 7 && RasterNormalizeFontFamily(family6) == 1:
        let glyph6 = font.WebFontGlyphIndexForCodepoint(face6, codepoint)
        if glyph6 > 0:
            let candidateWeight6 = RasterNormalizeFontWeight(weight6)
            let candidateScore6 = RasterAbsInt32(candidateWeight6 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore6, candidateWeight6, targetWeight):
                bestScore = candidateScore6
                bestWeight = candidateWeight6
                bestFaceIndex = 6
                bestGlyphIndex = glyph6
    if faceCount >= 8 && RasterNormalizeFontFamily(family7) == 1:
        let glyph7 = font.WebFontGlyphIndexForCodepoint(face7, codepoint)
        if glyph7 > 0:
            let candidateWeight7 = RasterNormalizeFontWeight(weight7)
            let candidateScore7 = RasterAbsInt32(candidateWeight7 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore7, candidateWeight7, targetWeight):
                bestScore = candidateScore7
                bestWeight = candidateWeight7
                bestFaceIndex = 7
                bestGlyphIndex = glyph7
    if bestFaceIndex >= 0:
        outFaceIndex = bestFaceIndex
        outGlyphIndex = bestGlyphIndex
        return true
    return RasterFontCascadeSelectWeighted8(face0, face1, face2, face3, face4, face5, face6, face7, faceCount, codepoint,
        weight0, weight1, weight2, weight3, weight4, weight5, weight6, weight7, requestedWeight, outFaceIndex, outGlyphIndex)

fn RasterFontCascadeUnitsPerEm8(face0: var font.WebFontFace,
                                face1: var font.WebFontFace,
                                face2: var font.WebFontFace,
                                face3: var font.WebFontFace,
                                face4: var font.WebFontFace,
                                face5: var font.WebFontFace,
                                face6: var font.WebFontFace,
                                face7: var font.WebFontFace,
                                faceIndex: int32): int32 =
    if faceIndex == 0:
        return face0.unitsPerEm
    if faceIndex == 1:
        return face1.unitsPerEm
    if faceIndex == 2:
        return face2.unitsPerEm
    if faceIndex == 3:
        return face3.unitsPerEm
    if faceIndex == 4:
        return face4.unitsPerEm
    if faceIndex == 5:
        return face5.unitsPerEm
    if faceIndex == 6:
        return face6.unitsPerEm
    if faceIndex == 7:
        return face7.unitsPerEm
    return 0

