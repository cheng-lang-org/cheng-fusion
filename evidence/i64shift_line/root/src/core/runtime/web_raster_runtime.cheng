import std/strutils as strutil
import cheng/core/runtime/web_font_runtime as font
import cheng/core/runtime/web_paint_runtime as paint

type
    WebRasterSurface =
        width: int32
        height: int32
        pixels: int32[]

fn WebRasterSurfaceInit(surface: var WebRasterSurface) =
    surface.width = 0
    surface.height = 0
    surface.pixels = []

fn WebRasterMax(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

fn WebRasterMin(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

fn WebRasterComposeSrcOver(dst: int32, src: int32): int32 =
    let srcA = (src >> 24) & 0xFF
    if srcA >= 255:
        return src
    if srcA <= 0:
        return dst
    let dstA = (dst >> 24) & 0xFF
    let invA = 255 - srcA
    let dstPartA = (dstA * invA + 127) / 255
    let outA = srcA + dstPartA
    if outA <= 0:
        return 0
    let srcR = (src >> 16) & 0xFF
    let srcG = (src >> 8) & 0xFF
    let srcB = src & 0xFF
    let dstR = (dst >> 16) & 0xFF
    let dstG = (dst >> 8) & 0xFF
    let dstB = dst & 0xFF
    let outR = (srcR * srcA + dstR * dstPartA + outA / 2) / outA
    let outG = (srcG * srcA + dstG * dstPartA + outA / 2) / outA
    let outB = (srcB * srcA + dstB * dstPartA + outA / 2) / outA
    return (outA << 24) | (outR << 16) | (outG << 8) | outB

fn RasterColorWithCoverageAlpha(color: int32, coverage: int32, coverageMax: int32): int32 =
    if coverage <= 0 || coverageMax <= 0:
        return color & 0x00FFFFFF
    if coverage >= coverageMax:
        return color
    let alpha = (color >> 24) & 0xFF
    let scaledAlpha = (alpha * coverage + coverageMax / 2) / coverageMax
    return (scaledAlpha << 24) | (color & 0x00FFFFFF)

fn WebRasterSurfaceWritePixel(surface: var WebRasterSurface, index: int32, color: int32) =
    let alpha = (color >> 24) & 0xFF
    if alpha == 0:
        surface.pixels[index] = color
        return
    if alpha >= 255:
        surface.pixels[index] = color
        return
    surface.pixels[index] = WebRasterComposeSrcOver(surface.pixels[index], color)

fn WebRasterPixelBufferWritePixel(pixels: var int32[], index: int32, color: int32) =
    let alpha = (color >> 24) & 0xFF
    if alpha == 0:
        pixels[index] = color
        return
    if alpha >= 255:
        pixels[index] = color
        return
    pixels[index] = WebRasterComposeSrcOver(pixels[index], color)

fn WebRasterSurfacePixelCount(width: int32, height: int32, outCount: var int32): bool =
    outCount = 0
    if width <= 0 || height <= 0:
        return false
    outCount = width * height
    return true

fn WebRasterClearSurface(surface: var WebRasterSurface, width: int32, height: int32, clearColor: int32): bool =
    var pixelCount = 0
    if !WebRasterSurfacePixelCount(width, height, pixelCount):
        return false
    surface.width = width
    surface.height = height
    surface.pixels = []
    for i in 0..<pixelCount:
        add(surface.pixels, clearColor)
    if surface.pixels.len != pixelCount:
        return false
    return true

fn WebRasterRasterizeDisplayList(list: var paint.WebPaintDisplayList,
                                 width: int32,
                                 height: int32,
                                 clearColor: int32,
                                 surface: var WebRasterSurface): bool =
    var pixelCount = 0
    if !WebRasterSurfacePixelCount(width, height, pixelCount):
        return false
    let itemCount = list.items.len
    var pixels: int32[]
    for pixelIndex in 0..<pixelCount:
        add(pixels, clearColor)
    if pixels.len != pixelCount:
        return false

    for itemIndex in 0..<itemCount:
        if list.items[itemIndex].width < 0 || list.items[itemIndex].height < 0:
            return false

        let itemRight = list.items[itemIndex].x + list.items[itemIndex].width
        let itemBottom = list.items[itemIndex].y + list.items[itemIndex].height
        if itemRight <= list.items[itemIndex].x || itemBottom <= list.items[itemIndex].y:
            continue

        let clippedX = WebRasterMax(list.items[itemIndex].x, 0)
        let clippedY = WebRasterMax(list.items[itemIndex].y, 0)
        let clippedRight = WebRasterMin(itemRight, width)
        let clippedBottom = WebRasterMin(itemBottom, height)
        if clippedRight <= clippedX || clippedBottom <= clippedY:
            continue

        for y in clippedY..<clippedBottom:
            let rowOffset = y * width
            for x in clippedX..<clippedRight:
                let writeIndex = rowOffset + x
                let writeColor = list.items[itemIndex].fillColor
                let writeAlpha = (writeColor >> 24) & 0xFF
                if writeAlpha == 0:
                    pixels[writeIndex] = writeColor
                elif writeAlpha >= 255:
                    pixels[writeIndex] = writeColor
                else:
                    pixels[writeIndex] = WebRasterComposeSrcOver(pixels[writeIndex], writeColor)
    surface.width = width
    surface.height = height
    surface.pixels = pixels
    return true

fn WebRasterPixelAt(surface: var WebRasterSurface, x: int32, y: int32): int32 =
    if surface.width <= 0 || surface.height <= 0:
        return 0
    if x < 0 || y < 0 || x >= surface.width || y >= surface.height:
        return 0
    let index = y * surface.width + x
    if index < 0 || index >= surface.pixels.len:
        return 0
    return surface.pixels[index]

# ──────────────────────────────────────────────
# Extended Raster API — PaintOp-based pipeline
# ──────────────────────────────────────────────

type
    RasterGlyphMaskEntry =
        fontKey: int32
        glyphIndex: int32
        fontSizePx: int32
        unitsPerEm: int32
        originParityX: int32
        baselineParityY: int32
        offsetX: int32
        offsetY: int32
        width: int32
        height: int32
        coverageStart: int32
        coverageCount: int32
        nextIndex: int32

    RasterGlyphAtlas =
        entries: RasterGlyphMaskEntry[]
        coverages: int32[]
        bucketHeads: int32[]
        hits: int32
        misses: int32

    RasterSurface =
        width: int32
        height: int32
        pixelBuffer: int32[]
        platformSurface: uint64
        imageCache: RasterImageCache
        lastError: str

var __rasterGlyphAtlasEntries: RasterGlyphMaskEntry[]
var __rasterGlyphAtlasCoverages: int32[]
var __rasterGlyphAtlasBucketHeads: int32[]
var __rasterGlyphAtlasHits: int32
var __rasterGlyphAtlasMisses: int32

fn RasterGlyphAtlasInit(atlas: var RasterGlyphAtlas) =
    atlas.entries = []
    atlas.coverages = []
    atlas.bucketHeads = []
    atlas.hits = 0
    atlas.misses = 0

fn RasterSurfaceInit(surface: var RasterSurface) =
    surface.width = 0
    surface.height = 0
    surface.pixelBuffer = []
    surface.platformSurface = uint64(0)
    RasterImageCacheInit(surface.imageCache)
    surface.lastError = ""

fn RasterClearError(surface: var RasterSurface) =
    surface.lastError = ""

fn RasterSurfaceWritePixel(surface: var RasterSurface, index: int32, color: int32) =
    let alpha = (color >> 24) & 0xFF
    if alpha == 0:
        surface.pixelBuffer[index] = color
        return
    if alpha >= 255:
        surface.pixelBuffer[index] = color
        return
    surface.pixelBuffer[index] = WebRasterComposeSrcOver(surface.pixelBuffer[index], color)

fn RasterFail(surface: var RasterSurface, message: str): bool =
    surface.lastError = message
    return false

@borrows
@borrow_result
fn RasterLastError(surface: var RasterSurface): str =
    return surface.lastError

fn RasterGlyphAtlasEntryCount(surface: var RasterSurface): int32 =
    return __rasterGlyphAtlasEntries.len

fn RasterGlyphAtlasHitCount(surface: var RasterSurface): int32 =
    return __rasterGlyphAtlasHits

fn RasterGlyphAtlasMissCount(surface: var RasterSurface): int32 =
    return __rasterGlyphAtlasMisses

fn RasterClear(surface: var RasterSurface, clearColor: int32): bool =
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    RasterClearError(surface)
    let pixelCount = surface.width * surface.height
    surface.pixelBuffer = []
    for i in 0..<pixelCount:
        add(surface.pixelBuffer, clearColor)
    if surface.pixelBuffer.len != pixelCount:
        return RasterFail(surface, "raster clear pixel count mismatch")
    return true

fn RasterResize(surface: var RasterSurface, width: int32, height: int32, clearColor: int32): bool =
    if width <= 0 || height <= 0:
        return RasterFail(surface, "invalid raster resize size")
    surface.width = width
    surface.height = height
    return RasterClear(surface, clearColor)

fn RasterSetPixel(surface: var RasterSurface, x: int32, y: int32, color: int32): bool =
    if x < 0 || y < 0 || x >= surface.width || y >= surface.height:
        return RasterFail(surface, "raster set pixel out of bounds")
    let index = y * surface.width + x
    if index < 0 || index >= surface.pixelBuffer.len:
        return RasterFail(surface, "raster set pixel buffer index out of bounds")
    surface.pixelBuffer[index] = color
    return true

# ──────────────────────────────────────
# Screenshot dump — raw RGBA pixel output for oracle comparison
# ──────────────────────────────────────

fn WebRasterDumpPixels(surface: var RasterSurface): bool =
    if surface.width <= 0 || surface.height <= 0:
        return false
    let w = surface.width
    let h = surface.height
    for y in 0..<h:
        var parts: str[]
        add(parts, "row: ")
        for x in 0..<w:
            if x > 0:
                add(parts, ",")
            let packed = surface.pixelBuffer[y * w + x]
            let a = (packed >> 24) & 0xFF
            let r = (packed >> 16) & 0xFF
            let g = (packed >> 8) & 0xFF
            let b = packed & 0xFF
            add(parts, Fmt"{r},{g},{b},{a}")
        echo(strutil.Join(parts, ""))
    return true


fn WebRasterDumpSummary(surface: var RasterSurface): bool =
    if surface.width <= 0 || surface.height <= 0:
        return false
    let count = surface.pixelBuffer.len
    var first = 0
    var center = 0
    var last = 0
    if count > 0:
        first = surface.pixelBuffer[0]
        center = surface.pixelBuffer[count / 2]
        last = surface.pixelBuffer[count - 1]
    # Scan for the first pixel that differs from the clear color (0xFFFFFFFF).
    # This detects any rendered content (fill rects, text, icons).
    # The first/center/last fields are misleading because full-page white fills
    # cover those positions on pages with white backgrounds (e.g., bg-white components).
    var renderedIdx = -1
    var renderedVal = 0
    var clearVal = int32(0xFFFFFFFF)
    for ci in 0..<count:
        let pv = surface.pixelBuffer[ci]
        if pv != clearVal:
            renderedIdx = ci
            renderedVal = pv
            break
    echo(Fmt"summary: width={surface.width},height={surface.height},pixels={count},first={first},center={center},last={last},rendered={renderedVal}@idx{renderedIdx}")
    return true

fn RasterPixelAt(surface: var RasterSurface, x: int32, y: int32): int32 =
    if x < 0 || y < 0 || x >= surface.width || y >= surface.height:
        return 0
    let index = y * surface.width + x
    if index < 0 || index >= surface.pixelBuffer.len:
        return 0
    return surface.pixelBuffer[index]

fn RasterFillRectImpl(surface: var RasterSurface, rx: int32, ry: int32, rw: int32, rh: int32, color: int32) =
    if rw <= 0 || rh <= 0:
        return
    let clippedX = WebRasterMax(rx, 0)
    let clippedY = WebRasterMax(ry, 0)
    let clippedRight = WebRasterMin(rx + rw, surface.width)
    let clippedBottom = WebRasterMin(ry + rh, surface.height)
    if clippedX >= clippedRight || clippedY >= clippedBottom:
        return
    for y in clippedY..<clippedBottom:
        let rowOffset = y * surface.width
        for x in clippedX..<clippedRight:
            RasterSurfaceWritePixel(surface, rowOffset + x, color)

fn RasterFillRectClippedImpl(surface: var RasterSurface, rx: int32, ry: int32, rw: int32, rh: int32,
                             clipX: int32, clipY: int32, clipW: int32, clipH: int32,
                             color: int32) =
    if rw <= 0 || rh <= 0 || clipW <= 0 || clipH <= 0:
        return
    let clippedX = WebRasterMax(WebRasterMax(rx, 0), clipX)
    let clippedY = WebRasterMax(WebRasterMax(ry, 0), clipY)
    let clippedRight = WebRasterMin(WebRasterMin(rx + rw, surface.width), clipX + clipW)
    let clippedBottom = WebRasterMin(WebRasterMin(ry + rh, surface.height), clipY + clipH)
    if clippedX >= clippedRight || clippedY >= clippedBottom:
        return
    for y in clippedY..<clippedBottom:
        let rowOffset = y * surface.width
        for x in clippedX..<clippedRight:
            RasterSurfaceWritePixel(surface, rowOffset + x, color)

fn RasterClampRadiusForRect(radius: int32, rw: int32, rh: int32): int32 =
    var r = radius
    if r < 0:
        r = 0
    let maxRadiusW = rw / 2
    let maxRadiusH = rh / 2
    if r > maxRadiusW:
        r = maxRadiusW
    if r > maxRadiusH:
        r = maxRadiusH
    return r

fn RasterRoundedRectContainsPixel4(rx: int32, ry: int32, rw: int32, rh: int32,
                                   topLeftRadius: int32,
                                   topRightRadius: int32,
                                   bottomRightRadius: int32,
                                   bottomLeftRadius: int32,
                                   x: int32, y: int32): bool =
    if rw <= 0 || rh <= 0:
        return false
    if x < rx || y < ry || x >= rx + rw || y >= ry + rh:
        return false
    let tl = RasterClampRadiusForRect(topLeftRadius, rw, rh)
    let tr = RasterClampRadiusForRect(topRightRadius, rw, rh)
    let br = RasterClampRadiusForRect(bottomRightRadius, rw, rh)
    let bl = RasterClampRadiusForRect(bottomLeftRadius, rw, rh)
    if tl > 0 && x < rx + tl && y < ry + tl:
        let cx = rx + tl - 1
        let cy = ry + tl - 1
        let dx = cx - x
        let dy = cy - y
        return dx * dx + dy * dy <= tl * tl
    if tr > 0 && x >= rx + rw - tr && y < ry + tr:
        let cx = rx + rw - tr
        let cy = ry + tr - 1
        let dx = x - cx
        let dy = cy - y
        return dx * dx + dy * dy <= tr * tr
    if br > 0 && x >= rx + rw - br && y >= ry + rh - br:
        let cx = rx + rw - br
        let cy = ry + rh - br
        let dx = x - cx
        let dy = y - cy
        return dx * dx + dy * dy <= br * br
    if bl > 0 && x < rx + bl && y >= ry + rh - bl:
        let cx = rx + bl - 1
        let cy = ry + rh - bl
        let dx = cx - x
        let dy = y - cy
        return dx * dx + dy * dy <= bl * bl
    return true

fn RasterFillRoundedRectCornersClippedImpl(surface: var RasterSurface,
                                           rx: int32, ry: int32, rw: int32, rh: int32,
                                           topLeftRadius: int32,
                                           topRightRadius: int32,
                                           bottomRightRadius: int32,
                                           bottomLeftRadius: int32,
                                           clipX: int32, clipY: int32, clipW: int32, clipH: int32,
                                           color: int32) =
    if rw <= 0 || rh <= 0 || clipW <= 0 || clipH <= 0:
        return
    if topLeftRadius <= 0 && topRightRadius <= 0 && bottomRightRadius <= 0 && bottomLeftRadius <= 0:
        RasterFillRectClippedImpl(surface, rx, ry, rw, rh, clipX, clipY, clipW, clipH, color)
        return
    let tl = RasterClampRadiusForRect(topLeftRadius, rw, rh)
    let tr = RasterClampRadiusForRect(topRightRadius, rw, rh)
    let br = RasterClampRadiusForRect(bottomRightRadius, rw, rh)
    let bl = RasterClampRadiusForRect(bottomLeftRadius, rw, rh)
    if tl <= 0 && tr <= 0 && br <= 0 && bl <= 0:
        RasterFillRectClippedImpl(surface, rx, ry, rw, rh, clipX, clipY, clipW, clipH, color)
        return
    let clippedX = WebRasterMax(WebRasterMax(rx, 0), clipX)
    let clippedY = WebRasterMax(WebRasterMax(ry, 0), clipY)
    let clippedRight = WebRasterMin(WebRasterMin(rx + rw, surface.width), clipX + clipW)
    let clippedBottom = WebRasterMin(WebRasterMin(ry + rh, surface.height), clipY + clipH)
    if clippedX >= clippedRight || clippedY >= clippedBottom:
        return
    for y in clippedY..<clippedBottom:
        let rowOffset = y * surface.width
        for x in clippedX..<clippedRight:
            if RasterRoundedRectContainsPixel4(rx, ry, rw, rh, tl, tr, br, bl, x, y):
                RasterSurfaceWritePixel(surface, rowOffset + x, color)

fn RasterFillRoundedRectClippedImpl(surface: var RasterSurface, rx: int32, ry: int32, rw: int32, rh: int32,
                                    radius: int32,
                                    clipX: int32, clipY: int32, clipW: int32, clipH: int32,
                                    color: int32) =
    RasterFillRoundedRectCornersClippedImpl(surface, rx, ry, rw, rh,
        radius, radius, radius, radius,
        clipX, clipY, clipW, clipH, color)

fn RasterRoundedRectContainsPixel(rx: int32, ry: int32, rw: int32, rh: int32,
                                  radius: int32, x: int32, y: int32): bool =
    if rw <= 0 || rh <= 0:
        return false
    if x < rx || y < ry || x >= rx + rw || y >= ry + rh:
        return false
    var r = radius
    let maxRadiusW = rw / 2
    let maxRadiusH = rh / 2
    if r > maxRadiusW:
        r = maxRadiusW
    if r > maxRadiusH:
        r = maxRadiusH
    if r <= 0:
        return true
    let leftCx = rx + r - 1
    let rightCx = rx + rw - r
    let topCy = ry + r - 1
    let bottomCy = ry + rh - r
    let radiusSq = r * r
    if x < rx + r && y < ry + r:
        let dx = leftCx - x
        let dy = topCy - y
        return dx * dx + dy * dy <= radiusSq
    if x >= rx + rw - r && y < ry + r:
        let dx = x - rightCx
        let dy = topCy - y
        return dx * dx + dy * dy <= radiusSq
    if x < rx + r && y >= ry + rh - r:
        let dx = leftCx - x
        let dy = y - bottomCy
        return dx * dx + dy * dy <= radiusSq
    if x >= rx + rw - r && y >= ry + rh - r:
        let dx = x - rightCx
        let dy = y - bottomCy
        return dx * dx + dy * dy <= radiusSq
    return true

fn RasterBorderInnerRadius(radius: int32,
                           topWidth: int32,
                           rightWidth: int32,
                           bottomWidth: int32,
                           leftWidth: int32): int32 =
    var maxWidth = topWidth
    if rightWidth > maxWidth:
        maxWidth = rightWidth
    if bottomWidth > maxWidth:
        maxWidth = bottomWidth
    if leftWidth > maxWidth:
        maxWidth = leftWidth
    var innerRadius = radius - maxWidth
    if innerRadius < 0:
        innerRadius = 0
    return innerRadius

fn RasterBorderInnerCornerRadius(radius: int32, firstWidth: int32, secondWidth: int32): int32 =
    var maxWidth = firstWidth
    if secondWidth > maxWidth:
        maxWidth = secondWidth
    var innerRadius = radius - maxWidth
    if innerRadius < 0:
        innerRadius = 0
    return innerRadius

fn RasterBorderRectCornersClippedImpl(surface: var RasterSurface,
                                      rx: int32, ry: int32, rw: int32, rh: int32,
                                      color: int32,
                                      topWidth: int32,
                                      rightWidth: int32,
                                      bottomWidth: int32,
                                      leftWidth: int32,
                                      topLeftRadius: int32,
                                      topRightRadius: int32,
                                      bottomRightRadius: int32,
                                      bottomLeftRadius: int32,
                                      clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    if rw <= 0 || rh <= 0:
        return RasterFail(surface, "invalid stroke rect dimensions")
    if topWidth < 0 || rightWidth < 0 || bottomWidth < 0 || leftWidth < 0:
        return RasterFail(surface, "invalid stroke rect border width")
    if topWidth == 0 && rightWidth == 0 && bottomWidth == 0 && leftWidth == 0:
        return true
    if clipW <= 0 || clipH <= 0:
        return true
    let tl = RasterClampRadiusForRect(topLeftRadius, rw, rh)
    let tr = RasterClampRadiusForRect(topRightRadius, rw, rh)
    let br = RasterClampRadiusForRect(bottomRightRadius, rw, rh)
    let bl = RasterClampRadiusForRect(bottomLeftRadius, rw, rh)
    let clippedX = WebRasterMax(WebRasterMax(rx, 0), clipX)
    let clippedY = WebRasterMax(WebRasterMax(ry, 0), clipY)
    let clippedRight = WebRasterMin(WebRasterMin(rx + rw, surface.width), clipX + clipW)
    let clippedBottom = WebRasterMin(WebRasterMin(ry + rh, surface.height), clipY + clipH)
    if clippedX >= clippedRight || clippedY >= clippedBottom:
        return true
    let innerX = rx + leftWidth
    let innerY = ry + topWidth
    let innerW = rw - leftWidth - rightWidth
    let innerH = rh - topWidth - bottomWidth
    let innerTl = RasterBorderInnerCornerRadius(tl, topWidth, leftWidth)
    let innerTr = RasterBorderInnerCornerRadius(tr, topWidth, rightWidth)
    let innerBr = RasterBorderInnerCornerRadius(br, bottomWidth, rightWidth)
    let innerBl = RasterBorderInnerCornerRadius(bl, bottomWidth, leftWidth)
    for y in clippedY..<clippedBottom:
        let rowOffset = y * surface.width
        for x in clippedX..<clippedRight:
            if RasterRoundedRectContainsPixel4(rx, ry, rw, rh, tl, tr, br, bl, x, y):
                var insideInner = false
                if innerW > 0 && innerH > 0:
                    insideInner = RasterRoundedRectContainsPixel4(innerX, innerY, innerW, innerH,
                        innerTl, innerTr, innerBr, innerBl, x, y)
                if !insideInner:
                    RasterSurfaceWritePixel(surface, rowOffset + x, color)
    return true

fn RasterBorderRectClippedImpl(surface: var RasterSurface,
                               rx: int32, ry: int32, rw: int32, rh: int32,
                               color: int32,
                               topWidth: int32,
                               rightWidth: int32,
                               bottomWidth: int32,
                               leftWidth: int32,
                               borderRadius: int32,
                               clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    return RasterBorderRectCornersClippedImpl(surface, rx, ry, rw, rh, color,
        topWidth, rightWidth, bottomWidth, leftWidth,
        borderRadius, borderRadius, borderRadius, borderRadius,
        clipX, clipY, clipW, clipH)

fn RasterStrokeRectImpl(surface: var RasterSurface, rx: int32, ry: int32, rw: int32, rh: int32,
                        color: int32, borderWidth: int32, borderRadius: int32): bool =
    return RasterBorderRectClippedImpl(surface, rx, ry, rw, rh, color,
        borderWidth, borderWidth, borderWidth, borderWidth, borderRadius,
        0, 0, surface.width, surface.height)

fn RasterStrokeRectClippedImpl(surface: var RasterSurface, rx: int32, ry: int32, rw: int32, rh: int32,
                               color: int32, borderWidth: int32, borderRadius: int32,
                               clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    return RasterBorderRectClippedImpl(surface, rx, ry, rw, rh, color,
        borderWidth, borderWidth, borderWidth, borderWidth, borderRadius,
        clipX, clipY, clipW, clipH)

@borrows
fn RasterFillTextImpl(surface: var RasterSurface, x: int32, y: int32,
                      text: str, charWidth: int32, lineHeight: int32,
                      color: int32) =
    if text.len <= 0 || charWidth <= 0 || lineHeight <= 0:
        return
    for i in 0..<text.len:
        let ch = text[i]
        if ch != ' ':
            let cx = x + i * charWidth
            RasterDrawPseudoGlyphImpl(surface, cx, y, charWidth, lineHeight, ch, color)

@borrows
fn RasterFillTextClippedImpl(surface: var RasterSurface, x: int32, y: int32,
                             text: str, charWidth: int32, lineHeight: int32,
                             color: int32,
                             clipX: int32, clipY: int32, clipW: int32, clipH: int32) =
    if text.len <= 0 || charWidth <= 0 || lineHeight <= 0:
        return
    for i in 0..<text.len:
        let ch = text[i]
        if ch != ' ':
            let cx = x + i * charWidth
            RasterDrawPseudoGlyphClippedImpl(surface, cx, y, charWidth, lineHeight,
                ch, clipX, clipY, clipW, clipH, color)

fn RasterFontScaledAscender(face: var font.WebFontFace, fontSizePx: int32): int32 =
    if !face.loaded || face.unitsPerEm <= 0 || fontSizePx <= 0:
        return 0
    return int32((int64(face.ascender) * int64(fontSizePx) + int64(face.unitsPerEm / 2)) / int64(face.unitsPerEm))

fn RasterFontScaledLineHeightPx2(face: var font.WebFontFace, fontSizePx: int32): int32 =
    if !face.loaded || face.unitsPerEm <= 0 || fontSizePx <= 0:
        return 0
    let designHeight = face.ascender - face.descender + face.lineGap
    if designHeight <= 0:
        return fontSizePx * 2
    return int32((int64(designHeight) * int64(fontSizePx) * 2 + int64(face.unitsPerEm / 2)) / int64(face.unitsPerEm))

@borrows
fn RasterMeasureTextVisualWidthWithFont(surface: var RasterSurface,
                                        face: var font.WebFontFace,
                                        text: str,
                                        fontSizePx: int32): int32 =
    var outAdvance = 0
    var hasInk = 0
    var inkMin = 0
    var inkMax = 0
    if !face.loaded:
        surface.lastError = "font face not loaded"
        return -1
    if fontSizePx <= 0 || face.unitsPerEm <= 0:
        surface.lastError = "invalid font text scale"
        return -1
    let textLen = text.len
    var textIndex = 0
    while textIndex < textLen:
        var b0 = int32(text[textIndex])
        var decodedCodepoint = 0
        var nextIndex = textIndex + 1
        var decodedOk = 0
        if b0 <= 127:
            decodedCodepoint = b0
            decodedOk = 1
        if decodedOk == 0 && b0 >= 192 && b0 < 224:
            if textIndex + 1 >= textLen:
                surface.lastError = "invalid utf8 text"
                return -1
            let b1 = int32(text[textIndex + 1])
            if (b1 & 192) != 128:
                surface.lastError = "invalid utf8 text"
                return -1
            decodedCodepoint = ((b0 & 31) << 6) | (b1 & 63)
            nextIndex = textIndex + 2
            decodedOk = 1
        if decodedOk == 0 && b0 >= 224 && b0 < 240:
            if textIndex + 2 >= textLen:
                surface.lastError = "invalid utf8 text"
                return -1
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            if (b1 & 192) != 128 || (b2 & 192) != 128:
                surface.lastError = "invalid utf8 text"
                return -1
            decodedCodepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
            nextIndex = textIndex + 3
            decodedOk = 1
        if decodedOk == 0 && b0 >= 240 && b0 < 248:
            if textIndex + 3 >= textLen:
                surface.lastError = "invalid utf8 text"
                return -1
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            let b3 = int32(text[textIndex + 3])
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128:
                surface.lastError = "invalid utf8 text"
                return -1
            decodedCodepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
            nextIndex = textIndex + 4
            decodedOk = 1
        if decodedOk == 0:
            surface.lastError = "invalid utf8 text"
            return -1
        var glyphCodepoint = decodedCodepoint
        if decodedCodepoint == 32 || decodedCodepoint == 10 || decodedCodepoint == 13 || decodedCodepoint == 9:
            glyphCodepoint = 32
        let glyphIndex = font.WebFontGlyphIndexForCodepoint(face, glyphCodepoint)
        if glyphIndex == 0 && glyphCodepoint != 32:
            surface.lastError = Fmt"font glyph missing: {glyphCodepoint}"
            return -1
        if glyphIndex > 0 && glyphCodepoint != 32:
            var outline: font.WebFontGlyphOutline
            if !font.WebFontGlyphOutlineRead(face, glyphIndex, outline):
                surface.lastError = Fmt"font glyph outline unreadable: codepoint={glyphCodepoint},glyph={glyphIndex}"
                return -1
            let glyphMin = outAdvance + RasterFloorDivI64(int64(outline.xMin) * int64(fontSizePx), int64(face.unitsPerEm))
            let glyphMax = outAdvance + RasterCeilDivI64(int64(outline.xMax) * int64(fontSizePx), int64(face.unitsPerEm))
            if hasInk == 0:
                inkMin = glyphMin
                inkMax = glyphMax
                hasInk = 1
            else:
                if glyphMin < inkMin:
                    inkMin = glyphMin
                if glyphMax > inkMax:
                    inkMax = glyphMax
        let advance = font.WebFontScaledAdvance(face, glyphIndex, fontSizePx)
        if advance <= 0:
            surface.lastError = "font glyph advance missing"
            return -1
        outAdvance = outAdvance + advance
        textIndex = nextIndex
    if hasInk == 0:
        return outAdvance
    return inkMax - inkMin

@borrows
fn RasterFillTextWithFontClipped(surface: var RasterSurface,
                                 face: var font.WebFontFace,
                                 x: int32,
                                 y: int32,
                                 text: str,
                                 fontSizePx: int32,
                                 color: int32,
                                 clipX: int32,
                                 clipY: int32,
                                 clipW: int32,
                                 clipH: int32,
                                 alignX: int32,
                                 alignWidth: int32,
                                 textAlign: int32): bool =
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    if !face.loaded:
        return RasterFail(surface, "font face not loaded")
    if text.len <= 0:
        return true
    if fontSizePx <= 0 || face.unitsPerEm <= 0:
        return RasterFail(surface, "invalid font text scale")
    if clipW <= 0 || clipH <= 0:
        return true
    let ascenderPx = RasterFontScaledAscender(face, fontSizePx)
    if ascenderPx <= 0:
        return RasterFail(surface, "invalid font ascender")
    let baselineY = y + ascenderPx
    var cursorX = x
    if alignWidth > 0 && (textAlign == 1 || textAlign == 2):
        let measuredAdvance = RasterMeasureTextVisualWidthWithFont(surface, face, text, fontSizePx)
        if measuredAdvance < 0:
            return false
        if alignWidth > measuredAdvance:
            if textAlign == 1:
                cursorX = alignX + (alignWidth - measuredAdvance) / 2
            elif textAlign == 2:
                cursorX = alignX + alignWidth - measuredAdvance
    let textLen = text.len
    var textIndex = 0
    while textIndex < textLen:
        var b0 = int32(text[textIndex])
        var decodedCodepoint = 0
        var nextIndex = textIndex + 1
        var decodedOk = 0
        if b0 <= 127:
            decodedCodepoint = b0
            decodedOk = 1
        if decodedOk == 0 && b0 >= 192 && b0 < 224:
            if textIndex + 1 >= textLen:
                return RasterFail(surface, "invalid utf8 text")
            let b1 = int32(text[textIndex + 1])
            if (b1 & 192) != 128:
                return RasterFail(surface, "invalid utf8 text")
            decodedCodepoint = ((b0 & 31) << 6) | (b1 & 63)
            nextIndex = textIndex + 2
            decodedOk = 1
        if decodedOk == 0 && b0 >= 224 && b0 < 240:
            if textIndex + 2 >= textLen:
                return RasterFail(surface, "invalid utf8 text")
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            if (b1 & 192) != 128 || (b2 & 192) != 128:
                return RasterFail(surface, "invalid utf8 text")
            decodedCodepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
            nextIndex = textIndex + 3
            decodedOk = 1
        if decodedOk == 0 && b0 >= 240 && b0 < 248:
            if textIndex + 3 >= textLen:
                return RasterFail(surface, "invalid utf8 text")
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            let b3 = int32(text[textIndex + 3])
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128:
                return RasterFail(surface, "invalid utf8 text")
            decodedCodepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
            nextIndex = textIndex + 4
            decodedOk = 1
        if decodedOk == 0:
            return RasterFail(surface, "invalid utf8 text")
        var blankFlag = 0
        if decodedCodepoint == 32 || decodedCodepoint == 10 || decodedCodepoint == 13 || decodedCodepoint == 9:
            blankFlag = 1
        var glyphCodepoint = decodedCodepoint
        if blankFlag != 0:
            glyphCodepoint = 32
        let glyphIndex = font.WebFontGlyphIndexForCodepoint(face, glyphCodepoint)
        if glyphIndex == 0 && blankFlag == 0:
            return RasterFail(surface, Fmt"font glyph missing: {glyphCodepoint}")
        if glyphIndex > 0 && blankFlag == 0:
            var outline: font.WebFontGlyphOutline
            if !font.WebFontGlyphOutlineRead(face, glyphIndex, outline):
                return RasterFail(surface, Fmt"font glyph outline unreadable: codepoint={glyphCodepoint},glyph={glyphIndex}")
            if !RasterFillGlyphOutlineCachedClipped(surface, outline, face.fingerprint, glyphIndex,
                cursorX, baselineY, fontSizePx, face.unitsPerEm, color, clipX, clipY, clipW, clipH):
                return false
        let advance = font.WebFontScaledAdvance(face, glyphIndex, fontSizePx)
        if advance <= 0:
            return RasterFail(surface, "font glyph advance missing")
        cursorX = cursorX + advance
        textIndex = nextIndex
    return true

@borrows
fn RasterFillTextWithFont(surface: var RasterSurface,
                          face: var font.WebFontFace,
                          x: int32,
                          y: int32,
                          text: str,
                          fontSizePx: int32,
                          color: int32): bool =
    return RasterFillTextWithFontClipped(surface, face, x, y, text, fontSizePx, color,
        0, 0, surface.width, surface.height, x, 0, 0)

fn RasterFontCascadeValidate4(surface: var RasterSurface,
                              face0: var font.WebFontFace,
                              face1: var font.WebFontFace,
                              face2: var font.WebFontFace,
                              face3: var font.WebFontFace,
                              faceCount: int32): bool =
    if faceCount <= 0 || faceCount > 4:
        return RasterFail(surface, "font cascade is empty")
    if face0.cffDetected:
        return RasterFail(surface, "font uses CFF/PostScript outlines (not supported); use TrueType fonts")
    if !face0.loaded || face0.unitsPerEm <= 0:
        return RasterFail(surface, "font cascade face not loaded: 0")
    if faceCount >= 2:
        if face1.cffDetected:
            return RasterFail(surface, "font cascade face 1 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face1.loaded || face1.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 1")
    if faceCount >= 3:
        if face2.cffDetected:
            return RasterFail(surface, "font cascade face 2 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face2.loaded || face2.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 2")
    if faceCount >= 4:
        if face3.cffDetected:
            return RasterFail(surface, "font cascade face 3 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face3.loaded || face3.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 3")
    return true

fn RasterFontCascadeSelect4(face0: var font.WebFontFace,
                            face1: var font.WebFontFace,
                            face2: var font.WebFontFace,
                            face3: var font.WebFontFace,
                            faceCount: int32,
                            codepoint: int32,
                            outFaceIndex: var int32,
                            outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if codepoint < 0:
        return false
    let glyph0 = font.WebFontGlyphIndexForCodepoint(face0, codepoint)
    if glyph0 > 0:
        outFaceIndex = 0
        outGlyphIndex = glyph0
        return true
    if faceCount >= 2:
        let glyph1 = font.WebFontGlyphIndexForCodepoint(face1, codepoint)
        if glyph1 > 0:
            outFaceIndex = 1
            outGlyphIndex = glyph1
            return true
    if faceCount >= 3:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(face2, codepoint)
        if glyph2 > 0:
            outFaceIndex = 2
            outGlyphIndex = glyph2
            return true
    if faceCount >= 4:
        let glyph3 = font.WebFontGlyphIndexForCodepoint(face3, codepoint)
        if glyph3 > 0:
            outFaceIndex = 3
        outGlyphIndex = glyph3
        return true
    return false

fn RasterNormalizeFontWeight(weight: int32): int32 =
    if weight <= 0:
        return 400
    if weight > 1000:
        return 1000
    return weight

fn RasterNormalizeFontFamily(family: int32): int32 =
    if family == 1:
        return 1
    return 0

fn RasterFontCascadeShouldReplaceWeight(bestScore: int32,
                                        bestWeight: int32,
                                        candidateScore: int32,
                                        candidateWeight: int32,
                                        requestedWeight: int32): bool =
    if candidateScore < bestScore:
        return true
    if candidateScore > bestScore:
        return false
    if requestedWeight >= 600:
        return candidateWeight > bestWeight
    return candidateWeight < bestWeight

fn RasterFontCascadeSelectWeighted4(face0: var font.WebFontFace,
                                    face1: var font.WebFontFace,
                                    face2: var font.WebFontFace,
                                    face3: var font.WebFontFace,
                                    faceCount: int32,
                                    codepoint: int32,
                                    weight0: int32,
                                    weight1: int32,
                                    weight2: int32,
                                    weight3: int32,
                                    requestedWeight: int32,
                                    outFaceIndex: var int32,
                                    outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if codepoint < 0:
        return false
    let targetWeight = RasterNormalizeFontWeight(requestedWeight)
    var bestScore = 2147483647
    var bestWeight = 400
    var bestFaceIndex = -1
    var bestGlyphIndex = 0
    let glyph0 = font.WebFontGlyphIndexForCodepoint(face0, codepoint)
    if glyph0 > 0:
        let candidateWeight0 = RasterNormalizeFontWeight(weight0)
        let candidateScore0 = RasterAbsInt32(candidateWeight0 - targetWeight)
        bestScore = candidateScore0
        bestWeight = candidateWeight0
        bestFaceIndex = 0
        bestGlyphIndex = glyph0
    if faceCount >= 2:
        let glyph1 = font.WebFontGlyphIndexForCodepoint(face1, codepoint)
        if glyph1 > 0:
            let candidateWeight1 = RasterNormalizeFontWeight(weight1)
            let candidateScore1 = RasterAbsInt32(candidateWeight1 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore1, candidateWeight1, targetWeight):
                bestScore = candidateScore1
                bestWeight = candidateWeight1
                bestFaceIndex = 1
                bestGlyphIndex = glyph1
    if faceCount >= 3:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(face2, codepoint)
        if glyph2 > 0:
            let candidateWeight2 = RasterNormalizeFontWeight(weight2)
            let candidateScore2 = RasterAbsInt32(candidateWeight2 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore2, candidateWeight2, targetWeight):
                bestScore = candidateScore2
                bestWeight = candidateWeight2
                bestFaceIndex = 2
                bestGlyphIndex = glyph2
    if faceCount >= 4:
        let glyph3 = font.WebFontGlyphIndexForCodepoint(face3, codepoint)
        if glyph3 > 0:
            let candidateWeight3 = RasterNormalizeFontWeight(weight3)
            let candidateScore3 = RasterAbsInt32(candidateWeight3 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore3, candidateWeight3, targetWeight):
                bestScore = candidateScore3
                bestWeight = candidateWeight3
                bestFaceIndex = 3
                bestGlyphIndex = glyph3
    if bestFaceIndex < 0:
        return false
    outFaceIndex = bestFaceIndex
    outGlyphIndex = bestGlyphIndex
    return true

fn RasterFontCascadeSelectWeightedFamily4(face0: var font.WebFontFace,
                                          face1: var font.WebFontFace,
                                          face2: var font.WebFontFace,
                                          face3: var font.WebFontFace,
                                          faceCount: int32,
                                          codepoint: int32,
                                          weight0: int32,
                                          weight1: int32,
                                          weight2: int32,
                                          weight3: int32,
                                          family0: int32,
                                          family1: int32,
                                          family2: int32,
                                          family3: int32,
                                          requestedWeight: int32,
                                          requestedFamily: int32,
                                          outFaceIndex: var int32,
                                          outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if RasterNormalizeFontFamily(requestedFamily) != 1:
        return RasterFontCascadeSelectWeighted4(face0, face1, face2, face3, faceCount, codepoint,
            weight0, weight1, weight2, weight3, requestedWeight, outFaceIndex, outGlyphIndex)
    let targetWeight = RasterNormalizeFontWeight(requestedWeight)
    var bestScore = 2147483647
    var bestWeight = 400
    var bestFaceIndex = -1
    var bestGlyphIndex = 0
    if RasterNormalizeFontFamily(family0) == 1:
        let glyph0 = font.WebFontGlyphIndexForCodepoint(face0, codepoint)
        if glyph0 > 0:
            let candidateWeight0 = RasterNormalizeFontWeight(weight0)
            let candidateScore0 = RasterAbsInt32(candidateWeight0 - targetWeight)
            bestScore = candidateScore0
            bestWeight = candidateWeight0
            bestFaceIndex = 0
            bestGlyphIndex = glyph0
    if faceCount >= 2 && RasterNormalizeFontFamily(family1) == 1:
        let glyph1 = font.WebFontGlyphIndexForCodepoint(face1, codepoint)
        if glyph1 > 0:
            let candidateWeight1 = RasterNormalizeFontWeight(weight1)
            let candidateScore1 = RasterAbsInt32(candidateWeight1 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore1, candidateWeight1, targetWeight):
                bestScore = candidateScore1
                bestWeight = candidateWeight1
                bestFaceIndex = 1
                bestGlyphIndex = glyph1
    if faceCount >= 3 && RasterNormalizeFontFamily(family2) == 1:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(face2, codepoint)
        if glyph2 > 0:
            let candidateWeight2 = RasterNormalizeFontWeight(weight2)
            let candidateScore2 = RasterAbsInt32(candidateWeight2 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore2, candidateWeight2, targetWeight):
                bestScore = candidateScore2
                bestWeight = candidateWeight2
                bestFaceIndex = 2
                bestGlyphIndex = glyph2
    if faceCount >= 4 && RasterNormalizeFontFamily(family3) == 1:
        let glyph3 = font.WebFontGlyphIndexForCodepoint(face3, codepoint)
        if glyph3 > 0:
            let candidateWeight3 = RasterNormalizeFontWeight(weight3)
            let candidateScore3 = RasterAbsInt32(candidateWeight3 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore3, candidateWeight3, targetWeight):
                bestScore = candidateScore3
                bestWeight = candidateWeight3
                bestFaceIndex = 3
                bestGlyphIndex = glyph3
    if bestFaceIndex >= 0:
        outFaceIndex = bestFaceIndex
        outGlyphIndex = bestGlyphIndex
        return true
    return RasterFontCascadeSelectWeighted4(face0, face1, face2, face3, faceCount, codepoint,
        weight0, weight1, weight2, weight3, requestedWeight, outFaceIndex, outGlyphIndex)

fn RasterFontCascadeCopyFace(face0: var font.WebFontFace,
                             face1: var font.WebFontFace,
                             face2: var font.WebFontFace,
                             face3: var font.WebFontFace,
                             faceIndex: int32,
                             outFace: var font.WebFontFace): bool =
    if faceIndex == 0:
        outFace = face0
        return true
    if faceIndex == 1:
        outFace = face1
        return true
    if faceIndex == 2:
        outFace = face2
        return true
    if faceIndex == 3:
        outFace = face3
        return true
    return false

fn RasterFontCascadeUnitsPerEm4(face0: var font.WebFontFace,
                                face1: var font.WebFontFace,
                                face2: var font.WebFontFace,
                                face3: var font.WebFontFace,
                                faceIndex: int32): int32 =
    if faceIndex == 0:
        return face0.unitsPerEm
    if faceIndex == 1:
        return face1.unitsPerEm
    if faceIndex == 2:
        return face2.unitsPerEm
    if faceIndex == 3:
        return face3.unitsPerEm
    return 0

fn RasterFontCascadeFingerprint4(face0: var font.WebFontFace,
                                 face1: var font.WebFontFace,
                                 face2: var font.WebFontFace,
                                 face3: var font.WebFontFace,
                                 faceIndex: int32): int32 =
    if faceIndex == 0:
        return face0.fingerprint
    if faceIndex == 1:
        return face1.fingerprint
    if faceIndex == 2:
        return face2.fingerprint
    if faceIndex == 3:
        return face3.fingerprint
    return 0

fn RasterFontCascadeAdvance4(face0: var font.WebFontFace,
                             face1: var font.WebFontFace,
                             face2: var font.WebFontFace,
                             face3: var font.WebFontFace,
                             faceIndex: int32,
                             glyphIndex: int32,
                             fontSizePx: int32): int32 =
    if faceIndex == 0:
        return font.WebFontScaledAdvance(face0, glyphIndex, fontSizePx)
    if faceIndex == 1:
        return font.WebFontScaledAdvance(face1, glyphIndex, fontSizePx)
    if faceIndex == 2:
        return font.WebFontScaledAdvance(face2, glyphIndex, fontSizePx)
    if faceIndex == 3:
        return font.WebFontScaledAdvance(face3, glyphIndex, fontSizePx)
    return 0

fn RasterFontCascadeReadOutline4(face0: var font.WebFontFace,
                                 face1: var font.WebFontFace,
                                 face2: var font.WebFontFace,
                                 face3: var font.WebFontFace,
                                 faceIndex: int32,
                                 glyphIndex: int32,
                                 outline: var font.WebFontGlyphOutline): bool =
    if faceIndex == 0:
        return font.WebFontGlyphOutlineRead(face0, glyphIndex, outline)
    if faceIndex == 1:
        return font.WebFontGlyphOutlineRead(face1, glyphIndex, outline)
    if faceIndex == 2:
        return font.WebFontGlyphOutlineRead(face2, glyphIndex, outline)
    if faceIndex == 3:
        return font.WebFontGlyphOutlineRead(face3, glyphIndex, outline)
    return false

fn RasterFontCascadeValidate8(surface: var RasterSurface,
                              face0: var font.WebFontFace,
                              face1: var font.WebFontFace,
                              face2: var font.WebFontFace,
                              face3: var font.WebFontFace,
                              face4: var font.WebFontFace,
                              face5: var font.WebFontFace,
                              face6: var font.WebFontFace,
                              face7: var font.WebFontFace,
                              faceCount: int32): bool =
    if faceCount <= 0 || faceCount > 8:
        return RasterFail(surface, "font cascade is empty")
    if !RasterFontCascadeValidate4(surface, face0, face1, face2, face3, WebRasterMin(faceCount, 4)):
        return false
    if faceCount >= 5:
        if face4.cffDetected:
            return RasterFail(surface, "font cascade face 4 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face4.loaded || face4.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 4")
    if faceCount >= 6:
        if face5.cffDetected:
            return RasterFail(surface, "font cascade face 5 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face5.loaded || face5.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 5")
    if faceCount >= 7:
        if face6.cffDetected:
            return RasterFail(surface, "font cascade face 6 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face6.loaded || face6.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 6")
    if faceCount >= 8:
        if face7.cffDetected:
            return RasterFail(surface, "font cascade face 7 uses CFF/PostScript outlines (not supported); use TrueType fonts")
        if !face7.loaded || face7.unitsPerEm <= 0:
            return RasterFail(surface, "font cascade face not loaded: 7")
    return true

fn RasterFontCascadeSelectWeighted8(face0: var font.WebFontFace,
                                    face1: var font.WebFontFace,
                                    face2: var font.WebFontFace,
                                    face3: var font.WebFontFace,
                                    face4: var font.WebFontFace,
                                    face5: var font.WebFontFace,
                                    face6: var font.WebFontFace,
                                    face7: var font.WebFontFace,
                                    faceCount: int32,
                                    codepoint: int32,
                                    weight0: int32,
                                    weight1: int32,
                                    weight2: int32,
                                    weight3: int32,
                                    weight4: int32,
                                    weight5: int32,
                                    weight6: int32,
                                    weight7: int32,
                                    requestedWeight: int32,
                                    outFaceIndex: var int32,
                                    outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if codepoint < 0:
        return false
    let targetWeight = RasterNormalizeFontWeight(requestedWeight)
    var bestScore = 2147483647
    var bestWeight = 400
    var bestFaceIndex = -1
    var bestGlyphIndex = 0
    if faceCount >= 1:
        let glyph0 = font.WebFontGlyphIndexForCodepoint(face0, codepoint)
        if glyph0 > 0:
            let candidateWeight0 = RasterNormalizeFontWeight(weight0)
            let candidateScore0 = RasterAbsInt32(candidateWeight0 - targetWeight)
            bestScore = candidateScore0
            bestWeight = candidateWeight0
            bestFaceIndex = 0
            bestGlyphIndex = glyph0
    if faceCount >= 2:
        let glyph1 = font.WebFontGlyphIndexForCodepoint(face1, codepoint)
        if glyph1 > 0:
            let candidateWeight1 = RasterNormalizeFontWeight(weight1)
            let candidateScore1 = RasterAbsInt32(candidateWeight1 - targetWeight)
            if bestFaceIndex < 0 || RasterFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore1, candidateWeight1, targetWeight):
                bestScore = candidateScore1
                bestWeight = candidateWeight1
                bestFaceIndex = 1
                bestGlyphIndex = glyph1
    if faceCount >= 3:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(face2, codepoint)
        if glyph2 > 0:
