fn RasterDrawPseudoGlyphImpl(surface: var RasterSurface, x: int32, y: int32,
                             charWidth: int32, lineHeight: int32,
                             ch: char, color: int32) =
    let code = int32(ch)
    if code <= 32:
        return
    var stroke = charWidth / 5
    if stroke < 1:
        stroke = 1
    var glyphW = charWidth - stroke
    if glyphW < stroke:
        glyphW = stroke
    let glyphH = lineHeight * 3 / 5
    let glyphY = y + (lineHeight - glyphH) / 2
    let midY = glyphY + glyphH / 2
    let bottomY = glyphY + glyphH - stroke
    let rightX = x + glyphW - stroke
    RasterFillRectImpl(surface, x, bottomY, glyphW, stroke, color)
    if (code & 1) != 0:
        RasterFillRectImpl(surface, x, glyphY, stroke, glyphH, color)
    if (code & 2) != 0:
        RasterFillRectImpl(surface, rightX, glyphY, stroke, glyphH, color)
    if (code & 4) != 0:
        RasterFillRectImpl(surface, x, glyphY, glyphW, stroke, color)
    if (code & 8) != 0:
        RasterFillRectImpl(surface, x, midY, glyphW, stroke, color)

fn RasterDrawPseudoGlyphClippedImpl(surface: var RasterSurface, x: int32, y: int32,
                                    charWidth: int32, lineHeight: int32,
                                    ch: char,
                                    clipX: int32, clipY: int32, clipW: int32, clipH: int32,
                                    color: int32) =
    let code = int32(ch)
    if code <= 32:
        return
    var stroke = charWidth / 5
    if stroke < 1:
        stroke = 1
    var glyphW = charWidth - stroke
    if glyphW < stroke:
        glyphW = stroke
    let glyphH = lineHeight * 3 / 5
    let glyphY = y + (lineHeight - glyphH) / 2
    let midY = glyphY + glyphH / 2
    let bottomY = glyphY + glyphH - stroke
    let rightX = x + glyphW - stroke
    RasterFillRectClippedImpl(surface, x, bottomY, glyphW, stroke, clipX, clipY, clipW, clipH, color)
    if (code & 1) != 0:
        RasterFillRectClippedImpl(surface, x, glyphY, stroke, glyphH, clipX, clipY, clipW, clipH, color)
    if (code & 2) != 0:
        RasterFillRectClippedImpl(surface, rightX, glyphY, stroke, glyphH, clipX, clipY, clipW, clipH, color)
    if (code & 4) != 0:
        RasterFillRectClippedImpl(surface, x, glyphY, glyphW, stroke, clipX, clipY, clipW, clipH, color)
    if (code & 8) != 0:
        RasterFillRectClippedImpl(surface, x, midY, glyphW, stroke, clipX, clipY, clipW, clipH, color)

fn RasterAbsInt32(value: int32): int32 =
    if value < 0:
        return -value
    return value

fn RasterFloorDivI64(numer: int64, denom: int64): int32 =
    let q = numer / denom
    let r = numer % denom
    if r != int64(0) && numer < int64(0):
        return int32(q - int64(1))
    return int32(q)

fn RasterCeilDivI64(numer: int64, denom: int64): int32 =
    let q = numer / denom
    let r = numer % denom
    if r != int64(0) && numer > int64(0):
        return int32(q + int64(1))
    return int32(q)

fn RasterSetPixelClippedImpl(surface: var RasterSurface, x: int32, y: int32,
                             clipX: int32, clipY: int32, clipW: int32, clipH: int32,
                             color: int32) =
    if clipW <= 0 || clipH <= 0:
        return
    if x < clipX || y < clipY || x >= clipX + clipW || y >= clipY + clipH:
        return
    if x < 0 || y < 0 || x >= surface.width || y >= surface.height:
        return
    let index = y * surface.width + x
    if index < 0 || index >= surface.pixelBuffer.len:
        return
    RasterSurfaceWritePixel(surface, index, color)

fn RasterGlyphOutlineOnCurveOnly(outline: var font.WebFontGlyphOutline): bool =
    if !outline.simple || outline.pointCount <= 0 || outline.pointCount != outline.points.len:
        return false
    for i in 0..<outline.pointCount:
        if !outline.points[i].onCurve:
            return false
    return true

fn RasterGlyphAppendFlatPoint(outline: var font.WebFontGlyphOutline,
                              x: int32, y: int32, endContour: bool) =
    var point: font.WebFontGlyphPoint
    point.x = x
    point.y = y
    point.onCurve = true
    point.endContour = endContour
    add(outline.points, point)
    outline.pointCount = outline.points.len

fn RasterGlyphSetLastEndContour(outline: var font.WebFontGlyphOutline): bool =
    if outline.points.len <= 0:
        return false
    outline.points[outline.points.len - 1].endContour = true
    return true

fn RasterGlyphAppendQuadFlat(outline: var font.WebFontGlyphOutline,
                             startX: int32, startY: int32,
                             controlX: int32, controlY: int32,
                             endX: int32, endY: int32) =
    let steps = 8
    let denom = steps * steps
    for step in 1..steps:
        let mt = steps - step
        let xNumer = mt * mt * startX + 2 * mt * step * controlX + step * step * endX
        let yNumer = mt * mt * startY + 2 * mt * step * controlY + step * step * endY
        RasterGlyphAppendFlatPoint(outline, xNumer / denom, yNumer / denom, false)

@borrows
fn RasterGlyphFlattenContour(source: var font.WebFontGlyphOutline,
                             contourStart: int32,
                             contourEnd: int32,
                             out: var font.WebFontGlyphOutline): bool =
    if contourStart < 0 || contourEnd < contourStart || contourEnd >= source.pointCount:
        return false
    let first = source.points[contourStart]
    let last = source.points[contourEnd]
    var startX = first.x
    var startY = first.y
    var cursorIndex = contourStart + 1
    if !first.onCurve:
        if last.onCurve:
            startX = last.x
            startY = last.y
            cursorIndex = contourStart
        else:
            startX = (last.x + first.x) / 2
            startY = (last.y + first.y) / 2
            cursorIndex = contourStart
    RasterGlyphAppendFlatPoint(out, startX, startY, false)
    var currentX = startX
    var currentY = startY
    var hasControl = false
    var controlX = 0
    var controlY = 0
    let count = contourEnd - contourStart + 1
    for n in 0..<count:
        let index = contourStart + ((cursorIndex - contourStart + n) % count)
        let point = source.points[index]
        if point.onCurve:
            if hasControl:
                RasterGlyphAppendQuadFlat(out, currentX, currentY, controlX, controlY, point.x, point.y)
                hasControl = false
            else:
                RasterGlyphAppendFlatPoint(out, point.x, point.y, false)
            currentX = point.x
            currentY = point.y
        else:
            if hasControl:
                let midX = (controlX + point.x) / 2
                let midY = (controlY + point.y) / 2
                RasterGlyphAppendQuadFlat(out, currentX, currentY, controlX, controlY, midX, midY)
                currentX = midX
                currentY = midY
                controlX = point.x
                controlY = point.y
            else:
                hasControl = true
                controlX = point.x
                controlY = point.y
    if hasControl:
        RasterGlyphAppendQuadFlat(out, currentX, currentY, controlX, controlY, startX, startY)
    elif currentX != startX || currentY != startY:
        RasterGlyphAppendFlatPoint(out, startX, startY, false)
    return RasterGlyphSetLastEndContour(out)

@borrows
fn RasterGlyphFlattenQuadratics(source: var font.WebFontGlyphOutline,
                                out: var font.WebFontGlyphOutline): bool =
    font.WebFontGlyphOutlineInit(out)
    if !source.simple || source.pointCount <= 0 || source.pointCount != source.points.len:
        return false
    out.glyphIndex = source.glyphIndex
    out.simple = true
    out.contourCount = source.contourCount
    out.xMin = source.xMin
    out.yMin = source.yMin
    out.xMax = source.xMax
    out.yMax = source.yMax
    var contourStart = 0
    var contourSeen = 0
    for i in 0..<source.pointCount:
        if source.points[i].endContour:
            if !RasterGlyphFlattenContour(source, contourStart, i, out):
                font.WebFontGlyphOutlineInit(out)
                return false
            contourStart = i + 1
            contourSeen = contourSeen + 1
    if contourSeen != source.contourCount:
        font.WebFontGlyphOutlineInit(out)
        return false
    out.pointCount = out.points.len
    return out.pointCount > 0

fn RasterGlyphEdgeCrosses(px: int32, py: int32,
                          x0: int32, y0: int32,
                          x1: int32, y1: int32): bool =
    if y0 == y1:
        return false
    let above0 = y0 > py
    let above1 = y1 > py
    if above0 == above1:
        return false
    let dy = y1 - y0
    let lhs = int64(px - x0) * int64(dy)
    let rhs = int64(py - y0) * int64(x1 - x0)
    if dy > 0:
        return lhs < rhs
    return lhs > rhs

fn RasterGlyphOutlineContainsPoint(outline: var font.WebFontGlyphOutline, px: int32, py: int32): bool =
    var inside = false
    var contourStart = 0
    for i in 0..<outline.pointCount:
        let p0 = outline.points[i]
        var nextIndex = i + 1
        if p0.endContour:
            nextIndex = contourStart
            contourStart = i + 1
        if nextIndex < 0 || nextIndex >= outline.pointCount:
            return false
        let p1 = outline.points[nextIndex]
        if RasterGlyphEdgeCrosses(px, py, p0.x, p0.y, p1.x, p1.y):
            inside = !inside
    return inside

fn RasterGlyphAtlasBucketCount(): int32 =
    return 4096

fn RasterGlyphAtlasEnsureBuckets(atlas: var RasterGlyphAtlas) =
    if atlas.bucketHeads.len > 0:
        return
    for i in 0..<RasterGlyphAtlasBucketCount():
        add(atlas.bucketHeads, -1)

fn RasterGlyphAtlasEnsureGlobalBuckets() =
    if __rasterGlyphAtlasBucketHeads.len > 0:
        return
    for i in 0..<RasterGlyphAtlasBucketCount():
        add(__rasterGlyphAtlasBucketHeads, -1)

fn RasterGlyphAtlasBucket(fontKey: int32,
                          glyphIndex: int32,
                          fontSizePx: int32,
                          unitsPerEm: int32,
                          originParityX: int32,
                          baselineParityY: int32): int32 =
    let hashMod = int64(2147483647)
    var hash: int64 = int64(fontKey)
    if hash < int64(0):
        hash = 0 - hash
    hash = hash % hashMod
    hash = (hash * int64(131) + int64(glyphIndex)) % hashMod
    if hash < int64(0):
        hash = 0 - hash
    hash = (hash * int64(131) + int64(fontSizePx)) % hashMod
    if hash < int64(0):
        hash = 0 - hash
    hash = (hash * int64(131) + int64(unitsPerEm)) % hashMod
    if hash < int64(0):
        hash = 0 - hash
    hash = (hash * int64(131) + int64(originParityX)) % hashMod
    if hash < int64(0):
        hash = 0 - hash
    hash = (hash * int64(131) + int64(baselineParityY)) % hashMod
    if hash < int64(0):
        hash = 0 - hash
    var bucket = int32(hash % int64(RasterGlyphAtlasBucketCount()))
    if bucket < 0:
        bucket = 0 - bucket
    if bucket >= RasterGlyphAtlasBucketCount():
        bucket = bucket % RasterGlyphAtlasBucketCount()
    return bucket

fn RasterGlyphMaskEntryMatches(entry: RasterGlyphMaskEntry,
                               fontKey: int32,
                               glyphIndex: int32,
                               fontSizePx: int32,
                               unitsPerEm: int32,
                               originParityX: int32,
                               baselineParityY: int32): bool =
    if entry.fontKey != fontKey:
        return false
    if entry.glyphIndex != glyphIndex:
        return false
    if entry.fontSizePx != fontSizePx:
        return false
    if entry.unitsPerEm != unitsPerEm:
        return false
    if entry.originParityX != originParityX:
        return false
    if entry.baselineParityY != baselineParityY:
        return false
    return true

fn RasterGlyphAtlasLookup(fontKey: int32,
                          glyphIndex: int32,
                          fontSizePx: int32,
                          unitsPerEm: int32,
                          originParityX: int32,
                          baselineParityY: int32): int32 =
    RasterGlyphAtlasEnsureGlobalBuckets()
    let bucket = RasterGlyphAtlasBucket(fontKey, glyphIndex, fontSizePx, unitsPerEm, originParityX, baselineParityY)
    var entryIndex = __rasterGlyphAtlasBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= __rasterGlyphAtlasEntries.len:
            return -1
        let entry = __rasterGlyphAtlasEntries[entryIndex]
        if RasterGlyphMaskEntryMatches(entry, fontKey, glyphIndex, fontSizePx, unitsPerEm, originParityX, baselineParityY):
            __rasterGlyphAtlasHits = __rasterGlyphAtlasHits + 1
            return entryIndex
        entryIndex = entry.nextIndex
    __rasterGlyphAtlasMisses = __rasterGlyphAtlasMisses + 1
    return -1

fn RasterGlyphAtlasInsert(fontKey: int32,
                          glyphIndex: int32,
                          fontSizePx: int32,
                          unitsPerEm: int32,
                          originParityX: int32,
                          baselineParityY: int32,
                          offsetX: int32,
                          offsetY: int32,
                          width: int32,
                          height: int32,
                          coverageStart: int32,
                          coverageCount: int32): int32 =
    RasterGlyphAtlasEnsureGlobalBuckets()
    let bucket = RasterGlyphAtlasBucket(fontKey, glyphIndex, fontSizePx, unitsPerEm, originParityX, baselineParityY)
    var entry: RasterGlyphMaskEntry
    entry.fontKey = fontKey
    entry.glyphIndex = glyphIndex
    entry.fontSizePx = fontSizePx
    entry.unitsPerEm = unitsPerEm
    entry.originParityX = originParityX
    entry.baselineParityY = baselineParityY
    entry.offsetX = offsetX
    entry.offsetY = offsetY
    entry.width = width
    entry.height = height
    entry.coverageStart = coverageStart
    entry.coverageCount = coverageCount
    entry.nextIndex = __rasterGlyphAtlasBucketHeads[bucket]
    add(__rasterGlyphAtlasEntries, entry)
    let entryIndex = __rasterGlyphAtlasEntries.len - 1
    __rasterGlyphAtlasBucketHeads[bucket] = entryIndex
    return entryIndex

@borrows
fn RasterGlyphAtlasAppendCoverages(coverages: int32[],
                                   outStart: var int32): bool =
    outStart = __rasterGlyphAtlasCoverages.len
    for i in 0..<coverages.len:
        add(__rasterGlyphAtlasCoverages, coverages[i])
    return __rasterGlyphAtlasCoverages.len == outStart + coverages.len

// 单个字形 mask 的最大边长;超过即视为字体数据异常并按缺字跳过(首次告警)
const RasterGlyphMaskMaxDim: int32 = 4096
var __rasterGlyphMaskOversizeWarned: bool

fn RasterGlyphMaskBuild(surface: var RasterSurface,
                        outline: var font.WebFontGlyphOutline,
                        fontKey: int32,
                        glyphIndex: int32,
                        fontSizePx: int32,
                        unitsPerEm: int32,
                        originParityX: int32,
                        baselineParityY: int32,
                        outEntryIndex: var int32): bool =
    outEntryIndex = -1
    if fontKey <= 0:
        return RasterFail(surface, "font glyph atlas key missing")
    if fontSizePx <= 0 || unitsPerEm <= 0:
        return RasterFail(surface, "invalid glyph scale")
    var drawable: font.WebFontGlyphOutline
    if !RasterGlyphFlattenQuadratics(outline, drawable):
        return RasterFail(surface, "glyph outline flatten failed")
    let scale = int64(fontSizePx)
    let upem = int64(unitsPerEm)
    let originCeilX = (originParityX + 1) / 2
    let baselineCeilY = (baselineParityY + 1) / 2
    var minX = RasterFloorDivI64(int64(drawable.xMin) * scale, upem)
    var maxX = originCeilX + RasterCeilDivI64(int64(drawable.xMax) * scale, upem)
    var minY = 0 - RasterCeilDivI64(int64(drawable.yMax) * scale, upem)
    var maxY = baselineCeilY - RasterFloorDivI64(int64(drawable.yMin) * scale, upem)
    if originParityX != 0:
        minX = minX - 1
        maxX = maxX + 1
    if baselineParityY != 0:
        minY = minY - 1
        maxY = maxY + 1
    let width = maxX - minX
    let height = maxY - minY
    var coverageStart = 0
    // 病态 bbox 防护: 超限字形会让下方采样循环退化成小时级循环并令 int32 覆盖率计数溢出
    // (实测 SIGBUS @ atlas 扩容回填)。真实文本字形不会超过此尺寸,超限=字体数据/缩放 bug,快速失败。
    if width > RasterGlyphMaskMaxDim || height > RasterGlyphMaskMaxDim:
        // 浏览器语义: 无法成形的字形按缺字跳过(不可见),不拖垮整页;首次出现时告警留痕
        if !__rasterGlyphMaskOversizeWarned:
            __rasterGlyphMaskOversizeWarned = true
            echo(Fmt"warning: glyph mask {width}x{height} exceeds limit {RasterGlyphMaskMaxDim}, skipped")
        var emptyCoverages2: int32[]
        var skippedStart = 0
        if !RasterGlyphAtlasAppendCoverages(emptyCoverages2, skippedStart):
            return RasterFail(surface, "glyph atlas coverage append failed")
        outEntryIndex = RasterGlyphAtlasInsert(fontKey, glyphIndex, fontSizePx, unitsPerEm,
            originParityX, baselineParityY, minX, minY, 0, 0, skippedStart, 0)
        return true
    if width <= 0 || height <= 0:
        var emptyCoverages: int32[]
        if !RasterGlyphAtlasAppendCoverages(emptyCoverages, coverageStart):
            return RasterFail(surface, "glyph atlas coverage append failed")
        outEntryIndex = RasterGlyphAtlasInsert(fontKey, glyphIndex, fontSizePx, unitsPerEm,
            originParityX, baselineParityY, minX, minY, 0, 0, coverageStart, 0)
        return true
    let sampleDenom = int64(fontSizePx * 8)
    // Coverage is accumulated per pixel, so the array is sized up front and the
    // scanline sweep below scatters into it (subsample rows are the outer loop).
    var builtCoverages: int32[]
    var fillIndex = 0
    while fillIndex < width * height:
        add(builtCoverages, 0)
        fillIndex = fillIndex + 1
    for yy in 0..<height:
        let y = minY + yy
        var sampleYStep = 1
        while sampleYStep <= 15:
            let sampleYNumer = int64(baselineParityY * 4 - y * 8 - sampleYStep) * upem
            let gy = RasterFloorDivI64(sampleYNumer, sampleDenom)
            // Collect the crossings of this scanline with every outline edge,
            // as exact rationals num/den with den > 0.
            var crossNum: int64[]
            var crossDen: int64[]
            var edgeContourStart = 0
            var edgeIndex = 0
            while edgeIndex < drawable.pointCount:
                let e0 = drawable.points[edgeIndex]
                var nextIndex = edgeIndex + 1
                if e0.endContour:
                    nextIndex = edgeContourStart
                    edgeContourStart = edgeIndex + 1
                if nextIndex >= 0 && nextIndex < drawable.pointCount:
                    let e1 = drawable.points[nextIndex]
                    // RasterGlyphEdgeCrosses semantics: skip horizontal edges,
                    // keep edges that straddle y = gy in the half-open sense.
                    if e0.y != e1.y && (e0.y > gy) != (e1.y > gy):
                        let eDy = int64(e1.y - e0.y)
                        var cNum = int64(e0.x) * eDy + int64(gy - e0.y) * int64(e1.x - e0.x)
                        var cDen = eDy
                        if cDen < int64(0):
                            cDen = 0 - cDen
                            cNum = 0 - cNum
                        // insertion sort by num/den (den > 0, so num_a*den_b < num_b*den_a)
                        var at: int32 = crossNum.len
                        while at > 0 && crossNum[at - 1] * cDen > cNum * crossDen[at - 1]:
                            at = at - 1
                        add(crossNum, cNum)
                        add(crossDen, cDen)
                        var sh: int32 = crossNum.len - 1
                        while sh > at:
                            let tN = crossNum[sh]
                            crossNum[sh] = crossNum[sh - 1]
                            crossNum[sh - 1] = tN
                            let tD = crossDen[sh]
                            crossDen[sh] = crossDen[sh - 1]
                            crossDen[sh - 1] = tD
                            sh = sh - 1
                edgeIndex = edgeIndex + 1
            let crossCount = crossNum.len
            var sampleXStep = 1
            while sampleXStep <= 15:
                // gx is monotonically non-decreasing in xx for a fixed
                // sampleXStep, so the crossing cursor only ever moves forward.
                var cursor: int32
                for xx in 0..<width:
                    let x = minX + xx
                    let sampleXNumer = int64(x * 8 + sampleXStep - originParityX * 4) * upem
                    let gx = RasterFloorDivI64(sampleXNumer, sampleDenom)
                    while cursor < crossCount && crossNum[cursor] <= int64(gx) * crossDen[cursor]:
                        cursor = cursor + 1
                    if (crossCount - cursor) % 2 == 1:
                        let covIndex = yy * width + xx
                        builtCoverages[covIndex] = builtCoverages[covIndex] + 1
                sampleXStep = sampleXStep + 2
            sampleYStep = sampleYStep + 2
    if !RasterGlyphAtlasAppendCoverages(builtCoverages, coverageStart):
        return RasterFail(surface, "glyph atlas coverage append failed")
    let coverageCount = builtCoverages.len
    outEntryIndex = RasterGlyphAtlasInsert(fontKey, glyphIndex, fontSizePx, unitsPerEm,
        originParityX, baselineParityY, minX, minY, width, height, coverageStart, coverageCount)
    return true

fn RasterBlitGlyphMaskClipped(surface: var RasterSurface,
                              entry: RasterGlyphMaskEntry,
                              originX2: int32,
                              baselineY2: int32,
                              color: int32,
                              clipX: int32,
                              clipY: int32,
                              clipW: int32,
                              clipH: int32): bool =
    if entry.width <= 0 || entry.height <= 0:
        return true
    let drawX = originX2 / 2 + entry.offsetX
    let drawY = baselineY2 / 2 + entry.offsetY
    let clippedX = WebRasterMax(WebRasterMax(drawX, 0), clipX)
    let clippedY = WebRasterMax(WebRasterMax(drawY, 0), clipY)
    let clippedRight = WebRasterMin(WebRasterMin(drawX + entry.width, surface.width), clipX + clipW)
    let clippedBottom = WebRasterMin(WebRasterMin(drawY + entry.height, surface.height), clipY + clipH)
    if clippedX >= clippedRight || clippedY >= clippedBottom:
        return true
    for y in clippedY..<clippedBottom:
        let maskY = y - drawY
        for x in clippedX..<clippedRight:
            let maskX = x - drawX
            let coverageIndex = entry.coverageStart + maskY * entry.width + maskX
            if coverageIndex < entry.coverageStart || coverageIndex >= entry.coverageStart + entry.coverageCount:
                return RasterFail(surface, "glyph atlas coverage index out of bounds")
            let coverage = __rasterGlyphAtlasCoverages[coverageIndex]
            if coverage > 0:
                RasterSetPixelClippedImpl(surface, x, y, clipX, clipY, clipW, clipH,
                    RasterColorWithCoverageAlpha(color, coverage, 64))
    return true

fn RasterFillGlyphOutlineCachedClippedPx2(surface: var RasterSurface,
                                          outline: var font.WebFontGlyphOutline,
                                          fontKey: int32,
                                          glyphIndex: int32,
                                          originX2: int32,
                                          baselineY2: int32,
                                          fontSizePx: int32,
                                          unitsPerEm: int32,
                                          color: int32,
                                          clipX: int32,
                                          clipY: int32,
                                          clipW: int32,
                                          clipH: int32): bool =
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    if fontSizePx <= 0 || unitsPerEm <= 0:
        return RasterFail(surface, "invalid glyph scale")
    if clipW <= 0 || clipH <= 0:
        return true
    let originParityX = originX2 % 2
    let baselineParityY = baselineY2 % 2
    var entryIndex = RasterGlyphAtlasLookup(fontKey, glyphIndex, fontSizePx, unitsPerEm, originParityX, baselineParityY)
    if entryIndex < 0:
        if !RasterGlyphMaskBuild(surface, outline, fontKey, glyphIndex, fontSizePx, unitsPerEm, originParityX, baselineParityY, entryIndex):
            return false
    if entryIndex < 0 || entryIndex >= __rasterGlyphAtlasEntries.len:
        return RasterFail(surface, "glyph atlas entry missing")
    let entry = __rasterGlyphAtlasEntries[entryIndex]
    return RasterBlitGlyphMaskClipped(surface, entry, originX2, baselineY2, color, clipX, clipY, clipW, clipH)

fn RasterFillGlyphOutlineCachedClipped(surface: var RasterSurface,
                                       outline: var font.WebFontGlyphOutline,
                                       fontKey: int32,
                                       glyphIndex: int32,
                                       originX: int32,
                                       baselineY: int32,
                                       fontSizePx: int32,
                                       unitsPerEm: int32,
                                       color: int32,
                                       clipX: int32,
                                       clipY: int32,
                                       clipW: int32,
                                       clipH: int32): bool =
    return RasterFillGlyphOutlineCachedClippedPx2(surface, outline, fontKey, glyphIndex,
        originX * 2, baselineY * 2, fontSizePx, unitsPerEm, color, clipX, clipY, clipW, clipH)

fn RasterFillGlyphOutlineClipped(surface: var RasterSurface,
                                 outline: var font.WebFontGlyphOutline,
                                 originX: int32,
                                 baselineY: int32,
                                 fontSizePx: int32,
                                 unitsPerEm: int32,
                                 color: int32,
                                 clipX: int32,
                                 clipY: int32,
                                 clipW: int32,
                                 clipH: int32): bool =
    return RasterFillGlyphOutlineClippedPx2(surface, outline, originX * 2, baselineY * 2,
        fontSizePx, unitsPerEm, color, clipX, clipY, clipW, clipH)

fn RasterFillGlyphOutlineClippedPx2(surface: var RasterSurface,
                                    outline: var font.WebFontGlyphOutline,
                                    originX2: int32,
                                    baselineY2: int32,
                                    fontSizePx: int32,
                                    unitsPerEm: int32,
                                    color: int32,
                                    clipX: int32,
                                    clipY: int32,
                                    clipW: int32,
                                    clipH: int32): bool =
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    if fontSizePx <= 0 || unitsPerEm <= 0:
        return RasterFail(surface, "invalid glyph scale")
    if clipW <= 0 || clipH <= 0:
        return true
    var drawable: font.WebFontGlyphOutline
    if !RasterGlyphFlattenQuadratics(outline, drawable):
        return RasterFail(surface, "glyph outline flatten failed")
    let scale = int64(fontSizePx)
    let upem = int64(unitsPerEm)
    let originFloorX = originX2 / 2
    let originCeilX = (originX2 + 1) / 2
    let baselineFloorY = baselineY2 / 2
    let baselineCeilY = (baselineY2 + 1) / 2
    var minX = originFloorX + RasterFloorDivI64(int64(drawable.xMin) * scale, upem)
    var maxX = originCeilX + RasterCeilDivI64(int64(drawable.xMax) * scale, upem)
    var minY = baselineFloorY - RasterCeilDivI64(int64(drawable.yMax) * scale, upem)
    var maxY = baselineCeilY - RasterFloorDivI64(int64(drawable.yMin) * scale, upem)
    if originX2 % 2 != 0:
        minX = minX - 1
        maxX = maxX + 1
    if baselineY2 % 2 != 0:
        minY = minY - 1
        maxY = maxY + 1
    let clippedX = WebRasterMax(WebRasterMax(minX, 0), clipX)
    let clippedY = WebRasterMax(WebRasterMax(minY, 0), clipY)
    let clippedRight = WebRasterMin(WebRasterMin(maxX, surface.width), clipX + clipW)
    let clippedBottom = WebRasterMin(WebRasterMin(maxY, surface.height), clipY + clipH)
    if clippedX >= clippedRight || clippedY >= clippedBottom:
        return true
    let sampleDenom = int64(fontSizePx * 8)
    for y in clippedY..<clippedBottom:
        for x in clippedX..<clippedRight:
            var coverage = 0
            var sampleYStep = 1
            while sampleYStep <= 15:
                let sampleYNumer = int64(baselineY2 * 4 - y * 8 - sampleYStep) * upem
                let gy = RasterFloorDivI64(sampleYNumer, sampleDenom)
                var sampleXStep = 1
                while sampleXStep <= 15:
                    let sampleXNumer = int64(x * 8 + sampleXStep - originX2 * 4) * upem
                    let gx = RasterFloorDivI64(sampleXNumer, sampleDenom)
                    if RasterGlyphOutlineContainsPoint(drawable, gx, gy):
                        coverage = coverage + 1
                    sampleXStep = sampleXStep + 2
                sampleYStep = sampleYStep + 2
            if coverage > 0:
                RasterSetPixelClippedImpl(surface, x, y, clipX, clipY, clipW, clipH,
                    RasterColorWithCoverageAlpha(color, coverage, 64))
    return true

fn RasterFillGlyphOutline(surface: var RasterSurface,
                          outline: var font.WebFontGlyphOutline,
                          originX: int32,
                          baselineY: int32,
                          fontSizePx: int32,
                          unitsPerEm: int32,
                          color: int32): bool =
    return RasterFillGlyphOutlineClipped(surface, outline, originX, baselineY, fontSizePx, unitsPerEm,
        color, 0, 0, surface.width, surface.height)

fn RasterSvgUnitToPixel(origin: int32, size: int32, value: int32): int32 =
    if value > 24 || value < -24:
        return origin + (value * size) / 2400
    return origin + (value * size) / 24

fn RasterSvgUnitToLength(size: int32, value: int32): int32 =
    if value > 24 || value < -24:
        return (value * size) / 2400
    return (value * size) / 24

fn RasterSvgStrokeRadius(size: int32): int32 =
    var stroke = size / 18
    if stroke < 1:
        stroke = 1
    return stroke

fn RasterDrawSvgLineClippedImpl(surface: var RasterSurface,
                                x0: int32, y0: int32, x1: int32, y1: int32,
                                strokeRadius: int32, color: int32,
                                clipX: int32, clipY: int32, clipW: int32, clipH: int32) =
    var left = WebRasterMin(x0, x1) - strokeRadius
    var right = WebRasterMax(x0, x1) + strokeRadius
    var top = WebRasterMin(y0, y1) - strokeRadius
    var bottom = WebRasterMax(y0, y1) + strokeRadius
    left = WebRasterMax(WebRasterMax(left, 0), clipX)
    top = WebRasterMax(WebRasterMax(top, 0), clipY)
    right = WebRasterMin(WebRasterMin(right, surface.width - 1), clipX + clipW - 1)
    bottom = WebRasterMin(WebRasterMin(bottom, surface.height - 1), clipY + clipH - 1)
    if left > right || top > bottom:
        return
    let vx = x1 - x0
    let vy = y1 - y0
    let len2 = int64(vx) * int64(vx) + int64(vy) * int64(vy)
    let radius2 = int64(strokeRadius) * int64(strokeRadius)
    for y in top..bottom:
        for x in left..right:
            let px = x - x0
            let py = y - y0
            var draw = false
            if len2 == int64(0):
                let d2 = int64(px) * int64(px) + int64(py) * int64(py)
                if d2 <= radius2:
                    draw = true
            else:
                let dot = int64(px) * int64(vx) + int64(py) * int64(vy)
                if dot < int64(0):
                    let d2 = int64(px) * int64(px) + int64(py) * int64(py)
                    if d2 <= radius2:
                        draw = true
                elif dot > len2:
                    let ex = x - x1
                    let ey = y - y1
                    let d2 = int64(ex) * int64(ex) + int64(ey) * int64(ey)
                    if d2 <= radius2:
                        draw = true
                else:
                    let cross = int64(px) * int64(vy) - int64(py) * int64(vx)
                    if cross * cross <= radius2 * len2:
                        draw = true
            if draw:
                RasterSetPixelClippedImpl(surface, x, y, clipX, clipY, clipW, clipH, color)

fn RasterDrawSvgCircleClippedImpl(surface: var RasterSurface,
                                  cx: int32, cy: int32, radius: int32,
                                  strokeRadius: int32, color: int32,
                                  clipX: int32, clipY: int32, clipW: int32, clipH: int32) =
    var inner = radius - strokeRadius
    if inner < 0:
        inner = 0
    let outer = radius + strokeRadius
    let inner2 = inner * inner
    let outer2 = outer * outer
    var left = WebRasterMax(WebRasterMax(cx - outer, 0), clipX)
    var top = WebRasterMax(WebRasterMax(cy - outer, 0), clipY)
    var right = WebRasterMin(WebRasterMin(cx + outer, surface.width - 1), clipX + clipW - 1)
    var bottom = WebRasterMin(WebRasterMin(cy + outer, surface.height - 1), clipY + clipH - 1)
    if left > right || top > bottom:
        return
    for y in top..bottom:
        let dy = y - cy
        for x in left..right:
            let dx = x - cx
            let d2 = dx * dx + dy * dy
            if d2 >= inner2 && d2 <= outer2:
                RasterSetPixelClippedImpl(surface, x, y, clipX, clipY, clipW, clipH, color)

fn RasterDrawSvgEllipseClippedImpl(surface: var RasterSurface,
                                   cx: int32, cy: int32, rx: int32, ry: int32,
                                   strokeRadius: int32, color: int32,
                                   clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    if rx <= 0 || ry <= 0:
        return RasterFail(surface, "invalid svg ellipse")
    let outerX = rx + strokeRadius
    let outerY = ry + strokeRadius
    var left = WebRasterMax(WebRasterMax(cx - outerX, 0), clipX)
    var top = WebRasterMax(WebRasterMax(cy - outerY, 0), clipY)
    var right = WebRasterMin(WebRasterMin(cx + outerX, surface.width - 1), clipX + clipW - 1)
    var bottom = WebRasterMin(WebRasterMin(cy + outerY, surface.height - 1), clipY + clipH - 1)
    if left > right || top > bottom:
        return true
    let rx2 = int64(rx) * int64(rx)
    let ry2 = int64(ry) * int64(ry)
    var minRadius = rx
    if ry < minRadius:
        minRadius = ry
    var tolerance = (int64(strokeRadius) * int64(10000)) / int64(minRadius)
    if tolerance < int64(800):
        tolerance = int64(800)
    for y in top..bottom:
        let dy = y - cy
        for x in left..right:
            let dx = x - cx
            let norm = (int64(dx) * int64(dx) * int64(10000)) / rx2 +
                (int64(dy) * int64(dy) * int64(10000)) / ry2
            var diff = norm - int64(10000)
            if diff < int64(0):
                diff = -diff
            if diff <= tolerance:
                RasterSetPixelClippedImpl(surface, x, y, clipX, clipY, clipW, clipH, color)
    return true

@borrows
fn RasterDrawSvgPrimitiveClippedImpl(surface: var RasterSurface,
                                     primitive: paint.PaintSvgPrimitive,
                                     drawX: int32, drawY: int32, size: int32,
                                     stroke: int32, color: int32,
                                     clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    if primitive.kind == paint.PaintSvgPrimitiveLine:
        let x0 = RasterSvgUnitToPixel(drawX, size, primitive.x1)
        let y0 = RasterSvgUnitToPixel(drawY, size, primitive.y1)
        let x1 = RasterSvgUnitToPixel(drawX, size, primitive.x2)
        let y1 = RasterSvgUnitToPixel(drawY, size, primitive.y2)
        RasterDrawSvgLineClippedImpl(surface, x0, y0, x1, y1, stroke, color, clipX, clipY, clipW, clipH)
    elif primitive.kind == paint.PaintSvgPrimitiveCircle:
        let cx = RasterSvgUnitToPixel(drawX, size, primitive.cx)
        let cy = RasterSvgUnitToPixel(drawY, size, primitive.cy)
        let radius = RasterSvgUnitToLength(size, primitive.rx)
        RasterDrawSvgCircleClippedImpl(surface, cx, cy, radius, stroke, color, clipX, clipY, clipW, clipH)
    elif primitive.kind == paint.PaintSvgPrimitiveEllipse:
        let cx = RasterSvgUnitToPixel(drawX, size, primitive.cx)
        let cy = RasterSvgUnitToPixel(drawY, size, primitive.cy)
        let erx = RasterSvgUnitToLength(size, primitive.rx)
        let ery = RasterSvgUnitToLength(size, primitive.ry)
        if !RasterDrawSvgEllipseClippedImpl(surface, cx, cy, erx, ery, stroke, color, clipX, clipY, clipW, clipH):
            return false
    elif primitive.kind == paint.PaintSvgPrimitiveRect:
        let rectX = RasterSvgUnitToPixel(drawX, size, primitive.x1)
        let rectY = RasterSvgUnitToPixel(drawY, size, primitive.y1)
        let rectW = RasterSvgUnitToLength(size, primitive.x2)
        let rectH = RasterSvgUnitToLength(size, primitive.y2)
        RasterDrawSvgLineClippedImpl(surface, rectX, rectY, rectX + rectW, rectY, stroke, color, clipX, clipY, clipW, clipH)
        RasterDrawSvgLineClippedImpl(surface, rectX + rectW, rectY, rectX + rectW, rectY + rectH, stroke, color, clipX, clipY, clipW, clipH)
        RasterDrawSvgLineClippedImpl(surface, rectX + rectW, rectY + rectH, rectX, rectY + rectH, stroke, color, clipX, clipY, clipW, clipH)
        RasterDrawSvgLineClippedImpl(surface, rectX, rectY + rectH, rectX, rectY, stroke, color, clipX, clipY, clipW, clipH)
    else:
        return RasterFail(surface, "unsupported svg primitive")
    return true

@borrows
fn RasterDrawSvgPrimitiveMaybeFillImpl(surface: var RasterSurface,
                                       primitive: paint.PaintSvgPrimitive,
                                       drawX: int32, drawY: int32, size: int32,
                                       stroke: int32, color: int32,
                                       fillSeen: var bool,
                                       fillXs0: var int32[], fillYs0: var int32[],
                                       fillXs1: var int32[], fillYs1: var int32[],
                                       clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    if primitive.kind == paint.PaintSvgPrimitiveFillMarker:
        fillSeen = true
        return true
    if fillSeen && primitive.kind == paint.PaintSvgPrimitiveLine:
        add(fillXs0, RasterSvgUnitToPixel(drawX, size, primitive.x1))
        add(fillYs0, RasterSvgUnitToPixel(drawY, size, primitive.y1))
        add(fillXs1, RasterSvgUnitToPixel(drawX, size, primitive.x2))
        add(fillYs1, RasterSvgUnitToPixel(drawY, size, primitive.y2))
        return true
    return RasterDrawSvgPrimitiveClippedImpl(surface, primitive, drawX, drawY, size, stroke, color, clipX, clipY, clipW, clipH)

// Evenodd scanline fill for fill-style svg icons (`fill="currentColor"` paths):
// the Line primitives are the flattened outline(s); intersect every segment with each
// scanline, sort crossings, and fill pixel pairs (evenodd rule punches inner holes).
fn RasterFillSvgLinesClippedImpl(surface: var RasterSurface,
                                 xs0: int32[], ys0: int32[], xs1: int32[], ys1: int32[],
                                 color: int32,
                                 clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    let n = xs0.len
    if n <= 0:
        return true
    var minY = ys0[0]
    var maxY = ys0[0]
    for i in 0..<n:
        if ys0[i] < minY:
            minY = ys0[i]
        if ys1[i] < minY:
            minY = ys1[i]
        if ys0[i] > maxY:
            maxY = ys0[i]
        if ys1[i] > maxY:
            maxY = ys1[i]
    var y = minY
    while y <= maxY:
        var xs: int32[]
        for i in 0..<n:
            let ya = ys0[i]
            let yb = ys1[i]
            if (ya <= y && y < yb) || (yb <= y && y < ya):
                let dx = xs1[i] - xs0[i]
                let dy = yb - ya
                let xi = xs0[i] + int32((int64(y - ya) * int64(dx)) / int64(dy))
                add(xs, xi)
        var a = 1
        while a < xs.len:
            let v = xs[a]
            var b = a
            while b > 0 && xs[b - 1] > v:
                xs[b] = xs[b - 1]
                b = b - 1
            xs[b] = v
            a = a + 1
        var k = 0
        while k + 1 < xs.len:
            var x0 = xs[k]
            var x1 = xs[k + 1]
            if x1 > x0:
                var px = x0
                while px < x1:
                    RasterSetPixelClippedImpl(surface, px, y, clipX, clipY, clipW, clipH, color)
                    px = px + 1
            k = k + 2
        y = y + 1
    return true

@borrows
fn RasterDrawSvgIconClippedImpl(surface: var RasterSurface, rx: int32, ry: int32,
                                rw: int32, rh: int32, iconKind: int32, iconSize: int32,
                                primitives: paint.PaintSvgPrimitive[],
                                color: int32,
                                clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    var size = iconSize
    if size <= 0:
        size = rw
    if size <= 0:
        size = rh
    if size <= 0:
        return RasterFail(surface, "invalid icon size")
    if size > rw && rw > 0:
        size = rw
    if size > rh && rh > 0:
        size = rh
    var primitiveCount = primitives.len
    if primitiveCount <= 0:
        primitiveCount = paint.PaintIconSvgPrimitiveCount(iconKind)
    if primitiveCount <= 0:
        return true  # unsupported icon kind, skip gracefully
    let drawX = rx + (rw - size) / 2
    let drawY = ry + (rh - size) / 2
    let stroke = RasterSvgStrokeRadius(size)
    var fillSeen = false
    var fillXs0: int32[]
    var fillYs0: int32[]
    var fillXs1: int32[]
    var fillYs1: int32[]
    for i in 0..<primitiveCount:
        if primitives.len > 0:
            if !RasterDrawSvgPrimitiveMaybeFillImpl(surface, primitives[i], drawX, drawY, size, stroke, color, fillSeen, fillXs0, fillYs0, fillXs1, fillYs1, clipX, clipY, clipW, clipH):
                return false
        else:
            var primitive: paint.PaintSvgPrimitive
            if !paint.PaintIconSvgPrimitiveAt(iconKind, i, primitive):
                return RasterFail(surface, "invalid icon primitive")
            if !RasterDrawSvgPrimitiveMaybeFillImpl(surface, primitive, drawX, drawY, size, stroke, color, fillSeen, fillXs0, fillYs0, fillXs1, fillYs1, clipX, clipY, clipW, clipH):
                return false
    if fillSeen:
        if !RasterFillSvgLinesClippedImpl(surface, fillXs0, fillYs0, fillXs1, fillYs1, color, clipX, clipY, clipW, clipH):
            return false
    return true

fn RasterDrawGlobeIconClippedImpl(surface: var RasterSurface, rx: int32, ry: int32,
                                  rw: int32, rh: int32, iconSize: int32,
                                  color: int32,
                                  clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    var size = iconSize
    if size <= 0:
        size = rw
    if size <= 0:
        size = rh
    if size <= 0:
        return RasterFail(surface, "invalid icon size")
    if size > rw && rw > 0:
        size = rw
    if size > rh && rh > 0:
        size = rh
    let drawX = rx + (rw - size) / 2
    let drawY = ry + (rh - size) / 2
    let center = size / 2
    var radius = center - 3
    if radius < 2:
        radius = 2
    var stroke = size / 32
    if stroke < 1:
        stroke = 1
    let outerR = radius + stroke
    let innerR = radius - stroke
    let outerD2 = outerR * outerR
    let innerD2 = innerR * innerR
    var meridianRx = size / 6
    if meridianRx < 2:
        meridianRx = 2
    let meridianRy = radius
    let meridianRx2 = meridianRx * meridianRx
    let meridianRy2 = meridianRy * meridianRy
    let ellipseTolerance = 4
    for yy in 0..<size:
        let dy = yy - center
        for xx in 0..<size:
            let dx = xx - center
            let d2 = dx * dx + dy * dy
            var draw = false
            if d2 >= innerD2 && d2 <= outerD2:
                draw = true
            let ellipseValue = (dx * dx * 100) / meridianRx2 + (dy * dy * 100) / meridianRy2
            if RasterAbsInt32(ellipseValue - 100) <= ellipseTolerance:
                draw = true
            if RasterAbsInt32(dy) <= stroke && xx >= center - radius && xx <= center + radius:
                draw = true
            if draw:
                RasterSetPixelClippedImpl(surface, drawX + xx, drawY + yy, clipX, clipY, clipW, clipH, color)
    return true

type
    RasterImageEntry =
        imageId: int32
        srcWidth: int32
        srcHeight: int32
        pixelStart: int32
        pixelCount: int32

    RasterImageCache =
        entries: RasterImageEntry[]
        pixels: int32[]

fn RasterImageCacheInit(cache: var RasterImageCache) =
    cache.entries = []
    cache.pixels = []

fn RasterImageCacheRegister(cache: var RasterImageCache, imageId: int32,
                            srcWidth: int32, srcHeight: int32, pixels: int32[]): bool =
    if srcWidth <= 0 || srcHeight <= 0:
        return false
    let expectedCount = srcWidth * srcHeight
    if pixels.len != expectedCount:
        return false
    var entry: RasterImageEntry
    entry.imageId = imageId
    entry.srcWidth = srcWidth
    entry.srcHeight = srcHeight
    entry.pixelStart = cache.pixels.len
    entry.pixelCount = pixels.len
    var i: int32
    while i < pixels.len:
        add(cache.pixels, pixels[i])
        i = i + 1
    add(cache.entries, entry)
    return true

@borrows
fn RasterImageCacheRegisterRgbaBase64(cache: var RasterImageCache, imageId: int32,
                                      srcWidth: int32, srcHeight: int32, base64Text: str): bool =
    if srcWidth <= 0 || srcHeight <= 0:
        return false
    var bytes: int32[]
    if !font.WebFontDecodeBase64(base64Text, bytes):
        return false
    let count = srcWidth * srcHeight
    if bytes.len != count * 4:
        return false
    var pixels: int32[]
    var i: int32
    while i < count:
        let o = i * 4
        let px = ((bytes[o + 3] & 255) << 24) | ((bytes[o] & 255) << 16) | ((bytes[o + 1] & 255) << 8) | (bytes[o + 2] & 255)
        add(pixels, px)
        i = i + 1
    return RasterImageCacheRegister(cache, imageId, srcWidth, srcHeight, pixels)
@borrows
fn RasterImageCacheLookup(cache: RasterImageCache, imageId: int32, outEntry: var RasterImageEntry): bool =
    var i: int32
    while i < cache.entries.len:
        if cache.entries[i].imageId == imageId:
            outEntry = cache.entries[i]
            return true
        i = i + 1
    return false

@borrows
fn RasterImageCachePixelAt(cache: RasterImageCache, entry: RasterImageEntry,
                           sx: int32, sy: int32): int32 =
    if sx < 0 || sy < 0 || sx >= entry.srcWidth || sy >= entry.srcHeight:
        return 0
    let idx = entry.pixelStart + sy * entry.srcWidth + sx
    if idx < 0 || idx >= cache.pixels.len:
        return 0
    return cache.pixels[idx]

@borrows
fn RasterDrawImageImpl(surface: var RasterSurface, rx: int32, ry: int32, rw: int32, rh: int32,
                       image: paint.PaintImage, cache: RasterImageCache): bool =
    if rw <= 0 || rh <= 0:
        return RasterFail(surface, "draw image invalid rect")
    var entry: RasterImageEntry
    if !RasterImageCacheLookup(cache, image.imageId, entry):
        return RasterFail(surface, "draw image not found in cache")
    if entry.srcWidth <= 0 || entry.srcHeight <= 0:
        return RasterFail(surface, "draw image invalid source dimensions")
    let clipX = int32(0)
    let clipY = int32(0)
    let clipW = surface.width
    let clipH = surface.height
    let imagePixels = cache.pixels
    var dy: int32
    while dy < rh:
        let sy = (dy * entry.srcHeight) / rh
        if sy < 0:
            dy = dy + 1
            continue
        if sy >= entry.srcHeight:
            dy = dy + 1
            continue
        let rowBase = entry.pixelStart + sy * entry.srcWidth
        var dx: int32
        while dx < rw:
            let sx = (dx * entry.srcWidth) / rw
            if sx < 0:
                dx = dx + 1
                continue
            if sx >= entry.srcWidth:
                dx = dx + 1
                continue
            let idx = rowBase + sx
            let pixel = (idx >= 0 && idx < imagePixels.len) ? imagePixels[idx] : 0
            if pixel >> 24 == 0:
                dx = dx + 1
                continue
            let gx = rx + dx
            let gy = ry + dy
            if gx >= clipX && gx < clipW && gy >= clipY && gy < clipH:
                let bufIdx = gy * surface.width + gx
                if bufIdx >= 0 && bufIdx < surface.pixelBuffer.len:
                    RasterSurfaceWritePixel(surface, bufIdx, pixel)
            dx = dx + 1
        dy = dy + 1
    return true

# CSS 线性渐变填充。仅支持轴对齐方向(0/90/180/270 度, 默认 to bottom=180):
# 其余角度属未实现构造, 按让崩原则带值失败。stops 按 position(千分比)升序排序,
# 端外钳位到首末色, 段内逐通道线性插值; 背景绘制按不透明处理(rgb() 停靠点)。
@borrows
fn RasterFillLinearGradientImpl(surface: var RasterSurface,
                                rx: int32, ry: int32, rw: int32, rh: int32,
                                stops: paint.PaintGradientStop[],
                                angleDeg: int32): bool =
    if rw <= 0 || rh <= 0:
        return true
    if stops.len == 0:
        return RasterFail(surface, "gradient fill missing stops")
    if angleDeg != 0 && angleDeg != 90 && angleDeg != 180 && angleDeg != 270:
        return RasterFail(surface, Fmt"linear-gradient angle {angleDeg} unsupported")
    var sorted: paint.PaintGradientStop[]
    for i in 0..<stops.len:
        let s = stops[i]
        var j: int32 = sorted.len
        while j > 0 && sorted[j - 1].position > s.position:
            j = j - 1
        add(sorted, s)
        var k = sorted.len - 1
        while k > j:
            let tmp = sorted[k]
            sorted[k] = sorted[k - 1]
            sorted[k - 1] = tmp
            k = k - 1
    var x0 = rx
    if x0 < 0:
        x0 = 0
    var y0 = ry
    if y0 < 0:
        y0 = 0
    var x1 = rx + rw
    if x1 > surface.width:
        x1 = surface.width
    var y1 = ry + rh
    if y1 > surface.height:
        y1 = surface.height
    if x1 <= x0 || y1 <= y0:
        return true
    var py = y0
    while py < y1:
        var px = x0
        while px < x1:
            var tPermille: int64
            if angleDeg == 180:
                tPermille = int64(py - ry) * 1000 / rh
            elif angleDeg == 0:
                tPermille = int64(ry + rh - 1 - py) * 1000 / rh
            elif angleDeg == 90:
                tPermille = int64(px - rx) * 1000 / rw
            else:
                tPermille = int64(rx + rw - 1 - px) * 1000 / rw
            var seg = 0
            while seg < sorted.len - 1 && tPermille > sorted[seg + 1].position:
                seg = seg + 1
            var color: int32
            if sorted.len == 1 || tPermille <= sorted[0].position:
                color = sorted[0].color
            elif tPermille >= sorted[sorted.len - 1].position:
                color = sorted[sorted.len - 1].color
            else:
                let span = sorted[seg + 1].position - sorted[seg].position
                var fracNum: int64 = tPermille - sorted[seg].position
                if span > 0:
                    fracNum = fracNum * 1000 / span
                let c0 = sorted[seg].color
                let c1 = sorted[seg + 1].color
                let a0 = (c0 >> 24) & 255
                let r0 = (c0 >> 16) & 255
                let g0 = (c0 >> 8) & 255
                let b0 = c0 & 255
                let a1 = (c1 >> 24) & 255
                let r1 = (c1 >> 16) & 255
                let g1 = (c1 >> 8) & 255
                let b1 = c1 & 255
                let f = fracNum
                let aOut = a0 + int32((int64(a1 - a0) * f) / 1000)
                let rOut = r0 + int32((int64(r1 - r0) * f) / 1000)
                let gOut = g0 + int32((int64(g1 - g0) * f) / 1000)
                let bOut = b0 + int32((int64(b1 - b0) * f) / 1000)
                color = (aOut << 24) | (rOut << 16) | (gOut << 8) | bOut
            color = color | 0xFF000000
            let bufIdx = py * surface.width + px
            if bufIdx >= 0 && bufIdx < surface.pixelBuffer.len:
                RasterSurfaceWritePixel(surface, bufIdx, color)
            px = px + 1
        py = py + 1
    return true
# Dispatch: rasterise a single PaintOp onto a RasterSurface.
@borrows
fn RasterPaintOp(surface: var RasterSurface, op: paint.PaintOp): bool =
    if op.kind == paint.PaintOpKindFillRect:
        RasterFillRectImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height, op.color)
        return true
    if op.kind == paint.PaintOpKindStrokeRect:
        return RasterBorderRectCornersClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
            op.color, op.borderTopWidth, op.borderRightWidth, op.borderBottomWidth, op.borderLeftWidth,
            op.borderTopLeftRadius, op.borderTopRightRadius, op.borderBottomRightRadius, op.borderBottomLeftRadius,
            0, 0, surface.width, surface.height)
    if op.kind == paint.PaintOpKindFillText:
        RasterFillTextImpl(surface, op.rect.x, op.rect.y, op.text.text, op.text.charWidth, op.text.lineHeight, op.color)
        return true
    if op.kind == paint.PaintOpKindStrokeText:
        return RasterFail(surface, "stroke text unsupported")
    if op.kind == paint.PaintOpKindDrawImage:
        return RasterDrawImageImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                                   op.image, surface.imageCache)
    if op.kind == paint.PaintOpKindGradientFill:
        if op.gradientKind == 0:
            return RasterFillLinearGradientImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                op.gradientStops, op.gradientAngle)
        return RasterFail(surface, "radial gradient fill unsupported")
    if op.kind == paint.PaintOpKindBoxShadow:
        return RasterFail(surface, "box shadow unsupported")
    if op.kind == paint.PaintOpKindTextShadow:
        return RasterFail(surface, "text shadow unsupported")
    if op.kind == paint.PaintOpKindIcon:
        return RasterDrawSvgIconClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
            op.icon.kind, op.icon.size, op.icon.primitives, op.color, 0, 0, surface.width, surface.height)
    if op.kind == paint.PaintOpKindClipRect:
        if op.clipRect.width <= 0 || op.clipRect.height <= 0:
            return RasterFail(surface, "invalid clip rect")
        return true
    return RasterFail(surface, "unknown paint op kind")

fn RasterPaintOps(surface: var RasterSurface, ops: paint.PaintOp[]): bool =
    if surface.platformSurface != uint64(0):
        return RasterFail(surface, "platform raster surface unsupported")
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    let expectedPixelCount = surface.width * surface.height
    if surface.pixelBuffer.len != expectedPixelCount:
        return RasterFail(surface, "raster pixel buffer size mismatch")
    RasterClearError(surface)
    var clipX: int32
    var clipY: int32
    var clipW = surface.width
    var clipH = surface.height
    for i in 0..<ops.len:
        let op = ops[i]
        let savedClipX = clipX
        let savedClipY = clipY
        let savedClipW = clipW
        let savedClipH = clipH
        if op.kind == paint.PaintOpKindClipRect:
            if op.clipRect.width <= 0 || op.clipRect.height <= 0:
                return RasterFail(surface, "invalid clip rect")
            var crx: int32 = op.clipRect.x
            var cry: int32 = op.clipRect.y
            var crw: int32 = op.clipRect.width
            var crh: int32 = op.clipRect.height
            var nextX: int32 = WebRasterMax(clipX, crx)
            var nextY: int32 = WebRasterMax(clipY, cry)
            var nextRight: int32 = WebRasterMin(clipX + clipW, crx + crw)
            var nextBottom: int32 = WebRasterMin(clipY + clipH, cry + crh)
            clipX = nextX
            clipY = nextY
            clipW = nextRight - nextX
            clipH = nextBottom - nextY
            if clipW < 0:
                clipW = 0
            if clipH < 0:
                clipH = 0
        elif op.kind == paint.PaintOpKindFillRect:
            var fillClipX = clipX
            var fillClipY = clipY
            var fillClipW = clipW
            var fillClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(fillClipX, op.clipRect.x)
                let nextY = WebRasterMax(fillClipY, op.clipRect.y)
                let nextRight = WebRasterMin(fillClipX + fillClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(fillClipY + fillClipH, op.clipRect.y + op.clipRect.height)
                fillClipX = nextX
                fillClipY = nextY
                fillClipW = nextRight - nextX
                fillClipH = nextBottom - nextY
                if fillClipW < 0:
                    fillClipW = 0
                if fillClipH < 0:
                    fillClipH = 0
            RasterFillRoundedRectCornersClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                op.borderTopLeftRadius, op.borderTopRightRadius, op.borderBottomRightRadius, op.borderBottomLeftRadius,
                fillClipX, fillClipY, fillClipW, fillClipH, op.color)
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif op.kind == paint.PaintOpKindStrokeRect:
            if !RasterBorderRectCornersClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                                            op.color,
                                            op.borderTopWidth, op.borderRightWidth, op.borderBottomWidth, op.borderLeftWidth,
                                            op.borderTopLeftRadius, op.borderTopRightRadius, op.borderBottomRightRadius, op.borderBottomLeftRadius,
                                            clipX, clipY, clipW, clipH):
                return false
        elif op.kind == paint.PaintOpKindFillText:
            var textClipX = clipX
            var textClipY = clipY
            var textClipW = clipW
            var textClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(textClipX, op.clipRect.x)
                let nextY = WebRasterMax(textClipY, op.clipRect.y)
                let nextRight = WebRasterMin(textClipX + textClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(textClipY + textClipH, op.clipRect.y + op.clipRect.height)
                textClipX = nextX
                textClipY = nextY
                textClipW = nextRight - nextX
                textClipH = nextBottom - nextY
                if textClipW < 0:
                    textClipW = 0
                if textClipH < 0:
                    textClipH = 0
            RasterFillTextClippedImpl(surface, op.rect.x, op.rect.y, op.text.text, op.text.charWidth, op.text.lineHeight,
                op.color, textClipX, textClipY, textClipW, textClipH)
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif op.kind == paint.PaintOpKindIcon:
            var iconClipX = clipX
            var iconClipY = clipY
            var iconClipW = clipW
            var iconClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(iconClipX, op.clipRect.x)
                let nextY = WebRasterMax(iconClipY, op.clipRect.y)
                let nextRight = WebRasterMin(iconClipX + iconClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(iconClipY + iconClipH, op.clipRect.y + op.clipRect.height)
                iconClipX = nextX
                iconClipY = nextY
                iconClipW = nextRight - nextX
                iconClipH = nextBottom - nextY
                if iconClipW < 0:
                    iconClipW = 0
                if iconClipH < 0:
                    iconClipH = 0
            if !RasterDrawSvgIconClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                op.icon.kind, op.icon.size, op.icon.primitives, op.color, iconClipX, iconClipY, iconClipW, iconClipH):
                return false
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif !RasterPaintOp(surface, op):
            return false
    return true

fn RasterPaintOpsWithFontCascade8WeightedFamily(surface: var RasterSurface,
                                                ops: paint.PaintOp[],
                                                face0: var font.WebFontFace,
                                                face1: var font.WebFontFace,
                                                face2: var font.WebFontFace,
                                                face3: var font.WebFontFace,
                                                face4: var font.WebFontFace,
                                                face5: var font.WebFontFace,
                                                face6: var font.WebFontFace,
                                                face7: var font.WebFontFace,
                                                faceCount: int32,
                                                weight0: int32,
                                                weight1: int32,
                                                weight2: int32,
                                                weight3: int32,
                                                weight4: int32,
                                                weight5: int32,
                                                weight6: int32,
                                                weight7: int32,
                                                family0: int32,
                                                family1: int32,
                                                family2: int32,
                                                family3: int32,
                                                family4: int32,
                                                family5: int32,
                                                family6: int32,
                                                family7: int32): bool =
    if surface.platformSurface != uint64(0):
        return RasterFail(surface, "platform raster surface unsupported")
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    if !RasterFontCascadeValidate8(surface, face0, face1, face2, face3, face4, face5, face6, face7, faceCount):
        return false
    let expectedPixelCount = surface.width * surface.height
    if surface.pixelBuffer.len != expectedPixelCount:
        return RasterFail(surface, "raster pixel buffer size mismatch")
    RasterClearError(surface)
    var clipX: int32
    var clipY: int32
    var clipW = surface.width
    var clipH = surface.height
    for i in 0..<ops.len:
        let op = ops[i]
        let savedClipX = clipX
        let savedClipY = clipY
        let savedClipW = clipW
        let savedClipH = clipH
        if op.kind == paint.PaintOpKindClipRect:
            if op.clipRect.width <= 0 || op.clipRect.height <= 0:
                return RasterFail(surface, "invalid clip rect")
            var crx: int32 = op.clipRect.x
            var cry: int32 = op.clipRect.y
            var crw: int32 = op.clipRect.width
            var crh: int32 = op.clipRect.height
            var nextX: int32 = WebRasterMax(clipX, crx)
            var nextY: int32 = WebRasterMax(clipY, cry)
            var nextRight: int32 = WebRasterMin(clipX + clipW, crx + crw)
            var nextBottom: int32 = WebRasterMin(clipY + clipH, cry + crh)
            clipX = nextX
            clipY = nextY
            clipW = nextRight - nextX
            clipH = nextBottom - nextY
            if clipW < 0:
                clipW = 0
            if clipH < 0:
                clipH = 0
        elif op.kind == paint.PaintOpKindFillRect:
            var fillClipX = clipX
            var fillClipY = clipY
            var fillClipW = clipW
            var fillClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(fillClipX, op.clipRect.x)
                let nextY = WebRasterMax(fillClipY, op.clipRect.y)
                let nextRight = WebRasterMin(fillClipX + fillClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(fillClipY + fillClipH, op.clipRect.y + op.clipRect.height)
                fillClipX = nextX
                fillClipY = nextY
                fillClipW = nextRight - nextX
                fillClipH = nextBottom - nextY
                if fillClipW < 0:
                    fillClipW = 0
                if fillClipH < 0:
                    fillClipH = 0
            RasterFillRoundedRectCornersClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                op.borderTopLeftRadius, op.borderTopRightRadius, op.borderBottomRightRadius, op.borderBottomLeftRadius,
                fillClipX, fillClipY, fillClipW, fillClipH, op.color)
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif op.kind == paint.PaintOpKindStrokeRect:
            if !RasterBorderRectCornersClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                                            op.color,
                                            op.borderTopWidth, op.borderRightWidth, op.borderBottomWidth, op.borderLeftWidth,
                                            op.borderTopLeftRadius, op.borderTopRightRadius, op.borderBottomRightRadius, op.borderBottomLeftRadius,
                                            clipX, clipY, clipW, clipH):
                return false
        elif op.kind == paint.PaintOpKindFillText:
            var textClipX = clipX
            var textClipY = clipY
            var textClipW = clipW
            var textClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(textClipX, op.clipRect.x)
                let nextY = WebRasterMax(textClipY, op.clipRect.y)
                let nextRight = WebRasterMin(textClipX + textClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(textClipY + textClipH, op.clipRect.y + op.clipRect.height)
                textClipX = nextX
                textClipY = nextY
                textClipW = nextRight - nextX
                textClipH = nextBottom - nextY
                if textClipW < 0:
                    textClipW = 0
                if textClipH < 0:
                    textClipH = 0
            if !RasterFillTextWithFontCascade8WeightedClippedPx2(surface, face0, face1, face2, face3, face4, face5, face6, face7, faceCount, op.rect.xPx2, op.rect.yPx2, op.text.text,
                op.text.fontSize, op.text.lineHeightPx2, op.color, textClipX, textClipY, textClipW, textClipH,
                op.text.alignX, op.text.alignWidth, op.text.textAlign,
                weight0, weight1, weight2, weight3, weight4, weight5, weight6, weight7,
                family0, family1, family2, family3, family4, family5, family6, family7,
                op.text.fontWeight, op.text.fontFamily):
                return false
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif op.kind == paint.PaintOpKindIcon:
            var iconClipX = clipX
            var iconClipY = clipY
            var iconClipW = clipW
            var iconClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(iconClipX, op.clipRect.x)
                let nextY = WebRasterMax(iconClipY, op.clipRect.y)
                let nextRight = WebRasterMin(iconClipX + iconClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(iconClipY + iconClipH, op.clipRect.y + op.clipRect.height)
                iconClipX = nextX
                iconClipY = nextY
                iconClipW = nextRight - nextX
                iconClipH = nextBottom - nextY
                if iconClipW < 0:
                    iconClipW = 0
                if iconClipH < 0:
                    iconClipH = 0
