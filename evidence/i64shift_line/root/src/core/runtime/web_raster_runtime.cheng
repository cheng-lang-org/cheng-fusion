    if faceIndex == 2:
        return font.WebFontScaledAdvance(face2, glyphIndex, fontSizePx)
    if faceIndex == 3:
        return font.WebFontScaledAdvance(face3, glyphIndex, fontSizePx)
    if faceIndex == 4:
        return font.WebFontScaledAdvance(face4, glyphIndex, fontSizePx)
    if faceIndex == 5:
        return font.WebFontScaledAdvance(face5, glyphIndex, fontSizePx)
    if faceIndex == 6:
        return font.WebFontScaledAdvance(face6, glyphIndex, fontSizePx)
    if faceIndex == 7:
        return font.WebFontScaledAdvance(face7, glyphIndex, fontSizePx)
