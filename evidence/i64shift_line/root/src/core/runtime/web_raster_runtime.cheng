            if hasInk == 0:
                inkMin = glyphMin
                inkMax = glyphMax
                hasInk = 1
            else:
                if glyphMin < inkMin:
                    inkMin = glyphMin
                if glyphMax > inkMax:
                    inkMax = glyphMax
        let advance = RasterFontCascadeAdvance8(face0, face1, face2, face3, face4, face5, face6, face7, faceIndex, glyphIndex, fontSizePx)
        if advance <= 0:
            surface.lastError = "font glyph advance missing"
            return -1
        outAdvance = outAdvance + advance
        textIndex = nextIndex
    if hasInk == 0:
        return outAdvance
    return inkMax - inkMin

@borrows
fn RasterFillTextWithFontCascade4Clipped(surface: var RasterSurface,
                                         face0: var font.WebFontFace,
                                         face1: var font.WebFontFace,
                                         face2: var font.WebFontFace,
                                         face3: var font.WebFontFace,
                                         faceCount: int32,
                                         x: int32,
                                         y: int32,
                                         text: str,
                                         fontSizePx: int32,
                                         color: int32,
                                         clipX: int32,
                                         clipY: int32,
                                         clipW: int32,
                                         clipH: int32,
                                         alignX: int32,
                                         alignWidth: int32,
                                         textAlign: int32): bool =
    return RasterFillTextWithFontCascade4WeightedClipped(surface, face0, face1, face2, face3, faceCount,
        x, y, text, fontSizePx, color, clipX, clipY, clipW, clipH, alignX, alignWidth, textAlign,
        400, 400, 400, 400, 0, 0, 0, 0, 400, 0)

@borrows
fn RasterFillTextWithFontCascade4WeightedClipped(surface: var RasterSurface,
                                                 face0: var font.WebFontFace,
                                                 face1: var font.WebFontFace,
                                                 face2: var font.WebFontFace,
                                                 face3: var font.WebFontFace,
                                                 faceCount: int32,
                                                 x: int32,
                                                 y: int32,
                                                 text: str,
                                                 fontSizePx: int32,
                                                 color: int32,
                                                 clipX: int32,
                                                 clipY: int32,
                                                 clipW: int32,
                                                 clipH: int32,
                                                 alignX: int32,
                                                 alignWidth: int32,
                                                 textAlign: int32,
                                                 weight0: int32,
                                                 weight1: int32,
                                                 weight2: int32,
                                                 weight3: int32,
                                                 family0: int32,
                                                 family1: int32,
                                                 family2: int32,
                                                 family3: int32,
                                                 fontWeight: int32,
                                                 fontFamily: int32): bool =
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    if !RasterFontCascadeValidate4(surface, face0, face1, face2, face3, faceCount):
        return false
    if text.len <= 0:
        return true
    if fontSizePx <= 0:
        return RasterFail(surface, "invalid font text scale")
    if clipW <= 0 || clipH <= 0:
        return true
    let ascenderPx = RasterFontScaledAscender(face0, fontSizePx)
    if ascenderPx <= 0:
        return RasterFail(surface, "invalid font ascender")
    let baselineY = y + ascenderPx
    var cursorX = x
    if alignWidth > 0 && (textAlign == 1 || textAlign == 2):
        let measuredAdvance = RasterMeasureTextVisualWidthWithFontCascade4Weighted(surface, face0, face1, face2, face3, faceCount,
            text, fontSizePx, weight0, weight1, weight2, weight3, family0, family1, family2, family3, fontWeight, fontFamily)
        if measuredAdvance < 0:
            return false
        if alignWidth > measuredAdvance:
            if textAlign == 1:
                cursorX = alignX + (alignWidth - measuredAdvance) / 2
            elif textAlign == 2:
                cursorX = alignX + alignWidth - measuredAdvance
    let textLen = text.len
    var textIndex = 0
    while textIndex < textLen:
        var b0 = int32(text[textIndex])
        var decodedCodepoint = 0
        var nextIndex = textIndex + 1
        var decodedOk = 0
        if b0 <= 127:
            decodedCodepoint = b0
            decodedOk = 1
        if decodedOk == 0 && b0 >= 192 && b0 < 224:
            if textIndex + 1 >= textLen:
                return RasterFail(surface, "invalid utf8 text")
            let b1 = int32(text[textIndex + 1])
            if (b1 & 192) != 128:
                return RasterFail(surface, "invalid utf8 text")
            decodedCodepoint = ((b0 & 31) << 6) | (b1 & 63)
            nextIndex = textIndex + 2
            decodedOk = 1
        if decodedOk == 0 && b0 >= 224 && b0 < 240:
            if textIndex + 2 >= textLen:
                return RasterFail(surface, "invalid utf8 text")
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            if (b1 & 192) != 128 || (b2 & 192) != 128:
                return RasterFail(surface, "invalid utf8 text")
            decodedCodepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
            nextIndex = textIndex + 3
            decodedOk = 1
        if decodedOk == 0 && b0 >= 240 && b0 < 248:
            if textIndex + 3 >= textLen:
                return RasterFail(surface, "invalid utf8 text")
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            let b3 = int32(text[textIndex + 3])
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128:
                return RasterFail(surface, "invalid utf8 text")
            decodedCodepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
            nextIndex = textIndex + 4
            decodedOk = 1
        if decodedOk == 0:
            return RasterFail(surface, "invalid utf8 text")
        var blankFlag = 0
        if decodedCodepoint == 32 || decodedCodepoint == 10 || decodedCodepoint == 13 || decodedCodepoint == 9:
            blankFlag = 1
        var glyphCodepoint = decodedCodepoint
        if blankFlag != 0:
            glyphCodepoint = 32
        var faceIndex = -1
        var glyphIndex = 0
        if !RasterFontCascadeSelectWeightedFamily4(face0, face1, face2, face3, faceCount, glyphCodepoint,
            weight0, weight1, weight2, weight3, family0, family1, family2, family3, fontWeight, fontFamily, faceIndex, glyphIndex):
            return RasterFail(surface, Fmt"font glyph missing: {glyphCodepoint}")
        if blankFlag == 0:
            var outline: font.WebFontGlyphOutline
            if !RasterFontCascadeReadOutline4(face0, face1, face2, face3, faceIndex, glyphIndex, outline):
                return RasterFail(surface, Fmt"font glyph outline unreadable: codepoint={glyphCodepoint},glyph={glyphIndex}")
            let unitsPerEm = RasterFontCascadeUnitsPerEm4(face0, face1, face2, face3, faceIndex)
            if unitsPerEm <= 0:
                return RasterFail(surface, "invalid font text scale")
            let fontKey = RasterFontCascadeFingerprint4(face0, face1, face2, face3, faceIndex)
            if !RasterFillGlyphOutlineCachedClipped(surface, outline, fontKey, glyphIndex,
                cursorX, baselineY, fontSizePx, unitsPerEm, color, clipX, clipY, clipW, clipH):
                return false
        let advance = RasterFontCascadeAdvance4(face0, face1, face2, face3, faceIndex, glyphIndex, fontSizePx)
        if advance <= 0:
            return RasterFail(surface, "font glyph advance missing")
        cursorX = cursorX + advance
        textIndex = nextIndex
    return true

@borrows
fn RasterFillTextWithFontCascade4WeightedClippedPx2(surface: var RasterSurface,
                                                    face0: var font.WebFontFace,
                                                    face1: var font.WebFontFace,
