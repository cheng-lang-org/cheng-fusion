                bestGlyphIndex = glyph4
    if faceCount >= 6:
        let glyph5 = font.WebFontGlyphIndexForCodepoint(face5, codepoint)
        if glyph5 > 0:
            let candidateWeight5 = RasterNormalizeFontWeight(weight5)
            let candidateScore5 = RasterAbsInt32(candidateWeight5 - targetWeight)
