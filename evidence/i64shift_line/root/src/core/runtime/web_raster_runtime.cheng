fn RasterFontCascadeReadOutline8(face0: var font.WebFontFace,
                                 face1: var font.WebFontFace,
                                 face2: var font.WebFontFace,
                                 face3: var font.WebFontFace,
                                 face4: var font.WebFontFace,
                                 face5: var font.WebFontFace,
                                 face6: var font.WebFontFace,
                                 face7: var font.WebFontFace,
                                 faceIndex: int32,
                                 glyphIndex: int32,
                                 outline: var font.WebFontGlyphOutline): bool =
    if faceIndex == 0:
        return font.WebFontGlyphOutlineRead(face0, glyphIndex, outline)
    if faceIndex == 1:
        return font.WebFontGlyphOutlineRead(face1, glyphIndex, outline)
    if faceIndex == 2:
        return font.WebFontGlyphOutlineRead(face2, glyphIndex, outline)
    if faceIndex == 3:
        return font.WebFontGlyphOutlineRead(face3, glyphIndex, outline)
    if faceIndex == 4:
        return font.WebFontGlyphOutlineRead(face4, glyphIndex, outline)
    if faceIndex == 5:
        return font.WebFontGlyphOutlineRead(face5, glyphIndex, outline)
    if faceIndex == 6:
        return font.WebFontGlyphOutlineRead(face6, glyphIndex, outline)
    if faceIndex == 7:
        return font.WebFontGlyphOutlineRead(face7, glyphIndex, outline)
    return false

@borrows
fn RasterMeasureTextVisualWidthWithFontCascade4(surface: var RasterSurface,
                                                face0: var font.WebFontFace,
                                                face1: var font.WebFontFace,
                                                face2: var font.WebFontFace,
                                                face3: var font.WebFontFace,
                                                faceCount: int32,
                                                text: str,
                                                fontSizePx: int32): int32 =
    return RasterMeasureTextVisualWidthWithFontCascade4Weighted(surface, face0, face1, face2, face3, faceCount,
        text, fontSizePx, 400, 400, 400, 400, 0, 0, 0, 0, 400, 0)

@borrows
fn RasterMeasureTextVisualWidthWithFontCascade4Weighted(surface: var RasterSurface,
                                                        face0: var font.WebFontFace,
                                                        face1: var font.WebFontFace,
                                                        face2: var font.WebFontFace,
                                                        face3: var font.WebFontFace,
                                                        faceCount: int32,
                                                        text: str,
                                                        fontSizePx: int32,
                                                        weight0: int32,
                                                        weight1: int32,
                                                        weight2: int32,
                                                        weight3: int32,
                                                        family0: int32,
                                                        family1: int32,
                                                        family2: int32,
                                                        family3: int32,
                                                        fontWeight: int32,
                                                        fontFamily: int32): int32 =
    if !RasterFontCascadeValidate4(surface, face0, face1, face2, face3, faceCount):
        return -1
    if fontSizePx <= 0:
        surface.lastError = "invalid font text scale"
        return -1
    var outAdvance = 0
    var hasInk = 0
    var inkMin = 0
    var inkMax = 0
    let textLen = text.len
    var textIndex = 0
    while textIndex < textLen:
        var b0 = int32(text[textIndex])
        var decodedCodepoint = 0
        var nextIndex = textIndex + 1
        var decodedOk = 0
        if b0 <= 127:
            decodedCodepoint = b0
            decodedOk = 1
        if decodedOk == 0 && b0 >= 192 && b0 < 224:
            if textIndex + 1 >= textLen:
                surface.lastError = "invalid utf8 text"
                return -1
            let b1 = int32(text[textIndex + 1])
            if (b1 & 192) != 128:
                surface.lastError = "invalid utf8 text"
                return -1
            decodedCodepoint = ((b0 & 31) << 6) | (b1 & 63)
            nextIndex = textIndex + 2
            decodedOk = 1
        if decodedOk == 0 && b0 >= 224 && b0 < 240:
            if textIndex + 2 >= textLen:
                surface.lastError = "invalid utf8 text"
                return -1
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            if (b1 & 192) != 128 || (b2 & 192) != 128:
                surface.lastError = "invalid utf8 text"
                return -1
            decodedCodepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
            nextIndex = textIndex + 3
            decodedOk = 1
        if decodedOk == 0 && b0 >= 240 && b0 < 248:
            if textIndex + 3 >= textLen:
                surface.lastError = "invalid utf8 text"
                return -1
            let b1 = int32(text[textIndex + 1])
            let b2 = int32(text[textIndex + 2])
            let b3 = int32(text[textIndex + 3])
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128:
                surface.lastError = "invalid utf8 text"
                return -1
            decodedCodepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
            nextIndex = textIndex + 4
            decodedOk = 1
        if decodedOk == 0:
            surface.lastError = "invalid utf8 text"
            return -1
        var blankFlag = 0
        if decodedCodepoint == 32 || decodedCodepoint == 10 || decodedCodepoint == 13 || decodedCodepoint == 9:
            blankFlag = 1
        var glyphCodepoint = decodedCodepoint
        if blankFlag != 0:
            glyphCodepoint = 32
        var faceIndex = -1
        var glyphIndex = 0
        if !RasterFontCascadeSelectWeightedFamily4(face0, face1, face2, face3, faceCount, glyphCodepoint,
            weight0, weight1, weight2, weight3, family0, family1, family2, family3, fontWeight, fontFamily, faceIndex, glyphIndex):
            surface.lastError = Fmt"font glyph missing: {glyphCodepoint}"
            return -1
        if blankFlag == 0:
            var outline: font.WebFontGlyphOutline
            if !RasterFontCascadeReadOutline4(face0, face1, face2, face3, faceIndex, glyphIndex, outline):
                surface.lastError = Fmt"font glyph outline unreadable: codepoint={glyphCodepoint},glyph={glyphIndex}"
                return -1
            let unitsPerEm = RasterFontCascadeUnitsPerEm4(face0, face1, face2, face3, faceIndex)
            if unitsPerEm <= 0:
                surface.lastError = "invalid font text scale"
                return -1
            let glyphMin = outAdvance + RasterFloorDivI64(int64(outline.xMin) * int64(fontSizePx), int64(unitsPerEm))
            let glyphMax = outAdvance + RasterCeilDivI64(int64(outline.xMax) * int64(fontSizePx), int64(unitsPerEm))
            if hasInk == 0:
                inkMin = glyphMin
                inkMax = glyphMax
                hasInk = 1
            else:
                if glyphMin < inkMin:
                    inkMin = glyphMin
                if glyphMax > inkMax:
                    inkMax = glyphMax
        let advance = RasterFontCascadeAdvance4(face0, face1, face2, face3, faceIndex, glyphIndex, fontSizePx)
        if advance <= 0:
            surface.lastError = "font glyph advance missing"
            return -1
        outAdvance = outAdvance + advance
        textIndex = nextIndex
    if hasInk == 0:
        return outAdvance
    return inkMax - inkMin

