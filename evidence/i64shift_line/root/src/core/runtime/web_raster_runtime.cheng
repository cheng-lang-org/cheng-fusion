            return false
        if alignWidth > measuredAdvance:
            if textAlign == 1:
                cursorX2 = (alignX + (alignWidth - measuredAdvance) / 2) * 2
            elif textAlign == 2:
                cursorX2 = (alignX + alignWidth - measuredAdvance) * 2
    let textLen = text.len
    var textIndex = 0
    while textIndex < textLen:
        var b0 = int32(text[textIndex])
        var decodedCodepoint = 0
        var nextIndex = textIndex + 1
        var decodedOk = 0
