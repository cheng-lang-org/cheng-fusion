                op.icon.kind, op.icon.size, op.icon.primitives, op.color, iconClipX, iconClipY, iconClipW, iconClipH):
                return false
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif !RasterPaintOp(surface, op):
            return false
    return true

fn RasterPaintOpsWithFont(surface: var RasterSurface, ops: paint.PaintOp[], face: var font.WebFontFace): bool =
    var empty1: font.WebFontFace
    var empty2: font.WebFontFace
    var empty3: font.WebFontFace
    return RasterPaintOpsWithFontCascade4(surface, ops, face, empty1, empty2, empty3, 1)

fn RasterPaintOpsWithFontCascade4(surface: var RasterSurface,
                                  ops: paint.PaintOp[],
                                  face0: var font.WebFontFace,
                                  face1: var font.WebFontFace,
                                  face2: var font.WebFontFace,
                                  face3: var font.WebFontFace,
                                  faceCount: int32): bool =
    return RasterPaintOpsWithFontCascade4Weighted(surface, ops, face0, face1, face2, face3, faceCount,
        400, 400, 400, 400)

fn RasterPaintOpsWithFontCascade4Weighted(surface: var RasterSurface,
                                          ops: paint.PaintOp[],
                                          face0: var font.WebFontFace,
                                          face1: var font.WebFontFace,
                                          face2: var font.WebFontFace,
