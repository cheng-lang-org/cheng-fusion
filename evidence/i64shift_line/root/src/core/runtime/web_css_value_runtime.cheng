@borrows
fn WebCssIsWhitespace(ch: char): bool =
    if ch == ' ':
        return true
    if ch == '\n':
        return true
    if ch == '\t':
        return true
    if ch == '\r':
        return true
    return false

@borrows
fn WebCssIsDigit(ch: char): bool =
    if ch < '0':
        return false
    if ch > '9':
        return false
    return true

@borrows
fn WebCssSpanIsPxLength(source: str, start: int32, stop: int32): bool =
    if start < 0:
        return false
    if stop >= source.len:
        return false
    if stop < start:
        return false
    let count = stop - start + 1
    if count == 1 && source[start] == '0':
        return true
    if source[stop] == '%':
        for i in start..<stop:
            if !WebCssIsDigit(source[i]):
                return false
        return true
    if count < 3:
        return false
    if source[stop - 1] != 'p':
        return false
    if source[stop] != 'x':
        return false
    for i in start..<stop - 1:
        if !WebCssIsDigit(source[i]):
            return false
    return true

@borrows
fn WebCssSpanIsPercentLength(source: str, start: int32, stop: int32): bool =
    if start < 0:
        return false
    if stop >= source.len:
        return false
    if start > stop:
        return false
    if source[stop] != '%':
        return false
    if stop <= start:
        return false
    for i in start..<stop:
        if !WebCssIsDigit(source[i]):
            return false
    return true

@borrows
fn WebCssParsePxLength(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if !WebCssSpanIsPxLength(source, start, stop):
        return false
    if source[start] == '0' && start == stop:
        return true
    if source[stop] == '%':
        return false
    for i in start..<stop - 1:
        out = out * 10 + int32(source[i]) - int32('0')
    return true

@borrows
fn WebCssParsePxLengthPx2(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0:
        return false
    if stop >= source.len:
        return false
    if start > stop:
        return false
    if source[start] == '0' && start == stop:
        return true
    if stop - start + 1 < 3:
        return false
    if source[stop - 1] != 'p':
        return false
    if source[stop] != 'x':
        return false
    var whole: int32
    var frac: int32
    var fracScale: int32 = 1
    var fracDigits: int32
    var seenDot: bool
    seenDot = false
    for i in start..<stop - 1:
        let ch = source[i]
        if ch == '.':
            if seenDot:
                return false
            seenDot = true
            continue
        if !WebCssIsDigit(ch):
            return false
        let digit = int32(ch) - int32('0')
        if seenDot:
            if fracDigits < 3:
                frac = frac * 10 + digit
                fracScale = fracScale * 10
                fracDigits = fracDigits + 1
        else:
            whole = whole * 10 + digit
    if seenDot && fracDigits == 0:
        return false
    out = whole * 2
    if fracDigits > 0:
        out = out + (frac * 2 + fracScale / 2) / fracScale
    return true

@borrows
fn WebCssParsePercentLength(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if !WebCssSpanIsPercentLength(source, start, stop):
        return false
    for i in start..<stop:
        out = out * 10 + int32(source[i]) - int32('0')
    return true

@borrows
fn WebCssParseIntValue(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0:
        return false
    if stop >= source.len:
        return false
    if start > stop:
        return false
    for i in start..stop:
        let ch = source[i]
        if !WebCssIsDigit(ch):
            return false
        out = out * 10 + int32(ch) - int32('0')
    return true

@borrows
fn WebCssParseUnitlessNumberScale1000(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0:
        return false
    if stop >= source.len:
        return false
    if start > stop:
        return false
    var whole: int32
    var frac: int32
    var fracScale: int32 = 1
    var fracDigits: int32
    var seenDot = false
    let count = stop - start + 1
    for offset in 0..<count:
        let ch = source[start + offset]
        if ch == '.':
            if seenDot:
                return false
            seenDot = true
            continue
        if !WebCssIsDigit(ch):
            return false
        let digit = int32(ch) - int32('0')
        if seenDot:
            if fracDigits < 3:
                frac = frac * 10 + digit
                fracScale = fracScale * 10
                fracDigits = fracDigits + 1
        else:
            whole = whole * 10 + digit
    if seenDot && fracDigits == 0:
        return false
    out = whole * 1000
    if fracDigits > 0:
        out = out + frac * 1000 / fracScale
    return out > 0

@borrows
fn WebCssParseLineHeightPx2(source: str, start: int32, stop: int32, fontSize: int32, out: var int32): bool =
    out = 0
    if WebCssParsePxLengthPx2(source, start, stop, out):
        return true
    var scaled: int32
    if !WebCssParseUnitlessNumberScale1000(source, start, stop, scaled):
        return false
    if fontSize <= 0:
        fontSize = 16
    out = (fontSize * scaled * 2 + 500) / 1000
    if out <= 0:
        out = 1
    return true
