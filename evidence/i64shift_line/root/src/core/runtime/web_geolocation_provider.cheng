// Web Geolocation Provider: FFI bridge for browser Geolocation API.
// Isolated from web_runtime.cheng to keep the core runtime pure Cheng.
// Native contract: the host returns a borrowed C string view of the position
// JSON (valid until the next call on the same thread); Cheng copies it via
// strFromCStringCopy, so no managed value crosses the C ABI boundary.
// Symbol names follow the cheng_clipboard_* convention: the Cheng import name
// IS the C symbol name (cheng_mobile_bridge.h family).

import std/system as system

importc fn cheng_geolocation_check_permissions(): int32

fn WebGeolocationCheckPermissions(): bool =
    return cheng_geolocation_check_permissions() == 0

importc fn cheng_geolocation_get_current_position(): cstring

fn WebGeolocationGetCurrentPosition(out: var str): bool =
    let raw: cstring = cheng_geolocation_get_current_position()
    if raw == nil:
        return false
    out = system.strFromCStringCopy(raw)
    return true

importc fn cheng_geolocation_request_permissions(): int32

fn WebGeolocationRequestPermissions(): bool =
    return cheng_geolocation_request_permissions() == 0
