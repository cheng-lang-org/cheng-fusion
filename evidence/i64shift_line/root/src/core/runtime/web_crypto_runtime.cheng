# GF(2^8) multiplication in AES field (x^8 + x^4 + x^3 + x + 1 = 0x11B)
fn WebCryptoGfMul(a: int32, b: int32): int32 =
    var result: int32
    var aa: int32 = a & 0xFF
    var bb: int32 = b & 0xFF
    for i in 0..<8:
        if bb & 1:
            result = result ^ aa
        let carry: int32 = aa & 0x80
        aa = (aa << 1) & 0xFF
        if carry:
            aa = aa ^ 0x1B
        bb = bb >> 1
    return result

# SubWord: apply S-box to each byte of a word
fn WebCryptoAesSubWord(w: int32): int32 =
    return (AES_SBOX[(w >> 24) & 0xFF] << 24) |
           (AES_SBOX[(w >> 16) & 0xFF] << 16) |
           (AES_SBOX[(w >> 8) & 0xFF] << 8) |
           AES_SBOX[w & 0xFF]

# RotWord: left rotate 8 bits (abcd -> bcda)
fn WebCryptoAesRotWord(w: int32): int32 =
    return (w << 8) | ((w >> 24) & 0xFF)

# AES-128 key expansion: 4 words -> 44 round key words (FIPS-197 Sec 5.2)
fn WebCryptoAesKeyExpansion(k0: int32, k1: int32, k2: int32, k3: int32, w: var int32[]): bool =
    let RCON: int32[] = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]
    setLen(w, 44)
    w[0] = k0
    w[1] = k1
    w[2] = k2
    w[3] = k3
    let n: int32 = 44
    for i in 4..<n:
        var temp: int32 = w[i - 1]
        if i % 4 == 0:
            temp = WebCryptoAesSubWord(WebCryptoAesRotWord(temp)) ^ RCON[i / 4 - 1]
        w[i] = w[i - 4] ^ temp
    return true

# Apply SubBytes to 4-word block (byte-wise S-box lookup)
fn WebCryptoAesSubBytes(block: var int32[]):
    var i: int32
    let n: int32 = 4
    while i < n:
        let w: int32 = block[i]
        block[i] = (AES_SBOX[(w >> 24) & 0xFF] << 24) |
                    (AES_SBOX[(w >> 16) & 0xFF] << 16) |
                    (AES_SBOX[(w >> 8) & 0xFF] << 8) |
                    AES_SBOX[w & 0xFF]
        i = i + 1

# Apply InvSubBytes to 4-word block (byte-wise inverse S-box lookup)
fn WebCryptoAesInvSubBytes(block: var int32[]):
    var i: int32
    let n: int32 = 4
    while i < n:
        let w: int32 = block[i]
        block[i] = (AES_INV_SBOX[(w >> 24) & 0xFF] << 24) |
                    (AES_INV_SBOX[(w >> 16) & 0xFF] << 16) |
                    (AES_INV_SBOX[(w >> 8) & 0xFF] << 8) |
                    AES_INV_SBOX[w & 0xFF]
        i = i + 1

# ShiftRows: left-rotate rows 0=no shift, 1=by 1, 2=by 2, 3=by 3
fn WebCryptoAesShiftRows(block: var int32[]):
    var b: int32[]
    setLen(b, 16)
    # Decompose 4 words to 16 bytes (column-major)
    for i in 0..<4:
        let w: int32 = block[i]
        let off: int32 = i * 4
        b[off] = (w >> 24) & 0xFF
        b[off + 1] = (w >> 16) & 0xFF
        b[off + 2] = (w >> 8) & 0xFF
        b[off + 3] = w & 0xFF
    # Reassemble with ShiftRows permutation
    block[0] = (b[0] << 24) | (b[5] << 16) | (b[10] << 8) | b[15]
    block[1] = (b[4] << 24) | (b[9] << 16) | (b[14] << 8) | b[3]
    block[2] = (b[8] << 24) | (b[13] << 16) | (b[2] << 8) | b[7]
    block[3] = (b[12] << 24) | (b[1] << 16) | (b[6] << 8) | b[11]

# InvShiftRows: right-rotate rows 0=no shift, 1=by 1, 2=by 2, 3=by 3
fn WebCryptoAesInvShiftRows(block: var int32[]):
    var b: int32[]
    setLen(b, 16)
    for i in 0..<4:
        let w: int32 = block[i]
        let off: int32 = i * 4
        b[off] = (w >> 24) & 0xFF
        b[off + 1] = (w >> 16) & 0xFF
        b[off + 2] = (w >> 8) & 0xFF
        b[off + 3] = w & 0xFF
    # Reassemble with InvShiftRows permutation
    block[0] = (b[0] << 24) | (b[13] << 16) | (b[10] << 8) | b[7]
    block[1] = (b[4] << 24) | (b[1] << 16) | (b[14] << 8) | b[11]
    block[2] = (b[8] << 24) | (b[5] << 16) | (b[2] << 8) | b[15]
    block[3] = (b[12] << 24) | (b[9] << 16) | (b[6] << 8) | b[3]

# MixColumns: GF(2^8) matrix multiplication per column (FIPS-197 Sec 5.1.3)
fn WebCryptoAesMixColumns(block: var int32[]):
    var i: int32
    let n: int32 = 4
    while i < n:
        let w: int32 = block[i]
        let a0: int32 = (w >> 24) & 0xFF
        let a1: int32 = (w >> 16) & 0xFF
        let a2: int32 = (w >> 8) & 0xFF
        let a3: int32 = w & 0xFF
        let b0: int32 = WebCryptoGfMul(2, a0) ^ WebCryptoGfMul(3, a1) ^ a2 ^ a3
        let b1: int32 = a0 ^ WebCryptoGfMul(2, a1) ^ WebCryptoGfMul(3, a2) ^ a3
        let b2: int32 = a0 ^ a1 ^ WebCryptoGfMul(2, a2) ^ WebCryptoGfMul(3, a3)
        let b3: int32 = WebCryptoGfMul(3, a0) ^ a1 ^ a2 ^ WebCryptoGfMul(2, a3)
        block[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        i = i + 1

# InvMixColumns: inverse GF(2^8) matrix multiplication (FIPS-197 Sec 5.3.3)
fn WebCryptoAesInvMixColumns(block: var int32[]):
    var i: int32
    let n: int32 = 4
    while i < n:
        let w: int32 = block[i]
        let a0: int32 = (w >> 24) & 0xFF
        let a1: int32 = (w >> 16) & 0xFF
        let a2: int32 = (w >> 8) & 0xFF
        let a3: int32 = w & 0xFF
        let b0: int32 = WebCryptoGfMul(14, a0) ^ WebCryptoGfMul(11, a1) ^ WebCryptoGfMul(13, a2) ^ WebCryptoGfMul(9, a3)
        let b1: int32 = WebCryptoGfMul(9, a0) ^ WebCryptoGfMul(14, a1) ^ WebCryptoGfMul(11, a2) ^ WebCryptoGfMul(13, a3)
        let b2: int32 = WebCryptoGfMul(13, a0) ^ WebCryptoGfMul(9, a1) ^ WebCryptoGfMul(14, a2) ^ WebCryptoGfMul(11, a3)
        let b3: int32 = WebCryptoGfMul(11, a0) ^ WebCryptoGfMul(13, a1) ^ WebCryptoGfMul(9, a2) ^ WebCryptoGfMul(14, a3)
        block[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        i = i + 1

# AddRoundKey: XOR each word with the corresponding round key word
fn WebCryptoAesAddRoundKey(block: var int32[], roundKeys: int32[], round: int32):
    let off: int32 = round * 4
    var i: int32
    let n: int32 = 4
    while i < n:
        block[i] = block[i] ^ roundKeys[off + i]
        i = i + 1

# AES-128 encrypt one 16-byte block (4 int32 words, in place)
fn WebCryptoAes128EncryptBlock(block: var int32[], roundKeys: int32[]): bool =
    # Round 0: AddRoundKey only
    WebCryptoAesAddRoundKey(block, roundKeys, 0)
    # Rounds 1..9: SubBytes -> ShiftRows -> MixColumns -> AddRoundKey
    var round: int32 = 1
    let lastRound: int32 = 10
    while round < lastRound:
        WebCryptoAesSubBytes(block)
        WebCryptoAesShiftRows(block)
        WebCryptoAesMixColumns(block)
        WebCryptoAesAddRoundKey(block, roundKeys, round)
        round = round + 1
    # Round 10: SubBytes -> ShiftRows -> AddRoundKey (no MixColumns)
    WebCryptoAesSubBytes(block)
    WebCryptoAesShiftRows(block)
    WebCryptoAesAddRoundKey(block, roundKeys, 10)
    return true

# AES-128 decrypt one 16-byte block (4 int32 words, in place)
fn WebCryptoAes128DecryptBlock(block: var int32[], roundKeys: int32[]): bool =
    # Round 10 reverse: AddRoundKey with last round key
    WebCryptoAesAddRoundKey(block, roundKeys, 10)
    # Rounds 9..1: InvShiftRows -> InvSubBytes -> AddRoundKey -> InvMixColumns
    var round: int32 = 9
    while round >= 1:
        WebCryptoAesInvShiftRows(block)
        WebCryptoAesInvSubBytes(block)
        WebCryptoAesAddRoundKey(block, roundKeys, round)
        WebCryptoAesInvMixColumns(block)
        round = round - 1
    # Round 0 reverse: InvShiftRows -> InvSubBytes -> AddRoundKey
    WebCryptoAesInvShiftRows(block)
    WebCryptoAesInvSubBytes(block)
    WebCryptoAesAddRoundKey(block, roundKeys, 0)
    return true

# ============================================================
# Key management
# ============================================================

fn WebCryptoFindKeyIndex(keyId: int32): int32 =
    let n: int32 = cryptoKeyKid.len
    for i in 0..<n:
        if cryptoKeyKid[i] == keyId:
            return i
    return -1

# ============================================================
# AES-CBC (FIPS-197)
# ============================================================

fn WebCryptoGenerateKey(algorithm: str, extractable: bool, usages: str[], outKeyId: var int32): bool =
    if algorithm != "AES-CBC":
        return false
    # Generate random 128-bit key (4 int32 = 16 bytes)
    var keyData: int32[]
    setLen(keyData, 4)
    if cheng_crypto_random_bytes(ptr(keyData), 16) != 16:
        panic("crypto random bytes failed")
    var kd0: int32 = keyData[0]
    var kd1: int32 = keyData[1]
    var kd2: int32 = keyData[2]
    var kd3: int32 = keyData[3]
    let kid = nextKeyId
    add(cryptoKeyKid, kid)
    add(cryptoKeyAlgorithm, algorithm)
    add(cryptoKeyData0, kd0)
    add(cryptoKeyData1, kd1)
    add(cryptoKeyData2, kd2)
    add(cryptoKeyData3, kd3)
    add(cryptoKeyExtractable, extractable)
    outKeyId = nextKeyId
    nextKeyId = nextKeyId + 1
    return true

fn WebCryptoImportKey(algorithm: str, keyData: int32[], extractable: bool, usages: str[], outKeyId: var int32): bool =
    if algorithm != "AES-CBC":
        return false
    if keyData.len != 4:
        return false
    var kd0: int32 = keyData[0]
    var kd1: int32 = keyData[1]
    var kd2: int32 = keyData[2]
    var kd3: int32 = keyData[3]
    let kid = nextKeyId
    add(cryptoKeyKid, kid)
    add(cryptoKeyAlgorithm, algorithm)
    add(cryptoKeyData0, kd0)
    add(cryptoKeyData1, kd1)
    add(cryptoKeyData2, kd2)
    add(cryptoKeyData3, kd3)
    add(cryptoKeyExtractable, extractable)
    outKeyId = nextKeyId
    nextKeyId = nextKeyId + 1
    return true

# AES-CBC encrypt with PKCS#7 padding
fn WebCryptoEncrypt(algorithm: str, keyId: int32, iv: int32[], data: int32[], out: var int32[]): bool =
    let keyIdx = WebCryptoFindKeyIndex(keyId)
    if keyIdx < 0:
        return false
    if cryptoKeyAlgorithm[keyIdx] != algorithm:
        return false
    if algorithm != "AES-CBC":
        return false
    # Expand key
    var roundKeys: int32[]
    let expandOk: bool = WebCryptoAesKeyExpansion(cryptoKeyData0[keyIdx], cryptoKeyData1[keyIdx], cryptoKeyData2[keyIdx], cryptoKeyData3[keyIdx], roundKeys)
    if expandOk == false:
        return false
    # PKCS#7 padding: padVal in 1..16
    let dataLen: int32 = data.len
    let padVal: int32 = 16 - (dataLen % 16)
    let paddedLen: int32 = dataLen + padVal
    setLen(out, paddedLen)
    # Copy data bytes
    for i in 0..<dataLen:
        out[i] = data[i]
    # Append PKCS#7 padding bytes
    var pi: int32 = dataLen
    while pi < paddedLen:
        out[pi] = padVal
        pi = pi + 1
    # CBC: XOR each plaintext block with previous ciphertext (or IV), then encrypt
    var prevBlock: int32[]
    setLen(prevBlock, 4)
    prevBlock[0] = iv[0]
    prevBlock[1] = iv[1]
    prevBlock[2] = iv[2]
    prevBlock[3] = iv[3]
    let numBlocks: int32 = paddedLen / 16
    var blk: int32
    while blk < numBlocks:
        let off: int32 = blk * 16
        var block: int32[]
        setLen(block, 4)
        # Pack 16 bytes to 4 int32 (big-endian)
        for i in 0..<4:
            let boff: int32 = off + i * 4
            block[i] = (out[boff] << 24) | (out[boff + 1] << 16) | (out[boff + 2] << 8) | out[boff + 3]
        # XOR with previous ciphertext (or IV for first block)
        for i in 0..<4:
            block[i] = block[i] ^ prevBlock[i]
        # AES-128 encrypt block
        let encOk: bool = WebCryptoAes128EncryptBlock(block, roundKeys)
        if encOk == false:
            return false
        # Unpack 4 int32 to 16 bytes (big-endian) and update prevBlock
        for i in 0..<4:
            let boff: int32 = off + i * 4
            let w: int32 = block[i]
            out[boff] = (w >> 24) & 0xFF
            out[boff + 1] = (w >> 16) & 0xFF
            out[boff + 2] = (w >> 8) & 0xFF
            out[boff + 3] = w & 0xFF
            prevBlock[i] = block[i]
        blk = blk + 1
    return true

# AES-CBC decrypt with PKCS#7 unpadding
fn WebCryptoDecrypt(algorithm: str, keyId: int32, iv: int32[], data: int32[], out: var int32[]): bool =
    let keyIdx = WebCryptoFindKeyIndex(keyId)
    if keyIdx < 0:
        return false
    if cryptoKeyAlgorithm[keyIdx] != algorithm:
        return false
    if algorithm != "AES-CBC":
        return false
    # Data length must be positive multiple of 16
    let dataLen: int32 = data.len
    if dataLen == 0:
        return false
    if dataLen % 16 != 0:
        return false
    # Expand key
    var roundKeys: int32[]
    let expandOk: bool = WebCryptoAesKeyExpansion(cryptoKeyData0[keyIdx], cryptoKeyData1[keyIdx], cryptoKeyData2[keyIdx], cryptoKeyData3[keyIdx], roundKeys)
    if expandOk == false:
        return false
    # Allocate output
    setLen(out, dataLen)
    # Initialize previous block with IV
    var prevBlock: int32[]
    setLen(prevBlock, 4)
    prevBlock[0] = iv[0]
    prevBlock[1] = iv[1]
    prevBlock[2] = iv[2]
    prevBlock[3] = iv[3]
    let numBlocks: int32 = dataLen / 16
    var blk: int32
    while blk < numBlocks:
        let off: int32 = blk * 16
        var block: int32[]
        setLen(block, 4)
        # Pack 16 bytes to 4 int32 (big-endian)
        for i in 0..<4:
            let boff: int32 = off + i * 4
            block[i] = (data[boff] << 24) | (data[boff + 1] << 16) | (data[boff + 2] << 8) | data[boff + 3]
        # Save current ciphertext before decryption (for next prevBlock)
        var nextPrev: int32[]
        setLen(nextPrev, 4)
        nextPrev[0] = block[0]
        nextPrev[1] = block[1]
        nextPrev[2] = block[2]
        nextPrev[3] = block[3]
        # AES-128 decrypt block
        let decOk: bool = WebCryptoAes128DecryptBlock(block, roundKeys)
        if decOk == false:
            return false
        # XOR with previous ciphertext block (or IV)
        for i in 0..<4:
            block[i] = block[i] ^ prevBlock[i]
        # Unpack 4 int32 to 16 bytes (big-endian)
        for i in 0..<4:
            let boff: int32 = off + i * 4
            let w: int32 = block[i]
            out[boff] = (w >> 24) & 0xFF
            out[boff + 1] = (w >> 16) & 0xFF
            out[boff + 2] = (w >> 8) & 0xFF
            out[boff + 3] = w & 0xFF
        # Update prevBlock
        prevBlock[0] = nextPrev[0]
        prevBlock[1] = nextPrev[1]
        prevBlock[2] = nextPrev[2]
        prevBlock[3] = nextPrev[3]
        blk = blk + 1
    # Remove PKCS#7 padding: last byte is the pad value
    let padVal: int32 = out[dataLen - 1]
    if padVal < 1:
        return false
    if padVal > 16:
        return false
    let unpaddedLen: int32 = dataLen - padVal
    # Verify all padding bytes equal padVal
    var pk: int32 = unpaddedLen
    while pk < dataLen:
        if out[pk] != padVal:
            return false
        pk = pk + 1
    setLen(out, unpaddedLen)
    return true

# ============================================================
# Random values
# ============================================================

fn WebCryptoGetRandomValues(length: int32, out: var int32[]): bool =
    if length <= 0:
        return false
    setLen(out, length)
    let byteCount = length * 4
    if cheng_crypto_random_bytes(ptr(out), byteCount) != byteCount:
        panic("crypto random bytes failed")
    return true
