# web_crypto_runtime.cheng
# Web Cryptography API runtime implementation.
# SHA-256: FIPS 180-4, pure computation (no FFI).
# AES-128-CBC: FIPS-197, pure computation (no FFI).
# Random values: FFI to cheng_crypto_random_bytes.

import std/seqs

importc fn cheng_crypto_random_bytes(buf: ptr, len: int32): int32

# ============================================================
# Types
# ============================================================

# ============================================================
# Global key table (flat primitive arrays, no struct with str fields)
# ============================================================

var cryptoKeyKid: int32[]
var cryptoKeyAlgorithm: str[]
var cryptoKeyData0: int32[]
var cryptoKeyData1: int32[]
var cryptoKeyData2: int32[]
var cryptoKeyData3: int32[]
var cryptoKeyExtractable: bool[]
var nextKeyId: int32 = 1

# ============================================================
# Bitwise helpers (uint32-correct on signed int32)
# ============================================================

# Right rotate. Mask clears sign-extended bits from ASR.
fn ror32(x: int32, n: int32): int32 =
    if n == 0: return x
    let mask: int32 = (1 << (32 - n)) - 1
    return ((x >> n) & mask) | (x << (32 - n))

# Logical (zero-extending) right shift.
fn shr32(x: int32, n: int32): int32 =
    if n == 0: return x
    let mask: int32 = (1 << (32 - n)) - 1
    return (x >> n) & mask

# ============================================================
# SHA-256 (FIPS 180-4)
# ============================================================

# Ch(x, y, z) = (x & y) ^ (~x & z)
fn sha256Ch(x: int32, y: int32, z: int32): int32 =
    return (x & y) ^ ((x ^ -1) & z)

# Maj(x, y, z) = (x & y) ^ (x & z) ^ (y & z)
fn sha256Maj(x: int32, y: int32, z: int32): int32 =
    return (x & y) ^ (x & z) ^ (y & z)

# Sigma0(x) = ROTR(x,2) ^ ROTR(x,13) ^ ROTR(x,22)
fn sha256Sig0(x: int32): int32 =
    return ror32(x, 2) ^ ror32(x, 13) ^ ror32(x, 22)

# Sigma1(x) = ROTR(x,6) ^ ROTR(x,11) ^ ROTR(x,25)
fn sha256Sig1(x: int32): int32 =
    return ror32(x, 6) ^ ror32(x, 11) ^ ror32(x, 25)

# sigma0(x) = ROTR(x,7) ^ ROTR(x,18) ^ SHR(x,3)
fn sha256sig0(x: int32): int32 =
    return ror32(x, 7) ^ ror32(x, 18) ^ shr32(x, 3)

# sigma1(x) = ROTR(x,17) ^ ROTR(x,19) ^ SHR(x,10)
fn sha256sig1(x: int32): int32 =
    return ror32(x, 17) ^ ror32(x, 19) ^ shr32(x, 10)

fn WebCryptoDigestSHA256(data: int32[], out: var int32[]): bool =
    # K constants: first 32 bits of fractional parts of cube roots of first 64 primes
    let K: int32[] = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
                      0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
                      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
                      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
                      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
                      0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
                      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
                      0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
                      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
                      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
                      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
                      0xc192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
                      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
                      0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
                      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
                      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

    # Initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
    var state: int32[]
    setLen(state, 8)
    state[0] = 0x6a09e667
    state[1] = 0xbb67ae85
    state[2] = 0x3c6ef372
    state[3] = 0xa54ff53a
    state[4] = 0x510e527f
    state[5] = 0x9b05688c
    state[6] = 0x1f83d9ab
    state[7] = 0x5be0cd19

    # Padding: append 0x80, zeros, then 64-bit big-endian bit length.
    # padLen is smallest multiple of 64 >= origLen + 1 + 8
    let origLen: int32 = data.len
    let padLen: int32 = ((origLen + 72) / 64) * 64

    var padded: int32[]
    setLen(padded, padLen)

    # Copy original data bytes
    for i in 0..<origLen:
        padded[i] = data[i]

    # Append 0x80
    padded[origLen] = 0x80

    # Zero-pad between origLen+1 and padLen-9 (inclusive)
    var zi: int32 = origLen + 1
    while zi < padLen - 8:
        padded[zi] = 0
        zi += 1

    # 64-bit bit length in big-endian
    let bitLenLo: int32 = origLen * 8
    let bitLenHi: int32 = origLen >> 29

    padded[padLen - 8] = (bitLenHi >> 24) & 0xFF
    padded[padLen - 7] = (bitLenHi >> 16) & 0xFF
    padded[padLen - 6] = (bitLenHi >> 8) & 0xFF
    padded[padLen - 5] = bitLenHi & 0xFF
    padded[padLen - 4] = (bitLenLo >> 24) & 0xFF
    padded[padLen - 3] = (bitLenLo >> 16) & 0xFF
    padded[padLen - 2] = (bitLenLo >> 8) & 0xFF
    padded[padLen - 1] = bitLenLo & 0xFF

    # Message schedule array (reused across blocks)
    var W: int32[]
    setLen(W, 64)

    var blockStart: int32
    while blockStart < padLen:
        # Load W[0..15] from block (big-endian)
        for i in 0..<16:
            let idx: int32 = blockStart + i * 4
            W[i] = (padded[idx] << 24) | (padded[idx + 1] << 16) | (padded[idx + 2] << 8) | padded[idx + 3]

        # Extend W[16..63]
        for i in 16..<64:
            W[i] = sha256sig1(W[i - 2]) + W[i - 7] + sha256sig0(W[i - 15]) + W[i - 16]

        # Initialize working variables
        var a: int32 = state[0]
        var b: int32 = state[1]
        var c: int32 = state[2]
        var d: int32 = state[3]
        var e: int32 = state[4]
        var f: int32 = state[5]
        var g: int32 = state[6]
        var h: int32 = state[7]

        # 64 compression rounds
        for i in 0..<64:
            let T1: int32 = h + sha256Sig1(e) + sha256Ch(e, f, g) + K[i] + W[i]
            let T2: int32 = sha256Sig0(a) + sha256Maj(a, b, c)
            h = g
            g = f
            f = e
            e = d + T1
            d = c
            c = b
            b = a
            a = T1 + T2

        # Update state
        state[0] = state[0] + a
        state[1] = state[1] + b
        state[2] = state[2] + c
        state[3] = state[3] + d
        state[4] = state[4] + e
        state[5] = state[5] + f
        state[6] = state[6] + g
        state[7] = state[7] + h

        blockStart = blockStart + 64

    # Output: h0..h7 as 32 big-endian bytes
    setLen(out, 32)
    for i in 0..<8:
        let val: int32 = state[i]
        let off: int32 = i * 4
        out[off] = (val >> 24) & 0xFF
        out[off + 1] = (val >> 16) & 0xFF
        out[off + 2] = (val >> 8) & 0xFF
        out[off + 3] = val & 0xFF
    return true

fn WebCryptoSubtleDigest(algorithm: str, data: int32[], out: var int32[]): bool =
    if algorithm == "SHA-256":
        return WebCryptoDigestSHA256(data, out)
    return false

