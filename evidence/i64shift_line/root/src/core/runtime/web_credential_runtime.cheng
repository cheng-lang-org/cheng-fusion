# web_credential_runtime.cheng
# Credential Management API for Cheng Web runtime.
# Provides: WebCredential type and WebCredentials* functions

type
    WebCredential =
        credentialId: int32
        kind: str       # "password"/"federated"/"public-key"
        id: str         # user identifier
        name: str       # display name
        data: str       # extra data (JSON)

# ============================================================
# Global state
# ============================================================

var credentials: WebCredential[]
var nextCredentialId: int32 = 1

# ============================================================
# Internal helpers
# ============================================================

fn WebCredentialsFindIndex(credentialId: int32): int32 =
    for i in 0..<credentials.len:
        if credentials[i].credentialId == credentialId:
            return i
    return -1

# ============================================================
# WebCredentialsStore: Store a credential
# ============================================================

fn WebCredentialsStore(credential: var WebCredential): bool =
    let credId = nextCredentialId
    nextCredentialId = nextCredentialId + 1
    credential.credentialId = credId
    add(credentials, credential)
    return true

# ============================================================
# WebCredentialsGet: Get credential by options
# Simplified: return first stored credential if any
# ============================================================

fn WebCredentialsGet(options: str, out: var WebCredential): bool =
    if credentials.len <= 0:
        return false
    out = credentials[0]
    return true

# ============================================================
# WebCredentialsPreventSilentAccess: Prevent silent access
# ============================================================

fn WebCredentialsPreventSilentAccess(): bool =
    return true

# ============================================================
# WebCredentialsCreate: Create a new credential
# Simplified: creates a password credential with default values
# ============================================================

fn WebCredentialsCreate(options: str, out: var WebCredential): bool =
    let credId = nextCredentialId
    nextCredentialId = nextCredentialId + 1
    var cred: WebCredential
    cred.credentialId = credId
    cred.kind = "password"
    cred.id = "user"
    cred.name = "User"
    cred.data = "{}"
    add(credentials, cred)
    out = cred
    return true

# ============================================================
# WebCredentialsAutoSignIn: Attempt auto sign-in
# ============================================================

fn WebCredentialsAutoSignIn(): bool =
    return false
