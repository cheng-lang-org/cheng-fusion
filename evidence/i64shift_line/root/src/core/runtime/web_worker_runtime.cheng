# web_worker_runtime.cheng
# Web Worker API for Cheng Web runtime.
# Provides: WebWorker type and WebWorker* functions

type
    WebWorker =
        workerId: int32
        scriptUrl: str
        state: int32       # 0=running, 1=terminated
        onmessage: int32   # callbackFnId
        onerror: int32
        messageQueue: str[]

const
    WebWorkerRunning = 0
    WebWorkerTerminated = 1

var workerTable: WebWorker[]
var nextWorkerId: int32 = 1

fn WebWorkerFindIndex(workerId: int32): int32 =
    for i in 0..<workerTable.len:
        if workerTable[i].workerId == workerId:
            return i
    return -1

fn WebWorkerCreate(scriptUrl: str, onmessage: int32, onerror: int32): int32 =
    let workerId = nextWorkerId
    nextWorkerId = nextWorkerId + 1
    var worker: WebWorker
    worker.workerId = workerId
    worker.scriptUrl = scriptUrl
    worker.state = WebWorkerRunning
    worker.onmessage = onmessage
    worker.onerror = onerror
    worker.messageQueue = []
    add(workerTable, worker)
    return workerId

fn WebWorkerPostMessage(workerId: int32, message: str): bool =
    let index = WebWorkerFindIndex(workerId)
    if index < 0:
        return false
    var worker = workerTable[index]
    if worker.state != WebWorkerRunning:
        return false
    add(worker.messageQueue, message)
    workerTable[index] = worker
    return true

fn WebWorkerFlushMessages(workerId: int32, out: var str[]): bool =
    let index = WebWorkerFindIndex(workerId)
    if index < 0:
        return false
    var worker = workerTable[index]
    out = worker.messageQueue
    worker.messageQueue = []
    workerTable[index] = worker
    return true

fn WebWorkerTerminate(workerId: int32): bool =
    let index = WebWorkerFindIndex(workerId)
    if index < 0:
        return false
    workerTable[index].state = WebWorkerTerminated
    return true

fn WebWorkerGetState(workerId: int32): int32 =
    let index = WebWorkerFindIndex(workerId)
    if index < 0:
        return -1
    return workerTable[index].state
