import std/system

@importc("cheng_tcp_loopback_payload_bridge")
fn cheng_tcp_loopback_payload_bridge_raw(protocolText: cstring, payloadWire: cstring): uint64
@importc("cheng_tcp_loopback_request_response_bridge")
fn cheng_tcp_loopback_request_response_bridge_raw(protocolText: cstring, requestWire: cstring, responseWire: cstring): uint64
@importc("cheng_tcp_loopback_request_response_handle_bridge")
fn cheng_tcp_loopback_request_response_handle_bridge_raw(protocolText: cstring, requestHandle: uint64, responseHandle: uint64): uint64
@importc("cheng_tcp_serve_payload_once_bridge")
fn cheng_tcp_serve_payload_once_bridge_raw(hostText: cstring, port: int32, protocolText: cstring, payloadWire: cstring, readyPath: cstring): int32
@importc("cheng_tcp_serve_payload_window_bridge")
fn cheng_tcp_serve_payload_window_bridge_raw(hostText: cstring, port: int32, protocolText: cstring, payloadWire: cstring, readyPath: cstring, maxServeCount: int32, waitMs: int32): int32
@importc("cheng_tcp_recv_payload_once_bridge")
fn cheng_tcp_recv_payload_once_bridge_raw(hostText: cstring, port: int32, protocolText: cstring): uint64
@importc("cheng_tcp_request_response_bridge")
fn cheng_tcp_request_response_bridge_raw(hostText: cstring, port: int32, protocolText: cstring, requestWire: cstring): uint64
@importc("cheng_tcp_serve_request_capture_once_bridge")
fn cheng_tcp_serve_request_capture_once_bridge_raw(hostText: cstring, port: int32, protocolText: cstring, responseWire: cstring, readyPath: cstring): uint64
@importc("cheng_tcp_serve_request_capture_window_bridge")
fn cheng_tcp_serve_request_capture_window_bridge_raw(hostText: cstring, port: int32, protocolText: cstring, responseWire: cstring, readyPath: cstring, maxCaptureCount: int32, waitMs: int32): uint64
@importc("cheng_buffer_handle_len_bridge")
fn cheng_buffer_handle_len_bridge(handle: uint64): int32
@importc("cheng_buffer_handle_byte_bridge")
fn cheng_buffer_handle_byte_bridge(handle: uint64, idx: int32): int32
@importc("cheng_buffer_handle_release_bridge")
fn cheng_buffer_handle_release_bridge(handle: uint64): int32
@importc("cheng_buffer_handle_from_raw_bridge")
fn cheng_buffer_handle_from_raw_bridge(data: ptr, n: int32): uint64
@importc("cheng_tcp_last_error_handle_bridge")
fn cheng_tcp_last_error_handle_bridge(): uint64

fn cheng_tcp_loopback_payload_bridge(protocolText: str, payloadWire: str): uint64 =
    return cheng_tcp_loopback_payload_bridge_raw(system.StrToCStringTemp(protocolText),
                                                 system.StrToCStringTemp(payloadWire))

fn cheng_tcp_loopback_request_response_bridge(protocolText: str,
                                               requestWire: str,
                                               responseWire: str): uint64 =
    return cheng_tcp_loopback_request_response_bridge_raw(system.StrToCStringTemp(protocolText),
                                                          system.StrToCStringTemp(requestWire),
                                                          system.StrToCStringTemp(responseWire))

fn cheng_tcp_loopback_request_response_handle_bridge(protocolText: str,
                                                      requestHandle: uint64,
                                                      responseHandle: uint64): uint64 =
    return cheng_tcp_loopback_request_response_handle_bridge_raw(system.StrToCStringTemp(protocolText),
                                                                 requestHandle,
                                                                 responseHandle)

fn cheng_tcp_serve_payload_once_bridge(hostText: str,
                                        port: int32,
                                        protocolText: str,
                                        payloadWire: str,
                                        readyPath: str): int32 =
    return cheng_tcp_serve_payload_once_bridge_raw(system.StrToCStringTemp(hostText),
                                                   port,
                                                   system.StrToCStringTemp(protocolText),
                                                   system.StrToCStringTemp(payloadWire),
                                                   system.StrToCStringTemp(readyPath))

fn cheng_tcp_serve_payload_window_bridge(hostText: str,
                                          port: int32,
                                          protocolText: str,
                                          payloadWire: str,
                                          readyPath: str,
                                          maxServeCount: int32,
                                          waitMs: int32): int32 =
    return cheng_tcp_serve_payload_window_bridge_raw(system.StrToCStringTemp(hostText),
                                                     port,
                                                     system.StrToCStringTemp(protocolText),
                                                     system.StrToCStringTemp(payloadWire),
                                                     system.StrToCStringTemp(readyPath),
                                                     maxServeCount,
                                                     waitMs)

fn cheng_tcp_recv_payload_once_bridge(hostText: str,
                                       port: int32,
                                       protocolText: str): uint64 =
    return cheng_tcp_recv_payload_once_bridge_raw(system.StrToCStringTemp(hostText),
                                                  port,
                                                  system.StrToCStringTemp(protocolText))

fn cheng_tcp_request_response_bridge(hostText: str,
                                      port: int32,
                                      protocolText: str,
                                      requestWire: str): uint64 =
    return cheng_tcp_request_response_bridge_raw(system.StrToCStringTemp(hostText),
                                                 port,
                                                 system.StrToCStringTemp(protocolText),
                                                 system.StrToCStringTemp(requestWire))

fn cheng_tcp_serve_request_capture_once_bridge(hostText: str,
                                                port: int32,
                                                protocolText: str,
                                                responseWire: str,
                                                readyPath: str): uint64 =
    return cheng_tcp_serve_request_capture_once_bridge_raw(system.StrToCStringTemp(hostText),
                                                           port,
                                                           system.StrToCStringTemp(protocolText),
                                                           system.StrToCStringTemp(responseWire),
                                                           system.StrToCStringTemp(readyPath))

fn cheng_tcp_serve_request_capture_window_bridge(hostText: str,
                                                  port: int32,
                                                  protocolText: str,
                                                  responseWire: str,
                                                  readyPath: str,
                                                  maxCaptureCount: int32,
                                                  waitMs: int32): uint64 =
    return cheng_tcp_serve_request_capture_window_bridge_raw(system.StrToCStringTemp(hostText),
                                                             port,
                                                             system.StrToCStringTemp(protocolText),
                                                             system.StrToCStringTemp(responseWire),
                                                             system.StrToCStringTemp(readyPath),
                                                             maxCaptureCount,
                                                             waitMs)
