@exportc("cheng_native_terminal_darwin_kqueue_note_exit_wait_bridge")
@abi_internal
fn cheng_native_terminal_darwin_kqueue_note_exit_wait_bridge_export(
        childPid: int32): int32 =
    if childPid <= 0:
        return 0
    let queueFd = libc_kqueue_native()
    if queueFd < 0:
        return 0
    let childIdent: uint64 = childPid
    var change: ChengDarwinTerminalKevent
    change.ident = childIdent
    change.filter = chengDarwinEvfiltProc
    change.flags = chengDarwinEvAddOneshot
    change.fflags = chengDarwinNoteExit
    var event: ChengDarwinTerminalKevent
    let eventCount = libc_kevent_native(
        queueFd,
        ptr(&change),
        1,
        ptr(&event),
        1,
        nil)
    let closeQueue = libc_close_native(queueFd)
    if eventCount != 1 || closeQueue != 0 ||
       event.ident != childIdent ||
       event.filter != chengDarwinEvfiltProc ||
       (event.flags & chengDarwinEvError) != chengDarwinZeroU16 ||
       (event.fflags & chengDarwinNoteExit) == chengDarwinZeroU32:
        return 0
    return 1

@exportc("cheng_native_terminal_child_birth_capture_bridge")
@abi_internal
fn cheng_native_terminal_child_birth_capture_bridge_export(
        childPid: int32,
        pidfd: int32,
        outPlatform: ptr,
        outBirth0: ptr,
        outBirth1: ptr): int32 =
    if childPid <= 0 || pidfd != -1 || outPlatform == nil ||
       outBirth0 == nil || outBirth1 == nil:
        return 0
    var info: ChengDarwinProcBsdinfoBuffer
    cheng_bytes_set(ptr(&info), 0, 136)
    let copied = libc_proc_pidinfo(
        childPid, 3, uint64(0), ptr(&info), 136)
    if copied != 136:
        return 0
    let observedStatus = *(UInt32Ptr(cheng_ptr_plus(ptr(&info), 4)))
    let observedPid = *(Int32Ptr(cheng_ptr_plus(ptr(&info), 12)))
    let startSec = *(UInt64Ptr(cheng_ptr_plus(ptr(&info), 120)))
    let startUsec = *(UInt64Ptr(cheng_ptr_plus(ptr(&info), 128)))
    if observedStatus < uint32(1) || observedStatus > uint32(4) ||
       observedPid != childPid || startSec == uint64(0) ||
       startUsec >= uint64(1000000):
        return 0
    *(Int32Ptr(outPlatform)) = 1
    *(UInt64Ptr(outBirth0)) = startSec
    *(UInt64Ptr(outBirth1)) = startUsec
    return 1

fn cheng_darwin_terminal_watch_close_queue_once(row: int32): bool =
    if row < 0 || row >= chengDarwinTerminalDecisionWatchRowCount:
        return false
    let statePtr = ptr(
        &chengDarwinTerminalDecisionWatchQueueCloseStates[row])
    let closeState = cheng_darwin_atomic_load_i32(statePtr)
    if closeState == chengDarwinTerminalFdCloseNotPresent:
        return true
    if closeState == chengDarwinTerminalFdCloseClosedClean ||
       closeState == chengDarwinTerminalFdCloseClosedError ||
       closeState == chengDarwinTerminalFdCloseInvalidEbafd:
        return closeState == chengDarwinTerminalFdCloseClosedClean
    let queueFd = chengDarwinTerminalDecisionWatchQueueFds[row]
    if closeState != chengDarwinTerminalFdCloseOpen || queueFd < 0 ||
       cheng_darwin_atomic_cas_i32(
           statePtr,
           chengDarwinTerminalFdCloseOpen,
           chengDarwinTerminalFdCloseClosing) != 1:
        return false
    let closeReceipt =
        cheng_native_terminal_fd_close_once_bridge_export(queueFd)
    let terminalState = closeReceipt == 1 ?
        chengDarwinTerminalFdCloseClosedClean :
        (closeReceipt == 2 ? chengDarwinTerminalFdCloseClosedError :
            chengDarwinTerminalFdCloseInvalidEbafd)
    chengDarwinTerminalDecisionWatchQueueFds[row] = -1
    chengDarwinTerminalDecisionWatchQueueCloseReceipts[row] = closeReceipt
    cheng_darwin_atomic_store_i32(statePtr, terminalState)
    return terminalState == chengDarwinTerminalFdCloseClosedClean

fn cheng_darwin_terminal_watch_close_decision_once(row: int32): bool =
    if row < 0 || row >= chengDarwinTerminalDecisionWatchRowCount:
        return false
    let statePtr = ptr(
        &chengDarwinTerminalDecisionWatchDecisionCloseStates[row])
    let closeState = cheng_darwin_atomic_load_i32(statePtr)
    if closeState == chengDarwinTerminalFdCloseNotPresent:
        return true
    if closeState == chengDarwinTerminalFdCloseClosedClean ||
       closeState == chengDarwinTerminalFdCloseClosedError ||
       closeState == chengDarwinTerminalFdCloseInvalidEbafd:
        return closeState == chengDarwinTerminalFdCloseClosedClean
    let decisionFd = chengDarwinTerminalDecisionWatchDecisionFds[row]
    if closeState != chengDarwinTerminalFdCloseOpen || decisionFd < 0 ||
       cheng_darwin_atomic_cas_i32(
           statePtr,
           chengDarwinTerminalFdCloseOpen,
           chengDarwinTerminalFdCloseClosing) != 1:
        return false
    let closeReceipt =
        cheng_native_terminal_fd_close_once_bridge_export(decisionFd)
    let terminalState = closeReceipt == 1 ?
        chengDarwinTerminalFdCloseClosedClean :
        (closeReceipt == 2 ? chengDarwinTerminalFdCloseClosedError :
            chengDarwinTerminalFdCloseInvalidEbafd)
    chengDarwinTerminalDecisionWatchDecisionFds[row] = -1
    chengDarwinTerminalDecisionWatchDecisionCloseReceipts[row] = closeReceipt
    cheng_darwin_atomic_store_i32(statePtr, terminalState)
    return terminalState == chengDarwinTerminalFdCloseClosedClean

fn cheng_darwin_terminal_watch_failed_owner(
        row: int32,
        queueFd: int32): int32 =
    let queueClosed = cheng_darwin_terminal_watch_close_queue_once(row)
    let decisionClosed =
        cheng_darwin_terminal_watch_close_decision_once(row)
    chengDarwinTerminalDecisionWatchDecisionFds[row] = -1
    chengDarwinTerminalDecisionWatchSocketFds[row] = -1
    chengDarwinTerminalDecisionWatchChildPids[row] = -1
    chengDarwinTerminalDecisionWatchDevices[row] = uint64(0)
    chengDarwinTerminalDecisionWatchInodes[row] = uint64(0)
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchStates[row]),
        chengDarwinTerminalDecisionWatchFailed)
    return queueClosed && decisionClosed ? -1 : row + 1

# Arm EVFILT_VNODE for the exact terminal inode and, when present,
# EVFILT_READ for the authenticated SEQPACKET channel. fstat before/after
# proves the watched vnode did not change during registration.
fn cheng_darwin_terminal_watch_arm(
        decisionReaderFd: int32,
        socketFd: int32,
        childPid: int32): int32 =
    if decisionReaderFd < 0 || socketFd < -1 || childPid < -1 ||
       (socketFd >= 0 && decisionReaderFd == socketFd):
        return -1
    # One append-only row per arm. This atomic fetch-add is shared by live and
    # restart paths; terminal rows are never rebound to another kqueue.
    let row = cheng_darwin_atomic_fetch_add_i32(
        ptr(&chengDarwinTerminalDecisionWatchNextRow), 1)
    if row < 0 || row >= chengDarwinTerminalDecisionWatchRowCount:
        return -1
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchStates[row]),
        chengDarwinTerminalDecisionWatchOpening)
    chengDarwinTerminalDecisionWatchQueueFds[row] = -1
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchQueueCloseStates[row]),
        chengDarwinTerminalFdCloseNotPresent)
    chengDarwinTerminalDecisionWatchQueueCloseReceipts[row] = 0
    chengDarwinTerminalDecisionWatchDecisionFds[row] = -1
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchDecisionCloseStates[row]),
        chengDarwinTerminalFdCloseNotPresent)
    chengDarwinTerminalDecisionWatchDecisionCloseReceipts[row] = 0
    chengDarwinTerminalDecisionWatchSocketFds[row] = -1
    chengDarwinTerminalDecisionWatchChildPids[row] = -1
    chengDarwinTerminalDecisionWatchDevices[row] = uint64(0)
    chengDarwinTerminalDecisionWatchInodes[row] = uint64(0)
    let watchedDecisionFd = libc_fcntl_native(
        decisionReaderFd, chengDarwinFDupFdCloexec, 0)
    if watchedDecisionFd < 0:
        return cheng_darwin_terminal_watch_failed_owner(row, -1)
    chengDarwinTerminalDecisionWatchDecisionFds[row] = watchedDecisionFd
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchDecisionCloseStates[row]),
        chengDarwinTerminalFdCloseOpen)
    var sizeBefore: int64
    var modeBefore: int32
    var deviceBefore: uint64
    var inodeBefore: uint64
    var sizeAfter: int64
    var modeAfter: int32
    var deviceAfter: uint64
    var inodeAfter: uint64
    if libc_fstat_scalars_runtime(
           watchedDecisionFd,
           ptr(&sizeBefore),
           ptr(&modeBefore),
           ptr(&deviceBefore),
           ptr(&inodeBefore)) != 0 ||
       deviceBefore == uint64(0) || inodeBefore == uint64(0):
        return cheng_darwin_terminal_watch_failed_owner(row, -1)
    let queueFd = libc_kqueue_native()
    if queueFd < 0:
        return cheng_darwin_terminal_watch_failed_owner(row, -1)
    chengDarwinTerminalDecisionWatchQueueFds[row] = queueFd
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchQueueCloseStates[row]),
        chengDarwinTerminalFdCloseOpen)
    var changes: ChengDarwinTerminalKevent[3]
    changes[0].ident = uint64(watchedDecisionFd)
    changes[0].filter = chengDarwinEvfiltVnode
    changes[0].flags = chengDarwinEvAddEnableClear
    changes[0].fflags =
        chengDarwinNoteDelete | chengDarwinNoteWrite |
        chengDarwinNoteExtend | chengDarwinNoteAttrib |
        chengDarwinNoteLink | chengDarwinNoteRename |
        chengDarwinNoteRevoke | chengDarwinNoteFunlock
    var changeCount: int32 = 1
    if socketFd >= 0:
        changes[1].ident = uint64(socketFd)
        changes[1].filter = chengDarwinEvfiltRead
        changes[1].flags = chengDarwinEvAddEnableClear
        changes[1].fflags = uint32(0)
        changeCount = 2
    if childPid > 0:
        changes[changeCount].ident = uint64(childPid)
        changes[changeCount].filter = chengDarwinEvfiltProc
        changes[changeCount].flags = chengDarwinEvAddEnableClear
        changes[changeCount].fflags = chengDarwinNoteExit
        changeCount = changeCount + 1
    let registered = libc_kevent_native(
        queueFd,
        ptr(&changes),
        changeCount,
        nil,
        0,
        nil) == 0 &&
        libc_fstat_scalars_runtime(
            watchedDecisionFd,
            ptr(&sizeAfter),
            ptr(&modeAfter),
            ptr(&deviceAfter),
            ptr(&inodeAfter)) == 0 &&
        sizeAfter == sizeBefore && modeAfter == modeBefore &&
        deviceAfter == deviceBefore && inodeAfter == inodeBefore
    if !registered:
        return cheng_darwin_terminal_watch_failed_owner(row, queueFd)
    chengDarwinTerminalDecisionWatchQueueFds[row] = queueFd
    chengDarwinTerminalDecisionWatchDecisionFds[row] = watchedDecisionFd
    chengDarwinTerminalDecisionWatchSocketFds[row] = socketFd
    chengDarwinTerminalDecisionWatchChildPids[row] = childPid
    chengDarwinTerminalDecisionWatchDevices[row] = deviceBefore
    chengDarwinTerminalDecisionWatchInodes[row] = inodeBefore
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchStates[row]),
        chengDarwinTerminalDecisionWatchIssued)
    return row + 1

@exportc("cheng_native_terminal_decision_watch_arm_bridge")
@abi_internal
fn cheng_native_terminal_decision_watch_arm_bridge_export(
        decisionReaderFd: int32,
        socketFd: int32): int32 =
    if socketFd < 0:
        return -1
    return cheng_darwin_terminal_watch_arm(
        decisionReaderFd, socketFd, -1)

@exportc("cheng_native_terminal_finished_watch_arm_bridge")
@abi_internal
fn cheng_native_terminal_finished_watch_arm_bridge_export(
