        flag = 1
    return libc_setsockopt_native(fd, 6, 1, &flag, 4)

@exportc("cheng_fd_wait_readable_bridge")
fn cheng_fd_wait_readable_bridge_export(fd: int32, timeoutMs: int32): int32 =
    if fd < 0:
        return -9
    var pollRaw: uint64
    let pollFd: ptr = &pollRaw
    cheng_darwin_pollfd_write(pollFd, fd, 1)
    let rc: int32 = libc_poll_native(pollFd, uint64(1), timeoutMs)
    let revents: int32 = cheng_darwin_pollfd_revents(pollFd)
    if rc < 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        if err > 0:
            return 0 - err
        return -1
    if rc == 0 || revents == 0:
        return 0
    return 1

