        let childStart: int32 = cheng_darwin_mp4_child_start(boxType, offset, boxSize)
        if childStart >= 0:
            if childStart > boxEnd:
                return 0
            let found: int32 = cheng_darwin_mp4_scan_avcc(data,
                                                          dataLen,
                                                          childStart,
                                                          boxEnd,
                                                          depth + 1,
                                                          avcCOffsetOut,
                                                          avcCSizeOut)
            if found != 0:
                return 1
        offset = boxEnd
    if offset != endOffset:
        return 0
    return 0

fn cheng_darwin_mp4_scan_video_stbl(data: ptr,
                                    dataLen: int32,
                                    start: int32,
                                    endOffset: int32): int32 =
    if data == nil:
        return 0
    if start < 0 || endOffset < start || endOffset > dataLen:
        return 0
    var avcCOffset: int32 = -1
    var avcCSize: int32
    var firstSampleSize: int32 = -1
    var firstChunkOffset: int32 = -1
    var offset: int32 = start
    while offset + 8 <= endOffset:
        let boxSize: int32 = cheng_load_i32_be_from_base(data, offset)
        if boxSize == 1:
            chengDarwinMediaLastErrorCode = 401
            return 0
        if boxSize < 8:
            chengDarwinMediaLastErrorCode = 402
            return 0
        let boxEnd: int32 = offset + boxSize
        if boxEnd > endOffset:
            chengDarwinMediaLastErrorCode = 403
            return 0
        let boxType: int32 = cheng_load_i32_be_from_base(data, offset + 4)
        if boxType == 1937011556:
            let foundAvcC: int32 = cheng_darwin_mp4_scan_avcc(data,
                                                              dataLen,
                                                              offset + 16,
                                                              boxEnd,
                                                              0,
                                                              &avcCOffset,
                                                              &avcCSize)
            if foundAvcC != 0:
                avcCOffset = chengDarwinMediaDecodeAvcCOffset
                avcCSize = chengDarwinMediaDecodeAvcCSize
        elif boxType == 1937011578:
            if boxSize < 20:
                chengDarwinMediaLastErrorCode = 404
                return 0
            let sampleSize: int32 = cheng_load_i32_be_from_base(data, offset + 12)
            let sampleCount: int32 = cheng_load_i32_be_from_base(data, offset + 16)
            if sampleCount <= 0:
                chengDarwinMediaLastErrorCode = 405
                return 0
            if sampleSize > 0:
                firstSampleSize = sampleSize
            else:
                if offset + 24 > boxEnd:
                    chengDarwinMediaLastErrorCode = 406
                    return 0
                firstSampleSize = cheng_load_i32_be_from_base(data, offset + 20)
        elif boxType == 1937007471:
            if boxSize < 20:
                chengDarwinMediaLastErrorCode = 407
                return 0
            let chunkCount: int32 = cheng_load_i32_be_from_base(data, offset + 12)
            if chunkCount <= 0:
                chengDarwinMediaLastErrorCode = 408
                return 0
            firstChunkOffset = cheng_load_i32_be_from_base(data, offset + 16)
        elif boxType == 1668232756:
            if boxSize < 24:
                chengDarwinMediaLastErrorCode = 409
                return 0
            let chunkCount64: int32 = cheng_load_i32_be_from_base(data, offset + 12)
            if chunkCount64 <= 0:
                chengDarwinMediaLastErrorCode = 410
                return 0
            let high: int32 = cheng_load_i32_be_from_base(data, offset + 16)
            let low: int32 = cheng_load_i32_be_from_base(data, offset + 20)
            if high != 0 || low <= 0:
                chengDarwinMediaLastErrorCode = 411
                return 0
            firstChunkOffset = low
        offset = boxEnd
    if offset != endOffset:
        chengDarwinMediaLastErrorCode = 412
        return 0
    if avcCOffset < 0 || avcCSize <= 16:
        return 0
    if firstSampleSize <= 0:
        chengDarwinMediaLastErrorCode = 413
        return 0
    if firstChunkOffset <= 0:
        chengDarwinMediaLastErrorCode = 414
        return 0
    chengDarwinMediaDecodeAvcCOffset = avcCOffset
    chengDarwinMediaDecodeAvcCSize = avcCSize
    chengDarwinMediaDecodeSampleOffset = firstChunkOffset
    chengDarwinMediaDecodeSampleSize = firstSampleSize
    return 1

fn cheng_darwin_mp4_scan_video_sample_table(data: ptr,
                                            dataLen: int32,
                                            start: int32,
                                            endOffset: int32,
                                            depth: int32): int32 =
    if data == nil:
        return 0
    if depth > 8:
        return 0
    if start < 0 || endOffset < start || endOffset > dataLen:
        return 0
    var offset: int32 = start
    while offset + 8 <= endOffset:
        let boxSize: int32 = cheng_load_i32_be_from_base(data, offset)
        if boxSize == 1:
            chengDarwinMediaLastErrorCode = 421
            return 0
        if boxSize < 8:
            chengDarwinMediaLastErrorCode = 422
            return 0
        let boxEnd: int32 = offset + boxSize
        if boxEnd > endOffset:
            chengDarwinMediaLastErrorCode = 423
            return 0
        let boxType: int32 = cheng_load_i32_be_from_base(data, offset + 4)
        if boxType == 1937007212:
            if cheng_darwin_mp4_scan_video_stbl(data, dataLen, offset + 8, boxEnd) != 0:
                return 1
        let childStart: int32 = cheng_darwin_mp4_child_start(boxType, offset, boxSize)
        if childStart >= 0:
            if childStart > boxEnd:
                chengDarwinMediaLastErrorCode = 424
                return 0
            let found: int32 = cheng_darwin_mp4_scan_video_sample_table(data,
                                                                        dataLen,
                                                                        childStart,
                                                                        boxEnd,
                                                                        depth + 1)
            if found != 0:
                return 1
        offset = boxEnd
    if offset != endOffset:
        chengDarwinMediaLastErrorCode = 425
        return 0
    return 0

fn cheng_darwin_mp4_find_top_box(data: ptr,
                                 dataLen: int32,
                                 targetType: int32,
                                 offsetOut: ptr,
                                 sizeOut: ptr): int32 =
    if data == nil || offsetOut == nil || sizeOut == nil:
        return 0
    var offset: int32
    while offset + 8 <= dataLen:
        let boxSize: int32 = cheng_load_i32_be_from_base(data, offset)
        if boxSize == 1:
            return 0
        if boxSize < 8:
            return 0
        let boxEnd: int32 = offset + boxSize
        if boxEnd > dataLen:
            return 0
        let boxType: int32 = cheng_load_i32_be_from_base(data, offset + 4)
        if boxType == targetType:
            *(Int32Ptr(offsetOut)) = offset
            *(Int32Ptr(sizeOut)) = boxSize
            return 1
        offset = boxEnd
    if offset != dataLen:
        return 0
    return 0

fn cheng_darwin_cm_time(value: int64, timescale: int32, flags: uint32): ChengDarwinCMTime =
    var out: ChengDarwinCMTime
    out.value = value
    out.timescale = timescale
    out.flags = flags
    out.epoch = int64(0)
    return out

fn cheng_darwin_decode_ctx_set_i32(ctx: ptr, offset: int32, value: int32) =
    if ctx == nil:
        return
    *(Int32Ptr(cheng_ptr_plus(ctx, offset))) = value

fn cheng_darwin_decode_ctx_get_i32(ctx: ptr, offset: int32): int32 =
    if ctx == nil:
