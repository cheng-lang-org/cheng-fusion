    if fontSize <= 0:
        return 0
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveLastCommandKind != chengGuiDrawCommandText:
        return 0
    chengGuiDrawListActiveTextFontSize = fontSize
    return 1

@exportc("cheng_drawlist_last_command_kind")
fn cheng_drawlist_last_command_kind_export(listId: int32): int32 =
    if !cheng_drawlist_active_ready(listId):
        return chengGuiDrawCommandNone
    return chengGuiDrawListActiveLastCommandKind

@exportc("cheng_drawlist_rect_count")
fn cheng_drawlist_rect_count_export(listId: int32): int32 =
    if !cheng_drawlist_active_ready(listId):
        return 0
    return chengGuiDrawListActiveRectCount

@exportc("cheng_drawlist_border_count")
fn cheng_drawlist_border_count_export(listId: int32): int32 =
    if !cheng_drawlist_active_ready(listId):
        return 0
    return chengGuiDrawListActiveBorderCount

@exportc("cheng_drawlist_text_count")
fn cheng_drawlist_text_count_export(listId: int32): int32 =
    if !cheng_drawlist_active_ready(listId):
        return 0
    return chengGuiDrawListActiveTextCount

@exportc("cheng_drawlist_push_texture_handle_parts")
fn cheng_drawlist_push_texture_handle_parts_export(listId: int32,
                                                   textureHandleHi: int32,
                                                   textureHandleLo: int32): int32 =
    if textureHandleHi == 0 && textureHandleLo == 0:
        return 0
    if cheng_drawlist_begin_active_command(listId, chengGuiDrawCommandTexture) == 0:
        return 0
    let hi = uint64(textureHandleHi) & uint64(4294967295)
    let lo = uint64(textureHandleLo) & uint64(4294967295)
    chengGuiDrawListActiveTextureHandle = (hi << uint64(32)) | lo
    chengGuiDrawListActiveTextureX = 0
    chengGuiDrawListActiveTextureY = 0
    chengGuiDrawListActiveTextureDrawWidth = 0
    chengGuiDrawListActiveTextureDrawHeight = 0
