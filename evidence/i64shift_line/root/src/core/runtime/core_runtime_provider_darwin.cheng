        return 0
    if fs.fBsize == uint32(0):
        return 0
    let out: int64 = cheng_u64_mul_checked(fs.fBavail, uint64(fs.fBsize))
    return out

@exportc("cheng_native_system_os_name_value_bridge")
fn cheng_native_system_os_name_value_bridge_export(): cstring =
    # struct utsname on Darwin: 5 char[256] fields: sysname, nodename, release,
    # version, machine. sysname is field 0.
    let buf: ptr = cheng_runtime_malloc(1280)
    if buf == nil:
        return ""
    if libc_uname(buf) != 0:
        cheng_runtime_free(buf)
        return ""
    let out: ptr = cheng_string_copy(buf, cheng_cstrlen_raw(buf))
    cheng_runtime_free(buf)
    return cstring(out)

# Scalar host admission for the Darwin production held-exec layer.  Raw
# utsname storage and pointer arithmetic remain inside this target provider;
# Cheng callers receive only 1 (exact Darwin/arm64) or 0 (fail closed).
@exportc("cheng_native_production_held_exec_darwin_arm64_host_bridge")
@abi_internal
fn cheng_native_production_held_exec_darwin_arm64_host_bridge_export():
        int32 =
    let buf: ptr = cheng_runtime_malloc(1280)
    if buf == nil:
        return 0
    cheng_bytes_set(buf, 0, 1280)
    if libc_uname(buf) != 0:
        cheng_runtime_free(buf)
        return 0
    let sysnameOk = cheng_darwin_cstring_equal_exact(
        buf, "Darwin", 6)
    let machineOk = cheng_darwin_cstring_equal_exact(
        cheng_ptr_plus(buf, 1024), "arm64", 5)
    cheng_runtime_free(buf)
    return (sysnameOk && machineOk) ? 1 : 0

@exportc("cheng_native_system_os_release_value_bridge")
fn cheng_native_system_os_release_value_bridge_export(): cstring =
    # release is the 3rd utsname field: offset = sysname(256) + nodename(256) = 512.
    let buf: ptr = cheng_runtime_malloc(1280)
    if buf == nil:
        return ""
    if libc_uname(buf) != 0:
        cheng_runtime_free(buf)
        return ""
    let releasePtr: ptr = cheng_ptr_plus(buf, 512)
    let out: ptr = cheng_string_copy(releasePtr, cheng_cstrlen_raw(releasePtr))
    cheng_runtime_free(buf)
    return cstring(out)

fn cheng_gui_reset_handle(id: int32) =
    if id <= 0 || id >= chengGuiMaxHandles:
        return
    chengGuiHandleKind[id] = chengGuiKindNone
    chengGuiHandleWidth[id] = 0
    chengGuiHandleHeight[id] = 0
    chengGuiDrawListCapacity[id] = 0
    chengGuiDrawListCount[id] = 0
    if id == chengGuiDrawListActiveHandle:
        chengGuiDrawListActiveHandle = 0
        chengGuiDrawListActiveCapacity = 0
        chengGuiDrawListActiveCount = 0
        chengGuiDrawListActiveLastCommandKind = chengGuiDrawCommandNone
        chengGuiDrawListActiveRectCount = 0
        chengGuiDrawListActiveBorderCount = 0
        chengGuiDrawListActiveTextCount = 0
        chengGuiDrawListActiveCommandX = 0
        chengGuiDrawListActiveCommandY = 0
        chengGuiDrawListActiveCommandWidth = 0
        chengGuiDrawListActiveCommandHeight = 0
        chengGuiDrawListActiveCommandR = 0
        chengGuiDrawListActiveCommandG = 0
        chengGuiDrawListActiveCommandB = 0
        chengGuiDrawListActiveCommandA = 0
        chengGuiDrawListActiveBorderWidth = 0
        chengGuiDrawListActiveBorderRadius = 0
        chengGuiDrawListActiveTextLen = 0
        chengGuiDrawListActiveTextFontSize = 0
        chengGuiDrawListActiveTextureCount = 0
        chengGuiDrawListActiveTextureHandle = uint64(0)
        chengGuiDrawListActiveTextureX = 0
        chengGuiDrawListActiveTextureY = 0
        chengGuiDrawListActiveTextureDrawWidth = 0
        chengGuiDrawListActiveTextureDrawHeight = 0
        chengGuiDrawListActiveTextureWidth = 0
        chengGuiDrawListActiveTextureHeight = 0
        chengGuiDrawListActiveTexturePixelFormat = 0

fn cheng_gui_handle_valid(id: int32, kind: int32): bool =
    if id <= 0 || id >= chengGuiMaxHandles:
        return false
    if chengGuiHandleKind[id] == kind:
        return true
    return false

fn cheng_gui_view_valid(id: int32): bool =
    if id <= 0 || id >= chengGuiMaxHandles:
        return false
    let kind = chengGuiHandleKind[id]
    if kind == chengGuiKindLabel:
        return true
    if kind == chengGuiKindCanvas:
        return true
    if kind == chengGuiKindButton:
        return true
    if kind == chengGuiKindDrawListCanvas:
        return true
    return false

fn cheng_gui_alloc_handle(kind: int32): int32 =
    if chengGuiNextHandle <= 0 || chengGuiNextHandle >= chengGuiMaxHandles:
        chengGuiNextHandle = 1
    let id: int32 = chengGuiNextHandle
    if id <= 0 || id >= chengGuiMaxHandles:
        return 0
    chengGuiNextHandle = chengGuiNextHandle + 1
    cheng_gui_reset_handle(id)
    chengGuiHandleKind[id] = kind
    return id

fn cheng_gui_push_event(kind: int32,
                        x: int32,
                        y: int32,
                        key: int32,
                        width: int32,
                        height: int32) =
    if chengGuiEventCount >= chengGuiMaxEvents:
        return
    let idx: int32 = chengGuiEventWrite
    chengGuiEventType[idx] = kind
    chengGuiEventX[idx] = x
    chengGuiEventY[idx] = y
    chengGuiEventKey[idx] = key
    chengGuiEventWidth[idx] = width
    chengGuiEventHeight[idx] = height
    chengGuiEventWrite = (chengGuiEventWrite + 1) % chengGuiMaxEvents
    chengGuiEventCount = chengGuiEventCount + 1

fn cheng_gui_write_cstring(raw: ptr) =
    if raw == nil:
        return
    let n: int32 = cheng_cstrlen_raw(raw)
    if n > 0:
        let _ = libc_write(1, raw, n)
    var newline: uint8[1]
    newline[0] = uint8(10)
    let _nl = libc_write(1, &newline[0], 1)

fn cheng_drawlist_clear_active_command_state() =
    chengGuiDrawListActiveLastCommandKind = chengGuiDrawCommandNone
    chengGuiDrawListActiveRectCount = 0
    chengGuiDrawListActiveBorderCount = 0
    chengGuiDrawListActiveTextCount = 0
    chengGuiDrawListActiveCommandX = 0
    chengGuiDrawListActiveCommandY = 0
    chengGuiDrawListActiveCommandWidth = 0
    chengGuiDrawListActiveCommandHeight = 0
    chengGuiDrawListActiveCommandR = 0
    chengGuiDrawListActiveCommandG = 0
    chengGuiDrawListActiveCommandB = 0
    chengGuiDrawListActiveCommandA = 0
    chengGuiDrawListActiveBorderWidth = 0
    chengGuiDrawListActiveBorderRadius = 0
    chengGuiDrawListActiveTextLen = 0
    chengGuiDrawListActiveTextFontSize = 0

fn cheng_drawlist_clear_active_texture_state() =
    chengGuiDrawListActiveTextureCount = 0
    chengGuiDrawListActiveTextureHandle = uint64(0)
    chengGuiDrawListActiveTextureX = 0
    chengGuiDrawListActiveTextureY = 0
    chengGuiDrawListActiveTextureDrawWidth = 0
    chengGuiDrawListActiveTextureDrawHeight = 0
    chengGuiDrawListActiveTextureWidth = 0
    chengGuiDrawListActiveTextureHeight = 0
    chengGuiDrawListActiveTexturePixelFormat = 0

fn cheng_drawlist_clear_last_command_fields() =
    chengGuiDrawListActiveCommandX = 0
    chengGuiDrawListActiveCommandY = 0
    chengGuiDrawListActiveCommandWidth = 0
    chengGuiDrawListActiveCommandHeight = 0
    chengGuiDrawListActiveCommandR = 0
    chengGuiDrawListActiveCommandG = 0
    chengGuiDrawListActiveCommandB = 0
    chengGuiDrawListActiveCommandA = 0
    chengGuiDrawListActiveBorderWidth = 0
    chengGuiDrawListActiveBorderRadius = 0
    chengGuiDrawListActiveTextLen = 0
    chengGuiDrawListActiveTextFontSize = 0

fn cheng_drawlist_active_ready(listId: int32): bool =
    if listId <= 0:
        return false
    if listId != chengGuiDrawListActiveHandle:
        return false
    if chengGuiDrawListActiveCapacity <= 0:
        return false
    return true

fn cheng_drawlist_begin_active_command(listId: int32, kind: int32): int32 =
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveCount >= chengGuiDrawListActiveCapacity:
        return 0
    chengGuiDrawListActiveCount = chengGuiDrawListActiveCount + 1
    chengGuiDrawListCount[listId] = chengGuiDrawListActiveCount
    chengGuiDrawListActiveLastCommandKind = kind
    cheng_drawlist_clear_last_command_fields()
    if kind == chengGuiDrawCommandRect:
        chengGuiDrawListActiveRectCount = chengGuiDrawListActiveRectCount + 1
    elif kind == chengGuiDrawCommandBorder:
        chengGuiDrawListActiveBorderCount = chengGuiDrawListActiveBorderCount + 1
    elif kind == chengGuiDrawCommandText:
        chengGuiDrawListActiveTextCount = chengGuiDrawListActiveTextCount + 1
    elif kind == chengGuiDrawCommandTexture:
        chengGuiDrawListActiveTextureCount = chengGuiDrawListActiveTextureCount + 1
    else:
        return 0
    return 1

fn cheng_drawlist_valid_color_component(value: int32): bool =
    if value < 0:
        return false
    if value > 255:
        return false
    return true

@exportc("cheng_app_init")
fn cheng_app_init_export() =
    if chengGuiNextHandle <= 0:
        chengGuiNextHandle = 1

@exportc("cheng_app_run")
fn cheng_app_run_export() =
    return

@exportc("cheng_app_terminate")
fn cheng_app_terminate_export() =
    cheng_gui_push_event(chengGuiEventQuit, 0, 0, 0, 0, 0)

@exportc("cheng_app_run_frame")
fn cheng_app_run_frame_export() =
    return

@exportc("cheng_sleep_ms")
fn cheng_sleep_ms_export(ms: int32) =
    if ms <= 0:
        return
    var safeMs: int32 = ms
    if safeMs > 2147483:
        safeMs = 2147483
    let _ = libc_usleep_native(uint32(safeMs * 1000))

@exportc("cheng_log")
fn cheng_log_export(msg: ptr) =
    cheng_gui_write_cstring(msg)

@exportc("cheng_window_create")
fn cheng_window_create_export(title: ptr, width: int32, height: int32): int32 =
    let _ = title
    if width <= 0 || height <= 0:
        return 0
    let id: int32 = cheng_gui_alloc_handle(chengGuiKindWindow)
    if id <= 0:
        return 0
    chengGuiHandleWidth[id] = width
    chengGuiHandleHeight[id] = height
    return id

