fn cheng_inference_metal_paged_attention_i32_page_buffers_window_run(queryBufferHandle: uint64,
                                                                     keyPageBufferHandles: ptr,
                                                                     valuePageBufferHandles: ptr,
                                                                     pageTableBufferHandle: uint64,
