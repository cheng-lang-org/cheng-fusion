                                                                     &session)
    if sessionStatus != 0:
        cheng_cf_release(sampleBuffer)
        cheng_cf_release(blockBuffer)
        cheng_cf_release(formatDescription)
        libc_dispatch_release(doneSemaphore)
        cheng_runtime_free(callbackRecordRaw)
        cheng_runtime_free(paramPtrs)
        cheng_runtime_free(paramSizes)
        cheng_runtime_free(sampleSizes)
        cheng_runtime_free(sampleCopy)
        cheng_darwin_decode_set_i32(statusOut, sessionStatus)
        return 0
    let decodeStatus: int32 = cheng_vt_decompression_session_decode_frame(session,
                                                                          sampleBuffer,
                                                                          uint32(0),
                                                                          nil,
                                                                          &infoFlags)
    var callbackWaitStatus: int64 = -1
    if decodeStatus == 0:
        cheng_vt_decompression_session_finish_delayed_frames(session)
        cheng_vt_decompression_session_wait_for_asynchronous_frames(session)
        # hoist: 嵌套 uint64(大字面量) 实参撞 call-arg 复杂表达式 poison (bail=8548)
        let dispatchWaitForever = uint64(18446744073709551615)
        callbackWaitStatus = libc_dispatch_semaphore_wait(doneSemaphore, dispatchWaitForever)
    cheng_vt_decompression_session_invalidate(session)
    cheng_cf_release(session)
    cheng_cf_release(sampleBuffer)
    cheng_cf_release(blockBuffer)
    cheng_cf_release(formatDescription)
    libc_dispatch_release(doneSemaphore)
    cheng_runtime_free(callbackRecordRaw)
    cheng_runtime_free(paramPtrs)
    cheng_runtime_free(paramSizes)
    cheng_runtime_free(sampleSizes)
    cheng_runtime_free(sampleCopy)
    if decodeStatus != 0:
        cheng_darwin_decode_set_i32(statusOut, decodeStatus)
        return 0
    if callbackWaitStatus != int64(0):
        cheng_darwin_decode_set_i32(statusOut, -120)
        cheng_darwin_decode_set_i32(infoFlagsOut, infoFlags)
        return 0
    let ctxReady: int32 = cheng_darwin_decode_ctx_get_i32(ctxPtr, chengDarwinDecodeCtxReadyOffset)
    let ctxImageBuffer: ptr = cheng_darwin_decode_ctx_get_ptr(ctxPtr, chengDarwinDecodeCtxImageBufferOffset)
    if ctxReady == 0 || ctxImageBuffer == nil:
        cheng_darwin_decode_set_i32(statusOut,
                                    cheng_darwin_decode_ctx_get_i32(ctxPtr,
                                                                    chengDarwinDecodeCtxStatusOffset))
        cheng_darwin_decode_set_i32(infoFlagsOut,
                                    cheng_darwin_decode_ctx_get_i32(ctxPtr,
                                                                        chengDarwinDecodeCtxInfoFlagsOffset))
        return 0
    let decodedWidth = cheng_darwin_decode_ctx_get_i32(ctxPtr,
                                                       chengDarwinDecodeCtxWidthOffset)
    let decodedHeight = cheng_darwin_decode_ctx_get_i32(ctxPtr,
                                                        chengDarwinDecodeCtxHeightOffset)
    let decodedPixelFormat = cheng_darwin_decode_ctx_get_i32(ctxPtr,
                                                             chengDarwinDecodeCtxPixelFormatOffset)
    let textureOk = cheng_darwin_decode_create_metal_texture(ctxImageBuffer,
                                                             decodedWidth,
                                                             decodedHeight,
                                                             decodedPixelFormat,
                                                             textureHandleOut,
                                                             statusOut)
    if textureOk == 0:
        cheng_darwin_decode_set_i32(infoFlagsOut, infoFlags)
        return 0
    cheng_darwin_decode_set_i32(widthOut, decodedWidth)
    cheng_darwin_decode_set_i32(heightOut, decodedHeight)
    cheng_darwin_decode_set_i32(pixelFormatOut, decodedPixelFormat)
    cheng_darwin_decode_set_u64(pixelBufferHandleOut, uint64(ctxImageBuffer))
    cheng_darwin_decode_set_i32(bytesReadyOut, sampleLen)
    cheng_darwin_decode_set_i32(statusOut,
                                cheng_darwin_decode_ctx_get_i32(ctxPtr,
                                                                chengDarwinDecodeCtxStatusOffset))
    cheng_darwin_decode_set_i32(infoFlagsOut, infoFlags)
    return 1

@exportc("cheng_media_darwin_provider_probe_bridge")
fn cheng_media_darwin_provider_probe_bridge_export(): int32 =
    chengDarwinMediaLastErrorCode = 0
    var mask: int32
    let videoToolbox: int32 = cheng_darwin_media_probe_symbol(
        "/System/Library/Frameworks/VideoToolbox.framework/VideoToolbox",
        "VTDecompressionSessionCreate",
        chengDarwinMediaCapabilityVideoToolbox,
        10,
        11)
    if videoToolbox != 0:
        mask = mask + videoToolbox
    let coreVideo: int32 = cheng_darwin_media_probe_symbol(
        "/System/Library/Frameworks/CoreVideo.framework/CoreVideo",
        "CVPixelBufferGetWidth",
        chengDarwinMediaCapabilityCoreVideo,
        20,
        21)
    if coreVideo != 0:
        mask = mask + coreVideo
    let metal: int32 = cheng_darwin_media_probe_symbol(
        "/System/Library/Frameworks/Metal.framework/Metal",
        "MTLCreateSystemDefaultDevice",
        chengDarwinMediaCapabilityMetal,
        30,
        31)
    if metal != 0:
        mask = mask + metal
    let quartzCore: int32 = cheng_darwin_media_probe_symbol(
        "/System/Library/Frameworks/QuartzCore.framework/QuartzCore",
        "OBJC_CLASS_$_CAMetalLayer",
        chengDarwinMediaCapabilityQuartzCore,
        40,
        41)
    if quartzCore != 0:
        mask = mask + quartzCore
    return mask

