fn cheng_darwin_thread_entry(raw: ptr): ptr =
    if raw == nil:
        return nil
    let task: ChengDarwinThreadTaskPtr = ChengDarwinThreadTaskPtr(raw)
    let fnPtr: ptr = task->fnPtr
    let ctx: ptr = task->ctx
    cheng_runtime_free(raw)
    if fnPtr != nil:
        cheng_darwin_call_indirect_void(fnPtr, ctx)
    return nil

@exportc("cheng_darwin_thread_spawn")
fn cheng_darwin_thread_spawn_export(fnPtr: ptr, ctx: ptr): int32 =
    if fnPtr == nil:
        return 0
    let mem: ptr = cheng_runtime_malloc(int32(sizeof(ChengDarwinThreadTask)))
    if mem == nil:
        return 0
    let task: ChengDarwinThreadTaskPtr = ChengDarwinThreadTaskPtr(mem)
    task->fnPtr = fnPtr
    task->ctx = ctx
    var thread: ptr
    let rc = cheng_darwin_pthread_create(ptr(&thread), nil, &cheng_darwin_thread_entry, mem)
    if rc != 0:
        cheng_runtime_free(mem)
        return 0
    if cheng_darwin_pthread_detach(thread) != 0:
        cheng_runtime_free(mem)
        return 0
    return 1

# --- QUIC transport recursive lock bridge (darwin exe form) ---
#
# dual-role（同进程 serve+client 并发）要求 msquic native 桥的全局 cur-slot /
# policy cache / conn impl 表对两线程互斥。语义：
#   - os_unfair_lock 只做 guard，guard 内仅读写 owner/depth 两个词，无等待；
#   - owner == pthread_self → 递归计深（span 嵌套合法）；
#   - 竞争失败 → 出 guard 后 usleep(50us) 退避重试（等待绝不发生在 guard 内，
#     也绝不发生在线程持有的传输 span 内，无饥饿死锁）。
var
    chengDarwinQuicTransportLockWord: int32
    chengDarwinQuicTransportOwner: int64
    chengDarwinQuicTransportDepth: int32

@importc("pthread_self")
fn cheng_darwin_quic_transport_pthread_self(): ptr

@exportc("cheng_native_quic_transport_lock_bridge")
@abi_internal
fn cheng_native_quic_transport_lock_bridge_export() =
    let guardAddress = ptr(&chengDarwinQuicTransportLockWord)
    let selfTag = uint64(cheng_darwin_quic_transport_pthread_self())
    while true:
        libc_os_unfair_lock_lock(guardAddress)
        if chengDarwinQuicTransportOwner == int64(selfTag):
            chengDarwinQuicTransportDepth = chengDarwinQuicTransportDepth + 1
            libc_os_unfair_lock_unlock(guardAddress)
            return
        if chengDarwinQuicTransportOwner == 0:
            chengDarwinQuicTransportOwner = int64(selfTag)
            chengDarwinQuicTransportDepth = 1
            libc_os_unfair_lock_unlock(guardAddress)
            return
        libc_os_unfair_lock_unlock(guardAddress)
        let _ = libc_usleep_native(uint32(50))

@exportc("cheng_native_quic_transport_unlock_bridge")
@abi_internal
fn cheng_native_quic_transport_unlock_bridge_export() =
    let guardAddress = ptr(&chengDarwinQuicTransportLockWord)
    let selfTag = uint64(cheng_darwin_quic_transport_pthread_self())
    libc_os_unfair_lock_lock(guardAddress)
    if chengDarwinQuicTransportOwner == int64(selfTag):
        chengDarwinQuicTransportDepth = chengDarwinQuicTransportDepth - 1
        if chengDarwinQuicTransportDepth <= 0:
            chengDarwinQuicTransportOwner = 0
            chengDarwinQuicTransportDepth = 0
    libc_os_unfair_lock_unlock(guardAddress)
