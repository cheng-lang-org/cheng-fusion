fn cheng_darwin_mp4_child_start(boxType: int32, offset: int32, boxSize: int32): int32 =
    if boxType == 1836019574:
        return offset + 8
    if boxType == 1953653099:
        return offset + 8
    if boxType == 1835297121:
        return offset + 8
    if boxType == 1835626086:
        return offset + 8
    if boxType == 1937007212:
        return offset + 8
    if boxType == 1937011556:
        return offset + 16
    if boxType == 1635148593:
        return offset + 86
    return -1

fn cheng_darwin_mp4_scan_avcc(data: ptr,
                              dataLen: int32,
                              start: int32,
                              endOffset: int32,
                              depth: int32,
                              avcCOffsetOut: ptr,
                              avcCSizeOut: ptr): int32 =
    if data == nil || avcCOffsetOut == nil || avcCSizeOut == nil:
        return 0
    if depth > 8:
