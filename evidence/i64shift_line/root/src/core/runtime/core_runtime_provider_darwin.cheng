# Close terminal descriptors exactly once. __close_nocancel removes the
# pthread-cancellation edge; EBADF is the only result proving the descriptor
# was not consumed. Other errors are consumed-but-not-clean receipts and the
# numeric fd must never be retried.
@exportc("cheng_native_terminal_fd_close_once_bridge")
@abi_internal
fn cheng_native_terminal_fd_close_once_bridge_export(fd: int32): int32 =
    if fd < 0:
        return 1
    if libc_close_nocancel_native(fd) == 0:
        return 1
    let raw: ptr = libc_errno_ptr()
    let ep: Int32Ptr = Int32Ptr(raw)
    if ep != nil && *ep == 9:
        return 0
    return 2

