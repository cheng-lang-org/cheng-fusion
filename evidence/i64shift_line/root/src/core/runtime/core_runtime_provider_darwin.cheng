@exportc("cheng_fd_set_nonblocking_bridge")
fn cheng_fd_set_nonblocking_bridge_export(fd: int32, enabled: int32): int32 =
    if fd < 0:
        return -1
    let flags: int32 = libc_fcntl_native(fd, 3, 0)
    if flags < 0:
        return -1
    let nonblockFlag: int32 = 4
    let nonblockClearMask: int32 = -5
    if enabled != 0:
        let setFlags: int32 = flags | nonblockFlag
        let setOut: int32 = libc_fcntl_native(fd, 4, setFlags)
        return setOut
    let nextFlags: int32 = flags & nonblockClearMask
    let out: int32 = libc_fcntl_native(fd, 4, nextFlags)
    return out

