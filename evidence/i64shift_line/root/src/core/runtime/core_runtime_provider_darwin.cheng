    if elapsed <= int64(0) || outBufferHandle == uint64(0):
        if outBufferHandle != uint64(0):
            cheng_inference_metal_release(ptr(outBufferHandle))
        return uint64(0)
    let outputHash = cheng_inference_metal_hash_i32_tensor_1d(out, valueDim, outputScale)
    if outputHash <= int64(0):
        cheng_inference_metal_release(ptr(outBufferHandle))
        return uint64(0)
    let receiptHandle = cheng_inference_metal_launch_receipt_new(elapsed, outBufferHandle, outputHash)
    if receiptHandle == uint64(0):
        cheng_inference_metal_release(ptr(outBufferHandle))
        return uint64(0)
    return receiptHandle

fn cheng_inference_metal_read_u64_handle(raw: ptr, index: int32): uint64 =
    return *(UInt64Ptr(cheng_ptr_plus(raw, index * 8)))

fn cheng_inference_metal_window_page_handle(pageBufferHandles: ptr,
                                            index: int32,
                                            windowPageCount: int32): uint64 =
    if pageBufferHandles == nil || windowPageCount <= 0:
        return uint64(0)
    if index < windowPageCount:
        return cheng_inference_metal_read_u64_handle(pageBufferHandles, index)
    return cheng_inference_metal_read_u64_handle(pageBufferHandles, 0)

# #M-batch root fix: this kernel's `source`/`functionName` are byte-identical
# on every call site that reaches this function (single caller,
# cheng_inference_metal_paged_attention_i32_page_buffers_window_run, always
# passes the same literal MSL string) -- yet the pre-existing code called
# newLibraryWithSource:options:error: (a full MSL compile-from-source) plus
# newComputePipelineStateWithFunction:error: on EVERY paged-attention window
# launch, i.e. once per query head per token in the #155r-mgqa per-head GQA
# loop (src/inference/model_executor.cheng's `for qh in
# 0..<graph.attentionHeads`). Compiling identical MSL text repeatedly is the
# dominant redundant cost behind "each head separate launch" -- not the
# command buffer/encoder/dispatch/commit/wait cycle itself (dispatch is a
# single GPU thread per launch; see the `if (gid > 0) return;` guard in the
# kernel body). newCommandQueue/newLibraryWithSource/newFunctionWithName/
# newComputePipelineStateWithFunction all return +1-owned (non-autoreleased)
# objects per Cocoa's alloc/new/copy/mutableCopy convention, so caching them
# process-lifetime in module globals and never releasing them is safe and
# needs no extra retain/pool bookkeeping. Device/queue/library/pipeline
# identity is cached; per-call state (params bytes, output buffer, command
# buffer, encoder) is unchanged and still built fresh every launch. Kernel
# MSL text and GPU dispatch/compute semantics are untouched -- bit-exact
# with the pre-cache code path by construction (same compiled pipeline
# object executes the same instructions either way).
# NOTE: cached as one ChengMetalPagedWindowDirectCache struct global per
# kernel slot, not a bare top-level `var: ptr` scalar global -- verified by
# minimal repro that a bare top-level scalar `ptr` global's value is
# corrupted (truncated) when read back via `let x: ptr = gBareGlobal` from a
# different function than the one that wrote it, while the identical
# write/read pattern through a struct field (`gBox.p`) round-trips
# correctly. Pre-existing cheng_cold codegen gap unrelated to this change;
# routed around with the working construct rather than touching the
# compiler (out of scope here).
#
# Two independent cache slots, not one: this launch helper is shared by TWO
# distinct MSL kernels -- pass1 "cheng_paged_attention_i32_page_window_direct"
# (slot 0) and the cross-window online-softmax merge's pass2
# "cheng_paged_attention_i32_page_window_pass2" (slot 1) -- interleaved once
# per query head (pass1 then pass2) in the #155-wide protocol. A single
# cache keyed only on "already built" (not on which kernel) was verified by
# direct repro to silently reuse pass1's compiled pipeline for pass2's
# dispatch -- same launch machinery, wrong compiled code, no crash (Metal
# happily runs a valid but mismatched pipeline against pass2's differently
# laid out output buffer) -- corrupting every pass2 result after the first
# pass1 call. Keying on the caller-supplied kernelSlot constant keeps each
# kernel's compiled pipeline permanently separate with zero string compares.
var gPagedWindowDirectCache: ChengMetalPagedWindowDirectCache = ChengMetalPagedWindowDirectCache(device: nil, queue: nil, library: nil, functionObj: nil, pipeline: nil)
var gPagedWindowPass2Cache: ChengMetalPagedWindowDirectCache = ChengMetalPagedWindowDirectCache(device: nil, queue: nil, library: nil, functionObj: nil, pipeline: nil)

fn cheng_inference_metal_paged_window_direct_ensure_pipeline(source: str, functionName: str, kernelSlot: int32): int32 =
    if kernelSlot == 0:
        if gPagedWindowDirectCache.pipeline != nil:
            return 1
    else:
        if gPagedWindowPass2Cache.pipeline != nil:
            return 1
    var pool: ptr = cheng_objc_autorelease_pool_push()
    let device: ptr = cheng_mtl_create_system_default_device()
    if device == nil:
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return 0
    let selNewQueue: ptr = cheng_sel_register_name("newCommandQueue")
    let queue: ptr = cheng_objc_msg_send0(device, selNewQueue)
    if queue == nil:
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return 0
    let sourceString: ptr = cheng_inference_metal_nsstring(source.data)
    if sourceString == nil:
        cheng_inference_metal_release(queue)
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return 0
    var errorObj: ptr
    let selNewLibrary: ptr = cheng_sel_register_name("newLibraryWithSource:options:error:")
    let library: ptr = cheng_objc_msg_send_ptr_ptr_ptr(device, selNewLibrary, sourceString, nil, ptr(&errorObj))
    if library == nil:
        cheng_inference_metal_release(queue)
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return 0
    let nameString: ptr = cheng_inference_metal_nsstring(functionName.data)
    if nameString == nil:
        cheng_inference_metal_release(library)
        cheng_inference_metal_release(queue)
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return 0
    let selNewFunction: ptr = cheng_sel_register_name("newFunctionWithName:")
    let functionObj: ptr = cheng_objc_msg_send_ptr(library, selNewFunction, nameString)
    if functionObj == nil:
        cheng_inference_metal_release(library)
        cheng_inference_metal_release(queue)
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
