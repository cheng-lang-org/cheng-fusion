    return cheng_darwin_terminal_watch_arm(finishedReaderFd, -1, -1)

@exportc("cheng_native_terminal_finished_recovery_watch_arm_bridge")
@abi_internal
fn cheng_native_terminal_finished_recovery_watch_arm_bridge_export(
        finishedReaderFd: int32,
        childPid: int32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64): int32 =
    if finishedReaderFd < 0 || childPid <= 0 ||
       childBirthPlatform != 1 || childBirth0 == uint64(0) ||
       childBirth1 >= uint64(1000000):
        return -1
    var platformBefore: int32
    var birth0Before: uint64
    var birth1Before: uint64
    if cheng_native_terminal_child_birth_capture_bridge_export(
           childPid,
           -1,
           ptr(&platformBefore),
           ptr(&birth0Before),
           ptr(&birth1Before)) != 1 ||
       platformBefore != childBirthPlatform ||
       birth0Before != childBirth0 || birth1Before != childBirth1:
        return -2
    let owner = cheng_darwin_terminal_watch_arm(
        finishedReaderFd, -1, childPid)
    if owner <= 0:
        var platformAfterFailure: int32
        var birth0AfterFailure: uint64
        var birth1AfterFailure: uint64
        let originalStillLive =
            cheng_native_terminal_child_birth_capture_bridge_export(
                childPid,
                -1,
                ptr(&platformAfterFailure),
                ptr(&birth0AfterFailure),
                ptr(&birth1AfterFailure)) == 1 &&
            platformAfterFailure == childBirthPlatform &&
            birth0AfterFailure == childBirth0 &&
            birth1AfterFailure == childBirth1
        return originalStillLive ? -1 : -2
    var platformAfter: int32
    var birth0After: uint64
    var birth1After: uint64
    let exactAfter =
        cheng_native_terminal_child_birth_capture_bridge_export(
            childPid,
            -1,
            ptr(&platformAfter),
            ptr(&birth0After),
            ptr(&birth1After)) == 1 &&
        platformAfter == childBirthPlatform &&
        birth0After == childBirth0 && birth1After == childBirth1
    if !exactAfter:
        let row = owner - 1
        cheng_darwin_atomic_store_i32(
            ptr(&chengDarwinTerminalDecisionWatchStates[row]),
            chengDarwinTerminalDecisionWatchFailed)
    return owner

# Result: 1=socket readable, 2=vnode changed, 4=socket EOF. DELETE, RENAME,
# REVOKE and EV_ERROR are authority failures, never retry hints.
@exportc("cheng_native_terminal_event_wait_bridge")
@abi_internal
fn cheng_native_terminal_event_wait_bridge_export(
        watchOwner: int32): int32 =
    let row = watchOwner - 1
    if row < 0 || row >= chengDarwinTerminalDecisionWatchRowCount ||
       cheng_darwin_atomic_cas_i32(
           ptr(&chengDarwinTerminalDecisionWatchStates[row]),
           chengDarwinTerminalDecisionWatchIssued,
           chengDarwinTerminalDecisionWatchWaiting) != 1:
        return -1
    var event: ChengDarwinTerminalKevent
    let eventCount = libc_kevent_native(
        chengDarwinTerminalDecisionWatchQueueFds[row],
        nil,
        0,
        ptr(&event),
        1,
        nil)
    if eventCount != 1 ||
       (event.flags & chengDarwinEvError) != chengDarwinZeroU16:
        cheng_darwin_atomic_store_i32(
            ptr(&chengDarwinTerminalDecisionWatchStates[row]),
            chengDarwinTerminalDecisionWatchFailed)
        return -1
    if event.filter == chengDarwinEvfiltRead &&
       event.ident == uint64(
           chengDarwinTerminalDecisionWatchSocketFds[row]):
        if event.data > int64(0):
            cheng_darwin_atomic_store_i32(
                ptr(&chengDarwinTerminalDecisionWatchStates[row]),
                chengDarwinTerminalDecisionWatchIssued)
            return 1
        if (event.flags & chengDarwinEvEof) != chengDarwinZeroU16:
            var removeSocket: ChengDarwinTerminalKevent
            removeSocket.ident = uint64(
                chengDarwinTerminalDecisionWatchSocketFds[row])
            removeSocket.filter = chengDarwinEvfiltRead
            removeSocket.flags = chengDarwinEvDelete
            if libc_kevent_native(
                   chengDarwinTerminalDecisionWatchQueueFds[row],
                   ptr(&removeSocket),
                   1,
                   nil,
                   0,
                   nil) != 0:
                cheng_darwin_atomic_store_i32(
                    ptr(&chengDarwinTerminalDecisionWatchStates[row]),
                    chengDarwinTerminalDecisionWatchFailed)
                return -1
            cheng_darwin_atomic_store_i32(
                ptr(&chengDarwinTerminalDecisionWatchStates[row]),
                chengDarwinTerminalDecisionWatchIssued)
            return 4
        cheng_darwin_atomic_store_i32(
            ptr(&chengDarwinTerminalDecisionWatchStates[row]),
            chengDarwinTerminalDecisionWatchFailed)
        return -1
    if event.filter == chengDarwinEvfiltProc &&
       event.ident == uint64(
           chengDarwinTerminalDecisionWatchChildPids[row]):
        if (event.fflags & chengDarwinNoteExit) == uint32(0):
            cheng_darwin_atomic_store_i32(
                ptr(&chengDarwinTerminalDecisionWatchStates[row]),
                chengDarwinTerminalDecisionWatchFailed)
            return -1
        cheng_darwin_atomic_store_i32(
            ptr(&chengDarwinTerminalDecisionWatchStates[row]),
            chengDarwinTerminalDecisionWatchIssued)
        return 8
    if event.filter != chengDarwinEvfiltVnode ||
       event.ident != uint64(
           chengDarwinTerminalDecisionWatchDecisionFds[row]) ||
       (event.fflags & (chengDarwinNoteDelete | chengDarwinNoteRename |
                        chengDarwinNoteRevoke)) != uint32(0) ||
       (event.fflags & (chengDarwinNoteWrite | chengDarwinNoteExtend |
                        chengDarwinNoteAttrib | chengDarwinNoteLink |
                        chengDarwinNoteFunlock)) ==
           uint32(0):
        cheng_darwin_atomic_store_i32(
            ptr(&chengDarwinTerminalDecisionWatchStates[row]),
            chengDarwinTerminalDecisionWatchFailed)
        return -1
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchStates[row]),
        chengDarwinTerminalDecisionWatchIssued)
    return 2

@exportc("cheng_native_terminal_event_close_bridge")
@abi_internal
fn cheng_native_terminal_event_close_bridge_export(
        watchOwner: int32): int32 =
    let row = watchOwner - 1
    if row < 0 || row >= chengDarwinTerminalDecisionWatchRowCount:
        return 0
    let state = cheng_darwin_atomic_load_i32(
        ptr(&chengDarwinTerminalDecisionWatchStates[row]))
    if state != chengDarwinTerminalDecisionWatchIssued &&
       state != chengDarwinTerminalDecisionWatchFailed:
        return 0
    if cheng_darwin_atomic_cas_i32(
           ptr(&chengDarwinTerminalDecisionWatchStates[row]),
           state,
           chengDarwinTerminalDecisionWatchClosing) != 1:
        return 0
    let queueClosed = cheng_darwin_terminal_watch_close_queue_once(row)
    let decisionClosed =
        cheng_darwin_terminal_watch_close_decision_once(row)
    cheng_darwin_atomic_store_i32(
        ptr(&chengDarwinTerminalDecisionWatchStates[row]),
        (queueClosed && decisionClosed) ?
            chengDarwinTerminalDecisionWatchConsumed :
            chengDarwinTerminalDecisionWatchFailed)
    return queueClosed && decisionClosed ? 1 : 0

@exportc("cheng_native_terminal_darwin_peer_credentials_bridge")
@abi_internal
fn cheng_native_terminal_darwin_peer_credentials_bridge_export(
        socketFd: int32,
        outPid: ptr,
        outUid: ptr,
        outGid: ptr): int32 =
    if socketFd < 0 || outPid == nil || outUid == nil || outGid == nil:
        return 0
    *(Int32Ptr(outPid)) = -1
    *(UInt32Ptr(outUid)) = uint32(0)
    *(UInt32Ptr(outGid)) = uint32(0)
    var peerPid: int32 = -1
    var peerPidBytes: int32 = int32(sizeof(int32))
    var peerEffectivePid: int32 = -1
    var peerEffectivePidBytes: int32 = int32(sizeof(int32))
    var peerUid: uint32
    var peerGid: uint32
    if libc_getsockopt_native(
           socketFd, 0, 2, ptr(&peerPid), ptr(&peerPidBytes)) != 0 ||
       libc_getsockopt_native(
           socketFd,
           0,
           3,
           ptr(&peerEffectivePid),
           ptr(&peerEffectivePidBytes)) != 0 ||
       libc_getpeereid_native(
           socketFd, ptr(&peerUid), ptr(&peerGid)) != 0 ||
       peerPidBytes != int32(sizeof(int32)) ||
       peerEffectivePidBytes != int32(sizeof(int32)) ||
       peerPid <= 0 || peerEffectivePid != peerPid:
        return 0
    *(Int32Ptr(outPid)) = peerPid
    *(UInt32Ptr(outUid)) = peerUid
    *(UInt32Ptr(outGid)) = peerGid
    return 1

@exportc("cheng_ptr_plus")
fn cheng_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

fn cheng_darwin_write_all_immediate(
        fd: int32,
        raw: ptr,
        byteLength: int32) =
    if raw == nil || byteLength <= 0:
        return
    var written: int32
    while written < byteLength:
        let rc = libc_write(
            fd,
            cheng_ptr_plus(raw, written),
            byteLength - written)
        if rc > 0:
            written = written + rc
            continue
        if rc < 0 && *(Int32Ptr(libc_errno_ptr())) == 4:
            continue
        return

@exportc("cheng_native_fail_stop_bridge")
@abi_internal
fn cheng_native_fail_stop_bridge_export(
        text: ptr,
        byteLength: int32,
        exitCode: int32) =
    var safeText: ptr = text
    var safeLength = byteLength
    if safeText == nil:
        safeText = "cheng native fail-stop"
        safeLength = 22
    elif safeLength < 0:
        safeLength = 0
    let safeCode = exitCode == 0 ? 70 : exitCode
    cheng_darwin_write_all_immediate(2, safeText, safeLength)
    cheng_darwin_write_all_immediate(2, "\n", 1)
    libc_exit_immediate(safeCode)
    while true:
        libc_exit_immediate(safeCode)

