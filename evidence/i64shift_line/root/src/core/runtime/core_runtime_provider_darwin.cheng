@exportc("cheng_drawlist_new_handle")
fn cheng_drawlist_new_handle_export(capacity: int32): int32 =
    if capacity <= 0:
        return 0
    let id: int32 = cheng_gui_alloc_handle(chengGuiKindDrawList)
    if id <= 0:
        return 0
    chengGuiDrawListCapacity[id] = capacity
    chengGuiDrawListCount[id] = 0
    chengGuiDrawListActiveHandle = id
    chengGuiDrawListActiveCapacity = capacity
    chengGuiDrawListActiveCount = 0
    cheng_drawlist_clear_active_command_state()
    cheng_drawlist_clear_active_texture_state()
    return id

@exportc("cheng_drawlist_free_handle")
fn cheng_drawlist_free_handle_export(listId: int32) =
    if listId == chengGuiDrawListActiveHandle:
        cheng_gui_reset_handle(listId)
        return
    if cheng_gui_handle_valid(listId, chengGuiKindDrawList):
        cheng_gui_reset_handle(listId)

@exportc("cheng_drawlist_clear_handle")
fn cheng_drawlist_clear_handle_export(listId: int32) =
    if listId == chengGuiDrawListActiveHandle:
        chengGuiDrawListActiveCount = 0
        chengGuiDrawListCount[listId] = 0
        cheng_drawlist_clear_active_command_state()
        cheng_drawlist_clear_active_texture_state()
        return
    if cheng_gui_handle_valid(listId, chengGuiKindDrawList):
        chengGuiDrawListCount[listId] = 0

@exportc("cheng_drawlist_count_handle")
fn cheng_drawlist_count_handle_export(listId: int32): int32 =
    if listId <= 0:
        return 0
    if listId == chengGuiDrawListActiveHandle:
        return chengGuiDrawListActiveCount
    return 0

@exportc("cheng_drawlist_is_active_handle")
fn cheng_drawlist_is_active_handle_export(listId: int32): int32 =
    if listId <= 0:
        return 0
    if listId != chengGuiDrawListActiveHandle:
        return 0
    return 1

@exportc("cheng_drawlist_push_rect_handle")
fn cheng_drawlist_push_rect_handle_export(listId: int32,
                                          x: int32,
                                          y: int32,
                                          w: int32,
                                          h: int32,
                                          r: int32,
                                          g: int32,
                                          b: int32,
                                          a: int32) =
    let _shape = x + y + w + h + r + g + b + a
    if !cheng_gui_handle_valid(listId, chengGuiKindDrawList):
        return
    if listId != chengGuiDrawListActiveHandle:
        return
    if chengGuiDrawListActiveCount >= chengGuiDrawListActiveCapacity:
        return
    chengGuiDrawListActiveCount = chengGuiDrawListActiveCount + 1

@exportc("cheng_drawlist_push_border_handle")
fn cheng_drawlist_push_border_handle_export(listId: int32,
                                            x: int32,
                                            y: int32,
                                            w: int32,
                                            h: int32,
                                            r: int32,
                                            g: int32,
                                            b: int32,
                                            a: int32,
                                            borderWidth: int32,
                                            radius: int32) =
    let _shape = x + y + w + h + r + g + b + a + borderWidth + radius
    if !cheng_gui_handle_valid(listId, chengGuiKindDrawList):
        return
    if listId != chengGuiDrawListActiveHandle:
        return
    if chengGuiDrawListActiveCount >= chengGuiDrawListActiveCapacity:
        return
    chengGuiDrawListActiveCount = chengGuiDrawListActiveCount + 1

@exportc("cheng_drawlist_push_text_handle")
fn cheng_drawlist_push_text_handle_export(listId: int32,
                                          text: ptr,
                                          textLen: int32,
                                          x: int32,
                                          y: int32,
                                          fontSize: int32,
                                          r: int32,
                                          g: int32,
                                          b: int32,
                                          a: int32) =
    let _ = text
    let _shape = textLen + x + y + fontSize + r + g + b + a
    if !cheng_gui_handle_valid(listId, chengGuiKindDrawList):
        return
    if listId != chengGuiDrawListActiveHandle:
        return
    if chengGuiDrawListActiveCount >= chengGuiDrawListActiveCapacity:
        return
    chengGuiDrawListActiveCount = chengGuiDrawListActiveCount + 1

@exportc("cheng_drawlist_push_rect_command")
fn cheng_drawlist_push_rect_command_export(listId: int32): int32 =
    return cheng_drawlist_begin_active_command(listId, chengGuiDrawCommandRect)

@exportc("cheng_drawlist_push_border_command")
fn cheng_drawlist_push_border_command_export(listId: int32): int32 =
    return cheng_drawlist_begin_active_command(listId, chengGuiDrawCommandBorder)

@exportc("cheng_drawlist_push_text_command")
fn cheng_drawlist_push_text_command_export(listId: int32, text: ptr, textLen: int32): int32 =
    let _ = text
    if textLen <= 0:
        return 0
    let rc = cheng_drawlist_begin_active_command(listId, chengGuiDrawCommandText)
    if rc == 0:
        return 0
    chengGuiDrawListActiveTextLen = textLen
    return 1

@exportc("cheng_drawlist_set_last_command_position")
fn cheng_drawlist_set_last_command_position_export(listId: int32, x: int32, y: int32): int32 =
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveLastCommandKind == chengGuiDrawCommandNone:
        return 0
    chengGuiDrawListActiveCommandX = x
    chengGuiDrawListActiveCommandY = y
    return 1

@exportc("cheng_drawlist_set_last_command_size")
fn cheng_drawlist_set_last_command_size_export(listId: int32, w: int32, h: int32): int32 =
    if w <= 0 || h <= 0:
        return 0
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveLastCommandKind == chengGuiDrawCommandNone:
        return 0
    chengGuiDrawListActiveCommandWidth = w
    chengGuiDrawListActiveCommandHeight = h
    return 1

@exportc("cheng_drawlist_set_last_command_color_rg")
fn cheng_drawlist_set_last_command_color_rg_export(listId: int32, r: int32, g: int32): int32 =
    if !cheng_drawlist_valid_color_component(r) || !cheng_drawlist_valid_color_component(g):
        return 0
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveLastCommandKind == chengGuiDrawCommandNone:
        return 0
    chengGuiDrawListActiveCommandR = r
    chengGuiDrawListActiveCommandG = g
    return 1

@exportc("cheng_drawlist_set_last_command_color_ba")
fn cheng_drawlist_set_last_command_color_ba_export(listId: int32, b: int32, a: int32): int32 =
    if !cheng_drawlist_valid_color_component(b) || !cheng_drawlist_valid_color_component(a):
        return 0
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveLastCommandKind == chengGuiDrawCommandNone:
        return 0
    chengGuiDrawListActiveCommandB = b
    chengGuiDrawListActiveCommandA = a
    return 1

@exportc("cheng_drawlist_set_last_border_style")
fn cheng_drawlist_set_last_border_style_export(listId: int32, borderWidth: int32, radius: int32): int32 =
    if borderWidth <= 0 || radius < 0:
        return 0
    if !cheng_drawlist_active_ready(listId):
        return 0
    if chengGuiDrawListActiveLastCommandKind != chengGuiDrawCommandBorder:
        return 0
    chengGuiDrawListActiveBorderWidth = borderWidth
    chengGuiDrawListActiveBorderRadius = radius
    return 1

