fn cheng_inference_metal_launch_i32(source: str,
                                    functionName: str,
                                    input0: ptr,
                                    input0Bytes: int32,
                                    input1: ptr,
                                    input1Bytes: int32,
                                    output: ptr,
                                    outputBytes: int32,
                                    params: ptr,
                                    paramsBytes: int32,
                                    threadCount: int32): int64 =
    if source.len <= 0 || source.data == nil || functionName.len <= 0 || functionName.data == nil:
        return int64(-1)
    if input0 == nil || input1 == nil || output == nil || params == nil:
        return int64(-2)
