fn cheng_inference_metal_load_file_range_buffer(path: cstring,
                                                offsetBytes: int64,
                                                byteCount: int32): uint64 =
    if path == nil || offsetBytes < int64(0) || byteCount <= 0:
        return uint64(0)
    let fd: int32 = libc_open_native(path, chengDarwinORdonly, 0)
    if fd < 0:
        return uint64(0)
    let seeked = libc_lseek_native(fd, offsetBytes, chengDarwinSeekSet)
    if seeked != offsetBytes:
        let _closeSeekFail = libc_close_native(fd)
        return uint64(0)
    let scratch: ptr = cheng_runtime_malloc(byteCount)
    if scratch == nil:
        let _closeAllocFail = libc_close_native(fd)
        return uint64(0)
    var readOffset: int32
    while readOffset < byteCount:
        let got = libc_read_native(fd, cheng_ptr_plus(scratch, readOffset), int64(byteCount - readOffset))
        if got <= int64(0) || got > int64(byteCount - readOffset):
            cheng_runtime_free(scratch)
            let _closeReadFail = libc_close_native(fd)
            return uint64(0)
        readOffset = readOffset + int32(got)
    let closeRc = libc_close_native(fd)
    if closeRc != 0:
        cheng_runtime_free(scratch)
        return uint64(0)
    var pool: ptr = cheng_objc_autorelease_pool_push()
    let device: ptr = cheng_mtl_create_system_default_device()
    if device == nil:
        cheng_runtime_free(scratch)
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return uint64(0)
    let selNewBufferBytes: ptr = cheng_sel_register_name("newBufferWithBytes:length:options:")
    if selNewBufferBytes == nil:
        cheng_runtime_free(scratch)
        if pool != nil:
            cheng_objc_autorelease_pool_pop(pool)
        return uint64(0)
    let buffer: ptr = cheng_objc_msg_send_ptr_u64_u64(device, selNewBufferBytes, scratch, uint64(byteCount), uint64(0))
    cheng_runtime_free(scratch)
    if pool != nil:
        cheng_objc_autorelease_pool_pop(pool)
    if buffer == nil:
        return uint64(0)
    return uint64(buffer)

