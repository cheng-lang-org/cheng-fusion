fn cheng_darwin_decode_signal_done(ctx: ptr) =
    if ctx == nil:
        return
    let doneSemaphore: ptr = cheng_darwin_decode_ctx_get_ptr(ctx, chengDarwinDecodeCtxDoneSemaphoreOffset)
    if doneSemaphore == nil:
        return
    let _signal = libc_dispatch_semaphore_signal(doneSemaphore)

@exportc("cheng_media_darwin_h264_decode_callback")
fn cheng_media_darwin_h264_decode_callback_export(refCon: ptr,
                                                  sourceFrameRefCon: ptr,
                                                  status: int32,
                                                  infoFlags: int32,
                                                  imageBuffer: ptr,
                                                  presentationTimeStamp: ptr,
                                                  presentationDuration: ptr) =
    let _source = sourceFrameRefCon
    let _pts = presentationTimeStamp
    let _duration = presentationDuration
    if refCon == nil:
        return
    let ctx: ptr = refCon
    cheng_darwin_decode_ctx_set_i32(ctx, chengDarwinDecodeCtxStatusOffset, status)
    cheng_darwin_decode_ctx_set_i32(ctx, chengDarwinDecodeCtxInfoFlagsOffset, infoFlags)
    if status != 0:
        cheng_darwin_decode_signal_done(ctx)
        return
    if imageBuffer == nil:
        cheng_darwin_decode_signal_done(ctx)
        return
    let width64: uint64 = cheng_cv_pixel_buffer_get_width(imageBuffer)
    let height64: uint64 = cheng_cv_pixel_buffer_get_height(imageBuffer)
    if width64 == uint64(0) || height64 == uint64(0):
        cheng_darwin_decode_signal_done(ctx)
        return
    if width64 > uint64(2147483647) || height64 > uint64(2147483647):
        cheng_darwin_decode_signal_done(ctx)
        return
    let retained: ptr = cheng_cv_buffer_retain(imageBuffer)
    if retained == nil:
        cheng_darwin_decode_signal_done(ctx)
        return
    cheng_darwin_decode_ctx_set_ptr(ctx, chengDarwinDecodeCtxImageBufferOffset, retained)
    cheng_darwin_decode_ctx_set_i32(ctx, chengDarwinDecodeCtxWidthOffset, int32(width64))
    cheng_darwin_decode_ctx_set_i32(ctx, chengDarwinDecodeCtxHeightOffset, int32(height64))
    cheng_darwin_decode_ctx_set_i32(ctx,
                                    chengDarwinDecodeCtxPixelFormatOffset,
                                    int32(cheng_cv_pixel_buffer_get_pixel_format_type(imageBuffer)))
    cheng_darwin_decode_ctx_set_i32(ctx, chengDarwinDecodeCtxReadyOffset, 1)
    cheng_darwin_decode_signal_done(ctx)

fn cheng_darwin_decode_set_i32(out: ptr, value: int32) =
    if out != nil:
        *(Int32Ptr(out)) = value

fn cheng_darwin_decode_set_u64(out: ptr, value: uint64) =
    if out != nil:
        *(UInt64Ptr(out)) = value

fn cheng_darwin_media_metal_pixel_format(pixelFormat: int32): int32 =
    if pixelFormat == chengDarwinMediaPixelFormat32BGRA:
        return chengDarwinMediaMtlPixelFormatBGRA8Unorm
    if pixelFormat == chengDarwinMediaPixelFormat420FullRange:
        return chengDarwinMediaMtlPixelFormatR8Unorm
    if pixelFormat == chengDarwinMediaPixelFormat420VideoRange:
        return chengDarwinMediaMtlPixelFormatR8Unorm
    return 0

fn cheng_darwin_decode_create_metal_texture(pixelBuffer: ptr,
                                            width: int32,
                                            height: int32,
                                            pixelFormat: int32,
                                            textureHandleOut: ptr,
                                            statusOut: ptr): int32 =
    cheng_darwin_decode_set_u64(textureHandleOut, uint64(0))
    if pixelBuffer == nil || width <= 0 || height <= 0:
        cheng_darwin_decode_set_i32(statusOut, -201)
        return 0
    let metalPixelFormat = cheng_darwin_media_metal_pixel_format(pixelFormat)
    if metalPixelFormat <= 0:
        cheng_darwin_decode_set_i32(statusOut, -202)
        return 0
    let device: ptr = cheng_mtl_create_system_default_device()
    if device == nil:
        cheng_darwin_decode_set_i32(statusOut, -203)
        return 0
    var textureCache: ptr
    let cacheStatus: int32 = cheng_cv_metal_texture_cache_create(nil,
                                                                 nil,
                                                                 device,
                                                                 nil,
                                                                 &textureCache)
    if cacheStatus != 0 || textureCache == nil:
        cheng_darwin_decode_set_i32(statusOut, cacheStatus)
        return 0
    var cvTexture: ptr
    let textureStatus: int32 = cheng_cv_metal_texture_cache_create_texture_from_image(nil,
                                                                                     textureCache,
                                                                                     pixelBuffer,
                                                                                     nil,
                                                                                     uint64(metalPixelFormat),
                                                                                     uint64(width),
                                                                                     uint64(height),
                                                                                     uint64(0),
                                                                                     &cvTexture)
    cheng_cf_release(textureCache)
    if textureStatus != 0 || cvTexture == nil:
        cheng_darwin_decode_set_i32(statusOut, textureStatus)
        return 0
    let textureObject: ptr = cheng_cv_metal_texture_get_texture(cvTexture)
    if textureObject == nil:
        cheng_cf_release(cvTexture)
        cheng_darwin_decode_set_i32(statusOut, -204)
        return 0
    # Return the retained CVMetalTexture handle. The host can derive the MTLTexture
    # from it while the receipt owns this first-frame texture lifetime.
    cheng_darwin_decode_set_u64(textureHandleOut, uint64(cvTexture))
    chengDarwinMediaLastTextureHandle = uint64(cvTexture)
    chengDarwinMediaLastTextureWidth = width
    chengDarwinMediaLastTextureHeight = height
    chengDarwinMediaLastTexturePixelFormat = pixelFormat
    return 1

