@exportc("cheng_inference_metal_paged_attention_i32_buffers_out_buffer_bridge")
fn cheng_inference_metal_paged_attention_i32_buffers_out_buffer_bridge_export(queryBufferHandle: uint64,
                                                                             keysBufferHandle: uint64,
                                                                             valuesBufferHandle: uint64,
                                                                             pageTableBufferHandle: uint64,
                                                                             out: ptr,
                                                                             outBufferHandleOut: ptr,
                                                                             tokenCount: int32,
                                                                             keyDim: int32,
                                                                             valueDim: int32,
                                                                             tokensPerPage: int32,
                                                                             pageCount: int32,
                                                                             blockCount: int32,
                                                                             scale: int32): int64 =
    if outBufferHandleOut != nil:
        *(UInt64Ptr(outBufferHandleOut)) = uint64(0)
    if queryBufferHandle == uint64(0) || keysBufferHandle == uint64(0) ||
       valuesBufferHandle == uint64(0) || pageTableBufferHandle == uint64(0) ||
       out == nil || outBufferHandleOut == nil:
        return int64(-1)
    if tokenCount <= 0 || keyDim <= 0 || valueDim <= 0 || tokensPerPage <= 0 || pageCount <= 0 || blockCount <= 0 || scale <= 0:
        return int64(-2)
    if blockCount != (tokenCount + tokensPerPage - 1) / tokensPerPage:
        return int64(-3)
    if int64(pageCount) > int64(536870911) / int64(tokensPerPage):
        return int64(-4)
    let pageSlots64: int64 = int64(pageCount) * int64(tokensPerPage)
    if pageSlots64 > int64(536870911) / int64(keyDim) ||
       pageSlots64 > int64(536870911) / int64(valueDim):
        return int64(-5)
    let keyElems64: int64 = pageSlots64 * int64(keyDim)
    let valueElems64: int64 = pageSlots64 * int64(valueDim)
    if keyElems64 <= int64(0) || valueElems64 <= int64(0):
        return int64(-6)
    if keyElems64 > int64(536870911) || valueElems64 > int64(536870911) || int64(valueDim) > int64(536870911):
        return int64(-7)
    let paramsBytes: int32 = 48
    let paramsPtr: ptr = cheng_runtime_malloc(paramsBytes)
    if paramsPtr == nil:
        return int64(-8)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 0, tokenCount)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 4, keyDim)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 8, valueDim)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 12, tokensPerPage)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 16, pageCount)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 20, blockCount)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 24, scale)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 28, 0)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 32, 0)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 36, 0)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 40, 0)
    cheng_inference_metal_write_i32_le_ptr(paramsPtr, 44, 0)
    # #153/#154 root fix mirrored here: hardmax-over-dot-product-score paged
    # KV retrieval replaced with a 1/sqrt(headDim)-scaled softmax-weighted
    # average over every token this single dispatch can see (headDim==keyDim
    # here since this bridge has no per-head split -- exactly the
    # queryHeadCount==1 specialization of paged_kv_cache.cheng's
    # PagedKVAttentionQueryFill, which is what every caller of this bridge
    # passes today; see fix_verdict.md for the general multi-head residual).
    # Recomputes the dot product per (dim,token) pair rather than caching a
    # scores array (Metal kernel functions have no dynamic-size locals) --
    # deterministic pure re-evaluation, bit-identical to caching.
    let source = "#include <metal_stdlib>\nusing namespace metal;\nstatic inline int cheng_saturate(long value) { if (value > 2147483647L) { return 2147483647; } if (value < (-2147483647L - 1L)) { return -2147483647 - 1; } return int(value); }\nstatic inline long cheng_round_div(long numer, long denom) { if (denom <= 0) { return 0; } long halfv = denom / 2; if (numer >= 0) { return (numer + halfv) / denom; } return (numer - halfv) / denom; }\nstatic inline long cheng_isqrt(long value) { if (value <= 0) { return 0; } long x = value; long y = (x + 1) / 2; while (y < x) { x = y; y = (x + value / x) / 2; } return x; }\nstatic inline int cheng_exp_neg_q(int delta, int inputScale, int outputScale) { if (delta >= 0) { return outputScale; } if (delta <= 0 - inputScale * 8) { return 0; } long dQ = cheng_saturate(cheng_round_div(long(0 - delta) * long(outputScale), long(inputScale))); long term = long(outputScale); long total = long(outputScale); for (int k = 1; k <= 12; k = k + 1) { term = cheng_round_div(term * dQ, long(outputScale * k)); total = total + term; } if (total <= 0) { return 0; } return cheng_saturate(cheng_round_div(long(outputScale) * long(outputScale), total)); }\nkernel void cheng_paged_attention_i32(const device int* query [[buffer(0)]], const device int* keys [[buffer(1)]], device int* out [[buffer(2)]], const device int* values [[buffer(3)]], const device int* pageTable [[buffer(4)]], const device int* params [[buffer(5)]], uint gid [[thread_position_in_grid]]) { if (gid > 0) { return; } int tokenCount = params[0]; int keyDim = params[1]; int valueDim = params[2]; int tokensPerPage = params[3]; int pageCount = params[4]; int scale = params[6]; if (scale <= 0) { return; } long sqrtFix = 10000; long isqrtHead = cheng_isqrt(long(keyDim) * sqrtFix * sqrtFix); if (isqrtHead <= 0) { return; } long maxScore = 0; int found = 0; for (int t = 0; t < tokenCount; t = t + 1) { int block = t / tokensPerPage; int offset = t - block * tokensPerPage; int pageOrdinal = pageTable[block]; if (pageOrdinal < 0 || pageOrdinal >= pageCount) { return; } int keyBase = (pageOrdinal * tokensPerPage + offset) * keyDim; long dot = 0; for (int d = 0; d < keyDim; d = d + 1) { dot = dot + long(query[d]) * long(keys[keyBase + d]); } long score = cheng_saturate(cheng_round_div(dot * sqrtFix, long(scale) * isqrtHead)); if (found == 0 || score > maxScore) { maxScore = score; found = 1; } } if (found == 0) { return; } for (int d = 0; d < valueDim; d = d + 1) { long numer = 0; long denomLocal = 0; for (int t = 0; t < tokenCount; t = t + 1) { int block = t / tokensPerPage; int offset = t - block * tokensPerPage; int pageOrdinal = pageTable[block]; int keyBase = (pageOrdinal * tokensPerPage + offset) * keyDim; long dot = 0; for (int dd = 0; dd < keyDim; dd = dd + 1) { dot = dot + long(query[dd]) * long(keys[keyBase + dd]); } long score = cheng_saturate(cheng_round_div(dot * sqrtFix, long(scale) * isqrtHead)); int weight = cheng_exp_neg_q(int(score - maxScore), scale, 10000); int valueBase = (pageOrdinal * tokensPerPage + offset) * valueDim; numer = numer + long(values[valueBase + d]) * long(weight); denomLocal = denomLocal + long(weight); } out[d] = cheng_saturate(cheng_round_div(numer, denomLocal)); } }\n"
    let elapsed = cheng_inference_metal_launch_i32_buffer0_buffer1_buffer3_buffer4_outbuffer(
        source,
        "cheng_paged_attention_i32",
        queryBufferHandle,
        keysBufferHandle,
        valuesBufferHandle,
        pageTableBufferHandle,
        out,
        valueDim * 4,
        outBufferHandleOut,
        paramsPtr,
        paramsBytes,
        1
    )
    cheng_runtime_free(paramsPtr)
    return elapsed

@exportc("cheng_inference_metal_paged_attention_i32_buffers_output_receipt_bridge")
fn cheng_inference_metal_paged_attention_i32_buffers_output_receipt_bridge_export(queryBufferHandle: uint64,
                                                                                 keysBufferHandle: uint64,
                                                                                 valuesBufferHandle: uint64,
                                                                                 pageTableBufferHandle: uint64,
                                                                                 out: ptr,
                                                                                 outByteCount: int64,
                                                                                 tokenCount: int32,
                                                                                 keyDim: int32,
                                                                                 valueDim: int32,
                                                                                 tokensPerPage: int32,
                                                                                 pageCount: int32,
                                                                                 blockCount: int32,
                                                                                 outputScale: int32): uint64 =
    var outBufferHandle: uint64
    if outByteCount != int64(valueDim) * int64(4):
        return uint64(0)
    let elapsed = cheng_inference_metal_paged_attention_i32_buffers_out_buffer_bridge_export(
        queryBufferHandle,
        keysBufferHandle,
        valuesBufferHandle,
        pageTableBufferHandle,
