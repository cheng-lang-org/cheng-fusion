    let rc: int32 = libc_poll_native(pollFd, uint64(1), timeoutMs)
    let revents: int32 = cheng_darwin_pollfd_revents(pollFd)
    if rc < 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        if err > 0:
            return 0 - err
        return -1
    if rc == 0 || revents == 0:
        return 0
    return 1

# --- Multi-fd event wait (poll over a fd SET) -----------------------------------
# The single-fd cheng_fd_wait_readable_bridge can only block on ONE socket; an event
# loop that multiplexes many sockets (the VPN mux: every app socket + the tunnel
# sockets) had to fall back to a 1ms idle sleep, capping it at ~1000 loop turns/sec
# and stalling every stream for up to 1ms after data arrives. This bridge polls a
# whole SET in one syscall and returns immediately when ANY fd is ready.
#
# Stateful 3-call ABI (reset / add / wait) so no fd array crosses the Cheng<->native
# boundary — the cold backend mis-lowers &localArray[i], so the pollfd buffer lives
# on the heap (cheng_runtime_malloc + cheng_ptr_plus pointer arithmetic, the proven
# lowering path) and is referenced only by a module-global ptr. events: 1=POLLIN
# (readable), 4=POLLOUT (writable), 5=both.
var
    chengDarwinPollSetBuf: ptr
    chengDarwinPollSetCap: int32
    chengDarwinPollSetCount: int32

@exportc("cheng_fd_wait_multi_reset")
fn cheng_fd_wait_multi_reset_export() =
    chengDarwinPollSetCount = 0

@exportc("cheng_fd_wait_multi_add")
fn cheng_fd_wait_multi_add_export(fd: int32, events: int32): int32 =
    if fd < 0:
        return -1
    # Grow the heap pollfd buffer (8 bytes/entry) on demand; pointer arithmetic only.
    if chengDarwinPollSetCount >= chengDarwinPollSetCap:
        var newCap: int32 = chengDarwinPollSetCap * 2
        if newCap < 16:
            newCap = 16
        let newBuf: ptr = cheng_runtime_malloc(newCap * 8)
        if newBuf == nil:
            return -1
        if chengDarwinPollSetBuf != nil && chengDarwinPollSetCount > 0:
            cheng_bytes_copy(newBuf, chengDarwinPollSetBuf, chengDarwinPollSetCount * 8)
        chengDarwinPollSetBuf = newBuf
        chengDarwinPollSetCap = newCap
    let slot: ptr = cheng_ptr_plus(chengDarwinPollSetBuf, chengDarwinPollSetCount * 8)
    cheng_darwin_pollfd_write(slot, fd, events)
    chengDarwinPollSetCount = chengDarwinPollSetCount + 1
    return 0

@exportc("cheng_fd_wait_multi_wait")
fn cheng_fd_wait_multi_wait_export(timeoutMs: int32): int32 =
    if chengDarwinPollSetCount <= 0 || chengDarwinPollSetBuf == nil:
        return 0
    let rc: int32 = libc_poll_native(chengDarwinPollSetBuf, uint64(uint32(chengDarwinPollSetCount)), timeoutMs)
    if rc < 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        if err > 0:
            return 0 - err
        return -1
    return rc

