@exportc("cheng_native_csg_store_identity_registry_wait_bridge")
@abi_internal
fn cheng_native_csg_store_identity_registry_wait_bridge_export(
        observedEpoch: int32) =
    let lockAddress = ptr(&chengDarwinCsgStoreIdentityRegistryLockWord)
    libc_os_unfair_lock_assert_not_owner(lockAddress)
    if observedEpoch < 0:
        cheng_native_fail_stop_bridge_export(
            "cheng csg store identity registry wait epoch invalid", 52, 70)
    let epochAddress = ptr(&chengDarwinCsgStoreIdentityRegistryEpochWord)
    let waitOperation = chengDarwinUlockCompareAndWait |
                        chengDarwinUlockNoErrno
    while cheng_darwin_atomic_load_i32(epochAddress) == observedEpoch:
        let waitRc = libc_ulock_wait(waitOperation,
                                      epochAddress,
                                      uint64(observedEpoch),
                                      uint32(0))
        if waitRc < 0 && waitRc != -4:
            cheng_native_fail_stop_bridge_export(
                "cheng csg store identity registry ulock wait failed", 51, 70)

@exportc("cheng_native_csg_store_identity_registry_notify_all_bridge")
@abi_internal
fn cheng_native_csg_store_identity_registry_notify_all_bridge_export() =
    let lockAddress = ptr(&chengDarwinCsgStoreIdentityRegistryLockWord)
    libc_os_unfair_lock_assert_owner(lockAddress)
    let epochAddress = ptr(&chengDarwinCsgStoreIdentityRegistryEpochWord)
    let current = cheng_darwin_atomic_load_i32(epochAddress)
    if current < 0 || current == chengDarwinInt32Max:
