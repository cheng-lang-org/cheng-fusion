t[valueDim] = 0; out[valueDim + 1] = -1; out[valueDim + 2] = 0; out[valueDim + 3] = 0; if (scale <= 0) { return; } long sqrtFix = 10000; long isqrtHead = cheng_isqrt(long(keyDim) * sqrtFix * sqrtFix); if (isqrtHead <= 0) { return; } long maxScore = 0; int found = 0; int firstToken = -1; for (int t = 0; t < tokenCount; t = t + 1) { int block = t / tokensPerPage; int offset = t - block * tokensPerPage; int pageOrdinal = pageTable[block]; if (pageOrdinal < 0 || pageOrdinal >= pageCount) { return; } if (pageOrdinal < pageStart || pageOrdinal >= pageStart + windowPageCount) { continue; } int localPage = pageOrdinal - pageStart; const device int* keyPage = key0; if (localPage == 1) { keyPage = key1; } else if (localPage == 2) { keyPage = key2; } else if (localPage == 3) { keyPage = key3; } int keyBase = offset * keyDim; long dot = 0; for (int d = 0; d < keyDim; d = d + 1) { dot = dot + long(query[d]) * long(keyPage[keyBase + d]); } long score = cheng_saturate(cheng_round_div(dot * sqrtFix, long(scale) * isqrtHead)); if (found == 0) { firstToken = t; } if (found == 0 || score > maxScore) { maxScore = score; } found = 1; } if (found == 0) { return; } for (int d = 0; d < valueDim; d = d + 1) { long numer = 0; long denomLocal = 0; for (int t = 0; t < tokenCount; t = t + 1) { int block = t / tokensPerPage; int offset = t - block * tokensPerPage; int pageOrdinal = pageTable[block]; if (pageOrdinal < pageStart || pageOrdinal >= pageStart + windowPageCount) { continue; } int localPage = pageOrdinal - pageStart; const device int* keyPage = key0; if (localPage == 1) { keyPage = key1; } else if (localPage == 2) { keyPage = key2; } else if (localPage == 3) { keyPage = key3; } const device int* valuePage = value0; if (localPage == 1) { valuePage = value1; } else if (localPage == 2) { valuePage = value2; } else if (localPage == 3) { valuePage = value3; } int keyBase = offset * keyDim; long dot = 0; for (int dd = 0; dd < keyDim; dd = dd + 1) { dot = dot + long(query[dd]) * long(keyPage[keyBase + dd]); } long score = cheng_saturate(cheng_round_div(dot * sqrtFix, long(scale) * isqrtHead)); int weight = cheng_exp_neg_q(int(score - maxScore), scale, 10000); int valueBase = offset * valueDim; numer = numer + long(valuePage[valueBase + d]) * long(weight); denomLocal = denomLocal + long(weight); } out[d] = cheng_saturate(cheng_round_div(numer, denomLocal)); } out[valueDim] = found; out[valueDim + 1] = firstToken; out[valueDim + 2] = int(maxScore); out[valueDim + 3] = int(maxScore >> 32); }\n"
    let elapsed = cheng_inference_metal_launch_i32_page_buffers_window_direct(
