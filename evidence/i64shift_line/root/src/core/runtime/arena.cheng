# Arena storage rides the runtime allocator (cheng_malloc/cheng_realloc/
# cheng_free) instead of a language-level uint8[] seq. Two wins over the seq
# backing: (1) blocks >=1MB inherit the runtime's mmap tier, so ArenaRelease
# truly returns pages to the OS (the seq backing leaked via the cold inline
# lowering and the libc malloc pool); (2) cold-compiled binaries reach the
# same runtime provider through @importc, so arena-backed data escapes the
# cold inline seq path entirely. Public API and offset/generation semantics
# are unchanged.
@importc("cheng_malloc")
fn arena_rt_malloc(size: int32): cstring

@importc("cheng_realloc")
fn arenaRuntimeReallocPhysical(p: cstring, size: int32): cstring

@importc("cheng_free")
fn arena_rt_free(p: cstring)

# Byte load/store stay in C provider (runtime ABI boundary). Cheng surface is
# only basePtr+offset calls — no Cheng-side * / uint8* deref (ZRPC / no-pointer).
@importc("cheng_u8_load_at")
fn arena_rt_u8_load_at(base: cstring, offset: int32): int32

@importc("cheng_u8_store_at")
fn arena_rt_u8_store_at(base: cstring, offset: int32, value: int32)

@importc("cheng_u32_load_at")
fn arena_rt_u32_load_at(base: cstring, offset: int32): int32

@importc("cheng_u32_store_at")
fn arena_rt_u32_store_at(base: cstring, offset: int32, value: int32)

const
    ArenaDefaultAlignment = 8
    ArenaMaxInt32 = 2147483647

type
    Arena =
        basePtr: cstring
        usedBytes: int32
        capacityBytes: int32
        alignmentBytes: int32
        generation: int32

    ArenaBytes =
        offset: int32
        len: int32
        alignmentBytes: int32
        generation: int32

    ArenaArrayInt32 =
        offset: int32
        len: int32
        capacity: int32
        generation: int32

    ArenaArrayU8 =
        offset: int32
        len: int32
        capacity: int32
        generation: int32

@borrows
fn arenaLoadByte(arena: Arena, offset: int32): int32 =
    return arena_rt_u8_load_at(arena.basePtr, offset)

fn arenaStoreByte(arena: var Arena, offset: int32, value: int32) =
    arena_rt_u8_store_at(arena.basePtr, offset, value & 255)

@borrows
fn arenaLoadU32(arena: Arena, offset: int32): int32 =
    return arena_rt_u32_load_at(arena.basePtr, offset)

fn arenaStoreU32(arena: var Arena, offset: int32, value: int32) =
    arena_rt_u32_store_at(arena.basePtr, offset, value)

fn arenaPowerOfTwo(value: int32): bool =
    if value <= 0:
        return false
    return (value & (value - 1)) == 0

fn arenaRequireAlignment(alignmentBytes: int32) =
    if !arenaPowerOfTwo(alignmentBytes):
        panic("arena: alignment must be a positive power of two")

@borrows
fn arenaRequireLive(arena: Arena) =
    if arena.capacityBytes <= 0:
        panic("arena: uninitialized")
    if arena.alignmentBytes <= 0:
        panic("arena: corrupt alignment")
    if arena.basePtr == nil:
        panic("arena: corrupt storage pointer")
    if arena.usedBytes < 0 || arena.usedBytes > arena.capacityBytes:
        panic("arena: corrupt used bytes")
    if arena.generation <= 0:
        panic("arena: corrupt generation")

fn arenaAlignUp(value: int32, alignmentBytes: int32): int32 =
    arenaRequireAlignment(alignmentBytes)
    let mask = alignmentBytes - 1
    if value < 0 || value > ArenaMaxInt32 - mask:
        panic("arena: alignment overflow")
    return (value + mask) & (0 - alignmentBytes)

fn ArenaInitAligned(capacityBytes: int32, alignmentBytes: int32): Arena =
    if capacityBytes <= 0:
        panic("arena: capacity must be positive")
    arenaRequireAlignment(alignmentBytes)
    var out: Arena
    out.capacityBytes = capacityBytes
    out.alignmentBytes = alignmentBytes
    out.generation = 1
    out.basePtr = arena_rt_malloc(capacityBytes)
    if out.basePtr == nil:
        panic("arena: allocation failed")
    return out

fn ArenaInit(capacityBytes: int32, alignmentBytes: int32): Arena =
    return ArenaInitAligned(capacityBytes, alignmentBytes)

fn ArenaInitDefault(capacityBytes: int32): Arena =
    return ArenaInitAligned(capacityBytes, ArenaDefaultAlignment)

fn ArenaInit(capacityBytes: int32): Arena =
    return ArenaInitDefault(capacityBytes)

fn ArenaCreate(initialCapacity: int32): Arena =
    return ArenaInitDefault(initialCapacity)

# combo B-3 component 1: deep-copy arena (TypedExprIrClone for ArenaArrayInt32-backed columns).
# Copies storage bytes + all fields; keeps generation so ArenaArrayInt32 offsets stay valid.
@borrows
fn ArenaClone(src: Arena): Arena =
    arenaRequireLive(src)
    var out: Arena
    out.capacityBytes = src.capacityBytes
    out.alignmentBytes = src.alignmentBytes
    out.usedBytes = src.usedBytes
    out.generation = src.generation
    out.basePtr = arena_rt_malloc(src.capacityBytes)
    if out.basePtr == nil:
        panic("arena: clone allocation failed")
    var i: int32
    while i < src.usedBytes:
        arena_rt_u8_store_at(out.basePtr, i, arena_rt_u8_load_at(src.basePtr, i))
        i = i + 1
    return out

fn ArenaFreeBase(base: cstring) =
    if base != nil:
        arena_rt_free(base)

fn ArenaRelease(arena: var Arena) =
    if arena.basePtr != nil:
        arena_rt_free(arena.basePtr)
    arena.basePtr = cstring(nil)
    arena.usedBytes = 0
    arena.capacityBytes = 0
    arena.alignmentBytes = 0
    arena.generation = 0

fn ArenaDestroy(arena: var Arena) =
    ArenaRelease(arena)

fn ArenaReset(arena: var Arena) =
    arenaRequireLive(arena)
    if arena.generation >= ArenaMaxInt32:
        panic("arena: generation overflow")
    arena.usedBytes = 0
    arena.generation = arena.generation + 1

@borrows
fn ArenaUsed(arena: Arena): int32 =
    arenaRequireLive(arena)
    return arena.usedBytes

@borrows
fn ArenaCapacity(arena: Arena): int32 =
    arenaRequireLive(arena)
    return arena.capacityBytes

@borrows
fn ArenaAlignment(arena: Arena): int32 =
    arenaRequireLive(arena)
    return arena.alignmentBytes

@borrows
fn ArenaRemaining(arena: Arena): int32 =
    arenaRequireLive(arena)
    return arena.capacityBytes - arena.usedBytes

# Grow capacity to exactly minCapacity (no doubling overshoot) so the next
# allocations up to that size never trigger the grow path. Callers that know
# their deterministic incremental size (parser forest merge from per-source
# trees) use this to keep the physical buffer tight: capacity == used, and no
# realloc copy transient beyond this single reallocation. Growth beyond the
# reserved capacity still goes through the standard doubling path.
fn ArenaReserveCapacity(arena: var Arena, minCapacity: int32) =
    arenaRequireLive(arena)
    if minCapacity < 0:
        panic("arena: negative reserve capacity")
    if minCapacity <= arena.capacityBytes:
        return
    if minCapacity > ArenaMaxInt32:
        panic("arena: reserve capacity overflow")
    let grown = arenaRuntimeReallocPhysical(arena.basePtr, minCapacity)
    if grown == nil:
        panic("arena: reserve allocation failed")
    arena.basePtr = grown
    arena.capacityBytes = minCapacity

fn ArenaAllocBytesAligned(arena: var Arena,
                           byteCount: int32,
                           alignmentBytes: int32): ArenaBytes =
    arenaRequireLive(arena)
    arenaRequireAlignment(alignmentBytes)
    if byteCount < 0:
        panic("arena: negative allocation")
    var out: ArenaBytes
    let alignedOffset = arenaAlignUp(arena.usedBytes, alignmentBytes)
    if byteCount == 0:
        out.offset = alignedOffset
        out.len = 0
        out.alignmentBytes = alignmentBytes
        out.generation = arena.generation
        return out
    if alignedOffset > ArenaMaxInt32 - byteCount:
        panic("arena: allocation overflow")
    let nextUsed = alignedOffset + byteCount
    if nextUsed > arena.capacityBytes:
        var growCap: int32 = arena.capacityBytes * 2
        if growCap <= 0:
            growCap = nextUsed
        if nextUsed > growCap:
            growCap = nextUsed
        if growCap > ArenaMaxInt32:
            panic("arena: grow overflow")
        let grown = arenaRuntimeReallocPhysical(arena.basePtr, growCap)
        if grown == nil:
            panic("arena: grow allocation failed")
        arena.basePtr = grown
        arena.capacityBytes = growCap
    arena.usedBytes = nextUsed
    out.offset = alignedOffset
    out.len = byteCount
    out.alignmentBytes = alignmentBytes
    out.generation = arena.generation
    return out

fn ArenaAllocBytes(arena: var Arena, byteCount: int32): ArenaBytes =
    arenaRequireLive(arena)
    return ArenaAllocBytesAligned(arena, byteCount, arena.alignmentBytes)

fn ArenaAlloc(arena: var Arena, byteCount: int32): ArenaBytes =
    return ArenaAllocBytes(arena, byteCount)

@borrows
fn arenaRequireBytes(arena: Arena, bytes: ArenaBytes) =
    arenaRequireLive(arena)
    if bytes.generation != arena.generation:
        panic("arena: stale allocation")
    if bytes.offset < 0 || bytes.len < 0:
        panic("arena: corrupt allocation")
    if bytes.offset > ArenaMaxInt32 - bytes.len:
        panic("arena: allocation range overflow")
    if bytes.offset + bytes.len > arena.usedBytes:
        panic("arena: allocation outside used range")
    arenaRequireAlignment(bytes.alignmentBytes)
    if arenaAlignUp(bytes.offset, bytes.alignmentBytes) != bytes.offset:
        panic("arena: allocation offset misaligned")

@borrows
fn ArenaBytesOffset(bytes: ArenaBytes): int32 =
    return bytes.offset

@borrows
fn ArenaBytesLen(bytes: ArenaBytes): int32 =
    return bytes.len

@borrows
fn ArenaBytesAlignment(bytes: ArenaBytes): int32 =
    return bytes.alignmentBytes

@borrows
fn ArenaGetByte(arena: Arena, bytes: ArenaBytes, index: int32): int32 =
    arenaRequireBytes(arena, bytes)
    if index < 0 || index >= bytes.len:
        panic("arena: read out of bounds")
    return arenaLoadByte(arena, bytes.offset + index)

@borrows
fn ArenaSetByte(arena: var Arena, bytes: ArenaBytes, index: int32, value: int32) =
    arenaRequireBytes(arena, bytes)
    if index < 0 || index >= bytes.len:
        panic("arena: write out of bounds")
    arenaStoreByte(arena, bytes.offset + index, value)

@borrows
fn ArenaFillBytes(arena: var Arena, bytes: ArenaBytes, value: int32) =
    arenaRequireBytes(arena, bytes)
    for i in 0..<bytes.len:
        arenaStoreByte(arena, bytes.offset + i, value)

fn ArenaAllocZeroBytes(arena: var Arena, byteCount: int32): ArenaBytes =
    let bytes = ArenaAllocBytes(arena, byteCount)
    ArenaFillBytes(arena, bytes, 0)
    return bytes

fn ArenaAllocZero(arena: var Arena, byteCount: int32): ArenaBytes =
    return ArenaAllocZeroBytes(arena, byteCount)

fn ArenaArrayInt32Init(): ArenaArrayInt32 =
    var out: ArenaArrayInt32
    return out

fn ArenaArrayInt32ReserveEmpty(arena: var Arena,
                               arr: var ArenaArrayInt32,
                               capacity: int32): bool =
    arenaRequireLive(arena)
    if arr.offset != 0 || arr.len != 0 || arr.capacity != 0 ||
       arr.generation != 0:
        panic("arena array: reserve requires an empty array")
    if capacity < 0:
        return false
    if capacity == 0:
        return true
    let byteCount64 = Int64(capacity) * Int64(4)
    if byteCount64 > Int64(ArenaMaxInt32):
        return false
    let bytes = ArenaAllocBytesAligned(arena, Int32(byteCount64), 4)
    arr.offset = bytes.offset
    arr.capacity = capacity
    arr.generation = bytes.generation
    return true

fn ArenaArrayInt32AddReserved(arena: var Arena,
                              arr: var ArenaArrayInt32,
                              value: int32) =
    arenaRequireLive(arena)
    if arr.generation != arena.generation:
        panic("arena array: stale reserved array")
    if arr.offset < 0 || arr.len < 0 || arr.capacity <= 0 ||
       arr.len >= arr.capacity:
        panic("arena array: reserved capacity exhausted")
    let byteCount64 = Int64(arr.capacity) * Int64(4)
    let endOffset64 = Int64(arr.offset) + byteCount64
    if endOffset64 > Int64(arena.usedBytes):
        panic("arena array: reserved storage outside arena")
    let o = arr.offset + arr.len * 4
    arenaStoreU32(arena, o, value)
    arr.len = arr.len + 1

# Test/probe-only reserved-storage touch. It writes and reads one physical
# reserved slot without changing the array's logical len.
@borrows
fn ArenaArrayInt32ProbeReservedIndexForTest(arena: var Arena,
                                            arr: ArenaArrayInt32,
                                            index: int32,
                                            value: int32): bool =
    arenaRequireLive(arena)
    if arr.generation != arena.generation || arr.capacity <= 0:
        return false
    if index < 0 || index >= arr.capacity:
        return false
    let endOffset64 = Int64(arr.offset) +
                      Int64(arr.capacity) * Int64(4)
    if arr.offset < 0 || endOffset64 > Int64(arena.usedBytes):
        return false
    let o = arr.offset + index * 4
    arenaStoreU32(arena, o, value)
    return arenaLoadU32(arena, o) == value

fn ArenaArrayInt32Add(arena: var Arena, arr: var ArenaArrayInt32, v: int32) =
    # 拆分 `or` 条件为独立 if——规避 Cheng 编译器 `or` codegen bug
    # (a==0 or b>=a 永远 true，致每次 add grow，arena overflow)
    var shouldGrow: bool
    shouldGrow = false
    if arr.capacity == 0:
        shouldGrow = true
    if arr.len >= arr.capacity:
        shouldGrow = true
    if shouldGrow:
        var newCap: int32 = 8
        if arr.capacity > 0:
            newCap = arr.capacity * 2
        let newBytes = ArenaAllocBytesAligned(arena, newCap * 4, 4)
        if arr.len > 0:
            for j in 0..<arr.len:
                arenaStoreU32(arena,
                              newBytes.offset + j * 4,
                              arenaLoadU32(arena, arr.offset + j * 4))
        arr.offset = newBytes.offset
        arr.capacity = newCap
        arr.generation = newBytes.generation
    let o = arr.offset + arr.len * 4
    arenaStoreU32(arena, o, v)
    arr.len = arr.len + 1

@borrows
fn ArenaArrayInt32Get(arena: Arena, arr: ArenaArrayInt32, i: int32): int32 =
    if i < 0 || i >= arr.len:
        panic("arena array: read out of bounds")
    let o = arr.offset + i * 4
    return arenaLoadU32(arena, o)

@borrows
fn ArenaArrayInt32Set(arena: var Arena, arr: ArenaArrayInt32, i: int32, v: int32) =
    if i < 0 || i >= arr.len:
        panic("arena array: write out of bounds")
    let o = arr.offset + i * 4
    arenaStoreU32(arena, o, v)

@borrows
fn ArenaArrayInt32Len(arena: Arena, arr: ArenaArrayInt32): int32 =
    return arr.len

fn ArenaArrayU8Init(): ArenaArrayU8 =
    var out: ArenaArrayU8
    return out

fn ArenaArrayU8ReserveEmpty(arena: var Arena,
                            arr: var ArenaArrayU8,
                            capacity: int32): bool =
    arenaRequireLive(arena)
    if arr.offset != 0 || arr.len != 0 || arr.capacity != 0 ||
       arr.generation != 0:
        panic("arena u8 array: reserve requires an empty array")
    if capacity < 0:
        return false
    if capacity == 0:
        return true
    let bytes = ArenaAllocBytesAligned(arena, capacity, 1)
    arr.offset = bytes.offset
    arr.capacity = capacity
    arr.generation = bytes.generation
    return true

fn ArenaArrayU8AddReserved(arena: var Arena,
                           arr: var ArenaArrayU8,
                           value: int32) =
    arenaRequireLive(arena)
    if value < 0 || value > 255:
        panic("arena u8 array: value out of range")
    if arr.generation != arena.generation:
        panic("arena u8 array: stale reserved array")
    if arr.offset < 0 || arr.len < 0 || arr.capacity <= 0 ||
       arr.len >= arr.capacity:
        panic("arena u8 array: reserved capacity exhausted")
    let endOffset64 = Int64(arr.offset) + Int64(arr.capacity)
    if endOffset64 > Int64(arena.usedBytes):
        panic("arena u8 array: reserved storage outside arena")
    arenaStoreByte(arena, arr.offset + arr.len, value)
    arr.len = arr.len + 1

@borrows
fn ArenaArrayU8ProbeReservedIndexForTest(arena: var Arena,
                                         arr: ArenaArrayU8,
                                         index: int32,
                                         value: int32): bool =
    arenaRequireLive(arena)
    if value < 0 || value > 255 ||
       arr.generation != arena.generation || arr.capacity <= 0:
        return false
    if index < 0 || index >= arr.capacity:
        return false
    let endOffset64 = Int64(arr.offset) + Int64(arr.capacity)
    if arr.offset < 0 || endOffset64 > Int64(arena.usedBytes):
        return false
    arenaStoreByte(arena, arr.offset + index, value)
    return arenaLoadByte(arena, arr.offset + index) == value

@borrows
fn ArenaArrayU8Get(arena: Arena, arr: ArenaArrayU8, i: int32): int32 =
    if i < 0 || i >= arr.len:
        panic("arena u8 array: read out of bounds")
    return arenaLoadByte(arena, arr.offset + i)

@borrows
fn ArenaArrayU8Set(arena: var Arena,
                   arr: ArenaArrayU8,
                   i: int32,
                   value: int32) =
    if i < 0 || i >= arr.len:
        panic("arena u8 array: write out of bounds")
    if value < 0 || value > 255:
        panic("arena u8 array: value out of range")
    arenaStoreByte(arena, arr.offset + i, value)

@borrows
fn ArenaArrayU8Len(arena: Arena, arr: ArenaArrayU8): int32 =
    return arr.len
