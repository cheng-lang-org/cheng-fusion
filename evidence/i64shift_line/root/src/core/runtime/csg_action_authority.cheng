# CSG 动作注册合同权威 (任务 05 首切片)。
#
# 唯一需求来源: docs/campaigns/2026-09-21-csg-decision-computer-use/contract.md
# §4 (权限与确认合同)。
#
# effectClass 与确认要求的唯一权威是本模块的注册合同表; 模型置信度与调用方
# 任意布尔值不得签发授权 (openspec/csg-semantic-decision-computer-use §1)。
# 确认凭证绑定 动作 + 参数 + 合同版本 + 快照世代, 一次性消费; 授权撤销后
# 未消费凭证全部作废。凭证句柄是本表行索引, 不自造 CID; 身份绑定复用
# (动作行, 参数, 版本, 世代) 精确匹配。
#
# 生命周期: 注册表进程级单例 (30 行固定, 首次查询时惰性构建); 凭证列追加式
# 增长, 每条用户确认一行, 消费/撤销只翻位不删除, 供审计; 无跨任务缓存。
#
# 错误串约定: 确认门 token 与 web_scene_computer_use 的既有外部合同字面量
# 一致 ("computer_use_e_confirmation_required"), 其余为本模块可区分判词。

import std/strings

const
    # 确认类: 无 / 外部发布 / 支付 (与既有两类确认外部行为兼容)
    CsgActionConfirmNone: int32 = 0
    CsgActionConfirmExternalPublish: int32 = 1
    CsgActionConfirmPayment: int32 = 2

    # 注册的 effectClass 词表; 词表外 (调用方自造) 一律拒绝
    CsgActionEffectLocal: str = ""
    CsgActionEffectSearch: str = "search"
    CsgActionEffectFilter: str = "filter"
    CsgActionEffectExternalPublish: str = "external-publish"
    CsgActionEffectPayment: str = "payment"

    # 参数合同引用 (合同元数据; 内容校验权威仍在执行层, 本切片不重复实现)
    CsgActionParamContractNone: int32 = 0
    CsgActionParamContractText: int32 = 1
    CsgActionParamContractNumber: int32 = 2
    CsgActionParamContractOption: int32 = 3

    # 错误判词 (逐项可区分)
    CsgActionAuthorityErrConfirmationRequired: str =
        "computer_use_e_confirmation_required"
    CsgActionAuthorityErrActionKind: str = "computer_use_e_action_kind"
    CsgActionAuthorityErrEffectClass: str =
        "computer_use_e_effect_class_not_registered"
    CsgActionAuthorityErrCredentialUsed: str =
        "csg_authority_e_credential_used"
    CsgActionAuthorityErrVersionMismatch: str =
        "csg_authority_e_credential_version_mismatch"
    CsgActionAuthorityErrStaleGeneration: str =
        "csg_authority_e_credential_stale_generation"
    CsgActionAuthorityErrRevoked: str =
        "csg_authority_e_authorization_revoked"
    CsgActionAuthorityErrCredentialHandle: str =
        "csg_authority_e_credential_handle_invalid"

var
    # 注册合同表 (SoA 列): (动作, effectClass) 精确行, 版本 int64
    csgActionRegistryReady: bool
    csgActionRegistryActionKinds: str[]
    csgActionRegistryEffectClasses: str[]
    csgActionRegistryConfirmClasses: int32[]
    csgActionRegistryVersions: int64[]
    csgActionRegistryParamContracts: int32[]

    # 快照世代 (执行前重验; 前进即整快照严格失效)
    csgActionCurrentGeneration: int64

    # 确认凭证列: 绑定 (动作行, 参数, 版本, 世代), 一次性消费, 可撤销
    csgCredRows: int32[]
    csgCredPayloads: str[]
    csgCredVersions: int64[]
    csgCredGenerations: int64[]
    csgCredConsumed: bool[]
    csgCredRevoked: bool[]

    # 凭证行句柄 (08 执行层接线): 最近一次签发/消费的凭证表行索引。
    # 同窗口使用 —— 签发方读 LastGrantedRow 得句柄, 执行入口按句柄提名消费;
    # 各入口在自身入口处复位 -1, 不跨调用、不跨任务保留。
    csgActionLastGrantedRow: int32
    csgActionLastConsumedRow: int32

fn csgActionRegistryAddRow(
        actionKind: str,
        effectClass: str,
        confirmClass: int32,
        paramContract: int32) =
    add(csgActionRegistryActionKinds, actionKind)
    add(csgActionRegistryEffectClasses, effectClass)
    add(csgActionRegistryConfirmClasses, confirmClass)
    add(csgActionRegistryVersions, int64(1))
    add(csgActionRegistryParamContracts, paramContract)

fn csgActionEnsureRegistry() =
    if csgActionRegistryReady:
        return
    # 六动作 × 五类 effectClass; 确认要求挂在类上 (external-publish/payment),
    # 与既有外部行为兼容; 参数合同引用来自各动作的执行合同。
    csgActionRegistryAddRow(
        "Click", CsgActionEffectLocal, CsgActionConfirmNone,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Click", CsgActionEffectSearch, CsgActionConfirmNone,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Click", CsgActionEffectFilter, CsgActionConfirmNone,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Click", CsgActionEffectExternalPublish,
        CsgActionConfirmExternalPublish, CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Click", CsgActionEffectPayment, CsgActionConfirmPayment,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Toggle", CsgActionEffectLocal, CsgActionConfirmNone,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Toggle", CsgActionEffectSearch, CsgActionConfirmNone,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Toggle", CsgActionEffectFilter, CsgActionConfirmNone,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Toggle", CsgActionEffectExternalPublish,
        CsgActionConfirmExternalPublish, CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "Toggle", CsgActionEffectPayment, CsgActionConfirmPayment,
        CsgActionParamContractNone)
    csgActionRegistryAddRow(
        "SetText", CsgActionEffectLocal, CsgActionConfirmNone,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SetText", CsgActionEffectSearch, CsgActionConfirmNone,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SetText", CsgActionEffectFilter, CsgActionConfirmNone,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SetText", CsgActionEffectExternalPublish,
        CsgActionConfirmExternalPublish, CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SetText", CsgActionEffectPayment, CsgActionConfirmPayment,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SetNumber", CsgActionEffectLocal, CsgActionConfirmNone,
        CsgActionParamContractNumber)
    csgActionRegistryAddRow(
        "SetNumber", CsgActionEffectSearch, CsgActionConfirmNone,
        CsgActionParamContractNumber)
    csgActionRegistryAddRow(
        "SetNumber", CsgActionEffectFilter, CsgActionConfirmNone,
        CsgActionParamContractNumber)
    csgActionRegistryAddRow(
        "SetNumber", CsgActionEffectExternalPublish,
        CsgActionConfirmExternalPublish, CsgActionParamContractNumber)
    csgActionRegistryAddRow(
        "SetNumber", CsgActionEffectPayment, CsgActionConfirmPayment,
        CsgActionParamContractNumber)
    csgActionRegistryAddRow(
        "Select", CsgActionEffectLocal, CsgActionConfirmNone,
        CsgActionParamContractOption)
    csgActionRegistryAddRow(
        "Select", CsgActionEffectSearch, CsgActionConfirmNone,
        CsgActionParamContractOption)
    csgActionRegistryAddRow(
        "Select", CsgActionEffectFilter, CsgActionConfirmNone,
        CsgActionParamContractOption)
    csgActionRegistryAddRow(
        "Select", CsgActionEffectExternalPublish,
        CsgActionConfirmExternalPublish, CsgActionParamContractOption)
    csgActionRegistryAddRow(
        "Select", CsgActionEffectPayment, CsgActionConfirmPayment,
        CsgActionParamContractOption)
    csgActionRegistryAddRow(
        "SelectFile", CsgActionEffectLocal, CsgActionConfirmNone,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SelectFile", CsgActionEffectSearch, CsgActionConfirmNone,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SelectFile", CsgActionEffectFilter, CsgActionConfirmNone,
        CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SelectFile", CsgActionEffectExternalPublish,
        CsgActionConfirmExternalPublish, CsgActionParamContractText)
    csgActionRegistryAddRow(
        "SelectFile", CsgActionEffectPayment, CsgActionConfirmPayment,
        CsgActionParamContractText)
    csgActionLastGrantedRow = 0 - 1
    csgActionLastConsumedRow = 0 - 1
    csgActionRegistryReady = true

# -------------------------------------------------------------------
# 注册表查询 (effectClass 与确认要求的唯一权威)
# -------------------------------------------------------------------

@borrows
fn csgActionRowLookup(actionKind: str, effectClass: str): int32 =
    var i: int32 = 0
    while i < csgActionRegistryActionKinds.len:
        if csgActionRegistryActionKinds[i] == actionKind &&
           csgActionRegistryEffectClasses[i] == effectClass:
            return i
        i = i + 1
    return -1

@borrows
fn csgActionActionRegistered(actionKind: str): bool =
    var i: int32 = 0
    while i < csgActionRegistryActionKinds.len:
        if csgActionRegistryActionKinds[i] == actionKind:
            return true
        i = i + 1
    return false

@borrows
fn CsgActionAuthorityActionRegistered(actionKind: str): bool =
    csgActionEnsureRegistry()
    return csgActionActionRegistered(actionKind)

@borrows
fn CsgActionAuthorityRowLookup(actionKind: str, effectClass: str): int32 =
    csgActionEnsureRegistry()
    return csgActionRowLookup(actionKind, effectClass)

fn CsgActionAuthorityRowRequiresConfirm(row: int32): bool =
    if row < 0 || row >= csgActionRegistryConfirmClasses.len:
        return false
    return csgActionRegistryConfirmClasses[row] != CsgActionConfirmNone

fn CsgActionAuthorityRowVersion(row: int32): int64 =
    if row < 0 || row >= csgActionRegistryVersions.len:
        return int64(0)
    return csgActionRegistryVersions[row]

fn CsgActionAuthorityRowParamContract(row: int32): int32 =
    if row < 0 || row >= csgActionRegistryParamContracts.len:
        return 0
    return csgActionRegistryParamContracts[row]

@borrows
fn CsgActionAuthorityEffectClassRequiresConfirmation(effectClass: str): bool =
    csgActionEnsureRegistry()
    var i: int32 = 0
    while i < csgActionRegistryEffectClasses.len:
        if csgActionRegistryEffectClasses[i] == effectClass:
            return csgActionRegistryConfirmClasses[i] != CsgActionConfirmNone
        i = i + 1
    return false

# 合同版本升级: 单调, 只对该动作的行生效; 旧版本凭证随即失配。
@borrows
fn CsgActionAuthorityAdvanceContractVersion(
        actionKind: str,
        newVersion: int64): bool =
    csgActionEnsureRegistry()
    if newVersion <= int64(0):
        return false
    var changed = false
    var i: int32 = 0
    while i < csgActionRegistryActionKinds.len:
        if csgActionRegistryActionKinds[i] == actionKind &&
           newVersion > csgActionRegistryVersions[i]:
            csgActionRegistryVersions[i] = newVersion
            changed = true
        i = i + 1
    return changed

# -------------------------------------------------------------------
# 快照世代 (执行前重验; 前进即旧凭证整批过期)
# -------------------------------------------------------------------

fn CsgActionAuthorityCurrentGeneration(): int64 =
    return csgActionCurrentGeneration

fn CsgActionAuthorityAdvanceGeneration(newGeneration: int64): bool =
    if newGeneration <= csgActionCurrentGeneration:
        return false
    csgActionCurrentGeneration = newGeneration
    return true

# -------------------------------------------------------------------
# 确认凭证: 签发 / 撤销 / 一次性消费
# -------------------------------------------------------------------

# 凭证绑定动作行 (该动作任一注册行即可, 版本取该动作当前版本), 与
# effectClass 无关: 用户确认的是 "执行某动作", 不是某个声明类。
@borrows
fn CsgActionAuthorityGrantConfirm(actionKind: str, payload: str): bool =
    csgActionEnsureRegistry()
    csgActionLastGrantedRow = 0 - 1
    var actionRow: int32 = -1
    var i: int32 = 0
    while i < csgActionRegistryActionKinds.len:
        if csgActionRegistryActionKinds[i] == actionKind:
            actionRow = i
            break
        i = i + 1
    if actionRow < 0:
        return false
    let credVersion = csgActionRegistryVersions[actionRow]
    let credGeneration = csgActionCurrentGeneration
    add(csgCredRows, actionRow)
    add(csgCredPayloads, strings.CloneStr(payload))
    add(csgCredVersions, credVersion)
    add(csgCredGenerations, credGeneration)
    add(csgCredConsumed, false)
    add(csgCredRevoked, false)
    csgActionLastGrantedRow = csgCredRows.len - 1
    return true

# 最近一次成功签发的凭证行句柄 (签发后同窗口读取; 失败签发复位 -1)。
fn CsgActionAuthorityLastGrantedRow(): int32 =
    return csgActionLastGrantedRow

# 最近一次成功消费的凭证行句柄 (准入后同窗口读取; 每次准入入口复位)。
fn CsgActionAuthorityLastConsumedRow(): int32 =
    return csgActionLastConsumedRow

fn CsgActionAuthorityRevokeConfirmations() =
    var i: int32 = 0
    while i < csgCredRevoked.len:
        if !csgCredConsumed[i] && !csgCredRevoked[i]:
            csgCredRevoked[i] = true
        i = i + 1

# 一次性消费: 精确匹配 (动作行, 参数, 当前版本, 当前世代)。
# 先扫活凭证 (未撤销/未消费/世代与版本相符) 命中即消费; 撤销后的旧凭证
# 不得影子化撤销之后的新签发。无任何活凭证时按最具体失败判词报告:
# 版本失配 > 已消费 > 世代过期 > 撤销; 全无匹配 = 确认门未满足
# (confirmation_required 既有合同 token)。
@borrows
fn CsgActionAuthorityConsumeConfirm(
        actionKind: str,
        payload: str,
        err: var str): bool =
    csgActionEnsureRegistry()
    csgActionLastConsumedRow = 0 - 1
    var actionRow: int32 = -1
    var i: int32 = 0
    while i < csgActionRegistryActionKinds.len:
        if csgActionRegistryActionKinds[i] == actionKind:
            actionRow = i
            break
        i = i + 1
    if actionRow < 0:
        err = strings.CloneStr(CsgActionAuthorityErrActionKind)
        return false
    let version = csgActionRegistryVersions[actionRow]
    var sawRevoked = false
    var sawVersionMismatch = false
    var sawUsed = false
    var sawStaleGeneration = false
    var j: int32 = 0
    while j < csgCredRows.len:
        if csgCredRows[j] == actionRow && csgCredPayloads[j] == payload:
            if csgCredRevoked[j]:
                sawRevoked = true
            elif csgCredGenerations[j] != csgActionCurrentGeneration:
                sawStaleGeneration = true
            elif csgCredVersions[j] != version:
                sawVersionMismatch = true
            elif csgCredConsumed[j]:
                sawUsed = true
            else:
                csgCredConsumed[j] = true
                csgActionLastConsumedRow = j
                err = ""
                return true
        j = j + 1
    if sawVersionMismatch:
        err = strings.CloneStr(CsgActionAuthorityErrVersionMismatch)
        return false
    if sawUsed:
        err = strings.CloneStr(CsgActionAuthorityErrCredentialUsed)
        return false
    if sawStaleGeneration:
        err = strings.CloneStr(CsgActionAuthorityErrStaleGeneration)
        return false
    if sawRevoked:
        err = strings.CloneStr(CsgActionAuthorityErrRevoked)
        return false
    err = strings.CloneStr(CsgActionAuthorityErrConfirmationRequired)
    return false

# -------------------------------------------------------------------
# 权威准入: 调用方只提名动作与参数; effectClass 词表与确认要求
# 全部从注册表读取, 确认类动作必须消费真实凭证, 无调用方布尔通道。
# -------------------------------------------------------------------

@borrows
fn CsgActionAuthorityAdmit(
        actionKind: str,
        effectClass: str,
        payload: str,
        err: var str): bool =
    csgActionEnsureRegistry()
    csgActionLastConsumedRow = 0 - 1
    let row = csgActionRowLookup(actionKind, effectClass)
    if row < 0:
        if !csgActionActionRegistered(actionKind):
            err = strings.CloneStr(CsgActionAuthorityErrActionKind)
            return false
        err = strings.CloneStr(CsgActionAuthorityErrEffectClass)
        return false
    if csgActionRegistryConfirmClasses[row] == CsgActionConfirmNone:
        err = ""
        return true
    if !CsgActionAuthorityConsumeConfirm(actionKind, payload, err):
        return false
    err = ""
    return true

# -------------------------------------------------------------------
# 凭证句柄面 (08 执行层接线): 调用方按凭证表行索引 (签发入口回执的
# LastGrantedRow) 提名要消费的凭证; 消费仍按 (动作行, 参数, 版本, 世代)
# 精确重验, 句柄不匹配/越界 = 可区分判词, 不扫表不近似。
# -------------------------------------------------------------------

@borrows
fn CsgActionAuthorityConsumeConfirmRow(
        actionKind: str,
        payload: str,
        credRow: int32,
        err: var str): bool =
    csgActionEnsureRegistry()
    csgActionLastConsumedRow = 0 - 1
    var actionRow: int32 = -1
    var i: int32 = 0
    while i < csgActionRegistryActionKinds.len:
        if csgActionRegistryActionKinds[i] == actionKind:
            actionRow = i
            break
        i = i + 1
    if actionRow < 0:
        err = strings.CloneStr(CsgActionAuthorityErrActionKind)
        return false
    if credRow < 0 || credRow >= csgCredRows.len:
        err = strings.CloneStr(CsgActionAuthorityErrCredentialHandle)
        return false
    if csgCredRows[credRow] != actionRow:
        err = strings.CloneStr(CsgActionAuthorityErrCredentialHandle)
        return false
    if csgCredRevoked[credRow]:
        err = strings.CloneStr(CsgActionAuthorityErrRevoked)
        return false
    if csgCredGenerations[credRow] != csgActionCurrentGeneration:
        err = strings.CloneStr(CsgActionAuthorityErrStaleGeneration)
        return false
    if csgCredVersions[credRow] != csgActionRegistryVersions[actionRow]:
        err = strings.CloneStr(CsgActionAuthorityErrVersionMismatch)
        return false
    if csgCredPayloads[credRow] != payload:
        err = strings.CloneStr(CsgActionAuthorityErrConfirmationRequired)
        return false
    if csgCredConsumed[credRow]:
        err = strings.CloneStr(CsgActionAuthorityErrCredentialUsed)
        return false
    csgCredConsumed[credRow] = true
    csgActionLastConsumedRow = credRow
    err = ""
    return true

@borrows
fn CsgActionAuthorityAdmitWithCredential(
        actionKind: str,
        effectClass: str,
        payload: str,
        credRow: int32,
        err: var str): bool =
    csgActionEnsureRegistry()
    csgActionLastConsumedRow = 0 - 1
    let row = csgActionRowLookup(actionKind, effectClass)
    if row < 0:
        if !csgActionActionRegistered(actionKind):
            err = strings.CloneStr(CsgActionAuthorityErrActionKind)
            return false
        err = strings.CloneStr(CsgActionAuthorityErrEffectClass)
        return false
    if csgActionRegistryConfirmClasses[row] == CsgActionConfirmNone:
        err = ""
        return true
    return CsgActionAuthorityConsumeConfirmRow(actionKind, payload, credRow, err)
