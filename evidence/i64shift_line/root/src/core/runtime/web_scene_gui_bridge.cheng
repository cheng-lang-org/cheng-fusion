import cheng/core/runtime/web_scene_runtime as scene
import std/gui
import std/media_platform as platform

fn WebSceneMediaSurfaceCommandCanPushLastDecodedTexture(buffer: var scene.WebSceneMediaSurfaceCommandBuffer,
                                                        index: int32,
                                                        drawList: int32): bool =
    if index < 0 || index >= scene.WebSceneMediaSurfaceCommandCount(buffer):
        return false
    if drawList <= 0 || !gui.DrawListIsActive(drawList):
        return false
    if scene.WebSceneMediaSurfaceKindCodeAt(buffer, index) != 1:
        return false
    if scene.WebSceneMediaSurfaceSurfaceKindAt(buffer, index) != "video-first-frame-texture":
        return false
    if scene.WebSceneMediaSurfaceTextureProviderAt(buffer, index) != platform.MediaPlatformDarwinMetalTextureProvider:
        return false
    if scene.WebSceneMediaSurfaceWidthAt(buffer, index) <= 0 ||
       scene.WebSceneMediaSurfaceHeightAt(buffer, index) <= 0:
        return false
    return gui.MediaDarwinLastTextureReady()

fn WebScenePushMediaSurfaceCommandToDrawList(buffer: var scene.WebSceneMediaSurfaceCommandBuffer,
                                             index: int32,
                                             drawList: int32): bool =
    if !WebSceneMediaSurfaceCommandCanPushLastDecodedTexture(buffer, index, drawList):
        return false
    if !gui.DrawListPushLastDecodedTexture(drawList):
        return false
    if !gui.DrawListSetLastTextureRect(drawList,
                                       scene.WebSceneMediaSurfaceXAt(buffer, index),
                                       scene.WebSceneMediaSurfaceYAt(buffer, index)):
        return false
    return gui.DrawListSetLastTextureSize(drawList,
                                          scene.WebSceneMediaSurfaceWidthAt(buffer, index),
                                          scene.WebSceneMediaSurfaceHeightAt(buffer, index))
