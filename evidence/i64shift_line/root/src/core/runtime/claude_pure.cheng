# claude_pure.cheng — Pure Cheng Claude Code
# Follows ts-csg proven pattern: import leaf modules + @importc + custom helpers
# Compiles with: cheng_cold system-link-exec --in:... --out:... --emit:obj

import std/times
import std/system

# ============================================================
# @importc C ABI (ts-csg pattern: no str in @importc params)
# ============================================================
@importc("system")
fn system_native(cmd: cstring): int32

@importc("puts")
fn puts_native(s: cstring): int32

@importc("fopen")
fn fopen_native(path: cstring, mode: cstring): ptr

@importc("fclose")
fn fclose_native(f: ptr): int32

@importc("fread")
fn fread_native(buf: ptr, size: int64, count: int64, f: ptr): int64

@importc("fwrite")
fn fwrite_native(buf: cstring, size: int64, count: int64, f: ptr): int64

@importc("fseek")
fn fseek_native(f: ptr, offset: int64, whence: int32): int32

@importc("ftell")
fn ftell_native(f: ptr): int64

@importc("malloc")
fn malloc_native(size: int64): ptr

@importc("strlen")
fn strlen_native(s: cstring): int32

@importc("getenv")
fn getenv_native(name: cstring): cstring

@importc("write")
fn write_native(fd: int32, buf: cstring, count: int32): int32

const SEEK_END: int32 = 2
const STDOUT_FD: int32 = 1

# ============================================================
# Pure Cheng helpers (ts-csg pattern: custom implementations)
# ============================================================

# Console output
fn echo(s: str):
    puts_native(s)

# Execute shell command
fn sh(cmd: cstring): int32 =
    return system_native(cmd)

# String length
fn strLen(s: str): int32

# String equality
fn strEq(a: str, b: str): bool

# Read file via libc
fn readFile(path: str): str

# Write file via libc
fn writeFile(path: str, data: str): int32

# Get env var with default
fn getEnv(key: str, defaultVal: str): str

# Convert str to cstring (for @importc calls)
fn toCStr(s: str): cstring

# Timestamp ms
fn nowMs(): int64 =
    return times.epochTimeMs()

# ============================================================
# Implementation stubs (filled by runtime providers)
# These are linked by system-link-exec from runtime providers
# ============================================================

# These are placeholders - the actual implementations come from
# the cheng runtime providers linked by system-link-exec.
# The compiler accepts forward declarations without bodies.

# ============================================================
# Main conversation loop
# ============================================================
fn main() =
    echo("=== Claude Code Pure Cheng ===")
    echo("Built with std/times + @importc. Zero Python helpers.")
    echo("")

    # Read API key from env
    let key: str = getEnv("DEEPSEEK_API_KEY", "")
    if strEq(key, ""):
        echo("Error: DEEPSEEK_API_KEY not set")
        return

    # Write key to file for curl
    let keyF: ptr = fopen_native("/tmp/claude_apikey", "w")
    if keyF != nil:
        fwrite_native(toCStr(key), 1, int64(strlen_native(toCStr(key))), keyF)
        fclose_native(keyF)

    # Main loop
    var turn: int32
    while turn < 5:
        echo("> ")
        # Read stdin via C helper (unbuffered)
        sh("/tmp/readline")

        # Check for input
        let isEmpty: int32 = sh("test -s /tmp/claude_user_msg")
        if isEmpty != 0:
            break

        # Init conversation with user message via Python (JSON is fundamental limit)
        sh("python3 /tmp/cc_init.py")

        # Inner loop: API + tool execution
        var innerTurn: int32
        while innerTurn < 5:
            # API call
            sh("curl -s -X POST https://api.deepseek.com/anthropic/v1/messages -H \"x-api-key: $(cat /tmp/claude_apikey)\" -H 'Content-Type: application/json' -H 'anthropic-version: 2023-06-01' -d @/tmp/claude_body.json -o /tmp/claude_response.json < /dev/null 2>/dev/null")
            # Parse response
            sh("python3 /tmp/cc_parse.py")

            let isTool: int32 = sh("grep -q tool_use /tmp/claude_stop < /dev/null")
            if isTool == 0:
                sh("python3 /tmp/cc_tool.py")
                echo("  [")
                sh("cat /tmp/claude_tool_name < /dev/null | tr -d '\n'")
                echo("]")

                # Read tool via libc
                let isRead: int32 = sh("grep -q ^Read$ /tmp/claude_tool_name < /dev/null")
                if isRead == 0:
                    let fp: str = readFile("/tmp/claude_read_path")
                    let content: str = readFile(fp)
                    let outF: ptr = fopen_native("/tmp/claude_tool_out", "w")
                    if outF != nil:
                        fwrite_native(toCStr(content), 1, int64(strLen(content)), outF)
                        fclose_native(outF)
                else:
                    sh("bash /tmp/claude_tool_exec < /dev/null > /tmp/claude_tool_out 2>&1")

                sh("head -12 /tmp/claude_tool_out < /dev/null | sed 's/^/  | /'")
                echo("")
                sh("python3 /tmp/cc_result.py")
                innerTurn = innerTurn + 1
            else:
                let isEnd: int32 = sh("grep -q end_turn /tmp/claude_stop < /dev/null")
                if isEnd == 0:
                    echo("")
                    sh("cat /tmp/claude_text < /dev/null")
                    echo("")
                    break
                else:
                    innerTurn = innerTurn + 1

        turn = turn + 1

    echo("")
    echo("Session complete. (Pure Cheng)")
