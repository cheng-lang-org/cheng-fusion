# web_indexeddb_runtime.cheng
# IndexedDB API for Cheng Web runtime (in-memory with file persistence)

import std/system

importc fn cheng_fs_write_file(path: ptr, pathLen: int32, data: ptr, dataLen: int32): bool
importc fn cheng_fs_read_file(path: ptr, pathLen: int32, outData: ptr, outLen: var int32): bool

const
    WebIDBPersistDir = "/tmp/"

type
    WebIDBObjectStore =
        name: str
        keyPath: str
        autoIncrement: bool
        records: WebIDBRecord[]
        nextAutoKey: int32

    WebIDBRecord =
        key: str
        value: str

    WebIDBTransaction =
        storeName: str
        mode: str
        objectStore: WebIDBObjectStore
        dbName: str
        transactionId: int32

    WebIDBDatabase =
        name: str
        version: int32
        objectStores: WebIDBObjectStore[]

    WebIDBRequest =
        requestId: int32
        readyState: str
        result: str
        error: str
        onsuccess: int32
        onerror: int32

const
    WebIDBRequestPending = 0
    WebIDBRequestDone = 1
    WebIDBTransactionReadonly = 0
    WebIDBTransactionReadwrite = 1

var idbDatabases: WebIDBDatabase[]
var idbRequests: WebIDBRequest[]
var idbTransactions: WebIDBTransaction[]
var nextRequestId: int32 = 1
var nextTransactionId: int32 = 1

# ──────────────────────────────────────
# Internal helpers
# ──────────────────────────────────────

fn WebIDBDatabaseFindIndex(name: str): int32 =
    for i in 0..<idbDatabases.len:
        if idbDatabases[i].name == name:
            return i
    return -1

fn WebIDBObjectStoreFindIndex(dbIndex: int32, storeName: str): int32 =
    if dbIndex < 0 || dbIndex >= idbDatabases.len:
        return -1
    var db = idbDatabases[dbIndex]
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            return i
    return -1

fn WebIDBRecordFindIndex(dbIndex: int32, storeIndex: int32, key: str): int32 =
    if dbIndex < 0 || dbIndex >= idbDatabases.len:
        return -1
    var db = idbDatabases[dbIndex]
    if storeIndex < 0 || storeIndex >= db.objectStores.len:
        return -1
    var store = db.objectStores[storeIndex]
    for i in 0..<store.records.len:
        if store.records[i].key == key:
            return i
    return -1

fn WebIDBTransactionFindIndex(transactionId: int32): int32 =
    for i in 0..<idbTransactions.len:
        if idbTransactions[i].transactionId == transactionId:
            return i
    return -1

fn WebIDBRequestNew(onsuccess: int32, onerror: int32): int32 =
    let rid = nextRequestId
    nextRequestId = nextRequestId + 1
    var req: WebIDBRequest
    req.requestId = rid
    req.readyState = "pending"
    req.result = ""
    req.error = ""
    req.onsuccess = onsuccess
    req.onerror = onerror
    add(idbRequests, req)
    return rid

fn WebIDBRequestComplete(requestId: int32, result: str) =
    for i in 0..<idbRequests.len:
        if idbRequests[i].requestId == requestId:
            var req = idbRequests[i]
            req.readyState = "done"
            req.result = result
            idbRequests[i] = req
            return

fn WebIDBRequestFail(requestId: int32, error: str) =
    for i in 0..<idbRequests.len:
        if idbRequests[i].requestId == requestId:
            var req = idbRequests[i]
            req.readyState = "done"
            req.error = error
            idbRequests[i] = req
            return

# Extract the string value of a JSON field matching the given keyPath.
# Handles quoted string values and numeric values.
# Example: value='{"id":42,"name":"test"}', keyPath="id" -> out="42"
fn WebIDBExtractJsonField(value: str, fieldName: str, out: var str): bool =
    if value.len <= 0 || fieldName.len <= 0:
        out = ""
        return false
    # Scan for '"fieldName":' in value string
    var i: int32 = 1
    while i < value.len:
        if value[i] != '"':
            i = i + 1
            continue
        # Check if the quoted text matches fieldName
        var vi = i + 1
        var matched = true
        for fi in 0..<fieldName.len:
            if vi >= value.len || value[vi] != fieldName[fi]:
                matched = false
                break
            vi = vi + 1
        if !matched || vi >= value.len || value[vi] != '"':
            i = i + 1
            continue
        vi = vi + 1
        # Skip whitespace before ':'
        while vi < value.len && value[vi] == ' ':
            vi = vi + 1
        if vi >= value.len || value[vi] != ':':
            i = i + 1
            continue
        vi = vi + 1
        # Skip whitespace after ':'
        while vi < value.len && value[vi] == ' ':
            vi = vi + 1
        if vi >= value.len:
            out = ""
            return false
        let ch = value[vi]
        if ch == '"':
            # Quoted string value
            vi = vi + 1
            let start = vi
            while vi < value.len && value[vi] != '"':
                vi = vi + 1
            if vi >= value.len:
                out = ""
                return false
            var result = ""
            for idx in start..<vi:
                result = result + value[idx]
            out = result
            return true
        elif (ch >= '0' && ch <= '9') || ch == '-':
            # Numeric value (integer or float)
            let start = vi
            while vi < value.len &&
                  ((value[vi] >= '0' && value[vi] <= '9') ||
                   value[vi] == '-' || value[vi] == '.' ||
                   value[vi] == 'e' || value[vi] == 'E' ||
                   value[vi] == '+') :
                vi = vi + 1
            var result = ""
            for idx in start..<vi:
                result = result + value[idx]
            out = result
            return true
        elif ch == 't' || ch == 'f':
            # Boolean value
            let start = vi
            while vi < value.len && ((value[vi] >= 'a' && value[vi] <= 'z') || (value[vi] >= 'A' && value[vi] <= 'Z')):
                vi = vi + 1
            var result = ""
            for idx in start..<vi:
                result = result + value[idx]
            out = result
            return true
        out = ""
        return false
    out = ""
    return false

# ──────────────────────────────────────
# Database operations
# ──────────────────────────────────────

fn WebIDBOpen(name: str, version: int32, onupgradeneeded: int32, onsuccess: int32, onerror: int32): int32 =
    let rid = WebIDBRequestNew(onsuccess, onerror)
    # Try to restore from persistence first
    WebIDBRestore(name)
    let dbIndex = WebIDBDatabaseFindIndex(name)
    if dbIndex < 0:
        var db: WebIDBDatabase
        db.name = name
        db.version = version
        db.objectStores = []
        add(idbDatabases, db)
        WebIDBRequestComplete(rid, name)
    else:
        var db = idbDatabases[dbIndex]
        if version > db.version:
            db.version = version
            db.objectStores = []
            idbDatabases[dbIndex] = db
        WebIDBRequestComplete(rid, name)
    return rid

fn WebIDBDeleteDatabase(name: str): bool =
    let dbIndex = WebIDBDatabaseFindIndex(name)
    if dbIndex < 0:
        return false
    var next: WebIDBDatabase[]
    for i in 0..<idbDatabases.len:
        if i != dbIndex:
            add(next, idbDatabases[i])
    idbDatabases = next
    return true

# ──────────────────────────────────────
# Object Store operations (called during onupgradeneeded)
# ──────────────────────────────────────

fn WebIDBCreateObjectStore(dbName: str, storeName: str, keyPath: str, autoIncrement: bool): bool =
    let dbIndex = WebIDBDatabaseFindIndex(dbName)
    if dbIndex < 0:
        return false
    var db = idbDatabases[dbIndex]
    # Check for duplicate store name
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            return false
    var store: WebIDBObjectStore
    store.name = storeName
    store.keyPath = keyPath
    store.autoIncrement = autoIncrement
    store.records = []
    store.nextAutoKey = 1
    add(db.objectStores, store)
    idbDatabases[dbIndex] = db
    return true

# ──────────────────────────────────────
# Transaction operations
# ──────────────────────────────────────

fn WebIDBTransaction(dbName: str, storeNames: str[], mode: int32): int32 =
    let dbIndex = WebIDBDatabaseFindIndex(dbName)
    if dbIndex < 0:
        return 0
    if storeNames.len <= 0:
        return 0
    let storeName = storeNames[0]
    var db = idbDatabases[dbIndex]
    var storeIndex: int32 = -1
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            storeIndex = i
            break
    if storeIndex < 0:
        return 0
    let txnId = nextTransactionId
    nextTransactionId = nextTransactionId + 1
    var txn: WebIDBTransaction
    txn.storeName = storeName
    txn.mode = (mode == WebIDBTransactionReadonly) ? "readonly" : "readwrite"
    txn.objectStore = db.objectStores[storeIndex]
    txn.dbName = dbName
    txn.transactionId = txnId
    add(idbTransactions, txn)
    return txnId

# ──────────────────────────────────────
# CRUD operations
# ──────────────────────────────────────

fn WebIDBResolveKey(db: var WebIDBDatabase, storeIndex: int32, value: str, key: str, out: var str): bool =
    if key.len > 0:
        out = key
        return true
    var store = db.objectStores[storeIndex]
    if store.keyPath.len > 0:
        if WebIDBExtractJsonField(value, store.keyPath, out):
            return true
    if store.autoIncrement:
        let autoKey = store.nextAutoKey
        out = Fmt"{autoKey}"
        store.nextAutoKey = autoKey + 1
        db.objectStores[storeIndex] = store
        return true
    out = ""
    return false

fn WebIDBAdd(transactionId: int32, storeName: str, value: str, key: str): int32 =
    let txnIndex = WebIDBTransactionFindIndex(transactionId)
    if txnIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction not found")
        return rid
    var txn = idbTransactions[txnIndex]
    if txn.mode != "readwrite":
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction is not readwrite")
        return rid
    let dbIndex = WebIDBDatabaseFindIndex(txn.dbName)
    if dbIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Database not found")
        return rid
    var db = idbDatabases[dbIndex]
    var storeIndex: int32 = -1
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            storeIndex = i
            break
    if storeIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Object store not found")
        return rid
    var recordKey: str
    if !WebIDBResolveKey(db, storeIndex, value, key, recordKey):
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Unable to determine key")
        return rid
    # Check for duplicate key (Add must not overwrite)
    var store = db.objectStores[storeIndex]
    var recIndex: int32 = -1
    for i in 0..<store.records.len:
        if store.records[i].key == recordKey:
            recIndex = i
            break
    if recIndex >= 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Key already exists")
        return rid
    var rec: WebIDBRecord
    rec.key = recordKey
    rec.value = value
    add(store.records, rec)
    db.objectStores[storeIndex] = store
    idbDatabases[dbIndex] = db
    WebIDBPersist(txn.dbName)
    let rid = WebIDBRequestNew(0, 0)
    WebIDBRequestComplete(rid, recordKey)
    return rid

fn WebIDBGet(transactionId: int32, storeName: str, key: str, out: var str): bool =
    let txnIndex = WebIDBTransactionFindIndex(transactionId)
    if txnIndex < 0:
        out = ""
        return false
    var txn = idbTransactions[txnIndex]
    let dbIndex = WebIDBDatabaseFindIndex(txn.dbName)
    if dbIndex < 0:
        out = ""
        return false
    var db = idbDatabases[dbIndex]
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            var store = db.objectStores[i]
            for j in 0..<store.records.len:
                if store.records[j].key == key:
                    out = store.records[j].value
                    return true
            out = ""
            return false
    out = ""
    return false

fn WebIDBPut(transactionId: int32, storeName: str, value: str, key: str): int32 =
    let txnIndex = WebIDBTransactionFindIndex(transactionId)
    if txnIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction not found")
        return rid
    var txn = idbTransactions[txnIndex]
    if txn.mode != "readwrite":
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction is not readwrite")
        return rid
    let dbIndex = WebIDBDatabaseFindIndex(txn.dbName)
    if dbIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Database not found")
        return rid
    var db = idbDatabases[dbIndex]
    var storeIndex: int32 = -1
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            storeIndex = i
            break
    if storeIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Object store not found")
        return rid
    var recordKey: str
    if !WebIDBResolveKey(db, storeIndex, value, key, recordKey):
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Unable to determine key")
        return rid
    var store = db.objectStores[storeIndex]
    var recIndex: int32 = -1
    for i in 0..<store.records.len:
        if store.records[i].key == recordKey:
            recIndex = i
            break
    if recIndex >= 0:
        store.records[recIndex].value = value
    else:
        var rec: WebIDBRecord
        rec.key = recordKey
        rec.value = value
        add(store.records, rec)
    db.objectStores[storeIndex] = store
    idbDatabases[dbIndex] = db
    WebIDBPersist(txn.dbName)
    let rid = WebIDBRequestNew(0, 0)
    WebIDBRequestComplete(rid, recordKey)
    return rid

fn WebIDBDelete(transactionId: int32, storeName: str, key: str): int32 =
    let txnIndex = WebIDBTransactionFindIndex(transactionId)
    if txnIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction not found")
        return rid
    var txn = idbTransactions[txnIndex]
    if txn.mode != "readwrite":
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction is not readwrite")
        return rid
    let dbIndex = WebIDBDatabaseFindIndex(txn.dbName)
    if dbIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Database not found")
        return rid
    var db = idbDatabases[dbIndex]
    var storeIndex: int32 = -1
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            storeIndex = i
            break
    if storeIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Object store not found")
        return rid
    var store = db.objectStores[storeIndex]
    var recIndex: int32 = -1
    for i in 0..<store.records.len:
        if store.records[i].key == key:
            recIndex = i
            break
    if recIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Record not found")
        return rid
    var nextRecords: WebIDBRecord[]
    for i in 0..<store.records.len:
        if i != recIndex:
            add(nextRecords, store.records[i])
    store.records = nextRecords
    db.objectStores[storeIndex] = store
    idbDatabases[dbIndex] = db
    WebIDBPersist(txn.dbName)
    let rid = WebIDBRequestNew(0, 0)
    WebIDBRequestComplete(rid, key)
    return rid

# ──────────────────────────────────────
# Cursor operation
# ──────────────────────────────────────

fn WebIDBCursorOpen(transactionId: int32, storeName: str, outKeys: var str[], outValues: var str[]): bool =
    let txnIndex = WebIDBTransactionFindIndex(transactionId)
    if txnIndex < 0:
        outKeys = []
        outValues = []
        return false
    var txn = idbTransactions[txnIndex]
    let dbIndex = WebIDBDatabaseFindIndex(txn.dbName)
    if dbIndex < 0:
        outKeys = []
        outValues = []
        return false
    var db = idbDatabases[dbIndex]
    for storeIdx in 0..<db.objectStores.len:
        if db.objectStores[storeIdx].name == storeName:
            var store = db.objectStores[storeIdx]
            var keys: str[]
            var values: str[]
            for ri in 0..<store.records.len:
                add(keys, store.records[ri].key)
                add(values, store.records[ri].value)
            outKeys = keys
            outValues = values
            return true
    outKeys = []
    outValues = []
    return false

# ──────────────────────────────────────
# JSON helpers
# ──────────────────────────────────────

fn strCat(a: str, b: str): str = Fmt"{a}{b}"

# JSON-encode a string value (escape special characters)
fn WebIDBJsonEncode(value: str): str =
    var out: str
    for i in 0..<value.len:
        let c = value[i]
        if c == '"':
            out = out + '\\'
            out = out + '"'
        elif c == '\\':
            out = out + '\\'
            out = out + '\\'
        elif c == '\n':
            out = out + '\\'
            out = out + 'n'
        elif c == '\t':
            out = out + '\\'
            out = out + 't'
        else:
            out = out + c
    return out

# JSON-decode: extract the value for a given key from a JSON string.
# Handles quoted strings (un-escapes), nested objects/arrays, numbers, booleans.
fn WebIDBJsonDecode(json: str, key: str, out: var str): bool =
    if json.len <= 0 || key.len <= 0:
        out = ""
        return false
    var i: int32
    while i < json.len:
        if json[i] != '"':
            i = i + 1
            continue
        # Check if quoted text matches key
        var vi = i + 1
        var matched = true
        for ki in 0..<key.len:
            if vi >= json.len || json[vi] != key[ki]:
                matched = false
                break
            vi = vi + 1
        if !matched || vi >= json.len || json[vi] != '"':
            i = i + 1
            continue
        vi = vi + 1
        # Skip whitespace and ':'
        while vi < json.len && (json[vi] == ' ' || json[vi] == '\t' || json[vi] == '\n' || json[vi] == '\r'):
            vi = vi + 1
        if vi >= json.len || json[vi] != ':':
            i = i + 1
            continue
        vi = vi + 1
        while vi < json.len && (json[vi] == ' ' || json[vi] == '\t' || json[vi] == '\n' || json[vi] == '\r'):
            vi = vi + 1
        if vi >= json.len:
            out = ""
            return false
        let ch = json[vi]
        if ch == '"':
            # Quoted string: un-escape and return
            vi = vi + 1
            var result: str
            while vi < json.len:
                if json[vi] == '\\':
                    vi = vi + 1
                    if vi >= json.len:
                        break
                    if json[vi] == '"':
                        result = result + '"'
                    elif json[vi] == '\\':
                        result = result + '\\'
                    elif json[vi] == 'n':
                        result = result + '\n'
                    elif json[vi] == 't':
                        result = result + '\t'
                    else:
                        result = result + '\\'
                        result = result + json[vi]
                    vi = vi + 1
                elif json[vi] == '"':
                    break
                else:
                    result = result + json[vi]
                    vi = vi + 1
            out = result
            return true
        elif ch == '{' || ch == '[':
            # Object or array: extract with balanced bracket matching
            let openChar = ch
            var closeChar: char = (openChar == '{') ? '}' : ']'
            var depth: int32 = 1
            var start = vi
            vi = vi + 1
            while vi < json.len && depth > 0:
                if json[vi] == '"':
                    # Skip string content (handle escapes inside)
                    vi = vi + 1
                    while vi < json.len:
                        if json[vi] == '\\':
                            vi = vi + 1
                        elif json[vi] == '"':
                            break
                        vi = vi + 1
                elif json[vi] == openChar:
                    depth = depth + 1
                elif json[vi] == closeChar:
                    depth = depth - 1
                vi = vi + 1
            var result: str
            let end = vi
            for idx in start..<end:
                result = result + json[idx]
            out = result
            return true
        else:
            # Number or boolean: extract until delimiter
            var result: str
            while vi < json.len && json[vi] != ',' && json[vi] != '}' && json[vi] != ']' && json[vi] != ' ' && json[vi] != '\t' && json[vi] != '\n' && json[vi] != '\r':
                result = result + json[vi]
                vi = vi + 1
            out = result
            return true
    out = ""
    return false

# ──────────────────────────────────────
# Persistence
# ──────────────────────────────────────

fn WebIDBPersist(dbName: str): bool =
    let dbIndex = WebIDBDatabaseFindIndex(dbName)
    if dbIndex < 0:
        return false
    var db = idbDatabases[dbIndex]
    var json: str
    json = strCat(json, "{\"name\":\"")
    json = Fmt"{json}{WebIDBJsonEncode(db.name)}"
    json = strCat(json, "\",\"version\":")
    json = Fmt"{json}{db.version}"
    json = strCat(json, ",\"stores\":[")
    for si in 0..<db.objectStores.len:
        if si > 0:
            json = strCat(json, ",")
        json = strCat(json, "{\"name\":\"")
        json = Fmt"{json}{WebIDBJsonEncode(db.objectStores[si].name)}"
        json = strCat(json, "\",\"keyPath\":\"")
        json = Fmt"{json}{WebIDBJsonEncode(db.objectStores[si].keyPath)}"
        json = strCat(json, "\",\"records\":[")
        var store = db.objectStores[si]
        for ri in 0..<store.records.len:
            if ri > 0:
                json = strCat(json, ",")
            json = strCat(json, "{\"key\":\"")
            json = Fmt"{json}{WebIDBJsonEncode(store.records[ri].key)}"
            json = strCat(json, "\",\"value\":\"")
            json = Fmt"{json}{WebIDBJsonEncode(store.records[ri].value)}"
            json = strCat(json, "\"}")
        json = strCat(json, "]}")
    json = strCat(json, "]}")
    let path = Fmt"{WebIDBPersistDir}cheng_idb_{dbName}.json"
    return cheng_fs_write_file(StrDataPtr(path), path.len, StrDataPtr(json), json.len)

# Restore a database from JSON, called by WebIDBRestore.
fn WebIDBRestoreFromJson(json: str): bool =
    var pos: int32
    # Extract db name
    var dbName: str
    if !WebIDBJsonDecode(json, "name", dbName):
        return false
    if dbName.len <= 0:
        return false
    # Extract version
    var versionStr: str
    var version: int32 = 1
    if WebIDBJsonDecode(json, "version", versionStr) && versionStr.len > 0:
        # Parse version as int32
        var versionVal: int32
        var neg: bool
        var vi: int32
        if vi < versionStr.len && versionStr[vi] == '-':
            neg = true
            vi = vi + 1
        while vi < versionStr.len && versionStr[vi] >= '0' && versionStr[vi] <= '9':
            versionVal = versionVal * 10 + int32(versionStr[vi] - '0')
            vi = vi + 1
        if neg:
            versionVal = 0 - versionVal
        if versionVal > 0:
            version = versionVal
    # Check if db already exists
    var dbIndex = WebIDBDatabaseFindIndex(dbName)
    if dbIndex < 0:
        # Create new database entry
        var db: WebIDBDatabase
        db.name = dbName
        db.version = version
        db.objectStores = []
        add(idbDatabases, db)
        dbIndex = idbDatabases.len - 1
    else:
        var db = idbDatabases[dbIndex]
        db.version = version
        db.objectStores = []
        idbDatabases[dbIndex] = db
    # Extract stores array
    var storesJson: str
    if !WebIDBJsonDecode(json, "stores", storesJson):
        return true  # No stores is OK
    if storesJson.len <= 1:
        return true  # Empty array is OK
    # Parse stores array elements
    var si: int32 = 1  # Skip opening '['
    while si < storesJson.len:
        # Skip whitespace and commas
        while si < storesJson.len && (storesJson[si] == ' ' || storesJson[si] == ',' || storesJson[si] == '\t' || storesJson[si] == '\n' || storesJson[si] == '\r'):
            si = si + 1
        if si >= storesJson.len || storesJson[si] == ']':
            break
        if storesJson[si] != '{':
            break
        # Extract store object using bracket matching
        var depth: int32 = 1
        var objStart = si
        si = si + 1
        while si < storesJson.len && depth > 0:
            if storesJson[si] == '"':
                si = si + 1
                while si < storesJson.len:
                    if storesJson[si] == '\\':
                        si = si + 1
                    elif storesJson[si] == '"':
                        break
                    si = si + 1
            elif storesJson[si] == '{':
                depth = depth + 1
            elif storesJson[si] == '}':
                depth = depth - 1
            si = si + 1
        var storeObj: str
        for idx in objStart..<si:
            storeObj = storeObj + storesJson[idx]
        # Extract store name
        var storeName: str
        if !WebIDBJsonDecode(storeObj, "name", storeName):
            continue
        # Extract keyPath
        var keyPath: str
        if !WebIDBJsonDecode(storeObj, "keyPath", keyPath):
            keyPath = ""
        # Create the store directly
        var db = idbDatabases[dbIndex]
        var newStore: WebIDBObjectStore
        newStore.name = storeName
        newStore.keyPath = keyPath
        newStore.autoIncrement = false
        newStore.records = []
        newStore.nextAutoKey = 1
        add(db.objectStores, newStore)
        idbDatabases[dbIndex] = db
        # Extract records array
        var recordsJson: str
        if !WebIDBJsonDecode(storeObj, "records", recordsJson):
            continue
        if recordsJson.len <= 1:
            continue
        # Parse record elements
        var ri: int32 = 1  # Skip opening '['
        while ri < recordsJson.len:
            while ri < recordsJson.len && (recordsJson[ri] == ' ' || recordsJson[ri] == ',' || recordsJson[ri] == '\t' || recordsJson[ri] == '\n' || recordsJson[ri] == '\r'):
                ri = ri + 1
            if ri >= recordsJson.len || recordsJson[ri] == ']':
                break
            if recordsJson[ri] != '{':
                break
            depth = 1
            var recStart = ri
            ri = ri + 1
            while ri < recordsJson.len && depth > 0:
                if recordsJson[ri] == '"':
                    ri = ri + 1
                    while ri < recordsJson.len:
                        if recordsJson[ri] == '\\':
                            ri = ri + 1
                        elif recordsJson[ri] == '"':
                            break
                        ri = ri + 1
                elif recordsJson[ri] == '{':
                    depth = depth + 1
                elif recordsJson[ri] == '}':
                    depth = depth - 1
                ri = ri + 1
            var recObj: str
            for idx in recStart..<ri:
                recObj = recObj + recordsJson[idx]
            # Extract key and value
            var recKey: str
            var recValue: str
            if !WebIDBJsonDecode(recObj, "key", recKey):
                continue
            if !WebIDBJsonDecode(recObj, "value", recValue):
                continue
            # Add record
            var curDb = idbDatabases[dbIndex]
            var curStore = curDb.objectStores[curDb.objectStores.len - 1]
            var rec: WebIDBRecord
            rec.key = recKey
            rec.value = recValue
            add(curStore.records, rec)
            curDb.objectStores[curDb.objectStores.len - 1] = curStore
            idbDatabases[dbIndex] = curDb
    return true

fn WebIDBRestore(dbName: str): bool =
    let path = Fmt"{WebIDBPersistDir}cheng_idb_{dbName}.json"
    var buf: int32[]
    setLen(buf, 65536)
    var actualLen: int32
    if !cheng_fs_read_file(StrDataPtr(path), path.len, ptr(buf), actualLen):
        return false
    if actualLen <= 0:
        return false
    let json: str = NewStringCopy(ptr(buf), actualLen)
    return WebIDBRestoreFromJson(json)

# ──────────────────────────────────────
# Clear operation
# ──────────────────────────────────────

fn WebIDBClear(transactionId: int32, storeName: str): int32 =
    let txnIndex = WebIDBTransactionFindIndex(transactionId)
    if txnIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction not found")
        return rid
    var txn = idbTransactions[txnIndex]
    if txn.mode != "readwrite":
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Transaction is not readwrite")
        return rid
    let dbIndex = WebIDBDatabaseFindIndex(txn.dbName)
    if dbIndex < 0:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Database not found")
        return rid
    var db = idbDatabases[dbIndex]
    var found: bool
    for i in 0..<db.objectStores.len:
        if db.objectStores[i].name == storeName:
            var store = db.objectStores[i]
            store.records = []
            store.nextAutoKey = 1
            db.objectStores[i] = store
            found = true
            break
    if !found:
        let rid = WebIDBRequestNew(0, 0)
        WebIDBRequestFail(rid, "Object store not found")
        return rid
    idbDatabases[dbIndex] = db
    WebIDBPersist(txn.dbName)
    let rid = WebIDBRequestNew(0, 0)
    WebIDBRequestComplete(rid, "")
    return rid
