import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_store_codec
import cheng/core/runtime/production_held_exec_admission_proof_codec as admission_codec

const
    ProductionTerminalJournalClaimedRecordBytes: int32 = 512
    ProductionTerminalJournalClaimedPhase: int32 = 1
    ProductionTerminalJournalDecisionNone: int32 = 0
    ProductionTerminalJournalClaimedSchemaVersion: int32 = 2
    productionTerminalJournalMagic0: int32 = 67
    productionTerminalJournalMagic1: int32 = 84
    productionTerminalJournalMagic2: int32 = 74
    productionTerminalJournalMagic3: int32 = 82
    productionTerminalJournalSessionDomain: str =
        "cheng.runtime.held_exec.terminal_journal.session.v2"
    productionTerminalJournalRecordDomain: str =
        "cheng.runtime.held_exec.terminal_journal.record.v2"

type
    ProductionTerminalJournalClaimedRecord =
        canonical: str
        sessionCid: str
        recordReceiptCid: str
        claimReceiptCid: str
        ownerClaimReceiptCid: str
        rootOwnerBindingCid: str
        admissionProofReceiptCid: str
        childBirthReceiptCid: str
        childPid: int32 = -1
        childUid: uint32
        childGid: uint32
        childBirthPlatform: int32
        childBirth0: uint64
        childBirth1: uint64

@borrows
fn ProductionTerminalJournalAdmissionProofReceiptStrictInto(
        admissionProofCanonical: str,
        expectedRootOwnerBindingCid: str,
        expectedClaimReceiptCid: str,
        expectedOwnerClaimReceiptCid: str,
        outReceiptCid: var str): bool =
    outReceiptCid = ""
    var proof: admission_codec.ProductionHeldExecAdmissionProof
    if !admission_codec.ProductionHeldExecAdmissionProofDecodeStrictInto(
           admissionProofCanonical, proof) ||
       proof.rootOwnerBindingCid != expectedRootOwnerBindingCid ||
       proof.claimReceiptCid != expectedClaimReceiptCid ||
       proof.ownerClaimReceiptCid != expectedOwnerClaimReceiptCid:
        return false
    outReceiptCid = strings.CloneStr(proof.receiptCid)
    return true

fn productionTerminalJournalCodecPutU32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: uint32) =
    rawbytes.BytesSet(bytes, offset, int32(value & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 1, int32((value >> 8) & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 2, int32((value >> 16) & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 3, int32((value >> 24) & uint32(255)))

fn productionTerminalJournalCodecPutU64(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: uint64) =
    for byteIndex in 0..<8:
        rawbytes.BytesSet(
            bytes,
            offset + byteIndex,
            int32((value >> uint64(byteIndex * 8)) & uint64(255)))

@borrows
fn productionTerminalJournalCodecPutFixed32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<32:
        rawbytes.BytesSet(
            bytes, offset + byteIndex, int32(value.data[byteIndex]))

@borrows
fn productionTerminalJournalCodecGetU32(
        bytes: rawbytes.Bytes,
        offset: int32): uint32 =
    return uint32(rawbytes.BytesGet(bytes, offset) & 255) |
        (uint32(rawbytes.BytesGet(bytes, offset + 1) & 255) << 8) |
        (uint32(rawbytes.BytesGet(bytes, offset + 2) & 255) << 16) |
        (uint32(rawbytes.BytesGet(bytes, offset + 3) & 255) << 24)

@borrows
fn productionTerminalJournalCodecGetU64(
        bytes: rawbytes.Bytes,
        offset: int32): uint64 =
    var value: uint64
    for byteIndex in 0..<8:
        value = value |
            (uint64(rawbytes.BytesGet(bytes, offset + byteIndex) & 255) <<
             uint64(byteIndex * 8))
    return value

@borrows
fn productionTerminalJournalCodecGetFixed32Into(
        bytes: rawbytes.Bytes,
        offset: int32,
        out: var layout.FixedBytes32) =
    for byteIndex in 0..<32:
        out.data[byteIndex] = uint8(
            rawbytes.BytesGet(bytes, offset + byteIndex) & 255)

@borrows
fn productionTerminalJournalCodecCidDigestInto(
        cid: str,
        out: var layout.FixedBytes32): bool =
    return merkle_store_codec.csgStoreCodecParseCid(cid, out) &&
        !layout.FixedBytes32Equal(out, layout.FixedBytes32())

@borrows
fn productionTerminalJournalCodecSessionCidInto(
        proof: admission_codec.ProductionHeldExecAdmissionProof,
        childBirthReceiptCid: str,
        childPid: int32,
        childUid: uint32,
        childGid: uint32,
        outCid: var str): bool =
    var claimDigest: layout.FixedBytes32
    var ownerClaimDigest: layout.FixedBytes32
    var rootBindingDigest: layout.FixedBytes32
    var proofReceiptDigest: layout.FixedBytes32
    var childBirthReceiptDigest: layout.FixedBytes32
    if childPid <= 0 ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.claimReceiptCid, claimDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.ownerClaimReceiptCid, ownerClaimDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.rootOwnerBindingCid, rootBindingDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.receiptCid, proofReceiptDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           childBirthReceiptCid, childBirthReceiptDigest) ||
       layout.FixedBytes32Equal(claimDigest, ownerClaimDigest) ||
       layout.FixedBytes32Equal(claimDigest, rootBindingDigest) ||
       layout.FixedBytes32Equal(ownerClaimDigest, rootBindingDigest) ||
       layout.FixedBytes32Equal(proofReceiptDigest, claimDigest) ||
       layout.FixedBytes32Equal(proofReceiptDigest, ownerClaimDigest) ||
       layout.FixedBytes32Equal(proofReceiptDigest, rootBindingDigest):
        return false
    var payload = rawbytes.BytesAlloc(172)
    productionTerminalJournalCodecPutFixed32(payload, 0, claimDigest)
    productionTerminalJournalCodecPutFixed32(payload, 32, ownerClaimDigest)
    productionTerminalJournalCodecPutU32(payload, 64, uint32(childPid))
    productionTerminalJournalCodecPutU32(payload, 68, childUid)
    productionTerminalJournalCodecPutU32(payload, 72, childGid)
    productionTerminalJournalCodecPutFixed32(payload, 76, rootBindingDigest)
    productionTerminalJournalCodecPutFixed32(
        payload, 108, proofReceiptDigest)
    productionTerminalJournalCodecPutFixed32(
        payload, 140, childBirthReceiptDigest)
    outCid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        productionTerminalJournalSessionDomain, payload)
    rawbytes.BytesFree(payload)
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(outCid)

@borrows
fn productionTerminalJournalCodecEncodeUnsigned(
        sessionDigest: layout.FixedBytes32,
        childBirthReceiptDigest: layout.FixedBytes32,
        claimDigest: layout.FixedBytes32,
        ownerClaimDigest: layout.FixedBytes32,
        rootBindingDigest: layout.FixedBytes32,
        childPid: int32,
        childUid: uint32,
        childGid: uint32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64): rawbytes.Bytes =
    var bytes = rawbytes.BytesAlloc(
        ProductionTerminalJournalClaimedRecordBytes)
    rawbytes.BytesSet(bytes, 0, productionTerminalJournalMagic0)
    rawbytes.BytesSet(bytes, 1, productionTerminalJournalMagic1)
    rawbytes.BytesSet(bytes, 2, productionTerminalJournalMagic2)
    rawbytes.BytesSet(bytes, 3, productionTerminalJournalMagic3)
    productionTerminalJournalCodecPutU32(
        bytes, 4, uint32(ProductionTerminalJournalClaimedSchemaVersion))
    productionTerminalJournalCodecPutU32(
        bytes, 8, uint32(ProductionTerminalJournalClaimedPhase))
    productionTerminalJournalCodecPutU32(
        bytes, 12, uint32(ProductionTerminalJournalDecisionNone))
    productionTerminalJournalCodecPutFixed32(bytes, 16, sessionDigest)
    productionTerminalJournalCodecPutFixed32(
        bytes, 48, childBirthReceiptDigest)
    productionTerminalJournalCodecPutFixed32(bytes, 80, claimDigest)
    productionTerminalJournalCodecPutU32(
        bytes, 112, uint32(childBirthPlatform))
    productionTerminalJournalCodecPutU64(bytes, 120, childBirth0)
    productionTerminalJournalCodecPutU64(bytes, 128, childBirth1)
    productionTerminalJournalCodecPutFixed32(bytes, 144, ownerClaimDigest)
    productionTerminalJournalCodecPutFixed32(bytes, 176, rootBindingDigest)
    productionTerminalJournalCodecPutU32(bytes, 216, uint32(-1))
    productionTerminalJournalCodecPutU32(bytes, 220, uint32(childPid))
    productionTerminalJournalCodecPutU32(bytes, 224, childUid)
    productionTerminalJournalCodecPutU32(bytes, 228, childGid)
    return bytes

@borrows
fn ProductionTerminalJournalClaimedEncodeStrictInto(
        admissionProofCanonical: str,
        childBirthReceiptCid: str,
        childPid: int32,
        childUid: uint32,
        childGid: uint32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64,
        out: var ProductionTerminalJournalClaimedRecord): bool =
    out = ProductionTerminalJournalClaimedRecord()
    var proof: admission_codec.ProductionHeldExecAdmissionProof
    var sessionCid: str
    var sessionDigest: layout.FixedBytes32
    var claimDigest: layout.FixedBytes32
    var ownerClaimDigest: layout.FixedBytes32
    var rootBindingDigest: layout.FixedBytes32
    var childBirthReceiptDigest: layout.FixedBytes32
    if !admission_codec.ProductionHeldExecAdmissionProofDecodeStrictInto(
           admissionProofCanonical, proof) ||
       !productionTerminalJournalCodecSessionCidInto(
           proof,
           childBirthReceiptCid,
           childPid,
           childUid,
           childGid,
           sessionCid) ||
       !productionTerminalJournalCodecCidDigestInto(
           sessionCid, sessionDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.claimReceiptCid, claimDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.ownerClaimReceiptCid, ownerClaimDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           proof.rootOwnerBindingCid, rootBindingDigest) ||
       !productionTerminalJournalCodecCidDigestInto(
           childBirthReceiptCid, childBirthReceiptDigest) ||
       (childBirthPlatform != 1 && childBirthPlatform != 2) ||
       childBirth0 == uint64(0) ||
       (childBirthPlatform == 2 && childBirth1 != uint64(0)) ||
       (childBirthPlatform == 1 && childBirth1 >= uint64(1000000)):
        return false
    var unsignedBytes = productionTerminalJournalCodecEncodeUnsigned(
        sessionDigest,
        childBirthReceiptDigest,
        claimDigest,
        ownerClaimDigest,
        rootBindingDigest,
        childPid,
        childUid,
        childGid,
        childBirthPlatform,
        childBirth0,
        childBirth1)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            productionTerminalJournalRecordDomain, unsignedBytes)
    var receiptDigest: layout.FixedBytes32
    if !productionTerminalJournalCodecCidDigestInto(
           receiptCid, receiptDigest):
        rawbytes.BytesFree(unsignedBytes)
        return false
    productionTerminalJournalCodecPutFixed32(
        unsignedBytes, 232, receiptDigest)
    out.canonical = rawbytes.BytesToString(unsignedBytes)
    rawbytes.BytesFree(unsignedBytes)
    out.sessionCid = strings.CloneStr(sessionCid)
    out.recordReceiptCid = strings.CloneStr(receiptCid)
    out.claimReceiptCid = strings.CloneStr(proof.claimReceiptCid)
    out.ownerClaimReceiptCid = strings.CloneStr(
        proof.ownerClaimReceiptCid)
    out.rootOwnerBindingCid = strings.CloneStr(proof.rootOwnerBindingCid)
    out.admissionProofReceiptCid = strings.CloneStr(proof.receiptCid)
    out.childBirthReceiptCid = strings.CloneStr(childBirthReceiptCid)
    out.childPid = childPid
    out.childUid = childUid
    out.childGid = childGid
    out.childBirthPlatform = childBirthPlatform
    out.childBirth0 = childBirth0
    out.childBirth1 = childBirth1
    return out.canonical.len == ProductionTerminalJournalClaimedRecordBytes

@borrows
fn ProductionTerminalJournalClaimedDecodeStrictInto(
        canonical: str,
        admissionProofCanonical: str,
        expectedRootOwnerBindingCid: str,
        out: var ProductionTerminalJournalClaimedRecord): bool =
    out = ProductionTerminalJournalClaimedRecord()
    if canonical.len != ProductionTerminalJournalClaimedRecordBytes:
        return false
    let bytes = rawbytes.BytesFromString(canonical)
    if rawbytes.BytesGet(bytes, 0) != productionTerminalJournalMagic0 ||
       rawbytes.BytesGet(bytes, 1) != productionTerminalJournalMagic1 ||
       rawbytes.BytesGet(bytes, 2) != productionTerminalJournalMagic2 ||
       rawbytes.BytesGet(bytes, 3) != productionTerminalJournalMagic3 ||
       productionTerminalJournalCodecGetU32(bytes, 4) !=
           uint32(ProductionTerminalJournalClaimedSchemaVersion) ||
       productionTerminalJournalCodecGetU32(bytes, 8) !=
           uint32(ProductionTerminalJournalClaimedPhase) ||
       productionTerminalJournalCodecGetU32(bytes, 12) !=
           uint32(ProductionTerminalJournalDecisionNone):
        return false
    for byteIndex in 116..<120:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    for byteIndex in 136..<144:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    for byteIndex in 208..<216:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    if productionTerminalJournalCodecGetU32(bytes, 216) != uint32(-1):
        return false
    for byteIndex in 264..<ProductionTerminalJournalClaimedRecordBytes:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    var proof: admission_codec.ProductionHeldExecAdmissionProof
    var sessionDigest: layout.FixedBytes32
    var claimDigest: layout.FixedBytes32
    var ownerClaimDigest: layout.FixedBytes32
    var rootBindingDigest: layout.FixedBytes32
    var receiptDigest: layout.FixedBytes32
    var childBirthReceiptDigest: layout.FixedBytes32
    productionTerminalJournalCodecGetFixed32Into(bytes, 16, sessionDigest)
    productionTerminalJournalCodecGetFixed32Into(
        bytes, 48, childBirthReceiptDigest)
    productionTerminalJournalCodecGetFixed32Into(bytes, 80, claimDigest)
    productionTerminalJournalCodecGetFixed32Into(
        bytes, 144, ownerClaimDigest)
    productionTerminalJournalCodecGetFixed32Into(
        bytes, 176, rootBindingDigest)
    productionTerminalJournalCodecGetFixed32Into(bytes, 232, receiptDigest)
    let childPid = int32(productionTerminalJournalCodecGetU32(bytes, 220))
    let childUid = productionTerminalJournalCodecGetU32(bytes, 224)
    let childGid = productionTerminalJournalCodecGetU32(bytes, 228)
    let childBirthPlatform = int32(
        productionTerminalJournalCodecGetU32(bytes, 112))
    let childBirth0 = productionTerminalJournalCodecGetU64(bytes, 120)
    let childBirth1 = productionTerminalJournalCodecGetU64(bytes, 128)
    let childBirthReceiptCid =
        "sha256:" + layout.FixedBytes32Hex(childBirthReceiptDigest)
    if childPid <= 0 ||
       !admission_codec.ProductionHeldExecAdmissionProofDecodeStrictInto(
           admissionProofCanonical, proof) ||
       proof.rootOwnerBindingCid != expectedRootOwnerBindingCid:
        return false
    var rebuilt: ProductionTerminalJournalClaimedRecord
    if !ProductionTerminalJournalClaimedEncodeStrictInto(
           admissionProofCanonical,
           childBirthReceiptCid,
           childPid,
           childUid,
           childGid,
           childBirthPlatform,
           childBirth0,
           childBirth1,
           rebuilt) ||
       rebuilt.canonical != canonical:
        return false
    out = rebuilt
    return true
