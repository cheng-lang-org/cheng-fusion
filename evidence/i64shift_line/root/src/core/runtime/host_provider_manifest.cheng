# host_provider_manifest.cheng
# Explicit declaration of APIs that require the host platform.
# These are NOT pure Cheng - they need Electron/Node.js host to provide them.
# Per project policy: these are categorized as EXTERNAL SYMBOLS with host provider.

const HOST_PROVIDER_ELECTRON_APPLICATION = "cheng-host.electron.application"
const HOST_PROVIDER_ELECTRON_IPC = "cheng-host.electron.ipc"
const HOST_PROVIDER_ELECTRON_WEB_CONTENTS = "cheng-host.electron.web-contents"
const HOST_PROVIDER_NODE_HTTP_SERVER = "cheng-host.node.http-server"
const HOST_PROVIDER_NODE_PROCESS = "cheng-host.node.process"
const HOST_PROVIDER_THREEJS_3D_MATH = "cheng-host.threejs.3d-math"
const HOST_PROVIDER_PDF_LIB = "cheng-host.pdf.lib"
const HOST_PROVIDER_CAPACITOR_HTTP = "cheng-host.capacitor.http"
const HOST_PROVIDER_BROWSER_GEOLOCATION = "cheng-host.browser.geolocation"
const HOST_PROVIDER_ETHEREUM_JSON_RPC = "cheng-host.ethereum.json-rpc"
const HOST_PROVIDER_SECP256K1_CRYPTO = "cheng-host.crypto.secp256k1"

# Manifest entries: (api_name, provider, reason)
# Each entry documents WHY this can't be pure Cheng

type HostProviderEntry =
    apiName: str
    provider: str
    reason: str
    inputSpec: str
    outputSpec: str
    failureModes: str
    permissions: str

var hostProviderManifest: HostProviderEntry[]

fn HostProviderManifestInit() =
    hostProviderManifest = []
    # Electron Application APIs
    HostProviderRegister("app.exit", HOST_PROVIDER_ELECTRON_APPLICATION, "Electron app lifecycle - requires Electron runtime", "exitCode: int32", "void", "Process may not exit if Electron is not running", "electron.app.quit")
    HostProviderRegister("app.on", HOST_PROVIDER_ELECTRON_APPLICATION, "Electron event registration - requires Electron event loop", "eventName: str, callback: function", "void", "Event may not fire if not in Electron context", "electron.app.events")

    # Electron IPC
    HostProviderRegister("ipcMain.handle", HOST_PROVIDER_ELECTRON_IPC, "Electron main process IPC - requires Electron IPC subsystem", "channel: str, handler: function", "void", "IPC may fail if renderer not connected", "electron.ipc.main")
    HostProviderRegister("ipcRenderer.invoke", HOST_PROVIDER_ELECTRON_IPC, "Electron renderer IPC - requires Electron IPC subsystem", "channel: str, ...args", "Promise<any>", "IPC may timeout if main process not responding", "electron.ipc.renderer")

    # Electron WebContents
    HostProviderRegister("webContents.executeJavaScript", HOST_PROVIDER_ELECTRON_WEB_CONTENTS, "Execute JS in Electron web contents - requires Chromium renderer", "code: str", "Promise<any>", "Execution may fail if web contents destroyed", "electron.webContents.executeJavaScript")

    # Node HTTP Server
    HostProviderRegister("req.on", HOST_PROVIDER_NODE_HTTP_SERVER, "Node HTTP request event - requires Node http module", "event: str, handler: function", "void", "Event may not fire if server not listening", "node.http.server")
    HostProviderRegister("res.setHeader", HOST_PROVIDER_NODE_HTTP_SERVER, "Node HTTP response header - requires Node http module", "name: str, value: str", "void", "Header may be ignored if response already sent", "node.http.response")
    HostProviderRegister("res.writeHead", HOST_PROVIDER_NODE_HTTP_SERVER, "Node HTTP response writeHead - requires Node http module", "statusCode: int32, headers: object", "void", "May throw if headers already sent", "node.http.response")
    HostProviderRegister("res.end", HOST_PROVIDER_NODE_HTTP_SERVER, "Node HTTP response end - requires Node http module", "data?: string", "void", "May throw if response already ended", "node.http.response")

    # Node Process
    HostProviderRegister("process.argv", HOST_PROVIDER_NODE_PROCESS, "Node process arguments - requires OS process", "none", "str[]", "Empty if no process context", "node.process.argv")
    HostProviderRegister("process.env.*", HOST_PROVIDER_NODE_PROCESS, "Node process environment - requires OS environment", "varName: str", "str", "Empty string if env var not set", "node.process.env")

    # Three.js 3D Math
    HostProviderRegister("camera.rotation.set", HOST_PROVIDER_THREEJS_3D_MATH, "Three.js camera rotation - requires 3D math library (Euler angles, quaternions, matrices)", "x: float64, y: float64, z: float64", "void", "N/A", "threejs.math.euler")
    HostProviderRegister("child.scale.setScalar", HOST_PROVIDER_THREEJS_3D_MATH, "Three.js object scaling - requires 3D math library (vector/matrix)", "scalar: float64", "void", "N/A", "threejs.math.vector")

    # PDF Library
    HostProviderRegister("doc.addPage", HOST_PROVIDER_PDF_LIB, "PDF document page addition - requires PDF generation library", "none", "void", "May fail if document closed", "pdf-lib.document.write")

    # Capacitor
    HostProviderRegister("CapacitorHttp.get", HOST_PROVIDER_CAPACITOR_HTTP, "Capacitor HTTP plugin - requires Capacitor mobile runtime", "options: {url: str, headers?: object}", "Promise<{data: str, status: int32, headers: object}>", "Network error if offline", "capacitor.http.get")

    # Browser Geolocation
    HostProviderRegister("Geolocation.getCurrentPosition", HOST_PROVIDER_BROWSER_GEOLOCATION, "Browser geolocation - requires GPS/WiFi hardware and browser permission", "options?: {enableHighAccuracy: bool, timeout: int64, maximumAge: int64}", "{coords: {latitude: float64, longitude: float64, accuracy: float64}}", "PERMISSION_DENIED if user denies, POSITION_UNAVAILABLE if hardware fails, TIMEOUT if exceeds timeout", "browser.geolocation")

    # Ethereum JSON-RPC
    HostProviderRegister("ethers.JsonRpcProvider", HOST_PROVIDER_ETHEREUM_JSON_RPC, "Ethereum JSON-RPC provider - requires Ethereum node connection", "url: str", "provider handle", "NETWORK_ERROR if node unreachable", "ethereum.rpc.connect")
    HostProviderRegister("provider.getBalance", HOST_PROVIDER_ETHEREUM_JSON_RPC, "Ethereum account balance query - requires Ethereum node", "address: str", "Promise<BigInt> balance in wei", "NETWORK_ERROR if node unreachable, INVALID_ADDRESS if address malformed", "ethereum.rpc.query")
    HostProviderRegister("tx.wait", HOST_PROVIDER_ETHEREUM_JSON_RPC, "Wait for Ethereum transaction confirmation - requires Ethereum node polling", "confirmations?: int32", "Promise<{status: int32, blockNumber: int32, gasUsed: BigInt}>", "TIMEOUT if tx not mined, REVERTED if tx failed", "ethereum.rpc.poll")

    # secp256k1 Crypto (elliptic curve)
    HostProviderRegister("ECPair.fromPrivateKey", HOST_PROVIDER_SECP256K1_CRYPTO, "secp256k1 key pair derivation - requires elliptic curve math", "privateKey: Buffer", "{publicKey: Buffer, privateKey: Buffer, toWIF(): str}", "INVALID_PRIVATE_KEY if key out of range", "crypto.secp256k1.keypair")
    HostProviderRegister("HDNodeWallet.fromPhrase", HOST_PROVIDER_SECP256K1_CRYPTO, "BIP32 HD wallet derivation - requires HMAC-SHA512 + secp256k1 curve operations", "mnemonic: str, path?: str", "HDNodeWallet", "INVALID_MNEMONIC if checksum fails", "crypto.secp256k1.hdwallet")

fn HostProviderRegister(apiName: str, provider: str, reason: str, inputSpec: str, outputSpec: str, failureModes: str, permissions: str) =
    var entry: HostProviderEntry
    entry.apiName = apiName
    entry.provider = provider
    entry.reason = reason
    entry.inputSpec = inputSpec
    entry.outputSpec = outputSpec
    entry.failureModes = failureModes
    entry.permissions = permissions
    add(hostProviderManifest, entry)

fn HostProviderLookup(apiName: str, out: var HostProviderEntry): bool =
    for i in 0..<hostProviderManifest.len:
        if hostProviderManifest[i].apiName == apiName:
            out = hostProviderManifest[i]
            return true
    return false
