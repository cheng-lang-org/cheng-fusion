import std/cmdline
import std/atomic
import std/rawbytes
import std/strings
import std/strformat
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/lang/parser
import cheng/core/tooling/compiler_request as compiler_request
import cheng/core/backend/system_link_plan as system_link_plan
import cheng/core/runtime/held_exec_identity as held_exec_identity
import cheng/core/runtime/production_held_exec_provider as held_exec_provider

const
    CsgCoreProductionSystemLinkExecAdmissionSchema: str =
        "csg_core::production_system_link_exec_admission::v1"
    CsgCoreProductionSystemLinkExecAdmissionDomain: str =
        "csg_core.production_system_link_exec.admission_receipt"
    CsgCoreProductionPackageSourceRootModuleGraphDomain: str =
        "csg_core.production.package_source_root.module_graph.v1"
    CsgCoreProductionPackageSourceRootIdentityDomain: str =
        "csg_core.production.package_source_root.identity.v1"
    CsgCoreProductionPreExecInputProducerReceiptDomain: str =
        "csg_core.production.pre_exec.producer_receipt.v1"
    CsgCoreProductionPreExecInputProducerSlotCount: int32 = 2
    CsgCoreProductionPreExecInputProducerStateEmpty: int32 = 0
    CsgCoreProductionPreExecInputProducerStateBuilding: int32 = 1
    CsgCoreProductionPreExecInputProducerStateIssued: int32 = 2
    CsgCoreProductionPreExecInputProducerStateConsuming: int32 = 3
    CsgCoreProductionPreExecInputProducerStateConsumed: int32 = 4
    CsgCoreProductionPreExecInputProducerStateAborted: int32 = 5

type
    CsgCoreProductionPackageSourceRootIdentityReceipt =
        packageId: str
        canonicalModulePaths: str[]
        sourceBundleCid: str
        importGraphCid: str
        moduleGraphCid: str
        receiptCid: str
        complete: bool

    # This is immutable data evidence, not an authority handle.  The provider
    # owner is minted later, only while the parent holds the current-HEAD
    # lease.  The nested root receipt preserves the exact source value-defs
    # needed to revalidate the envelope without trusting caller CID text.
    productionPreExecInputProducerReceipt =
        packageSourceRoot: CsgCoreProductionPackageSourceRootIdentityReceipt
        rawEnvelopeCid: str
        sourceClosureCid: str
        executableCid: str
        byteCount: int32
        receiptCid: str
        complete: bool

    CsgCoreProductionPreExecInputProducerHandle =
        slot: int32 = -1

    CsgCoreProductionSystemLinkExecAdmissionReceipt =
        schema: str
        commandCid: str
        inputSetCid: str
        outputContractCid: str
        currentHeadCid: str
        manifestCid: str
        csgcObjectCid: str
        factsRoot: str
        proofCid: str
        csgAuthorityReceiptCid: str
        launcherAdmissionReceiptCid: str
        receiptCid: str
        complete: bool

var productionPreExecInputProducerSlotStates: atomic.I32[]
var productionPreExecInputProducerSlotEnvelopeBytes: str[]
var productionPreExecInputProducerSlotPackageIds: str[]
var productionPreExecInputProducerSlotCanonicalModulePaths: str[][]
var productionPreExecInputProducerSlotSourceBundleCids: str[]
var productionPreExecInputProducerSlotImportGraphCids: str[]
var productionPreExecInputProducerSlotModuleGraphCids: str[]
var productionPreExecInputProducerSlotPackageReceiptCids: str[]
var productionPreExecInputProducerSlotRawEnvelopeCids: str[]
var productionPreExecInputProducerSlotSourceClosureCids: str[]
var productionPreExecInputProducerSlotExecutableCids: str[]
var productionPreExecInputProducerSlotByteCounts: int32[]
var productionPreExecInputProducerSlotReceiptCids: str[]
var productionPreExecInputProducerRegistryInit: int32

@borrows
fn productionSystemLinkAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value % 256)
    layout.ByteBufAppendByte(out, (value / 256) % 256)
    layout.ByteBufAppendByte(out, (value / 65536) % 256)
    layout.ByteBufAppendByte(out, (value / 16777216) % 256)

@borrows
fn productionSystemLinkAppendU64(
        out: var layout.ByteBuf,
        value: uint64) =
    var remaining = value
    for byteIndex in 0..<8:
        layout.ByteBufAppendByte(out, int32(remaining % uint64(256)))
        remaining = remaining / uint64(256)

@borrows
fn productionSystemLinkAppendText(
        out: var layout.ByteBuf,
        value: str) =
    productionSystemLinkAppendU32(out, value.len)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(out, value[byteIndex])

@borrows
fn productionPackageSourceRootTextLess(
        left: str,
        right: str): bool =
    let shared = left.len < right.len ? left.len : right.len
    for byteIndex in 0..<shared:
        if left[byteIndex] < right[byteIndex]:
            return true
        if left[byteIndex] > right[byteIndex]:
            return false
    return left.len < right.len

@borrows
fn productionPackageSourceRootModulePathValid(value: str): bool =
    if value.len <= 0 || value[0] == '/' || value[0] == '\\' ||
       !parser.ParserSourceIdentityModuleTextValid(value):
        return false
    var segmentStart: int32
    for byteIndex in 0..value.len:
        if byteIndex < value.len && value[byteIndex] != '/':
            if value[byteIndex] == '\\' || value[byteIndex] == ':' ||
               value[byteIndex] <= 32 || value[byteIndex] == 127:
                return false
            continue
        if byteIndex <= segmentStart:
            return false
        let segment = strings.SliceBytes(
            value, segmentStart, byteIndex - segmentStart)
        if segment == "." || segment == "..":
            return false
        segmentStart = byteIndex + 1
    return true

@borrows
fn productionPackageSourceRootModuleGraphCid(
        canonicalModulePaths: str[]): str =
    var buf = layout.ByteBufInit(256)
    productionSystemLinkAppendU32(buf, canonicalModulePaths.len)
    for moduleIndex in 0..<canonicalModulePaths.len:
        productionSystemLinkAppendText(
            buf, canonicalModulePaths[moduleIndex])
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPackageSourceRootModuleGraphDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionPackageSourceRootIdentityCid(
        packageId: str,
        sourceBundleCid: str,
        importGraphCid: str,
        moduleGraphCid: str): str =
    var buf = layout.ByteBufInit(192)
    productionSystemLinkAppendText(buf, packageId)
    productionSystemLinkAppendText(buf, sourceBundleCid)
    productionSystemLinkAppendText(buf, importGraphCid)
    productionSystemLinkAppendText(buf, moduleGraphCid)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPackageSourceRootIdentityDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn CsgCoreProductionPackageSourceRootIdentityReceiptStrictValid(
        receipt: CsgCoreProductionPackageSourceRootIdentityReceipt): bool =
    if !receipt.complete || receipt.canonicalModulePaths.len <= 0 ||
       parser.ParserManifestNormalizePackageId(receipt.packageId) !=
           receipt.packageId:
        return false
    for moduleIndex in 0..<receipt.canonicalModulePaths.len:
        if !productionPackageSourceRootModulePathValid(
               receipt.canonicalModulePaths[moduleIndex]):
            return false
        if moduleIndex > 0 &&
           !productionPackageSourceRootTextLess(
               receipt.canonicalModulePaths[moduleIndex - 1],
               receipt.canonicalModulePaths[moduleIndex]):
            return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.sourceBundleCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.importGraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.moduleGraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.receiptCid) ||
       receipt.sourceBundleCid == receipt.importGraphCid ||
       receipt.sourceBundleCid == receipt.moduleGraphCid ||
       receipt.importGraphCid == receipt.moduleGraphCid:
        return false
    return receipt.moduleGraphCid ==
               productionPackageSourceRootModuleGraphCid(
                   receipt.canonicalModulePaths) &&
        receipt.receiptCid == productionPackageSourceRootIdentityCid(
            receipt.packageId,
            receipt.sourceBundleCid,
            receipt.importGraphCid,
            receipt.moduleGraphCid)

@borrows
fn CsgCoreProductionPackageSourceRootIdentityFromPlanInto(
        plan: var system_link_plan.SystemLinkPlanStub,
        out: var CsgCoreProductionPackageSourceRootIdentityReceipt,
        err: var str): bool =
    out = CsgCoreProductionPackageSourceRootIdentityReceipt()
    if !system_link_plan.SystemLinkPlanSourceBundleBindingValid(plan):
        err = "production_package_source_root_e_plan"
        return false
    let packageId = system_link_plan.SystemLinkPlanPackageId(plan)
    if packageId.len <= 0 ||
       parser.ParserManifestNormalizePackageId(packageId) != packageId:
        err = "production_package_source_root_e_package"
        return false
    let ownerModulePaths =
        system_link_plan.SystemLinkPlanOwnerModulePaths(plan)
    if ownerModulePaths.len <= 0:
        err = "production_package_source_root_e_module_graph"
        return false
    var selected: bool[]
    setLen(selected, ownerModulePaths.len)
    for sourceIndex in 0..<ownerModulePaths.len:
        let modulePath = ownerModulePaths[sourceIndex]
        if !productionPackageSourceRootModulePathValid(modulePath):
            err = "production_package_source_root_e_module_path"
            return false
        for priorIndex in 0..<sourceIndex:
            if modulePath == ownerModulePaths[priorIndex]:
                err = "production_package_source_root_e_module_duplicate"
                return false
    var orderedModulePaths: str[]
    for outputIndex in 0..<ownerModulePaths.len:
        var bestIndex: int32 = -1
        for sourceIndex in 0..<ownerModulePaths.len:
            if selected[sourceIndex]:
                continue
            if bestIndex < 0 || productionPackageSourceRootTextLess(
                   ownerModulePaths[sourceIndex],
                   ownerModulePaths[bestIndex]):
                bestIndex = sourceIndex
        if bestIndex < 0:
            err = "production_package_source_root_e_module_order"
            return false
        selected[bestIndex] = true
        add(orderedModulePaths,
            strings.CloneStr(ownerModulePaths[bestIndex]))
    let sourceBundle =
        system_link_plan.SystemLinkPlanSourceBundleCidValue(plan)
    let importGraph =
        system_link_plan.SystemLinkPlanSourceBundleImportGraphCid(plan)
    if layout.FixedBytes32Equal(sourceBundle, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(importGraph, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(sourceBundle, importGraph):
        err = "production_package_source_root_e_source_identity"
        return false
    var receipt: CsgCoreProductionPackageSourceRootIdentityReceipt
    receipt.packageId = strings.CloneStr(packageId)
    receipt.canonicalModulePaths = orderedModulePaths
    receipt.sourceBundleCid =
        "sha256:" + layout.FixedBytes32Hex(sourceBundle)
    receipt.importGraphCid =
        "sha256:" + layout.FixedBytes32Hex(importGraph)
    receipt.moduleGraphCid = productionPackageSourceRootModuleGraphCid(
        receipt.canonicalModulePaths)
    receipt.receiptCid = productionPackageSourceRootIdentityCid(
        receipt.packageId,
        receipt.sourceBundleCid,
        receipt.importGraphCid,
        receipt.moduleGraphCid)
    receipt.complete = true
    if !CsgCoreProductionPackageSourceRootIdentityReceiptStrictValid(
           receipt):
        err = "production_package_source_root_e_receipt"
        return false
    out = receipt
    err = ""
    return true

@borrows
fn productionPreExecStringVectorsEqual(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    for valueIndex in 0..<left.len:
        if left[valueIndex] != right[valueIndex]:
            return false
    return true

@borrows
fn productionPreExecInputProducerReceiptCid(
        receipt: productionPreExecInputProducerReceipt): str =
    var buf = layout.ByteBufInit(256)
    productionSystemLinkAppendText(
        buf, receipt.packageSourceRoot.receiptCid)
    productionSystemLinkAppendText(buf, receipt.rawEnvelopeCid)
    productionSystemLinkAppendText(buf, receipt.sourceClosureCid)
    productionSystemLinkAppendText(buf, receipt.executableCid)
    productionSystemLinkAppendU32(buf, receipt.byteCount)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPreExecInputProducerReceiptDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionPreExecInputProducerReceiptStrictValid(
        envelopeBytes: str,
        receipt: productionPreExecInputProducerReceipt): bool =
    if !receipt.complete || receipt.byteCount <= 0 ||
       receipt.byteCount != envelopeBytes.len ||
       !CsgCoreProductionPackageSourceRootIdentityReceiptStrictValid(
           receipt.packageSourceRoot) ||
       receipt.sourceClosureCid !=
           receipt.packageSourceRoot.sourceBundleCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.rawEnvelopeCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.executableCid) ||
       receipt.rawEnvelopeCid == receipt.sourceClosureCid ||
       receipt.rawEnvelopeCid == receipt.executableCid ||
       receipt.sourceClosureCid == receipt.executableCid:
        return false
    var decoded: held_exec_provider.CsgCoreProductionPreExecInput
    var decodedCid: str
    var decodeErr: str
    if !held_exec_provider.CsgCoreProductionPreExecInputDecodeStrictInto(
           envelopeBytes, decoded, decodedCid, decodeErr):
        return false
    if decodedCid != receipt.rawEnvelopeCid ||
       decoded.packageSourceRootIdentityCid !=
           receipt.packageSourceRoot.receiptCid:
        return false
    return receipt.receiptCid ==
        productionPreExecInputProducerReceiptCid(receipt)

fn productionPreExecInputProducerRegistryEnsure(): bool =
    if system.RuntimeAtomicLoadI32(
           productionPreExecInputProducerRegistryInit) == 2:
        return true
    if !system.RuntimeAtomicCompareExchangeI32(
           productionPreExecInputProducerRegistryInit, 0, 1):
        return false
    setLen(productionPreExecInputProducerSlotStates,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotEnvelopeBytes,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotPackageIds,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotCanonicalModulePaths,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotSourceBundleCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotImportGraphCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotModuleGraphCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotPackageReceiptCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotRawEnvelopeCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotSourceClosureCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotExecutableCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotByteCounts,
        CsgCoreProductionPreExecInputProducerSlotCount)
    setLen(productionPreExecInputProducerSlotReceiptCids,
        CsgCoreProductionPreExecInputProducerSlotCount)
    for slot in 0..<CsgCoreProductionPreExecInputProducerSlotCount:
        productionPreExecInputProducerSlotStates[slot] = atomic.NewI32(0)
        productionPreExecInputProducerSlotEnvelopeBytes[slot] = ""
        productionPreExecInputProducerSlotPackageIds[slot] = ""
        productionPreExecInputProducerSlotCanonicalModulePaths[slot] = []
        productionPreExecInputProducerSlotSourceBundleCids[slot] = ""
        productionPreExecInputProducerSlotImportGraphCids[slot] = ""
        productionPreExecInputProducerSlotModuleGraphCids[slot] = ""
        productionPreExecInputProducerSlotPackageReceiptCids[slot] = ""
        productionPreExecInputProducerSlotRawEnvelopeCids[slot] = ""
        productionPreExecInputProducerSlotSourceClosureCids[slot] = ""
        productionPreExecInputProducerSlotExecutableCids[slot] = ""
        productionPreExecInputProducerSlotByteCounts[slot] = 0
        productionPreExecInputProducerSlotReceiptCids[slot] = ""
        if productionPreExecInputProducerSlotStates[slot] == nil:
            system.RuntimeAtomicStoreI32(
                productionPreExecInputProducerRegistryInit, 0)
            return false
    system.RuntimeAtomicStoreI32(
        productionPreExecInputProducerRegistryInit, 2)
    return true

fn productionPreExecInputProducerHandleShapeValid(
        handle: var CsgCoreProductionPreExecInputProducerHandle): bool =
    return handle.slot >= 0 &&
        handle.slot < CsgCoreProductionPreExecInputProducerSlotCount

fn productionPreExecInputProducerSlotMatches(
        slot: int32,
        handle: var CsgCoreProductionPreExecInputProducerHandle): bool =
    return slot == handle.slot

@borrows
fn productionPreExecInputProducerIssueInto(
        envelopeBytes: str,
        receipt: productionPreExecInputProducerReceipt,
        outHandle: var CsgCoreProductionPreExecInputProducerHandle,
        err: var str): bool =
    outHandle = CsgCoreProductionPreExecInputProducerHandle()
    if !productionPreExecInputProducerReceiptStrictValid(
           envelopeBytes, receipt) ||
       !productionPreExecInputProducerRegistryEnsure():
        err = "production_pre_exec_e_producer_issue_invalid"
        return false
    var slot: int32 = -1
    for scan in 0..<CsgCoreProductionPreExecInputProducerSlotCount:
        if slot >= 0:
            break
        let prior = atomic.LoadI32(
            productionPreExecInputProducerSlotStates[scan])
        if prior == CsgCoreProductionPreExecInputProducerStateEmpty:
            if atomic.CasI32(
                   productionPreExecInputProducerSlotStates[scan],
                   prior,
                   CsgCoreProductionPreExecInputProducerStateBuilding):
                slot = scan
    if slot < 0:
        err = "production_pre_exec_e_producer_slot_unavailable"
        return false
    productionPreExecInputProducerSlotEnvelopeBytes[slot] =
        strings.CloneStr(envelopeBytes)
    productionPreExecInputProducerSlotPackageIds[slot] =
        strings.CloneStr(receipt.packageSourceRoot.packageId)
    productionPreExecInputProducerSlotCanonicalModulePaths[slot] = []
    for moduleIndex in 0..<receipt.packageSourceRoot.canonicalModulePaths.len:
        add(productionPreExecInputProducerSlotCanonicalModulePaths[slot],
            strings.CloneStr(
                receipt.packageSourceRoot.canonicalModulePaths[moduleIndex]))
    productionPreExecInputProducerSlotSourceBundleCids[slot] =
        strings.CloneStr(receipt.packageSourceRoot.sourceBundleCid)
    productionPreExecInputProducerSlotImportGraphCids[slot] =
        strings.CloneStr(receipt.packageSourceRoot.importGraphCid)
    productionPreExecInputProducerSlotModuleGraphCids[slot] =
        strings.CloneStr(receipt.packageSourceRoot.moduleGraphCid)
    productionPreExecInputProducerSlotPackageReceiptCids[slot] =
        strings.CloneStr(receipt.packageSourceRoot.receiptCid)
    productionPreExecInputProducerSlotRawEnvelopeCids[slot] =
        strings.CloneStr(receipt.rawEnvelopeCid)
    productionPreExecInputProducerSlotSourceClosureCids[slot] =
        strings.CloneStr(receipt.sourceClosureCid)
    productionPreExecInputProducerSlotExecutableCids[slot] =
        strings.CloneStr(receipt.executableCid)
    productionPreExecInputProducerSlotByteCounts[slot] = receipt.byteCount
    productionPreExecInputProducerSlotReceiptCids[slot] =
        strings.CloneStr(receipt.receiptCid)
    var candidate: CsgCoreProductionPreExecInputProducerHandle
    candidate.slot = slot
    if !productionPreExecInputProducerSlotMatches(slot, candidate):
        atomic.StoreI32(
            productionPreExecInputProducerSlotStates[slot],
            CsgCoreProductionPreExecInputProducerStateAborted)
        err = "production_pre_exec_e_producer_issue_drift"
        return false
    atomic.StoreI32(
        productionPreExecInputProducerSlotStates[slot],
        CsgCoreProductionPreExecInputProducerStateIssued)
    outHandle = candidate
    err = ""
    return true

fn productionPreExecInputProducerTakeInto(
        handle: var CsgCoreProductionPreExecInputProducerHandle,
        outEnvelopeBytes: var str,
        outReceipt: var productionPreExecInputProducerReceipt,
        err: var str): bool =
    outEnvelopeBytes = ""
    outReceipt = productionPreExecInputProducerReceipt()
    if !productionPreExecInputProducerHandleShapeValid(handle) ||
       !productionPreExecInputProducerRegistryEnsure() ||
       !productionPreExecInputProducerSlotMatches(handle.slot, handle) ||
       !atomic.CasI32(
           productionPreExecInputProducerSlotStates[handle.slot],
           CsgCoreProductionPreExecInputProducerStateIssued,
           CsgCoreProductionPreExecInputProducerStateConsuming) ||
       !productionPreExecInputProducerSlotMatches(handle.slot, handle):
        err = "production_pre_exec_e_producer_single_consumption"
        return false
    let slot = handle.slot
    outEnvelopeBytes = strings.CloneStr(
        productionPreExecInputProducerSlotEnvelopeBytes[slot])
    outReceipt.packageSourceRoot.packageId = strings.CloneStr(
        productionPreExecInputProducerSlotPackageIds[slot])
    for moduleIndex in 0..<
            productionPreExecInputProducerSlotCanonicalModulePaths[slot].len:
        add(outReceipt.packageSourceRoot.canonicalModulePaths,
            strings.CloneStr(
                productionPreExecInputProducerSlotCanonicalModulePaths[slot][moduleIndex]))
    outReceipt.packageSourceRoot.sourceBundleCid = strings.CloneStr(
        productionPreExecInputProducerSlotSourceBundleCids[slot])
    outReceipt.packageSourceRoot.importGraphCid = strings.CloneStr(
        productionPreExecInputProducerSlotImportGraphCids[slot])
    outReceipt.packageSourceRoot.moduleGraphCid = strings.CloneStr(
        productionPreExecInputProducerSlotModuleGraphCids[slot])
    outReceipt.packageSourceRoot.receiptCid = strings.CloneStr(
        productionPreExecInputProducerSlotPackageReceiptCids[slot])
    outReceipt.packageSourceRoot.complete = true
    outReceipt.rawEnvelopeCid = strings.CloneStr(
        productionPreExecInputProducerSlotRawEnvelopeCids[slot])
    outReceipt.sourceClosureCid = strings.CloneStr(
        productionPreExecInputProducerSlotSourceClosureCids[slot])
    outReceipt.executableCid = strings.CloneStr(
        productionPreExecInputProducerSlotExecutableCids[slot])
    outReceipt.byteCount =
        productionPreExecInputProducerSlotByteCounts[slot]
    outReceipt.receiptCid = strings.CloneStr(
        productionPreExecInputProducerSlotReceiptCids[slot])
    outReceipt.complete = true
    if !productionPreExecInputProducerReceiptStrictValid(
           outEnvelopeBytes, outReceipt):
        atomic.StoreI32(
            productionPreExecInputProducerSlotStates[slot],
            CsgCoreProductionPreExecInputProducerStateAborted)
        err = "production_pre_exec_e_producer_take_drift"
        return false
    productionPreExecInputProducerSlotEnvelopeBytes[slot] = ""
    productionPreExecInputProducerSlotPackageIds[slot] = ""
    productionPreExecInputProducerSlotCanonicalModulePaths[slot] = []
    productionPreExecInputProducerSlotSourceBundleCids[slot] = ""
    productionPreExecInputProducerSlotImportGraphCids[slot] = ""
    productionPreExecInputProducerSlotModuleGraphCids[slot] = ""
    productionPreExecInputProducerSlotPackageReceiptCids[slot] = ""
    productionPreExecInputProducerSlotRawEnvelopeCids[slot] = ""
    productionPreExecInputProducerSlotSourceClosureCids[slot] = ""
    productionPreExecInputProducerSlotExecutableCids[slot] = ""
    productionPreExecInputProducerSlotByteCounts[slot] = 0
    productionPreExecInputProducerSlotReceiptCids[slot] = ""
    if !atomic.CasI32(
           productionPreExecInputProducerSlotStates[slot],
           CsgCoreProductionPreExecInputProducerStateConsuming,
           CsgCoreProductionPreExecInputProducerStateConsumed):
        atomic.StoreI32(
            productionPreExecInputProducerSlotStates[slot],
            CsgCoreProductionPreExecInputProducerStateAborted)
        err = "production_pre_exec_e_producer_take_publish"
        return false
    handle = CsgCoreProductionPreExecInputProducerHandle()
    err = ""
    return true

fn CsgCoreProductionPreExecInputProducerTakeAndIssueOwnerInto(
        handle: var CsgCoreProductionPreExecInputProducerHandle,
        outEnvelopeBytes: var str,
        outOwnerHandle:
            var held_exec_provider.CsgCoreProductionPreExecInputOwnerHandle,
        outOwnerReceipt:
            var held_exec_provider.CsgCoreProductionPreExecInputOwnerReceipt,
        err: var str): bool =
    outEnvelopeBytes = ""
    outOwnerHandle =
        held_exec_provider.CsgCoreProductionPreExecInputOwnerHandle()
    outOwnerReceipt =
        held_exec_provider.CsgCoreProductionPreExecInputOwnerReceipt()
    var receipt: productionPreExecInputProducerReceipt
    if !productionPreExecInputProducerTakeInto(
           handle, outEnvelopeBytes, receipt, err):
        return false
    return held_exec_provider.CsgCoreProductionPreExecInputOwnerIssueInto(
        outEnvelopeBytes,
        receipt.sourceClosureCid,
        receipt.executableCid,
        outOwnerHandle,
        outOwnerReceipt,
        err)

@borrows
fn productionPreExecExactModulePathInto(
        req: compiler_request.CompilerRequest,
        plan: var system_link_plan.SystemLinkPlanStub,
        out: var str,
        err: var str): bool =
    out = ""
    if !compiler_request.CompilerRequestExactFunctionEnabled(req):
        err = ""
        return true
    let exactSource =
        compiler_request.CompilerRequestExactFunctionSourcePath(req)
    let sourcePaths =
        system_link_plan.SystemLinkPlanSourceClosurePaths(plan)
    let ownerModulePaths =
        system_link_plan.SystemLinkPlanOwnerModulePaths(plan)
    if sourcePaths.len != ownerModulePaths.len:
        err = "production_pre_exec_e_exact_source_columns"
        return false
    var exactIndex: int32 = -1
    for sourceIndex in 0..<sourcePaths.len:
        if sourcePaths[sourceIndex] != exactSource:
            continue
        if exactIndex >= 0:
            err = "production_pre_exec_e_exact_source_ambiguous"
            return false
        exactIndex = sourceIndex
    if exactIndex < 0 ||
       !productionPackageSourceRootModulePathValid(
           ownerModulePaths[exactIndex]):
        err = "production_pre_exec_e_exact_source_missing"
        return false
    out = strings.CloneStr(ownerModulePaths[exactIndex])
    err = ""
    return true

@borrows
fn productionPreExecInputFromCompilerRequestPlanInto(
        req: compiler_request.CompilerRequest,
        plan: var system_link_plan.SystemLinkPlanStub,
        outInput: var held_exec_provider.CsgCoreProductionPreExecInput,
        outRootIdentity:
            var CsgCoreProductionPackageSourceRootIdentityReceipt,
        err: var str): bool =
    outInput = held_exec_provider.CsgCoreProductionPreExecInput()
    outRootIdentity = CsgCoreProductionPackageSourceRootIdentityReceipt()
    if !compiler_request.CompilerRequestStrictValidateSealed(req) ||
       !system_link_plan.SystemLinkPlanSourceBundleBindingValid(plan):
        err = "production_pre_exec_e_unsealed_request_plan"
        return false
    if compiler_request.CompilerRequestCompositionPresent(req) &&
       !compiler_request.CompilerRequestCompositionSourceBundleBound(req):
        err = "HARD_RED:production_pre_exec_composition_source_bundle_unbound"
        return false
    let requestTarget =
        compiler_request.CompilerRequestTargetTriple(req)
    let requestEmit = compiler_request.CompilerRequestEmitKind(req)
    let requestVisibility =
        compiler_request.CompilerRequestSymbolVisibility(req)
    let requestExports =
        compiler_request.CompilerRequestExportRootSymbols(req)
    let requestProviders =
        compiler_request.CompilerRequestProviderObjectPaths(req)
    let requestRuntimeBundle =
        compiler_request.CompilerRequestRuntimeProviderBundle(req)
    if requestTarget != system_link_plan.SystemLinkPlanTargetTriple(plan) ||
       requestEmit != system_link_plan.SystemLinkPlanEmitKind(plan) ||
       requestVisibility !=
           system_link_plan.SystemLinkPlanSymbolVisibility(plan) ||
       !productionPreExecStringVectorsEqual(
           requestExports,
           system_link_plan.SystemLinkPlanExportRootSymbols(plan)) ||
       !productionPreExecStringVectorsEqual(
           requestProviders,
           system_link_plan.SystemLinkPlanProviderObjectPaths(plan)) ||
       requestRuntimeBundle !=
           system_link_plan.SystemLinkPlanRuntimeProviderBundle(plan) ||
       compiler_request.CompilerRequestJobCount(req) !=
           system_link_plan.SystemLinkPlanJobCount(plan):
        err = "production_pre_exec_e_request_plan_drift"
        return false
    if compiler_request.CompilerRequestBrowserBridgeObjectPath(req).len > 0 ||
       requestProviders.len > 0 || requestRuntimeBundle.len > 0:
        err = "HARD_RED:production_pre_exec_retained_object_vector_unwired"
        return false
    if !CsgCoreProductionPackageSourceRootIdentityFromPlanInto(
           plan, outRootIdentity, err):
        return false
    outInput.schemaVersion =
        held_exec_provider.CsgCoreProductionPreExecInputSchemaVersion
    outInput.compilerRequestCid =
        compiler_request.CompilerRequestCidText(req)
    outInput.semanticCommand =
        held_exec_provider.CsgCoreProductionPreExecInputCommandSystemLinkExec
    outInput.packageSourceRootIdentityCid = strings.CloneStr(
        outRootIdentity.receiptCid)
    outInput.canonicalModulePath = strings.CloneStr(
        system_link_plan.SystemLinkPlanModuleStem(plan))
    outInput.outputRole =
        held_exec_provider.CsgCoreProductionPreExecInputOutputBuildArtifact
    outInput.targetTriple = strings.CloneStr(requestTarget)
    if requestEmit == compiler_request.CompilerEmitExeValue():
        outInput.emitKind =
            held_exec_provider.CsgCoreProductionPreExecInputEmitExe
    elif requestEmit == compiler_request.CompilerEmitObjValue():
        outInput.emitKind =
            held_exec_provider.CsgCoreProductionPreExecInputEmitObj
    elif requestEmit == compiler_request.CompilerEmitSharedValue():
        outInput.emitKind =
            held_exec_provider.CsgCoreProductionPreExecInputEmitShared
    else:
        err = "production_pre_exec_e_emit_kind"
        return false
    if requestVisibility ==
           compiler_request.CompilerSymbolVisibilityPublic():
        outInput.symbolVisibility =
            held_exec_provider.CsgCoreProductionPreExecInputVisibilityPublic
    elif requestVisibility ==
           compiler_request.CompilerSymbolVisibilityInternal():
        outInput.symbolVisibility =
            held_exec_provider.CsgCoreProductionPreExecInputVisibilityInternal
    else:
        err = "production_pre_exec_e_symbol_visibility"
        return false
    let compileMode = compiler_request.CompilerRequestCompileMode(req)
    if compileMode.len == 0:
        outInput.compileMode =
            held_exec_provider.CsgCoreProductionPreExecInputCompileModeDefault
    elif compileMode == "production":
        outInput.compileMode =
            held_exec_provider.CsgCoreProductionPreExecInputCompileModeProduction
    else:
        err = "production_pre_exec_e_compile_mode"
        return false
    let backendKind = compiler_request.CompilerRequestBackendKind(req)
    if backendKind == compiler_request.CompilerBackendPrimary:
        outInput.backendKind =
            held_exec_provider.CsgCoreProductionPreExecInputBackendPrimary
    elif backendKind == compiler_request.CompilerBackend2:
        outInput.backendKind =
            held_exec_provider.CsgCoreProductionPreExecInputBackend2
    else:
        err = "production_pre_exec_e_backend_kind"
        return false
    outInput.jobCount = compiler_request.CompilerRequestJobCount(req)
    for exportIndex in 0..<requestExports.len:
        add(outInput.exportRootSymbols,
            strings.CloneStr(requestExports[exportIndex]))
    if compiler_request.CompilerRequestExactFunctionEnabled(req):
        outInput.reportRole =
            held_exec_provider.CsgCoreProductionPreExecInputReportExactFunction
        if !productionPreExecExactModulePathInto(
               req,
               plan,
               outInput.exactFunctionRequest.canonicalModulePath,
               err):
            return false
        outInput.exactFunctionRequest.symbolSelector = strings.CloneStr(
            compiler_request.CompilerRequestExactFunctionName(req))
    elif compiler_request.CompilerRequestReportPath(req).len > 0:
        outInput.reportRole =
            held_exec_provider.CsgCoreProductionPreExecInputReportCompile
    else:
        outInput.reportRole =
            held_exec_provider.CsgCoreProductionPreExecInputReportAbsent
    return held_exec_provider.CsgCoreProductionPreExecInputStrictValid(
        outInput)

@borrows
fn productionPreExecInputProducerFromCompilerRequestInto(
        req: compiler_request.CompilerRequest,
        plan: var system_link_plan.SystemLinkPlanStub,
        retainedBinaryFd: int32,
        heldBinary: held_exec_identity.ChengHeldExecFileEvidence,
        outEnvelope: var str,
        outReceipt: var productionPreExecInputProducerReceipt,
        err: var str): bool =
    outEnvelope = ""
    outReceipt = productionPreExecInputProducerReceipt()
    if !compiler_request.CompilerRequestStrictValidateSealed(req) ||
       !system_link_plan.SystemLinkPlanSourceBundleBindingValid(plan):
        err = "production_pre_exec_e_unsealed_request_plan"
        return false
    if retainedBinaryFd <= 2 || !heldBinary.nativeImageProven ||
       !heldBinary.heldDescriptorPathProven ||
       !heldBinary.namedHeldFenceClosed ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           heldBinary.bytesCid):
        err = "production_pre_exec_e_held_executable_identity"
        return false
    let expectedPlatform = held_exec_identity.ChengHeldExecIdentityPlatform()
    if heldBinary.fixedPath !=
           held_exec_identity.ChengHeldExecIdentityBinaryFixedPath(
               expectedPlatform):
        err = "production_pre_exec_e_held_executable_locator"
        return false
    let issuanceBar =
        held_exec_identity.ChengHeldExecIdentityFileIssuanceBarError(
            expectedPlatform, heldBinary)
    if issuanceBar.len != 0:
        err = strings.CloneStr(issuanceBar)
        return false
    let heldDigest = system.RuntimeHeldExecFdContentSha256(retainedBinaryFd)
    if heldDigest.status != 1 ||
       system.RuntimeHeldExecFdDigestCid(heldDigest) != heldBinary.bytesCid ||
       heldDigest.byteCount != uint64(heldBinary.held.size):
        err = "production_pre_exec_e_held_executable_fd_drift"
        return false
    var rootIdentity: CsgCoreProductionPackageSourceRootIdentityReceipt
    var input: held_exec_provider.CsgCoreProductionPreExecInput
    if !productionPreExecInputFromCompilerRequestPlanInto(
           req, plan, input, rootIdentity, err):
        return false
    var envelopeCid: str
    if !held_exec_provider.CsgCoreProductionPreExecInputEncodeInto(
           input, outEnvelope, envelopeCid, err):
        return false
    var receipt: productionPreExecInputProducerReceipt
    receipt.packageSourceRoot = rootIdentity
    receipt.rawEnvelopeCid = strings.CloneStr(envelopeCid)
    receipt.sourceClosureCid = strings.CloneStr(rootIdentity.sourceBundleCid)
    receipt.executableCid = strings.CloneStr(heldBinary.bytesCid)
    receipt.byteCount = outEnvelope.len
    receipt.complete = true
    receipt.receiptCid = productionPreExecInputProducerReceiptCid(receipt)
    if !productionPreExecInputProducerReceiptStrictValid(
           outEnvelope, receipt):
        err = "production_pre_exec_e_producer_receipt_drift"
        return false
    outReceipt = receipt
    err = ""
    return true

@borrows
fn CsgCoreProductionPreExecInputOpenHeldBinaryAndProduceInto(
        req: compiler_request.CompilerRequest,
        plan: var system_link_plan.SystemLinkPlanStub,
        outRetainedBinaryFd: var int32,
        outHandle: var CsgCoreProductionPreExecInputProducerHandle,
        err: var str): bool =
    outRetainedBinaryFd = int32(-1)
    outHandle = CsgCoreProductionPreExecInputProducerHandle()
    let platform = held_exec_identity.ChengHeldExecIdentityPlatform()
    let fixedBinaryPath =
        held_exec_identity.ChengHeldExecIdentityBinaryFixedPath(platform)
    if fixedBinaryPath.len == 0:
        err = "production_pre_exec_e_held_executable_platform"
        return false
    var retainedBinaryFd: int32 = -1
    var heldBinary: held_exec_identity.ChengHeldExecFileEvidence
    if !held_exec_identity.ChengHeldExecIdentityOpenRetainedFileInto(
           platform,
           fixedBinaryPath,
           retainedBinaryFd,
           heldBinary,
           err):
        return false
    var envelopeBytes: str
    var receipt: productionPreExecInputProducerReceipt
    if !productionPreExecInputProducerFromCompilerRequestInto(
           req,
           plan,
           retainedBinaryFd,
           heldBinary,
           envelopeBytes,
           receipt,
           err):
        let _closedRejectedBinary =
            held_exec_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    if !productionPreExecInputProducerIssueInto(
           envelopeBytes, receipt, outHandle, err):
        let _closedUnissuedBinary =
            held_exec_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    outRetainedBinaryFd = retainedBinaryFd
    err = ""
    return true

@borrows
fn productionSystemLinkAdmissionReceiptCidUnchecked(
        receipt: CsgCoreProductionSystemLinkExecAdmissionReceipt): str =
    var payload = layout.ByteBufInit(1024)
    productionSystemLinkAppendText(
        payload, CsgCoreProductionSystemLinkExecAdmissionDomain)
    productionSystemLinkAppendText(payload, receipt.schema)
    productionSystemLinkAppendText(payload, receipt.commandCid)
    productionSystemLinkAppendText(payload, receipt.inputSetCid)
    productionSystemLinkAppendText(payload, receipt.outputContractCid)
    productionSystemLinkAppendText(payload, receipt.currentHeadCid)
    productionSystemLinkAppendText(payload, receipt.manifestCid)
    productionSystemLinkAppendText(payload, receipt.csgcObjectCid)
    productionSystemLinkAppendText(payload, receipt.factsRoot)
    productionSystemLinkAppendText(payload, receipt.proofCid)
    productionSystemLinkAppendText(
        payload, receipt.csgAuthorityReceiptCid)
    productionSystemLinkAppendText(
        payload, receipt.launcherAdmissionReceiptCid)
    var bytes = layout.ByteBufToBytes(payload)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionSystemLinkExecAdmissionDomain,
        bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn CsgCoreProductionLauncherSystemLinkExecAdmissionStrictValidateInto(
        receipt: CsgCoreProductionSystemLinkExecAdmissionReceipt,
        err: var str): bool =
    if receipt.schema != CsgCoreProductionSystemLinkExecAdmissionSchema ||
       !receipt.complete:
        err = "production_system_link_admission_incomplete"
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.commandCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.inputSetCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.outputContractCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.currentHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.proofCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.csgAuthorityReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.launcherAdmissionReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.receiptCid):
        err = "production_system_link_admission_cid_invalid"
        return false
    if receipt.commandCid == receipt.inputSetCid ||
       receipt.commandCid == receipt.outputContractCid ||
       receipt.inputSetCid == receipt.outputContractCid ||
       receipt.currentHeadCid == receipt.manifestCid ||
       receipt.currentHeadCid == receipt.csgcObjectCid ||
       receipt.manifestCid == receipt.csgcObjectCid ||
       receipt.factsRoot == receipt.csgcObjectCid ||
       receipt.csgAuthorityReceiptCid ==
           receipt.launcherAdmissionReceiptCid:
        err = "production_system_link_admission_identity_aliased"
        return false
    if receipt.receiptCid !=
           productionSystemLinkAdmissionReceiptCidUnchecked(receipt):
        err = "production_system_link_admission_receipt_mismatch"
        return false
    err = ""
    return true

fn CsgCoreProductionLauncherConsumeAdmittedInputAtEntryInto(
        outHandle: var held_exec_provider.CsgCoreProductionPreExecInputChildHandle,
        err: var str): bool =
    return held_exec_provider.CsgCoreProductionPreExecInputChildTakeAndImportInto(
        outHandle, err)

@borrows
fn CsgCoreProductionPreExecInputChildValidateAndConsumeInto(
        handle: var held_exec_provider.CsgCoreProductionPreExecInputChildHandle,
        req: compiler_request.CompilerRequest,
        plan: var system_link_plan.SystemLinkPlanStub,
        outOwnerReceipt:
            var held_exec_provider.CsgCoreProductionPreExecInputOwnerReceipt,
        err: var str): bool =
    outOwnerReceipt =
        held_exec_provider.CsgCoreProductionPreExecInputOwnerReceipt()
    var imported: held_exec_provider.CsgCoreProductionPreExecInput
    if !held_exec_provider.CsgCoreProductionPreExecInputChildConsumeInto(
           handle, imported, outOwnerReceipt, err):
        return false
    var expected: held_exec_provider.CsgCoreProductionPreExecInput
    var rootIdentity: CsgCoreProductionPackageSourceRootIdentityReceipt
    if !productionPreExecInputFromCompilerRequestPlanInto(
           req, plan, expected, rootIdentity, err):
        return false
    var expectedEnvelope: str
    var expectedEnvelopeCid: str
    var importedEnvelope: str
    var importedEnvelopeCid: str
    if !held_exec_provider.CsgCoreProductionPreExecInputEncodeInto(
           expected,
           expectedEnvelope,
           expectedEnvelopeCid,
           err) ||
       !held_exec_provider.CsgCoreProductionPreExecInputEncodeInto(
           imported,
           importedEnvelope,
           importedEnvelopeCid,
           err):
        return false
    let executableCid = system.RuntimeHeldExecChildExecutableCid()
    if importedEnvelope != expectedEnvelope ||
       importedEnvelopeCid != expectedEnvelopeCid ||
       outOwnerReceipt.rawEnvelopeCid != expectedEnvelopeCid ||
       outOwnerReceipt.packageSourceRootIdentityCid !=
           rootIdentity.receiptCid ||
       outOwnerReceipt.sourceClosureCid != rootIdentity.sourceBundleCid ||
       outOwnerReceipt.executableCid != executableCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(executableCid):
        err = "production_pre_exec_e_child_request_plan_identity"
        return false
    err = ""
    return true

fn CsgCoreProductionLauncherChildImportAtEntry(): int32 =
    return system.RuntimeHeldExecChildImport()

fn CsgCoreProductionLauncherChildTerminalCapsuleImportInto(
        outChildCapsuleOwner: var int32,
        err: var str): bool =
    return merkle_store.ProductionHeldExecTerminalCapsuleChildImportInto(
        outChildCapsuleOwner, err)

fn CsgCoreProductionLauncherChildAdmissionActive(): bool =
    return system.RuntimeHeldExecChildAdmissionActive()

@borrows
fn CsgCoreProductionSystemLinkExecAdmissionSealInto(
        receipt: var CsgCoreProductionSystemLinkExecAdmissionReceipt,
        err: var str): bool =
    receipt.receiptCid =
        productionSystemLinkAdmissionReceiptCidUnchecked(receipt)
    return CsgCoreProductionLauncherSystemLinkExecAdmissionStrictValidateInto(
        receipt, err)

@borrows
fn CsgCoreProductionLauncherPublishSystemLinkExecOutputInto(
        outputCid: str,
        compileReceiptCid: str,
        compileReceiptCanonical: str,
        outputPath: str,
        err: var str): bool =
    return system.RuntimeHeldExecChildPublishOutputInto(
        outputCid,
        compileReceiptCid,
        compileReceiptCanonical,
        outputPath,
        err)

fn CsgCoreProductionLauncherBeginHeldSystemLinkSessionInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability): bool =
    sessionCapability.handle = uint64(0)
    sessionCapability.generation = uint64(0)
    sessionCapability.nonce0 = uint64(0)
    sessionCapability.nonce1 = uint64(0)
    if !cmdline.RawParamEquals(1, "system-link-exec"):
        return true
    return system.RuntimeAllocationLedgerSessionOwnerBegin(
        uint64(1073741824), sessionCapability)

fn CsgCoreProductionLauncherCloseHeldSystemLinkSessionReceiptInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability,
        outReceipt: var system.RuntimeAllocationLedgerReceipt,
        err: var str): bool =
    outReceipt = system.RuntimeAllocationLedgerReceipt()
    err = ""
    if sessionCapability.handle == uint64(0):
        err = "production_system_link_allocation_session_missing"
        return false
    let closed =
        system.RuntimeAllocationLedgerSessionOwnerClose(sessionCapability)
    if !closed.ok || !closed.receipt.complete ||
       !closed.receipt.closed || closed.receipt.active:
        if closed.error.len > 0:
            err = strings.CloneStr(closed.error)
        else:
            err = "production_system_link_allocation_session_close"
        return false
    outReceipt = closed.receipt
    return true

fn CsgCoreProductionLauncherCloseHeldSystemLinkSessionInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability): bool =
    if sessionCapability.handle == uint64(0):
        return true
    var receipt: system.RuntimeAllocationLedgerReceipt
    var err: str
    return CsgCoreProductionLauncherCloseHeldSystemLinkSessionReceiptInto(
        sessionCapability, receipt, err)

@borrows
fn productionSystemLinkAllocationReceiptCid(
        receipt: system.RuntimeAllocationLedgerReceipt): str =
    var payload = layout.ByteBufInit(96)
    productionSystemLinkAppendText(
        payload, "csg_core.production_held_exec.allocation_receipt")
    productionSystemLinkAppendU64(payload, receipt.receiptCid.word0)
    productionSystemLinkAppendU64(payload, receipt.receiptCid.word1)
    productionSystemLinkAppendU64(payload, receipt.receiptCid.word2)
    productionSystemLinkAppendU64(payload, receipt.receiptCid.word3)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(payload))
    let cid = Fmt"sha256:{layout.FixedBytes32Hex(digest)}"
    layout.ByteBufFree(payload)
    return cid

@borrows
fn CsgCoreProductionLauncherFinishSystemLinkExecChildInto(
        childCapsuleOwner: int32,
        exitCode: int32,
        allocationReceipt: system.RuntimeAllocationLedgerReceipt,
        outTerminalReceiptCid: var str,
        err: var str): bool =
    if !allocationReceipt.complete ||
       !allocationReceipt.closed || allocationReceipt.active:
        err = "production_system_link_allocation_receipt_open"
        return false
    return system.RuntimeHeldExecChildFinishInto(
        childCapsuleOwner,
        exitCode,
        productionSystemLinkAllocationReceiptCid(allocationReceipt),
        outTerminalReceiptCid,
        err)
