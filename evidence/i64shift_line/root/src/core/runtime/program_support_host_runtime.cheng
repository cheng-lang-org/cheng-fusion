# Linux held-exec descriptor transport.  Raw ancillary layout stays entirely
# inside the provider ABI; public Cheng code sees only the typed protocol
# result.  Exactly one SCM_RIGHTS fd is accepted and every received descriptor
# is CLOEXEC before it can escape this function.
@exportc("cheng_host_send_fd_runtime")
@abi_internal
fn cheng_host_send_fd_runtime_export(
        socketFd: int32,
        payload: ptr,
        payloadBytes: int32,
        passedFd: int32): int32 =
    if socketFd < 0 || payload == nil || payloadBytes <= 0 || passedFd < 0 ||
       int32(sizeof(ChengHostLinuxIovec)) != 16 ||
       int32(sizeof(ChengHostLinuxMessageHeader)) != 56 ||
       int32(sizeof(ChengHostLinuxControlOneFd)) != 24:
        return -1
    var iov: ChengHostLinuxIovec
    iov.base = payload
    iov.length = uint64(payloadBytes)
    var control: ChengHostLinuxControlOneFd
    control.length = chengHostLinuxCmsgLenOneFd
    control.level = chengHostLinuxSolSocket
    control.kind = chengHostLinuxScmRights
    control.fd0 = passedFd
    var message: ChengHostLinuxMessageHeader
    message.iov = ptr(&iov)
    message.iovCount = uint64(1)
    message.control = ptr(&control)
    message.controlLength = chengHostLinuxCmsgSpaceOneFd
    let sent = raw_libc_sendmsg(socketFd, ptr(&message), 0)
    if sent != int64(payloadBytes):
        return -1
    return int32(sent)

@exportc("cheng_host_recv_optional_fd_runtime")
@abi_internal
fn cheng_host_recv_optional_fd_runtime_export(
        socketFd: int32,
        payload: ptr,
        payloadBytes: int32,
        outFd: Int32Ptr): int32 =
    if outFd != nil:
        *outFd = -1
    if socketFd < 0 || payload == nil || payloadBytes <= 0 || outFd == nil ||
       int32(sizeof(ChengHostLinuxIovec)) != 16 ||
       int32(sizeof(ChengHostLinuxMessageHeader)) != 56 ||
       int32(sizeof(ChengHostLinuxControlOneFd)) != 24:
        return -1
    var iov: ChengHostLinuxIovec
    iov.base = payload
    iov.length = uint64(payloadBytes)
    var control: ChengHostLinuxControlOneFd
    var message: ChengHostLinuxMessageHeader
    message.iov = ptr(&iov)
    message.iovCount = uint64(1)
    message.control = ptr(&control)
    message.controlLength = chengHostLinuxCmsgSpaceOneFd
    let received = raw_libc_recvmsg(
        socketFd,
        ptr(&message),
        chengHostLinuxMsgTrunc | chengHostLinuxMsgCmsgCloexec)
    if received != int64(payloadBytes) ||
       (message.flags &
        (chengHostLinuxMsgCtrunc | chengHostLinuxMsgTrunc)) != 0:
        if message.controlLength >= chengHostLinuxCmsgLenOneFd &&
           control.length >= chengHostLinuxCmsgLenOneFd &&
           control.length <= chengHostLinuxCmsgSpaceOneFd &&
           control.level == chengHostLinuxSolSocket &&
           control.kind == chengHostLinuxScmRights:
            let receivedControlBytes =
                int32(control.length - uint64(16))
            let receivedFdCount = receivedControlBytes / 4
            for fdIndex in 0..<receivedFdCount:
                let malformedFd = fdIndex == 0 ?
                    control.fd0 : control.fd1OrPadding
                if malformedFd >= 0:
                    let _closeTruncated = raw_libc_close(malformedFd)
        return -1
    if message.controlLength == uint64(0):
        return int32(received)
    if message.controlLength != chengHostLinuxCmsgSpaceOneFd ||
       control.length != chengHostLinuxCmsgLenOneFd ||
       control.level != chengHostLinuxSolSocket ||
       control.kind != chengHostLinuxScmRights:
        if message.controlLength >= chengHostLinuxCmsgLenOneFd &&
           control.length >= chengHostLinuxCmsgLenOneFd &&
           control.length <= chengHostLinuxCmsgSpaceOneFd &&
           control.level == chengHostLinuxSolSocket &&
           control.kind == chengHostLinuxScmRights:
            let receivedControlBytes =
                int32(control.length - uint64(16))
            let receivedFdCount = receivedControlBytes / 4
            for fdIndex in 0..<receivedFdCount:
                let malformedFd = fdIndex == 0 ?
                    control.fd0 : control.fd1OrPadding
                if malformedFd >= 0:
                    let _closeMalformedControl = raw_libc_close(malformedFd)
        return -1
    let receivedFd = control.fd0
    if receivedFd < 0 ||
       raw_libc_fcntl_native(
           receivedFd,
           chengHostLinuxFSetFd,
           chengHostLinuxFdCloexec) != 0:
        if receivedFd >= 0:
            let _closeMalformed = raw_libc_close(receivedFd)
        return -1
    *outFd = receivedFd
    return int32(received)

fn cheng_host_linux_cmsg_aligned_bytes(length: uint64): int32 =
    if length < uint64(chengHostLinuxCmsgHeaderBytes) ||
       length > uint64(2147483640):
        return -1
    return int32(((length + uint64(7)) / uint64(8)) * uint64(8))

fn cheng_host_darwin_cmsg_aligned_bytes(length: uint32): int32 =
    if length < uint32(12) || length > uint32(2147483644):
        return -1
    return int32(((length + uint32(3)) / uint32(4)) * uint32(4))

fn cheng_host_activate_receive_owner_reserve(platform: int32): int32 =
    if platform != 1 && platform != 2:
        return -1
    let row = raw_cheng_atomic_fetch_add_i32(
        ptr(&chengHostActivateReceiveNextRow), 1)
    if row < 0 || row >= chengHostActivateReceiveOwnerCount ||
       raw_cheng_atomic_cas_i32(
           ptr(&chengHostActivateReceiveStates[row]),
           0,
           chengHostActivateReceiveStateOpening) != 1:
        return -1
    chengHostActivateReceivePlatforms[row] = platform
    chengHostActivateReceiveStatuses[row] = 0
    chengHostActivateReceiveReceivedBytes[row] = -1
    chengHostActivateReceiveFdCounts[row] = 0
    chengHostActivateReceivePids[row] = -1
    chengHostActivateReceiveUids[row] = uint32(0)
    chengHostActivateReceiveGids[row] = uint32(0)
    return row

fn cheng_host_activate_receive_owner_store_fd(
        row: int32,
        fd: int32): bool =
    if row < 0 || row >= chengHostActivateReceiveOwnerCount || fd < 0 ||
       chengHostActivateReceiveStates[row] !=
           chengHostActivateReceiveStateOpening:
        return false
    let slot = chengHostActivateReceiveFdCounts[row]
    if slot < 0 || slot >= chengHostActivateReceiveMaxFds:
        return false
    let index = row * chengHostActivateReceiveMaxFds + slot
    chengHostActivateReceiveFds[index] = fd
    raw_cheng_atomic_store_i32(
        ptr(&chengHostActivateReceiveCloseStates[index]),
        chengHostActivateReceiveCloseOpen)
    chengHostActivateReceiveCloseReceipts[index] = 0
    chengHostActivateReceiveFdCounts[row] = slot + 1
    return true

fn cheng_host_activate_receive_owner_use_begin(
        owner: int32,
        role: int32): int32 =
    let row = owner - 1
    # role→槽位映射：3-fd capsule 的 SCM_RIGHTS 按发送序落槽 0/1/2
    # （BundleReader, FinishedWriter, DecisionReader）。role 取值为五角色
    # 传输词汇表 id {1, 2, 5}（3=FinishedReader, 4=DecisionWriter 为对向
    # 角色，不随 3-fd capsule 过网），非物理槽位。原 `slot = role - 1`
    # 直映射把 DecisionReader(5) 映到槽 4——3-fd 接收永不 populate 槽 4，
    # use_begin 恒拒 → 子 import 必败（幽灵终验 ticket 交接墙子侧根因，
    # 判词 59）。
    var slot: int32 = -1
    if role == 1:
        slot = 0
    elif role == 2:
        slot = 1
    elif role == 5:
        slot = 2
    if row < 0 || row >= chengHostActivateReceiveOwnerCount ||
       slot < 0 ||
       chengHostActivateReceiveFdCounts[row] != 3 ||
       raw_cheng_atomic_cas_i32(
           ptr(&chengHostActivateReceiveStates[row]),
           chengHostActivateReceiveStateBound,
           chengHostActivateReceiveStateUsing) != 1:
        return -1
    let index = row * chengHostActivateReceiveMaxFds + slot
    if raw_cheng_atomic_load_i32(
           ptr(&chengHostActivateReceiveCloseStates[index])) !=
           chengHostActivateReceiveCloseOpen ||
       chengHostActivateReceiveFds[index] < 0:
        raw_cheng_atomic_store_i32(
            ptr(&chengHostActivateReceiveStates[row]),
            chengHostActivateReceiveStateBound)
        return -1
    return index

fn cheng_host_activate_receive_owner_use_end(owner: int32): bool =
    let row = owner - 1
    if row < 0 || row >= chengHostActivateReceiveOwnerCount:
        return false
    if raw_cheng_atomic_cas_i32(
           ptr(&chengHostActivateReceiveStates[row]),
           chengHostActivateReceiveStateUsing,
           chengHostActivateReceiveStateBound) == 1:
        return true
    raw_cheng_atomic_store_i32(
        ptr(&chengHostActivateReceiveStates[row]),
        chengHostActivateReceiveStateRecoveryRequired)
    return false

fn cheng_host_activate_receive_owner_close_index(index: int32): int32 =
    if index < 0 || index >= chengHostActivateReceiveFdCapacity:
        return 0
    let closeState = raw_cheng_atomic_load_i32(
        ptr(&chengHostActivateReceiveCloseStates[index]))
    if closeState == chengHostActivateReceiveCloseNotPresent:
        return 1
    if closeState == chengHostActivateReceiveCloseClean:
        return 1
    if closeState == chengHostActivateReceiveCloseError ||
       closeState == chengHostActivateReceiveCloseInvalid:
        return chengHostActivateReceiveCloseReceipts[index]
    if closeState != chengHostActivateReceiveCloseOpen ||
       raw_cheng_atomic_cas_i32(
           ptr(&chengHostActivateReceiveCloseStates[index]),
           chengHostActivateReceiveCloseOpen,
           chengHostActivateReceiveCloseClosing) != 1:
        return 0
    let fd = chengHostActivateReceiveFds[index]
    let receipt = fd >= 0 ? raw_cheng_terminal_fd_close_once(fd) : 0
    chengHostActivateReceiveFds[index] = -1
    chengHostActivateReceiveCloseReceipts[index] = receipt
    raw_cheng_atomic_store_i32(
        ptr(&chengHostActivateReceiveCloseStates[index]),
        receipt == 1 ? chengHostActivateReceiveCloseClean :
            (receipt == 2 ? chengHostActivateReceiveCloseError :
                chengHostActivateReceiveCloseInvalid))
    return receipt

fn cheng_host_activate_receive_owner_abort_opening(row: int32): bool =
    if row < 0 || row >= chengHostActivateReceiveOwnerCount ||
       raw_cheng_atomic_cas_i32(
           ptr(&chengHostActivateReceiveStates[row]),
           chengHostActivateReceiveStateOpening,
           chengHostActivateReceiveStateClosing) != 1:
        return false
    var allClean = true
    let fdCount = chengHostActivateReceiveFdCounts[row]
    for slot in 0..<fdCount:
        let index = row * chengHostActivateReceiveMaxFds + slot
        if cheng_host_activate_receive_owner_close_index(index) != 1:
            allClean = false
    raw_cheng_atomic_store_i32(
        ptr(&chengHostActivateReceiveStates[row]),
        allClean ? chengHostActivateReceiveStateClosed :
            chengHostActivateReceiveStateRecoveryRequired)
    return allClean

fn cheng_host_activate_receive_owner_publish(
        row: int32,
        accepted: bool): bool =
    if row < 0 || row >= chengHostActivateReceiveOwnerCount:
        return false
    let terminalState = accepted ? chengHostActivateReceiveStateIssued :
        chengHostActivateReceiveStateRejected
    if raw_cheng_atomic_cas_i32(
           ptr(&chengHostActivateReceiveStates[row]),
           chengHostActivateReceiveStateOpening,
           terminalState) == 1:
        return true
    # A published state may never overwrite a concurrent/corrupt state.
    # Every installed descriptor is invalidated before the process fails.
    let fdCount = chengHostActivateReceiveFdCounts[row]
    for slot in 0..<fdCount:
        let index = row * chengHostActivateReceiveMaxFds + slot
        let _closed = cheng_host_activate_receive_owner_close_index(index)
    raw_cheng_atomic_store_i32(
        ptr(&chengHostActivateReceiveStates[row]),
        chengHostActivateReceiveStateRecoveryRequired)
    raw_cheng_native_fail_stop(
        "activate receive owner publish state drift", 42, 70)
    return false

