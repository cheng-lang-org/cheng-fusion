# Failure cleanup deliberately tolerates malformed records.  Every complete
# SCM_RIGHTS scalar installed by recvmsg is closed before rejection; Linux
# closes descriptors omitted because of MSG_CTRUNC itself.
fn cheng_host_linux_close_received_rights(
        controlBase: ptr,
        controlBytes: int32) =
    if controlBase == nil || controlBytes <= 0 ||
       controlBytes > chengHostLinuxCredentialControlBytes:
        return
    var cursor: int32
    while cursor < controlBytes:
        let remaining = controlBytes - cursor
        if remaining < chengHostLinuxCmsgHeaderBytes:
            return
        let header = cheng_host_ptr_plus(controlBase, cursor)
        let length = *(UInt64Ptr(header))
        if length < uint64(chengHostLinuxCmsgHeaderBytes) ||
           length > uint64(remaining):
            return
        let level = *(Int32Ptr(cheng_host_ptr_plus(header, 8)))
        let kind = *(Int32Ptr(cheng_host_ptr_plus(header, 12)))
        let dataBytes = int32(length) - chengHostLinuxCmsgHeaderBytes
        if level == chengHostLinuxSolSocket &&
           kind == chengHostLinuxScmRights &&
           dataBytes >= int32(sizeof(int32)) &&
           dataBytes % int32(sizeof(int32)) == 0:
            let fdCount = dataBytes / int32(sizeof(int32))
            for fdIndex in 0..<fdCount:
                let receivedFd = *(Int32Ptr(cheng_host_ptr_plus(
                    header,
                    chengHostLinuxCmsgHeaderBytes +
                        fdIndex * int32(sizeof(int32)))))
                if receivedFd >= 0:
                    let _closeRejected = raw_libc_close(receivedFd)
        let alignedBytes = cheng_host_linux_cmsg_aligned_bytes(length)
        if alignedBytes < 0 || alignedBytes > remaining:
            return
        cursor = cursor + alignedBytes

# Linux credentialed one-shot receive.  The parser consumes the complete
# ancillary byte range record by record: exactly one SCM_CREDENTIALS is
# mandatory, one SCM_RIGHTS descriptor is optional, and every duplicate,
# unknown record, mis-sized record, truncation flag, or trailing byte rejects.
@exportc("cheng_host_recv_credentialed_optional_fd_runtime")
@abi_internal
fn cheng_host_recv_credentialed_optional_fd_runtime_export(
        socketFd: int32,
        payload: ptr,
        payloadBytes: int32,
        outFd: Int32Ptr,
        outPid: Int32Ptr,
        outUid: UInt32Ptr,
        outGid: UInt32Ptr): int32 =
    if outFd != nil:
        *outFd = -1
    if outPid != nil:
        *outPid = -1
    if outUid != nil:
        *outUid = uint32(0)
    if outGid != nil:
        *outGid = uint32(0)
    if cheng_host_platform_code() != 2 || socketFd < 0 || payload == nil ||
       payloadBytes <= 0 || outFd == nil || outPid == nil ||
       outUid == nil || outGid == nil ||
       int32(sizeof(ChengHostLinuxIovec)) != 16 ||
       int32(sizeof(ChengHostLinuxMessageHeader)) != 56 ||
       int32(sizeof(ChengHostLinuxCredentialControl)) !=
           chengHostLinuxCredentialControlBytes:
        return -1
    var iov: ChengHostLinuxIovec
    iov.base = payload
    iov.length = uint64(payloadBytes)
    var control: ChengHostLinuxCredentialControl
    cheng_host_bytes_set(
        ptr(&control), 0, chengHostLinuxCredentialControlBytes)
    var message: ChengHostLinuxMessageHeader
    message.iov = ptr(&iov)
    message.iovCount = uint64(1)
    message.control = ptr(&control)
    message.controlLength = uint64(chengHostLinuxCredentialControlBytes)
    let received = raw_libc_recvmsg(
        socketFd,
        ptr(&message),
        chengHostLinuxMsgTrunc | chengHostLinuxMsgCmsgCloexec)
    var availableControlBytes = chengHostLinuxCredentialControlBytes
    if message.controlLength < uint64(chengHostLinuxCredentialControlBytes):
        availableControlBytes = int32(message.controlLength)
    if received != int64(payloadBytes) ||
       message.controlLength >
           uint64(chengHostLinuxCredentialControlBytes) ||
       (message.flags &
        (chengHostLinuxMsgCtrunc | chengHostLinuxMsgTrunc)) != 0:
        cheng_host_linux_close_received_rights(
            ptr(&control), availableControlBytes)
        return -1

    let controlBytes = int32(message.controlLength)
    var cursor: int32
    var credentialCount: int32
    var rightsCount: int32
    var parsedPid: int32 = -1
    var parsedUid: uint32
    var parsedGid: uint32
    var parsedFd: int32 = -1
    var valid = controlBytes > 0
    while valid && cursor < controlBytes:
        let remaining = controlBytes - cursor
