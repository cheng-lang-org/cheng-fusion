fn cheng_host_fwrite_fd_loop(fd: int32, data: ptr, total: int64, size: int64): int64 =
    var written: int64
    while written < total:
        let remain = total - written
        var chunk: int32 = 2147483647
        if remain <= int64(2147483647):
            chunk = int32(remain)
        let n = raw_libc_write_runtime(fd, cheng_host_ptr_plus(data, int32(written)), chunk)
        if n <= int64(0):
            return n
        written = written + n
    return written / size

@exportc("cheng_host_fwrite")
fn cheng_host_fwrite_export(data: ptr, size: int64, count: int64, stream: ptr): int64 =
    if data == nil || size <= int64(0) || count <= int64(0):
        return int64(0)
    let rawStream: uint64 = uint64(stream)
    if rawStream == uint64(1):
        return cheng_host_fwrite_fd_loop(1, data, size * count, size)
    if rawStream == uint64(2):
        return cheng_host_fwrite_fd_loop(2, data, size * count, size)
    if rawStream < uint64(65536):
        return int64(0)
    return raw_libc_fwrite(data, size, count, stream)

