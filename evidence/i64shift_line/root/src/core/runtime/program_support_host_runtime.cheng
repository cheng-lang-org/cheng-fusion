# Linux production held execution is fd-addressed. Keep the raw syscall in
# this runtime-only provider so no Cheng production API can acquire an OS
# address or substitute a pathname. Darwin deliberately returns unavailable;
# its production arm requires the separate audit-token/dynamic-guest proof.
@exportc("cheng_host_exec_retained_runtime")
@abi_internal
fn cheng_host_exec_retained_runtime_export(
        retainedFd: int32,
        emptyPath: ptr,
        argv: ptr,
        envp: ptr): int32 =
    let machineCode = cheng_host_linux_machine_code()
    var syscallNumber: int64 = -1
    if machineCode == 1:
        syscallNumber = int64(322)
    elif machineCode == 2:
        syscallNumber = int64(281)
    if cheng_host_platform_code() != 2 || syscallNumber < int64(0) ||
       retainedFd < 0 || emptyPath == nil ||
       argv == nil || envp == nil:
        return -1
    let rc = raw_libc_syscall5_runtime(
        syscallNumber,
        int64(retainedFd),
        int64(uint64(emptyPath)),
        int64(uint64(argv)),
        int64(uint64(envp)),
        int64(4096))
    if rc < int64(-2147483648) || rc > int64(2147483647):
        return -1
    return int32(rc)

@exportc("cheng_host_pidfd_open_runtime")
@abi_internal
fn cheng_host_pidfd_open_runtime_export(pid: int32): int32 =
    let machineCode = cheng_host_linux_machine_code()
    if cheng_host_platform_code() != 2 ||
       (machineCode != 1 && machineCode != 2) || pid <= 0:
        return -1
    let rc = raw_libc_syscall5_runtime(
        int64(434),
        int64(pid),
        int64(0),
        int64(0),
        int64(0),
        int64(0))
    if rc < int64(-2147483648) || rc > int64(2147483647):
        return -1
    return int32(rc)

fn cheng_host_terminal_exit_error(code: int32):
        ChengHostTerminalExitObservation =
    var out: ChengHostTerminalExitObservation
    out.errorCode = code
    out.exitCode = -1
    out.rawWaitStatus = -1
    return out

fn cheng_host_terminal_exit_canonical(
        siCode: int32,
        rawStatus: int32): int32 =
    # POSIX CLD_EXITED / CLD_KILLED / CLD_DUMPED.
    if siCode == 1 && rawStatus >= 0 && rawStatus <= 255:
        return rawStatus
    if (siCode == 2 || siCode == 3) &&
       rawStatus > 0 && rawStatus <= 127:
        return 128 + rawStatus
    return -1

fn cheng_host_terminal_observation_from_fields(
        expectedPid: int32,
        expectedSignal: int32,
        signalNumber: int32,
        observedPid: int32,
        observedUid: uint32,
        siCode: int32,
        rawStatus: int32,
        rawWaitStatus: int32): ChengHostTerminalExitObservation =
    let exitCode = cheng_host_terminal_exit_canonical(
        siCode, rawStatus)
    if signalNumber != expectedSignal || observedPid != expectedPid ||
       observedUid == uint32(4294967295) || exitCode < 0:
        return cheng_host_terminal_exit_error(4)
    return ChengHostTerminalExitObservation(
        status: 1,
        childPid: observedPid,
        childUid: observedUid,
        signalNumber: signalNumber,
        siCode: siCode,
        rawStatus: rawStatus,
        exitCode: exitCode,
        rawWaitStatus: rawWaitStatus)

fn cheng_host_terminal_linux_waitid_observe_exact(
        pidfd: int32,
        expectedPid: int32): ChengHostTerminalExitObservation =
    var info: ChengHostTerminalSiginfoBuffer
    cheng_host_bytes_set(
        ptr(&info), 0, int32(sizeof(ChengHostTerminalSiginfoBuffer)))
    if raw_libc_waitid_runtime(
           3, pidfd, ptr(&info), 4 | 16777216) != 0:
        return cheng_host_terminal_exit_error(3)
    let base = ptr(&info)
    return cheng_host_terminal_observation_from_fields(
        expectedPid,
        17,
        *(Int32Ptr(base)),
        *(Int32Ptr(cheng_host_ptr_plus(base, 16))),
        *(UInt32Ptr(cheng_host_ptr_plus(base, 20))),
        *(Int32Ptr(cheng_host_ptr_plus(base, 8))),
        *(Int32Ptr(cheng_host_ptr_plus(base, 24))),
        -1)

fn cheng_host_terminal_darwin_waitid_observe_exact(
        childPid: int32): ChengHostTerminalExitObservation =
    var info: ChengHostTerminalSiginfoBuffer
    cheng_host_bytes_set(
        ptr(&info), 0, int32(sizeof(ChengHostTerminalSiginfoBuffer)))
    if raw_libc_waitid_runtime(
           1, childPid, ptr(&info), 4 | 32) != 0:
        return cheng_host_terminal_exit_error(3)
    let base = ptr(&info)
    return cheng_host_terminal_observation_from_fields(
        childPid,
        20,
        *(Int32Ptr(base)),
        *(Int32Ptr(cheng_host_ptr_plus(base, 12))),
        *(UInt32Ptr(cheng_host_ptr_plus(base, 16))),
        *(Int32Ptr(cheng_host_ptr_plus(base, 8))),
        *(Int32Ptr(cheng_host_ptr_plus(base, 20))),
        -1)

fn cheng_host_terminal_linux_waitid_reap_exact(
        pidfd: int32,
        expectedPid: int32): ChengHostTerminalExitObservation =
    var info: ChengHostTerminalSiginfoBuffer
    cheng_host_bytes_set(
        ptr(&info), 0, int32(sizeof(ChengHostTerminalSiginfoBuffer)))
    if raw_libc_waitid_runtime(3, pidfd, ptr(&info), 4) != 0:
        return cheng_host_terminal_exit_error(3)
    let base = ptr(&info)
    return cheng_host_terminal_observation_from_fields(
        expectedPid,
        17,
        *(Int32Ptr(base)),
        *(Int32Ptr(cheng_host_ptr_plus(base, 16))),
        *(UInt32Ptr(cheng_host_ptr_plus(base, 20))),
        *(Int32Ptr(cheng_host_ptr_plus(base, 8))),
        *(Int32Ptr(cheng_host_ptr_plus(base, 24))),
        -1)

@exportc("cheng_host_terminal_linux_pidfd_event_wait_runtime")
@abi_internal
fn cheng_host_terminal_linux_pidfd_event_wait_runtime_export(
        pidfd: int32,
        childPid: int32): ChengHostTerminalExitObservation =
    let machineCode = cheng_host_linux_machine_code()
    if cheng_host_platform_code() != 2 ||
       (machineCode != 1 && machineCode != 2) ||
       pidfd < 0 || childPid <= 0:
        return cheng_host_terminal_exit_error(1)
    # waitid(P_PIDFD, ..., WEXITED|WNOWAIT) blocks on the pidfd event itself;
    # no poll/sleep/retry loop participates in terminal authority.
    return cheng_host_terminal_linux_waitid_observe_exact(pidfd, childPid)

@exportc("cheng_host_terminal_darwin_kqueue_event_wait_runtime")
@abi_internal
fn cheng_host_terminal_darwin_kqueue_event_wait_runtime_export(
        childPid: int32): ChengHostTerminalExitObservation =
    if cheng_host_platform_code() != 1 || childPid <= 0:
        return cheng_host_terminal_exit_error(1)
    # The Darwin provider owns the real libc kqueue/kevent ABI.  Common host
    # code receives only a scalar NOTE_EXIT readiness result, then obtains the
    # authoritative non-reaping siginfo tuple with waitid.
    if raw_terminal_darwin_kqueue_note_exit_wait_bridge(childPid) != 1:
        return cheng_host_terminal_exit_error(5)
    return cheng_host_terminal_darwin_waitid_observe_exact(childPid)

fn cheng_host_terminal_linux_pidfd_reap_exact(
        pidfd: int32,
        childPid: int32): ChengHostTerminalExitObservation =
    let machineCode = cheng_host_linux_machine_code()
    if cheng_host_platform_code() != 2 ||
       (machineCode != 1 && machineCode != 2) ||
       pidfd < 0 || childPid <= 0:
        return cheng_host_terminal_exit_error(1)
    return cheng_host_terminal_linux_waitid_reap_exact(pidfd, childPid)

fn cheng_host_terminal_darwin_waitpid_reap_exact(
        childPid: int32): ChengHostTerminalExitObservation =
    if cheng_host_platform_code() != 1 || childPid <= 0:
        return cheng_host_terminal_exit_error(1)
    var waitStatus: int32
    let waited = raw_libc_waitpid_runtime(childPid, ptr(&waitStatus), 0)
    if waited != childPid:
        return cheng_host_terminal_exit_error(7)
    let low = waitStatus & 127
    var reapedSiCode: int32
    var reapedRawStatus: int32
    if low == 0:
        reapedSiCode = 1
        reapedRawStatus = (waitStatus >> 8) & 255
    elif low != 127:
        reapedSiCode = (waitStatus & 128) != 0 ? 3 : 2
        reapedRawStatus = low
    else:
        return cheng_host_terminal_exit_error(8)
    let exitCode = cheng_host_terminal_exit_canonical(
        reapedSiCode, reapedRawStatus)
    if exitCode < 0:
        return cheng_host_terminal_exit_error(9)
    return ChengHostTerminalExitObservation(
        status: 1,
        childPid: childPid,
        childUid: uint32(0),
        signalNumber: 20,
        siCode: reapedSiCode,
        rawStatus: reapedRawStatus,
        exitCode: exitCode,
        rawWaitStatus: waitStatus)

@exportc("cheng_host_terminal_exit_reap_runtime")
@abi_internal
fn cheng_host_terminal_exit_reap_runtime_export(
        pidfd: int32,
        childPid: int32): ChengHostTerminalExitObservation =
    if cheng_host_platform_code() == 1:
        return cheng_host_terminal_darwin_waitpid_reap_exact(
            childPid)
    if cheng_host_platform_code() == 2:
        return cheng_host_terminal_linux_pidfd_reap_exact(
            pidfd, childPid)
    return cheng_host_terminal_exit_error(1)

@exportc("cheng_host_memfd_create_runtime")
@abi_internal
fn cheng_host_memfd_create_runtime_export(
        name: ptr,
        flags: int32): int32 =
    let machineCode = cheng_host_linux_machine_code()
    var syscallNumber: int64 = -1
    if machineCode == 1:
        syscallNumber = int64(319)
    elif machineCode == 2:
        syscallNumber = int64(279)
    if cheng_host_platform_code() != 2 || syscallNumber < int64(0) ||
       name == nil || flags != 3:
        return -1
    let rc = raw_libc_syscall5_runtime(
        syscallNumber,
        int64(uint64(name)),
        int64(flags),
        int64(0),
        int64(0),
        int64(0))
    if rc < int64(0) || rc > int64(2147483647):
        return -1
    return int32(rc)

# Anonymous held file pinned to the directory identified by dirFd.  Linux
# uses openat(dirFd, ".", O_TMPFILE|O_RDWR|O_CLOEXEC, 0600) so the inode
# never has a pathname.  Darwin has no O_TMPFILE: the equivalent contract is
# an O_CREAT|O_EXCL leaf with a 128-bit entropy name inside the same
# directory, unlinked before the descriptor escapes this provider, so the fd
# is already anonymous on return.  Every failure path closes partial state
# and returns -1; there is no named-temporary-file fallback.
@exportc("cheng_host_tmpfile_anon_runtime")
@abi_internal
fn cheng_host_tmpfile_anon_runtime_export(dirFd: int32): int32 =
    if dirFd < 0:
        return -1
    let platform = cheng_host_platform_code()
    if platform == 2:
        let selfName = cheng_host_copy_cstring_from_str(".")
        if selfName == nil:
            return -1
        let linuxFd = raw_host_openat_fixed(
            dirFd,
            selfName,
            chengHostLinuxAnonTmpfileFlags,
            chengHostAnonTmpfileMode)
        raw_libc_free(selfName)
        return linuxFd >= 0 ? linuxFd : -1
    if platform != 1:
        return -1
    var attempt: int32
    while attempt < chengHostAnonTmpMaxAttempts:
        attempt = attempt + 1
        var name: uint8[48]
        cheng_host_bytes_set(ptr(&name), 0, chengHostAnonTmpNameBytes)
        var entropy: uint8[16]
        if raw_libc_getentropy(ptr(&entropy), 16) != 0:
            return -1
        let prefix = cheng_host_copy_cstring_from_str("cheng.anon.")
        if prefix == nil:
            return -1
        cheng_host_bytes_copy(ptr(&name), prefix, 11)
        raw_libc_free(prefix)
        for byteIndex in 0..<16:
            let high = int32(entropy[byteIndex]) >> 4
            let low = int32(entropy[byteIndex]) & 15
            name[11 + byteIndex * 2] =
                uint8(high < 10 ? 48 + high : 87 + high)
            name[12 + byteIndex * 2] =
                uint8(low < 10 ? 48 + low : 87 + low)
        let fd = raw_host_openat_fixed(
            dirFd,
            ptr(&name),
            chengHostDarwinAnonTmpfileFlags,
            chengHostAnonTmpfileMode)
        if fd < 0:
            continue
        if raw_libc_unlinkat(dirFd, ptr(&name), 0) != 0:
            let _closeUnlinkFailure = raw_libc_close(fd)
            return -1
        return fd
    return -1

