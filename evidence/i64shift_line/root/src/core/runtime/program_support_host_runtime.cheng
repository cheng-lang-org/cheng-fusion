    return raw_libc_inet_ntop_native(family, src, dst, size)

@exportc("cheng_host_close")
fn cheng_host_close_export(fd: int32): int32 =
    return raw_libc_close(fd)

@exportc("cheng_host_socket_startup")
fn cheng_host_socket_startup_export(): int32 =
    return 0

@exportc("cheng_host_execvp")
fn cheng_host_execvp_export(file: ptr, argv: ptr): int32 =
    return raw_libc_execvp(file, argv)

@exportc("cheng_host_process_signal_bridge")
fn cheng_host_process_signal_bridge_export(pid: int64, signalCode: int32): int32 =
    if pid <= int64(0) || signalCode < 0:
        return -1
    let targetPid: int32 = int32(pid)
    if signalCode > 0:
        let groupPid: int32 = 0 - targetPid
        if raw_libc_kill_runtime(groupPid, signalCode) == 0:
            return 0
    return raw_libc_kill_runtime(targetPid, signalCode)

@exportc("cheng_host_process_exists_bridge")
fn cheng_host_process_exists_bridge_export(pid: int64): int32 =
    if pid <= int64(0):
        return 0
    if raw_libc_kill_runtime(int32(pid), 0) == 0:
        return 1
    return 0

@exportc("cheng_host_strerror")
fn cheng_host_strerror_export(err: int32): ptr =
    return raw_libc_strerror(err)

# Desktop/smoke absent-host for scene chat_text_send. Never succeeds.
# Android supplies a strong cheng_host_social_dm_send (JNI → socialDmSend).
@weak @exportc("cheng_host_social_dm_send")
fn cheng_host_social_dm_send_absent(peerId: cstring, conversationId: cstring, messageJson: cstring): bool =
    if peerId == nil || conversationId == nil || messageJson == nil:
        return false
    return false
