fn cheng_host_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(int64(uint64(base)) + int64(off)))

fn cheng_seq_drop_str_field_tail_fail() =
    raw_libc_exit_runtime(133)

# Type-driven seq shrink glue for an inline `str` leaf. The lowering records a
# LocalI32 CallOp result, so the provider ABI returns a deterministic status.
@exportc("cheng_seq_drop_str_field_tail")
fn cheng_seq_drop_str_field_tail_export(seqPtr: ptr,
                                         newLen: int32,
                                         elemSize: int32,
                                         fieldOffset: int32): int32 =
    if seqPtr == nil:
        cheng_seq_drop_str_field_tail_fail()
        return 1
    let strSize: int32 = int32(sizeof(ChengDropStr))
    if elemSize <= 0 || fieldOffset < 0 || strSize <= 0 ||
       fieldOffset > elemSize - strSize:
        cheng_seq_drop_str_field_tail_fail()
        return 1
    let seqHdr: ChengDropSeqHeaderPtr = ChengDropSeqHeaderPtr(seqPtr)
    if seqHdr->len < 0 || seqHdr->cap < 0 || seqHdr->cap < seqHdr->len:
        cheng_seq_drop_str_field_tail_fail()
        return 1
    var target: int32 = newLen
    if target < 0:
        target = 0
    if target >= seqHdr->len:
        return 0
    if seqHdr->buffer == nil:
        cheng_seq_drop_str_field_tail_fail()
        return 1
    let oldLen: int32 = seqHdr->len
    for itemIndex in target..<oldLen:
        let rowOffset64: int64 = int64(itemIndex) * int64(elemSize) + int64(fieldOffset)
        if rowOffset64 < int64(0) || rowOffset64 > int64(2147483647):
            cheng_seq_drop_str_field_tail_fail()
            return 1
        let slot: ChengDropStrPtr = ChengDropStrPtr(cheng_host_ptr_plus(seqHdr->buffer, int32(rowOffset64)))
        if slot->flags == 1 && slot->data != nil:
            raw_cheng_mem_release(slot->data)
        slot->data = nil
        slot->len = 0
        slot->store_id = 0
        slot->flags = 0
    return 0

fn cheng_host_bytes_copy(dst: ptr, src: ptr, n0: int32) =
    if dst == nil || src == nil || n0 <= 0:
        return
    for i in 0..<n0:
        *(UInt8Ptr(cheng_host_ptr_plus(dst, i))) = *(UInt8Ptr(cheng_host_ptr_plus(src, i)))

fn cheng_host_bytes_set(dst: ptr, value: int32, n0: int32) =
    if dst == nil || n0 <= 0:
        return
    let byteValue: uint8 = uint8(value & 255)
    for i in 0..<n0:
        *(UInt8Ptr(cheng_host_ptr_plus(dst, i))) = byteValue

fn cheng_host_cstrlen(raw: ptr): int32 =
    if raw == nil:
        return 0
    var n: int32
    while n < 4096:
        if *(UInt8Ptr(cheng_host_ptr_plus(raw, n))) == uint8(0):
            return n
        n = n + 1
    return n

fn cheng_host_bounded_cstrlen(raw: ptr, capacity: int32): int32 =
    if raw == nil || capacity <= 0:
        return -1
    for index in 0..<capacity:
        if *(UInt8Ptr(cheng_host_ptr_plus(raw, index))) == uint8(0):
            return index
    return -1

fn cheng_host_buffer_remaining(
        raw: ptr,
        buffer: ptr,
        capacity: int32): int32 =
    if raw == nil || buffer == nil || capacity <= 0:
        return -1
    let rawAddress = uint64(raw)
    let bufferAddress = uint64(buffer)
    if rawAddress < bufferAddress:
        return -1
    let offset = rawAddress - bufferAddress
    if offset >= uint64(capacity):
        return -1
    return capacity - int32(offset)

fn cheng_host_utf8_continuation(value: uint8): bool =
    return value >= uint8(128) && value <= uint8(191)

fn cheng_host_utf8_valid(raw: ptr, length: int32): bool =
    if raw == nil || length <= 0:
        return false
    var index: int32
    while index < length:
        let lead = *(UInt8Ptr(cheng_host_ptr_plus(raw, index)))
        if lead <= uint8(127):
            if lead == uint8(0):
                return false
            index = index + 1
            continue
        if lead >= uint8(194) && lead <= uint8(223):
            if index + 1 >= length ||
               !cheng_host_utf8_continuation(
                   *(UInt8Ptr(cheng_host_ptr_plus(raw, index + 1)))):
                return false
            index = index + 2
            continue
        if lead >= uint8(224) && lead <= uint8(239):
            if index + 2 >= length:
                return false
            let second =
                *(UInt8Ptr(cheng_host_ptr_plus(raw, index + 1)))
            let third =
                *(UInt8Ptr(cheng_host_ptr_plus(raw, index + 2)))
            if !cheng_host_utf8_continuation(third):
                return false
            if lead == uint8(224):
                if second < uint8(160) || second > uint8(191):
                    return false
            elif lead == uint8(237):
                if second < uint8(128) || second > uint8(159):
                    return false
            elif !cheng_host_utf8_continuation(second):
                return false
            index = index + 3
            continue
        if lead >= uint8(240) && lead <= uint8(244):
            if index + 3 >= length:
                return false
            let second =
                *(UInt8Ptr(cheng_host_ptr_plus(raw, index + 1)))
            if lead == uint8(240):
                if second < uint8(144) || second > uint8(191):
                    return false
            elif lead == uint8(244):
                if second < uint8(128) || second > uint8(143):
                    return false
            elif !cheng_host_utf8_continuation(second):
                return false
            if !cheng_host_utf8_continuation(
                   *(UInt8Ptr(cheng_host_ptr_plus(raw, index + 2)))) ||
               !cheng_host_utf8_continuation(
                   *(UInt8Ptr(cheng_host_ptr_plus(raw, index + 3)))):
                return false
            index = index + 4
            continue
        return false
    return true

fn cheng_host_absolute_path_bytes_valid(
        path: ptr,
        pathLength: int32): bool =
    if path == nil || pathLength <= 1 ||
       *(UInt8Ptr(path)) != uint8(47) ||
       *(UInt8Ptr(cheng_host_ptr_plus(
           path, pathLength - 1))) == uint8(47) ||
       !cheng_host_utf8_valid(path, pathLength):
        return false
    var segmentStart: int32 = 1
    var position: int32 = 1
    while position <= pathLength:
        if position < pathLength:
            let value =
                *(UInt8Ptr(cheng_host_ptr_plus(path, position)))
            if value != uint8(47):
                if value < uint8(32) || value == uint8(127) ||
                   value == uint8(92):
                    return false
                position = position + 1
                continue
        let segmentLength = position - segmentStart
        if segmentLength <= 0:
            return false
        if segmentLength == 1 &&
           *(UInt8Ptr(cheng_host_ptr_plus(
               path, segmentStart))) == uint8(46):
            return false
        if segmentLength == 2 &&
           *(UInt8Ptr(cheng_host_ptr_plus(
               path, segmentStart))) == uint8(46) &&
           *(UInt8Ptr(cheng_host_ptr_plus(
               path, segmentStart + 1))) == uint8(46):
            return false
        segmentStart = position + 1
        position = position + 1
    return true

@borrows
fn cheng_host_single_path_name_valid(name: str): bool =
    if len(name) <= 0 || name == "." || name == "..":
        return false
    for index in 0..<len(name):
        let value = uint8(name[index])
        if value < uint8(32) || value == uint8(127) ||
           value == uint8(47) || value == uint8(92):
            return false
    return true

@borrows
fn cheng_host_raw_text_eq(raw: ptr, text: str): bool =
    if raw == nil:
        return false
    if cheng_host_cstrlen(raw) != len(text):
        return false
    for i in 0..<len(text):
        if *(UInt8Ptr(cheng_host_ptr_plus(raw, i))) != uint8(text[i]):
            return false
    return true

fn cheng_host_platform_code(): int32 =
    var buf: ChengHostUnameBuffer
    cheng_host_bytes_set(
        ptr(&buf), 0, int32(sizeof(ChengHostUnameBuffer)))
    if raw_libc_uname(ptr(&buf)) != 0:
        return 0
    if cheng_host_raw_text_eq(ptr(&buf), "Darwin"):
        return 1
    if cheng_host_raw_text_eq(ptr(&buf), "Linux"):
        return 2
    return 0

fn cheng_host_is_darwin_runtime(): bool =
    return cheng_host_platform_code() == 1

fn cheng_host_linux_machine_code(): int32 =
    if cheng_host_platform_code() != 2:
        return 0
    var buf: ChengHostUnameBuffer
    cheng_host_bytes_set(ptr(&buf), 0, int32(sizeof(ChengHostUnameBuffer)))
    if raw_libc_uname(ptr(&buf)) != 0:
        return 0
    # Linux struct utsname is six char[65] fields; machine is field four.
    let machine = cheng_host_ptr_plus(ptr(&buf), 260)
    if cheng_host_raw_text_eq(machine, "x86_64"):
        return 1
    if cheng_host_raw_text_eq(machine, "aarch64") ||
       cheng_host_raw_text_eq(machine, "arm64"):
        return 2
    return 0

fn cheng_host_directory_open_flags(): int32 =
    if cheng_host_is_darwin_runtime():
        return 0 | 256 | 1048576 | 16777216
    return 0 | 131072 | 65536 | 524288

fn cheng_host_raw_equal(left: ptr, right: ptr): bool =
    if left == nil || right == nil:
        return false
    let leftLength = cheng_host_bounded_cstrlen(
        left, chengHostPersistentPathBytes)
    let rightLength = cheng_host_bounded_cstrlen(
        right, chengHostPersistentPathBytes)
    if leftLength <= 0 || leftLength != rightLength:
        return false
    for index in 0..<leftLength:
        if *(UInt8Ptr(cheng_host_ptr_plus(left, index))) !=
           *(UInt8Ptr(cheng_host_ptr_plus(right, index))):
            return false
    return true

fn cheng_host_copy_raw_text(
        output: ptr,
        capacity: int32,
        text: ptr): bool =
    if output == nil || text == nil || capacity <= 1:
        return false
    let textLength = cheng_host_bounded_cstrlen(text, capacity)
    if textLength <= 0 || textLength >= capacity:
        return false
    cheng_host_bytes_set(output, 0, capacity)
    cheng_host_bytes_copy(output, text, textLength)
    return true

fn cheng_host_copy_literal(
        output: ptr,
        capacity: int32,
        text: str): bool =
    if output == nil || capacity <= len(text):
        return false
    cheng_host_bytes_set(output, 0, capacity)
    for index in 0..<len(text):
        *(UInt8Ptr(cheng_host_ptr_plus(output, index))) =
            uint8(text[index])
    return true

fn cheng_host_append_literal(
        output: ptr,
        capacity: int32,
        suffix: str): bool =
    if output == nil:
        return false
    let currentLength = cheng_host_bounded_cstrlen(output, capacity)
    if currentLength <= 0 ||
       currentLength + len(suffix) >= capacity:
        return false
    for index in 0..<len(suffix):
        *(UInt8Ptr(cheng_host_ptr_plus(
            output, currentLength + index))) =
                uint8(suffix[index])
    *(UInt8Ptr(cheng_host_ptr_plus(
        output, currentLength + len(suffix)))) = uint8(0)
    return true

fn cheng_host_fstat_directory_identity(
        fd: int32,
        outMode: Int32Ptr,
        outUid: UInt32Ptr,
        outDevice: UInt64Ptr,
        outInode: UInt64Ptr): bool =
    if fd < 0 || outMode == nil || outUid == nil ||
       outDevice == nil || outInode == nil:
        return false
    var statBuffer: ChengHostStatBuffer
    cheng_host_bytes_set(
        ptr(&statBuffer), 0, int32(sizeof(ChengHostStatBuffer)))
    if raw_libc_fstat(fd, ptr(&statBuffer)) != 0:
        return false
    let base = ptr(&statBuffer)
    if cheng_host_is_darwin_runtime():
        *outMode = int32(*(UInt16Ptr(
            cheng_host_ptr_plus(base, 4))))
        *outUid = *(UInt32Ptr(cheng_host_ptr_plus(base, 16)))
        *outDevice = uint64(*(UInt32Ptr(base)))
    else:
        let machineCode = cheng_host_linux_machine_code()
        if machineCode == 1:
            *outMode = int32(*(UInt32Ptr(
                cheng_host_ptr_plus(base, 24))))
            *outUid = *(UInt32Ptr(
                cheng_host_ptr_plus(base, 28)))
        elif machineCode == 2:
            *outMode = int32(*(UInt32Ptr(
                cheng_host_ptr_plus(base, 16))))
            *outUid = *(UInt32Ptr(
                cheng_host_ptr_plus(base, 24)))
        else:
            return false
        *outDevice = *(UInt64Ptr(base))
    *outInode = *(UInt64Ptr(cheng_host_ptr_plus(base, 8)))
    return true

fn cheng_host_directory_identity_allowed(
        fd: int32,
        expectedUid: uint32,
        requireUserOwner: bool,
        requirePrivateMode: bool,
        outDevice: UInt64Ptr,
        outInode: UInt64Ptr): bool =
    var mode: int32
    var ownerUid: uint32
    if !cheng_host_fstat_directory_identity(
           fd, &mode, &ownerUid, outDevice, outInode):
        return false
    if (mode & chengHostTypeMask) != chengHostDirectoryType:
        return false
    if requireUserOwner:
        if ownerUid != expectedUid:
            return false
    elif ownerUid != uint32(0) && ownerUid != expectedUid:
        return false
    if (mode & chengHostGroupWorldWriteMask) != 0:
        return false
    if requirePrivateMode &&
       (mode & chengHostPrivateDirectoryModeMask) !=
           chengHostPrivateDirectoryMode:
        return false
    return true

fn cheng_host_open_absolute_directory(
        path: ptr,
        expectedUid: uint32,
        requireLeafUserOwner: bool,
        requireLeafPrivateMode: bool,
        outDevice: UInt64Ptr,
        outInode: UInt64Ptr): int32 =
    if path == nil || outDevice == nil || outInode == nil:
        return -1
    let pathLength = cheng_host_bounded_cstrlen(
        path, chengHostPersistentPathBytes)
    if !cheng_host_absolute_path_bytes_valid(path, pathLength):
        return -1
    let flags = cheng_host_directory_open_flags()
    let slash = cheng_host_copy_cstring_from_str("/")
    if slash == nil:
        return -1
    var currentFd = raw_host_openat_fixed(-100, slash, flags, 0)
    raw_libc_free(slash)
    if currentFd < 0:
        return -1
    var rootDevice: uint64
    var rootInode: uint64
    if !cheng_host_directory_identity_allowed(
           currentFd, expectedUid, false, false,
           &rootDevice, &rootInode):
        let ignoredClose = raw_libc_close(currentFd)
        return -1
    var start: int32 = 1
    var position: int32 = 1
    while position <= pathLength:
        if position < pathLength &&
           *(UInt8Ptr(cheng_host_ptr_plus(
               path, position))) != uint8(47):
            position = position + 1
            continue
        let segmentLength = position - start
        if segmentLength <= 0:
            let ignoredClose = raw_libc_close(currentFd)
            return -1
        let segment = raw_libc_malloc(int64(segmentLength + 1))
        if segment == nil:
            let ignoredClose = raw_libc_close(currentFd)
            return -1
        cheng_host_bytes_set(segment, 0, segmentLength + 1)
        cheng_host_bytes_copy(
            segment, cheng_host_ptr_plus(path, start), segmentLength)
        let nextFd =
            raw_host_openat_fixed(currentFd, segment, flags, 0)
        raw_libc_free(segment)
        if nextFd < 0:
            let ignoredClose = raw_libc_close(currentFd)
            return -1
        let isLeaf = position == pathLength
        var device: uint64
        var inode: uint64
        if !cheng_host_directory_identity_allowed(
               nextFd,
               expectedUid,
               isLeaf && requireLeafUserOwner,
               isLeaf && requireLeafPrivateMode,
               &device,
               &inode):
            let ignoredNextClose = raw_libc_close(nextFd)
            let ignoredClose = raw_libc_close(currentFd)
            return -1
        let ignoredClose = raw_libc_close(currentFd)
        currentFd = nextFd
        if isLeaf:
            *outDevice = device
            *outInode = inode
        start = position + 1
        position = position + 1
    return currentFd

fn cheng_host_open_or_create_private_child(
        parentFd: int32,
        name: str,
        expectedUid: uint32,
        requirePrivateMode: bool): int32 =
    if parentFd < 0 ||
       !cheng_host_single_path_name_valid(name):
        return -1
    let rawName = cheng_host_copy_cstring_from_str(name)
    if rawName == nil:
        return -1
    let flags = cheng_host_directory_open_flags()
    var childFd = raw_host_openat_fixed(
        parentFd, rawName, flags, 0)
    if childFd < 0:
        if raw_libc_mkdirat(
               parentFd,
               rawName,
               chengHostPrivateDirectoryMode) != 0:
            raw_libc_free(rawName)
            return -1
        childFd = raw_host_openat_fixed(
            parentFd, rawName, flags, 0)
    raw_libc_free(rawName)
    if childFd < 0:
        return -1
    var device: uint64
    var inode: uint64
    if !cheng_host_directory_identity_allowed(
           childFd,
           expectedUid,
           true,
           requirePrivateMode,
           &device,
           &inode):
        let ignoredClose = raw_libc_close(childFd)
        return -1
    if raw_libc_fsync(childFd) != 0:
        let ignoredClose = raw_libc_close(childFd)
        return -1
    if raw_libc_fsync(parentFd) != 0:
        let ignoredClose = raw_libc_close(childFd)
        return -1
    return childFd

fn cheng_host_passwd_home_canonical(
        expectedUid: uint32,
        platformCode: int32,
        outCanonicalHome: ptr,
        outCapacity: int32): int32 =
    if outCanonicalHome == nil ||
       outCapacity < chengHostPersistentPathBytes:
        return -10
    var homeOffset: int32
    if platformCode == 1:
        homeOffset = chengHostDarwinPasswdHomeOffset
    elif platformCode == 2:
        if cheng_host_linux_machine_code() == 0:
            return -13
        homeOffset = chengHostLinuxPasswdHomeOffset
    else:
        return -13

    var passwdRecord: ChengHostPasswdRecordBuffer
    var passwdCapacity = chengHostPasswdTextBytes
    var passwdText = raw_libc_malloc(int64(passwdCapacity))
    if passwdText == nil:
        return -11
    var foundRecord: ptr
    var passwdLookupRc: int32
    var lookupComplete: bool
    while !lookupComplete:
        cheng_host_bytes_set(
            ptr(&passwdRecord), 0, chengHostPasswdRecordBytes)
        cheng_host_bytes_set(passwdText, 0, passwdCapacity)
        foundRecord = nil
        passwdLookupRc = raw_libc_getpwuid_r(
            expectedUid,
            ptr(&passwdRecord),
            passwdText,
            int64(passwdCapacity),
            ptr(&foundRecord))
        if passwdLookupRc != chengHostErange:
            lookupComplete = true
            continue
        raw_libc_free(passwdText)
        passwdText = nil
        if passwdCapacity >= chengHostPasswdTextMaxBytes:
            return -11
        passwdCapacity = passwdCapacity * 2
        if passwdCapacity > chengHostPasswdTextMaxBytes:
            passwdCapacity = chengHostPasswdTextMaxBytes
        passwdText = raw_libc_malloc(int64(passwdCapacity))
        if passwdText == nil:
            return -11
    if passwdLookupRc != 0 ||
       foundRecord != ptr(&passwdRecord):
        raw_libc_free(passwdText)
        return -11

    let recordBase = ptr(&passwdRecord)
    let recordUid = *(UInt32Ptr(cheng_host_ptr_plus(
        recordBase, chengHostPasswdUidOffset)))
    if recordUid != expectedUid:
        raw_libc_free(passwdText)
        return -12
    let passwdHome =
        *(VoidPtrPtr(cheng_host_ptr_plus(recordBase, homeOffset)))
    let homeRemaining = cheng_host_buffer_remaining(
        passwdHome, passwdText, passwdCapacity)
    let homeLength = cheng_host_bounded_cstrlen(
        passwdHome, homeRemaining)
    if homeRemaining <= 0 ||
       !cheng_host_absolute_path_bytes_valid(
           passwdHome, homeLength):
        raw_libc_free(passwdText)
        return -14

    cheng_host_bytes_set(
        outCanonicalHome, 0, outCapacity)
    if raw_libc_realpath(
           passwdHome, outCanonicalHome) == nil:
        raw_libc_free(passwdText)
        return -15
    let canonicalLength = cheng_host_bounded_cstrlen(
        outCanonicalHome, outCapacity)
    if canonicalLength != homeLength ||
       !cheng_host_absolute_path_bytes_valid(
           outCanonicalHome, canonicalLength) ||
       !cheng_host_raw_equal(
           passwdHome, outCanonicalHome):
        raw_libc_free(passwdText)
        return -15
    raw_libc_free(passwdText)
    return 0

@exportc("cheng_host_authenticated_persistent_root")
fn cheng_host_authenticated_persistent_root_export(
        expectedUid: uint32,
        outRoot: ptr,
        rootCapacity: int32,
        outPlatform: ptr,
        platformCapacity: int32): int32 =
    if outRoot == nil || outPlatform == nil ||
       rootCapacity < chengHostPersistentPathBytes ||
       platformCapacity < 16:
        return -10
    cheng_host_bytes_set(outRoot, 0, rootCapacity)
    cheng_host_bytes_set(outPlatform, 0, platformCapacity)
    if raw_libc_geteuid() != expectedUid:
        return -10
    let platformCode = cheng_host_platform_code()
    var platformText: str
    if platformCode == 1:
        platformText = "darwin"
    elif platformCode == 2:
        if cheng_host_linux_machine_code() == 0:
            return -13
        platformText = "linux"
    else:
        return -13
    var canonicalHome: uint8[4096]
    let passwdHomeRc = cheng_host_passwd_home_canonical(
        expectedUid,
        platformCode,
        ptr(&canonicalHome),
        chengHostPersistentPathBytes)
    if passwdHomeRc != 0:
        return passwdHomeRc
    var homeDevice: uint64
    var homeInode: uint64
    var currentFd = cheng_host_open_absolute_directory(
        ptr(&canonicalHome),
        expectedUid,
        true,
        false,
        &homeDevice,
        &homeInode)
    if currentFd < 0:
        return -16
    if platformCode == 1:
        let libraryFd = cheng_host_open_or_create_private_child(
            currentFd, "Library", expectedUid, false)
        let ignoredHomeClose = raw_libc_close(currentFd)
        if libraryFd < 0:
            return -17
        let supportFd = cheng_host_open_or_create_private_child(
            libraryFd, "Application Support", expectedUid, false)
        let ignoredLibraryClose = raw_libc_close(libraryFd)
        if supportFd < 0:
            return -18
        currentFd = cheng_host_open_or_create_private_child(
            supportFd, "Cheng", expectedUid, true)
        let ignoredSupportClose = raw_libc_close(supportFd)
        if currentFd < 0:
            return -19
    else:
        let localFd = cheng_host_open_or_create_private_child(
            currentFd, ".local", expectedUid, false)
        let ignoredHomeClose = raw_libc_close(currentFd)
        if localFd < 0:
            return -20
        let shareFd = cheng_host_open_or_create_private_child(
            localFd, "share", expectedUid, false)
        let ignoredLocalClose = raw_libc_close(localFd)
        if shareFd < 0:
            return -21
        currentFd = cheng_host_open_or_create_private_child(
            shareFd, "cheng", expectedUid, true)
        let ignoredShareClose = raw_libc_close(shareFd)
        if currentFd < 0:
            return -22
    var expectedRoot: uint8[4096]
    if !cheng_host_copy_raw_text(
           ptr(&expectedRoot),
           chengHostPersistentPathBytes,
           ptr(&canonicalHome)):
        let ignoredClose = raw_libc_close(currentFd)
        return -23
    let suffixOk =
        platformCode == 1 ?
            cheng_host_append_literal(
                ptr(&expectedRoot),
                chengHostPersistentPathBytes,
                "/Library/Application Support/Cheng") :
            cheng_host_append_literal(
                ptr(&expectedRoot),
                chengHostPersistentPathBytes,
                "/.local/share/cheng")
    if !suffixOk:
        let ignoredClose = raw_libc_close(currentFd)
        return -24
    cheng_host_bytes_set(outRoot, 0, rootCapacity)
    if raw_libc_realpath(
           ptr(&expectedRoot), outRoot) == nil ||
       !cheng_host_absolute_path_bytes_valid(
           outRoot,
           cheng_host_bounded_cstrlen(
               outRoot, rootCapacity)) ||
       !cheng_host_raw_equal(
           ptr(&expectedRoot), outRoot):
        let ignoredClose = raw_libc_close(currentFd)
        return -25
    var heldMode: int32
    var heldUid: uint32
    var heldDevice: uint64
    var heldInode: uint64
    if !cheng_host_fstat_directory_identity(
           currentFd,
           &heldMode,
           &heldUid,
           &heldDevice,
           &heldInode) ||
       heldUid != expectedUid ||
       (heldMode & chengHostTypeMask) != chengHostDirectoryType ||
       (heldMode & chengHostPrivateDirectoryModeMask) !=
           chengHostPrivateDirectoryMode:
        let ignoredClose = raw_libc_close(currentFd)
        return -26
    var reopenedDevice: uint64
    var reopenedInode: uint64
    let reopenedFd = cheng_host_open_absolute_directory(
        outRoot,
        expectedUid,
        true,
        true,
        &reopenedDevice,
        &reopenedInode)
    if reopenedFd < 0 ||
       reopenedDevice != heldDevice ||
       reopenedInode != heldInode:
        if reopenedFd >= 0:
            let ignoredReopenedClose =
                raw_libc_close(reopenedFd)
        let ignoredClose = raw_libc_close(currentFd)
        return -27
    let ignoredReopenedClose = raw_libc_close(reopenedFd)
    let ignoredClose = raw_libc_close(currentFd)
    if !cheng_host_copy_literal(
           outPlatform, platformCapacity, platformText):
        return -28
    return 0

fn cheng_host_ascii_is_drive(ch: uint8): bool =
    let code: int32 = int32(ch)
    if code >= 65:
        if code <= 90:
            return true
    if code >= 97:
        if code <= 122:
            return true
    return false

fn cheng_host_msys_drive_path(path: ptr): bool =
    if path == nil:
        return false
    let slash0 = *(UInt8Ptr(path))
    if slash0 != uint8(47):
        return false
    let drive = *(UInt8Ptr(cheng_host_ptr_plus(path, 1)))
    if !cheng_host_ascii_is_drive(drive):
        return false
    let slash2 = *(UInt8Ptr(cheng_host_ptr_plus(path, 2)))
    if slash2 == uint8(47):
        return true
    if slash2 == uint8(92):
        return true
    return false

fn cheng_host_copy_msys_drive_path(path: ptr): ptr =
    let n = cheng_host_cstrlen(path)
    if n < 3 || !cheng_host_msys_drive_path(path):
        return nil
    let out = raw_libc_malloc(int64(n + 1))
    if out == nil:
        return nil
    *(UInt8Ptr(out)) = *(UInt8Ptr(cheng_host_ptr_plus(path, 1)))
    *(UInt8Ptr(cheng_host_ptr_plus(out, 1))) = uint8(58)
    *(UInt8Ptr(cheng_host_ptr_plus(out, 2))) = uint8(47)
    for i in 3..<n:
        let ch = *(UInt8Ptr(cheng_host_ptr_plus(path, i)))
        if ch == uint8(92):
            *(UInt8Ptr(cheng_host_ptr_plus(out, i))) = uint8(47)
        else:
            *(UInt8Ptr(cheng_host_ptr_plus(out, i))) = ch
    *(UInt8Ptr(cheng_host_ptr_plus(out, n))) = uint8(0)
    return out

fn cheng_host_u16le_at(raw: ptr, off: int32): int32 =
    let lo: int32 = int32(*(UInt8Ptr(cheng_host_ptr_plus(raw, off))))
    let hi: int32 = int32(*(UInt8Ptr(cheng_host_ptr_plus(raw, off + 1))))
    return lo + (hi << 8)

fn cheng_host_dirent_name_len(entRaw: ptr): int32 =
    if entRaw == nil:
        return 0
    return cheng_host_u16le_at(entRaw, 18)

fn cheng_host_list_dir_entry_name(entRaw: ptr,
                                  linuxDirent: bool,
                                  outName: var ptr,
                                  outLen: var int32): bool =
    if entRaw == nil:
        return false
    let nameOff: int32 = linuxDirent ? chengHostLinuxDirentNameOff : chengHostDirentNameOff
    let namePtr: ptr = cheng_host_ptr_plus(entRaw, nameOff)
    var nameLen: int32
    if linuxDirent:
        let reclen: int32 = cheng_host_u16le_at(entRaw, 16)
        if reclen <= nameOff:
            return false
        nameLen = cheng_host_bounded_cstrlen(namePtr, reclen - nameOff)
        if nameLen <= 0:
            return false
    else:
        nameLen = cheng_host_dirent_name_len(entRaw)
        if nameLen <= 0:
            nameLen = cheng_host_cstrlen(namePtr)
        if nameLen <= 0:
            return false
    if nameLen == 1 && *UInt8Ptr(namePtr) == uint8(46):
        return false
    if nameLen == 2 &&
       *UInt8Ptr(namePtr) == uint8(46) &&
       *UInt8Ptr(cheng_host_ptr_plus(namePtr, 1)) == uint8(46):
        return false
    outName = namePtr
    outLen = nameLen
    return true

fn cheng_host_fd_at(fds: ptr, idx: int32): int32 =
    if fds == nil:
        return -1
    return *(Int32Ptr(cheng_host_ptr_plus(fds, idx * int32(sizeof(int32)))))

fn cheng_host_close_fd_if_valid(fd: int32) =
    if fd >= 0:
        let ignoredClose = raw_libc_close(fd)

fn cheng_host_af_inet(): int32 =
    return raw_native_af_inet_bridge()

fn cheng_host_af_inet6(): int32 =
    return raw_native_af_inet6_bridge()

fn cheng_host_sockaddr_use_len_field(): bool =
    let flag = raw_native_sockaddr_use_len_field_bridge()
    if flag != 0:
        return true
    return false

fn cheng_host_copy_cstring_from_str(text: str): ptr =
    let n: int32 = len(text)
    let out: ptr = raw_libc_malloc(int64(n + 1))
    if out == nil:
        return nil
    cheng_host_bytes_set(out, 0, n + 1)
    for i in 0..<n:
        *(UInt8Ptr(cheng_host_ptr_plus(out, i))) = uint8(int32(text[i]) & 255)
    return out

fn cheng_host_path_is_empty(path: ptr): bool =
    if path == nil:
        return true
    if *(UInt8Ptr(path)) == uint8(0):
        return true
    return false

fn cheng_host_path_is_dir(path: ptr): bool =
    if cheng_host_path_is_empty(path):
        return false
    let dir = raw_libc_opendir(path)
    if dir == nil:
        return false
    raw_libc_closedir(dir)
    return true

fn cheng_host_fopen_read(path: ptr): ptr =
    if cheng_host_path_is_empty(path):
        return nil
    let mode = cheng_host_copy_cstring_from_str("rb")
    if mode == nil:
        return nil
    let fp = raw_libc_fopen(path, mode)
    raw_libc_free(mode)
    return fp

@exportc("cheng_host_file_exists_raw")
fn cheng_host_file_exists_raw_export(path: ptr): int32 =
    if cheng_host_path_is_empty(path):
        return 0
    let fp = cheng_host_fopen_read(path)
    if fp == nil:
        return 0
    raw_libc_fclose(fp)
    return 1

@exportc("cheng_host_file_size_raw")
fn cheng_host_file_size_raw_export(path: ptr): int64 =
    if cheng_host_path_is_empty(path):
        return 0
    let fp = cheng_host_fopen_read(path)
    if fp == nil:
        return 0
    if raw_libc_fseek(fp, 0, chengHostSeekEnd) != 0:
        raw_libc_fclose(fp)
        return 0
    let size = raw_libc_ftell(fp)
    raw_libc_fclose(fp)
    if size < 0:
        return 0
    return size

fn cheng_host_sockaddr_ipv4_from_raw(port: int32, rawAddr: ptr): ptr =
    let addr = raw_libc_malloc(chengHostSockaddrInLen)
    if addr == nil:
        return nil
    cheng_host_bytes_set(addr, 0, chengHostSockaddrInLen)
    let family = cheng_host_af_inet()
    if cheng_host_sockaddr_use_len_field():
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 0))) = uint8(chengHostSockaddrInLen)
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 1))) = uint8(family & 255)
    else:
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 0))) = uint8(family & 255)
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 1))) = uint8((family >> 8) & 255)
    *(UInt8Ptr(cheng_host_ptr_plus(addr, 2))) = uint8((port >> 8) & 255)
    *(UInt8Ptr(cheng_host_ptr_plus(addr, 3))) = uint8(port & 255)
    if rawAddr != nil:
        cheng_host_bytes_copy(cheng_host_ptr_plus(addr, 4), rawAddr, 4)
    return addr

fn cheng_host_sockaddr_ipv6_from_raw(port: int32, rawAddr: ptr): ptr =
    let addr = raw_libc_malloc(chengHostSockaddrIn6Len)
    if addr == nil:
        return nil
    cheng_host_bytes_set(addr, 0, chengHostSockaddrIn6Len)
    let family = cheng_host_af_inet6()
    if cheng_host_sockaddr_use_len_field():
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 0))) = uint8(chengHostSockaddrIn6Len)
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 1))) = uint8(family & 255)
    else:
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 0))) = uint8(family & 255)
        *(UInt8Ptr(cheng_host_ptr_plus(addr, 1))) = uint8((family >> 8) & 255)
    *(UInt8Ptr(cheng_host_ptr_plus(addr, 2))) = uint8((port >> 8) & 255)
    *(UInt8Ptr(cheng_host_ptr_plus(addr, 3))) = uint8(port & 255)
    if rawAddr != nil:
        cheng_host_bytes_copy(cheng_host_ptr_plus(addr, 8), rawAddr, 16)
    return addr

fn cheng_host_tcp_connect_first_resolved(entry: HostEntPtr, port: int32): int32 =
    if entry == nil || entry->h_addr_list == nil:
        return -1
    let family: int32 = entry->h_addrtype
    let rawLen: int32 = entry->h_length
    var idx: int32
    while true:
        let slot: ptr = cheng_host_ptr_plus(entry->h_addr_list, idx * int32(sizeof(ptr)))
        if slot == nil:
            return -1
        let rawAddr: ptr = *(VoidPtrPtr(slot))
        if rawAddr == nil:
            return -1
        var sockaddrLen: int32
        var sockaddrRaw: ptr = nil
        if family == cheng_host_af_inet() && rawLen >= 4:
            sockaddrRaw = cheng_host_sockaddr_ipv4_from_raw(port, rawAddr)
            sockaddrLen = chengHostSockaddrInLen
        elif family == cheng_host_af_inet6() && rawLen >= 16:
            sockaddrRaw = cheng_host_sockaddr_ipv6_from_raw(port, rawAddr)
            sockaddrLen = chengHostSockaddrIn6Len
        if sockaddrRaw != nil:
            let fd: int32 = raw_libc_socket(family, chengHostSockStream, 0)
            if fd >= 0:
                if raw_libc_connect(fd, sockaddrRaw, sockaddrLen) == 0:
                    raw_libc_free(sockaddrRaw)
                    return fd
                cheng_host_close_fd_if_valid(fd)
            raw_libc_free(sockaddrRaw)
        idx = idx + 1
    return -1

