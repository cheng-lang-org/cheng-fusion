@exportc("cheng_host_strcmp")
fn cheng_host_strcmp_export(a: ptr, b: ptr): int32 =
    if a == b:
        return 0
    var left: ptr = a
    var right: ptr = b
    if left == nil:
        left = ""
    if right == nil:
        right = ""
    return raw_libc_strcmp(left, right)

@importc("mmap")
fn raw_libc_mmap(addr: ptr, len: int64, prot: int32, flags: int32, fd: int32, offset: int64): ptr

@importc("munmap")
fn raw_libc_munmap(addr: ptr, len: int64): int32

# Anonymous private mapping for large allocations. munmap on free returns
# pages to the OS while libc free keeps them in the malloc pool. prot 3 is
# read plus write. flags 4098 is MAP_ANON plus MAP_PRIVATE on darwin. On
# Linux the anon flag differs so this mmap fails and returns nil there and
# callers observably fall back to malloc. Keep this comment ASCII only.
@exportc("cheng_host_mmap_anon")
fn cheng_host_mmap_anon_export(size: int64): ptr =
    if size <= 0:
        return nil
    var fdNone: int32
    fdNone = fdNone - 1
    let p: ptr = raw_libc_mmap(nil, size, 3, 4098, fdNone, int64(0))
    var failWord: int64
    failWord = failWord - 1
    if int64(p) == failWord:
        return nil
    return p

@exportc("cheng_host_munmap")
fn cheng_host_munmap_export(p: ptr, size: int64): int32 =
    return raw_libc_munmap(p, size)

