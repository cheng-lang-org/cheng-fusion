    chengHostStdInFd = 0
    chengHostStdOutFd: int32 = 1
    chengHostStdErrFd: int32 = 2
    chengHostSeekSet = 0
    chengHostSeekEnd: int32 = 2
    chengHostPersistentPathBytes: int32 = 4096
    chengHostPasswdRecordBytes: int32 = 128
    chengHostPasswdTextBytes: int32 = 16384
    chengHostPasswdTextMaxBytes: int32 = 1048576
    chengHostErange: int32 = 34
    chengHostPasswdUidOffset: int32 = 16
    chengHostDarwinPasswdHomeOffset: int32 = 48
    chengHostLinuxPasswdHomeOffset: int32 = 32
    chengHostDirectoryType: int32 = 16384
    chengHostTypeMask: int32 = 61440
    chengHostGroupWorldWriteMask: int32 = 18
    chengHostPrivateDirectoryMode: int32 = 448
    chengHostPrivateDirectoryModeMask: int32 = 4095
    chengHostLinuxSolSocket: int32 = 1
    chengHostLinuxScmRights: int32 = 1
    chengHostLinuxScmCredentials: int32 = 2
    chengHostLinuxSoPasscred: int32 = 16
    chengHostLinuxMsgCtrunc: int32 = 8
    chengHostLinuxMsgTrunc: int32 = 32
    chengHostLinuxMsgCmsgCloexec: int32 = 1073741824
    chengHostLinuxFdCloexec: int32 = 1
    chengHostLinuxFGetFd: int32 = 1
    chengHostLinuxFSetFd: int32 = 2
    chengHostLinuxCmsgHeaderBytes: int32 = 16
    chengHostLinuxCredentialsBytes: int32 = 12
    chengHostLinuxCmsgLenCredentials: uint64 = uint64(28)
    chengHostLinuxCmsgSpaceCredentials: uint64 = uint64(32)
    chengHostLinuxCmsgLenOneFd: uint64 = uint64(20)
    chengHostLinuxCmsgSpaceOneFd: uint64 = uint64(24)
    # Linux caps one SCM_RIGHTS message at 253 descriptors.  This buffer holds
    # that maximum plus the mandatory credential record, so a malformed sender
    # cannot make installed descriptors unreachable to the failure cleanup.
    chengHostLinuxRightsMaxFds: int32 = 253
    chengHostLinuxCredentialControlBytes: int32 = 1088
    chengHostDarwinSolSocket: int32 = 65535
    chengHostDarwinScmRights: int32 = 1
    chengHostDarwinMsgCtrunc: int32 = 32
    chengHostDarwinMsgTrunc: int32 = 16
    chengHostDarwinCmsgLenOneFd: uint64 = uint64(16)
    chengHostDarwinCmsgSpaceOneFd: uint64 = uint64(16)
    chengHostDarwinFdCloexec: int32 = 1
    chengHostDarwinFSetFd: int32 = 2
    # Linux CMSG_LEN/CMSG_SPACE for a fixed two-descriptor SCM_RIGHTS record:
    # 16-byte header plus 8 bytes of payload, already 8-aligned.
    chengHostLinuxCmsgLenTwoFd: uint64 = uint64(24)
    chengHostLinuxCmsgSpaceTwoFd: uint64 = uint64(24)
    # Three descriptors add 12 bytes to the 16-byte Linux cmsghdr.  CMSG_LEN
    # is 28 and the record occupies one 8-byte-aligned 32-byte control slot.
    chengHostLinuxCmsgLenThreeFd: uint64 = uint64(28)
    chengHostLinuxCmsgSpaceThreeFd: uint64 = uint64(32)
    # Darwin cmsghdr is 12 bytes and 4-aligned; two descriptors add 8 bytes.
    chengHostDarwinCmsgLenTwoFd: uint64 = uint64(20)
    chengHostDarwinCmsgSpaceTwoFd: uint64 = uint64(20)
    # Darwin cmsghdr is 12 bytes and 4-aligned; three descriptors add 12.
    chengHostDarwinCmsgLenThreeFd: uint64 = uint64(24)
    chengHostDarwinCmsgSpaceThreeFd: uint64 = uint64(24)
    # XNU bsd/kern/uipc_usrreq.c defines UIPC_MAX_CMSG_FD as 512.  The
    # receive buffer must hold the complete installed set before exact-three
    # role validation; MSG_CTRUNC does not revoke descriptors already placed
    # in the receiver table.
    chengHostDarwinRightsMaxFds: int32 = 512
    chengHostDarwinRightsControlBytes: int32 = 2060
    # Linux O_TMPFILE|O_RDWR|O_CLOEXEC with mode 0600.  The openat bridge
    # carries the variadic mode argument, so the flags word stays fixed here.
    chengHostLinuxAnonTmpfileFlags: int32 = 4784130
    # Darwin has no O_TMPFILE: the equivalent held fd is create-exclusive
    # (O_RDWR|O_CREAT|O_EXCL|O_CLOEXEC) under an entropy-named leaf that is
    # unlinked before the descriptor escapes this provider.
    chengHostDarwinAnonTmpfileFlags: int32 = 16779778
    chengHostAnonTmpfileMode: int32 = 384
    chengHostAnonTmpNameBytes: int32 = 48
    chengHostAnonTmpMaxAttempts: int32 = 8
    chengHostActivateReceiveOwnerCount: int32 = 4096
    chengHostActivateReceiveMaxFds: int32 = 512
    chengHostActivateReceiveFdCapacity: int32 = 2097152
    chengHostActivateReceiveStateOpening: int32 = 1
    chengHostActivateReceiveStateIssued: int32 = 2
    chengHostActivateReceiveStateBound: int32 = 3
    chengHostActivateReceiveStateRejected: int32 = 4
    chengHostActivateReceiveStateClosing: int32 = 5
    chengHostActivateReceiveStateClosed: int32 = 6
    chengHostActivateReceiveStateRecoveryRequired: int32 = 7
    chengHostActivateReceiveStateUsing: int32 = 8
    chengHostActivateReceiveCloseNotPresent: int32 = 0
    chengHostActivateReceiveCloseOpen: int32 = 1
    chengHostActivateReceiveCloseClosing: int32 = 2
    chengHostActivateReceiveCloseClean: int32 = 3
    chengHostActivateReceiveCloseError: int32 = 4
    chengHostActivateReceiveCloseInvalid: int32 = 5
    chengHostActivateReceiveRoleBundle: int32 = 1
    chengHostActivateReceiveRoleFinishedWriter: int32 = 2
    chengHostActivateReceiveRoleDecisionReader: int32 = 3

