# Linux held-exec socketpair authority.  SO_PASSCRED is enabled and read back
# on both endpoints before either descriptor can escape this provider.
@exportc("cheng_host_socketpair_passcred_runtime")
@abi_internal
fn cheng_host_socketpair_passcred_runtime_export(
        domain: int32,
        socketType: int32,
        protocol: int32,
        fds: Int32Ptr): int32 =
    if fds == nil:
        return -1
    let fd0: Int32Ptr = fds
    let fd1 = Int32Ptr(cheng_host_ptr_plus(ptr(fds), 4))
    *fd0 = -1
    *fd1 = -1
    if cheng_host_platform_code() != 2 ||
       domain != 1 || socketType != 5 || protocol != 0 ||
       raw_libc_socketpair_runtime(
           domain, socketType, protocol, ptr(fds)) != 0 ||
       *fd0 < 0 || *fd1 < 0 || *fd0 == *fd1:
        if *fd0 >= 0:
            let _closeInvalid0 = raw_libc_close(*fd0)
        if *fd1 >= 0:
            let _closeInvalid1 = raw_libc_close(*fd1)
        *fd0 = -1
        *fd1 = -1
        return -1
    var enabled: int32 = 1
    let set0 = raw_libc_setsockopt(
        *fd0,
        chengHostLinuxSolSocket,
        chengHostLinuxSoPasscred,
        ptr(&enabled),
        int32(sizeof(int32)))
    let set1 = raw_libc_setsockopt(
        *fd1,
        chengHostLinuxSolSocket,
        chengHostLinuxSoPasscred,
        ptr(&enabled),
        int32(sizeof(int32)))
    var observed0: int32
    var observed1: int32
    var observedLength0: int32 = int32(sizeof(int32))
    var observedLength1: int32 = int32(sizeof(int32))
    let get0 = raw_libc_getsockopt_runtime(
        *fd0,
        chengHostLinuxSolSocket,
        chengHostLinuxSoPasscred,
        ptr(&observed0),
        ptr(&observedLength0))
    let get1 = raw_libc_getsockopt_runtime(
        *fd1,
        chengHostLinuxSolSocket,
        chengHostLinuxSoPasscred,
        ptr(&observed1),
        ptr(&observedLength1))
    if set0 != 0 || set1 != 0 || get0 != 0 || get1 != 0 ||
       observedLength0 != int32(sizeof(int32)) ||
       observedLength1 != int32(sizeof(int32)) ||
       observed0 != 1 || observed1 != 1:
        let _closePasscred0 = raw_libc_close(*fd0)
        let _closePasscred1 = raw_libc_close(*fd1)
        *fd0 = -1
        *fd1 = -1
        return -1
    return 0

