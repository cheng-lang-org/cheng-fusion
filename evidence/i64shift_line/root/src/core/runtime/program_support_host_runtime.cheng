@exportc("cheng_host_list_dir")
fn cheng_host_list_dir_export(path: ptr): ptr =
    let linuxDirent: bool = cheng_host_platform_code() == 2
    let emptyOut: ptr = raw_libc_malloc(1)
    if emptyOut != nil:
        cheng_host_bytes_set(emptyOut, 0, 1)
    if path == nil || *UInt8Ptr(path) == uint8(0):
        return emptyOut
    let dir: ptr = raw_libc_opendir(path)
    if dir == nil:
        return emptyOut
    var totalBytes: int32 = 1
    while true:
        let entRaw: ptr = raw_libc_readdir(dir)
        if entRaw == nil:
            break
        var namePtr: ptr
        var nameLen: int32
        if !cheng_host_list_dir_entry_name(entRaw, linuxDirent, namePtr, nameLen):
            continue
        totalBytes = totalBytes + nameLen + 1
    if totalBytes <= 1:
        raw_libc_closedir(dir)
        return emptyOut
    raw_libc_rewinddir(dir)
    var lenOut: int32
    let cap: int32 = totalBytes
    let out: ptr = raw_libc_malloc(cap)
    if out == nil:
        raw_libc_closedir(dir)
        if emptyOut != nil:
            raw_libc_free(emptyOut)
        return nil
    cheng_host_bytes_set(out, 0, 1)
    if emptyOut != nil:
        raw_libc_free(emptyOut)
    while true:
        let entRaw: ptr = raw_libc_readdir(dir)
        if entRaw == nil:
            break
        var namePtr: ptr
        var nameLen: int32
        if !cheng_host_list_dir_entry_name(entRaw, linuxDirent, namePtr, nameLen):
            continue
        var need: int32 = lenOut + nameLen + 2
        if need > cap:
            raw_libc_closedir(dir)
            raw_libc_free(out)
            return nil
        cheng_host_bytes_copy(cheng_host_ptr_plus(out, lenOut), namePtr, nameLen)
        lenOut = lenOut + nameLen
        cheng_host_bytes_set(cheng_host_ptr_plus(out, lenOut), 10, 1)
        lenOut = lenOut + 1
        cheng_host_bytes_set(cheng_host_ptr_plus(out, lenOut), 0, 1)
    raw_libc_closedir(dir)
    return out

