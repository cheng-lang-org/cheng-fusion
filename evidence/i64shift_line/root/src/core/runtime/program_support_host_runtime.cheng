@exportc("cheng_host_fstat_scalars")
fn cheng_host_fstat_scalars_export(fd: int32,
                                    outSize: Int64Ptr,
                                    outMode: Int32Ptr,
                                    outDev: UInt64Ptr,
                                    outIno: UInt64Ptr): int32 =
    if fd < 0 || outSize == nil || outMode == nil ||
       outDev == nil || outIno == nil:
        return -2
    var statBuf: ChengHostStatBuffer
    cheng_host_bytes_set(ptr(&statBuf), 0,
                         int32(sizeof(ChengHostStatBuffer)))
    if raw_libc_fstat(fd, ptr(&statBuf)) != 0:
        return -1
    let base = ptr(&statBuf)
    var modeOffset: int32
    var sizeOffset: int32
    var inoOffset: int32 = 8
    if cheng_host_is_darwin_runtime():
        modeOffset = 4
        sizeOffset = 96
        *outMode = int32(*(UInt16Ptr(cheng_host_ptr_plus(base,
                                                          modeOffset))))
        *outDev = uint64(*(UInt32Ptr(base)))
    else:
        let machineCode = cheng_host_linux_machine_code()
        if machineCode == 1:
            modeOffset = 24
        elif machineCode == 2:
            modeOffset = 16
        else:
            return -2
        sizeOffset = 48
        *outMode = int32(*(UInt32Ptr(cheng_host_ptr_plus(base,
                                                          modeOffset))))
        *outDev = *(UInt64Ptr(base))
    *outSize = *(Int64Ptr(cheng_host_ptr_plus(base, sizeOffset)))
    *outIno = *(UInt64Ptr(cheng_host_ptr_plus(base, inoOffset)))
    return 0

@exportc("cheng_host_fstat_identity")
fn cheng_host_fstat_identity_export(fd: int32,
                                     outSize: Int64Ptr,
                                     outMode: Int32Ptr,
                                     outDevice: UInt64Ptr,
                                     outInode: UInt64Ptr,
                                     outMtimeSec: Int64Ptr,
                                     outMtimeNsec: Int64Ptr,
                                     outCtimeSec: Int64Ptr,
                                     outCtimeNsec: Int64Ptr,
                                     outChangeVersion: UInt64Ptr): int32 =
    if fd < 0 || outSize == nil || outMode == nil ||
       outDevice == nil || outInode == nil || outMtimeSec == nil ||
       outMtimeNsec == nil || outCtimeSec == nil ||
       outCtimeNsec == nil || outChangeVersion == nil:
        return -2
    var statBuf: ChengHostStatBuffer
    cheng_host_bytes_set(ptr(&statBuf), 0,
                         int32(sizeof(ChengHostStatBuffer)))
    if raw_libc_fstat(fd, ptr(&statBuf)) != 0:
        return -1
    let base = ptr(&statBuf)
    var modeOffset: int32
    var sizeOffset: int32
    var mtimeSecOffset: int32
    var mtimeNsecOffset: int32
    var ctimeSecOffset: int32
    var ctimeNsecOffset: int32
    var genOffset: int32 = -1
    let inoOffset: int32 = 8
    if cheng_host_is_darwin_runtime():
        modeOffset = 4
        sizeOffset = 96
        mtimeSecOffset = 48
        mtimeNsecOffset = 56
        ctimeSecOffset = 64
        ctimeNsecOffset = 72
        genOffset = 120
        *outMode = int32(*(UInt16Ptr(cheng_host_ptr_plus(base,
                                                          modeOffset))))
        *outDevice = uint64(*(UInt32Ptr(base)))
    else:
        let machineCode = cheng_host_linux_machine_code()
        if machineCode == 1:
            modeOffset = 24
        elif machineCode == 2:
            modeOffset = 16
        else:
            return -2
        sizeOffset = 48
        mtimeSecOffset = 88
        mtimeNsecOffset = 96
        ctimeSecOffset = 104
        ctimeNsecOffset = 112
        *outMode = int32(*(UInt32Ptr(cheng_host_ptr_plus(base,
                                                          modeOffset))))
        *outDevice = *(UInt64Ptr(base))
    *outSize = *(Int64Ptr(cheng_host_ptr_plus(base, sizeOffset)))
    *outInode = *(UInt64Ptr(cheng_host_ptr_plus(base, inoOffset)))
    *outMtimeSec = *(Int64Ptr(cheng_host_ptr_plus(base, mtimeSecOffset)))
    *outMtimeNsec = *(Int64Ptr(cheng_host_ptr_plus(base, mtimeNsecOffset)))
    *outCtimeSec = *(Int64Ptr(cheng_host_ptr_plus(base, ctimeSecOffset)))
    *outCtimeNsec = *(Int64Ptr(cheng_host_ptr_plus(base, ctimeNsecOffset)))
    if genOffset >= 0:
        *outChangeVersion = uint64(*(UInt32Ptr(cheng_host_ptr_plus(base,
                                                                    genOffset))))
    else:
        *outChangeVersion = uint64(0)
    return 0

@exportc("cheng_host_fstat_nlink")
fn cheng_host_fstat_nlink_export(fd: int32,
                                  outLinkCount: UInt64Ptr): int32 =
    if fd < 0 || outLinkCount == nil:
        return -2
    var statBuf: ChengHostStatBuffer
    cheng_host_bytes_set(ptr(&statBuf), 0,
                         int32(sizeof(ChengHostStatBuffer)))
    if raw_libc_fstat(fd, ptr(&statBuf)) != 0:
        return -1
    let base = ptr(&statBuf)
    if cheng_host_is_darwin_runtime():
        *outLinkCount =
            uint64(*(UInt16Ptr(cheng_host_ptr_plus(base, 6))))
        return 0
    let machineCode = cheng_host_linux_machine_code()
    if machineCode == 1:
        *outLinkCount =
            *(UInt64Ptr(cheng_host_ptr_plus(base, 16)))
        return 0
    if machineCode == 2:
        *outLinkCount =
            uint64(*(UInt32Ptr(cheng_host_ptr_plus(base, 20))))
        return 0
    return -2

