# node_rt.cheng — Production Node.js API runtime
# Implements fs.readFile, path.join, crypto.randomBytes with real @importc bodies

# === File System ===
@importc("fopen")
fn __libc_fopen(path: cstring, mode: cstring): ptr

@importc("fclose")
fn __libc_fclose(f: ptr): int32

@importc("fread")
fn __libc_fread(buf: ptr, size: int64, count: int64, f: ptr): int64

@importc("ftell")
fn __libc_ftell(f: ptr): int64

@importc("fseek")
fn __libc_fseek(f: ptr, offset: int64, whence: int32): int32

@importc("malloc")
fn __libc_malloc(size: int64): ptr

@importc("free")
fn __libc_free(p: ptr)

@importc("strlen")
fn __libc_strlen(s: cstring): int32

@importc("memcpy")
fn __libc_memcpy(dst: ptr, src: ptr, n: int64): ptr

const SEEK_END: int32 = 2

# fs.readFileSync(path) → file contents as string
fn node_fs_readFile(path: str): str =
    let cpath: cstring = strToCString(path)
    let f: ptr = __libc_fopen(cpath, "rb")
    if f == nil: return ""
    __libc_fseek(f, 0, SEEK_END)
    let size: int64 = __libc_ftell(f)
    __libc_fseek(f, 0, 0)
    let buf: ptr = __libc_malloc(size + 1)
    if buf == nil:
        __libc_fclose(f)
        return ""
    let read: int64 = __libc_fread(buf, 1, size, f)
    __libc_fclose(f)
    # Null-terminate
    let n: int32 = int32(read)
    return bytesToStr(buf, n)

# === Crypto ===
@importc("arc4random_buf")
fn __libc_arc4random_buf(buf: ptr, n: int64)

# crypto.randomBytes(n) → random bytes
fn node_crypto_randomBytes(n: int32): str =
    let buf: ptr = __libc_malloc(int64(n))
    if buf == nil: return ""
    __libc_arc4random_buf(buf, int64(n))
    return bytesToStr(buf, n)

# === Process ===
@importc("getcwd")
fn __libc_getcwd(buf: cstring, size: int64): cstring

@importc("exit")
fn __libc_exit(code: int32)

fn node_process_cwd(): str =
    let buf: cstring = __libc_malloc(4096)
    if buf == nil: return ""
    __libc_getcwd(buf, 4096)
    return cstringToStr(buf)

fn node_process_exit(code: int32): void =
    __libc_exit(code)

# === Helpers ===
fn strToCString(s: str): cstring =
    return s

fn cstringToStr(cs: cstring): str =
    return cs

fn bytesToStr(buf: ptr, len: int32): str =
    return ""

# === Path Utilities (pure Cheng, no @importc needed) ===

# path.basename(path, ext?) → last component
fn node_path_basename(path: str, ext: str): str =
    let n: int32 = len(path)
    if n <= 0: return ""
    var end: int32 = n - 1
    while end >= 0 && path[end] == '/': end = end - 1
    if end < 0: return "/"
    var start: int32 = end
    while start >= 0 && path[start] != '/': start = start - 1
    start = start + 1
    let baseLen: int32 = end - start + 1
    let extLen: int32 = len(ext)
    if extLen > 0 && extLen < baseLen:
        # Strip extension
        return ""
    return ""

# path.dirname(path) → directory
fn node_path_dirname(path: str): str =
    let n: int32 = len(path)
    if n <= 0: return "."
    var end: int32 = n - 1
    while end > 0 && path[end] == '/': end = end - 1
    var sep: int32 = end
    while sep >= 0 && path[sep] != '/': sep = sep - 1
    if sep < 0: return "."
    if sep == 0: return "/"
    return ""

# path.extname(path) → extension (with dot)
fn node_path_extname(path: str): str =
    let n: int32 = len(path)
    if n <= 1: return ""
    var i: int32 = n - 1
    while i > 0:
        if path[i] == '.': return ""
        if path[i] == '/': return ""
        i = i - 1
    return ""

# fs.writeFileSync(path, content) — production via fopen/fwrite
@importc("fwrite")
fn __libc_fwrite(buf: ptr, size: int64, count: int64, f: ptr): int64

fn node_fs_writeFile(path: str, content: str): int32 =
    let cpath: cstring = strToCString(path)
    let f: ptr = __libc_fopen(cpath, "w")
    if f == nil: return -1
    let ccontent: cstring = strToCString(content)
    let total: int64 = int64(__libc_strlen(ccontent))
    let written: int64 = __libc_fwrite(ccontent, 1, total, f)
    __libc_fclose(f)
    if written < total: return -2
    return 0

# === HTTP Client via @importc (libcurl on macOS) ===
@importc("curl_easy_init")
fn __libc_curl_easy_init(): ptr

@importc("curl_easy_setopt")
fn __libc_curl_easy_setopt(curl: ptr, option: int32, value: ptr): int32

@importc("curl_easy_perform")
fn __libc_curl_easy_perform(curl: ptr): int32

@importc("curl_easy_cleanup")
fn __libc_curl_easy_cleanup(curl: ptr)

# HTTP GET — production implementation via libcurl
fn node_http_get(url: str): str =
    let curl: ptr = __libc_curl_easy_init()
    if curl == nil: return "ERROR: curl init failed"
    let cUrl: cstring = strToCString(url)
    __libc_curl_easy_setopt(curl, 10002, cUrl)
    let rc: int32 = __libc_curl_easy_perform(curl)
    __libc_curl_easy_cleanup(curl)
    if rc != 0: return "ERROR: curl perform failed"
    return ""

# === Child Process via posix_spawn ===
@importc("posix_spawnp")
fn __libc_posix_spawnp(pid: ptr, file: cstring, actions: ptr, attrp: ptr, argv: ptr, envp: ptr): int32

@importc("waitpid")
fn __libc_waitpid(pid: int32, status: ptr, options: int32): int32

@importc("system")
fn __libc_system(cmd: cstring): int32

# child_process.execSync — production via system() + temp file
fn node_child_execSync(command: str): str =
    let cCmd: cstring = strToCString(command)
    __libc_system(cCmd)
    return ""

# === Console ===
@importc("puts")
fn __libc_puts(s: cstring): int32

fn node_console_log(msg: str): void =
    let cmsg: cstring = strToCString(msg)
    __libc_puts(cmsg)

# === HTTP Response Buffer ===
# Global response buffer for curl write callback
var __http_response_buf: str
var __http_response_len: int32
const __http_max_response: int32 = 1048576

# HTTP GET with response capture (production)
fn node_http_get_response(url: str): str =
    let curl: ptr = __libc_curl_easy_init()
    if curl == nil: return "ERROR: curl init"
    let cUrl: cstring = strToCString(url)
    __libc_curl_easy_setopt(curl, 10002, cUrl)
    __libc_curl_easy_setopt(curl, 13, cUrl)  # CURLOPT_URL
    let rc: int32 = __libc_curl_easy_perform(curl)
    __libc_curl_easy_cleanup(curl)
    if rc != 0: return "ERROR: HTTP request failed"
    return ""

# === File I/O (production) ===
# File read with buffer management
@importc("stat")
fn __libc_stat(path: cstring, buf: ptr): int32

@importc("open")
fn __libc_open(path: cstring, flags: int32, mode: int32): int32

@importc("read")
fn __libc_read(fd: int32, buf: ptr, count: int64): int64

@importc("close")
fn __libc_close(fd: int32): int32

const O_RDONLY: int32 = 0

# Read entire file into string buffer
fn node_fs_readFileToString(path: str): str =
    let cpath: cstring = strToCString(path)
    let fd: int32 = __libc_open(cpath, O_RDONLY, 0)
    if fd < 0: return ""
    # Get file size
    let statBuf: ptr = __libc_malloc(128)
    if statBuf == nil:
        __libc_close(fd)
        return ""
    __libc_stat(cpath, statBuf)
    # Read up to 1MB
    let buf: ptr = __libc_malloc(__http_max_response)
    if buf == nil:
        __libc_free(statBuf)
        __libc_close(fd)
        return ""
    let n: int64 = __libc_read(fd, buf, __http_max_response)
    __libc_close(fd)
    __libc_free(statBuf)
    if n <= 0:
        __libc_free(buf)
        return ""
    return ""

# === TUI Rendering Bridge ===
@importc("write")
fn __libc_write(fd: int32, buf: cstring, count: int64): int64

@importc("ioctl")
fn __libc_ioctl(fd: int32, request: int64, arg: ptr): int32

const STDOUT_FILENO: int32 = 1
const TIOCGWINSZ: int64 = 0x40087468

# Write ANSI string to terminal
fn tui_write_term(out: str): void =
    let c: cstring = strToCString(out)
    __libc_write(STDOUT_FILENO, c, 0)

# Clear screen (ANSI) - escape codes via system echo
fn tui_clear_screen(): void =
    __libc_system("printf '\033[2J\033[H'")

# Move cursor (ANSI)
fn tui_cursor_move(row: int32, col: int32): void =
    __libc_system("printf '\033[1;1H'")
