fn cheng_held_exec_parent_activate_capsule_owner_export(
        handle: int32,
        ownerClaimReceiptCid: str,
        providerRoleOwner: int32): ChengHeldExecParentPhaseResult =
    let roleRow = providerRoleOwner - 1
    if roleRow < 0 ||
       roleRow >= chengHeldExecCapsuleProviderRoleCount:
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrBundleUnavailable, handle)
