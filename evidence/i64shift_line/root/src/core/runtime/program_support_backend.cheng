fn cheng_allocation_ledger_participant_token_matches(
        row: int32,
        generation: int32,
        owner: int32): bool =
    return cheng_allocation_ledger_participant_row_valid(row) &&
        generation > 0 && owner > 0 &&
        cheng_allocation_ledger_participant_generation_load(row) ==
            generation &&
        cheng_allocation_ledger_participant_owner_load(row) == owner

fn cheng_allocation_ledger_participant_rotate_token_locked(
        row: int32,
        outGeneration: Int32Ptr,
        outOwner: Int32Ptr): bool =
    if outGeneration == nil || outOwner == nil:
        return false
    let generation =
        cheng_allocation_ledger_participant_generation_load(row)
    let owner = cheng_allocation_ledger_participant_owner_load(row)
    if generation <= 0 || generation >= int32(2147483647) ||
       owner <= 0 || owner >= int32(2147483647):
        return false
    let nextGeneration = generation + 1
    let nextOwner = owner + 1
    cheng_allocation_ledger_participant_generation_store(
        row, nextGeneration)
    cheng_allocation_ledger_participant_owner_store(row, nextOwner)
    *outGeneration = nextGeneration
    *outOwner = nextOwner
    return true

fn cheng_allocation_ledger_participant_owner_slot_locked(
        row: int32): ChengAllocationLedgerOwnerSlotPtr =
    if !cheng_allocation_ledger_participant_row_valid(row):
        return nil
    let slotIndex =
        cheng_allocation_ledger_participant_owner_slot_index_load(row)
    let slot = cheng_allocation_ledger_slot_at(slotIndex)
    if slot == nil || slot->active == 0 || slot->closed != 0 ||
       slot->slotIndex != slotIndex ||
       slot->capabilityGeneration !=
           cheng_allocation_ledger_participant_owner_slot_generation_load(row):
        return nil
    return slot

fn cheng_allocation_ledger_participant_active_locked():
        ChengAllocationLedgerOwnerSlotPtr =
    let row = cheng_allocation_ledger_participant_tls_row()
    if row < 0:
        return nil
    let threadId = uint64(cheng_pthread_self_runtime())
    if cheng_allocation_ledger_participant_state_load(row) !=
           chengAllocationLedgerParticipantClaimed ||
       cheng_allocation_ledger_participant_claimed_thread_load(row) !=
           threadId:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_authority_drift")
        return nil
    let slot =
        cheng_allocation_ledger_participant_owner_slot_locked(row)
    if slot == nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_authority_drift")
        return nil
    return slot

fn cheng_allocation_ledger_active_locked():
        ChengAllocationLedgerOwnerSlotPtr =
    let ownerSlot = cheng_allocation_ledger_owner_thread_active_locked()
    let participantSlot =
        cheng_allocation_ledger_participant_active_locked()
    if ownerSlot != nil && participantSlot != nil &&
       ownerSlot->slotIndex != participantSlot->slotIndex:
        cheng_allocation_ledger_abort(
            "allocation_ledger_owner_participant_domain_drift")
        return nil
    return ownerSlot != nil ? ownerSlot : participantSlot

fn cheng_allocation_ledger_participants_drained_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr): bool =
    if slot == nil:
        return false
    for row in 0..<chengAllocationLedgerParticipantRowCount:
        if cheng_allocation_ledger_participant_owner_slot_index_load(row) !=
               slot->slotIndex ||
           cheng_allocation_ledger_participant_owner_slot_generation_load(row) !=
               slot->capabilityGeneration:
            continue
        if cheng_allocation_ledger_participant_state_load(row) !=
               chengAllocationLedgerParticipantConsumed:
            return false
    return true

fn cheng_allocation_ledger_any_active_locked():
        ChengAllocationLedgerOwnerSlotPtr =
    for index in 0..<chengAllocationLedgerOwnerSlotCount:
        let slot = cheng_allocation_ledger_slot_at(index)
        if slot != nil && slot->active != 0 && slot->closed == 0:
            return slot
    return nil

fn cheng_allocation_ledger_active_owner_index_fast(): int32 =
    let controlRaw = cheng_allocation_ledger_control_plane_raw
    if controlRaw == uint64(0):
        return -1
    let control = ChengAllocationLedgerControlPlanePtr(ptr(controlRaw))
    return cheng_runtime_atomic_load_i32_intrinsic(
        ptr(&control->activeOwnerSlotIndex))

fn cheng_allocation_ledger_slab_heads_empty_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr): bool =
    if slot == nil:
        return false
    for classIndex in 0..<chengAllocationLedgerSlabSizeClassCount:
        if slot->availableSlabHeads[classIndex] != -1:
            return false
    return true

fn cheng_allocation_ledger_physical_drained_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr): bool =
    if slot == nil ||
       cheng_allocation_ledger_control_plane_raw == uint64(0) ||
       !cheng_allocation_ledger_slab_heads_empty_locked(slot):
        return false
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    var recordIndex = control->recordFreeHead
    for recordSeen in 0..<control->recordCount:
        if recordIndex < 0 || recordIndex >= control->recordCount:
            return false
        let record = &control->records[recordIndex]
        if record->recordIndex != recordIndex ||
           (record->state != chengAllocationLedgerRecordHeapFreed &&
            record->state != chengAllocationLedgerRecordMapUnmapped) ||
           record->liveHandleCount != uint64(0):
            return false
        recordIndex = record->nextFreeRecord
    if recordIndex != -1:
        return false
    for heapIndex in 0..<chengAllocationLedgerHeapIndexCount:
        let entry = &control->heapIndex[heapIndex]
        if entry->payloadRaw != uint64(0) ||
           entry->recordIndex != 0 || entry->reserved != 0 ||
           entry->allocationGeneration != uint64(0):
            return false
    var handleIndex = control->handleFreeHead
    for handleSeen in 0..<control->handleCount:
        if handleIndex < 0 || handleIndex >= control->handleCount:
            return false
        let handleSlot = &control->handles[handleIndex]
        if handleSlot->slotIndex != handleIndex ||
           handleSlot->state != chengAllocationLedgerHandleRetired ||
           handleSlot->ownerSlotIndex != -1 ||
           handleSlot->ownerSlotGeneration != uint64(0) ||
           handleSlot->payloadRaw != uint64(0) ||
           handleSlot->recordIndex != -1 ||
           handleSlot->recordGeneration != uint64(0) ||
           handleSlot->liveBorrowCount != uint64(0):
            return false
        handleIndex = handleSlot->nextFreeSlot
    if handleIndex != -1:
        return false
    var slabIndex = control->slabFreeHead
    for slabSeen in 0..<control->slabCount:
        if slabIndex < 0 || slabIndex >= control->slabCount:
            return false
        let slab = &control->slabs[slabIndex]
        if slab->slabIndex != slabIndex ||
           slab->state != chengAllocationLedgerSlabRetired ||
           slab->baseRaw != uint64(0) ||
           slab->backingBytes != uint64(0) ||
           slab->liveCount != 0 || slab->freeHeadBlock != -1 ||
           slab->availablePrev != -1 || slab->availableNext != -1 ||
           slab->onAvailableList != 0:
            return false
        slabIndex = slab->freeSlotNext
    return slabIndex == -1

fn cheng_allocation_ledger_forbid_untracked_provider(
        failure: ptr) =
    cheng_runtime_lock()
    let active = cheng_allocation_ledger_any_active_locked() != nil
    cheng_runtime_unlock()
    if active:
        cheng_allocation_ledger_abort(failure)

fn cheng_allocation_ledger_frame_put_u64(
        frame: var ChengAllocationLedgerFrame,
        offset: var int32,
        value: uint64): bool =
    if offset < 0 || offset > chengAllocationLedgerFrameBytes - 8:
        return false
    var byteIndex: int32
    while byteIndex < 8:
        *(UInt8Ptr(cheng_ptr_plus(ptr(&frame), offset + byteIndex))) =
            uint8((value >> uint64(byteIndex * 8)) & uint64(255))
        byteIndex = byteIndex + 1
    offset = offset + 8
    return true

fn cheng_allocation_ledger_frame_put_bytes(
        frame: var ChengAllocationLedgerFrame,
        offset: var int32,
        source: ptr,
        length: int32): bool =
    if length < 0 || offset < 0 ||
       offset > chengAllocationLedgerFrameBytes - length ||
       (length > 0 && source == nil):
        return false
    if length > 0:
        cheng_bytes_copy(cheng_ptr_plus(ptr(&frame), offset), source, length)
    offset = offset + length
    return true

fn cheng_allocation_ledger_frame_put_digest(
        frame: var ChengAllocationLedgerFrame,
        offset: var int32,
        digest: ChengFixedBytes32): bool =
    if offset < 0 || offset > chengAllocationLedgerFrameBytes - 32:
        return false
    var digestCopy = digest
    cheng_bytes_copy(
        cheng_ptr_plus(ptr(&frame), offset), ptr(&digestCopy), 32)
    offset = offset + 32
    return true

fn cheng_allocation_ledger_record_event_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        allocationId: uint64,
        ownerGeneration: uint64,
        operation: int32,
        requestedPayloadBytes: uint64,
        usablePayloadBytes: uint64,
        headerBytes: uint64,
        backingBytes: uint64,
        alignmentBytes: uint64,
        relatedAllocationId: uint64,
        targetGeneration: uint64) =
    if slot == nil || slot->eventIndex == cheng_allocation_ledger_u64_max():
        cheng_allocation_ledger_abort(
            "allocation_ledger_event_index_overflow")
        return
    var frame: ChengAllocationLedgerFrame
    var offset: int32
    let domain: ptr = "cheng.runtime.allocation_ledger.event"
    let domainLength = cheng_cstrlen_raw(domain)
    let nextEventIndex = slot->eventIndex + uint64(1)
    var valid =
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(domainLength)) &&
        cheng_allocation_ledger_frame_put_bytes(
            frame, offset, domain, domainLength) &&
        cheng_allocation_ledger_frame_put_digest(
            frame, offset, slot->ownerDomainDigest) &&
        cheng_allocation_ledger_frame_put_digest(
            frame, offset, slot->allocatorLayoutDigest) &&
        cheng_allocation_ledger_frame_put_digest(
            frame, offset, slot->eventChainDigest) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->capabilityGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->backingLimit) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->controlPlaneBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, nextEventIndex) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, allocationId) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, ownerGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(operation)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, requestedPayloadBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, usablePayloadBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, headerBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, backingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, alignmentBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->liveBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->peakBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->liveMappedVirtualBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->peakMappedVirtualBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->liveAllocationCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->peakAllocationCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->liveMappingCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(slot->lastStorageKind)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->lastAllocationGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->lastSlabId) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->lastSlabGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->lastSlabBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->lastBackingDeltaBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, slot->lastReallocOverlapUsableBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, relatedAllocationId) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, targetGeneration)
    var digest: ChengFixedBytes32
    valid = valid && cheng_allocation_ledger_sha256_noalloc(
        &frame.data[0], offset, &digest.data[0])
    if !valid:
        cheng_allocation_ledger_abort(
            "allocation_ledger_event_transcript_overflow")
        return
    slot->eventIndex = nextEventIndex
    slot->eventChainDigest = digest
    slot->lastAllocationId = allocationId
    slot->lastOwnerGeneration = ownerGeneration
    slot->lastOperation = operation
    slot->lastRequestedPayloadBytes = requestedPayloadBytes
    slot->lastUsablePayloadBytes = usablePayloadBytes
    slot->lastHeaderBytes = headerBytes
    slot->lastBackingBytes = backingBytes
    slot->lastAlignmentBytes = alignmentBytes

fn cheng_allocation_ledger_record_for_header_locked(
        payload: ptr,
        header: ChengMemHeaderPtr): ChengAllocationLedgerRecordPtr =
    if payload == nil || header == nil ||
       !cheng_mem_header_is_ledger(header):
        return nil
    let headerBytes =
        int32(sizeof(ChengAllocationLedgerPrefix)) +
        int32(sizeof(ChengMemHeader))
    let raw = cheng_ptr_plus(payload, 0 - headerBytes)
    let prefix = ChengAllocationLedgerPrefixPtr(raw)
    if prefix == nil ||
       prefix->magic != chengAllocationLedgerPrefixMagic:
        cheng_allocation_ledger_abort(
            "allocation_ledger_prefix_magic_mismatch")
        return nil
    let record = cheng_allocation_ledger_record_at(prefix->recordIndex)
    if record == nil || record->payloadRaw != uint64(payload) ||
       record->mapBaseRaw != uint64(raw) ||
       record->allocationGeneration !=
           prefix->allocationGeneration:
        cheng_allocation_ledger_abort(
            "allocation_ledger_record_identity_mismatch")
        return nil
    return record

fn cheng_allocation_ledger_heap_index_start(payload: ptr): int32 =
    if payload == nil:
        return -1
    let mask = uint64(chengAllocationLedgerHeapIndexCount - 1)
    return int32(cheng_mem_registry_hash(payload) & mask)

fn cheng_allocation_ledger_heap_index_lookup_locked(
        payload: ptr): ChengAllocationLedgerRecordPtr =
    if payload == nil ||
       cheng_allocation_ledger_control_plane_raw == uint64(0):
        return nil
    let start = cheng_allocation_ledger_heap_index_start(payload)
    if start < 0:
        return nil
    let payloadRaw = uint64(payload)
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    var index = start
    for step in 0..<chengAllocationLedgerHeapIndexCount:
        let entry = &control->heapIndex[index]
        if entry->payloadRaw == uint64(0):
            return nil
        if entry->payloadRaw == payloadRaw:
            let record = cheng_allocation_ledger_record_at(
                entry->recordIndex)
            if record == nil || record->allocationGeneration !=
               entry->allocationGeneration:
                cheng_allocation_ledger_abort(
                    "allocation_ledger_heap_index_generation_mismatch")
                return nil
            return record
        index = index + 1
        if index >= chengAllocationLedgerHeapIndexCount:
            index = 0
    return nil

fn cheng_allocation_ledger_heap_index_insert_locked(
        payload: ptr,
        recordIndex: int32): bool =
    if payload == nil || recordIndex < 0 ||
       cheng_allocation_ledger_control_plane_raw == uint64(0):
        return false
    let start = cheng_allocation_ledger_heap_index_start(payload)
    if start < 0:
        return false
    let payloadRaw = uint64(payload)
    let nextRecord = cheng_allocation_ledger_record_at(recordIndex)
    if nextRecord == nil ||
       nextRecord->state != chengAllocationLedgerRecordHeapLive:
        return false
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    var index = start
    for step in 0..<chengAllocationLedgerHeapIndexCount:
        let entry = &control->heapIndex[index]
        if entry->payloadRaw == uint64(0):
            entry->payloadRaw = payloadRaw
            entry->recordIndex = recordIndex
            entry->reserved = 0
            entry->allocationGeneration =
                nextRecord->allocationGeneration
            return true
        if entry->payloadRaw == payloadRaw:
            return false
        index = index + 1
        if index >= chengAllocationLedgerHeapIndexCount:
            index = 0
    return false

fn cheng_allocation_ledger_heap_index_remove_locked(
        payload: ptr,
        recordIndex: int32,
        allocationGeneration: uint64): bool =
    if payload == nil || recordIndex < 0 ||
       allocationGeneration == uint64(0) ||
       cheng_allocation_ledger_control_plane_raw == uint64(0):
        return false
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    var index = cheng_allocation_ledger_heap_index_start(payload)
    if index < 0:
        return false
    var found = false
    for step in 0..<chengAllocationLedgerHeapIndexCount:
        let entry = &control->heapIndex[index]
        if entry->payloadRaw == uint64(0):
            return false
        if entry->payloadRaw == uint64(payload) &&
           entry->recordIndex == recordIndex &&
           entry->allocationGeneration == allocationGeneration:
            entry->payloadRaw = uint64(0)
            entry->recordIndex = 0
            entry->reserved = 0
            entry->allocationGeneration = uint64(0)
            found = true
            break
        index = index + 1
        if index >= chengAllocationLedgerHeapIndexCount:
            index = 0
    if !found:
        return false
    index = index + 1
    if index >= chengAllocationLedgerHeapIndexCount:
        index = 0
    for step in 0..<chengAllocationLedgerHeapIndexCount:
        let entry = &control->heapIndex[index]
        if entry->payloadRaw == uint64(0):
            return true
        let displacedPayload = ptr(entry->payloadRaw)
        let displacedRecordIndex = entry->recordIndex
        let displacedGeneration = entry->allocationGeneration
        entry->payloadRaw = uint64(0)
        entry->recordIndex = 0
        entry->reserved = 0
        entry->allocationGeneration = uint64(0)
        if !cheng_allocation_ledger_heap_index_insert_locked(
               displacedPayload, displacedRecordIndex):
            cheng_allocation_ledger_abort(
                "allocation_ledger_heap_index_cluster_reinsert_failed")
            return false
        let displaced = cheng_allocation_ledger_record_at(
            displacedRecordIndex)
        if displaced == nil ||
           displaced->allocationGeneration != displacedGeneration:
            cheng_allocation_ledger_abort(
                "allocation_ledger_heap_index_cluster_generation_drift")
            return false
        index = index + 1
        if index >= chengAllocationLedgerHeapIndexCount:
            index = 0
    return false

fn cheng_allocation_ledger_live_record_for_payload_locked(
        payload: ptr): ChengAllocationLedgerRecordPtr =
    let record =
        cheng_allocation_ledger_heap_index_lookup_locked(payload)
    if record != nil &&
       record->state == chengAllocationLedgerRecordHeapLive &&
       record->payloadRaw == uint64(payload):
        return record
    return nil

fn cheng_allocation_ledger_record_slot_locked(
        record: ChengAllocationLedgerRecordPtr):
        ChengAllocationLedgerOwnerSlotPtr =
    if record == nil:
        return nil
    let slot = cheng_allocation_ledger_slot_at(record->ownerSlotIndex)
    let currentSlot = cheng_allocation_ledger_active_locked()
    if slot == nil || slot->active == 0 || slot->closed != 0 ||
       slot->capabilityGeneration != record->ownerSlotGeneration ||
       currentSlot == nil || currentSlot->slotIndex != slot->slotIndex:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_generation_or_thread_access")
        return nil
    return slot

fn cheng_managed_payload_provenance_locked(payload: ptr): int32 =
    if payload == nil:
        return chengManagedProvenanceNone
    let processOwner = cheng_allocation_ledger_any_active_locked()
    if processOwner != nil:
        let record =
            cheng_allocation_ledger_live_record_for_payload_locked(payload)
        let slot = cheng_allocation_ledger_record_slot_locked(record)
        if record == nil || slot == nil ||
           record->ownerSlotIndex != processOwner->slotIndex ||
           record->ownerSlotGeneration !=
               processOwner->capabilityGeneration:
            return chengManagedProvenanceNone
        return chengManagedProvenanceLedger
    if cheng_mem_registry_contains(payload):
        return chengManagedProvenanceOrdinary
    return chengManagedProvenanceNone

fn cheng_managed_payload_provenance(payload: ptr): int32 =
    cheng_runtime_lock()
    let provenance = cheng_managed_payload_provenance_locked(payload)
    cheng_runtime_unlock()
    return provenance

fn cheng_allocation_ledger_record_reference_event_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        record: ChengAllocationLedgerRecordPtr,
        operation: int32) =
    if slot == nil || record == nil ||
       record->state != chengAllocationLedgerRecordHeapLive ||
       (operation != chengAllocationLedgerOperationRetain &&
        operation != chengAllocationLedgerOperationRelease):
        cheng_allocation_ledger_abort(
            "allocation_ledger_reference_event_invalid")
        return
    slot->lastStorageKind = record->storageKind
    slot->lastAllocationGeneration = record->allocationGeneration
    slot->lastSlabId = record->slabId
    slot->lastSlabGeneration = record->slabGeneration
    slot->lastSlabBackingBytes = record->slabBackingBytes
    slot->lastBackingDeltaBytes = uint64(0)
    slot->lastReallocOverlapUsableBytes = uint64(0)
    cheng_allocation_ledger_record_event_locked(
        slot,
        record->allocationId,
        record->ownerGeneration,
        operation,
        record->requestedPayloadBytes,
        record->usablePayloadBytes,
        record->headerBytes,
        record->backingBytes,
        record->alignmentBytes,
        uint64(0),
        uint64(0))

fn cheng_allocation_ledger_record_handle_event_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        record: ChengAllocationLedgerRecordPtr,
        handleSlot: ChengAllocationLedgerFfiHandleSlotPtr,
        operation: int32) =
    if slot == nil || record == nil || handleSlot == nil ||
       record->state != chengAllocationLedgerRecordHeapLive ||
       handleSlot->state != chengAllocationLedgerHandleLive ||
       handleSlot->ownerSlotIndex != slot->slotIndex ||
       handleSlot->ownerSlotGeneration != slot->capabilityGeneration ||
       handleSlot->recordIndex != record->recordIndex ||
       handleSlot->recordGeneration != record->allocationGeneration ||
       handleSlot->payloadRaw != record->payloadRaw ||
       slot->liveHandleCount > uint64(0xffffffff) ||
       record->liveHandleCount > uint64(0xffffffff) ||
       (operation != chengAllocationLedgerOperationHandleRegister &&
        operation != chengAllocationLedgerOperationHandleInvalidate):
        cheng_allocation_ledger_abort(
            "allocation_ledger_ffi_handle_event_invalid")
        return
    slot->lastStorageKind = record->storageKind
    slot->lastAllocationGeneration = record->allocationGeneration
    slot->lastSlabId = record->slabId
    slot->lastSlabGeneration = record->slabGeneration
    slot->lastSlabBackingBytes = record->slabBackingBytes
    slot->lastBackingDeltaBytes = uint64(0)
    slot->lastReallocOverlapUsableBytes = uint64(0)
    let encodedHandle =
        (uint64(handleSlot->generation) << uint64(32)) |
        chengFfiHandleLedgerDomainBit |
        uint64(handleSlot->slotIndex + 1)
    let postHandleCounts =
        (slot->liveHandleCount << uint64(32)) |
        record->liveHandleCount
    cheng_allocation_ledger_record_event_locked(
        slot,
        record->allocationId,
        record->ownerGeneration,
        operation,
        record->requestedPayloadBytes,
        record->usablePayloadBytes,
        record->headerBytes,
        record->backingBytes,
        record->alignmentBytes,
        encodedHandle,
        postHandleCounts)

fn cheng_allocation_ledger_map_failed(mapped: ptr): bool =
    var failed: int64
    failed = failed - int64(1)
    return mapped == nil || int64(uint64(mapped)) == failed

fn cheng_allocation_ledger_map_owned(backingBytes: uint64): ptr =
    if backingBytes == uint64(0) ||
       backingBytes > uint64(2147483647):
        return nil
    let anonymousFlag = cheng_host_is_darwin() ? 4096 : 32
    let mapped = libc_mmap_read_only_runtime(
        nil,
        int64(backingBytes),
        3,
        2 | anonymousFlag,
        -1,
        int64(0))
    if cheng_allocation_ledger_map_failed(mapped):
        return nil
    return mapped

fn cheng_allocation_ledger_control_plane_ensure_locked(
        outErr: ptr): bool =
    if cheng_allocation_ledger_control_plane_raw != uint64(0):
        if !cheng_allocation_ledger_control_plane_identity_valid():
            cheng_allocation_ledger_abort(
                "allocation_ledger_control_plane_identity_drift")
            return false
        return true
    let pageSize = cheng_allocation_ledger_page_size()
    let backingBytes =
        cheng_allocation_ledger_control_plane_backing_bytes()
    if pageSize == uint64(0) || backingBytes == uint64(0):
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_control_plane_layout_invalid")
        return false
    let mapped = cheng_allocation_ledger_map_owned(backingBytes)
    if mapped == nil:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_control_plane_map_failed")
        return false
    # Anonymous mappings are kernel-zeroed and demand-paged. Initialize only
    # the header so begin does not fault the complete record capacity into RSS.
    let control = ChengAllocationLedgerControlPlanePtr(mapped)
    control->magic = chengAllocationLedgerControlPlaneMagic
    control->recordCount = 0
    control->recordFreeHead = -1
    control->activeOwnerSlotIndex = -1
    control->slabCount = 0
    control->slabFreeHead = -1
    control->handleCount = 0
    control->handleFreeHead = -1
    control->nextSlabId = uint64(0)
    control->objectBytes =
        uint64(sizeof(ChengAllocationLedgerControlPlane))
    control->backingBytes = backingBytes
    control->pageSize = pageSize
    control->reserved = uint64(0)
    cheng_allocation_ledger_control_plane_raw = uint64(mapped)
    if !cheng_allocation_ledger_control_plane_identity_valid():
        cheng_allocation_ledger_abort(
            "allocation_ledger_control_plane_publish_failed")
        return false
    return true

fn cheng_allocation_ledger_slab_class(
        totalBytes: uint64,
        outStride: Int32Ptr): int32 =
    if outStride == nil || totalBytes == uint64(0) ||
       totalBytes > uint64(chengAllocationLedgerSlabMaxStride):
        return -1
    var classIndex: int32
    var stride: int32 = 64
    while uint64(stride) < totalBytes &&
          classIndex < chengAllocationLedgerSlabSizeClassCount:
        stride = stride * 2
        classIndex = classIndex + 1
    if classIndex >= chengAllocationLedgerSlabSizeClassCount ||
       stride > chengAllocationLedgerSlabMaxStride:
        return -1
    *outStride = stride
    return classIndex

fn cheng_allocation_ledger_available_head_set(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        classIndex: int32,
        value: int32) =
    if slot == nil || classIndex < 0 ||
       classIndex >= chengAllocationLedgerSlabSizeClassCount:
        cheng_allocation_ledger_abort(
            "allocation_ledger_available_head_set_invalid")
        return
    *(Int32Ptr(cheng_ptr_plus(
        ptr(&slot->availableSlabHeads), classIndex * 4))) = value

fn cheng_allocation_ledger_slab_available_remove_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        slab: ChengAllocationLedgerSlabPtr) =
    if slot == nil || slab == nil || slab->classIndex < 0 ||
       slab->classIndex >= chengAllocationLedgerSlabSizeClassCount ||
       slab->onAvailableList != 1:
        cheng_allocation_ledger_abort(
            "allocation_ledger_slab_available_remove_invalid")
        return
    if slab->availablePrev >= 0:
        let previous = cheng_allocation_ledger_slab_at(
            slab->availablePrev)
        if previous == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_available_prev_invalid")
            return
        previous->availableNext = slab->availableNext
    else:
        if slot->availableSlabHeads[slab->classIndex] !=
           slab->slabIndex:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_available_head_identity_invalid")
            return
        cheng_allocation_ledger_available_head_set(
            slot, slab->classIndex, slab->availableNext)
    if slab->availableNext >= 0:
        let next = cheng_allocation_ledger_slab_at(
            slab->availableNext)
        if next == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_available_next_invalid")
            return
        next->availablePrev = slab->availablePrev
    slab->availablePrev = -1
    slab->availableNext = -1
    slab->onAvailableList = 0

fn cheng_allocation_ledger_slab_available_push_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        slabIndex: int32,
        slab: ChengAllocationLedgerSlabPtr) =
    if slot == nil || slab == nil || slabIndex < 0 ||
       slab->classIndex < 0 ||
       slab->classIndex >= chengAllocationLedgerSlabSizeClassCount ||
       slab->availablePrev >= 0 || slab->availableNext >= 0 ||
       slab->onAvailableList != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_slab_available_push_invalid")
        return
    let oldHead = slot->availableSlabHeads[slab->classIndex]
    slab->availablePrev = -1
    slab->availableNext = oldHead
    if oldHead >= 0:
        let previousHead = cheng_allocation_ledger_slab_at(oldHead)
        if previousHead == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_available_head_invalid")
            return
        previousHead->availablePrev = slabIndex
    cheng_allocation_ledger_available_head_set(
        slot, slab->classIndex, slabIndex)
    slab->onAvailableList = 1

fn cheng_allocation_ledger_slab_create_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        classIndex: int32,
        blockStride: int32,
        outBackingDelta: UInt64Ptr): ChengAllocationLedgerSlabPtr =
    if slot == nil || outBackingDelta == nil || classIndex < 0 ||
       classIndex >= chengAllocationLedgerSlabSizeClassCount ||
       blockStride <= 0 ||
       chengAllocationLedgerSlabMaxStride % blockStride != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_slab_create_invalid")
        return nil
    *outBackingDelta = uint64(0)
    let slabBackingBytes =
        cheng_allocation_ledger_slab_backing_bytes()
    var nextBacking: uint64
    if slabBackingBytes == uint64(0) ||
       !cheng_allocation_ledger_checked_add(
           slot->liveBackingBytes,
           slabBackingBytes,
           &nextBacking) || nextBacking > slot->backingLimit:
        cheng_allocation_ledger_abort(
            "allocation_ledger_backing_limit_exceeded")
        return nil
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    var slabIndex: int32
    var nextSlabGeneration: uint64 = uint64(1)
    if control->slabFreeHead >= 0:
        slabIndex = control->slabFreeHead
        let reusable = cheng_allocation_ledger_slab_at(slabIndex)
        if reusable == nil ||
           reusable->state != chengAllocationLedgerSlabRetired ||
           reusable->slabGeneration == cheng_allocation_ledger_u64_max():
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_free_list_invalid")
            return nil
        nextSlabGeneration = reusable->slabGeneration + uint64(1)
    else:
        if control->slabCount >= chengAllocationLedgerSlabCount:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_capacity_exhausted")
            return nil
        slabIndex = control->slabCount
    if control->nextSlabId == cheng_allocation_ledger_u64_max():
        cheng_allocation_ledger_abort(
            "allocation_ledger_slab_id_overflow")
        return nil
    let mapped = cheng_allocation_ledger_map_owned(
        slabBackingBytes)
    if mapped == nil:
        return nil
    if control->slabFreeHead >= 0:
        let reusable = cheng_allocation_ledger_slab_at(slabIndex)
        control->slabFreeHead = reusable->freeSlotNext
    else:
        control->slabCount = control->slabCount + 1
    control->nextSlabId = control->nextSlabId + uint64(1)
    let slab = cheng_allocation_ledger_slab_at(slabIndex)
    slab->state = chengAllocationLedgerSlabLive
    slab->slabIndex = slabIndex
    slab->classIndex = classIndex
    slab->ownerSlotIndex = slot->slotIndex
    slab->blockStride = blockStride
    slab->ownerSlotGeneration = slot->capabilityGeneration
    slab->slabId = control->nextSlabId
    slab->slabGeneration = nextSlabGeneration
    slab->baseRaw = uint64(mapped)
    slab->backingBytes = slabBackingBytes
    slab->blockCount = int32(
        slabBackingBytes / uint64(blockStride))
    slab->liveCount = 0
    slab->nextUnusedBlock = 0
    slab->freeHeadBlock = -1
    slab->availablePrev = -1
    slab->availableNext = -1
    slab->freeSlotNext = -1
    slab->onAvailableList = 0
    cheng_allocation_ledger_slab_available_push_locked(
        slot, slabIndex, slab)
    slot->liveBackingBytes = nextBacking
    if nextBacking > slot->peakBackingBytes:
        slot->peakBackingBytes = nextBacking
    *outBackingDelta = slabBackingBytes
    return slab

fn cheng_allocation_ledger_allocate_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        size0: int32): ptr =
    if slot == nil || slot->active == 0 || slot->closed != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_allocate_without_owner")
        return nil
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    if control == nil ||
       (control->recordFreeHead < 0 &&
        control->recordCount >= chengAllocationLedgerRecordCount):
        cheng_allocation_ledger_abort(
            "allocation_ledger_peak_live_record_capacity_exhausted")
        return nil
    var size = size0
    if size <= 0:
        size = 1
    if size > chengAllocationLedgerMaxPayloadBytes ||
       slot->liveAllocationCount == cheng_allocation_ledger_u64_max() ||
       slot->nextAllocationId == cheng_allocation_ledger_u64_max():
        cheng_allocation_ledger_abort(
            "allocation_ledger_allocation_capacity_exhausted")
        return nil
    let pageSize = cheng_allocation_ledger_page_size()
    let headerBytes =
        uint64(sizeof(ChengAllocationLedgerPrefix)) +
        uint64(sizeof(ChengMemHeader))
    if pageSize == uint64(0) ||
       headerBytes % uint64(chengAllocationLedgerPayloadAlignment) !=
           uint64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_header_alignment_mismatch")
        return nil
    var totalBytes: uint64
    if !cheng_allocation_ledger_checked_add(
           headerBytes, uint64(size), &totalBytes):
        cheng_allocation_ledger_abort(
            "allocation_ledger_backing_size_overflow")
        return nil
    var blockStride: int32
    let classIndex = cheng_allocation_ledger_slab_class(
        totalBytes, &blockStride)
    var raw: ptr
    var payload: ptr
    var storageKind: int32
    var slabIndex: int32 = -1
    var blockIndex: int32 = -1
    var slabId: uint64
    var slabGeneration: uint64
    var slabBackingBytes: uint64
    var backingBytes: uint64
    var backingDeltaBytes: uint64
    var usablePayloadBytes: uint64
    if classIndex >= 0:
        storageKind = chengAllocationLedgerStorageSlab
        slabIndex = slot->availableSlabHeads[classIndex]
        var slab = cheng_allocation_ledger_slab_at(slabIndex)
        if slab == nil:
            slab = cheng_allocation_ledger_slab_create_locked(
                slot, classIndex, blockStride, &backingDeltaBytes)
            slabIndex = slot->availableSlabHeads[classIndex]
        if slab == nil || slabIndex < 0 ||
           slab->state != chengAllocationLedgerSlabLive ||
           slab->ownerSlotIndex != slot->slotIndex ||
           slab->ownerSlotGeneration != slot->capabilityGeneration ||
           slab->classIndex != classIndex ||
           slab->blockStride != blockStride:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_identity_invalid")
            return nil
        if slab->freeHeadBlock >= 0:
            blockIndex = slab->freeHeadBlock
            let freeRaw = cheng_ptr_plus(
                ptr(slab->baseRaw), blockIndex * blockStride)
            let freePrefix = ChengAllocationLedgerPrefixPtr(freeRaw)
            slab->freeHeadBlock = freePrefix->nextFreeBlock
        else:
            blockIndex = slab->nextUnusedBlock
            slab->nextUnusedBlock = slab->nextUnusedBlock + 1
        if blockIndex < 0 || blockIndex >= slab->blockCount:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_block_index_invalid")
            return nil
        raw = cheng_ptr_plus(
            ptr(slab->baseRaw), blockIndex * blockStride)
        slab->liveCount = slab->liveCount + 1
        if slab->liveCount >= slab->blockCount:
            cheng_allocation_ledger_slab_available_remove_locked(
                slot, slab)
        slabId = slab->slabId
        slabGeneration = slab->slabGeneration
        slabBackingBytes = slab->backingBytes
        usablePayloadBytes = uint64(blockStride) - headerBytes
    else:
        storageKind = chengAllocationLedgerStorageLargeMap
        if !cheng_allocation_ledger_align_up(
               totalBytes, pageSize, &backingBytes):
            cheng_allocation_ledger_abort(
                "allocation_ledger_backing_size_overflow")
            return nil
        var nextBacking: uint64
        if !cheng_allocation_ledger_checked_add(
               slot->liveBackingBytes,
               backingBytes,
               &nextBacking) || nextBacking > slot->backingLimit:
            cheng_allocation_ledger_abort(
                "allocation_ledger_backing_limit_exceeded")
            return nil
        raw = cheng_allocation_ledger_map_owned(backingBytes)
        if raw == nil:
            return nil
        slot->liveBackingBytes = nextBacking
        if nextBacking > slot->peakBackingBytes:
            slot->peakBackingBytes = nextBacking
        backingDeltaBytes = backingBytes
        usablePayloadBytes = backingBytes - headerBytes
    payload = cheng_ptr_plus(raw, int32(headerBytes))
    if cheng_mem_registry_cached_payload_raw == uint64(payload):
        cheng_mem_registry_cached_payload_raw = uint64(0)
        cheng_mem_registry_cached_header_raw = uint64(0)
    let header = ChengMemHeaderPtr(
        cheng_ptr_plus(payload, 0 - int32(sizeof(ChengMemHeader))))
    cheng_mem_header_rc_set(header, 1)
    cheng_mem_header_size_set_ledger(header, size)
    var allocationGeneration: uint64
    let recordIndex = cheng_allocation_ledger_record_acquire_locked(
        &allocationGeneration)
    if recordIndex < 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_peak_live_record_capacity_exhausted")
        return nil
    slot->nextAllocationId = slot->nextAllocationId + uint64(1)
    let prefix = ChengAllocationLedgerPrefixPtr(raw)
    prefix->magic = chengAllocationLedgerPrefixMagic
    prefix->recordIndex = recordIndex
    prefix->allocationGeneration = allocationGeneration
    prefix->nextFreeBlock = -1
    prefix->reserved = 0
    let record = &control->records[recordIndex]
    record->state = chengAllocationLedgerRecordHeapLive
    record->kind = chengAllocationLedgerOperationMalloc
    record->storageKind = storageKind
    record->ownerSlotIndex = slot->slotIndex
    record->slabIndex = slabIndex
    record->blockIndex = blockIndex
    record->ownerSlotGeneration = slot->capabilityGeneration
    record->allocationId = slot->nextAllocationId
    record->ownerGeneration = slot->capabilityGeneration
    record->allocationGeneration = allocationGeneration
    record->slabId = slabId
    record->slabGeneration = slabGeneration
    record->payloadRaw = uint64(payload)
    record->mapBaseRaw = uint64(raw)
    record->requestedPayloadBytes = uint64(size)
    record->usablePayloadBytes = usablePayloadBytes
    record->headerBytes = headerBytes
    record->backingBytes = backingBytes
    record->slabBackingBytes = slabBackingBytes
    record->alignmentBytes =
        uint64(chengAllocationLedgerPayloadAlignment)
    record->mappedVirtualBytes = uint64(0)
    record->liveHandleCount = uint64(0)
    if !cheng_allocation_ledger_heap_index_insert_locked(
            payload, recordIndex):
        cheng_allocation_ledger_abort(
            "allocation_ledger_heap_index_insert_failed")
        return nil
    slot->liveAllocationCount = slot->liveAllocationCount + uint64(1)
    if slot->liveAllocationCount > slot->peakAllocationCount:
        slot->peakAllocationCount = slot->liveAllocationCount
    cheng_bytes_set(payload, 0, size)
    slot->lastStorageKind = storageKind
    slot->lastAllocationGeneration = record->allocationGeneration
    slot->lastSlabId = slabId
    slot->lastSlabGeneration = slabGeneration
    slot->lastSlabBackingBytes = slabBackingBytes
    slot->lastBackingDeltaBytes = backingDeltaBytes
    slot->lastReallocOverlapUsableBytes = uint64(0)
    cheng_allocation_ledger_record_event_locked(
        slot,
        record->allocationId,
        record->ownerGeneration,
        chengAllocationLedgerOperationMalloc,
        record->requestedPayloadBytes,
        record->usablePayloadBytes,
        record->headerBytes,
        record->backingBytes,
        record->alignmentBytes,
        uint64(0),
        uint64(0))
    return payload

fn cheng_allocation_ledger_release_locked(
        payload: ptr,
        header: ChengMemHeaderPtr) =
    let record =
        cheng_allocation_ledger_record_for_header_locked(payload, header)
    if record == nil || record->state != chengAllocationLedgerRecordHeapLive:
        cheng_allocation_ledger_abort(
            "allocation_ledger_duplicate_or_invalid_free")
        return
    if record->liveHandleCount != uint64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_free_with_live_handle")
        return
    let slot = cheng_allocation_ledger_record_slot_locked(record)
    if slot == nil || slot->liveAllocationCount == uint64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_live_backing_underflow")
        return
    var backingDeltaBytes: uint64
    if record->storageKind == chengAllocationLedgerStorageSlab:
        let slab = cheng_allocation_ledger_slab_at(record->slabIndex)
        if slab == nil || slab->state != chengAllocationLedgerSlabLive ||
           slab->slabId != record->slabId ||
           slab->slabGeneration != record->slabGeneration ||
           slab->ownerSlotIndex != slot->slotIndex ||
           slab->ownerSlotGeneration != slot->capabilityGeneration ||
           slab->liveCount <= 0:
            cheng_allocation_ledger_abort(
                "allocation_ledger_slab_release_identity_invalid")
            return
        let wasFull = slab->liveCount == slab->blockCount
        slab->liveCount = slab->liveCount - 1
        let prefix = ChengAllocationLedgerPrefixPtr(record->mapBaseRaw)
        prefix->nextFreeBlock = slab->freeHeadBlock
        slab->freeHeadBlock = record->blockIndex
        if slab->liveCount == 0:
            if !wasFull:
                cheng_allocation_ledger_slab_available_remove_locked(
                    slot, slab)
            if slot->liveBackingBytes < slab->backingBytes ||
               c_munmap(ptr(slab->baseRaw),
                        int64(slab->backingBytes)) != 0:
                cheng_allocation_ledger_abort(
                    "allocation_ledger_slab_munmap_failed")
                return
            backingDeltaBytes = slab->backingBytes
            slot->liveBackingBytes =
                slot->liveBackingBytes - slab->backingBytes
            let control = ChengAllocationLedgerControlPlanePtr(
                ptr(cheng_allocation_ledger_control_plane_raw))
            slab->state = chengAllocationLedgerSlabRetired
            slab->baseRaw = uint64(0)
            slab->backingBytes = uint64(0)
            slab->nextUnusedBlock = 0
            slab->freeHeadBlock = -1
            slab->availablePrev = -1
            slab->availableNext = -1
            slab->onAvailableList = 0
            slab->freeSlotNext = control->slabFreeHead
            control->slabFreeHead = record->slabIndex
        elif wasFull:
            cheng_allocation_ledger_slab_available_push_locked(
                slot, record->slabIndex, slab)
    elif record->storageKind == chengAllocationLedgerStorageLargeMap:
        if record->backingBytes == uint64(0) ||
           slot->liveBackingBytes < record->backingBytes ||
           c_munmap(ptr(record->mapBaseRaw),
                    int64(record->backingBytes)) != 0:
            cheng_allocation_ledger_abort(
                "allocation_ledger_heap_munmap_failed")
            return
        backingDeltaBytes = record->backingBytes
        slot->liveBackingBytes =
            slot->liveBackingBytes - record->backingBytes
    else:
        cheng_allocation_ledger_abort(
            "allocation_ledger_heap_storage_kind_invalid")
        return
    slot->liveAllocationCount =
        slot->liveAllocationCount - uint64(1)
    slot->lastStorageKind = record->storageKind
    slot->lastAllocationGeneration = record->allocationGeneration
    slot->lastSlabId = record->slabId
    slot->lastSlabGeneration = record->slabGeneration
    slot->lastSlabBackingBytes = record->slabBackingBytes
    slot->lastBackingDeltaBytes = backingDeltaBytes
    slot->lastReallocOverlapUsableBytes = uint64(0)
    if !cheng_allocation_ledger_heap_index_remove_locked(
           payload, record->recordIndex,
           record->allocationGeneration):
        cheng_allocation_ledger_abort(
            "allocation_ledger_heap_index_remove_failed")
        return
    cheng_allocation_ledger_record_event_locked(
        slot,
        record->allocationId,
        record->ownerGeneration,
        chengAllocationLedgerOperationFree,
        record->requestedPayloadBytes,
        record->usablePayloadBytes,
        record->headerBytes,
        record->backingBytes,
        record->alignmentBytes,
        uint64(0),
        uint64(0))
    cheng_allocation_ledger_record_recycle_locked(
        record, chengAllocationLedgerRecordHeapFreed)

fn cheng_allocation_ledger_record_realloc_locked(
        oldRecordIndex: int32,
        oldAllocationGeneration: uint64,
        oldAllocationId: uint64,
        oldUsablePayloadBytes: uint64,
        nextPayload: ptr) =
    let nextHeader = cheng_mem_header(nextPayload)
    let nextRecord = cheng_allocation_ledger_record_for_header_locked(
        nextPayload, nextHeader)
    if nextRecord == nil ||
       nextRecord->state != chengAllocationLedgerRecordHeapLive:
        cheng_allocation_ledger_abort(
            "allocation_ledger_realloc_result_untracked")
        return
    let slot = cheng_allocation_ledger_record_slot_locked(nextRecord)
    let oldRecord = cheng_allocation_ledger_record_at(oldRecordIndex)
    var overlapUsableBytes: uint64
    if oldRecord == nil ||
       (oldRecord->state != chengAllocationLedgerRecordHeapFreed &&
        oldRecord->state != chengAllocationLedgerRecordHeapLive) ||
       oldRecord->allocationGeneration != oldAllocationGeneration ||
       oldRecord->allocationId != oldAllocationId ||
       oldRecord->usablePayloadBytes != oldUsablePayloadBytes ||
       !cheng_allocation_ledger_checked_add(
           oldUsablePayloadBytes,
           nextRecord->usablePayloadBytes,
           &overlapUsableBytes):
        cheng_allocation_ledger_abort(
            "allocation_ledger_realloc_overlap_invalid")
        return
    slot->lastStorageKind = nextRecord->storageKind
    slot->lastAllocationGeneration =
        nextRecord->allocationGeneration
    slot->lastSlabId = nextRecord->slabId
    slot->lastSlabGeneration = nextRecord->slabGeneration
    slot->lastSlabBackingBytes = nextRecord->slabBackingBytes
    slot->lastBackingDeltaBytes = uint64(0)
    slot->lastReallocOverlapUsableBytes = overlapUsableBytes
    cheng_allocation_ledger_record_event_locked(
        slot,
        nextRecord->allocationId,
        nextRecord->ownerGeneration,
        chengAllocationLedgerOperationRealloc,
        nextRecord->requestedPayloadBytes,
        nextRecord->usablePayloadBytes,
        nextRecord->headerBytes,
        nextRecord->backingBytes,
        nextRecord->alignmentBytes,
        oldAllocationId,
        uint64(0))

fn cheng_allocation_ledger_record_mapping_locked(
        mapBase: ptr,
        requestedBytes: int64,
        outRecordIndex: Int32Ptr,
        outRecordGeneration: UInt64Ptr): uint64 =
    if outRecordIndex == nil || outRecordGeneration == nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_mapping_identity_output_invalid")
        return uint64(0)
    *outRecordIndex = -1
    *outRecordGeneration = uint64(0)
    let slot = cheng_allocation_ledger_active_locked()
    if slot == nil:
        if cheng_allocation_ledger_any_active_locked() != nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_cross_thread_mapping")
        return uint64(0)
    if mapBase == nil || requestedBytes <= int64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_mapping_record_invalid")
        return uint64(0)
    let pageSize = cheng_allocation_ledger_page_size()
    var virtualBytes: uint64
    if pageSize == uint64(0) ||
       !cheng_allocation_ledger_align_up(
           uint64(requestedBytes), pageSize, &virtualBytes):
        cheng_allocation_ledger_abort(
            "allocation_ledger_mapping_size_overflow")
        return uint64(0)
    var nextMappedVirtualBytes: uint64
    if !cheng_allocation_ledger_checked_add(
           slot->liveMappedVirtualBytes,
           virtualBytes,
           &nextMappedVirtualBytes) ||
       slot->liveMappingCount == cheng_allocation_ledger_u64_max():
        cheng_allocation_ledger_abort(
            "allocation_ledger_mapping_counter_overflow")
        return uint64(0)
    if slot->nextAllocationId == cheng_allocation_ledger_u64_max():
        cheng_allocation_ledger_abort(
            "allocation_ledger_allocation_id_overflow")
        return uint64(0)
    slot->nextAllocationId = slot->nextAllocationId + uint64(1)
    var recordGeneration: uint64
    let recordIndex = cheng_allocation_ledger_record_acquire_locked(
        &recordGeneration)
    if recordIndex < 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_peak_live_record_capacity_exhausted")
        return uint64(0)
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    let record = &control->records[recordIndex]
    record->state = chengAllocationLedgerRecordMapLive
    record->kind = chengAllocationLedgerOperationMmap
    record->storageKind = chengAllocationLedgerStorageFileMap
    record->ownerSlotIndex = slot->slotIndex
    record->slabIndex = -1
    record->blockIndex = -1
    record->ownerSlotGeneration = slot->capabilityGeneration
    record->allocationId = slot->nextAllocationId
    record->ownerGeneration = slot->capabilityGeneration
    record->allocationGeneration = recordGeneration
    record->slabId = uint64(0)
    record->slabGeneration = uint64(0)
    record->payloadRaw = uint64(0)
    record->mapBaseRaw = uint64(mapBase)
    record->requestedPayloadBytes = uint64(requestedBytes)
    record->usablePayloadBytes = uint64(requestedBytes)
    record->headerBytes = uint64(0)
    record->backingBytes = uint64(0)
    record->slabBackingBytes = uint64(0)
    record->alignmentBytes = pageSize
    record->mappedVirtualBytes = virtualBytes
    record->liveHandleCount = uint64(0)
    slot->liveMappedVirtualBytes = nextMappedVirtualBytes
    if slot->liveMappedVirtualBytes > slot->peakMappedVirtualBytes:
        slot->peakMappedVirtualBytes = slot->liveMappedVirtualBytes
    slot->liveMappingCount = slot->liveMappingCount + uint64(1)
    slot->lastStorageKind = chengAllocationLedgerStorageFileMap
    slot->lastAllocationGeneration = record->allocationGeneration
    slot->lastSlabId = uint64(0)
    slot->lastSlabGeneration = uint64(0)
    slot->lastSlabBackingBytes = uint64(0)
    slot->lastBackingDeltaBytes = uint64(0)
    slot->lastReallocOverlapUsableBytes = uint64(0)
    cheng_allocation_ledger_record_event_locked(
        slot,
        record->allocationId,
        record->ownerGeneration,
        chengAllocationLedgerOperationMmap,
        record->requestedPayloadBytes,
        record->usablePayloadBytes,
        uint64(0),
        uint64(0),
        record->alignmentBytes,
        uint64(0),
        uint64(0))
    *outRecordIndex = recordIndex
    *outRecordGeneration = recordGeneration
    return record->allocationId

fn cheng_allocation_ledger_record_unmapping_locked(
        allocationId: uint64,
        ownerSlotGeneration: uint64,
        recordIndex: int32,
        recordGeneration: uint64) =
    if allocationId == uint64(0) && ownerSlotGeneration == uint64(0) &&
       recordIndex == -1 && recordGeneration == uint64(0):
        return
    let slot = cheng_allocation_ledger_active_locked()
    let record = cheng_allocation_ledger_record_at(recordIndex)
    if allocationId == uint64(0) || ownerSlotGeneration == uint64(0) ||
       recordIndex < 0 || recordGeneration == uint64(0) ||
       slot == nil || slot->capabilityGeneration != ownerSlotGeneration ||
       record == nil ||
       record->recordIndex != recordIndex ||
       record->allocationGeneration != recordGeneration ||
       record->ownerSlotIndex != slot->slotIndex ||
       record->ownerSlotGeneration != ownerSlotGeneration ||
       record->allocationId != allocationId ||
       record->state != chengAllocationLedgerRecordMapLive ||
       slot->liveMappingCount == uint64(0) ||
       slot->liveMappedVirtualBytes < record->mappedVirtualBytes:
        cheng_allocation_ledger_abort(
            "allocation_ledger_duplicate_or_cross_generation_munmap")
        return
    slot->liveMappedVirtualBytes =
        slot->liveMappedVirtualBytes - record->mappedVirtualBytes
    slot->liveMappingCount = slot->liveMappingCount - uint64(1)
    slot->lastStorageKind = chengAllocationLedgerStorageFileMap
    slot->lastAllocationGeneration = record->allocationGeneration
    slot->lastSlabId = uint64(0)
    slot->lastSlabGeneration = uint64(0)
    slot->lastSlabBackingBytes = uint64(0)
    slot->lastBackingDeltaBytes = uint64(0)
    slot->lastReallocOverlapUsableBytes = uint64(0)
    cheng_allocation_ledger_record_event_locked(
        slot,
        record->allocationId,
        record->ownerGeneration,
        chengAllocationLedgerOperationMunmap,
        record->requestedPayloadBytes,
        record->usablePayloadBytes,
        uint64(0),
        uint64(0),
        record->alignmentBytes,
        uint64(0),
        uint64(0))
    cheng_allocation_ledger_record_recycle_locked(
        record, chengAllocationLedgerRecordMapUnmapped)

fn cheng_allocation_ledger_record_unmapping_preflight_locked(
        mapBase: ptr,
        requestedBytes: int64,
        allocationId: uint64,
        ownerSlotGeneration: uint64,
        recordIndex: int32,
        recordGeneration: uint64): bool =
    if allocationId == uint64(0) &&
       ownerSlotGeneration == uint64(0) &&
       recordIndex == -1 && recordGeneration == uint64(0):
        if cheng_allocation_ledger_any_active_locked() != nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_untracked_munmap_during_owner")
            return false
        return true
    if mapBase == nil || requestedBytes <= int64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_munmap_physical_identity_invalid")
        return false
    let slot = cheng_allocation_ledger_active_locked()
    let record = cheng_allocation_ledger_record_at(recordIndex)
    let pageSize = cheng_allocation_ledger_page_size()
    var mappedVirtualBytes: uint64
    if pageSize == uint64(0) ||
       !cheng_allocation_ledger_align_up(
           uint64(requestedBytes), pageSize, &mappedVirtualBytes) ||
       allocationId == uint64(0) || ownerSlotGeneration == uint64(0) ||
       recordIndex < 0 || recordGeneration == uint64(0) ||
       slot == nil || slot->capabilityGeneration != ownerSlotGeneration ||
       record == nil || record->recordIndex != recordIndex ||
       record->allocationGeneration != recordGeneration ||
       record->ownerSlotIndex != slot->slotIndex ||
       record->ownerSlotGeneration != ownerSlotGeneration ||
       record->allocationId != allocationId ||
       record->state != chengAllocationLedgerRecordMapLive ||
       record->mapBaseRaw != uint64(mapBase) ||
       record->requestedPayloadBytes != uint64(requestedBytes) ||
       record->usablePayloadBytes != uint64(requestedBytes) ||
       record->mappedVirtualBytes != mappedVirtualBytes ||
       slot->liveMappingCount == uint64(0) ||
       slot->liveMappedVirtualBytes < mappedVirtualBytes:
        cheng_allocation_ledger_abort(
            "allocation_ledger_munmap_physical_identity_mismatch")
        return false
    return true

fn probe_slot_at(idx: int32): ChengFfiHandleSlotPtr =
    if probe_slots == nil || probe_slots_cap <= 0 ||
       probe_slots_len < 0 || probe_slots_len > probe_slots_cap ||
       idx < 0 || idx >= probe_slots_cap:
        return nil
    let stride = int64(sizeof(ChengFfiHandleSlot))
    let offset = int64(idx) * stride
    if stride <= int64(0) || offset < int64(0) ||
       offset > int64(2147483647):
        cheng_mem_registry_hard_fail(
            "ffi probe table: slot offset overflow")
        return nil
    return ChengFfiHandleSlotPtr(
        cheng_ptr_plus(ptr(probe_slots), int32(offset)))

fn probe_ensure_capacity(minCap: int32): bool =
    if probe_slots_cap < 0 || probe_slots_len < 0 ||
       probe_slots_len > probe_slots_cap ||
       (probe_slots == nil && probe_slots_cap != 0) ||
       (probe_slots != nil && probe_slots_cap == 0):
        cheng_mem_registry_hard_fail(
            "ffi probe table: shape invalid")
        return false
    if minCap <= probe_slots_cap:
        return true
    let stride = int64(sizeof(ChengFfiHandleSlot))
    if minCap < 0 || stride <= int64(0) ||
       int64(minCap) > int64(2147483647) / stride:
        cheng_mem_registry_hard_fail(
            "ffi probe table: requested capacity overflows addressable bytes")
        return false
    var newCap: int32 = probe_slots_cap
    if newCap < 16:
        newCap = 16
    while newCap < minCap:
        let maxCap = int32(int64(2147483647) / stride)
        if newCap > maxCap / 2:
            newCap = minCap
        else:
            newCap = newCap * 2
    let bytes: int64 = int64(newCap) * stride
    let mem: ptr = c_realloc(ptr(probe_slots), bytes)
    if mem == nil:
        return false
    let oldCap = probe_slots_cap
    probe_slots = ChengFfiHandleSlotPtr(mem)
    probe_slots_cap = newCap
    for i in oldCap..<newCap:
        let slot: ChengFfiHandleSlotPtr = probe_slot_at(i)
        if slot == nil:
            cheng_mem_registry_hard_fail(
                "ffi probe table: initialized slot unavailable")
            return false
        slot->ptr = nil
        slot->generation = uint32(1)
        slot->liveBorrowCount = uint64(0)
        slot->borrowGeneration = uint64(0)
    return true

fn probe_live_slot_for_payload_locked(
        payload: ptr): ChengFfiHandleSlotPtr =
    if payload == nil || probe_slots == nil:
        return nil
    if probe_slots_cap <= 0 || probe_slots_len < 0 ||
       probe_slots_len > probe_slots_cap:
        cheng_mem_registry_hard_fail(
            "ffi probe table: payload index shape invalid")
        return nil
    for i in 0..<probe_slots_len:
        let slot = probe_slot_at(i)
        if slot == nil || slot->liveBorrowCount > uint64(1):
            cheng_mem_registry_hard_fail(
                "ffi probe table: payload index slot corrupt")
            return nil
        if slot->ptr == nil:
            if slot->liveBorrowCount != uint64(0):
                cheng_mem_registry_hard_fail(
                    "ffi probe table: retired payload remains leased")
                return nil
            continue
        if slot->generation == uint32(0):
            cheng_mem_registry_hard_fail(
                "ffi probe table: live payload generation missing")
            return nil
        if slot->ptr == payload:
            return slot
    return nil

fn cheng_malloc_locked(size0: int32): ptr =
    let ledgerOwner = cheng_allocation_ledger_active_locked()
    if ledgerOwner != nil:
        let ledgerPayload =
            cheng_allocation_ledger_allocate_locked(
                ledgerOwner, size0)
        if ledgerPayload != nil:
            cheng_mm_alloc_total = cheng_mm_alloc_total + 1
            cheng_mm_live_total = cheng_mm_live_total + 1
        return ledgerPayload
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_thread_allocation")
        return nil
    var size: int32 = size0
    if size <= 0:
        size = 1
    let total: int64 = int64(sizeof(ChengMemHeader)) + int64(size)
    # 大块走 mmap: free/migrate 时 munmap 直接归还 OS (libc free 只回
    # malloc pool 不还, 是 freed-but-not-returned RSS 高水位的根源)。mmap 失败
    # (如 Linux flags 不兼容) 回落 malloc — c_mmap_anon 返 nil 可观测非静默。
    # [wall150] 阈值 1MiB→256KiB（memline2c §3/§7 假说 b 轻量版）：SMALL 档
    # dirty=历史 live 峰不归还 OS，编译器中型列（256KiB~1MiB 翻倍链区）是
    # SMALL dirty 的主体；改走 mmap 档后 free（quarantine 淘汰）即
    # munmap 真归还。header bit30 mmap 标记/registry/quarantine/毒化复扫
    # 全流程复用，语义零变化；段数量级=live 中型列数（数千），可接受。
    # r2(256KiB) gate 实证 call_fixture 1077→1021MiB 过帽。
    # 注意：r3 曾降至 128KiB，触发 compiler snapshot lowering bridge
    # "output storage already owned"（128KiB~256KiB 档块与 bridge 输出存储
    # 所有权判定交互出雷），已回退 256KiB——该档位禁止再降。
    var raw: ptr
    var rawIsMmap: bool
    if total >= int64(262144):
        raw = c_mmap_anon(total)
        if raw != nil:
            rawIsMmap = true
    if raw == nil:
        raw = c_malloc(total)
    if raw == nil:
        return nil
    let header: ChengMemHeaderPtr = ChengMemHeaderPtr(raw)
    cheng_mem_header_rc_set(header, 1)
    if rawIsMmap:
        cheng_mem_header_size_set_mmap(header, size)
    else:
        cheng_mem_header_size_set(header, size)
    let payload: ptr = cheng_payload_ptr(raw)
    let insertOk = cheng_mem_registry_insert(payload)
    if !insertOk:
        cheng_mem_block_release(header)
        return nil
    cheng_mem_registry_cached_payload_raw = uint64(payload)
    cheng_bytes_set(payload, 0, size)
    cheng_mm_alloc_total = cheng_mm_alloc_total + 1
    cheng_mm_live_total = cheng_mm_live_total + 1
    return payload

@exportc("cheng_malloc")
fn cheng_malloc_export(size0: int32): ptr =
    cheng_runtime_lock()
    let payload = cheng_malloc_locked(size0)
    cheng_runtime_unlock()
    return payload

@exportc("cheng_runtime_heap_new")
fn cheng_runtime_heap_new_export(size: int32): ptr =
    return cheng_malloc_export(size)

fn cheng_free_locked(p: ptr) =
    let header: ChengMemHeaderPtr = cheng_mem_header(p)
    if header == nil:
        if p == nil:
            return
        # [free-hunt] 外域指针 free 现场尸检(复用 ORCMISS dump: p+deref16+quarantine
        # 扫描)。移动端 tun worker 周期性被此 fail-stop 打死, 需点名肇事指针。
        cheng_orcmiss_autopsy_dump(p)
        if cheng_allocation_ledger_any_active_locked() != nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_duplicate_or_untracked_free")
            return
        cheng_runtime_lock_abort(
            "cheng free: foreign pointer (allocator pairing violation)")
        return
    if cheng_mem_header_is_ledger(header):
        cheng_allocation_ledger_release_locked(p, header)
        cheng_mm_free_total = cheng_mm_free_total + 1
        if cheng_mm_live_total <= 0:
            cheng_allocation_ledger_abort(
                "allocation_ledger_runtime_live_counter_underflow")
        else:
            cheng_mm_live_total = cheng_mm_live_total - 1
        return
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_domain_free")
        return
    if probe_live_slot_for_payload_locked(p) != nil:
        cheng_mem_registry_hard_fail(
            "ffi probe table: free with live handle")
        return
    cheng_mem_registry_remove(p)
    cheng_quarantine_release_locked(header)
    cheng_mm_free_total = cheng_mm_free_total + 1
    if cheng_mm_live_total > 0:
        cheng_mm_live_total = cheng_mm_live_total - 1

@exportc("cheng_free")
fn cheng_free_export(p: ptr) =
    cheng_runtime_lock()
    cheng_free_locked(p)
    cheng_runtime_unlock()

@exportc("cheng_realloc")
fn cheng_realloc_export(p: ptr, size0: int32): ptr =
    cheng_runtime_lock()
    if p == nil:
        let freshNil: ptr = cheng_malloc_locked(size0)
        cheng_runtime_unlock()
        return freshNil
    var size: int32 = size0
    if size <= 0:
        size = 1
    let header: ChengMemHeaderPtr = cheng_mem_header(p)
    if header == nil:
        # 分配器配对: p 非本分配器产物 (registry miss = 无 ChengMemHeader 的裸
        # buffer, 如 cold 内联 seq lowering 的 calloc/bump payload)。原静默返
        # nil 会让上游 seq_set_grow 报 "alloc failed" —— 与真 OOM 同文案的诊断
        # 歧义地雷。loud panic 让跨分配器 grow 在第一现场暴露 (let-it-crash)。
        cheng_runtime_unlock()
        panic("cheng realloc: foreign pointer (allocator pairing violation)")
        return nil
    let ledgerOwner = cheng_allocation_ledger_active_locked()
    let anyLedgerOwner = cheng_allocation_ledger_any_active_locked()
    let ledgerAllocation = cheng_mem_header_is_ledger(header)
    if ledgerAllocation && ledgerOwner == nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_realloc_without_active_owner")
        return nil
    if !ledgerAllocation && ledgerOwner != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_domain_realloc")
        return nil
    if !ledgerAllocation && anyLedgerOwner != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_thread_or_domain_realloc")
        return nil
    if !ledgerAllocation &&
       probe_live_slot_for_payload_locked(p) != nil:
        cheng_runtime_unlock()
        cheng_mem_registry_hard_fail(
            "ffi probe table: realloc with live handle")
        return nil
    var oldAllocationId: uint64
    var oldRecordIndex: int32 = -1
    var oldAllocationGeneration: uint64
    var oldUsablePayloadBytes: uint64
    if ledgerAllocation:
        let oldRecord =
            cheng_allocation_ledger_record_for_header_locked(p, header)
        if oldRecord == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_realloc_source_untracked")
            return nil
        if oldRecord->liveHandleCount != uint64(0):
            cheng_allocation_ledger_abort(
                "allocation_ledger_realloc_with_live_handle")
            return nil
        oldAllocationId = oldRecord->allocationId
        oldRecordIndex = oldRecord->recordIndex
        oldAllocationGeneration = oldRecord->allocationGeneration
        oldUsablePayloadBytes = oldRecord->usablePayloadBytes
    if cheng_mem_header_rc_get(header) > 1:
        let fresh: ptr = cheng_malloc_locked(size)
        if fresh == nil:
            cheng_runtime_unlock()
            return nil
        var copyBytes: int32 = cheng_mem_header_size_get(header)
        if copyBytes > size:
            copyBytes = size
        if copyBytes > 0:
            cheng_bytes_copy(fresh, p, copyBytes)
        cheng_mem_release_locked(p)
        if ledgerAllocation:
            cheng_allocation_ledger_record_realloc_locked(
                oldRecordIndex, oldAllocationGeneration,
                oldAllocationId, oldUsablePayloadBytes, fresh)
        cheng_runtime_unlock()
        return fresh
    let total: int64 = int64(sizeof(ChengMemHeader)) + int64(size)
    # mmap 块不可喂 libc realloc; 大块升级也借 migrate 迁入 mmap。与上方
    # rc>1 分支同构: malloc_export 已内建 mmap 分级, release 走 block 派发。
    # [wall150] 阈值与 cheng_malloc_locked 同步（256KiB；128KiB 档已实证触发
    # bridge 所有权雷，禁止再降），扩容链一致。
    if ledgerAllocation || cheng_mem_header_is_mmap(header) ||
       total >= int64(262144):
        let freshM: ptr = cheng_malloc_locked(size)
        if freshM == nil:
            cheng_runtime_unlock()
            return nil
        var copyBytesM: int32 = cheng_mem_header_size_get(header)
        if copyBytesM > size:
            copyBytesM = size
        if copyBytesM > 0:
            cheng_bytes_copy(freshM, p, copyBytesM)
        cheng_mem_release_locked(p)
        if ledgerAllocation:
            cheng_allocation_ledger_record_realloc_locked(
                oldRecordIndex, oldAllocationGeneration,
                oldAllocationId, oldUsablePayloadBytes, freshM)
        cheng_runtime_unlock()
        return freshM
    let raw: ptr = c_realloc(ptr(header), total)
    if raw == nil:
        cheng_runtime_unlock()
        return nil
    let nextHeader: ChengMemHeaderPtr = ChengMemHeaderPtr(raw)
    let oldSize = cheng_mem_header_size_get(nextHeader)
    if size > oldSize:
        let payload: ptr = cheng_payload_ptr(raw)
        cheng_bytes_set(cheng_ptr_plus(payload, oldSize), 0, size - oldSize)
    cheng_mem_header_size_set(nextHeader, size)
    let nextPayload: ptr = cheng_payload_ptr(raw)
    if nextPayload != p:
        cheng_mem_registry_remove(p)
        let insertOk = cheng_mem_registry_insert(nextPayload)
        if !insertOk:
            cheng_runtime_unlock()
            cheng_panic_cstring_and_exit_export("cheng_realloc: registry insert failed")
            return nil
    cheng_runtime_unlock()
    return nextPayload

@exportc("cheng_mem_retain")
fn cheng_mem_retain_export(p: ptr) =
    if p == nil:
        return
    let activeOwnerSlotIndex =
        cheng_allocation_ledger_active_owner_index_fast()
    if activeOwnerSlotIndex >= 0:
        cheng_runtime_leaf_lock()
        let control = ChengAllocationLedgerControlPlanePtr(
            ptr(cheng_allocation_ledger_control_plane_raw))
        let record =
            cheng_allocation_ledger_live_record_for_payload_locked(p)
        let slot = cheng_allocation_ledger_record_slot_locked(record)
        if control == nil ||
           activeOwnerSlotIndex >= chengAllocationLedgerOwnerSlotCount ||
           control->activeOwnerSlotIndex != activeOwnerSlotIndex ||
           record == nil || slot == nil ||
           slot->slotIndex != activeOwnerSlotIndex:
            cheng_runtime_leaf_unlock()
            cheng_allocation_ledger_abort(
                "allocation_ledger_duplicate_or_untracked_retain")
            return
        let exactHeader = cheng_mem_header(p)
        let exactRecord = cheng_allocation_ledger_record_for_header_locked(
            p, exactHeader)
        if exactHeader == nil || exactRecord != record:
            cheng_runtime_leaf_unlock()
            cheng_allocation_ledger_abort(
                "allocation_ledger_retain_identity_lost")
            return
        let rc = cheng_mem_header_rc_get(exactHeader)
        if rc <= 0 || rc == 2147483647:
            cheng_runtime_leaf_unlock()
            cheng_allocation_ledger_abort(
                "allocation_ledger_retain_refcount_invalid")
            return
        let rcBefore = cheng_runtime_atomic_add_i32_intrinsic(
            ptr(exactHeader), 1)
        if rcBefore != rc:
            cheng_allocation_ledger_abort(
                "allocation_ledger_retain_refcount_race")
            return
        cheng_mm_retain_total = cheng_mm_retain_total + 1
        cheng_allocation_ledger_record_reference_event_locked(
            slot, record, chengAllocationLedgerOperationRetain)
        cheng_runtime_leaf_unlock()
        return
    let header: ChengMemHeaderPtr = cheng_mem_header_unchecked(p)
    if header == nil:
        return
    # Lock-free fast path: the refcount cell is a plain 32-bit fetch-add.
    # ORC ownership discipline guarantees rc >= 1 whenever a legitimate
    # retainer runs (a retain requires an already-counted ref), so the
    # increment can never race a final release's free. This removes the
    # global runtime lock from every refcount bump -- measured as the
    # dominant serialization in parallel allocation-bound workloads
    # (MoQ fountain droplet loop, ~30x wall blowup from lock handoff).
    let _ = cheng_runtime_atomic_add_i32_intrinsic(ptr(header), 1)
    # Diagnostic counter: intentionally lock-free like the rc itself; a
    # concurrent increment can be lost under heavy contention (count is
    # observability, not correctness).
    cheng_mm_retain_total = cheng_mm_retain_total + 1

fn cheng_mem_release_registry_miss_fail(atomicRelease: bool) =
    if atomicRelease:
        cheng_panic_cstring_and_exit_export(
            "cheng_orc_release_failure code=registry_miss operation=atomic_release detail=wrong_object_or_owner")
        return
    cheng_panic_cstring_and_exit_export(
        "cheng_orc_release_failure code=registry_miss operation=normal_release detail=wrong_object_or_owner")

fn cheng_mem_release_underflow_fail(atomicRelease: bool) =
    if atomicRelease:
        cheng_panic_cstring_and_exit_export(
            "cheng_orc_release_failure code=refcount_underflow operation=atomic_release detail=double_release_or_wrong_owner")
        return
    cheng_panic_cstring_and_exit_export(
        "cheng_orc_release_failure code=refcount_underflow operation=normal_release detail=double_release_or_wrong_owner")

fn cheng_mem_release_finalize_miss_fail(atomicRelease: bool) =
    if atomicRelease:
        cheng_panic_cstring_and_exit_export(
            "cheng_orc_release_failure code=finalize_registry_miss operation=atomic_release detail=wrong_object_or_owner")
        return
    cheng_panic_cstring_and_exit_export(
        "cheng_orc_release_failure code=finalize_registry_miss operation=normal_release detail=wrong_object_or_owner")

fn cheng_mem_release_live_counter_fail(atomicRelease: bool) =
    if atomicRelease:
        cheng_panic_cstring_and_exit_export(
            "cheng_orc_release_failure code=live_counter_underflow operation=atomic_release detail=alloc_free_live_drift")
        return
    cheng_panic_cstring_and_exit_export(
        "cheng_orc_release_failure code=live_counter_underflow operation=normal_release detail=alloc_free_live_drift")

# [orc-hunt] registry_miss 死亡现场尸检：p 处 16 字节内容（可直接点名被误
# release 的 str/Bytes 视图落在什么文本上）+ quarantine 环范围扫描（p 落入
# 近期 freed 块 = release-after-free/double release，打印槽号/基址/偏移/块长）。
# 仅在 fail-stop 死亡路径调用；临终读竞态可接受。
fn cheng_orcmiss_autopsy_dump(p: ptr) =
    let dbgBuf: ptr = ptr(cheng_quarantine_msg_buf)
    let derefHead: ptr = "ORCMISS deref16="
    var dbgP: int32 = cheng_cstrlen_raw(derefHead)
    cheng_bytes_copy(dbgBuf, derefHead, dbgP)
    var scanIdx: int32
    while scanIdx < 16:
        dbgP = cheng_quarantine_hex_append(dbgBuf, dbgP, uint64(*(UInt8Ptr(cheng_ptr_plus(p, scanIdx)))))
        scanIdx = scanIdx + 1
    *(UInt8Ptr(cheng_ptr_plus(dbgBuf, dbgP))) = uint8(10)
    *(UInt8Ptr(cheng_ptr_plus(dbgBuf, dbgP + 1))) = uint8(0)
    cheng_stderr_write_cstr(dbgBuf)
    let qHead: ptr = "ORCMISS q="
    var qP: int32 = cheng_cstrlen_raw(qHead)
    cheng_bytes_copy(dbgBuf, qHead, qP)
    var foundIdx: int64 = int64(-1)
    var foundOff: int64 = int64(-1)
    var foundSize: int64 = int64(-1)
    if cheng_quarantine_ring != nil && cheng_quarantine_ring_len > 0:
        let entryStride: int32 = int32(sizeof(ChengQuarantineEntry))
        let pRaw: uint64 = uint64(p)
        var k: int32
        while k < cheng_quarantine_ring_len:
            var slotIdx: int32 = cheng_quarantine_ring_head + k
            if slotIdx >= cheng_quarantine_ring_cap:
                slotIdx = slotIdx - cheng_quarantine_ring_cap
            let entryAddr: ptr = cheng_ptr_plus(ptr(cheng_quarantine_ring), int32(int64(slotIdx) * int64(entryStride)))
            let entry: ChengQuarantineEntryPtr = ChengQuarantineEntryPtr(entryAddr)
            let headerRaw: uint64 = uint64(entry->header)
            if headerRaw != uint64(0) && (headerRaw >> uint64(32)) != uint64(0xDDDDDDDD):
                let qHeader: ChengMemHeaderPtr = ChengMemHeaderPtr(entry->header)
                let qPayload: ptr = cheng_payload_ptr(ptr(qHeader))
                let qSize: int32 = cheng_mem_header_size_get(qHeader)
                if pRaw >= uint64(qPayload) && pRaw < uint64(qPayload) + uint64(int64(qSize)):
                    foundIdx = int64(slotIdx)
                    foundOff = int64(pRaw) - int64(uint64(qPayload))
                    foundSize = int64(qSize)
            k = k + 1
    qP = cheng_quarantine_hex_append(dbgBuf, qP, uint64(foundIdx))
    qP = cheng_quarantine_hex_append(dbgBuf, qP, uint64(foundOff))
    qP = cheng_quarantine_hex_append(dbgBuf, qP, uint64(foundSize))
    *(UInt8Ptr(cheng_ptr_plus(dbgBuf, qP))) = uint8(10)
    *(UInt8Ptr(cheng_ptr_plus(dbgBuf, qP + 1))) = uint8(0)
    cheng_stderr_write_cstr(dbgBuf)

fn cheng_mem_release_registered_header(p: ptr,
                                       atomicRelease: bool): ChengMemHeaderPtr =
    var header: ChengMemHeaderPtr = cheng_mem_header_cached_fast(p)
    if header != nil:
        return header
    cheng_runtime_leaf_lock()
    header = cheng_mem_header(p)
    if header == nil &&
       cheng_allocation_ledger_any_active_locked() != nil:
        cheng_runtime_leaf_unlock()
        cheng_allocation_ledger_abort(
            "allocation_ledger_duplicate_or_untracked_release")
        return nil
    cheng_runtime_leaf_unlock()
    if header == nil:
        # SCOPED DIAGNOSTIC (worker orc hunt): dump the missed pointer + autopsy.
        let dbgBuf: ptr = ptr(cheng_quarantine_msg_buf)
        let dbgHead: ptr = "ORCMISS p=0x"
        var dbgP: int32 = cheng_cstrlen_raw(dbgHead)
        cheng_bytes_copy(dbgBuf, dbgHead, dbgP)
        dbgP = cheng_quarantine_hex_append(dbgBuf, dbgP, uint64(p))
        *(UInt8Ptr(cheng_ptr_plus(dbgBuf, dbgP))) = uint8(10)
        *(UInt8Ptr(cheng_ptr_plus(dbgBuf, dbgP + 1))) = uint8(0)
        cheng_stderr_write_cstr(dbgBuf)
        cheng_orcmiss_autopsy_dump(p)
        cheng_mem_release_registry_miss_fail(atomicRelease)
    return header

fn cheng_mem_release_finalize_locked(p: ptr,
                                     header: ChengMemHeaderPtr,
                                     atomicRelease: bool) =
    # rc==0 的 free 对象必然在册。任何 miss 都是错误对象、错误 owner、
    # stale borrow 或 double release；不得静默跳过物理释放。
    if cheng_mm_live_total <= 0:
        cheng_mem_release_live_counter_fail(atomicRelease)
        return
    if cheng_mem_header_is_ledger(header):
        cheng_allocation_ledger_release_locked(p, header)
        cheng_mm_free_total = cheng_mm_free_total + 1
        cheng_mm_live_total = cheng_mm_live_total - 1
        return
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_domain_release")
        return
    if probe_live_slot_for_payload_locked(p) != nil:
        cheng_mem_registry_hard_fail(
            "ffi probe table: managed release with live handle")
        return
    if !cheng_mem_registry_remove_checked(p):
        cheng_mem_release_finalize_miss_fail(atomicRelease)
        return
    cheng_quarantine_release_locked(header)
    cheng_mm_free_total = cheng_mm_free_total + 1
    cheng_mm_live_total = cheng_mm_live_total - 1

fn cheng_mem_release_locked(p: ptr) =
    var header: ChengMemHeaderPtr
    var ledgerRecord: ChengAllocationLedgerRecordPtr
    var ledgerSlot: ChengAllocationLedgerOwnerSlotPtr
    if cheng_allocation_ledger_any_active_locked() != nil:
        ledgerRecord =
            cheng_allocation_ledger_live_record_for_payload_locked(p)
        ledgerSlot =
            cheng_allocation_ledger_record_slot_locked(ledgerRecord)
        if ledgerRecord == nil || ledgerSlot == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_duplicate_or_untracked_release")
            return
        header = cheng_mem_header(p)
        let exactRecord =
            cheng_allocation_ledger_record_for_header_locked(p, header)
        if header == nil || exactRecord != ledgerRecord:
            cheng_allocation_ledger_abort(
                "allocation_ledger_release_identity_lost")
            return
    else:
        header = cheng_mem_header_unchecked(p)
    if header == nil:
        return
    if cheng_mem_header_is_ledger(header):
        if ledgerRecord == nil:
            ledgerRecord =
                cheng_allocation_ledger_record_for_header_locked(p, header)
            ledgerSlot =
                cheng_allocation_ledger_record_slot_locked(ledgerRecord)
        if ledgerRecord == nil || ledgerSlot == nil:
            return
    let rcBefore = cheng_runtime_atomic_add_i32_intrinsic(ptr(header), -1)
    cheng_mm_release_total = cheng_mm_release_total + 1
    if rcBefore <= 0:
        cheng_mem_release_underflow_fail(false)
        return
    if ledgerRecord != nil:
        cheng_allocation_ledger_record_reference_event_locked(
            ledgerSlot, ledgerRecord,
            chengAllocationLedgerOperationRelease)
    if rcBefore == 1:
        cheng_mem_release_finalize_locked(p, header, false)

fn cheng_mem_release_checked(p: ptr, atomicRelease: bool) =
    if p == nil:
        return
    if cheng_allocation_ledger_active_owner_index_fast() >= 0:
        cheng_runtime_leaf_lock()
        cheng_mem_release_locked(p)
        cheng_runtime_leaf_unlock()
        return
    let header = cheng_mem_release_registered_header(p, atomicRelease)
    if header == nil:
        return
    if cheng_mem_header_is_ledger(header):
        cheng_runtime_leaf_lock()
        let exactHeader = cheng_mem_header(p)
        if exactHeader == nil || !cheng_mem_header_is_ledger(exactHeader):
            cheng_runtime_leaf_unlock()
            cheng_allocation_ledger_abort(
                "allocation_ledger_release_identity_lost")
            return
        cheng_mem_release_locked(p)
        cheng_runtime_leaf_unlock()
        return
    let rcBefore = cheng_runtime_atomic_add_i32_intrinsic(ptr(header), -1)
    cheng_mm_release_total = cheng_mm_release_total + 1
    if rcBefore <= 0:
        cheng_mem_release_underflow_fail(atomicRelease)
        return
    if rcBefore > 1:
        return
    cheng_runtime_leaf_lock()
    cheng_mem_release_finalize_locked(p, header, atomicRelease)
    cheng_runtime_leaf_unlock()

@exportc("cheng_mem_release")
fn cheng_mem_release_export(p: ptr) =
    cheng_mem_release_checked(p, false)

