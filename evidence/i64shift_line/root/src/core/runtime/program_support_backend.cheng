fn cheng_same_thread_large_stack_alloc(size0: int32): ptr =
    cheng_runtime_lock()
    let payload = cheng_malloc_locked(size0)
    cheng_runtime_unlock()
    return payload

fn cheng_same_thread_large_stack_free(p: ptr) =
    if p == nil:
        return
    cheng_runtime_lock()
    cheng_free_locked(p)
    cheng_runtime_unlock()

fn cheng_same_thread_large_stack_entry(sig: int32) =
    if uint64(cheng_pthread_self_runtime()) != cheng_same_thread_stack_owner:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_thread_allocation")
        return
    let fnPtr = cheng_same_thread_stack_fn
    let ctx = cheng_same_thread_stack_ctx
    if fnPtr != nil:
        __cheng_call_indirect_void_runtime(fnPtr, ctx)

fn cheng_same_thread_large_stack_call(fnPtr: ptr, ctx: ptr) =
    if cheng_same_thread_stack_depth != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_same_thread_stack_reentered")
        return
    # M3 线：Darwin 不再 abort。账本 armed 时 cheng_call_on_large_stack 的
    # 串行臂此前只有 Linux 实现，Darwin 直接 hard-exit——这是驱动编译期
    # system-link-exec 大栈臂 armed 轮 rc=70 的唯一位点。
    # Darwin 臂 = 同线程直调：不建线程、不换栈、不做信号/ucontext 开关。
    # （arm64 macOS 信号 handler 与 swapcontext 均不继承/恢复被调保存寄存器，
    # 冷编译器寄存器缓存的全局跨开关即成垃圾，实测两条路全 139。）
    # 直调与账本 ownerThread 纪律天然一致；栈容量是 Darwin 诊断轮的操作
    # 前提（启动器 ulimit -s 抬主栈），非运行期语义。
    if cheng_host_is_darwin():
        __cheng_call_indirect_void_runtime(fnPtr, ctx)
        return
    let sigNum: int32 = chengLinuxSigusr1
    let saFlags: int32 = int32(chengLinuxSaOnstack | chengLinuxSaRestart)
    let stackTBytes: int32 = chengLinuxStackTBytes
    let stackSpOffset: int32 = chengLinuxStackSpOffset
    let stackSizeOffset: int32 = chengLinuxStackSizeOffset
    let stackFlagsOffset: int32 = chengLinuxStackFlagsOffset
    let sigactionBytes: int32 = chengLinuxSigactionBytes
    let sigactionHandlerOffset: int32 = chengLinuxSigactionHandlerOffset
    let sigactionFlagsOffset: int32 = chengLinuxSigactionFlagsOffset
    let owner = uint64(cheng_pthread_self_runtime())
    let stack = cheng_same_thread_large_stack_alloc(
        chengSameThreadLargeStackBytes)
    let newSs = cheng_same_thread_large_stack_alloc(stackTBytes)
    let oldSs = cheng_same_thread_large_stack_alloc(stackTBytes)
    let newSa = cheng_same_thread_large_stack_alloc(sigactionBytes)
    let oldSa = cheng_same_thread_large_stack_alloc(sigactionBytes)
    if stack == nil || newSs == nil || oldSs == nil ||
       newSa == nil || oldSa == nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_same_thread_stack_alloc_failed")
        return
    cheng_bytes_set(newSs, 0, stackTBytes)
    cheng_bytes_set(oldSs, 0, stackTBytes)
    cheng_bytes_set(newSa, 0, sigactionBytes)
    cheng_bytes_set(oldSa, 0, sigactionBytes)
    let stackRaw = uint64(stack)
    let stackSize = uint64(chengSameThreadLargeStackBytes)
    let handler: ptr = &cheng_same_thread_large_stack_entry
    let handlerRaw = uint64(handler)
    *(UInt64Ptr(cheng_ptr_plus(newSs, stackSpOffset))) = stackRaw
    *(Int32Ptr(cheng_ptr_plus(newSs, stackFlagsOffset))) = 0
    *(UInt64Ptr(cheng_ptr_plus(newSs, stackSizeOffset))) = stackSize
    *(UInt64Ptr(cheng_ptr_plus(newSa, sigactionHandlerOffset))) = handlerRaw
    *(Int32Ptr(cheng_ptr_plus(newSa, sigactionFlagsOffset))) = saFlags
    if cheng_sigaltstack_runtime(newSs, oldSs) != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_same_thread_stack_switch_failed")
        return
    if cheng_sigaction_runtime(sigNum, newSa, oldSa) != 0:
        let _ = cheng_sigaltstack_runtime(oldSs, nil)
        cheng_allocation_ledger_abort(
            "allocation_ledger_same_thread_stack_switch_failed")
        return
    let prevFn = cheng_same_thread_stack_fn
    let prevCtx = cheng_same_thread_stack_ctx
    let prevOwner = cheng_same_thread_stack_owner
    cheng_same_thread_stack_fn = fnPtr
    cheng_same_thread_stack_ctx = ctx
    cheng_same_thread_stack_owner = owner
    cheng_same_thread_stack_depth = 1
    if cheng_raise_runtime(sigNum) != 0:
        cheng_same_thread_stack_depth = 0
        cheng_same_thread_stack_fn = prevFn
        cheng_same_thread_stack_ctx = prevCtx
        cheng_same_thread_stack_owner = prevOwner
        let _ = cheng_sigaction_runtime(sigNum, oldSa, nil)
        let _ = cheng_sigaltstack_runtime(oldSs, nil)
        cheng_allocation_ledger_abort(
            "allocation_ledger_same_thread_stack_switch_failed")
        return
    if uint64(cheng_pthread_self_runtime()) != owner:
        cheng_allocation_ledger_abort(
            "allocation_ledger_cross_thread_allocation")
        return
    cheng_same_thread_stack_depth = 0
    cheng_same_thread_stack_fn = prevFn
    cheng_same_thread_stack_ctx = prevCtx
    cheng_same_thread_stack_owner = prevOwner
    let _ = cheng_sigaction_runtime(sigNum, oldSa, nil)
    let _ = cheng_sigaltstack_runtime(oldSs, nil)
    cheng_same_thread_large_stack_free(oldSa)
    cheng_same_thread_large_stack_free(newSa)
    cheng_same_thread_large_stack_free(oldSs)
    cheng_same_thread_large_stack_free(newSs)
    cheng_same_thread_large_stack_free(stack)

@borrows
@exportc("cheng_call_on_large_stack")
fn cheng_call_on_large_stack_export(fnPtr: ptr, ctx: ptr): int32 =
    if fnPtr == nil:
        return 0
    cheng_runtime_lock()
    let ledgerActive = cheng_allocation_ledger_any_active_locked() != nil
    cheng_runtime_unlock()
    if ledgerActive:
        cheng_same_thread_large_stack_call(fnPtr, ctx)
        return 1
    let thread = cheng_thread_start_export(fnPtr, ctx)
    if thread == nil:
        return 0
    if cheng_thread_join_export(thread) == 0:
        return 0
    return 1

@exportc("cheng_thread_parallelism")
fn cheng_thread_parallelism_export(): int32 =
    return native_cheng_system_cpu_logical_cores_value_runtime()

@exportc("cheng_thread_yield")
fn cheng_thread_yield_export() =
    let _ = cheng_sched_yield_runtime()

@exportc("cheng_sched_pending")
