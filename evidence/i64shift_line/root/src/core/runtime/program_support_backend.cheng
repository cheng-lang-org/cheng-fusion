        chengHeldExecCapsuleProviderRoleFinishedWriters[roleRow]
    let finishedReader =
        chengHeldExecCapsuleProviderRoleFinishedReaders[roleRow]
    let decisionWriter =
        chengHeldExecCapsuleProviderRoleDecisionWriters[roleRow]
