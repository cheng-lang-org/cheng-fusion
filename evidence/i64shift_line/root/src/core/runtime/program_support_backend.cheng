@exportc("cheng_udp_recvfrom_addr_bridge")
fn cheng_udp_recvfrom_addr_bridge_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrCap: int32, outAddrLen: var int32, outErr: var int32): int32 =
    outAddrLen = 0
    outErr = 0
    if fd < 0 || buf == nil || len <= 0 || addr == nil || addrCap <= 0:
        return -1
    var rawLen: int32 = addrCap
    let rc: int32 = libc_recvfrom_native(fd, buf, len, flags, addr, &rawLen)
    if rc < 0:
        outErr = cheng_errno_code()
        return rc
    outAddrLen = rawLen
    return rc

@exportc("cheng_udp_recvfrom_addr_ptr_bridge")
fn cheng_udp_recvfrom_addr_ptr_bridge_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrCap: int32, outAddrLen: ptr, outErr: ptr): int32 =
    if outAddrLen != nil:
        *(Int32Ptr(outAddrLen)) = 0
    if outErr != nil:
        *(Int32Ptr(outErr)) = 0
    if fd < 0 || buf == nil || len <= 0 || addr == nil || addrCap <= 0 || outAddrLen == nil || outErr == nil:
        return -1
    *(Int32Ptr(outAddrLen)) = addrCap
    let rc: int32 = libc_recvfrom_native(fd, buf, len, flags, addr, outAddrLen)
    if rc < 0:
        *(Int32Ptr(outErr)) = cheng_errno_code()
        return rc
    return rc

@exportc("cheng_udp_platform_use_len_field_bridge")
