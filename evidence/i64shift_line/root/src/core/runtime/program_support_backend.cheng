    return ts.tv_sec * 1000000000 + ts.tv_nsec

# [spin-wd] 线程 CPU 时间桥: 区分"纯用户态自旋"(CPU 时间满速)与"等 IO"
# (CPU 时间不走)。VPN 数据面死旋看门狗消费, Linux CLOCK_THREAD_CPUTIME_ID。
@exportc("cheng_thread_cputime_ns")
fn cheng_thread_cputime_ns_export(): int64 =
    var ts: DarwinTimespec
    if libc_clock_gettime(chengClockThreadCputime, ptr(&ts)) != 0:
        return 0
    return ts.tv_sec * 1000000000 + ts.tv_nsec

