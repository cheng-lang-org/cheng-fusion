    return argvRaw

fn cheng_exec_program_build_shell_raw_argv(command: ptr): ptr =
    if command == nil || *UInt8Ptr(command) == uint8(0):
        return nil
    let slotCount: int32 = 4
    let argvRaw: ptr = cheng_malloc_export(slotCount * int32(sizeof(ptr)))
    if argvRaw == nil:
