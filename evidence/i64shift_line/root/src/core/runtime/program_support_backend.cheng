    let mem = cheng_malloc_export(int32(sizeof(ChengRelayProviderRuntime)))
    if mem == nil:
        return nil
    let runtime = ChengRelayProviderRuntimePtr(mem)
    runtime->serviceKind = nil
    runtime->endpoint = nil
    runtime->region = nil
    runtime->authScope = nil
    runtime->requiresLease = 0
    runtime->healthy = 0
    runtime->lastError = nil
    return runtime

fn cheng_relay_provider_runtime_dispose(runtime: ChengRelayProviderRuntimePtr) =
    if runtime == nil:
        return
    cheng_free_export(runtime->serviceKind)
    cheng_free_export(runtime->endpoint)
    cheng_free_export(runtime->region)
    cheng_free_export(runtime->authScope)
    cheng_free_export(runtime->lastError)
    cheng_free_export(ptr(runtime))

fn cheng_relay_provider_set_error_cstring(runtime: ChengRelayProviderRuntimePtr, text: ptr) =
    if runtime == nil:
        return
    cheng_free_export(runtime->lastError)
    let textLen = cheng_cstrlen_raw(text)
    runtime->lastError = cheng_string_copy(text, textLen)

fn cheng_relay_provider_set_error(runtime: ChengRelayProviderRuntimePtr, text: str) =
    if runtime == nil:
        return
    cheng_free_export(runtime->lastError)
    runtime->lastError = cheng_copy_cstring_from_str(text)

fn cheng_relay_provider_probe_payload(runtime: ChengRelayProviderRuntimePtr): str =
    if runtime == nil:
        return cheng_str_empty()
    var healthyText: str
    if runtime->healthy != 0:
        healthyText = cheng_str_copy_cstring("1")
    else:
        healthyText = cheng_str_copy_cstring("0")
    var errorText = cheng_str_copy_cstring(runtime->lastError)
    var out = cheng_str_copy_cstring("ok=1\n")
    cheng_runtime_concat_assign_cstring(out, "healthy=")
    cheng_runtime_concat_assign(out, healthyText)
    cheng_runtime_concat_assign_cstring(out, "\n")
    cheng_runtime_concat_assign_cstring(out, "successPermille=1000\n")
    cheng_runtime_concat_assign_cstring(out, "loadPermille=0\n")
    cheng_runtime_concat_assign_cstring(out, "capacityPermille=1000\n")
    cheng_runtime_concat_assign_cstring(out, "error=")
    cheng_runtime_concat_assign(out, errorText)
    cheng_runtime_concat_assign_cstring(out, "\n")
    cheng_str_dispose(healthyText)
    cheng_str_dispose(errorText)
    return out

fn cheng_relay_provider_issue_lease_payload(runtime: ChengRelayProviderRuntimePtr,
                                            requesterPeerIdText: str,
                                            requestedRegionText: str,
                                            nonceHex: str): str =
    if runtime == nil:
        return cheng_str_empty()
    if runtime->healthy == 0:
        var errorText = cheng_str_copy_cstring(runtime->lastError)
        var out = cheng_str_copy_cstring("ok=0\nerror=")
        cheng_runtime_concat_assign(out, errorText)
        cheng_runtime_concat_assign_cstring(out, "\n")
        cheng_str_dispose(errorText)
        return out
    if runtime->requiresLease != 0 && cheng_str_len(requesterPeerIdText) <= 0:
        return "ok=0\nerror=relay provider: requester missing\n"
    var endpointText = cheng_str_copy_cstring(runtime->endpoint)
    var regionText = cheng_str_copy_cstring(runtime->region)
    if cheng_str_len(requestedRegionText) > 0:
        cheng_str_dispose(regionText)
        regionText = cheng_str_dup(requestedRegionText)
    var usernameText = cheng_str_empty()
    var credentialText = cheng_str_empty()
    if runtime->requiresLease != 0:
        var serviceText = cheng_str_copy_cstring(runtime->serviceKind)
        var scopeText = cheng_str_copy_cstring(runtime->authScope)
        usernameText = cheng_str_dup(serviceText)
        cheng_runtime_concat_assign_cstring(usernameText, ":")
        cheng_runtime_concat_assign(usernameText, requesterPeerIdText)
        cheng_runtime_concat_assign_cstring(usernameText, ":")
        cheng_runtime_concat_assign(usernameText, nonceHex)
        credentialText = cheng_str_copy_cstring("scope=")
        cheng_runtime_concat_assign(credentialText, scopeText)
        cheng_runtime_concat_assign_cstring(credentialText, "|peer=")
        cheng_runtime_concat_assign(credentialText, requesterPeerIdText)
        cheng_runtime_concat_assign_cstring(credentialText, "|nonce=")
        cheng_runtime_concat_assign(credentialText, nonceHex)
        cheng_str_dispose(serviceText)
        cheng_str_dispose(scopeText)
    var out = cheng_str_copy_cstring("ok=1\n")
    cheng_runtime_concat_assign_cstring(out, "region=")
    cheng_runtime_concat_assign(out, regionText)
    cheng_runtime_concat_assign_cstring(out, "\n")
    cheng_runtime_concat_assign_cstring(out, "endpoint=")
    cheng_runtime_concat_assign(out, endpointText)
    cheng_runtime_concat_assign_cstring(out, "\n")
    cheng_runtime_concat_assign_cstring(out, "username=")
    cheng_runtime_concat_assign(out, usernameText)
    cheng_runtime_concat_assign_cstring(out, "\n")
    cheng_runtime_concat_assign_cstring(out, "credential=")
    cheng_runtime_concat_assign(out, credentialText)
    cheng_runtime_concat_assign_cstring(out, "\n")
    cheng_runtime_concat_assign_cstring(out, "error=\n")
    cheng_str_dispose(endpointText)
    cheng_str_dispose(regionText)
    cheng_str_dispose(usernameText)
    cheng_str_dispose(credentialText)
    return out

fn cheng_errno_code(): int32 =
    return native_cheng_errno_code_runtime()

fn cheng_error_with_errno(prefix: ptr): str =
    let reason = cheng_errno_text_ptr(cheng_errno_code())
    let prefixText = cheng_str_copy_cstring(prefix)
    if reason == nil || cheng_cstrlen_raw(reason) <= 0:
        return prefixText
    var out = prefixText
    cheng_runtime_concat_assign_cstring(out, ": ")
    cheng_runtime_concat_assign_cstring(out, reason)
    return out

fn cheng_sockaddr_ipv4_make(port: int32, inaddr: int32): ptr =
    let addr = cheng_malloc_export(chengSockaddrInLen)
    if addr == nil:
        return nil
    cheng_bytes_set(addr, 0, chengSockaddrInLen)
    let family = cheng_af_inet()
    if cheng_sockaddr_use_len_field():
        cheng_bytes_set(cheng_ptr_plus(addr, 0), chengSockaddrInLen, 1)
        cheng_bytes_set(cheng_ptr_plus(addr, 1), family & 255, 1)
    else:
        cheng_bytes_set(cheng_ptr_plus(addr, 0), family & 255, 1)
        cheng_bytes_set(cheng_ptr_plus(addr, 1), (family >> 8) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 2), (port >> 8) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 3), port & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 4), (inaddr >> 24) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 5), (inaddr >> 16) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 6), (inaddr >> 8) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 7), inaddr & 255, 1)
    return addr

fn cheng_sockaddr_loopback(port: int32): ptr =
    return cheng_sockaddr_ipv4_make(port, chengInaddrLoopback)

fn cheng_sockaddr_ipv6_make(port: int32, inaddr: ptr): ptr =
    let addr = cheng_malloc_export(chengSockaddrIn6Len)
    if addr == nil:
        return nil
    cheng_bytes_set(addr, 0, chengSockaddrIn6Len)
    let family = cheng_af_inet6()
    if cheng_sockaddr_use_len_field():
        cheng_bytes_set(cheng_ptr_plus(addr, 0), chengSockaddrIn6Len, 1)
        cheng_bytes_set(cheng_ptr_plus(addr, 1), family & 255, 1)
    else:
        cheng_bytes_set(cheng_ptr_plus(addr, 0), family & 255, 1)
        cheng_bytes_set(cheng_ptr_plus(addr, 1), (family >> 8) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 2), (port >> 8) & 255, 1)
    cheng_bytes_set(cheng_ptr_plus(addr, 3), port & 255, 1)
    if inaddr != nil:
        cheng_bytes_copy(cheng_ptr_plus(addr, 8), inaddr, 16)
    return addr

fn cheng_sockaddr_loopback_v6(port: int32): ptr =
    let octets = cheng_malloc_export(16)
    if octets == nil:
        return nil
    cheng_bytes_set(octets, 0, 16)
    cheng_bytes_set(cheng_ptr_plus(octets, 15), 1, 1)
    let addr = cheng_sockaddr_ipv6_make(port, octets)
    cheng_free_export(octets)
    return addr

@borrows
fn cheng_parse_ipv4_addr(text: str, outAddr: ptr): bool =
    if outAddr == nil:
        return false
    let data = cheng_str_data(text)
    let n = cheng_str_len(text)
    if data == nil || n <= 0:
        return false
    var partIndex: int32
    var value: int32
    var sawDigit = false
    cheng_bytes_set(outAddr, 0, 4)
    for i in 0..<n:
        let ch = int32(*(UInt8Ptr(cheng_ptr_plus(data, i))))
        if ch >= int32('0') && ch <= int32('9'):
            sawDigit = true
            value = value * 10 + (ch - int32('0'))
            if value > 255:
                return false
        elif ch == int32('.'):
            if !sawDigit || partIndex >= 3:
                return false
            cheng_bytes_set(cheng_ptr_plus(outAddr, partIndex), value, 1)
            partIndex = partIndex + 1
            value = 0
            sawDigit = false
        else:
            return false
    if !sawDigit || partIndex != 3:
        return false
    cheng_bytes_set(cheng_ptr_plus(outAddr, partIndex), value, 1)
    return true

fn cheng_parse_ipv4_cstring_octet(src: ptr, index: var int32, outValue: var int32): bool =
    var value: int32
    var digits: int32
    if src == nil:
        return false
    while true:
        let b: uint8 = *(UInt8Ptr(cheng_ptr_plus(src, index)))
        if b < uint8('0') || b > uint8('9'):
            break
        value = value * 10 + int32(b) - int32('0')
        if value > 255:
            return false
        digits = digits + 1
        index = index + 1
    if digits <= 0:
        return false
    outValue = value
    return true

fn cheng_inet_pton_ipv4(src: ptr, dst: ptr): int32 =
    if src == nil || dst == nil:
        return -1
    var index: int32
    var values: int32[4]
    for part in 0..<4:
        var value: int32
        if !cheng_parse_ipv4_cstring_octet(src, index, value):
            return 0
        values[part] = value
        let next: uint8 = *(UInt8Ptr(cheng_ptr_plus(src, index)))
        if part < 3:
            if next != uint8('.'):
                return 0
            index = index + 1
        else:
            if next != uint8(0):
                return 0
    for i in 0..<4:
        cheng_bytes_set(cheng_ptr_plus(dst, i), values[i], 1)
    return 1

fn cheng_write_u8_decimal_cstring(value: int32, out: ptr, offset0: int32, cap: int32): int32 =
    if out == nil || offset0 < 0 || offset0 >= cap:
        return -1
    if value == 0:
        if offset0 + 1 >= cap:
            return -1
        cheng_bytes_set(cheng_ptr_plus(out, offset0), int32('0'), 1)
        return offset0 + 1
    if value < 0 || value > 255:
        return -1
    var offset: int32 = offset0
    if value >= 100:
        if offset + 3 >= cap:
            return -1
        let hundreds = value / 100
        let rem = value - hundreds * 100
        let tens = rem / 10
        let ones = rem - tens * 10
        cheng_bytes_set(cheng_ptr_plus(out, offset), hundreds + int32('0'), 1)
        offset = offset + 1
        cheng_bytes_set(cheng_ptr_plus(out, offset), tens + int32('0'), 1)
        offset = offset + 1
        cheng_bytes_set(cheng_ptr_plus(out, offset), ones + int32('0'), 1)
        return offset + 1
    if value >= 10:
        if offset + 2 >= cap:
            return -1
        let tens = value / 10
        let ones = value - tens * 10
        cheng_bytes_set(cheng_ptr_plus(out, offset), tens + int32('0'), 1)
        offset = offset + 1
        cheng_bytes_set(cheng_ptr_plus(out, offset), ones + int32('0'), 1)
        return offset + 1
    if offset + 1 >= cap:
        return -1
    cheng_bytes_set(cheng_ptr_plus(out, offset), value + int32('0'), 1)
    return offset + 1

fn cheng_inet_ntop_ipv4(src: ptr, dst: ptr, size: int32): ptr =
    if src == nil || dst == nil || size < 16:
        return nil
    var offset: int32
    for i in 0..<4:
        if i > 0:
            cheng_bytes_set(cheng_ptr_plus(dst, offset), int32('.'), 1)
            offset = offset + 1
        let value: int32 = int32(*(UInt8Ptr(cheng_ptr_plus(src, i))))
        offset = cheng_write_u8_decimal_cstring(value, dst, offset, size)
        if offset < 0:
            return nil
    if offset >= size:
        return nil
    cheng_bytes_set(cheng_ptr_plus(dst, offset), 0, 1)
    return dst

@borrows
fn cheng_sockaddr_ipv4_parse(hostText: str, port: int32): ptr =
    let octets = cheng_malloc_export(4)
    if octets == nil:
        return nil
    if !cheng_parse_ipv4_addr(hostText, octets):
        cheng_free_export(octets)
        return nil
    let inaddr = (int32(*(UInt8Ptr(cheng_ptr_plus(octets, 0)))) << 24) |
                 (int32(*(UInt8Ptr(cheng_ptr_plus(octets, 1)))) << 16) |
                 (int32(*(UInt8Ptr(cheng_ptr_plus(octets, 2)))) << 8) |
                 int32(*(UInt8Ptr(cheng_ptr_plus(octets, 3))))
    cheng_free_export(octets)
    return cheng_sockaddr_ipv4_make(port, inaddr)

fn cheng_sockaddr_port(addr: ptr): int32 =
    if addr == nil:
        return 0
    return (int32(*(UInt8Ptr(cheng_ptr_plus(addr, 2)))) << 8) |
           int32(*(UInt8Ptr(cheng_ptr_plus(addr, 3))))

type
    ChengUdpBindResult =
        rc: int32
        fd: int32
        port: int32
        family: int32
        useLenField: int32

fn cheng_udp_bind_host_port_impl(out: var ChengUdpBindResult, hostText: str, port: int32, isV6: bool) =
    out.rc = 0
    out.fd = -1
    out.port = 0
    out.family = 0
    out.useLenField = 0
    var bindAddrRaw: uint64
    if port < 0 || port > 65535:
        out.rc = 22
        return

    var family: int32
    if isV6:
        family = cheng_af_inet6()
    else:
        family = cheng_af_inet()
    let _socketStartup = cheng_host_socket_startup()
    let fd: int32 = libc_socket(family, cheng_sock_dgram(), 0)
    if fd < 0:
        out.rc = cheng_errno_code()
        return

    if cheng_sockaddr_use_len_field():
        out.useLenField = 1
    else:
        out.useLenField = 0
    if isV6:
        if cheng_str_len(hostText) <= 0 || cheng_str_equals_cstring(hostText, "localhost"):
            bindAddrRaw = uint64(cheng_sockaddr_loopback_v6(port))
        else:
            libc_close(fd)
            out.rc = 97
            return
        if bindAddrRaw == uint64(0):
            libc_close(fd)
            out.rc = 12
            return
        let bindAddr: ptr = ptr(bindAddrRaw)
        if libc_bind(fd, bindAddr, chengSockaddrIn6Len) != 0:
            out.rc = cheng_errno_code()
            cheng_free_export(bindAddr)
            libc_close(fd)
            return
        if port == 0:
            let rawLenMem: ptr = cheng_malloc_export(int32(sizeof(int32)))
            if rawLenMem == nil:
                out.rc = 12
                cheng_free_export(bindAddr)
                libc_close(fd)
                return
            *(Int32Ptr(rawLenMem)) = chengSockaddrIn6Len
            if libc_getsockname(fd, bindAddr, rawLenMem) != 0:
                out.rc = cheng_errno_code()
                cheng_free_export(rawLenMem)
                cheng_free_export(bindAddr)
                libc_close(fd)
                return
            cheng_free_export(rawLenMem)
        out.fd = fd
        out.port = cheng_sockaddr_port(bindAddr)
        out.family = cheng_af_inet6()
        cheng_free_export(bindAddr)
        return
    if cheng_str_len(hostText) <= 0 || cheng_str_equals_cstring(hostText, "localhost"):
        bindAddrRaw = uint64(cheng_sockaddr_loopback(port))
    else:
        bindAddrRaw = uint64(cheng_sockaddr_ipv4_parse(hostText, port))
    if bindAddrRaw == uint64(0):
        libc_close(fd)
        out.rc = 22
        return
    let bindAddr: ptr = ptr(bindAddrRaw)
    if libc_bind(fd, bindAddr, chengSockaddrInLen) != 0:
        out.rc = cheng_errno_code()
        cheng_free_export(bindAddr)
        libc_close(fd)
        return
    if port == 0:
        let rawLenMem: ptr = cheng_malloc_export(int32(sizeof(int32)))
        if rawLenMem == nil:
            out.rc = 12
            cheng_free_export(bindAddr)
            libc_close(fd)
            return
        *(Int32Ptr(rawLenMem)) = chengSockaddrInLen
        if libc_getsockname(fd, bindAddr, rawLenMem) != 0:
            out.rc = cheng_errno_code()
            cheng_free_export(rawLenMem)
            cheng_free_export(bindAddr)
            libc_close(fd)
            return
        cheng_free_export(rawLenMem)
    out.fd = fd
    out.port = cheng_sockaddr_port(bindAddr)
    out.family = cheng_af_inet()
    cheng_free_export(bindAddr)
    return

@exportc("cheng_errno")
fn cheng_errno_export(): int32 =
    return cheng_errno_code()

@exportc("cheng_strerror")
fn cheng_strerror_export(err: int32): ptr =
    return cheng_errno_text_ptr(err)

fn cheng_errno_text_ptr(err: int32): ptr =
    if err == 0:
        return "ok"
    if err == 1:
        return "operation not permitted"
    if err == 2:
        return "no such file or directory"
    if err == 4:
        return "interrupted system call"
    if err == 9:
        return "bad file descriptor"
    if err == 11:
        return "resource temporarily unavailable"
    if err == 12:
        return "cannot allocate memory"
    if err == 13:
        return "permission denied"
    if err == 22:
        return "invalid argument"
    if err == 24:
        return "too many open files"
    if err == 32:
        return "broken pipe"
    if err == 97:
        return "address family not supported"
    if err == 98:
        return "address already in use"
    if err == 101:
        return "network unreachable"
    if err == 104:
        return "connection reset by peer"
    if err == 107:
        return "transport endpoint is not connected"
    if err == 110:
        return "connection timed out"
    if err == 111:
        return "connection refused"
    if err == 113:
        return "no route to host"
    if err == 114:
        return "operation already in progress"
    if err == 115:
        return "operation now in progress"
    return "unknown error"

@exportc("libc_socket")
fn libc_socket_export(domain: int32, typ: int32, protocol: int32): int32 =
    return libc_socket(domain, typ, protocol)

# ssize_t-returning wrappers must export int64: an int32 export zero-extends
# into x0 on arm64, so -1 reaches int64 callers as 4294967295 and their
# `n <= 0` error checks never fire (see cheng_mobile_tun_fd_read/write below).
@exportc("libc_write")
fn libc_write_export(fd: int32, buf: ptr, count: int32): int64 =
    return libc_write_runtime(fd, buf, count)

@exportc("libc_read")
fn libc_read_export(fd: int32, buf: ptr, count: int32): int64 =
    return libc_read_runtime(fd, buf, count)

@exportc("libc_fcntl")
fn libc_fcntl_export(fd: int32, cmd: int32, arg: int32): int32 =
    return libc_fcntl_native(fd, cmd, arg)

@exportc("libc_bind")
fn libc_bind_export(fd: int32, addr: ptr, len: int32): int32 =
    return libc_bind(fd, addr, len)

@exportc("libc_sendto")
fn libc_sendto_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrlen: int32): int32 =
    return libc_sendto_native(fd, buf, len, flags, addr, addrlen)

@exportc("libc_listen")
fn libc_listen_export(fd: int32, backlog: int32): int32 =
    return libc_listen(fd, backlog)

@exportc("libc_connect")
fn libc_connect_export(fd: int32, addr: ptr, len: int32): int32 =
    return libc_connect(fd, addr, len)

# addrlen must stay a raw pointer: C accept allows NULL addr/addrlen and
# os.tcpAcceptFdNoAddr relies on that.
@exportc("libc_accept")
fn libc_accept_export(fd: int32, addr: ptr, addrlen: ptr): int32 =
    return libc_accept(fd, addr, addrlen)

# send/recv return at most `len` (int32) bytes, so the int32 inner channel is
# value-exact; int64() sign-extends it back to the full ssize_t contract.
@exportc("libc_send")
fn libc_send_export(fd: int32, buf: ptr, len: int32, flags: int32): int64 =
    return int64(libc_send(fd, buf, len, flags))

@exportc("libc_recv")
fn libc_recv_export(fd: int32, buf: ptr, len: int32, flags: int32): int64 =
    return int64(libc_recv(fd, buf, len, flags))

@exportc("libc_shutdown")
fn libc_shutdown_export(fd: int32, how: int32): int32 =
    return libc_shutdown_native(fd, how)

@exportc("libc_recvfrom")
fn libc_recvfrom_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrlen: var int32): int32 =
    var localLen: int32 = addrlen
    let rc: int32 = libc_recvfrom_native(fd, buf, len, flags, addr, &localLen)
    addrlen = localLen
    return rc

@exportc("cheng_recvfrom_fd_ex")
fn cheng_recvfrom_fd_ex_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrlen: ptr, outErr: var int32): int32 =
    outErr = 0
    let rc: int32 = libc_recvfrom_native(fd, buf, len, flags, addr, addrlen)
    if rc < 0:
        outErr = cheng_errno_code()
    return rc

@exportc("libc_setsockopt")
fn libc_setsockopt_export(fd: int32, level: int32, optname: int32, optval: ptr, optlen: int32): int32 =
    return libc_setsockopt(fd, level, optname, optval, optlen)

@exportc("libc_inet_pton")
fn libc_inet_pton_export(family: int32, src: ptr, dst: ptr): int32 =
    if family != 2:
        return -1
    return cheng_inet_pton_ipv4(src, dst)

@exportc("libc_inet_ntop")
fn libc_inet_ntop_export(family: int32, src: ptr, dst: ptr, size: int32): ptr =
    if family != 2:
        return nil
    return cheng_inet_ntop_ipv4(src, dst, size)

@exportc("libc_getsockname")
fn libc_getsockname_export(fd: int32, addr: ptr, addrlen: var int32): int32 =
    var localLen: int32 = addrlen
    let rc: int32 = libc_getsockname(fd, addr, &localLen)
    addrlen = localLen
    return rc

@exportc("libc_close")
fn libc_close_export(fd: int32): int32 =
    return libc_close(fd)

@exportc("cheng_udp_bind_host_port_bridge")
@abi_internal
fn cheng_udp_bind_host_port_bridge_export(host: str, port: int32, isV6: int32, outFd: var int32, outPort: var int32, outFamily: var int32, outUseLenField: var int32): int32 =
    var bindRes: ChengUdpBindResult
    cheng_udp_bind_host_port_impl(bindRes, host, port, isV6 != 0)
    outFd = bindRes.fd
    outPort = bindRes.port
    outFamily = bindRes.family
    outUseLenField = bindRes.useLenField
    return bindRes.rc

@exportc("cheng_udp_bind_fd_bridge")
@abi_internal
fn cheng_udp_bind_fd_bridge_export(host: str, port: int32, isV6: int32): int32 =
    var bindRes: ChengUdpBindResult
    cheng_udp_bind_host_port_impl(bindRes, host, port, isV6 != 0)
    if bindRes.rc != 0:
        return 0 - bindRes.rc
    return bindRes.fd

@exportc("cheng_tcp_listen_host_port_bridge")
@abi_internal
fn cheng_tcp_listen_host_port_bridge_export(hostText: cstring, port: int32, isV6: int32): int32 =
    if port < 0 || port > 65535:
        return -22
    var family: int32
    if isV6 != 0:
        family = cheng_af_inet6()
    else:
        family = cheng_af_inet()
    let _socketStartup = cheng_host_socket_startup()
    let fd: int32 = libc_socket(family, cheng_sock_stream(), cheng_ipproto_ip())
    if fd < 0:
        return 0 - cheng_errno_code()
    let reuse: int32 = 1
    libc_setsockopt(fd, cheng_sol_socket(), cheng_so_reuseaddr(), ptr(&reuse), int32(sizeof(int32)))
    var bindAddrRaw: uint64
    var bindLen: int32
    let hostLen = cheng_cstrlen_raw(hostText)
    let hostIsLocalhost = cheng_cstring_equals_cstring(hostText, "localhost")
    if isV6 != 0:
        bindLen = chengSockaddrIn6Len
        if hostLen <= 0 || hostIsLocalhost:
            bindAddrRaw = uint64(cheng_sockaddr_loopback_v6(port))
        else:
            libc_close(fd)
            return -97
    else:
        bindLen = chengSockaddrInLen
        if hostLen <= 0:
            bindAddrRaw = uint64(cheng_sockaddr_ipv4_make(port, 0))
        elif hostIsLocalhost:
            bindAddrRaw = uint64(cheng_sockaddr_loopback(port))
        else:
            var hostStr = cheng_str_copy_cstring(hostText)
            bindAddrRaw = uint64(cheng_sockaddr_ipv4_parse(hostStr, port))
            cheng_str_dispose(hostStr)
    if bindAddrRaw == uint64(0):
        libc_close(fd)
        return -22
    let bindAddr: ptr = ptr(bindAddrRaw)
    if libc_bind(fd, bindAddr, bindLen) != 0:
        let err: int32 = cheng_errno_code()
        cheng_free_export(bindAddr)
        libc_close(fd)
        return 0 - err
    cheng_free_export(bindAddr)
    if libc_listen(fd, 16) != 0:
        let err: int32 = cheng_errno_code()
        libc_close(fd)
        return 0 - err
    return fd

@exportc("cheng_tcp_accept_noaddr_bridge")
fn cheng_tcp_accept_noaddr_bridge_export(fd: int32): int32 =
    if fd < 0:
        return -22
    let clientFd: int32 = libc_accept(fd, nil, nil)
    if clientFd < 0:
        return 0 - cheng_errno_code()
    return clientFd

@exportc("cheng_udp_bound_port_bridge")
fn cheng_udp_bound_port_bridge_export(fd: int32, isV6: int32): int32 =
    if fd < 0:
        return -22
    let rawLenInit: int32 = if isV6 != 0: chengSockaddrIn6Len else: chengSockaddrInLen
    let rawAddr = cheng_malloc_export(rawLenInit)
    if rawAddr == nil:
        return -12
    cheng_bytes_set(rawAddr, 0, rawLenInit)
    let rawLenMem: ptr = cheng_malloc_export(int32(sizeof(int32)))
    if rawLenMem == nil:
        cheng_free_export(rawAddr)
        return -12
    *(Int32Ptr(rawLenMem)) = rawLenInit
    if libc_getsockname(fd, rawAddr, rawLenMem) != 0:
        let err = cheng_errno_code()
        cheng_free_export(rawLenMem)
        cheng_free_export(rawAddr)
        return 0 - err
    let port: int32 = cheng_sockaddr_port(rawAddr)
    cheng_free_export(rawLenMem)
    cheng_free_export(rawAddr)
    return port

@exportc("cheng_fd_set_nonblocking_bridge")
fn cheng_fd_set_nonblocking_bridge_export(fd: int32, enabled: int32): int32 =
    if fd < 0:
        return -1
    let flags: int32 = libc_fcntl_native(fd, cheng_host_f_getfl(), 0)
    if flags < 0:
        return -1
    let nonblockFlag: int32 = cheng_host_o_nonblock()
    let nonblockClearMask: int32 = -1 - nonblockFlag
    var nextFlags: int32 = flags
    if enabled != 0:
        nextFlags = flags | nonblockFlag
    else:
        nextFlags = flags & nonblockClearMask
    return libc_fcntl_native(fd, cheng_host_f_setfl(), nextFlags)

@exportc("cheng_fd_wait_readable_bridge")
fn cheng_fd_wait_readable_bridge_export(fd: int32, timeoutMs: int32): int32 =
    if fd < 0:
        return -22
    let pollFd = cheng_malloc_export(chengPollFdLen)
    if pollFd == nil:
        return -12
    cheng_pollfd_write(pollFd, fd, chengPollIn)
    let rc = libc_poll(pollFd, 1, timeoutMs)
    let revents = cheng_pollfd_revents(pollFd)
    cheng_free_export(pollFd)
    if rc < 0:
        let err = cheng_errno_code()
        return 0 - err
    if rc == 0 || revents == 0:
        return 0
    if (revents & chengPollIn) != 0:
        return 1
    # [dead-fd-hunt] 对端关闭(POLLHUP/POLLERR 无 POLLIN)必须报就绪: 调用方
    # recv 将拿到 0/EOF 走既有收割分支。旧形返回 0=永远不可读 → recv 永不
    # 被调用 → 死 target 流在 mux pump 里无限空转(实测 poll 1ms+sleep 2ms
    # 循环烧 CPU, 手机侧干等到超时, 下行吞吐被拖垮)。
    if (revents & (chengPollErr | chengPollHup)) != 0:
        return 1
    return 0

# [event-wait] 多 fd 等待 ABI(与 provider_linux/darwin 同名同义): 状态式
# 3 调用(reset/add/wait), pollfd 数组堆存。mux serve 主循环用它在单次
# ppoll 里同时等 carrier+全部 target fd, 替代逐 fd 轮询(间歇读模型驯化
# 源站 BBR 的供数节律瓶颈, PUMPRATE 定谳)。
var chengPsPollSetBuf: ptr
var chengPsPollSetCap: int32
var chengPsPollSetCount: int32

@exportc("cheng_fd_wait_multi_reset")
fn cheng_fd_wait_multi_reset_export() =
    chengPsPollSetCount = 0

@exportc("cheng_fd_wait_multi_add")
fn cheng_fd_wait_multi_add_export(fd: int32, events: int32): int32 =
    if fd < 0:
        return -22
    if chengPsPollSetCount >= chengPsPollSetCap:
        var newCap: int32 = chengPsPollSetCap * 2
        if newCap < 16:
            newCap = 16
        let newBuf: ptr = cheng_malloc_export(newCap * 8)
        if newBuf == nil:
            return -12
        if chengPsPollSetBuf != nil && chengPsPollSetCount > 0:
            cheng_memcpy_export(newBuf, chengPsPollSetBuf, chengPsPollSetCount * 8)
        if chengPsPollSetBuf != nil:
            cheng_free_export(chengPsPollSetBuf)
        chengPsPollSetBuf = newBuf
        chengPsPollSetCap = newCap
    let slot: ptr = cheng_ptr_plus(chengPsPollSetBuf, chengPsPollSetCount * 8)
    cheng_pollfd_write(slot, fd, events)
    chengPsPollSetCount = chengPsPollSetCount + 1
    return chengPsPollSetCount

@exportc("cheng_fd_wait_multi_wait")
fn cheng_fd_wait_multi_wait_export(timeoutMs: int32): int32 =
    if chengPsPollSetCount <= 0 || chengPsPollSetBuf == nil:
        return 0
    let rc = libc_poll(chengPsPollSetBuf, chengPsPollSetCount, timeoutMs)
    if rc < 0:
        let err = cheng_errno_code()
        if err > 0:
            return 0 - err
        return -1
    return rc

@exportc("cheng_fd_wait_writable_bridge")
fn cheng_fd_wait_writable_bridge_export(fd: int32, timeoutMs: int32): int32 =
    if fd < 0:
        return -22
    let pollFd = cheng_malloc_export(chengPollFdLen)
    if pollFd == nil:
        return -12
    cheng_pollfd_write(pollFd, fd, chengPollOut)
    let rc = libc_poll(pollFd, 1, timeoutMs)
    let revents = cheng_pollfd_revents(pollFd)
    cheng_free_export(pollFd)
    if rc < 0:
        let err = cheng_errno_code()
        return 0 - err
    if rc == 0 || revents == 0:
        return 0
    # [epipe-spin-fix] 对端关闭后 poll(POLLOUT) 立即返回 POLLOUT|POLLHUP,
    # 旧形把 ERR/HUP 也当"可写"返回 1 → 调用方 sendto 必 EPIPE, errno 链
    # 误读为 would-block 时 poll(-1) 又立即返回 → 无限 poll+sendto+SIGPIPE
    # 自旋烧满 CPU(实测 4 线程, 活流饿死 19KB/s)。HUP/ERR/NVAL 一律致命。
    # readable 方向不受影响(只认 POLLIN, EOF 由 recv=0 分支处理)。
    let hangupEvents: int32 = chengPollErr | chengPollHup
    if (revents & hangupEvents) != 0:
        return int32(-32)
    if (revents & chengPollOut) != 0:
        return 1
    return 0

