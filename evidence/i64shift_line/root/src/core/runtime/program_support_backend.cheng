            cheng_held_exec_parent_session_i32_load(
                chengHeldExecParentArenaChildPidOffset, slot),
            cheng_held_exec_parent_session_u32_load(
                chengHeldExecParentArenaChildUidOffset, slot),
            cheng_held_exec_parent_session_u32_load(
