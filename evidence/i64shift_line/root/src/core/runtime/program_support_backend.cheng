       !cheng_held_exec_cid_digest_into(
           ownerClaimReceiptCid, ownerClaimDigest) ||
       !cheng_held_exec_digest_nonzero(ownerClaimDigest):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrOwnerClaimInvalid, handle)
