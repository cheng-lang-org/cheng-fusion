        handle, &borrowGeneration)
    if runtimeRaw == nil:
        return cheng_str_empty()
    let runtime = ChengRelayProviderRuntimePtr(runtimeRaw)
    var payload = cheng_str_empty()
    if issuedAtEpochSeconds < 0 || ttlSeconds <= 0:
        cheng_relay_provider_set_error_cstring(runtime, "relay provider: lease ttl invalid")
        runtime->healthy = 0
        payload = cheng_relay_provider_issue_lease_payload(
            runtime, requesterPeerIdText, requestedRegionText, nonceHex)
    else:
        runtime->healthy = 1
        cheng_relay_provider_set_error_cstring(runtime, "")
        payload = cheng_relay_provider_issue_lease_payload(
            runtime, requesterPeerIdText, requestedRegionText, nonceHex)
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        cheng_str_dispose(payload)
        return cheng_str_empty()
    return payload

