# SABI (task #71 root fix): text crosses this boundary as raw (ptr,len:int64),
# never as `str`. Root cause of the prior design: @exportc (str)->str returns a
# 24-byte struct via hidden x8 sret, but the production consumer
# (src/mobile/mobile_capi_bridge_internal.cheng) declared the @importc target as
# plain (cstring)->cstring -- the caller never populated x8, so the callee's own
# `str x0, [x8]` write on return guaranteed a SIGSEGV the moment the real bridge
# ran (reproduced 4/4 under stage3). The unique current exported symbol carries
# only the raw pointer/length contract; incompatible consumers fail at link time.
@exportc("cheng_sha256_word_bridge")
@abi_internal
fn cheng_sha256_word_bridge_export(textRaw: ptr, textLen: int64, wordIndex: int32): int64 =
    if wordIndex < 0 || wordIndex >= 4:
        return 0
    if textLen < int64(0) || textLen > int64(2147483647):
        return 0
    let digest = cheng_malloc_export(32)
    if digest == nil:
        return 0
    if !cheng_sha256_digest_into(textRaw, int32(textLen), digest):
        cheng_free_export(digest)
        return 0
    let base = wordIndex * 8
    var out: uint64 = uint64(0)
    for i in 0..<8:
        out = (out << uint64(8)) | uint64(*(UInt8Ptr(cheng_ptr_plus(digest, base + i))))
    cheng_free_export(digest)
    return int64(out)

# outHex must point to a caller-owned buffer of at least 64 bytes. The digest's hex
# form is a fixed-size (64-byte ASCII) output, so a caller-supplied out buffer is
# the whole contract -- no allocation, no emit callback needed. Returns 64 (bytes
# written) on success, -1 on invalid input (bad length or nil out buffer).
@exportc("cheng_sha256_hex_bridge")
@abi_internal
fn cheng_sha256_hex_bridge_export(textRaw: ptr, textLen: int64, outHex: ptr): int32 =
    if outHex == nil || textLen < int64(0) || textLen > int64(2147483647):
        return -1
    let digest = cheng_malloc_export(32)
    if digest == nil:
        return -1
    if !cheng_sha256_digest_into(textRaw, int32(textLen), digest):
        cheng_free_export(digest)
        return -1
    for i in 0..<32:
        let value = int32(*(UInt8Ptr(cheng_ptr_plus(digest, i))))
        *(UInt8Ptr(cheng_ptr_plus(outHex, i * 2))) = cheng_sha256_hex_digit((value >> 4) & 15)
        *(UInt8Ptr(cheng_ptr_plus(outHex, i * 2 + 1))) = cheng_sha256_hex_digit(value & 15)
    cheng_free_export(digest)
    return 64

fn cheng_quote_json_text(text: str): str =
    let textLen = cheng_str_len(text)
    let outRaw = driver_c_new_string_export(textLen * 2 + 2)
    if outRaw == nil:
        return cheng_str_empty()
    var used: int32
    *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(34)
    used = used + 1
    for i in 0..<textLen:
        let ch = *(UInt8Ptr(cheng_ptr_plus(cheng_str_data(text), i)))
        if ch == uint8(92):
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(92)
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used + 1))) = uint8(92)
            used = used + 2
        elif ch == uint8(34):
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(92)
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used + 1))) = uint8(34)
            used = used + 2
        elif ch == uint8(10):
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(92)
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used + 1))) = uint8(110)
            used = used + 2
        elif ch == uint8(13):
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(92)
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used + 1))) = uint8(114)
            used = used + 2
        elif ch == uint8(9):
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(92)
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used + 1))) = uint8(116)
            used = used + 2
        else:
            *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = ch
            used = used + 1
    *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(34)
    used = used + 1
    return cheng_str_view_owned(outRaw, used)

