@exportc("driver_c_write_text_file_bridge")
@abi_internal
@borrows
fn driver_c_write_text_file_bridge_export(path: str, content: str) =
    cheng_write_text_file(path, content)

@exportc("driver_c_write_text_file_raw_bridge")
fn driver_c_write_text_file_raw_bridge_export(pathData: ptr,
                                              pathLen0: int32,
                                              contentData: ptr,
                                              contentLen0: int32): int32 =
    if pathData == nil || pathLen0 <= 0 || contentLen0 < 0:
        return 0
    if contentData == nil && contentLen0 > 0:
        return 0
    let path = cheng_malloc_export(pathLen0 + 1)
    if path == nil:
        return 0
    cheng_bytes_set(path, 0, pathLen0 + 1)
    cheng_bytes_copy(path, pathData, pathLen0)
    cheng_mkdir_all_raw(path, false)
    let fp = cheng_fopen_write(path)
    cheng_free_export(path)
    if fp == nil:
        return 0
    var wrote: int64
    if contentLen0 > 0:
        wrote = libc_fwrite(contentData, 1, int64(contentLen0), fp)
    let closeRc = libc_fclose(fp)
    if wrote == int64(contentLen0) && closeRc == 0:
        return 1
    return 0

@exportc("driver_c_write_error_report_bridge")
@abi_internal
@borrows
fn driver_c_write_error_report_bridge_export(rootDir: str,
                                              reportPath: str,
                                              reason: str): int32 =
    if cheng_str_len(reportPath) <= 0:
        return 1
    var fullPath: str
    if cheng_os_is_absolute_bridge_export(reportPath) != 0:
        fullPath = cheng_str_copy(cheng_str_data(reportPath),
                                  cheng_str_len(reportPath))
    else:
        fullPath = cheng_os_join_path_bridge_export(rootDir, reportPath)
    let rawPath = cheng_copy_cstring_from_str(fullPath)
    if rawPath == nil:
        cheng_str_dispose(fullPath)
        return 0
    cheng_mkdir_all_raw(rawPath, false)
    cheng_free_export(rawPath)
    var reportText = cheng_str_copy_cstring("system_link_exec_runtime_execute=error\nerror=")
    cheng_runtime_concat_assign(reportText, reason)
    cheng_runtime_concat_assign_cstring(reportText, "\n")
    let ok = cheng_write_text_file(fullPath, reportText)
    cheng_str_dispose(reportText)
    cheng_str_dispose(fullPath)
    if ok:
        return 1
    return 0

