@exportc("cheng_relay_provider_issue_lease_bridge")
@abi_internal
fn cheng_relay_provider_issue_lease_bridge_export(handle: uint64,
                                                     requesterPeerIdText: str,
                                                     requestedRegionText: str,
                                                     nonceHex: str,
                                                     issuedAtEpochSeconds: int64,
                                                     ttlSeconds: int32): str =
