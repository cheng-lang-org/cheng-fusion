fn cheng_held_exec_terminal_fd_close_once(fd: int32): int32 =
    if fd < 0:
        return 0
    return libc_terminal_fd_close_once_runtime(fd)

fn cheng_held_exec_bundle_owner_close_fd_once(row: int32): bool =
    if row < 0 || row >= chengHeldExecBundleOwnerCount:
        return false
    cheng_runtime_lock()
    let closeState = chengHeldExecBundleOwnerFdCloseStates[row]
    if closeState == chengHeldExecFdCloseNotPresent:
        cheng_runtime_unlock()
        return true
    if closeState == chengHeldExecFdCloseClosedClean ||
       closeState == chengHeldExecFdCloseClosedError ||
       closeState == chengHeldExecFdCloseInvalidEbafd:
        cheng_runtime_unlock()
        return closeState == chengHeldExecFdCloseClosedClean
    let fd = chengHeldExecBundleOwnerFds[row]
    if closeState != chengHeldExecFdCloseOpen || fd < 0:
        cheng_runtime_unlock()
        return false
    chengHeldExecBundleOwnerFdCloseStates[row] =
        chengHeldExecFdCloseClosing
    cheng_runtime_unlock()
    let receipt = cheng_held_exec_terminal_fd_close_once(fd)
    let terminalState = receipt == 1 ? chengHeldExecFdCloseClosedClean :
        (receipt == 2 ? chengHeldExecFdCloseClosedError :
            chengHeldExecFdCloseInvalidEbafd)
    cheng_runtime_lock()
    chengHeldExecBundleOwnerFds[row] = -1
    chengHeldExecBundleOwnerFdCloseReceipts[row] = receipt
    chengHeldExecBundleOwnerFdCloseStates[row] = terminalState
    cheng_runtime_unlock()
    return terminalState == chengHeldExecFdCloseClosedClean

# Each raw descriptor has its own immutable close state.  Receipt zero is only
# "not attempted"; a native EBADF publishes InvalidEbafd and can never be
# retried or washed into success by a later Abort.
fn cheng_held_exec_capsule_provider_role_close_fd_once(
        row: int32,
        role: int32): bool =
    if row < 0 || row >= chengHeldExecCapsuleProviderRoleCount:
        return false
    cheng_runtime_lock()
    var fd: int32 = -1
    var closeState: int32
    if role == chengHeldExecCapsuleFdBundleReader:
        fd = chengHeldExecCapsuleProviderRoleBundleReaders[row]
        closeState =
            chengHeldExecCapsuleProviderRoleBundleReaderCloseStates[row]
    elif role == chengHeldExecCapsuleFdFinishedWriter:
        fd = chengHeldExecCapsuleProviderRoleFinishedWriters[row]
        closeState =
            chengHeldExecCapsuleProviderRoleFinishedWriterCloseStates[row]
    elif role == chengHeldExecCapsuleFdFinishedReader:
        fd = chengHeldExecCapsuleProviderRoleFinishedReaders[row]
        closeState =
            chengHeldExecCapsuleProviderRoleFinishedReaderCloseStates[row]
    elif role == chengHeldExecCapsuleFdDecisionWriter:
        fd = chengHeldExecCapsuleProviderRoleDecisionWriters[row]
        closeState =
            chengHeldExecCapsuleProviderRoleDecisionWriterCloseStates[row]
    elif role == chengHeldExecCapsuleFdDecisionReader:
        fd = chengHeldExecCapsuleProviderRoleDecisionReaders[row]
        closeState =
            chengHeldExecCapsuleProviderRoleDecisionReaderCloseStates[row]
    else:
        cheng_runtime_unlock()
        return false
    if closeState == chengHeldExecFdCloseNotPresent:
        cheng_runtime_unlock()
        return true
    if closeState == chengHeldExecFdCloseClosedClean ||
       closeState == chengHeldExecFdCloseClosedError ||
       closeState == chengHeldExecFdCloseInvalidEbafd:
        cheng_runtime_unlock()
        return closeState == chengHeldExecFdCloseClosedClean
    if closeState != chengHeldExecFdCloseOpen || fd < 0:
