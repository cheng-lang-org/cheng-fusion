    return rc

@exportc("cheng_file_handle_open_bridge")
@abi_internal
@borrows
fn cheng_file_handle_open_bridge_export(path: str, mode: int32, outErr: var str): uint64 =
    outErr = ""
    if cheng_str_len(path) <= 0:
        let _ = cheng_file_handle_err(outErr, "os file open: empty path")
        return uint64(0)
    if cheng_str_contains_nul(path):
        let _ = cheng_file_handle_err(outErr, "os file open: path contains NUL")
        return uint64(0)
    if !cheng_file_handle_mode_valid(mode):
        let _ = cheng_file_handle_err(outErr, "os file open: invalid mode")
        return uint64(0)
    let rawPath = cheng_copy_cstring_from_str(path)
    if rawPath == nil:
        let _ = cheng_file_handle_err(outErr, "os file open: path alloc failed")
        return uint64(0)
    let flags = cheng_file_handle_openat_flags(mode)
    let fd = libc_openat_runtime(
        cheng_file_handle_at_fdcwd(), rawPath, flags, chengFileHandleCreatMode)
    cheng_free_export(rawPath)
    if fd < 0:
        let _ = cheng_file_handle_err(outErr, "os file open: provider open failed")
        return uint64(0)
    cheng_runtime_lock()
    let handle = cheng_file_handle_register_fd_locked(fd, mode, outErr)
    cheng_runtime_unlock()
    if handle == uint64(0):
        let _closeAfterRegisterFail = libc_close(fd)
        if cheng_str_len(outErr) <= 0:
            let _ = cheng_file_handle_err(outErr, "os file open: handle register failed")
        return uint64(0)
    return handle

