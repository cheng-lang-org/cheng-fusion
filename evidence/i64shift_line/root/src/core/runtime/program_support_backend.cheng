    let planReceipt = cheng_held_exec_plan_binding_receipt(
        planEvidenceReceipt,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, slot),
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestOwnerClaim, slot))
    let terminalReceiptClaimed =
        cheng_held_exec_wire_get_digest(finished, 256)
    cheng_held_exec_wire_put_digest(
        finished, 256, ChengFixedBytes32())
    let terminalReceipt = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.finished_receipt.v2", finished)
    let terminalOutputDigest =
        cheng_held_exec_wire_get_digest(finished, 160)
    let terminalOutputPathDigest =
        cheng_held_exec_wire_get_digest(finished, 288)
    let terminalOutputVerityDigest =
        cheng_held_exec_wire_get_digest(finished, 320)
    let terminalOutputIdentityDigest =
        cheng_held_exec_wire_get_digest(finished, 352)
    let terminalOutputBytes =
        cheng_held_exec_wire_get_u64(finished, 384)
    var observedOutputDigest: ChengFixedBytes32
    var observedOutputVerityDigest: ChengFixedBytes32
    var observedOutputIdentityDigest: ChengFixedBytes32
    var observedOutputBytes: uint64
    var outputProofOk = terminalExit != 0 && outputFd < 0
    if terminalExit == 0:
        outputProofOk = outputFd >= 0 &&
            terminalOutputBytes > uint64(0) &&
            cheng_fixed32_equal(planReceipt, claimedPlanReceipt) &&
            cheng_fixed32_equal(
                terminalOutputPathDigest,
                cheng_held_exec_parent_session_digest_load(
                    chengHeldExecParentDigestOutputPath, slot)) &&
            cheng_held_exec_named_output_matches(outputFd, outputPath) &&
            cheng_held_exec_fd_content_digest_into(
                outputFd,
                observedOutputDigest,
                observedOutputBytes) &&
            observedOutputBytes == terminalOutputBytes &&
            cheng_fixed32_equal(
                observedOutputDigest, terminalOutputDigest) &&
            cheng_linux_fsverity_measure_sha256_runtime(
                outputFd,
                &observedOutputVerityDigest.data[0]) == 0 &&
            cheng_fixed32_equal(
                observedOutputVerityDigest,
                terminalOutputVerityDigest) &&
            cheng_held_exec_file_identity_digest(
                outputFd, observedOutputIdentityDigest) &&
            cheng_fixed32_equal(
                observedOutputIdentityDigest,
                terminalOutputIdentityDigest)
    var outputClosed = true
    if outputFd >= 0:
        outputClosed = libc_close(outputFd) == 0
    if !cheng_held_exec_digest_nonzero(planReceipt) ||
       !cheng_held_exec_digest_nonzero(planEvidenceReceipt) ||
       !cheng_fixed32_equal(planReceipt, claimedPlanReceipt) ||
       !cheng_fixed32_equal(
           terminalReceipt, terminalReceiptClaimed) ||
       !outputProofOk || !outputClosed ||
       !cheng_held_exec_named_path_matches(
           cheng_held_exec_parent_session_i32_load(
               chengHeldExecParentArenaRetainedFdOffset, slot),
           chengHeldExecNativePath):
        return cheng_held_exec_parent_result_error(
            chengHeldExecParentErrTerminalInvalid)
    var childIdentityWire: ChengHeldExecWire
    cheng_held_exec_wire_zero(childIdentityWire)
    cheng_held_exec_wire_put_digest(
        childIdentityWire,
        0,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, slot))
    cheng_held_exec_wire_put_digest(
        childIdentityWire,
        32,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestExecutable, slot))
    let childIdentity = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.child_identity.v2",
        childIdentityWire)
    if !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(finished, 448),
           childIdentity):
        return cheng_held_exec_parent_result_error(
            chengHeldExecParentErrTerminalInvalid)
    cheng_held_exec_parent_session_digest_store(
        chengHeldExecParentDigestPlan, slot, planReceipt)
    cheng_held_exec_parent_session_digest_store(
        chengHeldExecParentDigestTerminal, slot, terminalReceipt)
    cheng_held_exec_parent_session_digest_store(
        chengHeldExecParentDigestObservedOutput,
        slot,
        observedOutputDigest)
    cheng_held_exec_parent_session_u64_store(
        chengHeldExecParentArenaOutputBytesOffset,
        slot,
        observedOutputBytes)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaTerminalExitOffset, slot, terminalExit)
    cheng_held_exec_parent_session_store(
        slot, chengHeldExecParentSessionFinished)
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(projection, 0, childIdentity)
    cheng_held_exec_wire_put_digest(projection, 32, terminalReceipt)
    cheng_held_exec_wire_put_digest(projection, 64, observedOutputDigest)
    let childIdentity0 = cheng_held_exec_wire_get_u64(projection, 0)
    let childIdentity1 = cheng_held_exec_wire_get_u64(projection, 8)
    let childIdentity2 = cheng_held_exec_wire_get_u64(projection, 16)
    let childIdentity3 = cheng_held_exec_wire_get_u64(projection, 24)
    let terminalReceipt0 = cheng_held_exec_wire_get_u64(projection, 32)
    let terminalReceipt1 = cheng_held_exec_wire_get_u64(projection, 40)
    let terminalReceipt2 = cheng_held_exec_wire_get_u64(projection, 48)
    let terminalReceipt3 = cheng_held_exec_wire_get_u64(projection, 56)
    let observedOutput0 = cheng_held_exec_wire_get_u64(projection, 64)
    let observedOutput1 = cheng_held_exec_wire_get_u64(projection, 72)
    let observedOutput2 = cheng_held_exec_wire_get_u64(projection, 80)
    let observedOutput3 = cheng_held_exec_wire_get_u64(projection, 88)
    return ChengHeldExecParentRunResult(
        status: 1,
        exitCode: terminalExit,
        outputBytes: observedOutputBytes,
        childIdentity0: childIdentity0,
        childIdentity1: childIdentity1,
        childIdentity2: childIdentity2,
        childIdentity3: childIdentity3,
        terminalReceipt0: terminalReceipt0,
        terminalReceipt1: terminalReceipt1,
        terminalReceipt2: terminalReceipt2,
        terminalReceipt3: terminalReceipt3,
        observedOutput0: observedOutput0,
        observedOutput1: observedOutput1,
        observedOutput2: observedOutput2,
        observedOutput3: observedOutput3)

fn cheng_held_exec_finished_upload_read_exact(
        fd: int32,
        destination: ptr,
        byteCount: int32): bool =
    if fd < 0 || destination == nil || byteCount < 0:
        return false
    var offset: int32
    while offset < byteCount:
        let amount = libc_read_runtime(
            fd,
            cheng_ptr_plus(destination, offset),
            byteCount - offset)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) || amount > int64(byteCount - offset):
            return false
        offset = offset + int32(amount)
    return offset == byteCount

@borrows
fn cheng_held_exec_finished_upload_header_get_u64(
        header: ChengHeldExecFinishedUploadHeader,
        offset: int32): uint64 =
    if offset < 0 || offset > chengHeldExecFinishedUploadHeaderBytes - 8:
        return uint64(0)
    var out: uint64
    for byteIndex in 0..<8:
        out = out |
            (uint64(header.data[offset + byteIndex]) <<
             uint64(byteIndex * 8))
    return out

@borrows
fn cheng_held_exec_finished_upload_header_get_digest(
        header: ChengHeldExecFinishedUploadHeader,
        offset: int32): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    if offset < 0 || offset > chengHeldExecFinishedUploadHeaderBytes - 32:
        return out
    for byteIndex in 0..<32:
        out.data[byteIndex] = header.data[offset + byteIndex]
    return out

fn cheng_held_exec_digest_from_u64x4(
        value0: uint64,
        value1: uint64,
        value2: uint64,
        value3: uint64): ChengFixedBytes32 =
    var wire: ChengHeldExecWire
    cheng_held_exec_wire_zero(wire)
    cheng_held_exec_wire_put_u64(wire, 0, value0)
    cheng_held_exec_wire_put_u64(wire, 8, value1)
    cheng_held_exec_wire_put_u64(wire, 16, value2)
    cheng_held_exec_wire_put_u64(wire, 24, value3)
    return cheng_held_exec_wire_get_digest(wire, 0)

fn cheng_held_exec_finished_wires_exact_equal(
        left: var ChengHeldExecWire,
        right: var ChengHeldExecWire): bool =
    for byteIndex in 0..<chengHeldExecWireBytes:
        if left.data[byteIndex] != right.data[byteIndex]:
            return false
    return true

# A complete upload is the FINISHED authority.  This first pass derives the
# immutable terminal projection without a socket frame or output descriptor;
# the streaming pass below then verifies the plan, compile receipt, output
# bytes and full upload digest from the same inode.
fn cheng_held_exec_finished_upload_projection_into(
        finishedReader: int32,
        sessionSlot: int32,
        outTerminal: var ChengHeldExecWire,
        outResult: var ChengHeldExecParentRunResult): int32 =
    cheng_held_exec_wire_zero(outTerminal)
    outResult = cheng_held_exec_parent_result_error(
        chengHeldExecParentErrTerminalMissing)
    let ready = cheng_held_exec_finished_upload_probe_ready(finishedReader)
    if ready <= 0:
        return ready
    var totalSize: int64
    var mode: int32
    var device: uint64
    var inode: uint64
    var header: ChengHeldExecFinishedUploadHeader
    var terminal: ChengHeldExecWire
    if sessionSlot < 0 ||
       libc_fstat_scalars_runtime(
           finishedReader, &totalSize, &mode, &device, &inode) != 0 ||
       libc_lseek_runtime(
           finishedReader, int64(0), chengHeldExecSeekSet) != int64(0) ||
       !cheng_held_exec_finished_upload_read_exact(
           finishedReader,
           ptr(&header),
           chengHeldExecFinishedUploadHeaderBytes) ||
       !cheng_held_exec_finished_upload_read_exact(
           finishedReader, ptr(&terminal), chengHeldExecWireBytes):
        return -1
    let totalBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 16)
    let compileOffset =
        cheng_held_exec_finished_upload_header_get_u64(header, 56)
    let compileBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 64)
    let outputOffset =
        cheng_held_exec_finished_upload_header_get_u64(header, 72)
    let outputBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 80)
    let terminalExit = int32(
        cheng_held_exec_finished_upload_header_get_u64(header, 88) &
        uint64(0xffffffff))
    let expectedCompileOffset = uint64(
        chengHeldExecFinishedUploadHeaderBytes +
        chengHeldExecWireBytes +
        chengHeldExecPlanEvidenceByteCount)
    let planEvidenceReceipt =
        cheng_held_exec_wire_get_digest(terminal, 416)
    let claimedPlanReceipt =
        cheng_held_exec_wire_get_digest(terminal, 128)
    let planReceipt = cheng_held_exec_plan_binding_receipt(
        planEvidenceReceipt,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, sessionSlot),
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestOwnerClaim, sessionSlot))
    let claimedTerminalReceipt =
        cheng_held_exec_wire_get_digest(terminal, 256)
    var receiptProjection = terminal
    cheng_held_exec_wire_put_digest(
        receiptProjection, 256, ChengFixedBytes32())
    let terminalReceipt = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.finished_receipt.v2", receiptProjection)
    let outputDigest =
        cheng_held_exec_wire_get_digest(terminal, 160)
    let outputPathDigest =
        cheng_held_exec_wire_get_digest(terminal, 288)
    let outputVerityDigest =
        cheng_held_exec_wire_get_digest(terminal, 320)
    let outputIdentityDigest =
        cheng_held_exec_wire_get_digest(terminal, 352)
    var childIdentityWire: ChengHeldExecWire
    cheng_held_exec_wire_zero(childIdentityWire)
    cheng_held_exec_wire_put_digest(
        childIdentityWire,
        0,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, sessionSlot))
    cheng_held_exec_wire_put_digest(
        childIdentityWire,
        32,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestExecutable, sessionSlot))
    let childIdentity = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.child_identity.v2", childIdentityWire)
    if totalBytes != uint64(totalSize) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 0) !=
           chengHeldExecFinishedUploadMagic ||
       cheng_held_exec_finished_upload_header_get_u64(header, 8) !=
           chengHeldExecFinishedUploadVersion ||
       cheng_held_exec_finished_upload_header_get_u64(header, 24) !=
           uint64(chengHeldExecFinishedUploadHeaderBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 32) !=
           uint64(chengHeldExecWireBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 40) !=
           uint64(chengHeldExecFinishedUploadHeaderBytes +
                  chengHeldExecWireBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 48) !=
           uint64(chengHeldExecPlanEvidenceByteCount) ||
       compileOffset != expectedCompileOffset ||
       compileBytes > uint64(1048576) ||
       outputOffset != compileOffset + compileBytes ||
       outputOffset + outputBytes != totalBytes ||
       terminalExit < 0 || terminalExit > 255 ||
       (terminalExit == 0 &&
        (compileBytes == uint64(0) || outputBytes == uint64(0) ||
         !cheng_held_exec_digest_nonzero(outputDigest) ||
         !cheng_held_exec_digest_nonzero(outputVerityDigest) ||
         !cheng_held_exec_digest_nonzero(outputIdentityDigest))) ||
       (terminalExit != 0 && outputBytes != uint64(0)) ||
       !cheng_held_exec_wire_header_valid(
           terminal,
           chengHeldExecKindFinished,
           uint64(3),
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestNonce, sessionSlot)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 64),
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestClaim, sessionSlot)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 96),
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestOwnerClaim, sessionSlot)) ||
       !cheng_held_exec_digest_nonzero(planReceipt) ||
       !cheng_fixed32_equal(planReceipt, claimedPlanReceipt) ||
       !cheng_fixed32_equal(terminalReceipt, claimedTerminalReceipt) ||
       !cheng_fixed32_equal(
           outputPathDigest,
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestOutputPath, sessionSlot)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 448),
           childIdentity) ||
       cheng_held_exec_wire_get_u64(terminal, 384) != outputBytes ||
       int32(cheng_held_exec_wire_get_u64(terminal, 392) &
             uint64(0xffffffff)) != terminalExit ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 96),
           terminalReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 128),
           planEvidenceReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 160),
           cheng_held_exec_wire_get_digest(terminal, 192)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 192),
           outputDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 224),
           cheng_held_exec_wire_get_digest(terminal, 224)):
        return -1
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(projection, 0, childIdentity)
    cheng_held_exec_wire_put_digest(projection, 32, terminalReceipt)
    cheng_held_exec_wire_put_digest(projection, 64, outputDigest)
    outTerminal = terminal
    outResult = ChengHeldExecParentRunResult(
        status: 1,
        exitCode: terminalExit,
        outputBytes: outputBytes,
        childIdentity0: cheng_held_exec_wire_get_u64(projection, 0),
        childIdentity1: cheng_held_exec_wire_get_u64(projection, 8),
        childIdentity2: cheng_held_exec_wire_get_u64(projection, 16),
        childIdentity3: cheng_held_exec_wire_get_u64(projection, 24),
        terminalReceipt0: cheng_held_exec_wire_get_u64(projection, 32),
        terminalReceipt1: cheng_held_exec_wire_get_u64(projection, 40),
        terminalReceipt2: cheng_held_exec_wire_get_u64(projection, 48),
        terminalReceipt3: cheng_held_exec_wire_get_u64(projection, 56),
        observedOutput0: cheng_held_exec_wire_get_u64(projection, 64),
        observedOutput1: cheng_held_exec_wire_get_u64(projection, 72),
        observedOutput2: cheng_held_exec_wire_get_u64(projection, 80),
        observedOutput3: cheng_held_exec_wire_get_u64(projection, 88))
    return 1

@borrows
fn cheng_held_exec_plan_evidence_canonical_valid(
        evidence: ChengHeldExecPlanEvidenceCanonical,
        expectedDigest: ChengFixedBytes32): bool =
    if evidence.data[0] != uint8(int32('C')) ||
       evidence.data[1] != uint8(int32('S')) ||
       evidence.data[2] != uint8(int32('P')) ||
       evidence.data[3] != uint8(int32('1')):
        return false
    var rebuilt: ChengHeldExecPlanEvidenceCanonical
    rebuilt.data[0] = uint8(int32('C'))
    rebuilt.data[1] = uint8(int32('S'))
    rebuilt.data[2] = uint8(int32('P'))
    rebuilt.data[3] = uint8(int32('1'))
    for fieldIndex in 0..<9:
        let fieldOffset = 4 + fieldIndex * chengHeldExecPlanEvidenceCidBytes
        if evidence.data[fieldOffset] != uint8(int32('s')) ||
           evidence.data[fieldOffset + 1] != uint8(int32('h')) ||
           evidence.data[fieldOffset + 2] != uint8(int32('a')) ||
           evidence.data[fieldOffset + 3] != uint8(int32('2')) ||
           evidence.data[fieldOffset + 4] != uint8(int32('5')) ||
           evidence.data[fieldOffset + 5] != uint8(int32('6')) ||
           evidence.data[fieldOffset + 6] != uint8(int32(':')):
            return false
        for cidByteIndex in 0..<chengHeldExecPlanEvidenceCidBytes:
            rebuilt.data[fieldOffset + cidByteIndex] =
                evidence.data[fieldOffset + cidByteIndex]
        for hexIndex in 0..<64:
            let code = int32(evidence.data[fieldOffset + 7 + hexIndex])
            if !((code >= int32('0') && code <= int32('9')) ||
                 (code >= int32('a') && code <= int32('f'))):
                return false
    for byteIndex in 0..<chengHeldExecPlanEvidenceByteCount:
        if rebuilt.data[byteIndex] != evidence.data[byteIndex]:
            return false
    var observedDigest: ChengFixedBytes32
    let domainLength = cheng_str_len(chengHeldExecPlanEvidenceDomain)
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    return domainLength > 0 &&
        cheng_sha256_stream_init_fixed(
            &stream,
            &stateStorage.data[0],
            &tableStorage.data[0],
            &blockStorage.data[0]) &&
        cheng_sha256_stream_update_u32le(&stream, domainLength) &&
        cheng_sha256_stream_update(
            &stream,
            cheng_str_data(chengHeldExecPlanEvidenceDomain),
            int64(domainLength)) &&
        cheng_sha256_stream_update_u32le(
            &stream, chengHeldExecPlanEvidenceByteCount) &&
        cheng_sha256_stream_update(
            &stream,
            ptr(&evidence),
            int64(chengHeldExecPlanEvidenceByteCount)) &&
        cheng_sha256_stream_finish(
            &stream, &observedDigest.data[0]) &&
        cheng_fixed32_equal(observedDigest, expectedDigest)

fn cheng_held_exec_compile_receipt_canonical_shape_valid(
        canonical: ptr,
        byteCount: int32,
        expectedReceipt: ChengFixedBytes32): bool =
    if canonical == nil || byteCount <= 0 || byteCount > int32(1048576):
        return false
    let key: ptr = "receipt_cid="
    let keyBytes: int32 = 12
    var receiptRows: int32
    var rowStart: int32
    for index in 0..<byteCount:
        let code = int32(*(UInt8Ptr(cheng_ptr_plus(canonical, index))))
        if code == 0 || (code < 32 && code != 10) || code == 127:
            return false
        if index == byteCount - 1 || code == 10:
            let rowEnd = code == 10 ? index : index + 1
            if rowEnd - rowStart == keyBytes + 64:
                var keyMatches = true
                for keyIndex in 0..<keyBytes:
                    if *(UInt8Ptr(cheng_ptr_plus(
                           canonical, rowStart + keyIndex))) !=
                       *(UInt8Ptr(cheng_ptr_plus(key, keyIndex))):
                        keyMatches = false
                if keyMatches:
                    receiptRows = receiptRows + 1
                    for digestIndex in 0..<32:
                        let value = int32(expectedReceipt.data[digestIndex])
                        if *(UInt8Ptr(cheng_ptr_plus(
                               canonical,
                               rowStart + keyBytes + digestIndex * 2))) !=
                               cheng_sha256_expected_hex_byte(
                                   (value >> 4) & 15) ||
                           *(UInt8Ptr(cheng_ptr_plus(
                               canonical,
                               rowStart + keyBytes + digestIndex * 2 + 1))) !=
                               cheng_sha256_expected_hex_byte(value & 15):
                            return false
            rowStart = index + 1
    return receiptRows == 1

@borrows
fn cheng_held_exec_finished_upload_strict_readback(
        finishedReader: int32,
        sessionSlot: int32,
        runtimeResult: ChengHeldExecParentRunResult,
        outUploadDigest: var ChengFixedBytes32,
        outCompileReceiptCanonical: var str): bool =
    outUploadDigest = ChengFixedBytes32()
    outCompileReceiptCanonical = cheng_str_empty()
    var totalSize: int64
    var mode: int32
    var device: uint64
    var inode: uint64
    if finishedReader < 0 || sessionSlot < 0 ||
       runtimeResult.status != 1 ||
       libc_fstat_scalars_runtime(
           finishedReader,
           &totalSize,
           &mode,
           &device,
           &inode) != 0 ||
       totalSize < int64(
           chengHeldExecFinishedUploadHeaderBytes +
           chengHeldExecWireBytes +
           chengHeldExecPlanEvidenceByteCount) ||
       totalSize > int64(2147483647) ||
       (mode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       device == uint64(0) || inode == uint64(0) ||
       libc_lseek_runtime(
           finishedReader, int64(0), chengHeldExecSeekSet) != int64(0):
        return false
    var header: ChengHeldExecFinishedUploadHeader
    var terminal: ChengHeldExecWire
    var planEvidence: ChengHeldExecPlanEvidenceCanonical
    if !cheng_held_exec_finished_upload_read_exact(
           finishedReader,
           ptr(&header),
           chengHeldExecFinishedUploadHeaderBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 0) !=
           chengHeldExecFinishedUploadMagic ||
       cheng_held_exec_finished_upload_header_get_u64(header, 8) !=
           chengHeldExecFinishedUploadVersion ||
       cheng_held_exec_finished_upload_header_get_u64(header, 16) !=
           uint64(totalSize) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 24) !=
           uint64(chengHeldExecFinishedUploadHeaderBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 32) !=
           uint64(chengHeldExecWireBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 40) !=
           uint64(chengHeldExecFinishedUploadHeaderBytes +
                  chengHeldExecWireBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 48) !=
           uint64(chengHeldExecPlanEvidenceByteCount):
        return false
    let compileOffset =
        cheng_held_exec_finished_upload_header_get_u64(header, 56)
    let compileBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 64)
    let outputOffset =
        cheng_held_exec_finished_upload_header_get_u64(header, 72)
    let outputBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 80)
    let terminalExit = int32(
        cheng_held_exec_finished_upload_header_get_u64(header, 88) &
        uint64(0xffffffff))
    let expectedCompileOffset = uint64(
        chengHeldExecFinishedUploadHeaderBytes +
        chengHeldExecWireBytes +
        chengHeldExecPlanEvidenceByteCount)
    if compileOffset != expectedCompileOffset ||
       compileBytes > uint64(1048576) ||
       outputOffset != compileOffset + compileBytes ||
       outputOffset + outputBytes != uint64(totalSize) ||
       outputBytes != runtimeResult.outputBytes ||
       terminalExit != runtimeResult.exitCode ||
       (terminalExit == 0 && (compileBytes == uint64(0) ||
                             outputBytes == uint64(0))) ||
       !cheng_held_exec_finished_upload_read_exact(
           finishedReader, ptr(&terminal), chengHeldExecWireBytes) ||
       !cheng_held_exec_finished_upload_read_exact(
           finishedReader,
           ptr(&planEvidence),
           chengHeldExecPlanEvidenceByteCount):
        return false
    let expectedTerminalReceipt = cheng_held_exec_digest_from_u64x4(
        runtimeResult.terminalReceipt0,
        runtimeResult.terminalReceipt1,
        runtimeResult.terminalReceipt2,
        runtimeResult.terminalReceipt3)
    let expectedOutputDigest = cheng_held_exec_digest_from_u64x4(
        runtimeResult.observedOutput0,
        runtimeResult.observedOutput1,
        runtimeResult.observedOutput2,
        runtimeResult.observedOutput3)
    let expectedChildIdentity = cheng_held_exec_digest_from_u64x4(
        runtimeResult.childIdentity0,
        runtimeResult.childIdentity1,
        runtimeResult.childIdentity2,
        runtimeResult.childIdentity3)
    let planEvidenceDigest =
        cheng_held_exec_wire_get_digest(terminal, 416)
    let expectedPlanReceipt = cheng_held_exec_plan_binding_receipt(
        planEvidenceDigest,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, sessionSlot),
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestOwnerClaim, sessionSlot))
    let compileReceiptDigest =
        cheng_held_exec_wire_get_digest(terminal, 192)
    if !cheng_held_exec_wire_header_valid(
           terminal,
           chengHeldExecKindFinished,
           uint64(3),
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestNonce, sessionSlot)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 64),
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestClaim, sessionSlot)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 96),
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestOwnerClaim, sessionSlot)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 128),
           expectedPlanReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 160),
           expectedOutputDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 256),
           expectedTerminalReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(terminal, 448),
           expectedChildIdentity) ||
       cheng_held_exec_wire_get_u64(terminal, 384) != outputBytes ||
       int32(cheng_held_exec_wire_get_u64(terminal, 392) &
             uint64(0xffffffff)) != terminalExit ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 96),
           expectedTerminalReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 128),
           planEvidenceDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 160),
           compileReceiptDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 192),
           expectedOutputDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 224),
           cheng_held_exec_wire_get_digest(terminal, 224)) ||
       !cheng_held_exec_plan_evidence_canonical_valid(
           planEvidence, planEvidenceDigest):
        return false
    var compileRaw = compileBytes > uint64(0) ?
        cheng_malloc_export(int32(compileBytes)) : nil
    if compileBytes > uint64(0) &&
       (compileRaw == nil ||
        !cheng_held_exec_finished_upload_read_exact(
            finishedReader, compileRaw, int32(compileBytes)) ||
        !cheng_held_exec_compile_receipt_canonical_shape_valid(
            compileRaw, int32(compileBytes), compileReceiptDigest)):
        if compileRaw != nil:
            cheng_free_export(compileRaw)
        return false
    var outputDigest: ChengFixedBytes32
    var outputStream: ChengSha256StreamState
    var outputState: ChengAllocationLedgerHashState
    var outputTable: ChengAllocationLedgerHashTable
    var outputTail: ChengAllocationLedgerHashTail
    var outputRemaining = outputBytes
    var outputBuffer: uint8[65536]
    var outputValid = outputBytes == uint64(0) ||
        cheng_sha256_stream_init_fixed(
            &outputStream,
            &outputState.data[0],
            &outputTable.data[0],
            &outputTail.data[0])
    while outputValid && outputRemaining > uint64(0):
        var want = outputRemaining
        if want > uint64(65536):
            want = uint64(65536)
        let amount = libc_read_runtime(
            finishedReader, ptr(&outputBuffer), int32(want))
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) || amount > int64(want) ||
           !cheng_sha256_stream_update(
               &outputStream, ptr(&outputBuffer), amount):
            outputValid = false
        else:
            outputRemaining = outputRemaining - uint64(amount)
    if outputBytes > uint64(0):
        outputValid = outputValid && outputRemaining == uint64(0) &&
            cheng_sha256_stream_finish(
                &outputStream, &outputDigest.data[0]) &&
            cheng_fixed32_equal(outputDigest, expectedOutputDigest)
    elif !cheng_fixed32_equal(
             expectedOutputDigest, ChengFixedBytes32()):
        outputValid = false
    var extra: uint8[1]
    if !outputValid ||
       libc_read_runtime(finishedReader, ptr(&extra), 1) != int64(0):
        if compileRaw != nil:
            cheng_free_export(compileRaw)
        return false
    var uploadBytes: uint64
    if !cheng_held_exec_fd_content_digest_into(
           finishedReader, outUploadDigest, uploadBytes) ||
       uploadBytes != uint64(totalSize):
        if compileRaw != nil:
            cheng_free_export(compileRaw)
        return false
    if compileRaw != nil:
        outCompileReceiptCanonical = cheng_str_view_owned(
            compileRaw, int32(compileBytes))
        compileRaw = nil
    return true

fn cheng_held_exec_finished_recovery_canonical_zero(
        out: var ChengHeldExecFinishedRecoveryCanonical) =
    for byteIndex in 0..<352:
        out.data[byteIndex] = uint8(0)

fn cheng_held_exec_finished_recovery_canonical_put_u64(
        out: var ChengHeldExecFinishedRecoveryCanonical,
        offset: int32,
        value: uint64) =
    if offset < 0 || offset > 312:
        return
    for byteIndex in 0..<8:
        out.data[offset + byteIndex] = uint8(
            (value >> uint64(byteIndex * 8)) & uint64(255))

@borrows
fn cheng_held_exec_finished_recovery_canonical_put_digest(
        out: var ChengHeldExecFinishedRecoveryCanonical,
        offset: int32,
        digest: ChengFixedBytes32) =
    if offset < 0 || offset > 320:
        return
    for byteIndex in 0..<32:
        out.data[offset + byteIndex] = digest.data[byteIndex]

fn cheng_held_exec_finished_sync_writer_try_close_proof(
        syncWriter: int32): int32 =
    if syncWriter < 0:
        return -1
    if libc_flock_runtime(
           syncWriter,
           chengAtomicTreeFlockExclusiveNonblocking) == 0:
        return 1
    let errorCode = native_cheng_errno_code_runtime()
    if (cheng_host_is_darwin() && errorCode == 35) ||
       (!cheng_host_is_darwin() && errorCode == 11):
        return 0
    return -1

fn cheng_held_exec_finished_recovery_strict_into(
        finishedReader: int32,
        outCanonical: var ChengHeldExecFinishedRecoveryCanonical,
        outCompileReceiptCanonical: var str): int32 =
    cheng_held_exec_finished_recovery_canonical_zero(outCanonical)
    outCompileReceiptCanonical = cheng_str_empty()
    var totalSize: int64
    var mode: int32
    var device: uint64
    var inode: uint64
    if finishedReader < 0 ||
       libc_fstat_scalars_runtime(
           finishedReader, &totalSize, &mode, &device, &inode) != 0 ||
       totalSize > int64(2147483647) ||
       (mode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       device == uint64(0) || inode == uint64(0) ||
       libc_lseek_runtime(
           finishedReader, int64(0), chengHeldExecSeekSet) != int64(0):
        return chengHeldExecFinishedRecoveryInvalid
    if totalSize < int64(
           chengHeldExecFinishedUploadHeaderBytes +
           chengHeldExecWireBytes +
           chengHeldExecPlanEvidenceByteCount):
        return chengHeldExecFinishedRecoveryNotReady
    var header: ChengHeldExecFinishedUploadHeader
    var terminal: ChengHeldExecWire
    var planEvidence: ChengHeldExecPlanEvidenceCanonical
    if !cheng_held_exec_finished_upload_read_exact(
           finishedReader,
           ptr(&header),
           chengHeldExecFinishedUploadHeaderBytes) ||
       !cheng_held_exec_finished_upload_read_exact(
           finishedReader, ptr(&terminal), chengHeldExecWireBytes) ||
       !cheng_held_exec_finished_upload_read_exact(
           finishedReader,
           ptr(&planEvidence),
           chengHeldExecPlanEvidenceByteCount):
        return chengHeldExecFinishedRecoveryInvalid
    let totalBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 16)
    let compileOffset =
        cheng_held_exec_finished_upload_header_get_u64(header, 56)
    let compileBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 64)
    let outputOffset =
        cheng_held_exec_finished_upload_header_get_u64(header, 72)
    let outputBytes =
        cheng_held_exec_finished_upload_header_get_u64(header, 80)
    let terminalExit = int32(
        cheng_held_exec_finished_upload_header_get_u64(header, 88) &
        uint64(0xffffffff))
    let expectedCompileOffset = uint64(
        chengHeldExecFinishedUploadHeaderBytes +
        chengHeldExecWireBytes +
        chengHeldExecPlanEvidenceByteCount)
    let nonce = cheng_held_exec_wire_get_digest(terminal, 32)
    let claimReceipt = cheng_held_exec_wire_get_digest(terminal, 64)
    let ownerClaimReceipt = cheng_held_exec_wire_get_digest(terminal, 96)
    let claimedPlanReceipt = cheng_held_exec_wire_get_digest(terminal, 128)
    let outputDigest = cheng_held_exec_wire_get_digest(terminal, 160)
    let compileReceiptDigest =
        cheng_held_exec_wire_get_digest(terminal, 192)
    let claimedTerminalReceipt =
        cheng_held_exec_wire_get_digest(terminal, 256)
    let outputPathDigest = cheng_held_exec_wire_get_digest(terminal, 288)
    let outputVerityDigest = cheng_held_exec_wire_get_digest(terminal, 320)
    let outputIdentityDigest =
        cheng_held_exec_wire_get_digest(terminal, 352)
    let planEvidenceReceipt =
        cheng_held_exec_wire_get_digest(terminal, 416)
    let childIdentity = cheng_held_exec_wire_get_digest(terminal, 448)
    let planReceipt = cheng_held_exec_plan_binding_receipt(
        planEvidenceReceipt, claimReceipt, ownerClaimReceipt)
    var receiptProjection = terminal
    cheng_held_exec_wire_put_digest(
        receiptProjection, 256, ChengFixedBytes32())
    let terminalReceipt = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.finished_receipt.v2", receiptProjection)
    if cheng_held_exec_finished_upload_header_get_u64(header, 0) !=
           chengHeldExecFinishedUploadMagic ||
       cheng_held_exec_finished_upload_header_get_u64(header, 8) !=
           chengHeldExecFinishedUploadVersion ||
       cheng_held_exec_finished_upload_header_get_u64(header, 24) !=
           uint64(chengHeldExecFinishedUploadHeaderBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 32) !=
           uint64(chengHeldExecWireBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 40) !=
           uint64(chengHeldExecFinishedUploadHeaderBytes +
                  chengHeldExecWireBytes) ||
       cheng_held_exec_finished_upload_header_get_u64(header, 48) !=
           uint64(chengHeldExecPlanEvidenceByteCount) ||
       compileOffset != expectedCompileOffset ||
       compileBytes > uint64(1048576) ||
       outputOffset != compileOffset + compileBytes ||
       outputOffset + outputBytes != totalBytes ||
       terminalExit < 0 || terminalExit > 255 ||
       !cheng_held_exec_wire_header_valid(
           terminal, chengHeldExecKindFinished, uint64(3), nonce) ||
       !cheng_held_exec_digest_nonzero(claimReceipt) ||
       !cheng_held_exec_digest_nonzero(ownerClaimReceipt) ||
       !cheng_held_exec_digest_nonzero(planReceipt) ||
       !cheng_fixed32_equal(planReceipt, claimedPlanReceipt) ||
       !cheng_fixed32_equal(terminalReceipt, claimedTerminalReceipt) ||
       !cheng_held_exec_digest_nonzero(outputPathDigest) ||
       !cheng_held_exec_digest_nonzero(planEvidenceReceipt) ||
       !cheng_held_exec_digest_nonzero(childIdentity) ||
       cheng_held_exec_wire_get_u64(terminal, 384) != outputBytes ||
       int32(cheng_held_exec_wire_get_u64(terminal, 392) &
             uint64(0xffffffff)) != terminalExit ||
       (terminalExit == 0 &&
        (compileBytes == uint64(0) || outputBytes == uint64(0) ||
         !cheng_held_exec_digest_nonzero(outputDigest) ||
         !cheng_held_exec_digest_nonzero(compileReceiptDigest) ||
         !cheng_held_exec_digest_nonzero(outputVerityDigest) ||
         !cheng_held_exec_digest_nonzero(outputIdentityDigest))) ||
       (terminalExit != 0 && outputBytes != uint64(0)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 96),
           terminalReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 128),
           planEvidenceReceipt) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 160),
           compileReceiptDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 192),
           outputDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_finished_upload_header_get_digest(header, 224),
           cheng_held_exec_wire_get_digest(terminal, 224)) ||
       !cheng_held_exec_plan_evidence_canonical_valid(
           planEvidence, planEvidenceReceipt):
        return chengHeldExecFinishedRecoveryInvalid
    if totalBytes > uint64(totalSize):
        return chengHeldExecFinishedRecoveryNotReady
    if totalBytes != uint64(totalSize):
        return chengHeldExecFinishedRecoveryInvalid
    var compileRaw = compileBytes > uint64(0) ?
        cheng_malloc_export(int32(compileBytes)) : nil
    if compileBytes > uint64(0) &&
       (compileRaw == nil ||
        !cheng_held_exec_finished_upload_read_exact(
            finishedReader, compileRaw, int32(compileBytes)) ||
        !cheng_held_exec_compile_receipt_canonical_shape_valid(
            compileRaw, int32(compileBytes), compileReceiptDigest)):
        if compileRaw != nil:
            cheng_free_export(compileRaw)
        return chengHeldExecFinishedRecoveryInvalid
    var outputObserved: ChengFixedBytes32
    var outputStream: ChengSha256StreamState
    var outputState: ChengAllocationLedgerHashState
    var outputTable: ChengAllocationLedgerHashTable
    var outputTail: ChengAllocationLedgerHashTail
    var outputRemaining = outputBytes
    var outputBuffer: uint8[65536]
    var outputValid = outputBytes == uint64(0) ||
        cheng_sha256_stream_init_fixed(
            &outputStream,
            &outputState.data[0],
            &outputTable.data[0],
            &outputTail.data[0])
    while outputValid && outputRemaining > uint64(0):
        var want = outputRemaining
        if want > uint64(65536):
            want = uint64(65536)
        let amount = libc_read_runtime(
            finishedReader, ptr(&outputBuffer), int32(want))
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) || amount > int64(want) ||
           !cheng_sha256_stream_update(
               &outputStream, ptr(&outputBuffer), amount):
            outputValid = false
        else:
            outputRemaining = outputRemaining - uint64(amount)
    if outputBytes > uint64(0):
        outputValid = outputValid && outputRemaining == uint64(0) &&
            cheng_sha256_stream_finish(
                &outputStream, &outputObserved.data[0]) &&
            cheng_fixed32_equal(outputObserved, outputDigest)
    elif !cheng_fixed32_equal(outputDigest, ChengFixedBytes32()):
        outputValid = false
    var extra: uint8[1]
    var uploadDigest: ChengFixedBytes32
    var uploadByteCount: uint64
    if !outputValid ||
       libc_read_runtime(finishedReader, ptr(&extra), 1) != int64(0) ||
       !cheng_held_exec_fd_content_digest_into(
           finishedReader, uploadDigest, uploadByteCount) ||
       uploadByteCount != totalBytes:
        if compileRaw != nil:
            cheng_free_export(compileRaw)
        return chengHeldExecFinishedRecoveryInvalid
    cheng_held_exec_finished_recovery_canonical_zero(outCanonical)
    outCanonical.data[0] = uint8(int32('C'))
    outCanonical.data[1] = uint8(int32('F'))
    outCanonical.data[2] = uint8(int32('R'))
    outCanonical.data[3] = uint8(int32('1'))
    outCanonical.data[4] = uint8(2)
    cheng_held_exec_finished_recovery_canonical_put_u64(
        outCanonical, 8, uint64(uint32(terminalExit)))
    cheng_held_exec_finished_recovery_canonical_put_u64(
        outCanonical, 16, outputBytes)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 32, terminalReceipt)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 64, childIdentity)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 96, outputDigest)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 128, uploadDigest)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 160, planReceipt)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 192, planEvidenceReceipt)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 224, compileReceiptDigest)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 256, claimReceipt)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 288, ownerClaimReceipt)
    cheng_held_exec_finished_recovery_canonical_put_digest(
        outCanonical, 320, nonce)
    if compileRaw != nil:
        outCompileReceiptCanonical = cheng_str_view_owned(
            compileRaw, int32(compileBytes))
        compileRaw = nil
    return chengHeldExecFinishedRecoveryValid

@exportc("cheng_held_exec_finished_recovery_owner_take_canonical")
@abi_internal
@borrows
fn cheng_held_exec_finished_recovery_owner_take_canonical_export(
        recoveryOwner: int32,
        outProofCanonical: var str,
        outCompileReceiptCanonical: var str): int32 =
    outProofCanonical = cheng_str_empty()
    outCompileReceiptCanonical = cheng_str_empty()
    let row = recoveryOwner - 1
    if row < 0 || row >= chengHeldExecFinishedRecoveryOwnerCount:
        return 0
    cheng_runtime_lock()
    if row >= chengHeldExecFinishedRecoveryOwnerNextRow ||
       chengHeldExecFinishedRecoveryOwnerStates[row] !=
           chengHeldExecFinishedRecoveryOwnerIssued:
        cheng_runtime_unlock()
        return 0
    chengHeldExecFinishedRecoveryOwnerStates[row] =
        chengHeldExecFinishedRecoveryOwnerTaking
    let reader = chengHeldExecFinishedRecoveryOwnerReaders[row]
    let syncWriter =
        chengHeldExecFinishedRecoveryOwnerSyncWriters[row]
    let childPid = chengHeldExecFinishedRecoveryOwnerChildPids[row]
    let childBirthPlatform =
        chengHeldExecFinishedRecoveryOwnerChildBirthPlatforms[row]
    let childBirth0 = chengHeldExecFinishedRecoveryOwnerChildBirth0[row]
    let childBirth1 = chengHeldExecFinishedRecoveryOwnerChildBirth1[row]
    cheng_runtime_unlock()
    var proof: ChengHeldExecFinishedRecoveryCanonical
    var compileCanonical: str
    var strictStatus = cheng_held_exec_finished_recovery_strict_into(
        reader, proof, compileCanonical)
    var watchOwner: int32 = -1
    var waitFailed = false
    var writerClosed = false
    var synced = false
    if strictStatus != chengHeldExecFinishedRecoveryInvalid:
        # Recovery has no live socket.  Close the read-before-arm race on the
        # exact fixed inode and exact child birth owner even when the initial
        # bytes already look complete.  Page-cache equality before child
        # fdatasync is never a durable FINISHED authority.
        watchOwner = libc_terminal_finished_recovery_watch_arm_runtime(
            reader,
            childPid,
            childBirthPlatform,
            childBirth0,
            childBirth1)
        # Reread closes the arm race, but even VALID remains provisional
        # until the sync writer acquires the child OFD lock and fdatasyncs the
        # exact inode. A dead writer with non-VALID bytes is permanent INVALID.
        strictStatus = cheng_held_exec_finished_recovery_strict_into(
            reader, proof, compileCanonical)
        if watchOwner > 0:
            cheng_runtime_lock()
            chengHeldExecFinishedRecoveryOwnerWatchOwners[row] = watchOwner
            cheng_runtime_unlock()
        let closeProof =
            cheng_held_exec_finished_sync_writer_try_close_proof(
                syncWriter)
        writerClosed = closeProof == 1
        if closeProof < 0:
            waitFailed = true
        # The watcher only supplies a future wakeup.  If the child completed
        # and closed its writer inside the arm race, the immutable writer lock
        # plus our own fdatasync and final strict reread are sufficient; an
        # arm failure must not discard that already-complete authority.
        if watchOwner == -1 &&
           !(strictStatus == chengHeldExecFinishedRecoveryValid &&
             writerClosed):
            waitFailed = true
    while !writerClosed && !waitFailed &&
          strictStatus != chengHeldExecFinishedRecoveryInvalid:
        if watchOwner <= 0:
            strictStatus = chengHeldExecFinishedRecoveryInvalid
            break
        let eventKind = libc_terminal_decision_watch_wait_runtime(watchOwner)
        if eventKind != 2 && eventKind != 8:
            waitFailed = true
        else:
            strictStatus = cheng_held_exec_finished_recovery_strict_into(
                reader, proof, compileCanonical)
            let closeProof =
                cheng_held_exec_finished_sync_writer_try_close_proof(
                    syncWriter)
            writerClosed = closeProof == 1
            if closeProof < 0 || (eventKind == 8 && !writerClosed):
                waitFailed = closeProof < 0
                strictStatus = chengHeldExecFinishedRecoveryInvalid
    if writerClosed && !waitFailed:
        synced = libc_fdatasync_runtime(syncWriter) == 0
        strictStatus = synced ?
            cheng_held_exec_finished_recovery_strict_into(
                reader, proof, compileCanonical) :
            chengHeldExecFinishedRecoveryInvalid
    let watchClosed = watchOwner <= 0 ||
        libc_terminal_decision_watch_close_runtime(watchOwner) == 1
    let readerClosed =
        cheng_held_exec_finished_recovery_owner_close_fd_once(
            row, chengHeldExecRecoveryFdReader)
    let syncWriterClosed =
        cheng_held_exec_finished_recovery_owner_close_fd_once(
            row, chengHeldExecRecoveryFdSyncWriter)
    let complete =
        strictStatus == chengHeldExecFinishedRecoveryValid &&
        writerClosed && synced && !waitFailed && watchClosed &&
        readerClosed && syncWriterClosed
    let proofRaw = complete ? cheng_malloc_export(352) : nil
    cheng_runtime_lock()
    if watchClosed:
        chengHeldExecFinishedRecoveryOwnerWatchOwners[row] = -1
    chengHeldExecFinishedRecoveryOwnerStates[row] =
        complete && proofRaw != nil ?
            chengHeldExecFinishedRecoveryOwnerConsumed :
            ((readerClosed && syncWriterClosed && watchClosed) ?
                chengHeldExecFinishedRecoveryOwnerAborted :
                chengHeldExecFinishedRecoveryOwnerRecoveryRequired)
    cheng_runtime_unlock()
    if !complete || proofRaw == nil:
        return 0
    cheng_bytes_copy(proofRaw, ptr(&proof), 352)
    var ownedProof = cheng_str_view_owned(proofRaw, 352)
    cheng_str_store_slot(ptr(&outProofCanonical), ownedProof)
    cheng_str_dispose(ownedProof)
    cheng_str_store_slot(ptr(&outCompileReceiptCanonical), compileCanonical)
    cheng_str_dispose(compileCanonical)
    return 1

@borrows
fn cheng_held_exec_finished_socket_frame_valid(
        socketTerminal: var ChengHeldExecWire,
        uploadTerminal: var ChengHeldExecWire,
        outputFd: int32,
        outputPath: str): bool =
    if !cheng_held_exec_finished_wires_exact_equal(
           socketTerminal, uploadTerminal):
        if outputFd >= 0:
            let _closeMismatchedOutput = libc_close(outputFd)
        return false
    let terminalExit = int32(
        cheng_held_exec_wire_get_u64(uploadTerminal, 392) &
        uint64(0xffffffff))
    if terminalExit != 0:
        if outputFd >= 0:
            let _closeUnexpectedOutput = libc_close(outputFd)
            return false
        return true
    var observedDigest: ChengFixedBytes32
    var observedVerity: ChengFixedBytes32
    var observedIdentity: ChengFixedBytes32
    var observedBytes: uint64
    let valid = outputFd >= 0 &&
        cheng_held_exec_named_output_matches(outputFd, outputPath) &&
        cheng_held_exec_fd_content_digest_into(
            outputFd, observedDigest, observedBytes) &&
        observedBytes == cheng_held_exec_wire_get_u64(
            uploadTerminal, 384) &&
        cheng_fixed32_equal(
            observedDigest,
            cheng_held_exec_wire_get_digest(uploadTerminal, 160)) &&
        cheng_linux_fsverity_measure_sha256_runtime(
            outputFd, &observedVerity.data[0]) == 0 &&
        cheng_fixed32_equal(
            observedVerity,
            cheng_held_exec_wire_get_digest(uploadTerminal, 320)) &&
        cheng_held_exec_file_identity_digest(
            outputFd, observedIdentity) &&
        cheng_fixed32_equal(
            observedIdentity,
            cheng_held_exec_wire_get_digest(uploadTerminal, 352))
    let closed = outputFd < 0 || libc_close(outputFd) == 0
    return valid && closed

fn cheng_held_exec_parent_publish_upload_result(
        sessionSlot: int32,
        uploadTerminal: var ChengHeldExecWire,
        runtimeResult: ChengHeldExecParentRunResult): bool =
    if sessionSlot < 0 || runtimeResult.status != 1:
        return false
    let planReceipt =
        cheng_held_exec_wire_get_digest(uploadTerminal, 128)
    let terminalReceipt = cheng_held_exec_digest_from_u64x4(
        runtimeResult.terminalReceipt0,
        runtimeResult.terminalReceipt1,
        runtimeResult.terminalReceipt2,
        runtimeResult.terminalReceipt3)
    let outputDigest = cheng_held_exec_digest_from_u64x4(
        runtimeResult.observedOutput0,
        runtimeResult.observedOutput1,
        runtimeResult.observedOutput2,
        runtimeResult.observedOutput3)
    if !cheng_held_exec_digest_nonzero(planReceipt) ||
       !cheng_held_exec_digest_nonzero(terminalReceipt) ||
       (runtimeResult.exitCode == 0 &&
        !cheng_held_exec_digest_nonzero(outputDigest)):
        return false
    cheng_held_exec_parent_session_digest_store(
        chengHeldExecParentDigestPlan, sessionSlot, planReceipt)
    cheng_held_exec_parent_session_digest_store(
        chengHeldExecParentDigestTerminal, sessionSlot, terminalReceipt)
    cheng_held_exec_parent_session_digest_store(
        chengHeldExecParentDigestObservedOutput, sessionSlot, outputDigest)
    cheng_held_exec_parent_session_u64_store(
        chengHeldExecParentArenaOutputBytesOffset,
        sessionSlot,
        runtimeResult.outputBytes)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaTerminalExitOffset,
        sessionSlot,
        runtimeResult.exitCode)
    cheng_held_exec_parent_session_store(
        sessionSlot, chengHeldExecParentSessionFinished)
    return true

@exportc("cheng_held_exec_parent_finish_capsule_owner")
@abi_internal
@borrows
fn cheng_held_exec_parent_finish_capsule_owner_export(
        handle: int32,
        providerRoleOwner: int32,
        outputPath: str): int32 =
    let roleRow = providerRoleOwner - 1
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount:
        return -1
    cheng_runtime_lock()
    if roleRow >= chengHeldExecCapsuleProviderRoleNextRow ||
       chengHeldExecCapsuleProviderRoleStates[roleRow] !=
           chengHeldExecCapsuleProviderRoleActive ||
       chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow] != handle:
        cheng_runtime_unlock()
        return -1
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleReadingFinished
    let finishedReader =
        chengHeldExecCapsuleProviderRoleFinishedReaders[roleRow]
    let finishedWatchOwner =
        chengHeldExecCapsuleProviderRoleFinishedWatchOwners[roleRow]
    cheng_runtime_unlock()
    var sessionSlot: int32
    if !cheng_held_exec_parent_session_resolve(handle, sessionSlot) ||
       !cheng_held_exec_parent_session_cas(
           sessionSlot,
           chengHeldExecParentSessionActivated,
           chengHeldExecParentSessionReceiving):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return -1
    var suppliedOutputPathDigest: ChengFixedBytes32
    if finishedWatchOwner <= 0 ||
       cheng_os_is_absolute_bridge_export(outputPath) != 1 ||
       !cheng_held_exec_output_path_digest_into(
           outputPath, suppliedOutputPathDigest) ||
       !cheng_fixed32_equal(
           suppliedOutputPathDigest,
           cheng_held_exec_parent_session_digest_load(
               chengHeldExecParentDigestOutputPath, sessionSlot)):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return -1
    var uploadTerminal: ChengHeldExecWire
    var runtimeResult: ChengHeldExecParentRunResult
    var uploadStatus = cheng_held_exec_finished_upload_projection_into(
        finishedReader, sessionSlot, uploadTerminal, runtimeResult)
    var socketSettled = false
    var waitFailed = uploadStatus < 0
    while (uploadStatus == 0 || !socketSettled) && !waitFailed:
        let eventKind = libc_terminal_decision_watch_wait_runtime(
            finishedWatchOwner)
        if eventKind == 1:
            if uploadStatus == 0:
                uploadStatus =
                    cheng_held_exec_finished_upload_projection_into(
                        finishedReader,
                        sessionSlot,
                        uploadTerminal,
                        runtimeResult)
            if uploadStatus != 1:
                waitFailed = true
            else:
                var socketTerminal: ChengHeldExecWire
                let received =
                    cheng_held_exec_receive_wire_with_optional_fd_from(
                        cheng_held_exec_parent_session_i32_load(
                            chengHeldExecParentArenaChannelFdOffset,
                            sessionSlot),
                        socketTerminal,
                        cheng_held_exec_parent_session_i32_load(
                            chengHeldExecParentArenaChildPidOffset,
                            sessionSlot),
                        cheng_held_exec_parent_session_u32_load(
                            chengHeldExecParentArenaChildUidOffset,
                            sessionSlot),
                        cheng_held_exec_parent_session_u32_load(
                            chengHeldExecParentArenaChildGidOffset,
                            sessionSlot))
                if received.status != 1:
                    if received.fd >= 0:
                        let _closeMalformedSocketOutput =
                            libc_close(received.fd)
                    waitFailed = true
                elif !cheng_held_exec_finished_socket_frame_valid(
                         socketTerminal,
                         uploadTerminal,
                         received.fd,
                         outputPath):
                    waitFailed = true
                else:
                    socketSettled = true
        elif eventKind == 2:
            let changedUploadStatus =
                cheng_held_exec_finished_upload_projection_into(
                    finishedReader,
                    sessionSlot,
                    uploadTerminal,
                    runtimeResult)
            # MODIFY/EXTEND can precede fdatasync and close.  The inode event
            # is only a wakeup: a partial strict projection stays not-ready.
            # FINISHED or socket EOF is the final malformed-upload boundary.
            uploadStatus = changedUploadStatus == 1 ? 1 : 0
        elif eventKind == 4:
            socketSettled = true
            uploadStatus =
                cheng_held_exec_finished_upload_projection_into(
                    finishedReader,
                    sessionSlot,
                    uploadTerminal,
                    runtimeResult)
            if uploadStatus < 0:
                waitFailed = true
        else:
            waitFailed = true
    let watchClosed = libc_terminal_decision_watch_close_runtime(
        finishedWatchOwner) == 1
    cheng_runtime_lock()
    if watchClosed:
        chengHeldExecCapsuleProviderRoleFinishedWatchOwners[roleRow] = -1
    cheng_runtime_unlock()
    var uploadDigest: ChengFixedBytes32
    var compileReceiptCanonical: str
    if waitFailed || !watchClosed || uploadStatus != 1 ||
       !cheng_held_exec_finished_upload_strict_readback(
           finishedReader,
           sessionSlot,
           runtimeResult,
           uploadDigest,
           compileReceiptCanonical) ||
       !cheng_held_exec_parent_publish_upload_result(
           sessionSlot, uploadTerminal, runtimeResult):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return -1
    let terminalReceipt = cheng_held_exec_digest_from_u64x4(
        runtimeResult.terminalReceipt0,
        runtimeResult.terminalReceipt1,
        runtimeResult.terminalReceipt2,
        runtimeResult.terminalReceipt3)
    let childIdentity = cheng_held_exec_digest_from_u64x4(
        runtimeResult.childIdentity0,
        runtimeResult.childIdentity1,
        runtimeResult.childIdentity2,
        runtimeResult.childIdentity3)
    let outputDigest = cheng_held_exec_digest_from_u64x4(
        runtimeResult.observedOutput0,
        runtimeResult.observedOutput1,
        runtimeResult.observedOutput2,
        runtimeResult.observedOutput3)
    cheng_runtime_lock()
    chengHeldExecCapsuleProviderRoleTerminalReceipts[roleRow] =
        terminalReceipt
    chengHeldExecCapsuleProviderRoleChildIdentities[roleRow] =
        childIdentity
    chengHeldExecCapsuleProviderRoleOutputDigests[roleRow] = outputDigest
    chengHeldExecCapsuleProviderRoleUploadDigests[roleRow] = uploadDigest
    chengHeldExecCapsuleProviderRoleCompileReceiptCanonicals[roleRow] =
        compileReceiptCanonical
    chengHeldExecCapsuleProviderRoleOutputBytes[roleRow] =
        runtimeResult.outputBytes
    chengHeldExecCapsuleProviderRoleExitCodes[roleRow] =
        runtimeResult.exitCode
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleFinished
    cheng_runtime_unlock()
    return providerRoleOwner

@exportc("cheng_held_exec_finished_compile_receipt_export_canonical")
@abi_internal
@borrows
fn cheng_held_exec_finished_compile_receipt_export_canonical_export(
        providerRoleOwner: int32,
        outCanonical: var str): int32 =
    outCanonical = cheng_str_empty()
    let roleRow = providerRoleOwner - 1
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount:
        return 0
    cheng_runtime_lock()
    if roleRow >= chengHeldExecCapsuleProviderRoleNextRow ||
       chengHeldExecCapsuleProviderRoleStates[roleRow] !=
           chengHeldExecCapsuleProviderRoleFinished:
        cheng_runtime_unlock()
        return 0
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleExportingCompileReceipt
    let stored =
        chengHeldExecCapsuleProviderRoleCompileReceiptCanonicals[roleRow]
    cheng_runtime_unlock()
    var owned = cheng_held_exec_owned_text_clone(stored)
    if cheng_str_len(owned) <= 0 ||
       cheng_str_len(owned) != cheng_str_len(stored):
        cheng_str_dispose(owned)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleCompileReceiptValidated
        cheng_runtime_unlock()
        return 0
    cheng_str_store_slot(ptr(&outCanonical), owned)
    cheng_str_dispose(owned)
    cheng_runtime_lock()
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleCompileReceiptValidated
    cheng_runtime_unlock()
    return 1

@exportc("cheng_held_exec_finished_proof_export_canonical")
@abi_internal
@borrows
fn cheng_held_exec_finished_proof_export_canonical_export(
        providerRoleOwner: int32,
        outCanonical: var str): int32 =
    outCanonical = cheng_str_empty()
    let roleRow = providerRoleOwner - 1
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount:
        return 0
    cheng_runtime_lock()
    if roleRow >= chengHeldExecCapsuleProviderRoleNextRow ||
       chengHeldExecCapsuleProviderRoleStates[roleRow] !=
           chengHeldExecCapsuleProviderRoleCompileReceiptValidated:
        cheng_runtime_unlock()
        return 0
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleExportingFinished
    let session =
        chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow]
    let terminalReceipt =
        chengHeldExecCapsuleProviderRoleTerminalReceipts[roleRow]
    let childIdentity =
        chengHeldExecCapsuleProviderRoleChildIdentities[roleRow]
    let outputDigest =
        chengHeldExecCapsuleProviderRoleOutputDigests[roleRow]
    let uploadDigest =
        chengHeldExecCapsuleProviderRoleUploadDigests[roleRow]
    let outputBytes =
        chengHeldExecCapsuleProviderRoleOutputBytes[roleRow]
    let exitCode =
        chengHeldExecCapsuleProviderRoleExitCodes[roleRow]
    cheng_runtime_unlock()
    var sessionSlot: int32
    if session <= 0 ||
       !cheng_held_exec_parent_session_resolve(session, sessionSlot):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return 0
    var canonical: ChengHeldExecWire
    cheng_held_exec_wire_zero(canonical)
    canonical.data[0] = uint8(int32('C'))
    canonical.data[1] = uint8(int32('F'))
    canonical.data[2] = uint8(int32('P'))
    canonical.data[3] = uint8(int32('1'))
    canonical.data[4] = uint8(1)
    cheng_held_exec_wire_put_u64(canonical, 8, uint64(session))
    cheng_held_exec_wire_put_u64(canonical, 16, uint64(uint32(exitCode)))
    cheng_held_exec_wire_put_u64(canonical, 24, outputBytes)
    cheng_held_exec_wire_put_digest(canonical, 32, terminalReceipt)
    cheng_held_exec_wire_put_digest(canonical, 64, childIdentity)
    cheng_held_exec_wire_put_digest(canonical, 96, outputDigest)
    cheng_held_exec_wire_put_digest(canonical, 128, uploadDigest)
    cheng_held_exec_wire_put_digest(
        canonical,
        160,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestPlan, sessionSlot))
    cheng_held_exec_wire_put_digest(
        canonical,
        192,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, sessionSlot))
    cheng_held_exec_wire_put_digest(
        canonical,
        224,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestOwnerClaim, sessionSlot))
    let raw = cheng_malloc_export(256)
    if raw == nil:
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleFinished
        cheng_runtime_unlock()
        return 0
    cheng_bytes_copy(raw, ptr(&canonical), 256)
    var owned = cheng_str_view_owned(raw, 256)
    cheng_str_store_slot(ptr(&outCanonical), owned)
    cheng_str_dispose(owned)
    cheng_runtime_lock()
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleFinishedExported
    cheng_runtime_unlock()
    return 1

fn cheng_held_exec_decision_wire_build(
        slot: int32,
        decisionKind: int32,
        out: var ChengHeldExecWire): bool =
    if slot < 0 || slot >= chengHeldExecParentSessionCount ||
       (decisionKind != 1 && decisionKind != 2):
        return false
    cheng_held_exec_wire_header(
        out,
        decisionKind == 1 ?
            chengHeldExecKindCommitted : chengHeldExecKindAborted,
        uint64(4),
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestNonce, slot))
    cheng_held_exec_wire_put_digest(
        out,
        64,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, slot))
    cheng_held_exec_wire_put_digest(
        out,
        96,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestTerminal, slot))
    cheng_held_exec_wire_put_digest(
        out,
        128,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestOwnerClaim, slot))
    let receipt = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.durable_decision.canonical.v1",
        out)
    if !cheng_held_exec_digest_nonzero(receipt):
        return false
    cheng_held_exec_wire_put_digest(out, 160, receipt)
    return cheng_held_exec_digest_nonzero(
            cheng_held_exec_wire_get_digest(out, 32)) &&
        cheng_held_exec_digest_nonzero(
            cheng_held_exec_wire_get_digest(out, 64)) &&
        cheng_held_exec_digest_nonzero(
            cheng_held_exec_wire_get_digest(out, 96)) &&
        cheng_held_exec_digest_nonzero(
            cheng_held_exec_wire_get_digest(out, 128))

fn cheng_held_exec_decision_wire_exact_valid(
        wire: var ChengHeldExecWire): bool =
    let kind = cheng_held_exec_wire_get_u64(wire, 16)
    let embeddedReceipt = cheng_held_exec_wire_get_digest(wire, 160)
    if cheng_held_exec_wire_get_u64(wire, 0) != chengHeldExecMagic ||
       cheng_held_exec_wire_get_u64(wire, 8) != chengHeldExecVersion ||
       (kind != chengHeldExecKindCommitted &&
        kind != chengHeldExecKindAborted) ||
       cheng_held_exec_wire_get_u64(wire, 24) != uint64(4) ||
       !cheng_held_exec_digest_nonzero(
           cheng_held_exec_wire_get_digest(wire, 32)) ||
       !cheng_held_exec_digest_nonzero(
           cheng_held_exec_wire_get_digest(wire, 64)) ||
       !cheng_held_exec_digest_nonzero(
           cheng_held_exec_wire_get_digest(wire, 96)) ||
       !cheng_held_exec_digest_nonzero(
           cheng_held_exec_wire_get_digest(wire, 128)) ||
       !cheng_held_exec_digest_nonzero(embeddedReceipt):
        return false
    for byteIndex in 192..<chengHeldExecWireBytes:
        if wire.data[byteIndex] != uint8(0):
            return false
    cheng_held_exec_wire_put_digest(wire, 160, ChengFixedBytes32())
    let computedReceipt = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.durable_decision.canonical.v1",
        wire)
    cheng_held_exec_wire_put_digest(wire, 160, embeddedReceipt)
    return cheng_fixed32_equal(embeddedReceipt, computedReceipt)

@borrows
fn cheng_held_exec_decision_wire_exact_equal(
        left: ChengHeldExecWire,
        right: str): bool =
    if cheng_str_len(right) != chengHeldExecWireBytes ||
       cheng_str_data(right) == nil:
        return false
    for byteIndex in 0..<chengHeldExecWireBytes:
        if left.data[byteIndex] !=
           *(UInt8Ptr(cheng_ptr_plus(
               cheng_str_data(right), byteIndex))):
            return false
    return true

fn cheng_held_exec_decision_wires_equal(
        left: ChengHeldExecWire,
        right: ChengHeldExecWire): bool =
    for byteIndex in 0..<chengHeldExecWireBytes:
        if left.data[byteIndex] != right.data[byteIndex]:
            return false
    return true

# Project the exact fourth frame from an immutable FINISHED session.  The
# caller supplies only the bound session owner; terminal kind and every
# digest remain backend-owned value definitions.
@exportc("cheng_held_exec_terminal_transport_project_decision_canonical")
@abi_internal
fn cheng_held_exec_terminal_transport_project_decision_canonical_export(
        transportOwner: int32,
        outCanonicalBytes: var str): int32 =
    outCanonicalBytes = ""
    let roleRow = transportOwner - 1
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount:
        return 0
    cheng_runtime_lock()
    if roleRow >= chengHeldExecCapsuleProviderRoleNextRow ||
       (chengHeldExecCapsuleProviderRoleStates[roleRow] !=
            chengHeldExecCapsuleProviderRoleFinishedExported &&
        chengHeldExecCapsuleProviderRoleStates[roleRow] !=
            chengHeldExecCapsuleProviderRoleDecisionSent):
        cheng_runtime_unlock()
        return 0
    let session =
        chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow]
    cheng_runtime_unlock()
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(session, slot):
        return 0
    let state = cheng_held_exec_parent_session_state(slot)
    if state != chengHeldExecParentSessionFinished &&
       state != chengHeldExecParentSessionDecisionSent:
        return 0
    let terminalExit = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaTerminalExitOffset, slot)
    if terminalExit < 0 || terminalExit > 255:
        return 0
    let decisionKind = terminalExit == 0 ? 1 : 2
    var canonical: ChengHeldExecWire
    if !cheng_held_exec_decision_wire_build(
           slot, decisionKind, canonical) ||
       !cheng_held_exec_decision_wire_exact_valid(canonical):
        return 0
    let raw = cheng_malloc_export(chengHeldExecWireBytes + 1)
    if raw == nil:
        return 0
    cheng_bytes_set(raw, 0, chengHeldExecWireBytes + 1)
    cheng_bytes_copy(raw, ptr(&canonical), chengHeldExecWireBytes)
    var owned = cheng_str_view_owned(raw, chengHeldExecWireBytes)
    cheng_str_store_slot(ptr(&outCanonicalBytes), owned)
    cheng_str_dispose(owned)
    return 1

# Consume the already-bound parent transport once.  A retry after a complete
# SEQPACKET send is idempotent; a failed all-or-nothing send restores FINISHED
# so the durable journal can retry without changing its decision.
@exportc("cheng_held_exec_terminal_transport_send_decision")
@abi_internal
fn cheng_held_exec_terminal_transport_send_decision_export(
        transportOwner: int32): ChengHeldExecParentPhaseResult =
    let roleRow = transportOwner - 1
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount:
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, transportOwner)
    cheng_runtime_lock()
    if roleRow >= chengHeldExecCapsuleProviderRoleNextRow:
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, transportOwner)
    let roleState = chengHeldExecCapsuleProviderRoleStates[roleRow]
    let session =
        chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow]
    if roleState == chengHeldExecCapsuleProviderRoleDecisionSent:
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(1, 0, transportOwner)
    if roleState != chengHeldExecCapsuleProviderRoleFinishedExported:
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionState, transportOwner)
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleDecisionSending
    cheng_runtime_unlock()
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(session, slot):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, transportOwner)
    let state = cheng_held_exec_parent_session_state(slot)
    if state == chengHeldExecParentSessionDecisionSent:
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleDecisionSent
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(1, 0, transportOwner)
    if state != chengHeldExecParentSessionFinished ||
       !cheng_held_exec_parent_session_cas(
           slot,
           chengHeldExecParentSessionFinished,
           chengHeldExecParentSessionResolving):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleFinishedExported
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionState, transportOwner)
    let terminalExit = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaTerminalExitOffset, slot)
    let channelFd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChannelFdOffset, slot)
    let decisionKind = terminalExit == 0 ? 1 : 2
    var canonical: ChengHeldExecWire
    if terminalExit < 0 || terminalExit > 255 || channelFd < 0 ||
       !cheng_held_exec_decision_wire_build(
           slot, decisionKind, canonical) ||
       !cheng_held_exec_decision_wire_exact_valid(canonical) ||
       !cheng_held_exec_send_wire(channelFd, canonical):
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionFinished)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleFinishedExported
        cheng_runtime_unlock()
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrDecisionSendFailed, transportOwner)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaDecisionOffset, slot, decisionKind)
    cheng_held_exec_parent_session_store(
        slot, chengHeldExecParentSessionDecisionSent)
    cheng_runtime_lock()
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleDecisionSent
    cheng_runtime_unlock()
    return cheng_held_exec_parent_phase_result(1, 0, transportOwner)

fn cheng_held_exec_terminal_linux_pidfd_event_wait(
        session: int32): ChengHeldExecParentPhaseResult =
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(session, slot):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, session)
    if !cheng_held_exec_parent_session_cas(
           slot,
           chengHeldExecParentSessionDecisionSent,
           chengHeldExecParentSessionObservingExit):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionState, session)
    let childPid = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChildPidOffset, slot)
    let pidfd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaPidfdOffset, slot)
    let expectedUid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaChildUidOffset, slot)
    let terminalExit = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaTerminalExitOffset, slot)
    let decisionKind = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaDecisionOffset, slot)
    let observation = cheng_held_exec_terminal_linux_pidfd_event_wait_raw(
        pidfd, childPid)
    let decisionMatchesFinished =
        (decisionKind == 1 && terminalExit == 0) ||
        (decisionKind == 2 && terminalExit != 0)
    if observation.status != 1 || observation.errorCode != 0 ||
       observation.childPid != childPid ||
       observation.childUid != expectedUid ||
       observation.signalNumber != 17 ||
       observation.siCode < 1 || observation.siCode > 3 ||
       observation.rawStatus < 0 || observation.exitCode != 0 ||
       observation.rawWaitStatus != -1 || !decisionMatchesFinished:
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionRecoveryRequired)
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrChildExitNonzero, session)
    cheng_held_exec_parent_session_u32_store(
        chengHeldExecParentArenaObservedUidOffset,
        slot,
        observation.childUid)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedSignalOffset,
        slot,
        observation.signalNumber)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedSiCodeOffset,
        slot,
        observation.siCode)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedRawStatusOffset,
        slot,
        observation.rawStatus)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedExitOffset,
        slot,
        observation.exitCode)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedRawWaitStatusOffset,
        slot,
        observation.rawWaitStatus)
    let observationOwner =
        cheng_held_exec_terminal_observation_publish(session, slot, 1)
    if observationOwner <= 0:
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionRecoveryRequired)
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrReceiptProjectionFailed, session)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaExitObservationOwnerOffset,
        slot,
        observationOwner)
    cheng_held_exec_parent_session_store(
        slot, chengHeldExecParentSessionExitObserved)
    return cheng_held_exec_parent_phase_result(1, 0, session)

fn cheng_held_exec_terminal_darwin_kqueue_event_wait(
        session: int32): ChengHeldExecParentPhaseResult =
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(session, slot):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, session)
    if !cheng_held_exec_parent_session_cas(
           slot,
           chengHeldExecParentSessionDecisionSent,
           chengHeldExecParentSessionObservingExit):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionState, session)
    let childPid = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChildPidOffset, slot)
    let expectedUid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaChildUidOffset, slot)
    let terminalExit = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaTerminalExitOffset, slot)
    let decisionKind = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaDecisionOffset, slot)
    let observation = cheng_held_exec_terminal_darwin_kqueue_event_wait_raw(
        childPid)
    let decisionMatchesFinished =
        (decisionKind == 1 && terminalExit == 0) ||
        (decisionKind == 2 && terminalExit != 0)
    if observation.status != 1 || observation.errorCode != 0 ||
       observation.childPid != childPid ||
       observation.childUid != expectedUid ||
       observation.signalNumber != 20 ||
       observation.siCode < 1 || observation.siCode > 3 ||
       observation.rawStatus < 0 || observation.exitCode != 0 ||
       observation.rawWaitStatus != -1 || !decisionMatchesFinished:
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionRecoveryRequired)
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrChildExitNonzero, session)
    cheng_held_exec_parent_session_u32_store(
        chengHeldExecParentArenaObservedUidOffset,
        slot,
        observation.childUid)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedSignalOffset,
        slot,
        observation.signalNumber)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedSiCodeOffset,
        slot,
        observation.siCode)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedRawStatusOffset,
        slot,
        observation.rawStatus)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedExitOffset,
        slot,
        observation.exitCode)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedRawWaitStatusOffset,
        slot,
        observation.rawWaitStatus)
    let observationOwner =
        cheng_held_exec_terminal_observation_publish(session, slot, 1)
    if observationOwner <= 0:
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionRecoveryRequired)
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrReceiptProjectionFailed, session)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaExitObservationOwnerOffset,
        slot,
        observationOwner)
    cheng_held_exec_parent_session_store(
        slot, chengHeldExecParentSessionExitObserved)
    return cheng_held_exec_parent_phase_result(1, 0, session)

@exportc("cheng_held_exec_parent_terminal_observe_exit")
@abi_internal
fn cheng_held_exec_parent_terminal_observe_exit_export(
        session: int32): int32 =
    let result = cheng_host_is_darwin() ?
        cheng_held_exec_terminal_darwin_kqueue_event_wait(session) :
        cheng_held_exec_terminal_linux_pidfd_event_wait(session)
    if result.status != 1:
        return -1
    return cheng_held_exec_parent_terminal_observation_owner(session)

fn cheng_held_exec_terminal_exit_reap(
        session: int32): ChengHeldExecParentPhaseResult =
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(session, slot):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, session)
    if !cheng_held_exec_parent_session_cas(
           slot,
           chengHeldExecParentSessionExitObserved,
           chengHeldExecParentSessionReaping):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionState, session)
    let childPid = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChildPidOffset, slot)
    let pidfd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaPidfdOffset, slot)
    let observedUid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaObservedUidOffset, slot)
    let observedSignal = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedSignalOffset, slot)
    let observedSiCode = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedSiCodeOffset, slot)
    let observedRawStatus = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedRawStatusOffset, slot)
    let observedExit = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedExitOffset, slot)
    let reaped = cheng_host_terminal_exit_reap_runtime(pidfd, childPid)
    let platformTupleValid = cheng_host_is_darwin() ?
        (reaped.signalNumber == 20 && reaped.rawWaitStatus >= 0) :
        (reaped.childUid == observedUid && reaped.signalNumber == 17 &&
         reaped.rawWaitStatus == -1)
    if reaped.status != 1 || reaped.errorCode != 0 ||
       reaped.childPid != childPid || !platformTupleValid ||
       reaped.siCode != observedSiCode ||
       reaped.rawStatus != observedRawStatus ||
       reaped.exitCode != observedExit:
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionRecoveryRequired)
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrChildExitNonzero, session)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaObservedRawWaitStatusOffset,
        slot,
        reaped.rawWaitStatus)
    let reapObservationOwner =
        cheng_held_exec_terminal_observation_publish(session, slot, 2)
    if reapObservationOwner <= 0:
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionRecoveryRequired)
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrReceiptProjectionFailed, session)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaReapObservationOwnerOffset,
        slot,
        reapObservationOwner)
    if pidfd >= 0:
        let _closePidfd = libc_close(pidfd)
        cheng_held_exec_parent_session_i32_store(
            chengHeldExecParentArenaPidfdOffset, slot, -1)
    cheng_held_exec_parent_session_store(
        slot, chengHeldExecParentSessionReaped)
    return cheng_held_exec_parent_phase_result(1, 0, session)

@exportc("cheng_held_exec_parent_terminal_reap")
@abi_internal
fn cheng_held_exec_parent_terminal_reap_export(
        session: int32): int32 =
    let result = cheng_held_exec_terminal_exit_reap(session)
    if result.status != 1:
        return -1
    return cheng_held_exec_parent_terminal_observation_owner(session)

fn cheng_held_exec_parent_terminal_observation_owner(
        session: int32): int32 =
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(session, slot):
        return -1
    let state = cheng_held_exec_parent_session_state(slot)
    let owner = state == chengHeldExecParentSessionExitObserved ?
        cheng_held_exec_parent_session_i32_load(
            chengHeldExecParentArenaExitObservationOwnerOffset, slot) :
        (state == chengHeldExecParentSessionReaped ?
            cheng_held_exec_parent_session_i32_load(
                chengHeldExecParentArenaReapObservationOwnerOffset, slot) :
            -1)
    if owner <= 0 || owner > chengHeldExecTerminalObservationRowCount ||
       cheng_atomic_load_i32_export(
           ptr(&chengHeldExecTerminalObservationStates[owner - 1])) !=
           chengHeldExecTerminalObservationIssued:
        return -1
    return owner

@exportc("cheng_held_exec_parent_abort_unresolved")
@abi_internal
fn cheng_held_exec_parent_abort_unresolved_export(
        handle: int32): ChengHeldExecParentPhaseResult =
    var slot: int32
    if !cheng_held_exec_parent_session_resolve(handle, slot):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionUnavailable, handle)
    let prior = cheng_held_exec_parent_session_state(slot)
    if (prior != chengHeldExecParentSessionClaimed &&
        prior != chengHeldExecParentSessionActivated &&
        prior != chengHeldExecParentSessionFinished &&
        prior != chengHeldExecParentSessionReceiving &&
        prior != chengHeldExecParentSessionRecoveryRequired) ||
       !cheng_held_exec_parent_session_cas(
           slot, prior, chengHeldExecParentSessionResolving):
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrSessionState, handle)
    # An unresolved failure is not a semantic fourth frame. Close the channel,
    # terminate the child and reap it; COMMITTED|ABORTED can only originate
    # from a durable decision owner after FINISHED.
    let childPid = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChildPidOffset, slot)
    let _kill = cheng_host_process_signal_bridge_runtime(
        int64(childPid), 9)
    let decisionChannelFd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChannelFdOffset, slot)
    if decisionChannelFd >= 0:
        let _closeDecisionChannel = libc_close(decisionChannelFd)
        cheng_held_exec_parent_session_i32_store(
            chengHeldExecParentArenaChannelFdOffset, slot, -1)
    let waitedExit = cheng_held_exec_reap_failure(childPid)
    cheng_held_exec_parent_session_close_resources(slot)
    cheng_held_exec_parent_session_store(
        slot, chengHeldExecParentSessionAborted)
    if waitedExit < 0:
        return cheng_held_exec_parent_phase_result(
            0, chengHeldExecParentErrChildExitNonzero, handle)
    return cheng_held_exec_parent_phase_result(1, 0, handle)
