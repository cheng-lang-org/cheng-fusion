        return -1
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    var handleIndex: int32
    var handleSlot: ChengAllocationLedgerFfiHandleSlotPtr
    if control->handleFreeHead >= 0:
        handleIndex = control->handleFreeHead
        handleSlot = cheng_allocation_ledger_ffi_handle_slot_at(handleIndex)
        if handleSlot == nil ||
           handleSlot->state != chengAllocationLedgerHandleRetired ||
           handleSlot->generation == probe_handle_max_generation:
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_free_list_corrupt")
            return -1
        control->handleFreeHead = handleSlot->nextFreeSlot
        handleSlot->generation = handleSlot->generation + uint32(1)
    else:
        if control->handleCount >=
           chengAllocationLedgerFfiHandleSlotCount:
            return -1
        handleIndex = control->handleCount
        control->handleCount = control->handleCount + 1
        handleSlot = &control->handles[handleIndex]
        handleSlot->generation = uint32(1)
    handleSlot->state = chengAllocationLedgerHandleEmpty
    handleSlot->slotIndex = handleIndex
    handleSlot->nextFreeSlot = -1
    handleSlot->liveBorrowCount = uint64(0)
    *outGeneration = handleSlot->generation
    return handleIndex

fn cheng_allocation_ledger_ffi_handle_recycle_locked(
        handleSlot: ChengAllocationLedgerFfiHandleSlotPtr) =
    if handleSlot == nil ||
       handleSlot->state != chengAllocationLedgerHandleLive ||
       handleSlot->liveBorrowCount != uint64(0) ||
       cheng_allocation_ledger_control_plane_raw == uint64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_ffi_handle_recycle_invalid")
        return
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    if handleSlot->slotIndex < 0 ||
       handleSlot->slotIndex >= control->handleCount:
        cheng_allocation_ledger_abort(
            "allocation_ledger_ffi_handle_recycle_identity_invalid")
        return
    handleSlot->state = chengAllocationLedgerHandleRetired
    handleSlot->ownerSlotIndex = -1
    handleSlot->ownerSlotGeneration = uint64(0)
    handleSlot->payloadRaw = uint64(0)
    handleSlot->recordIndex = -1
    handleSlot->recordGeneration = uint64(0)
    handleSlot->liveBorrowCount = uint64(0)
    handleSlot->nextFreeSlot = control->handleFreeHead
    control->handleFreeHead = handleSlot->slotIndex

