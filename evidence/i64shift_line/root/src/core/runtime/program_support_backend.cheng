    cheng_bytes_set(argvRaw, 0, slotCount * int32(sizeof(ptr)))
    let programNameLen = cheng_cstrlen_raw(programName)
    let programCopy: ptr = cheng_string_copy(programName, programNameLen)
    if programCopy == nil:
        cheng_free_export(argvRaw)
        return nil
    store_ptr_export(argvRaw, programCopy)
    var builtCount: int32 = 1
    if !cheng_exec_program_append_wire_items(argvRaw, builtCount, argvWire):
        cheng_exec_program_free_argv(argvRaw, builtCount)
        return nil
    return argvRaw

@borrows
fn cheng_exec_program_build_exec_argv(programName: ptr,
                                      argvWire: str,
                                      envWire: str): ptr =
    let envCount = cheng_exec_program_argv_wire_count(envWire)
    let argCount = cheng_exec_program_argv_wire_count(argvWire)
