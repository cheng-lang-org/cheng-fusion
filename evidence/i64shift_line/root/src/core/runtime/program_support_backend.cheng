        elif !cheng_recv_exact(clientFd, responseBuf, responseLen):
            errWire = cheng_error_with_errno(" libp2p tcp: recv response payload")
    if cheng_str_len(errWire) == 0: clientResponseWire = cheng_str_copy(responseBuf, responseLen)
    if responseBuf != nil:
        cheng_free_export(responseBuf)
    if protocolBuf != nil:
        cheng_free_export(protocolBuf)
    if frameBuf != nil:
        cheng_free_export(frameBuf)
    if connectAddr != nil:
        cheng_free_export(connectAddr)
    cheng_str_dispose(requestWire)
    cheng_close_if_open(clientFd)
    let handle = cheng_str_len(errWire) == 0 ? cheng_buffer_handle_new_from_str(clientResponseWire) : uint64(0)
    if handle == uint64(0):
        if cheng_str_len(errWire) > 0:
            cheng_tcp_last_error_set(errWire)
        else:
            cheng_tcp_last_error_set_ptr(" libp2p tcp: request-response handle failed")
    else:
        cheng_tcp_last_error_clear()
    cheng_str_dispose(clientResponseWire)
    cheng_str_dispose(errWire)
    return handle

@exportc("cheng_tcp_serve_request_capture_once_bridge")
@abi_internal
fn cheng_tcp_serve_request_capture_once_bridge_export(hostText: str, port: int32, protocolText: str, responseHex: str, readyPath: str): uint64 =
    var capturedWire = cheng_str_empty()
    let capturedHandle = cheng_tcp_serve_request_capture_window_bridge_export(hostText, port, protocolText, responseHex, readyPath, 1, -1)
    if capturedHandle == uint64(0):
        return uint64(0)
    let capturedLen = cheng_buffer_handle_len_bridge_export(capturedHandle)
    if capturedLen < 0:
        cheng_buffer_handle_release_bridge_export(capturedHandle)
        cheng_tcp_last_error_set_ptr(" libp2p tcp: capture window handle len failed")
        return uint64(0)
    var capturedRaw = cheng_malloc_export(capturedLen + 1)
    if capturedRaw == nil:
        cheng_buffer_handle_release_bridge_export(capturedHandle)
        cheng_tcp_last_error_set_ptr(" libp2p tcp: alloc failed")
        return uint64(0)
    for i in 0..<capturedLen:
        *(UInt8Ptr(cheng_ptr_plus(capturedRaw, i))) = uint8(cheng_buffer_handle_byte_bridge_export(capturedHandle, i))
    *(UInt8Ptr(cheng_ptr_plus(capturedRaw, capturedLen))) = uint8(0)
    capturedWire = cheng_str_view_owned(capturedRaw, capturedLen)
    cheng_buffer_handle_release_bridge_export(capturedHandle)
    if cheng_str_len(capturedWire) <= 0:
        cheng_tcp_last_error_set_ptr(" libp2p tcp: empty captured request")
        return uint64(0)
    var requestWire = cheng_str_empty()
    var errWire = cheng_str_empty()
    let handle = cheng_hex_decode_str(capturedWire, requestWire, errWire) ? cheng_buffer_handle_new_from_str(requestWire) : uint64(0)
    if handle == uint64(0):
        if cheng_str_len(errWire) > 0:
            cheng_tcp_last_error_set(errWire)
        else:
            cheng_tcp_last_error_set_ptr(" libp2p tcp: capture decode handle failed")
    else:
        cheng_tcp_last_error_clear()
    cheng_str_dispose(requestWire)
    cheng_str_dispose(errWire)
    return handle

@exportc("cheng_tcp_serve_payload_window_bridge")
@abi_internal
fn cheng_tcp_serve_payload_window_bridge_export(hostText: str, port: int32, protocolText: str, payloadHex: str, readyPath: str, maxServeCount: int32, waitMs: int32): int32 =
    var errWire = cheng_str_empty()
    var payloadWire = cheng_str_empty()
    var listenerFd: int32 = -1
    var serverFd: int32 = -1
    var servedCount = 0
    let bindAddr = cheng_sockaddr_ipv4_parse(hostText, port)
    let addrLenMem = cheng_malloc_export(int32(sizeof(int32)))
    if port < 0 || port > 65535:
        errWire = cheng_str_copy_cstring(" libp2p tcp: invalid port")
    if cheng_str_len(errWire) == 0 && bindAddr == nil:
        errWire = cheng_str_copy_cstring(" libp2p tcp: invalid host")
    if cheng_str_len(errWire) == 0 && addrLenMem == nil:
        errWire = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
    if cheng_str_len(errWire) == 0:
        cheng_hex_decode_str(payloadHex, payloadWire, errWire)
    if cheng_str_len(errWire) == 0:
        listenerFd = libc_socket(cheng_af_inet(), cheng_sock_stream(), cheng_ipproto_ip())
        if listenerFd < 0:
            errWire = cheng_error_with_errno(" libp2p tcp: socket")
    if cheng_str_len(errWire) == 0:
        let reuse: int32 = 1
        libc_setsockopt(listenerFd, cheng_sol_socket(), cheng_so_reuseaddr(), ptr(&reuse), int32(sizeof(int32)))
        if libc_bind(listenerFd, bindAddr, chengSockaddrInLen) != 0:
            errWire = cheng_error_with_errno(" libp2p tcp: bind")
    if cheng_str_len(errWire) == 0 && libc_listen(listenerFd, 8) != 0:
        errWire = cheng_error_with_errno(" libp2p tcp: listen")
    if cheng_str_len(errWire) == 0:
        *(Int32Ptr(addrLenMem)) = chengSockaddrInLen
        if libc_getsockname(listenerFd, bindAddr, addrLenMem) != 0:
            errWire = cheng_error_with_errno(" libp2p tcp: getsockname")
    if cheng_str_len(errWire) == 0:
        let boundPort = cheng_sockaddr_port(bindAddr)
        let readyOk = cheng_write_ready_port(readyPath, boundPort, errWire)
        readyOk
    while cheng_str_len(errWire) == 0 &&
          (maxServeCount <= 0 || servedCount < maxServeCount):
        let ready = cheng_tcp_wait_readable(listenerFd, waitMs, errWire)
        if cheng_str_len(errWire) > 0:
            break
        if ready <= 0:
            break
        serverFd = libc_accept(listenerFd, nil, nil)
        if serverFd < 0:
            errWire = cheng_error_with_errno(" libp2p tcp: accept")
            break
        let frameBuf = cheng_malloc_export(4)
        var protocolBuf: ptr = nil
        var connErr = cheng_str_empty()
        var dropConn = false
        if frameBuf == nil:
            connErr = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
        if cheng_str_len(connErr) == 0 && cheng_str_len(protocolText) > 0:
            let protocolLen = cheng_str_len(protocolText)
            protocolBuf = cheng_malloc_export(protocolLen)
            if protocolBuf == nil:
                connErr = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
            elif !cheng_recv_exact(serverFd, protocolBuf, protocolLen):
                dropConn = true
            elif !cheng_bytes_equal(protocolBuf, cheng_str_data(protocolText), protocolLen):
                dropConn = true
            elif !cheng_send_all(serverFd, cheng_str_data(protocolText), protocolLen):
                dropConn = true
        if cheng_str_len(connErr) == 0 && !dropConn:
            cheng_write_u32be(frameBuf, uint32(cheng_str_len(payloadWire)))
            if !cheng_send_all(serverFd, frameBuf, 4):
                dropConn = true
            elif cheng_str_len(payloadWire) > 0 &&
                 !cheng_send_all(serverFd, cheng_str_data(payloadWire), cheng_str_len(payloadWire)):
                dropConn = true
        cheng_tcp_free_ptr(protocolBuf)
        cheng_tcp_free_ptr(frameBuf)
        cheng_close_if_open(serverFd)
        serverFd = -1
        if cheng_str_len(connErr) > 0:
            errWire = connErr
            break
        if dropConn:
            continue
        servedCount = servedCount + 1
    if addrLenMem != nil:
        cheng_free_export(addrLenMem)
    if bindAddr != nil:
        cheng_free_export(bindAddr)
    let ok = cheng_str_len(errWire) == 0 ? 1 : 0
    if ok != 0:
        cheng_tcp_last_error_clear()
    else:
        cheng_tcp_last_error_set(errWire)
    cheng_str_dispose(payloadWire)
    cheng_str_dispose(errWire)
    cheng_close_if_open(serverFd)
    cheng_close_if_open(listenerFd)
    return ok

@exportc("cheng_tcp_serve_request_capture_window_bridge")
@abi_internal
fn cheng_tcp_serve_request_capture_window_bridge_export(hostText: str, port: int32, protocolText: str, responseHex: str, readyPath: str, maxCaptureCount: int32, waitMs: int32): uint64 =
    var capturedWire = cheng_str_empty()
    var errWire = cheng_str_empty()
    var responseWire = cheng_str_empty()
    var listenerFd: int32 = -1
    var serverFd: int32 = -1
    var capturedCount = 0
    let bindAddr = cheng_sockaddr_ipv4_parse(hostText, port)
    let addrLenMem = cheng_malloc_export(int32(sizeof(int32)))
    if port < 0 || port > 65535:
        errWire = cheng_str_copy_cstring(" libp2p tcp: invalid port")
    if cheng_str_len(errWire) == 0 && bindAddr == nil:
        errWire = cheng_str_copy_cstring(" libp2p tcp: invalid host")
    if cheng_str_len(errWire) == 0 && addrLenMem == nil:
        errWire = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
    if cheng_str_len(errWire) == 0:
        cheng_hex_decode_str(responseHex, responseWire, errWire)
    if cheng_str_len(errWire) == 0:
        listenerFd = libc_socket(cheng_af_inet(), cheng_sock_stream(), cheng_ipproto_ip())
        if listenerFd < 0:
            errWire = cheng_error_with_errno(" libp2p tcp: socket")
    if cheng_str_len(errWire) == 0:
        let reuse: int32 = 1
        libc_setsockopt(listenerFd, cheng_sol_socket(), cheng_so_reuseaddr(), ptr(&reuse), int32(sizeof(int32)))
        if libc_bind(listenerFd, bindAddr, chengSockaddrInLen) != 0:
            errWire = cheng_error_with_errno(" libp2p tcp: bind")
    if cheng_str_len(errWire) == 0 && libc_listen(listenerFd, 8) != 0:
        errWire = cheng_error_with_errno(" libp2p tcp: listen")
    if cheng_str_len(errWire) == 0:
        *(Int32Ptr(addrLenMem)) = chengSockaddrInLen
        if libc_getsockname(listenerFd, bindAddr, addrLenMem) != 0:
            errWire = cheng_error_with_errno(" libp2p tcp: getsockname")
    if cheng_str_len(errWire) == 0:
        let boundPort = cheng_sockaddr_port(bindAddr)
        let readyOk = cheng_write_ready_port(readyPath, boundPort, errWire)
        readyOk
    while cheng_str_len(errWire) == 0 &&
          (maxCaptureCount <= 0 || capturedCount < maxCaptureCount):
        let ready = cheng_tcp_wait_readable(listenerFd, waitMs, errWire)
        if cheng_str_len(errWire) > 0:
            break
        if ready <= 0:
            break
        serverFd = libc_accept(listenerFd, nil, nil)
        if serverFd < 0:
            errWire = cheng_error_with_errno(" libp2p tcp: accept")
            break
        let frameBuf = cheng_malloc_export(4)
        var protocolBuf: ptr = nil
        var requestBuf: ptr = nil
        var requestText = cheng_str_empty()
        var connErr = cheng_str_empty()
        var dropConn = false
        if frameBuf == nil:
            connErr = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
        if cheng_str_len(connErr) == 0 && cheng_str_len(protocolText) > 0:
            let protocolLen = cheng_str_len(protocolText)
            protocolBuf = cheng_malloc_export(protocolLen)
            if protocolBuf == nil:
                connErr = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
            elif !cheng_recv_exact(serverFd, protocolBuf, protocolLen):
                dropConn = true
            elif !cheng_bytes_equal(protocolBuf, cheng_str_data(protocolText), protocolLen):
                dropConn = true
            elif !cheng_send_all(serverFd, cheng_str_data(protocolText), protocolLen):
                dropConn = true
        if cheng_str_len(connErr) == 0 && !dropConn && !cheng_recv_exact(serverFd, frameBuf, 4):
            dropConn = true
        let requestLen = int32(cheng_read_u32be(frameBuf))
        if cheng_str_len(connErr) == 0 && !dropConn && requestLen > 0:
            requestBuf = cheng_malloc_export(requestLen)
            if requestBuf == nil:
                connErr = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
            elif !cheng_recv_exact(serverFd, requestBuf, requestLen):
                dropConn = true
        if cheng_str_len(connErr) == 0 && !dropConn:
            requestText = cheng_str_copy(requestBuf, requestLen)
            cheng_write_u32be(frameBuf, uint32(cheng_str_len(responseWire)))
            if !cheng_send_all(serverFd, frameBuf, 4):
                dropConn = true
            elif cheng_str_len(responseWire) > 0 &&
                 !cheng_send_all(serverFd, cheng_str_data(responseWire), cheng_str_len(responseWire)):
                dropConn = true
        cheng_tcp_free_ptr(requestBuf)
        cheng_tcp_free_ptr(protocolBuf)
        cheng_tcp_free_ptr(frameBuf)
        cheng_close_if_open(serverFd)
        serverFd = -1
        if cheng_str_len(connErr) > 0:
            errWire = connErr
            break
        if dropConn:
            continue
        var requestHex = cheng_bytes_hex_str(cheng_str_data(requestText), cheng_str_len(requestText))
        if capturedCount > 0:
            cheng_runtime_concat_assign_cstring(capturedWire, "\n")
        cheng_runtime_concat_assign(capturedWire, requestHex)
        cheng_str_dispose(requestHex)
        capturedCount = capturedCount + 1
    if addrLenMem != nil:
        cheng_free_export(addrLenMem)
    if bindAddr != nil:
        cheng_free_export(bindAddr)
    cheng_str_dispose(responseWire)
    let handle = cheng_str_len(errWire) == 0 ? cheng_buffer_handle_new_from_str(capturedWire) : uint64(0)
    if handle == uint64(0):
        if cheng_str_len(errWire) > 0:
            cheng_tcp_last_error_set(errWire)
        else:
            cheng_tcp_last_error_set_ptr(" libp2p tcp: capture window handle failed")
    else:
        cheng_tcp_last_error_clear()
    cheng_str_dispose(capturedWire)
    cheng_str_dispose(errWire)
    cheng_close_if_open(serverFd)
    cheng_close_if_open(listenerFd)
    return handle

@exportc("cheng_tailnet_provider_open_bridge")
@abi_internal
fn cheng_tailnet_provider_open_bridge_export(providerKindText: str,
                                                controlEndpointText: str,
                                                relayEndpointText: str,
                                                controlProbeEndpointText: str,
                                                relayProbeEndpointText: str,
                                                derpRegionCodeText: str,
                                                derpHostnameText: str): uint64 =
    let runtime = cheng_tailnet_provider_runtime_new()
    if runtime == nil:
        return uint64(0)
    runtime->providerKind = cheng_copy_cstring_from_str(providerKindText)
    runtime->controlEndpoint = cheng_copy_cstring_from_str(controlEndpointText)
    runtime->relayEndpoint = cheng_copy_cstring_from_str(relayEndpointText)
    runtime->controlProbeEndpoint = cheng_copy_cstring_from_str(controlProbeEndpointText)
    runtime->relayProbeEndpoint = cheng_copy_cstring_from_str(relayProbeEndpointText)
    runtime->derpRegionCode = cheng_copy_cstring_from_str(derpRegionCodeText)
    runtime->derpHostname = cheng_copy_cstring_from_str(derpHostnameText)
    let handle = cheng_ffi_handle_register_ptr_export(ptr(runtime))
    if handle == uint64(0):
        cheng_tailnet_provider_runtime_dispose(runtime)
        return uint64(0)
    cheng_tailnet_provider_active_count = cheng_tailnet_provider_active_count + 1
    return handle

fn cheng_tailnet_provider_command_apply(
        runtime: ChengTailnetProviderRuntimePtr,
        commandText: str): int32 =
    if runtime == nil:
        return -1
    if cheng_str_equals_cstring(commandText, "provider-start"):
        if cheng_tailnet_provider_is_headscale(runtime):
            if cheng_tailnet_provider_sync_control(runtime):
                return 0
            return -1
        runtime->providerReady = true
        runtime->proxyReady = false
        runtime->listenerNeedsRepair = false
        cheng_tailnet_provider_set_stage_cstring(runtime, "provider-started")
        cheng_tailnet_provider_set_error_cstring(runtime, "")
        return 0
    if cheng_str_equals_cstring(commandText, "proxy-ready"):
        if cheng_tailnet_provider_is_headscale(runtime):
            if cheng_tailnet_provider_sync_control(runtime):
                return 0
            return -1
        runtime->providerReady = true
        runtime->proxyReady = true
        runtime->listenerNeedsRepair = false
        cheng_tailnet_provider_set_stage_cstring(runtime, "proxy-ready")
        cheng_tailnet_provider_set_error_cstring(runtime, "")
        return 0
    if cheng_str_equals_cstring(commandText, "repair-needed"):
        runtime->providerReady = true
        runtime->proxyReady = false
        runtime->listenerNeedsRepair = true
        cheng_tailnet_provider_set_stage_cstring(runtime, "repair-needed")
        cheng_tailnet_provider_set_error_cstring(runtime, "")
        return 0
    if cheng_str_equals_cstring(commandText, "repair-listeners"):
        if cheng_tailnet_provider_is_headscale(runtime):
            if cheng_tailnet_provider_sync_control(runtime):
                return 0
            return -1
        runtime->providerReady = true
        runtime->proxyReady = true
        runtime->listenerNeedsRepair = false
        cheng_tailnet_provider_set_stage_cstring(runtime, "repair-complete")
        cheng_tailnet_provider_set_error_cstring(runtime, "")
        return 0
    if cheng_str_equals_cstring(commandText, "derp-reconnect"):
        runtime->derpHealthy = false
        cheng_tailnet_provider_set_stage_cstring(runtime, "derp-reconnect")
        cheng_tailnet_provider_set_error_cstring(runtime, "")
        return 0
    if cheng_str_equals_cstring(commandText, "derp-ready"):
        if cheng_tailnet_provider_is_headscale(runtime):
            if cheng_tailnet_provider_sync_derp(runtime):
                return 0
            return -1
        runtime->derpHealthy = true
        cheng_tailnet_provider_set_stage_cstring(runtime, "derp-ready")
        cheng_tailnet_provider_set_error_cstring(runtime, "")
        return 0
    return -1

@exportc("cheng_tailnet_provider_command_bridge")
@abi_internal
fn cheng_tailnet_provider_command_bridge_export(handle: uint64, commandText: str): int32 =
    var borrowGeneration: uint64
    let runtimeRaw = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    if runtimeRaw == nil:
        return -1
    let runtime = ChengTailnetProviderRuntimePtr(runtimeRaw)
    cheng_tailnet_provider_command_count =
        cheng_tailnet_provider_command_count + 1
    let rc = cheng_tailnet_provider_command_apply(runtime, commandText)
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        return -1
    return rc

@exportc("cheng_tailnet_provider_close_bridge")
