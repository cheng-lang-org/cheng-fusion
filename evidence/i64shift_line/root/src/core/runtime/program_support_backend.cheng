@exportc("driver_c_str_eq_raw_bridge")
@abi_internal
fn driver_c_str_eq_raw_bridge_export(actual: str, expectedPtr: ptr, expectedLen: int32): int32 =
    if expectedLen < 0:
        return 0
    let actualLen: int32 = cheng_str_len(actual)
    if actualLen != expectedLen:
        return 0
    if actualLen == 0:
        return 1
    if expectedPtr == nil:
        return 0
    let actualPtr: ptr = cheng_str_data(actual)
    var i: int32
    for i in i..<actualLen:
        if *(UInt8Ptr(cheng_ptr_plus(actualPtr, i))) != *(UInt8Ptr(cheng_ptr_plus(expectedPtr, i))):
            return 0
    return 1

