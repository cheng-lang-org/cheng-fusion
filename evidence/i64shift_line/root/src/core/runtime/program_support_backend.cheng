fn cheng_ascii_space(ch: uint8): bool =
    if ch == uint8(32):
        return true
    if ch == uint8(9):
        return true
    if ch == uint8(10):
        return true
    if ch == uint8(13):
        return true
    if ch == uint8(12):
        return true
    if ch == uint8(11):
        return true
    return false

@exportc("cheng_str_strip_bridge")
@abi_internal
@borrows
fn cheng_str_strip_bridge_export(s: str): str =
    let data: ptr = cheng_str_data(s)
    let n: int32 = cheng_str_len(s)
    if data == nil || n <= 0:
        return cheng_str_empty()
    var start: int32
    var stop: int32 = n
    while start < n && cheng_ascii_space(*(UInt8Ptr(cheng_ptr_plus(data, start)))):
        start = start + 1
    while stop > start && cheng_ascii_space(*(UInt8Ptr(cheng_ptr_plus(data, stop - 1)))):
        stop = stop - 1
    let sliceData = cheng_ptr_plus(data, start)
    let sliceLen = stop - start
    let out = cheng_str_copy(sliceData, sliceLen)
    return out

fn cheng_strformat_join_refs_into(outRef: ptr,
                                  partsRef: ptr,
                                  sepData: ptr,
                                  sepLenRaw: int32) =
    let out: StrPtr = StrPtr(outRef)
    out->data = nil
    out->len = 0
    out->store_id = 0
    out->flags = 0
    if partsRef == nil:
        return
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(partsRef)
    if hdr->len <= 0:
        return
    if hdr->buffer == nil:
        panic("cheng_strformat_join_refs_into: invalid parts")
    var sepLen: int32
    if sepLenRaw > 0:
        sepLen = sepLenRaw
    if sepLen > 0 && sepData == nil:
        panic("cheng_strformat_join_refs_into: invalid separator")
    var total64: int64
    for i in 0..<hdr->len:
        if i > 0 && sepLen > 0:
            total64 = total64 + int64(sepLen)
        let partPtr: StrPtr = StrPtr(cheng_ptr_plus(hdr->buffer, i * int32(sizeof(str))))
        let partLen0: int32 = partPtr->len
        if partLen0 > 0:
            let partData0: ptr = partPtr->data
            if partData0 == nil:
                panic("cheng_strformat_join_refs_into: invalid part")
            total64 = total64 + int64(partLen0)
        if total64 >= int64(2147483647):
            panic("cheng_strformat_join_refs_into: length overflow")
    let total: int32 = int32(total64)
    if total <= 0:
        return
    let outRaw: ptr = driver_c_new_string_export(total)
    if outRaw == nil:
        panic("cheng_strformat_join_refs_into: alloc failed")
    var writeAt: int32
    for i in 0..<hdr->len:
        if i > 0 && sepLen > 0:
            let sepDst = cheng_ptr_plus(outRaw, writeAt)
            cheng_bytes_copy(sepDst, sepData, sepLen)
            writeAt = writeAt + sepLen
        let partPtr: StrPtr = StrPtr(cheng_ptr_plus(hdr->buffer, i * int32(sizeof(str))))
        let partLen: int32 = partPtr->len
        if partLen > 0:
            let dst = cheng_ptr_plus(outRaw, writeAt)
            cheng_bytes_copy(dst, partPtr->data, partLen)
            writeAt = writeAt + partLen
    out->data = outRaw
    out->len = total
    out->store_id = 0
    out->flags = chengStrFlagOwned

fn cheng_strformat_join_runtime(partsRef: ptr, sepRef: ptr): str =
    var out: str
    var sepData: ptr
    var sepLen: int32
    if sepRef != nil:
        let sepRaw: StrPtr = StrPtr(sepRef)
        sepData = sepRaw->data
        if sepRaw->len > 0:
            sepLen = sepRaw->len
    cheng_strformat_join_refs_into(ptr(&out), partsRef, sepData, sepLen)
    return out

@exportc("cheng_char_to_str_bridge")
@abi_internal
fn cheng_char_to_str_bridge_export(c: int32): str =
    let out: str = cheng_binary_str_alloc(1)
    let data: ptr = cheng_str_data(out)
    if data != nil:
        cheng_bytes_write_offset_i8(data, 0, int8(c))
    return out

# Pure primary passes local str/str[] bridge arguments by address. The exported
# bridges below stay pointer-native and avoid provider-internal aggregate sret
# calls on this ABI boundary.

@exportc("cheng_strformat_fmt_bridge")
@abi_internal
fn cheng_strformat_fmt_bridge_export(partsRef: ptr): str =
    var out: str
    cheng_strformat_join_refs_into(ptr(&out), partsRef, nil, 0)
    return out

@exportc("cheng_strformat_lines_bridge")
@abi_internal
fn cheng_strformat_lines_bridge_export(partsRef: ptr): str =
    var out: str
    var newline: uint8
    newline = uint8(10)
    cheng_strformat_join_refs_into(ptr(&out), partsRef, ptr(&newline), 1)
    return out

@exportc("cheng_strutils_join_bridge")
@abi_internal
fn cheng_strutils_join_bridge_export(partsRef: ptr, sepRef: ptr): str =
    var out: str
    var sepData: ptr
    var sepLen: int32
    if sepRef != nil:
        let sepRaw: StrPtr = StrPtr(sepRef)
        sepData = sepRaw->data
        if sepRaw->len > 0:
            sepLen = sepRaw->len
    cheng_strformat_join_refs_into(ptr(&out), partsRef, sepData, sepLen)
    return out

@exportc("cheng_os_is_absolute_bridge")
@abi_internal
@borrows
fn cheng_os_is_absolute_bridge_export(path: str): int32 =
    let data: ptr = cheng_str_data(path)
    let n: int32 = cheng_str_len(path)
    if data == nil || n <= 0:
        return 0
    let ch0: uint8 = *(UInt8Ptr(data))
    if int32(ch0) == 47:
        return 1
    if int32(ch0) == 92:
        return 1
    if n >= 2:
        let ch1: uint8 = *(UInt8Ptr(cheng_ptr_plus(data, 1)))
        if int32(ch1) == 58:
            return 1
    return 0

@exportc("cheng_os_join_path_bridge")
@abi_internal
@borrows
fn cheng_os_join_path_bridge_export(left: str, right: str): str =
    let leftData: ptr = cheng_str_data(left)
    let rightData: ptr = cheng_str_data(right)
    let leftLen: int32 = cheng_str_len(left)
    let rightLen: int32 = cheng_str_len(right)
    if leftLen <= 0:
        return cheng_str_copy(rightData, rightLen)
    if rightLen <= 0:
        return cheng_str_copy(leftData, leftLen)
    let leftLast: uint8 = *(UInt8Ptr(cheng_ptr_plus(leftData, leftLen - 1)))
    let rightFirst: uint8 = *(UInt8Ptr(rightData))
    let needSep: bool = leftLast != uint8(int32('/')) &&
                        leftLast != uint8(int32('\\')) &&
                        rightFirst != uint8(int32('/')) &&
                        rightFirst != uint8(int32('\\'))
    let total: int32 = leftLen + rightLen + (needSep ? 1 : 0)
    let out: ptr = driver_c_new_string_export(total)
    if out == nil:
        return cheng_str_empty()
    cheng_bytes_copy(out, leftData, leftLen)
    if needSep:
        let sepPtr: ptr = cheng_ptr_plus(out, leftLen)
        cheng_bytes_set(sepPtr, int32('/'), 1)
    cheng_bytes_copy(cheng_ptr_plus(out, leftLen + (needSep ? 1 : 0)), rightData, rightLen)
    return cheng_str_view_owned(out, total)

@exportc("cheng_register_line_map_from_argv0")
fn cheng_register_line_map_from_argv0_export(argv0: ptr) =
    native_cheng_register_line_map_from_argv0_runtime(argv0)

@exportc("cheng_panic_cstring_and_exit")
fn cheng_panic_cstring_and_exit_export(text: ptr) =
    var safeText: ptr = text
    if safeText == nil || cheng_cstrlen_raw(safeText) <= 0:
        safeText = "panic"
    cheng_stderr_write_line_cstr(safeText)
    cheng_quarantine_panic_exit_seen = 1
    c_exit_runtime(1)

@exportc("cheng_rawbytes_get_at")
fn cheng_rawbytes_get_at_export(base: ptr, idx: int32): int32 =
    if base == nil || idx < 0:
        return 0
    return int32(*(UInt8Ptr(cheng_ptr_plus(base, idx))))

@exportc("cheng_rawbytes_set_at")
fn cheng_rawbytes_set_at_export(base: ptr, idx: int32, value: int32) =
    if base == nil || idx < 0:
        return
    *(UInt8Ptr(cheng_ptr_plus(base, idx))) = uint8(value & 255)

fn cheng_ffi_handle_register_ptr_locked(p: ptr): uint64 =
    if p == nil:
        return uint64(0)
    let processOwner = cheng_allocation_ledger_any_active_locked()
    if processOwner != nil:
        let threadOwner = cheng_allocation_ledger_active_locked()
        let pointerRecord =
            cheng_allocation_ledger_live_record_for_payload_locked(p)
        let recordOwner =
            cheng_allocation_ledger_record_slot_locked(pointerRecord)
        if threadOwner == nil || pointerRecord == nil ||
           recordOwner == nil || recordOwner != threadOwner ||
           threadOwner->liveHandleCount ==
               cheng_allocation_ledger_u64_max():
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_pointer_untracked")
            return uint64(0)
        if pointerRecord->liveHandleCount != uint64(0):
            return uint64(0)
        var generation: uint32
        let handleIndex =
            cheng_allocation_ledger_ffi_handle_acquire_locked(
                &generation)
        if handleIndex < 0:
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_capacity_exhausted")
            return uint64(0)
        let control = ChengAllocationLedgerControlPlanePtr(
            ptr(cheng_allocation_ledger_control_plane_raw))
        let handleSlot = &control->handles[handleIndex]
        handleSlot->state = chengAllocationLedgerHandleLive
        handleSlot->ownerSlotIndex = threadOwner->slotIndex
        handleSlot->ownerSlotGeneration =
            threadOwner->capabilityGeneration
        handleSlot->payloadRaw = uint64(p)
        handleSlot->recordIndex = pointerRecord->recordIndex
        handleSlot->recordGeneration =
            pointerRecord->allocationGeneration
        threadOwner->liveHandleCount =
            threadOwner->liveHandleCount + uint64(1)
        pointerRecord->liveHandleCount =
            pointerRecord->liveHandleCount + uint64(1)
        if threadOwner->liveHandleCount > threadOwner->peakHandleCount:
            threadOwner->peakHandleCount = threadOwner->liveHandleCount
        cheng_allocation_ledger_record_handle_event_locked(
            threadOwner,
            pointerRecord,
            handleSlot,
            chengAllocationLedgerOperationHandleRegister)
        let low = chengFfiHandleLedgerDomainBit |
                  uint64(handleIndex + 1)
        let handle = (uint64(generation) << uint64(32)) | low
        return handle
    if probe_live_slot_for_payload_locked(p) != nil:
        return uint64(0)
    var idx: int32 = -1
    for i in 0..<probe_slots_len:
        let slot: ChengFfiHandleSlotPtr = probe_slot_at(i)
        if slot == nil:
            cheng_mem_registry_hard_fail(
                "ffi probe table: handle slot unavailable")
            return uint64(0)
        if slot->ptr == nil &&
           slot->liveBorrowCount != uint64(0):
            cheng_mem_registry_hard_fail(
                "ffi probe table: retired slot has live borrow")
            return uint64(0)
        if slot->ptr == nil:
            idx = i
            break
    if idx < 0:
        idx = probe_slots_len
        let stride = int64(sizeof(ChengFfiHandleSlot))
        let maxCap = int32(int64(2147483647) / stride)
        if stride <= int64(0) || idx < 0 || idx >= maxCap:
            cheng_mem_registry_hard_fail(
                "ffi probe table: handle capacity exhausted")
            return uint64(0)
        let requiredCap = idx + 1
        if !probe_ensure_capacity(requiredCap):
            return uint64(0)
        probe_slots_len = requiredCap
    let slot: ChengFfiHandleSlotPtr = probe_slot_at(idx)
    if slot == nil || slot->liveBorrowCount != uint64(0):
        cheng_mem_registry_hard_fail(
            "ffi probe table: reused slot has live borrow")
        return uint64(0)
    slot->ptr = p
    if slot->generation == uint32(0):
        slot->generation = uint32(1)
    let handle =
        (uint64(slot->generation) << uint64(32)) | uint64(idx + 1)
    return handle

@exportc("cheng_ffi_handle_register_ptr")
fn cheng_ffi_handle_register_ptr_export(p: ptr): uint64 =
    if p == nil:
        return uint64(0)
    cheng_runtime_lock()
    let handle = cheng_ffi_handle_register_ptr_locked(p)
    cheng_runtime_unlock()
    return handle

fn cheng_ffi_handle_decode_index(handle: uint64): int32 =
    if handle == uint64(0):
        return -1
    let low: uint64 = handle & uint64(0xffffffff)
    let encodedIndex = low & chengFfiHandleIndexMask
    if encodedIndex == uint64(0):
        return -1
    return int32(encodedIndex - uint64(1))

fn cheng_ffi_handle_is_ledger(handle: uint64): bool =
    let low = handle & uint64(0xffffffff)
    return (low & chengFfiHandleLedgerDomainBit) != uint64(0)

fn cheng_ffi_handle_decode_generation(handle: uint64): uint32 =
    return uint32(handle >> uint64(32))

fn cheng_allocation_ledger_ffi_handle_owner_locked(
        handleSlot: ChengAllocationLedgerFfiHandleSlotPtr,
        record: ChengAllocationLedgerRecordPtr):
        ChengAllocationLedgerOwnerSlotPtr =
    if handleSlot == nil || record == nil:
        return nil
    let owner = cheng_allocation_ledger_slot_at(
        handleSlot->ownerSlotIndex)
    if owner == nil || owner->active == 0 || owner->closed != 0 ||
       owner->slotIndex != handleSlot->ownerSlotIndex ||
       owner->capabilityGeneration !=
           handleSlot->ownerSlotGeneration ||
       record->recordIndex != handleSlot->recordIndex ||
       record->ownerSlotIndex != handleSlot->ownerSlotIndex ||
       record->ownerSlotGeneration !=
           handleSlot->ownerSlotGeneration:
        return nil
    return owner

fn cheng_ffi_handle_resolve_ptr_locked(handle: uint64): ptr =
    let idx = cheng_ffi_handle_decode_index(handle)
    let generation = cheng_ffi_handle_decode_generation(handle)
    if idx < 0 || generation == uint32(0):
        return nil
    if cheng_ffi_handle_is_ledger(handle):
        let handleSlot =
            cheng_allocation_ledger_ffi_handle_slot_at(idx)
        if handleSlot == nil ||
           handleSlot->slotIndex != idx ||
           handleSlot->state != chengAllocationLedgerHandleLive ||
           handleSlot->generation != generation:
            return nil
        let record = cheng_allocation_ledger_record_at(
            handleSlot->recordIndex)
        let owner =
            cheng_allocation_ledger_ffi_handle_owner_locked(
                handleSlot, record)
        if owner == nil ||
           record->state != chengAllocationLedgerRecordHeapLive ||
           record->allocationGeneration !=
               handleSlot->recordGeneration ||
           record->payloadRaw != handleSlot->payloadRaw ||
           owner->liveHandleCount == uint64(0) ||
           record->liveHandleCount != uint64(1):
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_capability_mismatch")
            return nil
        return ptr(handleSlot->payloadRaw)
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_ordinary_ffi_handle_during_owner")
        return nil
    if idx >= probe_slots_len:
        return nil
    let slot = probe_slot_at(idx)
    if slot == nil || slot->ptr == nil ||
       slot->generation != generation:
        return nil
    return slot->ptr

fn cheng_ffi_handle_lease_status_locked(handle: uint64): int32 =
    if cheng_ffi_handle_resolve_ptr_locked(handle) == nil:
        return probe_handle_err_invalid
    let idx = cheng_ffi_handle_decode_index(handle)
    if cheng_ffi_handle_is_ledger(handle):
        let handleSlot =
            cheng_allocation_ledger_ffi_handle_slot_at(idx)
        if handleSlot == nil ||
           handleSlot->liveBorrowCount > uint64(1):
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_borrow_state_corrupt")
            return probe_handle_err_invalid
        if handleSlot->liveBorrowCount != uint64(0):
            return probe_handle_err_busy
        if handleSlot->borrowGeneration ==
           cheng_allocation_ledger_u64_max():
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_borrow_generation_exhausted")
            return probe_handle_err_invalid
        return 0
    let slot = probe_slot_at(idx)
    if slot == nil || slot->liveBorrowCount > uint64(1):
        cheng_mem_registry_hard_fail(
            "ffi probe table: handle borrow state corrupt")
        return probe_handle_err_invalid
    if slot->liveBorrowCount != uint64(0):
        return probe_handle_err_busy
    if slot->borrowGeneration == cheng_allocation_ledger_u64_max():
        cheng_mem_registry_hard_fail(
            "ffi probe table: handle borrow generation exhausted")
        return probe_handle_err_invalid
    return 0

fn cheng_ffi_handle_lease_acquire_locked(
        handle: uint64,
        outPayload: VoidPtrPtr,
        outBorrowGeneration: UInt64Ptr): int32 =
    if outPayload == nil || outBorrowGeneration == nil:
        return probe_handle_err_invalid
    *outPayload = nil
    *outBorrowGeneration = uint64(0)
    let status = cheng_ffi_handle_lease_status_locked(handle)
    if status != 0:
        return status
    let idx = cheng_ffi_handle_decode_index(handle)
    if cheng_ffi_handle_is_ledger(handle):
        let handleSlot =
            cheng_allocation_ledger_ffi_handle_slot_at(idx)
        handleSlot->borrowGeneration =
            handleSlot->borrowGeneration + uint64(1)
        handleSlot->liveBorrowCount = uint64(1)
        *outPayload = ptr(handleSlot->payloadRaw)
        *outBorrowGeneration = handleSlot->borrowGeneration
        return 0
    let slot = probe_slot_at(idx)
    slot->borrowGeneration = slot->borrowGeneration + uint64(1)
    slot->liveBorrowCount = uint64(1)
    *outPayload = slot->ptr
    *outBorrowGeneration = slot->borrowGeneration
    return 0

fn cheng_ffi_handle_lease_pair_acquire_locked(
        requestHandle: uint64,
        responseHandle: uint64,
        outRequestPayload: VoidPtrPtr,
        outRequestBorrowGeneration: UInt64Ptr,
        outResponsePayload: VoidPtrPtr,
        outResponseBorrowGeneration: UInt64Ptr): int32 =
    if outRequestPayload == nil ||
       outRequestBorrowGeneration == nil ||
       outResponsePayload == nil ||
       outResponseBorrowGeneration == nil:
        return probe_handle_err_invalid
    *outRequestPayload = nil
    *outRequestBorrowGeneration = uint64(0)
    *outResponsePayload = nil
    *outResponseBorrowGeneration = uint64(0)
    if requestHandle == responseHandle:
        let rc = cheng_ffi_handle_lease_acquire_locked(
            requestHandle,
            outRequestPayload,
            outRequestBorrowGeneration)
        if rc == 0:
            *outResponsePayload = *outRequestPayload
            *outResponseBorrowGeneration = *outRequestBorrowGeneration
        return rc
    let requestStatus =
        cheng_ffi_handle_lease_status_locked(requestHandle)
    if requestStatus != 0:
        return requestStatus
    let responseStatus =
        cheng_ffi_handle_lease_status_locked(responseHandle)
    if responseStatus != 0:
        return responseStatus
    let requestRc = cheng_ffi_handle_lease_acquire_locked(
        requestHandle,
        outRequestPayload,
        outRequestBorrowGeneration)
    if requestRc != 0:
        cheng_runtime_lock_abort(
            "cheng ffi handle pair acquire: request preflight drift")
        return probe_handle_err_invalid
    let responseRc = cheng_ffi_handle_lease_acquire_locked(
        responseHandle,
        outResponsePayload,
        outResponseBorrowGeneration)
    if responseRc != 0:
        cheng_runtime_lock_abort(
            "cheng ffi handle pair acquire: response preflight drift")
        return probe_handle_err_invalid
    return 0

fn cheng_ffi_handle_lease_release_locked(
        handle: uint64,
        borrowGeneration: uint64): int32 =
    if borrowGeneration == uint64(0):
        return probe_handle_err_invalid
    let resolved = cheng_ffi_handle_resolve_ptr_locked(handle)
    if resolved == nil:
        return probe_handle_err_invalid
    let idx = cheng_ffi_handle_decode_index(handle)
    if cheng_ffi_handle_is_ledger(handle):
        let handleSlot =
            cheng_allocation_ledger_ffi_handle_slot_at(idx)
        if handleSlot == nil ||
           handleSlot->liveBorrowCount != uint64(1) ||
           handleSlot->borrowGeneration != borrowGeneration:
            return probe_handle_err_invalid
        handleSlot->liveBorrowCount = uint64(0)
        return 0
    let slot = probe_slot_at(idx)
    if slot == nil || slot->liveBorrowCount != uint64(1) ||
       slot->borrowGeneration != borrowGeneration:
        return probe_handle_err_invalid
    slot->liveBorrowCount = uint64(0)
    return 0

fn cheng_ffi_handle_retire_take_locked(
        handle: uint64,
        outPayload: VoidPtrPtr): int32 =
    if outPayload == nil:
        return probe_handle_err_invalid
    *outPayload = nil
    let resolved = cheng_ffi_handle_resolve_ptr_locked(handle)
    if resolved == nil:
        return probe_handle_err_invalid
    let idx = cheng_ffi_handle_decode_index(handle)
    if cheng_ffi_handle_is_ledger(handle):
        let handleSlot =
            cheng_allocation_ledger_ffi_handle_slot_at(idx)
        if handleSlot == nil ||
           handleSlot->liveBorrowCount > uint64(1):
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_retire_state_corrupt")
            return probe_handle_err_invalid
        if handleSlot->liveBorrowCount != uint64(0):
            return probe_handle_err_busy
    else:
        let slot = probe_slot_at(idx)
        if slot == nil || slot->liveBorrowCount > uint64(1):
            cheng_mem_registry_hard_fail(
                "ffi probe table: retire borrow state corrupt")
            return probe_handle_err_invalid
        if slot->liveBorrowCount != uint64(0):
            return probe_handle_err_busy
    if !cheng_ffi_handle_invalidate_locked(handle):
        cheng_runtime_lock_abort(
            "cheng ffi handle retire: preflight drift")
        return probe_handle_err_invalid
    *outPayload = resolved
    return 0

fn cheng_ffi_handle_invalidate_locked(handle: uint64): bool =
    let idx = cheng_ffi_handle_decode_index(handle)
    let generation = cheng_ffi_handle_decode_generation(handle)
    if idx < 0 || generation == uint32(0):
        return false
    if cheng_ffi_handle_is_ledger(handle):
        let handleSlot =
            cheng_allocation_ledger_ffi_handle_slot_at(idx)
        if handleSlot == nil ||
           handleSlot->slotIndex != idx ||
           handleSlot->state != chengAllocationLedgerHandleLive ||
           handleSlot->generation != generation ||
           handleSlot->liveBorrowCount != uint64(0):
            return false
        let record = cheng_allocation_ledger_record_at(
            handleSlot->recordIndex)
        let owner =
            cheng_allocation_ledger_ffi_handle_owner_locked(
                handleSlot, record)
        if owner == nil ||
           record->state != chengAllocationLedgerRecordHeapLive ||
           record->allocationGeneration !=
               handleSlot->recordGeneration ||
           record->payloadRaw != handleSlot->payloadRaw ||
           owner->liveHandleCount == uint64(0) ||
           record->liveHandleCount != uint64(1):
            cheng_allocation_ledger_abort(
                "allocation_ledger_ffi_handle_invalidate_mismatch")
            return false
        owner->liveHandleCount = owner->liveHandleCount - uint64(1)
        record->liveHandleCount = record->liveHandleCount - uint64(1)
        cheng_allocation_ledger_record_handle_event_locked(
            owner,
            record,
            handleSlot,
            chengAllocationLedgerOperationHandleInvalidate)
        cheng_allocation_ledger_ffi_handle_recycle_locked(handleSlot)
        return true
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_ordinary_ffi_handle_during_owner")
        return false
    if idx >= probe_slots_len:
        return false
    let slot = probe_slot_at(idx)
    if slot == nil || slot->ptr == nil ||
       slot->generation != generation ||
       slot->liveBorrowCount != uint64(0):
        return false
    if slot->generation == probe_handle_max_generation:
        cheng_mem_registry_hard_fail(
            "ffi probe table: handle generation exhausted")
        return false
    slot->ptr = nil
    slot->generation = slot->generation + uint32(1)
    return true

@borrows
fn cheng_ffi_handle_abort_invalid(op: ptr, handle: uint64, detail: ptr) =
    handle
    var safeOp: ptr = op
    if safeOp == nil:
        safeOp = "unknown"
    var safeDetail: ptr = detail
    if safeDetail == nil:
        safeDetail = "invalid"
    let prefix = "[cheng] ffi handle invalid: op="
    let middle = " detail="
    let ignoredPrefix = libc_write_runtime(
        2, prefix, cheng_cstrlen_raw(prefix))
    let ignoredOp = libc_write_runtime(
        2, safeOp, cheng_cstrlen_raw(safeOp))
    let ignoredMiddle = libc_write_runtime(
        2, middle, cheng_cstrlen_raw(middle))
    let ignoredDetail = libc_write_runtime(
        2, safeDetail, cheng_cstrlen_raw(safeDetail))
    let ignoredNewline = libc_write_runtime(2, "\n", 1)
    ignoredPrefix
    ignoredOp
    ignoredMiddle
    ignoredDetail
    ignoredNewline
    libc__exit_runtime(86)

fn cheng_ffi_handle_output_pair_valid(
        outPayload: ptr,
        outBorrowGeneration: ptr): bool =
    if outPayload == nil || outBorrowGeneration == nil:
        return false
    let payloadRaw = uint64(outPayload)
    let generationRaw = uint64(outBorrowGeneration)
    return (payloadRaw & uint64(7)) == uint64(0) &&
           (generationRaw & uint64(7)) == uint64(0) &&
           payloadRaw != generationRaw

@exportc("cheng_ffi_handle_lease_acquire")
fn cheng_ffi_handle_lease_acquire_export(
        handle: uint64,
        outPayload: ptr,
        outBorrowGeneration: ptr): int32 =
    if !cheng_ffi_handle_output_pair_valid(
           outPayload, outBorrowGeneration):
        return probe_handle_err_invalid
    cheng_runtime_lock()
    let rc = cheng_ffi_handle_lease_acquire_locked(
        handle, VoidPtrPtr(outPayload), UInt64Ptr(outBorrowGeneration))
    cheng_runtime_unlock()
    return rc

@exportc("cheng_ffi_handle_lease_release")
fn cheng_ffi_handle_lease_release_export(
        handle: uint64,
        borrowGeneration: uint64): int32 =
    cheng_runtime_lock()
    let rc = cheng_ffi_handle_lease_release_locked(
        handle, borrowGeneration)
    cheng_runtime_unlock()
    return rc

@exportc("cheng_ffi_handle_retire_take")
fn cheng_ffi_handle_retire_take_export(
        handle: uint64,
        outPayload: ptr): int32 =
    if outPayload == nil ||
       (uint64(outPayload) & uint64(7)) != uint64(0):
        return probe_handle_err_invalid
    *(VoidPtrPtr(outPayload)) = nil
    cheng_runtime_lock()
    let rc = cheng_ffi_handle_retire_take_locked(
        handle, VoidPtrPtr(outPayload))
    cheng_runtime_unlock()
    return rc

fn cheng_ffi_handle_lease_acquire_ptr(
        handle: uint64,
        outBorrowGeneration: UInt64Ptr): ptr =
    if outBorrowGeneration == nil:
        return nil
    var payload: ptr
    let rc = cheng_ffi_handle_lease_acquire_export(
        handle, &payload, ptr(outBorrowGeneration))
    if rc != 0:
        cheng_ffi_handle_abort_invalid(
            "lease_acquire", handle,
            rc == probe_handle_err_busy ? "busy" : "stale")
        return nil
    return payload

fn cheng_ffi_handle_lease_release_or_abort(
        handle: uint64,
        borrowGeneration: uint64): bool =
    let rc = cheng_ffi_handle_lease_release_export(
        handle, borrowGeneration)
    if rc != 0:
        cheng_ffi_handle_abort_invalid(
            "lease_release", handle, "invalid_generation_or_owner")
        return false
    return true

fn cheng_ffi_handle_retire_take_ptr(handle: uint64): ptr =
    var payload: ptr
    let rc = cheng_ffi_handle_retire_take_export(handle, &payload)
    if rc != 0:
        cheng_ffi_handle_abort_invalid(
            "retire_take", handle, "invalid_stale_or_borrowed")
        return nil
    return payload

@exportc("cheng_ffi_handle_invalidate")
fn cheng_ffi_handle_invalidate_export(handle: uint64): int32 =
    cheng_runtime_lock()
    let invalidated = cheng_ffi_handle_invalidate_locked(handle)
    cheng_runtime_unlock()
    if !invalidated:
        cheng_ffi_handle_abort_invalid(
            "invalidate", handle, "invalid_or_stale")
        return probe_handle_err_invalid
    return 0

@exportc("cheng_ffi_handle_new_i32")
fn cheng_ffi_handle_new_i32_export(value: int32): uint64 =
    let mem: ptr = cheng_malloc_export(int32(sizeof(int32)))
    if mem == nil:
        return uint64(0)
    *(Int32Ptr(mem)) = value
    let handle: uint64 = cheng_ffi_handle_register_ptr_export(mem)
    if handle == uint64(0):
        cheng_free_export(mem)
    return handle

@exportc("cheng_ffi_handle_get_i32")
fn cheng_ffi_handle_get_i32_export(handle: uint64, outValue: ptr): int32 =
    if outValue == nil:
        cheng_ffi_handle_abort_invalid("get_i32", handle, "null-out")
        return probe_handle_err_invalid
    var borrowGeneration: uint64
    let cell: ptr = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    if cell == nil:
        return probe_handle_err_invalid
    let value = *(Int32Ptr(cell))
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        return probe_handle_err_invalid
    *(Int32Ptr(outValue)) = value
    return 0

@exportc("cheng_ffi_handle_add_i32")
fn cheng_ffi_handle_add_i32_export(handle: uint64, delta: int32, outValue: ptr): int32 =
    if outValue == nil:
        cheng_ffi_handle_abort_invalid("add_i32", handle, "null-out")
        return probe_handle_err_invalid
    var borrowGeneration: uint64
    let cell: ptr = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    if cell == nil:
        return probe_handle_err_invalid
    let next: int32 = *(Int32Ptr(cell)) + delta
    *(Int32Ptr(cell)) = next
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        return probe_handle_err_invalid
    *(Int32Ptr(outValue)) = next
    return 0

@exportc("cheng_ffi_handle_release_i32")
fn cheng_ffi_handle_release_i32_export(handle: uint64): int32 =
    let cell: ptr = cheng_ffi_handle_retire_take_ptr(handle)
    if cell == nil:
        return probe_handle_err_invalid
    cheng_free_export(cell)
    return 0

