fn cheng_allocation_ledger_participant_reserve_thread_start_locked():
        int32 =
    let ownerSlot = cheng_allocation_ledger_owner_thread_active_locked()
    if ownerSlot == nil:
        return -1
    var selectedRow: int32 = -1
    var selectedWorkerOrdinal: int32 = int32(2147483647)
    for row in 0..<chengAllocationLedgerParticipantRowCount:
        let workerOrdinal =
            cheng_allocation_ledger_participant_worker_ordinal_load(row)
        if workerOrdinal <= 0 || workerOrdinal >= selectedWorkerOrdinal ||
           cheng_allocation_ledger_participant_state_load(row) !=
               chengAllocationLedgerParticipantIssued ||
           cheng_allocation_ledger_participant_owner_slot_index_load(row) !=
               ownerSlot->slotIndex ||
           cheng_allocation_ledger_participant_owner_slot_generation_load(row) !=
               ownerSlot->capabilityGeneration:
            continue
        selectedRow = row
        selectedWorkerOrdinal = workerOrdinal
    if selectedRow < 0 ||
       !cheng_allocation_ledger_participant_state_cas(
           selectedRow,
           chengAllocationLedgerParticipantIssued,
           chengAllocationLedgerParticipantStarting):
        return -1
    return selectedRow

