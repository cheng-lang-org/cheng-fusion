@exportc("cheng_file_handle_close_bridge")
@abi_internal
fn cheng_file_handle_close_bridge_export(handle: uint64, outErr: var str): int32 =
    outErr = ""
    cheng_runtime_lock()
    let cell: ptr = cheng_file_handle_cell_locked(handle, outErr)
    if cell == nil:
        cheng_runtime_unlock()
        return 0
    if cheng_file_handle_cell_kind(cell) == chengFileHandleKindFd:
        let packed = cheng_file_handle_cell_fd_packed(cell)
        let fd = int32(packed - uint64(1))
        var nextGeneration: uint32 = cheng_file_handle_cell_generation(cell) + uint32(1)
        if nextGeneration == uint32(0):
            nextGeneration = uint32(1)
        cheng_file_handle_cell_set_fd_packed(cell, uint64(0))
        cheng_file_handle_cell_set_generation(cell, nextGeneration)
        cheng_file_handle_cell_set_mode(cell, 0)
        cheng_file_handle_cell_set_magic(cell, 0)
        cheng_free_locked(cell)
        cheng_runtime_unlock()
        if libc_close(fd) != 0:
            let _ = cheng_file_handle_err(outErr, "os file close: provider close failed")
            return 0
        return 1
    let stream = cheng_file_handle_take_stream_locked(handle, outErr)
    if stream == nil:
        cheng_runtime_unlock()
        return 0
    cheng_runtime_unlock()
    let rc = libc_fclose(stream)
    if rc != 0:
        let _ = cheng_file_handle_err(outErr, "os file close: provider close failed")
        return 0
    return 1

@exportc("cheng_file_handle_read_all_bridge")
@abi_internal
fn cheng_file_handle_read_all_bridge_export(handle: uint64, out: var str, outErr: var str): int32 =
    out = cheng_str_empty()
    outErr = ""
    cheng_runtime_lock()
    let cell: ptr = cheng_file_handle_cell_locked(handle, outErr)
    if cell == nil:
        cheng_runtime_unlock()
        return 0
    if !cheng_file_handle_mode_can_read(cheng_file_handle_cell_mode(cell)):
        let _ = cheng_file_handle_err(outErr, "os file read: handle not readable")
        cheng_runtime_unlock()
        return 0
    if cheng_file_handle_cell_kind(cell) == chengFileHandleKindFd:
        let fd = int32(cheng_file_handle_cell_fd_packed(cell) - uint64(1))
        var size: int64
        var modeBits: int32
        var dev: uint64
        var ino: uint64
        if !cheng_atomic_tree_fstat(fd, &size, &modeBits, &dev, &ino):
            let _ = cheng_file_handle_err(outErr, "os file read: invalid size")
            cheng_runtime_unlock()
            return 0
        if size < int64(0) || size > int64(2147483647):
            let _ = cheng_file_handle_err(outErr, "os file read: invalid size")
            cheng_runtime_unlock()
            return 0
        let count = int32(size)
        if count <= 0:
            cheng_runtime_unlock()
            return 1
        let raw = cheng_malloc_locked(count + 1)
        if raw == nil:
            let _ = cheng_file_handle_err(outErr, "os file read: alloc failed")
            cheng_runtime_unlock()
            return 0
        cheng_bytes_set(raw, 0, count + 1)
        var got: int32
        while got < count:
            let n = libc_read_runtime(fd, cheng_ptr_plus(raw, got), count - got)
            if n <= int64(0) || n > int64(count - got):
                cheng_free_locked(raw)
                let _ = cheng_file_handle_err(outErr, "os file read: provider read failed")
                cheng_runtime_unlock()
                return 0
            got = got + int32(n)
        out = cheng_str_view_owned(raw, count)
        cheng_runtime_unlock()
        return 1
    let stream = cheng_file_handle_cell_stream(cell)
    if stream == nil:
        let _ = cheng_file_handle_err(outErr, "os file handle: closed")
        cheng_runtime_unlock()
        return 0
    if libc_fseek(stream, int64(0), 2) != 0:
        let _ = cheng_file_handle_err(outErr, "os file read: seek end failed")
        cheng_runtime_unlock()
        return 0
    let size = libc_ftell(stream)
    if size < int64(0) || size > int64(2147483647):
        let _ = cheng_file_handle_err(outErr, "os file read: invalid size")
        cheng_runtime_unlock()
        return 0
    if libc_fseek(stream, int64(0), 0) != 0:
        let _ = cheng_file_handle_err(outErr, "os file read: seek start failed")
        cheng_runtime_unlock()
        return 0
    let count = int32(size)
    if count <= 0:
        cheng_runtime_unlock()
        return 1
    let raw = cheng_malloc_locked(count + 1)
    if raw == nil:
        let _ = cheng_file_handle_err(outErr, "os file read: alloc failed")
        cheng_runtime_unlock()
        return 0
    cheng_bytes_set(raw, 0, count + 1)
    let got = libc_fread(raw, int64(1), int64(count), stream)
    if got != int64(count):
        cheng_free_locked(raw)
        let _ = cheng_file_handle_err(outErr, "os file read: provider read failed")
        cheng_runtime_unlock()
        return 0
    out = cheng_str_view_owned(raw, count)
    cheng_runtime_unlock()
    return 1

@exportc("cheng_file_handle_write_all_bridge")
@abi_internal
fn cheng_file_handle_write_all_bridge_export(handle: uint64, data: ptr, dataLen: int32, outErr: var str): int32 =
    outErr = ""
    if dataLen < 0:
        let _ = cheng_file_handle_err(outErr, "os file write: negative length")
        return 0
    if dataLen > 0 && data == nil:
        let _ = cheng_file_handle_err(outErr, "os file write: nil data")
        return 0
    cheng_runtime_lock()
    let cell: ptr = cheng_file_handle_cell_locked(handle, outErr)
    if cell == nil:
        cheng_runtime_unlock()
        return 0
    if !cheng_file_handle_mode_can_write(cheng_file_handle_cell_mode(cell)):
        let _ = cheng_file_handle_err(outErr, "os file write: handle not writable")
        cheng_runtime_unlock()
        return 0
    if cheng_file_handle_cell_kind(cell) == chengFileHandleKindFd:
        let fd = int32(cheng_file_handle_cell_fd_packed(cell) - uint64(1))
        var written: int32
        while written < dataLen:
            let want = dataLen - written
            let n = libc_write_runtime(fd, cheng_ptr_plus(data, written), want)
            if n <= int64(0):
                let _ = cheng_file_handle_err(outErr, "os file write: provider write failed")
                cheng_runtime_unlock()
                return 0
            written = written + int32(n)
        cheng_runtime_unlock()
        return 1
    let stream = cheng_file_handle_cell_stream(cell)
    if stream == nil:
        let _ = cheng_file_handle_err(outErr, "os file handle: closed")
        cheng_runtime_unlock()
        return 0
    var written: int32
    while written < dataLen:
        let want = dataLen - written
        let n = libc_fwrite(cheng_ptr_plus(data, written), int64(1), int64(want), stream)
        if n <= int64(0):
            let _ = cheng_file_handle_err(outErr, "os file write: provider write failed")
            cheng_runtime_unlock()
            return 0
        written = written + int32(n)
    if libc_fflush(stream) != 0:
        let _ = cheng_file_handle_err(outErr, "os file write: flush failed")
        cheng_runtime_unlock()
        return 0
    cheng_runtime_unlock()
    return 1

@borrows
@exportc("cheng_os_fopen_mode_bridge")
@abi_internal
fn cheng_os_fopen_mode_bridge_export(path: str, mode: str): ptr =
    let rawPath = cheng_copy_cstring_from_str(path)
    if rawPath == nil:
        return nil
    let rawMode = cheng_copy_cstring_from_str(mode)
    if rawMode == nil:
        cheng_free_export(rawPath)
        return nil
    let fp = libc_fopen(rawPath, rawMode)
    cheng_free_export(rawMode)
    cheng_free_export(rawPath)
    return fp

