fn cheng_tcp_drop_capture_conn(frameBuf: ptr, protocolBuf: ptr, requestBuf: ptr): bool =
    cheng_tcp_free_ptr(requestBuf)
    cheng_tcp_free_ptr(protocolBuf)
    cheng_tcp_free_ptr(frameBuf)
    return false
@exportc("cheng_tcp_loopback_request_response_impl_bridge")
@abi_internal
@borrows
fn cheng_tcp_loopback_request_response_impl_bridge_export(protocolText: str,
                                                             requestWire: str,
                                                             responseWire: str,
                                                             clientResponseWire: var str,
                                                             errWire: var str): int32 =
    clientResponseWire = cheng_str_empty()
    errWire = cheng_str_empty()
    var listenerFd: int32 = -1
    var clientFd: int32 = -1
    var serverFd: int32 = -1
    let listenerAddr = cheng_sockaddr_loopback(0)
    let clientAddr = cheng_sockaddr_loopback(0)
    let addrLenMem = cheng_malloc_export(int32(sizeof(int32)))
    let frameBuf = cheng_malloc_export(4)
    var protocolBuf: ptr = nil
    var protocolEcho: ptr = nil
    var requestBuf: ptr = nil
    var responseBuf: ptr = nil
    if listenerAddr == nil || clientAddr == nil || addrLenMem == nil || frameBuf == nil:
        errWire = cheng_str_copy_cstring(" libp2p tcp: alloc failed")
    if cheng_str_len(errWire) == 0:
        listenerFd = libc_socket(cheng_af_inet(), cheng_sock_stream(), cheng_ipproto_ip())
        if listenerFd < 0:
            errWire = cheng_error_with_errno(" libp2p tcp: socket")
    if cheng_str_len(errWire) == 0:
        let reuse: int32 = 1
        libc_setsockopt(listenerFd, cheng_sol_socket(), cheng_so_reuseaddr(), ptr(&reuse), int32(sizeof(int32)))
        if libc_bind(listenerFd, listenerAddr, chengSockaddrInLen) != 0:
            errWire = cheng_error_with_errno(" libp2p tcp: bind")
    if cheng_str_len(errWire) == 0 && libc_listen(listenerFd, 8) != 0:
        errWire = cheng_error_with_errno(" libp2p tcp: listen")
    if cheng_str_len(errWire) == 0:
        *(Int32Ptr(addrLenMem)) = chengSockaddrInLen
        if libc_getsockname(listenerFd, listenerAddr, addrLenMem) != 0:
            errWire = cheng_error_with_errno(" libp2p tcp: getsockname")
    if cheng_str_len(errWire) == 0:
        *(UInt8Ptr(cheng_ptr_plus(clientAddr, 2))) = *(UInt8Ptr(cheng_ptr_plus(listenerAddr, 2)))
        *(UInt8Ptr(cheng_ptr_plus(clientAddr, 3))) = *(UInt8Ptr(cheng_ptr_plus(listenerAddr, 3)))
        clientFd = libc_socket(cheng_af_inet(), cheng_sock_stream(), cheng_ipproto_ip())
        if clientFd < 0:
