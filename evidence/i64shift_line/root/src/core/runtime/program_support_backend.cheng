    elif slot == 1:
        cheng_thread_local_i32_slot1 = value
    elif slot == 2:
        cheng_thread_local_i32_slot2 = value
    elif slot == 3:
        cheng_thread_local_i32_slot3 = value

@exportc("alloc")
fn alloc_export(size: int32): ptr =
    return cheng_malloc_export(size)

@exportc("dealloc")
