fn driver_c_read_flag_code_key_matches(argRaw: ptr, code: int32, keyLen: int32): bool =
    if argRaw == nil || keyLen <= 0:
        return false
    for i in 0..<keyLen:
        let actual: uint8 = *(UInt8Ptr(cheng_ptr_plus(argRaw, i)))
        let expected: uint8 = driver_c_read_flag_code_key_byte(code, i)
        if actual != expected:
            return false
    return true

@exportc("driver_c_read_flag_code_raw_ptr_bridge")
fn driver_c_read_flag_code_raw_ptr_bridge_export(code: int32): ptr =
    let keyLen = driver_c_read_flag_code_key_len(code)
    let count = cheng_saved_argc
    for i in 1..<count:
        var argRaw: ptr
        if cheng_saved_argv != nil:
            argRaw = *(VoidPtrPtr(cheng_ptr_plus(cheng_saved_argv, i * int32(sizeof(ptr)))))
        let argLen = cheng_cstrlen_raw(argRaw)
        if argLen > keyLen && driver_c_read_flag_code_key_matches(argRaw, code, keyLen):
            let sep = *(UInt8Ptr(cheng_ptr_plus(argRaw, keyLen)))
            if int32(sep) == 58 || int32(sep) == 61:
                return cheng_ptr_plus(argRaw, keyLen + 1)
        if argLen == keyLen && driver_c_read_flag_code_key_matches(argRaw, code, keyLen):
            if i + 1 < count:
                if cheng_saved_argv != nil:
                    return *(VoidPtrPtr(cheng_ptr_plus(cheng_saved_argv, (i + 1) * int32(sizeof(ptr)))))
    # Pure cannot lower string-literal -> ptr for defaults; miss => nil/0 and
    # caller falls back to str-path ReadFlagOrDefault(key, defaultValue).
    return nil

@exportc("driver_c_read_flag_code_raw_len_bridge")
fn driver_c_read_flag_code_raw_len_bridge_export(code: int32): int32 =
    let keyLen = driver_c_read_flag_code_key_len(code)
    let count = cheng_saved_argc
    for i in 1..<count:
        var argRaw: ptr
        if cheng_saved_argv != nil:
            argRaw = *(VoidPtrPtr(cheng_ptr_plus(cheng_saved_argv, i * int32(sizeof(ptr)))))
        let argLen = cheng_cstrlen_raw(argRaw)
        if argLen > keyLen && driver_c_read_flag_code_key_matches(argRaw, code, keyLen):
            let sep = *(UInt8Ptr(cheng_ptr_plus(argRaw, keyLen)))
            if int32(sep) == 58 || int32(sep) == 61:
                return argLen - keyLen - 1
        if argLen == keyLen && driver_c_read_flag_code_key_matches(argRaw, code, keyLen):
            if i + 1 < count:
                if cheng_saved_argv != nil:
                    var nextRaw: ptr
                    nextRaw = *(VoidPtrPtr(cheng_ptr_plus(cheng_saved_argv, (i + 1) * int32(sizeof(ptr)))))
                    return cheng_cstrlen_raw(nextRaw)
    return 0

@exportc("driver_c_read_int32_flag_or_default_bridge")
@abi_internal
fn driver_c_read_int32_flag_or_default_bridge_export(key: str, defaultValue: int32): int32 =
    var defaultRaw = cheng_str_empty()
    let raw = driver_c_read_flag_or_default_bridge_export(key, defaultRaw)
    if driver_c_str_eq_bridge_export(key, "--emit") != 0:
        if cheng_str_len(raw) <= 0 || driver_c_str_eq_bridge_export(raw, "exe") != 0:
            return 0
        if driver_c_str_eq_bridge_export(raw, "obj") != 0:
            return 1
        if driver_c_str_eq_bridge_export(raw, "shared") != 0:
            return 2
        let message = cheng_str_copy_cstring(" compiler: unsupported --emit")
        let ignoredWrite = cheng_stderr_write_line_str_return2(message)
        c_exit_runtime(2)
        return 0
    return cheng_runtime_parse_int32(raw, defaultValue)

@exportc("driver_c_read_required_flag_or_exit_bridge")
@abi_internal
fn driver_c_read_required_flag_or_exit_bridge_export(key: str, message: str): str =
    let value = driver_c_read_flag_or_default_bridge_export(key, cheng_str_empty())
    if cheng_str_len(value) <= 0:
        let ignoredWrite = cheng_stderr_write_line_str_return2(message)
        c_exit_runtime(2)
        return cheng_str_empty()
    return value

@exportc("driver_c_read_emit_kind_or_exit_bridge")
@abi_internal
fn driver_c_read_emit_kind_or_exit_bridge_export(defaultValue: str): int32 =
    let raw = driver_c_read_flag_or_default_bridge_export("--emit", defaultValue)
    if cheng_str_len(raw) <= 0 || driver_c_str_eq_bridge_export(raw, "exe") != 0:
        return 0
    if driver_c_str_eq_bridge_export(raw, "obj") != 0:
        return 1
    if driver_c_str_eq_bridge_export(raw, "shared") != 0:
        return 2
    let message = cheng_str_copy_cstring(" compiler: unsupported --emit")
    let ignoredWrite = cheng_stderr_write_line_str_return2(message)
    c_exit_runtime(2)
    return 0

@exportc("driver_c_read_symbol_visibility_or_exit_bridge")
@abi_internal
fn driver_c_read_symbol_visibility_or_exit_bridge_export(defaultValue: str): str =
    let raw = driver_c_read_flag_or_default_bridge_export("--symbol-visibility", defaultValue)
    if cheng_str_len(raw) <= 0 || driver_c_str_eq_bridge_export(raw, "public") != 0:
        return cheng_str_copy_cstring("public")
    if driver_c_str_eq_bridge_export(raw, "internal") != 0:
        return raw
    let message = cheng_str_copy_cstring(" compiler: unsupported --symbol-visibility")
    let ignoredWrite = cheng_stderr_write_line_str_return2(message)
    c_exit_runtime(2)
    return cheng_str_empty()

@exportc("__cheng_str_concat")
fn cheng_raw_concat_export(a: ptr, b: ptr): ptr =
    let lenA: int32 = cheng_cstrlen_raw(a)
    let lenB: int32 = cheng_cstrlen_raw(b)
    let out: ptr = driver_c_new_string_export(lenA + lenB)
    if out == nil:
        return nil
    if lenA > 0 && a != nil:
        cheng_bytes_copy(out, a, lenA)
    if lenB > 0 && b != nil:
        cheng_bytes_copy(cheng_ptr_plus(out, lenA), b, lenB)
    return out

@exportc("__cheng_sym_2b")
fn cheng_raw_concat_sym_export(a: ptr, b: ptr): ptr =
    return cheng_raw_concat_export(a, b)

@exportc("driver_c_str_concat_bridge")
@abi_internal
@borrows
fn driver_c_str_concat_bridge_export(a: str, b: str): str =
    let lenA: int32 = cheng_str_len(a)
    let lenB: int32 = cheng_str_len(b)
    let dataA: ptr = cheng_str_data(a)
    let dataB: ptr = cheng_str_data(b)
    if lenA > 0 && dataA == nil:
        panic("driver_c_str_concat_bridge: invalid left string")
    if lenB > 0 && dataB == nil:
        panic("driver_c_str_concat_bridge: invalid right string")
    let total64: int64 = int64(lenA) + int64(lenB)
    if total64 < 0 || total64 >= int64(2147483647):
        panic("driver_c_str_concat_bridge: length overflow")
    let total: int32 = int32(total64)
    if total <= 0:
        return cheng_str_empty()
    let outRaw: ptr = driver_c_new_string_export(total)
    if outRaw == nil:
        panic("driver_c_str_concat_bridge: alloc failed")
    if lenA > 0:
        cheng_bytes_copy(outRaw, dataA, lenA)
    if lenB > 0:
        cheng_bytes_copy(cheng_ptr_plus(outRaw, lenA), dataB, lenB)
    return cheng_str_view_owned(outRaw, total)

@exportc("driver_c_i32_to_str")
fn driver_c_i32_to_str_export(value: int32): ptr =
    if value >= 0:
        return cheng_u64_to_string(uint64(value))
    let mag: uint64 = uint64(-(int64(value)))
    let digits: ptr = cheng_u64_to_string(mag)
    if digits == nil:
        return nil
    let lenDigits: int32 = cheng_cstrlen_raw(digits)
    let out: ptr = driver_c_new_string_export(lenDigits + 1)
    if out == nil:
        return nil
    cheng_bytes_set(out, int32('-'), 1)
    if lenDigits > 0:
        cheng_bytes_copy(cheng_ptr_plus(out, 1), digits, lenDigits)
    cheng_free_export(digits)
    return out

@exportc("driver_c_i64_to_str")
fn driver_c_i64_to_str_export(value: int64): ptr =
    if value >= 0:
        return cheng_u64_to_string(uint64(value))
    let mag: uint64 = uint64(0) - uint64(value)
    let digits: ptr = cheng_u64_to_string(mag)
    if digits == nil:
        return nil
    let lenDigits: int32 = cheng_cstrlen_raw(digits)
    let out: ptr = driver_c_new_string_export(lenDigits + 1)
    if out == nil:
        return nil
    cheng_bytes_set(out, int32('-'), 1)
    if lenDigits > 0:
        cheng_bytes_copy(cheng_ptr_plus(out, 1), digits, lenDigits)
    cheng_free_export(digits)
    return out

@exportc("driver_c_u64_to_str")
fn driver_c_u64_to_str_export(value: uint64): ptr =
    return cheng_u64_to_string(value)

@exportc("cheng_i32_to_str_bridge")
@abi_internal
fn cheng_i32_to_str_bridge_export(value: int32): str =
    let raw: ptr = driver_c_i32_to_str_export(value)
    if raw == nil:
        return cheng_str_empty()
    let n: int32 = cheng_cstrlen_raw(raw)
    let out: str = cheng_str_copy(raw, n)
    cheng_free_export(raw)
