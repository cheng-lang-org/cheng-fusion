    if cond:
        return
    cheng_stderr_write_line_str_return2(message)
    c_exit_runtime(1)

@exportc("Assert")
@abi_internal
fn Assert_export(cond: bool, message: str) =
    assert_export(cond, message)

@exportc("cheng_exit")
fn cheng_exit_export(code: int32) =
    c_exit_runtime(code)

@exportc("cheng_bounds_check")
fn cheng_bounds_check_export(len: int32, idx: int32) =
    if idx < 0 || idx >= len:
        let msg: ptr = cheng_bounds_failure_message(len, idx)
        if msg != nil:
            cheng_stderr_write_line_cstr(msg)
            cheng_free_export(msg)
        else:
            cheng_stderr_write_line_cstr("[cheng] bounds check failed")
        c_exit_runtime(1)

fn cheng_seq_next_cap_calc(curCap: int32, needLen: int32): int32 =
    if needLen <= 0:
        return needLen
    var cap: int32 = curCap
    if cap < 4:
        cap = 4
    while cap < needLen:
        let doubled: int32 = cap * 2
        if doubled <= 0:
            return needLen
        cap = doubled
    return cap

fn cheng_seq_alloc_bytes_checked(cap: int32, elemSize: int32): int32 =
    let bytes64: int64 = int64(cap) * int64(elemSize)
    if bytes64 <= 0 || bytes64 > int64(2147483647):
        panic("cheng seq: bytes overflow")
    return int32(bytes64)

fn cheng_seq_string_init_cap_calc(seqLen: int32, seqCap: int32): int32 =
    var cap: int32 = seqCap
    if cap < seqLen:
        cap = seqLen
    if cap <= 0:
        return 0
    if cap < 4:
        return 4
    return cap

@exportc("cheng_seq_get")
fn cheng_seq_get_export(buffer: ptr, len: int32, idx: int32, elemSize: int32): ptr =
    cheng_bounds_check_export(len, idx)
    if buffer == nil || elemSize <= 0:
        return buffer
    return cheng_ptr_plus(buffer, idx * elemSize)

@exportc("cheng_seq_set")
fn cheng_seq_set_export(buffer: ptr, len: int32, idx: int32, elemSize: int32): ptr =
    return cheng_seq_get_export(buffer, len, idx, elemSize)

@exportc("cheng_seq_set_grow")
fn cheng_seq_set_grow_export(seqPtr: ptr, idx: int32, elemSize: int32): ptr =
    if seqPtr == nil || elemSize <= 0:
        return nil
    let seqHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    if seqHdr->len < 0 || seqHdr->cap < 0 || seqHdr->cap < seqHdr->len:
        panic("cheng seq_set_grow: corrupt header")
    if idx < 0:
        return cheng_seq_get_export(seqHdr->buffer, seqHdr->len, idx, elemSize)
    let needLen: int32 = idx + 1
    if needLen > seqHdr->cap || seqHdr->buffer == nil:
        var newCap: int32 = seqHdr->cap
        if newCap < 4:
            newCap = 4
        while newCap < needLen:
            let grown: int32 = newCap + newCap / 2
            if grown <= newCap:
                newCap = needLen
                break
            newCap = grown
        let bytes64: int64 = int64(newCap) * int64(elemSize)
        if bytes64 <= 0 || bytes64 > int64(2147483647):
            panic("cheng seq_set_grow: bytes overflow")
        if bytes64 >= int64(67108864):
            panic("cheng seq_set_grow: huge alloc")
        let bytes: int32 = int32(bytes64)
        let oldCap: int32 = seqHdr->cap
        let newBuf: ptr = cheng_realloc_export(seqHdr->buffer, bytes)
        if newBuf == nil:
            panic("cheng seq_set_grow: alloc failed")
        if newCap > oldCap:
            cheng_bytes_set(cheng_ptr_plus(newBuf, oldCap * elemSize), 0, (newCap - oldCap) * elemSize)
        seqHdr->buffer = newBuf
        seqHdr->cap = newCap
    if needLen > seqHdr->len:
        seqHdr->len = needLen
    return cheng_seq_get_export(seqHdr->buffer, seqHdr->len, idx, elemSize)

@exportc("cheng_seq_delete_shift")
fn cheng_seq_delete_shift_export(buffer: ptr, at: int32, len: int32, elemSize: int32) =
    if buffer == nil || elemSize <= 0 || at < 0 || at >= len:
        return
    if at + 1 >= len:
        return
    let dstOff: int32 = at * elemSize
    let srcOff: int32 = (at + 1) * elemSize
    let moveBytes: int32 = (len - at - 1) * elemSize
    var i: int32
    for i in i..<moveBytes:
        *(UInt8Ptr(cheng_ptr_plus(buffer, dstOff + i))) = *(UInt8Ptr(cheng_ptr_plus(buffer, srcOff + i)))

@exportc("cheng_seq_string_release_range_compat")
fn cheng_seq_string_release_range_compat_export(buffer: ptr, startIndex: int32, count: int32) =
    if buffer == nil || count <= 0:
        return
    let elemBytes: int32 = int32(sizeof(str))
    var start: int32 = startIndex
    if start < 0:
        start = 0
    var i: int32
    for i in i..<count:
        let slot: ptr = cheng_ptr_plus(buffer, (start + i) * elemBytes)
        let curPtr: StrPtr = StrPtr(slot)
        var cur: str
        cur.data = curPtr->data
        cur.len = curPtr->len
        cur.store_id = curPtr->store_id
        cur.flags = curPtr->flags
        cheng_str_release_owned(cur)
        curPtr->data = nil
        curPtr->len = 0
        curPtr->store_id = 0
        curPtr->flags = 0

@exportc("cheng_seq_string_delete_shift_compat")
fn cheng_seq_string_delete_shift_compat_export(buffer: ptr, at: int32, len: int32) =
    if buffer == nil || at < 0 || at >= len:
        return
    cheng_seq_string_release_range_compat_export(buffer, at, 1)
    let elemBytes: int32 = int32(sizeof(str))
    if at + 1 < len:
        let dstOff: int32 = at * elemBytes
        let srcOff: int32 = (at + 1) * elemBytes
        let moveBytes: int32 = (len - at - 1) * elemBytes
        var i: int32
        for i in i..<moveBytes:
            *(UInt8Ptr(cheng_ptr_plus(buffer, dstOff + i))) = *(UInt8Ptr(cheng_ptr_plus(buffer, srcOff + i)))
    let lastSlot: StrPtr = StrPtr(cheng_ptr_plus(buffer, (len - 1) * elemBytes))
    lastSlot->data = nil
    lastSlot->len = 0
    lastSlot->store_id = 0
    lastSlot->flags = 0

@exportc("cheng_seq_grow_to_raw")
fn cheng_seq_grow_to_raw_export(pBuffer: ptr, pCap: ptr, minCap: int32, elemSize: int32) =
    if pBuffer == nil || pCap == nil || minCap <= 0 || elemSize <= 0:
        return
    let capPtr: Int32Ptr = Int32Ptr(pCap)
    let bufferPtr: VoidPtrPtr = VoidPtrPtr(pBuffer)
    let curCap: int32 = *capPtr
    let rawBuffer: ptr = *bufferPtr
    if rawBuffer != nil && minCap <= curCap:
        return
    let newCap: int32 = cheng_seq_next_cap_calc(curCap, minCap)
    let oldBytes: int32 = rawBuffer == nil ? 0 : cheng_seq_alloc_bytes_checked(curCap, elemSize)
    let newBytes: int32 = cheng_seq_alloc_bytes_checked(newCap, elemSize)
    let newBuffer: ptr = cheng_realloc_export(rawBuffer, newBytes)
    if newBuffer == nil:
        panic("cheng seq_grow_to_raw: alloc failed")
    *bufferPtr = newBuffer
    *capPtr = newCap
    if newBytes > oldBytes:
        cheng_bytes_set(cheng_ptr_plus(newBuffer, oldBytes), 0, newBytes - oldBytes)

@exportc("cheng_seq_grow_inst")
fn cheng_seq_grow_inst_export(seqPtr: ptr, minCap: int32, elemSize: int32) =
    if seqPtr == nil || minCap <= 0 || elemSize <= 0:
        return
    let seqHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    if seqHdr->len < 0 || seqHdr->cap < 0 || seqHdr->cap < seqHdr->len:
        panic("cheng seq_grow_inst: corrupt header")
    if seqHdr->buffer == nil || minCap > seqHdr->cap:
        var rawBuffer: ptr = seqHdr->buffer
        var rawCap: int32 = seqHdr->cap
        cheng_seq_grow_to_raw_export(&rawBuffer, &rawCap, minCap, elemSize)
        seqHdr->buffer = rawBuffer
        seqHdr->cap = rawCap

@exportc("cheng_seq_poke_len")
fn cheng_seq_poke_len_export(seqPtr: ptr, newLen: int32) =
    if seqPtr == nil:
        return
    let seqHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    seqHdr->len = newLen

@exportc("cheng_seq_next_cap")
fn cheng_seq_next_cap_export(curCap: int32, needLen: int32): int32 =
    return cheng_seq_next_cap_calc(curCap, needLen)

# setLen(seq, target) one-shot bridge: mirrors std/seqs.cheng setLen exactly —
# clamp target to >=0, grow when target>cap or (target>0 && buffer==nil), zero
# the newly exposed tail when target>len, then set len=target. Backend node-eval
# emits a single call to this in place of the cold BODY_OP_SEQ_SET_LEN op.
@exportc("cheng_seq_set_len")
fn cheng_seq_set_len_export(seqPtr: ptr, newLen: int32, elemSize: int32) =
    if seqPtr == nil || elemSize <= 0:
        return
    let seqHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    if seqHdr->len < 0 || seqHdr->cap < 0 || seqHdr->cap < seqHdr->len:
        panic("cheng seq_set_len: corrupt header")
    var target: int32 = newLen
    if target < 0:
        target = 0
    if target > seqHdr->cap || (target > 0 && seqHdr->buffer == nil):
        cheng_seq_grow_inst_export(seqPtr, target, elemSize)
    if target > seqHdr->len:
        # hoist ptr->field 实参到局部 (与上方 grow_inst rawBuffer/rawCap 同形)。
        # 纯路径 AppendCallArgs 对 `seqHdr->X` 曾分槽不写 → zeroTail 读栈垃圾崩;
        # hoist 后实参为具名局部, 不依赖箭形 call-arg 臂 (该臂仍保留作通用修)。
        let zeroTailBuffer: ptr = seqHdr->buffer
        let zeroTailCap: int32 = seqHdr->cap
        let zeroTailLen: int32 = seqHdr->len
        cheng_seq_zero_tail_raw_export(zeroTailBuffer, zeroTailCap, zeroTailLen, target, elemSize)
    seqHdr->len = target

@exportc("cheng_seq_zero_tail_raw")
fn cheng_seq_zero_tail_raw_export(buffer: ptr, seqCap: int32, len: int32, target: int32, elemSize: int32) =
    seqCap
    if buffer == nil || elemSize <= 0:
        return
    if target <= len:
        return
    let fromBytes: int32 = len * elemSize
    let toBytes: int32 = target * elemSize
    if toBytes <= fromBytes:
        return
    cheng_bytes_set(cheng_ptr_plus(buffer, fromBytes), 0, toBytes - fromBytes)

# f64 bit-cast ABI authority. The importc surface (std/system.cheng and the
# f32 helpers in system_helpers_backend.cheng) resolves against these exports;
# system_helpers_backend cannot host them because it is not a provider source.
#
# 位精确机制: 一律走 cheng_bytes_copy 字节搬运, 严禁 `*Int64Ptr(&f64局部)`
# 类型化双关。实测证据 (docs/campaigns/2026-09-21-csg-decision-computer-use/
# evidence/f64_bits_defect_probe.cheng / f64_bits_writeside_probe.cheng):
# 读侧 `return *Int64Ptr(&v64)`(槽已由 float 初始化)位精确; 写侧
# `*Int64Ptr(&v64) = bits`(槽未初始化)对任意输入(含 1、NaN 位型、全 0 高半)
# 槽内字节恒为全 0 —— store 经跨类型域 typed-deref 被后端整体丢弃/错址,
# 不是数值转换。memcpy 语义不做任何数值转换, 与类型域无关。
@exportc("cheng_bits_to_f64")
fn cheng_bits_to_f64(bits: int64): float64 =
    var src: int64 = bits
    var dst: float64
    let srcAddr: ptr = &src
    let dstAddr: ptr = &dst
    cheng_bytes_copy(dstAddr, srcAddr, 8)
    return dst

@exportc("cheng_f64_to_bits")
fn cheng_f64_to_bits(value: float64): int64 =
    var src: float64 = value
    var dst: int64
    let srcAddr: ptr = &src
    let dstAddr: ptr = &dst
    cheng_bytes_copy(dstAddr, srcAddr, 8)
    return dst

# 纯 int64 位逻辑, 不经浮点槽: 指数字段全 1 且尾数非 0。std/system.cheng 的
# f64BitsIsNaN importc 面 在旧驱动上曾链接报 _cheng_f64_bits_is_nan
# undefined —— 本导出补齐定义唯一点; provider reloc 扫描臂
# (system_link_exec_runtime AppendProgramSupportRelocRoots) 会把主对象
# 未决 reloc 自动并入 program_support export roots, 无需注册表改动。
@exportc("cheng_f64_bits_is_nan")
fn cheng_f64_bits_is_nan_export(bits: int64): bool =
    let expBits: int64 = (bits >> 52) & int64(2047)
    let mantBits: int64 = bits & ((int64(1) << 52) - int64(1))
    return expBits == int64(2047) && mantBits != 0

@exportc("cheng_seq_free")
fn cheng_seq_free(seqPtr: ptr) =
    if seqPtr == nil:
        return
    let seqHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    let seqFreeBuffer: ptr = seqHdr->buffer
    if seqFreeBuffer != nil:
        # 普通模式由 registry 证明来源；ledger owner 模式由精确 live-record
        # index、owner generation 和执行线程共同证明来源。无任一证明的裸
        # payload 仍按 allocator-pairing violation 处理。
        let seqFreeProvenance =
            cheng_managed_payload_provenance(seqFreeBuffer)
        if seqFreeProvenance != chengManagedProvenanceNone:
            cheng_mem_release_export(seqFreeBuffer)
        else:
            cheng_mm_foreign_free_total = cheng_mm_foreign_free_total + 1
            if cheng_allocation_ledger_active_owner_index_fast() >= 0:
                cheng_allocation_ledger_abort(
                    "allocation_ledger_duplicate_or_untracked_seq_free")
                return
            panic("cheng seq_free: foreign buffer (allocator pairing violation)")
    seqHdr->buffer = nil
    seqHdr->len = 0
    seqHdr->cap = 0

# Exact store primitive for dynamic sequences whose element layout is plain
# (the compiler rejects str/ref/nested-managed elements before emitting this
# call).  The buffer is the owned object; retain-new-before-release-old also
# makes self-assignment exact.  `cheng_realloc` already performs COW for rc>1.

const chengManagedDropGlueSchemaMagic: int32 = 1129139282
const chengManagedDropGlueSchemaVersion: int32 = 1
const chengManagedDropGlueNodePlain: int32 = 1
const chengManagedDropGlueNodeStr: int32 = 2
const chengManagedDropGlueNodeSequence: int32 = 3
const chengManagedDropGlueNodeAggregate: int32 = 4
const chengManagedDropGlueNodeFixedArray: int32 = 5
const chengManagedDropGlueNodeOptional: int32 = 6
const chengManagedDropGlueNodeEnum: int32 = 7
const chengManagedDropGlueNodeAlias: int32 = 8
const chengManagedDropGlueNodeRefObject: int32 = 9
const chengManagedDropGlueActionValidate: int32 = 1
const chengManagedDropGlueActionClone: int32 = 2
const chengManagedDropGlueActionDrop: int32 = 3
const chengManagedDropGlueActionMove: int32 = 4
const chengManagedDropGlueModeMove: int32 = 1
const chengManagedDropGlueModeBorrow: int32 = 2

fn cheng_managed_drop_glue_read_i32(
        cursor: var ChengManagedDropGlueCursor): int32 =
    if cursor.data == nil || cursor.pos < 0 || cursor.len < 0 ||
       cursor.pos > cursor.len - 4:
        panic("cheng managed aggregate store: descriptor truncated")
    let b0 = int32(*(UInt8Ptr(cheng_ptr_plus(cursor.data, cursor.pos))))
    let b1 = int32(*(UInt8Ptr(cheng_ptr_plus(cursor.data, cursor.pos + 1))))
    let b2 = int32(*(UInt8Ptr(cheng_ptr_plus(cursor.data, cursor.pos + 2))))
    let b3 = int32(*(UInt8Ptr(cheng_ptr_plus(cursor.data, cursor.pos + 3))))
    cursor.pos = cursor.pos + 4
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn cheng_managed_drop_glue_read_node(
        cursor: var ChengManagedDropGlueCursor): ChengManagedDropGlueNode =
    var node: ChengManagedDropGlueNode
    node.tag = cheng_managed_drop_glue_read_i32(cursor)
    node.typeId = cheng_managed_drop_glue_read_i32(cursor)
    node.sizeBytes = cheng_managed_drop_glue_read_i32(cursor)
    node.alignBytes = cheng_managed_drop_glue_read_i32(cursor)
    node.scalarKind = cheng_managed_drop_glue_read_i32(cursor)
    node.fixedLength = cheng_managed_drop_glue_read_i32(cursor)
    node.childCount = cheng_managed_drop_glue_read_i32(cursor)
    node.containsManaged = cheng_managed_drop_glue_read_i32(cursor)
    if node.tag < chengManagedDropGlueNodePlain ||
       node.tag > chengManagedDropGlueNodeRefObject ||
       node.typeId < 0 || node.sizeBytes <= 0 ||
       node.alignBytes <= 0 || node.fixedLength < 0 ||
       node.childCount < 0 ||
       (node.containsManaged != 0 && node.containsManaged != 1):
        panic("cheng managed aggregate store: descriptor node invalid")
    if ((node.tag == chengManagedDropGlueNodePlain ||
         node.tag == chengManagedDropGlueNodeStr ||
         node.tag == chengManagedDropGlueNodeRefObject) &&
        node.childCount != 0) ||
       ((node.tag == chengManagedDropGlueNodeSequence ||
         node.tag == chengManagedDropGlueNodeFixedArray ||
         node.tag == chengManagedDropGlueNodeOptional ||
         node.tag == chengManagedDropGlueNodeAlias) &&
        node.childCount != 1):
        panic("cheng managed aggregate store: descriptor cardinality invalid")
    return node

fn cheng_managed_drop_glue_skip_node(
        cursor: var ChengManagedDropGlueCursor) =
    let node = cheng_managed_drop_glue_read_node(cursor)
    for childIndex in 0..<node.childCount:
        let identityKind = cheng_managed_drop_glue_read_i32(cursor)
        let identityRow = cheng_managed_drop_glue_read_i32(cursor)
        let selectorOrdinal = cheng_managed_drop_glue_read_i32(cursor)
        let byteOffset = cheng_managed_drop_glue_read_i32(cursor)
        let byteWidth = cheng_managed_drop_glue_read_i32(cursor)
        if (identityKind != 1 && identityKind != 2) ||
           identityRow < 0 || selectorOrdinal < 0 ||
           byteOffset < 0 || byteWidth <= 0 ||
           byteOffset > node.sizeBytes - byteWidth:
            panic("cheng managed aggregate store: descriptor member invalid")
        let childStart = cursor.pos
        let child = cheng_managed_drop_glue_read_node(cursor)
        if child.sizeBytes != byteWidth:
            panic("cheng managed aggregate store: descriptor member width drift")
        cursor.pos = childStart
        cheng_managed_drop_glue_skip_node(cursor)

fn cheng_managed_drop_glue_node_contains_at(
        data: ptr,
        len: int32,
        nodeStart: int32): bool =
    var cursor: ChengManagedDropGlueCursor
    cursor.data = data
    cursor.len = len
    cursor.pos = nodeStart
    return cheng_managed_drop_glue_read_node(cursor).containsManaged == 1

fn cheng_managed_drop_glue_validate_seq_header(
        value: ptr,
        elemSize: int32): ChengSeqHeaderPtr =
    if value == nil || elemSize <= 0:
        panic("cheng managed aggregate store: sequence place invalid")
    let hdr = ChengSeqHeaderPtr(value)
    if hdr->len < 0 || hdr->cap < hdr->len ||
       (hdr->buffer == nil && (hdr->len != 0 || hdr->cap != 0)) ||
       (hdr->buffer != nil && hdr->cap <= 0):
        panic("cheng managed aggregate store: corrupt sequence header")
    if hdr->buffer != nil:
        if cheng_managed_payload_provenance(hdr->buffer) ==
               chengManagedProvenanceNone:
            panic("cheng managed aggregate store: foreign sequence buffer")
        let requiredBytes = int64(hdr->cap) * int64(elemSize)
        let payloadBytes = int64(cheng_mem_header_size_get(
            cheng_mem_header(hdr->buffer)))
        if requiredBytes <= int64(0) || requiredBytes > payloadBytes:
            panic("cheng managed aggregate store: sequence payload extent invalid")
    return hdr

fn cheng_managed_drop_glue_walk(
        cursor: var ChengManagedDropGlueCursor,
        target: ptr,
        source: ptr,
        action: int32) =
    let node = cheng_managed_drop_glue_read_node(cursor)
    if action < chengManagedDropGlueActionValidate ||
       action > chengManagedDropGlueActionMove:
        panic("cheng managed aggregate store: action invalid")
    if action == chengManagedDropGlueActionValidate:
        if source == nil:
            panic("cheng managed aggregate store: validation place missing")
    elif action == chengManagedDropGlueActionClone ||
         action == chengManagedDropGlueActionMove:
        if target == nil || source == nil:
            panic("cheng managed aggregate store: transfer place missing")
    elif target == nil:
        panic("cheng managed aggregate store: drop place missing")

    if node.tag == chengManagedDropGlueNodePlain:
        if action == chengManagedDropGlueActionClone ||
           action == chengManagedDropGlueActionMove:
            cheng_bytes_copy(target, source, node.sizeBytes)
            if action == chengManagedDropGlueActionMove:
                cheng_bytes_set(source, 0, node.sizeBytes)
        elif action == chengManagedDropGlueActionDrop:
            cheng_bytes_set(target, 0, node.sizeBytes)
        return

    if node.tag == chengManagedDropGlueNodeStr:
        let value = action == chengManagedDropGlueActionDrop ? target : source
        let raw = StrPtr(value)
        var record: str
        record.data = raw->data
        record.len = raw->len
        record.store_id = raw->store_id
        record.flags = raw->flags
        cheng_str_managed_record_validate(record)
        if action == chengManagedDropGlueActionValidate:
            return
        if action == chengManagedDropGlueActionDrop:
            cheng_str_release_owned(record)
            raw->data = nil
            raw->len = 0
            raw->store_id = 0
            raw->flags = 0
            return
        let out = StrPtr(target)
        if action == chengManagedDropGlueActionClone:
            if record.data != nil && record.flags != chengStrFlagOwned:
                record = cheng_str_copy(record.data, record.len)
            else:
                cheng_str_retain_owned(record)
        out->data = record.data
        out->len = record.len
        out->store_id = record.store_id
        out->flags = record.flags
        if action == chengManagedDropGlueActionMove:
            raw->data = nil
            raw->len = 0
            raw->store_id = 0
            raw->flags = 0
        return

    if node.tag == chengManagedDropGlueNodeRefObject:
        let value = action == chengManagedDropGlueActionDrop ? target : source
        let objectPtr = *(VoidPtrPtr(value))
        if objectPtr != nil &&
           cheng_managed_payload_provenance(objectPtr) ==
               chengManagedProvenanceNone:
            panic("cheng managed aggregate store: foreign ref-object payload")
        if action == chengManagedDropGlueActionValidate:
            return
        if action == chengManagedDropGlueActionDrop:
            if objectPtr != nil:
                cheng_mem_release_export(objectPtr)
            *(VoidPtrPtr(target)) = nil
            return
        *(VoidPtrPtr(target)) = objectPtr
        if action == chengManagedDropGlueActionClone:
            if objectPtr != nil:
                cheng_mem_retain_export(objectPtr)
        else:
            *(VoidPtrPtr(source)) = nil
        return

    if node.tag == chengManagedDropGlueNodeSequence:
        let identityKind = cheng_managed_drop_glue_read_i32(cursor)
        let identityRow = cheng_managed_drop_glue_read_i32(cursor)
        let selectorOrdinal = cheng_managed_drop_glue_read_i32(cursor)
        let byteOffset = cheng_managed_drop_glue_read_i32(cursor)
        let byteWidth = cheng_managed_drop_glue_read_i32(cursor)
        if identityKind != 1 || identityRow < 0 || selectorOrdinal != 0 ||
           byteOffset != 0 || byteWidth <= 0:
            panic("cheng managed aggregate store: sequence descriptor invalid")
        let childStart = cursor.pos
        var childEndCursor = cursor
        cheng_managed_drop_glue_skip_node(childEndCursor)
        cursor.pos = childEndCursor.pos
        let value = action == chengManagedDropGlueActionDrop ? target : source
        let hdr = cheng_managed_drop_glue_validate_seq_header(value, byteWidth)
        if action == chengManagedDropGlueActionValidate:
            if cheng_managed_drop_glue_node_contains_at(
                   cursor.data, cursor.len, childStart):
                for elemIndex in 0..<hdr->len:
                    var elemCursor = cursor
                    elemCursor.pos = childStart
                    cheng_managed_drop_glue_walk(
                        elemCursor,
                        nil,
                        cheng_ptr_plus(hdr->buffer, elemIndex * byteWidth),
                        chengManagedDropGlueActionValidate)
                    if elemCursor.pos != childEndCursor.pos:
                        panic("cheng managed aggregate store: sequence child extent drift")
            return
        if action == chengManagedDropGlueActionDrop:
            if hdr->buffer != nil:
                let rc = cheng_mem_refcount_export(hdr->buffer)
                if rc <= 0:
                    panic("cheng managed aggregate store: sequence refcount invalid")
                if rc == 1 &&
                   cheng_managed_drop_glue_node_contains_at(
                       cursor.data, cursor.len, childStart):
                    for elemIndex in 0..<hdr->len:
                        var elemCursor = cursor
                        elemCursor.pos = childStart
                        cheng_managed_drop_glue_walk(
                            elemCursor,
                            cheng_ptr_plus(hdr->buffer, elemIndex * byteWidth),
                            nil,
                            chengManagedDropGlueActionDrop)
                cheng_mem_release_export(hdr->buffer)
            hdr->len = 0
            hdr->cap = 0
            hdr->buffer = nil
            return
        let outHdr = ChengSeqHeaderPtr(target)
        outHdr->len = hdr->len
        outHdr->cap = hdr->cap
        outHdr->buffer = hdr->buffer
        if action == chengManagedDropGlueActionClone:
            if outHdr->buffer != nil:
                cheng_mem_retain_export(outHdr->buffer)
        else:
            hdr->len = 0
            hdr->cap = 0
            hdr->buffer = nil
        return

    if node.tag == chengManagedDropGlueNodeFixedArray:
        let identityKind = cheng_managed_drop_glue_read_i32(cursor)
        let identityRow = cheng_managed_drop_glue_read_i32(cursor)
        let selectorOrdinal = cheng_managed_drop_glue_read_i32(cursor)
        let byteOffset = cheng_managed_drop_glue_read_i32(cursor)
        let byteWidth = cheng_managed_drop_glue_read_i32(cursor)
        if identityKind != 1 || identityRow < 0 || selectorOrdinal != 0 ||
           byteOffset != 0 || byteWidth <= 0 ||
           node.fixedLength <= 0 ||
           int64(node.fixedLength) * int64(byteWidth) >
               int64(node.sizeBytes):
            panic("cheng managed aggregate store: fixed-array descriptor invalid")
        let childStart = cursor.pos
        var childEndCursor = cursor
        cheng_managed_drop_glue_skip_node(childEndCursor)
        cursor.pos = childEndCursor.pos
        for elemIndex in 0..<node.fixedLength:
            var elemCursor = cursor
            elemCursor.pos = childStart
            let targetElem = target == nil ? nil :
                cheng_ptr_plus(target, elemIndex * byteWidth)
            let sourceElem = source == nil ? nil :
                cheng_ptr_plus(source, elemIndex * byteWidth)
            cheng_managed_drop_glue_walk(
                elemCursor, targetElem, sourceElem, action)
            if elemCursor.pos != childEndCursor.pos:
                panic("cheng managed aggregate store: fixed-array child extent drift")
        return

    if node.tag == chengManagedDropGlueNodeOptional:
        let identityKind = cheng_managed_drop_glue_read_i32(cursor)
        let identityRow = cheng_managed_drop_glue_read_i32(cursor)
        let selectorOrdinal = cheng_managed_drop_glue_read_i32(cursor)
        let byteOffset = cheng_managed_drop_glue_read_i32(cursor)
        let byteWidth = cheng_managed_drop_glue_read_i32(cursor)
        if identityKind != 1 || identityRow < 0 || selectorOrdinal != 0 ||
           byteOffset <= 0 || byteWidth <= 0 ||
           byteOffset > node.sizeBytes - byteWidth:
            panic("cheng managed aggregate store: optional descriptor invalid")
        let sourceTag = source == nil ? 0 :
            int32(*(UInt8Ptr(source)))
        let targetTag = target == nil ? 0 :
            int32(*(UInt8Ptr(target)))
        if (source != nil && sourceTag != 0 && sourceTag != 1) ||
           (target != nil && targetTag != 0 && targetTag != 1):
            panic("cheng managed aggregate store: optional tag invalid")
        if action == chengManagedDropGlueActionValidate:
            if sourceTag == 1:
                cheng_managed_drop_glue_walk(
                    cursor, nil, cheng_ptr_plus(source, byteOffset), action)
            else:
                cheng_managed_drop_glue_skip_node(cursor)
            return
        if action == chengManagedDropGlueActionDrop:
            if targetTag == 1:
                cheng_managed_drop_glue_walk(
                    cursor, cheng_ptr_plus(target, byteOffset), nil, action)
            else:
                cheng_managed_drop_glue_skip_node(cursor)
            *(UInt8Ptr(target)) = uint8(0)
            return
        *(UInt8Ptr(target)) = uint8(sourceTag)
        if sourceTag == 1:
            cheng_managed_drop_glue_walk(
                cursor,
                cheng_ptr_plus(target, byteOffset),
                cheng_ptr_plus(source, byteOffset),
                action)
        else:
            cheng_managed_drop_glue_skip_node(cursor)
        if action == chengManagedDropGlueActionMove:
            *(UInt8Ptr(source)) = uint8(0)
        return

    # Aggregate, alias and enum all consume their exact member CSR in order.
    var sourceEnumTag: int32 = -1
    var targetEnumTag: int32 = -1
    if node.tag == chengManagedDropGlueNodeEnum:
        if node.fixedLength <= 0:
            panic("cheng managed aggregate store: enum variant count invalid")
        if source != nil:
            sourceEnumTag = *(Int32Ptr(source))
            if sourceEnumTag < 0 || sourceEnumTag >= node.fixedLength:
                panic("cheng managed aggregate store: enum source tag invalid")
        if target != nil:
            targetEnumTag = *(Int32Ptr(target))
            if targetEnumTag < 0 || targetEnumTag >= node.fixedLength:
                panic("cheng managed aggregate store: enum target tag invalid")
        if action == chengManagedDropGlueActionClone ||
           action == chengManagedDropGlueActionMove:
            *(Int32Ptr(target)) = sourceEnumTag
    for childIndex in 0..<node.childCount:
        let identityKind = cheng_managed_drop_glue_read_i32(cursor)
        let identityRow = cheng_managed_drop_glue_read_i32(cursor)
        let selectorOrdinal = cheng_managed_drop_glue_read_i32(cursor)
        let byteOffset = cheng_managed_drop_glue_read_i32(cursor)
        let byteWidth = cheng_managed_drop_glue_read_i32(cursor)
        if (identityKind != 1 && identityKind != 2) ||
           identityRow < 0 || selectorOrdinal < 0 ||
           byteOffset < 0 || byteWidth <= 0 ||
           byteOffset > node.sizeBytes - byteWidth:
            panic("cheng managed aggregate store: aggregate member invalid")
        var visit = true
        if node.tag == chengManagedDropGlueNodeEnum:
            if action == chengManagedDropGlueActionDrop:
                visit = selectorOrdinal == targetEnumTag
            else:
                visit = selectorOrdinal == sourceEnumTag
        if visit:
            let childTarget = target == nil ? nil :
                cheng_ptr_plus(target, byteOffset)
            let childSource = source == nil ? nil :
                cheng_ptr_plus(source, byteOffset)
            cheng_managed_drop_glue_walk(
                cursor, childTarget, childSource, action)
        else:
            cheng_managed_drop_glue_skip_node(cursor)
    if node.tag == chengManagedDropGlueNodeEnum &&
       action == chengManagedDropGlueActionDrop:
        *(Int32Ptr(target)) = 0
    if node.tag == chengManagedDropGlueNodeEnum &&
       action == chengManagedDropGlueActionMove:
        *(Int32Ptr(source)) = 0

fn cheng_managed_drop_glue_cursor_at_root(
        descriptor: ptr,
        descriptorLen: int32,
        expectedRootTypeId: int32): ChengManagedDropGlueCursor =
    if descriptor == nil || descriptorLen < 48 ||
       expectedRootTypeId < 0:
        panic("cheng managed aggregate store: descriptor ingress invalid")
    var cursor: ChengManagedDropGlueCursor
    cursor.data = descriptor
    cursor.len = descriptorLen
    if cheng_managed_drop_glue_read_i32(cursor) !=
           chengManagedDropGlueSchemaMagic ||
       cheng_managed_drop_glue_read_i32(cursor) !=
           chengManagedDropGlueSchemaVersion:
        panic("cheng managed aggregate store: descriptor header invalid")
    # Skip the exact 32-byte TypeArena artifact CID. Its digest is bound by the
    # CallOp semantic CID; runtime still checks the binary extent here.
    cursor.pos = cursor.pos + 32
    if cursor.pos > cursor.len - 4 ||
       cheng_managed_drop_glue_read_i32(cursor) != expectedRootTypeId:
        panic("cheng managed aggregate store: descriptor root identity drift")
    return cursor

@exportc("cheng_aggregate_store_managed")
fn cheng_aggregate_store_managed_export(
        target: ptr,
        source: ptr,
        descriptor: ptr,
        descriptorLen: int32,
        expectedRootTypeId: int32,
        mode: int32) =
    if target == nil || source == nil ||
       (mode != chengManagedDropGlueModeMove &&
        mode != chengManagedDropGlueModeBorrow):
        panic("cheng managed aggregate store: invalid arguments")
    var rootCursor = cheng_managed_drop_glue_cursor_at_root(
        descriptor, descriptorLen, expectedRootTypeId)
    let rootStart = rootCursor.pos
    let rootNode = cheng_managed_drop_glue_read_node(rootCursor)
    rootCursor.pos = rootStart
    cheng_managed_drop_glue_skip_node(rootCursor)
    if rootCursor.pos != descriptorLen:
        panic("cheng managed aggregate store: descriptor trailing bytes")
    if target == source:
        return
    let targetRaw = uint64(target)
    let sourceRaw = uint64(source)
    let rootWidth = uint64(rootNode.sizeBytes)
    if (targetRaw < sourceRaw + rootWidth &&
        sourceRaw < targetRaw + rootWidth):
        panic("cheng managed aggregate store: partial alias rejected")
    var validateSource = cheng_managed_drop_glue_cursor_at_root(
        descriptor, descriptorLen, expectedRootTypeId)
    cheng_managed_drop_glue_walk(
        validateSource, nil, source, chengManagedDropGlueActionValidate)
    var validateTarget = cheng_managed_drop_glue_cursor_at_root(
        descriptor, descriptorLen, expectedRootTypeId)
    cheng_managed_drop_glue_walk(
        validateTarget, nil, target, chengManagedDropGlueActionValidate)
    var transferSource = source
    var temporary: ptr = nil
    if mode == chengManagedDropGlueModeBorrow:
        temporary = cheng_malloc_export(rootNode.sizeBytes)
        if temporary == nil:
            panic("cheng managed aggregate store: clone allocation failed")
        cheng_bytes_set(temporary, 0, rootNode.sizeBytes)
        var cloneCursor = cheng_managed_drop_glue_cursor_at_root(
            descriptor, descriptorLen, expectedRootTypeId)
        cheng_managed_drop_glue_walk(
            cloneCursor, temporary, source, chengManagedDropGlueActionClone)
        transferSource = temporary
    var dropCursor = cheng_managed_drop_glue_cursor_at_root(
        descriptor, descriptorLen, expectedRootTypeId)
    cheng_managed_drop_glue_walk(
        dropCursor, target, nil, chengManagedDropGlueActionDrop)
    var moveCursor = cheng_managed_drop_glue_cursor_at_root(
        descriptor, descriptorLen, expectedRootTypeId)
    cheng_managed_drop_glue_walk(
        moveCursor, target, transferSource, chengManagedDropGlueActionMove)
    if temporary != nil:
        cheng_mem_release_export(temporary)

@exportc("cheng_seq_store_plain_managed")
fn cheng_seq_store_plain_managed_export(slot: ptr, valPtr: ptr) =
    if slot == nil || valPtr == nil:
        panic("cheng seq managed store: nil header")
    let outHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(slot)
    let valHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(valPtr)
    if valHdr->len < 0 || valHdr->cap < valHdr->len ||
       (valHdr->buffer == nil && (valHdr->len != 0 || valHdr->cap != 0)) ||
       (valHdr->buffer != nil && valHdr->cap <= 0):
        panic("cheng seq managed store: corrupt source header")
    if outHdr->len < 0 || outHdr->cap < outHdr->len ||
       (outHdr->buffer == nil && (outHdr->len != 0 || outHdr->cap != 0)) ||
       (outHdr->buffer != nil && outHdr->cap <= 0):
        panic("cheng seq managed store: corrupt destination header")
    let nextBuffer: ptr = valHdr->buffer
    let prevBuffer: ptr = outHdr->buffer
    if nextBuffer != nil:
        let nextProvenance =
            cheng_managed_payload_provenance(nextBuffer)
        if nextProvenance == chengManagedProvenanceNone:
            panic("cheng seq managed store: foreign source buffer")
        cheng_mem_retain_export(nextBuffer)
    if prevBuffer != nil:
        let prevProvenance =
            cheng_managed_payload_provenance(prevBuffer)
        if prevProvenance == chengManagedProvenanceNone:
            panic("cheng seq managed store: foreign destination buffer")
        cheng_mem_release_export(prevBuffer)
    outHdr->len = valHdr->len
    outHdr->cap = valHdr->cap
    outHdr->buffer = nextBuffer

@exportc("cheng_seq_move_store_plain_managed")
fn cheng_seq_move_store_plain_managed_export(slot: ptr, valPtr: ptr) =
    if slot == nil || valPtr == nil || slot == valPtr:
        panic("cheng seq managed move-store: invalid headers")
    let outHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(slot)
    let valHdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(valPtr)
    if valHdr->len < 0 || valHdr->cap < valHdr->len ||
       (valHdr->buffer == nil && (valHdr->len != 0 || valHdr->cap != 0)) ||
       (valHdr->buffer != nil && valHdr->cap <= 0):
        panic("cheng seq managed move-store: corrupt source header")
    if outHdr->len < 0 || outHdr->cap < outHdr->len ||
       (outHdr->buffer == nil && (outHdr->len != 0 || outHdr->cap != 0)) ||
       (outHdr->buffer != nil && outHdr->cap <= 0):
        panic("cheng seq managed move-store: corrupt destination header")
    let nextBuffer: ptr = valHdr->buffer
    let prevBuffer: ptr = outHdr->buffer
    if nextBuffer != nil:
        let nextProvenance =
            cheng_managed_payload_provenance(nextBuffer)
        if nextProvenance == chengManagedProvenanceNone:
            panic("cheng seq managed move-store: foreign source buffer")
    if prevBuffer != nil:
        let prevProvenance =
            cheng_managed_payload_provenance(prevBuffer)
        if prevProvenance == chengManagedProvenanceNone:
            panic("cheng seq managed move-store: foreign destination buffer")
        cheng_mem_release_export(prevBuffer)
    outHdr->len = valHdr->len
    outHdr->cap = valHdr->cap
    outHdr->buffer = nextBuffer
    valHdr->len = 0
    valHdr->cap = 0
    valHdr->buffer = nil

@exportc("cheng_seq_slice_alloc")
fn cheng_seq_slice_alloc_export(buffer: ptr, len: int32, startPos: int32, stopPos: int32,
                                exclusive: int32, elemSize: int32, outLen: ptr, outCap: ptr): ptr =
    if outLen != nil:
        *(Int32Ptr(outLen)) = 0
    if outCap != nil:
        *(Int32Ptr(outCap)) = 0
    if buffer == nil || len <= 0 || elemSize <= 0:
        return nil
    var start: int32 = startPos
    if start < 0:
        start = 0
    if start >= len:
        return nil
    var endExclusive: int32 = stopPos
    if exclusive == 0:
        if stopPos < 0:
            return nil
        if stopPos >= 2147483647:
            endExclusive = len
        else:
            endExclusive = stopPos + 1
    if endExclusive <= start:
        return nil
    if endExclusive > len:
        endExclusive = len
    let sliceLen: int32 = endExclusive - start
    if sliceLen <= 0:
        return nil
    let totalBytes: int32 = cheng_seq_alloc_bytes_checked(sliceLen, elemSize)
    let out: ptr = cheng_malloc_export(totalBytes)
    if out == nil:
        panic("cheng seq_slice_alloc: alloc failed")
    cheng_bytes_copy(out, cheng_ptr_plus(buffer, start * elemSize), totalBytes)
    if outLen != nil:
        *(Int32Ptr(outLen)) = sliceLen
    if outCap != nil:
        *(Int32Ptr(outCap)) = sliceLen
    return out

@exportc("cheng_seq_header_len_get")
fn cheng_seq_header_len_get_export(seqPtr: ptr): int32 =
    if seqPtr == nil:
        return 0
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    return hdr->len

@exportc("cheng_seq_header_len_set")
fn cheng_seq_header_len_set_export(seqPtr: ptr, value: int32) =
    if seqPtr == nil:
        return
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    hdr->len = value

@exportc("cheng_seq_header_cap_get")
fn cheng_seq_header_cap_get_export(seqPtr: ptr): int32 =
    if seqPtr == nil:
        return 0
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    return hdr->cap

@exportc("cheng_seq_header_cap_set")
fn cheng_seq_header_cap_set_export(seqPtr: ptr, value: int32) =
    if seqPtr == nil:
        return
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    hdr->cap = value

@exportc("cheng_seq_header_buffer_get")
fn cheng_seq_header_buffer_get_export(seqPtr: ptr): ptr =
    if seqPtr == nil:
        return nil
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    return hdr->buffer

