@exportc("cheng_buffer_handle_byte_bridge")
fn cheng_buffer_handle_byte_bridge_export(handle: uint64, idx: int32): int32 =
    var borrowGeneration: uint64
    let mem = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    let n = cheng_buffer_handle_len(mem)
