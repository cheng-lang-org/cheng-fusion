    # raw `ptr` 目标 + char 值会让 cold_emit_pointer_store 走指针宽(8B)
    # 存储路径, 越界写坏后续堆内存; 与 cheng_rawmem_write_i8_export 同款
    # 显式 UInt8Ptr 单字节存储。
    *(UInt8Ptr(cheng_ptr_plus(dst, idx))) = uint8(value)

