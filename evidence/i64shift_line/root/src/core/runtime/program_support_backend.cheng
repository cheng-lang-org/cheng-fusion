fn cheng_exec_program_signal(pid: int32, signalCode: int32): bool =
    if pid <= 0 || signalCode <= 0:
        return false
    return cheng_host_process_signal_bridge_runtime(int64(pid), signalCode) == 0

fn cheng_exec_program_close_fd_if_valid(fd: var int32) =
    if fd >= 0:
        let _close = libc_close(fd)
        fd = -1

@borrows
fn cheng_runtime_concat_assign(out: var str, part: str) =
    let next = driver_c_str_concat_bridge_export(out, part)
    cheng_str_dispose(out)
    out = next

fn cheng_runtime_concat_assign_cstring(out: var str, part: ptr) =
    var text = cheng_str_copy_cstring(part)
    cheng_runtime_concat_assign(out, text)
    cheng_str_dispose(text)

fn cheng_exec_program_spawn_pipe_argv(argvRaw: ptr,
                                      workingDir: ptr,
                                      mergeStderr: int32,
                                      outReadFd: var int32,
                                      outWriteFd: var int32,
                                      outPid: var int64): int32 =
    outReadFd = -1
    outWriteFd = -1
    outPid = int64(-1)
    if argvRaw == nil:
        return 0
    let program = *(VoidPtrPtr(argvRaw))
    if program == nil || *UInt8Ptr(program) == uint8(0):
        return 0
    let stdoutFds: ptr = cheng_malloc_export(2 * int32(sizeof(int32)))
    if stdoutFds == nil:
        return 0
    cheng_bytes_set(stdoutFds, 0, 2 * int32(sizeof(int32)))
    if libc_pipe_runtime(stdoutFds) != 0:
        cheng_free_export(stdoutFds)
        return 0
    var stdoutReadFd: int32 = cheng_host_fd_at(stdoutFds, 0)
    var stdoutWriteFd: int32 = cheng_host_fd_at(stdoutFds, 1)
    let stdinFds: ptr = cheng_malloc_export(2 * int32(sizeof(int32)))
    if stdinFds == nil:
        cheng_host_close_fd_if_valid(stdoutReadFd)
        cheng_host_close_fd_if_valid(stdoutWriteFd)
        cheng_free_export(stdoutFds)
        return 0
    cheng_bytes_set(stdinFds, 0, 2 * int32(sizeof(int32)))
    if libc_pipe_runtime(stdinFds) != 0:
        cheng_host_close_fd_if_valid(stdoutReadFd)
        cheng_host_close_fd_if_valid(stdoutWriteFd)
        cheng_free_export(stdoutFds)
        cheng_free_export(stdinFds)
        return 0
    var stdinReadFd: int32 = cheng_host_fd_at(stdinFds, 0)
    var stdinWriteFd: int32 = cheng_host_fd_at(stdinFds, 1)
    let pid32: int32 = libc_fork_runtime()
    if pid32 < 0:
        cheng_host_close_fd_if_valid(stdoutReadFd)
        cheng_host_close_fd_if_valid(stdoutWriteFd)
        cheng_host_close_fd_if_valid(stdinReadFd)
        cheng_host_close_fd_if_valid(stdinWriteFd)
        cheng_free_export(stdoutFds)
        cheng_free_export(stdinFds)
        return 0
    if pid32 == 0:
        let _setpgid = libc_setpgid_runtime(0, 0)
        if workingDir != nil && *UInt8Ptr(workingDir) != uint8(0):
            let _chdir = libc_chdir_runtime(workingDir)
        let _dupIn = libc_dup2_runtime(stdinReadFd, 0)
        let _dupOut = libc_dup2_runtime(stdoutWriteFd, 1)
        if mergeStderr != 0:
            let _dupErr = libc_dup2_runtime(stdoutWriteFd, 2)
        cheng_host_close_fd_if_valid(stdoutReadFd)
        cheng_host_close_fd_if_valid(stdoutWriteFd)
        cheng_host_close_fd_if_valid(stdinReadFd)
        cheng_host_close_fd_if_valid(stdinWriteFd)
        let _exec = libc_execvp(program, argvRaw)
        libc__exit_runtime(127)
        return 0
    let _parentSetpgid = libc_setpgid_runtime(pid32, pid32)
    cheng_free_export(stdoutFds)
    cheng_free_export(stdinFds)
    cheng_host_close_fd_if_valid(stdoutWriteFd)
    cheng_host_close_fd_if_valid(stdinReadFd)
    cheng_host_set_nonblock(stdoutReadFd)
    cheng_host_set_nonblock(stdinWriteFd)
    outReadFd = stdoutReadFd
    outWriteFd = stdinWriteFd
    outPid = int64(pid32)
    return 1

fn cheng_exec_program_drain_capture_fd(fd: var int32,
                                       output: var str,
                                       timeoutMs0: int32) =
    if fd < 0:
        return
    var timeoutMs = timeoutMs0
    while fd >= 0:
        var eofFlag: int32
        let rawChunk: ptr = cheng_host_read_text(fd, 65536, timeoutMs, ptr(&eofFlag))
        var chunkText: str = cheng_str_copy_cstring(rawChunk)
        cheng_free_export(rawChunk)
        if cheng_str_len(chunkText) > 0:
            cheng_runtime_concat_assign(output, chunkText)
            cheng_str_dispose(chunkText)
            timeoutMs = 0
            continue
        cheng_str_dispose(chunkText)
        if eofFlag != 0:
            cheng_exec_program_close_fd_if_valid(fd)
        break

@borrows
fn cheng_exec_program_capture_with_timeout(programName: ptr,
                                           argvWire: str,
                                           envWire: str,
                                           workingDir: ptr,
                                           mergeStderr: int32,
                                           timeoutSec: int32,
                                           exitCode: Int64Ptr): ptr =
    cheng_exec_program_set_exit_code(exitCode, -1)
    if programName == nil || *UInt8Ptr(programName) == uint8(0):
        return cheng_exec_program_empty_cstring()
    var readFd: int32 = -1
    var writeFd: int32 = -1
    var pid: int64 = int64(-1)
    if native_cheng_exec_file_pipe_spawn_runtime(programName,
                                                 argvWire,
                                                 envWire,
                                                 workingDir,
                                                 mergeStderr,
                                                 readFd,
                                                 writeFd,
                                                 pid) == 0:
        return cheng_exec_program_empty_cstring()
    cheng_exec_program_close_fd_if_valid(writeFd)
    let startNs: int64 = cheng_monotime_ns_export()
    let timeoutNs: int64 = int64(timeoutSec) * int64(1000000000)
    var timedOut = false
    var termSent = false
    var termAtNs: int64
    var output = ""
    var finalExitCode: int32 = -1
    while true:
        cheng_exec_program_drain_capture_fd(readFd, output, 20)
        let waitStatus: int32 = cheng_pty_wait_bridge(pid)
        if waitStatus == 1:
            finalExitCode = cheng_pty_wait_bridge_last_exit_code()
            break
        if waitStatus < 0:
            finalExitCode = -12
            break
        if timeoutSec > 0:
            let nowNs: int64 = cheng_monotime_ns_export() - startNs
            if nowNs >= timeoutNs:
                timedOut = true
                if !termSent:
                    let _term = cheng_exec_program_signal(int32(pid), chengHostSigterm)
                    termSent = true
                    termAtNs = nowNs
                elif nowNs - termAtNs >= int64(500000000):
                    let _kill = cheng_exec_program_signal(int32(pid), chengHostSigkill)
                cheng_sleep_ms(20)
                continue
        cheng_sleep_ms(10)
    cheng_exec_program_drain_capture_fd(readFd, output, 0)
    cheng_exec_program_close_fd_if_valid(readFd)
    if timedOut:
        finalExitCode = 124
    cheng_exec_program_set_exit_code(exitCode, finalExitCode)
    let outputRaw: ptr = cheng_copy_cstring_from_str(output)
    if outputRaw == nil:
        cheng_str_dispose(output)
        return cheng_exec_program_empty_cstring()
    cheng_str_dispose(output)
    return outputRaw

fn cheng_exec_program_read_capture_file(path: ptr): ptr =
    if path == nil:
        return cheng_exec_program_empty_cstring()
    var pathText = cheng_str_copy_cstring(path)
    var text: str = cheng_read_text_file(pathText)
    cheng_str_dispose(pathText)
    let out: ptr = cheng_copy_cstring_from_str(text)
    cheng_str_dispose(text)
    if out == nil:
        return cheng_exec_program_empty_cstring()
    return out

@exportc("cheng_exec_program_capture_bridge")
fn cheng_exec_program_capture_bridge_export(programName: ptr,
                                               argvWire: ptr,
                                               workingDir: ptr,
