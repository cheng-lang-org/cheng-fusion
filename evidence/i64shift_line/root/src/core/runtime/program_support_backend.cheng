fn cheng_thread_entry_runtime(raw: ptr): ptr =
    if raw == nil:
        return nil
    let task: ChengTaskPtr = ChengTaskPtr(raw)
    let fnPtr: ptr = task.fn_ptr
    let ctx: ptr = task.ctx
    c_free(raw)
    if fnPtr != nil:
        __cheng_call_indirect_void_runtime(fnPtr, ctx)
    return nil

fn cheng_thread_entry0_runtime(raw: ptr): ptr =
    if raw == nil:
        return nil
    let task: ChengTask0Ptr = ChengTask0Ptr(raw)
    let entry: fn() = task->entry
    c_free(raw)
    if entry != nil:
        entry()
    return nil

fn cheng_thread_participant_entry0_runtime(raw: ptr): ptr =
    let encodedRow = uint64(raw)
    if encodedRow == uint64(0) ||
       encodedRow > uint64(chengAllocationLedgerParticipantRowCount):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_row_invalid")
        return nil
    let row = int32(encodedRow - uint64(1))
    cheng_runtime_lock()
    let task =
        cheng_allocation_ledger_participant_start_entry_at(row)
    if task == nil || task->entry == nil ||
       cheng_allocation_ledger_participant_state_load(row) !=
           chengAllocationLedgerParticipantStarted:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_entry_stale")
        return nil
    let entry: fn() = task->entry
    if !cheng_allocation_ledger_participant_tls_bind(row):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_start_tls_bind_failed")
        return nil
    cheng_runtime_unlock()
    entry()
    cheng_runtime_lock()
    if cheng_allocation_ledger_participant_tls_row() >= 0 ||
       cheng_allocation_ledger_participant_state_load(row) !=
           chengAllocationLedgerParticipantPublished:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_terminal_missing")
        return nil
    var clearedEntry: fn()
    task->entry = clearedEntry
    cheng_runtime_unlock()
    return nil

fn cheng_thread_entry_i32_runtime(raw: ptr): ptr =
    if raw == nil:
        return nil
    let task: ChengTaskI32Ptr = ChengTaskI32Ptr(raw)
    let fnPtr: ptr = task.fn_ptr
    let ctx: int32 = task.ctx
    c_free(raw)
    if fnPtr != nil:
        let _ = __cheng_call_indirect_i32_runtime(fnPtr, int64(ctx), 0, 0)
    return nil

@exportc("cheng_thread_spawn")
fn cheng_thread_spawn_export(fnPtr: ptr, ctx: ptr): int32 =
    let thread = cheng_thread_start_export(fnPtr, ctx)
    if thread == nil:
        return 0
    if cheng_thread_detach_export(thread) == 0:
        let _ = c_puts_runtime("cheng_thread_detach_failed")
        c_exit_runtime(1)
    return 1

# worker 线程需大栈：PrimaryBodyIrEvalNode / PrimaryBuildBodyIrFromTypedStatements
# 是数 MB 的冷编码函数，单帧可到数 MB，16MB 仍会写穿 guard。
# attr 任一步失败即 hard-exit (let-it-crash，不静默退默认栈再次溢出崩)。
fn cheng_thread_create_with_bigstack_runtime(threadOut: ptr, startRoutine: ptr, arg: ptr): int32 =
    let attrMem: ptr = c_malloc(int64(256))
    if attrMem == nil:
        let _ = c_puts_runtime("cheng_thread_attr_alloc_failed")
        c_exit_runtime(1)
    if cheng_pthread_attr_init_runtime(attrMem) != 0:
        let _ = c_puts_runtime("cheng_thread_attr_init_failed")
        c_exit_runtime(1)
    if cheng_pthread_attr_setstacksize_runtime(attrMem, int64(67108864)) != 0:
        let _ = c_puts_runtime("cheng_thread_attr_setstacksize_failed")
        c_exit_runtime(1)
    let createStatus = cheng_pthread_create_runtime(threadOut, attrMem, startRoutine, arg)
    let _ = cheng_pthread_attr_destroy_runtime(attrMem)
    c_free(attrMem)
    return createStatus

fn cheng_thread_create_with_bigstack_ledger_locked(
        threadOut: ptr,
        startRoutine: ptr,
        arg: ptr): int32 =
    let attrMem = cheng_malloc_locked(256)
    if attrMem == nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_attr_alloc_failed")
        return -1
    if cheng_pthread_attr_init_runtime(attrMem) != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_attr_init_failed")
        return -1
    if cheng_pthread_attr_setstacksize_runtime(
           attrMem, int64(67108864)) != 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_thread_attr_stack_failed")
        return -1
    let createStatus = cheng_pthread_create_runtime(
        threadOut, attrMem, startRoutine, arg)
    let _ = cheng_pthread_attr_destroy_runtime(attrMem)
    cheng_free_locked(attrMem)
    return createStatus

@exportc("cheng_thread_start")
fn cheng_thread_start_export(fnPtr: ptr, ctx: ptr): ptr =
    cheng_allocation_ledger_forbid_untracked_provider(
        "allocation_ledger_thread_provider_unsupported")
    if fnPtr == nil:
        return nil
    let mem: ptr = c_malloc(int64(sizeof(ChengTask)))
    if mem == nil:
        return nil
    let task: ChengTaskPtr = ChengTaskPtr(mem)
    task->fn_ptr = fnPtr
    task->ctx = ctx
    task->next = nil
    var thread: ptr
    let createStatus = cheng_thread_create_with_bigstack_runtime(ptr(&thread), &cheng_thread_entry_runtime, mem)
    if createStatus != 0:
        c_free(mem)
        return nil
    return thread

@exportc("cheng_thread_start0")
fn cheng_thread_start0_export(entry: fn()): ptr =
    if entry == nil:
        return nil
    cheng_runtime_lock()
    let processOwner = cheng_allocation_ledger_any_active_locked()
    if processOwner != nil:
        let participantRow =
            cheng_allocation_ledger_participant_reserve_thread_start_locked()
        let participantTask =
            cheng_allocation_ledger_participant_start_entry_at(
                participantRow)
        if participantRow < 0 || participantTask == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_participant_thread_start_missing")
            return nil
        participantTask->entry = entry
        cheng_allocation_ledger_participant_state_store(
            participantRow, chengAllocationLedgerParticipantStarted)
        var participantThread: ptr
        let participantCreateStatus =
            cheng_thread_create_with_bigstack_ledger_locked(
                ptr(&participantThread),
                &cheng_thread_participant_entry0_runtime,
                ptr(uint64(participantRow + 1)))
        if participantCreateStatus != 0:
            cheng_allocation_ledger_participant_state_store(
                participantRow, chengAllocationLedgerParticipantIssued)
            cheng_runtime_unlock()
            return nil
        cheng_runtime_unlock()
        return participantThread
    cheng_runtime_unlock()
    cheng_allocation_ledger_forbid_untracked_provider(
        "allocation_ledger_thread_provider_unsupported")
    let mem: ptr = c_malloc(int64(sizeof(ChengTask0)))
    if mem == nil:
        return nil
    let task: ChengTask0Ptr = ChengTask0Ptr(mem)
    task->entry = entry
    var thread: ptr
    let createStatus = cheng_thread_create_with_bigstack_runtime(
        ptr(&thread), &cheng_thread_entry0_runtime, mem)
    if createStatus != 0:
        c_free(mem)
        return nil
    return thread

@exportc("cheng_thread_spawn0")
fn cheng_thread_spawn0_export(entry: fn()): int32 =
    let thread = cheng_thread_start0_export(entry)
    if thread == nil:
