fn cheng_held_exec_wire_zero(wire: var ChengHeldExecWire) =
    cheng_bytes_set(ptr(&wire), 0, chengHeldExecWireBytes)

fn cheng_held_exec_wire_put_u64(
        wire: var ChengHeldExecWire,
        offset: int32,
        value: uint64) =
    if offset < 0 || offset > chengHeldExecWireBytes - 8:
        return
    for byteIndex in 0..<8:
        wire.data[offset + byteIndex] =
            uint8((value >> uint64(byteIndex * 8)) & uint64(255))

@borrows
fn cheng_held_exec_wire_get_u64(
        wire: ChengHeldExecWire,
        offset: int32): uint64 =
    if offset < 0 || offset > chengHeldExecWireBytes - 8:
        return uint64(0)
    var out: uint64
    for byteIndex in 0..<8:
        out = out |
            (uint64(wire.data[offset + byteIndex]) <<
             uint64(byteIndex * 8))
    return out

@borrows
fn cheng_held_exec_wire_get_u32(
        wire: ChengHeldExecWire,
        offset: int32): uint32 =
    if offset < 0 || offset > chengHeldExecWireBytes - 4:
        return uint32(0)
    var out: uint32
    for byteIndex in 0..<4:
        out = out |
            (uint32(wire.data[offset + byteIndex]) <<
             uint32(byteIndex * 8))
    return out

@borrows
fn cheng_held_exec_wire_put_digest(
        wire: var ChengHeldExecWire,
        offset: int32,
        digest: ChengFixedBytes32) =
    if offset < 0 || offset > chengHeldExecWireBytes - 32:
        return
    for byteIndex in 0..<32:
        wire.data[offset + byteIndex] = digest.data[byteIndex]

@borrows
fn cheng_held_exec_wire_get_digest(
        wire: ChengHeldExecWire,
        offset: int32): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    if offset < 0 || offset > chengHeldExecWireBytes - 32:
        return out
    for byteIndex in 0..<32:
        out.data[byteIndex] = wire.data[offset + byteIndex]
    return out

@borrows
fn cheng_held_exec_child_birth_receipt(
        platform: int32,
        childPid: int32,
        childUid: uint32,
        childGid: uint32,
        birth0: uint64,
        birth1: uint64,
        claimReceipt: ChengFixedBytes32,
        executableReceipt: ChengFixedBytes32): ChengFixedBytes32 =
    var canonical: ChengHeldExecWire
    cheng_held_exec_wire_zero(canonical)
    cheng_held_exec_wire_put_u64(canonical, 0, uint64(uint32(platform)))
    cheng_held_exec_wire_put_u64(canonical, 8, uint64(uint32(childPid)))
    cheng_held_exec_wire_put_u64(canonical, 16, uint64(childUid))
    cheng_held_exec_wire_put_u64(canonical, 24, uint64(childGid))
    cheng_held_exec_wire_put_u64(canonical, 32, birth0)
    cheng_held_exec_wire_put_u64(canonical, 40, birth1)
    cheng_held_exec_wire_put_digest(canonical, 64, claimReceipt)
    cheng_held_exec_wire_put_digest(canonical, 96, executableReceipt)
    return cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.child_birth.v1", canonical)

@borrows
fn cheng_held_exec_wire_header(
        wire: var ChengHeldExecWire,
        kind: uint64,
        sequence: uint64,
        nonce: ChengFixedBytes32) =
    cheng_held_exec_wire_zero(wire)
    cheng_held_exec_wire_put_u64(wire, 0, chengHeldExecMagic)
    cheng_held_exec_wire_put_u64(wire, 8, chengHeldExecVersion)
    cheng_held_exec_wire_put_u64(wire, 16, kind)
    cheng_held_exec_wire_put_u64(wire, 24, sequence)
    cheng_held_exec_wire_put_digest(wire, 32, nonce)

@borrows
fn cheng_held_exec_wire_header_valid(
        wire: ChengHeldExecWire,
        kind: uint64,
        sequence: uint64,
        nonce: ChengFixedBytes32): bool =
    return cheng_held_exec_wire_get_u64(wire, 0) ==
               chengHeldExecMagic &&
        cheng_held_exec_wire_get_u64(wire, 8) ==
               chengHeldExecVersion &&
        cheng_held_exec_wire_get_u64(wire, 16) == kind &&
        cheng_held_exec_wire_get_u64(wire, 24) == sequence &&
        cheng_fixed32_equal(
            cheng_held_exec_wire_get_digest(wire, 32), nonce)

@borrows
fn cheng_held_exec_digest_nonzero(value: ChengFixedBytes32): bool =
    for byteIndex in 0..<32:
        if value.data[byteIndex] != uint8(0):
            return true
    return false

fn cheng_held_exec_wire_digest(
        domain: ptr,
        wire: var ChengHeldExecWire): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    let domainLength = cheng_cstrlen_raw(domain)
    if domain == nil || domainLength <= 0 ||
       !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]) ||
       !cheng_sha256_stream_update_u32le(&stream, domainLength) ||
       !cheng_sha256_stream_update(
           &stream, domain, int64(domainLength)) ||
       !cheng_sha256_stream_update(
           &stream, ptr(&wire), int64(chengHeldExecWireBytes)) ||
       !cheng_sha256_stream_finish(&stream, &out.data[0]):
        return ChengFixedBytes32()
    return out

# Match CsgCoreMerkleStoreDomainBytesCid exactly for the immutable 224-byte
# observation canonical: u32le(domain length), domain, u32le(byte count),
# then precisely the first 224 bytes of the fixed runtime wire.
fn cheng_held_exec_terminal_observation_canonical_digest(
        domain: ptr,
        wire: var ChengHeldExecWire): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    let domainLength = cheng_cstrlen_raw(domain)
    if domain == nil || domainLength <= 0 ||
       !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]) ||
       !cheng_sha256_stream_update_u32le(&stream, domainLength) ||
       !cheng_sha256_stream_update(
           &stream, domain, int64(domainLength)) ||
       !cheng_sha256_stream_update_u32le(
           &stream, chengHeldExecTerminalObservationCanonicalBytes) ||
       !cheng_sha256_stream_update(
           &stream,
           ptr(&wire),
           int64(chengHeldExecTerminalObservationCanonicalBytes)) ||
       !cheng_sha256_stream_finish(&stream, &out.data[0]):
        return ChengFixedBytes32()
    return out

# Match CsgCoreMerkleStoreDomainBytesCid for the exact finalized 512-byte
# journal record. The caller supplies a copy whose embedded receipt field is
# already zero, so the digest is reproducible from the durable record bytes.
fn cheng_held_exec_terminal_journal_record_digest(
        wire: var ChengHeldExecWire): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    let domain: ptr =
        "cheng.runtime.held_exec.terminal_journal.record.v1"
    let domainLength = cheng_cstrlen_raw(domain)
    if domainLength <= 0 ||
       !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]) ||
       !cheng_sha256_stream_update_u32le(&stream, domainLength) ||
       !cheng_sha256_stream_update(
           &stream, domain, int64(domainLength)) ||
       !cheng_sha256_stream_update_u32le(
           &stream, chengHeldExecTerminalJournalRecordBytes) ||
       !cheng_sha256_stream_update(
           &stream,
           ptr(&wire),
           int64(chengHeldExecTerminalJournalRecordBytes)) ||
       !cheng_sha256_stream_finish(&stream, &out.data[0]):
        return ChengFixedBytes32()
    return out

fn cheng_held_exec_argv_digest(
        firstArgOverride: ptr): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    let count = cheng_runtime_param_count()
    if count <= 0:
        return out
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    let domain: ptr = "cheng.runtime.held_exec.argv.v1"
    let domainLength = cheng_cstrlen_raw(domain)
    if !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]) ||
       !cheng_sha256_stream_update_u32le(&stream, domainLength) ||
       !cheng_sha256_stream_update(
           &stream, domain, int64(domainLength)) ||
       !cheng_sha256_stream_update_u32le(&stream, count):
        return out
    for argIndex in 0..<count:
        var raw = cheng_runtime_param_raw(argIndex)
        if argIndex == 0 && firstArgOverride != nil:
            raw = firstArgOverride
        if raw == nil:
            return ChengFixedBytes32()
        let argLength = cheng_cstrlen_raw(raw)
        if argLength < 0 ||
           !cheng_sha256_stream_update_u32le(
               &stream, argLength) ||
           !cheng_sha256_stream_update(
               &stream, raw, int64(argLength)):
            return ChengFixedBytes32()
    if !cheng_sha256_stream_finish(&stream, &out.data[0]):
        return ChengFixedBytes32()
    return out

fn cheng_held_exec_empty_environment_digest(): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    let domain: ptr = "cheng.runtime.held_exec.environment.v1"
    let domainLength = cheng_cstrlen_raw(domain)
    var frame: uint8[64]
    cheng_bytes_set(ptr(&frame), 0, 64)
    if domainLength <= 0 || domainLength > 56:
        return out
    cheng_bytes_copy(ptr(&frame), domain, domainLength)
    if !cheng_allocation_ledger_sha256_noalloc(
           ptr(&frame), domainLength, &out.data[0]):
        return ChengFixedBytes32()
    return out

fn cheng_held_exec_send_wire(
        fd: int32,
        wire: var ChengHeldExecWire): bool =
    if fd < 0:
        return false
    return libc_write_runtime(
        fd, ptr(&wire), chengHeldExecWireBytes) ==
        int64(chengHeldExecWireBytes)

fn cheng_held_exec_send_wire_with_fd(
        fd: int32,
        wire: var ChengHeldExecWire,
        passedFd: int32): bool =
    return fd >= 0 && passedFd >= 0 &&
        libc_send_fd_runtime(
            fd,
            ptr(&wire),
            chengHeldExecWireBytes,
            passedFd) == chengHeldExecWireBytes

fn cheng_held_exec_send_wire_with_fd_vector3(
        fd: int32,
        wire: var ChengHeldExecWire,
        fd0: int32,
        fd1: int32,
        fd2: int32): bool =
    if fd < 0 || fd0 < 0 || fd1 < 0 || fd2 < 0 ||
       fd0 == fd1 || fd0 == fd2 || fd1 == fd2:
        return false
    let sent = cheng_host_is_darwin() ?
        libc_darwin_send_fd_vector_runtime(
            fd,
            ptr(&wire),
            chengHeldExecWireBytes,
            fd0,
            fd1,
            fd2,
            chengHeldExecActivateAncillaryFdCount) :
        libc_send_fd_vector_runtime(
            fd,
            ptr(&wire),
            chengHeldExecWireBytes,
            fd0,
            fd1,
            fd2,
            chengHeldExecActivateAncillaryFdCount)
    return sent == chengHeldExecWireBytes

fn cheng_held_exec_receive_wire_with_fd_vector3(
        fd: int32,
        ownerRow: int32,
        wire: var ChengHeldExecWire):
        ChengHeldExecCredentialedVector3ReceiveResult =
    if fd < 0 || ownerRow < 0 || ownerRow >= 4 ||
       chengHeldExecChildCapsuleRoleStates[ownerRow] !=
           chengHeldExecChildCapsuleRoleOpening:
        return ChengHeldExecCredentialedVector3ReceiveResult()
    cheng_held_exec_wire_zero(wire)
    let nativeOwner = cheng_host_is_darwin() ?
        libc_darwin_recv_fd_vector_runtime(
            fd,
            ptr(&wire),
            chengHeldExecWireBytes) :
        libc_recv_credentialed_fd_vector_runtime(
            fd,
            ptr(&wire),
            chengHeldExecWireBytes)
    # The host owner existed before recvmsg. Bind only its opaque positive
    # row here; raw descriptor numbers never cross this module boundary.
    cheng_runtime_lock()
    chengHeldExecChildCapsuleRoleNativeReceiveOwners[ownerRow] = nativeOwner
    cheng_runtime_unlock()
    if nativeOwner <= 0:
        return ChengHeldExecCredentialedVector3ReceiveResult()
    let receivedPid =
        libc_terminal_activate_receive_owner_pid(nativeOwner)
    let receivedUid =
        libc_terminal_activate_receive_owner_uid(nativeOwner)
    let receivedGid =
        libc_terminal_activate_receive_owner_gid(nativeOwner)
    chengHeldExecChildCapsuleRoleParentPids[ownerRow] = receivedPid
    chengHeldExecChildCapsuleRoleParentUids[ownerRow] = receivedUid
    chengHeldExecChildCapsuleRoleParentGids[ownerRow] = receivedGid
    return ChengHeldExecCredentialedVector3ReceiveResult(
        status: libc_terminal_activate_receive_owner_status(nativeOwner),
        pid: receivedPid,
        uid: receivedUid,
        gid: receivedGid)

fn cheng_held_exec_receive_wire_with_optional_fd(
        fd: int32,
        wire: var ChengHeldExecWire): ChengHeldExecCredentialedReceiveResult =
    if fd < 0:
        return ChengHeldExecCredentialedReceiveResult()
    cheng_held_exec_wire_zero(wire)
    var receivedFd: int32 = -1
    var receivedPid: int32 = -1
    var receivedUid: uint32
    var receivedGid: uint32
    let received = libc_recv_credentialed_optional_fd_runtime(
        fd,
        ptr(&wire),
        chengHeldExecWireBytes,
        ptr(&receivedFd),
        ptr(&receivedPid),
        ptr(&receivedUid),
        ptr(&receivedGid))
    return ChengHeldExecCredentialedReceiveResult(
        status: received == chengHeldExecWireBytes ? 1 : 0,
        fd: receivedFd,
        pid: receivedPid,
        uid: receivedUid,
        gid: receivedGid)

fn cheng_held_exec_receive_wire(
        fd: int32,
        wire: var ChengHeldExecWire): ChengHeldExecCredentialedReceiveResult =
    let received = cheng_held_exec_receive_wire_with_optional_fd(fd, wire)
    if received.status == 1 && received.fd >= 0:
        let _closeUnexpected = libc_close(received.fd)
        return ChengHeldExecCredentialedReceiveResult()
    return received

fn cheng_held_exec_credentials_match(
        actualPid: int32,
        actualUid: uint32,
        actualGid: uint32,
        expectedPid: int32,
        expectedUid: uint32,
        expectedGid: uint32): bool =
    return actualPid == expectedPid && actualUid == expectedUid &&
        actualGid == expectedGid

fn cheng_held_exec_receive_wire_from(
        fd: int32,
        wire: var ChengHeldExecWire,
        expectedPid: int32,
        expectedUid: uint32,
        expectedGid: uint32): bool =
    let received = cheng_held_exec_receive_wire(fd, wire)
    return received.status == 1 &&
        cheng_held_exec_credentials_match(
            received.pid,
            received.uid,
            received.gid,
            expectedPid,
            expectedUid,
            expectedGid)

fn cheng_held_exec_receive_wire_with_optional_fd_from(
        fd: int32,
        wire: var ChengHeldExecWire,
        expectedPid: int32,
        expectedUid: uint32,
        expectedGid: uint32): ChengHeldExecCredentialedReceiveResult =
    let received = cheng_held_exec_receive_wire_with_optional_fd(fd, wire)
    if received.status == 1 &&
       !cheng_held_exec_credentials_match(
           received.pid,
           received.uid,
           received.gid,
           expectedPid,
           expectedUid,
           expectedGid):
        if received.fd >= 0:
            let _closeWrongSender = libc_close(received.fd)
        return ChengHeldExecCredentialedReceiveResult()
    return received

fn cheng_held_exec_hex_nibble(value: uint8): int32 =
    if value >= uint8(int32('0')) && value <= uint8(int32('9')):
        return int32(value) - int32('0')
    if value >= uint8(int32('a')) && value <= uint8(int32('f')):
        return int32(value) - int32('a') + 10
    return -1

@borrows
fn cheng_held_exec_cid_digest_into(
        cid: str,
        out: var ChengFixedBytes32): bool =
    out = ChengFixedBytes32()
    if cheng_str_len(cid) != 71 || cheng_str_data(cid) == nil:
        return false
    let raw = cheng_str_data(cid)
    let prefix: ptr = "sha256:"
    for prefixIndex in 0..<7:
        if *(UInt8Ptr(cheng_ptr_plus(raw, prefixIndex))) !=
           *(UInt8Ptr(cheng_ptr_plus(prefix, prefixIndex))):
            return false
    for byteIndex in 0..<32:
        let high = cheng_held_exec_hex_nibble(
            *(UInt8Ptr(cheng_ptr_plus(raw, 7 + byteIndex * 2))))
        let low = cheng_held_exec_hex_nibble(
            *(UInt8Ptr(cheng_ptr_plus(raw, 8 + byteIndex * 2))))
        if high < 0 || low < 0:
            out = ChengFixedBytes32()
            return false
        out.data[byteIndex] = uint8(high * 16 + low)
    return cheng_held_exec_digest_nonzero(out)

fn cheng_held_exec_file_identity_digest(
        fd: int32,
        out: var ChengFixedBytes32): bool =
    out = ChengFixedBytes32()
    var size: int64
    var mode: int32
    var device: uint64
    var inode: uint64
    if fd < 0 ||
       libc_fstat_scalars_runtime(
           fd, &size, &mode, &device, &inode) != 0 ||
       size <= 0 || device == uint64(0) || inode == uint64(0):
        return false
    var frame: uint8[40]
    cheng_bytes_set(ptr(&frame), 0, 40)
    *(UInt64Ptr(ptr(&frame))) = device
    *(UInt64Ptr(cheng_ptr_plus(ptr(&frame), 8))) = inode
    *(Int64Ptr(cheng_ptr_plus(ptr(&frame), 16))) = size
    *(Int32Ptr(cheng_ptr_plus(ptr(&frame), 24))) = mode
    let domain: ptr = "cheng.runtime.held_exec.file_identity.v1"
    let domainLength = cheng_cstrlen_raw(domain)
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    return cheng_sha256_stream_init_fixed(
            &stream,
            &stateStorage.data[0],
            &tableStorage.data[0],
            &blockStorage.data[0]) &&
        cheng_sha256_stream_update_u32le(&stream, domainLength) &&
        cheng_sha256_stream_update(
            &stream, domain, int64(domainLength)) &&
        cheng_sha256_stream_update(
            &stream, ptr(&frame), int64(28)) &&
        cheng_sha256_stream_finish(&stream, &out.data[0])

@borrows
fn cheng_held_exec_output_path_digest_into(
        path: str,
        out: var ChengFixedBytes32): bool =
    out = ChengFixedBytes32()
    let pathLength = cheng_str_len(path)
    let pathBytes = cheng_str_data(path)
    let domain: ptr = "cheng.runtime.held_exec.output_path.v1"
    let domainLength = cheng_cstrlen_raw(domain)
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    return pathLength > 0 && pathBytes != nil &&
        !cheng_str_contains_nul(path) && domainLength > 0 &&
        cheng_sha256_stream_init_fixed(
            &stream,
            &stateStorage.data[0],
            &tableStorage.data[0],
            &blockStorage.data[0]) &&
        cheng_sha256_stream_update_u32le(&stream, domainLength) &&
        cheng_sha256_stream_update(
            &stream, domain, int64(domainLength)) &&
        cheng_sha256_stream_update_u32le(&stream, pathLength) &&
        cheng_sha256_stream_update(
            &stream, pathBytes, int64(pathLength)) &&
        cheng_sha256_stream_finish(&stream, &out.data[0]) &&
        cheng_held_exec_digest_nonzero(out)

fn cheng_held_exec_fd_content_digest_status_into(
        fd: int32,
        out: var ChengFixedBytes32,
        outBytes: var uint64): int32 =
    out = ChengFixedBytes32()
    outBytes = uint64(0)
    var sizeBefore: int64
    var modeBefore: int32
    var deviceBefore: uint64
    var inodeBefore: uint64
    if fd < 0 ||
       libc_fstat_scalars_runtime(
           fd,
           &sizeBefore,
           &modeBefore,
           &deviceBefore,
           &inodeBefore) != 0 ||
       sizeBefore <= 0 || deviceBefore == uint64(0) ||
       inodeBefore == uint64(0) ||
       (modeBefore & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       libc_lseek_runtime(
           fd, int64(0), chengHeldExecSeekSet) != int64(0):
        return -1
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    if !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]):
        return -2
    var buffer: uint8[65536]
    var total: int64
    while total < sizeBefore:
        var want = sizeBefore - total
        if want > int64(65536):
            want = int64(65536)
        let amount = libc_read_runtime(
            fd, ptr(&buffer), int32(want))
        if amount <= int64(0) || amount > want ||
           !cheng_sha256_stream_update(
               &stream, ptr(&buffer), amount):
            return -3
        total = total + amount
    var extra: uint8[1]
    if libc_read_runtime(fd, ptr(&extra), 1) != int64(0) ||
       !cheng_sha256_stream_finish(&stream, &out.data[0]):
        return -4
    var sizeAfter: int64
    var modeAfter: int32
    var deviceAfter: uint64
    var inodeAfter: uint64
    if libc_fstat_scalars_runtime(
           fd,
           &sizeAfter,
           &modeAfter,
           &deviceAfter,
           &inodeAfter) != 0 ||
       sizeAfter != sizeBefore || modeAfter != modeBefore ||
       deviceAfter != deviceBefore || inodeAfter != inodeBefore ||
       !cheng_held_exec_digest_nonzero(out):
        return -5
    outBytes = uint64(sizeBefore)
    return 1

fn cheng_held_exec_fd_content_digest_into(
        fd: int32,
        out: var ChengFixedBytes32,
        outBytes: var uint64): bool =
    return cheng_held_exec_fd_content_digest_status_into(
        fd, out, outBytes) == 1

fn cheng_held_exec_native_receive_owner_content_digest_into(
        owner: int32,
        role: int32,
        out: var ChengFixedBytes32,
        outBytes: var uint64): bool =
    out = ChengFixedBytes32()
    outBytes = uint64(0)
    var sizeBefore: int64
    var modeBefore: int32
    var deviceBefore: uint64
    var inodeBefore: uint64
    if owner <= 0 ||
       libc_terminal_activate_receive_owner_fstat(
           owner,
           role,
           &sizeBefore,
           &modeBefore,
           &deviceBefore,
           &inodeBefore) != 0 ||
       sizeBefore <= 0 || deviceBefore == uint64(0) ||
       inodeBefore == uint64(0) ||
       (modeBefore & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       libc_terminal_activate_receive_owner_lseek(
           owner,
           role,
           int64(0),
           chengHeldExecSeekSet) != int64(0):
        return false
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    if !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]):
        return false
    var buffer: uint8[65536]
    var total: int64
    while total < sizeBefore:
        var want = sizeBefore - total
        if want > int64(65536):
            want = int64(65536)
        let amount = libc_terminal_activate_receive_owner_read(
            owner, role, ptr(&buffer), int32(want))
        if amount <= int64(0) || amount > want ||
           !cheng_sha256_stream_update(
               &stream, ptr(&buffer), amount):
            return false
        total = total + amount
    var extra: uint8[1]
    if libc_terminal_activate_receive_owner_read(
           owner, role, ptr(&extra), 1) != int64(0) ||
       !cheng_sha256_stream_finish(&stream, &out.data[0]):
        return false
    var sizeAfter: int64
    var modeAfter: int32
    var deviceAfter: uint64
    var inodeAfter: uint64
    if libc_terminal_activate_receive_owner_fstat(
           owner,
           role,
           &sizeAfter,
           &modeAfter,
           &deviceAfter,
           &inodeAfter) != 0 ||
       sizeAfter != sizeBefore || modeAfter != modeBefore ||
       deviceAfter != deviceBefore || inodeAfter != inodeBefore ||
       !cheng_held_exec_digest_nonzero(out):
        return false
    outBytes = uint64(sizeBefore)
    return true

@exportc("cheng_held_exec_fd_content_sha256")
@abi_internal
fn cheng_held_exec_fd_content_sha256_export(
        fd: int32): ChengHeldExecFdDigestResult =
    if fd < 0:
        return ChengHeldExecFdDigestResult(status: -6)
    var digest: ChengFixedBytes32
    var byteCount: uint64
    let status = cheng_held_exec_fd_content_digest_status_into(
        fd, digest, byteCount)
    if status != 1:
        return ChengHeldExecFdDigestResult(status: status)
    var digestWire: ChengHeldExecWire
    cheng_held_exec_wire_zero(digestWire)
    cheng_held_exec_wire_put_digest(digestWire, 0, digest)
    let digest0 = cheng_held_exec_wire_get_u64(digestWire, 0)
    let digest1 = cheng_held_exec_wire_get_u64(digestWire, 8)
    let digest2 = cheng_held_exec_wire_get_u64(digestWire, 16)
    let digest3 = cheng_held_exec_wire_get_u64(digestWire, 24)
    return ChengHeldExecFdDigestResult(
        status: 1,
        byteCount: byteCount,
        digest0: digest0,
        digest1: digest1,
        digest2: digest2,
        digest3: digest3)

@borrows
fn cheng_held_exec_parent_seal_bundle_raw(
        envelopeBytes: str,
        expectedHeldBundleCid: str): ChengHeldExecBundleSealResult =
    let platformKind = cheng_read_only_mapped_region_platform_kind()
    if platformKind == chengReadOnlyMappedRegionPlatformLinuxX64 ||
       platformKind == chengReadOnlyMappedRegionPlatformLinuxA64:
        return cheng_held_exec_parent_seal_bundle_linux_raw(
            envelopeBytes, expectedHeldBundleCid)
    if platformKind == chengReadOnlyMappedRegionPlatformDarwinA64:
        return cheng_held_exec_parent_seal_bundle_darwin_raw(
            envelopeBytes, expectedHeldBundleCid)
    return ChengHeldExecBundleSealResult(
        errorCode: chengHeldExecBundleSealErrPlatform, fd: -1)

# Linux seal: kernel-pinned anonymous memory.  memfd_create yields an
# unnamed regular file and F_ADD_SEALS(15) = F_SEAL_SEAL | F_SEAL_SHRINK |
# F_SEAL_GROW | F_SEAL_WRITE pins content, size and the seal set itself
# against every descriptor holder for the lifetime of the object.
# F_GET_SEALS is the kernel-enforced attestation every consumer re-reads.
@borrows
fn cheng_held_exec_parent_seal_bundle_linux_raw(
        envelopeBytes: str,
        expectedHeldBundleCid: str): ChengHeldExecBundleSealResult =
    let byteCount = cheng_str_len(envelopeBytes)
    let byteData = cheng_str_data(envelopeBytes)
    if byteCount <= 0 || byteCount > chengHeldExecBundleMaxBytes ||
       byteData == nil:
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrBytes, fd: -1)
    var expectedDigest: ChengFixedBytes32
    if !cheng_held_exec_cid_digest_into(
           expectedHeldBundleCid, expectedDigest):
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrIdentity, fd: -1)
    let fd = libc_memfd_create_runtime(
        "cheng-held-bundle", chengHeldExecMemfdFlags)
    if fd <= 2:
        if fd >= 0:
            let _closeInvalid = libc_close(fd)
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    var written: int32
    while written < byteCount:
        let amount = libc_write_runtime(
            fd,
            cheng_ptr_plus(byteData, written),
            byteCount - written)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) ||
           amount > int64(byteCount - written):
            let _closeWrite = libc_close(fd)
            return ChengHeldExecBundleSealResult(
                errorCode: chengHeldExecBundleSealErrWrite, fd: -1)
        written = written + int32(amount)
    if written != byteCount ||
       libc_lseek_runtime(fd, int64(0), chengHeldExecSeekSet) != int64(0) ||
       libc_fcntl_native(
           fd,
           chengHeldExecFAddSeals,
           chengHeldExecRequiredSeals) != 0 ||
       libc_fcntl_native(fd, chengHeldExecFGetSeals, 0) !=
           chengHeldExecRequiredSeals:
        let _closeSeal = libc_close(fd)
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrSeal, fd: -1)
    var actualDigest: ChengFixedBytes32
    var actualBytes: uint64
    var size: int64
    var mode: int32
    var device: uint64
    var inode: uint64
    if !cheng_held_exec_fd_content_digest_into(
           fd, actualDigest, actualBytes) ||
       actualBytes != uint64(byteCount) ||
       !cheng_fixed32_equal(actualDigest, expectedDigest) ||
       libc_fstat_scalars_runtime(
           fd, &size, &mode, &device, &inode) != 0 ||
       size != int64(byteCount) ||
       (mode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       device == uint64(0) || inode == uint64(0) ||
       libc_fcntl_native(fd, chengHeldExecFGetSeals, 0) !=
           chengHeldExecRequiredSeals ||
       libc_lseek_runtime(fd, int64(0), chengHeldExecSeekSet) != int64(0):
        let _closeVerify = libc_close(fd)
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrVerify, fd: -1)
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(projection, 0, actualDigest)
    let digest0 = cheng_held_exec_wire_get_u64(projection, 0)
    let digest1 = cheng_held_exec_wire_get_u64(projection, 8)
    let digest2 = cheng_held_exec_wire_get_u64(projection, 16)
    let digest3 = cheng_held_exec_wire_get_u64(projection, 24)
    return ChengHeldExecBundleSealResult(
        status: 1,
        fd: fd,
        byteCount: actualBytes,
        digest0: digest0,
        digest1: digest1,
        digest2: digest2,
        digest3: digest3)

# Darwin has no memfd_create and no F_ADD_SEALS.  The equivalent sealed
# object is an anonymous unlinked regular file whose only remaining handle
# is O_RDONLY: the write descriptor is closed before the name is removed,
# so after the freeze point no writable handle exists and none can be
# recreated (no pathname to reopen, O_RDONLY cannot gain write access via
# F_SETFL, ftruncate and PROT_WRITE mmap require write permission).
# SCM_RIGHTS copies preserve the O_RDONLY status, so every later consumer
# attests the same facts: handle read-only + st_nlink == 0.
fn cheng_held_exec_bundle_seal_attest_fd(fd: int32): bool =
    let platformKind = cheng_read_only_mapped_region_platform_kind()
    if platformKind == chengReadOnlyMappedRegionPlatformDarwinA64:
        let statusFlags = libc_fcntl_native(fd, chengHeldExecFGetFl, 0)
        if statusFlags < 0 ||
           (statusFlags & chengHeldExecAccessModeMask) !=
               chengHeldExecAccessReadOnly:
            return false
        var linkCount: uint64
        return libc_fstat_nlink_runtime(
            fd, ptr(&linkCount)) == 0 && linkCount == uint64(0)
    return libc_fcntl_native(
        fd, chengHeldExecFGetSeals, 0) == chengHeldExecRequiredSeals

fn cheng_held_exec_bundle_seal_attest_owner(
        owner: int32,
        role: int32): bool =
    let platformKind = cheng_read_only_mapped_region_platform_kind()
    if platformKind == chengReadOnlyMappedRegionPlatformDarwinA64:
        let statusFlags = libc_terminal_activate_receive_owner_fcntl(
            owner, role, chengHeldExecFGetFl)
        if statusFlags < 0 ||
           (statusFlags & chengHeldExecAccessModeMask) !=
               chengHeldExecAccessReadOnly:
            return false
        var linkCount: uint64
        return libc_terminal_activate_receive_owner_nlink(
            owner, role, ptr(&linkCount)) == 0 && linkCount == uint64(0)
    return libc_terminal_activate_receive_owner_fcntl(
        owner, role, chengHeldExecFGetSeals) == chengHeldExecRequiredSeals

# Darwin seal: freeze the envelope bytes into an anonymous read-only
# regular file staged inside a 0700 entropy-named directory that is removed
# before this provider returns, so no task-scoped residue can outlive the
# call on any path.
@borrows
fn cheng_held_exec_parent_seal_bundle_darwin_raw(
        envelopeBytes: str,
        expectedHeldBundleCid: str): ChengHeldExecBundleSealResult =
    let byteCount = cheng_str_len(envelopeBytes)
    let byteData = cheng_str_data(envelopeBytes)
    if byteCount <= 0 || byteCount > chengHeldExecBundleMaxBytes ||
       byteData == nil:
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrBytes, fd: -1)
    var expectedDigest: ChengFixedBytes32
    if !cheng_held_exec_cid_digest_into(
           expectedHeldBundleCid, expectedDigest):
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrIdentity, fd: -1)
    var dirPath: uint8[512]
    cheng_bytes_set(ptr(&dirPath), 0, chengHeldExecSealStagePathBytes)
    var basePtr: ptr = libc_getenv_runtime("TMPDIR")
    var offset: int32
    if basePtr != nil:
        offset = int32(libc_strlen_runtime(basePtr))
    if offset < 0 || offset > chengHeldExecSealStagePathBytes - 49:
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    if offset == 0:
        let fallback: ptr = "/private/tmp"
        offset = 12
        cheng_bytes_copy(ptr(&dirPath), fallback, offset)
    else:
        cheng_bytes_copy(ptr(&dirPath), basePtr, offset)
        while offset > 1 && dirPath[offset - 1] == uint8(47):
            offset = offset - 1
    if offset + 1 + 16 + 32 > chengHeldExecSealStagePathBytes - 1:
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    dirPath[offset] = uint8(47)
    offset = offset + 1
    let marker: ptr = "cheng-held-seal."
    cheng_bytes_copy(cheng_ptr_plus(ptr(&dirPath), offset), marker, 16)
    offset = offset + 16
    var entropy: uint8[16]
    if cheng_system_entropy_fill(ptr(&entropy), 16) != 1:
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    for byteIndex in 0..<16:
        let high = int32(entropy[byteIndex]) >> 4
        let low = int32(entropy[byteIndex]) & 15
        dirPath[offset + byteIndex * 2] =
            uint8(high < 10 ? 48 + high : 87 + high)
        dirPath[offset + byteIndex * 2 + 1] =
            uint8(low < 10 ? 48 + low : 87 + low)
    dirPath[offset + 32] = uint8(0)
    if libc_mkdir(ptr(&dirPath), chengHeldExecSealDirMode) != 0:
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    let dirFd = libc_open_runtime(
        ptr(&dirPath),
        chengHeldExecAccessReadOnly | chengHeldExecDarwinOCloexec)
    if dirFd < 0:
        let _rmUnopenableDir = libc_rmdir_runtime(ptr(&dirPath))
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    var fileName: uint8[chengHeldExecSealStageFileNameBytes]
    cheng_bytes_set(ptr(&fileName), 0, chengHeldExecSealStageFileNameBytes)
    let fileMarker: ptr = "bundle.bin"
    cheng_bytes_copy(ptr(&fileName), fileMarker, 11)
    let writeFd = libc_openat_runtime(
        dirFd,
        ptr(&fileName),
        chengHeldExecAccessReadWrite | chengHeldExecDarwinOCreat |
            chengHeldExecDarwinOExcl | chengHeldExecDarwinOCloexec,
        chengHeldExecSealFileMode)
    if writeFd < 0:
        let _closeStageDir = libc_close(dirFd)
        let _rmStageDir = libc_rmdir_runtime(ptr(&dirPath))
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    var written: int32
    while written < byteCount:
        let amount = libc_write_runtime(
            writeFd,
            cheng_ptr_plus(byteData, written),
            byteCount - written)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) ||
           amount > int64(byteCount - written):
            let _closeWriteFail = libc_close(writeFd)
            let _unlinkWriteFail = libc_unlinkat_runtime(
                dirFd, ptr(&fileName), 0)
            let _closeWriteFailDir = libc_close(dirFd)
            let _rmWriteFailDir = libc_rmdir_runtime(ptr(&dirPath))
            return ChengHeldExecBundleSealResult(
                errorCode: chengHeldExecBundleSealErrWrite, fd: -1)
        written = written + int32(amount)
    let readFd = libc_openat_runtime(
        dirFd,
        ptr(&fileName),
        chengHeldExecAccessReadOnly | chengHeldExecDarwinOCloexec,
        0)
    if readFd < 0:
        let _closeReadFail = libc_close(writeFd)
        let _unlinkReadFail = libc_unlinkat_runtime(
            dirFd, ptr(&fileName), 0)
        let _closeReadFailDir = libc_close(dirFd)
        let _rmReadFailDir = libc_rmdir_runtime(ptr(&dirPath))
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrCreate, fd: -1)
    # Freeze point: close the only writable handle, then remove the only
    # pathname.  From here the bytes are pinned for every later consumer.
    if libc_close(writeFd) != 0:
        let _closeFrozenRead = libc_close(readFd)
        let _unlinkFrozen = libc_unlinkat_runtime(
            dirFd, ptr(&fileName), 0)
        let _closeFrozenDir = libc_close(dirFd)
        let _rmFrozenDir = libc_rmdir_runtime(ptr(&dirPath))
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrSeal, fd: -1)
    if libc_unlinkat_runtime(dirFd, ptr(&fileName), 0) != 0:
        let _closeSealRead = libc_close(readFd)
        let _closeSealDir = libc_close(dirFd)
        let _rmSealDir = libc_rmdir_runtime(ptr(&dirPath))
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrSeal, fd: -1)
    if libc_close(dirFd) != 0:
        let _closeDirFailRead = libc_close(readFd)
        let _rmDirFailDir = libc_rmdir_runtime(ptr(&dirPath))
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrSeal, fd: -1)
    if libc_rmdir_runtime(ptr(&dirPath)) != 0:
        let _closeRmdirFail = libc_close(readFd)
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrSeal, fd: -1)
    var actualDigest: ChengFixedBytes32
    var actualBytes: uint64
    var size: int64
    var mode: int32
    var device: uint64
    var inode: uint64
    var linkCount: uint64
    if !cheng_held_exec_fd_content_digest_into(
           readFd, actualDigest, actualBytes) ||
       actualBytes != uint64(byteCount) ||
       !cheng_fixed32_equal(actualDigest, expectedDigest) ||
       libc_fstat_scalars_runtime(
           readFd, &size, &mode, &device, &inode) != 0 ||
       size != int64(byteCount) ||
       (mode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       device == uint64(0) || inode == uint64(0) ||
       libc_fstat_nlink_runtime(readFd, ptr(&linkCount)) != 0 ||
       linkCount != uint64(0) ||
       !cheng_held_exec_bundle_seal_attest_fd(readFd) ||
       libc_lseek_runtime(readFd, int64(0), chengHeldExecSeekSet) != int64(0):
        let _closeVerify = libc_close(readFd)
        return ChengHeldExecBundleSealResult(
            errorCode: chengHeldExecBundleSealErrVerify, fd: -1)
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(projection, 0, actualDigest)
    let digest0 = cheng_held_exec_wire_get_u64(projection, 0)
    let digest1 = cheng_held_exec_wire_get_u64(projection, 8)
    let digest2 = cheng_held_exec_wire_get_u64(projection, 16)
    let digest3 = cheng_held_exec_wire_get_u64(projection, 24)
    return ChengHeldExecBundleSealResult(
        status: 1,
        fd: readFd,
        byteCount: actualBytes,
        digest0: digest0,
        digest1: digest1,
        digest2: digest2,
        digest3: digest3)

# The raw sealed descriptor never crosses the Cheng ABI.  It is published
# exactly once into this append-only provider arena; callers receive row+1.
@exportc("cheng_held_exec_parent_seal_bundle_owner")
@abi_internal
@borrows
fn cheng_held_exec_parent_seal_bundle_owner_export(
        envelopeBytes: str,
        expectedHeldBundleCid: str): int32 =
    let sealed = cheng_held_exec_parent_seal_bundle_raw(
        envelopeBytes, expectedHeldBundleCid)
    if sealed.status != 1 || sealed.fd <= 2 ||
       sealed.byteCount == uint64(0):
        if sealed.fd >= 0:
            let _closeInvalidSeal = libc_close(sealed.fd)
        return -1
    var digestWire: ChengHeldExecWire
    cheng_held_exec_wire_zero(digestWire)
    cheng_held_exec_wire_put_u64(digestWire, 0, sealed.digest0)
    cheng_held_exec_wire_put_u64(digestWire, 8, sealed.digest1)
    cheng_held_exec_wire_put_u64(digestWire, 16, sealed.digest2)
    cheng_held_exec_wire_put_u64(digestWire, 24, sealed.digest3)
    let digest = cheng_held_exec_wire_get_digest(digestWire, 0)
    if !cheng_held_exec_digest_nonzero(digest):
        let _closeInvalidDigest = libc_close(sealed.fd)
        return -1
    cheng_runtime_lock()
    let row = chengHeldExecBundleOwnerNextRow
    if row < 0 || row >= chengHeldExecBundleOwnerCount ||
       chengHeldExecBundleOwnerStates[row] != 0:
        cheng_runtime_unlock()
        let _closeArenaFull = libc_close(sealed.fd)
        return -1
    chengHeldExecBundleOwnerNextRow = row + 1
    chengHeldExecBundleOwnerFds[row] = sealed.fd
    chengHeldExecBundleOwnerFdCloseStates[row] = chengHeldExecFdCloseOpen
    chengHeldExecBundleOwnerFdCloseReceipts[row] = 0
    chengHeldExecBundleOwnerDigests[row] = digest
    chengHeldExecBundleOwnerByteCounts[row] = sealed.byteCount
    chengHeldExecBundleOwnerStates[row] = chengHeldExecBundleOwnerIssued
    cheng_runtime_unlock()
    return row + 1

@exportc("cheng_held_exec_bundle_owner_abort")
@abi_internal
fn cheng_held_exec_bundle_owner_abort_export(
        bundleOwner: int32): int32 =
    let row = bundleOwner - 1
    if row < 0 || row >= chengHeldExecBundleOwnerCount:
        return 0
    cheng_runtime_lock()
    if row >= chengHeldExecBundleOwnerNextRow ||
       (chengHeldExecBundleOwnerStates[row] != chengHeldExecBundleOwnerIssued &&
        chengHeldExecBundleOwnerStates[row] !=
            chengHeldExecBundleOwnerRecoveryRequired):
        let alreadyAborted =
            chengHeldExecBundleOwnerStates[row] ==
                chengHeldExecBundleOwnerAborted
        cheng_runtime_unlock()
        return alreadyAborted ? 1 : 0
    chengHeldExecBundleOwnerStates[row] = chengHeldExecBundleOwnerAborting
    cheng_runtime_unlock()
    let clean = cheng_held_exec_bundle_owner_close_fd_once(row)
    cheng_runtime_lock()
    if clean:
        chengHeldExecBundleOwnerDigests[row] = ChengFixedBytes32()
        chengHeldExecBundleOwnerByteCounts[row] = uint64(0)
    chengHeldExecBundleOwnerStates[row] = clean ?
        chengHeldExecBundleOwnerAborted :
        chengHeldExecBundleOwnerRecoveryRequired
    cheng_runtime_unlock()
    return clean ? 1 : 0

fn cheng_held_exec_fd_identity_equal(
        leftFd: int32,
        rightFd: int32): bool =
    var leftSize: int64
    var leftMode: int32
    var leftDevice: uint64
    var leftInode: uint64
    var rightSize: int64
    var rightMode: int32
    var rightDevice: uint64
    var rightInode: uint64
    return leftFd >= 0 && rightFd >= 0 &&
        libc_fstat_scalars_runtime(
            leftFd,
            &leftSize,
            &leftMode,
            &leftDevice,
            &leftInode) == 0 &&
        libc_fstat_scalars_runtime(
            rightFd,
            &rightSize,
            &rightMode,
            &rightDevice,
            &rightInode) == 0 &&
        leftSize > 0 && leftDevice != uint64(0) &&
        leftInode != uint64(0) &&
        leftSize == rightSize && leftMode == rightMode &&
        leftDevice == rightDevice && leftInode == rightInode

fn cheng_held_exec_named_path_matches(
        retainedFd: int32,
        path: str): bool =
    let namedFd = libc_open_runtime(
        cheng_str_data(path), chengHeldExecOPathCloexec)
    if namedFd < 0:
        return false
    let matches = cheng_held_exec_fd_identity_equal(
        retainedFd, namedFd)
    let _close = libc_close(namedFd)
    return matches

@borrows
fn cheng_held_exec_named_output_matches(
        retainedFd: int32,
        path: str): bool =
    if retainedFd < 0 || path.len <= 0 ||
       cheng_str_contains_nul(path):
        return false
    let namedFd = libc_open_runtime(
        cheng_str_data(path), chengHeldExecOReadCloexecNoFollow)
    if namedFd < 0:
        return false
    let matches = cheng_held_exec_fd_identity_equal(
        retainedFd, namedFd)
    let _close = libc_close(namedFd)
    return matches

fn cheng_held_exec_launcher_identity_digest_into(
        out: var ChengFixedBytes32): bool =
    out = ChengFixedBytes32()
    let selfFd = libc_open_runtime(
        cheng_str_data(chengHeldExecProcSelfExePath),
        chengHeldExecOReadCloexec)
    let namedFd = libc_open_runtime(
        cheng_str_data(chengHeldExecLauncherPath),
        chengHeldExecOReadCloexec)
    if selfFd < 0 || namedFd < 0:
        if selfFd >= 0:
            let _closeSelf = libc_close(selfFd)
        if namedFd >= 0:
            let _closeNamed = libc_close(namedFd)
        return false
    let identityMatches =
        cheng_held_exec_fd_identity_equal(selfFd, namedFd)
    let measured = identityMatches &&
        cheng_linux_fsverity_measure_sha256_runtime(
            namedFd, &out.data[0]) == 0 &&
        cheng_held_exec_digest_nonzero(out)
    let _closeSelf = libc_close(selfFd)
    let _closeNamed = libc_close(namedFd)
    return measured

fn cheng_held_exec_retained_verity_digest_into(
        retainedFd: int32,
        out: var ChengFixedBytes32): bool =
    out = ChengFixedBytes32()
    return retainedFd >= 0 &&
        cheng_held_exec_named_path_matches(
            retainedFd, chengHeldExecNativePath) &&
        cheng_linux_fsverity_measure_sha256_runtime(
            retainedFd, &out.data[0]) == 0 &&
        cheng_held_exec_digest_nonzero(out)

fn cheng_held_exec_build_child_argv(): ptr =
    let count = cheng_runtime_param_count()
    if count <= 0 || count > 2147483646:
        return nil
    let bytes64 = int64(count + 1) * int64(sizeof(ptr))
    if bytes64 <= 0 || bytes64 > int64(2147483647):
        return nil
    let argv = cheng_malloc_export(int32(bytes64))
    if argv == nil:
        return nil
    cheng_bytes_set(argv, 0, int32(bytes64))
    var built: int32
    for argIndex in 0..<count:
        var source = cheng_runtime_param_raw(argIndex)
        if argIndex == 0:
            source = cheng_str_data(chengHeldExecNativePath)
        if source == nil:
            cheng_exec_program_free_argv(argv, built)
            return nil
        let item = cheng_string_copy(source, cheng_cstrlen_raw(source))
        if item == nil:
            cheng_exec_program_free_argv(argv, built)
            return nil
        store_ptr_export(
            cheng_ptr_plus(argv, built * int32(sizeof(ptr))), item)
        built = built + 1
    return argv

fn cheng_held_exec_proc_exe_path(
        pid: int32,
        out: var ChengHeldExecProcPath): bool =
    cheng_bytes_set(ptr(&out), 0, int32(sizeof(ChengHeldExecProcPath)))
    if pid <= 0:
        return false
    let prefix: ptr = "/proc/"
    cheng_bytes_copy(ptr(&out), prefix, 6)
    var digits: uint8[16]
    var digitCount: int32
    var value = pid
    while value > 0:
        digits[digitCount] = uint8(int32('0') + (value % 10))
        digitCount = digitCount + 1
        value = value / 10
    if digitCount <= 0 || digitCount > 10:
        return false
    for index in 0..<digitCount:
        out.data[6 + index] = digits[digitCount - index - 1]
    let suffixOffset = 6 + digitCount
    out.data[suffixOffset] = uint8(int32('/'))
    out.data[suffixOffset + 1] = uint8(int32('e'))
    out.data[suffixOffset + 2] = uint8(int32('x'))
    out.data[suffixOffset + 3] = uint8(int32('e'))
    return true

@borrows
fn cheng_held_exec_process_image_digest_into(
        pid: int32,
        fixedPath: str,
        out: var ChengFixedBytes32): bool =
    out = ChengFixedBytes32()
    var processPath: ChengHeldExecProcPath
    if pid <= 0 || fixedPath.len <= 0 ||
       !cheng_held_exec_proc_exe_path(pid, processPath):
        return false
    let processFd = libc_open_runtime(
        ptr(&processPath), chengHeldExecOReadCloexec)
    let fixedFd = libc_open_runtime(
        cheng_str_data(fixedPath), chengHeldExecOReadCloexec)
    if processFd < 0 || fixedFd < 0:
        if processFd >= 0:
            let _closeProcess = libc_close(processFd)
        if fixedFd >= 0:
            let _closeFixed = libc_close(fixedFd)
        return false
    let sameImage = cheng_held_exec_fd_identity_equal(
        processFd, fixedFd)
    let measured = sameImage &&
        cheng_linux_fsverity_measure_sha256_runtime(
            fixedFd, &out.data[0]) == 0 &&
        cheng_held_exec_digest_nonzero(out)
    let _closeProcess = libc_close(processFd)
    let _closeFixed = libc_close(fixedFd)
    return measured

fn cheng_held_exec_child_image_matches(
        childPid: int32,
        retainedFd: int32): bool =
    var retainedSize: int64
    var retainedMode: int32
    var retainedDevice: uint64
    var retainedInode: uint64
    if libc_fstat_scalars_runtime(
           retainedFd,
           &retainedSize,
           &retainedMode,
           &retainedDevice,
           &retainedInode) != 0:
        return false
    var path: ChengHeldExecProcPath
    if !cheng_held_exec_proc_exe_path(childPid, path):
        return false
    let childExeFd = libc_open_runtime(
        ptr(&path), chengHeldExecOPathCloexec)
    if childExeFd < 0:
        return false
    var childSize: int64
    var childMode: int32
    var childDevice: uint64
    var childInode: uint64
    let statOk = libc_fstat_scalars_runtime(
        childExeFd,
        &childSize,
        &childMode,
        &childDevice,
        &childInode) == 0
    let _close = libc_close(childExeFd)
    return statOk && retainedSize == childSize &&
        retainedMode == childMode &&
        retainedDevice == childDevice &&
        retainedInode == childInode

fn cheng_held_exec_channel_is_seqpacket(fd: int32): bool =
    var socketType: int32
    var length: int32 = int32(sizeof(int32))
    return fd >= 0 &&
        libc_getsockopt_runtime(
            fd,
            chengHeldExecSolSocket,
            chengHeldExecSoType,
            ptr(&socketType),
            ptr(&length)) == 0 &&
        length == int32(sizeof(int32)) &&
        socketType == chengHeldExecSockSeqpacket

fn cheng_held_exec_receive_wire_or_child_exit(
        channelFd: int32,
        pidfd: int32,
        wire: var ChengHeldExecWire): ChengHeldExecCredentialedReceiveResult =
    if channelFd < 0 || pidfd < 0:
        return ChengHeldExecCredentialedReceiveResult()
    var pollFds: uint8[16]
    cheng_bytes_set(ptr(&pollFds), 0, 16)
    cheng_pollfd_write(ptr(&pollFds), channelFd, chengPollIn)
    cheng_pollfd_write(
        cheng_ptr_plus(ptr(&pollFds), chengPollFdLen),
        pidfd,
        chengPollIn)
    let pollRc = libc_poll(ptr(&pollFds), 2, -1)
    if pollRc <= 0:
        return ChengHeldExecCredentialedReceiveResult()
    let channelEvents = cheng_pollfd_revents(ptr(&pollFds))
    if (channelEvents &
        (chengPollIn | chengPollHup | chengPollErr)) != 0:
        return cheng_held_exec_receive_wire(channelFd, wire)
    return ChengHeldExecCredentialedReceiveResult()

fn cheng_held_exec_receive_wire_or_child_exit_from(
        channelFd: int32,
        pidfd: int32,
        wire: var ChengHeldExecWire,
        expectedPid: int32,
        expectedUid: uint32,
        expectedGid: uint32): bool =
    let received = cheng_held_exec_receive_wire_or_child_exit(
        channelFd, pidfd, wire)
    return received.status == 1 &&
        cheng_held_exec_credentials_match(
            received.pid,
            received.uid,
            received.gid,
            expectedPid,
            expectedUid,
            expectedGid)

fn cheng_held_exec_receive_terminal_or_child_exit_from(
        channelFd: int32,
        pidfd: int32,
        wire: var ChengHeldExecWire,
        expectedPid: int32,
        expectedUid: uint32,
        expectedGid: uint32): ChengHeldExecCredentialedReceiveResult =
    if channelFd < 0 || pidfd < 0:
        return ChengHeldExecCredentialedReceiveResult()
    var pollFds: uint8[16]
    cheng_bytes_set(ptr(&pollFds), 0, 16)
    cheng_pollfd_write(ptr(&pollFds), channelFd, chengPollIn)
    cheng_pollfd_write(
        cheng_ptr_plus(ptr(&pollFds), chengPollFdLen),
        pidfd,
        chengPollIn)
    let pollRc = libc_poll(ptr(&pollFds), 2, -1)
    if pollRc <= 0:
        return ChengHeldExecCredentialedReceiveResult()
    let channelEvents = cheng_pollfd_revents(ptr(&pollFds))
    if (channelEvents &
        (chengPollIn | chengPollHup | chengPollErr)) != 0:
        return cheng_held_exec_receive_wire_with_optional_fd_from(
            channelFd,
            wire,
            expectedPid,
            expectedUid,
            expectedGid)
    return ChengHeldExecCredentialedReceiveResult()

fn cheng_held_exec_reap_failure(pid: int32): int32 =
    if pid <= 0:
        return -1
    var status: int32
    let waited = libc_waitpid_runtime(pid, ptr(&status), 0)
    if waited != pid:
        return -1
    if (status & 127) == 0:
        return (status >> 8) & 255
    return 128 + (status & 127)

@exportc("cheng_held_exec_child_import")
@abi_internal
fn cheng_held_exec_child_import_export(): int32 =
    if chengHeldExecChildState != 0:
        return -1
    chengHeldExecChildParentPid = -1
    chengHeldExecChildParentUid = uint32(0)
    chengHeldExecChildParentGid = uint32(0)
    chengHeldExecChildOutputFd = -1
    chengHeldExecChildCapsuleRoleNextRow = 0
    chengHeldExecChildCapsuleRoleActiveOwner = -1
    chengHeldExecChildCapsuleRoleOwnerExported = 0
    for capsuleRow in 0..<4:
        chengHeldExecChildCapsuleRoleStates[capsuleRow] = 0
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[capsuleRow] = -1
        chengHeldExecChildCapsuleRoleParentPids[capsuleRow] = -1
        chengHeldExecChildCapsuleRoleParentUids[capsuleRow] = uint32(0)
        chengHeldExecChildCapsuleRoleParentGids[capsuleRow] = uint32(0)
        chengHeldExecChildCapsuleRolePlanBound[capsuleRow] = 0
        chengHeldExecChildCapsuleRolePlanEvidence[capsuleRow] =
            ChengHeldExecPlanEvidenceCanonical()
        chengHeldExecChildCapsuleRoleCompileReceiptCanonical[capsuleRow] = ""
    chengHeldExecChildBundleDelivered = 0
    chengHeldExecChildOutputBytes = uint64(0)
    chengHeldExecChildOutputDigest = ChengFixedBytes32()
    chengHeldExecChildCompileReceiptDigest = ChengFixedBytes32()
    chengHeldExecChildOutputPathDigest = ChengFixedBytes32()
    chengHeldExecChildOutputVerityDigest = ChengFixedBytes32()
    chengHeldExecChildOutputIdentityDigest = ChengFixedBytes32()
    chengHeldExecChildExpectedOutputPathDigest = ChengFixedBytes32()
    chengHeldExecChildExecutableDigest = ChengFixedBytes32()
    chengHeldExecChildPlanReceiptDigest = ChengFixedBytes32()
    chengHeldExecChildPlanEvidenceDigest = ChengFixedBytes32()
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecChildDecisionConsumed), 0)
    if libc_fcntl_native(
           chengHeldExecChannelFd, chengHeldExecFGetFd, 0) < 0:
        return 0
    let platformKind = cheng_read_only_mapped_region_platform_kind()
    if (platformKind != chengReadOnlyMappedRegionPlatformLinuxX64 &&
        platformKind != chengReadOnlyMappedRegionPlatformLinuxA64 &&
        platformKind != chengReadOnlyMappedRegionPlatformDarwinA64) ||
       !cheng_held_exec_channel_is_seqpacket(chengHeldExecChannelFd):
        return -1
    var nonce: ChengFixedBytes32
    if cheng_system_entropy_fill(&nonce.data[0], 32) != 1 ||
       !cheng_held_exec_digest_nonzero(nonce):
        return -1
    let actualArgv = cheng_held_exec_argv_digest(nil)
    let actualEnvironment = cheng_held_exec_empty_environment_digest()
    var actualExecutable: ChengFixedBytes32
    if !cheng_held_exec_digest_nonzero(actualArgv) ||
       !cheng_held_exec_digest_nonzero(actualEnvironment) ||
       !cheng_held_exec_process_image_digest_into(
           libc_getpid_runtime(),
           chengHeldExecNativePath,
           actualExecutable):
        return -1
    var claim: ChengHeldExecWire
    cheng_held_exec_wire_header(
        claim, chengHeldExecKindClaim, uint64(1), nonce)
    cheng_held_exec_wire_put_digest(claim, 64, actualArgv)
    cheng_held_exec_wire_put_digest(claim, 96, actualEnvironment)
    cheng_held_exec_wire_put_u64(
        claim, 128, uint64(libc_getpid_runtime()))
    cheng_held_exec_wire_put_digest(claim, 160, actualExecutable)
    let claimDigest = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.claim.v2", claim)
    if !cheng_held_exec_digest_nonzero(claimDigest):
        return -1
    if !cheng_held_exec_send_wire(chengHeldExecChannelFd, claim):
        return -1
    # Reserve the append-only opaque row before recvmsg can install any
    # descriptor.  If the arena cannot publish Opening, recvmsg is never
    # called and no unowned SCM_RIGHTS descriptor can exist.
    if cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecChildCapsuleRoleNextRow), 0, 1) != 1 ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecChildCapsuleRoleStates[0]),
           0,
           chengHeldExecChildCapsuleRoleOpening) != 1:
        return -1
    let activateRoleRow = 0
    chengHeldExecChildCapsuleRoleActiveOwner = activateRoleRow + 1
    var activate: ChengHeldExecWire
    let activateReceive = cheng_held_exec_receive_wire_with_fd_vector3(
        chengHeldExecChannelFd, activateRoleRow, activate)
    let nativeReceiveOwner =
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[activateRoleRow]
    let parentPid =
        chengHeldExecChildCapsuleRoleParentPids[activateRoleRow]
    let parentUid =
        chengHeldExecChildCapsuleRoleParentUids[activateRoleRow]
    let parentGid =
        chengHeldExecChildCapsuleRoleParentGids[activateRoleRow]
    let executableDigest = cheng_held_exec_wire_get_digest(activate, 96)
    let launcherDigest = cheng_held_exec_wire_get_digest(activate, 128)
    let expectedOutputPath = cheng_held_exec_wire_get_digest(activate, 160)
    let bundleDigest = cheng_held_exec_wire_get_digest(activate, 192)
    let ownerClaimDigest = cheng_held_exec_wire_get_digest(activate, 224)
    var actualLauncher: ChengFixedBytes32
    if activateReceive.status != 1 ||
       nativeReceiveOwner <= 0 ||
       !cheng_held_exec_wire_header_valid(
           activate,
           chengHeldExecKindActivate,
           uint64(2),
           nonce) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(activate, 64),
           claimDigest) ||
       int32(cheng_held_exec_wire_get_u64(activate, 256)) != parentPid ||
       parentPid <= 0 ||
       !cheng_fixed32_equal(executableDigest, actualExecutable) ||
       !cheng_held_exec_digest_nonzero(expectedOutputPath) ||
       !cheng_held_exec_digest_nonzero(bundleDigest) ||
       !cheng_held_exec_digest_nonzero(ownerClaimDigest) ||
       !cheng_held_exec_process_image_digest_into(
           parentPid, chengHeldExecLauncherPath, actualLauncher) ||
       !cheng_fixed32_equal(actualLauncher, launcherDigest):
        cheng_held_exec_child_capsule_role_close(
            activateRoleRow,
            chengHeldExecChildCapsuleRoleRejected)
        return -1
    if libc_terminal_activate_receive_owner_bind(nativeReceiveOwner) != 1:
        cheng_held_exec_child_capsule_role_close(
            activateRoleRow,
            chengHeldExecChildCapsuleRoleRejected)
        return -1
    var observedBundleDigest: ChengFixedBytes32
    var observedBundleBytes: uint64
    var bundleSize: int64
    var bundleMode: int32
    var bundleDevice: uint64
    var bundleInode: uint64
    var finishedSize: int64
    var finishedMode: int32
    var finishedDevice: uint64
    var finishedInode: uint64
    var decisionSize: int64
    var decisionMode: int32
    var decisionDevice: uint64
    var decisionInode: uint64
    if !cheng_held_exec_native_receive_owner_content_digest_into(
           nativeReceiveOwner,
           chengHeldExecCapsuleFdBundleReader,
           observedBundleDigest,
           observedBundleBytes) ||
       observedBundleBytes == uint64(0) ||
       observedBundleBytes > uint64(chengHeldExecBundleMaxBytes) ||
       !cheng_fixed32_equal(observedBundleDigest, bundleDigest) ||
       libc_terminal_activate_receive_owner_fstat(
           nativeReceiveOwner,
           chengHeldExecCapsuleFdBundleReader,
           &bundleSize,
           &bundleMode,
           &bundleDevice,
           &bundleInode) != 0 ||
       bundleSize != int64(observedBundleBytes) ||
       (bundleMode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       bundleDevice == uint64(0) || bundleInode == uint64(0) ||
       !cheng_held_exec_bundle_seal_attest_owner(
           nativeReceiveOwner,
           chengHeldExecCapsuleFdBundleReader) ||
       libc_terminal_activate_receive_owner_lseek(
           nativeReceiveOwner,
           chengHeldExecCapsuleFdBundleReader,
           int64(0),
           chengHeldExecSeekSet) != int64(0) ||
       libc_terminal_activate_receive_owner_fstat(
           nativeReceiveOwner,
           chengHeldExecCapsuleFdFinishedWriter,
           &finishedSize,
           &finishedMode,
           &finishedDevice,
           &finishedInode) != 0 ||
       finishedSize != int64(0) ||
       (finishedMode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       finishedDevice == uint64(0) || finishedInode == uint64(0) ||
       (libc_terminal_activate_receive_owner_fcntl(
            nativeReceiveOwner,
            chengHeldExecCapsuleFdFinishedWriter,
            chengHeldExecFGetFl) &
        chengHeldExecAccessModeMask) != chengHeldExecAccessWriteOnly ||
       libc_terminal_activate_receive_owner_fstat(
           nativeReceiveOwner,
           chengHeldExecCapsuleFdDecisionReader,
           &decisionSize,
           &decisionMode,
           &decisionDevice,
           &decisionInode) != 0 ||
       decisionSize != int64(chengHeldExecWireBytes) ||
       (decisionMode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       decisionDevice == uint64(0) || decisionInode == uint64(0) ||
       (libc_terminal_activate_receive_owner_fcntl(
            nativeReceiveOwner,
            chengHeldExecCapsuleFdDecisionReader,
            chengHeldExecFGetFl) &
        chengHeldExecAccessModeMask) != chengHeldExecAccessReadOnly:
        cheng_held_exec_child_capsule_role_close(
            activateRoleRow,
            chengHeldExecChildCapsuleRoleRejected)
        return -1
    chengHeldExecChildChannelFd = chengHeldExecChannelFd
    chengHeldExecChildParentPid = parentPid
    chengHeldExecChildParentUid = parentUid
    chengHeldExecChildParentGid = parentGid
    chengHeldExecChildNonce = nonce
    chengHeldExecChildClaimDigest = claimDigest
    chengHeldExecChildOwnerClaimDigest = ownerClaimDigest
    chengHeldExecChildExecutableDigest = executableDigest
    chengHeldExecChildExpectedOutputPathDigest = expectedOutputPath
    chengHeldExecChildBundleDigest = bundleDigest
    if cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecChildCapsuleRoleStates[activateRoleRow]),
           chengHeldExecChildCapsuleRoleOpening,
           chengHeldExecChildCapsuleRoleIssued) != 1:
        cheng_held_exec_child_capsule_role_close(
            activateRoleRow,
            chengHeldExecChildCapsuleRoleRecoveryRequired)
        return -1
    chengHeldExecChildState = 1
    return 1

@exportc("cheng_held_exec_child_capsule_role_owner")
@abi_internal
fn cheng_held_exec_child_capsule_role_owner_export(): int32 =
    let owner = chengHeldExecChildCapsuleRoleActiveOwner
    let row = owner - 1
    if chengHeldExecChildState != 1 || owner <= 0 ||
       row < 0 || row >= 4 ||
       chengHeldExecChildCapsuleRoleNextRow != 1 ||
       chengHeldExecChildCapsuleRoleStates[row] !=
           chengHeldExecChildCapsuleRoleIssued ||
       chengHeldExecChildCapsuleRoleNativeReceiveOwners[row] <= 0 ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecChildCapsuleRoleOwnerExported), 0, 1) != 1:
        return -1
    return owner

fn cheng_held_exec_child_capsule_role_close_fd_once(
        row: int32,
        role: int32): bool =
    if row < 0 || row >= 4 ||
       role != chengHeldExecCapsuleFdBundleReader &&
       role != chengHeldExecCapsuleFdFinishedWriter &&
       role != chengHeldExecCapsuleFdDecisionReader:
        return false
    let nativeOwner =
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[row]
    return nativeOwner > 0 &&
        libc_terminal_activate_receive_owner_close_role(
            nativeOwner, role) == 1

fn cheng_held_exec_child_capsule_role_close(
        row: int32,
        nextState: int32) =
    if row < 0 || row >= 4:
        return
    let nativeOwner =
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[row]
    let allClosed = nativeOwner > 0 &&
        libc_terminal_activate_receive_owner_abort(nativeOwner) == 1
    chengHeldExecChildCapsuleRoleStates[row] =
        allClosed ?
            nextState : chengHeldExecChildCapsuleRoleRecoveryRequired

fn cheng_held_exec_finished_upload_header_zero(
        header: var ChengHeldExecFinishedUploadHeader) =
    for byteIndex in 0..<chengHeldExecFinishedUploadHeaderBytes:
        header.data[byteIndex] = uint8(0)

fn cheng_held_exec_finished_upload_header_put_u64(
        header: var ChengHeldExecFinishedUploadHeader,
        offset: int32,
        value: uint64) =
    if offset < 0 || offset > chengHeldExecFinishedUploadHeaderBytes - 8:
        return
    for byteIndex in 0..<8:
        header.data[offset + byteIndex] = uint8(
            (value >> uint64(byteIndex * 8)) & uint64(255))

@borrows
fn cheng_held_exec_finished_upload_header_put_digest(
        header: var ChengHeldExecFinishedUploadHeader,
        offset: int32,
        digest: ChengFixedBytes32) =
    if offset < 0 || offset > chengHeldExecFinishedUploadHeaderBytes - 32:
        return
    for byteIndex in 0..<32:
        header.data[offset + byteIndex] = digest.data[byteIndex]

fn cheng_held_exec_finished_upload_write_all(
        fd: int32,
        source: ptr,
        byteCount: int32): bool =
    if fd < 0 || source == nil || byteCount < 0:
        return false
    var written: int32
    while written < byteCount:
        let amount = libc_write_runtime(
            fd,
            cheng_ptr_plus(source, written),
            byteCount - written)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) ||
           amount > int64(byteCount - written):
            return false
        written = written + int32(amount)
    return written == byteCount

fn cheng_held_exec_native_receive_owner_write_all(
        owner: int32,
        role: int32,
        source: ptr,
        byteCount: int32): bool =
    if owner <= 0 || source == nil || byteCount < 0:
        return false
    var written: int32
    while written < byteCount:
        let amount = libc_terminal_activate_receive_owner_write(
            owner,
            role,
            cheng_ptr_plus(source, written),
            byteCount - written)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) ||
           amount > int64(byteCount - written):
            return false
        written = written + int32(amount)
    return written == byteCount

fn cheng_held_exec_native_receive_owner_read_exact(
        owner: int32,
        role: int32,
        destination: ptr,
        byteCount: int32): bool =
    if owner <= 0 || destination == nil || byteCount < 0:
        return false
    var offset: int32
    while offset < byteCount:
        let amount = libc_terminal_activate_receive_owner_read(
            owner,
            role,
            cheng_ptr_plus(destination, offset),
            byteCount - offset)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) ||
           amount > int64(byteCount - offset):
            return false
        offset = offset + int32(amount)
    return true

@borrows
fn cheng_held_exec_child_install_finished_upload(
        capsuleRow: int32,
        terminal: var ChengHeldExecWire,
        allocationReceipt: ChengFixedBytes32,
        exitCode: int32): bool =
    if capsuleRow < 0 || capsuleRow >= 4 ||
       chengHeldExecChildCapsuleRolePlanBound[capsuleRow] != 1:
        return false
    let nativeOwner =
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[capsuleRow]
    let compileCanonical =
        chengHeldExecChildCapsuleRoleCompileReceiptCanonical[capsuleRow]
    let compileBytes = cheng_str_len(compileCanonical)
    let outputBytes = exitCode == 0 ?
        chengHeldExecChildOutputBytes : uint64(0)
    if nativeOwner <= 0 || compileBytes < 0 ||
       compileBytes > int32(1048576) ||
       (exitCode == 0 &&
        (compileBytes <= 0 || chengHeldExecChildOutputFd < 0 ||
         outputBytes == uint64(0))) ||
       outputBytes > uint64(1073741824):
        return false
    let terminalOffset = chengHeldExecFinishedUploadHeaderBytes
    let planOffset = terminalOffset + chengHeldExecWireBytes
    let compileOffset = planOffset + chengHeldExecPlanEvidenceByteCount
    let outputOffset = compileOffset + compileBytes
    let totalBytes64 = uint64(outputOffset) + outputBytes
    if totalBytes64 > uint64(2147483647):
        return false
    var sizeBefore: int64
    var modeBefore: int32
    var deviceBefore: uint64
    var inodeBefore: uint64
    if libc_terminal_activate_receive_owner_fstat(
           nativeOwner,
           chengHeldExecCapsuleFdFinishedWriter,
           &sizeBefore,
           &modeBefore,
           &deviceBefore,
           &inodeBefore) != 0 ||
       sizeBefore != int64(0) ||
       (modeBefore & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       deviceBefore == uint64(0) || inodeBefore == uint64(0) ||
       libc_terminal_activate_receive_owner_lseek(
           nativeOwner,
           chengHeldExecCapsuleFdFinishedWriter,
           int64(0),
           chengHeldExecSeekSet) != int64(0):
        return false
    var header: ChengHeldExecFinishedUploadHeader
    cheng_held_exec_finished_upload_header_zero(header)
    cheng_held_exec_finished_upload_header_put_u64(
        header, 0, chengHeldExecFinishedUploadMagic)
    cheng_held_exec_finished_upload_header_put_u64(
        header, 8, chengHeldExecFinishedUploadVersion)
    cheng_held_exec_finished_upload_header_put_u64(
        header, 16, totalBytes64)
    cheng_held_exec_finished_upload_header_put_u64(
        header, 24, uint64(terminalOffset))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 32, uint64(chengHeldExecWireBytes))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 40, uint64(planOffset))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 48, uint64(chengHeldExecPlanEvidenceByteCount))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 56, uint64(compileOffset))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 64, uint64(compileBytes))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 72, uint64(outputOffset))
    cheng_held_exec_finished_upload_header_put_u64(
        header, 80, outputBytes)
    cheng_held_exec_finished_upload_header_put_u64(
        header, 88, uint64(uint32(exitCode)))
    cheng_held_exec_finished_upload_header_put_digest(
        header, 96, cheng_held_exec_wire_get_digest(terminal, 256))
    cheng_held_exec_finished_upload_header_put_digest(
        header, 128, chengHeldExecChildPlanEvidenceDigest)
    cheng_held_exec_finished_upload_header_put_digest(
        header, 160, chengHeldExecChildCompileReceiptDigest)
    cheng_held_exec_finished_upload_header_put_digest(
        header, 192, chengHeldExecChildOutputDigest)
    cheng_held_exec_finished_upload_header_put_digest(
        header, 224, allocationReceipt)
    let compileRaw = compileBytes > 0 ?
        cheng_str_data(compileCanonical) : nil
    var writeOk =
        cheng_held_exec_native_receive_owner_write_all(
            nativeOwner,
            chengHeldExecCapsuleFdFinishedWriter,
            ptr(&header),
            chengHeldExecFinishedUploadHeaderBytes) &&
        cheng_held_exec_native_receive_owner_write_all(
            nativeOwner,
            chengHeldExecCapsuleFdFinishedWriter,
            ptr(&terminal),
            chengHeldExecWireBytes) &&
        cheng_held_exec_native_receive_owner_write_all(
            nativeOwner,
            chengHeldExecCapsuleFdFinishedWriter,
            ptr(&chengHeldExecChildCapsuleRolePlanEvidence[capsuleRow]),
            chengHeldExecPlanEvidenceByteCount) &&
        (compileBytes == 0 ||
         cheng_held_exec_native_receive_owner_write_all(
             nativeOwner,
             chengHeldExecCapsuleFdFinishedWriter,
             compileRaw,
             compileBytes))
    if writeOk && outputBytes > uint64(0):
        writeOk = libc_lseek_runtime(
            chengHeldExecChildOutputFd,
            int64(0),
            chengHeldExecSeekSet) == int64(0)
        var outputRemaining = outputBytes
        var outputBuffer: uint8[65536]
        while writeOk && outputRemaining > uint64(0):
            var want = outputRemaining
            if want > uint64(65536):
                want = uint64(65536)
            let amount = libc_read_runtime(
                chengHeldExecChildOutputFd,
                ptr(&outputBuffer),
                int32(want))
            if amount < int64(0) &&
               native_cheng_errno_code_runtime() == chengHeldExecEintr:
                continue
            if amount <= int64(0) || amount > int64(want) ||
               !cheng_held_exec_native_receive_owner_write_all(
                   nativeOwner,
                   chengHeldExecCapsuleFdFinishedWriter,
                   ptr(&outputBuffer),
                   int32(amount)):
                writeOk = false
            else:
                outputRemaining = outputRemaining - uint64(amount)
    var sizeAfter: int64
    var modeAfter: int32
    var deviceAfter: uint64
    var inodeAfter: uint64
    let durable = writeOk &&
        libc_terminal_activate_receive_owner_fdatasync(
            nativeOwner,
            chengHeldExecCapsuleFdFinishedWriter) == 0 &&
        libc_terminal_activate_receive_owner_fstat(
            nativeOwner,
            chengHeldExecCapsuleFdFinishedWriter,
            &sizeAfter,
            &modeAfter,
            &deviceAfter,
            &inodeAfter) == 0 &&
        sizeAfter == int64(totalBytes64) &&
        modeAfter == modeBefore &&
        deviceAfter == deviceBefore && inodeAfter == inodeBefore
    let writerClosed =
        cheng_held_exec_child_capsule_role_close_fd_once(
            capsuleRow, chengHeldExecCapsuleFdFinishedWriter)
    if !writerClosed:
        chengHeldExecChildCapsuleRoleStates[capsuleRow] =
            chengHeldExecChildCapsuleRoleRecoveryRequired
    return durable && writerClosed

# Read the decision mirror through the child-only read descriptor.  Two
# complete reads with an unchanged vnode must agree byte-for-byte before the
# canonical fourth frame is published to the caller.  An all-zero or
# concurrently-changing inode is merely not ready; no polling or sleep is
# permitted, so the caller must arm the native event owner before retrying.
fn cheng_held_exec_child_decision_mirror_read_into(
        capsuleRow: int32,
        outDecision: var ChengHeldExecWire): int32 =
    cheng_held_exec_wire_zero(outDecision)
    if capsuleRow < 0 || capsuleRow >= 4 ||
       chengHeldExecChildCapsuleRoleStates[capsuleRow] !=
           chengHeldExecChildCapsuleRoleFinishing:
        return -1
    let nativeOwner =
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[capsuleRow]
    var sizeBefore: int64
    var modeBefore: int32
    var deviceBefore: uint64
    var inodeBefore: uint64
    var sizeAfter: int64
    var modeAfter: int32
    var deviceAfter: uint64
    var inodeAfter: uint64
    var first: ChengHeldExecWire
    var second: ChengHeldExecWire
    cheng_held_exec_wire_zero(first)
    cheng_held_exec_wire_zero(second)
    if nativeOwner <= 0 ||
       libc_terminal_activate_receive_owner_fstat(
           nativeOwner,
           chengHeldExecCapsuleFdDecisionReader,
           &sizeBefore,
           &modeBefore,
           &deviceBefore,
           &inodeBefore) != 0 ||
       sizeBefore != int64(chengHeldExecWireBytes) ||
       (modeBefore & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       deviceBefore == uint64(0) || inodeBefore == uint64(0) ||
       (libc_terminal_activate_receive_owner_fcntl(
            nativeOwner,
            chengHeldExecCapsuleFdDecisionReader,
            chengHeldExecFGetFl) &
        chengHeldExecAccessModeMask) != chengHeldExecAccessReadOnly ||
       libc_terminal_activate_receive_owner_lseek(
           nativeOwner,
           chengHeldExecCapsuleFdDecisionReader,
           int64(0),
           chengHeldExecSeekSet) != int64(0) ||
       !cheng_held_exec_native_receive_owner_read_exact(
           nativeOwner,
           chengHeldExecCapsuleFdDecisionReader,
           ptr(&first),
           chengHeldExecWireBytes) ||
       libc_terminal_activate_receive_owner_lseek(
           nativeOwner,
           chengHeldExecCapsuleFdDecisionReader,
           int64(0),
           chengHeldExecSeekSet) != int64(0) ||
       !cheng_held_exec_native_receive_owner_read_exact(
           nativeOwner,
           chengHeldExecCapsuleFdDecisionReader,
           ptr(&second),
           chengHeldExecWireBytes) ||
       libc_terminal_activate_receive_owner_fstat(
           nativeOwner,
           chengHeldExecCapsuleFdDecisionReader,
           &sizeAfter,
           &modeAfter,
           &deviceAfter,
           &inodeAfter) != 0 ||
       sizeAfter != sizeBefore || modeAfter != modeBefore ||
       deviceAfter != deviceBefore || inodeAfter != inodeBefore ||
       !cheng_held_exec_decision_wires_equal(first, second):
        return 0
    var allZero = true
    for byteIndex in 0..<chengHeldExecWireBytes:
        if second.data[byteIndex] != uint8(0):
            allZero = false
    if allZero:
        return 0
    if !cheng_held_exec_decision_wire_exact_valid(second):
        return 0
    outDecision = second
    return 1

@exportc("cheng_held_exec_child_admission_active")
@abi_internal
fn cheng_held_exec_child_admission_active_export(): int32 =
    return chengHeldExecChildState == 1 ? 1 : 0

@exportc("cheng_held_exec_child_executable_digest")
@abi_internal
fn cheng_held_exec_child_executable_digest_export():
        ChengHeldExecFdDigestResult =
    if chengHeldExecChildState != 1 ||
       !cheng_held_exec_digest_nonzero(
           chengHeldExecChildExecutableDigest):
        return ChengHeldExecFdDigestResult()
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(
        projection, 0, chengHeldExecChildExecutableDigest)
    return ChengHeldExecFdDigestResult(
        status: 1,
        digest0: cheng_held_exec_wire_get_u64(projection, 0),
        digest1: cheng_held_exec_wire_get_u64(projection, 8),
        digest2: cheng_held_exec_wire_get_u64(projection, 16),
        digest3: cheng_held_exec_wire_get_u64(projection, 24))


@exportc("cheng_held_exec_child_take_bundle_bytes")
@abi_internal
@borrows
fn cheng_held_exec_child_take_bundle_bytes_export(
        outBytes: var str): ChengHeldExecBundleTakeResult =
    outBytes = ""
    let capsuleOwner = chengHeldExecChildCapsuleRoleActiveOwner
    let capsuleRow = capsuleOwner - 1
    if chengHeldExecChildState != 1 ||
       chengHeldExecChildChannelFd != chengHeldExecChannelFd ||
       capsuleOwner <= 0 || capsuleRow < 0 || capsuleRow >= 4 ||
       chengHeldExecChildCapsuleRoleOwnerExported != 1 ||
       chengHeldExecChildCapsuleRoleStates[capsuleRow] !=
           chengHeldExecChildCapsuleRoleIssued ||
       chengHeldExecChildCapsuleRoleNativeReceiveOwners[capsuleRow] <= 0 ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecChildBundleDelivered), 0, 1) != 1:
        return ChengHeldExecBundleTakeResult(
            errorCode: chengHeldExecChildErrBundleMissing)
    let nativeOwner =
        chengHeldExecChildCapsuleRoleNativeReceiveOwners[capsuleRow]
    var observedDigest: ChengFixedBytes32
    var observedBytes: uint64
    var bundleSize: int64
    var bundleMode: int32
    var bundleDevice: uint64
    var bundleInode: uint64
    if !cheng_held_exec_native_receive_owner_content_digest_into(
           nativeOwner,
           chengHeldExecCapsuleFdBundleReader,
           observedDigest,
           observedBytes) ||
       observedBytes == uint64(0) ||
       observedBytes > uint64(16777216) ||
       !cheng_fixed32_equal(
           observedDigest, chengHeldExecChildBundleDigest) ||
       libc_terminal_activate_receive_owner_fstat(
           nativeOwner,
           chengHeldExecCapsuleFdBundleReader,
           &bundleSize,
           &bundleMode,
           &bundleDevice,
           &bundleInode) != 0 ||
       bundleSize != int64(observedBytes) ||
       (bundleMode & chengHeldExecTypeMask) != chengHeldExecRegularMode ||
       bundleDevice == uint64(0) || bundleInode == uint64(0) ||
       !cheng_held_exec_bundle_seal_attest_owner(
           nativeOwner,
           chengHeldExecCapsuleFdBundleReader) ||
       libc_terminal_activate_receive_owner_lseek(
           nativeOwner,
           chengHeldExecCapsuleFdBundleReader,
           int64(0),
           chengHeldExecSeekSet) != int64(0):
        cheng_held_exec_child_capsule_role_close(
            capsuleRow,
            chengHeldExecChildCapsuleRoleRecoveryRequired)
        return ChengHeldExecBundleTakeResult(
            errorCode: chengHeldExecChildErrBundleMissing)
    let byteCount = int32(observedBytes)
    let raw = cheng_malloc_export(byteCount + 1)
    if raw == nil:
        cheng_held_exec_child_capsule_role_close(
            capsuleRow,
            chengHeldExecChildCapsuleRoleRecoveryRequired)
        return ChengHeldExecBundleTakeResult(
            errorCode: chengHeldExecChildErrBundleMissing)
    cheng_bytes_set(raw, 0, byteCount + 1)
    var offset: int32
    while offset < byteCount:
        let amount = libc_terminal_activate_receive_owner_read(
            nativeOwner,
            chengHeldExecCapsuleFdBundleReader,
            cheng_ptr_plus(raw, offset),
            byteCount - offset)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) ||
           amount > int64(byteCount - offset):
            cheng_free_export(raw)
            cheng_held_exec_child_capsule_role_close(
                capsuleRow,
                chengHeldExecChildCapsuleRoleRecoveryRequired)
            return ChengHeldExecBundleTakeResult(
                errorCode: chengHeldExecChildErrBundleMissing)
        offset = offset + int32(amount)
    if !cheng_held_exec_child_capsule_role_close_fd_once(
           capsuleRow, chengHeldExecCapsuleFdBundleReader):
        chengHeldExecChildCapsuleRoleStates[capsuleRow] =
            chengHeldExecChildCapsuleRoleRecoveryRequired
        cheng_free_export(raw)
        return ChengHeldExecBundleTakeResult(
            errorCode: chengHeldExecChildErrBundleMissing)
    outBytes = cheng_str_view_owned(raw, byteCount)
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(
        projection, 0, observedDigest)
    let digest0 = cheng_held_exec_wire_get_u64(projection, 0)
    let digest1 = cheng_held_exec_wire_get_u64(projection, 8)
    let digest2 = cheng_held_exec_wire_get_u64(projection, 16)
    let digest3 = cheng_held_exec_wire_get_u64(projection, 24)
    return ChengHeldExecBundleTakeResult(
        status: 1,
        byteCount: byteCount,
        digest0: digest0,
        digest1: digest1,
        digest2: digest2,
        digest3: digest3)
fn cheng_held_exec_plan_evidence_write_cid(
        payload: ptr,
        offset: int32,
        digest: ChengFixedBytes32) =
    let prefix: ptr = "sha256:"
    cheng_bytes_copy(cheng_ptr_plus(payload, offset), prefix, 7)
    for byteIndex in 0..<32:
        let value = int32(digest.data[byteIndex])
        let highByte = cheng_sha256_expected_hex_byte(
            (value >> 4) & 15)
        let lowByte = cheng_sha256_expected_hex_byte(value & 15)
        cheng_bytes_set(
            cheng_ptr_plus(
                payload, offset + 7 + byteIndex * 2),
            int32(highByte),
            1)
        cheng_bytes_set(
            cheng_ptr_plus(
                payload, offset + 8 + byteIndex * 2),
            int32(lowByte),
            1)

fn cheng_held_exec_plan_evidence_digest_from_plan(
        plan: ChengHeldExecWire): ChengFixedBytes32 =
    var out: ChengFixedBytes32
    let payload = cheng_malloc_export(
        chengHeldExecPlanEvidenceByteCount)
    if payload == nil:
        return out
    cheng_bytes_copy(payload, "CSP1", 4)
    for fieldIndex in 0..<9:
        cheng_held_exec_plan_evidence_write_cid(
            payload,
            4 + fieldIndex * chengHeldExecPlanEvidenceCidBytes,
            cheng_held_exec_wire_get_digest(
                plan, 64 + fieldIndex * 32))
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    let domainLength = cheng_str_len(
        chengHeldExecPlanEvidenceDomain)
    let ok = cheng_sha256_stream_init_fixed(
        &stream,
        &stateStorage.data[0],
        &tableStorage.data[0],
        &blockStorage.data[0]) &&
        cheng_sha256_stream_update_u32le(&stream, domainLength) &&
        cheng_sha256_stream_update(
            &stream,
            cheng_str_data(chengHeldExecPlanEvidenceDomain),
            int64(domainLength)) &&
        cheng_sha256_stream_update_u32le(
            &stream, chengHeldExecPlanEvidenceByteCount) &&
        cheng_sha256_stream_update(
            &stream,
            payload,
            int64(chengHeldExecPlanEvidenceByteCount)) &&
        cheng_sha256_stream_finish(&stream, &out.data[0])
    cheng_free_export(payload)
    if !ok:
        return ChengFixedBytes32()
    return out

fn cheng_held_exec_plan_binding_receipt(
        planEvidenceReceipt: ChengFixedBytes32,
        claimReceipt: ChengFixedBytes32,
        ownerClaimReceipt: ChengFixedBytes32): ChengFixedBytes32 =
    var binding: ChengHeldExecWire
    cheng_held_exec_wire_zero(binding)
    cheng_held_exec_wire_put_digest(binding, 0, planEvidenceReceipt)
    cheng_held_exec_wire_put_digest(binding, 32, claimReceipt)
    cheng_held_exec_wire_put_digest(binding, 64, ownerClaimReceipt)
    return cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.plan_bind.v3", binding)

@borrows
fn cheng_held_exec_plan_evidence_decode_into(
        evidenceBytes: str,
        evidenceCid: str,
        outPlan: var ChengHeldExecWire,
        outEvidenceDigest: var ChengFixedBytes32): bool =
    cheng_held_exec_wire_zero(outPlan)
    outEvidenceDigest = ChengFixedBytes32()
    if cheng_str_len(evidenceBytes) !=
           chengHeldExecPlanEvidenceByteCount ||
       cheng_str_data(evidenceBytes) == nil ||
       !cheng_sha256_domain_payload_cid_matches(
           chengHeldExecPlanEvidenceDomain,
           cheng_str_data(evidenceBytes),
           int64(chengHeldExecPlanEvidenceByteCount),
           evidenceCid,
           nil) ||
       !cheng_held_exec_cid_digest_into(
           evidenceCid, outEvidenceDigest):
        return false
    let raw = cheng_str_data(evidenceBytes)
    let magic: ptr = "CSP1"
    for byteIndex in 0..<4:
        if *(UInt8Ptr(cheng_ptr_plus(raw, byteIndex))) !=
           *(UInt8Ptr(cheng_ptr_plus(magic, byteIndex))):
            return false
    for fieldIndex in 0..<9:
        var cid = cheng_str_slice_copy(
            evidenceBytes,
            4 + fieldIndex * chengHeldExecPlanEvidenceCidBytes,
            chengHeldExecPlanEvidenceCidBytes)
        var digest: ChengFixedBytes32
        if !cheng_held_exec_cid_digest_into(cid, digest):
            return false
        cheng_held_exec_wire_put_digest(
            outPlan, 64 + fieldIndex * 32, digest)
    return cheng_fixed32_equal(
        cheng_held_exec_plan_evidence_digest_from_plan(outPlan),
        outEvidenceDigest)

fn cheng_held_exec_child_result_error(
        errorCode: int32): ChengHeldExecChildResult =
    return ChengHeldExecChildResult(errorCode: errorCode)

fn cheng_held_exec_child_result_digest(
        digest: ChengFixedBytes32): ChengHeldExecChildResult =
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(projection, 0, digest)
    let digest0 = cheng_held_exec_wire_get_u64(projection, 0)
    let digest1 = cheng_held_exec_wire_get_u64(projection, 8)
    let digest2 = cheng_held_exec_wire_get_u64(projection, 16)
    let digest3 = cheng_held_exec_wire_get_u64(projection, 24)
    return ChengHeldExecChildResult(
        status: 1,
        digest0: digest0,
        digest1: digest1,
        digest2: digest2,
        digest3: digest3)

@borrows
fn cheng_held_exec_owned_text_clone(value: str): str =
    let byteCount = cheng_str_len(value)
    let source = cheng_str_data(value)
    if byteCount <= 0 || source == nil:
        return ""
    let owned = cheng_malloc_export(byteCount + 1)
    if owned == nil:
        return ""
    cheng_bytes_copy(owned, source, byteCount)
    cheng_bytes_set(cheng_ptr_plus(owned, byteCount), 0, 1)
    return cheng_str_view_owned(owned, byteCount)

@exportc("cheng_held_exec_child_bind_plan_receipt")
@abi_internal
@borrows
fn cheng_held_exec_child_bind_plan_receipt_export(
        planEvidenceBytes: str,
        planEvidenceCid: str): ChengHeldExecChildResult =
    if chengHeldExecChildState != 1 ||
       chengHeldExecChildChannelFd != chengHeldExecChannelFd ||
       chengHeldExecChildBundleDelivered != 1:
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrAdmissionMissing)
    var plan: ChengHeldExecWire
    var planEvidenceDigest: ChengFixedBytes32
    if !cheng_held_exec_plan_evidence_decode_into(
           planEvidenceBytes,
           planEvidenceCid,
           plan,
           planEvidenceDigest):
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrPlanCidInvalid)
    if chengHeldExecChildCapsuleRoleNextRow != 1 ||
       chengHeldExecChildCapsuleRoleStates[0] !=
           chengHeldExecChildCapsuleRoleIssued ||
       chengHeldExecChildCapsuleRolePlanBound[0] != 0:
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrPlanCidInvalid)
    let childClaimDigest = chengHeldExecChildClaimDigest
    let ownerClaimDigest = chengHeldExecChildOwnerClaimDigest
    let planReceipt = cheng_held_exec_plan_binding_receipt(
        planEvidenceDigest,
        childClaimDigest,
        ownerClaimDigest)
    if !cheng_held_exec_digest_nonzero(planReceipt):
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrPlanCidInvalid)
    chengHeldExecChildPlanReceiptDigest = planReceipt
    chengHeldExecChildPlanEvidenceDigest = planEvidenceDigest
    let planEvidenceRaw = cheng_str_data(planEvidenceBytes)
    if planEvidenceRaw == nil:
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrPlanCidInvalid)
    cheng_bytes_copy(
        ptr(&chengHeldExecChildCapsuleRolePlanEvidence[0]),
        planEvidenceRaw,
        chengHeldExecPlanEvidenceByteCount)
    chengHeldExecChildCapsuleRolePlanBound[0] = 1
    chengHeldExecChildState = 2
    return cheng_held_exec_child_result_digest(planReceipt)

@exportc("cheng_held_exec_child_publish_output")
@abi_internal
@borrows
fn cheng_held_exec_child_publish_output_export(
        outputCid: str,
        compileReceiptCid: str,
        compileReceiptCanonical: str,
        outputPath: str): ChengHeldExecChildResult =
    var outputDigest: ChengFixedBytes32
    var compileReceiptDigest: ChengFixedBytes32
    var pathDigest: ChengFixedBytes32
    if chengHeldExecChildCapsuleRoleNextRow != 1 ||
       chengHeldExecChildCapsuleRoleStates[0] !=
           chengHeldExecChildCapsuleRoleIssued ||
       chengHeldExecChildCapsuleRolePlanBound[0] != 1 ||
       chengHeldExecChildCapsuleRoleCompileReceiptCanonical[0].len != 0 ||
       chengHeldExecChildState != 2 ||
       cheng_os_is_absolute_bridge_export(outputPath) != 1 ||
       !cheng_held_exec_cid_digest_into(outputCid, outputDigest) ||
       !cheng_held_exec_cid_digest_into(
           compileReceiptCid, compileReceiptDigest) ||
       cheng_str_len(compileReceiptCanonical) <= 0 ||
       cheng_str_len(compileReceiptCanonical) > int32(1048576) ||
       cheng_str_contains_nul(compileReceiptCanonical) ||
       !cheng_held_exec_output_path_digest_into(
           outputPath, pathDigest) ||
       !cheng_fixed32_equal(
           pathDigest,
           chengHeldExecChildExpectedOutputPathDigest):
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrOutputBindingInvalid)
    let outputFd = libc_open_runtime(
        cheng_str_data(outputPath),
        chengHeldExecOReadCloexecNoFollow)
    if outputFd < 0 || outputFd == chengHeldExecChildChannelFd:
        if outputFd >= 0:
            let _closeAlias = libc_close(outputFd)
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrOutputOpenFailed)
    let enableRc =
        cheng_linux_fsverity_enable_sha256_runtime(outputFd)
    var enableErrno: int32
    if enableRc != 0:
        enableErrno = native_cheng_errno_code_runtime()
    var verityDigest: ChengFixedBytes32
    var measuredDigest: ChengFixedBytes32
    var identityDigest: ChengFixedBytes32
    var outputBytes: uint64
    if (enableRc != 0 && enableErrno != chengErrnoEexist) ||
       cheng_linux_fsverity_measure_sha256_runtime(
           outputFd, &verityDigest.data[0]) != 0 ||
       !cheng_held_exec_digest_nonzero(verityDigest) ||
       !cheng_held_exec_fd_content_digest_into(
           outputFd, measuredDigest, outputBytes) ||
       !cheng_fixed32_equal(measuredDigest, outputDigest) ||
       !cheng_held_exec_file_identity_digest(
           outputFd, identityDigest) ||
       !cheng_held_exec_named_output_matches(
           outputFd, outputPath):
        let _closeInvalidOutput = libc_close(outputFd)
       return cheng_held_exec_child_result_error(
            chengHeldExecChildErrOutputSealInvalid)
    let ownedCompileReceiptCanonical =
        cheng_held_exec_owned_text_clone(compileReceiptCanonical)
    if cheng_str_len(ownedCompileReceiptCanonical) !=
           cheng_str_len(compileReceiptCanonical):
        let _closeUnownedOutput = libc_close(outputFd)
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrOutputBindingInvalid)
    chengHeldExecChildOutputDigest = outputDigest
    chengHeldExecChildCompileReceiptDigest = compileReceiptDigest
    chengHeldExecChildOutputPathDigest = pathDigest
    chengHeldExecChildOutputVerityDigest = verityDigest
    chengHeldExecChildOutputIdentityDigest = identityDigest
    chengHeldExecChildOutputBytes = outputBytes
    chengHeldExecChildOutputFd = outputFd
    chengHeldExecChildCapsuleRoleCompileReceiptCanonical[0] =
        ownedCompileReceiptCanonical
    chengHeldExecChildState = 3
    return ChengHeldExecChildResult(status: 1)

@exportc("cheng_held_exec_child_finish")
@abi_internal
@borrows
fn cheng_held_exec_child_finish_export(
        childCapsuleOwner: int32,
        exitCode: int32,
        allocationReceiptCid: str): ChengHeldExecChildResult =
    var allocationReceipt: ChengFixedBytes32
    let capsuleRow = childCapsuleOwner - 1
    if capsuleRow < 0 || capsuleRow >= 4 ||
       chengHeldExecChildCapsuleRoleStates[capsuleRow] !=
           chengHeldExecChildCapsuleRoleIssued ||
       chengHeldExecChildState < 1 ||
       chengHeldExecChildChannelFd != chengHeldExecChannelFd ||
       !cheng_held_exec_cid_digest_into(
           allocationReceiptCid, allocationReceipt) ||
       (exitCode == 0 &&
        (chengHeldExecChildState != 3 ||
         chengHeldExecChildOutputFd < 0 ||
         chengHeldExecChildOutputBytes == uint64(0))):
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrTerminalPreconditionFailed)
    chengHeldExecChildCapsuleRoleStates[capsuleRow] =
        chengHeldExecChildCapsuleRoleFinishing
    var terminal: ChengHeldExecWire
    cheng_held_exec_wire_header(
        terminal,
        chengHeldExecKindFinished,
        uint64(3),
        chengHeldExecChildNonce)
    cheng_held_exec_wire_put_digest(
        terminal, 64, chengHeldExecChildClaimDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 96, chengHeldExecChildOwnerClaimDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 128, chengHeldExecChildPlanReceiptDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 160, chengHeldExecChildOutputDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 192, chengHeldExecChildCompileReceiptDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 224, allocationReceipt)
    cheng_held_exec_wire_put_digest(
        terminal, 288, chengHeldExecChildOutputPathDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 320, chengHeldExecChildOutputVerityDigest)
    cheng_held_exec_wire_put_digest(
        terminal, 352, chengHeldExecChildOutputIdentityDigest)
    cheng_held_exec_wire_put_u64(
        terminal, 384, chengHeldExecChildOutputBytes)
    cheng_held_exec_wire_put_u64(
        terminal, 392, uint64(uint32(exitCode)))
    cheng_held_exec_wire_put_digest(
        terminal, 416, chengHeldExecChildPlanEvidenceDigest)
    var childIdentityWire: ChengHeldExecWire
    cheng_held_exec_wire_zero(childIdentityWire)
    cheng_held_exec_wire_put_digest(
        childIdentityWire, 0, chengHeldExecChildClaimDigest)
    cheng_held_exec_wire_put_digest(
        childIdentityWire, 32, chengHeldExecChildExecutableDigest)
    let childIdentity = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.child_identity.v2", childIdentityWire)
    cheng_held_exec_wire_put_digest(terminal, 448, childIdentity)
    let terminalReceipt = cheng_held_exec_wire_digest(
        "cheng.runtime.held_exec.finished_receipt.v2", terminal)
    cheng_held_exec_wire_put_digest(terminal, 256, terminalReceipt)
    if !cheng_held_exec_child_install_finished_upload(
           capsuleRow, terminal, allocationReceipt, exitCode):
        if chengHeldExecChildOutputFd >= 0:
            let _closeOutputOnUploadFailure =
                libc_close(chengHeldExecChildOutputFd)
            chengHeldExecChildOutputFd = -1
        cheng_held_exec_child_capsule_role_close(
            capsuleRow,
            chengHeldExecChildCapsuleRoleRecoveryRequired)
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrTerminalPreconditionFailed)
    var decision: ChengHeldExecWire
    var decisionStatus = cheng_held_exec_child_decision_mirror_read_into(
        capsuleRow, decision)
    let decisionWatchOwner = decisionStatus >= 0 ?
        libc_terminal_activate_receive_owner_watch_arm(
            chengHeldExecChildCapsuleRoleNativeReceiveOwners[capsuleRow],
            chengHeldExecCapsuleFdDecisionReader,
            chengHeldExecChildChannelFd) : -1
    if decisionWatchOwner > 0:
        # Close the read-before-arm race before either transport can be
        # consumed. Even when the mirror is already complete, the socket
        # must remain armed until its exact frame or EOF is observed.
        decisionStatus =
            cheng_held_exec_child_decision_mirror_read_into(
                capsuleRow, decision)
    if decisionStatus < 0 || decisionWatchOwner <= 0:
        if decisionWatchOwner > 0:
            let _closeInvalidWatch =
                libc_terminal_decision_watch_close_runtime(
                    decisionWatchOwner)
        if chengHeldExecChildOutputFd >= 0:
            let _closeOutputOnWatchFailure =
                libc_close(chengHeldExecChildOutputFd)
            chengHeldExecChildOutputFd = -1
        cheng_held_exec_child_capsule_role_close(
            capsuleRow,
            chengHeldExecChildCapsuleRoleRecoveryRequired)
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrDecisionInvalid)
    let _terminalNotificationSent = exitCode == 0 ?
        cheng_held_exec_send_wire_with_fd(
            chengHeldExecChildChannelFd,
            terminal,
            chengHeldExecChildOutputFd) :
        cheng_held_exec_send_wire(
            chengHeldExecChildChannelFd, terminal)
    # FINISHED is the child's last write on the session socket.  A failed
    # notification therefore becomes an event-driven EOF at the parent while
    # the child keeps the read half for the durable decision mirror/socket.
    let notificationWriteClosed =
        libc_shutdown_native(chengHeldExecChildChannelFd, 1) == 0
    if chengHeldExecChildOutputFd >= 0:
        let _closeOutputAfterSend =
            libc_close(chengHeldExecChildOutputFd)
        chengHeldExecChildOutputFd = -1
    var socketSettled = false
    var waitFailed = !notificationWriteClosed
    while (decisionStatus == 0 || !socketSettled) && !waitFailed:
        let eventKind = libc_terminal_decision_watch_wait_runtime(
            decisionWatchOwner)
        if eventKind == 1:
            decisionStatus =
                cheng_held_exec_child_decision_mirror_read_into(
                    capsuleRow, decision)
            if decisionStatus != 1:
                waitFailed = true
            else:
                var socketDecision: ChengHeldExecWire
                let socketReceive = cheng_held_exec_receive_wire(
                    chengHeldExecChildChannelFd, socketDecision)
                let socketDecisionValid = socketReceive.status == 1 &&
                    cheng_held_exec_credentials_match(
                        socketReceive.pid,
                        socketReceive.uid,
                        socketReceive.gid,
                        chengHeldExecChildParentPid,
                        chengHeldExecChildParentUid,
                        chengHeldExecChildParentGid) &&
                    cheng_held_exec_decision_wire_exact_valid(
                        socketDecision) &&
                    cheng_held_exec_decision_wires_equal(
                        decision, socketDecision)
                if !socketDecisionValid:
                    waitFailed = true
                else:
                    socketSettled = true
        elif eventKind == 2:
            decisionStatus =
                cheng_held_exec_child_decision_mirror_read_into(
                    capsuleRow, decision)
        elif eventKind == 4:
            socketSettled = true
            decisionStatus =
                cheng_held_exec_child_decision_mirror_read_into(
                    capsuleRow, decision)
        else:
            waitFailed = true
    var watchClosed = true
    if decisionWatchOwner > 0:
        watchClosed = libc_terminal_decision_watch_close_runtime(
            decisionWatchOwner) == 1
    let expectedDecisionKind = exitCode == 0 ?
        chengHeldExecKindCommitted : chengHeldExecKindAborted
    let decisionValid =
        !waitFailed && socketSettled && watchClosed &&
        decisionStatus == 1 &&
        cheng_held_exec_decision_wire_exact_valid(decision) &&
        cheng_held_exec_wire_header_valid(
            decision,
            expectedDecisionKind,
            uint64(4),
            chengHeldExecChildNonce) &&
        cheng_fixed32_equal(
            cheng_held_exec_wire_get_digest(decision, 64),
            chengHeldExecChildClaimDigest) &&
        cheng_fixed32_equal(
            cheng_held_exec_wire_get_digest(decision, 96),
            terminalReceipt) &&
        cheng_fixed32_equal(
            cheng_held_exec_wire_get_digest(decision, 128),
            chengHeldExecChildOwnerClaimDigest) &&
        cheng_atomic_cas_i32_export(
            ptr(&chengHeldExecChildDecisionConsumed), 0, 1) == 1
    let _close = libc_close(chengHeldExecChildChannelFd)
    cheng_held_exec_child_capsule_role_close(
        capsuleRow,
        decisionValid ?
            chengHeldExecChildCapsuleRoleConsumed :
            chengHeldExecChildCapsuleRoleRecoveryRequired)
    chengHeldExecChildChannelFd = -1
    chengHeldExecChildState = 4
    if !decisionValid:
        return cheng_held_exec_child_result_error(
            chengHeldExecChildErrDecisionInvalid)
    return cheng_held_exec_child_result_digest(terminalReceipt)

fn cheng_held_exec_parent_session_state(
        slot: int32): int32 =
    if slot < 0 || slot >= chengHeldExecParentSessionCount:
        return -1
    let stateAddress = cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        chengHeldExecParentArenaStateOffset + slot * 4)
    return cheng_atomic_load_i32_export(
        stateAddress)

fn cheng_held_exec_parent_session_cas(
        slot: int32,
        expected: int32,
        desired: int32): bool =
    if slot < 0 || slot >= chengHeldExecParentSessionCount:
        return false
    let stateAddress = cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        chengHeldExecParentArenaStateOffset + slot * 4)
    return cheng_atomic_cas_i32_export(
        stateAddress, expected, desired) == 1

fn cheng_held_exec_parent_session_store(
        slot: int32,
        state: int32) =
    if slot >= 0 && slot < chengHeldExecParentSessionCount:
        let stateAddress = cheng_ptr_plus(
            ptr(&chengHeldExecParentSessionArena),
            chengHeldExecParentArenaStateOffset + slot * 4)
        cheng_atomic_store_i32_export(
            stateAddress, state)

fn cheng_held_exec_parent_session_i32_load(
        columnOffset: int32,
        slot: int32): int32 =
    return *(Int32Ptr(cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        columnOffset + slot * 4)))

fn cheng_held_exec_parent_session_i32_store(
        columnOffset: int32,
        slot: int32,
        value: int32) =
    *(Int32Ptr(cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        columnOffset + slot * 4))) = value

fn cheng_held_exec_parent_session_u32_load(
        columnOffset: int32,
        slot: int32): uint32 =
    return *(UInt32Ptr(cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        columnOffset + slot * 4)))

fn cheng_held_exec_parent_session_u32_store(
        columnOffset: int32,
        slot: int32,
        value: uint32) =
    *(UInt32Ptr(cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        columnOffset + slot * 4))) = value

fn cheng_held_exec_parent_session_u64_load(
        columnOffset: int32,
        slot: int32): uint64 =
    return *(UInt64Ptr(cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        columnOffset + slot * 8)))

fn cheng_held_exec_parent_session_u64_store(
        columnOffset: int32,
        slot: int32,
        value: uint64) =
    *(UInt64Ptr(cheng_ptr_plus(
        ptr(&chengHeldExecParentSessionArena),
        columnOffset + slot * 8))) = value

fn cheng_held_exec_parent_session_digest_word_index(
        field: int32,
        limb: int32,
        slot: int32): int32 =
    return field * 16 + limb * chengHeldExecParentSessionCount + slot

fn cheng_held_exec_parent_session_digest_store(
        field: int32,
        slot: int32,
        digest: ChengFixedBytes32) =
    if field < 0 || field >= chengHeldExecParentDigestFieldCount ||
       slot < 0 || slot >= chengHeldExecParentSessionCount:
        return
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(projection, 0, digest)
    for limb in 0..<4:
        let wordIndex =
            cheng_held_exec_parent_session_digest_word_index(
                field, limb, slot)
        cheng_held_exec_parent_session_u64_store(
            chengHeldExecParentArenaDigestOffset,
            wordIndex,
            cheng_held_exec_wire_get_u64(projection, limb * 8))

fn cheng_held_exec_parent_session_digest_load(
        field: int32,
        slot: int32): ChengFixedBytes32 =
    if field < 0 || field >= chengHeldExecParentDigestFieldCount ||
       slot < 0 || slot >= chengHeldExecParentSessionCount:
        return ChengFixedBytes32()
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    for limb in 0..<4:
        cheng_held_exec_wire_put_u64(
            projection,
            limb * 8,
            cheng_held_exec_parent_session_u64_load(
                chengHeldExecParentArenaDigestOffset,
                cheng_held_exec_parent_session_digest_word_index(
                    field, limb, slot)))
    return cheng_held_exec_wire_get_digest(projection, 0)

fn cheng_held_exec_terminal_observation_allocate_row(): int32 =
    let row = cheng_atomic_fetch_add_i32_export(
        ptr(&chengHeldExecTerminalObservationNextRow), 1)
    if row < 0 || row >= chengHeldExecTerminalObservationRowCount:
        return -1
    return row

fn cheng_held_exec_terminal_observation_publish(
        session: int32,
        slot: int32,
        phase: int32): int32 =
    if session <= 0 || slot < 0 ||
       slot >= chengHeldExecParentSessionCount ||
       (phase != 1 && phase != 2):
        return -1
    let childPid = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChildPidOffset, slot)
    let childUid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaObservedUidOffset, slot)
    let childGid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaChildGidOffset, slot)
    let signalNumber = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedSignalOffset, slot)
    let siCode = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedSiCodeOffset, slot)
    let rawStatus = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedRawStatusOffset, slot)
    let exitCode = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedExitOffset, slot)
    let rawWaitStatus = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaObservedRawWaitStatusOffset, slot)
    let claimDigest = cheng_held_exec_parent_session_digest_load(
        chengHeldExecParentDigestClaim, slot)
    let ownerClaimDigest = cheng_held_exec_parent_session_digest_load(
        chengHeldExecParentDigestOwnerClaim, slot)
    let terminalDigest = cheng_held_exec_parent_session_digest_load(
        chengHeldExecParentDigestTerminal, slot)
    if childPid <= 0 || signalNumber <= 0 || siCode < 1 || siCode > 3 ||
       rawStatus < 0 || exitCode != 0 ||
       (phase == 1 && rawWaitStatus != -1) ||
       !cheng_held_exec_digest_nonzero(claimDigest) ||
       !cheng_held_exec_digest_nonzero(ownerClaimDigest) ||
       !cheng_held_exec_digest_nonzero(terminalDigest):
        return -1
    let row = cheng_held_exec_terminal_observation_allocate_row()
    if row < 0:
        return -1
    chengHeldExecTerminalObservationSessions[row] = session
    chengHeldExecTerminalObservationPhases[row] = phase
    chengHeldExecTerminalObservationChildPids[row] = childPid
    chengHeldExecTerminalObservationChildUids[row] = childUid
    chengHeldExecTerminalObservationChildGids[row] = childGid
    chengHeldExecTerminalObservationSignals[row] = signalNumber
    chengHeldExecTerminalObservationSiCodes[row] = siCode
    chengHeldExecTerminalObservationRawStatuses[row] = rawStatus
    chengHeldExecTerminalObservationExitCodes[row] = exitCode
    chengHeldExecTerminalObservationRawWaitStatuses[row] = rawWaitStatus
    chengHeldExecTerminalObservationClaimDigests[row] = claimDigest
    chengHeldExecTerminalObservationOwnerClaimDigests[row] =
        ownerClaimDigest
    chengHeldExecTerminalObservationTerminalDigests[row] = terminalDigest
    let issued = chengHeldExecTerminalObservationIssued
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalObservationStates[row]),
        issued)
    return row + 1

fn cheng_held_exec_terminal_observation_encode_row(
        row: int32,
        out: var ChengHeldExecWire): bool =
    cheng_held_exec_wire_zero(out)
    if row < 0 || row >= chengHeldExecTerminalObservationRowCount:
        return false
    cheng_held_exec_wire_put_u64(
        out, 0, chengHeldExecTerminalObservationMagic)
    cheng_held_exec_wire_put_u64(
        out, 8, chengHeldExecTerminalObservationVersion)
    cheng_held_exec_wire_put_u64(
        out, 16, uint64(chengHeldExecTerminalObservationPhases[row]))
    cheng_held_exec_wire_put_u64(
        out, 24, uint64(chengHeldExecTerminalObservationChildPids[row]))
    cheng_held_exec_wire_put_u64(
        out, 32, uint64(chengHeldExecTerminalObservationChildUids[row]))
    cheng_held_exec_wire_put_u64(
        out, 40, uint64(chengHeldExecTerminalObservationChildGids[row]))
    cheng_held_exec_wire_put_u64(
        out, 48, uint64(chengHeldExecTerminalObservationSignals[row]))
    cheng_held_exec_wire_put_u64(
        out, 56, uint64(chengHeldExecTerminalObservationSiCodes[row]))
    cheng_held_exec_wire_put_u64(
        out, 64, uint64(chengHeldExecTerminalObservationRawStatuses[row]))
    cheng_held_exec_wire_put_u64(
        out, 72, uint64(chengHeldExecTerminalObservationExitCodes[row]))
    cheng_held_exec_wire_put_u64(
        out,
        80,
        uint64(chengHeldExecTerminalObservationRawWaitStatuses[row]))
    cheng_held_exec_wire_put_digest(
        out, 88, chengHeldExecTerminalObservationClaimDigests[row])
    cheng_held_exec_wire_put_digest(
        out,
        120,
        chengHeldExecTerminalObservationOwnerClaimDigests[row])
    cheng_held_exec_wire_put_digest(
        out, 152, chengHeldExecTerminalObservationTerminalDigests[row])
    cheng_held_exec_wire_put_u64(
        out, 216, uint64(chengHeldExecTerminalObservationSessions[row]))
    let receipt = cheng_held_exec_terminal_observation_canonical_digest(
        "cheng.runtime.held_exec.terminal_observation.canonical.v1",
        out)
    if !cheng_held_exec_digest_nonzero(receipt):
        return false
    cheng_held_exec_wire_put_digest(out, 184, receipt)
    return true

@borrows
fn cheng_held_exec_terminal_observation_wire_exact_equal(
        left: ChengHeldExecWire,
        right: str): bool =
    if cheng_str_len(right) !=
           chengHeldExecTerminalObservationCanonicalBytes ||
       cheng_str_data(right) == nil:
        return false
    for byteIndex in 0..<chengHeldExecTerminalObservationCanonicalBytes:
        if left.data[byteIndex] !=
           *(UInt8Ptr(cheng_ptr_plus(
               cheng_str_data(right), byteIndex))):
            return false
    return true

fn cheng_held_exec_terminal_permission_matches_locked(
        roleRow: int32,
        phase: int32,
        permission0: int32,
        permission1: int32,
        permission2: int32,
        permission3: int32): bool =
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount ||
       (phase != 1 && phase != 2):
        return false
    let stored0 = phase == 1 ?
        chengHeldExecCapsuleProviderRoleExitPermission0[roleRow] :
        chengHeldExecCapsuleProviderRoleReapPermission0[roleRow]
    let stored1 = phase == 1 ?
        chengHeldExecCapsuleProviderRoleExitPermission1[roleRow] :
        chengHeldExecCapsuleProviderRoleReapPermission1[roleRow]
    let stored2 = phase == 1 ?
        chengHeldExecCapsuleProviderRoleExitPermission2[roleRow] :
        chengHeldExecCapsuleProviderRoleReapPermission2[roleRow]
    let stored3 = phase == 1 ?
        chengHeldExecCapsuleProviderRoleExitPermission3[roleRow] :
        chengHeldExecCapsuleProviderRoleReapPermission3[roleRow]
    let difference =
        (uint32(stored0) ^ uint32(permission0)) |
        (uint32(stored1) ^ uint32(permission1)) |
        (uint32(stored2) ^ uint32(permission2)) |
        (uint32(stored3) ^ uint32(permission3))
    return difference == uint32(0) &&
        (stored0 != 0 || stored1 != 0 || stored2 != 0 || stored3 != 0)

# Bind is a one-shot move from the AtomicTree phase permission into a fresh
# append-only bind owner plus fresh 128-bit commit cargo.  The source phase
# permission is consumed here; copied or replayed inputs are rejected.
@exportc("cheng_held_exec_terminal_observation_bind_durable_prefix")
@abi_internal
@borrows
fn cheng_held_exec_terminal_observation_bind_durable_prefix_export(
        transportOwner: int32,
        session: int32,
        phase: int32,
        permission0: int32,
        permission1: int32,
        permission2: int32,
        permission3: int32,
        sessionCid: str,
        predecessorReceiptCid: str,
        evidenceBReceiptCid: str,
        outCommitPermission0: ptr,
        outCommitPermission1: ptr,
        outCommitPermission2: ptr,
        outCommitPermission3: ptr): int32 =
    if outCommitPermission0 == nil || outCommitPermission1 == nil ||
       outCommitPermission2 == nil || outCommitPermission3 == nil:
        return -1
    *(Int32Ptr(outCommitPermission0)) = 0
    *(Int32Ptr(outCommitPermission1)) = 0
    *(Int32Ptr(outCommitPermission2)) = 0
    *(Int32Ptr(outCommitPermission3)) = 0
    let roleRow = transportOwner - 1
    var sessionCidDigest: ChengFixedBytes32
    var predecessorDigest: ChengFixedBytes32
    var evidenceBDigest: ChengFixedBytes32
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount ||
       session <= 0 || (phase != 1 && phase != 2) ||
       !cheng_held_exec_cid_digest_into(sessionCid, sessionCidDigest) ||
       !cheng_held_exec_cid_digest_into(
           predecessorReceiptCid, predecessorDigest) ||
       !cheng_held_exec_cid_digest_into(
           evidenceBReceiptCid, evidenceBDigest):
        return -1
    var commitPermission: uint64[2]
    if cheng_system_entropy_fill(ptr(&commitPermission[0]), 16) != 1:
        commitPermission[0] = uint64(0)
        commitPermission[1] = uint64(0)
        return -1
    let issuedPermission0 =
        int32(uint32(commitPermission[0] & uint64(4294967295)))
    let issuedPermission1 =
        int32(uint32(commitPermission[0] >> uint64(32)))
    let issuedPermission2 =
        int32(uint32(commitPermission[1] & uint64(4294967295)))
    let issuedPermission3 =
        int32(uint32(commitPermission[1] >> uint64(32)))
    if (issuedPermission0 == 0 && issuedPermission1 == 0 &&
        issuedPermission2 == 0 && issuedPermission3 == 0) ||
       (issuedPermission0 == permission0 &&
        issuedPermission1 == permission1 &&
        issuedPermission2 == permission2 &&
        issuedPermission3 == permission3):
        commitPermission[0] = uint64(0)
        commitPermission[1] = uint64(0)
        return -1
    cheng_runtime_lock()
    let roleState = chengHeldExecCapsuleProviderRoleStates[roleRow]
    let permissionState = phase == 1 ?
        cheng_atomic_load_i32_export(ptr(
            &chengHeldExecCapsuleProviderRoleExitPermissionStates[roleRow])) :
        cheng_atomic_load_i32_export(ptr(
            &chengHeldExecCapsuleProviderRoleReapPermissionStates[roleRow]))
    let roleValid =
        roleRow < chengHeldExecCapsuleProviderRoleNextRow &&
        (roleState == chengHeldExecCapsuleProviderRoleFinishedExported ||
         roleState == chengHeldExecCapsuleProviderRoleDecisionSent) &&
        chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow] == session &&
        permissionState == chengHeldExecTerminalPermissionUnbound &&
        cheng_held_exec_terminal_permission_matches_locked(
            roleRow,
            phase,
            permission0,
            permission1,
            permission2,
            permission3)
    var valid = roleValid
    if valid && phase == 1:
        valid = !cheng_held_exec_digest_nonzero(
                    chengHeldExecCapsuleProviderRoleSessionCidDigests[
                        roleRow]) &&
            !cheng_held_exec_digest_nonzero(
                chengHeldExecCapsuleProviderRoleExitPredecessorDigests[
                    roleRow]) &&
            !cheng_held_exec_digest_nonzero(
                chengHeldExecCapsuleProviderRoleExitEvidenceBDigests[roleRow])
    elif valid:
        valid =
            cheng_atomic_load_i32_export(ptr(
                &chengHeldExecCapsuleProviderRoleExitPermissionStates[
                    roleRow])) == chengHeldExecTerminalPermissionConsumed &&
            cheng_fixed32_equal(
                chengHeldExecCapsuleProviderRoleSessionCidDigests[roleRow],
                sessionCidDigest) &&
            cheng_fixed32_equal(
                chengHeldExecCapsuleProviderRoleReapPredecessorDigests[
                    roleRow],
                predecessorDigest) &&
            cheng_fixed32_equal(
                chengHeldExecCapsuleProviderRoleReapEvidenceBDigests[roleRow],
                evidenceBDigest)
    let bindRow = valid ? chengHeldExecTerminalBindOwnerNextRow : -1
    if bindRow < 0 || bindRow >= chengHeldExecTerminalBindOwnerRowCount ||
       cheng_atomic_load_i32_export(ptr(
           &chengHeldExecTerminalBindOwnerStates[bindRow])) != 0:
        valid = false
    if valid:
        chengHeldExecTerminalBindOwnerNextRow = bindRow + 1
        chengHeldExecCapsuleProviderRoleSessionCidDigests[roleRow] =
            sessionCidDigest
        if phase == 1:
            chengHeldExecCapsuleProviderRoleExitPredecessorDigests[roleRow] =
                predecessorDigest
            chengHeldExecCapsuleProviderRoleExitEvidenceBDigests[roleRow] =
                evidenceBDigest
            cheng_atomic_store_i32_export(ptr(
                &chengHeldExecCapsuleProviderRoleExitPermissionStates[
                    roleRow]), chengHeldExecTerminalPermissionConsumed)
        else:
            cheng_atomic_store_i32_export(ptr(
                &chengHeldExecCapsuleProviderRoleReapPermissionStates[
                    roleRow]), chengHeldExecTerminalPermissionConsumed)
        chengHeldExecTerminalBindOwnerTransports[bindRow] = transportOwner
        chengHeldExecTerminalBindOwnerSessions[bindRow] = session
        chengHeldExecTerminalBindOwnerPhases[bindRow] = phase
        chengHeldExecTerminalBindOwnerPermission0[bindRow] = issuedPermission0
        chengHeldExecTerminalBindOwnerPermission1[bindRow] = issuedPermission1
        chengHeldExecTerminalBindOwnerPermission2[bindRow] = issuedPermission2
        chengHeldExecTerminalBindOwnerPermission3[bindRow] = issuedPermission3
        chengHeldExecTerminalBindOwnerSessionCidDigests[bindRow] =
            sessionCidDigest
        chengHeldExecTerminalBindOwnerPredecessorDigests[bindRow] =
            predecessorDigest
        chengHeldExecTerminalBindOwnerEvidenceBDigests[bindRow] =
            evidenceBDigest
        *(Int32Ptr(outCommitPermission0)) = issuedPermission0
        *(Int32Ptr(outCommitPermission1)) = issuedPermission1
        *(Int32Ptr(outCommitPermission2)) = issuedPermission2
        *(Int32Ptr(outCommitPermission3)) = issuedPermission3
        cheng_atomic_store_i32_export(ptr(
            &chengHeldExecTerminalBindOwnerStates[bindRow]),
            chengHeldExecTerminalBindOwnerIssued)
    cheng_runtime_unlock()
    commitPermission[0] = uint64(0)
    commitPermission[1] = uint64(0)
    return valid ? bindRow + 1 : -1

# A syntactically valid CID is not a durable acknowledgement. Validate the
# exact finalized CTJR record, including phase, runtime session embedded in
# the immutable observation, observation bytes, evidence digest and the
# receipt recomputed with the record receipt slot cleared.
@borrows
fn cheng_held_exec_terminal_observation_durable_record_exact_into(
        session: int32,
        phase: int32,
        projectedCanonical: ChengHeldExecWire,
        expectedSessionCidDigest: ChengFixedBytes32,
        expectedPredecessorDigest: ChengFixedBytes32,
        expectedEvidenceBDigest: ChengFixedBytes32,
        durableRecordCanonical: str,
        durableRecordReceiptCid: str,
        outRecordDigest: var ChengFixedBytes32): bool =
    outRecordDigest = ChengFixedBytes32()
    if session <= 0 ||
       (phase != 1 && phase != 2) ||
       cheng_str_len(durableRecordCanonical) !=
           chengHeldExecTerminalJournalRecordBytes ||
       cheng_str_data(durableRecordCanonical) == nil ||
       cheng_held_exec_wire_get_u64(projectedCanonical, 216) !=
           uint64(session):
        return false
    var record: ChengHeldExecWire
    cheng_held_exec_wire_zero(record)
    cheng_bytes_copy(
        ptr(&record),
        cheng_str_data(durableRecordCanonical),
        chengHeldExecTerminalJournalRecordBytes)
    let expectedRecordPhase: uint32 = phase == 1 ? uint32(5) : uint32(6)
    let recordDecision = cheng_held_exec_wire_get_u32(record, 12)
    var evidenceProjection = projectedCanonical
    let exitEvidenceDomain: ptr =
        "cheng.runtime.held_exec.exit_observation.canonical.v1"
    let reapEvidenceDomain: ptr =
        "cheng.runtime.held_exec.reap_observation.canonical.v1"
    let evidenceDomain = phase == 1 ?
        exitEvidenceDomain : reapEvidenceDomain
    let expectedEvidence =
        cheng_held_exec_terminal_observation_canonical_digest(
            evidenceDomain,
            evidenceProjection)
    let recordReceipt = cheng_held_exec_wire_get_digest(record, 232)
    if cheng_held_exec_wire_get_u32(record, 0) != uint32(1380602947) ||
       cheng_held_exec_wire_get_u32(record, 4) != uint32(1) ||
       cheng_held_exec_wire_get_u32(record, 8) != expectedRecordPhase ||
       (recordDecision != uint32(1) && recordDecision != uint32(2)) ||
       cheng_held_exec_wire_get_u32(record, 220) !=
           uint32(cheng_held_exec_wire_get_u64(projectedCanonical, 24)) ||
       cheng_held_exec_wire_get_u32(record, 224) !=
           uint32(cheng_held_exec_wire_get_u64(projectedCanonical, 32)) ||
       cheng_held_exec_wire_get_u32(record, 228) !=
           uint32(cheng_held_exec_wire_get_u64(projectedCanonical, 40)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(record, 80),
           cheng_held_exec_wire_get_digest(projectedCanonical, 88)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(record, 112),
           cheng_held_exec_wire_get_digest(projectedCanonical, 152)) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(record, 144),
           expectedEvidence) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(record, 16),
           expectedSessionCidDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(record, 48),
           expectedPredecessorDigest) ||
       !cheng_fixed32_equal(
           cheng_held_exec_wire_get_digest(record, 176),
           expectedEvidenceBDigest) ||
       !cheng_held_exec_digest_nonzero(recordReceipt):
        return false
    for byteIndex in 0..<chengHeldExecTerminalObservationCanonicalBytes:
        if record.data[264 + byteIndex] !=
           projectedCanonical.data[byteIndex]:
            return false
    for byteIndex in 488..<chengHeldExecTerminalJournalRecordBytes:
        if record.data[byteIndex] != uint8(0):
            return false
    cheng_held_exec_wire_put_digest(record, 232, ChengFixedBytes32())
    let computedRecordReceipt =
        cheng_held_exec_terminal_journal_record_digest(record)
    if !cheng_held_exec_digest_nonzero(computedRecordReceipt) ||
       !cheng_fixed32_equal(recordReceipt, computedRecordReceipt) ||
       !cheng_sha256_cid_matches_digest(
           durableRecordReceiptCid,
           ptr(&computedRecordReceipt.data[0])):
        return false
    outRecordDigest = computedRecordReceipt
    return true

fn cheng_held_exec_terminal_transport_owner_matches_session(
        transportOwner: int32,
        session: int32): bool =
    let roleRow = transportOwner - 1
    if roleRow < 0 ||
       roleRow >= chengHeldExecCapsuleProviderRoleCount ||
       session <= 0:
        return false
    cheng_runtime_lock()
    let matches =
        roleRow < chengHeldExecCapsuleProviderRoleNextRow &&
        chengHeldExecCapsuleProviderRoleStates[roleRow] ==
            chengHeldExecCapsuleProviderRoleDecisionSent &&
        chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow] == session
    cheng_runtime_unlock()
    return matches

fn cheng_held_exec_terminal_bind_owner_reserve_locked(
        bindRow: int32,
        session: int32,
        permission0: int32,
        permission1: int32,
        permission2: int32,
        permission3: int32,
        outTransportOwner: var int32,
        outPhase: var int32,
        outSessionCidDigest: var ChengFixedBytes32,
        outPredecessorDigest: var ChengFixedBytes32,
        outEvidenceBDigest: var ChengFixedBytes32): bool =
    outTransportOwner = -1
    outPhase = -1
    outSessionCidDigest = ChengFixedBytes32()
    outPredecessorDigest = ChengFixedBytes32()
    outEvidenceBDigest = ChengFixedBytes32()
    if bindRow < 0 || bindRow >= chengHeldExecTerminalBindOwnerRowCount ||
       bindRow >= chengHeldExecTerminalBindOwnerNextRow || session <= 0 ||
       cheng_atomic_load_i32_export(ptr(
           &chengHeldExecTerminalBindOwnerStates[bindRow])) !=
           chengHeldExecTerminalBindOwnerIssued ||
       chengHeldExecTerminalBindOwnerSessions[bindRow] != session:
        return false
    let stored0 = chengHeldExecTerminalBindOwnerPermission0[bindRow]
    let stored1 = chengHeldExecTerminalBindOwnerPermission1[bindRow]
    let stored2 = chengHeldExecTerminalBindOwnerPermission2[bindRow]
    let stored3 = chengHeldExecTerminalBindOwnerPermission3[bindRow]
    let difference =
        (uint32(stored0) ^ uint32(permission0)) |
        (uint32(stored1) ^ uint32(permission1)) |
        (uint32(stored2) ^ uint32(permission2)) |
        (uint32(stored3) ^ uint32(permission3))
    if difference != uint32(0) ||
       (stored0 == 0 && stored1 == 0 && stored2 == 0 && stored3 == 0) ||
       !cheng_held_exec_digest_nonzero(
           chengHeldExecTerminalBindOwnerSessionCidDigests[bindRow]):
        return false
    outTransportOwner = chengHeldExecTerminalBindOwnerTransports[bindRow]
    outPhase = chengHeldExecTerminalBindOwnerPhases[bindRow]
    outSessionCidDigest =
        chengHeldExecTerminalBindOwnerSessionCidDigests[bindRow]
    outPredecessorDigest =
        chengHeldExecTerminalBindOwnerPredecessorDigests[bindRow]
    outEvidenceBDigest =
        chengHeldExecTerminalBindOwnerEvidenceBDigests[bindRow]
    cheng_atomic_store_i32_export(ptr(
        &chengHeldExecTerminalBindOwnerStates[bindRow]),
        chengHeldExecTerminalBindOwnerCommitting)
    return true

fn cheng_held_exec_terminal_bind_owner_restore_locked(bindRow: int32) =
    if bindRow < 0 || bindRow >= chengHeldExecTerminalBindOwnerRowCount:
        panic("held-exec terminal bind restore row invariant")
    if cheng_atomic_load_i32_export(ptr(
           &chengHeldExecTerminalBindOwnerStates[bindRow])) !=
           chengHeldExecTerminalBindOwnerCommitting:
        panic("held-exec terminal bind restore state invariant")
    cheng_atomic_store_i32_export(ptr(
        &chengHeldExecTerminalBindOwnerStates[bindRow]),
        chengHeldExecTerminalBindOwnerIssued)

fn cheng_held_exec_terminal_bind_owner_consume_locked(bindRow: int32) =
    if bindRow < 0 || bindRow >= chengHeldExecTerminalBindOwnerRowCount:
        panic("held-exec terminal bind consume row invariant")
    if cheng_atomic_load_i32_export(ptr(
           &chengHeldExecTerminalBindOwnerStates[bindRow])) !=
           chengHeldExecTerminalBindOwnerCommitting:
        panic("held-exec terminal bind consume state invariant")
    chengHeldExecTerminalBindOwnerPermission0[bindRow] = 0
    chengHeldExecTerminalBindOwnerPermission1[bindRow] = 0
    chengHeldExecTerminalBindOwnerPermission2[bindRow] = 0
    chengHeldExecTerminalBindOwnerPermission3[bindRow] = 0
    cheng_atomic_store_i32_export(ptr(
        &chengHeldExecTerminalBindOwnerStates[bindRow]),
        chengHeldExecTerminalBindOwnerConsumed)

# Mint the only Ack authority after the private terminal journal has completed
# stable no-replace append/readback. The finished-proof transport owner is the
# exact runtime-side journal authority; public CID text alone cannot mint this
# append-only int32 owner. Projection remains non-consuming until Ack moves it.
@exportc("cheng_held_exec_terminal_observation_commit_durable_append")
@abi_internal
@borrows
fn cheng_held_exec_terminal_observation_commit_durable_append_export(
        bindOwner: int32,
        session: int32,
        permission0: int32,
        permission1: int32,
        permission2: int32,
        permission3: int32,
        observationHandle: int32,
        projectedCanonicalCid: str,
        durableRecordCanonical: str,
        durableRecordReceiptCid: str): int32 =
    let bindRow = bindOwner - 1
    let observationRow = observationHandle - 1
    if bindOwner <= 0 || session <= 0 || observationHandle <= 0 ||
       bindRow < 0 || bindRow >= chengHeldExecTerminalBindOwnerRowCount ||
       observationRow >= chengHeldExecTerminalObservationRowCount ||
       chengHeldExecTerminalObservationDurableAppendOwners[observationRow] !=
           0:
        return -1
    var transportOwner: int32
    var phase: int32
    var expectedSessionCidDigest: ChengFixedBytes32
    var expectedPredecessorDigest: ChengFixedBytes32
    var expectedEvidenceBDigest: ChengFixedBytes32
    cheng_runtime_lock()
    let permissionReserved =
        cheng_held_exec_terminal_bind_owner_reserve_locked(
            bindRow,
            session,
            permission0,
            permission1,
            permission2,
            permission3,
            transportOwner,
            phase,
            expectedSessionCidDigest,
            expectedPredecessorDigest,
            expectedEvidenceBDigest)
    cheng_runtime_unlock()
    if !permissionReserved ||
       phase != chengHeldExecTerminalObservationPhases[observationRow] ||
       !cheng_held_exec_digest_nonzero(expectedPredecessorDigest) ||
       !cheng_held_exec_digest_nonzero(expectedEvidenceBDigest) ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecTerminalObservationStates[observationRow]),
           chengHeldExecTerminalObservationIssued,
           chengHeldExecTerminalObservationAttestingAppend) != 1:
        if permissionReserved:
            cheng_runtime_lock()
            cheng_held_exec_terminal_bind_owner_restore_locked(bindRow)
            cheng_runtime_unlock()
        return -1
    let roleRow = transportOwner - 1
    var sessionSlot: int32
    var projectedCanonical: ChengHeldExecWire
    var projectedCanonicalDigest: ChengFixedBytes32
    var durableRecordDigest: ChengFixedBytes32
    let expectedSessionState = phase == 1 ?
        chengHeldExecParentSessionExitObserved :
        (phase == 2 ? chengHeldExecParentSessionReaped : -1)
    let ownerOffset = phase == 1 ?
        chengHeldExecParentArenaExitObservationOwnerOffset :
        (phase == 2 ? chengHeldExecParentArenaReapObservationOwnerOffset : -1)
    var valid =
        cheng_held_exec_terminal_transport_owner_matches_session(
            transportOwner, session) &&
        cheng_held_exec_parent_session_resolve(session, sessionSlot) &&
        chengHeldExecTerminalObservationSessions[observationRow] == session &&
        expectedSessionState >= 0 && ownerOffset >= 0 &&
        cheng_held_exec_parent_session_state(sessionSlot) ==
            expectedSessionState &&
        cheng_held_exec_parent_session_i32_load(
            ownerOffset, sessionSlot) == observationHandle &&
        cheng_held_exec_terminal_observation_encode_row(
            observationRow, projectedCanonical)
    if valid:
        projectedCanonicalDigest =
            cheng_held_exec_terminal_observation_canonical_digest(
                "cheng.runtime.held_exec.terminal_observation.projected_canonical.v1",
                projectedCanonical)
        valid =
            cheng_held_exec_digest_nonzero(projectedCanonicalDigest) &&
            cheng_sha256_cid_matches_digest(
                projectedCanonicalCid,
                ptr(&projectedCanonicalDigest.data[0])) &&
            cheng_held_exec_terminal_observation_durable_record_exact_into(
                session,
                phase,
                projectedCanonical,
                expectedSessionCidDigest,
                expectedPredecessorDigest,
                expectedEvidenceBDigest,
                durableRecordCanonical,
                durableRecordReceiptCid,
                durableRecordDigest) &&
            cheng_held_exec_wire_get_u64(projectedCanonical, 216) ==
                uint64(session)
    var durableRecordEvidence: ChengFixedBytes32
    if valid:
        var record: ChengHeldExecWire
        cheng_held_exec_wire_zero(record)
        cheng_bytes_copy(
            ptr(&record),
            cheng_str_data(durableRecordCanonical),
            chengHeldExecTerminalJournalRecordBytes)
        let terminalExit = cheng_held_exec_parent_session_i32_load(
            chengHeldExecParentArenaTerminalExitOffset, sessionSlot)
        let expectedDecision = terminalExit == 0 ? uint32(1) : uint32(2)
        valid = terminalExit >= 0 && terminalExit <= 255 &&
            cheng_held_exec_wire_get_u32(record, 12) == expectedDecision &&
            cheng_held_exec_wire_get_u64(record, 208) ==
                cheng_held_exec_parent_session_u64_load(
                    chengHeldExecParentArenaOutputBytesOffset,
                    sessionSlot) &&
            cheng_held_exec_wire_get_u32(record, 216) ==
                uint32(terminalExit)
        durableRecordEvidence = cheng_held_exec_wire_get_digest(record, 144)
    if !valid:
        cheng_runtime_lock()
        cheng_held_exec_terminal_bind_owner_restore_locked(bindRow)
        cheng_runtime_unlock()
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalObservationStates[observationRow]),
            chengHeldExecTerminalObservationIssued)
        return -1
    let authorityRow = cheng_atomic_fetch_add_i32_export(
        ptr(&chengHeldExecTerminalDurableAppendOwnerNextRow), 1)
    if authorityRow < 0 ||
       authorityRow >= chengHeldExecTerminalDurableAppendOwnerRowCount:
        cheng_runtime_lock()
        cheng_held_exec_terminal_bind_owner_restore_locked(bindRow)
        cheng_runtime_unlock()
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalObservationStates[observationRow]),
            chengHeldExecTerminalObservationIssued)
        return -1
    let authorityOwner = authorityRow + 1
    chengHeldExecTerminalDurableAppendOwnerSessions[authorityRow] = session
    chengHeldExecTerminalDurableAppendOwnerPhases[authorityRow] = phase
    chengHeldExecTerminalDurableAppendOwnerObservations[authorityRow] =
        observationHandle
    chengHeldExecTerminalDurableAppendOwnerTransports[authorityRow] =
        transportOwner
    chengHeldExecTerminalDurableAppendOwnerProjectedDigests[authorityRow] =
        projectedCanonicalDigest
    chengHeldExecTerminalDurableAppendOwnerRecordDigests[authorityRow] =
        durableRecordDigest
    cheng_runtime_lock()
    if phase == 1:
        chengHeldExecCapsuleProviderRoleReapPredecessorDigests[roleRow] =
            durableRecordDigest
        chengHeldExecCapsuleProviderRoleReapEvidenceBDigests[roleRow] =
            durableRecordEvidence
    cheng_held_exec_terminal_bind_owner_consume_locked(bindRow)
    cheng_runtime_unlock()
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalDurableAppendOwnerStates[authorityRow]),
        chengHeldExecTerminalDurableAppendOwnerIssued)
    chengHeldExecTerminalObservationDurableAppendOwners[observationRow] =
        authorityOwner
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalObservationStates[observationRow]),
        chengHeldExecTerminalObservationIssued)
    return authorityOwner

# Projection is repeatable and does not consume the int32 observation owner.
# The transient PROJECTING state serializes projection against the unique
# durable-record acknowledgement; every published row is immutable.
@exportc("cheng_held_exec_terminal_observation_project_canonical")
@abi_internal
@borrows
fn cheng_held_exec_terminal_observation_project_canonical_export(
        session: int32,
        observationHandle: int32,
        outCanonicalBytes: var str): int32 =
    outCanonicalBytes = ""
    let row = observationHandle - 1
    if session <= 0 || observationHandle <= 0 ||
       row >= chengHeldExecTerminalObservationRowCount ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecTerminalObservationStates[row]),
           chengHeldExecTerminalObservationIssued,
           chengHeldExecTerminalObservationProjecting) != 1:
        return 0
    if chengHeldExecTerminalObservationSessions[row] != session:
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalObservationStates[row]),
            chengHeldExecTerminalObservationIssued)
        return 0
    var canonical: ChengHeldExecWire
    if !cheng_held_exec_terminal_observation_encode_row(row, canonical):
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalObservationStates[row]),
            chengHeldExecTerminalObservationIssued)
        return 0
    let raw = cheng_malloc_export(
        chengHeldExecTerminalObservationCanonicalBytes + 1)
    if raw == nil:
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalObservationStates[row]),
            chengHeldExecTerminalObservationIssued)
        return 0
    cheng_bytes_set(
        raw, 0, chengHeldExecTerminalObservationCanonicalBytes + 1)
    cheng_bytes_copy(
        raw,
        ptr(&canonical),
        chengHeldExecTerminalObservationCanonicalBytes)
    outCanonicalBytes = cheng_str_view_owned(
        raw, chengHeldExecTerminalObservationCanonicalBytes)
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalObservationStates[row]),
        chengHeldExecTerminalObservationIssued)
    return 1

# Ack accepts only the append-only int32 authority minted after the private
# journal's stable write/readback join. Public CID text cannot retire an
# observation. Both owners are serialized before the one-way observation CAS;
# after that CAS there is no fallible work.
fn cheng_held_exec_terminal_retire_owner_reserve(
        session: int32,
        transportOwner: int32): int32 =
    if session <= 0 || transportOwner <= 0:
        return -1
    cheng_runtime_lock()
    let row = chengHeldExecTerminalRetireOwnerNextRow
    if row < 0 || row >= chengHeldExecTerminalRetireOwnerRowCount ||
       chengHeldExecTerminalRetireOwnerStates[row] != 0:
        cheng_runtime_unlock()
        return -1
    chengHeldExecTerminalRetireOwnerNextRow = row + 1
    chengHeldExecTerminalRetireOwnerSessions[row] = session
    chengHeldExecTerminalRetireOwnerTransports[row] = transportOwner
    chengHeldExecTerminalRetireOwnerStates[row] =
        chengHeldExecTerminalRetireOwnerBuilding
    cheng_runtime_unlock()
    return row

@exportc("cheng_held_exec_terminal_observation_ack")
@abi_internal
fn cheng_held_exec_terminal_observation_ack_export(
        session: int32,
        observationHandle: int32,
        durableAppendOwner: int32,
        outRetireOwner: var int32): int32 =
    outRetireOwner = -1
    let observationRow = observationHandle - 1
    let authorityRow = durableAppendOwner - 1
    var sessionSlot: int32
    if session <= 0 || observationHandle <= 0 || durableAppendOwner <= 0 ||
       observationRow >= chengHeldExecTerminalObservationRowCount ||
       authorityRow >= chengHeldExecTerminalDurableAppendOwnerRowCount ||
       !cheng_held_exec_parent_session_resolve(session, sessionSlot) ||
       chengHeldExecTerminalObservationSessions[observationRow] != session ||
       chengHeldExecTerminalObservationDurableAppendOwners[observationRow] !=
           durableAppendOwner ||
       cheng_atomic_load_i32_export(
           ptr(&chengHeldExecTerminalDurableAppendOwnerStates[authorityRow])) !=
           chengHeldExecTerminalDurableAppendOwnerIssued ||
       chengHeldExecTerminalDurableAppendOwnerSessions[authorityRow] !=
           session ||
       chengHeldExecTerminalDurableAppendOwnerPhases[authorityRow] !=
           chengHeldExecTerminalObservationPhases[observationRow] ||
       chengHeldExecTerminalDurableAppendOwnerObservations[authorityRow] !=
           observationHandle ||
       !cheng_held_exec_terminal_transport_owner_matches_session(
           chengHeldExecTerminalDurableAppendOwnerTransports[authorityRow],
           session) ||
       !cheng_held_exec_digest_nonzero(
           chengHeldExecTerminalDurableAppendOwnerProjectedDigests[
               authorityRow]) ||
       !cheng_held_exec_digest_nonzero(
           chengHeldExecTerminalDurableAppendOwnerRecordDigests[
               authorityRow]):
        return 0
    let phase = chengHeldExecTerminalObservationPhases[observationRow]
    let expectedSessionState = phase == 1 ?
        chengHeldExecParentSessionExitObserved :
        (phase == 2 ? chengHeldExecParentSessionReaped : -1)
    let ownerOffset = phase == 1 ?
        chengHeldExecParentArenaExitObservationOwnerOffset :
        (phase == 2 ? chengHeldExecParentArenaReapObservationOwnerOffset : -1)
    if expectedSessionState < 0 || ownerOffset < 0 ||
       cheng_held_exec_parent_session_state(sessionSlot) !=
           expectedSessionState ||
       cheng_held_exec_parent_session_i32_load(
           ownerOffset, sessionSlot) != observationHandle:
        return 0
    var retireRow: int32 = -1
    if phase == 2:
        retireRow = cheng_held_exec_terminal_retire_owner_reserve(
            session,
            chengHeldExecTerminalDurableAppendOwnerTransports[authorityRow])
        if retireRow < 0:
            return 0
    if cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecTerminalDurableAppendOwnerStates[authorityRow]),
           chengHeldExecTerminalDurableAppendOwnerIssued,
           chengHeldExecTerminalDurableAppendOwnerConsuming) != 1:
        if retireRow >= 0:
            cheng_atomic_store_i32_export(
                ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
                chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    if cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecTerminalObservationStates[observationRow]),
           chengHeldExecTerminalObservationIssued,
           chengHeldExecTerminalObservationAcknowledging) != 1:
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalDurableAppendOwnerStates[authorityRow]),
            chengHeldExecTerminalDurableAppendOwnerIssued)
        if retireRow >= 0:
            cheng_atomic_store_i32_export(
                ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
                chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    let projectedCanonicalDigest =
        chengHeldExecTerminalDurableAppendOwnerProjectedDigests[authorityRow]
    let durableRecordDigest =
        chengHeldExecTerminalDurableAppendOwnerRecordDigests[authorityRow]
    chengHeldExecTerminalObservationProjectedCanonicalDigests[
        observationRow] = projectedCanonicalDigest
    chengHeldExecTerminalObservationDurableRecordDigests[observationRow] =
        durableRecordDigest
    cheng_held_exec_parent_session_i32_store(
        ownerOffset, sessionSlot, -1)
    chengHeldExecTerminalObservationDurableAppendOwners[observationRow] = 0
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalObservationStates[observationRow]),
        chengHeldExecTerminalObservationConsumed)
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalDurableAppendOwnerStates[authorityRow]),
        chengHeldExecTerminalDurableAppendOwnerConsumed)
    if retireRow >= 0:
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
            chengHeldExecTerminalRetireOwnerIssued)
        outRetireOwner = retireRow + 1
    return 1

fn cheng_held_exec_parent_terminal_close_fd_into(
        sessionSlot: int32,
        offset: int32): bool =
    let fd = cheng_held_exec_parent_session_i32_load(offset, sessionSlot)
    if fd < 0:
        return true
    let receipt = cheng_held_exec_terminal_fd_close_once(fd)
    cheng_held_exec_parent_session_i32_store(offset, sessionSlot, -1)
    return receipt == 1

# The Reaped acknowledgement is the sole mint edge for this int32 owner.
# Retire consumes the transport/session binding once and publishes the same
# row in CLOSE_READY only after every runtime descriptor has an exact close
# receipt.  No process-exit hook and no caller-selected PID participates.
@exportc("cheng_held_exec_terminal_retire_into")
@abi_internal
fn cheng_held_exec_terminal_retire_into_export(
        retireOwner: int32,
        outCloseReadyOwner: var int32): int32 =
    outCloseReadyOwner = -1
    let retireRow = retireOwner - 1
    if retireRow < 0 ||
       retireRow >= chengHeldExecTerminalRetireOwnerRowCount ||
       retireRow >= chengHeldExecTerminalRetireOwnerNextRow ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
           chengHeldExecTerminalRetireOwnerIssued,
           chengHeldExecTerminalRetireOwnerRetiring) != 1:
        return 0
    let session = chengHeldExecTerminalRetireOwnerSessions[retireRow]
    let transportOwner =
        chengHeldExecTerminalRetireOwnerTransports[retireRow]
    let roleRow = transportOwner - 1
    var sessionSlot: int32
    if session <= 0 || roleRow < 0 ||
       roleRow >= chengHeldExecCapsuleProviderRoleCount ||
       roleRow >= chengHeldExecCapsuleProviderRoleNextRow ||
       !cheng_held_exec_parent_session_resolve(session, sessionSlot) ||
       cheng_held_exec_parent_session_state(sessionSlot) !=
           chengHeldExecParentSessionReaped ||
       cheng_held_exec_parent_session_i32_load(
           chengHeldExecParentArenaExitObservationOwnerOffset,
           sessionSlot) != -1 ||
       cheng_held_exec_parent_session_i32_load(
           chengHeldExecParentArenaReapObservationOwnerOffset,
           sessionSlot) != -1:
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
            chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    cheng_runtime_lock()
    if chengHeldExecCapsuleProviderRoleStates[roleRow] !=
           chengHeldExecCapsuleProviderRoleDecisionSent ||
       chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow] != session:
        cheng_runtime_unlock()
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
            chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleRetiring
    let finishedWatchOwner =
        chengHeldExecCapsuleProviderRoleFinishedWatchOwners[roleRow]
    cheng_runtime_unlock()
    let bundleClosed =
        cheng_held_exec_capsule_provider_role_close_fd_once(
            roleRow, chengHeldExecCapsuleFdBundleReader)
    let roleFdsClosed =
        cheng_held_exec_capsule_provider_role_close_four(roleRow)
    let watchClosed = finishedWatchOwner <= 0 ||
        libc_terminal_decision_watch_close_runtime(finishedWatchOwner) == 1
    if !cheng_held_exec_parent_session_cas(
           sessionSlot,
           chengHeldExecParentSessionReaped,
           chengHeldExecParentSessionRetiring):
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
            chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    let channelClosed = cheng_held_exec_parent_terminal_close_fd_into(
        sessionSlot, chengHeldExecParentArenaChannelFdOffset)
    let pidfdClosed = cheng_held_exec_parent_terminal_close_fd_into(
        sessionSlot, chengHeldExecParentArenaPidfdOffset)
    let retainedClosed = cheng_held_exec_parent_terminal_close_fd_into(
        sessionSlot, chengHeldExecParentArenaRetainedFdOffset)
    if !bundleClosed || !roleFdsClosed || !watchClosed ||
       !channelClosed || !pidfdClosed || !retainedClosed:
        cheng_held_exec_parent_session_store(
            sessionSlot, chengHeldExecParentSessionRecoveryRequired)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[roleRow] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
            chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    cheng_runtime_lock()
    chengHeldExecCapsuleProviderRoleFinishedWatchOwners[roleRow] = -1
    chengHeldExecCapsuleProviderRoleCompileReceiptCanonicals[roleRow] =
        cheng_str_empty()
    chengHeldExecCapsuleProviderRoleBundleDigests[roleRow] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleBundleByteCounts[roleRow] = uint64(0)
    chengHeldExecCapsuleProviderRoleStates[roleRow] =
        chengHeldExecCapsuleProviderRoleRetired
    cheng_runtime_unlock()
    cheng_held_exec_parent_session_store(
        sessionSlot, chengHeldExecParentSessionRetired)
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalRetireOwnerStates[retireRow]),
        chengHeldExecTerminalRetireOwnerCloseReady)
    outCloseReadyOwner = retireOwner
    return 1

# The provider alone consumes CLOSE_READY after the durable root and CSG rows
# have been dismantled.  This final CAS makes copied/replayed int32 cargo fail.
@exportc("cheng_held_exec_terminal_close_ready_consume")
@abi_internal
fn cheng_held_exec_terminal_close_ready_consume_export(
        closeReadyOwner: int32): int32 =
    let row = closeReadyOwner - 1
    if row < 0 || row >= chengHeldExecTerminalRetireOwnerRowCount ||
       row >= chengHeldExecTerminalRetireOwnerNextRow ||
       cheng_atomic_cas_i32_export(
           ptr(&chengHeldExecTerminalRetireOwnerStates[row]),
           chengHeldExecTerminalRetireOwnerCloseReady,
           chengHeldExecTerminalRetireOwnerConsumingCloseReady) != 1:
        return 0
    let session = chengHeldExecTerminalRetireOwnerSessions[row]
    let transportOwner = chengHeldExecTerminalRetireOwnerTransports[row]
    let roleRow = transportOwner - 1
    var sessionSlot: int32
    var roleRetired = false
    if roleRow >= 0 && roleRow < chengHeldExecCapsuleProviderRoleCount:
        cheng_runtime_lock()
        roleRetired =
            roleRow < chengHeldExecCapsuleProviderRoleNextRow &&
            chengHeldExecCapsuleProviderRoleStates[roleRow] ==
                chengHeldExecCapsuleProviderRoleRetired &&
            chengHeldExecCapsuleProviderRoleRuntimeSessions[roleRow] ==
                session
        cheng_runtime_unlock()
    if !cheng_held_exec_parent_session_resolve(session, sessionSlot) ||
       cheng_held_exec_parent_session_state(sessionSlot) !=
           chengHeldExecParentSessionRetired ||
       !roleRetired:
        cheng_atomic_store_i32_export(
            ptr(&chengHeldExecTerminalRetireOwnerStates[row]),
            chengHeldExecTerminalRetireOwnerRecoveryRequired)
        return 0
    chengHeldExecTerminalRetireOwnerSessions[row] = -1
    chengHeldExecTerminalRetireOwnerTransports[row] = -1
    cheng_held_exec_parent_session_store(
        sessionSlot, chengHeldExecParentSessionClosed)
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalRetireOwnerStates[row]),
        chengHeldExecTerminalRetireOwnerConsumed)
    return 1

@exportc("cheng_held_exec_terminal_observation_import_canonical")
@abi_internal
@borrows
fn cheng_held_exec_terminal_observation_import_canonical_export(
        canonicalBytes: str): int32 =
    if cheng_str_len(canonicalBytes) !=
           chengHeldExecTerminalObservationCanonicalBytes ||
       cheng_str_data(canonicalBytes) == nil:
        return -1
    var canonical: ChengHeldExecWire
    cheng_held_exec_wire_zero(canonical)
    cheng_bytes_copy(
        ptr(&canonical),
        cheng_str_data(canonicalBytes),
        chengHeldExecTerminalObservationCanonicalBytes)
    let phase = int32(cheng_held_exec_wire_get_u64(canonical, 16))
    let childPid = int32(cheng_held_exec_wire_get_u64(canonical, 24))
    let signalNumber = int32(
        cheng_held_exec_wire_get_u64(canonical, 48))
    let siCode = int32(cheng_held_exec_wire_get_u64(canonical, 56))
    let rawStatus = int32(cheng_held_exec_wire_get_u64(canonical, 64))
    let exitCode = int32(cheng_held_exec_wire_get_u64(canonical, 72))
    let rawWaitStatus = int32(
        cheng_held_exec_wire_get_u64(canonical, 80))
    let canonicalSession = int32(
        cheng_held_exec_wire_get_u64(canonical, 216))
    let claimDigest = cheng_held_exec_wire_get_digest(canonical, 88)
    let ownerClaimDigest = cheng_held_exec_wire_get_digest(canonical, 120)
    let terminalDigest = cheng_held_exec_wire_get_digest(canonical, 152)
    let embeddedReceipt = cheng_held_exec_wire_get_digest(canonical, 184)
    cheng_held_exec_wire_put_digest(
        canonical, 184, ChengFixedBytes32())
    let computedReceipt =
        cheng_held_exec_terminal_observation_canonical_digest(
            "cheng.runtime.held_exec.terminal_observation.canonical.v1",
            canonical)
    if cheng_held_exec_wire_get_u64(canonical, 0) !=
           chengHeldExecTerminalObservationMagic ||
       cheng_held_exec_wire_get_u64(canonical, 8) !=
           chengHeldExecTerminalObservationVersion ||
       canonicalSession <= 0 ||
       (phase != 1 && phase != 2) || childPid <= 0 ||
       signalNumber <= 0 || siCode < 1 || siCode > 3 ||
       rawStatus < 0 || exitCode != 0 ||
       (phase == 1 && rawWaitStatus != -1) ||
       !cheng_held_exec_digest_nonzero(claimDigest) ||
       !cheng_held_exec_digest_nonzero(ownerClaimDigest) ||
       !cheng_held_exec_digest_nonzero(terminalDigest) ||
       !cheng_fixed32_equal(embeddedReceipt, computedReceipt):
        return -1
    let row = cheng_held_exec_terminal_observation_allocate_row()
    if row < 0:
        return -1
    chengHeldExecTerminalObservationSessions[row] = canonicalSession
    chengHeldExecTerminalObservationPhases[row] = phase
    chengHeldExecTerminalObservationChildPids[row] = childPid
    chengHeldExecTerminalObservationChildUids[row] = uint32(
        cheng_held_exec_wire_get_u64(canonical, 32))
    chengHeldExecTerminalObservationChildGids[row] = uint32(
        cheng_held_exec_wire_get_u64(canonical, 40))
    chengHeldExecTerminalObservationSignals[row] = signalNumber
    chengHeldExecTerminalObservationSiCodes[row] = siCode
    chengHeldExecTerminalObservationRawStatuses[row] = rawStatus
    chengHeldExecTerminalObservationExitCodes[row] = exitCode
    chengHeldExecTerminalObservationRawWaitStatuses[row] = rawWaitStatus
    chengHeldExecTerminalObservationClaimDigests[row] = claimDigest
    chengHeldExecTerminalObservationOwnerClaimDigests[row] =
        ownerClaimDigest
    chengHeldExecTerminalObservationTerminalDigests[row] = terminalDigest
    var reencoded: ChengHeldExecWire
    if !cheng_held_exec_terminal_observation_encode_row(row, reencoded) ||
       !cheng_held_exec_terminal_observation_wire_exact_equal(
           reencoded, canonicalBytes):
        return -1
    # Recovered canonical bytes are evidence only. They cannot recreate the
    # live pidfd/kqueue observation authority of the original process.
    chengHeldExecTerminalObservationSessions[row] = -1
    let issued = chengHeldExecTerminalObservationIssued
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecTerminalObservationStates[row]),
        issued)
    return row + 1

fn cheng_held_exec_parent_session_allocate(
        outSlot: var int32,
        outHandle: var int32): bool =
    outSlot = -1
    outHandle = -1
    for slot in 0..<chengHeldExecParentSessionCount:
        let prior = cheng_held_exec_parent_session_state(slot)
        if (prior == chengHeldExecParentSessionEmpty ||
            prior == chengHeldExecParentSessionClosed) &&
           cheng_held_exec_parent_session_cas(
               slot, prior, chengHeldExecParentSessionBuilding):
            let generation = cheng_held_exec_parent_session_i32_load(
                chengHeldExecParentArenaGenerationOffset, slot) + 1
            if generation <= 0 || generation > 536870911:
                cheng_held_exec_parent_session_store(
                    slot, chengHeldExecParentSessionClosed)
                return false
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaGenerationOffset, slot, generation)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaChannelFdOffset, slot, -1)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaPidfdOffset, slot, -1)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaChildPidOffset, slot, -1)
            cheng_held_exec_parent_session_u32_store(
                chengHeldExecParentArenaChildUidOffset, slot, uint32(0))
            cheng_held_exec_parent_session_u32_store(
                chengHeldExecParentArenaChildGidOffset, slot, uint32(0))
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaRetainedFdOffset, slot, -1)
            chengHeldExecParentChildBirthPlatforms[slot] = 0
            chengHeldExecParentChildBirth0[slot] = uint64(0)
            chengHeldExecParentChildBirth1[slot] = uint64(0)
            chengHeldExecParentChildBirthReceipts[slot] =
                ChengFixedBytes32()
            for digestField in 0..<chengHeldExecParentDigestFieldCount:
                cheng_held_exec_parent_session_digest_store(
                    digestField, slot, ChengFixedBytes32())
            cheng_held_exec_parent_session_u64_store(
                chengHeldExecParentArenaOutputBytesOffset,
                slot,
                uint64(0))
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaTerminalExitOffset, slot, -1)
            cheng_held_exec_parent_session_u32_store(
                chengHeldExecParentArenaObservedUidOffset,
                slot,
                uint32(0))
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaObservedSignalOffset, slot, 0)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaObservedSiCodeOffset, slot, 0)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaObservedRawStatusOffset, slot, 0)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaObservedExitOffset, slot, -1)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaDecisionOffset, slot, 0)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaObservedRawWaitStatusOffset,
                slot,
                -1)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaExitObservationOwnerOffset,
                slot,
                -1)
            cheng_held_exec_parent_session_i32_store(
                chengHeldExecParentArenaReapObservationOwnerOffset,
                slot,
                -1)
            outSlot = slot
            outHandle = (generation - 1) *
                chengHeldExecParentSessionCount + slot + 1
            return true
    return false

fn cheng_held_exec_parent_session_resolve(
        handle: int32,
        outSlot: var int32): bool =
    outSlot = -1
    if handle <= 0:
        return false
    let raw = handle - 1
    let slot = raw % chengHeldExecParentSessionCount
    let generation = raw / chengHeldExecParentSessionCount + 1
    if slot < 0 || slot >= chengHeldExecParentSessionCount ||
       generation <= 0 ||
       cheng_held_exec_parent_session_i32_load(
           chengHeldExecParentArenaGenerationOffset, slot) != generation:
        return false
    outSlot = slot
    return true

fn cheng_held_exec_parent_session_close_resources(slot: int32) =
    if slot < 0 || slot >= chengHeldExecParentSessionCount:
        return
    let channelFd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChannelFdOffset, slot)
    if channelFd >= 0:
        let _closeChannel = libc_close(channelFd)
        cheng_held_exec_parent_session_i32_store(
            chengHeldExecParentArenaChannelFdOffset, slot, -1)
    let pidfd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaPidfdOffset, slot)
    if pidfd >= 0:
        let _closePidfd = libc_close(pidfd)
        cheng_held_exec_parent_session_i32_store(
            chengHeldExecParentArenaPidfdOffset, slot, -1)
    let retainedFd = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaRetainedFdOffset, slot)
    if retainedFd >= 0:
        let _closeRetained = libc_close(retainedFd)
        cheng_held_exec_parent_session_i32_store(
            chengHeldExecParentArenaRetainedFdOffset, slot, -1)

fn cheng_held_exec_parent_claim_result(
        slot: int32,
        handle: int32): ChengHeldExecParentClaimResult =
    if slot < 0 || slot >= chengHeldExecParentSessionCount ||
       handle <= 0:
        return ChengHeldExecParentClaimResult(
            errorCode: chengHeldExecParentErrSessionUnavailable,
            session: -1,
            childPid: -1)
    let childPid = cheng_held_exec_parent_session_i32_load(
        chengHeldExecParentArenaChildPidOffset, slot)
    let childUid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaChildUidOffset, slot)
    let childGid = cheng_held_exec_parent_session_u32_load(
        chengHeldExecParentArenaChildGidOffset, slot)
    let phase = cheng_held_exec_parent_session_state(slot)
    let childBirthPlatform =
        chengHeldExecParentChildBirthPlatforms[slot]
    let childBirth0 = chengHeldExecParentChildBirth0[slot]
    let childBirth1 = chengHeldExecParentChildBirth1[slot]
    var projection: ChengHeldExecWire
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(
        projection,
        0,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestClaim, slot))
    let claimReceipt0 = cheng_held_exec_wire_get_u64(projection, 0)
    let claimReceipt1 = cheng_held_exec_wire_get_u64(projection, 8)
    let claimReceipt2 = cheng_held_exec_wire_get_u64(projection, 16)
    let claimReceipt3 = cheng_held_exec_wire_get_u64(projection, 24)
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(
        projection,
        0,
        chengHeldExecParentChildBirthReceipts[slot])
    let childBirthReceipt0 = cheng_held_exec_wire_get_u64(projection, 0)
    let childBirthReceipt1 = cheng_held_exec_wire_get_u64(projection, 8)
    let childBirthReceipt2 = cheng_held_exec_wire_get_u64(projection, 16)
    let childBirthReceipt3 = cheng_held_exec_wire_get_u64(projection, 24)
    cheng_held_exec_wire_zero(projection)
    cheng_held_exec_wire_put_digest(
        projection,
        0,
        cheng_held_exec_parent_session_digest_load(
            chengHeldExecParentDigestTerminal, slot))
    let terminalReceipt0 = cheng_held_exec_wire_get_u64(projection, 0)
    let terminalReceipt1 = cheng_held_exec_wire_get_u64(projection, 8)
    let terminalReceipt2 = cheng_held_exec_wire_get_u64(projection, 16)
    let terminalReceipt3 = cheng_held_exec_wire_get_u64(projection, 24)
    return ChengHeldExecParentClaimResult(
        status: 1,
        session: handle,
        childPid: childPid,
        childUid: childUid,
        childGid: childGid,
        phase: phase,
        childBirthPlatform: childBirthPlatform,
        childBirth0: childBirth0,
        childBirth1: childBirth1,
        childBirthReceipt0: childBirthReceipt0,
        childBirthReceipt1: childBirthReceipt1,
        childBirthReceipt2: childBirthReceipt2,
        childBirthReceipt3: childBirthReceipt3,
        claimReceipt0: claimReceipt0,
        claimReceipt1: claimReceipt1,
        claimReceipt2: claimReceipt2,
        claimReceipt3: claimReceipt3,
        terminalReceipt0: terminalReceipt0,
        terminalReceipt1: terminalReceipt1,
        terminalReceipt2: terminalReceipt2,
        terminalReceipt3: terminalReceipt3)

fn cheng_held_exec_parent_claim_error(
        errorCode: int32): ChengHeldExecParentClaimResult =
    return ChengHeldExecParentClaimResult(
        errorCode: errorCode,
        session: -1,
        childPid: -1)

fn cheng_held_exec_parent_phase_result(
        status: int32,
        errorCode: int32,
        session: int32): ChengHeldExecParentPhaseResult =
    return ChengHeldExecParentPhaseResult(
        status: status,
        errorCode: errorCode,
        session: session)

fn cheng_held_exec_parent_result_error(
        errorCode: int32): ChengHeldExecParentRunResult =
    return ChengHeldExecParentRunResult(
        errorCode: errorCode,
        exitCode: -1)

@exportc("cheng_held_exec_parent_begin_claim")
@abi_internal
@borrows
fn cheng_held_exec_parent_begin_claim_export(
        retainedBinaryFd: int32,
        outputPath: str): ChengHeldExecParentClaimResult =
    let platformKind = cheng_read_only_mapped_region_platform_kind()
    if platformKind == chengReadOnlyMappedRegionPlatformLinuxX64 ||
       platformKind == chengReadOnlyMappedRegionPlatformLinuxA64:
        return cheng_held_exec_parent_begin_claim_linux_export(
            retainedBinaryFd, outputPath)
    if platformKind == chengReadOnlyMappedRegionPlatformDarwinA64:
        return cheng_held_exec_parent_begin_claim_darwin_export(
            retainedBinaryFd, outputPath)
    return cheng_held_exec_parent_claim_error(
        chengHeldExecParentErrLinuxX64Required)

# Darwin production arm skeleton (probes/darwin_authority/DESIGN.md).
# The Linux-only entry declaration is gone: darwin no longer receives
# "linux required". Each Linux primitive has a measured darwin equivalent
# (probes p1..p5) and each unwired equivalent hard-fails with its own
# code in begin_claim dependency order:
#   1. retained identity (fs-verity measure leg): darwin equivalent is
#      the installed-vnode issuance bar (SF_IMMUTABLE + codesign fence,
#      held_exec_identity) or the verdict-54 freeze-point envelope —
#      wiring is M3, hard-fails 33.
#   2. launcher identity (/proc/self/exe leg): same issuance bar on the
#      fixed launcher path — M3, hard-fails 34.
#   3. channel: AF_UNIX SOCK_SEQPACKET measured not-buildable (errno 43);
#      equivalent is SOCK_STREAM + fixed-frame framing + getpeereid —
#      M1, hard-fails 31.
#   4. spawn: execveat(AT_EMPTY_PATH) has no public darwin channel
#      (fexecve absent, /dev/fd execve EBADF, unlinked path ENOENT);
#      equivalent is fixed-path posix_spawn START_SUSPENDED dynamic
#      guest + audit-token join — M2, hard-fails 32.
# The platform-independent input contract (output path absoluteness) is
# wired and checked before the first hard block. No fallback, no green.
@borrows
fn cheng_held_exec_parent_begin_claim_darwin_export(
        retainedBinaryFd: int32,
        outputPath: str): ChengHeldExecParentClaimResult =
    if retainedBinaryFd < 0:
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrDarwinRetainedIdentityUnwired)
    if cheng_os_is_absolute_bridge_export(outputPath) != 1:
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrOutputPathNotAbsolute)
    return cheng_held_exec_parent_claim_error(
        chengHeldExecParentErrDarwinRetainedIdentityUnwired)

# Linux production arm: the original begin_claim body, moved verbatim
# (same split discipline as the wall3 seal dispatcher). One primitive set
# serves both Linux machine kinds: fs-verity measure, /proc/<pid>/exe
# image identity, execveat(AT_EMPTY_PATH), pidfd and the
# SOCK_SEQPACKET+SO_PASSCRED channel. The original first-gate error
# (LinuxX64Required for a negative retained fd) is preserved verbatim.
@borrows
fn cheng_held_exec_parent_begin_claim_linux_export(
        retainedBinaryFd: int32,
        outputPath: str): ChengHeldExecParentClaimResult =
    if retainedBinaryFd < 0:
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrLinuxX64Required)
    var executableDigest: ChengFixedBytes32
    var launcherDigest: ChengFixedBytes32
    var outputPathDigest: ChengFixedBytes32
    if !cheng_held_exec_retained_verity_digest_into(
           retainedBinaryFd, executableDigest):
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrRetainedVerityInvalid)
    if !cheng_held_exec_launcher_identity_digest_into(launcherDigest):
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrLauncherIdentityInvalid)
    if cheng_os_is_absolute_bridge_export(outputPath) != 1:
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrOutputPathNotAbsolute)
    if !cheng_held_exec_output_path_digest_into(
           outputPath, outputPathDigest):
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrOutputPathDigestInvalid)
    let nativePathRaw = cheng_str_data(chengHeldExecNativePath)
    let argvDigest = cheng_held_exec_argv_digest(nativePathRaw)
    let environmentDigest = cheng_held_exec_empty_environment_digest()
    if !cheng_held_exec_digest_nonzero(argvDigest):
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrArgvDigestInvalid)
    if !cheng_held_exec_digest_nonzero(environmentDigest):
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrEnvironmentDigestInvalid)
    var slot: int32
    var handle: int32
    if !cheng_held_exec_parent_session_allocate(slot, handle):
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrSessionUnavailable)
    let ownedRetainedFd = libc_dup_cloexec_runtime(retainedBinaryFd)
    if ownedRetainedFd < 0 || ownedRetainedFd == chengHeldExecChannelFd:
        if ownedRetainedFd >= 0:
            let _closeAlias = libc_close(ownedRetainedFd)
        cheng_held_exec_parent_session_store(
            slot, chengHeldExecParentSessionClosed)
        return cheng_held_exec_parent_claim_error(
            chengHeldExecParentErrRetainedFdAlias)
    cheng_held_exec_parent_session_i32_store(
        chengHeldExecParentArenaRetainedFdOffset, slot, ownedRetainedFd)
    var sockets: int32[2]
    sockets[0] = -1
    sockets[1] = -1
    if libc_socketpair_passcred_runtime(
           chengHeldExecAfUnix,
           chengHeldExecSockSeqpacket,
           0,
           ptr(&sockets)) != 0 ||
       sockets[0] < 0 || sockets[1] < 0 ||
