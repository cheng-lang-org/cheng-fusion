fn cheng_str_copy_cstring(text: ptr): str =
    if text == nil:
        return cheng_str_empty()
    let textLen = cheng_cstrlen_raw(text)
    let out = cheng_str_copy(text, textLen)
    return out

@borrows
fn cheng_str_dup(text: str): str =
    let textData = cheng_str_data(text)
    let textLen = cheng_str_len(text)
    let out = cheng_str_copy(textData, textLen)
    return out

fn cheng_str_dispose(s: var str) =
    s = cheng_str_empty()
@exportc("cheng_tcp_bridge_str_dispose_bridge")
@abi_internal
fn cheng_tcp_bridge_str_dispose_bridge_export(value: var str) =
    cheng_str_dispose(value)

@borrows
fn cheng_copy_cstring_from_str_locked(text: str): ptr =
    let textData = cheng_str_data(text)
    let textLen = cheng_str_len(text)
    if textLen < 0:
        cheng_runtime_lock_abort(
            "cheng_copy_cstring_from_str: negative length")
        return nil
    if textLen > 0 && textData == nil:
        cheng_runtime_lock_abort(
            "cheng_copy_cstring_from_str: nil source")
        return nil
    if textLen >= 2147483647:
        cheng_runtime_lock_abort(
            "cheng_copy_cstring_from_str: length overflow")
        return nil
    let out = cheng_malloc_locked(textLen + 1)
    if out == nil:
        return nil
    cheng_bytes_set(out, 0, textLen + 1)
    if textData != nil && textLen > 0:
        cheng_bytes_copy(out, textData, textLen)
    return out


@borrows
fn cheng_copy_cstring_from_str(text: str): ptr =
    cheng_runtime_lock()
    let out = cheng_copy_cstring_from_str_locked(text)
    cheng_runtime_unlock()
    return out

@borrows
fn cheng_str_contains_nul(text: str): bool =
    # pure-path: `*(UInt8Ptr(cheng_ptr_plus(data, i)))` in a counted loop
    # miscompiles (load omitted → stack garbage → false-positive NUL → open fails).
    # Walk with bare `*(UInt8Ptr(p))` + ptr_plus step; that form lowers correctly.
    var p = cheng_str_data(text)
    var n = cheng_str_len(text)
    if p == nil || n <= 0:
        return false
    while n > 0:
        if *(UInt8Ptr(p)) == uint8(0):
            return true
        p = cheng_ptr_plus(p, 1)
        n = n - 1
    return false

fn cheng_file_handle_mode_valid(mode: int32): bool =
    if mode == chengFileOpenRead:
        return true
    if mode == chengFileOpenWriteTruncate:
        return true
    if mode == chengFileOpenReadWrite:
        return true
    if mode == chengFileOpenAppend:
        return true
    return false

fn cheng_file_handle_mode_can_read(mode: int32): bool =
    if mode == chengFileOpenRead:
        return true
    if mode == chengFileOpenReadWrite:
        return true
    return false

fn cheng_file_handle_mode_can_write(mode: int32): bool =
    if mode == chengFileOpenWriteTruncate:
        return true
    if mode == chengFileOpenReadWrite:
        return true
    if mode == chengFileOpenAppend:
        return true
    return false

fn cheng_file_handle_mode_alloc2(a: int32, b: int32): ptr =
    let raw = cheng_malloc_export(3)
    if raw == nil:
        return nil
    cheng_rawbytes_set_at_export(raw, 0, a)
    cheng_rawbytes_set_at_export(raw, 1, b)
    cheng_rawbytes_set_at_export(raw, 2, 0)
    return raw

fn cheng_file_handle_mode_alloc3(a: int32, b: int32, c: int32): ptr =
    let raw = cheng_malloc_export(4)
    if raw == nil:
        return nil
    cheng_rawbytes_set_at_export(raw, 0, a)
    cheng_rawbytes_set_at_export(raw, 1, b)
    cheng_rawbytes_set_at_export(raw, 2, c)
    cheng_rawbytes_set_at_export(raw, 3, 0)
    return raw

fn cheng_file_handle_mode_cstring(mode: int32): ptr =
    if mode == chengFileOpenRead:
        return cheng_file_handle_mode_alloc2(114, 98)
    if mode == chengFileOpenWriteTruncate:
        return cheng_file_handle_mode_alloc2(119, 98)
    if mode == chengFileOpenReadWrite:
        return cheng_file_handle_mode_alloc3(114, 98, 43)
    if mode == chengFileOpenAppend:
        return cheng_file_handle_mode_alloc2(97, 98)
    return nil

fn cheng_file_handle_err(outErr: var str, message: str): int32 =
    outErr = message
    return 0

fn cheng_file_handle_cell_magic(cell: ptr): int32 =
    return *(Int32Ptr(cheng_ptr_plus(cell, chengFileHandleMagicOffset)))

fn cheng_file_handle_cell_set_magic(cell: ptr, value: int32) =
    *(Int32Ptr(cheng_ptr_plus(cell, chengFileHandleMagicOffset))) = value

fn cheng_file_handle_cell_mode(cell: ptr): int32 =
    return *(Int32Ptr(cheng_ptr_plus(cell, chengFileHandleModeOffset)))

fn cheng_file_handle_cell_set_mode(cell: ptr, value: int32) =
    *(Int32Ptr(cheng_ptr_plus(cell, chengFileHandleModeOffset))) = value

fn cheng_file_handle_cell_stream(cell: ptr): ptr =
    return *(VoidPtrPtr(cheng_ptr_plus(cell, chengFileHandleStreamOffset)))

fn cheng_file_handle_cell_set_stream(cell: ptr, value: ptr) =
    *(VoidPtrPtr(cheng_ptr_plus(cell, chengFileHandleStreamOffset))) = value

fn cheng_file_handle_cell_generation(cell: ptr): uint32 =
    return *(UInt32Ptr(cheng_ptr_plus(cell, chengFileHandleGenerationOffset)))

fn cheng_file_handle_cell_set_generation(cell: ptr, value: uint32) =
    *(UInt32Ptr(cheng_ptr_plus(cell, chengFileHandleGenerationOffset))) = value

fn cheng_file_handle_cell_kind(cell: ptr): int32 =
    return *(Int32Ptr(cheng_ptr_plus(cell, chengFileHandleKindOffset)))

fn cheng_file_handle_cell_set_kind(cell: ptr, value: int32) =
    *(Int32Ptr(cheng_ptr_plus(cell, chengFileHandleKindOffset))) = value

fn cheng_file_handle_cell_fd_packed(cell: ptr): uint64 =
    return *(UInt64Ptr(cheng_ptr_plus(cell, chengFileHandleStreamOffset)))

fn cheng_file_handle_cell_set_fd_packed(cell: ptr, value: uint64) =
    *(UInt64Ptr(cheng_ptr_plus(cell, chengFileHandleStreamOffset))) = value

fn cheng_file_handle_at_fdcwd(): int32 =
    if cheng_host_is_darwin():
        return -2
    return -100

fn cheng_file_handle_openat_flags(mode: int32): int32 =
    if cheng_host_is_darwin():
        if mode == chengFileOpenWriteTruncate:
            return 1 | 512 | 1024 | 16777216
        if mode == chengFileOpenReadWrite:
            return 2 | 16777216
        if mode == chengFileOpenAppend:
            return 1 | 512 | 8 | 16777216
        return 0 | 16777216
    if mode == chengFileOpenWriteTruncate:
        return 1 | 64 | 512 | 524288
    if mode == chengFileOpenReadWrite:
        return 2 | 524288
    if mode == chengFileOpenAppend:
        return 1 | 64 | 1024 | 524288
    return 0 | 524288

fn cheng_file_handle_register_stream_locked(stream: ptr, mode: int32, outErr: var str): uint64 =
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_allocation_ledger_abort(
            "allocation_ledger_libc_file_provider_unsupported")
        return uint64(0)
    if stream == nil:
        let _ = cheng_file_handle_err(outErr, "os file handle: nil stream")
        return uint64(0)
    let mem = c_malloc(int64(chengFileHandleCellSize))
    if mem == nil:
        let _ = cheng_file_handle_err(outErr, "os file handle: alloc failed")
        return uint64(0)
    cheng_file_handle_cell_set_magic(mem, chengFileHandleMagic)
    cheng_file_handle_cell_set_mode(mem, mode)
    cheng_file_handle_cell_set_stream(mem, stream)
    cheng_file_handle_cell_set_generation(mem, uint32(1))
    cheng_file_handle_cell_set_kind(mem, chengFileHandleKindStream)
    if cheng_file_handle_cell_magic(mem) != chengFileHandleMagic ||
       cheng_file_handle_cell_mode(mem) != mode ||
       cheng_file_handle_cell_stream(mem) != stream ||
       cheng_file_handle_cell_kind(mem) != chengFileHandleKindStream:
        let _ = cheng_file_handle_err(outErr, "os file handle: init failed")
        return uint64(0)
    return uint64(mem)

fn cheng_file_handle_register_fd_locked(fd: int32, mode: int32, outErr: var str): uint64 =
    if fd < 0:
        let _ = cheng_file_handle_err(outErr, "os file handle: invalid fd")
        return uint64(0)
    let mem = cheng_malloc_locked(chengFileHandleCellSize)
    if mem == nil:
        let _ = cheng_file_handle_err(outErr, "os file handle: alloc failed")
        return uint64(0)
    let packed = uint64(fd) + uint64(1)
    cheng_file_handle_cell_set_magic(mem, chengFileHandleMagic)
    cheng_file_handle_cell_set_mode(mem, mode)
    cheng_file_handle_cell_set_fd_packed(mem, packed)
    cheng_file_handle_cell_set_generation(mem, uint32(1))
    cheng_file_handle_cell_set_kind(mem, chengFileHandleKindFd)
    if cheng_file_handle_cell_magic(mem) != chengFileHandleMagic ||
       cheng_file_handle_cell_mode(mem) != mode ||
       cheng_file_handle_cell_kind(mem) != chengFileHandleKindFd ||
       cheng_file_handle_cell_fd_packed(mem) != packed:
        cheng_free_locked(mem)
        let _ = cheng_file_handle_err(outErr, "os file handle: init failed")
        return uint64(0)
    return uint64(mem)

fn cheng_file_handle_cell_locked(handle: uint64, outErr: var str): ptr =
    if handle == uint64(0):
        let _ = cheng_file_handle_err(outErr, "os file handle: invalid handle")
        return nil
    if handle < uint64(65536):
        let _ = cheng_file_handle_err(outErr, "os file handle: invalid handle")
        return nil
    let cell: ptr = ptr(handle)
    if cell == nil || cheng_file_handle_cell_magic(cell) != chengFileHandleMagic:
        let _ = cheng_file_handle_err(outErr, "os file handle: stale")
        return nil
    if cheng_file_handle_cell_stream(cell) == nil:
        let _ = cheng_file_handle_err(outErr, "os file handle: closed")
        return nil
    return cell

fn cheng_file_handle_stream_locked(handle: uint64, requireRead: bool, requireWrite: bool, outErr: var str): ptr =
    let cell: ptr = cheng_file_handle_cell_locked(handle, outErr)
    if cell == nil:
        return nil
    if cheng_file_handle_cell_kind(cell) == chengFileHandleKindFd:
        let _ = cheng_file_handle_err(outErr, "os file handle: fd provider")
        return nil
    let mode: int32 = cheng_file_handle_cell_mode(cell)
    if requireRead && !cheng_file_handle_mode_can_read(mode):
        let _ = cheng_file_handle_err(outErr, "os file read: handle not readable")
        return nil
    if requireWrite && !cheng_file_handle_mode_can_write(mode):
        let _ = cheng_file_handle_err(outErr, "os file write: handle not writable")
        return nil
    return cheng_file_handle_cell_stream(cell)

fn cheng_file_handle_fd_locked(handle: uint64, requireRead: bool, requireWrite: bool, outErr: var str): int32 =
    let cell: ptr = cheng_file_handle_cell_locked(handle, outErr)
    if cell == nil:
        return -1
    if cheng_file_handle_cell_kind(cell) != chengFileHandleKindFd:
        let _ = cheng_file_handle_err(outErr, "os file handle: stream provider")
        return -1
    let mode: int32 = cheng_file_handle_cell_mode(cell)
    if requireRead && !cheng_file_handle_mode_can_read(mode):
        let _ = cheng_file_handle_err(outErr, "os file read: handle not readable")
        return -1
    if requireWrite && !cheng_file_handle_mode_can_write(mode):
        let _ = cheng_file_handle_err(outErr, "os file write: handle not writable")
        return -1
    let packed = cheng_file_handle_cell_fd_packed(cell)
    if packed == uint64(0):
        let _ = cheng_file_handle_err(outErr, "os file handle: closed")
        return -1
    return int32(packed - uint64(1))

fn cheng_file_handle_take_stream_locked(handle: uint64, outErr: var str): ptr =
    let cell: ptr = cheng_file_handle_cell_locked(handle, outErr)
    if cell == nil:
        return nil
    let stream = cheng_file_handle_cell_stream(cell)
    var nextGeneration: uint32 = cheng_file_handle_cell_generation(cell) + uint32(1)
    if nextGeneration == uint32(0):
        nextGeneration = uint32(1)
    cheng_file_handle_cell_set_stream(cell, nil)
    cheng_file_handle_cell_set_generation(cell, nextGeneration)
    cheng_file_handle_cell_set_mode(cell, 0)
    return stream

fn cheng_runtime_error_wire_init(wire: ChengRuntimeErrorWirePtr) =
    if wire == nil:
        cheng_runtime_lock_abort("runtime error wire: nil initialization")
        return
    cheng_bytes_set(ptr(wire), 0, int32(sizeof(ChengRuntimeErrorWire)))

@borrows
fn cheng_atomic_tree_set_error(outErr: ptr, message: ptr): int32 =
    if outErr == nil:
        return 0
    let messageLen = cheng_cstrlen_raw(message)
    if message == nil || messageLen <= 0 || messageLen > 512:
        cheng_runtime_lock_abort(
            "runtime error wire: invalid static error literal")
        return 0
    let errorWire = ChengRuntimeErrorWirePtr(outErr)
    if errorWire->present != 0 && errorWire->present != 1:
        cheng_runtime_lock_abort(
            "runtime error wire: corrupt presence state")
        return 0
    cheng_bytes_copy(&errorWire->data[0], message, messageLen)
    errorWire->length = messageLen
    errorWire->present = 1
    return 0

fn cheng_read_only_mapped_region_set_error_if_empty(
        outErr: ptr,
        message: ptr): int32 =
    if outErr != nil:
        let errorWire = ChengRuntimeErrorWirePtr(outErr)
        if errorWire->present == 0:
            let _ = cheng_atomic_tree_set_error(outErr, message)
    return 0

fn cheng_runtime_error_wire_project(
        wire: ChengRuntimeErrorWirePtr,
        outErr: ptr) =
    if wire == nil || outErr == nil || wire->present == 0:
        return
    if wire->present != 1 || wire->length <= 0 || wire->length > 512:
        cheng_runtime_lock_abort("runtime error wire: invalid projection")
        return
    var message = cheng_str_copy(&wire->data[0], wire->length)
    cheng_str_store_slot(outErr, message)
    cheng_str_dispose(message)

fn cheng_atomic_tree_clear_error(outErr: ptr) =
    if outErr != nil:
        var empty: str
        cheng_str_store_slot(outErr, empty)

# O_NOFOLLOW / O_DIRECTORY differ per Linux arch: x86_64 = 0x20000 / 0x10000,
# aarch64 = 0x8000 / 0x4000 (O_DIRECT would collide on aarch64 and EINVAL
# directories).  Darwin has its own constants.  O_CLOEXEC = 0x80000 on all.
fn cheng_atomic_tree_no_follow_flag(): int32 =
    if cheng_host_is_darwin():
        return 256
    if cheng_read_only_mapped_region_platform_kind() ==
           chengReadOnlyMappedRegionPlatformLinuxA64:
        return 32768
    return 131072

fn cheng_atomic_tree_directory_flag(): int32 =
    if cheng_host_is_darwin():
        return 1048576
    if cheng_read_only_mapped_region_platform_kind() ==
           chengReadOnlyMappedRegionPlatformLinuxA64:
        return 16384
    return 65536

fn cheng_atomic_tree_dir_open_flags(): int32 =
    if cheng_host_is_darwin():
        return 0 | 256 | 1048576 | 16777216
    return 0 | cheng_atomic_tree_no_follow_flag() |
           cheng_atomic_tree_directory_flag() | 524288

fn cheng_atomic_tree_read_open_flags(): int32 =
    if cheng_host_is_darwin():
        return 0 | 256 | 16777216
    return 0 | cheng_atomic_tree_no_follow_flag() | 524288

fn cheng_atomic_tree_write_open_flags(): int32 =
    if cheng_host_is_darwin():
        return 1 | 512 | 2048 | 256 | 16777216
    return 1 | 64 | 128 |
           cheng_atomic_tree_no_follow_flag() | 524288

# Existing durable capsule inodes are opened through two distinct open file
# descriptions. The writer never receives O_RDWR, O_CREAT or O_TRUNC; the
# verified root transaction created and fsynced the inode before this bridge
# became reachable.
fn cheng_atomic_tree_existing_write_only_open_flags(): int32 =
    if cheng_host_is_darwin():
        return 1 | 256 | 16777216
    return 1 | cheng_atomic_tree_no_follow_flag() | 524288

fn cheng_atomic_tree_terminal_recovery_lock_open_flags(
        create: bool): int32 =
    if cheng_host_is_darwin():
        return 2 | (create ? 512 : 0) | 256 | 16777216
    return 2 | (create ? 64 : 0) |
        cheng_atomic_tree_no_follow_flag() | 524288

fn cheng_atomic_tree_removedir_flag(): int32 =
    if cheng_host_is_darwin():
        return 128
    return 512

fn cheng_atomic_tree_segment_valid(data: ptr, n: int32): bool =
    if data == nil || n <= 0:
        return false
    if n == 1 && *(UInt8Ptr(data)) == uint8(46):
        return false
    if n == 2 && *(UInt8Ptr(data)) == uint8(46) &&
       *(UInt8Ptr(cheng_ptr_plus(data, 1))) == uint8(46):
        return false
    for i in 0..<n:
        let ch = *(UInt8Ptr(cheng_ptr_plus(data, i)))
        if ch < uint8(32) || ch == uint8(127) ||
           ch == uint8(47) || ch == uint8(92):
            return false
    return true

@borrows
fn cheng_atomic_tree_single_name_valid(name: str): bool =
    return cheng_atomic_tree_segment_valid(cheng_str_data(name),
                                           cheng_str_len(name))

@borrows
fn cheng_atomic_tree_relative_path_valid(path: str): bool =
    let data = cheng_str_data(path)
    let n = cheng_str_len(path)
    if data == nil || n <= 0 ||
       *(UInt8Ptr(data)) == uint8(47) ||
       *(UInt8Ptr(cheng_ptr_plus(data, n - 1))) == uint8(47):
        return false
    var start: int32
    for i in 0..<n:
        let ch = *(UInt8Ptr(cheng_ptr_plus(data, i)))
        if ch == uint8(92) || ch == uint8(0):
            return false
        if ch != uint8(47):
            continue
        if !cheng_atomic_tree_segment_valid(cheng_ptr_plus(data, start),
                                             i - start):
            return false
        start = i + 1
    return cheng_atomic_tree_segment_valid(cheng_ptr_plus(data, start),
                                           n - start)

@borrows
fn cheng_atomic_tree_absolute_parent_valid(path: str): bool =
    let data = cheng_str_data(path)
    let n = cheng_str_len(path)
    if data == nil || n <= 0 || *(UInt8Ptr(data)) != uint8(47):
        return false
    if n == 1:
        return true
    if *(UInt8Ptr(cheng_ptr_plus(data, n - 1))) == uint8(47):
        return false
    var start: int32 = 1
    for i in 1..<n:
        let ch = *(UInt8Ptr(cheng_ptr_plus(data, i)))
        if ch == uint8(92) || ch == uint8(0):
            return false
        if ch != uint8(47):
            continue
        if !cheng_atomic_tree_segment_valid(cheng_ptr_plus(data, start),
                                             i - start):
            return false
        start = i + 1
    return cheng_atomic_tree_segment_valid(cheng_ptr_plus(data, start),
                                           n - start)

@borrows
fn cheng_atomic_tree_open_parent_absolute(path: str,
                                           outErr: ptr): int32 =
    if !cheng_atomic_tree_absolute_parent_valid(path):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: parent path must be canonical absolute no-symlink path")
        return -1
    let flags = cheng_atomic_tree_dir_open_flags()
    var currentFd = libc_open_runtime("/", flags)
    if currentFd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: open root failed")
        return -1
    let data = cheng_str_data(path)
    let n = cheng_str_len(path)
    if n == 1:
        return currentFd
    var start: int32 = 1
    var pos: int32 = 1
    while pos <= n:
        if pos < n && *(UInt8Ptr(cheng_ptr_plus(data, pos))) != uint8(47):
            pos = pos + 1
            continue
        let segment = cheng_string_copy_locked(
            cheng_ptr_plus(data, start), pos - start)
        if segment == nil:
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_parent_path_fd_close_failed"):
                return -1
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: path segment alloc failed")
            return -1
        let nextFd = libc_openat_runtime(currentFd, segment, flags, 0)
        cheng_free_locked(segment)
        if nextFd < 0:
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_parent_path_fd_close_failed"):
                return -1
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: parent component open failed")
            return -1
        if !cheng_atomic_tree_close_fd_or_abort(
               currentFd,
               "atomic_tree_parent_path_fd_close_failed"):
            return -1
        currentFd = nextFd
        start = pos + 1
        pos = pos + 1
    return currentFd

fn cheng_atomic_tree_cell_from_handle_locked(handle: uint64,
                                              outErr: ptr): ChengAtomicTreeCellPtr =
    let raw = cheng_ffi_handle_resolve_ptr_locked(handle)
    if raw == nil:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: stale handle")
        return nil
    let cell = ChengAtomicTreeCellPtr(raw)
    if cell == nil || cell->magic != chengAtomicTreeMagic:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: corrupt handle")
        return nil
    return cell

fn cheng_atomic_tree_invalidate_handle_locked(handle: uint64): bool =
    return cheng_ffi_handle_invalidate_locked(handle)

fn cheng_atomic_tree_mode_is_transaction(mode: int32): bool =
    return mode == chengAtomicTreeModeTransaction ||
           mode == chengAtomicTreeModeExclusiveTransaction

fn cheng_atomic_tree_mode_is_verified_read(mode: int32): bool =
    return mode == chengAtomicTreeModeVerifiedRead ||
           mode == chengAtomicTreeModeExclusiveOpened

fn cheng_atomic_tree_mode_has_exclusive_lease(mode: int32): bool =
    return mode >= chengAtomicTreeModeExclusiveAbsent &&
           mode <= chengAtomicTreeModeExclusiveOpened

fn cheng_atomic_tree_created_nodes_free(cell: ChengAtomicTreeCellPtr) =
    var node = ChengAtomicTreeCreatedNodePtr(cell->createdHead)
    while node != nil:
        let next = ChengAtomicTreeCreatedNodePtr(node->next)
        if node->relativePath != nil:
            cheng_free_locked(node->relativePath)
        cheng_free_locked(ptr(node))
        node = next
    cell->createdHead = nil

fn cheng_atomic_tree_verified_read_nodes_free(cell: ChengAtomicTreeCellPtr) =
    var node = ChengAtomicTreeVerifiedReadNodePtr(cell->verifiedReadHead)
    while node != nil:
        let next = ChengAtomicTreeVerifiedReadNodePtr(node->next)
        if node->relativePath != nil:
            cheng_free_locked(node->relativePath)
        cheng_free_locked(ptr(node))
        node = next
    cell->verifiedReadHead = nil

fn cheng_atomic_tree_close_fd_or_abort(
        fd: int32,
        failure: ptr): bool =
    if fd < 0:
        return true
    if libc_close(fd) != 0:
        cheng_allocation_ledger_abort(failure)
        return false
    return true

fn cheng_atomic_tree_cell_close_fds_or_abort(
        cell: ChengAtomicTreeCellPtr): bool =
    if cell == nil:
        cheng_allocation_ledger_abort(
            "atomic_tree_close_nil_cell")
        return false
    if cell->rootFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->rootFd,
               "atomic_tree_root_fd_close_failed"):
            return false
        cell->rootFd = -1
    if cell->parentFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->parentFd,
               "atomic_tree_parent_fd_close_failed"):
            return false
        cell->parentFd = -1
        cell->exclusiveLeaseHeld = 0
        cell->verifiedRootLeaseHeld = 0
    if cell->verifiedRootFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->verifiedRootFd,
               "atomic_tree_verified_root_fd_close_failed"):
            return false
        cell->verifiedRootFd = -1
    return true

fn cheng_atomic_tree_cell_free(cell: ChengAtomicTreeCellPtr) =
    if cell == nil:
        return
    if cell->rootFd >= 0 || cell->parentFd >= 0 ||
       cell->verifiedRootFd >= 0 ||
       cell->exclusiveLeaseHeld != 0 ||
       cell->verifiedRootLeaseHeld != 0:
        cheng_allocation_ledger_abort(
            "atomic_tree_cell_free_with_live_fd")
        return
    cheng_atomic_tree_created_nodes_free(cell)
    cheng_atomic_tree_verified_read_nodes_free(cell)
    if cell->stagingName != nil:
        cheng_free_locked(cell->stagingName)
        cell->stagingName = nil
    if cell->finalName != nil:
        cheng_free_locked(cell->finalName)
        cell->finalName = nil
    if cell->canonicalParentPath != nil:
        cheng_free_locked(cell->canonicalParentPath)
        cell->canonicalParentPath = nil
    if cell->verifiedCategoryName != nil:
        cheng_free_locked(cell->verifiedCategoryName)
        cell->verifiedCategoryName = nil
    cell->magic = 0
    cheng_free_locked(ptr(cell))

@borrows
fn cheng_atomic_tree_cell_new(parentFd: int32,
                               rootFd: int32,
                               mode: int32,
                               stagingName: str,
                               finalName: str,
                               outErr: ptr): ChengAtomicTreeCellPtr =
    let raw = cheng_malloc_locked(int32(sizeof(ChengAtomicTreeCell)))
    if raw == nil:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: handle alloc failed")
        return nil
    cheng_bytes_set(raw, 0, int32(sizeof(ChengAtomicTreeCell)))
    let cell = ChengAtomicTreeCellPtr(raw)
    cell->magic = chengAtomicTreeMagic
    cell->mode = mode
    cell->parentFd = parentFd
    cell->rootFd = rootFd
    cell->verifiedRootFd = -1
    if cheng_str_len(stagingName) > 0:
        cell->stagingName =
            cheng_copy_cstring_from_str_locked(stagingName)
        if cell->stagingName == nil:
            cell->magic = 0
            cheng_free_locked(ptr(cell))
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: staging name alloc failed")
            return nil
    if cheng_str_len(finalName) > 0:
        cell->finalName =
            cheng_copy_cstring_from_str_locked(finalName)
        if cell->finalName == nil:
            if cell->stagingName != nil:
                cheng_free_locked(cell->stagingName)
            cell->magic = 0
            cheng_free_locked(ptr(cell))
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: final name alloc failed")
            return nil
    return cell

@borrows
fn cheng_atomic_tree_attach_verified_category_locked(
        cell: ChengAtomicTreeCellPtr,
        verifiedRootFd: int32,
        categoryName: str,
        categoryDev: uint64,
        categoryIno: uint64,
        outErr: ptr): bool =
    if cell == nil || verifiedRootFd < 0 ||
       cell->verifiedRootFd >= 0 ||
       cell->verifiedCategoryName != nil ||
       !cheng_atomic_tree_single_name_valid(categoryName):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: invalid verified category provenance")
        return false
    let retainedRootFd = libc_dup_cloexec_runtime(verifiedRootFd)
    if retainedRootFd < 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified root retain failed")
        return false
    let retainedCategoryName =
        cheng_copy_cstring_from_str_locked(categoryName)
    if retainedCategoryName == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               retainedRootFd,
               "atomic_tree_verified_root_retain_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified category retain failed")
        return false
    cell->verifiedRootFd = retainedRootFd
    cell->verifiedCategoryName = retainedCategoryName
    cell->verifiedCategoryDev = categoryDev
    cell->verifiedCategoryIno = categoryIno
    return true

@borrows
fn cheng_atomic_tree_exclusive_cell_new(parentFd: int32,
                                         rootFd: int32,
                                         mode: int32,
                                         parentPath: str,
                                         stagingName: str,
                                         finalName: str,
                                         parentDev: uint64,
                                         parentIno: uint64,
                                         rootDev: uint64,
                                         rootIno: uint64,
                                         outErr: ptr): ChengAtomicTreeCellPtr =
    let cell = cheng_atomic_tree_cell_new(parentFd,
                                           rootFd,
                                           mode,
                                           stagingName,
                                           finalName,
                                           outErr)
    if cell == nil:
        return nil
    cell->canonicalParentPath =
        cheng_copy_cstring_from_str_locked(parentPath)
    if cell->canonicalParentPath == nil:
        cell->parentFd = -1
        cell->rootFd = -1
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: canonical parent path alloc failed")
        return nil
    cell->exclusiveLeaseHeld = 1
    cell->parentDev = parentDev
    cell->parentIno = parentIno
    cell->rootDev = rootDev
    cell->rootIno = rootIno
    return cell

@borrows
@exportc("cheng_atomic_tree_begin_bridge")
@abi_internal
fn cheng_atomic_tree_begin_bridge_export(parentPath: str,
                                          stagingName: str,
                                          finalName: str,
                                          outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if !cheng_atomic_tree_single_name_valid(stagingName) ||
       !cheng_atomic_tree_single_name_valid(finalName) ||
       stagingName == finalName:
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: invalid staging/final name")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let parentFd = cheng_atomic_tree_open_parent_absolute(
        parentPath, errorOut)
    if parentFd < 0:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let stagingRaw = cheng_copy_cstring_from_str_locked(stagingName)
    if stagingRaw == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_begin_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: staging name alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if libc_mkdirat_runtime(parentFd, stagingRaw, 448) != 0:
        cheng_free_locked(stagingRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_begin_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: exclusive staging mkdir failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(parentFd,
                                      stagingRaw,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    if rootFd < 0:
        if libc_unlinkat_runtime(
               parentFd,
               stagingRaw,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_begin_staging_rollback_failed")
            return uint64(0)
        cheng_free_locked(stagingRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_begin_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: staging open failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let cell = cheng_atomic_tree_cell_new(parentFd,
                                           rootFd,
                                           chengAtomicTreeModeTransaction,
                                           stagingName,
                                           finalName,
                                           errorOut)
    if cell == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_begin_root_fd_close_failed"):
            return uint64(0)
        if libc_unlinkat_runtime(
               parentFd,
               stagingRaw,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_begin_staging_rollback_failed")
            return uint64(0)
        cheng_free_locked(stagingRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_begin_parent_fd_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_free_locked(stagingRaw)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->rootFd,
               "atomic_tree_begin_handle_root_fd_close_failed"):
            return uint64(0)
        cell->rootFd = -1
        if libc_unlinkat_runtime(
               parentFd,
               cell->stagingName,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_begin_handle_staging_rollback_failed")
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->parentFd,
               "atomic_tree_begin_handle_parent_fd_close_failed"):
            return uint64(0)
        cell->parentFd = -1
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: handle register failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

@borrows
@exportc("cheng_atomic_tree_begin_child_from_verified_root_bridge")
@abi_internal
fn cheng_atomic_tree_begin_child_from_verified_root_bridge_export(
        verifiedRootHandle: uint64,
        parentRelativePath: str,
        stagingName: str,
        finalName: str,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if !cheng_atomic_tree_single_name_valid(parentRelativePath) ||
       !cheng_atomic_tree_single_name_valid(stagingName) ||
       !cheng_atomic_tree_single_name_valid(finalName) ||
       stagingName == finalName:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid verified-root child begin request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let source = cheng_atomic_tree_cell_from_handle_locked(
        verifiedRootHandle, errorOut)
    if source == nil ||
       source->mode != chengAtomicTreeModeExclusiveOpened ||
       source->exclusiveLeaseHeld != 1 || source->rootFd < 0 ||
       !cheng_atomic_tree_verify_root_binding_locked(
           source, true, errorOut):
        if source != nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: child begin requires live verified root lease")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let parentRaw = cheng_copy_cstring_from_str_locked(
        parentRelativePath)
    if parentRaw == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child parent alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let parentFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    if parentFd < 0 ||
       libc_flock_runtime(
           parentFd, chengAtomicTreeFlockExclusiveNonblocking) != 0:
        if parentFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_parent_fd_close_failed"):
            return uint64(0)
        cheng_free_locked(parentRaw)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child parent lease unavailable")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var parentSize: int64
    var parentMode: int32
    var parentDev: uint64
    var parentIno: uint64
    let joinedFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    cheng_free_locked(parentRaw)
    var joinedSize: int64
    var joinedMode: int32
    var joinedDev: uint64
    var joinedIno: uint64
    let parentJoined =
        joinedFd >= 0 &&
        cheng_atomic_tree_fstat(
            parentFd,
            &parentSize,
            &parentMode,
            &parentDev,
            &parentIno) &&
        cheng_atomic_tree_fstat(
            joinedFd,
            &joinedSize,
            &joinedMode,
            &joinedDev,
            &joinedIno) &&
        (parentMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        (joinedMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        parentDev == joinedDev && parentIno == joinedIno
    if joinedFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           joinedFd,
           "atomic_tree_verified_child_join_fd_close_failed"):
        return uint64(0)
    if !parentJoined:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child parent identity drift")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let stagingRaw = cheng_copy_cstring_from_str_locked(stagingName)
    if stagingRaw == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child staging alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if libc_mkdirat_runtime(parentFd, stagingRaw, 448) != 0:
        cheng_free_locked(stagingRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child staging mkdir failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(
        parentFd,
        stagingRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    if rootFd < 0:
        if libc_unlinkat_runtime(
               parentFd,
               stagingRaw,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_verified_child_staging_rollback_failed")
            return uint64(0)
        cheng_free_locked(stagingRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child staging open failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var rootSize: int64
    var rootMode: int32
    var rootDev: uint64
    var rootIno: uint64
    if !cheng_atomic_tree_fstat(
           rootFd, &rootSize, &rootMode, &rootDev, &rootIno) ||
       (rootMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
        cheng_allocation_ledger_abort(
            "atomic_tree_verified_child_staging_identity_uncertain")
        return uint64(0)
    let cell = cheng_atomic_tree_cell_new(
        parentFd,
        rootFd,
        chengAtomicTreeModeTransaction,
        stagingName,
        finalName,
        errorOut)
    if cell == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_verified_child_root_fd_close_failed"):
            return uint64(0)
        if libc_unlinkat_runtime(
               parentFd,
               stagingRaw,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_verified_child_staging_rollback_failed")
            return uint64(0)
        cheng_free_locked(stagingRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_parent_fd_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_free_locked(stagingRaw)
    if !cheng_atomic_tree_attach_verified_category_locked(
           cell,
           source->rootFd,
           parentRelativePath,
           parentDev,
           parentIno,
           errorOut):
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->rootFd,
               "atomic_tree_verified_child_attach_root_close_failed"):
            return uint64(0)
        cell->rootFd = -1
        if libc_unlinkat_runtime(
               cell->parentFd,
               cell->stagingName,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_verified_child_attach_rollback_failed")
            return uint64(0)
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cell->verifiedRootLeaseHeld = 1
    cell->parentDev = parentDev
    cell->parentIno = parentIno
    cell->rootDev = rootDev
    cell->rootIno = rootIno
    if !cheng_atomic_tree_verify_root_binding_locked(
           cell, false, errorOut):
        cheng_allocation_ledger_abort(
            "atomic_tree_verified_child_root_binding_uncertain")
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->rootFd,
               "atomic_tree_verified_child_handle_root_fd_close_failed"):
            return uint64(0)
        cell->rootFd = -1
        if libc_unlinkat_runtime(
               cell->parentFd,
               cell->stagingName,
               cheng_atomic_tree_removedir_flag()) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_verified_child_handle_staging_rollback_failed")
            return uint64(0)
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child handle register failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

@borrows
@exportc("cheng_atomic_tree_open_child_from_verified_root_bridge")
@abi_internal
fn cheng_atomic_tree_open_child_from_verified_root_bridge_export(
        verifiedRootHandle: uint64,
        parentRelativePath: str,
        finalName: str,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if !cheng_atomic_tree_single_name_valid(parentRelativePath) ||
       !cheng_atomic_tree_single_name_valid(finalName):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid verified-root child open request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let source = cheng_atomic_tree_cell_from_handle_locked(
        verifiedRootHandle, errorOut)
    if source == nil ||
       source->mode != chengAtomicTreeModeExclusiveOpened ||
       source->exclusiveLeaseHeld != 1 || source->rootFd < 0 ||
       !cheng_atomic_tree_verify_root_binding_locked(
           source, true, errorOut):
        if source != nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: child open requires live verified root lease")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let parentRaw = cheng_copy_cstring_from_str_locked(
        parentRelativePath)
    if parentRaw == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child parent alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let parentFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    if parentFd < 0:
        cheng_free_locked(parentRaw)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child parent open failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var parentSize: int64
    var parentMode: int32
    var parentDev: uint64
    var parentIno: uint64
    let joinedFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    cheng_free_locked(parentRaw)
    var joinedSize: int64
    var joinedMode: int32
    var joinedDev: uint64
    var joinedIno: uint64
    let parentJoined =
        joinedFd >= 0 &&
        cheng_atomic_tree_fstat(
            parentFd,
            &parentSize,
            &parentMode,
            &parentDev,
            &parentIno) &&
        cheng_atomic_tree_fstat(
            joinedFd,
            &joinedSize,
            &joinedMode,
            &joinedDev,
            &joinedIno) &&
        (parentMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        (joinedMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        parentDev == joinedDev && parentIno == joinedIno
    if joinedFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           joinedFd,
           "atomic_tree_verified_child_open_join_fd_close_failed"):
        return uint64(0)
    if !parentJoined:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_open_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child open parent identity drift")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let finalRaw = cheng_copy_cstring_from_str_locked(finalName)
    if finalRaw == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_open_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child final alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(
        parentFd,
        finalRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    cheng_free_locked(finalRaw)
    if rootFd < 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_open_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child destination open failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var noStagingName: str
    let cell = cheng_atomic_tree_cell_new(
        parentFd,
        rootFd,
        chengAtomicTreeModeVerifiedRead,
        noStagingName,
        finalName,
        errorOut)
    if cell == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_verified_child_open_root_fd_close_failed"):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_open_parent_fd_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if !cheng_atomic_tree_attach_verified_category_locked(
           cell,
           source->rootFd,
           parentRelativePath,
           parentDev,
           parentIno,
           errorOut):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if !cheng_atomic_tree_verify_root_binding_locked(cell, true, errorOut):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child open handle failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

@borrows
@exportc("cheng_atomic_tree_verified_root_child_exists_bridge")
@abi_internal
fn cheng_atomic_tree_verified_root_child_exists_bridge_export(
        verifiedRootHandle: uint64,
        parentRelativePath: str,
        finalName: str,
        outExists: ptr,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    if outExists != nil:
        *(Int32Ptr(outExists)) = 0
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outExists == nil ||
       !cheng_atomic_tree_single_name_valid(parentRelativePath) ||
       !cheng_atomic_tree_single_name_valid(finalName):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid verified-root child exists request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_lock()
    let source = cheng_atomic_tree_cell_from_handle_locked(
        verifiedRootHandle, errorOut)
    if source == nil ||
       source->mode != chengAtomicTreeModeExclusiveOpened ||
       source->exclusiveLeaseHeld != 1 || source->rootFd < 0 ||
       !cheng_atomic_tree_verify_root_binding_locked(
           source, true, errorOut):
        if source != nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: child exists requires live verified root lease")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let parentRaw = cheng_copy_cstring_from_str_locked(
        parentRelativePath)
    if parentRaw == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists parent alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let parentFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    if parentFd < 0:
        cheng_free_locked(parentRaw)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists parent open failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    var parentSize: int64
    var parentMode: int32
    var parentDev: uint64
    var parentIno: uint64
    let joinedFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    var joinedSize: int64
    var joinedMode: int32
    var joinedDev: uint64
    var joinedIno: uint64
    let parentJoined =
        joinedFd >= 0 &&
        cheng_atomic_tree_fstat(
            parentFd,
            &parentSize,
            &parentMode,
            &parentDev,
            &parentIno) &&
        cheng_atomic_tree_fstat(
            joinedFd,
            &joinedSize,
            &joinedMode,
            &joinedDev,
            &joinedIno) &&
        (parentMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        (joinedMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        parentDev == joinedDev && parentIno == joinedIno
    if joinedFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           joinedFd,
           "atomic_tree_verified_child_exists_join_fd_close_failed"):
        return 0
    if !parentJoined:
        cheng_free_locked(parentRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_exists_parent_fd_close_failed"):
            return 0
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists parent identity drift")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let finalRaw = cheng_copy_cstring_from_str_locked(finalName)
    if finalRaw == nil:
        cheng_free_locked(parentRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_exists_parent_fd_close_failed"):
            return 0
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists final alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let childFd = libc_openat_runtime(
        parentFd,
        finalRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    let childOpenErr =
        childFd < 0 ? native_cheng_errno_code_runtime() : 0
    cheng_free_locked(finalRaw)
    var childSize: int64
    var childMode: int32
    var childDev: uint64
    var childIno: uint64
    let childIsDirectory =
        childFd >= 0 &&
        cheng_atomic_tree_fstat(
            childFd,
            &childSize,
            &childMode,
            &childDev,
            &childIno) &&
        (childMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir
    if childFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           childFd,
           "atomic_tree_verified_child_exists_child_fd_close_failed"):
        return 0
    if childFd < 0 && childOpenErr != 2:
        cheng_free_locked(parentRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_exists_parent_fd_close_failed"):
            return 0
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists query failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    if childFd >= 0 && !childIsDirectory:
        cheng_free_locked(parentRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_child_exists_parent_fd_close_failed"):
            return 0
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists destination invalid")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let finalJoinedFd = libc_openat_runtime(
        source->rootFd,
        parentRaw,
        cheng_atomic_tree_dir_open_flags(),
        0)
    cheng_free_locked(parentRaw)
    var finalJoinedSize: int64
    var finalJoinedMode: int32
    var finalJoinedDev: uint64
    var finalJoinedIno: uint64
    let finalParentJoined =
        finalJoinedFd >= 0 &&
        cheng_atomic_tree_fstat(
            finalJoinedFd,
            &finalJoinedSize,
            &finalJoinedMode,
            &finalJoinedDev,
            &finalJoinedIno) &&
        (finalJoinedMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        parentDev == finalJoinedDev && parentIno == finalJoinedIno
    if finalJoinedFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           finalJoinedFd,
           "atomic_tree_verified_child_exists_final_join_fd_close_failed"):
        return 0
    let sourceStable =
        finalParentJoined &&
        cheng_atomic_tree_verify_root_binding_locked(
            source, true, errorOut)
    if !cheng_atomic_tree_close_fd_or_abort(
           parentFd,
           "atomic_tree_verified_child_exists_parent_fd_close_failed"):
        return 0
    if !sourceStable:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified-root child exists source drift")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    *(Int32Ptr(outExists)) = childFd >= 0 ? 1 : 0
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return 1

@borrows
@exportc("cheng_atomic_tree_open_verified_bridge")
@abi_internal
fn cheng_atomic_tree_open_verified_bridge_export(parentPath: str,
                                                  finalName: str,
                                                  outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if !cheng_atomic_tree_single_name_valid(finalName):
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: invalid final name")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let parentFd = cheng_atomic_tree_open_parent_absolute(
        parentPath, errorOut)
    if parentFd < 0:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let finalRaw = cheng_copy_cstring_from_str_locked(finalName)
    if finalRaw == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: final name alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(parentFd,
                                      finalRaw,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    cheng_free_locked(finalRaw)
    if rootFd < 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: verified root open failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    # Reopening an immutable destination also establishes its parent namespace
    # durability boundary.  Callers use this to disambiguate a post-rename
    # commit result without deleting or replacing authority state.
    if libc_fsync_runtime(parentFd) != 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_verified_root_fd_close_failed"):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: verified parent fsync failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var noStagingName: str
    let cell = cheng_atomic_tree_cell_new(parentFd,
                                           rootFd,
                                           chengAtomicTreeModeVerifiedRead,
                                           noStagingName,
                                           finalName,
                                           errorOut)
    if cell == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_verified_root_fd_close_failed"):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_verified_parent_fd_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: verified handle register failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

fn cheng_atomic_tree_fstat(fd: int32,
                           outSize: Int64Ptr,
                           outMode: Int32Ptr,
                           outDev: UInt64Ptr,
                           outIno: UInt64Ptr): bool =
    return libc_fstat_scalars_runtime(fd,
                                      outSize,
                                      outMode,
                                      outDev,
                                      outIno) == 0

fn cheng_atomic_tree_verify_exclusive_parent_locked(
        cell: ChengAtomicTreeCellPtr,
        outErr: ptr): bool =
    if cell == nil || cell->exclusiveLeaseHeld != 1 ||
       cell->parentFd < 0 || cell->canonicalParentPath == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: exclusive parent authority unavailable")
        return false
    var canonicalParentPath = cheng_str_view(
        cell->canonicalParentPath,
        cheng_cstrlen_raw(cell->canonicalParentPath))
    let reopenedFd = cheng_atomic_tree_open_parent_absolute(
        canonicalParentPath,
        outErr)
    if reopenedFd < 0:
        return false
    var heldSize: int64
    var heldMode: int32
    var heldDev: uint64
    var heldIno: uint64
    var reopenedSize: int64
    var reopenedMode: int32
    var reopenedDev: uint64
    var reopenedIno: uint64
    let valid = cheng_atomic_tree_fstat(cell->parentFd,
                                         &heldSize,
                                         &heldMode,
                                         &heldDev,
                                         &heldIno) &&
                cheng_atomic_tree_fstat(reopenedFd,
                                         &reopenedSize,
                                         &reopenedMode,
                                         &reopenedDev,
                                         &reopenedIno) &&
                (heldMode & chengAtomicTreeTypeMask) == chengAtomicTreeTypeDir &&
                (reopenedMode & chengAtomicTreeTypeMask) == chengAtomicTreeTypeDir &&
                heldDev == cell->parentDev && heldIno == cell->parentIno &&
                reopenedDev == cell->parentDev && reopenedIno == cell->parentIno
    if !cheng_atomic_tree_close_fd_or_abort(
           reopenedFd,
           "atomic_tree_exclusive_parent_reopen_fd_close_failed"):
        return false
    if !valid:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: exclusive parent identity drift")
        return false
    return true

fn cheng_atomic_tree_verify_exclusive_absent_locked(
        cell: ChengAtomicTreeCellPtr,
        outErr: ptr): bool =
    if !cheng_atomic_tree_verify_exclusive_parent_locked(cell, outErr) ||
       cell->finalName == nil:
        return false
    let finalFd = libc_openat_runtime(cell->parentFd,
                                      cell->finalName,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    if finalFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               finalFd,
               "atomic_tree_exclusive_absent_probe_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: exclusive absent destination appeared")
        return false
    let err = native_cheng_errno_code_runtime()
    if err != chengAtomicTreeErrnoNoEntry:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: exclusive absent destination probe failed")
        return false
    return true

fn cheng_shared_head_lease_store_u64(base: ptr, index: int32, value: uint64) =
    *(UInt64Ptr(cheng_ptr_plus(base, index * 8))) = value

fn cheng_shared_head_lease_store_i32(base: ptr, index: int32, value: int32) =
    *(Int32Ptr(cheng_ptr_plus(base, index * 4))) = value

fn cheng_shared_head_lease_load_i32(base: ptr, index: int32): int32 =
    return *(Int32Ptr(cheng_ptr_plus(base, index * 4)))

# A current-HEAD reader is a true cross-process shared lease. The private
# opening row is reserved before any descriptor exists, but no handle is
# published until the blocking LOCK_SH completes and the parent inode is
# reopened and joined. Waiting therefore holds neither the Cheng runtime lock
# nor a caller-visible owner; process death lets the kernel release the OFD.
@borrows
fn cheng_atomic_tree_open_verified_blocking_lease_or_absent(
        parentPath: str,
        finalName: str,
        lockOperation: int32,
        outKind: Int32Ptr,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    if outKind != nil:
        *outKind = 0
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outKind == nil ||
       (lockOperation != chengAtomicTreeFlockSharedBlocking &&
        lockOperation != chengAtomicTreeFlockExclusiveBlocking) ||
       !cheng_atomic_tree_absolute_parent_valid(parentPath) ||
       !cheng_atomic_tree_single_name_valid(finalName):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid shared open request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let statesBase = ptr(&chengSharedHeadLeaseOwnerStates)
    let fdsBase = ptr(&chengSharedHeadLeaseOwnerParentFds)
    let devicesBase = ptr(&chengSharedHeadLeaseOwnerParentDevices)
    let inodesBase = ptr(&chengSharedHeadLeaseOwnerParentInodes)
    let handlesBase = ptr(&chengSharedHeadLeaseOwnerHandles)
    let ownerRow = chengSharedHeadLeaseOwnerNextRow
    if ownerRow < 0 || ownerRow >= chengSharedHeadLeaseOwnerCount ||
       cheng_shared_head_lease_load_i32(statesBase, ownerRow) != 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: shared lease owner arena exhausted")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    chengSharedHeadLeaseOwnerNextRow = ownerRow + 1
    cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerOpening)
    cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
    cheng_shared_head_lease_store_u64(
        devicesBase, ownerRow, uint64(0))
    cheng_shared_head_lease_store_u64(
        inodesBase, ownerRow, uint64(0))
    cheng_shared_head_lease_store_u64(
        handlesBase, ownerRow, uint64(0))
    let parentFd = cheng_atomic_tree_open_parent_absolute(
        parentPath, errorOut)
    var parentSize: int64
    var parentMode: int32
    var parentDev: uint64
    var parentIno: uint64
    let finalRaw = cheng_copy_cstring_from_str_locked(finalName)
    let prepared = parentFd >= 0 && finalRaw != nil &&
        cheng_atomic_tree_fstat(
            parentFd, &parentSize, &parentMode, &parentDev, &parentIno) &&
        (parentMode & chengAtomicTreeTypeMask) == chengAtomicTreeTypeDir &&
        parentDev != uint64(0) && parentIno != uint64(0)
    if prepared:
        cheng_shared_head_lease_store_i32(fdsBase, ownerRow, parentFd)
        cheng_shared_head_lease_store_u64(
            devicesBase, ownerRow, parentDev)
        cheng_shared_head_lease_store_u64(
            inodesBase, ownerRow, parentIno)
    else:
        if finalRaw != nil:
            cheng_free_locked(finalRaw)
        if parentFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_shared_open_parent_fd_close_failed"):
            return uint64(0)
        cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: shared parent identity unavailable")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_unlock()
    var lockRc: int32 = -1
    var lockFailed = false
    while lockRc != 0 && !lockFailed:
        lockRc = libc_flock_runtime(parentFd, lockOperation)
        if lockRc != 0 &&
           native_cheng_errno_code_runtime() != chengAtomicTreeErrnoIntr:
            lockFailed = true
    cheng_runtime_lock()
    if lockFailed ||
       cheng_shared_head_lease_load_i32(statesBase, ownerRow) != chengSharedHeadLeaseOwnerOpening ||
       cheng_shared_head_lease_load_i32(fdsBase, ownerRow) != parentFd:
        if finalRaw != nil:
            cheng_free_locked(finalRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_shared_open_parent_fd_close_failed"):
            return uint64(0)
        cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
        cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: shared parent lease unavailable")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let reopenedParentFd = cheng_atomic_tree_open_parent_absolute(
        parentPath, errorOut)
    var reopenedParentSize: int64
    var reopenedParentMode: int32
    var reopenedParentDev: uint64
    var reopenedParentIno: uint64
    let parentJoined = reopenedParentFd >= 0 &&
        cheng_atomic_tree_fstat(
            reopenedParentFd,
            &reopenedParentSize,
            &reopenedParentMode,
            &reopenedParentDev,
            &reopenedParentIno) &&
        (reopenedParentMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        reopenedParentDev == parentDev && reopenedParentIno == parentIno
    if reopenedParentFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           reopenedParentFd,
           "atomic_tree_shared_open_joined_parent_fd_close_failed"):
        return uint64(0)
    if !parentJoined:
        cheng_free_locked(finalRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_shared_open_parent_fd_close_failed"):
            return uint64(0)
        cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
        cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: shared parent identity drift")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(
        parentFd, finalRaw, cheng_atomic_tree_dir_open_flags(), 0)
    let openErr = rootFd < 0 ? native_cheng_errno_code_runtime() : 0
    cheng_free_locked(finalRaw)
    var kind = chengAtomicTreeExclusiveKindOpened
    var rootDev: uint64
    var rootIno: uint64
    if rootFd < 0:
        if openErr != chengAtomicTreeErrnoNoEntry:
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_shared_open_parent_fd_close_failed"):
                return uint64(0)
            cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
            cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: shared destination open failed")
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return uint64(0)
        kind = chengAtomicTreeExclusiveKindAbsent
    else:
        var rootSize: int64
        var rootMode: int32
        if !cheng_atomic_tree_fstat(
               rootFd, &rootSize, &rootMode, &rootDev, &rootIno) ||
           (rootMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
            if !cheng_atomic_tree_close_fd_or_abort(
                   rootFd,
                   "atomic_tree_shared_open_root_fd_close_failed"):
                return uint64(0)
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_shared_open_parent_fd_close_failed"):
                return uint64(0)
            cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
            cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: shared destination identity unavailable")
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return uint64(0)
    var noStagingName: str
    let mode = kind == chengAtomicTreeExclusiveKindOpened ?
        chengAtomicTreeModeExclusiveOpened :
        chengAtomicTreeModeExclusiveAbsent
    let cell = cheng_atomic_tree_exclusive_cell_new(
        parentFd, rootFd, mode, parentPath, noStagingName, finalName,
        parentDev, parentIno, rootDev, rootIno, errorOut)
    if cell == nil:
        if rootFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_shared_open_root_fd_close_failed"):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_shared_open_parent_fd_close_failed"):
            return uint64(0)
        cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
        cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
        cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerRejected)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: shared handle register failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_shared_head_lease_store_i32(fdsBase, ownerRow, -1)
    cheng_shared_head_lease_store_u64(
        handlesBase, ownerRow, handle)
    cheng_shared_head_lease_store_i32(statesBase, ownerRow, chengSharedHeadLeaseOwnerAcquired)
    *outKind = kind
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

@borrows
@exportc("cheng_atomic_tree_open_verified_shared_or_absent_bridge")
@abi_internal
fn cheng_atomic_tree_open_verified_shared_or_absent_bridge_export(
        parentPath: str,
        finalName: str,
        outKind: Int32Ptr,
        outErr: ptr): uint64 =
    return cheng_atomic_tree_open_verified_blocking_lease_or_absent(
        parentPath,
        finalName,
        chengAtomicTreeFlockSharedBlocking,
        outKind,
        outErr)

@borrows
@exportc("cheng_atomic_tree_open_verified_blocking_exclusive_or_absent_bridge")
@abi_internal
fn cheng_atomic_tree_open_verified_blocking_exclusive_or_absent_bridge_export(
        parentPath: str,
        finalName: str,
        outKind: Int32Ptr,
        outErr: ptr): uint64 =
    return cheng_atomic_tree_open_verified_blocking_lease_or_absent(
        parentPath,
        finalName,
        chengAtomicTreeFlockExclusiveBlocking,
        outKind,
        outErr)

@borrows
@exportc("cheng_atomic_tree_open_verified_exclusive_or_absent_bridge")
@abi_internal
fn cheng_atomic_tree_open_verified_exclusive_or_absent_bridge_export(
        parentPath: str,
        finalName: str,
        outKind: Int32Ptr,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    if outKind != nil:
        *outKind = 0
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outKind == nil ||
       !cheng_atomic_tree_absolute_parent_valid(parentPath) ||
       !cheng_atomic_tree_single_name_valid(finalName):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid exclusive open request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let parentFd = cheng_atomic_tree_open_parent_absolute(
        parentPath,
        errorOut)
    if parentFd < 0:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if libc_flock_runtime(parentFd,
                           chengAtomicTreeFlockExclusiveNonblocking) != 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_open_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: parent lease unavailable")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var parentSize: int64
    var parentMode: int32
    var parentDev: uint64
    var parentIno: uint64
    if !cheng_atomic_tree_fstat(parentFd,
                                 &parentSize,
                                 &parentMode,
                                 &parentDev,
                                 &parentIno) ||
       (parentMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_open_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: leased parent identity unavailable")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let finalRaw = cheng_copy_cstring_from_str_locked(finalName)
    if finalRaw == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_open_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: final name alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(parentFd,
                                      finalRaw,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    let openErr = rootFd < 0 ? native_cheng_errno_code_runtime() : 0
    cheng_free_locked(finalRaw)
    var kind = chengAtomicTreeExclusiveKindOpened
    var rootDev: uint64
    var rootIno: uint64
    if rootFd < 0:
        if openErr != chengAtomicTreeErrnoNoEntry:
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_exclusive_open_parent_fd_close_failed"):
                return uint64(0)
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: destination open failed")
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return uint64(0)
        kind = chengAtomicTreeExclusiveKindAbsent
    else:
        var rootSize: int64
        var rootMode: int32
        if !cheng_atomic_tree_fstat(rootFd,
                                     &rootSize,
                                     &rootMode,
                                     &rootDev,
                                     &rootIno) ||
           (rootMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
            if !cheng_atomic_tree_close_fd_or_abort(
                   rootFd,
                   "atomic_tree_exclusive_open_root_fd_close_failed"):
                return uint64(0)
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_exclusive_open_parent_fd_close_failed"):
                return uint64(0)
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: destination identity unavailable")
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return uint64(0)
    var noStagingName: str
    let mode = kind == chengAtomicTreeExclusiveKindOpened ?
               chengAtomicTreeModeExclusiveOpened :
               chengAtomicTreeModeExclusiveAbsent
    let cell = cheng_atomic_tree_exclusive_cell_new(
        parentFd,
        rootFd,
        mode,
        parentPath,
        noStagingName,
        finalName,
        parentDev,
        parentIno,
        rootDev,
        rootIno,
        errorOut)
    if cell == nil:
        if rootFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_exclusive_open_root_fd_close_failed"):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_open_parent_fd_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive handle register failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    *outKind = kind
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

@borrows
@exportc("cheng_atomic_tree_open_verified_sibling_from_exclusive_parent_or_absent_bridge")
@abi_internal
fn cheng_atomic_tree_open_verified_sibling_from_exclusive_parent_or_absent_bridge_export(
        parentAuthorityHandle: uint64,
        finalName: str,
        outKind: Int32Ptr,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    if outKind != nil:
        *outKind = 0
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outKind == nil ||
       !cheng_atomic_tree_single_name_valid(finalName):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid exclusive sibling open request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let source = cheng_atomic_tree_cell_from_handle_locked(
        parentAuthorityHandle, errorOut)
    if source == nil || source->exclusiveLeaseHeld != 1 ||
       source->parentFd < 0 || source->canonicalParentPath == nil ||
       !cheng_atomic_tree_mode_has_exclusive_lease(source->mode) ||
       !cheng_atomic_tree_verify_exclusive_parent_locked(source, errorOut):
        if source != nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: sibling open requires live exclusive parent authority")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let parentFd = libc_dup_cloexec_runtime(source->parentFd)
    if parentFd < 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive sibling parent retain failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    var parentSize: int64
    var parentMode: int32
    var parentDev: uint64
    var parentIno: uint64
    if !cheng_atomic_tree_fstat(parentFd,
                                 &parentSize,
                                 &parentMode,
                                 &parentDev,
                                 &parentIno) ||
       (parentMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir ||
       parentDev != source->parentDev || parentIno != source->parentIno:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_sibling_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive sibling parent identity drift")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let finalRaw = cheng_copy_cstring_from_str_locked(finalName)
    if finalRaw == nil:
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_sibling_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive sibling final name alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(parentFd,
                                      finalRaw,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    let openErr = rootFd < 0 ? native_cheng_errno_code_runtime() : 0
    cheng_free_locked(finalRaw)
    var kind = chengAtomicTreeExclusiveKindOpened
    var rootDev: uint64
    var rootIno: uint64
    if rootFd < 0:
        if openErr != chengAtomicTreeErrnoNoEntry:
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_exclusive_sibling_parent_fd_close_failed"):
                return uint64(0)
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: exclusive sibling destination open failed")
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return uint64(0)
        kind = chengAtomicTreeExclusiveKindAbsent
    else:
        var rootSize: int64
        var rootMode: int32
        if !cheng_atomic_tree_fstat(rootFd,
                                     &rootSize,
                                     &rootMode,
                                     &rootDev,
                                     &rootIno) ||
           (rootMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
            if !cheng_atomic_tree_close_fd_or_abort(
                   rootFd,
                   "atomic_tree_exclusive_sibling_root_fd_close_failed"):
                return uint64(0)
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_exclusive_sibling_parent_fd_close_failed"):
                return uint64(0)
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: exclusive sibling destination identity unavailable")
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return uint64(0)
    var canonicalParentPath = cheng_str_view(
        source->canonicalParentPath,
        cheng_cstrlen_raw(source->canonicalParentPath))
    var noStagingName: str
    let mode = kind == chengAtomicTreeExclusiveKindOpened ?
               chengAtomicTreeModeExclusiveOpened :
               chengAtomicTreeModeExclusiveAbsent
    let cell = cheng_atomic_tree_exclusive_cell_new(
        parentFd,
        rootFd,
        mode,
        canonicalParentPath,
        noStagingName,
        finalName,
        parentDev,
        parentIno,
        rootDev,
        rootIno,
        errorOut)
    if cell == nil:
        if rootFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               rootFd,
               "atomic_tree_exclusive_sibling_root_fd_close_failed"):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_exclusive_sibling_parent_fd_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if handle == uint64(0):
        if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
            return uint64(0)
        cheng_atomic_tree_cell_free(cell)
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive sibling handle register failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    *outKind = kind
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return handle

fn cheng_atomic_tree_exclusive_terminal_discard_locked(
        cell: ChengAtomicTreeCellPtr,
        removeStaging: bool,
        failure: ptr): bool =
    if cell == nil:
        cheng_allocation_ledger_abort(failure)
        return false
    if removeStaging && cell->rootFd >= 0 &&
       !cheng_atomic_tree_verify_root_binding_locked(cell, false, nil):
        cheng_allocation_ledger_abort(failure)
        return false
    cell->mode = chengAtomicTreeModePoisoned
    if cell->rootFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(cell->rootFd, failure):
            return false
        cell->rootFd = -1
    if removeStaging:
        if cell->parentFd < 0 || cell->stagingName == nil ||
           libc_unlinkat_runtime(cell->parentFd,
                                  cell->stagingName,
                                  cheng_atomic_tree_removedir_flag()) != 0 ||
           libc_fsync_runtime(cell->parentFd) != 0:
            cheng_allocation_ledger_abort(failure)
            return false
    if cell->parentFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(cell->parentFd, failure):
            return false
        cell->parentFd = -1
        cell->exclusiveLeaseHeld = 0
    cheng_atomic_tree_cell_free(cell)
    return true

@borrows
@exportc("cheng_atomic_tree_begin_from_exclusive_absent_bridge")
@abi_internal
fn cheng_atomic_tree_begin_from_exclusive_absent_bridge_export(
        handle: uint64,
        stagingName: str,
        outConsumed: Int32Ptr,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    if outConsumed != nil:
        *outConsumed = 0
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outConsumed == nil ||
       !cheng_atomic_tree_single_name_valid(stagingName):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: invalid exclusive begin request")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    if cell == nil || cell->mode != chengAtomicTreeModeExclusiveAbsent ||
       cell->exclusiveLeaseHeld != 1 || cell->stagingName != nil ||
       cell->finalName == nil ||
       cheng_str_equals_cstring(stagingName, cell->finalName):
        if cell != nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: begin requires exclusive absent authority")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if !cheng_atomic_tree_verify_exclusive_absent_locked(cell, errorOut):
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let stagingRaw = cheng_copy_cstring_from_str_locked(stagingName)
    if stagingRaw == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: staging name alloc failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cell->stagingName = stagingRaw
    cell->mode = chengAtomicTreeModeAbsentBeginClaimed
    if !cheng_atomic_tree_invalidate_handle_locked(handle):
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_begin_handle_invalidation_failed")
        return uint64(0)
    *outConsumed = 1
    if libc_mkdirat_runtime(cell->parentFd,
                            cell->stagingName,
                            448) != 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive staging mkdir failed")
        if !cheng_atomic_tree_exclusive_terminal_discard_locked(
               cell,
               false,
               "atomic_tree_exclusive_begin_terminal_close_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let rootFd = libc_openat_runtime(cell->parentFd,
                                      cell->stagingName,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    if rootFd < 0:
        cell->mode = chengAtomicTreeModePoisoned
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_begin_staging_open_uncertain")
        return uint64(0)
    cell->rootFd = rootFd
    var rootSize: int64
    var rootMode: int32
    var rootDev: uint64
    var rootIno: uint64
    if !cheng_atomic_tree_fstat(rootFd,
                                 &rootSize,
                                 &rootMode,
                                 &rootDev,
                                 &rootIno) ||
       (rootMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
        cell->mode = chengAtomicTreeModePoisoned
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_begin_staging_identity_uncertain")
        return uint64(0)
    cell->rootDev = rootDev
    cell->rootIno = rootIno
    if !cheng_atomic_tree_verify_root_binding_locked(cell,
                                                      false,
                                                      errorOut):
        cell->mode = chengAtomicTreeModePoisoned
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_begin_root_binding_uncertain")
        return uint64(0)
    cell->mode = chengAtomicTreeModeExclusiveTransaction
    let newHandle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if newHandle == uint64(0):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive transaction handle register failed")
        if !cheng_atomic_tree_exclusive_terminal_discard_locked(
               cell,
               true,
               "atomic_tree_exclusive_begin_register_rollback_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return newHandle

fn cheng_atomic_tree_node_find_raw(cell: ChengAtomicTreeCellPtr,
                                   relativeRaw: ptr,
                                   requireDir: int32): ChengAtomicTreeCreatedNodePtr =
    var node = ChengAtomicTreeCreatedNodePtr(cell->createdHead)
    while node != nil:
        if node->isDir >= 0 && node->relativePath != nil &&
           libc_strcmp_runtime(node->relativePath, relativeRaw) == 0:
            if requireDir < 0 || node->isDir == requireDir:
                return node
            return nil
        node = ChengAtomicTreeCreatedNodePtr(node->next)
    return nil

fn cheng_atomic_tree_node_record_raw(cell: ChengAtomicTreeCellPtr,
                                     relativeRaw: ptr,
                                     dev: uint64,
                                     ino: uint64,
                                     isDir: int32): bool =
    if relativeRaw == nil ||
       cheng_atomic_tree_node_find_raw(cell, relativeRaw, -1) != nil:
        return false
    let raw = cheng_malloc_locked(
        int32(sizeof(ChengAtomicTreeCreatedNode)))
    if raw == nil:
        return false
    cheng_bytes_set(raw, 0, int32(sizeof(ChengAtomicTreeCreatedNode)))
    let node = ChengAtomicTreeCreatedNodePtr(raw)
    node->relativePath = cheng_string_copy_locked(
        relativeRaw, cheng_cstrlen_raw(relativeRaw))
    if node->relativePath == nil:
        cheng_free_locked(raw)
        return false
    node->dev = dev
    node->ino = ino
    node->isDir = isDir
    node->next = cell->createdHead
    cell->createdHead = ptr(node)
    return true

fn cheng_atomic_tree_verified_read_node_find_raw(
        cell: ChengAtomicTreeCellPtr,
        relativeRaw: ptr): ChengAtomicTreeVerifiedReadNodePtr =
    if cell == nil || relativeRaw == nil:
        return nil
    var node = ChengAtomicTreeVerifiedReadNodePtr(cell->verifiedReadHead)
    while node != nil:
        if node->relativePath != nil &&
           libc_strcmp_runtime(node->relativePath, relativeRaw) == 0:
            return node
        node = ChengAtomicTreeVerifiedReadNodePtr(node->next)
    return nil

fn cheng_atomic_tree_verified_read_node_record_raw(
        cell: ChengAtomicTreeCellPtr,
        relativeRaw: ptr,
        dev: uint64,
        ino: uint64,
        rawByteLength: int64,
        contentSha256Raw: ptr): bool =
    if cell == nil ||
       !cheng_atomic_tree_mode_is_verified_read(cell->mode) ||
       relativeRaw == nil || rawByteLength < int64(0) ||
       contentSha256Raw == nil ||
       cheng_atomic_tree_verified_read_node_find_raw(cell,
                                                      relativeRaw) != nil:
        return false
    let raw = cheng_malloc_locked(
        int32(sizeof(ChengAtomicTreeVerifiedReadNode)))
    if raw == nil:
        return false
    cheng_bytes_set(raw, 0, int32(sizeof(ChengAtomicTreeVerifiedReadNode)))
    let node = ChengAtomicTreeVerifiedReadNodePtr(raw)
    node->relativePath = cheng_string_copy_locked(
        relativeRaw, cheng_cstrlen_raw(relativeRaw))
    if node->relativePath == nil:
        cheng_free_locked(raw)
        return false
    node->dev = dev
    node->ino = ino
    node->rawByteLength = rawByteLength
    cheng_bytes_copy(&node->contentSha256.data[0], contentSha256Raw, 32)
    node->next = cell->verifiedReadHead
    cell->verifiedReadHead = ptr(node)
    return true

fn cheng_atomic_tree_verified_read_node_matches(
        node: ChengAtomicTreeVerifiedReadNodePtr,
        dev: uint64,
        ino: uint64,
        rawByteLength: int64,
        contentSha256Raw: ptr): bool =
    if node == nil || contentSha256Raw == nil ||
       node->dev != dev || node->ino != ino ||
       node->rawByteLength != rawByteLength:
        return false
    for byteIndex in 0..<32:
        if node->contentSha256.data[byteIndex] !=
           *(UInt8Ptr(cheng_ptr_plus(contentSha256Raw, byteIndex))):
            return false
    return true

fn cheng_atomic_tree_node_identity_matches(node: ChengAtomicTreeCreatedNodePtr,
                                           fd: int32,
                                           expectedType: int32): bool =
    if node == nil || fd < 0:
        return false
    var size: int64
    var mode: int32
    var dev: uint64
    var ino: uint64
    if !cheng_atomic_tree_fstat(fd, &size, &mode, &dev, &ino):
        return false
    return dev == node->dev && ino == node->ino &&
           (mode & chengAtomicTreeTypeMask) == expectedType

@borrows
fn cheng_atomic_tree_open_relative_parent(
        cell: ChengAtomicTreeCellPtr,
        relativePath: str,
        outLeaf: VoidPtrPtr,
        outErr: ptr): int32 =
    if cell == nil || outLeaf == nil ||
       !cheng_atomic_tree_relative_path_valid(relativePath):
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: invalid canonical relative path")
        return -1
    if cell->exclusiveLeaseHeld == 1:
        let useFinalName =
            cell->mode == chengAtomicTreeModeExclusiveOpened ||
            cell->mode == chengAtomicTreeModeExclusiveCommitted
        if !cheng_atomic_tree_verify_root_binding_locked(
               cell,
               useFinalName,
               outErr):
            return -1
    *outLeaf = nil
    let flags = cheng_atomic_tree_dir_open_flags()
    var currentFd = libc_openat_runtime(cell->rootFd, ".", flags, 0)
    if currentFd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: root duplicate open failed")
        return -1
    let data = cheng_str_data(relativePath)
    let n = cheng_str_len(relativePath)
    var start: int32
    var pos: int32
    while pos <= n:
        if pos < n && *(UInt8Ptr(cheng_ptr_plus(data, pos))) != uint8(47):
            pos = pos + 1
            continue
        let segment = cheng_string_copy_locked(
            cheng_ptr_plus(data, start), pos - start)
        if segment == nil:
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_relative_parent_fd_close_failed"):
                return -1
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: relative segment alloc failed")
            return -1
        if pos == n:
            *outLeaf = segment
            return currentFd
        let prefix = cheng_string_copy_locked(data, pos)
        if prefix == nil:
            cheng_free_locked(segment)
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_relative_parent_fd_close_failed"):
                return -1
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: relative prefix alloc failed")
            return -1
        var tracked: ChengAtomicTreeCreatedNodePtr
        if cheng_atomic_tree_mode_is_transaction(cell->mode):
            tracked = cheng_atomic_tree_node_find_raw(cell, prefix, 1)
            if tracked == nil:
                cheng_free_locked(prefix)
                cheng_free_locked(segment)
                if !cheng_atomic_tree_close_fd_or_abort(
                       currentFd,
                       "atomic_tree_relative_parent_fd_close_failed"):
                    return -1
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: untracked intermediate directory")
                return -1
        let nextFd = libc_openat_runtime(currentFd, segment, flags, 0)
        cheng_free_locked(segment)
        cheng_free_locked(prefix)
        if nextFd < 0:
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_relative_parent_fd_close_failed"):
                return -1
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: intermediate directory open failed")
            return -1
        if tracked != nil &&
           !cheng_atomic_tree_node_identity_matches(tracked,
                                                     nextFd,
                                                     chengAtomicTreeTypeDir):
            if !cheng_atomic_tree_close_fd_or_abort(
                   nextFd,
                   "atomic_tree_relative_next_fd_close_failed"):
                return -1
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_relative_parent_fd_close_failed"):
                return -1
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: intermediate directory identity drift")
            return -1
        if !cheng_atomic_tree_close_fd_or_abort(
               currentFd,
               "atomic_tree_relative_parent_fd_close_failed"):
            return -1
        currentFd = nextFd
        start = pos + 1
        pos = pos + 1
    if !cheng_atomic_tree_close_fd_or_abort(
           currentFd,
           "atomic_tree_relative_parent_fd_close_failed"):
        return -1
    let _ = cheng_atomic_tree_set_error(outErr,
                                         "os atomic tree: relative traversal failed")
    return -1

@borrows
fn cheng_atomic_tree_mkdir_locked(cell: ChengAtomicTreeCellPtr,
                                  relativePath: str,
                                  outErr: ptr): bool =
    if cell == nil ||
       !cheng_atomic_tree_mode_is_transaction(cell->mode) ||
       cell->committed != 0 ||
       !cheng_atomic_tree_relative_path_valid(relativePath):
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: mkdir requires active transaction and canonical path")
        return false
    if cell->exclusiveLeaseHeld == 1 &&
       !cheng_atomic_tree_verify_root_binding_locked(cell, false, outErr):
        return false
    let flags = cheng_atomic_tree_dir_open_flags()
    var currentFd = libc_openat_runtime(cell->rootFd, ".", flags, 0)
    if currentFd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: mkdir root open failed")
        return false
    let data = cheng_str_data(relativePath)
    let n = cheng_str_len(relativePath)
    var start: int32
    var pos: int32
    while pos <= n:
        if pos < n && *(UInt8Ptr(cheng_ptr_plus(data, pos))) != uint8(47):
            pos = pos + 1
            continue
        let segment = cheng_string_copy_locked(
            cheng_ptr_plus(data, start), pos - start)
        let prefix = cheng_string_copy_locked(data, pos)
        if segment == nil || prefix == nil:
            if segment != nil:
                cheng_free_locked(segment)
            if prefix != nil:
                cheng_free_locked(prefix)
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_mkdir_current_fd_close_failed"):
                return false
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: mkdir path alloc failed")
            return false
        let tracked = cheng_atomic_tree_node_find_raw(cell, prefix, 1)
        var created = false
        if tracked == nil:
            if libc_mkdirat_runtime(currentFd, segment, 448) != 0:
                cheng_free_locked(segment)
                cheng_free_locked(prefix)
                if !cheng_atomic_tree_close_fd_or_abort(
                       currentFd,
                       "atomic_tree_mkdir_current_fd_close_failed"):
                    return false
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: exclusive directory create failed")
                return false
            created = true
        let nextFd = libc_openat_runtime(currentFd, segment, flags, 0)
        if nextFd < 0:
            if created:
                if libc_unlinkat_runtime(
                       currentFd,
                       segment,
                       cheng_atomic_tree_removedir_flag()) != 0:
                    cheng_allocation_ledger_abort(
                        "atomic_tree_mkdir_open_rollback_failed")
                    return false
            cheng_free_locked(segment)
            cheng_free_locked(prefix)
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_mkdir_current_fd_close_failed"):
                return false
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: created directory open failed")
            return false
        if tracked != nil:
            if !cheng_atomic_tree_node_identity_matches(
                    tracked,
                    nextFd,
                    chengAtomicTreeTypeDir):
                if !cheng_atomic_tree_close_fd_or_abort(
                       nextFd,
                       "atomic_tree_mkdir_next_fd_close_failed"):
                    return false
                cheng_free_locked(segment)
                cheng_free_locked(prefix)
                if !cheng_atomic_tree_close_fd_or_abort(
                       currentFd,
                       "atomic_tree_mkdir_current_fd_close_failed"):
                    return false
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: tracked directory identity drift")
                return false
        else:
            var size: int64
            var mode: int32
            var dev: uint64
            var ino: uint64
            if !cheng_atomic_tree_fstat(nextFd,
                                         &size,
                                         &mode,
                                         &dev,
                                         &ino) ||
               (mode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir ||
               !cheng_atomic_tree_node_record_raw(cell,
                                                   prefix,
                                                   dev,
                                                   ino,
                                                   1):
                if !cheng_atomic_tree_close_fd_or_abort(
                       nextFd,
                       "atomic_tree_mkdir_next_fd_close_failed"):
                    return false
                if libc_unlinkat_runtime(
                       currentFd,
                       segment,
                       cheng_atomic_tree_removedir_flag()) != 0:
                    cheng_allocation_ledger_abort(
                        "atomic_tree_mkdir_record_rollback_failed")
                    return false
                cheng_free_locked(segment)
                cheng_free_locked(prefix)
                if !cheng_atomic_tree_close_fd_or_abort(
                       currentFd,
                       "atomic_tree_mkdir_current_fd_close_failed"):
                    return false
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: created directory identity/record failed")
                return false
        cheng_free_locked(segment)
        cheng_free_locked(prefix)
        if !cheng_atomic_tree_close_fd_or_abort(
               currentFd,
               "atomic_tree_mkdir_current_fd_close_failed"):
            return false
        currentFd = nextFd
        start = pos + 1
        pos = pos + 1
    let syncOk = libc_fsync_runtime(currentFd) == 0
    if !cheng_atomic_tree_close_fd_or_abort(
           currentFd,
           "atomic_tree_mkdir_current_fd_close_failed"):
        return false
    if !syncOk:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: created directory fsync failed")
        return false
    return true

@borrows
@exportc("cheng_atomic_tree_mkdir_bridge")
@abi_internal
fn cheng_atomic_tree_mkdir_bridge_export(handle: uint64,
                                          relativePath: str,
                                          outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    let ok = cell != nil &&
             cheng_atomic_tree_mkdir_locked(cell, relativePath, errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@borrows
fn cheng_atomic_tree_write_locked(cell: ChengAtomicTreeCellPtr,
                                  relativePath: str,
                                  data: ptr,
                                  dataLen: int32,
                                  outErr: ptr): bool =
    if cell == nil ||
       !cheng_atomic_tree_mode_is_transaction(cell->mode) ||
       cell->committed != 0 || dataLen < 0 ||
       (dataLen > 0 && data == nil):
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: invalid exclusive write request")
        return false
    if !cheng_atomic_tree_verify_verified_category_locked(cell, outErr):
        return false
    var leaf: ptr
    let parentFd = cheng_atomic_tree_open_relative_parent(cell,
                                                           relativePath,
                                                           &leaf,
                                                           outErr)
    if parentFd < 0:
        return false
    let fd = libc_openat_runtime(parentFd,
                                  leaf,
                                  cheng_atomic_tree_write_open_flags(),
                                  384)
    if fd < 0:
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_write_parent_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exclusive file open failed")
        return false
    var written: int32
    var writeOk = true
    while written < dataLen:
        let count = libc_write_runtime(fd,
                                        cheng_ptr_plus(data, written),
                                        dataLen - written)
        if count <= int64(0) || count > int64(dataLen - written):
            writeOk = false
            break
        written = written + int32(count)
    var size: int64
    var mode: int32
    var dev: uint64
    var ino: uint64
    if !writeOk || libc_fsync_runtime(fd) != 0 ||
       !cheng_atomic_tree_fstat(fd, &size, &mode, &dev, &ino) ||
       size != int64(dataLen) ||
       (mode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeReg:
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_write_file_fd_close_failed"):
            return false
        if libc_unlinkat_runtime(parentFd, leaf, 0) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_write_rollback_failed")
            return false
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_write_parent_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: write/fsync/fstat failed")
        return false
    let relativeRaw = cheng_copy_cstring_from_str_locked(relativePath)
    if relativeRaw == nil ||
       !cheng_atomic_tree_node_record_raw(cell,
                                           relativeRaw,
                                           dev,
                                           ino,
                                           0):
        if relativeRaw != nil:
            cheng_free_locked(relativeRaw)
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_write_file_fd_close_failed"):
            return false
        if libc_unlinkat_runtime(parentFd, leaf, 0) != 0:
            cheng_allocation_ledger_abort(
                "atomic_tree_write_record_rollback_failed")
            return false
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_write_parent_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: file record failed")
        return false
    cheng_free_locked(relativeRaw)
    if !cheng_atomic_tree_close_fd_or_abort(
           fd,
           "atomic_tree_write_file_fd_close_failed"):
        return false
    cheng_free_locked(leaf)
    if !cheng_atomic_tree_close_fd_or_abort(
           parentFd,
           "atomic_tree_write_parent_fd_close_failed"):
        return false
    return true

@borrows
@exportc("cheng_atomic_tree_write_exclusive_sync_bridge")
@abi_internal
fn cheng_atomic_tree_write_exclusive_sync_bridge_export(
        handle: uint64,
        relativePath: str,
        data: ptr,
        dataLen: int32,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    let ok = cell != nil &&
             cheng_atomic_tree_write_locked(cell,
                                             relativePath,
                                             data,
                                             dataLen,
                                             errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@borrows
@exportc("cheng_atomic_tree_write_exclusive_lease_sync_bridge")
@abi_internal
fn cheng_atomic_tree_write_exclusive_lease_sync_bridge_export(
        handle: uint64,
        relativePath: str,
        data: ptr,
        dataLen: int32,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    var ok = false
    if cell != nil:
        if !cheng_atomic_tree_mode_is_transaction(cell->mode) ||
           (cell->exclusiveLeaseHeld != 1 &&
            cell->verifiedRootLeaseHeld != 1) ||
           cell->committed != 0:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: write requires active exclusive lease transaction")
        else:
            ok = cheng_atomic_tree_write_locked(cell,
                                                 relativePath,
                                                 data,
                                                 dataLen,
                                                 errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

# Rewrite one already-created fixed-size regular inode while the caller owns
# the verified exclusive root lease.  The distinct O_WRONLY/O_RDONLY open
# descriptions, pre/post inode join, fdatasync and byte-for-byte readback are
# one physical operation; no pathname or descriptor escapes this ABI bridge.
@borrows
@exportc("cheng_atomic_tree_rewrite_existing_lease_sync_bridge")
@abi_internal
fn cheng_atomic_tree_rewrite_existing_lease_sync_bridge_export(
        handle: uint64,
        relativePath: str,
        data: ptr,
        dataLen: int32,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    if dataLen <= 0 || data == nil:
        var invalidWire: ChengRuntimeErrorWire
        cheng_runtime_error_wire_init(&invalidWire)
        let _invalid = cheng_atomic_tree_set_error(
            ptr(&invalidWire),
            "os atomic tree: invalid existing inode rewrite")
        cheng_runtime_error_wire_project(&invalidWire, outErr)
        return 0
    var writer = -1
    var reader = -1
    if cheng_atomic_tree_open_existing_write_read_pair_bridge(
           handle,
           relativePath,
           int64(dataLen),
           &writer,
           &reader,
           outErr) != 1:
        return 0
    var writerSizeBefore: int64
    var writerModeBefore: int32
    var writerDevBefore: uint64
    var writerInoBefore: uint64
    var readerSizeBefore: int64
    var readerModeBefore: int32
    var readerDevBefore: uint64
    var readerInoBefore: uint64
    var writerSizeAfter: int64
    var writerModeAfter: int32
    var writerDevAfter: uint64
    var writerInoAfter: uint64
    var readerSizeAfter: int64
    var readerModeAfter: int32
    var readerDevAfter: uint64
    var readerInoAfter: uint64
    var raw: ptr
    cheng_runtime_lock()
    raw = cheng_malloc_locked(dataLen)
    cheng_runtime_unlock()
    var ok = raw != nil &&
        cheng_atomic_tree_fstat(
            writer,
            &writerSizeBefore,
            &writerModeBefore,
            &writerDevBefore,
            &writerInoBefore) &&
        cheng_atomic_tree_fstat(
            reader,
            &readerSizeBefore,
            &readerModeBefore,
            &readerDevBefore,
            &readerInoBefore) &&
        writerSizeBefore == int64(dataLen) &&
        readerSizeBefore == int64(dataLen) &&
        writerModeBefore == readerModeBefore &&
        writerDevBefore != uint64(0) &&
        writerInoBefore != uint64(0) &&
        writerDevBefore == readerDevBefore &&
        writerInoBefore == readerInoBefore &&
        libc_lseek_runtime(writer, int64(0), 0) == int64(0)
    var written: int32
    while ok && written < dataLen:
        let amount = libc_write_runtime(
            writer,
            cheng_ptr_plus(data, written),
            dataLen - written)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) || amount > int64(dataLen - written):
            ok = false
        else:
            written = written + int32(amount)
    if ok:
        ok = libc_fdatasync_runtime(writer) == 0 &&
            libc_lseek_runtime(reader, int64(0), 0) == int64(0)
    var readBytes: int32
    while ok && readBytes < dataLen:
        let amount = libc_read_runtime(
            reader,
            cheng_ptr_plus(raw, readBytes),
            dataLen - readBytes)
        if amount < int64(0) &&
           native_cheng_errno_code_runtime() == chengHeldExecEintr:
            continue
        if amount <= int64(0) || amount > int64(dataLen - readBytes):
            ok = false
        else:
            readBytes = readBytes + int32(amount)
    if ok:
        ok = cheng_bytes_equal(raw, data, dataLen) &&
            cheng_atomic_tree_fstat(
                writer,
                &writerSizeAfter,
                &writerModeAfter,
                &writerDevAfter,
                &writerInoAfter) &&
            cheng_atomic_tree_fstat(
                reader,
                &readerSizeAfter,
                &readerModeAfter,
                &readerDevAfter,
                &readerInoAfter) &&
            writerSizeAfter == writerSizeBefore &&
            writerModeAfter == writerModeBefore &&
            writerDevAfter == writerDevBefore &&
            writerInoAfter == writerInoBefore &&
            readerSizeAfter == readerSizeBefore &&
            readerModeAfter == readerModeBefore &&
            readerDevAfter == readerDevBefore &&
            readerInoAfter == readerInoBefore
    if raw != nil:
        cheng_runtime_lock()
        cheng_free_locked(raw)
        cheng_runtime_unlock()
    let writerClosed = cheng_atomic_tree_close_fd_or_abort(
        writer, "atomic_tree_existing_rewrite_writer_close_failed")
    let readerClosed = cheng_atomic_tree_close_fd_or_abort(
        reader, "atomic_tree_existing_rewrite_reader_close_failed")
    ok = ok && writerClosed && readerClosed
    if !ok:
        var failureWire: ChengRuntimeErrorWire
        cheng_runtime_error_wire_init(&failureWire)
        let _failure = cheng_atomic_tree_set_error(
            ptr(&failureWire),
            "os atomic tree: existing inode rewrite/readback failed")
        cheng_runtime_error_wire_project(&failureWire, outErr)
        return 0
    return 1

@borrows
fn cheng_atomic_tree_seal_read_only_locked(
        cell: ChengAtomicTreeCellPtr,
        relativePath: str,
        outErr: ptr): bool =
    if cell == nil ||
       !cheng_atomic_tree_mode_is_transaction(cell->mode) ||
       cell->committed != 0 ||
       !cheng_atomic_tree_relative_path_valid(relativePath):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: seal requires active transaction and canonical path")
        return false
    let relativeRaw = cheng_copy_cstring_from_str_locked(relativePath)
    if relativeRaw == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: seal relative path alloc failed")
        return false
    let tracked = cheng_atomic_tree_node_find_raw(
        cell, relativeRaw, 0)
    cheng_free_locked(relativeRaw)
    if tracked == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: seal requires tracked regular file")
        return false
    if tracked->sealedReadOnly != 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: file already sealed read only")
        return false
    var leaf: ptr
    let parentFd = cheng_atomic_tree_open_relative_parent(
        cell, relativePath, &leaf, outErr)
    if parentFd < 0:
        return false
    let fd = libc_openat_runtime(
        parentFd,
        leaf,
        cheng_atomic_tree_read_open_flags(),
        0)
    if fd < 0:
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_seal_parent_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: seal file open failed")
        return false
    var sizeBefore: int64
    var modeBefore: int32
    var devBefore: uint64
    var inoBefore: uint64
    let identityBefore =
        cheng_atomic_tree_fstat(
            fd,
            &sizeBefore,
            &modeBefore,
            &devBefore,
            &inoBefore) &&
        cheng_atomic_tree_node_identity_matches(
            tracked, fd, chengAtomicTreeTypeReg)
    if !identityBefore:
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_seal_file_fd_close_failed"):
            return false
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_seal_parent_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: seal pre-fchmod identity mismatch")
        return false
    let platformKind =
        cheng_read_only_mapped_region_platform_kind()
    var preSealIdentity: ChengReadOnlyMappedFileIdentity
    var preSealPathIdentity: ChengReadOnlyMappedFileIdentity
    let preSealValid =
        platformKind != 0 &&
        cheng_read_only_mapped_region_fstat(
            platformKind, fd, &preSealIdentity) &&
        cheng_read_only_mapped_region_fstatat(
            platformKind,
            parentFd,
            leaf,
            &preSealPathIdentity) &&
        cheng_read_only_mapped_region_allocation_valid(
            &preSealIdentity, outErr) &&
        cheng_read_only_mapped_region_identity_equal(
            &preSealIdentity, &preSealPathIdentity)
    if !preSealValid:
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_seal_file_fd_close_failed"):
            return false
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_seal_parent_fd_close_failed"):
            return false
        let _ = cheng_read_only_mapped_region_set_error_if_empty(
            outErr,
            "csg_mmap_e_identity_drift: pre-seal fd/path identity mismatch")
        return false
    # FS_IOC_ENABLE_VERITY requires an O_RDONLY descriptor while the caller
    # still has write permission to the inode. Drop the mode to 0400 only
    # after verity is enabled and measured.
    var authorityOk = false
    var identityAfter: ChengReadOnlyMappedFileIdentity
    var pathIdentityAfter: ChengReadOnlyMappedFileIdentity
    var sealedVerityDigest: ChengFixedBytes32
    if cheng_read_only_mapped_region_linux_platform(
           platformKind):
        let enableRc =
            cheng_linux_fsverity_enable_sha256_runtime(fd)
        var enableErrno: int32
        if enableRc != 0:
            enableErrno = native_cheng_errno_code_runtime()
        let enableAccepted =
            enableRc == 0 ||
            (enableRc != 0 &&
             enableErrno == chengErrnoEexist)
        if enableRc != 0 &&
           enableErrno == chengErrnoEacces:
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "csg_mmap_e_fsverity_enable_denied: inode write access required before mode drop")
        var enabledDigest: ChengFixedBytes32
        var firstDigest: ChengFixedBytes32
        var firstIdentity: ChengReadOnlyMappedFileIdentity
        var firstPathIdentity: ChengReadOnlyMappedFileIdentity
        var finalDigest: ChengFixedBytes32
        authorityOk =
            enableAccepted &&
            cheng_read_only_mapped_region_linux_measure(
                platformKind,
                fd,
                ptr(&enabledDigest),
                outErr) &&
            cheng_read_only_mapped_region_fchmod(
                platformKind,
                fd,
                chengReadOnlyMappedRegionFileMode) &&
            cheng_read_only_mapped_region_linux_measure(
                platformKind,
                fd,
                ptr(&firstDigest),
                outErr) &&
            cheng_read_only_mapped_region_fstat(
                platformKind, fd, &firstIdentity) &&
            cheng_read_only_mapped_region_fstatat(
                platformKind,
                parentFd,
                leaf,
                &firstPathIdentity) &&
            cheng_read_only_mapped_region_identity_valid(
                &firstIdentity, outErr) &&
            cheng_read_only_mapped_region_identity_equal(
                &firstIdentity, &firstPathIdentity) &&
            cheng_read_only_mapped_region_linux_measure(
                platformKind,
                fd,
                ptr(&finalDigest),
                outErr) &&
            cheng_read_only_mapped_region_fstat(
                platformKind, fd, &identityAfter) &&
            cheng_read_only_mapped_region_fstatat(
                platformKind,
                parentFd,
                leaf,
                &pathIdentityAfter) &&
            cheng_read_only_mapped_region_identity_equal(
                &firstIdentity, &identityAfter) &&
            cheng_read_only_mapped_region_identity_equal(
                &identityAfter, &pathIdentityAfter) &&
            cheng_fixed32_equal(
                enabledDigest, firstDigest) &&
            cheng_fixed32_equal(firstDigest, finalDigest) &&
            identityAfter.size == sizeBefore &&
            identityAfter.size == preSealIdentity.size &&
            identityAfter.uid == preSealIdentity.uid &&
            identityAfter.gid == preSealIdentity.gid &&
            identityAfter.nlink == preSealIdentity.nlink &&
            identityAfter.dev == devBefore &&
            identityAfter.ino == inoBefore
        if authorityOk:
            sealedVerityDigest = finalDigest
    elif platformKind ==
             chengReadOnlyMappedRegionPlatformDarwinA64:
        authorityOk =
            cheng_read_only_mapped_region_fchmod(
                platformKind,
                fd,
                chengReadOnlyMappedRegionFileMode) &&
            cheng_read_only_mapped_region_fstat(
                platformKind, fd, &identityAfter) &&
            cheng_read_only_mapped_region_fstatat(
                platformKind,
                parentFd,
                leaf,
                &pathIdentityAfter) &&
            cheng_read_only_mapped_region_identity_valid(
                &identityAfter, outErr) &&
            cheng_read_only_mapped_region_identity_equal(
                &identityAfter, &pathIdentityAfter) &&
            identityAfter.size == sizeBefore &&
            identityAfter.size == preSealIdentity.size &&
            identityAfter.uid == preSealIdentity.uid &&
            identityAfter.gid == preSealIdentity.gid &&
            identityAfter.nlink == preSealIdentity.nlink &&
            identityAfter.dev == devBefore &&
            identityAfter.ino == inoBefore
    if !cheng_atomic_tree_close_fd_or_abort(
           fd,
           "atomic_tree_seal_file_fd_close_failed"):
        return false
    cheng_free_locked(leaf)
    if !cheng_atomic_tree_close_fd_or_abort(
           parentFd,
           "atomic_tree_seal_parent_fd_close_failed"):
        return false
    if !authorityOk:
        let _ = cheng_read_only_mapped_region_set_error_if_empty(
            outErr,
            "os atomic tree: immutable seal authority unavailable")
        return false
    tracked->sealedReadOnly = 1
    tracked->sealedMtimeSec = identityAfter.mtimeSec
    tracked->sealedMtimeNsec = identityAfter.mtimeNsec
    tracked->sealedCtimeSec = identityAfter.ctimeSec
    tracked->sealedCtimeNsec = identityAfter.ctimeNsec
    tracked->sealedChangeVersion =
        identityAfter.changeVersion
    tracked->sealedAuthorityKind =
        identityAfter.authorityKind
    tracked->sealedVerityDigest =
        sealedVerityDigest
    return true

@exportc("cheng_atomic_tree_seal_read_only_bridge")
@abi_internal
@borrows
fn cheng_atomic_tree_seal_read_only_bridge_export(
        handle: uint64,
        relativePath: str,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if cheng_read_only_mapped_region_platform_kind() == 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: read only seal provider unsupported")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_lock()
    let cell =
        cheng_atomic_tree_cell_from_handle_locked(
            handle, errorOut)
    let ok =
        cell != nil &&
        cheng_atomic_tree_seal_read_only_locked(
            cell, relativePath, errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@borrows
fn cheng_atomic_tree_read_locked(cell: ChengAtomicTreeCellPtr,
                                 relativePath: str,
                                 outData: VoidPtrPtr,
                                 outLength: Int32Ptr,
                                 outErr: ptr): bool =
    if cell == nil || outData == nil || outLength == nil:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: invalid stable read request")
        return false
    *outData = nil
    *outLength = 0
    var leaf: ptr
    let parentFd = cheng_atomic_tree_open_relative_parent(cell,
                                                           relativePath,
                                                           &leaf,
                                                           outErr)
    if parentFd < 0:
        return false
    let fd = libc_openat_runtime(parentFd,
                                  leaf,
                                  cheng_atomic_tree_read_open_flags(),
                                  0)
    cheng_free_locked(leaf)
    if !cheng_atomic_tree_close_fd_or_abort(
           parentFd,
           "atomic_tree_read_parent_fd_close_failed"):
        return false
    if fd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: stable file open failed")
        return false
    var sizeBefore: int64
    var modeBefore: int32
    var devBefore: uint64
    var inoBefore: uint64
    if !cheng_atomic_tree_fstat(fd,
                                 &sizeBefore,
                                 &modeBefore,
                                 &devBefore,
                                 &inoBefore) ||
       sizeBefore < int64(0) || sizeBefore > int64(2147483647) ||
       (modeBefore & chengAtomicTreeTypeMask) != chengAtomicTreeTypeReg:
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_read_file_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: stable pre-read fstat failed")
        return false
    let count = int32(sizeBefore)
    var raw: ptr
    if count > 0:
        raw = cheng_malloc_locked(count)
        if raw == nil:
            if !cheng_atomic_tree_close_fd_or_abort(
                   fd,
                   "atomic_tree_read_file_fd_close_failed"):
                return false
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: stable read alloc failed")
            return false
    var got: int32
    var readOk = true
    while got < count:
        let n = libc_read_runtime(fd,
                                  cheng_ptr_plus(raw, got),
                                  count - got)
        if n <= int64(0) || n > int64(count - got):
            readOk = false
            break
        got = got + int32(n)
    var sizeAfter: int64
    var modeAfter: int32
    var devAfter: uint64
    var inoAfter: uint64
    if !readOk ||
       !cheng_atomic_tree_fstat(fd,
                                 &sizeAfter,
                                 &modeAfter,
                                 &devAfter,
                                 &inoAfter) ||
       sizeAfter != sizeBefore || modeAfter != modeBefore ||
       devAfter != devBefore || inoAfter != inoBefore:
        if raw != nil:
            cheng_free_locked(raw)
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_read_file_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: file changed during stable read")
        return false
    if cheng_atomic_tree_mode_is_verified_read(cell->mode):
        let contentSha256Raw = cheng_malloc_locked(32)
        let relativeRaw =
            cheng_copy_cstring_from_str_locked(relativePath)
        var contentBound = contentSha256Raw != nil && relativeRaw != nil &&
            cheng_allocation_ledger_sha256_noalloc(
                raw, count, contentSha256Raw)
        if contentBound:
            let existing = cheng_atomic_tree_verified_read_node_find_raw(
                cell,
                relativeRaw)
            if existing == nil:
                contentBound =
                    cheng_atomic_tree_verified_read_node_record_raw(
                        cell,
                        relativeRaw,
                        devAfter,
                        inoAfter,
                        sizeAfter,
                        contentSha256Raw)
            else:
                contentBound =
                    cheng_atomic_tree_verified_read_node_matches(
                        existing,
                        devAfter,
                        inoAfter,
                        sizeAfter,
                        contentSha256Raw)
        if relativeRaw != nil:
            cheng_free_locked(relativeRaw)
        if contentSha256Raw != nil:
            cheng_free_locked(contentSha256Raw)
        if !contentBound:
            if raw != nil:
                cheng_free_locked(raw)
            if !cheng_atomic_tree_close_fd_or_abort(
                   fd,
                   "atomic_tree_read_file_fd_close_failed"):
                return false
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: verified read identity/content drift")
            return false
    if !cheng_atomic_tree_close_fd_or_abort(
           fd,
           "atomic_tree_read_file_fd_close_failed"):
        return false
    *outData = raw
    *outLength = count
    return true

@borrows
@exportc("cheng_atomic_tree_read_stable_bridge")
@abi_internal
fn cheng_atomic_tree_read_stable_bridge_export(handle: uint64,
                                                relativePath: str,
                                                outText: ptr,
                                                outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outText == nil || outText == outErr:
        if outText == outErr && outText != nil:
            cheng_runtime_lock_abort(
                "atomic tree: read text and error outputs alias")
        let _ = cheng_atomic_tree_set_error(
            errorOut, "os atomic tree: nil stable read output")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    var empty: str
    cheng_str_store_slot(outText, empty)
    var raw: ptr
    var count: int32
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    let ok = cell != nil &&
             cheng_atomic_tree_read_locked(cell,
                                            relativePath,
                                            &raw,
                                            &count,
                                            errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    if !ok:
        return 0
    var value = cheng_str_empty()
    if count > 0:
        value = cheng_str_view_owned(raw, count)
    cheng_str_store_slot(outText, value)
    cheng_str_dispose(value)
    return 1

@borrows
fn cheng_atomic_tree_open_existing_write_read_pair_bridge(
        handle: uint64,
        relativePath: str,
        expectedBytes: int64,
        outWriter: Int32Ptr,
        outReader: Int32Ptr,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    if outWriter == nil || outReader == nil:
        return 0
    *outWriter = -1
    *outReader = -1
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    var ok = false
    var writer = -1
    var reader = -1
    var parentFd = -1
    var leaf: ptr
    if cell == nil || expectedBytes < int64(0) ||
       cell->mode != chengAtomicTreeModeExclusiveOpened ||
       cell->committed != 1 || cell->exclusiveLeaseHeld != 1 ||
       !cheng_atomic_tree_verify_root_binding_locked(cell, true, errorOut):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: capsule role pair requires verified exclusive root")
    else:
        parentFd = cheng_atomic_tree_open_relative_parent(
            cell, relativePath, &leaf, errorOut)
        if parentFd >= 0:
            writer = libc_openat_runtime(
                parentFd,
                leaf,
                cheng_atomic_tree_existing_write_only_open_flags(),
                0)
            reader = libc_openat_runtime(
                parentFd,
                leaf,
                cheng_atomic_tree_read_open_flags(),
                0)
            var writerSize: int64
            var writerMode: int32
            var writerDev: uint64
            var writerIno: uint64
            var readerSize: int64
            var readerMode: int32
            var readerDev: uint64
            var readerIno: uint64
            ok = writer >= 0 && reader >= 0 &&
                cheng_atomic_tree_fstat(
                    writer, &writerSize, &writerMode, &writerDev, &writerIno) &&
                cheng_atomic_tree_fstat(
                    reader, &readerSize, &readerMode, &readerDev, &readerIno) &&
                (writerMode & chengAtomicTreeTypeMask) ==
                    chengAtomicTreeTypeReg &&
                (readerMode & chengAtomicTreeTypeMask) ==
                    chengAtomicTreeTypeReg &&
                writerSize == expectedBytes && readerSize == expectedBytes &&
                writerDev != uint64(0) && writerIno != uint64(0) &&
                writerDev == readerDev && writerIno == readerIno &&
                cheng_atomic_tree_verify_root_binding_locked(
                    cell, true, errorOut)
            if !ok:
                let _ = cheng_atomic_tree_set_error(
                    errorOut,
                    "os atomic tree: capsule role inode identity mismatch")
    if leaf != nil:
        cheng_free_locked(leaf)
    if parentFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           parentFd, "atomic_tree_capsule_pair_parent_close_failed"):
        ok = false
    if !ok:
        if writer >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               writer, "atomic_tree_capsule_writer_close_failed"):
            ok = false
        if reader >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               reader, "atomic_tree_capsule_reader_close_failed"):
            ok = false
        writer = -1
        reader = -1
    else:
        *outWriter = writer
        *outReader = reader
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

fn cheng_atomic_tree_open_terminal_finished_recovery_pair_bridge(
        handle: uint64,
        outReader: Int32Ptr,
        outSyncWriter: Int32Ptr,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    if outReader == nil || outSyncWriter == nil:
        return 0
    *outReader = -1
    *outSyncWriter = -1
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    var ok = false
    var reader = -1
    var syncWriter = -1
    var parentFd = -1
    var leaf: ptr
    if cell == nil ||
       cell->mode != chengAtomicTreeModeExclusiveOpened ||
       cell->committed != 1 || cell->exclusiveLeaseHeld != 1 ||
       !cheng_atomic_tree_verify_root_binding_locked(cell, true, errorOut):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: finished recovery requires verified exclusive root")
    else:
        parentFd = cheng_atomic_tree_open_relative_parent(
            cell, "finished-upload.bin", &leaf, errorOut)
        if parentFd >= 0:
            reader = libc_openat_runtime(
                parentFd,
                leaf,
                cheng_atomic_tree_read_open_flags(),
                0)
            syncWriter = libc_openat_runtime(
                parentFd,
                leaf,
                cheng_atomic_tree_existing_write_only_open_flags(),
                0)
            var readerSize: int64
            var readerMode: int32
            var readerDevice: uint64
            var readerInode: uint64
            var syncSize: int64
            var syncMode: int32
            var syncDevice: uint64
            var syncInode: uint64
            let statOk = reader >= 0 && syncWriter >= 0 &&
                cheng_atomic_tree_fstat(
                    reader,
                    &readerSize,
                    &readerMode,
                    &readerDevice,
                    &readerInode) &&
                cheng_atomic_tree_fstat(
                    syncWriter,
                    &syncSize,
                    &syncMode,
                    &syncDevice,
                    &syncInode)
            ok = statOk && readerSize >= int64(0) &&
                readerSize <= int64(2147483647) &&
                syncSize >= int64(0) &&
                syncSize <= int64(2147483647) &&
                readerMode == syncMode &&
                (readerMode & chengAtomicTreeTypeMask) ==
                    chengAtomicTreeTypeReg &&
                readerDevice != uint64(0) && readerInode != uint64(0) &&
                readerDevice == syncDevice && readerInode == syncInode &&
                cheng_atomic_tree_verify_root_binding_locked(
                    cell, true, errorOut)
            if !ok:
                let _ = cheng_atomic_tree_set_error(
                    errorOut,
                    "os atomic tree: finished recovery inode invalid")
    if leaf != nil:
        cheng_free_locked(leaf)
    if parentFd >= 0 && !cheng_atomic_tree_close_fd_or_abort(
           parentFd,
           "atomic_tree_finished_recovery_parent_close_failed"):
        ok = false
    if !ok:
        if reader >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               reader,
               "atomic_tree_finished_recovery_reader_close_failed"):
            ok = false
        if syncWriter >= 0 && !cheng_atomic_tree_close_fd_or_abort(
               syncWriter,
               "atomic_tree_finished_recovery_sync_close_failed"):
            ok = false
        reader = -1
        syncWriter = -1
    else:
        *outReader = reader
        *outSyncWriter = syncWriter
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

