@exportc("cheng_fwrite")
fn cheng_fwrite_export(buf: ptr, size: int64, n: int64, stream: ptr): int32 =
    let safe = cheng_safe_write_stream(stream)
    if buf == nil || safe == nil || size <= 0 || n <= 0:
        return 0
    let wrote = libc_fwrite(buf, size, n, safe)
    if wrote > 0 && uint64(safe) != uint64(1) && uint64(safe) != uint64(2):
        libc_fflush(safe)
    if wrote > int64(2147483647):
        return 2147483647
    if wrote < int64(-2147483648):
        return -2147483648
    return int32(wrote)

@exportc("cheng_fwrite_i32")
fn cheng_fwrite_i32_export(buf: ptr, size: int32, n: int32, stream: ptr): int32 =
    return cheng_fwrite_export(buf, int64(size), int64(n), stream)

