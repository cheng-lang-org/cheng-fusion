        return
    let err = StrPtr(outErr)
    err->data = nil
    err->len = 0
    err->store_id = 0
    err->flags = 0

fn cheng_allocation_ledger_set_error(outErr: ptr, text: ptr) =
    if outErr == nil:
        return
    let err = StrPtr(outErr)
    err->data = text
    err->len = text == nil ? 0 : cheng_cstrlen_raw(text)
    err->store_id = 0
    err->flags = 0

fn cheng_allocation_ledger_abort(text: ptr) =
    cheng_runtime_lock_abort(text)

fn cheng_allocation_ledger_u64_max(): uint64 =
    return (uint64(0xffffffff) << uint64(32)) | uint64(0xffffffff)

fn cheng_allocation_ledger_production_proof_complete(): int32 =
    if chengAllocationLedgerRawManagedPointerAbaProven != 1 ||
       chengAllocationLedgerRecursiveLockProven != 1:
        return 0
    return 1

fn cheng_allocation_ledger_control_plane_backing_bytes(): uint64 =
    let pageSize = cheng_allocation_ledger_page_size()
    var backingBytes: uint64
    if pageSize == uint64(0) ||
       !cheng_allocation_ledger_align_up(
           uint64(sizeof(ChengAllocationLedgerControlPlane)),
           pageSize,
           &backingBytes):
        return uint64(0)
    return backingBytes

fn cheng_allocation_ledger_control_plane_identity_valid(): bool =
    if cheng_allocation_ledger_control_plane_raw == uint64(0):
        return false
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    return control->magic == chengAllocationLedgerControlPlaneMagic &&
           control->recordCount >= 0 &&
           control->recordCount <= chengAllocationLedgerRecordCount &&
           control->recordFreeHead >= -1 &&
           control->recordFreeHead < control->recordCount &&
           control->activeOwnerSlotIndex >= -1 &&
           control->activeOwnerSlotIndex <
               chengAllocationLedgerOwnerSlotCount &&
           control->slabCount >= 0 &&
           control->slabCount <= chengAllocationLedgerSlabCount &&
           control->slabFreeHead >= -1 &&
           control->slabFreeHead < chengAllocationLedgerSlabCount &&
           control->handleCount >= 0 &&
           control->handleCount <=
               chengAllocationLedgerFfiHandleSlotCount &&
           control->handleFreeHead >= -1 &&
           control->handleFreeHead < control->handleCount &&
           control->objectBytes ==
               uint64(sizeof(ChengAllocationLedgerControlPlane)) &&
           control->backingBytes ==
               cheng_allocation_ledger_control_plane_backing_bytes() &&
           control->pageSize == cheng_allocation_ledger_page_size()

fn cheng_allocation_ledger_checked_add(
        left: uint64,
        right: uint64,
        outValue: UInt64Ptr): bool =
    if outValue == nil || left > cheng_allocation_ledger_u64_max() - right:
        return false
    *outValue = left + right
    return true

fn cheng_allocation_ledger_page_size(): uint64 =
    let raw = libc_getpagesize_allocation_ledger_runtime()
    if raw <= 0 || (raw & (raw - 1)) != 0:
        return uint64(0)
    return uint64(raw)

fn cheng_allocation_ledger_align_up(
        value: uint64,
        alignment: uint64,
        outValue: UInt64Ptr): bool =
    if outValue == nil || alignment == uint64(0) ||
       (alignment & (alignment - uint64(1))) != uint64(0):
        return false
    let mask = alignment - uint64(1)
    if value > cheng_allocation_ledger_u64_max() - mask:
        return false
    *outValue = (value + mask) & (cheng_allocation_ledger_u64_max() ^ mask)
    return true

fn cheng_allocation_ledger_slab_backing_bytes(): uint64 =
    let pageSize = cheng_allocation_ledger_page_size()
    var backingBytes: uint64
    if pageSize == uint64(0) ||
       !cheng_allocation_ledger_align_up(
           chengAllocationLedgerSlabBackingBytes,
           pageSize,
