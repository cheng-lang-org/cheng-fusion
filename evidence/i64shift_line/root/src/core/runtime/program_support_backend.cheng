       bundleDevice == uint64(0) || bundleInode == uint64(0) ||
       !cheng_held_exec_bundle_seal_attest_fd(bundleReader) ||
       libc_lseek_runtime(
           bundleReader, int64(0), chengHeldExecSeekSet) != int64(0) ||
