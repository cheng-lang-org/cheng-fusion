        return true
    cheng_allocation_ledger_participant_tls_key = uint64(0)
    if cheng_pthread_key_create_runtime(
           &cheng_allocation_ledger_participant_tls_key, nil) != 0:
        return false
    cheng_allocation_ledger_participant_tls_ready = 1
    return true

fn cheng_allocation_ledger_participant_tls_row(): int32 =
    if cheng_allocation_ledger_participant_tls_ready == 0:
        return -1
    let encoded = uint64(cheng_pthread_getspecific_runtime(
        cheng_allocation_ledger_participant_tls_key))
    if encoded == uint64(0) ||
       encoded > uint64(chengAllocationLedgerParticipantRowCount):
        return -1
    return int32(encoded - uint64(1))

fn cheng_allocation_ledger_participant_tls_bind(row: int32): bool =
