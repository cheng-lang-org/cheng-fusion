# [wall118] var-ptr ABI glue for 8B ref handle slots (wall73 handoff
# three-file package).  Ref handle slots are 8-byte LocalPtrTag carriers;
# the str-header (24/32B) drop glue must never touch them.  Same call-site
# convention as the CleanupPlan drop/retain units synthesize: exactly one
# ByAddressAggregate argument (the slot address, argAbiSizes=8) and a void
# result, so the glue takes the slot address as a raw 8-byte word and
# touches exactly those 8 bytes through the canonical ptr-slot
# load/store intrinsics (registry-slot precedent above).  Drop =
# conditional pointee release + slot clear (mirrors cheng_str_drop_owned's
# header clear); retain = conditional pointee refcount increment
# (cheng_mem_retain/cheng_mem_release are nil-tolerant, the explicit guard
# keeps the slot load the only dereference).
@exportc("cheng_ref_drop_owned")
@abi_internal
fn cheng_ref_drop_owned_export(slotRaw: uint64) =
    let handle = ptr(cheng_runtime_ptr_slot_load_raw_intrinsic(slotRaw, 0))
    cheng_runtime_ptr_slot_store_raw_intrinsic(slotRaw, 0, 0)
    if handle != nil:
        cheng_mem_release_export(handle)

@exportc("cheng_ref_retain_owned")
@abi_internal
fn cheng_ref_retain_owned_export(slotRaw: uint64) =
    let handle = ptr(cheng_runtime_ptr_slot_load_raw_intrinsic(slotRaw, 0))
    if handle != nil:
        cheng_mem_retain_export(handle)

@exportc("cheng_mem_refcount_atomic")
