@borrows
@exportc("cheng_os_list_dir_bridge")
@abi_internal
fn cheng_os_list_dir_bridge_export(path: str): ptr =
    # Tracked directory-listing provider.  The libc listing buffer never
    # escapes this bridge: its bytes are copied into the ledger-visible
    # allocator (cheng_malloc/cheng_free) before the pointer crosses the
    # provider edge, so an active allocation-ledger session attests the
    # payload (allocation event + 1GiB budget) instead of refusing the
    # provider.  A non-tracked pointer handed to the free bridge during a
    # session still aborts (duplicate_or_untracked_free).
    let raw = cheng_copy_cstring_from_str(path)
    if raw == nil:
        return nil
    let listing = libc_list_dir(raw)
    cheng_free_export(raw)
    if listing == nil:
        return nil
    let total = cheng_cstrlen_raw(listing)
    let tracked = cheng_malloc_export(total + 1)
    if tracked == nil:
        c_free(listing)
        return nil
    if total > 0:
        cheng_bytes_copy(tracked, listing, total)
    cheng_bytes_set(cheng_ptr_plus(tracked, total), 0, 1)
    c_free(listing)
    return tracked

@exportc("cheng_os_list_dir_free_bridge")
fn cheng_os_list_dir_free_bridge_export(raw: ptr) =
    cheng_free_export(raw)

