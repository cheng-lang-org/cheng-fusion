fn cheng_str_param_to_cstring_compat_value(s: str): ptr =
    if !cheng_probably_valid_str_bridge(s):
        let compat: ptr = cheng_fallback_string_ptr(s)
        if compat == nil:
            return ""
        return compat
    let data: ptr = cheng_str_data(s)
    let len: int32 = cheng_str_len(s)
    if data == nil || len <= 0:
        let empty: ptr = driver_c_new_string_export(0)
        if empty == nil:
            return ""
        return empty
    let out: ptr = cheng_string_copy(data, len)
    if out == nil:
        return ""
    return out

@exportc("cheng_str_param_to_cstring_compat")
fn cheng_str_param_to_cstring_compat_export(s_raw: ptr): ptr =
    if s_raw == nil:
        let empty: ptr = driver_c_new_string_export(0)
        if empty == nil:
            return ""
        return empty
    let inPtr: StrPtr = StrPtr(s_raw)
    let data: ptr = inPtr->data
    let len: int32 = inPtr->len
    let flags: int32 = inPtr->flags
    if len < 0 || len > 268435456:
        let compat: ptr = data != nil && uint64(data) >= uint64(65536) ? data : nil
        if compat == nil:
            return ""
        return compat
    if flags != 0 && flags != chengStrFlagOwned:
        let compat: ptr = data != nil && uint64(data) >= uint64(65536) ? data : nil
        if compat == nil:
            return ""
        return compat
    if data == nil || len <= 0:
        let empty: ptr = driver_c_new_string_export(0)
        if empty == nil:
            return ""
        return empty
    let out: ptr = cheng_string_copy(data, len)
    if out == nil:
        return ""
    return out

