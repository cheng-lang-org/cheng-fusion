fn driver_c_str_eq_bridge_export(a: str, b: str): int32 =
    let lenA: int32 = cheng_str_len(a)
    let lenB: int32 = cheng_str_len(b)
    if lenA != lenB:
        return 0
    if lenA <= 0:
        return 1
    if cheng_bytes_equal(cheng_str_data(a), cheng_str_data(b), lenA):
        return 1
    return 0

