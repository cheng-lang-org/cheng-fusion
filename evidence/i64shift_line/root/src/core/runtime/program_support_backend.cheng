@exportc("cheng_fflush")
fn cheng_fflush_export(stream: ptr): int32 =
    # fd-as-ptr sentinels (stdout=1, stderr=2) are raw fds with no libc
    # buffer: fflush on them crashes flockfile (fd passed as FILE*).  Raw
    # fds are already unbuffered, so flushing is a no-op success — mirror
    # the guard that cheng_fwrite_export already applies.
    if uint64(stream) == uint64(1) || uint64(stream) == uint64(2):
        return 0
    return libc_fflush(stream)

