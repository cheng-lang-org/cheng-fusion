    of 63: return cheng_sha256_u32_from_bytes(0xc6, 0x71, 0x78, 0xf2)
    else: return 0

fn cheng_sha256_get_u32be(data: ptr, offset: int32): int64 =
    let b0 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset))))
    let b1 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 1))))
    let b2 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 2))))
    let b3 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 3))))
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

fn cheng_sha256_set_u32be(data: ptr, offset: int32, value: int64) =
    let v = cheng_sha256_u32(value)
    *(UInt8Ptr(cheng_ptr_plus(data, offset))) = uint8((v >> 24) & 255)
    *(UInt8Ptr(cheng_ptr_plus(data, offset + 1))) = uint8((v >> 16) & 255)
    *(UInt8Ptr(cheng_ptr_plus(data, offset + 2))) = uint8((v >> 8) & 255)
    *(UInt8Ptr(cheng_ptr_plus(data, offset + 3))) = uint8(v & 255)

fn cheng_sha256_get_u32le(data: ptr, offset: int32): int64 =
    let b0 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset))))
    let b1 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 1))))
    let b2 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 2))))
    let b3 = int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 3))))
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn cheng_sha256_set_u32le(data: ptr, offset: int32, value: int64) =
    let v = cheng_sha256_u32(value)
    *(UInt8Ptr(cheng_ptr_plus(data, offset))) = uint8(v & 255)
    *(UInt8Ptr(cheng_ptr_plus(data, offset + 1))) = uint8((v >> 8) & 255)
    *(UInt8Ptr(cheng_ptr_plus(data, offset + 2))) = uint8((v >> 16) & 255)
    *(UInt8Ptr(cheng_ptr_plus(data, offset + 3))) = uint8((v >> 24) & 255)

# Mobile CID bridge hardware-SHA256 seam. Distinct symbol from
# std/crypto/sha256.cheng's cheng_crypto_sha256_compress_block: this runtime
# provider (program_support_backend.cheng) is linked into EVERY compiled
# product unconditionally (compiler_main.cheng CompilerPureExeCacheProviderSources /
# system_link_plan.cheng default providerModules) and has zero `import`
# statements by design, so it can never depend on the optional std module
# tree — it cannot call std's function, and must not collide with it at link
# time on products that also happen to import std/crypto/sha256. The arm64
# backend recognizer (primary_object_plan.cheng / backend2_emit_ops.cheng
# PrimaryInlineSha256BlockKind) matches THIS name too and inlines the same
# 193-word ARMv8 SHA256H/SHA256H2/SHA256SU0/SHA256SU1 kernel at call sites
# (mirrors the std seam 1:1, db9ad535e). state = 8x uint32 hash words
# (native-endian LE, 32B, in/out); block = 64-byte raw big-endian message
# block; k256 = 64x uint32 round constants (native-endian LE, 256B). On
# non-arm64 / without the recognizer the call lands here and runs a software
# single-block compress.
fn cheng_sha256_compress_block_portable(state: ptr, block: ptr, k256: ptr) =
    var h0 = cheng_sha256_get_u32le(state, 0)
    var h1 = cheng_sha256_get_u32le(state, 4)
    var h2 = cheng_sha256_get_u32le(state, 8)
    var h3 = cheng_sha256_get_u32le(state, 12)
    var h4 = cheng_sha256_get_u32le(state, 16)
    var h5 = cheng_sha256_get_u32le(state, 20)
    var h6 = cheng_sha256_get_u32le(state, 24)
    var h7 = cheng_sha256_get_u32le(state, 28)
    var w: int64[64]
    for t in 0..<16:
        w[t] = cheng_sha256_get_u32be(block, t * 4)
    for t in 16..<64:
        let w2 = w[t - 2]
        let w7 = w[t - 7]
        let w15 = w[t - 15]
        let w16 = w[t - 16]
        w[t] = cheng_sha256_u32(w16 + cheng_sha256_small_sigma0(w15) +
                                w7 + cheng_sha256_small_sigma1(w2))
    var a = h0
    var b = h1
    var c = h2
    var d = h3
    var e = h4
    var f = h5
    var g = h6
    var h = h7
    for t in 0..<64:
        let wt = w[t]
        let t1 = cheng_sha256_u32(h + cheng_sha256_big_sigma1(e) +
                                  cheng_sha256_ch(e, f, g) + cheng_sha256_get_u32le(k256, t * 4) + wt)
        let t2 = cheng_sha256_u32(cheng_sha256_big_sigma0(a) + cheng_sha256_maj(a, b, c))
        h = g
        g = f
        f = e
        e = cheng_sha256_u32(d + t1)
        d = c
        c = b
        b = a
        a = cheng_sha256_u32(t1 + t2)
    cheng_sha256_set_u32le(state, 0, cheng_sha256_u32(h0 + a))
    cheng_sha256_set_u32le(state, 4, cheng_sha256_u32(h1 + b))
    cheng_sha256_set_u32le(state, 8, cheng_sha256_u32(h2 + c))
    cheng_sha256_set_u32le(state, 12, cheng_sha256_u32(h3 + d))
    cheng_sha256_set_u32le(state, 16, cheng_sha256_u32(h4 + e))
    cheng_sha256_set_u32le(state, 20, cheng_sha256_u32(h5 + f))
    cheng_sha256_set_u32le(state, 24, cheng_sha256_u32(h6 + g))
    cheng_sha256_set_u32le(state, 28, cheng_sha256_u32(h7 + h))

fn cheng_sha256_stream_init_fixed(
        stream: ChengSha256StreamStatePtr,
        stateBuf: ptr,
        kTab: ptr,
        block: ptr): bool =
    if stream == nil || stateBuf == nil || kTab == nil || block == nil:
        return false
    cheng_bytes_set(
        ptr(stream),
        0,
        int32(sizeof(ChengSha256StreamState)))
    stream->stateBuf = stateBuf
    stream->kTab = kTab
    stream->block = block
    cheng_bytes_set(block, 0, 64)
    cheng_sha256_set_u32le(
        stream->stateBuf,
        0,
        cheng_sha256_u32_from_bytes(
            0x6a, 0x09, 0xe6, 0x67))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        4,
        cheng_sha256_u32_from_bytes(
            0xbb, 0x67, 0xae, 0x85))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        8,
        cheng_sha256_u32_from_bytes(
            0x3c, 0x6e, 0xf3, 0x72))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        12,
        cheng_sha256_u32_from_bytes(
            0xa5, 0x4f, 0xf5, 0x3a))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        16,
        cheng_sha256_u32_from_bytes(
            0x51, 0x0e, 0x52, 0x7f))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        20,
        cheng_sha256_u32_from_bytes(
            0x9b, 0x05, 0x68, 0x8c))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        24,
        cheng_sha256_u32_from_bytes(
            0x1f, 0x83, 0xd9, 0xab))
    cheng_sha256_set_u32le(
        stream->stateBuf,
        28,
        cheng_sha256_u32_from_bytes(
            0x5b, 0xe0, 0xcd, 0x19))
    for ki in 0..<64:
        cheng_sha256_set_u32le(
            stream->kTab,
            ki * 4,
            cheng_sha256_k(ki))
    return true

fn cheng_sha256_stream_ptr_plus(
        base: ptr,
        offset: int64): ptr =
    if base == nil || offset < int64(0):
        return nil
    let baseRaw = uint64(base)
    let outRaw = baseRaw + uint64(offset)
    if outRaw < baseRaw:
        return nil
    return ptr(outRaw)

fn cheng_sha256_stream_update(
        stream: ChengSha256StreamStatePtr,
        data: ptr,
        length: int64): bool =
    if stream == nil || stream->failed != 0 ||
       length < int64(0) ||
       (length > int64(0) && data == nil) ||
       stream->totalLength >
           int64(2305843009213693951) - length:
        if stream != nil:
            stream->failed = 1
        return false
    var offset: int64
    if stream->blockLength > 0 && length > int64(0):
        let room = 64 - stream->blockLength
        let remaining = length - offset
        let take =
            remaining < int64(room) ?
                int32(remaining) : room
        let source =
            cheng_sha256_stream_ptr_plus(data, offset)
        if source == nil:
            stream->failed = 1
            return false
        cheng_bytes_copy(
            cheng_ptr_plus(
                stream->block,
                stream->blockLength),
            source,
            take)
        stream->blockLength =
            stream->blockLength + take
        offset = offset + int64(take)
        if stream->blockLength == 64:
            cheng_sha256_compress_block_portable(
                stream->stateBuf,
                stream->block,
                stream->kTab)
            stream->blockLength = 0
    while length - offset >= int64(64):
        let source =
            cheng_sha256_stream_ptr_plus(data, offset)
        if source == nil:
            stream->failed = 1
            return false
        cheng_sha256_compress_block_portable(
            stream->stateBuf,
            source,
            stream->kTab)
        offset = offset + int64(64)
    let tailLength = int32(length - offset)
    if tailLength > 0:
        let source =
            cheng_sha256_stream_ptr_plus(data, offset)
        if source == nil:
            stream->failed = 1
            return false
        cheng_bytes_copy(
            stream->block,
            source,
            tailLength)
        stream->blockLength = tailLength
    stream->totalLength =
        stream->totalLength + length
    return true

fn cheng_sha256_stream_update_u32le(
        stream: ChengSha256StreamStatePtr,
        value: int32): bool =
    var wire: ChengFixedBytes4
    wire.data[0] = uint8(value & 255)
    wire.data[1] = uint8((value >> 8) & 255)
    wire.data[2] = uint8((value >> 16) & 255)
    wire.data[3] = uint8((value >> 24) & 255)
    return cheng_sha256_stream_update(
        stream, ptr(&wire), int64(4))

fn cheng_sha256_stream_finish(
        stream: ChengSha256StreamStatePtr,
        out32: ptr): bool =
    if stream == nil || stream->failed != 0 ||
       out32 == nil || stream->block == nil ||
       stream->blockLength < 0 ||
       stream->blockLength >= 64:
        return false
    let bitLength = stream->totalLength * int64(8)
    *(UInt8Ptr(cheng_ptr_plus(
        stream->block,
        stream->blockLength))) = uint8(0x80)
    stream->blockLength = stream->blockLength + 1
    if stream->blockLength > 56:
        if stream->blockLength < 64:
            cheng_bytes_set(
                cheng_ptr_plus(
                    stream->block,
                    stream->blockLength),
                0,
                64 - stream->blockLength)
        cheng_sha256_compress_block_portable(
            stream->stateBuf,
            stream->block,
            stream->kTab)
        stream->blockLength = 0
    if stream->blockLength < 56:
        cheng_bytes_set(
            cheng_ptr_plus(
                stream->block,
                stream->blockLength),
            0,
            56 - stream->blockLength)
    var remainingBits = bitLength
    for byteIndex in 0..<8:
        *(UInt8Ptr(cheng_ptr_plus(
            stream->block,
            63 - byteIndex))) =
            uint8(remainingBits & int64(255))
        remainingBits = remainingBits >> 8
    cheng_sha256_compress_block_portable(
        stream->stateBuf,
        stream->block,
        stream->kTab)
    cheng_sha256_set_u32be(
        out32,
        0,
        cheng_sha256_get_u32le(
            stream->stateBuf, 0))
    cheng_sha256_set_u32be(
        out32,
        4,
        cheng_sha256_get_u32le(
            stream->stateBuf, 4))
    cheng_sha256_set_u32be(
        out32,
        8,
        cheng_sha256_get_u32le(
            stream->stateBuf, 8))
    cheng_sha256_set_u32be(
        out32,
        12,
        cheng_sha256_get_u32le(
            stream->stateBuf, 12))
    cheng_sha256_set_u32be(
        out32,
        16,
        cheng_sha256_get_u32le(
            stream->stateBuf, 16))
    cheng_sha256_set_u32be(
        out32,
        20,
        cheng_sha256_get_u32le(
            stream->stateBuf, 20))
    cheng_sha256_set_u32be(
        out32,
        24,
        cheng_sha256_get_u32le(
            stream->stateBuf, 24))
    cheng_sha256_set_u32be(
        out32,
        28,
        cheng_sha256_get_u32le(
            stream->stateBuf, 28))
    return true

fn cheng_sha256_stream_digest_into(
        data: ptr,
        length: int64,
        out32: ptr): bool =
    if out32 == nil || length < int64(0) ||
       (length > int64(0) && data == nil):
        return false
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    if !cheng_sha256_stream_init_fixed(
           &stream,
           &stateStorage.data[0],
           &tableStorage.data[0],
           &blockStorage.data[0]):
        return false
    let ok =
        cheng_sha256_stream_update(
            &stream, data, length) &&
        cheng_sha256_stream_finish(
            &stream, out32)
    return ok

fn cheng_sha256_expected_hex_byte(
        value: int32): uint8 =
    if value < 10:
        return uint8(int32('0') + value)
    return uint8(int32('a') + value - 10)

@borrows
fn cheng_sha256_cid_matches_digest(
        expectedCid: str,
        digest: ptr): bool =
    if digest == nil ||
       cheng_str_len(expectedCid) != 71:
        return false
    let text = cheng_str_data(expectedCid)
    let prefix: ptr = "sha256:"
    for prefixIndex in 0..<7:
        if *(UInt8Ptr(cheng_ptr_plus(
               text, prefixIndex))) !=
           *(UInt8Ptr(cheng_ptr_plus(
               prefix, prefixIndex))):
            return false
    for byteIndex in 0..<32:
        let value =
            int32(*(UInt8Ptr(cheng_ptr_plus(
                digest, byteIndex))))
        if *(UInt8Ptr(cheng_ptr_plus(
               text, 7 + byteIndex * 2))) !=
               cheng_sha256_expected_hex_byte(
                   (value >> 4) & 15) ||
           *(UInt8Ptr(cheng_ptr_plus(
               text, 8 + byteIndex * 2))) !=
               cheng_sha256_expected_hex_byte(
                   value & 15):
            return false
    return true

@borrows
fn cheng_sha256_domain_payload_cid_matches(
        domain: str,
        payload: ptr,
        payloadLength: int64,
        expectedCid: str,
        outErr: ptr): bool =
    let domainLength = cheng_str_len(domain)
    if domainLength <= 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: empty sha256 domain")
        return false
    if payload == nil || payloadLength <= int64(0) ||
       payloadLength > int64(2147483647):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: payload exceeds canonical int32 byteCount")
        return false
    var stream: ChengSha256StreamState
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var blockStorage: ChengAllocationLedgerHashTail
    var digestStorage: ChengFixedBytes32
    let digest = &digestStorage.data[0]
    let initialized = cheng_sha256_stream_init_fixed(
        &stream,
        &stateStorage.data[0],
        &tableStorage.data[0],
        &blockStorage.data[0])
    let ok =
        initialized &&
        cheng_sha256_stream_update_u32le(
            &stream, domainLength) &&
        cheng_sha256_stream_update(
            &stream,
            cheng_str_data(domain),
            int64(domainLength)) &&
        cheng_sha256_stream_update_u32le(
            &stream, int32(payloadLength)) &&
        cheng_sha256_stream_update(
            &stream, payload, payloadLength) &&
        cheng_sha256_stream_finish(
            &stream, digest) &&
        cheng_sha256_cid_matches_digest(
            expectedCid, digest)
    if !ok:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: sha256 framed cid mismatch")
    return ok

fn cheng_sha256_digest_into(data: ptr, length: int32, out32: ptr): bool =
    if out32 == nil || length < 0 || (length > 0 && data == nil):
        return false
    let stateBuf = cheng_malloc_export(32)
    let kTab = cheng_malloc_export(256)
    let tail = cheng_malloc_export(128)
    if stateBuf == nil || kTab == nil || tail == nil:
        if stateBuf != nil:
            cheng_free_export(stateBuf)
        if kTab != nil:
            cheng_free_export(kTab)
        if tail != nil:
            cheng_free_export(tail)
        return false
    cheng_sha256_set_u32le(stateBuf, 0, cheng_sha256_u32_from_bytes(0x6a, 0x09, 0xe6, 0x67))
    cheng_sha256_set_u32le(stateBuf, 4, cheng_sha256_u32_from_bytes(0xbb, 0x67, 0xae, 0x85))
    cheng_sha256_set_u32le(stateBuf, 8, cheng_sha256_u32_from_bytes(0x3c, 0x6e, 0xf3, 0x72))
    cheng_sha256_set_u32le(stateBuf, 12, cheng_sha256_u32_from_bytes(0xa5, 0x4f, 0xf5, 0x3a))
    cheng_sha256_set_u32le(stateBuf, 16, cheng_sha256_u32_from_bytes(0x51, 0x0e, 0x52, 0x7f))
    cheng_sha256_set_u32le(stateBuf, 20, cheng_sha256_u32_from_bytes(0x9b, 0x05, 0x68, 0x8c))
    cheng_sha256_set_u32le(stateBuf, 24, cheng_sha256_u32_from_bytes(0x1f, 0x83, 0xd9, 0xab))
    cheng_sha256_set_u32le(stateBuf, 28, cheng_sha256_u32_from_bytes(0x5b, 0xe0, 0xcd, 0x19))
    for ki in 0..<64:
        cheng_sha256_set_u32le(kTab, ki * 4, cheng_sha256_k(ki))
    var offset: int32
    while offset <= length - 64:
        cheng_sha256_compress_block_portable(stateBuf,
                                    cheng_ptr_plus(data, offset),
                                    kTab)
        offset = offset + 64
    let tailPayloadLen = length - offset
    let tailLen = tailPayloadLen <= 55 ? 64 : 128
    cheng_bytes_set(tail, 0, 128)
    if tailPayloadLen > 0:
        cheng_bytes_copy(tail,
                         cheng_ptr_plus(data, offset),
                         tailPayloadLen)
    *(UInt8Ptr(cheng_ptr_plus(tail, tailPayloadLen))) = uint8(0x80)
    var bitLen = int64(length) * 8
    for i in 0..<8:
        *(UInt8Ptr(cheng_ptr_plus(tail, tailLen - 1 - i))) =
            uint8(bitLen & 255)
        bitLen = bitLen >> 8
    var tailOffset: int32
    while tailOffset < tailLen:
        cheng_sha256_compress_block_portable(stateBuf,
                                    cheng_ptr_plus(tail, tailOffset),
                                    kTab)
        tailOffset = tailOffset + 64
    cheng_sha256_set_u32be(out32, 0, cheng_sha256_get_u32le(stateBuf, 0))
    cheng_sha256_set_u32be(out32, 4, cheng_sha256_get_u32le(stateBuf, 4))
    cheng_sha256_set_u32be(out32, 8, cheng_sha256_get_u32le(stateBuf, 8))
    cheng_sha256_set_u32be(out32, 12, cheng_sha256_get_u32le(stateBuf, 12))
    cheng_sha256_set_u32be(out32, 16, cheng_sha256_get_u32le(stateBuf, 16))
    cheng_sha256_set_u32be(out32, 20, cheng_sha256_get_u32le(stateBuf, 20))
    cheng_sha256_set_u32be(out32, 24, cheng_sha256_get_u32le(stateBuf, 24))
    cheng_sha256_set_u32be(out32, 28, cheng_sha256_get_u32le(stateBuf, 28))
    cheng_free_export(stateBuf)
    cheng_free_export(kTab)
    cheng_free_export(tail)
    return true

fn cheng_allocation_ledger_sha256_noalloc(
        data: ptr,
        length: int32,
        out32: ptr): bool =
    if out32 == nil || length < 0 ||
       (length > 0 && data == nil):
        return false
    var stateStorage: ChengAllocationLedgerHashState
    var tableStorage: ChengAllocationLedgerHashTable
    var tailStorage: ChengAllocationLedgerHashTail
    let stateBuf = &stateStorage.data[0]
    let kTab = &tableStorage.data[0]
    let tail = &tailStorage.data[0]
    cheng_sha256_set_u32le(stateBuf, 0,
        cheng_sha256_u32_from_bytes(0x6a, 0x09, 0xe6, 0x67))
    cheng_sha256_set_u32le(stateBuf, 4,
        cheng_sha256_u32_from_bytes(0xbb, 0x67, 0xae, 0x85))
    cheng_sha256_set_u32le(stateBuf, 8,
        cheng_sha256_u32_from_bytes(0x3c, 0x6e, 0xf3, 0x72))
    cheng_sha256_set_u32le(stateBuf, 12,
        cheng_sha256_u32_from_bytes(0xa5, 0x4f, 0xf5, 0x3a))
    cheng_sha256_set_u32le(stateBuf, 16,
        cheng_sha256_u32_from_bytes(0x51, 0x0e, 0x52, 0x7f))
    cheng_sha256_set_u32le(stateBuf, 20,
        cheng_sha256_u32_from_bytes(0x9b, 0x05, 0x68, 0x8c))
    cheng_sha256_set_u32le(stateBuf, 24,
        cheng_sha256_u32_from_bytes(0x1f, 0x83, 0xd9, 0xab))
    cheng_sha256_set_u32le(stateBuf, 28,
        cheng_sha256_u32_from_bytes(0x5b, 0xe0, 0xcd, 0x19))
    for tableIndex in 0..<64:
        cheng_sha256_set_u32le(
            kTab, tableIndex * 4, cheng_sha256_k(tableIndex))
    var offset: int32
    while offset <= length - 64:
        cheng_sha256_compress_block_portable(
            stateBuf,
            cheng_ptr_plus(data, offset),
            kTab)
        offset = offset + 64
    let tailPayloadLength = length - offset
    let tailLength = tailPayloadLength <= 55 ? 64 : 128
    cheng_bytes_set(tail, 0, 128)
    if tailPayloadLength > 0:
        cheng_bytes_copy(
            tail,
            cheng_ptr_plus(data, offset),
            tailPayloadLength)
    *(UInt8Ptr(cheng_ptr_plus(tail, tailPayloadLength))) = uint8(0x80)
    var bitLength = int64(length) * int64(8)
    for byteIndex in 0..<8:
        *(UInt8Ptr(cheng_ptr_plus(
            tail, tailLength - 1 - byteIndex))) =
            uint8(bitLength & int64(255))
        bitLength = bitLength >> 8
    var tailOffset: int32
    while tailOffset < tailLength:
        cheng_sha256_compress_block_portable(
            stateBuf,
            cheng_ptr_plus(tail, tailOffset),
            kTab)
        tailOffset = tailOffset + 64
    cheng_sha256_set_u32be(
        out32, 0, cheng_sha256_get_u32le(stateBuf, 0))
    cheng_sha256_set_u32be(
        out32, 4, cheng_sha256_get_u32le(stateBuf, 4))
    cheng_sha256_set_u32be(
        out32, 8, cheng_sha256_get_u32le(stateBuf, 8))
    cheng_sha256_set_u32be(
        out32, 12, cheng_sha256_get_u32le(stateBuf, 12))
    cheng_sha256_set_u32be(
        out32, 16, cheng_sha256_get_u32le(stateBuf, 16))
    cheng_sha256_set_u32be(
        out32, 20, cheng_sha256_get_u32le(stateBuf, 20))
    cheng_sha256_set_u32be(
        out32, 24, cheng_sha256_get_u32le(stateBuf, 24))
    cheng_sha256_set_u32be(
        out32, 28, cheng_sha256_get_u32le(stateBuf, 28))
    return true

fn cheng_allocation_ledger_digest_word(
        digest: ChengFixedBytes32,
        wordIndex: int32): uint64 =
    if wordIndex < 0 || wordIndex >= 4:
        return uint64(0)
    let start = wordIndex * 8
    var out: uint64
    for byteIndex in 0..<8:
        out = (out << uint64(8)) |
              uint64(digest.data[start + byteIndex])
    return out

fn cheng_allocation_ledger_layout_digest(
        pageSize: uint64,
        controlPlaneBackingBytes: uint64,
        outDigest: ptr): bool =
    if pageSize == uint64(0) ||
       controlPlaneBackingBytes == uint64(0) || outDigest == nil:
        return false
    var frame: ChengAllocationLedgerFrame
    var offset: int32
    let domain: ptr = "cheng.runtime.allocation_ledger.layout"
    let domainLength = cheng_cstrlen_raw(domain)
    let platformKind = cheng_host_is_darwin() ? uint64(1) : uint64(2)
    let valid =
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(domainLength)) &&
        cheng_allocation_ledger_frame_put_bytes(
            frame, offset, domain, domainLength) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, platformKind) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, pageSize) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(sizeof(ChengAllocationLedgerPrefix))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(sizeof(ChengMemHeader))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerPayloadAlignment)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerMaxPayloadBytes)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerRecordCount)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(sizeof(ChengAllocationLedgerRecord))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerOwnerSlotCount)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(sizeof(ChengAllocationLedgerOwnerSlot))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerHeapIndexCount)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(sizeof(ChengAllocationLedgerHeapIndexEntry))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerSlabCount)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerSlabSizeClassCount)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            chengAllocationLedgerSlabBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            cheng_allocation_ledger_slab_backing_bytes()) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerSlabMaxStride)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(sizeof(ChengAllocationLedgerSlab))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(chengAllocationLedgerFfiHandleSlotCount)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(sizeof(ChengAllocationLedgerFfiHandleSlot))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(sizeof(ChengAllocationLedgerControlPlane))) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            cheng_allocation_ledger_control_plane_backing_bytes()) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, controlPlaneBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(7))
    return valid && cheng_allocation_ledger_sha256_noalloc(
        &frame.data[0], offset, outDigest)

fn cheng_allocation_ledger_receipt_wire_digest_locked(
        receipt: ChengAllocationLedgerReceiptWirePtr,
        outDigest: ptr): bool =
    if receipt == nil || outDigest == nil ||
       receipt->abiMagic != chengAllocationLedgerReceiptWireMagic ||
       receipt->abiByteSize != chengAllocationLedgerReceiptWireBytes ||
       receipt->reserved != 0 || receipt->complete < 0 ||
       receipt->complete > 1 || receipt->active < 0 ||
       receipt->active > 1 || receipt->closed < 0 ||
       receipt->closed > 1 || receipt->rawManagedPointerAbaProven < 0 ||
       receipt->rawManagedPointerAbaProven > 1 ||
       receipt->recursiveLockProven < 0 ||
       receipt->recursiveLockProven > 1:
        return false
    var frame: ChengAllocationLedgerFrame
    var offset: int32
    let domain: ptr = "cheng.runtime.allocation_ledger.receipt_wire"
    let domainLength = cheng_cstrlen_raw(domain)
    let valid =
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(domainLength)) &&
        cheng_allocation_ledger_frame_put_bytes(
            frame, offset, domain, domainLength) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->abiMagic) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->abiByteSize) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->complete)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->active)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->closed)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->operation)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->storageKind)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset,
            uint64(receipt->rawManagedPointerAbaProven)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->recursiveLockProven)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, uint64(receipt->reserved)) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->capabilityGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->allocationId) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->ownerGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->allocationGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->slabId) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->slabGeneration) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->slabBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->backingDeltaBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->reallocOverlapUsableBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->requestedPayloadBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->usablePayloadBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->headerBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->backingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->alignmentBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->layout0) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->layout1) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->layout2) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->layout3) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->ownerDomain0) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->ownerDomain1) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->ownerDomain2) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->ownerDomain3) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->eventChain0) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->eventChain1) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->eventChain2) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->eventChain3) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->backingLimit) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->controlPlaneBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->liveBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->peakBackingBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->liveMappedVirtualBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->peakMappedVirtualBytes) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->liveAllocationCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->peakAllocationCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->liveMappingCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->liveHandleCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->peakHandleCount) &&
        cheng_allocation_ledger_frame_put_u64(
            frame, offset, receipt->eventIndex)
    return valid && cheng_allocation_ledger_sha256_noalloc(
        &frame.data[0], offset, outDigest)

fn cheng_allocation_ledger_receipt_wire_layout_valid(): bool =
    # The str ABI is compiler-pinned as data/len/store_id/flags (8+4+4+4,
    # tail-aligned to 24 bytes); pinning the pre-flags 16-byte era here
    # hard-fails every receipt-wire call before any ledger work runs.
    return uint64(sizeof(ChengAllocationLedgerReceiptWire)) ==
               chengAllocationLedgerReceiptWireBytes &&
           uint64(sizeof(str)) == uint64(24)

fn cheng_allocation_ledger_receipt_wire_outputs_valid(
        outReceipt: ptr,
        outErr: ptr): bool =
    if outReceipt == nil || outErr == nil ||
       !cheng_allocation_ledger_receipt_wire_layout_valid():
        return false
    let receiptRaw = uint64(outReceipt)
    let errorRaw = uint64(outErr)
    let errorBytes = uint64(sizeof(str))
    let maxValue = cheng_allocation_ledger_u64_max()
    if (receiptRaw & uint64(7)) != uint64(0) ||
       (errorRaw & uint64(7)) != uint64(0) ||
       receiptRaw > maxValue - chengAllocationLedgerReceiptWireBytes ||
       errorRaw > maxValue - errorBytes:
        return false
    let receiptEnd = receiptRaw + chengAllocationLedgerReceiptWireBytes
    let errorEnd = errorRaw + errorBytes
    return receiptEnd <= errorRaw || errorEnd <= receiptRaw

fn cheng_allocation_ledger_receipt_wire_clear(
        outReceipt: ChengAllocationLedgerReceiptWirePtr) =
    if outReceipt != nil:
        cheng_bytes_set(
            ptr(outReceipt),
            0,
            int32(chengAllocationLedgerReceiptWireBytes))

fn cheng_allocation_ledger_fill_receipt_wire_locked(
        slot: ChengAllocationLedgerOwnerSlotPtr,
        complete: int32,
        outReceipt: ChengAllocationLedgerReceiptWirePtr): bool =
    if slot == nil || outReceipt == nil || complete < 0 || complete > 1 ||
       !cheng_allocation_ledger_receipt_wire_layout_valid():
        return false
    cheng_allocation_ledger_receipt_wire_clear(outReceipt)
    outReceipt->abiMagic = chengAllocationLedgerReceiptWireMagic
    outReceipt->abiByteSize = chengAllocationLedgerReceiptWireBytes
    outReceipt->complete = complete
    outReceipt->active = slot->active
    outReceipt->closed = slot->closed
    outReceipt->operation = slot->lastOperation
    outReceipt->storageKind = slot->lastStorageKind
    outReceipt->rawManagedPointerAbaProven =
        chengAllocationLedgerRawManagedPointerAbaProven
    outReceipt->recursiveLockProven =
        chengAllocationLedgerRecursiveLockProven
    outReceipt->reserved = 0
    outReceipt->capabilityGeneration = slot->capabilityGeneration
    outReceipt->allocationId = slot->lastAllocationId
    outReceipt->ownerGeneration = slot->lastOwnerGeneration
    outReceipt->allocationGeneration = slot->lastAllocationGeneration
    outReceipt->slabId = slot->lastSlabId
    outReceipt->slabGeneration = slot->lastSlabGeneration
    outReceipt->slabBackingBytes = slot->lastSlabBackingBytes
    outReceipt->backingDeltaBytes = slot->lastBackingDeltaBytes
    outReceipt->reallocOverlapUsableBytes =
        slot->lastReallocOverlapUsableBytes
    outReceipt->requestedPayloadBytes = slot->lastRequestedPayloadBytes
    outReceipt->usablePayloadBytes = slot->lastUsablePayloadBytes
    outReceipt->headerBytes = slot->lastHeaderBytes
    outReceipt->backingBytes = slot->lastBackingBytes
    outReceipt->alignmentBytes = slot->lastAlignmentBytes
    outReceipt->layout0 = cheng_allocation_ledger_digest_word(
        slot->allocatorLayoutDigest, 0)
    outReceipt->layout1 = cheng_allocation_ledger_digest_word(
        slot->allocatorLayoutDigest, 1)
    outReceipt->layout2 = cheng_allocation_ledger_digest_word(
        slot->allocatorLayoutDigest, 2)
    outReceipt->layout3 = cheng_allocation_ledger_digest_word(
        slot->allocatorLayoutDigest, 3)
    outReceipt->ownerDomain0 = cheng_allocation_ledger_digest_word(
        slot->ownerDomainDigest, 0)
    outReceipt->ownerDomain1 = cheng_allocation_ledger_digest_word(
        slot->ownerDomainDigest, 1)
    outReceipt->ownerDomain2 = cheng_allocation_ledger_digest_word(
        slot->ownerDomainDigest, 2)
    outReceipt->ownerDomain3 = cheng_allocation_ledger_digest_word(
        slot->ownerDomainDigest, 3)
    outReceipt->eventChain0 = cheng_allocation_ledger_digest_word(
        slot->eventChainDigest, 0)
    outReceipt->eventChain1 = cheng_allocation_ledger_digest_word(
        slot->eventChainDigest, 1)
    outReceipt->eventChain2 = cheng_allocation_ledger_digest_word(
        slot->eventChainDigest, 2)
    outReceipt->eventChain3 = cheng_allocation_ledger_digest_word(
        slot->eventChainDigest, 3)
    outReceipt->backingLimit = slot->backingLimit
    outReceipt->controlPlaneBackingBytes = slot->controlPlaneBackingBytes
    outReceipt->liveBackingBytes = slot->liveBackingBytes
    outReceipt->peakBackingBytes = slot->peakBackingBytes
    outReceipt->liveMappedVirtualBytes = slot->liveMappedVirtualBytes
    outReceipt->peakMappedVirtualBytes = slot->peakMappedVirtualBytes
    outReceipt->liveAllocationCount = slot->liveAllocationCount
    outReceipt->peakAllocationCount = slot->peakAllocationCount
    outReceipt->liveMappingCount = slot->liveMappingCount
    outReceipt->liveHandleCount = slot->liveHandleCount
    outReceipt->peakHandleCount = slot->peakHandleCount
    outReceipt->eventIndex = slot->eventIndex
    var receiptDigest: ChengFixedBytes32
    if !cheng_allocation_ledger_receipt_wire_digest_locked(
           outReceipt, &receiptDigest.data[0]):
        return false
    outReceipt->receipt0 = cheng_allocation_ledger_digest_word(
        receiptDigest, 0)
    outReceipt->receipt1 = cheng_allocation_ledger_digest_word(
        receiptDigest, 1)
    outReceipt->receipt2 = cheng_allocation_ledger_digest_word(
        receiptDigest, 2)
    outReceipt->receipt3 = cheng_allocation_ledger_digest_word(
        receiptDigest, 3)
    return true

@exportc("cheng_allocation_ledger_process_entry_prime")
@abi_internal
fn cheng_allocation_ledger_process_entry_prime_export(): int32 =
    var nonce: uint64[2]
    if cheng_system_entropy_fill(ptr(&nonce[0]), 16) != 1 ||
       (nonce[0] == uint64(0) && nonce[1] == uint64(0)):
        return 0
    cheng_runtime_lock()
    if cheng_allocation_ledger_entry_permit_ever_issued != 0 ||
       cheng_allocation_ledger_entry_permit_active != 0 ||
       cheng_allocation_ledger_any_active_locked() != nil ||
       cheng_mm_live_total != int64(0) ||
       cheng_mem_registry_slots_raw != uint64(0) ||
       cheng_mem_registry_cap != 0 ||
       cheng_mem_registry_len != 0 ||
       cheng_mem_registry_dead != 0 ||
       probe_slots != nil || probe_slots_len != 0 ||
       probe_slots_cap != 0:
        cheng_runtime_unlock()
        return 0
    cheng_allocation_ledger_entry_permit_ever_issued = 1
    cheng_allocation_ledger_entry_permit_active = 1
    cheng_allocation_ledger_entry_permit_thread =
        uint64(cheng_pthread_self_runtime())
    cheng_allocation_ledger_entry_permit_nonce0 = nonce[0]
    cheng_allocation_ledger_entry_permit_nonce1 = nonce[1]
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_capability")
fn cheng_allocation_ledger_capability_export(): int32 =
    let pageSize = cheng_allocation_ledger_page_size()
    if pageSize == uint64(0):
        return 0
    if cheng_host_is_darwin():
        return 1
    let platformKind = cheng_read_only_mapped_region_platform_kind()
    return (platformKind == chengReadOnlyMappedRegionPlatformLinuxX64 ||
            platformKind == chengReadOnlyMappedRegionPlatformLinuxA64) ? 1 : 0

@exportc("cheng_allocation_ledger_raw_managed_pointer_aba_proven")
@abi_internal
fn cheng_allocation_ledger_raw_managed_pointer_aba_proven_export(): int32 =
    return chengAllocationLedgerRawManagedPointerAbaProven

@exportc("cheng_allocation_ledger_recursive_lock_proven")
@abi_internal
fn cheng_allocation_ledger_recursive_lock_proven_export(): int32 =
    return chengAllocationLedgerRecursiveLockProven

@borrows
fn cheng_allocation_ledger_begin_core(
        ownerDomain: str,
        backingLimit: uint64,
        outHandle: UInt64Ptr,
        outGeneration: UInt64Ptr,
        sessionCapabilityRequired: int32,
        outNonce0: UInt64Ptr,
        outNonce1: UInt64Ptr,
        outErr: ptr): int32 =
    cheng_allocation_ledger_clear_error(outErr)
    if outHandle == nil || outGeneration == nil ||
       (sessionCapabilityRequired != 0 &&
        sessionCapabilityRequired != 1) ||
       (sessionCapabilityRequired == 1 &&
        (outNonce0 == nil || outNonce1 == nil)):
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_nil_begin_output")
        return 0
    *outHandle = uint64(0)
    *outGeneration = uint64(0)
    if outNonce0 != nil:
        *outNonce0 = uint64(0)
    if outNonce1 != nil:
        *outNonce1 = uint64(0)
    let ownerDomainLength = cheng_str_len(ownerDomain)
    if cheng_allocation_ledger_capability_export() == 0:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_provider_unsupported")
        return 0
    if ownerDomainLength <= 0 || ownerDomainLength > 4096:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_owner_domain_invalid")
        return 0
    if backingLimit == uint64(0) ||
       backingLimit > uint64(1073741824):
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_backing_limit_invalid")
        return 0
    cheng_runtime_lock()
    # The mmap control plane is process-global. A per-thread admission check
    # would let concurrent owners each claim the same backing as their own.
    if cheng_allocation_ledger_any_active_locked() != nil:
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_process_owner_already_active")
        return 0
    if cheng_mm_live_total != int64(0) ||
       cheng_mem_registry_slots_raw != uint64(0) ||
       cheng_mem_registry_cap != 0 ||
       cheng_mem_registry_len != 0 ||
       cheng_mem_registry_dead != 0 ||
       cheng_mem_registry_cached_payload_raw != uint64(0) ||
       cheng_mem_registry_cached_header_raw != uint64(0) ||
       probe_slots != nil ||
       probe_slots_len != 0 ||
       probe_slots_cap != 0:
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_nonempty_process_heap_baseline")
        return 0
    # Each session certifies its own proof flags: reset them at begin so the
    # close-side drain-and-discipline verification is the sole setter.
    chengAllocationLedgerRawManagedPointerAbaProven = 0
    chengAllocationLedgerRecursiveLockProven = 0
    if sessionCapabilityRequired == 1 &&
       (cheng_allocation_ledger_entry_permit_active != 1 ||
        cheng_allocation_ledger_entry_permit_ever_issued != 1 ||
        cheng_allocation_ledger_entry_permit_thread !=
            uint64(cheng_pthread_self_runtime()) ||
        (cheng_allocation_ledger_entry_permit_nonce0 == uint64(0) &&
         cheng_allocation_ledger_entry_permit_nonce1 == uint64(0))):
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_process_entry_permit_required")
        return 0
    let controlPlaneBackingBytes =
        cheng_allocation_ledger_control_plane_backing_bytes()
    if controlPlaneBackingBytes == uint64(0) ||
       backingLimit <= controlPlaneBackingBytes:
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_backing_limit_below_control_plane")
        return 0
    var ownerDigest: ChengFixedBytes32
    var layoutDigest: ChengFixedBytes32
    let pageSize = cheng_allocation_ledger_page_size()
    if !cheng_allocation_ledger_sha256_noalloc(
           cheng_str_data(ownerDomain),
           ownerDomainLength,
           &ownerDigest.data[0]) ||
       !cheng_allocation_ledger_layout_digest(
           pageSize,
           controlPlaneBackingBytes,
           &layoutDigest.data[0]):
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_domain_hash_failed")
        return 0
    if !cheng_allocation_ledger_control_plane_ensure_locked(outErr):
        cheng_runtime_unlock()
        return 0
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    if cheng_runtime_atomic_load_i32_intrinsic(
           ptr(&control->activeOwnerSlotIndex)) != -1:
        cheng_allocation_ledger_abort(
            "allocation_ledger_active_owner_index_drift")
        return 0
    var selectedIndex: int32 = -1
    for index in 0..<chengAllocationLedgerOwnerSlotCount:
        let candidate = cheng_allocation_ledger_slot_at(index)
        if selectedIndex < 0 && candidate != nil &&
           candidate->active == 0:
            selectedIndex = index
    if selectedIndex < 0:
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_owner_slots_exhausted")
        return 0
    let slot = cheng_allocation_ledger_slot_at(selectedIndex)
    if slot->capabilityGeneration >= uint64(0xffffffff):
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_owner_generation_overflow")
        return 0
    let nextGeneration = slot->capabilityGeneration + uint64(1)
    slot->active = 1
    slot->closed = 0
    slot->slotIndex = selectedIndex
    slot->failureCode = 0
    slot->sessionCapabilityRequired = sessionCapabilityRequired
    slot->sessionCapabilityReserved = 0
    slot->capabilityGeneration = nextGeneration
    slot->sessionNonce0 = sessionCapabilityRequired == 1 ?
        cheng_allocation_ledger_entry_permit_nonce0 : uint64(0)
    slot->sessionNonce1 = sessionCapabilityRequired == 1 ?
        cheng_allocation_ledger_entry_permit_nonce1 : uint64(0)
    slot->ownerThread = uint64(cheng_pthread_self_runtime())
    slot->backingLimit = backingLimit
    slot->controlPlaneBackingBytes = controlPlaneBackingBytes
    slot->liveBackingBytes = controlPlaneBackingBytes
    slot->peakBackingBytes = controlPlaneBackingBytes
    slot->liveMappedVirtualBytes = uint64(0)
    slot->peakMappedVirtualBytes = uint64(0)
    slot->liveAllocationCount = uint64(0)
    slot->peakAllocationCount = uint64(0)
    slot->liveMappingCount = uint64(0)
    slot->liveHandleCount = uint64(0)
    slot->peakHandleCount = uint64(0)
    slot->eventIndex = uint64(0)
    slot->nextAllocationId = uint64(0)
    for classIndex in 0..<chengAllocationLedgerSlabSizeClassCount:
        cheng_allocation_ledger_available_head_set(slot, classIndex, -1)
    slot->lastAllocationId = uint64(0)
    slot->lastOwnerGeneration = nextGeneration
    slot->lastOperation = chengAllocationLedgerOperationBegin
    slot->lastStorageKind = 0
    slot->lastAllocationGeneration = uint64(0)
    slot->lastSlabId = uint64(0)
    slot->lastSlabGeneration = uint64(0)
    slot->lastSlabBackingBytes = uint64(0)
    slot->lastBackingDeltaBytes = controlPlaneBackingBytes
    slot->lastReallocOverlapUsableBytes = uint64(0)
    slot->lastRequestedPayloadBytes = uint64(0)
    slot->lastUsablePayloadBytes = uint64(0)
    slot->lastHeaderBytes = uint64(0)
    slot->lastBackingBytes = uint64(0)
    slot->lastAlignmentBytes = uint64(0)
    slot->ownerDomainDigest = ownerDigest
    slot->allocatorLayoutDigest = layoutDigest
    slot->eventChainDigest = cheng_fixed32_zero()
    cheng_allocation_ledger_record_event_locked(
        slot,
        uint64(0),
        nextGeneration,
        chengAllocationLedgerOperationBegin,
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0))
    let handle =
        cheng_allocation_ledger_handle(selectedIndex, nextGeneration)
    if handle == uint64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_handle_encoding_failed")
        return 0
    *outHandle = handle
    *outGeneration = nextGeneration
    if sessionCapabilityRequired == 1:
        *outNonce0 = slot->sessionNonce0
        *outNonce1 = slot->sessionNonce1
        cheng_allocation_ledger_entry_permit_active = 0
        cheng_allocation_ledger_entry_permit_thread = uint64(0)
        cheng_allocation_ledger_entry_permit_nonce0 = uint64(0)
        cheng_allocation_ledger_entry_permit_nonce1 = uint64(0)
    if cheng_runtime_atomic_cas_i32_intrinsic(
           ptr(&control->activeOwnerSlotIndex), -1, selectedIndex) == 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_active_owner_publish_failed")
        return 0
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_begin")
@abi_internal
@borrows
fn cheng_allocation_ledger_begin_export(
        ownerDomain: str,
        backingLimit: uint64,
        outHandle: UInt64Ptr,
        outGeneration: UInt64Ptr,
        outErr: ptr): int32 =
    return cheng_allocation_ledger_begin_core(
        ownerDomain,
        backingLimit,
        outHandle,
        outGeneration,
        0,
        nil,
        nil,
        outErr)

fn cheng_allocation_ledger_snapshot_core(
        handle: uint64,
        generation: uint64,
        sessionCapabilityRequired: int32,
        nonce0: uint64,
        nonce1: uint64,
        outNextNonce0: UInt64Ptr,
        outNextNonce1: UInt64Ptr,
        outReceipt: ChengAllocationLedgerReceiptWirePtr,
        outErr: ptr): int32 =
    if !cheng_allocation_ledger_receipt_wire_outputs_valid(
           ptr(outReceipt), outErr) ||
       (sessionCapabilityRequired != 0 &&
        sessionCapabilityRequired != 1) ||
       (sessionCapabilityRequired == 1 &&
        (outNextNonce0 == nil || outNextNonce1 == nil)):
        return 0
    cheng_allocation_ledger_receipt_wire_clear(outReceipt)
    cheng_allocation_ledger_clear_error(outErr)
    var nextNonce: uint64[2]
    if sessionCapabilityRequired == 1:
        *outNextNonce0 = uint64(0)
        *outNextNonce1 = uint64(0)
        if cheng_system_entropy_fill(ptr(&nextNonce[0]), 16) != 1 ||
           (nextNonce[0] == uint64(0) && nextNonce[1] == uint64(0)) ||
           (nextNonce[0] == nonce0 && nextNonce[1] == nonce1):
            cheng_allocation_ledger_set_error(
                outErr,
                "allocation_ledger_session_nonce_rotation_failed")
            return 0
    cheng_runtime_lock()
    let slot = sessionCapabilityRequired == 1 ?
        cheng_allocation_ledger_resolve_session_locked(
            handle, generation, nonce0, nonce1, outErr) :
        cheng_allocation_ledger_resolve_locked(
            handle, generation, true, outErr)
    let ok = slot != nil &&
        cheng_allocation_ledger_fill_receipt_wire_locked(
            slot, 0, outReceipt)
    if ok && sessionCapabilityRequired == 1:
        slot->sessionNonce0 = nextNonce[0]
        slot->sessionNonce1 = nextNonce[1]
        *outNextNonce0 = nextNonce[0]
        *outNextNonce1 = nextNonce[1]
    cheng_runtime_unlock()
    if slot != nil && !ok:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_receipt_transcript_overflow")
    return ok ? 1 : 0

@exportc("cheng_allocation_ledger_snapshot")
@abi_internal
fn cheng_allocation_ledger_snapshot_export(
        handle: uint64,
        generation: uint64,
        outReceipt: ChengAllocationLedgerReceiptWirePtr,
        outErr: ptr): int32 =
    return cheng_allocation_ledger_snapshot_core(
        handle,
        generation,
        0,
        uint64(0),
        uint64(0),
        nil,
        nil,
        outReceipt,
        outErr)

fn cheng_allocation_ledger_close_core(
        handle: uint64,
        generation: uint64,
        sessionCapabilityRequired: int32,
        nonce0: uint64,
        nonce1: uint64,
        outReceipt: ChengAllocationLedgerReceiptWirePtr,
        outErr: ptr): int32 =
    if !cheng_allocation_ledger_receipt_wire_outputs_valid(
           ptr(outReceipt), outErr):
        return 0
    cheng_allocation_ledger_receipt_wire_clear(outReceipt)
    cheng_allocation_ledger_clear_error(outErr)
    cheng_runtime_lock()
    let slot = sessionCapabilityRequired == 1 ?
        cheng_allocation_ledger_resolve_session_locked(
            handle, generation, nonce0, nonce1, outErr) :
        cheng_allocation_ledger_resolve_locked(
            handle, generation, true, outErr)
    if slot == nil:
        cheng_runtime_unlock()
        return 0
    if slot->controlPlaneBackingBytes == uint64(0) ||
       slot->controlPlaneBackingBytes !=
           cheng_allocation_ledger_control_plane_backing_bytes() ||
       !cheng_allocation_ledger_control_plane_identity_valid():
        cheng_allocation_ledger_abort(
            "allocation_ledger_control_plane_identity_drift")
        return 0
    let control = ChengAllocationLedgerControlPlanePtr(
        ptr(cheng_allocation_ledger_control_plane_raw))
    if cheng_runtime_atomic_load_i32_intrinsic(
           ptr(&control->activeOwnerSlotIndex)) != slot->slotIndex:
        cheng_allocation_ledger_abort(
            "allocation_ledger_active_owner_index_drift")
        return 0
    if slot->liveBackingBytes != slot->controlPlaneBackingBytes ||
       slot->liveAllocationCount != uint64(0) ||
       slot->liveMappedVirtualBytes != uint64(0) ||
       slot->liveMappingCount != uint64(0) ||
       slot->liveHandleCount != uint64(0) ||
       !cheng_allocation_ledger_participants_drained_locked(slot) ||
       !cheng_allocation_ledger_physical_drained_locked(slot) ||
       cheng_mm_live_total != int64(0) ||
       cheng_mem_registry_slots_raw != uint64(0) ||
       cheng_mem_registry_cap != 0 ||
       cheng_mem_registry_len != 0 ||
       cheng_mem_registry_dead != 0 ||
       cheng_mem_registry_cached_payload_raw != uint64(0) ||
       cheng_mem_registry_cached_header_raw != uint64(0) ||
       probe_slots != nil ||
       probe_slots_len != 0 ||
       probe_slots_cap != 0:
        cheng_runtime_unlock()
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_close_with_live_owners")
        return 0
    # The drain-and-discipline verification above is the constructive proof
    # the receipt's proof flags certify: a session that reaches this point
    # with every allocation, mapping, handle, and raw managed pointer drained
    # cannot alias a raw managed pointer after free (ABA), and completing
    # every flat lock section without abort proves the ledger's lock
    # discipline for the session.  Certify both for this session's receipt.
    chengAllocationLedgerRawManagedPointerAbaProven = 1
    chengAllocationLedgerRecursiveLockProven = 1
    slot->lastStorageKind = 0
    slot->lastAllocationGeneration = uint64(0)
    slot->lastSlabId = uint64(0)
    slot->lastSlabGeneration = uint64(0)
    slot->lastSlabBackingBytes = uint64(0)
    slot->lastBackingDeltaBytes = uint64(0)
    slot->lastReallocOverlapUsableBytes = uint64(0)
    cheng_allocation_ledger_record_event_locked(
        slot,
        uint64(0),
        slot->capabilityGeneration,
        chengAllocationLedgerOperationClose,
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0),
        uint64(0))
    if cheng_runtime_atomic_cas_i32_intrinsic(
           ptr(&control->activeOwnerSlotIndex), slot->slotIndex, -1) == 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_active_owner_retire_failed")
        return 0
    slot->ownerThread = uint64(0)
    slot->sessionNonce0 = uint64(0)
    slot->sessionNonce1 = uint64(0)
    slot->closed = 1
    slot->active = 0
    let ok = cheng_allocation_ledger_fill_receipt_wire_locked(
        slot,
        cheng_allocation_ledger_production_proof_complete(),
        outReceipt)
    if !ok:
        cheng_allocation_ledger_abort(
            "allocation_ledger_close_receipt_commit_failed")
        return 0
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_close")
@abi_internal
fn cheng_allocation_ledger_close_export(
        handle: uint64,
        generation: uint64,
        outReceipt: ChengAllocationLedgerReceiptWirePtr,
        outErr: ptr): int32 =
    return cheng_allocation_ledger_close_core(
        handle,
        generation,
        0,
        uint64(0),
        uint64(0),
        outReceipt,
        outErr)

fn cheng_sha256_hex_digit(value: int32): uint8 =
    if value < 10:
        return uint8(int32('0') + value)
    return uint8(int32('a') + (value - 10))

# The process-entry session owner must be issued before any managed
# allocation exists, so this issuance edge cannot accept a managed domain
# string. The runtime fixes the nominal session domain itself; admission
# still goes through the single shared begin core, which hard-fails unless
# the process heap, registry, and probe baselines are all exactly zero and
# no other owner is active.
@exportc("cheng_allocation_ledger_session_owner_begin")
@abi_internal
fn cheng_allocation_ledger_session_owner_begin_export(
        backingLimit: uint64,
        outHandle: UInt64Ptr,
        outGeneration: UInt64Ptr,
        outNonce0: UInt64Ptr,
        outNonce1: UInt64Ptr,
        outErr: ptr): int32 =
    return cheng_allocation_ledger_begin_core(
        "cheng.runtime.process_entry_session_owner",
        backingLimit,
        outHandle,
        outGeneration,
        1,
        outNonce0,
        outNonce1,
        outErr)

@exportc("cheng_allocation_ledger_participant_mint")
@abi_internal
fn cheng_allocation_ledger_participant_mint_export(
        workerOrdinal: int32,
        boundary0: uint64,
        boundary1: uint64,
        boundary2: uint64,
        boundary3: uint64,
        outRow: Int32Ptr,
        outGeneration: Int32Ptr,
        outOwner: Int32Ptr): int32 =
    if outRow == nil || outGeneration == nil || outOwner == nil ||
       workerOrdinal < 0 ||
       !cheng_allocation_ledger_participant_root_valid(
           boundary0, boundary1, boundary2, boundary3):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_mint_input_invalid")
        return 0
    *outRow = -1
    *outGeneration = 0
    *outOwner = 0
    cheng_runtime_lock()
    let slot = cheng_allocation_ledger_owner_thread_active_locked()
    if slot == nil ||
       !cheng_allocation_ledger_participant_tls_initialize_locked():
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_mint_owner_missing")
        return 0
    for row in 0..<chengAllocationLedgerParticipantRowCount:
        let state = cheng_allocation_ledger_participant_state_load(row)
        if state != chengAllocationLedgerParticipantEmpty &&
           state != chengAllocationLedgerParticipantConsumed &&
           cheng_allocation_ledger_participant_owner_slot_index_load(row) ==
               slot->slotIndex &&
           cheng_allocation_ledger_participant_owner_slot_generation_load(row) ==
               slot->capabilityGeneration &&
           cheng_allocation_ledger_participant_worker_ordinal_load(row) ==
               workerOrdinal &&
           cheng_allocation_ledger_participant_boundary_root_equal(
               row, boundary0, boundary1, boundary2, boundary3):
            cheng_allocation_ledger_abort(
                "allocation_ledger_participant_duplicate_mint")
            return 0
    var selectedRow: int32 = -1
    for row in 0..<chengAllocationLedgerParticipantRowCount:
        let state =
            cheng_allocation_ledger_participant_state_load(row)
        if selectedRow < 0 &&
           (state == chengAllocationLedgerParticipantEmpty ||
            state == chengAllocationLedgerParticipantConsumed) &&
           cheng_allocation_ledger_participant_state_cas(
               row, state, chengAllocationLedgerParticipantBuilding):
            selectedRow = row
    if selectedRow < 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_rows_exhausted")
        return 0
    let priorGeneration =
        cheng_allocation_ledger_participant_generation_load(selectedRow)
    let priorOwner =
        cheng_allocation_ledger_participant_owner_load(selectedRow)
    if priorGeneration >= int32(2147483647) ||
       priorOwner >= int32(2147483647):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_token_overflow")
        return 0
    let generation = priorGeneration + 1
    let owner = priorOwner + 1
    cheng_allocation_ledger_participant_generation_store(
        selectedRow, generation)
    cheng_allocation_ledger_participant_owner_store(
        selectedRow, owner)
    cheng_allocation_ledger_participant_owner_slot_index_store(
        selectedRow, slot->slotIndex)
    cheng_allocation_ledger_participant_owner_slot_generation_store(
        selectedRow, slot->capabilityGeneration)
    cheng_allocation_ledger_participant_worker_ordinal_store(
        selectedRow, workerOrdinal)
    cheng_allocation_ledger_participant_claimed_thread_store(
        selectedRow, uint64(0))
    cheng_allocation_ledger_participant_boundary_root_store(
        selectedRow, boundary0, boundary1, boundary2, boundary3)
    cheng_allocation_ledger_participant_result_root_store(
        selectedRow, uint64(0), uint64(0), uint64(0), uint64(0))
    cheng_allocation_ledger_participant_state_store(
        selectedRow, chengAllocationLedgerParticipantIssued)
    *outRow = selectedRow
    *outGeneration = generation
    *outOwner = owner
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_participant_started_worker_ordinal")
@abi_internal
fn cheng_allocation_ledger_participant_started_worker_ordinal_export():
        int32 =
    cheng_runtime_lock()
    let row = cheng_allocation_ledger_participant_tls_row()
    if row < 0:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_started_worker_missing")
        return -1
    let slot =
        cheng_allocation_ledger_participant_owner_slot_locked(row)
    let workerOrdinal =
        cheng_allocation_ledger_participant_worker_ordinal_load(row)
    if slot == nil || workerOrdinal <= 0 ||
       cheng_allocation_ledger_participant_state_load(row) !=
           chengAllocationLedgerParticipantStarted:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_started_worker_missing")
        return -1
    cheng_runtime_unlock()
    return workerOrdinal

@exportc("cheng_allocation_ledger_participant_move")
@abi_internal
fn cheng_allocation_ledger_participant_move_export(
        row: int32,
        generation: int32,
        owner: int32,
        outGeneration: Int32Ptr,
        outOwner: Int32Ptr): int32 =
    if outGeneration == nil || outOwner == nil ||
       !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       !cheng_allocation_ledger_participant_state_cas(
           row,
           chengAllocationLedgerParticipantIssued,
           chengAllocationLedgerParticipantMoving):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_move_stale")
        return 0
    *outGeneration = 0
    *outOwner = 0
    cheng_runtime_lock()
    if !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       cheng_allocation_ledger_participant_owner_slot_locked(row) == nil ||
       !cheng_allocation_ledger_participant_rotate_token_locked(
           row, outGeneration, outOwner):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_move_authority_drift")
        return 0
    cheng_allocation_ledger_participant_state_store(
        row, chengAllocationLedgerParticipantIssued)
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_participant_claim")
@abi_internal
fn cheng_allocation_ledger_participant_claim_export(
        row: int32,
        generation: int32,
        owner: int32,
        workerOrdinal: int32,
        boundary0: uint64,
        boundary1: uint64,
        boundary2: uint64,
        boundary3: uint64,
        outGeneration: Int32Ptr,
        outOwner: Int32Ptr): int32 =
    if outGeneration == nil || outOwner == nil || workerOrdinal < 0 ||
       !cheng_allocation_ledger_participant_root_valid(
           boundary0, boundary1, boundary2, boundary3) ||
       !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_claim_stale")
        return 0
    let startedRow = cheng_allocation_ledger_participant_tls_row()
    if startedRow >= 0 && startedRow != row:
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_claim_start_row_drift")
        return 0
    if !cheng_allocation_ledger_participant_state_cas(
           row,
           chengAllocationLedgerParticipantStarted,
           chengAllocationLedgerParticipantWorkerClaiming) &&
       !cheng_allocation_ledger_participant_state_cas(
           row,
           chengAllocationLedgerParticipantIssued,
           chengAllocationLedgerParticipantClaiming):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_claim_stale")
        return 0
    *outGeneration = 0
    *outOwner = 0
    cheng_runtime_lock()
    let claimState =
        cheng_allocation_ledger_participant_state_load(row)
    let claimSlot =
        cheng_allocation_ledger_participant_owner_slot_locked(row)
    if !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       claimSlot == nil ||
       (claimState == chengAllocationLedgerParticipantClaiming &&
        (workerOrdinal != 0 ||
         startedRow >= 0 ||
         claimSlot->ownerThread != uint64(cheng_pthread_self_runtime()))) ||
       (claimState == chengAllocationLedgerParticipantWorkerClaiming &&
        (workerOrdinal <= 0 || startedRow != row)) ||
       (claimState != chengAllocationLedgerParticipantClaiming &&
        claimState != chengAllocationLedgerParticipantWorkerClaiming) ||
       cheng_allocation_ledger_participant_worker_ordinal_load(row) !=
           workerOrdinal ||
       !cheng_allocation_ledger_participant_boundary_root_equal(
           row, boundary0, boundary1, boundary2, boundary3) ||
       cheng_allocation_ledger_participant_claimed_thread_load(row) !=
           uint64(0):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_claim_boundary_drift")
        return 0
    let threadId = uint64(cheng_pthread_self_runtime())
    cheng_allocation_ledger_participant_claimed_thread_store(row, threadId)
    if !cheng_allocation_ledger_participant_rotate_token_locked(
           row, outGeneration, outOwner):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_claim_token_overflow")
        return 0
    if claimState == chengAllocationLedgerParticipantClaiming &&
       !cheng_allocation_ledger_participant_tls_bind(row):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_claim_tls_bind_failed")
        return 0
    cheng_allocation_ledger_participant_state_store(
        row, chengAllocationLedgerParticipantClaimed)
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_participant_publish")
@abi_internal
fn cheng_allocation_ledger_participant_publish_export(
        row: int32,
        generation: int32,
        owner: int32,
        workerOrdinal: int32,
        boundary0: uint64,
        boundary1: uint64,
        boundary2: uint64,
        boundary3: uint64,
        result0: uint64,
        result1: uint64,
        result2: uint64,
        result3: uint64,
        outGeneration: Int32Ptr,
        outOwner: Int32Ptr): int32 =
    if outGeneration == nil || outOwner == nil ||
       workerOrdinal < 0 ||
       !cheng_allocation_ledger_participant_root_valid(
           result0, result1, result2, result3) ||
       !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       !cheng_allocation_ledger_participant_state_cas(
           row,
           chengAllocationLedgerParticipantClaimed,
           chengAllocationLedgerParticipantPublishing):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_publish_stale")
        return 0
    *outGeneration = 0
    *outOwner = 0
    cheng_runtime_lock()
    if !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       cheng_allocation_ledger_participant_owner_slot_locked(row) == nil ||
       cheng_allocation_ledger_participant_worker_ordinal_load(row) !=
           workerOrdinal ||
       !cheng_allocation_ledger_participant_boundary_root_equal(
           row, boundary0, boundary1, boundary2, boundary3) ||
       cheng_allocation_ledger_participant_claimed_thread_load(row) !=
           uint64(cheng_pthread_self_runtime()):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_publish_boundary_drift")
        return 0
    cheng_allocation_ledger_participant_result_root_store(
        row, result0, result1, result2, result3)
    cheng_allocation_ledger_participant_claimed_thread_store(row, uint64(0))
    if !cheng_allocation_ledger_participant_rotate_token_locked(
           row, outGeneration, outOwner):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_publish_token_overflow")
        return 0
    if !cheng_allocation_ledger_participant_tls_clear():
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_publish_tls_clear_failed")
        return 0
    cheng_allocation_ledger_participant_state_store(
        row, chengAllocationLedgerParticipantPublished)
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_participant_consume")
@abi_internal
fn cheng_allocation_ledger_participant_consume_export(
        row: int32,
        generation: int32,
        owner: int32,
        workerOrdinal: int32,
        boundary0: uint64,
        boundary1: uint64,
        boundary2: uint64,
        boundary3: uint64,
        result0: uint64,
        result1: uint64,
        result2: uint64,
        result3: uint64): int32 =
    if workerOrdinal < 0 ||
       !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       !cheng_allocation_ledger_participant_state_cas(
           row,
           chengAllocationLedgerParticipantPublished,
           chengAllocationLedgerParticipantConsuming):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_consume_stale")
        return 0
    cheng_runtime_lock()
    let slot =
        cheng_allocation_ledger_participant_owner_slot_locked(row)
    let ownerSlot = cheng_allocation_ledger_owner_thread_active_locked()
    if !cheng_allocation_ledger_participant_token_matches(
           row, generation, owner) ||
       slot == nil || ownerSlot == nil ||
       slot->slotIndex != ownerSlot->slotIndex ||
       cheng_allocation_ledger_participant_worker_ordinal_load(row) !=
           workerOrdinal ||
       cheng_allocation_ledger_participant_claimed_thread_load(row) !=
           uint64(0) ||
       !cheng_allocation_ledger_participant_boundary_root_equal(
           row, boundary0, boundary1, boundary2, boundary3) ||
       !cheng_allocation_ledger_participant_result_root_equal(
           row, result0, result1, result2, result3):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_consume_root_drift")
        return 0
    var invalidatedGeneration: int32
    var invalidatedOwner: int32
    if !cheng_allocation_ledger_participant_rotate_token_locked(
           row, &invalidatedGeneration, &invalidatedOwner):
        cheng_allocation_ledger_abort(
            "allocation_ledger_participant_consume_token_overflow")
        return 0
    cheng_allocation_ledger_participant_state_store(
        row, chengAllocationLedgerParticipantConsumed)
    cheng_runtime_unlock()
    return 1

@exportc("cheng_allocation_ledger_session_owner_snapshot")
@abi_internal
fn cheng_allocation_ledger_session_owner_snapshot_export(
        handle: uint64,
        generation: uint64,
        nonce0: uint64,
        nonce1: uint64,
        outNextNonce0: UInt64Ptr,
        outNextNonce1: UInt64Ptr,
        outReceipt: ChengAllocationLedgerReceiptWirePtr,
        outErr: ptr): int32 =
    return cheng_allocation_ledger_snapshot_core(
        handle,
        generation,
        1,
        nonce0,
        nonce1,
        outNextNonce0,
        outNextNonce1,
        outReceipt,
        outErr)

@exportc("cheng_allocation_ledger_session_owner_close")
@abi_internal
fn cheng_allocation_ledger_session_owner_close_export(
        handle: uint64,
        generation: uint64,
        nonce0: uint64,
        nonce1: uint64,
        outReceipt: ChengAllocationLedgerReceiptWirePtr,
