fn cheng_runtime_lock_abort(reason: ptr) =
    var safeReason: ptr = reason
    if safeReason == nil:
        safeReason = "cheng runtime lock: fail-stop"
    let rawReasonLen = libc_strlen_runtime(safeReason)
    var reasonLen: int32
    if rawReasonLen < int64(0) || rawReasonLen > int64(2147483647):
        safeReason = "cheng runtime lock: invalid fail-stop reason"
        reasonLen = 44
    else:
        reasonLen = int32(rawReasonLen)
    if reasonLen > 0:
        let ignoredReason =
            libc_write_runtime(2, safeReason, reasonLen)
        ignoredReason
    let ignoredNewline = libc_write_runtime(2, "\n", 1)
    ignoredNewline
    libc__exit_runtime(70)

