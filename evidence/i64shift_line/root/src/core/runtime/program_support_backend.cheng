       (libc_fcntl_native(
            finishedReader, chengHeldExecFGetFl, 0) &
        chengHeldExecAccessModeMask) != chengHeldExecAccessReadOnly ||
       size < int64(0) || size > int64(2147483647):
        return -1
    if size == int64(0):
        return 0
    if size < int64(
           chengHeldExecFinishedUploadHeaderBytes +
           chengHeldExecWireBytes +
           chengHeldExecPlanEvidenceByteCount):
        return 0
    return 1

@exportc("cheng_held_exec_parent_activate_capsule_owner")
@abi_internal
