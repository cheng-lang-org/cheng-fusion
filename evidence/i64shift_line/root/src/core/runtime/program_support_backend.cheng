        cheng_held_exec_capsule_provider_role_close_fd_once(
            roleRow, chengHeldExecCapsuleFdBundleReader)
    let finishedWriterClosed =
        cheng_held_exec_capsule_provider_role_close_fd_once(
            roleRow, chengHeldExecCapsuleFdFinishedWriter)
    let decisionReaderClosed =
        cheng_held_exec_capsule_provider_role_close_fd_once(
