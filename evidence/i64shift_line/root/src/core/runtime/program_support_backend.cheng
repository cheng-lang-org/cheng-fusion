        return uint64(0)
    return backingBytes

fn cheng_allocation_ledger_handle(
        slotIndex: int32,
        generation: uint64): uint64 =
    if slotIndex < 0 || slotIndex >= chengAllocationLedgerOwnerSlotCount ||
       generation == uint64(0) || generation > uint64(0xffffffff):
        return uint64(0)
    return (generation << chengAllocationLedgerHandleShift) |
           uint64(slotIndex + 1)

fn cheng_allocation_ledger_handle_slot(handle: uint64): int32 =
    let low = handle & chengAllocationLedgerHandleIndexMask
    if low == uint64(0) || low > uint64(chengAllocationLedgerOwnerSlotCount):
        return -1
    return int32(low - uint64(1))

fn cheng_allocation_ledger_handle_generation(handle: uint64): uint64 =
    return handle >> chengAllocationLedgerHandleShift

fn cheng_allocation_ledger_resolve_locked(
        handle: uint64,
        generation: uint64,
        requireThread: bool,
        outErr: ptr): ChengAllocationLedgerOwnerSlotPtr =
    let slotIndex = cheng_allocation_ledger_handle_slot(handle)
    let encodedGeneration =
        cheng_allocation_ledger_handle_generation(handle)
    if slotIndex < 0 || encodedGeneration == uint64(0) ||
       encodedGeneration != generation:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_invalid_owner_handle")
        return nil
    let slot = cheng_allocation_ledger_slot_at(slotIndex)
    if slot == nil || slot->active == 0 || slot->closed != 0 ||
       slot->capabilityGeneration != generation:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_stale_owner_generation")
        return nil
    if slot->sessionCapabilityRequired != 0:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_session_nonce_required")
        return nil
    if requireThread &&
       slot->ownerThread != uint64(cheng_pthread_self_runtime()):
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_cross_thread_owner_access")
        return nil
    return slot

fn cheng_allocation_ledger_resolve_session_locked(
        handle: uint64,
        generation: uint64,
        nonce0: uint64,
        nonce1: uint64,
        outErr: ptr): ChengAllocationLedgerOwnerSlotPtr =
    let slotIndex = cheng_allocation_ledger_handle_slot(handle)
    let encodedGeneration =
        cheng_allocation_ledger_handle_generation(handle)
    if slotIndex < 0 || encodedGeneration == uint64(0) ||
       encodedGeneration != generation ||
       nonce0 == uint64(0) && nonce1 == uint64(0):
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_invalid_session_capability")
        return nil
    let slot = cheng_allocation_ledger_slot_at(slotIndex)
    if slot == nil || slot->active == 0 || slot->closed != 0 ||
       slot->sessionCapabilityRequired != 1 ||
       slot->capabilityGeneration != generation ||
       slot->sessionNonce0 != nonce0 || slot->sessionNonce1 != nonce1:
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_stale_session_capability")
        return nil
    if slot->ownerThread != uint64(cheng_pthread_self_runtime()):
        cheng_allocation_ledger_set_error(
            outErr,
            "allocation_ledger_cross_thread_session_access")
        return nil
    return slot

fn cheng_allocation_ledger_owner_thread_active_locked():
        ChengAllocationLedgerOwnerSlotPtr =
    let threadId = uint64(cheng_pthread_self_runtime())
    for index in 0..<chengAllocationLedgerOwnerSlotCount:
        let slot = cheng_allocation_ledger_slot_at(index)
        if slot != nil && slot->active != 0 && slot->closed == 0 &&
           slot->ownerThread == threadId:
            return slot
    return nil

