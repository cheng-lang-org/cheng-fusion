@exportc("cheng_webrtc_browser_request_response_bridge")
@abi_internal
fn cheng_webrtc_browser_request_response_bridge_export(protocolText: str,
                                                          policyWire: str,
                                                          labelText: str,
                                                          requestWire: str,
                                                          responseWire: str,
                                                          signalResponseWire: var str,
                                                          clientResponseWire: var str,
                                                          errWire: var str): int32 =
    signalResponseWire = cheng_str_empty()
    clientResponseWire = cheng_str_empty()
    errWire = cheng_str_empty()
    if cheng_str_len(protocolText) == 0:
        return cheng_webrtc_error(errWire, " libp2p webrtc browser: missing protocol selection")
    requestWire
    var handleErr = ""
    var handleSignal = ""
    let handle = cheng_webrtc_browser_session_open_bridge_export(policyWire,
                                                                    labelText,
                                                                    handleSignal,
                                                                    handleErr)
    if handle == uint64(0):
        if cheng_str_len(handleErr) == 0:
            return cheng_webrtc_error(errWire, " libp2p webrtc browser: session open failed")
        errWire = handleErr
        return 0
    signalResponseWire = handleSignal
    let ok = cheng_webrtc_browser_session_exchange_bridge_export(handle,
                                                                    protocolText,
                                                                    requestWire,
                                                                    responseWire,
                                                                    clientResponseWire,
                                                                    errWire)
    var closeErr = ""
    let closeOk = cheng_webrtc_browser_session_close_bridge_export(handle, closeErr)
    if ok == 0:
        return 0
    if closeOk == 0:
        if cheng_str_len(closeErr) == 0:
            return cheng_webrtc_error(errWire, " libp2p webrtc browser: session close failed")
        errWire = closeErr
        return 0
    errWire = cheng_str_empty()
    return 1

@exportc("cheng_webrtc_browser_session_open_bridge")
@abi_internal
fn cheng_webrtc_browser_session_open_bridge_export(policyText: str,
                                                      labelText: str,
                                                      signalResponseWire: var str,
                                                      errWire: var str): uint64 =
    signalResponseWire = cheng_str_empty()
    errWire = cheng_str_empty()
    var sessionId = cheng_fixed32_zero()
    var relayOnly = false
    if !cheng_webrtc_browser_signal_transcript(policyText,
                                               labelText,
                                               signalResponseWire,
                                               sessionId,
                                               relayOnly,
                                               errWire):
        return uint64(0)
    let runtime = cheng_webrtc_browser_session_runtime_new(sessionId, relayOnly)
    if runtime == nil:
        cheng_webrtc_error(errWire, " libp2p webrtc browser: alloc failed")
        signalResponseWire = cheng_str_empty()
        return uint64(0)
    let handle = cheng_ffi_handle_register_ptr_export(ptr(runtime))
    if handle == uint64(0):
        cheng_webrtc_browser_session_runtime_dispose(runtime)
        cheng_webrtc_error(errWire, " libp2p webrtc browser: handle register failed")
        signalResponseWire = cheng_str_empty()
        return uint64(0)
    cheng_webrtc_browser_session_active_count = cheng_webrtc_browser_session_active_count + 1
    return handle

@exportc("cheng_webrtc_browser_session_open_handle_bridge")
@abi_internal
fn cheng_webrtc_browser_session_open_handle_bridge_export(policyText: str,
                                                             labelText: str): uint64 =
    var signalResponseWire = cheng_str_empty()
    var errWire = cheng_str_empty()
    let handle = cheng_webrtc_browser_session_open_bridge_export(policyText,
                                                                    labelText,
                                                                    signalResponseWire,
                                                                    errWire)
    if handle == uint64(0):
        if cheng_str_len(errWire) == 0:
            var openErr = WebrtcErrBrowserSessionOpenFailed()
            cheng_webrtc_last_error_set(openErr)
        else:
            cheng_webrtc_last_error_set(errWire)
        cheng_str_dispose(signalResponseWire)
        cheng_str_dispose(errWire)
        return uint64(0)
    var borrowGeneration: uint64
    let runtimeRaw = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    let runtime = ChengWebrtcBrowserSessionStatePtr(runtimeRaw)
    var storedSignalWire = cheng_str_dup(signalResponseWire)
    cheng_str_store_slot(&runtime->signalWire, storedSignalWire)
    cheng_str_dispose(storedSignalWire)
    let storedSignalSlot = StrPtr(&runtime->signalWire)
    let signalStored =
        cheng_str_len(signalResponseWire) > 0 &&
        storedSignalSlot->len ==
            cheng_str_len(signalResponseWire)
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        cheng_str_dispose(signalResponseWire)
        cheng_str_dispose(errWire)
        return uint64(0)
    if !signalStored:
        var closeErr = cheng_str_empty()
        let closeOk = cheng_webrtc_browser_session_close_bridge_export(handle, closeErr)
        closeOk
        if cheng_str_len(closeErr) > 0:
            cheng_webrtc_last_error_set(closeErr)
        else:
            var signalAllocErr = WebrtcErrBrowserSignalAllocFailed()
            cheng_webrtc_last_error_set(signalAllocErr)
        cheng_str_dispose(signalResponseWire)
        cheng_str_dispose(errWire)
        cheng_str_dispose(closeErr)
        return uint64(0)
    cheng_webrtc_last_error_clear()
    cheng_str_dispose(signalResponseWire)
    cheng_str_dispose(errWire)
    return handle

@exportc("cheng_webrtc_browser_session_signal_handle_bridge")
fn cheng_webrtc_browser_session_signal_handle_bridge_export(handle: uint64): uint64 =
    var borrowGeneration: uint64
    let runtimeRaw = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    let runtime = ChengWebrtcBrowserSessionStatePtr(runtimeRaw)
    if !runtime->active:
        let released = cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration)
        released
        var inactiveErr = WebrtcErrBrowserSessionInactive()
        cheng_webrtc_last_error_set(inactiveErr)
        return uint64(0)
    let signalWireSlot = StrPtr(&runtime->signalWire)
    if signalWireSlot->len == 0:
        let released = cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration)
        released
        var signalMissingErr = WebrtcErrBrowserSignalMissing()
        cheng_webrtc_last_error_set(signalMissingErr)
        return uint64(0)
    let signalHandle = cheng_buffer_handle_new_from_buf(
        signalWireSlot->data, signalWireSlot->len)
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        if signalHandle != uint64(0):
            let retiredSignal = cheng_ffi_handle_retire_take_ptr(signalHandle)
            cheng_free_export(retiredSignal)
        return uint64(0)
    if signalHandle == uint64(0):
        var allocErr = WebrtcErrAllocFailed()
        cheng_webrtc_last_error_set(allocErr)
        return uint64(0)
    cheng_webrtc_last_error_clear()
    return signalHandle

@exportc("cheng_webrtc_browser_session_exchange_bridge")
@abi_internal
fn cheng_webrtc_browser_session_exchange_bridge_export(handle: uint64,
                                                          protocolText: str,
                                                          requestWire: str,
                                                          responseWire: str,
                                                          clientResponseWire: var str,
                                                          errWire: var str): int32 =
    clientResponseWire = cheng_str_empty()
    errWire = cheng_str_empty()
    requestWire
    if cheng_str_len(protocolText) == 0:
        return cheng_webrtc_error(errWire, " libp2p webrtc browser: missing protocol selection")
    var borrowGeneration: uint64
    let runtimeRaw = cheng_ffi_handle_lease_acquire_ptr(
        handle, &borrowGeneration)
    if runtimeRaw == nil:
        return cheng_webrtc_error(errWire, " libp2p webrtc browser: invalid session handle")
    let runtime = ChengWebrtcBrowserSessionStatePtr(runtimeRaw)
    let active = runtime->active
    if !cheng_ffi_handle_lease_release_or_abort(
            handle, borrowGeneration):
        return cheng_webrtc_error(
            errWire, " libp2p webrtc browser: lease release failed")
    if !active:
        return cheng_webrtc_error(errWire, " libp2p webrtc browser: session inactive")
    return cheng_webrtc_browser_copy_response(responseWire, clientResponseWire, errWire)

