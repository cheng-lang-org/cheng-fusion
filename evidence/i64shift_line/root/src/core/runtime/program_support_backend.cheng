        return nil
    return ptr(uint64(int64(uint64(base)) + int64(off)))

fn cheng_mem_registry_slot_get_raw(idx: int32): uint64 =
    if idx < 0 || cheng_mem_registry_slots_raw == uint64(0):
        return uint64(0)
    return cheng_runtime_ptr_slot_load_raw_intrinsic(cheng_mem_registry_slots_raw, idx)

fn cheng_mem_registry_slot_get(idx: int32): ptr =
    return ptr(cheng_mem_registry_slot_get_raw(idx))

fn cheng_mem_registry_slot_set(idx: int32, value: ptr) =
    if idx < 0 || cheng_mem_registry_slots_raw == uint64(0):
        return
    cheng_runtime_ptr_slot_store_raw_intrinsic(cheng_mem_registry_slots_raw, idx, uint64(value))

fn cheng_mem_registry_slot_set_raw(idx: int32, value: uint64) =
    if idx < 0 || cheng_mem_registry_slots_raw == uint64(0):
        return
    cheng_runtime_ptr_slot_store_raw_intrinsic(cheng_mem_registry_slots_raw, idx, value)

fn cheng_mem_registry_hash(value: ptr): uint64 =
    # murmur3 finalizer: strong mixing avoids primary clustering in the
    # open-addressing table when heap pointers are sequential.
    # 64 位字面量须 32 位半段拼装：cold 与纯发射器的 LoadConst 操作数均为
    # int32，整字面量会被截断为 imm32 符号扩展。
    let mixC1: uint64 = (uint64(0xff51afd7) << uint64(32)) | uint64(0xed558ccd)
    let mixC2: uint64 = (uint64(0xc4ceb9fe) << uint64(32)) | uint64(0x1a85ec53)
    var bits: uint64 = uint64(value) >> uint64(4)
    bits = bits ^ (bits >> uint64(33))
    bits = bits * mixC1
    bits = bits ^ (bits >> uint64(33))
    bits = bits * mixC2
    bits = bits ^ (bits >> uint64(33))
    return bits

fn cheng_mem_registry_probe_start(value: ptr, cap: int32): int32 =
    if cap <= 0:
        return 0
    let capMask: int32 = cap - 1
    let hashBits: uint64 = cheng_mem_registry_hash(value)
    let maskBits: uint64 = uint64(capMask)
    let boundedBits: uint64 = hashBits & maskBits
    let boundedHash: int32 = int32(boundedBits)
    if boundedHash < 0:
        return 0
    return boundedHash

fn cheng_mem_registry_insert_into(slotsRaw: uint64, cap: int32, value: ptr): bool =
    if slotsRaw == uint64(0) || cap <= 0 || value == nil:
        return false
    let valueRaw = uint64(value)
    var idx: int32 = cheng_mem_registry_probe_start(value, cap)
    if idx < 0:
        return false
    var steps: int32
    for steps in steps..<cap:
        let currentRaw = cheng_runtime_ptr_slot_load_raw_intrinsic(slotsRaw, idx)
        if currentRaw == uint64(0):
            cheng_runtime_ptr_slot_store_raw_intrinsic(slotsRaw, idx, valueRaw)
            return true
        if currentRaw == valueRaw:
            return false
        idx = idx + 1
        if idx >= cap:
            idx = 0
    return false

fn cheng_mem_registry_grow(minLive: int32): bool =
    native_cheng_runtime_event_assert_owner_runtime()
    if minLive < 0:
        cheng_mem_registry_hard_fail("cheng mem registry: negative minimum live count")
        return false
    let oldRaw: uint64 = cheng_mem_registry_slots_raw
    let oldCap: int32 = cheng_mem_registry_cap
    let oldLen: int32 = cheng_mem_registry_len
    let oldDead: int32 = cheng_mem_registry_dead
    if oldCap < 0 || oldLen < 0 || oldDead < 0 ||
       (oldCap == 0 && oldRaw != uint64(0)) ||
       (oldCap > 0 && (oldRaw == uint64(0) || oldCap < 8 ||
                       (oldCap & (oldCap - 1)) != 0)) ||
       int64(oldLen) + int64(oldDead) > int64(oldCap):
        cheng_mem_registry_hard_fail("cheng mem registry: corrupt table shape before rehash")
        return false
    var needed64: int64 = int64(minLive)
    if needed64 < int64(oldLen):
        needed64 = int64(oldLen)
    if needed64 <= int64(0):
        needed64 = int64(1)
    var newCap: int32 = 8
    while (int64(newCap) * int64(7)) / int64(10) < needed64:
        if newCap >= 1073741824:
            cheng_mem_registry_hard_fail(
                "cheng mem registry: slot capacity exhausted")
            return false
        newCap = newCap * 2
    let slotBytes: int64 = int64(sizeof(ptr))
    let bytes: int64 = int64(newCap) * slotBytes
    if slotBytes <= int64(0) || bytes <= int64(0) ||
       bytes / slotBytes != int64(newCap):
        cheng_mem_registry_hard_fail(
            "cheng mem registry: slot byte size overflow")
        return false
    let mem: ptr = c_malloc(bytes)
    if mem == nil:
        return false
    var clearIndex: int32
    for clearIndex in clearIndex..<newCap:
        cheng_runtime_ptr_slot_store_raw_intrinsic(
            uint64(mem), clearIndex, uint64(0))
    var i: int32
    var liveCount: int32
    var deadCount: int32
    var emptyCount: int32
    let tombRaw = cheng_mem_registry_tombstone_raw()
    for i in i..<oldCap:
        let currentRaw = cheng_runtime_ptr_slot_load_raw_intrinsic(oldRaw, i)
        if currentRaw == uint64(0):
            emptyCount = emptyCount + 1
        elif currentRaw == tombRaw:
            deadCount = deadCount + 1
        else:
            let current = ptr(currentRaw)
            if !cheng_mem_registry_insert_into(uint64(mem), newCap, current):
                c_free(mem)
                cheng_mem_registry_hard_fail("cheng mem registry: duplicate or impossible rehash insertion")
                return false
            liveCount = liveCount + 1
    if int64(liveCount) + int64(deadCount) + int64(emptyCount) != int64(oldCap) ||
       liveCount != oldLen || deadCount != oldDead:
        c_free(mem)
        cheng_mem_registry_hard_fail("cheng mem registry: recorded counts differ from physical slots")
        return false
    # Every registry access is made under cheng_runtime_lock/leaf_lock. Publish
    # the complete replacement while that same lock is held, then release the
    # old slot owner. Entries are pointer values, never borrows into oldRaw.
    cheng_mem_registry_slots_raw = uint64(mem)
    cheng_mem_registry_cap = newCap
    cheng_mem_registry_len = liveCount
    cheng_mem_registry_dead = 0
    if oldRaw != uint64(0):
        c_free(ptr(oldRaw))
    return true

fn cheng_mem_registry_ensure_capacity(extraLive: int32): bool =
    if extraLive < 0 || cheng_mem_registry_cap < 0 ||
       cheng_mem_registry_len < 0 || cheng_mem_registry_dead < 0 ||
       (cheng_mem_registry_cap == 0 &&
        (cheng_mem_registry_slots_raw != uint64(0) ||
         cheng_mem_registry_len != 0 || cheng_mem_registry_dead != 0)) ||
       (cheng_mem_registry_cap > 0 &&
        (cheng_mem_registry_slots_raw == uint64(0) ||
         cheng_mem_registry_cap < 8 ||
         (cheng_mem_registry_cap & (cheng_mem_registry_cap - 1)) != 0)) ||
       int64(cheng_mem_registry_len) + int64(cheng_mem_registry_dead) >
           int64(cheng_mem_registry_cap):
        cheng_mem_registry_hard_fail("cheng mem registry: corrupt capacity request state")
        return false
    let needed64: int64 = int64(cheng_mem_registry_len) + int64(extraLive)
    if needed64 > int64(2147483647):
        cheng_mem_registry_hard_fail("cheng mem registry: live count overflow")
        return false
    let needed: int32 = int32(needed64)
    if cheng_mem_registry_cap <= 0:
        return cheng_mem_registry_grow(needed)
    let occupied64: int64 = int64(cheng_mem_registry_len) +
                                int64(cheng_mem_registry_dead) +
                                int64(extraLive)
    if occupied64 * int64(10) >= int64(cheng_mem_registry_cap) * int64(7):
        return cheng_mem_registry_grow(needed)
    return true

fn cheng_mem_registry_contains(value: ptr): bool =
    if value == nil || cheng_mem_registry_cap <= 0 || cheng_mem_registry_slots_raw == uint64(0):
        return false
    var idx: int32 = cheng_mem_registry_probe_start(value, cheng_mem_registry_cap)
    if idx < 0:
        return false
    let valueRaw = uint64(value)
    var steps: int32
    for steps in steps..<cheng_mem_registry_cap:
        let currentRaw = cheng_mem_registry_slot_get_raw(idx)
        if currentRaw == uint64(0):
            return false
        if currentRaw == valueRaw:
            return true
        idx = idx + 1
        if idx >= cheng_mem_registry_cap:
            idx = 0
    return false

fn cheng_mem_registry_insert(value: ptr): bool =
    if value == nil:
        return true
    if !cheng_mem_registry_ensure_capacity(1):
        return false
    let valueRaw = uint64(value)
    let tombRaw = cheng_mem_registry_tombstone_raw()
    var idx: int32 = cheng_mem_registry_probe_start(value, cheng_mem_registry_cap)
    if idx < 0:
        return false
    var steps: int32
    var firstDead: int32 = -1
    for steps in steps..<cheng_mem_registry_cap:
        let currentRaw = cheng_mem_registry_slot_get_raw(idx)
        if currentRaw == valueRaw:
            return true
        if currentRaw == tombRaw && firstDead < 0:
            firstDead = idx
        if currentRaw == uint64(0):
            let target: int32 = firstDead >= 0 ? firstDead : idx
            cheng_mem_registry_slot_set(target, value)
            cheng_mem_registry_len = cheng_mem_registry_len + 1
            if firstDead >= 0 && cheng_mem_registry_dead > 0:
                cheng_mem_registry_dead = cheng_mem_registry_dead - 1
            return true
        idx = idx + 1
        if idx >= cheng_mem_registry_cap:
            idx = 0
    if firstDead >= 0:
        cheng_mem_registry_slot_set(firstDead, value)
        cheng_mem_registry_len = cheng_mem_registry_len + 1
        if cheng_mem_registry_dead > 0:
            cheng_mem_registry_dead = cheng_mem_registry_dead - 1
        return true
    return false

fn cheng_mem_registry_remove(value: ptr) =
    if value == nil || cheng_mem_registry_cap <= 0 || cheng_mem_registry_slots_raw == uint64(0):
        return
    if cheng_mem_registry_cached_payload_raw == uint64(value):
        cheng_mem_registry_cached_payload_raw = uint64(0)
    var idx: int32 = cheng_mem_registry_probe_start(value, cheng_mem_registry_cap)
    let valueRaw = uint64(value)
    let tombRaw = cheng_mem_registry_tombstone_raw()
    var steps: int32
    for steps in steps..<cheng_mem_registry_cap:
        let currentRaw = cheng_mem_registry_slot_get_raw(idx)
        if currentRaw == uint64(0):
            return
        if currentRaw == valueRaw:
            cheng_mem_registry_slot_set_raw(idx, tombRaw)
            if cheng_mem_registry_len > 0:
                cheng_mem_registry_len = cheng_mem_registry_len - 1
            cheng_mem_registry_dead = cheng_mem_registry_dead + 1
            return
        idx = idx + 1
        if idx >= cheng_mem_registry_cap:
            idx = 0

# poison-on-miss 守卫用: 与 cheng_mem_registry_remove 同逻辑, 但把「未在册」如实
# 返回 false (alloc/realloc 全路径强制 insert, rc==0 的 free 对象必然在册; miss =
# rc under-count / stale borrow 把非在册指针推进了 free 路径)。
fn cheng_mem_registry_remove_checked(value: ptr): bool =
    if value == nil || cheng_mem_registry_cap <= 0 || cheng_mem_registry_slots_raw == uint64(0):
        return false
    if cheng_mem_registry_cached_payload_raw == uint64(value):
        cheng_mem_registry_cached_payload_raw = uint64(0)
    var idx: int32 = cheng_mem_registry_probe_start(value, cheng_mem_registry_cap)
    let valueRaw = uint64(value)
    let tombRaw = cheng_mem_registry_tombstone_raw()
    var steps: int32
    for steps in steps..<cheng_mem_registry_cap:
        let currentRaw = cheng_mem_registry_slot_get_raw(idx)
        if currentRaw == uint64(0):
            return false
        if currentRaw == valueRaw:
            cheng_mem_registry_slot_set_raw(idx, tombRaw)
            if cheng_mem_registry_len > 0:
                cheng_mem_registry_len = cheng_mem_registry_len - 1
            cheng_mem_registry_dead = cheng_mem_registry_dead + 1
            return true
        idx = idx + 1
        if idx >= cheng_mem_registry_cap:
            idx = 0
    return false

fn cheng_mem_header(p: ptr): ChengMemHeaderPtr =
    if p == nil:
        return nil
    let ledgerRecord =
        cheng_allocation_ledger_live_record_for_payload_locked(p)
    if ledgerRecord != nil:
        let ledgerSlot =
            cheng_allocation_ledger_record_slot_locked(ledgerRecord)
        if ledgerSlot == nil:
            cheng_allocation_ledger_abort(
                "allocation_ledger_header_owner_invalid")
            return nil
        return ChengMemHeaderPtr(
            ptr(uint64(p) - uint64(sizeof(ChengMemHeader))))
    let payloadRaw: uint64 = uint64(p)
    if cheng_mem_registry_cached_payload_raw == payloadRaw:
        return ChengMemHeaderPtr(ptr(payloadRaw - uint64(sizeof(ChengMemHeader))))
    if !cheng_mem_registry_contains(p):
        return nil
    let headerRaw: uint64 = payloadRaw - uint64(sizeof(ChengMemHeader))
    cheng_mem_registry_cached_payload_raw = payloadRaw
    return ChengMemHeaderPtr(ptr(headerRaw))

fn cheng_mem_header_cached_fast(p: ptr): ChengMemHeaderPtr =
    if p == nil:
        return nil
    if cheng_allocation_ledger_active_owner_index_fast() >= 0:
        return nil
    if cheng_mem_registry_cached_payload_raw != uint64(p):
        return nil
    return ChengMemHeaderPtr(ptr(uint64(p) - uint64(sizeof(ChengMemHeader))))

fn cheng_mem_header_unchecked(p: ptr): ChengMemHeaderPtr =
    if p == nil:
        return nil
    return ChengMemHeaderPtr(ptr(uint64(p) - uint64(sizeof(ChengMemHeader))))

fn cheng_mem_header_rc_get(header: ChengMemHeaderPtr): int32 =
    if header == nil:
        return 0
    return *(Int32Ptr(ptr(header)))

fn cheng_mem_header_rc_set(header: ChengMemHeaderPtr, value: int32) =
    if header == nil:
        return
    *(Int32Ptr(ptr(header))) = value

# header.size bit30 marks mmap backing and bit29 marks the owner-scoped exact
# ledger domain. Payloads are bounded below bit29, so size_get can strip both
# physical tags without changing logical payload length.
fn cheng_mem_header_size_get(header: ChengMemHeaderPtr): int32 =
    if header == nil:
        return 0
    # hoist ptr_plus: nested *(Int32Ptr(cheng_ptr_plus(...))) 在纯 Cheng
    # backend 下会丢 value/地址物化（DRV78 反汇编: store 读未写栈槽）。
    let sizeAddr = cheng_ptr_plus(ptr(header), int32(sizeof(int32)))
    let rawSize = *(Int32Ptr(sizeAddr))
    return rawSize & 536870911

fn cheng_mem_header_is_mmap(header: ChengMemHeaderPtr): bool =
    if header == nil:
        return false
    let sizeAddr = cheng_ptr_plus(ptr(header), int32(sizeof(int32)))
    let rawSize = *(Int32Ptr(sizeAddr))
    return (rawSize & 1073741824) != 0

fn cheng_mem_header_is_ledger(header: ChengMemHeaderPtr): bool =
    if header == nil:
        return false
    let sizeAddr = cheng_ptr_plus(ptr(header), int32(sizeof(int32)))
    let rawSize = *(Int32Ptr(sizeAddr))
    return (rawSize & 536870912) != 0

fn cheng_mem_header_size_set(header: ChengMemHeaderPtr, value: int32) =
    if header == nil:
        return
    let sizeAddr = cheng_ptr_plus(ptr(header), int32(sizeof(int32)))
    *(Int32Ptr(sizeAddr)) = value

fn cheng_mem_header_size_set_mmap(header: ChengMemHeaderPtr, value: int32) =
    if header == nil:
        return
    let sizeAddr = cheng_ptr_plus(ptr(header), int32(sizeof(int32)))
    let tagged = value | 1073741824
    *(Int32Ptr(sizeAddr)) = tagged

fn cheng_mem_header_size_set_ledger(
        header: ChengMemHeaderPtr,
        value: int32) =
    if header == nil || value <= 0 ||
       value > chengAllocationLedgerMaxPayloadBytes:
        cheng_allocation_ledger_abort(
            "allocation_ledger_header_size_invalid")
        return
    let sizeAddr = cheng_ptr_plus(ptr(header), int32(sizeof(int32)))
    *(Int32Ptr(sizeAddr)) = value | 1073741824 | 536870912

# 块级释放派发: mmap 块 munmap (长度=header+净size, 内核页对齐), malloc 块
# c_free。所有 header 释放点 (free/release/realloc-migrate) 统一走这。
fn cheng_mem_block_release(header: ChengMemHeaderPtr) =
    if header == nil:
        return
    if cheng_mem_header_is_ledger(header):
        cheng_allocation_ledger_abort(
            "allocation_ledger_release_requires_owner_dispatch")
        return
    if cheng_mem_header_is_mmap(header):
        let total: int64 = int64(sizeof(ChengMemHeader)) + int64(cheng_mem_header_size_get(header))
        let _ = c_munmap(ptr(header), total)
    else:
        c_free(ptr(header))

# ---- free 毒化 + 有界 quarantine（wall75 内存制度线）----
# 语义边界：只改「释放之后」的行为。存活路径（rc/registry/ledger/probe 全部
# 判定）零触碰；分配永远取新鲜 c_malloc/mmap，quarantine 块物理释放前绝不
# 重新入册，毒化字节不可能被任何存活对象读到。mmap 块（≥256KiB，[wall150]
# 前 ≥1MiB）直接 munmap：
# 释放后访问本就 SIGSEGV 确定性，无需 quarantine。
# 机制：
#   1. 毒化：托管块最后一跳把 payload 填 0xDD。释放后任何读写立刻呈可判别
#      毒形态（0xDD ≠ 0xFF，与合法 -1 默认、move-out 置零均不同）。
#   2. 有界 FIFO quarantine：毒化块延迟物理释放，预算默认 48MiB
#      （CHENG_QUARANTINE_BYTES 可调，1GiB 封顶）；预算溢出从队头淘汰，
#      淘汰前逐字节复扫 + header 期望长度互证——任何非毒字节 = quarantine
#      期内被写 = 确定性 use-after-free，携块地址/长度/首违偏移 write(2)
#      直出后 _exit(70)，绝不静默。
#   3. atexit 出口兜底不可用：macho provider linker 对 atexit 符号不可解析
#      （夹具 exe native link 实证 unresolved first=atexit），授权面内无出口
#      钩子。flush 保留为显式导出 @cheng_quarantine_flush；退出残余（≤预算）
#      不复扫，扫描覆盖率=运行中淘汰流，边界如实记录。
# 开关：CHENG_QUARANTINE=0 全关（与无此代码行为逐字节等价）；默认开，
# 编译期默认由 chengQuarantineDefaultEnabled 承载。
const chengQuarantineDefaultEnabled: int32 = 1
const chengQuarantinePoisonByte: int32 = 221
# [wall150] 预算保持 48MiB：r4 曾试 40MiB（连同 ring 收敛），gate cn 快测
# 触发 compiler snapshot lowering bridge "output storage already owned"
# （quarantine 参数与 bridge 输出存储所有权判定存在耦合，机制移交后端线），
# 回退后判词消失——预算/环形参数锁定在 r2 实证安全组合，禁止再动。
const chengQuarantineDefaultBudgetBytes: int64 = 50331648
const chengQuarantineBudgetMaxBytes: int64 = 1073741824
const chengQuarantineRingInitialCap: int32 = 1024
# [wall150] ring 本体上限 16MiB→4MiB：淘汰权威=ring_bytes 字节预算(48MiB)，
# entry 数上限只是辅助闸。[wall149] 翻倍紧缩拷贝的瞬态=旧块+新块共存
# （旧 8MiB+新 16MiB=24MiB）；收敛 4MiB 后瞬态降至 6MiB（2MiB+4MiB）。
# cap 到顶后强制淘汰一格语义不变（预算窗口不缩）。
const chengQuarantineRingMaxCap: int32 = 262144

fn cheng_quarantine_hex_append(buf: ptr, pos: int32, raw: uint64): int32 =
    let digits: ptr = "0123456789abcdef"
    var p: int32 = pos
    if p > 236:
        return p
    *(UInt8Ptr(cheng_ptr_plus(buf, p))) = uint8(48)
    *(UInt8Ptr(cheng_ptr_plus(buf, p + 1))) = uint8(120)
    p = p + 2
    var shift: int32 = 60
    while shift >= 0:
        let nibble: int32 = int32((raw >> uint64(shift)) & uint64(15))
        let digitChar: int32 = int32(*(UInt8Ptr(cheng_ptr_plus(digits, nibble))))
        *(UInt8Ptr(cheng_ptr_plus(buf, p))) = uint8(digitChar)
        p = p + 1
        shift = shift - 4
    return p

fn cheng_quarantine_uaf_abort_locked(payload: ptr,
                                     payloadBytes: int32,
                                     badOffset: int32,
                                     observed: int32) =
    # quarantine 期内出现非毒字节 = 释放后被写 = 确定性 UAF。证据 write(2)
    # 直出后 _exit(70)：不 malloc、不进 atexit、不再入任何 Cheng 代码路径。
    let buf: ptr = ptr(cheng_quarantine_msg_buf)
    let head: ptr = "cheng_quarantine: use-after-free write after free payload="
    var p: int32 = cheng_cstrlen_raw(head)
    cheng_bytes_copy(buf, head, p)
    p = cheng_quarantine_hex_append(buf, p, uint64(payload))
    let mid1: ptr = " payloadBytes="
    let m1: int32 = cheng_cstrlen_raw(mid1)
    cheng_bytes_copy(cheng_ptr_plus(buf, p), mid1, m1)
    p = p + m1
    p = cheng_quarantine_hex_append(buf, p, uint64(int64(payloadBytes)))
    let mid2: ptr = " firstBadOffset="
    let m2: int32 = cheng_cstrlen_raw(mid2)
    cheng_bytes_copy(cheng_ptr_plus(buf, p), mid2, m2)
    p = p + m2
    p = cheng_quarantine_hex_append(buf, p, uint64(int64(badOffset)))
    let mid3: ptr = " observedByte="
    let m3: int32 = cheng_cstrlen_raw(mid3)
    cheng_bytes_copy(cheng_ptr_plus(buf, p), mid3, m3)
    p = p + m3
    p = cheng_quarantine_hex_append(buf, p, uint64(int64(observed)))
    *(UInt8Ptr(cheng_ptr_plus(buf, p))) = uint8(10)
    let _ = libc_write_runtime(2, buf, p + 1)
    libc__exit_runtime(70)

fn cheng_quarantine_scan_locked(header: ChengMemHeaderPtr) =
    let payload: ptr = cheng_payload_ptr(ptr(header))
    let size: int32 = cheng_mem_header_size_get(header)
    var i: int32
    while i < size:
        let byteValue: int32 = int32(*(UInt8Ptr(cheng_ptr_plus(payload, i))))
        if byteValue != chengQuarantinePoisonByte:
            cheng_quarantine_uaf_abort_locked(payload, size, i, byteValue)
            return
        i = i + 1

# [wall149] 辅防 fail-stop：evict 窗口槽 header 呈毒化遗体形态（0xDD 填充形）
# 时禁静默解引用，携毒模式值+槽位+窗口现场 write(2) 直出后 _exit(70)。
# 判别式取「高 32 位全 0xDD」：用户态地址空间不存在该形态的合法堆指针，
# 零误报；窗口内槽只可能被 push 写入或翻倍紧缩拷贝写入（wall147 spec ②）。
fn cheng_quarantine_stale_slot_abort_locked(headerRaw: uint64, slot: int32) =
    let buf: ptr = ptr(cheng_quarantine_msg_buf)
    let head: ptr = "cheng_quarantine: ring stale slot header=0x"
    var p: int32 = cheng_cstrlen_raw(head)
    cheng_bytes_copy(buf, head, p)
    p = cheng_quarantine_hex_append(buf, p, headerRaw)
    let mid1: ptr = " slot="
    let m1: int32 = cheng_cstrlen_raw(mid1)
    cheng_bytes_copy(cheng_ptr_plus(buf, p), mid1, m1)
    p = p + m1
    p = cheng_quarantine_hex_append(buf, p, uint64(int64(slot)))
    let mid2: ptr = " len="
    let m2: int32 = cheng_cstrlen_raw(mid2)
    cheng_bytes_copy(cheng_ptr_plus(buf, p), mid2, m2)
    p = p + m2
    p = cheng_quarantine_hex_append(buf, p, uint64(int64(cheng_quarantine_ring_len)))
    let mid3: ptr = " cap="
    let m3: int32 = cheng_cstrlen_raw(mid3)
    cheng_bytes_copy(cheng_ptr_plus(buf, p), mid3, m3)
    p = p + m3
    p = cheng_quarantine_hex_append(buf, p, uint64(int64(cheng_quarantine_ring_cap)))
    *(UInt8Ptr(cheng_ptr_plus(buf, p))) = uint8(10)
    let _ = libc_write_runtime(2, buf, p + 1)
    libc__exit_runtime(70)

fn cheng_quarantine_evict_one_locked() =
    if cheng_quarantine_ring_len <= 0:
        return
    let entryStride: int32 = int32(sizeof(ChengQuarantineEntry))
    let entryAddr: ptr = cheng_ptr_plus(ptr(cheng_quarantine_ring), int32(int64(cheng_quarantine_ring_head) * int64(entryStride)))
    let entry: ChengQuarantineEntryPtr = ChengQuarantineEntryPtr(entryAddr)
    let headerRaw: uint64 = uint64(entry->header)
    if (headerRaw >> uint64(32)) == uint64(0xDDDDDDDD):
        cheng_quarantine_stale_slot_abort_locked(headerRaw, cheng_quarantine_ring_head)
    let header: ChengMemHeaderPtr = ChengMemHeaderPtr(entry->header)
    let expectedBytes: int32 = entry->payloadBytes
    cheng_quarantine_ring_head = cheng_quarantine_ring_head + 1
    if cheng_quarantine_ring_head >= cheng_quarantine_ring_cap:
        cheng_quarantine_ring_head = 0
    cheng_quarantine_ring_len = cheng_quarantine_ring_len - 1
    if header != nil:
        let liveBytes: int32 = cheng_mem_header_size_get(header)
        let total: int64 = int64(sizeof(ChengMemHeader)) + int64(liveBytes)
        if liveBytes != expectedBytes:
            # header 在 quarantine 期内被改写 = 指针级 UAF 变体，同场 abort。
            cheng_quarantine_uaf_abort_locked(cheng_payload_ptr(ptr(header)), liveBytes, -1, -2)
        cheng_quarantine_scan_locked(header)
        cheng_quarantine_ring_bytes = cheng_quarantine_ring_bytes - total
    cheng_mem_block_release(header)

fn cheng_quarantine_ring_push_locked(header: ChengMemHeaderPtr) =
    let payloadBytes: int32 = cheng_mem_header_size_get(header)
    if cheng_quarantine_ring_cap <= 0:
        let bytes: int64 = int64(chengQuarantineRingInitialCap) * int64(sizeof(ChengQuarantineEntry))
        let mem: ptr = c_malloc(bytes)
        if mem == nil:
            # ring 本体分配失败：毒化已生效但延迟释放不可用，就地物理释放
            # （等价 quarantine 关闭、毒化保留）。非静默降级：仅 libc OOM 可达。
            cheng_mem_block_release(header)
            return
        cheng_quarantine_ring = ChengQuarantineEntryPtr(mem)
        cheng_quarantine_ring_cap = chengQuarantineRingInitialCap
        cheng_quarantine_ring_head = 0
        cheng_quarantine_ring_len = 0
    if cheng_quarantine_ring_len >= cheng_quarantine_ring_cap:
        # 容量到顶先翻倍，到上限才强制淘汰一格。
        if cheng_quarantine_ring_cap < chengQuarantineRingMaxCap:
            # [wall149] 翻倍根治：禁走 c_realloc。libc 大块 realloc 搬新址只拷
            # 旧块字节，新块拷贝边界 [oldBytes, newBytes) 是复用 freed 大块的
            # 陈旧遗体（历史毒化块 0xDD 遗体可达 evict 窗口，wall147 定谳堆腐
            # 根因）。改 malloc 新块 + 旧窗口 [head, head+len) 环形展开紧缩
            # 拷贝到新块 [0, len) + head 归零 + 旧块 c_free：窗口恒为已写槽，
            # 未拷贝陈旧区永远落在窗口外。新旧块不重叠，逐 entry 拷贝无别名。
            # 旧块指针按 cheng_mem_registry_grow 同款纪律以 uint64 raw 快照
            # （指针值携带，禁止指针型 local 别名全局；r1 烤机实证指针型
            # local 从全局赋值会被物化成 &global 导致 free 野实参 SIGABRT）。
            # malloc 失败（仅 libc OOM 可达）：旧块原样保留，走下方强制淘汰
            # 一格，与原 realloc 失败语义一致，非静默降级。
            let oldCap: int32 = cheng_quarantine_ring_cap
            let oldRingRaw: uint64 = uint64(cheng_quarantine_ring)
            let oldHead: int32 = cheng_quarantine_ring_head
            let oldLen: int32 = cheng_quarantine_ring_len
            let entryStride: int32 = int32(sizeof(ChengQuarantineEntry))
            let newCap: int32 = oldCap * 2
            let bytes: int64 = int64(newCap) * int64(entryStride)
            let mem: ptr = c_malloc(bytes)
            if mem != nil:
                var i: int32
                while i < oldLen:
                    var srcIdx: int32 = oldHead + i
                    if srcIdx >= oldCap:
                        srcIdx = srcIdx - oldCap
                    let dstAddr: ptr = cheng_ptr_plus(mem, int32(int64(i) * int64(entryStride)))
                    let srcAddr: ptr = cheng_ptr_plus(ptr(oldRingRaw), int32(int64(srcIdx) * int64(entryStride)))
                    cheng_bytes_copy(dstAddr, srcAddr, entryStride)
                    i = i + 1
                cheng_quarantine_ring = ChengQuarantineEntryPtr(mem)
                cheng_quarantine_ring_cap = newCap
                cheng_quarantine_ring_head = 0
                c_free(ptr(oldRingRaw))
        if cheng_quarantine_ring_len >= cheng_quarantine_ring_cap:
            cheng_quarantine_evict_one_locked()
    var tail: int32 = cheng_quarantine_ring_head + cheng_quarantine_ring_len
    if tail >= cheng_quarantine_ring_cap:
        tail = tail - cheng_quarantine_ring_cap
    let entryStride: int32 = int32(sizeof(ChengQuarantineEntry))
    let entryAddr: ptr = cheng_ptr_plus(ptr(cheng_quarantine_ring), int32(int64(tail) * int64(entryStride)))
    let entry: ChengQuarantineEntryPtr = ChengQuarantineEntryPtr(entryAddr)
    entry->header = ptr(header)
    entry->payloadBytes = payloadBytes
    cheng_quarantine_ring_len = cheng_quarantine_ring_len + 1
    cheng_quarantine_ring_bytes = cheng_quarantine_ring_bytes + int64(sizeof(ChengMemHeader)) + int64(payloadBytes)
    while cheng_quarantine_ring_bytes > cheng_quarantine_budget_bytes:
        cheng_quarantine_evict_one_locked()

fn cheng_quarantine_release_locked(header: ChengMemHeaderPtr) =
    # 托管块物理释放唯一收口（cheng_mem_release / cheng_free 最后一跳）。
    if header == nil:
        return
    if cheng_quarantine_settings_resolved == 0:
        # 注意：全局 BSS 零初始化，哨兵必须是独立 resolved 标志
        # （enabled 用 -1 当「未解析」会被零值吞掉——首烤实证）。
        cheng_quarantine_settings_resolved = 1
        var enabled: int32 = chengQuarantineDefaultEnabled
        var budget: int64 = chengQuarantineDefaultBudgetBytes
        let flagRaw: ptr = libc_getenv_runtime("CHENG_QUARANTINE")
        if flagRaw != nil:
            if cheng_cstrlen_raw(flagRaw) > 0:
                if int32(*(UInt8Ptr(flagRaw))) == 48:
                    enabled = 0
                else:
                    enabled = 1
        let budgetRaw: ptr = libc_getenv_runtime("CHENG_QUARANTINE_BYTES")
        if budgetRaw != nil:
            var value: int64
            var digitCount: int32
            let rawLen: int32 = cheng_cstrlen_raw(budgetRaw)
            var i: int32
            while i < rawLen:
                let byteValue: int32 = int32(*(UInt8Ptr(cheng_ptr_plus(budgetRaw, i))))
                if byteValue >= 48 && byteValue <= 57:
                    value = value * 10 + int64(byteValue - 48)
                    digitCount = digitCount + 1
                    if value > chengQuarantineBudgetMaxBytes:
                        value = chengQuarantineBudgetMaxBytes
                i = i + 1
            if digitCount > 0 && value > 0:
                budget = value
        cheng_quarantine_enabled = enabled
        cheng_quarantine_budget_bytes = budget
    if cheng_quarantine_enabled == 0:
        cheng_mem_block_release(header)
        return
    if cheng_mem_header_is_mmap(header):
        cheng_mem_block_release(header)
        return
    let payload: ptr = cheng_payload_ptr(ptr(header))
    let size: int32 = cheng_mem_header_size_get(header)
    if size > 0:
        cheng_bytes_set(payload, chengQuarantinePoisonByte, size)
    cheng_quarantine_ring_push_locked(header)

@exportc("cheng_quarantine_flush")
fn cheng_quarantine_flush_export() =
    if cheng_quarantine_panic_exit_seen != 0:
        return
    if cheng_quarantine_flush_running != 0:
        return
    cheng_quarantine_flush_running = 1
    cheng_runtime_lock()
    while cheng_quarantine_ring_len > 0:
        cheng_quarantine_evict_one_locked()
    cheng_runtime_unlock()

fn cheng_load_u8(base: ptr, idx: int32): int32 =
    return int32(*(UInt8Ptr(cheng_ptr_plus(base, idx))))

# Runtime ABI boundary: arena SoA byte access only (not a general memory peek).
# nil base is a caller bug — panic (ZRPC fail-safe; no silent 0/no-op degrade).
@exportc("cheng_u8_load_at")
fn cheng_u8_load_at_export(base: ptr, offset: int32): int32 =
    if base == nil:
        panic("cheng_u8_load_at: nil base")
    return cheng_load_u8(base, offset)

@exportc("cheng_u8_store_at")
fn cheng_u8_store_at_export(base: ptr, offset: int32, value: int32) =
    if base == nil:
        panic("cheng_u8_store_at: nil base")
    *(UInt8Ptr(cheng_ptr_plus(base, offset))) = uint8(value & 255)

# Arena ArrayInt32 columns are allocated at 4-byte aligned offsets, so a
# 32-bit little-endian word is semantically identical to the previous
# byte-wise sequence on every supported target (arm64, x86_64, aarch64 are
# little-endian). Same ABI-boundary rule: one checked base pointer, one
# scalar load/store, no caller-side dereference.
@exportc("cheng_u32_load_at")
fn cheng_u32_load_at_export(base: ptr, offset: int32): int32 =
    if base == nil:
        panic("cheng_u32_load_at: nil base")
    return int32(*(UInt32Ptr(cheng_ptr_plus(base, offset))))

@exportc("cheng_u32_store_at")
fn cheng_u32_store_at_export(base: ptr, offset: int32, value: int32) =
    if base == nil:
        panic("cheng_u32_store_at: nil base")
    *(UInt32Ptr(cheng_ptr_plus(base, offset))) = uint32(value)

# Dedicated fs.stat ABI bridge (out_ptrs scalars). Not a general (ptr,offset) peek.
# Darwin arm64 struct stat field offsets (raw; selfhost DarwinStat field layout is
# known-wrong for st_size — #44; use audited offsets here only).
const
    chengDarwinStatModeOff: int32 = 4
    chengDarwinStatMtimeSecOff: int32 = 48
    chengDarwinStatSizeOff: int32 = 96
    chengLinuxX64StatModeOff: int32 = 24
    chengLinuxA64StatModeOff: int32 = 16
    chengLinuxStatSizeOff: int32 = 48
    chengLinuxStatMtimeSecOff: int32 = 88

@exportc("cheng_fs_stat_scalars")
fn cheng_fs_stat_scalars_export(path: ptr,
                                outSize: Int64Ptr,
                                outMode: Int32Ptr,
                                outMtime: Int64Ptr,
                                outIsDir: Int32Ptr,
                                outIsFile: Int32Ptr): int32 =
    if path == nil || outSize == nil || outMode == nil || outMtime == nil ||
       outIsDir == nil || outIsFile == nil:
        panic("cheng_fs_stat_scalars: nil path or out_ptr")
    var st: ChengReadOnlyMappedRegionStatBuffer
    cheng_bytes_set(ptr(&st), 0, 256)
    if libc_stat(path, ptr(&st)) != 0:
        return -1
    let base: ptr = ptr(&st)
    var size: int64
    var mode: int32
    var mtime: int64
    if cheng_host_is_darwin():
        size = *(Int64Ptr(cheng_ptr_plus(base, chengDarwinStatSizeOff)))
        mode = int32(*(UInt16Ptr(cheng_ptr_plus(base, chengDarwinStatModeOff))))
        mtime = *(Int64Ptr(cheng_ptr_plus(base, chengDarwinStatMtimeSecOff)))
    else:
        let platformKind = cheng_read_only_mapped_region_platform_kind()
        if platformKind == chengReadOnlyMappedRegionPlatformLinuxX64:
            size = *(Int64Ptr(cheng_ptr_plus(base, chengLinuxStatSizeOff)))
            mode = int32(*(UInt32Ptr(
                cheng_ptr_plus(base, chengLinuxX64StatModeOff))))
            mtime = *(Int64Ptr(cheng_ptr_plus(base, chengLinuxStatMtimeSecOff)))
        elif platformKind == chengReadOnlyMappedRegionPlatformLinuxA64:
            size = *(Int64Ptr(cheng_ptr_plus(base, chengLinuxStatSizeOff)))
            mode = int32(*(UInt32Ptr(
                cheng_ptr_plus(base, chengLinuxA64StatModeOff))))
            mtime = *(Int64Ptr(cheng_ptr_plus(base, chengLinuxStatMtimeSecOff)))
        else:
            return -1
    let ftype: int32 = mode & chengStatTypeMask
    *outSize = size
    *outMode = mode
    *outMtime = mtime
    if ftype == chengStatTypeDir:
        *outIsDir = 1
    else:
        *outIsDir = 0
    if ftype == chengStatTypeReg:
        *outIsFile = 1
    else:
        *outIsFile = 0
    return 0

fn cheng_payload_ptr(raw: ptr): ptr =
    if raw == nil:
        return nil
    return cheng_ptr_plus(raw, int32(sizeof(ChengMemHeader)))

fn cheng_str_empty(): str =
    var out: str
    out.data = nil
    out.len = 0
    out.store_id = 0
    out.flags = 0
    return out

fn cheng_str_view_owned(data: ptr, len0: int32): str =
    var out: str
    let len: int32 = len0 < 0 ? 0 : len0
    if data == nil || len <= 0:
        return out
    out.data = data
    out.len = len
    out.store_id = 0
    out.flags = chengStrFlagOwned
    return out

fn cheng_str_view(data: ptr, len0: int32): str =
    var out: str
    let len: int32 = len0 < 0 ? 0 : len0
    if data == nil || len <= 0:
        return out
    out.data = data
    out.len = len
    out.store_id = 0
    out.flags = 0
    return out

@borrows
fn cheng_probably_valid_str_bridge(s: str): bool =
    if s.len < 0 || s.len > 268435456:
        return false
    if s.flags != 0 && s.flags != chengStrFlagOwned:
        return false
    if s.data == nil:
        return s.len == 0
    return uint64(s.data) >= uint64(65536)

@borrows
fn cheng_fallback_string_ptr(s: str): ptr =
    if s.data == nil:
        return nil
    if uint64(s.data) < uint64(65536):
        return nil
    return s.data

@borrows
fn cheng_str_len(s: str): int32 =
    if cheng_probably_valid_str_bridge(s):
        if s.data == nil || s.len <= 0:
            return 0
        return s.len
    let compat: ptr = cheng_fallback_string_ptr(s)
    if compat == nil:
        return 0
    return cheng_cstrlen_raw(compat)

@borrows
fn cheng_str_data(s: str): ptr =
    if cheng_probably_valid_str_bridge(s):
        if s.data == nil || s.len <= 0:
            return nil
        return s.data
    return cheng_fallback_string_ptr(s)

@borrows
fn panic(msg: str) =
    let data: ptr = cheng_str_data(msg)
    let len: int32 = cheng_str_len(msg)
    if data == nil || len <= 0:
        cheng_panic_cstring_and_exit_export("panic")
        return
    let raw: ptr = driver_c_new_string_copy_n_export(data, len)
    if raw == nil:
        cheng_panic_cstring_and_exit_export("panic")
        return
    cheng_panic_cstring_and_exit_export(raw)

fn cheng_bytes_copy(dst: ptr, src: ptr, n0: int32) =
    if dst == nil || src == nil || n0 <= 0:
        return
    # 词拷贝主体 + 字节尾。arm64/x64 标量 LDR/STR 对普通内存允许非对齐访问，
    # 纯搬运与字节序无关，逐词等价于逐字节且快 ~30 倍（大块 memcpy 形态
    # 曾以 ~8ns/字节成为所有端到端测速的主导项）。
    var d: ptr = dst
    var s: ptr = src
    var n: int32 = n0
    while n >= 8:
        *(UInt64Ptr(d)) = *(UInt64Ptr(s))
        d = cheng_ptr_plus(d, 8)
        s = cheng_ptr_plus(s, 8)
        n = n - 8
    var i: int32
    while i < n:
        *(UInt8Ptr(cheng_ptr_plus(d, i))) = *(UInt8Ptr(cheng_ptr_plus(s, i)))
        i = i + 1

fn cheng_bytes_set(dst: ptr, value: int32, n0: int32) =
    if dst == nil || n0 <= 0:
        return
    let byteValue: uint8 = uint8(value & 255)
    let wordValue: uint32 = uint32(byteValue) | (uint32(byteValue) << 8) |
                            (uint32(byteValue) << 16) | (uint32(byteValue) << 24)
    var d: ptr = dst
    var n: int32 = n0
    while n >= 4:
        *(UInt32Ptr(d)) = wordValue
        d = cheng_ptr_plus(d, 4)
        n = n - 4
    var i: int32
    while i < n:
        *(UInt8Ptr(cheng_ptr_plus(d, i))) = byteValue
        i = i + 1

fn cheng_bytes_write_offset_i8(dst: ptr, offset: int32, value: int8) =
    if dst == nil || offset < 0:
        return
    cheng_bytes_set(cheng_ptr_plus(dst, offset), int32(value), 1)

fn cheng_bytes_compare(a: ptr, b: ptr, n0: int32): int32 =
    if n0 <= 0:
        return 0
    if a == b:
        return 0
    if a == nil:
        return -1
    if b == nil:
        return 1
    for i in 0..<n0:
        let av: uint8 = *(UInt8Ptr(cheng_ptr_plus(a, i)))
        let bv: uint8 = *(UInt8Ptr(cheng_ptr_plus(b, i)))
        if av < bv:
            return -1
        if av > bv:
            return 1
    return 0

fn cheng_bytes_equal(a: ptr, b: ptr, n0: int32): bool =
    return cheng_bytes_compare(a, b, n0) == 0

fn cheng_cstrlen_raw(s: ptr): int32 =
    if s == nil:
        return 0
    let n = libc_strlen_runtime(s)
    if n < 0 || n > 2147483647:
        cheng_runtime_lock_abort("cheng_cstrlen_raw: length overflow")
        return 0
    return int32(n)

fn cheng_string_copy_locked(raw: ptr, n0: int32): ptr =
    if n0 < 0:
        cheng_runtime_lock_abort("cheng_string_copy: negative length")
        return nil
    if n0 > 0 && raw == nil:
        cheng_runtime_lock_abort("cheng_string_copy: nil source")
        return nil
    if n0 >= 2147483647:
        cheng_runtime_lock_abort("cheng_string_copy: length overflow")
        return nil
    let n = n0
    let out: ptr = cheng_malloc_locked(n + 1)
    if out == nil:
        return nil
    cheng_bytes_set(out, 0, n + 1)
    if raw != nil && n > 0:
        cheng_bytes_copy(out, raw, n)
    return out

fn cheng_string_copy(raw: ptr, n0: int32): ptr =
    cheng_runtime_lock()
    let out = cheng_string_copy_locked(raw, n0)
    cheng_runtime_unlock()
    return out

@exportc("cheng_string_copy")
fn cheng_string_copy_export(raw: ptr, n0: int32): ptr =
    cheng_string_copy(raw, n0)

fn cheng_str_copy(raw: ptr, n: int32): str =
    if n <= 0:
        return cheng_str_empty()
    if raw == nil:
        cheng_panic_cstring_and_exit_export("cheng_str_copy: nil source")
    let outRaw: ptr = cheng_string_copy(raw, n)
    if outRaw == nil:
        cheng_panic_cstring_and_exit_export("cheng_str_copy: alloc failed")
    return cheng_str_view_owned(outRaw, n)

fn cheng_str_retain_owned(s: var str) =
    if s.flags == chengStrFlagOwned && s.data != nil:
        cheng_mem_retain_export(s.data)

fn cheng_str_release_owned(s: var str) =
    cheng_str_release_scope_export(s.data, s.flags)
    s.data = nil
    s.len = 0
    s.store_id = 0
    s.flags = 0

fn cheng_str_managed_record_validate(s: var str) =
    if s.len < 0 || s.len > 268435456:
        panic("cheng str managed store: invalid length")
    if s.flags != 0 && s.flags != chengStrFlagOwned:
        panic("cheng str managed store: invalid flags")
    if s.data == nil:
        if s.len != 0:
            panic("cheng str managed store: nil data with nonzero length")
        return
    # str ABI 合同对齐(判词 50 附属根修): 发射器对 `""` 字面量的文档化
    # 表示 = {只读 NUL 边界 data, len=0, 非 owned}(cheng_cold.c STR_LITERAL
    # 注释: string_abi_contract=nul_terminated boundary); store 槽原语对
    # 非 owned 记录同样原样放行。静态空视图合法; owned 空记录必须走
    # canonical (nil,0)。wild-page 守卫与 owned provenance 守卫全部保留。
    if s.len == 0:
        if s.flags == chengStrFlagOwned:
            panic("cheng str managed store: owned empty with non-nil data")
        if uint64(s.data) < uint64(65536):
            panic("cheng str managed store: invalid data")
        return
    if uint64(s.data) < uint64(65536):
        panic("cheng str managed store: invalid data")
    if s.flags == chengStrFlagOwned:
        let provenance = cheng_managed_payload_provenance(s.data)
        if provenance == chengManagedProvenanceNone:
            panic("cheng str managed store: foreign owned data")

# Scope-exit release primitive (deterministic-memory-lifetime-plan.md §5.4).
# Same guarded semantics as cheng_str_release_owned (which now delegates
# here, so this stays on the exact reachability path chengStrStoreCompat's
# container-store release already depends on — no separate export-roots
# registration needed), but takes the two decomposed scalar fields (data ptr
# + flags) instead of a full str-by-value aggregate, so backend-generated
# scope-exit release call sites can pass them as plain register args
# (FieldLoad data@0/8 + FieldLoad flags@16/4) without needing str
# aggregate-by-value call ABI.
@exportc("cheng_str_release_scope")
fn cheng_str_release_scope_export(data: ptr, flags: int32) =
    if flags == chengStrFlagOwned && data != nil:
        cheng_mem_release_export(data)

# Canonical Ownership/Init/Drop glue consumes a complete managed place by
# address.  Keep this ABI separate from the historical decomposed helper so
# CleanupPlan can emit one type-directed call shared by every backend.
@exportc("cheng_str_drop_owned")
@abi_internal
fn cheng_str_drop_owned_export(value: var str) =
    cheng_str_release_scope_export(value.data, value.flags)
    value.data = nil
    value.len = 0
    value.store_id = 0
    value.flags = 0

# Owned returns are snapshotted before local cleanup.  The returned record owns
# one independent retain; the source remains live until the cleanup edge drops
# it in canonical reverse order.
@exportc("cheng_str_snapshot_retain_owned")
@abi_internal
fn cheng_str_snapshot_retain_owned_export(source: var str): str =
    var out: str
    out.data = source.data
    out.len = source.len
    out.store_id = source.store_id
    out.flags = source.flags
    cheng_str_retain_owned(out)
    return out

fn cheng_str_store_slot(slot: ptr, val: var str) =
    if slot == nil:
        return
    let outPtr: StrPtr = StrPtr(slot)
    var prev: str
    prev.data = outPtr->data
    prev.len = outPtr->len
    prev.store_id = outPtr->store_id
    prev.flags = outPtr->flags
    var next: str
    next.data = val.data
    next.len = val.len
    next.store_id = val.store_id
    next.flags = val.flags
    cheng_str_managed_record_validate(val)
    cheng_str_managed_record_validate(prev)
    if next.flags != chengStrFlagOwned &&
       next.data != nil &&
       next.len > 0:
        next = cheng_str_copy(next.data, next.len)
    else:
        cheng_str_retain_owned(val)
    cheng_str_release_owned(prev)
    prev.data = nil
    prev.len = 0
    prev.store_id = 0
    prev.flags = 0
    outPtr->data = next.data
    outPtr->len = next.len
    outPtr->store_id = next.store_id
    outPtr->flags = next.flags
    next.data = nil
    next.len = 0
    next.store_id = 0
    next.flags = 0

# Backend whole-value stores pass both records by address.  Keep the ownership
# transition in one runtime primitive: retain/copy the incoming value before
# releasing the previous global value, then publish the complete 24-byte record.
@exportc("cheng_str_store_managed")
fn cheng_str_store_managed_export(slot: ptr, valPtr: ptr) =
    if slot == nil || valPtr == nil:
        panic("cheng str managed store: nil record")
    let valRaw: StrPtr = StrPtr(valPtr)
    var val: str
    val.data = valRaw->data
    val.len = valRaw->len
    val.store_id = valRaw->store_id
    val.flags = valRaw->flags
    cheng_str_store_slot(slot, val)
    val.data = nil
    val.len = 0
    val.store_id = 0
    val.flags = 0

# Move form for an exact owned call-result temporary.  Borrowed results are
# copied; owned results transfer their existing reference.  The source record
# is cleared so the ownership move is represented in runtime state as well as
# BodyIR ownership metadata.
@exportc("cheng_str_move_store_managed")
fn cheng_str_move_store_managed_export(slot: ptr, valPtr: ptr) =
    if slot == nil || valPtr == nil || slot == valPtr:
        panic("cheng str managed move-store: invalid records")
    let outPtr: StrPtr = StrPtr(slot)
    let valRaw: StrPtr = StrPtr(valPtr)
    var prev: str
    prev.data = outPtr->data
    prev.len = outPtr->len
    prev.store_id = outPtr->store_id
    prev.flags = outPtr->flags
    var next: str
    next.data = valRaw->data
    next.len = valRaw->len
    next.store_id = valRaw->store_id
    next.flags = valRaw->flags
    cheng_str_managed_record_validate(prev)
    cheng_str_managed_record_validate(next)
    if next.flags != chengStrFlagOwned && next.data != nil:
        next = cheng_str_copy(next.data, next.len)
    cheng_str_release_owned(prev)
    outPtr->data = next.data
    outPtr->len = next.len
    outPtr->store_id = next.store_id
    outPtr->flags = next.flags
    valRaw->data = nil
    valRaw->len = 0
    valRaw->store_id = 0
    valRaw->flags = 0
    next.data = nil
    next.len = 0
    next.store_id = 0
    next.flags = 0

fn cheng_fopen_write(path: ptr): ptr =
    if path == nil:
        return nil
    return libc_fopen(path, "wb")

fn get_stdin(): ptr =
    if cheng_stdio_in != nil:
        return cheng_stdio_in
    cheng_stdio_in = libc_fopen("/dev/stdin", "r")
    return cheng_stdio_in

fn get_stdout(): ptr =
    if cheng_stdio_out != nil:
        return cheng_stdio_out
    cheng_stdio_out = libc_fopen("/dev/stdout", "w")
    return cheng_stdio_out

fn get_stderr(): ptr =
    if cheng_stdio_err != nil:
        return cheng_stdio_err
    cheng_stdio_err = libc_fopen("/dev/stderr", "w")
    return cheng_stdio_err

fn cheng_stream_looks_safe(stream: ptr): bool =
    if stream == nil:
        return false
    return uint64(stream) >= uint64(0x100000000)

fn cheng_safe_read_stream(stream: ptr): ptr =
    if cheng_stream_looks_safe(stream):
        return stream
    # Inline the /dev/stdin fopen: the fd-as-ptr builtin intercepts `get_stdin`
    # by name, so a call to get_stdin() here would return the ptr-0 sentinel
    # instead of a real FILE* and fgetc would read EOF.
    if cheng_stdio_in != nil:
        return cheng_stdio_in
    cheng_stdio_in = libc_fopen("/dev/stdin", "r")
    return cheng_stdio_in

fn cheng_safe_write_stream(stream: ptr): ptr =
    # fd-as-ptr sentinels (stdout=1, stderr=2) are valid write streams:
    # cheng_host_fwrite routes them through the raw fd write loop. Without
    # this pass-through the 4GiB looks-safe heuristic rejects them and the
    # /dev/stdout reopen misroutes stderr on Darwin and silently drops the
    # write on cold Linux ELF, eating every panic message.
    if uint64(stream) == uint64(1) || uint64(stream) == uint64(2):
        return stream
    if cheng_stream_looks_safe(stream):
        return stream
    # Inline the /dev/stdout fopen: same reason as cheng_safe_read_stream --
    # get_stdout() would be intercepted to the ptr-1 sentinel, not a real FILE*.
    if cheng_stdio_out != nil:
        return cheng_stdio_out
    cheng_stdio_out = libc_fopen("/dev/stdout", "w")
    return cheng_stdio_out

fn cheng_fread(buf: ptr, size: int64, n: int64, stream: ptr): int32 =
    let safe = cheng_safe_read_stream(stream)
    if buf == nil || safe == nil || size <= 0 || n <= 0:
        return 0
    let got = libc_fread(buf, size, n, safe)
    if got <= 0:
        return int32(got)
    if got > int64(2147483647):
        return 2147483647
    return int32(got)

fn cheng_fwrite(buf: ptr, size: int64, n: int64, stream: ptr): int32 =
    let safe = cheng_safe_write_stream(stream)
    if buf == nil || safe == nil || size <= 0 || n <= 0:
        return 0
    let wrote = libc_fwrite(buf, size, n, safe)
    # fd-as-ptr sentinels (stdout=1, stderr=2) are raw fds: they have no
    # libc buffer, so fflush is both meaningless and crashes flockfile
    # (fd passed as FILE*). Only real FILE* streams need the flush.
    if wrote > 0 && uint64(safe) != uint64(1) && uint64(safe) != uint64(2):
        libc_fflush(safe)
    if wrote <= 0:
        return int32(wrote)
    if wrote > int64(2147483647):
        return 2147483647
    return int32(wrote)

fn cheng_fwrite_i32(buf: ptr, size: int32, n: int32, stream: ptr): int32 =
    return cheng_fwrite(buf, int64(size), int64(n), stream)

fn cheng_stderr_write_cstr(text: ptr) =
    if text == nil:
        return
    let n: int32 = cheng_cstrlen_raw(text)
    if n <= 0:
        return
    let ignoredWrite = cheng_fwrite(text, 1, int64(n), get_stderr())

fn cheng_stderr_write_line_cstr(text: ptr) =
    cheng_stderr_write_cstr(text)
    cheng_stderr_write_cstr("\n")

@borrows
fn cheng_stderr_write_line_str_return2(text: str): int32 =
    let n: int32 = cheng_str_len(text)
    let data: ptr = cheng_str_data(text)
    if data != nil && n > 0:
        let ignoredText = cheng_fwrite(data, 1, int64(n), get_stderr())
    let ignoredNewline = cheng_fwrite("\n", 1, int64(1), get_stderr())
    return 2

@borrows
fn cheng_stdout_write_line_str_return2(text: str): int32 =
    let n: int32 = cheng_str_len(text)
    let data: ptr = cheng_str_data(text)
    if data != nil && n > 0:
        let ignoredText = cheng_fwrite(data, 1, int64(n), get_stdout())
    let ignoredNewline = cheng_fwrite("\n", 1, int64(1), get_stdout())
    return 2

fn driver_c_raw_env_truthy(name: ptr): bool =
    let raw: ptr = libc_getenv_runtime(name)
    if raw == nil:
        return false
    let n: int32 = cheng_cstrlen_raw(raw)
    if n <= 0:
        return false
    if n == 1 && *(UInt8Ptr(raw)) == uint8(int32('0')):
        return false
    if n == 5 && cheng_bytes_compare(raw, "false", 5) == 0:
        return false
    return true

fn driver_c_progress_parse_unsigned_i64(raw: ptr): int64 =
    if raw == nil:
        return int64(-1)
    let n: int32 = cheng_cstrlen_raw(raw)
    if n <= 0:
        return int64(-1)
    var value: int64
    var hadDigit = false
    var trailingSpace = false
    for i in 0..<n:
        let ch: uint8 = *(UInt8Ptr(cheng_ptr_plus(raw, i)))
        if ch >= uint8(int32('0')) && ch <= uint8(int32('9')):
            if trailingSpace:
                return int64(-1)
            value = value * int64(10) + int64(int32(ch) - int32('0'))
            hadDigit = true
        elif int32(ch) == 32 || int32(ch) == 10 || int32(ch) == 9 || int32(ch) == 13:
            if hadDigit:
                trailingSpace = true
        else:
            return int64(-1)
    if !hadDigit:
        return int64(-1)
    return value

fn driver_c_progress_default_max_rss_bytes(): int64 =
    return int64(805306368)

fn driver_c_progress_configured_max_rss_bytes(): int64 =
    if driver_c_raw_env_truthy("CHENG_PARENT_RSS_GUARD"):
        return int64(0)
    if libc_getenv_runtime("PARENT_RSS_GUARD") != nil ||
       libc_getenv_runtime("PROCESS_MAX_RSS_BYTES") != nil ||
       libc_getenv_runtime("CHENG_MAX_RSS_BYTES") != nil ||
       libc_getenv_runtime("MAX_RSS_BYTES") != nil:
        return int64(-1)
    var raw: ptr = libc_getenv_runtime("CHENG_PROCESS_MAX_RSS_BYTES")
    if raw == nil || cheng_cstrlen_raw(raw) <= 0:
        return driver_c_progress_default_max_rss_bytes()
    let parsed: int64 = driver_c_progress_parse_unsigned_i64(raw)
    if parsed <= int64(0):
        return int64(-1)
    return parsed

fn driver_c_progress_current_rss_bytes(): int64 =
    var usage: ChengRuntimeRusage
    if libc_getrusage_runtime(0, usage) != 0:
        return int64(-1)
    if usage.ru_maxrss <= int64(0):
        return int64(-1)
    # ru_maxrss unit: Linux reports KiB, Darwin reports bytes.
    if cheng_host_is_darwin():
        return usage.ru_maxrss
    return usage.ru_maxrss * int64(1024)

fn driver_c_progress_write_limit_exceeded(rssBytes: int64,
                                           maxRssBytes: int64) =
    let rssText: ptr = driver_c_i64_to_str_export(rssBytes)
    let maxText: ptr = driver_c_i64_to_str_export(maxRssBytes)
    let p0: ptr = cheng_raw_concat_export("compile_progress phase=resource_guard status=rss_limit_exceeded rss_bytes=", rssText)
    let p1: ptr = cheng_raw_concat_export(p0, " limit_bytes=")
    let line: ptr = cheng_raw_concat_export(p1, maxText)
    cheng_stderr_write_line_cstr(line)
    cheng_free_export(rssText)
    cheng_free_export(maxText)
    cheng_free_export(p0)
    cheng_free_export(p1)
    cheng_free_export(line)

fn driver_c_rss_guard_instant_enabled(): bool =
    # [orcd5-guard] getrusage maxrss under-reports against the
    # instantaneous provider channel on darwin under memory pressure
    # (T-E round: instantaneous 969,999,584B over the 805,306,368 gate
    # while the maxrss-based guard never fired).  Env-gated: default off
    # keeps the guard byte-identical.
    return driver_c_raw_env_truthy("CHENG_RSS_GUARD_INSTANT")

fn driver_c_progress_resource_guard_check() =
    let maxRssBytes: int64 = driver_c_progress_configured_max_rss_bytes()
    if maxRssBytes == int64(0):
        return
    if maxRssBytes < int64(0):
        cheng_stderr_write_line_cstr("compile_progress phase=resource_guard status=invalid_max_rss")
        c_exit_runtime(2)
    let rssBytes: int64 = driver_c_progress_current_rss_bytes()
    if rssBytes <= int64(0):
        cheng_stderr_write_line_cstr("compile_progress phase=resource_guard status=rss_unavailable")
        c_exit_runtime(2)
    # [orcd5-guard] take the max of the getrusage high-water channel and
    # the instantaneous provider channel so an intra-phase spike that
    # maxrss misses still trips the gate.
    var effectiveRss: int64 = rssBytes
    if driver_c_rss_guard_instant_enabled():
        let instantRss: int64 = cheng_orcd5_instant_rss_bridge(
            int64(libc_getpid_runtime()))
        if instantRss > effectiveRss:
            effectiveRss = instantRss
    if effectiveRss > maxRssBytes:
        driver_c_progress_write_limit_exceeded(effectiveRss, maxRssBytes)
        c_exit_runtime(125)

fn driver_c_progress_line(phase: str,
                           status: str): str =
    var p0: str = driver_c_str_concat_bridge_export("compile_progress phase=", phase)
    var p1: str = driver_c_str_concat_bridge_export(p0, " status=")
    let line: str = driver_c_str_concat_bridge_export(p1, status)
    cheng_str_release_owned(p0)
    cheng_str_release_owned(p1)
    return line

fn cheng_bounds_failure_message(len: int32, idx: int32): ptr =
    let idxText: ptr = driver_c_i32_to_str_export(idx)
    let lenText: ptr = driver_c_i32_to_str_export(len)
    let prefix: ptr = cheng_raw_concat_export("[cheng] bounds check failed: idx=", idxText)
    let withLenPrefix: ptr = cheng_raw_concat_export(prefix, " len=")
    let out: ptr = cheng_raw_concat_export(withLenPrefix, lenText)
    cheng_free_export(idxText)
    cheng_free_export(lenText)
    cheng_free_export(prefix)
    cheng_free_export(withLenPrefix)
    return out

fn cheng_getcwd(): ptr =
    if cheng_getcwd_ready != 1 || cheng_getcwd_buf == nil:
        cheng_getcwd_buf = cheng_malloc_export(4096)
        if cheng_getcwd_buf == nil:
            return nil
        cheng_getcwd_ready = 1
    cheng_bytes_set(cheng_getcwd_buf, 0, 4096)
    let raw = libc_getcwd(cheng_getcwd_buf, 4096)
    if raw == nil:
        return nil
    *(UInt8Ptr(cheng_ptr_plus(cheng_getcwd_buf, 4095))) = uint8(0)
    return cheng_getcwd_buf

fn cheng_system_entropy_fill(dst: ptr, len: int32): int32 =
    if dst == nil || len <= 0:
        return 0
    var offset: int32
    while offset < len:
        var chunk: int32 = len - offset
        if chunk > 256:
            chunk = 256
        if libc_getentropy(cheng_ptr_plus(dst, offset), chunk) != 0:
            return 0
        offset = offset + chunk
    return 1

fn cheng_exec_cmd_fill_workdir_prefix(dst: ptr, workingDir: ptr): int32 =
    let wdLen: int32 = cheng_cstrlen_raw(workingDir)
    if wdLen <= 0:
        return 0
    return 9 + wdLen

fn cheng_exec_cmd_fill_merge_suffix(dst: ptr, pos: int32) =
    return

fn cheng_exec_shell_quote_len(raw: ptr, rawLen0: int32): int32 =
    let rawLen: int32 = rawLen0 < 0 ? 0 : rawLen0
    var total: int32 = 2
    var i: int32
    for i in i..<rawLen:
        if *(UInt8Ptr(ptr(uint64(int64(uint64(raw)) + int64(i))))) == uint8(39):
            total = total + 5
        else:
            total = total + 1
    return total

fn cheng_exec_shell_quote_write(dst: ptr, raw: ptr, rawLen0: int32): int32 =
    let rawLen: int32 = rawLen0 < 0 ? 0 : rawLen0
    if dst == nil:
        return 0
    var pos: int32
    *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(39)
    pos = pos + 1
    var i: int32
    for i in i..<rawLen:
        let ch: uint8 = *(UInt8Ptr(ptr(uint64(int64(uint64(raw)) + int64(i)))))
        if ch == uint8(39):
            *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(39)
            pos = pos + 1
            *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(34)
            pos = pos + 1
            *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(39)
            pos = pos + 1
            *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(34)
            pos = pos + 1
            *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(39)
            pos = pos + 1
        else:
            *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = ch
            pos = pos + 1
    *(UInt8Ptr(ptr(uint64(int64(uint64(dst)) + int64(pos))))) = uint8(39)
    return pos + 1

fn cheng_exec_shell_quote(raw: ptr): ptr =
    let rawLen: int32 = cheng_cstrlen_raw(raw)
    let total: int32 = cheng_exec_shell_quote_len(raw, rawLen)
    let out: ptr = cheng_malloc_export(total + 1)
    if out == nil:
        return nil
    let written: int32 = cheng_exec_shell_quote_write(out, raw, rawLen)
    *(UInt8Ptr(ptr(uint64(int64(uint64(out)) + int64(written))))) = uint8(0)
    return out

fn cheng_exec_cmd_build_workdir_command(command: ptr, workingDir: ptr): ptr =
    let quotedWorkingDir: ptr = cheng_exec_shell_quote(workingDir)
    if quotedWorkingDir == nil:
        return nil
    let wdPrefix: ptr = cheng_raw_concat_export("cd ", quotedWorkingDir)
    cheng_free_export(quotedWorkingDir)
    if wdPrefix == nil:
        return nil
    let wdShell: ptr = cheng_raw_concat_export(wdPrefix, " && ")
    cheng_free_export(wdPrefix)
    if wdShell == nil:
        return nil
    let out: ptr = cheng_raw_concat_export(wdShell, command)
    cheng_free_export(wdShell)
    return out

fn cheng_exec_cmd_append_merge_suffix(command: ptr): ptr =
    return cheng_raw_concat_export(command, " 2>&1")

fn cheng_exec_cmd_capture(command: ptr, workingDir: ptr, mergeStderr: int32): ptr =
    cheng_exec_cmd_last_exit_code_runtime = int64(-1)
    if command == nil || *UInt8Ptr(command) == uint8(0):
        return cheng_string_copy("", 0)
    let argv: str[] = cheng_exec_program_shell_argv(command)
    let argvWire: str = cheng_exec_program_encode_wire_items(argv)
    var exitCode: int64 = -1
    let out: ptr = cheng_exec_program_capture_with_timeout("/bin/sh",
                                                           argvWire,
                                                           "",
                                                           workingDir,
                                                           mergeStderr,
                                                           0,
                                                           &exitCode)
    cheng_exec_cmd_last_exit_code_runtime = exitCode
    return out

fn cheng_exec_cmd_last_exit_code(): int64 =
    return cheng_exec_cmd_last_exit_code_runtime

fn cheng_exec_cmd_ex(command: ptr, workingDir: ptr, mergeStderr: int32, exitCode: ptr): ptr =
    let out: ptr = cheng_exec_cmd_capture(command, workingDir, mergeStderr)
    if exitCode != nil:
        ptrStoreI64(exitCode, cheng_exec_cmd_last_exit_code())
    return out

fn cheng_exec_cmd_status(command: ptr, workingDir: ptr): int32 =
    if command == nil || *UInt8Ptr(command) == uint8(0):
        return -1
    let previousDir: ptr = cheng_getcwd()
    var changedDir: int32
    if workingDir != nil && *UInt8Ptr(workingDir) != uint8(0):
        if libc_chdir_runtime(workingDir) != 0:
            return -1
        changedDir = 1
    let rc: int32 = libc_system_runtime(command)
    if changedDir != 0 && previousDir != nil && *UInt8Ptr(previousDir) != uint8(0):
        let _restoreDir = libc_chdir_runtime(previousDir)
    if rc < 0:
        return rc
    if rc >= 256:
        return rc / 256
    return rc

fn cheng_exec_program_empty_cstring(): ptr =
    return cheng_string_copy("", 0)

fn cheng_exec_program_seq_add(out: var str[], value: str) =
    let seqPtr: ptr = &out
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    let nextLen: int32 = hdr->len + 1
    cheng_seq_grow_inst_export(seqPtr, nextLen, int32(sizeof(str)))
    let hdrAfter: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    let slot: StrPtr = StrPtr(cheng_ptr_plus(hdrAfter->buffer, hdrAfter->len * int32(sizeof(str))))
    cheng_str_store_slot(ptr(slot), value)
    value.data = nil
    value.len = 0
    value.store_id = 0
    value.flags = 0
    hdrAfter->len = nextLen

@exportc("cheng_seq_str_add")
fn cheng_seq_str_add(seqPtr: ptr, valuePtr: ptr) =
    if seqPtr == nil || valuePtr == nil:
        return
    let valueRaw: StrPtr = StrPtr(valuePtr)
    var value: str
    value.data = valueRaw->data
    value.len = valueRaw->len
    value.store_id = valueRaw->store_id
    value.flags = valueRaw->flags
    let hdr: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    let nextLen: int32 = hdr->len + 1
    cheng_seq_grow_inst_export(seqPtr, nextLen, int32(sizeof(str)))
    let hdrAfter: ChengSeqHeaderPtr = ChengSeqHeaderPtr(seqPtr)
    let slot: StrPtr = StrPtr(cheng_ptr_plus(hdrAfter->buffer, hdrAfter->len * int32(sizeof(str))))
    cheng_str_store_slot(ptr(slot), value)
    hdrAfter->len = nextLen

fn cheng_exec_program_encode_wire_items(items: str[]): str =
    var out = ""
    var i: int32
    for i in i..<len(items):
        let item: str = items[i]
        let itemLen: int32 = cheng_str_len(item)
        let lenRaw: ptr = driver_c_i32_to_str_export(itemLen)
        cheng_runtime_concat_assign_cstring(out, lenRaw)
        cheng_free_export(lenRaw)
        cheng_runtime_concat_assign_cstring(out, ":")
        cheng_runtime_concat_assign(out, item)
    return out

fn cheng_exec_program_decode_wire_items(wire: str): str[] =
    var out: str[]
    let wireLen: int32 = cheng_str_len(wire)
    if wireLen <= 0:
        return out
    let wireData: ptr = cheng_str_data(wire)
    var pos: int32
    while pos < wireLen:
        let itemLen = cheng_exec_program_wire_read_len(wireData, wireLen, pos)
        if itemLen < 0 || pos + itemLen > wireLen:
            panic("cheng exec argv wire invalid")
        if cheng_exec_program_bytes_contains_nul(cheng_ptr_plus(wireData, pos), itemLen):
            panic("cheng exec argv contains NUL")
        cheng_exec_program_seq_add(out, cheng_str_copy(cheng_ptr_plus(wireData, pos), itemLen))
        pos = pos + itemLen
    return out

fn cheng_exec_program_shell_argv(command: ptr): str[] =
    var out: str[]
    cheng_exec_program_seq_add(out, "-lc")
    cheng_exec_program_seq_add(out, cheng_str_copy_cstring(command))
    return out

fn cheng_exec_program_wait_status_exit_code(waitStatus: int32): int32 =
    if waitStatus < 0:
        return -1
    let signalCode: int32 = waitStatus & 127
    if signalCode == 0:
        return (waitStatus >> 8) & 255
    return 128 + signalCode

fn cheng_exec_program_set_exit_code(exitCode: Int64Ptr, code: int32) =
    if exitCode != nil:
        *exitCode = int64(code)

fn cheng_exec_program_free_argv(argvRaw: ptr, argc: int32) =
    if argvRaw == nil:
        return
    var i: int32
    for i in i..<argc:
        let item = *(VoidPtrPtr(cheng_ptr_plus(argvRaw, i * int32(sizeof(ptr)))))
        if item != nil:
            cheng_free_export(item)
    cheng_free_export(argvRaw)

fn cheng_exec_program_wire_read_len(wireData: ptr, wireLen: int32, pos: var int32): int32 =
    if wireData == nil || pos >= wireLen:
        return -1
    var n: int32
    var sawDigit: bool
    while pos < wireLen:
        let ch = *(UInt8Ptr(cheng_ptr_plus(wireData, pos)))
        if ch == uint8(58):
            if !sawDigit:
                return -1
            pos = pos + 1
            return n
        if ch < uint8(48) || ch > uint8(57):
            return -1
        sawDigit = true
        n = n * 10 + int32(ch - uint8(48))
        if n < 0 || n > wireLen:
            return -1
        pos = pos + 1
    return -1

fn cheng_exec_program_bytes_contains_nul(data: ptr, n: int32): bool =
    # Same pure-path miscompile as cheng_str_contains_nul: counted-loop
    # `*(UInt8Ptr(cheng_ptr_plus(data, i)))` omits the load. Walk bare ptr.
    if data == nil:
        return false
    var p = data
    var left = n
    while left > 0:
        if *(UInt8Ptr(p)) == uint8(0):
            return true
        p = cheng_ptr_plus(p, 1)
        left = left - 1
    return false

@borrows
fn cheng_exec_program_append_wire_items(argvRaw: ptr,
                                        builtCount: var int32,
                                        wire: str): bool =
    let wireLen = cheng_str_len(wire)
    let wireData = cheng_str_data(wire)
    var pos: int32
    while pos < wireLen:
        let itemLen = cheng_exec_program_wire_read_len(wireData, wireLen, pos)
        if itemLen < 0 || pos + itemLen > wireLen:
            panic("cheng exec argv wire invalid")
        if cheng_exec_program_bytes_contains_nul(cheng_ptr_plus(wireData, pos), itemLen):
            panic("cheng exec argv contains NUL")
        let argCopy: ptr = cheng_string_copy(cheng_ptr_plus(wireData, pos), itemLen)
        if argCopy == nil:
            return false
        store_ptr_export(cheng_ptr_plus(argvRaw, builtCount * int32(sizeof(ptr))), argCopy)
        builtCount = builtCount + 1
        pos = pos + itemLen
    return true

@borrows
fn cheng_exec_program_argv_wire_count(argvWire: str): int32 =
    let wireLen = cheng_str_len(argvWire)
    if wireLen <= 0:
        return 0
    let wireData = cheng_str_data(argvWire)
    var count: int32
    var pos: int32
    while pos < wireLen:
        let itemLen = cheng_exec_program_wire_read_len(wireData, wireLen, pos)
        if itemLen < 0 || pos + itemLen > wireLen:
            panic("cheng exec argv wire invalid")
        if cheng_exec_program_bytes_contains_nul(cheng_ptr_plus(wireData, pos), itemLen):
            panic("cheng exec argv contains NUL")
        pos = pos + itemLen
        count = count + 1
    return count

@borrows
fn cheng_exec_program_build_argv(programName: ptr, argvWire: str): ptr =
    let argCount = cheng_exec_program_argv_wire_count(argvWire)
    let slotCount: int32 = argCount + 2
    let argvRaw: ptr = cheng_malloc_export(slotCount * int32(sizeof(ptr)))
    if argvRaw == nil:
