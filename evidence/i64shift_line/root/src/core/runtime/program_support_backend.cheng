    let runtimeRaw = cheng_ffi_handle_retire_take_ptr(handle)
    if runtimeRaw == nil:
        return -1
    let runtime = ChengTailnetProviderRuntimePtr(runtimeRaw)
    cheng_tailnet_provider_runtime_dispose(runtime)
    if cheng_tailnet_provider_active_count > 0:
        cheng_tailnet_provider_active_count = cheng_tailnet_provider_active_count - 1
    return 0

@exportc("cheng_tailnet_provider_active_count_bridge")
