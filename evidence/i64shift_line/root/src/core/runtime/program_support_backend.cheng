@exportc("cheng_tcp_loopback_request_response_handle_bridge")
@abi_internal
fn cheng_tcp_loopback_request_response_handle_bridge_export(protocolText: str,
                                                               requestHandle: uint64,
                                                               responseHandle: uint64): uint64 =
    var requestBorrowGeneration: uint64
    var responseBorrowGeneration: uint64
    var requestMem: ptr
    var responseMem: ptr
    let sameInputHandle = responseHandle == requestHandle
    cheng_runtime_lock()
    let pairRc = cheng_ffi_handle_lease_pair_acquire_locked(
        requestHandle,
        responseHandle,
        &requestMem,
        &requestBorrowGeneration,
        &responseMem,
        &responseBorrowGeneration)
    cheng_runtime_unlock()
    if pairRc != 0:
        cheng_tcp_last_error_set_ptr(
            " libp2p tcp: input handle unavailable")
        return uint64(0)
    let requestLen = cheng_buffer_handle_len(requestMem)
    let responseLen = cheng_buffer_handle_len(responseMem)
    if requestLen < 0 || responseLen < 0:
        if !sameInputHandle:
            let responseReleased =
                cheng_ffi_handle_lease_release_or_abort(
                    responseHandle, responseBorrowGeneration)
            responseReleased
        let requestReleased = cheng_ffi_handle_lease_release_or_abort(
            requestHandle, requestBorrowGeneration)
        requestReleased
        cheng_tcp_last_error_set_ptr(" libp2p tcp: invalid input handle")
        return uint64(0)
    var requestWire = cheng_str_copy(cheng_buffer_handle_payload_ptr(requestMem), requestLen)
    var responseWire = cheng_str_copy(cheng_buffer_handle_payload_ptr(responseMem), responseLen)
    var inputLeasesReleased = true
    if !sameInputHandle:
        inputLeasesReleased =
            cheng_ffi_handle_lease_release_or_abort(
                responseHandle, responseBorrowGeneration)
    if !cheng_ffi_handle_lease_release_or_abort(
            requestHandle, requestBorrowGeneration):
        inputLeasesReleased = false
    if !inputLeasesReleased:
        cheng_str_dispose(requestWire)
        cheng_str_dispose(responseWire)
        return uint64(0)
    var clientResponseWire = cheng_str_empty()
    var errWire = cheng_str_empty()
    let ok = cheng_tcp_loopback_request_response_impl_bridge_export(protocolText,
                                                                       requestWire,
                                                                       responseWire,
                                                                       clientResponseWire,
                                                                       errWire)
    cheng_str_dispose(requestWire)
    cheng_str_dispose(responseWire)
    let handle = ok != 0 ? cheng_buffer_handle_new_from_str(clientResponseWire) : uint64(0)
    if handle == uint64(0):
        if cheng_str_len(errWire) > 0:
            cheng_tcp_last_error_set(errWire)
        else:
            cheng_tcp_last_error_set_ptr(" libp2p tcp: loopback handle failed")
    else:
        cheng_tcp_last_error_clear()
    cheng_str_dispose(clientResponseWire)
    cheng_str_dispose(errWire)
    return handle
