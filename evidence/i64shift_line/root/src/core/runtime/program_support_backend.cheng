@exportc("driver_c_status_bridge")
fn driver_c_status_bridge_export(): int32 =
    let ignored0 = driver_c_stdout_line_return2_bridge_export("cheng")
    let ignored1 = driver_c_stdout_line_return2_bridge_export("schema=cheng.compiler_runtime")
    let ignored2 = driver_c_stdout_line_return2_bridge_export("execution=argv_control_plane")
    let ignored3 = driver_c_stdout_line_return2_bridge_export("bootstrap_mode=selfhost")
    let ignored4 = driver_c_stdout_line_return2_bridge_export("compiler_entry=src/core/tooling/backend_driver_dispatch_min.cheng")
    let ignored5 = driver_c_stdout_line_return2_bridge_export("ordinary_command=system-link-exec")
    let ignored6 = driver_c_stdout_line_return2_bridge_export("ordinary_pipeline=canonical_csg_verified_primary_object_codegen_ready")
    let ignored7 = driver_c_stdout_line_return2_bridge_export("stage3=artifacts/bootstrap/cheng.stage3")
    return 0

@exportc("driver_c_status_from_cmdline_bridge")
fn driver_c_status_from_cmdline_bridge_export(): int32 =
    let statusCode = driver_c_status_bridge_export()
    let packageRoot = driver_c_read_flag_or_default_bridge_export("--root", "")
    let sourcePath = driver_c_read_flag_or_default_bridge_export("--in", "")
    let outputPath = driver_c_read_flag_or_default_bridge_export("--out", "")
    if driver_c_str_eq_bridge_export(packageRoot, "") != 0 &&
       driver_c_str_eq_bridge_export(sourcePath, "") != 0 &&
       driver_c_str_eq_bridge_export(outputPath, "") != 0:
        return statusCode
    var rootLine = driver_c_str_concat_bridge_export("flag_root=", packageRoot)
    let ignoredRoot = driver_c_stdout_line_return2_bridge_export(rootLine)
    cheng_str_release_owned(rootLine)
    var inLine = driver_c_str_concat_bridge_export("flag_in=", sourcePath)
    let ignoredIn = driver_c_stdout_line_return2_bridge_export(inLine)
    cheng_str_release_owned(inLine)
    if driver_c_str_eq_bridge_export(sourcePath, "") != 0 &&
       driver_c_str_eq_bridge_export(outputPath, "") != 0:
        return statusCode
    if driver_c_str_eq_bridge_export(packageRoot, "") != 0 ||
       driver_c_str_eq_bridge_export(sourcePath, "") != 0 ||
       driver_c_str_eq_bridge_export(outputPath, "") != 0:
        let ignoredErr = driver_c_stdout_line_return2_bridge_export("flag_exec_edges=err")
        let ignoredMissing = driver_c_stdout_line_return2_bridge_export("flag_exec_unresolved=missing_required_status_flag")
        return 2
    let ignoredEdges = driver_c_stdout_line_return2_bridge_export("flag_exec_edges=status_only")
    let ignoredUnresolved = driver_c_stdout_line_return2_bridge_export("flag_exec_unresolved=0")
    return statusCode

