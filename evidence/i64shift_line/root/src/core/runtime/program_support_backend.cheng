    let elemBytes: int32 = cheng_seq_string_elem_bytes_compat_export()
    var rawBuffer: ptr = nil
    if bufCap > 0:
        rawBuffer = cheng_malloc_export(cheng_seq_alloc_bytes_checked(bufCap, elemBytes))
        if rawBuffer == nil:
            panic("cheng seq_string_init: alloc failed")
    seqHdr->buffer = rawBuffer
