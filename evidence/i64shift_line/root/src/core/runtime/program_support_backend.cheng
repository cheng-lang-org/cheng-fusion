    let rawNew = cheng_copy_cstring_from_str(newPath)
    if rawNew == nil:
        cheng_free_export(rawOld)
        return -1
    let rc = libc_rename_runtime(rawOld, rawNew)
    cheng_free_export(rawOld)
    cheng_free_export(rawNew)
    return rc

