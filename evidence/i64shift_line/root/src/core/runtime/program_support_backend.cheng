const
    chengBufferHandleMagic: int32 = 1128817459

fn cheng_buffer_handle_payload_ptr(raw: ptr): ptr =
    if raw == nil:
        return nil
    return cheng_ptr_plus(raw, 8)

@borrows
fn cheng_buffer_handle_new_from_str(s: str): uint64 =
    let n = cheng_str_len(s)
    let mem = cheng_malloc_export(8 + n)
    if mem == nil:
        return uint64(0)
    *(Int32Ptr(mem)) = chengBufferHandleMagic
    *(Int32Ptr(cheng_ptr_plus(mem, 4))) = n
    if n > 0:
        cheng_bytes_copy(cheng_buffer_handle_payload_ptr(mem), cheng_str_data(s), n)
    let handle = cheng_ffi_handle_register_ptr_export(mem)
    if handle == uint64(0):
        cheng_free_export(mem)
    return handle

fn cheng_buffer_handle_new_from_buf(data: ptr, n: int32): uint64 =
    if n < 0:
        return uint64(0)
    let mem = cheng_malloc_export(8 + n)
    if mem == nil:
        return uint64(0)
    *(Int32Ptr(mem)) = chengBufferHandleMagic
    *(Int32Ptr(cheng_ptr_plus(mem, 4))) = n
    if n > 0:
        cheng_bytes_copy(cheng_buffer_handle_payload_ptr(mem), data, n)
    let handle = cheng_ffi_handle_register_ptr_export(mem)
    if handle == uint64(0):
        cheng_free_export(mem)
    return handle

fn cheng_buffer_handle_len(raw: ptr): int32 =
    if raw == nil || *(Int32Ptr(raw)) != chengBufferHandleMagic:
        return -1
    return *(Int32Ptr(cheng_ptr_plus(raw, 4)))

# --- production held-exec one-shot channel ---------------------------------
#
# The public Cheng surface in std/system carries only scalar/CID values.  OS
# addresses, argv vectors, socket credentials and retained descriptors remain
# inside this always-linked runtime provider.  Linux uses one inherited
# SOCK_SEQPACKET endpoint at fd 198 and execveat(AT_EMPTY_PATH).  Each phase is
# transcript-bound to a random ticket and acknowledged before the child can
# advance.  EOF, signal death, replay, a short packet, or a non-zero wait
# status is terminal failure; there is no pathname or process-local fallback.

type
    ChengHeldExecWire =
        data: uint8[768]
    ChengHeldExecPlanEvidenceCanonical =
        data: uint8[643]
    ChengHeldExecFinishedUploadHeader =
        data: uint8[256]
    ChengHeldExecFinishedRecoveryCanonical =
        data: uint8[352]
    ChengHeldExecFdDigestResult =
        status: int32
        reserved: int32
        digest0: uint64
        digest1: uint64
        digest2: uint64
        digest3: uint64
        byteCount: uint64
    ChengHeldExecCredentialedReceiveResult =
        status: int32
        fd: int32 = -1
        pid: int32 = -1
        uid: uint32
        gid: uint32
    ChengHeldExecCredentialedVector3ReceiveResult =
        status: int32
        pid: int32 = -1
        uid: uint32
        gid: uint32
    ChengHeldExecBundleTakeResult =
        status: int32
        errorCode: int32
        byteCount: int32
        digest0: uint64
        digest1: uint64
        digest2: uint64
        digest3: uint64
    ChengHeldExecBundleSealResult =
        status: int32
        errorCode: int32
        fd: int32
        reserved: int32
        byteCount: uint64
        digest0: uint64
        digest1: uint64
        digest2: uint64
        digest3: uint64
    ChengHeldExecChildResult =
        status: int32
        errorCode: int32
        digest0: uint64
        digest1: uint64
        digest2: uint64
        digest3: uint64
    ChengHeldExecParentRunResult =
        status: int32
        errorCode: int32
        exitCode: int32
        reserved: int32
        outputBytes: uint64
        childIdentity0: uint64
        childIdentity1: uint64
        childIdentity2: uint64
        childIdentity3: uint64
        terminalReceipt0: uint64
        terminalReceipt1: uint64
        terminalReceipt2: uint64
        terminalReceipt3: uint64
        observedOutput0: uint64
        observedOutput1: uint64
        observedOutput2: uint64
        observedOutput3: uint64
    ChengHeldExecParentClaimResult =
        status: int32
        errorCode: int32
        session: int32
        childPid: int32
        childUid: uint32
        childGid: uint32
        phase: int32
        reserved: int32
        childBirthPlatform: int32
        childBirthReserved: int32
        childBirth0: uint64
        childBirth1: uint64
        childBirthReceipt0: uint64
        childBirthReceipt1: uint64
        childBirthReceipt2: uint64
