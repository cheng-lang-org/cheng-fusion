@exportc("driver_c_read_flag_or_default_bridge")
@abi_internal
@borrows
fn driver_c_read_flag_or_default_bridge_export(key: str, defaultValue: str): str =
    let defaultData = cheng_str_data(defaultValue)
    let defaultLen = cheng_str_len(defaultValue)
    let count = cheng_runtime_param_count()
    if count <= 1:
        let copied = cheng_str_copy(defaultData, defaultLen)
        return copied
    for i in 1..<count:
        let arg = cheng_runtime_param_str(i)
        var inlineValue: str
        if cheng_runtime_flag_inline_value(arg, key, inlineValue):
            return inlineValue
        if cheng_runtime_flag_key_matches(arg, key):
            if i + 1 >= count:
                let copied = cheng_str_copy(defaultData, defaultLen)
                return copied
            let value = cheng_runtime_param_str(i + 1)
            let copied = cheng_str_copy(cheng_str_data(value), cheng_str_len(value))
            return copied
    let copied = cheng_str_copy(defaultData, defaultLen)
    return copied

@exportc("driver_c_read_flag_value_bridge")
@abi_internal
@borrows
fn driver_c_read_flag_value_bridge_export(key: str, outValue: var str): bool =
    outValue = cheng_str_empty()
    let count = cheng_runtime_param_count()
    if count <= 1:
        return false
    for i in 1..<count:
        let arg = cheng_runtime_param_str(i)
        if cheng_runtime_flag_inline_value(arg, key, outValue):
            return true
        if cheng_runtime_flag_key_matches(arg, key):
            if i + 1 >= count:
                return false
            let value = cheng_runtime_param_str(i + 1)
            outValue = cheng_str_copy(cheng_str_data(value), cheng_str_len(value))
            return true
    return false

@exportc("driver_c_read_flag_raw_ptr_bridge")
fn driver_c_read_flag_raw_ptr_bridge_export(keyData: ptr,
                                             keyLen: int32,
                                             defaultData: ptr,
                                             defaultLen: int32): ptr =
    let count = cheng_runtime_param_count()
    defaultLen
    if count <= 1:
        return defaultData
    for i in 1..<count:
        let argRaw = cheng_runtime_param_raw(i)
        let argLen = cheng_cstrlen_raw(argRaw)
        if keyLen > 0 && argLen > keyLen && cheng_bytes_compare(argRaw, keyData, keyLen) == 0:
            let sep = *(UInt8Ptr(cheng_ptr_plus(argRaw, keyLen)))
            if int32(sep) == 58 || int32(sep) == 61:
                return cheng_ptr_plus(argRaw, keyLen + 1)
        if keyLen > 0 && argLen == keyLen && cheng_bytes_compare(argRaw, keyData, keyLen) == 0:
            if i + 1 >= count:
                return defaultData
            return cheng_runtime_param_raw(i + 1)
    return defaultData

@exportc("driver_c_read_flag_raw_len_bridge")
fn driver_c_read_flag_raw_len_bridge_export(keyData: ptr,
                                             keyLen: int32,
                                             defaultData: ptr,
                                             defaultLen: int32): int32 =
    let count = cheng_runtime_param_count()
    defaultData
    if count <= 1:
        return defaultLen
    for i in 1..<count:
        let argRaw = cheng_runtime_param_raw(i)
        let argLen = cheng_cstrlen_raw(argRaw)
        if keyLen > 0 && argLen > keyLen && cheng_bytes_compare(argRaw, keyData, keyLen) == 0:
            let sep = *(UInt8Ptr(cheng_ptr_plus(argRaw, keyLen)))
            if int32(sep) == 58 || int32(sep) == 61:
                return argLen - keyLen - 1
        if keyLen > 0 && argLen == keyLen && cheng_bytes_compare(argRaw, keyData, keyLen) == 0:
            if i + 1 >= count:
                return defaultLen
            return cheng_cstrlen_raw(cheng_runtime_param_raw(i + 1))
    return defaultLen

fn driver_c_read_flag_code_key_len(code: int32): int32 =
    # Pure backend cannot lower string-literal -> ptr; never strlen on key().
    if code == 1:
        return 6
    if code == 2:
        return 5
    if code == 3:
        return 4
    if code == 4:
        return 12
    if code == 5:
        return 8
    if code == 6:
        return 14
    if code == 7:
        return 23
    if code == 8:
        return 6
    if code == 9:
        return 18
    if code == 10:
        return 20
    if code == 11:
        return 18
    if code == 12:
        return 25
    if code == 13:
        return 12
    if code == 14:
        return 6
    if code == 15:
        return 18
    if code == 16:
        return 9
    return 0

fn driver_c_read_flag_code_key_byte(code: int32, idx: int32): uint8 =
    # Pure backend cannot lower string-literal -> ptr; encode keys as bytes.
    if idx == 0 || idx == 1:
        return uint8(45)
    if code == 1:
        if idx == 2: return uint8(114)
        if idx == 3: return uint8(111)
        if idx == 4: return uint8(111)
        if idx == 5: return uint8(116)
    if code == 2:
        if idx == 2: return uint8(111)
        if idx == 3: return uint8(117)
        if idx == 4: return uint8(116)
    if code == 3:
        if idx == 2: return uint8(105)
        if idx == 3: return uint8(110)
    if code == 4:
        if idx == 2: return uint8(114)
