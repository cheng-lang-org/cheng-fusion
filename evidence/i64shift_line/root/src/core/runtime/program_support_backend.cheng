    cheng_runtime_lock()
    chengTerminalSessionLiveLockOwnerFds[row] = -1
    chengTerminalSessionLiveLockOwnerCloseReceipts[row] = receipt
    chengTerminalSessionLiveLockOwnerStates[row] = receipt == 1 ?
        chengTerminalSessionLiveLockOwnerReleased :
        chengTerminalSessionLiveLockOwnerRecoveryRequired
    cheng_runtime_unlock()
    return receipt == 1 ? 1 : 0

@exportc("cheng_atomic_tree_open_terminal_finished_recovery_owner_bridge")
@abi_internal
fn cheng_atomic_tree_open_terminal_finished_recovery_owner_bridge_export(
        handle: uint64,
        childPid: int32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64,
        outErr: ptr): int32 =
    if childPid <= 0 ||
       (childBirthPlatform != 1 && childBirthPlatform != 2) ||
       childBirth0 == uint64(0) ||
       (childBirthPlatform == 2 && childBirth1 != uint64(0)) ||
       (childBirthPlatform == 1 && childBirth1 >= uint64(1000000)):
        return -1
    cheng_runtime_lock()
    let row = chengHeldExecFinishedRecoveryOwnerNextRow
    if row < 0 || row >= chengHeldExecFinishedRecoveryOwnerCount ||
       chengHeldExecFinishedRecoveryOwnerStates[row] != 0:
        cheng_runtime_unlock()
        return -1
    chengHeldExecFinishedRecoveryOwnerNextRow = row + 1
    chengHeldExecFinishedRecoveryOwnerReaders[row] = -1
    chengHeldExecFinishedRecoveryOwnerSyncWriters[row] = -1
    chengHeldExecFinishedRecoveryOwnerReaderCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecFinishedRecoveryOwnerSyncWriterCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecFinishedRecoveryOwnerReaderCloseReceipts[row] = 0
    chengHeldExecFinishedRecoveryOwnerSyncWriterCloseReceipts[row] = 0
    chengHeldExecFinishedRecoveryOwnerWatchOwners[row] = -1
    chengHeldExecFinishedRecoveryOwnerChildPids[row] = childPid
    chengHeldExecFinishedRecoveryOwnerChildBirthPlatforms[row] =
        childBirthPlatform
    chengHeldExecFinishedRecoveryOwnerChildBirth0[row] = childBirth0
    chengHeldExecFinishedRecoveryOwnerChildBirth1[row] = childBirth1
    chengHeldExecFinishedRecoveryOwnerStates[row] =
        chengHeldExecFinishedRecoveryOwnerOpening
    cheng_runtime_unlock()
    var finishedReader: int32
    var finishedSyncWriter: int32
    if cheng_atomic_tree_open_terminal_finished_recovery_pair_bridge(
           handle,
           &finishedReader,
           &finishedSyncWriter,
           outErr) != 1:
        cheng_runtime_lock()
        chengHeldExecFinishedRecoveryOwnerStates[row] =
            chengHeldExecFinishedRecoveryOwnerAborted
        cheng_runtime_unlock()
        return -1
    cheng_runtime_lock()
    if chengHeldExecFinishedRecoveryOwnerStates[row] !=
           chengHeldExecFinishedRecoveryOwnerOpening:
        chengHeldExecFinishedRecoveryOwnerReaders[row] = finishedReader
        chengHeldExecFinishedRecoveryOwnerSyncWriters[row] =
            finishedSyncWriter
        chengHeldExecFinishedRecoveryOwnerReaderCloseStates[row] =
            chengHeldExecFdCloseOpen
        chengHeldExecFinishedRecoveryOwnerSyncWriterCloseStates[row] =
            chengHeldExecFdCloseOpen
        cheng_runtime_unlock()
        let readerClosed =
            cheng_held_exec_finished_recovery_owner_close_fd_once(
                row, chengHeldExecRecoveryFdReader)
        let syncWriterClosed =
            cheng_held_exec_finished_recovery_owner_close_fd_once(
                row, chengHeldExecRecoveryFdSyncWriter)
        cheng_runtime_lock()
        chengHeldExecFinishedRecoveryOwnerStates[row] =
            (readerClosed && syncWriterClosed) ?
                chengHeldExecFinishedRecoveryOwnerAborted :
                chengHeldExecFinishedRecoveryOwnerRecoveryRequired
        cheng_runtime_unlock()
        return -1
    chengHeldExecFinishedRecoveryOwnerReaders[row] = finishedReader
    chengHeldExecFinishedRecoveryOwnerSyncWriters[row] =
        finishedSyncWriter
    chengHeldExecFinishedRecoveryOwnerReaderCloseStates[row] =
        chengHeldExecFdCloseOpen
    chengHeldExecFinishedRecoveryOwnerSyncWriterCloseStates[row] =
        chengHeldExecFdCloseOpen
    chengHeldExecFinishedRecoveryOwnerStates[row] =
        chengHeldExecFinishedRecoveryOwnerIssued
    cheng_runtime_unlock()
    return row + 1

@exportc("cheng_held_exec_finished_recovery_owner_abort")
@abi_internal
fn cheng_held_exec_finished_recovery_owner_abort_export(
        recoveryOwner: int32): int32 =
    let row = recoveryOwner - 1
    if row < 0 || row >= chengHeldExecFinishedRecoveryOwnerCount:
        return 0
    cheng_runtime_lock()
    if row >= chengHeldExecFinishedRecoveryOwnerNextRow ||
       (chengHeldExecFinishedRecoveryOwnerStates[row] !=
            chengHeldExecFinishedRecoveryOwnerIssued &&
        chengHeldExecFinishedRecoveryOwnerStates[row] !=
            chengHeldExecFinishedRecoveryOwnerAborted &&
        chengHeldExecFinishedRecoveryOwnerStates[row] !=
            chengHeldExecFinishedRecoveryOwnerRecoveryRequired):
        cheng_runtime_unlock()
        return 0
    let watchOwner =
        chengHeldExecFinishedRecoveryOwnerWatchOwners[row]
    cheng_runtime_unlock()
    let readerClosed =
        cheng_held_exec_finished_recovery_owner_close_fd_once(
            row, chengHeldExecRecoveryFdReader)
    let syncWriterClosed =
        cheng_held_exec_finished_recovery_owner_close_fd_once(
            row, chengHeldExecRecoveryFdSyncWriter)
    let watchClosed = watchOwner < 0 ||
        libc_terminal_decision_watch_close_runtime(watchOwner) == 1
    cheng_runtime_lock()
    if watchClosed:
        chengHeldExecFinishedRecoveryOwnerWatchOwners[row] = -1
    chengHeldExecFinishedRecoveryOwnerStates[row] =
        (readerClosed && syncWriterClosed && watchClosed) ?
            chengHeldExecFinishedRecoveryOwnerAborted :
            chengHeldExecFinishedRecoveryOwnerRecoveryRequired
    cheng_runtime_unlock()
    return readerClosed && syncWriterClosed && watchClosed ? 1 : 0

# This bridge is the only point where the four inode descriptors exist as
# separate scalars. It immediately seals them into one append-only provider
# row; Cheng callers receive only row+1:int32.
@exportc("cheng_atomic_tree_open_terminal_capsule_role_owner_bridge")
@abi_internal
fn cheng_atomic_tree_open_terminal_capsule_role_owner_bridge_export(
        handle: uint64,
        outExitPermission0: ptr,
        outExitPermission1: ptr,
        outExitPermission2: ptr,
        outExitPermission3: ptr,
        outReapPermission0: ptr,
        outReapPermission1: ptr,
        outReapPermission2: ptr,
        outReapPermission3: ptr,
        outErr: ptr): int32 =
    if outExitPermission0 == nil || outExitPermission1 == nil ||
       outExitPermission2 == nil || outExitPermission3 == nil ||
       outReapPermission0 == nil || outReapPermission1 == nil ||
       outReapPermission2 == nil || outReapPermission3 == nil:
        return -1
    *(Int32Ptr(outExitPermission0)) = 0
    *(Int32Ptr(outExitPermission1)) = 0
    *(Int32Ptr(outExitPermission2)) = 0
    *(Int32Ptr(outExitPermission3)) = 0
    *(Int32Ptr(outReapPermission0)) = 0
    *(Int32Ptr(outReapPermission1)) = 0
    *(Int32Ptr(outReapPermission2)) = 0
    *(Int32Ptr(outReapPermission3)) = 0
    # Reserve the append-only owner before opening any descriptor.  Every
    # partial-open failure therefore has a durable int32 row carrying all four
    # close-once receipts; -row-2 reports failure while still returning the
    # recoverable owner identity to the Cheng wrapper.
    cheng_runtime_lock()
    let row = chengHeldExecCapsuleProviderRoleNextRow
    if row < 0 || row >= chengHeldExecCapsuleProviderRoleCount ||
       chengHeldExecCapsuleProviderRoleStates[row] != 0:
        cheng_runtime_unlock()
        return -1
    chengHeldExecCapsuleProviderRoleNextRow = row + 1
    chengHeldExecCapsuleProviderRoleFinishedWriters[row] = -1
    chengHeldExecCapsuleProviderRoleFinishedReaders[row] = -1
    chengHeldExecCapsuleProviderRoleDecisionWriters[row] = -1
    chengHeldExecCapsuleProviderRoleDecisionReaders[row] = -1
    chengHeldExecCapsuleProviderRoleBundleReaderCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecCapsuleProviderRoleBundleReaderCloseReceipts[row] = 0
    chengHeldExecCapsuleProviderRoleFinishedWriterCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecCapsuleProviderRoleFinishedReaderCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecCapsuleProviderRoleDecisionWriterCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecCapsuleProviderRoleDecisionReaderCloseStates[row] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecCapsuleProviderRoleFinishedWriterCloseReceipts[row] = 0
    chengHeldExecCapsuleProviderRoleFinishedReaderCloseReceipts[row] = 0
    chengHeldExecCapsuleProviderRoleDecisionWriterCloseReceipts[row] = 0
    chengHeldExecCapsuleProviderRoleDecisionReaderCloseReceipts[row] = 0
    chengHeldExecCapsuleProviderRoleFinishedWatchOwners[row] = -1
    chengHeldExecCapsuleProviderRoleBundleReaders[row] = -1
    chengHeldExecCapsuleProviderRoleBundleDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleBundleByteCounts[row] = uint64(0)
    chengHeldExecCapsuleProviderRoleRuntimeSessions[row] = -1
    chengHeldExecCapsuleProviderRoleTerminalReceipts[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleChildIdentities[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleOutputDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleUploadDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleCompileReceiptCanonicals[row] =
        cheng_str_empty()
    chengHeldExecCapsuleProviderRoleOutputBytes[row] = uint64(0)
    chengHeldExecCapsuleProviderRoleExitCodes[row] = -1
    chengHeldExecCapsuleProviderRoleExitPermission0[row] = 0
    chengHeldExecCapsuleProviderRoleExitPermission1[row] = 0
    chengHeldExecCapsuleProviderRoleExitPermission2[row] = 0
    chengHeldExecCapsuleProviderRoleExitPermission3[row] = 0
    chengHeldExecCapsuleProviderRoleReapPermission0[row] = 0
    chengHeldExecCapsuleProviderRoleReapPermission1[row] = 0
    chengHeldExecCapsuleProviderRoleReapPermission2[row] = 0
    chengHeldExecCapsuleProviderRoleReapPermission3[row] = 0
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecCapsuleProviderRoleExitPermissionStates[row]),
        chengHeldExecTerminalPermissionUnbound)
    cheng_atomic_store_i32_export(
        ptr(&chengHeldExecCapsuleProviderRoleReapPermissionStates[row]),
        chengHeldExecTerminalPermissionUnbound)
    chengHeldExecCapsuleProviderRoleSessionCidDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleExitPredecessorDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleExitEvidenceBDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleReapPredecessorDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleReapEvidenceBDigests[row] =
        ChengFixedBytes32()
    chengHeldExecCapsuleProviderRoleStates[row] =
        chengHeldExecCapsuleProviderRoleOpening
    cheng_runtime_unlock()
    var permissions: uint64[4]
    if cheng_system_entropy_fill(ptr(&permissions[0]), 32) != 1 ||
       (permissions[0] == uint64(0) && permissions[1] == uint64(0)) ||
       (permissions[2] == uint64(0) && permissions[3] == uint64(0)) ||
       (permissions[0] == permissions[2] &&
        permissions[1] == permissions[3]):
        permissions[0] = uint64(0)
        permissions[1] = uint64(0)
        permissions[2] = uint64(0)
        permissions[3] = uint64(0)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[row] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return 0 - row - 2
    # Freeze the two 128-bit permissions into exact scalar value-defs before
    # any descriptor work.  The append-only row and caller cargo are populated
    # from these same values; no mutable SoA read participates in publication.
    let exitPermission0 =
        int32(uint32(permissions[0] & uint64(4294967295)))
    let exitPermission1 =
        int32(uint32(permissions[0] >> uint64(32)))
    let exitPermission2 =
        int32(uint32(permissions[1] & uint64(4294967295)))
    let exitPermission3 =
        int32(uint32(permissions[1] >> uint64(32)))
    let reapPermission0 =
        int32(uint32(permissions[2] & uint64(4294967295)))
    let reapPermission1 =
        int32(uint32(permissions[2] >> uint64(32)))
    let reapPermission2 =
        int32(uint32(permissions[3] & uint64(4294967295)))
    let reapPermission3 =
        int32(uint32(permissions[3] >> uint64(32)))
    var finishedWriter: int32
    var finishedReader: int32
    var decisionWriter: int32
    var decisionReader: int32
    if cheng_atomic_tree_open_existing_write_read_pair_bridge(
           handle,
           "finished-upload.bin",
           int64(0),
           &finishedWriter,
           &finishedReader,
           outErr) != 1:
        permissions[0] = uint64(0)
        permissions[1] = uint64(0)
        permissions[2] = uint64(0)
        permissions[3] = uint64(0)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[row] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return 0 - row - 2
    cheng_runtime_lock()
    chengHeldExecCapsuleProviderRoleFinishedWriters[row] = finishedWriter
    chengHeldExecCapsuleProviderRoleFinishedReaders[row] = finishedReader
    chengHeldExecCapsuleProviderRoleFinishedWriterCloseStates[row] =
        chengHeldExecFdCloseOpen
    chengHeldExecCapsuleProviderRoleFinishedReaderCloseStates[row] =
        chengHeldExecFdCloseOpen
    cheng_runtime_unlock()
    # The exclusive flock follows the finished writer open-file description
    # through SCM_RIGHTS.  A restart-only sync writer can therefore prove the
    # child writer has closed without trusting a lost CLOSE_WRITE event.
    if libc_flock_runtime(
           finishedWriter,
           chengAtomicTreeFlockExclusiveNonblocking) != 0:
        permissions[0] = uint64(0)
        permissions[1] = uint64(0)
        permissions[2] = uint64(0)
        permissions[3] = uint64(0)
        let _closed = cheng_held_exec_capsule_provider_role_close_four(row)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[row] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return 0 - row - 2
    if cheng_atomic_tree_open_existing_write_read_pair_bridge(
           handle,
           "decision-mirror.bin",
           int64(768),
           &decisionWriter,
           &decisionReader,
           outErr) != 1:
        permissions[0] = uint64(0)
        permissions[1] = uint64(0)
        permissions[2] = uint64(0)
        permissions[3] = uint64(0)
        let _closed = cheng_held_exec_capsule_provider_role_close_four(row)
        cheng_runtime_lock()
        chengHeldExecCapsuleProviderRoleStates[row] =
            chengHeldExecCapsuleProviderRoleRecoveryRequired
        cheng_runtime_unlock()
        return 0 - row - 2
    cheng_runtime_lock()
    if chengHeldExecCapsuleProviderRoleStates[row] !=
           chengHeldExecCapsuleProviderRoleOpening:
        chengHeldExecCapsuleProviderRoleDecisionWriters[row] =
            decisionWriter
        chengHeldExecCapsuleProviderRoleDecisionReaders[row] =
            decisionReader
        chengHeldExecCapsuleProviderRoleDecisionWriterCloseStates[row] =
            chengHeldExecFdCloseOpen
        chengHeldExecCapsuleProviderRoleDecisionReaderCloseStates[row] =
            chengHeldExecFdCloseOpen
        cheng_runtime_unlock()
        permissions[0] = uint64(0)
        permissions[1] = uint64(0)
        permissions[2] = uint64(0)
        permissions[3] = uint64(0)
        let _closedUnexpected =
            cheng_held_exec_capsule_provider_role_close_four(row)
        return 0 - row - 2
    chengHeldExecCapsuleProviderRoleDecisionWriters[row] = decisionWriter
    chengHeldExecCapsuleProviderRoleDecisionReaders[row] = decisionReader
    chengHeldExecCapsuleProviderRoleDecisionWriterCloseStates[row] =
        chengHeldExecFdCloseOpen
    chengHeldExecCapsuleProviderRoleDecisionReaderCloseStates[row] =
        chengHeldExecFdCloseOpen
    chengHeldExecCapsuleProviderRoleExitPermission0[row] = exitPermission0
    chengHeldExecCapsuleProviderRoleExitPermission1[row] = exitPermission1
    chengHeldExecCapsuleProviderRoleExitPermission2[row] = exitPermission2
    chengHeldExecCapsuleProviderRoleExitPermission3[row] = exitPermission3
    chengHeldExecCapsuleProviderRoleReapPermission0[row] = reapPermission0
    chengHeldExecCapsuleProviderRoleReapPermission1[row] = reapPermission1
    chengHeldExecCapsuleProviderRoleReapPermission2[row] = reapPermission2
    chengHeldExecCapsuleProviderRoleReapPermission3[row] = reapPermission3
    *(Int32Ptr(outExitPermission0)) = exitPermission0
    *(Int32Ptr(outExitPermission1)) = exitPermission1
    *(Int32Ptr(outExitPermission2)) = exitPermission2
    *(Int32Ptr(outExitPermission3)) = exitPermission3
    *(Int32Ptr(outReapPermission0)) = reapPermission0
    *(Int32Ptr(outReapPermission1)) = reapPermission1
    *(Int32Ptr(outReapPermission2)) = reapPermission2
    *(Int32Ptr(outReapPermission3)) = reapPermission3
    permissions[0] = uint64(0)
    permissions[1] = uint64(0)
    permissions[2] = uint64(0)
    permissions[3] = uint64(0)
    # Publish the provider role only after both private SoA and caller cargo
    # contain the exact immutable values.
    chengHeldExecCapsuleProviderRoleStates[row] =
        chengHeldExecCapsuleProviderRoleIssued
    cheng_runtime_unlock()
    return row + 1

# This is the sole move from a sealed-bundle owner into a capsule role owner.
# Both owners are resolved under the same provider lock and the exact digest
# is joined before either row is published in its terminal state.
@exportc("cheng_held_exec_terminal_capsule_role_bind_bundle_owner")
@abi_internal
fn cheng_held_exec_terminal_capsule_role_bind_bundle_owner_export(
        providerRoleOwner: int32,
        bundleOwner: int32): int32 =
    let roleRow = providerRoleOwner - 1
    let bundleRow = bundleOwner - 1
    if roleRow < 0 || roleRow >= chengHeldExecCapsuleProviderRoleCount ||
       bundleRow < 0 || bundleRow >= chengHeldExecBundleOwnerCount:
        return 0
    cheng_runtime_lock()
    if roleRow >= chengHeldExecCapsuleProviderRoleNextRow ||
       bundleRow >= chengHeldExecBundleOwnerNextRow ||
       chengHeldExecCapsuleProviderRoleStates[roleRow] !=
           chengHeldExecCapsuleProviderRoleIssued ||
       chengHeldExecCapsuleProviderRoleBundleReaders[roleRow] >= 0 ||
       chengHeldExecBundleOwnerStates[bundleRow] !=
           chengHeldExecBundleOwnerIssued ||
       chengHeldExecBundleOwnerFds[bundleRow] <= 2 ||
       chengHeldExecBundleOwnerByteCounts[bundleRow] == uint64(0) ||
       !cheng_held_exec_digest_nonzero(
           chengHeldExecBundleOwnerDigests[bundleRow]):
        cheng_runtime_unlock()
        return 0
    chengHeldExecCapsuleProviderRoleBundleReaders[roleRow] =
        chengHeldExecBundleOwnerFds[bundleRow]
    chengHeldExecCapsuleProviderRoleBundleReaderCloseStates[roleRow] =
        chengHeldExecFdCloseOpen
    chengHeldExecCapsuleProviderRoleBundleReaderCloseReceipts[roleRow] = 0
    chengHeldExecCapsuleProviderRoleBundleDigests[roleRow] =
        chengHeldExecBundleOwnerDigests[bundleRow]
    chengHeldExecCapsuleProviderRoleBundleByteCounts[roleRow] =
        chengHeldExecBundleOwnerByteCounts[bundleRow]
    chengHeldExecBundleOwnerFds[bundleRow] = -1
    chengHeldExecBundleOwnerFdCloseStates[bundleRow] =
        chengHeldExecFdCloseNotPresent
    chengHeldExecBundleOwnerDigests[bundleRow] = ChengFixedBytes32()
    chengHeldExecBundleOwnerByteCounts[bundleRow] = uint64(0)
    chengHeldExecBundleOwnerStates[bundleRow] = chengHeldExecBundleOwnerMoved
    cheng_runtime_unlock()
    return 1

fn cheng_atomic_tree_verify_verified_category_locked(
        cell: ChengAtomicTreeCellPtr,
        outErr: ptr): bool =
    if cell == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified category cell unavailable")
        return false
    if cell->verifiedRootFd < 0:
        if cell->verifiedCategoryName == nil &&
           cell->verifiedCategoryDev == uint64(0) &&
           cell->verifiedCategoryIno == uint64(0):
            return true
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified category provenance corrupt")
        return false
    if cell->verifiedCategoryName == nil || cell->parentFd < 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified category binding unavailable")
        return false
    let categoryFd = libc_openat_runtime(
        cell->verifiedRootFd,
        cell->verifiedCategoryName,
        cheng_atomic_tree_dir_open_flags(),
        0)
    if categoryFd < 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified category reopen failed")
        return false
    var retainedRootSize: int64
    var retainedRootMode: int32
    var retainedRootDev: uint64
    var retainedRootIno: uint64
    var categorySize: int64
    var categoryMode: int32
    var categoryDev: uint64
    var categoryIno: uint64
    var heldSize: int64
    var heldMode: int32
    var heldDev: uint64
    var heldIno: uint64
    let valid =
        cheng_atomic_tree_fstat(
            cell->verifiedRootFd,
            &retainedRootSize,
            &retainedRootMode,
            &retainedRootDev,
            &retainedRootIno) &&
        cheng_atomic_tree_fstat(
            categoryFd,
            &categorySize,
            &categoryMode,
            &categoryDev,
            &categoryIno) &&
        cheng_atomic_tree_fstat(
            cell->parentFd,
            &heldSize,
            &heldMode,
            &heldDev,
            &heldIno) &&
        (retainedRootMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        (categoryMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        (heldMode & chengAtomicTreeTypeMask) ==
            chengAtomicTreeTypeDir &&
        categoryDev == cell->verifiedCategoryDev &&
        categoryIno == cell->verifiedCategoryIno &&
        heldDev == cell->verifiedCategoryDev &&
        heldIno == cell->verifiedCategoryIno
    if !cheng_atomic_tree_close_fd_or_abort(
           categoryFd,
           "atomic_tree_verified_category_fd_close_failed"):
        return false
    if !valid:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: verified category identity drift")
        return false
    return true

fn cheng_atomic_tree_verify_root_binding_locked(
        cell: ChengAtomicTreeCellPtr,
        useFinalName: bool,
        outErr: ptr): bool =
    if cell == nil || cell->parentFd < 0 || cell->rootFd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: root binding unavailable")
        return false
    if !cheng_atomic_tree_verify_verified_category_locked(cell, outErr):
        return false
    if cell->exclusiveLeaseHeld == 1 &&
       !cheng_atomic_tree_verify_exclusive_parent_locked(cell, outErr):
        return false
    if cell->verifiedRootLeaseHeld == 1:
        var heldSize: int64
        var heldMode: int32
        var heldDev: uint64
        var heldIno: uint64
        if !cheng_atomic_tree_fstat(
               cell->parentFd,
               &heldSize,
               &heldMode,
               &heldDev,
               &heldIno) ||
           (heldMode & chengAtomicTreeTypeMask) !=
               chengAtomicTreeTypeDir ||
           heldDev != cell->parentDev || heldIno != cell->parentIno:
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: verified-root child parent identity drift")
            return false
    let name = useFinalName ? cell->finalName : cell->stagingName
    if name == nil:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: root binding name unavailable")
        return false
    let pathFd = libc_openat_runtime(cell->parentFd,
                                      name,
                                      cheng_atomic_tree_dir_open_flags(),
                                      0)
    if pathFd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: root binding open failed")
        return false
    var rootSize: int64
    var rootMode: int32
    var rootDev: uint64
    var rootIno: uint64
    var pathSize: int64
    var pathMode: int32
    var pathDev: uint64
    var pathIno: uint64
    let valid = cheng_atomic_tree_fstat(cell->rootFd,
                                         &rootSize,
                                         &rootMode,
                                         &rootDev,
                                         &rootIno) &&
                cheng_atomic_tree_fstat(pathFd,
                                         &pathSize,
                                         &pathMode,
                                         &pathDev,
                                         &pathIno) &&
                (rootMode & chengAtomicTreeTypeMask) == chengAtomicTreeTypeDir &&
                (pathMode & chengAtomicTreeTypeMask) == chengAtomicTreeTypeDir &&
                rootDev == pathDev && rootIno == pathIno &&
                ((cell->exclusiveLeaseHeld == 0 &&
                  cell->verifiedRootLeaseHeld == 0) ||
                 (rootDev == cell->rootDev && rootIno == cell->rootIno))
    if !cheng_atomic_tree_close_fd_or_abort(
           pathFd,
           "atomic_tree_root_binding_fd_close_failed"):
        return false
    if !valid:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: root binding identity drift")
        return false
    return true

fn cheng_read_only_mapped_region_platform_kind(): int32 =
    var unameValue: ChengReadOnlyMappedRegionUnameBuffer
    cheng_bytes_set(
        ptr(&unameValue),
        0,
        int32(sizeof(ChengReadOnlyMappedRegionUnameBuffer)))
    if libc_uname_read_only_runtime(ptr(&unameValue)) != 0:
        return 0
    if cheng_host_is_darwin():
        let machine =
            cheng_ptr_plus(ptr(&unameValue), 1024)
        if cheng_cstring_equals_cstring(
               machine, "arm64"):
            return chengReadOnlyMappedRegionPlatformDarwinA64
        return 0
    if !cheng_cstring_equals_cstring(
           ptr(&unameValue), "Linux"):
        return 0
    let machine =
        cheng_ptr_plus(ptr(&unameValue), 260)
    if cheng_cstring_equals_cstring(
           machine, "x86_64"):
        return chengReadOnlyMappedRegionPlatformLinuxX64
    if cheng_cstring_equals_cstring(
           machine, "aarch64"):
        return chengReadOnlyMappedRegionPlatformLinuxA64
    return 0

fn cheng_read_only_mapped_region_allocation_valid(
        identity: ChengReadOnlyMappedFileIdentityPtr,
        outErr: ptr): bool =
    if identity == nil ||
       identity->platformKind <= 0 ||
       identity->size < int64(0) ||
       identity->blocks < int64(0) ||
       identity->mtimeNsec < int64(0) ||
       identity->mtimeNsec > int64(999999999) ||
       identity->ctimeNsec < int64(0) ||
       identity->ctimeNsec > int64(999999999) ||
       (identity->mode & chengAtomicTreeTypeMask) !=
           chengAtomicTreeTypeReg:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "csg_mmap_e_identity_invalid: regular file identity required")
        return false
    if identity->nlink != uint64(1):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "csg_mmap_e_nlink_not_one: mapped file must have exactly one hard link")
        return false
    if identity->size == int64(0):
        if identity->blocks != int64(0):
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "csg_mmap_e_sparse_file: zero-length file has allocated data blocks")
            return false
    else:
        var requiredBlocks =
            identity->size /
            chengReadOnlyMappedRegionAllocationUnitBytes
        if identity->size %
               chengReadOnlyMappedRegionAllocationUnitBytes !=
               int64(0):
            requiredBlocks = requiredBlocks + int64(1)
        if identity->blocks < requiredBlocks:
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "csg_mmap_e_sparse_file: sparse mapped files are forbidden")
            return false
    return true

fn cheng_read_only_mapped_region_identity_valid(
        identity: ChengReadOnlyMappedFileIdentityPtr,
        outErr: ptr): bool =
    if !cheng_read_only_mapped_region_allocation_valid(
           identity, outErr):
        return false
    if (identity->mode &
           chengReadOnlyMappedRegionPermissionMask) !=
           chengReadOnlyMappedRegionFileMode:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "csg_mmap_e_identity_invalid: sealed 0400 file mode required")
        return false
    if identity->authorityKind ==
           chengReadOnlyMappedRegionAuthorityLinuxFsVerity:
        return identity->platformKind ==
                   chengReadOnlyMappedRegionPlatformLinuxX64 ||
               identity->platformKind ==
                   chengReadOnlyMappedRegionPlatformLinuxA64
    if identity->authorityKind ==
           chengReadOnlyMappedRegionAuthorityDarwinStableFile:
        return identity->platformKind ==
                   chengReadOnlyMappedRegionPlatformDarwinA64 &&
               identity->hasChangeVersion == 0
    let _ = cheng_atomic_tree_set_error(
        outErr,
        "csg_mmap_e_identity_invalid: unsupported immutable content authority")
    return false

fn cheng_read_only_mapped_region_identity_equal(
        left: ChengReadOnlyMappedFileIdentityPtr,
        right: ChengReadOnlyMappedFileIdentityPtr): bool =
    if left == nil || right == nil:
        return false
    let equal =
        left->platformKind == right->platformKind &&
        left->authorityKind == right->authorityKind &&
        left->size == right->size &&
        left->blocks == right->blocks &&
        left->mode == right->mode &&
        left->uid == right->uid &&
        left->gid == right->gid &&
        left->nlink == right->nlink &&
        left->dev == right->dev &&
        left->ino == right->ino &&
        left->mtimeSec == right->mtimeSec &&
        left->mtimeNsec == right->mtimeNsec &&
        left->ctimeSec == right->ctimeSec &&
        left->ctimeNsec == right->ctimeNsec &&
        left->hasChangeVersion ==
            right->hasChangeVersion
    if !equal:
        return false
    if left->hasChangeVersion == 1:
        return left->changeVersion ==
               right->changeVersion
    return true

fn cheng_read_only_mapped_region_identity_from_linux(
        platformKind: int32,
        statData: ptr,
        outIdentity: ChengReadOnlyMappedFileIdentityPtr): bool =
    if statData == nil || outIdentity == nil:
        return false
    var modeOffset: int32
    if platformKind ==
           chengReadOnlyMappedRegionPlatformLinuxX64:
        modeOffset = 24
        outIdentity->nlink =
            *(UInt64Ptr(cheng_ptr_plus(statData, 16)))
        outIdentity->uid =
            *(UInt32Ptr(cheng_ptr_plus(statData, 28)))
        outIdentity->gid =
            *(UInt32Ptr(cheng_ptr_plus(statData, 32)))
    elif platformKind ==
             chengReadOnlyMappedRegionPlatformLinuxA64:
        modeOffset = 16
        outIdentity->nlink =
            uint64(*(UInt32Ptr(
                cheng_ptr_plus(statData, 20))))
        outIdentity->uid =
            *(UInt32Ptr(cheng_ptr_plus(statData, 24)))
        outIdentity->gid =
            *(UInt32Ptr(cheng_ptr_plus(statData, 28)))
    else:
        return false
    outIdentity->platformKind = platformKind
    outIdentity->authorityKind =
        chengReadOnlyMappedRegionAuthorityLinuxFsVerity
    outIdentity->size =
        *(Int64Ptr(cheng_ptr_plus(statData, 48)))
    outIdentity->blocks =
        *(Int64Ptr(cheng_ptr_plus(statData, 64)))
    outIdentity->mode =
        int32(*(UInt32Ptr(
            cheng_ptr_plus(statData, modeOffset))))
    outIdentity->hasChangeVersion = 0
    outIdentity->dev =
        *(UInt64Ptr(cheng_ptr_plus(statData, 0)))
    outIdentity->ino =
        *(UInt64Ptr(cheng_ptr_plus(statData, 8)))
    outIdentity->mtimeSec =
        *(Int64Ptr(cheng_ptr_plus(statData, 88)))
    outIdentity->mtimeNsec =
        *(Int64Ptr(cheng_ptr_plus(statData, 96)))
    outIdentity->ctimeSec =
        *(Int64Ptr(cheng_ptr_plus(statData, 104)))
    outIdentity->ctimeNsec =
        *(Int64Ptr(cheng_ptr_plus(statData, 112)))
    outIdentity->changeVersion = uint64(0)
    return true

fn cheng_read_only_mapped_region_identity_from_darwin(
        platformKind: int32,
        statData: ptr,
        outIdentity: ChengReadOnlyMappedFileIdentityPtr): bool =
    if platformKind !=
           chengReadOnlyMappedRegionPlatformDarwinA64 ||
       statData == nil || outIdentity == nil:
        return false
    outIdentity->platformKind = platformKind
    outIdentity->authorityKind =
        chengReadOnlyMappedRegionAuthorityDarwinStableFile
    outIdentity->size =
        *(Int64Ptr(cheng_ptr_plus(statData, 96)))
    outIdentity->blocks =
        *(Int64Ptr(cheng_ptr_plus(statData, 104)))
    outIdentity->mode =
        int32(*(UInt16Ptr(cheng_ptr_plus(statData, 4))))
    outIdentity->hasChangeVersion = 0
    outIdentity->uid =
        *(UInt32Ptr(cheng_ptr_plus(statData, 16)))
    outIdentity->gid =
        *(UInt32Ptr(cheng_ptr_plus(statData, 20)))
    outIdentity->nlink =
        uint64(*(UInt16Ptr(cheng_ptr_plus(statData, 6))))
    outIdentity->dev =
        uint64(uint32(*(Int32Ptr(cheng_ptr_plus(statData, 0)))))
    outIdentity->ino =
        *(UInt64Ptr(cheng_ptr_plus(statData, 8)))
    outIdentity->mtimeSec =
        *(Int64Ptr(cheng_ptr_plus(statData, 48)))
    outIdentity->mtimeNsec =
        *(Int64Ptr(cheng_ptr_plus(statData, 56)))
    outIdentity->ctimeSec =
        *(Int64Ptr(cheng_ptr_plus(statData, 64)))
    outIdentity->ctimeNsec =
        *(Int64Ptr(cheng_ptr_plus(statData, 72)))
    outIdentity->changeVersion = uint64(0)
    return true

fn cheng_read_only_mapped_region_fstat(
        platformKind: int32,
        fd: int32,
        outIdentity: ChengReadOnlyMappedFileIdentityPtr): bool =
    if fd < 0 || outIdentity == nil:
        return false
    cheng_bytes_set(
        ptr(outIdentity),
        0,
        int32(sizeof(ChengReadOnlyMappedFileIdentity)))
    var statValue: ChengReadOnlyMappedRegionStatBuffer
    cheng_bytes_set(
        ptr(&statValue),
        0,
        int32(sizeof(ChengReadOnlyMappedRegionStatBuffer)))
    if libc_fstat_read_only_runtime(
           fd, ptr(&statValue)) != 0:
        return false
    if platformKind ==
           chengReadOnlyMappedRegionPlatformDarwinA64:
        return cheng_read_only_mapped_region_identity_from_darwin(
            platformKind, ptr(&statValue), outIdentity)
    return cheng_read_only_mapped_region_identity_from_linux(
        platformKind, ptr(&statValue), outIdentity)

fn cheng_read_only_mapped_region_fstatat(
        platformKind: int32,
        parentFd: int32,
        leaf: ptr,
        outIdentity: ChengReadOnlyMappedFileIdentityPtr): bool =
    if parentFd < 0 || leaf == nil ||
       outIdentity == nil:
        return false
    cheng_bytes_set(
        ptr(outIdentity),
        0,
        int32(sizeof(ChengReadOnlyMappedFileIdentity)))
    var statValue: ChengReadOnlyMappedRegionStatBuffer
    cheng_bytes_set(
        ptr(&statValue),
        0,
        int32(sizeof(ChengReadOnlyMappedRegionStatBuffer)))
    let noFollow =
        platformKind ==
            chengReadOnlyMappedRegionPlatformDarwinA64 ?
            chengReadOnlyMappedRegionDarwinNoFollow :
            chengReadOnlyMappedRegionLinuxNoFollow
    if libc_fstatat_read_only_runtime(
           parentFd,
           leaf,
           ptr(&statValue),
           noFollow) != 0:
        return false
    if platformKind ==
           chengReadOnlyMappedRegionPlatformDarwinA64:
        return cheng_read_only_mapped_region_identity_from_darwin(
            platformKind, ptr(&statValue), outIdentity)
    return cheng_read_only_mapped_region_identity_from_linux(
        platformKind, ptr(&statValue), outIdentity)

fn cheng_read_only_mapped_region_map_failed(
        mapped: ptr): bool =
    var mapFailedWord: int64
    mapFailedWord = mapFailedWord - int64(1)
    return mapped == nil ||
           int64(uint64(mapped)) == mapFailedWord

fn cheng_read_only_mapped_region_fchmod(
        platformKind: int32,
        fd: int32,
        mode: int32): bool =
    if platformKind !=
           chengReadOnlyMappedRegionPlatformDarwinA64 &&
       platformKind !=
           chengReadOnlyMappedRegionPlatformLinuxX64 &&
       platformKind !=
           chengReadOnlyMappedRegionPlatformLinuxA64:
        return false
    return libc_fchmod_read_only_runtime(
               fd, mode) == 0

fn cheng_read_only_mapped_region_linux_platform(
        platformKind: int32): bool =
    return platformKind ==
               chengReadOnlyMappedRegionPlatformLinuxX64 ||
           platformKind ==
               chengReadOnlyMappedRegionPlatformLinuxA64

fn cheng_read_only_mapped_region_linux_measure(
        platformKind: int32,
        fd: int32,
        outDigest: ptr,
        outErr: ptr): bool =
    if !cheng_read_only_mapped_region_linux_platform(
           platformKind) ||
       fd < 0 || outDigest == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: invalid linux fs-verity measurement request")
        return false
    if cheng_linux_fsverity_measure_sha256_runtime(
           fd, outDigest) != 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: linux fs-verity SHA256 measurement unavailable")
        return false
    return true

fn cheng_read_only_mapped_region_cell_from_handle_locked(
        handle: uint64,
        outErr: ptr): ChengReadOnlyMappedRegionCellPtr =
    let raw = cheng_ffi_handle_resolve_ptr_locked(handle)
    if raw == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: stale handle")
        return nil
    let cell =
        ChengReadOnlyMappedRegionCellPtr(raw)
    if cell == nil ||
       cell->magic != chengReadOnlyMappedRegionMagic:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: corrupt handle")
        return nil
    return cell

fn cheng_read_only_mapped_region_identity_stable_locked(
        cell: ChengReadOnlyMappedRegionCellPtr,
        outErr: ptr): bool =
    if cell == nil || cell->mapBase == nil ||
       cell->byteLength <= int64(0):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: owner state unavailable")
        return false
    if cell->fd < 0 || cell->parentFd < 0 ||
       cell->leaf == nil:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: unsupported identity authority")
        return false
    let linuxAuthority =
        cell->authorityKind ==
            chengReadOnlyMappedRegionAuthorityLinuxFsVerity
    let darwinAuthority =
        cell->authorityKind ==
            chengReadOnlyMappedRegionAuthorityDarwinStableFile
    if !linuxAuthority && !darwinAuthority:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os read only mapped region: unsupported identity authority")
        return false
    var fdIdentity: ChengReadOnlyMappedFileIdentity
    var pathIdentity: ChengReadOnlyMappedFileIdentity
    var stable =
        cell->platformKind ==
            cheng_read_only_mapped_region_platform_kind() &&
        cheng_read_only_mapped_region_fstat(
            cell->platformKind,
            cell->fd,
            &fdIdentity) &&
        cheng_read_only_mapped_region_fstatat(
            cell->platformKind,
            cell->parentFd,
            cell->leaf,
            &pathIdentity) &&
        cheng_read_only_mapped_region_identity_valid(
            &fdIdentity, outErr) &&
        cheng_read_only_mapped_region_identity_equal(
            &fdIdentity, &pathIdentity) &&
        fdIdentity.authorityKind ==
            cell->authorityKind &&
        fdIdentity.size == cell->byteLength &&
        fdIdentity.blocks == cell->blocks &&
        fdIdentity.mode == cell->mode &&
        fdIdentity.uid == cell->uid &&
        fdIdentity.gid == cell->gid &&
        fdIdentity.nlink == cell->nlink &&
        fdIdentity.dev == cell->dev &&
        fdIdentity.ino == cell->ino &&
        fdIdentity.mtimeSec == cell->mtimeSec &&
        fdIdentity.mtimeNsec == cell->mtimeNsec &&
        fdIdentity.ctimeSec == cell->ctimeSec &&
        fdIdentity.ctimeNsec == cell->ctimeNsec &&
        fdIdentity.changeVersion == cell->changeVersion
    if stable && linuxAuthority:
        var measuredDigest: ChengFixedBytes32
        stable =
            cheng_read_only_mapped_region_linux_measure(
                cell->platformKind,
                cell->fd,
                ptr(&measuredDigest),
                outErr) &&
            cheng_fixed32_equal(
                measuredDigest,
                cell->verityDigest)
    if !stable:
        let _ = cheng_read_only_mapped_region_set_error_if_empty(
            outErr,
            "csg_mmap_e_identity_drift: file identity/content metadata changed")
        return false
    return true

fn cheng_read_only_mapped_region_unmap_or_abort_locked(
        mapBase: ptr,
        byteLength: int64,
        allocationLedgerId: uint64,
        allocationLedgerGeneration: uint64,
        allocationLedgerRecordIndex: int32,
        allocationLedgerRecordGeneration: uint64): bool =
    if mapBase == nil || byteLength <= int64(0):
        cheng_allocation_ledger_abort(
            "mapped_region_unmap_identity_invalid")
        return false
    if !cheng_allocation_ledger_record_unmapping_preflight_locked(
           mapBase,
           byteLength,
           allocationLedgerId,
           allocationLedgerGeneration,
           allocationLedgerRecordIndex,
           allocationLedgerRecordGeneration):
        return false
    if c_munmap(mapBase, byteLength) != 0:
        cheng_allocation_ledger_abort(
            "mapped_region_munmap_failed_before_state_commit")
        return false
    cheng_allocation_ledger_record_unmapping_locked(
        allocationLedgerId,
        allocationLedgerGeneration,
        allocationLedgerRecordIndex,
        allocationLedgerRecordGeneration)
    return true

fn cheng_read_only_mapped_region_resources_release_locked(
        cell: ChengReadOnlyMappedRegionCellPtr): bool =
    if cell == nil || cell->mapBase == nil ||
       cell->byteLength <= int64(0):
        return false
    if !cheng_read_only_mapped_region_unmap_or_abort_locked(
           cell->mapBase,
           cell->byteLength,
           cell->allocationLedgerId,
           cell->allocationLedgerGeneration,
           cell->allocationLedgerRecordIndex,
           cell->allocationLedgerRecordGeneration):
        return false
    cell->mapBase = nil
    cell->allocationLedgerId = uint64(0)
    cell->allocationLedgerGeneration = uint64(0)
    cell->allocationLedgerRecordIndex = -1
    cell->allocationLedgerRecordGeneration = uint64(0)
    if cell->fd >= 0:
        if libc_close(cell->fd) != 0:
            cheng_allocation_ledger_abort(
                "mapped_region_fd_close_failed")
            return false
        cell->fd = -1
    if cell->parentFd >= 0:
        if libc_close(cell->parentFd) != 0:
            cheng_allocation_ledger_abort(
                "mapped_region_parent_fd_close_failed")
            return false
        cell->parentFd = -1
    if cell->leaf != nil:
        cheng_free_locked(cell->leaf)
        cell->leaf = nil
    return true

fn cheng_read_only_mapped_region_cell_release(
        cell: ChengReadOnlyMappedRegionCellPtr): bool =
    if !cheng_read_only_mapped_region_resources_release_locked(cell):
        return false
    cell->magic = 0
    cheng_free_locked(ptr(cell))
    return true

@borrows
fn cheng_atomic_tree_map_read_only_locked(
        tree: ChengAtomicTreeCellPtr,
        relativePath: str,
        outErr: ptr): uint64 =
    if tree == nil ||
       !cheng_atomic_tree_mode_is_verified_read(tree->mode) ||
       !cheng_atomic_tree_relative_path_valid(relativePath):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: map requires verified tree and canonical path")
        return uint64(0)
    if !cheng_atomic_tree_verify_root_binding_locked(
           tree, true, outErr):
        return uint64(0)
    var leaf: ptr
    let parentFd = cheng_atomic_tree_open_relative_parent(
        tree, relativePath, &leaf, outErr)
    if parentFd < 0:
        return uint64(0)
    let fd = libc_openat_runtime(
        parentFd,
        leaf,
        cheng_atomic_tree_read_open_flags(),
        0)
    if fd < 0:
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_map_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: mapped file open failed")
        return uint64(0)
    let platformKind =
        cheng_read_only_mapped_region_platform_kind()
    var fdIdentity: ChengReadOnlyMappedFileIdentity
    var pathIdentity: ChengReadOnlyMappedFileIdentity
    var valid =
        platformKind != 0 &&
        cheng_read_only_mapped_region_fstat(
            platformKind, fd, &fdIdentity) &&
        cheng_read_only_mapped_region_fstatat(
            platformKind,
            parentFd,
            leaf,
            &pathIdentity) &&
        cheng_read_only_mapped_region_identity_valid(
            &fdIdentity, outErr) &&
        cheng_read_only_mapped_region_identity_equal(
            &fdIdentity, &pathIdentity)
    if valid && fdIdentity.size == int64(0):
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "csg_mmap_e_zero_length: zero-length files cannot be memory mapped")
        valid = false
    var verityDigest: ChengFixedBytes32
    var linuxAuthority = false
    if valid:
        linuxAuthority =
            fdIdentity.authorityKind ==
                chengReadOnlyMappedRegionAuthorityLinuxFsVerity
    if valid && linuxAuthority:
        valid =
            cheng_read_only_mapped_region_linux_measure(
                platformKind,
                fd,
                ptr(&verityDigest),
            outErr)
    if !valid:
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_map_file_fd_close_failed"):
            return uint64(0)
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_map_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_read_only_mapped_region_set_error_if_empty(
            outErr,
            "os atomic tree: map requires sealed nonempty regular file")
        return uint64(0)
    let mapped = libc_mmap_read_only_runtime(
        nil,
        fdIdentity.size,
        chengReadOnlyMappedRegionProtRead,
        chengReadOnlyMappedRegionMapPrivate,
        fd,
        int64(0))
    if cheng_read_only_mapped_region_map_failed(mapped):
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_map_file_fd_close_failed"):
            return uint64(0)
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_map_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: file-backed mmap failed")
        return uint64(0)
    var mappedLedgerRecordIndex: int32 = -1
    var mappedLedgerRecordGeneration: uint64
    let mappedLedgerAllocationId =
        cheng_allocation_ledger_record_mapping_locked(
            mapped, fdIdentity.size,
            &mappedLedgerRecordIndex,
            &mappedLedgerRecordGeneration)
    var mappedLedgerGeneration: uint64
    let mappedLedgerOwner = cheng_allocation_ledger_active_locked()
    if mappedLedgerOwner != nil &&
       mappedLedgerAllocationId != uint64(0):
        mappedLedgerGeneration =
            mappedLedgerOwner->capabilityGeneration
    if linuxAuthority:
        var finalFdIdentity: ChengReadOnlyMappedFileIdentity
        var finalPathIdentity: ChengReadOnlyMappedFileIdentity
        var finalVerityDigest: ChengFixedBytes32
        valid =
            cheng_read_only_mapped_region_fstat(
                platformKind,
                fd,
                &finalFdIdentity) &&
            cheng_read_only_mapped_region_fstatat(
                platformKind,
                parentFd,
                leaf,
                &finalPathIdentity) &&
            cheng_read_only_mapped_region_identity_equal(
                &fdIdentity,
                &finalFdIdentity) &&
            cheng_read_only_mapped_region_identity_equal(
                &finalFdIdentity,
                &finalPathIdentity) &&
            cheng_read_only_mapped_region_linux_measure(
                platformKind,
                fd,
                ptr(&finalVerityDigest),
                outErr) &&
            cheng_fixed32_equal(
                verityDigest,
                finalVerityDigest)
        if valid:
            verityDigest = finalVerityDigest
    if !valid:
        if !cheng_read_only_mapped_region_unmap_or_abort_locked(
               mapped,
               fdIdentity.size,
               mappedLedgerAllocationId,
               mappedLedgerGeneration,
               mappedLedgerRecordIndex,
               mappedLedgerRecordGeneration):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_map_file_fd_close_failed"):
            return uint64(0)
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_map_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_read_only_mapped_region_set_error_if_empty(
            outErr,
            "os atomic tree: mapped file authority changed during acquisition")
        return uint64(0)
    let raw = cheng_malloc_locked(
        int32(sizeof(ChengReadOnlyMappedRegionCell)))
    if raw == nil:
        if !cheng_read_only_mapped_region_unmap_or_abort_locked(
               mapped,
               fdIdentity.size,
               mappedLedgerAllocationId,
               mappedLedgerGeneration,
               mappedLedgerRecordIndex,
               mappedLedgerRecordGeneration):
            return uint64(0)
        if !cheng_atomic_tree_close_fd_or_abort(
               fd,
               "atomic_tree_map_file_fd_close_failed"):
            return uint64(0)
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_map_parent_fd_close_failed"):
            return uint64(0)
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: mapped region owner alloc failed")
        return uint64(0)
    cheng_bytes_set(
        raw,
        0,
        int32(sizeof(ChengReadOnlyMappedRegionCell)))
    let region =
        ChengReadOnlyMappedRegionCellPtr(raw)
    region->magic = chengReadOnlyMappedRegionMagic
    region->fd = fd
    region->parentFd = parentFd
    region->mode = fdIdentity.mode
    region->mapBase = mapped
    region->byteLength = fdIdentity.size
    region->blocks = fdIdentity.blocks
    region->dev = fdIdentity.dev
    region->ino = fdIdentity.ino
    region->uid = fdIdentity.uid
    region->gid = fdIdentity.gid
    region->nlink = fdIdentity.nlink
    region->mtimeSec = fdIdentity.mtimeSec
    region->mtimeNsec = fdIdentity.mtimeNsec
    region->ctimeSec = fdIdentity.ctimeSec
    region->ctimeNsec = fdIdentity.ctimeNsec
    region->changeVersion =
        fdIdentity.changeVersion
    region->platformKind = platformKind
    region->authorityKind =
        fdIdentity.authorityKind
    region->verityDigest = verityDigest
    region->leaf = leaf
    region->allocationLedgerId = mappedLedgerAllocationId
    region->allocationLedgerGeneration = mappedLedgerGeneration
    region->allocationLedgerRecordIndex = mappedLedgerRecordIndex
    region->allocationLedgerRecordReserved = 0
    region->allocationLedgerRecordGeneration =
        mappedLedgerRecordGeneration
    if !cheng_read_only_mapped_region_identity_stable_locked(
           region, outErr):
        if !cheng_read_only_mapped_region_cell_release(region):
            cheng_allocation_ledger_abort(
                "mapped_region_identity_failure_cleanup_failed")
        return uint64(0)
    let handle =
        cheng_ffi_handle_register_ptr_locked(ptr(region))
    if handle == uint64(0):
        if !cheng_read_only_mapped_region_cell_release(region):
            cheng_allocation_ledger_abort(
                "mapped_region_handle_failure_cleanup_failed")
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: mapped region handle register failed")
        return uint64(0)
    return handle

@exportc("cheng_atomic_tree_map_read_only_bridge")
@abi_internal
@borrows
fn cheng_atomic_tree_map_read_only_bridge_export(
        handle: uint64,
        relativePath: str,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if cheng_read_only_mapped_region_platform_kind() == 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: read only mmap provider unsupported")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let tree =
        cheng_atomic_tree_cell_from_handle_locked(
            handle, errorOut)
    var region: uint64
    if tree != nil:
        region =
            cheng_atomic_tree_map_read_only_locked(
                tree, relativePath, errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return region

@exportc("cheng_read_only_mapped_region_byte_length_bridge")
@abi_internal
fn cheng_read_only_mapped_region_byte_length_bridge_export(
        handle: uint64,
        outLength: Int64Ptr,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outLength == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os read only mapped region: nil byte length output")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_lock()
    let cell =
        cheng_read_only_mapped_region_cell_from_handle_locked(
            handle, errorOut)
    let ok =
        cell != nil &&
        cheng_read_only_mapped_region_identity_stable_locked(
            cell, errorOut)
    if ok:
        *outLength = cell->byteLength
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@exportc("cheng_read_only_mapped_region_bind_sha256_framed_bridge")
@abi_internal
@borrows
fn cheng_read_only_mapped_region_bind_sha256_framed_bridge_export(
        handle: uint64,
        domain: str,
        expectedCid: str,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell =
        cheng_read_only_mapped_region_cell_from_handle_locked(
            handle, errorOut)
    var ok =
        cell != nil &&
        cheng_read_only_mapped_region_identity_stable_locked(
            cell, errorOut)
    if ok && cell->sha256Bound != 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os read only mapped region: sha256 already bound")
        ok = false
    if ok:
        if cheng_str_len(domain) > 0 &&
           cell->byteLength > int64(0) &&
           cell->byteLength <= int64(2147483647):
            cell->fullDigestCount =
                cell->fullDigestCount + 1
        ok = cheng_sha256_domain_payload_cid_matches(
            domain,
            cell->mapBase,
            cell->byteLength,
            expectedCid,
            errorOut)
    if ok:
        ok =
            cheng_read_only_mapped_region_identity_stable_locked(
                cell, errorOut)
    if ok:
        cell->sha256Bound = 1
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@exportc("cheng_read_only_mapped_region_full_digest_count_bridge")
@abi_internal
fn cheng_read_only_mapped_region_full_digest_count_bridge_export(
        handle: uint64,
        outCount: Int32Ptr,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outCount == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os read only mapped region: nil digest count output")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_lock()
    let cell =
        cheng_read_only_mapped_region_cell_from_handle_locked(
            handle, errorOut)
    let ok =
        cell != nil &&
        cheng_read_only_mapped_region_identity_stable_locked(
            cell, errorOut)
    if ok:
        *outCount = cell->fullDigestCount
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@exportc("cheng_read_only_mapped_region_read_window_bridge")
@abi_internal
fn cheng_read_only_mapped_region_read_window_bridge_export(
        handle: uint64,
        offset: int64,
        length: int32,
        outData: UInt64Ptr,
        outLength: Int32Ptr,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outData == nil || outLength == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os read only mapped region: nil window output")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    *outData = uint64(0)
    *outLength = 0
    cheng_runtime_lock()
    let cell =
        cheng_read_only_mapped_region_cell_from_handle_locked(
            handle, errorOut)
    var ok =
        cell != nil &&
        cheng_read_only_mapped_region_identity_stable_locked(
            cell, errorOut)
    if ok && cell->sha256Bound == 0:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os read only mapped region: read requires sha256 binding")
        ok = false
    if ok &&
       (offset < int64(0) ||
        length <= 0 ||
        length > chengReadOnlyMappedRegionMaxWindow ||
        offset > cell->byteLength - int64(length)):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os read only mapped region: invalid read window")
        ok = false
    var raw: ptr
    if ok:
        raw = cheng_malloc_locked(length)
        if raw == nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os read only mapped region: window alloc failed")
            ok = false
    if ok:
        let source = ptr(
            uint64(cell->mapBase) + uint64(offset))
        cheng_bytes_copy(raw, source, length)
        ok =
            cheng_read_only_mapped_region_identity_stable_locked(
                cell, errorOut)
    if !ok:
        if raw != nil:
            cheng_free_locked(raw)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    *outData = uint64(raw)
    *outLength = length
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return 1

@exportc("cheng_read_only_mapped_region_close_bridge")
@abi_internal
fn cheng_read_only_mapped_region_close_bridge_export(
        handle: uint64,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell =
        cheng_read_only_mapped_region_cell_from_handle_locked(
            handle, errorOut)
    if cell == nil:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let stable =
        cheng_read_only_mapped_region_identity_stable_locked(
            cell, errorOut)
    let released =
        cheng_read_only_mapped_region_resources_release_locked(cell)
    if !released:
        cheng_allocation_ledger_abort(
            "mapped_region_release_failed_before_handle_commit")
        return 0
    let invalidated = cheng_ffi_handle_invalidate_locked(handle)
    if !invalidated:
        cheng_allocation_ledger_abort(
            "mapped_region_handle_invalidate_failed_after_unmap")
        return 0
    cell->magic = 0
    cheng_free_locked(ptr(cell))
    if !stable:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return 1

fn cheng_atomic_tree_u16le(data: ptr, offset: int32): int32 =
    return int32(*(UInt8Ptr(cheng_ptr_plus(data, offset)))) |
           (int32(*(UInt8Ptr(cheng_ptr_plus(data, offset + 1)))) << 8)

fn cheng_atomic_tree_u64le(data: ptr, offset: int32): uint64 =
    var out: uint64
    for byteIndex in 0..<8:
        out = out |
              (uint64(*(UInt8Ptr(cheng_ptr_plus(data,
                                                offset + byteIndex)))) <<
               uint64(byteIndex * 8))
    return out

@borrows
fn cheng_atomic_tree_str_compare(
        left: str,
        right: str): int32 =
    let leftLen = cheng_str_len(left)
    let rightLen = cheng_str_len(right)
    let commonLen = leftLen < rightLen ? leftLen : rightLen
    let leftData = cheng_str_data(left)
    let rightData = cheng_str_data(right)
    for byteIndex in 0..<commonLen:
        let leftByte = int32(*(UInt8Ptr(cheng_ptr_plus(leftData,
                                                       byteIndex))))
        let rightByte = int32(*(UInt8Ptr(cheng_ptr_plus(rightData,
                                                        byteIndex))))
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if leftLen < rightLen:
        return -1
    if leftLen > rightLen:
        return 1
    return 0

@borrows
fn cheng_atomic_tree_str_compare_raw(left: str,
                                      rightData: ptr,
                                      rightLen: int32): int32 =
    let leftLen = cheng_str_len(left)
    let commonLen = leftLen < rightLen ? leftLen : rightLen
    let leftData = cheng_str_data(left)
    for byteIndex in 0..<commonLen:
        let leftByte = int32(*(UInt8Ptr(cheng_ptr_plus(leftData,
                                                       byteIndex))))
        let rightByte = int32(*(UInt8Ptr(cheng_ptr_plus(rightData,
                                                        byteIndex))))
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if leftLen < rightLen:
        return -1
    if leftLen > rightLen:
        return 1
    return 0

@borrows
fn cheng_atomic_tree_child_path_byte(parent: str,
                                      name: ptr,
                                      nameLen: int32,
                                      byteIndex: int32): uint8 =
    let parentLen = cheng_str_len(parent)
    if parentLen == 0:
        return *(UInt8Ptr(cheng_ptr_plus(name, byteIndex)))
    if byteIndex < parentLen:
        return *(UInt8Ptr(cheng_ptr_plus(cheng_str_data(parent),
                                         byteIndex)))
    if byteIndex == parentLen:
        return uint8(47)
    return *(UInt8Ptr(cheng_ptr_plus(name,
                                     byteIndex - parentLen - 1)))

@borrows
fn cheng_atomic_tree_str_compare_child(left: str,
                                        parent: str,
                                        name: ptr,
                                        nameLen: int32): int32 =
    let parentLen = cheng_str_len(parent)
    let rightLen = parentLen == 0 ? nameLen : parentLen + 1 + nameLen
    let leftLen = cheng_str_len(left)
    let commonLen = leftLen < rightLen ? leftLen : rightLen
    let leftData = cheng_str_data(left)
    for byteIndex in 0..<commonLen:
        let leftByte = int32(*(UInt8Ptr(cheng_ptr_plus(leftData,
                                                       byteIndex))))
        let rightByte = int32(cheng_atomic_tree_child_path_byte(parent,
                                                                 name,
                                                                 nameLen,
                                                                 byteIndex))
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if leftLen < rightLen:
        return -1
    if leftLen > rightLen:
        return 1
    return 0

fn cheng_atomic_tree_u32le(data: ptr, offset: int32): int64 =
    return int64(*(UInt8Ptr(cheng_ptr_plus(data, offset)))) |
           (int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 1)))) << 8) |
           (int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 2)))) << 16) |
           (int64(*(UInt8Ptr(cheng_ptr_plus(data, offset + 3)))) << 24)

@borrows
fn cheng_atomic_tree_expected_wire_init(raw: str,
                                         out: var ChengAtomicTreeExpectedWire,
                                         outErr: ptr): bool =
    let data = cheng_str_data(raw)
    let byteLen = cheng_str_len(raw)
    if data == nil || byteLen < 8:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: expected set wire too short")
        return false
    let count64 = cheng_atomic_tree_u32le(data, 0)
    let payloadOffset64 = Int64(8) + count64 * Int64(4)
    if count64 < Int64(0) || count64 > Int64(2147483647) ||
       payloadOffset64 < Int64(8) || payloadOffset64 > Int64(byteLen):
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: expected set wire header invalid")
        return false
    let count = int32(count64)
    let payloadOffset = int32(payloadOffset64)
    let payloadBytes = byteLen - payloadOffset
    var previousOffset: int64 = -1
    for offsetIndex in 0..<(count + 1):
        let itemOffset = cheng_atomic_tree_u32le(data,
                                                 4 + offsetIndex * 4)
        if itemOffset < Int64(0) || itemOffset > Int64(payloadBytes) ||
           (offsetIndex == 0 && itemOffset != Int64(0)) ||
           (offsetIndex > 0 && itemOffset <= previousOffset):
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: expected set wire offsets invalid")
            return false
        previousOffset = itemOffset
    if previousOffset != Int64(payloadBytes):
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: expected set wire payload length mismatch")
        return false
    out.data = data
    out.byteLen = byteLen
    out.count = count
    out.payloadOffset = payloadOffset
    return true

@borrows
fn cheng_atomic_tree_expected_wire_item(
        wire: ChengAtomicTreeExpectedWire,
        itemIndex: int32): ChengAtomicTreeExpectedItem =
    if itemIndex < 0 || itemIndex >= wire.count:
        cheng_runtime_lock_abort(
            "atomic tree: expected wire item index outside domain")
        return ChengAtomicTreeExpectedItem()
    let start = int32(cheng_atomic_tree_u32le(wire.data,
                                               4 + itemIndex * 4))
    let finish = int32(cheng_atomic_tree_u32le(wire.data,
                                                4 + (itemIndex + 1) * 4))
    var out: ChengAtomicTreeExpectedItem
    out.data = cheng_ptr_plus(
        wire.data, wire.payloadOffset + start)
    out.len = finish - start
    return out

@borrows
fn cheng_atomic_tree_expected_wire_find_raw(
        wire: ChengAtomicTreeExpectedWire,
        raw: ptr,
        rawLen: int32): int32 =
    var low: int32
    var high = wire.count
    while low < high:
        let middle = low + (high - low) / 2
        let middleRaw =
            cheng_atomic_tree_expected_wire_item(
                wire, middle)
        var middleItem = cheng_str_view(
            middleRaw.data, middleRaw.len)
        let order = cheng_atomic_tree_str_compare_raw(
            middleItem, raw, rawLen)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < wire.count:
        let lowRaw =
            cheng_atomic_tree_expected_wire_item(
                wire, low)
        var lowItem = cheng_str_view(
            lowRaw.data, lowRaw.len)
        if cheng_atomic_tree_str_compare_raw(
               lowItem, raw, rawLen) == 0:
            return low
    return -1

@borrows
fn cheng_atomic_tree_expected_wire_find_child(
        wire: ChengAtomicTreeExpectedWire,
        parent: str,
        name: ptr,
        nameLen: int32): int32 =
    var low: int32
    var high = wire.count
    while low < high:
        let middle = low + (high - low) / 2
        let middleRaw =
            cheng_atomic_tree_expected_wire_item(
                wire, middle)
        var middleItem = cheng_str_view(
            middleRaw.data, middleRaw.len)
        let order = cheng_atomic_tree_str_compare_child(
            middleItem, parent, name, nameLen)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < wire.count:
        let lowRaw =
            cheng_atomic_tree_expected_wire_item(
                wire, low)
        var lowItem = cheng_str_view(
            lowRaw.data, lowRaw.len)
        if cheng_atomic_tree_str_compare_child(
               lowItem, parent, name, nameLen) == 0:
            return low
    return -1

@borrows
fn cheng_atomic_tree_expected_path_parent_valid(
        path: str,
        expectedDirs: ChengAtomicTreeExpectedWire): bool =
    let data = cheng_str_data(path)
    let count = cheng_str_len(path)
    var lastSlash: int32 = -1
    for byteIndex in 0..<count:
        if *(UInt8Ptr(cheng_ptr_plus(data, byteIndex))) == uint8(47):
            lastSlash = byteIndex
    if lastSlash < 0:
        return true
    return cheng_atomic_tree_expected_wire_find_raw(expectedDirs,
                                                     data,
                                                     lastSlash) >= 0

@borrows
fn cheng_atomic_tree_expected_set_validate(
        expectedDirs: ChengAtomicTreeExpectedWire,
        expectedFiles: ChengAtomicTreeExpectedWire,
        outErr: ptr): bool =
    for dirIndex in 0..<expectedDirs.count:
        let directoryRaw = cheng_atomic_tree_expected_wire_item(
            expectedDirs, dirIndex)
        var directoryPath = cheng_str_view(
            directoryRaw.data, directoryRaw.len)
        if !cheng_atomic_tree_relative_path_valid(directoryPath):
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: expected directory path is not canonical")
            return false
        if dirIndex > 0:
            let previousDirectoryRaw =
                cheng_atomic_tree_expected_wire_item(
                    expectedDirs, dirIndex - 1)
            var previousDirectoryPath = cheng_str_view(
                previousDirectoryRaw.data,
                previousDirectoryRaw.len)
            if cheng_atomic_tree_str_compare(
                   previousDirectoryPath,
                   directoryPath) >= 0:
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: expected directories are not strict byte-sorted unique")
                return false
        if !cheng_atomic_tree_expected_path_parent_valid(
                directoryPath, expectedDirs):
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: expected directory parent is missing")
            return false
    for fileIndex in 0..<expectedFiles.count:
        let fileRaw =
            cheng_atomic_tree_expected_wire_item(
                expectedFiles, fileIndex)
        var filePath = cheng_str_view(
            fileRaw.data, fileRaw.len)
        if !cheng_atomic_tree_relative_path_valid(filePath):
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: expected file path is not canonical")
            return false
        if fileIndex > 0:
            let previousFileRaw =
                cheng_atomic_tree_expected_wire_item(
                    expectedFiles, fileIndex - 1)
            var previousFilePath = cheng_str_view(
                previousFileRaw.data,
                previousFileRaw.len)
            if cheng_atomic_tree_str_compare(
                   previousFilePath,
                   filePath) >= 0:
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: expected files are not strict byte-sorted unique")
                return false
        if !cheng_atomic_tree_expected_path_parent_valid(
                filePath, expectedDirs):
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: expected file parent is missing")
            return false
        if cheng_atomic_tree_expected_wire_find_raw(
                expectedDirs,
                cheng_str_data(filePath),
                cheng_str_len(filePath)) >= 0:
            let _ = cheng_atomic_tree_set_error(
                outErr,
                "os atomic tree: expected path has conflicting types")
            return false
    return true

fn cheng_atomic_tree_parse_dirent(record: ptr,
                                   remaining: int32,
                                   darwin: bool,
                                   outRecordLen: var int32,
                                   outName: var ptr,
                                   outNameLen: var int32,
                                   outType: var int32,
                                   outIno: var uint64): bool =
    if record == nil:
        return false
    if darwin:
        if remaining < chengAtomicTreeDarwinDirentNameOffset + 1:
            return false
        let recordLen = cheng_atomic_tree_u16le(record, 16)
        let nameLen = cheng_atomic_tree_u16le(record, 18)
        if recordLen < chengAtomicTreeDarwinDirentNameOffset + 1 ||
           recordLen > remaining || recordLen % 4 != 0 ||
           nameLen <= 0 || nameLen > 1023 ||
           nameLen >= recordLen - chengAtomicTreeDarwinDirentNameOffset:
            return false
        let name = cheng_ptr_plus(record,
                                  chengAtomicTreeDarwinDirentNameOffset)
        if *(UInt8Ptr(cheng_ptr_plus(name, nameLen))) != uint8(0):
            return false
        let paddingStart = nameLen + 1
        let paddingEnd = recordLen - chengAtomicTreeDarwinDirentNameOffset
        for padIndex in paddingStart..<paddingEnd:
            if *(UInt8Ptr(cheng_ptr_plus(name, padIndex))) != uint8(0):
                return false
        outRecordLen = recordLen
        outName = name
        outNameLen = nameLen
        outType = int32(*(UInt8Ptr(cheng_ptr_plus(record, 20))))
        outIno = cheng_atomic_tree_u64le(record, 0)
        return outIno != uint64(0)
    if remaining < chengAtomicTreeLinuxDirentNameOffset + 1:
        return false
    let recordLen = cheng_atomic_tree_u16le(record, 16)
    if recordLen < chengAtomicTreeLinuxDirentNameOffset + 1 ||
       recordLen > remaining || recordLen % 8 != 0:
        return false
    let name = cheng_ptr_plus(record,
                              chengAtomicTreeLinuxDirentNameOffset)
    let nameCapacity = recordLen - chengAtomicTreeLinuxDirentNameOffset
    var nameLen: int32
    while nameLen < nameCapacity &&
          *(UInt8Ptr(cheng_ptr_plus(name, nameLen))) != uint8(0):
        nameLen = nameLen + 1
    if nameLen <= 0 || nameLen >= nameCapacity:
        return false
    outRecordLen = recordLen
    outName = name
    outNameLen = nameLen
    outType = int32(*(UInt8Ptr(cheng_ptr_plus(record, 18))))
    outIno = cheng_atomic_tree_u64le(record, 0)
    return outIno != uint64(0)

fn cheng_atomic_tree_dirent_dot_kind(name: ptr,
                                      nameLen: int32): int32 =
    if nameLen == 1 && *(UInt8Ptr(name)) == uint8(46):
        return 1
    if nameLen == 2 && *(UInt8Ptr(name)) == uint8(46) &&
       *(UInt8Ptr(cheng_ptr_plus(name, 1))) == uint8(46):
        return 2
    return 0

@borrows
fn cheng_atomic_tree_open_expected_dir(rootFd: int32,
                                        relativePath: str,
                                        expectedDev: uint64,
                                        expectedIno: uint64,
                                        outErr: ptr): int32 =
    var currentFd = libc_openat_runtime(rootFd,
                                         ".",
                                         cheng_atomic_tree_dir_open_flags(),
                                         0)
    if currentFd < 0:
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: exact directory root duplicate open failed")
        return -1
    let data = cheng_str_data(relativePath)
    let count = cheng_str_len(relativePath)
    var start: int32
    var position: int32
    if count > 0:
        while position <= count:
            if position < count &&
               *(UInt8Ptr(cheng_ptr_plus(data, position))) != uint8(47):
                position = position + 1
                continue
            let segment = cheng_string_copy(cheng_ptr_plus(data, start),
                                             position - start)
            if segment == nil:
                if !cheng_atomic_tree_close_fd_or_abort(
                       currentFd,
                       "atomic_tree_expected_dir_fd_close_failed"):
                    return -1
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: exact directory segment alloc failed")
                return -1
            let nextFd = libc_openat_runtime(currentFd,
                                              segment,
                                              cheng_atomic_tree_dir_open_flags(),
                                              0)
            cheng_free_export(segment)
            if !cheng_atomic_tree_close_fd_or_abort(
                   currentFd,
                   "atomic_tree_expected_dir_fd_close_failed"):
                return -1
            if nextFd < 0:
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: expected directory missing, wrong type, or symlink")
                return -1
            currentFd = nextFd
            start = position + 1
            position = position + 1
    var size: int64
    var mode: int32
    var dev: uint64
    var ino: uint64
    if !cheng_atomic_tree_fstat(currentFd, &size, &mode, &dev, &ino) ||
       (mode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir ||
       dev != expectedDev || ino != expectedIno:
        if !cheng_atomic_tree_close_fd_or_abort(
               currentFd,
               "atomic_tree_expected_dir_fd_close_failed"):
            return -1
        let _ = cheng_atomic_tree_set_error(
            outErr,
            "os atomic tree: expected directory identity drift")
        return -1
    return currentFd

@borrows
fn cheng_atomic_tree_enumerate_exact_dir(
        directoryFd: int32,
        directoryPath: str,
        expectedDirs: ChengAtomicTreeExpectedWire,
        expectedFiles: ChengAtomicTreeExpectedWire,
        matchedDirs: var int32,
        matchedFiles: var int32,
        depth: int32,
        recurseChildren: bool,
        outErr: ptr): bool =
    if depth < 0 || depth > 4096:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact directory depth exceeds bound")
        return false
    let buffer = cheng_malloc_locked(chengAtomicTreeDirentBufferBytes)
    if buffer == nil:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact enumeration alloc failed")
        return false
    let darwin = cheng_host_is_darwin()
    while true:
        let byteCount = libc_getdents_runtime(directoryFd,
                                               buffer,
                                               chengAtomicTreeDirentBufferBytes)
        if byteCount < 0 || byteCount > chengAtomicTreeDirentBufferBytes:
            cheng_free_locked(buffer)
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: fixed getdents failed")
            return false
        if byteCount == 0:
            break
        var offset: int32
        while offset < byteCount:
            let record = cheng_ptr_plus(buffer, offset)
            let remaining = byteCount - offset
            var recordLen: int32
            var name: ptr
            var nameLen: int32
            var entryType: int32
            var entryIno: uint64
            let parsed = cheng_atomic_tree_parse_dirent(record,
                                                         remaining,
                                                         darwin,
                                                         recordLen,
                                                         name,
                                                         nameLen,
                                                         entryType,
                                                         entryIno)
            if !parsed:
                cheng_free_locked(buffer)
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: malformed kernel dirent")
                return false
            offset = offset + recordLen
            let dotKind = cheng_atomic_tree_dirent_dot_kind(name, nameLen)
            if dotKind != 0:
                if entryType != chengAtomicTreeDirentTypeDir:
                    cheng_free_locked(buffer)
                    let _ = cheng_atomic_tree_set_error(outErr,
                                                         "os atomic tree: dot dirent type drift")
                    return false
                continue
            if !cheng_atomic_tree_segment_valid(name, nameLen):
                cheng_free_locked(buffer)
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: actual entry name is not canonical")
                return false
            let expectedDirIndex = cheng_atomic_tree_expected_wire_find_child(
                expectedDirs,
                directoryPath,
                name,
                nameLen)
            let expectedFileIndex = cheng_atomic_tree_expected_wire_find_child(
                expectedFiles,
                directoryPath,
                name,
                nameLen)
            if entryType == chengAtomicTreeDirentTypeSymlink:
                cheng_free_locked(buffer)
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: symlink entry rejected")
                return false
            if entryType != chengAtomicTreeDirentTypeDir &&
               entryType != chengAtomicTreeDirentTypeReg:
                cheng_free_locked(buffer)
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: unsupported or unknown entry type")
                return false
            let expectedIndex = entryType == chengAtomicTreeDirentTypeDir ?
                                expectedDirIndex : expectedFileIndex
            if expectedIndex < 0 ||
               (entryType == chengAtomicTreeDirentTypeDir &&
                expectedFileIndex >= 0) ||
               (entryType == chengAtomicTreeDirentTypeReg &&
                expectedDirIndex >= 0):
                cheng_free_locked(buffer)
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: extra entry or expected type mismatch")
                return false
            let openFlags = entryType == chengAtomicTreeDirentTypeDir ?
                            cheng_atomic_tree_dir_open_flags() :
                            cheng_atomic_tree_read_open_flags()
            let childFd = libc_openat_runtime(directoryFd,
                                               name,
                                               openFlags,
                                               0)
            var size: int64
            var mode: int32
            var dev: uint64
            var ino: uint64
            let expectedMode = entryType == chengAtomicTreeDirentTypeDir ?
                               chengAtomicTreeTypeDir : chengAtomicTreeTypeReg
            if childFd < 0 ||
               !cheng_atomic_tree_fstat(childFd,
                                         &size,
                                         &mode,
                                         &dev,
                                         &ino) ||
               (mode & chengAtomicTreeTypeMask) != expectedMode ||
               ino != entryIno:
                if childFd >= 0:
                    if !cheng_atomic_tree_close_fd_or_abort(
                           childFd,
                           "atomic_tree_exact_child_fd_close_failed"):
                        return false
                cheng_free_locked(buffer)
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: entry identity/type drift")
                return false
            if entryType == chengAtomicTreeDirentTypeDir:
                if matchedDirs >= expectedDirs.count:
                    if !cheng_atomic_tree_close_fd_or_abort(
                           childFd,
                           "atomic_tree_exact_child_fd_close_failed"):
                        return false
                    cheng_free_locked(buffer)
                    let _ = cheng_atomic_tree_set_error(outErr,
                                                         "os atomic tree: duplicate directory match")
                    return false
                matchedDirs = matchedDirs + 1
                var childOk = true
                if recurseChildren:
                    let childRaw = cheng_atomic_tree_expected_wire_item(
                        expectedDirs, expectedIndex)
                    var childPath = cheng_str_view(
                        childRaw.data, childRaw.len)
                    childOk = cheng_atomic_tree_enumerate_exact_dir(
                        childFd,
                        childPath,
                        expectedDirs,
                        expectedFiles,
                        matchedDirs,
                        matchedFiles,
                        depth + 1,
                        true,
                        outErr)
                if !cheng_atomic_tree_close_fd_or_abort(
                       childFd,
                       "atomic_tree_exact_child_fd_close_failed"):
                    return false
                if !childOk:
                    cheng_free_locked(buffer)
                    return false
            else:
                if !cheng_atomic_tree_close_fd_or_abort(
                       childFd,
                       "atomic_tree_exact_child_fd_close_failed"):
                    return false
                if matchedFiles >= expectedFiles.count:
                    cheng_free_locked(buffer)
                    let _ = cheng_atomic_tree_set_error(outErr,
                                                         "os atomic tree: duplicate file match")
                    return false
                matchedFiles = matchedFiles + 1
        if offset != byteCount:
            cheng_free_locked(buffer)
            let _ = cheng_atomic_tree_set_error(outErr,
                                                 "os atomic tree: dirent byte coverage drift")
            return false
    cheng_free_locked(buffer)
    return true

@borrows
fn cheng_atomic_tree_expected_root_set_validate(
        expectedDirs: ChengAtomicTreeExpectedWire,
        expectedFiles: ChengAtomicTreeExpectedWire,
        outErr: ptr): bool =
    if !cheng_atomic_tree_expected_set_validate(
            expectedDirs,
            expectedFiles,
            outErr):
        return false
    for dirIndex in 0..<expectedDirs.count:
        let directory = cheng_atomic_tree_expected_wire_item(
            expectedDirs, dirIndex)
        for byteIndex in 0..<directory.len:
            if *(UInt8Ptr(cheng_ptr_plus(
                   directory.data, byteIndex))) == uint8(47):
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: expected root directory is not a basename")
                return false
    for fileIndex in 0..<expectedFiles.count:
        let file = cheng_atomic_tree_expected_wire_item(
            expectedFiles, fileIndex)
        for byteIndex in 0..<file.len:
            if *(UInt8Ptr(cheng_ptr_plus(
                   file.data, byteIndex))) == uint8(47):
                let _ = cheng_atomic_tree_set_error(
                    outErr,
                    "os atomic tree: expected root file is not a basename")
                return false
    return true

@borrows
fn cheng_atomic_tree_verify_set_locked(
        cell: ChengAtomicTreeCellPtr,
        expectedDirs: ChengAtomicTreeExpectedWire,
        expectedFiles: ChengAtomicTreeExpectedWire,
        recurseChildren: bool,
        outErr: ptr): bool =
    if cell == nil || cell->rootFd < 0 ||
       (!cheng_atomic_tree_mode_is_transaction(cell->mode) &&
        !cheng_atomic_tree_mode_is_verified_read(cell->mode)):
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact verification requires live tree")
        return false
    if recurseChildren:
        if !cheng_atomic_tree_expected_set_validate(
                expectedDirs,
                expectedFiles,
                outErr):
            return false
    else:
        if !cheng_atomic_tree_expected_root_set_validate(
                expectedDirs,
                expectedFiles,
                outErr):
            return false
    let useFinalName = cheng_atomic_tree_mode_is_verified_read(cell->mode) ||
                       cell->committed != 0
    if !cheng_atomic_tree_verify_root_binding_locked(cell,
                                                      useFinalName,
                                                      outErr):
        return false
    var rootSize: int64
    var rootMode: int32
    var rootDev: uint64
    var rootIno: uint64
    if !cheng_atomic_tree_fstat(cell->rootFd,
                                 &rootSize,
                                 &rootMode,
                                 &rootDev,
                                 &rootIno) ||
       (rootMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact root fstat failed")
        return false
    var matchedDirs: int32
    var matchedFiles: int32
    var rootPath = cheng_str_empty()
    let rootScanFd = libc_openat_runtime(cell->rootFd,
                                          ".",
                                          cheng_atomic_tree_dir_open_flags(),
                                          0)
    if rootScanFd < 0:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact root duplicate open failed")
        return false
    var scanSize: int64
    var scanMode: int32
    var scanDev: uint64
    var scanIno: uint64
    if !cheng_atomic_tree_fstat(rootScanFd,
                                 &scanSize,
                                 &scanMode,
                                 &scanDev,
                                 &scanIno) ||
       (scanMode & chengAtomicTreeTypeMask) != chengAtomicTreeTypeDir ||
       scanDev != rootDev || scanIno != rootIno:
        if !cheng_atomic_tree_close_fd_or_abort(
               rootScanFd,
               "atomic_tree_exact_root_scan_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact root duplicate identity drift")
        return false
    let rootOk = cheng_atomic_tree_enumerate_exact_dir(rootScanFd,
                                                        rootPath,
                                                        expectedDirs,
                                                        expectedFiles,
                                                        matchedDirs,
                                                        matchedFiles,
                                                        0,
                                                        recurseChildren,
                                                        outErr)
    if !cheng_atomic_tree_close_fd_or_abort(
           rootScanFd,
           "atomic_tree_exact_root_scan_fd_close_failed"):
        return false
    if !rootOk:
        return false
    if matchedDirs != expectedDirs.count ||
       matchedFiles != expectedFiles.count:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: exact tree set is incomplete")
        return false
    return true

@borrows
fn cheng_atomic_tree_verify_exact_locked(
        cell: ChengAtomicTreeCellPtr,
        expectedDirs: ChengAtomicTreeExpectedWire,
        expectedFiles: ChengAtomicTreeExpectedWire,
        outErr: ptr): bool =
    return cheng_atomic_tree_verify_set_locked(cell,
                                                expectedDirs,
                                                expectedFiles,
                                                true,
                                                outErr)

@borrows
fn cheng_atomic_tree_verify_root_exact_locked(
        cell: ChengAtomicTreeCellPtr,
        expectedDirs: ChengAtomicTreeExpectedWire,
        expectedFiles: ChengAtomicTreeExpectedWire,
        outErr: ptr): bool =
    return cheng_atomic_tree_verify_set_locked(cell,
                                                expectedDirs,
                                                expectedFiles,
                                                false,
                                                outErr)

@borrows
@exportc("cheng_atomic_tree_verify_exact_bridge")
@abi_internal
fn cheng_atomic_tree_verify_exact_bridge_export(handle: uint64,
                                                 expectedDirsWire: str,
                                                 expectedFilesWire: str,
                                                 outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    var expectedDirs: ChengAtomicTreeExpectedWire
    var expectedFiles: ChengAtomicTreeExpectedWire
    if !cheng_atomic_tree_expected_wire_init(expectedDirsWire,
                                              expectedDirs,
                                              errorOut) ||
       !cheng_atomic_tree_expected_wire_init(expectedFilesWire,
                                              expectedFiles,
                                              errorOut):
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    let ok = cell != nil &&
             cheng_atomic_tree_verify_exact_locked(cell,
                                                    expectedDirs,
                                                    expectedFiles,
                                                    errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

@borrows
@exportc("cheng_atomic_tree_verify_root_exact_bridge")
@abi_internal
fn cheng_atomic_tree_verify_root_exact_bridge_export(
        handle: uint64,
        expectedDirsWire: str,
        expectedFilesWire: str,
        outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    var expectedDirs: ChengAtomicTreeExpectedWire
    var expectedFiles: ChengAtomicTreeExpectedWire
    if !cheng_atomic_tree_expected_wire_init(expectedDirsWire,
                                              expectedDirs,
                                              errorOut) ||
       !cheng_atomic_tree_expected_wire_init(expectedFilesWire,
                                              expectedFiles,
                                              errorOut):
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    let ok = cell != nil &&
             cheng_atomic_tree_verify_root_exact_locked(cell,
                                                         expectedDirs,
                                                         expectedFiles,
                                                         errorOut)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return ok ? 1 : 0

fn cheng_atomic_tree_sync_tracked_dirs_locked(cell: ChengAtomicTreeCellPtr,
                                               outErr: ptr): bool =
    var node = ChengAtomicTreeCreatedNodePtr(cell->createdHead)
    while node != nil:
        if node->isDir == 1:
            var relativePath =
                cheng_str_view(
                    node->relativePath,
                    cheng_cstrlen_raw(node->relativePath))
            var leaf: ptr
            let parentFd = cheng_atomic_tree_open_relative_parent(cell,
                                                                   relativePath,
                                                                   &leaf,
                                                                   outErr)
            if parentFd < 0:
                return false
            let fd = libc_openat_runtime(parentFd,
                                          leaf,
                                          cheng_atomic_tree_dir_open_flags(),
                                          0)
            cheng_free_locked(leaf)
            if !cheng_atomic_tree_close_fd_or_abort(
                   parentFd,
                   "atomic_tree_sync_parent_fd_close_failed"):
                return false
            if fd < 0:
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: tracked directory sync open failed")
                return false
            let identityOk = cheng_atomic_tree_node_identity_matches(
                node,
                fd,
                chengAtomicTreeTypeDir)
            let syncOk = identityOk && libc_fsync_runtime(fd) == 0
            if !cheng_atomic_tree_close_fd_or_abort(
                   fd,
                   "atomic_tree_sync_dir_fd_close_failed"):
                return false
            if !syncOk:
                let _ = cheng_atomic_tree_set_error(outErr,
                                                     "os atomic tree: tracked directory identity/fsync failed")
                return false
        node = ChengAtomicTreeCreatedNodePtr(node->next)
    return true

@exportc("cheng_atomic_tree_commit_noreplace_bridge")
@abi_internal
fn cheng_atomic_tree_commit_noreplace_bridge_export(handle: uint64,
                                                     outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    if cell == nil || cell->mode != chengAtomicTreeModeTransaction ||
       cell->committed != 0:
        if cell != nil:
            let _ = cheng_atomic_tree_set_error(errorOut,
                                                 "os atomic tree: commit requires active transaction")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    if !cheng_atomic_tree_verify_verified_category_locked(cell, errorOut) ||
       !cheng_atomic_tree_verify_root_binding_locked(cell, false, errorOut) ||
       !cheng_atomic_tree_sync_tracked_dirs_locked(cell, errorOut):
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    if libc_fsync_runtime(cell->rootFd) != 0:
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: root fsync failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let renameRc = libc_renameat_noreplace_runtime(cell->parentFd,
                                                    cell->stagingName,
                                                    cell->finalName)
    if renameRc != 0:
        let err = native_cheng_errno_code_runtime()
        if renameRc == -1 && err == 17:
            cheng_runtime_unlock()
            cheng_runtime_error_wire_project(&errorWire, outErr)
            return chengAtomicTreeCommitDestinationExists
        if renameRc == -2:
            let _ = cheng_atomic_tree_set_error(errorOut,
                                                 "os atomic tree: no-replace rename unsupported")
        else:
            let _ = cheng_atomic_tree_set_error(errorOut,
                                                 "os atomic tree: no-replace rename failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cell->committed = 1
    if !cheng_atomic_tree_verify_root_binding_locked(cell, true, errorOut):
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return chengAtomicTreeCommitDurabilityUnknown
    if libc_fsync_runtime(cell->parentFd) != 0:
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: committed parent fsync failed")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return chengAtomicTreeCommitDurabilityUnknown
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return chengAtomicTreeCommitCommitted

fn cheng_atomic_tree_remove_created_node_locked(
        cell: ChengAtomicTreeCellPtr,
        node: ChengAtomicTreeCreatedNodePtr,
        outErr: ptr): bool =
    var relativePath =
        cheng_str_view(
            node->relativePath,
            cheng_cstrlen_raw(node->relativePath))
    var leaf: ptr
    let parentFd = cheng_atomic_tree_open_relative_parent(cell,
                                                           relativePath,
                                                           &leaf,
                                                           outErr)
    if parentFd < 0:
        return false
    let expectedType = node->isDir == 1 ?
                       chengAtomicTreeTypeDir : chengAtomicTreeTypeReg
    let flags = node->isDir == 1 ? cheng_atomic_tree_dir_open_flags() :
                                  cheng_atomic_tree_read_open_flags()
    let fd = libc_openat_runtime(parentFd, leaf, flags, 0)
    if fd < 0 ||
       !cheng_atomic_tree_node_identity_matches(node, fd, expectedType):
        if fd >= 0:
            if !cheng_atomic_tree_close_fd_or_abort(
                   fd,
                   "atomic_tree_abort_node_fd_close_failed"):
                return false
        cheng_free_locked(leaf)
        if !cheng_atomic_tree_close_fd_or_abort(
               parentFd,
               "atomic_tree_abort_node_parent_fd_close_failed"):
            return false
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: abort node identity drift")
        return false
    if !cheng_atomic_tree_close_fd_or_abort(
           fd,
           "atomic_tree_abort_node_fd_close_failed"):
        return false
    let unlinkFlags = node->isDir == 1 ?
                      cheng_atomic_tree_removedir_flag() : 0
    let removed = libc_unlinkat_runtime(parentFd, leaf, unlinkFlags) == 0
    cheng_free_locked(leaf)
    if !cheng_atomic_tree_close_fd_or_abort(
           parentFd,
           "atomic_tree_abort_node_parent_fd_close_failed"):
        return false
    if !removed:
        let _ = cheng_atomic_tree_set_error(outErr,
                                             "os atomic tree: abort tracked node removal failed")
        return false
    return true

fn cheng_atomic_tree_exclusive_rollback_terminal_locked(
        cell: ChengAtomicTreeCellPtr,
        outErr: ptr,
        failure: ptr): bool =
    if cell == nil ||
       !cheng_atomic_tree_verify_root_binding_locked(cell, false, outErr):
        cheng_allocation_ledger_abort(failure)
        return false
    var node = ChengAtomicTreeCreatedNodePtr(cell->createdHead)
    while node != nil:
        if !cheng_atomic_tree_remove_created_node_locked(cell,
                                                          node,
                                                          outErr):
            cheng_allocation_ledger_abort(failure)
            return false
        node = ChengAtomicTreeCreatedNodePtr(node->next)
    return cheng_atomic_tree_exclusive_terminal_discard_locked(
        cell,
        true,
        failure)

@exportc("cheng_atomic_tree_commit_exclusive_noreplace_and_open_verified_bridge")
@abi_internal
fn cheng_atomic_tree_commit_exclusive_noreplace_and_open_verified_bridge_export(
        handle: uint64,
        outConsumed: Int32Ptr,
        outErr: ptr): uint64 =
    cheng_atomic_tree_clear_error(outErr)
    if outConsumed != nil:
        *outConsumed = 0
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    if outConsumed == nil:
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: nil exclusive commit consumption output")
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    if cell == nil ||
       cell->mode != chengAtomicTreeModeExclusiveTransaction ||
       cell->committed != 0 || cell->exclusiveLeaseHeld != 1:
        if cell != nil:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: exclusive commit requires active transaction")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    if !cheng_atomic_tree_verify_root_binding_locked(cell, false, errorOut):
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cell->committed = -1
    if !cheng_atomic_tree_invalidate_handle_locked(handle):
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_commit_handle_invalidation_failed")
        return uint64(0)
    *outConsumed = 1
    if !cheng_atomic_tree_sync_tracked_dirs_locked(cell, errorOut) ||
       libc_fsync_runtime(cell->rootFd) != 0 ||
       !cheng_atomic_tree_verify_root_binding_locked(cell,
                                                      false,
                                                      errorOut):
        let _ = cheng_atomic_tree_set_error(
            errorOut,
            "os atomic tree: exclusive pre-commit durability failed")
        if !cheng_atomic_tree_exclusive_rollback_terminal_locked(
               cell,
               errorOut,
               "atomic_tree_exclusive_precommit_rollback_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    let renameRc = libc_renameat_noreplace_runtime(cell->parentFd,
                                                    cell->stagingName,
                                                    cell->finalName)
    if renameRc != 0:
        let renameErr = native_cheng_errno_code_runtime()
        if renameRc == -1 && renameErr == 17:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: exclusive destination already exists")
        elif renameRc == -2:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: no-replace rename unsupported")
        else:
            let _ = cheng_atomic_tree_set_error(
                errorOut,
                "os atomic tree: exclusive no-replace rename failed")
        if !cheng_atomic_tree_exclusive_rollback_terminal_locked(
               cell,
               errorOut,
               "atomic_tree_exclusive_rename_rollback_failed"):
            return uint64(0)
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return uint64(0)
    cell->mode = chengAtomicTreeModeExclusiveCommitted
    cell->committed = 1
    if !cheng_atomic_tree_verify_root_binding_locked(cell, true, errorOut) ||
       libc_fsync_runtime(cell->parentFd) != 0:
        if !cheng_atomic_tree_exclusive_terminal_discard_locked(
               cell,
               false,
               "atomic_tree_exclusive_postrename_terminal_close_failed"):
            return uint64(0)
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_postrename_durability_unknown")
        return uint64(0)
    if cell->stagingName != nil:
        cheng_free_locked(cell->stagingName)
        cell->stagingName = nil
    cell->mode = chengAtomicTreeModeExclusiveOpened
    let newHandle = cheng_ffi_handle_register_ptr_locked(ptr(cell))
    if newHandle == uint64(0):
        if !cheng_atomic_tree_exclusive_terminal_discard_locked(
               cell,
               false,
               "atomic_tree_exclusive_commit_register_terminal_close_failed"):
            return uint64(0)
        cheng_allocation_ledger_abort(
            "atomic_tree_exclusive_commit_register_failed")
        return uint64(0)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return newHandle

@exportc("cheng_atomic_tree_abort_bridge")
@abi_internal
fn cheng_atomic_tree_abort_bridge_export(handle: uint64,
                                          outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    if cell == nil ||
       !cheng_atomic_tree_mode_is_transaction(cell->mode) ||
       cell->committed != 0:
        if cell != nil:
            let _ = cheng_atomic_tree_set_error(errorOut,
                                                 "os atomic tree: abort requires active transaction")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    let exclusive = cell->mode == chengAtomicTreeModeExclusiveTransaction
    var ok = cheng_atomic_tree_verify_verified_category_locked(
        cell, errorOut) &&
        cheng_atomic_tree_verify_root_binding_locked(cell, false, errorOut)
    if exclusive && ok:
        ok = cheng_atomic_tree_invalidate_handle_locked(handle)
        if !ok:
            cheng_allocation_ledger_abort(
                "atomic_tree_exclusive_abort_handle_invalidation_failed")
            return 0
    var node = ChengAtomicTreeCreatedNodePtr(cell->createdHead)
    while node != nil:
        if ok && !cheng_atomic_tree_remove_created_node_locked(cell,
                                                                node,
                                                                errorOut):
            ok = false
        node = ChengAtomicTreeCreatedNodePtr(node->next)
    if ok && exclusive:
        ok = cheng_atomic_tree_verify_root_binding_locked(
            cell,
            false,
            errorOut)
    if !ok:
        cheng_allocation_ledger_abort(
            "atomic_tree_abort_rollback_failed")
        return 0
    if cell->rootFd >= 0:
        if !cheng_atomic_tree_close_fd_or_abort(
               cell->rootFd,
               "atomic_tree_abort_root_fd_close_failed"):
            return 0
        cell->rootFd = -1
    if libc_unlinkat_runtime(cell->parentFd,
                              cell->stagingName,
                              cheng_atomic_tree_removedir_flag()) != 0 ||
       libc_fsync_runtime(cell->parentFd) != 0:
        cheng_allocation_ledger_abort(
            "atomic_tree_abort_staging_removal_or_fsync_failed")
        return 0
    if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
        return 0
    if !exclusive:
        let invalidated = cheng_atomic_tree_invalidate_handle_locked(handle)
        if !invalidated:
            cheng_allocation_ledger_abort(
                "atomic_tree_abort_handle_invalidation_failed")
            return 0
    cheng_atomic_tree_cell_free(cell)
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return 1

@exportc("cheng_atomic_tree_close_bridge")
@abi_internal
fn cheng_atomic_tree_close_bridge_export(handle: uint64,
                                          outErr: ptr): int32 =
    cheng_atomic_tree_clear_error(outErr)
    var errorWire: ChengRuntimeErrorWire
    cheng_runtime_error_wire_init(&errorWire)
    let errorOut = ptr(&errorWire)
    cheng_runtime_lock()
    let cell = cheng_atomic_tree_cell_from_handle_locked(handle, errorOut)
    if cell == nil:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    if cheng_atomic_tree_mode_is_transaction(cell->mode) &&
       cell->committed == 0:
        let _ = cheng_atomic_tree_set_error(errorOut,
                                             "os atomic tree: active transaction must abort")
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    var verifiedStable =
        cheng_atomic_tree_verify_verified_category_locked(cell, errorOut)
    if cell->mode == chengAtomicTreeModeExclusiveAbsent:
        verifiedStable = verifiedStable &&
            cheng_atomic_tree_verify_exclusive_absent_locked(
                cell,
                errorOut)
    elif cheng_atomic_tree_mode_is_verified_read(cell->mode):
        verifiedStable = verifiedStable &&
            cheng_atomic_tree_verify_root_binding_locked(
                cell,
                true,
                errorOut)
        var node = ChengAtomicTreeVerifiedReadNodePtr(
            cell->verifiedReadHead)
        while verifiedStable && node != nil:
            if node->relativePath == nil:
                let _ = cheng_atomic_tree_set_error(
                    errorOut,
                    "os atomic tree: verified read ledger corrupt")
                verifiedStable = false
            else:
                var relativePath =
                    cheng_str_view(
                        node->relativePath,
                        cheng_cstrlen_raw(
                            node->relativePath))
                var replayRaw: ptr
                var replayLength: int32
                verifiedStable = cheng_atomic_tree_read_locked(
                    cell,
                    relativePath,
                    &replayRaw,
                    &replayLength,
                    errorOut)
                if replayRaw != nil:
                    cheng_free_locked(replayRaw)
            node = ChengAtomicTreeVerifiedReadNodePtr(node->next)
        if verifiedStable:
            verifiedStable = cheng_atomic_tree_verify_root_binding_locked(
                cell,
                true,
                errorOut)
    if !cheng_atomic_tree_cell_close_fds_or_abort(cell):
        return 0
    let invalidated = cheng_atomic_tree_invalidate_handle_locked(handle)
    if !invalidated:
        cheng_allocation_ledger_abort(
            "atomic_tree_close_handle_invalidation_failed")
        return 0
    cheng_atomic_tree_cell_free(cell)
    if !verifiedStable:
        cheng_runtime_unlock()
        cheng_runtime_error_wire_project(&errorWire, outErr)
        return 0
    cheng_runtime_unlock()
    cheng_runtime_error_wire_project(&errorWire, outErr)
    return 1

fn cheng_empty_cstring_alloc(): ptr =
    return cheng_string_copy("", 0)

fn cheng_fopen_read(path: ptr): ptr =
    if path == nil:
        return nil
    let mode = cheng_string_copy("rb", 2)
    if mode == nil:
        return nil
    let fp = libc_fopen(path, mode)
    cheng_free_export(mode)
    return fp

@borrows
fn cheng_str_equals_cstring(text: str, raw: ptr): bool =
    let textLen = cheng_str_len(text)
    let rawLen = cheng_cstrlen_raw(raw)
    if textLen != rawLen:
        return false
    if textLen <= 0:
        return true
    return cheng_bytes_equal(cheng_str_data(text), raw, textLen)

@borrows
fn cheng_str_has_prefix_cstring(text: str, prefix: ptr): bool =
    let textLen = cheng_str_len(text)
    let prefixLen = cheng_cstrlen_raw(prefix)
    if prefixLen <= 0:
        return true
    if textLen < prefixLen:
        return false
    return cheng_bytes_equal(cheng_str_data(text), prefix, prefixLen)

@borrows
fn cheng_str_slice_copy(text: str, start0: int32, count0: int32): str =
    let textLen = cheng_str_len(text)
    let textData = cheng_str_data(text)
    var start = start0
    var count = count0
    if textData == nil || textLen <= 0:
        return cheng_str_empty()
    if start < 0:
        start = 0
    if start >= textLen || count <= 0:
        return cheng_str_empty()
    if start + count > textLen:
        count = textLen - start
    return cheng_str_copy(cheng_ptr_plus(textData, start), count)

fn cheng_cstring_equals_cstring(a: ptr, b: ptr): bool =
    let lenA = cheng_cstrlen_raw(a)
    let lenB = cheng_cstrlen_raw(b)
    if lenA != lenB:
        return false
    if lenA <= 0:
        return true
    return cheng_bytes_equal(a, b, lenA)

@borrows
fn cheng_read_text_file(path: str): str =
    let rawPath = cheng_copy_cstring_from_str(path)
    if rawPath == nil:
        return cheng_str_empty()
    let fp = cheng_fopen_read(rawPath)
    cheng_free_export(rawPath)
    if fp == nil:
        return cheng_str_empty()
    var cap: int32 = 1024
    var out = driver_c_new_string_export(cap)
    if out == nil:
        libc_fclose(fp)
        return cheng_str_empty()
    var used: int32
    while true:
        let got = int32(libc_fread(cheng_ptr_plus(out, used), int64(1), int64(cap - used), fp))
        if got < 0:
            libc_fclose(fp)
            cheng_free_export(out)
            return cheng_str_empty()
        used = used + got
        *(UInt8Ptr(cheng_ptr_plus(out, used))) = uint8(0)
        if got == 0:
            break
        if used >= cap:
            let nextCap = cap * 2
            let next = cheng_realloc_export(out, nextCap + 1)
            if next == nil:
                libc_fclose(fp)
                cheng_free_export(out)
                return cheng_str_empty()
            out = next
            cap = nextCap
    libc_fclose(fp)
    return cheng_str_view_owned(out, used)

fn cheng_read_file_all_raw(path: ptr): ptr =
    if path == nil || *(UInt8Ptr(path)) == uint8(0):
        return cheng_empty_cstring_alloc()
    let fp = cheng_fopen_read(path)
    if fp == nil:
        return cheng_empty_cstring_alloc()
    var cap: int32 = 1024
    var out = cheng_malloc_export(cap + 1)
    if out == nil:
        libc_fclose(fp)
        return nil
    var got: int32
    while true:
        if got >= cap:
            let nextCap: int32 = cap * 2
            let next = cheng_realloc_export(out, nextCap + 1)
            if next == nil:
                libc_fclose(fp)
                cheng_free_export(out)
                return cheng_empty_cstring_alloc()
            out = next
            cap = nextCap
        let chunk = int32(libc_fread(cheng_ptr_plus(out, got), 1, int64(cap - got), fp))
        if chunk <= 0:
            break
        got = got + chunk
    libc_fclose(fp)
    cheng_bytes_set(cheng_ptr_plus(out, got), 0, 1)
    return out

fn cheng_file_exists_raw(path: ptr): bool =
    if path == nil || *(UInt8Ptr(path)) == uint8(0):
        return false
    var st: DarwinStat
    if libc_stat(path, ptr(&st)) != 0:
        return false
    return (int32(st.st_mode) & chengStatTypeMask) != chengStatTypeDir

fn cheng_dir_exists_raw(path: ptr): bool =
    if path == nil || *(UInt8Ptr(path)) == uint8(0):
        return false
    let dir = libc_opendir(path)
    if dir == nil:
        return false
    libc_closedir(dir)
    return true

fn cheng_file_size_raw(path: ptr): int64 =
    if path == nil || *(UInt8Ptr(path)) == uint8(0):
        return 0
    # #38 fixup: PERF-7(2677bdb26) 把这里从 fopen+fseek+ftell 换成
    # `var st: DarwinStat; libc_stat(...); return st.st_size`, 用 C harness
    # (裸 C 侧手写 struct stat 读取)验证过与旧实现同值——但 C harness 验的是
    # C 编译器读出的字段, 不是 cheng 自举编译器读出的字段。实测(影子树
    # os_filesize_nonblock_smoke.cheng, 12347/1/4096/4097/0 字节夹具 + 真实
    # /usr/bin/stat 对照)证实: 本仓自举编译器(cheng.stage3, system-link-exec
    # --link-providers)对 DarwinStat.st_size 字段访问算出的是错误偏移, 实际
    # 读到的是 st_blocks 所在内存(裸指针按偏移 96 读正确, 按字段名 st.st_size
    # 读到 st_blocks 值; st.st_blocks 字段访问同理错位读到 st_blksize)——即
    # #38"os.FileSize 返回 st_blocks"缺陷的真根因是编译器 struct 字段偏移
    # 计算 bug, 不是 PERF-7 改动前的旧逻辑有问题。旧 fopen+fseek+ftell 路径
    # 全程走 @importc 直连 libc, 不经过本仓编译器的 struct 字段偏移计算,
    # 不触发该 bug, 经同一夹具实测正确, 故先原样恢复止损(#38 关闭), 编译器
    # 侧 DarwinStat 字段偏移根因另立专项(不在本 fixup scope)。
    let fp = cheng_fopen_read(path)
    if fp == nil:
        return 0
    if libc_fseek(fp, int64(0), chengSeekEnd) != 0:
        libc_fclose(fp)
        return 0
    let size = libc_ftell(fp)
    libc_fclose(fp)
    if size < int64(0):
        return 0
    return size

fn cheng_file_mtime_raw(path: ptr): int64 =
    if path == nil || *(UInt8Ptr(path)) == uint8(0):
        return 0
    var st: DarwinStat
    if libc_stat(path, ptr(&st)) != 0:
        return 0
    return st.st_mtimespec.tv_sec

fn cheng_path_is_sep(ch: int32): bool =
    if ch == int32('/'):
        return true
    if ch == int32('\\'):
        return true
    return false

fn cheng_mkdir_if_needed(path: ptr) =
    if path == nil || *(UInt8Ptr(path)) == uint8(0):
        return
    if cheng_dir_exists_raw(path):
        return
    let rc = libc_mkdir(path, 493)
    rc

fn cheng_mkdir_all_raw(path: ptr, includeLeaf: bool) =
    if path == nil:
        return
    let n = cheng_cstrlen_raw(path)
    if n <= 0:
        return
    let scratch = cheng_string_copy(path, n)
    if scratch == nil:
        return
    for i in 0..<n:
        let ch = cheng_load_u8(scratch, i)
        if cheng_path_is_sep(ch):
            if i > 0:
                var skip = false
                if i == 2:
                    if cheng_load_u8(scratch, 1) == 58:
                        skip = true
                if !skip:
                    *(UInt8Ptr(cheng_ptr_plus(scratch, i))) = uint8(0)
                    cheng_mkdir_if_needed(scratch)
                    *(UInt8Ptr(cheng_ptr_plus(scratch, i))) = uint8(ch)
    if includeLeaf:
        cheng_mkdir_if_needed(scratch)
    cheng_free_export(scratch)

fn cheng_sleep_ms(value: int32) =
    if value <= 0:
        return
    libc_usleep(uint32(value * 1000))

@borrows
fn cheng_http_find_char(text: str, target: int32, start0: int32): int32 =
    let data = cheng_str_data(text)
    let n = cheng_str_len(text)
    if data == nil || n <= 0:
        return -1
    var start = start0
    if start < 0:
        start = 0
    for i in start..<n:
        if cheng_load_u8(data, i) == target:
            return i
    return -1

@borrows
fn cheng_http_response_status_ok(response: str): bool =
    let data = cheng_str_data(response)
    let n = cheng_str_len(response)
    if data == nil || n < 12:
        return false
    let space = cheng_http_find_char(response, 32, 0)
    if space < 0 || space + 4 > n:
        return false
    let d0 = cheng_load_u8(data, space + 1)
    let d1 = cheng_load_u8(data, space + 2)
    let d2 = cheng_load_u8(data, space + 3)
    if d0 < int32('0') || d0 > int32('9') ||
       d1 < int32('0') || d1 > int32('9') ||
       d2 < int32('0') || d2 > int32('9'):
        return false
    return d0 == int32('2')

@borrows
fn cheng_http_response_body(response: str): str =
    let data = cheng_str_data(response)
    let n = cheng_str_len(response)
    if data == nil || n <= 0:
        return cheng_str_empty()
    var i: int32
    while i + 3 < n:
        if cheng_load_u8(data, i) == 13 &&
           cheng_load_u8(data, i + 1) == 10 &&
           cheng_load_u8(data, i + 2) == 13 &&
           cheng_load_u8(data, i + 3) == 10:
            return cheng_str_slice_copy(response, i + 4, n - i - 4)
        i = i + 1
    i = 0
    while i + 1 < n:
        if cheng_load_u8(data, i) == 10 &&
           cheng_load_u8(data, i + 1) == 10:
            return cheng_str_slice_copy(response, i + 2, n - i - 2)
        i = i + 1
    return cheng_str_empty()

@borrows
fn cheng_http_parse_url(url: str,
                        outHost: var str,
                        outPort: var int32,
                        outPath: var str,
                        outHttps: var bool): bool =
    outHost = cheng_str_empty()
    outPort = 0
    outPath = cheng_str_empty()
    outHttps = false
    let n = cheng_str_len(url)
    if n <= 0:
        return false
    var start = 0
    if cheng_str_has_prefix_cstring(url, "http://"):
        start = 7
        outPort = 80
    elif cheng_str_has_prefix_cstring(url, "https://"):
        start = 8
        outPort = 443
        outHttps = true
    else:
        return false
    let slash = cheng_http_find_char(url, int32('/'), start)
    let authorityEnd = if slash >= 0: slash else: n
    if authorityEnd <= start:
        return false
    var authority = cheng_str_slice_copy(url, start, authorityEnd - start)
    let authorityLen = cheng_str_len(authority)
    if authorityLen <= 0:
        cheng_str_dispose(authority)
        return false
    let authorityData = cheng_str_data(authority)
    var colon = -1
    var i: int32
    for i in i..<authorityLen:
        let ch = cheng_load_u8(authorityData, i)
        if ch == 91 || ch == 93 || ch == 64:
            cheng_str_dispose(authority)
            return false
        if ch == 58:
            if colon >= 0:
                cheng_str_dispose(authority)
                return false
            colon = i
    if colon >= 0:
        if colon <= 0 || colon + 1 >= authorityLen:
            cheng_str_dispose(authority)
            return false
        outHost = cheng_str_slice_copy(authority, 0, colon)
        var portText = cheng_str_slice_copy(authority, colon + 1, authorityLen - colon - 1)
        outPort = cheng_runtime_parse_int32(portText, -1)
        cheng_str_dispose(portText)
        if outPort <= 0 || outPort > 65535:
            cheng_str_dispose(authority)
            cheng_str_dispose(outHost)
            outHost = cheng_str_empty()
            return false
    else:
        outHost = share(authority)
    if slash >= 0:
        outPath = cheng_str_slice_copy(url, slash, n - slash)
    else:
        outPath = cheng_str_copy_cstring("/")
    if cheng_str_len(outHost) <= 0 || cheng_str_len(outPath) <= 0:
        cheng_str_dispose(authority)
        cheng_str_dispose(outHost)
        cheng_str_dispose(outPath)
        outHost = cheng_str_empty()
        outPath = cheng_str_empty()
        return false
    cheng_str_dispose(authority)
    return true

@borrows
fn cheng_http_connect_ipv4(hostText: str, port: int32): int32 =
    if port <= 0 || port > 65535:
        return -1
    let fd = libc_socket(cheng_af_inet(), cheng_sock_stream(), cheng_ipproto_ip())
    if fd < 0:
        return -1
    var connectAddr: ptr = nil
    if cheng_str_len(hostText) <= 0 || cheng_str_equals_cstring(hostText, "localhost"):
        connectAddr = cheng_sockaddr_loopback(port)
    else:
        connectAddr = cheng_sockaddr_ipv4_parse(hostText, port)
    if connectAddr == nil:
        cheng_close_if_open(fd)
        return -1
    if libc_connect(fd, connectAddr, chengSockaddrInLen) != 0:
        cheng_free_export(connectAddr)
        cheng_close_if_open(fd)
        return -1
    cheng_free_export(connectAddr)
    return fd

fn cheng_http_recv_all(fd: int32): str =
    if fd < 0:
        return cheng_str_empty()
    var cap: int32 = 2048
    var out = driver_c_new_string_export(cap)
    if out == nil:
        return cheng_str_empty()
    var used: int32
    while true:
        if used >= cap:
            let nextCap = cap * 2
            let next = cheng_realloc_export(out, nextCap + 1)
            if next == nil:
                cheng_free_export(out)
                return cheng_str_empty()
            out = next
            cap = nextCap
        let got = libc_recv(fd, cheng_ptr_plus(out, used), cap - used, 0)
        if got < 0:
            cheng_free_export(out)
            return cheng_str_empty()
        if got == 0:
            *(UInt8Ptr(cheng_ptr_plus(out, used))) = uint8(0)
            return cheng_str_view_owned(out, used)
        used = used + got
        *(UInt8Ptr(cheng_ptr_plus(out, used))) = uint8(0)
@borrows
fn cheng_http_load_endpoint_payload_ex(endpoint: str, outErr: var str): str =
    outErr = cheng_str_empty()
    var host = cheng_str_empty()
    var path = cheng_str_empty()
    var port: int32
    var isHttps = false
    if !cheng_http_parse_url(endpoint, host, port, path, isHttps):
        outErr = cheng_str_copy_cstring("http probe: invalid url")
        return cheng_str_empty()
    if isHttps:
        outErr = cheng_str_copy_cstring("http probe: https unsupported")
        cheng_str_dispose(host)
        cheng_str_dispose(path)
        return cheng_str_empty()
    let fd = cheng_http_connect_ipv4(host, port)
    if fd < 0:
        outErr = cheng_str_copy_cstring("http probe: connect failed")
        cheng_str_dispose(host)
        cheng_str_dispose(path)
        return cheng_str_empty()
    var request = cheng_str_copy_cstring("GET ")
    cheng_runtime_concat_assign(request, path)
    cheng_runtime_concat_assign_cstring(request, " HTTP/1.0\r\n")
    cheng_runtime_concat_assign_cstring(request, "Host: ")
    cheng_runtime_concat_assign(request, host)
    cheng_runtime_concat_assign_cstring(request, "\r\n")
    cheng_runtime_concat_assign_cstring(request, "Connection: close\r\n")
    cheng_runtime_concat_assign_cstring(request, "Accept: application/json\r\n\r\n")
    let requestData = cheng_str_data(request)
    let requestLen = cheng_str_len(request)
    let sentOk = cheng_send_all(fd, requestData, requestLen)
    var response = cheng_str_empty()
    if sentOk:
        response = cheng_http_recv_all(fd)
    cheng_close_if_open(fd)
    cheng_str_dispose(request)
    cheng_str_dispose(host)
    cheng_str_dispose(path)
    if !sentOk:
        outErr = cheng_str_copy_cstring("http probe: send failed")
        cheng_str_dispose(response)
        return cheng_str_empty()
    if cheng_str_len(response) <= 0:
        outErr = cheng_str_copy_cstring("http probe: recv failed")
        cheng_str_dispose(response)
        return cheng_str_empty()
    if !cheng_http_response_status_ok(response):
        outErr = cheng_str_copy_cstring("http probe: bad status")
        cheng_str_dispose(response)
        return cheng_str_empty()
    let payload = cheng_http_response_body(response)
    cheng_str_dispose(response)
    if cheng_str_len(payload) <= 0:
        outErr = cheng_str_copy_cstring("http probe: missing body")
        return cheng_str_empty()
    outErr = cheng_str_empty()
    return payload

@borrows
fn cheng_http_load_endpoint_payload(endpoint: str): str =
    var err = cheng_str_empty()
    let payload = cheng_http_load_endpoint_payload_ex(endpoint, err)
    cheng_str_dispose(err)
    return payload

@borrows
fn cheng_tailnet_load_endpoint_payload(endpoint: str): str =
    var clean = cheng_str_strip_bridge_export(endpoint)
    if cheng_str_len(clean) <= 0:
        return cheng_str_empty()
    var payload = cheng_str_empty()
    if cheng_str_has_prefix_cstring(clean, "file://"):
        var path = cheng_str_slice_copy(clean, 7, cheng_str_len(clean) - 7)
        payload = cheng_read_text_file(path)
        cheng_str_dispose(path)
    elif cheng_str_has_prefix_cstring(clean, "http://") ||
         cheng_str_has_prefix_cstring(clean, "https://"):
        payload = cheng_http_load_endpoint_payload(clean)
    else:
        payload = cheng_read_text_file(clean)
    cheng_str_dispose(clean)
    return payload

fn cheng_tailnet_load_endpoint_payload_cstring(endpoint: ptr): str =
    if endpoint == nil:
        return cheng_str_empty()
    var text = cheng_str_copy_cstring(endpoint)
    let payload = cheng_tailnet_load_endpoint_payload(text)
    cheng_str_dispose(text)
    return payload

@borrows
fn cheng_tailnet_json_skip_ws(payload: str, idx0: int32): int32 =
    let data = cheng_str_data(payload)
    let n = cheng_str_len(payload)
    var idx = idx0
    if idx >= n:
        return idx
    for i in idx..<n:
        let ch = cheng_load_u8(data, i)
        if !cheng_ascii_space(uint8(ch)):
            return i
    return n

@borrows
fn cheng_tailnet_json_value_after_key(payload: str, key: ptr): int32 =
    let payloadData = cheng_str_data(payload)
    let payloadLen = cheng_str_len(payload)
    let keyLen = cheng_cstrlen_raw(key)
    if payloadData == nil || payloadLen <= 0 || key == nil || keyLen <= 0:
        return -1
    let quote = 34
    let colon = 58
    let limit = payloadLen - keyLen - 2
    var i: int32
    for i in i..limit:
        let ch0 = cheng_load_u8(payloadData, i)
        if ch0 == quote:
            let keyMatch = cheng_bytes_equal(cheng_ptr_plus(payloadData, i + 1), key, keyLen)
            if keyMatch:
                let ch1 = cheng_load_u8(payloadData, i + keyLen + 1)
                if ch1 == quote:
                    var idx = cheng_tailnet_json_skip_ws(payload, i + keyLen + 2)
                    if idx < payloadLen:
                        let sep = cheng_load_u8(payloadData, idx)
                        if sep == colon:
                            idx = cheng_tailnet_json_skip_ws(payload, idx + 1)
                            if idx < payloadLen:
                                return idx
    return -1

fn cheng_tailnet_json_bool_term(ch: int32): bool =
    if ch == 0:
        return true
    if ch == 44:
        return true
    if ch == 125:
        return true
    return cheng_ascii_space(uint8(ch))

fn cheng_tailnet_json_match_literal(data: ptr, idx: int32, totalLen: int32, text: ptr): bool =
    let textLen = cheng_cstrlen_raw(text)
    if data == nil || idx < 0 || totalLen < 0 || text == nil || textLen <= 0:
        return false
    if idx + textLen > totalLen:
        return false
    return cheng_bytes_equal(cheng_ptr_plus(data, idx), text, textLen)

@borrows
fn cheng_tailnet_json_read_bool(payload: str, key: ptr, outValue: var bool): bool =
    let idx = cheng_tailnet_json_value_after_key(payload, key)
    let data = cheng_str_data(payload)
    let n = cheng_str_len(payload)
    outValue = false
    if idx < 0 || data == nil:
        return false
    if cheng_tailnet_json_match_literal(data, idx, n, "true"):
        let endIdx = idx + 4
        if endIdx >= n || cheng_tailnet_json_bool_term(cheng_load_u8(data, endIdx)):
            outValue = true
            return true
    if cheng_tailnet_json_match_literal(data, idx, n, "false"):
        let endIdx = idx + 5
        if endIdx >= n || cheng_tailnet_json_bool_term(cheng_load_u8(data, endIdx)):
            outValue = false
            return true
    return false

@borrows
fn cheng_tailnet_json_read_string(payload: str, key: ptr, outValue: var str): bool =
    outValue = cheng_str_empty()
    let idx = cheng_tailnet_json_value_after_key(payload, key)
    let data = cheng_str_data(payload)
    let n = cheng_str_len(payload)
    if idx < 0 || data == nil || idx >= n:
        return false
    let quote = 34
    let slash = 92
    if cheng_load_u8(data, idx) != quote:
        return false
    let outRaw = driver_c_new_string_export(n - idx)
    if outRaw == nil:
        return false
    var used: int32
    var pos = idx + 1
    var ch: int32
    while pos < n:
        ch = cheng_load_u8(data, pos)
        pos = pos + 1
        if ch == quote:
            outValue = cheng_str_view_owned(outRaw, used)
            return true
        if ch == slash:
            if pos >= n:
                break
            ch = cheng_load_u8(data, pos)
            pos = pos + 1
        *(UInt8Ptr(cheng_ptr_plus(outRaw, used))) = uint8(ch)
        used = used + 1
    cheng_free_export(outRaw)
    return false

fn cheng_tailnet_provider_runtime_new(): ChengTailnetProviderRuntimePtr =
    let mem = cheng_malloc_export(int32(sizeof(ChengTailnetProviderRuntime)))
    if mem == nil:
        return nil
    let runtime = ChengTailnetProviderRuntimePtr(mem)
    runtime->providerKind = nil
    runtime->controlEndpoint = nil
    runtime->relayEndpoint = nil
    runtime->controlProbeEndpoint = nil
    runtime->relayProbeEndpoint = nil
    runtime->derpRegionCode = nil
    runtime->derpHostname = nil
    runtime->startupStage = cheng_string_copy("init", 4)
    runtime->lastError = nil
    runtime->providerReady = false
    runtime->proxyReady = false
    runtime->listenerNeedsRepair = false
    runtime->derpHealthy = false
    return runtime

fn cheng_tailnet_provider_runtime_dispose(runtime: ChengTailnetProviderRuntimePtr) =
    if runtime == nil:
        return
    cheng_free_export(runtime->providerKind)
    cheng_free_export(runtime->controlEndpoint)
    cheng_free_export(runtime->relayEndpoint)
    cheng_free_export(runtime->controlProbeEndpoint)
    cheng_free_export(runtime->relayProbeEndpoint)
    cheng_free_export(runtime->derpRegionCode)
    cheng_free_export(runtime->derpHostname)
    cheng_free_export(runtime->startupStage)
    cheng_free_export(runtime->lastError)
    cheng_free_export(ptr(runtime))

@borrows
fn cheng_tailnet_provider_set_stage(runtime: ChengTailnetProviderRuntimePtr, stage: str) =
    if runtime == nil:
        return
    cheng_free_export(runtime->startupStage)
    runtime->startupStage = cheng_copy_cstring_from_str(stage)

fn cheng_tailnet_provider_set_stage_cstring(runtime: ChengTailnetProviderRuntimePtr, stage: ptr) =
    if runtime == nil:
        return
    cheng_free_export(runtime->startupStage)
    let stageLen = cheng_cstrlen_raw(stage)
    runtime->startupStage = cheng_string_copy(stage, stageLen)

fn cheng_tailnet_provider_set_error_cstring(runtime: ChengTailnetProviderRuntimePtr, text: ptr) =
    if runtime == nil:
        return
    cheng_free_export(runtime->lastError)
    let textLen = cheng_cstrlen_raw(text)
    runtime->lastError = cheng_string_copy(text, textLen)

@borrows
fn cheng_tailnet_provider_set_error(runtime: ChengTailnetProviderRuntimePtr, text: str) =
    if runtime == nil:
        return
    cheng_free_export(runtime->lastError)
    runtime->lastError = cheng_copy_cstring_from_str(text)

fn cheng_tailnet_provider_is_headscale(runtime: ChengTailnetProviderRuntimePtr): bool =
    if runtime == nil:
        return false
    return cheng_cstring_equals_cstring(runtime->providerKind, "headscale")

fn cheng_tailnet_provider_sync_control(runtime: ChengTailnetProviderRuntimePtr): bool =
    if runtime == nil:
        return false
    var payload = cheng_str_empty()
    var loadErr = cheng_str_empty()
    if cheng_cstrlen_raw(runtime->controlProbeEndpoint) > 0:
        var endpoint = cheng_str_copy_cstring(runtime->controlProbeEndpoint)
        if cheng_str_has_prefix_cstring(endpoint, "http://") ||
           cheng_str_has_prefix_cstring(endpoint, "https://"):
            payload = cheng_http_load_endpoint_payload_ex(endpoint, loadErr)
        else:
            payload = cheng_tailnet_load_endpoint_payload(endpoint)
        cheng_str_dispose(endpoint)
    else:
        payload = cheng_tailnet_load_endpoint_payload_cstring(runtime->controlEndpoint)
    if cheng_str_len(payload) <= 0:
        if cheng_str_len(loadErr) > 0:
            var errText = cheng_str_copy_cstring("tailnet provider: ")
            cheng_runtime_concat_assign(errText, loadErr)
            cheng_tailnet_provider_set_error(runtime, errText)
            cheng_str_dispose(errText)
            cheng_str_dispose(loadErr)
            return false
        cheng_tailnet_provider_set_error_cstring(runtime, "tailnet provider: control probe load failed")
        cheng_str_dispose(loadErr)
        return false
    var providerReady = false
    var proxyReady = false
    var listenerNeedsRepair = false
    var startupStage = cheng_str_empty()
    let ok = cheng_tailnet_json_read_bool(payload, "providerReady", providerReady) &&
             cheng_tailnet_json_read_bool(payload, "proxyListenersReady", proxyReady) &&
             cheng_tailnet_json_read_bool(payload, "listenerNeedsRepair", listenerNeedsRepair) &&
             cheng_tailnet_json_read_string(payload, "startupStage", startupStage)
    cheng_str_dispose(payload)
    if !ok:
        cheng_str_dispose(startupStage)
        cheng_tailnet_provider_set_error_cstring(runtime, "tailnet provider: control probe parse failed")
        return false
    runtime->providerReady = providerReady
    runtime->proxyReady = proxyReady
    runtime->listenerNeedsRepair = listenerNeedsRepair
    cheng_tailnet_provider_set_stage(runtime, startupStage)
    cheng_str_dispose(startupStage)
    cheng_str_dispose(loadErr)
    cheng_tailnet_provider_set_error_cstring(runtime, "")
    return true

fn cheng_tailnet_provider_sync_derp(runtime: ChengTailnetProviderRuntimePtr): bool =
    if runtime == nil:
        return false
    var payload = cheng_str_empty()
    var loadErr = cheng_str_empty()
    if cheng_cstrlen_raw(runtime->relayProbeEndpoint) > 0:
        var endpoint = cheng_str_copy_cstring(runtime->relayProbeEndpoint)
        if cheng_str_has_prefix_cstring(endpoint, "http://") ||
           cheng_str_has_prefix_cstring(endpoint, "https://"):
            payload = cheng_http_load_endpoint_payload_ex(endpoint, loadErr)
        else:
            payload = cheng_tailnet_load_endpoint_payload(endpoint)
        cheng_str_dispose(endpoint)
    else:
        payload = cheng_tailnet_load_endpoint_payload_cstring(runtime->relayEndpoint)
    if cheng_str_len(payload) <= 0:
        if cheng_str_len(loadErr) > 0:
            var errText = cheng_str_copy_cstring("tailnet provider: ")
            cheng_runtime_concat_assign(errText, loadErr)
            cheng_tailnet_provider_set_error(runtime, errText)
            cheng_str_dispose(errText)
            cheng_str_dispose(loadErr)
            return false
        cheng_tailnet_provider_set_error_cstring(runtime, "tailnet provider: derp probe load failed")
        cheng_str_dispose(loadErr)
        return false
    var derpHealthy = false
    var startupStage = cheng_str_empty()
    let ok = cheng_tailnet_json_read_bool(payload, "derpHealthy", derpHealthy) &&
             cheng_tailnet_json_read_string(payload, "startupStage", startupStage)
    cheng_str_dispose(payload)
    if !ok:
        cheng_str_dispose(startupStage)
        cheng_tailnet_provider_set_error_cstring(runtime, "tailnet provider: derp probe parse failed")
        return false
    runtime->derpHealthy = derpHealthy
    cheng_tailnet_provider_set_stage(runtime, startupStage)
    cheng_str_dispose(startupStage)
    cheng_str_dispose(loadErr)
    cheng_tailnet_provider_set_error_cstring(runtime, "")
    return true

