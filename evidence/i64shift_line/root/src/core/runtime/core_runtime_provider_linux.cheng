fn libc_close_export(fd: int32): int32 =
    return cheng_linux_syscall_i32(cheng_linux_syscall1(chengLinuxSysClose, int64(fd)))

@exportc("cheng_udp_bind_host_port_bridge")
@abi_internal
fn cheng_udp_bind_host_port_bridge_export(host: str, port: int32, isV6: int32, outFd: var int32, outPort: var int32, outFamily: var int32, outUseLenField: var int32): int32 =
    outFd = -1
    outPort = 0
    outFamily = 0
    outUseLenField = 0
    if isV6 != 0:
        return 97
    if port < 0 || port > 65535:
        return 22
    let fd: int32 = libc_socket_export(cheng_native_af_inet_bridge_export(),
                                       cheng_native_sock_dgram_bridge_export(),
                                       cheng_native_ipproto_ip_bridge_export())
    if fd < 0:
        return cheng_native_errno_code_bridge_export()
    var reuse: int32 = 1
    let _reuseRc: int32 = libc_setsockopt_export(fd,
                                                 cheng_native_sol_socket_bridge_export(),
                                                 cheng_native_so_reuseaddr_bridge_export(),
                                                 &reuse,
                                                 int32(sizeof(int32)))
    var addr: uint8[16]
    if !cheng_linux_sockaddr_ipv4_from_host(host, port, addr):
        let _closeBadAddr: int32 = libc_close_export(fd)
        return 22
    if libc_bind_export(fd, &addr[0], chengLinuxSockaddrInLen) != 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        let _closeBind: int32 = libc_close_export(fd)
        return err
    if port == 0:
        var addrLen: int32 = chengLinuxSockaddrInLen
        if libc_getsockname_export(fd, &addr[0], addrLen) != 0:
            let err: int32 = cheng_native_errno_code_bridge_export()
            let _closeSockName: int32 = libc_close_export(fd)
            return err
    outFd = fd
    outPort = cheng_linux_sockaddr_port(addr)
    outFamily = cheng_native_af_inet_bridge_export()
    outUseLenField = 0
    return 0

@exportc("cheng_udp_bind_fd_bridge")
@abi_internal
fn cheng_udp_bind_fd_bridge_export(host: str, port: int32, isV6: int32): int32 =
    var fd: int32
    var boundPort: int32
    var family: int32
    var useLenField: int32
    let rc: int32 = cheng_udp_bind_host_port_bridge_export(host, port, isV6, fd, boundPort, family, useLenField)
    if rc != 0:
        return 0 - rc
    return fd

@exportc("cheng_udp_bound_port_bridge")
fn cheng_udp_bound_port_bridge_export(fd: int32, isV6: int32): int32 =
    if fd < 0:
        return -9
    if isV6 != 0:
        return -97
    var addr: uint8[16]
    var addrLen: int32 = chengLinuxSockaddrInLen
    cheng_bytes_set(&addr[0], 0, chengLinuxSockaddrInLen)
    if libc_getsockname_export(fd, &addr[0], addrLen) != 0:
        return 0 - cheng_native_errno_code_bridge_export()
    return cheng_linux_sockaddr_port(addr)

@exportc("cheng_udp_recvfrom_addr_bridge")
fn cheng_udp_recvfrom_addr_bridge_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrCap: int32, outAddrLen: var int32, outErr: var int32): int32 =
    outAddrLen = 0
    outErr = 0
    if fd < 0:
        outErr = 22
        return -1
    if buf == nil:
        outErr = 22
        return -1
    if len <= 0:
        outErr = 22
        return -1
    if addr == nil:
        outErr = 22
        return -1
    if addrCap <= 0:
        outErr = 22
        return -1
    outAddrLen = addrCap
    let rc: int32 = libc_recvfrom_export(fd, buf, len, flags, addr, outAddrLen)
    if rc < 0:
        outErr = cheng_native_errno_code_bridge_export()
    return rc

@exportc("cheng_udp_recvfrom_addr_ptr_bridge")
fn cheng_udp_recvfrom_addr_ptr_bridge_export(fd: int32, buf: ptr, len: int32, flags: int32, addr: ptr, addrCap: int32, outAddrLen: ptr, outErr: ptr): int32 =
    if outAddrLen != nil:
        *(Int32Ptr(outAddrLen)) = 0
    if outErr != nil:
        *(Int32Ptr(outErr)) = 0
    if fd < 0:
        if outErr != nil:
            *(Int32Ptr(outErr)) = 22
        return -1
    if buf == nil:
        if outErr != nil:
            *(Int32Ptr(outErr)) = 22
        return -1
    if len <= 0:
        if outErr != nil:
            *(Int32Ptr(outErr)) = 22
        return -1
    if addr == nil:
        if outErr != nil:
            *(Int32Ptr(outErr)) = 22
        return -1
    if addrCap <= 0:
        if outErr != nil:
            *(Int32Ptr(outErr)) = 22
        return -1
    if outAddrLen == nil:
        if outErr != nil:
            *(Int32Ptr(outErr)) = 22
        return -1
    if outErr == nil:
        return -1
    var rawAddrLen: int32 = addrCap
    *(Int32Ptr(outAddrLen)) = rawAddrLen
    # Call recvfrom(2) directly with &rawAddrLen (a local int32) for the socklen
    # in/out pointer. Routing through libc_recvfrom_export's `addrlen: var int32`
    # parameter made the backend pass the address of the by-ref parameter slot
    # (a pointer-to-pointer) as the socklen pointer, so the kernel saw a bogus
    # socklen and recvfrom failed with EINVAL. &local is the proven lowering.
    let rc: int32 = cheng_linux_syscall_i32(cheng_linux_syscall6(chengLinuxSysRecvFrom,
                                                                int64(fd),
                                                                cheng_ptr_arg(buf),
                                                                int64(len),
                                                                int64(flags),
                                                                cheng_ptr_arg(addr),
                                                                cheng_ptr_arg(&rawAddrLen)))
    *(Int32Ptr(outAddrLen)) = rawAddrLen
    if rc < 0:
        *(Int32Ptr(outErr)) = cheng_native_errno_code_bridge_export()
    return rc

