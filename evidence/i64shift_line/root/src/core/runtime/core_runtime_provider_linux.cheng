    let blockSize: uint64 = fs.fFrsize > 0 ? uint64(fs.fFrsize) : uint64(fs.fBsize)
    if blockSize == uint64(0):
        return 0
    return cheng_u64_mul_checked(uint64(fs.fBavail), blockSize)

@exportc("cheng_native_system_os_name_value_bridge")
fn cheng_native_system_os_name_value_bridge_export(): cstring =
    # struct utsname (Linux, incl. Android bionic / OHOS musl): 6 char[65] fields:
    # sysname, nodename, release, version, machine, domainname. sysname is field 0.
    let buf: ptr = cheng_runtime_malloc(390)
    if buf == nil:
        return ""
    if libc_uname(buf) != 0:
        cheng_runtime_free(buf)
        return ""
    let out: ptr = cheng_string_copy(buf, cheng_cstrlen_raw(buf))
    cheng_runtime_free(buf)
    return cstring(out)

@exportc("cheng_native_system_os_release_value_bridge")
fn cheng_native_system_os_release_value_bridge_export(): cstring =
    # release is the 3rd utsname field: offset = sysname(65) + nodename(65) = 130.
    let buf: ptr = cheng_runtime_malloc(390)
    if buf == nil:
        return ""
    if libc_uname(buf) != 0:
        cheng_runtime_free(buf)
        return ""
    let releasePtr: ptr = cheng_ptr_plus(buf, 130)
    let out: ptr = cheng_string_copy(releasePtr, cheng_cstrlen_raw(releasePtr))
    cheng_runtime_free(buf)
    return cstring(out)

