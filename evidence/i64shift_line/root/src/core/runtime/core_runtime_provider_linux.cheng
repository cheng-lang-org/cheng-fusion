@exportc("pread")
fn cheng_linux_libc_pread(
        fd: int32,
        buf: ptr,
        count: int64,
        offset: int64): int64 =
    if fd < 0 || buf == nil || count < int64(0) || offset < int64(0):
        chengLinuxLastErrno = chengLinuxErrnoEinval
        return int64(-1)
    var nr: int64
    nr = chengLinuxSysPread64A64
    if cheng_linux_host_is_x86_64():
        # 17 collides with the aarch64→x86_64 syscall remap table, so emulate
        # a positional read on the owned descriptor and restore the offset.
