    cheng_bytes_set(out, 0, size + 1)
    return out

@exportc("driver_c_new_string_copy_n")
fn driver_c_new_string_copy_n_export(raw: ptr, n0: int32): ptr =
    var n: int32 = n0
    if n < 0:
        n = 0
    let out: ptr = driver_c_new_string_export(n)
    if out == nil:
        return nil
    if raw != nil && n > 0:
        cheng_bytes_copy(out, raw, n)
    return out

