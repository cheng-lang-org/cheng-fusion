    var events: ChengLinuxTerminalInotifyEvents
    let byteCount = libc_read_runtime(
        chengLinuxTerminalDecisionWatchInotifyFds[row],
        ptr(&events),
        4096)
    if byteCount < int64(16):
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchFailed)
        return -1
    var offset: int32
    var changed: bool
    while offset + 16 <= int32(byteCount):
        let descriptor = *(Int32Ptr(cheng_ptr_plus(ptr(&events), offset)))
        let mask = *(UInt32Ptr(cheng_ptr_plus(ptr(&events), offset + 4)))
        let nameBytes = *(UInt32Ptr(cheng_ptr_plus(ptr(&events), offset + 12)))
        if descriptor !=
               chengLinuxTerminalDecisionWatchDescriptors[row] ||
           (mask & (chengLinuxInDeleteSelf | chengLinuxInMoveSelf |
                    chengLinuxInUnmount | chengLinuxInQOverflow |
                    chengLinuxInIgnored)) != uint32(0) ||
           offset + 16 + int32(nameBytes) > int32(byteCount):
            cheng_linux_atomic_store_i32(
                ptr(&chengLinuxTerminalDecisionWatchStates[row]),
                chengLinuxTerminalDecisionWatchFailed)
            return -1
        if (mask & (chengLinuxInModify | chengLinuxInAttrib |
                    chengLinuxInCloseWrite)) != uint32(0):
            changed = true
        offset = offset + 16 + int32(nameBytes)
    if offset != int32(byteCount) || !changed:
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchFailed)
        return -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        chengLinuxTerminalDecisionWatchIssued)
    return 2

@exportc("cheng_native_terminal_event_close_bridge")
@abi_internal
fn cheng_native_terminal_event_close_bridge_export(
        watchOwner: int32): int32 =
    let row = watchOwner - 1
    if row < 0 || row >= chengLinuxTerminalDecisionWatchRowCount:
        return 0
