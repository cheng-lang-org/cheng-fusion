       finishedDevice == uint64(0) ||
       finishedInode == uint64(0) ||
       decisionDevice == uint64(0) ||
       decisionInode == uint64(0) ||
       heldExecutableDevice == uint64(0) ||
       heldExecutableInode == uint64(0) ||
       (finishedDevice == decisionDevice &&
        finishedInode == decisionInode) ||
       (finishedDevice == heldExecutableDevice &&
        finishedInode == heldExecutableInode) ||
       (decisionDevice == heldExecutableDevice &&
        decisionInode == heldExecutableInode):
