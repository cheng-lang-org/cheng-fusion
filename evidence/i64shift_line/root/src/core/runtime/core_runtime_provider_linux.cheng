@exportc("cheng_udp_ipv4_sockaddr_sanity_bridge")
fn cheng_udp_ipv4_sockaddr_sanity_bridge_export(): int32 =
    var addr: uint8[16]
    if !cheng_linux_sockaddr_ipv4_from_host("127.0.0.1", 6210, addr):
        return 1
    if int32(addr[0]) != 2:
        return 10 + int32(addr[0])
    if int32(addr[1]) != 0:
        return 20 + int32(addr[1])
    if int32(addr[2]) != ((6210 >> 8) & 255):
        return 30 + int32(addr[2])
    if int32(addr[3]) != (6210 & 255):
        return 40 + int32(addr[3])
    if int32(addr[4]) != 127:
        return 50 + int32(addr[4])
    if int32(addr[5]) != 0:
        return 60 + int32(addr[5])
    if int32(addr[6]) != 0:
        return 70 + int32(addr[6])
    if int32(addr[7]) != 1:
        return 80 + int32(addr[7])
    return 0

