            cheng_linux_terminal_close_syscall_number(),
            int64(finishedRuleFd))
        let _closeRulesetIdentity = cheng_linux_syscall1(
            cheng_linux_terminal_close_syscall_number(), int64(rulesetFd))
        return -1
    var pathRule: ChengLinuxLandlockPathBeneathAttr
