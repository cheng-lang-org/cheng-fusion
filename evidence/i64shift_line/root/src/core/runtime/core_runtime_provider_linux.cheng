    var v: int32 = value
    while v > 0 && n < 3:
        let q: int32 = v / 10
        let digit: int32 = v - q * 10
        digits[n] = uint8(digit + int32('0'))
        v = q
        n = n + 1
    if v != 0 || n <= 0 || offset0 + n >= cap:
        return -1
    var offset: int32 = offset0
    for i in 0..<n:
        cheng_bytes_set(cheng_ptr_plus(out, offset), int32(digits[n - 1 - i]), 1)
        offset = offset + 1
    return offset

fn cheng_linux_parse_ipv4_octet(src: ptr, index: var int32, outValue: var int32): bool =
    var value: int32
    var digits: int32
    while true:
        let b: uint8 = *(UInt8Ptr(cheng_ptr_plus(src, index)))
        if b < uint8('0') || b > uint8('9'):
            break
        value = value * 10 + int32(b) - int32('0')
        if value > 255:
            return false
        digits = digits + 1
        index = index + 1
    if digits <= 0:
        return false
    outValue = value
    return true

fn cheng_linux_str_is_localhost(text: str): bool =
    if text.data == nil:
        return false
    if text.len != 9:
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 0))) != uint8('l'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 1))) != uint8('o'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 2))) != uint8('c'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 3))) != uint8('a'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 4))) != uint8('l'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 5))) != uint8('h'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 6))) != uint8('o'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 7))) != uint8('s'):
        return false
    if *(UInt8Ptr(cheng_ptr_plus(text.data, 8))) != uint8('t'):
        return false
    return true

fn cheng_linux_parse_ipv4_str(text: str, outAddr: var uint8[4]): bool =
    if text.data == nil:
        return false
    if text.len <= 0:
        return false
    for clearIndex in 0..<4:
        outAddr[clearIndex] = uint8(0)
    var partIndex: int32
    var value: int32
    var sawDigit = false
    for i in 0..<text.len:
        let b: uint8 = *(UInt8Ptr(cheng_ptr_plus(text.data, i)))
        if b >= uint8('0') && b <= uint8('9'):
            sawDigit = true
            value = value * 10 + int32(b) - int32('0')
            if value > 255:
                return false
        elif b == uint8('.'):
            if !sawDigit:
                return false
            if partIndex >= 3:
                return false
            outAddr[partIndex] = uint8(value)
            partIndex = partIndex + 1
            value = 0
            sawDigit = false
        else:
            return false
    if !sawDigit:
        return false
    if partIndex != 3:
        return false
    outAddr[partIndex] = uint8(value)
    return true

fn cheng_linux_sockaddr_ipv4_write(addr: var uint8[16], port: int32, inaddr: int32): bool =
    if port < 0 || port > 65535:
        return false
    for clearIndex in 0..<16:
        addr[clearIndex] = uint8(0)
    addr[0] = uint8(cheng_native_af_inet_bridge_export() & 255)
    addr[1] = uint8((cheng_native_af_inet_bridge_export() >> 8) & 255)
    addr[2] = uint8((port >> 8) & 255)
    addr[3] = uint8(port & 255)
    addr[4] = uint8((inaddr >> 24) & 255)
    addr[5] = uint8((inaddr >> 16) & 255)
    addr[6] = uint8((inaddr >> 8) & 255)
    addr[7] = uint8(inaddr & 255)
    return true

fn cheng_linux_sockaddr_ipv4_from_host(hostText: str, port: int32, addr: var uint8[16]): bool =
    if hostText.len <= 0:
        return cheng_linux_sockaddr_ipv4_write(addr, port, 0)
    if cheng_linux_str_is_localhost(hostText):
        return cheng_linux_sockaddr_ipv4_write(addr, port, chengLinuxInaddrLoopback)
    var octets: uint8[4]
    if !cheng_linux_parse_ipv4_str(hostText, octets):
        return false
    let inaddr: int32 = (int32(octets[0]) << 24) |
                        (int32(octets[1]) << 16) |
                        (int32(octets[2]) << 8) |
                        int32(octets[3])
    return cheng_linux_sockaddr_ipv4_write(addr, port, inaddr)

fn cheng_linux_sockaddr_port(addr: var uint8[16]): int32 =
    return (int32(addr[2]) << 8) | int32(addr[3])

fn cheng_linux_env_name_matches(entry: ptr, name: ptr, nameLen: int32): bool =
    var i: int32
    while i < nameLen:
        let eb: uint8 = *(UInt8Ptr(cheng_ptr_plus(entry, i)))
        let nb: uint8 = *(UInt8Ptr(cheng_ptr_plus(name, i)))
        if eb == uint8(0) || eb == uint8('=') || eb != nb:
            return false
        i = i + 1
    return *(UInt8Ptr(cheng_ptr_plus(entry, nameLen))) == uint8('=')

fn cheng_linux_process_rss_bytes(pid: int64): int64 =
    if pid <= 0:
        return 0
    var path: uint8[64]
    if !cheng_linux_build_proc_statm_path(pid, &path[0], 64):
        return 0
    let fd: int32 = libc_open_runtime(&path[0], chengLinuxORdonly)
    if fd < 0:
        return 0
    var buf: uint8[128]
    let got: int64 = libc_read_runtime(fd, &buf[0], 127)
    let _ = libc_close(fd)
    if got <= 0 || got > int64(127):
        return 0
    buf[int32(got)] = uint8(0)
    let pages: uint64 = cheng_linux_parse_statm_rss_pages(&buf[0], int32(got))
    if pages == uint64(0):
        return 0
    let pageSize: int64 = libc_sysconf(chengLinuxScPagesize)
    if pageSize <= 0:
        return 0
    return cheng_u64_mul_checked(pages, uint64(pageSize))

fn cheng_linux_getpid_value(): int64 =
    return cheng_linux_syscall0(chengLinuxSysGetpid)

@exportc("core_runtime_provider_trace")
fn core_runtime_provider_trace_export(): int32 =
    let pid: int64 = cheng_linux_getpid_value()
    if pid <= int64(0):
        return 0
    let wrote: int64 = libc_write_export(2, " core runtime getpid\n", 21)
    if wrote <= int64(0):
        return 0
    return int32(wrote)

# POSIX realpath via kernel resolution: open the path with O_PATH (the kernel
# canonicalizes every component, following symlinks), then read the canonical
# target back from /proc/self/fd/<fd>. Callers (std/fs.realpath) pass a
# 4096-byte resolved buffer; its upper half briefly holds the /proc path —
# the kernel copies the pathname before writing the result, so no overlap.
@exportc("realpath")
fn cheng_linux_realpath_export(path: ptr, resolved: ptr): ptr =
    if path == nil || resolved == nil:
        return nil
    let fd: int32 = cheng_linux_syscall_i32(cheng_linux_syscall4(chengLinuxSysOpenAt,
                                                                 chengLinuxAtFdcwd,
                                                                 cheng_ptr_arg(path),
                                                                 chengLinuxOPathFlag,
                                                                 0))
    if fd < 0:
        return nil
    let procPath: ptr = cheng_ptr_plus(resolved, 2048)
    let prefix: ptr = "/proc/self/fd/"
    var pi: int32
    while pi < 14:
        *(UInt8Ptr(cheng_ptr_plus(procPath, pi))) = *(UInt8Ptr(cheng_ptr_plus(prefix, pi)))
        pi = pi + 1
    var digits: int32
    var probe: int32 = fd
    while probe > 0:
        digits = digits + 1
        probe = probe / 10
    if digits == 0:
        digits = 1
    var di: int32 = digits
    var value: int32 = fd
    while di > 0:
        di = di - 1
        *(UInt8Ptr(cheng_ptr_plus(procPath, 14 + di))) = uint8(48 + value % 10)
        value = value / 10
    *(UInt8Ptr(cheng_ptr_plus(procPath, 14 + digits))) = uint8(0)
    let n: int64 = cheng_linux_syscall_i64(cheng_linux_syscall4(chengLinuxSysReadlinkat,
                                                                chengLinuxAtFdcwd,
                                                                cheng_ptr_arg(procPath),
                                                                cheng_ptr_arg(resolved),
                                                                2047))
    let _closeFd = cheng_linux_syscall_i32(cheng_linux_syscall1(chengLinuxSysClose, int64(fd)))
    if n <= int64(0) || n >= int64(2047):
        return nil
    *(UInt8Ptr(cheng_ptr_plus(resolved, int32(n)))) = uint8(0)
    return resolved

# Darwin-only libproc API. The Linux ELF closure still references the symbol
# because os.processResourceGuardCurrentRssBytes selects its Darwin branch at
# runtime; that branch is unreachable while procfs is present. Resolve the
# symbol with an unconditional loud failure so no caller can mistake it for a
# working phys_footprint source; callers already treat nonzero as failure.
@exportc("proc_pid_rusage")
fn cheng_linux_proc_pid_rusage_export(pid: int32, flavor: int32, info: ptr): int32 =
    let _wrote: int64 = libc_write_export(2, " proc_pid_rusage darwin-only bridge invoked on linux\n", 53)
    return 1

@exportc("cheng_native_errno_code_bridge")
fn cheng_native_errno_code_bridge_export(): int32 =
    # Prefer the raw-host-syscall errno cell (every failed host syscall
    # stores its errno there), then libc's errno (system-linked musl paths),
    # then the provider's own last-syscall tracker.
    let cell = cheng_linux_errno_cell_runtime()
    if cell != nil:
        let cellErrno = *(Int32Ptr(cell))
        if cellErrno != 0:
            return cellErrno
    let ep = cheng_linux_errno_location_runtime()
    if ep != nil:
        let libcErrno = *(Int32Ptr(ep))
        if libcErrno != 0:
            return libcErrno
    return chengLinuxLastErrno

# Linux releases the descriptor number before reporting deferred close
# errors. Return a close-once receipt so no terminal owner can retry a
# possibly-reused numeric fd: 1=consumed clean, 2=consumed with error,
# 0=EBADF/not consumed.
@exportc("cheng_native_terminal_fd_close_once_bridge")
@abi_internal
fn cheng_native_terminal_fd_close_once_bridge_export(fd: int32): int32 =
    if fd < 0:
        return 1
    let rc = cheng_linux_syscall1(
        cheng_linux_terminal_close_syscall_number(), int64(fd))
    if rc == int64(0):
        return 1
    if rc == int64(-9):
        return 0
    if cheng_linux_syscall_failed(rc):
        chengLinuxLastErrno = int32(0 - rc)
        return 2
    return 2

@exportc("cheng_errno")
fn cheng_errno_export(): int32 =
    return cheng_native_errno_code_bridge_export()

@exportc("cheng_strerror")
fn cheng_strerror_export(err: int32): ptr =
    if err == 2:
        return "No such file or directory"
    if err == 4:
        return "Interrupted system call"
    if err == 5:
        return "Input/output error"
    if err == 9:
        return "Bad file descriptor"
    if err == 11:
        return "Resource temporarily unavailable"
    if err == 13:
        return "Permission denied"
    if err == 22:
        return "Invalid argument"
    if err == 98:
        return "Address already in use"
    if err == 101:
        return "Network is unreachable"
    if err == 106:
        return "Transport endpoint is already connected"
    if err == 110:
        return "Connection timed out"
    if err == 111:
        return "Connection refused"
    if err == 113:
        return "No route to host"
    if err == 114:
        return "Operation already in progress"
    if err == 115:
        return "Operation now in progress"
    if err == 97:
        return "Address family not supported by protocol"
    return "Linux syscall error"

@exportc("driver_c_new_string")
fn driver_c_new_string_export(size0: int32): ptr =
    var size: int32 = size0
