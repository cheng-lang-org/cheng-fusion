@exportc("libc_inet_pton")
fn libc_inet_pton_export(family: int32, src: ptr, dst: ptr): int32 =
    if family != 2:
        return -1
    if src == nil || dst == nil:
        return -1
    var index: int32
    var values: int32[4]
    for part in 0..<4:
        var value: int32
        if !cheng_linux_parse_ipv4_octet(src, index, value):
            return 0
        values[part] = value
        let next: uint8 = *(UInt8Ptr(cheng_ptr_plus(src, index)))
        if part < 3:
            if next != uint8('.'):
                return 0
            index = index + 1
        else:
            if next != uint8(0):
                return 0
    for i in 0..<4:
        cheng_bytes_set(cheng_ptr_plus(dst, i), values[i], 1)
    return 1

@exportc("libc_inet_ntop")
fn libc_inet_ntop_export(family: int32, src: ptr, dst: ptr, size: int32): ptr =
    if family != 2:
        return nil
    if src == nil || dst == nil || size < 16:
        return nil
    var offset: int32
    for i in 0..<4:
        if i > 0:
            cheng_bytes_set(cheng_ptr_plus(dst, offset), int32('.'), 1)
            offset = offset + 1
        let value: int32 = int32(*(UInt8Ptr(cheng_ptr_plus(src, i))))
        offset = cheng_linux_write_u8_decimal(value, dst, offset, size)
        if offset < 0:
            return nil
    if offset >= size:
        return nil
    cheng_bytes_set(cheng_ptr_plus(dst, offset), 0, 1)
    return dst

