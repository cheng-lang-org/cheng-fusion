        cheng_linux_terminal_close_syscall_number(), int64(finishedRuleFd))
    let closeRc = cheng_linux_syscall1(
        cheng_linux_terminal_close_syscall_number(), int64(rulesetFd))
    if cheng_linux_syscall_failed(restrictRc) ||
       cheng_linux_syscall_failed(closePathRc) ||
