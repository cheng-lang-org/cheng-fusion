        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        (epollClosed && inotifyClosed && processClosed && decisionClosed) ?
            chengLinuxTerminalDecisionWatchConsumed :
            chengLinuxTerminalDecisionWatchFailed)
    return epollClosed && inotifyClosed && processClosed && decisionClosed ?
        1 : 0

# Install the child write-deny sandbox before retained-fd exec.  The exact
# FINISHED upload inode is the sole path-beneath write grant.  DECISION and
# held-executable descriptors are checked read-only and remain outside the
# handled write set.  ABI < 3 cannot enforce TRUNCATE and is a hard failure.
@exportc("cheng_native_terminal_linux_write_deny_sandbox_install_bridge")
@abi_internal
fn cheng_native_terminal_linux_write_deny_sandbox_install_bridge_export(
        finishedWriterFd: int32,
        decisionReaderFd: int32,
        heldExecutableFd: int32): int32 =
    if finishedWriterFd < 0 || decisionReaderFd < 0 ||
       heldExecutableFd < 0 ||
       finishedWriterFd == decisionReaderFd ||
       finishedWriterFd == heldExecutableFd ||
       decisionReaderFd == heldExecutableFd:
        return -1
    let finishedFlags = cheng_linux_syscall3(
        cheng_linux_terminal_fcntl_syscall_number(),
        int64(finishedWriterFd),
        chengLinuxFGetFl,
        int64(0))
    let decisionFlags = cheng_linux_syscall3(
        cheng_linux_terminal_fcntl_syscall_number(),
        int64(decisionReaderFd),
        chengLinuxFGetFl,
        int64(0))
    let heldExecutableFlags = cheng_linux_syscall3(
        cheng_linux_terminal_fcntl_syscall_number(),
        int64(heldExecutableFd),
        chengLinuxFGetFl,
        int64(0))
    if cheng_linux_syscall_failed(finishedFlags) ||
       cheng_linux_syscall_failed(decisionFlags) ||
       cheng_linux_syscall_failed(heldExecutableFlags) ||
       (finishedFlags & chengLinuxAccessModeMask) !=
           chengLinuxOWriteOnly ||
       (decisionFlags & chengLinuxAccessModeMask) !=
           chengLinuxOReadOnly ||
       (heldExecutableFlags & chengLinuxAccessModeMask) !=
           chengLinuxOReadOnly:
        return -1
    var finishedSize: int64
    var finishedMode: int32
    var finishedDevice: uint64
    var finishedInode: uint64
    var decisionSize: int64
    var decisionMode: int32
    var decisionDevice: uint64
    var decisionInode: uint64
    var heldExecutableSize: int64
    var heldExecutableMode: int32
    var heldExecutableDevice: uint64
    var heldExecutableInode: uint64
    if libc_fstat_scalars_runtime(
           finishedWriterFd,
           ptr(&finishedSize),
           ptr(&finishedMode),
           ptr(&finishedDevice),
           ptr(&finishedInode)) != 0 ||
       libc_fstat_scalars_runtime(
           decisionReaderFd,
           ptr(&decisionSize),
           ptr(&decisionMode),
           ptr(&decisionDevice),
           ptr(&decisionInode)) != 0 ||
       libc_fstat_scalars_runtime(
           heldExecutableFd,
           ptr(&heldExecutableSize),
           ptr(&heldExecutableMode),
           ptr(&heldExecutableDevice),
           ptr(&heldExecutableInode)) != 0 ||
