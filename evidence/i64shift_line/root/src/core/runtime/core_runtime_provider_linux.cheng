# --- QUIC transport 递归锁(linux exe 桥; dual-role serve+client 并发互斥) ---
# 语义与 darwin provider(os_unfair_lock 版)一致: CAS guard + owner(gettid)/
# depth 递归计数; 竞争失败 → sched_yield 退避(等待绝不出现在 guard 内)。
var
    chengLinuxQuicTransportLockWord: int32
    chengLinuxQuicTransportOwner: int64
    chengLinuxQuicTransportDepth: int32

@exportc("cheng_native_quic_transport_lock_bridge")
@abi_internal
fn cheng_native_quic_transport_lock_bridge_export() =
    let selfTag: int64 = cheng_linux_syscall0(chengLinuxSysGettid)
    while true:
        if cheng_linux_atomic_cas_i32(&chengLinuxQuicTransportLockWord, 0, 1) != 0:
            if chengLinuxQuicTransportOwner == selfTag:
                chengLinuxQuicTransportDepth = chengLinuxQuicTransportDepth + 1
                cheng_linux_atomic_store_i32(&chengLinuxQuicTransportLockWord, 0)
                return
            if chengLinuxQuicTransportOwner == 0:
                chengLinuxQuicTransportOwner = selfTag
                chengLinuxQuicTransportDepth = 1
                cheng_linux_atomic_store_i32(&chengLinuxQuicTransportLockWord, 0)
                return
            cheng_linux_atomic_store_i32(&chengLinuxQuicTransportLockWord, 0)
        let _ = cheng_linux_syscall0(chengLinuxSysSchedYield)

@exportc("cheng_native_quic_transport_unlock_bridge")
@abi_internal
fn cheng_native_quic_transport_unlock_bridge_export() =
    let selfTag: int64 = cheng_linux_syscall0(chengLinuxSysGettid)
    while true:
        if cheng_linux_atomic_cas_i32(&chengLinuxQuicTransportLockWord, 0, 1) != 0:
            break
        let _ = cheng_linux_syscall0(chengLinuxSysSchedYield)
    if chengLinuxQuicTransportOwner == selfTag:
        chengLinuxQuicTransportDepth = chengLinuxQuicTransportDepth - 1
        if chengLinuxQuicTransportDepth <= 0:
            chengLinuxQuicTransportOwner = 0
            chengLinuxQuicTransportDepth = 0
    cheng_linux_atomic_store_i32(&chengLinuxQuicTransportLockWord, 0)
