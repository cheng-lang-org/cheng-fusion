    if index < 0 || index >= 8:
        return -2
    var addr: uint8[16]
    if !cheng_linux_sockaddr_ipv4_from_host("127.0.0.1", 6210, addr):
        return -1
    return int32(addr[index])

@exportc("cheng_tcp_listen_host_port_bridge")
@abi_internal
fn cheng_tcp_listen_host_port_bridge_export(host: cstring, port: int32, isV6: int32): int32 =
    if isV6 != 0:
        return -97
    if port < 0 || port > 65535:
        return -22
    let fd: int32 = libc_socket_export(cheng_native_af_inet_bridge_export(),
                                       cheng_native_sock_stream_bridge_export(),
                                       cheng_native_ipproto_ip_bridge_export())
    if fd < 0:
        return 0 - cheng_native_errno_code_bridge_export()
    var reuse: int32 = 1
    let _reuseRc: int32 = libc_setsockopt_export(fd,
                                                 cheng_native_sol_socket_bridge_export(),
                                                 cheng_native_so_reuseaddr_bridge_export(),
                                                 &reuse,
                                                 int32(sizeof(int32)))
    var addr: uint8[16]
    if !cheng_linux_sockaddr_ipv4_from_host(host, port, addr):
        let _closeBadAddr: int32 = libc_close_export(fd)
        return -22
    if libc_bind_export(fd, &addr[0], chengLinuxSockaddrInLen) != 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        let _closeBind: int32 = libc_close_export(fd)
        return 0 - err
    if libc_listen_export(fd, 64) != 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        let _closeListen: int32 = libc_close_export(fd)
        return 0 - err
    return fd

