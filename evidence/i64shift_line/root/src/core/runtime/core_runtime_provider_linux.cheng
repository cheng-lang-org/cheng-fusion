        ptr(&chengLinuxRuntimeEventCurrentWaiters))
    *(Int32Ptr(cheng_ptr_plus(out, 12))) = cheng_linux_atomic_load_i32(
        ptr(&chengLinuxRuntimeEventWakeCallTotal))
    *(Int32Ptr(cheng_ptr_plus(out, 16))) = cheng_linux_atomic_load_i32(
        ptr(&chengLinuxRuntimeEventWakeSuccessTotal))
    *(Int32Ptr(cheng_ptr_plus(out, 20))) = cheng_linux_atomic_load_i32(
        ptr(&chengLinuxRuntimeEventAcquireTotal))
    *(Int32Ptr(cheng_ptr_plus(out, 24))) = cheng_linux_atomic_load_i32(
        ptr(&chengLinuxRuntimeEventUnlockTotal))
