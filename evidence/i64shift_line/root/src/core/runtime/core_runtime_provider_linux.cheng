fn cheng_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

fn cheng_ptr_arg(value: ptr): int64 =
    return int64(uint64(value))

fn cheng_linux_syscall_failed(rc: int64): bool =
    return rc < 0 && rc >= -4095

fn cheng_linux_syscall_i32(rc: int64): int32 =
    if cheng_linux_syscall_failed(rc):
        chengLinuxLastErrno = int32(0 - rc)
        return -1
    return int32(rc)

fn cheng_linux_syscall_i64(rc: int64): int64 =
    if cheng_linux_syscall_failed(rc):
        chengLinuxLastErrno = int32(0 - rc)
        return -1
    return rc

fn cheng_linux_write_all_immediate(
        fd: int32,
        raw: ptr,
        byteLength: int32) =
    if raw == nil || byteLength <= 0:
        return
    var written: int32
    while written < byteLength:
        let rc = cheng_linux_syscall3(
            chengLinuxSysWrite,
            int64(fd),
            cheng_ptr_arg(cheng_ptr_plus(raw, written)),
            int64(byteLength - written))
        if rc == -4:
            continue
        if rc <= 0 || rc > int64(2147483647):
            return
        written = written + int32(rc)

fn cheng_linux_current_tid_or_fail(): int32 =
    let tid = cheng_linux_syscall0(chengLinuxSysGettid)
    if cheng_linux_syscall_failed(tid) || tid <= 0 ||
       tid > int64(2147483647):
        cheng_linux_write_all_immediate(
            2, "cheng runtime event lock gettid failed", 38)
        cheng_linux_write_all_immediate(2, "\n", 1)
        let ignoredGroup = cheng_linux_syscall1(
            chengLinuxSysExitGroup, int64(70))
        ignoredGroup
        let ignoredThread = cheng_linux_syscall1(
            chengLinuxSysExit, int64(70))
        ignoredThread
        while true:
            let ignored = cheng_linux_syscall1(
                chengLinuxSysExit, int64(70))
            ignored
    return int32(tid)

@exportc("cheng_native_fail_stop_bridge")
@abi_internal
fn cheng_native_fail_stop_bridge_export(
        text: ptr,
        byteLength: int32,
        exitCode: int32) =
    var safeText: ptr = text
    var safeLength = byteLength
    if safeText == nil:
        safeText = "cheng native fail-stop"
        safeLength = 22
    elif safeLength < 0:
        safeLength = 0
    let safeCode = exitCode == 0 ? 70 : exitCode
    cheng_linux_write_all_immediate(2, safeText, safeLength)
    cheng_linux_write_all_immediate(2, "\n", 1)
    let ignoredGroup = cheng_linux_syscall1(
        chengLinuxSysExitGroup, int64(safeCode))
    ignoredGroup
    let ignoredThread = cheng_linux_syscall1(
        chengLinuxSysExit, int64(safeCode))
    ignoredThread
    while true:
        let ignored = cheng_linux_syscall1(
            chengLinuxSysExit, int64(safeCode))
        ignored

fn cheng_linux_runtime_event_counter_increment_checked(
        address: ptr): int32 =
    if address == nil:
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event counter overflow", 36, 70)
    while true:
        let current = cheng_linux_atomic_load_i32(address)
        if current < 0 || current == chengLinuxInt32Max:
            cheng_native_fail_stop_bridge_export(
                "cheng runtime event counter overflow", 36, 70)
        let desired = current + 1
        if cheng_linux_atomic_cas_i32(address, current, desired) != 0:
            return desired

fn cheng_linux_runtime_event_counter_decrement_checked(
        address: ptr): int32 =
    if address == nil:
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event counter underflow", 37, 70)
    while true:
        let current = cheng_linux_atomic_load_i32(address)
        if current <= 0:
            cheng_native_fail_stop_bridge_export(
                "cheng runtime event counter underflow", 37, 70)
        let desired = current - 1
        if cheng_linux_atomic_cas_i32(address, current, desired) != 0:
            return desired

fn cheng_linux_runtime_event_futex_wake_tracked(
        wakeRc: int64) =
    let _ = cheng_linux_runtime_event_counter_increment_checked(
        ptr(&chengLinuxRuntimeEventWakeCallTotal))
    if wakeRc > 0:
        let _ = cheng_linux_runtime_event_counter_increment_checked(
            ptr(&chengLinuxRuntimeEventWakeSuccessTotal))

fn cheng_linux_runtime_event_futex_wake_raw(
        futexAddress: ptr,
        wakeCount: int32) =
    if futexAddress == nil || wakeCount <= 0:
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event waiter futex wake failed", 44, 70)
    let wakeRc = cheng_linux_syscall6(
        chengLinuxSysFutex,
        cheng_ptr_arg(futexAddress),
        chengLinuxFutexWakePrivate,
        int64(wakeCount),
        0,
        0,
        0)
    if wakeRc < 0:
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event waiter futex wake failed", 44, 70)

fn cheng_linux_runtime_event_waiter_register_once() =
    let _ = cheng_linux_runtime_event_counter_increment_checked(
        ptr(&chengLinuxRuntimeEventRegisteredTotal))
    let _ = cheng_linux_runtime_event_counter_increment_checked(
        ptr(&chengLinuxRuntimeEventCurrentWaiters))
    let _ = cheng_linux_runtime_event_counter_increment_checked(
        ptr(&chengLinuxRuntimeEventWaiterEpochWord))
    cheng_linux_runtime_event_futex_wake_raw(
        ptr(&chengLinuxRuntimeEventWaiterEpochWord), 1)

fn cheng_linux_runtime_event_waiter_unregister_once() =
    let _ = cheng_linux_runtime_event_counter_decrement_checked(
        ptr(&chengLinuxRuntimeEventCurrentWaiters))

@exportc("cheng_native_runtime_event_lock_bridge")
@abi_internal
fn cheng_native_runtime_event_lock_bridge_export() =
    let lockAddress = ptr(&chengLinuxRuntimeEventLockWord)
    let ownerAddress = ptr(&chengLinuxRuntimeEventOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    if cheng_linux_atomic_load_i32(lockAddress) != 0 &&
       cheng_linux_atomic_load_i32(ownerAddress) == tid:
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event lock recursive acquire", 42, 70)
    if cheng_linux_atomic_cas_i32(lockAddress, 0, 1) != 0:
        cheng_linux_atomic_store_i32(ownerAddress, tid)
        let _ = cheng_linux_runtime_event_counter_increment_checked(
            ptr(&chengLinuxRuntimeEventAcquireTotal))
        return
    var waiterRegistered: bool
    while true:
        if cheng_linux_atomic_load_i32(ownerAddress) == tid:
            cheng_native_fail_stop_bridge_export(
                "cheng runtime event lock recursive acquire", 42, 70)
        let current = cheng_linux_atomic_load_i32(lockAddress)
        if current == 0:
            if cheng_linux_atomic_cas_i32(lockAddress, 0, 2) != 0:
                if waiterRegistered:
                    cheng_linux_runtime_event_waiter_unregister_once()
                    waiterRegistered = false
                cheng_linux_atomic_store_i32(ownerAddress, tid)
                let _ = cheng_linux_runtime_event_counter_increment_checked(
                    ptr(&chengLinuxRuntimeEventAcquireTotal))
                return
            continue
        if current == 1:
            let promoted = cheng_linux_atomic_cas_i32(
                lockAddress, 1, 2)
            promoted
        elif current != 2:
            cheng_native_fail_stop_bridge_export(
                "cheng runtime event lock state corrupt", 38, 70)
        if !waiterRegistered:
            cheng_linux_runtime_event_waiter_register_once()
            waiterRegistered = true
        let waitRc = cheng_linux_syscall6(
            chengLinuxSysFutex,
            cheng_ptr_arg(lockAddress),
            chengLinuxFutexWaitPrivate,
            2,
            0,
            0,
            0)
        if waitRc < 0 && waitRc != -4 && waitRc != -11:
            cheng_native_fail_stop_bridge_export(
                "cheng runtime event lock futex wait failed", 42, 70)

@exportc("cheng_linux_runtime_event_waiter_barrier_bridge")
@abi_internal
fn cheng_linux_runtime_event_waiter_barrier_bridge_export(
        expectedWaiters: int32): int32 =
    if expectedWaiters <= 0:
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event waiter barrier expected invalid", 51, 70)
    let lockAddress = ptr(&chengLinuxRuntimeEventLockWord)
    let ownerAddress = ptr(&chengLinuxRuntimeEventOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    let lockState = cheng_linux_atomic_load_i32(lockAddress)
    if (lockState != 1 && lockState != 2) ||
       tid != cheng_linux_atomic_load_i32(ownerAddress):
        cheng_native_fail_stop_bridge_export(
            "cheng runtime event waiter barrier owner required", 49, 70)
    let epochAddress = ptr(&chengLinuxRuntimeEventWaiterEpochWord)
    let currentAddress = ptr(&chengLinuxRuntimeEventCurrentWaiters)
    let registeredAddress = ptr(&chengLinuxRuntimeEventRegisteredTotal)
    while true:
        let observedEpoch = cheng_linux_atomic_load_i32(epochAddress)
        let currentWaiters = cheng_linux_atomic_load_i32(currentAddress)
        let registeredTotal = cheng_linux_atomic_load_i32(registeredAddress)
        if currentWaiters >= expectedWaiters &&
           registeredTotal >= expectedWaiters:
            return 0
        let waitRc = cheng_linux_syscall6(
            chengLinuxSysFutex,
            cheng_ptr_arg(epochAddress),
            chengLinuxFutexWaitPrivate,
            int64(observedEpoch),
            0,
