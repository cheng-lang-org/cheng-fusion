    var finishedRuleSize: int64
    var finishedRuleMode: int32
    var finishedRuleDevice: uint64
    var finishedRuleInode: uint64
    if libc_fstat_scalars_runtime(
           finishedRuleFd,
           ptr(&finishedRuleSize),
           ptr(&finishedRuleMode),
           ptr(&finishedRuleDevice),
           ptr(&finishedRuleInode)) != 0 ||
       (finishedRuleMode & chengLinuxFileTypeMask) !=
           chengLinuxRegularType ||
       finishedRuleSize != finishedSize ||
       finishedRuleDevice != finishedDevice ||
       finishedRuleInode != finishedInode:
