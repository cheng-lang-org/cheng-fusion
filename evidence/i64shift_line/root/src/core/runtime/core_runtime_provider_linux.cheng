            cheng_linux_syscall3(
                chengLinuxSysLseekX64,
                int64(fd),
                int64(0),
                chengLinuxSeekCur))
        if cur < int64(0):
            return int64(-1)
        let jumped = cheng_linux_syscall_i64(
            cheng_linux_syscall3(
                chengLinuxSysLseekX64,
                int64(fd),
                offset,
                chengLinuxSeekSet))
        if jumped < int64(0):
            return int64(-1)
        let got = cheng_linux_syscall_i64(
            cheng_linux_syscall3(
                chengLinuxSysRead,
                int64(fd),
                cheng_ptr_arg(buf),
                count))
        let _restore = cheng_linux_syscall3(
            chengLinuxSysLseekX64,
            int64(fd),
            cur,
            chengLinuxSeekSet)
        return got
    return cheng_linux_syscall_i64(
        cheng_linux_syscall4(nr, int64(fd), cheng_ptr_arg(buf), count, offset))

