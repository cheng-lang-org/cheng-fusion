@exportc("cheng_fd_set_nonblocking_bridge")
fn cheng_fd_set_nonblocking_bridge_export(fd: int32, enabled: int32): int32 =
    if fd < 0:
        return -1
    let flags: int32 = libc_fcntl_export(fd, 3, 0)
    if flags < 0:
        return -1
    let nonblockFlag: int32 = 2048
    let nonblockClearMask: int32 = -1 - nonblockFlag
    var nextFlags: int32 = flags
    if enabled != 0:
        nextFlags = flags | nonblockFlag
    else:
        nextFlags = flags & nonblockClearMask
    return libc_fcntl_export(fd, 4, nextFlags)

@exportc("cheng_tcp_set_nodelay_bridge")
fn cheng_tcp_set_nodelay_bridge_export(fd: int32, enabled: int32): int32 =
    # IPPROTO_TCP=6, TCP_NODELAY=1 (Linux/Android)
    if fd < 0:
        return -1
    var flag: int32
    if enabled != 0:
        flag = 1
    return libc_setsockopt_export(fd, 6, 1, &flag, 4)

# Kernel struct pollfd is { int fd; short events; short revents; } packed to
# 8 bytes with revents at byte offset 6. Cheng aligns int16 fields wider, so a
# Cheng struct cannot mirror this ABI; build the kernel layout in a raw byte
# buffer (little-endian) instead.
fn cheng_linux_pollfd_wait(fd: int32, events: int32, timeoutMs: int32): int32 =
    if fd < 0:
        return -9
    # The pollfd struct is built inside a single uint64 scalar instead of a
    # local uint8[8] array: taking the address of a local fixed-array element
    # (&pollBuf[0]) is mis-lowered by the cold backend to a bogus pointer, so
    # ppoll faulted (EFAULT) and returned instantly every call — the listener
    # recv loop then busy-spun without ever draining the socket. &scalar is the
    # lowering path every other syscall wrapper in this file already relies on.
    # Layout (little-endian): bits[0..31]=fd, bits[32..47]=events, bits[48..63]=revents.
    var pollWord: uint64 = uint64(uint32(fd)) | (uint64(uint32(events) & uint32(65535)) << uint64(32))
    var timeout: ChengLinuxTimespec
    # The cold backend mis-lowers `var p: ptr = nil; if c: p = &local` — it stores
    # &local through the stale nil slot (PAYLOAD_STORE) -> SIGSEGV (repro:
    # src/tests/cold_ptr_addr_reassign_repro.cheng, crashes darwin+android; the
    # existing cold_opaque_local_reassign_smoke only covers `p = call()`). Branch
    # the syscall so &timeout is passed straight through (the same proven path as
    # &pollWord above) and the no-timeout case passes cheng_ptr_arg(nil)==0. Same
    # workaround discipline as the &pollBuf[0]->&scalar fix noted above. Root fix
    # belongs in the cold backend lowering.
    var rc: int32
    if timeoutMs >= 0:
        timeout.tv_sec = int64(timeoutMs / 1000)
        let timeoutSecPart: int32 = timeoutMs / 1000
        let timeoutMsPart: int32 = timeoutMs - timeoutSecPart * 1000
        timeout.tv_nsec = int64(timeoutMsPart) * int64(1000000)
        rc = cheng_linux_syscall_i32(cheng_linux_syscall5(chengLinuxSysPPoll,
                                                           cheng_ptr_arg(&pollWord),
                                                           1,
                                                           cheng_ptr_arg(&timeout),
                                                           0,
                                                           0))
    else:
        rc = cheng_linux_syscall_i32(cheng_linux_syscall5(chengLinuxSysPPoll,
                                                          cheng_ptr_arg(&pollWord),
                                                          1,
                                                          cheng_ptr_arg(nil),
                                                          0,
                                                          0))
    let revents: int32 = int32((pollWord >> uint64(48)) & uint64(65535))
    if rc < 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        if err > 0:
            return 0 - err
        return -1
    if rc == 0 || revents == 0:
        return 0
    # [dead-fd-hunt] 对端关闭(POLLHUP=16/POLLERR=8)即便无 POLLIN 也报就绪:
    # 调用方 recv 拿到 0/EOF 走既有收割分支。旧形返回 0 = 死 target 永远
    # "不可读" → mux pump 对死流无限空转(poll 1ms+sleep 2ms 烧 CPU)。
    if events == 1:
        if (revents & int32(24)) != 0:
            return 1
    # [epipe-spin-fix] POLLOUT 方向的假就绪: 对端关闭后 poll(POLLOUT) 立即
    # 返回 POLLOUT|POLLHUP, 旧逻辑返回 1="可写", 调用方 sendto 必 EPIPE;
    # 若 errno 链把失败误读为 would-block, poll(-1) 又立即返回 → 无限
    # poll+sendto+SIGPIPE 自旋(实测服务器 4 线程烧满 CPU, 活流饿死到
    # 19KB/s)。POLLERR|POLLHUP|POLLNVAL 一律判致命(-EPIPE)。
    # readable 方向不受影响: POLLIN|POLLHUP 仍可读残余数据, EOF 由
    # recv=0 的既有分支处理。
    if events == 4:
        if (revents & int32(56)) != 0:
            return int32(-32)
    return 1

@exportc("cheng_fd_wait_readable_bridge")
fn cheng_fd_wait_readable_bridge_export(fd: int32, timeoutMs: int32): int32 =
    return cheng_linux_pollfd_wait(fd, 1, timeoutMs)

@exportc("cheng_fd_wait_writable_bridge")
fn cheng_fd_wait_writable_bridge_export(fd: int32, timeoutMs: int32): int32 =
    return cheng_linux_pollfd_wait(fd, 4, timeoutMs)

# --- Multi-fd event wait (ppoll over a fd SET) ----------------------------------
# Block on a whole SET of fds in one ppoll syscall and return immediately when ANY
# is ready, replacing the event loop's 1ms idle sleep (see the darwin provider for
# the rationale). Stateful 3-call ABI (reset/add/wait); the pollfd buffer lives on
# the heap (cheng_runtime_malloc + pointer arithmetic), never crosses as an array.
# pollfd layout: fd@0 (int32), events@4 (uint16 LE), revents@6 (uint16 LE).
var
    chengLinuxPollSetBuf: ptr
    chengLinuxPollSetCap: int32
    chengLinuxPollSetCount: int32

fn cheng_linux_pollfd_write(slot: ptr, fd: int32, events: int32) =
    if slot == nil:
        return
    *(Int32Ptr(slot)) = fd
    *(UInt8Ptr(cheng_ptr_plus(slot, 4))) = uint8(events & 255)
    *(UInt8Ptr(cheng_ptr_plus(slot, 5))) = uint8((events >> 8) & 255)
    *(UInt8Ptr(cheng_ptr_plus(slot, 6))) = uint8(0)
    *(UInt8Ptr(cheng_ptr_plus(slot, 7))) = uint8(0)

@exportc("cheng_fd_wait_multi_reset")
fn cheng_fd_wait_multi_reset_export() =
    chengLinuxPollSetCount = 0

@exportc("cheng_fd_wait_multi_add")
fn cheng_fd_wait_multi_add_export(fd: int32, events: int32): int32 =
    if fd < 0:
        return -1
    if chengLinuxPollSetCount >= chengLinuxPollSetCap:
        var newCap: int32 = chengLinuxPollSetCap * 2
        if newCap < 16:
            newCap = 16
        let newBuf: ptr = cheng_runtime_malloc(newCap * 8)
        if newBuf == nil:
            return -1
        if chengLinuxPollSetBuf != nil && chengLinuxPollSetCount > 0:
            cheng_bytes_copy(newBuf, chengLinuxPollSetBuf, chengLinuxPollSetCount * 8)
        chengLinuxPollSetBuf = newBuf
        chengLinuxPollSetCap = newCap
    let slot: ptr = cheng_ptr_plus(chengLinuxPollSetBuf, chengLinuxPollSetCount * 8)
    cheng_linux_pollfd_write(slot, fd, events)
    chengLinuxPollSetCount = chengLinuxPollSetCount + 1
    return 0

@exportc("cheng_fd_wait_multi_wait")
fn cheng_fd_wait_multi_wait_export(timeoutMs: int32): int32 =
    if chengLinuxPollSetCount <= 0 || chengLinuxPollSetBuf == nil:
        return 0
    var rc: int32
    if timeoutMs >= 0:
        var timeout: ChengLinuxTimespec
        let timeoutSecPart: int32 = timeoutMs / 1000
        timeout.tv_sec = int64(timeoutSecPart)
        let timeoutMsPart: int32 = timeoutMs - timeoutSecPart * 1000
        timeout.tv_nsec = int64(timeoutMsPart) * int64(1000000)
        rc = cheng_linux_syscall_i32(cheng_linux_syscall5(chengLinuxSysPPoll,
                                                          cheng_ptr_arg(chengLinuxPollSetBuf),
                                                          int64(chengLinuxPollSetCount),
                                                          cheng_ptr_arg(&timeout),
                                                          0,
                                                          0))
    else:
        rc = cheng_linux_syscall_i32(cheng_linux_syscall5(chengLinuxSysPPoll,
                                                          cheng_ptr_arg(chengLinuxPollSetBuf),
                                                          int64(chengLinuxPollSetCount),
                                                          cheng_ptr_arg(nil),
                                                          0,
                                                          0))
    if rc < 0:
        let err: int32 = cheng_native_errno_code_bridge_export()
        if err > 0:
            return 0 - err
        return -1
    return rc

