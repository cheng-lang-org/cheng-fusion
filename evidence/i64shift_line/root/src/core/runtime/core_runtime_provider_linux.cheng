        chengLinuxSysLandlockCreateRuleset,
        int64(0),
        int64(0),
        chengLinuxLandlockCreateVersion)
    if cheng_linux_syscall_failed(abi) ||
       abi < chengLinuxLandlockMinimumAbi:
