            cheng_linux_terminal_close_syscall_number(), int64(rulesetFd))
        return -1
    let finishedRuleFdRaw = cheng_linux_syscall4(
        cheng_linux_terminal_openat_syscall_number(),
        chengLinuxAtFdcwd,
        cheng_ptr_arg(ptr(&finishedProcPath)),
        chengLinuxOPathFlag | chengLinuxOCloexecFlag,
        int64(0))
    if cheng_linux_syscall_failed(finishedRuleFdRaw) ||
       finishedRuleFdRaw < int64(0) ||
       finishedRuleFdRaw > int64(2147483647):
        let _closeProcOpen = cheng_linux_syscall1(
            cheng_linux_terminal_close_syscall_number(), int64(rulesetFd))
        return -1
