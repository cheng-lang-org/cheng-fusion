    let epollClosed = cheng_linux_terminal_watch_close_fd_once(
        row, chengLinuxTerminalWatchFdEpoll)
    let inotifyClosed = cheng_linux_terminal_watch_close_fd_once(
        row, chengLinuxTerminalWatchFdInotify)
    let processClosed = cheng_linux_terminal_watch_close_fd_once(
        row, chengLinuxTerminalWatchFdProcess)
    let decisionClosed = cheng_linux_terminal_watch_close_fd_once(row, 4)
