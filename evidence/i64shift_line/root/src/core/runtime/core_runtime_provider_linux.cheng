        cheng_native_fail_stop_bridge_export(
            "cheng csg merkle admission registry epoch futex wake failed", 59, 70)

@exportc("cheng_native_csg_current_head_lease_registry_lock_bridge")
@abi_internal
fn cheng_native_csg_current_head_lease_registry_lock_bridge_export() =
    let lockAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryLockWord)
    let ownerAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    if cheng_linux_atomic_load_i32(lockAddress) != 0 &&
       cheng_linux_atomic_load_i32(ownerAddress) == tid:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry lock recursive acquire", 60, 70)
    if cheng_linux_atomic_cas_i32(lockAddress, 0, 1) != 0:
        cheng_linux_atomic_store_i32(ownerAddress, tid)
        return
    while true:
        if cheng_linux_atomic_load_i32(ownerAddress) == tid:
            cheng_native_fail_stop_bridge_export(
                "cheng csg current head lease registry lock recursive acquire", 60, 70)
        let current = cheng_linux_atomic_load_i32(lockAddress)
        if current == 0:
            if cheng_linux_atomic_cas_i32(lockAddress, 0, 2) != 0:
                cheng_linux_atomic_store_i32(ownerAddress, tid)
                return
            continue
        if current == 1:
            let promoted = cheng_linux_atomic_cas_i32(
                lockAddress, 1, 2)
            promoted
        elif current != 2:
            cheng_native_fail_stop_bridge_export(
                "cheng csg current head lease registry lock state corrupt", 56, 70)
        let waitRc = cheng_linux_syscall6(
            chengLinuxSysFutex,
            cheng_ptr_arg(lockAddress),
            chengLinuxFutexWaitPrivate,
            2,
            0,
            0,
            0)
        if waitRc < 0 && waitRc != -4 && waitRc != -11:
            cheng_native_fail_stop_bridge_export(
                "cheng csg current head lease registry lock futex wait failed", 60, 70)

@exportc("cheng_native_csg_current_head_lease_registry_unlock_bridge")
@abi_internal
fn cheng_native_csg_current_head_lease_registry_unlock_bridge_export() =
    let lockAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryLockWord)
    let ownerAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    if cheng_linux_atomic_load_i32(ownerAddress) != tid:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry unlock by non-owner", 57, 70)
    let current = cheng_linux_atomic_load_i32(lockAddress)
    if current != 1 && current != 2:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry unlock state corrupt", 58, 70)
    cheng_linux_atomic_store_i32(ownerAddress, 0)
    var releaseState = current
    while cheng_linux_atomic_cas_i32(lockAddress, releaseState, 0) == 0:
        releaseState = cheng_linux_atomic_load_i32(lockAddress)
        if releaseState != 1 && releaseState != 2:
            cheng_native_fail_stop_bridge_export(
                "cheng csg current head lease registry unlock state corrupt", 58, 70)
    if releaseState == 2:
        let wakeRc = cheng_linux_syscall6(
            chengLinuxSysFutex,
            cheng_ptr_arg(lockAddress),
            chengLinuxFutexWakePrivate,
            1,
            0,
            0,
            0)
        if wakeRc < 0:
            cheng_native_fail_stop_bridge_export(
                "cheng csg current head lease registry unlock futex wake failed", 62, 70)

@exportc("cheng_native_csg_current_head_lease_registry_epoch_bridge")
@abi_internal
fn cheng_native_csg_current_head_lease_registry_epoch_bridge_export(): int32 =
    let lockAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryLockWord)
    let ownerAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    let state = cheng_linux_atomic_load_i32(lockAddress)
    if (state != 1 && state != 2) ||
       cheng_linux_atomic_load_i32(ownerAddress) != tid:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry lock ownership required", 61, 70)
    return cheng_linux_atomic_load_i32(
        ptr(&chengLinuxCsgCurrentHeadLeaseRegistryEpochWord))

@exportc("cheng_native_csg_current_head_lease_registry_wait_bridge")
@abi_internal
fn cheng_native_csg_current_head_lease_registry_wait_bridge_export(
        observedEpoch: int32) =
    let lockAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryLockWord)
    let ownerAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    if observedEpoch < 0:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry wait epoch invalid", 56, 70)
    let lockState = cheng_linux_atomic_load_i32(lockAddress)
    if lockState < 0 || lockState > 2:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry wait lock state corrupt", 61, 70)
    if lockState != 0 &&
       cheng_linux_atomic_load_i32(ownerAddress) == tid:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry wait while locked", 55, 70)
    let epochAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryEpochWord)
    while cheng_linux_atomic_load_i32(epochAddress) == observedEpoch:
        let waitRc = cheng_linux_syscall6(
            chengLinuxSysFutex,
            cheng_ptr_arg(epochAddress),
            chengLinuxFutexWaitPrivate,
            int64(observedEpoch),
            0,
            0,
            0)
        if waitRc < 0 && waitRc != -4 && waitRc != -11:
            cheng_native_fail_stop_bridge_export(
                "cheng csg current head lease registry epoch futex wait failed", 61, 70)

@exportc("cheng_native_csg_current_head_lease_registry_notify_all_bridge")
@abi_internal
fn cheng_native_csg_current_head_lease_registry_notify_all_bridge_export() =
    let lockAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryLockWord)
    let ownerAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryOwnerTid)
    let tid = cheng_linux_current_tid_or_fail()
    let state = cheng_linux_atomic_load_i32(lockAddress)
    if (state != 1 && state != 2) ||
       cheng_linux_atomic_load_i32(ownerAddress) != tid:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry lock ownership required", 61, 70)
    let epochAddress = ptr(&chengLinuxCsgCurrentHeadLeaseRegistryEpochWord)
    let current = cheng_linux_atomic_load_i32(epochAddress)
    if current < 0 || current == chengLinuxInt32Max:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry epoch overflow", 52, 70)
    cheng_linux_atomic_store_i32(epochAddress, current + 1)
    let wakeRc = cheng_linux_syscall6(
        chengLinuxSysFutex,
        cheng_ptr_arg(epochAddress),
        chengLinuxFutexWakePrivate,
        int64(chengLinuxInt32Max),
        0,
        0,
        0)
    if wakeRc < 0:
        cheng_native_fail_stop_bridge_export(
            "cheng csg current head lease registry epoch futex wake failed", 61, 70)

fn cheng_linux_raw_mmap(bytes: int64): ptr =
    let rc: int64 = cheng_linux_syscall6(chengLinuxSysMmap,
                                        0,
                                        bytes,
                                        chengLinuxProtReadWrite,
                                        chengLinuxMapPrivateAnonymous,
                                        -1,
                                        0)
    if cheng_linux_syscall_failed(rc):
        return nil
    return ptr(uint64(rc))

# libc-shaped mmap/munmap for the linkerless Linux target. The Linux runtime is
# nolibc, so every libc name a Cheng closure imports has to have a real
# definition somewhere; the linkerless syscall provider object only carries
# mmap/munmap on x86_64, which left aarch64 links unresolved. These are the
# genuine syscalls with every argument passed through - no anon-only shortcut
# and no substituted allocator - and the failure value is MAP_FAILED (-1) with
# errno recorded, matching what libc callers already test for.
@exportc("mmap")
fn cheng_linux_libc_mmap(addr: ptr, len: int64, prot: int32, flags: int32, fd: int32, offset: int64): ptr =
    let rc: int64 = cheng_linux_syscall6(chengLinuxSysMmap,
                                        cheng_ptr_arg(addr),
                                        len,
                                        int64(prot),
                                        int64(flags),
                                        int64(fd),
                                        offset)
    if cheng_linux_syscall_failed(rc):
        chengLinuxLastErrno = int32(0 - rc)
        return ptr(uint64(chengLinuxMapFailedWord))
    return ptr(uint64(rc))

@exportc("munmap")
fn cheng_linux_libc_munmap(addr: ptr, len: int64): int32 =
    return cheng_linux_syscall_i32(cheng_linux_syscall2(chengLinuxSysMunmap,
                                                        cheng_ptr_arg(addr),
                                                        len))

fn cheng_linux_geteuid_syscall_number(): int64 =
    var unameWire: uint8[390]
    cheng_bytes_set(ptr(&unameWire), 0, 390)
    if libc_uname(ptr(&unameWire)) != 0:
        chengLinuxLastErrno = chengLinuxErrnoEnosys
        return int64(-1)
    let machine = cheng_ptr_plus(ptr(&unameWire), 260)
    if cheng_linux_machine_name_equal(
           machine, "x86_64", 6):
        return chengLinuxSysGeteuidX64
    if cheng_linux_machine_name_equal(
           machine, "aarch64", 7):
        return chengLinuxSysGeteuidA64
    chengLinuxLastErrno = chengLinuxErrnoEnosys
    return int64(-1)

# libc geteuid never fails, but on the nolibc Linux target the syscall number
# is arch-specific; an unknown machine is a hard stop, not a fabricated uid.
@exportc("geteuid")
fn cheng_linux_libc_geteuid(): uint32 =
    let syscallNumber = cheng_linux_geteuid_syscall_number()
    if syscallNumber < int64(0):
        cheng_native_fail_stop_bridge_export(
            "geteuid: unknown machine", 24, 70)
    return uint32(cheng_linux_syscall0(syscallNumber))

fn cheng_linux_machine_name_equal(
        machine: ptr,
        expected: ptr,
        expectedLength: int32): bool =
    if machine == nil || expected == nil || expectedLength <= 0:
        return false
    for index in 0..<expectedLength:
        if *(UInt8Ptr(cheng_ptr_plus(machine, index))) !=
           *(UInt8Ptr(cheng_ptr_plus(expected, index))):
            return false
    return *(UInt8Ptr(
               cheng_ptr_plus(machine, expectedLength))) == uint8(0)

fn cheng_linux_fsverity_ioctl_number(): int64 =
    var unameWire: uint8[390]
    cheng_bytes_set(ptr(&unameWire), 0, 390)
    if libc_uname(ptr(&unameWire)) != 0:
        chengLinuxLastErrno = chengLinuxErrnoEnosys
        return int64(-1)
    let machine = cheng_ptr_plus(ptr(&unameWire), 260)
    if cheng_linux_machine_name_equal(
           machine, "x86_64", 6):
        return chengLinuxSysIoctlX64
    if cheng_linux_machine_name_equal(
           machine, "aarch64", 7):
        return chengLinuxSysIoctlA64
    chengLinuxLastErrno = chengLinuxErrnoEnosys
    return int64(-1)

fn cheng_linux_fsverity_ioctl(
        fd: int32,
        request: int64,
        argument: ptr): int32 =
    if fd < 0 || argument == nil:
        chengLinuxLastErrno = chengLinuxErrnoEinval
        return -1
    let syscallNumber =
        cheng_linux_fsverity_ioctl_number()
    if syscallNumber < int64(0):
        return -1
    return cheng_linux_syscall_i32(
        cheng_linux_syscall3(
            syscallNumber,
            int64(fd),
            request,
            cheng_ptr_arg(argument)))

@exportc("cheng_linux_fs_ioc_getflags_bridge")
fn cheng_linux_fs_ioc_getflags_bridge_export(
        fd: int32,
        outFlags: ptr): int32 =
    if outFlags == nil:
        chengLinuxLastErrno = chengLinuxErrnoEinval
        return -1
    var flagsWord: uint32
    let rc64 = cheng_linux_fsverity_ioctl(
        fd,
        int64(2148038145),
        ptr(&flagsWord))
    if rc64 != 0:
        let rc32 = cheng_linux_fsverity_ioctl(
            fd,
            int64(2147776001),
            ptr(&flagsWord))
        if rc32 != 0:
            return rc32
    *(UInt32Ptr(outFlags)) = flagsWord
    *(UInt32Ptr(cheng_ptr_plus(outFlags, 4))) = uint32(0)
    return 0

@exportc("cheng_linux_fsverity_enable_sha256_bridge")
fn cheng_linux_fsverity_enable_sha256_bridge_export(
        fd: int32): int32 =
    var argument: uint8[128]
    cheng_bytes_set(
        ptr(&argument),
        0,
        chengLinuxFsverityEnableArgBytes)
    argument[0] = uint8(chengLinuxFsverityVersion & uint32(255))
    argument[1] = uint8((chengLinuxFsverityVersion >> 8) & uint32(255))
    argument[2] = uint8((chengLinuxFsverityVersion >> 16) & uint32(255))
    argument[3] = uint8((chengLinuxFsverityVersion >> 24) & uint32(255))
    argument[4] = uint8(chengLinuxFsveritySha256 & uint32(255))
    argument[5] = uint8((chengLinuxFsveritySha256 >> 8) & uint32(255))
    argument[6] = uint8((chengLinuxFsveritySha256 >> 16) & uint32(255))
    argument[7] = uint8((chengLinuxFsveritySha256 >> 24) & uint32(255))
    argument[8] = uint8(chengLinuxFsverityBlockBytes & uint32(255))
    argument[9] = uint8((chengLinuxFsverityBlockBytes >> 8) & uint32(255))
    argument[10] = uint8((chengLinuxFsverityBlockBytes >> 16) & uint32(255))
    argument[11] = uint8((chengLinuxFsverityBlockBytes >> 24) & uint32(255))
    return cheng_linux_fsverity_ioctl(
        fd,
        chengLinuxFsverityEnableRequest,
        ptr(&argument))

@exportc("cheng_linux_fsverity_measure_sha256_bridge")
fn cheng_linux_fsverity_measure_sha256_bridge_export(
        fd: int32,
        outDigest: ptr): int32 =
    if outDigest == nil:
        chengLinuxLastErrno = chengLinuxErrnoEinval
        return -1
    var wire: uint8[36]
    cheng_bytes_set(
        ptr(&wire),
        0,
        chengLinuxFsverityDigestWireBytes)
    *(UInt16Ptr(cheng_ptr_plus(ptr(&wire), 2))) = chengLinuxFsverityDigestBytes
    let rc = cheng_linux_fsverity_ioctl(
        fd, chengLinuxFsverityMeasureRequest, ptr(&wire))
    if rc != 0:
        return rc
    let algorithm =
        *(UInt16Ptr(ptr(&wire)))
    let digestSize =
        *(UInt16Ptr(cheng_ptr_plus(
            ptr(&wire), 2)))
    if int32(algorithm) != int32(chengLinuxFsveritySha256) ||
       digestSize != chengLinuxFsverityDigestBytes:
        chengLinuxLastErrno = chengLinuxErrnoEbadmsg
        return -1
    cheng_bytes_copy(
        outDigest,
        cheng_ptr_plus(ptr(&wire), 4),
        int32(chengLinuxFsverityDigestBytes))
    return 0

fn cheng_linux_host_is_x86_64(): bool =
    var unameWire: uint8[390]
    cheng_bytes_set(ptr(&unameWire), 0, 390)
    if libc_uname(ptr(&unameWire)) != 0:
        return false
    return cheng_linux_machine_name_equal(
        cheng_ptr_plus(ptr(&unameWire), 260), "x86_64", 6)

fn cheng_linux_prctl_syscall_number(): int64 =
    return cheng_linux_host_is_x86_64() ?
        int64(157) : chengLinuxSysPrctlA64

fn cheng_linux_terminal_fcntl_syscall_number(): int64 =
    return cheng_linux_host_is_x86_64() ?
        chengLinuxSysFcntlX64 : chengLinuxSysFcntl

fn cheng_linux_terminal_openat_syscall_number(): int64 =
    return cheng_linux_host_is_x86_64() ?
        chengLinuxSysOpenAtX64 : chengLinuxSysOpenAt

fn cheng_linux_terminal_close_syscall_number(): int64 =
    return cheng_linux_host_is_x86_64() ?
        chengLinuxSysCloseX64 : chengLinuxSysClose

fn cheng_linux_terminal_proc_fd_path_into(
        fd: int32,
        out: ptr,
        cap: int32): bool =
    if fd < 0 || out == nil || cap < 17:
        return false
    cheng_bytes_set(out, 0, cap)
    let prefix: ptr = "/proc/self/fd/"
    for index in 0..<14:
        *(UInt8Ptr(cheng_ptr_plus(out, index))) =
            *(UInt8Ptr(cheng_ptr_plus(prefix, index)))
    var digits: int32
    var probe = fd
    while probe > 0:
        digits = digits + 1
        probe = probe / 10
    if digits <= 0 || 14 + digits >= cap:
        return false
    var value = fd
    var digit = digits
    while digit > 0:
        digit = digit - 1
        *(UInt8Ptr(cheng_ptr_plus(out, 14 + digit))) =
            uint8(48 + value % 10)
        value = value / 10
    return true

fn cheng_linux_terminal_proc_stat_path_into(
        childPid: int32,
        out: ptr,
        cap: int32): bool =
    if childPid <= 0 || out == nil || cap < 24:
        return false
    cheng_bytes_set(out, 0, cap)
    cheng_bytes_copy(out, "/proc/", 6)
    let offset = cheng_linux_write_u64_decimal(
        uint64(childPid), out, 6, cap)
    if offset <= 0 || offset + 5 >= cap:
        return false
    cheng_bytes_copy(cheng_ptr_plus(out, offset), "/stat", 5)
    *(UInt8Ptr(cheng_ptr_plus(out, offset + 5))) = uint8(0)
    return true

# Linux /proc/<pid>/stat field 22 is the kernel process start tick.  The
# command field is parenthesized and may contain spaces or ')' bytes, so the
# parser anchors at the final ')' and then counts exact numeric fields.
fn cheng_linux_terminal_proc_stat_identity(
        raw: ptr,
        count: int32,
        childPid: int32,
        outStartTicks: ptr,
        outState: ptr): bool =
    if raw == nil || outStartTicks == nil || outState == nil ||
       count <= 8 || childPid <= 0:
        return false
    var pidValue: uint64
    var pidIndex: int32
    while pidIndex < count:
        let byte = *(UInt8Ptr(cheng_ptr_plus(raw, pidIndex)))
        if byte == uint8(' '):
            break
        if byte < uint8('0') || byte > uint8('9'):
            return false
        let digit = uint64(int32(byte) - int32('0'))
        if pidValue > (uint64(2147483647) - digit) / uint64(10):
            return false
        pidValue = pidValue * uint64(10) + digit
        pidIndex = pidIndex + 1
    if int32(pidValue) != childPid || pidIndex >= count - 4:
        return false
    var closeParen: int32 = -1
    for scan in 0..<count:
        if *(UInt8Ptr(cheng_ptr_plus(raw, scan))) == uint8(')'):
            closeParen = scan
    if closeParen <= pidIndex + 1 || closeParen + 4 >= count ||
       *(UInt8Ptr(cheng_ptr_plus(raw, pidIndex + 1))) != uint8('(') ||
       *(UInt8Ptr(cheng_ptr_plus(raw, closeParen + 1))) != uint8(' ') ||
       *(UInt8Ptr(cheng_ptr_plus(raw, closeParen + 3))) != uint8(' '):
        return false
    let processState = *(UInt8Ptr(cheng_ptr_plus(raw, closeParen + 2)))
    if processState != uint8('R') && processState != uint8('S') &&
       processState != uint8('D') && processState != uint8('Z') &&
       processState != uint8('T') && processState != uint8('t') &&
       processState != uint8('X') && processState != uint8('x') &&
       processState != uint8('K') && processState != uint8('W') &&
       processState != uint8('P') && processState != uint8('I'):
        return false
    var index = closeParen + 4
    var field: int32 = 4
    while field <= 22:
        while index < count &&
              *(UInt8Ptr(cheng_ptr_plus(raw, index))) == uint8(' '):
            index = index + 1
        if index >= count:
            return false
        var negative = false
        if *(UInt8Ptr(cheng_ptr_plus(raw, index))) == uint8('-'):
            negative = true
            index = index + 1
        var value: uint64
        var digits: int32
        while index < count:
            let byte = *(UInt8Ptr(cheng_ptr_plus(raw, index)))
            if byte < uint8('0') || byte > uint8('9'):
                break
            let digit = uint64(int32(byte) - int32('0'))
            # UINT64_MAX 溢出守卫，无除法精确形。原守卫
            # value > (uint64(18446744073709551615) - digit) / uint64(10)
            # 撞 stage3 现行 codegen 的 u64 除法误译（发成有符号除法，
            # 高位置位值 (-1)/10=0 → 守卫恒真，/proc/<pid>/stat 解析必败，
            # 即幽灵终验 ticket 交接墙根因，判词 59）。恒等式：
            # UINT64_MAX = 10*1844674407370955161 + 5，故
            # value*10+digit 溢出 ⟺ value > 1844674407370955161，或
            # value == 1844674407370955161 且 digit > 5。
            if value > uint64(1844674407370955161):
                return false
            if value == uint64(1844674407370955161) && digit > uint64(5):
                return false
            value = value * uint64(10) + digit
            digits = digits + 1
            index = index + 1
        if digits <= 0 || (index < count &&
           *(UInt8Ptr(cheng_ptr_plus(raw, index))) != uint8(' ') &&
           *(UInt8Ptr(cheng_ptr_plus(raw, index))) != uint8('\n')):
            return false
        if field == 22:
            if negative || value == uint64(0):
                return false
            *(UInt64Ptr(outStartTicks)) = value
            *(Int32Ptr(outState)) = int32(processState)
            return true
        field = field + 1
    return false

fn cheng_linux_terminal_child_identity_into(
        childPid: int32,
        outStartTicks: ptr,
        outState: ptr): bool =
    var path: uint8[64]
    if !cheng_linux_terminal_proc_stat_path_into(
           childPid, ptr(&path), 64):
        return false
    let fd = libc_open_runtime(
        ptr(&path), int32(chengLinuxOCloexecFlag))
    if fd < 0:
        return false
    var bytes: uint8[4096]
    let count = libc_read_runtime(fd, ptr(&bytes), 4095)
    var extra: uint8[1]
    let eof = count > int64(0) && count <= int64(4095) &&
        libc_read_runtime(fd, ptr(&extra), 1) == int64(0)
    let closed = libc_close(fd) == 0
    return eof && closed &&
        cheng_linux_terminal_proc_stat_identity(
            ptr(&bytes), int32(count), childPid, outStartTicks, outState)

fn cheng_linux_terminal_process_state(
        processState: int32): int32 =
    if processState == int32('Z') || processState == int32('X') ||
       processState == int32('x'):
        return 0
    if processState == int32('R') || processState == int32('S') ||
       processState == int32('D') || processState == int32('T') ||
       processState == int32('t') || processState == int32('K') ||
       processState == int32('W') || processState == int32('P') ||
       processState == int32('I'):
        return 1
    return -1

@exportc("cheng_native_terminal_child_birth_capture_bridge")
@abi_internal
fn cheng_native_terminal_child_birth_capture_bridge_export(
        childPid: int32,
        pidfd: int32,
        outPlatform: ptr,
        outBirth0: ptr,
        outBirth1: ptr): int32 =
    if childPid <= 0 || pidfd < 0 || outPlatform == nil ||
       outBirth0 == nil || outBirth1 == nil:
        return 0
    var pidfdSize: int64
    var pidfdMode: int32
    var pidfdDevice: uint64
    var pidfdInode: uint64
    var startTicks: uint64
    var processState: int32
    if libc_fstat_scalars_runtime(
           pidfd,
           ptr(&pidfdSize),
           ptr(&pidfdMode),
           ptr(&pidfdDevice),
           ptr(&pidfdInode)) != 0 ||
       pidfdDevice == uint64(0) || pidfdInode == uint64(0) ||
       !cheng_linux_terminal_child_identity_into(
           childPid, ptr(&startTicks), ptr(&processState)) ||
       cheng_linux_terminal_process_state(processState) != 1:
        return 0
    *(Int32Ptr(outPlatform)) = 2
    *(UInt64Ptr(outBirth0)) = startTicks
    *(UInt64Ptr(outBirth1)) = uint64(0)
    return 1

fn cheng_linux_terminal_epoll_event_build(
        event: var ChengLinuxTerminalEpollEvent,
        flags: uint32,
        token: uint64) =
    cheng_bytes_set(ptr(&event), 0, 16)
    for index in 0..<4:
        event.data[index] = uint8(
            (flags >> uint32(index * 8)) & uint32(255))
    for index in 0..<8:
        event.data[4 + index] = uint8(
            (token >> uint64(index * 8)) & uint64(255))

fn cheng_linux_terminal_epoll_event_flags(
        event: ChengLinuxTerminalEpollEvent): uint32 =
    var value: uint32
    for index in 0..<4:
        value = value |
            (uint32(event.data[index]) << uint32(index * 8))
    return value

fn cheng_linux_terminal_epoll_event_token(
        event: ChengLinuxTerminalEpollEvent): uint64 =
    var value: uint64
    for index in 0..<8:
        value = value |
            (uint64(event.data[4 + index]) << uint64(index * 8))
    return value

fn cheng_linux_terminal_watch_close_fd_once(
        row: int32,
        role: int32): bool =
    if row < 0 || row >= chengLinuxTerminalDecisionWatchRowCount:
        return false
    var statePtr: ptr
    var fd = -1
    if role == chengLinuxTerminalWatchFdEpoll:
        statePtr = ptr(
            &chengLinuxTerminalDecisionWatchEpollCloseStates[row])
        fd = chengLinuxTerminalDecisionWatchEpollFds[row]
    elif role == chengLinuxTerminalWatchFdInotify:
        statePtr = ptr(
            &chengLinuxTerminalDecisionWatchInotifyCloseStates[row])
        fd = chengLinuxTerminalDecisionWatchInotifyFds[row]
    elif role == chengLinuxTerminalWatchFdProcess:
        statePtr = ptr(
            &chengLinuxTerminalDecisionWatchProcessCloseStates[row])
        fd = chengLinuxTerminalDecisionWatchProcessFds[row]
    elif role == 4:
        statePtr = ptr(
            &chengLinuxTerminalDecisionWatchDecisionCloseStates[row])
        fd = chengLinuxTerminalDecisionWatchDecisionFds[row]
    else:
        return false
    let closeState = cheng_linux_atomic_load_i32(statePtr)
    if closeState == chengLinuxTerminalFdCloseNotPresent:
        return true
    if closeState == chengLinuxTerminalFdCloseClosedClean ||
       closeState == chengLinuxTerminalFdCloseClosedError ||
       closeState == chengLinuxTerminalFdCloseInvalidEbafd:
        return closeState == chengLinuxTerminalFdCloseClosedClean
    if closeState != chengLinuxTerminalFdCloseOpen || fd < 0 ||
       cheng_linux_atomic_cas_i32(
           statePtr,
           chengLinuxTerminalFdCloseOpen,
           chengLinuxTerminalFdCloseClosing) != 1:
        return false
    let receipt = cheng_native_terminal_fd_close_once_bridge_export(fd)
    let terminalState = receipt == 1 ?
        chengLinuxTerminalFdCloseClosedClean :
        (receipt == 2 ? chengLinuxTerminalFdCloseClosedError :
            chengLinuxTerminalFdCloseInvalidEbafd)
    if role == chengLinuxTerminalWatchFdEpoll:
        chengLinuxTerminalDecisionWatchEpollFds[row] = -1
        chengLinuxTerminalDecisionWatchEpollCloseReceipts[row] = receipt
    elif role == chengLinuxTerminalWatchFdInotify:
        chengLinuxTerminalDecisionWatchInotifyFds[row] = -1
        chengLinuxTerminalDecisionWatchInotifyCloseReceipts[row] = receipt
    else:
        if role == chengLinuxTerminalWatchFdProcess:
            chengLinuxTerminalDecisionWatchProcessFds[row] = -1
            chengLinuxTerminalDecisionWatchProcessCloseReceipts[row] = receipt
        else:
            chengLinuxTerminalDecisionWatchDecisionFds[row] = -1
            chengLinuxTerminalDecisionWatchDecisionCloseReceipts[row] = receipt
    cheng_linux_atomic_store_i32(statePtr, terminalState)
    return terminalState == chengLinuxTerminalFdCloseClosedClean

fn cheng_linux_terminal_watch_failed_owner(
        row: int32,
        epollFd: int32,
        inotifyFd: int32,
        processFd: int32): int32 =
    let epollClosed = cheng_linux_terminal_watch_close_fd_once(
        row, chengLinuxTerminalWatchFdEpoll)
    let inotifyClosed = cheng_linux_terminal_watch_close_fd_once(
        row, chengLinuxTerminalWatchFdInotify)
    let processClosed = cheng_linux_terminal_watch_close_fd_once(
        row, chengLinuxTerminalWatchFdProcess)
    let decisionClosed = cheng_linux_terminal_watch_close_fd_once(row, 4)
    chengLinuxTerminalDecisionWatchDescriptors[row] = -1
    chengLinuxTerminalDecisionWatchSocketFds[row] = -1
    chengLinuxTerminalDecisionWatchDecisionFds[row] = -1
    chengLinuxTerminalDecisionWatchDevices[row] = uint64(0)
    chengLinuxTerminalDecisionWatchInodes[row] = uint64(0)
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        chengLinuxTerminalDecisionWatchFailed)
    return epollClosed && inotifyClosed && processClosed && decisionClosed ?
        -1 : row + 1

fn cheng_linux_terminal_watch_retain_failed_process(
        processFd: int32,
        processCloseReceipt: int32): int32 =
    let row = cheng_linux_atomic_fetch_add_i32(
        ptr(&chengLinuxTerminalDecisionWatchNextRow), 1)
    if row < 0 || row >= chengLinuxTerminalDecisionWatchRowCount:
        cheng_native_fail_stop_bridge_export(
            "terminal watch failed process owner arena exhausted", 51, 70)
        return -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        chengLinuxTerminalDecisionWatchOpening)
    chengLinuxTerminalDecisionWatchEpollFds[row] = -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchEpollCloseStates[row]),
        chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchEpollCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchInotifyFds[row] = -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchInotifyCloseStates[row]),
        chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchInotifyCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchDescriptors[row] = -1
    chengLinuxTerminalDecisionWatchSocketFds[row] = -1
    chengLinuxTerminalDecisionWatchDecisionFds[row] = -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchDecisionCloseStates[row]),
        chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchDecisionCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchProcessFds[row] = processFd
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchProcessCloseStates[row]),
        processCloseReceipt == 1 ?
            chengLinuxTerminalFdCloseClosedClean :
            (processCloseReceipt == 2 ?
                chengLinuxTerminalFdCloseClosedError :
                chengLinuxTerminalFdCloseInvalidEbafd))
    chengLinuxTerminalDecisionWatchProcessCloseReceipts[row] =
        processCloseReceipt
    chengLinuxTerminalDecisionWatchDevices[row] = uint64(0)
    chengLinuxTerminalDecisionWatchInodes[row] = uint64(0)
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        chengLinuxTerminalDecisionWatchFailed)
    return row + 1

# Arm one direct-inode watch and, when present, the already-authenticated
# SEQPACKET channel in one epoll owner. The inode is fstat-joined before and
# after inotify registration; no pathname becomes an identity.
fn cheng_linux_terminal_watch_arm(
        decisionReaderFd: int32,
        socketFd: int32,
        processFd: int32): int32 =
    if decisionReaderFd < 0 || socketFd < -1 || processFd < -1 ||
       (socketFd >= 0 && decisionReaderFd == socketFd) ||
       (processFd >= 0 &&
        (processFd == decisionReaderFd || processFd == socketFd)):
        return -1
    # Rows are append-only. A native atomic fetch-add is the single
    # linearization point shared by live ACTIVATE and restart recovery arms.
    # Failed rows stay terminal and are never recycled, so an int32 handle can
    # never be rebound to another epoll/inotify pair.
    let row = cheng_linux_atomic_fetch_add_i32(
        ptr(&chengLinuxTerminalDecisionWatchNextRow), 1)
    if row < 0 || row >= chengLinuxTerminalDecisionWatchRowCount:
        if processFd >= 0 &&
           cheng_native_terminal_fd_close_once_bridge_export(processFd) != 1:
            cheng_native_fail_stop_bridge_export(
                "terminal watch process close after arena exhaustion failed",
                58,
                70)
        return -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        chengLinuxTerminalDecisionWatchOpening)
    chengLinuxTerminalDecisionWatchEpollFds[row] = -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchEpollCloseStates[row]),
        chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchEpollCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchInotifyFds[row] = -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchInotifyCloseStates[row]),
        chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchInotifyCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchDescriptors[row] = -1
    chengLinuxTerminalDecisionWatchSocketFds[row] = -1
    chengLinuxTerminalDecisionWatchDecisionFds[row] = -1
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchDecisionCloseStates[row]),
        chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchDecisionCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchProcessFds[row] = processFd
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchProcessCloseStates[row]),
        processFd >= 0 ? chengLinuxTerminalFdCloseOpen :
            chengLinuxTerminalFdCloseNotPresent)
    chengLinuxTerminalDecisionWatchProcessCloseReceipts[row] = 0
    chengLinuxTerminalDecisionWatchDevices[row] = uint64(0)
    chengLinuxTerminalDecisionWatchInodes[row] = uint64(0)
    let duplicatedRaw = cheng_linux_syscall3(
        cheng_linux_terminal_fcntl_syscall_number(),
        int64(decisionReaderFd),
        chengLinuxFDupFdCloexec,
        int64(0))
    if duplicatedRaw < int64(0) || duplicatedRaw > int64(2147483647):
        return cheng_linux_terminal_watch_failed_owner(
            row, -1, -1, processFd)
    let watchedDecisionFd = int32(duplicatedRaw)
    chengLinuxTerminalDecisionWatchDecisionFds[row] = watchedDecisionFd
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchDecisionCloseStates[row]),
        chengLinuxTerminalFdCloseOpen)
    var sizeBefore: int64
    var modeBefore: int32
    var deviceBefore: uint64
    var inodeBefore: uint64
    var sizeAfter: int64
    var modeAfter: int32
    var deviceAfter: uint64
    var inodeAfter: uint64
    if libc_fstat_scalars_runtime(
           watchedDecisionFd,
           ptr(&sizeBefore),
           ptr(&modeBefore),
           ptr(&deviceBefore),
           ptr(&inodeBefore)) != 0 ||
       deviceBefore == uint64(0) || inodeBefore == uint64(0):
        return cheng_linux_terminal_watch_failed_owner(
            row, -1, -1, processFd)
    let inotifyFd = libc_inotify_init1_native(
        chengLinuxInCloexec | chengLinuxInNonblock)
    let epollFd = libc_epoll_create1_native(chengLinuxEpollCloexec)
    if inotifyFd >= 0:
        chengLinuxTerminalDecisionWatchInotifyFds[row] = inotifyFd
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchInotifyCloseStates[row]),
            chengLinuxTerminalFdCloseOpen)
    if epollFd >= 0:
        chengLinuxTerminalDecisionWatchEpollFds[row] = epollFd
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchEpollCloseStates[row]),
            chengLinuxTerminalFdCloseOpen)
    var pathBytes: uint8[64]
    let pathOk = cheng_linux_terminal_proc_fd_path_into(
        watchedDecisionFd, ptr(&pathBytes), 64)
    var watchDescriptor: int32 = -1
    if inotifyFd >= 0 && epollFd >= 0 && pathOk:
        watchDescriptor = libc_inotify_add_watch_native(
            inotifyFd,
            ptr(&pathBytes),
            chengLinuxInModify | chengLinuxInAttrib |
            chengLinuxInCloseWrite | chengLinuxInDeleteSelf |
            chengLinuxInMoveSelf | chengLinuxInUnmount)
    var inotifyEvent: ChengLinuxTerminalEpollEvent
    var socketEvent: ChengLinuxTerminalEpollEvent
    var processEvent: ChengLinuxTerminalEpollEvent
    cheng_linux_terminal_epoll_event_build(
        inotifyEvent,
        chengLinuxEpollIn | chengLinuxEpollErr | chengLinuxEpollHup,
        uint64(1))
    cheng_linux_terminal_epoll_event_build(
        socketEvent,
        chengLinuxEpollIn | chengLinuxEpollErr | chengLinuxEpollHup,
        uint64(2))
    cheng_linux_terminal_epoll_event_build(
        processEvent,
        chengLinuxEpollIn | chengLinuxEpollErr | chengLinuxEpollHup,
        uint64(3))
    let socketRegistered = socketFd < 0 ||
        libc_epoll_ctl_native(
            epollFd,
            chengLinuxEpollCtlAdd,
            socketFd,
            ptr(&socketEvent)) == 0
    let processRegistered = processFd < 0 ||
        libc_epoll_ctl_native(
            epollFd,
            chengLinuxEpollCtlAdd,
            processFd,
            ptr(&processEvent)) == 0
    let armed = watchDescriptor >= 0 &&
        libc_fstat_scalars_runtime(
            watchedDecisionFd,
            ptr(&sizeAfter),
            ptr(&modeAfter),
            ptr(&deviceAfter),
            ptr(&inodeAfter)) == 0 &&
        sizeAfter == sizeBefore && modeAfter == modeBefore &&
        deviceAfter == deviceBefore && inodeAfter == inodeBefore &&
        libc_epoll_ctl_native(
            epollFd,
            chengLinuxEpollCtlAdd,
            inotifyFd,
            ptr(&inotifyEvent)) == 0 && socketRegistered &&
        processRegistered
    if !armed:
        return cheng_linux_terminal_watch_failed_owner(
            row, epollFd, inotifyFd, processFd)
    chengLinuxTerminalDecisionWatchEpollFds[row] = epollFd
    chengLinuxTerminalDecisionWatchInotifyFds[row] = inotifyFd
    chengLinuxTerminalDecisionWatchDescriptors[row] = watchDescriptor
    chengLinuxTerminalDecisionWatchSocketFds[row] = socketFd
    chengLinuxTerminalDecisionWatchDecisionFds[row] = watchedDecisionFd
    chengLinuxTerminalDecisionWatchProcessFds[row] = processFd
    chengLinuxTerminalDecisionWatchDevices[row] = deviceBefore
    chengLinuxTerminalDecisionWatchInodes[row] = inodeBefore
    cheng_linux_atomic_store_i32(
        ptr(&chengLinuxTerminalDecisionWatchStates[row]),
        chengLinuxTerminalDecisionWatchIssued)
    return row + 1

@exportc("cheng_native_terminal_decision_watch_arm_bridge")
@abi_internal
fn cheng_native_terminal_decision_watch_arm_bridge_export(
        decisionReaderFd: int32,
        socketFd: int32): int32 =
    if socketFd < 0:
        return -1
    return cheng_linux_terminal_watch_arm(
        decisionReaderFd, socketFd, -1)

@exportc("cheng_native_terminal_finished_watch_arm_bridge")
@abi_internal
fn cheng_native_terminal_finished_watch_arm_bridge_export(
        finishedReaderFd: int32): int32 =
    return cheng_linux_terminal_watch_arm(finishedReaderFd, -1, -1)

@exportc("cheng_native_terminal_finished_recovery_watch_arm_bridge")
@abi_internal
fn cheng_native_terminal_finished_recovery_watch_arm_bridge_export(
        finishedReaderFd: int32,
        childPid: int32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64): int32 =
    if finishedReaderFd < 0 || childPid <= 0 ||
       childBirthPlatform != 2 || childBirth0 == uint64(0) ||
       childBirth1 != uint64(0):
        return -1
    var observedBefore: uint64
    var stateBefore: int32
    if !cheng_linux_terminal_child_identity_into(
           childPid, ptr(&observedBefore), ptr(&stateBefore)) ||
       observedBefore != childBirth0 ||
       cheng_linux_terminal_process_state(stateBefore) != 1:
        return -2
    let rawPidfd = cheng_linux_syscall2(
        int64(434), int64(childPid), int64(0))
    if rawPidfd < int64(0) || rawPidfd > int64(2147483647):
        return -2
    let pidfd = int32(rawPidfd)
    var observedAfterOpen: uint64
    var stateAfterOpen: int32
    if !cheng_linux_terminal_child_identity_into(
           childPid, ptr(&observedAfterOpen), ptr(&stateAfterOpen)) ||
       observedAfterOpen != childBirth0 ||
       cheng_linux_terminal_process_state(stateAfterOpen) != 1:
        let pidfdCloseReceipt =
            cheng_native_terminal_fd_close_once_bridge_export(pidfd)
        if pidfdCloseReceipt == 1:
            return -2
        return cheng_linux_terminal_watch_retain_failed_process(
            -1, pidfdCloseReceipt)
    let owner = cheng_linux_terminal_watch_arm(
        finishedReaderFd, -1, pidfd)
    if owner <= 0:
        return -1
    var observedAfterArm: uint64
    var stateAfterArm: int32
    let exactAfterArm = cheng_linux_terminal_child_identity_into(
        childPid, ptr(&observedAfterArm), ptr(&stateAfterArm)) &&
        observedAfterArm == childBirth0 &&
        cheng_linux_terminal_process_state(stateAfterArm) == 1
    if !exactAfterArm:
        let row = owner - 1
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchFailed)
    return owner

# Result: 1=socket readable, 2=inode changed, 4=socket disconnected. Any
# malformed queue event or inode anomaly is a hard negative result.
@exportc("cheng_native_terminal_event_wait_bridge")
@abi_internal
fn cheng_native_terminal_event_wait_bridge_export(
        watchOwner: int32): int32 =
    let row = watchOwner - 1
    if row < 0 || row >= chengLinuxTerminalDecisionWatchRowCount ||
       cheng_linux_atomic_cas_i32(
           ptr(&chengLinuxTerminalDecisionWatchStates[row]),
           chengLinuxTerminalDecisionWatchIssued,
           chengLinuxTerminalDecisionWatchWaiting) != 1:
        return -1
    var event: ChengLinuxTerminalEpollEvent
    let eventCount = libc_epoll_wait_native(
        chengLinuxTerminalDecisionWatchEpollFds[row],
        ptr(&event),
        1,
        -1)
    if eventCount != 1:
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchFailed)
        return -1
    let flags = cheng_linux_terminal_epoll_event_flags(event)
    let token = cheng_linux_terminal_epoll_event_token(event)
    if token == uint64(2):
        if (flags & chengLinuxEpollIn) != uint32(0):
            cheng_linux_atomic_store_i32(
                ptr(&chengLinuxTerminalDecisionWatchStates[row]),
                chengLinuxTerminalDecisionWatchIssued)
            return 1
        if (flags & (chengLinuxEpollErr | chengLinuxEpollHup)) !=
               uint32(0):
            let removedSocket = libc_epoll_ctl_native(
                chengLinuxTerminalDecisionWatchEpollFds[row],
                chengLinuxEpollCtlDel,
                chengLinuxTerminalDecisionWatchSocketFds[row],
                nil)
            if removedSocket != 0:
                cheng_linux_atomic_store_i32(
                    ptr(&chengLinuxTerminalDecisionWatchStates[row]),
                    chengLinuxTerminalDecisionWatchFailed)
                return -1
            cheng_linux_atomic_store_i32(
                ptr(&chengLinuxTerminalDecisionWatchStates[row]),
                chengLinuxTerminalDecisionWatchIssued)
            return 4
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchFailed)
        return -1
    if token == uint64(3):
        if (flags & (chengLinuxEpollIn | chengLinuxEpollErr |
                     chengLinuxEpollHup)) == uint32(0):
            cheng_linux_atomic_store_i32(
                ptr(&chengLinuxTerminalDecisionWatchStates[row]),
                chengLinuxTerminalDecisionWatchFailed)
            return -1
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchIssued)
        return 8
    if token != uint64(1) ||
       (flags & (chengLinuxEpollErr | chengLinuxEpollHup)) != uint32(0):
        cheng_linux_atomic_store_i32(
            ptr(&chengLinuxTerminalDecisionWatchStates[row]),
            chengLinuxTerminalDecisionWatchFailed)
