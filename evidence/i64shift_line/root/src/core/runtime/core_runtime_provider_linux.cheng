        return 0
    return ts.tv_sec

@exportc("cheng_epoch_time_ms")
fn cheng_epoch_time_ms_export(): int64 =
    var ts: ChengLinuxTimespec
    let rc: int64 = cheng_linux_syscall2(chengLinuxSysClockGetTime,
                                        chengLinuxClockRealtime,
                                        cheng_ptr_arg(&ts))
    if cheng_linux_syscall_failed(rc):
        return 0
    return ts.tv_sec * int64(1000) + ts.tv_nsec / int64(1000000)

@exportc("libc_getenv")
fn libc_getenv_export(name: ptr): ptr =
    if name == nil:
        return nil
    let nameLen: int32 = cheng_cstrlen_raw(name)
    if nameLen <= 0:
        return nil
    let envBuf: ptr = cheng_runtime_malloc(65536)
    if envBuf == nil:
        return nil
    let fd: int32 = cheng_linux_syscall_i32(cheng_linux_syscall4(chengLinuxSysOpenAt,
                                                                 chengLinuxAtFdcwd,
                                                                 cheng_ptr_arg("/proc/self/environ"),
                                                                 int64(chengLinuxORdonly),
                                                                 0))
    if fd < 0:
        return nil
    let got: int64 = cheng_linux_syscall_i64(cheng_linux_syscall3(chengLinuxSysRead,
                                                                  int64(fd),
                                                                  cheng_ptr_arg(envBuf),
                                                                  65535))
    let _ = cheng_linux_syscall_i32(cheng_linux_syscall1(chengLinuxSysClose, int64(fd)))
    if got <= 0:
        return nil
    var total: int32 = int32(got)
    if total >= 65536:
        total = 65535
    cheng_bytes_set(cheng_ptr_plus(envBuf, total), 0, 1)
    var start: int32
    var i: int32
    while i < total:
        if *(UInt8Ptr(cheng_ptr_plus(envBuf, i))) == uint8(0):
            let entry: ptr = cheng_ptr_plus(envBuf, start)
            if cheng_linux_env_name_matches(entry, name, nameLen):
                return cheng_ptr_plus(entry, nameLen + 1)
            start = i + 1
        i = i + 1
    if start < total:
        let entry: ptr = cheng_ptr_plus(envBuf, start)
        if cheng_linux_env_name_matches(entry, name, nameLen):
            return cheng_ptr_plus(entry, nameLen + 1)
    return nil

