import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_paint_runtime as paint
import cheng/core/runtime/web_raster_runtime as raster

const
    WebTextDefaultCharWidth = 8
    WebTextDefaultLineHeight = 16
    WebTextMaxInt32 = 2147483647

type
    WebTextMetrics =
        charWidth: int32
        lineHeight: int32

    WebTextDisplayItem =
        nodeId: int32
        charIndex: int32
        charCode: int32
        x: int32
        y: int32
        width: int32
        height: int32
        fillColor: int32
        drawsInk: bool

    WebTextDisplayList =
        items: WebTextDisplayItem[]

    WebTextRasterWitness =
        width: int32
        height: int32
        pixelCount: int32
        inkPixelCount: int32
        colorSum: int64
        positionWeightedSum: int64

fn WebTextMetricsInit(metrics: var WebTextMetrics, charWidth: int32, lineHeight: int32): bool =
    metrics.charWidth = 0
    metrics.lineHeight = 0
    if charWidth <= 0 || lineHeight <= 0:
        return false
    metrics.charWidth = charWidth
    metrics.lineHeight = lineHeight
    return true

fn WebTextDefaultMetrics(metrics: var WebTextMetrics) =
    metrics.charWidth = WebTextDefaultCharWidth
    metrics.lineHeight = WebTextDefaultLineHeight

fn WebTextDisplayListInit(list: var WebTextDisplayList) =
    list.items = []

fn WebTextRasterWitnessInit(witness: var WebTextRasterWitness) =
    witness.width = 0
    witness.height = 0
    witness.pixelCount = 0
    witness.inkPixelCount = 0
    witness.colorSum = int64(0)
    witness.positionWeightedSum = int64(0)

fn WebTextIsSupportedAsciiChar(ch: char): bool =
    return ch >= ' ' && ch <= '~'

fn WebTextValidateSource(text: str): bool =
    if text.len <= 0:
        return false
    for i in 0..<text.len:
        if !WebTextIsSupportedAsciiChar(text[i]):
            return false
    return true

fn WebTextMeasure(text: str,
                  metrics: var WebTextMetrics,
                  outWidth: var int32,
                  outHeight: var int32,
                  outCharCount: var int32): bool =
    outWidth = 0
    outHeight = 0
    outCharCount = 0
    if metrics.charWidth <= 0 || metrics.lineHeight <= 0:
        return false
    if !WebTextValidateSource(text):
        return false
    outCharCount = text.len
    let width64 = int64(text.len) * int64(metrics.charWidth)
    if width64 <= int64(0) || width64 > int64(WebTextMaxInt32):
        outCharCount = 0
        return false
    outWidth = int32(width64)
    outHeight = metrics.lineHeight
    return true

fn WebTextAppendLayoutStyle(tree: var layout.WebLayoutTree,
                            nodeId: int32,
                            display: int32,
                            width: int32,
                            height: int32,
                            marginLeft: int32,
                            marginTop: int32): bool =
    if nodeId <= 0:
        return false
    if !layout.WebLayoutStyleSupported(display, width, height, marginLeft, marginTop):
        return false
    var style: layout.WebLayoutStyleBox
    style.nodeId = nodeId
    style.display = display
    style.width = width
    style.height = height
    style.marginLeft = marginLeft
    style.marginTop = marginTop
    add(tree.styles, style)
    if tree.rootNodeId == 0:
        tree.rootNodeId = nodeId
    if nodeId >= tree.nextNodeId:
        tree.nextNodeId = nodeId + 1
    return true

fn WebTextBuildTextNodeLayout(document: var web.WebDocument,
                              textNodeId: int32,
                              x: int32,
                              y: int32,
                              metrics: var WebTextMetrics,
                              tree: var layout.WebLayoutTree): bool =
    layout.WebLayoutTreeInit(tree)
    if web.WebDocumentNodeKind(document, textNodeId) != web.WebNodeKindText:
        return false

    var source: str
    if !web.WebDocumentNodeTextContent(document, textNodeId, source):
        return false

    var width = 0
    var height = 0
    var charCount = 0
    if !WebTextMeasure(source, metrics, width, height, charCount):
        return false
    if x < 0 || y < 0:
        return false
    if int64(x) + int64(width) > int64(WebTextMaxInt32):
        return false
    if int64(y) + int64(height) > int64(WebTextMaxInt32):
        return false

    if !WebTextAppendLayoutStyle(tree, textNodeId, layout.WebLayoutDisplayBlock, width, height, x, y):
        layout.WebLayoutTreeInit(tree)
        return false
    if !layout.WebLayoutCompute(tree, textNodeId):
        layout.WebLayoutTreeInit(tree)
        return false
    return true

fn WebTextDisplayItemCount(list: var WebTextDisplayList): int32 =
    return list.items.len

fn WebTextDisplayItemCharCodeAt(list: var WebTextDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].charCode

fn WebTextDisplayItemXAt(list: var WebTextDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].x

fn WebTextDisplayItemYAt(list: var WebTextDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].y

fn WebTextDisplayItemDrawsInkAt(list: var WebTextDisplayList, index: int32): bool =
    if index < 0 || index >= list.items.len:
        return false
    return list.items[index].drawsInk

fn WebTextBuildDisplayItems(document: var web.WebDocument,
                            tree: var layout.WebLayoutTree,
                            metrics: var WebTextMetrics,
                            fillColor: int32,
                            list: var WebTextDisplayList): bool =
    list.items = []
    if metrics.charWidth <= 0 || metrics.lineHeight <= 0:
        return false
    if tree.boxes.len <= 0:
        return false

    for boxIndex in 0..<tree.boxes.len:
        let box = tree.boxes[boxIndex]
        if box.x < 0 || box.y < 0 || box.width <= 0 || box.height <= 0:
            list.items = []
            return false
        if int64(box.x) + int64(box.width) > int64(WebTextMaxInt32):
            list.items = []
            return false
        if int64(box.y) + int64(box.height) > int64(WebTextMaxInt32):
            list.items = []
            return false
        if web.WebDocumentNodeKind(document, box.nodeId) != web.WebNodeKindText:
            list.items = []
            return false

        var source: str
        if !web.WebDocumentNodeTextContent(document, box.nodeId, source):
            list.items = []
            return false

        var measuredWidth = 0
        var measuredHeight = 0
        var charCount = 0
        if !WebTextMeasure(source, metrics, measuredWidth, measuredHeight, charCount):
            list.items = []
            return false
        if measuredWidth != box.width || measuredHeight != box.height:
            list.items = []
            return false

        for charIndex in 0..<source.len:
            let ch = source[charIndex]
            let itemX64 = int64(box.x) + int64(charIndex) * int64(metrics.charWidth)
            if itemX64 > int64(WebTextMaxInt32):
                list.items = []
                return false
            var item: WebTextDisplayItem
            item.nodeId = box.nodeId
            item.charIndex = charIndex
            item.charCode = int32(ch)
            item.x = int32(itemX64)
            item.y = box.y
            item.width = metrics.charWidth
            item.height = metrics.lineHeight
            item.fillColor = fillColor
            item.drawsInk = ch != ' '
            add(list.items, item)
    if list.items.len <= 0:
        return false
    return true

fn WebTextBuildPaintDisplayList(list: var WebTextDisplayList, paintList: var paint.WebPaintDisplayList): bool =
    paint.WebPaintDisplayListInit(paintList)
    if list.items.len <= 0:
        return false
    var itemCount: int32
    itemCount = list.items.len
    for i in 0..<itemCount:
        let item = list.items[i]
        if item.x < 0 || item.y < 0 || item.width <= 0 || item.height <= 0:
            paintList.items = []
            return false
        if int64(item.x) + int64(item.width) > int64(WebTextMaxInt32):
            paintList.items = []
            return false
        if int64(item.y) + int64(item.height) > int64(WebTextMaxInt32):
            paintList.items = []
            return false
        if item.drawsInk:
            var rect: paint.WebPaintRectItem
            rect.nodeId = item.nodeId
            rect.x = item.x
            rect.y = item.y
            rect.width = item.width
            rect.height = item.height
            rect.fillColor = item.fillColor
            add(paintList.items, rect)
    return true

fn WebTextComputeRasterWitness(surface: var raster.WebRasterSurface,
                               clearColor: int32,
                               witness: var WebTextRasterWitness): bool =
    WebTextRasterWitnessInit(witness)
    if surface.width <= 0 || surface.height <= 0:
        return false
    let pixelCount64 = int64(surface.width) * int64(surface.height)
    if pixelCount64 > int64(WebTextMaxInt32):
        return false
    let pixelCount = int32(pixelCount64)
    if pixelCount != surface.pixels.len:
        return false
    witness.width = surface.width
    witness.height = surface.height
    witness.pixelCount = pixelCount
    for i in 0..<surface.pixels.len:
        let pixel = surface.pixels[i]
        if pixel != clearColor:
            witness.inkPixelCount = witness.inkPixelCount + 1
            witness.colorSum = witness.colorSum + int64(pixel)
            witness.positionWeightedSum = witness.positionWeightedSum + int64(i + 1) * int64(pixel)
    return true

fn WebTextRasterizeDisplayItems(list: var WebTextDisplayList,
                                width: int32,
                                height: int32,
                                clearColor: int32,
                                surface: var raster.WebRasterSurface,
                                witness: var WebTextRasterWitness): bool =
    WebTextRasterWitnessInit(witness)
    let itemCount = list.items.len
    for i in 0..<itemCount:
        let item = list.items[i]
        if item.drawsInk && item.fillColor == clearColor:
            return false

    var paintList: paint.WebPaintDisplayList
    if !WebTextBuildPaintDisplayList(list, paintList):
        return false
    if !raster.WebRasterRasterizeDisplayList(paintList, width, height, clearColor, surface):
        return false
    return WebTextComputeRasterWitness(surface, clearColor, witness)
