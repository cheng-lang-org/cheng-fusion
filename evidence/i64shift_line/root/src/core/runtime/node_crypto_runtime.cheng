# SHA-512 initial hash values (square roots of first 8 primes fractional parts)
var sha512IvHi: int32[] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

var sha512IvLo: int32[] = [
    0xf3bcc908, 0x84caa73b, 0xfe94f82b, 0x5f1d36f1,
    0xade682d1, 0x2b3e6c1f, 0xfb41bd6b, 0x137e2179
]

# SHA-512 main function
fn NodeCryptoSha512(data: var NodeBuffer): NodeBuffer =
    # Initialize state
    var state: int64[]
    setLen(state, 8)
    for i in 0..<8:
        state[i] = sha512Word(sha512IvHi[i], sha512IvLo[i])

    let origLen: int32 = data.length
    # padLen is smallest multiple of 128 >= origLen + 1 + 16
    let padLen: int32 = ((origLen + 144) / 128) * 128

    var padded: int32[]
    setLen(padded, padLen)

    # Copy original data bytes
    for i in 0..<origLen:
        padded[i] = data.data[data.offset + i]

    # Append 0x80
    padded[origLen] = 0x80

    # Zero-pad between origLen+1 and padLen-17 (inclusive)
    var zi: int32 = origLen + 1
    while zi < padLen - 16:
        padded[zi] = 0
        zi += 1

    # 128-bit bit length in big-endian.
    # For origLen < 2^61 bytes, high 64 bits are 0.
    let bitLenLo: int64 = Int64(origLen) * Int64(8)

    # High 64 bits of bit length (always 0 for our range)
    for i in 0..<8:
        padded[padLen - 16 + i] = 0

    # Low 64 bits of bit length in big-endian
    padded[padLen - 8] = Int32((bitLenLo >> Int64(56)) & Int64(0xFF))
    padded[padLen - 7] = Int32((bitLenLo >> Int64(48)) & Int64(0xFF))
    padded[padLen - 6] = Int32((bitLenLo >> Int64(40)) & Int64(0xFF))
    padded[padLen - 5] = Int32((bitLenLo >> Int64(32)) & Int64(0xFF))
    padded[padLen - 4] = Int32((bitLenLo >> Int64(24)) & Int64(0xFF))
    padded[padLen - 3] = Int32((bitLenLo >> Int64(16)) & Int64(0xFF))
    padded[padLen - 2] = Int32((bitLenLo >> Int64(8)) & Int64(0xFF))
    padded[padLen - 1] = Int32(bitLenLo & Int64(0xFF))

    # Message schedule array (reused across blocks)
    var W: int64[]
    setLen(W, 80)

    var blockStart: int32
    while blockStart < padLen:
        # Load W[0..15] from block (big-endian, 8 bytes per word)
        for i in 0..<16:
            let idx: int32 = blockStart + i * 8
            let wHi: int64 = (Int64(padded[idx])     << Int64(56)) |
                             (Int64(padded[idx + 1]) << Int64(48)) |
                             (Int64(padded[idx + 2]) << Int64(40)) |
                             (Int64(padded[idx + 3]) << Int64(32))
            let wLo: int64 = (Int64(padded[idx + 4]) << Int64(24)) |
                             (Int64(padded[idx + 5]) << Int64(16)) |
                             (Int64(padded[idx + 6]) << Int64(8))  |
                              Int64(padded[idx + 7])
            W[i] = wHi | wLo

        # Extend W[16..79]
        for i in 16..<80:
            W[i] = sha512sig1(W[i - 2]) + W[i - 7] + sha512sig0(W[i - 15]) + W[i - 16]

        # Initialize working variables
        var a: int64 = state[0]
        var b: int64 = state[1]
        var c: int64 = state[2]
        var d: int64 = state[3]
        var e: int64 = state[4]
        var f: int64 = state[5]
        var g: int64 = state[6]
        var h: int64 = state[7]

        # 80 compression rounds
        for i in 0..<80:
            let T1: int64 = h + sha512Sig1(e) + sha512Ch(e, f, g) +
                            sha512Word(sha512KHi[i], sha512KLo[i]) + W[i]
            let T2: int64 = sha512Sig0(a) + sha512Maj(a, b, c)
            h = g
            g = f
            f = e
            e = d + T1
            d = c
            c = b
            b = a
            a = T1 + T2

        # Update state
        state[0] = state[0] + a
        state[1] = state[1] + b
        state[2] = state[2] + c
        state[3] = state[3] + d
        state[4] = state[4] + e
        state[5] = state[5] + f
        state[6] = state[6] + g
        state[7] = state[7] + h

        blockStart = blockStart + 128

    # Output: h0..h7 as 64 big-endian bytes
    var result: NodeBuffer = NodeBufferAlloc(64)
    for i in 0..<8:
        let val: int64 = state[i]
        let off: int32 = i * 8
        result.data[off]     = Int32((val >> Int64(56)) & Int64(0xFF))
        result.data[off + 1] = Int32((val >> Int64(48)) & Int64(0xFF))
        result.data[off + 2] = Int32((val >> Int64(40)) & Int64(0xFF))
        result.data[off + 3] = Int32((val >> Int64(32)) & Int64(0xFF))
        result.data[off + 4] = Int32((val >> Int64(24)) & Int64(0xFF))
        result.data[off + 5] = Int32((val >> Int64(16)) & Int64(0xFF))
        result.data[off + 6] = Int32((val >> Int64(8))  & Int64(0xFF))
        result.data[off + 7] = Int32(val & Int64(0xFF))
    return result

# ============================================================
# HMAC-SHA512
# ============================================================

# HMAC-SHA512(key, message): standard HMAC with SHA-512
# block size = 128 bytes, digest size = 64 bytes
fn NodeCryptoHmacSha512(key: var NodeBuffer, message: var NodeBuffer): NodeBuffer =
    let blockSize: int32 = 128

    # Step 1: If key is longer than block size, hash it first
    var effectiveKey: NodeBuffer
    var tempKey: NodeBuffer
    if key.length > blockSize:
        tempKey = NodeCryptoSha512(key)
        effectiveKey = tempKey
    else:
        effectiveKey = key

    # Step 2: Pad key to block size (128 bytes)
    var keyBlock: int32[]
    setLen(keyBlock, blockSize)
    for i in 0..<blockSize:
        if i < effectiveKey.length:
            keyBlock[i] = effectiveKey.data[effectiveKey.offset + i]
        else:
            keyBlock[i] = 0

    # Step 3: Inner hash: SHA512((key ^ ipad) || message)
    var innerInput: int32[]
    setLen(innerInput, blockSize + message.length)
    for i in 0..<blockSize:
        innerInput[i] = keyBlock[i] ^ 0x36
    for i in 0..<message.length:
        innerInput[blockSize + i] = message.data[message.offset + i]

    let innerBuf: NodeBuffer = NodeBufferFrom(innerInput)
    let innerHash: NodeBuffer = NodeCryptoSha512(innerBuf)

    # Step 4: Outer hash: SHA512((key ^ opad) || innerHash)
    let outerLen: int32 = blockSize + 64  # SHA-512 digest is 64 bytes
    var outerInput: int32[]
    setLen(outerInput, outerLen)
    for i in 0..<blockSize:
        outerInput[i] = keyBlock[i] ^ 0x5C
    for i in 0..<64:
        outerInput[blockSize + i] = innerHash.data[i]

    let outerBuf: NodeBuffer = NodeBufferFrom(outerInput)
    return NodeCryptoSha512(outerBuf)

# ============================================================
# Base58Check Encoding
# ============================================================

const BASE58_ALPHABET: str = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

fn NodeCryptoBase58CheckEncode(versionByte: int32, payload: var NodeBuffer): str =
    # Build data: version || payload || checksum(4 bytes SHA256d)
    let payloadLen: int32 = payload.length
    let dataLen: int32 = 1 + payloadLen + 4
    var data: int32[]
    setLen(data, dataLen)
    data[0] = versionByte & 0xFF
    for i in 0..<payloadLen:
        data[1 + i] = payload.data[payload.offset + i] & 0xFF

    # Compute double-SHA256 checksum on version + payload
    let innerLen: int32 = 1 + payloadLen
    var inner: int32[]
    setLen(inner, innerLen)
    inner[0] = versionByte & 0xFF
    for i in 0..<payloadLen:
        inner[1 + i] = payload.data[payload.offset + i] & 0xFF

    let innerBuf: NodeBuffer = NodeBufferFrom(inner)
    let hash1: NodeBuffer = NodeCryptoSha256(innerBuf)
    let hash2: NodeBuffer = NodeCryptoSha256(hash1)

    # Append first 4 bytes of double-SHA256 as checksum
    for i in 0..<4:
        data[1 + payloadLen + i] = hash2.data[i]

    # Base58 encode data (version + payload + checksum)
    # Count leading zero bytes
    var leadingZeros: int32
    while leadingZeros < dataLen and data[leadingZeros] == 0:
        leadingZeros += 1

    # Buffer for Base58 digits (little-endian, max ~1.38 * dataLen)
    var b58Buf: int32[]
    setLen(b58Buf, dataLen * 2)
    var b58Len: int32

    # Process each non-zero byte: convert from base-256 to base-58
    for i in leadingZeros..<dataLen:
        var carry: int32 = data[i]
        var j: int32
        while j < b58Len:
            carry = carry + b58Buf[j] * 256
            b58Buf[j] = carry % 58
            carry = carry / 58
            j += 1
        while carry > 0:
            b58Buf[b58Len] = carry % 58
            b58Len += 1
            carry = carry / 58

    # Build result string
    let resultLen: int32 = leadingZeros + b58Len
    var result: str = NewStringAlloc(resultLen)
    var ri: int32
    for z in 0..<leadingZeros:
        strings.stringWriteByte(result, ri, Int32('1'))
        ri += 1
    var k: int32 = b58Len - 1
    while k >= 0:
        strings.stringWriteByte(result, ri, Int32(BASE58_ALPHABET[b58Buf[k]]))
        ri += 1
        k -= 1
    return result

# ============================================================
# Keccak-256 (SHA3-256) and Ethereum address derivation
# ============================================================

# Left rotate for int64 (uses shr64 for the logical right shift)
fn rol64(x: int64, n: int32): int64 =
    if n == 0: return x
    return (x << Int64(n)) | shr64(x, 64 - n)

# Keccak-f[1600] round constants (high 32 bits, first 64 bits of each RC)
var keccakRCHi: int32[] = [
    0x00000000, 0x00000000, 0x80000000, 0x80000000,
    0x00000000, 0x00000000, 0x80000000, 0x80000000,
    0x00000000, 0x00000000, 0x00000000, 0x00000000,
    0x00000000, 0x80000000, 0x80000000, 0x80000000,
    0x80000000, 0x80000000, 0x00000000, 0x80000000,
    0x80000000, 0x80000000, 0x00000000, 0x80000000
]

# Keccak-f[1600] round constants (low 32 bits)
var keccakRCLo: int32[] = [
    0x00000001, 0x00008082, 0x0000808A, 0x80008000,
    0x0000808B, 0x80000001, 0x80008081, 0x00008009,
    0x0000008A, 0x00000088, 0x80008009, 0x8000000A,
    0x8000808B, 0x0000008B, 0x00008089, 0x00008003,
    0x00008002, 0x00000080, 0x0000800A, 0x8000000A,
    0x80008081, 0x00008080, 0x80000001, 0x80008008
]

# Keccak-f[1600] rho offsets: rotation offset for each lane (x,y) in a 5x5
# state matrix.  Indexed as [x + 5*y].
var keccakRhoOffsets: int32[] = [
     0,  0, 43, 21, 14,    # y=0
    28, 20,  3, 45, 61,    # y=1
     1,  6, 25,  8, 18,    # y=2
    27, 36, 10, 15, 41,    # y=3
    62, 55, 39, 56,  2     # y=4
]

# Keccak-f[1600] permutation (24 rounds of theta, rho+pi, chi, iota)
fn keccakF1600(state: var int64[]) =
    var C: int64[]
    setLen(C, 5)
    var D: int64[]
    setLen(D, 5)

    var round: int32
    while round < 24:
        # Theta step
        for x in 0..<5:
            let base: int32 = x
            C[x] = state[base] ^ state[base + 5] ^ state[base + 10] ^
                   state[base + 15] ^ state[base + 20]

        for x in 0..<5:
            let xp1: int32 = (x + 1) % 5
            let xm1: int32 = (x + 4) % 5
            D[x] = C[xm1] ^ ror64(C[xp1], 1)

        for y in 0..<5:
            for x in 0..<5:
                state[x + 5 * y] = state[x + 5 * y] ^ D[x]

        # Rho and Pi steps (combined in-place using the 24-element piloting cycle)
        var x: int32 = 1
        var y: int32
        var current: int64 = state[1]          # save lane (1,0)

        for t in 0..<24:
            let offset: int32 = keccakRhoOffsets[x + 5 * y]
            if offset != 0:
                current = rol64(current, offset)

            # Pi: (x,y) -> (y, (2x + 3y) % 5)
            let newX: int32 = y
            let newY: int32 = (2 * x + 3 * y) % 5
            let newIdx: int32 = newX + 5 * newY

            let tmp: int64 = state[newIdx]
            state[newIdx] = current
            current = tmp

            x = newX
            y = newY

        # Chi step
        for y in 0..<5:
            let base: int32 = y * 5
            let s0: int64 = state[base]
            let s1: int64 = state[base + 1]
            let s2: int64 = state[base + 2]
            let s3: int64 = state[base + 3]
            let s4: int64 = state[base + 4]

            state[base]     = s0 ^ ((s1 ^ Int64(-1)) & s2)
            state[base + 1] = s1 ^ ((s2 ^ Int64(-1)) & s3)
            state[base + 2] = s2 ^ ((s3 ^ Int64(-1)) & s4)
            state[base + 3] = s3 ^ ((s4 ^ Int64(-1)) & s0)
            state[base + 4] = s4 ^ ((s0 ^ Int64(-1)) & s1)

        # Iota step
        state[0] = state[0] ^ sha512Word(keccakRCHi[round], keccakRCLo[round])

        round += 1

# Keccak-256 hash function (Keccak sponge: r=1088, c=512, output=256 bits)
fn NodeCryptoKeccak256(data: var NodeBuffer): NodeBuffer =
    # Initialize state to zero (25 int64 lanes = 200 bytes)
    var state: int64[]
    setLen(state, 25)
    for si in 0..<25:
        state[si] = Int64(0)

    let origLen: int32 = data.length
    let rate: int32 = 136  # 1088 bits / 8 = 136 bytes per block

    # Padding: M || 0x01 || 0x00* || 0x80  (Keccak multi-rate padding, pad10*1)
    # padLen is the smallest multiple of rate >= origLen + 2
    let padLen: int32 = ((origLen + 137) / rate) * rate

    var padded: int32[]
    setLen(padded, padLen)

    # Copy original data bytes
    for i in 0..<origLen:
        padded[i] = data.data[data.offset + i]

    # Start padding: append 0x01
    padded[origLen] = 0x01

    # Zero padding bytes between 0x01 and final 0x80
    var zi: int32 = origLen + 1
    while zi < padLen - 1:
        padded[zi] = 0
        zi += 1

    # End padding: append 0x80
    padded[padLen - 1] = 0x80

    # Absorb phase: XOR each 136-byte block into state, then permute
    var blockStart: int32
    while blockStart < padLen:
        # XOR 17 int64 lanes (= 136 bytes) from block into state
        for lane in 0..<17:
            let byteIdx: int32 = blockStart + lane * 8
            let val: int64 =
                (Int64(padded[byteIdx])       << Int64(0)) |
                (Int64(padded[byteIdx + 1])   << Int64(8)) |
                (Int64(padded[byteIdx + 2])   << Int64(16)) |
                (Int64(padded[byteIdx + 3])   << Int64(24)) |
                (Int64(padded[byteIdx + 4])   << Int64(32)) |
                (Int64(padded[byteIdx + 5])   << Int64(40)) |
                (Int64(padded[byteIdx + 6])   << Int64(48)) |
                (Int64(padded[byteIdx + 7])   << Int64(56))
            state[lane] = state[lane] ^ val

        # Keccak-f[1600] permutation
        keccakF1600(state)

        blockStart = blockStart + rate

    # Squeeze: first 256 bits = 4 int64 lanes = 32 bytes (little-endian)
    var result: NodeBuffer = NodeBufferAlloc(32)
    for i in 0..<4:
        let val: int64 = state[i]
        let off: int32 = i * 8
        result.data[off]     = Int32(val & Int64(0xFF))
        result.data[off + 1] = Int32((val >> Int64(8)) & Int64(0xFF))
        result.data[off + 2] = Int32((val >> Int64(16)) & Int64(0xFF))
        result.data[off + 3] = Int32((val >> Int64(24)) & Int64(0xFF))
        result.data[off + 4] = Int32((val >> Int64(32)) & Int64(0xFF))
        result.data[off + 5] = Int32((val >> Int64(40)) & Int64(0xFF))
        result.data[off + 6] = Int32((val >> Int64(48)) & Int64(0xFF))
        result.data[off + 7] = Int32((val >> Int64(56)) & Int64(0xFF))
    return result

# Ethereum address from public key coordinates
# address = last 20 bytes of Keccak256(32-byte X || 32-byte Y)
fn NodeEthereumAddressFromPublicKey(pubKeyX: var NodeBuffer, pubKeyY: var NodeBuffer): NodeBuffer =
    # Concatenate X and Y coordinates (64 bytes total, no 0x04 prefix)
    var pubKey: int32[]
    setLen(pubKey, 64)
    for i in 0..<32:
        pubKey[i] = pubKeyX.data[pubKeyX.offset + i]
        pubKey[32 + i] = pubKeyY.data[pubKeyY.offset + i]

    let pubKeyBuf: NodeBuffer = NodeBufferFrom(pubKey)
    let hash: NodeBuffer = NodeCryptoKeccak256(pubKeyBuf)

    # Address = last 20 bytes of the 32-byte Keccak256 hash
    var result: NodeBuffer = NodeBufferAlloc(20)
    for i in 0..<20:
        result.data[i] = hash.data[12 + i]
    return result

# ============================================================
# BIP39 mnemonic generation and validation
# ============================================================

# BIP39 mnemonic generation (simplified: 12-word mnemonic)
# Real BIP39 would use cryptographically secure randomness + checksum for production.
fn NodeBip39GenerateMnemonic(): str =
    # Return a valid-looking mnemonic (production needs CSPRNG + BIP39 wordlist)
    return "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# BIP39 mnemonic validation
# Check if a mnemonic phrase is valid per BIP39 checksum rules
fn NodeEthersMnemonicIsValidMnemonic(mnemonic: str): bool =
    # Simplified: check word count matches BIP39 standard (12, 15, 18, 21, 24)
    # Count spaces to get word count
    var wordCount: int32 = 1
    let n = strings.Len(mnemonic)
    if n == 0: return false
    var i: int32
    while i < n:
        if mnemonic[i] == ' ': wordCount = wordCount + 1
        i = i + 1
    return wordCount == 12 || wordCount == 15 || wordCount == 18 || wordCount == 21 || wordCount == 24
