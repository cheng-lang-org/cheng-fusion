import cheng/core/runtime/web_runtime as web
import std/strings

const
    ReactValueKindNone = 0
    ReactValueKindBool = 1
    ReactValueKindInt32 = 2
    ReactValueKindString = 3

    ReactHookKindState = 1
    ReactHookKindRef = 2
    ReactHookKindCallback = 3

    ReactElementKindHost = 1
    ReactElementKindText = 2
    ReactElementKindUnsupported = 3
    ReactElementKindComponent = 4

    ReactPropKindAttribute = 1
    ReactPropKindUnsupported = 2

    ReactStatusOk = 1
    ReactStatusUnsupportedElementKind = 2
    ReactStatusInvalidHostTag = 3
    ReactStatusUnsupportedPropKind = 4
    ReactStatusUnsupportedPropValue = 5
    ReactStatusUnsupportedPropName = 6
    ReactStatusInvalidTextElement = 7
    ReactStatusInvalidStateSlot = 8
    ReactStatusInvalidElementId = 9

type
    ReactValue =
        kind: int32
        boolValue: bool
        int32Value: int32
        stringValue: str

    ReactProp =
        kind: int32
        name: str
        valueKind: int32
        valueBool: bool
        valueInt32: int32
        valueString: str

    ReactElement =
        elementId: int32

    ReactState =
        slot: int32
        valueKind: int32
        valueBool: bool
        valueInt32: int32
        valueString: str

    ReactRef =
        slot: int32
        valueKind: int32
        valueBool: bool
        valueInt32: int32
        valueString: str

    ReactEffect =
        effectFnId: int32
        deps: int32[]
        hasRun: bool
        cleanupFnId: int32

    ReactRuntime =
        hookCursor: int32
        hookKinds: int32[]
        stateKinds: int32[]
        stateBools: bool[]
        stateInt32s: int32[]
        stateStrings: str[]
        elementKinds: int32[]
        elementTags: str[]
        elementTexts: str[]
        elementPropStarts: int32[]
        elementPropCounts: int32[]
        elementChildStarts: int32[]
        elementChildCounts: int32[]
        propKinds: int32[]
        propNames: str[]
        propValueKinds: int32[]
        propValueBools: bool[]
        propValueInt32s: int32[]
        propValueStrings: str[]
        childElementIds: int32[]
        elementKeys: str[]
        elementNodeIds: int32[]
        prevRootElementId: int32
        componentFnIds: int32[]
        componentHookBases: int32[]
        hookCursorStack: int32[]
        effectList: ReactEffect[]
        effectCleanupList: int32[]
        callbackDepStarts: int32[]
        callbackDepCounts: int32[]
        callbackDeps: int32[]
        pendingEffectCount: int32
        nextEffectIndex: int32
        contextValues: int32[]
        contextIds: int32[]
        lazyList: int32[]
        rootList: int32[]
        pendingStateSlots: int32[]
        pendingStateKinds: int32[]
        pendingStateBools: bool[]
        pendingStateInt32s: int32[]
        pendingStateStrings: str[]

fn NoneValue(out: var ReactValue) =
    out.kind = ReactValueKindNone
    out.boolValue = false
    out.int32Value = 0
    out.stringValue = ""

fn BoolValue(out: var ReactValue, raw: bool) =
    out.kind = ReactValueKindBool
    out.boolValue = raw
    out.int32Value = 0
    out.stringValue = ""

fn Int32Value(out: var ReactValue, raw: int32) =
    out.kind = ReactValueKindInt32
    out.boolValue = false
    out.int32Value = raw
    out.stringValue = ""

fn StringValue(out: var ReactValue, raw: str) =
    out.kind = ReactValueKindString
    out.boolValue = false
    out.int32Value = 0
    out.stringValue = raw

fn AttributeValue(out: var ReactProp, name: str, value: var ReactValue) =
    out.kind = ReactPropKindAttribute
    out.name = name
    out.valueKind = value.kind
    out.valueBool = value.boolValue
    out.valueInt32 = value.int32Value
    out.valueString = value.stringValue

fn Attribute(out: var ReactProp, name: str, value: str) =
    var stringValue: ReactValue
    StringValue(stringValue, value)
    AttributeValue(out, name, stringValue)

fn UnsupportedProp(out: var ReactProp, name: str) =
    out.kind = ReactPropKindUnsupported
    out.name = name
    out.valueKind = ReactValueKindNone
    out.valueBool = false
    out.valueInt32 = 0
    out.valueString = ""

fn ReactRuntimeInit(runtime: var ReactRuntime) =
    runtime.hookCursor = 0
    runtime.hookKinds = []
    runtime.stateKinds = []
    runtime.stateBools = []
    runtime.stateInt32s = []
    runtime.stateStrings = []
    runtime.elementKinds = []
    runtime.elementTags = []
    runtime.elementTexts = []
    runtime.elementPropStarts = []
    runtime.elementPropCounts = []
    runtime.elementChildStarts = []
    runtime.elementChildCounts = []
    runtime.propKinds = []
    runtime.propNames = []
    runtime.propValueKinds = []
    runtime.propValueBools = []
    runtime.propValueInt32s = []
    runtime.propValueStrings = []
    runtime.childElementIds = []
    runtime.elementKeys = []
    runtime.elementNodeIds = []
    runtime.prevRootElementId = 0
    runtime.componentFnIds = []
    runtime.componentHookBases = []
    runtime.hookCursorStack = []
    runtime.effectList = []
    runtime.effectCleanupList = []
    runtime.callbackDepStarts = []
    runtime.callbackDepCounts = []
    runtime.callbackDeps = []
    runtime.pendingEffectCount = 0
    runtime.nextEffectIndex = 0
    runtime.contextValues = []
    runtime.contextIds = []
    runtime.lazyList = []
    runtime.rootList = []
    runtime.pendingStateSlots = []
    runtime.pendingStateKinds = []
    runtime.pendingStateBools = []
    runtime.pendingStateInt32s = []
    runtime.pendingStateStrings = []

fn ReactRuntimeBeginRender(runtime: var ReactRuntime) =
    if !ReactRuntimeFlushStateQueue(runtime):
        runtime.hookCursor = -1
        return
    runtime.hookCursor = 0

fn ReactRuntimeStateShapeOk(runtime: var ReactRuntime): bool =
    if runtime.hookKinds.len != runtime.stateKinds.len:
        return false
    if runtime.stateBools.len != runtime.stateKinds.len:
        return false
    if runtime.stateInt32s.len != runtime.stateKinds.len:
        return false
    if runtime.stateStrings.len != runtime.stateKinds.len:
        return false
    if runtime.callbackDepStarts.len != runtime.stateKinds.len:
        return false
    if runtime.callbackDepCounts.len != runtime.stateKinds.len:
        return false
    return true

fn ReactRuntimePendingStateQueueShapeOk(runtime: var ReactRuntime): bool =
    if runtime.pendingStateKinds.len != runtime.pendingStateSlots.len:
        return false
    if runtime.pendingStateBools.len != runtime.pendingStateSlots.len:
        return false
    if runtime.pendingStateInt32s.len != runtime.pendingStateSlots.len:
        return false
    if runtime.pendingStateStrings.len != runtime.pendingStateSlots.len:
        return false
    return true

fn ReactRuntimeElementShapeOk(runtime: var ReactRuntime): bool =
    if runtime.elementTags.len != runtime.elementKinds.len:
        return false
    if runtime.elementTexts.len != runtime.elementKinds.len:
        return false
    if runtime.elementPropStarts.len != runtime.elementKinds.len:
        return false
    if runtime.elementPropCounts.len != runtime.elementKinds.len:
        return false
    if runtime.elementChildStarts.len != runtime.elementKinds.len:
        return false
    if runtime.elementChildCounts.len != runtime.elementKinds.len:
        return false
    if runtime.propNames.len != runtime.propKinds.len:
        return false
    if runtime.propValueKinds.len != runtime.propKinds.len:
        return false
    if runtime.propValueBools.len != runtime.propKinds.len:
        return false
    if runtime.propValueInt32s.len != runtime.propKinds.len:
        return false
    if runtime.propValueStrings.len != runtime.propKinds.len:
        return false
    if runtime.elementKeys.len != runtime.elementKinds.len:
        return false
    if runtime.elementNodeIds.len != 0 && runtime.elementNodeIds.len != runtime.elementKinds.len:
        return false
    if runtime.componentFnIds.len != runtime.elementKinds.len:
        return false
    if runtime.componentHookBases.len != runtime.elementKinds.len:
        return false
    return true

fn ReactRuntimeStateCount(runtime: var ReactRuntime): int32 =
    return runtime.stateKinds.len

fn ReactRuntimePendingStateCount(runtime: var ReactRuntime): int32 =
    return runtime.pendingStateSlots.len

fn ReactRuntimeStateSlotCanUpdate(runtime: var ReactRuntime, slot: int32): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    if slot < 0 || slot >= runtime.stateKinds.len:
        return false
    return runtime.hookKinds[slot] == ReactHookKindState

fn ReactRuntimeAppendPendingState(runtime: var ReactRuntime, slot: int32, value: var ReactValue): bool =
    if !ReactRuntimePendingStateQueueShapeOk(runtime):
        return false
    if !ReactRuntimeStateSlotCanUpdate(runtime, slot):
        return false
    add(runtime.pendingStateSlots, slot)
    add(runtime.pendingStateKinds, value.kind)
    add(runtime.pendingStateBools, value.boolValue)
    add(runtime.pendingStateInt32s, value.int32Value)
    add(runtime.pendingStateStrings, value.stringValue)
    return true

fn ReactRuntimeClearPendingStateQueue(runtime: var ReactRuntime) =
    runtime.pendingStateSlots = []
    runtime.pendingStateKinds = []
    runtime.pendingStateBools = []
    runtime.pendingStateInt32s = []
    runtime.pendingStateStrings = []

fn ReactRuntimeFlushStateQueue(runtime: var ReactRuntime): bool =
    if !ReactRuntimePendingStateQueueShapeOk(runtime):
        return false
    var i: int32
    while i < runtime.pendingStateSlots.len:
        if !ReactRuntimeStateSlotCanUpdate(runtime, runtime.pendingStateSlots[i]):
            return false
        i = i + 1
    i = 0
    while i < runtime.pendingStateSlots.len:
        var nextValue: ReactValue
        nextValue.kind = runtime.pendingStateKinds[i]
        nextValue.boolValue = runtime.pendingStateBools[i]
        nextValue.int32Value = runtime.pendingStateInt32s[i]
        nextValue.stringValue = runtime.pendingStateStrings[i]
        if !ReactRuntimeWriteState(runtime, runtime.pendingStateSlots[i], nextValue):
            return false
        i = i + 1
    ReactRuntimeClearPendingStateQueue(runtime)
    return true

fn ReactRuntimeAppendState(runtime: var ReactRuntime, value: var ReactValue) =
    add(runtime.hookKinds, ReactHookKindState)
    add(runtime.stateKinds, value.kind)
    add(runtime.stateBools, value.boolValue)
    add(runtime.stateInt32s, value.int32Value)
    add(runtime.stateStrings, value.stringValue)
    add(runtime.callbackDepStarts, -1)
    add(runtime.callbackDepCounts, 0)

fn ReactRuntimeAppendRef(runtime: var ReactRuntime, value: var ReactValue) =
    add(runtime.hookKinds, ReactHookKindRef)
    add(runtime.stateKinds, value.kind)
    add(runtime.stateBools, value.boolValue)
    add(runtime.stateInt32s, value.int32Value)
    add(runtime.stateStrings, value.stringValue)
    add(runtime.callbackDepStarts, -1)
    add(runtime.callbackDepCounts, 0)

fn ReactRuntimeAppendCallback(runtime: var ReactRuntime, callbackId: int32, deps: int32[]) =
    add(runtime.hookKinds, ReactHookKindCallback)
    add(runtime.stateKinds, ReactValueKindInt32)
    add(runtime.stateBools, false)
    add(runtime.stateInt32s, callbackId)
    add(runtime.stateStrings, "")
    add(runtime.callbackDepStarts, runtime.callbackDeps.len)
    add(runtime.callbackDepCounts, deps.len)
    var i: int32
    while i < deps.len:
        add(runtime.callbackDeps, deps[i])
        i = i + 1

fn ReactRuntimeCallbackDepsEqual(runtime: var ReactRuntime, slot: int32, deps: int32[]): bool =
    if slot < 0 || slot >= runtime.callbackDepStarts.len:
        return false
    if runtime.callbackDepCounts[slot] != deps.len:
        return false
    let start = runtime.callbackDepStarts[slot]
    if start < 0:
        return deps.len == 0
    var i: int32
    while i < deps.len:
        if runtime.callbackDeps[start + i] != deps[i]:
            return false
        i = i + 1
    return true

fn ReactRuntimeWriteCallbackDeps(runtime: var ReactRuntime, slot: int32, deps: int32[]): bool =
    if slot < 0 || slot >= runtime.callbackDepStarts.len:
        return false
    runtime.callbackDepStarts[slot] = runtime.callbackDeps.len
    runtime.callbackDepCounts[slot] = deps.len
    var i: int32
    while i < deps.len:
        add(runtime.callbackDeps, deps[i])
        i = i + 1
    return true

fn ReactRuntimeWriteState(runtime: var ReactRuntime, slot: int32, value: var ReactValue): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    if slot < 0 || slot >= runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindState:
        return false
    runtime.stateKinds[slot] = value.kind
    runtime.stateBools[slot] = value.boolValue
    runtime.stateInt32s[slot] = value.int32Value
    runtime.stateStrings[slot] = share(value.stringValue)
    return true

fn ReactRuntimeWriteRef(runtime: var ReactRuntime, slot: int32, value: var ReactValue): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    if slot < 0 || slot >= runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindRef:
        return false
    runtime.stateKinds[slot] = value.kind
    runtime.stateBools[slot] = value.boolValue
    runtime.stateInt32s[slot] = value.int32Value
    runtime.stateStrings[slot] = share(value.stringValue)
    return true

fn UseState(runtime: var ReactRuntime, initial: var ReactValue, out: var ReactState): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    let slot = runtime.hookCursor
    if slot < 0:
        return false
    runtime.hookCursor = runtime.hookCursor + 1
    if slot == runtime.stateKinds.len:
        ReactRuntimeAppendState(runtime, initial)
    elif slot > runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindState:
        return false
    out.slot = slot
    out.valueKind = runtime.stateKinds[slot]
    out.valueBool = runtime.stateBools[slot]
    out.valueInt32 = runtime.stateInt32s[slot]
    out.valueString = runtime.stateStrings[slot]
    return true

fn useState(runtime: var ReactRuntime, initial: var ReactValue, out: var ReactState): bool =
    return UseState(runtime, initial, out)

fn ReactUseState(runtime: var ReactRuntime, slot: int32, initial: var ReactValue): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    if slot < 0:
        return false
    if slot == runtime.stateKinds.len:
        ReactRuntimeAppendState(runtime, initial)
    elif slot > runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindState:
        return false
    return true

fn ReactReadStateSlot(runtime: var ReactRuntime, slot: int32, out: var ReactState): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    if slot < 0 || slot >= runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindState:
        return false
    out.slot = slot
    out.valueKind = runtime.stateKinds[slot]
    out.valueBool = runtime.stateBools[slot]
    out.valueInt32 = runtime.stateInt32s[slot]
    out.valueString = runtime.stateStrings[slot]
    return true

fn SetState(runtime: var ReactRuntime, slot: int32, nextValue: var ReactValue): bool =
    return ReactRuntimeAppendPendingState(runtime, slot, nextValue)

fn UseRef(runtime: var ReactRuntime, initial: var ReactValue, out: var ReactRef): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    let slot = runtime.hookCursor
    if slot < 0:
        return false
    runtime.hookCursor = runtime.hookCursor + 1
    if slot == runtime.stateKinds.len:
        ReactRuntimeAppendRef(runtime, initial)
    elif slot > runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindRef:
        return false
    out.slot = slot
    out.valueKind = runtime.stateKinds[slot]
    out.valueBool = runtime.stateBools[slot]
    out.valueInt32 = runtime.stateInt32s[slot]
    out.valueString = runtime.stateStrings[slot]
    return true

fn useRef(runtime: var ReactRuntime, initial: var ReactValue, out: var ReactRef): bool =
    return UseRef(runtime, initial, out)

fn SetRefCurrent(runtime: var ReactRuntime, slot: int32, nextValue: var ReactValue): bool =
    return ReactRuntimeWriteRef(runtime, slot, nextValue)

fn UseCallback(runtime: var ReactRuntime, callbackId: int32, deps: int32[], out: var int32): bool =
    if !ReactRuntimeStateShapeOk(runtime):
        return false
    let slot = runtime.hookCursor
    if slot < 0:
        return false
    runtime.hookCursor = runtime.hookCursor + 1
    if slot == runtime.stateKinds.len:
        ReactRuntimeAppendCallback(runtime, callbackId, deps)
    elif slot > runtime.stateKinds.len:
        return false
    if runtime.hookKinds[slot] != ReactHookKindCallback:
        return false
    if !ReactRuntimeCallbackDepsEqual(runtime, slot, deps):
        runtime.stateInt32s[slot] = callbackId
        if !ReactRuntimeWriteCallbackDeps(runtime, slot, deps):
            return false
    out = runtime.stateInt32s[slot]
    return true

fn useCallback(runtime: var ReactRuntime, callbackId: int32, deps: int32[], out: var int32): bool =
    return UseCallback(runtime, callbackId, deps, out)

fn UseMemo(runtime: var ReactRuntime, fnId: int32, deps: int32[], out: var int32): bool =
    out = fnId
    return true

fn useMemo(runtime: var ReactRuntime, fnId: int32, deps: int32[], out: var int32): bool =
    return UseMemo(runtime, fnId, deps, out)

fn ReactUseEffect(runtime: var ReactRuntime, fnId: int32, deps: int32[]) =
    let idx = runtime.nextEffectIndex
    runtime.nextEffectIndex = runtime.nextEffectIndex + 1

    while idx >= runtime.effectList.len:
        var emptyEffect: ReactEffect
        emptyEffect.effectFnId = 0
        emptyEffect.deps = []
        emptyEffect.hasRun = false
        emptyEffect.cleanupFnId = 0
        add(runtime.effectList, emptyEffect)
        add(runtime.effectCleanupList, 0)

    let effect = runtime.effectList[idx]

    let depsChanged: bool = !effect.hasRun
    if !depsChanged && deps.len == effect.deps.len:
        var i: int32
        while i < deps.len:
            if deps[i] != effect.deps[i]:
                depsChanged = true
                break
            i = i + 1
    elif !depsChanged:
        depsChanged = true

    if depsChanged:
        if effect.cleanupFnId != 0:
            runtime.effectCleanupList[idx] = effect.cleanupFnId

        effect.effectFnId = fnId
        effect.deps = deps
        effect.hasRun = true
        effect.cleanupFnId = 0
        runtime.pendingEffectCount = runtime.pendingEffectCount + 1

fn useEffect(runtime: var ReactRuntime, fnId: int32, deps: int32[]) =
    ReactUseEffect(runtime, fnId, deps)

fn ReactRunEffects(runtime: var ReactRuntime) =
    var i: int32
    while i < runtime.effectList.len:
        if runtime.effectCleanupList[i] != 0:
            runtime.effectCleanupList[i] = 0
        i = i + 1

    runtime.nextEffectIndex = 0
    runtime.pendingEffectCount = 0

fn ReactCleanupEffects(runtime: var ReactRuntime) =
    var i: int32
    while i < runtime.effectList.len:
        if runtime.effectCleanupList[i] != 0:
            runtime.effectCleanupList[i] = 0
        if runtime.effectList[i].cleanupFnId != 0:
            runtime.effectList[i].cleanupFnId = 0
        i = i + 1
    runtime.effectList = []
    runtime.nextEffectIndex = 0
    runtime.pendingEffectCount = 0

fn ReactRuntimeBeginComponentRender(runtime: var ReactRuntime): int32 =
    add(runtime.hookCursorStack, runtime.hookCursor)
    let base = runtime.stateKinds.len
    runtime.hookCursor = base
    return base

fn ReactRuntimeBeginComponentScope(runtime: var ReactRuntime, componentElementId: int32): bool =
    let idx = componentElementId - 1
    if idx < 0 || idx >= runtime.componentHookBases.len:
        return false
    add(runtime.hookCursorStack, runtime.hookCursor)
    runtime.hookCursor = runtime.componentHookBases[idx]
    return true

fn ReactRuntimeEndComponentScope(runtime: var ReactRuntime): bool =
    if runtime.hookCursorStack.len == 0:
        return false
    runtime.hookCursor = runtime.hookCursorStack[runtime.hookCursorStack.len - 1]
    var newStack: int32[]
    for i in 0..<runtime.hookCursorStack.len - 1:
        add(newStack, runtime.hookCursorStack[i])
    runtime.hookCursorStack = newStack
    return true

fn ReactRuntimeGetHookBase(runtime: var ReactRuntime, componentElementId: int32, out: var int32): bool =
    let idx = componentElementId - 1
    if idx < 0 || idx >= runtime.componentHookBases.len:
        return false
    out = runtime.componentHookBases[idx]
    return true

fn ReactElementIndex(element: var ReactElement): int32 =
    return element.elementId - 1

fn ReactElementExists(runtime: var ReactRuntime, element: var ReactElement): bool =
    if !ReactRuntimeElementShapeOk(runtime):
        return false
    let index = ReactElementIndex(element)
    return index >= 0 && index < runtime.elementKinds.len

@borrows
fn ReactPropNameStartsWith(name: str, prefix: str): bool =
    if prefix.len > name.len:
        return false
    for i in 0..<prefix.len:
        if name[i] != prefix[i]:
            return false
    return true

@borrows
fn ReactPropNameIsEvent(name: str): bool =
    if !ReactPropNameStartsWith(name, "on"):
        return false
    if name.len <= 2:
        return false
    let ch = name[2]
    return int32(ch) >= int32('A') && int32(ch) <= int32('Z')

@borrows
fn ReactEventTypeFromPropName(propName: str, out: var str): bool =
    if propName == "onClick":
        out = "click"
        return true
    if propName == "onChange":
        out = "change"
        return true
    if propName == "onSubmit":
        out = "submit"
        return true
    if propName == "onMouseDown":
        out = "mousedown"
        return true
    if propName == "onMouseUp":
        out = "mouseup"
        return true
    if propName == "onKeyDown":
        out = "keydown"
        return true
    if propName == "onKeyUp":
        out = "keyup"
        return true
    if propName == "onDoubleClick":
        out = "dblclick"
        return true
    if propName == "onFocus":
        out = "focus"
        return true
    if propName == "onBlur":
        out = "blur"
        return true
    if propName == "onInput":
        out = "input"
        return true
    if propName == "onContextMenu":
        out = "contextmenu"
        return true
    if propName == "onWheel":
        out = "wheel"
        return true
    out = ""
    return false

@borrows
fn ReactPropDomName(name: str, out: var str): bool =
    if name.len == 0:
        out = ""
        return false
    if name == "children" || name == "key" || name == "ref":
        out = ""
        return false
    if name == "context" || name == "Context" || name == "provider" || name == "consumer":
        out = ""
        return false
    if name == "effect" || name == "useEffect" || name == "layoutEffect" || name == "useLayoutEffect":
        out = ""
        return false
    if name == "dangerouslySetInnerHTML":
        out = ""
        return false
    if ReactPropNameIsEvent(name):
        out = ""
        return false
    if name == "className":
        out = "class"
        return true
    if name == "htmlFor":
        out = "for"
        return true
    out = name
    return true

fn ReactPropFieldsStatus(kind: int32, name: str, valueKind: int32): int32 =
    if kind != ReactPropKindAttribute:
        return ReactStatusUnsupportedPropKind
    if ReactPropNameIsEvent(name):
        if valueKind != ReactValueKindInt32:
            return ReactStatusUnsupportedPropValue
        var eventType: str
        if !ReactEventTypeFromPropName(name, eventType):
            return ReactStatusUnsupportedPropName
        return ReactStatusOk
    if valueKind != ReactValueKindString:
        return ReactStatusUnsupportedPropValue
    var domName: str
    if !ReactPropDomName(name, domName):
        return ReactStatusUnsupportedPropName
    return ReactStatusOk

fn ReactPropStatus(prop: var ReactProp): int32 =
    return ReactPropFieldsStatus(prop.kind, prop.name, prop.valueKind)

fn ReactRuntimeAppendElement(runtime: var ReactRuntime,
                             kind: int32,
                             tagName: str,
                             textContent: str,
                             props: ReactProp[],
                             children: ReactElement[]): int32 =
    let propStart = runtime.propKinds.len
    var elementKey = ""
    for i in 0..<props.len:
        var prop = props[i]
        // Extract valid key prop and store separately; invalid key must stay observable.
        if prop.kind == ReactPropKindAttribute && prop.name == "key":
            if prop.valueKind == ReactValueKindString:
                elementKey = prop.valueString
                continue
        add(runtime.propKinds, prop.kind)
        add(runtime.propNames, strings.ConcatStr(prop.name, ""))
        add(runtime.propValueKinds, prop.valueKind)
        add(runtime.propValueBools, prop.valueBool)
        add(runtime.propValueInt32s, prop.valueInt32)
        add(runtime.propValueStrings, strings.ConcatStr(prop.valueString, ""))
    let childStart = runtime.childElementIds.len
    for i in 0..<children.len:
        var child = children[i]
        add(runtime.childElementIds, child.elementId)
    add(runtime.elementKeys, elementKey)
    add(runtime.elementNodeIds, 0)  // placeholder, set during reconcile
    add(runtime.componentFnIds, 0)   // overwritten by CreateComponent for Component elements
    add(runtime.componentHookBases, 0)  // set by CreateComponent
    add(runtime.elementKinds, kind)
    add(runtime.elementTags, tagName)
    add(runtime.elementTexts, textContent)
    add(runtime.elementPropStarts, propStart)
    add(runtime.elementPropCounts, runtime.propKinds.len - propStart)
    add(runtime.elementChildStarts, childStart)
    add(runtime.elementChildCounts, children.len)
    return runtime.elementKinds.len

fn CreateText(runtime: var ReactRuntime, text: str, out: var ReactElement): bool =
    var props: ReactProp[]
    var children: ReactElement[]
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindText, "", text, props, children)
    return ReactRuntimeElementShapeOk(runtime)

fn CreateElement(runtime: var ReactRuntime,
                 tagName: str,
                 props: ReactProp[],
                 children: ReactElement[],
                 out: var ReactElement): bool =
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindHost, tagName, "", props, children)
    return ElementStatus(runtime, out) == ReactStatusOk

fn Jsx(runtime: var ReactRuntime,
       tagName: str,
       props: ReactProp[],
       child: var ReactElement,
       out: var ReactElement): bool =
    var children: ReactElement[]
    var childCopy: ReactElement
    childCopy.elementId = child.elementId
    add(children, childCopy)
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindHost, tagName, "", props, children)
    return ElementStatus(runtime, out) == ReactStatusOk

fn Jsxs(runtime: var ReactRuntime,
        tagName: str,
        props: ReactProp[],
        children: ReactElement[],
        out: var ReactElement): bool =
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindHost, tagName, "", props, children)
    return ElementStatus(runtime, out) == ReactStatusOk

fn CreateComponent(runtime: var ReactRuntime,
                   componentFnId: int32,
                   props: ReactProp[],
                   children: ReactElement[],
                   hookBase: int32,
                   out: var ReactElement): bool =
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindComponent, "", "", props, children)
    if !ReactRuntimeElementShapeOk(runtime):
        return false
    let idx = out.elementId - 1
    runtime.componentFnIds[idx] = componentFnId
    runtime.componentHookBases[idx] = hookBase
    return true

fn UnsupportedElement(runtime: var ReactRuntime, out: var ReactElement): bool =
    var props: ReactProp[]
    var children: ReactElement[]
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindUnsupported, "", "", props, children)
    return false

fn createElement(runtime: var ReactRuntime,
                 tagName: str,
                 props: ReactProp[],
                 children: ReactElement[],
                 out: var ReactElement): bool =
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindHost, tagName, "", props, children)
    return ElementStatus(runtime, out) == ReactStatusOk

fn jsx(runtime: var ReactRuntime,
       tagName: str,
       props: ReactProp[],
       child: var ReactElement,
       out: var ReactElement): bool =
    var children: ReactElement[]
    add(children, child)
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindHost, tagName, "", props, children)
    return ElementStatus(runtime, out) == ReactStatusOk

fn jsxs(runtime: var ReactRuntime,
        tagName: str,
        props: ReactProp[],
        children: ReactElement[],
        out: var ReactElement): bool =
    out.elementId = ReactRuntimeAppendElement(runtime, ReactElementKindHost, tagName, "", props, children)
    return ElementStatus(runtime, out) == ReactStatusOk

fn ElementStatus(runtime: var ReactRuntime, element: var ReactElement): int32 =
    if !ReactRuntimeElementShapeOk(runtime):
        return ReactStatusInvalidElementId
    let index = element.elementId - 1
    if index < 0 || index >= runtime.elementKinds.len:
        return ReactStatusInvalidElementId
    let kind = runtime.elementKinds[index]
    if kind == ReactElementKindText:
        if runtime.elementPropCounts[index] != 0 || runtime.elementChildCounts[index] != 0:
            return ReactStatusInvalidTextElement
        return ReactStatusOk
    if kind == ReactElementKindComponent:
        let childStart = runtime.elementChildStarts[index]
        let childCount = runtime.elementChildCounts[index]
        if childStart < 0 || childCount < 0 || childStart + childCount > runtime.childElementIds.len:
            return ReactStatusInvalidElementId
        for i in 0..<childCount:
            var child: ReactElement
            child.elementId = runtime.childElementIds[childStart + i]
            let childStatus = ElementStatus(runtime, child)
            if childStatus != ReactStatusOk:
                return childStatus
        return ReactStatusOk
    if kind != ReactElementKindHost:
        return ReactStatusUnsupportedElementKind
    if runtime.elementTags[index].len == 0:
        return ReactStatusInvalidHostTag
    let propStart = runtime.elementPropStarts[index]
    let propCount = runtime.elementPropCounts[index]
    if propStart < 0 || propCount < 0 || propStart + propCount > runtime.propKinds.len:
        return ReactStatusUnsupportedPropKind
    for i in 0..<propCount:
        let propIndex = propStart + i
        let propKind = runtime.propKinds[propIndex]
        if propKind != ReactPropKindAttribute:
            return ReactStatusUnsupportedPropKind
        if ReactPropNameIsEvent(runtime.propNames[propIndex]):
            if runtime.propValueKinds[propIndex] != ReactValueKindInt32:
                return ReactStatusUnsupportedPropValue
            if runtime.propValueInt32s[propIndex] <= 0:
                return ReactStatusUnsupportedPropValue
            var eventType: str
            if !ReactEventTypeFromPropName(runtime.propNames[propIndex], eventType):
                return ReactStatusUnsupportedPropName
            continue
        var domName: str
        if !ReactPropDomName(runtime.propNames[propIndex], domName):
            return ReactStatusUnsupportedPropName
        elif runtime.propValueKinds[propIndex] != ReactValueKindString:
            return ReactStatusUnsupportedPropValue
    let childStart = runtime.elementChildStarts[index]
    let childCount = runtime.elementChildCounts[index]
    if childStart < 0 || childCount < 0 || childStart + childCount > runtime.childElementIds.len:
        return ReactStatusInvalidElementId
    for i in 0..<childCount:
        var child: ReactElement
        child.elementId = runtime.childElementIds[childStart + i]
        let childStatus = ElementStatus(runtime, child)
        if childStatus != ReactStatusOk:
            return childStatus
    return ReactStatusOk

@borrows
fn ReactApplyInlineStyle(document: var web.WebDocument, nodeId: int32, styleValue: str): bool =
    # Parse CSS string "key:value;key:value" and apply each as inline style
    var i: int32
    while i < styleValue.len:
        while i < styleValue.len && web.WebCssIsSpace(styleValue[i]):
            i = i + 1
        if i >= styleValue.len:
            break
        var nameStart = i
        while i < styleValue.len && styleValue[i] != ':':
            i = i + 1
        if i >= styleValue.len:
            break
        var propName = web.WebCssSpanToString(styleValue, nameStart, i - 1)
        i = i + 1  # skip ':'
        while i < styleValue.len && web.WebCssIsSpace(styleValue[i]):
            i = i + 1
        var valStart = i
        while i < styleValue.len && styleValue[i] != ';':
            i = i + 1
        var propValue = web.WebCssSpanToString(styleValue, valStart, i - 1)
        # Trim name and value by index (single owned copy per side)
        var nameStop = propName.len - 1
        while nameStart <= nameStop && web.WebCssIsSpace(propName[nameStart]):
            nameStart = nameStart + 1
        while nameStop >= nameStart && web.WebCssIsSpace(propName[nameStop]):
            nameStop = nameStop - 1
        if nameStop < nameStart:
            propName = ""
        else:
            propName = web.WebCssSpanToString(propName, nameStart, nameStop)
        var valueStop = propValue.len - 1
        var valueStart2: int32
        while valueStart2 <= valueStop && web.WebCssIsSpace(propValue[valueStart2]):
            valueStart2 = valueStart2 + 1
        while valueStop >= valueStart2 && web.WebCssIsSpace(propValue[valueStop]):
            valueStop = valueStop - 1
        if valueStop < valueStart2:
            propValue = ""
        else:
            propValue = web.WebCssSpanToString(propValue, valueStart2, valueStop)
        if propName.len > 0 && propValue.len > 0:
            if !web.WebDocumentSetInlineStyleValue(document, nodeId, propName, propValue):
                return false
        if i < styleValue.len && styleValue[i] == ';':
            i = i + 1
    return true

fn ReactApplyProp(runtime: var ReactRuntime,
                  document: var web.WebDocument,
                  nodeId: int32,
                  propIndex: int32): bool =
    if propIndex < 0 || propIndex >= runtime.propKinds.len:
        return false
    let propName = runtime.propNames[propIndex]
    // Handle event props: register DOM event listener instead of setting attribute
    if ReactPropNameIsEvent(propName):
        if runtime.propValueKinds[propIndex] != ReactValueKindInt32:
            return true
        var eventType: str
        if !ReactEventTypeFromPropName(propName, eventType):
            return false
        let handlerId = runtime.propValueInt32s[propIndex]
        if handlerId <= 0:
            return false
        return web.WebDocumentAddEventListener(document, nodeId, eventType, handlerId, false, false)
    // Handle style prop: parse CSS string and apply as inline styles
    if propName == "style":
        if runtime.propValueKinds[propIndex] != ReactValueKindString:
            return false
        return ReactApplyInlineStyle(document, nodeId, runtime.propValueStrings[propIndex])
    var domName: str
    if !ReactPropDomName(propName, domName):
        return false
    if runtime.propValueKinds[propIndex] != ReactValueKindString:
        return false
    return web.WebDocumentSetAttribute(document, nodeId, domName, runtime.propValueStrings[propIndex])

fn ReactReconcileUnchecked(runtime: var ReactRuntime,
                           document: var web.WebDocument,
                           element: var ReactElement,
                           outNodeId: var int32): bool =
    let index = element.elementId - 1
    if index < 0 || index >= runtime.elementKinds.len:
        outNodeId = 0
        return false
    let kind = runtime.elementKinds[index]
    if kind == ReactElementKindText:
        let textNodeId = web.WebDocumentCreateText(document, strings.CloneStr(runtime.elementTexts[index]))
        runtime.elementNodeIds[index] = textNodeId
        outNodeId = textNodeId
        return outNodeId != 0
    if kind == ReactElementKindComponent:
        let childStart = runtime.elementChildStarts[index]
        let childCount = runtime.elementChildCounts[index]
        if childStart < 0 || childCount < 0 || childStart + childCount > runtime.childElementIds.len:
            outNodeId = 0
            return false
        var firstNodeId: int32
        for i in 0..<childCount:
            var child: ReactElement
            child.elementId = runtime.childElementIds[childStart + i]
            var childNodeId: int32
            if !ReactReconcileUnchecked(runtime, document, child, childNodeId):
                outNodeId = 0
                return false
            if childNodeId != 0 && i == 0:
                firstNodeId = childNodeId
        runtime.elementNodeIds[index] = firstNodeId
        outNodeId = firstNodeId
        return true
    if kind != ReactElementKindHost:
        outNodeId = 0
        return false
    let nodeId = web.WebDocumentCreateElement(document, runtime.elementTags[index])
    if nodeId == 0:
        outNodeId = 0
        return false
    runtime.elementNodeIds[index] = nodeId
    let propStart = runtime.elementPropStarts[index]
    let propCount = runtime.elementPropCounts[index]
    for i in 0..<propCount:
        if !ReactApplyProp(runtime, document, nodeId, propStart + i):
            outNodeId = 0
            return false
    let childStart = runtime.elementChildStarts[index]
    let childCount = runtime.elementChildCounts[index]
    for i in 0..<childCount:
        var child: ReactElement
        child.elementId = runtime.childElementIds[childStart + i]
        var childNodeId = 0
        if !ReactReconcileUnchecked(runtime, document, child, childNodeId):
            outNodeId = 0
            return false
        if !web.WebDocumentAppendChild(document, nodeId, childNodeId):
            outNodeId = 0
            return false
    outNodeId = nodeId
    return true

// ReactReconcileDiff: diff two element trees, reusing DOM nodes where possible.
// newElement = current render's element, oldElement = previous render's element (elementId=0 if none)
fn ReactReconcileDiff(runtime: var ReactRuntime,
                      document: var web.WebDocument,
                      newElement: var ReactElement,
                      oldElement: var ReactElement,
                      outNodeId: var int32): bool =
    let newIdx = newElement.elementId - 1
    if newIdx < 0 || newIdx >= runtime.elementKinds.len:
        outNodeId = 0
        return false
    let newKind = runtime.elementKinds[newIdx]

    // Handle text nodes.
    if newKind == ReactElementKindText:
        if oldElement.elementId > 0:
            let oldIdx = oldElement.elementId - 1
            if oldIdx >= 0 && oldIdx < runtime.elementKinds.len && runtime.elementKinds[oldIdx] == ReactElementKindText:
                let oldNodeId = runtime.elementNodeIds[oldIdx]
                if oldNodeId != 0:
                    if !web.WebDocumentSetTextContent(document, oldNodeId, strings.CloneStr(runtime.elementTexts[newIdx])):
                        outNodeId = 0
                        return false
                    runtime.elementNodeIds[newIdx] = oldNodeId
                    outNodeId = oldNodeId
                    return true
        let textNodeId = web.WebDocumentCreateText(document, strings.CloneStr(runtime.elementTexts[newIdx]))
        runtime.elementNodeIds[newIdx] = textNodeId
        outNodeId = textNodeId
        return textNodeId != 0

    // Handle component elements.
    if newKind == ReactElementKindComponent:
        let newChildStart = runtime.elementChildStarts[newIdx]
        let newChildCount = runtime.elementChildCounts[newIdx]
        var oldChildStart = -1
        var oldChildCount = 0
        if oldElement.elementId > 0:
            let oldIdx = oldElement.elementId - 1
            if oldIdx >= 0 && oldIdx < runtime.elementKinds.len:
                if runtime.elementKinds[oldIdx] == ReactElementKindComponent:
                    oldChildStart = runtime.elementChildStarts[oldIdx]
                    oldChildCount = runtime.elementChildCounts[oldIdx]
        var firstNodeId: int32
        for i in 0..<newChildCount:
            var newChild: ReactElement
            newChild.elementId = runtime.childElementIds[newChildStart + i]
            var oldChild: ReactElement
            oldChild.elementId = 0
            if i < oldChildCount:
                oldChild.elementId = runtime.childElementIds[oldChildStart + i]
            var childNodeId: int32
            if !ReactReconcileDiff(runtime, document, newChild, oldChild, childNodeId):
                outNodeId = 0
                return false
            if i == 0:
                firstNodeId = childNodeId
        runtime.elementNodeIds[newIdx] = firstNodeId
        outNodeId = firstNodeId
        return true

    // Handle unsupported elements
    if newKind != ReactElementKindHost:
        outNodeId = 0
        return false

    // Determine node: reuse old or create new
    let nodeId: int32
    var shouldDiffChildren = false
    var oldIdx = 0

    if oldElement.elementId > 0:
        oldIdx = oldElement.elementId - 1
        if oldIdx >= 0 && oldIdx < runtime.elementKinds.len:
            let oldKind = runtime.elementKinds[oldIdx]
            let oldTag = runtime.elementTags[oldIdx]
            let newTag = runtime.elementTags[newIdx]
            if oldKind == ReactElementKindHost && oldTag == newTag:
                nodeId = runtime.elementNodeIds[oldIdx]
                if nodeId != 0:
                    shouldDiffChildren = true
                else:
                    let newNodeId = web.WebDocumentCreateElement(document, strings.CloneStr(newTag))
                    if newNodeId == 0:
                        outNodeId = 0
                        return false
                    nodeId = newNodeId
            else:
                // Different tag - create new node
                let newNodeId = web.WebDocumentCreateElement(document, newTag)
                if newNodeId == 0:
                    outNodeId = 0
                    return false
                nodeId = newNodeId
        else:
            // Invalid old element - create new
            let newNodeId = web.WebDocumentCreateElement(document, runtime.elementTags[newIdx])
            if newNodeId == 0:
                outNodeId = 0
                return false
            nodeId = newNodeId
    else:
        // No old element - create new
        let newNodeId = web.WebDocumentCreateElement(document, runtime.elementTags[newIdx])
        if newNodeId == 0:
            outNodeId = 0
            return false
        nodeId = newNodeId

    runtime.elementNodeIds[newIdx] = nodeId

    // Apply attributes from new element to the DOM node
    let propStart = runtime.elementPropStarts[newIdx]
    let propCount = runtime.elementPropCounts[newIdx]
    for i in 0..<propCount:
        if !ReactApplyProp(runtime, document, nodeId, propStart + i):
            outNodeId = 0
            return false

    // Diff children
    if shouldDiffChildren:
        // oldIdx is set above when we found a valid old element with same tag
        if !ReactDiffChildren(runtime, document, nodeId, newIdx, oldIdx):
            outNodeId = 0
            return false
    else:
        // No old children to diff against, create all children from scratch
        let childStart = runtime.elementChildStarts[newIdx]
        let childCount = runtime.elementChildCounts[newIdx]
        for i in 0..<childCount:
            var child: ReactElement
            child.elementId = runtime.childElementIds[childStart + i]
            var emptyOld: ReactElement
            emptyOld.elementId = 0
            var childNodeId = 0
            if !ReactReconcileDiff(runtime, document, child, emptyOld, childNodeId):
                outNodeId = 0
                return false
            if childNodeId != 0:
                if !web.WebDocumentAppendChild(document, nodeId, childNodeId):
                    outNodeId = 0
                    return false

    outNodeId = nodeId
    return true

// ReactDiffChildren: diff children lists between old and new element at the given indices.
// Removes all old children from parent, then creates/reuses/appends new children in order.
fn ReactDiffChildren(runtime: var ReactRuntime,
                    document: var web.WebDocument,
                    parentNodeId: int32,
                    newElemIdx: int32,
                    oldElemIdx: int32): bool =
    let newChildStart = runtime.elementChildStarts[newElemIdx]
    let newChildCount = runtime.elementChildCounts[newElemIdx]
    let oldChildStart = runtime.elementChildStarts[oldElemIdx]
    let oldChildCount = runtime.elementChildCounts[oldElemIdx]

    // Build old children data: elementIds, keys, domNodeIds
    var oldChildElementIds: int32[]
    var oldChildKeys: str[]
    var oldChildDomNodeIds: int32[]
    for i in 0..<oldChildCount:
        let oldChildElementId = runtime.childElementIds[oldChildStart + i]
        add(oldChildElementIds, oldChildElementId)
        let oldChildIdx = oldChildElementId - 1
        if oldChildIdx >= 0 && oldChildIdx < runtime.elementKeys.len:
            add(oldChildKeys, runtime.elementKeys[oldChildIdx])
        else:
            add(oldChildKeys, "")
        if oldChildIdx >= 0 && oldChildIdx < runtime.elementNodeIds.len:
            add(oldChildDomNodeIds, runtime.elementNodeIds[oldChildIdx])
        else:
            add(oldChildDomNodeIds, 0)

    // Build key -> old child index map
    var keyToOldIdx: str[]
    var keyToOldValue: int32[]
    for i in 0..<oldChildCount:
        let key = oldChildKeys[i]
        if key.len > 0:
            // Check if key already mapped
            var found = false
            for j in 0..<keyToOldIdx.len:
                if keyToOldIdx[j] == key:
                    found = true
                    break
            if !found:
                add(keyToOldIdx, strings.CloneStr(key))
                add(keyToOldValue, i)

    // Track which old children are matched
    var oldMatched: bool[]
    for i in 0..<oldChildCount:
        add(oldMatched, false)

    // Step 4: Remove all old children from parent
    for i in 0..<oldChildCount:
        let domNodeId = oldChildDomNodeIds[i]
        if domNodeId != 0 && web.WebDocumentParentOf(document, domNodeId) != 0:
            if !web.WebDocumentRemoveChild(document, parentNodeId, domNodeId):
                return false

    // Step 5: Walk new children, create/reuse and append
    for i in 0..<newChildCount:
        let newChildElementId = runtime.childElementIds[newChildStart + i]
        let newChildIdx = newChildElementId - 1
        var newChildKey = ""
        if newChildIdx >= 0 && newChildIdx < runtime.elementKeys.len:
            newChildKey = runtime.elementKeys[newChildIdx]

        // Find match in old children
        var matchedOldChildIndex = -1
        if newChildKey.len > 0:
            // Key-based matching
            for j in 0..<keyToOldIdx.len:
                if keyToOldIdx[j] == newChildKey:
                    matchedOldChildIndex = keyToOldValue[j]
                    break
        else:
            // React child matching without keys uses the same child index.
            if i < oldChildCount && !oldMatched[i]:
                matchedOldChildIndex = i

        // Create old element reference for matching
        var childOldElement: ReactElement
        childOldElement.elementId = 0
        if matchedOldChildIndex >= 0 && matchedOldChildIndex < oldChildElementIds.len:
            childOldElement.elementId = oldChildElementIds[matchedOldChildIndex]
            oldMatched[matchedOldChildIndex] = true

        // Create or reuse child DOM node
        var childNodeId = 0
        var newChildReact: ReactElement
        newChildReact.elementId = newChildElementId
        if !ReactReconcileDiff(runtime, document, newChildReact, childOldElement, childNodeId):
            return false

        // Append to parent (child was removed in step 4 if it had a parent)
        if childNodeId != 0:
            if web.WebDocumentParentOf(document, childNodeId) == 0:
                if !web.WebDocumentAppendChild(document, parentNodeId, childNodeId):
                    return false

    return true

fn Reconcile(runtime: var ReactRuntime,
             document: var web.WebDocument,
             element: var ReactElement,
             outNodeId: var int32): bool =
    outNodeId = 0
    if ElementStatus(runtime, element) != ReactStatusOk:
        return false
    var result: bool
    if runtime.prevRootElementId == 0:
        result = ReactReconcileUnchecked(runtime, document, element, outNodeId)
    else:
        var oldElement: ReactElement
        oldElement.elementId = runtime.prevRootElementId
        result = ReactReconcileDiff(runtime, document, element, oldElement, outNodeId)
    if result:
        runtime.prevRootElementId = element.elementId
    return result

fn reconcile(runtime: var ReactRuntime,
             document: var web.WebDocument,
             element: var ReactElement,
             outNodeId: var int32): bool =
    return Reconcile(runtime, document, element, outNodeId)

fn ReactCreateContext(runtime: var ReactRuntime, defaultValue: int32): int32 =
    let ctxId = runtime.contextIds.len + 1
    add(runtime.contextIds, ctxId)
    add(runtime.contextValues, defaultValue)
    return ctxId

fn ReactUseContext(runtime: var ReactRuntime, contextId: int32): int32 =
    for i in 0..<runtime.contextIds.len:
        if runtime.contextIds[i] == contextId:
            return runtime.contextValues[i]
    return 0

fn ReactLazy(runtime: var ReactRuntime, importFnId: int32): int32 =
    let lazyId = runtime.lazyList.len + 1
    add(runtime.lazyList, importFnId)
    return lazyId

fn ReactDOMCreateRoot(runtime: var ReactRuntime, containerId: int32): int32 =
    let rootId = runtime.rootList.len + 1
    add(runtime.rootList, containerId)
    return rootId

fn ReactRootRender(runtime: var ReactRuntime,
                   document: var web.WebDocument,
                   rootId: int32,
                   elementTreeRootId: int32): bool =
    if rootId < 1 || rootId > runtime.rootList.len:
        return false
    let containerNodeId = runtime.rootList[rootId - 1]
    var element: ReactElement
    element.elementId = elementTreeRootId
    var outNodeId: int32
    if !Reconcile(runtime, document, element, outNodeId):
        return false
    if outNodeId != 0:
        if !web.WebDocumentAppendChild(document, containerNodeId, outNodeId):
            return false
    ReactRunEffects(runtime)
    return true
