# Ink overlay (M2/M3 水墨线): first-frame loading splash (墨滴入水), route
# transitions (墨晕转场) and qi tap feedback (点击生气), all over the host's
# overlay channel + cached-frame replay paths. Commands/fields never enter the
# scene compositor frame nor the route digest.
#
# Motion: fluid3d 3D particles (drop ballistics, impact composition, curl
# advection) act as ink sources injected into the lbm2d wash field (扩散晕染
# 沉积). Per-tick receipt fingerprints fold into a rolling hash (replay gate).
#
# Present phase protocol (consumed by the generated app tick):
#   0 none, 1 paper-exclusive refresh, 2 normal present once (warm layer
#   caches under full ink cover), 3 cached-frame replay + ink.

import cheng/game/fluid3d
import cheng/game/lbm2d
import std/rawbytes

const
    WebInkOverlayCommandStrideI32 = 17
    WebInkOverlayMaxCommands = 512
    WebInkGpuGradientFill = 8
    WebInkOverlayFixedDtMs = 16
    # ~1s launch reveal: ~26 frames at the device's ~40ms fluid step ≈ 1s wall
    # clock (was 170 ≈ 3.8s). The reveal now plays over an already-built home
    # (the build runs first under the Android launch splash), so these frames
    # are clean with no build interleaving — the former mid-sequence freeze.
    WebInkOverlayMaxTicks = 26
    WebInkLbmGridW = 130
    WebInkLbmGridH = 280
    WebInkLbmStepEvery = 2
    WebInkFadeTicks = 8
    WebInkTransExpandTicks = 12
    WebInkTransCoverTicks = 2
    WebInkTransRevealTicks = 16
    WebInkTransBandPx = 26
    WebInkQiSlots = 24
    WebInkQiLifeTicks = 18
    WebInkOverlayEndAlpha = 14
    WebInkOverlayBaseColorRgb = 0x1A2026

var __webInkOverlayActive: bool
var __webInkOverlayTick: int32
var __webInkOverlayWorld: fluid3d.Fluid3dWorld
var __webInkOverlayConfig: fluid3d.Fluid3dConfig
var __webInkOverlaySeed: int32
var __webInkOverlayRollingFingerprint: int32
var __webInkOverlayViewportW: int32
var __webInkOverlayViewportH: int32
var __webInkLbmWorld: lbm2d.Lbm2dWorld
var __webInkLbmConfig: lbm2d.Lbm2dConfig
var __webInkFieldBytes: rawbytes.Bytes
var __webInkFieldReady: bool
var __webInkFadeLeft: int32
# mode: 0 none, 1 splash (paper background), 2 route transition (ink wipe)
var __webInkMode: int32
var __webInkWarmed: bool
var __webInkTransTick: int32
var __webInkTransCenterX: int32
var __webInkTransCenterY: int32

# Debug fixture (channel verification): a single static soft-edged dot.
var __webInkOverlayDebugActive: bool
var __webInkOverlayDebugX: int32
var __webInkOverlayDebugY: int32
var __webInkOverlayDebugSize: int32
var __webInkOverlayDebugColor: int32

fn WebInkOverlayDebugSpawn(x: int32, y: int32, size: int32, color: int32) =
    __webInkOverlayDebugActive = true
    __webInkOverlayDebugX = x
    __webInkOverlayDebugY = y
    __webInkOverlayDebugSize = size
    __webInkOverlayDebugColor = color

fn WebInkOverlayDebugClear() =
    __webInkOverlayDebugActive = false

fn webInkOverlayMix(hash: int32, value: int32): int32 =
    var mixed = hash * 31 + value
    if mixed < 0:
        mixed = 0 - mixed
    return mixed

fn WebInkOverlayLaunch(viewportW: int32, viewportH: int32, seed: int32) =
    __webInkOverlayTick = 0
    __webInkOverlaySeed = seed
    __webInkOverlayRollingFingerprint = webInkOverlayMix(7, seed)
    __webInkOverlayViewportW = viewportW
    __webInkOverlayViewportH = viewportH
    __webInkOverlayConfig.dropStartXPx = viewportW / 2
    __webInkOverlayConfig.dropStartYPx = viewportH / 8
    __webInkOverlayConfig.dropSpeedQ8 = 760 * fluid3d.Fluid3dQ
    __webInkOverlayConfig.dropRadiusPx = 9
    __webInkOverlayConfig.waterLineYPx = (viewportH * 2) / 5
    __webInkOverlayConfig.minXPx = 12
    __webInkOverlayConfig.maxXPx = viewportW - 12
    __webInkOverlayConfig.maxYPx = viewportH - 40
    __webInkOverlayConfig.depthRangePx = 130
    __webInkOverlayConfig.plumeSinkQ8 = 95 * fluid3d.Fluid3dQ
    __webInkOverlayConfig.swirlAmpQ8 = 88 * fluid3d.Fluid3dQ
    __webInkOverlayConfig.spreadQ8 = 14 * fluid3d.Fluid3dQ
    __webInkOverlayConfig.diffuseRadiusGrowQ8 = 44
    __webInkOverlayConfig.alphaDecayNum = 986
    __webInkOverlayConfig.alphaDecayDen = 1000
    __webInkOverlayConfig.tendrilEvery = 1
    __webInkOverlayConfig.endAlpha = 8
    __webInkOverlayWorld = fluid3d.Fluid3dInkDropInit(__webInkOverlayConfig, seed)
    __webInkLbmConfig.ambientWater = lbm2d.Lbm2dQ
    __webInkLbmConfig.evapNum = 14
    __webInkLbmConfig.evapDen = 1000
    __webInkLbmConfig.dryThreshold = lbm2d.Lbm2dQ / 10
    __webInkLbmConfig.depositNum = 6
    __webInkLbmConfig.depositDen = 100
    __webInkLbmConfig.pigmentDiffNum = 3
    __webInkLbmConfig.pigmentDiffDen = 100
    __webInkLbmConfig.fiberDragMax = 90
    __webInkLbmConfig.sinkForceQ8 = 14
    __webInkLbmWorld = lbm2d.Lbm2dInit(WebInkLbmGridW, WebInkLbmGridH, seed, __webInkLbmConfig)
    if !__webInkFieldReady:
        __webInkFieldBytes = rawbytes.BytesAlloc(WebInkLbmGridW * WebInkLbmGridH)
        __webInkFieldReady = true
    else:
        var clearCell = 0
        let totalClear = WebInkLbmGridW * WebInkLbmGridH
        while clearCell < totalClear:
            rawbytes.BytesSet(__webInkFieldBytes, clearCell, 0)
            clearCell = clearCell + 1
    __webInkFadeLeft = WebInkFadeTicks
    __webInkMode = 1
    __webInkWarmed = false
    __webInkOverlayActive = true

# 气 (qi) tap feedback: up to 4 concurrent analytic puffs over the live scene.
# Slots are scalar module vars (cold quirk: plain element stores into module
# arrays can be dropped; scalar stores are reliable).
# Qi slots live in a rawbytes buffer (BytesSet is a call, immune to the cold
# module-level array element-store bug). 12 slots x 12 bytes:
# [0..1] x px  [2..3] y px  [4..5] vx (1/16 px per tick, biased +32768)
# [6..7] vy (biased)  [8..9] age  [10..11] seed
var __webInkQiNext: int32
var __webInkQiBytes: rawbytes.Bytes
var __webInkQiReady: bool
var __webInkQiAliveCount: int32

var __webInkLastTapX: int32
var __webInkLastTapY: int32
var __webInkTrailLastX: int32
var __webInkTrailLastY: int32
var __webInkTrailHas: bool

fn webInkQiEnsure() =
    if !__webInkQiReady:
        __webInkQiBytes = rawbytes.BytesAlloc(WebInkQiSlots * 12)
        __webInkQiReady = true

fn webInkQiGet16(off: int32): int32 =
    return rawbytes.BytesGet(__webInkQiBytes, off) | (rawbytes.BytesGet(__webInkQiBytes, off + 1) << 8)

fn webInkQiSet16(off: int32, value: int32) =
    var v = value
    if v < 0:
        v = 0
    if v > 65535:
        v = 65535
    rawbytes.BytesSet(__webInkQiBytes, off, v & 255)
    rawbytes.BytesSet(__webInkQiBytes, off + 1, (v >> 8) & 255)

fn webInkQiSpawnSlot(xPx: int32, yPx: int32, vx16: int32, vy16: int32) =
    webInkQiEnsure()
    var slot = __webInkQiNext
    while slot >= WebInkQiSlots:
        slot = slot - WebInkQiSlots
    __webInkQiNext = __webInkQiNext + 1
    if __webInkQiNext >= 1000000:
        __webInkQiNext = 0
    let seed = webInkOverlayMix(__webInkOverlaySeed + 11, xPx * 31 + yPx)
    let base = slot * 12
    webInkQiSet16(base, xPx)
    webInkQiSet16(base + 2, yPx)
    webInkQiSet16(base + 4, vx16 + 32768)
    webInkQiSet16(base + 6, vy16 + 32768)
    webInkQiSet16(base + 8, 1)
    webInkQiSet16(base + 10, seed & 65535)
    __webInkQiAliveCount = __webInkQiAliveCount + 1

fn WebInkQiSpawn(xPx: int32, yPx: int32) =
    __webInkLastTapX = xPx
    __webInkLastTapY = yPx
    webInkQiSpawnSlot(xPx, yPx, 0, 0)

# Trail mode (滑动气轨迹): spawn qi along the finger path; the spawn velocity
# follows the finger so size/stretch/afterglow express speed and force.
fn WebInkQiOnTouchMove(xPx: int32, yPx: int32) =
    if !__webInkTrailHas:
        __webInkTrailHas = true
        __webInkTrailLastX = xPx
        __webInkTrailLastY = yPx
        return
    let dx = xPx - __webInkTrailLastX
    let dy = yPx - __webInkTrailLastY
    let dist2 = dx * dx + dy * dy
    # throttle: one qi per >=18px of travel (24 slots x 0.3s life covers a fast
    # full-screen stroke without slot recycling truncating the tail)
    if dist2 < 324:
        return
    __webInkTrailLastX = xPx
    __webInkTrailLastY = yPx
    # initial velocity ~ finger direction; 1/16 px per tick fixed point,
    # clamped so a fast fling stays inside the slot encoding
    var vx16 = dx * 6
    var vy16 = dy * 6
    if vx16 > 2047:
        vx16 = 2047
    if vx16 < 0 - 2047:
        vx16 = 0 - 2047
    if vy16 > 2047:
        vy16 = 2047
    if vy16 < 0 - 2047:
        vy16 = 0 - 2047
    webInkQiSpawnSlot(xPx, yPx, vx16, vy16)

fn WebInkQiOnTouchEnd() =
    __webInkTrailHas = false

fn WebInkQiActive(): bool =
    return __webInkQiAliveCount > 0

fn WebInkQiPresentPhase(): int32 =
    if WebInkQiActive():
        return 3
    return 0

fn webInkQiTick() =
    if !__webInkQiReady || __webInkQiAliveCount <= 0:
        return
    var slot = 0
    while slot < WebInkQiSlots:
        let base = slot * 12
        let age = webInkQiGet16(base + 8)
        if age >= 1:
            if age + 1 >= WebInkQiLifeTicks:
                webInkQiSet16(base + 8, 0)
                __webInkQiAliveCount = __webInkQiAliveCount - 1
            else:
                webInkQiSet16(base + 8, age + 1)
                # inertia: integrate position, decay velocity by 7/8 per tick
                let vx = webInkQiGet16(base + 4) - 32768
                let vy = webInkQiGet16(base + 6) - 32768
                webInkQiSet16(base, webInkQiGet16(base) + vx / 16)
                webInkQiSet16(base + 2, webInkQiGet16(base + 2) + vy / 16)
                webInkQiSet16(base + 4, (vx * 7) / 8 + 32768)
                webInkQiSet16(base + 6, (vy * 7) / 8 + 32768)
        slot = slot + 1

# Route transition (M3 墨晕转场): ink blooms from the tap point, covers the
# screen, the new route is presented under full cover, then the ink reveals it.
fn WebInkTransitionStartAtLastTap(viewportW: int32, viewportH: int32) =
    var x = __webInkLastTapX
    var y = __webInkLastTapY
    if x <= 0 && y <= 0:
        x = viewportW / 2
        y = viewportH / 2
    WebInkTransitionStart(x, y, viewportW, viewportH)

fn WebInkTransitionStart(xPx: int32, yPx: int32, viewportW: int32, viewportH: int32) =
    if __webInkMode == 1:
        return
    if viewportW <= 0 || viewportH <= 0:
        return
    __webInkOverlayViewportW = viewportW
    __webInkOverlayViewportH = viewportH
    if !__webInkFieldReady:
        __webInkFieldBytes = rawbytes.BytesAlloc(WebInkLbmGridW * WebInkLbmGridH)
        __webInkFieldReady = true
    __webInkMode = 2
    __webInkWarmed = false
    __webInkTransTick = 0
    __webInkTransCenterX = xPx
    __webInkTransCenterY = yPx
    __webInkOverlayActive = true

fn WebInkOverlayPresentPhaseTake(): int32 =
    if !__webInkOverlayActive:
        return 0
    if __webInkMode == 1:
        let splashEnding = __webInkFadeLeft < WebInkFadeTicks
        if !splashEnding:
            return 1
        if !__webInkWarmed:
            __webInkWarmed = true
            return 2
        return 3
    if __webInkMode == 2:
        if __webInkTransTick < WebInkTransExpandTicks:
            return 3
        if !__webInkWarmed:
            __webInkWarmed = true
            return 2
        return 3
    return 0

fn webInkTransitionFillField() =
    # analytic ink bloom: dist^2 vs eased radius, noise-perturbed edge band
    let cx = (__webInkTransCenterX * WebInkLbmGridW) / __webInkOverlayViewportW
    let cy = (__webInkTransCenterY * WebInkLbmGridH) / __webInkOverlayViewportH
    let maxCell = WebInkLbmGridW + WebInkLbmGridH
    var radius = 0
    let expandEnd = WebInkTransExpandTicks + WebInkTransCoverTicks
    if __webInkTransTick >= expandEnd:
        radius = maxCell
    else:
        let t = __webInkTransTick
        radius = (maxCell * t * t) / (WebInkTransExpandTicks * WebInkTransExpandTicks)
        if radius > maxCell:
            radius = maxCell
    let cellPxAvg = (__webInkOverlayViewportW / WebInkLbmGridW + __webInkOverlayViewportH / WebInkLbmGridH) / 2 + 1
    let band = WebInkTransBandPx / cellPxAvg + 2
    let r2 = radius * radius
    let rb = radius + band
    let rb2 = rb * rb
    if __webInkTransTick <= 1:
        # first fill: full scan seeds the "out-of-box == 0" invariant the clip
        # below relies on (the field may carry residue from a prior sequence).
        var cell = 0
        var gy = 0
        while gy < WebInkLbmGridH:
            var gx = 0
            while gx < WebInkLbmGridW:
                let dx = gx - cx
                let dy = gy - cy
                let noise = webInkOverlayMix(__webInkOverlaySeed, cell * 2654435761) % (band + 1)
                let d2 = dx * dx + dy * dy + noise * noise
                var v = 0
                if d2 <= r2:
                    v = 255
                elif d2 < rb2:
                    v = (255 * (rb2 - d2)) / (rb2 - r2)
                rawbytes.BytesSet(__webInkFieldBytes, cell, v)
                gx = gx + 1
                cell = cell + 1
            gy = gy + 1
        return
    # bounding-box clip: only cells with |gx-cx|<=rb and |gy-cy|<=rb can be
    # nonzero (a cell outside computes d2 > rb2 -> v=0). radius/rb grow
    # monotonically within a transition, so a cell once outside the box is never
    # re-entered, and the tick<=1 full scan already cleared it to 0. Byte-identical
    # to the full scan; only the guaranteed-0 out-of-box cells are skipped.
    var x0 = cx - rb
    if x0 < 0:
        x0 = 0
    var x1 = cx + rb
    if x1 > WebInkLbmGridW - 1:
        x1 = WebInkLbmGridW - 1
    var y0 = cy - rb
    if y0 < 0:
        y0 = 0
    var y1 = cy + rb
    if y1 > WebInkLbmGridH - 1:
        y1 = WebInkLbmGridH - 1
    var gy2 = y0
    while gy2 <= y1:
        let rowBase = gy2 * WebInkLbmGridW
        var gx2 = x0
        while gx2 <= x1:
            let cell2 = rowBase + gx2
            let dx = gx2 - cx
            let dy = gy2 - cy
            let noise = webInkOverlayMix(__webInkOverlaySeed, cell2 * 2654435761) % (band + 1)
            let d2 = dx * dx + dy * dy + noise * noise
            var v = 0
            if d2 <= r2:
                v = 255
            elif d2 < rb2:
                v = (255 * (rb2 - d2)) / (rb2 - r2)
            rawbytes.BytesSet(__webInkFieldBytes, cell2, v)
            gx2 = gx2 + 1
        gy2 = gy2 + 1

fn webInkTransitionTick(): int32 =
    __webInkTransTick = __webInkTransTick + 1
    __webInkOverlayRollingFingerprint = webInkOverlayMix(__webInkOverlayRollingFingerprint,
                                                         __webInkTransTick * 31 + __webInkTransCenterX)
    webInkTransitionFillField()
    if __webInkTransTick >= WebInkTransExpandTicks + WebInkTransCoverTicks + WebInkTransRevealTicks:
        __webInkMode = 0
        __webInkOverlayActive = false
    return 1

fn WebInkOverlayTick(): int32 =
    webInkQiTick()
    if !__webInkOverlayActive:
        return 1
    if __webInkMode == 2:
        return webInkTransitionTick()
    __webInkOverlayTick = __webInkOverlayTick + 1
    let receipt = fluid3d.Fluid3dStep(__webInkOverlayWorld,
                                      WebInkOverlayFixedDtMs,
                                      __webInkOverlayConfig)
    fluid3d.Fluid3dRequireValid(receipt)
    __webInkOverlayRollingFingerprint = webInkOverlayMix(__webInkOverlayRollingFingerprint,
                                                         receipt.receiptFingerprint)
    # particles hand their pigment into the LBM wash as they move through water
    var pi = 0
    while pi < __webInkOverlayWorld.count:
        let pAlpha = __webInkOverlayWorld.alpha[pi]
        if pAlpha > __webInkOverlayConfig.endAlpha:
            let px = __webInkOverlayWorld.posX[pi] / fluid3d.Fluid3dQ
            let py = __webInkOverlayWorld.posY[pi] / fluid3d.Fluid3dQ
            let cx = (px * WebInkLbmGridW) / __webInkOverlayViewportW
            let cy = (py * WebInkLbmGridH) / __webInkOverlayViewportH
            lbm2d.Lbm2dInjectInk(__webInkLbmWorld, cx, cy,
                                 lbm2d.Lbm2dQ / 3,
                                 (pAlpha * lbm2d.Lbm2dQ) / 320,
                                 __webInkOverlayWorld.velX[pi] / 24,
                                 __webInkOverlayWorld.velY[pi] / 24)
        pi = pi + 1
    if __webInkOverlayTick % WebInkLbmStepEvery == 0:
        let lbmReceipt = lbm2d.Lbm2dStep(__webInkLbmWorld, __webInkLbmConfig)
        lbm2d.Lbm2dRequireValid(lbmReceipt)
        __webInkOverlayRollingFingerprint = webInkOverlayMix(__webInkOverlayRollingFingerprint,
                                                             lbmReceipt.receiptFingerprint)
    var ending = false
    if receipt.phase == fluid3d.Fluid3dPhaseDone:
        ending = true
    if __webInkOverlayTick >= WebInkOverlayMaxTicks - WebInkFadeTicks:
        ending = true
    if ending:
        __webInkFadeLeft = __webInkFadeLeft - 1
        if __webInkFadeLeft <= 0:
            __webInkOverlayActive = false
    # refresh only the field bytes the LBM touched this step (fade is GPU-side)
    var ti = 0
    let touchedCount = __webInkLbmWorld.touchedIdx.len
    while ti < touchedCount:
        let cell = __webInkLbmWorld.touchedIdx[ti]
        rawbytes.BytesSet(__webInkFieldBytes, cell, __webInkLbmWorld.view[cell])
        ti = ti + 1
    return 1

fn WebInkOverlayActive(): bool =
    return __webInkOverlayActive

fn WebInkOverlayRollingFingerprint(): int32 =
    return __webInkOverlayRollingFingerprint

fn WebInkOverlayFadePermille(): int32 =
    if !__webInkOverlayActive:
        return 0
    if __webInkMode == 1:
        if __webInkFadeLeft >= WebInkFadeTicks:
            return 1000
        var f = (__webInkFadeLeft * 1000) / WebInkFadeTicks
        if f < 0:
            f = 0
        return f
    if __webInkMode == 2:
        let expandEnd = WebInkTransExpandTicks + WebInkTransCoverTicks
        let revealT = __webInkTransTick - expandEnd
        if revealT <= 0:
            return 1000
        var f2 = ((WebInkTransRevealTicks - revealT) * 1000) / WebInkTransRevealTicks
        if f2 < 0:
            f2 = 0
        return f2
    return 1000

fn WebInkOverlayFieldData(): ptr =
    return __webInkFieldBytes.data

fn WebInkOverlayFieldGridW(): int32 =
    if !__webInkOverlayActive:
        return 0
    return WebInkLbmGridW

fn WebInkOverlayFieldGridH(): int32 =
    return WebInkLbmGridH

# 16-step deterministic angle from a velocity vector, in degrees.
fn webInkOverlayAngleDeg(vx: int32, vy: int32): int32 =
    var ax = vx
    if ax < 0:
        ax = 0 - ax
    var ay = vy
    if ay < 0:
        ay = 0 - ay
    if ax == 0 && ay == 0:
        return 0
    var octant: int32
    if ay <= ax / 2:
        octant = 0
    elif ax <= ay / 2:
        octant = 4
    else:
        octant = 2
    var deg = octant * 22
    if vx >= 0 && vy < 0:
        deg = 0 - deg
    if vx < 0 && vy >= 0:
        deg = 180 - deg
    if vx < 0 && vy < 0:
        deg = 180 + deg
    return deg

fn WebInkOverlayAppendSoftDot(out: var int32[],
                              x: int32,
                              y: int32,
                              w: int32,
                              h: int32,
                              color: int32,
                              rotationDeg: int32) =
    add(out, WebInkGpuGradientFill)   # [0] kind
    add(out, 0)                        # [1] routeIndex (overlay: unused)
    add(out, 0)                        # [2] layerId (overlay: unused)
    add(out, x)                        # [3] x
    add(out, y)                        # [4] y
    add(out, w)                        # [5] w
    add(out, h)                        # [6] h
    add(out, color)                    # [7] start color (ink)
    add(out, color & 0x00FFFFFF)       # [8] end color (alpha 0)
    add(out, 0)                        # [9] gradient angle (unused for radial)
    add(out, 1)                        # [10] radial flag
    add(out, 500)                      # [11] center x permille
    add(out, w / 2)                    # [12] corner radius
    add(out, 500)                      # [13] center y permille
    add(out, 500)                      # [14] radius permille
    add(out, 0)                        # [15] glyphSdfAtlasId (unused)
    add(out, rotationDeg)              # [16] rotation

fn fluidAbsLocal(value: int32): int32 =
    if value < 0:
        return 0 - value
    return value

fn webInkQiCollectOne(out: var int32[], countIn: int32, cx: int32, cy: int32, age: int32, seed: int32, vx: int32, vy: int32): int32 =
    var count = countIn
    if age < 1 || count + 6 >= WebInkOverlayMaxCommands:
        return count
    # speed in 1/16 px per tick; stretches the ring along the motion and adds
    # alpha so a fast stroke reads as force
    var speed = fluidAbsLocal(vx) + fluidAbsLocal(vy)
    if speed > 2048:
        speed = 2048
    let ringW = 22 + age * 3 + speed / 28
    let ringH = 22 + age * 3
    var ringAlpha = 96 + speed / 24 - (age * 96) / WebInkQiLifeTicks
    if ringAlpha > 200:
        ringAlpha = 200
    if ringAlpha > 0:
        let ringColor = (ringAlpha << 24) | WebInkOverlayBaseColorRgb
        let deg = webInkOverlayAngleDeg(vx, vy)
        WebInkOverlayAppendSoftDot(out, cx - ringW / 2, cy - ringH / 2, ringW, ringH, ringColor, deg)
        count = count + 1
    var k = 0
    while k < 5:
        var noise = webInkOverlayMix(seed, k * 97)
        let drift = ((noise % 21) - 10)
        noise = webInkOverlayMix(noise, 7)
        let rise = 8 + (noise % 9)
        noise = webInkOverlayMix(noise, 13)
        let size = 6 + (noise % 4) + age / 3
        # wisps trail behind the motion direction (inertia afterglow)
        let wx = cx + drift * age / 4 + ((noise % 9) - 4) - (vx * age) / 96
        let wy = cy - (rise * age) / 6 - (vy * age) / 96
        var wAlpha = 64 + speed / 48 - (age * 64) / WebInkQiLifeTicks
        if k == 0:
            wAlpha = wAlpha + 16
        if wAlpha > 160:
            wAlpha = 160
        if wAlpha > 0:
            let wColor = (wAlpha << 24) | WebInkOverlayBaseColorRgb
            WebInkOverlayAppendSoftDot(out, wx - size / 2, wy - size / 2, size, size, wColor, 0)
            count = count + 1
        k = k + 1
    return count

fn webInkQiCollect(out: var int32[], countIn: int32): int32 =
    var count = countIn
    if !__webInkQiReady || __webInkQiAliveCount <= 0:
        return count
    var slot = 0
    while slot < WebInkQiSlots:
        let base = slot * 12
        let age = webInkQiGet16(base + 8)
        if age >= 1:
            count = webInkQiCollectOne(out,
                                       count,
                                       webInkQiGet16(base),
                                       webInkQiGet16(base + 2),
                                       age,
                                       webInkQiGet16(base + 10),
                                       webInkQiGet16(base + 4) - 32768,
                                       webInkQiGet16(base + 6) - 32768)
        slot = slot + 1
    return count

fn WebInkOverlayCollectCommands(out: var int32[]): int32 =
    var count = 0
    if __webInkOverlayActive && __webInkMode == 1:
        let phase = fluid3d.Fluid3dPhaseOf(__webInkOverlayWorld)
        if phase == fluid3d.Fluid3dPhaseFalling:
            let dx = fluid3d.Fluid3dDropXPx(__webInkOverlayWorld)
            let dy = fluid3d.Fluid3dDropYPx(__webInkOverlayWorld)
            let dr = __webInkOverlayConfig.dropRadiusPx
            let dropColor = (240 << 24) | WebInkOverlayBaseColorRgb
            WebInkOverlayAppendSoftDot(out, dx - dr, dy - dr * 2, dr * 2, dr * 4, dropColor, 0)
            count = count + 1
        let ringAge = fluid3d.Fluid3dRingAge(__webInkOverlayWorld)
        if ringAge >= 0 && ringAge < 34 && count < WebInkOverlayMaxCommands:
            let rw = 26 + ringAge * 9
            let rh = 7 + ringAge / 4
            var ringAlpha = 110 - ringAge * 3
            if ringAlpha > 0:
                let ringColor = (ringAlpha << 24) | WebInkOverlayBaseColorRgb
                let cx = fluid3d.Fluid3dDropXPx(__webInkOverlayWorld)
                let cy = __webInkOverlayConfig.waterLineYPx
                WebInkOverlayAppendSoftDot(out, cx - rw / 2, cy - rh / 2, rw, rh, ringColor, 0)
                count = count + 1
        # painter order: farthest (most negative z) first
        var order: int32[]
        var i = 0
        while i < __webInkOverlayWorld.count:
            add(order, i)
            i = i + 1
        var sorted = 1
        while sorted == 1:
            sorted = 0
            var k = 0
            while k + 1 < order.len:
                if __webInkOverlayWorld.posZ[order[k]] > __webInkOverlayWorld.posZ[order[k + 1]]:
                    let tmp = order[k]
                    order[k] = order[k + 1]
                    order[k + 1] = tmp
                    sorted = 1
                k = k + 1
        let pivotX = fluid3d.Fluid3dDropXPx(__webInkOverlayWorld)
        let pivotY = __webInkOverlayConfig.waterLineYPx
        var oi = 0
        while oi < order.len && count < WebInkOverlayMaxCommands:
            let idx = order[oi]
            let alpha = __webInkOverlayWorld.alpha[idx]
            if alpha > __webInkOverlayConfig.endAlpha:
                let scale = fluid3d.Fluid3dProjectScalePermille(__webInkOverlayWorld.posZ[idx])
                let px = fluid3d.Fluid3dProjectAxis(__webInkOverlayWorld.posX[idx], pivotX, scale)
                let py = fluid3d.Fluid3dProjectAxis(__webInkOverlayWorld.posY[idx], pivotY, scale)
                var r = (__webInkOverlayWorld.radiusQ8[idx] / fluid3d.Fluid3dQ) * scale / 1000
                if r < 2:
                    r = 2
                var depthAlpha = (alpha * (700 + scale * 3 / 10)) / 1000
                if depthAlpha > 255:
                    depthAlpha = 255
                let color = (depthAlpha << 24) | WebInkOverlayBaseColorRgb
                let vx = __webInkOverlayWorld.velX[idx]
                let vy = __webInkOverlayWorld.velY[idx]
                var stretch = (fluidAbsLocal(vx) + fluidAbsLocal(vy)) / (40 * fluid3d.Fluid3dQ / 10)
                if stretch > 18:
                    stretch = 18
                let w = r * 2 + stretch
                let h = r * 2
                let deg = webInkOverlayAngleDeg(vx, vy)
                WebInkOverlayAppendSoftDot(out, px - w / 2, py - h / 2, w, h, color, deg)
                count = count + 1
            oi = oi + 1
    count = webInkQiCollect(out, count)
    if __webInkOverlayDebugActive && count < WebInkOverlayMaxCommands:
        WebInkOverlayAppendSoftDot(out,
                                   __webInkOverlayDebugX,
                                   __webInkOverlayDebugY,
                                   __webInkOverlayDebugSize,
                                   __webInkOverlayDebugSize,
                                   __webInkOverlayDebugColor,
                                   0)
        count = count + 1
    return count

# Host channel accessors (scalar ABI: count recollects, word_at reads).
var __webInkOverlayWords: int32[]

fn WebInkOverlayCommandCount(): int32 =
    __webInkOverlayWords = []
    return WebInkOverlayCollectCommands(__webInkOverlayWords)

fn WebInkOverlayCommandWordAt(index: int32): int32 =
    if index < 0 || index >= __webInkOverlayWords.len:
        return 0
    return __webInkOverlayWords[index]
