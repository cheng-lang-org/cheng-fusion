# parser_text_provider — raw byte-copy helpers for parser str builders.
#
# Kernel parser callers hold a freshly allocated `var str` plus a write cursor.
# The byte copy is a platform/physical detail; it lives in the provider tier so
# kernel_core signatures stay free of ptr parameters.
import std/rawmem_support
import std/system

@borrows
fn ParserWriteTextFast(out: var str,
                       writePos: var int32,
                       text: str) =
    let textLen = text.len
    if textLen <= 0:
        return
    let outPtr = RawmemAsVoid(out)
    if outPtr == nil:
        return
    RawmemCopy(RawmemPtrAdd(outPtr, writePos), RawmemAsVoid(text), textLen)
    writePos = writePos + textLen
