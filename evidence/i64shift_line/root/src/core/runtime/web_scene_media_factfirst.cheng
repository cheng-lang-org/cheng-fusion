# Pure-Cheng fact-first publish seal (CFFM v1) — docs/cheng-csg-video-facts-bytes-plan.md §S1.
#
# 发布=封签事实图，不是传完字节。本模块把 `.moqidx`（已是雏形 fact index，
# 见 tools/gen_moq_es_index.mjs / moqidx_oracle_dump_main.cheng）封签为 CFFM v1
# (Cheng Fact-First Manifest) 事实包：接收端仅凭 manifest 即可完成 seek 查表、
# 首帧预算与防篡改校验，无需持有 ES 字节；封签成本由索引大小界定，与 ES 大小
# 解耦（GB 级资产秒发的结构性前提）。
#
# CFFM v1 wire layout (little-endian; CID covers exactly the canonical content bytes):
#   content:
#     0..3   magic "CFFM"
#     4..7   version = 1
#     8..11  width            (copied from moqidx header)
#     12..15 height
#     16..19 fpsNum
#     20..23 fpsDen
#     24..27 frameCount       (total frames in the ES stream)
#     28..31 esTotalBytes
#     32..35 rotation (i32)
#     36..39 keyframeCount
#     40..71 esIndexCid = sha256(full .moqidx bytes)
#     72..   keyframe table: keyframeCount × {frameIndex u32, offsetInEs u32, sizeBytes u32}
#   wire = content ++ manifestCid(32B = sha256(content));  total = 104 + 12*keyframeCount
#
# 边界（勿越）：本模块是 S1 事实合同雏形，S5 升格 csg_dialect::scene 正式方言；
# 不做逐内容编译、不碰 ES 字节（API 只接受索引 Bytes，构造上保证封签不扫描 ES）。
# 纯 int/Bytes 风格对齐 web_scene_media_network_bridge 同族（无 struct、receipt 为 int）。

import std/result
import std/rawbytes
import std/crypto/sha256

fn webSceneMediaFfReadLeU32(b: rawbytes.Bytes, off: int32): int32 =
    let b0: int32 = rawbytes.BytesGet(b, off) & 255
    let b1: int32 = rawbytes.BytesGet(b, off + 1) & 255
    let b2: int32 = rawbytes.BytesGet(b, off + 2) & 255
    let b3: int32 = rawbytes.BytesGet(b, off + 3) & 255
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn webSceneMediaFfWriteLeU32(b: var rawbytes.Bytes, off: int32, v: int32) =
    rawbytes.BytesSet(b, off, v & 255)
    rawbytes.BytesSet(b, off + 1, (v >> 8) & 255)
    rawbytes.BytesSet(b, off + 2, (v >> 16) & 255)
    rawbytes.BytesSet(b, off + 3, (v >> 24) & 255)

fn WebSceneMediaFactFirstContentLen(keyframeCount: int32): int32 =
    return 72 + keyframeCount * 12

fn WebSceneMediaFactFirstManifestLen(keyframeCount: int32): int32 =
    return WebSceneMediaFactFirstContentLen(keyframeCount) + 32

# Seal a `.moqidx` (exact format-2 bytes) into a CFFM v1 manifest (content ++ cid).
# Fails loud on: short buffer, bad magic, non-current format, non-exact byte length,
# zero frames, frame[0] not a keyframe (the gen tool's own invariant), zero keyframes.
fn WebSceneMediaFactFirstSeal(idx: rawbytes.Bytes): Result[rawbytes.Bytes] =
    let total: int32 = rawbytes.BytesLen(idx)
    if total < 36:
        return Err[rawbytes.Bytes]("factfirst: index shorter than MQES header")
    if rawbytes.BytesGet(idx, 0) != 77 || rawbytes.BytesGet(idx, 1) != 81 ||
       rawbytes.BytesGet(idx, 2) != 69 || rawbytes.BytesGet(idx, 3) != 83:
        return Err[rawbytes.Bytes]("factfirst: magic mismatch, expected MQES")
    let format: int32 = webSceneMediaFfReadLeU32(idx, 4)
    if format != 2:
        return Err[rawbytes.Bytes]("factfirst: unsupported moqidx format")
    let count: int32 = webSceneMediaFfReadLeU32(idx, 24)
    if count <= 0:
        return Err[rawbytes.Bytes]("factfirst: zero frame count")
    if total != 36 + count * 12:
        return Err[rawbytes.Bytes]("factfirst: non-exact index byte length")
    if (webSceneMediaFfReadLeU32(idx, 44) & 1) != 1:
        return Err[rawbytes.Bytes]("factfirst: frame[0] is not a keyframe")

    # Pass 1: count keyframes (flags bit0, entry i at 36 + i*12 + 8).
    var kfCount: int32
    var i: int32
    while i < count:
        if (webSceneMediaFfReadLeU32(idx, 44 + i * 12) & 1) == 1:
            kfCount = kfCount + 1
        i = i + 1
    if kfCount <= 0:
        return Err[rawbytes.Bytes]("factfirst: zero keyframes")

    let esIndexCid: rawbytes.Bytes = sha256.Sha256Digest(idx)
    if rawbytes.BytesLen(esIndexCid) != 32:
        return Err[rawbytes.Bytes]("factfirst: esIndexCid digest length mismatch")

    let contentLen: int32 = WebSceneMediaFactFirstContentLen(kfCount)
    var content: rawbytes.Bytes = rawbytes.BytesAlloc(contentLen)
    webSceneMediaFfWriteLeU32(content, 0, 0x4D464643)  # "CFFM" little-endian
    webSceneMediaFfWriteLeU32(content, 4, 1)           # version
    webSceneMediaFfWriteLeU32(content, 8, webSceneMediaFfReadLeU32(idx, 8))    # width
    webSceneMediaFfWriteLeU32(content, 12, webSceneMediaFfReadLeU32(idx, 12))  # height
    webSceneMediaFfWriteLeU32(content, 16, webSceneMediaFfReadLeU32(idx, 16))  # fpsNum
    webSceneMediaFfWriteLeU32(content, 20, webSceneMediaFfReadLeU32(idx, 20))  # fpsDen
    webSceneMediaFfWriteLeU32(content, 24, count)
    webSceneMediaFfWriteLeU32(content, 28, webSceneMediaFfReadLeU32(idx, 28))  # esTotalBytes
    webSceneMediaFfWriteLeU32(content, 32, webSceneMediaFfReadLeU32(idx, 32))  # rotation
    webSceneMediaFfWriteLeU32(content, 36, kfCount)
    var ci: int32
    while ci < 32:
        rawbytes.BytesSet(content, 40 + ci, rawbytes.BytesGet(esIndexCid, ci))
        ci = ci + 1

    # Pass 2: copy keyframe entries {frameIndex, offsetInEs, sizeBytes}.
    var k: int32
    var w: int32 = 72
    while k < count:
        if (webSceneMediaFfReadLeU32(idx, 44 + k * 12) & 1) == 1:
            webSceneMediaFfWriteLeU32(content, w, k)
            webSceneMediaFfWriteLeU32(content, w + 4, webSceneMediaFfReadLeU32(idx, 36 + k * 12))
            webSceneMediaFfWriteLeU32(content, w + 8, webSceneMediaFfReadLeU32(idx, 40 + k * 12))
            w = w + 12
        k = k + 1

    let manifestCid: rawbytes.Bytes = sha256.Sha256Digest(content)
    var wire: rawbytes.Bytes = rawbytes.BytesAlloc(contentLen + 32)
    var c: int32
    while c < contentLen:
        rawbytes.BytesSet(wire, c, rawbytes.BytesGet(content, c))
        c = c + 1
    ci = 0
    while ci < 32:
        rawbytes.BytesSet(wire, contentLen + ci, rawbytes.BytesGet(manifestCid, ci))
        ci = ci + 1
    return Ok[rawbytes.Bytes](wire)

# Verify wire integrity: length/magic/version + manifestCid recomputation.
# 0=ok 1=short 2=magic 3=version 4=cid mismatch.
fn WebSceneMediaFactFirstVerify(m: rawbytes.Bytes): int32 =
    let total: int32 = rawbytes.BytesLen(m)
    if total < 104:
        return 1
    if rawbytes.BytesGet(m, 0) != 67 || rawbytes.BytesGet(m, 1) != 70 ||
       rawbytes.BytesGet(m, 2) != 70 || rawbytes.BytesGet(m, 3) != 77:
        return 2
    if webSceneMediaFfReadLeU32(m, 4) != 1:
        return 3
    let kfCount: int32 = webSceneMediaFfReadLeU32(m, 36)
    let contentLen: int32 = WebSceneMediaFactFirstContentLen(kfCount)
    if total != contentLen + 32:
        return 1
    var content: rawbytes.Bytes = rawbytes.BytesAlloc(contentLen)
    var c: int32
    while c < contentLen:
        rawbytes.BytesSet(content, c, rawbytes.BytesGet(m, c))
        c = c + 1
    let expect: rawbytes.Bytes = sha256.Sha256Digest(content)
    var ci: int32
    while ci < 32:
        if rawbytes.BytesGet(m, contentLen + ci) != rawbytes.BytesGet(expect, ci):
            return 4
        ci = ci + 1
    return 0

fn WebSceneMediaFactFirstWidth(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 8)

fn WebSceneMediaFactFirstHeight(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 12)

fn WebSceneMediaFactFirstFpsNum(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 16)

fn WebSceneMediaFactFirstFpsDen(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 20)

fn WebSceneMediaFactFirstFrameCount(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 24)

fn WebSceneMediaFactFirstEsTotalBytes(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 28)

fn WebSceneMediaFactFirstKeyframeCount(m: rawbytes.Bytes): int32 =
    return webSceneMediaFfReadLeU32(m, 36)

fn WebSceneMediaFactFirstKeyframeFrame(m: rawbytes.Bytes, k: int32): int32 =
    return webSceneMediaFfReadLeU32(m, 72 + k * 12)

fn WebSceneMediaFactFirstKeyframeOffset(m: rawbytes.Bytes, k: int32): int32 =
    return webSceneMediaFfReadLeU32(m, 76 + k * 12)

fn WebSceneMediaFactFirstKeyframeSize(m: rawbytes.Bytes, k: int32): int32 =
    return webSceneMediaFfReadLeU32(m, 80 + k * 12)

# Receiver-side seek purely from facts: largest keyframe frameIndex <= target.
# target below the first keyframe or past the end clamps (first is frame 0 by
# the seal invariant, so the result is always a real keyframe row).
fn WebSceneMediaFactFirstSnapToKeyframe(m: rawbytes.Bytes, target: int32): int32 =
    let kfCount: int32 = WebSceneMediaFactFirstKeyframeCount(m)
    if kfCount <= 0:
        return -1
    var best: int32 = WebSceneMediaFactFirstKeyframeFrame(m, 0)
    var k: int32
    while k < kfCount:
        let f: int32 = WebSceneMediaFactFirstKeyframeFrame(m, k)
        if f <= target:
            best = f
        else:
            k = kfCount
        k = k + 1
    return best

# Byte length of the k-th GOP: [kf[k].offset, kf[k+1].offset | esTotal).
fn WebSceneMediaFactFirstGopByteLen(m: rawbytes.Bytes, k: int32): int32 =
    let kfCount: int32 = WebSceneMediaFactFirstKeyframeCount(m)
    if k < 0 || k >= kfCount:
        return -1
    let start: int32 = WebSceneMediaFactFirstKeyframeOffset(m, k)
    var endOff: int32 = WebSceneMediaFactFirstEsTotalBytes(m)
    if k + 1 < kfCount:
        endOff = WebSceneMediaFactFirstKeyframeOffset(m, k + 1)
    return endOff - start

# 首帧预算：接收端起播前需要兑现的精确字节数（仅凭 facts 可算）。
fn WebSceneMediaFactFirstFirstGopByteLen(m: rawbytes.Bytes): int32 =
    return WebSceneMediaFactFirstGopByteLen(m, 0)
