@borrows
fn productionHeldExecIdentityStrictValid(
        value: CsgCoreProductionHeldExecIdentity): bool =
    if value.device == uint64(0) ||
       value.inode == uint64(0) ||
       (value.mode & productionHeldExecFileTypeMask) !=
           productionHeldExecRegularFileMode ||
       (value.mode & productionHeldExecWriteModeMask) != 0 ||
       (value.mode & productionHeldExecExecuteModeMask) == 0 ||
       value.linkCount != uint64(1) ||
       value.size <= int64(0) ||
       value.mtimeSec < int64(0) ||
       value.mtimeNsec < int64(0) || value.mtimeNsec >= int64(1000000000) ||
       value.ctimeSec < int64(0) ||
       value.ctimeNsec < int64(0) || value.ctimeNsec >= int64(1000000000):
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.bytesCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.externalAnchorCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.immutableReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.heldDescriptorTokenCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.heldDescriptorIdentityCid):
        return false
    if value.bytesCid == value.externalAnchorCid ||
       value.bytesCid == value.immutableReceiptCid ||
       value.bytesCid == value.heldDescriptorTokenCid ||
       value.externalAnchorCid == value.immutableReceiptCid ||
       value.immutableReceiptCid == value.heldDescriptorTokenCid:
        return false
    return value.heldDescriptorIdentityCid ==
        CsgCoreProductionHeldExecProviderIdentityCid(value)

@borrows
fn productionHeldExecScopeValid(value: str): bool =
    return value == CsgCoreProductionHeldExecScopeMilestones ||
        value == CsgCoreProductionHeldExecScopeSystemLink ||
        value == CsgCoreProductionHeldExecScopeRelfacts

@borrows
fn productionHeldExecWorkloadStrictValid(
        value: CsgCoreProductionHeldExecWorkloadBinding,
        scope: str): bool =
    if value.executionScope != scope:
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.commandCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.inputSetCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.outputContractCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.executableObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.argvCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.environmentCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.planReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.proofCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.admissionReceiptCid) ||
       value.commandCid == value.inputSetCid ||
       value.commandCid == value.outputContractCid ||
       value.inputSetCid == value.outputContractCid ||
       value.argvCid == value.environmentCid ||
       value.argvCid == value.executableObjectCid ||
       value.environmentCid == value.executableObjectCid ||
       value.executableObjectCid == value.planReceiptCid ||
       value.planReceiptCid == value.proofCid ||
       value.proofCid == value.admissionReceiptCid:
        return false
    if scope != CsgCoreProductionHeldExecScopeSystemLink:
        return value.currentHeadCid.len == 0 &&
            value.manifestCid.len == 0 &&
            value.csgcObjectCid.len == 0 &&
            value.factsRoot.len == 0 &&
            value.csgAuthorityReceiptCid.len == 0
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.currentHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.csgAuthorityReceiptCid):
        return false
    return value.currentHeadCid != value.manifestCid &&
        value.currentHeadCid != value.csgcObjectCid &&
        value.manifestCid != value.csgcObjectCid &&
        value.factsRoot != value.csgcObjectCid

@borrows
fn productionHeldExecEventStrictValidateInto(
        value: CsgCoreProductionHeldExecEvent,
        expectedSequence: int32,
        expectedKind: str,
        expectedStateBefore: str,
        expectedStateAfter: str,
        expectedPreviousEventCid: str,
        expectedSubjectIdentityCid: str,
        expectedAdmissionClosed: bool,
        expectedHeldExecution: bool,
        expectedExecutionRelease: bool,
        expectedOutputPublication: bool,
        receipt: CsgCoreProductionHeldExecReceipt,
        err: var str): bool =
    if value.schema != CsgCoreProductionHeldExecProviderSchema ||
       value.sequence != expectedSequence ||
       value.kind != expectedKind ||
       value.stateBefore != expectedStateBefore ||
       value.stateAfter != expectedStateAfter:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEventOrder)
        return false
    if value.previousEventCid != expectedPreviousEventCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEventChain)
        return false
    if value.sessionGeneration != receipt.sessionGeneration ||
       value.sessionNonceCid != receipt.sessionNonceCid ||
       value.sessionCapabilityCid != receipt.sessionCapabilityCid ||
       value.providerAuthorityCid != receipt.providerAuthorityCid ||
       value.launcherIdentityCid !=
           receipt.launcherIdentity.heldDescriptorIdentityCid ||
       value.binaryIdentityCid !=
           receipt.binaryIdentity.heldDescriptorIdentityCid ||
       value.childProcessIdentityCid != receipt.childProcessIdentityCid ||
       value.subjectIdentityCid != expectedSubjectIdentityCid ||
       value.executableObjectCid != receipt.workload.executableObjectCid ||
       value.heldDescriptorIdentityCid !=
           receipt.binaryIdentity.heldDescriptorIdentityCid ||
       value.argvCid != receipt.workload.argvCid ||
       value.environmentCid != receipt.workload.environmentCid ||
       value.planReceiptCid != receipt.workload.planReceiptCid ||
       value.proofCid != receipt.workload.proofCid ||
       value.admissionReceiptCid != receipt.workload.admissionReceiptCid ||
       value.executionMethod != receipt.executionMethod:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEventBinding)
        return false
    if value.inputReadCountBeforeAdmission != int64(0):
        err = strings.CloneStr(
            CsgCoreProductionHeldExecErrInputReadBeforeAdmission)
        return false
    if value.admissionReceiptClosed != expectedAdmissionClosed:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrAdmissionOpen)
        return false
    if value.namedPathExecutionObserved:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrPathExecution)
        return false
    if value.heldDescriptorExecutionObserved != expectedHeldExecution:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrHeldExecution)
        return false
    if value.executionReleaseObserved != expectedExecutionRelease:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEarlyRelease)
        return false
    if value.outputPublicationObserved != expectedOutputPublication:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEarlyOutput)
        return false
    if value.eventCid !=
           CsgCoreProductionHeldExecProviderEventCid(value):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEventChain)
        return false
    err = ""
    return true

@borrows
fn CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
        receipt: CsgCoreProductionHeldExecReceipt,
        err: var str): bool =
    if receipt.schema != CsgCoreProductionHeldExecProviderSchema ||
       !receipt.complete || !receipt.singleConsumptionProven:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrSchema)
        return false
    if receipt.platform == CsgCoreProductionHeldExecLinux:
        if receipt.executionMethod != CsgCoreProductionHeldExecLinuxMethod:
            err = strings.CloneStr(CsgCoreProductionHeldExecErrPlatform)
            return false
    elif receipt.platform == CsgCoreProductionHeldExecDarwin:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecDarwinHardRed)
        return false
    else:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrPlatform)
        return false
    if !productionHeldExecScopeValid(receipt.executionScope):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrScope)
        return false
    if receipt.sessionGeneration == uint64(0) ||
       receipt.activationOrdinal == uint64(0) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.sessionNonceCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.sessionCapabilityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.providerAuthorityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.childProcessIdentityCid):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReceipt)
        return false
    if (receipt.previousSessionNonceCid.len == 0) !=
           (receipt.previousSessionCapabilityCid.len == 0) ||
       (receipt.previousSessionCapabilityCid.len == 0) !=
           (receipt.previousReceiptCid.len == 0) ||
       (receipt.previousReceiptCid.len == 0) !=
           (receipt.previousActivationOrdinal == uint64(0)):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReplay)
        return false
    if receipt.previousSessionNonceCid.len != 0:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               receipt.previousSessionNonceCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               receipt.previousSessionCapabilityCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               receipt.previousReceiptCid) ||
           receipt.previousSessionNonceCid == receipt.sessionNonceCid ||
           receipt.previousSessionCapabilityCid ==
               receipt.sessionCapabilityCid ||
           receipt.previousActivationOrdinal >= receipt.activationOrdinal ||
           receipt.previousReceiptCid == receipt.receiptCid:
            err = strings.CloneStr(CsgCoreProductionHeldExecErrReplay)
            return false
    if !productionHeldExecIdentityStrictValid(receipt.launcherIdentity) ||
       !productionHeldExecIdentityStrictValid(receipt.binaryIdentity):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrIdentity)
        return false
    if receipt.launcherIdentity.heldDescriptorIdentityCid ==
           receipt.binaryIdentity.heldDescriptorIdentityCid ||
       receipt.launcherIdentity.bytesCid == receipt.binaryIdentity.bytesCid ||
       receipt.launcherIdentity.heldDescriptorTokenCid ==
           receipt.binaryIdentity.heldDescriptorTokenCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrIdentityMismatch)
        return false
    if receipt.sessionCapabilityCid == receipt.sessionNonceCid ||
       receipt.providerAuthorityCid == receipt.sessionNonceCid ||
       receipt.providerAuthorityCid == receipt.sessionCapabilityCid ||
       receipt.providerAuthorityCid ==
           receipt.launcherIdentity.heldDescriptorIdentityCid ||
       receipt.providerAuthorityCid ==
           receipt.binaryIdentity.heldDescriptorIdentityCid ||
       receipt.childProcessIdentityCid ==
           receipt.binaryIdentity.heldDescriptorIdentityCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReceipt)
        return false
    if !productionHeldExecWorkloadStrictValid(
           receipt.workload, receipt.executionScope) ||
       receipt.workload.executableObjectCid != receipt.binaryIdentity.bytesCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrWorkloadBinding)
        return false
    var eventErr: str
    if !productionHeldExecEventStrictValidateInto(
           receipt.activated,
           1,
           CsgCoreProductionHeldExecEventActivated,
           CsgCoreProductionHeldExecStateEmpty,
           CsgCoreProductionHeldExecStateActivated,
           "",
           receipt.providerAuthorityCid,
           false,
           false,
           false,
           false,
           receipt,
           eventErr):
        err = eventErr
        return false
    if !productionHeldExecEventStrictValidateInto(
           receipt.launcherHeld,
           2,
           CsgCoreProductionHeldExecEventLauncherHeld,
           CsgCoreProductionHeldExecStateActivated,
           CsgCoreProductionHeldExecStateLauncherHeld,
           receipt.activated.eventCid,
           receipt.launcherIdentity.heldDescriptorIdentityCid,
           false,
           false,
           false,
           false,
           receipt,
           eventErr):
        err = eventErr
        return false
    if !productionHeldExecEventStrictValidateInto(
           receipt.binaryHeld,
           3,
           CsgCoreProductionHeldExecEventBinaryHeld,
           CsgCoreProductionHeldExecStateLauncherHeld,
           CsgCoreProductionHeldExecStateBinaryHeld,
           receipt.launcherHeld.eventCid,
           receipt.binaryIdentity.heldDescriptorIdentityCid,
           false,
           false,
           false,
           false,
           receipt,
           eventErr):
        err = eventErr
        return false
    if !productionHeldExecEventStrictValidateInto(
           receipt.zeroReadAdmitted,
           4,
           CsgCoreProductionHeldExecEventZeroReadAdmitted,
           CsgCoreProductionHeldExecStateBinaryHeld,
           CsgCoreProductionHeldExecStateAdmitted,
           receipt.binaryHeld.eventCid,
           receipt.providerAuthorityCid,
           true,
           false,
           false,
           false,
           receipt,
           eventErr):
        err = eventErr
        return false
    if !productionHeldExecEventStrictValidateInto(
           receipt.heldExecStarted,
           5,
           CsgCoreProductionHeldExecEventHeldExecStarted,
           CsgCoreProductionHeldExecStateAdmitted,
           CsgCoreProductionHeldExecStateExecuted,
           receipt.zeroReadAdmitted.eventCid,
           receipt.binaryIdentity.heldDescriptorIdentityCid,
           true,
           true,
           true,
           false,
           receipt,
           eventErr):
        err = eventErr
        return false
    if !productionHeldExecEventStrictValidateInto(
           receipt.childObserved,
           6,
           CsgCoreProductionHeldExecEventChildObserved,
           CsgCoreProductionHeldExecStateExecuted,
           CsgCoreProductionHeldExecStateObserved,
           receipt.heldExecStarted.eventCid,
           receipt.childProcessIdentityCid,
           true,
           true,
           true,
           false,
           receipt,
           eventErr):
        err = eventErr
        return false
    if !productionHeldExecEventStrictValidateInto(
           receipt.consumed,
           7,
           CsgCoreProductionHeldExecEventConsumed,
           CsgCoreProductionHeldExecStateObserved,
           CsgCoreProductionHeldExecStateConsumed,
           receipt.childObserved.eventCid,
           receipt.providerAuthorityCid,
           true,
           true,
           true,
           true,
           receipt,
           eventErr):
        err = eventErr
        return false
    if receipt.activated.eventCid == receipt.launcherHeld.eventCid ||
       receipt.launcherHeld.eventCid == receipt.binaryHeld.eventCid ||
       receipt.binaryHeld.eventCid == receipt.zeroReadAdmitted.eventCid ||
       receipt.zeroReadAdmitted.eventCid == receipt.heldExecStarted.eventCid ||
       receipt.heldExecStarted.eventCid == receipt.childObserved.eventCid ||
       receipt.childObserved.eventCid == receipt.consumed.eventCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReplay)
        return false
    if receipt.eventStreamCid !=
           CsgCoreProductionHeldExecProviderEventStreamCid(receipt):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrEventChain)
        return false
    if receipt.receiptCid !=
           CsgCoreProductionHeldExecProviderReceiptCid(receipt) ||
       receipt.receiptCid == receipt.eventStreamCid ||
       receipt.receiptCid == receipt.providerAuthorityCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReceipt)
        return false
    err = ""
    return true

# The only legal upstream that may deposit into the slot is the named
# launcher process-entry arming edge. The deposit is single-consumption: it
# validates the activation shape, the receipt seal, the workload executable
# binding and the session capability binding, then release-stores the receipt
# and publishes ISSUED exactly once. A second deposit on a live slot is
# rejected.
fn CsgCoreProductionHeldExecProviderDepositActivationInto(
        activation: CsgCoreProductionLauncherActivation,
        receipt: CsgCoreProductionHeldExecReceipt,
        err: var str): bool =
    if !CsgCoreProductionHeldExecActivationShapeStrictValid(activation):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReceipt)
        return false
    if !receipt.complete || !receipt.singleConsumptionProven:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrReceipt)
        return false
    if receipt.workload.executableObjectCid != activation.executableObjectCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrWorkloadBinding)
        return false
    if receipt.sessionGeneration != activation.sessionGeneration ||
       receipt.sessionNonceCid != activation.sessionNonceCid ||
       receipt.sessionCapabilityCid != activation.sessionCapabilityCid:
        err = strings.CloneStr(CsgCoreProductionHeldExecErrSessionBinding)
        return false
    # Reserve the only producer slot before touching the managed receipt.
    if !system.RuntimeAtomicCompareExchangeI32(
           productionHeldExecProviderSlotState, 0, 1):
        err = strings.CloneStr(CsgCoreProductionHeldExecErrSingleConsumption)
        return false
    # Full admission + retained descriptor + child observation must all have
    # succeeded before the slot publishes: re-run the frozen strict validator
    # on the exact receipt the launcher sealed.
    var validateErr: str
    if !CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
           receipt, validateErr):
        productionHeldExecProviderSlotReceipt =
            CsgCoreProductionHeldExecReceipt()
        system.RuntimeAtomicStoreI32(
            productionHeldExecProviderSlotState, 4)
        err = validateErr
        return false
    productionHeldExecProviderSlotReceipt = receipt
    system.RuntimeAtomicStoreI32(productionHeldExecProviderSlotState, 2)
    err = ""
    return true

fn productionHeldExecProviderReceiveActivatedEventStreamInto(
        out: var CsgCoreProductionHeldExecReceipt,
        err: var str): bool =
    # One-shot event delivery boundary. No pathname, process environment,
    # repository value, or caller-supplied observation can enter. The only
    # source is the runtime-owned activation slot: when it is empty the
    # boundary fails closed with the exact arming HARD_RED; once the launcher
    # arming edge deposits a validated receipt the slot publishes it exactly
    # once.
    out = CsgCoreProductionHeldExecReceipt()
    if !system.RuntimeAtomicCompareExchangeI32(
           productionHeldExecProviderSlotState, 2, 3):
        err = strings.CloneStr(CsgCoreProductionHeldExecActivationArmingHardRed)
        return false
    out = productionHeldExecProviderSlotReceipt
    productionHeldExecProviderSlotReceipt =
        CsgCoreProductionHeldExecReceipt()
    system.RuntimeAtomicStoreI32(productionHeldExecProviderSlotState, 4)
    err = ""
    return true

fn CsgCoreProductionHeldExecProviderIssueInto(
        out: var CsgCoreProductionHeldExecReceipt,
        err: var str): bool =
    out = CsgCoreProductionHeldExecReceipt()
    var candidate: CsgCoreProductionHeldExecReceipt
    if !productionHeldExecProviderReceiveActivatedEventStreamInto(
           candidate, err):
        return false
    if !CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
           candidate, err):
        return false
    out = candidate
    err = ""
    return true

fn CsgCoreProductionHeldExecProviderAvailable(): bool =
    return system.RuntimeAtomicLoadI32(
        productionHeldExecProviderSlotState) == 2

@borrows
fn productionPreExecInputAppendCid(
        out: var layout.ByteBuf,
        value: str) =
    var parsed: layout.FixedBytes32
    if merkle_store_codec.csgStoreCodecParseCid(value, parsed):
        layout.ByteBufAppendFixed32(out, parsed)

@borrows
fn productionPreExecInputCommandCid(command: int32): str =
    var buf = layout.ByteBufInit(8)
    productionHeldExecAppendU32(
        buf, CsgCoreProductionPreExecInputSchemaVersion)
    productionHeldExecAppendU32(buf, command)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPreExecInputCommandDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionPreExecInputOriginCid(
        packageSourceRootIdentityCid: str,
        sourceClosureCid: str,
        executableCid: str): str =
    var buf = layout.ByteBufInit(128)
    productionPreExecInputAppendCid(
        buf, packageSourceRootIdentityCid)
    productionPreExecInputAppendCid(buf, sourceClosureCid)
    productionPreExecInputAppendCid(buf, executableCid)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPreExecInputOriginDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionPreExecInputRequestIdentityCid(
        rawEnvelopeCid: str,
        semanticCommandCid: str,
        packageSourceRootIdentityCid: str,
        sourceClosureCid: str,
        executableCid: str,
        originCid: str): str =
    var buf = layout.ByteBufInit(224)
    productionPreExecInputAppendCid(buf, rawEnvelopeCid)
    productionPreExecInputAppendCid(buf, semanticCommandCid)
    productionPreExecInputAppendCid(
        buf, packageSourceRootIdentityCid)
    productionPreExecInputAppendCid(buf, sourceClosureCid)
    productionPreExecInputAppendCid(buf, executableCid)
    productionPreExecInputAppendCid(buf, originCid)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPreExecInputRequestIdentityDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionPreExecInputOwnerReceiptCid(
        receipt: CsgCoreProductionPreExecInputOwnerReceipt): str =
    var buf = layout.ByteBufInit(320)
    productionHeldExecAppendU32(buf, receipt.schemaVersion)
    productionPreExecInputAppendCid(buf, receipt.rawEnvelopeCid)
    productionPreExecInputAppendCid(buf, receipt.semanticCommandCid)
    productionPreExecInputAppendCid(
        buf, receipt.packageSourceRootIdentityCid)
    productionPreExecInputAppendCid(buf, receipt.sourceClosureCid)
    productionPreExecInputAppendCid(buf, receipt.executableCid)
    productionPreExecInputAppendCid(buf, receipt.originCid)
    productionPreExecInputAppendCid(buf, receipt.requestIdentityCid)
    productionHeldExecAppendU32(buf, receipt.byteCount)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionPreExecInputOwnerReceiptDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionPreExecInputOwnerReceiptFromDecodedInto(
        envelopeBytes: str,
        rawEnvelopeCid: str,
        decoded: CsgCoreProductionPreExecInput,
        sourceClosureCid: str,
        executableCid: str,
        out: var CsgCoreProductionPreExecInputOwnerReceipt): bool =
    out = CsgCoreProductionPreExecInputOwnerReceipt()
    if envelopeBytes.len <= 0 ||
       envelopeBytes.len > CsgCoreProductionPreExecInputMaxBytes ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(rawEnvelopeCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(sourceClosureCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(executableCid) ||
       rawEnvelopeCid == sourceClosureCid ||
       rawEnvelopeCid == executableCid ||
       sourceClosureCid == executableCid:
        return false
    out.schemaVersion = CsgCoreProductionPreExecInputSchemaVersion
    out.rawEnvelopeCid = strings.CloneStr(rawEnvelopeCid)
    out.semanticCommandCid = productionPreExecInputCommandCid(
        decoded.semanticCommand)
    out.packageSourceRootIdentityCid = strings.CloneStr(
        decoded.packageSourceRootIdentityCid)
    out.sourceClosureCid = strings.CloneStr(sourceClosureCid)
    out.executableCid = strings.CloneStr(executableCid)
    out.originCid = productionPreExecInputOriginCid(
        out.packageSourceRootIdentityCid,
        out.sourceClosureCid,
        out.executableCid)
    out.requestIdentityCid = productionPreExecInputRequestIdentityCid(
        out.rawEnvelopeCid,
        out.semanticCommandCid,
        out.packageSourceRootIdentityCid,
        out.sourceClosureCid,
        out.executableCid,
        out.originCid)
    out.byteCount = envelopeBytes.len
    out.complete = true
    out.receiptCid = productionPreExecInputOwnerReceiptCid(out)
    return CsgCoreProductionPreExecInputOwnerReceiptStrictValid(out)

@borrows
fn productionPreExecInputOwnerReceiptsEqual(
        left: CsgCoreProductionPreExecInputOwnerReceipt,
        right: CsgCoreProductionPreExecInputOwnerReceipt): bool =
    return left.schemaVersion == right.schemaVersion &&
        left.rawEnvelopeCid == right.rawEnvelopeCid &&
        left.semanticCommandCid == right.semanticCommandCid &&
        left.packageSourceRootIdentityCid ==
            right.packageSourceRootIdentityCid &&
        left.sourceClosureCid == right.sourceClosureCid &&
        left.executableCid == right.executableCid &&
        left.originCid == right.originCid &&
        left.requestIdentityCid == right.requestIdentityCid &&
        left.byteCount == right.byteCount &&
        left.receiptCid == right.receiptCid &&
        left.complete == right.complete

# The activation bundle is the only byte stream delivered to a child.  It
# contains the canonical portable envelope plus the two upstream object
# identities that cannot be derived from that envelope.  The owner receipt is
# re-derived on decode; only its CID is transported, so no caller-supplied
# receipt fields can acquire authority.
@borrows
fn CsgCoreProductionPreExecActivationBundleEncodeInto(
        envelopeBytes: str,
        ownerReceipt: CsgCoreProductionPreExecInputOwnerReceipt,
        outBundleBytes: var str,
        outBundleCid: var str,
        err: var str): bool =
    outBundleBytes = ""
    outBundleCid = ""
    var decoded: CsgCoreProductionPreExecInput
    var rawEnvelopeCid: str
    if !CsgCoreProductionPreExecInputDecodeStrictInto(
           envelopeBytes, decoded, rawEnvelopeCid, err):
        return false
    var derived: CsgCoreProductionPreExecInputOwnerReceipt
    if !productionPreExecInputOwnerReceiptFromDecodedInto(
           envelopeBytes,
           rawEnvelopeCid,
           decoded,
           ownerReceipt.sourceClosureCid,
           ownerReceipt.executableCid,
           derived) ||
       !productionPreExecInputOwnerReceiptsEqual(derived, ownerReceipt):
        err = "production_pre_exec_activation_e_owner_receipt"
        return false
    let totalBytes = CsgCoreProductionPreExecActivationHeaderBytes +
        envelopeBytes.len + CsgCoreProductionPreExecActivationCidBytes * 3
    if totalBytes <= 0 ||
       totalBytes > CsgCoreProductionPreExecActivationMaxBytes:
        err = "production_pre_exec_activation_e_length"
        return false
    var buf = layout.ByteBufInit(totalBytes)
    productionHeldExecAppendU32(
        buf, CsgCoreProductionPreExecActivationSchemaVersion)
    productionHeldExecAppendU32(buf, envelopeBytes.len)
    for byteIndex in 0..<envelopeBytes.len:
        layout.ByteBufAppendByte(buf, envelopeBytes[byteIndex])
    for byteIndex in 0..<ownerReceipt.sourceClosureCid.len:
        layout.ByteBufAppendByte(
            buf, ownerReceipt.sourceClosureCid[byteIndex])
    for byteIndex in 0..<ownerReceipt.executableCid.len:
        layout.ByteBufAppendByte(buf, ownerReceipt.executableCid[byteIndex])
    for byteIndex in 0..<ownerReceipt.receiptCid.len:
        layout.ByteBufAppendByte(buf, ownerReceipt.receiptCid[byteIndex])
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes))
    outBundleCid = "sha256:" + layout.FixedBytes32Hex(digest)
    outBundleBytes = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    if outBundleBytes.len != totalBytes ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(outBundleCid):
        outBundleBytes = ""
        outBundleCid = ""
        err = "production_pre_exec_activation_e_identity"
        return false
    err = ""
    return true

@borrows
fn CsgCoreProductionPreExecActivationBundleDecodeStrictInto(
        bundleBytes: str,
        outEnvelopeBytes: var str,
        outInput: var CsgCoreProductionPreExecInput,
        outOwnerReceipt: var CsgCoreProductionPreExecInputOwnerReceipt,
        outBundleCid: var str,
        err: var str): bool =
    outEnvelopeBytes = ""
    outInput = CsgCoreProductionPreExecInput()
    outOwnerReceipt = CsgCoreProductionPreExecInputOwnerReceipt()
    outBundleCid = ""
    let fixedBytes = CsgCoreProductionPreExecActivationHeaderBytes +
        CsgCoreProductionPreExecActivationCidBytes * 3
    if bundleBytes.len <= fixedBytes ||
       bundleBytes.len > CsgCoreProductionPreExecActivationMaxBytes ||
       productionHeldBundleReadU32(bundleBytes, 0) !=
           CsgCoreProductionPreExecActivationSchemaVersion:
        err = "production_pre_exec_activation_e_length"
        return false
    let envelopeBytes = productionHeldBundleReadU32(bundleBytes, 4)
    if envelopeBytes <= 0 || envelopeBytes != bundleBytes.len - fixedBytes:
        err = "production_pre_exec_activation_e_envelope_length"
        return false
    let sourceOffset = CsgCoreProductionPreExecActivationHeaderBytes +
        envelopeBytes
    let executableOffset = sourceOffset +
        CsgCoreProductionPreExecActivationCidBytes
    let receiptOffset = executableOffset +
        CsgCoreProductionPreExecActivationCidBytes
    outEnvelopeBytes = strings.CloneStr(strings.SliceBytes(
        bundleBytes,
        CsgCoreProductionPreExecActivationHeaderBytes,
        envelopeBytes))
    let sourceClosureCid = strings.CloneStr(strings.SliceBytes(
        bundleBytes,
        sourceOffset,
        CsgCoreProductionPreExecActivationCidBytes))
    let executableCid = strings.CloneStr(strings.SliceBytes(
        bundleBytes,
        executableOffset,
        CsgCoreProductionPreExecActivationCidBytes))
    let ownerReceiptCid = strings.CloneStr(strings.SliceBytes(
        bundleBytes,
        receiptOffset,
        CsgCoreProductionPreExecActivationCidBytes))
    var rawEnvelopeCid: str
    if !CsgCoreProductionPreExecInputDecodeStrictInto(
           outEnvelopeBytes, outInput, rawEnvelopeCid, err) ||
       !productionPreExecInputOwnerReceiptFromDecodedInto(
           outEnvelopeBytes,
           rawEnvelopeCid,
           outInput,
           sourceClosureCid,
           executableCid,
           outOwnerReceipt) ||
       outOwnerReceipt.receiptCid != ownerReceiptCid:
        outEnvelopeBytes = ""
        outInput = CsgCoreProductionPreExecInput()
        outOwnerReceipt = CsgCoreProductionPreExecInputOwnerReceipt()
        err = "production_pre_exec_activation_e_owner_receipt"
        return false
    var canonicalBytes: str
    var canonicalCid: str
    var encodeErr: str
    if !CsgCoreProductionPreExecActivationBundleEncodeInto(
           outEnvelopeBytes,
           outOwnerReceipt,
           canonicalBytes,
           canonicalCid,
           encodeErr) || canonicalBytes != bundleBytes:
        outEnvelopeBytes = ""
        outInput = CsgCoreProductionPreExecInput()
        outOwnerReceipt = CsgCoreProductionPreExecInputOwnerReceipt()
        err = "production_pre_exec_activation_e_noncanonical"
        return false
    outBundleCid = strings.CloneStr(canonicalCid)
    err = ""
    return true

@borrows
fn CsgCoreProductionPreExecInputOwnerReceiptStrictValid(
        receipt: CsgCoreProductionPreExecInputOwnerReceipt): bool =
    if !receipt.complete ||
       receipt.schemaVersion !=
           CsgCoreProductionPreExecInputSchemaVersion ||
       receipt.byteCount <= 0 ||
       receipt.byteCount > CsgCoreProductionPreExecInputMaxBytes:
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.rawEnvelopeCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.semanticCommandCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.packageSourceRootIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.sourceClosureCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.executableCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.originCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.requestIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.receiptCid):
        return false
    if receipt.rawEnvelopeCid == receipt.sourceClosureCid ||
       receipt.rawEnvelopeCid == receipt.executableCid ||
       receipt.sourceClosureCid == receipt.executableCid ||
       receipt.originCid == receipt.requestIdentityCid ||
       receipt.receiptCid == receipt.requestIdentityCid:
        return false
    return receipt.receiptCid ==
        productionPreExecInputOwnerReceiptCid(receipt)

fn productionPreExecInputOwnerRegistryEnsure(): bool =
    if system.RuntimeAtomicLoadI32(
           productionPreExecInputOwnerRegistryInit) == 2:
        return true
    if !system.RuntimeAtomicCompareExchangeI32(
           productionPreExecInputOwnerRegistryInit, 0, 1):
        return false
    productionPreExecInputOwnerSlotStates = []
    setLen(productionPreExecInputOwnerSlotGenerations,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotRawEnvelopeCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotSemanticCommandCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotPackageSourceRootIdentityCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotSourceClosureCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotExecutableCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotOriginCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotRequestIdentityCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotByteCounts,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerSlotReceiptCids,
        CsgCoreProductionPreExecInputOwnerSlotCount)
    setLen(productionPreExecInputOwnerHandleResourceSlots,
        CsgCoreProductionPreExecInputOwnerHandleRowCount)
    setLen(productionPreExecInputOwnerHandleGenerations,
        CsgCoreProductionPreExecInputOwnerHandleRowCount)
    setLen(productionPreExecInputOwnerHandleReceiptCids,
        CsgCoreProductionPreExecInputOwnerHandleRowCount)
    for slot in 0..<CsgCoreProductionPreExecInputOwnerSlotCount:
        add(productionPreExecInputOwnerSlotStates,
            atomic.NewI32(0))
        productionPreExecInputOwnerSlotGenerations[slot] = uint64(0)
        productionPreExecInputOwnerSlotRawEnvelopeCids[slot] = ""
        productionPreExecInputOwnerSlotSemanticCommandCids[slot] = ""
        productionPreExecInputOwnerSlotPackageSourceRootIdentityCids[slot] = ""
        productionPreExecInputOwnerSlotSourceClosureCids[slot] = ""
        productionPreExecInputOwnerSlotExecutableCids[slot] = ""
        productionPreExecInputOwnerSlotOriginCids[slot] = ""
        productionPreExecInputOwnerSlotRequestIdentityCids[slot] = ""
        productionPreExecInputOwnerSlotByteCounts[slot] = 0
        productionPreExecInputOwnerSlotReceiptCids[slot] = ""
        if productionPreExecInputOwnerSlotStates[slot] == nil:
            system.RuntimeAtomicStoreI32(
                productionPreExecInputOwnerRegistryInit, 0)
            return false
    if productionPreExecInputOwnerSlotStates.len !=
            CsgCoreProductionPreExecInputOwnerSlotCount:
        system.RuntimeAtomicStoreI32(
            productionPreExecInputOwnerRegistryInit, 0)
        return false
    for row in 0..<CsgCoreProductionPreExecInputOwnerHandleRowCount:
        productionPreExecInputOwnerHandleResourceSlots[row] = int32(-1)
        productionPreExecInputOwnerHandleGenerations[row] = uint64(0)
        productionPreExecInputOwnerHandleReceiptCids[row] = ""
    productionPreExecInputOwnerHandleNextRow = atomic.NewI32(0)
    if productionPreExecInputOwnerHandleNextRow == nil:
        system.RuntimeAtomicStoreI32(
            productionPreExecInputOwnerRegistryInit, 0)
        return false
    system.RuntimeAtomicStoreI32(
        productionPreExecInputOwnerRegistryInit, 2)
    return true

fn productionPreExecInputOwnerHandleShapeValid(
        handle: var CsgCoreProductionPreExecInputOwnerHandle): bool =
    if handle.handleRow < 0 ||
       handle.handleRow >=
           CsgCoreProductionPreExecInputOwnerHandleRowCount ||
       productionPreExecInputOwnerHandleNextRow == nil ||
       handle.handleRow >=
           atomic.LoadI32(productionPreExecInputOwnerHandleNextRow):
        return false
    let slot = productionPreExecInputOwnerHandleResourceSlots[
        handle.handleRow]
    return slot >= 0 &&
        slot < CsgCoreProductionPreExecInputOwnerSlotCount &&
        productionPreExecInputOwnerHandleGenerations[handle.handleRow] >
            uint64(0) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            productionPreExecInputOwnerHandleReceiptCids[
                handle.handleRow])

fn productionPreExecInputOwnerSlotMatches(
        slot: int32,
        handle: var CsgCoreProductionPreExecInputOwnerHandle): bool =
    if !productionPreExecInputOwnerHandleShapeValid(handle) ||
       productionPreExecInputOwnerHandleResourceSlots[handle.handleRow] !=
           slot:
        return false
    return productionPreExecInputOwnerSlotGenerations[slot] ==
               productionPreExecInputOwnerHandleGenerations[
                   handle.handleRow] &&
        productionPreExecInputOwnerSlotReceiptCids[slot] ==
            productionPreExecInputOwnerHandleReceiptCids[
                handle.handleRow]

fn productionPreExecInputOwnerReceiptFromSlot(
        slot: int32,
        out: var CsgCoreProductionPreExecInputOwnerReceipt) =
    out = CsgCoreProductionPreExecInputOwnerReceipt()
    out.schemaVersion = CsgCoreProductionPreExecInputSchemaVersion
    out.rawEnvelopeCid = strings.CloneStr(
        productionPreExecInputOwnerSlotRawEnvelopeCids[slot])
    out.semanticCommandCid = strings.CloneStr(
        productionPreExecInputOwnerSlotSemanticCommandCids[slot])
    out.packageSourceRootIdentityCid = strings.CloneStr(
        productionPreExecInputOwnerSlotPackageSourceRootIdentityCids[slot])
    out.sourceClosureCid = strings.CloneStr(
        productionPreExecInputOwnerSlotSourceClosureCids[slot])
    out.executableCid = strings.CloneStr(
        productionPreExecInputOwnerSlotExecutableCids[slot])
    out.originCid = strings.CloneStr(
        productionPreExecInputOwnerSlotOriginCids[slot])
    out.requestIdentityCid = strings.CloneStr(
        productionPreExecInputOwnerSlotRequestIdentityCids[slot])
    out.byteCount = productionPreExecInputOwnerSlotByteCounts[slot]
    out.receiptCid = strings.CloneStr(
        productionPreExecInputOwnerSlotReceiptCids[slot])
    out.complete = true

@borrows
fn CsgCoreProductionPreExecInputOwnerIssueInto(
        envelopeBytes: str,
        sourceClosureCid: str,
        executableCid: str,
        outHandle: var CsgCoreProductionPreExecInputOwnerHandle,
        outReceipt: var CsgCoreProductionPreExecInputOwnerReceipt,
        err: var str): bool =
    outHandle = CsgCoreProductionPreExecInputOwnerHandle()
    outReceipt = CsgCoreProductionPreExecInputOwnerReceipt()
    var decoded: CsgCoreProductionPreExecInput
    var rawEnvelopeCid: str
    if !CsgCoreProductionPreExecInputDecodeStrictInto(
           envelopeBytes, decoded, rawEnvelopeCid, err):
        return false
    var receipt: CsgCoreProductionPreExecInputOwnerReceipt
    if !productionPreExecInputOwnerReceiptFromDecodedInto(
           envelopeBytes,
           rawEnvelopeCid,
           decoded,
           sourceClosureCid,
           executableCid,
           receipt) ||
       !productionPreExecInputOwnerRegistryEnsure():
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrAdmission)
        return false
    var slot: int32 = -1
    var priorState = CsgCoreProductionPreExecInputOwnerStateEmpty
    for scan in 0..<CsgCoreProductionPreExecInputOwnerSlotCount:
        if slot >= 0:
            break
        let prior = atomic.LoadI32(
            productionPreExecInputOwnerSlotStates[scan])
        if prior == CsgCoreProductionPreExecInputOwnerStateEmpty ||
           prior == CsgCoreProductionPreExecInputOwnerStateConsumed ||
           prior == CsgCoreProductionPreExecInputOwnerStateAborted:
            if atomic.CasI32(
                   productionPreExecInputOwnerSlotStates[scan],
                   prior,
                   CsgCoreProductionPreExecInputOwnerStateBuilding):
                if productionPreExecInputOwnerSlotGenerations[scan] +
                       uint64(1) == uint64(0):
                    atomic.StoreI32(
                        productionPreExecInputOwnerSlotStates[scan], prior)
                else:
                    slot = scan
                    priorState = prior
    if slot < 0:
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    let generation =
        productionPreExecInputOwnerSlotGenerations[slot] + uint64(1)
    productionPreExecInputOwnerSlotGenerations[slot] = generation
    productionPreExecInputOwnerSlotRawEnvelopeCids[slot] =
        strings.CloneStr(receipt.rawEnvelopeCid)
    productionPreExecInputOwnerSlotSemanticCommandCids[slot] =
        strings.CloneStr(receipt.semanticCommandCid)
    productionPreExecInputOwnerSlotPackageSourceRootIdentityCids[slot] =
        strings.CloneStr(receipt.packageSourceRootIdentityCid)
    productionPreExecInputOwnerSlotSourceClosureCids[slot] =
        strings.CloneStr(receipt.sourceClosureCid)
    productionPreExecInputOwnerSlotExecutableCids[slot] =
        strings.CloneStr(receipt.executableCid)
    productionPreExecInputOwnerSlotOriginCids[slot] =
        strings.CloneStr(receipt.originCid)
    productionPreExecInputOwnerSlotRequestIdentityCids[slot] =
        strings.CloneStr(receipt.requestIdentityCid)
    productionPreExecInputOwnerSlotByteCounts[slot] = receipt.byteCount
    productionPreExecInputOwnerSlotReceiptCids[slot] =
        strings.CloneStr(receipt.receiptCid)
    let handleRow = atomic.FetchAddI32(
        productionPreExecInputOwnerHandleNextRow, 1)
    if handleRow < 0 ||
       handleRow >= CsgCoreProductionPreExecInputOwnerHandleRowCount:
        atomic.StoreI32(
            productionPreExecInputOwnerSlotStates[slot],
            CsgCoreProductionPreExecInputOwnerStateAborted)
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    productionPreExecInputOwnerHandleResourceSlots[handleRow] = slot
    productionPreExecInputOwnerHandleGenerations[handleRow] = generation
    productionPreExecInputOwnerHandleReceiptCids[handleRow] =
        strings.CloneStr(receipt.receiptCid)
    var candidateHandle: CsgCoreProductionPreExecInputOwnerHandle
    candidateHandle.handleRow = handleRow
    if !productionPreExecInputOwnerSlotMatches(
           slot, candidateHandle):
        atomic.StoreI32(
            productionPreExecInputOwnerSlotStates[slot],
            CsgCoreProductionPreExecInputOwnerStateAborted)
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    atomic.StoreI32(
        productionPreExecInputOwnerSlotStates[slot],
        CsgCoreProductionPreExecInputOwnerStateIssued)
    outHandle = candidateHandle
    outReceipt = receipt
    err = ""
    return true

fn productionPreExecInputOwnerAcquireInto(
        handle: var CsgCoreProductionPreExecInputOwnerHandle,
        out: var CsgCoreProductionPreExecInputOwnerReceipt,
        err: var str): bool =
    out = CsgCoreProductionPreExecInputOwnerReceipt()
    if !productionPreExecInputOwnerHandleShapeValid(handle) ||
       !productionPreExecInputOwnerRegistryEnsure():
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrCapability)
        return false
    let slot = productionPreExecInputOwnerHandleResourceSlots[
        handle.handleRow]
    if !productionPreExecInputOwnerSlotMatches(slot, handle) ||
       !atomic.CasI32(
           productionPreExecInputOwnerSlotStates[slot],
           CsgCoreProductionPreExecInputOwnerStateIssued,
           CsgCoreProductionPreExecInputOwnerStateConsuming) ||
       !productionPreExecInputOwnerSlotMatches(slot, handle):
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrSingleConsumption)
        return false
    productionPreExecInputOwnerReceiptFromSlot(slot, out)
    if !CsgCoreProductionPreExecInputOwnerReceiptStrictValid(out):
        atomic.StoreI32(
            productionPreExecInputOwnerSlotStates[slot],
            CsgCoreProductionPreExecInputOwnerStateAborted)
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrAdmission)
        return false
    err = ""
    return true

fn productionPreExecInputOwnerRelease(
        handle: var CsgCoreProductionPreExecInputOwnerHandle): bool =
    if !productionPreExecInputOwnerHandleShapeValid(handle) ||
       !productionPreExecInputOwnerRegistryEnsure() ||
       !productionPreExecInputOwnerSlotMatches(
           productionPreExecInputOwnerHandleResourceSlots[
               handle.handleRow],
           handle):
        return false
    let slot = productionPreExecInputOwnerHandleResourceSlots[
        handle.handleRow]
    return atomic.CasI32(
        productionPreExecInputOwnerSlotStates[slot],
        CsgCoreProductionPreExecInputOwnerStateConsuming,
        CsgCoreProductionPreExecInputOwnerStateIssued)

fn productionPreExecInputOwnerCommitConsumed(
        handle: var CsgCoreProductionPreExecInputOwnerHandle): bool =
    if !productionPreExecInputOwnerHandleShapeValid(handle) ||
       !productionPreExecInputOwnerSlotMatches(
           productionPreExecInputOwnerHandleResourceSlots[
               handle.handleRow],
           handle):
        return false
    let slot = productionPreExecInputOwnerHandleResourceSlots[
        handle.handleRow]
    return atomic.CasI32(
        productionPreExecInputOwnerSlotStates[slot],
        CsgCoreProductionPreExecInputOwnerStateConsuming,
        CsgCoreProductionPreExecInputOwnerStateConsumed)

# The admitted-claim authority may move an already-issued producer row, but
# it never receives the reusable slot/generation/CID columns.  The returned
# receipt is an immutable value definition copied only after the unique
# ISSUED -> CONSUMING CAS; the public identity remains the positive int32 row.
fn CsgCoreProductionPreExecInputOwnerMoveReceiptInto(
        ownerHandle: int32,
        out: var CsgCoreProductionPreExecInputOwnerReceipt,
        err: var str): bool =
    var handle: CsgCoreProductionPreExecInputOwnerHandle
    handle.handleRow = ownerHandle - 1
    return productionPreExecInputOwnerAcquireInto(handle, out, err)

fn CsgCoreProductionPreExecInputOwnerMoveAbort(
        ownerHandle: int32): bool =
    var handle: CsgCoreProductionPreExecInputOwnerHandle
    handle.handleRow = ownerHandle - 1
    return productionPreExecInputOwnerRelease(handle)

fn CsgCoreProductionPreExecInputOwnerMoveCommit(
        ownerHandle: int32): bool =
    var handle: CsgCoreProductionPreExecInputOwnerHandle
    handle.handleRow = ownerHandle - 1
    return productionPreExecInputOwnerCommitConsumed(handle)

fn CsgCoreProductionPreExecInputOwnerAbortInto(
        handle: var CsgCoreProductionPreExecInputOwnerHandle,
        err: var str): bool =
    if !productionPreExecInputOwnerHandleShapeValid(handle) ||
       !productionPreExecInputOwnerRegistryEnsure() ||
       !productionPreExecInputOwnerSlotMatches(
           productionPreExecInputOwnerHandleResourceSlots[
               handle.handleRow],
           handle) ||
       !atomic.CasI32(
           productionPreExecInputOwnerSlotStates[
               productionPreExecInputOwnerHandleResourceSlots[
                   handle.handleRow]],
           CsgCoreProductionPreExecInputOwnerStateIssued,
           CsgCoreProductionPreExecInputOwnerStateAborted):
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrSingleConsumption)
        return false
    handle = CsgCoreProductionPreExecInputOwnerHandle()
    err = ""
    return true

@borrows
fn productionAdmittedInputCid(
        receipt: CsgCoreProductionPreExecInputOwnerReceipt,
        rootOwnerBindingCid: str,
        heldBundleCid: str): str =
    var buf = layout.ByteBufInit(256)
    productionHeldExecAppendText(buf, receipt.receiptCid)
    productionHeldExecAppendText(buf, receipt.rawEnvelopeCid)
    productionHeldExecAppendText(buf, receipt.requestIdentityCid)
    productionHeldExecAppendText(buf, rootOwnerBindingCid)
    productionHeldExecAppendText(buf, heldBundleCid)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionAdmittedInputDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionAdmittedInputLeaseCid(
        admittedInputCid: str,
        sessionGeneration: uint64,
        sessionNonceCid: str,
        generation: uint64,
        activationOrdinal: uint64): str =
    var buf = layout.ByteBufInit(256)
    productionHeldExecAppendText(buf, admittedInputCid)
    productionHeldExecAppendU64(buf, sessionGeneration)
    productionHeldExecAppendText(buf, sessionNonceCid)
    productionHeldExecAppendU64(buf, generation)
    productionHeldExecAppendU64(buf, activationOrdinal)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionAdmittedInputLeaseDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn productionAdmittedInputOwnerClaimCid(
        claimReceiptCid: str,
        leaseCid: str,
        heldBundleCid: str,
        requestIdentityCid: str,
        sessionGeneration: uint64,
        runtimeSession: int32,
        childPid: int32,
        childUid: uint32,
        childGid: uint32): str =
    var buf = layout.ByteBufInit(256)
    productionHeldExecAppendText(buf, claimReceiptCid)
    productionHeldExecAppendText(buf, leaseCid)
    productionHeldExecAppendText(buf, heldBundleCid)
    productionHeldExecAppendText(buf, requestIdentityCid)
    productionHeldExecAppendU64(buf, sessionGeneration)
    productionHeldExecAppendU32(buf, runtimeSession)
    productionHeldExecAppendU32(buf, childPid)
    var uidRemaining = childUid
    for byteIndex in 0..<4:
        layout.ByteBufAppendByte(
            buf, int32(uidRemaining % uint32(256)))
        uidRemaining = uidRemaining / uint32(256)
    var gidRemaining = childGid
    for byteIndex in 0..<4:
        layout.ByteBufAppendByte(
            buf, int32(gidRemaining % uint32(256)))
        gidRemaining = gidRemaining / uint32(256)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionAdmittedInputOwnerClaimDomain, bytes)
    rawbytes.BytesFree(bytes)
    return cid

fn CsgCoreProductionAdmittedInputAuthorityReady(): bool =
    if system.RuntimeAtomicLoadI32(
           productionAdmittedInputRegistryState) !=
           CsgCoreProductionAdmittedInputRegistryReady:
        return false
    return productionAdmittedInputRuntimeSessionCapability.handle !=
               uint64(0) &&
        productionAdmittedInputRuntimeSessionCapability.generation !=
            uint64(0) &&
        (productionAdmittedInputRuntimeSessionCapability.nonce0 !=
             uint64(0) ||
         productionAdmittedInputRuntimeSessionCapability.nonce1 !=
             uint64(0))

fn CsgCoreProductionAdmittedInputAuthorityInitializeBeforeFork(
        sessionCapability:
            var system.RuntimeAllocationLedgerSessionCapability,
        outPreflightCloseOwner: var int32): bool =
    outPreflightCloseOwner = -1
    if sessionCapability.handle == uint64(0) ||
       sessionCapability.generation == uint64(0) ||
       (sessionCapability.nonce0 == uint64(0) &&
        sessionCapability.nonce1 == uint64(0)):
        return false
    let prior = system.RuntimeAtomicLoadI32(
        productionAdmittedInputRegistryState)
    if prior != CsgCoreProductionAdmittedInputRegistryUninitialized ||
       !system.RuntimeAtomicCompareExchangeI32(
           productionAdmittedInputRegistryState,
           CsgCoreProductionAdmittedInputRegistryUninitialized,
           CsgCoreProductionAdmittedInputRegistryBuilding):
        return false
    let sessionNonceCid =
        CsgCoreProductionHeldExecProviderSessionNonceCid(
            sessionCapability)
    if sessionCapability.generation == uint64(0) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(sessionNonceCid):
        system.RuntimeAtomicStoreI32(
            productionAdmittedInputRegistryState,
            CsgCoreProductionAdmittedInputRegistryFailed)
        return false
    productionAdmittedInputSlotStates = []
    setLen(productionAdmittedInputSlotGenerations,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotSessionGenerations,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotSessionNonceCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotActivationOrdinals,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotRootOwners,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotBundleOwners,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotParentSessions,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotChildPids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotChildUids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotChildGids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotAdmittedInputCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotLeaseCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotRootOwnerBindingCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotHeldBundleCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotActivationBundleBytes,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotOwnerReceiptCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotRequestIdentityCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotClaimReceiptCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputSlotOwnerClaimReceiptCids,
        CsgCoreProductionAdmittedInputSlotCount)
    setLen(productionAdmittedInputHandleResourceSlots,
        CsgCoreProductionAdmittedInputHandleRowCount)
    productionAdmittedInputHandleStates = []
    setLen(productionAdmittedInputHandleGenerations,
        CsgCoreProductionAdmittedInputHandleRowCount)
    setLen(productionAdmittedInputHandleSessionGenerations,
        CsgCoreProductionAdmittedInputHandleRowCount)
    setLen(productionAdmittedInputHandleSessionNonceCids,
        CsgCoreProductionAdmittedInputHandleRowCount)
    setLen(productionAdmittedInputHandleAdmittedInputCids,
        CsgCoreProductionAdmittedInputHandleRowCount)
    setLen(productionAdmittedInputHandleLeaseCids,
        CsgCoreProductionAdmittedInputHandleRowCount)
    var ok = true
    for slot in 0..<CsgCoreProductionAdmittedInputSlotCount:
        add(productionAdmittedInputSlotStates,
            atomic.NewI32(0))
        if productionAdmittedInputSlotStates[slot] == nil:
            ok = false
        productionAdmittedInputSlotRootOwners[slot] = -1
        productionAdmittedInputSlotBundleOwners[slot] = -1
        productionAdmittedInputSlotParentSessions[slot] = -1
        productionAdmittedInputSlotChildPids[slot] = -1
    if productionAdmittedInputSlotStates.len !=
            CsgCoreProductionAdmittedInputSlotCount:
        ok = false
    for row in 0..<CsgCoreProductionAdmittedInputHandleRowCount:
        add(productionAdmittedInputHandleStates,
            atomic.NewI32(
                CsgCoreProductionAdmittedInputHandleUnpublished))
        if productionAdmittedInputHandleStates[row] == nil:
            ok = false
        productionAdmittedInputHandleResourceSlots[row] = -1
    if productionAdmittedInputHandleStates.len !=
            CsgCoreProductionAdmittedInputHandleRowCount:
        ok = false
    productionAdmittedInputHandleNextRow = atomic.NewI32(0)
    if productionAdmittedInputHandleNextRow == nil:
        ok = false
    if !ok:
        system.RuntimeAtomicStoreI32(
            productionAdmittedInputRegistryState,
            CsgCoreProductionAdmittedInputRegistryFailed)
        return false
    # The destination stays module-private in BUILDING.  Publish the exact
    # four-field logical owner only after the caller's value-def is cleared;
    # therefore no reachable state ever contains two live authorities.
    productionAdmittedInputRuntimeSessionCapability.handle =
        sessionCapability.handle
    productionAdmittedInputRuntimeSessionCapability.generation =
        sessionCapability.generation
    productionAdmittedInputRuntimeSessionCapability.nonce0 =
        sessionCapability.nonce0
    productionAdmittedInputRuntimeSessionCapability.nonce1 =
        sessionCapability.nonce1
    sessionCapability.handle = uint64(0)
    sessionCapability.generation = uint64(0)
    sessionCapability.nonce0 = uint64(0)
    sessionCapability.nonce1 = uint64(0)
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputPreflightOwnerState,
        CsgCoreProductionAdmittedInputPreflightOwnerIssued)
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputRegistryState,
        CsgCoreProductionAdmittedInputRegistryReady)
    outPreflightCloseOwner = 1
    return true

fn productionAdmittedInputCapabilityShapeValid(
        capability: CsgCoreProductionAdmittedInputCapability): bool =
    return capability.handleRow >= 0 &&
        capability.handleRow <
            CsgCoreProductionAdmittedInputHandleRowCount &&
        productionAdmittedInputHandleNextRow != nil &&
        capability.handleRow <
            atomic.LoadI32(productionAdmittedInputHandleNextRow) &&
        atomic.LoadI32(
            productionAdmittedInputHandleStates[
                capability.handleRow]) ==
            CsgCoreProductionAdmittedInputHandlePublished

fn productionAdmittedInputHandleMatchesSlot(
        row: int32,
        slot: int32): bool =
    return row >= 0 &&
        row < CsgCoreProductionAdmittedInputHandleRowCount &&
        slot >= 0 && slot < CsgCoreProductionAdmittedInputSlotCount &&
        productionAdmittedInputHandleResourceSlots[row] == slot &&
        productionAdmittedInputHandleGenerations[row] ==
            productionAdmittedInputSlotGenerations[slot] &&
        productionAdmittedInputHandleSessionGenerations[row] ==
            productionAdmittedInputSlotSessionGenerations[slot] &&
        productionAdmittedInputHandleSessionNonceCids[row] ==
            productionAdmittedInputSlotSessionNonceCids[slot] &&
        productionAdmittedInputHandleAdmittedInputCids[row] ==
            productionAdmittedInputSlotAdmittedInputCids[slot] &&
        productionAdmittedInputHandleLeaseCids[row] ==
            productionAdmittedInputSlotLeaseCids[slot]

fn productionAdmittedInputSlotForCapability(
        capability: CsgCoreProductionAdmittedInputCapability): int32 =
    if system.RuntimeAtomicLoadI32(
           productionAdmittedInputRegistryState) !=
           CsgCoreProductionAdmittedInputRegistryReady ||
       !productionAdmittedInputCapabilityShapeValid(capability):
        return -1
    let row = capability.handleRow
    let slot = productionAdmittedInputHandleResourceSlots[row]
    if !productionAdmittedInputHandleMatchesSlot(row, slot):
        return -1
    return slot

fn productionAdmittedInputMoveOwnedHandlesInto(
        slot: int32,
        outRootOwner: var int32,
        outBundleOwner: var int32) =
    outRootOwner = productionAdmittedInputSlotRootOwners[slot]
    outBundleOwner = productionAdmittedInputSlotBundleOwners[slot]
    productionAdmittedInputSlotRootOwners[slot] = -1
    productionAdmittedInputSlotBundleOwners[slot] = -1

fn productionAdmittedInputPreflightIssueRelease(owned: bool) =
    if owned && !system.RuntimeAtomicCompareExchangeI32(
           productionAdmittedInputPreflightOwnerState,
           CsgCoreProductionAdmittedInputPreflightOwnerConsuming,
           CsgCoreProductionAdmittedInputPreflightOwnerIssued):
        panic("production admitted-input preflight issue release drift")

fn CsgCoreProductionHeldExecProviderIssueAdmittedInputInto(
        preflightCloseOwner: var int32,
        preExecOwnerRow: var int32,
        rootOwner: var int32,
        bundleOwner: var int32,
        rootOwnerBindingCid: str,
        activationBundleBytes: str,
        outAdmittedOwner: var int32,
        outHeldBundleCid: var str,
        err: var str): bool =
    outAdmittedOwner = -1
    outHeldBundleCid = ""
    if system.RuntimeAtomicLoadI32(
           productionAdmittedInputRegistryState) !=
           CsgCoreProductionAdmittedInputRegistryReady ||
       preExecOwnerRow < 0 || rootOwner <= 0 || bundleOwner <= 0 ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           rootOwnerBindingCid):
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    var ownsPreflight = false
    let preflightState = system.RuntimeAtomicLoadI32(
        productionAdmittedInputPreflightOwnerState)
    if preflightState == CsgCoreProductionAdmittedInputPreflightOwnerIssued:
        if preflightCloseOwner != 1 ||
           !system.RuntimeAtomicCompareExchangeI32(
               productionAdmittedInputPreflightOwnerState,
               CsgCoreProductionAdmittedInputPreflightOwnerIssued,
               CsgCoreProductionAdmittedInputPreflightOwnerConsuming):
            err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
            return false
        ownsPreflight = true
    elif preflightState !=
             CsgCoreProductionAdmittedInputPreflightOwnerConsumed ||
         preflightCloseOwner != -1:
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    let ownedPreExecOwner = preExecOwnerRow + 1
    var receipt: CsgCoreProductionPreExecInputOwnerReceipt
    if !CsgCoreProductionPreExecInputOwnerMoveReceiptInto(
           ownedPreExecOwner, receipt, err):
        productionAdmittedInputPreflightIssueRelease(ownsPreflight)
        return false
    var envelopeBytes: str
    var input: CsgCoreProductionPreExecInput
    var decodedReceipt: CsgCoreProductionPreExecInputOwnerReceipt
    var heldBundleCid: str
    if !CsgCoreProductionPreExecActivationBundleDecodeStrictInto(
           activationBundleBytes,
           envelopeBytes,
           input,
           decodedReceipt,
           heldBundleCid,
           err) ||
       decodedReceipt.receiptCid != receipt.receiptCid ||
       decodedReceipt.rawEnvelopeCid != receipt.rawEnvelopeCid ||
       decodedReceipt.requestIdentityCid != receipt.requestIdentityCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(heldBundleCid):
        let _releasedDecode =
            CsgCoreProductionPreExecInputOwnerMoveAbort(
                ownedPreExecOwner)
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrActivationIdentity)
        productionAdmittedInputPreflightIssueRelease(ownsPreflight)
        return false
    var slot: int32 = -1
    var priorState = CsgCoreProductionAdmittedInputStateEmpty
    for scan in 0..<CsgCoreProductionAdmittedInputSlotCount:
        if slot >= 0:
            break
        let prior = atomic.LoadI32(
            productionAdmittedInputSlotStates[scan])
        if prior == CsgCoreProductionAdmittedInputStateEmpty ||
           prior == CsgCoreProductionAdmittedInputStateClaimed ||
           prior == CsgCoreProductionAdmittedInputStateAborted:
            if atomic.CasI32(
                   productionAdmittedInputSlotStates[scan],
                   prior,
                   CsgCoreProductionAdmittedInputStateBuilding):
                if productionAdmittedInputSlotGenerations[scan] +
                       uint64(1) == uint64(0):
                    atomic.StoreI32(
                        productionAdmittedInputSlotStates[scan], prior)
                else:
                    slot = scan
                    priorState = prior
    if slot < 0:
        let _releasedNoSlot =
            CsgCoreProductionPreExecInputOwnerMoveAbort(
                ownedPreExecOwner)
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        productionAdmittedInputPreflightIssueRelease(ownsPreflight)
        return false
    let generation =
        productionAdmittedInputSlotGenerations[slot] + uint64(1)
    let sessionGeneration =
        productionAdmittedInputRuntimeSessionCapability.generation
    let sessionNonceCid =
        CsgCoreProductionHeldExecProviderSessionNonceCid(
            productionAdmittedInputRuntimeSessionCapability)
    let handleRow = atomic.FetchAddI32(
        productionAdmittedInputHandleNextRow, 1)
    let activationOrdinal = uint64(handleRow + 1)
    let admittedInputCid = productionAdmittedInputCid(
        receipt, rootOwnerBindingCid, heldBundleCid)
    let leaseCid = productionAdmittedInputLeaseCid(
        admittedInputCid,
        sessionGeneration,
        sessionNonceCid,
        generation,
        activationOrdinal)
    if handleRow < 0 ||
       handleRow >= CsgCoreProductionAdmittedInputHandleRowCount ||
       sessionGeneration == uint64(0) ||
       activationOrdinal == uint64(0) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(sessionNonceCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(admittedInputCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(leaseCid):
        atomic.StoreI32(
            productionAdmittedInputSlotStates[slot], priorState)
        let _releasedInvalid =
            CsgCoreProductionPreExecInputOwnerMoveAbort(
                ownedPreExecOwner)
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        productionAdmittedInputPreflightIssueRelease(ownsPreflight)
        return false
    productionAdmittedInputSlotGenerations[slot] = generation
    productionAdmittedInputSlotSessionGenerations[slot] =
        sessionGeneration
    productionAdmittedInputSlotSessionNonceCids[slot] =
        strings.CloneStr(sessionNonceCid)
    productionAdmittedInputSlotActivationOrdinals[slot] =
        activationOrdinal
    productionAdmittedInputSlotAdmittedInputCids[slot] =
        strings.CloneStr(admittedInputCid)
    productionAdmittedInputSlotLeaseCids[slot] =
        strings.CloneStr(leaseCid)
    productionAdmittedInputSlotRootOwnerBindingCids[slot] =
        strings.CloneStr(rootOwnerBindingCid)
    productionAdmittedInputSlotHeldBundleCids[slot] =
        strings.CloneStr(heldBundleCid)
    productionAdmittedInputSlotActivationBundleBytes[slot] =
        strings.CloneStr(activationBundleBytes)
    productionAdmittedInputSlotOwnerReceiptCids[slot] =
        strings.CloneStr(receipt.receiptCid)
    productionAdmittedInputSlotRequestIdentityCids[slot] =
        strings.CloneStr(receipt.requestIdentityCid)
    productionAdmittedInputHandleResourceSlots[handleRow] = slot
    productionAdmittedInputHandleGenerations[handleRow] = generation
    productionAdmittedInputHandleSessionGenerations[handleRow] =
        sessionGeneration
    productionAdmittedInputHandleSessionNonceCids[handleRow] =
        strings.CloneStr(sessionNonceCid)
    productionAdmittedInputHandleAdmittedInputCids[handleRow] =
        strings.CloneStr(admittedInputCid)
    productionAdmittedInputHandleLeaseCids[handleRow] =
        strings.CloneStr(leaseCid)
    var candidateCapability: CsgCoreProductionAdmittedInputCapability
    candidateCapability.handleRow = handleRow
    if !productionAdmittedInputHandleMatchesSlot(handleRow, slot) ||
       !CsgCoreProductionPreExecInputOwnerMoveCommit(
           ownedPreExecOwner):
        atomic.StoreI32(
            productionAdmittedInputSlotStates[slot],
            CsgCoreProductionAdmittedInputStateAborted)
        let _releasedCommit =
            CsgCoreProductionPreExecInputOwnerMoveAbort(
                ownedPreExecOwner)
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        productionAdmittedInputPreflightIssueRelease(ownsPreflight)
        return false
    if ownsPreflight:
        if preflightCloseOwner != 1:
            panic("production admitted-input preflight owner publication drift")
        preflightCloseOwner = -1
        system.RuntimeAtomicStoreI32(
            productionAdmittedInputPreflightOwnerState,
            CsgCoreProductionAdmittedInputPreflightOwnerConsumed)
    elif system.RuntimeAtomicLoadI32(
             productionAdmittedInputPreflightOwnerState) !=
             CsgCoreProductionAdmittedInputPreflightOwnerConsumed ||
         preflightCloseOwner != -1:
        panic("production admitted-input preflight owner state invalid")
    productionAdmittedInputSlotRootOwners[slot] = rootOwner
    productionAdmittedInputSlotBundleOwners[slot] = bundleOwner
    preExecOwnerRow = -1
    rootOwner = -1
    bundleOwner = -1
    atomic.StoreI32(
        productionAdmittedInputSlotStates[slot],
        CsgCoreProductionAdmittedInputStateIssued)
    atomic.StoreI32(
        productionAdmittedInputHandleStates[handleRow],
        CsgCoreProductionAdmittedInputHandlePublished)
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputState,
        CsgCoreProductionAdmittedInputStateIssued)
    outAdmittedOwner = candidateCapability.handleRow + 1
    outHeldBundleCid = strings.CloneStr(heldBundleCid)
    err = ""
    return true

fn CsgCoreProductionAdmittedInputClaimInto(
        admittedOwner: var int32,
        runtimeSession: int32,
        outClaim: var CsgCoreProductionAdmittedInputClaim,
        outRootOwner: var int32,
        outBundleOwner: var int32,
        err: var str): bool =
    outClaim = CsgCoreProductionAdmittedInputClaim()
    outRootOwner = -1
    outBundleOwner = -1
    var capability: CsgCoreProductionAdmittedInputCapability
    capability.handleRow = admittedOwner - 1
    let slot = productionAdmittedInputSlotForCapability(capability)
    if slot < 0 || runtimeSession <= 0 ||
       !atomic.CasI32(
           productionAdmittedInputSlotStates[slot],
           CsgCoreProductionAdmittedInputStateIssued,
           CsgCoreProductionAdmittedInputStateClaiming):
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrSingleConsumption)
        return false
    admittedOwner = -1
    let claim = system.RuntimeHeldExecParentClaimEvidence(runtimeSession)
    let claimReceiptCid = productionHeldExecDigestCid(
        claim.claimReceipt0,
        claim.claimReceipt1,
        claim.claimReceipt2,
        claim.claimReceipt3)
    let childBirthReceiptCid = productionHeldExecDigestCid(
        claim.childBirthReceipt0,
        claim.childBirthReceipt1,
        claim.childBirthReceipt2,
        claim.childBirthReceipt3)
    let valid = claim.status == 1 && claim.session == runtimeSession &&
        claim.phase == system.RuntimeHeldExecParentPhaseClaimed &&
        claim.childPid > 0 &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(claimReceiptCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            childBirthReceiptCid) &&
        (claim.childBirthPlatform == 1 ||
         claim.childBirthPlatform == 2) &&
        claim.childBirth0 != uint64(0) &&
        (claim.childBirthPlatform != 2 ||
         claim.childBirth1 == uint64(0)) &&
        (claim.childBirthPlatform != 1 ||
         claim.childBirth1 < uint64(1000000))
    if !valid:
        productionAdmittedInputMoveOwnedHandlesInto(
            slot, outRootOwner, outBundleOwner)
        atomic.StoreI32(
            productionAdmittedInputSlotStates[slot],
            CsgCoreProductionAdmittedInputStateAborted)
        system.RuntimeAtomicStoreI32(
            productionAdmittedInputState,
            CsgCoreProductionAdmittedInputStateAborted)
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrActivationIdentity)
        return false
    let ownerClaimReceiptCid = productionAdmittedInputOwnerClaimCid(
        claimReceiptCid,
        productionAdmittedInputSlotLeaseCids[slot],
        productionAdmittedInputSlotHeldBundleCids[slot],
        productionAdmittedInputSlotRequestIdentityCids[slot],
        productionAdmittedInputSlotSessionGenerations[slot],
        runtimeSession,
        claim.childPid,
        claim.childUid,
        claim.childGid)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           ownerClaimReceiptCid):
        productionAdmittedInputMoveOwnedHandlesInto(
            slot, outRootOwner, outBundleOwner)
        atomic.StoreI32(
            productionAdmittedInputSlotStates[slot],
            CsgCoreProductionAdmittedInputStateAborted)
        system.RuntimeAtomicStoreI32(
            productionAdmittedInputState,
            CsgCoreProductionAdmittedInputStateAborted)
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrActivationIdentity)
        return false
    productionAdmittedInputSlotParentSessions[slot] = runtimeSession
    productionAdmittedInputSlotChildPids[slot] = claim.childPid
    productionAdmittedInputSlotChildUids[slot] = claim.childUid
    productionAdmittedInputSlotChildGids[slot] = claim.childGid
    productionAdmittedInputSlotClaimReceiptCids[slot] =
        strings.CloneStr(claimReceiptCid)
    productionAdmittedInputSlotOwnerClaimReceiptCids[slot] =
        strings.CloneStr(ownerClaimReceiptCid)
    outClaim.generation = productionAdmittedInputSlotGenerations[slot]
    outClaim.sessionGeneration =
        productionAdmittedInputSlotSessionGenerations[slot]
    outClaim.activationOrdinal =
        productionAdmittedInputSlotActivationOrdinals[slot]
    outClaim.admittedInputCid = strings.CloneStr(
        productionAdmittedInputSlotAdmittedInputCids[slot])
    outClaim.leaseCid = strings.CloneStr(
        productionAdmittedInputSlotLeaseCids[slot])
    outClaim.rootOwnerBindingCid = strings.CloneStr(
        productionAdmittedInputSlotRootOwnerBindingCids[slot])
    outClaim.heldBundleCid = strings.CloneStr(
        productionAdmittedInputSlotHeldBundleCids[slot])
    outClaim.activationBundleBytes = strings.CloneStr(
        productionAdmittedInputSlotActivationBundleBytes[slot])
    outClaim.requestIdentityCid = strings.CloneStr(
        productionAdmittedInputSlotRequestIdentityCids[slot])
    outClaim.claimReceiptCid = strings.CloneStr(claimReceiptCid)
    outClaim.ownerClaimReceiptCid = strings.CloneStr(ownerClaimReceiptCid)
    outClaim.childBirthReceiptCid = strings.CloneStr(
        childBirthReceiptCid)
    outClaim.childPid = claim.childPid
    outClaim.childUid = claim.childUid
    outClaim.childGid = claim.childGid
    outClaim.childBirthPlatform = claim.childBirthPlatform
    outClaim.childBirth0 = claim.childBirth0
    outClaim.childBirth1 = claim.childBirth1
    productionAdmittedInputMoveOwnedHandlesInto(
        slot, outRootOwner, outBundleOwner)
    atomic.StoreI32(
        productionAdmittedInputSlotStates[slot],
        CsgCoreProductionAdmittedInputStateClaimed)
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputState,
        CsgCoreProductionAdmittedInputStateClaimed)
    err = ""
    return true

fn CsgCoreProductionAdmittedInputAbortInto(
        admittedOwner: var int32,
        outRootOwner: var int32,
        outBundleOwner: var int32,
        err: var str): bool =
    outRootOwner = -1
    outBundleOwner = -1
    var capability: CsgCoreProductionAdmittedInputCapability
    capability.handleRow = admittedOwner - 1
    let slot = productionAdmittedInputSlotForCapability(capability)
    if slot < 0 || !atomic.CasI32(
           productionAdmittedInputSlotStates[slot],
           CsgCoreProductionAdmittedInputStateIssued,
           CsgCoreProductionAdmittedInputStateAborted):
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrSingleConsumption)
        return false
    admittedOwner = -1
    productionAdmittedInputMoveOwnedHandlesInto(
        slot, outRootOwner, outBundleOwner)
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputState,
        CsgCoreProductionAdmittedInputStateAborted)
    err = ""
    return true

fn CsgCoreProductionAdmittedInputStateCurrent(): int32 =
    return system.RuntimeAtomicLoadI32(productionAdmittedInputState)

fn productionPreExecInputOwnersTerminalForSessionClose(): bool =
    let registryState = system.RuntimeAtomicLoadI32(
        productionPreExecInputOwnerRegistryInit)
    if registryState == 0:
        return true
    if registryState != 2 ||
       productionPreExecInputOwnerSlotStates.len !=
           CsgCoreProductionPreExecInputOwnerSlotCount:
        return false
    for slot in 0..<CsgCoreProductionPreExecInputOwnerSlotCount:
        let state = atomic.LoadI32(
            productionPreExecInputOwnerSlotStates[slot])
        if state != CsgCoreProductionPreExecInputOwnerStateEmpty &&
           state != CsgCoreProductionPreExecInputOwnerStateConsumed &&
           state != CsgCoreProductionPreExecInputOwnerStateAborted:
            return false
    return true

fn productionAdmittedInputRowsTerminalForPreflightClose(): bool =
    if productionAdmittedInputHandleNextRow == nil ||
       productionAdmittedInputSlotStates.len !=
           CsgCoreProductionAdmittedInputSlotCount:
        return false
    let handleRows = atomic.LoadI32(
        productionAdmittedInputHandleNextRow)
    if handleRows < 0 ||
       handleRows > CsgCoreProductionAdmittedInputHandleRowCount:
        return false
    for row in 0..<handleRows:
        if atomic.LoadI32(
               productionAdmittedInputHandleStates[row]) !=
               CsgCoreProductionAdmittedInputHandleUnpublished:
            return false
    for slot in 0..<CsgCoreProductionAdmittedInputSlotCount:
        let state = atomic.LoadI32(
            productionAdmittedInputSlotStates[slot])
        if state != CsgCoreProductionAdmittedInputStateEmpty &&
           state != CsgCoreProductionAdmittedInputStateAborted:
            return false
    return productionPreExecInputOwnersTerminalForSessionClose()

# The process-entry caller retains this one-shot int32 owner only until the
# first admitted row is irreversibly published.  Legal request/plan/producer
# failures consume it here after the inner scope has dropped all managed
# value-defs.  A racing Issue and preflight close contend on the same CAS.
fn CsgCoreProductionAdmittedInputAuthorityConsumePreflightCloseReadyAndCloseInto(
        preflightCloseOwner: var int32,
        err: var str): bool =
    err = ""
    if preflightCloseOwner != 1 ||
       !system.RuntimeAtomicCompareExchangeI32(
           productionAdmittedInputPreflightOwnerState,
           CsgCoreProductionAdmittedInputPreflightOwnerIssued,
           CsgCoreProductionAdmittedInputPreflightOwnerConsuming):
        err = "production_admitted_input_preflight_close_owner_invalid"
        return false
    preflightCloseOwner = -1
    if !productionAdmittedInputRowsTerminalForPreflightClose():
        panic("production admitted-input preflight close found live row")
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputPreflightOwnerState,
        CsgCoreProductionAdmittedInputPreflightOwnerConsumed)
    if !system.RuntimeAtomicCompareExchangeI32(
           productionAdmittedInputRegistryState,
           CsgCoreProductionAdmittedInputRegistryReady,
           CsgCoreProductionAdmittedInputRegistryPreflightCloseReady):
        panic("production admitted-input preflight close publication drift")
    return CsgCoreProductionAdmittedInputAuthorityConsumeCloseReadyAndCloseInto(
        err)

# The journal can publish this state only with the runtime owner minted by the
# durable Reaped Ack.  The owner is moved into the runtime consume CAS; copied
# or replayed int32 cargo cannot publish a second CloseReady transition.
fn CsgCoreProductionAdmittedInputAuthorityPublishCloseReadyInto(
        closeReadyOwner: var int32,
        err: var str): bool =
    if closeReadyOwner <= 0 ||
       !system.RuntimeAtomicCompareExchangeI32(
           productionAdmittedInputRegistryState,
           CsgCoreProductionAdmittedInputRegistryReady,
           CsgCoreProductionAdmittedInputRegistryPublishingCloseReady):
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    if !system.RuntimeHeldExecTerminalCloseReadyConsume(closeReadyOwner):
        system.RuntimeAtomicStoreI32(
            productionAdmittedInputRegistryState,
            CsgCoreProductionAdmittedInputRegistryFailed)
        err = "production_admitted_input_close_ready_runtime_consume_failed"
        return false
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputRegistryState,
        CsgCoreProductionAdmittedInputRegistryCloseReady)
    err = ""
    return true

fn CsgCoreProductionAdmittedInputAuthorityCloseReady(): bool =
    return system.RuntimeAtomicLoadI32(
        productionAdmittedInputRegistryState) ==
        CsgCoreProductionAdmittedInputRegistryCloseReady

# Called only from compiler_main's outer process-entry epilogue, after the
# parent command helper has returned and dropped every managed value-def.
# Clearing the provider-owned Arena/SoA precedes the unique ledger Close.
fn CsgCoreProductionAdmittedInputAuthorityConsumeCloseReadyAndCloseInto(
        err: var str): bool =
    err = ""
    let readyState = system.RuntimeAtomicLoadI32(
        productionAdmittedInputRegistryState)
    let preflightClose = readyState ==
        CsgCoreProductionAdmittedInputRegistryPreflightCloseReady
    if (readyState != CsgCoreProductionAdmittedInputRegistryCloseReady &&
        !preflightClose) ||
       !system.RuntimeAtomicCompareExchangeI32(
           productionAdmittedInputRegistryState,
           readyState,
           CsgCoreProductionAdmittedInputRegistryClosing):
        err = "production_admitted_input_close_ready_missing"
        return false
    if productionAdmittedInputRuntimeSessionCapability.handle == uint64(0) ||
       productionAdmittedInputRuntimeSessionCapability.generation ==
           uint64(0):
        panic("production admitted-input close-ready session missing")
    if !productionPreExecInputOwnersTerminalForSessionClose():
        panic("production admitted-input close-ready pre-exec row live")
    let handleRows = productionAdmittedInputHandleNextRow == nil ? 0 :
        atomic.LoadI32(productionAdmittedInputHandleNextRow)
    if preflightClose:
        if !productionAdmittedInputRowsTerminalForPreflightClose():
            panic("production admitted-input preflight close row drift")
    else:
        for row in 0..<handleRows:
            let slot = productionAdmittedInputHandleResourceSlots[row]
            if slot < 0 ||
               slot >= CsgCoreProductionAdmittedInputSlotCount ||
               atomic.LoadI32(
                   productionAdmittedInputHandleStates[row]) !=
                   CsgCoreProductionAdmittedInputHandlePublished ||
               atomic.LoadI32(productionAdmittedInputSlotStates[slot]) !=
                   CsgCoreProductionAdmittedInputStateClaimed ||
               productionAdmittedInputSlotRootOwners[slot] != -1 ||
               productionAdmittedInputSlotBundleOwners[slot] != -1:
                panic("production admitted-input close-ready row not terminal")
    var sessionCapability: system.RuntimeAllocationLedgerSessionCapability
    sessionCapability.handle =
        productionAdmittedInputRuntimeSessionCapability.handle
    sessionCapability.generation =
        productionAdmittedInputRuntimeSessionCapability.generation
    sessionCapability.nonce0 =
        productionAdmittedInputRuntimeSessionCapability.nonce0
    sessionCapability.nonce1 =
        productionAdmittedInputRuntimeSessionCapability.nonce1
    productionAdmittedInputRuntimeSessionCapability.handle = uint64(0)
    productionAdmittedInputRuntimeSessionCapability.generation = uint64(0)
    productionAdmittedInputRuntimeSessionCapability.nonce0 = uint64(0)
    productionAdmittedInputRuntimeSessionCapability.nonce1 = uint64(0)
    productionHeldExecProviderSlotReceipt =
        CsgCoreProductionHeldExecReceipt()
    productionPreExecInputOwnerSlotStates = []
    productionPreExecInputOwnerSlotGenerations = []
    productionPreExecInputOwnerSlotRawEnvelopeCids = []
    productionPreExecInputOwnerSlotSemanticCommandCids = []
    productionPreExecInputOwnerSlotPackageSourceRootIdentityCids = []
    productionPreExecInputOwnerSlotSourceClosureCids = []
    productionPreExecInputOwnerSlotExecutableCids = []
    productionPreExecInputOwnerSlotOriginCids = []
    productionPreExecInputOwnerSlotRequestIdentityCids = []
    productionPreExecInputOwnerSlotByteCounts = []
    productionPreExecInputOwnerSlotReceiptCids = []
    productionPreExecInputOwnerHandleResourceSlots = []
    productionPreExecInputOwnerHandleGenerations = []
    productionPreExecInputOwnerHandleReceiptCids = []
    productionPreExecInputOwnerHandleNextRow = nil
    productionPreExecInputOwnerRegistryInit = 0
    productionAdmittedInputSlotStates = []
    productionAdmittedInputSlotGenerations = []
    productionAdmittedInputSlotSessionGenerations = []
    productionAdmittedInputSlotSessionNonceCids = []
    productionAdmittedInputSlotActivationOrdinals = []
    productionAdmittedInputSlotRootOwners = []
    productionAdmittedInputSlotBundleOwners = []
    productionAdmittedInputSlotParentSessions = []
    productionAdmittedInputSlotChildPids = []
    productionAdmittedInputSlotChildUids = []
    productionAdmittedInputSlotChildGids = []
    productionAdmittedInputSlotAdmittedInputCids = []
    productionAdmittedInputSlotLeaseCids = []
    productionAdmittedInputSlotRootOwnerBindingCids = []
    productionAdmittedInputSlotHeldBundleCids = []
    productionAdmittedInputSlotActivationBundleBytes = []
    productionAdmittedInputSlotOwnerReceiptCids = []
    productionAdmittedInputSlotRequestIdentityCids = []
    productionAdmittedInputSlotClaimReceiptCids = []
    productionAdmittedInputSlotOwnerClaimReceiptCids = []
    productionAdmittedInputHandleStates = []
    productionAdmittedInputHandleResourceSlots = []
    productionAdmittedInputHandleGenerations = []
    productionAdmittedInputHandleSessionGenerations = []
    productionAdmittedInputHandleSessionNonceCids = []
    productionAdmittedInputHandleAdmittedInputCids = []
    productionAdmittedInputHandleLeaseCids = []
    productionAdmittedInputHandleNextRow = nil
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputState,
        CsgCoreProductionAdmittedInputStateEmpty)
    let closed = system.RuntimeAllocationLedgerSessionOwnerClose(
        sessionCapability)
    if !closed.ok || !closed.receipt.complete ||
       !closed.receipt.closed || closed.receipt.active:
        panic("production admitted-input close-ready ledger close failed")
    system.RuntimeAtomicStoreI32(
        productionAdmittedInputRegistryState,
        CsgCoreProductionAdmittedInputRegistryClosed)
    return true

fn productionPreExecInputChildRegistryEnsure(): bool =
    if system.RuntimeAtomicLoadI32(
           productionPreExecInputChildRegistryInit) == 2:
        return true
    if !system.RuntimeAtomicCompareExchangeI32(
           productionPreExecInputChildRegistryInit, 0, 1):
        return false
    productionPreExecInputChildSlotStates = []
    setLen(productionPreExecInputChildSlotBundleBytes,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotBundleCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotRawEnvelopeCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotSemanticCommandCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotPackageSourceRootIdentityCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotSourceClosureCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotExecutableCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotOriginCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotRequestIdentityCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotOwnerReceiptCids,
        CsgCoreProductionPreExecInputChildSlotCount)
    setLen(productionPreExecInputChildSlotByteCounts,
        CsgCoreProductionPreExecInputChildSlotCount)
    for slot in 0..<CsgCoreProductionPreExecInputChildSlotCount:
        add(productionPreExecInputChildSlotStates,
            atomic.NewI32(0))
        productionPreExecInputChildSlotBundleBytes[slot] = ""
        productionPreExecInputChildSlotBundleCids[slot] = ""
        productionPreExecInputChildSlotRawEnvelopeCids[slot] = ""
        productionPreExecInputChildSlotSemanticCommandCids[slot] = ""
        productionPreExecInputChildSlotPackageSourceRootIdentityCids[slot] = ""
        productionPreExecInputChildSlotSourceClosureCids[slot] = ""
        productionPreExecInputChildSlotExecutableCids[slot] = ""
        productionPreExecInputChildSlotOriginCids[slot] = ""
        productionPreExecInputChildSlotRequestIdentityCids[slot] = ""
        productionPreExecInputChildSlotOwnerReceiptCids[slot] = ""
        productionPreExecInputChildSlotByteCounts[slot] = 0
        if productionPreExecInputChildSlotStates[slot] == nil:
            system.RuntimeAtomicStoreI32(
                productionPreExecInputChildRegistryInit, 0)
            return false
    if productionPreExecInputChildSlotStates.len !=
            CsgCoreProductionPreExecInputChildSlotCount:
        system.RuntimeAtomicStoreI32(
            productionPreExecInputChildRegistryInit, 0)
        return false
    system.RuntimeAtomicStoreI32(
        productionPreExecInputChildRegistryInit, 2)
    return true

fn productionPreExecInputChildHandleShapeValid(
        handle: var CsgCoreProductionPreExecInputChildHandle): bool =
    return handle.slot >= 0 &&
        handle.slot < CsgCoreProductionPreExecInputChildSlotCount

fn productionPreExecInputChildSlotMatches(
        slot: int32,
        handle: var CsgCoreProductionPreExecInputChildHandle): bool =
    return slot == handle.slot

fn CsgCoreProductionPreExecInputChildTakeAndImportInto(
        outHandle: var CsgCoreProductionPreExecInputChildHandle,
        err: var str): bool =
    outHandle = CsgCoreProductionPreExecInputChildHandle()
    if !system.RuntimeHeldExecChildAdmissionActive() ||
       !productionPreExecInputChildRegistryEnsure():
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputHardRedBundleDelivery)
        return false
    var bundleBytes: str
    let taken = system.RuntimeHeldExecChildTakeBundleBytesInto(bundleBytes)
    let observedBundleCid = system.RuntimeHeldExecBundleDigestCid(taken)
    if taken.status != 1 || taken.byteCount <= 0 ||
       bundleBytes.len != taken.byteCount ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(observedBundleCid):
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrActivationPayload)
        return false
    var envelopeBytes: str
    var decoded: CsgCoreProductionPreExecInput
    var ownerReceipt: CsgCoreProductionPreExecInputOwnerReceipt
    var heldBundleCid: str
    if !CsgCoreProductionPreExecActivationBundleDecodeStrictInto(
           bundleBytes,
           envelopeBytes,
           decoded,
           ownerReceipt,
           heldBundleCid,
           err) || heldBundleCid != observedBundleCid:
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrActivationIdentity)
        return false
    var slot: int32 = -1
    for scan in 0..<CsgCoreProductionPreExecInputChildSlotCount:
        if slot >= 0:
            break
        let prior = atomic.LoadI32(
            productionPreExecInputChildSlotStates[scan])
        if prior == CsgCoreProductionPreExecInputChildStateEmpty:
            if atomic.CasI32(
                   productionPreExecInputChildSlotStates[scan],
                   prior,
                   CsgCoreProductionPreExecInputChildStateBuilding):
                slot = scan
    if slot < 0:
        err = strings.CloneStr(CsgCoreProductionAdmittedInputErrState)
        return false
    productionPreExecInputChildSlotBundleBytes[slot] =
        strings.CloneStr(bundleBytes)
    productionPreExecInputChildSlotBundleCids[slot] =
        strings.CloneStr(heldBundleCid)
    productionPreExecInputChildSlotRawEnvelopeCids[slot] =
        strings.CloneStr(ownerReceipt.rawEnvelopeCid)
    productionPreExecInputChildSlotSemanticCommandCids[slot] =
        strings.CloneStr(ownerReceipt.semanticCommandCid)
    productionPreExecInputChildSlotPackageSourceRootIdentityCids[slot] =
        strings.CloneStr(ownerReceipt.packageSourceRootIdentityCid)
    productionPreExecInputChildSlotSourceClosureCids[slot] =
        strings.CloneStr(ownerReceipt.sourceClosureCid)
    productionPreExecInputChildSlotExecutableCids[slot] =
        strings.CloneStr(ownerReceipt.executableCid)
    productionPreExecInputChildSlotOriginCids[slot] =
        strings.CloneStr(ownerReceipt.originCid)
    productionPreExecInputChildSlotRequestIdentityCids[slot] =
        strings.CloneStr(ownerReceipt.requestIdentityCid)
    productionPreExecInputChildSlotOwnerReceiptCids[slot] =
        strings.CloneStr(ownerReceipt.receiptCid)
    productionPreExecInputChildSlotByteCounts[slot] = ownerReceipt.byteCount
    atomic.StoreI32(
        productionPreExecInputChildSlotStates[slot],
        CsgCoreProductionPreExecInputChildStateImported)
    outHandle.slot = slot
    err = ""
    return true

fn CsgCoreProductionPreExecInputChildConsumeInto(
        handle: var CsgCoreProductionPreExecInputChildHandle,
        outInput: var CsgCoreProductionPreExecInput,
        outOwnerReceipt: var CsgCoreProductionPreExecInputOwnerReceipt,
        err: var str): bool =
    outInput = CsgCoreProductionPreExecInput()
    outOwnerReceipt = CsgCoreProductionPreExecInputOwnerReceipt()
    if !productionPreExecInputChildHandleShapeValid(handle) ||
       !productionPreExecInputChildRegistryEnsure() ||
       !productionPreExecInputChildSlotMatches(handle.slot, handle) ||
       !atomic.CasI32(
           productionPreExecInputChildSlotStates[handle.slot],
           CsgCoreProductionPreExecInputChildStateImported,
           CsgCoreProductionPreExecInputChildStateConsuming) ||
       !productionPreExecInputChildSlotMatches(handle.slot, handle):
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrSingleConsumption)
        return false
    let slot = handle.slot
    var envelopeBytes: str
    var heldBundleCid: str
    if !CsgCoreProductionPreExecActivationBundleDecodeStrictInto(
           productionPreExecInputChildSlotBundleBytes[slot],
           envelopeBytes,
           outInput,
           outOwnerReceipt,
           heldBundleCid,
           err) ||
       heldBundleCid != productionPreExecInputChildSlotBundleCids[slot] ||
       outOwnerReceipt.rawEnvelopeCid !=
           productionPreExecInputChildSlotRawEnvelopeCids[slot] ||
       outOwnerReceipt.semanticCommandCid !=
           productionPreExecInputChildSlotSemanticCommandCids[slot] ||
       outOwnerReceipt.packageSourceRootIdentityCid !=
           productionPreExecInputChildSlotPackageSourceRootIdentityCids[slot] ||
       outOwnerReceipt.sourceClosureCid !=
           productionPreExecInputChildSlotSourceClosureCids[slot] ||
       outOwnerReceipt.executableCid !=
           productionPreExecInputChildSlotExecutableCids[slot] ||
       outOwnerReceipt.originCid !=
           productionPreExecInputChildSlotOriginCids[slot] ||
       outOwnerReceipt.requestIdentityCid !=
           productionPreExecInputChildSlotRequestIdentityCids[slot] ||
       outOwnerReceipt.receiptCid !=
           productionPreExecInputChildSlotOwnerReceiptCids[slot] ||
       outOwnerReceipt.byteCount !=
           productionPreExecInputChildSlotByteCounts[slot]:
        atomic.StoreI32(
            productionPreExecInputChildSlotStates[slot],
            CsgCoreProductionPreExecInputChildStateAborted)
        err = strings.CloneStr(
            CsgCoreProductionAdmittedInputErrActivationIdentity)
        return false
    atomic.StoreI32(
        productionPreExecInputChildSlotStates[slot],
        CsgCoreProductionPreExecInputChildStateConsumed)
    handle = CsgCoreProductionPreExecInputChildHandle()
    err = ""
    return true
