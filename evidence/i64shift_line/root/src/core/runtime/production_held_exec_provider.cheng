type
    CsgCoreProductionHeldExecIdentity =
        device: uint64
        inode: uint64
        mode: int32
        linkCount: uint64
        size: int64
        ownerUid: uint64
        ownerGid: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        bytesCid: str
        externalAnchorCid: str
        immutableReceiptCid: str
        heldDescriptorTokenCid: str
        heldDescriptorIdentityCid: str

    CsgCoreProductionHeldExecEvent =
        schema: str
        sequence: int32
        kind: str
        stateBefore: str
        stateAfter: str
        previousEventCid: str
        sessionGeneration: uint64
        sessionNonceCid: str
        sessionCapabilityCid: str
        providerAuthorityCid: str
        launcherIdentityCid: str
        binaryIdentityCid: str
        childProcessIdentityCid: str
        subjectIdentityCid: str
        executableObjectCid: str
        heldDescriptorIdentityCid: str
        argvCid: str
        environmentCid: str
        planReceiptCid: str
        proofCid: str
        admissionReceiptCid: str
        executionMethod: str
        inputReadCountBeforeAdmission: int64
        admissionReceiptClosed: bool
        namedPathExecutionObserved: bool
        heldDescriptorExecutionObserved: bool
        executionReleaseObserved: bool
        outputPublicationObserved: bool
        eventCid: str

    CsgCoreProductionHeldExecWorkloadBinding =
        executionScope: str
        commandCid: str
        inputSetCid: str
        outputContractCid: str
        executableObjectCid: str
        argvCid: str
        environmentCid: str
        planReceiptCid: str
        admissionReceiptCid: str
        currentHeadCid: str
        manifestCid: str
        csgcObjectCid: str
        factsRoot: str
        proofCid: str
        csgAuthorityReceiptCid: str

    # This is only the canonical shape accepted at the future native launcher
    # arming edge. It is deliberately not an authority object: scalar fields
    # can be copied or fabricated, so only a runtime-owned retained descriptor
    # source may pass a validated instance to the provider event source.
    CsgCoreProductionLauncherActivation =
        sessionGeneration: uint64
        sessionNonceCid: str
        sessionCapabilityCid: str
        retainedBinaryFd: int32
        executableObjectCid: str
        heldDescriptorIdentityCid: str
        argvCid: str
        environmentCid: str
        planReceiptCid: str
        proofCid: str
        admissionReceiptCid: str
        inputReadCountBeforeAdmission: int64
        admissionReceiptClosed: bool
        namedPathExecutionObserved: bool
        activationConsumed: bool

    CsgCoreProductionHeldExecReceipt =
        schema: str
        platform: str
        executionMethod: str
        executionScope: str
        sessionGeneration: uint64
        sessionNonceCid: str
        sessionCapabilityCid: str
        previousSessionNonceCid: str
        previousSessionCapabilityCid: str
        previousReceiptCid: str
        activationOrdinal: uint64
        previousActivationOrdinal: uint64
        providerAuthorityCid: str
        launcherIdentity: CsgCoreProductionHeldExecIdentity
        binaryIdentity: CsgCoreProductionHeldExecIdentity
        childProcessIdentityCid: str
        activated: CsgCoreProductionHeldExecEvent
        launcherHeld: CsgCoreProductionHeldExecEvent
        binaryHeld: CsgCoreProductionHeldExecEvent
        zeroReadAdmitted: CsgCoreProductionHeldExecEvent
        heldExecStarted: CsgCoreProductionHeldExecEvent
        childObserved: CsgCoreProductionHeldExecEvent
        consumed: CsgCoreProductionHeldExecEvent
        workload: CsgCoreProductionHeldExecWorkloadBinding
        eventStreamCid: str
        receiptCid: str
        complete: bool
        singleConsumptionProven: bool

    # Copying this query key never copies the pre-exec owner.  The provider's
    # private Arena/SoA state is the only authority and exactly one caller can
    # win ISSUED -> CONSUMING.
    CsgCoreProductionPreExecInputOwnerHandle =
        handleRow: int32 = -1

    # Public query identity. The reusable slot, generation, OS-backed
    # session generation/nonce and every owned descriptor stay in the
    # provider's private Arena + SoA columns.
    CsgCoreProductionAdmittedInputCapability =
        handleRow: int32 = -1

    # Immutable value-definition projection emitted only after the unique
    # ISSUED -> CLAIMING CAS and kernel claim validation. Descriptor owners
    # move through separate `var int32` outputs and are never fields here.
    CsgCoreProductionAdmittedInputClaim =
        generation: uint64
        sessionGeneration: uint64
        activationOrdinal: uint64
        admittedInputCid: str
        leaseCid: str
        rootOwnerBindingCid: str
        heldBundleCid: str
        activationBundleBytes: str
        requestIdentityCid: str
        claimReceiptCid: str
        ownerClaimReceiptCid: str
        childBirthReceiptCid: str
        childPid: int32 = -1
        childUid: uint32
        childGid: uint32
        childBirthPlatform: int32
        childBirth0: uint64
        childBirth1: uint64

    # Child-local query key.  The activation bytes and every identity column
    # remain in the child's private Arena/SoA; this int32 index is the only
    # node identity crossing the compiler adapter.
    CsgCoreProductionPreExecInputChildHandle =
        slot: int32 = -1

    # Immutable producer receipt.  All fields are pre-fork facts.  The
    # origin and request identities are derived inside this provider from the
    # canonical envelope/source/executable value definitions; no child,
    # plan, output, ledger or terminal evidence can be represented here.
    CsgCoreProductionPreExecInputOwnerReceipt =
        schemaVersion: int32
        rawEnvelopeCid: str
        semanticCommandCid: str
        packageSourceRootIdentityCid: str
        sourceClosureCid: str
        executableCid: str
        originCid: str
        requestIdentityCid: str
        byteCount: int32
        receiptCid: str
        complete: bool

    # The canonical portable request present before fork.  This value is not
    # authority: the future owner receipt must bind its raw envelope CID to a
    # runtime-owned int32 handle and consume that handle exactly once.  Every
    # `*Cid` comes from its real byte/object/declaration value definition;
    # physical locators belong to a separate authenticated local receipt.
    CsgCoreProductionPreExecExactFunctionRequest =
        canonicalModulePath: str
        symbolSelector: str

    CsgCoreProductionPreExecInput =
        schemaVersion: int32
        semanticCommand: int32
        packageSourceRootIdentityCid: str
        canonicalModulePath: str
        outputRole: int32
        targetTriple: str
        emitKind: int32
        reportRole: int32
        symbolVisibility: int32
        browserBridgeObjectCid: str
        exportRootSymbols: str[]
        providerObjectCids: str[]
        runtimeProviderBundleCid: str
        compileMode: int32
        backendKind: int32
        jobCount: int32
        exactFunctionRequest: CsgCoreProductionPreExecExactFunctionRequest
        compilerRequestCid: str

# Runtime-owned activation slot (Arena + SoA, int32-indexed). The int32 state
# is the only cross-function identity; the receipt is stored by value and the
# slot owns its managed strings via share-on-assign. No object addresses, no
# paths, no name+arity keys ever enter the slot. State transitions are atomic:
# 0 empty -> 1 producer-owned -> 2 issued -> 3 consumer-owned -> 4 consumed.
# Only state 2 exposes a fully initialized receipt, and only one consumer can
# move it to state 3.
var productionHeldExecProviderSlotState: int32
var productionHeldExecProviderSlotReceipt: CsgCoreProductionHeldExecReceipt

# Pre-exec owner arena.  Every column is private SoA storage indexed only by
# int32.  The receipt columns are initialized before the release-store of
# ISSUED and never change during the generation.
var productionPreExecInputOwnerSlotStates: atomic.I32[]
var productionPreExecInputOwnerSlotGenerations: uint64[]
var productionPreExecInputOwnerSlotRawEnvelopeCids: str[]
var productionPreExecInputOwnerSlotSemanticCommandCids: str[]
var productionPreExecInputOwnerSlotPackageSourceRootIdentityCids: str[]
var productionPreExecInputOwnerSlotSourceClosureCids: str[]
var productionPreExecInputOwnerSlotExecutableCids: str[]
var productionPreExecInputOwnerSlotOriginCids: str[]
var productionPreExecInputOwnerSlotRequestIdentityCids: str[]
var productionPreExecInputOwnerSlotByteCounts: int32[]
var productionPreExecInputOwnerSlotReceiptCids: str[]
var productionPreExecInputOwnerRegistryInit: int32
var productionPreExecInputOwnerHandleNextRow: atomic.I32
var productionPreExecInputOwnerHandleResourceSlots: int32[]
var productionPreExecInputOwnerHandleGenerations: uint64[]
var productionPreExecInputOwnerHandleReceiptCids: str[]

# Sole admitted-input authority Arena + SoA. A public int32 handle row joins
# the reusable resource slot to its immutable generation/session/CID tuple;
# neither paths nor object addresses are accepted as identity.
var productionAdmittedInputRegistryState: int32
var productionAdmittedInputRuntimeSessionCapability: system.RuntimeAllocationLedgerSessionCapability
var productionAdmittedInputSlotStates: atomic.I32[]
var productionAdmittedInputSlotGenerations: uint64[]
var productionAdmittedInputSlotSessionGenerations: uint64[]
var productionAdmittedInputSlotSessionNonceCids: str[]
var productionAdmittedInputSlotActivationOrdinals: uint64[]
var productionAdmittedInputSlotRootOwners: int32[]
var productionAdmittedInputSlotBundleOwners: int32[]
var productionAdmittedInputSlotParentSessions: int32[]
var productionAdmittedInputSlotChildPids: int32[]
var productionAdmittedInputSlotChildUids: uint32[]
var productionAdmittedInputSlotChildGids: uint32[]
var productionAdmittedInputSlotAdmittedInputCids: str[]
var productionAdmittedInputSlotLeaseCids: str[]
var productionAdmittedInputSlotRootOwnerBindingCids: str[]
var productionAdmittedInputSlotHeldBundleCids: str[]
var productionAdmittedInputSlotActivationBundleBytes: str[]
var productionAdmittedInputSlotOwnerReceiptCids: str[]
var productionAdmittedInputSlotRequestIdentityCids: str[]
var productionAdmittedInputSlotClaimReceiptCids: str[]
var productionAdmittedInputSlotOwnerClaimReceiptCids: str[]
var productionAdmittedInputHandleNextRow: atomic.I32
var productionAdmittedInputHandleStates: atomic.I32[]
var productionAdmittedInputHandleResourceSlots: int32[]
var productionAdmittedInputHandleGenerations: uint64[]
var productionAdmittedInputHandleSessionGenerations: uint64[]
var productionAdmittedInputHandleSessionNonceCids: str[]
var productionAdmittedInputHandleAdmittedInputCids: str[]
var productionAdmittedInputHandleLeaseCids: str[]
var productionAdmittedInputState: int32
var productionAdmittedInputPreflightOwnerState: int32

# Child-local activation Arena/SoA.  No parent registry or parent query key is
# imported after exec; all immutable columns are populated before IMPORTED is
# published and consumed exactly once by int32 slot identity.
var productionPreExecInputChildSlotStates: atomic.I32[]
var productionPreExecInputChildSlotBundleBytes: str[]
var productionPreExecInputChildSlotBundleCids: str[]
var productionPreExecInputChildSlotRawEnvelopeCids: str[]
var productionPreExecInputChildSlotSemanticCommandCids: str[]
var productionPreExecInputChildSlotPackageSourceRootIdentityCids: str[]
var productionPreExecInputChildSlotSourceClosureCids: str[]
var productionPreExecInputChildSlotExecutableCids: str[]
var productionPreExecInputChildSlotOriginCids: str[]
var productionPreExecInputChildSlotRequestIdentityCids: str[]
var productionPreExecInputChildSlotOwnerReceiptCids: str[]
var productionPreExecInputChildSlotByteCounts: int32[]
var productionPreExecInputChildRegistryInit: int32

@borrows
fn CsgCoreProductionHeldExecActivationShapeStrictValid(
        value: CsgCoreProductionLauncherActivation): bool =
    if value.retainedBinaryFd < 0 ||
       value.sessionGeneration == uint64(0) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.sessionNonceCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.sessionCapabilityCid) ||
       value.sessionNonceCid == value.sessionCapabilityCid:
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.executableObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.heldDescriptorIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.argvCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.environmentCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.planReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.proofCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.admissionReceiptCid):
        return false
    if value.executableObjectCid == value.heldDescriptorIdentityCid ||
       value.executableObjectCid == value.argvCid ||
       value.argvCid == value.environmentCid ||
       value.proofCid == value.planReceiptCid ||
       value.admissionReceiptCid == value.proofCid:
        return false
    return value.inputReadCountBeforeAdmission == int64(0) &&
        value.admissionReceiptClosed &&
        !value.namedPathExecutionObserved &&
        !value.activationConsumed

# Session capability serialization (gap 5). The nonce CID covers only
# (nonce0 || nonce1); the capability CID covers (handle || generation ||
# nonce0 || nonce1). Distinct domains + distinct payloads guarantee the two
# CIDs never alias, matching the receipt validator's session binding.
fn productionHeldExecBytesPutU8(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: int32) =
    if off >= cap:
        return
    rawbytes.BytesSet(buf, off, value)
    off = off + 1

fn productionHeldExecBytesPutU32(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: int32) =
    productionHeldExecBytesPutU8(buf, off, cap, value & 255)
    productionHeldExecBytesPutU8(buf, off, cap, (value >> 8) & 255)
    productionHeldExecBytesPutU8(buf, off, cap, (value >> 16) & 255)
    productionHeldExecBytesPutU8(buf, off, cap, (value >> 24) & 255)

fn productionHeldExecBytesPutU64(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: uint64) =
    var shift: int32
    while shift < 8:
        productionHeldExecBytesPutU8(
            buf, off, cap, int32((value >> (shift * 8)) & uint64(255)))
        shift = shift + 1

fn productionHeldExecHashPrefix(buf: var rawbytes.Bytes, n: int32): str =
    var slim: rawbytes.Bytes
    slim = rawbytes.BytesAlloc(n)
    var index: int32
    while index < n:
        rawbytes.BytesSet(slim, index, rawbytes.BytesGet(buf, index))
        index = index + 1
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(slim))
    rawbytes.BytesFree(slim)
    return "sha256:" + layout.FixedBytes32Hex(digest)

fn productionHeldExecStackCid4(
        domain: str,
        a: uint64,
        b: uint64,
        c: uint64,
        d: uint64): str =
    var buf: rawbytes.Bytes
    buf = rawbytes.BytesAlloc(160)
    var off: int32
    var index: int32
    while index < domain.len && off < 96:
        productionHeldExecBytesPutU8(buf, off, 160, domain[index])
        index = index + 1
    productionHeldExecBytesPutU64(buf, off, 160, a)
    productionHeldExecBytesPutU64(buf, off, 160, b)
    productionHeldExecBytesPutU64(buf, off, 160, c)
    productionHeldExecBytesPutU64(buf, off, 160, d)
    let cid = productionHeldExecHashPrefix(buf, off)
    rawbytes.BytesFree(buf)
    return cid

fn productionHeldExecDigestCid(
        word0: uint64,
        word1: uint64,
        word2: uint64,
        word3: uint64): str =
    if word0 == uint64(0) && word1 == uint64(0) &&
       word2 == uint64(0) && word3 == uint64(0):
        return ""
    var digest: layout.FixedBytes32
    for byteIndex in 0..<32:
        let limbIndex = byteIndex / 8
        var limb = word0
        if limbIndex == 1:
            limb = word1
        elif limbIndex == 2:
            limb = word2
        elif limbIndex == 3:
            limb = word3
        digest.data[byteIndex] = uint8(
            (limb >> uint64((byteIndex % 8) * 8)) & uint64(255))
    return "sha256:" + layout.FixedBytes32Hex(digest)

@borrows
fn productionHeldExecStackAppendText(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: str) =
    productionHeldExecBytesPutU32(buf, off, cap, value.len)
    var index: int32
    while index < value.len && off < cap:
        productionHeldExecBytesPutU8(buf, off, cap, value[index])
        index = index + 1

@borrows
fn productionHeldExecStackAppendBool(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: bool) =
    if value:
        productionHeldExecStackAppendText(buf, off, cap, "true")
    else:
        productionHeldExecStackAppendText(buf, off, cap, "false")

@borrows
fn CsgCoreProductionHeldExecProviderSessionNonceCid(
        capability:
            var system.RuntimeAllocationLedgerSessionCapability): str =
    return productionHeldExecStackCid4(
        CsgCoreProductionHeldExecSessionNonceDomain,
        capability.nonce0,
        capability.nonce1,
        uint64(0),
        uint64(0))

@borrows
fn CsgCoreProductionHeldExecProviderSessionCapabilityCid(
        capability:
            var system.RuntimeAllocationLedgerSessionCapability): str =
    return productionHeldExecStackCid4(
        CsgCoreProductionHeldExecSessionDomain,
        capability.handle,
        capability.generation,
        capability.nonce0,
        capability.nonce1)

@borrows
fn productionHeldExecAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn productionHeldExecAppendU64(
        out: var layout.ByteBuf,
        value: uint64) =
    var remaining = value
    for byteIndex in 0..<8:
        layout.ByteBufAppendByte(out, int32(remaining & uint64(255)))
        remaining = remaining >> uint64(8)

@borrows
fn productionHeldExecAppendText(
        out: var layout.ByteBuf,
        value: str) =
    productionHeldExecAppendU32(out, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(out, value[index])

@borrows
fn productionHeldBundleReadU32(
        bytes: str,
        offset: int32): int32 =
    if offset < 0 || offset > bytes.len - 4:
        return -1
    return int32(bytes[offset]) |
        (int32(bytes[offset + 1]) << 8) |
        (int32(bytes[offset + 2]) << 16) |
        (int32(bytes[offset + 3]) << 24)

@borrows
fn productionHeldBundleReadU64(
        bytes: str,
        offset: int32,
        out: var uint64): bool =
    out = uint64(0)
    if offset < 0 || offset > bytes.len - 8:
        return false
    for byteIndex in 0..<8:
        out = out |
            (uint64(bytes[offset + byteIndex]) << uint64(byteIndex * 8))
    return true

# Canonical transport envelope only. Nested CSGC/proof/request payloads keep
# their own strict codecs and authority; this layer fixes field count, tag
# order, lengths and raw-byte identity without interpreting nested bytes.
@borrows
fn productionHeldBundleEncodeInto(
        payloads: str[],
        outEnvelopeBytes: var str,
        outHeldBundleCid: var str,
        err: var str): bool =
    outEnvelopeBytes = ""
    outHeldBundleCid = ""
    err = ""
    if payloads.len != CsgCoreProductionHeldBundleFieldCount:
        err = "production_held_bundle_e_field_count"
        return false
    var totalBytes: int64
    for fieldIndex in 0..<payloads.len:
        let payloadBytes = int64(payloads[fieldIndex].len)
        if payloadBytes <= int64(0) ||
           totalBytes > CsgCoreProductionHeldBundleMaxBytes - int64(12) -
               payloadBytes:
            err = "production_held_bundle_e_field_length"
            return false
        totalBytes = totalBytes + int64(12) + payloadBytes
    if totalBytes <= int64(0) ||
       totalBytes > CsgCoreProductionHeldBundleMaxBytes ||
       totalBytes > int64(2147483647):
        err = "production_held_bundle_e_total_length"
        return false
    var envelope = layout.ByteBufInit(int32(totalBytes))
    for fieldIndex in 0..<payloads.len:
        productionHeldExecAppendU32(envelope, fieldIndex + 1)
        productionHeldExecAppendU64(
            envelope, uint64(payloads[fieldIndex].len))
        for byteIndex in 0..<payloads[fieldIndex].len:
            layout.ByteBufAppendByte(
                envelope, payloads[fieldIndex][byteIndex])
    if layout.ByteBufLen(envelope) != int32(totalBytes):
        layout.ByteBufFree(envelope)
        err = "production_held_bundle_e_encode_length"
        return false
    var bytes = layout.ByteBufToBytes(envelope)
    layout.ByteBufFree(envelope)
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes))
    outHeldBundleCid =
        "sha256:" + layout.FixedBytes32Hex(digest)
    outEnvelopeBytes = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    if outEnvelopeBytes.len != int32(totalBytes) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(outHeldBundleCid):
        outEnvelopeBytes = ""
        outHeldBundleCid = ""
        err = "production_held_bundle_e_identity"
        return false
    return true

@borrows
fn productionHeldBundleDecodeStrictInto(
        envelopeBytes: str,
        outPayloads: var str[],
        outHeldBundleCid: var str,
        err: var str): bool =
    outPayloads = []
    outHeldBundleCid = ""
    err = ""
    if envelopeBytes.len <= 0 ||
       int64(envelopeBytes.len) > CsgCoreProductionHeldBundleMaxBytes:
        err = "production_held_bundle_e_total_length"
        return false
    var offset: int32
    for fieldIndex in 0..<CsgCoreProductionHeldBundleFieldCount:
        if offset > envelopeBytes.len - 12 ||
           productionHeldBundleReadU32(envelopeBytes, offset) !=
               fieldIndex + 1:
            outPayloads = []
            err = "production_held_bundle_e_tag_order"
            return false
        var payloadBytes: uint64
        if !productionHeldBundleReadU64(
               envelopeBytes, offset + 4, payloadBytes) ||
           payloadBytes == uint64(0) ||
           payloadBytes > uint64(2147483647) ||
           payloadBytes > uint64(envelopeBytes.len - offset - 12):
            outPayloads = []
            err = "production_held_bundle_e_field_length"
            return false
        offset = offset + 12
        add(outPayloads, strings.CloneStr(strings.SliceBytes(
            envelopeBytes, offset, int32(payloadBytes))))
        offset = offset + int32(payloadBytes)
    if offset != envelopeBytes.len:
        outPayloads = []
        err = "production_held_bundle_e_trailing_bytes"
        return false
    var canonicalBytes: str
    var canonicalCid: str
    var encodeErr: str
    if !productionHeldBundleEncodeInto(
           outPayloads, canonicalBytes, canonicalCid, encodeErr) ||
       canonicalBytes != envelopeBytes:
        outPayloads = []
        err = "production_held_bundle_e_noncanonical"
        return false
    outHeldBundleCid = strings.CloneStr(canonicalCid)
    return true

# --- typed portable pre-exec input ----------------------------------------
#
# Outer tags 1..16 are fixed by CsgCoreProductionHeldBundle.  Each cargo is
# independently typed as:
#   u32le schema-version || u32le field-id || field-specific body
# Text bodies are u32le length + raw semantic UTF-8 bytes; CIDs are the exact
# canonical `sha256:` bytes; optionals carry an explicit 0/1 presence byte;
# vectors carry u32le count followed by fixed-width canonical CIDs.  No host
# path, argv, environment or local descriptor locator is representable.

@borrows
fn productionPreExecCargoHeader(
        out: var layout.ByteBuf,
        fieldId: int32) =
    productionHeldExecAppendU32(
        out, CsgCoreProductionPreExecInputSchemaVersion)
    productionHeldExecAppendU32(out, fieldId)

fn productionPreExecCargoFinish(
        out: var layout.ByteBuf): str =
    var bytes = layout.ByteBufToBytes(out)
    layout.ByteBufFree(out)
    let text = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return text

fn productionPreExecCargoI32(
        fieldId: int32,
        value: int32): str =
    var out = layout.ByteBufInit(12)
    productionPreExecCargoHeader(out, fieldId)
    productionHeldExecAppendU32(out, value)
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCargoText(
        fieldId: int32,
        value: str): str =
    var out = layout.ByteBufInit(12 + value.len)
    productionPreExecCargoHeader(out, fieldId)
    productionHeldExecAppendU32(out, value.len)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(out, value[byteIndex])
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCargoCid(
        fieldId: int32,
        value: str): str =
    var out = layout.ByteBufInit(79)
    productionPreExecCargoHeader(out, fieldId)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(out, value[byteIndex])
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCargoOptionalCid(
        fieldId: int32,
        value: str): str =
    var out = layout.ByteBufInit(80)
    productionPreExecCargoHeader(out, fieldId)
    if value.len == 0:
        layout.ByteBufAppendByte(out, 0)
    else:
        layout.ByteBufAppendByte(out, 1)
        for byteIndex in 0..<value.len:
            layout.ByteBufAppendByte(out, value[byteIndex])
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCargoCidVector(
        fieldId: int32,
        values: str[]): str =
    var out = layout.ByteBufInit(12 + values.len * 71)
    productionPreExecCargoHeader(out, fieldId)
    productionHeldExecAppendU32(out, values.len)
    for valueIndex in 0..<values.len:
        for byteIndex in 0..<values[valueIndex].len:
            layout.ByteBufAppendByte(out, values[valueIndex][byteIndex])
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCargoTextVector(
        fieldId: int32,
        values: str[]): str =
    var totalBytes: int32 = 12
    for valueIndex in 0..<values.len:
        totalBytes = totalBytes + 4 + values[valueIndex].len
    var out = layout.ByteBufInit(totalBytes)
    productionPreExecCargoHeader(out, fieldId)
    productionHeldExecAppendU32(out, values.len)
    for valueIndex in 0..<values.len:
        productionHeldExecAppendU32(out, values[valueIndex].len)
        for byteIndex in 0..<values[valueIndex].len:
            layout.ByteBufAppendByte(out, values[valueIndex][byteIndex])
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCargoExactFunction(
        fieldId: int32,
        value: CsgCoreProductionPreExecExactFunctionRequest): str =
    var out = layout.ByteBufInit(
        17 + value.canonicalModulePath.len + value.symbolSelector.len)
    productionPreExecCargoHeader(out, fieldId)
    if value.canonicalModulePath.len == 0 && value.symbolSelector.len == 0:
        layout.ByteBufAppendByte(out, 0)
    else:
        layout.ByteBufAppendByte(out, 1)
        productionHeldExecAppendU32(out, value.canonicalModulePath.len)
        for byteIndex in 0..<value.canonicalModulePath.len:
            layout.ByteBufAppendByte(out, value.canonicalModulePath[byteIndex])
        productionHeldExecAppendU32(out, value.symbolSelector.len)
        for byteIndex in 0..<value.symbolSelector.len:
            layout.ByteBufAppendByte(out, value.symbolSelector[byteIndex])
    return productionPreExecCargoFinish(out)

@borrows
fn productionPreExecCanonicalModulePath(value: str): bool =
    if value.len <= 0 || value.len > 4096 ||
       value[0] == '/' || value[value.len - 1] == '/' ||
       value[0] == '\\' || value[value.len - 1] == '\\':
        return false
    var segmentStart: int32
    for byteIndex in 0..<(value.len + 1):
        if byteIndex < value.len:
            let ch = value[byteIndex]
            let allowed =
                (ch >= 'a' && ch <= 'z') ||
                (ch >= 'A' && ch <= 'Z') ||
                (ch >= '0' && ch <= '9') ||
                ch == '_' || ch == '-' || ch == '.' || ch == '/'
            if !allowed || ch == '\\' || ch == ':' || ch == '\0' ||
               ch == '\n' || ch == '\r':
                return false
            if ch != '/':
                continue
        if byteIndex <= segmentStart:
            return false
        let segment = strings.SliceBytes(
            value, segmentStart, byteIndex - segmentStart)
        if segment == "." || segment == "..":
            return false
        segmentStart = byteIndex + 1
    return true

@borrows
fn productionPreExecCanonicalTargetTriple(value: str): bool =
    if value.len <= 2 || value.len > 128 ||
       value[0] == '-' || value[value.len - 1] == '-':
        return false
    var dashCount: int32
    for byteIndex in 0..<value.len:
        let ch = value[byteIndex]
        let allowed =
            (ch >= 'a' && ch <= 'z') ||
            (ch >= '0' && ch <= '9') ||
            ch == '_' || ch == '-' || ch == '.'
        if !allowed:
            return false
        if ch == '-':
            dashCount = dashCount + 1
    return dashCount > 0

@borrows
fn productionPreExecCanonicalSymbol(value: str): bool =
    if value.len <= 0 || value.len > 1024:
        return false
    for byteIndex in 0..<value.len:
        let ch = value[byteIndex]
        let allowed =
            (ch >= 'a' && ch <= 'z') ||
            (ch >= 'A' && ch <= 'Z') ||
            (ch >= '0' && ch <= '9') || ch == '_'
        if !allowed || (byteIndex == 0 && ch >= '0' && ch <= '9'):
            return false
    return true

@borrows
fn productionPreExecSymbolVectorValid(values: str[]): bool =
    if values.len > 65535:
        return false
    var wireBytes: int64 = int64(12)
    for valueIndex in 0..<values.len:
        if !productionPreExecCanonicalSymbol(values[valueIndex]) ||
           wireBytes > int64(8388608) - int64(4) -
               int64(values[valueIndex].len):
            return false
        wireBytes = wireBytes + int64(4) +
            int64(values[valueIndex].len)
    return true

@borrows
fn productionPreExecCidVectorValid(values: str[]): bool =
    if values.len > 65535:
        return false
    for valueIndex in 0..<values.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               values[valueIndex]):
            return false
    return true

@borrows
fn CsgCoreProductionPreExecInputStrictValid(
        value: CsgCoreProductionPreExecInput): bool =
    if value.schemaVersion !=
           CsgCoreProductionPreExecInputSchemaVersion ||
       value.semanticCommand !=
           CsgCoreProductionPreExecInputCommandSystemLinkExec ||
       value.outputRole !=
           CsgCoreProductionPreExecInputOutputBuildArtifact ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.packageSourceRootIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.compilerRequestCid) ||
       !productionPreExecCanonicalModulePath(value.canonicalModulePath) ||
       !productionPreExecCanonicalTargetTriple(value.targetTriple) ||
       value.jobCount < 1:
        return false
    if value.compilerRequestCid ==
           value.packageSourceRootIdentityCid:
        return false
    if value.emitKind != CsgCoreProductionPreExecInputEmitExe &&
       value.emitKind != CsgCoreProductionPreExecInputEmitObj &&
       value.emitKind != CsgCoreProductionPreExecInputEmitShared:
        return false
    if value.reportRole != CsgCoreProductionPreExecInputReportAbsent &&
       value.reportRole != CsgCoreProductionPreExecInputReportCompile &&
       value.reportRole != CsgCoreProductionPreExecInputReportExactFunction:
        return false
    if value.symbolVisibility !=
           CsgCoreProductionPreExecInputVisibilityPublic &&
       value.symbolVisibility !=
           CsgCoreProductionPreExecInputVisibilityInternal:
        return false
    if value.compileMode !=
           CsgCoreProductionPreExecInputCompileModeDefault &&
       value.compileMode !=
           CsgCoreProductionPreExecInputCompileModeProduction:
        return false
    if value.backendKind != CsgCoreProductionPreExecInputBackendPrimary &&
       value.backendKind != CsgCoreProductionPreExecInputBackend2:
        return false
    if (value.browserBridgeObjectCid.len > 0 &&
        !merkle_store_codec.CsgCoreMerkleStoreCidValid(
            value.browserBridgeObjectCid)) ||
       (value.runtimeProviderBundleCid.len > 0 &&
        !merkle_store_codec.CsgCoreMerkleStoreCidValid(
            value.runtimeProviderBundleCid)) ||
       !productionPreExecSymbolVectorValid(value.exportRootSymbols) ||
       !productionPreExecCidVectorValid(value.providerObjectCids):
        return false
    let exactPresent = value.exactFunctionRequest.canonicalModulePath.len > 0 ||
        value.exactFunctionRequest.symbolSelector.len > 0
    if exactPresent &&
       (!productionPreExecCanonicalModulePath(
            value.exactFunctionRequest.canonicalModulePath) ||
        !productionPreExecCanonicalSymbol(
            value.exactFunctionRequest.symbolSelector)):
        return false
    return (value.reportRole ==
                CsgCoreProductionPreExecInputReportExactFunction) ==
           exactPresent

@borrows
fn CsgCoreProductionPreExecInputEncodeInto(
        value: CsgCoreProductionPreExecInput,
        outEnvelopeBytes: var str,
        outEnvelopeCid: var str,
        err: var str): bool =
    outEnvelopeBytes = ""
    outEnvelopeCid = ""
    err = ""
    if !CsgCoreProductionPreExecInputStrictValid(value):
        err = "production_pre_exec_input_e_value"
        return false
    var payloads: str[]
    add(payloads, productionPreExecCargoI32(1, value.semanticCommand))
    add(payloads, productionPreExecCargoCid(
        2, value.packageSourceRootIdentityCid))
    add(payloads, productionPreExecCargoText(
        3, value.canonicalModulePath))
    add(payloads, productionPreExecCargoI32(4, value.outputRole))
    add(payloads, productionPreExecCargoText(5, value.targetTriple))
    add(payloads, productionPreExecCargoI32(6, value.emitKind))
    add(payloads, productionPreExecCargoI32(7, value.reportRole))
    add(payloads, productionPreExecCargoI32(8, value.symbolVisibility))
    add(payloads, productionPreExecCargoOptionalCid(
        9, value.browserBridgeObjectCid))
    add(payloads, productionPreExecCargoTextVector(
        10, value.exportRootSymbols))
    add(payloads, productionPreExecCargoCidVector(
        11, value.providerObjectCids))
    add(payloads, productionPreExecCargoOptionalCid(
        12, value.runtimeProviderBundleCid))
    add(payloads, productionPreExecCargoI32(13, value.compileMode))
    add(payloads, productionPreExecCargoI32(14, value.backendKind))
    add(payloads, productionPreExecCargoI32(15, value.jobCount))
    add(payloads, productionPreExecCargoExactFunction(
        16, value.exactFunctionRequest))
    add(payloads, productionPreExecCargoCid(
        17, value.compilerRequestCid))
    return productionHeldBundleEncodeInto(
        payloads, outEnvelopeBytes, outEnvelopeCid, err)

@borrows
fn productionPreExecCargoHeaderValid(
        payload: str,
        fieldId: int32): bool =
    return payload.len >= 8 &&
        productionHeldBundleReadU32(payload, 0) ==
            CsgCoreProductionPreExecInputSchemaVersion &&
        productionHeldBundleReadU32(payload, 4) == fieldId

@borrows
fn productionPreExecDecodeI32Cargo(
        payload: str,
        fieldId: int32,
        out: var int32): bool =
    out = 0
    if payload.len != 12 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    out = productionHeldBundleReadU32(payload, 8)
    return true

@borrows
fn productionPreExecDecodeTextCargo(
        payload: str,
        fieldId: int32,
        out: var str): bool =
    out = ""
    if payload.len < 12 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    let count = productionHeldBundleReadU32(payload, 8)
    if count < 0 || count != payload.len - 12:
        return false
    out = strings.CloneStr(strings.SliceBytes(payload, 12, count))
    return true

@borrows
fn productionPreExecDecodeCidCargo(
        payload: str,
        fieldId: int32,
        out: var str): bool =
    out = ""
    if payload.len != 79 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    out = strings.CloneStr(strings.SliceBytes(payload, 8, 71))
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(out)

@borrows
fn productionPreExecDecodeOptionalCidCargo(
        payload: str,
        fieldId: int32,
        out: var str): bool =
    out = ""
    if payload.len < 9 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    let present = payload[8]
    if present == 0:
        return payload.len == 9
    if present != 1 || payload.len != 80:
        return false
    out = strings.CloneStr(strings.SliceBytes(payload, 9, 71))
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(out)

@borrows
fn productionPreExecDecodeCidVectorCargo(
        payload: str,
        fieldId: int32,
        out: var str[]): bool =
    out = []
    if payload.len < 12 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    let count = productionHeldBundleReadU32(payload, 8)
    if count < 0 || count > 65535 ||
       count > (2147483647 - 12) / 71 ||
       payload.len != 12 + count * 71:
        return false
    for valueIndex in 0..<count:
        let cid = strings.CloneStr(strings.SliceBytes(
            payload, 12 + valueIndex * 71, 71))
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(cid):
            out = []
            return false
        add(out, cid)
    return true

@borrows
fn productionPreExecDecodeTextVectorCargo(
        payload: str,
        fieldId: int32,
        out: var str[]): bool =
    out = []
    if payload.len < 12 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    let count = productionHeldBundleReadU32(payload, 8)
    if count < 0 || count > 65535:
        return false
    var offset: int32 = 12
    for valueIndex in 0..<count:
        if offset > payload.len - 4:
            out = []
            return false
        let textBytes = productionHeldBundleReadU32(payload, offset)
        offset = offset + 4
        if textBytes <= 0 || textBytes > payload.len - offset:
            out = []
            return false
        let text = strings.CloneStr(strings.SliceBytes(
            payload, offset, textBytes))
        if !productionPreExecCanonicalSymbol(text):
            out = []
            return false
        add(out, text)
        offset = offset + textBytes
    return offset == payload.len

@borrows
fn productionPreExecDecodeExactFunctionCargo(
        payload: str,
        fieldId: int32,
        out: var CsgCoreProductionPreExecExactFunctionRequest): bool =
    out = CsgCoreProductionPreExecExactFunctionRequest()
    if payload.len < 9 ||
       !productionPreExecCargoHeaderValid(payload, fieldId):
        return false
    let present = payload[8]
    if present == 0:
        return payload.len == 9
    if present != 1 || payload.len < 17:
        return false
    let moduleBytes = productionHeldBundleReadU32(payload, 9)
    if moduleBytes <= 0 || moduleBytes > payload.len - 13:
        return false
    let symbolLengthOffset = 13 + moduleBytes
    if symbolLengthOffset > payload.len - 4:
        return false
    let symbolBytes = productionHeldBundleReadU32(
        payload, symbolLengthOffset)
    if symbolBytes <= 0 ||
       symbolBytes != payload.len - symbolLengthOffset - 4:
        return false
    out.canonicalModulePath = strings.CloneStr(strings.SliceBytes(
        payload, 13, moduleBytes))
    out.symbolSelector = strings.CloneStr(strings.SliceBytes(
        payload, symbolLengthOffset + 4, symbolBytes))
    return productionPreExecCanonicalModulePath(out.canonicalModulePath) &&
        productionPreExecCanonicalSymbol(out.symbolSelector)

@borrows
fn CsgCoreProductionPreExecInputDecodeStrictInto(
        envelopeBytes: str,
        out: var CsgCoreProductionPreExecInput,
        outEnvelopeCid: var str,
        err: var str): bool =
    out = CsgCoreProductionPreExecInput()
    outEnvelopeCid = ""
    err = ""
    if envelopeBytes.len <= 0 ||
       envelopeBytes.len > CsgCoreProductionPreExecInputMaxBytes:
        err = "production_pre_exec_input_e_envelope_length"
        return false
    var payloads: str[]
    var genericEnvelopeCid: str
    if !productionHeldBundleDecodeStrictInto(
           envelopeBytes, payloads, genericEnvelopeCid, err):
        return false
    out.schemaVersion = CsgCoreProductionPreExecInputSchemaVersion
    if !productionPreExecDecodeI32Cargo(
           payloads[0], 1, out.semanticCommand) ||
       !productionPreExecDecodeCidCargo(
           payloads[1], 2, out.packageSourceRootIdentityCid) ||
       !productionPreExecDecodeTextCargo(
           payloads[2], 3, out.canonicalModulePath) ||
       !productionPreExecDecodeI32Cargo(
           payloads[3], 4, out.outputRole) ||
       !productionPreExecDecodeTextCargo(
           payloads[4], 5, out.targetTriple) ||
       !productionPreExecDecodeI32Cargo(
           payloads[5], 6, out.emitKind) ||
       !productionPreExecDecodeI32Cargo(
           payloads[6], 7, out.reportRole) ||
       !productionPreExecDecodeI32Cargo(
           payloads[7], 8, out.symbolVisibility) ||
       !productionPreExecDecodeOptionalCidCargo(
           payloads[8], 9, out.browserBridgeObjectCid) ||
       !productionPreExecDecodeTextVectorCargo(
           payloads[9], 10, out.exportRootSymbols) ||
       !productionPreExecDecodeCidVectorCargo(
           payloads[10], 11, out.providerObjectCids) ||
       !productionPreExecDecodeOptionalCidCargo(
           payloads[11], 12, out.runtimeProviderBundleCid) ||
       !productionPreExecDecodeI32Cargo(
           payloads[12], 13, out.compileMode) ||
       !productionPreExecDecodeI32Cargo(
           payloads[13], 14, out.backendKind) ||
       !productionPreExecDecodeI32Cargo(
           payloads[14], 15, out.jobCount) ||
       !productionPreExecDecodeExactFunctionCargo(
           payloads[15], 16, out.exactFunctionRequest) ||
       !productionPreExecDecodeCidCargo(
           payloads[16], 17, out.compilerRequestCid) ||
       !CsgCoreProductionPreExecInputStrictValid(out):
        out = CsgCoreProductionPreExecInput()
        err = "production_pre_exec_input_e_typed_cargo"
        return false
    var canonicalBytes: str
    var canonicalCid: str
    var encodeErr: str
    if !CsgCoreProductionPreExecInputEncodeInto(
           out, canonicalBytes, canonicalCid, encodeErr) ||
       canonicalBytes != envelopeBytes ||
       canonicalCid != genericEnvelopeCid:
        out = CsgCoreProductionPreExecInput()
        err = "production_pre_exec_input_e_noncanonical"
        return false
    outEnvelopeCid = strings.CloneStr(canonicalCid)
    return true

