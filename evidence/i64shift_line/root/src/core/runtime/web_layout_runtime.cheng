            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore1, __webLayoutFontWeight1, targetWeight):
                bestScore = candidateScore1
                bestWeight = __webLayoutFontWeight1
                bestFaceIndex = 1
                bestGlyphIndex = glyph1
    if __webLayoutFontFaceCount >= 3:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace2, codepoint)
        if glyph2 > 0:
