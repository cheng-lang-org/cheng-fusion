# K-cluster fix: 自顶向下传播的绝对定位包含块(最近非 static 祖先的盒子)栈。
# 用四个平行固定容量数组保存 x/y/w/h;第 WebLayoutPosDepth-1 项为当前最近非 static 祖先的包含块。
var WebLayoutPosDepth: int32
var WebLayoutPosOriginX: int32[128]
var WebLayoutPosOriginY: int32[128]
var WebLayoutPosOriginW: int32[128]
var WebLayoutPosOriginH: int32[128]

fn WebLayoutPushPositionedOrigin(cbX: int32, cbY: int32, cbW: int32, cbH: int32): bool =
    if WebLayoutPosDepth >= 128:
        return false
    WebLayoutPosOriginX[WebLayoutPosDepth] = cbX
    WebLayoutPosOriginY[WebLayoutPosDepth] = cbY
    WebLayoutPosOriginW[WebLayoutPosDepth] = cbW
    WebLayoutPosOriginH[WebLayoutPosDepth] = cbH
    WebLayoutPosDepth = WebLayoutPosDepth + 1
    return true

fn WebLayoutPopPositionedOrigin(): bool =
    if WebLayoutPosDepth <= 0:
        return false
    WebLayoutPosDepth = WebLayoutPosDepth - 1
    return true

fn WebLayoutTreeInit(tree: var WebLayoutTree) =
    tree.nextNodeId = 1
    tree.viewportWidth = 0
    tree.viewportHeight = 0
    tree.boxCount = 0
    tree.layoutDepth = 0
    tree.rootNodeId = 0
    tree.styles = []
    tree.children = []
    tree.boxes = []
    tree.gridTracks = []
    tree.gridItems = []
    tree.flexChildIds = []
    tree.flexChildMain = []
    tree.flexChildCross = []
    tree.flexChildOrders = []
    tree.visitedNodeIds = []
    tree.styleIndexByNodeId = []
    tree.styleIndexSynced = 0
    tree.parentByChildNodeId = []
    tree.childCountByParentNodeId = []
    tree.childIndexSynced = 0
    tree.firstBoxIndexByNodeId = []
    tree.visibleBoxIndexByNodeId = []
    tree.boxIndexSynced = 0
    tree.blockBoxIndexByNodeId = []

# Arena-reuse reset: same scalar resets as WebLayoutTreeInit, but every seq is
# truncated with setLen(0) (which never shrinks cap) so backing capacity is
# retained across rebuilds — warm rebuilds do zero array alloc churn instead of
# the grow-from-8 malloc/free storm of a fresh Init. Managed textContent slots
# are released explicitly before styles truncation. Pairs with a persistent
# module-level tree on hot rebuild paths (arena semantics: capacity lives for
# the process, not per rebuild).
fn WebLayoutTreeResetForReuse(tree: var WebLayoutTree) =
    tree.nextNodeId = 1
    tree.viewportWidth = 0
    tree.viewportHeight = 0
    tree.boxCount = 0
    tree.layoutDepth = 0
    tree.rootNodeId = 0
    var si: int32
    while si < tree.styles.len:
        tree.styles[si].textContent = ""
        si = si + 1
    setLen(tree.styles, 0)
    setLen(tree.children, 0)
    setLen(tree.boxes, 0)
    setLen(tree.gridTracks, 0)
    setLen(tree.gridItems, 0)
    setLen(tree.flexChildIds, 0)
    setLen(tree.flexChildMain, 0)
    setLen(tree.flexChildCross, 0)
    setLen(tree.flexChildOrders, 0)
    setLen(tree.visitedNodeIds, 0)
    setLen(tree.styleIndexByNodeId, 0)
    tree.styleIndexSynced = 0
    setLen(tree.parentByChildNodeId, 0)
    setLen(tree.childCountByParentNodeId, 0)
    tree.childIndexSynced = 0
    # Box index caches keep their capacity: they are keyed by nodeId and fully
    # re-zeroed + refilled by WebLayoutRebuildBoxIndexes on the first lookup
    # after invalidation, so truncating them here would only re-pay the
    # grow-from-8 realloc chain every rebuild. boxIndexSynced = -1 is the
    # established force-invalidate sentinel (see WebLayoutPurgeNodeBoxes).
    tree.boxIndexSynced = -1

fn WebLayoutDisplaySupported(display: int32): bool =
    if display == WebLayoutDisplayBlock:
        return true
    if display == WebLayoutDisplayNone:
        return true
    if display == WebLayoutDisplayInline:
        return true
    if display == WebLayoutDisplayFlex:
        return true
    if display == WebLayoutDisplayGrid:
        return true
    if display == WebLayoutDisplayTable:
        return true
    if display == WebLayoutDisplayMasonry:
        return true
    return false

fn WebLayoutStyleSupported(display: int32, width: int32, height: int32,
                            marginLeft: int32, marginTop: int32): bool =
    if !WebLayoutDisplaySupported(display):
        return false
    if width < 0 || height < 0:
        return false
    # 负外边距是合法 CSS(常用于元素贴边微调), 布局算术已按带符号处理
    return true

fn WebLayoutInitStyleBoxDefaults(style: var WebLayoutStyleBox) =
    style.paddingLeft = 0
    style.tableRole = WebLayoutTableRoleNone
    style.paddingTop = 0
    style.paddingRight = 0
    style.paddingBottom = 0
    style.borderTopWidth = 0
    style.borderRightWidth = 0
    style.borderBottomWidth = 0
    style.borderLeftWidth = 0
    style.flexDirection = WebLayoutFlexDirectionRow
    style.justifyContent = WebLayoutJustifyContentFlexStart
    style.alignItems = WebLayoutAlignItemsStretch
    style.flex = 0
    style.flexShrink = 1
    style.gap = 0
    style.masonryMinColumnWidth = 180
    style.masonryMinColumns = 2
    style.masonryMaxColumns = 6
    style.masonryEstimatedItemHeight = 200
    style.masonryModel = WebLayoutMasonryModelDefault
    style.fontSize = 16
    style.renderFontSize = 16
    style.lineHeight = 0
    style.lineHeightPx2 = 0
    style.renderFontWeight = 400
    style.fontFamily = WebLayoutFontFamilySans
    style.textContent = ""
    style.fontSizeExplicit = false
    style.lineHeightExplicit = false
    style.fontWeightExplicit = false
    style.fontFamilyExplicit = false
    style.position = WebLayoutPositionStatic
    style.zIndex = 0
    style.offsetTop = 0
    style.offsetRight = 0
    style.offsetBottom = 0
    style.offsetLeft = 0
    style.offsetTopPercent = 0
    style.offsetRightPercent = 0
    style.offsetBottomPercent = 0
    style.offsetLeftPercent = 0
    style.visible = true
    style.overflowX = WebLayoutOverflowVisible
    style.overflowY = WebLayoutOverflowVisible
    style.opacity = 255
    style.flexWrap = 0
    style.alignContent = WebLayoutAlignContentFlexStart
    style.alignSelf = WebLayoutAlignSelfAuto
    style.order = 0
    style.boxSizing = WebLayoutBoxSizingContentBox
    style.textAlign = WebLayoutTextAlignLeft
    style.textAlignExplicit = false
    style.minWidth = 0
    style.hasMinWidth = false
    style.hasWidthDeclared = false
    style.maxWidth = 0
    style.minHeight = 0
    style.maxHeight = 0
    style.aspectRatioNumerator = 0
    style.aspectRatioDenominator = 0
    style.inlineLevel = false
    style.whiteSpaceNowrap = false
    style.whiteSpaceExplicit = false
    style.wordBreakBreakAll = false
    style.wordBreakExplicit = false
    style.textOverflowEllipsis = false
    style.hasOffsetTop = false
    style.hasOffsetRight = false
    style.hasOffsetBottom = false
    style.hasOffsetLeft = false
    style.hasOffsetTopPercent = false
    style.hasOffsetRightPercent = false
    style.hasOffsetBottomPercent = false
    style.hasOffsetLeftPercent = false

fn WebLayoutResolvePercentSize(percent: int32, basis: int32): int32 =
    if percent <= 0 || basis <= 0:
        return 0
    return basis * percent / 100

fn WebLayoutResolveOffsetValue(offsetPx: int32, offsetPercent: int32, hasPercent: bool, basis: int32): int32 =
    if hasPercent:
        return WebLayoutResolvePercentSize(offsetPercent, basis)
    return offsetPx

fn WebLayoutResolvedWidth(tree: var WebLayoutTree, styleIdx: int32, basis: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return 0
    if tree.styles[styleIdx].width > 0:
        return tree.styles[styleIdx].width
    if tree.styles[styleIdx].width < 0:
        return WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].width, basis)
    return 0

fn WebLayoutResolvedHeight(tree: var WebLayoutTree, styleIdx: int32, basis: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return 0
    if tree.styles[styleIdx].height > 0:
        return tree.styles[styleIdx].height
    if tree.styles[styleIdx].height < 0:
        return WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].height, basis)
    return 0

fn WebLayoutAspectRatioHeightForWidth(tree: var WebLayoutTree, styleIdx: int32, width: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return 0
    if width <= 0:
        return 0
    let numerator = tree.styles[styleIdx].aspectRatioNumerator
    let denominator = tree.styles[styleIdx].aspectRatioDenominator
    if numerator <= 0 || denominator <= 0:
        return 0
    let value = int64(width) * int64(denominator)
    return Int32((value + int64(numerator / 2)) / int64(numerator))

fn WebLayoutClampHeightConstraints(tree: var WebLayoutTree, styleIdx: int32, height: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return height
    var result = height
    if tree.styles[styleIdx].minHeight > 0 && result < tree.styles[styleIdx].minHeight:
        result = tree.styles[styleIdx].minHeight
    if tree.styles[styleIdx].maxHeight > 0 && result > tree.styles[styleIdx].maxHeight:
        result = tree.styles[styleIdx].maxHeight
    return result

fn WebLayoutCreateStyleBox(tree: var WebLayoutTree,
                           display: int32,
                           width: int32,
                           height: int32,
                           marginLeft: int32,
                           marginTop: int32,
                           outNodeId: var int32): bool =
    outNodeId = 0
    if !WebLayoutStyleSupported(display, width, height, marginLeft, marginTop):
        return false
    let nodeId = tree.nextNodeId
    tree.nextNodeId = tree.nextNodeId + 1
    var style: WebLayoutStyleBox
    WebLayoutInitStyleBoxDefaults(style)
    style.nodeId = nodeId
    style.display = display
    style.width = width
    style.height = height
    style.marginLeft = marginLeft
    style.marginTop = marginTop
    style.marginRight = 0
    style.marginBottom = 0
    style.marginLeftAuto = false
    style.marginTopAuto = false
    style.marginRightAuto = false
    style.marginBottomAuto = false
    add(tree.styles, style)
    if tree.rootNodeId == 0:
        tree.rootNodeId = nodeId
    outNodeId = nodeId
    return true

fn WebLayoutSetFlexStyle(tree: var WebLayoutTree, nodeId: int32,
                         flexDirection: int32, justifyContent: int32,
                         alignItems: int32, flex: int32, gap: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    tree.styles[styleIdx].flexDirection = flexDirection
    tree.styles[styleIdx].justifyContent = justifyContent
    tree.styles[styleIdx].alignItems = alignItems
    tree.styles[styleIdx].flex = flex
    tree.styles[styleIdx].gap = gap
    return true

fn WebLayoutSetMasonryStyle(tree: var WebLayoutTree, nodeId: int32,
                            minColumnWidth: int32, minColumns: int32,
                            maxColumns: int32, estimatedItemHeight: int32,
                            gap: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if minColumnWidth <= 0 || minColumns <= 0 || maxColumns < minColumns || estimatedItemHeight <= 0 || gap < 0:
        return false
    tree.styles[styleIdx].display = WebLayoutDisplayMasonry
    tree.styles[styleIdx].masonryMinColumnWidth = minColumnWidth
    tree.styles[styleIdx].masonryMinColumns = minColumns
    tree.styles[styleIdx].masonryMaxColumns = maxColumns
    tree.styles[styleIdx].masonryEstimatedItemHeight = estimatedItemHeight
    tree.styles[styleIdx].gap = gap
    return true

fn WebLayoutSetMasonryModel(tree: var WebLayoutTree, nodeId: int32,
                            model: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if model != WebLayoutMasonryModelDefault && model != WebLayoutMasonryModelVirtualizedReact:
        return false
    tree.styles[styleIdx].masonryModel = model
    return true

fn WebLayoutSetTextContent(tree: var WebLayoutTree, nodeId: int32, text: str): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    tree.styles[styleIdx].textContent = text
    return true

fn WebLayoutSetFontSize(tree: var WebLayoutTree, nodeId: int32, fontSize: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if fontSize <= 0:
        return false
    tree.styles[styleIdx].fontSize = fontSize
    tree.styles[styleIdx].renderFontSize = fontSize
    tree.styles[styleIdx].fontSizeExplicit = true
    return true

fn WebLayoutSetTextAlign(tree: var WebLayoutTree, nodeId: int32, textAlign: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if textAlign != WebLayoutTextAlignLeft && textAlign != WebLayoutTextAlignCenter && textAlign != WebLayoutTextAlignRight:
        return false
    tree.styles[styleIdx].textAlign = textAlign
    tree.styles[styleIdx].textAlignExplicit = true
    return true

fn WebLayoutNormalizeFontWeight(weight: int32): int32 =
    if weight <= 0:
        return 400
    if weight > 1000:
        return 1000
    return weight

fn WebLayoutNormalizeFontFamily(family: int32): int32 =
    if family == WebLayoutFontFamilyMono:
        return WebLayoutFontFamilyMono
    if family == WebLayoutFontFamilyIcon:
        return WebLayoutFontFamilyIcon
    return WebLayoutFontFamilySans

fn WebLayoutAbsInt32(value: int32): int32 =
    if value < 0:
        return 0 - value
    return value

fn WebLayoutFontCascadeShouldReplaceWeight(bestScore: int32,
                                           bestWeight: int32,
                                           candidateScore: int32,
                                           candidateWeight: int32,
                                           requestedWeight: int32): bool =
    if candidateScore < bestScore:
        return true
    if candidateScore > bestScore:
        return false
    if requestedWeight >= 600:
        return candidateWeight > bestWeight
    return candidateWeight < bestWeight

fn WebLayoutClearFontCascade() =
    __webLayoutFontFaceCount = 0
    __webLayoutFontFamily0 = WebLayoutFontFamilySans
    __webLayoutFontFamily1 = WebLayoutFontFamilySans
    __webLayoutFontFamily2 = WebLayoutFontFamilySans
    __webLayoutFontFamily3 = WebLayoutFontFamilySans
    __webLayoutFontFamily4 = WebLayoutFontFamilySans
    __webLayoutFontFamily5 = WebLayoutFontFamilySans
    __webLayoutFontFamily6 = WebLayoutFontFamilySans
    __webLayoutFontFamily7 = WebLayoutFontFamilySans
    font.WebFontFree(__webLayoutFontFace0)
    font.WebFontFree(__webLayoutFontFace1)
    font.WebFontFree(__webLayoutFontFace2)
    font.WebFontFree(__webLayoutFontFace3)
    font.WebFontFree(__webLayoutFontFace4)
    font.WebFontFree(__webLayoutFontFace5)
    font.WebFontFree(__webLayoutFontFace6)
    font.WebFontFree(__webLayoutFontFace7)

fn WebLayoutCopyFontTable(src: font.WebFontTable, dst: var font.WebFontTable) =
    dst.offset = src.offset
    dst.length = src.length

@borrows
fn WebLayoutCopyFontFace(src: font.WebFontFace, dst: var font.WebFontFace): bool =
    font.WebFontInitEmpty(dst)
    if !src.loaded || src.unitsPerEm <= 0:
        return false
    for i in 0..<src.data.len:
        add(dst.data, src.data[i])
    dst.loaded = src.loaded
    dst.cffDetected = src.cffDetected
    dst.fingerprint = src.fingerprint
    dst.unitsPerEm = src.unitsPerEm
    dst.numGlyphs = src.numGlyphs
    dst.indexToLocFormat = src.indexToLocFormat
    dst.ascender = src.ascender
    dst.descender = src.descender
    dst.lineGap = src.lineGap
    dst.numberOfHMetrics = src.numberOfHMetrics
    WebLayoutCopyFontTable(src.cmap, dst.cmap)
    WebLayoutCopyFontTable(src.glyf, dst.glyf)
    WebLayoutCopyFontTable(src.head, dst.head)
    WebLayoutCopyFontTable(src.hhea, dst.hhea)
    WebLayoutCopyFontTable(src.hmtx, dst.hmtx)
    WebLayoutCopyFontTable(src.loca, dst.loca)
    WebLayoutCopyFontTable(src.maxp, dst.maxp)
    return true

fn WebLayoutSetFontCascade4Weighted(face0: var font.WebFontFace,
                                    face1: var font.WebFontFace,
                                    face2: var font.WebFontFace,
                                    face3: var font.WebFontFace,
                                    faceCount: int32,
                                    weight0: int32,
                                    weight1: int32,
                                    weight2: int32,
                                    weight3: int32): bool =
    return WebLayoutSetFontCascade4WeightedFamily(face0, face1, face2, face3, faceCount,
        weight0, weight1, weight2, weight3,
        WebLayoutFontFamilySans, WebLayoutFontFamilySans, WebLayoutFontFamilySans, WebLayoutFontFamilySans)

fn WebLayoutSetFontCascade4WeightedFamily(face0: var font.WebFontFace,
                                          face1: var font.WebFontFace,
                                          face2: var font.WebFontFace,
                                          face3: var font.WebFontFace,
                                          faceCount: int32,
                                          weight0: int32,
                                          weight1: int32,
                                          weight2: int32,
                                          weight3: int32,
                                          family0: int32,
                                          family1: int32,
                                          family2: int32,
                                          family3: int32): bool =
    var empty4: font.WebFontFace
    var empty5: font.WebFontFace
    var empty6: font.WebFontFace
    var empty7: font.WebFontFace
    return WebLayoutSetFontCascade8WeightedFamily(face0, face1, face2, face3, empty4, empty5, empty6, empty7, faceCount,
        weight0, weight1, weight2, weight3, 400, 400, 400, 400,
        family0, family1, family2, family3,
