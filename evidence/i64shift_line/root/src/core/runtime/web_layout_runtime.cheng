fn WebLayoutSetFontCascade8WeightedFamily(face0: var font.WebFontFace,
                                          face1: var font.WebFontFace,
                                          face2: var font.WebFontFace,
                                          face3: var font.WebFontFace,
                                          face4: var font.WebFontFace,
                                          face5: var font.WebFontFace,
                                          face6: var font.WebFontFace,
                                          face7: var font.WebFontFace,
                                          faceCount: int32,
                                          weight0: int32,
                                          weight1: int32,
                                          weight2: int32,
                                          weight3: int32,
                                          weight4: int32,
                                          weight5: int32,
                                          weight6: int32,
                                          weight7: int32,
                                          family0: int32,
                                          family1: int32,
                                          family2: int32,
                                          family3: int32,
                                          family4: int32,
                                          family5: int32,
                                          family6: int32,
                                          family7: int32): bool =
    if faceCount < 0 || faceCount > 8:
        return false
    if faceCount >= 1 && (!face0.loaded || face0.unitsPerEm <= 0):
        return false
    if faceCount >= 2 && (!face1.loaded || face1.unitsPerEm <= 0):
        return false
    if faceCount >= 3 && (!face2.loaded || face2.unitsPerEm <= 0):
        return false
    if faceCount >= 4 && (!face3.loaded || face3.unitsPerEm <= 0):
        return false
    if faceCount >= 5 && (!face4.loaded || face4.unitsPerEm <= 0):
        return false
    if faceCount >= 6 && (!face5.loaded || face5.unitsPerEm <= 0):
        return false
    if faceCount >= 7 && (!face6.loaded || face6.unitsPerEm <= 0):
        return false
    if faceCount >= 8 && (!face7.loaded || face7.unitsPerEm <= 0):
        return false
    WebLayoutClearFontCascade()
    if faceCount >= 1 && !WebLayoutCopyFontFace(face0, __webLayoutFontFace0):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 2 && !WebLayoutCopyFontFace(face1, __webLayoutFontFace1):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 3 && !WebLayoutCopyFontFace(face2, __webLayoutFontFace2):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 4 && !WebLayoutCopyFontFace(face3, __webLayoutFontFace3):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 5 && !WebLayoutCopyFontFace(face4, __webLayoutFontFace4):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 6 && !WebLayoutCopyFontFace(face5, __webLayoutFontFace5):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 7 && !WebLayoutCopyFontFace(face6, __webLayoutFontFace6):
        WebLayoutClearFontCascade()
        return false
    if faceCount >= 8 && !WebLayoutCopyFontFace(face7, __webLayoutFontFace7):
        WebLayoutClearFontCascade()
        return false
    __webLayoutFontFaceCount = faceCount
    __webLayoutFontWeight0 = WebLayoutNormalizeFontWeight(weight0)
    __webLayoutFontWeight1 = WebLayoutNormalizeFontWeight(weight1)
    __webLayoutFontWeight2 = WebLayoutNormalizeFontWeight(weight2)
    __webLayoutFontWeight3 = WebLayoutNormalizeFontWeight(weight3)
    __webLayoutFontWeight4 = WebLayoutNormalizeFontWeight(weight4)
    __webLayoutFontWeight5 = WebLayoutNormalizeFontWeight(weight5)
    __webLayoutFontWeight6 = WebLayoutNormalizeFontWeight(weight6)
    __webLayoutFontWeight7 = WebLayoutNormalizeFontWeight(weight7)
    __webLayoutFontFamily0 = WebLayoutNormalizeFontFamily(family0)
    __webLayoutFontFamily1 = WebLayoutNormalizeFontFamily(family1)
    __webLayoutFontFamily2 = WebLayoutNormalizeFontFamily(family2)
    __webLayoutFontFamily3 = WebLayoutNormalizeFontFamily(family3)
    __webLayoutFontFamily4 = WebLayoutNormalizeFontFamily(family4)
    __webLayoutFontFamily5 = WebLayoutNormalizeFontFamily(family5)
    __webLayoutFontFamily6 = WebLayoutNormalizeFontFamily(family6)
    __webLayoutFontFamily7 = WebLayoutNormalizeFontFamily(family7)
    return true

fn WebLayoutFontCascadeSelectWeighted(codepoint: int32,
                                      requestedWeight: int32,
                                      outFaceIndex: var int32,
                                      outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if codepoint < 0 || __webLayoutFontFaceCount <= 0:
        return false
    let targetWeight = WebLayoutNormalizeFontWeight(requestedWeight)
    var bestScore = 2147483647
    var bestWeight = 400
    var bestFaceIndex = -1
    var bestGlyphIndex = 0
