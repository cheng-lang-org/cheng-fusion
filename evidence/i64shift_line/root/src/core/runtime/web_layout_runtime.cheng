            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore1, __webLayoutFontWeight1, targetWeight):
                bestScore = candidateScore1
                bestWeight = __webLayoutFontWeight1
                bestFaceIndex = 1
                bestGlyphIndex = glyph1
    if __webLayoutFontFaceCount >= 3 && __webLayoutFontFamily2 == targetFamily:
        let glyph2 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace2, codepoint)
        if glyph2 > 0:
            let candidateScore2 = WebLayoutAbsInt32(__webLayoutFontWeight2 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore2, __webLayoutFontWeight2, targetWeight):
                bestScore = candidateScore2
                bestWeight = __webLayoutFontWeight2
                bestFaceIndex = 2
                bestGlyphIndex = glyph2
    if __webLayoutFontFaceCount >= 4 && __webLayoutFontFamily3 == targetFamily:
        let glyph3 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace3, codepoint)
        if glyph3 > 0:
            let candidateScore3 = WebLayoutAbsInt32(__webLayoutFontWeight3 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore3, __webLayoutFontWeight3, targetWeight):
                bestScore = candidateScore3
                bestWeight = __webLayoutFontWeight3
                bestFaceIndex = 3
                bestGlyphIndex = glyph3
    if __webLayoutFontFaceCount >= 5 && __webLayoutFontFamily4 == targetFamily:
        let glyph4 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace4, codepoint)
        if glyph4 > 0:
            let candidateScore4 = WebLayoutAbsInt32(__webLayoutFontWeight4 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore4, __webLayoutFontWeight4, targetWeight):
                bestScore = candidateScore4
                bestWeight = __webLayoutFontWeight4
                bestFaceIndex = 4
                bestGlyphIndex = glyph4
    if __webLayoutFontFaceCount >= 6 && __webLayoutFontFamily5 == targetFamily:
        let glyph5 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace5, codepoint)
        if glyph5 > 0:
            let candidateScore5 = WebLayoutAbsInt32(__webLayoutFontWeight5 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore5, __webLayoutFontWeight5, targetWeight):
                bestScore = candidateScore5
                bestWeight = __webLayoutFontWeight5
                bestFaceIndex = 5
                bestGlyphIndex = glyph5
    if __webLayoutFontFaceCount >= 7 && __webLayoutFontFamily6 == targetFamily:
        let glyph6 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace6, codepoint)
        if glyph6 > 0:
            let candidateScore6 = WebLayoutAbsInt32(__webLayoutFontWeight6 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore6, __webLayoutFontWeight6, targetWeight):
                bestScore = candidateScore6
                bestWeight = __webLayoutFontWeight6
                bestFaceIndex = 6
                bestGlyphIndex = glyph6
    if __webLayoutFontFaceCount >= 8 && __webLayoutFontFamily7 == targetFamily:
        let glyph7 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace7, codepoint)
        if glyph7 > 0:
            let candidateScore7 = WebLayoutAbsInt32(__webLayoutFontWeight7 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore7, __webLayoutFontWeight7, targetWeight):
                bestScore = candidateScore7
                bestWeight = __webLayoutFontWeight7
                bestFaceIndex = 7
                bestGlyphIndex = glyph7
    if bestFaceIndex >= 0:
        outFaceIndex = bestFaceIndex
