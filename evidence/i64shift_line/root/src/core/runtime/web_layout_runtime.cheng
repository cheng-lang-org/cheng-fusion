fn WebLayoutSetRootViewport(tree: var WebLayoutTree, rootNodeId: int32,
                             viewportWidth: int32, viewportHeight: int32): bool =
    if rootNodeId == 0:
        return false
    tree.viewportWidth = viewportWidth
    tree.viewportHeight = viewportHeight
    let styleIdx = WebLayoutFindStyleIndex(tree, rootNodeId)
    if styleIdx >= 0:
        if tree.styles[styleIdx].width == 0:
            tree.styles[styleIdx].width = viewportWidth
        elif tree.styles[styleIdx].width < 0:
            tree.styles[styleIdx].width = WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].width, viewportWidth)
        if tree.styles[styleIdx].height == 0:
            tree.styles[styleIdx].height = viewportHeight
        elif tree.styles[styleIdx].height < 0:
            tree.styles[styleIdx].height = WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].height, viewportHeight)
    for i in 0..<tree.styles.len:
        if tree.styles[i].minWidth < 0:
            tree.styles[i].minWidth = WebLayoutResolvePercentSize(0 - tree.styles[i].minWidth, viewportWidth)
        if tree.styles[i].maxWidth < 0:
            tree.styles[i].maxWidth = WebLayoutResolvePercentSize(0 - tree.styles[i].maxWidth, viewportWidth)
        if tree.styles[i].minHeight < 0:
            tree.styles[i].minHeight = WebLayoutResolvePercentSize(0 - tree.styles[i].minHeight, viewportHeight)
        if tree.styles[i].maxHeight < 0:
            tree.styles[i].maxHeight = WebLayoutResolvePercentSize(0 - tree.styles[i].maxHeight, viewportHeight)
    return true


fn WebLayoutLayoutSubtree(tree: var WebLayoutTree, nodeId: int32,
                          parentX: int32, parentY: int32,
                          parentWidth: int32): bool =
    if nodeId == 0:
        return false
    if WebLayoutVisitedNode(tree, nodeId):
        return true
    WebLayoutMarkVisitedNode(tree, nodeId)
    let styleIndex = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIndex < 0:
        return WebLayoutLayoutTransparentNode(tree, nodeId, parentX, parentY, parentWidth)
    if styleIndex >= tree.styles.len:
        return false
    WebLayoutFixDisplay(tree, nodeId)
    let display = tree.styles[styleIndex].display
    if display == WebLayoutDisplayNone:
        return true
    if tree.styles[styleIndex].inlineLevel || display == WebLayoutDisplayInline:
        return WebLayoutLayoutInlineNode(tree, nodeId, styleIndex, parentX, parentY, parentWidth)
    if display == WebLayoutDisplayBlock:
        return WebLayoutLayoutBlockNode(tree, nodeId, styleIndex, parentX, parentY, parentWidth)
    if display == WebLayoutDisplayTable:
        return WebLayoutLayoutTableNode(tree, nodeId, styleIndex, parentX, parentY, parentWidth)
    if display == WebLayoutDisplayGrid:
        return WebLayoutLayoutGridNode(tree, nodeId, styleIndex, parentX, parentY, parentWidth)
    if display == WebLayoutDisplayMasonry:
        return WebLayoutLayoutMasonryNode(tree, nodeId, styleIndex, parentX, parentY, parentWidth)
    if display == WebLayoutDisplayFlex:
        return WebLayoutLayoutFlexNode(tree, nodeId, styleIndex, parentX, parentY, parentWidth)
    return false

fn WebLayoutBlockLayoutOneBlockChild(tree: var WebLayoutTree,
                                     parentNodeId: int32,
                                     childNodeId: int32,
                                     childStyleIndex: int32,
                                     contentX: int32,
                                     contentWidth: int32,
                                     blockY: var int32,
                                     prevMarginBottom: var int32,
                                     laidOutBlockChildren: var int32): bool =
    var childX = contentX
    let childMarginTop = tree.styles[childStyleIndex].marginTop
    let childMarginBottom = tree.styles[childStyleIndex].marginBottom
    let childTextWidth = WebLayoutResolvedWidth(tree, childStyleIndex, contentWidth)
    if tree.styles[childStyleIndex].textContent != "" && childTextWidth > 0 && contentWidth > childTextWidth:
        if tree.styles[childStyleIndex].textAlign == WebLayoutTextAlignCenter:
            childX = contentX + (contentWidth - childTextWidth) / 2
        elif tree.styles[childStyleIndex].textAlign == WebLayoutTextAlignRight:
            childX = contentX + contentWidth - childTextWidth
    var collapseAdjust: int32
    if prevMarginBottom > 0 && childMarginTop > 0:
        if prevMarginBottom < childMarginTop:
            collapseAdjust = prevMarginBottom
        else:
            collapseAdjust = childMarginTop
    var layoutY = blockY > collapseAdjust ? blockY - collapseAdjust : blockY
    let beforeChildBoxCount = tree.boxes.len
    let blockChildLayoutOk = WebLayoutLayoutSubtree(tree, childNodeId, childX, layoutY, contentWidth)
    if !blockChildLayoutOk:
        return false
    var childFlowHeight = tree.styles[childStyleIndex].height
    var nextBlockY = blockY + childMarginTop + childFlowHeight + childMarginBottom
    let actualChildBoxIdx = WebLayoutFindBoxIndexForNodeFrom(tree, childNodeId, beforeChildBoxCount)
    if actualChildBoxIdx >= 0 && actualChildBoxIdx < tree.boxes.len:
        childFlowHeight = tree.boxes[actualChildBoxIdx].height
        nextBlockY = tree.boxes[actualChildBoxIdx].y + childFlowHeight + childMarginBottom
    blockY = nextBlockY
    prevMarginBottom = childMarginBottom
    laidOutBlockChildren = laidOutBlockChildren + 1
    return true

fn WebLayoutInlineFlowAllChildrenAreBlocks(tree: var WebLayoutTree, nodeId: int32): bool =
    let n2 = WebLayoutChildCount(tree, nodeId)
    if n2 == 0:
        return false
    var sawVisible = false
    for o2 in 0..<n2:
        let c2 = WebLayoutChildAt(tree, nodeId, o2)
        if c2 == 0:
            return false
        let si2 = WebLayoutFindStyleIndex(tree, c2)
        if si2 < 0 || si2 >= tree.styles.len:
            return false
        if tree.styles[si2].display == WebLayoutDisplayNone:
            continue
        if WebLayoutStyleIsInlineFlow(tree, si2):
            return false
        sawVisible = true
    return sawVisible

fn WebLayoutBlockLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                startX: int32, startY: int32, parentWidth: int32,
                                outContentHeight: var int32): bool =
    # Normalize child display before measuring block children.
    let bc = WebLayoutChildCount(tree, parentNodeId)
    for bi in 0..<bc:
        let bid = WebLayoutChildAt(tree, parentNodeId, bi)
        if bid != 0:
            WebLayoutFixDisplay(tree, bid)
    # Account for parent padding: children are positioned within the content area
    let parentStyleIdx = WebLayoutFindStyleIndex(tree, parentNodeId)
    var parentPaddingLeft: int32
    var parentPaddingTop: int32
    var parentPaddingRight: int32
    var parentPaddingBottom: int32
    var parentBorderLeft: int32
    var parentBorderTop: int32
    var parentBorderRight: int32
    var parentBorderBottom: int32
    var parentGap: int32
    var parentTextAlign = WebLayoutTextAlignLeft
    var parentLineHeight: int32
    var parentLineHeightPx2: int32
    var parentWhiteSpaceNowrap = false
    if parentStyleIdx >= 0:
        parentPaddingLeft = tree.styles[parentStyleIdx].paddingLeft
        parentPaddingTop = tree.styles[parentStyleIdx].paddingTop
        parentPaddingRight = tree.styles[parentStyleIdx].paddingRight
        parentPaddingBottom = tree.styles[parentStyleIdx].paddingBottom
        parentBorderLeft = tree.styles[parentStyleIdx].borderLeftWidth
        parentBorderTop = tree.styles[parentStyleIdx].borderTopWidth
        parentBorderRight = tree.styles[parentStyleIdx].borderRightWidth
        parentBorderBottom = tree.styles[parentStyleIdx].borderBottomWidth
        parentGap = tree.styles[parentStyleIdx].gap
        parentTextAlign = tree.styles[parentStyleIdx].textAlign
        parentWhiteSpaceNowrap = tree.styles[parentStyleIdx].whiteSpaceNowrap
        if tree.styles[parentStyleIdx].lineHeight != 0 || tree.styles[parentStyleIdx].lineHeightPx2 > 0:
            parentLineHeight = WebLayoutEffectiveTextLineHeight(tree.styles[parentStyleIdx].fontSize, tree.styles[parentStyleIdx].lineHeight)
            parentLineHeightPx2 = WebLayoutEffectiveTextLineHeightPx2(tree.styles[parentStyleIdx].fontSize, tree.styles[parentStyleIdx].lineHeight, tree.styles[parentStyleIdx].lineHeightPx2)
    var contentX: int32
    contentX = startX + parentBorderLeft + parentPaddingLeft
    var contentY: int32
    contentY = startY + parentBorderTop + parentPaddingTop
    var contentWidth: int32
    contentWidth = parentWidth - parentBorderLeft - parentBorderRight - parentPaddingLeft - parentPaddingRight
    if contentWidth < 0:
        contentWidth = 0
    var contentHeightBasis: int32
    if parentStyleIdx >= 0:
        let parentResolvedHeight = tree.styles[parentStyleIdx].height
        if parentResolvedHeight > 0:
            contentHeightBasis = parentResolvedHeight - parentBorderTop - parentBorderBottom - parentPaddingTop - parentPaddingBottom
            if contentHeightBasis < 0:
                contentHeightBasis = 0
    var blockY: int32
    blockY = contentY
    var inlineX: int32
    inlineX = contentX
    var inlineY: int32
    inlineY = contentY
    var inlineY2: int32
    inlineY2 = contentY * 2
    var curLineHeight: int32
    var curLineHeight2: int32
    var lineBoxStart: int32 = -1
    var prevMarginBottom: int32
    var laidOutBlockChildren: int32
    let parentRight = contentX + contentWidth
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    var allFloatRow: bool = childCount > 0
    for fi in 0..<childCount:
        let fid = WebLayoutChildAt(tree, parentNodeId, fi)
        if fid == 0:
            continue
        let fst = WebLayoutFindStyleIndex(tree, fid)
        if fst < 0 || fst >= tree.styles.len:
            continue
        if tree.styles[fst].display == WebLayoutDisplayNone:
            continue
        let fpos = tree.styles[fst].position
        if fpos == WebLayoutPositionAbsolute || fpos == WebLayoutPositionFixed:
            continue
        if tree.styles[fst].floatKind != WebLayoutFloatLeft:
            allFloatRow = false
            break
    var floatX: int32
    floatX = contentX
    var floatRowMaxHeight2: int32
    floatRowMaxHeight2 = 0

    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            continue
        let childStyleIndex = WebLayoutFindStyleIndex(tree, childNodeId)
        if childStyleIndex < 0 || childStyleIndex >= tree.styles.len:
            continue

        var childDisplay = tree.styles[childStyleIndex].display
        if childDisplay == WebLayoutDisplayNone:
            continue

        var childPosition = tree.styles[childStyleIndex].position
        if childPosition == WebLayoutPositionAbsolute || childPosition == WebLayoutPositionFixed:
            continue

        if contentHeightBasis > 0 && tree.styles[childStyleIndex].height < 0:
            tree.styles[childStyleIndex].height = WebLayoutResolvedHeight(tree, childStyleIndex, contentHeightBasis)

        if allFloatRow && tree.styles[childStyleIndex].floatKind == WebLayoutFloatLeft:
            var fw = tree.styles[childStyleIndex].width
            if fw <= 0:
                fw = WebLayoutIntrinsicWidth(tree, childNodeId, contentWidth, 0)
            let fml = tree.styles[childStyleIndex].marginLeft
            let fmr = tree.styles[childStyleIndex].marginRight
            if !WebLayoutLayoutSubtree(tree, childNodeId, floatX + fml, contentY, fw):
                return false
            floatX = floatX + fml + fw + fmr
            let fbi = WebLayoutFindBoxIndexForNodeFrom(tree, childNodeId, 0)
            if fbi >= 0 && fbi < tree.boxes.len:
                if tree.boxes[fbi].height * 2 > floatRowMaxHeight2:
                    floatRowMaxHeight2 = tree.boxes[fbi].height * 2
            laidOutBlockChildren = laidOutBlockChildren + 1
            continue
        var childIsInlineFlow: bool = WebLayoutStyleIsInlineFlow(tree, childStyleIndex)
        if childIsInlineFlow:
            if WebLayoutInlineFlowAllChildrenAreBlocks(tree, childNodeId):
                tree.styles[childStyleIndex].display = WebLayoutDisplayBlock
                childIsInlineFlow = false
        if childIsInlineFlow:
            if laidOutBlockChildren > 0 && curLineHeight <= 0 && lineBoxStart < 0 && inlineY < blockY:
                inlineX = contentX
                inlineY = blockY
                inlineY2 = blockY * 2
            var childWidth = WebLayoutResolvedWidth(tree, childStyleIndex, contentWidth)
            var childHeight = WebLayoutResolvedHeight(tree, childStyleIndex, contentHeightBasis)
            if childWidth <= 0:
                childWidth = WebLayoutIntrinsicWidth(tree, childNodeId, contentWidth, 0)
            if childHeight <= 0:
                childHeight = WebLayoutAspectRatioHeightForWidth(tree, childStyleIndex, childWidth)
            if childHeight <= 0:
                childHeight = WebLayoutIntrinsicHeight(tree, childNodeId, contentWidth, 0)
            let childFontSize = tree.styles[childStyleIndex].fontSize
            let childGap = tree.styles[childStyleIndex].gap
            let childMarginLeft = tree.styles[childStyleIndex].marginLeft
            let childWhiteSpaceNowrap = parentWhiteSpaceNowrap || tree.styles[childStyleIndex].whiteSpaceNowrap
            if tree.styles[childStyleIndex].textContent != "" && !childWhiteSpaceNowrap:
                WebLayoutLayoutInlineWords(
                    tree, childNodeId,
                    tree.styles[childStyleIndex].textContent, tree.styles[childStyleIndex].fontSize,
                    tree.styles[childStyleIndex].lineHeight,
                    tree.styles[childStyleIndex].renderFontWeight,
                    childGap,
                    tree.styles[childStyleIndex].fontFamily,
                    tree.styles[childStyleIndex].wordBreakBreakAll,
                    contentX, inlineY, parentRight,
                    parentTextAlign, contentWidth,
                    parentLineHeight, parentLineHeightPx2,
                    lineBoxStart,
                    inlineX, inlineY, curLineHeight,
                    inlineY2, curLineHeight2)
            elif childWidth > 0 && childHeight > 0:
                // 原子内联盒(元素)不受 white-space:nowrap 约束: 整盒放不下必移行(仅文本词受 nowrap 抑制)
                if inlineX + childWidth > parentRight && curLineHeight > 0:
                    WebLayoutApplyInlineLineTextAlign(tree, lineBoxStart, parentTextAlign, contentX, contentWidth)
                    inlineX = contentX
                    if curLineHeight2 > 0:
                        inlineY2 = inlineY2 + curLineHeight2
                    else:
                        inlineY2 = inlineY2 + curLineHeight * 2
                    inlineY = inlineY2 / 2
                    curLineHeight = 0
                    curLineHeight2 = 0
                    lineBoxStart = -1
                if lineBoxStart < 0:
                    lineBoxStart = tree.boxes.len
                let inlineChildAvailW = contentX + contentWidth - inlineX
                let inlineChildLayoutOk = WebLayoutLayoutSubtree(tree, childNodeId,
                        inlineX, inlineY, inlineChildAvailW)
                if !inlineChildLayoutOk:
                    return false
                inlineX = inlineX + childWidth + childGap + childMarginLeft
                if parentLineHeight > curLineHeight:
                    curLineHeight = parentLineHeight
                if childHeight > curLineHeight:
                    curLineHeight = childHeight
                if parentLineHeightPx2 > curLineHeight2:
                    curLineHeight2 = parentLineHeightPx2
                if childHeight * 2 > curLineHeight2:
                    curLineHeight2 = childHeight * 2
            elif tree.styles[childStyleIndex].textContent != "":
                WebLayoutLayoutInlineWords(
                    tree, childNodeId,
                    tree.styles[childStyleIndex].textContent, tree.styles[childStyleIndex].fontSize,
                    tree.styles[childStyleIndex].lineHeight,
                    tree.styles[childStyleIndex].renderFontWeight,
                    childGap,
                    tree.styles[childStyleIndex].fontFamily,
                    tree.styles[childStyleIndex].wordBreakBreakAll,
                    contentX, inlineY, parentRight,
                    parentTextAlign, contentWidth,
                    parentLineHeight, parentLineHeightPx2,
                    lineBoxStart,
                    inlineX, inlineY, curLineHeight,
                    inlineY2, curLineHeight2)
        else:
            if curLineHeight > 0:
                WebLayoutApplyInlineLineTextAlign(tree, lineBoxStart, parentTextAlign, contentX, contentWidth)
                if curLineHeight2 > 0:
                    blockY = (inlineY2 + curLineHeight2 + 1) / 2
                else:
                    blockY = inlineY + curLineHeight
                inlineX = contentX
                inlineY = blockY
                inlineY2 = blockY * 2
                curLineHeight = 0
                curLineHeight2 = 0
                lineBoxStart = -1
            if parentGap > 0 && laidOutBlockChildren > 0:
                blockY = blockY + parentGap
            let blockChildOk = WebLayoutBlockLayoutOneBlockChild(tree, parentNodeId, childNodeId, childStyleIndex, contentX, contentWidth, blockY, prevMarginBottom, laidOutBlockChildren)
            if !blockChildOk:
                return false

    if curLineHeight > 0:
        WebLayoutApplyInlineLineTextAlign(tree, lineBoxStart, parentTextAlign, contentX, contentWidth)
        if curLineHeight2 > 0:
            blockY = (inlineY2 + curLineHeight2 + 1) / 2
        else:
            blockY = inlineY + curLineHeight
    if allFloatRow && floatRowMaxHeight2 > 0:
        blockY = contentY + (floatRowMaxHeight2 + 1) / 2
    outContentHeight = blockY - startY + parentPaddingBottom + parentBorderBottom
    return true

fn WebLayoutFlexMainBeforeMargin(tree: var WebLayoutTree, styleIdx: int32, isRow: bool): int32 =
    if isRow:
        if tree.styles[styleIdx].marginLeftAuto:
            return 0
        return tree.styles[styleIdx].marginLeft
    if tree.styles[styleIdx].marginTopAuto:
        return 0
    return tree.styles[styleIdx].marginTop

fn WebLayoutFlexMainAfterMargin(tree: var WebLayoutTree, styleIdx: int32, isRow: bool): int32 =
    if isRow:
        if tree.styles[styleIdx].marginRightAuto:
            return 0
        return tree.styles[styleIdx].marginRight
    if tree.styles[styleIdx].marginBottomAuto:
        return 0
    return tree.styles[styleIdx].marginBottom

fn WebLayoutFlexCrossBeforeMargin(tree: var WebLayoutTree, styleIdx: int32, isRow: bool): int32 =
    if isRow:
        if tree.styles[styleIdx].marginTopAuto:
            return 0
        return tree.styles[styleIdx].marginTop
    if tree.styles[styleIdx].marginLeftAuto:
        return 0
    return tree.styles[styleIdx].marginLeft

fn WebLayoutFlexCrossAfterMargin(tree: var WebLayoutTree, styleIdx: int32, isRow: bool): int32 =
    if isRow:
        if tree.styles[styleIdx].marginBottomAuto:
            return 0
        return tree.styles[styleIdx].marginBottom
    if tree.styles[styleIdx].marginRightAuto:
        return 0
    return tree.styles[styleIdx].marginRight

fn WebLayoutFlexMainBeforeMarginIsAuto(tree: var WebLayoutTree, styleIdx: int32, isRow: bool): bool =
    if isRow:
        return tree.styles[styleIdx].marginLeftAuto
    return tree.styles[styleIdx].marginTopAuto

fn WebLayoutFlexMainAfterMarginIsAuto(tree: var WebLayoutTree, styleIdx: int32, isRow: bool): bool =
    if isRow:
        return tree.styles[styleIdx].marginRightAuto
    return tree.styles[styleIdx].marginBottomAuto

fn WebLayoutFlexCountMainAutoMarginsInRange(tree: var WebLayoutTree, parentNodeId: int32,
                                            startOrdinal: int32, stopOrdinal: int32,
                                            isRow: bool): int32 =
    var result: int32
    var ordinal = startOrdinal
    while ordinal < stopOrdinal:
        if WebLayoutFlexItemEligible(tree, parentNodeId, ordinal):
            let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
            let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if csIdx >= 0:
                if WebLayoutFlexMainBeforeMarginIsAuto(tree, csIdx, isRow):
                    result = result + 1
                if WebLayoutFlexMainAfterMarginIsAuto(tree, csIdx, isRow):
                    result = result + 1
        ordinal = ordinal + 1
    return result

fn WebLayoutFlexAutoMainMarginShare(parentMain: int32, totalUsed: int32,
                                    gapTotal: int32, autoMainMarginCount: int32): int32 =
    if autoMainMarginCount <= 0:
        return 0
    let autoExtra = parentMain - totalUsed - gapTotal
    if autoExtra <= 0:
        return 0
    return autoExtra / autoMainMarginCount

fn WebLayoutFlexOuterMainSize(tree: var WebLayoutTree, styleIdx: int32,
                              mainSize: int32, isRow: bool): int32 =
    return mainSize + WebLayoutFlexMainBeforeMargin(tree, styleIdx, isRow) +
        WebLayoutFlexMainAfterMargin(tree, styleIdx, isRow)

fn WebLayoutFlexOuterCrossSize(tree: var WebLayoutTree, styleIdx: int32,
                               crossSize: int32, isRow: bool): int32 =
    return crossSize + WebLayoutFlexCrossBeforeMargin(tree, styleIdx, isRow) +
        WebLayoutFlexCrossAfterMargin(tree, styleIdx, isRow)

fn WebLayoutFlexAutoSize(tree: var WebLayoutTree, nodeId: int32,
                         flexDirection: int32, gap: int32,
                         outWidth: var int32, outHeight: var int32) =
    if outWidth > 0 && outHeight > 0:
        return
    let isRow = flexDirection == 0 || flexDirection == WebLayoutFlexDirectionRow
    var totalMain: int32
    var maxCross: int32
    var childCount: int32
    let totalChildren = WebLayoutChildCount(tree, nodeId)
    for ordinal in 0..<totalChildren:
        let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
        if childNodeId == 0:
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            continue
        # Read child style fields directly during intrinsic flex sizing.
        if tree.styles[csIdx].display == WebLayoutDisplayNone:
            WebLayoutFixDisplay(tree, childNodeId)
        if tree.styles[csIdx].display == WebLayoutDisplayNone:
            continue
        if tree.styles[csIdx].position == WebLayoutPositionAbsolute || tree.styles[csIdx].position == WebLayoutPositionFixed:
            continue
        childCount = childCount + 1
        var childW = tree.styles[csIdx].width > 0 ? tree.styles[csIdx].width : 0
        var childH = WebLayoutResolvedHeight(tree, csIdx, outHeight)
        if childW <= 0:
            childW = WebLayoutIntrinsicWidth(tree, childNodeId, outWidth, 0)
        if childH <= 0:
            childH = WebLayoutAspectRatioHeightForWidth(tree, csIdx, childW)
        if childH <= 0:
            childH = WebLayoutIntrinsicHeight(tree, childNodeId, outWidth, 0)
        if isRow:
            let childOuterMain = WebLayoutFlexOuterMainSize(tree, csIdx, childW, true)
            let childOuterCross = WebLayoutFlexOuterCrossSize(tree, csIdx, childH, true)
            totalMain = totalMain + childOuterMain
            if childOuterCross > maxCross:
                maxCross = childOuterCross
        else:
            let childOuterMain = WebLayoutFlexOuterMainSize(tree, csIdx, childH, false)
            let childOuterCross = WebLayoutFlexOuterCrossSize(tree, csIdx, childW, false)
            totalMain = totalMain + childOuterMain
            if childOuterCross > maxCross:
                maxCross = childOuterCross
    if childCount > 1:
        totalMain = totalMain + gap * (childCount - 1)
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    var padX: int32
    var padY: int32
    if styleIdx >= 0:
        padX = tree.styles[styleIdx].borderLeftWidth + tree.styles[styleIdx].borderRightWidth + tree.styles[styleIdx].paddingLeft + tree.styles[styleIdx].paddingRight
        padY = tree.styles[styleIdx].borderTopWidth + tree.styles[styleIdx].borderBottomWidth + tree.styles[styleIdx].paddingTop + tree.styles[styleIdx].paddingBottom
    if outWidth == 0:
        outWidth = (isRow ? totalMain : maxCross) + padX
    if outHeight == 0:
        outHeight = (isRow ? maxCross : totalMain) + padY

fn WebLayoutFlexWrapAutoSize(tree: var WebLayoutTree, nodeId: int32,
                             styleIdx: int32,
                             outWidth: var int32, outHeight: var int32) =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return
    if outWidth > 0 && outHeight > 0:
        return
    let isRow = tree.styles[styleIdx].flexDirection == 0 || tree.styles[styleIdx].flexDirection == WebLayoutFlexDirectionRow
    let parentMain = isRow ? outWidth : outHeight
    if parentMain <= 0:
        return
    let gap = tree.styles[styleIdx].gap
    var lineMain: int32
    var lineCross: int32
    var lineItemCount: int32
    var totalCross: int32
    var committedLineCount: int32
    let totalChildren = WebLayoutChildCount(tree, nodeId)
    for ordinal in 0..<totalChildren:
        let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
        if childNodeId == 0:
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            continue
        if tree.styles[csIdx].display == WebLayoutDisplayNone:
            WebLayoutFixDisplay(tree, childNodeId)
        if tree.styles[csIdx].display == WebLayoutDisplayNone:
            continue
        if tree.styles[csIdx].position == WebLayoutPositionAbsolute || tree.styles[csIdx].position == WebLayoutPositionFixed:
            continue
        var childW = WebLayoutResolvedWidth(tree, csIdx, outWidth)
        var childH = WebLayoutResolvedHeight(tree, csIdx, outHeight)
        if childW <= 0 && tree.styles[csIdx].textContent.len > 0:
            childW = WebLayoutEstimateTextWidthWeightedFamily(tree.styles[csIdx].textContent, tree.styles[csIdx].fontSize, tree.styles[csIdx].renderFontWeight, tree.styles[csIdx].fontFamily)
        if childW <= 0:
            childW = WebLayoutIntrinsicWidth(tree, childNodeId, outWidth, 0)
        if childH <= 0:
            childH = WebLayoutAspectRatioHeightForWidth(tree, csIdx, childW)
        if childH <= 0 && tree.styles[csIdx].textContent.len > 0:
            childH = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[csIdx].textContent, tree.styles[csIdx].fontSize, tree.styles[csIdx].lineHeight, tree.styles[csIdx].lineHeightPx2, tree.styles[csIdx].renderFontWeight, tree.styles[csIdx].fontFamily)
        if childH <= 0:
            childH = WebLayoutIntrinsicHeight(tree, childNodeId, outWidth, 0)
        if childW < 0:
            childW = 0
        if childH < 0:
            childH = 0
        let outerMain = isRow ? WebLayoutFlexOuterMainSize(tree, csIdx, childW, true) : WebLayoutFlexOuterMainSize(tree, csIdx, childH, false)
        let outerCross = isRow ? WebLayoutFlexOuterCrossSize(tree, csIdx, childH, true) : WebLayoutFlexOuterCrossSize(tree, csIdx, childW, false)
        var nextMain = lineMain + outerMain
        if lineItemCount > 0:
            nextMain = nextMain + gap
        if lineItemCount > 0 && nextMain > parentMain:
            if committedLineCount > 0:
                totalCross = totalCross + gap
            totalCross = totalCross + lineCross
            committedLineCount = committedLineCount + 1
            lineMain = outerMain
            lineCross = outerCross
            lineItemCount = 1
        else:
            lineMain = nextMain
            if outerCross > lineCross:
                lineCross = outerCross
            lineItemCount = lineItemCount + 1
    if lineItemCount > 0:
        if committedLineCount > 0:
            totalCross = totalCross + gap
        totalCross = totalCross + lineCross
    if totalCross <= 0:
        return
    let padX = tree.styles[styleIdx].borderLeftWidth + tree.styles[styleIdx].borderRightWidth + tree.styles[styleIdx].paddingLeft + tree.styles[styleIdx].paddingRight
    let padY = tree.styles[styleIdx].borderTopWidth + tree.styles[styleIdx].borderBottomWidth + tree.styles[styleIdx].paddingTop + tree.styles[styleIdx].paddingBottom
    if isRow:
        if outHeight == 0:
            outHeight = totalCross + padY
    else:
        if outWidth == 0:
            outWidth = totalCross + padX

fn WebLayoutFlexSpaceBetweenSlots(itemCount: int32): int32 =
    if itemCount <= 1:
        return 1
    return itemCount - 1

fn WebLayoutFlexItemEligible(tree: var WebLayoutTree, parentNodeId: int32, ordinal: int32): bool =
    let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
    if childNodeId == 0:
        return false
    let styleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
    if styleIdx < 0:
        return false
    if tree.styles[styleIdx].display == WebLayoutDisplayNone:
        return false
    if tree.styles[styleIdx].position == WebLayoutPositionAbsolute || tree.styles[styleIdx].position == WebLayoutPositionFixed:
        return false
    return true

fn WebLayoutFlexNthSourceOrdinal(tree: var WebLayoutTree, parentNodeId: int32,
                                 childCount: int32, slot: int32): int32 =
    var seen: int32
    var ordinal: int32
    while ordinal < childCount:
        if WebLayoutFlexItemEligible(tree, parentNodeId, ordinal):
            if seen == slot:
                return ordinal
            seen = seen + 1
        ordinal = ordinal + 1
    return -1

fn WebLayoutFlexNthOrderedOrdinal(tree: var WebLayoutTree, parentNodeId: int32,
                                  childCount: int32, slot: int32): int32 =
    var bestOrdinal: int32 = -1
    var scanOrd: int32
    while scanOrd < childCount:
        if WebLayoutFlexItemEligible(tree, parentNodeId, scanOrd):
            let childNodeId = WebLayoutChildAt(tree, parentNodeId, scanOrd)
            let styleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            var rank: int32
            var innerOrd: int32
            while innerOrd < childCount:
                if WebLayoutFlexItemEligible(tree, parentNodeId, innerOrd):
                    let innerNodeId = WebLayoutChildAt(tree, parentNodeId, innerOrd)
                    let innerIdx = WebLayoutFindStyleIndex(tree, innerNodeId)
                    if innerIdx >= 0 && styleIdx >= 0:
                        if tree.styles[innerIdx].order < tree.styles[styleIdx].order || (tree.styles[innerIdx].order == tree.styles[styleIdx].order && innerOrd < scanOrd):
                            rank = rank + 1
                innerOrd = innerOrd + 1
            if rank == slot && bestOrdinal < 0:
                bestOrdinal = scanOrd
        scanOrd = scanOrd + 1
    return bestOrdinal

fn WebLayoutFlexGrowBase(flexGrow: int32, remaining: int32, totalFlex: int32): int32 =
    if flexGrow <= 0:
        return 0
    if remaining <= 0:
        return 0
    var flexDiv = totalFlex
    if flexDiv <= 0:
        flexDiv = 1
    return remaining * flexGrow / flexDiv

fn WebLayoutFlexBaseMainSize(tree: var WebLayoutTree, childNodeId: int32,
                             styleIdx: int32, isRow: bool,
                             parentWidth: int32, parentHeight: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return 0
    if tree.styles[styleIdx].flex > 0:
        return 0
    if isRow:
        var baseW = WebLayoutResolvedWidth(tree, styleIdx, parentWidth)
        if baseW <= 0:
            baseW = WebLayoutIntrinsicWidth(tree, childNodeId, parentWidth, 0)
        if baseW < 0:
            baseW = 0
        return baseW
    var baseH = WebLayoutResolvedHeight(tree, styleIdx, parentHeight)
    if baseH <= 0:
        baseH = WebLayoutIntrinsicHeight(tree, childNodeId, parentWidth, 0)
    if baseH < 0:
        baseH = 0
    return baseH

fn WebLayoutFlexShrinkBase(baseMain: int32, flexShrink: int32,
                           deficit: int32, totalShrinkWeight: int64): int32 =
    if baseMain <= 0 || flexShrink <= 0 || deficit <= 0 || totalShrinkWeight <= int64(0):
        return 0
    let amount64 = int64(deficit) * int64(baseMain) * int64(flexShrink) / totalShrinkWeight
    if amount64 <= int64(0):
        return 0
    if amount64 >= int64(baseMain):
        return baseMain
    return int32(amount64)

fn WebLayoutFlexEffectiveAlignItems(tree: var WebLayoutTree,
                                    styleIdx: int32,
                                    parentAlignItems: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return parentAlignItems
    let alignSelf = tree.styles[styleIdx].alignSelf
    if alignSelf == WebLayoutAlignSelfAuto:
        return parentAlignItems
    if alignSelf == WebLayoutAlignSelfFlexStart:
        return WebLayoutAlignItemsFlexStart
    if alignSelf == WebLayoutAlignSelfFlexEnd:
        return WebLayoutAlignItemsFlexEnd
    if alignSelf == WebLayoutAlignSelfCenter:
        return WebLayoutAlignItemsCenter
    if alignSelf == WebLayoutAlignSelfStretch:
        return WebLayoutAlignItemsStretch
    if alignSelf == WebLayoutAlignSelfBaseline:
        return -1
    return parentAlignItems

fn WebLayoutFlexBaseCrossSize(tree: var WebLayoutTree, childNodeId: int32,
                              styleIdx: int32, isRow: bool,
                              parentWidth: int32, parentHeight: int32): int32 =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return 0
    if isRow:
        var baseH = WebLayoutResolvedHeight(tree, styleIdx, parentHeight)
        if baseH <= 0:
            let baseW = WebLayoutResolvedWidth(tree, styleIdx, parentWidth)
            baseH = WebLayoutAspectRatioHeightForWidth(tree, styleIdx, baseW)
        if baseH <= 0:
            baseH = WebLayoutIntrinsicHeight(tree, childNodeId, parentWidth, 0)
        if baseH < 0:
            baseH = 0
        return baseH
    var baseW = WebLayoutResolvedWidth(tree, styleIdx, parentWidth)
    if baseW <= 0:
        baseW = WebLayoutIntrinsicWidth(tree, childNodeId, parentWidth, 0)
    if baseW < 0:
        baseW = 0
    return baseW

fn WebLayoutFlexClampMainSize(tree: var WebLayoutTree,
                              styleIdx: int32,
                              isRow: bool,
                              mainSize: int32): int32 =
    var result = mainSize
    if result < 0:
        result = 0
    if isRow:
        if tree.styles[styleIdx].minWidth > 0 && result < tree.styles[styleIdx].minWidth:
            result = tree.styles[styleIdx].minWidth
        if tree.styles[styleIdx].maxWidth > 0 && result > tree.styles[styleIdx].maxWidth:
            result = tree.styles[styleIdx].maxWidth
    else:
        if tree.styles[styleIdx].minHeight > 0 && result < tree.styles[styleIdx].minHeight:
            result = tree.styles[styleIdx].minHeight
        if tree.styles[styleIdx].maxHeight > 0 && result > tree.styles[styleIdx].maxHeight:
            result = tree.styles[styleIdx].maxHeight
    return result

fn WebLayoutFlexClampCrossSize(tree: var WebLayoutTree,
                               styleIdx: int32,
                               isRow: bool,
                               crossSize: int32): int32 =
    var result = crossSize
    if result < 0:
        result = 0
    if isRow:
        if tree.styles[styleIdx].minHeight > 0 && result < tree.styles[styleIdx].minHeight:
            result = tree.styles[styleIdx].minHeight
        if tree.styles[styleIdx].maxHeight > 0 && result > tree.styles[styleIdx].maxHeight:
            result = tree.styles[styleIdx].maxHeight
    else:
        if tree.styles[styleIdx].minWidth > 0 && result < tree.styles[styleIdx].minWidth:
            result = tree.styles[styleIdx].minWidth
        if tree.styles[styleIdx].maxWidth > 0 && result > tree.styles[styleIdx].maxWidth:
            result = tree.styles[styleIdx].maxWidth
    return result

fn WebLayoutGridTrackSpace(total: int32, trackCount: int32, gap: int32): int32 =
    var result = total
    if trackCount > 1:
        let gapTotal = gap * (trackCount - 1)
        if gapTotal < result:
            result = result - gapTotal
        else:
            result = 0
    return result

fn WebLayoutGridRoundedShare(total: int32, beforeNumerator: int32,
                             afterNumerator: int32, denominator: int32): int32 =
    if total <= 0 || denominator <= 0 || afterNumerator <= beforeNumerator:
        return 0
    let start = int64(total) * int64(beforeNumerator) / int64(denominator)
    let stop = int64(total) * int64(afterNumerator) / int64(denominator)
    let result64 = stop - start
    if result64 <= int64(0):
        return 0
    return int32(result64)

fn WebLayoutFlexLayoutWrappedChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                      parentX: int32, parentY: int32,
                                      parentWidth: int32, parentHeight: int32,
                                      flexDir: int32, flexWrap: int32,
                                      justifyContent: int32,
                                      alignItems: int32,
                                      alignContent: int32,
                                      gap: int32): bool =
    if flexWrap != 1:
        return false
    let isRow = flexDir == 0 || flexDir == WebLayoutFlexDirectionRow
    if !isRow:
        return false
    if alignContent != WebLayoutAlignContentFlexStart:
        return false
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    if childCount == 0:
        return true
    for fi in 0..<childCount:
        let fid = WebLayoutChildAt(tree, parentNodeId, fi)
        if fid != 0:
            WebLayoutFixDisplay(tree, fid)
            let fsi = WebLayoutFindStyleIndex(tree, fid)
            if fsi >= 0:
                if tree.styles[fsi].order != 0:
                    return false
    var lineStart: int32
    var crossOffset: int32
    while lineStart < childCount:
        var scan = lineStart
        var lineStop = lineStart
        var lineItemCount: int32
        var lineMain: int32
        var lineCross: int32
        var lineTotalFlex: int32
        var lineFixedMain: int32
        var lineBaseMainTotal: int32
        var lineTotalShrinkWeight: int64 = int64(0)
        while scan < childCount:
            if WebLayoutFlexItemEligible(tree, parentNodeId, scan):
                let childNodeId = WebLayoutChildAt(tree, parentNodeId, scan)
                let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if csIdx < 0:
                    return false
                let baseMain = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, true, parentWidth, parentHeight)
                var baseCross = WebLayoutResolvedHeight(tree, csIdx, parentHeight)
                if baseCross <= 0:
                    baseCross = WebLayoutAspectRatioHeightForWidth(tree, csIdx, baseMain)
                if baseCross <= 0:
                    baseCross = WebLayoutIntrinsicHeight(tree, childNodeId, parentWidth, 0)
                if baseCross < 0:
                    baseCross = 0
                let outerMain = WebLayoutFlexOuterMainSize(tree, csIdx, baseMain, true)
                let outerCross = WebLayoutFlexOuterCrossSize(tree, csIdx, baseCross, true)
                var nextMain = lineMain + outerMain
                if lineItemCount > 0:
                    nextMain = nextMain + gap
                if lineItemCount > 0 && parentWidth > 0 && nextMain > parentWidth:
                    break
                lineMain = nextMain
                if outerCross > lineCross:
                    lineCross = outerCross
                lineItemCount = lineItemCount + 1
                lineStop = scan + 1
                lineTotalFlex = lineTotalFlex + tree.styles[csIdx].flex
                lineBaseMainTotal = lineBaseMainTotal + outerMain
                if tree.styles[csIdx].flexShrink > 0 && baseMain > 0:
                    lineTotalShrinkWeight = lineTotalShrinkWeight + int64(tree.styles[csIdx].flexShrink) * int64(baseMain)
                if tree.styles[csIdx].flex == 0:
                    lineFixedMain = lineFixedMain + outerMain
            scan = scan + 1
        if lineItemCount == 0:
            lineStart = lineStart + 1
            continue
        var lineGapTotal: int32
        if lineItemCount > 1:
            lineGapTotal = gap * (lineItemCount - 1)
        var remaining = parentWidth - lineFixedMain - lineGapTotal
        if remaining < 0:
            remaining = 0
        var shrinkDeficit: int32
        let shrinkDeficitRaw = lineBaseMainTotal + lineGapTotal - parentWidth
        if shrinkDeficitRaw > 0:
            shrinkDeficit = shrinkDeficitRaw
            remaining = 0
        var totalUsed: int32
        var layoutOrdinal = lineStart
        while layoutOrdinal < lineStop:
            if WebLayoutFlexItemEligible(tree, parentNodeId, layoutOrdinal):
                let childNodeId = WebLayoutChildAt(tree, parentNodeId, layoutOrdinal)
                let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if csIdx < 0:
                    return false
                var mainSize = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, true, parentWidth, parentHeight)
                if shrinkDeficit > 0:
                    let shrinkAmount = WebLayoutFlexShrinkBase(mainSize, tree.styles[csIdx].flexShrink, shrinkDeficit, lineTotalShrinkWeight)
                    mainSize = mainSize - shrinkAmount
                    if mainSize < 0:
                        mainSize = 0
                else:
                    mainSize = mainSize + WebLayoutFlexGrowBase(tree.styles[csIdx].flex, remaining, lineTotalFlex)
                mainSize = WebLayoutFlexClampMainSize(tree, csIdx, true, mainSize)
                totalUsed = totalUsed + WebLayoutFlexOuterMainSize(tree, csIdx, mainSize, true)
            layoutOrdinal = layoutOrdinal + 1
        var spacing = gap
        var startOffset: int32
        let autoMainMarginCount = WebLayoutFlexCountMainAutoMarginsInRange(tree, parentNodeId, lineStart, lineStop, true)
        let autoMainMarginShare = WebLayoutFlexAutoMainMarginShare(parentWidth, totalUsed, lineGapTotal, autoMainMarginCount)
        if autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentCenter:
            startOffset = (parentWidth - totalUsed - lineGapTotal) / 2
            if startOffset < 0:
                startOffset = 0
        elif autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentFlexEnd:
            startOffset = parentWidth - totalUsed - lineGapTotal
            if startOffset < 0:
                startOffset = 0
        elif autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentSpaceBetween:
            let extraSpace = parentWidth - totalUsed - lineGapTotal
            if extraSpace > 0:
                spacing = gap + extraSpace / WebLayoutFlexSpaceBetweenSlots(lineItemCount)
        elif autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentSpaceAround:
            let extraSpace = parentWidth - totalUsed - lineGapTotal
            if extraSpace > 0 && lineItemCount > 0:
                startOffset = extraSpace / (lineItemCount * 2)
                spacing = gap + extraSpace / lineItemCount
        var pos = startOffset
        layoutOrdinal = lineStart
        while layoutOrdinal < lineStop:
            if WebLayoutFlexItemEligible(tree, parentNodeId, layoutOrdinal):
                let childNodeId = WebLayoutChildAt(tree, parentNodeId, layoutOrdinal)
                let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if csIdx < 0:
                    return false
                var layoutMainSize = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, true, parentWidth, parentHeight)
                if shrinkDeficit > 0:
                    let shrinkAmount = WebLayoutFlexShrinkBase(layoutMainSize, tree.styles[csIdx].flexShrink, shrinkDeficit, lineTotalShrinkWeight)
                    layoutMainSize = layoutMainSize - shrinkAmount
                    if layoutMainSize < 0:
                        layoutMainSize = 0
                else:
                    layoutMainSize = layoutMainSize + WebLayoutFlexGrowBase(tree.styles[csIdx].flex, remaining, lineTotalFlex)
                layoutMainSize = WebLayoutFlexClampMainSize(tree, csIdx, true, layoutMainSize)
                var layoutCrossSize = WebLayoutResolvedHeight(tree, csIdx, parentHeight)
                if layoutCrossSize <= 0:
                    layoutCrossSize = WebLayoutAspectRatioHeightForWidth(tree, csIdx, layoutMainSize)
                if layoutCrossSize <= 0:
                    layoutCrossSize = WebLayoutIntrinsicHeight(tree, childNodeId, parentWidth, 0)
                if layoutCrossSize < 0:
                    layoutCrossSize = 0
                let effectiveAlignItems = WebLayoutFlexEffectiveAlignItems(tree, csIdx, alignItems)
                let outerCrossSize = WebLayoutFlexOuterCrossSize(tree, csIdx, layoutCrossSize, true)
                var childY = parentY + crossOffset
                if effectiveAlignItems == WebLayoutAlignItemsCenter:
                    childY = parentY + crossOffset + (lineCross - outerCrossSize) / 2
                    if childY < parentY + crossOffset:
                        childY = parentY + crossOffset
                elif effectiveAlignItems == WebLayoutAlignItemsFlexEnd:
                    childY = parentY + crossOffset + lineCross - outerCrossSize
                    if childY < parentY + crossOffset:
                        childY = parentY + crossOffset
                elif effectiveAlignItems == WebLayoutAlignItemsStretch:
                    layoutCrossSize = lineCross - WebLayoutFlexCrossBeforeMargin(tree, csIdx, true) -
                        WebLayoutFlexCrossAfterMargin(tree, csIdx, true)
                    if layoutCrossSize < 0:
                        layoutCrossSize = 0
                    childY = parentY + crossOffset
                let childMainWasAuto = tree.styles[csIdx].width == 0
                let childIsSticky = tree.styles[csIdx].position == WebLayoutPositionSticky
                if WebLayoutFlexMainBeforeMarginIsAuto(tree, csIdx, true):
                    pos = pos + autoMainMarginShare
                if layoutMainSize > 0 || shrinkDeficit > 0:
                    if shrinkDeficit > 0 || tree.styles[csIdx].flex > 0 || tree.styles[csIdx].width < 0:
                        tree.styles[csIdx].width = layoutMainSize
                if layoutCrossSize > 0 && tree.styles[csIdx].height < 0:
                    tree.styles[csIdx].height = layoutCrossSize
                let beforeChildBoxCount = tree.boxes.len
                if !WebLayoutLayoutSubtree(tree, childNodeId,
                        parentX + pos, childY, layoutMainSize):
                    return false
                let postIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if postIdx >= 0:
                    let actualBoxIdx = WebLayoutFindBoxIndexForNodeFrom(tree, childNodeId, beforeChildBoxCount)
                    if actualBoxIdx >= 0:
                        let actualMain = tree.boxes[actualBoxIdx].width
                        if childIsSticky || childMainWasAuto:
                            layoutMainSize = actualMain
                    elif childIsSticky || layoutMainSize == 0:
                        let actualMain = tree.styles[postIdx].width
                        if actualMain > 0:
                            layoutMainSize = actualMain
                if WebLayoutFlexMainAfterMarginIsAuto(tree, csIdx, true):
                    pos = pos + WebLayoutFlexOuterMainSize(tree, csIdx, layoutMainSize, true) + autoMainMarginShare + spacing
                else:
                    pos = pos + WebLayoutFlexOuterMainSize(tree, csIdx, layoutMainSize, true) + spacing
            layoutOrdinal = layoutOrdinal + 1
        crossOffset = crossOffset + lineCross + gap
        lineStart = lineStop
    return true

fn WebLayoutFlexLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                               parentX: int32, parentY: int32,
                               parentWidth: int32, parentHeight: int32,
                               flexDir: int32, justifyContent: int32,
                               alignItems: int32, gap: int32): bool =
    let isRow = flexDir == 0 || flexDir == WebLayoutFlexDirectionRow
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    if childCount == 0:
        return true
    # Normalize child display before measuring flex items.
    for fi in 0..<childCount:
        let fid = WebLayoutChildAt(tree, parentNodeId, fi)
        if fid != 0:
            WebLayoutFixDisplay(tree, fid)

    # ---- Pass 1: count flex items, compute totals ----
    var totalFlex: int32
    var fixedMain: int32
    var baseMainTotal: int32
    var totalShrinkWeight: int64 = int64(0)
    var n: int32
    var useCssOrderLayout = true
    var needsOrderSort = false
    var ordinal: int32
    while ordinal < childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            ordinal = ordinal + 1
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            ordinal = ordinal + 1
            continue
        if tree.styles[csIdx].position != WebLayoutPositionAbsolute && tree.styles[csIdx].position != WebLayoutPositionFixed:
            if tree.styles[csIdx].display == WebLayoutDisplayNone:
                WebLayoutFixDisplay(tree, childNodeId)
            if tree.styles[csIdx].display != WebLayoutDisplayNone:
                n = n + 1
                totalFlex = totalFlex + tree.styles[csIdx].flex
                if tree.styles[csIdx].order != 0:
                    needsOrderSort = true
                let baseMain = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, isRow, parentWidth, parentHeight)
                baseMainTotal = baseMainTotal + WebLayoutFlexOuterMainSize(tree, csIdx, baseMain, isRow)
                if tree.styles[csIdx].flexShrink > 0 && baseMain > 0:
                    totalShrinkWeight = totalShrinkWeight + int64(tree.styles[csIdx].flexShrink) * int64(baseMain)
                if tree.styles[csIdx].flex == 0:
                    fixedMain = fixedMain + WebLayoutFlexOuterMainSize(tree, csIdx, baseMain, isRow)
        ordinal = ordinal + 1

    if n == 0:
        return true

    var gapTotal: int32
    if n > 1:
        gapTotal = gap * (n - 1)
    let parentMain = isRow ? parentWidth : parentHeight
    var remaining = parentMain - fixedMain - gapTotal
    if remaining < 0:
        remaining = 0
    var shrinkDeficit: int32
    let shrinkDeficitRaw = baseMainTotal + gapTotal - parentMain
    if shrinkDeficitRaw > 0:
        shrinkDeficit = shrinkDeficitRaw
        remaining = 0

    # ---- Pass 2: compute totalUsed (sum of main sizes after flex-grow) ----
    # We iterate children again to compute sizes without storing in arrays.
    var totalUsed: int32
    ordinal = 0
    while ordinal < childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId != 0:
            let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if csIdx >= 0:
                if tree.styles[csIdx].display != WebLayoutDisplayNone && tree.styles[csIdx].position != WebLayoutPositionAbsolute && tree.styles[csIdx].position != WebLayoutPositionFixed:
                    var mainSize: int32
                    mainSize = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, isRow, parentWidth, parentHeight)
                    if shrinkDeficit > 0:
                        let shrinkAmount = WebLayoutFlexShrinkBase(mainSize, tree.styles[csIdx].flexShrink, shrinkDeficit, totalShrinkWeight)
                        mainSize = mainSize - shrinkAmount
                        if mainSize < 0:
                            mainSize = 0
                    else:
                        mainSize = mainSize + WebLayoutFlexGrowBase(tree.styles[csIdx].flex, remaining, totalFlex)
                    # min/max constraints on main axis
                    if isRow:
                        if tree.styles[csIdx].minWidth > 0 && mainSize < tree.styles[csIdx].minWidth:
                            mainSize = tree.styles[csIdx].minWidth
                        if tree.styles[csIdx].maxWidth > 0 && mainSize > tree.styles[csIdx].maxWidth:
                            mainSize = tree.styles[csIdx].maxWidth
                    else:
                        if tree.styles[csIdx].minHeight > 0 && mainSize < tree.styles[csIdx].minHeight:
                            mainSize = tree.styles[csIdx].minHeight
                        if tree.styles[csIdx].maxHeight > 0 && mainSize > tree.styles[csIdx].maxHeight:
                            mainSize = tree.styles[csIdx].maxHeight
                    totalUsed = totalUsed + WebLayoutFlexOuterMainSize(tree, csIdx, mainSize, isRow)
        ordinal = ordinal + 1

    # Distribute flex-grow rounding error to last flex child
    var roundingExtra: int32
    var lastFlexOrdinal: int32 = -1
    if totalFlex > 0:
        if remaining > 0:
            # Compute how much was distributed
            var distSum: int32
            ordinal = 0
            while ordinal < childCount:
                if WebLayoutFlexItemEligible(tree, parentNodeId, ordinal):
                    let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
                    let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                    if csIdx >= 0:
                        let baseGrow = WebLayoutFlexGrowBase(tree.styles[csIdx].flex, remaining, totalFlex)
                        if baseGrow > 0:
                            distSum = distSum + baseGrow
                            lastFlexOrdinal = ordinal
                ordinal = ordinal + 1
            if lastFlexOrdinal >= 0:
                if distSum < remaining:
                    roundingExtra = remaining - distSum
                    totalUsed = totalUsed + roundingExtra

    # ---- Compute alignment offsets ----
    var spacing = gap
    var startOffset: int32
    let autoMainMarginCount = WebLayoutFlexCountMainAutoMarginsInRange(tree, parentNodeId, 0, childCount, isRow)
    let autoMainMarginShare = WebLayoutFlexAutoMainMarginShare(parentMain, totalUsed, gapTotal, autoMainMarginCount)
    if autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentCenter:
        startOffset = (parentMain - totalUsed - gapTotal) / 2
        if startOffset < 0:
            startOffset = 0
    elif autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentFlexEnd:
        startOffset = parentMain - totalUsed - gapTotal
        if startOffset < 0:
            startOffset = 0
    elif autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentSpaceBetween:
        let extraSpace = parentMain - totalUsed - gapTotal
        if extraSpace > 0:
            spacing = gap + extraSpace / WebLayoutFlexSpaceBetweenSlots(n)
    elif autoMainMarginCount == 0 && justifyContent == WebLayoutJustifyContentSpaceAround:
        let extraSpace = parentMain - totalUsed - gapTotal
        if extraSpace > 0 && n > 0:
            startOffset = extraSpace / (n * 2)
            spacing = gap + extraSpace / n

    # ---- Pass 3: layout children ----
    # Always lay out flex items in CSS order: stable by (order, source ordinal).
    # This keeps source order when all order values are zero.
    if useCssOrderLayout:
        # Sort by CSS order property: for each slot, find the child with
        # the k-th smallest (order, ordinal) pair among flex items.
        # O(n^2); mobile GUI flex child counts are bounded by the emitted view tree.
        var slot: int32
        var pos: int32 = startOffset
        while slot < n:
            var bestOrdinal: int32 = -1
            var bestOrder: int32
            if needsOrderSort:
                bestOrdinal = WebLayoutFlexNthOrderedOrdinal(tree, parentNodeId, childCount, slot)
            else:
                bestOrdinal = WebLayoutFlexNthSourceOrdinal(tree, parentNodeId, childCount, slot)
            if bestOrdinal >= 0:
                let orderedNodeId = WebLayoutChildAt(tree, parentNodeId, bestOrdinal)
                let orderedStyleIdx = WebLayoutFindStyleIndex(tree, orderedNodeId)
                if orderedStyleIdx >= 0:
                    bestOrder = tree.styles[orderedStyleIdx].order

            if bestOrdinal < 0:
                return false

            let childNodeId = WebLayoutChildAt(tree, parentNodeId, bestOrdinal)
            let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if csIdx < 0:
                return false

            var layoutMainSize: int32
            var layoutCrossSize: int32
            if isRow:
                layoutMainSize = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, true, parentWidth, parentHeight)
                layoutCrossSize = WebLayoutResolvedHeight(tree, csIdx, parentHeight)
                if layoutCrossSize <= 0:
                    layoutCrossSize = WebLayoutAspectRatioHeightForWidth(tree, csIdx, layoutMainSize)
                if layoutCrossSize <= 0:
                    if alignItems == WebLayoutAlignItemsStretch && parentHeight > 0:
                        layoutCrossSize = parentHeight - WebLayoutFlexCrossBeforeMargin(tree, csIdx, true) -
                            WebLayoutFlexCrossAfterMargin(tree, csIdx, true)
                        if layoutCrossSize < 0:
                            layoutCrossSize = 0
                    else:
                        layoutCrossSize = WebLayoutIntrinsicHeight(tree, childNodeId, parentWidth, 0)
            else:
                layoutMainSize = WebLayoutFlexBaseMainSize(tree, childNodeId, csIdx, false, parentWidth, parentHeight)
                layoutCrossSize = WebLayoutResolvedWidth(tree, csIdx, parentWidth)
                if layoutCrossSize <= 0:
                    if alignItems == WebLayoutAlignItemsStretch && parentWidth > 0:
                        layoutCrossSize = parentWidth - WebLayoutFlexCrossBeforeMargin(tree, csIdx, false) -
                            WebLayoutFlexCrossAfterMargin(tree, csIdx, false)
                        if layoutCrossSize < 0:
                            layoutCrossSize = 0
                    else:
                        layoutCrossSize = WebLayoutIntrinsicWidth(tree, childNodeId, parentWidth, 0)

            var autoCrossAlign = false
            if layoutCrossSize == 0:
                if alignItems == WebLayoutAlignItemsCenter || alignItems == WebLayoutAlignItemsFlexEnd:
                    autoCrossAlign = true

            if shrinkDeficit > 0:
                let shrinkAmount = WebLayoutFlexShrinkBase(layoutMainSize, tree.styles[csIdx].flexShrink, shrinkDeficit, totalShrinkWeight)
                layoutMainSize = layoutMainSize - shrinkAmount
                if layoutMainSize < 0:
                    layoutMainSize = 0
            else:
                let flexBaseExtra = WebLayoutFlexGrowBase(tree.styles[csIdx].flex, remaining, totalFlex)
                layoutMainSize = layoutMainSize + flexBaseExtra
                if flexBaseExtra > 0:
                    if bestOrdinal == lastFlexOrdinal:
                        layoutMainSize = layoutMainSize + roundingExtra

            if isRow:
                if tree.styles[csIdx].minWidth > 0:
                    if layoutMainSize < tree.styles[csIdx].minWidth:
                        layoutMainSize = tree.styles[csIdx].minWidth
                if tree.styles[csIdx].maxWidth > 0:
                    if layoutMainSize > tree.styles[csIdx].maxWidth:
                        layoutMainSize = tree.styles[csIdx].maxWidth
                if tree.styles[csIdx].minHeight > 0:
                    if layoutCrossSize < tree.styles[csIdx].minHeight:
                        layoutCrossSize = tree.styles[csIdx].minHeight
                if tree.styles[csIdx].maxHeight > 0:
                    if layoutCrossSize > tree.styles[csIdx].maxHeight:
                        layoutCrossSize = tree.styles[csIdx].maxHeight
            else:
                if tree.styles[csIdx].minHeight > 0:
                    if layoutMainSize < tree.styles[csIdx].minHeight:
                        layoutMainSize = tree.styles[csIdx].minHeight
                if tree.styles[csIdx].maxHeight > 0:
                    if layoutMainSize > tree.styles[csIdx].maxHeight:
                        layoutMainSize = tree.styles[csIdx].maxHeight
                if tree.styles[csIdx].minWidth > 0:
                    if layoutCrossSize < tree.styles[csIdx].minWidth:
                        layoutCrossSize = tree.styles[csIdx].minWidth
                if tree.styles[csIdx].maxWidth > 0:
                    if layoutCrossSize > tree.styles[csIdx].maxWidth:
                        layoutCrossSize = tree.styles[csIdx].maxWidth

            var childX: int32
            var childY: int32
            if isRow:
                let childMainWasAuto = tree.styles[csIdx].width == 0
                if WebLayoutFlexMainBeforeMarginIsAuto(tree, csIdx, true):
                    pos = pos + autoMainMarginShare
                childX = parentX + pos
                let outerCrossSize = WebLayoutFlexOuterCrossSize(tree, csIdx, layoutCrossSize, true)
                if alignItems == WebLayoutAlignItemsCenter:
                    if autoCrossAlign:
                        childY = parentY
                    else:
                        childY = parentY + (parentHeight - outerCrossSize) / 2
                        if childY < parentY:
                            childY = parentY
                elif alignItems == WebLayoutAlignItemsFlexEnd:
                    if autoCrossAlign:
                        childY = parentY
                    else:
                        childY = parentY + parentHeight - outerCrossSize
                        if childY < parentY:
                            childY = parentY
                elif alignItems == WebLayoutAlignItemsStretch:
                    if layoutCrossSize == 0:
                        layoutCrossSize = parentHeight - WebLayoutFlexCrossBeforeMargin(tree, csIdx, true) -
                            WebLayoutFlexCrossAfterMargin(tree, csIdx, true)
                        if layoutCrossSize < 0:
                            layoutCrossSize = 0
                    childY = parentY
                else:
                    childY = parentY
                let childIsSticky = tree.styles[csIdx].position == WebLayoutPositionSticky
                if layoutMainSize > 0 || shrinkDeficit > 0:
                    if shrinkDeficit > 0 || tree.styles[csIdx].flex > 0 || tree.styles[csIdx].width < 0:
                        tree.styles[csIdx].width = layoutMainSize
                if layoutCrossSize > 0 && tree.styles[csIdx].height < 0:
                    tree.styles[csIdx].height = layoutCrossSize
                var childParentWidth = layoutMainSize
                if tree.styles[csIdx].flex > 0 && childParentWidth <= 0:
                    childParentWidth = parentWidth
                let beforeChildBoxCount = tree.boxes.len
                if !WebLayoutLayoutSubtree(tree, childNodeId,
                        childX, childY, childParentWidth):
                    return false
                let postIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if postIdx >= 0:
                    let actualBoxIdx = WebLayoutFindBoxIndexForNodeFrom(tree, childNodeId, beforeChildBoxCount)
                    if actualBoxIdx >= 0:
                        let actualMain = tree.boxes[actualBoxIdx].width
                        if childIsSticky || childMainWasAuto:
                            layoutMainSize = actualMain
                    elif childIsSticky || layoutMainSize == 0:
                        let actualMain = tree.styles[postIdx].width
                        if actualMain > 0:
                            layoutMainSize = actualMain
                    if autoCrossAlign:
                        let actualCross = tree.styles[postIdx].height
                        if !WebLayoutFlexApplyAutoCrossAlignment(tree, childNodeId, isRow, alignItems, parentWidth, parentHeight, actualCross):
                            return false
                if WebLayoutFlexMainAfterMarginIsAuto(tree, csIdx, true):
                    pos = pos + WebLayoutFlexOuterMainSize(tree, csIdx, layoutMainSize, true) + autoMainMarginShare + spacing
                else:
                    pos = pos + WebLayoutFlexOuterMainSize(tree, csIdx, layoutMainSize, true) + spacing
            else:
                let childMainWasAuto = tree.styles[csIdx].height <= 0
                if WebLayoutFlexMainBeforeMarginIsAuto(tree, csIdx, false):
                    pos = pos + autoMainMarginShare
                childY = parentY + pos
                let outerCrossSize = WebLayoutFlexOuterCrossSize(tree, csIdx, layoutCrossSize, false)
                if alignItems == WebLayoutAlignItemsCenter:
                    if autoCrossAlign:
                        childX = parentX
                    else:
                        childX = parentX + (parentWidth - outerCrossSize) / 2
                        if childX < parentX:
                            childX = parentX
                elif alignItems == WebLayoutAlignItemsFlexEnd:
                    if autoCrossAlign:
                        childX = parentX
                    else:
                        childX = parentX + parentWidth - outerCrossSize
                        if childX < parentX:
                            childX = parentX
                elif alignItems == WebLayoutAlignItemsStretch:
                    if layoutCrossSize == 0:
                        layoutCrossSize = parentWidth - WebLayoutFlexCrossBeforeMargin(tree, csIdx, false) -
                            WebLayoutFlexCrossAfterMargin(tree, csIdx, false)
                        if layoutCrossSize < 0:
                            layoutCrossSize = 0
                    childX = parentX
                else:
                    childX = parentX
                let childIsSticky = tree.styles[csIdx].position == WebLayoutPositionSticky
                if layoutMainSize > 0 || shrinkDeficit > 0:
                    if shrinkDeficit > 0 || tree.styles[csIdx].flex > 0 || tree.styles[csIdx].height < 0:
                        tree.styles[csIdx].height = layoutMainSize
                let beforeChildBoxCount = tree.boxes.len
                if !WebLayoutLayoutSubtree(tree, childNodeId,
                        childX, childY, layoutCrossSize > 0 ? layoutCrossSize : parentWidth):
                    return false
                let postIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if postIdx >= 0:
                    let actualBoxIdx = WebLayoutFindBoxIndexForNodeFrom(tree, childNodeId, beforeChildBoxCount)
                    if actualBoxIdx >= 0:
                        let actualMain = tree.boxes[actualBoxIdx].height
                        if childIsSticky || childMainWasAuto:
                            layoutMainSize = actualMain
                    elif childIsSticky || layoutMainSize == 0:
                        let actualMain = tree.styles[postIdx].height
                        if actualMain > 0:
                            layoutMainSize = actualMain
                    if autoCrossAlign:
                        let actualCross = tree.styles[postIdx].width
                        if !WebLayoutFlexApplyAutoCrossAlignment(tree, childNodeId, isRow, alignItems, parentWidth, parentHeight, actualCross):
                            return false
                if WebLayoutFlexMainAfterMarginIsAuto(tree, csIdx, false):
                    pos = pos + WebLayoutFlexOuterMainSize(tree, csIdx, layoutMainSize, false) + autoMainMarginShare + spacing
                else:
                    pos = pos + WebLayoutFlexOuterMainSize(tree, csIdx, layoutMainSize, false) + spacing

            slot = slot + 1
        return true
    return true

fn WebLayoutTableNodeCanParticipate(tree: var WebLayoutTree, nodeId: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if tree.styles[styleIdx].display == WebLayoutDisplayNone:
        return false
    if tree.styles[styleIdx].position == WebLayoutPositionAbsolute || tree.styles[styleIdx].position == WebLayoutPositionFixed:
        return false
    return true

fn WebLayoutTableAppendRowsFromNode(tree: var WebLayoutTree, nodeId: int32,
                                    rows: var int32[]): bool =
    if !WebLayoutTableNodeCanParticipate(tree, nodeId):
        return true
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return true
    let role = tree.styles[styleIdx].tableRole
    if role == WebLayoutTableRoleRow:
        add(rows, nodeId)
        return true
    if role == WebLayoutTableRoleSection || role == WebLayoutTableRoleTable:
        let childCount = WebLayoutChildCount(tree, nodeId)
        for ordinal in 0..<childCount:
            let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
            if childNodeId != 0:
                if !WebLayoutTableAppendRowsFromNode(tree, childNodeId, rows):
                    return false
    return true

fn WebLayoutTableCellEligible(tree: var WebLayoutTree, nodeId: int32): bool =
    if !WebLayoutTableNodeCanParticipate(tree, nodeId):
        return false
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    let role = tree.styles[styleIdx].tableRole
    return role == WebLayoutTableRoleCell || role == WebLayoutTableRoleNone

fn WebLayoutTableLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                startX: int32, startY: int32, parentWidth: int32,
                                outContentWidth: var int32, outContentHeight: var int32): bool =
    # 拷贝参数到局部变量，避免编译器参数别名问题
    var tableX = startX
    var tableY = startY
    # Get gap (border-spacing) from table style
    var tableGap: int32
    let tableStyleIdx = WebLayoutFindStyleIndex(tree, parentNodeId)
    if tableStyleIdx >= 0:
        tableGap = tree.styles[tableStyleIdx].gap
    # Phase 1: collect table rows through section groups, then compute cell sizes.
    var trNodes: int32[]
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            continue
        if !WebLayoutTableAppendRowsFromNode(tree, childNodeId, trNodes):
            return false

    # Phase 1a: count max columns across all rows
    var nCols: int32
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var cellCount: int32
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            if !WebLayoutTableCellEligible(tree, tdNodeId):
                continue
            cellCount = cellCount + 1
        if cellCount > nCols:
            nCols = cellCount

    if trNodes.len == 0 || nCols == 0:
        outContentWidth = 0
        outContentHeight = 0
        return true

    # Phase 1b: compute column widths (max cell width per column)
    var colWidths: int32[]
    for ci in 0..<nCols:
        add(colWidths, 0)
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var ci: int32
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            if !WebLayoutTableCellEligible(tree, tdNodeId):
                continue
            if ci < nCols:
                var tdW = tree.styles[tdIdx].width
                if tdW <= 0:
                    if tree.styles[tdIdx].textContent != "":
                        tdW = WebLayoutEstimateTextWidthWeightedFamily(tree.styles[tdIdx].textContent, tree.styles[tdIdx].fontSize, tree.styles[tdIdx].renderFontWeight, tree.styles[tdIdx].fontFamily)
                    if tdW <= 0:
                        tdW = WebLayoutIntrinsicWidth(tree, tdNodeId, parentWidth, 0)
                    if tdW <= 0:
                        tdW = 50    # 默认单元格最小宽度
                    tdW = tdW + tree.styles[tdIdx].borderLeftWidth + tree.styles[tdIdx].borderRightWidth + tree.styles[tdIdx].paddingLeft + tree.styles[tdIdx].paddingRight
                if tdW > colWidths[ci]:
                    colWidths[ci] = tdW
                ci = ci + 1

    # Phase 1c: compute row heights (max cell height per row)
    var rowHeights: int32[]
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var maxH: int32
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            if !WebLayoutTableCellEligible(tree, tdNodeId):
                continue
            var tdH = tree.styles[tdIdx].height
            if tdH <= 0:
                if tree.styles[tdIdx].textContent != "":
                    tdH = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[tdIdx].textContent, tree.styles[tdIdx].fontSize, tree.styles[tdIdx].lineHeight, tree.styles[tdIdx].lineHeightPx2, tree.styles[tdIdx].renderFontWeight, tree.styles[tdIdx].fontFamily)
                if tdH <= 0:
                    tdH = WebLayoutIntrinsicHeight(tree, tdNodeId, parentWidth, 0)
                if tdH <= 0:
                    tdH = 18    # 默认单元格最小高度
                tdH = tdH + tree.styles[tdIdx].borderTopWidth + tree.styles[tdIdx].borderBottomWidth + tree.styles[tdIdx].paddingTop + tree.styles[tdIdx].paddingBottom
            if tdH > maxH:
                maxH = tdH
        add(rowHeights, maxH)

    # Phase 2a: pre-compute row Y positions
    var rowYPos: int32[]
    var ry: int32 = tableY
    for ri in 0..<trNodes.len:
        add(rowYPos, ry)
        if ri < trNodes.len - 1:
            ry = ry + rowHeights[ri] + tableGap
        else:
            ry = ry + rowHeights[ri]

    # Phase 2b: pre-compute column X offsets (cumulative column widths)
    var colXOffsets: int32[]
    var cx: int32 = tableX
    for ci in 0..<nCols:
        add(colXOffsets, cx)
        if ci < nCols - 1:
            cx = cx + colWidths[ci] + tableGap
        else:
            cx = cx + colWidths[ci]

    # Total table content width from column widths + gaps
    var totalTableWidth: int32
    for ci in 0..<nCols:
        totalTableWidth = totalTableWidth + colWidths[ci]
    if nCols > 1:
        totalTableWidth = totalTableWidth + tableGap * (nCols - 1)

    # tr width: use explicit table width if set and larger than content
    var trWidth = totalTableWidth
    let hasExplicitWidth = tableStyleIdx >= 0 && tree.styles[tableStyleIdx].width > 0
    if hasExplicitWidth && parentWidth > trWidth:
        trWidth = parentWidth

    # Phase 2c: place rows and cells (read from arrays, no mutable scalars beyond loop counters)
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let rowY = rowYPos[ri]
        let rowH = rowHeights[ri]

        # Record tr box — width = total table content width, not parentWidth
        WebLayoutRecordBox(tree, trNodeId, tableX, rowY, trWidth, rowH)

        # Place cells in this row
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var ci: int32
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            if !WebLayoutTableCellEligible(tree, tdNodeId):
                continue
            if ci < nCols:
                let cellX = colXOffsets[ci]
                let tdW = colWidths[ci]
                let tdH = rowH

                # Record td box
                WebLayoutRecordBox(tree, tdNodeId,
                    cellX + tree.styles[tdIdx].marginLeft, rowY + tree.styles[tdIdx].marginTop,
                    tdW, tdH)

                # Layout td content (inline/block children inside td)
                var tdContentHeight: int32
                if !WebLayoutBlockLayoutChildren(tree, tdNodeId,
                        cellX + tree.styles[tdIdx].marginLeft, rowY + tree.styles[tdIdx].marginTop, tdW,
                        tdContentHeight):
                    return false

                # Update td box height to match actual content if larger
                if tdContentHeight > tdH:
                    for bi in 0..<tree.boxes.len:
                        if tree.boxes[bi].nodeId == tdNodeId:
                            tree.boxes[bi].height = tdContentHeight
                            break

                ci = ci + 1

    outContentWidth = totalTableWidth
    if trNodes.len > 0:
        let lastRow = trNodes.len - 1
        outContentHeight = rowYPos[lastRow] + rowHeights[lastRow] - tableY
    else:
        outContentHeight = 0
    return true

// Validation hook after the cold compiler struct-copy fix.
// WebLayoutDisplayNone is a real value and must not be rewritten.
fn WebLayoutFixDisplay(tree: var WebLayoutTree, nodeId: int32): bool =
    let si = WebLayoutFindStyleIndex(tree, nodeId)
    if si < 0:
        return false
    return true

fn WebLayoutLayoutTransparentNode(tree: var WebLayoutTree, nodeId: int32,
                                  parentX: int32, parentY: int32,
                                  parentWidth: int32): bool =
    var effectiveWidth = parentWidth
    if effectiveWidth <= 0:
        effectiveWidth = tree.viewportWidth
    let childCount = WebLayoutChildCount(tree, nodeId)
    var ordinal: int32
    while ordinal < childCount:
        let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
        if childNodeId != 0:
            if !WebLayoutLayoutSubtree(tree, childNodeId, parentX, parentY, effectiveWidth):
                return false
        ordinal = ordinal + 1
    return true

// 行内盒子盒行右缘并集: 子元素首盒 (x+width) 的最大值; 无子盒时返回 selfX
fn WebLayoutInlineUnionRight(tree: var WebLayoutTree, parentNodeId: int32, selfX: int32): int32 =
    var unionRight = selfX
    var ordinal = 0
    while ordinal < WebLayoutChildCount(tree, parentNodeId):
        let cid = WebLayoutChildAt(tree, parentNodeId, ordinal)
        let cbi = WebLayoutFindBoxIndexForNodeFrom(tree, cid, 0)
        if cbi >= 0 && cbi < tree.boxes.len:
            let bx = tree.boxes[cbi].x
            let bw = tree.boxes[cbi].width
            if bx + bw > unionRight:
                unionRight = bx + bw
        ordinal = ordinal + 1
    return unionRight
fn WebLayoutLayoutInlineNode(tree: var WebLayoutTree, nodeId: int32,
                             styleIndex: int32,
                             parentX: int32, parentY: int32,
                             parentWidth: int32): bool =
    let x = parentX + tree.styles[styleIndex].marginLeft
    let y = parentY + tree.styles[styleIndex].marginTop
    var w = WebLayoutResolvedWidth(tree, styleIndex, parentWidth)
    var h = tree.styles[styleIndex].height
    if tree.styles[styleIndex].boxSizing != WebLayoutBoxSizingBorderBox:
        if w > 0:
            var addW: int32 = tree.styles[styleIndex].paddingLeft + tree.styles[styleIndex].paddingRight
            addW = addW + tree.styles[styleIndex].borderLeftWidth + tree.styles[styleIndex].borderRightWidth
            w = w + addW
        if h > 0:
            var addH: int32 = tree.styles[styleIndex].paddingTop + tree.styles[styleIndex].paddingBottom
            addH = addH + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].borderBottomWidth
            h = h + addH
    let inlineHWasAuto = h <= 0
    if w <= 0 && tree.styles[styleIndex].textContent != "":
        w = WebLayoutEstimateTextWidthWeightedFamily(tree.styles[styleIndex].textContent, tree.styles[styleIndex].fontSize, tree.styles[styleIndex].renderFontWeight, tree.styles[styleIndex].fontFamily)
    if w <= 0:
        w = WebLayoutIntrinsicWidth(tree, nodeId, parentWidth, 0)
    if h <= 0:
        h = WebLayoutAspectRatioHeightForWidth(tree, styleIndex, w)
    if h <= 0 && tree.styles[styleIndex].textContent != "":
        h = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[styleIndex].textContent, tree.styles[styleIndex].fontSize, tree.styles[styleIndex].lineHeight, tree.styles[styleIndex].lineHeightPx2, tree.styles[styleIndex].renderFontWeight, tree.styles[styleIndex].fontFamily)
    if h <= 0:
        h = WebLayoutIntrinsicHeight(tree, nodeId, parentWidth, 0)
    h = WebLayoutClampHeightConstraints(tree, styleIndex, h)
    WebLayoutRecordBox(tree, nodeId, x, y, w, h)
    let inlineBoxIdx = tree.boxes.len - 1
    var pushedPosOrigin: int32
    if tree.styles[styleIndex].position != WebLayoutPositionStatic:
        var cbX = x + tree.styles[styleIndex].borderLeftWidth
        var cbY = y + tree.styles[styleIndex].borderTopWidth
        var cbW = w - tree.styles[styleIndex].borderLeftWidth - tree.styles[styleIndex].borderRightWidth - tree.styles[styleIndex].paddingLeft - tree.styles[styleIndex].paddingRight
        var cbH = h - tree.styles[styleIndex].borderTopWidth - tree.styles[styleIndex].borderBottomWidth - tree.styles[styleIndex].paddingTop - tree.styles[styleIndex].paddingBottom
        if cbW < 0:
            cbW = 0
        if cbH < 0:
            cbH = 0
        if WebLayoutPushPositionedOrigin(cbX, cbY, cbW, cbH):
            pushedPosOrigin = 1
    var inlineContentHeight: int32
    if WebLayoutChildCount(tree, nodeId) > 0:
        let contentX = x + tree.styles[styleIndex].borderLeftWidth + tree.styles[styleIndex].paddingLeft
        let contentY = y + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].paddingTop
        var contentW = w - tree.styles[styleIndex].borderLeftWidth - tree.styles[styleIndex].borderRightWidth - tree.styles[styleIndex].paddingLeft - tree.styles[styleIndex].paddingRight
        var contentH = h - tree.styles[styleIndex].borderTopWidth - tree.styles[styleIndex].borderBottomWidth - tree.styles[styleIndex].paddingTop - tree.styles[styleIndex].paddingBottom
        if contentW < 0:
            contentW = 0
        if contentH < 0:
            contentH = 0
        if tree.styles[styleIndex].display == WebLayoutDisplayFlex:
            if !WebLayoutFlexLayoutChildren(tree, nodeId,
                    contentX, contentY, contentW, contentH,
                    tree.styles[styleIndex].flexDirection,
                    tree.styles[styleIndex].justifyContent,
                    tree.styles[styleIndex].alignItems,
                    tree.styles[styleIndex].gap):
                if pushedPosOrigin == 1:
                    WebLayoutPopPositionedOrigin()
                return false
        else:
            # display:inline 的孩子折行约束沿用父行剩余宽度(chrome 行内语义):
            # 自身估宽只是测量结果, 不作为孩子的折行边界; 其余情形保持自身宽。
            // 行内盒的孩子折行边界 = 所在行的剩余宽度(CSS 行内语义); 自身估宽不构成边界
            let childWrapW = tree.styles[styleIndex].display == WebLayoutDisplayInline && parentWidth - (x - parentX) > 0 ? parentWidth - (x - parentX) : w
            if !WebLayoutBlockLayoutChildren(tree, nodeId, x, y, childWrapW, inlineContentHeight):
                if pushedPosOrigin == 1:
                    WebLayoutPopPositionedOrigin()
                return false
            // 行内盒报告宽 = 子盒行水平并集(Chrome getBoundingClientRect 语义)
            if tree.styles[styleIndex].display == WebLayoutDisplayInline:
                let uw = WebLayoutInlineUnionRight(tree, nodeId, x)
                // 仅收敛估宽超行宽的病态盒(多原子子项并排); 常规行内盒不动
                if tree.boxes[inlineBoxIdx].width > childWrapW && uw - x < tree.boxes[inlineBoxIdx].width:
                    tree.boxes[inlineBoxIdx].width = uw - x
            if inlineHWasAuto && inlineContentHeight > 0:
                var inlineActualH = WebLayoutClampHeightConstraints(tree, styleIndex, inlineContentHeight)
                tree.boxes[inlineBoxIdx].height = inlineActualH
            elif inlineHWasAuto && inlineContentHeight > tree.boxes[inlineBoxIdx].height && tree.styles[styleIndex].overflowY == WebLayoutOverflowVisible:
                tree.boxes[inlineBoxIdx].height = WebLayoutClampHeightConstraints(tree, styleIndex, inlineContentHeight)
    tree.styles[styleIndex].width = tree.boxes[inlineBoxIdx].width
    tree.styles[styleIndex].height = tree.boxes[inlineBoxIdx].height
    let positionedInlineOk = WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, tree.boxes[inlineBoxIdx].width, tree.boxes[inlineBoxIdx].height)
    if pushedPosOrigin == 1:
        WebLayoutPopPositionedOrigin()
    return positionedInlineOk

fn WebLayoutLayoutBlockNode(tree: var WebLayoutTree, nodeId: int32,
                            styleIndex: int32,
                            parentX: int32, parentY: int32,
                            parentWidth: int32): bool =
    let x = parentX + tree.styles[styleIndex].marginLeft
    let y = parentY + tree.styles[styleIndex].marginTop
    var boxWidth = WebLayoutResolvedWidth(tree, styleIndex, parentWidth)
    if boxWidth > 0 || tree.styles[styleIndex].hasWidthDeclared:
        # CSS content-box: declared width is the CONTENT width; the border box
        # also spans horizontal padding and border. Chrome parity requires the
        # recorded geometry (and child containing block) to be the border box.
        if tree.styles[styleIndex].boxSizing != WebLayoutBoxSizingBorderBox:
            boxWidth = boxWidth + tree.styles[styleIndex].paddingLeft + tree.styles[styleIndex].paddingRight + tree.styles[styleIndex].borderLeftWidth + tree.styles[styleIndex].borderRightWidth
    if boxWidth <= 0 && !tree.styles[styleIndex].hasWidthDeclared:
        if parentWidth > 0:
            boxWidth = parentWidth
        elif tree.viewportWidth > 0:
            boxWidth = tree.viewportWidth
    var boxHeight = tree.styles[styleIndex].height
    let blockHWasAuto = boxHeight <= 0
    if boxHeight <= 0:
        boxHeight = WebLayoutAspectRatioHeightForWidth(tree, styleIndex, boxWidth)
    if boxHeight <= 0:
        if tree.styles[styleIndex].textContent.len > 0:
            boxHeight = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[styleIndex].textContent, tree.styles[styleIndex].fontSize, tree.styles[styleIndex].lineHeight, tree.styles[styleIndex].lineHeightPx2, tree.styles[styleIndex].renderFontWeight, tree.styles[styleIndex].fontFamily)
            boxHeight = boxHeight + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].borderBottomWidth + tree.styles[styleIndex].paddingTop + tree.styles[styleIndex].paddingBottom
    boxHeight = WebLayoutClampHeightConstraints(tree, styleIndex, boxHeight)
    let parentBoxIdx: int32 = tree.boxes.len
    WebLayoutRecordBox(tree, nodeId, x, y, boxWidth, boxHeight)
    WebLayoutApplyBoxOffset(tree, nodeId)
    tree.styles[styleIndex].width = boxWidth
    if boxHeight > 0:
        tree.styles[styleIndex].height = boxHeight
    var pushedPosOrigin: int32
    if tree.styles[styleIndex].position != WebLayoutPositionStatic:
        var cbX = x + tree.styles[styleIndex].borderLeftWidth
        var cbY = y + tree.styles[styleIndex].borderTopWidth
        var cbW = boxWidth - tree.styles[styleIndex].borderLeftWidth - tree.styles[styleIndex].borderRightWidth - tree.styles[styleIndex].paddingLeft - tree.styles[styleIndex].paddingRight
        var cbH = boxHeight - tree.styles[styleIndex].borderTopWidth - tree.styles[styleIndex].borderBottomWidth - tree.styles[styleIndex].paddingTop - tree.styles[styleIndex].paddingBottom
        if cbW < 0:
            cbW = 0
        if cbH < 0:
            cbH = 0
        if WebLayoutPushPositionedOrigin(cbX, cbY, cbW, cbH):
            pushedPosOrigin = 1
    var contentHeight: int32
    if WebLayoutChildCount(tree, nodeId) > 0:
        let blockChildrenOk = WebLayoutBlockLayoutChildren(tree, nodeId, x, y, boxWidth, contentHeight)
        if !blockChildrenOk:
            if pushedPosOrigin == 1:
                WebLayoutPopPositionedOrigin()
            return false
    if blockHWasAuto && contentHeight > 0:
        tree.boxes[parentBoxIdx].height = WebLayoutClampHeightConstraints(tree, styleIndex, contentHeight)
    elif blockHWasAuto && contentHeight > tree.boxes[parentBoxIdx].height && tree.styles[styleIndex].overflowY == WebLayoutOverflowVisible:
        tree.boxes[parentBoxIdx].height = WebLayoutClampHeightConstraints(tree, styleIndex, contentHeight)
    else:
        tree.boxes[parentBoxIdx].height = WebLayoutClampHeightConstraints(tree, styleIndex, tree.boxes[parentBoxIdx].height)
    tree.styles[styleIndex].height = tree.boxes[parentBoxIdx].height
    let positionedBlockOk = WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, boxWidth, tree.boxes[parentBoxIdx].height)
    if pushedPosOrigin == 1:
        WebLayoutPopPositionedOrigin()
    return positionedBlockOk

fn WebLayoutLayoutTableNode(tree: var WebLayoutTree, nodeId: int32,
                            styleIndex: int32,
                            parentX: int32, parentY: int32,
                            parentWidth: int32): bool =
    let x = parentX + tree.styles[styleIndex].marginLeft
    let y = parentY + tree.styles[styleIndex].marginTop
    var boxWidth = WebLayoutResolvedWidth(tree, styleIndex, parentWidth)
    if boxWidth <= 0 && parentWidth > 0 && !tree.styles[styleIndex].hasWidthDeclared:
        boxWidth = parentWidth
    var boxHeight = tree.styles[styleIndex].height
    if boxHeight <= 0:
        boxHeight = WebLayoutAspectRatioHeightForWidth(tree, styleIndex, boxWidth)
    if boxHeight <= 0:
        if tree.styles[styleIndex].textContent.len > 0:
            boxHeight = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[styleIndex].textContent, tree.styles[styleIndex].fontSize, tree.styles[styleIndex].lineHeight, tree.styles[styleIndex].lineHeightPx2, tree.styles[styleIndex].renderFontWeight, tree.styles[styleIndex].fontFamily)
            boxHeight = boxHeight + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].borderBottomWidth + tree.styles[styleIndex].paddingTop + tree.styles[styleIndex].paddingBottom
        if tree.styles[styleIndex].minHeight > 0 && boxHeight < tree.styles[styleIndex].minHeight:
            boxHeight = tree.styles[styleIndex].minHeight
    let parentBoxIdx: int32 = tree.boxes.len
    WebLayoutRecordBox(tree, nodeId, x, y, boxWidth, boxHeight)
    WebLayoutApplyBoxOffset(tree, nodeId)
    var contentWidth: int32
    var contentHeight: int32
    if !WebLayoutTableLayoutChildren(tree, nodeId, x, y, boxWidth, contentWidth, contentHeight):
        return false
    if contentHeight > tree.boxes[parentBoxIdx].height:
        tree.boxes[parentBoxIdx].height = contentHeight
    tree.styles[styleIndex].height = tree.boxes[parentBoxIdx].height
    if tree.styles[styleIndex].width <= 0 && contentWidth > tree.boxes[parentBoxIdx].width:
        tree.boxes[parentBoxIdx].width = contentWidth
        tree.styles[styleIndex].width = contentWidth
    return WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, tree.boxes[parentBoxIdx].width, tree.boxes[parentBoxIdx].height)

fn WebLayoutMasonryColumnCount(containerWidth: int32, minColumnWidth: int32,
                               gap: int32, minColumns: int32,
                               maxColumns: int32): int32 =
    var minCols = minColumns
    var maxCols = maxColumns
    var minW = minColumnWidth
    var g = gap
    if minCols <= 0:
        minCols = 1
    if maxCols < minCols:
        maxCols = minCols
    if minW <= 0:
        minW = 1
    if g < 0:
        g = 0
    var denom = minW + g
    if denom <= 0:
        denom = minW
    var maxPossible = minCols
    if containerWidth > 0:
        maxPossible = (containerWidth + g) / denom
    if maxPossible < minCols:
        return minCols
    if maxPossible > maxCols:
        return maxCols
    return maxPossible

fn WebLayoutMasonryShortestColumn(columnHeights: var int32[]): int32 =
    if columnHeights.len == 0:
        return 0
    var best = 0
    var bestHeight = columnHeights[0]
    var i = 1
    while i < columnHeights.len:
        if columnHeights[i] < bestHeight:
            best = i
            bestHeight = columnHeights[i]
        i = i + 1
    return best

fn WebLayoutLayoutMasonryNode(tree: var WebLayoutTree, nodeId: int32,
                              styleIndex: int32,
                              parentX: int32, parentY: int32,
                              parentWidth: int32): bool =
    let x = parentX + tree.styles[styleIndex].marginLeft
    let y = parentY + tree.styles[styleIndex].marginTop
    var masonryW = WebLayoutResolvedWidth(tree, styleIndex, parentWidth)
    if masonryW <= 0:
        if parentWidth > 0:
            masonryW = parentWidth
        elif tree.viewportWidth > 0:
            masonryW = tree.viewportWidth
    var masonryH = tree.styles[styleIndex].height
    let masonryHWasAuto = masonryH <= 0
    if masonryH <= 0:
        masonryH = WebLayoutAspectRatioHeightForWidth(tree, styleIndex, masonryW)
    if masonryH <= 0:
        masonryH = 0

    let masonryBoxIdx: int32 = tree.boxes.len
    WebLayoutRecordBox(tree, nodeId, x, y, masonryW, masonryH)
    WebLayoutApplyBoxOffset(tree, nodeId)

    var contentX = x + tree.styles[styleIndex].borderLeftWidth + tree.styles[styleIndex].paddingLeft
    var contentY = y + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].paddingTop
    var contentW = masonryW - tree.styles[styleIndex].borderLeftWidth - tree.styles[styleIndex].borderRightWidth - tree.styles[styleIndex].paddingLeft - tree.styles[styleIndex].paddingRight
    if contentW < 0:
        contentW = 0
    var gap = tree.styles[styleIndex].gap
    if gap < 0:
        gap = 0
    let columnCount = WebLayoutMasonryColumnCount(contentW,
        tree.styles[styleIndex].masonryMinColumnWidth,
        gap,
        tree.styles[styleIndex].masonryMinColumns,
        tree.styles[styleIndex].masonryMaxColumns)
    var columnHeights: int32[]
    var columnWidths: int32[]
    var columnXs: int32[]
    if tree.styles[styleIndex].masonryModel == WebLayoutMasonryModelVirtualizedReact:
        for ci in 0..<columnCount:
            var colX = contentX
            var colW = contentW
            if columnCount > 0:
                colX = contentX + (contentW * ci) / columnCount + (gap * ci) / columnCount
                colW = contentW / columnCount
            let halfGap = gap / 2
            if columnCount > 1:
                colW = colW - (gap * (columnCount - 1)) / columnCount
            if ci > 0:
                colX = colX + halfGap
                colW = colW - halfGap
            if ci < columnCount - 1:
                colW = colW - halfGap
            if colW < 0:
                colW = 0
            add(columnHeights, 0)
            add(columnWidths, colW)
            add(columnXs, colX)
    else:
        var totalGap: int32
        if columnCount > 1:
            totalGap = gap * (columnCount - 1)
        var availableW = contentW - totalGap
        if availableW < 0:
            availableW = 0
        var baseW = availableW
        if columnCount > 0:
            baseW = availableW / columnCount
        var remainder = availableW - baseW * columnCount
        var cursorX = contentX
        for ci in 0..<columnCount:
            var colW = baseW
            if ci < remainder:
                colW = colW + 1
            add(columnHeights, 0)
            add(columnWidths, colW)
            add(columnXs, cursorX)
            cursorX = cursorX + colW + gap

    let childCount = WebLayoutChildCount(tree, nodeId)
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
        if childNodeId == 0:
            continue
        let childStyleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if childStyleIdx < 0:
            continue
        if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
            continue
        if tree.styles[childStyleIdx].position == WebLayoutPositionAbsolute || tree.styles[childStyleIdx].position == WebLayoutPositionFixed:
            continue
        let col = WebLayoutMasonryShortestColumn(columnHeights)
        if col < 0 || col >= columnWidths.len:
            return false
        let beforeChildBoxCount = tree.boxes.len
        if !WebLayoutLayoutSubtree(tree, childNodeId, columnXs[col], contentY + columnHeights[col], columnWidths[col]):
            return false
        var childBottom = columnHeights[col] + tree.styles[styleIndex].masonryEstimatedItemHeight
        let actualChildBoxIdx = WebLayoutFindBoxIndexForNodeFrom(tree, childNodeId, beforeChildBoxCount)
        if actualChildBoxIdx >= 0 && actualChildBoxIdx < tree.boxes.len:
            childBottom = tree.boxes[actualChildBoxIdx].y + tree.boxes[actualChildBoxIdx].height + tree.styles[childStyleIdx].marginBottom - contentY
        elif tree.styles[childStyleIdx].height > 0:
            childBottom = columnHeights[col] + tree.styles[childStyleIdx].marginTop + tree.styles[childStyleIdx].height + tree.styles[childStyleIdx].marginBottom
        columnHeights[col] = childBottom + gap

    var contentH: int32
    for hi in 0..<columnHeights.len:
        var usedH = columnHeights[hi]
        if usedH > 0 && gap > 0:
            usedH = usedH - gap
        if usedH > contentH:
            contentH = usedH
    var actualH = contentH + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].borderBottomWidth + tree.styles[styleIndex].paddingTop + tree.styles[styleIndex].paddingBottom
    if tree.styles[styleIndex].minHeight > 0 && actualH < tree.styles[styleIndex].minHeight:
        actualH = tree.styles[styleIndex].minHeight
    if tree.styles[styleIndex].maxHeight > 0 && actualH > tree.styles[styleIndex].maxHeight:
        actualH = tree.styles[styleIndex].maxHeight
    if masonryHWasAuto || actualH > masonryH && tree.styles[styleIndex].overflowY == WebLayoutOverflowVisible:
        masonryH = actualH
    if masonryBoxIdx >= 0 && masonryBoxIdx < tree.boxes.len:
        tree.boxes[masonryBoxIdx].height = masonryH
    tree.styles[styleIndex].width = masonryW
    tree.styles[styleIndex].height = masonryH
    return WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, masonryW, masonryH)

fn WebLayoutLayoutGridNode(tree: var WebLayoutTree, nodeId: int32,
                           styleIndex: int32,
                           parentX: int32, parentY: int32,
                           parentWidth: int32): bool =
    let x = parentX + tree.styles[styleIndex].marginLeft
    let y = parentY + tree.styles[styleIndex].marginTop
    var gridW = WebLayoutResolvedWidth(tree, styleIndex, parentWidth)
    if gridW <= 0 && parentWidth > 0:
        gridW = parentWidth
    var gridH = tree.styles[styleIndex].height
    if gridH <= 0:
        gridH = WebLayoutAspectRatioHeightForWidth(tree, styleIndex, gridW)
    var gridContentX = x + tree.styles[styleIndex].borderLeftWidth + tree.styles[styleIndex].paddingLeft
    var gridContentY = y + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].paddingTop
    var gridContentW = gridW - tree.styles[styleIndex].borderLeftWidth - tree.styles[styleIndex].borderRightWidth - tree.styles[styleIndex].paddingLeft - tree.styles[styleIndex].paddingRight
    var gridContentH = gridH - tree.styles[styleIndex].borderTopWidth - tree.styles[styleIndex].borderBottomWidth - tree.styles[styleIndex].paddingTop - tree.styles[styleIndex].paddingBottom
    if gridContentW < 0:
        gridContentW = 0
    if gridContentH < 0:
        gridContentH = 0
    let gridChildCount = WebLayoutChildCount(tree, nodeId)
    var gridChildIds: int32[]
    for gi in 0..<gridChildCount:
        add(gridChildIds, WebLayoutChildAt(tree, nodeId, gi))
    let gridBoxIdx: int32 = tree.boxes.len
    WebLayoutRecordBox(tree, nodeId, x, y, gridW, gridH)
    WebLayoutApplyBoxOffset(tree, nodeId)
    if !WebLayoutGridLayoutChildren(tree, nodeId, gridContentX, gridContentY, gridContentW, gridContentH, gridChildIds):
        return false
    if gridH <= 0:
        var maxChildBottom: int32
        let gridChildLoopCount = WebLayoutChildCount(tree, nodeId)
        for gi in 0..<gridChildLoopCount:
            let gcid = WebLayoutChildAt(tree, nodeId, gi)
            if gcid == 0:
                continue
            for bi in 0..<tree.boxes.len:
                if tree.boxes[bi].nodeId == gcid:
                    let childBottom = tree.boxes[bi].y + tree.boxes[bi].height
                    if childBottom > maxChildBottom:
                        maxChildBottom = childBottom
                    break
        if maxChildBottom > y:
            gridH = maxChildBottom - y + tree.styles[styleIndex].borderBottomWidth + tree.styles[styleIndex].paddingBottom
        if tree.styles[styleIndex].minHeight > 0 && gridH < tree.styles[styleIndex].minHeight:
            gridH = tree.styles[styleIndex].minHeight
        if tree.styles[styleIndex].maxHeight > 0 && gridH > tree.styles[styleIndex].maxHeight:
            gridH = tree.styles[styleIndex].maxHeight
        if gridBoxIdx >= 0 && gridBoxIdx < tree.boxes.len:
            tree.boxes[gridBoxIdx].height = gridH
        tree.styles[styleIndex].height = gridH
    return WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, gridW, gridH)

fn WebLayoutLayoutFlexNode(tree: var WebLayoutTree, nodeId: int32,
                           styleIndex: int32,
                           parentX: int32, parentY: int32,
                           parentWidth: int32): bool =
    let x = parentX + tree.styles[styleIndex].marginLeft
    let y = parentY + tree.styles[styleIndex].marginTop
    var flexW = WebLayoutResolvedWidth(tree, styleIndex, parentWidth)
    var flexH = tree.styles[styleIndex].height
    let flexHWasAuto = flexH <= 0
    if flexW <= 0 && parentWidth > 0:
        flexW = parentWidth
    if flexH <= 0:
        flexH = WebLayoutAspectRatioHeightForWidth(tree, styleIndex, flexW)
    if tree.styles[styleIndex].flexWrap != 0:
        WebLayoutFlexWrapAutoSize(tree, nodeId, styleIndex, flexW, flexH)
    else:
        WebLayoutFlexAutoSize(tree, nodeId,
            tree.styles[styleIndex].flexDirection, tree.styles[styleIndex].gap,
            flexW, flexH)
    if flexW <= 0 && parentWidth > 0:
        flexW = parentWidth
    if flexH <= 0 && tree.styles[styleIndex].textContent.len > 0:
        flexH = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[styleIndex].textContent, tree.styles[styleIndex].fontSize, tree.styles[styleIndex].lineHeight, tree.styles[styleIndex].lineHeightPx2, tree.styles[styleIndex].renderFontWeight, tree.styles[styleIndex].fontFamily)
    WebLayoutRecordBox(tree, nodeId, x, y, flexW, flexH)
    let flexBoxIdx = tree.boxes.len - 1
    WebLayoutApplyBoxOffset(tree, nodeId)
    var flexContentX = x + tree.styles[styleIndex].borderLeftWidth + tree.styles[styleIndex].paddingLeft
    var flexContentY = y + tree.styles[styleIndex].borderTopWidth + tree.styles[styleIndex].paddingTop
    var flexContentW = flexW - tree.styles[styleIndex].borderLeftWidth - tree.styles[styleIndex].borderRightWidth - tree.styles[styleIndex].paddingLeft - tree.styles[styleIndex].paddingRight
    var flexContentH = flexH - tree.styles[styleIndex].borderTopWidth - tree.styles[styleIndex].borderBottomWidth - tree.styles[styleIndex].paddingTop - tree.styles[styleIndex].paddingBottom
    if flexContentW < 0:
        flexContentW = 0
    if flexContentH < 0:
        flexContentH = 0
    if tree.styles[styleIndex].flexWrap != 0:
        if !WebLayoutFlexLayoutWrappedChildren(tree, nodeId,
                flexContentX, flexContentY, flexContentW, flexContentH,
                tree.styles[styleIndex].flexDirection, tree.styles[styleIndex].flexWrap,
                tree.styles[styleIndex].justifyContent,
                tree.styles[styleIndex].alignItems,
                tree.styles[styleIndex].alignContent,
                tree.styles[styleIndex].gap):
            return false
    else:
        if !WebLayoutFlexLayoutChildren(tree, nodeId,
                flexContentX, flexContentY, flexContentW, flexContentH,
                tree.styles[styleIndex].flexDirection, tree.styles[styleIndex].justifyContent,
                tree.styles[styleIndex].alignItems, tree.styles[styleIndex].gap):
            return false
    if flexHWasAuto:
        var maxChildBottom: int32
        let fcc = WebLayoutChildCount(tree, nodeId)
        for fi in 0..<fcc:
            let fcid = WebLayoutChildAt(tree, nodeId, fi)
            if fcid != 0:
                let fsi = WebLayoutFindStyleIndex(tree, fcid)
                if fsi >= 0:
                    for bi in 0..<tree.boxes.len:
                        if tree.boxes[bi].nodeId == fcid:
                            let childBottom = tree.boxes[bi].y + tree.boxes[bi].height + tree.styles[fsi].marginBottom
                            if childBottom > maxChildBottom:
                                maxChildBottom = childBottom
                            break
        if maxChildBottom > y:
            let actualFlexH = maxChildBottom - y + tree.styles[styleIndex].borderBottomWidth + tree.styles[styleIndex].paddingBottom
            if actualFlexH > flexH:
                flexH = actualFlexH
                if flexBoxIdx >= 0 && flexBoxIdx < tree.boxes.len:
                    tree.boxes[flexBoxIdx].height = flexH
    if flexBoxIdx >= 0 && flexBoxIdx < tree.boxes.len:
        tree.styles[styleIndex].width = tree.boxes[flexBoxIdx].width
        tree.styles[styleIndex].height = tree.boxes[flexBoxIdx].height
    return WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, flexW, flexH)


fn WebLayoutSetGridTracks(tree: var WebLayoutTree, nodeId: int32,
                          kind: int32,
                          sizes: int32[], units: int32[]): bool =
    if !WebLayoutNodeExists(tree, nodeId):
        return false
    let ns = sizes.len
    let nu = units.len
    if ns != nu:
        return false
    for i in 0..<ns:
        var track: WebGridTrack
        track.nodeId = nodeId
        track.size = sizes[i]
        track.unit = units[i]
        track.kind = kind
        track.ordinal = i
        add(tree.gridTracks, track)
    return true

fn WebLayoutParseGridLength(size: int32, unit: int32,
                            containerSize: int32,
                            totalFr: int32,
                            frTotalSize: int32,
                            outSize: var int32): bool =
    if unit == 0:
        outSize = size
        return true
    if unit == 1:
        if totalFr > 0:
            outSize = frTotalSize * size / totalFr
        else:
            outSize = 0
        return true
    if unit == 2:
        outSize = 0
        return true
    return false

fn WebLayoutParseGridTemplate(template: str,
                              kind: int32,
                              nodeId: int32,
                              tree: var WebLayoutTree): bool =
    if template.len == 0:
        return true
    var sizes: int32[]
    var units: int32[]
    var tokenStart: int32
    var i: int32
    while i < template.len:
        let ch = template[i]
        if ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r':
            if i > tokenStart:
                let tokenLen = i - tokenStart
                if tokenLen >= 3:
                    let last = i - 1
                    if template[last - 1] == 'p' && template[last] == 'x':
                        var val: int32
                        for j in tokenStart..<last - 1:
                            let digit = template[j]
                            if digit >= '0' && digit <= '9':
                                val = val * 10 + int32(digit) - int32('0')
                            else:
                                return false
                        add(sizes, val)
                        add(units, 0)
                    elif template[last] == '%':
                        var val: int32
                        for j in tokenStart..<last:
                            let digit = template[j]
                            if digit >= '0' && digit <= '9':
                                val = val * 10 + int32(digit) - int32('0')
                            else:
                                return false
                        add(sizes, val)
                        add(units, 2)
            tokenStart = i + 1
        i = i + 1
    # Last token
    if i > tokenStart:
        let tokenLen = i - tokenStart
        if tokenLen >= 3:
            let last = i - 1
            if template[last - 1] == 'p' && template[last] == 'x':
                var val: int32
                for j in tokenStart..<last - 1:
                    let digit = template[j]
                    if digit >= '0' && digit <= '9':
                        val = val * 10 + int32(digit) - int32('0')
                    else:
                        return false
                add(sizes, val)
                add(units, 0)
            elif template[last] == '%':
                var val: int32
                for j in tokenStart..<last:
                    let digit = template[j]
                    if digit >= '0' && digit <= '9':
                        val = val * 10 + int32(digit) - int32('0')
                    else:
                        return false
                add(sizes, val)
                add(units, 2)
    if sizes.len == 0:
        return true
    return WebLayoutSetGridTracks(tree, nodeId, kind, sizes, units)


fn WebLayoutCompute(tree: var WebLayoutTree, rootNodeId: int32): bool =
    if rootNodeId == 0:
        return false
    if !WebLayoutNodeExists(tree, rootNodeId):
        return false
    if tree.boxes.len > 0:
        setLen(tree.boxes, 0)
    tree.boxCount = 0
    if tree.visitedNodeIds.len > 0:
        setLen(tree.visitedNodeIds, 0)
    if tree.blockBoxIndexByNodeId.len > 0:
        setLen(tree.blockBoxIndexByNodeId, 0)
    var rootParentWidth = tree.viewportWidth
    if rootParentWidth < 0:
        rootParentWidth = 0
    if !WebLayoutLayoutSubtree(tree, rootNodeId, 0, 0, rootParentWidth):
        return false
    if !WebLayoutRebuildBoxIndexes(tree):
        return false
    # Propagate child overflow height only when the parent permits visible vertical overflow.
    for ei in 0..<tree.children.len:
        let parentId = tree.children[ei].parentNodeId
        let childId = tree.children[ei].childNodeId
        let parentBoxIndex = WebLayoutFindFirstBoxIndex(tree, parentId)
        if parentBoxIndex < 0:
            continue
        if tree.boxes[parentBoxIndex].overflowY != WebLayoutOverflowVisible:
            continue
        let childStyleIdx = WebLayoutFindStyleIndex(tree, childId)
        if childStyleIdx >= 0:
            if tree.styles[childStyleIdx].position == WebLayoutPositionAbsolute || tree.styles[childStyleIdx].position == WebLayoutPositionFixed:
                continue
        let childBoxIndex = WebLayoutFindFirstBoxIndex(tree, childId)
        if childBoxIndex < 0:
            continue
        let childBottom = tree.boxes[childBoxIndex].y + tree.boxes[childBoxIndex].height
        let parentBottom = tree.boxes[parentBoxIndex].y + tree.boxes[parentBoxIndex].height
        if childBottom > parentBottom:
            tree.boxes[parentBoxIndex].height = childBottom - tree.boxes[parentBoxIndex].y
    return true

fn WebLayoutBoxCount(tree: var WebLayoutTree): int32 =
    return tree.boxes.len

fn WebLayoutBoxNodeAt(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].nodeId

fn WebLayoutBoxXAt(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].x

fn WebLayoutBoxYAt(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].y

fn WebLayoutBoxWidthAt(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].width

fn WebLayoutBoxHeightAt(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].height

fn WebLayoutBoxXPx2At(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].xPx2

fn WebLayoutBoxYPx2At(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].yPx2

fn WebLayoutBoxWidthPx2At(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].widthPx2

fn WebLayoutBoxHeightPx2At(tree: var WebLayoutTree, index: int32): int32 =
    if index < 0 || index >= tree.boxes.len:
        return 0
    return tree.boxes[index].heightPx2

fn WebLayoutDumpBoxes(tree: var WebLayoutTree) =
    let nb = tree.boxes.len
    for i in 0..<nb:
        let b = tree.boxes[i]
        echo(Fmt"box[{i}] nodeId={b.nodeId} pos=({b.x},{b.y}) size=({b.width},{b.height}) z={b.zIndex} v={b.visible} o={b.opacity}")


