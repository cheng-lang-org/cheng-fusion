                bestFaceIndex = 2
                bestGlyphIndex = glyph2
    if __webLayoutFontFaceCount >= 4:
        let glyph3 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace3, codepoint)
        if glyph3 > 0:
            let candidateScore3 = WebLayoutAbsInt32(__webLayoutFontWeight3 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore3, __webLayoutFontWeight3, targetWeight):
                bestScore = candidateScore3
