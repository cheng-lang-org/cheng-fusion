    WebLayoutTree =
        nextNodeId: int32
        rootNodeId: int32
        viewportWidth: int32
        viewportHeight: int32
        boxCount: int32
        layoutDepth: int32
        styles: WebLayoutStyleBox[]
        children: WebLayoutChildEdge[]
        boxes: WebLayoutBox[]
        gridTracks: WebGridTrack[]
        gridItems: WebGridItem[]
        flexChildIds: int32[]
        flexChildMain: int32[]
        flexChildCross: int32[]
        flexChildOrders: int32[]
        visitedNodeIds: int32[]
        # O(1) lookup accelerators, lazily synced from the append-only styles/
        # children arrays (see WebLayoutEnsureStyleIndex / EnsureChildIndex).
        # styleIndexByNodeId[nodeId] = styleIndex+1 (0=absent, first-write-wins to
        # match the linear scan's first-match semantics). parentByChildNodeId
        # [childNodeId] = parentNodeId (0=none). childCountByParentNodeId[parent]
        # = number of child edges. *Synced track how far each map has consumed.
        styleIndexByNodeId: int32[]
        styleIndexSynced: int32
        parentByChildNodeId: int32[]
        childCountByParentNodeId: int32[]
        childIndexSynced: int32
        firstBoxIndexByNodeId: int32[]
        visibleBoxIndexByNodeId: int32[]
        boxIndexSynced: int32
        # blockBoxIndexByNodeId[nodeId] = boxes-index+1 of the single canonical
        # box record kept for a non-inline-flow node (0=absent). Lets
        # WebLayoutRecordBox dedupe re-records of the same block-level node in
        # O(1) amortized instead of a linear tree.boxes scan. Reset alongside
        # tree.boxes at the top of each WebLayoutCompute pass (see there).
        blockBoxIndexByNodeId: int32[]

