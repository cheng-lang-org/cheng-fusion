                bestFaceIndex = 4
                bestGlyphIndex = glyph4
    if __webLayoutFontFaceCount >= 6:
        let glyph5 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace5, codepoint)
        if glyph5 > 0:
            let candidateScore5 = WebLayoutAbsInt32(__webLayoutFontWeight5 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore5, __webLayoutFontWeight5, targetWeight):
                bestScore = candidateScore5
                bestWeight = __webLayoutFontWeight5
                bestFaceIndex = 5
                bestGlyphIndex = glyph5
    if __webLayoutFontFaceCount >= 7:
        let glyph6 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace6, codepoint)
        if glyph6 > 0:
            let candidateScore6 = WebLayoutAbsInt32(__webLayoutFontWeight6 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore6, __webLayoutFontWeight6, targetWeight):
                bestScore = candidateScore6
                bestWeight = __webLayoutFontWeight6
                bestFaceIndex = 6
                bestGlyphIndex = glyph6
    if __webLayoutFontFaceCount >= 8:
        let glyph7 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace7, codepoint)
        if glyph7 > 0:
            let candidateScore7 = WebLayoutAbsInt32(__webLayoutFontWeight7 - targetWeight)
            if bestFaceIndex < 0 || WebLayoutFontCascadeShouldReplaceWeight(bestScore, bestWeight, candidateScore7, __webLayoutFontWeight7, targetWeight):
                bestScore = candidateScore7
                bestWeight = __webLayoutFontWeight7
                bestFaceIndex = 7
                bestGlyphIndex = glyph7
    if bestFaceIndex < 0:
        return false
    outFaceIndex = bestFaceIndex
    outGlyphIndex = bestGlyphIndex
    return true

fn WebLayoutFontCascadeSelectWeightedFamily(codepoint: int32,
                                            requestedWeight: int32,
                                            requestedFamily: int32,
                                            outFaceIndex: var int32,
                                            outGlyphIndex: var int32): bool =
    outFaceIndex = -1
    outGlyphIndex = 0
    if codepoint < 0 || __webLayoutFontFaceCount <= 0:
        return false
    let targetFamily = WebLayoutNormalizeFontFamily(requestedFamily)
    let targetWeight = WebLayoutNormalizeFontWeight(requestedWeight)
    var bestScore = 2147483647
    var bestWeight = 400
    var bestFaceIndex = -1
    var bestGlyphIndex = 0
    if __webLayoutFontFamily0 == targetFamily:
        let glyph0 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace0, codepoint)
        if glyph0 > 0:
            let candidateScore0 = WebLayoutAbsInt32(__webLayoutFontWeight0 - targetWeight)
            bestScore = candidateScore0
