            bestGlyphIndex = glyph0
    if __webLayoutFontFaceCount >= 2 && __webLayoutFontFamily1 == targetFamily:
        let glyph1 = font.WebFontGlyphIndexForCodepoint(__webLayoutFontFace1, codepoint)
        if glyph1 > 0:
