fn WebLayoutFontCascadeAdvance(faceIndex: int32, glyphIndex: int32, fontSizePx: int32): int32 =
    if faceIndex == 0:
        return font.WebFontScaledAdvance(__webLayoutFontFace0, glyphIndex, fontSizePx)
    if faceIndex == 1:
        return font.WebFontScaledAdvance(__webLayoutFontFace1, glyphIndex, fontSizePx)
    if faceIndex == 2:
        return font.WebFontScaledAdvance(__webLayoutFontFace2, glyphIndex, fontSizePx)
    if faceIndex == 3:
        return font.WebFontScaledAdvance(__webLayoutFontFace3, glyphIndex, fontSizePx)
    if faceIndex == 4:
        return font.WebFontScaledAdvance(__webLayoutFontFace4, glyphIndex, fontSizePx)
    if faceIndex == 5:
        return font.WebFontScaledAdvance(__webLayoutFontFace5, glyphIndex, fontSizePx)
    if faceIndex == 6:
        return font.WebFontScaledAdvance(__webLayoutFontFace6, glyphIndex, fontSizePx)
    if faceIndex == 7:
        return font.WebFontScaledAdvance(__webLayoutFontFace7, glyphIndex, fontSizePx)
    return 0

@borrows
fn WebLayoutEstimateTextRangeWidthHeuristic(text: str, startIndex: int32, endIndex: int32, fontSize: int32): int32 =
    if fontSize <= 0:
        fontSize = 16
    var width: int32
    var i: int32 = startIndex
    if i < 0:
        i = 0
    var endAt: int32 = endIndex
    if endAt > text.len:
        endAt = text.len
    while i < endAt:
        let ch = text[i]
        if ch == ' ':
            width = width + fontSize / 4
            i = i + 1
        elif int32(ch) >= 0 && int32(ch) < 128:
            width = width + fontSize * 3 / 5
            i = i + 1
        else:
            width = width + fontSize
            i = i + 1
            while i < endAt && (int32(text[i]) & 192) == 128:
                i = i + 1
    return width

fn WebLayoutMeasureCodepointWidthWeighted(codepoint: int32, fontSize: int32, fontWeight: int32): int32 =
    return WebLayoutMeasureCodepointWidthWeightedFamily(codepoint, fontSize, fontWeight, WebLayoutFontFamilySans)

fn WebLayoutMeasureCodepointWidthWeightedFamily(codepoint: int32, fontSize: int32, fontWeight: int32, fontFamily: int32): int32 =
    var faceIndex = -1
    var glyphIndex = 0
    if !WebLayoutFontCascadeSelectWeightedFamily(codepoint, fontWeight, fontFamily, faceIndex, glyphIndex):
        return -1
    let advance = WebLayoutFontCascadeAdvance(faceIndex, glyphIndex, fontSize)
    if advance <= 0:
        return -1
    return advance

@borrows
fn WebLayoutEstimateTextRangeWidthWeighted(text: str, startIndex: int32, endIndex: int32, fontSize: int32, fontWeight: int32): int32 =
    return WebLayoutEstimateTextRangeWidthWeightedFamily(text, startIndex, endIndex, fontSize, fontWeight, WebLayoutFontFamilySans)

@borrows
fn WebLayoutEstimateTextRangeWidthWeightedFamily(text: str, startIndex: int32, endIndex: int32, fontSize: int32, fontWeight: int32, fontFamily: int32): int32 =
    if __webLayoutFontFaceCount <= 0:
        return WebLayoutEstimateTextRangeWidthHeuristic(text, startIndex, endIndex, fontSize)
    if fontSize <= 0:
        fontSize = 16
    var width: int32
    var lineWidth: int32
    var i: int32 = startIndex
    if i < 0:
        i = 0
    var endAt: int32 = endIndex
    if endAt > text.len:
        endAt = text.len
    while i < endAt:
        let b0 = int32(text[i])
        var codepoint = 0
        var nextIndex = i + 1
        var decoded = true
        if b0 <= 127:
            codepoint = b0
        elif b0 >= 192 && b0 < 224:
            if i + 1 >= endAt || (int32(text[i + 1]) & 192) != 128:
                decoded = false
            else:
                let b1 = int32(text[i + 1])
                codepoint = ((b0 & 31) << 6) | (b1 & 63)
                nextIndex = i + 2
        elif b0 >= 224 && b0 < 240:
            if i + 2 >= endAt || (int32(text[i + 1]) & 192) != 128 || (int32(text[i + 2]) & 192) != 128:
                decoded = false
            else:
                let b1 = int32(text[i + 1])
                let b2 = int32(text[i + 2])
                codepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
                nextIndex = i + 3
        elif b0 >= 240 && b0 < 248:
            if i + 3 >= endAt || (int32(text[i + 1]) & 192) != 128 || (int32(text[i + 2]) & 192) != 128 || (int32(text[i + 3]) & 192) != 128:
                decoded = false
            else:
                let b1 = int32(text[i + 1])
                let b2 = int32(text[i + 2])
                let b3 = int32(text[i + 3])
                codepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
                nextIndex = i + 4
        else:
            decoded = false
        if !decoded:
            return -1
        if codepoint == 10:
            if lineWidth > width:
                width = lineWidth
            lineWidth = 0
        else:
            var glyphCodepoint = codepoint
            if codepoint == 13 || codepoint == 9:
                glyphCodepoint = 32
            let advance = WebLayoutMeasureCodepointWidthWeightedFamily(glyphCodepoint, fontSize, fontWeight, fontFamily)
            if advance < 0:
                return -1
            lineWidth = lineWidth + advance
        i = nextIndex
    if lineWidth > width:
        width = lineWidth
    return width

@borrows
fn WebLayoutEstimateTextWidthWeighted(text: str, fontSize: int32, fontWeight: int32): int32 =
    return WebLayoutEstimateTextRangeWidthWeighted(text, 0, text.len, fontSize, fontWeight)

@borrows
fn WebLayoutEstimateTextWidthWeightedFamily(text: str, fontSize: int32, fontWeight: int32, fontFamily: int32): int32 =
    return WebLayoutEstimateTextRangeWidthWeightedFamily(text, 0, text.len, fontSize, fontWeight, fontFamily)

fn WebLayoutTextMeasure(text: str, fontSize: int32): WebLayoutSize =
    var size: WebLayoutSize
    size.width = WebLayoutEstimateTextWidth(text, fontSize)
    size.height = fontSize
    return size

@borrows
fn WebLayoutEstimateTextWidth(text: str, fontSize: int32): int32 =
    return WebLayoutEstimateTextWidthWeighted(text, fontSize, 400)

fn WebLayoutEffectiveTextLineHeight(fontSize: int32, lineHeight: int32): int32 =
    if lineHeight > 0:
        return lineHeight
    if fontSize <= 0:
        return 20
    if lineHeight < 0:
        let scaled = 0 - lineHeight
        let result = (fontSize * scaled + 500) / 1000
        if result > 0:
            return result
        return 1
    return fontSize * 6 / 5

fn WebLayoutEffectiveTextLineHeightPx2(fontSize: int32, lineHeight: int32, lineHeightPx2: int32): int32 =
    if lineHeightPx2 > 0:
        return lineHeightPx2
    if lineHeight < 0:
        if fontSize <= 0:
            fontSize = 16
        let scaled = 0 - lineHeight
        let result = (fontSize * scaled * 2 + 500) / 1000
        if result > 0:
            return result
        return 1
    return WebLayoutEffectiveTextLineHeight(fontSize, lineHeight) * 2

# `line-height: normal` semantics: the browser derives the line box from the font's
# own vertical metrics (hhea ascender-descender+lineGap over unitsPerEm), NOT a fixed
# 1.2x. This mirrors RasterFontScaledLineHeightPx2 for a cascade face by index so the
# layout box height and the raster baseline agree on the same intrinsic value.
fn WebLayoutFaceIntrinsicLineHeightPx2(faceIndex: int32, fontSize: int32): int32 =
    if fontSize <= 0:
        return 0
    var loaded = false
    var unitsPerEm: int32
    var ascender: int32
    var descender: int32
    var lineGap: int32
    if faceIndex == 0:
        loaded = __webLayoutFontFace0.loaded
        unitsPerEm = __webLayoutFontFace0.unitsPerEm
        ascender = __webLayoutFontFace0.ascender
        descender = __webLayoutFontFace0.descender
        lineGap = __webLayoutFontFace0.lineGap
    elif faceIndex == 1:
        loaded = __webLayoutFontFace1.loaded
        unitsPerEm = __webLayoutFontFace1.unitsPerEm
        ascender = __webLayoutFontFace1.ascender
        descender = __webLayoutFontFace1.descender
        lineGap = __webLayoutFontFace1.lineGap
    elif faceIndex == 2:
        loaded = __webLayoutFontFace2.loaded
        unitsPerEm = __webLayoutFontFace2.unitsPerEm
        ascender = __webLayoutFontFace2.ascender
        descender = __webLayoutFontFace2.descender
        lineGap = __webLayoutFontFace2.lineGap
    elif faceIndex == 3:
        loaded = __webLayoutFontFace3.loaded
        unitsPerEm = __webLayoutFontFace3.unitsPerEm
        ascender = __webLayoutFontFace3.ascender
        descender = __webLayoutFontFace3.descender
        lineGap = __webLayoutFontFace3.lineGap
    elif faceIndex == 4:
        loaded = __webLayoutFontFace4.loaded
        unitsPerEm = __webLayoutFontFace4.unitsPerEm
        ascender = __webLayoutFontFace4.ascender
        descender = __webLayoutFontFace4.descender
        lineGap = __webLayoutFontFace4.lineGap
    elif faceIndex == 5:
        loaded = __webLayoutFontFace5.loaded
        unitsPerEm = __webLayoutFontFace5.unitsPerEm
        ascender = __webLayoutFontFace5.ascender
        descender = __webLayoutFontFace5.descender
        lineGap = __webLayoutFontFace5.lineGap
    elif faceIndex == 6:
        loaded = __webLayoutFontFace6.loaded
        unitsPerEm = __webLayoutFontFace6.unitsPerEm
        ascender = __webLayoutFontFace6.ascender
        descender = __webLayoutFontFace6.descender
        lineGap = __webLayoutFontFace6.lineGap
    elif faceIndex == 7:
        loaded = __webLayoutFontFace7.loaded
        unitsPerEm = __webLayoutFontFace7.unitsPerEm
        ascender = __webLayoutFontFace7.ascender
        descender = __webLayoutFontFace7.descender
        lineGap = __webLayoutFontFace7.lineGap
    else:
        return 0
    if !loaded || unitsPerEm <= 0:
        return 0
    let designHeight = ascender - descender + lineGap
    if designHeight <= 0:
        return 0
    return int32((int64(designHeight) * int64(fontSize) * 2 + int64(unitsPerEm / 2)) / int64(unitsPerEm))

# Browser line-box model for `normal`: the used line height is the max over the intrinsic
# line heights of every font actually used to render the text (each glyph resolved through
# the same cascade the measurement path uses). Returns 0 when no font is loaded or the text
# has no renderable glyph, so callers fall back to the legacy heuristic.
@borrows
fn WebLayoutNormalLineHeightPx2ForText(text: str, fontSize: int32, fontWeight: int32, fontFamily: int32): int32 =
    if fontSize <= 0:
        return 0
    if __webLayoutFontFaceCount <= 0:
        return 0
    var maxPx2: int32
    var i: int32
    while i < text.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebLayoutDecodeUtf8Codepoint(text, i, text.len, codepoint, nextIndex):
            return maxPx2
        if codepoint != 10 && codepoint != 13 && codepoint != 9 && codepoint != 32:
            var faceIndex: int32 = -1
            var glyphIndex: int32
            if WebLayoutFontCascadeSelectWeightedFamily(codepoint, fontWeight, fontFamily, faceIndex, glyphIndex):
                let px2 = WebLayoutFaceIntrinsicLineHeightPx2(faceIndex, fontSize)
                if px2 > maxPx2:
                    maxPx2 = px2
        i = nextIndex
    return maxPx2

@borrows
fn WebLayoutEffectiveTextLineHeightPx2ForText(fontSize: int32, lineHeight: int32, lineHeightPx2: int32,
                                              text: str, fontWeight: int32, fontFamily: int32): int32 =
    if lineHeightPx2 <= 0 && lineHeight == 0:
        let normalPx2 = WebLayoutNormalLineHeightPx2ForText(text, fontSize, fontWeight, fontFamily)
        if normalPx2 > 0:
            return normalPx2
    return WebLayoutEffectiveTextLineHeightPx2(fontSize, lineHeight, lineHeightPx2)

@borrows
fn WebLayoutEstimateTextHeightWithLineHeight(text: str, fontSize: int32, lineHeight: int32): int32 =
    if text.len == 0:
        return 0
    var lines: int32 = 1
    for i in 0..<text.len:
        if text[i] == '\n':
            lines = lines + 1
    return lines * WebLayoutEffectiveTextLineHeight(fontSize, lineHeight)

@borrows
fn WebLayoutEstimateTextHeightWithLineHeightPx2Family(text: str, fontSize: int32, lineHeight: int32, lineHeightPx2: int32,
                                                      fontWeight: int32, fontFamily: int32): int32 =
    if text.len == 0:
        return 0
    var lines: int32 = 1
    for i in 0..<text.len:
        if text[i] == '\n':
            lines = lines + 1
    return (lines * WebLayoutEffectiveTextLineHeightPx2ForText(fontSize, lineHeight, lineHeightPx2, text, fontWeight, fontFamily) + 1) / 2

@borrows
fn WebLayoutEstimateTextHeightWithLineHeightPx2(text: str, fontSize: int32, lineHeight: int32, lineHeightPx2: int32): int32 =
    return WebLayoutEstimateTextHeightWithLineHeightPx2Family(text, fontSize, lineHeight, lineHeightPx2, 400, WebLayoutFontFamilySans)

@borrows
fn WebLayoutEstimateTextHeight(text: str, fontSize: int32): int32 =
    return WebLayoutEstimateTextHeightWithLineHeight(text, fontSize, 0)

fn WebLayoutTreeAddStyle(tree: var WebLayoutTree, nodeId: int32, display: int32,
                         width: int32, height: int32, marginLeft: int32, marginTop: int32): bool =
    if tree.styles.len >= 16384:
        return false
    if !WebLayoutStyleSupported(display, width, height, marginLeft, marginTop):
        return false
    var style: WebLayoutStyleBox
    WebLayoutInitStyleBoxDefaults(style)
    add(tree.styles, style)
    let idx = tree.styles.len - 1
    tree.styles[idx].nodeId = nodeId
    tree.styles[idx].display = display
    tree.styles[idx].width = width
    tree.styles[idx].height = height
    tree.styles[idx].marginLeft = marginLeft
    tree.styles[idx].marginTop = marginTop
    tree.styles[idx].marginRight = 0
    tree.styles[idx].marginBottom = 0
    tree.nextNodeId = tree.nextNodeId + 1
    return true

fn WebLayoutTreeAddChildEdge(tree: var WebLayoutTree, parentNodeId: int32, childNodeId: int32): bool =
    if parentNodeId == childNodeId:
        return false
    if parentNodeId == childNodeId:
        return false
    if WebLayoutParentOf(tree, childNodeId) != 0:
        return false
    if WebLayoutIsAncestorOf(tree, childNodeId, parentNodeId):
        return false
    if tree.children.len >= 65536:
        return false
    var edge: WebLayoutChildEdge
    edge.parentNodeId = parentNodeId
    edge.childNodeId = childNodeId
    edge.ordinal = WebLayoutChildCount(tree, parentNodeId)
    add(tree.children, edge)
    return true

# Extend styleIndexByNodeId to cover every style added since the last sync.
# styles is append-only, so this is incremental O(newStyles) amortized O(1).
# First-write-wins preserves WebLayoutFindStyleIndex's first-match semantics.
fn WebLayoutEnsureStyleIndex(tree: var WebLayoutTree) =
    while tree.styleIndexSynced < tree.styles.len:
        let nid = tree.styles[tree.styleIndexSynced].nodeId
        if nid >= 0:
            while tree.styleIndexByNodeId.len <= nid:
                add(tree.styleIndexByNodeId, 0)
            if tree.styleIndexByNodeId[nid] == 0:
                tree.styleIndexByNodeId[nid] = tree.styleIndexSynced + 1
        tree.styleIndexSynced = tree.styleIndexSynced + 1

# Extend parentByChildNodeId + childCountByParentNodeId to cover every child
# edge added since the last sync (append-only, incremental).
fn WebLayoutEnsureChildIndex(tree: var WebLayoutTree) =
    while tree.childIndexSynced < tree.children.len:
        let childNodeId = tree.children[tree.childIndexSynced].childNodeId
        let parentNodeId = tree.children[tree.childIndexSynced].parentNodeId
        if childNodeId >= 0:
            while tree.parentByChildNodeId.len <= childNodeId:
                add(tree.parentByChildNodeId, 0)
            if tree.parentByChildNodeId[childNodeId] == 0:
                tree.parentByChildNodeId[childNodeId] = parentNodeId
        if parentNodeId >= 0:
            while tree.childCountByParentNodeId.len <= parentNodeId:
                add(tree.childCountByParentNodeId, 0)
            tree.childCountByParentNodeId[parentNodeId] = tree.childCountByParentNodeId[parentNodeId] + 1
        tree.childIndexSynced = tree.childIndexSynced + 1

fn WebLayoutFindStyleIndex(tree: var WebLayoutTree, nodeId: int32): int32 =
    WebLayoutEnsureStyleIndex(tree)
    if nodeId >= 0 && nodeId < tree.styleIndexByNodeId.len:
        let mapped = tree.styleIndexByNodeId[nodeId]
        if mapped > 0:
            return mapped - 1
        # 0 = confirmed absent (sync covers all styles): skip the linear scan.
        return -1
    return -1

fn WebLayoutNodeExists(tree: var WebLayoutTree, nodeId: int32): bool =
    if WebLayoutFindStyleIndex(tree, nodeId) >= 0:
        return true
    // Document nodes don't have style boxes but exist if they have children
    return WebLayoutChildCount(tree, nodeId) > 0

fn WebLayoutChildCount(tree: var WebLayoutTree, parentNodeId: int32): int32 =
    WebLayoutEnsureChildIndex(tree)
    if parentNodeId >= 0 && parentNodeId < tree.childCountByParentNodeId.len:
        return tree.childCountByParentNodeId[parentNodeId]
    return 0

fn WebLayoutParentOf(tree: var WebLayoutTree, childNodeId: int32): int32 =
    WebLayoutEnsureChildIndex(tree)
    if childNodeId >= 0 && childNodeId < tree.parentByChildNodeId.len:
        return tree.parentByChildNodeId[childNodeId]
    return 0

fn WebLayoutIsAncestorOf(tree: var WebLayoutTree, ancestorNodeId: int32, nodeId: int32): bool =
    if ancestorNodeId == 0 || nodeId == 0:
        return false
    var current = WebLayoutParentOf(tree, nodeId)
    var steps = 0
    while current != 0:
        if current == ancestorNodeId:
            return true
        steps = steps + 1
        if steps > tree.styles.len:
            return true
        current = WebLayoutParentOf(tree, current)
    return false

fn WebLayoutAppendChild(tree: var WebLayoutTree, parentNodeId: int32, childNodeId: int32): bool =
    if parentNodeId == childNodeId:
        return false
    # Prevent duplicate parent (a node can have at most one parent)
    if WebLayoutParentOf(tree, childNodeId) != 0:
        return false
    # Prevent cycles: adding childNodeId under parentNodeId creates a cycle
    # if childNodeId is already an ancestor of parentNodeId.
    if WebLayoutIsAncestorOf(tree, childNodeId, parentNodeId):
        return false
    let edge: WebLayoutChildEdge
    edge.parentNodeId = parentNodeId
    edge.childNodeId = childNodeId
    edge.ordinal = WebLayoutChildCount(tree, parentNodeId)
    add(tree.children, edge)
    return true

fn WebLayoutChildAt(tree: var WebLayoutTree, parentNodeId: int32, ordinal: int32): int32 =
    for i in 0..<tree.children.len:
        if tree.children[i].parentNodeId == parentNodeId && tree.children[i].ordinal == ordinal:
            return tree.children[i].childNodeId
    return 0

fn WebLayoutVisitedNode(tree: var WebLayoutTree, nodeId: int32): bool =
    for i in 0..<tree.visitedNodeIds.len:
        if tree.visitedNodeIds[i] == nodeId:
            return true
    return false

fn WebLayoutMarkVisitedNode(tree: var WebLayoutTree, nodeId: int32): bool =
    if WebLayoutVisitedNode(tree, nodeId):
        return false
    add(tree.visitedNodeIds, nodeId)
    return true

fn WebLayoutStyleIsInlineFlow(tree: var WebLayoutTree, styleIdx: int32): bool =
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return false
    return tree.styles[styleIdx].display == WebLayoutDisplayInline || tree.styles[styleIdx].inlineLevel

fn WebLayoutPurgeBoxesForNode(tree: var WebLayoutTree, nodeId: int32) =
    var hasNodeBox = false
    for i in 0..<tree.boxes.len:
        if tree.boxes[i].nodeId == nodeId:
            hasNodeBox = true
            break
    if !hasNodeBox:
        return
    var kept: WebLayoutBox[]
    for i in 0..<tree.boxes.len:
        if tree.boxes[i].nodeId != nodeId:
            add(kept, tree.boxes[i])
    tree.boxes = kept
    # The box index cache (firstBoxIndexByNodeId/visibleBoxIndexByNodeId) is
    # only invalidated by comparing tree.boxes.len against boxIndexSynced. A
    # purge-then-append can leave tree.boxes.len unchanged from the last synced
    # value (e.g. one stale record purged, one fresh one appended), which would
    # silently leave the cache stale. Force invalidation explicitly.
    tree.boxIndexSynced = -1


fn WebLayoutRecordBox(tree: var WebLayoutTree, nodeId: int32, x: int32, y: int32,
                      width: int32, height: int32) =
    tree.boxCount = tree.boxCount + 1

    if tree.boxes.len >= 16384:
        return
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    let isFragmentCapable = styleIdx >= 0 && WebLayoutStyleIsInlineFlow(tree, styleIdx)
    var box: WebLayoutBox
    box.nodeId = nodeId
    box.x = x
    box.y = y
    box.width = width
    box.height = height
    box.xPx2 = x * 2
    box.yPx2 = y * 2
    box.widthPx2 = width * 2
    box.heightPx2 = height * 2
    box.position = WebLayoutPositionStatic
    box.zIndex = 0
    # Read style fields directly from the layout tree.
    if styleIdx >= 0:
        box.position = tree.styles[styleIdx].position
        box.zIndex = tree.styles[styleIdx].zIndex
        box.offsetTop = tree.styles[styleIdx].offsetTop
        box.offsetRight = tree.styles[styleIdx].offsetRight
        box.offsetBottom = tree.styles[styleIdx].offsetBottom
        box.offsetLeft = tree.styles[styleIdx].offsetLeft
        box.visible = tree.styles[styleIdx].visible
        box.overflowX = tree.styles[styleIdx].overflowX
        box.overflowY = tree.styles[styleIdx].overflowY
        box.clipContent = box.overflowX != WebLayoutOverflowVisible || box.overflowY != WebLayoutOverflowVisible
        box.opacity = tree.styles[styleIdx].opacity
        if tree.styles[styleIdx].position == WebLayoutPositionSticky:
            if width > 0 && tree.styles[styleIdx].width <= 0:
                tree.styles[styleIdx].width = width
            if height > 0 && tree.styles[styleIdx].height <= 0:
                tree.styles[styleIdx].height = height
    else:
        box.offsetTop = 0
        box.offsetRight = 0
        box.offsetBottom = 0
        box.offsetLeft = 0
        box.visible = true
        box.overflowX = WebLayoutOverflowVisible
        box.overflowY = WebLayoutOverflowVisible
        box.clipContent = false
        box.opacity = 255
    if isFragmentCapable:
        # Inline-flow nodes (text) legitimately emit multiple box fragments
        # (one per wrapped line/word) within a single layout pass, recorded
        # back-to-back. A fragment run for a node is only ever interrupted
        # once that pass finishes; a later, independent pass touching the
        # same node again (e.g. after a reflow) starts a new run. Detect the
        # pass boundary structurally: if the immediately preceding box record
        # is not this node's own fragment run, any earlier records for this
        # nodeId are stale leftovers from a prior pass and must be purged
        # before this pass's first fragment is appended -- otherwise old and
        # new line boxes would coexist as phantom hit-test targets.
        let lastIdx = tree.boxes.len - 1
        let continuesRun = lastIdx >= 0 && tree.boxes[lastIdx].nodeId == nodeId
        if !continuesRun:
            WebLayoutPurgeBoxesForNode(tree, nodeId)
        add(tree.boxes, box)
        return
    if nodeId < 0:
        add(tree.boxes, box)
        return
    # Non-inline (block/flex/grid/table/etc.) nodes own exactly one canonical
    # box slot. Mirror WebLayoutFindBestBoxIndex's own "first visible, else
    # first" selection rule incrementally as records come in, so paint (which
    # picks one record via that rule) and hit-test (which used to keep every
    # duplicate) always agree on the very same geometry. blockBoxIndexByNodeId
    # gives this O(1) amortized instead of a linear tree.boxes scan per call.
    while tree.blockBoxIndexByNodeId.len <= nodeId:
        add(tree.blockBoxIndexByNodeId, 0)
    let existingSlot = tree.blockBoxIndexByNodeId[nodeId]
    if existingSlot > 0:
        let existingIdx = existingSlot - 1
        let existingBox = tree.boxes[existingIdx]
        let existingVisible = existingBox.visible && existingBox.width > 0 && existingBox.height > 0
        if existingVisible:
            # The kept record already satisfies "first visible" -- this new
            # record is a stale re-layout duplicate and is discarded.
            return
        # The kept record isn't visible; this new one becomes the record at
        # that same slot (in place, so array order/other cached indices for
        # other nodes are undisturbed).
        tree.boxes[existingIdx] = box
        tree.boxIndexSynced = -1
        return
    add(tree.boxes, box)
    tree.blockBoxIndexByNodeId[nodeId] = tree.boxes.len

fn WebLayoutRecordTextBox(tree: var WebLayoutTree, nodeId: int32, x: int32, y: int32,
                          width: int32, height: int32, textStart: int32, textStop: int32) =
    let before = tree.boxes.len
    WebLayoutRecordBox(tree, nodeId, x, y, width, height)
    if tree.boxes.len > before:
        let idx = tree.boxes.len - 1
        tree.boxes[idx].textStart = textStart
        tree.boxes[idx].textStop = textStop

fn WebLayoutRecordTextBoxPx2(tree: var WebLayoutTree, nodeId: int32, xPx2: int32, yPx2: int32,
                             widthPx2: int32, heightPx2: int32, textStart: int32, textStop: int32) =
    let x = xPx2 / 2
    let y = yPx2 / 2
    let width = (widthPx2 + 1) / 2
    let height = (heightPx2 + 1) / 2
    let before = tree.boxes.len
    WebLayoutRecordBox(tree, nodeId, x, y, width, height)
    if tree.boxes.len > before:
        let idx = tree.boxes.len - 1
        tree.boxes[idx].xPx2 = xPx2
        tree.boxes[idx].yPx2 = yPx2
        tree.boxes[idx].widthPx2 = widthPx2
        tree.boxes[idx].heightPx2 = heightPx2
        tree.boxes[idx].textStart = textStart
        tree.boxes[idx].textStop = textStop

fn WebLayoutApplyInlineLineTextAlign(tree: var WebLayoutTree,
                                     firstBoxIndex: int32,
                                     textAlign: int32,
                                     contentX: int32,
                                     contentWidth: int32) =
    if firstBoxIndex < 0 || firstBoxIndex >= tree.boxes.len:
        return
    if textAlign == WebLayoutTextAlignLeft:
        return
    if contentWidth <= 0:
        return
    var minX: int32
    minX = tree.boxes[firstBoxIndex].x
    var maxRight: int32
    maxRight = tree.boxes[firstBoxIndex].x
    maxRight = maxRight + tree.boxes[firstBoxIndex].width
    var bi: int32
    bi = firstBoxIndex + 1
    while bi < tree.boxes.len:
        if tree.boxes[bi].x < minX:
            minX = tree.boxes[bi].x
        var right: int32
        right = tree.boxes[bi].x
        right = right + tree.boxes[bi].width
        if right > maxRight:
            maxRight = right
        bi = bi + 1
    if maxRight <= minX:
        return
    var lineWidth: int32
    lineWidth = maxRight - minX
    var targetX: int32
    targetX = contentX
    if textAlign == WebLayoutTextAlignCenter:
        var extra: int32
        extra = contentWidth - lineWidth
        extra = extra / 2
        targetX = contentX + extra
    elif textAlign == WebLayoutTextAlignRight:
        targetX = contentX + contentWidth
        targetX = targetX - lineWidth
    var dx: int32
    dx = targetX - minX
    if dx == 0:
        return
    for bi in firstBoxIndex..<tree.boxes.len:
        tree.boxes[bi].x = tree.boxes[bi].x + dx

@borrows
fn WebLayoutDecodeUtf8Codepoint(text: str, startIndex: int32, endIndex: int32,
                                outCodepoint: var int32, outNextIndex: var int32): bool =
    outCodepoint = 0
    outNextIndex = startIndex
    if startIndex < 0 || startIndex >= text.len:
        return false
    var endAt: int32
    endAt = endIndex
    if endAt > text.len:
        endAt = text.len
    if startIndex >= endAt:
        return false
    let b0 = int32(text[startIndex])
    if b0 <= 127:
        outCodepoint = b0
        outNextIndex = startIndex + 1
        return true
    if b0 >= 192 && b0 < 224:
        if startIndex + 1 >= endAt || (int32(text[startIndex + 1]) & 192) != 128:
            return false
        let b1 = int32(text[startIndex + 1])
        outCodepoint = ((b0 & 31) << 6) | (b1 & 63)
        outNextIndex = startIndex + 2
        return true
    if b0 >= 224 && b0 < 240:
        if startIndex + 2 >= endAt || (int32(text[startIndex + 1]) & 192) != 128 || (int32(text[startIndex + 2]) & 192) != 128:
            return false
        let b1 = int32(text[startIndex + 1])
        let b2 = int32(text[startIndex + 2])
        outCodepoint = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
        outNextIndex = startIndex + 3
        return true
    if b0 >= 240 && b0 < 248:
        if startIndex + 3 >= endAt || (int32(text[startIndex + 1]) & 192) != 128 || (int32(text[startIndex + 2]) & 192) != 128 || (int32(text[startIndex + 3]) & 192) != 128:
            return false
        let b1 = int32(text[startIndex + 1])
        let b2 = int32(text[startIndex + 2])
        let b3 = int32(text[startIndex + 3])
        outCodepoint = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
        outNextIndex = startIndex + 4
        return true
    return false

fn WebLayoutIsCjkLineBreakCodepoint(codepoint: int32): bool =
    if codepoint >= 0x3400 && codepoint <= 0x4DBF:
        return true
    if codepoint >= 0x4E00 && codepoint <= 0x9FFF:
        return true
    if codepoint >= 0xF900 && codepoint <= 0xFAFF:
        return true
    return false

fn WebLayoutIsInlineTextSeparator(codepoint: int32): bool =
    return codepoint == 9 || codepoint == 13 || codepoint == 32

@borrows
fn WebLayoutLayoutInlineWords(tree: var WebLayoutTree, nodeId: int32,
                               text: str, fontSize: int32, lineHeight: int32, fontWeight: int32, gap: int32,
                               fontFamily: int32,
                               breakAll: bool,
                               startX: int32, startY: int32, parentRight: int32,
                               textAlign: int32, contentWidth: int32,
                               minLineHeight: int32,
                               minLineHeightPx2: int32,
                               lineBoxStart: var int32,
                               ioX: var int32, ioY: var int32,
                               ioLineHeight: var int32,
                               ioY2: var int32,
                               ioLineHeight2: var int32) =
    if fontSize <= 0:
        fontSize = 16
    var lineHeightPx2: int32
    let textStyleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if textStyleIdx >= 0:
        lineHeightPx2 = tree.styles[textStyleIdx].lineHeightPx2
    var textMeasW: int32
    var textEstFull: int32
    if textStyleIdx >= 0 && text.len > 0:
        textMeasW = tree.styles[textStyleIdx].width
        if textMeasW > 0:
            textEstFull = WebLayoutEstimateTextRangeWidthWeightedFamily(text, 0, text.len, fontSize, fontWeight, fontFamily)
            if textEstFull <= 0 || textMeasW > textEstFull * 8:
                textEstFull = 0
    let wordH2 = WebLayoutEffectiveTextLineHeightPx2ForText(fontSize, lineHeight, lineHeightPx2, text, fontWeight, fontFamily)
    let wordH = (wordH2 + 1) / 2
    var i: int32
    while i < text.len:
        var codepoint: int32
        var nextIndex: int32
        if !WebLayoutDecodeUtf8Codepoint(text, i, text.len, codepoint, nextIndex):
            return
        if codepoint == 10:
            if lineBoxStart >= 0:
                WebLayoutApplyInlineLineTextAlign(tree, lineBoxStart, textAlign, startX, contentWidth)
            if ioLineHeight2 > 0:
                ioY2 = ioY2 + ioLineHeight2
            else:
                ioY2 = ioY2 + wordH2
            ioY = ioY2 / 2
            ioX = startX
            ioLineHeight = 0
            ioLineHeight2 = 0
            lineBoxStart = -1
            i = nextIndex
            continue
        var segmentStart: int32
        var segmentStop: int32
        segmentStart = i
        segmentStop = nextIndex
        if !breakAll && !WebLayoutIsCjkLineBreakCodepoint(codepoint) && !WebLayoutIsInlineTextSeparator(codepoint):
            var scan: int32
            scan = nextIndex
            var keepScanning = true
            while keepScanning && scan < text.len:
                var scanCodepoint: int32
                var scanNext: int32
                if !WebLayoutDecodeUtf8Codepoint(text, scan, text.len, scanCodepoint, scanNext):
                    return
                if scanCodepoint == 10 || WebLayoutIsInlineTextSeparator(scanCodepoint) || WebLayoutIsCjkLineBreakCodepoint(scanCodepoint):
                    keepScanning = false
                else:
                    segmentStop = scanNext
                    scan = scanNext
        var segmentW = WebLayoutEstimateTextRangeWidthWeightedFamily(text, segmentStart, segmentStop, fontSize, fontWeight, fontFamily)
        if textEstFull > 0 && textMeasW < textEstFull:
            segmentW = (segmentW * textMeasW + textEstFull / 2) / textEstFull
        if segmentW > 0:
            if WebLayoutIsInlineTextSeparator(codepoint) && ioX == startX && ioLineHeight == 0:
                i = segmentStop
                continue
            if ioX + segmentW > parentRight && ioLineHeight > 0:
                WebLayoutApplyInlineLineTextAlign(tree, lineBoxStart, textAlign, startX, contentWidth)
                ioX = startX
                if ioLineHeight2 > 0:
                    ioY2 = ioY2 + ioLineHeight2
                else:
                    ioY2 = ioY2 + ioLineHeight * 2
                ioY = ioY2 / 2
                ioLineHeight = 0
                ioLineHeight2 = 0
                lineBoxStart = -1
                if WebLayoutIsInlineTextSeparator(codepoint):
                    i = segmentStop
                    continue
            if lineBoxStart < 0:
                lineBoxStart = tree.boxes.len
            WebLayoutRecordTextBoxPx2(tree, nodeId, ioX * 2, ioY2, segmentW * 2, wordH2, segmentStart, segmentStop)
            ioX = ioX + segmentW + gap
            if minLineHeight > ioLineHeight:
                ioLineHeight = minLineHeight
            if wordH > ioLineHeight:
                ioLineHeight = wordH
            if minLineHeightPx2 > ioLineHeight2:
                ioLineHeight2 = minLineHeightPx2
            if wordH2 > ioLineHeight2:
                ioLineHeight2 = wordH2
        i = segmentStop

fn WebLayoutGridTrackCount(tree: var WebLayoutTree, nodeId: int32, kind: int32): int32 =
    var count: int32
    for i in 0..<tree.gridTracks.len:
        if tree.gridTracks[i].nodeId == nodeId && tree.gridTracks[i].kind == kind:
            count = count + 1
    return count

fn WebLayoutIntrinsicWidth(tree: var WebLayoutTree, nodeId: int32,
                           parentWidth: int32, depth: int32): int32 =
    if depth > 24:
        return 0
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return 0
    if tree.styles[styleIdx].display == WebLayoutDisplayNone:
        return 0
    if tree.styles[styleIdx].width > 0:
        return tree.styles[styleIdx].width
    // Percentage widths (width < 0) are deliberately NOT resolved against parentWidth
    // here: in intrinsic/max-content sizing a parent-relative percentage is cyclic and
    // behaves as auto (content-based). Resolving it against the passed-down available
    // width inflated w-auto flex chains (e.g. a width:100% truncate label ballooning
    // its parent button past the viewport).
    var contentWidth: int32
    if tree.styles[styleIdx].textContent.len > 0:
        contentWidth = WebLayoutEstimateTextWidthWeightedFamily(tree.styles[styleIdx].textContent, tree.styles[styleIdx].fontSize, tree.styles[styleIdx].renderFontWeight, tree.styles[styleIdx].fontFamily)
    let childCount = WebLayoutChildCount(tree, nodeId)
    if childCount > 0:
        let isFlexRow = tree.styles[styleIdx].display == WebLayoutDisplayFlex &&
            (tree.styles[styleIdx].flexDirection == 0 || tree.styles[styleIdx].flexDirection == WebLayoutFlexDirectionRow)
        let isFlexColumn = tree.styles[styleIdx].display == WebLayoutDisplayFlex &&
            tree.styles[styleIdx].flexDirection == WebLayoutFlexDirectionColumn
        var childTotalWidth: int32
        var childMaxWidth: int32
        var visibleChildren: int32
        var inlineFlowChildren = true
        for ordinal in 0..<childCount:
            let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
            if childNodeId == 0:
                continue
            let childStyleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if childStyleIdx < 0:
                continue
            if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
                continue
            if tree.styles[childStyleIdx].position == WebLayoutPositionAbsolute || tree.styles[childStyleIdx].position == WebLayoutPositionFixed:
                continue
            if !WebLayoutStyleIsInlineFlow(tree, childStyleIdx):
                inlineFlowChildren = false
            let childWidth = WebLayoutIntrinsicWidth(tree, childNodeId, parentWidth, depth + 1)
            if childWidth <= 0:
                continue
            visibleChildren = visibleChildren + 1
            let childOuterWidth = childWidth + tree.styles[childStyleIdx].marginLeft + tree.styles[childStyleIdx].marginRight
            if childOuterWidth > childMaxWidth:
                childMaxWidth = childOuterWidth
            childTotalWidth = childTotalWidth + childOuterWidth
        if isFlexRow:
            contentWidth = childTotalWidth
            if visibleChildren > 1:
                contentWidth = contentWidth + tree.styles[styleIdx].gap * (visibleChildren - 1)
        elif isFlexColumn:
            contentWidth = childMaxWidth
        elif tree.styles[styleIdx].display == WebLayoutDisplayInline || inlineFlowChildren:
            contentWidth = childTotalWidth
        else:
            contentWidth = childMaxWidth
    var result = contentWidth + tree.styles[styleIdx].borderLeftWidth + tree.styles[styleIdx].borderRightWidth + tree.styles[styleIdx].paddingLeft + tree.styles[styleIdx].paddingRight
    if tree.styles[styleIdx].minWidth > 0 && result < tree.styles[styleIdx].minWidth:
        result = tree.styles[styleIdx].minWidth
    if tree.styles[styleIdx].maxWidth > 0 && result > tree.styles[styleIdx].maxWidth:
        result = tree.styles[styleIdx].maxWidth
    return result

fn WebLayoutIntrinsicHeight(tree: var WebLayoutTree, nodeId: int32,
                            parentWidth: int32, depth: int32): int32 =
    if depth > 24:
        return 0
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return 0
    if tree.styles[styleIdx].display == WebLayoutDisplayNone:
        return 0
    if tree.styles[styleIdx].height > 0:
        return tree.styles[styleIdx].height
    var contentHeight: int32
    let resolvedWidth = WebLayoutResolvedWidth(tree, styleIdx, parentWidth)
    let ratioHeight = WebLayoutAspectRatioHeightForWidth(tree, styleIdx, resolvedWidth)
    if ratioHeight > contentHeight:
        contentHeight = ratioHeight
    if tree.styles[styleIdx].textContent.len > 0:
        let textHeight = WebLayoutEstimateTextHeightWithLineHeightPx2Family(tree.styles[styleIdx].textContent, tree.styles[styleIdx].fontSize, tree.styles[styleIdx].lineHeight, tree.styles[styleIdx].lineHeightPx2, tree.styles[styleIdx].renderFontWeight, tree.styles[styleIdx].fontFamily)
        if textHeight > contentHeight:
            contentHeight = textHeight
    let childCount = WebLayoutChildCount(tree, nodeId)
    if childCount > 0:
        let isFlexRow = tree.styles[styleIdx].display == WebLayoutDisplayFlex &&
            (tree.styles[styleIdx].flexDirection == 0 || tree.styles[styleIdx].flexDirection == WebLayoutFlexDirectionRow)
        let isGrid = tree.styles[styleIdx].display == WebLayoutDisplayGrid
        var childTotal: int32
        var childMax: int32
        var visibleChildren: int32
        var inlineFlowChildren = true
        var gridRowHeights: int32[]
        var gridColCount = WebLayoutGridTrackCount(tree, nodeId, 0)
        if gridColCount <= 0:
            gridColCount = 1
        for ordinal in 0..<childCount:
            let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
            if childNodeId == 0:
                continue
            let childStyleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if childStyleIdx < 0:
                continue
            if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
                continue
            if tree.styles[childStyleIdx].position == WebLayoutPositionAbsolute || tree.styles[childStyleIdx].position == WebLayoutPositionFixed:
                continue
            if !WebLayoutStyleIsInlineFlow(tree, childStyleIdx):
                inlineFlowChildren = false
            let childHeight = WebLayoutIntrinsicHeight(tree, childNodeId, parentWidth, depth + 1)
            if childHeight <= 0:
                continue
            let childOuterHeight = childHeight + tree.styles[childStyleIdx].marginTop + tree.styles[childStyleIdx].marginBottom
            if isGrid:
                let rowIndex = visibleChildren / gridColCount
                while gridRowHeights.len <= rowIndex:
                    add(gridRowHeights, 0)
                if childOuterHeight > gridRowHeights[rowIndex]:
                    gridRowHeights[rowIndex] = childOuterHeight
                visibleChildren = visibleChildren + 1
                continue
            visibleChildren = visibleChildren + 1
            if childOuterHeight > childMax:
                childMax = childOuterHeight
            childTotal = childTotal + childOuterHeight
        if isFlexRow:
            contentHeight = childMax
        elif isGrid:
            contentHeight = 0
            for rowIndex in 0..<gridRowHeights.len:
                contentHeight = contentHeight + gridRowHeights[rowIndex]
            if gridRowHeights.len > 1:
                contentHeight = contentHeight + tree.styles[styleIdx].gap * (gridRowHeights.len - 1)
        elif tree.styles[styleIdx].display == WebLayoutDisplayInline || inlineFlowChildren:
            contentHeight = childMax
        else:
            contentHeight = childTotal
            if visibleChildren > 1:
                contentHeight = contentHeight + tree.styles[styleIdx].gap * (visibleChildren - 1)
    var result = contentHeight + tree.styles[styleIdx].borderTopWidth + tree.styles[styleIdx].borderBottomWidth + tree.styles[styleIdx].paddingTop + tree.styles[styleIdx].paddingBottom
    if tree.styles[styleIdx].minHeight > 0 && result < tree.styles[styleIdx].minHeight:
        result = tree.styles[styleIdx].minHeight
    if tree.styles[styleIdx].maxHeight > 0 && result > tree.styles[styleIdx].maxHeight:
        result = tree.styles[styleIdx].maxHeight
    return result

fn WebLayoutGridLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                               parentX: int32, parentY: int32,
                               parentWidth: int32, parentHeight: int32,
                               childIds: int32[]): bool =
    if childIds.len == 0:
        return true
    let parentStyleIdx = WebLayoutFindStyleIndex(tree, parentNodeId)
    if parentStyleIdx < 0:
        return false
    let parentGap = tree.styles[parentStyleIdx].gap

    # Count columns and rows
    var nCols: int32
    var nRows: int32
    var ti: int32
    while ti < tree.gridTracks.len:
        if tree.gridTracks[ti].nodeId == parentNodeId:
            if tree.gridTracks[ti].kind == 0:
                nCols = nCols + 1
            else:
                nRows = nRows + 1
        ti = ti + 1

    # Compute column widths
    var colWidths: int32[]
    var totalColTrackSpace: int32
    totalColTrackSpace = WebLayoutGridTrackSpace(parentWidth, nCols, parentGap)
    var remainingCol: int32
    remainingCol = totalColTrackSpace
    var colFr: int32
    var colPercentUsed: int32
    var ci: int32
    while ci < tree.gridTracks.len:
        if tree.gridTracks[ci].nodeId == parentNodeId && tree.gridTracks[ci].kind == 0:
            if tree.gridTracks[ci].unit == 0:
                var sz = tree.gridTracks[ci].size
                if sz > remainingCol:
                    sz = remainingCol
                add(colWidths, sz)
                remainingCol = remainingCol - sz
            elif tree.gridTracks[ci].unit == 2:
                let beforePercent = colPercentUsed
                colPercentUsed = colPercentUsed + tree.gridTracks[ci].size
                if colPercentUsed > 100:
                    colPercentUsed = 100
                var sz = WebLayoutGridRoundedShare(totalColTrackSpace, beforePercent, colPercentUsed, 100)
                if sz > remainingCol:
                    sz = remainingCol
                add(colWidths, sz)
                remainingCol = remainingCol - sz
            else:
                add(colWidths, 0)
                colFr = colFr + tree.gridTracks[ci].size
        ci = ci + 1
    # Distribute remaining space to fr columns
    if colFr > 0 && remainingCol > 0:
        var dci: int32
        var colIdx: int32
        var colFrUsed: int32
        while dci < tree.gridTracks.len:
            if tree.gridTracks[dci].nodeId == parentNodeId && tree.gridTracks[dci].kind == 0:
                if tree.gridTracks[dci].unit == 1:
                    let beforeFr = colFrUsed
                    colFrUsed = colFrUsed + tree.gridTracks[dci].size
                    colWidths[colIdx] = WebLayoutGridRoundedShare(remainingCol, beforeFr, colFrUsed, colFr)
                colIdx = colIdx + 1
            dci = dci + 1

    # Compute row heights
    var rowHeights: int32[]
    var totalRowTrackSpace: int32
    totalRowTrackSpace = WebLayoutGridTrackSpace(parentHeight, nRows, parentGap)
    var remainingRow: int32
    remainingRow = totalRowTrackSpace
    var rowFr: int32
    var rowPercentUsed: int32
    var ri: int32
    while ri < tree.gridTracks.len:
        if tree.gridTracks[ri].nodeId == parentNodeId && tree.gridTracks[ri].kind == 1:
            if tree.gridTracks[ri].unit == 0:
                var sz = tree.gridTracks[ri].size
                if sz > remainingRow:
                    sz = remainingRow
                add(rowHeights, sz)
                remainingRow = remainingRow - sz
            elif tree.gridTracks[ri].unit == 2:
                let beforePercent = rowPercentUsed
                rowPercentUsed = rowPercentUsed + tree.gridTracks[ri].size
                if rowPercentUsed > 100:
                    rowPercentUsed = 100
                var sz = WebLayoutGridRoundedShare(totalRowTrackSpace, beforePercent, rowPercentUsed, 100)
                if sz > remainingRow:
                    sz = remainingRow
                add(rowHeights, sz)
                remainingRow = remainingRow - sz
            else:
                add(rowHeights, 0)
                rowFr = rowFr + tree.gridTracks[ri].size
        ri = ri + 1
    if rowFr > 0 && remainingRow > 0:
        var dri: int32
        var rowIdx: int32
        var rowFrUsed: int32
        while dri < tree.gridTracks.len:
            if tree.gridTracks[dri].nodeId == parentNodeId && tree.gridTracks[dri].kind == 1:
                if tree.gridTracks[dri].unit == 1:
                    let beforeFr = rowFrUsed
                    rowFrUsed = rowFrUsed + tree.gridTracks[dri].size
                    rowHeights[rowIdx] = WebLayoutGridRoundedShare(remainingRow, beforeFr, rowFrUsed, rowFr)
                rowIdx = rowIdx + 1
            dri = dri + 1

    let nc = colWidths.len
    let nr = rowHeights.len
    if nc == 0:
        add(colWidths, parentWidth)
    if nr == 0:
        var autoRowCount = childIds.len
        if colWidths.len > 0:
            autoRowCount = (childIds.len + colWidths.len - 1) / colWidths.len
        if autoRowCount <= 0:
            autoRowCount = 1
        if parentHeight > 0:
            var autoParentHeight = parentHeight
            if autoRowCount > 1:
                let autoGapTotal = parentGap * (autoRowCount - 1)
                if autoGapTotal < autoParentHeight:
                    autoParentHeight = autoParentHeight - autoGapTotal
                else:
                    autoParentHeight = 0
            var autoRowHeight = autoParentHeight
            if autoRowCount > 0:
                autoRowHeight = autoParentHeight / autoRowCount
            for _ in 0..<autoRowCount:
                add(rowHeights, autoRowHeight)
        else:
            for _ in 0..<autoRowCount:
                add(rowHeights, 0)
            for ordinal in 0..<childIds.len:
                let childNodeId = childIds[ordinal]
                if childNodeId == 0:
                    continue
                let childStyleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if childStyleIdx < 0:
                    continue
                if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
                    WebLayoutFixDisplay(tree, childNodeId)
                if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
                    continue
                if tree.styles[childStyleIdx].position == WebLayoutPositionAbsolute || tree.styles[childStyleIdx].position == WebLayoutPositionFixed:
                    continue
                var intrinsicW = parentWidth
                let intrinsicCol = ordinal % colWidths.len
                if intrinsicCol < colWidths.len:
                    intrinsicW = colWidths[intrinsicCol]
                let intrinsicRow = ordinal / colWidths.len
                if intrinsicRow < rowHeights.len:
                    var intrinsicH = WebLayoutIntrinsicHeight(tree, childNodeId, intrinsicW, 0)
                    intrinsicH = intrinsicH + tree.styles[childStyleIdx].marginTop + tree.styles[childStyleIdx].marginBottom
                    if intrinsicH > rowHeights[intrinsicRow]:
                        rowHeights[intrinsicRow] = intrinsicH
    let effectiveCols = colWidths.len
    let effectiveRows = rowHeights.len
    if effectiveCols == 0 || effectiveRows == 0:
        return true

    # Place children into grid cells
    for currentOrdinal in 0..<childIds.len:
        let childNodeId = childIds[currentOrdinal]
        if childNodeId == 0:
            continue
        let childStyleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if childStyleIdx < 0:
            continue
        if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
            WebLayoutFixDisplay(tree, childNodeId)
        if tree.styles[childStyleIdx].display == WebLayoutDisplayNone:
            continue
        if tree.styles[childStyleIdx].position == WebLayoutPositionAbsolute || tree.styles[childStyleIdx].position == WebLayoutPositionFixed:
            continue
        let gridCol = currentOrdinal % effectiveCols
        let gridRow = currentOrdinal / effectiveCols
        var cellXOffset = 0
        var colOffsetIndex: int32
        while colOffsetIndex < gridCol && colOffsetIndex < effectiveCols:
            cellXOffset = cellXOffset + colWidths[colOffsetIndex] + parentGap
            colOffsetIndex = colOffsetIndex + 1
        var cellYOffset = 0
        var rowOffsetIndex: int32
        while rowOffsetIndex < gridRow && rowOffsetIndex < effectiveRows:
            cellYOffset = cellYOffset + rowHeights[rowOffsetIndex] + parentGap
            rowOffsetIndex = rowOffsetIndex + 1
        var cellW = parentWidth
        if gridCol < effectiveCols:
            cellW = colWidths[gridCol]
        var cellH: int32
        if gridRow < effectiveRows:
            cellH = rowHeights[gridRow]
        if cellH <= 0:
            cellH = tree.styles[childStyleIdx].height
        if cellH <= 0:
            cellH = WebLayoutIntrinsicHeight(tree, childNodeId, cellW, 0)
        let cellX = parentX + cellXOffset
        let cellY = parentY + cellYOffset

        let itemX = cellX + tree.styles[childStyleIdx].marginLeft
        let itemY = cellY + tree.styles[childStyleIdx].marginTop
        var itemW = cellW
        if itemW <= 0:
            itemW = WebLayoutResolvedWidth(tree, childStyleIdx, cellW)
        var itemH = cellH
        if itemH <= 0:
            itemH = tree.styles[childStyleIdx].height
        if itemH <= 0:
            itemH = 0

        let itemBoxIdx = tree.boxes.len
        WebLayoutRecordBox(tree, childNodeId, itemX, itemY, itemW, itemH)
        WebLayoutApplyBoxOffset(tree, childNodeId)

        if tree.styles[childStyleIdx].display == WebLayoutDisplayFlex:
            var itemContentX = itemX + tree.styles[childStyleIdx].borderLeftWidth + tree.styles[childStyleIdx].paddingLeft
            var itemContentY = itemY + tree.styles[childStyleIdx].borderTopWidth + tree.styles[childStyleIdx].paddingTop
            var itemContentW = itemW - tree.styles[childStyleIdx].borderLeftWidth - tree.styles[childStyleIdx].borderRightWidth - tree.styles[childStyleIdx].paddingLeft - tree.styles[childStyleIdx].paddingRight
            var itemContentH = itemH - tree.styles[childStyleIdx].borderTopWidth - tree.styles[childStyleIdx].borderBottomWidth - tree.styles[childStyleIdx].paddingTop - tree.styles[childStyleIdx].paddingBottom
            if itemContentW < 0:
                itemContentW = 0
            if itemContentH < 0:
                itemContentH = 0
            if !WebLayoutFlexLayoutChildren(tree, childNodeId, itemContentX, itemContentY, itemContentW, itemContentH,
                    tree.styles[childStyleIdx].flexDirection,
                    tree.styles[childStyleIdx].justifyContent,
                    tree.styles[childStyleIdx].alignItems,
                    tree.styles[childStyleIdx].gap):
                return false
        elif tree.styles[childStyleIdx].display == WebLayoutDisplayGrid:
            var nestedChildIds: int32[]
            let nestedChildCount = WebLayoutChildCount(tree, childNodeId)
            for nestedOrdinal in 0..<nestedChildCount:
                add(nestedChildIds, WebLayoutChildAt(tree, childNodeId, nestedOrdinal))
            if !WebLayoutGridLayoutChildren(tree, childNodeId, itemX, itemY, itemW, itemH, nestedChildIds):
                return false
        elif tree.styles[childStyleIdx].display == WebLayoutDisplayTable:
            var tableContentWidth: int32
            var tableContentHeight: int32
            if !WebLayoutTableLayoutChildren(tree, childNodeId, itemX, itemY, itemW, tableContentWidth, tableContentHeight):
                return false
            if tableContentHeight > itemH && itemBoxIdx >= 0 && itemBoxIdx < tree.boxes.len:
                tree.boxes[itemBoxIdx].height = tableContentHeight
        else:
            var contentHeight: int32
            if !WebLayoutBlockLayoutChildren(tree, childNodeId, itemX, itemY, itemW, contentHeight):
                return false
            if contentHeight > itemH && itemBoxIdx >= 0 && itemBoxIdx < tree.boxes.len:
                tree.boxes[itemBoxIdx].height = contentHeight

        if !WebLayoutLayoutPositionedChildren(tree, childNodeId, itemX, itemY, itemW, itemH):
            return false

    return true

fn WebLayoutFindPositionedAncestor(tree: var WebLayoutTree, nodeId: int32): int32 =
    if nodeId == 0:
        return 0
    let parentId = WebLayoutParentOf(tree, nodeId)
    if parentId == 0:
        return 0
    let styleIdx = WebLayoutFindStyleIndex(tree, parentId)
    if styleIdx < 0:
        return 0
    if tree.styles[styleIdx].position != WebLayoutPositionStatic:
        return parentId
    return WebLayoutFindPositionedAncestor(tree, parentId)

fn WebLayoutApplyBoxOffset(tree: var WebLayoutTree, nodeId: int32): bool =
    let bn = tree.boxes.len
    if bn == 0:
        return false
    let lastIdx = bn - 1
    if tree.boxes[lastIdx].nodeId != nodeId:
        return false
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0 || styleIdx >= tree.styles.len:
        return false
    # Read style fields directly from the layout tree.
    if tree.styles[styleIdx].position != WebLayoutPositionRelative:
        return false
    if lastIdx < 0 || lastIdx >= tree.boxes.len:
        return false
    let resolvedLeft = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetLeft, tree.styles[styleIdx].offsetLeftPercent, tree.styles[styleIdx].hasOffsetLeftPercent, tree.boxes[lastIdx].width)
    let resolvedRight = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetRight, tree.styles[styleIdx].offsetRightPercent, tree.styles[styleIdx].hasOffsetRightPercent, tree.boxes[lastIdx].width)
    let resolvedTop = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetTop, tree.styles[styleIdx].offsetTopPercent, tree.styles[styleIdx].hasOffsetTopPercent, tree.boxes[lastIdx].height)
    let resolvedBottom = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetBottom, tree.styles[styleIdx].offsetBottomPercent, tree.styles[styleIdx].hasOffsetBottomPercent, tree.boxes[lastIdx].height)
    if tree.styles[styleIdx].hasOffsetLeft:
        tree.boxes[lastIdx].x = tree.boxes[lastIdx].x + resolvedLeft
        tree.boxes[lastIdx].xPx2 = tree.boxes[lastIdx].xPx2 + resolvedLeft * 2
    elif tree.styles[styleIdx].hasOffsetRight:
        tree.boxes[lastIdx].x = tree.boxes[lastIdx].x - resolvedRight
        tree.boxes[lastIdx].xPx2 = tree.boxes[lastIdx].xPx2 - resolvedRight * 2
    if tree.styles[styleIdx].hasOffsetTop:
        tree.boxes[lastIdx].y = tree.boxes[lastIdx].y + resolvedTop
        tree.boxes[lastIdx].yPx2 = tree.boxes[lastIdx].yPx2 + resolvedTop * 2
    elif tree.styles[styleIdx].hasOffsetBottom:
        tree.boxes[lastIdx].y = tree.boxes[lastIdx].y - resolvedBottom
        tree.boxes[lastIdx].yPx2 = tree.boxes[lastIdx].yPx2 - resolvedBottom * 2
    return true

fn WebLayoutShiftSubtreeBoxes(tree: var WebLayoutTree, nodeId: int32, dx: int32, dy: int32): bool =
    for bi in 0..<tree.boxes.len:
        if tree.boxes[bi].nodeId == nodeId:
            tree.boxes[bi].x = tree.boxes[bi].x + dx
            tree.boxes[bi].y = tree.boxes[bi].y + dy
            tree.boxes[bi].xPx2 = tree.boxes[bi].xPx2 + dx * 2
            tree.boxes[bi].yPx2 = tree.boxes[bi].yPx2 + dy * 2
    let childCount = WebLayoutChildCount(tree, nodeId)
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
        if childNodeId != 0:
            if !WebLayoutShiftSubtreeBoxes(tree, childNodeId, dx, dy):
                return false
    return true

fn WebLayoutFindBoxIndexForNodeFrom(tree: var WebLayoutTree, nodeId: int32, startIndex: int32): int32 =
    var i = startIndex
    if i < 0:
        i = 0
    while i < tree.boxes.len:
        if tree.boxes[i].nodeId == nodeId:
            return i
        i = i + 1
    return -1

fn WebLayoutRebuildBoxIndexes(tree: var WebLayoutTree): bool =
    var maxNodeId: int32
    for i in 0..<tree.boxes.len:
        let nodeId = tree.boxes[i].nodeId
        if nodeId < 0:
            return false
        if nodeId > maxNodeId:
            maxNodeId = nodeId
    setLen(tree.firstBoxIndexByNodeId, maxNodeId + 1)
    setLen(tree.visibleBoxIndexByNodeId, maxNodeId + 1)
    for i in 0..<tree.firstBoxIndexByNodeId.len:
        tree.firstBoxIndexByNodeId[i] = 0
        tree.visibleBoxIndexByNodeId[i] = 0
    for i in 0..<tree.boxes.len:
        let box = tree.boxes[i]
        if tree.firstBoxIndexByNodeId[box.nodeId] == 0:
            tree.firstBoxIndexByNodeId[box.nodeId] = i + 1
        if box.visible && box.width > 0 && box.height > 0:
            if tree.visibleBoxIndexByNodeId[box.nodeId] == 0:
                tree.visibleBoxIndexByNodeId[box.nodeId] = i + 1
    tree.boxIndexSynced = tree.boxes.len
    return true

fn WebLayoutFindFirstBoxIndex(tree: var WebLayoutTree, nodeId: int32): int32 =
    if tree.boxIndexSynced != tree.boxes.len:
        if !WebLayoutRebuildBoxIndexes(tree):
            return -1
    if nodeId < 0 || nodeId >= tree.firstBoxIndexByNodeId.len:
        return -1
    let mapped = tree.firstBoxIndexByNodeId[nodeId]
    if mapped <= 0:
        return -1
    return mapped - 1

fn WebLayoutFindBestBoxIndex(tree: var WebLayoutTree, nodeId: int32): int32 =
    if tree.boxIndexSynced != tree.boxes.len:
        if !WebLayoutRebuildBoxIndexes(tree):
            return -1
    if nodeId < 0 || nodeId >= tree.firstBoxIndexByNodeId.len:
        return -1
    let visibleMapped = tree.visibleBoxIndexByNodeId[nodeId]
    if visibleMapped > 0:
        return visibleMapped - 1
    let firstMapped = tree.firstBoxIndexByNodeId[nodeId]
    if firstMapped <= 0:
        return -1
    return firstMapped - 1

fn WebLayoutFlexApplyAutoCrossAlignment(tree: var WebLayoutTree, childNodeId: int32,
                                        isRow: bool, alignItems: int32,
                                        parentWidth: int32, parentHeight: int32,
                                        actualCross: int32): bool =
    if actualCross <= 0:
        return true
    var delta: int32
    let styleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
    if styleIdx < 0:
        return true
    let outerCross = WebLayoutFlexOuterCrossSize(tree, styleIdx, actualCross, isRow)
    if isRow:
        if alignItems == WebLayoutAlignItemsCenter:
            delta = (parentHeight - outerCross) / 2
        elif alignItems == WebLayoutAlignItemsFlexEnd:
            delta = parentHeight - outerCross
        if delta > 0:
            return WebLayoutShiftSubtreeBoxes(tree, childNodeId, 0, delta)
    else:
        if alignItems == WebLayoutAlignItemsCenter:
            delta = (parentWidth - outerCross) / 2
        elif alignItems == WebLayoutAlignItemsFlexEnd:
            delta = parentWidth - outerCross
        if delta > 0:
            return WebLayoutShiftSubtreeBoxes(tree, childNodeId, delta, 0)
    return true

fn WebLayoutLayoutPositionedChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                     parentX: int32, parentY: int32,
                                     parentWidth: int32, parentHeight: int32): bool =
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            continue
        let styleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if styleIdx < 0:
            continue
        if parentNodeId == 4 && (childNodeId == 768 || childNodeId == 775):
            echo(Fmt"PC n={childNodeId} pos={tree.styles[styleIdx].position} ol={tree.styles[styleIdx].offsetLeft} ot={tree.styles[styleIdx].offsetTop} w={tree.styles[styleIdx].width}")
        if tree.styles[styleIdx].display == WebLayoutDisplayNone:
            WebLayoutFixDisplay(tree, childNodeId)
        if tree.styles[styleIdx].display == WebLayoutDisplayNone:
            continue
        if tree.styles[styleIdx].position != WebLayoutPositionAbsolute && tree.styles[styleIdx].position != WebLayoutPositionFixed:
            continue

        var posX: int32
        var posY: int32
        var containerX = parentX
        var containerY = parentY
        var containerW = parentWidth
        var containerH = parentHeight

        if tree.styles[styleIdx].position == WebLayoutPositionAbsolute:
            if tree.styles[styleIdx].hasOffsetLeft || tree.styles[styleIdx].hasOffsetRight || tree.styles[styleIdx].hasOffsetTop || tree.styles[styleIdx].hasOffsetBottom:
                if WebLayoutPosDepth > 0:
                    containerX = WebLayoutPosOriginX[WebLayoutPosDepth - 1]
                    containerY = WebLayoutPosOriginY[WebLayoutPosDepth - 1]
                    containerW = WebLayoutPosOriginW[WebLayoutPosDepth - 1]
                    containerH = WebLayoutPosOriginH[WebLayoutPosDepth - 1]
                else:
                    containerX = 0
                    containerY = 0
                    if tree.viewportWidth > 0:
                        containerW = tree.viewportWidth
                    if tree.viewportHeight > 0:
                        containerH = tree.viewportHeight
                    if tree.styles[styleIdx].width < 0:
                        tree.styles[styleIdx].width = WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].width, containerW)
                    if tree.styles[styleIdx].height < 0:
                        tree.styles[styleIdx].height = WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].height, containerH)

        if tree.styles[styleIdx].position == WebLayoutPositionFixed:
            containerX = 0
            containerY = 0
            if tree.viewportWidth > 0:
                containerW = tree.viewportWidth
            if tree.viewportHeight > 0:
                containerH = tree.viewportHeight
            if tree.styles[styleIdx].width < 0:
                tree.styles[styleIdx].width = WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].width, containerW)
            if tree.styles[styleIdx].height < 0:
                tree.styles[styleIdx].height = WebLayoutResolvePercentSize(0 - tree.styles[styleIdx].height, containerH)

        let resolvedLeft = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetLeft, tree.styles[styleIdx].offsetLeftPercent, tree.styles[styleIdx].hasOffsetLeftPercent, containerW)
        let resolvedRight = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetRight, tree.styles[styleIdx].offsetRightPercent, tree.styles[styleIdx].hasOffsetRightPercent, containerW)
        let resolvedTop = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetTop, tree.styles[styleIdx].offsetTopPercent, tree.styles[styleIdx].hasOffsetTopPercent, containerH)
        let resolvedBottom = WebLayoutResolveOffsetValue(tree.styles[styleIdx].offsetBottom, tree.styles[styleIdx].offsetBottomPercent, tree.styles[styleIdx].hasOffsetBottomPercent, containerH)

        if tree.styles[styleIdx].width <= 0 && tree.styles[styleIdx].hasOffsetLeft && tree.styles[styleIdx].hasOffsetRight:
            let stretchW = containerW - resolvedLeft - resolvedRight - tree.styles[styleIdx].marginLeft - tree.styles[styleIdx].marginRight
            if stretchW > 0:
                tree.styles[styleIdx].width = stretchW
        if tree.styles[styleIdx].height <= 0 && tree.styles[styleIdx].hasOffsetTop && tree.styles[styleIdx].hasOffsetBottom:
            let stretchH = containerH - resolvedTop - resolvedBottom - tree.styles[styleIdx].marginTop - tree.styles[styleIdx].marginBottom
            if stretchH > 0:
                tree.styles[styleIdx].height = stretchH

        if tree.styles[styleIdx].hasOffsetLeft:
            posX = containerX + tree.styles[styleIdx].marginLeft + resolvedLeft
        elif tree.styles[styleIdx].hasOffsetRight && tree.styles[styleIdx].width > 0:
            posX = containerX + containerW - resolvedRight - tree.styles[styleIdx].width - tree.styles[styleIdx].marginRight
        else:
            posX = containerX + tree.styles[styleIdx].marginLeft

        if tree.styles[styleIdx].hasOffsetTop:
            posY = containerY + tree.styles[styleIdx].marginTop + resolvedTop
        elif tree.styles[styleIdx].hasOffsetBottom && tree.styles[styleIdx].height > 0:
            posY = containerY + containerH - resolvedBottom - tree.styles[styleIdx].height - tree.styles[styleIdx].marginBottom
        else:
            posY = containerY + tree.styles[styleIdx].marginTop

        let beforeBoxCount = tree.boxes.len
        if !WebLayoutLayoutSubtree(tree, childNodeId, posX, posY, tree.styles[styleIdx].width > 0 ? tree.styles[styleIdx].width : containerW):
            return false
        var rootBoxIdx: int32 = -1
        for bi in beforeBoxCount..<tree.boxes.len:
            if tree.boxes[bi].nodeId == childNodeId:
                rootBoxIdx = bi
                break
        if rootBoxIdx >= 0:
            var dx: int32
            var dy: int32
            if !tree.styles[styleIdx].hasOffsetLeft && tree.styles[styleIdx].hasOffsetRight:
                let targetX = containerX + containerW - resolvedRight - tree.boxes[rootBoxIdx].width - tree.styles[styleIdx].marginRight
                dx = targetX - tree.boxes[rootBoxIdx].x
            if !tree.styles[styleIdx].hasOffsetTop && tree.styles[styleIdx].hasOffsetBottom:
                let targetY = containerY + containerH - resolvedBottom - tree.boxes[rootBoxIdx].height - tree.styles[styleIdx].marginBottom
                dy = targetY - tree.boxes[rootBoxIdx].y
            if dx != 0 || dy != 0:
                if !WebLayoutShiftSubtreeBoxes(tree, childNodeId, dx, dy):
                    return false
    return true

fn WebLayoutSortBoxesByZIndex(tree: var WebLayoutTree): bool =
    let nb = tree.boxes.len
    if nb <= 1:
        return true
    var needsSort = false
    for i in 0..<nb:
        if tree.boxes[i].zIndex != 0:
            needsSort = true
            break
    if !needsSort:
        return true
    // Simple insertion sort (stable) by zIndex
    for i in 1..<nb:
        var j = i
        while j > 0 && tree.boxes[j].zIndex < tree.boxes[j - 1].zIndex:
            let tmp = tree.boxes[j]
            tree.boxes[j] = tree.boxes[j - 1]
            tree.boxes[j - 1] = tmp
            j = j - 1
    return true

fn WebLayoutSetDisplay(tree: var WebLayoutTree, nodeId: int32, display: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    tree.styles[styleIdx].display = display
    return true

