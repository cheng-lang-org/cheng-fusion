# web_canvas_export_runtime.cheng
# canvas.toBlob PNG encoder substrate (pure Cheng, zero-C).
#
# Contract (mirrors HTMLCanvasElement.toBlob("image/png")):
#   WebCanvasToBlobPng(width, height, rgba) -> Bytes
#   - rgba is tightly packed 8-bit RGBA, row-major, length must equal
#     width*height*4; any mismatch returns EmptyBytes (hard fail shape,
#     no silent fallback).
#   - Output is a spec-compliant PNG: 8-bit depth, color type 6 (RGBA),
#     filter type 0 per scanline, zlib stream built from RFC1951 stored
#     deflate blocks (valid deflate; compression ratio is explicitly not
#     a goal of this substrate).
# Backs the ts-csg runtime closure provider id
#   cheng/core/runtime/web_canvas_export_runtime.to-blob-png.
import std/rawbytes

fn pngCrcStep(crc: uint32, v: int32): uint32 =
    var c: uint32 = crc ^ UInt32(v)
    var i: int32
    while i < 8:
        if (c & UInt32(1)) != UInt32(0):
            c = (c >> 1) ^ UInt32(-306674912)
        else:
            c = c >> 1
        i = i + 1
    return c

fn PngCrc32Range(buf: rawbytes.Bytes, fromPos: int32, toExcl: int32): uint32 =
    var crc: uint32 = UInt32(0xFFFFFFFF)
    var i: int32 = fromPos
    while i < toExcl:
        crc = pngCrcStep(crc, rawbytes.BytesGet(buf, i))
        i = i + 1
    return crc ^ UInt32(0xFFFFFFFF)

fn PngPutU8(buf: rawbytes.Bytes, pos: int32, v: int32) =
    rawbytes.BytesSet(buf, pos, v & 255)

fn PngPutU32be(buf: rawbytes.Bytes, pos: int32, v: int32) =
    rawbytes.BytesSet(buf, pos, (v >> 24) & 255)
    rawbytes.BytesSet(buf, pos + 1, (v >> 16) & 255)
    rawbytes.BytesSet(buf, pos + 2, (v >> 8) & 255)
    rawbytes.BytesSet(buf, pos + 3, v & 255)

fn WebCanvasToBlobPng(width: int32, height: int32, rgba: rawbytes.Bytes): rawbytes.Bytes =
    if width <= 0 || height <= 0:
        return rawbytes.EmptyBytes()
    let stride: int32 = width * 4
    let rowStride: int32 = stride + 1
    let rawLen: int32 = height * rowStride
    if rgba.len != width * height * 4:
        return rawbytes.EmptyBytes()

    # zlib stream: 2-byte header + stored blocks + 4-byte adler32
    let nBlocks: int32 = ((rawLen - 1) / 65535) + 1
    let zlen: int32 = 2 + nBlocks * 5 + rawLen + 4
    let ihdrDataPos: int32 = 12
    let idatPos: int32 = 33
    let idatTypePos: int32 = idatPos + 4
    let idatCrcPos: int32 = idatTypePos + zlen + 4
    let iendPos: int32 = idatCrcPos + 4
    let total: int32 = iendPos + 12

    var outBuf: rawbytes.Bytes = rawbytes.BytesAlloc(total)
    if outBuf.len != total:
        return rawbytes.EmptyBytes()

    # signature
    PngPutU8(outBuf, 0, 0x89)
    PngPutU8(outBuf, 1, 0x50)
    PngPutU8(outBuf, 2, 0x4E)
    PngPutU8(outBuf, 3, 0x47)
    PngPutU8(outBuf, 4, 0x0D)
    PngPutU8(outBuf, 5, 0x0A)
    PngPutU8(outBuf, 6, 0x1A)
    PngPutU8(outBuf, 7, 0x0A)

    # IHDR
    PngPutU32be(outBuf, 8, 13)
    PngPutU8(outBuf, 12, 0x49)
    PngPutU8(outBuf, 13, 0x48)
    PngPutU8(outBuf, 14, 0x44)
    PngPutU8(outBuf, 15, 0x52)
    PngPutU32be(outBuf, 16, width)
    PngPutU32be(outBuf, 20, height)
    PngPutU8(outBuf, 24, 8)
    PngPutU8(outBuf, 25, 6)
    PngPutU8(outBuf, 26, 0)
    PngPutU8(outBuf, 27, 0)
    PngPutU8(outBuf, 28, 0)
    PngPutU32be(outBuf, 29, Int32(PngCrc32Range(outBuf, ihdrDataPos, 29)))

    # IDAT header
    PngPutU32be(outBuf, idatPos, zlen)
    PngPutU8(outBuf, idatTypePos, 0x49)
    PngPutU8(outBuf, idatTypePos + 1, 0x44)
    PngPutU8(outBuf, idatTypePos + 2, 0x41)
    PngPutU8(outBuf, idatTypePos + 3, 0x54)

    # zlib header (stored-deflate friendly)
    PngPutU8(outBuf, idatTypePos + 4, 0x78)
    PngPutU8(outBuf, idatTypePos + 5, 0x01)

    # stored deflate blocks over the filtered logical stream:
    # logical byte p -> row = p / rowStride; off = p % rowStride;
    # off==0 is the filter byte 0, else the RGBA pixel component.
    var adlerA: uint32 = UInt32(1)
    var adlerB: uint32 = UInt32(0)
    var logical: int32
    var dst: int32 = idatTypePos + 6
    while logical < rawLen:
        var take: int32 = rawLen - logical
        var headerByte: int32
        if take > 65535:
            take = 65535
        if take == rawLen - logical && logical + take >= rawLen:
            headerByte = 1
        PngPutU8(outBuf, dst, headerByte)
        PngPutU8(outBuf, dst + 1, take & 255)
        PngPutU8(outBuf, dst + 2, (take >> 8) & 255)
        PngPutU8(outBuf, dst + 3, (65535 - take) & 255)
        PngPutU8(outBuf, dst + 4, ((65535 - take) >> 8) & 255)
        dst = dst + 5
        var k: int32
        while k < take:
            let row: int32 = logical / rowStride
            let off: int32 = logical % rowStride
            var v: int32
            if off != 0:
                v = rawbytes.BytesGet(rgba, row * stride + off - 1)
            rawbytes.BytesSet(outBuf, dst, v)
            adlerA = (adlerA + UInt32(v)) % UInt32(65521)
            adlerB = (adlerB + adlerA) % UInt32(65521)
            dst = dst + 1
            logical = logical + 1
            k = k + 1
    let adler: uint32 = (adlerB << 16) | adlerA
    PngPutU8(outBuf, dst, Int32((adler >> 24) & UInt32(255)))
    PngPutU8(outBuf, dst + 1, Int32((adler >> 16) & UInt32(255)))
    PngPutU8(outBuf, dst + 2, Int32((adler >> 8) & UInt32(255)))
    PngPutU8(outBuf, dst + 3, Int32(adler & UInt32(255)))
    PngPutU32be(outBuf, idatCrcPos, Int32(PngCrc32Range(outBuf, idatTypePos, idatCrcPos)))

    # IEND
    PngPutU32be(outBuf, iendPos, 0)
    PngPutU8(outBuf, iendPos + 4, 0x49)
    PngPutU8(outBuf, iendPos + 5, 0x45)
    PngPutU8(outBuf, iendPos + 6, 0x4E)
    PngPutU8(outBuf, iendPos + 7, 0x44)
    PngPutU32be(outBuf, iendPos + 8, Int32(PngCrc32Range(outBuf, iendPos + 4, iendPos + 8)))

    return outBuf
