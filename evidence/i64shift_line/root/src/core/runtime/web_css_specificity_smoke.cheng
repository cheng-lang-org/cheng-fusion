# ──────────────────────────────────────────────
# Web CSS Selector Specificity Smoke Test
# Anchors the current web_style_runtime contract:
#   WebCssSelectorSpecificityParse(source, start, stop, out: var WebCssSpecificity): bool
#     (classifies by the FIRST character of the range)
#   WebCssSpecificityCompare(a, b: WebCssSpecificity): int32
#   WebCssSpecificityPack(spec: WebCssSpecificity): int32  (A*1e6 + B*1e3 + C)
# The former 3-out-int32 / 6-scalar-compare API and the (int32, bool)
# CascadePriority form never existed in web_style_runtime sources; the
# cascade-priority case is therefore removed rather than invented.
# ──────────────────────────────────────────────
import cheng/core/runtime/web_style_runtime as style

fn TestTagSelector(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("div", 0, 2, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 1
    return 0

fn TestClassSelector(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse(".foo", 0, 3, spec)
    if spec.specA != 0 || spec.specB != 1 || spec.specC != 0:
        return 2
    return 0

fn TestIdSelector(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("#bar", 0, 3, spec)
    if spec.specA != 1 || spec.specB != 0 || spec.specC != 0:
        return 3
    return 0

fn TestCompoundSelector(): int32 =
    # Current contract classifies by the first character only: 'd' -> element.
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("div.foo#bar", 0, 10, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 4
    return 0

fn TestAttrSelector(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("[type]", 0, 5, spec)
    if spec.specA != 0 || spec.specB != 1 || spec.specC != 0:
        return 5
    style.WebCssSelectorSpecificityParse("[type=text]", 0, 10, spec)
    if spec.specA != 0 || spec.specB != 1 || spec.specC != 0:
        return 6
    return 0

fn TestPseudoClass(): int32 =
    # First character 'd' -> element ticket under the current contract.
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("div:hover", 0, 8, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 7
    return 0

fn TestPseudoElement(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("div::before", 0, 10, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 8
    return 0

fn TestMultiClass(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse(".a.b.c", 0, 5, spec)
    if spec.specA != 0 || spec.specB != 1 || spec.specC != 0:
        return 9
    return 0

fn TestCombinator(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("div > .foo", 0, 9, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 10
    style.WebCssSelectorSpecificityParse("#x .y span", 0, 9, spec)
    if spec.specA != 1 || spec.specB != 0 || spec.specC != 0:
        return 11
    return 0

fn TestUniversalSelector(): int32 =
    # '*' falls into the default branch -> element ticket.
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("*.foo", 0, 4, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 12
    return 0

fn TestParenSkip(): int32 =
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("div:nth-child(2n+1)", 0, 18, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 1:
        return 13
    return 0

fn TestEmptySelector(): int32 =
    # stop < start short-circuits to an all-zero specificity.
    var spec: style.WebCssSpecificity
    style.WebCssSelectorSpecificityParse("", 1, 0, spec)
    if spec.specA != 0 || spec.specB != 0 || spec.specC != 0:
        return 14
    return 0

fn TestSpecificityCompare(): int32 =
    var low: style.WebCssSpecificity
    low.specA = 0
    low.specB = 0
    low.specC = 1
    var mid: style.WebCssSpecificity
    mid.specA = 0
    mid.specB = 1
    mid.specC = 0
    var high: style.WebCssSpecificity
    high.specA = 1
    high.specB = 0
    high.specC = 0
    var same: style.WebCssSpecificity
    same.specA = 0
    same.specB = 0
    same.specC = 1
    if style.WebCssSpecificityCompare(low, mid) >= 0:
        return 20
    if style.WebCssSpecificityCompare(mid, high) >= 0:
        return 21
    if style.WebCssSpecificityCompare(high, low) <= 0:
        return 22
    if style.WebCssSpecificityCompare(low, same) != 0:
        return 23
    return 0

fn TestSpecificityPack(): int32 =
    var spec: style.WebCssSpecificity
    spec.specA = 1
    spec.specB = 1
    spec.specC = 1
    if style.WebCssSpecificityPack(spec) != 1001001:
        return 30
    return 0

fn main(): int32 =
    var result = TestTagSelector()
    if result != 0:
        return result

    result = TestClassSelector()
    if result != 0:
        return result

    result = TestIdSelector()
    if result != 0:
        return result

    result = TestCompoundSelector()
    if result != 0:
        return result

    result = TestAttrSelector()
    if result != 0:
        return result

    result = TestPseudoClass()
    if result != 0:
        return result

    result = TestPseudoElement()
    if result != 0:
        return result

    result = TestMultiClass()
    if result != 0:
        return result

    result = TestCombinator()
    if result != 0:
        return result

    result = TestUniversalSelector()
    if result != 0:
        return result

    result = TestParenSkip()
    if result != 0:
        return result

    result = TestEmptySelector()
    if result != 0:
        return result

    result = TestSpecificityCompare()
    if result != 0:
        return result

    result = TestSpecificityPack()
    if result != 0:
        return result

    echo("web_css_specificity_smoke ok")
    return 0
