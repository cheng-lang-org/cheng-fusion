# Darwin production held-exec capability.
#
# Darwin has no fd-addressed exec. Production therefore uses exactly one
# different OS-enforced authority: the root-owned, system-immutable,
# non-ad-hoc signed vnode installed at the fixed native path. The retained
# descriptor remains the byte/vnode measurement authority; it is never
# converted into a caller pathname identity. A later spawn owner must execute
# the same fixed vnode under the SSV-attested sandbox-exec profile and bind the
# resulting audit token back to this private row before ACTIVATE.
#
# This module has no FFI, pointer, reference or address surface. Raw uname and
# vnode operations live in target providers / held_exec_identity. Cross-module
# identity is one append-only int32 owner row; all CIDs and vnode/signature
# evidence stay in private SoA columns.

import std/atomic
import std/strings
import std/system
import cheng/core/runtime/held_exec_identity as held_identity

const
    CsgCoreProductionHeldExecDarwinCapabilityRowCount: int32 = 4096
    CsgCoreProductionHeldExecDarwinCapabilityEmpty: int32 = 0
    CsgCoreProductionHeldExecDarwinCapabilityIssued: int32 = 1
    CsgCoreProductionHeldExecDarwinCapabilityAuditBound: int32 = 2
    CsgCoreProductionHeldExecDarwinCapabilityConsumed: int32 = 3
    CsgCoreProductionHeldExecDarwinCapabilityFixedPath: str =
        "/usr/local/libexec/cheng/csg-core-native"
    CsgCoreProductionHeldExecDarwinCapabilityHardRedInstall: str =
        "HARD_RED:production_held_exec_darwin_system_immutable_signed_vnode_unavailable"
    CsgCoreProductionHeldExecDarwinCapabilityHardRedAudit: str =
        "HARD_RED:production_held_exec_darwin_audit_token_binding_unwired"
    CsgCoreProductionHeldExecDarwinCapabilityErrInitialize: str =
        "production_held_exec_darwin_capability_e_initialize"
    CsgCoreProductionHeldExecDarwinCapabilityErrPlatform: str =
        "production_held_exec_darwin_capability_e_platform"
    CsgCoreProductionHeldExecDarwinCapabilityErrExhausted: str =
        "production_held_exec_darwin_capability_e_exhausted"
    CsgCoreProductionHeldExecDarwinCapabilityErrIssuance: str =
        "production_held_exec_darwin_capability_e_issuance"

var
    productionHeldExecDarwinCapabilityRegistryInit: int32
    productionHeldExecDarwinCapabilityNextRow: atomic.I32
    productionHeldExecDarwinCapabilityStates: atomic.I32[]
    productionHeldExecDarwinCapabilityBinaryBytesCids: str[]
    productionHeldExecDarwinCapabilityCdhashCids: str[]
    productionHeldExecDarwinCapabilityDesignatedRequirementCids: str[]
    productionHeldExecDarwinCapabilitySigningIdentifiers: str[]
    productionHeldExecDarwinCapabilityTeamIdentifiers: str[]
    productionHeldExecDarwinCapabilityDevices: uint64[]
    productionHeldExecDarwinCapabilityInodes: uint64[]
    productionHeldExecDarwinCapabilityInodeFlags: uint64[]

# Unique launcher-start phase. No admitted child or worker may exist before
# this returns, so initialization is explicit and never performs a loser spin
# or caller-visible best-effort retry.
fn CsgCoreProductionHeldExecDarwinCapabilityInitializeBeforeLauncher():
        bool =
    if productionHeldExecDarwinCapabilityRegistryInit == 2:
        return true
    if productionHeldExecDarwinCapabilityRegistryInit != 0:
        return false
    productionHeldExecDarwinCapabilityRegistryInit = 1
    productionHeldExecDarwinCapabilityStates = []
    productionHeldExecDarwinCapabilityBinaryBytesCids = []
    productionHeldExecDarwinCapabilityCdhashCids = []
    productionHeldExecDarwinCapabilityDesignatedRequirementCids = []
    productionHeldExecDarwinCapabilitySigningIdentifiers = []
    productionHeldExecDarwinCapabilityTeamIdentifiers = []
    productionHeldExecDarwinCapabilityDevices = []
    productionHeldExecDarwinCapabilityInodes = []
    productionHeldExecDarwinCapabilityInodeFlags = []
    for row in 0..<CsgCoreProductionHeldExecDarwinCapabilityRowCount:
        add(productionHeldExecDarwinCapabilityStates,
            atomic.NewI32(
                CsgCoreProductionHeldExecDarwinCapabilityEmpty))
        add(productionHeldExecDarwinCapabilityBinaryBytesCids, "")
        add(productionHeldExecDarwinCapabilityCdhashCids, "")
        add(productionHeldExecDarwinCapabilityDesignatedRequirementCids, "")
        add(productionHeldExecDarwinCapabilitySigningIdentifiers, "")
        add(productionHeldExecDarwinCapabilityTeamIdentifiers, "")
        add(productionHeldExecDarwinCapabilityDevices, uint64(0))
        add(productionHeldExecDarwinCapabilityInodes, uint64(0))
        add(productionHeldExecDarwinCapabilityInodeFlags, uint64(0))
    productionHeldExecDarwinCapabilityNextRow = atomic.NewI32(0)
    if productionHeldExecDarwinCapabilityNextRow == nil:
        productionHeldExecDarwinCapabilityRegistryInit = 0
        return false
    for row in 0..<CsgCoreProductionHeldExecDarwinCapabilityRowCount:
        if productionHeldExecDarwinCapabilityStates[row] == nil:
            productionHeldExecDarwinCapabilityRegistryInit = 0
            return false
    productionHeldExecDarwinCapabilityRegistryInit = 2
    return true

@borrows
fn productionHeldExecDarwinCapabilityCidValid(value: str): bool =
    return value.len == 71 && strings.HasPrefix(value, "sha256:")

# Pre-spawn issuance bar. Success means only that the installed fixed vnode is
# a valid input to the future audited spawn step. It does not grant ACTIVATE
# and cannot be consumed as execution evidence until an audit-token owner has
# been joined by the Darwin spawn provider.
fn CsgCoreProductionHeldExecDarwinSystemImmutablePathPreflightInto(
        outOwner: var int32,
        err: var str): bool =
    outOwner = -1
    if productionHeldExecDarwinCapabilityRegistryInit != 2:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecDarwinCapabilityErrInitialize)
        return false
    if !system.RuntimeProductionHeldExecDarwinA64Host():
        err = strings.CloneStr(
            CsgCoreProductionHeldExecDarwinCapabilityErrPlatform)
        return false
    var issued: held_identity.ChengHeldExecIdentityIssueResult
    var issueErr: str
    if !held_identity.ChengHeldExecIdentityIssueInto(issued, issueErr):
        err = issueErr.len != 0 ? strings.CloneStr(issueErr) :
            strings.CloneStr(
                CsgCoreProductionHeldExecDarwinCapabilityHardRedInstall)
        return false
    let binary = issued.evidence.binary
    let issuanceBar =
        held_identity.ChengHeldExecIdentityFileIssuanceBarError(
            held_identity.ChengHeldExecPlatformDarwin, binary)
    if !issued.ok ||
       issued.evidence.platform !=
           held_identity.ChengHeldExecPlatformDarwin ||
       binary.fixedPath !=
           CsgCoreProductionHeldExecDarwinCapabilityFixedPath ||
       issuanceBar.len != 0 ||
       !binary.heldDescriptorPathProven ||
       !binary.namedHeldFenceClosed ||
       !binary.nativeImageProven ||
       !binary.darwin.codeDirectoryProven ||
       binary.darwin.adHocSignature ||
       !binary.darwin.hardenedRuntime ||
       !binary.darwin.libraryValidation ||
       !binary.darwin.designatedRequirementProven ||
       !productionHeldExecDarwinCapabilityCidValid(binary.bytesCid) ||
       !productionHeldExecDarwinCapabilityCidValid(
           binary.darwin.cdhashCid) ||
       !productionHeldExecDarwinCapabilityCidValid(
           binary.darwin.designatedRequirementCid) ||
       binary.darwin.signingIdentifier.len == 0 ||
       binary.darwin.teamIdentifier.len == 0 ||
       binary.held.device == uint64(0) ||
       binary.held.inode == uint64(0) ||
       binary.held.inodeFlags == uint64(0):
        err = issuanceBar.len != 0 ? strings.CloneStr(issuanceBar) :
            strings.CloneStr(
                CsgCoreProductionHeldExecDarwinCapabilityErrIssuance)
        return false
    let row = atomic.FetchAddI32(
        productionHeldExecDarwinCapabilityNextRow, 1)
    if row < 0 ||
       row >= CsgCoreProductionHeldExecDarwinCapabilityRowCount:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecDarwinCapabilityErrExhausted)
        return false
    productionHeldExecDarwinCapabilityBinaryBytesCids[row] =
        strings.CloneStr(binary.bytesCid)
    productionHeldExecDarwinCapabilityCdhashCids[row] =
        strings.CloneStr(binary.darwin.cdhashCid)
    productionHeldExecDarwinCapabilityDesignatedRequirementCids[row] =
        strings.CloneStr(binary.darwin.designatedRequirementCid)
    productionHeldExecDarwinCapabilitySigningIdentifiers[row] =
        strings.CloneStr(binary.darwin.signingIdentifier)
    productionHeldExecDarwinCapabilityTeamIdentifiers[row] =
        strings.CloneStr(binary.darwin.teamIdentifier)
    productionHeldExecDarwinCapabilityDevices[row] = binary.held.device
    productionHeldExecDarwinCapabilityInodes[row] = binary.held.inode
    productionHeldExecDarwinCapabilityInodeFlags[row] =
        binary.held.inodeFlags
    atomic.StoreI32(
        productionHeldExecDarwinCapabilityStates[row],
        CsgCoreProductionHeldExecDarwinCapabilityIssued)
    outOwner = row + 1
    err = ""
    return true

# Full Darwin arming is deliberately still RED: the fixed-path spawn,
# sandbox receipt and post-spawn audit-token join are not yet wired to this
# owner. This prevents a preflight receipt from being mistaken for execution
# authority on developer hosts where the installed immutable vnode is absent.
fn CsgCoreProductionHeldExecDarwinRequireAuditedPathSpawnInto(
        preflightOwner: int32,
        err: var str): bool =
    if preflightOwner <= 0 ||
       preflightOwner > CsgCoreProductionHeldExecDarwinCapabilityRowCount ||
       productionHeldExecDarwinCapabilityRegistryInit != 2:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecDarwinCapabilityErrIssuance)
        return false
    let row = preflightOwner - 1
    if atomic.LoadI32(
           productionHeldExecDarwinCapabilityStates[row]) !=
           CsgCoreProductionHeldExecDarwinCapabilityAuditBound:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecDarwinCapabilityHardRedAudit)
        return false
    err = strings.CloneStr(
        CsgCoreProductionHeldExecDarwinCapabilityHardRedAudit)
    return false
