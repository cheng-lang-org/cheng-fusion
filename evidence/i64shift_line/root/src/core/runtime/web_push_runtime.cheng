# web_push_runtime.cheng
# Web Push API for Cheng Web runtime.
# Provides: WebPushSubscription, WebPushKeys types and WebPush* functions

type
    WebPushSubscription =
        endpoint: str
        expirationTime: int64
        keys: WebPushKeys

    WebPushKeys =
        p256dh: str
        auth: str

# ============================================================
# Global state
# ============================================================

var pushSubscriptions: WebPushSubscription[]
var nextSubId: int32 = 1

# ============================================================
# Internal helpers
# ============================================================

fn WebPushFindIndex(subId: int32): int32 =
    if subId < 1:
        return -1
    let idx: int32 = subId - 1
    if idx >= pushSubscriptions.len:
        return -1
    return idx

# ============================================================
# WebPushManagerSubscribe: Create push subscription
# Returns subId, generates placeholder endpoint + keys
# ============================================================

fn WebPushManagerSubscribe(): int32 =
    let subId = nextSubId
    nextSubId = nextSubId + 1
    var sub: WebPushSubscription
    sub.endpoint = "https://example.com/push/"
    sub.expirationTime = Int64(0)
    var keys: WebPushKeys
    keys.p256dh = "BCVw39gPfGk="
    keys.auth = "authKey"
    sub.keys = keys
    add(pushSubscriptions, sub)
    return subId

# ============================================================
# WebPushManagerGetSubscription: Get subscription by subId
# ============================================================

fn WebPushManagerGetSubscription(subId: int32, out: var WebPushSubscription): bool =
    let idx = WebPushFindIndex(subId)
    if idx < 0:
        return false
    out = pushSubscriptions[idx]
    return true

# ============================================================
# WebPushManagerUnsubscribe: Remove subscription
# ============================================================

fn WebPushManagerUnsubscribe(subId: int32): bool =
    let idx = WebPushFindIndex(subId)
    if idx < 0:
        return false
    # Mark as expired rather than removing from array
    pushSubscriptions[idx].expirationTime = Int64(1)
    return true

# ============================================================
# WebPushManagerPermissionState: Get push permission state
# ============================================================

fn WebPushManagerPermissionState(): str =
    return "granted"

# ============================================================
# WebPushGenerateVapidKeys: Generate VAPID key pair (placeholder)
# ============================================================

fn WebPushGenerateVapidKeys(outPublic: var str, outPrivate: var str): bool =
    outPublic = "BGwL0LqRKlk="
    outPrivate = "a1b2c3d4e5f6g7h8"
    return true
