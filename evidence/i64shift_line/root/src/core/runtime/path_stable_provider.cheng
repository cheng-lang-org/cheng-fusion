# path_stable_provider — host filesystem/stat physical bridges for path.cheng.
#
# fstat/fstatat/read/write/getentropy and file-handle write-all stay in the
# provider tier behind managed rawbytes.Bytes / str value contracts. Kernel
# path.cheng never materializes an address; it only passes value buffers.
import std/rawbytes
import std/rawmem_support
import std/system

type
    PathHostStatFields =
        device: uint64
        mode: int32
        linkCount: uint64
        inode: uint64
        ownerUid: uint64
        ownerGid: uint64
        size: int64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        changeVersion: uint64

@importc("fstat")
fn pathHostFstatPhysical(fd: int32, outStat: cstring): int32
@importc("fstatat")
fn pathHostFstatAtPhysical(dirFd: int32, path: cstring, outStat: cstring,
                           flags: int32): int32
@importc("cheng_host_read_runtime")
fn pathHostReadPhysical(fd: int32, data: cstring, count: int32): int64
@importc("cheng_host_write_runtime")
fn pathHostWritePhysical(fd: int32, data: cstring, count: int32): int64
@importc("cheng_host_getentropy")
fn pathHostEntropyPhysical(data: cstring, count: int32): int32
@abi_internal
@importc("cheng_file_handle_write_all_bridge")
fn pathHostFileHandleWriteAllPhysical(handle: uint64, data: cstring,
                                      dataLen: int32,
                                      outErr: var str): int32

fn pathHostLoadU64(bytes: rawbytes.Bytes, offset: int32): uint64 =
    let value: uint64 = load(RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset))
    return value

fn pathHostLoadU32(bytes: rawbytes.Bytes, offset: int32): uint32 =
    let value: uint32 = load(RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset))
    return value

fn pathHostLoadI64(bytes: rawbytes.Bytes, offset: int32): int64 =
    let value: int64 = load(RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset))
    return value

fn PathHostStatDecode(
        bytes: rawbytes.Bytes,
        platformCode: int32,
        expectedType: int32,
        requireSingleLink: bool,
        out: var PathHostStatFields): bool =
    if rawbytes.BytesDataPtr(bytes) == nil:
        return false
    var next: PathHostStatFields
    if platformCode == 2:
        # Darwin arm64 struct stat layout: st_dev@0(u32) st_mode@4(u16)
        # st_nlink@6(u16) st_ino@8(u64) st_uid@16(u32) st_gid@20(u32)
        # st_mtimespec@48 st_ctimespec@64 st_size@96 st_gen@120.
        let headWord: uint64 = pathHostLoadU64(bytes, 0)
        let inodeRaw: uint64 = pathHostLoadU64(bytes, 8)
        let ownerWord: uint64 = pathHostLoadU64(bytes, 16)
        next.device = headWord & uint64(4294967295)
        next.mode = int32(uint64(headWord >> 32) & uint64(65535))
        next.linkCount = uint64(uint64(headWord >> 48) & uint64(65535))
        next.inode = inodeRaw
        next.ownerUid = ownerWord & uint64(4294967295)
        next.ownerGid = uint64(ownerWord >> 32) & uint64(4294967295)
        next.mtimeSec = pathHostLoadI64(bytes, 48)
        next.mtimeNsec = pathHostLoadI64(bytes, 56)
        next.ctimeSec = pathHostLoadI64(bytes, 64)
        next.ctimeNsec = pathHostLoadI64(bytes, 72)
        next.size = pathHostLoadI64(bytes, 96)
        let changeWord: uint64 = pathHostLoadU64(bytes, 120)
        next.changeVersion = changeWord & uint64(4294967295)
    elif platformCode == 1:
        let x64ModeRaw: uint32 = pathHostLoadU32(bytes, 24)
        let hostCpuModeRaw: uint32 = pathHostLoadU32(bytes, 16)
        let x64Mode = int32(x64ModeRaw)
        let hostCpuMode = int32(hostCpuModeRaw)
        let x64Matches =
            (x64Mode & int32(61440)) == expectedType
        let hostCpuMatches =
            (hostCpuMode & int32(61440)) == expectedType
        if x64Matches == hostCpuMatches:
            return false
        let devRaw: uint64 = pathHostLoadU64(bytes, 0)
        let inodeRaw: uint64 = pathHostLoadU64(bytes, 8)
        next.device = devRaw
        next.inode = inodeRaw
        if x64Matches:
            next.mode = x64Mode
            next.linkCount = pathHostLoadU64(bytes, 16)
            next.ownerUid = uint64(pathHostLoadU32(bytes, 28))
            next.ownerGid = uint64(pathHostLoadU32(bytes, 32))
        else:
            next.mode = hostCpuMode
            next.linkCount = uint64(pathHostLoadU32(bytes, 20))
            next.ownerUid = uint64(pathHostLoadU32(bytes, 24))
            next.ownerGid = uint64(pathHostLoadU32(bytes, 28))
        next.size = pathHostLoadI64(bytes, 48)
        next.mtimeSec = pathHostLoadI64(bytes, 88)
        next.mtimeNsec = pathHostLoadI64(bytes, 96)
        next.ctimeSec = pathHostLoadI64(bytes, 104)
        next.ctimeNsec = pathHostLoadI64(bytes, 112)
        next.changeVersion = uint64(0)
    else:
        return false
    if next.size < Int64(0) ||
       (next.mode & int32(61440)) != expectedType ||
       next.device == uint64(0) ||
       next.inode == uint64(0) ||
       next.linkCount == uint64(0) ||
       (requireSingleLink &&
        next.linkCount != uint64(1)):
        return false
    out = next
    return true

fn PathHostFstatInto(fd: int32, out: var rawbytes.Bytes): int32 =
    if rawbytes.BytesLen(out) < 144:
        return 1
    return pathHostFstatPhysical(fd, rawbytes.BytesDataPtr(out))

@borrows
fn PathHostFstatAtInto(dirFd: int32, path: str, out: var rawbytes.Bytes,
                       flags: int32): int32 =
    if rawbytes.BytesLen(out) < 144:
        return 1
    return pathHostFstatAtPhysical(
        dirFd, strToCStringTemp(path), rawbytes.BytesDataPtr(out), flags)

fn PathHostReadInto(
        fd: int32,
        bytes: var rawbytes.Bytes,
        offset: int32,
        count: int32): int64 =
    if count <= 0:
        return pathHostReadPhysical(fd, rawbytes.BytesDataPtr(bytes), 0)
    return pathHostReadPhysical(
        fd, RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset), count)

fn PathHostWriteFrom(
        fd: int32,
        bytes: rawbytes.Bytes,
        offset: int32,
        count: int32): int64 =
    if count <= 0:
        return pathHostWritePhysical(fd, rawbytes.BytesDataPtr(bytes), 0)
    return pathHostWritePhysical(
        fd, RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset), count)

fn PathHostEntropyInto(
        bytes: var rawbytes.Bytes,
        offset: int32,
        count: int32): int32 =
    if count <= 0:
        return pathHostEntropyPhysical(rawbytes.BytesDataPtr(bytes), 0)
    return pathHostEntropyPhysical(
        RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset), count)

@borrows
fn PathHostFileHandleWriteAll(
        handle: uint64,
        data: str,
        dataLen: int32,
        outErr: var str): int32 =
    return pathHostFileHandleWriteAllPhysical(
        handle, StrDataPtr(data), dataLen, outErr)

@borrows
fn PathHostBytesHandleWriteAll(
        handle: uint64,
        bytes: rawbytes.Bytes,
        outErr: var str): int32 =
    return pathHostFileHandleWriteAllPhysical(
        handle,
        rawbytes.BytesDataPtr(bytes),
        rawbytes.BytesLen(bytes),
        outErr)
