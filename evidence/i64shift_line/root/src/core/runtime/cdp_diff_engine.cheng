# cdp_diff_engine.cheng
# Layered diff engine: compares Cheng runtime output with Chrome CDP oracle.
# Layers: DOM tree → computed style → layout box → paint commands → raster
# Deterministic for layers 1-4; layer 5 (raster) is platform-dependent.

import cheng/core/runtime/cdp_oracle_dom as oracle
import std/strings
import std/strutils as su

# ============================================================
# Diff report types
# ============================================================

const
    DiffStatusPass = 0
    DiffStatusFail = 1
    DiffStatusSkip = 2

type
    DiffReport =
        domStatus: int32
        cssStatus: int32
        layoutStatus: int32
        paintStatus: int32
        rasterStatus: int32
        totalMismatches: int32
        firstLayer: str
        firstField: str
        firstOracle: str
        firstCheng: str


# ============================================================
# Diff report helpers
# ============================================================

fn statusStr(s: int32): str =
    if s == DiffStatusPass:
        return "PASS"
    if s == DiffStatusFail:
        return "FAIL"
    return "SKIP"


fn diffReportNew(): DiffReport =
    var r = DiffReport()
    r.domStatus = DiffStatusSkip
    r.cssStatus = DiffStatusSkip
    r.layoutStatus = DiffStatusSkip
    r.paintStatus = DiffStatusSkip
    r.rasterStatus = DiffStatusSkip
    return r


fn diffReportAdd(report: var DiffReport, layer: str, field: str, oracleVal: str, chengVal: str) =
    report.totalMismatches = report.totalMismatches + 1
    if report.totalMismatches == 1:
        report.firstLayer = layer
        report.firstField = field
        report.firstOracle = oracleVal
        report.firstCheng = chengVal


fn diffReportSummary(report: var DiffReport): str =
    var out: str
    out = ConcatStr("DOM:", statusStr(report.domStatus))
    out = ConcatStr(out, " CSS:")
    out = ConcatStr(out, statusStr(report.cssStatus))
    out = ConcatStr(out, " Layout:")
    out = ConcatStr(out, statusStr(report.layoutStatus))
    out = ConcatStr(out, " Paint:")
    out = ConcatStr(out, statusStr(report.paintStatus))
    out = ConcatStr(out, " Raster:")
    out = ConcatStr(out, statusStr(report.rasterStatus))
    out = ConcatStr(out, " Mismatches:")
    out = ConcatStr(out, strings.IntToStr(report.totalMismatches))
    return out


# ============================================================
# Layer 1: DOM comparison
# ============================================================

fn diffDom(oracle: var oracle.OracleDomSummary, chengNodeCount: int32,
             chengElemCount: int32, chengTextCount: int32,
             report: var DiffReport): bool =
    var ok = true

    if oracle.nodeCount != chengNodeCount:
        diffReportAdd(report, "DOM", "nodeCount",
            strings.IntToStr(oracle.nodeCount),
            strings.IntToStr(chengNodeCount))
        ok = false

    if oracle.elementCount != chengElemCount:
        diffReportAdd(report, "DOM", "elemCount",
            strings.IntToStr(oracle.elementCount),
            strings.IntToStr(chengElemCount))
        ok = false

    if oracle.textCount != chengTextCount:
        diffReportAdd(report, "DOM", "textCount",
            strings.IntToStr(oracle.textCount),
            strings.IntToStr(chengTextCount))
        ok = false

    report.domStatus = if ok then DiffStatusPass else DiffStatusFail
    return ok


# ============================================================
# Full layered diff
# ============================================================

fn diffFull(oracleSummary: var oracle.OracleDomSummary,
              chengNodeCount: int32, chengElemCount: int32, chengTextCount: int32,
              outReport: var DiffReport, out1to1: var bool): bool =
    outReport = diffReportNew()

    # Layer 1: DOM
    var domOk = diffDom(oracleSummary, chengNodeCount, chengElemCount, chengTextCount, outReport)

    # Layers 2-5: skip (need more extraction)
    outReport.cssStatus = DiffStatusSkip
    outReport.layoutStatus = DiffStatusSkip
    outReport.paintStatus = DiffStatusSkip
    outReport.rasterStatus = DiffStatusSkip

    out1to1 = domOk
    return true
