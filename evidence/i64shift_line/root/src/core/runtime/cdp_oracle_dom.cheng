# cdp_oracle_dom.cheng
# Fetch DOM from Chrome DevTools and extract structural counts.
# Uses string parsing (no js_runtime JSON dependency).
# This is deliberately simple — full JSON→DOM tree needs js_runtime
# and is deferred until js_runtime is compilable with the CDP modules.

import cheng/core/runtime/cdp_client as cdp
import std/strings
import std/strutils as su

# ============================================================
# Oracle DOM summary (from raw CDP JSON string parsing)
# ============================================================

type
    OracleDomSummary =
        nodeCount: int32
        elementCount: int32
        textCount: int32
        maxDepth: int32
        rawJsonLen: int32


# ============================================================
# String helpers for JSON extraction
# ============================================================

@borrows
fn countStringOccurrences(haystack: str, needle: str): int32 =
    var count: int32
    var pos: int32
    while pos + len(needle) <= len(haystack):
        var isMatch: bool
        isMatch = true
        var j: int32
        while j < len(needle) && isMatch:
            if haystack[pos + j] != needle[j]:
                isMatch = false
            j = j + 1
        if isMatch:
            count = count + 1
            pos = pos + len(needle)
        else:
            pos = pos + 1
    return count


# ============================================================
# Parse CDP DOM.getDocument JSON (string-based, no JSON parser)
# ============================================================

fn oracleParseDomFromJson(json: str, outSummary: var OracleDomSummary): bool =
    if len(json) == 0:
        return false
    outSummary.rawJsonLen = len(json)
    outSummary.nodeCount = countStringOccurrences(json, "\"nodeId\"")
    outSummary.elementCount = countStringOccurrences(json, "\"nodeType\":1")
    outSummary.textCount = countStringOccurrences(json, "\"nodeType\":3")
    outSummary.maxDepth = 1
    return true


# ============================================================
# High-level: fetch DOM from Chrome and return summary
# ============================================================

fn oracleFetchDomSummary(outSummary: var OracleDomSummary, outError: var str): bool =
    var docJson: str
    if !cdp.cdpFetchDocumentFromChrome(docJson):
        outError = "FAIL: could not connect to Chrome DevTools"
        return false
    if !oracleParseDomFromJson(docJson, outSummary):
        outError = "FAIL: could not parse CDP JSON response"
        return false
    outError = ""
    return true


# ============================================================
# Format summary as human-readable string
# ============================================================

fn oracleFormatSummary(summary: var OracleDomSummary): str =
    var out: str
    out = ConcatStr("Oracle DOM: ", strings.IntToStr(summary.nodeCount))
    out = ConcatStr(out, " nodes, ")
    out = ConcatStr(out, strings.IntToStr(summary.elementCount))
    out = ConcatStr(out, " elements, ")
    out = ConcatStr(out, strings.IntToStr(summary.textCount))
    out = ConcatStr(out, " text nodes, maxDepth=")
    out = ConcatStr(out, strings.IntToStr(summary.maxDepth))
    out = ConcatStr(out, ", rawJson=")
    out = ConcatStr(out, strings.IntToStr(summary.rawJsonLen))
    out = ConcatStr(out, " bytes")
    return out
