import cheng/core/runtime/cdp_client as cdp
import std/strings

fn PelagoOrderCsvHeader(): str =
    return "url,visit_date,product_option,adult_qty,child_qty,first_name,last_name,email,country_code,phone,promo_code\n"


fn PelagoOrderCsvExample(url: str): str =
    return strings.ConcatStr(PelagoOrderCsvHeader(),
        strings.ConcatStr(url, ",2026-07-01,adult,1,0,San,Zhang,buyer@example.com,+65,81234567,\n"))


fn PelagoFieldProbeExpression(): str =
    var expr: str
    expr = strings.ConcatStr(expr, "(() => {")
    expr = strings.ConcatStr(expr, "const nodes=Array.prototype.slice.call(document.querySelectorAll('input,select,textarea,button,[role=\"button\"]')).slice(0,120);")
    expr = strings.ConcatStr(expr, "const fields=nodes.map((el,i)=>({")
    expr = strings.ConcatStr(expr, "index:i,tag:(el.tagName||'').toLowerCase(),")
    expr = strings.ConcatStr(expr, "type:el.getAttribute('type')||'',")
    expr = strings.ConcatStr(expr, "name:el.getAttribute('name')||'',")
    expr = strings.ConcatStr(expr, "id:el.id||'',")
    expr = strings.ConcatStr(expr, "placeholder:el.getAttribute('placeholder')||'',")
    expr = strings.ConcatStr(expr, "aria:el.getAttribute('aria-label')||'',")
    expr = strings.ConcatStr(expr, "text:((el.innerText||el.textContent||'').trim()).slice(0,100),")
    expr = strings.ConcatStr(expr, "required:!!el.required,disabled:!!el.disabled")
    expr = strings.ConcatStr(expr, "}));")
    expr = strings.ConcatStr(expr, "return JSON.stringify({url:location.href,title:document.title,fieldCount:fields.length,fields});")
    expr = strings.ConcatStr(expr, "})()")
    return expr


fn PelagoExtractFieldProbeJson(evaluateResponseJson: str, outFieldsJson: var str): bool =
    return cdp.cdpRuntimeEvaluateStringValue(evaluateResponseJson, outFieldsJson)


fn PelagoProbeFields(conn: var cdp.CdpConnection, outFieldsJson: var str): bool =
    var responseJson: str
    if !cdp.cdpEvaluateJs(conn, PelagoFieldProbeExpression(), responseJson):
        return false
    return PelagoExtractFieldProbeJson(responseJson, outFieldsJson)
