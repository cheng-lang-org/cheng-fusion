import std/result
import std/rawbytes
import std/crypto/sha256
import std/strings
import std/strutils as strutil
import cheng/core/ir/csg_web_facts as facts
import cheng/core/runtime/web_scene_runtime as scene

const
    WebSceneAgentMediaActionSchema = "unimaker.agent.media.action.v1"
    WebSceneAgentMediaEventStreamSchema = "unimaker.agent.media.event_stream.v1"

type
    WebSceneAgentMediaActionRequest =
        schema: str
        agentId: str
        streamId: str
        lifecycleFactIdPrefix: str
        slotId: str
        actionKind: str
        payload: str
        trace: str

    WebSceneAgentMediaEvent =
        streamIndex: int32
        lifecycleIndex: int32
        receiptIndex: int32
        lifecycleFactId: str
        eventCid: str
        eventKind: str
        actionKind: str
        slotId: str
        assetCid: str
        bundleCid: str
        manifestCid: str
        kindCode: int32
        payloadSchema: str
        payload: str
        transport: str
        dispatch: str
        guard: str
        sourceStateCode: int32
        resultStateCode: int32
        statusCode: int32
        objectCount: int32
        dropletCount: int32
        trace: str

    WebSceneAgentMediaEventStream =
        schema: str
        streamId: str
        sourceCursor: int32
        nextCursor: int32
        eventCount: int32
        events: WebSceneAgentMediaEvent[]

    WebSceneAgentMediaActionReceipt =
        schema: str
        actionCid: str
        agentId: str
        streamId: str
        slotId: str
        actionKind: str
        payload: str
        assetCid: str
        kindCode: int32
        mediaReceiptIndex: int32
        mediaReceiptStatusCode: int32
        playbackState: int32
        lifecycleSourceCursor: int32
        lifecycleNextCursor: int32
        lifecycleDeltaCount: int32
        lifecycleStream: WebSceneAgentMediaEventStream
        trace: str

fn WebSceneMediaLifecycleSha256HexText(text: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(text))
    return rawbytes.BytesToHex(digest)

fn WebSceneMediaLifecycleEventValidate(event: var scene.WebSceneMediaLifecycleEvent): Result[int32] =
    if event.receiptIndex < 0:
        return Err[int32]("web scene csg: lifecycle event missing receipt index")
    if !scene.WebSceneMediaLifecycleAction(event.eventKind):
        return Err[int32]("web scene csg: unsupported lifecycle event kind")
    if len(event.slotId) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing slot id")
    if len(event.assetCid) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing asset cid")
    if len(event.bundleCid) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing bundle cid")
    if len(event.manifestCid) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing manifest cid")
    if event.kindCode <= 0:
        return Err[int32]("web scene csg: lifecycle event missing media kind")
    if len(event.payloadSchema) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing payload schema")
    if len(event.payload) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing payload")
    if len(event.dispatch) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing dispatch")
    if len(event.guard) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing guard")
    if event.statusCode != scene.WebSceneMediaReceiptOk:
        return Err[int32]("web scene csg: lifecycle event status mismatch")
    if len(event.trace) <= 0:
        return Err[int32]("web scene csg: lifecycle event missing trace")
    if event.eventKind == "OpenAsset":
        if event.payload != event.manifestCid:
            return Err[int32]("web scene csg: open payload must equal manifest cid")
        if event.transport != "moq":
            return Err[int32]("web scene csg: open event must use moq transport")
        if event.objectCount <= 0 || event.dropletCount <= 0:
            return Err[int32]("web scene csg: open event missing object or droplet count")
    elif event.eventKind == "PublishAsset":
        if event.payload != event.assetCid:
            return Err[int32]("web scene csg: publish payload must equal asset cid")
        if event.transport != "moq":
            return Err[int32]("web scene csg: publish event must use moq transport")
        if event.objectCount <= 0 || event.dropletCount <= 0:
            return Err[int32]("web scene csg: publish event missing object or droplet count")
    elif event.eventKind == "EditAsset":
        if len(event.transport) != 0:
            return Err[int32]("web scene csg: edit event must not carry transport")
        if event.objectCount != 0 || event.dropletCount != 0:
            return Err[int32]("web scene csg: edit event must not carry object or droplet count")
    else:
        if !scene.WebSceneMediaDomLifecycleEvent(event.eventKind):
            return Err[int32]("web scene csg: unsupported dom lifecycle event kind")
        if len(event.transport) != 0:
            return Err[int32]("web scene csg: dom lifecycle event must not carry transport")
        if event.objectCount != 0 || event.dropletCount != 0:
            return Err[int32]("web scene csg: dom lifecycle event must not carry object or droplet count")
    return Ok[int32](1)

fn WebSceneMediaLifecycleEventPreimage(event: var scene.WebSceneMediaLifecycleEvent): Result[str] =
    let validateRes = WebSceneMediaLifecycleEventValidate(event)
    if IsErr(validateRes):
        return Err[str](Error(validateRes))
    return Ok[str](strutil.Join([
        strings.CloneStr(event.payloadSchema),
        "|webscene|",
        strings.CloneStr(event.eventKind),
        "|",
        IntToStr(event.receiptIndex),
        "|",
        strings.CloneStr(event.slotId),
        "|",
        strings.CloneStr(event.assetCid),
        "|",
        strings.CloneStr(event.bundleCid),
        "|",
        strings.CloneStr(event.manifestCid),
        "|",
        IntToStr(event.kindCode),
        "|",
        strings.CloneStr(event.payload),
        "|",
        strings.CloneStr(event.transport),
        "|",
        strings.CloneStr(event.dispatch),
        "|",
        strings.CloneStr(event.guard),
        "|",
        IntToStr(event.sourceStateCode),
        "|",
        IntToStr(event.resultStateCode),
        "|",
        IntToStr(event.statusCode),
        "|",
        IntToStr(event.objectCount),
        "|",
        IntToStr(event.dropletCount),
        "|",
        strings.CloneStr(event.trace)
    ], ""))

fn WebSceneMediaLifecycleEventCid(event: var scene.WebSceneMediaLifecycleEvent): Result[str] =
    let preimageRes = WebSceneMediaLifecycleEventPreimage(event)
    if IsErr(preimageRes):
        return Err[str](Error(preimageRes))
    return Ok[str](WebSceneMediaLifecycleSha256HexText(Value(preimageRes)))

fn WebSceneMediaLifecycleEventToCsgWebFact(event: var scene.WebSceneMediaLifecycleEvent,
                                           factId: str): Result[facts.CsgWebMediaLifecycleEventFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaLifecycleEventFact]("web scene csg: missing lifecycle event fact id")
    let cidRes = WebSceneMediaLifecycleEventCid(event)
    if IsErr(cidRes):
        return Err[facts.CsgWebMediaLifecycleEventFact](Error(cidRes))
    return Ok[facts.CsgWebMediaLifecycleEventFact](facts.CsgWebMediaLifecycleEventFact(
        kind: facts.CsgWebMediaLifecycleEvent,
        id: factId,
        eventKind: event.eventKind,
        eventCid: Value(cidRes),
        slotId: event.slotId,
        assetCid: event.assetCid,
        bundleCid: event.bundleCid,
        manifestCid: event.manifestCid,
        kindCode: event.kindCode,
        payloadSchema: event.payloadSchema,
        payload: event.payload,
        transport: event.transport,
        dispatch: event.dispatch,
        guard: event.guard,
        sourceStateCode: event.sourceStateCode,
        resultStateCode: event.resultStateCode,
        statusCode: event.statusCode,
        objectCount: event.objectCount,
        dropletCount: event.dropletCount,
        trace: event.trace
    ))

fn WebSceneMediaLifecycleEventAtToCsgWebFact(graph: var scene.WebSceneGraph,
                                             index: int32,
                                             factId: str): Result[facts.CsgWebMediaLifecycleEventFact] =
    if index < 0 || index >= graph.mediaLifecycleEvents.len:
        return Err[facts.CsgWebMediaLifecycleEventFact]("web scene csg: lifecycle event index out of range")
    var event = graph.mediaLifecycleEvents[index]
    return WebSceneMediaLifecycleEventToCsgWebFact(event, factId)

fn WebSceneAgentMediaEventFromLifecycleFact(fact: var facts.CsgWebMediaLifecycleEventFact,
                                            streamIndex: int32,
                                            lifecycleIndex: int32,
                                            receiptIndex: int32): Result[WebSceneAgentMediaEvent] =
    if streamIndex < 0 || lifecycleIndex < 0 || receiptIndex < 0:
        return Err[WebSceneAgentMediaEvent]("web scene agent: invalid event index")
    if fact.kind != facts.CsgWebMediaLifecycleEvent:
        return Err[WebSceneAgentMediaEvent]("web scene agent: lifecycle fact kind mismatch")
    if len(fact.id) <= 0 || len(fact.eventCid) != 64:
        return Err[WebSceneAgentMediaEvent]("web scene agent: invalid lifecycle fact identity")
    if !scene.WebSceneMediaLifecycleAction(fact.eventKind):
        return Err[WebSceneAgentMediaEvent]("web scene agent: unsupported lifecycle action")
    if len(fact.assetCid) <= 0 || len(fact.bundleCid) <= 0 || len(fact.manifestCid) <= 0:
        return Err[WebSceneAgentMediaEvent]("web scene agent: missing media identity")
    if len(fact.dispatch) <= 0 || len(fact.guard) <= 0 || len(fact.trace) <= 0:
        return Err[WebSceneAgentMediaEvent]("web scene agent: missing control metadata")
    if fact.eventKind == "OpenAsset":
        if fact.payload != fact.manifestCid || fact.transport != "moq":
            return Err[WebSceneAgentMediaEvent]("web scene agent: open lifecycle fact mismatch")
        if fact.objectCount <= 0 || fact.dropletCount <= 0:
            return Err[WebSceneAgentMediaEvent]("web scene agent: open lifecycle fact missing objects")
    elif fact.eventKind == "PublishAsset":
        if fact.payload != fact.assetCid || fact.transport != "moq":
            return Err[WebSceneAgentMediaEvent]("web scene agent: publish lifecycle fact mismatch")
        if fact.objectCount <= 0 || fact.dropletCount <= 0:
            return Err[WebSceneAgentMediaEvent]("web scene agent: publish lifecycle fact missing objects")
    elif fact.eventKind == "EditAsset":
        if len(fact.payload) <= 0 || len(fact.transport) != 0:
            return Err[WebSceneAgentMediaEvent]("web scene agent: edit lifecycle fact mismatch")
        if fact.objectCount != 0 || fact.dropletCount != 0:
            return Err[WebSceneAgentMediaEvent]("web scene agent: edit lifecycle fact carries publish data")
    return Ok[WebSceneAgentMediaEvent](WebSceneAgentMediaEvent(
        streamIndex: streamIndex,
        lifecycleIndex: lifecycleIndex,
        receiptIndex: receiptIndex,
        lifecycleFactId: fact.id,
        eventCid: fact.eventCid,
        eventKind: fact.eventKind,
        actionKind: fact.eventKind,
        slotId: fact.slotId,
        assetCid: fact.assetCid,
        bundleCid: fact.bundleCid,
        manifestCid: fact.manifestCid,
        kindCode: fact.kindCode,
        payloadSchema: fact.payloadSchema,
        payload: fact.payload,
        transport: fact.transport,
        dispatch: fact.dispatch,
        guard: fact.guard,
        sourceStateCode: fact.sourceStateCode,
        resultStateCode: fact.resultStateCode,
        statusCode: fact.statusCode,
        objectCount: fact.objectCount,
        dropletCount: fact.dropletCount,
        trace: fact.trace
    ))

fn WebSceneAgentMediaEventStreamFromCursor(graph: var scene.WebSceneGraph,
                                           sourceCursor: int32,
                                           streamId: str,
                                           lifecycleFactIdPrefix: str): Result[WebSceneAgentMediaEventStream] =
    if len(streamId) <= 0:
        return Err[WebSceneAgentMediaEventStream]("web scene agent: missing stream id")
    if len(lifecycleFactIdPrefix) <= 0:
        return Err[WebSceneAgentMediaEventStream]("web scene agent: missing lifecycle fact id prefix")
    if sourceCursor < 0 || sourceCursor > graph.mediaLifecycleEvents.len:
        return Err[WebSceneAgentMediaEventStream]("web scene agent: lifecycle cursor out of range")
    var stream: WebSceneAgentMediaEventStream
    stream.schema = WebSceneAgentMediaEventStreamSchema
    stream.streamId = streamId
    stream.sourceCursor = sourceCursor
    stream.nextCursor = graph.mediaLifecycleEvents.len
    stream.events = []
    var streamIndex: int32
    streamIndex = 0
    var lifecycleIndex: int32
    for lifecycleIndex in sourceCursor..<graph.mediaLifecycleEvents.len:
        let factId = strutil.Join([lifecycleFactIdPrefix, ".", IntToStr(lifecycleIndex)], "")
        let factRes = WebSceneMediaLifecycleEventAtToCsgWebFact(graph, lifecycleIndex, factId)
        if IsErr(factRes):
            return Err[WebSceneAgentMediaEventStream](Error(factRes))
        var fact = Value(factRes)
        let eventRes = WebSceneAgentMediaEventFromLifecycleFact(fact,
                                                               streamIndex,
                                                               lifecycleIndex,
                                                               graph.mediaLifecycleEvents[lifecycleIndex].receiptIndex)
        if IsErr(eventRes):
            return Err[WebSceneAgentMediaEventStream](Error(eventRes))
        add(stream.events, Value(eventRes))
        streamIndex = streamIndex + 1
    stream.eventCount = stream.events.len
    return Ok[WebSceneAgentMediaEventStream](stream)

fn WebSceneAgentMediaEventStreamCount(stream: var WebSceneAgentMediaEventStream): int32 =
    return stream.eventCount

fn WebSceneAgentMediaEventStreamNextCursor(stream: var WebSceneAgentMediaEventStream): int32 =
    return stream.nextCursor

fn WebSceneAgentMediaEventCidAt(stream: var WebSceneAgentMediaEventStream, index: int32): str =
    if index < 0 || index >= stream.events.len:
        return ""
    return stream.events[index].eventCid

fn WebSceneAgentMediaEventKindAt(stream: var WebSceneAgentMediaEventStream, index: int32): str =
    if index < 0 || index >= stream.events.len:
        return ""
    return stream.events[index].eventKind

fn WebSceneAgentMediaEventAssetCidAt(stream: var WebSceneAgentMediaEventStream, index: int32): str =
    if index < 0 || index >= stream.events.len:
        return ""
    return stream.events[index].assetCid

fn WebSceneAgentMediaEventPayloadAt(stream: var WebSceneAgentMediaEventStream, index: int32): str =
    if index < 0 || index >= stream.events.len:
        return ""
    return stream.events[index].payload

fn WebSceneAgentMediaEventLifecycleFactIdAt(stream: var WebSceneAgentMediaEventStream, index: int32): str =
    if index < 0 || index >= stream.events.len:
        return ""
    return stream.events[index].lifecycleFactId

fn WebSceneAgentMediaEventReceiptIndexAt(stream: var WebSceneAgentMediaEventStream, index: int32): int32 =
    if index < 0 || index >= stream.events.len:
        return -1
    return stream.events[index].receiptIndex

fn WebSceneAgentMediaEventResultStateCodeAt(stream: var WebSceneAgentMediaEventStream, index: int32): int32 =
    if index < 0 || index >= stream.events.len:
        return -1
    return stream.events[index].resultStateCode

fn WebSceneAgentMediaEventObjectCountAt(stream: var WebSceneAgentMediaEventStream, index: int32): int32 =
    if index < 0 || index >= stream.events.len:
        return -1
    return stream.events[index].objectCount

fn WebSceneAgentMediaEventDropletCountAt(stream: var WebSceneAgentMediaEventStream, index: int32): int32 =
    if index < 0 || index >= stream.events.len:
        return -1
    return stream.events[index].dropletCount

fn WebSceneAgentMediaActionRequestValidate(request: var WebSceneAgentMediaActionRequest): Result[int32] =
    if request.schema != WebSceneAgentMediaActionSchema:
        return Err[int32]("web scene agent: media action schema mismatch")
    if len(request.agentId) <= 0:
        return Err[int32]("web scene agent: missing agent id")
    if len(request.streamId) <= 0:
        return Err[int32]("web scene agent: missing stream id")
    if len(request.lifecycleFactIdPrefix) <= 0:
        return Err[int32]("web scene agent: missing lifecycle fact id prefix")
    if len(request.slotId) <= 0:
        return Err[int32]("web scene agent: missing slot id")
    if len(request.actionKind) <= 0:
        return Err[int32]("web scene agent: missing action kind")
    if len(request.trace) <= 0:
        return Err[int32]("web scene agent: missing trace")
    if request.actionKind == "OpenAsset":
        if len(request.payload) != 0:
            return Err[int32]("web scene agent: open action payload unsupported")
    elif scene.WebSceneMediaLifecycleAction(request.actionKind):
        if len(request.payload) <= 0:
            return Err[int32]("web scene agent: lifecycle action requires payload")
    elif len(request.payload) != 0:
        return Err[int32]("web scene agent: non-lifecycle action payload unsupported")
    return Ok[int32](1)

fn WebSceneAgentMediaActionReceiptPreimage(receipt: var WebSceneAgentMediaActionReceipt): str =
    return strutil.Join([
        receipt.schema,
        "|",
        receipt.agentId,
        "|",
        receipt.streamId,
        "|",
        receipt.slotId,
        "|",
        receipt.actionKind,
        "|",
        receipt.payload,
        "|",
        receipt.assetCid,
        "|",
        IntToStr(receipt.kindCode),
        "|",
        IntToStr(receipt.mediaReceiptIndex),
        "|",
        IntToStr(receipt.mediaReceiptStatusCode),
        "|",
        IntToStr(receipt.playbackState),
        "|",
        IntToStr(receipt.lifecycleSourceCursor),
        "|",
        IntToStr(receipt.lifecycleNextCursor),
        "|",
        IntToStr(receipt.lifecycleDeltaCount),
        "|",
        receipt.trace
    ], "")

fn WebSceneAgentApplyMediaAction(graph: var scene.WebSceneGraph,
                                 request: var WebSceneAgentMediaActionRequest): Result[WebSceneAgentMediaActionReceipt] =
    let validateRes = WebSceneAgentMediaActionRequestValidate(request)
    if IsErr(validateRes):
        return Err[WebSceneAgentMediaActionReceipt](Error(validateRes))
    let lifecycleSourceCursor = graph.mediaLifecycleEvents.len
    let mediaReceiptIndex = graph.mediaReceipts.len
    if !scene.WebSceneApplyMediaControlWithPayload(graph, request.slotId, request.actionKind, request.payload):
        return Err[WebSceneAgentMediaActionReceipt]("web scene agent: media action rejected by runtime")
    if graph.mediaReceipts.len != mediaReceiptIndex + 1:
        return Err[WebSceneAgentMediaActionReceipt]("web scene agent: media action receipt missing")
    let mediaReceipt = graph.mediaReceipts[mediaReceiptIndex]
    if mediaReceipt.slotId != request.slotId || mediaReceipt.actionKind != request.actionKind:
        return Err[WebSceneAgentMediaActionReceipt]("web scene agent: media receipt/action mismatch")
    let streamRes = WebSceneAgentMediaEventStreamFromCursor(graph,
                                                           lifecycleSourceCursor,
                                                           request.streamId,
                                                           request.lifecycleFactIdPrefix)
    if IsErr(streamRes):
        return Err[WebSceneAgentMediaActionReceipt](Error(streamRes))
    let lifecycleStream = Value(streamRes)
    if scene.WebSceneMediaLifecycleAction(request.actionKind):
        if lifecycleStream.eventCount != 1:
            return Err[WebSceneAgentMediaActionReceipt]("web scene agent: lifecycle action did not produce one event")
    elif lifecycleStream.eventCount != 0:
        return Err[WebSceneAgentMediaActionReceipt]("web scene agent: non-lifecycle action produced lifecycle event")
    var receipt: WebSceneAgentMediaActionReceipt
    receipt.schema = WebSceneAgentMediaActionSchema
    receipt.agentId = request.agentId
    receipt.streamId = request.streamId
    receipt.slotId = request.slotId
    receipt.actionKind = request.actionKind
    receipt.payload = request.payload
    receipt.assetCid = mediaReceipt.assetCid
    receipt.kindCode = mediaReceipt.kindCode
    receipt.mediaReceiptIndex = mediaReceiptIndex
    receipt.mediaReceiptStatusCode = mediaReceipt.statusCode
    receipt.playbackState = mediaReceipt.playbackState
    receipt.lifecycleSourceCursor = lifecycleSourceCursor
    receipt.lifecycleNextCursor = lifecycleStream.nextCursor
    receipt.lifecycleDeltaCount = lifecycleStream.eventCount
    receipt.lifecycleStream = lifecycleStream
    receipt.trace = strutil.Join([request.trace, "->typed-action->runtime-receipt"], "")
    receipt.actionCid = WebSceneMediaLifecycleSha256HexText(WebSceneAgentMediaActionReceiptPreimage(receipt))
    return Ok[WebSceneAgentMediaActionReceipt](receipt)
