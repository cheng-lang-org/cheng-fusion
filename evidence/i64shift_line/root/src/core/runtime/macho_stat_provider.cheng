# macho_stat_provider — Darwin stat(2) bridge for the Mach-O provider linker.
#
# The raw stat ABI writes a fixed 144-byte struct into a caller-owned managed
# rawbytes.Bytes buffer. The bridge stays in the provider tier so the kernel
# linker only handles value buffers.
import std/rawbytes
import std/system

@importc("stat")
fn machoStatProviderPhysical(path: cstring, outStat: cstring): int32

@borrows
fn MachoStatProviderInto(path: str, outBytes: var rawbytes.Bytes): int32 =
    if rawbytes.BytesLen(outBytes) < 144:
        panic("macho stat provider: buffer too small")
    return machoStatProviderPhysical(
        strToCStringTemp(path), rawbytes.BytesDataPtr(outBytes))
