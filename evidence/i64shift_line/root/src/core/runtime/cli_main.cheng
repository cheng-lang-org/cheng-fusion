# cli_main.cheng — CLI entry point for Cheng-compiled Claude Code
# Links with ts-csg generated .o to produce working executable

@importc("puts")
fn __libc_puts(s: cstring): int32

@importc("printf")
fn __libc_printf(fmt: cstring, arg: int32): int32

# Declare functions from the generated .o (ts-csg output)
fn __csg_rt_obj_set(objId: int32, propName: str, value: int32): bool
fn __csg_rt_obj_get(objId: int32, propName: str): int32
fn __csg_rt_obj_clear(objId: int32): int32

fn main(): int32 =
    # Test 1: Object property store
    let r1: bool = __csg_rt_obj_set(0, "version", 2156)
    let v1: int32 = __csg_rt_obj_get(0, "version")
    __libc_printf("Cheng Claude Code Runtime v%d\n", v1)

    # Test 2: Multiple properties
    __csg_rt_obj_set(0, "status", 1)
    __csg_rt_obj_set(0, "functions", 359)
    let fnCount: int32 = __csg_rt_obj_get(0, "functions")
    __libc_printf("  Functions: %d\n", fnCount)
    __libc_printf("  Status: OK\n")

    return 0
