import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_style_runtime as style
import cheng/core/runtime/web_layout_runtime as layout

// === UA defaults: Chrome-like default values for common elements ===
// These match the HTML user-agent stylesheet from the CSS spec:
// - display: inline for phrasing elements, block/flow-root for button controls
// - margin-top: vertical spacing between block-level elements
// - margin-left: body margin, list indentation, blockquote indentation
@borrows
fn WebStyleLayoutBridgeUADisplay(tagName: str): int32 =
    if tagName == "span" || tagName == "a" || tagName == "b" || tagName == "i" || tagName == "em" || tagName == "strong" || tagName == "code" || tagName == "small" || tagName == "abbr" || tagName == "sub" || tagName == "sup" || tagName == "label" || tagName == "cite" || tagName == "time" || tagName == "mark" || tagName == "u" || tagName == "s":
        return layout.WebLayoutDisplayInline
    if tagName == "button":
        return layout.WebLayoutDisplayBlock
    if tagName == "input" || tagName == "select" || tagName == "textarea" || tagName == "img" || tagName == "canvas":
        return layout.WebLayoutDisplayInline  # inline-block in Chrome, inline is close enough for layout
    if tagName == "table" || tagName == "tr" || tagName == "td" || tagName == "th" || tagName == "thead" || tagName == "tbody" || tagName == "tfoot" || tagName == "caption" || tagName == "colgroup" || tagName == "col":
        return layout.WebLayoutDisplayTable
    return layout.WebLayoutDisplayBlock

@borrows
fn WebStyleLayoutBridgeTableRole(tagName: str): int32 =
    if tagName == "table":
        return layout.WebLayoutTableRoleTable
    if tagName == "thead" || tagName == "tbody" || tagName == "tfoot":
        return layout.WebLayoutTableRoleSection
    if tagName == "tr":
        return layout.WebLayoutTableRoleRow
    if tagName == "td" || tagName == "th":
        return layout.WebLayoutTableRoleCell
    return layout.WebLayoutTableRoleNone

@borrows
fn WebStyleLayoutBridgeUAMarginTop(tagName: str): int32 =
    if tagName == "body":
        return 8
    if tagName == "h1":
        return 21
    if tagName == "h2":
        return 20
    if tagName == "h3":
        return 16
    if tagName == "h4":
        return 21
    if tagName == "h5":
        return 22
    if tagName == "h6":
        return 24
    if tagName == "p" || tagName == "ul" || tagName == "ol" || tagName == "pre" || tagName == "figure" || tagName == "blockquote" || tagName == "address":
        return 16
    if tagName == "hr":
        return 8
    return 0

@borrows
fn WebStyleLayoutBridgeUAMarginLeft(tagName: str): int32 =
    if tagName == "body":
        return 8
    if tagName == "blockquote" || tagName == "dd" || tagName == "figure":
        return 40
    return 0

// === Form element default sizes (UA defaults for form/widget elements) ===
// These match Chrome's intrinsic sizes when no explicit width/height is set.
// Returns false for elements without a UA default, leaving outWidth/outHeight unchanged.
@borrows
fn WebStyleLayoutBridgeFormDefaults(tagName: str, inputType: str, outWidth: var int32, outHeight: var int32): bool =
    if tagName == "button":
        outWidth = 0; outHeight = 0; return true
    elif tagName == "input":
        if inputType == "text" || inputType == "":
            outWidth = 128; outHeight = 30
        elif inputType == "submit" || inputType == "button":
            outWidth = 60; outHeight = 24
        elif inputType == "checkbox" || inputType == "radio":
            outWidth = 13; outHeight = 13
        elif inputType == "password" || inputType == "email" || inputType == "number" || inputType == "search" || inputType == "url" || inputType == "tel":
            outWidth = 128; outHeight = 30
        else:
            outWidth = 128; outHeight = 30
        return true
    elif tagName == "label":
        outHeight = 20; return true
    elif tagName == "canvas":
        outWidth = 300; outHeight = 150; return true
    elif tagName == "select":
        outWidth = 120; outHeight = 24; return true
    elif tagName == "textarea":
        outWidth = 200; outHeight = 60; return true
    return false

@borrows
fn WebStyleLayoutBridgeInputTypeUsesTextBox(inputType: str): bool =
    return inputType == "" || inputType == "text" || inputType == "password" || inputType == "email" || inputType == "number" || inputType == "search" || inputType == "url" || inputType == "tel"

// === Display mapping: maps CSS display keywords to layout display constants ===
fn WebStyleLayoutBridgeDisplay(computed: var style.WebComputedStyle, out: var int32): bool =
    if !computed.hasDisplay:
        return false
    if style.WebComputedStyleDisplayEquals(computed, "block"):
        out = layout.WebLayoutDisplayBlock
        return true
    if style.WebComputedStyleDisplayEquals(computed, "none"):
        out = layout.WebLayoutDisplayNone
        return true
    if style.WebComputedStyleDisplayEquals(computed, "inline"):
        out = layout.WebLayoutDisplayInline
        return true
    if style.WebComputedStyleDisplayEquals(computed, "flex"):
        out = layout.WebLayoutDisplayFlex
        return true
    if style.WebComputedStyleDisplayEquals(computed, "inline-flex"):
        out = layout.WebLayoutDisplayFlex
        return true
    if style.WebComputedStyleDisplayEquals(computed, "grid"):
        out = layout.WebLayoutDisplayGrid
        return true
    if style.WebComputedStyleDisplayEquals(computed, "inline-grid"):
        out = layout.WebLayoutDisplayGrid
        return true
    if style.WebComputedStyleDisplayEquals(computed, "table"):
        out = layout.WebLayoutDisplayTable
        return true
    if style.WebComputedStyleDisplayEquals(computed, "inline-table"):
        out = layout.WebLayoutDisplayTable
        return true
    if style.WebComputedStyleDisplayEquals(computed, "masonry"):
        out = layout.WebLayoutDisplayMasonry
        return true
    if style.WebComputedStyleDisplayEquals(computed, "table-row"):
        out = layout.WebLayoutDisplayTable
        return true
    if style.WebComputedStyleDisplayEquals(computed, "table-cell"):
        out = layout.WebLayoutDisplayTable
        return true
    if style.WebComputedStyleDisplayEquals(computed, "table-row-group"):
        out = layout.WebLayoutDisplayTable
        return true
    if style.WebComputedStyleDisplayEquals(computed, "table-header-group"):
        out = layout.WebLayoutDisplayTable
        return true
    if style.WebComputedStyleDisplayEquals(computed, "table-footer-group"):
        out = layout.WebLayoutDisplayTable
        return true
    return false

// === Style box creation ===
fn WebStyleLayoutBridgeAppendStyle(tree: var layout.WebLayoutTree,
                                   nodeId: int32,
                                   display: int32,
                                   width: int32,
                                   height: int32,
                                   marginLeft: int32,
                                   marginTop: int32): bool =
    if !layout.WebLayoutTreeAddStyle(tree, nodeId, display, width, height, marginLeft, marginTop):
        return false
    if nodeId >= tree.nextNodeId:
        tree.nextNodeId = nodeId + 1
    return true

// === Child edge creation ===
fn WebStyleLayoutBridgeAppendChild(tree: var layout.WebLayoutTree,
                                   parentNodeId: int32,
                                   childNodeId: int32): bool =
    if !layout.WebLayoutTreeAddChildEdge(tree, parentNodeId, childNodeId):
        return false
    return true

@borrows
fn WebStyleLayoutBridgeParsePositiveInt(text: str, out: var int32): bool =
    if text.len == 0:
        return false
    var parsed: int32
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        parsed = parsed * 10 + int32(ch) - int32('0')
    if parsed <= 0:
        return false
    out = parsed
    return true

@borrows
fn WebStyleLayoutBridgeReadPositiveIntAttr(document: var web.WebDocument,
                                           nodeId: int32,
                                           name: str,
                                           out: var int32): bool =
    var raw: str
    if !web.WebDocumentGetAttribute(document, nodeId, name, raw):
        return true
    if raw == "":
        return true
    return WebStyleLayoutBridgeParsePositiveInt(raw, out)

var WebStyleBridgeDbgTextCalls: int32
var WebStyleBridgeDbgTextRejectEmpty: int32
var WebStyleBridgeDbgTextRejectParent: int32
var WebStyleBridgeDbgTextRejectMeasure: int32
var WebStyleBridgeDbgTwAttrSeen: int32
var WebStyleBridgeDbgTwAttrHit: int32
var WebStyleBridgeDbgTwApplied: int32
var WebStyleBridgeTwWidths: int32[]
var WebStyleBridgeTwWidths: int32[]
var WebStyleBridgeDbgTwVisited: int32
var WebStyleBridgeDbgTwParentFound: int32
var WebStyleBridgeDbgTwStyleIdx: int32

@exportc("cheng_app_debug_bridge_text_stats")
fn WebStyleBridgeDebugTextStats(): int32 =
    return WebStyleBridgeDbgTextCalls * 1000000 + WebStyleBridgeDbgTextRejectEmpty * 10000 + WebStyleBridgeDbgTextRejectParent * 100 + WebStyleBridgeDbgTextRejectMeasure

@exportc("cheng_app_debug_bridge_tw_stats")
fn WebStyleBridgeDebugTwStats(): int32 =
    return WebStyleBridgeDbgTwAttrSeen * 100 + WebStyleBridgeDbgTwAttrHit * 10 + WebStyleBridgeDbgTwApplied

var TwOrdParentIds: int32[] = []
var TwOrdParentCounts: int32[] = []
fn WebStyleBridgeTwTextOrdinal(parentNodeId: int32): int32 =
    for ti in 0..<TwOrdParentIds.len:
        if TwOrdParentIds[ti] == parentNodeId:
            let v = TwOrdParentCounts[ti]
            TwOrdParentCounts[ti] = v + 1
            return v
    add(TwOrdParentIds, parentNodeId)
    add(TwOrdParentCounts, 1)
    return 0

fn WebStyleLayoutBridgeBuildTextNode(document: var web.WebDocument,
                                     textNodeId: int32,
                                     parentNodeId: int32,
                                     tree: var layout.WebLayoutTree): bool =
    WebStyleBridgeDbgTextCalls = WebStyleBridgeDbgTextCalls + 1
    var text: str
    if !web.WebDocumentNodeTextContent(document, textNodeId, text):
        return false
    if text.len == 0:
        WebStyleBridgeDbgTextRejectEmpty = WebStyleBridgeDbgTextRejectEmpty + 1
        return false
    let parentStyleIdx = layout.WebLayoutFindStyleIndex(tree, parentNodeId)
    if parentStyleIdx < 0:
        WebStyleBridgeDbgTextRejectParent = WebStyleBridgeDbgTextRejectParent + 1
        return false
    var fontSize = tree.styles[parentStyleIdx].fontSize
    if tree.styles[parentStyleIdx].renderFontSize > 0:
        fontSize = tree.styles[parentStyleIdx].renderFontSize
    if fontSize <= 0:
        fontSize = 16
    let lineHeight = tree.styles[parentStyleIdx].lineHeight
    let lineHeightPx2 = tree.styles[parentStyleIdx].lineHeightPx2
    // white-space:normal 折叠语义: 纯空白(含换行)文本节点不产生可见行盒
    var hasVisibleChar: bool
    var wsIdx: int32
    while wsIdx < text.len:
        let wsCh = text[wsIdx]
        if wsCh != 32 && wsCh != 10 && wsCh != 13 && wsCh != 9:
            hasVisibleChar = true
        wsIdx = wsIdx + 1
    if !hasVisibleChar:
        return false
    let width = layout.WebLayoutEstimateTextWidthWeightedFamily(text, fontSize, tree.styles[parentStyleIdx].renderFontWeight, tree.styles[parentStyleIdx].fontFamily)
    let height = layout.WebLayoutEstimateTextHeightWithLineHeightPx2Family(text, fontSize, lineHeight, lineHeightPx2, tree.styles[parentStyleIdx].renderFontWeight, tree.styles[parentStyleIdx].fontFamily)
    if width <= 0 || height <= 0:
        WebStyleBridgeDbgTextRejectMeasure = WebStyleBridgeDbgTextRejectMeasure + 1
        return false
    # 浏览器整形实测宽覆盖(data-csg-tw): 第 ordinal 个文本子节点取第 ordinal 个逗号值
    var twAttr: str
    var twFound: bool = web.WebDocumentGetAttribute(document, parentNodeId, "data-csg-tw", twAttr)
    if !twFound:
        twFound = web.WebDocumentGetAttribute(document, parentNodeId, "csgTw", twAttr)
    WebStyleBridgeDbgTwAttrSeen = WebStyleBridgeDbgTwAttrSeen + 1
    if twFound && twAttr.len > 0:
        WebStyleBridgeDbgTwAttrHit = WebStyleBridgeDbgTwAttrHit + 1
        var ordinal: int32
        let sibCount: int32 = web.WebDocumentChildCount(document, parentNodeId)
        var sibIdx: int32
        while sibIdx < sibCount:
            let sibId: int32 = web.WebDocumentChildAt(document, parentNodeId, sibIdx)
            if sibId == textNodeId:
                break
            if web.WebDocumentNodeKind(document, sibId) == web.WebNodeKindText:
                ordinal = ordinal + 1
            sibIdx = sibIdx + 1
        let attrLen: int32 = twAttr.len
        var pos: int32
        var tokNo: int32
        var acc: int32
        var haveTok: bool
        var matched: bool
        var overrideW: int32
        while pos <= attrLen && !matched:
            if pos == attrLen || strings.SliceBytes(twAttr, pos, pos) == ",":
                if tokNo == ordinal && haveTok:
                    overrideW = acc
                    matched = true
                tokNo = tokNo + 1
                acc = 0
                haveTok = false
            else:
                var dch: int32
                while dch < 10:
                    if strings.SliceBytes(twAttr, pos, pos) == strings.SliceBytes("0123456789", dch, dch):
                        acc = acc * 10 + dch
                        haveTok = true
                    dch = dch + 1
            pos = pos + 1
        if matched && overrideW > 0:
            WebStyleBridgeDbgTwApplied = WebStyleBridgeDbgTwApplied + 1
            width = overrideW
    var ordinalOfText: int32
    let ordSibCount: int32 = web.WebDocumentChildCount(document, parentNodeId)
    var ordSi: int32
    while ordSi < ordSibCount:
        let ordSib: int32 = web.WebDocumentChildAt(document, parentNodeId, ordSi)
        if ordSib == textNodeId:
            break
        if web.WebDocumentNodeKind(document, ordSib) == web.WebNodeKindText:
            ordinalOfText = ordinalOfText + 1
        ordSi = ordSi + 1
    var flatJ: int32
    var flatState: int32
    var flatTok: int32
    while flatJ < WebStyleBridgeTwWidths.len && flatState != 2:
        let v: int32 = WebStyleBridgeTwWidths[flatJ]
        if flatState == 0:
            if v == parentNodeId:
                flatState = 1
        else:
            if v < 0:
                flatState = 2
            else:
                if flatTok == ordinalOfText && v > 0:
                    width = v
                    WebStyleBridgeDbgTwApplied = WebStyleBridgeDbgTwApplied + 1
                flatTok = flatTok + 1
        flatJ = flatJ + 1
    // chrome 侧按文本子节点序数记录实测宽度列表
    var twOrdinal: int32 = WebStyleBridgeTwTextOrdinal(parentNodeId)
    var twAttr2: str
    if web.WebDocumentGetAttribute(document, parentNodeId, "data-csg-tw", twAttr2):
        var segIdx: int32
        var curW: int32
        var haveSeg: bool
        var allDig: bool = true
        for tci in 0..<twAttr2.len:
            let tch = twAttr2[tci]
            if tch == ',':
                if segIdx == twOrdinal:
                    break
                segIdx = segIdx + 1
                curW = 0
                haveSeg = false
                allDig = true
            elif tch >= '0' && tch <= '9':
                curW = curW * 10 + int32(tch) - int32('0')
                haveSeg = true
            else:
                allDig = false
        if segIdx == twOrdinal && haveSeg && allDig && curW > 0:
            width = curW
            WebStyleBridgeDbgTwApplied = WebStyleBridgeDbgTwApplied + 1
    if !WebStyleLayoutBridgeAppendStyle(tree, textNodeId, layout.WebLayoutDisplayInline, width, height, 0, 0):
        return false
    let textStyleIdx = layout.WebLayoutFindStyleIndex(tree, textNodeId)
    if textStyleIdx < 0:
        return false
    tree.styles[textStyleIdx].textContent = text
    tree.styles[textStyleIdx].fontSize = fontSize
    tree.styles[textStyleIdx].renderFontSize = fontSize
    tree.styles[textStyleIdx].lineHeight = lineHeight
    tree.styles[textStyleIdx].lineHeightPx2 = lineHeightPx2
    tree.styles[textStyleIdx].renderFontWeight = tree.styles[parentStyleIdx].renderFontWeight
    tree.styles[textStyleIdx].fontFamily = tree.styles[parentStyleIdx].fontFamily
    tree.styles[textStyleIdx].visible = tree.styles[parentStyleIdx].visible
    tree.styles[textStyleIdx].opacity = tree.styles[parentStyleIdx].opacity
    tree.styles[textStyleIdx].overflowX = layout.WebLayoutOverflowVisible
    tree.styles[textStyleIdx].overflowY = layout.WebLayoutOverflowVisible
    tree.styles[textStyleIdx].textAlign = tree.styles[parentStyleIdx].textAlign
    tree.styles[textStyleIdx].whiteSpaceNowrap = tree.styles[parentStyleIdx].whiteSpaceNowrap
    tree.styles[textStyleIdx].wordBreakBreakAll = tree.styles[parentStyleIdx].wordBreakBreakAll
    tree.styles[textStyleIdx].textOverflowEllipsis = tree.styles[parentStyleIdx].textOverflowEllipsis
    if !WebStyleLayoutBridgeAppendChild(tree, parentNodeId, textNodeId):
        return false
    return true

// --- Category 1: Position bridge ---
// Maps position keyword, z-index, and top/right/bottom/left offsets
fn WebStyleLayoutBridgeApplyPosition(computed: var style.WebComputedStyle,
                                     nodeId: int32,
                                     tree: var layout.WebLayoutTree): bool =
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if computed.hasPosition:
        if style.WebComputedStylePositionEquals(computed, "static"):
            tree.styles[styleIdx].position = layout.WebLayoutPositionStatic
        elif style.WebComputedStylePositionEquals(computed, "relative"):
            tree.styles[styleIdx].position = layout.WebLayoutPositionRelative
        elif style.WebComputedStylePositionEquals(computed, "absolute"):
            tree.styles[styleIdx].position = layout.WebLayoutPositionAbsolute
        elif style.WebComputedStylePositionEquals(computed, "fixed"):
            tree.styles[styleIdx].position = layout.WebLayoutPositionFixed
        elif style.WebComputedStylePositionEquals(computed, "sticky"):
            tree.styles[styleIdx].position = layout.WebLayoutPositionSticky
    if computed.hasFloat:
        if style.WebComputedStyleFloatEquals(computed, "left"):
            tree.styles[styleIdx].floatKind = layout.WebLayoutFloatLeft
        elif style.WebComputedStyleFloatEquals(computed, "right"):
            tree.styles[styleIdx].floatKind = layout.WebLayoutFloatRight
        else:
            tree.styles[styleIdx].floatKind = layout.WebLayoutFloatNone
    if computed.hasZIndex:
        var zIndexVal: int32
        if style.WebComputedStyleZIndexInt(computed, zIndexVal):
            tree.styles[styleIdx].zIndex = zIndexVal
    var offsetVal: int32
    if style.WebComputedStyleTopPx(computed, offsetVal):
        tree.styles[styleIdx].offsetTop = offsetVal
        tree.styles[styleIdx].hasOffsetTop = true
    if style.WebComputedStyleRightPx(computed, offsetVal):
        tree.styles[styleIdx].offsetRight = offsetVal
        tree.styles[styleIdx].hasOffsetRight = true
    if style.WebComputedStyleBottomPx(computed, offsetVal):
        tree.styles[styleIdx].offsetBottom = offsetVal
        tree.styles[styleIdx].hasOffsetBottom = true
    if style.WebComputedStyleLeftPx(computed, offsetVal):
        tree.styles[styleIdx].offsetLeft = offsetVal
        tree.styles[styleIdx].hasOffsetLeft = true
    if style.WebComputedStyleMarginLeftEquals(computed, "auto"):
        tree.styles[styleIdx].marginLeftAuto = true
    if style.WebComputedStyleMarginRightEquals(computed, "auto"):
        tree.styles[styleIdx].marginRightAuto = true
    return true

// --- Category 2: Overflow + Visibility + Opacity bridge ---
fn WebStyleLayoutBridgeApplyOverflowVisibilityOpacity(computed: var style.WebComputedStyle,
                                                      nodeId: int32,
                                                      tree: var layout.WebLayoutTree): bool =
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if computed.hasOverflow:
        if style.WebComputedStyleOverflowEquals(computed, "visible"):
            tree.styles[styleIdx].overflowX = layout.WebLayoutOverflowVisible
            tree.styles[styleIdx].overflowY = layout.WebLayoutOverflowVisible
        elif style.WebComputedStyleOverflowEquals(computed, "hidden"):
            tree.styles[styleIdx].overflowX = layout.WebLayoutOverflowHidden
            tree.styles[styleIdx].overflowY = layout.WebLayoutOverflowHidden
        elif style.WebComputedStyleOverflowEquals(computed, "scroll"):
            tree.styles[styleIdx].overflowX = layout.WebLayoutOverflowScroll
            tree.styles[styleIdx].overflowY = layout.WebLayoutOverflowScroll
        elif style.WebComputedStyleOverflowEquals(computed, "auto"):
            tree.styles[styleIdx].overflowX = layout.WebLayoutOverflowAuto
            tree.styles[styleIdx].overflowY = layout.WebLayoutOverflowAuto
    if computed.hasVisibility:
        if style.WebComputedStyleVisibilityEquals(computed, "hidden"):
            tree.styles[styleIdx].visible = false
        elif style.WebComputedStyleVisibilityEquals(computed, "collapse"):
            tree.styles[styleIdx].visible = false
        else:
            tree.styles[styleIdx].visible = true
    if computed.hasOpacity:
        var opacityVal: int32
        if style.WebComputedStyleOpacityInt(computed, opacityVal):
            tree.styles[styleIdx].opacity = opacityVal
    return true

@borrows
fn WebStyleLayoutBridgeApplyTextAlign(document: var web.WebDocument,
                                      computed: var style.WebComputedStyle,
                                      nodeId: int32,
                                      tagName: str,
                                      tree: var layout.WebLayoutTree): bool =
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    var textAlign = layout.WebLayoutTextAlignLeft
    let parentNodeId = web.WebDocumentNodeParent(document, nodeId)
    let parentStyleIdx = layout.WebLayoutFindStyleIndex(tree, parentNodeId)
    if parentStyleIdx >= 0:
        textAlign = tree.styles[parentStyleIdx].textAlign
    if tagName == "button":
        textAlign = layout.WebLayoutTextAlignCenter
    if computed.hasTextAlign:
        if style.WebComputedStyleTextAlignEquals(computed, "left") || style.WebComputedStyleTextAlignEquals(computed, "start"):
            textAlign = layout.WebLayoutTextAlignLeft
        elif style.WebComputedStyleTextAlignEquals(computed, "center"):
            textAlign = layout.WebLayoutTextAlignCenter
        elif style.WebComputedStyleTextAlignEquals(computed, "right") || style.WebComputedStyleTextAlignEquals(computed, "end"):
            textAlign = layout.WebLayoutTextAlignRight
    return layout.WebLayoutSetTextAlign(tree, nodeId, textAlign)

fn WebStyleLayoutBridgeApplyTextOverflow(computed: var style.WebComputedStyle,
                                         nodeId: int32,
                                         tree: var layout.WebLayoutTree): bool =
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if computed.hasWhiteSpace:
        tree.styles[styleIdx].whiteSpaceNowrap = style.WebComputedStyleWhiteSpaceEquals(computed, "nowrap") || style.WebComputedStyleWhiteSpaceEquals(computed, "pre")
        tree.styles[styleIdx].whiteSpaceExplicit = true
    if computed.hasWordBreak:
        tree.styles[styleIdx].wordBreakBreakAll = style.WebComputedStyleWordBreakEquals(computed, "break-all")
    if computed.hasTextOverflow:
        tree.styles[styleIdx].textOverflowEllipsis = style.WebComputedStyleTextOverflowEquals(computed, "ellipsis")
    return true

// --- Category 3: Flexbox bridge ---
// Maps flex-wrap, align-content, align-self, order
fn WebStyleLayoutBridgeApplyFlexbox(computed: var style.WebComputedStyle,
                                    nodeId: int32,
                                    tree: var layout.WebLayoutTree): bool =
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    if computed.hasFlexDirection:
        if style.WebComputedStyleFlexDirectionEquals(computed, "row"):
            tree.styles[styleIdx].flexDirection = layout.WebLayoutFlexDirectionRow
        elif style.WebComputedStyleFlexDirectionEquals(computed, "column"):
            tree.styles[styleIdx].flexDirection = layout.WebLayoutFlexDirectionColumn
    if computed.hasJustifyContent:
        if style.WebComputedStyleJustifyContentEquals(computed, "flex-start"):
            tree.styles[styleIdx].justifyContent = layout.WebLayoutJustifyContentFlexStart
        elif style.WebComputedStyleJustifyContentEquals(computed, "center"):
            tree.styles[styleIdx].justifyContent = layout.WebLayoutJustifyContentCenter
        elif style.WebComputedStyleJustifyContentEquals(computed, "flex-end"):
            tree.styles[styleIdx].justifyContent = layout.WebLayoutJustifyContentFlexEnd
        elif style.WebComputedStyleJustifyContentEquals(computed, "space-between"):
            tree.styles[styleIdx].justifyContent = layout.WebLayoutJustifyContentSpaceBetween
        elif style.WebComputedStyleJustifyContentEquals(computed, "space-around"):
            tree.styles[styleIdx].justifyContent = layout.WebLayoutJustifyContentSpaceAround
    if computed.hasAlignItems:
        if style.WebComputedStyleAlignItemsEquals(computed, "flex-start"):
            tree.styles[styleIdx].alignItems = layout.WebLayoutAlignItemsFlexStart
        elif style.WebComputedStyleAlignItemsEquals(computed, "center"):
            tree.styles[styleIdx].alignItems = layout.WebLayoutAlignItemsCenter
        elif style.WebComputedStyleAlignItemsEquals(computed, "flex-end"):
            tree.styles[styleIdx].alignItems = layout.WebLayoutAlignItemsFlexEnd
        elif style.WebComputedStyleAlignItemsEquals(computed, "stretch"):
            tree.styles[styleIdx].alignItems = layout.WebLayoutAlignItemsStretch
    if computed.hasFlex:
        var flexVal: int32
        if style.WebComputedStyleFlexInt(computed, flexVal):
            tree.styles[styleIdx].flex = flexVal
    if computed.hasFlexShrink:
        var flexShrinkVal: int32
        if !style.WebComputedStyleFlexShrinkInt(computed, flexShrinkVal):
            return false
        if flexShrinkVal < 0:
            return false
        tree.styles[styleIdx].flexShrink = flexShrinkVal
    if computed.hasFlexWrap:
        if style.WebComputedStyleFlexWrapEquals(computed, "nowrap"):
            if !layout.WebLayoutSetFlexWrap(tree, nodeId, 0):
                return false
        elif style.WebComputedStyleFlexWrapEquals(computed, "wrap"):
            if !layout.WebLayoutSetFlexWrap(tree, nodeId, 1):
                return false
        elif style.WebComputedStyleFlexWrapEquals(computed, "wrap-reverse"):
            if !layout.WebLayoutSetFlexWrap(tree, nodeId, 2):
                return false
    if computed.hasAlignContent:
        if style.WebComputedStyleAlignContentEquals(computed, "flex-start"):
            if !layout.WebLayoutSetAlignContent(tree, nodeId, 1):
                return false
        elif style.WebComputedStyleAlignContentEquals(computed, "flex-end"):
            if !layout.WebLayoutSetAlignContent(tree, nodeId, 2):
                return false
        elif style.WebComputedStyleAlignContentEquals(computed, "center"):
            if !layout.WebLayoutSetAlignContent(tree, nodeId, 3):
                return false
        elif style.WebComputedStyleAlignContentEquals(computed, "stretch"):
            if !layout.WebLayoutSetAlignContent(tree, nodeId, 4):
                return false
        elif style.WebComputedStyleAlignContentEquals(computed, "space-between"):
            if !layout.WebLayoutSetAlignContent(tree, nodeId, 5):
                return false
        elif style.WebComputedStyleAlignContentEquals(computed, "space-around"):
            if !layout.WebLayoutSetAlignContent(tree, nodeId, 6):
                return false
    if computed.hasAlignSelf:
        if style.WebComputedStyleAlignSelfEquals(computed, "auto"):
            if !layout.WebLayoutSetAlignSelf(tree, nodeId, 1):
                return false
        elif style.WebComputedStyleAlignSelfEquals(computed, "flex-start"):
            if !layout.WebLayoutSetAlignSelf(tree, nodeId, 2):
                return false
        elif style.WebComputedStyleAlignSelfEquals(computed, "flex-end"):
            if !layout.WebLayoutSetAlignSelf(tree, nodeId, 3):
                return false
        elif style.WebComputedStyleAlignSelfEquals(computed, "center"):
            if !layout.WebLayoutSetAlignSelf(tree, nodeId, 4):
                return false
        elif style.WebComputedStyleAlignSelfEquals(computed, "baseline"):
            if !layout.WebLayoutSetAlignSelf(tree, nodeId, 5):
                return false
        elif style.WebComputedStyleAlignSelfEquals(computed, "stretch"):
            if !layout.WebLayoutSetAlignSelf(tree, nodeId, 6):
                return false
    if computed.hasOrder:
        var orderVal: int32
        if style.WebComputedStyleOrderInt(computed, orderVal):
            if !layout.WebLayoutSetOrder(tree, nodeId, orderVal):
                return false
    return true

// --- Category 4: Box model extensions bridge ---
// Maps box-sizing, min/max-width/height
fn WebStyleLayoutBridgeApplyBoxModel(computed: var style.WebComputedStyle,
                                     nodeId: int32,
                                     isImgTag: bool,
                                     tree: var layout.WebLayoutTree): bool =
    if computed.hasBoxSizing:
        if style.WebComputedStyleBoxSizingEquals(computed, "content-box"):
            if !layout.WebLayoutSetBoxSizing(tree, nodeId, 0):
                return false
        elif style.WebComputedStyleBoxSizingEquals(computed, "border-box"):
            if !layout.WebLayoutSetBoxSizing(tree, nodeId, 1):
                return false
    var dimVal: int32
    if style.WebComputedStyleMinWidthPx(computed, dimVal):
        if !layout.WebLayoutSetMinWidth(tree, nodeId, dimVal):
            return false
    if style.WebComputedStyleMaxWidthPx(computed, dimVal):
        if !layout.WebLayoutSetMaxWidth(tree, nodeId, dimVal):
            return false
    if style.WebComputedStyleMinHeightPx(computed, dimVal):
        if !layout.WebLayoutSetMinHeight(tree, nodeId, dimVal):
            return false
    if style.WebComputedStyleMaxHeightPx(computed, dimVal):
        if !layout.WebLayoutSetMaxHeight(tree, nodeId, dimVal):
            return false
    # 替换元素自动最小尺寸: img 有显式 width 时以该值为收缩下限(CSS Flexbox 自动最小尺寸语义)
    if isImgTag:
        var imgWidthPx: int32
        if style.WebComputedStyleWidthPx(computed, imgWidthPx) && imgWidthPx > 0:
            if !layout.WebLayoutSetMinWidth(tree, nodeId, imgWidthPx):
                return false
    var borderVal: int32
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx >= 0:
        if style.WebComputedStyleBorderTopWidthPx(computed, borderVal):
            tree.styles[styleIdx].borderTopWidth = borderVal
        if style.WebComputedStyleBorderRightWidthPx(computed, borderVal):
            tree.styles[styleIdx].borderRightWidth = borderVal
        if style.WebComputedStyleBorderBottomWidthPx(computed, borderVal):
            tree.styles[styleIdx].borderBottomWidth = borderVal
        if style.WebComputedStyleBorderLeftWidthPx(computed, borderVal):
            tree.styles[styleIdx].borderLeftWidth = borderVal
    return true

// --- Category 5: Grid bridge ---
// Parses grid-template-columns/rows into track definitions,
// applies column-gap/row-gap as gap, and stores grid-column/row as items

@borrows
fn WebStyleLayoutBridgeParseGridPxTrack(template: str, kind: int32,
                                        nodeId: int32,
                                        tree: var layout.WebLayoutTree): bool =
    if template.len == 0:
        return true
    var sizes: int32[]
    var units: int32[]
    var tokenStart: int32
    var i: int32
    while i < template.len:
        let ch = template[i]
        if ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r':
            if i > tokenStart:
                let tokenLen = i - tokenStart
                if tokenLen >= 3:
                    let last = i - 1
                    if template[last - 1] == 'p' && template[last] == 'x':
                        var val: int32
                        for j in tokenStart..<last - 1:
                            let digit = template[j]
                            if digit >= '0' && digit <= '9':
                                val = val * 10 + int32(digit) - int32('0')
                            else:
                                return false
                        add(sizes, val)
                        add(units, 0)
                    elif template[last] == '%':
                        var val: int32
                        for j in tokenStart..<last:
                            let digit = template[j]
                            if digit >= '0' && digit <= '9':
                                val = val * 10 + int32(digit) - int32('0')
                            else:
                                return false
                        add(sizes, val)
                        add(units, 2)
            tokenStart = i + 1
        i = i + 1
    // Last token
    if i > tokenStart:
        let tokenLen = i - tokenStart
        if tokenLen >= 3:
            let last = i - 1
            if template[last - 1] == 'p' && template[last] == 'x':
                var val: int32
                for j in tokenStart..<last - 1:
                    let digit = template[j]
                    if digit >= '0' && digit <= '9':
                        val = val * 10 + int32(digit) - int32('0')
                    else:
                        return false
                add(sizes, val)
                add(units, 0)
            elif template[last] == '%':
                var val: int32
                for j in tokenStart..<last:
                    let digit = template[j]
                    if digit >= '0' && digit <= '9':
                        val = val * 10 + int32(digit) - int32('0')
                    else:
                        return false
                add(sizes, val)
                add(units, 2)
    if sizes.len == 0:
        return true
    return layout.WebLayoutSetGridTracks(tree, nodeId, kind, sizes, units)

fn WebStyleLayoutBridgeApplyGrid(computed: var style.WebComputedStyle,
                                 nodeId: int32,
                                 tree: var layout.WebLayoutTree): bool =
    if computed.hasGridTemplateColumns:
        var templateVal: str
        if style.WebComputedStyleGridTemplateColumnsStr(computed, templateVal):
            if !WebStyleLayoutBridgeParseGridPxTrack(templateVal, 0, nodeId, tree):
                return false
    if computed.hasGridTemplateRows:
        var templateVal: str
        if style.WebComputedStyleGridTemplateRowsStr(computed, templateVal):
            if !WebStyleLayoutBridgeParseGridPxTrack(templateVal, 1, nodeId, tree):
                return false
    if computed.hasColumnGap || computed.hasRowGap:
        let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
        if styleIdx >= 0:
            var gapVal: int32
            if style.WebComputedStyleColumnGapPx(computed, gapVal):
                tree.styles[styleIdx].gap = gapVal
            elif style.WebComputedStyleRowGapPx(computed, gapVal):
                tree.styles[styleIdx].gap = gapVal
    return true

fn WebStyleLayoutBridgeApplyMasonry(document: var web.WebDocument,
                                    nodeId: int32,
                                    tree: var layout.WebLayoutTree): bool =
    let styleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    var minColumnWidth = tree.styles[styleIdx].masonryMinColumnWidth
    var minColumns = tree.styles[styleIdx].masonryMinColumns
    var maxColumns = tree.styles[styleIdx].masonryMaxColumns
    var estimatedItemHeight = tree.styles[styleIdx].masonryEstimatedItemHeight
    if !WebStyleLayoutBridgeReadPositiveIntAttr(document, nodeId, "data-csg-masonry-min-column-width", minColumnWidth):
        return false
    if !WebStyleLayoutBridgeReadPositiveIntAttr(document, nodeId, "data-csg-masonry-min-columns", minColumns):
        return false
    if !WebStyleLayoutBridgeReadPositiveIntAttr(document, nodeId, "data-csg-masonry-max-columns", maxColumns):
        return false
    if !WebStyleLayoutBridgeReadPositiveIntAttr(document, nodeId, "data-csg-masonry-estimated-item-height", estimatedItemHeight):
        return false
    if !layout.WebLayoutSetMasonryStyle(tree, nodeId,
        minColumnWidth,
        minColumns,
        maxColumns,
        estimatedItemHeight,
        tree.styles[styleIdx].gap):
        return false
    var modelAttr: str
    if web.WebDocumentGetAttribute(document, nodeId, "data-csg-masonry-model", modelAttr):
        if modelAttr == "virtualized-react":
            return layout.WebLayoutSetMasonryModel(tree, nodeId, layout.WebLayoutMasonryModelVirtualizedReact)
        if modelAttr != "":
            return false
    return true

// --- Category 6: Gradient/Shadow bridge ---
// Stores background-image, box-shadow, and text-shadow as string values
// Note: The layout runtime does not currently have dedicated fields for these
// visual properties. The getter functions read from the computed style, and
// these values are accessible at render time via the computed style directly.
// The bridge confirms the computed style has these values available.
fn WebStyleLayoutBridgeApplyVisualStrings(computed: var style.WebComputedStyle,
                                           nodeId: int32,
                                           tree: var layout.WebLayoutTree): bool =
    // Background-image, box-shadow, and text-shadow are read from computed
    // style at render time. The bridge ensures the computed style is populated
    // correctly (done by WebStyleSheetComputeStyle). No layout tree fields
    // exist for these values, so this is a pass-through verification.
    return true

// === Build element (enhanced with all bridge categories) ===
fn WebStyleLayoutBridgeBuildElementDepth(document: var web.WebDocument,
                                    sheet: var style.WebStyleSheet,
                                    nodeId: int32,
                                    tree: var layout.WebLayoutTree,
                                    depth: int32): bool =
    if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
        return false
    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, nodeId, computed):
        return false

    var tagName: str
    if !web.WebDocumentNodeTagName(document, nodeId, tagName):
        tagName = ""

    var display = 0
    var width = 0
    var height = 0
    var widthPercent = 0
    var heightPercent = 0
    var marginLeft = 0
    var marginTop = 0
    var marginRight = 0
    var marginBottom = 0
    var inputType: str
    if tagName == "input":
        if !web.WebDocumentGetAttribute(document, nodeId, "type", inputType):
            inputType = ""
    if !WebStyleLayoutBridgeDisplay(computed, display):
        display = WebStyleLayoutBridgeUADisplay(tagName)
    # inline-block 语义 = 行内流 + 可定宽高; 引擎以 Inline+inlineLevel 表达,
    # 缺失会使控件落入块子路径(丢失父级 text-align 对齐)
    var isInlineBlock = false
    if style.WebComputedStyleDisplayEquals(computed, "inline-block"):
        display = layout.WebLayoutDisplayInline
        isInlineBlock = true
    if nodeId == 771:
        let blk = style.WebComputedStyleDisplayEquals(computed, "block")
        let non = style.WebComputedStyleDisplayEquals(computed, "none")
    let widthFromCss = style.WebComputedStyleWidthPx(computed, width)
    if !widthFromCss:
        width = 0
    if style.WebComputedStyleWidthPercent(computed, widthPercent):
        width = 0
    let heightFromCss = style.WebComputedStyleHeightPx(computed, height)
    if !heightFromCss:
        height = 0
    if style.WebComputedStyleHeightPercent(computed, heightPercent):
        height = 0
    # Apply form element UA default sizes when no explicit width/height
    if width == 0 || height == 0:
        var formW: int32
        var formH: int32
        if WebStyleLayoutBridgeFormDefaults(tagName, inputType, formW, formH):
            if width == 0:
                width = formW
            if height == 0:
                height = formH
    # Canvas/svg: read width/height from DOM attributes (override UA defaults)
    if tagName == "canvas" || tagName == "svg":
        var attrW: str
        if web.WebDocumentGetAttribute(document, nodeId, "width", attrW) && attrW != "":
            var parsedW: int32
            for ci in 0..<attrW.len:
                let ch = attrW[ci]
                if ch >= '0' && ch <= '9':
                    parsedW = parsedW * 10 + int32(ch) - int32('0')
            if parsedW > 0:
                width = parsedW
        var attrH: str
        if web.WebDocumentGetAttribute(document, nodeId, "height", attrH) && attrH != "":
            var parsedH: int32
            for ci in 0..<attrH.len:
                let ch = attrH[ci]
                if ch >= '0' && ch <= '9':
                    parsedH = parsedH * 10 + int32(ch) - int32('0')
            if parsedH > 0:
                height = parsedH
    if !style.WebComputedStyleMarginLeftPx(computed, marginLeft):
        marginLeft = WebStyleLayoutBridgeUAMarginLeft(tagName)
    if !style.WebComputedStyleMarginTopPx(computed, marginTop):
        marginTop = WebStyleLayoutBridgeUAMarginTop(tagName)
    if !style.WebComputedStyleMarginRightPx(computed, marginRight):
        marginRight = 0
    if !style.WebComputedStyleMarginBottomPx(computed, marginBottom):
        marginBottom = 0

    if !WebStyleLayoutBridgeAppendStyle(tree, nodeId, display, width, height, marginLeft, marginTop):
        return false
    // Var struct workaround: directly re-assign key fields after AppendStyle
    let _psIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if _psIdx >= 0:
        tree.styles[_psIdx].display = display
        tree.styles[_psIdx].hasWidthDeclared = widthFromCss || widthPercent > 0
        tree.styles[_psIdx].width = width
        if widthPercent > 0:
            tree.styles[_psIdx].width = 0 - widthPercent
        tree.styles[_psIdx].height = height
        if heightPercent > 0:
            tree.styles[_psIdx].height = 0 - heightPercent
        tree.styles[_psIdx].marginLeft = marginLeft
        tree.styles[_psIdx].marginTop = marginTop
        tree.styles[_psIdx].marginRight = marginRight
        tree.styles[_psIdx].marginBottom = marginBottom
        if isInlineBlock:
            tree.styles[_psIdx].inlineLevel = true
        tree.styles[_psIdx].nodeId = nodeId
        tree.styles[_psIdx].visible = true
        # visibility 为继承属性: 计算样式未显式声明时取父链值(chrome 语义)。
        # 显式声明的元素随后由 ApplyOverflowVisibilityOpacity 按计算值覆盖。
        if !computed.hasVisibility:
            let parentNodeIdV = web.WebDocumentParentOf(document, nodeId)
            if parentNodeIdV != 0:
                let parentStyleIdxV = layout.WebLayoutFindStyleIndex(tree, parentNodeIdV)
                if parentStyleIdxV >= 0:
                    tree.styles[_psIdx].visible = tree.styles[parentStyleIdxV].visible
        tree.styles[_psIdx].opacity = 255
        if style.WebComputedStyleDisplayEquals(computed, "inline-flex") || style.WebComputedStyleDisplayEquals(computed, "inline-grid"):
            tree.styles[_psIdx].inlineLevel = true

    # Bridge padding from computed style to layout style box
    var paddingVal: int32
    var fontSizeVal: int32
    var lineHeightVal: int32
    var lineHeightPx2Val: int32
    var fontWeightVal: int32
    let psIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
    if psIdx >= 0:
        if style.WebComputedStyleFontSizePx(computed, fontSizeVal):
            if fontSizeVal > 0:
                tree.styles[psIdx].fontSize = fontSizeVal
                tree.styles[psIdx].renderFontSize = fontSizeVal
        if style.WebComputedStyleLineHeightPx(computed, tree.styles[psIdx].fontSize, lineHeightVal):
            if lineHeightVal > 0:
                tree.styles[psIdx].lineHeight = lineHeightVal
        if style.WebComputedStyleLineHeightPx2(computed, tree.styles[psIdx].fontSize, lineHeightPx2Val):
            if lineHeightPx2Val > 0:
                tree.styles[psIdx].lineHeightPx2 = lineHeightPx2Val
        if style.WebComputedStyleFontWeightInt(computed, fontWeightVal):
            if fontWeightVal > 0:
                tree.styles[psIdx].renderFontWeight = fontWeightVal
        if style.WebComputedStyleFontFamilyIsMonospace(computed):
            tree.styles[psIdx].fontFamily = layout.WebLayoutFontFamilyMono
        if style.WebComputedStyleFontFamilyContainsIcon(computed):
            tree.styles[psIdx].fontFamily = layout.WebLayoutFontFamilyIcon
        if style.WebComputedStylePaddingLeftPx(computed, paddingVal):
            tree.styles[psIdx].paddingLeft = paddingVal
        if style.WebComputedStylePaddingTopPx(computed, paddingVal):
            tree.styles[psIdx].paddingTop = paddingVal
        if style.WebComputedStylePaddingRightPx(computed, paddingVal):
            tree.styles[psIdx].paddingRight = paddingVal
        if style.WebComputedStylePaddingBottomPx(computed, paddingVal):
            tree.styles[psIdx].paddingBottom = paddingVal

        # Chrome defaults td/th padding to 1px
        if tagName == "td" || tagName == "th":
            if tree.styles[psIdx].paddingLeft == 0:
                tree.styles[psIdx].paddingLeft = 1
            if tree.styles[psIdx].paddingTop == 0:
                tree.styles[psIdx].paddingTop = 1
            if tree.styles[psIdx].paddingRight == 0:
                tree.styles[psIdx].paddingRight = 1
            if tree.styles[psIdx].paddingBottom == 0:
                tree.styles[psIdx].paddingBottom = 1

        # Chrome UA: ul/ol indent via padding-inline-start:40px (not margin)
        if tagName == "ul" || tagName == "ol":
            if tree.styles[psIdx].paddingLeft == 0:
                tree.styles[psIdx].paddingLeft = 40

        # li: list-style-position outside by default (marker in padding area)
        if tagName == "li":
            if tree.styles[psIdx].paddingLeft == 0:
                tree.styles[psIdx].paddingLeft = 0

    // Apply all extra computed style properties
    var isImgTag: bool = tagName == "img"
    if !WebStyleLayoutBridgeApplyPosition(computed, nodeId, tree):
        return false

    if !WebStyleLayoutBridgeApplyOverflowVisibilityOpacity(computed, nodeId, tree):
        return false
    if !WebStyleLayoutBridgeApplyTextAlign(document, computed, nodeId, tagName, tree):
        return false
    if !WebStyleLayoutBridgeApplyTextOverflow(computed, nodeId, tree):
        return false
    if !WebStyleLayoutBridgeApplyFlexbox(computed, nodeId, tree):
        return false
    if !WebStyleLayoutBridgeApplyBoxModel(computed, nodeId, isImgTag, tree):
        return false

    if tagName == "input" && !heightFromCss && WebStyleLayoutBridgeInputTypeUsesTextBox(inputType):
        let inputStyleIdx = layout.WebLayoutFindStyleIndex(tree, nodeId)
        if inputStyleIdx >= 0:
            var controlLineHeight: int32 = tree.styles[inputStyleIdx].lineHeight
            if controlLineHeight <= 0:
                if tree.styles[inputStyleIdx].lineHeightPx2 > 0:
                    controlLineHeight = (tree.styles[inputStyleIdx].lineHeightPx2 + 1) / 2
                elif tree.styles[inputStyleIdx].fontSize > 0:
                    controlLineHeight = (tree.styles[inputStyleIdx].fontSize * 3 + 1) / 2
                else:
                    controlLineHeight = 20
            var controlHeight: int32 = controlLineHeight + tree.styles[inputStyleIdx].paddingTop + tree.styles[inputStyleIdx].paddingBottom + tree.styles[inputStyleIdx].borderTopWidth + tree.styles[inputStyleIdx].borderBottomWidth
            if controlHeight > tree.styles[inputStyleIdx].height:
                tree.styles[inputStyleIdx].height = controlHeight
    if !WebStyleLayoutBridgeApplyGrid(computed, nodeId, tree):
        return false
    if display == layout.WebLayoutDisplayMasonry:
        if !WebStyleLayoutBridgeApplyMasonry(document, nodeId, tree):
            return false
    if !WebStyleLayoutBridgeApplyVisualStrings(computed, nodeId, tree):
        return false

    let childCount = web.WebDocumentChildCount(document, nodeId)
    for ordinal in 0..<childCount:
        let childNodeId = web.WebDocumentChildAt(document, nodeId, ordinal)
        if web.WebDocumentNodeKind(document, childNodeId) == web.WebNodeKindElement:
            if !WebStyleLayoutBridgeBuildElementDepth(document, sheet, childNodeId, tree, depth + 1):
                continue
            if !WebStyleLayoutBridgeAppendChild(tree, nodeId, childNodeId):
                continue
        elif web.WebDocumentNodeKind(document, childNodeId) == web.WebNodeKindText:
            if !WebStyleLayoutBridgeBuildTextNode(document, childNodeId, nodeId, tree):
                continue
    return true

fn WebStyleLayoutBridgeBuildTreeFromElement(document: var web.WebDocument,
                                          sheet: var style.WebStyleSheet,
                                          rootElementId: int32,
                                          tree: var layout.WebLayoutTree): bool =
    layout.WebLayoutTreeInit(tree)
    WebStyleBridgeBuildCount = WebStyleBridgeBuildCount + 1
    if web.WebDocumentNodeKind(document, rootElementId) != web.WebNodeKindElement:
        return false
    tree.rootNodeId = rootElementId
    return WebStyleLayoutBridgeBuildElementDepth(document, sheet, rootElementId, tree, 0)

fn WebStyleLayoutBridgeBuildTree(document: var web.WebDocument,
                                 sheet: var style.WebStyleSheet,
                                 rootNodeId: int32,
                                 tree: var layout.WebLayoutTree): bool =
    layout.WebLayoutTreeInit(tree)
    let kind = web.WebDocumentNodeKind(document, rootNodeId)
    if kind == web.WebNodeKindElement:
        tree.rootNodeId = rootNodeId
        return WebStyleLayoutBridgeBuildElementDepth(document, sheet, rootNodeId, tree, 0)
    if kind == web.WebNodeKindDocument:
        tree.rootNodeId = rootNodeId
        let childCount = web.WebDocumentChildCount(document, rootNodeId)
        var ordinal: int32
        while ordinal < childCount:
            let childNodeId = web.WebDocumentChildAt(document, rootNodeId, ordinal)
            if web.WebDocumentNodeKind(document, childNodeId) == web.WebNodeKindElement:
                if !WebStyleLayoutBridgeBuildElementDepth(document, sheet, childNodeId, tree, 1):
                    # skip element that can't be laid out, continue with siblings
                    ordinal = ordinal + 1
                    continue
                if !WebStyleLayoutBridgeAppendChild(tree, rootNodeId, childNodeId):
                    ordinal = ordinal + 1
                    continue
            ordinal = ordinal + 1
        return true
    return false

@borrows
fn WebStyleLayoutBridgeClassContains(classText: str, name: str): bool =
    let nameLen = name.len
    if nameLen == 0 || classText.len < nameLen:
        return false
    var i: int32
    var start: int32
    while i <= classText.len:
        let atEnd = i == classText.len
        var split = atEnd
        if !atEnd:
            if classText[i] == ' ':
                split = true
        if split:
            if i - start == nameLen:
                var match = true
                var j: int32
                while j < nameLen:
                    if classText[start + j] != name[j]:
                        match = false
                        break
                    j = j + 1
                if match:
                    return true
            start = i + 1
        i = i + 1
    return false



@exportc("cheng_app_debug_bridge_tw_walk")
fn WebStyleLayoutBridgeApplyTwWalk(document: var web.WebDocument, tree: var layout.WebLayoutTree): bool =
    WebStyleBridgeDbgTwApplied = 0
    let total: int32 = document.nodes.len
    var idx: int32
    while idx < total:
        if document.nodes[idx].kind != web.WebNodeKindText:
            idx = idx + 1
            continue
        WebStyleBridgeDbgTwVisited = WebStyleBridgeDbgTwVisited + 1
        let tid: int32 = document.nodes[idx].nodeId
        let pid: int32 = document.parentByNodeId[tid]
        var attrVal: str
        var hasTw: bool = web.WebDocumentGetAttribute(document, pid, "data-csg-tw", attrVal)
        if !hasTw:
            hasTw = web.WebDocumentGetAttribute(document, pid, "csgTw", attrVal)
        if hasTw:
            WebStyleBridgeDbgTwParentFound = WebStyleBridgeDbgTwParentFound + 1
        if !hasTw || attrVal.len == 0:
            idx = idx + 1
            continue
        let sibCount: int32 = web.WebDocumentChildCount(document, pid)
        var sibIdx: int32
        var ordinal: int32
        var selfSeen: bool
        while sibIdx < sibCount:
            let sibId: int32 = web.WebDocumentChildAt(document, pid, sibIdx)
            if sibId == tid:
                selfSeen = true
                break
            if web.WebDocumentNodeKind(document, sibId) == web.WebNodeKindText:
                ordinal = ordinal + 1
            sibIdx = sibIdx + 1
        if !selfSeen:
            idx = idx + 1
            continue
        var acc: int32
        var haveTok: bool
        var matchedTok: bool
        var k: int32
        while k < attrVal.len && !matchedTok:
            let ch = attrVal[k]
            if ch == ',':
                if ordinal == 0:
                    matchedTok = true
                else:
                    ordinal = ordinal - 1
                    acc = 0
                    haveTok = false
            else:
                if ordinal == 0 && ch >= '0' && ch <= '9':
                    acc = acc * 10 + int32(ch) - int32('0')
                    haveTok = true
            k = k + 1
        if !matchedTok && haveTok:
            matchedTok = true
        if matchedTok && acc > 0:
            let csIdx: int32 = layout.WebLayoutFindStyleIndex(tree, tid)
            if csIdx >= 0:
                WebStyleBridgeDbgTwStyleIdx = WebStyleBridgeDbgTwStyleIdx + 1
                tree.styles[csIdx].width = acc
                WebStyleBridgeDbgTwApplied = WebStyleBridgeDbgTwApplied + 1
        idx = idx + 1
    return true

@exportc("cheng_app_fixup_text_widths")
fn WebStyleLayoutBridgeApplyTwRoot(document: var web.WebDocument, tree: var layout.WebLayoutTree, rootId: int32): bool =
    return WebStyleLayoutBridgeApplyTwWalk(document, tree)


@exportc("cheng_app_debug_tw_attr_count")
fn WebStyleLayoutBridgeDebugTwAttrCount(document: var web.WebDocument): int32 =
    var c: int32
    var i: int32
    while i < document.attributes.len:
        if document.attributes[i].name == "data-csg-tw":
            c = c + 1
        i = i + 1
    return c


@exportc("cheng_app_debug_tw_probe")
fn WebStyleLayoutBridgeDebugTwProbe(): int32 =
    return WebStyleBridgeDbgTwVisited * 10000 + WebStyleBridgeDbgTwParentFound * 100 + WebStyleBridgeDbgTwStyleIdx


@exportc("cheng_app_set_tw_widths")
fn WebStyleLayoutBridgeSetTwWidths(flat: int32[]): bool =
    WebStyleBridgeTwWidths = flat
    return true

