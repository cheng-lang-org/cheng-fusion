import std/strings

importc fn cheng_epoch_time_ms(): int64


const
    JsKindUndefined = 0
    JsKindNull = 1
    JsKindBool = 2
    JsKindInt32 = 3
    JsKindFloat64 = 4
    JsKindString = 5
    JsKindObject = 6
    JsKindSymbol = 7
    JsKindBigInt = 8
    JsKindFunction = 9

    JsObjectDefaultPropertyCapacity = 32
    JsObjectDefaultElementCapacity = 32

    JsBodyKindNative = 0
    JsBodyKindBytecode = 1
    JsBodyKindChengFn = 2

    JsExceptionThrow = 0
    JsExceptionTypeError = 1
    JsExceptionReferenceError = 2
    JsExceptionRangeError = 3
    JsExceptionSyntaxError = 4
    JsExceptionUnsupported = 5
    JsExceptionNone = -1

    JsDefaultFrameStackCapacity = 256

type
    JsValue =
        kind: int32
        boolValue: bool
        int32Value: int32
        float64Value: float64
        stringValue: str
        objectId: int32
        functionId: int32
        arrayId: int32

    JsPropertyDescriptor =
        writable: bool
        enumerable: bool
        configurable: bool

    JsProperty =
        name: str
        valueKind: int32
        valueBool: bool
        valueInt32: int32
        valueFloat64: float64
        valueString: str
        valueObjectId: int32
        valueFunctionId: int32
        valueArrayId: int32
        writable: bool
        enumerable: bool
        configurable: bool

    JsObject =
        objectId: int32
        shapeId: int32
        prototypeId: int32
        extensible: bool = true
        propertyCapacity: int32 = JsObjectDefaultPropertyCapacity
        elementCapacity: int32 = JsObjectDefaultElementCapacity
        properties: JsProperty[]

    JsArray =
        capacity: int32
        values: int32[]
        valuesJs: JsValue[]

    JsArrayBuffer =
        bufferId: int32
        data: int32[]          # raw bytes stored as int32 values (0-255)
        byteLength: int32

    JsTypedArray =
        arrayId: int32
        bufferId: int32        # reference to ArrayBuffer
        byteOffset: int32
        byteLength: int32
        length: int32          # number of elements
        bytesPerElement: int32

    JsDataView =
        viewId: int32
        bufferId: int32
        byteOffset: int32
        byteLength: int32

    JsRegExp =
        pattern: str
        flags: str
        global: bool
        ignoreCase: bool
        multiline: bool
        dotAll: bool
        lastIndex: int32

    JsMapEntry =
        key: JsValue
        value: JsValue

    JsMap =
        mapId: int32
        entries: JsMapEntry[]

    JsSet =
        setId: int32
        values: JsValue[]

fn JsValueReset(value: var JsValue) =
    value.kind = JsKindUndefined
    value.boolValue = false
    value.int32Value = 0
    value.float64Value = 0.0
    value.stringValue = ""
    value.objectId = 0
    value.functionId = 0
    value.arrayId = 0

fn JsValueCopy(out: var JsValue, value: var JsValue) =
    out.kind = value.kind
    out.boolValue = value.boolValue
    out.int32Value = value.int32Value
    out.float64Value = value.float64Value
    out.stringValue = value.stringValue
    out.objectId = value.objectId
    out.functionId = value.functionId
    out.arrayId = value.arrayId

fn JsValueInitUndefined(value: var JsValue) =
    JsValueReset(value)

fn JsValueInitNull(value: var JsValue) =
    JsValueReset(value)
    value.kind = JsKindNull

fn JsValueInitBool(value: var JsValue, raw: bool) =
    JsValueReset(value)
    value.kind = JsKindBool
    value.boolValue = raw

fn JsValueInitInt32(value: var JsValue, raw: int32) =
    JsValueReset(value)
    value.kind = JsKindInt32
    value.int32Value = raw

fn JsValueInitFloat64(value: var JsValue, raw: float64) =
    JsValueReset(value)
    value.kind = JsKindFloat64
    value.float64Value = raw

fn JsValueInitString(value: var JsValue, raw: str) =
    JsValueReset(value)
    value.kind = JsKindString
    value.stringValue = raw

fn JsValueInitObject(value: var JsValue, objectId: int32) =
    JsValueReset(value)
    value.kind = JsKindObject
    value.objectId = objectId

fn JsValueInitArray(value: var JsValue, arrayId: int32) =
    JsValueReset(value)
    value.kind = JsKindObject
    value.arrayId = arrayId

fn JsValueInitFunction(value: var JsValue, functionId: int32) =
    JsValueReset(value)
    value.kind = JsKindFunction
    value.functionId = functionId

fn JsValueIsUndefined(value: var JsValue): bool =
    return value.kind == JsKindUndefined

fn JsValueIsNull(value: var JsValue): bool =
    return value.kind == JsKindNull

fn JsValueIsBool(value: var JsValue): bool =
    return value.kind == JsKindBool

fn JsValueIsInt32(value: var JsValue): bool =
    return value.kind == JsKindInt32

fn JsValueIsFloat64(value: var JsValue): bool =
    return value.kind == JsKindFloat64

fn JsValueIsString(value: var JsValue): bool =
    return value.kind == JsKindString

fn JsValueIsObject(value: var JsValue): bool =
    return value.kind == JsKindObject

fn JsValueIsFunction(value: var JsValue): bool =
    return value.kind == JsKindFunction

fn JsValueBool(value: var JsValue): bool =
    return value.boolValue

fn JsValueInt32(value: var JsValue): int32 =
    return value.int32Value

fn JsValueFloat64(value: var JsValue): float64 =
    return value.float64Value

fn JsValueString(value: var JsValue): str =
    return value.stringValue

fn JsStringFromBool(raw: bool): str =
    if raw:
        return "true"
    return "false"

fn JsStringFromScalarValue(value: var JsValue, out: var str): bool =
    if JsValueIsUndefined(value):
        out = "undefined"
        return true
    if JsValueIsNull(value):
        out = "null"
        return true
    if JsValueIsBool(value):
        out = JsStringFromBool(value.boolValue)
        return true
    if JsValueIsInt32(value):
        out = strings.IntToStr(value.int32Value)
        return true
    if JsValueIsString(value):
        out = value.stringValue
        return true
    out = ""
    return false

fn JsValueObjectId(value: var JsValue): int32 =
    return value.objectId

fn JsValueFunctionId(value: var JsValue): int32 =
    return value.functionId

fn JsValueSameKindAndScalar(left: var JsValue, right: var JsValue): bool =
    if left.kind != right.kind:
        return false
    if left.kind == JsKindUndefined || left.kind == JsKindNull:
        return true
    if left.kind == JsKindBool:
        return left.boolValue == right.boolValue
    if left.kind == JsKindInt32:
        return left.int32Value == right.int32Value
    if left.kind == JsKindFloat64:
        return left.float64Value == right.float64Value
    if left.kind == JsKindString:
        return left.stringValue == right.stringValue
    if left.kind == JsKindObject:
        return left.objectId == right.objectId
    if left.kind == JsKindFunction:
        return left.functionId == right.functionId
    return false

fn JsValueEquals(left: var JsValue, right: var JsValue): bool =
    if left.kind != right.kind:
        return false
    if left.kind == JsKindUndefined || left.kind == JsKindNull:
        return true
    if left.kind == JsKindBool:
        return left.boolValue == right.boolValue
    if left.kind == JsKindInt32:
        return left.int32Value == right.int32Value
    if left.kind == JsKindFloat64:
        return left.float64Value == right.float64Value
    if left.kind == JsKindString:
        return left.stringValue == right.stringValue
    if left.kind == JsKindObject:
        if left.arrayId > 0 || right.arrayId > 0:
            return left.arrayId == right.arrayId
        return left.objectId == right.objectId
    if left.kind == JsKindFunction:
        return left.functionId == right.functionId
    return false

fn JsDescriptorInitData(descriptor: var JsPropertyDescriptor,
                        writable: bool,
                        enumerable: bool,
                        configurable: bool) =
    descriptor.writable = writable
    descriptor.enumerable = enumerable
    descriptor.configurable = configurable

fn JsDescriptorCopy(out: var JsPropertyDescriptor, descriptor: var JsPropertyDescriptor) =
    out.writable = descriptor.writable
    out.enumerable = descriptor.enumerable
    out.configurable = descriptor.configurable

fn JsObjectInit(object: var JsObject, objectId: int32, prototypeId: int32) =
    JsObjectInitWithCapacity(object,
                             objectId,
                             prototypeId,
                             JsObjectDefaultPropertyCapacity,
                             JsObjectDefaultElementCapacity)

fn JsObjectInitWithCapacity(object: var JsObject,
                            objectId: int32,
                            prototypeId: int32,
                            propertyCapacity: int32,
                            elementCapacity: int32) =
    object.objectId = objectId
    object.shapeId = 0
    object.prototypeId = prototypeId
    object.extensible = true
    object.propertyCapacity = propertyCapacity
    object.elementCapacity = elementCapacity
    object.properties = []

fn JsObjectSetExtensible(object: var JsObject, extensible: bool) =
    object.extensible = extensible

fn JsObjectPropertyCount(object: var JsObject): int32 =
    return object.properties.len

fn JsObjectPropertyCapacity(object: var JsObject): int32 =
    return object.propertyCapacity

fn JsObjectElementCapacity(object: var JsObject): int32 =
    return object.elementCapacity

fn JsObjectFindOwnPropertyIndex(object: var JsObject, name: str): int32 =
    let objPropLen: int32 = object.properties.len
    for i in 0..<objPropLen:
        if object.properties[i].name == name:
            return i
    return -1

fn JsObjectHasOwnProperty(object: var JsObject, name: str): bool =
    return JsObjectFindOwnPropertyIndex(object, name) >= 0

fn JsObjectGetById(id: int32, out: var JsObject): bool =
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == id:
            out = jsObjectTable[i]
            return true
    return false

fn JsObjectCanAddOwnProperty(object: var JsObject): bool =
    if !object.extensible:
        return false
    if object.properties.len >= object.propertyCapacity:
        return false
    return true

fn JsObjectCopyPropertyValue(outValue: var JsValue, property: var JsProperty) =
    outValue.kind = property.valueKind
    outValue.boolValue = property.valueBool
    outValue.int32Value = property.valueInt32
    outValue.float64Value = property.valueFloat64
    outValue.stringValue = property.valueString
    outValue.objectId = property.valueObjectId
    outValue.functionId = property.valueFunctionId
    outValue.arrayId = property.valueArrayId

fn JsObjectGetOwnProperty(object: var JsObject, name: str, outValue: var JsValue): bool =
    let index = JsObjectFindOwnPropertyIndex(object, name)
    if index < 0:
        JsValueInitUndefined(outValue)
        return false
    JsObjectCopyPropertyValue(outValue, object.properties[index])
    return true

fn JsObjectGetStringProperty(object: var JsObject, name: str, outValue: var JsValue): bool =
    return JsObjectGetOwnProperty(object, name, outValue)

fn JsObjectDefineDataProperty(object: var JsObject,
                              name: str,
                              value: var JsValue,
                              descriptor: var JsPropertyDescriptor): bool =
    let index = JsObjectFindOwnPropertyIndex(object, name)
    if index >= 0:
        object.properties[index].valueKind = value.kind
        object.properties[index].valueBool = value.boolValue
        object.properties[index].valueInt32 = value.int32Value
        object.properties[index].valueFloat64 = value.float64Value
        object.properties[index].valueString = value.stringValue
        object.properties[index].valueObjectId = value.objectId
        object.properties[index].valueFunctionId = value.functionId
        object.properties[index].valueArrayId = value.arrayId
        object.properties[index].writable = descriptor.writable
        object.properties[index].enumerable = descriptor.enumerable
        object.properties[index].configurable = descriptor.configurable
        return true
    if !JsObjectCanAddOwnProperty(object):
        return false
    var property: JsProperty
    property.name = name
    property.valueKind = value.kind
    property.valueBool = value.boolValue
    property.valueInt32 = value.int32Value
    property.valueFloat64 = value.float64Value
    property.valueString = value.stringValue
    property.valueObjectId = value.objectId
    property.valueFunctionId = value.functionId
    property.valueArrayId = value.arrayId
    property.writable = descriptor.writable
    property.enumerable = descriptor.enumerable
    property.configurable = descriptor.configurable
    add(object.properties, property)
    object.shapeId = object.shapeId + 1
    return true

fn JsObjectSetStringProperty(object: var JsObject,
                             name: str,
                             value: var JsValue,
                             descriptor: var JsPropertyDescriptor): bool =
    return JsObjectDefineDataProperty(object, name, value, descriptor)

fn JsObjectSetOwnPropertyValue(object: var JsObject,
                               name: str,
                               value: var JsValue): bool =
    let index = JsObjectFindOwnPropertyIndex(object, name)
    if index >= 0:
        if !object.properties[index].writable:
            return false
        object.properties[index].valueKind = value.kind
        object.properties[index].valueBool = value.boolValue
        object.properties[index].valueInt32 = value.int32Value
        object.properties[index].valueFloat64 = value.float64Value
        object.properties[index].valueString = value.stringValue
        object.properties[index].valueObjectId = value.objectId
        object.properties[index].valueFunctionId = value.functionId
        object.properties[index].valueArrayId = value.arrayId
        return true
    var descriptor: JsPropertyDescriptor
    JsDescriptorInitData(descriptor, true, true, true)
    return JsObjectDefineDataProperty(object, name, value, descriptor)

fn JsObjectAssign(target: var JsObject, source: var JsObject): bool =
    let srcPropLen: int32 = source.properties.len
    for i in 0..<srcPropLen:
        if source.properties[i].enumerable:
            var value: JsValue
            JsObjectCopyPropertyValue(value, source.properties[i])
            if !JsObjectSetOwnPropertyValue(target, source.properties[i].name, value):
                return false
    return true

fn JsObjectArrayIndexKey(name: str): int32 =
    let n: int32 = strings.Len(name)
    if n <= 0 || n > 10:
        return -1
    if n > 1 && name[0] == '0':
        return -1
    var value: int32
    for i in 0..<n:
        let ch: char = name[i]
        if ch < '0' || ch > '9':
            return -1
        let digit: int32 = Int32(ch) - Int32('0')
        if value > 214748364:
            return -1
        value = value * 10 + digit
        if value < 0:
            return -1
    return value

fn JsSortInt32Ascending(values: var int32[]) =
    let n: int32 = values.len
    if n <= 1:
        return
    for i in 0..<n:
        var j: int32 = i
        while j > 0 && values[j - 1] > values[j]:
            let tmp: int32 = values[j - 1]
            values[j - 1] = values[j]
            values[j] = tmp
            j = j - 1

fn JsObjectKeysAppendString(result: var JsArray, key: str) =
    var val: JsValue
    JsValueInitString(val, key)
    jsArrayAddJsValue(result, val)

fn JsObjectKeys(value: var JsValue, result: var JsArray): bool =
    JsArrayInit(result, 8)
    if value.kind == JsKindUndefined || value.kind == JsKindNull:
        jsSetTypeErrorException("Object.keys cannot convert undefined or null to object")
        return false
    if value.kind == JsKindString:
        let n: int32 = strings.Len(value.stringValue)
        for i in 0..<n:
            JsObjectKeysAppendString(result, strings.IntToStr(i))
        return true
    if value.kind != JsKindObject:
        return true
    if value.arrayId > 0:
        var arrayValue: JsArray
        if !JsArrayLoadById(value.arrayId, arrayValue):
            jsSetTypeErrorException("Object.keys array object is not registered")
            return false
        let n: int32 = JsArrayLength(arrayValue)
        for i in 0..<n:
            JsObjectKeysAppendString(result, strings.IntToStr(i))
        return true
    var objIndex: int32 = -1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == value.objectId:
            objIndex = i
            break
    if objIndex < 0:
        jsSetTypeErrorException("Object.keys object is not registered")
        return false
    var indexes: int32[]
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        if jsObjectTable[objIndex].properties[i].enumerable:
            let indexKey: int32 = JsObjectArrayIndexKey(jsObjectTable[objIndex].properties[i].name)
            if indexKey >= 0:
                add(indexes, indexKey)
    JsSortInt32Ascending(indexes)
    for i in 0..<indexes.len:
        JsObjectKeysAppendString(result, strings.IntToStr(indexes[i]))
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        if jsObjectTable[objIndex].properties[i].enumerable:
            if JsObjectArrayIndexKey(jsObjectTable[objIndex].properties[i].name) < 0:
                JsObjectKeysAppendString(result, jsObjectTable[objIndex].properties[i].name)
    return true

fn JsObjectValues(value: var JsValue, result: var JsArray): bool =
    JsArrayInit(result, 8)
    if value.kind == JsKindUndefined || value.kind == JsKindNull:
        jsSetTypeErrorException("Object.values cannot convert undefined or null to object")
        return false
    if value.kind == JsKindString:
        let n: int32 = strings.Len(value.stringValue)
        for i in 0..<n:
            var charValue: JsValue
            JsValueInitString(charValue, strings.SliceBytes(value.stringValue, i, 1))
            jsArrayAddJsValue(result, charValue)
        return true
    if value.kind != JsKindObject:
        return true
    if value.arrayId > 0:
        var arrayValue: JsArray
        if !JsArrayLoadById(value.arrayId, arrayValue):
            jsSetTypeErrorException("Object.values array object is not registered")
            return false
        let n: int32 = JsArrayLength(arrayValue)
        for i in 0..<n:
            var arrayItemValue: JsValue
            if arrayValue.valuesJs.len > 0:
                if i < arrayValue.valuesJs.len:
                    JsValueCopy(arrayItemValue, arrayValue.valuesJs[i])
                else:
                    JsValueInitUndefined(arrayItemValue)
            else:
                if i < arrayValue.values.len:
                    JsValueInitInt32(arrayItemValue, arrayValue.values[i])
                else:
                    JsValueInitUndefined(arrayItemValue)
            jsArrayAddJsValue(result, arrayItemValue)
        return true
    var objIndex: int32 = -1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == value.objectId:
            objIndex = i
            break
    if objIndex < 0:
        jsSetTypeErrorException("Object.values object is not registered")
        return false
    var indexes: int32[]
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        if jsObjectTable[objIndex].properties[i].enumerable:
            let indexKey: int32 = JsObjectArrayIndexKey(jsObjectTable[objIndex].properties[i].name)
            if indexKey >= 0:
                add(indexes, indexKey)
    JsSortInt32Ascending(indexes)
    for i in 0..<indexes.len:
        let key: str = strings.IntToStr(indexes[i])
        let objPropLen: int32 = jsObjectTable[objIndex].properties.len
        for j in 0..<objPropLen:
            if jsObjectTable[objIndex].properties[j].enumerable && jsObjectTable[objIndex].properties[j].name == key:
                var indexedValue: JsValue
                JsObjectCopyPropertyValue(indexedValue, jsObjectTable[objIndex].properties[j])
                jsArrayAddJsValue(result, indexedValue)
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        if jsObjectTable[objIndex].properties[i].enumerable:
            if JsObjectArrayIndexKey(jsObjectTable[objIndex].properties[i].name) < 0:
                var namedValue: JsValue
                JsObjectCopyPropertyValue(namedValue, jsObjectTable[objIndex].properties[i])
                jsArrayAddJsValue(result, namedValue)
    return true

fn JsObjectEntriesAppendPair(result: var JsArray, key: str, value: var JsValue) =
    var pairArr: JsArray
    JsArrayInit(pairArr, 2)
    var keyVal: JsValue
    JsValueInitString(keyVal, key)
    jsArrayAddJsValue(pairArr, keyVal)
    var valueVal: JsValue
    JsValueCopy(valueVal, value)
    jsArrayAddJsValue(pairArr, valueVal)
    let pairId = jsRegisterArray(pairArr)
    var pairRef: JsValue
    JsValueInitArray(pairRef, pairId)
    jsArrayAddJsValue(result, pairRef)

fn JsObjectEntries(value: var JsValue, result: var JsArray): bool =
    JsArrayInit(result, 8)
    if value.kind == JsKindUndefined || value.kind == JsKindNull:
        jsSetTypeErrorException("Object.entries cannot convert undefined or null to object")
        return false
    if value.kind == JsKindString:
        let n: int32 = strings.Len(value.stringValue)
        for i in 0..<n:
            var charValue: JsValue
            JsValueInitString(charValue, strings.SliceBytes(value.stringValue, i, 1))
            JsObjectEntriesAppendPair(result, strings.IntToStr(i), charValue)
        return true
    if value.kind != JsKindObject:
        return true
    if value.arrayId > 0:
        var arrayValue: JsArray
        if !JsArrayLoadById(value.arrayId, arrayValue):
            jsSetTypeErrorException("Object.entries array object is not registered")
            return false
        let n: int32 = JsArrayLength(arrayValue)
        for i in 0..<n:
            var entryValue: JsValue
            if arrayValue.valuesJs.len > 0:
                if i < arrayValue.valuesJs.len:
                    JsValueCopy(entryValue, arrayValue.valuesJs[i])
                else:
                    JsValueInitUndefined(entryValue)
            else:
                if i < arrayValue.values.len:
                    JsValueInitInt32(entryValue, arrayValue.values[i])
                else:
                    JsValueInitUndefined(entryValue)
            JsObjectEntriesAppendPair(result, strings.IntToStr(i), entryValue)
        return true
    var objIndex: int32 = -1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == value.objectId:
            objIndex = i
            break
    if objIndex < 0:
        jsSetTypeErrorException("Object.entries object is not registered")
        return false
    var indexes: int32[]
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        if jsObjectTable[objIndex].properties[i].enumerable:
            let indexKey: int32 = JsObjectArrayIndexKey(jsObjectTable[objIndex].properties[i].name)
            if indexKey >= 0:
                add(indexes, indexKey)
    JsSortInt32Ascending(indexes)
    for i in 0..<indexes.len:
        let key: str = strings.IntToStr(indexes[i])
        let objPropLen: int32 = jsObjectTable[objIndex].properties.len
        for j in 0..<objPropLen:
            if jsObjectTable[objIndex].properties[j].enumerable && jsObjectTable[objIndex].properties[j].name == key:
                var indexedEntryValue: JsValue
                JsObjectCopyPropertyValue(indexedEntryValue, jsObjectTable[objIndex].properties[j])
                JsObjectEntriesAppendPair(result, key, indexedEntryValue)
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        if jsObjectTable[objIndex].properties[i].enumerable:
            if JsObjectArrayIndexKey(jsObjectTable[objIndex].properties[i].name) < 0:
                var namedEntryValue: JsValue
                JsObjectCopyPropertyValue(namedEntryValue, jsObjectTable[objIndex].properties[i])
                JsObjectEntriesAppendPair(result, jsObjectTable[objIndex].properties[i].name, namedEntryValue)
    return true

fn JsObjectFreeze(value: var JsValue): JsValue =
    if value.kind != JsKindObject:
        return value
    var objIndex: int32 = -1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == value.objectId:
            objIndex = i
            break
    if objIndex < 0:
        return value
    jsObjectTable[objIndex].extensible = false
    var i: int32
    let objPropLen: int32 = jsObjectTable[objIndex].properties.len
    for i in 0..<objPropLen:
        jsObjectTable[objIndex].properties[i].writable = false
        jsObjectTable[objIndex].properties[i].configurable = false
    return value

fn JsObjectFindTableIndex(objectId: int32): int32 =
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == objectId:
            return i
    return -1

fn JsObjectFreshId(): int32 =
    var result: int32 = 1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId >= result:
            result = jsObjectTable[i].objectId + 1
    return result

fn JsObjectCreateFresh(out: var JsObject, prototypeId: int32): bool =
    let objectId: int32 = JsObjectFreshId()
    var stored: JsObject
    JsObjectInit(stored, objectId, prototypeId)
    add(jsObjectTable, stored)
    jsObjectCount = jsObjectCount + 1
    out = stored
    return true

fn JsObjectDefineDataPropertyById(objectId: int32,
                                  name: str,
                                  value: var JsValue,
                                  descriptor: var JsPropertyDescriptor): bool =
    let objIndex: int32 = JsObjectFindTableIndex(objectId)
    if objIndex < 0:
        return false
    var obj: JsObject
    obj = jsObjectTable[objIndex]
    if !JsObjectDefineDataProperty(obj, name, value, descriptor):
        return false
    jsObjectTable[objIndex] = obj
    return true

fn JsErrorPrototypeInit(out: var JsObject, objectId: int32): bool =
    if !JsObjectCreateFresh(out, 0):
        return false
    var descriptor: JsPropertyDescriptor
    JsDescriptorInitData(descriptor, true, false, true)
    var nameValue: JsValue
    JsValueInitString(nameValue, "Error")
    if !JsObjectDefineDataPropertyById(out.objectId, "name", nameValue, descriptor):
        return false
    var messageValue: JsValue
    JsValueInitString(messageValue, "")
    if !JsObjectDefineDataPropertyById(out.objectId, "message", messageValue, descriptor):
        return false
    jsErrorPrototypeObjectId = out.objectId
    return JsObjectGetById(out.objectId, out)

fn JsErrorObjectInit(out: var JsObject, objectId: int32, errorPrototypeId: int32): bool =
    if JsObjectFindTableIndex(errorPrototypeId) < 0:
        return false
    if !JsObjectCreateFresh(out, errorPrototypeId):
        return false
    return JsObjectGetById(out.objectId, out)

fn JsErrorObjectInitWithMessage(out: var JsObject,
                                objectId: int32,
                                errorPrototypeId: int32,
                                message: str): bool =
    if !JsErrorObjectInit(out, objectId, errorPrototypeId):
        return false
    var descriptor: JsPropertyDescriptor
    JsDescriptorInitData(descriptor, true, false, true)
    var messageValue: JsValue
    JsValueInitString(messageValue, message)
    if !JsObjectDefineDataPropertyById(out.objectId, "message", messageValue, descriptor):
        return false
    return JsObjectGetById(out.objectId, out)

fn JsErrorEnsurePrototype(out: var JsObject): bool =
    if jsErrorPrototypeObjectId > 0:
        return JsObjectGetById(jsErrorPrototypeObjectId, out)
    return JsErrorPrototypeInit(out, 0)

fn JsErrorValueInitWithMessage(out: var JsValue, message: str): bool =
    var prototype: JsObject
    if !JsErrorEnsurePrototype(prototype):
        JsValueInitUndefined(out)
        return false
    var object: JsObject
    if !JsErrorObjectInitWithMessage(object, 0, prototype.objectId, message):
        JsValueInitUndefined(out)
        return false
    JsValueInitObject(out, object.objectId)
    return true

fn JsValueInstanceOfError(value: var JsValue): bool =
    if value.kind != JsKindObject:
        return false
    if jsErrorPrototypeObjectId <= 0:
        return false
    var instanceObject: JsObject
    if !JsObjectGetById(value.objectId, instanceObject):
        return false
    var currentObjectId: int32 = instanceObject.prototypeId
    while currentObjectId > 0:
        if currentObjectId == jsErrorPrototypeObjectId:
            return true
        var currentObject: JsObject
        if !JsObjectGetById(currentObjectId, currentObject):
            return false
        currentObjectId = currentObject.prototypeId
    return false

fn JsObjectElementKey(index: int32): str =
    return strings.IntToStr(index)

fn JsObjectElementIndexInBounds(object: var JsObject, index: int32): bool =
    return index >= 0 && index < object.elementCapacity

fn JsObjectSetElementInt32(object: var JsObject,
                           index: int32,
                           value: var JsValue,
                           descriptor: var JsPropertyDescriptor): bool =
    if !JsObjectElementIndexInBounds(object, index):
        return false
    return JsObjectDefineDataProperty(object, JsObjectElementKey(index), value, descriptor)

fn JsObjectGetElementInt32(object: var JsObject,
                           index: int32,
                           outValue: var JsValue): bool =
    if !JsObjectElementIndexInBounds(object, index):
        JsValueInitUndefined(outValue)
        return false
    return JsObjectGetOwnProperty(object, JsObjectElementKey(index), outValue)

fn JsObjectGetPropertyOneProto(object: var JsObject,
                               prototype: var JsObject,
                               name: str,
                               outValue: var JsValue): bool =
    if JsObjectGetOwnProperty(object, name, outValue):
        return true
    if object.prototypeId == prototype.objectId:
        return JsObjectGetOwnProperty(prototype, name, outValue)
    JsValueInitUndefined(outValue)
    return false
fn JsArrayGetById(id: int32, out: var JsArray): bool =
    if id <= 0 || id > jsArrayCount: return false
    out = jsArrayTable[id - 1]
    return true
    return &jsArrayTable[id - 1]

fn JsArrayLoadById(id: int32, out: var JsArray): bool =
    if id <= 0 || id > jsArrayCount:
        return false
    JsArrayCopy(out, jsArrayTable[id - 1])
    return true

fn JsArrayCopy(out: var JsArray, array: var JsArray) =
    out.capacity = array.capacity
    out.values = array.values
    out.valuesJs = array.valuesJs

fn JsArrayInit(array: var JsArray, capacity: int32): bool =
    array.capacity = 0
    array.values = []
    array.valuesJs = []
    array.capacity = capacity
    if capacity < 0:
        return false
    array.capacity = capacity
    return true

fn JsArrayLength(array: var JsArray): int32 =
    if array.valuesJs.len > array.values.len:
        return array.valuesJs.len
    return array.values.len

fn JsArrayCapacity(array: var JsArray): int32 =
    return array.capacity

fn JsArrayIndexInBounds(array: var JsArray, index: int32): bool =
    return index >= 0 && index < array.values.len

fn JsArrayGetInt32(array: var JsArray, index: int32, outValue: var int32): bool =
    if !JsArrayIndexInBounds(array, index):
        return false
    outValue = array.values[index]
    return true

fn JsArraySetInt32(array: var JsArray, index: int32, value: int32): bool =
    if !JsArrayIndexInBounds(array, index):
        return false
    array.values[index] = value
    return true

fn JsArrayPushInt32(array: var JsArray, value: int32): bool =
    if array.values.len >= array.capacity:
        return false
    add(array.values, value)
    return true

fn JsArrayPushInt32Length(array: var JsArray, value: int32): int32 =
    if array.values.len >= array.capacity:
        var nextCapacity: int32 = array.capacity * 2
        if nextCapacity <= array.values.len:
            nextCapacity = array.values.len + 1
        array.capacity = nextCapacity
    add(array.values, value)
    return array.values.len

fn JsArrayPushJsValue(array: var JsArray, value: var JsValue): bool =
    if array.valuesJs.len >= array.capacity:
        return false
    var stored: JsValue
    JsValueCopy(stored, value)
    add(array.valuesJs, stored)
    return true

fn JsArrayGetJsValue(array: var JsArray, index: int32, outValue: var JsValue): bool =
    if index < 0 || index >= array.valuesJs.len:
        JsValueInitUndefined(outValue)
        return false
    JsValueCopy(outValue, array.valuesJs[index])
    return true

fn JsArrayIncludesJsValue(array: var JsArray, needle: var JsValue): bool =
    if array.valuesJs.len > 0:
        let arrValuesJsLen: int32 = array.valuesJs.len
        for i in 0..<arrValuesJsLen:
            if JsValueSameKindAndScalar(array.valuesJs[i], needle):
                return true
        return false
    if JsValueIsInt32(needle):
        let arrValuesLen: int32 = array.values.len
        for i in 0..<arrValuesLen:
            if array.values[i] == needle.int32Value:
                return true
    return false

fn JsArraySomeJsValueObjectScalarPropertyEquals(array: var JsArray, propertyName: str, expected: var JsValue): bool =
    if array.values.len > 0:
        jsSetTypeErrorException("Array.some object property equals requires JS object values")
        return false
    let arrValuesJsLen: int32 = array.valuesJs.len
    for i in 0..<arrValuesJsLen:
        let item: JsValue = array.valuesJs[i]
        if !JsValueIsObject(item) || item.objectId <= 0:
            jsSetTypeErrorException("Array.some object property equals requires object item")
            return false
        var object: JsObject
        if !JsObjectGetById(item.objectId, object):
            jsSetTypeErrorException("Array.some object property equals object id missing")
            return false
        var actual: JsValue
        if JsObjectGetOwnProperty(object, propertyName, actual):
            if JsValueSameKindAndScalar(actual, expected):
                return true
    return false

fn JsArraySomeJsValueObjectScalarPropertiesEqual(array: var JsArray, propertyNames: str[], expectedValues: var JsArray): bool =
    if propertyNames.len == 0 || propertyNames.len != expectedValues.valuesJs.len:
        jsSetTypeErrorException("Array.some object property conjunction equals requires matching expected JS values")
        return false
    if array.values.len > 0:
        jsSetTypeErrorException("Array.some object property conjunction equals requires JS object values")
        return false
    let arrValuesJsLen: int32 = array.valuesJs.len
    for i in 0..<arrValuesJsLen:
        let item: JsValue = array.valuesJs[i]
        if !JsValueIsObject(item) || item.objectId <= 0:
            jsSetTypeErrorException("Array.some object property conjunction equals requires object item")
            return false
        var object: JsObject
        if !JsObjectGetById(item.objectId, object):
            jsSetTypeErrorException("Array.some object property conjunction equals object id missing")
            return false
        var matched: bool = true
        for j in 0..<propertyNames.len:
            var actual: JsValue
            if !JsObjectGetOwnProperty(object, propertyNames[j], actual):
                matched = false
                break
            if !JsValueSameKindAndScalar(actual, expectedValues.valuesJs[j]):
                matched = false
                break
        if matched:
            return true
    return false

fn JsArrayFindIndexJsValueObjectScalarPropertyEquals(array: var JsArray, propertyName: str, expected: var JsValue): int32 =
    if array.values.len > 0:
        jsSetTypeErrorException("Array.findIndex object property equals requires JS object values")
        return -1
    let arrValuesJsLen: int32 = array.valuesJs.len
    for i in 0..<arrValuesJsLen:
        let item: JsValue = array.valuesJs[i]
        if !JsValueIsObject(item) || item.objectId <= 0:
            jsSetTypeErrorException("Array.findIndex object property equals requires object item")
            return -1
        var object: JsObject
        if !JsObjectGetById(item.objectId, object):
            jsSetTypeErrorException("Array.findIndex object property equals object id missing")
            return -1
        var actual: JsValue
        if JsObjectGetOwnProperty(object, propertyName, actual):
            if JsValueSameKindAndScalar(actual, expected):
                return i
    return -1

fn JsArrayFindIndexJsValueObjectScalarPropertiesEqual(array: var JsArray, propertyNames: str[], expectedValues: var JsArray): int32 =
    if propertyNames.len == 0 || propertyNames.len != expectedValues.valuesJs.len:
        jsSetTypeErrorException("Array.findIndex object property conjunction equals requires matching expected JS values")
        return -1
    if array.values.len > 0:
        jsSetTypeErrorException("Array.findIndex object property conjunction equals requires JS object values")
        return -1
    let arrValuesJsLen: int32 = array.valuesJs.len
    for i in 0..<arrValuesJsLen:
        let item: JsValue = array.valuesJs[i]
        if !JsValueIsObject(item) || item.objectId <= 0:
            jsSetTypeErrorException("Array.findIndex object property conjunction equals requires object item")
            return -1
        var object: JsObject
        if !JsObjectGetById(item.objectId, object):
            jsSetTypeErrorException("Array.findIndex object property conjunction equals object id missing")
            return -1
        var matched: bool = true
        for j in 0..<propertyNames.len:
            var actual: JsValue
            if !JsObjectGetOwnProperty(object, propertyNames[j], actual):
                matched = false
                break
            if !JsValueSameKindAndScalar(actual, expectedValues.valuesJs[j]):
                matched = false
                break
        if matched:
            return i
    return -1

fn JsArrayFindIndexJsValueObjectAnyScalarPropertyEqual(array: var JsArray, propertyNames: str[], expectedValues: var JsArray): int32 =
    if propertyNames.len == 0 || propertyNames.len != expectedValues.valuesJs.len:
        jsSetTypeErrorException("Array.findIndex object property disjunction equals requires matching expected JS values")
        return -1
    if array.values.len > 0:
        jsSetTypeErrorException("Array.findIndex object property disjunction equals requires JS object values")
        return -1
    let arrValuesJsLen: int32 = array.valuesJs.len
    for i in 0..<arrValuesJsLen:
        let item: JsValue = array.valuesJs[i]
        if !JsValueIsObject(item) || item.objectId <= 0:
            jsSetTypeErrorException("Array.findIndex object property disjunction equals requires object item")
            return -1
        var object: JsObject
        if !JsObjectGetById(item.objectId, object):
            jsSetTypeErrorException("Array.findIndex object property disjunction equals object id missing")
            return -1
        for j in 0..<propertyNames.len:
            var actual: JsValue
            if JsObjectGetOwnProperty(object, propertyNames[j], actual):
                if JsValueSameKindAndScalar(actual, expectedValues.valuesJs[j]):
                    return i
    return -1

# --- JS Array sequence operations (callable from translated JS) ---
#
# These implement the underlying sequence operations for Array.prototype
# methods. The translation layer (TS->CSG-Web compiler) is responsible
# for lowering callbacks into inline Cheng code that pre-computes the
# boolean mask (filter/find) or mapped values (map).
#
# When Cheng gains closure/function-pointer support, these will be
# extended with callback-based overloads.

fn JsArrayFilterInt32(arr: int32[], includeMask: bool[], out: var JsArray) =
    let n: int32 = arr.len
    if includeMask.len != n:
        return
    for i in 0..<n:
        if includeMask[i] == true:
            add(out.values, arr[i])

fn JsArrayMapInt32(arr: int32[], mappedValues: int32[], out: var JsArray) =
    let n: int32 = arr.len
    if mappedValues.len != n:
        return
    for i in 0..<n:
        add(out.values, mappedValues[i])

fn JsArrayFindInt32(arr: int32[], predicateMatch: bool[]): int32 =
    let n: int32 = arr.len
    if predicateMatch.len != n:
        return 0
    for i in 0..<n:
        if predicateMatch[i] == true:
            return arr[i]
    return 0

fn JsArraySliceInt32(arr: int32[], start: int32, end: int32, out: var JsArray) =
    let n: int32 = arr.len
    var s: int32 = start
    var e: int32 = end
    if s < 0:
        s = 0
    if s > n:
        s = n
    if e < 0:
        e = 0
    if e > n:
        e = n
    if s >= e:
        return
    for i in s..<e:
        add(out.values, arr[i])

fn jsStrConcat(a: str, b: str): str =
    return Fmt"{a}{b}"

fn JsArrayJoinInt32(arr: int32[], separator: str): str =
    let n: int32 = arr.len
    if n == 0:
        var emptyResult: str
        emptyResult = ""
        return emptyResult
    var result: str = strings.IntToStr(arr[0])
    for i in 1..<n:
        result = jsStrConcat(jsStrConcat(result, separator), strings.IntToStr(arr[i]))
    return result

fn JsArrayConcatInt32(a: int32[], b: int32[], out: var JsArray) =
    for i in 0..<a.len:
        add(out.values, a[i])
    for i in 0..<b.len:
        add(out.values, b[i])

fn JsArrayFrom(items: int32[]): JsArray =
    var result: JsArray
    JsArrayInit(result, items.len)
    for i in 0..<items.len:
        var ok = JsArrayPushInt32Length(result, items[i])
    return result

fn JsArrayFromLengthUndefined(length: int32, out: var JsArray): bool =
    if length < 0:
        return false
    if !JsArrayInit(out, length):
        return false
    for i in 0..<length:
        var value: JsValue
        JsValueInitUndefined(value)
        if !JsArrayPushJsValue(out, value):
            return false
    return true

fn jsUint8ToHex2(value: int32): str =
    let normalized: int32 = value & 0xFF
    let digits: str = "0123456789abcdef"
    let hi: int32 = (normalized / 16) & 0xF
    let lo: int32 = normalized & 0xF
    return jsStrConcat(strings.SliceBytes(digits, hi, 1), strings.SliceBytes(digits, lo, 1))

fn JsArrayFromUint8Array(array: var JsTypedArray, out: var JsArray): bool =
    if array.bytesPerElement != 1 || array.length < 0:
        return false
    if !JsArrayInit(out, array.length):
        return false
    var i: int32
    while i < array.length:
        var item: JsValue
        JsValueInitInt32(item, JsTypedArrayGetUint8(array.arrayId, i))
        if !JsArrayPushJsValue(out, item):
            return false
        i = i + 1
    return true

fn JsArrayFromUint8ArrayHexLower(array: var JsTypedArray, out: var JsArray): bool =
    if array.bytesPerElement != 1 || array.length < 0:
        return false
    if !JsArrayInit(out, array.length):
        return false
    var i: int32
    while i < array.length:
        var item: JsValue
        JsValueInitString(item, jsUint8ToHex2(JsTypedArrayGetUint8(array.arrayId, i)))
        if !JsArrayPushJsValue(out, item):
            return false
        i = i + 1
    return true

fn jsRegisterArray(arr: var JsArray): int32 =
    let id: int32 = jsArrayCount + 1
    var stored: JsArray
    JsArrayCopy(stored, arr)
    add(jsArrayTable, stored)
    jsArrayCount = jsArrayCount + 1
    return id

fn JsArrayRegister(arr: var JsArray): int32 =
    return jsRegisterArray(arr)

fn jsArrayAddJsValue(array: var JsArray, val: var JsValue) =
    var stored: JsValue
    JsValueCopy(stored, val)
    add(array.valuesJs, stored)

fn JsArrayAppendJsValues(array: var JsArray, source: var JsArray) =
    let srcValuesJsLen: int32 = source.valuesJs.len
    for i in 0..<srcValuesJsLen:
        jsArrayAddJsValue(array, source.valuesJs[i])
    let srcValuesLen: int32 = source.values.len
    for i in 0..<srcValuesLen:
        var val: JsValue
        JsValueInitInt32(val, source.values[i])
        jsArrayAddJsValue(array, val)

fn JsArrayPop(array: var JsArray): JsValue =
    let n: int32 = array.valuesJs.len
    if n == 0:
        var result: JsValue
        JsValueInitUndefined(result)
        return result
    let result: JsValue = array.valuesJs[n - 1]
    setLen(array.valuesJs, n - 1)
    return result

fn JsArraySortInt32(array: var JsArray) =
    let n: int32 = array.values.len
    if n <= 1:
        return
    var i: int32
    for i in 0..<n:
        var j: int32 = i
        while j > 0 && array.values[j - 1] > array.values[j]:
            let temp: int32 = array.values[j]
            array.values[j] = array.values[j - 1]
            array.values[j - 1] = temp
            j = j - 1

fn JsArraySortInt32Descending(array: var JsArray) =
    let n: int32 = array.values.len
    if n <= 1:
        return
    var i: int32
    for i in 0..<n:
        var j: int32 = i
        while j > 0 && array.values[j - 1] < array.values[j]:
            let temp: int32 = array.values[j]
            array.values[j] = array.values[j - 1]
            array.values[j - 1] = temp
            j = j - 1

# --- JS Array iteration methods (callback-based) ---

fn JsArrayReduce(array: var JsArray, callbackFnId: int32, initial: var JsValue, out: var JsValue): bool =
    let arrLen: int32 = array.valuesJs.len
    var accumulator: JsValue
    JsValueCopy(accumulator, initial)
    for i in 0..<arrLen:
        var args: JsValue[]
        var accArg: JsValue
        JsValueCopy(accArg, accumulator)
        add(args, accArg)
        var elemArg: JsValue
        JsValueCopy(elemArg, array.valuesJs[i])
        add(args, elemArg)
        var indexArg: JsValue
        JsValueInitInt32(indexArg, i)
        add(args, indexArg)
        var frame: JsCallFrame
        frame.args = args
        var result: JsValue
        if !jsDispatchChengFn(callbackFnId, frame, result):
            return false
        JsValueCopy(accumulator, result)
    JsValueCopy(out, accumulator)
    return true

fn JsArrayReduceRight(array: var JsArray, callbackFnId: int32, initial: var JsValue, out: var JsValue): bool =
    let arrLen: int32 = array.valuesJs.len
    var accumulator: JsValue
    JsValueCopy(accumulator, initial)
    var i: int32 = arrLen - 1
    while i >= 0:
        var args: JsValue[]
        var accArg: JsValue
        JsValueCopy(accArg, accumulator)
        add(args, accArg)
        var elemArg: JsValue
        JsValueCopy(elemArg, array.valuesJs[i])
        add(args, elemArg)
        var indexArg: JsValue
        JsValueInitInt32(indexArg, i)
        add(args, indexArg)
        var frame: JsCallFrame
        frame.args = args
        var result: JsValue
        if !jsDispatchChengFn(callbackFnId, frame, result):
            return false
        JsValueCopy(accumulator, result)
        i = i - 1
    JsValueCopy(out, accumulator)
    return true

fn JsArrayEvery(array: var JsArray, callbackFnId: int32): bool =
    let arrLen: int32 = array.valuesJs.len
    for i in 0..<arrLen:
        var args: JsValue[]
        var elemArg: JsValue
        JsValueCopy(elemArg, array.valuesJs[i])
        add(args, elemArg)
        var indexArg: JsValue
        JsValueInitInt32(indexArg, i)
        add(args, indexArg)
        var frame: JsCallFrame
        frame.args = args
        var result: JsValue
        if !jsDispatchChengFn(callbackFnId, frame, result):
            return false
        if !JsValueIsTruthy(result):
            return false
    return true

fn JsArraySome(array: var JsArray, callbackFnId: int32): bool =
    let arrLen: int32 = array.valuesJs.len
    for i in 0..<arrLen:
        var args: JsValue[]
        var elemArg: JsValue
        JsValueCopy(elemArg, array.valuesJs[i])
        add(args, elemArg)
        var indexArg: JsValue
        JsValueInitInt32(indexArg, i)
        add(args, indexArg)
        var frame: JsCallFrame
        frame.args = args
        var result: JsValue
        if !jsDispatchChengFn(callbackFnId, frame, result):
            return false
        if JsValueIsTruthy(result):
            return true
    return false

fn JsArrayEveryTruthy(array: var JsArray): bool =
    if array.valuesJs.len > 0:
        for i in 0..<array.valuesJs.len:
            if !JsValueIsTruthy(array.valuesJs[i]):
                return false
        return true
    for i in 0..<array.values.len:
        if array.values[i] == 0:
            return false
    return true

fn JsArraySomeTruthy(array: var JsArray): bool =
    if array.valuesJs.len > 0:
        for i in 0..<array.valuesJs.len:
            if JsValueIsTruthy(array.valuesJs[i]):
                return true
        return false
    for i in 0..<array.values.len:
        if array.values[i] != 0:
            return true
    return false

fn JsArrayFlat(array: var JsArray, out: var JsArray): bool =
    let arrLen: int32 = array.valuesJs.len
    JsArrayInit(out, arrLen)
    for i in 0..<arrLen:
        let item: JsValue = array.valuesJs[i]
        if item.arrayId > 0:
            var nested: JsArray
            if JsArrayLoadById(item.arrayId, nested):
                let nestedLen: int32 = nested.valuesJs.len
                for j in 0..<nestedLen:
                    jsArrayAddJsValue(out, nested.valuesJs[j])
            else:
                jsArrayAddJsValue(out, item)
        else:
            jsArrayAddJsValue(out, item)
    return true

fn JsArrayShift(array: var JsArray, out: var JsValue): bool =
    let n: int32 = array.valuesJs.len
    if n == 0:
        JsValueInitUndefined(out)
        return true
    JsValueCopy(out, array.valuesJs[0])
    var i: int32 = 1
    while i < n:
        array.valuesJs[i - 1] = array.valuesJs[i]
        i = i + 1
    setLen(array.valuesJs, n - 1)
    return true

fn JsArrayUnshift(array: var JsArray, value: var JsValue): bool =
    let n: int32 = array.valuesJs.len
    var stored: JsValue
    JsValueCopy(stored, value)
    add(array.valuesJs, stored)
    var i: int32 = n
    while i > 0:
        array.valuesJs[i] = array.valuesJs[i - 1]
        i = i - 1
    JsValueCopy(array.valuesJs[0], value)
    return true

fn jsValueReadObjectInt32PropertyPath(value: var JsValue, propertyPath: str[], outValue: var int32): bool =
    if propertyPath.len <= 0:
        return false
    var current: JsValue
    JsValueCopy(current, value)
    for i in 0..<propertyPath.len:
        if current.objectId <= 0:
            return false
        var object: JsObject
        if !JsObjectGetById(current.objectId, object):
            return false
        var next: JsValue
        if !JsObjectGetOwnProperty(object, propertyPath[i], next):
            return false
        if i == propertyPath.len - 1:
            if !JsValueIsInt32(next):
                return false
            outValue = JsValueInt32(next)
            return true
        JsValueCopy(current, next)
    return false

fn jsValueReadArrayInt32Index(value: var JsValue, index: int32, outValue: var int32): bool =
    if index < 0 || value.arrayId <= 0:
        return false
    var nested: JsArray
    if !JsArrayLoadById(value.arrayId, nested):
        return false
    if nested.valuesJs.len > 0:
        if index >= nested.valuesJs.len:
            return false
        if !JsValueIsInt32(nested.valuesJs[index]):
            return false
        outValue = JsValueInt32(nested.valuesJs[index])
        return true
    if index >= nested.values.len:
        return false
    outValue = nested.values[index]
    return true

fn jsValueReadObjectOptionalInt32PropertyNullishZero(value: var JsValue, propertyName: str, outValue: var int32): bool =
    if value.objectId <= 0:
        return false
    var object: JsObject
    if !JsObjectGetById(value.objectId, object):
        return false
    var next: JsValue
    if !JsObjectGetOwnProperty(object, propertyName, next):
        outValue = 0
        return true
    if JsValueIsUndefined(next) || JsValueIsNull(next):
        outValue = 0
        return true
    if !JsValueIsInt32(next):
        return false
    outValue = JsValueInt32(next)
    return true

fn jsValueReadArrayOptionalInt32IndexNullishZero(value: var JsValue, index: int32, outValue: var int32): bool =
    if index < 0 || value.arrayId <= 0:
        return false
    var nested: JsArray
    if !JsArrayLoadById(value.arrayId, nested):
        return false
    if nested.valuesJs.len > 0:
        if index >= nested.valuesJs.len:
            outValue = 0
            return true
        if JsValueIsUndefined(nested.valuesJs[index]) || JsValueIsNull(nested.valuesJs[index]):
            outValue = 0
            return true
        if !JsValueIsInt32(nested.valuesJs[index]):
            return false
        outValue = JsValueInt32(nested.valuesJs[index])
        return true
    if index >= nested.values.len:
        outValue = 0
        return true
    outValue = nested.values[index]
    return true

fn jsValueReadObjectOptionalInt32PropertyLogicalOrZero(value: var JsValue, propertyName: str, outValue: var int32): bool =
    if value.objectId <= 0:
        return false
    var object: JsObject
    if !JsObjectGetById(value.objectId, object):
        return false
    var next: JsValue
    if !JsObjectGetOwnProperty(object, propertyName, next):
        outValue = 0
        return true
    if JsValueIsUndefined(next) || JsValueIsNull(next):
        outValue = 0
        return true
    if !JsValueIsInt32(next):
        return false
    outValue = JsValueInt32(next)
    return true

fn jsValueReadArrayOptionalInt32IndexLogicalOrZero(value: var JsValue, index: int32, outValue: var int32): bool =
    if index < 0 || value.arrayId <= 0:
        return false
    var nested: JsArray
    if !JsArrayLoadById(value.arrayId, nested):
        return false
    if nested.valuesJs.len > 0:
        if index >= nested.valuesJs.len:
            outValue = 0
            return true
        if JsValueIsUndefined(nested.valuesJs[index]) || JsValueIsNull(nested.valuesJs[index]):
            outValue = 0
            return true
        if !JsValueIsInt32(nested.valuesJs[index]):
            return false
        outValue = JsValueInt32(nested.valuesJs[index])
        return true
    if index >= nested.values.len:
        outValue = 0
        return true
    outValue = nested.values[index]
    return true

fn JsArraySortJsValueObjectInt32PropertyPath(array: var JsArray, propertyPath: str[], descending: bool): bool =
    if array.values.len > 0:
        jsSetTypeErrorException("Array.sort object int32 key requires JS values")
        return false
    let n: int32 = array.valuesJs.len
    var keys: int32[]
    keys = []
    for i in 0..<n:
        var key: int32
        if !jsValueReadObjectInt32PropertyPath(array.valuesJs[i], propertyPath, key):
            jsSetTypeErrorException("Array.sort object int32 key requires int32 property path")
            return false
        add(keys, key)
    var i: int32
    for i in 0..<n:
        var j: int32 = i
        while j > 0:
            var shouldSwap: bool
            if descending:
                shouldSwap = keys[j - 1] < keys[j]
            else:
                shouldSwap = keys[j - 1] > keys[j]
            if !shouldSwap:
                break
            let tempValue: JsValue = array.valuesJs[j]
            array.valuesJs[j] = array.valuesJs[j - 1]
            array.valuesJs[j - 1] = tempValue
            let tempKey: int32 = keys[j]
            keys[j] = keys[j - 1]
            keys[j - 1] = tempKey
            j = j - 1
    return true

fn JsArraySortJsValueObjectOptionalInt32PropertyNullishZero(array: var JsArray, propertyName: str, descending: bool): bool =
    if array.values.len > 0:
        jsSetTypeErrorException("Array.sort object optional int32 key requires JS values")
        return false
    let n: int32 = array.valuesJs.len
