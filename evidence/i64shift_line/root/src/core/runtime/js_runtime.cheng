fn JsStringDefaultSortCompare(left: str, right: str): int32 =
    let leftLen: int32 = strings.Len(left)
    let rightLen: int32 = strings.Len(right)
    var limit: int32 = leftLen
    if rightLen < limit:
        limit = rightLen
    var i: int32
    for i in 0..<limit:
        let leftCode: int32 = Int32(left[i])
        let rightCode: int32 = Int32(right[i])
        if leftCode < rightCode:
            return -1
        if leftCode > rightCode:
            return 1
    if leftLen < rightLen:
        return -1
    if leftLen > rightLen:
        return 1
    return 0

fn JsStringArrayDefaultSort(values: var str[]) =
    let n: int32 = values.len
    if n <= 1:
        return
    var i: int32
    for i in 0..<n:
        var j: int32 = i
        while j > 0 && JsStringDefaultSortCompare(values[j - 1], values[j]) > 0:
            let temp: str = values[j]
            values[j] = values[j - 1]
            values[j - 1] = temp
            j = j - 1

fn JsArraySortStringDefault(array: var JsArray): bool =
    if array.values.len > 0:
        jsSetTypeErrorException("Array.sort string default requires string values")
        return false
    let n: int32 = array.valuesJs.len
    for i in 0..<n:
        if array.valuesJs[i].kind != JsKindString:
            jsSetTypeErrorException("Array.sort string default requires string values")
            return false
    if n <= 1:
        return true
    var i: int32
    for i in 0..<n:
        var j: int32 = i
        while j > 0 && JsStringDefaultSortCompare(array.valuesJs[j - 1].stringValue, array.valuesJs[j].stringValue) > 0:
            let temp: JsValue = array.valuesJs[j]
            array.valuesJs[j] = array.valuesJs[j - 1]
            array.valuesJs[j - 1] = temp
            j = j - 1
    return true

fn JsArrayIsArray(value: var JsValue): bool =
    return value.arrayId > 0

fn JsStringLength(raw: str): int32 =
    return strings.Len(raw)

fn jsStringMatchAt(haystack: str, needle: str, start: int32): bool =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    if start < 0:
        panic("js string match: negative start")
    if start > haystackLen:
        panic("js string match: start past end")
    if needleLen > haystackLen - start:
        return false
    for i in 0..<needleLen:
        if haystack[start + i] != needle[i]:
            return false
    return true

fn JsStringIndexOf(haystack: str, needle: str): int32 =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    if needleLen == 0:
        return 0
    if needleLen > haystackLen:
        return -1
    let limit: int32 = haystackLen - needleLen
    for start in 0..limit:
        if jsStringMatchAt(haystack, needle, start):
            return start
    return -1

fn JsStringIndexOfFrom(haystack: str, needle: str, fromIndex: int32): int32 =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    var start: int32 = fromIndex
    if start < 0:
        start = 0
    if start > haystackLen:
        start = haystackLen
    if needleLen == 0:
        return start
    if needleLen > haystackLen - start:
        return -1
    let limit: int32 = haystackLen - needleLen
    var i: int32 = start
    while i <= limit:
        if jsStringMatchAt(haystack, needle, i):
            return i
        i = i + 1
    return -1

fn JsStringIncludes(haystack: str, needle: str): bool =
    return JsStringIndexOf(haystack, needle) >= 0

fn JsStringIncludesFrom(haystack: str, needle: str, fromIndex: int32): bool =
    return JsStringIndexOfFrom(haystack, needle, fromIndex) >= 0

fn JsConstStringArrayIncludes(values: str[], needle: str): bool =
    for i in 0..<values.len:
        if values[i] == needle:
            return true
    return false

fn JsStringArrayIndexOf(values: str[], needle: str): int32 =
    for i in 0..<values.len:
        if values[i] == needle:
            return i
    return -1

fn JsConstStringArraySomeEndsWith(values: str[], text: str): bool =
    for i in 0..<values.len:
        if JsStringEndsWith(text, values[i]):
            return true
    return false

fn JsConstStringArraySomeHaystackIncludes(values: str[], text: str): bool =
    for i in 0..<values.len:
        if JsStringIncludes(text, values[i]):
            return true
    return false

fn JsConstStringArraySomeHaystackStartsWith(values: str[], text: str): bool =
    for i in 0..<values.len:
        if JsStringStartsWith(text, values[i]):
            return true
    return false

fn JsStringArraySomeItemIncludes(values: str[], needle: str): bool =
    for i in 0..<values.len:
        if JsStringIncludes(values[i], needle):
            return true
    return false

fn JsStringArraySomeItemStartsWith(values: str[], needle: str): bool =
    for i in 0..<values.len:
        if JsStringStartsWith(values[i], needle):
            return true
    return false

fn JsStringArraySomeItemEndsWith(values: str[], needle: str): bool =
    for i in 0..<values.len:
        if JsStringEndsWith(values[i], needle):
            return true
    return false

fn JsStringStartsWith(haystack: str, needle: str): bool =
    let needleLen: int32 = JsStringLength(needle)
    if needleLen == 0:
        return true
    if needleLen > JsStringLength(haystack):
        return false
    return jsStringMatchAt(haystack, needle, 0)

fn JsStringStartsWithAt(haystack: str, needle: str, position: int32): bool =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    var start: int32 = position
    if start < 0:
        start = 0
    if start > haystackLen:
        start = haystackLen
    if needleLen > haystackLen - start:
        return false
    return jsStringMatchAt(haystack, needle, start)

fn JsStringEndsWith(haystack: str, needle: str): bool =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    if needleLen == 0:
        return true
    if needleLen > haystackLen:
        return false
    return jsStringMatchAt(haystack, needle, haystackLen - needleLen)

fn jsStringIsAsciiTrimChar(ch: char): bool =
    let code: int32 = Int32(ch)
    if code == 32:
        return true
    if code == 9:
        return true
    if code == 10:
        return true
    if code == 13:
        return true
    return false

fn JsStringTrim(raw: str): str =
    let n: int32 = JsStringLength(raw)
    var start: int32
    while start < n && jsStringIsAsciiTrimChar(raw[start]):
        start = start + 1
    if start >= n:
        return ""
    var stop: int32 = n - 1
    while stop >= start && jsStringIsAsciiTrimChar(raw[stop]):
        stop = stop - 1
    let trimLen: int32 = stop - start + 1
    var trimStart: int32 = start
    var trimLen2: int32 = trimLen
    return strings.SliceBytes(raw, trimStart, trimLen2)

fn JsStringCharAt(s: str, index: int32): str =
    let n: int32 = JsStringLength(s)
    if index < 0 || index >= n:
        return ""
    return strings.SliceBytes(s, index, 1)

fn JsStringCharCodeAt(s: str, index: int32): int32 =
    let n: int32 = JsStringLength(s)
    if index < 0 || index >= n:
        return -1
    return Int32(s[index])

fn JsStringSlice(s: str, start: int32, stop: int32): str =
    let n: int32 = JsStringLength(s)
    var begin: int32 = start
    if begin < 0:
        begin = n + begin
    if begin < 0:
        begin = 0
    if begin > n:
        begin = n
    var end: int32 = stop
    if end < 0:
        end = n + end
    if end < 0:
        end = 0
    if end > n:
        end = n
    if end <= begin:
        return ""
    let sliceLen: int32 = end - begin
    return strings.SliceBytes(s, begin, sliceLen)

fn JsStringSubstring(s: str, start: int32, stop: int32): str =
    let n: int32 = JsStringLength(s)
    var begin: int32 = start
    if begin < 0:
        begin = 0
    if begin > n:
        begin = n
    var end: int32 = stop
    if end < 0:
        end = 0
    if end > n:
        end = n
    if begin > end:
        let tmp: int32 = begin
        begin = end
        end = tmp
    if end <= begin:
        return ""
    let sliceLen: int32 = end - begin
    return strings.SliceBytes(s, begin, sliceLen)

# String.fromCharCode(code): create a single-character string from char code
fn JsStringFromCharCode(code: int32): str =
    if code < 0 || code > 65535: return ""
    let c: char = char(code)
    var result: str
    result = Fmt"{result}{c}"
    return result

# String.toLowerCase: convert ASCII uppercase to lowercase
fn JsStringToLowerCase(s: str): str =
    var result: str
    let n: int32 = strings.Len(s)
    let lowerAlphabet: str = "abcdefghijklmnopqrstuvwxyz"
    var i: int32
    while i < n:
        let c: char = s[i]
        if c >= 'A' && c <= 'Z':
            let lowerIdx: int32 = Int32(c) - Int32('A')
            result = jsStrConcat(result, strings.SliceBytes(lowerAlphabet, lowerIdx, 1))
        else:
            result = jsStrConcat(result, strings.SliceBytes(s, i, 1))
        i = i + 1
    return result

# String.toUpperCase: convert ASCII lowercase to uppercase
fn JsStringToUpperCase(s: str): str =
    var result: str
    let n: int32 = strings.Len(s)
    let upperAlphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i: int32
    while i < n:
        let c: char = s[i]
        if c >= 'a' && c <= 'z':
            let upperIdx: int32 = Int32(c) - Int32('a')
            result = jsStrConcat(result, strings.SliceBytes(upperAlphabet, upperIdx, 1))
        else:
            result = jsStrConcat(result, strings.SliceBytes(s, i, 1))
        i = i + 1
    return result

fn JsStringRepeat(s: str, count: int32): str =
    if count <= 0:
        return ""
    var result: str
    var i: int32
    while i < count:
        result = jsStrConcat(result, s)
        i = i + 1
    return result

fn JsStringPadStart(s: str, targetLength: int32, padString: str): str =
    let currentLen: int32 = JsStringLength(s)
    if targetLength <= currentLen:
        return s
    let padLen: int32 = JsStringLength(padString)
    if padLen <= 0:
        return s
    let needed: int32 = targetLength - currentLen
    var prefix: str
    while JsStringLength(prefix) < needed:
        let remaining: int32 = needed - JsStringLength(prefix)
        if padLen <= remaining:
            prefix = jsStrConcat(prefix, padString)
        else:
            prefix = jsStrConcat(prefix, JsStringSlice(padString, 0, remaining))
    return jsStrConcat(prefix, s)

fn JsStringPadEnd(s: str, targetLength: int32, padString: str): str =
    let currentLen: int32 = JsStringLength(s)
    if targetLength <= currentLen:
        return s
    let padLen: int32 = JsStringLength(padString)
    if padLen <= 0:
        return s
    var result: str = s
    while JsStringLength(result) < targetLength:
        let remaining: int32 = targetLength - JsStringLength(result)
        if padLen <= remaining:
            result = jsStrConcat(result, padString)
        else:
            result = jsStrConcat(result, JsStringSlice(padString, 0, remaining))
    return result

fn JsStringLastIndexOf(haystack: str, needle: str): int32 =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    if needleLen == 0:
        return haystackLen
    if needleLen > haystackLen:
        return -1
    let limit: int32 = haystackLen - needleLen
    var i: int32 = limit
    while i >= 0:
        if jsStringMatchAt(haystack, needle, i):
            return i
        i = i - 1
    return -1

fn JsStringLastIndexOfFrom(haystack: str, needle: str, fromIndex: int32): int32 =
    let haystackLen: int32 = JsStringLength(haystack)
    let needleLen: int32 = JsStringLength(needle)
    var end: int32 = fromIndex
    if end < 0:
        end = 0
    if end > haystackLen:
        end = haystackLen
    if needleLen == 0:
        return end
    if needleLen > haystackLen:
        return -1
    var start: int32 = end
    let maxStart: int32 = haystackLen - needleLen
    if start > maxStart:
        start = maxStart
    while start >= 0:
        if jsStringMatchAt(haystack, needle, start):
            return start
        start = start - 1
    return -1

fn JsStringSplit(s: str, separator: str): JsArray =
    var result: JsArray
    JsArrayInit(result, 8)
    let sLen: int32 = JsStringLength(s)
    let sepLen: int32 = JsStringLength(separator)
    if sepLen == 0:
        var i: int32
        for i in 0..<sLen:
            var val: JsValue
            JsValueInitString(val, strings.SliceBytes(s, i, 1))
            jsArrayAddJsValue(result, val)
        return result
    var pos: int32
    while pos <= sLen:
        let remainLen: int32 = sLen - pos
        let remaining: str = strings.SliceBytes(s, pos, remainLen)
        let found: int32 = JsStringIndexOf(remaining, separator)
        if found < 0:
            var val: JsValue
            let remainLen: int32 = sLen - pos
            JsValueInitString(val, strings.SliceBytes(s, pos, remainLen))
            jsArrayAddJsValue(result, val)
            break
        var val: JsValue
        JsValueInitString(val, strings.SliceBytes(s, pos, found))
        jsArrayAddJsValue(result, val)
        pos = pos + found + sepLen
    return result

fn jsStringSplitPushSlice(result: var JsArray, s: str, start: int32, stop: int32) =
    var val: JsValue
    let sliceLen: int32 = stop - start
    JsValueInitString(val, strings.SliceBytes(s, start, sliceLen))
    jsArrayAddJsValue(result, val)

fn JsStringSplitCrLfOptLf(s: str): JsArray =
    var result: JsArray
    JsArrayInit(result, 8)
    let n: int32 = JsStringLength(s)
    var start: int32
    var i: int32
    while i < n:
        let ch: str = strings.SliceBytes(s, i, 1)
        if ch == "\n":
            var stop: int32 = i
            let prevStop: int32 = stop - 1
            if stop > start && strings.SliceBytes(s, prevStop, 1) == "\r":
                stop = stop - 1
            jsStringSplitPushSlice(result, s, start, stop)
            i = i + 1
            start = i
        else:
            i = i + 1
    jsStringSplitPushSlice(result, s, start, n)
    return result

fn JsStringSplitLineBreak(s: str): JsArray =
    var result: JsArray
    JsArrayInit(result, 8)
    let n: int32 = JsStringLength(s)
    var start: int32
    var i: int32
    while i < n:
        let ch: str = strings.SliceBytes(s, i, 1)
        if ch == "\r":
            jsStringSplitPushSlice(result, s, start, i)
            i = i + 1
            if i < n && strings.SliceBytes(s, i, 1) == "\n":
                i = i + 1
            start = i
        elif ch == "\n":
            jsStringSplitPushSlice(result, s, start, i)
            i = i + 1
            start = i
        else:
            i = i + 1
    jsStringSplitPushSlice(result, s, start, n)
    return result

fn jsStringIsAsciiDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn jsRegexBodyCharEscaped(body: str, index: int32): bool =
    var count: int32
    var i: int32 = index - 1
    while i >= 0 && body[i] == '\\':
        count = count + 1
        i = i - 1
    return count % 2 == 1

fn jsRegexAsciiBodyUsesRun(body: str): bool =
    let n: int32 = JsStringLength(body)
    return n > 0 && body[n - 1] == '+' && !jsRegexBodyCharEscaped(body, n - 1)

fn jsRegexAsciiClassToken(body: str,
                          index: int32,
                          stop: int32,
                          outKind: var int32,
                          outChar: var char,
                          outNext: var int32): bool =
    if index >= stop:
        return false
    let ch: char = body[index]
    if ch == '\\':
        if index + 1 >= stop:
            return false
        let next: char = body[index + 1]
        if next == 's' || next == 'd' || next == 'D':
            outKind = 2
            outChar = next
            outNext = index + 2
            return true
        outKind = 1
        outChar = next
        outNext = index + 2
        return true
    outKind = 1
    outChar = ch
    outNext = index + 1
    return true

fn jsRegexAsciiClassTokenMatches(kind: int32, token: char, ch: char): bool =
    if kind == 1:
        return ch == token
    if token == 's':
        return jsStringIsAsciiTrimChar(ch)
    if token == 'd':
        return jsStringIsAsciiDigit(ch)
    if token == 'D':
        return !jsStringIsAsciiDigit(ch)
    return false

fn jsRegexAsciiClassMatches(body: str, start: int32, stop: int32, ch: char, outSupported: var bool): bool =
    if stop - start < 2:
        outSupported = false
        return false
    if body[start] != '[' || body[stop - 1] != ']':
        outSupported = false
        return false
    var i: int32 = start + 1
    var negated: bool
    if i < stop - 1 && body[i] == '^':
        negated = true
        i = i + 1
    if i >= stop - 1:
        outSupported = false
        return false
    var matched: bool
    while i < stop - 1:
        var kind: int32
        var token: char
        var next: int32
        if !jsRegexAsciiClassToken(body, i, stop - 1, kind, token, next):
            outSupported = false
            return false
        if next < stop - 1 && body[next] == '-':
            var rightKind: int32
            var rightToken: char
            var rightNext: int32
            if !jsRegexAsciiClassToken(body, next + 1, stop - 1, rightKind, rightToken, rightNext):
                outSupported = false
                return false
            if kind != 1 || rightKind != 1 || token > rightToken:
                outSupported = false
                return false
            if ch >= token && ch <= rightToken:
                matched = true
            i = rightNext
        else:
            if jsRegexAsciiClassTokenMatches(kind, token, ch):
                matched = true
            i = next
    outSupported = true
    if negated:
        return !matched
    return matched

fn jsRegexAsciiBodyMatches(body: str, ch: char, outSupported: var bool): bool =
    let n: int32 = JsStringLength(body)
    if n <= 0:
        outSupported = false
        return false
    var stop: int32 = n
    if jsRegexAsciiBodyUsesRun(body):
        stop = n - 1
    if stop == 2 && body[0] == '\\':
        let token: char = body[1]
        if token == 's' || token == 'd' || token == 'D':
            outSupported = true
            return jsRegexAsciiClassTokenMatches(2, token, ch)
    if stop >= 2 && body[0] == '[':
        return jsRegexAsciiClassMatches(body, 0, stop, ch, outSupported)
    outSupported = false
    return false

fn JsStringReplaceAsciiClassRegex(s: str, body: str, replacement: str, out: var str): bool =
    let n: int32 = JsStringLength(s)
    let run: bool = jsRegexAsciiBodyUsesRun(body)
    out = ""
    var i: int32
    while i < n:
        var supported: bool
        let matched: bool = jsRegexAsciiBodyMatches(body, s[i], supported)
        if !supported:
            return false
        if !matched:
            out = jsStrConcat(out, strings.SliceBytes(s, i, 1))
            i = i + 1
            continue
        let matchStart: int32 = i
        var matchStop: int32 = i + 1
        if run:
            while matchStop < n:
                var runSupported: bool
                if !jsRegexAsciiBodyMatches(body, s[matchStop], runSupported):
                    if !runSupported:
                        return false
                    break
                matchStop = matchStop + 1
        let prefix: str = strings.SliceBytes(s, 0, matchStart)
        let suffix: str = strings.SliceBytes(s, matchStop, n - matchStop)
        let matchText: str = strings.SliceBytes(s, matchStart, matchStop - matchStart)
        out = jsStrConcat(out, JsStringReplacementSubstitution(replacement, matchText, prefix, suffix))
        i = matchStop
    return true

fn JsStringSplitAsciiClassRegex(s: str, body: str, out: var JsArray): bool =
    JsArrayInit(out, 8)
    let n: int32 = JsStringLength(s)
    let run: bool = jsRegexAsciiBodyUsesRun(body)
    var start: int32
    var i: int32
    while i < n:
        var supported: bool
        let matched: bool = jsRegexAsciiBodyMatches(body, s[i], supported)
        if !supported:
            return false
        if !matched:
            i = i + 1
            continue
        jsStringSplitPushSlice(out, s, start, i)
        i = i + 1
        if run:
            while i < n:
                var runSupported: bool
                if !jsRegexAsciiBodyMatches(body, s[i], runSupported):
                    if !runSupported:
                        return false
                    break
                i = i + 1
        start = i
    jsStringSplitPushSlice(out, s, start, n)
    return true

fn JsStringReplace(s: str, search: str, replacement: str): str =
    let found: int32 = JsStringIndexOf(s, search)
    if found < 0:
        return s
    let sLen: int32 = JsStringLength(s)
    let searchLen: int32 = JsStringLength(search)
    let prefix: str = strings.SliceBytes(s, 0, found)
    let suffixStart: int32 = found + searchLen
    let suffixLen: int32 = sLen - found - searchLen
    let suffix: str = strings.SliceBytes(s, suffixStart, suffixLen)
    let matched: str = strings.SliceBytes(s, found, searchLen)
    let substituted: str = JsStringReplacementSubstitution(replacement, matched, prefix, suffix)
    return jsStrConcat(jsStrConcat(prefix, substituted), suffix)

fn JsStringReplaceAllLiteral(s: str, search: str, replacement: str): str =
    let searchLen: int32 = JsStringLength(search)
    if searchLen <= 0:
        return JsStringReplace(s, search, replacement)
    let sLen: int32 = JsStringLength(s)
    var result: str
    var cursor: int32
    while cursor < sLen:
        var found: int32 = -1
        var i: int32 = cursor
        while i + searchLen <= sLen:
            if jsStringMatchAt(s, search, i):
                found = i
                break
            i = i + 1
        if found < 0:
            let remainLen: int32 = sLen - cursor
            result = jsStrConcat(result, strings.SliceBytes(s, cursor, remainLen))
            return result
        if found > cursor:
            let foundLen: int32 = found - cursor
            result = jsStrConcat(result, strings.SliceBytes(s, cursor, foundLen))
        let prefix: str = strings.SliceBytes(s, 0, found)
        let suffixStart: int32 = found + searchLen
        let suffixLen: int32 = sLen - found - searchLen
        let suffix: str = strings.SliceBytes(s, suffixStart, suffixLen)
        let matched: str = strings.SliceBytes(s, found, searchLen)
        result = jsStrConcat(result, JsStringReplacementSubstitution(replacement, matched, prefix, suffix))
        cursor = found + searchLen
    return result

fn JsStringReplacementSubstitution(replacement: str, matched: str, prefix: str, suffix: str): str =
    var result: str
    let n: int32 = JsStringLength(replacement)
    var i: int32
    while i < n:
        let ch: char = replacement[i]
        if ch != '$':
            result = jsStrConcat(result, strings.SliceBytes(replacement, i, 1))
            i = i + 1
            continue
        if i + 1 >= n:
            result = jsStrConcat(result, "$")
            i = i + 1
            continue
        let next: char = replacement[i + 1]
        if next == '$':
            result = jsStrConcat(result, "$")
            i = i + 2
        elif next == '&':
            result = jsStrConcat(result, matched)
            i = i + 2
        elif next == '`':
            result = jsStrConcat(result, prefix)
            i = i + 2
        elif Int32(next) == 39:
            result = jsStrConcat(result, suffix)
            i = i + 2
        else:
            result = jsStrConcat(result, "$")
            i = i + 1
    return result

type
    JsFunction =
        functionId: int32
        name: str
        paramNames: str[]
        bodyKind: int32
        closureEnv: JsValue[]
        bytecode: int32[]
        chengFnId: int32
        constPool: JsValue[]
        stringTable: str[]

    JsCallFrame =
        functionId: int32
        func: JsFunction
        thisBinding: JsValue
        args: JsValue[]
        locals: JsValue[]
        parentFrameIndex: int32
        pc: int32

    JsException =
        kind: int32
        value: JsValue
        stack: str

var
    jsExceptionPending: bool
    jsExceptionValue: JsException
    jsCallStack: JsCallFrame[]
    jsCallStackSize: int32 = 0
    jsObjectTable: JsObject[]
    jsObjectCount: int32 = 0
    jsErrorPrototypeObjectId: int32 = 0
    jsArrayTable: JsArray[]
    jsArrayCount: int32 = 0
    jsFunctionTable: JsFunction[]
    jsFunctionCount: int32 = 0

    jsArrayBufferTable: JsArrayBuffer[]
    jsArrayBufferCount: int32 = 0

    jsTypedArrayTable: JsTypedArray[]
    jsTypedArrayCount: int32 = 0

    jsDataViewTable: JsDataView[]
    jsDataViewCount: int32 = 0

    jsMapTable: JsMap[]
    jsMapCount: int32 = 0

    jsSetTable: JsSet[]
    jsSetCount: int32 = 0

fn jsSetUnsupportedException(message: str) =
    var value: JsValue
    JsValueInitString(value, message)
    jsExceptionPending = true
    JsExceptionInit(jsExceptionValue, JsExceptionUnsupported, value)

fn jsSetTypeErrorException(message: str) =
    var value: JsValue
    JsValueInitString(value, message)
    jsExceptionPending = true
    JsExceptionInit(jsExceptionValue, JsExceptionTypeError, value)

fn JsFunctionInit(out: var JsFunction, name: str) =
    out.name = name
    out.paramNames = []
    out.bodyKind = JsBodyKindNative
    out.closureEnv = []
    out.bytecode = []
    out.chengFnId = 0
    out.functionId = 0
    out.constPool = []
    out.stringTable = []

fn JsFunctionSetParams(out: var JsFunction, params: str[]) =
    out.paramNames = params

fn JsFunctionSetBodyKind(out: var JsFunction, kind: int32) =
    out.bodyKind = kind

fn JsFunctionSetClosureEnv(out: var JsFunction, env: JsValue[]) =
    out.closureEnv = env

fn JsFunctionSetChengFn(out: var JsFunction, chengFnId: int32) =
    out.chengFnId = chengFnId

fn JsFunctionSetBytecode(out: var JsFunction, bc: int32[]) =
    out.bytecode = bc

fn JsFunctionSetConstPool(out: var JsFunction, pool: JsValue[]) =
fn JsFunctionGetById(id: int32, out: var JsFunction): bool =
    if id < 0 || id >= jsFunctionCount: return false
    out = jsFunctionTable[id]
    return true
    return &jsFunctionTable[id]

fn JsFunctionLoadById(id: int32, out: var JsFunction): bool =
    if id < 0 || id >= jsFunctionCount:
        return false
    JsFunctionCopy(out, jsFunctionTable[id])
    return true

fn JsFunctionName(func: var JsFunction): str =
    return func.name

fn JsFunctionBodyKind(func: var JsFunction): int32 =
    return func.bodyKind

fn JsFunctionBytecode(func: var JsFunction): int32[] =
    return func.bytecode

fn JsFunctionChengFnId(func: var JsFunction): int32 =
    return func.chengFnId

fn JsFunctionCopy(out: var JsFunction, func: var JsFunction) =
    out.functionId = func.functionId
    out.name = func.name
    out.paramNames = func.paramNames
    out.bodyKind = func.bodyKind
    out.closureEnv = func.closureEnv
    out.bytecode = func.bytecode
    out.chengFnId = func.chengFnId
    out.constPool = func.constPool
    out.stringTable = func.stringTable

fn JsCallFrameInit(frame: var JsCallFrame,
                   functionId: int32,
                   thisBinding: var JsValue,
                   args: JsValue[]) =
    frame.functionId = functionId
    JsValueCopy(frame.thisBinding, thisBinding)
    frame.args = args
    frame.locals = []
    frame.parentFrameIndex = -1
    frame.pc = 0

fn JsCallFrameInitFull(frame: var JsCallFrame,
                       func: var JsFunction,
                       thisBinding: var JsValue,
                       args: JsValue[]) =
    frame.functionId = 0
    frame.func = func
    JsValueCopy(frame.thisBinding, thisBinding)
    frame.args = args
    frame.locals = []
    // Copy args into locals so bytecode can access them by index
    for i in 0..<args.len:
        add(frame.locals, args[i])
    frame.parentFrameIndex = -1
    frame.pc = 0

fn JsExceptionInit(out: var JsException, kind: int32, value: var JsValue) =
    out.kind = kind
    JsValueCopy(out.value, value)
    out.stack = ""

fn JsExceptionInitWithStack(out: var JsException,
                             kind: int32,
                             value: var JsValue,
                             stack: str) =
    JsExceptionInit(out, kind, value)
    out.stack = stack

fn jsThrowException(kind: int32, value: var JsValue): JsException =
    var exc: JsException
    JsExceptionInit(exc, kind, value)
    return exc

fn jsCatchException(exc: var JsException, outValue: var JsValue): int32 =
    JsValueCopy(outValue, exc.value)
    return exc.kind

fn jsCreateClosure(func: var JsFunction, env: JsValue[]): JsFunction =
    var closure: JsFunction
    JsFunctionCopy(closure, func)
    closure.closureEnv = env
    return closure

fn jsCallFunction(func: var JsFunction,
                  thisBinding: var JsValue,
                  args: JsValue[],
                  result: var JsValue): bool =
    JsValueInitUndefined(result)
    if func.bodyKind == JsBodyKindChengFn && func.chengFnId != 0:
        var frame: JsCallFrame
        JsCallFrameInitFull(frame, func, thisBinding, args)
        if jsDispatchChengFn(func.chengFnId, frame, result):
            return true
        let message: str = "js cheng function dispatch: unknown fn id"
        JsValueInitString(result, message)
        jsSetUnsupportedException(message)
        return false
    if func.bodyKind == JsBodyKindBytecode:
        var frame: JsCallFrame
        JsCallFrameInitFull(frame, func, thisBinding, args)
        let r = jsExecuteCallFrame(frame)
        if jsExceptionIsPending():
            JsValueCopy(result, jsExceptionValue.value)
            return false
        JsValueCopy(result, r)
        return true
    jsSetUnsupportedException("js call function unsupported body kind")
    return false

# --- JS builtin wrappers ---

# sin(x) via Taylor: x - x^3/3! + x^5/5! - x^7/7! + x^9/9!
fn JsMathSin(x: float64): float64 =
    let pi = float64(3.141592653589793)
    let twoPi = pi * float64(2.0)
    var xr = x
    while xr > pi: xr = xr - twoPi
    while xr < float64(0.0) - pi: xr = xr + twoPi
    let x2 = xr * xr
    let x3 = x2 * xr
    let x5 = x3 * x2
    let x7 = x5 * x2
    let x9 = x7 * x2
    return xr - x3/float64(6.0) + x5/float64(120.0) - x7/float64(5040.0) + x9/float64(362880.0)

# cos(x) via Taylor: 1 - x^2/2! + x^4/4! - x^6/6! + x^8/8!
fn JsMathCos(x: float64): float64 =
    let pi = float64(3.141592653589793)
    let twoPi = pi * float64(2.0)
    var xr = x
    while xr > pi: xr = xr - twoPi
    while xr < float64(0.0) - pi: xr = xr + twoPi
    let x2 = xr * xr
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x6 * x2
    return float64(1.0) - x2/float64(2.0) + x4/float64(24.0) - x6/float64(720.0) + x8/float64(40320.0)

# tan(x) = sin(x)/cos(x)
fn JsMathTan(x: float64): float64 =
    let c = JsMathCos(x)
    if c == float64(0.0) || float64(0.0) - c == float64(0.0): return float64(0.0)
    return JsMathSin(x) / c

# log(x) via Newton: iterate y = y - 1 + x/exp(y)
fn JsMathLog(x: float64): float64 =
    if x <= float64(0.0): return float64(0.0)
    var y = x / float64(2.718281828459045)
    var i: int32
    for i in 0..<8:
        let ey = JsMathExp(y)
        if ey <= float64(0.0): break
        y = y - float64(1.0) + x / ey
    return y

# exp(x) via Taylor: 1 + x + x^2/2! + x^3/3! + ... + x^10/10!
fn JsMathExp(x: float64): float64 =
    var result = float64(1.0) + x
    var term = x
    var i: int32
    for i in 2..<11:
        term = term * x / float64(i)
        result = result + term
    return result

# pow(base, exp) = exp(exp * log(base))
fn JsMathPow(base: float64, exp: float64): float64 =
    if base <= float64(0.0): return float64(0.0)
    return JsMathExp(exp * JsMathLog(base))

# sqrt via Newton: y = (y + x/y) / 2
fn JsMathSqrt(x: float64): float64 =
    if x <= float64(0.0): return float64(0.0)
    var y = x / float64(2.0)
    var i: int32
    for i in 0..<10:
        if y <= float64(0.0): break
        y = (y + x / y) / float64(2.0)
    return y

# Math.hypot(x, y): sqrt(x*x + y*y)
fn JsMathHypot(x: float64, y: float64): float64 =
    return JsMathSqrt(x * x + y * y)

# Number.parseFloat: parse string to float64
fn JsNumberParseFloat(value: str): float64 =
    if JsStringLength(value) == 0: return float64(0.0)
    var result: float64 = float64(0.0)
    var fracPart: float64 = float64(0.0)
    var fracDiv: float64 = float64(1.0)
    var sign: float64 = float64(1.0)
    var pos: int32
    let n = JsStringLength(value)
    while pos < n && (value[pos] == ' ' || value[pos] == '\t'): pos = pos + 1
    if pos >= n: return float64(0.0)
    if value[pos] == '-': sign = float64(-1.0); pos = pos + 1
    elif value[pos] == '+': pos = pos + 1
    while pos < n && value[pos] >= '0' && value[pos] <= '9':
        result = result * float64(10.0) + float64(Int32(value[pos]) - 48)
        pos = pos + 1
    if pos < n && value[pos] == '.':
        pos = pos + 1
        while pos < n && value[pos] >= '0' && value[pos] <= '9':
            fracPart = fracPart * float64(10.0) + float64(Int32(value[pos]) - 48)
            fracDiv = fracDiv * float64(10.0)
            pos = pos + 1
    return (result + fracPart / fracDiv) * sign

# Number.parseInt: parse string to int32
fn JsNumberParseInt(s: str): int32 =
    if JsStringLength(s) == 0: return 0
    var result: int32
    var sign: int32 = 1
    var pos: int32
    let n = JsStringLength(s)
    while pos < n && (s[pos] == ' ' || s[pos] == '\t'): pos = pos + 1
    if pos >= n: return 0
    if s[pos] == '-': sign = -1; pos = pos + 1
    elif s[pos] == '+': pos = pos + 1
    while pos < n && s[pos] >= '0' && s[pos] <= '9':
        result = result * 10 + (Int32(s[pos]) - 48)
        pos = pos + 1
    return result * sign

# Number.NaN: IEEE 754 not-a-number
fn JsNumberNaN(): float64 =
    return float64(0.0) / float64(0.0)

# Number.isNaN: NaN is the only value not equal to itself
fn JsNumberIsNaN(value: float64): bool =
    return value != value

# Number.POSITIVE_INFINITY
fn JsNumberPositiveInfinity(): float64 =
    return float64(1.0) / float64(0.0)

# Number.NEGATIVE_INFINITY
fn JsNumberNegativeInfinity(): float64 =
    return (float64(0.0) - float64(1.0)) / float64(0.0)

# Number.EPSILON: 2^-52
fn JsNumberEpsilon(): float64 =
    return float64(1.0) / float64(4503599627370496.0)

# Number.MAX_SAFE_INTEGER: 2^53 - 1
fn JsNumberMaxSafeInteger(): int64 =
    return Int64(9007199254740991)

# Number.MIN_SAFE_INTEGER: -(2^53 - 1)
fn JsNumberMinSafeInteger(): int64 =
    return Int64(-9007199254740991)

# Number.MAX_VALUE: largest positive finite float64 (approx 1.8e308)
fn JsNumberMaxValue(): float64 =
    return float64(1.7976931348623157e+308)

# Number.MIN_VALUE: smallest positive float64
fn JsNumberMinValue(): float64 =
    return float64(5e-324)

# Number.toFixed: format number to fixed decimal places
fn JsNumberToFixed(value: float64, digits: int32): str =
    var d: int32 = digits
    if d < 0:
        d = 0
    if d > 20:
        d = 20

    var pow10: int32 = 1
    var i: int32
    while i < d:
        pow10 = pow10 * 10
        i = i + 1

    if d == 0:
        return strings.IntToStr(int(value))

    var isNegative: bool
    var absVal: float64 = value
    if value < float64(0.0):
        isNegative = true
        absVal = -absVal

    var intPart: int32 = int(absVal)

    var factor: float64 = float64(1.0)
    var j: int32
    while j < d:
        factor = factor * float64(10.0)
        j = j + 1

    var fracInt: int32 = int((absVal - float64(intPart)) * factor + float64(0.5))

    if fracInt >= pow10:
        fracInt = fracInt - pow10
        intPart = intPart + 1

    var intStr: str = strings.IntToStr(intPart)
    if isNegative:
        intStr = jsStrConcat("-", intStr)

    var fracStr: str = strings.IntToStr(fracInt)
    var padLen: int32 = d - JsStringLength(fracStr)
    var result: str = jsStrConcat(intStr, ".")
    var k: int32
    while k < padLen:
        result = jsStrConcat(result, "0")
        k = k + 1
    result = jsStrConcat(result, fracStr)
    return result

# Intl.DateTimeFormat: returns a formatter handle
fn JsIntlDateTimeFormat(): int32 =
    return 1

# Intl.DateTimeFormatFormat: format timestamp to ISO string
fn JsIntlDateTimeFormatFormat(formatterId: int32, timestamp: int64): str =
    return JsDateToISOString(timestamp)

# Object.fromEntries: create object from [key, value] pairs array
fn JsObjectFromEntries(entries: JsArray): JsValue =
    var result: JsValue
    JsValueInitUndefined(result)
    var obj: JsObject
    let objId: int32 = jsObjectCount + 1
    JsObjectInit(obj, objId, 0)
    add(jsObjectTable, obj)
    jsObjectCount = jsObjectCount + 1
    JsValueInitObject(result, objId)
    var objIndex: int32 = -1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == objId:
            objIndex = i
            break
    if objIndex < 0:
        return result
    let entriesLen: int32 = entries.valuesJs.len
    for i in 0..<entriesLen:
        let entryVal = entries.valuesJs[i]
        if entryVal.arrayId > 0:
            var entryArr: JsArray
            if !JsArrayLoadById(entryVal.arrayId, entryArr): continue
            if entryArr.valuesJs.len < 2: continue
            let keyVal = entryArr.valuesJs[0]
            let valVal = entryArr.valuesJs[1]
            if keyVal.kind == JsKindString:
                var descriptor: JsPropertyDescriptor
                JsDescriptorInitData(descriptor, true, true, true)
                JsObjectDefineDataProperty(jsObjectTable[objIndex], keyVal.stringValue, valVal, descriptor)
    return result

var jsRandomSeed: int32 = 12345

fn JsMathRandom(): float64 =
    jsRandomSeed = jsRandomSeed * 1103515245 + 12345
    jsRandomSeed = jsRandomSeed & 0x7fffffff
    return float64(jsRandomSeed) / float64(0x7fffffff)

fn JsRegExpTest(pattern: str, text: str): bool =
    return JsStringIndexOf(text, pattern) >= 0

fn JsStringMatch(text: str, pattern: str): str =
    if JsStringIndexOf(text, pattern) < 0: return ""
    return pattern

fn JsValueToString(value: var JsValue): str =
    if JsValueIsUndefined(value):
        return "undefined"
    if JsValueIsNull(value):
        return "null"
    if JsValueIsBool(value):
        return JsStringFromBool(value.boolValue)
    if JsValueIsInt32(value):
        return strings.IntToStr(value.int32Value)
    if JsValueIsString(value):
        return value.stringValue
    if value.kind == JsKindObject:
        if value.arrayId > 0:
            return "[object Array]"
        return "[object Object]"
    return "undefined"

// Zero-padding helpers for ISO 8601 date formatting

fn jsPadTwo(n: int32): str =
    if n < 10:
        let s: str = strings.IntToStr(n)
        return Fmt"0{s}"
    return strings.IntToStr(n)

fn jsPadThree(n: int32): str =
    if n < 10:
        let s: str = strings.IntToStr(n)
        return Fmt"00{s}"
    elif n < 100:
        let s: str = strings.IntToStr(n)
        return Fmt"0{s}"
    return strings.IntToStr(n)

fn jsPadFour(n: int32): str =
    if n < 10:
        let s: str = strings.IntToStr(n)
        return Fmt"000{s}"
    elif n < 100:
        let s: str = strings.IntToStr(n)
        return Fmt"00{s}"
    elif n < 1000:
        let s: str = strings.IntToStr(n)
        return Fmt"0{s}"
    return strings.IntToStr(n)

fn JsDateToISOString(timestampMs: int64): str =
    let msPart: int64 = timestampMs % Int64(1000)
    var msPartAbs: int32 = Int32(msPart)
    if msPartAbs < 0:
        msPartAbs = -msPartAbs

    let totalSeconds: int64 = timestampMs / Int64(1000)

    var days: int64 = totalSeconds / Int64(86400)
    var daySeconds: int64 = totalSeconds % Int64(86400)
    if daySeconds < Int64(0):
        days = days - Int64(1)
        daySeconds = daySeconds + Int64(86400)

    let hours: int32 = Int32(daySeconds / Int64(3600))
    let minutes: int32 = Int32((daySeconds % Int64(3600)) / Int64(60))
    let seconds: int32 = Int32(daySeconds % Int64(60))

    // Howard Hinnant algorithm: days since 1970-01-01 to Gregorian date
    let z: int64 = days + Int64(719468)
    let era: int64 = (z >= Int64(0)) ? (z / Int64(146097)) : ((z - Int64(146096)) / Int64(146097))
    let doe: int64 = z - era * Int64(146097)
    let yoe: int64 = (doe - doe/Int64(1460) + doe/Int64(36524) - doe/Int64(146096)) / Int64(365)
    let y: int64 = yoe + era * Int64(400)
    let doy: int64 = doe - (Int64(365)*yoe + yoe/Int64(4) - yoe/Int64(100))
    let mp: int64 = (Int64(5)*doy + Int64(2)) / Int64(153)
    let d: int64 = doy - (Int64(153)*mp + Int64(2)) / Int64(5) + Int64(1)
    let m: int64 = mp + Int64(3)

    var year: int64 = y
    var month: int64 = m
    var day: int64 = d
    if m > Int64(12):
        year = y + Int64(1)
        month = m - Int64(12)

    let yearInt: int32 = Int32(year)
    let monthInt: int32 = Int32(month)
    let dayInt: int32 = Int32(day)

    var yearStr: str
    if year < Int64(0):
        let negYearStr: str = jsPadFour(-yearInt)
        yearStr = Fmt"-{negYearStr}"
    else:
        yearStr = jsPadFour(yearInt)

    let padMonth: str = jsPadTwo(monthInt)
    let padDay: str = jsPadTwo(dayInt)
    let padHours: str = jsPadTwo(hours)
    let padMinutes: str = jsPadTwo(minutes)
    let padSeconds: str = jsPadTwo(seconds)
    let padMs: str = jsPadThree(msPartAbs)
    return Fmt"{yearStr}-{padMonth}-{padDay}T{padHours}:{padMinutes}:{padSeconds}.{padMs}Z"

# Date.getUTCMinutes(timestampMs): extract minutes (0-59) from Unix timestamp
fn JsDateGetUTCMinutes(timestampMs: int64): int32 =
    let totalMinutes: int64 = timestampMs / Int64(60000)
    return Int32(totalMinutes % Int64(60))

# Date.getUTCHours(timestampMs): extract hours (0-23) from Unix timestamp
fn JsDateGetUTCHours(timestampMs: int64): int32 =
    let totalHours: int64 = timestampMs / Int64(3600000)
    return Int32(totalHours % Int64(24))

# Date.getUTCSeconds(timestampMs): extract seconds (0-59) from Unix timestamp
fn JsDateGetUTCSeconds(timestampMs: int64): int32 =
    let totalSeconds: int64 = timestampMs / Int64(1000)
    return Int32(totalSeconds % Int64(60))

# Date.getUTCMilliseconds(timestampMs): extract milliseconds (0-999) from Unix timestamp
fn JsDateGetUTCMilliseconds(timestampMs: int64): int32 =
    return Int32(timestampMs % Int64(1000))

# Date.UTC(year, month, day, hours, minutes, seconds, ms): returns Unix timestamp in ms
# month is 0-indexed (0=January) per JS spec. year must be >= 1970.
fn JsDateUTC(year: int32, month: int32, day: int32, hours: int32, minutes: int32, seconds: int32, ms: int32): int64 =
    var totalDays: int64 = Int64(0)
    var y2: int32 = 1970
    while y2 < year:
        if (y2 % 4 == 0 && y2 % 100 != 0) || (y2 % 400 == 0):
            totalDays = totalDays + Int64(366)
        else:
            totalDays = totalDays + Int64(365)
        y2 = y2 + 1
    let isLeap: bool = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
    if month > 0: totalDays = totalDays + Int64(31)
    if month > 1: totalDays = totalDays + Int64(isLeap ? 29 : 28)
    if month > 2: totalDays = totalDays + Int64(31)
    if month > 3: totalDays = totalDays + Int64(30)
    if month > 4: totalDays = totalDays + Int64(31)
    if month > 5: totalDays = totalDays + Int64(30)
    if month > 6: totalDays = totalDays + Int64(31)
    if month > 7: totalDays = totalDays + Int64(31)
    if month > 8: totalDays = totalDays + Int64(30)
    if month > 9: totalDays = totalDays + Int64(31)
    if month > 10: totalDays = totalDays + Int64(30)
    totalDays = totalDays + Int64(day - 1)
    let msPerDay: int64 = Int64(86400000)
    var result: int64 = totalDays * msPerDay
    result = result + Int64(hours) * Int64(3600000)
    result = result + Int64(minutes) * Int64(60000)
    result = result + Int64(seconds) * Int64(1000)
    result = result + Int64(ms)
    return result

# --- New engine functions ---

fn jsNewFunction(name: str,
                 params: str[],
                 bodyKind: int32,
                 chengFnId: int32): JsFunction =
    var func: JsFunction
    JsFunctionInit(func, name)
    func.paramNames = params
    func.bodyKind = bodyKind
    func.chengFnId = chengFnId
    return func

fn jsResolveThis(frame: var JsCallFrame): JsValue =
    return frame.thisBinding

fn jsExecuteCallFrame(frame: var JsCallFrame): JsValue =
    var result: JsValue
    JsValueInitUndefined(result)
    if frame.func.bodyKind == JsBodyKindBytecode:
        return jsExecuteBytecode(frame)
    elif frame.func.bodyKind == JsBodyKindChengFn && frame.func.chengFnId != 0:
        if jsDispatchChengFn(frame.func.chengFnId, frame, result):
            return result
        else:
            jsSetUnsupportedException("js cheng function dispatch: unknown fn id")
            JsValueInitUndefined(result)
            return result
    else:
        jsSetUnsupportedException("js execute call frame unsupported")
        JsValueInitUndefined(result)
        return result

// Bytecode op constants (match what the TS→CSG-Web compiler emits)
const JS_BC_PUSH_CONST = 1
const JS_BC_PUSH_LOCAL = 2
const JS_BC_POP_LOCAL = 3
const JS_BC_CALL = 4
const JS_BC_RETURN = 5
const JS_BC_GET_PROP = 6
const JS_BC_SET_PROP = 7

fn jsExecuteBytecode(frame: var JsCallFrame): JsValue =
    var result: JsValue
    JsValueInitUndefined(result)
    jsSetUnsupportedException("js bytecode execution unsupported")
    return result

// Global function table for bytecode CALL resolution
var jsGlobalFnTable: JsFunction[]
var jsChengFnRegistered: bool[]

fn jsRegisterGlobalFunction(fn: JsFunction): int32 =
    add(jsGlobalFnTable, fn)
    return jsGlobalFnTable.len - 1

fn jsResolveFunction(frame: var JsCallFrame, funcIndex: int32): JsFunction =
    if funcIndex > 0 && funcIndex <= jsGlobalFnTable.len:
        return jsGlobalFnTable[funcIndex - 1]
    var f: JsFunction
    JsFunctionInit(f, "")
    return f

// --- Cheng native function dispatch bridge ---
// Registers a chengFnId so it can be dispatched by jsDispatchChengFn.
// Returns true on success, false if the id is already registered.
fn jsRegisterChengFn(chengFnId: int32): bool =
    if chengFnId < 0:
        return false
    // Grow the registration table if needed
    while jsChengFnRegistered.len <= chengFnId:
        add(jsChengFnRegistered, false)
    if jsChengFnRegistered[chengFnId]:
        return false
    jsChengFnRegistered[chengFnId] = true
    return true

fn jsIsChengFnRegistered(chengFnId: int32): bool =
    if chengFnId < 0 || chengFnId >= jsChengFnRegistered.len:
        return false
    return jsChengFnRegistered[chengFnId]

// Dispatch a Cheng native function by its registered chengFnId.
// The frame provides func, thisBinding, args, and locals.
// On success, outResult is set and returns true.
// On failure (unregistered id or no implementation), returns false.
fn jsDispatchChengFn(chengFnId: int32, frame: var JsCallFrame, outResult: var JsValue): bool =
    JsValueInitUndefined(outResult)

    if !jsIsChengFnRegistered(chengFnId):
        return false

    // --- Dispatch table (switch-case on chengFnId) ---
    // Add new Cheng native function implementations as cases below.
    // Each case extracts parameters from frame.args, calls the Cheng
    // implementation, sets outResult, and returns true.

    if chengFnId == 1:
        // Example Cheng native function: returns the argument count
        JsValueInitInt32(outResult, frame.args.len)
        return true

    elif chengFnId == 2:
        // Example Cheng native function: returns first argument or undefined
        if frame.args.len > 0:
            JsValueCopy(outResult, frame.args[0])
        return true

    // Registered but no dispatch case implemented yet.
    // Return false so the caller can set an appropriate exception.
    return false


fn jsGetCurrentException(out: var JsException): bool =
    if !jsExceptionPending:
        return false
    jsExceptionPending = false
    out = jsExceptionValue
    return true

fn jsSetCurrentException(value: var JsValue, kind: int32): void =
    jsExceptionPending = true
    JsExceptionInit(jsExceptionValue, kind, value)

fn jsClearCurrentException(): void =
    jsExceptionPending = false

fn jsExceptionIsPending(): bool =
    return jsExceptionPending

fn jsCurrentExceptionKind(): int32 =
    if !jsExceptionPending:
        return JsExceptionNone
    return jsExceptionValue.kind

fn jsPushCallFrame(frame: JsCallFrame): int32 =
    var idx: int32 = jsCallStackSize
    add(jsCallStack, frame)
    jsCallStackSize = jsCallStackSize + 1
    return idx

fn jsPopCallFrame(): bool =
    if jsCallStackSize <= 0:
        return false
    jsCallStackSize = jsCallStackSize - 1
    setLen(jsCallStack, jsCallStackSize)
    return true

fn jsGetCallFrame(index: int32, out: var JsCallFrame): bool =
    if index < 0 || index >= jsCallStackSize:
        return false
    out = jsCallStack[index]
    return true

# --- ArrayBuffer / TypedArray / DataView ---

fn JsArrayBufferCopy(out: var JsArrayBuffer, buffer: var JsArrayBuffer) =
    out.bufferId = buffer.bufferId
    out.data = buffer.data
    out.byteLength = buffer.byteLength

fn JsArrayBufferInit(out: var JsArrayBuffer, byteLength: int32): bool =
    if byteLength < 0: return false
    out.bufferId = jsArrayBufferCount + 1
    out.data = []
    out.byteLength = byteLength
    var i: int32
    while i < byteLength:
        add(out.data, 0)
        i = i + 1
    var stored: JsArrayBuffer
    JsArrayBufferCopy(stored, out)
    add(jsArrayBufferTable, stored)
    jsArrayBufferCount = jsArrayBufferCount + 1
    return true

fn JsArrayBufferGetByte(buf: var JsArrayBuffer, index: int32): int32 =
    if index < 0 || index >= buf.byteLength: return 0
    return JsArrayBufferGetByteById(buf.bufferId, index)

fn JsArrayBufferSetByte(buf: var JsArrayBuffer, index: int32, value: int32) =
    if index < 0 || index >= buf.byteLength: return
    JsArrayBufferSetByteById(buf.bufferId, index, value)

fn JsArrayBufferGetByteById(id: int32, index: int32): int32 =
    for i in 0..<jsArrayBufferCount:
        if jsArrayBufferTable[i].bufferId == id:
            if index < 0 || index >= jsArrayBufferTable[i].byteLength:
                return 0
            return jsArrayBufferTable[i].data[index]
    return 0

fn JsArrayBufferSetByteById(id: int32, index: int32, value: int32): bool =
    for i in 0..<jsArrayBufferCount:
        if jsArrayBufferTable[i].bufferId == id:
            if index < 0 || index >= jsArrayBufferTable[i].byteLength:
                return false
            var stored: JsArrayBuffer
            JsArrayBufferCopy(stored, jsArrayBufferTable[i])
            stored.data[index] = value & 0xFF
            jsArrayBufferTable[i] = stored
            return true
    return false

fn JsArrayBufferGetById(id: int32, out: var JsArrayBuffer): bool =
    for i in 0..<jsArrayBufferCount:
        if jsArrayBufferTable[i].bufferId == id:
            JsArrayBufferCopy(out, jsArrayBufferTable[i])
            return true
    return false

fn JsTypedArrayCopy(out: var JsTypedArray, array: var JsTypedArray) =
    out.arrayId = array.arrayId
    out.bufferId = array.bufferId
    out.byteOffset = array.byteOffset
    out.byteLength = array.byteLength
    out.length = array.length
    out.bytesPerElement = array.bytesPerElement

fn JsDataViewCopy(out: var JsDataView, view: var JsDataView) =
    out.viewId = view.viewId
    out.bufferId = view.bufferId
    out.byteOffset = view.byteOffset
    out.byteLength = view.byteLength

fn JsTypedArrayGetById(id: int32, out: var JsTypedArray): bool =
    for i in 0..<jsTypedArrayCount:
        if jsTypedArrayTable[i].arrayId == id:
            JsTypedArrayCopy(out, jsTypedArrayTable[i])
            return true
    return false

fn JsUint8ArrayFromBuffer(bufId: int32, byteOffset: int32, length: int32, out: var JsTypedArray): bool =
    var buf: JsArrayBuffer
    if !JsArrayBufferGetById(bufId, buf): return false
    if byteOffset < 0 || length < 0: return false
    if byteOffset > buf.byteLength: return false
    if length > buf.byteLength - byteOffset: return false
    out.arrayId = jsTypedArrayCount + 1
    out.bufferId = bufId
    out.byteOffset = byteOffset
    out.byteLength = length
    out.length = length
    out.bytesPerElement = 1
    var stored: JsTypedArray
    JsTypedArrayCopy(stored, out)
    add(jsTypedArrayTable, stored)
    jsTypedArrayCount = jsTypedArrayCount + 1
    return true

fn JsUint8ArrayNew(length: int32, out: var JsTypedArray): bool =
    var buf: JsArrayBuffer
    if !JsArrayBufferInit(buf, length): return false
    return JsUint8ArrayFromBuffer(buf.bufferId, 0, length, out)

fn JsTypedArrayGetUint8(arrId: int32, index: int32): int32 =
    for i in 0..<jsTypedArrayCount:
        if jsTypedArrayTable[i].arrayId == arrId:
            let ta = jsTypedArrayTable[i]
            if index < 0 || index >= ta.length: return 0
            return JsArrayBufferGetByteById(ta.bufferId, ta.byteOffset + index)
    return 0

fn JsTypedArraySetUint8(arrId: int32, index: int32, value: int32) =
    for i in 0..<jsTypedArrayCount:
        if jsTypedArrayTable[i].arrayId == arrId:
            let ta = jsTypedArrayTable[i]
            if index < 0 || index >= ta.length: return
            JsArrayBufferSetByteById(ta.bufferId, ta.byteOffset + index, value)
            return

fn JsUint8ArrayFromItems(items: int32[], result: var JsTypedArray): bool =
    if !JsUint8ArrayNew(items.len, result):
        return false
    var i: int32
    while i < items.len:
        JsTypedArraySetUint8(result.arrayId, i, items[i])
        i = i + 1
    return true

fn JsUint8ArrayCopy(source: var JsTypedArray, result: var JsTypedArray): bool =
    var canonical: JsTypedArray
    if !JsTypedArrayGetById(source.arrayId, canonical):
        return false
    if canonical.bytesPerElement != 1 || canonical.length < 0:
        return false
    if !JsUint8ArrayNew(canonical.length, result):
        return false
    var i: int32
    while i < canonical.length:
        JsTypedArraySetUint8(result.arrayId, i, JsTypedArrayGetUint8(canonical.arrayId, i))
        i = i + 1
    return true

fn JsUint8ArrayFrom(items: int32[]): JsTypedArray =
    var result: JsTypedArray
    JsUint8ArrayFromItems(items, result)
    return result

# TypedArray.subarray(begin, end): create a new view over the same buffer
fn JsTypedArraySubarray(arrId: int32, begin: int32, end: int32): int32 =
    for i in 0..<jsTypedArrayCount:
        if jsTypedArrayTable[i].arrayId == arrId:
            let ta = jsTypedArrayTable[i]
            var b: int32 = begin
            if b < 0: b = 0
            var e: int32 = end
            if e < 0 || e > ta.length: e = ta.length
            if b >= e:
                b = 0
                e = 0
            var out: JsTypedArray
            JsUint8ArrayFromBuffer(ta.bufferId, ta.byteOffset + b, e - b, out)
            return out.arrayId
    return 0

fn JsDataViewInit(bufId: int32, byteOffset: int32, byteLength: int32, out: var JsDataView): bool =
    var buf: JsArrayBuffer
    if !JsArrayBufferGetById(bufId, buf): return false
    if byteOffset < 0 || byteLength < 0: return false
    if byteOffset > buf.byteLength: return false
    if byteLength > buf.byteLength - byteOffset: return false
    out.viewId = jsDataViewCount + 1
    out.bufferId = bufId
    out.byteOffset = byteOffset
    out.byteLength = byteLength
    var stored: JsDataView
    JsDataViewCopy(stored, out)
    add(jsDataViewTable, stored)
    jsDataViewCount = jsDataViewCount + 1
    return true

fn JsDataViewSetInt32(viewId: int32, byteOffset: int32, value: int32, littleEndian: bool) =
    for i in 0..<jsDataViewCount:
        if jsDataViewTable[i].viewId == viewId:
            let dv = jsDataViewTable[i]
            if byteOffset < 0 || byteOffset > dv.byteLength: return
            if 4 > dv.byteLength - byteOffset: return
            let pos = dv.byteOffset + byteOffset
            if littleEndian:
                JsArrayBufferSetByteById(dv.bufferId, pos, value & 0xFF)
                JsArrayBufferSetByteById(dv.bufferId, pos + 1, (value / 256) & 0xFF)
                JsArrayBufferSetByteById(dv.bufferId, pos + 2, (value / 65536) & 0xFF)
                JsArrayBufferSetByteById(dv.bufferId, pos + 3, (value / 16777216) & 0xFF)
            else:
                JsArrayBufferSetByteById(dv.bufferId, pos + 3, value & 0xFF)
                JsArrayBufferSetByteById(dv.bufferId, pos + 2, (value / 256) & 0xFF)
                JsArrayBufferSetByteById(dv.bufferId, pos + 1, (value / 65536) & 0xFF)
                JsArrayBufferSetByteById(dv.bufferId, pos, (value / 16777216) & 0xFF)
    return

# DataView.getInt32(byteOffset, littleEndian): read signed 32-bit integer from buffer
fn JsDataViewGetInt32(viewId: int32, byteOffset: int32, littleEndian: bool): int32 =
    for i in 0..<jsDataViewCount:
        if jsDataViewTable[i].viewId == viewId:
            let dv = jsDataViewTable[i]
            if byteOffset < 0 || byteOffset > dv.byteLength: return 0
            if 4 > dv.byteLength - byteOffset: return 0
            let pos = dv.byteOffset + byteOffset
            var b0: int32 = JsArrayBufferGetByteById(dv.bufferId, pos)
            var b1: int32 = JsArrayBufferGetByteById(dv.bufferId, pos + 1)
            var b2: int32 = JsArrayBufferGetByteById(dv.bufferId, pos + 2)
            var b3: int32 = JsArrayBufferGetByteById(dv.bufferId, pos + 3)
            if littleEndian:
                return (b3 * 16777216) + (b2 * 65536) + (b1 * 256) + b0
            else:
                return (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
    return 0

# DataView.setUint32(byteOffset, value, littleEndian)
fn JsDataViewSetUint32(viewId: int32, byteOffset: int32, value: int32, littleEndian: bool) =
    # Same as setInt32 but value is always treated as unsigned
    # For Cheng int32, the bit pattern is the same for signed/unsigned
    JsDataViewSetInt32(viewId, byteOffset, value, littleEndian)

# DataView.getUint32(byteOffset, littleEndian)
fn JsDataViewGetUint32(viewId: int32, byteOffset: int32, littleEndian: bool): int32 =
    # Same bit pattern as getInt32
    return JsDataViewGetInt32(viewId, byteOffset, littleEndian)

# --- URI encoding/decoding (RFC 3986) ---

fn jsHexDigitValue(d: int32): int32 =
    if d >= 65 && d <= 70:
        return d - 55
    if d >= 97 && d <= 102:
        return d - 87
    if d >= 48 && d <= 57:
        return d - 48
    return -1

# encodeURIComponent: RFC 3986 percent-encoding
# Safe (unencoded) characters: A-Z a-z 0-9 - _ . ! ~ * ' ( )
fn JsEncodeURIComponent(s: str): str =
    var result: str
    let n: int32 = strings.Len(s)
    var i: int32
    while i < n:
        let c: char = s[i]
        let code: int32 = Int32(c)
        if (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) ||
           c == '-' || c == '_' || c == '.' || c == '!' || c == '~' || c == '*' || c == '\'' || c == '(' || c == ')':
            result = Fmt"{result}{c}"
        else:
            let hi: int32 = code / 16
            let lo: int32 = code % 16
            let hiChar: char = (hi < 10) ? char(48 + hi) : char(55 + hi)
            let loChar: char = (lo < 10) ? char(48 + lo) : char(55 + lo)
            result = Fmt"{result}%{hiChar}{loChar}"
        i = i + 1
    return result

# decodeURIComponent: decode %XX hex sequences back to characters
fn JsDecodeURIComponent(s: str): str =
    var result: str
    let n: int32 = strings.Len(s)
    var i: int32
    while i < n:
        let c: char = s[i]
        if c == '%' && i + 2 < n:
            let hi: int32 = Int32(s[i+1])
            let lo: int32 = Int32(s[i+2])
            let hiVal: int32 = jsHexDigitValue(hi)
            let loVal: int32 = jsHexDigitValue(lo)
            if hiVal >= 0 && loVal >= 0:
                let decoded: char = char(hiVal * 16 + loVal)
                result = Fmt"{result}{decoded}"
                i = i + 3
                continue
        result = Fmt"{result}{c}"
        i = i + 1
    return result

# --- JSON.stringify, Map, Set (production) ---

fn jsJsonEscapeString(s: str): str =
    var result: str = "\""
    var i: int32
    let n: int32 = strings.Len(s)
    while i < n:
        let c: char = s[i]
        if c == '"':
            result = jsStrConcat(result, "\\\"")
        elif c == '\\':
            result = jsStrConcat(result, "\\\\")
        elif c == '\n':
            result = jsStrConcat(result, "\\n")
        elif c == '\t':
            result = jsStrConcat(result, "\\t")
        elif c == '\r':
            result = jsStrConcat(result, "\\r")
        else:
            var cStr: str = strings.SliceBytes(s, i, 1)
            result = jsStrConcat(result, cStr)
        i = i + 1
    result = jsStrConcat(result, "\"")
    return result

fn jsFloat64ToStr(f: float64): str =
    # Detect NaN and Infinity: f * 0.0 gives NaN for both, NaN != 0.0
    if f * float64(0.0) != float64(0.0):
        return "null"

    var isNeg: bool
    var val: float64 = f
    if val < float64(0.0):
        isNeg = true
        val = -val

    if val == float64(0.0):
        return "0"

    var result: str
    var remainder: float64 = val

    # --- Integer part ---
    if remainder >= float64(1.0):
        var pow10: float64 = float64(1.0)
        while pow10 * float64(10.0) <= remainder:
            pow10 = pow10 * float64(10.0)
        while pow10 >= float64(1.0):
            var digit: int32 = int(remainder / pow10 + float64(0.0000001))
            if digit > 9: digit = 9
            if digit < 0: digit = 0
            result = jsStrConcat(result, strings.IntToStr(digit))
            remainder = remainder - float64(digit) * pow10
            if remainder < float64(0.0):
                remainder = float64(0.0)
            pow10 = pow10 / float64(10.0)
    else:
        result = "0"

    # --- Fractional part ---
    if remainder > float64(0.0):
        result = jsStrConcat(result, ".")
        var maxFrac: int32 = 15
        var fracCount: int32
        while fracCount < maxFrac && remainder > float64(0.0):
            remainder = remainder * float64(10.0)
            var digit: int32 = int(remainder + float64(0.0000001))
            if digit > 9: digit = 9
            if digit < 0: digit = 0
            result = jsStrConcat(result, strings.IntToStr(digit))
            remainder = remainder - float64(digit)
            if remainder < float64(0.0):
                remainder = float64(0.0)
            fracCount = fracCount + 1

    if isNeg:
        result = jsStrConcat("-", result)
    return result

fn JsJSONStringify(value: var JsValue, out: var str): bool =
    var visited: int32[]
    return JsJSONStringifyImpl(value, out, 0, visited)

fn JsJSONStringifyImpl(value: var JsValue, out: var str, depth: int32, visited: var int32[]): bool =
    if depth > 32:
        return false

    # Arrays (arrayId > 0)
    if value.arrayId > 0:
        var arr: JsArray
        if !JsArrayLoadById(value.arrayId, arr):
            return false
        var result = "["
        var hasJsValues = false
        if arr.valuesJs.len > 0:
            hasJsValues = true
        var arrLen: int32
        if hasJsValues:
            arrLen = arr.valuesJs.len
        else:
            arrLen = arr.values.len
        var j: int32
        while j < arrLen:
            if j > 0:
                result = Fmt"{result},"
            var item: JsValue
            if hasJsValues:
                if j < arr.valuesJs.len:
                    JsValueCopy(item, arr.valuesJs[j])
                else:
                    JsValueInitUndefined(item)
            else:
                if j < arr.values.len:
                    JsValueInitInt32(item, arr.values[j])
                else:
                    JsValueInitUndefined(item)
            if item.kind == JsKindUndefined || item.kind == JsKindNull || item.kind == JsKindFunction || item.kind == JsKindSymbol || item.kind == JsKindBigInt:
                result = Fmt"{result}null"
            else:
                var itemStr: str
                if !JsJSONStringifyImpl(item, itemStr, depth + 1, visited):
                    return false
                result = Fmt"{result}{itemStr}"
            j = j + 1
        result = Fmt"{result}]"
        out = result
        return true

    # Top-level undefined / function / symbol are not serializable as JSON
    if value.kind == JsKindUndefined || value.kind == JsKindFunction || value.kind == JsKindSymbol:
        return false

    if value.kind == JsKindNull:
        out = "null"
        return true

    if value.kind == JsKindBool:
        out = JsStringFromBool(value.boolValue)
        return true

    if value.kind == JsKindInt32:
        out = strings.IntToStr(value.int32Value)
        return true

    if value.kind == JsKindFloat64:
        out = jsFloat64ToStr(value.float64Value)
        return true

    if value.kind == JsKindString:
        out = jsJsonEscapeString(value.stringValue)
        return true

    if value.kind == JsKindBigInt:
        out = "0"
        return true

    # Object (non-array)
    if value.kind == JsKindObject:
        # Cycle detection
        for i in 0..<visited.len:
            if visited[i] == value.objectId:
                return false
        add(visited, value.objectId)

        var objIndex = JsObjectFindTableIndex(value.objectId)
        if objIndex < 0:
            return false

        var result = "{"
        var first: bool = true
        let propLen = jsObjectTable[objIndex].properties.len
        for i in 0..<propLen:
            if jsObjectTable[objIndex].properties[i].enumerable:
                var propVal: JsValue
                JsObjectCopyPropertyValue(propVal, jsObjectTable[objIndex].properties[i])
                # Skip undefined, function, symbol in object context
                if propVal.kind == JsKindUndefined || propVal.kind == JsKindFunction || propVal.kind == JsKindSymbol:
                    continue
                if !first:
                    result = Fmt"{result},"
                first = false
                result = Fmt"{result}{jsJsonEscapeString(jsObjectTable[objIndex].properties[i].name)}:"
                var valStr: str
                if !JsJSONStringifyImpl(propVal, valStr, depth + 1, visited):
                    return false
                result = Fmt"{result}{valStr}"
        result = jsStrConcat(result, "}")
        setLen(visited, visited.len - 1)
        out = result
        return true

    out = "null"
    return true

# ──────────────────────────────────────
# JSON.parse implementation
# ──────────────────────────────────────

fn JsJSONSkipWhitespace(json: str, pos: var int32) =
    let n: int32 = strings.Len(json)
    while pos < n && (json[pos] == ' ' || json[pos] == '\t' || json[pos] == '\n' || json[pos] == '\r'):
        pos = pos + 1

fn JsJSONParseNull(json: str, pos: var int32, out: var JsValue): bool =
    if pos + 3 >= strings.Len(json):
        return false
    if json[pos] == 'n' && json[pos + 1] == 'u' && json[pos + 2] == 'l' && json[pos + 3] == 'l':
        pos = pos + 4
        JsValueInitNull(out)
        return true
    return false

fn JsJSONParseTrue(json: str, pos: var int32, out: var JsValue): bool =
    if pos + 3 >= strings.Len(json):
        return false
    if json[pos] == 't' && json[pos + 1] == 'r' && json[pos + 2] == 'u' && json[pos + 3] == 'e':
        pos = pos + 4
        JsValueInitBool(out, true)
        return true
    return false

fn JsJSONParseFalse(json: str, pos: var int32, out: var JsValue): bool =
    if pos + 4 >= strings.Len(json):
        return false
    if json[pos] == 'f' && json[pos + 1] == 'a' && json[pos + 2] == 'l' && json[pos + 3] == 's' && json[pos + 4] == 'e':
        pos = pos + 5
        JsValueInitBool(out, false)
        return true
    return false

fn JsJSONParseString(json: str, pos: var int32, out: var JsValue): bool =
    let n: int32 = strings.Len(json)
    if pos >= n || json[pos] != '"':
        return false
    pos = pos + 1
    var result = ""
    while pos < n:
        let c = json[pos]
        if c == '"':
            pos = pos + 1
            JsValueInitString(out, result)
            return true
        if c == '\\':
            pos = pos + 1
            if pos >= n:
                return false
            let esc = json[pos]
            if esc == '"':
                result = Fmt"{result}{char(34)}"
            elif esc == '\\':
                result = Fmt"{result}{char(92)}"
            elif esc == '/':
                result = Fmt"{result}/"
            elif esc == 'b':
                result = Fmt"{result}{char(8)}"
            elif esc == 'f':
                result = Fmt"{result}{char(12)}"
            elif esc == 'n':
                result = Fmt"{result}{char(10)}"
            elif esc == 'r':
                result = Fmt"{result}{char(13)}"
            elif esc == 't':
                result = Fmt"{result}{char(9)}"
            elif esc == 'u':
                if pos + 4 >= n:
                    return false
                var code: int32
                for ui in 0..<4:
                    let d = json[pos + 1 + ui]
                    if d >= '0' && d <= '9':
                        code = code * 16 + (Int32(d) - 48)
                    elif d >= 'a' && d <= 'f':
                        code = code * 16 + (Int32(d) - 87)
                    elif d >= 'A' && d <= 'F':
                        code = code * 16 + (Int32(d) - 55)
                    else:
                        return false
                result = Fmt"{result}{char(code)}"
                pos = pos + 4
            else:
                return false
            pos = pos + 1
        else:
            result = Fmt"{result}{c}"
            pos = pos + 1
    return false

fn JsJSONParseNumber(json: str, pos: var int32, out: var JsValue): bool =
    let n: int32 = strings.Len(json)
    let start = pos
    var isFloat = false

    if pos >= n:
        return false
    if json[pos] == '-' || json[pos] == '+':
        pos = pos + 1
    if pos >= n || json[pos] < '0' || json[pos] > '9':
        pos = start
        return false

    while pos < n && json[pos] >= '0' && json[pos] <= '9':
        pos = pos + 1

    if pos < n && json[pos] == '.':
        isFloat = true
        pos = pos + 1
        if pos >= n || json[pos] < '0' || json[pos] > '9':
            pos = start
            return false
        while pos < n && json[pos] >= '0' && json[pos] <= '9':
            pos = pos + 1

    if pos < n && (json[pos] == 'e' || json[pos] == 'E'):
        isFloat = true
        pos = pos + 1
        if pos < n && (json[pos] == '-' || json[pos] == '+'):
            pos = pos + 1
        if pos >= n || json[pos] < '0' || json[pos] > '9':
            pos = start
            return false
        while pos < n && json[pos] >= '0' && json[pos] <= '9':
            pos = pos + 1

    let end = pos
    pos = start

    if !isFloat:
        var sign: int32 = 1
        if json[pos] == '-':
            sign = -1
            pos = pos + 1
        elif json[pos] == '+':
            pos = pos + 1
        var val: int32
        while pos < end:
            val = val * 10 + (Int32(json[pos]) - 48)
            pos = pos + 1
        JsValueInitInt32(out, val * sign)
        return true

    var signF: float64 = float64(1.0)
    if json[pos] == '-':
        signF = float64(-1.0)
        pos = pos + 1
    elif json[pos] == '+':
        pos = pos + 1

    var intPart: float64 = float64(0.0)
    while pos < end && json[pos] >= '0' && json[pos] <= '9':
        intPart = intPart * float64(10.0) + float64(Int32(json[pos]) - 48)
        pos = pos + 1

    var fracPart: float64 = float64(0.0)
    var fracDiv: float64 = float64(1.0)
    if pos < end && json[pos] == '.':
        pos = pos + 1
        while pos < end && json[pos] >= '0' && json[pos] <= '9':
            fracPart = fracPart * float64(10.0) + float64(Int32(json[pos]) - 48)
            fracDiv = fracDiv * float64(10.0)
            pos = pos + 1

    var result = (intPart + fracPart / fracDiv) * signF

    if pos < end && (json[pos] == 'e' || json[pos] == 'E'):
        pos = pos + 1
        var expSign: float64 = float64(1.0)
        if pos < end && json[pos] == '-':
            expSign = float64(-1.0)
            pos = pos + 1
        elif pos < end && json[pos] == '+':
            pos = pos + 1
        var expVal: int32
        while pos < end && json[pos] >= '0' && json[pos] <= '9':
            expVal = expVal * 10 + (Int32(json[pos]) - 48)
            pos = pos + 1
        var expFactor: float64 = float64(1.0)
        var expI: int32
        while expI < expVal:
            expFactor = expFactor * float64(10.0)
            expI = expI + 1
        if expSign < float64(0.0):
            result = result / expFactor
        else:
            result = result * expFactor

    JsValueInitFloat64(out, result)
    return true

fn JsJSONParseArray(json: str, pos: var int32, out: var JsValue, depth: int32): bool =
    let n: int32 = strings.Len(json)
    if pos >= n || json[pos] != '[':
        return false
    pos = pos + 1
    JsJSONSkipWhitespace(json, pos)
    var arr: JsArray
    JsArrayInit(arr, 8)
    if pos < n && json[pos] == ']':
        pos = pos + 1
        let arrId = jsRegisterArray(arr)
        JsValueInitArray(out, arrId)
        return true
    var first: bool = true
    while pos < n:
        if !first:
            if json[pos] != ',':
                return false
            pos = pos + 1
            JsJSONSkipWhitespace(json, pos)
        first = false
        JsJSONSkipWhitespace(json, pos)
        var element: JsValue
        if !JsJSONParseValue(json, pos, element, depth + 1):
            return false
        jsArrayAddJsValue(arr, element)
        JsJSONSkipWhitespace(json, pos)
        if pos < n && json[pos] == ']':
            pos = pos + 1
            let arrId = jsRegisterArray(arr)
            JsValueInitArray(out, arrId)
            return true
    return false

fn JsJSONParseObject(json: str, pos: var int32, out: var JsValue, depth: int32): bool =
    let n: int32 = strings.Len(json)
    if pos >= n || json[pos] != '{':
        return false
    pos = pos + 1
    JsJSONSkipWhitespace(json, pos)
    var obj: JsObject
    if !JsObjectCreateFresh(obj, 0):
        return false
    let objId = obj.objectId
    if pos < n && json[pos] == '}':
        pos = pos + 1
        JsValueInitObject(out, objId)
        return true
    var descriptor: JsPropertyDescriptor
    JsDescriptorInitData(descriptor, true, true, true)
    var first: bool = true
    while pos < n:
        if !first:
            if json[pos] != ',':
                return false
            pos = pos + 1
            JsJSONSkipWhitespace(json, pos)
        first = false
        JsJSONSkipWhitespace(json, pos)
        var keyVal: JsValue
        if !JsJSONParseString(json, pos, keyVal):
            return false
        JsJSONSkipWhitespace(json, pos)
        if pos >= n || json[pos] != ':':
            return false
        pos = pos + 1
        JsJSONSkipWhitespace(json, pos)
        var valueVal: JsValue
        if !JsJSONParseValue(json, pos, valueVal, depth + 1):
            return false
        if !JsObjectDefineDataPropertyById(objId, JsValueString(keyVal), valueVal, descriptor):
            return false
        JsJSONSkipWhitespace(json, pos)
        if pos < n && json[pos] == '}':
            pos = pos + 1
            JsValueInitObject(out, objId)
            return true
    return false

fn JsJSONParseValue(json: str, pos: var int32, out: var JsValue, depth: int32): bool =
    if depth > 32:
        return false
    JsJSONSkipWhitespace(json, pos)
    let n: int32 = strings.Len(json)
    if pos >= n:
        return false
    let c = json[pos]
    if c == 'n':
        return JsJSONParseNull(json, pos, out)
    if c == 't':
        return JsJSONParseTrue(json, pos, out)
    if c == 'f':
        return JsJSONParseFalse(json, pos, out)
    if c == '"':
        return JsJSONParseString(json, pos, out)
    if c == '-' || c == '+' || (c >= '0' && c <= '9'):
        return JsJSONParseNumber(json, pos, out)
    if c == '[':
        return JsJSONParseArray(json, pos, out, depth)
    if c == '{':
        return JsJSONParseObject(json, pos, out, depth)
    return false

fn JsJSONParse(json: str, out: var JsValue): bool =
    var pos: int32
    JsValueInitUndefined(out)
    JsJSONSkipWhitespace(json, pos)
    if !JsJSONParseValue(json, pos, out, 0):
        JsValueInitUndefined(out)
        return false
    JsJSONSkipWhitespace(json, pos)
    if pos != strings.Len(json):
        JsValueInitUndefined(out)
        return false
    return true

fn JsMapInit(out: var JsValue) =
    var obj: JsObject
    let objId: int32 = jsObjectCount + 1
    JsObjectInit(obj, objId, 0)
    add(jsObjectTable, obj)
    jsObjectCount = jsObjectCount + 1
    JsValueInitObject(out, objId)

fn JsMapSet(map: var JsValue, key: str, value: var JsValue): bool =
    if map.kind != JsKindObject:
        return false
    var objIndex: int32 = -1
    for i in 0..<jsObjectCount:
        if jsObjectTable[i].objectId == map.objectId:
            objIndex = i
            break
    if objIndex < 0:
        return false
    var desc: JsPropertyDescriptor
    JsDescriptorInitData(desc, true, true, true)
    var obj: JsObject
    obj = jsObjectTable[objIndex]
    if !JsObjectDefineDataProperty(obj, key, value, desc):
        return false
    jsObjectTable[objIndex] = obj
    return true

fn JsMapGet(map: var JsValue, key: str, out: var JsValue): bool =
    if map.kind == JsKindObject:
        var objIndex: int32 = -1
        for i in 0..<jsObjectCount:
            if jsObjectTable[i].objectId == map.objectId:
                objIndex = i
                break
        if objIndex >= 0:
            return JsObjectGetOwnProperty(jsObjectTable[objIndex], key, out)
    JsValueInitUndefined(out)
    return false

fn JsMapFromStringInt32Entries(keys: str[], values: int32[], out: var JsValue): bool =
    if keys.len != values.len:
        JsValueInitUndefined(out)
        return false
    JsMapInit(out)
    for i in 0..<keys.len:
        var value: JsValue
        JsValueInitInt32(value, values[i])
        if !JsMapSet(out, keys[i], value):
            JsValueInitUndefined(out)
            return false
    return true

fn JsMapKeys(map: var JsValue): JsArray =
    var keys: JsArray
    if !JsObjectKeys(map, keys):
        JsArrayInit(keys, 0)
    return keys

fn JsMapValues(map: var JsValue): JsArray =
    var values: JsArray
    if !JsObjectValues(map, values):
        JsArrayInit(values, 0)
    return values

fn JsSetInit(out: var JsValue) =
    var obj: JsObject
    let objId: int32 = jsObjectCount + 1
    JsObjectInit(obj, objId, 0)
    add(jsObjectTable, obj)
    jsObjectCount = jsObjectCount + 1
    JsValueInitObject(out, objId)
    out.stringValue = ""

fn JsSetAdd(set: var JsValue, key: str) =
    if set.kind != JsKindObject:
        return
    if JsSetHas(set, key):
        return
    set.stringValue = jsStrConcat(set.stringValue, strings.IntToStr(JsStringLength(key)))
    set.stringValue = jsStrConcat(set.stringValue, ":")
    set.stringValue = jsStrConcat(set.stringValue, key)
    set.stringValue = jsStrConcat(set.stringValue, ";")

fn JsSetHas(set: var JsValue, key: str): bool =
    if set.kind != JsKindObject:
        return false
    let encodedLen: int32 = JsStringLength(set.stringValue)
    let keyLen: int32 = JsStringLength(key)
    var pos: int32
    while pos < encodedLen:
        var itemLen: int32
        while pos < encodedLen && set.stringValue[pos] != ':':
            let digit: int32 = Int32(set.stringValue[pos]) - Int32('0')
            if digit < 0 || digit > 9:
                return false
            itemLen = itemLen * 10 + digit
            pos = pos + 1
        if pos >= encodedLen:
            return false
        pos = pos + 1
        if pos + itemLen > encodedLen:
            return false
        if itemLen == keyLen && strings.SliceBytes(set.stringValue, pos, itemLen) == key:
            return true
        pos = pos + itemLen
        if pos < encodedLen && set.stringValue[pos] == ';':
            pos = pos + 1
    return false

fn JsSetFromStringArray(items: str[], out: var JsValue) =
    JsSetInit(out)
    for i in 0..<items.len:
        JsSetAdd(out, items[i])

fn JsArrayFromStringSet(set: var JsValue, out: var JsArray): bool =
    if set.kind != JsKindObject:
        return false
    let encodedLen: int32 = JsStringLength(set.stringValue)
    var count: int32
    var pos: int32
    while pos < encodedLen:
        var itemLen: int32
        while pos < encodedLen && set.stringValue[pos] != ':':
            let digit: int32 = Int32(set.stringValue[pos]) - Int32('0')
            if digit < 0 || digit > 9:
                return false
            itemLen = itemLen * 10 + digit
            pos = pos + 1
        if pos >= encodedLen:
            return false
        pos = pos + 1
        if pos + itemLen > encodedLen:
            return false
        pos = pos + itemLen
        if pos < encodedLen && set.stringValue[pos] == ';':
            pos = pos + 1
        count = count + 1
    if !JsArrayInit(out, count):
        return false
    pos = 0
    while pos < encodedLen:
        var itemLen: int32
        while pos < encodedLen && set.stringValue[pos] != ':':
            let digit: int32 = Int32(set.stringValue[pos]) - Int32('0')
            if digit < 0 || digit > 9:
                return false
            itemLen = itemLen * 10 + digit
            pos = pos + 1
        if pos >= encodedLen:
            return false
        pos = pos + 1
        if pos + itemLen > encodedLen:
            return false
        var item: JsValue
        JsValueInitString(item, strings.SliceBytes(set.stringValue, pos, itemLen))
        if !JsArrayPushJsValue(out, item):
            return false
        pos = pos + itemLen
        if pos < encodedLen && set.stringValue[pos] == ';':
            pos = pos + 1
    return true

fn JsSetValues(set: var JsValue): JsArray =
    var values: JsArray
    if !JsArrayFromStringSet(set, values):
        JsArrayInit(values, 0)
    return values

#
# --- Boolean constructor ---
#

fn JsValueIsTruthy(value: var JsValue): bool =
    if JsValueIsUndefined(value):
        return false
    if JsValueIsNull(value):
        return false
    if JsValueIsBool(value):
        return value.boolValue
    if JsValueIsInt32(value):
        return value.int32Value != 0
    if JsValueIsFloat64(value):
        return value.float64Value != float64(0.0)
    if JsValueIsString(value):
        return JsStringLength(value.stringValue) > 0
    return true

fn JsBooleanConstructor(value: var JsValue): JsValue =
    var result: JsValue
    if JsValueIsTruthy(value):
        JsValueInitBool(result, true)
    else:
        JsValueInitBool(result, false)
    return result

#
# --- Date constructor ---
#

fn JsDateConstructor(): int64 =
    return cheng_epoch_time_ms()

fn JsDateConstructorFromMs(ms: int64): int64 =
    return ms

#
# --- ForOf iterator ---
#

var jsForOfIterableKind: int32 = -1
var jsForOfIterableId: int32
var jsForOfIterableStr: str
var jsForOfIndex: int32
var jsForOfLength: int32

fn JsForOfIterate(iterable: var JsValue, outElement: var JsValue, outDone: var bool): bool =
    JsValueInitUndefined(outElement)
    outDone = true

    if iterable.arrayId > 0:
        var arr: JsArray
        if !JsArrayLoadById(iterable.arrayId, arr):
            return false
        let arrLen: int32 = JsArrayLength(arr)
        if jsForOfIterableKind != 0 || jsForOfIterableId != iterable.arrayId:
            jsForOfIterableKind = 0
            jsForOfIterableId = iterable.arrayId
            jsForOfIterableStr = ""
            jsForOfIndex = 0
            jsForOfLength = arrLen
        if jsForOfIndex >= jsForOfLength:
            outDone = true
            return true
        if !JsArrayGetJsValue(arr, jsForOfIndex, outElement):
            return false
        jsForOfIndex = jsForOfIndex + 1
        outDone = false
        return true

    if JsValueIsString(iterable):
        let s: str = iterable.stringValue
        let sLen: int32 = JsStringLength(s)
        if jsForOfIterableKind != 1 || jsForOfIterableStr != s:
            jsForOfIterableKind = 1
            jsForOfIterableId = 0
            jsForOfIterableStr = s
            jsForOfIndex = 0
            jsForOfLength = sLen
        if jsForOfIndex >= jsForOfLength:
            outDone = true
            return true
        JsValueInitString(outElement, strings.SliceBytes(s, jsForOfIndex, 1))
        jsForOfIndex = jsForOfIndex + 1
        outDone = false
        return true

    outDone = true
    return false

#
# --- Timer (setTimeout / clearTimeout / setInterval / clearInterval) ---
#

type
    JsTimer =
        timerId: int32
        callbackFnId: int32
        delayMs: int32
        isInterval: bool
        remainingMs: int32

var jsTimerTable: JsTimer[]
var jsTimerCount: int32
var jsNextTimerId: int32 = 1

fn JsSetTimeout(callbackFnId: int32, delayMs: int32): int32 =
    let timerId: int32 = jsNextTimerId
    jsNextTimerId = jsNextTimerId + 1
    var timer: JsTimer
    timer.timerId = timerId
    timer.callbackFnId = callbackFnId
    timer.delayMs = delayMs
    timer.isInterval = false
    timer.remainingMs = delayMs
    add(jsTimerTable, timer)
    jsTimerCount = jsTimerCount + 1
    return timerId

fn JsClearTimeout(timerId: int32): bool =
    for i in 0..<jsTimerCount:
        if jsTimerTable[i].timerId == timerId:
            var j: int32 = i
            while j < jsTimerCount - 1:
                jsTimerTable[j] = jsTimerTable[j + 1]
                j = j + 1
            setLen(jsTimerTable, jsTimerCount - 1)
            jsTimerCount = jsTimerCount - 1
            return true
    return false

fn JsSetInterval(callbackFnId: int32, delayMs: int32): int32 =
    let timerId: int32 = jsNextTimerId
    jsNextTimerId = jsNextTimerId + 1
    var timer: JsTimer
    timer.timerId = timerId
    timer.callbackFnId = callbackFnId
    timer.delayMs = delayMs
    timer.isInterval = true
    timer.remainingMs = delayMs
    add(jsTimerTable, timer)
    jsTimerCount = jsTimerCount + 1
    return timerId

fn JsClearInterval(timerId: int32): bool =
    return JsClearTimeout(timerId)

fn JsFlushTimers(): void =
    var i: int32
    while i < jsTimerCount:
        let fnId: int32 = jsTimerTable[i].callbackFnId
        let isInterval: bool = jsTimerTable[i].isInterval
        var func: JsFunction
        if JsFunctionLoadById(fnId, func):
            var thisVal: JsValue
            JsValueInitUndefined(thisVal)
            var result: JsValue
            jsCallFunction(func, thisVal, [], result)
        if isInterval:
            jsTimerTable[i].remainingMs = jsTimerTable[i].delayMs
            i = i + 1
        else:
            var j: int32 = i
            while j < jsTimerCount - 1:
                jsTimerTable[j] = jsTimerTable[j + 1]
                j = j + 1
            setLen(jsTimerTable, jsTimerCount - 1)
            jsTimerCount = jsTimerCount - 1

#
# --- crypto.getRandomValues (LCG-based PRNG) ---
#

fn JsCryptoGetRandomValues(length: int32): int32[] =
    var result: int32[]
    var seed: int32 = 12345
    var i: int32
    while i < length:
        seed = seed * 1103515245 + 12345
        seed = seed & 0x7fffffff
        add(result, seed & 0xFF)
        i = i + 1
    return result

#
# ──────────────────────────────────────
# JsRegExp (simple substring-based regexp)
# ──────────────────────────────────────
#

fn JsRegExpCreate(pattern: str, flags: str, out: var JsRegExp): bool =
    out.pattern = pattern
    out.flags = flags
    out.global = false
    out.ignoreCase = false
    out.multiline = false
    out.dotAll = false
    out.lastIndex = 0
    let n: int32 = JsStringLength(flags)
    for i in 0..<n:
        let c: char = flags[i]
        if c == 'g':
            out.global = true
        elif c == 'i':
            out.ignoreCase = true
        elif c == 'm':
            out.multiline = true
        elif c == 's':
            out.dotAll = true
        else:
            return false
    return true

fn JsRegExpTestRe(re: var JsRegExp, text: str): bool =
    var searchPattern: str = re.pattern
    var searchText: str = text
    if re.ignoreCase:
        searchPattern = JsStringToLowerCase(re.pattern)
        searchText = JsStringToLowerCase(text)
    var found: int32
    if re.global:
        found = JsStringIndexOfFrom(searchText, searchPattern, re.lastIndex)
    else:
        found = JsStringIndexOf(searchText, searchPattern)
    if found >= 0:
        let patternLen: int32 = JsStringLength(searchPattern)
        re.lastIndex = found + patternLen
        return true
    re.lastIndex = 0
    return false

fn JsRegExpExec(re: var JsRegExp, text: str, out: var JsArray): bool =
    JsArrayInit(out, 1)
    var searchPattern: str = re.pattern
    var searchText: str = text
    if re.ignoreCase:
        searchPattern = JsStringToLowerCase(re.pattern)
        searchText = JsStringToLowerCase(text)
    var found: int32
    if re.global:
        found = JsStringIndexOfFrom(searchText, searchPattern, re.lastIndex)
    else:
        found = JsStringIndexOf(searchText, searchPattern)
    if found >= 0:
        let patternLen: int32 = JsStringLength(searchPattern)
        re.lastIndex = found + patternLen
        var matchVal: JsValue
        JsValueInitString(matchVal, strings.SliceBytes(searchText, found, patternLen))
        jsArrayAddJsValue(out, matchVal)
        return true
    re.lastIndex = 0
    return true

fn JsRegExpToString(re: var JsRegExp, out: var str): bool =
    let slashPattern: str = jsStrConcat("/", re.pattern)
    let slashFlags: str = jsStrConcat("/", re.flags)
    out = jsStrConcat(slashPattern, slashFlags)
    return true

#
# ──────────────────────────────────────
# JsMap (proper implementation with JsValue keys)
# ──────────────────────────────────────
#

fn JsMapCreate(out: var JsValue): bool =
    let objId: int32 = JsObjectFreshId()
    var obj: JsObject
    JsObjectInit(obj, objId, 0)
    add(jsObjectTable, obj)
    jsObjectCount = jsObjectCount + 1
    var map: JsMap
    map.mapId = objId
    map.entries = []
    add(jsMapTable, map)
    jsMapCount = jsMapCount + 1
    JsValueInitObject(out, objId)
    return true

fn JsMapGetByObjectId(objectId: int32, out: var JsMap): bool =
    for i in 0..<jsMapCount:
        if jsMapTable[i].mapId == objectId:
            out = jsMapTable[i]
            return true
    return false

fn JsMapSetObj(map: var JsMap, key: var JsValue, value: var JsValue): bool =
    let n: int32 = map.entries.len
    for i in 0..<n:
        if JsValueEquals(map.entries[i].key, key):
            JsValueCopy(map.entries[i].value, value)
            return true
    var entry: JsMapEntry
    JsValueCopy(entry.key, key)
    JsValueCopy(entry.value, value)
    add(map.entries, entry)
    return true

fn JsMapGetObj(map: var JsMap, key: var JsValue, out: var JsValue): bool =
    let n: int32 = map.entries.len
    for i in 0..<n:
        if JsValueEquals(map.entries[i].key, key):
            JsValueCopy(out, map.entries[i].value)
            return true
    JsValueInitUndefined(out)
    return false

fn JsMapDelete(map: var JsMap, key: var JsValue): bool =
    let n: int32 = map.entries.len
    for i in 0..<n:
        if JsValueEquals(map.entries[i].key, key):
            var j: int32 = i
            while j < n - 1:
                JsValueCopy(map.entries[j].key, map.entries[j + 1].key)
                JsValueCopy(map.entries[j].value, map.entries[j + 1].value)
                j = j + 1
            setLen(map.entries, n - 1)
            return true
    return false

fn JsMapHas(map: var JsMap, key: var JsValue): bool =
    let n: int32 = map.entries.len
    for i in 0..<n:
        if JsValueEquals(map.entries[i].key, key):
            return true
    return false

fn JsMapClear(map: var JsMap) =
    setLen(map.entries, 0)

fn JsMapSize(map: var JsMap): int32 =
    return map.entries.len

fn JsMapForEach(map: var JsMap, callbackFnId: int32): bool =
    let n: int32 = map.entries.len
    for i in 0..<n:
        var args: JsValue[]
        var valueArg: JsValue
        JsValueCopy(valueArg, map.entries[i].value)
        add(args, valueArg)
        var keyArg: JsValue
        JsValueCopy(keyArg, map.entries[i].key)
        add(args, keyArg)
        var mapArg: JsValue
        JsValueInitObject(mapArg, map.mapId)
        add(args, mapArg)
        var frame: JsCallFrame
        frame.args = args
        var result: JsValue
        if !jsDispatchChengFn(callbackFnId, frame, result):
            return false
    return true

fn JsMapKeysObj(map: var JsMap, out: var JsArray): bool =
    let n: int32 = map.entries.len
    JsArrayInit(out, n)
    for i in 0..<n:
        var keyVal: JsValue
        JsValueCopy(keyVal, map.entries[i].key)
        jsArrayAddJsValue(out, keyVal)
    return true

fn JsMapValuesObj(map: var JsMap, out: var JsArray): bool =
    let n: int32 = map.entries.len
    JsArrayInit(out, n)
    for i in 0..<n:
        var valueVal: JsValue
        JsValueCopy(valueVal, map.entries[i].value)
        jsArrayAddJsValue(out, valueVal)
    return true

fn JsMapEntries(map: var JsMap, out: var JsArray): bool =
    let n: int32 = map.entries.len
    JsArrayInit(out, n)
    for i in 0..<n:
        var pairArr: JsArray
        JsArrayInit(pairArr, 2)
        var keyVal: JsValue
        JsValueCopy(keyVal, map.entries[i].key)
        jsArrayAddJsValue(pairArr, keyVal)
        var valueVal: JsValue
        JsValueCopy(valueVal, map.entries[i].value)
        jsArrayAddJsValue(pairArr, valueVal)
        let pairId: int32 = jsRegisterArray(pairArr)
        var pairRef: JsValue
        JsValueInitArray(pairRef, pairId)
        jsArrayAddJsValue(out, pairRef)
    return true

#
# ──────────────────────────────────────
# JsSet (proper implementation with JsValue elements)
# ──────────────────────────────────────
#

fn JsSetCreate(out: var JsValue): bool =
    let objId: int32 = JsObjectFreshId()
    var obj: JsObject
    JsObjectInit(obj, objId, 0)
    add(jsObjectTable, obj)
    jsObjectCount = jsObjectCount + 1
    var set: JsSet
    set.setId = objId
    set.values = []
    add(jsSetTable, set)
    jsSetCount = jsSetCount + 1
    JsValueInitObject(out, objId)
    return true

fn JsSetGetByObjectId(objectId: int32, out: var JsSet): bool =
    for i in 0..<jsSetCount:
        if jsSetTable[i].setId == objectId:
            out = jsSetTable[i]
            return true
    return false

fn JsSetAddObj(set: var JsSet, value: var JsValue): bool =
    let n: int32 = set.values.len
    for i in 0..<n:
        if JsValueEquals(set.values[i], value):
            return true
    var stored: JsValue
    JsValueCopy(stored, value)
    add(set.values, stored)
    return true

fn JsSetDelete(set: var JsSet, value: var JsValue): bool =
    let n: int32 = set.values.len
    for i in 0..<n:
        if JsValueEquals(set.values[i], value):
            var j: int32 = i
            while j < n - 1:
                JsValueCopy(set.values[j], set.values[j + 1])
                j = j + 1
            setLen(set.values, n - 1)
            return true
    return false

fn JsSetHasObj(set: var JsSet, value: var JsValue): bool =
    let n: int32 = set.values.len
    for i in 0..<n:
        if JsValueEquals(set.values[i], value):
            return true
    return false

fn JsSetClear(set: var JsSet) =
    setLen(set.values, 0)

fn JsSetSize(set: var JsSet): int32 =
    return set.values.len

fn JsSetForEach(set: var JsSet, callbackFnId: int32): bool =
    let n: int32 = set.values.len
    for i in 0..<n:
        var args: JsValue[]
        var valueArg1: JsValue
        JsValueCopy(valueArg1, set.values[i])
        add(args, valueArg1)
        var valueArg2: JsValue
        JsValueCopy(valueArg2, set.values[i])
        add(args, valueArg2)
        var setArg: JsValue
        JsValueInitObject(setArg, set.setId)
        add(args, setArg)
        var frame: JsCallFrame
        frame.args = args
        var result: JsValue
        if !jsDispatchChengFn(callbackFnId, frame, result):
            return false
    return true

fn JsSetValuesObj(set: var JsSet, out: var JsArray): bool =
    let n: int32 = set.values.len
    JsArrayInit(out, n)
    for i in 0..<n:
        var val: JsValue
        JsValueCopy(val, set.values[i])
        jsArrayAddJsValue(out, val)
    return true

#
# --- structuredClone ---
#

fn JsStructuredClone(value: var JsValue, out: var JsValue): bool =
    var visitedObjIds: int32[]
    var clonedObjIds: int32[]
    var visitedArrIds: int32[]
    var clonedArrIds: int32[]
    return JsStructuredCloneValue(value, out, visitedObjIds, clonedObjIds, visitedArrIds, clonedArrIds)

fn JsStructuredCloneValue(value: var JsValue, out: var JsValue,
                           visitedObjIds: var int32[], clonedObjIds: var int32[],
                           visitedArrIds: var int32[], clonedArrIds: var int32[]): bool =
    JsValueReset(out)
    out.kind = value.kind

    if value.kind == JsKindUndefined || value.kind == JsKindNull:
        return true

    if value.kind == JsKindBool:
        out.boolValue = value.boolValue
        return true

    if value.kind == JsKindInt32:
        out.int32Value = value.int32Value
        return true

    if value.kind == JsKindFloat64:
        out.float64Value = value.float64Value
        return true

    if value.kind == JsKindString:
        out.stringValue = value.stringValue
        return true

    if value.kind == JsKindSymbol:
        out.stringValue = value.stringValue
        return true

    if value.kind == JsKindBigInt:
        out.stringValue = value.stringValue
        return true

    if value.kind == JsKindFunction:
        out.functionId = value.functionId
        return true

    if value.kind == JsKindObject:
        if value.arrayId > 0:
            # Array: check cycle, then clone each element
            for i in 0..<visitedArrIds.len:
                if visitedArrIds[i] == value.arrayId:
                    out.arrayId = clonedArrIds[i]
                    return true

            var srcArr: JsArray
            if !JsArrayLoadById(value.arrayId, srcArr):
                return false

            let arrLen: int32 = JsArrayLength(srcArr)
            var dstArr: JsArray
            if !JsArrayInit(dstArr, arrLen):
                return false

            let newArrId: int32 = jsRegisterArray(dstArr)
            add(visitedArrIds, value.arrayId)
            add(clonedArrIds, newArrId)

            var hasJsValues: bool = srcArr.valuesJs.len > 0
            for i in 0..<arrLen:
                var elemVal: JsValue
                if hasJsValues:
                    if i < srcArr.valuesJs.len:
                        JsValueCopy(elemVal, srcArr.valuesJs[i])
                    else:
                        JsValueInitUndefined(elemVal)
                else:
                    if i < srcArr.values.len:
                        JsValueInitInt32(elemVal, srcArr.values[i])
                    else:
                        JsValueInitUndefined(elemVal)

                var clonedElem: JsValue
                if !JsStructuredCloneValue(elemVal, clonedElem, visitedObjIds, clonedObjIds, visitedArrIds, clonedArrIds):
                    return false
                jsArrayAddJsValue(dstArr, clonedElem)

            out.arrayId = newArrId
            return true

        # Object (plain object, not array)
        for i in 0..<visitedObjIds.len:
            if visitedObjIds[i] == value.objectId:
                out.objectId = clonedObjIds[i]
                return true

        var srcObj: JsObject
        if !JsObjectGetById(value.objectId, srcObj):
            return false

        var newObj: JsObject
        let newObjId: int32 = JsObjectFreshId()
        let srcPropLen: int32 = srcObj.properties.len
        var requiredCapacity: int32 = JsObjectDefaultPropertyCapacity
        if srcPropLen > requiredCapacity:
            requiredCapacity = srcPropLen
        JsObjectInitWithCapacity(newObj, newObjId, 0, requiredCapacity, JsObjectDefaultElementCapacity)
        add(jsObjectTable, newObj)
        jsObjectCount = jsObjectCount + 1

        add(visitedObjIds, value.objectId)
        add(clonedObjIds, newObjId)

        for i in 0..<srcPropLen:
            var propVal: JsValue
            JsObjectCopyPropertyValue(propVal, srcObj.properties[i])
            var clonedPropVal: JsValue
            if !JsStructuredCloneValue(propVal, clonedPropVal, visitedObjIds, clonedObjIds, visitedArrIds, clonedArrIds):
                return false
            let propName: str = srcObj.properties[i].name
            var descriptor: JsPropertyDescriptor
            JsDescriptorInitData(descriptor,
                                 srcObj.properties[i].writable,
                                 srcObj.properties[i].enumerable,
                                 srcObj.properties[i].configurable)
            if !JsObjectDefineDataPropertyById(newObjId, propName, clonedPropVal, descriptor):
                return false

        out.objectId = newObjId
        return true

    return true

#
# --- Math functions ---
#

fn JsMathFloor(x: float64): int32 =
    let n: int32 = int(x)
    if x < 0.0 && float64(n) != x:
        return n - 1
    return n

fn JsMathCeil(x: float64): int32 =
    let n: int32 = int(x)
    if x > 0.0 && float64(n) != x:
        return n + 1
    return n

fn JsMathRound(x: float64): int32 =
    if x < 0.0:
        return JsMathCeil(x - 0.5)
    return JsMathFloor(x + 0.5)

fn JsMathAbs(x: float64): float64 =
    if x < 0.0:
        return -x
    return x

fn JsMathMax(a: float64, b: float64): float64 =
    if a > b:
        return a
    return b

fn JsMathMin(a: float64, b: float64): float64 =
    if a < b:
        return a
    return b

#
# --- Number functions ---
#

fn JsNumberIsFinite(value: var JsValue): bool =
    if value.kind == JsKindInt32:
        return true
    if value.kind == JsKindFloat64:
        return value.float64Value == value.float64Value
    return false

#
# --- Date functions ---
#

fn JsDateGetTime(dateMs: float64): float64 =
    return dateMs

fn JsDateGetFullYear(dateMs: float64): int32 =
    return int(dateMs / float64(31536000000.0)) + 1970

fn JsDateNow(): float64 =
    let totalMs = cheng_epoch_time_ms()
    let secsPart = totalMs / Int64(1000)
    let msPart = totalMs % Int64(1000)
    return float64(Int32(secsPart)) * float64(1000.0) + float64(Int32(msPart))

fn JsDateGetMonth(dateMs: float64): int32 =
    let msPerYear = float64(31536000000.0)
    let yearsElapsed = int(dateMs / msPerYear)
    let remainingMs = dateMs - float64(yearsElapsed) * msPerYear
    let monthsElapsed = int(remainingMs / float64(2628000000.0))
    if monthsElapsed >= 12:
        return 11
    return monthsElapsed

fn JsDateGetDate(dateMs: float64): int32 =
    let msPerYear = float64(31536000000.0)
    let yearsElapsed = int(dateMs / msPerYear)
    let remainingMs = dateMs - float64(yearsElapsed) * msPerYear
    let monthsElapsed = int(remainingMs / float64(2628000000.0))
    let msPerMonth = float64(2628000000.0)
    let remainingAfterMonths = remainingMs - float64(monthsElapsed) * msPerMonth
    let dayIndex = int(remainingAfterMonths / float64(86400000.0)) + 1
    if dayIndex > 31:
        return 31
    return dayIndex

#
# ──────────────────────────────────────
# Task A: Promise combinators
# ──────────────────────────────────────
#

fn JsPromiseAll(promises: JsValue[], out: var JsValue): bool =
    var resultArr: JsArray
    if !JsArrayInit(resultArr, promises.len):
        JsValueInitUndefined(out)
        return false
    let n: int32 = promises.len
    for i in 0..<n:
        let p = promises[i]
        # Check if it is a promise object with a "state" property
        if p.kind == JsKindObject && p.objectId > 0:
            var obj: JsObject
            if JsObjectGetById(p.objectId, obj):
                var stateVal: JsValue
                if JsObjectGetOwnProperty(obj, "state", stateVal):
                    if stateVal.kind == JsKindString:
                        if stateVal.stringValue == "rejected":
                            var reasonVal: JsValue
                            JsObjectGetOwnProperty(obj, "reason", reasonVal)
                            JsValueCopy(out, reasonVal)
                            return false
                        elif stateVal.stringValue == "fulfilled":
                            var valVal: JsValue
                            if JsObjectGetOwnProperty(obj, "value", valVal):
                                jsArrayAddJsValue(resultArr, valVal)
                            else:
                                jsArrayAddJsValue(resultArr, p)
                            continue
                    # pending state or unknown: fall through to add as-is
        # Non-promise or no state: use value directly
        jsArrayAddJsValue(resultArr, p)
    let arrId = jsRegisterArray(resultArr)
    JsValueInitArray(out, arrId)
    return true

fn JsPromiseRace(promises: JsValue[], out: var JsValue): bool =
    let n: int32 = promises.len
    for i in 0..<n:
        let p = promises[i]
        if p.kind == JsKindObject && p.objectId > 0:
            var obj: JsObject
            if JsObjectGetById(p.objectId, obj):
                var stateVal: JsValue
                if JsObjectGetOwnProperty(obj, "state", stateVal):
                    if stateVal.kind == JsKindString:
                        if stateVal.stringValue == "fulfilled":
                            var valVal: JsValue
                            if JsObjectGetOwnProperty(obj, "value", valVal):
                                JsValueCopy(out, valVal)
                                return true
                            JsValueCopy(out, p)
                            return true
                        elif stateVal.stringValue == "rejected":
                            var reasonVal: JsValue
                            JsObjectGetOwnProperty(obj, "reason", reasonVal)
                            JsValueCopy(out, reasonVal)
                            return false
                    # pending state: skip
                    continue
        # Not a promise or no state -> first non-promise is returned immediately
        JsValueCopy(out, p)
        return true
    JsValueInitUndefined(out)
    return false

fn JsPromiseAllSettled(promises: JsValue[], out: var JsValue): bool =
    var resultArr: JsArray
    if !JsArrayInit(resultArr, promises.len):
        JsValueInitUndefined(out)
        return false
    let n: int32 = promises.len
    for i in 0..<n:
        let p = promises[i]
        var statusObj: JsObject
        if !JsObjectCreateFresh(statusObj, 0):
            jsArrayAddJsValue(resultArr, p)
            continue
        var descriptor: JsPropertyDescriptor
        JsDescriptorInitData(descriptor, true, true, true)
        var isPromise: bool
        if p.kind == JsKindObject && p.objectId > 0:
            var obj: JsObject
            if JsObjectGetById(p.objectId, obj):
                var stateVal: JsValue
                if JsObjectGetOwnProperty(obj, "state", stateVal):
                    if stateVal.kind == JsKindString:
                        isPromise = true
                        if stateVal.stringValue == "fulfilled":
                            var statusStr: JsValue
                            JsValueInitString(statusStr, "fulfilled")
                            JsObjectDefineDataPropertyById(statusObj.objectId, "status", statusStr, descriptor)
                            var valVal: JsValue
                            if JsObjectGetOwnProperty(obj, "value", valVal):
                                JsObjectDefineDataPropertyById(statusObj.objectId, "value", valVal, descriptor)
                        elif stateVal.stringValue == "rejected":
                            var statusStr: JsValue
                            JsValueInitString(statusStr, "rejected")
                            JsObjectDefineDataPropertyById(statusObj.objectId, "status", statusStr, descriptor)
                            var reasonVal: JsValue
                            if JsObjectGetOwnProperty(obj, "reason", reasonVal):
                                JsObjectDefineDataPropertyById(statusObj.objectId, "reason", reasonVal, descriptor)
                        else:
                            # pending: treat as fulfilled with the promise
                            var statusStr: JsValue
                            JsValueInitString(statusStr, "fulfilled")
                            JsObjectDefineDataPropertyById(statusObj.objectId, "status", statusStr, descriptor)
                            JsObjectDefineDataPropertyById(statusObj.objectId, "value", p, descriptor)
        if !isPromise:
            # Non-promise: fulfilled with the value itself
            var statusStr: JsValue
            JsValueInitString(statusStr, "fulfilled")
            JsObjectDefineDataPropertyById(statusObj.objectId, "status", statusStr, descriptor)
            JsObjectDefineDataPropertyById(statusObj.objectId, "value", p, descriptor)
        var resultVal: JsValue
        JsValueInitObject(resultVal, statusObj.objectId)
        jsArrayAddJsValue(resultArr, resultVal)
    let arrId = jsRegisterArray(resultArr)
    JsValueInitArray(out, arrId)
    return true

fn JsPromiseAny(promises: JsValue[], out: var JsValue): bool =
    let n: int32 = promises.len
    var allRejected: bool = true
    for i in 0..<n:
        let p = promises[i]
        if p.kind == JsKindObject && p.objectId > 0:
            var obj: JsObject
            if JsObjectGetById(p.objectId, obj):
                var stateVal: JsValue
                if JsObjectGetOwnProperty(obj, "state", stateVal):
                    if stateVal.kind == JsKindString:
                        if stateVal.stringValue == "fulfilled":
                            var valVal: JsValue
                            if JsObjectGetOwnProperty(obj, "value", valVal):
                                JsValueCopy(out, valVal)
                                return true
                            JsValueCopy(out, p)
                            return true
                        elif stateVal.stringValue == "rejected":
                            continue
                        # pending: may still become fulfilled
                        allRejected = false
                        continue
        # Non-promise: treat as fulfilled value
        JsValueCopy(out, p)
        return true
    if allRejected:
        var errVal: JsValue
        JsValueInitString(errVal, "AggregateError: All promises were rejected")
        JsValueCopy(out, errVal)
        return false
    JsValueInitUndefined(out)
    return false

#
# ──────────────────────────────────────
# Task B: Error constructors
# ──────────────────────────────────────
#

fn JsCreateError(kind: int32, message: str, out: var JsValue): bool =
    var obj: JsObject
    if !JsObjectCreateFresh(obj, 0):
        JsValueInitUndefined(out)
        return false
    var descriptor: JsPropertyDescriptor
    JsDescriptorInitData(descriptor, true, true, true)
    var nameVal: JsValue
    if kind == JsExceptionTypeError:
        JsValueInitString(nameVal, "TypeError")
    elif kind == JsExceptionRangeError:
        JsValueInitString(nameVal, "RangeError")
    elif kind == JsExceptionSyntaxError:
        JsValueInitString(nameVal, "SyntaxError")
    elif kind == JsExceptionReferenceError:
        JsValueInitString(nameVal, "ReferenceError")
    else:
        JsValueInitString(nameVal, "Error")
    if !JsObjectDefineDataPropertyById(obj.objectId, "name", nameVal, descriptor):
        JsValueInitUndefined(out)
        return false
    var msgVal: JsValue
    JsValueInitString(msgVal, message)
    if !JsObjectDefineDataPropertyById(obj.objectId, "message", msgVal, descriptor):
        JsValueInitUndefined(out)
        return false
    var stackVal: JsValue
    JsValueInitString(stackVal, "")
    if !JsObjectDefineDataPropertyById(obj.objectId, "stack", stackVal, descriptor):
        JsValueInitUndefined(out)
        return false
    JsValueInitObject(out, obj.objectId)
    return true

fn JsCreateTypeError(message: str, out: var JsValue): bool =
    return JsCreateError(JsExceptionTypeError, message, out)

fn JsCreateRangeError(message: str, out: var JsValue): bool =
    return JsCreateError(JsExceptionRangeError, message, out)

fn JsCreateSyntaxError(message: str, out: var JsValue): bool =
    return JsCreateError(JsExceptionSyntaxError, message, out)

#
# ──────────────────────────────────────
# Task C: Symbol + Iterator
# ──────────────────────────────────────
#

var jsNextSymbolId: int32 = 1

fn JsSymbolCreate(description: str): int32 =
    let id: int32 = jsNextSymbolId
    jsNextSymbolId = jsNextSymbolId + 1
    return id

fn JsSymbolFor(key: str): int32 =
    return JsSymbolCreate(key)

fn JsSymbolIterator(): int32 =
    return -1

fn JsValueIsIterable(value: var JsValue): bool =
    if value.arrayId > 0:
        return true
    if value.kind == JsKindObject && value.objectId > 0:
        # Check if it is a Map or Set by table lookup
        for i in 0..<jsMapCount:
            if jsMapTable[i].mapId == value.objectId:
                return true
        for i in 0..<jsSetCount:
            if jsSetTable[i].setId == value.objectId:
                return true
    return false

fn JsIterableNext(value: var JsValue, index: int32, out: var JsValue): bool =
    if value.arrayId > 0:
        var arr: JsArray
        if !JsArrayLoadById(value.arrayId, arr):
            JsValueInitUndefined(out)
            return false
        let arrLen: int32 = JsArrayLength(arr)
        var resultObj: JsObject
        if !JsObjectCreateFresh(resultObj, 0):
            JsValueInitUndefined(out)
            return false
        var descriptor: JsPropertyDescriptor
        JsDescriptorInitData(descriptor, true, true, true)
        if index < arrLen:
            var itemVal: JsValue
            if arr.valuesJs.len > 0:
                if index < arr.valuesJs.len:
                    JsValueCopy(itemVal, arr.valuesJs[index])
                else:
                    JsValueInitUndefined(itemVal)
            else:
                if index < arr.values.len:
                    JsValueInitInt32(itemVal, arr.values[index])
                else:
                    JsValueInitUndefined(itemVal)
            JsObjectDefineDataPropertyById(resultObj.objectId, "value", itemVal, descriptor)
            var doneVal: JsValue
            JsValueInitBool(doneVal, false)
            JsObjectDefineDataPropertyById(resultObj.objectId, "done", doneVal, descriptor)
        else:
            var undefVal: JsValue
            JsValueInitUndefined(undefVal)
            JsObjectDefineDataPropertyById(resultObj.objectId, "value", undefVal, descriptor)
            var doneVal: JsValue
            JsValueInitBool(doneVal, true)
            JsObjectDefineDataPropertyById(resultObj.objectId, "done", doneVal, descriptor)
        JsValueInitObject(out, resultObj.objectId)
        return true
    JsValueInitUndefined(out)
    return false

#
# ──────────────────────────────────────
# Task D: ArrayBuffer + TypedArray helpers
# ──────────────────────────────────────
#

fn JsArrayBufferCreate(byteLength: int32, out: var JsArrayBuffer): bool =
    if byteLength < 0:
        return false
    out.bufferId = jsArrayBufferCount + 1
    out.data = []
    out.byteLength = byteLength
    var i: int32
    while i < byteLength:
        add(out.data, 0)
        i = i + 1
    var stored: JsArrayBuffer
    JsArrayBufferCopy(stored, out)
    add(jsArrayBufferTable, stored)
    jsArrayBufferCount = jsArrayBufferCount + 1
    return true

fn JsUint8ArrayCreate(length: int32, out: var JsTypedArray): bool =
    if length < 0:
        return false
    var buf: JsArrayBuffer
    if !JsArrayBufferCreate(length, buf):
        return false
    out.arrayId = jsTypedArrayCount + 1
    out.bufferId = buf.bufferId
    out.byteOffset = 0
    out.byteLength = length
    out.length = length
    out.bytesPerElement = 1
    var stored: JsTypedArray
    JsTypedArrayCopy(stored, out)
    add(jsTypedArrayTable, stored)
    jsTypedArrayCount = jsTypedArrayCount + 1
    return true

fn JsUint8ArrayGet(arr: var JsTypedArray, index: int32): int32 =
    if index < 0 || index >= arr.length:
        return 0
    return JsArrayBufferGetByteById(arr.bufferId, arr.byteOffset + index)

fn JsUint8ArraySet(arr: var JsTypedArray, index: int32, value: int32): bool =
    if index < 0 || index >= arr.length:
        return false
    return JsArrayBufferSetByteById(arr.bufferId, arr.byteOffset + index, value)
