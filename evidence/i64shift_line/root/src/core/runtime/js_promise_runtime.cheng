import cheng/core/runtime/js_runtime as jsrt
import cheng/core/runtime/js_event_loop_runtime as eloop

const
    JsPromisePending = 0
    JsPromiseFulfilled = 1
    JsPromiseRejected = 2

    JsPromiseNoHandler = 0
    JsPromiseNoChild = -1
    JsPromiseRegistryCapacity = 1024
    JsPromisePendingReactionCapacity = 2048
    JsPromiseReactionJobCapacity = 2048

    JsPromiseReactionFulfill = 1
    JsPromiseReactionReject = 2

    JsPromiseHandlerDispatchUnsupported = "js promise handler dispatch unsupported"
    JsPromiseThenableAssimilationUnsupported = "js promise thenable assimilation unsupported"
    JsPromiseReactionDispatchStepLimitExceeded = "js promise reaction dispatch step limit exceeded"
    JsPromiseReactionDispatchInvalidKind = "js promise reaction dispatch invalid kind"
    JsPromiseReactionQueueCapacityExceeded = "js promise reaction queue capacity exceeded"
    JsPromiseAllUnsupported = "js promise all async compose unsupported"
    JsPromiseAllSettledUnsupported = "js promise allsettled async compose unsupported"
    JsPromiseRaceUnsupported = "js promise race async compose unsupported"

type
    JsPromiseRuntime =
        promiseState: int32[]
        promiseValueKind: int32[]
        promiseValueBool: int32[]
        promiseValueInt32: int32[]
        promiseValueFloat64: float64[]
        promiseValueString: str[]
        promiseValueObjectId: int32[]
        promiseValueFunctionId: int32[]
        promiseValueArrayId: int32[]
        promiseReasonKind: int32[]
        promiseReasonBool: int32[]
        promiseReasonInt32: int32[]
        promiseReasonFloat64: float64[]
        promiseReasonString: str[]
        promiseReasonObjectId: int32[]
        promiseReasonFunctionId: int32[]
        promiseReasonArrayId: int32[]
        pendingPromiseIdx: int32[]
        pendingReactionKind: int32[]
        pendingHandlerId: int32[]
        pendingChildIdx: int32[]
        reactionJobKind: int32[]
        reactionJobHandlerId: int32[]
        reactionJobNextIdx: int32[]
        reactionJobInputKind: int32[]
        reactionJobInputBool: int32[]
        reactionJobInputInt32: int32[]
        reactionJobInputFloat64: float64[]
        reactionJobInputString: str[]
        reactionJobInputObjectId: int32[]
        reactionJobInputFunctionId: int32[]
        reactionJobInputArrayId: int32[]
        reactionJobHead: int32
        handlerIds: int32[]
        handlerFunctions: jsrt.JsFunction[]

fn boolToInt(raw: bool): int32 =
    if raw:
        return 1
    return 0

fn intToBool(raw: int32): bool =
    return raw != 0

fn jsPromiseRuntimeInit(runtime: var JsPromiseRuntime) =
    runtime.promiseState = []
    runtime.promiseValueKind = []
    runtime.promiseValueBool = []
    runtime.promiseValueInt32 = []
    runtime.promiseValueFloat64 = []
    runtime.promiseValueString = []
    runtime.promiseValueObjectId = []
    runtime.promiseValueFunctionId = []
    runtime.promiseReasonKind = []
    runtime.promiseReasonBool = []
    runtime.promiseReasonInt32 = []
    runtime.promiseReasonFloat64 = []
    runtime.promiseReasonString = []
    runtime.promiseReasonObjectId = []
    runtime.promiseReasonFunctionId = []
    runtime.promiseValueArrayId = []
    runtime.promiseReasonArrayId = []
    runtime.pendingPromiseIdx = []
    runtime.pendingReactionKind = []
    runtime.pendingHandlerId = []
    runtime.pendingChildIdx = []
    runtime.reactionJobKind = []
    runtime.reactionJobHandlerId = []
    runtime.reactionJobNextIdx = []
    runtime.reactionJobInputKind = []
    runtime.reactionJobInputBool = []
    runtime.reactionJobInputInt32 = []
    runtime.reactionJobInputFloat64 = []
    runtime.reactionJobInputString = []
    runtime.reactionJobInputObjectId = []
    runtime.reactionJobInputFunctionId = []
    runtime.reactionJobInputArrayId = []
    runtime.reactionJobHead = 0
    runtime.handlerIds = []
    runtime.handlerFunctions = []

fn JsPromiseRuntimeInit(runtime: var JsPromiseRuntime) =
    jsPromiseRuntimeInit(runtime)

fn jsPromiseRegistryReset(runtime: var JsPromiseRuntime) =
    jsPromiseRuntimeInit(runtime)

fn jsPromiseRuntimeReset(runtime: var JsPromiseRuntime) =
    jsPromiseRuntimeInit(runtime)

fn jsPromiseIndexValid(runtime: var JsPromiseRuntime, idx: int32): bool =
    return idx >= 0 && idx < runtime.promiseState.len

fn jsPromiseSetValue(runtime: var JsPromiseRuntime, idx: int32, value: var jsrt.JsValue) =
    runtime.promiseValueKind[idx] = value.kind
    runtime.promiseValueBool[idx] = boolToInt(value.boolValue)
    runtime.promiseValueInt32[idx] = value.int32Value
    runtime.promiseValueFloat64[idx] = value.float64Value
    runtime.promiseValueString[idx] = value.stringValue
    runtime.promiseValueObjectId[idx] = value.objectId
    runtime.promiseValueFunctionId[idx] = value.functionId
    runtime.promiseValueArrayId[idx] = value.arrayId

fn jsPromiseSetReason(runtime: var JsPromiseRuntime, idx: int32, value: var jsrt.JsValue) =
    runtime.promiseReasonKind[idx] = value.kind
    runtime.promiseReasonBool[idx] = boolToInt(value.boolValue)
    runtime.promiseReasonInt32[idx] = value.int32Value
    runtime.promiseReasonFloat64[idx] = value.float64Value
    runtime.promiseReasonString[idx] = value.stringValue
    runtime.promiseReasonObjectId[idx] = value.objectId
    runtime.promiseReasonFunctionId[idx] = value.functionId
    runtime.promiseReasonArrayId[idx] = value.arrayId

fn jsPromiseWriteValue(runtime: var JsPromiseRuntime, idx: int32, out: var jsrt.JsValue) =
    out.kind = runtime.promiseValueKind[idx]
    out.boolValue = intToBool(runtime.promiseValueBool[idx])
    out.int32Value = runtime.promiseValueInt32[idx]
    out.float64Value = runtime.promiseValueFloat64[idx]
    out.stringValue = runtime.promiseValueString[idx]
    out.objectId = runtime.promiseValueObjectId[idx]
    out.functionId = runtime.promiseValueFunctionId[idx]
    out.arrayId = runtime.promiseValueArrayId[idx]

fn jsPromiseWriteReason(runtime: var JsPromiseRuntime, idx: int32, out: var jsrt.JsValue) =
    out.kind = runtime.promiseReasonKind[idx]
    out.boolValue = intToBool(runtime.promiseReasonBool[idx])
    out.int32Value = runtime.promiseReasonInt32[idx]
    out.float64Value = runtime.promiseReasonFloat64[idx]
    out.stringValue = runtime.promiseReasonString[idx]
    out.objectId = runtime.promiseReasonObjectId[idx]
    out.functionId = runtime.promiseReasonFunctionId[idx]
    out.arrayId = runtime.promiseReasonArrayId[idx]

fn jsPromiseNew(runtime: var JsPromiseRuntime): int32 =
    if runtime.promiseState.len >= JsPromiseRegistryCapacity:
        return JsPromiseNoChild
    add(runtime.promiseState, JsPromisePending)
    add(runtime.promiseValueKind, 0)
    add(runtime.promiseValueBool, 0)
    add(runtime.promiseValueInt32, 0)
    add(runtime.promiseValueFloat64, 0.0)
    add(runtime.promiseValueString, "")
    add(runtime.promiseValueObjectId, 0)
    add(runtime.promiseValueFunctionId, 0)
    add(runtime.promiseValueArrayId, 0)
    add(runtime.promiseReasonKind, 0)
    add(runtime.promiseReasonBool, 0)
    add(runtime.promiseReasonInt32, 0)
    add(runtime.promiseReasonFloat64, 0.0)
    add(runtime.promiseReasonString, "")
    add(runtime.promiseReasonObjectId, 0)
    add(runtime.promiseReasonFunctionId, 0)
    add(runtime.promiseReasonArrayId, 0)
    return runtime.promiseState.len - 1

fn jsPromiseResolve(runtime: var JsPromiseRuntime, v: var jsrt.JsValue): int32 =
    let idx: int32 = jsPromiseNew(runtime)
    if idx == JsPromiseNoChild:
        return JsPromiseNoChild
    runtime.promiseState[idx] = JsPromiseFulfilled
    jsPromiseSetValue(runtime, idx, v)
    return idx

fn jsPromiseStaticReject(runtime: var JsPromiseRuntime, r: var jsrt.JsValue): int32 =
    let idx: int32 = jsPromiseNew(runtime)
    if idx == JsPromiseNoChild:
        return JsPromiseNoChild
    runtime.promiseState[idx] = JsPromiseRejected
    jsPromiseSetReason(runtime, idx, r)
    return idx

fn jsPromiseState(runtime: var JsPromiseRuntime, idx: int32): int32 =
    if !jsPromiseIndexValid(runtime, idx):
        return JsPromisePending
    return runtime.promiseState[idx]

fn jsPromiseIsPending(runtime: var JsPromiseRuntime, idx: int32): bool =
    return jsPromiseState(runtime, idx) == JsPromisePending

fn jsPromiseIsFulfilled(runtime: var JsPromiseRuntime, idx: int32): bool =
    return jsPromiseState(runtime, idx) == JsPromiseFulfilled

fn jsPromiseIsRejected(runtime: var JsPromiseRuntime, idx: int32): bool =
    return jsPromiseState(runtime, idx) == JsPromiseRejected

fn jsPromiseGetValue(runtime: var JsPromiseRuntime, idx: int32, out: var jsrt.JsValue): bool =
    if !jsPromiseIndexValid(runtime, idx):
        jsrt.JsValueInitUndefined(out)
        return false
    if runtime.promiseState[idx] != JsPromiseFulfilled:
        jsrt.JsValueInitUndefined(out)
        return false
    jsPromiseWriteValue(runtime, idx, out)
    return true

fn jsPromiseGetReason(runtime: var JsPromiseRuntime, idx: int32, out: var jsrt.JsValue): bool =
    if !jsPromiseIndexValid(runtime, idx):
        jsrt.JsValueInitUndefined(out)
        return false
    if runtime.promiseState[idx] != JsPromiseRejected:
        jsrt.JsValueInitUndefined(out)
        return false
    jsPromiseWriteReason(runtime, idx, out)
    return true

fn jsPromiseAwaitInt32(runtime: var JsPromiseRuntime, idx: int32, out: var int32): bool =
    var value: jsrt.JsValue
    if !jsPromiseGetValue(runtime, idx, value):
        return false
    if !jsrt.JsValueIsInt32(value):
        return false
    out = jsrt.JsValueInt32(value)
    return true

fn jsPromisePendingReactionCapacityAvailable(runtime: var JsPromiseRuntime, extra: int32): bool =
    return runtime.pendingPromiseIdx.len + extra <= JsPromisePendingReactionCapacity

fn jsPromiseReactionJobCapacityAvailable(runtime: var JsPromiseRuntime, extra: int32): bool =
    return runtime.reactionJobKind.len + extra <= JsPromiseReactionJobCapacity

fn jsPromiseAddPendingReaction(runtime: var JsPromiseRuntime,
                               promiseIdx: int32,
                               kind: int32,
                               handlerId: int32,
                               childIdx: int32): bool =
    if !jsPromisePendingReactionCapacityAvailable(runtime, 1):
        jsrt.jsSetUnsupportedException(JsPromiseReactionQueueCapacityExceeded)
        return false
    add(runtime.pendingPromiseIdx, promiseIdx)
    add(runtime.pendingReactionKind, kind)
    add(runtime.pendingHandlerId, handlerId)
    add(runtime.pendingChildIdx, childIdx)
    return true

fn jsPromiseEnqueueReactionJob(runtime: var JsPromiseRuntime,
                               kind: int32,
                               handlerId: int32,
                               childIdx: int32,
                               input: var jsrt.JsValue,
                               loop: var eloop.JsEventLoop): bool =
    if !jsPromiseReactionJobCapacityAvailable(runtime, 1):
        jsrt.jsSetUnsupportedException(JsPromiseReactionQueueCapacityExceeded)
        return false
    add(runtime.reactionJobKind, kind)
    add(runtime.reactionJobHandlerId, handlerId)
    add(runtime.reactionJobNextIdx, childIdx)
    add(runtime.reactionJobInputKind, input.kind)
    add(runtime.reactionJobInputBool, boolToInt(input.boolValue))
    add(runtime.reactionJobInputInt32, input.int32Value)
    add(runtime.reactionJobInputFloat64, input.float64Value)
    add(runtime.reactionJobInputString, input.stringValue)
    add(runtime.reactionJobInputObjectId, input.objectId)
    add(runtime.reactionJobInputFunctionId, input.functionId)
    add(runtime.reactionJobInputArrayId, input.arrayId)
    if handlerId > JsPromiseNoHandler:
        return eloop.JsEventLoopEnqueuePromiseMicrotask(loop, handlerId)
    return true

fn jsPromiseThen(runtime: var JsPromiseRuntime,
                 promiseIdx: int32,
                 onFulfilled: int32,
                 onRejected: int32,
                 loop: var eloop.JsEventLoop): int32 =
    if !jsPromiseIndexValid(runtime, promiseIdx):
        return JsPromiseNoChild
    let st: int32 = runtime.promiseState[promiseIdx]
    if st == JsPromisePending:
        if !jsPromisePendingReactionCapacityAvailable(runtime, 2):
            jsrt.jsSetUnsupportedException(JsPromiseReactionQueueCapacityExceeded)
            return JsPromiseNoChild
    elif !jsPromiseReactionJobCapacityAvailable(runtime, 1):
        jsrt.jsSetUnsupportedException(JsPromiseReactionQueueCapacityExceeded)
        return JsPromiseNoChild
    let childIdx: int32 = jsPromiseNew(runtime)
    if childIdx == JsPromiseNoChild:
        return JsPromiseNoChild
    if st == JsPromisePending:
        if !jsPromiseAddPendingReaction(runtime, promiseIdx, JsPromiseReactionFulfill, onFulfilled, childIdx):
            return JsPromiseNoChild
        if !jsPromiseAddPendingReaction(runtime, promiseIdx, JsPromiseReactionReject, onRejected, childIdx):
            return JsPromiseNoChild
    elif st == JsPromiseFulfilled:
        var value: jsrt.JsValue
        jsPromiseWriteValue(runtime, promiseIdx, value)
        if !jsPromiseEnqueueReactionJob(runtime, JsPromiseReactionFulfill, onFulfilled, childIdx, value, loop):
            return JsPromiseNoChild
    elif st == JsPromiseRejected:
        var reason: jsrt.JsValue
        jsPromiseWriteReason(runtime, promiseIdx, reason)
        if !jsPromiseEnqueueReactionJob(runtime, JsPromiseReactionReject, onRejected, childIdx, reason, loop):
            return JsPromiseNoChild
    return childIdx

fn jsPromiseCatch(runtime: var JsPromiseRuntime,
                  promiseIdx: int32,
                  onRejected: int32,
                  loop: var eloop.JsEventLoop): int32 =
    return jsPromiseThen(runtime, promiseIdx, JsPromiseNoHandler, onRejected, loop)

fn jsPromiseFulfill(runtime: var JsPromiseRuntime,
                    promiseIdx: int32,
                    v: var jsrt.JsValue,
                    loop: var eloop.JsEventLoop): void =
    if !jsPromiseIndexValid(runtime, promiseIdx):
        return
    if runtime.promiseState[promiseIdx] != JsPromisePending:
        return
    runtime.promiseState[promiseIdx] = JsPromiseFulfilled
    jsPromiseSetValue(runtime, promiseIdx, v)
    var i: int32
    for i in 0..<runtime.pendingPromiseIdx.len:
        if runtime.pendingPromiseIdx[i] == promiseIdx && runtime.pendingReactionKind[i] == JsPromiseReactionFulfill:
            let childIdx: int32 = runtime.pendingChildIdx[i]
            if childIdx != JsPromiseNoChild:
                jsPromiseEnqueueReactionJob(runtime,
                                            JsPromiseReactionFulfill,
                                            runtime.pendingHandlerId[i],
                                            childIdx,
                                            v,
                                            loop)

fn jsPromiseReject(runtime: var JsPromiseRuntime,
                   promiseIdx: int32,
                   r: var jsrt.JsValue,
                   loop: var eloop.JsEventLoop): void =
    if !jsPromiseIndexValid(runtime, promiseIdx):
        return
    if runtime.promiseState[promiseIdx] != JsPromisePending:
        return
    runtime.promiseState[promiseIdx] = JsPromiseRejected
    jsPromiseSetReason(runtime, promiseIdx, r)
    var i: int32
    for i in 0..<runtime.pendingPromiseIdx.len:
        if runtime.pendingPromiseIdx[i] == promiseIdx && runtime.pendingReactionKind[i] == JsPromiseReactionReject:
            let childIdx: int32 = runtime.pendingChildIdx[i]
            if childIdx != JsPromiseNoChild:
                jsPromiseEnqueueReactionJob(runtime,
                                            JsPromiseReactionReject,
                                            runtime.pendingHandlerId[i],
                                            childIdx,
                                            r,
                                            loop)

fn jsPromiseIsThenable(value: var jsrt.JsValue): bool =
    if value.kind != jsrt.JsKindObject:
        return false
    if value.objectId <= 0:
        return false
    var object: jsrt.JsObject
    if !jsrt.JsObjectGetById(value.objectId, object):
        return false
    var thenValue: jsrt.JsValue
    if !jsrt.JsObjectGetOwnProperty(object, "then", thenValue):
        return false
    return jsrt.JsValueIsFunction(thenValue)

fn jsPromiseThenableAssimilate(runtime: var JsPromiseRuntime,
                               childIdx: int32,
                               thenable: var jsrt.JsValue,
                               loop: var eloop.JsEventLoop): void =
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, JsPromiseThenableAssimilationUnsupported)
    jsPromiseReject(runtime, childIdx, reason, loop)

fn jsPromiseRegisterHandler(runtime: var JsPromiseRuntime,
                            handlerId: int32,
                            func: var jsrt.JsFunction): bool =
    if handlerId <= JsPromiseNoHandler:
        return false
    var stored: jsrt.JsFunction
    jsrt.JsFunctionCopy(stored, func)
    for i in 0..<runtime.handlerIds.len:
        if runtime.handlerIds[i] == handlerId:
            runtime.handlerFunctions[i] = stored
            return true
    add(runtime.handlerIds, handlerId)
    add(runtime.handlerFunctions, stored)
    return true

fn jsPromiseLoadHandler(runtime: var JsPromiseRuntime,
                        handlerId: int32,
                        out: var jsrt.JsFunction): bool =
    for i in 0..<runtime.handlerIds.len:
        if runtime.handlerIds[i] == handlerId:
            jsrt.JsFunctionCopy(out, runtime.handlerFunctions[i])
            return true
    return false

fn jsPromiseDispatchHandler(runtime: var JsPromiseRuntime,
                            handlerId: int32,
                            inputKind: int32,
                            inputBool: bool,
                            inputInt32: int32,
                            inputFloat64: float64,
                            inputString: str,
                            inputObjectId: int32,
                            inputFunctionId: int32,
                            inputArrayId: int32,
                            childIdx: int32,
                            loop: var eloop.JsEventLoop,
                            out: var jsrt.JsValue): bool =
    var func: jsrt.JsFunction
    if !jsPromiseLoadHandler(runtime, handlerId, func):
        jsrt.JsValueInitString(out, JsPromiseHandlerDispatchUnsupported)
        jsrt.jsSetCurrentException(out, jsrt.JsExceptionUnsupported)
        if jsPromiseIndexValid(runtime, childIdx):
            jsPromiseReject(runtime, childIdx, out, loop)
        return false
    var input: jsrt.JsValue
    input.kind = inputKind
    input.boolValue = inputBool
    input.int32Value = inputInt32
    input.float64Value = inputFloat64
    input.stringValue = inputString
    input.objectId = inputObjectId
    input.functionId = inputFunctionId
    input.arrayId = inputArrayId
    var args: jsrt.JsValue[]
    add(args, input)
    var thisBinding: jsrt.JsValue
    jsrt.JsValueInitUndefined(thisBinding)
    var result: jsrt.JsValue
    jsrt.JsValueInitUndefined(result)
    if !jsrt.jsCallFunction(func, thisBinding, args, result):
        var exc: jsrt.JsException
        if jsrt.jsGetCurrentException(exc):
            jsrt.JsValueCopy(out, exc.value)
        else:
            jsrt.JsValueCopy(out, result)
        if jsPromiseIndexValid(runtime, childIdx):
            jsPromiseReject(runtime, childIdx, out, loop)
        return false
    if jsPromiseIsThenable(result):
        jsPromiseThenableAssimilate(runtime, childIdx, result, loop)
        jsrt.JsValueCopy(out, result)
        return true
    jsPromiseFulfill(runtime, childIdx, result, loop)
    jsrt.JsValueCopy(out, result)
    return true

fn jsPromiseReactionJobQueueCount(runtime: var JsPromiseRuntime): int32 =
    return runtime.reactionJobKind.len - runtime.reactionJobHead

fn jsPromiseInputValueAt(runtime: var JsPromiseRuntime,
                         jobIdx: int32,
                         out: var jsrt.JsValue) =
    out.kind = runtime.reactionJobInputKind[jobIdx]
    out.boolValue = intToBool(runtime.reactionJobInputBool[jobIdx])
    out.int32Value = runtime.reactionJobInputInt32[jobIdx]
    out.float64Value = runtime.reactionJobInputFloat64[jobIdx]
    out.stringValue = runtime.reactionJobInputString[jobIdx]
    out.objectId = runtime.reactionJobInputObjectId[jobIdx]
    out.functionId = runtime.reactionJobInputFunctionId[jobIdx]
    out.arrayId = runtime.reactionJobInputArrayId[jobIdx]

fn jsPromiseDrainReactionJobs(runtime: var JsPromiseRuntime,
                              loop: var eloop.JsEventLoop,
                              maxSteps: int32,
                              out: var jsrt.JsValue): bool =
    jsrt.JsValueInitUndefined(out)
    if maxSteps < 0:
        jsrt.JsValueInitString(out, JsPromiseReactionDispatchStepLimitExceeded)
        return false
    var steps: int32
    while runtime.reactionJobHead < runtime.reactionJobKind.len:
        if steps >= maxSteps:
            jsrt.JsValueInitString(out, JsPromiseReactionDispatchStepLimitExceeded)
            return false
        let jobIdx: int32 = runtime.reactionJobHead
        runtime.reactionJobHead = runtime.reactionJobHead + 1
        let kind: int32 = runtime.reactionJobKind[jobIdx]
        let handlerId: int32 = runtime.reactionJobHandlerId[jobIdx]
        let childIdx: int32 = runtime.reactionJobNextIdx[jobIdx]
        var input: jsrt.JsValue
        jsPromiseInputValueAt(runtime, jobIdx, input)
        if handlerId > JsPromiseNoHandler:
            if !jsPromiseDispatchHandler(runtime,
                                         handlerId,
                                         input.kind,
                                         input.boolValue,
                                         input.int32Value,
                                         input.float64Value,
                                         input.stringValue,
                                         input.objectId,
                                         input.functionId,
                                         input.arrayId,
                                         childIdx,
                                         loop,
                                         out):
                return false
        elif kind == JsPromiseReactionFulfill:
            jsPromiseFulfill(runtime, childIdx, input, loop)
        elif kind == JsPromiseReactionReject:
            jsPromiseReject(runtime, childIdx, input, loop)
        else:
            jsrt.JsValueInitString(out, JsPromiseReactionDispatchInvalidKind)
            return false
        steps = steps + 1
    runtime.reactionJobHead = 0
    runtime.reactionJobKind = []
    runtime.reactionJobHandlerId = []
    runtime.reactionJobNextIdx = []
    runtime.reactionJobInputKind = []
    runtime.reactionJobInputBool = []
    runtime.reactionJobInputInt32 = []
    runtime.reactionJobInputFloat64 = []
    runtime.reactionJobInputString = []
    runtime.reactionJobInputObjectId = []
    runtime.reactionJobInputFunctionId = []
    runtime.reactionJobInputArrayId = []
    jsrt.JsValueInitUndefined(out)
    return true

fn jsPromiseWaitAll(runtime: var JsPromiseRuntime, promiseIds: int32[]): bool =
    var i: int32
    for i in 0..<promiseIds.len:
        if !jsPromiseIndexValid(runtime, promiseIds[i]):
            return false
        let st: int32 = runtime.promiseState[promiseIds[i]]
        if st != JsPromiseFulfilled && st != JsPromiseRejected:
            return false
    return true

fn jsPromiseAll(runtime: var JsPromiseRuntime, promiseIds: int32[], loop: var eloop.JsEventLoop): int32 =
    let resultPromiseId: int32 = jsPromiseNew(runtime)
    if resultPromiseId == JsPromiseNoChild:
        return JsPromiseNoChild
    if promiseIds.len == 0:
        var emptyArr: jsrt.JsArray
        jsrt.JsArrayInit(emptyArr, 0)
        let arrId: int32 = jsrt.jsRegisterArray(emptyArr)
        var val: jsrt.JsValue
        jsrt.JsValueInitArray(val, arrId)
        jsPromiseFulfill(runtime, resultPromiseId, val, loop)
        return resultPromiseId

    # Validate all indices
    var i: int32
    for i in 0..<promiseIds.len:
        if !jsPromiseIndexValid(runtime, promiseIds[i]):
            var reason: jsrt.JsValue
            jsrt.JsValueInitString(reason, JsPromiseAllUnsupported)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId

    # Fast path: all already fulfilled
    if jsPromiseWaitAll(runtime, promiseIds):
        var resultsArr: jsrt.JsArray
        jsrt.JsArrayInit(resultsArr, promiseIds.len)
        for i in 0..<promiseIds.len:
            let pid: int32 = promiseIds[i]
            var pval: jsrt.JsValue
            jsPromiseWriteValue(runtime, pid, pval)
            jsrt.jsArrayAddJsValue(resultsArr, pval)
        let arrId: int32 = jsrt.jsRegisterArray(resultsArr)
        var resultVal: jsrt.JsValue
        jsrt.JsValueInitArray(resultVal, arrId)
        jsPromiseFulfill(runtime, resultPromiseId, resultVal, loop)
        return resultPromiseId

    # Async path: chain via jsPromiseThen, drain, compose
    var childIds: int32[]
    for i in 0..<promiseIds.len:
        let child: int32 = jsPromiseThen(runtime, promiseIds[i], JsPromiseNoHandler, JsPromiseNoHandler, loop)
        if child == JsPromiseNoChild:
            var reason: jsrt.JsValue
            jsrt.JsValueInitString(reason, JsPromiseAllUnsupported)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId
        add(childIds, child)

    var drainOut: jsrt.JsValue
    jsPromiseDrainReactionJobs(runtime, loop, 2048, drainOut)

    if !jsPromiseWaitAll(runtime, childIds):
        var reason: jsrt.JsValue
        jsrt.JsValueInitString(reason, JsPromiseAllUnsupported)
        jsPromiseReject(runtime, resultPromiseId, reason, loop)
        return resultPromiseId

    var j: int32
    for j in 0..<childIds.len:
        if runtime.promiseState[childIds[j]] == JsPromiseRejected:
            var reason: jsrt.JsValue
            jsPromiseWriteReason(runtime, childIds[j], reason)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId

    var resultsArr: jsrt.JsArray
    jsrt.JsArrayInit(resultsArr, promiseIds.len)
    for j in 0..<childIds.len:
        var pval: jsrt.JsValue
        jsPromiseWriteValue(runtime, childIds[j], pval)
        jsrt.jsArrayAddJsValue(resultsArr, pval)
    let arrId: int32 = jsrt.jsRegisterArray(resultsArr)
    var resultVal: jsrt.JsValue
    jsrt.JsValueInitArray(resultVal, arrId)
    jsPromiseFulfill(runtime, resultPromiseId, resultVal, loop)
    return resultPromiseId

fn jsPromiseRace(runtime: var JsPromiseRuntime, promiseIds: int32[], loop: var eloop.JsEventLoop): int32 =
    let resultPromiseId: int32 = jsPromiseNew(runtime)
    if resultPromiseId == JsPromiseNoChild:
        return JsPromiseNoChild
    if promiseIds.len == 0:
        return resultPromiseId

    var i: int32
    for i in 0..<promiseIds.len:
        let pid: int32 = promiseIds[i]
        if !jsPromiseIndexValid(runtime, pid):
            continue
        let st: int32 = runtime.promiseState[pid]
        if st == JsPromiseFulfilled:
            var val: jsrt.JsValue
            jsPromiseWriteValue(runtime, pid, val)
            jsPromiseFulfill(runtime, resultPromiseId, val, loop)
            return resultPromiseId
        if st == JsPromiseRejected:
            var reason: jsrt.JsValue
            jsPromiseWriteReason(runtime, pid, reason)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId

    # Async path: chain via jsPromiseThen and drain
    var childIds: int32[]
    for i in 0..<promiseIds.len:
        let pid: int32 = promiseIds[i]
        if !jsPromiseIndexValid(runtime, pid):
            continue
        let child: int32 = jsPromiseThen(runtime, pid, JsPromiseNoHandler, JsPromiseNoHandler, loop)
        if child != JsPromiseNoChild:
            add(childIds, child)

    var drainOut: jsrt.JsValue
    jsPromiseDrainReactionJobs(runtime, loop, 2048, drainOut)

    for i in 0..<childIds.len:
        let st: int32 = runtime.promiseState[childIds[i]]
        if st == JsPromiseFulfilled:
            var val: jsrt.JsValue
            jsPromiseWriteValue(runtime, childIds[i], val)
            jsPromiseFulfill(runtime, resultPromiseId, val, loop)
            return resultPromiseId
        if st == JsPromiseRejected:
            var reason: jsrt.JsValue
            jsPromiseWriteReason(runtime, childIds[i], reason)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId

    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, JsPromiseRaceUnsupported)
    jsPromiseReject(runtime, resultPromiseId, reason, loop)
    return resultPromiseId

fn jsPromiseAllSettled(runtime: var JsPromiseRuntime, promiseIds: int32[], loop: var eloop.JsEventLoop): int32 =
    let resultPromiseId: int32 = jsPromiseNew(runtime)
    if resultPromiseId == JsPromiseNoChild:
        return JsPromiseNoChild
    if promiseIds.len == 0:
        var emptyArr: jsrt.JsArray
        jsrt.JsArrayInit(emptyArr, 0)
        let arrId: int32 = jsrt.jsRegisterArray(emptyArr)
        var val: jsrt.JsValue
        jsrt.JsValueInitArray(val, arrId)
        jsPromiseFulfill(runtime, resultPromiseId, val, loop)
        return resultPromiseId

    # Validate all indices
    var i: int32
    for i in 0..<promiseIds.len:
        if !jsPromiseIndexValid(runtime, promiseIds[i]):
            var reason: jsrt.JsValue
            jsrt.JsValueInitString(reason, JsPromiseAllSettledUnsupported)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId

    # Determine source promises: either originals (fast path) or chained children (async path)
    var sourceIds: int32[] = promiseIds

    if !jsPromiseWaitAll(runtime, promiseIds):
        # Async path: chain via jsPromiseThen and drain
        var childIds: int32[]
        for i in 0..<promiseIds.len:
            let child: int32 = jsPromiseThen(runtime, promiseIds[i], JsPromiseNoHandler, JsPromiseNoHandler, loop)
            if child == JsPromiseNoChild:
                var reason: jsrt.JsValue
                jsrt.JsValueInitString(reason, JsPromiseAllSettledUnsupported)
                jsPromiseReject(runtime, resultPromiseId, reason, loop)
                return resultPromiseId
            add(childIds, child)

        var drainOut: jsrt.JsValue
        jsPromiseDrainReactionJobs(runtime, loop, 2048, drainOut)

        if !jsPromiseWaitAll(runtime, childIds):
            var reason: jsrt.JsValue
            jsrt.JsValueInitString(reason, JsPromiseAllSettledUnsupported)
            jsPromiseReject(runtime, resultPromiseId, reason, loop)
            return resultPromiseId

        sourceIds = childIds

    # Compose settlement results from sourceIds
    var resultsArr: jsrt.JsArray
    jsrt.JsArrayInit(resultsArr, sourceIds.len)
    for i in 0..<sourceIds.len:
        let sid: int32 = sourceIds[i]
        let st: int32 = runtime.promiseState[sid]
        var obj: jsrt.JsObject
        let objId: int32 = jsrt.jsObjectCount + 1
        jsrt.JsObjectInit(obj, objId, 0)
        var promiseObjTable: jsrt.JsObject[] = jsrt.jsObjectTable
        add(promiseObjTable, obj)
        jsrt.jsObjectTable = promiseObjTable
        jsrt.jsObjectCount = jsrt.jsObjectCount + 1
        var descriptor: jsrt.JsPropertyDescriptor
        jsrt.JsDescriptorInitData(descriptor, true, true, true)
        var statusVal: jsrt.JsValue
        if st == JsPromiseFulfilled:
            jsrt.JsValueInitString(statusVal, "fulfilled")
        else:
            jsrt.JsValueInitString(statusVal, "rejected")
        let objIndex: int32 = jsrt.jsObjectCount - 1
        jsrt.JsObjectDefineDataProperty(jsrt.jsObjectTable[objIndex], "status", statusVal, descriptor)
        if st == JsPromiseFulfilled:
            var val: jsrt.JsValue
            jsPromiseWriteValue(runtime, sid, val)
            jsrt.JsObjectDefineDataProperty(jsrt.jsObjectTable[objIndex], "value", val, descriptor)
        else:
            var reasonVal: jsrt.JsValue
            jsPromiseWriteReason(runtime, sid, reasonVal)
            jsrt.JsObjectDefineDataProperty(jsrt.jsObjectTable[objIndex], "reason", reasonVal, descriptor)
        var objVal: jsrt.JsValue
        jsrt.JsValueInitObject(objVal, objId)
        jsrt.jsArrayAddJsValue(resultsArr, objVal)
    let arrId: int32 = jsrt.jsRegisterArray(resultsArr)
    var resultVal: jsrt.JsValue
    jsrt.JsValueInitArray(resultVal, arrId)
    jsPromiseFulfill(runtime, resultPromiseId, resultVal, loop)
    return resultPromiseId
