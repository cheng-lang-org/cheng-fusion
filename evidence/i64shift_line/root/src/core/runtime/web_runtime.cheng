fn WebDocumentInit(document: var WebDocument) =
    document.nextNodeId = 1
    document.rootNodeId = 0
    document.headNodeId = 0
    document.bodyNodeId = 0
    document.hidden = false
    document.visibilityState = "visible"
    document.activeElementNodeId = 0
    document.hoverNodeId = 0
    document.activeNodeId = 0
    document.nodes = []
    document.nodeIndexById = []
    document.attributes = []
    document.attributeHeadByNodeId = []
    document.attributeNextIndex = []
    document.datasetEntries = []
    document.datasetHeadByNodeId = []
    document.datasetNextIndex = []
    document.inlineStyles = []
    document.inlineStyleHeadByNodeId = []
    document.inlineStyleNextIndex = []
    document.children = []
    document.parentByNodeId = []
    document.childCountByNodeId = []
    document.listeners = []
    document.dispatchTrace = []
    document.mutations = []
    document.boundingRects = []
    document.scrollTop = 0
    document.scrollLeft = 0
    document.formControls = []
    document.styleSheetCss = ""
    document.designMode = "off"
    document.nextAnimationId = 1
    document.animations = []
    var selectionInit: WebSelection
    selectionInit.anchorNodeId = 0
    selectionInit.anchorOffset = 0
    selectionInit.focusNodeId = 0
    selectionInit.focusOffset = 0
    selectionInit.isCollapsed = true
    document.selection = selectionInit

@borrows
fn WebAttributeClone(attribute: WebAttribute): WebAttribute =
    var out: WebAttribute
    out.nodeId = attribute.nodeId
    out.name = strings.CloneStr(attribute.name)
    out.value = strings.CloneStr(attribute.value)
    return out

@borrows
fn WebNodeClone(node: WebNode): WebNode =
    var out: WebNode
    out.nodeId = node.nodeId
    out.kind = node.kind
    out.tagName = strings.CloneStr(node.tagName)
    out.textContent = strings.CloneStr(node.textContent)
    return out

fn WebNodeInit(node: var WebNode, nodeId: int32, kind: int32, tagName: str, textContent: str) =
    node.nodeId = nodeId
    node.kind = kind
    node.tagName = tagName
    node.textContent = textContent

fn WebDocumentEnsureNodeIndexCapacity(document: var WebDocument, nodeId: int32) =
    while document.nodeIndexById.len <= nodeId:
        add(document.nodeIndexById, 0)
        add(document.attributeHeadByNodeId, -1)
        add(document.datasetHeadByNodeId, -1)
        add(document.inlineStyleHeadByNodeId, -1)
        add(document.parentByNodeId, 0)
        add(document.childCountByNodeId, 0)

fn WebDocumentAttributeHeadAt(document: var WebDocument, nodeId: int32): int32 =
    if nodeId < 0 || nodeId >= document.attributeHeadByNodeId.len:
        return -1
    return document.attributeHeadByNodeId[nodeId]

fn WebDocumentDatasetHeadAt(document: var WebDocument, nodeId: int32): int32 =
    if nodeId < 0 || nodeId >= document.datasetHeadByNodeId.len:
        return -1
    return document.datasetHeadByNodeId[nodeId]

fn WebDocumentInlineStyleHeadAt(document: var WebDocument, nodeId: int32): int32 =
    if nodeId < 0 || nodeId >= document.inlineStyleHeadByNodeId.len:
        return -1
    return document.inlineStyleHeadByNodeId[nodeId]

fn WebDocumentRegisterNodeIndex(document: var WebDocument, nodeId: int32, index: int32) =
    if nodeId < 0:
        return
    WebDocumentEnsureNodeIndexCapacity(document, nodeId)
    document.nodeIndexById[nodeId] = index + 1

fn WebDocumentRegisterAttributeIndex(document: var WebDocument, nodeId: int32, index: int32) =
    if nodeId < 0:
        return
    WebDocumentEnsureNodeIndexCapacity(document, nodeId)
    add(document.attributeNextIndex, document.attributeHeadByNodeId[nodeId])
    document.attributeHeadByNodeId[nodeId] = index

fn WebDocumentRegisterDatasetIndex(document: var WebDocument, nodeId: int32, index: int32) =
    if nodeId < 0:
        return
    WebDocumentEnsureNodeIndexCapacity(document, nodeId)
    add(document.datasetNextIndex, document.datasetHeadByNodeId[nodeId])
    document.datasetHeadByNodeId[nodeId] = index

fn WebDocumentRegisterInlineStyleIndex(document: var WebDocument, nodeId: int32, index: int32) =
    if nodeId < 0:
        return
    WebDocumentEnsureNodeIndexCapacity(document, nodeId)
    add(document.inlineStyleNextIndex, document.inlineStyleHeadByNodeId[nodeId])
    document.inlineStyleHeadByNodeId[nodeId] = index

fn WebDocumentRebuildIndexes(document: var WebDocument) =
    document.nodeIndexById = []
    document.attributeHeadByNodeId = []
    document.attributeNextIndex = []
    document.datasetHeadByNodeId = []
    document.datasetNextIndex = []
    document.inlineStyleHeadByNodeId = []
    document.inlineStyleNextIndex = []
    document.parentByNodeId = []
    document.childCountByNodeId = []
    for i in 0..<document.nodes.len:
        WebDocumentRegisterNodeIndex(document, document.nodes[i].nodeId, i)
    for i in 0..<document.attributes.len:
        WebDocumentRegisterAttributeIndex(document, document.attributes[i].nodeId, i)
    for i in 0..<document.datasetEntries.len:
        WebDocumentRegisterDatasetIndex(document, document.datasetEntries[i].nodeId, i)
    for i in 0..<document.inlineStyles.len:
        WebDocumentRegisterInlineStyleIndex(document, document.inlineStyles[i].nodeId, i)
    for i in 0..<document.children.len:
        let parentNodeId = document.children[i].parentNodeId
        let childNodeId = document.children[i].childNodeId
        WebDocumentEnsureNodeIndexCapacity(document, parentNodeId)
        WebDocumentEnsureNodeIndexCapacity(document, childNodeId)
        document.parentByNodeId[childNodeId] = parentNodeId
        document.childCountByNodeId[parentNodeId] = document.childCountByNodeId[parentNodeId] + 1

@borrows
fn WebDocumentRecordMutation(document: var WebDocument, kind: int32, nodeId: int32, name: str, value: str, parentNodeId: int32, childNodeId: int32) =
    var mutation: WebMutation
    mutation.kind = kind
    mutation.nodeId = nodeId
    mutation.name = name
    mutation.value = value
    mutation.parentNodeId = parentNodeId
    mutation.childNodeId = childNodeId
    add(document.mutations, mutation)

fn WebDocumentMutationCount(document: var WebDocument): int32 =
    return document.mutations.len

fn WebDocumentMutationKindAt(document: var WebDocument, index: int32): int32 =
    if index < 0:
        return 0
    if index >= document.mutations.len:
        return 0
    let mutation = document.mutations[index]
    return mutation.kind

fn WebDocumentMutationNameAt(document: var WebDocument, index: int32, out: var str): bool =
    if index < 0:
        out = ""
        return false
    if index >= document.mutations.len:
        out = ""
        return false
    let mutation = document.mutations[index]
    out = mutation.name
    return true

fn WebDocumentMutationValueAt(document: var WebDocument, index: int32, out: var str): bool =
    if index < 0:
        out = ""
        return false
    if index >= document.mutations.len:
        out = ""
        return false
    let mutation = document.mutations[index]
    out = mutation.value
    return true

fn WebDocumentMutationParentAt(document: var WebDocument, index: int32): int32 =
    if index < 0:
        return 0
    if index >= document.mutations.len:
        return 0
    let mutation = document.mutations[index]
    return mutation.parentNodeId

fn WebDocumentMutationChildAt(document: var WebDocument, index: int32): int32 =
    if index < 0:
        return 0
    if index >= document.mutations.len:
        return 0
    let mutation = document.mutations[index]
    return mutation.childNodeId

@borrows
fn WebDocumentCreateNode(document: var WebDocument, kind: int32, tagName: str, textContent: str): int32 =
    let nodeId = document.nextNodeId
    document.nextNodeId = document.nextNodeId + 1
    var node: WebNode
    WebNodeInit(node, nodeId, kind, strings.ConcatStr(tagName, ""), strings.ConcatStr(textContent, ""))
    add(document.nodes, node)
    WebDocumentRegisterNodeIndex(document, nodeId, document.nodes.len - 1)
    WebDocumentRecordMutation(document, WebMutationKindCreateNode, nodeId, tagName, textContent, 0, 0)
    return nodeId

fn WebDocumentCreateDocumentNode(document: var WebDocument): int32 =
    let nodeId = WebDocumentCreateNode(document, WebNodeKindDocument, "#document", "")
    document.rootNodeId = nodeId
    return nodeId

@borrows
fn WebDocumentCreateElement(document: var WebDocument, tagName: str): int32 =
    return WebDocumentCreateNode(document, WebNodeKindElement, tagName, "")

fn WebDocumentCreateText(document: var WebDocument, textContent: str): int32 =
    return WebDocumentCreateNode(document, WebNodeKindText, "#text", textContent)

// ──────────────────────────────────────
// HTML Semantic Element convenience functions
// ──────────────────────────────────────

fn WebDocumentCreateTable(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "table")

fn WebDocumentCreateTableBody(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "tbody")

fn WebDocumentCreateTableRow(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "tr")

fn WebDocumentCreateTableHeader(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "th")

fn WebDocumentCreateTableCell(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "td")

fn WebDocumentCreateTableHead(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "thead")

fn WebDocumentCreateTableFoot(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "tfoot")

fn WebDocumentCreateTableCaption(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "caption")

fn WebDocumentTableAppendRow(document: var WebDocument, tableId: int32, rowId: int32): bool =
    if !WebDocumentNodeExists(document, tableId):
        return false
    if !WebDocumentNodeExists(document, rowId):
        return false
    if WebDocumentNodeKind(document, tableId) != WebNodeKindElement:
        return false
    var tagName: str
    if !WebDocumentNodeTagName(document, tableId, tagName):
        return false
    if tagName != "table":
        return false
    // Find or create tbody
    var tbodyId: int32
    let childCount = WebDocumentChildCount(document, tableId)
    for i in 0..<childCount:
        let childId = WebDocumentChildAt(document, tableId, i)
        var childTag: str
        if WebDocumentNodeTagName(document, childId, childTag) && childTag == "tbody":
            tbodyId = childId
            break
    if tbodyId == 0:
        tbodyId = WebDocumentCreateElement(document, "tbody")
        if !WebDocumentAppendChild(document, tableId, tbodyId):
            return false
    return WebDocumentAppendChild(document, tbodyId, rowId)

fn WebDocumentCreateList(document: var WebDocument, ordered: bool): int32 =
    if ordered:
        return WebDocumentCreateElement(document, "ol")
    return WebDocumentCreateElement(document, "ul")

fn WebDocumentCreateListItem(document: var WebDocument): int32 =
    return WebDocumentCreateElement(document, "li")

fn WebDocumentCreateImage(document: var WebDocument, src: str, alt: str): int32 =
    let id = WebDocumentCreateElement(document, "img")
    if src.len > 0:
        WebDocumentSetAttribute(document, id, "src", src)
    if alt.len > 0:
        WebDocumentSetAttribute(document, id, "alt", alt)
    return id

fn WebDocumentCreateAnchor(document: var WebDocument, href: str, target: str): int32 =
    let id = WebDocumentCreateElement(document, "a")
    if href.len > 0:
        WebDocumentSetAttribute(document, id, "href", href)
    if target.len > 0:
        WebDocumentSetAttribute(document, id, "target", target)
    return id

fn WebDocumentCloneNode(document: var WebDocument, nodeId: int32, deep: bool): int32 =
    let srcIndex = WebDocumentFindNodeIndex(document, nodeId)
    if srcIndex < 0:
        return 0
    let kind = document.nodes[srcIndex].kind
    if kind != WebNodeKindElement && kind != WebNodeKindText:
        return 0
    let newNodeId = WebDocumentCreateNode(document, kind, document.nodes[srcIndex].tagName, document.nodes[srcIndex].textContent)
    if kind == WebNodeKindElement:
        var i = WebDocumentAttributeHeadAt(document, nodeId)
        while i >= 0:
            if document.attributes[i].nodeId == nodeId:
                WebDocumentSetAttribute(document, newNodeId, document.attributes[i].name, document.attributes[i].value)
            i = document.attributeNextIndex[i]
    if deep:
        let childCount = WebDocumentChildCount(document, nodeId)
        for i in 0..<childCount:
            let childId = WebDocumentChildAt(document, nodeId, i)
            let clonedChildId = WebDocumentCloneNode(document, childId, true)
            if clonedChildId != 0:
                WebDocumentAppendChild(document, newNodeId, clonedChildId)
    return newNodeId

fn WebDocumentIsHeadElement(document: var WebDocument, nodeId: int32): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var tagName: str
    if !WebDocumentNodeTagName(document, nodeId, tagName):
        return false
    return tagName == "head"

fn WebDocumentIsBodyElement(document: var WebDocument, nodeId: int32): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var tagName: str
    if !WebDocumentNodeTagName(document, nodeId, tagName):
        return false
    return tagName == "body"

fn WebDocumentFindHeadUnderRoot(document: var WebDocument, rootNodeId: int32): int32 =
    let childCount = WebDocumentChildCount(document, rootNodeId)
    for i in 0..<childCount:
        let childNodeId = WebDocumentChildAt(document, rootNodeId, i)
        if WebDocumentIsHeadElement(document, childNodeId):
            return childNodeId
    return 0

fn WebDocumentFindBodyUnderRoot(document: var WebDocument, rootNodeId: int32): int32 =
    let childCount = WebDocumentChildCount(document, rootNodeId)
    for i in 0..<childCount:
        let childNodeId = WebDocumentChildAt(document, rootNodeId, i)
        if WebDocumentIsBodyElement(document, childNodeId):
            return childNodeId
    return 0

fn WebDocumentFindDocumentElement(document: var WebDocument): int32 =
    let rootNodeId = document.rootNodeId
    if rootNodeId == 0:
        return 0
    let childCount = WebDocumentChildCount(document, rootNodeId)
    for i in 0..<childCount:
        let childNodeId = WebDocumentChildAt(document, rootNodeId, i)
        if WebDocumentNodeKind(document, childNodeId) == WebNodeKindElement:
            var tagName: str
            if WebDocumentNodeTagName(document, childNodeId, tagName) && tagName == "html":
                return childNodeId
    return 0

fn WebDocumentEnsureDocumentElement(document: var WebDocument, outElementNodeId: var int32): bool =
    var rootNodeId = document.rootNodeId
    if rootNodeId == 0:
        rootNodeId = WebDocumentCreateDocumentNode(document)
    if !WebDocumentNodeExists(document, rootNodeId):
        outElementNodeId = 0
        return false
    let existingElementNodeId = WebDocumentFindDocumentElement(document)
    if existingElementNodeId != 0:
        outElementNodeId = existingElementNodeId
        return true
    let elementNodeId = WebDocumentCreateElement(document, "html")
    if !WebDocumentAppendChild(document, rootNodeId, elementNodeId):
        outElementNodeId = 0
        return false
    outElementNodeId = elementNodeId
    return true

fn WebDocumentEnsureHead(document: var WebDocument, outHeadNodeId: var int32): bool =
    if document.headNodeId != 0:
        if WebDocumentNodeExists(document, document.headNodeId) &&
           WebDocumentIsHeadElement(document, document.headNodeId) &&
           WebDocumentParentOf(document, document.headNodeId) != 0:
            outHeadNodeId = document.headNodeId
            return true
        outHeadNodeId = 0
        return false
    var rootNodeId = document.rootNodeId
    if rootNodeId == 0:
        rootNodeId = WebDocumentCreateDocumentNode(document)
    if !WebDocumentNodeExists(document, rootNodeId):
        outHeadNodeId = 0
        return false
    let existingHeadNodeId = WebDocumentFindHeadUnderRoot(document, rootNodeId)
    if existingHeadNodeId != 0:
        document.headNodeId = existingHeadNodeId
        outHeadNodeId = existingHeadNodeId
        return true
    let headNodeId = WebDocumentCreateElement(document, "head")
    if !WebDocumentAppendChild(document, rootNodeId, headNodeId):
        outHeadNodeId = 0
        return false
    document.headNodeId = headNodeId
    outHeadNodeId = headNodeId
    return true

fn WebDocumentEnsureBody(document: var WebDocument, outBodyNodeId: var int32): bool =
    if document.bodyNodeId != 0:
        if WebDocumentNodeExists(document, document.bodyNodeId) &&
           WebDocumentIsBodyElement(document, document.bodyNodeId) &&
           WebDocumentParentOf(document, document.bodyNodeId) != 0:
            outBodyNodeId = document.bodyNodeId
            return true
        outBodyNodeId = 0
        return false
    var rootNodeId = document.rootNodeId
    if rootNodeId == 0:
        rootNodeId = WebDocumentCreateDocumentNode(document)
    if !WebDocumentNodeExists(document, rootNodeId):
        outBodyNodeId = 0
        return false
    let existingBodyNodeId = WebDocumentFindBodyUnderRoot(document, rootNodeId)
    if existingBodyNodeId != 0:
        document.bodyNodeId = existingBodyNodeId
        outBodyNodeId = existingBodyNodeId
        return true
    let bodyNodeId = WebDocumentCreateElement(document, "body")
    if !WebDocumentAppendChild(document, rootNodeId, bodyNodeId):
        outBodyNodeId = 0
        return false
    document.bodyNodeId = bodyNodeId
    outBodyNodeId = bodyNodeId
    return true

fn WebDocumentNodeCount(document: var WebDocument): int32 =
    return document.nodes.len

fn WebDocumentNodeIdAt(document: var WebDocument, index: int32): int32 =
    if index < 0 || index >= document.nodes.len:
        return 0
    return document.nodes[index].nodeId

fn WebDocumentFindNodeIndex(document: var WebDocument, nodeId: int32): int32 =
    if nodeId >= 0 && nodeId < document.nodeIndexById.len:
        let encodedIndex = document.nodeIndexById[nodeId]
        if encodedIndex > 0:
            let index = encodedIndex - 1
            if index >= 0 && index < document.nodes.len && document.nodes[index].nodeId == nodeId:
                return index
            return -1
    for i in 0..<document.nodes.len:
        if document.nodes[i].nodeId == nodeId:
            return i
    return -1

fn WebDocumentNodeExists(document: var WebDocument, nodeId: int32): bool =
    return WebDocumentFindNodeIndex(document, nodeId) >= 0

fn WebDocumentNodeConnected(document: var WebDocument, nodeId: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    var current = nodeId
    var steps = 0
    while current != 0:
        if current == document.rootNodeId:
            return true
        steps = steps + 1
        if steps > document.nodes.len:
            return false
        current = WebDocumentParentOf(document, current)
    return false

fn WebDocumentNodeKind(document: var WebDocument, nodeId: int32): int32 =
    let index = WebDocumentFindNodeIndex(document, nodeId)
    if index < 0:
        return 0
    return document.nodes[index].kind

fn WebDocumentNodeTagName(document: var WebDocument, nodeId: int32, out: var str): bool =
    let index = WebDocumentFindNodeIndex(document, nodeId)
    if index < 0:
        out = ""
        return false
    out = document.nodes[index].tagName
    return true

fn WebDocumentNodeTextContent(document: var WebDocument, nodeId: int32, out: var str): bool =
    let index = WebDocumentFindNodeIndex(document, nodeId)
    if index < 0:
        out = ""
        return false
    out = document.nodes[index].textContent
    return true

fn WebDocumentNodeType(document: var WebDocument, nodeId: int32): int32 =
    let kind = WebDocumentNodeKind(document, nodeId)
    if kind == WebNodeKindDocument:
        return 9
    if kind == WebNodeKindElement:
        return 1
    if kind == WebNodeKindText:
        return 3
    return 0

fn WebDocumentNodeName(document: var WebDocument, nodeId: int32, out: var str): bool =
    let index = WebDocumentFindNodeIndex(document, nodeId)
    if index < 0:
        out = ""
        return false
    let kind = document.nodes[index].kind
    if kind == WebNodeKindElement:
        out = document.nodes[index].tagName
        return true
    if kind == WebNodeKindText:
        out = "#text"
        return true
    if kind == WebNodeKindDocument:
        out = "#document"
        return true
    out = ""
    return false

@borrows
fn WebDocumentSetTextContent(document: var WebDocument, nodeId: int32, textContent: str): bool =
    let index = WebDocumentFindNodeIndex(document, nodeId)
    if index < 0:
        return false
    if document.nodes[index].kind != WebNodeKindText:
        return false
    document.nodes[index].textContent = textContent
    # Accumulate styleSheetCss if parent is a <style> element
    let parentNodeId = WebDocumentParentOf(document, nodeId)
    if parentNodeId != 0:
        var parentTag: str
        if WebDocumentNodeTagName(document, parentNodeId, parentTag) && parentTag == "style":
            document.styleSheetCss = Fmt"{document.styleSheetCss}{textContent}"
    WebDocumentRecordMutation(document, WebMutationKindSetTextContent, nodeId, "textContent", textContent, 0, 0)
    return true

fn WebDocumentChildCount(document: var WebDocument, parentNodeId: int32): int32 =
    if parentNodeId >= 0 && parentNodeId < document.childCountByNodeId.len:
        return document.childCountByNodeId[parentNodeId]
    var count = 0
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == parentNodeId:
            count = count + 1
    return count

fn WebDocumentAppendChild(document: var WebDocument, parentNodeId: int32, childNodeId: int32): bool =
    if !WebDocumentNodeExists(document, parentNodeId):
        return false
    if !WebDocumentNodeExists(document, childNodeId):
        return false
    if parentNodeId == childNodeId:
        return false
    if WebDocumentParentOf(document, childNodeId) != 0:
        return false
    if WebDocumentIsAncestorOf(document, childNodeId, parentNodeId):
        return false
    var edge: WebChildEdge
    edge.parentNodeId = parentNodeId
    edge.childNodeId = childNodeId
    edge.ordinal = WebDocumentChildCount(document, parentNodeId)
    add(document.children, edge)
    WebDocumentEnsureNodeIndexCapacity(document, parentNodeId)
    WebDocumentEnsureNodeIndexCapacity(document, childNodeId)
    document.parentByNodeId[childNodeId] = parentNodeId
    document.childCountByNodeId[parentNodeId] = document.childCountByNodeId[parentNodeId] + 1
    # Accumulate styleSheetCss if appending a Text child to a <style> element
    if WebDocumentNodeKind(document, parentNodeId) == WebNodeKindElement:
        var parentTag: str
        if WebDocumentNodeTagName(document, parentNodeId, parentTag) && parentTag == "style":
            let childIndex = WebDocumentFindNodeIndex(document, childNodeId)
            if childIndex >= 0 && document.nodes[childIndex].kind == WebNodeKindText:
                document.styleSheetCss = Fmt"{document.styleSheetCss}{document.nodes[childIndex].textContent}"
    WebDocumentRecordMutation(document, WebMutationKindAppendChild, 0, "", "", parentNodeId, childNodeId)
    return true

fn WebDocumentRemoveChild(document: var WebDocument, parentNodeId: int32, childNodeId: int32): bool =
    if !WebDocumentNodeExists(document, parentNodeId):
        return false
    if !WebDocumentNodeExists(document, childNodeId):
        return false
    if WebDocumentParentOf(document, childNodeId) != parentNodeId:
        return false
    var removedOrdinal = -1
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == parentNodeId && document.children[i].childNodeId == childNodeId:
            removedOrdinal = document.children[i].ordinal
            break
    if removedOrdinal < 0:
        return false
    if document.activeElementNodeId != 0 && WebDocumentContains(document, childNodeId, document.activeElementNodeId):
        document.activeElementNodeId = 0
    var newChildren: WebChildEdge[]
    for i in 0..<document.children.len:
        let edge = document.children[i]
        if edge.parentNodeId == parentNodeId && edge.childNodeId == childNodeId:
            continue
        if edge.parentNodeId == parentNodeId && edge.ordinal > removedOrdinal:
            var adjusted = edge
            adjusted.ordinal = adjusted.ordinal - 1
            add(newChildren, adjusted)
        else:
            add(newChildren, edge)
    document.children = newChildren
    if childNodeId >= 0 && childNodeId < document.parentByNodeId.len:
        document.parentByNodeId[childNodeId] = 0
    if parentNodeId >= 0 && parentNodeId < document.childCountByNodeId.len && document.childCountByNodeId[parentNodeId] > 0:
        document.childCountByNodeId[parentNodeId] = document.childCountByNodeId[parentNodeId] - 1
    if document.bodyNodeId == childNodeId:
        document.bodyNodeId = 0
    if document.headNodeId == childNodeId:
        document.headNodeId = 0
    WebDocumentRecordMutation(document, WebMutationKindRemoveChild, 0, "", "", parentNodeId, childNodeId)
    return true

fn WebDocumentInsertBefore(document: var WebDocument, parentNodeId: int32, childNodeId: int32, refNodeId: int32): bool =
    if !WebDocumentNodeExists(document, parentNodeId):
        return false
    if !WebDocumentNodeExists(document, childNodeId):
        return false
    if parentNodeId == childNodeId:
        return false
    if refNodeId != 0 && !WebDocumentNodeExists(document, refNodeId):
        return false
    if refNodeId != 0 && WebDocumentParentOf(document, refNodeId) != parentNodeId:
        return false
    if WebDocumentParentOf(document, childNodeId) != 0:
        return false
    if WebDocumentIsAncestorOf(document, childNodeId, parentNodeId):
        return false
    if refNodeId == 0:
        return WebDocumentAppendChild(document, parentNodeId, childNodeId)
    var refOrdinal = -1
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == parentNodeId && document.children[i].childNodeId == refNodeId:
            refOrdinal = document.children[i].ordinal
            break
    if refOrdinal < 0:
        return false
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == parentNodeId && document.children[i].ordinal >= refOrdinal:
            document.children[i].ordinal = document.children[i].ordinal + 1
    var edge: WebChildEdge
    edge.parentNodeId = parentNodeId
    edge.childNodeId = childNodeId
    edge.ordinal = refOrdinal
    add(document.children, edge)
    WebDocumentEnsureNodeIndexCapacity(document, parentNodeId)
    WebDocumentEnsureNodeIndexCapacity(document, childNodeId)
    document.parentByNodeId[childNodeId] = parentNodeId
    document.childCountByNodeId[parentNodeId] = document.childCountByNodeId[parentNodeId] + 1
    WebDocumentRecordMutation(document, WebMutationKindInsertBefore, 0, "", "", parentNodeId, childNodeId)
    return true

fn WebDocumentInsertAdjacentHTML(document: var WebDocument, nodeId: int32, position: str, html: str): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    if html.len <= 0 || html[0] != '<':
        return false
    # Phase 1: scan all positions from html using only index access
    # NOTE: cold_subset compiler aliases vars initialized from each other,
    # so we compute openClose independently to avoid corrupting tagEnd.
    var tagEnd: int32 = 1
    while tagEnd < html.len && html[tagEnd] != '>' && html[tagEnd] != ' ' && html[tagEnd] != '/':
        tagEnd = tagEnd + 1
    if tagEnd >= html.len:
        return false
    var openClose: int32 = 1
    while openClose < html.len && html[openClose] != '>':
        openClose = openClose + 1
    if openClose >= html.len:
        return false
    let selfClosing = html[openClose - 1] == '/'
    var textStart: int32
    var textEnd: int32
    if !selfClosing:
        textStart = openClose + 1
        if textStart < html.len:
            textEnd = textStart
            while textEnd < html.len && html[textEnd] != '<':
                textEnd = textEnd + 1
    # Phase 2: extract substrings (textContent first, since SliceBytes may corrupt source)
    var textContent: str
    if !selfClosing && textEnd > textStart:
        textContent = strings.SliceBytes(html, textStart, textEnd - textStart)
    let tagName = strings.SliceBytes(html, 1, tagEnd - 1)
    if tagName.len <= 0:
        return false
    let elementId = WebDocumentCreateElement(document, tagName)
    if textContent.len > 0:
        let textId = WebDocumentCreateText(document, textContent)
        WebDocumentAppendChild(document, elementId, textId)
    if position == "beforebegin":
        let parentId = WebDocumentParentOf(document, nodeId)
        if parentId == 0:
            return false
        return WebDocumentInsertBefore(document, parentId, elementId, nodeId)
    elif position == "afterbegin":
        let firstChildId = WebDocumentChildAt(document, nodeId, 0)
        if firstChildId == 0:
            return WebDocumentAppendChild(document, nodeId, elementId)
        return WebDocumentInsertBefore(document, nodeId, elementId, firstChildId)
    elif position == "beforeend":
        return WebDocumentAppendChild(document, nodeId, elementId)
    elif position == "afterend":
        let parentId = WebDocumentParentOf(document, nodeId)
        if parentId == 0:
            return false
        var nodeOrdinal: int32 = -1
        for ci in 0..<document.children.len:
            if document.children[ci].parentNodeId == parentId && document.children[ci].childNodeId == nodeId:
                nodeOrdinal = document.children[ci].ordinal
                break
        if nodeOrdinal < 0:
            return false
        let childCount = WebDocumentChildCount(document, parentId)
        let nextOrdinal = nodeOrdinal + 1
        if nextOrdinal < childCount:
            let nextSibling = WebDocumentChildAt(document, parentId, nextOrdinal)
            return WebDocumentInsertBefore(document, parentId, elementId, nextSibling)
        return WebDocumentAppendChild(document, parentId, elementId)
    return false

fn WebDocumentReplaceChild(document: var WebDocument, parentNodeId: int32, newChildNodeId: int32, oldChildNodeId: int32): bool =
    if !WebDocumentNodeExists(document, parentNodeId):
        return false
    if !WebDocumentNodeExists(document, newChildNodeId):
        return false
    if !WebDocumentNodeExists(document, oldChildNodeId):
        return false
    if parentNodeId == newChildNodeId || parentNodeId == oldChildNodeId:
        return false
    if WebDocumentParentOf(document, oldChildNodeId) != parentNodeId:
        return false
    if newChildNodeId == oldChildNodeId:
        return false
    if WebDocumentParentOf(document, newChildNodeId) != 0:
        return false
    if WebDocumentIsAncestorOf(document, newChildNodeId, parentNodeId):
        return false
    if document.activeElementNodeId != 0 && WebDocumentContains(document, oldChildNodeId, document.activeElementNodeId):
        document.activeElementNodeId = 0
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == parentNodeId && document.children[i].childNodeId == oldChildNodeId:
            document.children[i].childNodeId = newChildNodeId
            WebDocumentEnsureNodeIndexCapacity(document, parentNodeId)
            WebDocumentEnsureNodeIndexCapacity(document, newChildNodeId)
            if oldChildNodeId >= 0 && oldChildNodeId < document.parentByNodeId.len:
                document.parentByNodeId[oldChildNodeId] = 0
            document.parentByNodeId[newChildNodeId] = parentNodeId
            if document.bodyNodeId == oldChildNodeId:
                document.bodyNodeId = WebDocumentIsBodyElement(document, newChildNodeId) ? newChildNodeId : 0
                if document.headNodeId == newChildNodeId:
                    document.headNodeId = 0
            if document.headNodeId == oldChildNodeId:
                document.headNodeId = WebDocumentIsHeadElement(document, newChildNodeId) ? newChildNodeId : 0
                if document.bodyNodeId == newChildNodeId:
                    document.bodyNodeId = 0
            WebDocumentRecordMutation(document, WebMutationKindReplaceChild, 0, "", "", parentNodeId, newChildNodeId)
            return true
    return false

fn WebDocumentChildAt(document: var WebDocument, parentNodeId: int32, ordinal: int32): int32 =
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == parentNodeId && document.children[i].ordinal == ordinal:
            return document.children[i].childNodeId
    return 0

fn WebDocumentParentOf(document: var WebDocument, childNodeId: int32): int32 =
    if childNodeId >= 0 && childNodeId < document.parentByNodeId.len:
        return document.parentByNodeId[childNodeId]
    for i in 0..<document.children.len:
        if document.children[i].childNodeId == childNodeId:
            return document.children[i].parentNodeId
    return 0

fn WebDocumentRemoveNode(document: var WebDocument, nodeId: int32): bool =
    let parentNodeId = WebDocumentParentOf(document, nodeId)
    if parentNodeId == 0:
        return false
    return WebDocumentRemoveChild(document, parentNodeId, nodeId)

fn WebDocumentRemove(document: var WebDocument, nodeId: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    let parentId = WebDocumentParentOf(document, nodeId)
    if parentId == 0:
        return false
    if !WebDocumentRemoveChild(document, parentId, nodeId):
        return false
    var newNodes: WebNode[]
    for i in 0..<document.nodes.len:
        if document.nodes[i].nodeId != nodeId:
            let clonedNode: WebNode = WebNodeClone(document.nodes[i])
            add(newNodes, clonedNode)
    document.nodes = newNodes
    var newAttributes: WebAttribute[]
    for i in 0..<document.attributes.len:
        if document.attributes[i].nodeId != nodeId:
            let clonedAttr: WebAttribute = WebAttributeClone(document.attributes[i])
            add(newAttributes, clonedAttr)
    document.attributes = newAttributes
    var newDataset: WebDatasetEntry[]
    for i in 0..<document.datasetEntries.len:
        if document.datasetEntries[i].nodeId != nodeId:
            add(newDataset, share(document.datasetEntries[i]))
    document.datasetEntries = newDataset
    var newInlineStyles: WebInlineStyleEntry[]
    for i in 0..<document.inlineStyles.len:
        if document.inlineStyles[i].nodeId != nodeId:
            add(newInlineStyles, share(document.inlineStyles[i]))
    document.inlineStyles = newInlineStyles
    WebDocumentRebuildIndexes(document)
    return true

fn WebDocumentReplaceWith(document: var WebDocument, oldNodeId: int32, newNodeId: int32): bool =
    if !WebDocumentNodeExists(document, oldNodeId):
        return false
    let parentId = WebDocumentParentOf(document, oldNodeId)
    if parentId == 0:
        return false
    return WebDocumentReplaceChild(document, parentId, newNodeId, oldNodeId)

fn WebDocumentBefore(document: var WebDocument, nodeId: int32, newNodeId: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    if !WebDocumentNodeExists(document, newNodeId):
        return false
    let parentId = WebDocumentParentOf(document, nodeId)
    if parentId == 0:
        return false
    return WebDocumentInsertBefore(document, parentId, newNodeId, nodeId)

fn WebDocumentAfter(document: var WebDocument, nodeId: int32, newNodeId: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    if !WebDocumentNodeExists(document, newNodeId):
        return false
    let parentId = WebDocumentParentOf(document, nodeId)
    if parentId == 0:
        return false
    let childCount = WebDocumentChildCount(document, parentId)
    var nodeOrdinal: int32 = -1
    for i in 0..<childCount:
        if WebDocumentChildAt(document, parentId, i) == nodeId:
            nodeOrdinal = i
            break
    if nodeOrdinal < 0:
        return false
    if nodeOrdinal + 1 < childCount:
        let nextSibling = WebDocumentChildAt(document, parentId, nodeOrdinal + 1)
        return WebDocumentInsertBefore(document, parentId, newNodeId, nextSibling)
    return WebDocumentAppendChild(document, parentId, newNodeId)

fn WebDocumentPrepend(document: var WebDocument, parentNodeId: int32, newNodeId: int32): bool =
    if !WebDocumentNodeExists(document, parentNodeId):
        return false
    if !WebDocumentNodeExists(document, newNodeId):
        return false
    let firstChildId = WebDocumentChildAt(document, parentNodeId, 0)
    if firstChildId == 0:
        return WebDocumentAppendChild(document, parentNodeId, newNodeId)
    return WebDocumentInsertBefore(document, parentNodeId, newNodeId, firstChildId)

fn WebDocumentAppend(document: var WebDocument, parentNodeId: int32, newNodeId: int32): bool =
    return WebDocumentAppendChild(document, parentNodeId, newNodeId)

fn WebDocumentReplaceChildren(document: var WebDocument, parentNodeId: int32, newChildren: int32[]): bool =
    if !WebDocumentNodeExists(document, parentNodeId):
        return false
    # Remove all existing children
    var childIds: int32[]
    let childCount = WebDocumentChildCount(document, parentNodeId)
    for i in 0..<childCount:
        let childId = WebDocumentChildAt(document, parentNodeId, i)
        add(childIds, childId)
    for i in 0..<childIds.len:
        if !WebDocumentRemoveChild(document, parentNodeId, childIds[i]):
            return false
    # Add new children
    for i in 0..<newChildren.len:
        if !WebDocumentAppendChild(document, parentNodeId, newChildren[i]):
            return false
    return true

fn WebDocumentIsAncestorOf(document: var WebDocument, ancestorNodeId: int32, nodeId: int32): bool =
    if ancestorNodeId == 0 || nodeId == 0:
        return false
    var current = WebDocumentParentOf(document, nodeId)
    var steps = 0
    while current != 0:
        if current == ancestorNodeId:
            return true
        steps = steps + 1
        if steps > document.nodes.len:
            return true
        current = WebDocumentParentOf(document, current)
    return false

fn WebDocumentContains(document: var WebDocument, nodeId: int32, otherNodeId: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    if !WebDocumentNodeExists(document, otherNodeId):
        return false
    if nodeId == otherNodeId:
        return true
    return WebDocumentIsAncestorOf(document, nodeId, otherNodeId)

fn WebDocumentCompareDocumentPosition(document: var WebDocument, nodeId: int32, otherNodeId: int32): int32 =
    if !WebDocumentNodeExists(document, nodeId) || !WebDocumentNodeExists(document, otherNodeId):
        return DOCUMENT_POSITION_DISCONNECTED
    if nodeId == otherNodeId:
        return 0
    if WebDocumentIsAncestorOf(document, nodeId, otherNodeId):
        return DOCUMENT_POSITION_CONTAINS | DOCUMENT_POSITION_PRECEDING
    if WebDocumentIsAncestorOf(document, otherNodeId, nodeId):
        return DOCUMENT_POSITION_CONTAINED_BY | DOCUMENT_POSITION_FOLLOWING
    var ancestorsA: int32[]
    var current = nodeId
    while current != 0:
        add(ancestorsA, current)
        current = WebDocumentParentOf(document, current)
    var ancestorsB: int32[]
    current = otherNodeId
    while current != 0:
        add(ancestorsB, current)
        current = WebDocumentParentOf(document, current)
    if ancestorsA.len == 0 || ancestorsB.len == 0 || ancestorsA[ancestorsA.len - 1] != ancestorsB[ancestorsB.len - 1]:
        return DOCUMENT_POSITION_DISCONNECTED | DOCUMENT_POSITION_PRECEDING
    var aIdx = ancestorsA.len - 1
    var bIdx = ancestorsB.len - 1
    while aIdx >= 0 && bIdx >= 0 && ancestorsA[aIdx] == ancestorsB[bIdx]:
        aIdx = aIdx - 1
        bIdx = bIdx - 1
    let lca = ancestorsA[aIdx + 1]
    let childA = ancestorsA[aIdx]
    let childB = ancestorsB[bIdx]
    var ordinalA: int32 = -1
    var ordinalB: int32 = -1
    for i in 0..<document.children.len:
        if document.children[i].parentNodeId == lca:
            if document.children[i].childNodeId == childA:
                ordinalA = document.children[i].ordinal
            if document.children[i].childNodeId == childB:
                ordinalB = document.children[i].ordinal
    if ordinalA < ordinalB:
        return DOCUMENT_POSITION_PRECEDING
    return DOCUMENT_POSITION_FOLLOWING

@borrows
fn WebDocumentSetAttribute(document: var WebDocument, nodeId: int32, name: str, value: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var i = WebDocumentAttributeHeadAt(document, nodeId)
    while i >= 0:
        if document.attributes[i].nodeId == nodeId && document.attributes[i].name == name:
            document.attributes[i].value = strings.ConcatStr(value, "")
            WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, name, value, 0, 0)
            return true
        i = document.attributeNextIndex[i]
    var attribute: WebAttribute
    attribute.nodeId = nodeId
    attribute.name = strings.ConcatStr(name, "")
    attribute.value = strings.ConcatStr(value, "")
    add(document.attributes, attribute)
    WebDocumentRegisterAttributeIndex(document, nodeId, document.attributes.len - 1)
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, name, value, 0, 0)
    return true

@borrows
fn WebDocumentGetAttribute(document: var WebDocument, nodeId: int32, name: str, out: var str): bool =
    var i = WebDocumentAttributeHeadAt(document, nodeId)
    while i >= 0:
        if document.attributes[i].nodeId == nodeId && document.attributes[i].name == name:
            out = document.attributes[i].value
            return true
        i = document.attributeNextIndex[i]
    var datasetIndex = WebDocumentDatasetHeadAt(document, nodeId)
    while datasetIndex >= 0:
        if document.datasetEntries[datasetIndex].nodeId == nodeId &&
           WebDatasetAttributeNameMatchesProperty(name, document.datasetEntries[datasetIndex].name):
            out = document.datasetEntries[datasetIndex].value
            return true
        datasetIndex = document.datasetNextIndex[datasetIndex]
    out = ""
    return false


fn WebDocumentHasAttribute(document: var WebDocument, nodeId: int32, name: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var i = WebDocumentAttributeHeadAt(document, nodeId)
    while i >= 0:
        if document.attributes[i].nodeId == nodeId && document.attributes[i].name == name:
            return true
        i = document.attributeNextIndex[i]
    var datasetIndex = WebDocumentDatasetHeadAt(document, nodeId)
    while datasetIndex >= 0:
        if document.datasetEntries[datasetIndex].nodeId == nodeId &&
           WebDatasetAttributeNameMatchesProperty(name, document.datasetEntries[datasetIndex].name):
            return true
        datasetIndex = document.datasetNextIndex[datasetIndex]
    return false

fn WebDocumentRemoveAttribute(document: var WebDocument, nodeId: int32, name: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var removed = false
    var kept: WebAttribute[]
    for i in 0..<document.attributes.len:
        if document.attributes[i].nodeId == nodeId && document.attributes[i].name == name:
            removed = true
            continue
        add(kept, share(document.attributes[i]))
    document.attributes = kept
    var keptDataset: WebDatasetEntry[]
    for i in 0..<document.datasetEntries.len:
        if document.datasetEntries[i].nodeId == nodeId &&
           WebDatasetAttributeNameMatchesProperty(name, document.datasetEntries[i].name):
            removed = true
            continue
        add(keptDataset, share(document.datasetEntries[i]))
    document.datasetEntries = keptDataset
    WebDocumentRebuildIndexes(document)
    if !removed:
        return false
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, name, "", 0, 0)
    return true

fn WebDatasetPropertyNameCharUpper(ch: char): bool =
    return ch >= 'A' && ch <= 'Z'

fn WebDatasetPropertyNameCharAllowed(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '_'

@borrows
fn WebDatasetPropertyNameValid(name: str): bool =
    if name.len <= 0:
        return false
    for i in 0..<name.len:
        let ch = name[i]
        if !WebDatasetPropertyNameCharUpper(ch) && !WebDatasetPropertyNameCharAllowed(ch):
            return false
    return true

fn WebDatasetLowerAscii(ch: char): char =
    if WebDatasetPropertyNameCharUpper(ch):
        return Char(Int32(ch) + 32)
    return ch

@borrows
fn WebDatasetAttributeNameMatchesProperty(attributeName: str, propertyName: str): bool =
    if !WebDatasetPropertyNameValid(propertyName):
        return false
    if attributeName.len < 6:
        return false
    if attributeName[0] != 'd' || attributeName[1] != 'a' || attributeName[2] != 't' || attributeName[3] != 'a' || attributeName[4] != '-':
        return false
    var attrIndex: int32 = 5
    for propIndex in 0..<propertyName.len:
        let ch = propertyName[propIndex]
        if WebDatasetPropertyNameCharUpper(ch):
            if attrIndex + 1 >= attributeName.len:
                return false
            if attributeName[attrIndex] != '-' || attributeName[attrIndex + 1] != WebDatasetLowerAscii(ch):
                return false
            attrIndex = attrIndex + 2
        else:
            if attrIndex >= attributeName.len:
                return false
            if attributeName[attrIndex] != ch:
                return false
            attrIndex = attrIndex + 1
    return attrIndex == attributeName.len

fn WebDocumentSetDatasetValue(document: var WebDocument, nodeId: int32, name: str, value: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    if !WebDatasetPropertyNameValid(name):
        return false
    var i = WebDocumentDatasetHeadAt(document, nodeId)
    while i >= 0:
        if document.datasetEntries[i].nodeId == nodeId && document.datasetEntries[i].name == name:
            document.datasetEntries[i].value = strings.CloneStr(value)
            WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "dataset", value, 0, 0)
            return true
        i = document.datasetNextIndex[i]
    var entry: WebDatasetEntry
    entry.nodeId = nodeId
    entry.name = name
    entry.value = strings.CloneStr(value)
    add(document.datasetEntries, entry)
    WebDocumentRegisterDatasetIndex(document, nodeId, document.datasetEntries.len - 1)
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "dataset", value, 0, 0)
    return true

@borrows
fn WebDocumentGetDatasetValue(document: var WebDocument, nodeId: int32, name: str, out: var str): bool =
    if !WebDatasetPropertyNameValid(name):
        out = ""
        return false
    var i = WebDocumentDatasetHeadAt(document, nodeId)
    while i >= 0:
        if document.datasetEntries[i].nodeId == nodeId && document.datasetEntries[i].name == name:
            out = document.datasetEntries[i].value
            return true
        i = document.datasetNextIndex[i]
    var attrIndex = WebDocumentAttributeHeadAt(document, nodeId)
    while attrIndex >= 0:
        if document.attributes[attrIndex].nodeId == nodeId && WebDatasetAttributeNameMatchesProperty(document.attributes[attrIndex].name, name):
            out = document.attributes[attrIndex].value
            return true
        attrIndex = document.attributeNextIndex[attrIndex]
    out = ""
    return false

fn WebInlineStyleNameCharAllowed(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '-' || ch == '_'

@borrows
fn WebInlineStyleNameValid(name: str): bool =
    if name.len <= 0:
        return false
    for i in 0..<name.len:
        if !WebInlineStyleNameCharAllowed(name[i]):
            return false
    return true

@borrows
fn WebInlineStylePriorityValid(priority: str): bool =
    return priority == "" || priority == "important"

@borrows
fn WebDocumentSetInlineStyleValue(document: var WebDocument, nodeId: int32, name: str, value: str): bool =
    return WebDocumentSetInlineStyleValuePriority(document, nodeId, name, value, "")

@borrows
fn WebDocumentSetInlineStyleValuePriority(document: var WebDocument, nodeId: int32, name: str, value: str, priority: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    if !WebInlineStyleNameValid(name) || !WebInlineStylePriorityValid(priority):
        return false
    if value.len <= 0:
        var next: WebInlineStyleEntry[]
        for i in 0..<document.inlineStyles.len:
            if document.inlineStyles[i].nodeId == nodeId && document.inlineStyles[i].name == name:
                continue
            var keptEntry = document.inlineStyles[i]
            add(next, keptEntry)
        document.inlineStyles = next
        WebDocumentRebuildIndexes(document)
        WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "style", "", 0, 0)
        return true
    var i = WebDocumentInlineStyleHeadAt(document, nodeId)
    while i >= 0:
        if document.inlineStyles[i].nodeId == nodeId && document.inlineStyles[i].name == name:
            document.inlineStyles[i].value = strings.ConcatStr(value, "")
            document.inlineStyles[i].priority = priority
            WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "style", strings.ConcatStr(value, ""), 0, 0)
            return true
        i = document.inlineStyleNextIndex[i]
    var entry: WebInlineStyleEntry
    entry.nodeId = nodeId
    entry.name = strings.ConcatStr(name, "")
    entry.value = strings.ConcatStr(value, "")
    entry.priority = priority
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "style", strings.ConcatStr(value, ""), 0, 0)
    add(document.inlineStyles, entry)
    WebDocumentRegisterInlineStyleIndex(document, nodeId, document.inlineStyles.len - 1)
    return true

@borrows
fn WebDocumentGetInlineStyleValue(document: var WebDocument, nodeId: int32, name: str, out: var str): bool =
    if !WebInlineStyleNameValid(name):
        out = ""
        return false
    var i = WebDocumentInlineStyleHeadAt(document, nodeId)
    while i >= 0:
        if document.inlineStyles[i].nodeId == nodeId && document.inlineStyles[i].name == name:
            out = document.inlineStyles[i].value
            return true
        i = document.inlineStyleNextIndex[i]
    out = ""
    return false

fn WebDocumentInlineStyleCount(document: var WebDocument, nodeId: int32): int32 =
    var count: int32
    var i = WebDocumentInlineStyleHeadAt(document, nodeId)
    while i >= 0:
        if document.inlineStyles[i].nodeId == nodeId:
            count = count + 1
        i = document.inlineStyleNextIndex[i]
    return count

fn WebDocumentInlineStyleNameAt(document: var WebDocument, nodeId: int32, ordinal: int32, out: var str): bool =
    if ordinal < 0:
        out = ""
        return false
    var count: int32
    var i = WebDocumentInlineStyleHeadAt(document, nodeId)
    while i >= 0:
        if document.inlineStyles[i].nodeId == nodeId:
            if count == ordinal:
                out = document.inlineStyles[i].name
                return true
            count = count + 1
        i = document.inlineStyleNextIndex[i]
    out = ""
    return false

fn WebDocumentInlineStyleValueAt(document: var WebDocument, nodeId: int32, ordinal: int32, out: var str): bool =
    if ordinal < 0:
        out = ""
        return false
    var count: int32
    var i = WebDocumentInlineStyleHeadAt(document, nodeId)
    while i >= 0:
        if document.inlineStyles[i].nodeId == nodeId:
            if count == ordinal:
                out = document.inlineStyles[i].value
                return true
            count = count + 1
        i = document.inlineStyleNextIndex[i]
    out = ""
    return false

fn WebDocumentAddEventListener(document: var WebDocument,
                               nodeId: int32,
                               eventType: str,
                               handlerId: int32,
                               capture: bool,
                               once: bool): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    var listener: WebEventListener
    listener.nodeId = nodeId
    listener.eventType = eventType
    listener.handlerId = handlerId
    listener.capture = capture
    listener.once = once
    add(document.listeners, listener)
    return true

fn WebDocumentRemoveEventListener(document: var WebDocument,
                                  nodeId: int32,
                                  eventType: str,
                                  handlerId: int32,
                                  capture: bool): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    for i in 0..<document.listeners.len:
        if document.listeners[i].nodeId == nodeId &&
           document.listeners[i].eventType == eventType &&
           document.listeners[i].handlerId == handlerId &&
           document.listeners[i].capture == capture:
            document.listeners[i].handlerId = 0
            return true
    return false

@borrows
fn WebDocumentRecordDispatchStep(document: var WebDocument,
                                 nodeId: int32,
                                 eventType: str,
                                 handlerId: int32,
                                 phase: int32) =
    var step: WebDispatchStep
    step.nodeId = nodeId
    step.eventType = strings.CloneStr(eventType)
    step.handlerId = handlerId
    step.phase = phase
    add(document.dispatchTrace, step)

@borrows
fn WebDocumentDispatchListeners(document: var WebDocument,
                                nodeId: int32,
                                eventType: str,
                                phase: int32,
                                captureOnly: bool,
                                bubbleOnly: bool): int32 =
    var count = 0
    for i in 0..<document.listeners.len:
        if document.listeners[i].nodeId == nodeId &&
           document.listeners[i].eventType == eventType &&
           document.listeners[i].handlerId != 0:
            if captureOnly && !document.listeners[i].capture:
                continue
            if bubbleOnly && document.listeners[i].capture:
                continue
            WebDocumentRecordDispatchStep(document,
                                          nodeId,
                                          eventType,
                                          document.listeners[i].handlerId,
                                          phase)
            count = count + 1
            if document.listeners[i].once:
                document.listeners[i].handlerId = 0
    return count

fn WebDocumentDispatchEvent(document: var WebDocument, targetNodeId: int32, eventType: str): int32 =
    if !WebDocumentNodeExists(document, targetNodeId):
        return 0
    document.dispatchTrace = []
    var ancestors: int32[]
    var current = WebDocumentParentOf(document, targetNodeId)
    while current != 0:
        add(ancestors, current)
        current = WebDocumentParentOf(document, current)
    var dispatched = 0
    for i in 0..<ancestors.len:
        let ancestor = ancestors[ancestors.len - 1 - i]
        dispatched = dispatched + WebDocumentDispatchListeners(document,
                                                               ancestor,
                                                               eventType,
                                                               WebEventPhaseCapture,
                                                               true,
                                                               false)
    dispatched = dispatched + WebDocumentDispatchListeners(document,
                                                           targetNodeId,
                                                           eventType,
                                                           WebEventPhaseTarget,
                                                           false,
                                                           false)
    for i in 0..<ancestors.len:
        dispatched = dispatched + WebDocumentDispatchListeners(document,
                                                               ancestors[i],
                                                               eventType,
                                                               WebEventPhaseBubble,
                                                               false,
                                                               true)
    return dispatched

fn WebDocumentDispatchTraceCount(document: var WebDocument): int32 =
    return document.dispatchTrace.len

fn WebDocumentDispatchTraceNodeAt(document: var WebDocument, index: int32): int32 =
    if index < 0 || index >= document.dispatchTrace.len:
        return 0
    return document.dispatchTrace[index].nodeId

fn WebDocumentDispatchTraceHandlerAt(document: var WebDocument, index: int32): int32 =
    if index < 0 || index >= document.dispatchTrace.len:
        return 0
    return document.dispatchTrace[index].handlerId

fn WebDocumentDispatchTracePhaseAt(document: var WebDocument, index: int32): int32 =
    if index < 0 || index >= document.dispatchTrace.len:
        return 0
    return document.dispatchTrace[index].phase

fn WebDocumentListenerCount(document: var WebDocument): int32 =
    return document.listeners.len

fn WebDocumentListenerNodeAt(document: var WebDocument, index: int32): int32 =
    if index < 0 || index >= document.listeners.len:
        return 0
    return document.listeners[index].nodeId

fn WebDocumentListenerEventTypeAt(document: var WebDocument, index: int32, out: var str): bool =
    if index < 0 || index >= document.listeners.len:
        out = ""
        return false
    out = document.listeners[index].eventType
    return true

fn WebDocumentListenerHandlerAt(document: var WebDocument, index: int32): int32 =
    if index < 0 || index >= document.listeners.len:
        return 0
    return document.listeners[index].handlerId

fn WebStorageInit(storage: var WebStorage) =
    storage.entries = []

fn WebStorageLength(storage: var WebStorage): int32 =
    return storage.entries.len

@borrows
fn WebStorageFindIndex(storage: var WebStorage, key: str): int32 =
    for i in 0..<storage.entries.len:
        if storage.entries[i].key == key:
            return i
    return -1

@borrows
fn WebStorageGetItem(storage: var WebStorage, key: str, out: var str): bool =
    let index = WebStorageFindIndex(storage, key)
    if index < 0:
        out = ""
        return false
    out = storage.entries[index].value
    return true

fn WebStorageSetItem(storage: var WebStorage, key: str, value: str): bool =
    let keyCopy = strings.CloneStr(key)
    let valueCopy = strings.CloneStr(value)
    let index = WebStorageFindIndex(storage, key)
    if index >= 0:
        storage.entries[index].value = valueCopy
        return true
    var entry: WebStorageEntry
    entry.key = keyCopy
    entry.value = value
    add(storage.entries, entry)
    return true

fn WebStorageRemoveItem(storage: var WebStorage, key: str): bool =
    let index = WebStorageFindIndex(storage, key)
    if index < 0:
        return false
    var next: WebStorageEntry[]
    for i in 0..<storage.entries.len:
        if i != index:
            add(next, share(storage.entries[i]))
    storage.entries = next
    return true

fn WebStorageClear(storage: var WebStorage) =
    storage.entries = []

fn WebWindowInit(window: var WebWindow) =
    var storage: WebStorage
    WebStorageInit(storage)
    window.localStorage = storage
    window.listeners = []
    window.dispatchTrace = []
    window.loaded = false
    window.domContentLoaded = false
    window.innerWidth = 1024
    window.innerHeight = 768
    window.scrollX = 0
    window.scrollY = 0
    window.nextAnimationFrameId = 0
    window.animationCallbacks = []
    window.fetchRequests = []
    window.fetchResponses = []
    window.xhrStates = []
    window.canvasStates = []
    window.history.entries = []
    window.history.currentIndex = -1
    window.clipboardText = ""
    window.location = ""
    window.locationHref = ""
    window.colorScheme = "light"
    var sessionStorage: WebStorage
    WebStorageInit(sessionStorage)
    window.sessionStorage = sessionStorage
    window.nextIdleCallbackId = 1
    window.idleCallbacks = []
    window.microtaskQueue = []
    window.notifications = []
    window.notificationPermission = "default"
    window.eventSources = []

fn WebWindowLocalStorageLength(window: var WebWindow): int32 =
    return WebStorageLength(window.localStorage)

fn WebWindowLocalStorageGetItem(window: var WebWindow, key: str, out: var str): bool =
    return WebStorageGetItem(window.localStorage, key, out)

fn WebWindowLocalStorageSetItem(window: var WebWindow, key: str, value: str): bool =
    var storage = window.localStorage
    let ok = WebStorageSetItem(storage, key, value)
    window.localStorage = storage
    return ok

fn WebWindowLocalStorageRemoveItem(window: var WebWindow, key: str): bool =
    var storage = window.localStorage
    let ok = WebStorageRemoveItem(storage, key)
    window.localStorage = storage
    return ok

fn WebWindowLocalStorageClear(window: var WebWindow) =
    var storage = window.localStorage
    WebStorageClear(storage)
    window.localStorage = storage

fn WebWindowSessionStorage(window: var WebWindow): WebStorage =
    return window.sessionStorage

fn WebWindowLocationHref(window: var WebWindow, out: var str): bool =
    out = window.locationHref
    return true

fn WebWindowLocationSetHref(window: var WebWindow, url: str): bool =
    window.locationHref = url
    return true

fn WebWindowLocationReload(window: var WebWindow): bool =
    # Mark reload request
    window.locationHref = window.location
    return true

fn WebWindowLocationPathname(window: var WebWindow, out: var str): bool =
    let parsed = WebUrlParse(window.locationHref)
    out = parsed.pathname
    return true

@borrows
fn WebStrContains(text: str, sub: str): bool =
    if sub.len <= 0:
        return true
    if sub.len > text.len:
        return false
    for i in 0..<(text.len - sub.len + 1):
        var matchedText = true
        for j in 0..<sub.len:
            if text[i + j] != sub[j]:
                matchedText = false
                break
        if matchedText:
            return true
    return false

fn WebWindowOpen(window: var WebWindow, url: str, target: str): int32 =
    # Simplified: return 0 to indicate not supported
    return 0

fn WebWindowClose(window: var WebWindow): bool =
    return true

fn WebWindowScrollX(window: var WebWindow): int32 =
    return window.scrollX

fn WebWindowScrollY(window: var WebWindow): int32 =
    return window.scrollY

fn WebWindowSetScroll(window: var WebWindow, x: int32, y: int32): bool =
    if x < 0 || y < 0:
        return false
    window.scrollX = x
    window.scrollY = y
    return true

fn WebWindowInnerWidth(window: var WebWindow): int32 =
    return window.innerWidth

fn WebWindowInnerHeight(window: var WebWindow): int32 =
    return window.innerHeight

fn WebWindowSetViewport(window: var WebWindow, width: int32, height: int32): bool =
    if width <= 0 || height <= 0:
        return false
    window.innerWidth = width
    window.innerHeight = height
    return true

@borrows
fn WebWindowMatchMedia(window: var WebWindow, query: str, out: var bool): bool =
    # Parse simple media queries
    if query.len <= 0:
        out = false
        return true
    # "(min-width: 768px)" => always true (Cheng runtime has no viewport restriction)
    if WebStrContains(query, "min-width"):
        out = true
        return true
    # "(prefers-color-scheme: dark)" => check window.colorScheme
    if WebStrContains(query, "prefers-color-scheme"):
        out = window.colorScheme == "dark"
        return true
    out = false
    return true

fn WebWindowMatchMediaList(window: var WebWindow, query: str, out: var WebMediaQueryList): bool =
    out.query = strings.CloneStr(query)
    out.listeners = []
    var matches: bool
    if !WebWindowMatchMedia(window, query, matches):
        out.matches = false
        return false
    out.matches = matches
    return true

fn WebMediaQueryListAddEventListener(list: var WebMediaQueryList,
                                     eventType: str,
                                     handlerId: int32): bool =
    if eventType != "change" || handlerId <= 0:
        return false
    var listener: WebEventListener
    listener.nodeId = 0
    listener.eventType = eventType
    listener.handlerId = handlerId
    listener.capture = false
    listener.once = false
    add(list.listeners, listener)
    return true

fn WebMediaQueryListRemoveEventListener(list: var WebMediaQueryList,
                                        eventType: str,
                                        handlerId: int32): bool =
    if eventType != "change" || handlerId <= 0:
        return false
    var kept: WebEventListener[]
    var removed = false
    for i in 0..<list.listeners.len:
        if list.listeners[i].eventType == eventType && list.listeners[i].handlerId == handlerId:
            removed = true
            continue
        add(kept, share(list.listeners[i]))
    list.listeners = kept
    return removed

fn WebMediaQueryListAddListener(list: var WebMediaQueryList, handlerId: int32): bool =
    return WebMediaQueryListAddEventListener(list, "change", handlerId)

fn WebMediaQueryListRemoveListener(list: var WebMediaQueryList, handlerId: int32): bool =
    return WebMediaQueryListRemoveEventListener(list, "change", handlerId)

fn WebMediaQueryListListenerCount(list: var WebMediaQueryList): int32 =
    return list.listeners.len

fn WebWindowAddEventListener(window: var WebWindow,
                             eventType: str,
                             handlerId: int32,
                             capture: bool,
                             once: bool): bool =
    if handlerId <= 0:
        return false
    var listener: WebEventListener
    listener.nodeId = 0
    listener.eventType = eventType
    listener.handlerId = handlerId
    listener.capture = capture
    listener.once = once
    add(window.listeners, listener)
    return true

fn WebWindowRemoveEventListener(window: var WebWindow,
                                eventType: str,
                                handlerId: int32,
                                capture: bool): bool =
    if handlerId <= 0:
        return false
    for i in 0..<window.listeners.len:
        if window.listeners[i].eventType == eventType &&
           window.listeners[i].handlerId == handlerId &&
           window.listeners[i].capture == capture:
            window.listeners[i].handlerId = 0
            return true
    return false

fn WebWindowRecordDispatchStep(window: var WebWindow,
                               eventType: str,
                               handlerId: int32,
                               phase: int32) =
    var step: WebDispatchStep
    step.nodeId = 0
    step.eventType = eventType
    step.handlerId = handlerId
    step.phase = phase
    add(window.dispatchTrace, step)

fn WebWindowDispatchEvent(window: var WebWindow, eventType: str): int32 =
    window.dispatchTrace = []
    var dispatched = 0
    for i in 0..<window.listeners.len:
        if window.listeners[i].eventType == eventType &&
           window.listeners[i].handlerId != 0:
            WebWindowRecordDispatchStep(window,
                                        share(eventType),
                                        window.listeners[i].handlerId,
                                        WebEventPhaseTarget)
            dispatched = dispatched + 1
            if window.listeners[i].once:
                window.listeners[i].handlerId = 0
    return dispatched

fn WebWindowDispatchEventObject(window: var WebWindow, event: var WebEvent): bool =
    event.target = 0
    event.currentTarget = 0
    event.eventPhase = WebEventPhaseTarget
    event.defaultPrevented = false
    event.propagationStopped = false
    event.canceled = false
    window.dispatchTrace = []
    for i in 0..<window.listeners.len:
        if window.listeners[i].eventType == event.type &&
           window.listeners[i].handlerId != 0:
            WebWindowRecordDispatchStep(window,
                                        share(event.type),
                                        window.listeners[i].handlerId,
                                        WebEventPhaseTarget)
            if window.listeners[i].once:
                window.listeners[i].handlerId = 0
            if event.propagationStopped:
                break
    event.eventPhase = EVENT_PHASE_NONE
    event.currentTarget = 0
    return !event.defaultPrevented

fn WebWindowDispatchTraceCount(window: var WebWindow): int32 =
    return window.dispatchTrace.len

fn WebWindowDispatchTraceHandlerAt(window: var WebWindow, index: int32): int32 =
    if index < 0 || index >= window.dispatchTrace.len:
        return 0
    return window.dispatchTrace[index].handlerId

fn WebWindowDispatchTracePhaseAt(window: var WebWindow, index: int32): int32 =
    if index < 0 || index >= window.dispatchTrace.len:
        return 0
    return window.dispatchTrace[index].phase

// ──────────────────────────────────────
// DOM Query functions
// ──────────────────────────────────────

fn WebDocumentGetElementById(document: var WebDocument, id: str): int32 =
    for i in 0..<document.attributes.len:
        if document.attributes[i].name == "id" && document.attributes[i].value == id:
            return document.attributes[i].nodeId
    return 0

fn WebDocumentGetElementsByTagName(document: var WebDocument, tagName: str, out: var int32[]): int32 =
    out = []
    for i in 0..<document.nodes.len:
        if document.nodes[i].kind == WebNodeKindElement && document.nodes[i].tagName == tagName:
            add(out, document.nodes[i].nodeId)
    return out.len

fn WebDocumentGetElementsByClassName(document: var WebDocument, className: str, out: var int32[]): int32 =
    out = []
    for i in 0..<document.attributes.len:
        if document.attributes[i].name == "class":
            let classValue = document.attributes[i].value
            var start: int32
            var j: int32
            while j <= classValue.len:
                let atEnd = j == classValue.len
                var split = atEnd
                if !split:
                    let ch = classValue[j]
                    split = ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r'
                if split:
                    if j > start:
                        let count = j - start
                        if count == className.len:
                            var same = true
                            for k in 0..<count:
                                if classValue[start + k] != className[k]:
                                    same = false
                                    break
                            if same:
                                add(out, document.attributes[i].nodeId)
                                break
                    start = j + 1
                j = j + 1
    return out.len

fn WebArrayFromNodeIds(nodeIds: int32[], out: var int32[]): int32 =
    out = []
    for i in 0..<nodeIds.len:
        add(out, nodeIds[i])
    return out.len

fn WebArrayFromChildNodes(document: var WebDocument, parentNodeId: int32, out: var int32[]): int32 =
    out = []
    let childCount = WebDocumentChildCount(document, parentNodeId)
    for i in 0..<childCount:
        add(out, WebDocumentChildAt(document, parentNodeId, i))
    return out.len

fn WebArrayFromElementAttributes(document: var WebDocument, nodeId: int32, out: var WebAttribute[]): int32 =
    out = []
    for i in 0..<document.attributes.len:
        if document.attributes[i].nodeId == nodeId:
            add(out, share(document.attributes[i]))
    return out.len

fn WebFileInit(file: var WebFile, name: str, size: int32, mediaType: str) =
    file.name = name
    file.size = size
    file.mediaType = mediaType

fn WebFileListInit(list: var WebFileList) =
    list.names = []
    list.sizes = []
    list.mediaTypes = []

fn WebFileListAdd(list: var WebFileList, file: var WebFile) =
    add(list.names, share(file.name))
    add(list.sizes, file.size)
    add(list.mediaTypes, share(file.mediaType))

fn WebFileArrayInit(array: var WebFileArray) =
    array.names = []
    array.sizes = []
    array.mediaTypes = []

fn WebArrayFromFileList(list: var WebFileList, out: var WebFileArray): int32 =
    WebFileArrayInit(out)
    if list.names.len != list.sizes.len:
        return 0
    if list.names.len != list.mediaTypes.len:
        return 0
    for i in 0..<list.names.len:
        add(out.names, share(list.names[i]))
        add(out.sizes, list.sizes[i])
        add(out.mediaTypes, share(list.mediaTypes[i]))
    return out.names.len

fn WebDataTransferItemInit(item: var WebDataTransferItem, kind: str, mediaType: str) =
    item.kind = kind
    item.mediaType = mediaType

fn WebDataTransferItemListInit(list: var WebDataTransferItemList) =
    list.kinds = []
    list.mediaTypes = []

fn WebDataTransferItemListAdd(list: var WebDataTransferItemList, item: var WebDataTransferItem) =
    add(list.kinds, share(item.kind))
    add(list.mediaTypes, share(item.mediaType))

fn WebDataTransferItemArrayInit(array: var WebDataTransferItemArray) =
    array.kinds = []
    array.mediaTypes = []

fn WebArrayFromDataTransferItemList(list: var WebDataTransferItemList, out: var WebDataTransferItemArray): int32 =
    WebDataTransferItemArrayInit(out)
    if list.kinds.len != list.mediaTypes.len:
        return 0
    for i in 0..<list.kinds.len:
        add(out.kinds, share(list.kinds[i]))
        add(out.mediaTypes, share(list.mediaTypes[i]))
    return out.kinds.len

// ──────────────────────────────────────
// MutationObserver
// ──────────────────────────────────────

type WebMutationObserver =
    observedNodeId: int32
    observeChildList: bool
    observeAttributes: bool
    observeSubtree: bool
    records: WebMutation[]

fn WebMutationObserverInit(observer: var WebMutationObserver) =
    observer.observedNodeId = 0
    observer.observeChildList = false
    observer.observeAttributes = false
    observer.observeSubtree = false
    observer.records = []

fn WebMutationObserverObserve(observer: var WebMutationObserver,
                              nodeId: int32,
                              childList: bool,
                              attributes: bool,
                              subtree: bool) =
    observer.observedNodeId = nodeId
    observer.observeChildList = childList
    observer.observeAttributes = attributes
    observer.observeSubtree = subtree

fn WebMutationObserverPushRecord(observer: var WebMutationObserver, mutation: WebMutation) =
    add(observer.records, mutation)

fn WebMutationObserverTakeRecords(observer: var WebMutationObserver, out: var WebMutation[]): int32 =
    out = observer.records
    observer.records = []
    return out.len

fn WebMutationObserverDisconnect(observer: var WebMutationObserver) =
    observer.observedNodeId = 0
    observer.records = []

// ──────────────────────────────────────
// WebEvent functions
// ──────────────────────────────────────

fn WebEventInit(event: var WebEvent, type: str) =
    event.type = type
    event.target = 0
    event.currentTarget = 0
    event.eventPhase = EVENT_PHASE_NONE
    event.bubbles = true
    event.cancelable = true
    event.defaultPrevented = false
    event.propagationStopped = false
    event.canceled = false
    event.timestamp = 0
    event.composed = false
    event.clientX = 0
    event.clientY = 0
    event.pageX = 0
    event.pageY = 0
    event.screenX = 0
    event.screenY = 0
    event.button = 0
    event.buttons = 0
    event.ctrlKey = false
    event.shiftKey = false
    event.altKey = false
    event.metaKey = false
    event.detail = 0
    event.relatedTarget = 0
    event.key = ""
    event.code = ""
    event.repeat = false
    event.location = 0
    event.customDetail = ""
    event.deltaX = 0
    event.deltaY = 0
    event.deltaZ = 0
    event.deltaMode = 0

fn WebEventInitWithOptions(event: var WebEvent, type: str, bubbles: bool, cancelable: bool) =
    WebEventInit(event, type)
    event.bubbles = bubbles
    event.cancelable = cancelable

fn WebEventNew(type: str, out: var WebEvent): bool =
    WebEventInitWithOptions(out, type, false, false)
    return true

fn WebEventNewWithOptions(type: str, bubbles: bool, cancelable: bool, out: var WebEvent): bool =
    WebEventInitWithOptions(out, type, bubbles, cancelable)
    return true

fn WebEventStopPropagation(event: var WebEvent) =
    event.propagationStopped = true

fn WebEventPreventDefault(event: var WebEvent) =
    if event.cancelable:
        event.canceled = true
        event.defaultPrevented = true

fn WebDispatchEvent(document: var WebDocument,
                    targetId: int32,
                    event: var WebEvent): bool =
    if !WebDocumentNodeExists(document, targetId):
        return false
    event.target = targetId
    event.currentTarget = 0
    event.eventPhase = EVENT_PHASE_NONE
    event.defaultPrevented = false
    event.propagationStopped = false
    event.canceled = false
    document.dispatchTrace = []

    // Build ancestor chain (target → root)
    var ancestors: int32[]
    var current = WebDocumentParentOf(document, targetId)
    while current != 0:
        add(ancestors, current)
        current = WebDocumentParentOf(document, current)

    // Phase 1: Capture (root → target)
    event.eventPhase = WebEventPhaseCapture
    for i in 0..<ancestors.len:
        let ancestor = ancestors[ancestors.len - 1 - i]
        event.currentTarget = ancestor
        WebDocumentDispatchListeners(document,
                                     ancestor,
                                     event.type,
                                     WebEventPhaseCapture,
                                     true,
                                     false)
        if event.propagationStopped:
            break

    // Phase 2: Target
    if !event.propagationStopped:
        event.eventPhase = WebEventPhaseTarget
        event.currentTarget = targetId
        WebDocumentDispatchListeners(document,
                                     targetId,
                                     event.type,
                                     WebEventPhaseTarget,
                                     false,
                                     false)
        // After target phase, if bubbles=false, stop before bubble
        if !event.bubbles:
            event.propagationStopped = true

    // Phase 3: Bubble (target → root)
    if !event.propagationStopped:
        event.eventPhase = WebEventPhaseBubble
        for i in 0..<ancestors.len:
            event.currentTarget = ancestors[i]
            WebDocumentDispatchListeners(document,
                                         ancestors[i],
                                         event.type,
                                         WebEventPhaseBubble,
                                         false,
                                         true)
            if event.propagationStopped:
                break

    event.eventPhase = EVENT_PHASE_NONE
    event.currentTarget = 0
    return !event.defaultPrevented

fn WebDocumentDispatchEventObject(document: var WebDocument, event: var WebEvent): bool =
    var docNodeId = document.rootNodeId
    if docNodeId == 0:
        docNodeId = WebDocumentCreateDocumentNode(document)
    return WebDispatchEvent(document, docNodeId, event)

// ──────────────────────────────────────
// Event InitDict types  (sentinel -1 = unset)
// ──────────────────────────────────────

type WebEventInitDict =
    bubbles: int32      // -1=unset, 0=false, 1=true
    cancelable: int32
    composed: int32

type WebMouseEventInitDict =
    screenX: int32
    screenY: int32
    clientX: int32
    clientY: int32
    pageX: int32
    pageY: int32
    button: int32
    buttons: int32
    ctrlKey: int32     // -1=unset
    shiftKey: int32
    altKey: int32
    metaKey: int32
    detail: int32
    relatedTarget: int32

type WebKeyboardEventInitDict =
    key: str
    code: str
    ctrlKey: int32     // -1=unset
    shiftKey: int32
    altKey: int32
    metaKey: int32
    repeat: int32      // -1=unset
    location: int32    // -1=unset

type WebCustomEventInitDict =
    detail: str

type WebFocusEventInitDict =
    relatedTarget: int32   // -1=unset

type WebInputEventInitDict =
    data: str
    inputType: str

// ──────────────────────────────────────
// Event constructors
// ──────────────────────────────────────

fn WebEventConstructor(type: str, eventInit: var WebEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.bubbles = false
    out.cancelable = false
    out.composed = false
    if eventInit.bubbles != -1:
        out.bubbles = eventInit.bubbles == 1
    if eventInit.cancelable != -1:
        out.cancelable = eventInit.cancelable == 1
    if eventInit.composed != -1:
        out.composed = eventInit.composed == 1
    return true

fn WebMouseEventConstructor(type: str, mouseInit: var WebMouseEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.clientX = mouseInit.clientX
    out.clientY = mouseInit.clientY
    out.screenX = mouseInit.screenX
    out.screenY = mouseInit.screenY
    out.pageX = mouseInit.pageX
    out.pageY = mouseInit.pageY
    out.button = mouseInit.button
    out.buttons = mouseInit.buttons
    out.detail = mouseInit.detail
    out.bubbles = true
    out.cancelable = true
    out.composed = false
    if mouseInit.ctrlKey != -1:
        out.ctrlKey = mouseInit.ctrlKey == 1
    if mouseInit.shiftKey != -1:
        out.shiftKey = mouseInit.shiftKey == 1
    if mouseInit.altKey != -1:
        out.altKey = mouseInit.altKey == 1
    if mouseInit.metaKey != -1:
        out.metaKey = mouseInit.metaKey == 1
    if mouseInit.relatedTarget != -1:
        out.relatedTarget = mouseInit.relatedTarget
    return true

fn WebKeyboardEventConstructor(type: str, keyInit: var WebKeyboardEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.key = keyInit.key
    out.code = keyInit.code
    out.bubbles = true
    out.cancelable = true
    out.composed = false
    if keyInit.ctrlKey != -1:
        out.ctrlKey = keyInit.ctrlKey == 1
    if keyInit.shiftKey != -1:
        out.shiftKey = keyInit.shiftKey == 1
    if keyInit.altKey != -1:
        out.altKey = keyInit.altKey == 1
    if keyInit.metaKey != -1:
        out.metaKey = keyInit.metaKey == 1
    if keyInit.repeat != -1:
        out.repeat = keyInit.repeat == 1
    if keyInit.location != -1:
        out.location = keyInit.location
    return true

fn WebCustomEventConstructor(type: str, customInit: var WebCustomEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.customDetail = customInit.detail
    out.bubbles = false
    out.cancelable = false
    out.composed = false
    return true

fn WebFocusEventConstructor(type: str, focusInit: var WebFocusEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.bubbles = false
    out.cancelable = false
    out.composed = false
    if focusInit.relatedTarget != -1:
        out.relatedTarget = focusInit.relatedTarget
    return true

fn WebInputEventConstructor(type: str, inputInit: var WebInputEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.bubbles = true
    out.cancelable = true
    out.composed = false
    // InputEvent fields stored in customDetail for data
    out.customDetail = inputInit.data
    return true

// ──────────────────────────────────────
// WheelEvent / TouchEvent InitDict types
// ──────────────────────────────────────

type WebWheelEventInitDict =
    deltaX: int32
    deltaY: int32
    deltaZ: int32
    deltaMode: int32

type WebTouchInitDict =
    identifier: int32
    clientX: int32
    clientY: int32
    pageX: int32
    pageY: int32

type WebTouchEventInitDict =
    touches: WebTouchInitDict[]
    changedTouches: WebTouchInitDict[]
    targetTouches: WebTouchInitDict[]

fn WebWheelEventConstructor(type: str, wheelInit: var WebWheelEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.bubbles = true
    out.cancelable = true
    out.composed = false
    out.deltaX = wheelInit.deltaX
    out.deltaY = wheelInit.deltaY
    out.deltaZ = wheelInit.deltaZ
    out.deltaMode = wheelInit.deltaMode
    return true

fn WebTouchEventConstructor(type: str, touchInit: var WebTouchEventInitDict, out: var WebEvent): bool =
    WebEventInit(out, type)
    out.bubbles = true
    out.cancelable = true
    out.composed = false
    if touchInit.touches.len > 0:
        out.clientX = touchInit.touches[0].clientX
        out.clientY = touchInit.touches[0].clientY
        out.pageX = touchInit.touches[0].pageX
        out.pageY = touchInit.touches[0].pageY
    return true

// ──────────────────────────────────────
// TextEncoder
// ──────────────────────────────────────

type WebTextEncoder =
    encoding: str

fn WebTextEncoderInit(encoder: var WebTextEncoder) =
    encoder.encoding = "utf-8"

fn WebTextEncoderEncode(encoder: var WebTextEncoder, text: str, out: var int32[]): bool =
    var result: int32[]
    for i in 0..<text.len:
        add(result, int32(text[i]))
    out = result
    return true

// ──────────────────────────────────────
// Standalone TextEncoder convenience
// ──────────────────────────────────────

fn WebTextEncoderEncodeString(text: str): int32[] =
    var result: int32[]
    for i in 0..<text.len:
        add(result, int32(text[i]))
    return result

// ──────────────────────────────────────
// TextDecoder
// ──────────────────────────────────────

type WebTextDecoder =
    encoding: str

fn WebTextDecoderInit(decoder: var WebTextDecoder) =
    decoder.encoding = "utf-8"

fn WebTextDecoderBytesValid(bytes: int32[]): bool =
    for i in 0..<bytes.len:
        if bytes[i] < 0 || bytes[i] > 255:
            return false
    return true

fn WebTextDecoderDecode(decoder: var WebTextDecoder, bytes: int32[], out: var str): bool =
    if !WebTextDecoderBytesValid(bytes):
        out = ""
        return false
    var result = ""
    for i in 0..<bytes.len:
        result = Fmt"{result}{char(bytes[i])}"
    out = result
    return true

// ──────────────────────────────────────
// Standalone TextDecoder convenience
// ──────────────────────────────────────

fn WebTextDecoderDecodeBytes(bytes: int32[]): str =
    if !WebTextDecoderBytesValid(bytes):
        return ""
    var result = ""
    for i in 0..<bytes.len:
        result = Fmt"{result}{char(bytes[i])}"
    return result

// ──────────────────────────────────────
// Node tree helpers (for querySelector / pseudo-class matching)
// ──────────────────────────────────────

fn WebDocumentNodeParent(document: var WebDocument, nodeId: int32): int32 =
    return WebDocumentParentOf(document, nodeId)

fn WebDocumentNodeFirstChild(document: var WebDocument, parentNodeId: int32): int32 =
    return WebDocumentChildAt(document, parentNodeId, 0)

fn WebDocumentNodeLastChild(document: var WebDocument, parentNodeId: int32): int32 =
    let count = WebDocumentChildCount(document, parentNodeId)
    if count <= 0:
        return 0
    return WebDocumentChildAt(document, parentNodeId, count - 1)

// ──────────────────────────────────────
// DOM Query Selector functions
// ──────────────────────────────────────

@borrows
fn WebCssSpanToString(source: str, start: int32, stop: int32): str =
    var result: str
    for i in start..stop:
        result = Fmt"{result}{char(source[i])}"
    return result

@borrows
fn WebCssClassValueContains(attrValue: str, selSource: str, selStart: int32, selStop: int32): bool =
    let nameLen = selStop - selStart + 1
    var start: int32
    var i: int32
    while i <= attrValue.len:
        let atEnd = i == attrValue.len
        var split = atEnd
        if !split:
            let ch = attrValue[i]
            split = ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r'
        if split:
            if i > start:
                let count = i - start
                if count == nameLen:
                    var same = true
                    for k in 0..<count:
                        if attrValue[start + k] != selSource[selStart + k]:
                            same = false
                            break
                    if same:
                        return true
            start = i + 1
        i = i + 1
    return false

fn WebCssIsIdentChar(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '_' 

@borrows
fn WebCssMatchIdSelector(document: var WebDocument, nodeId: int32, selector: str, varPos: var int32, selStop: int32, idOk: var bool) =
    var pos = varPos
    pos = pos + 1
    let idStart = pos
    while pos <= selStop:
        if !WebCssIsIdentChar(selector[pos]):
            break
        pos = pos + 1
    if !idOk:
        var attrVal: str
        if WebDocumentGetAttribute(document, nodeId, "id", attrVal):
            let idLen = pos - idStart
            if idLen == attrVal.len:
                var same = true
                for k in 0..<idLen:
                    if selector[idStart + k] != attrVal[k]:
                        same = false
                        break
                idOk = same
            else:
                idOk = false
        else:
            idOk = false
    varPos = pos

@borrows
fn WebCssMatchClassSelector(document: var WebDocument, nodeId: int32, selector: str, varPos: var int32, selStop: int32, classOk: var bool) =
    var pos = varPos
    pos = pos + 1
    let clsStart = pos
    while pos <= selStop:
        if !WebCssIsIdentChar(selector[pos]):
            break
        pos = pos + 1
    if !classOk:
        var attrVal: str
        if WebDocumentGetAttribute(document, nodeId, "class", attrVal):
            classOk = WebCssClassValueContains(attrVal, selector, clsStart, pos - 1)
        else:
            classOk = false
    varPos = pos

@borrows
fn WebCssMatchAttrSelector(document: var WebDocument, nodeId: int32, selector: str, varPos: var int32, selStop: int32, attrOk: var bool): bool =
    var pos = varPos
    pos = pos + 1
    let nameStart = pos
    while pos <= selStop:
        let c = selector[pos]
        if c == ']' || c == '=':
            break
        pos = pos + 1
    if pos > selStop:
        varPos = pos
        return false
    if !attrOk:
        let attrName = WebCssSpanToString(selector, nameStart, pos - 1)
        if selector[pos] == '=':
            pos = pos + 1
            let valStart = pos
            if pos <= selStop:
                let cq = selector[pos]
                if cq == '"' || cq == '\'':
                    pos = pos + 1
            while pos <= selStop:
                if selector[pos] == ']':
                    break
                pos = pos + 1
            if pos > selStop:
                varPos = pos
                return false
            var valueStop = pos - 1
            if valueStop >= valStart:
                let cv = selector[valueStop]
                if cv == '"' || cv == '\'':
                    valueStop = valueStop - 1
            var actualValue: str
            if WebDocumentGetAttribute(document, nodeId, attrName, actualValue):
                let valLen = valueStop - valStart + 1
                if valLen == actualValue.len:
                    var same = true
                    for k in 0..<valLen:
                        if selector[valStart + k] != actualValue[k]:
                            same = false
                            break
                    attrOk = same
                else:
                    attrOk = false
            else:
                attrOk = false
        else:
            var actualValue: str
            attrOk = WebDocumentGetAttribute(document, nodeId, attrName, actualValue)
    pos = pos + 1
    varPos = pos
    return true

@borrows
fn WebCssParseNthChildFormula(formula: str, a: var int32, b: var int32): bool =
    a = 0
    b = 0
    var i: int32
    while i < formula.len && (formula[i] == ' ' || formula[i] == '\n' || formula[i] == '\t' || formula[i] == '\r'):
        i = i + 1
    if i >= formula.len:
        return false
    let flen = formula.len - i
    if flen >= 3:
        let o = formula[i]
        if o == 'o' || o == 'O':
            if flen >= 3 && (formula[i+1] == 'd' || formula[i+1] == 'D') && (formula[i+2] == 'd' || formula[i+2] == 'D'):
                if flen == 3 || formula[i+3] == ' ' || formula[i+3] == '\n' || formula[i+3] == '\t' || formula[i+3] == '\r':
                    a = 2; b = 1; return true
        if o == 'e' || o == 'E':
            if flen >= 4 && (formula[i+1] == 'v' || formula[i+1] == 'V') && (formula[i+2] == 'e' || formula[i+2] == 'E') && (formula[i+3] == 'n' || formula[i+3] == 'N'):
                if flen == 4 || formula[i+4] == ' ' || formula[i+4] == '\n' || formula[i+4] == '\t' || formula[i+4] == '\r':
                    a = 2; b = 0; return true
    var sign: int32 = 1
    if formula[i] == '-':
        sign = -1
        i = i + 1
    elif formula[i] == '+':
        i = i + 1
    var coeff: int32
    var hasDigit = false
    while i < formula.len:
        let d = formula[i]
        if d >= '0' && d <= '9':
            coeff = coeff * 10 + int32(d) - int32('0')
            hasDigit = true
            i = i + 1
        else:
            break
    if i < formula.len && (formula[i] == 'n' || formula[i] == 'N'):
        i = i + 1
        a = sign
        if hasDigit:
            a = sign * coeff
        while i < formula.len && (formula[i] == ' ' || formula[i] == '\n' || formula[i] == '\t' || formula[i] == '\r'):
            i = i + 1
        if i < formula.len:
            var bSign: int32 = 1
            if formula[i] == '-':
                bSign = -1
                i = i + 1
            elif formula[i] == '+':
                i = i + 1
            while i < formula.len:
                let d = formula[i]
                if d >= '0' && d <= '9':
                    b = b * 10 + int32(d) - int32('0')
                    i = i + 1
                else:
                    break
            b = b * bSign
    else:
        if !hasDigit:
            return false
        a = 0
        b = sign * coeff
    while i < formula.len && (formula[i] == ' ' || formula[i] == '\n' || formula[i] == '\t' || formula[i] == '\r'):
        i = i + 1
    return i == formula.len

fn WebCssEvaluateNthChild(a: int32, b: int32, index: int32): bool =
    if a == 0:
        return index == b
    if a > 0:
        if index < b:
            return false
        return (index - b) % a == 0
    if index > b:
        return false
    return (b - index) % (-a) == 0

@borrows
fn WebCssMatchPseudoSelector(document: var WebDocument, nodeId: int32, selector: str, varPos: var int32, selStop: int32, pseudoOk: var bool) =
    var pos = varPos
    pos = pos + 1
    let pseudoStart = pos
    while pos <= selStop:
        if !WebCssIsIdentChar(selector[pos]):
            break
        pos = pos + 1
    if !pseudoOk:
        let pseudoName = WebCssSpanToString(selector, pseudoStart, pos - 1)
        if pseudoName == "first-child":
            let parentId = WebDocumentNodeParent(document, nodeId)
            if parentId != 0:
                let firstChild = WebDocumentNodeFirstChild(document, parentId)
                pseudoOk = firstChild == nodeId
            else:
                pseudoOk = false
        elif pseudoName == "last-child":
            let parentId = WebDocumentNodeParent(document, nodeId)
            if parentId != 0:
                let lastChild = WebDocumentNodeLastChild(document, parentId)
                pseudoOk = lastChild == nodeId
            else:
                pseudoOk = false
        elif pseudoName == "nth-child":
            while pos <= selStop && (selector[pos] == ' ' || selector[pos] == '\n' || selector[pos] == '\t' || selector[pos] == '\r'):
                pos = pos + 1
            if pos <= selStop && selector[pos] == '(':
                pos = pos + 1
                let formulaStart = pos
                while pos <= selStop && selector[pos] != ')':
                    pos = pos + 1
                if pos <= selStop && selector[pos] == ')':
                    let formulaStop = pos - 1
                    pos = pos + 1
                    var formula: str
                    for fi in formulaStart..formulaStop:
                        formula = Fmt"{formula}{char(selector[fi])}"
                    var a: int32; var b: int32
                    if !WebCssParseNthChildFormula(formula, a, b):
                        pseudoOk = false
                    else:
                        let parentId = WebDocumentNodeParent(document, nodeId)
                        if parentId == 0:
                            pseudoOk = false
                        else:
                            let childCount = WebDocumentChildCount(document, parentId)
                            var index: int32
                            for ci in 0..<childCount:
                                let childId = WebDocumentChildAt(document, parentId, ci)
                                if childId == nodeId:
                                    index = ci + 1
                                    break
                            pseudoOk = WebCssEvaluateNthChild(a, b, index)
                else:
                    pseudoOk = false
            else:
                pseudoOk = false
        elif pseudoName == "not":
            while pos <= selStop && (selector[pos] == ' ' || selector[pos] == '\n' || selector[pos] == '\t' || selector[pos] == '\r'):
                pos = pos + 1
            if pos <= selStop && selector[pos] == '(':
                pos = pos + 1
                let innerStart = pos
                var parenDepth: int32
                while pos <= selStop:
                    let c = selector[pos]
                    if c == '(':
                        parenDepth = parenDepth + 1
                        pos = pos + 1
                    elif c == ')':
                        if parenDepth == 0:
                            break
                        parenDepth = parenDepth - 1
                        pos = pos + 1
                    else:
                        pos = pos + 1
                if pos <= selStop && selector[pos] == ')':
                    let innerStop = pos - 1
                    pos = pos + 1
                    pseudoOk = !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, innerStart, innerStop)
                else:
                    pseudoOk = false
            else:
                pseudoOk = false
        elif pseudoName == "hover":
            pseudoOk = nodeId == document.hoverNodeId
        elif pseudoName == "active":
            pseudoOk = nodeId == document.activeNodeId
        elif pseudoName == "focus":
            pseudoOk = nodeId == document.activeElementNodeId
        else:
            pseudoOk = true
    varPos = pos

@borrows
fn WebCssMatchTagSelector(document: var WebDocument, nodeId: int32, selector: str, varPos: var int32, selStop: int32, tagOk: var bool) =
    var pos = varPos
    let tagStart = pos
    while pos <= selStop:
        if !WebCssIsIdentChar(selector[pos]):
            break
        pos = pos + 1
    if !tagOk:
        var tagVal: str
        if WebDocumentNodeTagName(document, nodeId, tagVal):
            let tagLen = pos - tagStart
            if tagLen == tagVal.len:
                var same = true
                for k in 0..<tagLen:
                    if selector[tagStart + k] != tagVal[k]:
                        same = false
                        break
                tagOk = same
            else:
                tagOk = false
        else:
            tagOk = false
    varPos = pos

fn WebCssIsSelectorCombinator(ch: char): bool =
    if ch == '>':
        return true
    if ch == '+':
        return true
    if ch == '~':
        return true
    return false

fn WebCssIsIdentStart(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch == '_':
        return true
    return false

@borrows
fn WebCssNodeMatchesSelectorSpan(document: var WebDocument,
                                  nodeId: int32,
                                  selector: str,
                                  selStart: int32,
                                  selStop: int32): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var pos = selStart
    var hasTag = false
    var tagOk = false
    var hasId = false
    var idOk = false
    var hasClass = false
    var classOk = false
    var hasAttr = false
    var attrOk = false
    var hasPseudo = false
    var pseudoOk = false

    while pos <= selStop:
        let ch = selector[pos]
        if WebCssIsSpace(ch):
            pos = pos + 1
        elif ch == '#':
            hasId = true
            WebCssMatchIdSelector(document, nodeId, selector, pos, selStop, idOk)
        elif ch == '.':
            hasClass = true
            WebCssMatchClassSelector(document, nodeId, selector, pos, selStop, classOk)
        elif ch == '[':
            hasAttr = true
            if !WebCssMatchAttrSelector(document, nodeId, selector, pos, selStop, attrOk):
                return false
        elif ch == ':':
            hasPseudo = true
            WebCssMatchPseudoSelector(document, nodeId, selector, pos, selStop, pseudoOk)
        elif WebCssIsIdentStart(ch):
            hasTag = true
            WebCssMatchTagSelector(document, nodeId, selector, pos, selStop, tagOk)
        else:
            return false

    if hasTag && !tagOk:
        return false
    if hasId && !idOk:
        return false
    if hasClass && !classOk:
        return false
    if hasAttr && !attrOk:
        return false
    if hasPseudo && !pseudoOk:
        return false
    return true

@borrows
fn WebCssFindSelectorSplitPoint(selector: str, leftStop: var int32, rightStart: var int32, combType: var int32): bool =
    var parenDepth: int32
    var i: int32
    while i < selector.len:
        let ch = selector[i]
        if ch == '(':
            parenDepth = parenDepth + 1
            i = i + 1
        elif ch == ')':
            if parenDepth > 0:
                parenDepth = parenDepth - 1
            i = i + 1
        elif parenDepth > 0:
            i = i + 1
        elif WebCssIsSelectorCombinator(ch):
            var ls = i - 1
            while ls >= 0:
                let leftCh = selector[ls]
                if !WebCssIsSpace(leftCh):
                    break
                ls = ls - 1
            if ls >= 0:
                var rs = i + 1
                while rs < selector.len:
                    let rightCh = selector[rs]
                    if !WebCssIsSpace(rightCh):
                        break
                    rs = rs + 1
                if rs < selector.len:
                    leftStop = ls
                    rightStart = rs
                    combType = int32(ch)
                    return true
            i = i + 1
        elif WebCssIsSpace(ch):
            var hasLeft = false
            var j = i - 1
            while j >= 0:
                let cj = selector[j]
                if WebCssIsSpace(cj):
                    j = j - 1
                elif WebCssIsSelectorCombinator(cj):
                    break
                else:
                    hasLeft = true
                    break
            if hasLeft:
                var hasRight = false
                j = i + 1
                while j < selector.len:
                    let cj = selector[j]
                    if WebCssIsSpace(cj):
                        j = j + 1
                    elif WebCssIsSelectorCombinator(cj):
                        break
                    else:
                        hasRight = true
                        break
                if hasRight:
                    leftStop = i - 1
                    while leftStop >= 0:
                        let leftTrimCh = selector[leftStop]
                        if !WebCssIsSpace(leftTrimCh):
                            break
                        leftStop = leftStop - 1
                    rightStart = i + 1
                    while rightStart < selector.len:
                        let rightTrimCh = selector[rightStart]
                        if !WebCssIsSpace(rightTrimCh):
                            break
                        rightStart = rightStart + 1
                    if leftStop >= 0 && rightStart < selector.len:
                        combType = int32(' ')
                        return true
            i = i + 1
        else:
            i = i + 1
    return false

fn WebDocumentQuerySelector(document: var WebDocument, selector: str): int32 =
    var leftStop: int32
    var rightStart: int32
    var combType: int32
    if !WebCssFindSelectorSplitPoint(selector, leftStop, rightStart, combType):
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                if WebCssNodeMatchesSelectorSpan(document, document.nodes[ni].nodeId, selector, 0, selector.len - 1):
                    return document.nodes[ni].nodeId
        return 0

    let ancStart = 0
    let ancStop = leftStop
    let descStart = rightStart
    let descStop = selector.len - 1

    if combType == int32(' '):
        var ancestors: int32[]
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                if WebCssNodeMatchesSelectorSpan(document, document.nodes[ni].nodeId, selector, ancStart, ancStop):
                    add(ancestors, document.nodes[ni].nodeId)
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                let nodeId = document.nodes[ni].nodeId
                if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                    continue
                for ai in 0..<ancestors.len:
                    if WebDocumentIsAncestorOf(document, ancestors[ai], nodeId):
                        return nodeId
        return 0

    if combType == int32('>'):
        var parents: int32[]
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                if WebCssNodeMatchesSelectorSpan(document, document.nodes[ni].nodeId, selector, ancStart, ancStop):
                    add(parents, document.nodes[ni].nodeId)
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                let nodeId = document.nodes[ni].nodeId
                if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                    continue
                let parentId = WebDocumentParentOf(document, nodeId)
                for pi in 0..<parents.len:
                    if parentId == parents[pi]:
                        return nodeId
        return 0

    if combType == int32('+'):
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                let nodeId = document.nodes[ni].nodeId
                if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                    continue
                let parentId = WebDocumentParentOf(document, nodeId)
                if parentId == 0:
                    continue
                let childCount = WebDocumentChildCount(document, parentId)
                for ci in 1..<childCount:
                    if WebDocumentChildAt(document, parentId, ci) == nodeId:
                        let prevSibling = WebDocumentChildAt(document, parentId, ci - 1)
                        if WebCssNodeMatchesSelectorSpan(document, prevSibling, selector, ancStart, ancStop):
                            return nodeId
                        break
        return 0

    // General sibling combinator (~)
    for ni in 0..<document.nodes.len:
        if document.nodes[ni].kind == WebNodeKindElement:
            let nodeId = document.nodes[ni].nodeId
            if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                continue
            let parentId = WebDocumentParentOf(document, nodeId)
            if parentId == 0:
                continue
            let childCount = WebDocumentChildCount(document, parentId)
            for ci in 0..<childCount:
                if WebDocumentChildAt(document, parentId, ci) == nodeId:
                    for pj in 0..<ci:
                        let prevSibling = WebDocumentChildAt(document, parentId, pj)
                        if WebCssNodeMatchesSelectorSpan(document, prevSibling, selector, ancStart, ancStop):
                            return nodeId
                    break
    return 0

fn WebDocumentQuerySelectorAll(document: var WebDocument, selector: str, out: var int32[]): int32 =
    out = []
    var leftStop: int32
    var rightStart: int32
    var combType: int32
    if !WebCssFindSelectorSplitPoint(selector, leftStop, rightStart, combType):
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                if WebCssNodeMatchesSelectorSpan(document, document.nodes[ni].nodeId, selector, 0, selector.len - 1):
                    add(out, document.nodes[ni].nodeId)
        return out.len

    let ancStart = 0
    let ancStop = leftStop
    let descStart = rightStart
    let descStop = selector.len - 1

    if combType == int32(' '):
        var ancestors: int32[]
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                if WebCssNodeMatchesSelectorSpan(document, document.nodes[ni].nodeId, selector, ancStart, ancStop):
                    add(ancestors, document.nodes[ni].nodeId)
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                let nodeId = document.nodes[ni].nodeId
                if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                    continue
                for ai in 0..<ancestors.len:
                    if WebDocumentIsAncestorOf(document, ancestors[ai], nodeId):
                        add(out, nodeId)
                        break
        return out.len

    if combType == int32('>'):
        var parents: int32[]
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                if WebCssNodeMatchesSelectorSpan(document, document.nodes[ni].nodeId, selector, ancStart, ancStop):
                    add(parents, document.nodes[ni].nodeId)
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                let nodeId = document.nodes[ni].nodeId
                if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                    continue
                let parentId = WebDocumentParentOf(document, nodeId)
                for pi in 0..<parents.len:
                    if parentId == parents[pi]:
                        add(out, nodeId)
                        break
        return out.len

    if combType == int32('+'):
        for ni in 0..<document.nodes.len:
            if document.nodes[ni].kind == WebNodeKindElement:
                let nodeId = document.nodes[ni].nodeId
                if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                    continue
                let parentId = WebDocumentParentOf(document, nodeId)
                if parentId == 0:
                    continue
                let childCount = WebDocumentChildCount(document, parentId)
                for ci in 1..<childCount:
                    if WebDocumentChildAt(document, parentId, ci) == nodeId:
                        let prevSibling = WebDocumentChildAt(document, parentId, ci - 1)
                        if WebCssNodeMatchesSelectorSpan(document, prevSibling, selector, ancStart, ancStop):
                            add(out, nodeId)
                        break
        return out.len

    // General sibling combinator (~)
    for ni in 0..<document.nodes.len:
        if document.nodes[ni].kind == WebNodeKindElement:
            let nodeId = document.nodes[ni].nodeId
            if !WebCssNodeMatchesSelectorSpan(document, nodeId, selector, descStart, descStop):
                continue
            let parentId = WebDocumentParentOf(document, nodeId)
            if parentId == 0:
                continue
            let childCount = WebDocumentChildCount(document, parentId)
            for ci in 0..<childCount:
                if WebDocumentChildAt(document, parentId, ci) == nodeId:
                    for pj in 0..<ci:
                        let prevSibling = WebDocumentChildAt(document, parentId, pj)
                        if WebCssNodeMatchesSelectorSpan(document, prevSibling, selector, ancStart, ancStop):
                            add(out, nodeId)
                            break
                    break
    return out.len

// ──────────────────────────────────────
// ClassList operations
// ──────────────────────────────────────

@borrows
fn WebDocumentClassListContains(document: var WebDocument, nodeId: int32, className: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var current: str
    if !WebDocumentGetAttribute(document, nodeId, "class", current):
        return false
    var start: int32
    var i: int32
    while i <= current.len:
        let atEnd = i == current.len
        var split = atEnd
        if !split:
            let ch = current[i]
            split = ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r'
        if split:
            if i > start:
                let count = i - start
                if count == className.len:
                    var same = true
                    for k in 0..<count:
                        if current[start + k] != className[k]:
                            same = false
                            break
                    if same:
                        return true
            start = i + 1
        i = i + 1
    return false

fn WebDocumentClassListAdd(document: var WebDocument, nodeId: int32, className: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var current: str
    if !WebDocumentGetAttribute(document, nodeId, "class", current):
        current = ""
    // Check if already present
    var start: int32
    var i: int32
    while i <= current.len:
        let atEnd = i == current.len
        var split = atEnd
        if !split:
            let ch = current[i]
            split = ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r'
        if split:
            if i > start:
                let count = i - start
                if count == className.len:
                    var same = true
                    for k in 0..<count:
                        if current[start + k] != className[k]:
                            same = false
                            break
                    if same:
                        return true  // already present, no change
            start = i + 1
        i = i + 1
    if current.len > 0:
        current = Fmt"{current} {className}"
    else:
        current = className
    return WebDocumentSetAttribute(document, nodeId, "class", current)

@borrows
fn WebDocumentClassListRemove(document: var WebDocument, nodeId: int32, className: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    var current: str
    if !WebDocumentGetAttribute(document, nodeId, "class", current):
        return false
    var result = ""
    var wordStart: int32
    var i: int32
    var found = false
    while i <= current.len:
        let atEnd = i == current.len
        var split = atEnd
        if !split:
            let ch = current[i]
            split = ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r'
        if split:
            if i > wordStart:
                let count = i - wordStart
                var isTarget = false
                if count == className.len:
                    var same = true
                    for k in 0..<count:
                        if current[wordStart + k] != className[k]:
                            same = false
                            break
                    isTarget = same
                if !isTarget:
                    if result.len > 0:
                        result = Fmt"{result} "
                    for k in wordStart..<i:
                        result = Fmt"{result}{char(current[k])}"
                else:
                    found = true
            wordStart = i + 1
        i = i + 1
    if !found:
        return false
    return WebDocumentSetAttribute(document, nodeId, "class", result)

fn WebDocumentClassListToggle(document: var WebDocument, nodeId: int32, className: str): bool =
    if WebDocumentClassListContains(document, nodeId, className):
        WebDocumentClassListRemove(document, nodeId, className)
        return false
    else:
        WebDocumentClassListAdd(document, nodeId, className)
        return true

// ──────────────────────────────────────
// matches / closest
// ──────────────────────────────────────

fn WebDocumentMatches(document: var WebDocument, nodeId: int32, selector: str): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    return WebCssNodeMatchesSelectorSpan(document, nodeId, selector, 0, selector.len - 1)

fn WebDocumentClosest(document: var WebDocument, nodeId: int32, selector: str): int32 =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return 0
    var current = nodeId
    var steps = 0
    while current != 0:
        if WebCssNodeMatchesSelectorSpan(document, current, selector, 0, selector.len - 1):
            return current
        current = WebDocumentParentOf(document, current)
        steps = steps + 1
        if steps > document.nodes.len:
            break
    return 0

fn WebCssIsSpace(ch: char): bool =
    if ch == ' ':
        return true
    if ch == '\n':
        return true
    if ch == '\t':
        return true
    if ch == '\r':
        return true
    return false

fn WebDocumentGetComputedStyle(document: var WebDocument, nodeId: int32, out: var str): bool =
    if !WebDocumentNodeExists(document, nodeId):
        out = ""
        return false
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        out = ""
        return false

    var propNames: str[]
    var propValues: str[]

    # Phase 1: Parse CSS rules from styleSheetCss and collect matching declarations
    if document.styleSheetCss.len > 0:
        var i: int32
        while i < document.styleSheetCss.len:
            # Skip whitespace
            while i < document.styleSheetCss.len && WebCssIsSpace(document.styleSheetCss[i]):
                i = i + 1
            if i >= document.styleSheetCss.len:
                break
            # Skip comments /* ... */
            if i + 1 < document.styleSheetCss.len && document.styleSheetCss[i] == '/' && document.styleSheetCss[i + 1] == '*':
                i = i + 2
                while i + 1 < document.styleSheetCss.len && !(document.styleSheetCss[i] == '*' && document.styleSheetCss[i + 1] == '/'):
                    i = i + 1
                i = i + 2
                continue
            # Parse selector before '{'
            var selectorStart = i
            while i < document.styleSheetCss.len && document.styleSheetCss[i] != '{':
                i = i + 1
            if i >= document.styleSheetCss.len || document.styleSheetCss[i] != '{':
                break
            var selector = WebCssSpanToString(document.styleSheetCss, selectorStart, i - 1)
            # Trim selector
            while selector.len > 0 && WebCssIsSpace(selector[0]):
                selector = strings.SliceBytes(selector, 1, selector.len - 1)
            while selector.len > 0 && WebCssIsSpace(selector[selector.len - 1]):
                selector = strings.SliceBytes(selector, 0, selector.len - 1)
            i = i + 1  # skip '{'
            # Parse declarations until '}'
            var declStart = i
            while i < document.styleSheetCss.len && document.styleSheetCss[i] != '}':
                i = i + 1
            if i >= document.styleSheetCss.len:
                break
            var declText = WebCssSpanToString(document.styleSheetCss, declStart, i - 1)
            # Check if selector matches node
            var matches = false
            var tagVal: str
            if WebDocumentNodeTagName(document, nodeId, tagVal):
                if selector == tagVal:
                    matches = true
                elif selector.len >= 2 && selector[0] == '.':
                    let clsName = strings.SliceBytes(selector, 1, selector.len - 1)
                    if WebDocumentClassListContains(document, nodeId, clsName):
                        matches = true
                elif selector.len >= 2 && selector[0] == '#':
                    var idVal: str
                    if WebDocumentGetAttribute(document, nodeId, "id", idVal):
                        let idName = strings.SliceBytes(selector, 1, selector.len - 1)
                        if idVal == idName:
                            matches = true
            if matches:
                # Parse declarations from declText
                var j: int32
                while j < declText.len:
                    while j < declText.len && WebCssIsSpace(declText[j]):
                        j = j + 1
                    if j >= declText.len:
                        break
                    var propStart = j
                    while j < declText.len && declText[j] != ':':
                        j = j + 1
                    if j >= declText.len:
                        break
                    var propName = WebCssSpanToString(declText, propStart, j - 1)
                    j = j + 1  # skip ':'
                    while j < declText.len && WebCssIsSpace(declText[j]):
                        j = j + 1
                    var valStart = j
                    while j < declText.len && declText[j] != ';':
                        j = j + 1
                    var propVal = WebCssSpanToString(declText, valStart, j - 1)
                    # Trim property and value
                    while propName.len > 0 && WebCssIsSpace(propName[0]):
                        propName = strings.SliceBytes(propName, 1, propName.len - 1)
                    while propName.len > 0 && WebCssIsSpace(propName[propName.len - 1]):
                        propName = strings.SliceBytes(propName, 0, propName.len - 1)
                    while propVal.len > 0 && WebCssIsSpace(propVal[0]):
                        propVal = strings.SliceBytes(propVal, 1, propVal.len - 1)
                    while propVal.len > 0 && WebCssIsSpace(propVal[propVal.len - 1]):
                        propVal = strings.SliceBytes(propVal, 0, propVal.len - 1)
                    if propName.len > 0 && propVal.len > 0:
                        var found = false
                        for k in 0..<propNames.len:
                            if propNames[k] == propName:
                                propValues[k] = propVal
                                found = true
                                break
                        if !found:
                            add(propNames, propName)
                            add(propValues, propVal)
                    if j < declText.len && declText[j] == ';':
                        j = j + 1
            i = i + 1  # skip '}'

    # Phase 2: Inline styles (higher priority, override CSS rules)
    for idx in 0..<document.inlineStyles.len:
        if document.inlineStyles[idx].nodeId == nodeId:
            let name = document.inlineStyles[idx].name
            let value = document.inlineStyles[idx].value
            if name.len > 0 && value.len > 0:
                var found = false
                for k in 0..<propNames.len:
                    if propNames[k] == name:
                        propValues[k] = strings.CloneStr(value)
                        found = true
                        break
                if !found:
                    add(propNames, strings.CloneStr(name))
                    add(propValues, strings.CloneStr(value))

    # Build result string
    var result = ""
    for k in 0..<propNames.len:
        if result.len > 0:
            result = Fmt"{result}; {propNames[k]}: {propValues[k]}"
        else:
            result = Fmt"{propNames[k]}: {propValues[k]}"
    out = result
    return true

// ──────────────────────────────────────
// Bounding rect helpers
// ──────────────────────────────────────

fn WebDocumentSetBoundingRect(document: var WebDocument, nodeId: int32, x: int32, y: int32, width: int32, height: int32) =
    for i in 0..<document.boundingRects.len:
        if document.boundingRects[i].nodeId == nodeId:
            document.boundingRects[i].x = x
            document.boundingRects[i].y = y
            document.boundingRects[i].width = width
            document.boundingRects[i].height = height
            return
    var rect: BoundingRect
    rect.nodeId = nodeId
    rect.x = x
    rect.y = y
    rect.width = width
    rect.height = height
    add(document.boundingRects, rect)

// ──────────────────────────────────────
// IntersectionObserver
// ──────────────────────────────────────

fn WebInt32Max(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

fn WebInt32Min(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

fn WebIntersectionObserverInit(observer: var WebIntersectionObserver,
                               callbackId: int32,
                               thresholdPermille: int32): bool =
    if callbackId <= 0:
        return false
    if thresholdPermille < 0 || thresholdPermille > 1000:
        return false
    observer.callbackId = callbackId
    observer.thresholdPermille = thresholdPermille
    observer.observedNodeIds = []
    observer.recordTargetNodeIds = []
    observer.recordIsIntersecting = []
    observer.recordIntersectionRatioPermille = []
    return true

fn WebIntersectionObserverObservedCount(observer: var WebIntersectionObserver): int32 =
    return observer.observedNodeIds.len

fn WebIntersectionObserverThresholdPermille(observer: var WebIntersectionObserver): int32 =
    return observer.thresholdPermille

fn WebIntersectionObserverRecordCount(observer: var WebIntersectionObserver): int32 =
    return observer.recordTargetNodeIds.len

fn WebIntersectionObserverRecordIsIntersecting(observer: var WebIntersectionObserver, index: int32): bool =
    if index < 0 || index >= observer.recordIsIntersecting.len:
        return false
    return observer.recordIsIntersecting[index] != 0

fn WebIntersectionObserverRecordTarget(observer: var WebIntersectionObserver, index: int32): int32 =
    if index < 0 || index >= observer.recordTargetNodeIds.len:
        return 0
    return observer.recordTargetNodeIds[index]

fn WebIntersectionObserverRecordRatioPermille(observer: var WebIntersectionObserver, index: int32): int32 =
    if index < 0 || index >= observer.recordIntersectionRatioPermille.len:
        return 0
    return observer.recordIntersectionRatioPermille[index]

fn WebIntersectionObserverTakeRecords(observer: var WebIntersectionObserver,
                                      out: var WebIntersectionObserverEntry[]): int32 =
    var records: WebIntersectionObserverEntry[]
    for i in 0..<observer.recordTargetNodeIds.len:
        var entry: WebIntersectionObserverEntry
        entry.targetNodeId = observer.recordTargetNodeIds[i]
        entry.isIntersecting = observer.recordIsIntersecting[i] != 0
        entry.intersectionRatioPermille = observer.recordIntersectionRatioPermille[i]
        add(records, entry)
    out = records
    observer.recordTargetNodeIds = []
    observer.recordIsIntersecting = []
    observer.recordIntersectionRatioPermille = []
    return out.len

fn WebIntersectionObserverDisconnect(observer: var WebIntersectionObserver) =
    observer.observedNodeIds = []
    observer.recordTargetNodeIds = []
    observer.recordIsIntersecting = []
    observer.recordIntersectionRatioPermille = []

fn WebIntersectionObserverFindObservedIndex(observer: var WebIntersectionObserver, nodeId: int32): int32 =
    for i in 0..<observer.observedNodeIds.len:
        if observer.observedNodeIds[i] == nodeId:
            return i
    return -1

fn WebIntersectionObserverComputeRatioPermille(document: var WebDocument,
                                               window: var WebWindow,
                                               nodeId: int32): int32 =
    if !WebDocumentNodeExists(document, nodeId):
        return -1
    var rectIndex: int32 = -1
    for i in 0..<document.boundingRects.len:
        if document.boundingRects[i].nodeId == nodeId:
            rectIndex = i
            break
    if rectIndex < 0:
        return -1
    let x = document.boundingRects[rectIndex].x
    let y = document.boundingRects[rectIndex].y
    let w = document.boundingRects[rectIndex].width
    let h = document.boundingRects[rectIndex].height
    if w <= 0 || h <= 0:
        return 0
    let viewportLeft = window.scrollX
    let viewportTop = window.scrollY
    let viewportRight = window.scrollX + window.innerWidth
    let viewportBottom = window.scrollY + window.innerHeight
    let rectRight = x + w
    let rectBottom = y + h
    let interLeft = WebInt32Max(x, viewportLeft)
    let interTop = WebInt32Max(y, viewportTop)
    let interRight = WebInt32Min(rectRight, viewportRight)
    let interBottom = WebInt32Min(rectBottom, viewportBottom)
    let interWidth = interRight - interLeft
    let interHeight = interBottom - interTop
    if interWidth <= 0 || interHeight <= 0:
        return 0
    let area = w * h
    let interArea = interWidth * interHeight
    if area <= 0:
        return 0
    return (interArea * 1000) / area

fn WebIntersectionObserverIsIntersecting(observer: var WebIntersectionObserver, ratioPermille: int32): int32 =
    if ratioPermille < 0:
        return 0
    if observer.thresholdPermille == 0 && ratioPermille > 0:
        return 1
    if ratioPermille >= observer.thresholdPermille:
        return 1
    return 0

fn WebIntersectionObserverQueueEntry(observer: var WebIntersectionObserver,
                                     window: var WebWindow,
                                     nodeId: int32,
                                     isIntersecting: int32,
                                     ratioPermille: int32) =
    add(observer.recordTargetNodeIds, nodeId)
    if isIntersecting != 0:
        add(observer.recordIsIntersecting, 1)
    else:
        add(observer.recordIsIntersecting, 0)
    add(observer.recordIntersectionRatioPermille, ratioPermille)
    WebWindowRecordDispatchStep(window, "intersectionobserver", observer.callbackId, WebEventPhaseTarget)

fn WebIntersectionObserverObserve(observer: var WebIntersectionObserver,
                                  document: var WebDocument,
                                  window: var WebWindow,
                                  nodeId: int32): bool =
    if observer.callbackId <= 0:
        return false
    if !WebDocumentNodeExists(document, nodeId):
        return false
    if WebIntersectionObserverFindObservedIndex(observer, nodeId) < 0:
        add(observer.observedNodeIds, nodeId)
    let ratioPermille = WebIntersectionObserverComputeRatioPermille(document, window, nodeId)
    if ratioPermille < 0:
        return false
    let isIntersecting = WebIntersectionObserverIsIntersecting(observer, ratioPermille)
    WebIntersectionObserverQueueEntry(observer, window, nodeId, isIntersecting, ratioPermille)
    return true

fn WebIntersectionObserverEvaluate(observer: var WebIntersectionObserver,
                                   document: var WebDocument,
                                   window: var WebWindow): int32 =
    var queued: int32
    for i in 0..<observer.observedNodeIds.len:
        let nodeId = observer.observedNodeIds[i]
        let ratioPermille = WebIntersectionObserverComputeRatioPermille(document, window, nodeId)
        if ratioPermille >= 0:
            let isIntersecting = WebIntersectionObserverIsIntersecting(observer, ratioPermille)
            WebIntersectionObserverQueueEntry(observer, window, nodeId, isIntersecting, ratioPermille)
            queued = queued + 1
    return queued

// ──────────────────────────────────────
// offsetParent helper
// ──────────────────────────────────────

fn WebDocumentOffsetParent(document: var WebDocument, nodeId: int32): int32 =
    if !WebDocumentNodeExists(document, nodeId):
        return 0
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return 0
    var current = WebDocumentParentOf(document, nodeId)
    var steps = 0
    while current != 0:
        if current == document.bodyNodeId:
            return current
        var pos: str
        if WebDocumentGetInlineStyleValue(document, current, "position", pos):
            if pos != "" && pos != "static":
                return current
        current = WebDocumentParentOf(document, current)
        steps = steps + 1
        if steps > document.nodes.len:
            break
    if document.bodyNodeId != 0 && WebDocumentNodeExists(document, document.bodyNodeId):
        return document.bodyNodeId
    return 0

fn WebDocumentOffsetTop(document: var WebDocument, nodeId: int32): int32 =
    var elemX: int32
    var elemY: int32
    var elemW: int32
    var elemH: int32
    if !WebDocumentGetBoundingClientRect(document, nodeId, elemX, elemY, elemW, elemH):
        return 0
    let parentId = WebDocumentOffsetParent(document, nodeId)
    if parentId == 0:
        return elemY
    var parentX: int32
    var parentY: int32
    var parentW: int32
    var parentH: int32
    if !WebDocumentGetBoundingClientRect(document, parentId, parentX, parentY, parentW, parentH):
        return elemY
    return elemY - parentY

fn WebDocumentOffsetLeft(document: var WebDocument, nodeId: int32): int32 =
    var elemX: int32
    var elemY: int32
    var elemW: int32
    var elemH: int32
    if !WebDocumentGetBoundingClientRect(document, nodeId, elemX, elemY, elemW, elemH):
        return 0
    let parentId = WebDocumentOffsetParent(document, nodeId)
    if parentId == 0:
        return elemX
    var parentX: int32
    var parentY: int32
    var parentW: int32
    var parentH: int32
    if !WebDocumentGetBoundingClientRect(document, parentId, parentX, parentY, parentW, parentH):
        return elemX
    return elemX - parentX

fn WebDocumentOffsetWidth(document: var WebDocument, nodeId: int32): int32 =
    var x: int32
    var y: int32
    var w: int32
    var h: int32
    if !WebDocumentGetBoundingClientRect(document, nodeId, x, y, w, h):
        return 0
    return w

fn WebDocumentOffsetHeight(document: var WebDocument, nodeId: int32): int32 =
    var x: int32
    var y: int32
    var w: int32
    var h: int32
    if !WebDocumentGetBoundingClientRect(document, nodeId, x, y, w, h):
        return 0
    return h

// ──────────────────────────────────────
// Scroll helpers
// ──────────────────────────────────────

fn WebDocumentScrollTop(document: var WebDocument, nodeId: int32): int32 =
    if !WebDocumentNodeExists(document, nodeId):
        return 0
    return document.scrollTop

fn WebDocumentScrollLeft(document: var WebDocument, nodeId: int32): int32 =
    if !WebDocumentNodeExists(document, nodeId):
        return 0
    return document.scrollLeft

fn WebDocumentSetScrollTop(document: var WebDocument, nodeId: int32, value: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    document.scrollTop = value
    return true

fn WebDocumentSetScrollLeft(document: var WebDocument, nodeId: int32, value: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    document.scrollLeft = value
    return true

fn WebDocumentScrollWidth(document: var WebDocument, nodeId: int32): int32 =
    var x: int32
    var y: int32
    var w: int32
    var h: int32
    if !WebDocumentGetBoundingClientRect(document, nodeId, x, y, w, h):
        return 0
    return w

fn WebDocumentScrollHeight(document: var WebDocument, nodeId: int32): int32 =
    var x: int32
    var y: int32
    var w: int32
    var h: int32
    if !WebDocumentGetBoundingClientRect(document, nodeId, x, y, w, h):
        return 0
    return h

// ──────────────────────────────────────
// DOM element layout / interaction
// ──────────────────────────────────────

fn WebDocumentGetBoundingClientRect(document: var WebDocument, nodeId: int32, outX: var int32, outY: var int32, outW: var int32, outH: var int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        outX = 0
        outY = 0
        outW = 0
        outH = 0
        return false
    for i in 0..<document.boundingRects.len:
        if document.boundingRects[i].nodeId == nodeId:
            outX = document.boundingRects[i].x
            outY = document.boundingRects[i].y
            outW = document.boundingRects[i].width
            outH = document.boundingRects[i].height
            return true
    outX = 0
    outY = 0
    outW = 0
    outH = 0
    return false

fn WebDocumentActiveElement(document: var WebDocument): int32 =
    if document.activeElementNodeId == 0:
        return 0
    if !WebDocumentNodeExists(document, document.activeElementNodeId):
        document.activeElementNodeId = 0
        return 0
    if !WebDocumentNodeConnected(document, document.activeElementNodeId):
        document.activeElementNodeId = 0
        return 0
    if WebDocumentNodeKind(document, document.activeElementNodeId) != WebNodeKindElement:
        document.activeElementNodeId = 0
        return 0
    return document.activeElementNodeId

fn WebDocumentBlur(document: var WebDocument, nodeId: int32): bool =
    if WebDocumentActiveElement(document) != nodeId:
        return false
    var blurEvent: WebEvent
    WebEventInitWithOptions(blurEvent, "blur", false, false)
    if !WebDispatchEvent(document, nodeId, blurEvent):
        return false
    document.activeElementNodeId = 0
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "blur", "", 0, 0)
    return true

fn WebDocumentFocus(document: var WebDocument, nodeId: int32): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    if !WebDocumentNodeConnected(document, nodeId):
        return false
    let currentActive = WebDocumentActiveElement(document)
    if currentActive == nodeId:
        return true
    if currentActive != 0:
        var blurEvent: WebEvent
        WebEventInitWithOptions(blurEvent, "blur", false, false)
        if !WebDispatchEvent(document, currentActive, blurEvent):
            return false
    document.activeElementNodeId = nodeId
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "focus", "", 0, 0)
    var focusEvent: WebEvent
    WebEventInitWithOptions(focusEvent, "focus", false, false)
    if !WebDispatchEvent(document, nodeId, focusEvent):
        document.activeElementNodeId = 0
        return false
    return true

fn WebDocumentClick(document: var WebDocument, nodeId: int32): bool =
    if !WebDocumentNodeExists(document, nodeId):
        return false
    WebDocumentRecordMutation(document, WebMutationKindSetAttribute, nodeId, "click", "", 0, 0)
    return true

fn WebDocumentSetHover(document: var WebDocument, nodeId: int32) =
    document.hoverNodeId = nodeId

fn WebDocumentClearHover(document: var WebDocument) =
    document.hoverNodeId = 0

fn WebDocumentSetActive(document: var WebDocument, nodeId: int32) =
    document.activeNodeId = nodeId

fn WebDocumentClearActive(document: var WebDocument) =
    document.activeNodeId = 0

// ──────────────────────────────────────
// URL constructor / parsing
// ──────────────────────────────────────

@borrows
fn WebUrlParse(url: str): WebUrl =
    var result: WebUrl
    result.href = strings.CloneStr(url)
    result.protocol = ""
    result.hostname = ""
    result.port = ""
    result.pathname = ""
    result.search = ""
    result.hash = ""

    if url.len <= 0:
        return result

    var hashPos: int32 = -1
    var searchPos: int32 = -1
    var protocolPos: int32 = -1
    var i: int32

    i = 0
    while i < url.len:
        if url[i] == '#':
            hashPos = i
            i = url.len
        i = i + 1

    i = 0
    while i < url.len:
        if url[i] == '?':
            if hashPos < 0 || i < hashPos:
                searchPos = i
                i = url.len
        i = i + 1

    if hashPos >= 0:
        result.hash = WebCssSpanToString(url, hashPos, url.len - 1)

    if searchPos >= 0:
        let searchEnd = hashPos >= 0 ? hashPos : url.len
        result.search = WebCssSpanToString(url, searchPos, searchEnd - 1)

    let pathEnd = searchPos >= 0 ? searchPos : (hashPos >= 0 ? hashPos : url.len)

    i = 0
    while i < url.len && i < pathEnd:
        if url[i] == ':' && i + 2 < url.len && url[i + 1] == '/' && url[i + 2] == '/':
            protocolPos = i
            i = url.len
        i = i + 1

    if protocolPos >= 0:
        result.protocol = WebCssSpanToString(url, 0, protocolPos)

        let afterProtocol = protocolPos + 3
        var hostStart = afterProtocol
        var hostEnd = hostStart
        while hostEnd < pathEnd && url[hostEnd] != '/' && url[hostEnd] != '?' && url[hostEnd] != '#':
            hostEnd = hostEnd + 1

        var portPos: int32 = -1
        i = hostStart
        while i < hostEnd:
            if url[i] == ':':
                portPos = i
                i = hostEnd
            i = i + 1

        if portPos >= 0:
            result.hostname = WebCssSpanToString(url, hostStart, portPos - 1)
            result.port = WebCssSpanToString(url, portPos + 1, hostEnd - 1)
        else:
            result.hostname = WebCssSpanToString(url, hostStart, hostEnd - 1)

        if hostEnd < pathEnd:
            result.pathname = WebCssSpanToString(url, hostEnd, pathEnd - 1)
        else:
            result.pathname = "/"
    else:
        if url.len >= 7 && url[0] == 'f' && url[1] == 'i' && url[2] == 'l' && url[3] == 'e' && url[4] == ':' && url[5] == '/' && url[6] == '/':
            result.protocol = "file:"
            var pathStart: int32 = 7
            if pathStart < pathEnd:
                result.pathname = WebCssSpanToString(url, pathStart, pathEnd - 1)
            else:
                result.pathname = "/"
        else:
            result.pathname = WebCssSpanToString(url, 0, pathEnd - 1)

    return result

fn WebUrlToString(url: var WebUrl): str =
    return url.href

