    WebNodeKindDocument = 1
    WebNodeKindElement = 2
    WebNodeKindText = 3
    WebEventPhaseCapture = 1
    WebEventPhaseTarget = 2
    WebEventPhaseBubble = 3
    EVENT_PHASE_NONE = 0

    WebMutationKindCreateNode = 1
    WebMutationKindSetAttribute = 2
    WebMutationKindAppendChild = 3
    WebMutationKindRemoveChild = 4
    WebMutationKindInsertBefore = 5
    WebMutationKindReplaceChild = 6
    WebMutationKindSetTextContent = 7

    DOCUMENT_POSITION_DISCONNECTED = 1
    DOCUMENT_POSITION_PRECEDING = 2
    DOCUMENT_POSITION_FOLLOWING = 4
    DOCUMENT_POSITION_CONTAINS = 8
    DOCUMENT_POSITION_CONTAINED_BY = 16

    WebAnimationIdle = 0
    WebAnimationRunning = 1
    WebAnimationPaused = 2
    WebAnimationFinished = 3

    WebAnimationFillNone = 0
    WebAnimationFillForwards = 1
    WebAnimationFillBackwards = 2
    WebAnimationFillBoth = 3

