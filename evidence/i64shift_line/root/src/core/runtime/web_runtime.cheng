// Platform APIs
// ──────────────────────────────────────

fn WebAbortControllerInit(): int32 =
    return 1

fn WebAbortSignal(controllerId: int32): int32 =
    if controllerId != 0:
        return controllerId
    return 0

fn WebAbortControllerAbort(controllerId: int32) =
    return

fn WebUrlSearchParamsInit(): int32 =
    return 1

fn WebUrlSearchParamsAppend(paramsId: int32, key: str, value: str) =
    return

fn WebUrlSearchParamsToString(paramsId: int32): str =
    return ""

fn WebCryptoGetRandomInt32Array(length: int32): int32[] =
    var result: int32[]
    if length <= 0:
        return result
    let byteCount = length * 4
    for i in 0..<length:
        add(result, 0)
    if cheng_crypto_random_bytes(ptr(result), byteCount) != byteCount:
        panic("crypto random bytes failed")
    return result

fn WebStreamGetTracks(streamId: int32): int32[] = return []

fn WebRequestAnimationFrame(window: var WebWindow, callbackId: int32): int32 =
    if callbackId <= 0:
        return 0
    window.nextAnimationFrameId = window.nextAnimationFrameId + 1
    var entry: WebAnimationFrameEntry
    entry.requestId = window.nextAnimationFrameId
    entry.callbackId = callbackId
    add(window.animationCallbacks, entry)
    return window.nextAnimationFrameId

# ──────────────────────────────────────
# Canvas 2D Rendering Context
# ──────────────────────────────────────

fn WebCanvasMaxInt32(a: int32, b: int32): int32 =
    if a > b: return a
    return b

fn WebCanvasMinInt32(a: int32, b: int32): int32 =
    if a < b: return a
    return b

fn WebCanvasHexDigit(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    return 0

fn WebCanvasParseColor(color: str, r: var int32, g: var int32, b: var int32, a: var int32): bool =
    a = 255
    if color.len <= 0:
        r = 0; g = 0; b = 0; a = 255
        return false
    if color[0] == '#':
        if color.len == 4:
            let ri = WebCanvasHexDigit(color[1])
            let gi = WebCanvasHexDigit(color[2])
            let bi = WebCanvasHexDigit(color[3])
            r = ri * 17
            g = gi * 17
            b = bi * 17
            a = 255
            return true
        if color.len == 7:
            r = WebCanvasHexDigit(color[1]) * 16 + WebCanvasHexDigit(color[2])
            g = WebCanvasHexDigit(color[3]) * 16 + WebCanvasHexDigit(color[4])
            b = WebCanvasHexDigit(color[5]) * 16 + WebCanvasHexDigit(color[6])
            a = 255
            return true
        r = 0; g = 0; b = 0; a = 255
        return false
    elif color == "red":
        r = 255; g = 0; b = 0; a = 255; return true
    elif color == "blue":
        r = 0; g = 0; b = 255; a = 255; return true
    elif color == "green":
        r = 0; g = 128; b = 0; a = 255; return true
    elif color == "black":
        r = 0; g = 0; b = 0; a = 255; return true
    elif color == "white":
        r = 255; g = 255; b = 255; a = 255; return true
    elif color == "yellow":
        r = 255; g = 255; b = 0; a = 255; return true
    elif color == "orange":
        r = 255; g = 165; b = 0; a = 255; return true
    elif color == "purple":
        r = 128; g = 0; b = 128; a = 255; return true
    elif color == "transparent":
        r = 0; g = 0; b = 0; a = 0; return true
    elif color == "gray" || color == "grey":
        r = 128; g = 128; b = 128; a = 255; return true
    r = 0; g = 0; b = 0; a = 255
    return false

fn WebCanvasColorPack(r: int32, g: int32, b: int32, a: int32): int32 =
    return (a << 24) | (r << 16) | (g << 8) | b

fn WebCanvasParseInt(s: str): int32 =
    var result: int32
    for i in 0..<s.len:
        let ch = s[i]
        if ch >= '0' && ch <= '9':
            result = result * 10 + (int32(ch) - int32('0'))
        else:
            break
    return result

fn WebCanvasInit(canvasId: int32, width: int32, height: int32): WebCanvasState =
    var state: WebCanvasState
    state.canvasId = canvasId
    state.width = width
    state.height = height
    state.fillStyle = "#000000"
    state.strokeStyle = "#000000"
    state.lineWidth = 1
    state.font = "10px sans-serif"
    state.textAlign = "left"
    state.textBaseline = "alphabetic"
    state.globalAlpha = 255
    state.pixels = []
    let pixelCount = width * height
    for i in 0..<pixelCount:
        add(state.pixels, 0xFFFFFFFF)
    state.transformA = float64(1.0)
    state.transformB = float64(0.0)
    state.transformC = float64(0.0)
    state.transformD = float64(1.0)
    state.transformE = float64(0.0)
    state.transformF = float64(0.0)
    state.savedStates = []
    state.dirty = false
    state.currentPath = []
    state.currentX = 0
    state.currentY = 0
    state.hasCurrentPoint = false
    return state

fn WebCanvasGetContext(window: var WebWindow, document: var WebDocument, canvasId: int32, contextType: str): int32 =
    if contextType != "2d":
        return 0
    for i in 0..<window.canvasStates.len:
        if window.canvasStates[i].canvasId == canvasId:
            return i + 1
    var width: int32 = 300
    var height: int32 = 150
    var widthStr: str
    if WebDocumentGetAttribute(document, canvasId, "width", widthStr) && widthStr.len > 0:
        width = WebCanvasParseInt(widthStr)
    var heightStr: str
    if WebDocumentGetAttribute(document, canvasId, "height", heightStr) && heightStr.len > 0:
        height = WebCanvasParseInt(heightStr)
    if width <= 0: width = 300
    if height <= 0: height = 150
    let state = WebCanvasInit(canvasId, width, height)
    add(window.canvasStates, state)
    return window.canvasStates.len

fn WebCanvasApplyTransform(canvas: var WebCanvasState, x: int32, y: int32, w: int32, h: int32,
                            outX: var int32, outY: var int32, outW: var int32, outH: var int32) =
    let fx = float64(x)
    let fy = float64(y)
    let fw = float64(w)
    let fh = float64(h)
    let ta = canvas.transformA
    let tb = canvas.transformB
    let tc = canvas.transformC
    let td = canvas.transformD
    let te = canvas.transformE
    let tf = canvas.transformF
    let x1 = int32(ta * fx + tc * fy + te)
    let y1 = int32(tb * fx + td * fy + tf)
    let x2 = int32(ta * (fx + fw) + tc * fy + te)
    let y2 = int32(tb * (fx + fw) + td * fy + tf)
    let x3 = int32(ta * fx + tc * (fy + fh) + te)
    let y3 = int32(tb * fx + td * (fy + fh) + tf)
    let x4 = int32(ta * (fx + fw) + tc * (fy + fh) + te)
    let y4 = int32(tb * (fx + fw) + td * (fy + fh) + tf)
    let minX = WebCanvasMinInt32(WebCanvasMinInt32(WebCanvasMinInt32(x1, x2), x3), x4)
    let minY = WebCanvasMinInt32(WebCanvasMinInt32(WebCanvasMinInt32(y1, y2), y3), y4)
    let maxX = WebCanvasMaxInt32(WebCanvasMaxInt32(WebCanvasMaxInt32(x1, x2), x3), x4)
    let maxY = WebCanvasMaxInt32(WebCanvasMaxInt32(WebCanvasMaxInt32(y1, y2), y3), y4)
    outX = minX
    outY = minY
    outW = maxX - minX
    outH = maxY - minY

fn WebCanvasFillRectDevice(canvas: var WebCanvasState, x: int32, y: int32, w: int32, h: int32, color: int32) =
    if w <= 0 || h <= 0: return
    let clippedX = WebCanvasMaxInt32(x, 0)
    let clippedY = WebCanvasMaxInt32(y, 0)
    let clippedRight = WebCanvasMinInt32(x + w, canvas.width)
    let clippedBottom = WebCanvasMinInt32(y + h, canvas.height)
    if clippedX >= clippedRight || clippedY >= clippedBottom: return
    for py in clippedY..<clippedBottom:
        let rowOffset = py * canvas.width
        for px in clippedX..<clippedRight:
            canvas.pixels[rowOffset + px] = color

fn WebCanvasFillRect(canvas: var WebCanvasState, x: int32, y: int32, w: int32, h: int32) =
    if w <= 0 || h <= 0: return
    var tx: int32
    var ty: int32
    var tw: int32
    var th: int32
    WebCanvasApplyTransform(canvas, x, y, w, h, tx, ty, tw, th)
    if tw <= 0 || th <= 0: return
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if !WebCanvasParseColor(canvas.fillStyle, r, g, b, a): return
    a = a * canvas.globalAlpha / 255
    let color = WebCanvasColorPack(r, g, b, a)
    WebCanvasFillRectDevice(canvas, tx, ty, tw, th, color)
    canvas.dirty = true

fn WebCanvasStrokeRect(canvas: var WebCanvasState, x: int32, y: int32, w: int32, h: int32) =
    if w <= 0 || h <= 0: return
    var tx: int32
    var ty: int32
    var tw: int32
    var th: int32
    WebCanvasApplyTransform(canvas, x, y, w, h, tx, ty, tw, th)
    if tw <= 0 || th <= 0: return
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if !WebCanvasParseColor(canvas.strokeStyle, r, g, b, a): return
    a = a * canvas.globalAlpha / 255
    let color = WebCanvasColorPack(r, g, b, a)
    let bw = canvas.lineWidth
    if bw <= 0: return
    let rightEdge = tx + tw
    let bottomEdge = ty + th
    WebCanvasFillRectDevice(canvas, tx, ty, tw, bw, color)
    WebCanvasFillRectDevice(canvas, tx, bottomEdge - bw, tw, bw, color)
    WebCanvasFillRectDevice(canvas, tx, ty + bw, bw, th - bw - bw, color)
    WebCanvasFillRectDevice(canvas, rightEdge - bw, ty + bw, bw, th - bw - bw, color)
    canvas.dirty = true

fn WebCanvasClearRect(canvas: var WebCanvasState, x: int32, y: int32, w: int32, h: int32) =
    if w <= 0 || h <= 0: return
    var tx: int32
    var ty: int32
    var tw: int32
    var th: int32
    WebCanvasApplyTransform(canvas, x, y, w, h, tx, ty, tw, th)
    if tw <= 0 || th <= 0: return
    WebCanvasFillRectDevice(canvas, tx, ty, tw, th, 0xFFFFFFFF)
    canvas.dirty = true

fn WebCanvasFillText(canvas: var WebCanvasState, text: str, x: int32, y: int32) =
    if text.len <= 0: return
    var tx: int32
    var ty: int32
    var tw: int32
    var th: int32
    WebCanvasApplyTransform(canvas, x, y, 1, 1, tx, ty, tw, th)
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if !WebCanvasParseColor(canvas.fillStyle, r, g, b, a): return
    a = a * canvas.globalAlpha / 255
    let color = WebCanvasColorPack(r, g, b, a)
    let charWidth: int32 = 8
    let lineHeight: int32 = 16
    let textWidth = text.len * charWidth
    var startX = tx
    if canvas.textAlign == "center":
        startX = tx - textWidth / 2
    elif canvas.textAlign == "right":
        startX = tx - textWidth
    var textY = ty
    if canvas.textBaseline == "top":
        textY = ty
    elif canvas.textBaseline == "middle":
        textY = ty - lineHeight / 2
    elif canvas.textBaseline == "bottom":
        textY = ty - lineHeight
    else:
        textY = ty - lineHeight + 12
    for i in 0..<text.len:
        let ch = text[i]
        if ch != ' ':
            let cx = startX + i * charWidth
            WebCanvasFillRectDevice(canvas, cx, textY, charWidth, lineHeight, color)
    canvas.dirty = true

fn WebCanvasStrokeText(canvas: var WebCanvasState, text: str, x: int32, y: int32) =
    if text.len <= 0: return
    var tx: int32
    var ty: int32
    var tw: int32
    var th: int32
    WebCanvasApplyTransform(canvas, x, y, 1, 1, tx, ty, tw, th)
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if !WebCanvasParseColor(canvas.strokeStyle, r, g, b, a): return
    a = a * canvas.globalAlpha / 255
    let color = WebCanvasColorPack(r, g, b, a)
    let charWidth: int32 = 8
    let lineHeight: int32 = 16
    let textWidth = text.len * charWidth
    var startX = tx
    if canvas.textAlign == "center":
        startX = tx - textWidth / 2
    elif canvas.textAlign == "right":
        startX = tx - textWidth
    var textY = ty
    if canvas.textBaseline == "top":
        textY = ty
    elif canvas.textBaseline == "middle":
        textY = ty - lineHeight / 2
    elif canvas.textBaseline == "bottom":
        textY = ty - lineHeight
    else:
        textY = ty - lineHeight + 12
    let strokeW: int32 = 1
    for i in 0..<text.len:
        let ch = text[i]
        if ch != ' ':
            let cx = startX + i * charWidth
            WebCanvasFillRectDevice(canvas, cx, textY, charWidth, strokeW, color)
            WebCanvasFillRectDevice(canvas, cx, textY + lineHeight - strokeW, charWidth, strokeW, color)
            WebCanvasFillRectDevice(canvas, cx, textY + strokeW, strokeW, lineHeight - strokeW - strokeW, color)
            WebCanvasFillRectDevice(canvas, cx + charWidth - strokeW, textY + strokeW, strokeW, lineHeight - strokeW - strokeW, color)
    canvas.dirty = true

fn WebCanvasSetFillStyle(canvas: var WebCanvasState, color: str) =
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if WebCanvasParseColor(color, r, g, b, a):
        canvas.fillStyle = color

fn WebCanvasSetStrokeStyle(canvas: var WebCanvasState, color: str) =
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if WebCanvasParseColor(color, r, g, b, a):
        canvas.strokeStyle = color

fn WebCanvasSetLineWidth(canvas: var WebCanvasState, width: int32) =
    if width >= 0:
        canvas.lineWidth = width

fn WebCanvasSetFont(canvas: var WebCanvasState, font: str) =
    canvas.font = font

fn WebCanvasSetGlobalAlpha(canvas: var WebCanvasState, alpha: int32) =
    if alpha >= 0 && alpha <= 255:
        canvas.globalAlpha = alpha

fn WebCanvasGetPixel(canvas: var WebCanvasState, x: int32, y: int32): int32 =
    if x < 0 || y < 0 || x >= canvas.width || y >= canvas.height:
        return 0
    let index = y * canvas.width + x
    if index < 0 || index >= canvas.pixels.len:
        return 0
    return canvas.pixels[index]

fn WebCanvasToDataURL(canvas: var WebCanvasState, out: var str): bool =
    if canvas.width <= 0 || canvas.height <= 0:
        out = "data:,"
        return false
    out = Fmt"data:image/cheng-rgba;width={canvas.width};height={canvas.height};pixels={canvas.pixels.len}"
    return true

fn WebCanvasSave(canvas: var WebCanvasState) =
    var saved: WebCanvasState
    saved.canvasId = canvas.canvasId
    saved.width = canvas.width
    saved.height = canvas.height
    saved.fillStyle = canvas.fillStyle
    saved.strokeStyle = canvas.strokeStyle
    saved.lineWidth = canvas.lineWidth
    saved.font = canvas.font
    saved.textAlign = canvas.textAlign
    saved.textBaseline = canvas.textBaseline
    saved.globalAlpha = canvas.globalAlpha
    saved.pixels = []
    saved.transformA = canvas.transformA
    saved.transformB = canvas.transformB
    saved.transformC = canvas.transformC
    saved.transformD = canvas.transformD
    saved.transformE = canvas.transformE
    saved.transformF = canvas.transformF
    saved.savedStates = []
    saved.dirty = canvas.dirty
    saved.currentPath = canvas.currentPath
    saved.currentX = canvas.currentX
    saved.currentY = canvas.currentY
    saved.hasCurrentPoint = canvas.hasCurrentPoint
    add(canvas.savedStates, saved)

fn WebCanvasRestore(canvas: var WebCanvasState) =
    if canvas.savedStates.len <= 0: return
    let savedIndex = canvas.savedStates.len - 1
    canvas.fillStyle = canvas.savedStates[savedIndex].fillStyle
    canvas.strokeStyle = canvas.savedStates[savedIndex].strokeStyle
    canvas.lineWidth = canvas.savedStates[savedIndex].lineWidth
    canvas.font = canvas.savedStates[savedIndex].font
    canvas.textAlign = canvas.savedStates[savedIndex].textAlign
    canvas.textBaseline = canvas.savedStates[savedIndex].textBaseline
    canvas.globalAlpha = canvas.savedStates[savedIndex].globalAlpha
    canvas.transformA = canvas.savedStates[savedIndex].transformA
    canvas.transformB = canvas.savedStates[savedIndex].transformB
    canvas.transformC = canvas.savedStates[savedIndex].transformC
    canvas.transformD = canvas.savedStates[savedIndex].transformD
    canvas.transformE = canvas.savedStates[savedIndex].transformE
    canvas.transformF = canvas.savedStates[savedIndex].transformF
    canvas.dirty = canvas.savedStates[savedIndex].dirty
    canvas.currentPath = canvas.savedStates[savedIndex].currentPath
    canvas.currentX = canvas.savedStates[savedIndex].currentX
    canvas.currentY = canvas.savedStates[savedIndex].currentY
    canvas.hasCurrentPoint = canvas.savedStates[savedIndex].hasCurrentPoint
    var newStack: WebCanvasState[]
    for i in 0..<savedIndex:
        add(newStack, share(canvas.savedStates[i]))
    canvas.savedStates = newStack

fn WebCanvasTranslate(canvas: var WebCanvasState, tx: int32, ty: int32) =
    canvas.transformE = canvas.transformE + float64(tx)
    canvas.transformF = canvas.transformF + float64(ty)

fn WebCanvasScale(canvas: var WebCanvasState, sx: float64, sy: float64) =
    canvas.transformA = canvas.transformA * sx
    canvas.transformB = canvas.transformB * sy
    canvas.transformC = canvas.transformC * sx
    canvas.transformD = canvas.transformD * sy
    canvas.transformE = canvas.transformE * sx
    canvas.transformF = canvas.transformF * sy

fn WebCanvasSin(x: float64): float64 =
    let pi = float64(3.141592653589793)
    let twoPi = pi * float64(2.0)
    var xr = x
    while xr > pi: xr = xr - twoPi
    while xr < float64(0.0) - pi: xr = xr + twoPi
    let x2 = xr * xr
    let x3 = x2 * xr
    let x5 = x3 * x2
    let x7 = x5 * x2
    let x9 = x7 * x2
    return xr - x3/float64(6.0) + x5/float64(120.0) - x7/float64(5040.0) + x9/float64(362880.0)

fn WebCanvasCos(x: float64): float64 =
    let pi = float64(3.141592653589793)
    let twoPi = pi * float64(2.0)
    var xr = x
    while xr > pi: xr = xr - twoPi
    while xr < float64(0.0) - pi: xr = xr + twoPi
    let x2 = xr * xr
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x6 * x2
    return float64(1.0) - x2/float64(2.0) + x4/float64(24.0) - x6/float64(720.0) + x8/float64(40320.0)

fn WebCanvasRotate(canvas: var WebCanvasState, angle: float64) =
    let c = WebCanvasCos(angle)
    let s = WebCanvasSin(angle)
    let ta = canvas.transformA
    let tb = canvas.transformB
    let tc = canvas.transformC
    let td = canvas.transformD
    let te = canvas.transformE
    let tf = canvas.transformF
    canvas.transformA = c * ta - s * tb
    canvas.transformB = s * ta + c * tb
    canvas.transformC = c * tc - s * td
    canvas.transformD = s * tc + c * td
    canvas.transformE = c * te - s * tf
    canvas.transformF = s * te + c * tf

fn WebCanvasAbs(x: int32): int32 =
    if x < 0: return -x
    return x

fn WebCanvasDrawLineDevice(canvas: var WebCanvasState, x0: int32, y0: int32, x1: int32, y1: int32, color: int32) =
    # Bresenham's line algorithm
    let dx = WebCanvasAbs(x1 - x0)
    let dy = -WebCanvasAbs(y1 - y0)
    var sx: int32 = 1
    var sy: int32 = 1
    if x0 > x1: sx = -1
    if y0 > y1: sy = -1
    var err = dx + dy
    var x = x0
    var y = y0
    while true:
        if x >= 0 && x < canvas.width && y >= 0 && y < canvas.height:
            canvas.pixels[y * canvas.width + x] = color
        if x == x1 && y == y1:
            break
        let e2 = 2 * err
        if e2 >= dy:
            err = err + dy
            x = x + sx
        if e2 <= dx:
            err = err + dx
            y = y + sy

fn WebCanvasFillPath(canvas: var WebCanvasState, color: int32) =
    # Build edges list from all subpaths
    var edgesX0: int32[]
    var edgesY0: int32[]
    var edgesX1: int32[]
    var edgesY1: int32[]
    for si in 0..<canvas.currentPath.len:
        let subpath = canvas.currentPath[si]
        if subpath.points.len < 2:
            continue
        for pi in 0..<subpath.points.len - 1:
            add(edgesX0, subpath.points[pi].x)
            add(edgesY0, subpath.points[pi].y)
            add(edgesX1, subpath.points[pi + 1].x)
            add(edgesY1, subpath.points[pi + 1].y)
        if subpath.closed:
            let last = subpath.points.len - 1
            if subpath.points[last].x != subpath.points[0].x || subpath.points[last].y != subpath.points[0].y:
                add(edgesX0, subpath.points[last].x)
                add(edgesY0, subpath.points[last].y)
                add(edgesX1, subpath.points[0].x)
                add(edgesY1, subpath.points[0].y)
    if edgesX0.len == 0:
        return
    # Find Y bounds
    var minY = edgesY0[0]
    var maxY = edgesY0[0]
    for i in 0..<edgesX0.len:
        if edgesY0[i] < minY: minY = edgesY0[i]
        if edgesY0[i] > maxY: maxY = edgesY0[i]
        if edgesY1[i] < minY: minY = edgesY1[i]
        if edgesY1[i] > maxY: maxY = edgesY1[i]
    if minY < 0: minY = 0
    if maxY >= canvas.height: maxY = canvas.height - 1
    if minY > maxY: return
    # Scanline fill
    for y in minY..maxY:
        var xs: int32[]
        for ei in 0..<edgesX0.len:
            let y0 = edgesY0[ei]
            let y1 = edgesY1[ei]
            if y0 == y1:
                continue
            let x0 = edgesX0[ei]
            let x1 = edgesX1[ei]
            if (y >= y0 && y < y1) || (y >= y1 && y < y0):
                let t = float64(y - y0) / float64(y1 - y0)
                let xIntersect = int32(float64(x0) + t * float64(x1 - x0))
                add(xs, xIntersect)
        # Sort intersections
        for i in 0..<xs.len:
            for j in i + 1..<xs.len:
                if xs[i] > xs[j]:
                    let tmp = xs[i]
                    xs[i] = xs[j]
                    xs[j] = tmp
        # Fill between pairs
        var fi: int32
        while fi + 1 < xs.len:
            let xStart = WebCanvasMaxInt32(xs[fi], 0)
            var xEnd = WebCanvasMinInt32(xs[fi + 1], canvas.width)
            if xEnd > xStart:
                for x in xStart..<xEnd:
                    canvas.pixels[y * canvas.width + x] = color
            fi = fi + 2

fn WebCanvasBeginPath(canvas: var WebCanvasState) =
    canvas.currentPath = []
    canvas.currentX = 0
    canvas.currentY = 0
    canvas.hasCurrentPoint = false

fn WebCanvasMoveTo(canvas: var WebCanvasState, x: int32, y: int32) =
    var subpath: WebCanvasSubPath
    subpath.points = []
    subpath.closed = false
    var pt: WebCanvasSubPathPoint
    pt.x = x
    pt.y = y
    add(subpath.points, pt)
    add(canvas.currentPath, subpath)
    canvas.currentX = x
    canvas.currentY = y
    canvas.hasCurrentPoint = true

fn WebCanvasLineTo(canvas: var WebCanvasState, x: int32, y: int32) =
    if !canvas.hasCurrentPoint || canvas.currentPath.len <= 0:
        WebCanvasMoveTo(canvas, x, y)
        return
    let lastIdx = canvas.currentPath.len - 1
    var pt: WebCanvasSubPathPoint
    pt.x = x
    pt.y = y
    add(canvas.currentPath[lastIdx].points, pt)
    canvas.currentX = x
    canvas.currentY = y

fn WebCanvasArc(canvas: var WebCanvasState, x: int32, y: int32, radius: int32, startAngle: int32, endAngle: int32, counterclockwise: bool) =
    if radius <= 0:
        return
    let pi = float64(3.141592653589793)
    var sa = float64(startAngle) * pi / float64(180.0)
    var ea = float64(endAngle) * pi / float64(180.0)
    # Compute sweep
    var sweep = ea - sa
    if !counterclockwise && sweep < float64(0.0):
        sweep = sweep + float64(2.0) * pi
    elif counterclockwise && sweep > float64(0.0):
        sweep = sweep - float64(2.0) * pi
    let absSweep = sweep < float64(0.0) ? float64(0.0) - sweep : sweep
    var segments = WebCanvasMaxInt32(4, int32(absSweep * float64(radius) / float64(4.0)))
    if segments > 200:
        segments = 200
    let step = sweep / float64(segments)
    # Ensure a subpath exists
    if !canvas.hasCurrentPoint || canvas.currentPath.len <= 0:
        var firstPx = x + int32(float64(radius) * WebCanvasCos(sa))
        var firstPy = y + int32(float64(radius) * WebCanvasSin(sa))
        var subpath: WebCanvasSubPath
        subpath.points = []
        subpath.closed = false
        var pt0: WebCanvasSubPathPoint
        pt0.x = firstPx
        pt0.y = firstPy
        add(subpath.points, pt0)
        add(canvas.currentPath, subpath)
        canvas.currentX = firstPx
        canvas.currentY = firstPy
        canvas.hasCurrentPoint = true
    # Generate arc points
    let lastIdx = canvas.currentPath.len - 1
    for i in 1..segments:
        let angle = sa + float64(i) * step
        let px = x + int32(float64(radius) * WebCanvasCos(angle))
        let py = y + int32(float64(radius) * WebCanvasSin(angle))
        var pt: WebCanvasSubPathPoint
        pt.x = px
        pt.y = py
        add(canvas.currentPath[lastIdx].points, pt)
    # Update current position to arc endpoint
    let endAngle2 = sa + sweep
    let endPx = x + int32(float64(radius) * WebCanvasCos(endAngle2))
    let endPy = y + int32(float64(radius) * WebCanvasSin(endAngle2))
    canvas.currentX = endPx
    canvas.currentY = endPy

fn WebCanvasClosePath(canvas: var WebCanvasState) =
    if canvas.currentPath.len <= 0:
        return
    let lastIdx = canvas.currentPath.len - 1
    canvas.currentPath[lastIdx].closed = true
    # Reset current position to subpath start
    if canvas.currentPath[lastIdx].points.len > 0:
        canvas.currentX = canvas.currentPath[lastIdx].points[0].x
        canvas.currentY = canvas.currentPath[lastIdx].points[0].y

fn WebCanvasStroke(canvas: var WebCanvasState) =
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if !WebCanvasParseColor(canvas.strokeStyle, r, g, b, a):
        return
    a = a * canvas.globalAlpha / 255
    let color = WebCanvasColorPack(r, g, b, a)
    for si in 0..<canvas.currentPath.len:
        let subpath = canvas.currentPath[si]
        if subpath.points.len < 2:
            continue
        for pi in 0..<subpath.points.len - 1:
            WebCanvasDrawLineDevice(canvas, subpath.points[pi].x, subpath.points[pi].y, subpath.points[pi + 1].x, subpath.points[pi + 1].y, color)
        if subpath.closed:
            let last = subpath.points.len - 1
            WebCanvasDrawLineDevice(canvas, subpath.points[last].x, subpath.points[last].y, subpath.points[0].x, subpath.points[0].y, color)
    canvas.dirty = true

fn WebCanvasFill(canvas: var WebCanvasState) =
    var r: int32
    var g: int32
    var b: int32
    var a: int32
    if !WebCanvasParseColor(canvas.fillStyle, r, g, b, a):
        return
    a = a * canvas.globalAlpha / 255
    let color = WebCanvasColorPack(r, g, b, a)
    WebCanvasFillPath(canvas, color)
    canvas.dirty = true

fn WebFileReaderReadAsDataURLPtr(readerId: int32, blob: ptr): str =
    if blob == nil:
        return "data:,"
    return "data:,"

// ──────────────────────────────────────
// performance.now()
// ──────────────────────────────────────

fn WebPerformanceNow(out: var int32): bool =
    out = cheng_epoch_time_ms() & 0x7FFFFFFF
    return true

// ──────────────────────────────────────
// Document visibility state
// ──────────────────────────────────────

fn WebDocumentVisibilityState(document: var WebDocument, out: var str): bool =
    out = document.visibilityState
    return true

fn WebDocumentHidden(document: var WebDocument): bool =
    return document.hidden

fn WebDocumentSetVisibility(document: var WebDocument, hidden: bool, state: str): bool =
    if state != "visible" &&
       state != "hidden" &&
       state != "prerender" &&
       state != "unloaded":
        return false
    document.hidden = hidden
    document.visibilityState = state
    return true

// ──────────────────────────────────────
// crypto.getRandomValues (in-place variant)
// ──────────────────────────────────────

fn WebCryptoGetRandomValues(arr: var int32[]): bool =
    if arr.len <= 0:
        return false
    let byteCount = arr.len * 4
    for i in 0..<arr.len:
        arr[i] = 0
    if cheng_crypto_random_bytes(ptr(arr), byteCount) != byteCount:
        panic("crypto random bytes failed")
    return true

// ──────────────────────────────────────
// Fetch API + XMLHttpRequest
// ──────────────────────────────────────

fn WebFetchInit(): int32 =
    return 1

fn WebFetchDoRequest(request: var WebFetchRequest, out: var WebFetchResponse): bool =
    out.status = 0
    out.statusText = ""
    out.headers = []
    out.body = ""
    out.ok = false

    if request.url.len <= 0:
        return false

    # Handle file:// protocol
    if request.url.len >= 7 &&
       request.url[0] == 'f' && request.url[1] == 'i' && request.url[2] == 'l' &&
       request.url[3] == 'e' && request.url[4] == ':' && request.url[5] == '/' && request.url[6] == '/':
        var pathStart: int32 = 7
        var pathLen: int32 = request.url.len - pathStart
        if pathLen > 0:
            let path = strings.SliceBytes(request.url, pathStart, pathLen)
            var content: str
            if cheng_fs_read_file(path, content) == 0:
                out.body = content
                out.status = 200
                out.statusText = "OK"
                out.ok = true
                return true
        return false

    # Handle data: URL
    if request.url.len >= 5 &&
       request.url[0] == 'd' && request.url[1] == 'a' && request.url[2] == 't' &&
       request.url[3] == 'a' && request.url[4] == ':':
        var mimeType: str
        var data: str
        if WebDataUrlParse(request.url, mimeType, data):
            out.body = data
            out.status = 200
            out.statusText = "OK"
            out.ok = true
            return true
        return false

    # Try native HTTP fetch
    var nativeStatus: int32
    var nativeBody: str
    if cheng_http_fetch_native(request.method, request.url, request.body, nativeStatus, nativeBody) == 0:
        out.status = nativeStatus
        out.body = nativeBody
        if nativeStatus >= 200 && nativeStatus <= 299:
            out.statusText = "OK"
            out.ok = true
        else:
            out.statusText = "Error"
            out.ok = false
        return true

    return false

fn WebFetchGet(url: str, response: var WebFetchResponse): bool =
    var request: WebFetchRequest
    request.method = "GET"
    request.url = url
    request.headers = []
    request.body = ""
    return WebFetchDoRequest(request, response)

fn WebFetchPost(url: str, body: str, contentType: str, response: var WebFetchResponse): bool =
    var request: WebFetchRequest
    request.method = "POST"
    request.url = url
    request.body = body
    if contentType.len > 0:
        request.headers = [Fmt"Content-Type: {contentType}"]
    else:
        request.headers = []
    return WebFetchDoRequest(request, response)

fn WebDataUrlParse(dataUrl: str, mimeType: var str, out: var str): bool =
    mimeType = ""
    out = ""
    if dataUrl.len < 5 || dataUrl[0] != 'd' || dataUrl[1] != 'a' || dataUrl[2] != 't' || dataUrl[3] != 'a' || dataUrl[4] != ':':
        return false

    var commaPos: int32 = -1
    var semiPos: int32 = -1
    var i: int32 = 5
    while i < dataUrl.len:
        if dataUrl[i] == ',':
            commaPos = i
            break
        if dataUrl[i] == ';' && semiPos < 0:
            semiPos = i
        i = i + 1

    if commaPos < 0:
        return false

    # Extract mime type: content between "data:" and first ";"
    if semiPos >= 0:
        if semiPos > 5:
            mimeType = strings.SliceBytes(dataUrl, 5, semiPos - 5)
        else:
            mimeType = "text/plain"
    else:
        if commaPos > 5:
            mimeType = strings.SliceBytes(dataUrl, 5, commaPos - 5)
        else:
            mimeType = "text/plain"

    # Extract body after comma
    let bodyStart: int32 = commaPos + 1
    let bodyLen: int32 = dataUrl.len - bodyStart
    if bodyLen > 0:
        out = strings.SliceBytes(dataUrl, bodyStart, bodyLen)

    return true

fn WebXHRCreate(): int32 =
    return 1

fn WebXHROpen(xhr: var WebXHRState, method: str, url: str, async: bool): bool =
    xhr.readyState = 1
    xhr.status = 0
    xhr.responseText = ""
    xhr.method = method
    xhr.url = url
    xhr.requestHeaders = []
    return true

fn WebXHRSetRequestHeader(xhr: var WebXHRState, name: str, value: str): bool =
    if name.len <= 0:
        return false
    add(xhr.requestHeaders, Fmt"{name}: {value}")
    return true

fn WebXHRSend(xhr: var WebXHRState, body: str): bool =
    var request: WebFetchRequest
    request.method = xhr.method
    request.url = xhr.url
    request.headers = xhr.requestHeaders
    request.body = body

    var response: WebFetchResponse
    if WebFetchDoRequest(request, response):
        xhr.readyState = 4
        xhr.status = response.status
        xhr.responseText = response.body
        return true

    xhr.readyState = 4
    xhr.status = 0
    return false

fn WebXHRGetResponseText(xhr: var WebXHRState, out: var str): bool =
    out = xhr.responseText
    return true

fn WebXHRReadyState(xhr: var WebXHRState): int32 =
    return xhr.readyState

fn WebFetchResponseInit(response: var WebFetchResponse, body: str, status: int32) =
    response.body = body
    response.status = status
    response.ok = status >= 200 && status <= 299
    response.statusText = ""
    response.headers = []

fn WebFetchResponseText(response: var WebFetchResponse, out: var str): bool =
    out = response.body
    return true

fn WebHeadersInitEmpty(headers: var WebHeaders) =
    headers.entries = []

fn WebHeaderAsciiLower(name: str): str =
    var out = ""
    for i in 0..<name.len:
        let ch: char = name[i]
        if ch >= 'A' && ch <= 'Z':
            out = Fmt"{out}{char(int32(ch) + 32)}"
        else:
            out = Fmt"{out}{char(int32(ch))}"
    return out

fn WebHeadersAppend(headers: var WebHeaders, name: str, value: str): bool =
    if name.len <= 0:
        return false
    add(headers.entries, WebHeaderAsciiLower(name))
    add(headers.entries, value)
    return true

fn WebHeadersInitPairs(headers: var WebHeaders, names: str[], values: str[]): bool =
    headers.entries = []
    if names.len != values.len:
        return false
    for i in 0..<names.len:
        if names[i].len <= 0:
            headers.entries = []
            return false
    for i in 0..<names.len:
        if !WebHeadersAppend(headers, names[i], values[i]):
            headers.entries = []
            return false
    return true

fn WebHeadersHas(headers: var WebHeaders, name: str): bool =
    if name.len <= 0:
        return false
    let normalized = WebHeaderAsciiLower(name)
    var i: int32
    while i + 1 < headers.entries.len:
        if headers.entries[i] == normalized:
            return true
        i = i + 2
    return false

// ──────────────────────────────────────
// FileReader.readAsDataURL (typed overload)
// ──────────────────────────────────────

fn WebFileReaderReadAsDataURL(reader: var WebFileReader, blob: var int32[], out: var str): bool =
    if reader.readyState == WebFileReaderLoading:
        out = ""
        return false
    reader.readyState = WebFileReaderLoading
    if blob.len <= 0:
        reader.readyState = WebFileReaderDone
        out = "data:,"
        reader.result = out
        return true
    reader.result = "data:application/octet-stream;base64,"
    out = reader.result
    reader.readyState = WebFileReaderDone
    return true

# ──────────────────────────────────────
# WebUrlSearchParams Parse (real query string parser)
# ──────────────────────────────────────

fn WebUrlSearchParamsParse(query: str): str[] =
    var result: str[]
    if strings.Len(query) == 0: return result
    var q: str = query
    if q[0] == '?':
        q = strings.SliceBytes(q, 1, strings.Len(q) - 1)
    var current: str
    var i: int32
    let n: int32 = strings.Len(q)
    while i < n:
        if q[i] == '&':
            if strings.Len(current) > 0:
                add(result, current)
                current = ""
        else:
            current = Fmt"{current}{char(q[i])}"
        i = i + 1
    if strings.Len(current) > 0:
        add(result, current)
    return result

# ──────────────────────────────────────
# innerHTML / outerHTML serialization
# ──────────────────────────────────────

fn WebHtmlEscapeText(text: str): str =
    var result = ""
    for i in 0..<text.len:
        let ch = text[i]
        if ch == '&':
            result = Fmt"{result}&amp;"
        elif ch == '<':
            result = Fmt"{result}&lt;"
        elif ch == '>':
            result = Fmt"{result}&gt;"
        else:
            result = Fmt"{result}{char(ch)}"
    return result

fn WebHtmlEscapeAttribute(text: str): str =
    var result = ""
    for i in 0..<text.len:
        let ch = text[i]
        if ch == '&':
            result = Fmt"{result}&amp;"
        elif ch == '"':
            result = Fmt"{result}&quot;"
        elif ch == '<':
            result = Fmt"{result}&lt;"
        elif ch == '>':
            result = Fmt"{result}&gt;"
        else:
            result = Fmt"{result}{char(ch)}"
    return result

fn WebDocumentSerializeNode(document: var WebDocument, nodeId: int32, out: var str): bool =
    if !WebDocumentNodeExists(document, nodeId):
        out = ""
        return false
    let kind = WebDocumentNodeKind(document, nodeId)
    if kind == WebNodeKindText:
        var textContent: str
        if !WebDocumentNodeTextContent(document, nodeId, textContent):
            out = ""
            return false
        out = WebHtmlEscapeText(textContent)
        return true
    if kind == WebNodeKindElement:
        var tagName: str
        if !WebDocumentNodeTagName(document, nodeId, tagName):
            out = ""
            return false
        var result = Fmt"<{tagName}"
        for i in 0..<document.attributes.len:
            if document.attributes[i].nodeId == nodeId:
                let attrName = document.attributes[i].name
                let attrValue = document.attributes[i].value
                let escapedValue = WebHtmlEscapeAttribute(attrValue)
                result = Fmt"{result} {attrName}=\"{escapedValue}\""
        let childCount = WebDocumentChildCount(document, nodeId)
        if childCount == 0:
            result = Fmt"{result} />"
            out = result
            return true
        result = Fmt"{result}>"
        for i in 0..<childCount:
            let childId = WebDocumentChildAt(document, nodeId, i)
            var childHtml: str
            if !WebDocumentSerializeNode(document, childId, childHtml):
                out = ""
                return false
            result = Fmt"{result}{childHtml}"
        result = Fmt"{result}</{tagName}>"
        out = result
        return true
    if kind == WebNodeKindDocument:
        var result = ""
        let childCount = WebDocumentChildCount(document, nodeId)
        for i in 0..<childCount:
            let childId = WebDocumentChildAt(document, nodeId, i)
            var childHtml: str
            if !WebDocumentSerializeNode(document, childId, childHtml):
                out = ""
                return false
            result = Fmt"{result}{childHtml}"
        out = result
        return true
    out = ""
    return false

fn WebDocumentGetInnerHTML(document: var WebDocument, nodeId: int32, out: var str): bool =
    if !WebDocumentNodeExists(document, nodeId):
        out = ""
        return false
    var result = ""
    let childCount = WebDocumentChildCount(document, nodeId)
    for i in 0..<childCount:
        let childId = WebDocumentChildAt(document, nodeId, i)
        var childHtml: str
        if !WebDocumentSerializeNode(document, childId, childHtml):
            out = ""
            return false
        result = Fmt"{result}{childHtml}"
    out = result
    return true

fn WebDocumentGetOuterHTML(document: var WebDocument, nodeId: int32, out: var str): bool =
    if !WebDocumentNodeExists(document, nodeId):
        out = ""
        return false
    let kind = WebDocumentNodeKind(document, nodeId)
    if kind == WebNodeKindDocument:
        return WebDocumentGetInnerHTML(document, nodeId, out)
    return WebDocumentSerializeNode(document, nodeId, out)

// ──────────────────────────────────────
// Form Controls
// ──────────────────────────────────────

fn WebDocumentSetFormControl(document: var WebDocument, nodeId: int32, kind: int32, inputType: str) =
    if !WebDocumentNodeExists(document, nodeId):
        return
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            document.formControls[i].kind = kind
            document.formControls[i].inputType = inputType
            return
    var control: WebFormControlState
    control.nodeId = nodeId
    control.kind = kind
    control.value = ""
    control.checked = false
    control.disabled = false
    control.readonly = false
    control.inputType = inputType
    add(document.formControls, control)

fn WebDocumentSetFormValue(document: var WebDocument, nodeId: int32, value: str): bool =
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            document.formControls[i].value = value
            return true
    return false

fn WebDocumentGetFormValue(document: var WebDocument, nodeId: int32, out: var str): bool =
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            out = document.formControls[i].value
            return true
    out = ""
    return false

fn WebDocumentSetChecked(document: var WebDocument, nodeId: int32, checked: bool): bool =
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            document.formControls[i].checked = checked
            return true
    return false

fn WebDocumentGetChecked(document: var WebDocument, nodeId: int32, out: var bool): bool =
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            out = document.formControls[i].checked
            return true
    out = false
    return false

fn WebDocumentSetDisabled(document: var WebDocument, nodeId: int32, disabled: bool): bool =
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            document.formControls[i].disabled = disabled
            return true
    return false

fn WebDocumentGetDisabled(document: var WebDocument, nodeId: int32, out: var bool): bool =
    for i in 0..<document.formControls.len:
        if document.formControls[i].nodeId == nodeId:
            out = document.formControls[i].disabled
            return true
    out = false
    return false

// ──────────────────────────────────────
// Lifecycle Events
// ──────────────────────────────────────

fn WebWindowDispatchLifecycleEvent(window: var WebWindow, document: var WebDocument, eventType: str): bool =
    if eventType == "DOMContentLoaded":
        window.domContentLoaded = true
    elif eventType == "load":
        window.loaded = true
    // "beforeunload" and "unload" dispatch without setting boolean state
    // Dispatch to window
    WebWindowDispatchEvent(window, eventType)
    // Also dispatch to document root
    if document.rootNodeId != 0:
        WebDocumentDispatchEvent(document, document.rootNodeId, eventType)
    return true

fn WebWindowHasLoaded(window: var WebWindow): bool =
    return window.loaded

fn WebWindowHasDOMContentLoaded(window: var WebWindow): bool =
    return window.domContentLoaded

// ──────────────────────────────────────
// Scroll / Resize Events
// ──────────────────────────────────────

fn WebDocumentDispatchScrollEvent(document: var WebDocument, window: var WebWindow, nodeId: int32): bool =
    if nodeId == 0:
        var ev: WebEvent
        WebEventInit(ev, "scroll")
        WebWindowDispatchEventObject(window, ev)
        return true
    var ev: WebEvent
    WebEventInit(ev, "scroll")
    return WebDispatchEvent(document, nodeId, ev)

fn WebWindowDispatchResizeEvent(window: var WebWindow, document: var WebDocument, width: int32, height: int32): bool =
    var ev: WebEvent
    WebEventInit(ev, "resize")
    return WebWindowDispatchEventObject(window, ev)

// ──────────────────────────────────────
// Animation Frame Flush / Cancel
// ──────────────────────────────────────

fn WebWindowFlushAnimationFrames(window: var WebWindow): bool =
    for i in 0..<window.animationCallbacks.len:
        WebWindowRecordDispatchStep(window,
                                    "animationframe",
                                    window.animationCallbacks[i].callbackId,
                                    WebEventPhaseTarget)
    window.animationCallbacks = []
    return true

fn WebWindowCancelAnimationFrame(window: var WebWindow, requestId: int32): bool =
    var kept: WebAnimationFrameEntry[]
    var found = false
    for i in 0..<window.animationCallbacks.len:
        if window.animationCallbacks[i].requestId == requestId:
            found = true
        else:
            add(kept, share(window.animationCallbacks[i]))
    if found:
        window.animationCallbacks = kept
        return true
    return false

// ──────────────────────────────────────
// History API
// ──────────────────────────────────────

fn WebHistoryPushState(window: var WebWindow, url: str, title: str, state: str): bool =
    var entries = window.history.entries
    let curIdx = window.history.currentIndex
    if curIdx < entries.len - 1:
        var truncated: WebHistoryEntry[]
        for i in 0..curIdx:
            add(truncated, share(entries[i]))
        entries = truncated
    var entry: WebHistoryEntry
    entry.url = url
    entry.title = title
    entry.state = state
    add(entries, entry)
    window.history.entries = entries
    window.history.currentIndex = entries.len - 1
    return true

fn WebHistoryReplaceState(window: var WebWindow, url: str, title: str, state: str): bool =
    let idx = window.history.currentIndex
    if idx < 0 || idx >= window.history.entries.len:
        return false
    window.history.entries[idx].url = url
    window.history.entries[idx].title = title
    window.history.entries[idx].state = state
    return true

fn WebHistoryBack(window: var WebWindow): bool =
    if window.history.currentIndex > 0:
        window.history.currentIndex = window.history.currentIndex - 1
        return true
    return false

fn WebHistoryForward(window: var WebWindow): bool =
    if window.history.currentIndex < window.history.entries.len - 1:
        window.history.currentIndex = window.history.currentIndex + 1
        return true
    return false

fn WebHistoryGo(window: var WebWindow, delta: int32): bool =
    let newIndex = window.history.currentIndex + delta
    if newIndex >= 0 && newIndex < window.history.entries.len:
        window.history.currentIndex = newIndex
        return true
    return false

fn WebHistoryLength(window: var WebWindow): int32 =
    return window.history.entries.len

// ──────────────────────────────────────
// Clipboard API
// ──────────────────────────────────────

fn WebClipboardWriteText(window: var WebWindow, text: str): bool =
    window.clipboardText = text
    return true

fn WebClipboardReadText(window: var WebWindow, out: var str): bool =
    out = window.clipboardText
    return true

// ──────────────────────────────────────
// atob / btoa (Base64)
// ──────────────────────────────────────

fn base64CharValue(c: char): int32 =
    let val = Int32(c)
    if val >= Int32('A') && val <= Int32('Z'): return val - Int32('A')
    if val >= Int32('a') && val <= Int32('z'): return val - Int32('a') + 26
    if val >= Int32('0') && val <= Int32('9'): return val - Int32('0') + 52
    if val == Int32('+'): return 62
    if val == Int32('/'): return 63
    return 0

fn charFromBase64Value(val: int32): char =
    if val < 26: return Char(Int32('A') + val)
    if val < 52: return Char(Int32('a') + val - 26)
    if val < 62: return Char(Int32('0') + val - 52)
    if val == 62: return '+'
    return '/'

fn WebAtob(data: str): str =
    let n: int32 = strings.Len(data)
    if n == 0: return ""
    var padding: int32
    if n >= 1 && data[n-1] == '=': padding = 1
    if n >= 2 && data[n-2] == '=': padding = 2
    let groups = n / 4
    let outLen = groups * 3 - padding
    if outLen <= 0: return ""
    var out: str
    var g: int32
    for g in 0..<groups:
        let base = g * 4
        let v0 = base64CharValue(data[base])
        let v1 = base64CharValue(data[base + 1])
        let hasC2 = data[base + 2] != '='
        let hasC3 = data[base + 3] != '='
        let v2 = hasC2 ? base64CharValue(data[base + 2]) : 0
        let v3 = hasC3 ? base64CharValue(data[base + 3]) : 0
        let buffer = v0 * 262144 + v1 * 4096 + v2 * 64 + v3
        out = Fmt"{out}{char((buffer / 65536) % 256)}"
        if hasC2:
            out = Fmt"{out}{char((buffer / 256) % 256)}"
        if hasC3:
            out = Fmt"{out}{char(buffer % 256)}"
    return out

fn WebBtoa(data: str): str =
    let n: int32 = strings.Len(data)
    if n == 0: return ""
    var out: str
    var i: int32
    while i < n:
        let remaining = n - i
        let b0 = Int32(data[i])
        let b1 = remaining >= 2 ? Int32(data[i+1]) : 0
        let b2 = remaining >= 3 ? Int32(data[i+2]) : 0
        let buffer = b0 * 65536 + b1 * 256 + b2
        let v0 = (buffer / 262144) % 64
        let v1 = (buffer / 4096) % 64
        let v2 = (buffer / 64) % 64
        let v3 = buffer % 64
        out = Fmt"{out}{charFromBase64Value(v0)}"
        out = Fmt"{out}{charFromBase64Value(v1)}"
        if remaining >= 2:
            out = Fmt"{out}{charFromBase64Value(v2)}"
        else:
            out = Fmt"{out}="
        if remaining >= 3:
            out = Fmt"{out}{charFromBase64Value(v3)}"
        else:
            out = Fmt"{out}="
        i = i + 3
    return out

// ──────────────────────────────────────
// requestIdleCallback / cancelIdleCallback
// ──────────────────────────────────────

fn WebRequestIdleCallback(window: var WebWindow, callbackFnId: int32): int32 =
    add(window.idleCallbacks, callbackFnId)
    let id = window.nextIdleCallbackId
    window.nextIdleCallbackId = window.nextIdleCallbackId + 1
    return id

fn WebCancelIdleCallback(window: var WebWindow, idleCallbackId: int32): bool =
    var found = false
    var kept: int32[]
    for i in 0..<window.idleCallbacks.len:
        if window.idleCallbacks[i] == idleCallbackId:
            found = true
        else:
            add(kept, window.idleCallbacks[i])
    window.idleCallbacks = kept
    return found

fn WebWindowFlushIdleCallbacks(window: var WebWindow): bool =
    if window.idleCallbacks.len <= 0:
        return false
    for i in 0..<window.idleCallbacks.len:
        let callbackFnId = window.idleCallbacks[i]
        WebWindowRecordDispatchStep(window, "idlecallback", callbackFnId, WebEventPhaseTarget)
    window.idleCallbacks = []
    return true

// ──────────────────────────────────────
// queueMicrotask
// ──────────────────────────────────────

fn WebQueueMicrotask(window: var WebWindow, callbackFnId: int32): bool =
    add(window.microtaskQueue, callbackFnId)
    return true

fn WebWindowFlushMicrotasks(window: var WebWindow): bool =
    if window.microtaskQueue.len <= 0:
        return false
    for i in 0..<window.microtaskQueue.len:
        let callbackFnId = window.microtaskQueue[i]
        WebWindowRecordDispatchStep(window, "microtask", callbackFnId, WebEventPhaseTarget)
    window.microtaskQueue = []
    return true

// ──────────────────────────────────────
// Notification API
// ──────────────────────────────────────

fn WebNotificationConstructor(title: str, options: var WebNotificationOptions, out: var WebNotification): bool =
    out.title = title
    out.body = options.body
    out.icon = options.icon
    out.tag = options.tag
    return true

fn WebNotificationRequestPermission(window: var WebWindow): str =
    window.notificationPermission = "granted"
    return "granted"

fn WebNotificationShow(window: var WebWindow, notification: var WebNotification): bool =
    let output = Fmt"NOTIFICATION: {notification.title} - {notification.body}"
    echo(output)
    add(window.notifications, notification)
    return true

// ──────────────────────────────────────
// contentEditable / designMode
// ──────────────────────────────────────

fn WebDocumentSetContentEditable(document: var WebDocument, nodeId: int32, editable: bool): bool =
    if WebDocumentNodeKind(document, nodeId) != WebNodeKindElement:
        return false
    if editable:
        return WebDocumentSetAttribute(document, nodeId, "contenteditable", "true")
    return WebDocumentSetAttribute(document, nodeId, "contenteditable", "false")

fn WebDocumentIsContentEditable(document: var WebDocument, nodeId: int32): bool =
    let index = WebDocumentFindNodeIndex(document, nodeId)
    if index < 0:
        return false
    if document.nodes[index].kind != WebNodeKindElement:
        return false
    var value: str
    if WebDocumentGetAttribute(document, nodeId, "contenteditable", value) && value == "true":
        return true
    return false

fn WebDocumentSetDesignMode(document: var WebDocument, mode: str): bool =
    if mode != "on" && mode != "off":
        return false
    document.designMode = mode
    return true

// ──────────────────────────────────────
// Selection API
// ──────────────────────────────────────

fn WebDocumentGetSelection(document: var WebDocument, out: var WebSelection): bool =
    out = document.selection
    return true

fn WebDocumentCreateRange(document: var WebDocument): int32 =
    return 0

fn WebSelectionRemoveAllRanges(selection: var WebSelection) =
    selection.anchorNodeId = 0
    selection.anchorOffset = 0
    selection.focusNodeId = 0
    selection.focusOffset = 0
    selection.isCollapsed = true

fn WebSelectionAddRange(selection: var WebSelection, anchorNodeId: int32, anchorOffset: int32, focusNodeId: int32, focusOffset: int32) =
    selection.anchorNodeId = anchorNodeId
    selection.anchorOffset = anchorOffset
    selection.focusNodeId = focusNodeId
    selection.focusOffset = focusOffset
    selection.isCollapsed = anchorNodeId == focusNodeId && anchorOffset == focusOffset

fn WebSelectionGetRangeAt(selection: var WebSelection, index: int32, outAnchor: var int32, outAnchorOff: var int32, outFocus: var int32, outFocusOff: var int32): bool =
    if index != 0:
        return false
    outAnchor = selection.anchorNodeId
    outAnchorOff = selection.anchorOffset
    outFocus = selection.focusNodeId
    outFocusOff = selection.focusOffset
    return true

# ──────────────────────────────────────
# Server-Sent Events (EventSource)
# ──────────────────────────────────────

const
    WebEventSourceConnecting = 0
    WebEventSourceOpen = 1
    WebEventSourceClosed = 2

var eventSources: WebEventSource[]

fn WebEventSourceCreate(url: str): int32 =
    var source: WebEventSource
    source.url = url
    source.readyState = WebEventSourceConnecting
    source.onmessage = 0
    source.onerror = 0
    source.onopen = 0
    source.lastEventId = ""
    add(eventSources, source)
    return eventSources.len - 1

fn WebEventSourceClose(sourceId: int32): bool =
    if sourceId < 0 || sourceId >= eventSources.len:
        return false
    eventSources[sourceId].readyState = WebEventSourceClosed
    return true

# ──────────────────────────────────────
# Web Animations API — element.animate()
# ──────────────────────────────────────

fn WebAnimationParseKeyframes(json: str, keyframes: var WebAnimationKeyframe[]): bool =
    keyframes = []
    let n = json.len
    if n <= 0:
        return false
    var i: int32
    # Skip leading whitespace
    while i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\t' || json[i] == '\r'):
        i = i + 1
    if i >= n || json[i] != '[':
        return false
    i = i + 1  # skip '['
    while i < n:
        # Skip whitespace
        while i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\t' || json[i] == '\r'):
            i = i + 1
        if i >= n:
            return false
        if json[i] == ']':
            return true
        if json[i] != '{':
            return false
        i = i + 1  # skip '{'
        var kf: WebAnimationKeyframe
        kf.offset = 0.0
        kf.properties = []
        var inObject = true
        while i < n && inObject:
            # Skip whitespace inside object
            while i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\t' || json[i] == '\r'):
                i = i + 1
            if i >= n:
                return false
            if json[i] == '}':
                i = i + 1
                inObject = false
                break
            # Expect quoted key
            if json[i] != '"':
                return false
            i = i + 1  # skip opening '"'
            var keyStart = i
            while i < n && json[i] != '"':
                i = i + 1
            if i >= n:
                return false
            let keyName = strings.SliceBytes(json, keyStart, i - keyStart)
            i = i + 1  # skip closing '"'
            # Skip to ':'
            while i < n && json[i] != ':':
                i = i + 1
            if i >= n:
                return false
            i = i + 1  # skip ':'
            # Skip whitespace after ':'
            while i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\t' || json[i] == '\r'):
                i = i + 1
            if i >= n:
                return false
            if keyName == "offset":
                # Parse float number
                var intPart: int32
                var fracPart: int32
                var fracDiv: int32 = 1
                var negative = false
                if json[i] == '-':
                    negative = true
                    i = i + 1
                elif json[i] == '+':
                    i = i + 1
                while i < n && json[i] >= '0' && json[i] <= '9':
                    intPart = intPart * 10 + int32(json[i]) - int32('0')
                    i = i + 1
                if i < n && json[i] == '.':
                    i = i + 1
                    while i < n && json[i] >= '0' && json[i] <= '9':
                        fracPart = fracPart * 10 + int32(json[i]) - int32('0')
                        fracDiv = fracDiv * 10
                        i = i + 1
                kf.offset = float64(intPart) + float64(fracPart) / float64(fracDiv)
                if negative:
                    kf.offset = -kf.offset
            else:
                # Property value: parse string (quoted or unquoted)
                var valStr: str
                if json[i] == '"':
                    i = i + 1  # skip opening '"'
                    while i < n && json[i] != '"':
                        valStr = Fmt"{valStr}{char(json[i])}"
                        i = i + 1
                    if i >= n:
                        return false
                    i = i + 1  # skip closing '"'
                else:
                    # Unquoted (number, true/false, etc.)
                    while i < n && json[i] != ',' && json[i] != '}' && json[i] != ' ' && json[i] != '\n' && json[i] != '\t' && json[i] != '\r':
                        valStr = Fmt"{valStr}{char(json[i])}"
                        i = i + 1
                var prop: WebAnimationProperty
                prop.name = keyName
                prop.value = valStr
                add(kf.properties, prop)
            # Skip whitespace before ',' or '}'
            while i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\t' || json[i] == '\r'):
                i = i + 1
            if i < n && json[i] == ',':
                i = i + 1
        if inObject:
            return false  # object not closed
        add(keyframes, kf)
        # Skip whitespace after '}'
        while i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\t' || json[i] == '\r'):
            i = i + 1
        if i < n && json[i] == ',':
            i = i + 1
    return true

fn WebDocumentAnimate(document: var WebDocument, nodeId: int32, keyframesJson: str, duration: int32, iteration: int32, fill: int32, easing: int32, onfinish: int32, oncancel: int32): int32 =
    var keyframes: WebAnimationKeyframe[]
    if !WebAnimationParseKeyframes(keyframesJson, keyframes):
        return 0
    var effect: WebAnimationEffect
    effect.keyframes = keyframes
    effect.duration = duration
    effect.fill = fill
    effect.iteration = iteration
    var timeline: WebAnimationTimeline
    timeline.currentTime = 0
    var anim: WebAnimation
    let animId = document.nextAnimationId
    document.nextAnimationId = document.nextAnimationId + 1
    anim.animationId = animId
    anim.nodeId = nodeId
    anim.effect = effect
    anim.timeline = timeline
    anim.playState = WebAnimationRunning
    anim.playbackRate = 1.0
    anim.startTime = 0
    anim.currentTime = 0
    anim.onfinish = onfinish
    anim.oncancel = oncancel
    add(document.animations, anim)
    return animId

fn WebAnimationFindIndex(document: var WebDocument, animationId: int32): int32 =
    for i in 0..<document.animations.len:
        if document.animations[i].animationId == animationId:
            return i
    return -1

fn WebAnimationPlay(document: var WebDocument, animationId: int32): bool =
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    document.animations[idx].playState = WebAnimationRunning
    return true

fn WebAnimationPause(document: var WebDocument, animationId: int32): bool =
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    document.animations[idx].playState = WebAnimationPaused
    return true

fn WebAnimationFinish(document: var WebDocument, animationId: int32): bool =
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    document.animations[idx].playState = WebAnimationFinished
    let cb = document.animations[idx].onfinish
    if cb > 0:
        WebDocumentRecordDispatchStep(document, 0, "animationfinish", cb, WebEventPhaseTarget)
    return true

fn WebAnimationCancel(document: var WebDocument, animationId: int32): bool =
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    document.animations[idx].playState = WebAnimationIdle
    let cb = document.animations[idx].oncancel
    if cb > 0:
        WebDocumentRecordDispatchStep(document, 0, "animationcancel", cb, WebEventPhaseTarget)
    return true

fn WebAnimationReverse(document: var WebDocument, animationId: int32): bool =
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    document.animations[idx].playbackRate = -document.animations[idx].playbackRate
    return true

fn WebAnimationUpdateCurrentTime(document: var WebDocument, animationId: int32, timeMs: int32): bool =
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    if document.animations[idx].playState != WebAnimationRunning:
        return true
    document.animations[idx].currentTime = timeMs
    let duration = document.animations[idx].effect.duration
    if duration > 0 && document.animations[idx].currentTime >= duration:
        if document.animations[idx].effect.iteration == -1:
            # Infinite: wrap around
            document.animations[idx].currentTime = document.animations[idx].currentTime - duration
        elif document.animations[idx].effect.iteration > 1:
            # More iterations left: decrement and wrap
            document.animations[idx].currentTime = document.animations[idx].currentTime - duration
            document.animations[idx].effect.iteration = document.animations[idx].effect.iteration - 1
        else:
            # Final iteration: finish
            document.animations[idx].currentTime = duration
            document.animations[idx].playState = WebAnimationFinished
            let cb = document.animations[idx].onfinish
            if cb > 0:
                WebDocumentRecordDispatchStep(document, 0, "animationfinish", cb, WebEventPhaseTarget)
    return true

fn WebAnimationInterpolateValue(a: str, b: str, t: float64): str =
    # Handle px values
    let aLen = a.len
    let bLen = b.len
    if aLen >= 3 && a[aLen - 2] == 'p' && a[aLen - 1] == 'x' &&
       bLen >= 3 && b[bLen - 2] == 'p' && b[bLen - 1] == 'x':
        var aVal: int32
        var bVal: int32
        var ai: int32
        while ai < aLen && a[ai] >= '0' && a[ai] <= '9':
            aVal = aVal * 10 + int32(a[ai]) - int32('0')
            ai = ai + 1
        var bi: int32
        while bi < bLen && b[bi] >= '0' && b[bi] <= '9':
            bVal = bVal * 10 + int32(b[bi]) - int32('0')
            bi = bi + 1
        let resultf = float64(aVal) + (float64(bVal) - float64(aVal)) * t
        var intResult = int32(resultf)
        if intResult < 0:
            intResult = 0
        var resultStr: str
        if intResult == 0:
            resultStr = "0"
        else:
            var digits: str
            var n = intResult
            while n > 0:
                var d = n - (n / 10) * 10
                digits = Fmt"{char(int32('0') + d)}{digits}"
                n = n / 10
            resultStr = digits
        resultStr = Fmt"{resultStr}px"
        return resultStr
    # Handle hex colors
    if aLen >= 1 && a[0] == '#' && bLen >= 1 && b[0] == '#':
        var aR: int32
        var aG: int32
        var aB: int32
        var aA: int32
        var bR: int32
        var bG: int32
        var bB: int32
        var bA: int32
        if WebCanvasParseColor(a, aR, aG, aB, aA) && WebCanvasParseColor(b, bR, bG, bB, bA):
            let r = int32(float64(aR) + float64(bR - aR) * t + 0.5)
            let g = int32(float64(aG) + float64(bG - aG) * t + 0.5)
            let bCol = int32(float64(aB) + float64(bB - aB) * t + 0.5)
            var result: str = "#"
            var hexChars: str = "0123456789abcdef"
            result = Fmt"{result}{hexChars[r / 16]}{hexChars[r - (r / 16) * 16]}"
            result = Fmt"{result}{hexChars[g / 16]}{hexChars[g - (g / 16) * 16]}"
            result = Fmt"{result}{hexChars[bCol / 16]}{hexChars[bCol - (bCol / 16) * 16]}"
            return result
    # Default: return a (closest match, no interpolation)
    return a

fn WebAnimationGetComputedValue(document: var WebDocument, animationId: int32, propertyName: str, out: var str): bool =
    out = ""
    let idx = WebAnimationFindIndex(document, animationId)
    if idx < 0:
        return false
    let anim = document.animations[idx]
    let keyframes = anim.effect.keyframes
    let kfCount = keyframes.len
    if kfCount <= 0:
        return true
    let duration = anim.effect.duration
    if duration <= 0:
        # No duration: return first keyframe value for the property
        for pi in 0..<keyframes[0].properties.len:
            if keyframes[0].properties[pi].name == propertyName:
                out = keyframes[0].properties[pi].value
                return true
        return true
    # Normalize t to 0.0-1.0
    var t = float64(anim.currentTime) / float64(duration)
    if t < 0.0:
        t = 0.0
    if t > 1.0:
        t = 1.0
    # Find bracketing keyframes by offset
    var prevIdx: int32
    var nextIdx: int32 = kfCount - 1
    for i in 0..<kfCount:
        if keyframes[i].offset <= t:
            prevIdx = i
    for i in 0..<kfCount:
        if keyframes[i].offset >= t:
            nextIdx = i
            break
    if prevIdx == nextIdx:
        # Single keyframe matches
        for pi in 0..<keyframes[prevIdx].properties.len:
            if keyframes[prevIdx].properties[pi].name == propertyName:
                out = keyframes[prevIdx].properties[pi].value
                return true
        return true
    # Look up property value in both keyframes
    var valA: str
    var valB: str
    var foundA = false
    var foundB = false
    for pi in 0..<keyframes[prevIdx].properties.len:
        if keyframes[prevIdx].properties[pi].name == propertyName:
            valA = keyframes[prevIdx].properties[pi].value
            foundA = true
            break
    for pi in 0..<keyframes[nextIdx].properties.len:
        if keyframes[nextIdx].properties[pi].name == propertyName:
            valB = keyframes[nextIdx].properties[pi].value
            foundB = true
            break
    if !foundA && !foundB:
        return true
    if !foundA:
        out = valB
        return true
    if !foundB:
        out = valA
        return true
    # Calculate local t between the two keyframes
    let offsetA = keyframes[prevIdx].offset
    let offsetB = keyframes[nextIdx].offset
    var localT = float64(0.0)
    if offsetB > offsetA:
        localT = (t - offsetA) / (offsetB - offsetA)
    out = WebAnimationInterpolateValue(valA, valB, localT)
    return true

# ──────────────────────────────────────
# DOM dump — JSON serialization for oracle comparison
# ──────────────────────────────────────

@borrows
fn WebJsonEscapeString(s: str): str =
    var result = ""
    for i in 0..<s.len:
        let ch = s[i]
        var piece: str
        if ch == '"':
            piece = "\\\""
        elif ch == '\\':
            piece = "\\\\"
        elif ch == '\n':
            piece = "\\n"
        elif ch == '\t':
            piece = "\\t"
        elif ch == '\r':
            piece = "\\r"
        else:
            piece = strings.CharToStr(ch)
        result = strings.ConcatStr(result, piece)
    return result

fn WebDocumentDumpChildrenToJson(document: var WebDocument, nodeId: int32): str =
    var result = "["
    var written: int32
    let childCount = WebDocumentChildCount(document, nodeId)
    for ordinal in 0..<childCount:
        let childId = WebDocumentChildAt(document, nodeId, ordinal)
        if childId != 0:
            let sep = written > 0 ? "," : ""
            written = written + 1
            result = strings.ConcatStr(result, Fmt"{sep}{WebDocumentDumpNodeToJson(document, childId)}")
    result = strings.ConcatStr(result, Fmt"]")
    return result

fn WebDocumentDumpElementExtrasToJson(document: var WebDocument, nodeId: int32): str =
    var result: str
    var tagName: str
    if WebDocumentNodeTagName(document, nodeId, tagName):
        result = strings.ConcatStr(result, Fmt",\"tagName\":\"{WebJsonEscapeString(tagName)}\"")
    result = strings.ConcatStr(result, Fmt",\"textContent\":\"\"")
    result = strings.ConcatStr(result, Fmt",\"attributes\":{{")
    var written: int32
    for i in 0..<document.attributes.len:
        if document.attributes[i].nodeId == nodeId:
            let sep = written > 0 ? "," : ""
            written = written + 1
            result = strings.ConcatStr(result, Fmt"{sep}\"{WebJsonEscapeString(document.attributes[i].name)}\":\"{WebJsonEscapeString(document.attributes[i].value)}\"")
    result = strings.ConcatStr(result, Fmt"}}")
    result = strings.ConcatStr(result, Fmt",\"children\":")
    result = strings.ConcatStr(result, WebDocumentDumpChildrenToJson(document, nodeId))
    return result

fn WebDocumentDumpTextExtrasToJson(document: var WebDocument, nodeId: int32): str =
    var result = Fmt",\"tagName\":\"#text\""
    var textContent: str
    if WebDocumentNodeTextContent(document, nodeId, textContent):
        result = strings.ConcatStr(result, Fmt",\"textContent\":\"{WebJsonEscapeString(textContent)}\"")
    result = strings.ConcatStr(result, Fmt",\"attributes\":{{}},\"children\":[]")
    return result

fn WebDocumentDumpNodeToJson(document: var WebDocument, nodeId: int32): str =
    if !WebDocumentNodeExists(document, nodeId):
        return "null"
    let kind = WebDocumentNodeKind(document, nodeId)
    let nodeIndex = WebDocumentFindNodeIndex(document, nodeId)
    var result = Fmt"{{\"nodeId\":{nodeId},\"kind\":{kind}"
    if kind == WebNodeKindElement:
        result = strings.ConcatStr(result, WebDocumentDumpElementExtrasToJson(document, nodeId))
    elif kind == WebNodeKindText:
        result = strings.ConcatStr(result, WebDocumentDumpTextExtrasToJson(document, nodeId))
    else:
        var tagName: str
        if WebDocumentNodeTagName(document, nodeId, tagName):
            result = strings.ConcatStr(result, Fmt",\"tagName\":\"{WebJsonEscapeString(tagName)}\"")
        result = strings.ConcatStr(result, Fmt",\"textContent\":\"\"")
        result = strings.ConcatStr(result, Fmt",\"attributes\":{{}}")
        result = strings.ConcatStr(result, Fmt",\"children\":")
        result = strings.ConcatStr(result, WebDocumentDumpChildrenToJson(document, nodeId))
    result = strings.ConcatStr(result, Fmt"}}")
    return result


fn WebDocumentDumpDOM(document: var WebDocument): bool =
    if document.rootNodeId == 0:
        echo("[]")
        return true
    var json = WebDocumentDumpNodeToJson(document, document.rootNodeId)
    # Chunk output to avoid echo() buffer limit
    # Use strings.SliceBytes instead of WebCssSpanToString to avoid Fmt char() → ASCII numeric output
    var pos: int32
    let jlen = json.len
    while pos < jlen:
        let chunkEnd = pos + 200
        var end = chunkEnd
        if end > jlen:
            end = jlen
        echo(strings.SliceBytes(json, pos, end - pos))
        pos = end
    return true
