# CSG 统一决策执行内核合同 (任务 04 首切片)。
#
# 唯一需求来源: docs/campaigns/2026-09-21-csg-decision-computer-use/contract.md
# §1 (六类节点统一图) + §3 (错误与取消合同)。
#
# 本文件只定义合同 (类型 + 值域构造合同 + 追加式 SoA 列), 不做语义校验;
# 全部拒绝语义 (NaN/越界/不归一/过期世代/伪造引用/候选交换/销毁重建/
# 跨会话/按名寻址) 的唯一权威是 src/inference/decision_validate.cheng。
#
# 铁律 (contract.md §1):
# - 六类节点 (observe/deterministic/learn/action/execute/receipt) 全部定义在
#   同一 Arena/SoA 容器 (CsgDecisionGraph) 内, 每类一列; 跨节点引用一律
#   int32 索引, 快照世代 int64。
# - 事实值 (CsgDecisionFactValue) 与概率判断 (CsgDecisionProbValue) 分型;
#   本文件不存在任何从概率类型到事实类型的转换入口。
# - 每个候选是完整动作元组 (目标索引/操作/参数槽位/前置条件/效果合同),
#   一切按索引寻址, 不提供按名查找 API, 不设任何名称字段。
# - 本地索引只在绑定快照世代内有效; 每行 (节点/槽位/候选/结果) 都记录
#   创建世代, 引用凭 (世代, 索引) 双键校验。
# - 单个冻结世代内数据依赖无环: 节点间引用只允许指向类序更低的列
#   (receipt->execute->action->candidate), 由结构保证, 校验器复核。

import std/strings
import std/result

# -------------------------------------------------------------------
# 错误族 (contract.md §3, 逐字对齐)
# -------------------------------------------------------------------
const
    CsgDecisionErrNotConfigured = "NotConfigured"
    CsgDecisionErrBadArtifact = "BadArtifact"
    CsgDecisionErrLoadFailed = "LoadFailed"
    CsgDecisionErrInferenceFailed = "InferenceFailed"
    CsgDecisionErrInvalidOutput = "InvalidOutput"
    CsgDecisionErrCancelled = "Cancelled"
    CsgDecisionErrDeadlinePassed = "DeadlinePassed"
    CsgDecisionErrBudgetExceeded = "BudgetExceeded"
    CsgDecisionErrUnreachable = "Unreachable"
    CsgDecisionErrNeedEvidence = "NeedEvidence"
    CsgDecisionErrUnknownOutcome = "UnknownOutcome"
    CsgDecisionErrExecutionFailed = "ExecutionFailed"

# -------------------------------------------------------------------
# 节点类 / learn 头 / 槽位类
# -------------------------------------------------------------------
const
    CsgDecisionNodeClassObserve = 1
    CsgDecisionNodeClassDeterministic = 2
    CsgDecisionNodeClassLearn = 3
    CsgDecisionNodeClassAction = 4
    CsgDecisionNodeClassExecute = 5
    CsgDecisionNodeClassReceipt = 6

    # learn 三类头
    CsgDecisionHeadChoice = 1      # 互斥候选分布
    CsgDecisionHeadNoul = 2        # 条件成立概率
    CsgDecisionHeadScore = 3       # 有序等级分布及加权值

    # 引用目标槽位类 (统一槽位注册列的 kind 标签)
    CsgDecisionSlotKindSnapshot = 1
    CsgDecisionSlotKindPredicate = 2
    CsgDecisionSlotKindGoal = 3
    CsgDecisionSlotKindPrecondition = 4
    CsgDecisionSlotKindEffectContract = 5
    CsgDecisionSlotKindActionModel = 6
    CsgDecisionSlotKindParam = 7
    CsgDecisionSlotKindEvidence = 8
    CsgDecisionSlotKindReceipt = 9
    CsgDecisionSlotKindBackend = 10
    CsgDecisionSlotKindBudget = 11
    CsgDecisionSlotKindAuthorization = 12
    CsgDecisionSlotKindCommitAuthority = 13

    # 跨节点引用的 ref kind (与槽位 kind 同一编号空间, 101 起)
    CsgDecisionRefKindObserve = 101
    CsgDecisionRefKindDeterministic = 102
    CsgDecisionRefKindLearn = 103
    CsgDecisionRefKindAction = 104
    CsgDecisionRefKindExecute = 105
    CsgDecisionRefKindReceipt = 106
    CsgDecisionRefKindCandidate = 107
    CsgDecisionRefKindLearnResult = 108

    # learn 结果显式 no-match (合同 §3: "不适用/无候选匹配" 是显式选项,
    # 不是概率, 不是服务失败)
    CsgDecisionChosenNone: int32 = -1

type
    # 引用目标槽位: (类, 会话, 世代) 三元组, 供 (世代, 索引) 双键校验
    CsgDecisionSlot =
        kind: int32
        session: int64
        generation: int64

    # 事实值: 与概率分型。只承载精确整型事实, 绑定槽位 (类+索引) 与世代;
    # 不存在从 CsgDecisionProbValue 到本类型的构造或转换入口。
    CsgDecisionFactValue =
        slotRef: int32
        slotKind: int32
        generation: int64
        unitCode: int32
        raw: int64

    # 概率值: 声明精度 precision 位十进制定点, numer ∈ [0, 10^precision]。
    # 判断结果的唯一数值载体; 不提供到事实类型的转换入口。
    CsgDecisionProbValue =
        numer: int64
        precision: int32

    # ---- 六类节点 (contract.md §1 载荷字段) ----
    CsgDecisionObserveNode =
        snapshotRef: int32
        generation: int64
        sourceReceiptRef: int32
        evidenceRef: int32

    CsgDecisionDeterministicNode =
        predicateRef: int32
        actionModelRef: int32
        budgetRef: int32
        evidenceRef: int32
        generation: int64

    CsgDecisionLearnNode =
        headKind: int32
        candidateSetRef: int32      # 候选集起始 (candidates 列索引)
        candidateCount: int32
        evidenceRef: int32
        backendRef: int32
        generation: int64

    CsgDecisionActionNode =
        candidateRef: int32         # 完整动作元组索引
        authorizationRef: int32
        preconditionRef: int32
        generation: int64

    CsgDecisionExecuteNode =
        actionRef: int32            # actions 列索引
        commitAuthorityRef: int32
        generation: int64

    CsgDecisionReceiptNode =
        executionRef: int32         # executes 列索引
        goalPredicateRef: int32
        generation: int64

    # 候选 = 完整动作元组: 目标索引/操作/参数槽位/前置条件引用/效果合同引用。
    # 全部 int32 索引, 无名称字段 (禁名称寻址)。
    CsgDecisionCandidate =
        goalRef: int32
        operationRef: int32
        paramSlots: int32[]
        preconditionRef: int32
        effectContractRef: int32
        generation: int64

    # learn 判断结果 (与事实分型)。noMatch = 显式 no-match 选项。
    CsgDecisionLearnResult =
        learnRef: int32             # 所属 learn 节点 (learns 列索引)
        generation: int64
        headKind: int32
        noMatch: bool
        boundGoalRef: int32         # 本判断绑定的目标槽位 (候选交换检测锚点)
        chosenCandidate: int32      # Choice: 绝对候选索引; 其余 -1
        probs: CsgDecisionProbValue[]
        ranks: int32[]              # 仅 Score: 0..<count 的排列
        weighted: CsgDecisionProbValue  # 仅 Score: sum(ranks[i]*probs[i].numer)

    # 显式失败状态 (contract.md §3): 错误是显式状态, 不是回退触发器。
    CsgDecisionFailure =
        kind: str                   # 必须属于上方 §3 错误族
        detail: str

    # 有类型引用句柄: (会话, 世代, 索引, 期望类) 四元组。
    CsgDecisionRef =
        session: int64
        generation: int64
        index: int32
        kind: int32

    # 统一 Arena/SoA 容器: 六类节点列 + 候选/判断结果/槽位/事实/失败列,
    # 全部在同一容器内, 会话与当前世代是容器级身份。
    CsgDecisionGraph =
        session: int64
        generation: int64
        observes: CsgDecisionObserveNode[]
        deterministics: CsgDecisionDeterministicNode[]
        learns: CsgDecisionLearnNode[]
        actions: CsgDecisionActionNode[]
        executes: CsgDecisionExecuteNode[]
        receipts: CsgDecisionReceiptNode[]
        candidates: CsgDecisionCandidate[]
        learnResults: CsgDecisionLearnResult[]
        slots: CsgDecisionSlot[]
        facts: CsgDecisionFactValue[]
        failures: CsgDecisionFailure[]

# -------------------------------------------------------------------
# 概率值构造合同: 值域与声明精度显式校验
# -------------------------------------------------------------------

# 10^precision (precision ∈ [1, 9]; 越界返回 0, 由调用方判 0 拒绝)。
fn CsgDecisionProbScale(precision: int32): int64 =
    if precision < 1 || precision > 9:
        return 0
    var scale: int64 = 1
    var i: int32 = 0
    while i < precision:
        scale = scale * 10
        i = i + 1
    return scale

# 定点构造: numer 必须落在 [0, 10^precision] 值域内, 精度必须声明在
# [1, 9]。越界一律显式 Err (InvalidOutput 族), 不截断不兜底。
fn CsgDecisionProbFromFixed(numer: int64, precision: int32): Result[CsgDecisionProbValue] =
    if precision < 1 || precision > 9:
        return Err[CsgDecisionProbValue]("InvalidOutput: decision prob precision out of range")
    let scale = CsgDecisionProbScale(precision)
    if numer < 0 || numer > scale:
        return Err[CsgDecisionProbValue]("InvalidOutput: decision prob numer out of range")
    var out: CsgDecisionProbValue
    out.numer = numer
    out.precision = precision
    return Ok[CsgDecisionProbValue](out)

# -------------------------------------------------------------------
# 图构造 (纯追加, 不校验语义; 校验唯一权威在 decision_validate)
# -------------------------------------------------------------------

fn CsgDecisionGraphNew(session: int64, generation: int64): CsgDecisionGraph =
    var out: CsgDecisionGraph
    out.session = session
    out.generation = generation
    return out

# 跨世代反馈 (回执 -> 新观察) 由事件推进: 容器级世代前进, 旧行保留创建
# 世代, 旧引用随即失效 (由校验器按双键拒绝)。
fn CsgDecisionGraphAdvanceGeneration(graph: var CsgDecisionGraph, newGeneration: int64) =
    graph.generation = newGeneration

fn CsgDecisionSlotAdd(graph: var CsgDecisionGraph, kind: int32): int32 =
    var slot: CsgDecisionSlot
    slot.kind = kind
    slot.session = graph.session
    slot.generation = graph.generation
    add(graph.slots, slot)
    return graph.slots.len - 1

fn CsgDecisionFactAdd(graph: var CsgDecisionGraph, fact: CsgDecisionFactValue) =
    add(graph.facts, fact)

fn CsgDecisionObserveAdd(graph: var CsgDecisionGraph, node: CsgDecisionObserveNode) =
    add(graph.observes, node)

fn CsgDecisionDeterministicAdd(graph: var CsgDecisionGraph, node: CsgDecisionDeterministicNode) =
    add(graph.deterministics, node)

fn CsgDecisionLearnAdd(graph: var CsgDecisionGraph, node: CsgDecisionLearnNode) =
    add(graph.learns, node)

fn CsgDecisionActionAdd(graph: var CsgDecisionGraph, node: CsgDecisionActionNode) =
    add(graph.actions, node)

fn CsgDecisionExecuteAdd(graph: var CsgDecisionGraph, node: CsgDecisionExecuteNode) =
    add(graph.executes, node)

fn CsgDecisionReceiptAdd(graph: var CsgDecisionGraph, node: CsgDecisionReceiptNode) =
    add(graph.receipts, node)

fn CsgDecisionCandidateAdd(graph: var CsgDecisionGraph, candidate: CsgDecisionCandidate) =
    add(graph.candidates, candidate)

fn CsgDecisionLearnResultAdd(graph: var CsgDecisionGraph, res: CsgDecisionLearnResult) =
    add(graph.learnResults, res)

# -------------------------------------------------------------------
# 失败合同 (contract.md §3): kind 必须属于统一错误族
# -------------------------------------------------------------------

@borrows
fn CsgDecisionFailureKindIsKnown(kind: str): bool =
    if kind == CsgDecisionErrNotConfigured:
        return true
    if kind == CsgDecisionErrBadArtifact:
        return true
    if kind == CsgDecisionErrLoadFailed:
        return true
    if kind == CsgDecisionErrInferenceFailed:
        return true
    if kind == CsgDecisionErrInvalidOutput:
        return true
    if kind == CsgDecisionErrCancelled:
        return true
    if kind == CsgDecisionErrDeadlinePassed:
        return true
    if kind == CsgDecisionErrBudgetExceeded:
        return true
    if kind == CsgDecisionErrUnreachable:
        return true
    if kind == CsgDecisionErrNeedEvidence:
        return true
    if kind == CsgDecisionErrUnknownOutcome:
        return true
    if kind == CsgDecisionErrExecutionFailed:
        return true
    return false

# 与 std/result Err 同款合同: @borrows 收参, 构造器内部 CloneStr 落独立
# 副本, 对常量/字段/字面量等一切调用形安全。
@borrows
fn CsgDecisionFailureNew(kind: str, detail: str): Result[CsgDecisionFailure] =
    let known = CsgDecisionFailureKindIsKnown(kind)
    if !known:
        return Err[CsgDecisionFailure]("InvalidOutput: decision failure kind unknown")
    var out: CsgDecisionFailure
    out.kind = strings.CloneStr(kind)
    out.detail = strings.CloneStr(detail)
    return Ok[CsgDecisionFailure](out)

fn CsgDecisionGraphRecordFailure(graph: var CsgDecisionGraph, failure: CsgDecisionFailure) =
    add(graph.failures, failure)
