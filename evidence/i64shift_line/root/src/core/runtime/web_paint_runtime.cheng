import cheng/core/runtime/web_layout_runtime as layout
import std/strings

type
    PaintSvgPrimitive =
        kind: int32
        x1: int32
        y1: int32
        x2: int32
        y2: int32
        cx: int32
        cy: int32
        rx: int32
        ry: int32

    WebPaintNodeColor =
        nodeId: int32
        hasFill: bool
        fillColor: int32
        borderRadius: int32
        borderTopLeftRadius: int32
        borderTopRightRadius: int32
        borderBottomRightRadius: int32
        borderBottomLeftRadius: int32
        hasBorder: bool
        borderColor: int32
        borderTopWidth: int32
        borderRightWidth: int32
        borderBottomWidth: int32
        borderLeftWidth: int32
        hasText: bool
        textColor: int32
        hasIcon: bool
        iconKind: int32
        iconColor: int32
        iconSize: int32

    WebPaintNodeIconPrimitive =
        nodeId: int32
        primitive: PaintSvgPrimitive

    WebPaintGradientFillSpec =
        nodeId: int32
        startColor: int32
        endColor: int32
        angleDeg: int32
        hasStops: bool
        stopsColor: int32[]
        stopsPosPermille: int32[]
        hasSegXB: bool
        segX0Permille: int32[]
        segX1Permille: int32[]

    WebPaintRectItem =
        nodeId: int32
        x: int32
        y: int32
        width: int32
        height: int32
        fillColor: int32

    WebPaintColorRegistry =
        colors: WebPaintNodeColor[]
        iconPrimitives: WebPaintNodeIconPrimitive[]
        gradientFills: WebPaintGradientFillSpec[]

    WebPaintDisplayList =
        items: WebPaintRectItem[]

fn WebPaintColorRegistryInit(registry: var WebPaintColorRegistry) =
    registry.colors = []
    registry.iconPrimitives = []
    registry.gradientFills = []

fn WebPaintRegisterGradientFillStyle(registry: var WebPaintColorRegistry, nodeId: int32,
                                     startColor: int32, endColor: int32, angleDeg: int32): bool =
    var spec: WebPaintGradientFillSpec
    spec.nodeId = nodeId
    spec.startColor = startColor
    spec.endColor = endColor
    spec.angleDeg = angleDeg
    spec.hasStops = false
    spec.stopsColor = []
    spec.stopsPosPermille = []
    spec.hasSegXB = false
    spec.segX0Permille = []
    spec.segX1Permille = []
    add(registry.gradientFills, spec)
    return true

fn WebPaintRegisterGradientFillStops(registry: var WebPaintColorRegistry, nodeId: int32,
                                     colors: int32[], posPermille: int32[], angleDeg: int32): bool =
    if colors.len < 2 || colors.len != posPermille.len:
        return false
    var spec: WebPaintGradientFillSpec
    spec.nodeId = nodeId
    spec.startColor = colors[0]
    spec.endColor = colors[colors.len - 1]
    spec.angleDeg = angleDeg
    spec.hasStops = true
    spec.stopsColor = colors
    spec.stopsPosPermille = posPermille
    add(registry.gradientFills, spec)
    return true


fn WebPaintRegisterGradientFillStopsXB(registry: var WebPaintColorRegistry, nodeId: int32,
                                        colors: int32[], posPermille: int32[], angleDeg: int32,
                                        segX0Permille: int32[], segX1Permille: int32[]): bool =
    if colors.len < 2 || colors.len != posPermille.len:
        return false
    if segX0Permille.len != colors.len - 1 || segX1Permille.len != colors.len - 1:
        return false
    var spec: WebPaintGradientFillSpec
    spec.nodeId = nodeId
    spec.startColor = colors[0]
    spec.endColor = colors[colors.len - 1]
    spec.angleDeg = angleDeg
    spec.hasStops = true
    spec.stopsColor = colors
    spec.stopsPosPermille = posPermille
    spec.hasSegXB = true
    spec.segX0Permille = segX0Permille
    spec.segX1Permille = segX1Permille
    add(registry.gradientFills, spec)
    return true
fn WebPaintFindGradientFillStops(registry: var WebPaintColorRegistry, nodeId: int32,
                                 outColors: var int32[], outPosPermille: var int32[],
                                 outAngleDeg: var int32, outSegX0: var int32[], outSegX1: var int32[]): bool =
    outColors = []
    outPosPermille = []
    outAngleDeg = 180
    outSegX0 = []
    outSegX1 = []
    let count = registry.gradientFills.len
    for i in 0..<count:
        if registry.gradientFills[i].nodeId == nodeId && registry.gradientFills[i].hasStops:
            outColors = registry.gradientFills[i].stopsColor
            outPosPermille = registry.gradientFills[i].stopsPosPermille
            outAngleDeg = registry.gradientFills[i].angleDeg
            if registry.gradientFills[i].hasSegXB:
                outSegX0 = registry.gradientFills[i].segX0Permille
                outSegX1 = registry.gradientFills[i].segX1Permille
            return true
    return false

fn WebPaintFindGradientFillStyle(registry: var WebPaintColorRegistry, nodeId: int32,
                                 outStartColor: var int32,
                                 outEndColor: var int32,
                                 outAngleDeg: var int32): bool =
    outStartColor = 0
    outEndColor = 0
    outAngleDeg = 180
    let count = registry.gradientFills.len
    for i in 0..<count:
        if registry.gradientFills[i].nodeId == nodeId:
            outStartColor = registry.gradientFills[i].startColor
            outEndColor = registry.gradientFills[i].endColor
            outAngleDeg = registry.gradientFills[i].angleDeg
            return true
    return false

fn WebPaintDisplayListInit(list: var WebPaintDisplayList) =
    list.items = []

fn WebPaintRegisterFillColor(registry: var WebPaintColorRegistry, nodeId: int32, fillColor: int32): bool =
    if nodeId <= 0:
        return false
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasFill = true
            registry.colors[i].fillColor = fillColor
            registry.colors[i].borderRadius = 0
            registry.colors[i].borderTopLeftRadius = 0
            registry.colors[i].borderTopRightRadius = 0
            registry.colors[i].borderBottomRightRadius = 0
            registry.colors[i].borderBottomLeftRadius = 0
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = true
    color.fillColor = fillColor
    color.borderRadius = 0
    color.borderTopLeftRadius = 0
    color.borderTopRightRadius = 0
    color.borderBottomRightRadius = 0
    color.borderBottomLeftRadius = 0
    color.hasBorder = false
    color.borderColor = 0
    color.borderTopWidth = 0
    color.borderRightWidth = 0
    color.borderBottomWidth = 0
    color.borderLeftWidth = 0
    color.hasText = false
    color.textColor = 0
    color.hasIcon = false
    color.iconKind = 0
    color.iconColor = 0
    color.iconSize = 0
    add(registry.colors, color)
    return true

fn WebPaintRegisterFillStyle(registry: var WebPaintColorRegistry, nodeId: int32, fillColor: int32, borderRadius: int32): bool =
    if nodeId <= 0:
        return false
    let colorCount = registry.colors.len
    var radius = borderRadius
    if radius < 0:
        radius = 0
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasFill = true
            registry.colors[i].fillColor = fillColor
            registry.colors[i].borderRadius = radius
            registry.colors[i].borderTopLeftRadius = radius
            registry.colors[i].borderTopRightRadius = radius
            registry.colors[i].borderBottomRightRadius = radius
            registry.colors[i].borderBottomLeftRadius = radius
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = true
    color.fillColor = fillColor
    color.borderRadius = radius
    color.borderTopLeftRadius = radius
    color.borderTopRightRadius = radius
    color.borderBottomRightRadius = radius
    color.borderBottomLeftRadius = radius
    color.hasBorder = false
    color.borderColor = 0
    color.borderTopWidth = 0
    color.borderRightWidth = 0
    color.borderBottomWidth = 0
    color.borderLeftWidth = 0
    color.hasText = false
    color.textColor = 0
    color.hasIcon = false
    color.iconKind = 0
    color.iconColor = 0
    color.iconSize = 0
    add(registry.colors, color)
    return true

fn WebPaintNormalizeRadius(radius: int32): int32 =
    if radius < 0:
        return 0
    return radius

fn WebPaintRegisterFillCornerStyle(registry: var WebPaintColorRegistry,
                                   nodeId: int32,
                                   fillColor: int32,
                                   topLeftRadius: int32,
                                   topRightRadius: int32,
                                   bottomRightRadius: int32,
                                   bottomLeftRadius: int32): bool =
    if nodeId <= 0:
        return false
    let tl = WebPaintNormalizeRadius(topLeftRadius)
    let tr = WebPaintNormalizeRadius(topRightRadius)
    let br = WebPaintNormalizeRadius(bottomRightRadius)
    let bl = WebPaintNormalizeRadius(bottomLeftRadius)
    var uniform = tl
    if tr > uniform:
        uniform = tr
    if br > uniform:
        uniform = br
    if bl > uniform:
        uniform = bl
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasFill = true
            registry.colors[i].fillColor = fillColor
            registry.colors[i].borderRadius = uniform
            registry.colors[i].borderTopLeftRadius = tl
            registry.colors[i].borderTopRightRadius = tr
            registry.colors[i].borderBottomRightRadius = br
            registry.colors[i].borderBottomLeftRadius = bl
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = true
    color.fillColor = fillColor
    color.borderRadius = uniform
    color.borderTopLeftRadius = tl
    color.borderTopRightRadius = tr
    color.borderBottomRightRadius = br
    color.borderBottomLeftRadius = bl
    color.hasBorder = false
    color.borderColor = 0
    color.borderTopWidth = 0
    color.borderRightWidth = 0
    color.borderBottomWidth = 0
    color.borderLeftWidth = 0
    color.hasText = false
    color.textColor = 0
    color.hasIcon = false
    color.iconKind = 0
    color.iconColor = 0
    color.iconSize = 0
    add(registry.colors, color)
    return true

fn WebPaintRegisterBorderStyle(registry: var WebPaintColorRegistry,
                               nodeId: int32,
                               borderColor: int32,
                               borderTopWidth: int32,
                               borderRightWidth: int32,
                               borderBottomWidth: int32,
                               borderLeftWidth: int32,
                               borderRadius: int32): bool =
    if nodeId <= 0:
        return false
    var top = borderTopWidth
    var right = borderRightWidth
    var bottom = borderBottomWidth
    var left = borderLeftWidth
    var radius = borderRadius
    if top < 0 || right < 0 || bottom < 0 || left < 0:
        return false
    if radius < 0:
        radius = 0
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasBorder = true
            registry.colors[i].borderColor = borderColor
            registry.colors[i].borderTopWidth = top
            registry.colors[i].borderRightWidth = right
            registry.colors[i].borderBottomWidth = bottom
            registry.colors[i].borderLeftWidth = left
            if radius > registry.colors[i].borderRadius:
                registry.colors[i].borderRadius = radius
            if radius > registry.colors[i].borderTopLeftRadius:
                registry.colors[i].borderTopLeftRadius = radius
            if radius > registry.colors[i].borderTopRightRadius:
                registry.colors[i].borderTopRightRadius = radius
            if radius > registry.colors[i].borderBottomRightRadius:
                registry.colors[i].borderBottomRightRadius = radius
            if radius > registry.colors[i].borderBottomLeftRadius:
                registry.colors[i].borderBottomLeftRadius = radius
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = false
    color.fillColor = 0
    color.borderRadius = radius
    color.borderTopLeftRadius = radius
    color.borderTopRightRadius = radius
    color.borderBottomRightRadius = radius
    color.borderBottomLeftRadius = radius
    color.hasBorder = true
    color.borderColor = borderColor
    color.borderTopWidth = top
    color.borderRightWidth = right
    color.borderBottomWidth = bottom
    color.borderLeftWidth = left
    color.hasText = false
    color.textColor = 0
    color.hasIcon = false
    color.iconKind = 0
    color.iconColor = 0
    color.iconSize = 0
    add(registry.colors, color)
    return true

fn WebPaintRegisterBorderCornerStyle(registry: var WebPaintColorRegistry,
                                     nodeId: int32,
                                     borderColor: int32,
                                     borderTopWidth: int32,
                                     borderRightWidth: int32,
                                     borderBottomWidth: int32,
                                     borderLeftWidth: int32,
                                     topLeftRadius: int32,
                                     topRightRadius: int32,
                                     bottomRightRadius: int32,
                                     bottomLeftRadius: int32): bool =
    if nodeId <= 0:
        return false
    var top = borderTopWidth
    var right = borderRightWidth
    var bottom = borderBottomWidth
    var left = borderLeftWidth
    if top < 0 || right < 0 || bottom < 0 || left < 0:
        return false
    let tl = WebPaintNormalizeRadius(topLeftRadius)
    let tr = WebPaintNormalizeRadius(topRightRadius)
    let br = WebPaintNormalizeRadius(bottomRightRadius)
    let bl = WebPaintNormalizeRadius(bottomLeftRadius)
    var uniform = tl
    if tr > uniform:
        uniform = tr
    if br > uniform:
        uniform = br
    if bl > uniform:
        uniform = bl
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasBorder = true
            registry.colors[i].borderColor = borderColor
            registry.colors[i].borderTopWidth = top
            registry.colors[i].borderRightWidth = right
            registry.colors[i].borderBottomWidth = bottom
            registry.colors[i].borderLeftWidth = left
            if uniform > registry.colors[i].borderRadius:
                registry.colors[i].borderRadius = uniform
            registry.colors[i].borderTopLeftRadius = tl
            registry.colors[i].borderTopRightRadius = tr
            registry.colors[i].borderBottomRightRadius = br
            registry.colors[i].borderBottomLeftRadius = bl
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = false
    color.fillColor = 0
    color.borderRadius = uniform
    color.borderTopLeftRadius = tl
    color.borderTopRightRadius = tr
    color.borderBottomRightRadius = br
    color.borderBottomLeftRadius = bl
    color.hasBorder = true
    color.borderColor = borderColor
    color.borderTopWidth = top
    color.borderRightWidth = right
    color.borderBottomWidth = bottom
    color.borderLeftWidth = left
    color.hasText = false
    color.textColor = 0
    color.hasIcon = false
    color.iconKind = 0
    color.iconColor = 0
    color.iconSize = 0
    add(registry.colors, color)
    return true

fn WebPaintRegisterTextColor(registry: var WebPaintColorRegistry, nodeId: int32, textColor: int32): bool =
    if nodeId <= 0:
        return false
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasText = true
            registry.colors[i].textColor = textColor
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = false
    color.fillColor = 0
    color.borderRadius = 0
    color.borderTopLeftRadius = 0
    color.borderTopRightRadius = 0
    color.borderBottomRightRadius = 0
    color.borderBottomLeftRadius = 0
    color.hasBorder = false
    color.borderColor = 0
    color.borderTopWidth = 0
    color.borderRightWidth = 0
    color.borderBottomWidth = 0
    color.borderLeftWidth = 0
    color.hasText = true
    color.textColor = textColor
    color.hasIcon = false
    color.iconKind = 0
    color.iconColor = 0
    color.iconSize = 0
    add(registry.colors, color)
    return true

fn WebPaintRegisterIconStyle(registry: var WebPaintColorRegistry, nodeId: int32,
                             iconKind: int32, iconColor: int32, iconSize: int32): bool =
    if nodeId <= 0:
        return false
    if iconKind <= 0:
        return false
    var size = iconSize
    if size <= 0:
        size = 16
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId:
            registry.colors[i].hasIcon = true
            registry.colors[i].iconKind = iconKind
            registry.colors[i].iconColor = iconColor
            registry.colors[i].iconSize = size
            return true
    var color: WebPaintNodeColor
    color.nodeId = nodeId
    color.hasFill = false
    color.fillColor = 0
    color.borderRadius = 0
    color.borderTopLeftRadius = 0
    color.borderTopRightRadius = 0
    color.borderBottomRightRadius = 0
    color.borderBottomLeftRadius = 0
    color.hasBorder = false
    color.borderColor = 0
    color.borderTopWidth = 0
    color.borderRightWidth = 0
    color.borderBottomWidth = 0
    color.borderLeftWidth = 0
    color.hasText = false
    color.textColor = 0
    color.hasIcon = true
    color.iconKind = iconKind
    color.iconColor = iconColor
    color.iconSize = size
    add(registry.colors, color)
    return true

fn WebPaintRegisterIconPrimitive(registry: var WebPaintColorRegistry, nodeId: int32,
                                 primitiveKind: int32,
                                 x1: int32, y1: int32, x2: int32, y2: int32,
                                 cx: int32, cy: int32, rx: int32, ry: int32): bool =
    if nodeId <= 0:
        return false
    if primitiveKind <= 0:
        return false
    var primitive: PaintSvgPrimitive
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = primitiveKind
    primitive.x1 = x1
    primitive.y1 = y1
    primitive.x2 = x2
    primitive.y2 = y2
    primitive.cx = cx
    primitive.cy = cy
    primitive.rx = rx
    primitive.ry = ry
    var item: WebPaintNodeIconPrimitive
    item.nodeId = nodeId
    item.primitive = primitive
    add(registry.iconPrimitives, item)
    return true

fn WebPaintFindFillColor(registry: var WebPaintColorRegistry, nodeId: int32, outFillColor: var int32): bool =
    outFillColor = 0
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId && registry.colors[i].hasFill:
            outFillColor = registry.colors[i].fillColor
            return true
    return false

fn WebPaintFindFillStyle(registry: var WebPaintColorRegistry, nodeId: int32,
                         outFillColor: var int32, outBorderRadius: var int32): bool =
    outFillColor = 0
    outBorderRadius = 0
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId && registry.colors[i].hasFill:
            outFillColor = registry.colors[i].fillColor
            outBorderRadius = registry.colors[i].borderRadius
            return true
    return false

