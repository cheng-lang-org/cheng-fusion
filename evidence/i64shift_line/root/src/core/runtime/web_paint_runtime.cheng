fn WebPaintFindTextColor(registry: var WebPaintColorRegistry, nodeId: int32, outTextColor: var int32): bool =
    outTextColor = 0
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId && registry.colors[i].hasText:
            outTextColor = registry.colors[i].textColor
            return true
    return false

fn WebPaintFindInheritedTextColor(tree: var layout.WebLayoutTree,
                                  registry: var WebPaintColorRegistry,
                                  nodeId: int32,
                                  outTextColor: var int32): bool =
    outTextColor = 0
    var current: int32
    current = nodeId
    var steps: int32
    steps = 0
    while current != 0:
        if WebPaintFindTextColor(registry, current, outTextColor):
            return true
        current = layout.WebLayoutParentOf(tree, current)
        steps = steps + 1
        if steps > tree.styles.len + tree.children.len + 1:
            outTextColor = 0
            return false
    return false

fn WebPaintFindIconStyle(registry: var WebPaintColorRegistry, nodeId: int32,
                         outIconKind: var int32, outIconColor: var int32, outIconSize: var int32): bool =
    outIconKind = 0
    outIconColor = 0
    outIconSize = 0
    let colorCount = registry.colors.len
    for i in 0..<colorCount:
        if registry.colors[i].nodeId == nodeId && registry.colors[i].hasIcon:
            outIconKind = registry.colors[i].iconKind
            outIconColor = registry.colors[i].iconColor
            outIconSize = registry.colors[i].iconSize
            return true
    return false

fn WebPaintCopyIconPrimitives(registry: var WebPaintColorRegistry, nodeId: int32,
                              outPrimitives: var PaintSvgPrimitive[]): int32 =
    outPrimitives = []
    for i in 0..<registry.iconPrimitives.len:
        if registry.iconPrimitives[i].nodeId == nodeId:
            add(outPrimitives, registry.iconPrimitives[i].primitive)
    return outPrimitives.len


fn WebPaintMaxInt32(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

fn WebPaintMinInt32(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

fn WebPaintFindBoxIndexForNode(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    for i in 0..<tree.boxes.len:
        if tree.boxes[i].nodeId == nodeId:
            return i
    return -1

fn WebPaintEffectiveOpacity(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    var opacity = 255
    var current = nodeId
    var steps = 0
    while current != 0:
        let boxIndex = WebPaintFindBoxIndexForNode(tree, current)
        if boxIndex >= 0:
            let box = tree.boxes[boxIndex]
            if box.opacity <= 0:
                return 0
            if box.opacity < 255:
                opacity = opacity * box.opacity / 255
        current = layout.WebLayoutParentOf(tree, current)
        steps = steps + 1
        if steps > tree.boxes.len + tree.children.len + 1:
            return 0
    return opacity

fn WebPaintApplyOpacityToColor(color: int32, opacity: int32): int32 =
    if opacity >= 255:
        return color
    if opacity <= 0:
        return color & int32(0x00FFFFFF)
    let alpha = (color >> 24) & 0xFF
    let nextAlpha = alpha * opacity / 255
    return (color & int32(0x00FFFFFF)) | (nextAlpha << 24)

fn WebPaintFindAncestorClip(tree: var layout.WebLayoutTree, nodeId: int32,
                            outX: var int32, outY: var int32,
                            outW: var int32, outH: var int32): bool =
    outX = 0
    outY = 0
    outW = 0
    outH = 0
    var hasClip = false
    var current = layout.WebLayoutParentOf(tree, nodeId)
    var steps = 0
    while current != 0:
        let boxIndex = WebPaintFindBoxIndexForNode(tree, current)
        if boxIndex >= 0:
            let b = tree.boxes[boxIndex]
            if b.overflowX != layout.WebLayoutOverflowVisible || b.overflowY != layout.WebLayoutOverflowVisible:
                if !hasClip:
                    outX = b.x
                    outY = b.y
                    outW = b.width
                    outH = b.height
                    hasClip = true
                else:
                    let nextX = WebPaintMaxInt32(outX, b.x)
                    let nextY = WebPaintMaxInt32(outY, b.y)
                    let nextRight = WebPaintMinInt32(outX + outW, b.x + b.width)
                    let nextBottom = WebPaintMinInt32(outY + outH, b.y + b.height)
                    outX = nextX
                    outY = nextY
                    outW = nextRight - nextX
                    outH = nextBottom - nextY
                    if outW < 0:
                        outW = 0
                    if outH < 0:
                        outH = 0
        steps = steps + 1
        if steps > tree.styles.len:
            return hasClip
        current = layout.WebLayoutParentOf(tree, current)
    return hasClip

fn WebPaintFindTextOverflowEllipsisBox(tree: var layout.WebLayoutTree, nodeId: int32,
                                       outX: var int32, outY: var int32,
                                       outW: var int32, outH: var int32): bool =
    outX = 0
    outY = 0
    outW = 0
    outH = 0
    var current = layout.WebLayoutParentOf(tree, nodeId)
    var steps: int32
    while current != 0:
        steps = steps + 1
        if steps > tree.styles.len:
            return false
        let styleIdx = layout.WebLayoutFindStyleIndex(tree, current)
        if styleIdx >= 0 && styleIdx < tree.styles.len:
            if tree.styles[styleIdx].textOverflowEllipsis &&
                    tree.styles[styleIdx].whiteSpaceNowrap &&
                    tree.styles[styleIdx].overflowX != layout.WebLayoutOverflowVisible:
                let boxIndex = WebPaintFindBoxIndexForNode(tree, current)
                if boxIndex >= 0:
                    let b = tree.boxes[boxIndex]
                    outX = b.x + tree.styles[styleIdx].borderLeftWidth + tree.styles[styleIdx].paddingLeft
                    outY = b.y + tree.styles[styleIdx].borderTopWidth + tree.styles[styleIdx].paddingTop
                    outW = b.width - tree.styles[styleIdx].borderLeftWidth - tree.styles[styleIdx].borderRightWidth - tree.styles[styleIdx].paddingLeft - tree.styles[styleIdx].paddingRight
                    outH = b.height - tree.styles[styleIdx].borderTopWidth - tree.styles[styleIdx].borderBottomWidth - tree.styles[styleIdx].paddingTop - tree.styles[styleIdx].paddingBottom
                    if outW < 0:
                        outW = 0
                    if outH < 0:
                        outH = 0
                    return outW > 0 && outH > 0
            return false
        current = layout.WebLayoutParentOf(tree, current)
    return false

@borrows
fn WebPaintTextCharVisualWidth(text: str, start: int32, fontSize: int32, nextIndex: var int32): int32 =
    if start < 0 || start >= text.len:
        nextIndex = text.len
        return 0
    let ch = text[start]
    if ch == ' ':
        nextIndex = start + 1
        return fontSize / 4
    if int32(ch) >= 0 && int32(ch) < 128:
        nextIndex = start + 1
        return fontSize * 3 / 5
    nextIndex = start + 1
    while nextIndex < text.len && (int32(text[nextIndex]) & 192) == 128:
        nextIndex = nextIndex + 1
    return fontSize

@borrows
fn WebPaintEllipsizeText(text: str, fontSize: int32, maxWidth: int32): str =
    if maxWidth <= 0:
        return ""
    let ellipsis = "..."
    let ellipsisWidth = layout.WebLayoutEstimateTextWidth(ellipsis, fontSize)
    if layout.WebLayoutEstimateTextWidth(text, fontSize) <= maxWidth:
        return strings.ConcatStr(text, "")
    if ellipsisWidth >= maxWidth:
        return ellipsis
    let budget = maxWidth - ellipsisWidth
    var width: int32
    var byteStop: int32
    var i: int32
    while i < text.len:
        var nextIndex: int32
        let charWidth = WebPaintTextCharVisualWidth(text, i, fontSize, nextIndex)
        if nextIndex <= i:
            break
        if width + charWidth > budget:
            break
        width = width + charWidth
        byteStop = nextIndex
        i = nextIndex
    if byteStop <= 0:
        return ellipsis
    let prefix = strings.SliceBytes(text, 0, byteStop)
    return strings.ConcatStr(prefix, ellipsis)

fn WebPaintClipRestrictsRect(clipX: int32, clipY: int32, clipW: int32, clipH: int32,
                             rectX: int32, rectY: int32, rectW: int32, rectH: int32): bool =
    if clipW <= 0 || clipH <= 0:
        return true
    if clipX > rectX:
        return true
    if clipY > rectY:
        return true
    if clipX + clipW < rectX + rectW:
        return true
    if clipY + clipH < rectY + rectH:
        return true
    return false

fn WebPaintBuildDisplayList(tree: var layout.WebLayoutTree,
                            registry: var WebPaintColorRegistry,
                            viewportX: int32,
                            viewportY: int32,
                            viewportWidth: int32,
                            viewportHeight: int32,
                            list: var WebPaintDisplayList): bool =
    list.items = []
    if viewportWidth <= 0 || viewportHeight <= 0:
        return false

    let viewportRight = viewportX + viewportWidth
    let viewportBottom = viewportY + viewportHeight
    if viewportRight <= viewportX || viewportBottom <= viewportY:
        return false

    for i in 0..<tree.boxes.len:
        let box = tree.boxes[i]
        if box.width < 0 || box.height < 0:
            return false

        let boxRight = box.x + box.width
        let boxBottom = box.y + box.height
        if boxRight <= box.x || boxBottom <= box.y:
            continue
        if boxRight <= viewportX || boxBottom <= viewportY || box.x >= viewportRight || box.y >= viewportBottom:
            continue

        var fillColor = 0
        if !WebPaintFindFillColor(registry, box.nodeId, fillColor):
            list.items = []
            return false

        let clippedX = WebPaintMaxInt32(box.x, viewportX)
        let clippedY = WebPaintMaxInt32(box.y, viewportY)
        let clippedRight = WebPaintMinInt32(boxRight, viewportRight)
        let clippedBottom = WebPaintMinInt32(boxBottom, viewportBottom)

        var item: WebPaintRectItem
        item.nodeId = box.nodeId
        item.x = clippedX
        item.y = clippedY
        item.width = clippedRight - clippedX
        item.height = clippedBottom - clippedY
        item.fillColor = fillColor
        add(list.items, item)
    return true

fn WebPaintDisplayItemCount(list: var WebPaintDisplayList): int32 =
    return list.items.len

fn WebPaintDisplayItemNodeAt(list: var WebPaintDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].nodeId

fn WebPaintDisplayItemXAt(list: var WebPaintDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].x

fn WebPaintDisplayItemYAt(list: var WebPaintDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].y

fn WebPaintDisplayItemWidthAt(list: var WebPaintDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].width

fn WebPaintDisplayItemHeightAt(list: var WebPaintDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].height

fn WebPaintDisplayItemFillColorAt(list: var WebPaintDisplayList, index: int32): int32 =
    if index < 0 || index >= list.items.len:
        return 0
    return list.items[index].fillColor

# ──────────────────────────────────────────────
# Extended Paint API — PaintOp types & helpers
# ──────────────────────────────────────────────

const
    PaintOpKindFillRect = 1
    PaintOpKindStrokeRect = 2
    PaintOpKindFillText = 3
    PaintOpKindStrokeText = 4
    PaintOpKindDrawImage = 5
    PaintOpKindClipRect = 6
    PaintOpKindGradientFill = 7
    PaintOpKindBoxShadow = 8
    PaintOpKindTextShadow = 9
    PaintOpKindIcon = 10

    PaintIconKindGlobe = 1
    PaintIconKindCheck = 2
    PaintIconKindX = 3
    PaintIconKindMenu = 4
    PaintIconKindSearch = 5
    PaintIconKindChevronRight = 6
    PaintIconKindPlus = 7
    PaintIconKindArrowLeft = 8
    PaintIconKindSvg = 1000

    PaintSvgPrimitiveLine = 1
    PaintSvgPrimitiveCircle = 2
    PaintSvgPrimitiveEllipse = 3
    PaintSvgPrimitiveRect = 4
    PaintSvgPrimitiveTriangle = 5
    # Marker, not a shape: subsequent Line primitives belong to a fill-style icon
    # (`fill="currentColor"` paths) and rasterize as evenodd-filled polygons.
    PaintSvgPrimitiveFillMarker = 6

type
    PaintRect =
        x: int32
        y: int32
        width: int32
        height: int32
        xPx2: int32
        yPx2: int32
        widthPx2: int32
        heightPx2: int32

    PaintTextRun =
        text: str
        charWidth: int32
        lineHeight: int32
        lineHeightPx2: int32
        fontSize: int32
        fontWeight: int32
        fontFamily: int32
        alignX: int32
        alignWidth: int32
        textAlign: int32

    PaintImage =
        imageId: int32
        srcWidth: int32
        srcHeight: int32

    PaintIcon =
        kind: int32
        size: int32
        primitives: PaintSvgPrimitive[]

    PaintGradientStop =
        color: int32
        position: int32

    PaintOp =
        kind: int32
        rect: PaintRect
        text: PaintTextRun
        image: PaintImage
        icon: PaintIcon
        clipRect: PaintRect
        color: int32
        borderWidth: int32
        borderTopWidth: int32
        borderRightWidth: int32
        borderBottomWidth: int32
        borderLeftWidth: int32
        borderRadius: int32
        borderTopLeftRadius: int32
        borderTopRightRadius: int32
        borderBottomRightRadius: int32
        borderBottomLeftRadius: int32
        gradientStops: PaintGradientStop[]
        gradientAngle: int32
        gradientKind: int32
        shadowOffsetX: int32
        shadowOffsetY: int32
        shadowBlur: int32
        shadowSpread: int32
        shadowInset: bool
        shadowText: str

fn PaintRectInit(r: var PaintRect) =
    r.x = 0
    r.y = 0
    r.width = 0
    r.height = 0
    r.xPx2 = 0
    r.yPx2 = 0
    r.widthPx2 = 0
    r.heightPx2 = 0

fn PaintRectSet(r: var PaintRect, x: int32, y: int32, w: int32, h: int32) =
    r.x = x
    r.y = y
    r.width = w
    r.height = h
    r.xPx2 = x * 2
    r.yPx2 = y * 2
    r.widthPx2 = w * 2
    r.heightPx2 = h * 2

fn PaintTextRunInit(run: var PaintTextRun) =
    run.text = ""
    run.charWidth = 8
    run.lineHeight = 16
    run.lineHeightPx2 = 0
    run.fontSize = 16
    run.fontWeight = 400
    run.fontFamily = layout.WebLayoutFontFamilySans
    run.alignX = 0
    run.alignWidth = 0
    run.textAlign = layout.WebLayoutTextAlignLeft

fn PaintTextRunSet(run: var PaintTextRun, text: str, charWidth: int32, lineHeight: int32, fontSize: int32) =
    run.text = text
    run.charWidth = charWidth
    run.lineHeight = lineHeight
    run.lineHeightPx2 = 0
    run.fontSize = fontSize
    run.fontWeight = 400
    run.fontFamily = layout.WebLayoutFontFamilySans
    run.alignX = 0
    run.alignWidth = 0
    run.textAlign = layout.WebLayoutTextAlignLeft

fn PaintImageInit(img: var PaintImage) =
    img.imageId = 0
    img.srcWidth = 0
    img.srcHeight = 0

fn PaintImageSet(img: var PaintImage, imageId: int32, srcWidth: int32, srcHeight: int32) =
    img.imageId = imageId
    img.srcWidth = srcWidth
    img.srcHeight = srcHeight

fn PaintOpInit(op: var PaintOp) =
    op.kind = PaintOpKindFillRect
    op.rect.x = 0
    op.rect.y = 0
    op.rect.width = 0
    op.rect.height = 0
    op.rect.xPx2 = 0
    op.rect.yPx2 = 0
    op.rect.widthPx2 = 0
    op.rect.heightPx2 = 0
    op.text.text = ""
    op.text.charWidth = 8
    op.text.lineHeight = 16
    op.text.lineHeightPx2 = 0
    op.text.fontSize = 16
    op.text.fontWeight = 400
    op.text.fontFamily = layout.WebLayoutFontFamilySans
    op.text.alignX = 0
    op.text.alignWidth = 0
    op.text.textAlign = layout.WebLayoutTextAlignLeft
    op.image.imageId = 0
    op.image.srcWidth = 0
    op.image.srcHeight = 0
    op.icon.kind = 0
    op.icon.size = 0
    op.icon.primitives = []
    op.clipRect.x = 0
    op.clipRect.y = 0
    op.clipRect.width = 0
    op.clipRect.height = 0
    op.clipRect.xPx2 = 0
    op.clipRect.yPx2 = 0
    op.clipRect.widthPx2 = 0
    op.clipRect.heightPx2 = 0
    op.color = 0
    op.borderWidth = 0
    op.borderTopWidth = 0
    op.borderRightWidth = 0
    op.borderBottomWidth = 0
    op.borderLeftWidth = 0
    op.borderRadius = 0
    op.borderTopLeftRadius = 0
    op.borderTopRightRadius = 0
    op.borderBottomRightRadius = 0
    op.borderBottomLeftRadius = 0
    op.gradientStops = []
    op.gradientAngle = 0
    op.gradientKind = 0
    op.shadowOffsetX = 0
    op.shadowOffsetY = 0
    op.shadowBlur = 0
    op.shadowSpread = 0
    op.shadowInset = false
    op.shadowText = ""

fn PaintOpMakeFillRect(x: int32, y: int32, w: int32, h: int32, color: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindFillRect
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.color = color
    return op

fn PaintOpMakeStrokeRect(x: int32, y: int32, w: int32, h: int32, color: int32, borderWidth: int32, borderRadius: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindStrokeRect
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.color = color
    op.borderWidth = borderWidth
    op.borderTopWidth = borderWidth
    op.borderRightWidth = borderWidth
    op.borderBottomWidth = borderWidth
    op.borderLeftWidth = borderWidth
    op.borderRadius = borderRadius
    op.borderTopLeftRadius = borderRadius
    op.borderTopRightRadius = borderRadius
    op.borderBottomRightRadius = borderRadius
    op.borderBottomLeftRadius = borderRadius
    return op

fn PaintOpMakeBorderRect(x: int32, y: int32, w: int32, h: int32, color: int32,
                         topWidth: int32, rightWidth: int32, bottomWidth: int32, leftWidth: int32,
                         borderRadius: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindStrokeRect
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.color = color
    op.borderTopWidth = topWidth
    op.borderRightWidth = rightWidth
    op.borderBottomWidth = bottomWidth
    op.borderLeftWidth = leftWidth
    op.borderWidth = topWidth
    if rightWidth > op.borderWidth:
        op.borderWidth = rightWidth
    if bottomWidth > op.borderWidth:
        op.borderWidth = bottomWidth
    if leftWidth > op.borderWidth:
        op.borderWidth = leftWidth
    op.borderRadius = borderRadius
    op.borderTopLeftRadius = borderRadius
    op.borderTopRightRadius = borderRadius
    op.borderBottomRightRadius = borderRadius
    op.borderBottomLeftRadius = borderRadius
    return op

@borrows
fn PaintOpMakeFillText(x: int32, y: int32, text: str, charWidth: int32, lineHeight: int32, fontSize: int32, color: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindFillText
    op.rect.x = x
    op.rect.y = y
    op.rect.width = charWidth * text.len
    op.rect.height = lineHeight
    op.rect.xPx2 = x * 2
    op.rect.yPx2 = y * 2
    op.rect.widthPx2 = op.rect.width * 2
    op.rect.heightPx2 = lineHeight * 2
    op.text.text = text
    op.text.charWidth = charWidth
    op.text.lineHeight = lineHeight
    op.text.lineHeightPx2 = 0
    op.text.fontSize = fontSize
    op.text.fontWeight = 400
    op.text.fontFamily = layout.WebLayoutFontFamilySans
    op.text.alignX = 0
    op.text.alignWidth = 0
    op.text.textAlign = layout.WebLayoutTextAlignLeft
    op.color = color
    return op

fn PaintOpMakeDrawImage(x: int32, y: int32, w: int32, h: int32, imageId: int32, srcWidth: int32, srcHeight: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindDrawImage
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.image.imageId = imageId
    op.image.srcWidth = srcWidth
    op.image.srcHeight = srcHeight
    return op

fn PaintOpMakeIcon(x: int32, y: int32, w: int32, h: int32, iconKind: int32, iconSize: int32, color: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindIcon
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.icon.kind = iconKind
    op.icon.size = iconSize
    op.icon.primitives = []
    op.color = color
    return op

fn PaintOpMakeClipRect(x: int32, y: int32, w: int32, h: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindClipRect
    op.clipRect.x = x
    op.clipRect.y = y
    op.clipRect.width = w
    op.clipRect.height = h
    return op

fn PaintSvgPrimitiveInit(primitive: var PaintSvgPrimitive) =
    primitive.kind = 0
    primitive.x1 = 0
    primitive.y1 = 0
    primitive.x2 = 0
    primitive.y2 = 0
    primitive.cx = 0
    primitive.cy = 0
    primitive.rx = 0
    primitive.ry = 0

fn PaintSvgPrimitiveSetLine(primitive: var PaintSvgPrimitive, x1: int32, y1: int32, x2: int32, y2: int32) =
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = PaintSvgPrimitiveLine
    primitive.x1 = x1
    primitive.y1 = y1
    primitive.x2 = x2
    primitive.y2 = y2

fn PaintSvgPrimitiveSetCircle(primitive: var PaintSvgPrimitive, cx: int32, cy: int32, r: int32) =
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = PaintSvgPrimitiveCircle
    primitive.cx = cx
    primitive.cy = cy
    primitive.rx = r
    primitive.ry = r

fn PaintSvgPrimitiveSetEllipse(primitive: var PaintSvgPrimitive, cx: int32, cy: int32, rx: int32, ry: int32) =
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = PaintSvgPrimitiveEllipse
    primitive.cx = cx
    primitive.cy = cy
    primitive.rx = rx
    primitive.ry = ry

fn PaintSvgPrimitiveSetRect(primitive: var PaintSvgPrimitive, x: int32, y: int32, w: int32, h: int32) =
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = PaintSvgPrimitiveRect
    primitive.x1 = x
    primitive.y1 = y
    primitive.x2 = w
    primitive.y2 = h

fn PaintSvgPrimitiveSetTriangle(primitive: var PaintSvgPrimitive, x1: int32, y1: int32, x2: int32, y2: int32, x3: int32, y3: int32) =
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = PaintSvgPrimitiveTriangle
    primitive.x1 = x1
    primitive.y1 = y1
    primitive.x2 = x2
    primitive.y2 = y2
    primitive.cx = x3
    primitive.cy = y3

fn PaintSvgPrimitiveSetFillMarker(primitive: var PaintSvgPrimitive) =
    PaintSvgPrimitiveInit(primitive)
    primitive.kind = PaintSvgPrimitiveFillMarker

fn PaintIconSvgPrimitiveCount(iconKind: int32): int32 =
    if iconKind == PaintIconKindGlobe:
        return 3
    if iconKind == PaintIconKindCheck:
        return 2
    if iconKind == PaintIconKindX:
        return 2
    if iconKind == PaintIconKindMenu:
        return 3
    if iconKind == PaintIconKindSearch:
        return 2
    if iconKind == PaintIconKindChevronRight:
        return 2
    if iconKind == PaintIconKindPlus:
        return 2
    if iconKind == PaintIconKindArrowLeft:
        return 3
    return 0

fn PaintIconSvgPrimitiveAt(iconKind: int32, index: int32, primitive: var PaintSvgPrimitive): bool =
    PaintSvgPrimitiveInit(primitive)
    if index < 0:
        return false
    if iconKind == PaintIconKindGlobe:
        if index == 0:
            PaintSvgPrimitiveSetCircle(primitive, 12, 12, 10)
            return true
        if index == 1:
            PaintSvgPrimitiveSetEllipse(primitive, 12, 12, 4, 10)
            return true
        if index == 2:
            PaintSvgPrimitiveSetLine(primitive, 2, 12, 22, 12)
            return true
        return false
    if iconKind == PaintIconKindCheck:
        if index == 0:
            PaintSvgPrimitiveSetLine(primitive, 20, 6, 9, 17)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 9, 17, 4, 12)
            return true
        return false
    if iconKind == PaintIconKindX:
        if index == 0:
            PaintSvgPrimitiveSetLine(primitive, 18, 6, 6, 18)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 6, 6, 18, 18)
            return true
        return false
    if iconKind == PaintIconKindMenu:
        if index == 0:
            PaintSvgPrimitiveSetLine(primitive, 4, 6, 20, 6)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 4, 12, 20, 12)
            return true
        if index == 2:
            PaintSvgPrimitiveSetLine(primitive, 4, 18, 20, 18)
            return true
        return false
    if iconKind == PaintIconKindSearch:
        if index == 0:
            PaintSvgPrimitiveSetCircle(primitive, 11, 11, 8)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 16, 16, 21, 21)
            return true
        return false
    if iconKind == PaintIconKindChevronRight:
        if index == 0:
            PaintSvgPrimitiveSetLine(primitive, 9, 6, 15, 12)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 15, 12, 9, 18)
            return true
        return false
    if iconKind == PaintIconKindPlus:
        if index == 0:
            PaintSvgPrimitiveSetLine(primitive, 12, 5, 12, 19)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 5, 12, 19, 12)
            return true
        return false
    if iconKind == PaintIconKindArrowLeft:
        if index == 0:
            PaintSvgPrimitiveSetLine(primitive, 19, 12, 5, 12)
            return true
        if index == 1:
            PaintSvgPrimitiveSetLine(primitive, 12, 5, 5, 12)
            return true
        if index == 2:
            PaintSvgPrimitiveSetLine(primitive, 12, 19, 5, 12)
            return true
        return false
    return false

fn PaintOpMakeGradientFill(x: int32, y: int32, w: int32, h: int32,
                            stops: var PaintGradientStop[],
                            angle: int32, kind: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindGradientFill
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.gradientStops = stops
    op.gradientAngle = angle
    op.gradientKind = kind
    return op

fn PaintOpMakeBoxShadow(x: int32, y: int32, w: int32, h: int32,
                         offsetX: int32, offsetY: int32,
                         blur: int32, spread: int32,
                         color: int32,
                         inset: bool): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindBoxShadow
    op.rect.x = x
    op.rect.y = y
    op.rect.width = w
    op.rect.height = h
    op.shadowOffsetX = offsetX
    op.shadowOffsetY = offsetY
    op.shadowBlur = blur
    op.shadowSpread = spread
    op.shadowInset = inset
    op.color = color
    return op

fn PaintOpMakeTextShadow(text: str, x: int32, y: int32,
                          offsetX: int32, offsetY: int32,
                          blur: int32, color: int32): PaintOp =
    var op: PaintOp
    PaintOpInit(op)
    op.kind = PaintOpKindTextShadow
    op.rect.x = x
    op.rect.y = y
    op.rect.width = 0
    op.rect.height = 0
    op.shadowOffsetX = offsetX
    op.shadowOffsetY = offsetY
    op.shadowBlur = blur
    op.color = color
    op.shadowText = text
    return op

fn PaintOpAppend(ops: var PaintOp[], op: PaintOp) =
    add(ops, op)

fn PaintOpCount(ops: var PaintOp[]): int32 =
    return ops.len

fn WebPaintDefaultFillColorForTag(tagText: str): int32 =
    if tagText == "button":
        return int32(0xFFE5E7EB)
    return int32(0xFFFFFFFF)

fn WebPaintEffectiveStackZIndex(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    var current = nodeId
    var effective = 0
    while current != 0:
        let styleIdx = layout.WebLayoutFindStyleIndex(tree, current)
        if styleIdx >= 0:
            if tree.styles[styleIdx].position != layout.WebLayoutPositionStatic && tree.styles[styleIdx].zIndex != 0:
                effective = tree.styles[styleIdx].zIndex
        current = layout.WebLayoutParentOf(tree, current)
    return effective

fn WebPaintBoxPaintOrderBefore(tree: var layout.WebLayoutTree, leftIndex: int32, rightIndex: int32): bool =
    if leftIndex == rightIndex:
        return false
    if leftIndex < 0 || rightIndex < 0:
        return false
    if leftIndex >= tree.boxes.len || rightIndex >= tree.boxes.len:
        return false
    let leftBox = tree.boxes[leftIndex]
    let rightBox = tree.boxes[rightIndex]
    if layout.WebLayoutIsAncestorOf(tree, leftBox.nodeId, rightBox.nodeId):
        return true
    if layout.WebLayoutIsAncestorOf(tree, rightBox.nodeId, leftBox.nodeId):
        return false
    let leftEffectiveZ = WebPaintEffectiveStackZIndex(tree, leftBox.nodeId)
    let rightEffectiveZ = WebPaintEffectiveStackZIndex(tree, rightBox.nodeId)
    if leftEffectiveZ != rightEffectiveZ:
        return leftEffectiveZ < rightEffectiveZ
    if leftBox.zIndex != rightBox.zIndex:
        return leftBox.zIndex < rightBox.zIndex
    return leftIndex < rightIndex

fn WebPaintBuildBoxPaintOrder(tree: var layout.WebLayoutTree, outOrder: var int32[]): bool =
    # setLen(0) instead of []: truncated in place so a caller-owned scratch
    # array keeps its capacity across rebuilds (no per-swap realloc chain).
    setLen(outOrder, 0)
    for i in 0..<tree.boxes.len:
        add(outOrder, i)
    for i in 1..<outOrder.len:
        var j = i
        while j > 0:
            let current = outOrder[j]
            let previous = outOrder[j - 1]
            if !WebPaintBoxPaintOrderBefore(tree, current, previous):
                break
            outOrder[j] = previous
            outOrder[j - 1] = current
            j = j - 1
    return true

fn WebPaintBuildOpsFromLayoutTree(tree: var layout.WebLayoutTree, ops: var PaintOp[]): bool =
    ops = []
    var paintOrder: int32[]
    if !WebPaintBuildBoxPaintOrder(tree, paintOrder):
        return false
    for oi in 0..<paintOrder.len:
        let i = paintOrder[oi]
        let box = tree.boxes[i]
        if box.width <= 0 || box.height <= 0:
            continue
        if !box.visible:
            continue
        let styleIndex = layout.WebLayoutFindStyleIndex(tree, box.nodeId)
        if styleIndex < 0:
            return false
        let styleBox = tree.styles[styleIndex]
        PaintOpAppend(ops, PaintOpMakeFillRect(box.x, box.y, box.width, box.height, WebPaintDefaultFillColorForTag("")))
        if styleBox.textContent.len > 0:
            var textX = box.x + styleBox.paddingLeft
            let textY = box.y + styleBox.paddingTop
            var fontSize = styleBox.fontSize > 0 ? styleBox.fontSize : 16
            if styleBox.renderFontSize > 0:
                fontSize = styleBox.renderFontSize
            var segmentText = styleBox.textContent
            if box.textStop > box.textStart && box.textStop <= styleBox.textContent.len:
                segmentText = strings.SliceBytes(styleBox.textContent, box.textStart, box.textStop - box.textStart)
            let textWidth = layout.WebLayoutEstimateTextWidthWeighted(segmentText, fontSize, styleBox.renderFontWeight)
            let textAreaWidth = box.width - styleBox.paddingLeft - styleBox.paddingRight
            if textAreaWidth > textWidth:
                if styleBox.textAlign == layout.WebLayoutTextAlignCenter:
                    textX = box.x + styleBox.paddingLeft + (textAreaWidth - textWidth) / 2
                elif styleBox.textAlign == layout.WebLayoutTextAlignRight:
                    textX = box.x + styleBox.paddingLeft + textAreaWidth - textWidth
            var textLineHeightPx2 = layout.WebLayoutEffectiveTextLineHeightPx2ForText(fontSize, styleBox.lineHeight, styleBox.lineHeightPx2, segmentText, styleBox.renderFontWeight, styleBox.fontFamily)
            var textOp = PaintOpMakeFillText(textX, textY, segmentText, fontSize * 3 / 5, (textLineHeightPx2 + 1) / 2, fontSize, int32(0xFF111827))
            textOp.rect.xPx2 = textX * 2
            textOp.rect.yPx2 = box.yPx2 + styleBox.paddingTop * 2
            textOp.rect.widthPx2 = textOp.rect.width * 2
            textOp.rect.heightPx2 = textLineHeightPx2
            textOp.text.lineHeightPx2 = textLineHeightPx2
            textOp.text.alignX = box.x + styleBox.paddingLeft
            textOp.text.alignWidth = textAreaWidth
            textOp.text.textAlign = styleBox.textAlign
            if styleBox.renderFontWeight > 0:
                textOp.text.fontWeight = styleBox.renderFontWeight
            textOp.text.fontFamily = styleBox.fontFamily
            PaintOpAppend(ops, textOp)
    return true

fn WebPaintBuildOpsFromLayoutTreeWithRegistry(tree: var layout.WebLayoutTree,
                                              registry: var WebPaintColorRegistry,
                                              ops: var PaintOp[]): bool =
    ops = []
    var paintOrder: int32[]
    if !WebPaintBuildBoxPaintOrder(tree, paintOrder):
        return false
    for oi in 0..<paintOrder.len:
        let i = paintOrder[oi]
        let box = tree.boxes[i]
        if !box.visible:
            continue
        let effectiveOpacity = WebPaintEffectiveOpacity(tree, box.nodeId)
        if effectiveOpacity <= 0:
            continue
        let styleIndex = layout.WebLayoutFindStyleIndex(tree, box.nodeId)
        if styleIndex < 0:
            return false
        let styleBox = tree.styles[styleIndex]
        var iconKind: int32
        var iconColor: int32
        var iconSize: int32
        let hasIcon = WebPaintFindIconStyle(registry, box.nodeId, iconKind, iconColor, iconSize)
        if (box.width <= 0 || box.height <= 0) && !hasIcon:
            continue
        var clipX: int32
        var clipY: int32
        var clipW: int32
        var clipH: int32
        let hasClip = WebPaintFindAncestorClip(tree, box.nodeId, clipX, clipY, clipW, clipH)
        var fillColor: int32
        var fillTopLeftRadius: int32
        var fillTopRightRadius: int32
        var fillBottomRightRadius: int32
        var fillBottomLeftRadius: int32
        if WebPaintFindFillCornerStyle(registry, box.nodeId, fillColor,
                fillTopLeftRadius, fillTopRightRadius, fillBottomRightRadius, fillBottomLeftRadius):
            fillColor = WebPaintApplyOpacityToColor(fillColor, effectiveOpacity)
            var fillOp = PaintOpMakeFillRect(box.x, box.y, box.width, box.height, fillColor)
            fillOp.borderRadius = fillTopLeftRadius
            if fillTopRightRadius > fillOp.borderRadius:
                fillOp.borderRadius = fillTopRightRadius
            if fillBottomRightRadius > fillOp.borderRadius:
                fillOp.borderRadius = fillBottomRightRadius
            if fillBottomLeftRadius > fillOp.borderRadius:
                fillOp.borderRadius = fillBottomLeftRadius
            fillOp.borderTopLeftRadius = fillTopLeftRadius
            fillOp.borderTopRightRadius = fillTopRightRadius
            fillOp.borderBottomRightRadius = fillBottomRightRadius
            fillOp.borderBottomLeftRadius = fillBottomLeftRadius
            if hasClip && WebPaintClipRestrictsRect(clipX, clipY, clipW, clipH, box.x, box.y, box.width, box.height):
                fillOp.clipRect.x = clipX
                fillOp.clipRect.y = clipY
                fillOp.clipRect.width = clipW
                fillOp.clipRect.height = clipH
            PaintOpAppend(ops, fillOp)
        var gradStart: int32
        var gradEnd: int32
        var gradAngle: int32
        var gradColors: int32[]
        var gradPos: int32[]
        var gradSegX0: int32[]
        var gradSegX1: int32[]
        var gradAngleMulti: int32
        var gradEmitted = false
        if WebPaintFindGradientFillStops(registry, box.nodeId, gradColors, gradPos, gradAngleMulti, gradSegX0, gradSegX1):
            var segIdx = 0
            while segIdx + 1 < gradColors.len:
                let bandY0 = box.y + (gradPos[segIdx] * box.height) / 1000
                let bandY1 = box.y + (gradPos[segIdx + 1] * box.height) / 1000
                if bandY1 > bandY0:
                    var segStops: PaintGradientStop[]
                    var stopA: PaintGradientStop
                    stopA.color = WebPaintApplyOpacityToColor(gradColors[segIdx], effectiveOpacity)
                    stopA.position = 0
                    add(segStops, stopA)
                    var stopB: PaintGradientStop
                    stopB.color = WebPaintApplyOpacityToColor(gradColors[segIdx + 1], effectiveOpacity)
                    stopB.position = 1000
                    add(segStops, stopB)
                    var opX = box.x
                    var opW = box.width
                    var segOp = PaintOpMakeGradientFill(opX, bandY0, opW, bandY1 - bandY0, segStops, gradAngleMulti, 0)
                    segOp.borderRadius = fillTopLeftRadius
                    if fillTopRightRadius > segOp.borderRadius:
                        segOp.borderRadius = fillTopRightRadius
                    if fillBottomRightRadius > segOp.borderRadius:
                        segOp.borderRadius = fillBottomRightRadius
                    if fillBottomLeftRadius > segOp.borderRadius:
                        segOp.borderRadius = fillBottomLeftRadius
                    segOp.borderTopLeftRadius = fillTopLeftRadius
                    segOp.borderTopRightRadius = fillTopRightRadius
                    segOp.borderBottomRightRadius = fillBottomRightRadius
                    segOp.borderBottomLeftRadius = fillBottomLeftRadius
                    if hasClip && WebPaintClipRestrictsRect(clipX, clipY, clipW, clipH, segOp.rect.x, segOp.rect.y, segOp.rect.width, segOp.rect.height):
                        segOp.clipRect.x = clipX
                        segOp.clipRect.y = clipY
                        segOp.clipRect.width = clipW
                        segOp.clipRect.height = clipH
                    let stopAAlpha = (stopA.color >> 24) & 0xFF
                    let stopBAlpha = (stopB.color >> 24) & 0xFF
                    if stopAAlpha > 0 || stopBAlpha > 0:
                                            PaintOpAppend(ops, segOp)
                    gradEmitted = true
                segIdx = segIdx + 1
        if !gradEmitted && WebPaintFindGradientFillStyle(registry, box.nodeId, gradStart, gradEnd, gradAngle):
            gradStart = WebPaintApplyOpacityToColor(gradStart, effectiveOpacity)
            gradEnd = WebPaintApplyOpacityToColor(gradEnd, effectiveOpacity)
            var stops: PaintGradientStop[]
            var startStop: PaintGradientStop
            startStop.color = gradStart
            startStop.position = 0
            add(stops, startStop)
            var endStop: PaintGradientStop
            endStop.color = gradEnd
            endStop.position = 1000
            add(stops, endStop)
            var gradientOp = PaintOpMakeGradientFill(box.x, box.y, box.width, box.height, stops, gradAngle, 0)
            gradientOp.borderRadius = fillTopLeftRadius
            if fillTopRightRadius > gradientOp.borderRadius:
                gradientOp.borderRadius = fillTopRightRadius
            if fillBottomRightRadius > gradientOp.borderRadius:
                gradientOp.borderRadius = fillBottomRightRadius
            if fillBottomLeftRadius > gradientOp.borderRadius:
                gradientOp.borderRadius = fillBottomLeftRadius
            gradientOp.borderTopLeftRadius = fillTopLeftRadius
            gradientOp.borderTopRightRadius = fillTopRightRadius
            gradientOp.borderBottomRightRadius = fillBottomRightRadius
            gradientOp.borderBottomLeftRadius = fillBottomLeftRadius
            if hasClip && WebPaintClipRestrictsRect(clipX, clipY, clipW, clipH, box.x, box.y, box.width, box.height):
                gradientOp.clipRect.x = clipX
                gradientOp.clipRect.y = clipY
                gradientOp.clipRect.width = clipW
                gradientOp.clipRect.height = clipH
            PaintOpAppend(ops, gradientOp)
        var borderColor: int32
        var borderTopWidth: int32
        var borderRightWidth: int32
        var borderBottomWidth: int32
        var borderLeftWidth: int32
        var borderTopLeftRadius: int32
        var borderTopRightRadius: int32
        var borderBottomRightRadius: int32
        var borderBottomLeftRadius: int32
        if WebPaintFindBorderCornerStyle(registry, box.nodeId, borderColor,
                borderTopWidth, borderRightWidth, borderBottomWidth, borderLeftWidth,
                borderTopLeftRadius, borderTopRightRadius, borderBottomRightRadius, borderBottomLeftRadius):
            if borderTopWidth > 0 || borderRightWidth > 0 || borderBottomWidth > 0 || borderLeftWidth > 0:
                borderColor = WebPaintApplyOpacityToColor(borderColor, effectiveOpacity)
                var borderPaintRadius = borderTopLeftRadius
                if borderTopRightRadius > borderPaintRadius:
                    borderPaintRadius = borderTopRightRadius
                if borderBottomRightRadius > borderPaintRadius:
                    borderPaintRadius = borderBottomRightRadius
                if borderBottomLeftRadius > borderPaintRadius:
                    borderPaintRadius = borderBottomLeftRadius
                var borderOp = PaintOpMakeBorderRect(box.x, box.y, box.width, box.height, borderColor,
                    borderTopWidth, borderRightWidth, borderBottomWidth, borderLeftWidth, borderPaintRadius)
                borderOp.borderTopLeftRadius = borderTopLeftRadius
                borderOp.borderTopRightRadius = borderTopRightRadius
                borderOp.borderBottomRightRadius = borderBottomRightRadius
                borderOp.borderBottomLeftRadius = borderBottomLeftRadius
                if hasClip && WebPaintClipRestrictsRect(clipX, clipY, clipW, clipH, borderOp.rect.x, borderOp.rect.y, borderOp.rect.width, borderOp.rect.height):
                    borderOp.clipRect.x = clipX
                    borderOp.clipRect.y = clipY
                    borderOp.clipRect.width = clipW
                    borderOp.clipRect.height = clipH
                PaintOpAppend(ops, borderOp)
        if styleBox.textContent.len > 0:
            var textX = box.x + styleBox.paddingLeft
            let textY = box.y + styleBox.paddingTop
            var fontSize = styleBox.fontSize > 0 ? styleBox.fontSize : 16
            if styleBox.renderFontSize > 0:
                fontSize = styleBox.renderFontSize
            var paintText = styleBox.textContent
            // Inline word-segment boxes share the text node's full textContent and carry
            // their own byte range: paint only the segment slice, not the whole text.
            if box.textStop > box.textStart && box.textStop <= styleBox.textContent.len:
                paintText = strings.SliceBytes(styleBox.textContent, box.textStart, box.textStop - box.textStart)
            var ellipsisX: int32
            var ellipsisY: int32
            var ellipsisW: int32
            var ellipsisH: int32
            let hasEllipsis = WebPaintFindTextOverflowEllipsisBox(tree, box.nodeId, ellipsisX, ellipsisY, ellipsisW, ellipsisH)
            var textAreaX = box.x + styleBox.paddingLeft
            var textAreaWidth = box.width - styleBox.paddingLeft - styleBox.paddingRight
            if hasEllipsis:
                paintText = WebPaintEllipsizeText(paintText, fontSize, ellipsisW)
                textAreaX = ellipsisX
                textAreaWidth = ellipsisW
                textX = ellipsisX
            let textWidth = layout.WebLayoutEstimateTextWidthWeighted(paintText, fontSize, styleBox.renderFontWeight)
            if textAreaWidth > textWidth:
                if styleBox.textAlign == layout.WebLayoutTextAlignCenter:
                    textX = textAreaX + (textAreaWidth - textWidth) / 2
                elif styleBox.textAlign == layout.WebLayoutTextAlignRight:
                    textX = textAreaX + textAreaWidth - textWidth
            var textColor = int32(0xFF111827)
            var registeredTextColor: int32
            if WebPaintFindInheritedTextColor(tree, registry, box.nodeId, registeredTextColor):
                textColor = registeredTextColor
            textColor = WebPaintApplyOpacityToColor(textColor, effectiveOpacity)
            var textLineHeightPx2 = layout.WebLayoutEffectiveTextLineHeightPx2ForText(fontSize, styleBox.lineHeight, styleBox.lineHeightPx2, paintText, styleBox.renderFontWeight, styleBox.fontFamily)
            var textOp = PaintOpMakeFillText(textX, textY, paintText, fontSize * 3 / 5, (textLineHeightPx2 + 1) / 2, fontSize, textColor)
            textOp.rect.xPx2 = textX * 2
            textOp.rect.yPx2 = box.yPx2 + styleBox.paddingTop * 2
            textOp.rect.widthPx2 = textOp.rect.width * 2
            textOp.rect.heightPx2 = textLineHeightPx2
            textOp.text.lineHeightPx2 = textLineHeightPx2
            textOp.text.alignX = textAreaX
            textOp.text.alignWidth = textAreaWidth
            textOp.text.textAlign = styleBox.textAlign
            if styleBox.renderFontWeight > 0:
                textOp.text.fontWeight = styleBox.renderFontWeight
            textOp.text.fontFamily = styleBox.fontFamily
            if hasClip && WebPaintClipRestrictsRect(clipX, clipY, clipW, clipH, textOp.rect.x, textOp.rect.y, textOp.rect.width, textOp.rect.height):
                textOp.clipRect.x = clipX
                textOp.clipRect.y = clipY
                textOp.clipRect.width = clipW
                textOp.clipRect.height = clipH
            PaintOpAppend(ops, textOp)
        if hasIcon:
            var iconBoxX = box.x
            var iconBoxY = box.y
            var iconBoxW = box.width
            var iconBoxH = box.height
            if iconBoxW <= 0 || iconBoxH <= 0:
                let parentId = layout.WebLayoutParentOf(tree, box.nodeId)
                let parentBoxIndex = WebPaintFindBoxIndexForNode(tree, parentId)
                if parentBoxIndex >= 0:
                    let parentBox = tree.boxes[parentBoxIndex]
                    iconBoxX = parentBox.x
                    iconBoxY = parentBox.y
                    iconBoxW = parentBox.width
                    iconBoxH = parentBox.height
            if iconBoxW > 0 && iconBoxH > 0:
                var drawSize = iconSize
                if drawSize <= 0:
                    drawSize = 16
                if drawSize > iconBoxW:
                    drawSize = iconBoxW
                if drawSize > iconBoxH:
                    drawSize = iconBoxH
                let iconX = iconBoxX + (iconBoxW - drawSize) / 2
                let iconY = iconBoxY + (iconBoxH - drawSize) / 2
                iconColor = WebPaintApplyOpacityToColor(iconColor, effectiveOpacity)
                var iconOp = PaintOpMakeIcon(iconX, iconY, drawSize, drawSize, iconKind, drawSize, iconColor)
                let primitiveStatus = WebPaintCopyIconPrimitives(registry, box.nodeId, iconOp.icon.primitives)
                if primitiveStatus < 0:
                    return false
                if hasClip && WebPaintClipRestrictsRect(clipX, clipY, clipW, clipH, iconOp.rect.x, iconOp.rect.y, iconOp.rect.width, iconOp.rect.height):
                    iconOp.clipRect.x = clipX
                    iconOp.clipRect.y = clipY
                    iconOp.clipRect.width = clipW
                    iconOp.clipRect.height = clipH
                PaintOpAppend(ops, iconOp)
    return true
