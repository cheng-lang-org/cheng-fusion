# web_audio_runtime.cheng
# Web Audio API for Cheng Web runtime.
# Pure computation: buffer generation and parameter transforms, no audio output.
# AudioContext manages all nodes.

import std/seqs

type
    WebAudioContext =
        contextId: int32
        sampleRate: int32
        destination: int32
        currentTime: float64
        state: str

    WebAudioNode =
        nodeId: int32
        contextId: int32
        kind: int32
        inputs: int32[]
        outputs: int32[]
        params: WebAudioParam[]

    WebAudioParam =
        name: str
        value: float64
        minValue: float64
        maxValue: float64

    WebAudioBuffer =
        bufferId: int32
        sampleRate: int32
        length: int32
        numberOfChannels: int32
        data: float64[]

const
    WebAudioNodeOscillator = 0
    WebAudioNodeGain = 1
    WebAudioNodeBiquadFilter = 2
    WebAudioNodeBufferSource = 3
    WebAudioNodeDestination = 4

    WebAudioOscillatorSine = 0
    WebAudioOscillatorSquare = 1
    WebAudioOscillatorSawtooth = 2
    WebAudioOscillatorTriangle = 3

    WebAudioFilterLowpass = 0
    WebAudioFilterHighpass = 1
    WebAudioFilterBandpass = 2

var audioContexts: WebAudioContext[]
var nodeTable: WebAudioNode[]
var audioBuffers: WebAudioBuffer[]
var nextContextId: int32 = 1
var nextNodeId: int32 = 1
var nextBufferId: int32 = 1

fn WebAudioContextFindIndex(contextId: int32): int32 =
    for i in 0..<audioContexts.len:
        if audioContexts[i].contextId == contextId:
            return i
    return -1

fn WebAudioNodeFindIndex(nodeId: int32): int32 =
    for i in 0..<nodeTable.len:
        if nodeTable[i].nodeId == nodeId:
            return i
    return -1

fn WebAudioBufferFindIndex(bufferId: int32): int32 =
    for i in 0..<audioBuffers.len:
        if audioBuffers[i].bufferId == bufferId:
            return i
    return -1

# ──────────────────────────────────────
# AudioContext
# ──────────────────────────────────────

fn WebAudioContextCreate(): int32 =
    let contextId = nextContextId
    nextContextId = nextContextId + 1
    var ctx: WebAudioContext
    ctx.contextId = contextId
    ctx.sampleRate = 44100
    ctx.destination = 0
    ctx.currentTime = float64(0.0)
    ctx.state = "running"
    add(audioContexts, ctx)
    let destNodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    var destNode: WebAudioNode
    destNode.nodeId = destNodeId
    destNode.contextId = contextId
    destNode.kind = WebAudioNodeDestination
    destNode.inputs = []
    destNode.outputs = []
    destNode.params = []
    add(nodeTable, destNode)
    for i in 0..<audioContexts.len:
        if audioContexts[i].contextId == contextId:
            audioContexts[i].destination = destNodeId
    return contextId

fn WebAudioContextResume(contextId: int32): bool =
    let index = WebAudioContextFindIndex(contextId)
    if index < 0:
        return false
    if audioContexts[index].state == "closed":
        return false
    audioContexts[index].state = "running"
    return true

fn WebAudioContextSuspend(contextId: int32): bool =
    let index = WebAudioContextFindIndex(contextId)
    if index < 0:
        return false
    if audioContexts[index].state == "closed":
        return false
    audioContexts[index].state = "suspended"
    return true

fn WebAudioContextClose(contextId: int32): bool =
    let index = WebAudioContextFindIndex(contextId)
    if index < 0:
        return false
    audioContexts[index].state = "closed"
    return true

fn WebAudioContextGetCurrentTime(contextId: int32): float64 =
    let index = WebAudioContextFindIndex(contextId)
    if index < 0:
        return float64(0.0)
    return audioContexts[index].currentTime

# ──────────────────────────────────────
# OscillatorNode
# ──────────────────────────────────────

fn WebAudioCreateOscillator(contextId: int32, waveformType: int32, frequency: float64): int32 =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return 0
    let nodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    var node: WebAudioNode
    node.nodeId = nodeId
    node.contextId = contextId
    node.kind = WebAudioNodeOscillator
    node.inputs = []
    node.outputs = []
    var params: WebAudioParam[]
    var tParam: WebAudioParam
    tParam.name = "type"
    tParam.value = float64(waveformType)
    tParam.minValue = float64(0.0)
    tParam.maxValue = float64(3.0)
    add(params, tParam)
    var fParam: WebAudioParam
    fParam.name = "frequency"
    fParam.value = frequency
    fParam.minValue = float64(-3.402823e38)
    fParam.maxValue = float64(3.402823e38)
    add(params, fParam)
    var dParam: WebAudioParam
    dParam.name = "detune"
    dParam.value = float64(0.0)
    dParam.minValue = float64(-3.402823e38)
    dParam.maxValue = float64(3.402823e38)
    add(params, dParam)
    node.params = params
    add(nodeTable, node)
    return nodeId

fn WebAudioOscillatorSetFrequency(nodeId: int32, frequency: float64): bool =
    let ni = WebAudioNodeFindIndex(nodeId)
    if ni < 0:
        return false
    var node = nodeTable[ni]
    if node.kind != WebAudioNodeOscillator:
        return false
    for pi in 0..<node.params.len:
        if node.params[pi].name == "frequency":
            var param = node.params[pi]
            param.value = frequency
            node.params[pi] = param
            nodeTable[ni] = node
            return true
    return false

fn WebAudioOscillatorSetType(nodeId: int32, waveformType: int32): bool =
    let ni = WebAudioNodeFindIndex(nodeId)
    if ni < 0:
        return false
    var node = nodeTable[ni]
    if node.kind != WebAudioNodeOscillator:
        return false
    for pi in 0..<node.params.len:
        if node.params[pi].name == "type":
            var param = node.params[pi]
            param.value = float64(waveformType)
            node.params[pi] = param
            nodeTable[ni] = node
            return true
    var tParam: WebAudioParam
    tParam.name = "type"
    tParam.value = float64(waveformType)
    tParam.minValue = float64(0.0)
    tParam.maxValue = float64(3.0)
    add(node.params, tParam)
    nodeTable[ni] = node
    return true

# ──────────────────────────────────────
# GainNode
# ──────────────────────────────────────

fn WebAudioCreateGain(contextId: int32, gain: float64): int32 =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return 0
    let nodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    var node: WebAudioNode
    node.nodeId = nodeId
    node.contextId = contextId
    node.kind = WebAudioNodeGain
    node.inputs = []
    node.outputs = []
    var params: WebAudioParam[]
    var gParam: WebAudioParam
    gParam.name = "gain"
    gParam.value = gain
    gParam.minValue = float64(0.0)
    gParam.maxValue = float64(1.0)
    add(params, gParam)
    node.params = params
    add(nodeTable, node)
    return nodeId

fn WebAudioGainSetValue(nodeId: int32, gain: float64): bool =
    let ni = WebAudioNodeFindIndex(nodeId)
    if ni < 0:
        return false
    var node = nodeTable[ni]
    if node.kind != WebAudioNodeGain:
        return false
    for pi in 0..<node.params.len:
        if node.params[pi].name == "gain":
            var param = node.params[pi]
            param.value = gain
            node.params[pi] = param
            nodeTable[ni] = node
            return true
    return false

# ──────────────────────────────────────
# BiquadFilterNode
# ──────────────────────────────────────

fn WebAudioCreateBiquadFilter(contextId: int32, filterType: int32, frequency: float64, Q: float64): int32 =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return 0
    let nodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    var node: WebAudioNode
    node.nodeId = nodeId
    node.contextId = contextId
    node.kind = WebAudioNodeBiquadFilter
    node.inputs = []
    node.outputs = []
    var params: WebAudioParam[]
    var tParam: WebAudioParam
    tParam.name = "type"
    tParam.value = float64(filterType)
    tParam.minValue = float64(0.0)
    tParam.maxValue = float64(2.0)
    add(params, tParam)
    var fParam: WebAudioParam
    fParam.name = "frequency"
    fParam.value = frequency
    fParam.minValue = float64(0.0)
    fParam.maxValue = float64(3.402823e38)
    add(params, fParam)
    var qParam: WebAudioParam
    qParam.name = "Q"
    qParam.value = Q
    qParam.minValue = float64(0.0001)
    qParam.maxValue = float64(1000.0)
    add(params, qParam)
    node.params = params
    add(nodeTable, node)
    return nodeId

# ──────────────────────────────────────
# BufferSourceNode
# ──────────────────────────────────────

fn WebAudioCreateBufferSource(contextId: int32, bufferId: int32): int32 =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return 0
    let bufIndex = WebAudioBufferFindIndex(bufferId)
    if bufIndex < 0:
        return 0
    let nodeId = nextNodeId
    nextNodeId = nextNodeId + 1
    var node: WebAudioNode
    node.nodeId = nodeId
    node.contextId = contextId
    node.kind = WebAudioNodeBufferSource
    node.inputs = []
    node.outputs = []
    var params: WebAudioParam[]
    var rParam: WebAudioParam
    rParam.name = "playbackRate"
    rParam.value = float64(1.0)
    rParam.minValue = float64(-3.402823e38)
    rParam.maxValue = float64(3.402823e38)
    add(params, rParam)
    node.params = params
    add(nodeTable, node)
    return nodeId

fn WebAudioBufferSourceStart(nodeId: int32): bool =
    let ni = WebAudioNodeFindIndex(nodeId)
    if ni < 0:
        return false
    if nodeTable[ni].kind != WebAudioNodeBufferSource:
        return false
    return true

fn WebAudioBufferSourceStop(nodeId: int32): bool =
    let ni = WebAudioNodeFindIndex(nodeId)
    if ni < 0:
        return false
    if nodeTable[ni].kind != WebAudioNodeBufferSource:
        return false
    return true

# ──────────────────────────────────────
# AudioBuffer
# ──────────────────────────────────────

fn WebAudioCreateBuffer(contextId: int32, numChannels: int32, length: int32, sampleRate: int32): int32 =
    if numChannels <= 0 || length <= 0 || sampleRate <= 0:
        return 0
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return 0
    let bufferId = nextBufferId
    nextBufferId = nextBufferId + 1
    var buffer: WebAudioBuffer
    buffer.bufferId = bufferId
    buffer.sampleRate = sampleRate
    buffer.length = length
    buffer.numberOfChannels = numChannels
    var totalSamples = numChannels * length
    var data: float64[]
    setLen(data, totalSamples)
    for i in 0..<totalSamples:
        data[i] = float64(0.0)
    buffer.data = data
    add(audioBuffers, buffer)
    return bufferId

fn WebAudioBufferGetChannelData(bufferId: int32, channel: int32, out: var float64[]): bool =
    let bufIndex = WebAudioBufferFindIndex(bufferId)
    if bufIndex < 0:
        out = []
        return false
    let buf = audioBuffers[bufIndex]
    if channel < 0 || channel >= buf.numberOfChannels:
        out = []
        return false
    var channelData: float64[]
    setLen(channelData, buf.length)
    for i in 0..<buf.length:
        let idx = i * buf.numberOfChannels + channel
        channelData[i] = buf.data[idx]
    out = channelData
    return true

# ──────────────────────────────────────
# Connection
# ──────────────────────────────────────

fn WebAudioConnect(contextId: int32, sourceNodeId: int32, destNodeId: int32): bool =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return false
    let si = WebAudioNodeFindIndex(sourceNodeId)
    if si < 0:
        return false
    let di = WebAudioNodeFindIndex(destNodeId)
    if di < 0:
        return false
    if sourceNodeId == destNodeId:
        return false
    var sn = nodeTable[si]
    var dn = nodeTable[di]
    add(sn.outputs, destNodeId)
    add(dn.inputs, sourceNodeId)
    nodeTable[si] = sn
    nodeTable[di] = dn
    return true

fn WebAudioDisconnect(contextId: int32, sourceNodeId: int32, destNodeId: int32): bool =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return false
    let si = WebAudioNodeFindIndex(sourceNodeId)
    if si < 0:
        return false
    let di = WebAudioNodeFindIndex(destNodeId)
    if di < 0:
        return false
    var sn = nodeTable[si]
    var no: int32[]
    for i in 0..<sn.outputs.len:
        if sn.outputs[i] != destNodeId:
            add(no, sn.outputs[i])
    sn.outputs = no
    nodeTable[si] = sn
    var dn = nodeTable[di]
    var ni: int32[]
    for i in 0..<dn.inputs.len:
        if dn.inputs[i] != sourceNodeId:
            add(ni, dn.inputs[i])
    dn.inputs = ni
    nodeTable[di] = dn
    return true

# ──────────────────────────────────────
# Signal generation (pure math, no FFI)
# Cold compiler restriction: no float64 function calls, inline sin directly.
# ──────────────────────────────────────

fn WebAudioGenerateSine(buffer: var float64[], frequency: float64, sampleRate: int32, amplitude: float64) =
    let pi = float64(3.141592653589793)
    let twoPiOverSR = float64(2.0) * pi / float64(sampleRate)
    let omega = twoPiOverSR * frequency
    let twoPi = pi * float64(2.0)
    for i in 0..<buffer.len:
        let angle = omega * float64(i)
        var xr = angle
        while xr > pi: xr = xr - twoPi
        while xr < float64(0.0) - pi: xr = xr + twoPi
        let x2 = xr * xr
        let x3 = x2 * xr
        let x5 = x3 * x2
        let x7 = x5 * x2
        let sinVal = xr - x3/float64(6.0) + x5/float64(120.0) - x7/float64(5040.0)
        buffer[i] = amplitude * sinVal

fn WebAudioGenerateSquare(buffer: var float64[], frequency: float64, sampleRate: int32, amplitude: float64) =
    let samplesPerPeriod = float64(sampleRate) / frequency
    let halfPeriod = samplesPerPeriod / float64(2.0)
    for i in 0..<buffer.len:
        let fi = float64(i)
        let periods = fi / samplesPerPeriod
        let phase = fi - float64(int32(periods)) * samplesPerPeriod
        if phase < halfPeriod:
            buffer[i] = amplitude
        else:
            buffer[i] = float64(0.0) - amplitude

fn WebAudioGenerateSawtooth(buffer: var float64[], frequency: float64, sampleRate: int32, amplitude: float64) =
    let samplesPerPeriod = float64(sampleRate) / frequency
    for i in 0..<buffer.len:
        let fi = float64(i)
        let periods = fi / samplesPerPeriod
        let phase = fi - float64(int32(periods)) * samplesPerPeriod
        let normalized = phase / samplesPerPeriod
        buffer[i] = amplitude * (float64(2.0) * normalized - float64(1.0))

fn WebAudioGenerateTriangle(buffer: var float64[], frequency: float64, sampleRate: int32, amplitude: float64) =
    let samplesPerPeriod = float64(sampleRate) / frequency
    let halfPeriod = samplesPerPeriod / float64(2.0)
    for i in 0..<buffer.len:
        let fi = float64(i)
        let periods = fi / samplesPerPeriod
        let phase = fi - float64(int32(periods)) * samplesPerPeriod
        if phase < halfPeriod:
            buffer[i] = amplitude * (float64(2.0) * phase / halfPeriod - float64(1.0))
        else:
            let phaseFromHalf = phase - halfPeriod
            buffer[i] = amplitude * (float64(1.0) - float64(2.0) * phaseFromHalf / halfPeriod)

# ──────────────────────────────────────
# Biquad filter (bilinear transform, Q16.16 fixed-point coefficients)
# ──────────────────────────────────────

fn WebAudioBiquadComputeCoefficients(type: int32, frequency: float64, Q: float64, sampleRate: int32, b0: var int32, b1: var int32, b2: var int32, a1: var int32, a2: var int32): bool =
    if type < 0 || type > 2:
        return false
    if frequency <= float64(0.0) || Q <= float64(0.0) || sampleRate <= 0:
        return false
    let pi = float64(3.141592653589793)
    let omega = float64(2.0) * pi * frequency / float64(sampleRate)
    # Taylor-series sin(omega): x - x^3/6 + x^5/120 - x^7/5040
    let x = omega
    let x2 = x * x
    let x3 = x2 * x
    let x5 = x3 * x2
    let x7 = x5 * x2
    let sinOmega = x - x3 / float64(6.0) + x5 / float64(120.0) - x7 / float64(5040.0)
    # Taylor-series cos(omega): 1 - x^2/2 + x^4/24 - x^6/720 + x^8/40320
    let x4 = x2 * x2
    let x6 = x3 * x3
    let x8 = x4 * x4
    let cosOmega = float64(1.0) - x2 / float64(2.0) + x4 / float64(24.0) - x6 / float64(720.0) + x8 / float64(40320.0)
    let alpha = sinOmega / (float64(2.0) * Q)
    var fb0: float64
    var fb1: float64
    var fb2: float64
    let fa1 = float64(-2.0) * cosOmega
    let fa2 = float64(1.0) - alpha
    let a0 = float64(1.0) + alpha
    if type == 0:  # Lowpass
        fb0 = (float64(1.0) - cosOmega) / float64(2.0)
        fb1 = float64(1.0) - cosOmega
        fb2 = fb0
    elif type == 1:  # Highpass
        fb0 = (float64(1.0) + cosOmega) / float64(2.0)
        fb1 = float64(0.0) - (float64(1.0) + cosOmega)
        fb2 = fb0
    else:  # type == 2, Bandpass
        fb0 = alpha
        fb1 = float64(0.0)
        fb2 = float64(0.0) - alpha
    # Normalize by a0
    fb0 = fb0 / a0
    fb1 = fb1 / a0
    fb2 = fb2 / a0
    let na1 = fa1 / a0
    let na2 = fa2 / a0
    # Convert to Q16 (multiply by 2^16, round to int32)
    let scale = float64(65536.0)
    b0 = int32(fb0 * scale)
    b1 = int32(fb1 * scale)
    b2 = int32(fb2 * scale)
    a1 = int32(na1 * scale)
    a2 = int32(na2 * scale)
    return true

fn WebAudioBiquadProcess(input: float64, b0: int32, b1: int32, b2: int32, a1: int32, a2: int32, x1: var int32, x2: var int32, y1: var int32, y2: var int32): int32 =
    let scale = float64(65536.0)
    let x0 = int32(input * scale)
    # Direct Form 1: y = (b0*x0 + b1*x1 + b2*x2 - a1*y1 - a2*y2) / 2^16
    let sum: int64 = int64(b0) * int64(x0) + int64(b1) * int64(x1) + int64(b2) * int64(x2) - int64(a1) * int64(y1) - int64(a2) * int64(y2)
    let y = int32(sum / int64(65536))
    # Update state
    x2 = x1
    x1 = x0
    y2 = y1
    y1 = y
    return y

# ──────────────────────────────────────
# AudioBuffer resampling (linear interpolation)
# ──────────────────────────────────────

fn WebAudioResampleBuffer(src: float64[], srcRate: int32, dstRate: int32, out: var float64[]): bool =
    if src.len <= 0 || srcRate <= 0 || dstRate <= 0:
        out = []
        return false
    if srcRate == dstRate:
        # Direct copy
        var result: float64[]
        setLen(result, src.len)
        for i in 0..<src.len:
            result[i] = src[i]
        out = result
        return true
    let ratio = float64(srcRate) / float64(dstRate)
    let dstLen = int32(float64(src.len - 1) / ratio) + 1
    if dstLen <= 0:
        out = []
        return false
    var result: float64[]
    setLen(result, dstLen)
    for i in 0..<dstLen:
        let srcPos = ratio * float64(i)
        let idx = int32(srcPos)
        let frac = srcPos - float64(idx)
        let nextIdx = (idx + 1 < src.len) ? idx + 1 : idx
        result[i] = src[idx] + frac * (src[nextIdx] - src[idx])
    out = result
    return true

# ──────────────────────────────────────
# AudioContext time / block processing
# ──────────────────────────────────────

fn WebAudioContextAdvanceTime(contextId: int32, deltaMs: int32): bool =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return false
    var ctx = audioContexts[ctxIndex]
    if ctx.state != "running":
        return false
    ctx.currentTime = ctx.currentTime + float64(deltaMs) / float64(1000.0)
    audioContexts[ctxIndex] = ctx
    return true

fn WebAudioContextProcessBlock(contextId: int32, blockSize: int32): bool =
    let ctxIndex = WebAudioContextFindIndex(contextId)
    if ctxIndex < 0:
        return false
    if blockSize <= 0:
        return false
    var ctx = audioContexts[ctxIndex]
    if ctx.state != "running":
        return false
    # Collect all nodes belonging to this context
    var ctxNodeIds: int32[]
    for ni in 0..<nodeTable.len:
        if nodeTable[ni].contextId == contextId:
            add(ctxNodeIds, nodeTable[ni].nodeId)
    let numNodes = ctxNodeIds.len
    if numNodes <= 0:
        return false
    # Find destination node index within ctxNodeIds
    var destNodeId: int32 = ctx.destination
    var destIdx: int32 = -1
    for i in 0..<numNodes:
        if ctxNodeIds[i] == destNodeId:
            destIdx = i
            break
    if destIdx < 0:
        return false
    # Flat buffer: flatBuf[nodeIdx * blockSize + sample]
    var flatBuf: float64[]
    setLen(flatBuf, numNodes * blockSize)
    for i in 0..<(numNodes * blockSize):
        flatBuf[i] = float64(0.0)
    # Process all nodes in order
    for ni in 0..<numNodes:
        let nodeId = ctxNodeIds[ni]
        let nodeIndex = WebAudioNodeFindIndex(nodeId)
        if nodeIndex < 0:
            continue
        var node = nodeTable[nodeIndex]
        var bufOff = ni * blockSize
        if node.kind == WebAudioNodeOscillator:
            # Get waveform type and frequency
            var waveformType: int32
            var freq: float64 = float64(440.0)
            var amp: float64 = float64(0.5)
            for pi in 0..<node.params.len:
                if node.params[pi].name == "type":
                    waveformType = int32(node.params[pi].value)
                elif node.params[pi].name == "frequency":
                    freq = node.params[pi].value
            # Copy region to temp buffer for the generate functions (require var float64[])
            var temp: float64[]
            setLen(temp, blockSize)
            for si in 0..<blockSize:
                temp[si] = flatBuf[bufOff + si]
            if waveformType == WebAudioOscillatorSine:
                WebAudioGenerateSine(temp, freq, ctx.sampleRate, amp)
            elif waveformType == WebAudioOscillatorSquare:
                WebAudioGenerateSquare(temp, freq, ctx.sampleRate, amp)
            elif waveformType == WebAudioOscillatorSawtooth:
                WebAudioGenerateSawtooth(temp, freq, ctx.sampleRate, amp)
            else:
                WebAudioGenerateTriangle(temp, freq, ctx.sampleRate, amp)
            for si in 0..<blockSize:
                flatBuf[bufOff + si] = temp[si]
        elif node.kind == WebAudioNodeBufferSource:
            var bufferId: int32 = -1
            for pi in 0..<node.params.len:
                if node.params[pi].name == "bufferId":
                    bufferId = int32(node.params[pi].value)
            if bufferId > 0:
                let bufIndex = WebAudioBufferFindIndex(bufferId)
                if bufIndex >= 0:
                    var srcBuf = audioBuffers[bufIndex]
                    var totalSamples = srcBuf.numberOfChannels * srcBuf.length
                    var sampleBuf: float64[]
                    setLen(sampleBuf, totalSamples)
                    for si in 0..<totalSamples:
                        sampleBuf[si] = srcBuf.data[si]
                    var resampled: float64[]
                    if srcBuf.sampleRate != ctx.sampleRate:
                        WebAudioResampleBuffer(sampleBuf, srcBuf.sampleRate, ctx.sampleRate, resampled)
                    else:
                        resampled = sampleBuf
                    var copyLen = (resampled.len < blockSize) ? resampled.len : blockSize
                    for si in 0..<copyLen:
                        flatBuf[bufOff + si] = resampled[si]
        # Route output to downstream nodes
        for oi in 0..<node.outputs.len:
            let destId = node.outputs[oi]
            var dIdx: int32 = -1
            for di in 0..<numNodes:
                if ctxNodeIds[di] == destId:
                    dIdx = di
                    break
            if dIdx < 0:
                continue
            var destNodeIndex = WebAudioNodeFindIndex(destId)
            if destNodeIndex < 0:
                continue
            var destNode = nodeTable[destNodeIndex]
            var gain: float64 = float64(1.0)
            if destNode.kind == WebAudioNodeGain:
                for pi in 0..<destNode.params.len:
                    if destNode.params[pi].name == "gain":
                        gain = destNode.params[pi].value
                        break
            var fB0: int32
            var fB1: int32
            var fB2: int32
            var fA1: int32
            var fA2: int32
            var filterActive: bool
            if destNode.kind == WebAudioNodeBiquadFilter:
                var filterType: int32
                var filterFreq: float64 = float64(1000.0)
                var filterQ: float64 = float64(0.707)
                for pi in 0..<destNode.params.len:
                    if destNode.params[pi].name == "type":
                        filterType = int32(destNode.params[pi].value)
                    elif destNode.params[pi].name == "frequency":
                        filterFreq = destNode.params[pi].value
                    elif destNode.params[pi].name == "Q":
                        filterQ = destNode.params[pi].value
                filterActive = WebAudioBiquadComputeCoefficients(filterType, filterFreq, filterQ, ctx.sampleRate, fB0, fB1, fB2, fA1, fA2)
            var destOff = dIdx * blockSize
            var x1: int32
            var x2: int32
            var y1: int32
            var y2: int32
            for si in 0..<blockSize:
                var sample = flatBuf[bufOff + si] * gain
                if filterActive:
                    let processed = WebAudioBiquadProcess(sample, fB0, fB1, fB2, fA1, fA2, x1, x2, y1, y2)
                    let scale = float64(65536.0)
                    sample = float64(processed) / scale
                flatBuf[destOff + si] = flatBuf[destOff + si] + sample
        # Clear source buffer after all outputs are routed
        for si in 0..<blockSize:
            flatBuf[bufOff + si] = float64(0.0)
    # Update context currentTime by block duration
    let blockDuration = float64(blockSize) / float64(ctx.sampleRate)
    ctx.currentTime = ctx.currentTime + blockDuration
    audioContexts[ctxIndex] = ctx
    return true

# ──────────────────────────────────────
# Noise generation (LCG pseudo-random)
# ──────────────────────────────────────

fn WebAudioGenerateNoise(buffer: var float64[], amplitude: float64) =
    var state: int64 = 12345
    let a = int64(1103515245)
    let c = int64(12345)
    let m = int64(2147483648)  # 2^31
    for i in 0..<buffer.len:
        state = (a * state + c) % m
        let normalized = float64(state) / float64(m)
        buffer[i] = amplitude * (float64(2.0) * normalized - float64(1.0))
