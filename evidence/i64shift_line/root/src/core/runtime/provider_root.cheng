import std/os
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/root_discovery as rootdisco

@borrows
fn RuntimeProviderRoot(rootDirRaw: str): str =
    let envRoot = strutil.Strip(os.GetEnv("CHENG_ROOT"))
    if Len(envRoot) > 0:
        return envRoot
    let discoveredRoot = strutil.Strip(rootdisco.CompilerRootAuto())
    if Len(discoveredRoot) > 0:
        let seedPath = chengpath.PathAbsolute(discoveredRoot, "bootstrap/stage1_bootstrap.cheng")
        let packageManifestPath = chengpath.PathAbsolute(discoveredRoot, "cheng-package.toml")
        if chengpath.PathFileExists(seedPath) || chengpath.PathFileExists(packageManifestPath):
            return discoveredRoot
    return strings.CloneStr(strutil.Strip(rootDirRaw))

@borrows
fn RuntimeProviderPath(rootDirRaw: str, relRaw: str): str =
    let rel = strings.CloneStr(strutil.Strip(relRaw))
    if Len(rel) <= 0:
        return strings.CloneStr("")
    let rootDir = RuntimeProviderRoot(rootDirRaw)
    if Len(rootDir) <= 0:
        return rel
    return chengpath.PathAbsolute(rootDir, rel)
