fn WebComputedStyleFontWeightInt(style: var WebComputedStyle, out: var int32): bool =
    if !style.hasFontWeight:
        out = 400
        return false
    if WebCssSpanEqualsText(style.fontWeightSource, style.fontWeightStart, style.fontWeightStop, "normal"):
        out = 400
        return true
    if WebCssSpanEqualsText(style.fontWeightSource, style.fontWeightStart, style.fontWeightStop, "bold"):
        out = 700
        return true
    return WebCssParseIntValue(style.fontWeightSource, style.fontWeightStart, style.fontWeightStop, out)

@borrows
fn WebCssSpanContainsText(source: str, start: int32, stop: int32, needle: str): bool =
    if start < 0 || start > stop || needle.len <= 0:
        return false
    let needleLen = needle.len
    var i: int32
    i = start
    while i + needleLen - 1 <= stop:
        if strings.SliceBytes(source, i, needleLen) == needle:
            return true
        i = i + 1
    return false

fn WebComputedStyleFontFamilyIsMonospace(style: var WebComputedStyle): bool =
    if !style.hasFontFamily:
        return false
    if WebCssSpanContainsText(style.fontFamilySource, style.fontFamilyStart, style.fontFamilyStop, "ui-monospace"):
        return true
    return WebCssSpanContainsText(style.fontFamilySource, style.fontFamilyStart, style.fontFamilyStop, "monospace")

@borrows
fn WebComputedStyleFontFamilyContainsIcon(style: var WebComputedStyle): bool =
    if !style.hasFontFamily:
        return false
    if WebCssSpanContainsText(style.fontFamilySource, style.fontFamilyStart, style.fontFamilyStop, "Material Icons"):
        return true
    return WebCssSpanContainsText(style.fontFamilySource, style.fontFamilyStart, style.fontFamilyStop, "material icons")

@borrows
fn WebCssSpanValue(source: str, start: int32, stop: int32, out: var str): bool =
    if start < 0 || start > stop:
        out = ""
        return false
    out = strings.SliceBytes(source, start, stop - start + 1)
    return true

