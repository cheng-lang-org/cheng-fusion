fn WebComputedStyleApplyInlineDeclaration(style: var WebComputedStyle, name: str, value: str, sourceOrder: int32): bool =
    if value.len <= 0:
        return true
    let property = WebCssPropertyNameKind(name)
    if property == 0:
        return false
    var declaration: WebCssDeclaration
    declaration.property = property
    declaration.valueSource = value
    declaration.valueStart = 0
    declaration.valueStop = value.len - 1
    declaration.specificity = 1000
    declaration.sourceOrder = sourceOrder
    WebComputedStyleApplyDeclaration(style, declaration)
    return true

fn WebStyleSheetComputeStyle(document: var web.WebDocument,
                             sheet: var WebStyleSheet,
                             nodeId: int32,
                             style: var WebComputedStyle): bool =
    if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
        WebComputedStyleInit(style)
        return false
    WebComputedStyleInit(style)
    // Collect all declarations from matching rules
    var allDeclarations: WebCssDeclaration[]
    var ruleIndex: int32
    let ruleCount = sheet.rules.len
    while ruleIndex < ruleCount:
        if WebCssRuleMatches(document, sheet.rules[ruleIndex], nodeId):
            var declarationIndex: int32
            let declarationCount = sheet.rules[ruleIndex].declarations.len
            while declarationIndex < declarationCount:
                var declaration = sheet.rules[ruleIndex].declarations[declarationIndex]
                add(allDeclarations, declaration)
                declarationIndex = declarationIndex + 1
        ruleIndex = ruleIndex + 1
    // Collect inline style declarations with a=1 specificity (1000000)
    let inlineCount = web.WebDocumentInlineStyleCount(document, nodeId)
    for i in 0..<inlineCount:
        var inlineName: str
        var inlineValue: str
        if !web.WebDocumentInlineStyleNameAt(document, nodeId, i, inlineName):
            return false
        if !web.WebDocumentInlineStyleValueAt(document, nodeId, i, inlineValue):
            return false
        let property = WebCssPropertyNameKind(inlineName)
        if property == 0:
            continue
        var inlineDecl: WebCssDeclaration
        inlineDecl.property = property
        inlineDecl.valueStart = 0
        inlineDecl.valueStop = inlineValue.len - 1
        inlineDecl.valueSource = inlineValue
        inlineDecl.specificity = 1000000  // a=1 for inline style
        inlineDecl.sourceOrder = 1000000 + i
        add(allDeclarations, inlineDecl)
    // Cascade: sort all declarations by specificity (desc), sourceOrder (desc), then apply
    WebCssCascadeMerge(allDeclarations, style)
    let parentNodeId = web.WebDocumentNodeParent(document, nodeId)
    if parentNodeId != 0 && web.WebDocumentNodeKind(document, parentNodeId) == web.WebNodeKindElement:
        var parentStyle: WebComputedStyle
        if WebStyleSheetComputeStyle(document, sheet, parentNodeId, parentStyle):
            WebComputedStyleInherit(style, parentStyle)
    return true

fn WebComputedStyleColorEquals(style: var WebComputedStyle, value: str): bool =
    if !style.hasColor:
        return false
    return WebCssSpanEqualsText(style.colorSource, style.colorStart, style.colorStop, value)

