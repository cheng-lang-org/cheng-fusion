            style.transitionDurationSource = strings.CloneStr(declaration.valueSource)
            style.transitionDurationStart = declaration.valueStart
            style.transitionDurationStop = declaration.valueStop
            style.hasTransitionDuration = true
            style.transitionDurationSpecificity = declaration.specificity
            style.transitionDurationOrder = declaration.sourceOrder
    elif declaration.property == WebCssPropertyTransitionTiming:
        if WebCssDeclarationWins(style.transitionTimingSpecificity,
                                 style.transitionTimingOrder,
                                 declaration.specificity,
                                 declaration.sourceOrder):
            style.transitionTimingSource = strings.CloneStr(declaration.valueSource)
            style.transitionTimingStart = declaration.valueStart
