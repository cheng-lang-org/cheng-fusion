fn WebStyleSheetRuleCount(sheet: var WebStyleSheet): int32 =
    return sheet.rules.len

fn WebStyleSheetRuleSelectorEquals(sheet: var WebStyleSheet, ruleIndex: int32, value: str): bool =
    if ruleIndex < 0 || ruleIndex >= sheet.rules.len:
        return false
    let rule = sheet.rules[ruleIndex]
    let selectorSource: str = rule.selectorSource
    let selectorStart: int32 = rule.selectorStart
    let selectorStop: int32 = rule.selectorStop
    return WebCssSpanEqualsText(selectorSource, selectorStart, selectorStop, value)

fn WebStyleSheetRuleSelectorKindAt(sheet: var WebStyleSheet, ruleIndex: int32): int32 =
    if ruleIndex < 0 || ruleIndex >= sheet.rules.len:
        return 0
    let rule = sheet.rules[ruleIndex]
    return rule.selectorKind

fn WebStyleSheetRuleMatches(document: var web.WebDocument,
                            sheet: var WebStyleSheet,
                            ruleIndex: int32,
                            nodeId: int32): bool =
    if ruleIndex < 0 || ruleIndex >= sheet.rules.len:
        return false
    let rule = sheet.rules[ruleIndex]
    return WebCssRuleMatches(document, rule, nodeId)

fn WebComputedStyleInherit(style: var WebComputedStyle, parent: WebComputedStyle) =
    if !style.hasColor && parent.hasColor:
        style.colorSource = parent.colorSource
        style.colorStart = parent.colorStart
        style.colorStop = parent.colorStop
        style.hasColor = true
        style.colorSpecificity = parent.colorSpecificity
        style.colorOrder = parent.colorOrder
    if !style.hasFontSize && parent.hasFontSize:
        style.fontSizeSource = parent.fontSizeSource
        style.fontSizeStart = parent.fontSizeStart
        style.fontSizeStop = parent.fontSizeStop
        style.hasFontSize = true
        style.fontSizeSpecificity = parent.fontSizeSpecificity
        style.fontSizeOrder = parent.fontSizeOrder
    if !style.hasLineHeight && parent.hasLineHeight:
        style.lineHeightSource = parent.lineHeightSource
        style.lineHeightStart = parent.lineHeightStart
        style.lineHeightStop = parent.lineHeightStop
        style.hasLineHeight = true
        style.lineHeightSpecificity = parent.lineHeightSpecificity
        style.lineHeightOrder = parent.lineHeightOrder
    if !style.hasFontWeight && parent.hasFontWeight:
        style.fontWeightSource = parent.fontWeightSource
        style.fontWeightStart = parent.fontWeightStart
        style.fontWeightStop = parent.fontWeightStop
        style.hasFontWeight = true
        style.fontWeightSpecificity = parent.fontWeightSpecificity
        style.fontWeightOrder = parent.fontWeightOrder
    if !style.hasFontFamily && parent.hasFontFamily:
        style.fontFamilySource = parent.fontFamilySource
        style.fontFamilyStart = parent.fontFamilyStart
        style.fontFamilyStop = parent.fontFamilyStop
        style.hasFontFamily = true
        style.fontFamilySpecificity = parent.fontFamilySpecificity
        style.fontFamilyOrder = parent.fontFamilyOrder
    if !style.hasTextAlign && parent.hasTextAlign:
        style.textAlignSource = parent.textAlignSource
        style.textAlignStart = parent.textAlignStart
        style.textAlignStop = parent.textAlignStop
        style.hasTextAlign = true
        style.textAlignSpecificity = parent.textAlignSpecificity
        style.textAlignOrder = parent.textAlignOrder
    if !style.hasWhiteSpace && parent.hasWhiteSpace:
        style.whiteSpaceSource = parent.whiteSpaceSource
        style.whiteSpaceStart = parent.whiteSpaceStart
        style.whiteSpaceStop = parent.whiteSpaceStop
        style.hasWhiteSpace = true
        style.whiteSpaceSpecificity = parent.whiteSpaceSpecificity
        style.whiteSpaceOrder = parent.whiteSpaceOrder
    if !style.hasWordBreak && parent.hasWordBreak:
        style.wordBreakSource = parent.wordBreakSource
        style.wordBreakStart = parent.wordBreakStart
        style.wordBreakStop = parent.wordBreakStop
        style.hasWordBreak = true
        style.wordBreakSpecificity = parent.wordBreakSpecificity
        style.wordBreakOrder = parent.wordBreakOrder

fn WebCssIsIdentStart(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch == '_':
        return true
    return false

fn WebCssIsIdentChar(ch: char): bool =
    if WebCssIsIdentStart(ch):
        return true
    if ch >= '0' && ch <= '9':
        return true
    if ch == '-':
        return true
    return false

fn WebCssIsQuote(ch: char): bool =
    if int32(ch) == 34:
        return true
    if int32(ch) == 39:
        return true
    return false

@borrows
fn WebCssClassValueContains(attrValue: str, selSource: str, selStart: int32, selStop: int32): bool =
    let nameLen = selStop - selStart + 1
    var start: int32
    var i: int32
    while i <= attrValue.len:
        let atEnd = i == attrValue.len
        var split = atEnd
        if !split:
            let ch = attrValue[i]
            split = WebCssIsWhitespace(ch)
        if split:
            if i > start:
                let count = i - start
                if count == nameLen:
                    var same = true
                    for k in 0..<count:
                        if attrValue[start + k] != selSource[selStart + k]:
                            same = false
                            break
                    if same:
                        return true
            start = i + 1
        i = i + 1
    return false

fn WebCssNodeMatchesSelectorSpan(document: var web.WebDocument,
                                   nodeId: int32,
                                   selector: str,
                                   selStart: int32,
                                   selStop: int32): bool =
    return WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, selStart, selStop)

fn WebCssNodeMatchesSimpleSelectorSpan(document: var web.WebDocument,
                                       nodeId: int32,
                                       selector: str,
                                       selStart: int32,
                                       selStop: int32): bool =
    if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
        return false
    if selStart > selStop:
        return false
    let ch = selector[selStart]
    if ch == '#':
        var attrVal: str
        if !web.WebDocumentGetAttribute(document, nodeId, "id", attrVal):
            return false
        return WebCssSpanEqualsText(selector, selStart + 1, selStop, attrVal)
    if ch == '.':
        var classVal: str
        if !web.WebDocumentGetAttribute(document, nodeId, "class", classVal):
            return false
        return WebCssClassValueContains(classVal, selector, selStart + 1, selStop)
    if ch == ':':
        if WebCssSpanEqualsText(selector, selStart + 1, selStop, "first-child"):
            let parentId = web.WebDocumentNodeParent(document, nodeId)
            if parentId == 0:
                return false
            if web.WebDocumentNodeFirstChild(document, parentId) == nodeId:
                return true
            return false
        if WebCssSpanEqualsText(selector, selStart + 1, selStop, "last-child"):
            let parentId = web.WebDocumentNodeParent(document, nodeId)
            if parentId == 0:
                return false
            if web.WebDocumentNodeLastChild(document, parentId) == nodeId:
                return true
            return false
        return true
    var tagVal: str
    if !web.WebDocumentNodeTagName(document, nodeId, tagVal):
        return false
    return WebCssSpanEqualsText(selector, selStart, selStop, tagVal)

fn WebDocumentQuerySelector(document: var web.WebDocument, selector: str): int32 =
    // Find whitespace separator for descendant combinator
    var spacePos: int32 = -1
    var i: int32
    while i < selector.len:
        if WebCssIsWhitespace(selector[i]):
            spacePos = i
            break
        i = i + 1

    if spacePos < 0:
        // Simple selector - scan all elements
        let nodeCount = web.WebDocumentNodeCount(document)
        for ni in 0..<nodeCount:
            let nodeId = web.WebDocumentNodeIdAt(document, ni)
            if web.WebDocumentNodeKind(document, nodeId) == web.WebNodeKindElement:
                if WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, 0, selector.len - 1):
                    return nodeId
        return 0

    // Descendant combinator: ancestor selector is before first whitespace
    let ancStart = 0
    let ancStop = spacePos - 1
    var descStart = spacePos + 1
    while descStart < selector.len:
        if !WebCssIsWhitespace(selector[descStart]):
            break
        descStart = descStart + 1
    if descStart >= selector.len:
        return 0
    let descStop = selector.len - 1

    // Collect ancestor-matching node IDs
    var ancestors: int32[]
    let nodeCount = web.WebDocumentNodeCount(document)
    for ni in 0..<nodeCount:
        let nodeId = web.WebDocumentNodeIdAt(document, ni)
        if web.WebDocumentNodeKind(document, nodeId) == web.WebNodeKindElement:
            if WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, ancStart, ancStop):
                add(ancestors, nodeId)

    // Find first descendant-matching node that has an ancestor in the list
    for ni in 0..<nodeCount:
        let nodeId = web.WebDocumentNodeIdAt(document, ni)
        if web.WebDocumentNodeKind(document, nodeId) == web.WebNodeKindElement:
            if !WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, descStart, descStop):
                continue
            for ai in 0..<ancestors.len:
                if web.WebDocumentIsAncestorOf(document, ancestors[ai], nodeId):
                    return nodeId

    return 0

fn WebDocumentQuerySelectorAll(document: var web.WebDocument, selector: str, result: var int32[]): int32 =
    result = []
    var spacePos: int32 = -1
    var i: int32
    while i < selector.len:
        if WebCssIsWhitespace(selector[i]):
            spacePos = i
            break
        i = i + 1

    if spacePos < 0:
        let nodeCount = web.WebDocumentNodeCount(document)
        for ni in 0..<nodeCount:
            let nodeId = web.WebDocumentNodeIdAt(document, ni)
            if web.WebDocumentNodeKind(document, nodeId) == web.WebNodeKindElement:
                if WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, 0, selector.len - 1):
                    add(result, nodeId)
        return result.len

    // Descendant combinator
    let ancStart = 0
    let ancStop = spacePos - 1
    var descStart = spacePos + 1
    while descStart < selector.len:
        if !WebCssIsWhitespace(selector[descStart]):
            break
        descStart = descStart + 1
    if descStart >= selector.len:
        return 0
    let descStop = selector.len - 1

    var ancestors: int32[]
    let nodeCount = web.WebDocumentNodeCount(document)
    for ni in 0..<nodeCount:
        let nodeId = web.WebDocumentNodeIdAt(document, ni)
        if web.WebDocumentNodeKind(document, nodeId) == web.WebNodeKindElement:
            if WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, ancStart, ancStop):
                add(ancestors, nodeId)

    for ni in 0..<nodeCount:
        let nodeId = web.WebDocumentNodeIdAt(document, ni)
        if web.WebDocumentNodeKind(document, nodeId) == web.WebNodeKindElement:
            if !WebCssNodeMatchesSimpleSelectorSpan(document, nodeId, selector, descStart, descStop):
                continue
            for ai in 0..<ancestors.len:
                if web.WebDocumentIsAncestorOf(document, ancestors[ai], nodeId):
                    add(result, nodeId)
                    break

    return result.len

// === Stage 1: CSS Specificity + Cascade ==
type
    WebCssSpecificity =
        specA: int32
        specB: int32
        specC: int32

    WebCssProperty =
        kind: int32
        value: str

    WebCssCascadeRule =
        selector: str
        specificity: WebCssSpecificity
        properties: WebCssProperty[]
        sourceOrder: int32
        source: str
        important: bool

@borrows
fn WebCssSelectorSpecificityParse(source: str, start: int32, stop: int32, out: var WebCssSpecificity): bool =
    out.specA = 0
    out.specB = 0
    out.specC = 0
    if start < 0 || stop < start:
        return true
    let ch = source[start]
    if ch == '#':
        out.specA = 1
    elif ch == '.' || ch == ':' || ch == '[':
        out.specB = 1
    else:
        out.specC = 1
    return true

fn WebCssSpecificityCompare(a: WebCssSpecificity, b: WebCssSpecificity): int32 =
    if a.specA != b.specA:
        if a.specA > b.specA:
            return 1
        return -1
    if a.specB != b.specB:
        if a.specB > b.specB:
            return 1
        return -1
    if a.specC != b.specC:
        if a.specC > b.specC:
            return 1
        return -1
    return 0

fn WebCssSpecificityPack(spec: WebCssSpecificity): int32 =
    return spec.specA * 1000000 + spec.specB * 1000 + spec.specC

fn WebCssCascadePriority(sheet: var WebStyleSheet, ruleIndex: int32, declarationIndex: int32): int32 =
    if ruleIndex < 0 || ruleIndex >= sheet.rules.len:
        return -1
    let rule = sheet.rules[ruleIndex]
    let n = rule.declarations.len
    if declarationIndex < 0 || declarationIndex >= n:
        return -1
    let decl = rule.declarations[declarationIndex]
    return decl.specificity * 100000 + rule.sourceOrder

fn WebCssMatchRules(document: var web.WebDocument, sheet: var WebStyleSheet, nodeId: int32, matched: var WebCssCascadeRule[]): bool =
    matched = []
    var i: int32
    let n = sheet.rules.len
    while i < n:
        let rule = sheet.rules[i]
        if WebCssRuleMatches(document, rule, nodeId):
            var cr: WebCssCascadeRule
            cr.selector = WebCssSpanToString(rule.selectorSource, rule.selectorStart, rule.selectorStop)
            let sp = rule.specificity
            cr.specificity.specA = sp / 1000000
            cr.specificity.specB = (sp / 1000) % 1000
            cr.specificity.specC = sp % 1000
            cr.properties = []
            var j: int32
            let dn = rule.declarations.len
            while j < dn:
                var cp: WebCssProperty
                cp.kind = rule.declarations[j].property
                cp.value = WebCssSpanToString(rule.declarations[j].valueSource, rule.declarations[j].valueStart, rule.declarations[j].valueStop)
                add(cr.properties, cp)
                j = j + 1
            cr.sourceOrder = rule.sourceOrder
            cr.source = rule.selectorSource
            cr.important = false
            add(matched, cr)
        i = i + 1
    return true

fn WebCssResolveCascade(document: var web.WebDocument, sheet: var WebStyleSheet, nodeId: int32, style: var WebComputedStyle): bool =
    WebComputedStyleInit(style)
    var matched: WebCssCascadeRule[]
    if !WebCssMatchRules(document, sheet, nodeId, matched):
        return false
    var allDeclarations: WebCssDeclaration[]
    var i: int32
    let n = matched.len
    while i < n:
        let cr = matched[i]
        var j: int32
        let pn = cr.properties.len
        while j < pn:
            var decl: WebCssDeclaration
            decl.property = cr.properties[j].kind
            decl.valueSource = cr.properties[j].value
            decl.valueStart = 0
            decl.valueStop = cr.properties[j].value.len - 1
            decl.specificity = WebCssSpecificityPack(cr.specificity)
            decl.sourceOrder = cr.sourceOrder
            add(allDeclarations, decl)
            j = j + 1
        i = i + 1
    let inlineCount = web.WebDocumentInlineStyleCount(document, nodeId)
    var ki: int32
    while ki < inlineCount:
        var inlineName: str
        var inlineValue: str
        if !web.WebDocumentInlineStyleNameAt(document, nodeId, ki, inlineName):
            ki = ki + 1
            continue
        if !web.WebDocumentInlineStyleValueAt(document, nodeId, ki, inlineValue):
            ki = ki + 1
            continue
        let property = WebCssPropertyNameKind(inlineName)
        if property == 0:
            ki = ki + 1
            continue
        var inlineDecl: WebCssDeclaration
        inlineDecl.property = property
        inlineDecl.valueStart = 0
        inlineDecl.valueStop = inlineValue.len - 1
        inlineDecl.valueSource = inlineValue
        inlineDecl.specificity = 1000000
        inlineDecl.sourceOrder = 1000000 + ki
        add(allDeclarations, inlineDecl)
        ki = ki + 1
    WebCssCascadeMerge(allDeclarations, style)
    return true

