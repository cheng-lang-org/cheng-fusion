fn WebComputedStyleWhiteSpaceEquals(style: var WebComputedStyle, value: str): bool =
    if !style.hasWhiteSpace:
        return false
    return WebCssSpanEqualsText(style.whiteSpaceSource, style.whiteSpaceStart, style.whiteSpaceStop, value)

fn WebComputedStyleWordBreakEquals(style: var WebComputedStyle, value: str): bool =
    if !style.hasWordBreak:
        return false
    return WebCssSpanEqualsText(style.wordBreakSource, style.wordBreakStart, style.wordBreakStop, value)

// === Stage 5: CSS Gradients and Shadows ===
type
    WebCssGradientStop =
        color: str
        position: str
        colorStart: int32
        colorStop: int32
        positionStart: int32
        positionStop: int32

@borrows
fn WebCssParseLinearGradient(source: str, start: int32, stop: int32,
                             outStops: var WebCssGradientStop[],
                             outAngle: var str): bool =
    outAngle = ""
    var p = start
    // Skip "linear-gradient("
    let kw = "linear-gradient("
    for i in 0..<kw.len:
        if p > stop || source[p] != kw[i]:
            return false
        p = p + 1
    // Skip whitespace
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    // Try to parse angle to first comma
    var angleStart = p
    var foundComma: bool
    var cp = p
    while cp <= stop:
        if source[cp] == ',':
            foundComma = true
            break
        if source[cp] == ')':
            break
        cp = cp + 1
    if foundComma:
        // Check if before comma looks like an angle (ends with "deg" or is "to ...")
        let angleEnd = cp - 1
        var ae = angleEnd
        while ae >= angleStart && (source[ae] == ' ' || source[ae] == '\t'):
            ae = ae - 1
        if ae >= angleStart:
            var isAngle = false
            if ae >= angleStart + 2:
                if source[ae] == 'g' && source[ae - 1] == 'e' && source[ae - 2] == 'd':
                    isAngle = true
            if ae >= angleStart + 1:
                if source[angleStart] == 't' && source[angleStart + 1] == 'o':
                    isAngle = true
            if isAngle:
                outAngle = ""
                for ai in angleStart..ae:
                    outAngle = outAngle + source[ai]
                p = cp + 1
    // Parse color stops
    while p <= stop:
        // Skip whitespace
        while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
            p = p + 1
        if p > stop || source[p] == ')':
            break
        var stopStart = p
        while p <= stop && source[p] != ',' && source[p] != ')':
            p = p + 1
        var stopEnd = p - 1
        // Trim trailing whitespace from stop
        while stopEnd >= stopStart && (source[stopEnd] == ' ' || source[stopEnd] == '\n' || source[stopEnd] == '\t'):
            stopEnd = stopEnd - 1
        if stopEnd >= stopStart:
            // Split into color and optional position
            var colorEnd = stopEnd
            var posFound = false
            var posStart: int32 = -1
            var posEnd: int32 = -1
            // Search for percentage
            var si = stopStart
            while si <= stopEnd:
                if source[si] == '%':
                    posFound = true
                    posEnd = si
                    break
                si = si + 1
            if posFound:
                // Find start of position number
                var pn = posEnd - 1
                while pn >= stopStart && source[pn] >= '0' && source[pn] <= '9':
                    pn = pn - 1
                posStart = pn + 1
                // Also skip decimal point and digits after
                pn = pn - 1
                while pn >= stopStart && ((source[pn] >= '0' && source[pn] <= '9') || source[pn] == '.'):
                    pn = pn - 1
                posStart = pn + 1
                colorEnd = posStart - 1
                while colorEnd >= stopStart && (source[colorEnd] == ' ' || source[colorEnd] == '\n' || source[colorEnd] == '\t'):
                    colorEnd = colorEnd - 1
            var stopItem: WebCssGradientStop
            stopItem.color = ""
            for ci in stopStart..colorEnd:
                stopItem.color = stopItem.color + source[ci]
            stopItem.colorStart = stopStart
            stopItem.colorStop = colorEnd
            if posFound:
                stopItem.position = ""
                for pi in posStart..posEnd:
                    stopItem.position = stopItem.position + source[pi]
                stopItem.positionStart = posStart
                stopItem.positionStop = posEnd
            else:
                stopItem.position = ""
                stopItem.positionStart = -1
                stopItem.positionStop = -1
            add(outStops, stopItem)
        if p <= stop && source[p] == ',':
            p = p + 1
    if outStops.len > 0:
        return true
    return false

@borrows
fn WebCssParseRadialGradient(source: str, start: int32, stop: int32,
                             outStops: var WebCssGradientStop[],
                             outShape: var str): bool =
    outShape = ""
    var p = start
    let kw = "radial-gradient("
    for i in 0..<kw.len:
        if p > stop || source[p] != kw[i]:
            return false
        p = p + 1
    // Skip whitespace
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    // Try to parse shape/size/position to first comma
    var foundComma: bool
    var cp = p
    while cp <= stop:
        if source[cp] == ',':
            foundComma = true
            break
        if source[cp] == ')':
            break
        cp = cp + 1
    if foundComma:
        let shapeEnd = cp - 1
        var se = shapeEnd
        while se >= p && (source[se] == ' ' || source[se] == '\n' || source[se] == '\t'):
            se = se - 1
        if se >= p:
            outShape = ""
            for si in p..se:
                outShape = outShape + source[si]
        p = cp + 1
    // Parse same color stops as linear
    while p <= stop:
        while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
            p = p + 1
        if p > stop || source[p] == ')':
            break
        var stopStart = p
        while p <= stop && source[p] != ',' && source[p] != ')':
            p = p + 1
        var stopEnd = p - 1
        while stopEnd >= stopStart && (source[stopEnd] == ' ' || source[stopEnd] == '\n' || source[stopEnd] == '\t'):
            stopEnd = stopEnd - 1
        if stopEnd >= stopStart:
            var colorEnd = stopEnd
            var posFound = false
            var posStart: int32 = -1
            var posEnd: int32 = -1
            var si = stopStart
            while si <= stopEnd:
                if source[si] == '%':
                    posFound = true
                    posEnd = si
                    break
                si = si + 1
            if posFound:
                var pn = posEnd - 1
                while pn >= stopStart && source[pn] >= '0' && source[pn] <= '9':
                    pn = pn - 1
                posStart = pn + 1
                pn = pn - 1
                while pn >= stopStart && ((source[pn] >= '0' && source[pn] <= '9') || source[pn] == '.'):
                    pn = pn - 1
                posStart = pn + 1
                colorEnd = posStart - 1
                while colorEnd >= stopStart && (source[colorEnd] == ' ' || source[colorEnd] == '\n' || source[colorEnd] == '\t'):
                    colorEnd = colorEnd - 1
            var stopItem: WebCssGradientStop
            stopItem.color = ""
            for ci in stopStart..colorEnd:
                stopItem.color = stopItem.color + source[ci]
            stopItem.colorStart = stopStart
            stopItem.colorStop = colorEnd
            if posFound:
                stopItem.position = ""
                for pi in posStart..posEnd:
                    stopItem.position = stopItem.position + source[pi]
                stopItem.positionStart = posStart
                stopItem.positionStop = posEnd
            else:
                stopItem.position = ""
                stopItem.positionStart = -1
                stopItem.positionStop = -1
            add(outStops, stopItem)
        if p <= stop && source[p] == ',':
            p = p + 1
    if outStops.len > 0:
        return true
    return false

@borrows
fn WebCssParseBoxShadow(source: str, start: int32, stop: int32,
                        outOffsetX: var str, outOffsetY: var str,
                        outBlurRadius: var str, outSpreadRadius: var str,
                        outColor: var str, outInset: var bool): bool =
    outOffsetX = ""
    outOffsetY = ""
    outBlurRadius = ""
    outSpreadRadius = ""
    outColor = ""
    outInset = false
    var p = start
    // Skip whitespace
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    if p > stop:
        return false
    // Check for "inset"
    if stop - p + 1 >= 5:
        if source[p] == 'i' && source[p + 1] == 'n' && source[p + 2] == 's' &&
           source[p + 3] == 'e' && source[p + 4] == 't':
            outInset = true
            p = p + 5
            while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
                p = p + 1
    // Parse tokens into parts
    var parts: str[]
    while p <= stop:
        if source[p] == ',':
            break
        while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
            p = p + 1
        if p > stop:
            break
        var partStart = p
        while p <= stop && source[p] != ' ' && source[p] != ',' && source[p] != '\n' && source[p] != '\t':
            p = p + 1
        var partEnd = p - 1
        if partStart <= partEnd:
            var part: str
            for pi in partStart..partEnd:
                part = part + source[pi]
            add(parts, part)
        if p <= stop && source[p] == ',':
            break
    if parts.len < 2:
        return false
    outOffsetX = parts[0]
    outOffsetY = parts[1]
    if parts.len >= 3:
        outBlurRadius = parts[2]
    if parts.len >= 4:
        outSpreadRadius = parts[3]
    if parts.len >= 5:
        outColor = parts[4]
    elif parts.len >= 3:
        outColor = parts[parts.len - 1]
    return true

@borrows
fn WebCssParseTextShadow(source: str, start: int32, stop: int32,
                         outOffsetX: var str, outOffsetY: var str,
                         outBlurRadius: var str, outColor: var str): bool =
    outOffsetX = ""
    outOffsetY = ""
    outBlurRadius = ""
    outColor = ""
    var p = start
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    if p > stop:
        return false
    var parts: str[]
    while p <= stop:
        if source[p] == ',':
            break
        while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
            p = p + 1
        if p > stop:
            break
        var partStart = p
        while p <= stop && source[p] != ' ' && source[p] != ',' && source[p] != '\n' && source[p] != '\t':
            p = p + 1
        var partEnd = p - 1
        if partStart <= partEnd:
            var part: str
            for pi in partStart..partEnd:
                part = part + source[pi]
            add(parts, part)
        if p <= stop && source[p] == ',':
            break
    if parts.len < 2:
        return false
    outOffsetX = parts[0]
    outOffsetY = parts[1]
    if parts.len >= 3:
        outBlurRadius = parts[2]
    if parts.len >= 4:
        outColor = parts[3]
    elif parts.len >= 3:
        outColor = parts[parts.len - 1]
    return true

// === Stage 6: CSS Transitions and Animations ===
const
    WebCssTimingEase = 1
    WebCssTimingEaseIn = 2
    WebCssTimingEaseOut = 3
    WebCssTimingEaseInOut = 4
    WebCssTimingLinear = 5
    WebCssTimingStepStart = 6
    WebCssTimingStepEnd = 7

type
    WebCssKeyframe =
        offset: str
        properties: WebCssProperty[]

    WebCssKeyframes =
        name: str
        keyframes: WebCssKeyframe[]

    WebCssAnimation =
        name: str
        duration: float64
        timing: str
        delay: float64
        iterationCount: float64
        direction: str
        fillMode: str
        playState: str

@borrows
fn WebCssParseTimeMs(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0 || stop < start:
        return false
    var p = start
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    if p > stop:
        return false
    var sign: int32 = 1
    if source[p] == '-':
        sign = -1
        p = p + 1
    elif source[p] == '+':
        p = p + 1
    if p > stop:
        return false
    var intPart: int32
    var fracPart: int32
    var fracDiv: int32 = 1
    var hasInt: bool
    var hasFrac: bool
    while p <= stop && source[p] >= '0' && source[p] <= '9':
        hasInt = true
        intPart = intPart * 10 + int32(source[p]) - int32('0')
        p = p + 1
    if p <= stop && source[p] == '.':
        p = p + 1
        while p <= stop && source[p] >= '0' && source[p] <= '9':
            hasFrac = true
            fracPart = fracPart * 10 + int32(source[p]) - int32('0')
            fracDiv = fracDiv * 10
            p = p + 1
    if !hasInt && !hasFrac:
        return false
    var valueMs: int32 = intPart * 1000
    if hasFrac:
        // Fractional part as milliseconds
        valueMs = valueMs + (fracPart * 1000) / fracDiv
    valueMs = valueMs * sign
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    if p > stop:
        out = valueMs
        return true
    if p == stop:
        if source[p] == 's':
            out = valueMs
            return true
        return false
    if p < stop:
        if source[p] == 'm' && source[p + 1] == 's':
            out = valueMs
            return true
        if source[p] == 's':
            out = valueMs
            return true
    return false

@borrows
fn WebCssParseTimingFunction(source: str, start: int32, stop: int32, out: var str): bool =
    out = ""
    if start < 0 || stop < start:
        return false
    var p = start
    while p <= stop && (source[p] == ' ' || source[p] == '\n' || source[p] == '\t'):
        p = p + 1
    if p > stop:
        return false
    var identStart = p
    while p <= stop && source[p] != ' ' && source[p] != '\n' && source[p] != '\t' && source[p] != ',':
        p = p + 1
    var identEnd = p - 1
    if identStart > identEnd:
        return false
    if WebCssSpanEqualsText(source, identStart, identEnd, "ease"):
        out = "ease"
        return true
    if WebCssSpanEqualsText(source, identStart, identEnd, "ease-in"):
        out = "ease-in"
        return true
    if WebCssSpanEqualsText(source, identStart, identEnd, "ease-out"):
        out = "ease-out"
        return true
    if WebCssSpanEqualsText(source, identStart, identEnd, "ease-in-out"):
        out = "ease-in-out"
        return true
    if WebCssSpanEqualsText(source, identStart, identEnd, "linear"):
        out = "linear"
        return true
    if WebCssSpanEqualsText(source, identStart, identEnd, "step-start"):
        out = "step-start"
        return true
    if WebCssSpanEqualsText(source, identStart, identEnd, "step-end"):
        out = "step-end"
        return true
    // cubic-bezier or steps - store as-is
    out = WebCssSpanToString(source, identStart, identEnd)
    return true

@borrows
fn WebCssEasingValue(name: str, t: float64): float64 =
    if name == "linear":
        return t
    if name == "ease":
        // cubic-bezier(0.25, 0.1, 0.25, 1.0) - simplified approximation
        return t * (2.0 - t)
    if name == "ease-in":
        // cubic-bezier(0.42, 0.0, 1.0, 1.0) - simplified
        return t * t
    if name == "ease-out":
        // cubic-bezier(0.0, 0.0, 0.58, 1.0) - simplified
        return t * (2.0 - t)
    if name == "ease-in-out":
        // cubic-bezier(0.42, 0.0, 0.58, 1.0) - simplified
        if t < 0.5:
            return 2.0 * t * t
        return -1.0 + (4.0 - 2.0 * t) * t
    if name == "step-start":
        if t < 1.0:
            return 0.0
        return 1.0
    if name == "step-end":
        if t < 1.0:
            return 1.0
        return 0.0
    return t

@borrows
fn WebCssInterpolatePx(a: str, b: str, t: float64): str =
    // Parse "123px" from both, lerp, return "Npx"
    var aVal: float64.0
    var bVal: float64.0
    var aIsPx: bool
    var bIsPx: bool
    // Parse a
    var i: int32
    while i < a.len:
        let ch = a[i]
        if ch >= '0' && ch <= '9':
            aVal = aVal * 10.0 + float64(int32(ch) - int32('0'))
        elif ch == '.':
            // decimal point - skip for simplicity
            i = a.len
        i = i + 1
    // Parse b
    i = 0
    while i < b.len:
        let ch = b[i]
        if ch >= '0' && ch <= '9':
            bVal = bVal * 10.0 + float64(int32(ch) - int32('0'))
        elif ch == '.':
            i = b.len
        i = i + 1
    let result = aVal + (bVal - aVal) * t
    var resultStr: str
    var intPart = int32(result)
    // Convert intPart to string
    if intPart == 0:
        resultStr = "0"
    else:
        var digits: str
        var n = intPart
        while n > 0:
            var d = n - (n / 10) * 10
            digits = char(int32('0') + d) + digits
            n = n / 10
        resultStr = digits
    resultStr = resultStr + "px"
    return resultStr

@borrows
fn WebCssInterpolateColor(a: str, b: str, t: float64): str =
    // Parse hex colors (#RRGGBB) and interpolate
    var aR: int32
    var aG: int32
    var aB: int32
    var bR: int32
    var bG: int32
    var bB: int32
    // Parse a (#RRGGBB or #RGB)
    if a.len >= 7 && a[0] == '#':
        aR = (int32(a[1]) - int32('0')) * 16 + (int32(a[2]) - int32('0'))
        aG = (int32(a[3]) - int32('0')) * 16 + (int32(a[4]) - int32('0'))
        aB = (int32(a[5]) - int32('0')) * 16 + (int32(a[6]) - int32('0'))
    if b.len >= 7 && b[0] == '#':
        bR = (int32(b[1]) - int32('0')) * 16 + (int32(b[2]) - int32('0'))
        bG = (int32(b[3]) - int32('0')) * 16 + (int32(b[4]) - int32('0'))
        bB = (int32(b[5]) - int32('0')) * 16 + (int32(b[6]) - int32('0'))
    let r = int32(float64(aR) + float64(bR - aR) * t + 0.5)
    let g = int32(float64(aG) + float64(bG - aG) * t + 0.5)
    let b = int32(float64(aB) + float64(bB - aB) * t + 0.5)
    // Convert to hex string
    var result: str = "#"
    var hexChars: str = "0123456789abcdef"
    result = result + hexChars[(r / 16)]
    result = result + hexChars[(r - (r / 16) * 16)]
    result = result + hexChars[(g / 16)]
    result = result + hexChars[(g - (g / 16) * 16)]
    result = result + hexChars[(b / 16)]
    result = result + hexChars[(b - (b / 16) * 16)]
    return result

@borrows
fn WebCssParseKeyframes(source: str, start: int32, stop: int32): bool =
    // Register @keyframes by storing in a global table
    // Simplified: just return success, actual storage handled externally
    return true

fn WebCssComputeAnimationValue(anim: WebCssKeyframes, property: str, time: float64): str =
    // Find the keyframe pair that brackets the given time
    var result: str
    if anim.keyframes.len == 0:
        return result
    if anim.keyframes.len == 1:
        let kf = anim.keyframes[0]
        for i in 0..<kf.properties.len:
            if kf.properties[i].kind == 0 && kf.properties[i].value == property:
                var dummy: int32
                // Not ideal matching, but return the value
                result = kf.properties[i].value
                return result
        return result
    // Find two keyframes to interpolate between
    var t: float64 = time
    var prev: WebCssKeyframe
    var next: WebCssKeyframe
    var prevIdx: int32 = -1
    var nextIdx: int32 = -1
    for i in 0..<anim.keyframes.len:
        let kf = anim.keyframes[i]
        var offsetVal: float64.0
        if kf.offset == "from" || kf.offset == "0%" || kf.offset == "0":
            offsetVal = 0.0
        elif kf.offset == "to" || kf.offset == "100%" || kf.offset == "100":
            offsetVal = 1.0
        else:
            // Parse percentage
            var pv: float64.0
            var pi: int32
            while pi < kf.offset.len:
                let ch = kf.offset[pi]
                if ch >= '0' && ch <= '9':
                    pv = pv * 10.0 + float64(int32(ch) - int32('0'))
                pi = pi + 1
            offsetVal = pv / 100.0
        if offsetVal <= t:
            if prevIdx < 0 || offsetVal >= 0.0:
                prev = kf
                prevIdx = i
        if offsetVal >= t:
            if nextIdx < 0 || offsetVal <= 1.0:
                next = kf
                nextIdx = i
    if prevIdx < 0:
        prev = anim.keyframes[0]
    if nextIdx < 0:
        next = anim.keyframes[anim.keyframes.len - 1]
    // Find property values
    var prevVal: str
    var nextVal: str
    for i in 0..<prev.properties.len:
        if prev.properties[i].kind == 0 && prev.properties[i].value == property:
            prevVal = prev.properties[i].value
    for i in 0..<next.properties.len:
        if next.properties[i].kind == 0 && next.properties[i].value == property:
            nextVal = next.properties[i].value
    if prevVal == "":
        return nextVal
    if nextVal == "":
        return prevVal
    // For now, return the next value (simplified)
    return nextVal

// === Stage 7: FlexFlow + AspectRatio Keyword Constants ===
const
    WebCssFlexFlowRow = 1
    WebCssFlexFlowColumn = 2
    WebCssFlexFlowRowReverse = 3
    WebCssFlexFlowColumnReverse = 4
    WebCssFlexFlowNoWrap = 0
    WebCssFlexFlowWrap = 1
    WebCssAspectRatioAuto = 0

// === Stage 8: CSS Custom Properties ===
type
    WebCssCustomProperty =
        name: str
        value: str

var cssCustomProperties: WebCssCustomProperty[]

@borrows
fn WebCssRegisterCustomProperty(name: str, value: str) =
    // Update if exists, otherwise add
    for i in 0..<cssCustomProperties.len:
        if cssCustomProperties[i].name == name:
            cssCustomProperties[i].value = value
            return
    var prop: WebCssCustomProperty
    prop.name = name
    prop.value = value
    add(cssCustomProperties, prop)

@borrows
fn WebCssResolveVar(varName: str, fallback: str, depth: int32): str =
    if depth > 8:
        return ""
    for i in 0..<cssCustomProperties.len:
        if cssCustomProperties[i].name == varName:
            return cssCustomProperties[i].value
    return fallback
