@borrows
fn WebCssParseIntValue(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0 || start > stop:
        return false
    for i in start..stop:
        let ch = source[i]
        if ch < '0' || ch > '9':
            return false
        out = out * 10 + int32(ch) - int32('0')
    return true

@borrows
fn WebCssParseOpacityValue(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 255
    if start < 0 || start > stop:
        return false
    if WebCssSpanEqualsText(source, start, stop, "0"):
        out = 0
        return true
    if WebCssSpanEqualsText(source, start, stop, "1"):
        out = 255
        return true
    if source[stop] == '%':
        var percent: int32
        if !WebCssParseIntValue(source, start, stop - 1, percent):
            return false
        if percent < 0 || percent > 100:
            return false
        out = percent * 255 / 100
        return true
    var digitStart = start
    if source[start] == '.':
        digitStart = start + 1
    elif start + 1 <= stop && source[start] == '0' && source[start + 1] == '.':
        digitStart = start + 2
    else:
        return false
    if digitStart > stop:
        return false
    var numerator = 0
    var denominator = 1
    for i in digitStart..stop:
        let ch = source[i]
        if ch < '0' || ch > '9':
            return false
        numerator = numerator * 10 + int32(ch) - int32('0')
        denominator = denominator * 10
    out = numerator * 255 / denominator
    return true

fn WebComputedStyleZIndexInt(style: var WebComputedStyle, out: var int32): bool =
    if !style.hasZIndex:
        out = 0
        return false
    return WebCssParseIntValue(style.zIndexSource, style.zIndexStart, style.zIndexStop, out)

