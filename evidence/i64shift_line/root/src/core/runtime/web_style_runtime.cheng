fn WebCssIsWhitespace(ch: char): bool =
    if ch == ' ':
        return true
    if ch == '\n':
        return true
    if ch == '\t':
        return true
    if ch == '\r':
        return true
    return false

fn WebCssIsNameChar(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    if ch == '-':
        return true
    if ch == '_':
        return true
    return false

fn WebCssIsValuePunctuation(ch: char): bool =
    if ch == '(' || ch == ')':
        return true
    if ch == ',':
        return true
    if ch == '/':
        return true
    if ch == '!':
        return true
    if ch == '+' || ch == '*':
        return true
    return false

@borrows
fn WebCssSpanEqualsText(source: str, startIn: int32, stopIn: int32, text: str): bool =
    # CSS values are whitespace-insensitive at both ends; cascade may keep leading space.
    var start = startIn
    var stop = stopIn
    if start < 0 || stop < start:
        if text.len == 0:
            return true
        return false
    while start <= stop && (source[start] == ' ' || source[start] == '\t' || source[start] == '\n' || source[start] == '\r'):
        start = start + 1
    while stop >= start && (source[stop] == ' ' || source[stop] == '\t' || source[stop] == '\n' || source[stop] == '\r'):
        stop = stop - 1
    if stop < start:
        if text.len == 0:
            return true
        return false
    let count = stop - start + 1
    if count != text.len:
        return false
    for i in 0..<count:
        if source[start + i] != text[i]:
            return false
    return true

@borrows
fn WebCssSpanEqualsSpan(leftSource: str,
                       leftStart: int32,
                       leftStop: int32,
                       rightSource: str,
                       rightStart: int32,
                       rightStop: int32): bool =
    if leftStart < 0 || rightStart < 0:
        return false
    let leftCount = leftStop - leftStart + 1
    let rightCount = rightStop - rightStart + 1
    if leftCount != rightCount:
        return false
    for i in 0..<leftCount:
        if leftSource[leftStart + i] != rightSource[rightStart + i]:
            return false
    return true

fn WebCssTokenPush(tokens: var WebCssToken[], kind: int32, start: int32, stop: int32) =
    var token: WebCssToken
    token.kind = kind
    token.start = start
    token.stop = stop
    add(tokens, token)

@borrows
fn WebCssTokenize(source: str, tokens: var WebCssToken[]): bool =
    tokens = []
    var i: int32
    while i < source.len:
        let ch = source[i]
        if WebCssIsWhitespace(ch):
            i = i + 1
            continue
        if ch == '{':
            WebCssTokenPush(tokens, WebCssTokenLeftBrace, i, i)
            i = i + 1
            continue
        if ch == '}':
            WebCssTokenPush(tokens, WebCssTokenRightBrace, i, i)
            i = i + 1
            continue
        if ch == ':':
            WebCssTokenPush(tokens, WebCssTokenColon, i, i)
            i = i + 1
            continue
        if ch == ';':
            WebCssTokenPush(tokens, WebCssTokenSemicolon, i, i)
            i = i + 1
            continue
        if ch == '[':
            WebCssTokenPush(tokens, WebCssTokenLeftBracket, i, i)
            i = i + 1
            continue
        if ch == ']':
            WebCssTokenPush(tokens, WebCssTokenRightBracket, i, i)
            i = i + 1
            continue
        if ch == '=':
            WebCssTokenPush(tokens, WebCssTokenEquals, i, i)
            i = i + 1
            continue
        if ch == '%':
            WebCssTokenPush(tokens, WebCssTokenPercent, i, i)
            i = i + 1
            continue
        if ch == '.':
            WebCssTokenPush(tokens, WebCssTokenDot, i, i)
            i = i + 1
            continue
        if ch == '#':
            let start = i
            i = i + 1
            if i >= source.len || !WebCssIsNameChar(source[i]):
                return false
            while i < source.len && WebCssIsNameChar(source[i]):
                i = i + 1
            WebCssTokenPush(tokens, WebCssTokenHash, start, i - 1)
            continue
        if ch == '"' || ch == '\'':
            /* Quoted string in a value (e.g. font-feature-settings:"liga" 0):
               consume through the closing quote as one ident token (content
               without quotes), keeping the declaration value parse simple. */
            let start = i
            i = i + 1
            while i < source.len && source[i] != ch:
                i = i + 1
            if i >= source.len:
                return false
            WebCssTokenPush(tokens, WebCssTokenIdent, start + 1, i - 1)
            i = i + 1
            continue
        if WebCssIsValuePunctuation(ch):
            WebCssTokenPush(tokens, WebCssTokenPunctuation, i, i)
            i = i + 1
            continue
        if WebCssIsNameChar(ch) || ch == '\\':
            let start = i
            while i < source.len:
                if WebCssIsNameChar(source[i]):
                    i = i + 1
                    continue
                /* Arbitrary-value class segments (`bg-[#2d2925]`, `w-[136px]`):
                   an escaped or bare bracket opens a run consumed through the
                   closing bracket (contents included), so the selector parse
                   sees one ident token. */
                if source[i] == '\\' && i + 1 < source.len && source[i + 1] == '[':
                    i = i + 2
                    while i < source.len && source[i] != ']':
                        i = i + 1
                    if i < source.len:
                        i = i + 1
                    continue
                if source[i] == '[':
                    i = i + 1
                    while i < source.len && source[i] != ']':
                        i = i + 1
                    if i < source.len:
                        i = i + 1
                    continue
                /* Tailwind v4 var shorthand in class names (`max-w-(--x)`):
                   consume the parenthesized run as part of the ident. */
                if source[i] == '(':
                    i = i + 1
                    while i < source.len && source[i] != ')':
                        i = i + 1
                    if i < source.len:
                        i = i + 1
                    continue
                if source[i] == '\\' && i + 1 < source.len:
                    i = i + 2
                    continue
                break
            WebCssTokenPush(tokens, WebCssTokenIdent, start, i - 1)
            continue
        return false
    return true

