@borrows
fn WebCssParsePxLength(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if !WebCssSpanIsPxLength(source, start, stop):
        return false
    if source[stop] == '%':
        return false
    // CSS 长度允许符号位; 此前负值会把 '-' 当数字参与十进制累加(实测 "-1px" => -29)
    var sign: int32 = 1
    var digitStart = start
    if source[start] == '-':
        sign = 0 - 1
        digitStart = start + 1
    elif source[start] == '+':
        digitStart = start + 1
    for i in digitStart..<stop - 1:
        out = out * 10 + int32(source[i]) - int32('0')
    out = out * sign
    return true

@borrows
fn WebCssParsePxLengthPx2(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0 || start > stop:
        return false
    if source[start] == '0' && start == stop:
        return true
    if stop - start + 1 < 3:
        return false
    if source[stop - 1] != 'p' || source[stop] != 'x':
        return false
    var whole: int32
    var frac: int32
    var fracScale: int32 = 1
    var fracDigits: int32
    var seenDot: bool
    seenDot = false
    for i in start..<stop - 1:
        let ch = source[i]
        if ch == '.':
            if seenDot:
                return false
            seenDot = true
            continue
        if ch < '0' || ch > '9':
            return false
        let digit = int32(ch) - int32('0')
        if seenDot:
            if fracDigits < 3:
                frac = frac * 10 + digit
                fracScale = fracScale * 10
                fracDigits = fracDigits + 1
        else:
            whole = whole * 10 + digit
    if seenDot && fracDigits == 0:
        return false
    out = whole * 2
    if fracDigits > 0:
        out = out + (frac * 2 + fracScale / 2) / fracScale
    return true

@borrows
fn WebCssParsePercentLength(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if !WebCssSpanIsPercentLength(source, start, stop):
        return false
    for i in start..<stop:
        out = out * 10 + int32(source[i]) - int32('0')
    return true

@borrows
fn WebCssParseUnitlessScaled1000(source: str, start: int32, stop: int32, out: var int32): bool =
    out = 0
    if start < 0 || start > stop:
        return false
    var whole: int32
    var frac: int32
    var fracScale: int32 = 1
    var fracDigits: int32
    var seenDot: bool
    seenDot = false
    let endExclusive = stop + 1
    for i in start..<endExclusive:
        let ch = source[i]
        if ch == '.':
            if seenDot:
                return false
            seenDot = true
            continue
        if ch < '0' || ch > '9':
            return false
        let digit = int32(ch) - int32('0')
        if seenDot:
            if fracDigits < 3:
                frac = frac * 10 + digit
                fracScale = fracScale * 10
                fracDigits = fracDigits + 1
        else:
            whole = whole * 10 + digit
    if seenDot && fracDigits == 0:
        return false
    out = whole * 1000
    if fracDigits > 0:
        out = out + frac * 1000 / fracScale
    return true

@borrows
fn WebCssParseLineHeightPx(source: str, start: int32, stop: int32, fontSize: int32, out: var int32): bool =
    out = 0
    if WebCssParsePxLength(source, start, stop, out):
        return true
    if start < 0 || start > stop:
        return false
    var whole: int32
    var frac: int32
    var fracScale: int32 = 1
    var fracDigits: int32
    var seenDot = false
    let count = stop - start + 1
    for offset in 0..<count:
        let ch = source[start + offset]
        if ch == '.':
            if seenDot:
                return false
            seenDot = true
            continue
        if ch < '0' || ch > '9':
            return false
        let digit = int32(ch) - int32('0')
        if seenDot:
            if fracDigits < 3:
                frac = frac * 10 + digit
                fracScale = fracScale * 10
                fracDigits = fracDigits + 1
        else:
            whole = whole * 10 + digit
    if seenDot && fracDigits == 0:
        return false
    var scaled: int32
    scaled = whole * 1000
    if fracDigits > 0:
        scaled = scaled + frac * 1000 / fracScale
    if fontSize <= 0:
        fontSize = 16
    out = (fontSize * scaled + 500) / 1000
    if out <= 0:
        out = 1
    return true

@borrows
fn WebCssParseLineHeightPx2(source: str, start: int32, stop: int32, fontSize: int32, out: var int32): bool =
    out = 0
    if WebCssParsePxLengthPx2(source, start, stop, out):
        return true
    if start < 0 || start > stop:
        return false
    var whole: int32
    var frac: int32
    var fracScale: int32 = 1
    var fracDigits: int32
    var seenDot = false
    let count = stop - start + 1
    for offset in 0..<count:
        let ch = source[start + offset]
        if ch == '.':
            if seenDot:
                return false
            seenDot = true
            continue
        if ch < '0' || ch > '9':
            return false
        let digit = int32(ch) - int32('0')
        if seenDot:
            if fracDigits < 3:
                frac = frac * 10 + digit
                fracScale = fracScale * 10
                fracDigits = fracDigits + 1
        else:
            whole = whole * 10 + digit
    if seenDot && fracDigits == 0:
        return false
    var scaled: int32
    scaled = whole * 1000
    if fracDigits > 0:
        scaled = scaled + frac * 1000 / fracScale
    if fontSize <= 0:
        fontSize = 16
    out = (fontSize * scaled * 2 + 500) / 1000
    if out <= 0:
        out = 1
    return true

fn WebComputedStyleWidthPx(style: var WebComputedStyle, out: var int32): bool =
    if !style.hasWidth:
        out = 0
        return false
    return WebCssParsePxLength(style.widthSource, style.widthStart, style.widthStop, out)

fn WebComputedStyleWidthPercent(style: var WebComputedStyle, out: var int32): bool =
    if !style.hasWidth:
        out = 0
        return false
    return WebCssParsePercentLength(style.widthSource, style.widthStart, style.widthStop, out)

fn WebComputedStyleHeightPercent(style: var WebComputedStyle, out: var int32): bool =
    if !style.hasHeight:
        out = 0
