fn WebCssIsPxProperty(property: int32): bool =
    if property == WebCssPropertyWidth:
        return true
    if property == WebCssPropertyHeight:
        return true
    if property == WebCssPropertyMarginLeft:
        return true
    if property == WebCssPropertyMarginTop:
        return true
    if property == WebCssPropertyMarginRight:
        return true
    if property == WebCssPropertyMarginBottom:
        return true
    if property == WebCssPropertyPaddingLeft:
        return true
    if property == WebCssPropertyPaddingTop:
        return true
    if property == WebCssPropertyPaddingRight:
        return true
    if property == WebCssPropertyPaddingBottom:
        return true
    if property == WebCssPropertyTop:
        return true
    if property == WebCssPropertyRight:
        return true
    if property == WebCssPropertyBottom:
        return true
    if property == WebCssPropertyLeft:
        return true
    if property == WebCssPropertyColumnGap:
        return true
    if property == WebCssPropertyRowGap:
        return true
    if property == WebCssPropertyMinWidth:
        return true
    if property == WebCssPropertyMaxWidth:
        return true
    if property == WebCssPropertyMinHeight:
        return true
    if property == WebCssPropertyMaxHeight:
        return true
    return false

@borrows
fn WebCssSpanIsPxLength(source: str, start: int32, stop: int32): bool =
    var first = start
    if first <= stop && (source[first] == '-' || source[first] == '+'):
        first = first + 1
    let count = stop - first + 1
    if count <= 0:
        return false
    if count == 1 && source[first] == '0':
        return true
    if source[stop] == '%':
        var seenDot = false
        for i in first..<stop:
            let ch = source[i]
            if ch == '.' && !seenDot:
                seenDot = true
                continue
            if ch < '0' || ch > '9':
                return false
        return true
    if count < 3:
        return false
    if source[stop - 1] != 'p' || source[stop] != 'x':
        return false
    var seenDot2 = false
    for i in first..<stop - 1:
        let ch = source[i]
        if ch == '.' && !seenDot2:
            seenDot2 = true
            continue
        if ch < '0' || ch > '9':
            return false
    return true

@borrows
fn WebCssSpanIsPercentLength(source: str, start: int32, stop: int32): bool =
    if start < 0 || start > stop:
        return false
    if source[stop] != '%':
        return false
    if stop <= start:
        return false
    for i in start..<stop:
        let ch = source[i]
        if ch < '0' || ch > '9':
            return false
    return true

fn WebCssPropertyAllowsAuto(property: int32): bool =
    if property == WebCssPropertyMarginLeft:
        return true
    if property == WebCssPropertyMarginRight:
        return true
    return false

@borrows
fn WebCssSpanIsSizeKeyword(source: str, start: int32, stop: int32): bool =
    return WebCssSpanEqualsText(source, start, stop, "auto") ||
        WebCssSpanEqualsText(source, start, stop, "fit-content") ||
        WebCssSpanEqualsText(source, start, stop, "min-content") ||
        WebCssSpanEqualsText(source, start, stop, "max-content") ||
        WebCssSpanEqualsText(source, start, stop, "stretch") ||
        WebCssSpanEqualsText(source, start, stop, "none")

fn WebCssPropertyIsSizeBox(property: int32): bool =
    return property == WebCssPropertyWidth ||
        property == WebCssPropertyHeight ||
        property == WebCssPropertyMinWidth ||
        property == WebCssPropertyMaxWidth ||
        property == WebCssPropertyMinHeight ||
        property == WebCssPropertyMaxHeight

@borrows
fn WebCssSpanHasPrefix(source: str, start: int32, stop: int32, prefix: str): bool =
    if prefix.len > stop - start + 1:
        return false
    for i in 0..<prefix.len:
        if source[start + i] != prefix[i]:
            return false
    return true

@borrows
fn WebCssSpanIsFunctionalOrViewportLength(source: str, start: int32, stop: int32): bool =
    /* Functional length values the app emits (clamp/min/max/calc) and viewport
       units (vw/vh) are accepted opaquely here; computed-style falls back to
       unconstrained for them. */
    if WebCssSpanHasPrefix(source, start, stop, "clamp(") ||
        WebCssSpanHasPrefix(source, start, stop, "min(") ||
        WebCssSpanHasPrefix(source, start, stop, "max(") ||
        WebCssSpanHasPrefix(source, start, stop, "calc("):
        return true
    if stop > start + 2 &&
        ((source[stop - 1] == 'v' && (source[stop] == 'w' || source[stop] == 'h')) ||
         (source[stop - 1] == 'e' && source[stop] == 'm') ||
         (source[stop - 2] == 'r' && source[stop - 1] == 'e' && source[stop] == 'm')):
        return true
    return false

@borrows
fn WebCssSpanIsUniversalKeyword(source: str, start: int32, stop: int32): bool =
    return WebCssSpanEqualsText(source, start, stop, "inherit") ||
        WebCssSpanEqualsText(source, start, stop, "initial") ||
        WebCssSpanEqualsText(source, start, stop, "unset") ||
        WebCssSpanEqualsText(source, start, stop, "revert")

@borrows
fn WebCssSpanEqualsAuto(source: str, start: int32, stop: int32): bool =
    return WebCssSpanEqualsText(source, start, stop, "auto")

@borrows
fn WebCssSpanToString(source: str, start: int32, stop: int32): str =
    if start < 0 || start > stop:
        return ""
    return strings.CloneStrRange(source, start, stop - start + 1)

@borrows
fn WebCssParseSelector(source: str,
                       tokens: var WebCssToken[],
                       index: var int32,
                       rule: var WebCssRule): bool =
    rule.selectorKind = 0
    rule.selectorSource = source
    rule.selectorStart = -1
    rule.selectorStop = -1
    rule.specificity = 0
    rule.selectorAttrName = ""
    rule.selectorAttrValue = ""
    rule.selectorPseudoName = ""
    if index >= tokens.len:
        return false
    let token = tokens[index]
    if token.kind == WebCssTokenIdent:
        // Tag selector: specificity d=1 → packed 1
        rule.selectorKind = WebCssSelectorTag
        rule.selectorStart = token.start
        rule.selectorStop = token.stop
        rule.specificity = 1
        index = index + 1
    elif token.kind == WebCssTokenHash:
        // ID selector: specificity b=1 → packed 10000
        rule.selectorKind = WebCssSelectorId
        rule.selectorStart = token.start + 1
        rule.selectorStop = token.stop
        rule.specificity = 10000
        index = index + 1
    elif token.kind == WebCssTokenDot:
        // Class selector: specificity c=1 → packed 100
        index = index + 1
        if index >= tokens.len || tokens[index].kind != WebCssTokenIdent:
            return false
        rule.selectorKind = WebCssSelectorClass
        rule.selectorStart = tokens[index].start
        rule.selectorStop = tokens[index].stop
        rule.specificity = 100
        index = index + 1
    elif token.kind == WebCssTokenColon:
        // Pseudo-class selector: specificity c=1 → packed 100
        index = index + 1
        if index >= tokens.len || tokens[index].kind != WebCssTokenIdent:
            return false
        rule.selectorKind = WebCssSelectorPseudo
        rule.selectorPseudoName = WebCssSpanToString(source, tokens[index].start, tokens[index].stop)
        rule.specificity = 100
        index = index + 1
    elif token.kind == WebCssTokenLeftBracket:
        // Attribute selector: [attr] or [attr=value], specificity c=1 → packed 100
        index = index + 1
        if index >= tokens.len || tokens[index].kind != WebCssTokenIdent:
            return false
        rule.selectorKind = WebCssSelectorAttr
        rule.selectorAttrName = WebCssSpanToString(source, tokens[index].start, tokens[index].stop)
        index = index + 1
        // Optional [attr=value]
        if index < tokens.len && tokens[index].kind == WebCssTokenEquals:
            index = index + 1
            if index >= tokens.len || tokens[index].kind != WebCssTokenIdent:
                return false
            rule.selectorAttrValue = WebCssSpanToString(source, tokens[index].start, tokens[index].stop)
            index = index + 1
        // Expect ]
        if index >= tokens.len || tokens[index].kind != WebCssTokenRightBracket:
            return false
        rule.specificity = 100
        index = index + 1
    else:
        return false
    if index >= tokens.len || tokens[index].kind != WebCssTokenLeftBrace:
        return false
    index = index + 1
    return true

@borrows
fn WebCssParseDeclaration(source: str,
                          tokens: var WebCssToken[],
                          index: var int32,
                          specificity: int32,
                          sourceOrder: int32,
                          out: var WebCssDeclaration): bool =
    if index >= tokens.len || tokens[index].kind != WebCssTokenIdent:
        return false
    let property = WebCssPropertyKind(source, tokens[index])
    if property == 0:
        // Skip unknown property: consume tokens until ; or }
        index = index + 1
        while index < tokens.len && tokens[index].kind != WebCssTokenSemicolon && tokens[index].kind != WebCssTokenRightBrace:
            index = index + 1
        if index < tokens.len && tokens[index].kind == WebCssTokenSemicolon:
            index = index + 1
        out.property = 0
        out.valueSource = source
        out.valueStart = 0
        out.valueStop = 0
        out.specificity = specificity
        out.sourceOrder = sourceOrder
        return true
    index = index + 1
    if index >= tokens.len || tokens[index].kind != WebCssTokenColon:
        return false
    index = index + 1
    if index >= tokens.len:
        return false
    // Multi-token value: consume all tokens until semicolon or right brace
    let valueStart = tokens[index].start
    var valueStop = tokens[index].stop
    var lastToken = index
    var hasTokens = false
    while index < tokens.len:
        let tk = tokens[index]
        if tk.kind == WebCssTokenSemicolon:
            index = index + 1
            hasTokens = true
            break
        if tk.kind == WebCssTokenRightBrace:
            hasTokens = true
            break
        if hasTokens:
            valueStop = tk.stop
        else:
            valueStart = tk.start
            valueStop = tk.stop
            hasTokens = true
        lastToken = index
        valueStop = tk.stop
        index = index + 1
    if !hasTokens:
        return false
    if WebCssIsPxProperty(property):
        if !WebCssSpanIsPxLength(source, valueStart, valueStop) &&
           !(WebCssPropertyAllowsAuto(property) && WebCssSpanEqualsAuto(source, valueStart, valueStop)) &&
           !(WebCssPropertyIsSizeBox(property) && WebCssSpanIsSizeKeyword(source, valueStart, valueStop)) &&
           !WebCssSpanIsFunctionalOrViewportLength(source, valueStart, valueStop) &&
           !WebCssSpanIsUniversalKeyword(source, valueStart, valueStop):
            return false
    out.property = property
    out.valueSource = source
    out.valueStart = valueStart
    out.valueStop = valueStop
    out.specificity = specificity
    out.sourceOrder = sourceOrder
    return true

fn WebStyleSheetInit(sheet: var WebStyleSheet) =
    sheet.rules = []

@borrows
fn WebStyleSheetParse(css: str, sheet: var WebStyleSheet): bool =
    var tokens: WebCssToken[]
    if !WebCssTokenize(css, tokens):
        return false
    sheet.rules = []
    var index: int32
    var sourceOrder: int32
    while index < tokens.len:
        var rule: WebCssRule
        if !WebCssParseSelector(css, tokens, index, rule):
            return false
        rule.sourceOrder = sourceOrder
        rule.declarations = []
        var declarationCount: int32
        while index < tokens.len && tokens[index].kind != WebCssTokenRightBrace:
            var declaration: WebCssDeclaration
            if !WebCssParseDeclaration(css, tokens, index, rule.specificity, sourceOrder, declaration):
                return false
            add(rule.declarations, declaration)
            declarationCount = declarationCount + 1
        if declarationCount == 0:
            return false
        if index >= tokens.len || tokens[index].kind != WebCssTokenRightBrace:
            return false
        index = index + 1
        add(sheet.rules, rule)
        sourceOrder = sourceOrder + 1
    return true

@borrows
fn WebCssClassListContainsSpan(classText: str, selectorSource: str, selectorStart: int32, selectorStop: int32): bool =
    var start: int32
    var i: int32
    while i <= classText.len:
        let atEnd = i == classText.len
        var split = atEnd
        if !split:
            split = WebCssIsWhitespace(classText[i])
        if split:
            if i > start:
                if WebCssClassListItemEqualsEscapedSelector(classText, start, i - 1, selectorSource, selectorStart, selectorStop):
                    return true
            start = i + 1
        i = i + 1
    return false

@borrows
fn WebCssClassListItemEqualsEscapedSelector(classText: str,
                                            classStart: int32,
                                            classStop: int32,
                                            selectorSource: str,
                                            selectorStart: int32,
                                            selectorStop: int32): bool =
    if classStart < 0 || selectorStart < 0:
        return false
    var ci: int32 = classStart
    var si: int32 = selectorStart
    while ci <= classStop && si <= selectorStop:
        var sc: char = selectorSource[si]
        if sc == '\\':
            si = si + 1
            if si > selectorStop:
                return false
            sc = selectorSource[si]
        if classText[ci] != sc:
            return false
        ci = ci + 1
        si = si + 1
    if !(ci > classStop):
        return false
    if !(si > selectorStop):
        return false
    return true

@borrows
fn WebCssRuleMatchesAttr(document: var web.WebDocument, rule: WebCssRule, nodeId: int32): bool =
    var attrValue: str
    if !web.WebDocumentGetAttribute(document, nodeId, rule.selectorAttrName, attrValue):
        return false
    if rule.selectorAttrValue == "":
        // [attr] — presence only
        return true
    // [attr=value] — exact match
    if attrValue == rule.selectorAttrValue:
        return true
    return false

@borrows
fn WebCssRuleMatchesPseudo(document: var web.WebDocument, rule: WebCssRule, nodeId: int32): bool =
    // Structural pseudo-classes check document tree; state-based always match for now
    if rule.selectorPseudoName == "first-child":
        let parentId = web.WebDocumentNodeParent(document, nodeId)
        if parentId == 0:
            return false
        let firstChild = web.WebDocumentNodeFirstChild(document, parentId)
        if firstChild == nodeId:
            return true
        return false
    if rule.selectorPseudoName == "last-child":
        let parentId = web.WebDocumentNodeParent(document, nodeId)
        if parentId == 0:
            return false
        let lastChild = web.WebDocumentNodeLastChild(document, parentId)
        if lastChild == nodeId:
            return true
        return false
    // For state-based pseudo-classes (hover, focus, active), always match
    return true

@borrows
fn WebCssRuleMatches(document: var web.WebDocument, rule: WebCssRule, nodeId: int32): bool =
    if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
        return false
    if rule.selectorKind == WebCssSelectorTag:
        var tagName: str
        if !web.WebDocumentNodeTagName(document, nodeId, tagName):
            return false
        return WebCssSpanEqualsText(rule.selectorSource, rule.selectorStart, rule.selectorStop, tagName)
    if rule.selectorKind == WebCssSelectorId:
        var idValue: str
        if !web.WebDocumentGetAttribute(document, nodeId, "id", idValue):
            return false
        return WebCssSpanEqualsText(rule.selectorSource, rule.selectorStart, rule.selectorStop, idValue)
    if rule.selectorKind == WebCssSelectorClass:
        var classValue: str
        if !web.WebDocumentGetAttribute(document, nodeId, "class", classValue):
            return false
        return WebCssClassListContainsSpan(classValue, rule.selectorSource, rule.selectorStart, rule.selectorStop)
    if rule.selectorKind == WebCssSelectorAttr:
        return WebCssRuleMatchesAttr(document, rule, nodeId)
    if rule.selectorKind == WebCssSelectorPseudo:
        return WebCssRuleMatchesPseudo(document, rule, nodeId)
    return false

fn WebCssDeclarationWins(currentSpecificity: int32,
                         currentOrder: int32,
                         nextSpecificity: int32,
                         nextOrder: int32): bool =
    if nextSpecificity > currentSpecificity:
        return true
    if nextSpecificity == currentSpecificity && nextOrder >= currentOrder:
        return true
    return false

fn WebCssCascadeMerge(declarations: WebCssDeclaration[], style: var WebComputedStyle) =
    // Apply low priority first, then high priority. WebComputedStyleApplyDeclaration
    // keeps the later/higher specificity or source order winner per property.
    var i: int32
    while i < declarations.len:
        var j = i
        while j > 0:
            var cur: WebCssDeclaration
            var prev: WebCssDeclaration
            cur.property = declarations[j].property
            cur.valueSource = strings.CloneStr(declarations[j].valueSource)
            cur.valueStart = declarations[j].valueStart
            cur.valueStop = declarations[j].valueStop
            cur.specificity = declarations[j].specificity
            cur.sourceOrder = declarations[j].sourceOrder
            prev.property = declarations[j - 1].property
            prev.valueSource = strings.CloneStr(declarations[j - 1].valueSource)
            prev.valueStart = declarations[j - 1].valueStart
            prev.valueStop = declarations[j - 1].valueStop
            prev.specificity = declarations[j - 1].specificity
            prev.sourceOrder = declarations[j - 1].sourceOrder
            var lower = false
            if cur.specificity < prev.specificity:
                lower = true
            elif cur.specificity == prev.specificity && cur.sourceOrder < prev.sourceOrder:
                lower = true
            if !lower:
                break
            declarations[j] = prev
            declarations[j - 1] = cur
            j = j - 1
        i = i + 1
    var k: int32
    while k < declarations.len:
        var item: WebCssDeclaration
        item.property = declarations[k].property
        item.valueSource = strings.CloneStr(declarations[k].valueSource)
        item.valueStart = declarations[k].valueStart
        item.valueStop = declarations[k].valueStop
        item.specificity = declarations[k].specificity
        item.sourceOrder = declarations[k].sourceOrder
        WebComputedStyleApplyDeclaration(style, item)
        k = k + 1

