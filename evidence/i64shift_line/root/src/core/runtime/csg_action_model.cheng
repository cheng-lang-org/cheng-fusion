# CSG 统一决策执行内核 —— 动作合同与规划准入(任务 07 首切片)。
#
# 合同: docs/campaigns/2026-09-21-csg-decision-computer-use/contract.md §1
# deterministic 节点;提案 §2「有界确定性规划」:动作明确读写集、前置条件、
# 状态迁移与错误语义;缺少合同的动作不准入规划。
#
# 结构合同:DOD + SoA,动作行存放在平行列中,动作身份 = int32 行下标;
# 状态变量以 int32 索引寻址;无裸指针/名称/文本键。
#
# 声明即准入:本切片用「非空写集 + 至少一个效果」承载读写集声明;
# 未声明读写集的动作在 CsgActionValidateForPlanning 被显式拒绝,
# 调用方拿到 rejectedAction 精确行号。准入还逐层证明完整性:
#   1) 代价非负(非负加权 Dijkstra 前提);
#   2) 错误语义 = 前置为真则确定性成功(total),可能失败的动作不准入规划
#      (迁移不可信, planning 无从谈起);
#   3) 每个效果目标 ∈ 声明写集,每个拷贝效果源 ∈ 声明读集;
#   4) 前置条件引用的每个状态变量 ∈ 声明读集且在状态域内。
#
# 确定性迁移:效果按声明顺序施加,后面效果可见前面效果的写入;
# 变量 ← 常量(AssignConst)或变量拷贝(CopyVar);拷贝未知变量产生未知
# (Unknown 传播,Unknown != false)。

import cheng/core/runtime/csg_goal as cgoal

const
    CsgActionEffectAssignConst: int32 = 0
    CsgActionEffectCopyVar: int32 = 1

type
    CsgActionModel =
        # 每个动作一行;各列按下标对齐,动作身份 = int32 行下标。
        readVars: int32[]           # 读集池(展平)
        readStart: int32[]
        readCount: int32[]
        writeVars: int32[]          # 写集池(展平)
        writeStart: int32[]
        writeCount: int32[]
        precondition: int32[]       # 谓词节点下标;-1 = 恒真
        effectKind: int32[]         # 效果池:CsgActionEffect*
        effectTarget: int32[]       # 效果目标变量
        effectConst: int64[]        # AssignConst 的常量
        effectSrcVar: int32[]       # CopyVar 的源变量
        effectStart: int32[]
        effectCount: int32[]
        cost: int64[]               # 非负代价
        totalUnderTruePrecond: uint8[]  # 错误语义:1 = 前置为真则确定性成功
        count: int32

# ---- 构造 ----

# 登记一个带完整合同的动作。四个效果列必须等长;effectConst 仅对
# AssignConst 有效,effectSrcVar 仅对 CopyVar 有效。动作身份 = 追加后的
# 行下标(count-1),由消费方按行下标寻址。
fn CsgActionAddAction(out: var CsgActionModel,
                      precondition: int32,
                      cost: int64,
                      totalUnderTruePrecond: uint8,
                      readVars: int32[],
                      writeVars: int32[],
                      effectKind: int32[],
                      effectTarget: int32[],
                      effectConst: int64[],
                      effectSrcVar: int32[]) =
    assert(precondition >= -1, "csg action: precondition index must be -1 or predicate index")
    assert(cost >= int64(0), "csg action: cost must be non-negative")
    assert(totalUnderTruePrecond == uint8(0) || totalUnderTruePrecond == uint8(1),
        "csg action: total flag must be 0/1")
    assert(effectKind.len == effectTarget.len && effectKind.len == effectConst.len &&
        effectKind.len == effectSrcVar.len, "csg action: effect columns must be equal length")
    let readStart = out.readVars.len
    for i in 0..<readVars.len:
        add(out.readVars, readVars[i])
    let writeStart = out.writeVars.len
    for i in 0..<writeVars.len:
        add(out.writeVars, writeVars[i])
    let effectStart = out.effectKind.len
    for i in 0..<effectKind.len:
        let k = effectKind[i]
        assert(k == CsgActionEffectAssignConst || k == CsgActionEffectCopyVar,
            "csg action: unknown effect kind")
        let t = effectTarget[i]
        assert(t >= 0, "csg action: effect target negative")
        if k == CsgActionEffectCopyVar:
            assert(effectSrcVar[i] >= 0, "csg action: copy source negative")
        add(out.effectKind, k)
        add(out.effectTarget, t)
        add(out.effectConst, effectConst[i])
        add(out.effectSrcVar, effectSrcVar[i])
    add(out.readStart, readStart)
    add(out.readCount, readVars.len)
    add(out.writeStart, writeStart)
    add(out.writeCount, writeVars.len)
    add(out.precondition, precondition)
    add(out.effectStart, effectStart)
    add(out.effectCount, effectKind.len)
    add(out.cost, cost)
    add(out.totalUnderTruePrecond, totalUnderTruePrecond)
    out.count = out.count + 1

# 登记一个未声明读写集的动作占位(真实注册形态:handler 无合同)。
# 准入校验必须显式拒绝它,规划器不得消费。
fn CsgActionAddUndeclared(out: var CsgActionModel, cost: int64) =
    assert(cost >= int64(0), "csg action: cost must be non-negative")
    add(out.readStart, out.readVars.len)
    add(out.readCount, 0)
    add(out.writeStart, out.writeVars.len)
    add(out.writeCount, 0)
    add(out.precondition, -1)
    add(out.effectStart, out.effectKind.len)
    add(out.effectCount, 0)
    add(out.cost, cost)
    add(out.totalUnderTruePrecond, uint8(1))
    out.count = out.count + 1

# ---- 只读访问器 ----

@borrows
fn CsgActionCostOf(m: CsgActionModel, i: int32): int64 =
    assert(i >= 0 && i < m.count, "csg action: action index out of range")
    return m.cost[i]

@borrows
fn CsgActionPreconditionOf(m: CsgActionModel, i: int32): int32 =
    assert(i >= 0 && i < m.count, "csg action: action index out of range")
    return m.precondition[i]

@borrows
fn CsgActionReadSetContains(m: CsgActionModel, i: int32, v: int32): bool =
    let start = m.readStart[i]
    let cnt = m.readCount[i]
    for k in 0..<cnt:
        if m.readVars[start + k] == v:
            return true
    return false

@borrows
fn CsgActionWriteSetContains(m: CsgActionModel, i: int32, v: int32): bool =
    let start = m.writeStart[i]
    let cnt = m.writeCount[i]
    for k in 0..<cnt:
        if m.writeVars[start + k] == v:
            return true
    return false

# ---- 确定性迁移 ----

# 在 values/unknown 的 base 偏移状态上按声明顺序施加动作 i 的效果。
# 只允许对已过准入且前置为真的动作调用(本函数只做列完整性 assert)。
@borrows
fn CsgActionApplyEffectsAt(m: CsgActionModel, i: int32, values: var int64[], unknown: var uint8[], base: int32) =
    assert(i >= 0 && i < m.count, "csg action: action index out of range")
    let start = m.effectStart[i]
    let cnt = m.effectCount[i]
    for e in 0..<cnt:
        let k = m.effectKind[start + e]
        let t = m.effectTarget[start + e]
        if k == CsgActionEffectAssignConst:
            values[base + t] = m.effectConst[start + e]
            unknown[base + t] = uint8(0)
        else:
            assert(k == CsgActionEffectCopyVar, "csg action: effect column corrupt")
            let src = m.effectSrcVar[start + e]
            if unknown[base + src] != uint8(0):
                # 拷贝未知产生未知:Unknown != false
                unknown[base + t] = uint8(1)
            else:
                values[base + t] = values[base + src]
                unknown[base + t] = uint8(0)

# ---- 规划准入 ----

# 逐动作证明动作模型可被精确规划消费。任一动作违反合同即返回 false
# 并在 rejectedAction 给出首个违规行号(显式拒绝,绝无静默降级)。
@borrows
fn CsgActionValidateForPlanning(m: CsgActionModel,
                                preds: cgoal.CsgGoalPredicateSet,
                                varCount: int32,
                                rejectedAction: var int32): bool =
    for i in 0..<m.count:
        # 1) 读写集声明:非空写集 + 至少一个效果。无声明不准入规划。
        if m.writeCount[i] <= 0 || m.effectCount[i] <= 0:
            rejectedAction = i
            return false
        # 2) 非负代价(Dijkstra/等代价 BFS 的共同前提)
        if m.cost[i] < int64(0):
            rejectedAction = i
            return false
        # 3) 错误语义:前置为真必须确定性成功;可能失败的动作迁移不可信
        if m.totalUnderTruePrecond[i] == uint8(0):
            rejectedAction = i
            return false
        # 4) 读集/写集变量都在冻结状态域内
        let rs = m.readStart[i]
        let rc = m.readCount[i]
        for k in 0..<rc:
            let v = m.readVars[rs + k]
            if v < 0 || v >= varCount:
                rejectedAction = i
                return false
        let ws = m.writeStart[i]
        let wc = m.writeCount[i]
        for k in 0..<wc:
            let v = m.writeVars[ws + k]
            if v < 0 || v >= varCount:
                rejectedAction = i
                return false
        # 5) 完整性:效果目标必须落在声明写集内,拷贝源必须落在声明读集内
        let es = m.effectStart[i]
        let ec = m.effectCount[i]
        for e in 0..<ec:
            let t = m.effectTarget[es + e]
            if !CsgActionWriteSetContains(m, i, t):
                rejectedAction = i
                return false
            if m.effectKind[es + e] == CsgActionEffectCopyVar:
                let src = m.effectSrcVar[es + e]
                if !CsgActionReadSetContains(m, i, src):
                    rejectedAction = i
                    return false
        # 6) 前置条件:-1 恒真;否则谓词下标合法,且其引用的每个状态变量
        #    都在状态域内并落在声明读集内
        let pre = m.precondition[i]
        if pre != -1:
            if pre < 0 || pre >= preds.count:
                rejectedAction = i
                return false
            var refs: int32[]
            cgoal.CsgGoalCollectVarRefs(preds, pre, refs)
            for r in 0..<refs.len:
                let v = refs[r]
                if v < 0 || v >= varCount || !CsgActionReadSetContains(m, i, v):
                    rejectedAction = i
                    return false
    return true
