# web_fs_runtime.cheng
# File System Access API for Cheng Web runtime.
# Provides: WebFileHandle type and WebFileSystem* functions

type
    WebFileHandle =
        handleId: int32
        name: str
        kind: str     # "file"/"directory"
        content: str  # file content (already read)

# ============================================================
# Global state
# ============================================================

var fileHandles: WebFileHandle[]
var nextHandleId: int32 = 1

# ============================================================
# Internal helpers
# ============================================================

fn WebFileSystemFindIndex(handleId: int32): int32 =
    for i in 0..<fileHandles.len:
        if fileHandles[i].handleId == handleId:
            return i
    return -1

# ============================================================
# WebFileSystemShowOpenFilePicker: Show file picker dialog
# Simplified: returns [-1] indicating not available
# ============================================================

fn WebFileSystemShowOpenFilePicker(options: str, outHandles: var int32[]): bool =
    setLen(outHandles, 1)
    outHandles[0] = -1
    return false

# ============================================================
# WebFileSystemReadFile: Read file content by handle
# ============================================================

fn WebFileSystemReadFile(handleId: int32, out: var str): bool =
    let idx = WebFileSystemFindIndex(handleId)
    if idx < 0:
        return false
    out = fileHandles[idx].content
    return true

# ============================================================
# WebFileSystemWriteFile: Write data to file by handle
# ============================================================

fn WebFileSystemWriteFile(handleId: int32, data: str): bool =
    let idx = WebFileSystemFindIndex(handleId)
    if idx < 0:
        return false
    fileHandles[idx].content = data
    return true

# ============================================================
# WebFileSystemShowSaveFilePicker: Show save file picker
# Simplified: creates in-memory handle, returns handleId
# ============================================================

fn WebFileSystemShowSaveFilePicker(suggestedName: str, outHandleId: var int32): bool =
    let handleId = nextHandleId
    nextHandleId = nextHandleId + 1
    var handle: WebFileHandle
    handle.handleId = handleId
    handle.name = suggestedName
    handle.kind = "file"
    handle.content = ""
    add(fileHandles, handle)
    outHandleId = handleId
    return true
