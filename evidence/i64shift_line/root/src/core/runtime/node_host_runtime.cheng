# ============================================================
# 10. fileURLToPath (pure Cheng)
# ============================================================

# fileURLToPath(url): convert file:// URL to native path
# file:///path/to/file -> /path/to/file
# file:///C:/path -> C:/path (Windows)
fn nodeFileURLToPath(url: str): str =
    let prefix = "file://"
    let n = len(url)
    let prefixLen = len(prefix)
    if n < prefixLen: return url
    # Check prefix
    var matchedPrefix: bool = true
    var i: int32
    while i < prefixLen:
        if url[i] != prefix[i]: matchedPrefix = false; break
        i = i + 1
    if !matchedPrefix: return url
    # Skip prefix
    let start: int32 = prefixLen
    # Handle Windows drive letter (file:///C:/...)
    if n - start >= 4 && url[start] == '/' && url[start + 2] == ':':
        # Remove leading slash for Windows path
        return nodeUrlDecode(url[start + 1 .. n - 1])
    # Unix path
    return nodeUrlDecode(url[start .. n - 1])

# URL decode helper (%XX -> char)
fn nodeUrlDecode(s: str): str =
    # Simple: just return s for now (real impl would decode %20 etc.)
    return s

