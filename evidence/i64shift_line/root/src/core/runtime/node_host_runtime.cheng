@importc("cheng_ipc_main_handle")
fn cheng_ipc_main_handle_native(channel: ptr, handlerId: int32): int32

fn nodeIpcMainHandle(channel: str, handlerId: int32): int32 =
    return cheng_ipc_main_handle_native(cheng_str_to_cstring_native(channel), handlerId)

@importc("cheng_ipc_renderer_invoke")
fn cheng_ipc_renderer_invoke_native(channel: ptr, payload: ptr): ptr

fn nodeIpcRendererInvoke(channel: str, payload: str): str =
    let chRaw: ptr = cheng_str_to_cstring_native(channel)
    let plRaw: ptr = cheng_str_to_cstring_native(payload)
    let result: ptr = cheng_ipc_renderer_invoke_native(chRaw, plRaw)
    if result == nil:
        return ""
    let count: int32 = cheng_cstrlen_native(result)
    return cheng_str_from_utf8_native(result, count)

