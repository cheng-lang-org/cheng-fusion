    let plRaw: ptr = cheng_str_to_cstring_native(payload)
    let result: ptr = cheng_electron_api_bridge_native(mRaw, plRaw)
    if result == nil:
        return ""
    let count: int32 = cheng_cstrlen_native(result)
    return cheng_str_from_utf8_native(result, count)

