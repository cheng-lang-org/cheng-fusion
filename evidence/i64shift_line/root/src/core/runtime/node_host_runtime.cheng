# node_host_runtime.cheng
# Node.js host API stubs for Cheng Web runtime.
# Provides: process, path, Electron IPC, window.electronAPI

# ============================================================
# String conversion helpers (FFI bridges to C runtime exports)
# ============================================================

@importc("cheng_str_to_cstring_temp_bridge")
fn cheng_str_to_cstring_native(text: str): ptr

@importc("cheng_cstrlen")
fn cheng_cstrlen_native(s: ptr): int32

@importc("driver_c_str_from_utf8_copy_bridge")
fn cheng_str_from_utf8_native(raw: ptr, count: int32): str

# ============================================================
# 1. process global
# ============================================================

# Returns a dummy process ID
fn nodeProcessGlobal(): int32 =
    return 42

# Calls c_exit_runtime to terminate the process
@importc("cheng_host_exit_runtime")
fn cheng_exit_runtime_native(code: int32)
fn nodeProcessExit(code: int32) =
    cheng_exit_runtime_native(code)

# Returns current working directory
@importc("cheng_getcwd")
fn cheng_getcwd_native(): ptr

fn nodeProcessCwd(): str =
    let raw: ptr = cheng_getcwd_native()
    if raw == nil:
        return ""
    let count: int32 = cheng_cstrlen_native(raw)
    return cheng_str_from_utf8_native(raw, count)

# Get env var by name, returns "" if not set
@importc("cheng_host_getenv")
fn cheng_host_getenv_native(name: ptr): ptr

fn nodeProcessEnvGet(name: str): str =
    let keyRaw: ptr = cheng_str_to_cstring_native(name)
    let raw: ptr = cheng_host_getenv_native(keyRaw)
    if raw == nil:
        return ""
    let count: int32 = cheng_cstrlen_native(raw)
    return cheng_str_from_utf8_native(raw, count)

# ============================================================
# 2. path module (pure Cheng implementations)
# ============================================================

# Join path segments with "/"
fn nodePathJoin(segments: str[]): str =
    let n: int32 = segments.len
    if n == 0:
        return ""
    var result: str = segments[0]
    var i: int32 = 1
    while i < n:
        let seg: str = segments[i]
        if len(seg) > 0:
            if len(result) > 0:
                let lastCh: int32 = int32(result[len(result) - 1])
                let firstCh: int32 = int32(seg[0])
                if lastCh != int32('/') && firstCh != int32('/'):
                    result = Fmt"{result}/{seg}"
                else:
                    result = Fmt"{result}{seg}"
            else:
                result = seg
        i += 1
    return result

# Internal: backtrack path by one segment (for ".." resolution)
fn pathBacktrack(p: str): str =
    if len(p) == 0 || p == "/":
        return "/"
    var end: int32 = len(p) - 1
    while end > 0 && int32(p[end]) == int32('/'):
        end -= 1
    while end > 0 && int32(p[end]) != int32('/'):
        end -= 1
    if end <= 0:
        if len(p) > 0 && int32(p[0]) == int32('/'):
            return "/"
        return ""
    return p[0 .. end]

# Internal: normalize path by resolving ".", "..", and "//"
fn pathNormalize(p: str): str =
    if len(p) == 0:
        return "."
    let isAbs: bool = int32(p[0]) == int32('/')
    var result: str = if isAbs then "/" else ""
    var segStart: int32 = if isAbs then 1 else 0
    var i: int32 = segStart
    while i <= len(p):
        if i == len(p) || int32(p[i]) == int32('/'):
            let segLen: int32 = i - segStart
            if segLen > 0:
                let seg: str = p[segStart ..< i]
                if seg == "..":
                    result = pathBacktrack(result)
                elif seg != ".":
                    if len(result) > 0 && int32(result[len(result) - 1]) != int32('/'):
                        result = Fmt"{result}/{seg}"
                    else:
                        result = Fmt"{result}{seg}"
            segStart = i + 1
        i += 1
    if len(result) == 0:
        return "."
    return result

# Resolve path: join and normalize segments
fn nodePathResolve(segments: str[]): str =
    let joined: str = nodePathJoin(segments)
    return pathNormalize(joined)

# Directory part of path
fn nodePathDirname(p: str): str =
    let n: int32 = len(p)
    if n == 0:
        return "."
    # Strip trailing slashes
    var end: int32 = n - 1
    while end > 0 && int32(p[end]) == int32('/'):
        end -= 1
    # Find last '/'
    var lastSlash: int32 = -1
    var i: int32 = end
    while i >= 0:
        if int32(p[i]) == int32('/'):
            lastSlash = i
            break
        i -= 1
    if lastSlash == -1:
        return "."
    if lastSlash == 0:
        return "/"
    return p[0 ..< lastSlash]

# File name part of path
fn nodePathBasename(p: str): str =
    let n: int32 = len(p)
    if n == 0:
        return ""
    # Strip trailing slashes
    var end: int32 = n - 1
    while end > 0 && int32(p[end]) == int32('/'):
        end -= 1
    # Find last '/'
    var lastSlash: int32 = -1
    var i: int32 = end
    while i >= 0:
        if int32(p[i]) == int32('/'):
            lastSlash = i
            break
        i -= 1
    return p[lastSlash + 1 .. end]

# Extension part of path (e.g. ".ts")
fn nodePathExtname(p: str): str =
    let base: str = nodePathBasename(p)
    let n: int32 = len(base)
    if n == 0:
        return ""
    # Find last '.'
    var lastDot: int32 = -1
    var i: int32 = n - 1
    while i >= 0:
        if int32(base[i]) == int32('.'):
            lastDot = i
            break
        i -= 1
    if lastDot <= 0:
        return ""
    return base[lastDot .. n - 1]

# Helper: split path into segments by '/'
fn nodePathSplit(p: str, out: var str[]) =
    var segStart: int32
    var i: int32
    while i <= len(p):
        if i == len(p) || int32(p[i]) == int32('/'):
            let segLen: int32 = i - segStart
            if segLen > 0:
                add(out, p[segStart ..< i])
            segStart = i + 1
        i += 1

# path.relative(from, to): compute relative path from 'from' to 'to'
fn nodePathRelative(from: str, to: str): str =
    if len(from) == 0 || len(to) == 0:
        return to
    var fromSegs: str[]
    var toSegs: str[]
    nodePathSplit(from, fromSegs)
    nodePathSplit(to, toSegs)
    # Find common prefix length
    var commonLen: int32
    while commonLen < fromSegs.len && commonLen < toSegs.len && fromSegs[commonLen] == toSegs[commonLen]:
        commonLen += 1
    # Build relative path: ".." for each remaining from segment, then remaining to segments
    var parts: str[]
    var i: int32 = commonLen
    while i < fromSegs.len:
        add(parts, "..")
        i += 1
    i = commonLen
    while i < toSegs.len:
        add(parts, strings.CloneStr(toSegs[i]))
        i += 1
    return nodePathJoin(parts)

