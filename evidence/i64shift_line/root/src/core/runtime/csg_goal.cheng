# CSG 统一决策执行内核 —— 有类型状态目标谓词(任务 07 首切片)。
#
# 合同: docs/campaigns/2026-09-21-csg-decision-computer-use/contract.md §1
# deterministic 节点 / §3 错误族(NeedEvidence 与 false 分立);
# 提案 openspec/proposals/csg-semantic-decision-computer-use.md §2
# 「有界确定性规划」:目标使用有类型的状态谓词,先支持精确身份、标量比较、
# 集合成员及布尔组合;未知事实与 false 分离。
#
# 结构合同(AGENTS 工程规范):DOD + Arena + SoA,谓词节点存放在平行列
# (struct-of-arrays)中,跨节点只允许 int32 索引;无任何裸指针/引用字段。
#
# 构造合同:组合子(and/or/not)只能引用**先于自身加入**的谓词节点
# (child index < parent index,加入时 assert 强制)。求值按列下标升序
# 单趟完成,无需递归,天然确定性。
#
# 三值逻辑:True / False / Unknown。Unknown != False:任一叶子引用的
# 状态变量处于 unknown(必要证据缺失)时按 Kleene 三值逻辑传播;
# 求值结果为 Unknown 时,规划层必须返回 NeedEvidence 而不是当作 false。

const
    CsgGoalTrue: int32 = 0
    CsgGoalFalse: int32 = 1
    CsgGoalUnknown: int32 = 2

    CsgGoalPredIdentityEq: int32 = 0
    CsgGoalPredScalarEq: int32 = 1
    CsgGoalPredScalarLt: int32 = 2
    CsgGoalPredScalarLe: int32 = 3
    CsgGoalPredInSet: int32 = 4
    CsgGoalPredAnd: int32 = 5
    CsgGoalPredOr: int32 = 6
    CsgGoalPredNot: int32 = 7

type
    CsgGoalPredicateSet =
        # 每个谓词节点一行;各列按下标对齐,节点身份 = int32 列下标。
        kind: int32[]           # CsgGoalPred*
        varIndex: int32[]       # 叶子主变量(状态变量 int32 索引)
        rhsVar: int32[]         # IdentityEq 的右变量(精确身份相等)
        constant: int64[]       # 标量比较常量(int64)
        members: int64[]        # InSet 成员池(展平)
        memberStart: int32[]    # 该节点成员在池中的起点
        memberCount: int32[]    # 该节点成员个数(>=1)
        childA: int32[]         # And/Or 左孩子
        childB: int32[]         # And/Or 右孩子
        child: int32[]          # Not 孩子
        count: int32

# ---- 构造 ----
# 各列必须逐节点对齐:每个 Add* 都向全部列追加占位/实值。

fn CsgGoalAddIdentityEq(out: var CsgGoalPredicateSet, lhsVar: int32, rhsVar: int32): int32 =
    assert(lhsVar >= 0 && rhsVar >= 0, "csg goal: identity-eq variable index negative")
    let idx = out.count
    add(out.kind, CsgGoalPredIdentityEq)
    add(out.varIndex, lhsVar)
    add(out.rhsVar, rhsVar)
    add(out.constant, int64(0))
    add(out.memberStart, 0)
    add(out.memberCount, 0)
    add(out.childA, -1)
    add(out.childB, -1)
    add(out.child, -1)
    out.count = idx + 1
    return idx

fn CsgGoalAddScalarCompare(out: var CsgGoalPredicateSet, kind: int32, varIndex: int32, constant: int64): int32 =
    assert(kind == CsgGoalPredScalarEq || kind == CsgGoalPredScalarLt || kind == CsgGoalPredScalarLe,
        "csg goal: scalar compare kind must be eq/lt/le")
    assert(varIndex >= 0, "csg goal: scalar compare variable index negative")
    let idx = out.count
    add(out.kind, kind)
    add(out.varIndex, varIndex)
    add(out.rhsVar, -1)
    add(out.constant, constant)
    add(out.memberStart, 0)
    add(out.memberCount, 0)
    add(out.childA, -1)
    add(out.childB, -1)
    add(out.child, -1)
    out.count = idx + 1
    return idx

# 集合成员谓词:v ∈ members。接管 members 序列所有权(值逐元素拷入池)。
fn CsgGoalAddInSet(out: var CsgGoalPredicateSet, varIndex: int32, members: int64[]): int32 =
    assert(varIndex >= 0, "csg goal: in-set variable index negative")
    assert(members.len > 0, "csg goal: membership set must be non-empty")
    let idx = out.count
    let start = out.members.len
    for i in 0..<members.len:
        add(out.members, members[i])
    add(out.kind, CsgGoalPredInSet)
    add(out.varIndex, varIndex)
    add(out.rhsVar, -1)
    add(out.constant, int64(0))
    add(out.memberStart, start)
    add(out.memberCount, members.len)
    add(out.childA, -1)
    add(out.childB, -1)
    add(out.child, -1)
    out.count = idx + 1
    return idx

fn CsgGoalAddAnd(out: var CsgGoalPredicateSet, childA: int32, childB: int32): int32 =
    assert(childA >= 0 && childA < out.count, "csg goal: and childA must precede parent")
    assert(childB >= 0 && childB < out.count, "csg goal: and childB must precede parent")
    let idx = out.count
    add(out.kind, CsgGoalPredAnd)
    add(out.varIndex, -1)
    add(out.rhsVar, -1)
    add(out.constant, int64(0))
    add(out.memberStart, 0)
    add(out.memberCount, 0)
    add(out.childA, childA)
    add(out.childB, childB)
    add(out.child, -1)
    out.count = idx + 1
    return idx

fn CsgGoalAddOr(out: var CsgGoalPredicateSet, childA: int32, childB: int32): int32 =
    assert(childA >= 0 && childA < out.count, "csg goal: or childA must precede parent")
    assert(childB >= 0 && childB < out.count, "csg goal: or childB must precede parent")
    let idx = out.count
    add(out.kind, CsgGoalPredOr)
    add(out.varIndex, -1)
    add(out.rhsVar, -1)
    add(out.constant, int64(0))
    add(out.memberStart, 0)
    add(out.memberCount, 0)
    add(out.childA, childA)
    add(out.childB, childB)
    add(out.child, -1)
    out.count = idx + 1
    return idx

fn CsgGoalAddNot(out: var CsgGoalPredicateSet, child: int32): int32 =
    assert(child >= 0 && child < out.count, "csg goal: not child must precede parent")
    let idx = out.count
    add(out.kind, CsgGoalPredNot)
    add(out.varIndex, -1)
    add(out.rhsVar, -1)
    add(out.constant, int64(0))
    add(out.memberStart, 0)
    add(out.memberCount, 0)
    add(out.childA, -1)
    add(out.childB, -1)
    add(out.child, child)
    out.count = idx + 1
    return idx

# ---- 求值 ----

# 对状态区间 [base, base+varCount) 求值整棵谓词列,返回 results[root]。
# 状态编码 = 定长 int64 值向量 + 逐变量 unknown 字节(0=已知, 1=未知)。
# 契约:孩子下标严格小于父下标(构造器强制),升序单趟即后序。
@borrows
fn CsgGoalEvaluateAt(s: CsgGoalPredicateSet, root: int32, values: int64[], unknown: uint8[], base: int32): int32 =
    assert(root >= 0 && root < s.count, "csg goal: evaluate root out of range")
    var results: int32[]
    for i in 0..<s.count:
        let k = s.kind[i]
        assert(k >= CsgGoalPredIdentityEq && k <= CsgGoalPredNot, "csg goal: unknown predicate kind")
        var r: int32
        if k == CsgGoalPredIdentityEq:
            let lhs = s.varIndex[i]
            let rhs = s.rhsVar[i]
            assert(lhs >= 0 && rhs >= 0, "csg goal: identity-eq column corrupt")
            if unknown[base + lhs] != uint8(0) || unknown[base + rhs] != uint8(0):
                r = CsgGoalUnknown
            elif values[base + lhs] == values[base + rhs]:
                r = CsgGoalTrue
            else:
                r = CsgGoalFalse
        elif k == CsgGoalPredScalarEq || k == CsgGoalPredScalarLt || k == CsgGoalPredScalarLe || k == CsgGoalPredInSet:
            let v = s.varIndex[i]
            assert(v >= 0, "csg goal: leaf variable column corrupt")
            if unknown[base + v] != uint8(0):
                r = CsgGoalUnknown
            elif k == CsgGoalPredScalarEq:
                if values[base + v] == s.constant[i]:
                    r = CsgGoalTrue
                else:
                    r = CsgGoalFalse
            elif k == CsgGoalPredScalarLt:
                if values[base + v] < s.constant[i]:
                    r = CsgGoalTrue
                else:
                    r = CsgGoalFalse
            elif k == CsgGoalPredScalarLe:
                if values[base + v] <= s.constant[i]:
                    r = CsgGoalTrue
                else:
                    r = CsgGoalFalse
            else:
                # InSet:未知已在上游截获,这里值必已知
                r = CsgGoalFalse
                let start = s.memberStart[i]
                let cnt = s.memberCount[i]
                for m in 0..<cnt:
                    if values[base + v] == s.members[start + m]:
                        r = CsgGoalTrue
                        break
        elif k == CsgGoalPredAnd:
            assert(s.childA[i] >= 0 && s.childA[i] < i && s.childB[i] >= 0 && s.childB[i] < i,
                "csg goal: and child must precede parent")
            let a = results[s.childA[i]]
            let b = results[s.childB[i]]
            if a == CsgGoalFalse || b == CsgGoalFalse:
                r = CsgGoalFalse
            elif a == CsgGoalUnknown || b == CsgGoalUnknown:
                r = CsgGoalUnknown
            else:
                r = CsgGoalTrue
        elif k == CsgGoalPredOr:
            assert(s.childA[i] >= 0 && s.childA[i] < i && s.childB[i] >= 0 && s.childB[i] < i,
                "csg goal: or child must precede parent")
            let a = results[s.childA[i]]
            let b = results[s.childB[i]]
            if a == CsgGoalTrue || b == CsgGoalTrue:
                r = CsgGoalTrue
            elif a == CsgGoalUnknown || b == CsgGoalUnknown:
                r = CsgGoalUnknown
            else:
                r = CsgGoalFalse
        else:
            # Not(唯一剩余合法 kind,上方 assert 已排除未知 kind)
            assert(s.child[i] >= 0 && s.child[i] < i, "csg goal: not child must precede parent")
            let a = results[s.child[i]]
            if a == CsgGoalTrue:
                r = CsgGoalFalse
            elif a == CsgGoalFalse:
                r = CsgGoalTrue
            else:
                r = CsgGoalUnknown
        add(results, r)
    return results[root]

# ---- 谓词引用的状态变量收集 ----

fn csgGoalAppendVarDedup(outVars: var int32[], v: int32) =
    for i in 0..<outVars.len:
        if outVars[i] == v:
            return
    add(outVars, v)

# 收集 root 子树引用的全部状态变量(int32,去重,升序发现序)。
# 动作模型准入用它强制「前置条件引用的变量必须落在声明的读集内」。
@borrows
fn CsgGoalCollectVarRefs(s: CsgGoalPredicateSet, root: int32, outVars: var int32[]) =
    assert(root >= 0 && root < s.count, "csg goal: collect root out of range")
    var marked: uint8[]
    for i in 0..<s.count:
        add(marked, uint8(0))
    marked[root] = uint8(1)
    # 孩子下标 < 父下标:降序标记即可覆盖整个子树
    var i: int32 = s.count - 1
    while i >= 0:
        if marked[i] != uint8(0):
            let k = s.kind[i]
            if k == CsgGoalPredAnd || k == CsgGoalPredOr:
                assert(s.childA[i] >= 0 && s.childA[i] < s.count, "csg goal: and child column corrupt")
                assert(s.childB[i] >= 0 && s.childB[i] < s.count, "csg goal: or child column corrupt")
                marked[s.childA[i]] = uint8(1)
                marked[s.childB[i]] = uint8(1)
            elif k == CsgGoalPredNot:
                assert(s.child[i] >= 0 && s.child[i] < s.count, "csg goal: not child column corrupt")
                marked[s.child[i]] = uint8(1)
        i = i - 1
    for i in 0..<s.count:
        if marked[i] == uint8(0):
            continue
        let k = s.kind[i]
        if k == CsgGoalPredIdentityEq:
            csgGoalAppendVarDedup(outVars, s.varIndex[i])
            csgGoalAppendVarDedup(outVars, s.rhsVar[i])
        elif k == CsgGoalPredScalarEq || k == CsgGoalPredScalarLt || k == CsgGoalPredScalarLe || k == CsgGoalPredInSet:
            csgGoalAppendVarDedup(outVars, s.varIndex[i])
