@borrows
fn FinanceProductionEnvironmentPreimage(env: FinanceProductionTransactionEnvironment): str =
    var lines: str[]
    envAddLine(lines, "schema", cert.FinanceDialectVersion)
    envAddLine(lines, "kind", "production_transaction_environment")
    envAddLine(lines, "typedActionHash", FinanceTypedActionHash(env.typedAction))
    envAddLine(lines, "policyReceiptHash", FinancePolicyReceiptHash(env.policyReceipt))
    envAddLine(lines, "stateReceiptHash", FinanceStateSnapshotReceiptHash(env.stateReceipt))
    envAddLine(lines, "contractEntryHash", FinanceContractRegistryEntryHash(env.contractEntry))
    envAddLine(lines, "simulationReceiptHash", FinanceSimulationReceiptHash(env.simulationReceipt))
    envAddLine(lines, "payloadReceiptHash", FinancePayloadReceiptHash(env.payloadReceipt))
    envAddLine(lines, "signerSessionHash", FinanceSignerSessionHash(env.signerSession))
    envAddLine(lines, "executionSubstrateHash", FinanceExecutionSubstrateHash(env.executionSubstrate))
    return envJoin(lines)

