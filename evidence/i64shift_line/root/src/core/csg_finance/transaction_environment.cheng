import std/result
import std/rawbytes
import std/crypto/sha256
import std/strings
import std/strutils as strutil
import cheng/core/csg_finance/certified_transaction as cert

const
    FinanceEnvSourceTypedAction = "typed_action"
    FinanceEnvFinalitySafe = "safe"
    FinanceEnvFinalityFinalized = "finalized"
    FinanceEnvChainAdapterNative = "chain-native"
    FinanceEnvSignerBoundaryIsolated = "isolated-signer"
    FinanceEnvSubstrateChengCsgTransactionOs = "cheng-csg-transaction-os"

type
    FinanceTypedAction =
        id: str
        sourceKind: str
        controlSurfaceId: str
        payloadSchemaHash: str
        uiDisplayHash: str
        userIntentHash: str
        userId: str
        actionKind: str
        chainId: int64
        asset: str
        amount: int64
        recipientIdentity: str
        recipientAddress: str
        userAuthorized: bool
        aiGenerated: bool
        visualClickPath: bool

    FinancePolicyReceipt =
        id: str
        policy: cert.FinancePolicy
        policyHash: str
        policySourceHash: str
        policyVersionHash: str
        policyOwnerUserId: str
        authorizationHash: str

    FinanceStateSnapshotReceipt =
        id: str
        snapshot: cert.FinanceStateSnapshot
        blockHash: str
        stateRootHash: str
        rpcProviderHash: str
        finality: str
        receiptHash: str

    FinanceContractRegistryEntry =
        id: str
        profile: cert.FinanceContractProfile
        profileHash: str
        registryVersionHash: str
        registryAuthorityHash: str
        selectorPolicyHash: str
        revoked: bool
        receiptHash: str

    FinanceSimulationReceipt =
        id: str
        simulation: cert.FinanceSimulationResult
        engineId: str
        engineVersionHash: str
        stateSnapshotHash: str
        contractProfileHash: str
        payloadHash: str
        requestHash: str
        receiptHash: str
        engineTrusted: bool

    FinancePayloadReceipt =
        id: str
        payload: cert.FinanceSigningPayload
        builderId: str
        builderVersionHash: str
        typedActionHash: str
        policyHash: str
        stateSnapshotHash: str
        contractProfileHash: str
        receiptHash: str
        builderTrusted: bool

    FinanceSignerSession =
        id: str
        signerKind: str
        signerId: str
        deviceBindingHash: str
        sessionPolicyHash: str
        attestationHash: str
        hardwareBacked: bool
        expiresAtBlock: int64
        keyExportable: bool
        aiProcessAccessible: bool

    FinanceExecutionSubstrate =
        id: str
        substrateKind: str
        osIdentityHash: str
        kernelCapabilityHash: str
        processIsolationHash: str
        signerIsolationHash: str
        memoryPolicyHash: str
        networkPolicyHash: str
        uiTrustedPathHash: str
        deviceAttestationHash: str
        csgMeasurementHash: str
        receiptHash: str
        chengCsgKernel: bool
        capabilityRuntime: bool
        deterministicSyscalls: bool
        signerIsolated: bool
        aiProcessIsolated: bool
        uiTrustedPath: bool
        networkPinned: bool
        noDynamicCodeLoading: bool
        noVisualTransactionPath: bool
        noClipboardTransactionPath: bool

    FinanceProductionTransactionEnvironment =
        typedAction: FinanceTypedAction
        policyReceipt: FinancePolicyReceipt
        stateReceipt: FinanceStateSnapshotReceipt
        contractEntry: FinanceContractRegistryEntry
        simulationReceipt: FinanceSimulationReceipt
        payloadReceipt: FinancePayloadReceipt
        signerSession: FinanceSignerSession
        executionSubstrate: FinanceExecutionSubstrate

    FinanceExecutionEnvelope =
        environmentHash: str
        executionSubstrateHash: str
        compileInput: cert.FinanceCompileInput
        certified: cert.FinanceCertifiedTransaction
        authorization: cert.FinanceSignerAuthorization
        requiredSignerKind: str
        requiredSignerId: str
        auditTrace: str

    FinanceSignedTransactionReceipt =
        id: str
        signerKind: str
        signerId: str
        environmentHash: str
        executionSubstrateHash: str
        certifiedHash: str
        payloadHash: str
        authorizationHash: str
        signedTransactionHash: str
        signatureScheme: str
        signerBoundary: str
        keyExportable: bool
        aiProcessAccessible: bool

    FinanceChainAdapterProfile =
        id: str
        chainId: int64
        adapterKind: str
        adapterVersionHash: str
        supportedSignatureScheme: str
        broadcastPolicyHash: str
        trustedAdapter: bool
        visualPath: bool

    FinanceBroadcastRequest =
        id: str
        chainId: int64
        environmentHash: str
        executionSubstrateHash: str
        certifiedHash: str
        payloadHash: str
        authorizationHash: str
        signedTransactionHash: str
        chainAdapterId: str
        chainAdapterVersionHash: str
        maxSubmitBlock: int64
        broadcastPolicyHash: str
        requestHash: str

@borrows
fn envCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn envCat3(a: str, b: str, c: str): str =
    return envCat(envCat(a, b), c)

fn envBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn envI32(value: int32): str =
    return strings.IntToStr(value)

fn envI64(value: int64): str =
    return strings.Int64ToStr(value)

@borrows
fn envLine(key: str, value: str): str =
    return envCat3(key, "=", value)

@borrows
fn envAddLine(lines: var str[], key: str, value: str) =
    add(lines, envLine(key, value))

fn envJoin(lines: str[]): str =
    return strutil.Join(lines, "\n")

fn envSha256(preimage: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(preimage))
    return envCat("sha256:", rawbytes.BytesToHex(digest))

@borrows
fn envHashOk(hashText: str): bool =
    if hashText.len <= 7:
        return false
    return strings.HasPrefix(hashText, "sha256:")

@borrows
fn envRequireHash(hashText: str, label: str): Result[bool] =
    if !envHashOk(hashText):
        return Err[bool](envCat("finance env: invalid hash field ", label))
    return Ok[bool](true)

@borrows
fn envFinalityAllowed(finality: str): bool =
    return finality == FinanceEnvFinalitySafe || finality == FinanceEnvFinalityFinalized

@borrows
fn FinanceTypedActionPreimage(action: FinanceTypedAction): str =
    var lines: str[]
    envAddLine(lines, "schema", cert.FinanceDialectVersion)
    envAddLine(lines, "kind", "typed_action")
    envAddLine(lines, "id", action.id)
    envAddLine(lines, "sourceKind", action.sourceKind)
    envAddLine(lines, "controlSurfaceId", action.controlSurfaceId)
    envAddLine(lines, "payloadSchemaHash", action.payloadSchemaHash)
    envAddLine(lines, "uiDisplayHash", action.uiDisplayHash)
    envAddLine(lines, "userIntentHash", action.userIntentHash)
    envAddLine(lines, "userId", action.userId)
    envAddLine(lines, "actionKind", action.actionKind)
    envAddLine(lines, "chainId", envI64(action.chainId))
    envAddLine(lines, "asset", action.asset)
    envAddLine(lines, "amount", envI64(action.amount))
    envAddLine(lines, "recipientIdentity", action.recipientIdentity)
    envAddLine(lines, "recipientAddress", action.recipientAddress)
    envAddLine(lines, "userAuthorized", envBool(action.userAuthorized))
    envAddLine(lines, "aiGenerated", envBool(action.aiGenerated))
    envAddLine(lines, "visualClickPath", envBool(action.visualClickPath))
    return envJoin(lines)

@borrows
fn FinanceTypedActionHash(action: FinanceTypedAction): str =
    return envSha256(FinanceTypedActionPreimage(action))

