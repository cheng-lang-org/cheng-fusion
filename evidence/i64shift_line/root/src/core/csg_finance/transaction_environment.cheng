@borrows
fn FinanceIntentFromTypedAction(action: FinanceTypedAction): cert.FinanceIntent =
    return cert.FinanceIntent(
        id: envCat("intent:", action.id),
        userId: action.userId,
        sourceKind: cert.FinanceSourceUserIntent,
        sourceIntentHash: action.userIntentHash,
        actionKind: action.actionKind,
        chainId: action.chainId,
        asset: action.asset,
        amount: action.amount,
        recipientIdentity: action.recipientIdentity,
        recipientAddress: action.recipientAddress,
        userAuthorized: action.userAuthorized
    )

@borrows
fn FinanceValidateTypedAction(action: FinanceTypedAction): Result[bool] =
    if action.id.len <= 0:
        return Err[bool]("finance env: missing typed action id")
    if action.sourceKind != FinanceEnvSourceTypedAction:
        return Err[bool]("finance env: transaction must enter through typed action")
    if action.controlSurfaceId.len <= 0:
        return Err[bool]("finance env: missing control surface id")
    if IsErr(envRequireHash(action.payloadSchemaHash, "typedAction.payloadSchemaHash")):
        return Err[bool]("finance env: invalid typed action payload schema hash")
    if IsErr(envRequireHash(action.uiDisplayHash, "typedAction.uiDisplayHash")):
        return Err[bool]("finance env: invalid typed action UI display hash")
    if IsErr(envRequireHash(action.userIntentHash, "typedAction.userIntentHash")):
        return Err[bool]("finance env: invalid typed action user intent hash")
    if action.userId.len <= 0:
        return Err[bool]("finance env: missing typed action user")
    if !cert.FinanceActionAllowed(action.actionKind):
        return Err[bool]("finance env: unsupported typed action")
    if !action.userAuthorized:
        return Err[bool]("finance env: typed action not user authorized")
    if action.aiGenerated:
        return Err[bool]("finance env: AI generated proposal cannot enter transaction compiler")
    if action.visualClickPath:
        return Err[bool]("finance env: visual click path cannot enter transaction compiler")
    return Ok[bool](true)

@borrows
fn FinanceValidatePolicyReceipt(action: FinanceTypedAction, receipt: FinancePolicyReceipt): Result[bool] =
    if receipt.id.len <= 0:
        return Err[bool]("finance env: missing policy receipt id")
    if receipt.policyOwnerUserId != action.userId:
        return Err[bool]("finance env: policy owner differs from action user")
    if receipt.policyHash != cert.FinancePolicyHash(receipt.policy):
        return Err[bool]("finance env: policy receipt hash mismatch")
    if receipt.policy.allowedChainId != action.chainId:
        return Err[bool]("finance env: policy chain differs from action")
    if receipt.policy.allowedAsset != action.asset:
        return Err[bool]("finance env: policy asset differs from action")
    if receipt.policy.allowedRecipientIdentity != action.recipientIdentity:
        return Err[bool]("finance env: policy recipient identity differs from action")
    if receipt.policy.allowedRecipientAddress != action.recipientAddress:
        return Err[bool]("finance env: policy recipient address differs from action")
    if IsErr(envRequireHash(receipt.policySourceHash, "policyReceipt.policySourceHash")):
        return Err[bool]("finance env: invalid policy source hash")
    if IsErr(envRequireHash(receipt.policyVersionHash, "policyReceipt.policyVersionHash")):
        return Err[bool]("finance env: invalid policy version hash")
    if IsErr(envRequireHash(receipt.authorizationHash, "policyReceipt.authorizationHash")):
        return Err[bool]("finance env: invalid policy authorization hash")
    return Ok[bool](true)

@borrows
fn FinanceValidateStateReceipt(action: FinanceTypedAction,
                               policy: cert.FinancePolicy,
                               receipt: FinanceStateSnapshotReceipt): Result[bool] =
    if receipt.id.len <= 0:
        return Err[bool]("finance env: missing state receipt id")
    if receipt.snapshot.chainId != action.chainId:
        return Err[bool]("finance env: state snapshot chain differs from action")
    if receipt.snapshot.blockNumber > policy.validUntilBlock:
        return Err[bool]("finance env: state snapshot expired before policy")
    if !envFinalityAllowed(receipt.finality):
        return Err[bool]("finance env: state snapshot finality is not safe")
    if IsErr(envRequireHash(receipt.blockHash, "stateReceipt.blockHash")):
        return Err[bool]("finance env: invalid block hash")
    if IsErr(envRequireHash(receipt.stateRootHash, "stateReceipt.stateRootHash")):
        return Err[bool]("finance env: invalid state root hash")
    if IsErr(envRequireHash(receipt.rpcProviderHash, "stateReceipt.rpcProviderHash")):
        return Err[bool]("finance env: invalid rpc provider hash")
    if receipt.receiptHash != FinanceStateSnapshotReceiptHash(receipt):
        return Err[bool]("finance env: state receipt hash mismatch")
    return Ok[bool](true)

@borrows
fn FinanceValidateContractEntry(action: FinanceTypedAction,
                                policy: cert.FinancePolicy,
                                entry: FinanceContractRegistryEntry): Result[bool] =
    if entry.id.len <= 0:
        return Err[bool]("finance env: missing contract registry entry id")
    if entry.revoked:
        return Err[bool]("finance env: contract registry entry revoked")
    if entry.profileHash != cert.FinanceContractProfileHash(entry.profile):
        return Err[bool]("finance env: contract profile hash mismatch")
    if entry.profile.chainId != action.chainId:
        return Err[bool]("finance env: contract profile chain differs from action")
    if entry.profile.contractAddress != policy.allowedContract:
        return Err[bool]("finance env: contract address differs from policy")
    if entry.profile.selector != policy.allowedSelector:
        return Err[bool]("finance env: selector differs from policy")
    if IsErr(envRequireHash(entry.registryVersionHash, "contractEntry.registryVersionHash")):
        return Err[bool]("finance env: invalid registry version hash")
    if IsErr(envRequireHash(entry.registryAuthorityHash, "contractEntry.registryAuthorityHash")):
        return Err[bool]("finance env: invalid registry authority hash")
    if IsErr(envRequireHash(entry.selectorPolicyHash, "contractEntry.selectorPolicyHash")):
        return Err[bool]("finance env: invalid selector policy hash")
    if entry.receiptHash != FinanceContractRegistryEntryHash(entry):
        return Err[bool]("finance env: contract registry receipt hash mismatch")
    return Ok[bool](true)

@borrows
fn FinanceValidatePayloadReceipt(actionHash: str,
                                 policyHash: str,
                                 stateSnapshotHash: str,
                                 contractProfileHash: str,
                                 receipt: FinancePayloadReceipt): Result[bool] =
    if receipt.id.len <= 0:
        return Err[bool]("finance env: missing payload receipt id")
    if !receipt.builderTrusted:
        return Err[bool]("finance env: payload builder is not trusted")
    if receipt.typedActionHash != actionHash:
        return Err[bool]("finance env: payload typed action hash mismatch")
    if receipt.policyHash != policyHash:
        return Err[bool]("finance env: payload policy hash mismatch")
    if receipt.stateSnapshotHash != stateSnapshotHash:
        return Err[bool]("finance env: payload state snapshot hash mismatch")
    if receipt.contractProfileHash != contractProfileHash:
        return Err[bool]("finance env: payload contract profile hash mismatch")
    if IsErr(envRequireHash(receipt.builderVersionHash, "payloadReceipt.builderVersionHash")):
        return Err[bool]("finance env: invalid payload builder version hash")
    if receipt.builderId.len <= 0:
        return Err[bool]("finance env: missing payload builder id")
    if receipt.receiptHash != FinancePayloadReceiptHash(receipt):
        return Err[bool]("finance env: payload receipt hash mismatch")
    return Ok[bool](true)

@borrows
fn FinanceValidateSimulationReceipt(stateSnapshotHash: str,
                                    contractProfileHash: str,
                                    payload: cert.FinanceSigningPayload,
                                    receipt: FinanceSimulationReceipt): Result[bool] =
    if receipt.id.len <= 0:
        return Err[bool]("finance env: missing simulation receipt id")
    if !receipt.engineTrusted:
        return Err[bool]("finance env: simulation engine is not trusted")
    if receipt.engineId.len <= 0:
        return Err[bool]("finance env: missing simulation engine id")
    if IsErr(envRequireHash(receipt.engineVersionHash, "simulationReceipt.engineVersionHash")):
        return Err[bool]("finance env: invalid simulation engine version hash")
    if IsErr(envRequireHash(receipt.requestHash, "simulationReceipt.requestHash")):
        return Err[bool]("finance env: invalid simulation request hash")
    if receipt.stateSnapshotHash != stateSnapshotHash:
        return Err[bool]("finance env: simulation state snapshot hash mismatch")
    if receipt.contractProfileHash != contractProfileHash:
        return Err[bool]("finance env: simulation contract profile hash mismatch")
    if receipt.payloadHash != payload.payloadHash:
        return Err[bool]("finance env: simulation payload hash mismatch")
    if receipt.simulation.payloadHash != payload.payloadHash:
        return Err[bool]("finance env: simulation result payload hash mismatch")
    if receipt.simulation.calldataHash != payload.calldataHash:
        return Err[bool]("finance env: simulation calldata hash mismatch")
    if receipt.receiptHash != FinanceSimulationReceiptHash(receipt):
        return Err[bool]("finance env: simulation receipt hash mismatch")
    return Ok[bool](true)

@borrows
fn FinanceValidateSignerSession(policy: cert.FinancePolicy, session: FinanceSignerSession): Result[bool] =
    if session.id.len <= 0:
        return Err[bool]("finance env: missing signer session id")
    if session.signerKind != policy.signerRequirement:
        return Err[bool]("finance env: signer session kind differs from policy")
    if !cert.FinanceRiskSignerRequirementValid(policy.riskLevel, session.signerKind):
        return Err[bool]("finance env: signer session does not satisfy risk policy")
    if session.signerId.len <= 0:
        return Err[bool]("finance env: missing signer id")
    if IsErr(envRequireHash(session.deviceBindingHash, "signerSession.deviceBindingHash")):
        return Err[bool]("finance env: invalid signer device binding hash")
    if IsErr(envRequireHash(session.sessionPolicyHash, "signerSession.sessionPolicyHash")):
        return Err[bool]("finance env: invalid signer session policy hash")
    if IsErr(envRequireHash(session.attestationHash, "signerSession.attestationHash")):
        return Err[bool]("finance env: invalid signer attestation hash")
    if session.expiresAtBlock < policy.validUntilBlock:
        return Err[bool]("finance env: signer session expires before transaction")
    if session.keyExportable:
        return Err[bool]("finance env: signer key is exportable")
    if session.aiProcessAccessible:
        return Err[bool]("finance env: signer is accessible to AI process")
    if session.signerKind != cert.FinanceSignerMultisig && !session.hardwareBacked:
        return Err[bool]("finance env: signer must be hardware-backed")
    return Ok[bool](true)

@borrows
fn FinanceValidateExecutionSubstrate(substrate: FinanceExecutionSubstrate,
                                     session: FinanceSignerSession): Result[bool] =
    if substrate.id.len <= 0:
        return Err[bool]("finance env: missing execution substrate id")
    if substrate.substrateKind != FinanceEnvSubstrateChengCsgTransactionOs:
        return Err[bool]("finance env: execution substrate must be Cheng CSG transaction OS")
    if IsErr(envRequireHash(substrate.osIdentityHash, "executionSubstrate.osIdentityHash")):
        return Err[bool]("finance env: invalid substrate OS identity hash")
    if IsErr(envRequireHash(substrate.kernelCapabilityHash, "executionSubstrate.kernelCapabilityHash")):
        return Err[bool]("finance env: invalid substrate kernel capability hash")
    if IsErr(envRequireHash(substrate.processIsolationHash, "executionSubstrate.processIsolationHash")):
        return Err[bool]("finance env: invalid substrate process isolation hash")
    if IsErr(envRequireHash(substrate.signerIsolationHash, "executionSubstrate.signerIsolationHash")):
        return Err[bool]("finance env: invalid substrate signer isolation hash")
    if IsErr(envRequireHash(substrate.memoryPolicyHash, "executionSubstrate.memoryPolicyHash")):
        return Err[bool]("finance env: invalid substrate memory policy hash")
    if IsErr(envRequireHash(substrate.networkPolicyHash, "executionSubstrate.networkPolicyHash")):
        return Err[bool]("finance env: invalid substrate network policy hash")
    if IsErr(envRequireHash(substrate.uiTrustedPathHash, "executionSubstrate.uiTrustedPathHash")):
        return Err[bool]("finance env: invalid substrate UI trusted path hash")
    if IsErr(envRequireHash(substrate.deviceAttestationHash, "executionSubstrate.deviceAttestationHash")):
        return Err[bool]("finance env: invalid substrate device attestation hash")
    if IsErr(envRequireHash(substrate.csgMeasurementHash, "executionSubstrate.csgMeasurementHash")):
        return Err[bool]("finance env: invalid substrate CSG measurement hash")
    if !substrate.chengCsgKernel:
        return Err[bool]("finance env: execution substrate is not Cheng CSG kernel")
    if !substrate.capabilityRuntime:
        return Err[bool]("finance env: execution substrate is not capability runtime")
    if !substrate.deterministicSyscalls:
        return Err[bool]("finance env: execution substrate syscalls are not deterministic")
    if !substrate.signerIsolated:
        return Err[bool]("finance env: signer is not isolated by substrate")
    if !substrate.aiProcessIsolated:
        return Err[bool]("finance env: AI process is not isolated by substrate")
    if !substrate.uiTrustedPath:
        return Err[bool]("finance env: UI trusted path is not proven by substrate")
    if !substrate.networkPinned:
        return Err[bool]("finance env: network policy is not pinned by substrate")
    if !substrate.noDynamicCodeLoading:
        return Err[bool]("finance env: substrate allows dynamic code loading")
    if !substrate.noVisualTransactionPath:
        return Err[bool]("finance env: substrate allows visual transaction path")
    if !substrate.noClipboardTransactionPath:
        return Err[bool]("finance env: substrate allows clipboard transaction path")
    if session.deviceBindingHash != substrate.deviceAttestationHash:
        return Err[bool]("finance env: signer device binding is not bound to substrate")
    if session.attestationHash != substrate.signerIsolationHash:
        return Err[bool]("finance env: signer attestation is not bound to substrate isolation")
    if substrate.receiptHash != FinanceExecutionSubstrateHash(substrate):
        return Err[bool]("finance env: execution substrate receipt hash mismatch")
    return Ok[bool](true)

@borrows
fn FinanceBuildCompileInput(env: FinanceProductionTransactionEnvironment): Result[cert.FinanceCompileInput] =
    let actionRes = FinanceValidateTypedAction(share(env.typedAction))
    if IsErr(actionRes):
        let actionError = Error(actionRes)
        return Err[cert.FinanceCompileInput](actionError)
    let policyRes = FinanceValidatePolicyReceipt(share(env.typedAction), share(env.policyReceipt))
    if IsErr(policyRes):
        let policyError = Error(policyRes)
        return Err[cert.FinanceCompileInput](policyError)
    let stateRes = FinanceValidateStateReceipt(share(env.typedAction), share(env.policyReceipt.policy), share(env.stateReceipt))
    if IsErr(stateRes):
        let stateError = Error(stateRes)
        return Err[cert.FinanceCompileInput](stateError)
    let contractRes = FinanceValidateContractEntry(share(env.typedAction), share(env.policyReceipt.policy), share(env.contractEntry))
    if IsErr(contractRes):
        let contractError = Error(contractRes)
        return Err[cert.FinanceCompileInput](contractError)

    let typedActionHash = FinanceTypedActionHash(share(env.typedAction))
    let policyHash = cert.FinancePolicyHash(share(env.policyReceipt.policy))
    let stateSnapshotHash = cert.FinanceStateSnapshotHash(share(env.stateReceipt.snapshot))
    let contractProfileHash = cert.FinanceContractProfileHash(share(env.contractEntry.profile))
    let payloadRes = FinanceValidatePayloadReceipt(typedActionHash, policyHash, stateSnapshotHash, contractProfileHash, share(env.payloadReceipt))
    if IsErr(payloadRes):
        let payloadError = Error(payloadRes)
        return Err[cert.FinanceCompileInput](payloadError)
    let simulationRes = FinanceValidateSimulationReceipt(stateSnapshotHash, contractProfileHash, share(env.payloadReceipt.payload), share(env.simulationReceipt))
    if IsErr(simulationRes):
        let simulationError = Error(simulationRes)
        return Err[cert.FinanceCompileInput](simulationError)
    let signerRes = FinanceValidateSignerSession(share(env.policyReceipt.policy), share(env.signerSession))
    if IsErr(signerRes):
        let signerError = Error(signerRes)
        return Err[cert.FinanceCompileInput](signerError)
    let substrateRes = FinanceValidateExecutionSubstrate(env.executionSubstrate, env.signerSession)
    if IsErr(substrateRes):
        let substrateError = Error(substrateRes)
        return Err[cert.FinanceCompileInput](substrateError)

    var compileInput: cert.FinanceCompileInput
    compileInput.intent = FinanceIntentFromTypedAction(env.typedAction)
    compileInput.policy = env.policyReceipt.policy
    compileInput.stateSnapshot = env.stateReceipt.snapshot
    compileInput.contractProfile = env.contractEntry.profile
    compileInput.simulation = env.simulationReceipt.simulation
    compileInput.payload = env.payloadReceipt.payload
    return Ok[cert.FinanceCompileInput](compileInput)

@borrows
fn FinanceCompileExecutionEnvelope(env: FinanceProductionTransactionEnvironment): Result[FinanceExecutionEnvelope] =
    let inputRes = FinanceBuildCompileInput(env)
    if IsErr(inputRes):
        let inputError = Error(inputRes)
        return Err[FinanceExecutionEnvelope](inputError)
    let input = Value(inputRes)
    let certRes = cert.FinanceCompileCertifiedTransaction(input)
    if IsErr(certRes):
        let certError = Error(certRes)
        return Err[FinanceExecutionEnvelope](certError)
    let certified = Value(certRes)
    let authRes = cert.FinanceSignerGateAuthorize(share(certified), env.signerSession.signerKind, input.payload)
    if IsErr(authRes):
        let authError = Error(authRes)
        return Err[FinanceExecutionEnvelope](authError)
    let authorization = Value(authRes)
    var envelope: FinanceExecutionEnvelope
    envelope.environmentHash = FinanceProductionEnvironmentHash(env)
    envelope.executionSubstrateHash = FinanceExecutionSubstrateHash(env.executionSubstrate)
    envelope.compileInput = input
    envelope.certified = certified
    envelope.authorization = authorization
    envelope.requiredSignerKind = env.signerSession.signerKind
    envelope.requiredSignerId = env.signerSession.signerId
    envelope.auditTrace = envCat(envCat(FinanceProductionEnvironmentPreimage(env), "\n"), certified.auditTrace)
    return Ok[FinanceExecutionEnvelope](envelope)

@borrows
fn FinanceSignedTransactionReceiptPreimage(receipt: FinanceSignedTransactionReceipt): str =
    var lines: str[]
    envAddLine(lines, "schema", cert.FinanceDialectVersion)
    envAddLine(lines, "kind", "signed_transaction")
    envAddLine(lines, "id", receipt.id)
    envAddLine(lines, "signerKind", receipt.signerKind)
    envAddLine(lines, "signerId", receipt.signerId)
    envAddLine(lines, "environmentHash", receipt.environmentHash)
    envAddLine(lines, "executionSubstrateHash", receipt.executionSubstrateHash)
    envAddLine(lines, "certifiedHash", receipt.certifiedHash)
    envAddLine(lines, "payloadHash", receipt.payloadHash)
    envAddLine(lines, "authorizationHash", receipt.authorizationHash)
    envAddLine(lines, "signedTransactionHash", receipt.signedTransactionHash)
    envAddLine(lines, "signatureScheme", receipt.signatureScheme)
    envAddLine(lines, "signerBoundary", receipt.signerBoundary)
    envAddLine(lines, "keyExportable", envBool(receipt.keyExportable))
    envAddLine(lines, "aiProcessAccessible", envBool(receipt.aiProcessAccessible))
    return envJoin(lines)

@borrows
fn FinanceSignedTransactionReceiptHash(receipt: FinanceSignedTransactionReceipt): str =
    return envSha256(FinanceSignedTransactionReceiptPreimage(receipt))

@borrows
fn FinanceBroadcastRequestPreimage(request: FinanceBroadcastRequest): str =
    var lines: str[]
    envAddLine(lines, "schema", cert.FinanceDialectVersion)
    envAddLine(lines, "kind", "broadcast_request")
    envAddLine(lines, "chainId", envI64(request.chainId))
    envAddLine(lines, "environmentHash", request.environmentHash)
    envAddLine(lines, "executionSubstrateHash", request.executionSubstrateHash)
    envAddLine(lines, "certifiedHash", request.certifiedHash)
    envAddLine(lines, "payloadHash", request.payloadHash)
    envAddLine(lines, "authorizationHash", request.authorizationHash)
    envAddLine(lines, "signedTransactionHash", request.signedTransactionHash)
    envAddLine(lines, "chainAdapterId", request.chainAdapterId)
    envAddLine(lines, "chainAdapterVersionHash", request.chainAdapterVersionHash)
    envAddLine(lines, "maxSubmitBlock", envI64(request.maxSubmitBlock))
    envAddLine(lines, "broadcastPolicyHash", request.broadcastPolicyHash)
    return envJoin(lines)

@borrows
fn FinanceBroadcastRequestHash(request: FinanceBroadcastRequest): str =
    return envSha256(FinanceBroadcastRequestPreimage(request))

fn FinanceBuildBroadcastRequest(envelope: FinanceExecutionEnvelope,
                                signed: FinanceSignedTransactionReceipt,
                                adapter: FinanceChainAdapterProfile,
                                maxSubmitBlock: int64): Result[FinanceBroadcastRequest] =
    if signed.id.len <= 0:
        return Err[FinanceBroadcastRequest]("finance env: missing signed transaction receipt id")
    if signed.signerKind != envelope.requiredSignerKind:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction signer kind mismatch")
    if signed.signerId != envelope.requiredSignerId:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction signer id mismatch")
    if signed.environmentHash != envelope.environmentHash:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction environment hash mismatch")
    if signed.executionSubstrateHash != envelope.executionSubstrateHash:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction substrate hash mismatch")
    if signed.certifiedHash != envelope.certified.certifiedHash:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction certified hash mismatch")
    if signed.payloadHash != envelope.certified.payloadHash:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction payload hash mismatch")
    if signed.authorizationHash != envelope.authorization.authorizationHash:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction authorization hash mismatch")
    if IsErr(envRequireHash(signed.signedTransactionHash, "signedTransaction.signedTransactionHash")):
        return Err[FinanceBroadcastRequest]("finance env: invalid signed transaction hash")
    if signed.signatureScheme != cert.FinanceExecutionSignatureChainNative:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction must use chain-native signature")
    if signed.signerBoundary != FinanceEnvSignerBoundaryIsolated:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction boundary is not isolated")
    if signed.keyExportable:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction used exportable key")
    if signed.aiProcessAccessible:
        return Err[FinanceBroadcastRequest]("finance env: signed transaction signer was AI-accessible")

    if adapter.id.len <= 0:
        return Err[FinanceBroadcastRequest]("finance env: missing chain adapter id")
    if !adapter.trustedAdapter:
        return Err[FinanceBroadcastRequest]("finance env: chain adapter is not trusted")
    if adapter.visualPath:
        return Err[FinanceBroadcastRequest]("finance env: chain adapter cannot use visual path")
    if adapter.adapterKind != FinanceEnvChainAdapterNative:
        return Err[FinanceBroadcastRequest]("finance env: chain adapter must be chain-native")
    if adapter.chainId != envelope.compileInput.payload.chainId:
        return Err[FinanceBroadcastRequest]("finance env: chain adapter chain mismatch")
    if adapter.supportedSignatureScheme != cert.FinanceExecutionSignatureChainNative:
        return Err[FinanceBroadcastRequest]("finance env: chain adapter signature scheme mismatch")
    if IsErr(envRequireHash(adapter.adapterVersionHash, "chainAdapter.adapterVersionHash")):
        return Err[FinanceBroadcastRequest]("finance env: invalid chain adapter version hash")
    if IsErr(envRequireHash(adapter.broadcastPolicyHash, "chainAdapter.broadcastPolicyHash")):
        return Err[FinanceBroadcastRequest]("finance env: invalid broadcast policy hash")
    if maxSubmitBlock <= int64(0) || maxSubmitBlock > envelope.certified.validUntilBlock:
        return Err[FinanceBroadcastRequest]("finance env: max submit block exceeds certified validity")

    var request: FinanceBroadcastRequest
    request.chainId = adapter.chainId
    request.environmentHash = envelope.environmentHash
    request.executionSubstrateHash = envelope.executionSubstrateHash
    request.certifiedHash = envelope.certified.certifiedHash
    request.payloadHash = envelope.certified.payloadHash
    request.authorizationHash = envelope.authorization.authorizationHash
    request.signedTransactionHash = signed.signedTransactionHash
    request.chainAdapterId = adapter.id
    request.chainAdapterVersionHash = adapter.adapterVersionHash
    request.maxSubmitBlock = maxSubmitBlock
    request.broadcastPolicyHash = adapter.broadcastPolicyHash
    request.requestHash = FinanceBroadcastRequestHash(request)
    request.id = envCat("broadcast:", request.requestHash)
    return Ok[FinanceBroadcastRequest](request)
