fn FinanceStateSnapshotPreimage(snapshot: FinanceStateSnapshot): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "state_snapshot")
    financeAddLine(lines, "id", snapshot.id)
    financeAddLine(lines, "chainId", financeI64(snapshot.chainId))
    financeAddLine(lines, "account", snapshot.account)
    financeAddLine(lines, "blockNumber", financeI64(snapshot.blockNumber))
    financeAddLine(lines, "nonce", financeI64(snapshot.nonce))
    financeAddLine(lines, "balance", financeI64(snapshot.balance))
    financeAddLine(lines, "allowance", financeI64(snapshot.allowance))
    financeAddLine(lines, "price", financeI64(snapshot.price))
    financeAddLine(lines, "stateReadsHash", snapshot.stateReadsHash)
    return financeJoin(lines)

@borrows
fn FinanceContractProfilePreimage(profile: FinanceContractProfile): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "contract_profile")
    financeAddLine(lines, "id", profile.id)
    financeAddLine(lines, "chainId", financeI64(profile.chainId))
    financeAddLine(lines, "contractAddress", profile.contractAddress)
    financeAddLine(lines, "selector", profile.selector)
    financeAddLine(lines, "selectorName", profile.selectorName)
    financeAddLine(lines, "abiHash", profile.abiHash)
    financeAddLine(lines, "knownContract", financeBool(profile.knownContract))
    financeAddLine(lines, "unknownCall", financeBool(profile.unknownCall))
    financeAddLine(lines, "containsDelegatecall", financeBool(profile.containsDelegatecall))
    financeAddLine(lines, "approveAll", financeBool(profile.approveAll))
    financeAddLine(lines, "supportsSimulation", financeBool(profile.supportsSimulation))
    return financeJoin(lines)

@borrows
fn FinanceSimulationPreimage(simulation: FinanceSimulationResult): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "simulation_result")
    financeAddLine(lines, "id", simulation.id)
    financeAddLine(lines, "ok", financeBool(simulation.ok))
