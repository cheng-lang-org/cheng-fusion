    financeAddLine(lines, "stateReadsHash", simulation.stateReadsHash)
    financeAddLine(lines, "outputAsset", simulation.outputAsset)
    financeAddLine(lines, "outputAmount", financeI64(simulation.outputAmount))
    financeAddLine(lines, "maxLossAmount", financeI64(simulation.maxLossAmount))
    financeAddLine(lines, "error", simulation.error)
    return financeJoin(lines)

@borrows
fn FinancePayloadPreimage(payload: FinanceSigningPayload): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "signing_payload")
    financeAddLine(lines, "id", payload.id)
    financeAddLine(lines, "chainId", financeI64(payload.chainId))
    financeAddLine(lines, "contractAddress", payload.contractAddress)
    financeAddLine(lines, "selector", payload.selector)
    financeAddLine(lines, "calldataHash", payload.calldataHash)
    financeAddLine(lines, "payloadHash", payload.payloadHash)
    financeAddLine(lines, "intentHash", payload.intentHash)
    financeAddLine(lines, "policyHash", payload.policyHash)
    financeAddLine(lines, "stateSnapshotHash", payload.stateSnapshotHash)
    financeAddLine(lines, "contractProfileHash", payload.contractProfileHash)
    financeAddLine(lines, "validUntilBlock", financeI64(payload.validUntilBlock))
    financeAddLine(lines, "maxSlippageBps", financeI32(payload.maxSlippageBps))
    financeAddLine(lines, "stateReadsHash", payload.stateReadsHash)
    financeAddLine(lines, "nonce", financeI64(payload.nonce))
    return financeJoin(lines)

@borrows
fn FinanceIntentHash(intent: FinanceIntent): str =
    return financeSha256(FinanceIntentPreimage(intent))

@borrows
fn FinancePolicyHash(policy: FinancePolicy): str =
    return financeSha256(FinancePolicyPreimage(policy))

@borrows
fn FinanceStateSnapshotHash(snapshot: FinanceStateSnapshot): str =
    return financeSha256(FinanceStateSnapshotPreimage(snapshot))

@borrows
fn FinanceContractProfileHash(profile: FinanceContractProfile): str =
    return financeSha256(FinanceContractProfilePreimage(profile))

@borrows
fn FinanceSimulationHash(simulation: FinanceSimulationResult): str =
    return financeSha256(FinanceSimulationPreimage(simulation))

@borrows
fn FinancePayloadDeclaredHash(payload: FinanceSigningPayload): str =
    return financeSha256(FinancePayloadPreimage(payload))

@borrows
fn FinanceCertifiedPreimage(cert: FinanceCertifiedTransaction): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "certified_transaction")
    financeAddLine(lines, "complete", financeBool(cert.complete))
    financeAddLine(lines, "actionKind", cert.actionKind)
    financeAddLine(lines, "riskLevel", cert.riskLevel)
    financeAddLine(lines, "signerRequirement", cert.signerRequirement)
    financeAddLine(lines, "intentHash", cert.intentHash)
    financeAddLine(lines, "policyHash", cert.policyHash)
    financeAddLine(lines, "stateSnapshotHash", cert.stateSnapshotHash)
    financeAddLine(lines, "contractProfileHash", cert.contractProfileHash)
    financeAddLine(lines, "simulationHash", cert.simulationHash)
    financeAddLine(lines, "payloadHash", cert.payloadHash)
    financeAddLine(lines, "calldataHash", cert.calldataHash)
    financeAddLine(lines, "stateReadsHash", cert.stateReadsHash)
    financeAddLine(lines, "validUntilBlock", financeI64(cert.validUntilBlock))
    financeAddLine(lines, "maxSlippageBps", financeI32(cert.maxSlippageBps))
    return financeJoin(lines)

@borrows
fn FinanceCertifiedHash(cert: FinanceCertifiedTransaction): str =
    return financeSha256(FinanceCertifiedPreimage(cert))

fn FinanceAuditTrace(cert: FinanceCertifiedTransaction): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "audit_trace")
    financeAddLine(lines, "certifiedHash", cert.certifiedHash)
    financeAddLine(lines, "intentHash", cert.intentHash)
    financeAddLine(lines, "policyHash", cert.policyHash)
    financeAddLine(lines, "stateSnapshotHash", cert.stateSnapshotHash)
    financeAddLine(lines, "contractProfileHash", cert.contractProfileHash)
    financeAddLine(lines, "simulationHash", cert.simulationHash)
    financeAddLine(lines, "payloadHash", cert.payloadHash)
    financeAddLine(lines, "signerRequirement", cert.signerRequirement)
    financeAddLine(lines, "riskLevel", cert.riskLevel)
    return financeJoin(lines)

@borrows
fn financeRequiresAllowance(actionKind: str): bool =
    if actionKind == FinanceActionRwadLimitOrder:
        return true
    if actionKind == FinanceActionDexLimitOrder:
        return true
    return false

@borrows
fn FinanceValidateCompileInput(input: FinanceCompileInput,
                               intentHash: str,
                               policyHash: str,
                               stateSnapshotHash: str,
                               contractProfileHash: str): Result[bool] =
    if input.intent.id.len <= 0:
        return Err[bool]("finance: missing intent id")
    if input.intent.userId.len <= 0:
        return Err[bool]("finance: missing intent user")
    if input.intent.sourceKind != FinanceSourceUserIntent:
        return Err[bool]("finance: AI proposal or non-user source cannot compile transaction")
    if !input.intent.userAuthorized:
        return Err[bool]("finance: user intent is not authorized")
    if IsErr(financeRequireHash(input.intent.sourceIntentHash, "intent.sourceIntentHash")):
        return Err[bool]("finance: invalid source intent hash")
    if !FinanceActionAllowed(input.intent.actionKind):
        return Err[bool]("finance: unsupported action kind")
    if input.intent.actionKind == FinanceActionCancelOrder:
        if input.intent.amount < int64(0):
            return Err[bool]("finance: cancel amount cannot be negative")
    elif input.intent.amount <= int64(0):
        return Err[bool]("finance: amount must be positive")
    if input.intent.recipientIdentity.len <= 0:
        return Err[bool]("finance: missing recipient identity")
    if input.intent.recipientAddress.len <= 0:
        return Err[bool]("finance: missing recipient address")

    if input.policy.id.len <= 0:
        return Err[bool]("finance: missing policy id")
    if input.policy.maxAmount <= int64(0):
        return Err[bool]("finance: policy max amount must be positive")
    if input.intent.amount > input.policy.maxAmount:
        return Err[bool]("finance: amount exceeds policy max")
    if input.intent.chainId != input.policy.allowedChainId:
        return Err[bool]("finance: intent chain differs from policy")
    if input.intent.asset != input.policy.allowedAsset:
        return Err[bool]("finance: intent asset differs from policy")
    if input.intent.recipientIdentity != input.policy.allowedRecipientIdentity:
        return Err[bool]("finance: recipient identity differs from policy")
    if input.intent.recipientAddress != input.policy.allowedRecipientAddress:
        return Err[bool]("finance: recipient address differs from policy")
    if input.policy.allowedContract.len <= 0:
        return Err[bool]("finance: policy missing allowed contract")
    if input.policy.allowedSelector.len <= 0:
        return Err[bool]("finance: policy missing allowed selector")
    if input.policy.validUntilBlock <= int64(0):
        return Err[bool]("finance: policy missing valid_until block")
    if input.policy.maxSlippageBps < 0:
        return Err[bool]("finance: negative slippage is invalid")
    if !FinanceRiskSignerRequirementValid(input.policy.riskLevel, input.policy.signerRequirement):
        return Err[bool]("finance: signer requirement does not match risk level")
    if input.policy.allowUnknownContract:
        return Err[bool]("finance: v1 does not allow unknown contracts")
    if input.policy.policyAuthorizationScheme != FinancePolicyAuthClassicalMlDsa:
        return Err[bool]("finance: policy authorization must use classical+ml-dsa")
    if input.policy.rootAuthorizationScheme != FinanceRootAuthSlhDsa:
        return Err[bool]("finance: root authorization must use slh-dsa")
    if input.policy.executionSignatureScheme != FinanceExecutionSignatureChainNative:
        return Err[bool]("finance: v1 execution signature must stay chain-native")

    if input.stateSnapshot.id.len <= 0:
        return Err[bool]("finance: missing state snapshot id")
    if input.stateSnapshot.chainId != input.intent.chainId:
        return Err[bool]("finance: state chain differs from intent")
    if input.stateSnapshot.account.len <= 0:
        return Err[bool]("finance: missing state account")
    if input.stateSnapshot.blockNumber > input.policy.validUntilBlock:
        return Err[bool]("finance: state snapshot is past valid_until block")
    if input.stateSnapshot.balance < input.intent.amount:
        return Err[bool]("finance: insufficient balance in state snapshot")
    if financeRequiresAllowance(input.intent.actionKind) && input.stateSnapshot.allowance < input.intent.amount:
        return Err[bool]("finance: insufficient allowance in state snapshot")
    if IsErr(financeRequireHash(input.stateSnapshot.stateReadsHash, "state.stateReadsHash")):
        return Err[bool]("finance: invalid state reads hash")

    if input.contractProfile.id.len <= 0:
        return Err[bool]("finance: missing contract profile id")
    if input.contractProfile.chainId != input.intent.chainId:
        return Err[bool]("finance: contract chain differs from intent")
    if input.contractProfile.contractAddress != input.policy.allowedContract:
        return Err[bool]("finance: contract address differs from policy")
    if input.contractProfile.selector != input.policy.allowedSelector:
        return Err[bool]("finance: selector differs from policy")
    if !input.contractProfile.knownContract:
        return Err[bool]("finance: unknown contract")
    if input.contractProfile.unknownCall:
        return Err[bool]("finance: unknown call")
    if input.contractProfile.approveAll && input.policy.forbidApproveAll:
        return Err[bool]("finance: approve all is forbidden")
    if input.contractProfile.containsDelegatecall && input.policy.forbidDelegatecall:
        return Err[bool]("finance: delegatecall is forbidden")
    if !input.contractProfile.supportsSimulation:
        return Err[bool]("finance: contract cannot be simulated")
    if IsErr(financeRequireHash(input.contractProfile.abiHash, "contract.abiHash")):
        return Err[bool]("finance: invalid contract abi hash")

    if input.simulation.id.len <= 0:
        return Err[bool]("finance: missing simulation id")
    if !input.simulation.ok:
        return Err[bool]("finance: simulation failed")
    if input.simulation.payloadHash != input.payload.payloadHash:
        return Err[bool]("finance: simulation payload hash differs from payload")
    if input.simulation.calldataHash != input.payload.calldataHash:
        return Err[bool]("finance: simulation calldata hash differs from payload")
    if input.simulation.stateReadsHash != input.stateSnapshot.stateReadsHash:
        return Err[bool]("finance: simulation state reads hash differs from state")
    if input.simulation.maxLossAmount > input.policy.maxAmount:
        return Err[bool]("finance: simulation max loss exceeds policy")
    if IsErr(financeRequireHash(input.simulation.payloadHash, "simulation.payloadHash")):
        return Err[bool]("finance: invalid simulation payload hash")
    if IsErr(financeRequireHash(input.simulation.calldataHash, "simulation.calldataHash")):
        return Err[bool]("finance: invalid simulation calldata hash")

    if input.payload.id.len <= 0:
        return Err[bool]("finance: missing signing payload id")
    if input.payload.chainId != input.intent.chainId:
        return Err[bool]("finance: payload chain differs from intent")
    if input.payload.contractAddress != input.policy.allowedContract:
        return Err[bool]("finance: payload contract differs from policy")
    if input.payload.selector != input.policy.allowedSelector:
        return Err[bool]("finance: payload selector differs from policy")
    if input.payload.intentHash != intentHash:
        return Err[bool]("finance: payload intent hash differs from compiled intent")
    if input.payload.policyHash != policyHash:
        return Err[bool]("finance: payload policy hash differs from compiled policy")
    if input.payload.stateSnapshotHash != stateSnapshotHash:
        return Err[bool]("finance: payload state snapshot hash differs from compiled state")
    if input.payload.contractProfileHash != contractProfileHash:
        return Err[bool]("finance: payload contract profile hash differs from compiled contract")
    if input.payload.validUntilBlock != input.policy.validUntilBlock:
        return Err[bool]("finance: payload valid_until block differs from policy")
    if input.payload.maxSlippageBps != input.policy.maxSlippageBps:
        return Err[bool]("finance: payload slippage differs from policy")
    if input.payload.stateReadsHash != input.stateSnapshot.stateReadsHash:
        return Err[bool]("finance: payload state reads hash differs from state")
    if input.payload.nonce != input.stateSnapshot.nonce:
        return Err[bool]("finance: payload nonce differs from state")
    if IsErr(financeRequireHash(input.payload.payloadHash, "payload.payloadHash")):
        return Err[bool]("finance: invalid payload hash")
    if IsErr(financeRequireHash(input.payload.calldataHash, "payload.calldataHash")):
        return Err[bool]("finance: invalid calldata hash")

    return Ok[bool](true)

@borrows
fn FinanceCompileCertifiedTransaction(input: FinanceCompileInput): Result[FinanceCertifiedTransaction] =
    let intentHash = FinanceIntentHash(input.intent)
    let policyHash = FinancePolicyHash(input.policy)
    let stateSnapshotHash = FinanceStateSnapshotHash(input.stateSnapshot)
    let contractProfileHash = FinanceContractProfileHash(input.contractProfile)
    let validateRes = FinanceValidateCompileInput(input, intentHash, policyHash, stateSnapshotHash, contractProfileHash)
    if IsErr(validateRes):
        let validateError = Error(validateRes)
        return Err[FinanceCertifiedTransaction](validateError)

    var cert: FinanceCertifiedTransaction
    cert.complete = true
    cert.actionKind = input.intent.actionKind
    cert.riskLevel = input.policy.riskLevel
    cert.signerRequirement = input.policy.signerRequirement
    cert.intentHash = intentHash
    cert.policyHash = policyHash
    cert.stateSnapshotHash = stateSnapshotHash
    cert.contractProfileHash = contractProfileHash
    cert.simulationHash = FinanceSimulationHash(input.simulation)
    cert.payloadHash = input.payload.payloadHash
    cert.calldataHash = input.payload.calldataHash
    cert.stateReadsHash = input.stateSnapshot.stateReadsHash
    cert.validUntilBlock = input.policy.validUntilBlock
    cert.maxSlippageBps = input.policy.maxSlippageBps
    cert.certifiedHash = FinanceCertifiedHash(share(cert))
    cert.id = financeCat("cert:", cert.certifiedHash)
    cert.auditTrace = FinanceAuditTrace(share(cert))
    return Ok[FinanceCertifiedTransaction](cert)

@borrows
fn FinanceSignerGateAuthorize(cert: FinanceCertifiedTransaction,
                              signerKind: str,
                              payload: FinanceSigningPayload): Result[FinanceSignerAuthorization] =
    if !cert.complete:
        return Err[FinanceSignerAuthorization]("finance signer gate: certified transaction is incomplete")
    if !FinanceRiskSignerRequirementValid(cert.riskLevel, cert.signerRequirement):
        return Err[FinanceSignerAuthorization]("finance signer gate: invalid certified risk/signer policy")
    if signerKind != cert.signerRequirement:
        return Err[FinanceSignerAuthorization]("finance signer gate: signer kind does not satisfy certified policy")
    if payload.payloadHash != cert.payloadHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: payload hash mismatch")
    if payload.policyHash != cert.policyHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: policy hash mismatch")
    if payload.stateSnapshotHash != cert.stateSnapshotHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: state snapshot hash mismatch")
    if payload.contractProfileHash != cert.contractProfileHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: contract profile hash mismatch")
    if payload.intentHash != cert.intentHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: intent hash mismatch")
    if payload.calldataHash != cert.calldataHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: calldata hash mismatch")
    if payload.stateReadsHash != cert.stateReadsHash:
        return Err[FinanceSignerAuthorization]("finance signer gate: state reads hash mismatch")
    if payload.validUntilBlock != cert.validUntilBlock:
        return Err[FinanceSignerAuthorization]("finance signer gate: valid_until mismatch")
    if payload.maxSlippageBps != cert.maxSlippageBps:
        return Err[FinanceSignerAuthorization]("finance signer gate: slippage mismatch")

    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "signer_authorization")
    financeAddLine(lines, "signerKind", signerKind)
    financeAddLine(lines, "certifiedHash", cert.certifiedHash)
    financeAddLine(lines, "payloadHash", payload.payloadHash)
    let authorizationHash = financeSha256(financeJoin(lines))

    var auth: FinanceSignerAuthorization
    auth.authorized = true
    auth.signerKind = signerKind
    auth.certifiedHash = cert.certifiedHash
    auth.payloadHash = payload.payloadHash
    auth.authorizationHash = authorizationHash
    auth.signerBoundary = "isolated-signer"
    return Ok[FinanceSignerAuthorization](auth)
