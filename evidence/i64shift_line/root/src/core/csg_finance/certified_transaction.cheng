import std/result
import std/rawbytes
import std/crypto/sha256
import std/strings
import std/strutils as strutil

const
    FinanceDialectProfile = "csg_dialect::finance"
    FinanceDialectVersion = "csg_dialect::finance::v1"

    FinanceSourceUserIntent = "user_intent"

    FinanceActionInternalPayment = "internal_payment"
    FinanceActionContentPurchase = "content_purchase"
    FinanceActionRwadLimitOrder = "rwad_limit_order"
    FinanceActionDexLimitOrder = "dex_limit_order"
    FinanceActionCancelOrder = "cancel_order"
    FinanceActionEscrowSettlement = "escrow_settlement"

    FinanceRiskLow = "low"
    FinanceRiskMedium = "medium"
    FinanceRiskHigh = "high"

    FinanceSignerSession = "session"
    FinanceSignerPasskey = "passkey"
    FinanceSignerHardware = "hardware"
    FinanceSignerMultisig = "multisig"

    FinancePolicyAuthClassicalMlDsa = "classical+ml-dsa"
    FinanceRootAuthSlhDsa = "slh-dsa"
    FinanceExecutionSignatureChainNative = "chain-native"

type
    FinanceIntent =
        id: str
        userId: str
        sourceKind: str
        sourceIntentHash: str
        actionKind: str
        chainId: int64
        asset: str
        amount: int64
        recipientIdentity: str
        recipientAddress: str
        userAuthorized: bool

    FinancePolicy =
        id: str
        maxAmount: int64
        allowedChainId: int64
        allowedAsset: str
        allowedRecipientIdentity: str
        allowedRecipientAddress: str
        allowedContract: str
        allowedSelector: str
        validUntilBlock: int64
        maxSlippageBps: int32
        riskLevel: str
        signerRequirement: str
        forbidApproveAll: bool
        forbidDelegatecall: bool
        allowUnknownContract: bool
        policyAuthorizationScheme: str
        rootAuthorizationScheme: str
        executionSignatureScheme: str

    FinanceStateSnapshot =
        id: str
        chainId: int64
        account: str
        blockNumber: int64
        nonce: int64
        balance: int64
        allowance: int64
        price: int64
        stateReadsHash: str

    FinanceContractProfile =
        id: str
        chainId: int64
        contractAddress: str
        selector: str
        selectorName: str
        abiHash: str
        knownContract: bool
        unknownCall: bool
        containsDelegatecall: bool
        approveAll: bool
        supportsSimulation: bool

    FinanceSimulationResult =
        id: str
        ok: bool
        payloadHash: str
        calldataHash: str
        stateReadsHash: str
        outputAsset: str
        outputAmount: int64
        maxLossAmount: int64
        error: str

    FinanceSigningPayload =
        id: str
        chainId: int64
        contractAddress: str
        selector: str
        calldataHash: str
        payloadHash: str
        intentHash: str
        policyHash: str
        stateSnapshotHash: str
        contractProfileHash: str
        validUntilBlock: int64
        maxSlippageBps: int32
        stateReadsHash: str
        nonce: int64

    FinanceCompileInput =
        intent: FinanceIntent
        policy: FinancePolicy
        stateSnapshot: FinanceStateSnapshot
        contractProfile: FinanceContractProfile
        simulation: FinanceSimulationResult
        payload: FinanceSigningPayload

    FinanceCertifiedTransaction =
        id: str
        complete: bool
        actionKind: str
        riskLevel: str
        signerRequirement: str
        intentHash: str
        policyHash: str
        stateSnapshotHash: str
        contractProfileHash: str
        simulationHash: str
        payloadHash: str
        calldataHash: str
        stateReadsHash: str
        validUntilBlock: int64
        maxSlippageBps: int32
        certifiedHash: str
        auditTrace: str

    FinanceSignerAuthorization =
        authorized: bool
        signerKind: str
        certifiedHash: str
        payloadHash: str
        authorizationHash: str
        signerBoundary: str

@borrows
fn financeCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn financeCat3(a: str, b: str, c: str): str =
    return financeCat(financeCat(a, b), c)

@borrows
fn financeLine(key: str, value: str): str =
    return financeCat3(key, "=", value)

fn financeBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn financeI32(value: int32): str =
    return strings.IntToStr(value)

fn financeI64(value: int64): str =
    return strings.Int64ToStr(value)

fn financeSha256(preimage: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(preimage))
    return financeCat("sha256:", rawbytes.BytesToHex(digest))

@borrows
fn financeHashOk(hashText: str): bool =
    if hashText.len <= 7:
        return false
    return strings.HasPrefix(hashText, "sha256:")

fn financeJoin(lines: str[]): str =
    return strutil.Join(lines, "\n")

@borrows
fn financeRequireHash(hashText: str, label: str): Result[bool] =
    if !financeHashOk(hashText):
        return Err[bool](financeCat("finance: invalid hash field ", label))
    return Ok[bool](true)

@borrows
fn financeAddLine(lines: var str[], key: str, value: str) =
    add(lines, financeLine(key, value))

@borrows
fn FinanceActionAllowed(actionKind: str): bool =
    if actionKind == FinanceActionInternalPayment:
        return true
    if actionKind == FinanceActionContentPurchase:
        return true
    if actionKind == FinanceActionRwadLimitOrder:
        return true
    if actionKind == FinanceActionDexLimitOrder:
        return true
    if actionKind == FinanceActionCancelOrder:
        return true
    if actionKind == FinanceActionEscrowSettlement:
        return true
    return false

@borrows
fn FinanceRiskSignerRequirementValid(riskLevel: str, signerRequirement: str): bool =
    if riskLevel == FinanceRiskLow:
        return signerRequirement == FinanceSignerSession
    if riskLevel == FinanceRiskMedium:
        return signerRequirement == FinanceSignerPasskey
    if riskLevel == FinanceRiskHigh:
        return signerRequirement == FinanceSignerHardware || signerRequirement == FinanceSignerMultisig
    return false

@borrows
fn FinanceIntentPreimage(intent: FinanceIntent): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "intent")
    financeAddLine(lines, "id", intent.id)
    financeAddLine(lines, "userId", intent.userId)
    financeAddLine(lines, "sourceKind", intent.sourceKind)
    financeAddLine(lines, "sourceIntentHash", intent.sourceIntentHash)
    financeAddLine(lines, "actionKind", intent.actionKind)
    financeAddLine(lines, "chainId", financeI64(intent.chainId))
    financeAddLine(lines, "asset", intent.asset)
    financeAddLine(lines, "amount", financeI64(intent.amount))
    financeAddLine(lines, "recipientIdentity", intent.recipientIdentity)
    financeAddLine(lines, "recipientAddress", intent.recipientAddress)
    financeAddLine(lines, "userAuthorized", financeBool(intent.userAuthorized))
    return financeJoin(lines)

@borrows
fn FinancePolicyPreimage(policy: FinancePolicy): str =
    var lines: str[]
    financeAddLine(lines, "schema", FinanceDialectVersion)
    financeAddLine(lines, "kind", "policy")
    financeAddLine(lines, "id", policy.id)
    financeAddLine(lines, "maxAmount", financeI64(policy.maxAmount))
    financeAddLine(lines, "allowedChainId", financeI64(policy.allowedChainId))
    financeAddLine(lines, "allowedAsset", policy.allowedAsset)
    financeAddLine(lines, "allowedRecipientIdentity", policy.allowedRecipientIdentity)
    financeAddLine(lines, "allowedRecipientAddress", policy.allowedRecipientAddress)
    financeAddLine(lines, "allowedContract", policy.allowedContract)
    financeAddLine(lines, "allowedSelector", policy.allowedSelector)
    financeAddLine(lines, "validUntilBlock", financeI64(policy.validUntilBlock))
    financeAddLine(lines, "maxSlippageBps", financeI32(policy.maxSlippageBps))
    financeAddLine(lines, "riskLevel", policy.riskLevel)
    financeAddLine(lines, "signerRequirement", policy.signerRequirement)
    financeAddLine(lines, "forbidApproveAll", financeBool(policy.forbidApproveAll))
    financeAddLine(lines, "forbidDelegatecall", financeBool(policy.forbidDelegatecall))
    financeAddLine(lines, "allowUnknownContract", financeBool(policy.allowUnknownContract))
    financeAddLine(lines, "policyAuthorizationScheme", policy.policyAuthorizationScheme)
    financeAddLine(lines, "rootAuthorizationScheme", policy.rootAuthorizationScheme)
    financeAddLine(lines, "executionSignatureScheme", policy.executionSignatureScheme)
    return financeJoin(lines)

