@borrows
fn CsgCompilerParserAnnotationIdentityCidInto(
        snapshot: CsgCompilerSnapshotTables,
        row: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let count = snapshot.parserSidecars.annotationProducerSourceIds.len
    if !csgCompilerIndexValid(row, count):
        err = " csg compiler snapshot: annotation identity row out of range"
        return false
    let source = snapshot.parserSidecars.annotationProducerSourceIds[row]
    let span = snapshot.parserSidecars.annotationSpanIds[row]
    let rootStart = snapshot.parserSidecars.annotationArgRootStarts[row]
    let rootCount = snapshot.parserSidecars.annotationArgRootCounts[row]
    if !csgCompilerIndexValid(
           source, snapshot.parserSidecars.sidecarCids.len) ||
       !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
       rootStart < 0 || rootCount < 0 ||
       rootStart > snapshot.parserSidecars.annotationArgRootIds.len ||
       rootCount >
           snapshot.parserSidecars.annotationArgRootIds.len - rootStart:
        err = " csg compiler snapshot: invalid annotation identity preimage"
        return false
    var buf = layout.ByteBufInit(224)
    csgCompilerParserIdentityAppendText(
        buf, "cheng.csg_compiler.parser_annotation")
    layout.ByteBufAppendFixed32(
        buf, snapshot.sources.documentCids[source])
    layout.ByteBufAppendFixed32(
        buf, snapshot.parserSidecars.sidecarCids[source])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.annotationSourceLocalRows[row])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.tokens.sourceLocalRows[
            snapshot.parserSidecars.annotationNameTokenIds[row]])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.tokens.sourceLocalRows[
            snapshot.parserSidecars.annotationTargetTokenIds[row]])
    csgCompilerParserIdentityAppendSpan(buf, snapshot, span)
    csgCompilerParserIdentityAppendU32(buf, rootCount)
    for offset in 0..<rootCount:
        let root =
            snapshot.parserSidecars.annotationArgRootIds[rootStart + offset]
        if !csgCompilerIndexValid(
               root, snapshot.parserSidecars.annotationArgIdentityCids.len) ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.annotationArgIdentityCids[root]):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: annotation root identity missing"
            return false
        layout.ByteBufAppendFixed32(
            buf, snapshot.parserSidecars.annotationArgIdentityCids[root])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn csgCompilerParserGenericAnnotationValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let typeSyntaxCount = snapshot.parserSidecars.typeSyntaxKinds.len
    if typeSyntaxCount != snapshot.parserSidecars.typeSyntaxSourceIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxProducerSourceIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxSourceLocalRows.len ||
       typeSyntaxCount != snapshot.parserSidecars.typeSyntaxSpanIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxOwnerTokenIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxDeclarationOwnerTokenIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxDeclarationOwnerIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxGenericSymbolStarts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxGenericSymbolCounts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxChildStarts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxChildCounts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxBracketArgStarts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxBracketArgCounts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxNameTokenIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxFixedLengths.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxQuestionTokenIds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxRootKinds.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxEnumVariantStarts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxEnumVariantCounts.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxIdentityCids.len ||
       typeSyntaxCount !=
           snapshot.parserSidecars.typeSyntaxTypeIds.len ||
       snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len !=
           snapshot.parserSidecars.typeSyntaxBracketArgTokenCounts.len ||
       snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len !=
           snapshot.parserSidecars.typeSyntaxBracketArgTypeIds.len ||
       snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len !=
           snapshot.parserSidecars.typeSyntaxBracketArgConstExprRootIds.len:
        err = " csg compiler snapshot: TypeSyntax parser columns mismatch"
        return false
    let typeConstCount = snapshot.parserSidecars.typeConstExprKinds.len
    if typeConstCount !=
           snapshot.parserSidecars.typeConstExprProducerSourceIds.len ||
       typeConstCount !=
           snapshot.parserSidecars.typeConstExprSourceTextIds.len ||
       typeConstCount !=
           snapshot.parserSidecars.typeConstExprTokenIds.len ||
       typeConstCount !=
           snapshot.parserSidecars.typeConstExprLeftChildIds.len ||
       typeConstCount !=
           snapshot.parserSidecars.typeConstExprRightChildIds.len ||
       typeConstCount !=
           snapshot.parserSidecars.typeConstExprIntegerValues.len ||
       typeConstCount !=
           snapshot.parserSidecars.typeConstExprIdentityCids.len:
        err = " csg compiler snapshot: TypeConstExpr parser columns mismatch"
        return false
    for row in 0..<typeConstCount:
        let source =
            snapshot.parserSidecars.typeConstExprProducerSourceIds[row]
        let token = snapshot.parserSidecars.typeConstExprTokenIds[row]
        let left =
            snapshot.parserSidecars.typeConstExprLeftChildIds[row]
        let right =
            snapshot.parserSidecars.typeConstExprRightChildIds[row]
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(token, snapshot.tokens.sourceIds.len) ||
           snapshot.tokens.sourceIds[token] != source ||
           left < -1 || left >= row || right < -1 || right >= row ||
           snapshot.parserSidecars.typeConstExprKinds[row] <= 0 ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.typeConstExprIdentityCids[row]):
            err = " csg compiler snapshot: invalid TypeConstExpr parser row"
            return false
    var typeChildCursor: int32
    var bracketArgCursor: int32
    var enumVariantCursor: int32
    var declarationByTypeRoot: int32[]
    setLen(declarationByTypeRoot, typeSyntaxCount)
    for row in 0..<declarationByTypeRoot.len:
        declarationByTypeRoot[row] = -1
    for declarationRow in 0..<
            snapshot.parserSidecars.declarationKinds.len:
        let root =
            snapshot.parserSidecars.declarationTypeSyntaxRootIds[
                declarationRow]
        if root < 0:
            continue
        let declarationKind =
            snapshot.parserSidecars.declarationKinds[declarationRow]
        if declarationKind != CsgCompilerParserDeclarationType &&
           declarationKind != CsgCompilerParserDeclarationField:
            continue
        if root >= typeSyntaxCount ||
           declarationByTypeRoot[root] >= 0:
            err = " csg compiler snapshot: declaration TypeSyntax root is not unique"
            return false
        declarationByTypeRoot[root] = declarationRow
        let expectedRootKind =
            declarationKind == CsgCompilerParserDeclarationType ?
                Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) :
                Int32(parser.ParserTypeSyntaxRootFieldDeclaration)
        if snapshot.parserSidecars.typeSyntaxRootKinds[root] !=
               expectedRootKind:
            err = " csg compiler snapshot: declaration TypeSyntax root kind drift"
            return false
    var sourceTypeSyntaxRows: int32[]
    setLen(sourceTypeSyntaxRows, snapshot.sources.documentCids.len)
    for row in 0..<typeSyntaxCount:
        let source = snapshot.parserSidecars.typeSyntaxSourceIds[row]
        let ownerToken =
            snapshot.parserSidecars.typeSyntaxOwnerTokenIds[row]
        let declarationOwnerToken =
            snapshot.parserSidecars.typeSyntaxDeclarationOwnerTokenIds[row]
        let declarationOwner =
            snapshot.parserSidecars.typeSyntaxDeclarationOwnerIds[row]
        let childStart =
            snapshot.parserSidecars.typeSyntaxChildStarts[row]
        let childCount =
            snapshot.parserSidecars.typeSyntaxChildCounts[row]
        let argStart =
            snapshot.parserSidecars.typeSyntaxBracketArgStarts[row]
        let argCount =
            snapshot.parserSidecars.typeSyntaxBracketArgCounts[row]
        let genericStart =
            snapshot.parserSidecars.typeSyntaxGenericSymbolStarts[row]
        let genericCount =
            snapshot.parserSidecars.typeSyntaxGenericSymbolCounts[row]
        let variantStart =
            snapshot.parserSidecars.typeSyntaxEnumVariantStarts[row]
        let variantCount =
            snapshot.parserSidecars.typeSyntaxEnumVariantCounts[row]
        let typeSyntaxKind =
            snapshot.parserSidecars.typeSyntaxKinds[row]
        let rootKind =
            snapshot.parserSidecars.typeSyntaxRootKinds[row]
        let questionToken =
            snapshot.parserSidecars.typeSyntaxQuestionTokenIds[row]
        let optionalType =
            typeSyntaxKind == Int32(parser.ParserTypeSyntaxOptional)
        let semanticTypeId =
            snapshot.parserSidecars.typeSyntaxTypeIds[row]
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           snapshot.parserSidecars.typeSyntaxProducerSourceIds[row] != source ||
           snapshot.parserSidecars.typeSyntaxSourceLocalRows[row] !=
               sourceTypeSyntaxRows[source] ||
           typeSyntaxKind <= 0 ||
           typeSyntaxKind >
               Int32(parser.ParserTypeSyntaxOptional) ||
           !csgCompilerIndexValid(
               snapshot.parserSidecars.typeSyntaxSpanIds[row],
               snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[
               snapshot.parserSidecars.typeSyntaxSpanIds[row]] != source ||
           !csgCompilerIndexValid(ownerToken, snapshot.tokens.sourceIds.len) ||
           snapshot.tokens.sourceIds[ownerToken] != source ||
           !csgCompilerOptionalIndexValid(
               declarationOwnerToken, snapshot.tokens.sourceIds.len) ||
           (declarationOwnerToken >= 0 &&
            snapshot.tokens.sourceIds[declarationOwnerToken] != source) ||
           !csgCompilerOptionalIndexValid(declarationOwner, typeSyntaxCount) ||
           !csgCompilerOptionalIndexValid(
               snapshot.parserSidecars.typeSyntaxNameTokenIds[row],
               snapshot.tokens.sourceIds.len) ||
           (snapshot.types.typeCids.len == 0 &&
            semanticTypeId != -1) ||
           (snapshot.types.typeCids.len > 0 &&
            !csgCompilerIndexValid(
                semanticTypeId, snapshot.types.typeCids.len)) ||
           !csgCompilerOptionalIndexValid(
               questionToken,
               snapshot.tokens.sourceIds.len) ||
           (questionToken >= 0 &&
            snapshot.tokens.sourceIds[questionToken] != source) ||
           optionalType != (questionToken >= 0) ||
           (optionalType && childCount != 1) ||
           childStart != typeChildCursor || childCount < 0 ||
           childCount >
               snapshot.parserSidecars.typeSyntaxChildIds.len -
                   typeChildCursor ||
           argStart != bracketArgCursor || argCount < 0 ||
           argCount >
               snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len -
                   bracketArgCursor ||
           genericCount < 0 ||
           (genericCount == 0) != (genericStart == -1) ||
           (genericCount > 0 &&
            (genericStart < 0 ||
             genericCount >
                 snapshot.parserSidecars.typeGenericSymbolProducerSourceIds.len -
                     genericStart)) ||
           variantCount < 0 ||
           (variantCount == 0) != (variantStart == -1) ||
           (variantCount > 0 &&
            (variantStart != enumVariantCursor ||
             variantCount >
                 snapshot.parserSidecars.typeEnumVariantProducerSourceIds.len -
                     variantStart)):
            err = " csg compiler snapshot: invalid TypeSyntax parser row"
            return false
        if rootKind ==
               Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
            let declarationRow = declarationByTypeRoot[row]
            if declarationRow < 0 ||
               snapshot.parserSidecars.declarationKinds[declarationRow] !=
                   CsgCompilerParserDeclarationType ||
               declarationOwner != row ||
               declarationOwnerToken != ownerToken ||
               snapshot.parserSidecars.declarationNameTokenIds[
                   declarationRow] != ownerToken:
                err = " csg compiler snapshot: TypeSyntax type declaration owner drift"
                return false
        elif rootKind ==
                 Int32(parser.ParserTypeSyntaxRootFieldDeclaration):
            let declarationRow = declarationByTypeRoot[row]
            var expectedOwner: int32 = -1
            if declarationRow >= 0:
                let fieldScope =
                    snapshot.parserSidecars.declarationLexicalScopeIds[
                        declarationRow]
                if csgCompilerIndexValid(
                       fieldScope,
                       snapshot.parserSidecars.declarationLexicalScopeParentIds.len):
                    let parentScope =
                        snapshot.parserSidecars.declarationLexicalScopeParentIds[
                            fieldScope]
                    if parentScope >= 0:
                        for candidateDeclaration in 0..<declarationRow:
                            if snapshot.parserSidecars.declarationLexicalScopeIds[
                                   candidateDeclaration] !=
                                   parentScope:
                                continue
                            let candidateRoot =
                                snapshot.parserSidecars.declarationTypeSyntaxRootIds[
                                    candidateDeclaration]
                            if candidateRoot < 0 ||
                               candidateRoot >= typeSyntaxCount:
                                continue
                            let candidateRootKind =
                                snapshot.parserSidecars.typeSyntaxRootKinds[
                                    candidateRoot]
                            let candidateKind =
                                snapshot.parserSidecars.typeSyntaxKinds[
                                    candidateRoot]
                            # [phaseB-tuple-snap] A named tuple declaration
                            # root owns its declared field rows exactly like
                            # the aggregate families. The parser grants the
                            # FieldDeclaration root only to an alias
                            # declaration whose single child is the tuple
                            # itself
                            # (ParserValueExprTypeSyntaxAliasDeclarationRootWrapsTuple),
                            # so the immediate-owner join accepts an
                            # alias-wrapping-tuple declaration root; a plain
                            # alias to scalar/sequence still owns no field
                            # declaration.
                            let candidateWrapsTuple =
                                candidateKind ==
                                    Int32(parser.ParserTypeSyntaxAlias) &&
                                snapshot.parserSidecars.typeSyntaxChildCounts[
                                    candidateRoot] == 1 &&
                                snapshot.parserSidecars.typeSyntaxKinds[
                                    snapshot.parserSidecars.typeSyntaxChildIds[
                                        snapshot.parserSidecars.typeSyntaxChildStarts[
                                            candidateRoot]]] ==
                                    Int32(parser.ParserTypeSyntaxTuple)
                            let topOwner =
                                candidateRootKind ==
                                    Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) &&
                                (candidateKind ==
                                     Int32(parser.ParserTypeSyntaxImplicitObject) ||
                                 candidateKind ==
                                     Int32(parser.ParserTypeSyntaxObject) ||
                                 candidateKind ==
                                     Int32(parser.ParserTypeSyntaxRefObject) ||
                                 candidateWrapsTuple)
                            let nestedOwner =
                                candidateRootKind ==
                                    Int32(parser.ParserTypeSyntaxRootFieldDeclaration) &&
                                (candidateKind ==
                                     Int32(parser.ParserTypeSyntaxObject) ||
                                 candidateKind ==
                                     Int32(parser.ParserTypeSyntaxRefObject))
                            if topOwner || nestedOwner:
                                expectedOwner = candidateRoot
            if declarationRow < 0 ||
               snapshot.parserSidecars.declarationKinds[declarationRow] !=
                   CsgCompilerParserDeclarationField ||
               snapshot.parserSidecars.declarationNameTokenIds[
                   declarationRow] != ownerToken ||
               expectedOwner < 0 || expectedOwner >= row ||
               declarationOwner != expectedOwner ||
               snapshot.parserSidecars.typeSyntaxSourceIds[
                   expectedOwner] != source ||
               snapshot.parserSidecars.typeSyntaxProducerSourceIds[
                   expectedOwner] != source ||
               declarationOwnerToken !=
                   snapshot.parserSidecars.typeSyntaxDeclarationOwnerTokenIds[
                       expectedOwner] ||
               genericStart !=
                   snapshot.parserSidecars.typeSyntaxGenericSymbolStarts[
                       expectedOwner] ||
               genericCount !=
                   snapshot.parserSidecars.typeSyntaxGenericSymbolCounts[
                       expectedOwner]:
                err = " csg compiler snapshot: TypeSyntax field immediate owner drift"
                return false
        elif declarationOwner != -1:
            err = " csg compiler snapshot: non-declaration TypeSyntax owns declaration"
            return false
        sourceTypeSyntaxRows[source] = sourceTypeSyntaxRows[source] + 1
        if optionalType:
            let child =
                snapshot.parserSidecars.typeSyntaxChildIds[
                    childStart]
            let rowSpan =
                snapshot.parserSidecars.typeSyntaxSpanIds[row]
            let childSpan =
                child < 0 ||
                child >= snapshot.parserSidecars.typeSyntaxSpanIds.len ?
                    -1 :
                    snapshot.parserSidecars.typeSyntaxSpanIds[child]
            let questionSpan =
                questionToken < 0 ||
                questionToken >= snapshot.tokens.spanIds.len ?
                    -1 : snapshot.tokens.spanIds[questionToken]
            let previousToken = questionToken - 1
            let previousSpan =
                previousToken < 0 ||
                previousToken >= snapshot.tokens.spanIds.len ?
                    -1 : snapshot.tokens.spanIds[previousToken]
            if questionToken <= 0 ||
               snapshot.tokens.kinds[questionToken] !=
                   Int32(parser.ParserValueTokenQuestion) ||
               snapshot.tokens.sourceLocalRows[questionToken] <= 0 ||
               snapshot.tokens.sourceIds[previousToken] != source ||
               snapshot.tokens.sourceLocalRows[previousToken] + 1 !=
                   snapshot.tokens.sourceLocalRows[questionToken] ||
               !csgCompilerIndexValid(
                   childSpan, snapshot.spans.sourceIds.len) ||
               !csgCompilerIndexValid(
                   questionSpan, snapshot.spans.sourceIds.len) ||
               !csgCompilerIndexValid(
                   previousSpan, snapshot.spans.sourceIds.len) ||
               snapshot.parserSidecars.typeSyntaxSourceIds[child] !=
                   source ||
               snapshot.parserSidecars.typeSyntaxOwnerTokenIds[child] !=
                   ownerToken ||
               snapshot.spans.startBytes[childSpan] !=
                   snapshot.spans.startBytes[rowSpan] ||
               snapshot.spans.endBytes[childSpan] !=
                   snapshot.spans.endBytes[previousSpan] ||
               snapshot.spans.endBytes[rowSpan] !=
                   snapshot.spans.endBytes[questionSpan] ||
               snapshot.parserSidecars.typeSyntaxRootKinds[child] !=
                   Int32(parser.ParserTypeSyntaxRootInvalid) ||
               snapshot.parserSidecars.typeSyntaxDeclarationOwnerIds[
                   child] != -1:
                err = " csg compiler snapshot: optional TypeSyntax token authority invalid"
                return false
        for offset in 0..<childCount:
            let child =
                snapshot.parserSidecars.typeSyntaxChildIds[
                    childStart + offset]
            if child < 0 || child >= row ||
               snapshot.parserSidecars.typeSyntaxSourceIds[child] != source:
                err = " csg compiler snapshot: invalid TypeSyntax child"
                return false
        for offset in 0..<argCount:
            let argRow = argStart + offset
            let tokenStart =
                snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts[
                    argRow]
            let tokenCount =
                snapshot.parserSidecars.typeSyntaxBracketArgTokenCounts[
                    argRow]
            let typeId =
                snapshot.parserSidecars.typeSyntaxBracketArgTypeIds[argRow]
            let constRoot =
                snapshot.parserSidecars.typeSyntaxBracketArgConstExprRootIds[
                    argRow]
            if tokenStart < 0 || tokenCount <= 0 ||
               tokenStart >
                   snapshot.tokens.sourceIds.len - tokenCount ||
               snapshot.tokens.sourceIds[tokenStart] != source ||
               !csgCompilerOptionalIndexValid(typeId, row) ||
               !csgCompilerOptionalIndexValid(constRoot, typeConstCount) ||
               (typeId >= 0) == (constRoot >= 0):
                err = " csg compiler snapshot: invalid TypeSyntax bracket argument"
                return false
        var expectedTypeIdentity: layout.FixedBytes32
        if !CsgCompilerParserTypeSyntaxIdentityCidInto(
               snapshot, row, expectedTypeIdentity, err) ||
           !layout.FixedBytes32Equal(
               expectedTypeIdentity,
               snapshot.parserSidecars.typeSyntaxIdentityCids[row]):
            if err == "":
                err = " csg compiler snapshot: TypeSyntax identity CID mismatch"
            return false
        typeChildCursor = typeChildCursor + childCount
        bracketArgCursor = bracketArgCursor + argCount
        enumVariantCursor = enumVariantCursor + variantCount
    if typeChildCursor != snapshot.parserSidecars.typeSyntaxChildIds.len ||
       bracketArgCursor !=
           snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len ||
       enumVariantCursor !=
           snapshot.parserSidecars.typeEnumVariantProducerSourceIds.len:
        err = " csg compiler snapshot: TypeSyntax parser CSR coverage mismatch"
        return false
    let variantCount =
        snapshot.parserSidecars.typeEnumVariantProducerSourceIds.len
    if variantCount !=
           snapshot.parserSidecars.typeEnumVariantDeclarationOwnerIds.len ||
       variantCount !=
           snapshot.parserSidecars.typeEnumVariantDeclarationOwnerTokenIds.len ||
       variantCount !=
           snapshot.parserSidecars.typeEnumVariantNameTokenIds.len ||
       variantCount !=
           snapshot.parserSidecars.typeEnumVariantOrdinals.len ||
       variantCount !=
           snapshot.parserSidecars.typeEnumVariantPayloadTypeSyntaxIds.len:
        err = " csg compiler snapshot: TypeSyntax variant columns mismatch"
        return false
    for row in 0..<variantCount:
        let source =
            snapshot.parserSidecars.typeEnumVariantProducerSourceIds[row]
        let owner =
            snapshot.parserSidecars.typeEnumVariantDeclarationOwnerIds[row]
        let ownerToken =
            snapshot.parserSidecars.typeEnumVariantDeclarationOwnerTokenIds[
                row]
        let nameToken =
            snapshot.parserSidecars.typeEnumVariantNameTokenIds[row]
        let payload =
            snapshot.parserSidecars.typeEnumVariantPayloadTypeSyntaxIds[row]
        if !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(owner, typeSyntaxCount) ||
           snapshot.parserSidecars.typeSyntaxSourceIds[owner] != source ||
           !csgCompilerIndexValid(ownerToken, snapshot.tokens.sourceIds.len) ||
           !csgCompilerIndexValid(nameToken, snapshot.tokens.sourceIds.len) ||
           snapshot.tokens.sourceIds[ownerToken] != source ||
           snapshot.tokens.sourceIds[nameToken] != source ||
           !csgCompilerOptionalIndexValid(payload, typeSyntaxCount) ||
           (payload >= 0 &&
            snapshot.parserSidecars.typeSyntaxSourceIds[payload] != source) ||
           snapshot.parserSidecars.typeEnumVariantOrdinals[row] < 0:
            err = " csg compiler snapshot: invalid TypeSyntax variant row"
            return false
    let genericCount =
        snapshot.parserSidecars.typeGenericSymbolProducerSourceIds.len
    if genericCount !=
           snapshot.parserSidecars.typeGenericSymbolSourceLocalRows.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolNameTokenIds.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolOrdinals.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolSpanIds.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolOwnerTypeSyntaxIds.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolChildStarts.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolChildCounts.len ||
       genericCount !=
           snapshot.parserSidecars.typeGenericSymbolIdentityCids.len:
        err = " csg compiler snapshot: generic parameter parser columns mismatch"
        return false
    var genericChildCursor: int32
    var previousGenericSource: int32 = -1
    var previousGenericLocal: int32 = -1
    for row in 0..<genericCount:
        let source =
            snapshot.parserSidecars.typeGenericSymbolProducerSourceIds[row]
        let localRow =
            snapshot.parserSidecars.typeGenericSymbolSourceLocalRows[row]
        let ownerToken =
            snapshot.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds[
                row]
        let nameToken =
            snapshot.parserSidecars.typeGenericSymbolNameTokenIds[row]
        let span =
            snapshot.parserSidecars.typeGenericSymbolSpanIds[row]
        let childStart =
            snapshot.parserSidecars.typeGenericSymbolChildStarts[row]
        let childCount =
            snapshot.parserSidecars.typeGenericSymbolChildCounts[row]
        let firstForSource = source != previousGenericSource
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           source < previousGenericSource ||
           localRow != (firstForSource ? 0 : previousGenericLocal + 1) ||
           !csgCompilerIndexValid(ownerToken, snapshot.tokens.sourceIds.len) ||
           !csgCompilerIndexValid(nameToken, snapshot.tokens.sourceIds.len) ||
           snapshot.tokens.sourceIds[ownerToken] != source ||
           snapshot.tokens.sourceIds[nameToken] != source ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           snapshot.parserSidecars.typeGenericSymbolOrdinals[row] < 0 ||
           !csgCompilerIndexValid(
               snapshot.parserSidecars.typeGenericSymbolOwnerTypeSyntaxIds[
                   row], typeSyntaxCount) ||
           !csgCompilerOptionalIndexValid(
               snapshot.parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds[
                   row], typeSyntaxCount) ||
           !csgCompilerOptionalIndexValid(
               snapshot.parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds[
                   row], typeSyntaxCount) ||
           childStart != genericChildCursor || childCount < 0 ||
           childCount >
               snapshot.parserSidecars.typeGenericSymbolChildTypeSyntaxIds.len -
                   genericChildCursor:
            err = " csg compiler snapshot: invalid generic parameter parser row"
            return false
        for offset in 0..<childCount:
            let child =
                snapshot.parserSidecars.typeGenericSymbolChildTypeSyntaxIds[
                    childStart + offset]
            if !csgCompilerIndexValid(child, typeSyntaxCount) ||
               snapshot.parserSidecars.typeSyntaxSourceIds[child] != source:
                err = " csg compiler snapshot: invalid generic parameter child"
                return false
        genericChildCursor = genericChildCursor + childCount
        var expectedGenericIdentity: layout.FixedBytes32
        if !CsgCompilerParserGenericParameterIdentityCidInto(
               snapshot, row, expectedGenericIdentity, err) ||
           !layout.FixedBytes32Equal(
               expectedGenericIdentity,
               snapshot.parserSidecars.typeGenericSymbolIdentityCids[row]):
            if err == "":
                err = " csg compiler snapshot: generic parser identity CID mismatch"
            return false
        previousGenericSource = source
        previousGenericLocal = localRow
    if genericChildCursor !=
           snapshot.parserSidecars.typeGenericSymbolChildTypeSyntaxIds.len:
        err = " csg compiler snapshot: generic parameter child coverage mismatch"
        return false

    let annotationCount =
        snapshot.parserSidecars.annotationProducerSourceIds.len
    if annotationCount !=
           snapshot.parserSidecars.annotationSourceLocalRows.len ||
       annotationCount != snapshot.parserSidecars.annotationNameTokenIds.len ||
       annotationCount !=
           snapshot.parserSidecars.annotationTargetTokenIds.len ||
       annotationCount != snapshot.parserSidecars.annotationSpanIds.len ||
       annotationCount !=
           snapshot.parserSidecars.annotationArgRootStarts.len ||
       annotationCount !=
           snapshot.parserSidecars.annotationArgRootCounts.len ||
       annotationCount != snapshot.parserSidecars.annotationIdentityCids.len:
        err = " csg compiler snapshot: annotation parser columns mismatch"
        return false
    let annotationArgCount =
        snapshot.parserSidecars.annotationArgProducerSourceIds.len
    if annotationArgCount !=
           snapshot.parserSidecars.annotationArgSourceLocalRows.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgOwnerIds.len ||
       annotationArgCount != snapshot.parserSidecars.annotationArgKinds.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgTokenIds.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgSeparatorTokenIds.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgSpanIds.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgChildStarts.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgChildCounts.len ||
       annotationArgCount !=
           snapshot.parserSidecars.annotationArgIdentityCids.len:
        err = " csg compiler snapshot: annotation argument columns mismatch"
        return false
    var rootCursor: int32
    var previousAnnotationSource: int32 = -1
    var previousAnnotationLocal: int32 = -1
    for row in 0..<annotationCount:
        let source = snapshot.parserSidecars.annotationProducerSourceIds[row]
        let localRow = snapshot.parserSidecars.annotationSourceLocalRows[row]
        let nameToken = snapshot.parserSidecars.annotationNameTokenIds[row]
        let targetToken =
            snapshot.parserSidecars.annotationTargetTokenIds[row]
        let span = snapshot.parserSidecars.annotationSpanIds[row]
        let rootStart =
            snapshot.parserSidecars.annotationArgRootStarts[row]
        let rootCount =
            snapshot.parserSidecars.annotationArgRootCounts[row]
        let firstForSource = source != previousAnnotationSource
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           source < previousAnnotationSource ||
           localRow != (firstForSource ? 0 : previousAnnotationLocal + 1) ||
           !csgCompilerIndexValid(nameToken, snapshot.tokens.sourceIds.len) ||
           !csgCompilerIndexValid(targetToken, snapshot.tokens.sourceIds.len) ||
           snapshot.tokens.sourceIds[nameToken] != source ||
           snapshot.tokens.sourceIds[targetToken] != source ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           rootStart != rootCursor || rootCount < 0 ||
           rootCount >
               snapshot.parserSidecars.annotationArgRootIds.len - rootCursor:
            err = " csg compiler snapshot: invalid annotation parser row"
            return false
        for offset in 0..<rootCount:
            let argId = snapshot.parserSidecars.annotationArgRootIds[
                rootStart + offset]
            if !csgCompilerIndexValid(argId, annotationArgCount) ||
               snapshot.parserSidecars.annotationArgOwnerIds[argId] != row:
                err = " csg compiler snapshot: invalid annotation root"
                return false
        rootCursor = rootCursor + rootCount
        previousAnnotationSource = source
        previousAnnotationLocal = localRow
    if rootCursor != snapshot.parserSidecars.annotationArgRootIds.len:
        err = " csg compiler snapshot: annotation root coverage mismatch"
        return false
    var argChildCursor: int32
    var previousArgSource: int32 = -1
    var previousArgLocal: int32 = -1
    for row in 0..<annotationArgCount:
        let source =
            snapshot.parserSidecars.annotationArgProducerSourceIds[row]
        let localRow =
            snapshot.parserSidecars.annotationArgSourceLocalRows[row]
        let owner = snapshot.parserSidecars.annotationArgOwnerIds[row]
        let token = snapshot.parserSidecars.annotationArgTokenIds[row]
        let separator =
            snapshot.parserSidecars.annotationArgSeparatorTokenIds[row]
        let span = snapshot.parserSidecars.annotationArgSpanIds[row]
        let childStart =
            snapshot.parserSidecars.annotationArgChildStarts[row]
        let childCount =
            snapshot.parserSidecars.annotationArgChildCounts[row]
        let firstForSource = source != previousArgSource
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           source < previousArgSource ||
           localRow != (firstForSource ? 0 : previousArgLocal + 1) ||
           !csgCompilerIndexValid(owner, annotationCount) ||
           snapshot.parserSidecars.annotationProducerSourceIds[owner] !=
               source ||
           snapshot.parserSidecars.annotationArgKinds[row] < 1 ||
           snapshot.parserSidecars.annotationArgKinds[row] > 8 ||
           !csgCompilerOptionalIndexValid(token, snapshot.tokens.sourceIds.len) ||
           !csgCompilerOptionalIndexValid(
               separator, snapshot.tokens.sourceIds.len) ||
           (token >= 0 && snapshot.tokens.sourceIds[token] != source) ||
           (separator >= 0 &&
            snapshot.tokens.sourceIds[separator] != source) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           childStart != argChildCursor || childCount < 0 ||
           childCount >
               snapshot.parserSidecars.annotationArgChildIds.len -
                   argChildCursor:
            err = " csg compiler snapshot: invalid annotation argument row"
            return false
        for offset in 0..<childCount:
            let child = snapshot.parserSidecars.annotationArgChildIds[
                childStart + offset]
            if !csgCompilerIndexValid(child, annotationArgCount) ||
               snapshot.parserSidecars.annotationArgOwnerIds[child] != owner ||
               snapshot.parserSidecars.annotationArgProducerSourceIds[child] !=
                   source:
                err = " csg compiler snapshot: invalid annotation argument child"
                return false
        argChildCursor = argChildCursor + childCount
        var expectedArgIdentity: layout.FixedBytes32
        if !CsgCompilerParserAnnotationArgIdentityCidInto(
               snapshot, row, expectedArgIdentity, err) ||
           !layout.FixedBytes32Equal(
               expectedArgIdentity,
               snapshot.parserSidecars.annotationArgIdentityCids[row]):
            if err == "":
                err = " csg compiler snapshot: annotation argument identity CID mismatch"
            return false
        previousArgSource = source
        previousArgLocal = localRow
    if argChildCursor != snapshot.parserSidecars.annotationArgChildIds.len:
        err = " csg compiler snapshot: annotation child coverage mismatch"
        return false
    for row in 0..<annotationCount:
        var expectedAnnotationIdentity: layout.FixedBytes32
        if !CsgCompilerParserAnnotationIdentityCidInto(
               snapshot, row, expectedAnnotationIdentity, err) ||
           !layout.FixedBytes32Equal(
               expectedAnnotationIdentity,
               snapshot.parserSidecars.annotationIdentityCids[row]):
            if err == "":
                err = " csg compiler snapshot: annotation identity CID mismatch"
            return false
    return true

@borrows
fn csgCompilerParserNormalizedExprIdentitiesValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count =
        snapshot.parserSidecars.normalizedExprParserNodeIds.len
    if count !=
           snapshot.parserSidecars.normalizedExprProducerSourceIds.len ||
       count !=
           snapshot.parserSidecars.normalizedExprSourceLocalRows.len ||
       count !=
           snapshot.parserSidecars.normalizedExprFunctionIndexes.len ||
       count != snapshot.parserSidecars.normalizedExprKinds.len ||
       count !=
           snapshot.parserSidecars.normalizedExprStatementRoles.len:
        err = " csg compiler snapshot: normalized expression columns mismatch"
        return false
    var previousSource: int32 = -1
    var previousLocalRow: int32 = -1
    for row in 0..<count:
        let source =
            snapshot.parserSidecars.normalizedExprProducerSourceIds[row]
        let localRow =
            snapshot.parserSidecars.normalizedExprSourceLocalRows[row]
        let functionIndex =
            snapshot.parserSidecars.normalizedExprFunctionIndexes[row]
        let parserNodeId =
            snapshot.parserSidecars.normalizedExprParserNodeIds[row]
        var functionSource: int32 = -1
        for functionRow in 0..<
                snapshot.parserSidecars.functionIndexes.len:
            if snapshot.parserSidecars.functionIndexes[functionRow] ==
                   functionIndex:
                let span =
                    snapshot.parserSidecars.functionDeclarationSpanIds[
                        functionRow]
                if csgCompilerIndexValid(
                       span, snapshot.spans.sourceIds.len):
                    functionSource = snapshot.spans.sourceIds[span]
        let firstForSource = source != previousSource
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           source < previousSource ||
           localRow != (firstForSource ? 0 : previousLocalRow + 1) ||
           !csgCompilerIndexValid(
               functionIndex,
               snapshot.parserSidecars.functionIndexes.len) ||
           functionSource != source ||
           !csgCompilerIndexValid(
               parserNodeId, snapshot.parserNodes.sourceIds.len) ||
           snapshot.parserNodes.sourceIds[parserNodeId] != source ||
           snapshot.parserSidecars.normalizedExprKinds[row] <= 0 ||
           snapshot.parserSidecars.normalizedExprStatementRoles[row] < 0 ||
           snapshot.parserSidecars.normalizedExprStatementRoles[row] > 12:
            err = " csg compiler snapshot: normalized expression identity invalid"
            return false
        for previous in 0..<row:
            if snapshot.parserSidecars.normalizedExprProducerSourceIds[
                   previous] == source &&
               snapshot.parserSidecars.normalizedExprFunctionIndexes[
                   previous] == functionIndex &&
               snapshot.parserSidecars.normalizedExprParserNodeIds[
                   previous] == parserNodeId &&
               snapshot.parserSidecars.normalizedExprKinds[previous] ==
                   snapshot.parserSidecars.normalizedExprKinds[row] &&
               snapshot.parserSidecars.normalizedExprStatementRoles[
                   previous] ==
                   snapshot.parserSidecars.normalizedExprStatementRoles[
                       row]:
                err = " csg compiler snapshot: duplicate normalized expression identity"
                return false
        previousSource = source
        previousLocalRow = localRow
    return true

@borrows
fn csgCompilerParserManualConsumeValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let functionCount = snapshot.parserSidecars.functionIndexes.len
    if functionCount !=
           snapshot.parserSidecars.functionAnnotationFlags.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds.len:
        err = " csg compiler snapshot: parser manual consume columns mismatch"
        return false
    for parserFunctionRow in 0..<functionCount:
        let flags =
            snapshot.parserSidecars.functionAnnotationFlags[
                parserFunctionRow]
        let targetOrdinal =
            snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals[
                parserFunctionRow]
        let targetDeclaration =
            snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
                parserFunctionRow]
        let sourceOrdinal =
            snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals[
                parserFunctionRow]
        let sourceDeclaration =
            snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
                parserFunctionRow]
        let present =
            CsgCompilerFunctionAnnotationHas(
                flags, CsgCompilerFunctionAnnotationManualConsume)
        if !present:
            if targetOrdinal != -1 || targetDeclaration != -1 ||
               sourceOrdinal != -1 || sourceDeclaration != -1:
                err = " csg compiler snapshot: absent parser manual consume relation invalid"
                return false
            continue
        let declarationSpan =
            snapshot.parserSidecars.functionDeclarationSpanIds[
                parserFunctionRow]
        let nameSpan =
            snapshot.parserSidecars.functionNameSpanIds[
                parserFunctionRow]
        var functionDeclaration: int32 = -1
        for declarationRow in 0..<
                snapshot.parserSidecars.declarationKinds.len:
            if snapshot.parserSidecars.declarationKinds[declarationRow] !=
                   CsgCompilerParserDeclarationFunction ||
               snapshot.parserSidecars.declarationSpanIds[declarationRow] !=
                   declarationSpan ||
               snapshot.parserSidecars.declarationNameSpanIds[
                   declarationRow] != nameSpan:
                continue
            if functionDeclaration >= 0:
                err = " csg compiler snapshot: parser manual consume Function authority ambiguous"
                return false
            functionDeclaration = declarationRow
        if functionDeclaration < 0 ||
           targetOrdinal < 0 || sourceOrdinal < 0 ||
           targetOrdinal == sourceOrdinal ||
           !csgCompilerIndexValid(
               targetDeclaration,
               snapshot.parserSidecars.declarationKinds.len) ||
           !csgCompilerIndexValid(
               sourceDeclaration,
               snapshot.parserSidecars.declarationKinds.len) ||
           targetDeclaration == sourceDeclaration ||
           snapshot.parserSidecars.declarationKinds[targetDeclaration] !=
               CsgCompilerParserDeclarationParameter ||
           snapshot.parserSidecars.declarationKinds[sourceDeclaration] !=
               CsgCompilerParserDeclarationParameter ||
           snapshot.parserSidecars.declarationOwnerIds[
               targetDeclaration] != functionDeclaration ||
           snapshot.parserSidecars.declarationOwnerIds[
               sourceDeclaration] != functionDeclaration:
            err = " csg compiler snapshot: parser manual consume relation invalid"
            return false
        var observedTargetOrdinal: int32 = -1
        var observedSourceOrdinal: int32 = -1
        var parameterOrdinal: int32
        for declarationRow in 0..<
                snapshot.parserSidecars.declarationKinds.len:
            if snapshot.parserSidecars.declarationKinds[declarationRow] !=
                   CsgCompilerParserDeclarationParameter ||
               snapshot.parserSidecars.declarationOwnerIds[
                   declarationRow] != functionDeclaration:
                continue
            if declarationRow == targetDeclaration:
                observedTargetOrdinal = parameterOrdinal
            if declarationRow == sourceDeclaration:
                observedSourceOrdinal = parameterOrdinal
            parameterOrdinal = parameterOrdinal + 1
        if observedTargetOrdinal != targetOrdinal ||
           observedSourceOrdinal != sourceOrdinal:
            err = " csg compiler snapshot: parser manual consume ordinal drift"
            return false
    err = ""
    return true

@borrows
fn csgCompilerParserValidateInto(snapshot: CsgCompilerSnapshotTables,
                                 err: var str): bool =
    let sourceCount = snapshot.sources.documentCids.len
    if snapshot.parserSidecars.sourceIds.len != sourceCount ||
       snapshot.parserSidecars.producerSourceIndexes.len != sourceCount ||
       snapshot.parserSidecars.parserInputCids.len != sourceCount ||
       snapshot.parserSidecars.sidecarCids.len != sourceCount:
        err = " csg compiler snapshot: parser sidecar source columns mismatch"
        return false
    var producerSeen: int32[]
    setLen(producerSeen, sourceCount)
    for row in 0..<sourceCount:
        let producerSourceIndex =
            snapshot.parserSidecars.producerSourceIndexes[row]
        if snapshot.parserSidecars.sourceIds[row] != row ||
           !csgCompilerIndexValid(producerSourceIndex, sourceCount) ||
           producerSeen[producerSourceIndex] != 0 ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.parserInputCids[row]) ||
           !csgCompilerCidObserved(snapshot.parserSidecars.sidecarCids[row]):
            err = " csg compiler snapshot: invalid parser sidecar source row"
            return false
        producerSeen[producerSourceIndex] = 1
    for producerSourceIndex in 0..<sourceCount:
        if producerSeen[producerSourceIndex] != 1:
            err = " csg compiler snapshot: parser producer source coverage mismatch"
            return false
    let count = snapshot.parserNodes.sourceIds.len
    if count <= 0 || count != snapshot.parserNodes.producerNodeIds.len ||
       count != snapshot.parserNodes.parentNodeIds.len ||
       count != snapshot.parserNodes.kinds.len ||
       count != snapshot.parserNodes.spanIds.len ||
       count != snapshot.parserNodes.childStarts.len ||
       count != snapshot.parserNodes.childCounts.len ||
       count != snapshot.parserNodes.genericStarts.len ||
       count != snapshot.parserNodes.genericCounts.len ||
       count != snapshot.parserNodes.bindingResolutionKinds.len ||
       count !=
           snapshot.parserNodes.bindingDeclarationSourceLocalRows.len ||
       count != snapshot.parserNodes.bindingPatternSourceLocalRows.len:
        err = " csg compiler snapshot: parser columns mismatch"
        return false
    var childCursor: int32
    var childSeen: int32[]
    setLen(childSeen, count)
    var genericSeen: int32[]
    setLen(genericSeen, snapshot.parserSidecars.genericSpanIds.len)
    for row in 0..<count:
        let source = snapshot.parserNodes.sourceIds[row]
        let span = snapshot.parserNodes.spanIds[row]
        let parent = snapshot.parserNodes.parentNodeIds[row]
        let childStart = snapshot.parserNodes.childStarts[row]
        let childCount = snapshot.parserNodes.childCounts[row]
        let genericStart = snapshot.parserNodes.genericStarts[row]
        let genericCount = snapshot.parserNodes.genericCounts[row]
        let bindingResolutionKind =
            snapshot.parserNodes.bindingResolutionKinds[row]
        let bindingDeclarationSourceLocalRow =
            snapshot.parserNodes.bindingDeclarationSourceLocalRows[row]
        let bindingPatternSourceLocalRow =
            snapshot.parserNodes.bindingPatternSourceLocalRows[row]
        let bindingAbsent =
            bindingResolutionKind ==
                CsgCompilerParserBindingResolutionNone &&
            bindingDeclarationSourceLocalRow == -1 &&
            bindingPatternSourceLocalRow == -1
        if !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           snapshot.spans.endBytes[span] <= snapshot.spans.startBytes[span] ||
           snapshot.parserNodes.kinds[row] <= 0 ||
           (parent != -1 && (parent < 0 || parent >= row)) ||
           (parent >= 0 && snapshot.parserNodes.sourceIds[parent] != source) ||
           childStart != childCursor || childCount < 0 ||
           childCount > snapshot.parserNodes.childNodeIds.len ||
           childStart > snapshot.parserNodes.childNodeIds.len - childCount ||
           genericStart < 0 || genericCount < 0 ||
           genericCount > snapshot.parserSidecars.genericSpanIds.len ||
           genericStart >
               snapshot.parserSidecars.genericSpanIds.len - genericCount ||
           bindingResolutionKind <
               CsgCompilerParserBindingResolutionNone ||
           bindingResolutionKind >
               CsgCompilerParserBindingResolutionPattern ||
           (bindingResolutionKind ==
                CsgCompilerParserBindingResolutionNone &&
            !bindingAbsent) ||
           (!bindingAbsent &&
            snapshot.parserNodes.kinds[row] !=
                CsgCompilerParserValueExprIdentifier) ||
           (row > 0 && source < snapshot.parserNodes.sourceIds[row - 1]):
            err = " csg compiler snapshot: invalid parser row"
            return false
        for childOffset in 0..<childCount:
            let child = snapshot.parserNodes.childNodeIds[childStart + childOffset]
            if child <= row || child >= count ||
               snapshot.parserNodes.parentNodeIds[child] != row ||
               snapshot.parserNodes.sourceIds[child] != source ||
               childSeen[child] != 0 ||
               (childOffset > 0 && child <=
                   snapshot.parserNodes.childNodeIds[
                       childStart + childOffset - 1]):
                err = " csg compiler snapshot: invalid parser child"
                return false
            childSeen[child] = 1
        for genericOffset in 0..<genericCount:
            let generic = genericStart + genericOffset
            let genericSpan = snapshot.parserSidecars.genericSpanIds[generic]
            if genericSeen[generic] != 0 ||
               !csgCompilerIndexValid(genericSpan,
                                       snapshot.spans.sourceIds.len) ||
               snapshot.spans.sourceIds[genericSpan] != source ||
               snapshot.spans.endBytes[genericSpan] <=
                   snapshot.spans.startBytes[genericSpan]:
                err = " csg compiler snapshot: invalid parser generic"
                return false
            genericSeen[generic] = 1
        childCursor = childCursor + childCount
    if childCursor != snapshot.parserNodes.childNodeIds.len:
        err = " csg compiler snapshot: parser child coverage mismatch"
        return false
    for row in 0..<count:
        if (snapshot.parserNodes.parentNodeIds[row] == -1 &&
            childSeen[row] != 0) ||
           (snapshot.parserNodes.parentNodeIds[row] >= 0 &&
            childSeen[row] != 1):
            err = " csg compiler snapshot: parser parent coverage mismatch"
            return false
    for row in 0..<genericSeen.len:
        if genericSeen[row] != 1:
            err = " csg compiler snapshot: parser generic coverage mismatch"
            return false

    # The sidecar commits a strict local producer-node permutation. Preserve
    # it after global remap so TypedIR origins join by int32 identity only.
    var sourceNodeCounts: int32[]
    setLen(sourceNodeCounts, sourceCount)
    for row in 0..<count:
        sourceNodeCounts[snapshot.parserNodes.sourceIds[row]] =
            sourceNodeCounts[snapshot.parserNodes.sourceIds[row]] + 1
    var sourceNodeStarts: int32[]
    setLen(sourceNodeStarts, sourceCount)
    var sourceNodeCursor: int32
    for source in 0..<sourceCount:
        sourceNodeStarts[source] = sourceNodeCursor
        sourceNodeCursor = sourceNodeCursor + sourceNodeCounts[source]
    if sourceNodeCursor != count:
        err = " csg compiler snapshot: parser producer domain mismatch"
        return false
    var producerNodeSeen: int32[]
    setLen(producerNodeSeen, count)
    for row in 0..<count:
        let source = snapshot.parserNodes.sourceIds[row]
        let producerNodeId = snapshot.parserNodes.producerNodeIds[row]
        if producerNodeId < 0 || producerNodeId >= sourceNodeCounts[source]:
            err = " csg compiler snapshot: parser producer node out of range"
            return false
        let producerSlot = sourceNodeStarts[source] + producerNodeId
        if producerNodeSeen[producerSlot] != 0:
            err = " csg compiler snapshot: duplicate parser producer node"
            return false
        producerNodeSeen[producerSlot] = 1
    for producerSlot in 0..<count:
        if producerNodeSeen[producerSlot] != 1:
            err = " csg compiler snapshot: parser producer coverage mismatch"
            return false

    let tokenCount = snapshot.tokens.sourceIds.len
    if tokenCount <= 0 ||
       tokenCount != snapshot.tokens.sourceLocalRows.len ||
       tokenCount != snapshot.tokens.lexicalParentTokenIds.len ||
       tokenCount != snapshot.tokens.spanIds.len ||
       tokenCount != snapshot.tokens.kinds.len ||
       tokenCount != snapshot.tokens.valueTextIds.len:
        err = " csg compiler snapshot: token columns mismatch"
        return false
    var previousSource: int32 = -1
    var expectedSourceLocalRow: int32
    var previousRootEndByte: int32 = -1
    var previousChildEndBytes: int32[]
    setLen(previousChildEndBytes, tokenCount)
    for row in 0..<tokenCount:
        previousChildEndBytes[row] = -1
    for row in 0..<tokenCount:
        let source = snapshot.tokens.sourceIds[row]
        let sourceLocalRow = snapshot.tokens.sourceLocalRows[row]
        let lexicalParent = snapshot.tokens.lexicalParentTokenIds[row]
        let span = snapshot.tokens.spanIds[row]
        if !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           snapshot.spans.endBytes[span] <= snapshot.spans.startBytes[span] ||
           snapshot.tokens.kinds[row] <= 0 ||
           !csgCompilerIndexValid(snapshot.tokens.valueTextIds[row],
                                  snapshot.texts.len) ||
           source < previousSource:
            err = " csg compiler snapshot: invalid token row"
            return false
        if source != previousSource:
            expectedSourceLocalRow = 0
            previousRootEndByte = -1
        if sourceLocalRow != expectedSourceLocalRow ||
           lexicalParent < -1 || lexicalParent >= row:
            err = " csg compiler snapshot: invalid token identity"
            return false
        let startByte = snapshot.spans.startBytes[span]
        let endByte = snapshot.spans.endBytes[span]
        if lexicalParent == -1:
            if startByte < previousRootEndByte:
                err = " csg compiler snapshot: primary token order invalid"
                return false
            previousRootEndByte = endByte
        else:
            let parentSpan =
                snapshot.tokens.spanIds[lexicalParent]
            if snapshot.tokens.sourceIds[lexicalParent] != source ||
               snapshot.tokens.kinds[lexicalParent] !=
                   CsgCompilerTokenFmtString ||
               startByte <= snapshot.spans.startBytes[parentSpan] ||
               endByte >= snapshot.spans.endBytes[parentSpan] ||
               startByte < previousChildEndBytes[lexicalParent]:
                err = " csg compiler snapshot: interpolation token identity invalid"
                return false
            previousChildEndBytes[lexicalParent] = endByte
        previousSource = source
        expectedSourceLocalRow = expectedSourceLocalRow + 1

    var previousGenericSource: int32 = -1
    for row in 0..<snapshot.parserSidecars.genericSpanIds.len:
        let span = snapshot.parserSidecars.genericSpanIds[row]
        if !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.endBytes[span] <= snapshot.spans.startBytes[span] ||
           snapshot.spans.sourceIds[span] < previousGenericSource:
            err = " csg compiler snapshot: non-canonical parser generics"
            return false
        previousGenericSource = snapshot.spans.sourceIds[span]

    let regionCount = snapshot.parserSidecars.regionKinds.len
    if regionCount != snapshot.parserSidecars.regionSpanIds.len ||
       regionCount != snapshot.parserSidecars.regionAnchorTokenIds.len:
        err = " csg compiler snapshot: parser region columns mismatch"
        return false
    var previousRegionSource: int32 = -1
    for row in 0..<regionCount:
        let span = snapshot.parserSidecars.regionSpanIds[row]
        let token = snapshot.parserSidecars.regionAnchorTokenIds[row]
        if snapshot.parserSidecars.regionKinds[row] <= 0 ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           !csgCompilerIndexValid(token, snapshot.tokens.sourceIds.len) ||
           snapshot.spans.endBytes[span] <= snapshot.spans.startBytes[span] ||
           snapshot.spans.sourceIds[span] != snapshot.tokens.sourceIds[token] ||
           snapshot.spans.startBytes[snapshot.tokens.spanIds[token]] <
               snapshot.spans.startBytes[span] ||
           snapshot.spans.endBytes[snapshot.tokens.spanIds[token]] >
               snapshot.spans.endBytes[span] ||
           snapshot.spans.sourceIds[span] < previousRegionSource:
            err = " csg compiler snapshot: invalid parser region row"
            return false
        previousRegionSource = snapshot.spans.sourceIds[span]

    var previousRootSource: int32 = -1
    for row in 0..<snapshot.parserSidecars.rootNodeIds.len:
        let node = snapshot.parserSidecars.rootNodeIds[row]
        if !csgCompilerIndexValid(node, count) ||
           snapshot.parserNodes.sourceIds[node] < previousRootSource:
            err = " csg compiler snapshot: invalid parser root row"
            return false
        previousRootSource = snapshot.parserNodes.sourceIds[node]

    var previousCallSource: int32 = -1
    for row in 0..<snapshot.parserSidecars.callEventNodeIds.len:
        let node = snapshot.parserSidecars.callEventNodeIds[row]
        if !csgCompilerIndexValid(node, count) ||
           snapshot.parserNodes.sourceIds[node] < previousCallSource:
            err = " csg compiler snapshot: invalid parser call event row"
            return false
        previousCallSource = snapshot.parserNodes.sourceIds[node]

    let statementCount = snapshot.parserSidecars.statementRootNodeIds.len
    if statementCount != snapshot.parserSidecars.statementRootRoles.len ||
       statementCount !=
           snapshot.parserSidecars.statementRootAnchorTokenIds.len ||
       statementCount !=
           snapshot.parserSidecars.statementRootBindingDeclarationStarts.len ||
       statementCount !=
           snapshot.parserSidecars.statementRootBindingDeclarationCounts.len ||
       statementCount !=
           snapshot.parserSidecars.statementRootAnchorLines.len ||
       statementCount !=
           snapshot.parserSidecars.statementRootAnchorColumns.len ||
       statementCount != snapshot.parserSidecars.statementRootEndLines.len ||
       statementCount !=
           snapshot.parserSidecars.statementRootEndColumns.len:
        err = " csg compiler snapshot: parser statement columns mismatch"
        return false
    var previousStatementSource: int32 = -1
    for row in 0..<statementCount:
        let node = snapshot.parserSidecars.statementRootNodeIds[row]
        let anchorToken =
            snapshot.parserSidecars.statementRootAnchorTokenIds[row]
        let declarationStart =
            snapshot.parserSidecars.statementRootBindingDeclarationStarts[row]
        let declarationCount =
            snapshot.parserSidecars.statementRootBindingDeclarationCounts[row]
        if !csgCompilerIndexValid(node, count) ||
           !csgCompilerIndexValid(anchorToken, tokenCount) ||
           snapshot.parserSidecars.statementRootRoles[row] <= 0 ||
           snapshot.parserSidecars.statementRootAnchorLines[row] < 0 ||
           snapshot.parserSidecars.statementRootAnchorColumns[row] < 0 ||
           snapshot.parserSidecars.statementRootEndLines[row] <
               snapshot.parserSidecars.statementRootAnchorLines[row] ||
           (snapshot.parserSidecars.statementRootEndLines[row] ==
                snapshot.parserSidecars.statementRootAnchorLines[row] &&
            snapshot.parserSidecars.statementRootEndColumns[row] <
                snapshot.parserSidecars.statementRootAnchorColumns[row]) ||
           snapshot.parserSidecars.statementRootEndColumns[row] < 0 ||
           snapshot.parserNodes.sourceIds[node] < previousStatementSource:
            err = " csg compiler snapshot: invalid parser statement row"
            return false
        let nodeSource = snapshot.parserNodes.sourceIds[node]
        let anchorSpan = snapshot.tokens.spanIds[anchorToken]
        if snapshot.tokens.sourceIds[anchorToken] != nodeSource ||
           snapshot.parserSidecars.statementRootAnchorLines[row] !=
               snapshot.spans.startLines[anchorSpan] ||
           snapshot.parserSidecars.statementRootAnchorColumns[row] !=
               snapshot.spans.startColumns[anchorSpan]:
            err = " csg compiler snapshot: parser statement anchor invalid"
            return false
        let statementRole =
            snapshot.parserSidecars.statementRootRoles[row]
        if statementRole ==
               CsgCompilerParserStatementParameterDefault &&
           snapshot.tokens.kinds[anchorToken] != CsgCompilerTokenAssign:
            err = " csg compiler snapshot: parameter default assignment anchor invalid"
            return false
        let declarationAuthorityRole =
            statementRole ==
                CsgCompilerParserStatementBindingInitializer ||
            statementRole ==
                CsgCompilerParserStatementParameterDefault ||
            statementRole == CsgCompilerParserStatementTypeDefault
        if !declarationAuthorityRole:
            if declarationStart != -1 || declarationCount != 0:
                err = " csg compiler snapshot: statement without declaration authority owns declarations"
                return false
        else:
            if declarationStart < 0 || declarationCount <= 0 ||
               declarationStart >
                   snapshot.parserSidecars.declarationKinds.len ||
               declarationCount >
                   snapshot.parserSidecars.declarationKinds.len -
                       declarationStart:
                err = " csg compiler snapshot: statement declaration authority range invalid"
                return false
            let anchorStart = snapshot.spans.startBytes[anchorSpan]
            let nodeSpan = snapshot.parserNodes.spanIds[node]
            if (statementRole ==
                    CsgCompilerParserStatementTypeDefault ||
                statementRole ==
                    CsgCompilerParserStatementParameterDefault) &&
               declarationCount != 1:
                err = " csg compiler snapshot: declaration default cardinality invalid"
                return false
            for declarationOffset in 0..<declarationCount:
                let declarationRow = declarationStart + declarationOffset
                let declarationSpan =
                    snapshot.parserSidecars.declarationSpanIds[declarationRow]
                let nameToken =
                    snapshot.parserSidecars.declarationNameTokenIds[
                        declarationRow]
                if statementRole ==
                       CsgCompilerParserStatementBindingInitializer:
                    if snapshot.parserSidecars.declarationKinds[
                           declarationRow] !=
                           CsgCompilerParserDeclarationLocal ||
                       snapshot.parserSidecars.declarationProducerSourceIds[
                           declarationRow] != nodeSource ||
                       snapshot.spans.startBytes[declarationSpan] >=
                           anchorStart ||
                       snapshot.spans.endBytes[declarationSpan] !=
                           snapshot.spans.endBytes[nodeSpan] ||
                       snapshot.spans.startBytes[
                           snapshot.tokens.spanIds[nameToken]] >=
                           anchorStart:
                        err = " csg compiler snapshot: binding statement declaration authority invalid"
                        return false
                elif statementRole ==
                         CsgCompilerParserStatementTypeDefault:
                    let declarationKind =
                        snapshot.parserSidecars.declarationKinds[
                            declarationRow]
                    let declarationFunctionRow =
                        snapshot.parserSidecars.declarationFunctionRows[
                            declarationRow]
                    let declarationScopeRow =
                        snapshot.parserSidecars.declarationLexicalScopeIds[
                            declarationRow]
                    let declarationScopeKind =
                        snapshot.parserSidecars.declarationLexicalScopeKinds[
                            declarationScopeRow]
                    let typeDeclarationAuthority =
                        declarationKind ==
                            CsgCompilerParserDeclarationType &&
                        declarationScopeKind ==
                            CsgCompilerParserScopeSource
                    let fieldDeclarationAuthority =
                        declarationKind ==
                            CsgCompilerParserDeclarationField &&
                        declarationScopeKind ==
                            CsgCompilerParserScopeType
                    if declarationFunctionRow != -1 ||
                       (!typeDeclarationAuthority &&
                        !fieldDeclarationAuthority) ||
                       snapshot.parserSidecars.declarationProducerSourceIds[
                           declarationRow] != nodeSource ||
                       snapshot.spans.startBytes[declarationSpan] >=
                           anchorStart ||
                       snapshot.spans.endBytes[declarationSpan] <
                           snapshot.spans.endBytes[nodeSpan] ||
                       snapshot.spans.startBytes[
                           snapshot.tokens.spanIds[nameToken]] >=
                           anchorStart:
                        err = " csg compiler snapshot: type default declaration authority invalid"
                        return false
                else:
                    let declarationKind =
                        snapshot.parserSidecars.declarationKinds[
                            declarationRow]
                    let declarationFunctionRow =
                        snapshot.parserSidecars.declarationFunctionRows[
                            declarationRow]
                    let declarationOwnerRow =
                        snapshot.parserSidecars.declarationOwnerIds[
                            declarationRow]
                    let declarationScopeRow =
                        snapshot.parserSidecars.declarationLexicalScopeIds[
                            declarationRow]
                    if declarationKind !=
                           CsgCompilerParserDeclarationParameter ||
                       snapshot.parserSidecars.declarationDefaultStatementRootRows[
                           declarationRow] != row ||
                       declarationFunctionRow < 0 ||
                       declarationOwnerRow < 0 ||
                       snapshot.parserSidecars.declarationKinds[
                           declarationOwnerRow] !=
                           CsgCompilerParserDeclarationFunction ||
                       snapshot.parserSidecars.declarationFunctionRows[
                           declarationOwnerRow] !=
                           declarationFunctionRow ||
                       snapshot.parserSidecars.declarationLexicalScopeKinds[
                           declarationScopeRow] !=
                           CsgCompilerParserScopeFunction ||
                       snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
                           declarationScopeRow] !=
                           declarationOwnerRow ||
                       snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[
                           declarationScopeRow] !=
                           snapshot.parserSidecars.declarationProducerSourceIds[
                               declarationRow] ||
                       snapshot.parserSidecars.declarationProducerSourceIds[
                           declarationRow] != nodeSource ||
                       snapshot.spans.startBytes[declarationSpan] >=
                           anchorStart ||
                       snapshot.spans.endBytes[declarationSpan] !=
                           snapshot.spans.endBytes[nodeSpan] ||
                       snapshot.spans.startBytes[
                           snapshot.tokens.spanIds[nameToken]] >=
                           anchorStart:
                        err = " csg compiler snapshot: parameter default declaration authority invalid"
                        return false
        previousStatementSource = snapshot.parserNodes.sourceIds[node]
    let functionCount = snapshot.parserSidecars.functionIndexes.len
    if functionCount != snapshot.parserSidecars.functionNameTextIds.len ||
       functionCount !=
           snapshot.parserSidecars.functionNameSurfaceKinds.len ||
       functionCount !=
           snapshot.parserSidecars.functionNameProofCids.len ||
       functionCount !=
           snapshot.parserSidecars.functionSignatureLineNumbers.len ||
       functionCount !=
           snapshot.parserSidecars.functionDeclarationSpanIds.len ||
       functionCount !=
           snapshot.parserSidecars.functionDeclarationHeaderCids.len ||
       functionCount !=
           snapshot.parserSidecars.functionDeclarationPathCids.len ||
       functionCount != snapshot.parserSidecars.functionNameSpanIds.len ||
       functionCount != snapshot.parserSidecars.functionBodySpanIds.len ||
       functionCount !=
           snapshot.parserSidecars.functionAnnotationFlags.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals.len ||
       functionCount !=
           snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds.len:
        err = " csg compiler snapshot: parser function columns mismatch"
        return false
    var functionSeen: int32[]
    setLen(functionSeen, functionCount)
    var previousFunctionSource: int32 = -1
    var previousFunctionLine: int32
    for row in 0..<functionCount:
        let functionIndex = snapshot.parserSidecars.functionIndexes[row]
        let declarationSpan =
            snapshot.parserSidecars.functionDeclarationSpanIds[row]
        let nameSpan = snapshot.parserSidecars.functionNameSpanIds[row]
        let bodySpan = snapshot.parserSidecars.functionBodySpanIds[row]
        if !csgCompilerIndexValid(functionIndex, functionCount) ||
           functionSeen[functionIndex] != 0 ||
           !csgCompilerIndexValid(
               snapshot.parserSidecars.functionNameTextIds[row],
               snapshot.texts.len) ||
           !CsgCompilerFunctionAnnotationFlagsValid(
               snapshot.parserSidecars.functionAnnotationFlags[row]) ||
           (snapshot.parserSidecars.functionNameSurfaceKinds[row] != 1 &&
            snapshot.parserSidecars.functionNameSurfaceKinds[row] != 2) ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.functionNameProofCids[row]) ||
           snapshot.parserSidecars.functionSignatureLineNumbers[row] <= 0 ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.functionDeclarationHeaderCids[row]) ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.functionDeclarationPathCids[row]) ||
           !csgCompilerIndexValid(declarationSpan,
                                  snapshot.spans.sourceIds.len) ||
           !csgCompilerIndexValid(nameSpan, snapshot.spans.sourceIds.len) ||
           !csgCompilerIndexValid(bodySpan, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[nameSpan] !=
               snapshot.spans.sourceIds[declarationSpan] ||
           snapshot.spans.sourceIds[bodySpan] !=
               snapshot.spans.sourceIds[declarationSpan] ||
           snapshot.spans.startLines[declarationSpan] + 1 !=
               snapshot.parserSidecars.functionSignatureLineNumbers[row] ||
           snapshot.spans.startLines[nameSpan] + 1 !=
               snapshot.parserSidecars.functionSignatureLineNumbers[row] ||
           snapshot.spans.startBytes[nameSpan] <
               snapshot.spans.startBytes[declarationSpan] ||
           snapshot.spans.endBytes[nameSpan] >
               snapshot.spans.endBytes[declarationSpan] ||
           snapshot.spans.startBytes[bodySpan] <
               snapshot.spans.startBytes[declarationSpan] ||
           snapshot.spans.endBytes[bodySpan] >
               snapshot.spans.endBytes[declarationSpan]:
            err = " csg compiler snapshot: invalid parser function row"
            return false
        let source = snapshot.spans.sourceIds[declarationSpan]
        let signatureLine =
            snapshot.parserSidecars.functionSignatureLineNumbers[row]
        if source < previousFunctionSource ||
           (source == previousFunctionSource &&
            signatureLine <= previousFunctionLine):
            err = " csg compiler snapshot: parser functions are not canonical"
            return false
        functionSeen[functionIndex] = 1
        previousFunctionSource = source
        previousFunctionLine = signatureLine
    for functionIndex in 0..<functionSeen.len:
        if functionSeen[functionIndex] != 1:
            err = " csg compiler snapshot: parser function coverage mismatch"
            return false
    if !csgCompilerParserDeclarationsValidateInto(snapshot, err):
        return false
    if !csgCompilerParserManualConsumeValidateInto(snapshot, err):
        return false
    if !csgCompilerParserPatternsValidateInto(snapshot, err):
        return false
    var declarationStarts: int32[]
    var declarationCounts: int32[]
    var patternStarts: int32[]
    var patternCounts: int32[]
    setLen(declarationStarts, sourceCount)
    setLen(declarationCounts, sourceCount)
    setLen(patternStarts, sourceCount)
    setLen(patternCounts, sourceCount)
    for source in 0..<sourceCount:
        declarationStarts[source] = -1
        patternStarts[source] = -1
    for declarationRow in 0..<
            snapshot.parserSidecars.declarationKinds.len:
        let source =
            snapshot.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        if declarationStarts[source] < 0:
            declarationStarts[source] = declarationRow
        declarationCounts[source] = declarationCounts[source] + 1
    for patternRow in 0..<snapshot.parserSidecars.patternKinds.len:
        let source =
            snapshot.parserSidecars.patternProducerSourceIds[patternRow]
        if patternStarts[source] < 0:
            patternStarts[source] = patternRow
        patternCounts[source] = patternCounts[source] + 1
    for parserNodeId in 0..<count:
        let resolutionKind =
            snapshot.parserNodes.bindingResolutionKinds[parserNodeId]
        if resolutionKind ==
               CsgCompilerParserBindingResolutionNone:
            continue
        let source = snapshot.parserNodes.sourceIds[parserNodeId]
        let declarationSourceLocalRow =
            snapshot.parserNodes.bindingDeclarationSourceLocalRows[
                parserNodeId]
        let patternSourceLocalRow =
            snapshot.parserNodes.bindingPatternSourceLocalRows[
                parserNodeId]
        if declarationSourceLocalRow < 0 ||
           declarationSourceLocalRow >= declarationCounts[source] ||
           declarationStarts[source] < 0:
            err = " csg compiler snapshot: parser binding declaration missing"
            return false
        let declarationRow =
            declarationStarts[source] + declarationSourceLocalRow
        if resolutionKind ==
               CsgCompilerParserBindingResolutionParameter:
            if snapshot.parserSidecars.declarationKinds[declarationRow] !=
                   CsgCompilerParserDeclarationParameter ||
               patternSourceLocalRow != -1:
                err = " csg compiler snapshot: parser parameter binding invalid"
                return false
            continue
        if patternSourceLocalRow < 0 ||
           patternSourceLocalRow >= patternCounts[source] ||
           patternStarts[source] < 0:
            err = " csg compiler snapshot: parser Pattern binding missing"
            return false
        let patternRow = patternStarts[source] + patternSourceLocalRow
        if snapshot.parserSidecars.declarationKinds[declarationRow] !=
               CsgCompilerParserDeclarationLocal ||
           snapshot.parserSidecars.patternBindingDeclarationIds[
               patternRow] != declarationRow:
            err = " csg compiler snapshot: parser Pattern binding invalid"
            return false
    if !csgCompilerParserGenericAnnotationValidateInto(snapshot, err):
        return false
    if !csgCompilerParserNormalizedExprIdentitiesValidateInto(
           snapshot, err):
        return false
    return true

fn csgCompilerTypeKindValid(kind: int32): bool =
    return kind >= CsgCompilerTypeScalar &&
           kind <= CsgCompilerTypeGenericParameter

fn csgCompilerScalarKindValid(kind: int32): bool =
    return kind >= CsgCompilerScalarBool &&
           kind <= CsgCompilerScalarBytesView

fn csgCompilerConstArgValid(kind: int32, value: int32): bool =
    if kind == CsgCompilerConstArgInt32:
        return true
    if kind == CsgCompilerConstArgBool:
        return value == 0 || value == 1
    if kind == CsgCompilerConstArgChar:
        return value >= 0 && value <= 1114111 &&
               (value < 55296 || value > 57343)
    return false

fn csgCompilerValueProofKindValid(kind: int32): bool =
    return kind >= CsgCompilerValueProofTypeTrait &&
           kind <= CsgCompilerValueProofBoundary

fn csgCompilerValueKindValid(kind: int32): bool =
    return kind >= CsgCompilerValueOrdinary &&
           kind <= CsgCompilerValueClosure

fn csgCompilerShareKindValid(kind: int32): bool =
    return kind >= CsgCompilerShareNone &&
           kind <= CsgCompilerShareThreadSafe

fn csgCompilerTypeCidAppendU32(buf: var layout.ByteBuf,
                               value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn csgCompilerTypeCidAppendText(buf: var layout.ByteBuf, value: str) =
    csgCompilerTypeCidAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn csgCompilerExternFfiHandlePortablePreamble(
        buf: var layout.ByteBuf,
        domain: str) =
    csgCompilerTypeCidAppendText(buf, domain)
    csgCompilerTypeCidAppendText(buf, CsgCompilerStandardIdentity)
    csgCompilerTypeCidAppendText(
        buf, CsgCompilerExternFfiHandleSchemaIdentity)
    csgCompilerTypeCidAppendText(buf, CsgCompilerNativeProfileIdentity)

fn csgCompilerExternFfiHandleAbiCarrierText(
        carrierKind: int32): str =
    if carrierKind == CsgCompilerExternFfiHandleAbiCarrierUInt32:
        return "csg.scalar.uint32"
    if carrierKind == CsgCompilerExternFfiHandleAbiCarrierUInt64:
        return "csg.scalar.uint64"
    return ""

fn CsgCompilerExternFfiHandleTypeCid(
        carrierKind: int32): layout.FixedBytes32 =
    let widthBits =
        carrierKind == CsgCompilerExternFfiHandleAbiCarrierUInt32 ? 32 :
        carrierKind == CsgCompilerExternFfiHandleAbiCarrierUInt64 ? 64 : 0
    let carrierText =
        csgCompilerExternFfiHandleAbiCarrierText(carrierKind)
    if widthBits == 0 || carrierText == "":
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(192)
    csgCompilerExternFfiHandlePortablePreamble(
        buf, CsgCompilerExternFfiHandleTypeDomain)
    csgCompilerTypeCidAppendU32(buf, widthBits)
    csgCompilerTypeCidAppendText(buf, carrierText)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CsgCompilerExternFfiHandleParameterSymbolCid(
        functionSymbolCid: layout.FixedBytes32,
        ordinal: int32,
        typeCid: layout.FixedBytes32,
        carrierKind: int32): layout.FixedBytes32 =
    if !csgCompilerCidObserved(functionSymbolCid) || ordinal < 0 ||
       !csgCompilerCidObserved(typeCid) ||
       csgCompilerExternFfiHandleAbiCarrierText(carrierKind) == "":
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(224)
    csgCompilerExternFfiHandlePortablePreamble(
        buf, CsgCompilerExternFfiHandleParameterSymbolDomain)
    layout.ByteBufAppendFixed32(buf, functionSymbolCid)
    csgCompilerTypeCidAppendU32(buf, ordinal)
    layout.ByteBufAppendFixed32(buf, typeCid)
    csgCompilerTypeCidAppendText(
        buf, csgCompilerExternFfiHandleAbiCarrierText(carrierKind))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CsgCompilerExternFfiHandleEffectCid(
        functionSymbolCid: layout.FixedBytes32,
        effectKind: int32,
        targetKind: int32,
        parameterOrdinal: int32,
        parameterSymbolCid: layout.FixedBytes32,
        typeCid: layout.FixedBytes32,
        carrierKind: int32): layout.FixedBytes32 =
    if !csgCompilerCidObserved(functionSymbolCid) ||
       !csgCompilerCidObserved(typeCid) ||
       csgCompilerExternFfiHandleAbiCarrierText(carrierKind) == "":
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(288)
    csgCompilerExternFfiHandlePortablePreamble(
        buf, CsgCompilerExternFfiHandleEffectDomain)
    layout.ByteBufAppendFixed32(buf, functionSymbolCid)
    csgCompilerTypeCidAppendU32(buf, effectKind)
    csgCompilerTypeCidAppendU32(buf, targetKind)
    csgCompilerTypeCidAppendU32(buf, parameterOrdinal + 1)
    layout.ByteBufAppendFixed32(buf, parameterSymbolCid)
    layout.ByteBufAppendFixed32(buf, typeCid)
    csgCompilerTypeCidAppendText(
        buf, csgCompilerExternFfiHandleAbiCarrierText(carrierKind))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CsgCompilerExternFfiHandleContractCidInto(
        table: CsgCompilerExternFfiHandleContractTable,
        contractRow: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    if !csgCompilerIndexValid(contractRow, table.functionSymbolCids.len) ||
       contractRow >= table.unwindKinds.len ||
       contractRow >= table.effectStarts.len ||
       contractRow >= table.effectCounts.len:
        err = " csg compiler snapshot: ffi handle contract row missing"
        return false
    let effectStart = table.effectStarts[contractRow]
    let effectCount = table.effectCounts[contractRow]
    if effectStart < 0 || effectCount < 0 ||
       effectStart > table.effectCids.len ||
       effectCount > table.effectCids.len - effectStart:
        err = " csg compiler snapshot: ffi handle contract CSR invalid"
        return false
    var buf = layout.ByteBufInit(224 + effectCount * 32)
    csgCompilerExternFfiHandlePortablePreamble(
        buf, CsgCompilerExternFfiHandleContractDomain)
    layout.ByteBufAppendFixed32(
        buf, table.functionSymbolCids[contractRow])
    csgCompilerTypeCidAppendU32(
        buf, table.unwindKinds[contractRow])
    csgCompilerTypeCidAppendU32(buf, effectCount)
    for effectOffset in 0..<effectCount:
        layout.ByteBufAppendFixed32(
            buf, table.effectCids[effectStart + effectOffset])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn CsgCompilerExternFfiHandleInterfaceCid(
        functionSymbolCid: layout.FixedBytes32,
        contractCid: layout.FixedBytes32): layout.FixedBytes32 =
    if !csgCompilerCidObserved(functionSymbolCid) ||
       !csgCompilerCidObserved(contractCid):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(224)
    csgCompilerExternFfiHandlePortablePreamble(
        buf, CsgCompilerExternFfiHandleInterfaceDomain)
    layout.ByteBufAppendFixed32(buf, functionSymbolCid)
    layout.ByteBufAppendFixed32(buf, contractCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CsgCompilerExternFfiHandleCargoCid(
        table: CsgCompilerExternFfiHandleContractTable): layout.FixedBytes32 =
    var sortedInterfaces = csgCompilerCloneCidArray(table.interfaceCids)
    for row in 1..<sortedInterfaces.len:
        let current = sortedInterfaces[row]
        var prior = row - 1
        while prior >= 0 &&
              csgCompilerCidLess(current, sortedInterfaces[prior]):
            sortedInterfaces[prior + 1] = sortedInterfaces[prior]
            prior = prior - 1
        sortedInterfaces[prior + 1] = current
    var buf = layout.ByteBufInit(192 + sortedInterfaces.len * 32)
    csgCompilerExternFfiHandlePortablePreamble(
        buf, CsgCompilerExternFfiHandleCargoDomain)
    csgCompilerTypeCidAppendU32(buf, sortedInterfaces.len)
    for row in 0..<sortedInterfaces.len:
        layout.ByteBufAppendFixed32(buf, sortedInterfaces[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn csgCompilerTypeCidAppendOptionalSymbol(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        symbolId: int32) =
    csgCompilerTypeCidAppendU32(buf, symbolId >= 0 ? 1 : 0)
    if symbolId >= 0:
        layout.ByteBufAppendFixed32(buf, snapshot.symbols.symbolCids[symbolId])

@borrows
fn csgCompilerTypeCidAppendOptionalType(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32) =
    csgCompilerTypeCidAppendU32(buf, typeId >= 0 ? 1 : 0)
    if typeId >= 0:
        layout.ByteBufAppendFixed32(buf, snapshot.types.typeCids[typeId])

@borrows
fn CsgCompilerFunctionManualConsumeEffectCidInto(
        snapshot: CsgCompilerSnapshotTables,
        functionId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    err = ""
    if !csgCompilerIndexValid(
           functionId, snapshot.functions.symbolIds.len) ||
       functionId >= snapshot.functions.bodySpanIds.len ||
       functionId >= snapshot.functions.typedFunctionIndexes.len ||
       functionId >= snapshot.functions.annotationFlags.len ||
       functionId >=
           snapshot.functions.manualConsumeTargetParameterSymbolIds.len ||
       functionId >=
           snapshot.functions.manualConsumeSourceParameterSymbolIds.len:
        err = " csg compiler snapshot: manual consume Function row missing"
        return false
    let functionSymbol = snapshot.functions.symbolIds[functionId]
    let bodySpan = snapshot.functions.bodySpanIds[functionId]
    let producerFunctionIndex =
        snapshot.functions.typedFunctionIndexes[functionId]
    let targetSymbol =
        snapshot.functions.manualConsumeTargetParameterSymbolIds[
            functionId]
    let sourceSymbol =
        snapshot.functions.manualConsumeSourceParameterSymbolIds[
            functionId]
    var parserFunctionRow: int32 = -1
    for row in 0..<snapshot.parserSidecars.functionIndexes.len:
        let parserFunctionId =
            snapshot.parserSidecars.functionIndexes[row]
        if !csgCompilerIndexValid(
               parserFunctionId,
               snapshot.functions.typedFunctionIndexes.len) ||
           snapshot.functions.typedFunctionIndexes[parserFunctionId] !=
               producerFunctionIndex:
            continue
        if parserFunctionId != functionId:
            err = " csg compiler snapshot: manual consume Function identity crossed"
            return false
        if parserFunctionRow >= 0:
            err = " csg compiler snapshot: manual consume parser Function ambiguous"
            return false
        parserFunctionRow = row
    if producerFunctionIndex < 0 ||
       producerFunctionIndex >= snapshot.functions.symbolIds.len ||
       parserFunctionRow < 0 ||
       parserFunctionRow >=
           snapshot.parserSidecars.functionBodySpanIds.len ||
       snapshot.parserSidecars.functionBodySpanIds[parserFunctionRow] !=
           bodySpan ||
       parserFunctionRow >=
           snapshot.parserSidecars.functionAnnotationFlags.len ||
       parserFunctionRow >=
           snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals.len ||
       parserFunctionRow >=
           snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds.len ||
       parserFunctionRow >=
           snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals.len ||
       parserFunctionRow >=
           snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds.len:
        err = " csg compiler snapshot: manual consume parser Function missing"
        return false
    let functionPresent =
        CsgCompilerFunctionAnnotationHas(
            snapshot.functions.annotationFlags[functionId],
            CsgCompilerFunctionAnnotationManualConsume)
    let parserPresent =
        CsgCompilerFunctionAnnotationHas(
            snapshot.parserSidecars.functionAnnotationFlags[
                parserFunctionRow],
            CsgCompilerFunctionAnnotationManualConsume)
    if functionPresent != parserPresent:
        err = " csg compiler snapshot: manual consume presence drift"
        return false
    if !functionPresent:
        if targetSymbol != -1 || sourceSymbol != -1:
            err = " csg compiler snapshot: absent manual consume Symbol relation invalid"
            return false
        return true
    let targetOrdinal =
        snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals[
            parserFunctionRow]
    let sourceOrdinal =
        snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals[
            parserFunctionRow]
    let targetParserDeclaration =
        snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
            parserFunctionRow]
    let sourceParserDeclaration =
        snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
            parserFunctionRow]
    if !csgCompilerIndexValid(
           functionSymbol, snapshot.symbols.declKeyCids.len) ||
       !csgCompilerIndexValid(
           targetSymbol, snapshot.symbols.declKeyCids.len) ||
       !csgCompilerIndexValid(
           sourceSymbol, snapshot.symbols.declKeyCids.len) ||
       targetSymbol == sourceSymbol ||
       snapshot.symbols.symbolKinds[targetSymbol] !=
           CsgCompilerSymbolParameter ||
       snapshot.symbols.symbolKinds[sourceSymbol] !=
           CsgCompilerSymbolParameter ||
       snapshot.symbols.ownerSymbolIds[targetSymbol] != functionSymbol ||
       snapshot.symbols.ownerSymbolIds[sourceSymbol] != functionSymbol ||
       !csgCompilerIndexValid(
           targetParserDeclaration,
           snapshot.parserSidecars.declarationKinds.len) ||
       !csgCompilerIndexValid(
           sourceParserDeclaration,
           snapshot.parserSidecars.declarationKinds.len) ||
       snapshot.parserSidecars.declarationKinds[
           targetParserDeclaration] !=
           CsgCompilerParserDeclarationParameter ||
       snapshot.parserSidecars.declarationKinds[
           sourceParserDeclaration] !=
           CsgCompilerParserDeclarationParameter ||
       snapshot.symbols.sourceIds[targetSymbol] !=
           snapshot.parserSidecars.declarationProducerSourceIds[
               targetParserDeclaration] ||
       snapshot.symbols.sourceIds[sourceSymbol] !=
           snapshot.parserSidecars.declarationProducerSourceIds[
               sourceParserDeclaration] ||
       snapshot.symbols.nameTokenIds[targetSymbol] !=
           snapshot.parserSidecars.declarationNameTokenIds[
               targetParserDeclaration] ||
       snapshot.symbols.nameTokenIds[sourceSymbol] !=
           snapshot.parserSidecars.declarationNameTokenIds[
               sourceParserDeclaration] ||
       snapshot.symbols.nameSpanIds[targetSymbol] !=
           snapshot.parserSidecars.declarationNameSpanIds[
               targetParserDeclaration] ||
       snapshot.symbols.nameSpanIds[sourceSymbol] !=
           snapshot.parserSidecars.declarationNameSpanIds[
               sourceParserDeclaration] ||
       snapshot.symbols.declarationSpanIds[targetSymbol] !=
           snapshot.parserSidecars.declarationSpanIds[
               targetParserDeclaration] ||
       snapshot.symbols.declarationSpanIds[sourceSymbol] !=
           snapshot.parserSidecars.declarationSpanIds[
               sourceParserDeclaration]:
        err = " csg compiler snapshot: manual consume parameter Symbol authority invalid"
        return false
    let targetTypeId = snapshot.symbols.typeIds[targetSymbol]
    let sourceTypeId = snapshot.symbols.typeIds[sourceSymbol]
    if !csgCompilerIndexValid(targetTypeId, snapshot.types.typeCids.len) ||
       !csgCompilerIndexValid(sourceTypeId, snapshot.types.typeCids.len) ||
       targetTypeId == sourceTypeId ||
       snapshot.types.typeKinds[targetTypeId] !=
           CsgCompilerTypeBorrow ||
       snapshot.types.elementTypeIds[targetTypeId] != sourceTypeId ||
       snapshot.types.typeKinds[sourceTypeId] !=
           CsgCompilerTypeSequence ||
       !snapshot.types.managedFlags[sourceTypeId] ||
       targetOrdinal < 0 || sourceOrdinal < 0 ||
       targetOrdinal == sourceOrdinal:
        err = " csg compiler snapshot: manual consume parameter Type relation invalid"
        return false
    var buf = layout.ByteBufInit(256)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.manual_consume_effect")
    layout.ByteBufAppendFixed32(
        buf, snapshot.symbols.declKeyCids[functionSymbol])
    layout.ByteBufAppendFixed32(
        buf, snapshot.symbols.declKeyCids[targetSymbol])
    layout.ByteBufAppendFixed32(
        buf, snapshot.symbols.declKeyCids[sourceSymbol])
    csgCompilerTypeCidAppendU32(buf, targetOrdinal)
    csgCompilerTypeCidAppendU32(buf, sourceOrdinal)
    layout.ByteBufAppendFixed32(
        buf, snapshot.types.typeCids[targetTypeId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.types.typeCids[sourceTypeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    if !csgCompilerCidObserved(out):
        err = " csg compiler snapshot: manual consume effect CID invalid"
        return false
    return true

@borrows
fn csgCompilerTypeCidAppendOptionalText(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        textId: int32) =
    csgCompilerTypeCidAppendU32(buf, textId >= 0 ? 1 : 0)
    if textId >= 0:
        csgCompilerTypeCidAppendText(buf, snapshot.texts[textId])

@borrows
fn CsgCompilerGenericParameterIdentityCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    if !csgCompilerIndexValid(
           typeId, snapshot.types.genericParameterParserRows.len):
        err = " csg compiler snapshot: generic parameter Type row missing"
        return false
    let parserRow = snapshot.types.genericParameterParserRows[typeId]
    if !csgCompilerIndexValid(
           parserRow,
           snapshot.parserSidecars.typeGenericSymbolProducerSourceIds.len) ||
       parserRow >=
           snapshot.parserSidecars.typeGenericSymbolIdentityCids.len ||
       !csgCompilerCidObserved(
           snapshot.parserSidecars.typeGenericSymbolIdentityCids[parserRow]):
        err = " csg compiler snapshot: generic parameter Type identity missing"
        return false
    out = snapshot.parserSidecars.typeGenericSymbolIdentityCids[parserRow]
    err = ""
    return true

@borrows
fn csgCompilerTypeStructureAppendInto(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32,
        err: var str): bool =
    let count = snapshot.types.typeCids.len
    let declSymbolId = snapshot.types.declSymbolIds[typeId]
    let elementTypeId = snapshot.types.elementTypeIds[typeId]
    let argStart = snapshot.types.argStarts[typeId]
    let argCount = snapshot.types.argCounts[typeId]
    let constArgStart = snapshot.types.constArgStarts[typeId]
    let constArgCount = snapshot.types.constArgCounts[typeId]
    let aliasTargetTypeId = snapshot.types.aliasTargetTypeIds[typeId]
    # [phaseB-enum-schema] Defensive column-length guards: a misprojected
    # table must fail closed here instead of indexing out of bounds.
    let variantStart = typeId < snapshot.types.variantStarts.len ?
        snapshot.types.variantStarts[typeId] : -1
    let variantCount = typeId < snapshot.types.variantCounts.len ?
        snapshot.types.variantCounts[typeId] : -1
    if !csgCompilerOptionalIndexValid(
           declSymbolId, snapshot.symbols.symbolCids.len) ||
       !csgCompilerOptionalIndexValid(elementTypeId, count) ||
       !csgCompilerOptionalIndexValid(aliasTargetTypeId, count) ||
       argStart < 0 || argCount < 0 ||
       argStart > snapshot.types.argTypeIds.len ||
       argCount > snapshot.types.argTypeIds.len - argStart ||
       snapshot.types.argNameTextIds.len !=
           snapshot.types.argTypeIds.len ||
       constArgStart < 0 || constArgCount < 0 ||
       constArgStart > snapshot.types.constArgKinds.len ||
       constArgCount > snapshot.types.constArgKinds.len - constArgStart ||
       snapshot.types.constArgKinds.len !=
           snapshot.types.constArgValues.len ||
       variantStart < 0 || variantCount < 0 ||
       variantStart > snapshot.types.variantNameTextIds.len ||
       variantCount > snapshot.types.variantNameTextIds.len - variantStart ||
       snapshot.types.variantOrdinals.len !=
           snapshot.types.variantNameTextIds.len ||
       snapshot.types.variantPayloadTypeIds.len !=
           snapshot.types.variantNameTextIds.len:
        err = " csg compiler snapshot: invalid type structure row"
        return false
    csgCompilerTypeCidAppendU32(buf, snapshot.types.typeKinds[typeId])
    csgCompilerTypeCidAppendU32(buf, snapshot.types.scalarKinds[typeId])
    if snapshot.types.typeKinds[typeId] ==
           CsgCompilerTypeGenericParameter:
        var genericIdentityCid: layout.FixedBytes32
        if !CsgCompilerGenericParameterIdentityCidInto(
               snapshot, typeId, genericIdentityCid, err):
            return false
        layout.ByteBufAppendFixed32(buf, genericIdentityCid)
    else:
        layout.ByteBufAppendFixed32(buf, layout.FixedBytes32())
    let nominalDeclaration =
        snapshot.types.typeKinds[typeId] == CsgCompilerTypeObject ||
        snapshot.types.typeKinds[typeId] == CsgCompilerTypeRefObject ||
        snapshot.types.typeKinds[typeId] == CsgCompilerTypeEnum
    if nominalDeclaration:
        csgCompilerTypeCidAppendU32(buf, declSymbolId >= 0 ? 1 : 0)
        if declSymbolId >= 0:
            if declSymbolId >=
                   snapshot.symbols.declarationPathCids.len ||
               !csgCompilerCidObserved(
                   snapshot.symbols.declarationPathCids[declSymbolId]):
                err = " csg compiler snapshot: nominal declaration path CID missing"
                return false
            layout.ByteBufAppendFixed32(
                buf,
                snapshot.symbols.declarationPathCids[declSymbolId])
    else:
        csgCompilerTypeCidAppendOptionalSymbol(
            buf, snapshot, declSymbolId)
    # [phaseB-enum-schema] A CsgCompilerTypeEnum row's exact declaration
    # data is its variant payload rows: ordinal, canonical name text and
    # the referenced payload TypeCid (or the payloadless marker). Every
    # other kind has zero variant rows, so its preimage is unchanged.
    if snapshot.types.typeKinds[typeId] == CsgCompilerTypeEnum:
        csgCompilerTypeCidAppendU32(buf, variantCount)
        for variantOffset in 0..<variantCount:
            let variantRow = variantStart + variantOffset
            let variantNameTextId =
                snapshot.types.variantNameTextIds[variantRow]
            let variantOrdinal =
                snapshot.types.variantOrdinals[variantRow]
            let variantPayloadTypeId =
                snapshot.types.variantPayloadTypeIds[variantRow]
            if variantNameTextId < 0 ||
               variantNameTextId >= snapshot.texts.len ||
               variantOrdinal != variantOffset ||
               !csgCompilerOptionalIndexValid(variantPayloadTypeId, count):
                err = " csg compiler snapshot: invalid enum variant payload row"
                return false
            csgCompilerTypeCidAppendU32(buf, variantOrdinal)
            csgCompilerTypeCidAppendText(
                buf, snapshot.texts[variantNameTextId])
            csgCompilerTypeCidAppendOptionalType(
                buf, snapshot, variantPayloadTypeId)
    csgCompilerTypeCidAppendOptionalType(buf, snapshot, elementTypeId)
    csgCompilerTypeCidAppendU32(buf, snapshot.types.arrayLengths[typeId])
    csgCompilerTypeCidAppendU32(buf, argCount)
    for offset in 0..<argCount:
        let argRow = argStart + offset
        let argTypeId = snapshot.types.argTypeIds[argRow]
        let argNameTextId = snapshot.types.argNameTextIds[argRow]
        if !csgCompilerIndexValid(argTypeId, count) ||
           !csgCompilerOptionalIndexValid(
               argNameTextId, snapshot.texts.len) ||
           (snapshot.types.typeKinds[typeId] !=
                CsgCompilerTypeTuple &&
            snapshot.types.typeKinds[typeId] !=
                CsgCompilerTypeObject &&
            snapshot.types.typeKinds[typeId] !=
                CsgCompilerTypeRefObject &&
            argNameTextId >= 0):
            err = " csg compiler snapshot: invalid type argument identity"
            return false
        layout.ByteBufAppendFixed32(buf, snapshot.types.typeCids[argTypeId])
        csgCompilerTypeCidAppendOptionalText(
            buf, snapshot, argNameTextId)
    csgCompilerTypeCidAppendU32(buf, constArgCount)
    for offset in 0..<constArgCount:
        let row = constArgStart + offset
        if !csgCompilerConstArgValid(
               snapshot.types.constArgKinds[row],
               snapshot.types.constArgValues[row]):
            err = " csg compiler snapshot: invalid const type argument"
            return false
        csgCompilerTypeCidAppendU32(buf, snapshot.types.constArgKinds[row])
        csgCompilerTypeCidAppendU32(buf, snapshot.types.constArgValues[row])
    csgCompilerTypeCidAppendOptionalType(buf, snapshot, aliasTargetTypeId)
    csgCompilerTypeCidAppendU32(
        buf, snapshot.types.traitConclusionKinds[typeId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.types.managedFlags[typeId] ? 1 : 0)
    csgCompilerTypeCidAppendU32(
        buf, snapshot.types.sendFlags[typeId] ? 1 : 0)
    csgCompilerTypeCidAppendU32(
        buf, snapshot.types.syncFlags[typeId] ? 1 : 0)
    return true

@borrows
fn csgCompilerTypeTraitPremisesExact(
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32): bool =
    let kind = snapshot.types.typeKinds[typeId]
    let start = snapshot.types.traitPremiseStarts[typeId]
    let count = snapshot.types.traitPremiseCounts[typeId]
    if start < 0 || count < 0 ||
       start > snapshot.types.traitPremiseTypeIds.len ||
       count > snapshot.types.traitPremiseTypeIds.len - start:
        return false
    if kind == CsgCompilerTypeScalar ||
       kind == CsgCompilerTypeGenericParameter:
        return count == 0
# [d1-dead-premise] reserved ordinal 5; no producer kind in TypedExprIr type arena (:14-29); dead until ref T ruling (wire ordinal held; branch kept as the ref-T wiring-day shape precedent).
    if kind == CsgCompilerTypeReference ||
       kind == CsgCompilerTypeBorrow ||
       kind == CsgCompilerTypeSequence ||
       kind == CsgCompilerTypeArray:
        return count == 1 &&
               snapshot.types.traitPremiseTypeIds[start] ==
                   snapshot.types.elementTypeIds[typeId]
    if kind == CsgCompilerTypeTuple:
        if count != snapshot.types.argCounts[typeId]:
            return false
        for offset in 0..<count:
            if snapshot.types.traitPremiseTypeIds[start + offset] !=
               snapshot.types.argTypeIds[
                   snapshot.types.argStarts[typeId] + offset]:
                return false
        return true
    if kind == CsgCompilerTypeFunction:
        if count != snapshot.types.argCounts[typeId] + 1 ||
           snapshot.types.traitPremiseTypeIds[start] !=
               snapshot.types.elementTypeIds[typeId]:
            return false
        for offset in 0..<snapshot.types.argCounts[typeId]:
            if snapshot.types.traitPremiseTypeIds[start + offset + 1] !=
               snapshot.types.argTypeIds[
                   snapshot.types.argStarts[typeId] + offset]:
                return false
        return true
    if kind == CsgCompilerTypeAlias:
        return count == 1 &&
               snapshot.types.traitPremiseTypeIds[start] ==
                   snapshot.types.aliasTargetTypeIds[typeId]
    if kind == CsgCompilerTypeObject ||
       kind == CsgCompilerTypeRefObject:
        if snapshot.types.argCounts[typeId] != count:
            return false
        for offset in 0..<count:
            if snapshot.types.traitPremiseTypeIds[start + offset] !=
                   snapshot.types.argTypeIds[
                       snapshot.types.argStarts[typeId] + offset]:
                return false
        return true
    if kind == CsgCompilerTypeEnum:
        # [phaseB-enum-schema] The enum row's trait premises are exactly its
        # declared payload rows: one premise per payload-bearing variant, in
        # declaration (ordinal) order. Payloadless variants contribute none,
        # so a payload-free enum legitimately has zero premises. Row
        # presence is guarded by the per-row CSR columns only; the flat
        # columns are sliced by start/total, never by row index.
        if typeId >= snapshot.types.variantStarts.len ||
           typeId >= snapshot.types.variantCounts.len ||
           snapshot.types.variantOrdinals.len !=
               snapshot.types.variantNameTextIds.len ||
           snapshot.types.variantPayloadTypeIds.len !=
               snapshot.types.variantOrdinals.len:
            return false
        let variantStartRow = snapshot.types.variantStarts[typeId]
        let variantTotal = snapshot.types.variantCounts[typeId]
        if variantStartRow < 0 || variantTotal < 0 ||
           variantStartRow > snapshot.types.variantOrdinals.len ||
           variantTotal >
               snapshot.types.variantOrdinals.len - variantStartRow:
            return false
        var premiseSeen: int32
        for variantOffset in 0..<variantTotal:
            let variantRow = variantStartRow + variantOffset
            if snapshot.types.variantOrdinals[variantRow] != variantOffset:
                return false
            let payloadTypeId =
                snapshot.types.variantPayloadTypeIds[variantRow]
            if payloadTypeId < 0:
                continue
            if premiseSeen >= count ||
               snapshot.types.traitPremiseTypeIds[
                   start + premiseSeen] != payloadTypeId:
                return false
            premiseSeen = premiseSeen + 1
        return premiseSeen == count
    # Enum variant payload identity has no exact schema table yet.
    return false

@borrows
fn csgCompilerTypeTraitsDerivedInto(
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32,
        managedOut: var bool,
        sendOut: var bool,
        syncOut: var bool,
        err: var str): bool =
    if !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) ||
       typeId >= snapshot.types.typeKinds.len ||
       typeId >= snapshot.types.scalarKinds.len ||
       typeId >= snapshot.types.traitPremiseStarts.len ||
       typeId >= snapshot.types.traitPremiseCounts.len ||
       !csgCompilerTypeTraitPremisesExact(snapshot, typeId):
        err = " csg compiler snapshot: type trait premises are not exact"
        return false
    let kind = snapshot.types.typeKinds[typeId]
    if kind == CsgCompilerTypeScalar:
        let scalarKind = snapshot.types.scalarKinds[typeId]
        managedOut = scalarKind == CsgCompilerScalarStr
        sendOut = scalarKind != CsgCompilerScalarStr &&
                  scalarKind != CsgCompilerScalarCString &&
                  scalarKind != CsgCompilerScalarPtr &&
                  scalarKind != CsgCompilerScalarUtf8View &&
                  scalarKind != CsgCompilerScalarBytesView &&
                  scalarKind != CsgCompilerScalarTypedesc
        syncOut = sendOut
        return true
# [d1-dead-premise] reserved ordinal 5; no producer kind in TypedExprIr type arena (:14-29); dead until ref T ruling (wire ordinal held; branch kept as the ref-T wiring-day shape precedent).
    if kind == CsgCompilerTypeReference || kind == CsgCompilerTypeBorrow:
        managedOut = false
        sendOut = false
        syncOut = false
        return true
    if kind == CsgCompilerTypeGenericParameter:
        managedOut = true
        sendOut = false
        syncOut = false
        return true
    if kind == CsgCompilerTypeSequence:
        managedOut = true
        sendOut = false
        syncOut = false
        return true
    if kind == CsgCompilerTypeFunction:
        # This row is a signature, not a function value.  `&fnName` and
        # closure capture proofs belong to the TypedNode value rule.
        managedOut = false
        sendOut = false
        syncOut = false
        return true
    if kind == CsgCompilerTypeArray || kind == CsgCompilerTypeTuple:
        managedOut = false
        sendOut = true
        syncOut = true
        let start = snapshot.types.traitPremiseStarts[typeId]
        for offset in 0..<snapshot.types.traitPremiseCounts[typeId]:
            let premiseTypeId =
                snapshot.types.traitPremiseTypeIds[start + offset]
            if !csgCompilerIndexValid(
                   premiseTypeId, snapshot.types.typeCids.len):
                err = " csg compiler snapshot: type trait premise out of range"
                return false
            managedOut = managedOut ||
                snapshot.types.managedFlags[premiseTypeId]
            sendOut = sendOut && snapshot.types.sendFlags[premiseTypeId]
            syncOut = syncOut && snapshot.types.syncFlags[premiseTypeId]
        return true
    # [phaseB-enum-schema] An enum row derives exactly like an object row
    # over its premises (the payload-bearing variant rows): managed if any
    # payload is managed, Send/Sync only if every payload is. This mirrors
    # the producer's EnumVariantsRecursive trait rule.
    if kind == CsgCompilerTypeObject || kind == CsgCompilerTypeEnum:
        managedOut = false
        sendOut = true
        syncOut = true
        let start = snapshot.types.traitPremiseStarts[typeId]
        for offset in 0..<snapshot.types.traitPremiseCounts[typeId]:
            let premiseTypeId =
                snapshot.types.traitPremiseTypeIds[start + offset]
            if !csgCompilerIndexValid(
                   premiseTypeId, snapshot.types.typeCids.len):
                err = " csg compiler snapshot: object trait premise out of range"
                return false
            managedOut = managedOut ||
                snapshot.types.managedFlags[premiseTypeId]
            sendOut = sendOut &&
                snapshot.types.sendFlags[premiseTypeId]
            syncOut = syncOut &&
                snapshot.types.syncFlags[premiseTypeId]
        return true
    if kind == CsgCompilerTypeRefObject:
        managedOut = true
        sendOut = false
        syncOut = false
        return true
    if kind == CsgCompilerTypeAlias:
        let premiseTypeId = snapshot.types.traitPremiseTypeIds[
            snapshot.types.traitPremiseStarts[typeId]]
        if !csgCompilerIndexValid(
               premiseTypeId, snapshot.types.typeCids.len):
            err = " csg compiler snapshot: alias trait premise out of range"
            return false
        managedOut = snapshot.types.managedFlags[premiseTypeId]
        sendOut = snapshot.types.sendFlags[premiseTypeId]
        syncOut = snapshot.types.syncFlags[premiseTypeId]
        return true
    err = " csg compiler snapshot: declaration trait authority is missing"
    return false

# Trait proof identity is a deterministic receipt over exact constructors,
# dependencies and the three immutable type properties.  A nonzero arbitrary
# CID is never accepted.
@borrows
fn CsgCompilerTypeTraitProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) ||
       typeId >= snapshot.types.typeKinds.len ||
       typeId >= snapshot.types.scalarKinds.len ||
       typeId >= snapshot.types.declSymbolIds.len ||
       typeId >= snapshot.types.elementTypeIds.len ||
       typeId >= snapshot.types.arrayLengths.len ||
       typeId >= snapshot.types.argStarts.len ||
       typeId >= snapshot.types.argCounts.len ||
       typeId >= snapshot.types.constArgStarts.len ||
       typeId >= snapshot.types.constArgCounts.len ||
       typeId >= snapshot.types.aliasTargetTypeIds.len ||
       typeId >= snapshot.types.managedFlags.len ||
       typeId >= snapshot.types.sendFlags.len ||
       typeId >= snapshot.types.syncFlags.len ||
       typeId >= snapshot.types.traitConclusionKinds.len ||
       typeId >= snapshot.types.traitProofKinds.len ||
       typeId >= snapshot.types.traitPremiseStarts.len ||
       typeId >= snapshot.types.traitPremiseCounts.len:
        err = " csg compiler snapshot: trait proof row out of range"
        return false
    var expectedManaged: bool
    var expectedSend: bool
    var expectedSync: bool
    if !csgCompilerTypeTraitsDerivedInto(
           snapshot, typeId, expectedManaged, expectedSend, expectedSync,
           err) ||
       snapshot.types.managedFlags[typeId] != expectedManaged ||
       snapshot.types.sendFlags[typeId] != expectedSend ||
       snapshot.types.syncFlags[typeId] != expectedSync:
        if err == "":
            err = " csg compiler snapshot: type trait conclusion mismatch"
        return false
    let expectedConclusion =
        snapshot.types.typeKinds[typeId] == CsgCompilerTypeFunction ?
            CsgCompilerTraitConclusionNone :
            CsgCompilerTraitConclusionExact
    if snapshot.types.traitConclusionKinds[typeId] != expectedConclusion:
        err = " csg compiler snapshot: invalid type trait conclusion kind"
        return false
    var buf = layout.ByteBufInit(384)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.type_trait_proof")
    if !csgCompilerTypeStructureAppendInto(buf, snapshot, typeId, err):
        layout.ByteBufFree(buf)
        return false
    csgCompilerTypeCidAppendU32(
        buf, snapshot.types.traitProofKinds[typeId])
    let premiseStart = snapshot.types.traitPremiseStarts[typeId]
    let premiseCount = snapshot.types.traitPremiseCounts[typeId]
    csgCompilerTypeCidAppendU32(buf, premiseCount)
    for offset in 0..<premiseCount:
        let premiseTypeId =
            snapshot.types.traitPremiseTypeIds[premiseStart + offset]
        if !csgCompilerIndexValid(
               premiseTypeId, snapshot.types.typeCids.len):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: type trait premise out of range"
            return false
        layout.ByteBufAppendFixed32(
            buf, snapshot.types.typeCids[premiseTypeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

# Type identity excludes canonicalTextIds.  Text is diagnostic cargo only;
# exact constructor columns and referenced stable CIDs are the identity.
@borrows
fn CsgCompilerTypeRowCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    let count = snapshot.types.typeCids.len
    if !csgCompilerIndexValid(typeId, count) ||
       typeId >= snapshot.types.canonicalTextIds.len ||
       typeId >= snapshot.types.typeKinds.len ||
       typeId >= snapshot.types.scalarKinds.len ||
       typeId >= snapshot.types.declSymbolIds.len ||
       typeId >= snapshot.types.elementTypeIds.len ||
       typeId >= snapshot.types.arrayLengths.len ||
       typeId >= snapshot.types.argStarts.len ||
       typeId >= snapshot.types.argCounts.len ||
       typeId >= snapshot.types.constArgStarts.len ||
       typeId >= snapshot.types.constArgCounts.len ||
       typeId >= snapshot.types.variantStarts.len ||
       typeId >= snapshot.types.variantCounts.len ||
       typeId >= snapshot.types.aliasTargetTypeIds.len ||
       typeId >= snapshot.types.managedFlags.len ||
       typeId >= snapshot.types.sendFlags.len ||
       typeId >= snapshot.types.syncFlags.len ||
       typeId >= snapshot.types.traitConclusionKinds.len ||
       typeId >= snapshot.types.traitProofKinds.len ||
       typeId >= snapshot.types.traitProofCids.len:
        err = " csg compiler snapshot: type CID row shape mismatch"
        return false
    if !csgCompilerIndexValid(
           snapshot.types.canonicalTextIds[typeId], snapshot.texts.len):
        err = " csg compiler snapshot: invalid type CID row"
        return false
    var buf = layout.ByteBufInit(416)
    csgCompilerTypeCidAppendText(buf, "cheng.csg_compiler.type")
    if !csgCompilerTypeStructureAppendInto(buf, snapshot, typeId, err):
        layout.ByteBufFree(buf)
        return false
    csgCompilerTypeCidAppendU32(
        buf, snapshot.types.traitProofKinds[typeId])
    layout.ByteBufAppendFixed32(buf, snapshot.types.traitProofCids[typeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn csgCompilerTypeGraphAcyclicInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.types.typeCids.len
    var incoming: int32[]
    setLen(incoming, count)
    for row in 0..<count:
        let elementTypeId = snapshot.types.elementTypeIds[row]
        let aliasTargetTypeId = snapshot.types.aliasTargetTypeIds[row]
        if elementTypeId >= 0:
            if incoming[elementTypeId] == 2147483647:
                err = " csg compiler snapshot: type edge count overflow"
                return false
            incoming[elementTypeId] = incoming[elementTypeId] + 1
        if aliasTargetTypeId >= 0:
            if incoming[aliasTargetTypeId] == 2147483647:
                err = " csg compiler snapshot: type edge count overflow"
                return false
            incoming[aliasTargetTypeId] = incoming[aliasTargetTypeId] + 1
        let argStart = snapshot.types.argStarts[row]
        for offset in 0..<snapshot.types.argCounts[row]:
            let argTypeId = snapshot.types.argTypeIds[argStart + offset]
            if incoming[argTypeId] == 2147483647:
                err = " csg compiler snapshot: type edge count overflow"
                return false
            incoming[argTypeId] = incoming[argTypeId] + 1
    var ready: int32[]
    for row in 0..<count:
        if incoming[row] == 0:
            add(ready, row)
    var cursor: int32
    while cursor < ready.len:
        let row = ready[cursor]
        cursor = cursor + 1
        let elementTypeId = snapshot.types.elementTypeIds[row]
        let aliasTargetTypeId = snapshot.types.aliasTargetTypeIds[row]
        if elementTypeId >= 0:
            incoming[elementTypeId] = incoming[elementTypeId] - 1
            if incoming[elementTypeId] == 0:
                add(ready, elementTypeId)
        if aliasTargetTypeId >= 0:
            incoming[aliasTargetTypeId] = incoming[aliasTargetTypeId] - 1
            if incoming[aliasTargetTypeId] == 0:
                add(ready, aliasTargetTypeId)
        let argStart = snapshot.types.argStarts[row]
        for offset in 0..<snapshot.types.argCounts[row]:
            let argTypeId = snapshot.types.argTypeIds[argStart + offset]
            incoming[argTypeId] = incoming[argTypeId] - 1
            if incoming[argTypeId] == 0:
                add(ready, argTypeId)
    if cursor != count:
        err = " csg compiler snapshot: type identity graph cycle"
        return false
    return true

fn csgCompilerTypeExpectedTraitProofKind(kind: int32): int32 =
    if kind == CsgCompilerTypeScalar:
        return CsgCompilerTraitProofBuiltin
    if kind == CsgCompilerTypeObject ||
       kind == CsgCompilerTypeRefObject ||
       kind == CsgCompilerTypeEnum:
        return CsgCompilerTraitProofDeclaration
    return CsgCompilerTraitProofStructural

fn csgCompilerTypeExactShape(
        kind: int32,
        scalarKind: int32,
        declSymbolId: int32,
        elementTypeId: int32,
        arrayLength: int32,
        argCount: int32,
        constArgCount: int32,
        aliasTargetTypeId: int32): bool =
    if kind == CsgCompilerTypeScalar:
        return csgCompilerScalarKindValid(scalarKind) &&
               declSymbolId == -1 && elementTypeId == -1 &&
               arrayLength == -1 && argCount == 0 &&
               constArgCount == 0 && aliasTargetTypeId == -1
    if kind == CsgCompilerTypeObject ||
       kind == CsgCompilerTypeRefObject:
        return scalarKind == 0 && declSymbolId >= 0 &&
               elementTypeId == -1 && arrayLength == -1 &&
               argCount >= 0 && constArgCount == 0 &&
               aliasTargetTypeId == -1
    if kind == CsgCompilerTypeEnum:
        return scalarKind == 0 && declSymbolId >= 0 &&
               elementTypeId == -1 && arrayLength == -1 &&
               argCount == 0 && constArgCount == 0 &&
               aliasTargetTypeId == -1
# [d1-dead-premise] reserved ordinal 5; no producer kind in TypedExprIr type arena (:14-29); dead until ref T ruling (wire ordinal held; branch kept as the ref-T wiring-day shape precedent).
    if kind == CsgCompilerTypeReference ||
       kind == CsgCompilerTypeBorrow ||
       kind == CsgCompilerTypeSequence:
        return scalarKind == 0 && declSymbolId == -1 &&
               elementTypeId >= 0 && arrayLength == -1 &&
               argCount == 0 && constArgCount == 0 &&
               aliasTargetTypeId == -1
    if kind == CsgCompilerTypeArray:
        return scalarKind == 0 && declSymbolId == -1 &&
               elementTypeId >= 0 && arrayLength > 0 &&
               argCount == 0 && constArgCount == 0 &&
               aliasTargetTypeId == -1
    if kind == CsgCompilerTypeTuple:
        return scalarKind == 0 && declSymbolId == -1 &&
               elementTypeId == -1 && arrayLength == -1 &&
               argCount > 0 && constArgCount == 0 &&
               aliasTargetTypeId == -1
    if kind == CsgCompilerTypeApply:
        return scalarKind == 0 && declSymbolId >= 0 &&
               elementTypeId == -1 && arrayLength == -1 &&
               (argCount > 0 || constArgCount > 0) &&
               aliasTargetTypeId == -1
    if kind == CsgCompilerTypeFunction:
        return scalarKind == 0 && declSymbolId == -1 &&
               elementTypeId >= 0 && arrayLength == -1 &&
               constArgCount == 0 && aliasTargetTypeId == -1
    if kind == CsgCompilerTypeAlias:
        return scalarKind == 0 && declSymbolId >= 0 &&
               elementTypeId == -1 && arrayLength == -1 &&
               argCount == 0 && constArgCount == 0 &&
               aliasTargetTypeId >= 0
    if kind == CsgCompilerTypeGenericParameter:
        return scalarKind == 0 && declSymbolId == -1 &&
               elementTypeId == -1 && arrayLength == -1 &&
               argCount == 0 && constArgCount == 0 &&
               aliasTargetTypeId == -1
    return false

@borrows
fn csgCompilerNominalTypeDeclarationJoinValid(
        snapshot: CsgCompilerSnapshotTables,
        typeId: int32): bool =
    if !csgCompilerIndexValid(typeId, snapshot.types.typeKinds.len):
        return false
    let kind = snapshot.types.typeKinds[typeId]
    if kind != CsgCompilerTypeObject &&
       kind != CsgCompilerTypeRefObject &&
       kind != CsgCompilerTypeEnum:
        return true
    let symbolId = snapshot.types.declSymbolIds[typeId]
    if !csgCompilerIndexValid(symbolId, snapshot.symbols.symbolKinds.len) ||
       symbolId >= snapshot.symbols.typeIds.len ||
       snapshot.symbols.typeIds[symbolId] != typeId:
        return false
    let symbolKind = snapshot.symbols.symbolKinds[symbolId]
    if kind == CsgCompilerTypeEnum:
        if symbolKind != CsgCompilerSymbolType:
            return false
    elif symbolKind != CsgCompilerSymbolType &&
         symbolKind != CsgCompilerSymbolField:
        return false
    var matchedDeclaration: int32 = -1
    for declarationRow in 0..<
            snapshot.parserSidecars.declarationKinds.len:
        let expectedDeclarationKind =
            symbolKind == CsgCompilerSymbolType ?
                CsgCompilerParserDeclarationType :
                CsgCompilerParserDeclarationField
        if snapshot.parserSidecars.declarationKinds[declarationRow] !=
               expectedDeclarationKind ||
           snapshot.parserSidecars.declarationProducerSourceIds[
               declarationRow] != snapshot.symbols.sourceIds[symbolId] ||
           snapshot.parserSidecars.declarationNameTokenIds[
               declarationRow] != snapshot.symbols.nameTokenIds[symbolId] ||
           snapshot.parserSidecars.declarationNameSpanIds[
               declarationRow] != snapshot.symbols.nameSpanIds[symbolId] ||
           snapshot.parserSidecars.declarationSpanIds[
               declarationRow] !=
               snapshot.symbols.declarationSpanIds[symbolId]:
            continue
        if matchedDeclaration >= 0:
            return false
        matchedDeclaration = declarationRow
    if matchedDeclaration < 0:
        return false
    let root =
        snapshot.parserSidecars.declarationTypeSyntaxRootIds[
            matchedDeclaration]
    if !csgCompilerIndexValid(
           root, snapshot.parserSidecars.typeSyntaxKinds.len) ||
       snapshot.parserSidecars.typeSyntaxTypeIds[root] != typeId:
        return false
    let parserKind =
        snapshot.parserSidecars.typeSyntaxKinds[root]
    let exactKind =
        (kind == CsgCompilerTypeObject &&
         (parserKind == Int32(parser.ParserTypeSyntaxObject) ||
          parserKind == Int32(parser.ParserTypeSyntaxImplicitObject))) ||
        (kind == CsgCompilerTypeRefObject &&
         parserKind == Int32(parser.ParserTypeSyntaxRefObject)) ||
        (kind == CsgCompilerTypeEnum &&
         parserKind == Int32(parser.ParserTypeSyntaxEnum))
    if !exactKind:
        return false
    if symbolKind == CsgCompilerSymbolField:
        let ownerRoot =
            snapshot.parserSidecars.typeSyntaxDeclarationOwnerIds[root]
        if !csgCompilerIndexValid(
               ownerRoot, snapshot.parserSidecars.typeSyntaxTypeIds.len):
            return false
        let ownerTypeId =
            snapshot.parserSidecars.typeSyntaxTypeIds[ownerRoot]
        if !csgCompilerIndexValid(
               ownerTypeId, snapshot.types.declSymbolIds.len) ||
           snapshot.symbols.ownerSymbolIds[symbolId] !=
               snapshot.types.declSymbolIds[ownerTypeId]:
            return false
    return true

@borrows
fn csgCompilerTypesValidateInto(snapshot: CsgCompilerSnapshotTables,
                                err: var str): bool =
    let count = snapshot.types.typeCids.len
    if count <= 0 ||
       count != snapshot.types.producerTypeArenaIds.len ||
       count != snapshot.types.canonicalTextIds.len ||
       count != snapshot.types.typeKinds.len ||
       count != snapshot.types.scalarKinds.len ||
       count != snapshot.types.declSymbolIds.len ||
       count != snapshot.types.elementTypeIds.len ||
       count != snapshot.types.arrayLengths.len ||
       count != snapshot.types.argStarts.len ||
       count != snapshot.types.argCounts.len ||
       snapshot.types.argNameTextIds.len !=
           snapshot.types.argTypeIds.len ||
       count != snapshot.types.constArgStarts.len ||
       count != snapshot.types.constArgCounts.len ||
       count != snapshot.types.aliasTargetTypeIds.len ||
       count != snapshot.types.genericParameterParserRows.len ||
       count != snapshot.types.managedFlags.len ||
       count != snapshot.types.sendFlags.len ||
       count != snapshot.types.syncFlags.len ||
       count != snapshot.types.traitConclusionKinds.len ||
       count != snapshot.types.traitProofKinds.len ||
       count != snapshot.types.traitProofCids.len ||
       count != snapshot.types.traitPremiseStarts.len ||
       count != snapshot.types.traitPremiseCounts.len ||
       count != snapshot.types.variantStarts.len ||
       count != snapshot.types.variantCounts.len ||
       snapshot.types.variantOrdinals.len !=
           snapshot.types.variantNameTextIds.len ||
       snapshot.types.variantPayloadTypeIds.len !=
           snapshot.types.variantNameTextIds.len ||
       snapshot.types.constArgKinds.len !=
           snapshot.types.constArgValues.len:
        err = " csg compiler snapshot: type columns mismatch"
        return false
    var argCursor: int32
    var constArgCursor: int32
    var traitPremiseCursor: int32
    var variantCursor: int32
    var genericParserSeen: bool[]
    var producerTypeArenaSeen: bool[]
    var producerTypeArenaCount: int32
    setLen(
        genericParserSeen,
        snapshot.parserSidecars.typeGenericSymbolProducerSourceIds.len)
    setLen(producerTypeArenaSeen, count)
    for row in 0..<count:
        let kind = snapshot.types.typeKinds[row]
        let producerTypeArenaId =
            snapshot.types.producerTypeArenaIds[row]
        let genericParserRow =
            snapshot.types.genericParameterParserRows[row]
        let declSymbolId = snapshot.types.declSymbolIds[row]
        let elementTypeId = snapshot.types.elementTypeIds[row]
        let argCount = snapshot.types.argCounts[row]
        let constArgCount = snapshot.types.constArgCounts[row]
        let aliasTargetTypeId = snapshot.types.aliasTargetTypeIds[row]
        if !csgCompilerCidObserved(snapshot.types.typeCids[row]) ||
           !csgCompilerIndexValid(snapshot.types.canonicalTextIds[row],
                                  snapshot.texts.len) ||
           !csgCompilerTypeKindValid(kind) ||
           !csgCompilerOptionalIndexValid(
               declSymbolId, snapshot.symbols.symbolCids.len) ||
           (declSymbolId >= 0 &&
            (declSymbolId >= snapshot.symbols.symbolKinds.len ||
             ((kind == CsgCompilerTypeObject ||
               kind == CsgCompilerTypeRefObject) ?
                  (snapshot.symbols.symbolKinds[declSymbolId] !=
                       CsgCompilerSymbolType &&
                   snapshot.symbols.symbolKinds[declSymbolId] !=
                       CsgCompilerSymbolField) :
                  snapshot.symbols.symbolKinds[declSymbolId] !=
                      CsgCompilerSymbolType))) ||
           !csgCompilerOptionalIndexValid(elementTypeId, count) ||
           !csgCompilerOptionalIndexValid(aliasTargetTypeId, count) ||
           snapshot.types.argStarts[row] != argCursor ||
           argCount < 0 ||
           argCount > snapshot.types.argTypeIds.len - argCursor ||
           snapshot.types.constArgStarts[row] != constArgCursor ||
           constArgCount < 0 ||
           constArgCount >
               snapshot.types.constArgKinds.len - constArgCursor ||
           snapshot.types.traitPremiseStarts[row] !=
               traitPremiseCursor ||
           snapshot.types.traitPremiseCounts[row] < 0 ||
           snapshot.types.traitPremiseCounts[row] >
               snapshot.types.traitPremiseTypeIds.len -
                   traitPremiseCursor ||
           snapshot.types.variantStarts[row] != variantCursor ||
           snapshot.types.variantCounts[row] < 0 ||
           snapshot.types.variantCounts[row] >
               snapshot.types.variantNameTextIds.len - variantCursor ||
           (kind != CsgCompilerTypeEnum &&
            snapshot.types.variantCounts[row] != 0) ||
           snapshot.types.traitProofKinds[row] !=
               csgCompilerTypeExpectedTraitProofKind(kind) ||
           snapshot.types.traitConclusionKinds[row] !=
               (kind == CsgCompilerTypeFunction ?
                    CsgCompilerTraitConclusionNone :
                    CsgCompilerTraitConclusionExact) ||
           !csgCompilerCidObserved(snapshot.types.traitProofCids[row]) ||
           !csgCompilerTypeExactShape(
               kind, snapshot.types.scalarKinds[row], declSymbolId,
               elementTypeId, snapshot.types.arrayLengths[row],
               argCount, constArgCount, aliasTargetTypeId) ||
           !csgCompilerNominalTypeDeclarationJoinValid(snapshot, row) ||
           producerTypeArenaId < -1 ||
           (kind == CsgCompilerTypeFunction) !=
               (producerTypeArenaId == -1) ||
           (producerTypeArenaId >= 0 &&
            (producerTypeArenaId >= count ||
             producerTypeArenaSeen[producerTypeArenaId])) ||
           (kind == CsgCompilerTypeGenericParameter) !=
               (genericParserRow >= 0) ||
           (genericParserRow >= 0 &&
            (!csgCompilerIndexValid(
                 genericParserRow, genericParserSeen.len) ||
             genericParserSeen[genericParserRow])) ||
           (row > 0 &&
            !csgCompilerCidLess(snapshot.types.typeCids[row - 1],
                                snapshot.types.typeCids[row])):
            err = " csg compiler snapshot: invalid type row"
            return false
        if producerTypeArenaId >= 0:
            producerTypeArenaSeen[producerTypeArenaId] = true
            producerTypeArenaCount =
                producerTypeArenaCount + 1
        if genericParserRow >= 0:
            genericParserSeen[genericParserRow] = true
        for offset in 0..<argCount:
            let argRow = argCursor + offset
            if !csgCompilerIndexValid(
                   snapshot.types.argTypeIds[argRow], count) ||
               !csgCompilerOptionalIndexValid(
                   snapshot.types.argNameTextIds[argRow],
                   snapshot.texts.len) ||
               ((kind == CsgCompilerTypeObject ||
                 kind == CsgCompilerTypeRefObject) &&
                snapshot.types.argNameTextIds[argRow] < 0) ||
               (kind != CsgCompilerTypeTuple &&
                kind != CsgCompilerTypeObject &&
                kind != CsgCompilerTypeRefObject &&
                snapshot.types.argNameTextIds[argRow] >= 0):
                err = " csg compiler snapshot: invalid type argument"
                return false
        for offset in 0..<constArgCount:
            let constRow = constArgCursor + offset
            if !csgCompilerConstArgValid(
                   snapshot.types.constArgKinds[constRow],
                   snapshot.types.constArgValues[constRow]):
                err = " csg compiler snapshot: invalid const type argument"
                return false
        # [phaseB-enum-schema] Enum variant payload row validation: exact
        # ordinal sequence, present canonical name, optional payloadTypeId.
        for offset in 0..<snapshot.types.variantCounts[row]:
            let variantRow = variantCursor + offset
            if snapshot.types.variantOrdinals[variantRow] != offset ||
               !csgCompilerIndexValid(
                   snapshot.types.variantNameTextIds[variantRow],
                   snapshot.texts.len) ||
               !csgCompilerOptionalIndexValid(
                   snapshot.types.variantPayloadTypeIds[variantRow], count):
                err = " csg compiler snapshot: invalid enum variant row"
                return false
        argCursor = argCursor + argCount
        constArgCursor = constArgCursor + constArgCount
        variantCursor = variantCursor + snapshot.types.variantCounts[row]
        traitPremiseCursor = traitPremiseCursor +
            snapshot.types.traitPremiseCounts[row]
    if argCursor != snapshot.types.argTypeIds.len:
        err = " csg compiler snapshot: type argument coverage mismatch"
        return false
    if constArgCursor != snapshot.types.constArgKinds.len:
        err = " csg compiler snapshot: const type argument coverage mismatch"
        return false
    if traitPremiseCursor != snapshot.types.traitPremiseTypeIds.len:
        err = " csg compiler snapshot: type trait premise coverage mismatch"
        return false
    if variantCursor != snapshot.types.variantNameTextIds.len:
        err = " csg compiler snapshot: enum variant payload coverage mismatch"
        return false
    for producerTypeArenaId in 0..<producerTypeArenaSeen.len:
        if (producerTypeArenaId < producerTypeArenaCount) !=
               producerTypeArenaSeen[producerTypeArenaId]:
            err =
                " csg compiler snapshot: producer TypeArena bridge is not a full bijection"
            return false
    for parserRow in 0..<genericParserSeen.len:
        if !genericParserSeen[parserRow]:
            err = " csg compiler snapshot: parser generic parameter lacks Type"
            return false
    if !csgCompilerTypeGraphAcyclicInto(snapshot, err):
        return false
    for row in 0..<count:
        var expectedTraitProofCid: layout.FixedBytes32
        if !CsgCompilerTypeTraitProofCidInto(
               snapshot, row, expectedTraitProofCid, err) ||
           !layout.FixedBytes32Equal(
               expectedTraitProofCid,
               snapshot.types.traitProofCids[row]):
            if err == "":
                err = " csg compiler snapshot: type trait proof CID mismatch"
            return false
        var expectedCid: layout.FixedBytes32
        if !CsgCompilerTypeRowCidInto(snapshot, row, expectedCid, err) ||
           !layout.FixedBytes32Equal(
               expectedCid, snapshot.types.typeCids[row]):
            if err == "":
                err = " csg compiler snapshot: type CID mismatch"
            return false
    return true

@borrows
fn CsgCompilerSymbolIdentityCidInto(
        declKeyCid: layout.FixedBytes32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if !csgCompilerCidObserved(declKeyCid):
        err = " csg compiler snapshot: unobserved declaration key"
        return false
    out = layout.FixedBytes32Copy(declKeyCid)
    return true

fn csgCompilerDeclarationKindForSymbolKind(symbolKind: int32): int32 =
    if symbolKind == CsgCompilerSymbolModule:
        return declaration.SemanticSnapshotDeclarationKindModule
    if symbolKind == CsgCompilerSymbolType:
        return declaration.SemanticSnapshotDeclarationKindType
    if symbolKind == CsgCompilerSymbolFunction:
        return declaration.SemanticSnapshotDeclarationKindFunction
    if symbolKind == CsgCompilerSymbolField:
        return declaration.SemanticSnapshotDeclarationKindField
    if symbolKind == CsgCompilerSymbolParameter:
        return declaration.SemanticSnapshotDeclarationKindParameter
    if symbolKind == CsgCompilerSymbolLocal:
        return declaration.SemanticSnapshotDeclarationKindLocal
    if symbolKind == CsgCompilerSymbolGenericParameter:
        return declaration.SemanticSnapshotDeclarationKindGenericParameter
    return 0

fn CsgCompilerDeclarationKindMatchesSymbolKind(
        symbolKind: int32,
        declarationKind: int32): bool =
    if symbolKind == CsgCompilerSymbolLocal:
        # The six-row CSG Symbol domain intentionally keeps all bindings in
        # one broad kind.  Portable declaration identity retains the exact
        # semantic split: module bindings are Global, `const` stays Const,
        # and callable/block bindings are Local.
        return declarationKind ==
                   declaration.SemanticSnapshotDeclarationKindGlobal ||
               declarationKind ==
                   declaration.SemanticSnapshotDeclarationKindConst ||
               declarationKind ==
                   declaration.SemanticSnapshotDeclarationKindLocal
    return csgCompilerDeclarationKindForSymbolKind(symbolKind) ==
           declarationKind

# Internal semantic names cross the Module/member boundary with `::`, matching
# CompilerCSG symbolText.  Deeper declaration ownership uses `.`; source-level
# display spelling is never consulted.
@borrows
fn csgCompilerDeclarationQualifiedNameInto(
        snapshot: CsgCompilerSnapshotTables,
        declId: int32,
        out: var str): bool =
    out = ""
    if !csgCompilerIndexValid(
           declId, snapshot.declarations.declIds.len):
        return false
    var ownerChain: int32[]
    var current = declId
    while current >= 0:
        if !csgCompilerIndexValid(
               current, snapshot.declarations.declIds.len) ||
           ownerChain.len >= snapshot.declarations.declIds.len:
            return false
        add(ownerChain, current)
        current = snapshot.declarations.ownerDeclIds[current]
    if ownerChain.len <= 0:
        return false
    var cursor = ownerChain.len - 1
    if snapshot.declarations.declarationKinds[ownerChain[cursor]] !=
           declaration.SemanticSnapshotDeclarationKindModule:
        return false
    out = csgCompilerOwnedTextCopy(
        snapshot.declarations.canonicalNames[ownerChain[cursor]])
    cursor = cursor - 1
    var firstMember = true
    while cursor >= 0:
        out = strings.ConcatStr(
            strings.ConcatStr(out, firstMember ? "::" : "."),
            snapshot.declarations.canonicalNames[ownerChain[cursor]])
        firstMember = false
        cursor = cursor - 1
    return true

@borrows
fn CsgCompilerSymbolRowCidInto(
        snapshot: CsgCompilerSnapshotTables,
        symbolId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    let count = snapshot.symbols.symbolCids.len
    if !csgCompilerIndexValid(symbolId, count) ||
       symbolId >= snapshot.symbols.declIds.len ||
       symbolId >= snapshot.symbols.declKeyCids.len ||
       symbolId >= snapshot.symbols.sourceIds.len ||
       symbolId >= snapshot.symbols.symbolKinds.len ||
       symbolId >= snapshot.symbols.ownerSymbolIds.len:
        err = " csg compiler snapshot: symbol identity row out of range"
        return false
    let sourceId = snapshot.symbols.sourceIds[symbolId]
    let ownerSymbolId = snapshot.symbols.ownerSymbolIds[symbolId]
    let declId = snapshot.symbols.declIds[symbolId]
    if !csgCompilerIndexValid(sourceId, snapshot.sources.documentCids.len) ||
       !csgCompilerIndexValid(declId, snapshot.declarations.declIds.len) ||
       !csgCompilerOptionalIndexValid(ownerSymbolId, count) ||
       ownerSymbolId == symbolId ||
       !csgCompilerSymbolKindValid(snapshot.symbols.symbolKinds[symbolId]) ||
       !CsgCompilerDeclarationKindMatchesSymbolKind(
           snapshot.symbols.symbolKinds[symbolId],
           snapshot.declarations.declarationKinds[declId]) ||
       !layout.FixedBytes32Equal(
           snapshot.sources.documentCids[sourceId],
           snapshot.declarations.portableDocumentIdentityCids[declId]) ||
       !layout.FixedBytes32Equal(
           snapshot.symbols.declKeyCids[symbolId],
           snapshot.declarations.declKeyCids[declId]):
        err = " csg compiler snapshot: invalid symbol identity preimage"
        return false
    let ownerDeclId = snapshot.declarations.ownerDeclIds[declId]
    if ownerSymbolId >= 0:
        if snapshot.symbols.declIds[ownerSymbolId] != ownerDeclId:
            err = " csg compiler snapshot: symbol/declaration owner drift"
            return false
    elif snapshot.symbols.symbolKinds[symbolId] ==
             CsgCompilerSymbolModule:
        if ownerDeclId != -1:
            err = " csg compiler snapshot: module Symbol owner drift"
            return false
    elif !csgCompilerIndexValid(
             ownerDeclId, snapshot.declarations.declIds.len) ||
         snapshot.declarations.declarationKinds[ownerDeclId] !=
             declaration.SemanticSnapshotDeclarationKindModule:
        err = " csg compiler snapshot: missing non-module Symbol owner"
        return false
    return CsgCompilerSymbolIdentityCidInto(
        snapshot.symbols.declKeyCids[symbolId], out, err)

@borrows
fn CsgCompilerSymbolInterfaceCidInto(
        snapshot: CsgCompilerSnapshotTables,
        symbolId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    let count = snapshot.symbols.symbolCids.len
    if !csgCompilerIndexValid(symbolId, count) ||
       symbolId >= snapshot.symbols.symbolKinds.len ||
       symbolId >= snapshot.symbols.typeIds.len ||
       symbolId >= snapshot.symbols.functionIds.len ||
       symbolId >= snapshot.symbols.externFunctionIds.len ||
       symbolId >= snapshot.symbols.exportedFlags.len ||
       symbolId >= snapshot.symbols.genericConstraintStarts.len ||
       symbolId >= snapshot.symbols.genericConstraintCounts.len ||
       symbolId >= snapshot.symbols.genericParameterParserRows.len ||
       symbolId >= snapshot.symbols.genericParameterOrdinals.len ||
       symbolId >= snapshot.symbols.genericParameterDefaultTypeIds.len:
        err = " csg compiler snapshot: symbol interface row out of range"
        return false
    let kind = snapshot.symbols.symbolKinds[symbolId]
    let typeId = snapshot.symbols.typeIds[symbolId]
    let functionId = snapshot.symbols.functionIds[symbolId]
    let externFunctionId = snapshot.symbols.externFunctionIds[symbolId]
    let constraintStart =
        snapshot.symbols.genericConstraintStarts[symbolId]
    let constraintCount =
        snapshot.symbols.genericConstraintCounts[symbolId]
    let genericParserRow =
        snapshot.symbols.genericParameterParserRows[symbolId]
    let genericOrdinal =
        snapshot.symbols.genericParameterOrdinals[symbolId]
    let genericDefaultTypeId =
        snapshot.symbols.genericParameterDefaultTypeIds[symbolId]
    if !csgCompilerSymbolKindValid(kind) ||
       !csgCompilerOptionalIndexValid(typeId, snapshot.types.typeCids.len) ||
       (kind == CsgCompilerSymbolModule && typeId != -1) ||
       (kind != CsgCompilerSymbolModule && typeId < 0) ||
       (kind == CsgCompilerSymbolFunction &&
        (typeId < 0 || typeId >= snapshot.types.typeKinds.len ||
         snapshot.types.typeKinds[typeId] != CsgCompilerTypeFunction ||
         ((functionId >= 0) == (externFunctionId >= 0)))) ||
       (kind != CsgCompilerSymbolFunction &&
        (functionId != -1 || externFunctionId != -1)) ||
       (kind == CsgCompilerSymbolGenericParameter &&
        (typeId < 0 || typeId >= snapshot.types.typeKinds.len ||
         snapshot.types.typeKinds[typeId] !=
             CsgCompilerTypeGenericParameter ||
         genericParserRow < 0 || genericOrdinal < 0)) ||
       (kind != CsgCompilerSymbolGenericParameter &&
        (genericParserRow != -1 || genericOrdinal != -1 ||
         genericDefaultTypeId != -1)) ||
       !csgCompilerOptionalIndexValid(
           genericDefaultTypeId, snapshot.types.typeCids.len) ||
       (typeId >= 0 &&
        (typeId >= snapshot.types.managedFlags.len ||
         typeId >= snapshot.types.sendFlags.len ||
         typeId >= snapshot.types.syncFlags.len ||
         typeId >= snapshot.types.traitConclusionKinds.len ||
         typeId >= snapshot.types.traitProofKinds.len ||
         typeId >= snapshot.types.traitProofCids.len)) ||
       constraintStart < 0 || constraintCount < 0 ||
       constraintStart > snapshot.symbols.genericConstraintTypeIds.len ||
       constraintCount >
           snapshot.symbols.genericConstraintTypeIds.len - constraintStart:
        err = " csg compiler snapshot: invalid symbol interface preimage"
        return false
    var buf = layout.ByteBufInit(320)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.symbol_interface")
    layout.ByteBufAppendFixed32(buf, snapshot.symbols.symbolCids[symbolId])
    csgCompilerTypeCidAppendU32(buf, kind)
    csgCompilerTypeCidAppendU32(
        buf, snapshot.symbols.exportedFlags[symbolId] ? 1 : 0)
    csgCompilerTypeCidAppendOptionalType(buf, snapshot, typeId)
    if typeId >= 0:
        csgCompilerTypeCidAppendU32(
            buf, snapshot.types.traitConclusionKinds[typeId])
        csgCompilerTypeCidAppendU32(
            buf, snapshot.types.managedFlags[typeId] ? 1 : 0)
        csgCompilerTypeCidAppendU32(
            buf, snapshot.types.sendFlags[typeId] ? 1 : 0)
        csgCompilerTypeCidAppendU32(
            buf, snapshot.types.syncFlags[typeId] ? 1 : 0)
        csgCompilerTypeCidAppendU32(
            buf, snapshot.types.traitProofKinds[typeId])
        layout.ByteBufAppendFixed32(
            buf, snapshot.types.traitProofCids[typeId])
    csgCompilerTypeCidAppendU32(buf, constraintCount)
    for offset in 0..<constraintCount:
        let constraintTypeId =
            snapshot.symbols.genericConstraintTypeIds[
                constraintStart + offset]
        if !csgCompilerIndexValid(
               constraintTypeId, snapshot.types.typeCids.len):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: invalid generic constraint TypeId"
            return false
        layout.ByteBufAppendFixed32(
            buf, snapshot.types.typeCids[constraintTypeId])
    csgCompilerTypeCidAppendOptionalType(
        buf, snapshot, genericDefaultTypeId)
    if kind == CsgCompilerSymbolFunction && functionId >= 0:
        if !csgCompilerIndexValid(
               functionId, snapshot.functions.annotationFlags.len) ||
           functionId >=
               snapshot.functions.resultOwnershipKinds.len ||
           functionId >=
               snapshot.functions.parameterOwnershipStarts.len ||
           functionId >=
               snapshot.functions.parameterOwnershipCounts.len ||
           functionId >=
               snapshot.functions.manualConsumeEffectCids.len ||
           typeId < 0 || typeId >= snapshot.types.argCounts.len:
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: function interface ownership row missing"
            return false
        let ownershipStart =
            snapshot.functions.parameterOwnershipStarts[functionId]
        let ownershipCount =
            snapshot.functions.parameterOwnershipCounts[functionId]
        if ownershipStart < 0 ||
           ownershipCount != snapshot.types.argCounts[typeId] ||
           ownershipStart >
               snapshot.functions.parameterOwnershipKinds.len ||
           ownershipCount >
               snapshot.functions.parameterOwnershipKinds.len -
                   ownershipStart:
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: function parameter ownership CSR invalid"
            return false
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.functions.annotationFlags[functionId])
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.functions.resultOwnershipKinds[functionId])
        csgCompilerTypeCidAppendU32(buf, ownershipCount)
        for offset in 0..<ownershipCount:
            let ownershipKind =
                snapshot.functions.parameterOwnershipKinds[
                    ownershipStart + offset]
            var expectedOwnershipKind: int32
            if !csgCompilerOwnershipKindValid(ownershipKind) ||
               !csgCompilerFunctionParameterOwnershipExpectedInto(
                   snapshot, typeId, offset,
                   expectedOwnershipKind, err) ||
               ownershipKind != expectedOwnershipKind:
                layout.ByteBufFree(buf)
                if err == "":
                    err = " csg compiler snapshot: function parameter ownership kind invalid"
                return false
            csgCompilerTypeCidAppendU32(buf, ownershipKind)
        var expectedManualConsumeEffectCid: layout.FixedBytes32
        if !CsgCompilerFunctionManualConsumeEffectCidInto(
               snapshot,
               functionId,
               expectedManualConsumeEffectCid,
               err) ||
           !layout.FixedBytes32Equal(
               snapshot.functions.manualConsumeEffectCids[functionId],
               expectedManualConsumeEffectCid):
            layout.ByteBufFree(buf)
            if err == "":
                err = " csg compiler snapshot: function manual consume effect drift"
            return false
        layout.ByteBufAppendFixed32(
            buf,
            snapshot.functions.manualConsumeEffectCids[functionId])
    elif kind == CsgCompilerSymbolFunction:
        if !csgCompilerIndexValid(
               externFunctionId, snapshot.externFunctions.symbolIds.len) ||
           externFunctionId >=
               snapshot.externFunctions.parserDeclarationRows.len ||
           externFunctionId >= snapshot.externFunctions.typeIds.len ||
           externFunctionId >=
               snapshot.externFunctions.externalNameTextIds.len ||
           externFunctionId >= snapshot.externFunctions.abiKinds.len ||
           externFunctionId >=
               snapshot.externFunctions.importAnnotationRows.len ||
           snapshot.externFunctions.symbolIds[externFunctionId] !=
               symbolId ||
           snapshot.externFunctions.typeIds[externFunctionId] != typeId:
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: extern function interface row missing"
            return false
        let parserDeclarationRow =
            snapshot.externFunctions.parserDeclarationRows[
                externFunctionId]
        let externalNameTextId =
            snapshot.externFunctions.externalNameTextIds[
                externFunctionId]
        let abiKind =
            snapshot.externFunctions.abiKinds[externFunctionId]
        let importAnnotationRow =
            snapshot.externFunctions.importAnnotationRows[
                externFunctionId]
        if !csgCompilerIndexValid(
               parserDeclarationRow,
               snapshot.parserSidecars.declarationKinds.len) ||
           snapshot.parserSidecars.declarationKinds[
               parserDeclarationRow] !=
               CsgCompilerParserDeclarationFunction ||
           !csgCompilerIndexValid(externalNameTextId, snapshot.texts.len) ||
           snapshot.texts[externalNameTextId] == "" ||
           abiKind != CsgCompilerExternAbiC:
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: invalid extern function interface preimage"
            return false
        csgCompilerTypeCidAppendU32(buf, abiKind)
        csgCompilerTypeCidAppendText(
            buf, snapshot.texts[externalNameTextId])
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.parserSidecars.declarationProducerSourceIds[
                parserDeclarationRow])
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.parserSidecars.declarationSourceLocalRows[
                parserDeclarationRow])
        layout.ByteBufAppendFixed32(
            buf, snapshot.symbols.declKeyCids[symbolId])
        if importAnnotationRow >= 0:
            if !csgCompilerIndexValid(
                   importAnnotationRow,
                   snapshot.parserSidecars.annotationIdentityCids.len):
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: extern import annotation row invalid"
                return false
            csgCompilerTypeCidAppendU32(buf, 1)
            layout.ByteBufAppendFixed32(
                buf,
                snapshot.parserSidecars.annotationIdentityCids[
                    importAnnotationRow])
        else:
            csgCompilerTypeCidAppendU32(buf, 0)
    else:
        csgCompilerTypeCidAppendU32(buf, 0)
        csgCompilerTypeCidAppendU32(buf, 0)
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn CsgCompilerModuleParserDeclarationRowsBySourceInto(
        snapshot: CsgCompilerSnapshotTables,
        out: var int32[],
        err: var str): bool =
    let sourceCount = snapshot.sources.documentCids.len
    let declarationCount =
        snapshot.parserSidecars.declarationKinds.len
    if declarationCount !=
           snapshot.parserSidecars.declarationProducerSourceIds.len ||
       declarationCount !=
           snapshot.parserSidecars.declarationNameTokenIds.len ||
       declarationCount !=
           snapshot.parserSidecars.declarationNameSpanIds.len ||
       declarationCount !=
           snapshot.parserSidecars.declarationSpanIds.len:
        err = " csg compiler snapshot: module declaration coordinate columns mismatch"
        return false
    var rows: int32[]
    setLen(rows, sourceCount)
    for sourceId in 0..<sourceCount:
        rows[sourceId] = -1
    for declarationRow in 0..<declarationCount:
        let sourceId =
            snapshot.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        if !csgCompilerIndexValid(sourceId, sourceCount):
            err = " csg compiler snapshot: module declaration source out of range"
            return false
        if snapshot.parserSidecars.declarationKinds[declarationRow] != 1:
            continue
        if rows[sourceId] >= 0:
            err = " csg compiler snapshot: duplicate module declaration authority"
            return false
        rows[sourceId] = declarationRow
    out = rows
    err = ""
    return true

# Backtick operator names (`[]`, `[]=`, `()`) tokenize as separate punctuation
# tokens, and declaration name spans record the inner byte range, so a
# backtick name span is generally not any token's span and its name token is
# the opening backtick token (the parser's declaration name token domain).
# These predicates are the consumer-side mirror of the snapshot builder's
# compilerSnapshotBuilderFunctionNameOwnerTokenResolveInto (ring 2, R6): the
# same opener/closer bracket contract, evaluated against an already-pinned
# name token.  The bracket form pins the opener/closer pair; the full
# authority adds the parse-time byte-coverage contract (the tokens inside the
# name span must cover it byte-exactly, concatenate to the name text, and
# contain no embedded backtick).  Span byte offsets are per-source, so the
# token scans are source-filtered.
@borrows
fn CsgCompilerBacktickNameTokenBracketValid(
        spanStartBytes: int32[],
        spanEndBytes: int32[],
        spanSourceIds: int32[],
        tokenSourceIds: int32[],
        tokenSpanIds: int32[],
        tokenKinds: int32[],
        source: int32,
        nameSpan: int32,
        nameToken: int32): bool =
    if nameSpan < 0 || nameSpan >= spanStartBytes.len ||
       spanSourceIds[nameSpan] != source ||
       nameToken < 0 || nameToken >= tokenKinds.len ||
       nameToken >= tokenSpanIds.len ||
       tokenSourceIds[nameToken] != source ||
       tokenKinds[nameToken] != CsgCompilerTokenBacktick:
        return false
    let openerSpan = tokenSpanIds[nameToken]
    if openerSpan < 0 || openerSpan >= spanStartBytes.len ||
       spanSourceIds[openerSpan] != source ||
       spanEndBytes[openerSpan] != spanStartBytes[nameSpan]:
        return false
    let nameStart = spanStartBytes[nameSpan]
    let nameEnd = spanEndBytes[nameSpan]
    if nameEnd <= nameStart:
        return false
    var closerToken: int32 = -1
    for tokenId in nameToken + 1..<tokenKinds.len:
        if tokenSourceIds[tokenId] != source:
            continue
        if tokenKinds[tokenId] == CsgCompilerTokenBacktick:
            closerToken = tokenId
            break
    if closerToken < 0:
        return false
    let closerSpan = tokenSpanIds[closerToken]
    if closerSpan < 0 || closerSpan >= spanStartBytes.len ||
       spanSourceIds[closerSpan] != source ||
       spanStartBytes[closerSpan] != nameEnd:
        return false
    return true

@borrows
fn CsgCompilerBacktickNameTokenAuthorityValid(
        spanStartBytes: int32[],
        spanEndBytes: int32[],
        spanSourceIds: int32[],
        tokenSourceIds: int32[],
        tokenSpanIds: int32[],
        tokenKinds: int32[],
        tokenValueTextIds: int32[],
        texts: str[],
        source: int32,
        nameSpan: int32,
        nameToken: int32,
        nameText: int32): bool =
    if !CsgCompilerBacktickNameTokenBracketValid(
           spanStartBytes,
           spanEndBytes,
           spanSourceIds,
           tokenSourceIds,
           tokenSpanIds,
           tokenKinds,
           source,
           nameSpan,
           nameToken):
        return false
    if nameText < 0 || nameText >= texts.len:
        return false
    let nameValue = texts[nameText]
    if nameValue.len != spanEndBytes[nameSpan] - spanStartBytes[nameSpan]:
        return false
    let nameStart = spanStartBytes[nameSpan]
    let nameEnd = spanEndBytes[nameSpan]
    var byteCursor = nameStart
    var nameCursor: int32 = 0
    var innerCount: int32 = 0
    for tokenId in 0..<tokenKinds.len:
        if tokenSourceIds[tokenId] != source:
            continue
        let tokenSpanId = tokenSpanIds[tokenId]
        if tokenSpanId < 0 || tokenSpanId >= spanStartBytes.len ||
           spanSourceIds[tokenSpanId] != source:
            return false
        let tokenStart = spanStartBytes[tokenSpanId]
        let tokenEnd = spanEndBytes[tokenSpanId]
        if tokenEnd <= tokenStart:
            return false
        if tokenStart < nameStart || tokenEnd > nameEnd:
            continue
        if tokenKinds[tokenId] == CsgCompilerTokenBacktick:
            return false
        if tokenStart != byteCursor ||
           nameCursor + tokenEnd - tokenStart > nameValue.len:
            return false
        let tokenValue = texts[tokenValueTextIds[tokenId]]
        if tokenValue.len != tokenEnd - tokenStart:
            return false
        var offset: int32 = 0
        while offset < tokenValue.len:
            if nameValue[nameCursor + offset] != tokenValue[offset]:
                return false
            offset = offset + 1
        byteCursor = tokenEnd
        nameCursor = nameCursor + tokenValue.len
        innerCount = innerCount + 1
    return innerCount > 0 && byteCursor == nameEnd &&
        nameCursor == nameValue.len

# A module coordinate has two exact producer shapes.  An explicit `module`
# header is bound to its canonical parser declaration/token rows.  A source
# without a module header has no source coordinate at all: all three coordinate
# columns stay -1 and its display name is the canonical module path.  Zero
# spans and borrowed coordinates from another declaration are never accepted.
@borrows
fn CsgCompilerSymbolSourceCoordinateAuthorityWithModuleRowsStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        symbolId: int32,
        moduleDeclarationRows: int32[],
        err: var str): bool =
    let count = snapshot.symbols.symbolCids.len
    if !csgCompilerIndexValid(symbolId, count) ||
       symbolId >= snapshot.symbols.sourceIds.len ||
       symbolId >= snapshot.symbols.nameTextIds.len ||
       symbolId >= snapshot.symbols.nameSpanIds.len ||
       symbolId >= snapshot.symbols.nameTokenIds.len ||
       symbolId >= snapshot.symbols.qualifiedNameTextIds.len ||
       symbolId >= snapshot.symbols.symbolKinds.len ||
       symbolId >= snapshot.symbols.declarationSpanIds.len:
        err = " csg compiler snapshot: symbol coordinate row out of range"
        return false
    let source = snapshot.symbols.sourceIds[symbolId]
    let nameText = snapshot.symbols.nameTextIds[symbolId]
    let nameSpan = snapshot.symbols.nameSpanIds[symbolId]
    let nameToken = snapshot.symbols.nameTokenIds[symbolId]
    let qualifiedName = snapshot.symbols.qualifiedNameTextIds[symbolId]
    let kind = snapshot.symbols.symbolKinds[symbolId]
    let declarationSpan =
        snapshot.symbols.declarationSpanIds[symbolId]
    let spanCount = snapshot.spans.sourceIds.len
    let tokenCount = snapshot.tokens.spanIds.len
    let parserDeclarationCount =
        snapshot.parserSidecars.declarationKinds.len
    if !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
       source >= snapshot.sources.modulePathTextIds.len ||
       !csgCompilerIndexValid(nameText, snapshot.texts.len) ||
       !csgCompilerIndexValid(qualifiedName, snapshot.texts.len) ||
       !csgCompilerSymbolKindValid(kind) ||
       spanCount != snapshot.spans.startBytes.len ||
       spanCount != snapshot.spans.endBytes.len ||
       tokenCount != snapshot.tokens.sourceIds.len ||
       tokenCount != snapshot.tokens.sourceLocalRows.len ||
       tokenCount != snapshot.tokens.lexicalParentTokenIds.len ||
       tokenCount != snapshot.tokens.valueTextIds.len ||
       moduleDeclarationRows.len !=
           snapshot.sources.documentCids.len ||
       parserDeclarationCount !=
           snapshot.parserSidecars.declarationProducerSourceIds.len ||
       parserDeclarationCount !=
           snapshot.parserSidecars.declarationNameTokenIds.len ||
       parserDeclarationCount !=
           snapshot.parserSidecars.declarationNameSpanIds.len ||
       parserDeclarationCount !=
           snapshot.parserSidecars.declarationSpanIds.len:
        err = " csg compiler snapshot: symbol coordinate identity invalid"
        return false
    if kind != CsgCompilerSymbolModule:
        # Identifier surfaces keep the original single-token authority.
        # Backtick operator names tokenize as separate punctuation tokens and
        # their name token is the opening backtick token (the parser's
        # declaration name token domain), so the direct form cannot hold and
        # the opener/closer bracket + byte-coverage authority decides instead.
        let directNameTokenHolds =
            csgCompilerIndexValid(nameSpan, snapshot.spans.sourceIds.len) &&
            snapshot.spans.sourceIds[nameSpan] == source &&
            csgCompilerIndexValid(nameToken, snapshot.tokens.spanIds.len) &&
            nameToken < snapshot.tokens.sourceIds.len &&
            nameToken < snapshot.tokens.valueTextIds.len &&
            snapshot.tokens.sourceIds[nameToken] == source &&
            snapshot.tokens.spanIds[nameToken] == nameSpan &&
            snapshot.tokens.valueTextIds[nameToken] == nameText
        let declarationAnchorHolds =
            csgCompilerIndexValid(nameSpan, snapshot.spans.sourceIds.len) &&
            csgCompilerIndexValid(
                declarationSpan, snapshot.spans.sourceIds.len) &&
            snapshot.spans.sourceIds[declarationSpan] == source &&
            snapshot.spans.startBytes[nameSpan] >=
                snapshot.spans.startBytes[declarationSpan] &&
            snapshot.spans.endBytes[nameSpan] <=
                snapshot.spans.endBytes[declarationSpan]
        if !declarationAnchorHolds ||
           (!directNameTokenHolds &&
            !CsgCompilerBacktickNameTokenAuthorityValid(
                snapshot.spans.startBytes,
                snapshot.spans.endBytes,
                snapshot.spans.sourceIds,
                snapshot.tokens.sourceIds,
                snapshot.tokens.spanIds,
                snapshot.tokens.kinds,
                snapshot.tokens.valueTextIds,
                snapshot.texts,
                source,
                nameSpan,
                nameToken,
                nameText)):
            err = " csg compiler snapshot: symbol name lacks exact token authority"
            return false
        err = ""
        return true
    let modulePathText = snapshot.sources.modulePathTextIds[source]
    if !csgCompilerIndexValid(modulePathText, snapshot.texts.len) ||
       qualifiedName != modulePathText:
        err = " csg compiler snapshot: module Symbol path authority drift"
        return false
    let moduleDeclaration = moduleDeclarationRows[source]
    if moduleDeclaration >= 0 &&
       (!csgCompilerIndexValid(
            moduleDeclaration, parserDeclarationCount) ||
        snapshot.parserSidecars.declarationKinds[moduleDeclaration] != 1 ||
        snapshot.parserSidecars.declarationProducerSourceIds[
            moduleDeclaration] != source):
        err = " csg compiler snapshot: module declaration index drift"
        return false
    if moduleDeclaration < 0:
        if nameText != modulePathText || nameSpan != -1 ||
           nameToken != -1 || declarationSpan != -1:
            err = " csg compiler snapshot: implicit module fabricated a source coordinate"
            return false
        err = ""
        return true
    if nameToken !=
           snapshot.parserSidecars.declarationNameTokenIds[
               moduleDeclaration] ||
       nameSpan !=
           snapshot.parserSidecars.declarationNameSpanIds[
               moduleDeclaration] ||
       declarationSpan !=
           snapshot.parserSidecars.declarationSpanIds[moduleDeclaration] ||
       !csgCompilerIndexValid(nameSpan, snapshot.spans.sourceIds.len) ||
       snapshot.spans.sourceIds[nameSpan] != source ||
       !csgCompilerIndexValid(nameToken, snapshot.tokens.spanIds.len) ||
       nameToken >= snapshot.tokens.sourceIds.len ||
       nameToken >= snapshot.tokens.valueTextIds.len ||
       snapshot.tokens.sourceIds[nameToken] != source ||
       snapshot.tokens.spanIds[nameToken] != nameSpan ||
       snapshot.tokens.valueTextIds[nameToken] != nameText ||
       !csgCompilerIndexValid(
           declarationSpan, snapshot.spans.sourceIds.len) ||
       snapshot.spans.sourceIds[declarationSpan] != source ||
       snapshot.spans.startBytes[nameSpan] <
           snapshot.spans.startBytes[declarationSpan] ||
       snapshot.spans.endBytes[nameSpan] >
           snapshot.spans.endBytes[declarationSpan]:
        err = " csg compiler snapshot: explicit module coordinate authority drift"
        return false
    err = ""
    return true

@borrows
fn CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        symbolId: int32,
        err: var str): bool =
    var moduleDeclarationRows: int32[]
    if !CsgCompilerModuleParserDeclarationRowsBySourceInto(
            snapshot, moduleDeclarationRows, err):
        return false
    return CsgCompilerSymbolSourceCoordinateAuthorityWithModuleRowsStrictValidateInto(
        snapshot, symbolId, moduleDeclarationRows, err)

@borrows
fn csgCompilerSymbolsValidateInto(snapshot: CsgCompilerSnapshotTables,
                                  requireIdentityProof: bool,
                                  err: var str): bool =
    let count = snapshot.symbols.symbolCids.len
    if count <= 0 || count != snapshot.symbols.interfaceCids.len ||
       count != snapshot.symbols.declIds.len ||
       count != snapshot.symbols.declKeyCids.len ||
       count != snapshot.symbols.declarationHeaderCids.len ||
       count != snapshot.symbols.declarationPathCids.len ||
       count != snapshot.symbols.sourceIds.len ||
       count != snapshot.symbols.nameTextIds.len ||
       count != snapshot.symbols.nameSpanIds.len ||
       count != snapshot.symbols.nameTokenIds.len ||
       count != snapshot.symbols.qualifiedNameTextIds.len ||
       count != snapshot.symbols.symbolKinds.len ||
       count != snapshot.symbols.typeIds.len ||
       count != snapshot.symbols.declarationSpanIds.len ||
       count != snapshot.symbols.ownerSymbolIds.len ||
       count != snapshot.symbols.functionIds.len ||
       count != snapshot.symbols.externFunctionIds.len ||
       count != snapshot.symbols.exportedFlags.len ||
       count != snapshot.symbols.genericConstraintStarts.len ||
       count != snapshot.symbols.genericConstraintCounts.len ||
       count != snapshot.symbols.genericParameterParserRows.len ||
       count != snapshot.symbols.genericParameterOrdinals.len ||
       count != snapshot.symbols.genericParameterDefaultTypeIds.len:
        err = " csg compiler snapshot: symbol columns mismatch"
        return false
    if requireIdentityProof &&
       !declaration.SemanticSnapshotDeclarationTableStrictValidateInto(
           snapshot.declarations, err):
        return false
    var moduleDeclarationRows: int32[]
    if !CsgCompilerModuleParserDeclarationRowsBySourceInto(
            snapshot, moduleDeclarationRows, err):
        return false
    var genericParserSeen: bool[]
    setLen(
        genericParserSeen,
        snapshot.parserSidecars.typeGenericSymbolProducerSourceIds.len)
    var constraintCursor: int32
    for row in 0..<count:
        let source = snapshot.symbols.sourceIds[row]
        let owner = snapshot.symbols.ownerSymbolIds[row]
        let function = snapshot.symbols.functionIds[row]
        let externFunction = snapshot.symbols.externFunctionIds[row]
        let symbolKind = snapshot.symbols.symbolKinds[row]
        let genericParserRow =
            snapshot.symbols.genericParameterParserRows[row]
        let genericOrdinal =
            snapshot.symbols.genericParameterOrdinals[row]
        let genericDefaultTypeId =
            snapshot.symbols.genericParameterDefaultTypeIds[row]
        if !csgCompilerCidObserved(snapshot.symbols.symbolCids[row]) ||
           !csgCompilerCidObserved(snapshot.symbols.interfaceCids[row]) ||
           !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(snapshot.symbols.nameTextIds[row],
                                  snapshot.texts.len) ||
           !csgCompilerIndexValid(snapshot.symbols.qualifiedNameTextIds[row],
                                  snapshot.texts.len) ||
           !csgCompilerSymbolKindValid(symbolKind) ||
           !csgCompilerOptionalIndexValid(snapshot.symbols.typeIds[row],
                                           snapshot.types.typeCids.len) ||
           !csgCompilerOptionalIndexValid(owner, count) || owner == row ||
           (symbolKind == CsgCompilerSymbolFunction &&
            ((function >= 0) == (externFunction >= 0) ||
             (function >= 0 &&
              (!csgCompilerIndexValid(
                   function, snapshot.functions.symbolIds.len) ||
               snapshot.functions.symbolIds[function] != row)) ||
             (externFunction >= 0 &&
              (!csgCompilerIndexValid(
                   externFunction,
                   snapshot.externFunctions.symbolIds.len) ||
               snapshot.externFunctions.symbolIds[
                   externFunction] != row)))) ||
           (symbolKind != CsgCompilerSymbolFunction &&
            (function != -1 || externFunction != -1)) ||
           !csgCompilerOptionalIndexValid(
               genericDefaultTypeId, snapshot.types.typeCids.len) ||
           snapshot.symbols.genericConstraintStarts[row] !=
               constraintCursor ||
           snapshot.symbols.genericConstraintCounts[row] < 0 ||
           snapshot.symbols.genericConstraintCounts[row] >
               snapshot.symbols.genericConstraintTypeIds.len -
                   constraintCursor ||
           (row > 0 &&
            !csgCompilerCidLess(snapshot.symbols.symbolCids[row - 1],
                                snapshot.symbols.symbolCids[row])):
            err = " csg compiler snapshot: invalid symbol row"
            return false
        if symbolKind == CsgCompilerSymbolGenericParameter:
            let ownerKind =
                owner >= 0 && owner < snapshot.symbols.symbolKinds.len ?
                    snapshot.symbols.symbolKinds[owner] : 0
            let typeId = snapshot.symbols.typeIds[row]
            if !csgCompilerIndexValid(
                   genericParserRow, genericParserSeen.len) ||
               genericParserSeen[genericParserRow] ||
               genericOrdinal < 0 ||
               !csgCompilerIndexValid(
                   typeId, snapshot.types.typeKinds.len) ||
               snapshot.types.typeKinds[typeId] !=
                   CsgCompilerTypeGenericParameter ||
               snapshot.types.genericParameterParserRows[typeId] !=
                   genericParserRow ||
               (ownerKind != CsgCompilerSymbolFunction &&
                ownerKind != CsgCompilerSymbolType) ||
               snapshot.symbols.sourceIds[owner] != source ||
               snapshot.parserSidecars.typeGenericSymbolProducerSourceIds[
                   genericParserRow] != source ||
               snapshot.parserSidecars.typeGenericSymbolNameTokenIds[
                   genericParserRow] !=
                       snapshot.symbols.nameTokenIds[row] ||
               snapshot.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds[
                   genericParserRow] !=
                       snapshot.symbols.nameTokenIds[owner] ||
               snapshot.parserSidecars.typeGenericSymbolOrdinals[
                   genericParserRow] != genericOrdinal ||
               snapshot.parserSidecars.typeGenericSymbolSpanIds[
                   genericParserRow] !=
                       snapshot.symbols.declarationSpanIds[row] ||
               (snapshot.parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds[
                    genericParserRow] < 0) !=
                   (snapshot.symbols.genericConstraintCounts[row] == 0) ||
               snapshot.symbols.genericConstraintCounts[row] > 1 ||
               (snapshot.parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds[
                    genericParserRow] < 0) !=
                   (genericDefaultTypeId < 0) ||
               snapshot.symbols.exportedFlags[row]:
                err = " csg compiler snapshot: generic parameter Symbol relation invalid"
                return false
            genericParserSeen[genericParserRow] = true
        elif genericParserRow != -1 || genericOrdinal != -1 ||
             genericDefaultTypeId != -1:
            err = " csg compiler snapshot: non-generic Symbol has generic relation"
            return false
        if requireIdentityProof &&
           (symbolKind == CsgCompilerSymbolParameter ||
            symbolKind == CsgCompilerSymbolLocal):
            var parserDeclaration: int32 = -1
            for declarationRow in 0..<
                    snapshot.parserSidecars.declarationKinds.len:
                if snapshot.parserSidecars.declarationProducerSourceIds[
                       declarationRow] != source ||
                   snapshot.parserSidecars.declarationNameTokenIds[
                       declarationRow] !=
                       snapshot.symbols.nameTokenIds[row] ||
                   snapshot.parserSidecars.declarationNameSpanIds[
                       declarationRow] !=
                       snapshot.symbols.nameSpanIds[row] ||
                   snapshot.parserSidecars.declarationSpanIds[
                       declarationRow] !=
                       snapshot.symbols.declarationSpanIds[row]:
                    continue
                if parserDeclaration >= 0:
                    err = " csg compiler snapshot: binding Symbol parser declaration ambiguous"
                    return false
                parserDeclaration = declarationRow
            let expectedParserKind =
                symbolKind == CsgCompilerSymbolParameter ?
                    CsgCompilerParserDeclarationParameter :
                    CsgCompilerParserDeclarationLocal
            if parserDeclaration < 0 ||
               snapshot.parserSidecars.declarationKinds[
                   parserDeclaration] != expectedParserKind:
                err = " csg compiler snapshot: binding Symbol parser declaration missing"
                return false
            if symbolKind == CsgCompilerSymbolLocal:
                let parserScopeId =
                    snapshot.parserSidecars.declarationLexicalScopeIds[
                        parserDeclaration]
                let declId = snapshot.symbols.declIds[row]
                var expectedScopeCid: layout.FixedBytes32
                var definitionRow: int32 = -1
                let definitionCount =
                    snapshot.valueDefinitions.groupRows.len
                if definitionCount !=
                       snapshot.valueDefinitions.originKinds.len ||
                   definitionCount !=
                       snapshot.valueDefinitions.producerSourceIndexes.len ||
                   definitionCount !=
                       snapshot.valueDefinitions.sourceLocalNodeIndexes.len ||
                   definitionCount !=
                       snapshot.valueDefinitions.declarationSourceLocalRows.len ||
                   definitionCount !=
                       snapshot.valueDefinitions.functionIds.len ||
                   definitionCount !=
                       snapshot.valueDefinitions.typeIds.len:
                    err = " csg compiler snapshot: Local Symbol value-definition columns mismatch"
                    return false
                for candidateDefinition in 0..<
                        definitionCount:
                    if snapshot.valueDefinitions.originKinds[
                           candidateDefinition] !=
                           CsgCompilerValueDefinitionOriginBindingInitializer ||
                       snapshot.valueDefinitions.producerSourceIndexes[
                           candidateDefinition] !=
                           snapshot.parserSidecars.producerSourceIndexes[
                               source] ||
                       snapshot.valueDefinitions.declarationSourceLocalRows[
                           candidateDefinition] !=
                           snapshot.parserSidecars.declarationSourceLocalRows[
                               parserDeclaration]:
                        continue
                    if definitionRow >= 0:
                        err = " csg compiler snapshot: Local Symbol has two value definitions"
                        return false
                    definitionRow = candidateDefinition
                if !csgCompilerIndexValid(
                       declId,
                       snapshot.declarations.lexicalScopeCids.len) ||
                   !CsgCompilerParserLexicalScopeIdentityCidInto(
                       snapshot, parserScopeId,
                       expectedScopeCid, err) ||
                   !layout.FixedBytes32Equal(
                       expectedScopeCid,
                       snapshot.declarations.lexicalScopeCids[
                           declId]) ||
                   !csgCompilerIndexValid(
                       definitionRow,
                       snapshot.valueDefinitions.functionIds.len) ||
                   !csgCompilerIndexValid(owner, count) ||
                   snapshot.symbols.symbolKinds[owner] !=
                       CsgCompilerSymbolFunction ||
                   snapshot.symbols.functionIds[owner] < 0 ||
                   snapshot.valueDefinitions.functionIds[
                       definitionRow] !=
                       snapshot.symbols.functionIds[owner] ||
                   snapshot.valueDefinitions.typeIds[
                       definitionRow] !=
                       snapshot.symbols.typeIds[row]:
                    if err == "":
                        err = " csg compiler snapshot: Local Symbol exact definition authority drift"
                    return false
        if !CsgCompilerSymbolSourceCoordinateAuthorityWithModuleRowsStrictValidateInto(
                snapshot, row, moduleDeclarationRows, err):
            return false
        let constraintCount =
            snapshot.symbols.genericConstraintCounts[row]
        for offset in 0..<constraintCount:
            let constraintTypeId =
                snapshot.symbols.genericConstraintTypeIds[
                    constraintCursor + offset]
            if !csgCompilerIndexValid(
                   constraintTypeId, snapshot.types.typeCids.len) ||
               (offset > 0 &&
                !csgCompilerCidLess(
                    snapshot.types.typeCids[
                        snapshot.symbols.genericConstraintTypeIds[
                            constraintCursor + offset - 1]],
                    snapshot.types.typeCids[constraintTypeId])):
                err = " csg compiler snapshot: invalid generic constraint set"
                return false
        constraintCursor = constraintCursor + constraintCount
        if requireIdentityProof:
            var expectedSymbolCid: layout.FixedBytes32
            var expectedInterfaceCid: layout.FixedBytes32
            var expectedQualifiedName: str
            let declId = snapshot.symbols.declIds[row]
            let symbolKind = snapshot.symbols.symbolKinds[row]
            let typeId = snapshot.symbols.typeIds[row]
            var declaredSignatureCid: layout.FixedBytes32
            if csgCompilerIndexValid(
                   declId, snapshot.declarations.declIds.len):
                declaredSignatureCid =
                    snapshot.declarations.portableSignatureTypeExpressionCids[
                        declId]
            if !csgCompilerIndexValid(
                   declId, snapshot.declarations.declIds.len) ||
               (symbolKind == CsgCompilerSymbolModule && typeId != -1) ||
               (symbolKind != CsgCompilerSymbolModule &&
                (typeId < 0 ||
                 !layout.FixedBytes32Equal(
                     declaredSignatureCid,
                     snapshot.types.typeCids[typeId]))) ||
               !csgCompilerDeclarationQualifiedNameInto(
                   snapshot, declId, expectedQualifiedName) ||
               snapshot.texts[
                   snapshot.symbols.qualifiedNameTextIds[row]] !=
                   expectedQualifiedName ||
               !CsgCompilerSymbolRowCidInto(
                   snapshot, row, expectedSymbolCid, err) ||
               !layout.FixedBytes32Equal(
                   expectedSymbolCid, snapshot.symbols.symbolCids[row]) ||
               !CsgCompilerSymbolInterfaceCidInto(
                   snapshot, row, expectedInterfaceCid, err) ||
               !layout.FixedBytes32Equal(
                   expectedInterfaceCid,
                   snapshot.symbols.interfaceCids[row]):
                if err == "":
                    err = " csg compiler snapshot: symbol identity CID mismatch"
                return false
        else:
            # Inspection staging has no declaration identity until TypeArena
            # signature authority is complete.  The old header/path receipts
            # are diagnostic cargo and cannot certify SymbolCid.
            if snapshot.symbols.declIds[row] != -1 ||
               csgCompilerCidObserved(
                   snapshot.symbols.declKeyCids[row]) ||
               snapshot.symbols.typeIds[row] != -1 || constraintCount != 0:
                if err == "":
                    err = " csg compiler snapshot: provisional symbol claimed declaration authority"
                return false
    if constraintCursor != snapshot.symbols.genericConstraintTypeIds.len:
        err = " csg compiler snapshot: generic constraint coverage mismatch"
        return false
    if requireIdentityProof:
        for parserRow in 0..<genericParserSeen.len:
            if !genericParserSeen[parserRow]:
                err = " csg compiler snapshot: parser generic parameter lacks Symbol"
                return false
    if requireIdentityProof:
        var declarationSeen: bool[]
        var symbolByDeclaration: int32[]
        setLen(declarationSeen, snapshot.declarations.declIds.len)
        setLen(symbolByDeclaration, snapshot.declarations.declIds.len)
        for declId in 0..<symbolByDeclaration.len:
            symbolByDeclaration[declId] = -1
        var moduleDeclBySource: int32[]
        setLen(moduleDeclBySource, snapshot.sources.documentCids.len)
        for sourceId in 0..<moduleDeclBySource.len:
            moduleDeclBySource[sourceId] = -1
        for declId in 0..<snapshot.declarations.declIds.len:
            if snapshot.declarations.declarationKinds[declId] ==
                   declaration.SemanticSnapshotDeclarationKindModule:
                var sourceId: int32 = -1
                for candidateSourceId in 0..<snapshot.sources.documentCids.len:
                    if layout.FixedBytes32Equal(
                           snapshot.sources.documentCids[candidateSourceId],
                           snapshot.declarations.portableDocumentIdentityCids[
                               declId]):
                        if sourceId >= 0:
                            err = " csg compiler snapshot: ambiguous module document"
                            return false
                        sourceId = candidateSourceId
                if sourceId < 0 || moduleDeclBySource[sourceId] >= 0 ||
                   snapshot.sources.modulePathTextIds[sourceId] < 0 ||
                   snapshot.sources.modulePathTextIds[sourceId] >=
                       snapshot.texts.len ||
                   snapshot.texts[
                       snapshot.sources.modulePathTextIds[sourceId]] !=
                       snapshot.declarations.canonicalNames[declId]:
                    err = " csg compiler snapshot: module declaration coverage mismatch"
                    return false
                moduleDeclBySource[sourceId] = declId
        for symbolId in 0..<count:
            let declId = snapshot.symbols.declIds[symbolId]
            if declarationSeen[declId]:
                err = " csg compiler snapshot: two Symbols share one DeclId"
                return false
            declarationSeen[declId] = true
            symbolByDeclaration[declId] = symbolId
        for sourceId in 0..<moduleDeclBySource.len:
            if moduleDeclBySource[sourceId] < 0 ||
               !declarationSeen[moduleDeclBySource[sourceId]]:
                err = " csg compiler snapshot: source module Symbol missing"
                return false
        for declId in 0..<declarationSeen.len:
            if !declarationSeen[declId]:
                err = " csg compiler snapshot: declaration lacks Symbol row"
                return false
        for symbolId in 0..<count:
            let declId = snapshot.symbols.declIds[symbolId]
            let ownerDeclId = snapshot.declarations.ownerDeclIds[declId]
            let ownerSymbolId = snapshot.symbols.ownerSymbolIds[symbolId]
            if ownerDeclId < 0:
                if ownerSymbolId != -1:
                    err = " csg compiler snapshot: module Symbol owner drift"
                    return false
            elif ownerDeclId >= symbolByDeclaration.len ||
                 symbolByDeclaration[ownerDeclId] < 0 ||
                 ownerSymbolId != symbolByDeclaration[ownerDeclId]:
                err = " csg compiler snapshot: exact Symbol owner missing"
                return false
    var ownerStates: int32[]
    for row in 0..<count:
        add(ownerStates, 0)
    for row in 0..<count:
        let visitStamp = row + 1
        var current = row
        while current >= 0 && ownerStates[current] == 0:
            ownerStates[current] = visitStamp
            current = snapshot.symbols.ownerSymbolIds[current]
        if current >= 0 && ownerStates[current] == visitStamp:
            err = " csg compiler snapshot: symbol owner cycle"
            return false
        current = row
        while current >= 0 && ownerStates[current] == visitStamp:
            ownerStates[current] = -1
            current = snapshot.symbols.ownerSymbolIds[current]
    return true

@borrows
fn csgCompilerAnnotationTargetsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.annotationTargets.sourceIds.len
    let declarationCount =
        snapshot.parserSidecars.declarationKinds.len
    let spanCount = snapshot.spans.sourceIds.len
    let tokenCount = snapshot.tokens.sourceIds.len
    if count != snapshot.annotationTargets.parserAnnotationRows.len ||
       count != snapshot.annotationTargets.targetTokenIds.len ||
       count !=
           snapshot.annotationTargets.targetParserDeclarationRows.len ||
       count != snapshot.annotationTargets.targetSymbolIds.len ||
       count != snapshot.annotationTargets.targetDeclIds.len ||
       count != snapshot.annotationTargets.targetDeclKeyCids.len ||
       count != snapshot.parserSidecars.annotationProducerSourceIds.len:
        err = " csg compiler snapshot: annotation target relation columns mismatch"
        return false
    var startGroupBySpan: int32[]
    setLen(startGroupBySpan, spanCount)
    var startGroupCount: int32
    var previousSource: int32 = -1
    var previousStart: int32 = -1
    for spanId in 0..<spanCount:
        let source = snapshot.spans.sourceIds[spanId]
        let startByte = snapshot.spans.startBytes[spanId]
        if source < previousSource ||
           (source == previousSource && startByte < previousStart):
            err = " csg compiler snapshot: annotation span order drift"
            return false
        if spanId == 0 || source != previousSource ||
           startByte != previousStart:
            startGroupCount = startGroupCount + 1
        startGroupBySpan[spanId] = startGroupCount - 1
        previousSource = source
        previousStart = startByte
    var declarationByStartGroup: int32[]
    var declarationByNameToken: int32[]
    var symbolByParserDeclaration: int32[]
    setLen(declarationByStartGroup, startGroupCount)
    setLen(declarationByNameToken, tokenCount)
    setLen(symbolByParserDeclaration, declarationCount)
    for row in 0..<declarationByStartGroup.len:
        declarationByStartGroup[row] = -1
    for row in 0..<declarationByNameToken.len:
        declarationByNameToken[row] = -1
    for row in 0..<symbolByParserDeclaration.len:
        symbolByParserDeclaration[row] = -1
    for declarationRow in 0..<declarationCount:
        let span =
            snapshot.parserSidecars.declarationSpanIds[declarationRow]
        let nameToken =
            snapshot.parserSidecars.declarationNameTokenIds[declarationRow]
        if !csgCompilerIndexValid(span, spanCount):
            err = " csg compiler snapshot: annotation declaration span missing"
            return false
        let startGroup = startGroupBySpan[span]
        if declarationByStartGroup[startGroup] == -1:
            declarationByStartGroup[startGroup] = declarationRow
        else:
            declarationByStartGroup[startGroup] = -2
        if nameToken >= 0:
            if !csgCompilerIndexValid(nameToken, tokenCount) ||
               declarationByNameToken[nameToken] >= 0:
                err = " csg compiler snapshot: annotation declaration name token ambiguous"
                return false
            declarationByNameToken[nameToken] = declarationRow
    for symbolId in 0..<snapshot.symbols.symbolCids.len:
        let nameToken = snapshot.symbols.nameTokenIds[symbolId]
        if nameToken < 0:
            continue
        if !csgCompilerIndexValid(nameToken, tokenCount):
            err = " csg compiler snapshot: annotation Symbol name token out of range"
            return false
        let declarationRow = declarationByNameToken[nameToken]
        if declarationRow < 0:
            if snapshot.symbols.symbolKinds[symbolId] ==
                   CsgCompilerSymbolGenericParameter:
                continue
            err = " csg compiler snapshot: annotation Symbol lacks parser declaration"
            return false
        if symbolByParserDeclaration[declarationRow] >= 0 ||
           snapshot.symbols.sourceIds[symbolId] !=
               snapshot.parserSidecars.declarationProducerSourceIds[
                   declarationRow] ||
           snapshot.symbols.nameSpanIds[symbolId] !=
               snapshot.parserSidecars.declarationNameSpanIds[
                   declarationRow] ||
           snapshot.symbols.declarationSpanIds[symbolId] !=
               snapshot.parserSidecars.declarationSpanIds[
                   declarationRow]:
            err = " csg compiler snapshot: annotation declaration/Symbol relation drift"
            return false
        symbolByParserDeclaration[declarationRow] = symbolId
    var parserSeen: bool[]
    setLen(
        parserSeen,
        snapshot.parserSidecars.annotationProducerSourceIds.len)
    for row in 0..<count:
        let source = snapshot.annotationTargets.sourceIds[row]
        let parserRow =
            snapshot.annotationTargets.parserAnnotationRows[row]
        let targetToken = snapshot.annotationTargets.targetTokenIds[row]
        let targetParserDeclaration =
            snapshot.annotationTargets.targetParserDeclarationRows[row]
        let targetSymbol =
            snapshot.annotationTargets.targetSymbolIds[row]
        let targetDecl = snapshot.annotationTargets.targetDeclIds[row]
        let targetDeclKey =
            snapshot.annotationTargets.targetDeclKeyCids[row]
        let anchorSpan =
            csgCompilerIndexValid(targetToken, snapshot.tokens.spanIds.len) ?
                snapshot.tokens.spanIds[targetToken] : -1
        let exactParserDeclaration =
            csgCompilerIndexValid(anchorSpan, startGroupBySpan.len) ?
                declarationByStartGroup[startGroupBySpan[anchorSpan]] : -1
        if parserRow != row ||
           !csgCompilerIndexValid(parserRow, parserSeen.len) ||
           parserSeen[parserRow] ||
           source !=
               snapshot.parserSidecars.annotationProducerSourceIds[
                   parserRow] ||
           targetToken !=
               snapshot.parserSidecars.annotationTargetTokenIds[parserRow] ||
           !csgCompilerIndexValid(targetToken, tokenCount) ||
           snapshot.tokens.sourceIds[targetToken] != source ||
           !csgCompilerIndexValid(anchorSpan, spanCount) ||
           !csgCompilerIndexValid(
               exactParserDeclaration, declarationCount) ||
           targetParserDeclaration != exactParserDeclaration ||
           !csgCompilerIndexValid(
               targetSymbol, snapshot.symbols.symbolCids.len) ||
           symbolByParserDeclaration[targetParserDeclaration] !=
               targetSymbol ||
           !csgCompilerIndexValid(
               targetDecl, snapshot.declarations.declIds.len) ||
           snapshot.symbols.declIds[targetSymbol] != targetDecl ||
           !layout.FixedBytes32Equal(
               targetDeclKey,
               snapshot.declarations.declKeyCids[targetDecl]) ||
           !layout.FixedBytes32Equal(
               targetDeclKey,
               snapshot.symbols.declKeyCids[targetSymbol]):
            err = " csg compiler snapshot: invalid annotation target relation"
            return false
        parserSeen[parserRow] = true
    for parserRow in 0..<parserSeen.len:
        if !parserSeen[parserRow]:
            err = " csg compiler snapshot: annotation target relation missing"
            return false
    return true

@borrows
fn CsgCompilerAnnotationTargetsStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if !csgCompilerParserGenericAnnotationValidateInto(snapshot, err) ||
       !csgCompilerAnnotationTargetsValidateInto(snapshot, err):
        return false
    err = ""
    return true

@borrows
fn csgCompilerLexicalScopesValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let scopeCount = snapshot.lexicalScopes.sourceIds.len
    let parserScopeCount =
        snapshot.parserSidecars.declarationLexicalScopeKinds.len
    if scopeCount <= 0 ||
       scopeCount != snapshot.lexicalScopes.spanIds.len ||
       scopeCount != snapshot.lexicalScopes.parentScopeIds.len ||
       scopeCount != snapshot.lexicalScopes.producerKinds.len ||
       scopeCount != snapshot.lexicalScopes.producerIds.len ||
       scopeCount != snapshot.lexicalScopes.parserBridgeScopeIds.len ||
       scopeCount != snapshot.lexicalScopes.ownerDeclIds.len ||
       scopeCount != snapshot.lexicalScopes.ownerFunctionIds.len ||
       scopeCount != snapshot.lexicalScopes.visibleStarts.len ||
       scopeCount != snapshot.lexicalScopes.visibleCounts.len ||
       parserScopeCount <= 0 ||
       parserScopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds.len ||
       parserScopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeParentIds.len ||
       parserScopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds.len ||
       parserScopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeSpanIds.len:
        err = Fmt" csg compiler snapshot: lexical scope columns mismatch scopes={scopeCount} span={snapshot.lexicalScopes.spanIds.len} parent={snapshot.lexicalScopes.parentScopeIds.len} producer_kind={snapshot.lexicalScopes.producerKinds.len} producer_id={snapshot.lexicalScopes.producerIds.len} bridge={snapshot.lexicalScopes.parserBridgeScopeIds.len} owner_decl={snapshot.lexicalScopes.ownerDeclIds.len} owner_fn={snapshot.lexicalScopes.ownerFunctionIds.len} visible_start={snapshot.lexicalScopes.visibleStarts.len} visible_count={snapshot.lexicalScopes.visibleCounts.len} parser_scopes={parserScopeCount} parser_source={snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds.len} parser_parent={snapshot.parserSidecars.declarationLexicalScopeParentIds.len} parser_owner={snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds.len} parser_span={snapshot.parserSidecars.declarationLexicalScopeSpanIds.len}"
        return false
    var visibleCursor: int32
    var previousSource: int32 = -1
    var previousStart: int32 = -1
    var previousEnd: int32 = 2147483647
    var sourceRootCounts: int32[]
    for sourceId in 0..<snapshot.sources.documentCids.len:
        add(sourceRootCounts, 0)
    var parserProducerSeen: bool[]
    setLen(
        parserProducerSeen,
        parserScopeCount)
    var maximumTypedProducerId: int32 = -1
    for row in 0..<scopeCount:
        if snapshot.lexicalScopes.producerKinds[row] !=
               CsgCompilerLexicalScopeProducerTypedExpr:
            continue
        if snapshot.lexicalScopes.producerIds[row] < 0 ||
           snapshot.lexicalScopes.producerIds[row] >= scopeCount:
            err = " csg compiler snapshot: TypedExpr lexical producer out of range"
            return false
        if snapshot.lexicalScopes.producerIds[row] >
               maximumTypedProducerId:
            maximumTypedProducerId =
                snapshot.lexicalScopes.producerIds[row]
    var typedProducerSeen: bool[]
    setLen(typedProducerSeen, maximumTypedProducerId + 1)
    for row in 0..<scopeCount:
        let source = snapshot.lexicalScopes.sourceIds[row]
        let span = snapshot.lexicalScopes.spanIds[row]
        let parent = snapshot.lexicalScopes.parentScopeIds[row]
        let producerKind =
            snapshot.lexicalScopes.producerKinds[row]
        let producerId =
            snapshot.lexicalScopes.producerIds[row]
        let parserBridgeScopeId =
            snapshot.lexicalScopes.parserBridgeScopeIds[row]
        let ownerDeclId =
            snapshot.lexicalScopes.ownerDeclIds[row]
        let ownerFunctionId =
            snapshot.lexicalScopes.ownerFunctionIds[row]
        let rowVisibleCount = snapshot.lexicalScopes.visibleCounts[row]
        let parserBridgeSpanId =
            !csgCompilerIndexValid(
                parserBridgeScopeId,
                snapshot.parserSidecars.declarationLexicalScopeSpanIds.len) ?
                -1 :
                snapshot.parserSidecars.declarationLexicalScopeSpanIds[
                    parserBridgeScopeId]
        if !csgCompilerIndexValid(source,
                                  snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           snapshot.lexicalScopes.visibleStarts[row] != visibleCursor ||
           rowVisibleCount < 0 ||
           rowVisibleCount >
               snapshot.lexicalScopes.visibleSymbolIds.len - visibleCursor ||
           (parent != -1 && (parent < 0 || parent >= row)) ||
           (producerKind != CsgCompilerLexicalScopeProducerParser &&
            producerKind !=
                CsgCompilerLexicalScopeProducerTypedExpr) ||
           producerId < 0 ||
           !csgCompilerIndexValid(
               parserBridgeScopeId,
               snapshot.parserSidecars.declarationLexicalScopeKinds.len) ||
           !csgCompilerIndexValid(
               parserBridgeSpanId,
               snapshot.spans.sourceIds.len) ||
           snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[
               parserBridgeScopeId] != source ||
           snapshot.spans.startBytes[
               parserBridgeSpanId] >
               snapshot.spans.startBytes[span] ||
           snapshot.spans.endBytes[span] >
               snapshot.spans.endBytes[
                   parserBridgeSpanId] ||
           ownerDeclId < -1 ||
           ownerDeclId >= snapshot.declarations.declIds.len ||
           ownerFunctionId < -1 ||
           ownerFunctionId >= snapshot.functions.symbolIds.len:
            err = " csg compiler snapshot: invalid lexical scope row"
            return false
        if producerKind == CsgCompilerLexicalScopeProducerParser:
            if !csgCompilerIndexValid(
                   producerId, parserProducerSeen.len) ||
               parserProducerSeen[producerId] ||
               snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[
                   producerId] != source ||
               snapshot.parserSidecars.declarationLexicalScopeSpanIds[
                   producerId] != span:
                err = " csg compiler snapshot: invalid parser lexical producer"
                return false
            if parserBridgeScopeId != producerId:
                err = " csg compiler snapshot: parser lexical bridge split"
                return false
            let parserParent =
                snapshot.parserSidecars.declarationLexicalScopeParentIds[
                    producerId]
            if (parserParent < 0 && parent != -1) ||
               (parserParent >= 0 &&
                (parent < 0 ||
                 snapshot.lexicalScopes.producerKinds[parent] !=
                     CsgCompilerLexicalScopeProducerParser ||
                 snapshot.lexicalScopes.producerIds[parent] !=
                     parserParent)):
                err = " csg compiler snapshot: parser lexical parent split"
                return false
            let ownerParserDeclaration =
                snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
                    producerId]
            var ownerSymbolId: int32 = -1
            if ownerParserDeclaration >= 0:
                if ownerParserDeclaration >=
                       snapshot.parserSidecars.declarationNameTokenIds.len:
                    err = " csg compiler snapshot: parser lexical owner is out of range"
                    return false
                let ownerNameTokenId =
                    snapshot.parserSidecars.declarationNameTokenIds[
                        ownerParserDeclaration]
                for symbolId in 0..<snapshot.symbols.nameTokenIds.len:
                    if snapshot.symbols.nameTokenIds[symbolId] ==
                           ownerNameTokenId:
                        if ownerSymbolId >= 0:
                            err = " csg compiler snapshot: parser lexical owner is ambiguous"
                            return false
                        ownerSymbolId = symbolId
            let expectedOwnerDeclId =
                ownerSymbolId < 0 ? -1 :
                    snapshot.symbols.declIds[ownerSymbolId]
            let expectedOwnerFunctionId =
                ownerSymbolId < 0 ? -1 :
                    snapshot.symbols.functionIds[ownerSymbolId]
            if ownerDeclId != expectedOwnerDeclId ||
               ownerFunctionId != expectedOwnerFunctionId ||
               (ownerParserDeclaration >= 0 &&
                ownerSymbolId < 0):
                err = " csg compiler snapshot: parser lexical owner identity split"
                return false
            parserProducerSeen[producerId] = true
        else:
            if producerId >= typedProducerSeen.len ||
               typedProducerSeen[producerId] ||
               ownerFunctionId < 0:
                err = " csg compiler snapshot: invalid TypedExpr lexical producer"
                return false
            let functionSymbolId =
                snapshot.functions.symbolIds[ownerFunctionId]
            if !csgCompilerIndexValid(
                   functionSymbolId,
                   snapshot.symbols.declIds.len) ||
               snapshot.symbols.declIds[functionSymbolId] !=
                   ownerDeclId:
                err = " csg compiler snapshot: TypedExpr lexical owner identity split"
                return false
            typedProducerSeen[producerId] = true
        if parent < 0:
            sourceRootCounts[source] = sourceRootCounts[source] + 1
        else:
            let parentSpan = snapshot.lexicalScopes.spanIds[parent]
            if snapshot.lexicalScopes.sourceIds[parent] != source ||
               snapshot.spans.startBytes[parentSpan] >
                   snapshot.spans.startBytes[span] ||
               snapshot.spans.endBytes[span] >
                   snapshot.spans.endBytes[parentSpan]:
                err = " csg compiler snapshot: lexical scope parent mismatch"
                return false
        let startByte = snapshot.spans.startBytes[span]
        let endByte = snapshot.spans.endBytes[span]
        if source < previousSource ||
           (source == previousSource && startByte < previousStart) ||
           (source == previousSource && startByte == previousStart &&
            endByte > previousEnd):
            err = " csg compiler snapshot: lexical scopes are not canonical"
            return false
        var previousVisibleSymbol: int32 = -1
        for offset in 0..<rowVisibleCount:
            let symbolId = snapshot.lexicalScopes.visibleSymbolIds[
                visibleCursor + offset]
            if !csgCompilerIndexValid(
                    symbolId, snapshot.symbols.symbolCids.len) ||
               symbolId <= previousVisibleSymbol:
                err = " csg compiler snapshot: invalid visible SymbolId set"
                return false
            previousVisibleSymbol = symbolId
        visibleCursor = visibleCursor + rowVisibleCount
        previousSource = source
        previousStart = startByte
        previousEnd = endByte
    if visibleCursor != snapshot.lexicalScopes.visibleSymbolIds.len:
        err = " csg compiler snapshot: lexical visibility coverage mismatch"
        return false
    for sourceId in 0..<sourceRootCounts.len:
        if sourceRootCounts[sourceId] != 1:
            err = " csg compiler snapshot: source lexical root is not unique"
            return false
    for producerId in 0..<parserProducerSeen.len:
        if !parserProducerSeen[producerId]:
            err = " csg compiler snapshot: parser lexical producer missing"
            return false
    return true

@borrows
fn CsgCompilerSnapshotLexicalScopesStrictValidateInto(
        snapshot: var CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0 ||
       !csgCompilerLexicalScopesValidateInto(snapshot, err):
        if err == "":
            err = " csg compiler snapshot: invalid lexical scope envelope"
        return false
    err = ""
    return true

@borrows
fn csgCompilerFunctionsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.functions.symbolIds.len
    if count != snapshot.functions.typedFunctionIndexes.len ||
       count != snapshot.functions.bodySpanIds.len ||
       count != snapshot.functions.bodyContentCids.len ||
       count != snapshot.functions.fragmentCids.len ||
       count != snapshot.functions.interfaceCids.len ||
       count != snapshot.functions.annotationFlags.len ||
       count != snapshot.functions.resultOwnershipKinds.len ||
       count != snapshot.functions.parameterOwnershipStarts.len ||
       count != snapshot.functions.parameterOwnershipCounts.len ||
       count !=
           snapshot.functions.manualConsumeTargetParameterSymbolIds.len ||
       count !=
           snapshot.functions.manualConsumeSourceParameterSymbolIds.len ||
       count != snapshot.functions.manualConsumeEffectCids.len ||
       count != snapshot.functions.valueDefinitionStarts.len ||
       count != snapshot.functions.valueDefinitionCounts.len ||
       count != snapshot.functions.valueDefinitionGroupStarts.len ||
       count != snapshot.functions.valueDefinitionGroupCounts.len ||
       count != snapshot.functions.readStarts.len ||
       count != snapshot.functions.readCounts.len ||
       count != snapshot.functions.readSetPreimageCids.len ||
       count != snapshot.functions.nodeStarts.len ||
       count != snapshot.functions.nodeCounts.len:
        err = " csg compiler snapshot: function columns mismatch"
        return false
    var nodeCursor: int32
    var ownershipCursor: int32
    var typedFunctionSeen: int32[]
    setLen(typedFunctionSeen, count)
    for row in 0..<count:
        let typedFunctionIndex = snapshot.functions.typedFunctionIndexes[row]
        let symbol = snapshot.functions.symbolIds[row]
        let bodySpan = snapshot.functions.bodySpanIds[row]
        let rowNodeCount = snapshot.functions.nodeCounts[row]
        let ownershipCount =
            snapshot.functions.parameterOwnershipCounts[row]
        let expectedResultOwnershipKind =
            CsgCompilerFunctionAnnotationHas(
                snapshot.functions.annotationFlags[row],
                CsgCompilerFunctionAnnotationBorrowResult) ?
                CsgCompilerOwnershipBorrowed :
                CsgCompilerOwnershipOwned
        let functionTypeId =
            symbol < 0 || symbol >= snapshot.symbols.typeIds.len ?
                -1 : snapshot.symbols.typeIds[symbol]
        var expectedManualConsumeEffectCid: layout.FixedBytes32
        if !csgCompilerIndexValid(typedFunctionIndex, count) ||
           typedFunctionSeen[typedFunctionIndex] != 0 ||
           !csgCompilerIndexValid(symbol, snapshot.symbols.symbolCids.len) ||
           snapshot.symbols.symbolKinds[symbol] != CsgCompilerSymbolFunction ||
           !csgCompilerIndexValid(bodySpan, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[bodySpan] !=
               snapshot.symbols.sourceIds[symbol] ||
           !csgCompilerCidObserved(
               snapshot.functions.bodyContentCids[row]) ||
           !csgCompilerCidObserved(snapshot.functions.fragmentCids[row]) ||
           !csgCompilerCidObserved(snapshot.functions.interfaceCids[row]) ||
           !CsgCompilerFunctionAnnotationFlagsValid(
               snapshot.functions.annotationFlags[row]) ||
           snapshot.functions.resultOwnershipKinds[row] !=
               expectedResultOwnershipKind ||
           !layout.FixedBytes32Equal(snapshot.functions.interfaceCids[row],
                                     snapshot.symbols.interfaceCids[symbol]) ||
           snapshot.symbols.functionIds[symbol] != row ||
           snapshot.symbols.externFunctionIds[symbol] != -1 ||
           snapshot.functions.parameterOwnershipStarts[row] !=
               ownershipCursor ||
           ownershipCount < 0 ||
           ownershipCount >
               snapshot.functions.parameterOwnershipKinds.len -
                   ownershipCursor ||
           (functionTypeId < 0 && ownershipCount != 0) ||
           (functionTypeId >= 0 &&
            (functionTypeId >= snapshot.types.typeKinds.len ||
             snapshot.types.typeKinds[functionTypeId] !=
                 CsgCompilerTypeFunction ||
             functionTypeId >= snapshot.types.argCounts.len ||
             snapshot.types.argCounts[functionTypeId] !=
                 ownershipCount)) ||
           snapshot.functions.nodeStarts[row] != nodeCursor ||
           rowNodeCount < 0 ||
           rowNodeCount >
               snapshot.typedNodes.functionIds.len - nodeCursor:
            err = " csg compiler snapshot: invalid function row"
            return false
        if !CsgCompilerFunctionManualConsumeEffectCidInto(
               snapshot,
               row,
               expectedManualConsumeEffectCid,
               err) ||
           !layout.FixedBytes32Equal(
               snapshot.functions.manualConsumeEffectCids[row],
               expectedManualConsumeEffectCid):
            if err == "":
                err = " csg compiler snapshot: manual consume Function effect drift"
            return false
        for ownershipOffset in 0..<ownershipCount:
            let ownershipKind =
                snapshot.functions.parameterOwnershipKinds[
                    ownershipCursor + ownershipOffset]
            var expectedOwnershipKind: int32
            if !csgCompilerOwnershipKindValid(ownershipKind) ||
               !csgCompilerFunctionParameterOwnershipExpectedInto(
                   snapshot, functionTypeId, ownershipOffset,
                   expectedOwnershipKind, err) ||
               ownershipKind != expectedOwnershipKind:
                err = " csg compiler snapshot: invalid function parameter ownership"
                return false
        typedFunctionSeen[typedFunctionIndex] = 1
        nodeCursor = nodeCursor + rowNodeCount
        ownershipCursor = ownershipCursor + ownershipCount
    if nodeCursor != snapshot.typedNodes.functionIds.len ||
       ownershipCursor !=
           snapshot.functions.parameterOwnershipKinds.len:
        err = " csg compiler snapshot: function coverage mismatch"
        return false
    for typedFunctionIndex in 0..<typedFunctionSeen.len:
        if typedFunctionSeen[typedFunctionIndex] != 1:
            err = " csg compiler snapshot: typed-function producer coverage mismatch"
            return false
    return true

@borrows
fn csgCompilerExternFunctionsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.externFunctions.symbolIds.len
    if count != snapshot.externFunctions.parserDeclarationRows.len ||
       count != snapshot.externFunctions.typeIds.len ||
       count != snapshot.externFunctions.externalNameTextIds.len ||
       count != snapshot.externFunctions.abiKinds.len ||
       count != snapshot.externFunctions.importAnnotationRows.len ||
       count != snapshot.externFunctions.interfaceCids.len:
        err = " csg compiler snapshot: extern function columns mismatch"
        return false
    var previousSymbolId: int32 = -1
    for row in 0..<count:
        let symbolId = snapshot.externFunctions.symbolIds[row]
        let parserDeclarationRow =
            snapshot.externFunctions.parserDeclarationRows[row]
        let typeId = snapshot.externFunctions.typeIds[row]
        let externalNameTextId =
            snapshot.externFunctions.externalNameTextIds[row]
        let importAnnotationRow =
            snapshot.externFunctions.importAnnotationRows[row]
        if !csgCompilerIndexValid(
               symbolId, snapshot.symbols.symbolCids.len) ||
           symbolId <= previousSymbolId ||
           snapshot.symbols.symbolKinds[symbolId] !=
               CsgCompilerSymbolFunction ||
           snapshot.symbols.functionIds[symbolId] != -1 ||
           snapshot.symbols.externFunctionIds[symbolId] != row ||
           !csgCompilerIndexValid(
               parserDeclarationRow,
               snapshot.parserSidecars.declarationKinds.len) ||
           snapshot.parserSidecars.declarationKinds[
               parserDeclarationRow] !=
               CsgCompilerParserDeclarationFunction ||
           snapshot.parserSidecars.declarationProducerSourceIds[
               parserDeclarationRow] !=
               snapshot.symbols.sourceIds[symbolId] ||
           snapshot.parserSidecars.declarationNameTokenIds[
               parserDeclarationRow] !=
               snapshot.symbols.nameTokenIds[symbolId] ||
           snapshot.parserSidecars.declarationNameSpanIds[
               parserDeclarationRow] !=
               snapshot.symbols.nameSpanIds[symbolId] ||
           snapshot.parserSidecars.declarationSpanIds[
               parserDeclarationRow] !=
               snapshot.symbols.declarationSpanIds[symbolId] ||
           !csgCompilerIndexValid(typeId, snapshot.types.typeKinds.len) ||
           snapshot.types.typeKinds[typeId] != CsgCompilerTypeFunction ||
           snapshot.symbols.typeIds[symbolId] != typeId ||
           !csgCompilerIndexValid(externalNameTextId, snapshot.texts.len) ||
           snapshot.texts[externalNameTextId] == "" ||
           snapshot.externFunctions.abiKinds[row] != CsgCompilerExternAbiC ||
           !csgCompilerCidObserved(
               snapshot.externFunctions.interfaceCids[row]) ||
           !layout.FixedBytes32Equal(
               snapshot.externFunctions.interfaceCids[row],
               snapshot.symbols.interfaceCids[symbolId]):
            err = " csg compiler snapshot: invalid extern function row"
            return false
        if importAnnotationRow < 0:
            if externalNameTextId != snapshot.symbols.nameTextIds[symbolId]:
                err = " csg compiler snapshot: parser-native extern name drift"
                return false
        else:
            if !csgCompilerIndexValid(
                   importAnnotationRow,
                   snapshot.parserSidecars.annotationNameTokenIds.len):
                err = " csg compiler snapshot: extern annotation row missing"
                return false
            let annotationNameToken =
                snapshot.parserSidecars.annotationNameTokenIds[
                    importAnnotationRow]
            let annotationSource =
                snapshot.parserSidecars.annotationProducerSourceIds[
                    importAnnotationRow]
            let rootStart =
                snapshot.parserSidecars.annotationArgRootStarts[
                    importAnnotationRow]
            let rootCount =
                snapshot.parserSidecars.annotationArgRootCounts[
                    importAnnotationRow]
            if annotationSource != snapshot.symbols.sourceIds[symbolId] ||
               !csgCompilerIndexValid(
                   annotationNameToken, snapshot.tokens.valueTextIds.len) ||
               !csgCompilerIndexValid(
                   snapshot.tokens.valueTextIds[annotationNameToken],
                   snapshot.texts.len) ||
               snapshot.texts[
                   snapshot.tokens.valueTextIds[annotationNameToken]] !=
                   "importc" ||
               rootCount != 1 ||
               !csgCompilerIndexValid(
                   rootStart,
                   snapshot.parserSidecars.annotationArgRootIds.len):
                err = " csg compiler snapshot: extern annotation shape invalid"
                return false
            let rootArg =
                snapshot.parserSidecars.annotationArgRootIds[rootStart]
            if !csgCompilerIndexValid(
                   rootArg,
                   snapshot.parserSidecars.annotationArgKinds.len) ||
               snapshot.parserSidecars.annotationArgKinds[rootArg] !=
                   CsgCompilerParserAnnotationArgString:
                err = " csg compiler snapshot: extern annotation argument invalid"
                return false
            let argToken =
                snapshot.parserSidecars.annotationArgTokenIds[rootArg]
            if !csgCompilerIndexValid(
                   argToken, snapshot.tokens.valueTextIds.len) ||
               !csgCompilerIndexValid(
                   snapshot.tokens.valueTextIds[argToken],
                   snapshot.texts.len) ||
               snapshot.tokens.valueTextIds[argToken] != externalNameTextId:
                err = " csg compiler snapshot: extern ABI name mismatch"
                return false
            var targetMatchCount: int32
            for targetRow in 0..<snapshot.annotationTargets.sourceIds.len:
                if snapshot.annotationTargets.parserAnnotationRows[
                       targetRow] == importAnnotationRow:
                    if snapshot.annotationTargets.targetSymbolIds[
                           targetRow] != symbolId:
                        err = " csg compiler snapshot: extern annotation target drift"
                        return false
                    targetMatchCount = targetMatchCount + 1
            if targetMatchCount != 1:
                err = " csg compiler snapshot: extern annotation target missing"
                return false
        var expectedInterfaceCid: layout.FixedBytes32
        if !CsgCompilerSymbolInterfaceCidInto(
               snapshot, symbolId, expectedInterfaceCid, err):
            return false
        if !layout.FixedBytes32Equal(
               expectedInterfaceCid,
               snapshot.externFunctions.interfaceCids[row]):
            err = " csg compiler snapshot: extern interface CID mismatch"
            return false
        previousSymbolId = symbolId
    return true

@borrows
fn CsgCompilerExternFfiHandleContractsStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let table = snapshot.externFfiHandleContracts
    let contractCount = table.externSymbolIds.len
    let effectCount = table.effectKinds.len
    if snapshot.types.typeCids.len != snapshot.types.typeKinds.len ||
       snapshot.types.typeCids.len != snapshot.types.scalarKinds.len ||
       contractCount != table.functionSymbolCids.len ||
       contractCount != table.parserProvenanceCids.len ||
       contractCount != table.unwindKinds.len ||
       contractCount != table.effectStarts.len ||
       contractCount != table.effectCounts.len ||
       contractCount != table.contractCids.len ||
       contractCount != table.interfaceCids.len ||
       effectCount != table.effectContractRows.len ||
       effectCount != table.effectTargetKinds.len ||
       effectCount != table.effectParameterOrdinals.len ||
       effectCount != table.effectParameterSymbolCids.len ||
       effectCount != table.effectTypeCids.len ||
       effectCount != table.effectAbiCarrierKinds.len ||
       effectCount != table.effectCids.len:
        err = " csg compiler snapshot: ffi handle contract columns mismatch"
        return false
    if contractCount == 0 && effectCount == 0 &&
       !csgCompilerCidObserved(table.cargoCid):
        if snapshot.types.typeCids.len == 0:
            err = ""
            return true
        err = " csg compiler snapshot: ffi handle cargo CID missing"
        return false
    var effectCursor: int32
    var previousExternSymbolId: int32 = -1
    for contractRow in 0..<contractCount:
        let externSymbolId = table.externSymbolIds[contractRow]
        let externFunctionId =
            !csgCompilerIndexValid(
                externSymbolId, snapshot.symbols.externFunctionIds.len) ? -1 :
            snapshot.symbols.externFunctionIds[externSymbolId]
        if !csgCompilerIndexValid(
               externSymbolId, snapshot.symbols.symbolCids.len) ||
           externSymbolId <= previousExternSymbolId ||
           snapshot.symbols.symbolKinds[externSymbolId] !=
               CsgCompilerSymbolFunction ||
           snapshot.symbols.functionIds[externSymbolId] != -1 ||
           !csgCompilerIndexValid(
               externFunctionId, snapshot.externFunctions.symbolIds.len) ||
           snapshot.externFunctions.symbolIds[externFunctionId] !=
               externSymbolId ||
           !csgCompilerCidObserved(table.functionSymbolCids[contractRow]) ||
           !csgCompilerCidObserved(
               table.parserProvenanceCids[contractRow]) ||
           table.unwindKinds[contractRow] !=
               CsgCompilerExternFfiHandleUnwindNoUnwind ||
           table.effectStarts[contractRow] != effectCursor ||
           table.effectCounts[contractRow] < 0 ||
           table.effectCounts[contractRow] > effectCount - effectCursor:
            err = " csg compiler snapshot: invalid ffi handle contract row"
            return false
        for previousRow in 0..<contractRow:
            if layout.FixedBytes32Equal(
                   table.functionSymbolCids[previousRow],
                   table.functionSymbolCids[contractRow]):
                err = " csg compiler snapshot: duplicate ffi handle function Symbol CID"
                return false
        var previousParameterOrdinal: int32 = -1
        var resultSeen = false
        let rowEffectCount = table.effectCounts[contractRow]
        for effectOffset in 0..<rowEffectCount:
            let effectRow = effectCursor + effectOffset
            let effectKind = table.effectKinds[effectRow]
            let targetKind = table.effectTargetKinds[effectRow]
            let parameterOrdinal =
                table.effectParameterOrdinals[effectRow]
            let carrierKind =
                table.effectAbiCarrierKinds[effectRow]
            let expectedTypeCid =
                CsgCompilerExternFfiHandleTypeCid(carrierKind)
            var exactCarrierTypeCount: int32
            let expectedScalarKind =
                carrierKind == CsgCompilerExternFfiHandleAbiCarrierUInt32 ?
                    CsgCompilerScalarUInt32 :
                carrierKind == CsgCompilerExternFfiHandleAbiCarrierUInt64 ?
                    CsgCompilerScalarUInt64 : 0
            for typeId in 0..<snapshot.types.typeCids.len:
                if snapshot.types.typeKinds[typeId] == CsgCompilerTypeScalar &&
                   snapshot.types.scalarKinds[typeId] == expectedScalarKind:
                    exactCarrierTypeCount = exactCarrierTypeCount + 1
            var expectedParameterSymbolCid: layout.FixedBytes32
            if targetKind == CsgCompilerExternFfiHandleTargetResult:
                if resultSeen || effectOffset != 0 ||
                   effectKind != CsgCompilerExternFfiHandleEffectProduce ||
                   parameterOrdinal != -1 ||
                   csgCompilerCidObserved(
                       table.effectParameterSymbolCids[effectRow]):
                    err = " csg compiler snapshot: invalid ffi handle result effect"
                    return false
                resultSeen = true
            elif targetKind == CsgCompilerExternFfiHandleTargetParameter:
                if (effectKind != CsgCompilerExternFfiHandleEffectBorrow &&
                    effectKind != CsgCompilerExternFfiHandleEffectConsume) ||
                   parameterOrdinal < 0 ||
                   parameterOrdinal <= previousParameterOrdinal:
                    err = " csg compiler snapshot: invalid ffi handle parameter effect"
                    return false
                expectedParameterSymbolCid =
                    CsgCompilerExternFfiHandleParameterSymbolCid(
                        table.functionSymbolCids[contractRow],
                        parameterOrdinal,
                        expectedTypeCid,
                        carrierKind)
                previousParameterOrdinal = parameterOrdinal
            else:
                err = " csg compiler snapshot: invalid ffi handle effect target"
                return false
            let expectedEffectCid = CsgCompilerExternFfiHandleEffectCid(
                table.functionSymbolCids[contractRow],
                effectKind,
                targetKind,
                parameterOrdinal,
                expectedParameterSymbolCid,
                expectedTypeCid,
                carrierKind)
            if table.effectContractRows[effectRow] != contractRow ||
               exactCarrierTypeCount != 1 ||
               !csgCompilerCidObserved(expectedTypeCid) ||
               !layout.FixedBytes32Equal(
                   table.effectTypeCids[effectRow], expectedTypeCid) ||
               !layout.FixedBytes32Equal(
                   table.effectParameterSymbolCids[effectRow],
                   expectedParameterSymbolCid) ||
               !layout.FixedBytes32Equal(
                   table.effectCids[effectRow], expectedEffectCid):
                err = " csg compiler snapshot: ffi handle effect CID/type drift"
                return false
        var expectedContractCid: layout.FixedBytes32
        if !CsgCompilerExternFfiHandleContractCidInto(
               table, contractRow, expectedContractCid, err):
            return false
        let expectedInterfaceCid =
            CsgCompilerExternFfiHandleInterfaceCid(
                table.functionSymbolCids[contractRow],
                expectedContractCid)
        if !layout.FixedBytes32Equal(
               table.contractCids[contractRow], expectedContractCid) ||
           !layout.FixedBytes32Equal(
               table.interfaceCids[contractRow], expectedInterfaceCid):
            err = " csg compiler snapshot: ffi handle contract/interface CID drift"
            return false
        effectCursor = effectCursor + rowEffectCount
        previousExternSymbolId = externSymbolId
    if effectCursor != effectCount ||
       !csgCompilerCidObserved(table.cargoCid) ||
       !layout.FixedBytes32Equal(
           table.cargoCid,
           CsgCompilerExternFfiHandleCargoCid(table)):
        err = " csg compiler snapshot: ffi handle cargo/CSR drift"
        return false
    err = ""
    return true

@borrows
fn csgCompilerReadsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let functionCount = snapshot.functions.symbolIds.len
    let readCount = snapshot.readSet.readerFunctionIds.len
    var expectedTargetDomainKinds: int32[]
    var expectedTargetPortableKeyCids: layout.FixedBytes32[]
    var expectedStarts: int32[]
    var expectedCounts: int32[]
    var expectedReaders: int32[]
    var expectedObserved: layout.FixedBytes32[]
    var expectedForwardRows: int32[]
    var expectedReverseCid: layout.FixedBytes32
    let reverseTargetCount =
        snapshot.readSet.reverseTargetDomainKinds.len
    if readCount != snapshot.readSet.targetDomainKinds.len ||
       readCount != snapshot.readSet.targetPortableKeyCids.len ||
       readCount != snapshot.readSet.observedValueCids.len ||
       reverseTargetCount !=
           snapshot.readSet.reverseTargetPortableKeyCids.len ||
       reverseTargetCount != snapshot.readSet.reverseStarts.len ||
       reverseTargetCount != snapshot.readSet.reverseCounts.len ||
       snapshot.readSet.reverseReaderFunctionIds.len != readCount ||
       snapshot.readSet.reverseObservedValueCids.len != readCount ||
       snapshot.readSet.reverseForwardRowIds.len != readCount ||
       !csgCompilerCidObserved(snapshot.readSet.reverseIndexCid):
        err = " csg compiler snapshot: read-set columns mismatch"
        return false
    var readCursor: int32
    for functionId in 0..<functionCount:
        let symbolId = snapshot.functions.symbolIds[functionId]
        let rowReadCount =
            snapshot.functions.readCounts[functionId]
        if snapshot.functions.readStarts[functionId] != readCursor ||
           rowReadCount < 0 ||
           rowReadCount > readCount - readCursor ||
           !csgCompilerCidObserved(
               snapshot.functions.readSetPreimageCids[functionId]):
            err = " csg compiler snapshot: invalid function read range"
            return false
        for readOffset in 0..<rowReadCount:
            let readRow = readCursor + readOffset
            var expectedObserved: layout.FixedBytes32
            if snapshot.readSet.readerFunctionIds[readRow] !=
                   functionId ||
               !csgCompilerReadTargetObservedCidInto(
                   snapshot,
                   snapshot.readSet.targetDomainKinds[readRow],
                   snapshot.readSet.targetPortableKeyCids[readRow],
                   expectedObserved) ||
               !layout.FixedBytes32Equal(
                   snapshot.readSet.observedValueCids[readRow],
                   expectedObserved):
                err = " csg compiler snapshot: invalid read-set row"
                return false
            if readOffset > 0:
                let previousReadRow = readRow - 1
                if !csgCompilerReadSetForwardPairSorted(
                       snapshot.readSet.targetDomainKinds,
                       snapshot.readSet.targetPortableKeyCids,
                       previousReadRow,
                       readRow):
                    err = " csg compiler snapshot: forward read-set is not canonical"
                    return false
        var readSetPreimageCid: layout.FixedBytes32
        if !CsgCompilerReadSetPreimageCidInto(
                snapshot.symbols.symbolCids[symbolId],
                snapshot.readSet.targetDomainKinds,
                snapshot.readSet.targetPortableKeyCids,
                snapshot.readSet.observedValueCids,
                readCursor,
                rowReadCount,
                readSetPreimageCid,
                err) ||
           !layout.FixedBytes32Equal(
               readSetPreimageCid,
               snapshot.functions.readSetPreimageCids[functionId]):
            if err == "":
                err = " csg compiler snapshot: read-set preimage cid mismatch"
            return false
        readCursor = readCursor + rowReadCount
    if readCursor != readCount:
        err = " csg compiler snapshot: read-set coverage mismatch"
        return false
    if !csgCompilerReadSetReverseExpectedInto(
           snapshot, expectedTargetDomainKinds,
           expectedTargetPortableKeyCids, expectedStarts, expectedCounts,
           expectedReaders, expectedObserved, expectedForwardRows,
           expectedReverseCid, err) ||
       !layout.FixedBytes32Equal(
           expectedReverseCid, snapshot.readSet.reverseIndexCid):
        if err == "":
            err = " csg compiler snapshot: reverse read-set CID mismatch"
        return false
    for targetId in 0..<expectedTargetDomainKinds.len:
        if snapshot.readSet.reverseTargetDomainKinds[targetId] !=
               expectedTargetDomainKinds[targetId] ||
           !layout.FixedBytes32Equal(
               snapshot.readSet.reverseTargetPortableKeyCids[targetId],
               expectedTargetPortableKeyCids[targetId]) ||
           snapshot.readSet.reverseStarts[targetId] !=
               expectedStarts[targetId] ||
           snapshot.readSet.reverseCounts[targetId] !=
               expectedCounts[targetId]:
            err = " csg compiler snapshot: reverse read-set CSR mismatch"
            return false
    for row in 0..<readCount:
        if snapshot.readSet.reverseReaderFunctionIds[row] !=
               expectedReaders[row] ||
           !layout.FixedBytes32Equal(
               snapshot.readSet.reverseObservedValueCids[row],
               expectedObserved[row]) ||
           snapshot.readSet.reverseForwardRowIds[row] !=
               expectedForwardRows[row]:
            err = " csg compiler snapshot: reverse read-set row mismatch"
            return false
    return true

@borrows
fn csgCompilerUnsealedReadsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    if snapshot.readSet.readerFunctionIds.len != 0 ||
       snapshot.readSet.targetDomainKinds.len != 0 ||
       snapshot.readSet.targetPortableKeyCids.len != 0 ||
       snapshot.readSet.observedValueCids.len != 0 ||
       snapshot.readSet.reverseTargetDomainKinds.len != 0 ||
       snapshot.readSet.reverseTargetPortableKeyCids.len != 0 ||
       snapshot.readSet.reverseStarts.len != 0 ||
       snapshot.readSet.reverseCounts.len != 0 ||
       snapshot.readSet.reverseReaderFunctionIds.len != 0 ||
       snapshot.readSet.reverseObservedValueCids.len != 0 ||
       snapshot.readSet.reverseForwardRowIds.len != 0 ||
       !layout.FixedBytes32Equal(
           snapshot.readSet.reverseIndexCid,
           layout.FixedBytes32()):
        err = " csg compiler snapshot: unsealed read-set authority is not empty"
        return false
    for functionId in 0..<snapshot.functions.symbolIds.len:
        if snapshot.functions.readStarts[functionId] != 0 ||
           snapshot.functions.readCounts[functionId] != 0 ||
           !layout.FixedBytes32Equal(
               snapshot.functions.readSetPreimageCids[functionId],
               layout.FixedBytes32()):
            err = " csg compiler snapshot: unsealed function read authority is not empty"
            return false
    return true

@borrows
fn CsgCompilerFunctionResultOwnershipExpectedInto(
        snapshot: CsgCompilerSnapshotTables,
        functionId: int32,
        out: var int32,
        err: var str): bool =
    out = 0
    err = ""
    if !csgCompilerIndexValid(
           functionId, snapshot.functions.symbolIds.len):
        err = " csg compiler snapshot: function result summary row missing"
        return false
    let symbolId = snapshot.functions.symbolIds[functionId]
    if !csgCompilerIndexValid(
           symbolId, snapshot.symbols.symbolKinds.len) ||
       symbolId >= snapshot.symbols.functionIds.len ||
       symbolId >= snapshot.symbols.declIds.len ||
       snapshot.symbols.symbolKinds[symbolId] !=
           CsgCompilerSymbolFunction ||
       snapshot.symbols.functionIds[symbolId] != functionId:
        err = " csg compiler snapshot: function result summary SymbolId invalid"
        return false
    var borrowResultCount: int32
    for targetRow in 0..<snapshot.annotationTargets.sourceIds.len:
        if targetRow >=
               snapshot.annotationTargets.parserAnnotationRows.len ||
           targetRow >=
               snapshot.annotationTargets.targetSymbolIds.len ||
           targetRow >= snapshot.annotationTargets.targetDeclIds.len:
            err = " csg compiler snapshot: function result annotation relation columns mismatch"
            return false
        if snapshot.annotationTargets.targetSymbolIds[targetRow] !=
               symbolId:
            continue
        let parserAnnotationRow =
            snapshot.annotationTargets.parserAnnotationRows[targetRow]
        if !csgCompilerIndexValid(
               parserAnnotationRow,
               snapshot.parserSidecars.annotationNameTokenIds.len) ||
           parserAnnotationRow >=
               snapshot.parserSidecars.annotationArgRootCounts.len:
            err = " csg compiler snapshot: function result annotation parser row invalid"
            return false
        let nameTokenId =
            snapshot.parserSidecars.annotationNameTokenIds[
                parserAnnotationRow]
        if !csgCompilerIndexValid(
               nameTokenId, snapshot.tokens.valueTextIds.len):
            err = " csg compiler snapshot: function result annotation name token missing"
            return false
        let nameTextId = snapshot.tokens.valueTextIds[nameTokenId]
        if !csgCompilerIndexValid(nameTextId, snapshot.texts.len):
            err = " csg compiler snapshot: function result annotation name text missing"
            return false
        if snapshot.texts[nameTextId] != "borrow_result":
            continue
        if snapshot.annotationTargets.targetDeclIds[targetRow] !=
               snapshot.symbols.declIds[symbolId] ||
           snapshot.parserSidecars.annotationArgRootCounts[
               parserAnnotationRow] != 0:
            err = " csg compiler snapshot: @borrow_result exact target invalid"
            return false
        borrowResultCount = borrowResultCount + 1
    if borrowResultCount > 1:
        err = " csg compiler snapshot: duplicate @borrow_result function summary"
        return false
    out = borrowResultCount == 1 ?
        CsgCompilerOwnershipBorrowed :
        CsgCompilerOwnershipOwned
    return true

@borrows
fn csgCompilerFunctionResultOwnershipExactValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    for functionId in 0..<snapshot.functions.symbolIds.len:
        var expected: int32
        if !CsgCompilerFunctionResultOwnershipExpectedInto(
               snapshot, functionId, expected, err):
            return false
        let flagExpected =
            CsgCompilerFunctionAnnotationHas(
                snapshot.functions.annotationFlags[functionId],
                CsgCompilerFunctionAnnotationBorrowResult) ?
                CsgCompilerOwnershipBorrowed :
                CsgCompilerOwnershipOwned
        if expected != flagExpected ||
           snapshot.functions.resultOwnershipKinds[functionId] !=
               expected:
            err = " csg compiler snapshot: exact @borrow_result Function summary drift"
            return false
    return true

@borrows
fn csgCompilerFunctionsAndReadsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    if !csgCompilerFunctionsValidateInto(snapshot, err) ||
       !csgCompilerExternFunctionsValidateInto(snapshot, err) ||
       !CsgCompilerExternFfiHandleContractsStrictValidateInto(
           snapshot, err):
        return false
    return csgCompilerReadsValidateInto(snapshot, err)

@borrows
fn csgCompilerParserFunctionIdentityValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let functionCount = snapshot.functions.symbolIds.len
    if snapshot.parserSidecars.functionIndexes.len != functionCount:
        err = " csg compiler snapshot: parser/function identity coverage mismatch"
        return false
    var functionByBodySpan: int32[]
    setLen(functionByBodySpan, snapshot.spans.sourceIds.len)
    for spanId in 0..<functionByBodySpan.len:
        functionByBodySpan[spanId] = -1
    for functionId in 0..<functionCount:
        let bodySpanId = snapshot.functions.bodySpanIds[functionId]
        if !csgCompilerIndexValid(bodySpanId, functionByBodySpan.len) ||
           functionByBodySpan[bodySpanId] >= 0:
            err = " csg compiler snapshot: function body identity is not unique"
            return false
        functionByBodySpan[bodySpanId] = functionId
    var functionSeen: bool[]
    setLen(functionSeen, functionCount)
    for parserRow in 0..<functionCount:
        let bodySpanId =
            snapshot.parserSidecars.functionBodySpanIds[parserRow]
        if !csgCompilerIndexValid(bodySpanId, functionByBodySpan.len):
            err = " csg compiler snapshot: parser function body identity missing"
            return false
        let functionId = functionByBodySpan[bodySpanId]
        if functionId < 0 || functionSeen[functionId]:
            err = " csg compiler snapshot: parser/function identity is not bijective"
            return false
        let symbolId = snapshot.functions.symbolIds[functionId]
        let declId = !csgCompilerIndexValid(
            symbolId, snapshot.symbols.declIds.len) ? -1 :
            snapshot.symbols.declIds[symbolId]
        if !csgCompilerIndexValid(symbolId, snapshot.symbols.symbolCids.len) ||
           !csgCompilerIndexValid(
               declId, snapshot.declarations.declIds.len) ||
           snapshot.symbols.declarationSpanIds[symbolId] !=
               snapshot.parserSidecars.functionDeclarationSpanIds[parserRow] ||
           snapshot.symbols.nameSpanIds[symbolId] !=
               snapshot.parserSidecars.functionNameSpanIds[parserRow] ||
           snapshot.symbols.nameTextIds[symbolId] !=
               snapshot.parserSidecars.functionNameTextIds[parserRow] ||
           snapshot.declarations.nameSurfaceKinds[declId] !=
               snapshot.parserSidecars.functionNameSurfaceKinds[parserRow] ||
           snapshot.declarations.canonicalNames[declId] !=
               snapshot.texts[
                   snapshot.parserSidecars.functionNameTextIds[parserRow]] ||
           !layout.FixedBytes32Equal(
               snapshot.declarations.parserValidatedNameProofCids[declId],
               snapshot.parserSidecars.functionNameProofCids[parserRow]) ||
           !layout.FixedBytes32Equal(
               snapshot.symbols.declarationHeaderCids[symbolId],
               snapshot.parserSidecars.functionDeclarationHeaderCids[
                   parserRow]) ||
           !layout.FixedBytes32Equal(
               snapshot.symbols.declarationPathCids[symbolId],
               snapshot.parserSidecars.functionDeclarationPathCids[
                   parserRow]) ||
           snapshot.functions.annotationFlags[functionId] !=
               snapshot.parserSidecars.functionAnnotationFlags[
                   parserRow]:
            err = " csg compiler snapshot: parser/function identity mismatch"
            return false
        functionSeen[functionId] = true
    for functionId in 0..<functionSeen.len:
        if !functionSeen[functionId]:
            err = " csg compiler snapshot: parser/function identity coverage mismatch"
            return false
    return true

@borrows
fn CsgCompilerCallResultOwnershipProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        callId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if !csgCompilerIndexValid(
           callId, snapshot.calls.callReferenceIds.len) ||
       callId >= snapshot.calls.callerFunctionIds.len ||
       callId >= snapshot.calls.calleeSymbolIds.len ||
       callId >= snapshot.calls.targetCallDeclarationRows.len ||
       callId >= snapshot.calls.targetSourceIds.len ||
       callId >=
           snapshot.calls.targetSourceLocalDeclarationRows.len ||
       callId >= snapshot.calls.targetParserDeclarationRows.len ||
       callId >= snapshot.calls.targetDeclIds.len ||
       callId >= snapshot.calls.targetDeclKeyCids.len ||
       callId >= snapshot.calls.targetSymbolCids.len ||
       callId >= snapshot.calls.resultTypedNodeIds.len ||
       callId >= snapshot.calls.resultValueDefinitionRows.len ||
       callId >= snapshot.calls.resultTypeIds.len ||
       callId >= snapshot.calls.resultOwnershipKinds.len ||
       callId >= snapshot.calls.resultOwnershipProofKinds.len:
        err = " csg compiler snapshot: call ownership proof row out of range"
        return false
    let referenceId = snapshot.calls.callReferenceIds[callId]
    let callerFunctionId = snapshot.calls.callerFunctionIds[callId]
    let calleeSymbolId = snapshot.calls.calleeSymbolIds[callId]
    let resultTypedNodeId =
        snapshot.calls.resultTypedNodeIds[callId]
    let resultValueDefinitionRow =
        snapshot.calls.resultValueDefinitionRows[callId]
    let resultTypeId = snapshot.calls.resultTypeIds[callId]
    if !csgCompilerIndexValid(
           referenceId, snapshot.references.targetSymbolIds.len) ||
       !csgCompilerIndexValid(
           callerFunctionId, snapshot.functions.symbolIds.len) ||
       !csgCompilerIndexValid(
           calleeSymbolId, snapshot.symbols.symbolCids.len) ||
       calleeSymbolId >= snapshot.symbols.functionIds.len ||
       !csgCompilerIndexValid(
           resultTypedNodeId, snapshot.typedNodes.functionIds.len) ||
       !csgCompilerIndexValid(
           resultValueDefinitionRow,
           snapshot.valueDefinitions.functionIds.len) ||
       resultValueDefinitionRow >=
           snapshot.valueDefinitions.originKinds.len ||
       resultValueDefinitionRow >=
           snapshot.valueDefinitions.definingTypedNodeIds.len ||
       !csgCompilerIndexValid(resultTypeId, snapshot.types.typeCids.len) ||
       resultTypedNodeId >=
           snapshot.typedNodes.typedIrNodeIndexes.len ||
       resultTypedNodeId >=
           snapshot.typedNodes.originParserNodeIds.len ||
       resultTypedNodeId >= snapshot.typedNodes.spanIds.len ||
       resultTypedNodeId >= snapshot.typedNodes.opKinds.len ||
       resultTypedNodeId >= snapshot.typedNodes.typeIds.len ||
       resultTypedNodeId >=
           snapshot.typedNodes.producedValueDefinitionRows.len ||
       resultTypedNodeId >= snapshot.typedNodes.ownerStatementIds.len ||
       resultTypedNodeId >= snapshot.typedNodes.ownershipKinds.len ||
       resultTypedNodeId >=
           snapshot.typedNodes.ownershipProofKinds.len ||
       snapshot.typedNodes.functionIds[resultTypedNodeId] !=
           callerFunctionId ||
       snapshot.typedNodes.opKinds[resultTypedNodeId] !=
           CsgCompilerTypedOpCallExpr ||
       snapshot.typedNodes.producedValueDefinitionRows[
           resultTypedNodeId] != resultValueDefinitionRow ||
       !csgCompilerIndexValid(
           snapshot.typedNodes.ownerStatementIds[resultTypedNodeId],
           snapshot.typedStatements.functionIds.len) ||
       snapshot.typedNodes.ownerStatementIds[resultTypedNodeId] >=
           snapshot.typedStatements.typedIrStatementIndexes.len ||
       snapshot.typedStatements.functionIds[
           snapshot.typedNodes.ownerStatementIds[resultTypedNodeId]] !=
           callerFunctionId ||
       snapshot.valueDefinitions.functionIds[
           resultValueDefinitionRow] != callerFunctionId ||
       snapshot.valueDefinitions.definingTypedNodeIds[
           resultValueDefinitionRow] != resultTypedNodeId ||
       (snapshot.valueDefinitions.originKinds[
            resultValueDefinitionRow] !=
            CsgCompilerValueDefinitionOriginBindingInitializer &&
        snapshot.valueDefinitions.originKinds[
            resultValueDefinitionRow] !=
            CsgCompilerValueDefinitionOriginCallResult) ||
       snapshot.typedNodes.typeIds[resultTypedNodeId] != resultTypeId ||
       snapshot.typedNodes.ownershipKinds[resultTypedNodeId] !=
           snapshot.calls.resultOwnershipKinds[callId] ||
       snapshot.typedNodes.ownershipProofKinds[resultTypedNodeId] !=
           snapshot.calls.resultOwnershipProofKinds[callId] ||
       !csgCompilerOwnershipKindValid(
           snapshot.calls.resultOwnershipKinds[callId]) ||
       !csgCompilerValueProofKindValid(
           snapshot.calls.resultOwnershipProofKinds[callId]):
        err = " csg compiler snapshot: call result TypedExpr producer binding is missing"
        return false
    let calleeFunctionId =
        snapshot.symbols.functionIds[calleeSymbolId]
    if calleeFunctionId >= 0:
        if !csgCompilerIndexValid(
               calleeFunctionId,
               snapshot.functions.resultOwnershipKinds.len) ||
           resultTypeId >= snapshot.types.managedFlags.len:
            err = " csg compiler snapshot: call callee result summary missing"
            return false
        let expectedCallOwnership =
            snapshot.types.managedFlags[resultTypeId] ?
                snapshot.functions.resultOwnershipKinds[
                    calleeFunctionId] :
                CsgCompilerOwnershipUnmanaged
        if snapshot.calls.resultOwnershipKinds[callId] !=
               expectedCallOwnership:
            err = " csg compiler snapshot: call result ownership disagrees with callee summary"
            return false
    let callerSymbolId =
        snapshot.functions.symbolIds[callerFunctionId]
    var buf = layout.ByteBufInit(448)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.call_semantic_proof")
    csgCompilerTypeCidAppendU32(buf, referenceId)
    csgCompilerTypeCidAppendU32(
        buf, snapshot.calls.targetCallDeclarationRows[callId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.calls.targetSourceIds[callId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.calls.targetSourceLocalDeclarationRows[callId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.calls.targetParserDeclarationRows[callId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.calls.targetDeclIds[callId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.calls.targetDeclKeyCids[callId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.calls.targetSymbolCids[callId])
    csgCompilerTypeCidAppendU32(buf, resultTypedNodeId)
    csgCompilerTypeCidAppendU32(buf, resultValueDefinitionRow)
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.typedIrNodeIndexes[resultTypedNodeId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.originParserNodeIds[resultTypedNodeId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.spanIds[resultTypedNodeId])
    let ownerStatementId =
        snapshot.typedNodes.ownerStatementIds[resultTypedNodeId]
    csgCompilerTypeCidAppendU32(buf, ownerStatementId)
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedStatements.typedIrStatementIndexes[
            ownerStatementId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.symbols.symbolCids[callerSymbolId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.functions.interfaceCids[callerFunctionId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.symbols.symbolCids[calleeSymbolId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.symbols.interfaceCids[calleeSymbolId])
    csgCompilerTypeCidAppendU32(
        buf,
        calleeFunctionId >= 0 ?
            snapshot.functions.resultOwnershipKinds[calleeFunctionId] :
            0)
    layout.ByteBufAppendFixed32(buf, snapshot.types.typeCids[resultTypeId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.calls.resultOwnershipKinds[callId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.calls.resultOwnershipProofKinds[callId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn csgCompilerBindingReferenceTargetValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        referenceRow: int32,
        err: var str): bool =
    let targetSymbolId =
        snapshot.references.targetSymbolIds[referenceRow]
    let targetKind =
        snapshot.symbols.symbolKinds[targetSymbolId]
    let typedNodeId =
        snapshot.references.bindingTypedNodeIds[referenceRow]
    if targetKind != CsgCompilerSymbolParameter &&
       targetKind != CsgCompilerSymbolLocal:
        if typedNodeId != -1:
            err = " csg compiler snapshot: non-binding reference retained TypedNode identity"
            return false
        return true
    if snapshot.references.referenceKinds[referenceRow] !=
           CsgCompilerReferenceRead ||
       !csgCompilerIndexValid(
           typedNodeId, snapshot.typedNodes.opKinds.len):
        err = " csg compiler snapshot: binding reference kind has no TypedExpr producer"
        return false
    let sourceId =
        snapshot.references.sourceIds[referenceRow]
    let functionId =
        snapshot.references.ownerFunctionIds[referenceRow]
    let spanId =
        snapshot.references.spanIds[referenceRow]
    let typedNodeCount = snapshot.typedNodes.opKinds.len
    if typedNodeCount !=
           snapshot.typedNodes.typedIrNodeIndexes.len ||
       typedNodeCount != snapshot.typedNodes.functionIds.len ||
       typedNodeCount != snapshot.typedNodes.spanIds.len ||
       typedNodeCount !=
           snapshot.typedNodes.bindingProducerSourceIndexes.len ||
       typedNodeCount !=
           snapshot.typedNodes.bindingParserSourceLocalNodeRows.len ||
       typedNodeCount !=
           snapshot.typedNodes.bindingDeclarationSourceLocalRows.len ||
       typedNodeCount !=
           snapshot.typedNodes.bindingPatternSourceLocalRows.len ||
       typedNodeCount !=
           snapshot.typedNodes.bindingValueDefinitionRows.len ||
       typedNodeCount !=
           snapshot.typedNodes.producedValueDefinitionRows.len ||
       typedNodeCount != snapshot.typedNodes.originParserNodeIds.len ||
       typedNodeCount != snapshot.typedNodes.typeIds.len ||
       targetSymbolId >= snapshot.symbols.ownerSymbolIds.len ||
       targetSymbolId >= snapshot.symbols.nameTokenIds.len ||
       targetSymbolId >= snapshot.symbols.nameSpanIds.len ||
       targetSymbolId >= snapshot.symbols.declarationSpanIds.len ||
       targetSymbolId >= snapshot.symbols.typeIds.len ||
       !csgCompilerIndexValid(
           functionId, snapshot.functions.symbolIds.len) ||
       snapshot.symbols.ownerSymbolIds[targetSymbolId] !=
           snapshot.functions.symbolIds[functionId]:
        err = " csg compiler snapshot: binding reference crossed Function identity"
        return false
    let expectedOp =
        targetKind == CsgCompilerSymbolParameter ?
            CsgCompilerTypedOpParamRef :
            CsgCompilerTypedOpLocalRef
    let producerSourceIndex =
        snapshot.typedNodes.bindingProducerSourceIndexes[typedNodeId]
    let parserSourceLocalNodeRow =
        snapshot.typedNodes.bindingParserSourceLocalNodeRows[typedNodeId]
    let declarationSourceLocalRow =
        snapshot.typedNodes.bindingDeclarationSourceLocalRows[typedNodeId]
    let patternSourceLocalRow =
        snapshot.typedNodes.bindingPatternSourceLocalRows[typedNodeId]
    let originParserNodeId =
        snapshot.typedNodes.originParserNodeIds[typedNodeId]
    if snapshot.typedNodes.typedIrNodeIndexes[typedNodeId] < 0 ||
       snapshot.typedNodes.functionIds[typedNodeId] != functionId ||
       snapshot.typedNodes.spanIds[typedNodeId] != spanId ||
       snapshot.typedNodes.opKinds[typedNodeId] != expectedOp ||
       snapshot.typedNodes.typeIds[typedNodeId] !=
           snapshot.symbols.typeIds[targetSymbolId] ||
       producerSourceIndex < 0 ||
       parserSourceLocalNodeRow < 0 ||
       declarationSourceLocalRow < 0 ||
       !csgCompilerIndexValid(
           originParserNodeId, snapshot.parserNodes.sourceIds.len) ||
       originParserNodeId >= snapshot.parserNodes.producerNodeIds.len ||
       originParserNodeId >= snapshot.parserNodes.kinds.len ||
       originParserNodeId >=
           snapshot.parserNodes.bindingResolutionKinds.len ||
       originParserNodeId >=
           snapshot.parserNodes.bindingDeclarationSourceLocalRows.len ||
       originParserNodeId >=
           snapshot.parserNodes.bindingPatternSourceLocalRows.len ||
       snapshot.parserNodes.sourceIds[originParserNodeId] != sourceId ||
       snapshot.parserNodes.producerNodeIds[originParserNodeId] !=
           parserSourceLocalNodeRow ||
       snapshot.parserNodes.kinds[originParserNodeId] !=
           CsgCompilerParserValueExprIdentifier ||
       snapshot.parserNodes.bindingDeclarationSourceLocalRows[
           originParserNodeId] != declarationSourceLocalRow ||
       snapshot.parserNodes.bindingPatternSourceLocalRows[
           originParserNodeId] != patternSourceLocalRow:
        err = " csg compiler snapshot: binding Reference/TypedExpr/Parser identity drift"
        return false
    var producerSourceMatchCount: int32
    for sidecarRow in 0..<snapshot.parserSidecars.sourceIds.len:
        if sidecarRow <
               snapshot.parserSidecars.producerSourceIndexes.len &&
           snapshot.parserSidecars.sourceIds[sidecarRow] == sourceId &&
           snapshot.parserSidecars.producerSourceIndexes[sidecarRow] ==
               producerSourceIndex:
            producerSourceMatchCount = producerSourceMatchCount + 1
    if producerSourceMatchCount != 1:
        err = " csg compiler snapshot: binding producer source identity drift"
        return false
    var parserDeclaration: int32 = -1
    for declarationRow in 0..<
            snapshot.parserSidecars.declarationKinds.len:
        if snapshot.parserSidecars.declarationProducerSourceIds[
               declarationRow] != sourceId ||
           snapshot.parserSidecars.declarationSourceLocalRows[
               declarationRow] != declarationSourceLocalRow:
            continue
        if parserDeclaration >= 0:
            err = " csg compiler snapshot: binding reference declaration ambiguous"
            return false
        parserDeclaration = declarationRow
    if parserDeclaration < 0:
        err = " csg compiler snapshot: binding reference declaration missing"
        return false
    if parserDeclaration >=
           snapshot.parserSidecars.declarationNameTokenIds.len ||
       parserDeclaration >=
           snapshot.parserSidecars.declarationNameSpanIds.len ||
       parserDeclaration >=
           snapshot.parserSidecars.declarationSpanIds.len ||
       snapshot.symbols.sourceIds[targetSymbolId] != sourceId ||
       snapshot.symbols.nameTokenIds[targetSymbolId] !=
           snapshot.parserSidecars.declarationNameTokenIds[
               parserDeclaration] ||
       snapshot.symbols.nameSpanIds[targetSymbolId] !=
           snapshot.parserSidecars.declarationNameSpanIds[
               parserDeclaration] ||
       snapshot.symbols.declarationSpanIds[targetSymbolId] !=
           snapshot.parserSidecars.declarationSpanIds[
               parserDeclaration]:
        err = " csg compiler snapshot: binding reference target identity drift"
        return false
    if targetKind == CsgCompilerSymbolParameter:
        if snapshot.parserSidecars.declarationKinds[
               parserDeclaration] !=
               CsgCompilerParserDeclarationParameter ||
           snapshot.parserNodes.bindingResolutionKinds[
               originParserNodeId] !=
               CsgCompilerParserBindingResolutionParameter ||
           patternSourceLocalRow != -1 ||
           !csgCompilerIndexValid(
               snapshot.typedNodes.bindingValueDefinitionRows[
                   typedNodeId],
               snapshot.valueDefinitions.originKinds.len) ||
           snapshot.valueDefinitions.originKinds[
               snapshot.typedNodes.bindingValueDefinitionRows[
                   typedNodeId]] !=
               CsgCompilerValueDefinitionOriginParameter:
            err = " csg compiler snapshot: ParamRef reference target drift"
            return false
        return true
    let definitionRow =
        snapshot.typedNodes.bindingValueDefinitionRows[
            typedNodeId]
    var parserPattern: int32 = -1
    for patternRow in 0..<snapshot.parserSidecars.patternKinds.len:
        if snapshot.parserSidecars.patternProducerSourceIds[patternRow] !=
               sourceId ||
           snapshot.parserSidecars.patternSourceLocalRows[patternRow] !=
               patternSourceLocalRow:
            continue
        if parserPattern >= 0:
            err = " csg compiler snapshot: LocalRef Pattern identity ambiguous"
            return false
        parserPattern = patternRow
    if snapshot.parserSidecars.declarationKinds[
           parserDeclaration] !=
           CsgCompilerParserDeclarationLocal ||
       snapshot.parserNodes.bindingResolutionKinds[
           originParserNodeId] !=
           CsgCompilerParserBindingResolutionPattern ||
       parserPattern < 0 ||
       parserPattern >=
           snapshot.parserSidecars.patternBindingDeclarationIds.len ||
       snapshot.parserSidecars.patternBindingDeclarationIds[
           parserPattern] != parserDeclaration ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.groupRows.len) ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.originKinds.len) ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.producerSourceIndexes.len) ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.declarationSourceLocalRows.len) ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.patternSourceLocalRows.len) ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.functionIds.len) ||
       !csgCompilerIndexValid(
           definitionRow,
           snapshot.valueDefinitions.typeIds.len) ||
       snapshot.valueDefinitions.originKinds[definitionRow] !=
           CsgCompilerValueDefinitionOriginBindingInitializer ||
       snapshot.valueDefinitions.producerSourceIndexes[
           definitionRow] != producerSourceIndex ||
       snapshot.valueDefinitions.declarationSourceLocalRows[
           definitionRow] != declarationSourceLocalRow ||
       snapshot.valueDefinitions.patternSourceLocalRows[
           definitionRow] != patternSourceLocalRow ||
       snapshot.valueDefinitions.functionIds[definitionRow] !=
           functionId ||
       snapshot.valueDefinitions.typeIds[definitionRow] !=
           snapshot.symbols.typeIds[targetSymbolId]:
        err = " csg compiler snapshot: LocalRef reference target drift"
        return false
    return true

@borrows
fn CsgCompilerBindingReferenceTargetStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        referenceRow: int32,
        err: var str): bool =
    if !csgCompilerIndexValid(
           referenceRow, snapshot.references.sourceIds.len) ||
       referenceRow >= snapshot.references.spanIds.len ||
       referenceRow >= snapshot.references.ownerFunctionIds.len ||
       referenceRow >= snapshot.references.ownerSymbolIds.len ||
       referenceRow >= snapshot.references.targetSymbolIds.len ||
       referenceRow >= snapshot.references.referenceKinds.len ||
       referenceRow >= snapshot.references.bindingTypedNodeIds.len ||
       !csgCompilerIndexValid(
           snapshot.references.targetSymbolIds[referenceRow],
           snapshot.symbols.symbolKinds.len):
        err = " csg compiler snapshot: binding reference target row invalid"
        return false
    return csgCompilerBindingReferenceTargetValidateInto(
        snapshot, referenceRow, err)

@borrows
fn CsgCompilerBindingReferencesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let referenceCount = snapshot.references.sourceIds.len
    if referenceCount != snapshot.references.spanIds.len ||
       referenceCount != snapshot.references.ownerFunctionIds.len ||
       referenceCount != snapshot.references.ownerSymbolIds.len ||
       referenceCount != snapshot.references.targetSymbolIds.len ||
       referenceCount != snapshot.references.referenceKinds.len ||
       referenceCount !=
           snapshot.references.bindingTypedNodeIds.len:
        err = " csg compiler snapshot: binding reference columns mismatch"
        return false
    var bindingTypedNodeSeen: bool[]
    setLen(bindingTypedNodeSeen, snapshot.typedNodes.opKinds.len)
    for referenceRow in 0..<referenceCount:
        if !CsgCompilerBindingReferenceTargetStrictValidateInto(
                snapshot, referenceRow, err):
            return false
        let typedNodeId =
            snapshot.references.bindingTypedNodeIds[referenceRow]
        if typedNodeId >= 0:
            if bindingTypedNodeSeen[typedNodeId]:
                err = " csg compiler snapshot: binding TypedNode referenced more than once"
                return false
            bindingTypedNodeSeen[typedNodeId] = true
    for typedNodeId in 0..<bindingTypedNodeSeen.len:
        let opKind = snapshot.typedNodes.opKinds[typedNodeId]
        let sourceBackedBinding =
            typedNodeId <
                snapshot.typedNodes.bindingProducerSourceIndexes.len &&
            snapshot.typedNodes.bindingProducerSourceIndexes[
                typedNodeId] >= 0 &&
            (opKind == CsgCompilerTypedOpParamRef ||
             opKind == CsgCompilerTypedOpLocalRef)
        if bindingTypedNodeSeen[typedNodeId] != sourceBackedBinding:
            err = " csg compiler snapshot: binding Reference/TypedNode coverage mismatch"
            return false
    return true

@borrows
fn csgCompilerReferencesAndCallsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let referenceCount = snapshot.references.sourceIds.len
    if referenceCount != snapshot.references.spanIds.len ||
       referenceCount != snapshot.references.ownerFunctionIds.len ||
       referenceCount != snapshot.references.ownerSymbolIds.len ||
       referenceCount != snapshot.references.targetSymbolIds.len ||
       referenceCount != snapshot.references.referenceKinds.len ||
       referenceCount !=
           snapshot.references.bindingTypedNodeIds.len:
        err = " csg compiler snapshot: reference columns mismatch"
        return false
    if !CsgCompilerBindingReferencesStrictValidateInto(snapshot, err):
        return false
    for row in 0..<referenceCount:
        let source = snapshot.references.sourceIds[row]
        let span = snapshot.references.spanIds[row]
        let ownerFunction = snapshot.references.ownerFunctionIds[row]
        let ownerSymbol = snapshot.references.ownerSymbolIds[row]
        let target = snapshot.references.targetSymbolIds[row]
        let referenceKind = snapshot.references.referenceKinds[row]
        if !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           !csgCompilerOptionalIndexValid(ownerFunction,
                                           snapshot.functions.symbolIds.len) ||
           !csgCompilerIndexValid(ownerSymbol,
                                  snapshot.symbols.symbolCids.len) ||
           snapshot.symbols.sourceIds[ownerSymbol] != source ||
           (snapshot.symbols.symbolKinds[ownerSymbol] !=
                CsgCompilerSymbolModule &&
            snapshot.symbols.symbolKinds[ownerSymbol] !=
                CsgCompilerSymbolType &&
            snapshot.symbols.symbolKinds[ownerSymbol] !=
                CsgCompilerSymbolFunction) ||
           snapshot.symbols.functionIds[ownerSymbol] != ownerFunction ||
           !csgCompilerIndexValid(target, snapshot.symbols.symbolCids.len) ||
           !csgCompilerReferenceKindValid(referenceKind) ||
           (referenceKind == CsgCompilerReferenceCall &&
            snapshot.symbols.symbolKinds[target] !=
                CsgCompilerSymbolFunction) ||
           (referenceKind == CsgCompilerReferenceType &&
            snapshot.symbols.symbolKinds[target] != CsgCompilerSymbolType) ||
           (referenceKind == CsgCompilerReferenceImport &&
            snapshot.symbols.symbolKinds[target] !=
                CsgCompilerSymbolModule):
            err = " csg compiler snapshot: invalid reference row"
            return false
        if row > 0:
            let previousTarget = snapshot.references.targetSymbolIds[row - 1]
            let previousSource = snapshot.references.sourceIds[row - 1]
            let previousSpan = snapshot.references.spanIds[row - 1]
            let previousTyped =
                snapshot.references.bindingTypedNodeIds[row - 1]
            let typed = snapshot.references.bindingTypedNodeIds[row]
            if target < previousTarget ||
               (target == previousTarget && source < previousSource) ||
               (target == previousTarget && source == previousSource &&
                span < previousSpan) ||
               (target == previousTarget && source == previousSource &&
                span == previousSpan && typed <= previousTyped):
                err = " csg compiler snapshot: references are not canonical"
                return false
    let callCount = snapshot.calls.callReferenceIds.len
    if callCount != snapshot.calls.callerFunctionIds.len ||
       callCount != snapshot.calls.calleeSymbolIds.len ||
       callCount != snapshot.calls.targetCallDeclarationRows.len ||
       callCount != snapshot.calls.targetSourceIds.len ||
       callCount !=
           snapshot.calls.targetSourceLocalDeclarationRows.len ||
       callCount != snapshot.calls.targetParserDeclarationRows.len ||
       callCount != snapshot.calls.targetDeclIds.len ||
       callCount != snapshot.calls.targetDeclKeyCids.len ||
       callCount != snapshot.calls.targetSymbolCids.len ||
       callCount != snapshot.calls.resultTypedNodeIds.len ||
       callCount != snapshot.calls.resultValueDefinitionRows.len ||
       callCount != snapshot.calls.resultTypeIds.len ||
       callCount != snapshot.calls.resultOwnershipKinds.len ||
       callCount != snapshot.calls.resultOwnershipProofKinds.len ||
       callCount != snapshot.calls.resultOwnershipProofCids.len:
        err = " csg compiler snapshot: call columns mismatch"
        return false
    for row in 0..<callCount:
        let reference = snapshot.calls.callReferenceIds[row]
        let caller = snapshot.calls.callerFunctionIds[row]
        let callee = snapshot.calls.calleeSymbolIds[row]
        let targetCallDeclarationRow =
            snapshot.calls.targetCallDeclarationRows[row]
        let targetSource = snapshot.calls.targetSourceIds[row]
        let targetLocalDeclaration =
            snapshot.calls.targetSourceLocalDeclarationRows[row]
        let targetParserDeclaration =
            snapshot.calls.targetParserDeclarationRows[row]
        let targetDecl = snapshot.calls.targetDeclIds[row]
        let resultTypedNodeId =
            snapshot.calls.resultTypedNodeIds[row]
        let resultValueDefinitionRow =
            snapshot.calls.resultValueDefinitionRows[row]
        let targetFunctionId =
            !csgCompilerIndexValid(
                callee, snapshot.symbols.functionIds.len) ? -1 :
                snapshot.symbols.functionIds[callee]
        let targetExternFunctionId =
            !csgCompilerIndexValid(
                callee, snapshot.symbols.externFunctionIds.len) ? -1 :
                snapshot.symbols.externFunctionIds[callee]
        var targetParserFunctionRow: int32 = -1
        if !csgCompilerIndexValid(reference, referenceCount) ||
           snapshot.references.referenceKinds[reference] !=
               CsgCompilerReferenceCall ||
           snapshot.references.bindingTypedNodeIds[reference] != -1 ||
           !csgCompilerIndexValid(caller, snapshot.functions.symbolIds.len) ||
           snapshot.references.ownerFunctionIds[reference] != caller ||
           snapshot.references.ownerSymbolIds[reference] !=
               snapshot.functions.symbolIds[caller] ||
           !csgCompilerIndexValid(callee, snapshot.symbols.symbolCids.len) ||
           snapshot.references.targetSymbolIds[reference] != callee:
            err = " csg compiler snapshot: call reference link mismatch"
            return false
        if targetCallDeclarationRow < 0:
            err = " csg compiler snapshot: call target callDeclaration row missing"
            return false
        if !csgCompilerIndexValid(
               targetSource, snapshot.sources.documentCids.len) ||
           snapshot.symbols.sourceIds[callee] != targetSource:
            err = " csg compiler snapshot: call target source mismatch"
            return false
        if !csgCompilerIndexValid(
               targetParserDeclaration,
               snapshot.parserSidecars.declarationKinds.len):
            err = " csg compiler snapshot: call target parser declaration missing"
            return false
        if snapshot.parserSidecars.declarationProducerSourceIds[
               targetParserDeclaration] != targetSource:
            err = " csg compiler snapshot: call target parser source mismatch"
            return false
        if snapshot.parserSidecars.declarationSourceLocalRows[
               targetParserDeclaration] != targetLocalDeclaration:
            err = " csg compiler snapshot: call target parser local row mismatch"
            return false
        if snapshot.parserSidecars.declarationKinds[
               targetParserDeclaration] !=
               CsgCompilerParserDeclarationFunction:
            err = " csg compiler snapshot: call target parser kind mismatch"
            return false
        if snapshot.parserSidecars.declarationNameTokenIds[
               targetParserDeclaration] !=
               snapshot.symbols.nameTokenIds[callee]:
            err = " csg compiler snapshot: call target name token mismatch"
            return false
        if snapshot.parserSidecars.declarationSpanIds[
               targetParserDeclaration] !=
               snapshot.symbols.declarationSpanIds[callee]:
            err = " csg compiler snapshot: call target declaration span mismatch"
            return false
        if (targetFunctionId >= 0) == (targetExternFunctionId >= 0):
            err = " csg compiler snapshot: call target function domain invalid"
            return false
        if targetFunctionId >= 0:
            if !csgCompilerParserFunctionRowForDeclarationInto(
                   snapshot,
                   targetParserDeclaration,
                   targetParserFunctionRow,
                   err):
                return false
            if !csgCompilerIndexValid(
                   targetFunctionId, snapshot.functions.bodySpanIds.len):
                err = " csg compiler snapshot: call target FunctionId missing"
                return false
            if snapshot.parserSidecars.functionBodySpanIds[
                   targetParserFunctionRow] !=
                   snapshot.functions.bodySpanIds[targetFunctionId]:
                err = " csg compiler snapshot: call target function body span mismatch"
                return false
        elif !csgCompilerIndexValid(
                 targetExternFunctionId,
                 snapshot.externFunctions.symbolIds.len) ||
             snapshot.externFunctions.symbolIds[
                 targetExternFunctionId] != callee ||
             snapshot.externFunctions.parserDeclarationRows[
                 targetExternFunctionId] != targetParserDeclaration ||
             snapshot.externFunctions.typeIds[
                 targetExternFunctionId] !=
                 snapshot.symbols.typeIds[callee] ||
             !layout.FixedBytes32Equal(
                 snapshot.externFunctions.interfaceCids[
                     targetExternFunctionId],
                 snapshot.symbols.interfaceCids[callee]):
            err = " csg compiler snapshot: call target ExternFunctionId mismatch"
            return false
        if !csgCompilerIndexValid(
               targetDecl, snapshot.declarations.declIds.len) ||
           snapshot.declarations.declIds[targetDecl] != targetDecl:
            err = " csg compiler snapshot: call target DeclId missing"
            return false
        if snapshot.declarations.declarationKinds[targetDecl] !=
               declaration.SemanticSnapshotDeclarationKindFunction:
            err = " csg compiler snapshot: call target DeclId kind mismatch"
            return false
        if snapshot.symbols.declIds[callee] != targetDecl:
            err = " csg compiler snapshot: call target Symbol DeclId mismatch"
            return false
        if !layout.FixedBytes32Equal(
               snapshot.calls.targetDeclKeyCids[row],
               snapshot.declarations.declKeyCids[targetDecl]):
            err = " csg compiler snapshot: call target declaration DeclKeyCid mismatch"
            return false
        if !layout.FixedBytes32Equal(
               snapshot.calls.targetDeclKeyCids[row],
               snapshot.symbols.declKeyCids[callee]):
            err = " csg compiler snapshot: call target Symbol DeclKeyCid mismatch"
            return false
        if !layout.FixedBytes32Equal(
               snapshot.calls.targetSymbolCids[row],
               snapshot.symbols.symbolCids[callee]):
            err = " csg compiler snapshot: call target SymbolCid mismatch"
            return false
        if !csgCompilerCidObserved(
               snapshot.calls.targetDeclKeyCids[row]) ||
           !csgCompilerCidObserved(
               snapshot.calls.targetSymbolCids[row]):
            err = " csg compiler snapshot: call target CID missing"
            return false
        if !csgCompilerIndexValid(
               resultTypedNodeId,
               snapshot.typedNodes.functionIds.len) ||
           !csgCompilerIndexValid(
               resultValueDefinitionRow,
               snapshot.valueDefinitions.functionIds.len) ||
           resultValueDefinitionRow >=
               snapshot.valueDefinitions.originKinds.len ||
           resultValueDefinitionRow >=
               snapshot.valueDefinitions.definingTypedNodeIds.len ||
           resultTypedNodeId >=
               snapshot.typedNodes.producedValueDefinitionRows.len ||
           snapshot.typedNodes.functionIds[resultTypedNodeId] != caller ||
           snapshot.typedNodes.spanIds[resultTypedNodeId] !=
               snapshot.references.spanIds[reference] ||
           snapshot.typedNodes.opKinds[resultTypedNodeId] !=
               CsgCompilerTypedOpCallExpr ||
           snapshot.typedNodes.typeIds[resultTypedNodeId] !=
               snapshot.calls.resultTypeIds[row] ||
           snapshot.typedNodes.ownershipKinds[resultTypedNodeId] !=
               snapshot.calls.resultOwnershipKinds[row] ||
           snapshot.typedNodes.ownershipProofKinds[
               resultTypedNodeId] !=
               snapshot.calls.resultOwnershipProofKinds[row] ||
           snapshot.typedNodes.producedValueDefinitionRows[
               resultTypedNodeId] != resultValueDefinitionRow ||
           snapshot.valueDefinitions.functionIds[
               resultValueDefinitionRow] != caller ||
           snapshot.valueDefinitions.definingTypedNodeIds[
               resultValueDefinitionRow] != resultTypedNodeId ||
           (snapshot.valueDefinitions.originKinds[
                resultValueDefinitionRow] !=
                CsgCompilerValueDefinitionOriginBindingInitializer &&
            snapshot.valueDefinitions.originKinds[
                resultValueDefinitionRow] !=
                CsgCompilerValueDefinitionOriginCallResult):
            err = " csg compiler snapshot: call result TypedNode mismatch"
            return false
        if !csgCompilerIndexValid(snapshot.calls.resultTypeIds[row],
                                  snapshot.types.typeCids.len) ||
           !csgCompilerOwnershipKindValid(
               snapshot.calls.resultOwnershipKinds[row]) ||
           !csgCompilerValueProofKindValid(
               snapshot.calls.resultOwnershipProofKinds[row]) ||
           !csgCompilerCidObserved(
               snapshot.calls.resultOwnershipProofCids[row]):
            err = " csg compiler snapshot: call result ownership proof missing"
            return false
        if row > 0 &&
           reference <= snapshot.calls.callReferenceIds[row - 1]:
            err = " csg compiler snapshot: call rows are not canonical"
            return false
        var expectedOwnershipProofCid: layout.FixedBytes32
        if !CsgCompilerCallResultOwnershipProofCidInto(
               snapshot, row, expectedOwnershipProofCid, err) ||
           !layout.FixedBytes32Equal(
               expectedOwnershipProofCid,
               snapshot.calls.resultOwnershipProofCids[row]):
            if err == "":
                err = " csg compiler snapshot: call result ownership proof CID mismatch"
            return false
    return true

@borrows
fn CsgCompilerLayoutRowCidInto(
        snapshot: CsgCompilerSnapshotTables,
        layoutId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    let count = snapshot.layouts.layoutCids.len
    if !csgCompilerIndexValid(layoutId, count) ||
       layoutId >= snapshot.layouts.typeIds.len ||
       layoutId >= snapshot.layouts.sizeBytes.len ||
       layoutId >= snapshot.layouts.alignBytes.len ||
       layoutId >= snapshot.layouts.fieldStarts.len ||
       layoutId >= snapshot.layouts.fieldCounts.len:
        err = " csg compiler snapshot: layout CID row out of range"
        return false
    let typeId = snapshot.layouts.typeIds[layoutId]
    let size = snapshot.layouts.sizeBytes[layoutId]
    let align = snapshot.layouts.alignBytes[layoutId]
    let fieldStart = snapshot.layouts.fieldStarts[layoutId]
    let rowFieldCount = snapshot.layouts.fieldCounts[layoutId]
    let fieldCount = snapshot.layoutFields.layoutIds.len
    if snapshot.layoutFields.fieldSymbolIds.len != fieldCount ||
       snapshot.layoutFields.typeIds.len != fieldCount ||
       snapshot.layoutFields.offsetBytes.len != fieldCount ||
       snapshot.layoutFields.sizeBytes.len != fieldCount ||
       snapshot.layoutFields.alignBytes.len != fieldCount ||
       !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) ||
       !csgCompilerCidObserved(snapshot.types.typeCids[typeId]) ||
       size < 0 || !csgCompilerPowerOfTwo(align) ||
       size % align != 0 || fieldStart < 0 || rowFieldCount < 0 ||
       fieldStart > fieldCount || rowFieldCount > fieldCount - fieldStart:
        err = " csg compiler snapshot: invalid layout CID preimage"
        return false
    # RefObject layout rows carry the 8/8 pointer-handle extent (wall47
    # exact-layout verdict) while their field rows live in pointee-offset
    # space (backend handle-deref addressing).  The row-size containment
    # conditions below therefore only apply to non-ref rows; ref rows are
    # domain-checked by the remaining alignment/order/join conditions.
    let refObjectLayout =
        typeId < snapshot.types.typeKinds.len &&
        snapshot.types.typeKinds[typeId] == CsgCompilerTypeRefObject
    var buf = layout.ByteBufInit(256)
    csgCompilerTypeCidAppendText(buf, "cheng.csg_compiler.layout")
    layout.ByteBufAppendFixed32(buf, snapshot.types.typeCids[typeId])
    csgCompilerTypeCidAppendU32(buf, size)
    csgCompilerTypeCidAppendU32(buf, align)
    csgCompilerTypeCidAppendU32(buf, rowFieldCount)
    for fieldOffset in 0..<rowFieldCount:
        let fieldRow = fieldStart + fieldOffset
        let fieldSymbolId =
            snapshot.layoutFields.fieldSymbolIds[fieldRow]
        let fieldTypeId = snapshot.layoutFields.typeIds[fieldRow]
        let offset = snapshot.layoutFields.offsetBytes[fieldRow]
        let fieldSize = snapshot.layoutFields.sizeBytes[fieldRow]
        let fieldAlign = snapshot.layoutFields.alignBytes[fieldRow]
        if snapshot.layoutFields.layoutIds[fieldRow] != layoutId ||
           !csgCompilerIndexValid(
               fieldSymbolId, snapshot.symbols.symbolCids.len) ||
           fieldSymbolId >= snapshot.symbols.symbolKinds.len ||
           fieldSymbolId >= snapshot.symbols.typeIds.len ||
           snapshot.symbols.symbolKinds[fieldSymbolId] !=
               CsgCompilerSymbolField ||
           !csgCompilerCidObserved(
               snapshot.symbols.symbolCids[fieldSymbolId]) ||
           !csgCompilerIndexValid(
               fieldTypeId, snapshot.types.typeCids.len) ||
           !csgCompilerCidObserved(snapshot.types.typeCids[fieldTypeId]) ||
           snapshot.symbols.typeIds[fieldSymbolId] != fieldTypeId ||
           offset < 0 ||
           (!refObjectLayout && offset > size) || fieldSize < 0 ||
           (!refObjectLayout && fieldSize > size - offset) ||
           !csgCompilerPowerOfTwo(fieldAlign) || fieldAlign > align ||
           offset % fieldAlign != 0 ||
           (fieldOffset > 0 &&
            offset < snapshot.layoutFields.offsetBytes[fieldRow - 1] +
                         snapshot.layoutFields.sizeBytes[fieldRow - 1]):
            layout.ByteBufFree(buf)
            var symbolKindForErr: int32 = -1
            var symbolTypeIdForErr: int32 = -1
            var symbolCidObservedForErr: int32
            var fieldTypeCidObservedForErr: int32
            if csgCompilerIndexValid(
                   fieldSymbolId, snapshot.symbols.symbolCids.len) &&
               fieldSymbolId < snapshot.symbols.symbolKinds.len &&
               fieldSymbolId < snapshot.symbols.typeIds.len:
                symbolKindForErr =
                    snapshot.symbols.symbolKinds[fieldSymbolId]
                symbolTypeIdForErr =
                    snapshot.symbols.typeIds[fieldSymbolId]
                symbolCidObservedForErr =
                    csgCompilerCidObserved(
                        snapshot.symbols.symbolCids[fieldSymbolId]) ?
                    1 : 0
            if csgCompilerIndexValid(fieldTypeId,
                                     snapshot.types.typeCids.len):
                fieldTypeCidObservedForErr =
                    csgCompilerCidObserved(
                        snapshot.types.typeCids[fieldTypeId]) ? 1 : 0
            err = Fmt" csg compiler snapshot: invalid layout field CID preimage layout_id={layoutId} type_id={typeId} type_kind={snapshot.types.typeKinds[typeId]} ref_object_layout={refObjectLayout ? 1 : 0} row_size={size} row_align={align} row_field_count={rowFieldCount} field_ordinal={fieldOffset} field_row={fieldRow} field_symbol_id={fieldSymbolId} field_type_id={fieldTypeId} field_offset={offset} field_size={fieldSize} field_align={fieldAlign} field_layout_id={snapshot.layoutFields.layoutIds[fieldRow]} symbol_kind={symbolKindForErr} symbol_type_id={symbolTypeIdForErr} symbol_cid_observed={symbolCidObservedForErr} field_type_cid_observed={fieldTypeCidObservedForErr}"
            return false
        layout.ByteBufAppendFixed32(
            buf, snapshot.symbols.symbolCids[fieldSymbolId])
        layout.ByteBufAppendFixed32(
            buf, snapshot.types.typeCids[fieldTypeId])
        csgCompilerTypeCidAppendU32(buf, offset)
        csgCompilerTypeCidAppendU32(buf, fieldSize)
        csgCompilerTypeCidAppendU32(buf, fieldAlign)
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn csgCompilerLayoutsValidateInto(snapshot: CsgCompilerSnapshotTables,
                                  err: var str): bool =
    let count = snapshot.layouts.layoutCids.len
    if count != snapshot.layouts.typeIds.len ||
       count != snapshot.layouts.sizeBytes.len ||
       count != snapshot.layouts.alignBytes.len ||
       count != snapshot.layouts.fieldStarts.len ||
       count != snapshot.layouts.fieldCounts.len:
        err = " csg compiler snapshot: layout columns mismatch"
        return false
    let fieldCount = snapshot.layoutFields.layoutIds.len
    if fieldCount != snapshot.layoutFields.fieldSymbolIds.len ||
       fieldCount != snapshot.layoutFields.typeIds.len ||
       fieldCount != snapshot.layoutFields.offsetBytes.len ||
       fieldCount != snapshot.layoutFields.sizeBytes.len ||
       fieldCount != snapshot.layoutFields.alignBytes.len:
        err = " csg compiler snapshot: layout field columns mismatch"
        return false
    var fieldCursor: int32
    var layoutSeenByType: bool[]
    setLen(layoutSeenByType, snapshot.types.typeCids.len)
    for row in 0..<count:
        let layoutTypeId = snapshot.layouts.typeIds[row]
        let size = snapshot.layouts.sizeBytes[row]
        let align = snapshot.layouts.alignBytes[row]
        let rowFieldCount = snapshot.layouts.fieldCounts[row]
        if !csgCompilerCidObserved(snapshot.layouts.layoutCids[row]) ||
           !csgCompilerIndexValid(snapshot.layouts.typeIds[row],
                                  snapshot.types.typeCids.len) ||
           size < 0 || !csgCompilerPowerOfTwo(align) ||
           size % align != 0 ||
           snapshot.layouts.fieldStarts[row] != fieldCursor ||
           rowFieldCount < 0 || fieldCursor > fieldCount ||
           rowFieldCount > fieldCount - fieldCursor ||
           (row > 0 && snapshot.layouts.typeIds[row] <=
                       snapshot.layouts.typeIds[row - 1]):
            err = " csg compiler snapshot: invalid layout row"
            return false
        layoutSeenByType[layoutTypeId] = true
        let layoutTypeKind =
            snapshot.types.typeKinds[layoutTypeId]
        let nominalLayout =
            layoutTypeKind == CsgCompilerTypeObject ||
            layoutTypeKind == CsgCompilerTypeRefObject
        let refObjectRow = layoutTypeKind == CsgCompilerTypeRefObject
        let declaringSymbol =
            nominalLayout ?
                snapshot.types.declSymbolIds[layoutTypeId] : -1
        var expectedFieldCount: int32
        if nominalLayout:
            if !csgCompilerIndexValid(
                   declaringSymbol, snapshot.symbols.symbolKinds.len) ||
               (snapshot.symbols.symbolKinds[declaringSymbol] !=
                    CsgCompilerSymbolType &&
                snapshot.symbols.symbolKinds[declaringSymbol] !=
                    CsgCompilerSymbolField):
                err = " csg compiler snapshot: layout declaring Symbol join invalid"
                return false
            for symbolId in 0..<snapshot.symbols.symbolKinds.len:
                if snapshot.symbols.symbolKinds[symbolId] ==
                       CsgCompilerSymbolField &&
                   snapshot.symbols.ownerSymbolIds[symbolId] ==
                       declaringSymbol:
                    expectedFieldCount = expectedFieldCount + 1
            if expectedFieldCount != rowFieldCount ||
               snapshot.types.argCounts[layoutTypeId] !=
                   rowFieldCount:
                err = " csg compiler snapshot: layout declaring Field coverage mismatch"
                return false
        for fieldOffset in 0..<rowFieldCount:
            let fieldRow = fieldCursor + fieldOffset
            let fieldSymbol = snapshot.layoutFields.fieldSymbolIds[fieldRow]
            let offset = snapshot.layoutFields.offsetBytes[fieldRow]
            let fieldSize = snapshot.layoutFields.sizeBytes[fieldRow]
            let fieldAlign = snapshot.layoutFields.alignBytes[fieldRow]
            if snapshot.layoutFields.layoutIds[fieldRow] != row ||
               !csgCompilerIndexValid(fieldSymbol,
                                       snapshot.symbols.symbolCids.len) ||
               snapshot.symbols.symbolKinds[fieldSymbol] !=
                   CsgCompilerSymbolField ||
               (nominalLayout &&
                snapshot.symbols.ownerSymbolIds[fieldSymbol] !=
                    declaringSymbol) ||
               !csgCompilerIndexValid(snapshot.layoutFields.typeIds[fieldRow],
                                       snapshot.types.typeCids.len) ||
               snapshot.symbols.typeIds[fieldSymbol] !=
                   snapshot.layoutFields.typeIds[fieldRow] ||
               (nominalLayout &&
                (snapshot.types.argTypeIds[
                     snapshot.types.argStarts[layoutTypeId] +
                         fieldOffset] !=
                     snapshot.layoutFields.typeIds[fieldRow] ||
                 snapshot.types.argNameTextIds[
                     snapshot.types.argStarts[layoutTypeId] +
                         fieldOffset] !=
                     snapshot.symbols.nameTextIds[fieldSymbol])) ||
               offset < 0 ||
               (!refObjectRow && offset > size) || fieldSize < 0 ||
               (!refObjectRow && fieldSize > size - offset) ||
               !csgCompilerPowerOfTwo(fieldAlign) || fieldAlign > align ||
               offset % fieldAlign != 0 ||
               (fieldOffset > 0 &&
                offset < snapshot.layoutFields.offsetBytes[fieldRow - 1] +
                             snapshot.layoutFields.sizeBytes[fieldRow - 1]):
                var symbolReadableForErr: bool
                var symbolKindForErr: int32 = -1
                var symbolTypeIdForErr: int32 = -1
                if csgCompilerIndexValid(
                       fieldSymbol, snapshot.symbols.symbolCids.len) &&
                   fieldSymbol < snapshot.symbols.symbolKinds.len &&
                   fieldSymbol < snapshot.symbols.typeIds.len:
                    symbolReadableForErr = true
                    symbolKindForErr =
                        snapshot.symbols.symbolKinds[fieldSymbol]
                    symbolTypeIdForErr =
                        snapshot.symbols.typeIds[fieldSymbol]
                err = Fmt" csg compiler snapshot: invalid layout field row layout_row={row} type_id={layoutTypeId} type_kind={layoutTypeKind} ref_object_row={refObjectRow ? 1 : 0} row_size={size} row_align={align} field_ordinal={fieldOffset} field_row={fieldRow} field_symbol={fieldSymbol} symbol_readable={symbolReadableForErr ? 1 : 0} symbol_kind={symbolKindForErr} symbol_type_id={symbolTypeIdForErr} field_type_id={snapshot.layoutFields.typeIds[fieldRow]} field_offset={offset} field_size={fieldSize} field_align={fieldAlign}"
                return false
        fieldCursor = fieldCursor + rowFieldCount
        var expectedLayoutCid: layout.FixedBytes32
        if !CsgCompilerLayoutRowCidInto(
               snapshot, row, expectedLayoutCid, err) ||
           !layout.FixedBytes32Equal(
               expectedLayoutCid, snapshot.layouts.layoutCids[row]):
            if err == "":
                err = " csg compiler snapshot: layout CID mismatch"
            return false
    if fieldCursor != fieldCount:
        err = " csg compiler snapshot: layout field coverage mismatch"
        return false
    for typeId in 0..<snapshot.types.typeKinds.len:
        if (snapshot.types.typeKinds[typeId] ==
                CsgCompilerTypeObject ||
            snapshot.types.typeKinds[typeId] ==
                CsgCompilerTypeRefObject) &&
           !layoutSeenByType[typeId]:
            err = " csg compiler snapshot: nominal layout missing"
            return false
    return true

@borrows
fn CsgCompilerSnapshotLayoutsStrictValidateInto(
        snapshot: var CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if !csgCompilerLayoutsValidateInto(snapshot, err):
        if err == "":
            err = " csg compiler snapshot: invalid layout envelope"
        return false
    err = ""
    return true

@borrows
fn csgCompilerFunctionFragmentColumnsAligned(
        snapshot: CsgCompilerSnapshotTables): bool =
    let functionCount = snapshot.functions.symbolIds.len
    let nodeCount = snapshot.typedNodes.functionIds.len
    let statementCount =
        snapshot.typedStatements.typedIrStatementIndexes.len
    let parserNodeCount = snapshot.parserNodes.sourceIds.len
    let spanCount = snapshot.spans.sourceIds.len
    return functionCount == snapshot.functions.bodySpanIds.len &&
        functionCount == snapshot.functions.bodyContentCids.len &&
        functionCount == snapshot.functions.fragmentCids.len &&
        functionCount == snapshot.functions.interfaceCids.len &&
        functionCount ==
            snapshot.functions.resultOwnershipKinds.len &&
        functionCount ==
            snapshot.functions.parameterOwnershipStarts.len &&
        functionCount ==
            snapshot.functions.parameterOwnershipCounts.len &&
        functionCount ==
            snapshot.functions.valueDefinitionStarts.len &&
        functionCount ==
            snapshot.functions.valueDefinitionCounts.len &&
        functionCount ==
            snapshot.functions.valueDefinitionGroupStarts.len &&
        functionCount ==
            snapshot.functions.valueDefinitionGroupCounts.len &&
        functionCount == snapshot.functions.nodeStarts.len &&
        functionCount == snapshot.functions.nodeCounts.len &&
        statementCount == snapshot.typedStatements.functionIds.len &&
        statementCount == snapshot.typedStatements.rootStarts.len &&
        statementCount == snapshot.typedStatements.rootCounts.len &&
        nodeCount == snapshot.typedNodes.typedIrNodeIndexes.len &&
        nodeCount ==
            snapshot.typedNodes.bindingProducerSourceIndexes.len &&
        nodeCount ==
            snapshot.typedNodes.bindingParserSourceLocalNodeRows.len &&
        nodeCount ==
            snapshot.typedNodes.bindingDeclarationSourceLocalRows.len &&
        nodeCount ==
            snapshot.typedNodes.bindingPatternSourceLocalRows.len &&
        nodeCount ==
            snapshot.typedNodes.bindingValueDefinitionRows.len &&
        nodeCount ==
            snapshot.typedNodes.producedValueDefinitionRows.len &&
        nodeCount == snapshot.typedNodes.ownerStatementIds.len &&
        nodeCount == snapshot.typedNodes.originParserNodeIds.len &&
        nodeCount == snapshot.typedNodes.syntheticOriginKinds.len &&
        nodeCount == snapshot.typedNodes.spanAuthorityKinds.len &&
        nodeCount == snapshot.typedNodes.opKinds.len &&
        nodeCount == snapshot.typedNodes.typeIds.len &&
        nodeCount == snapshot.typedNodes.valueKinds.len &&
        nodeCount == snapshot.typedNodes.captureStarts.len &&
        nodeCount == snapshot.typedNodes.captureCounts.len &&
        nodeCount == snapshot.typedNodes.ownershipKinds.len &&
        nodeCount == snapshot.typedNodes.ownershipProofKinds.len &&
        nodeCount == snapshot.typedNodes.ownershipProofCids.len &&
        nodeCount == snapshot.typedNodes.sendConclusions.len &&
        nodeCount == snapshot.typedNodes.sendProofKinds.len &&
        nodeCount == snapshot.typedNodes.sendProofCids.len &&
        nodeCount == snapshot.typedNodes.syncConclusions.len &&
        nodeCount == snapshot.typedNodes.syncProofKinds.len &&
        nodeCount == snapshot.typedNodes.syncProofCids.len &&
        nodeCount == snapshot.typedNodes.shareKinds.len &&
        nodeCount == snapshot.typedNodes.shareProofCids.len &&
        nodeCount == snapshot.typedNodes.spanIds.len &&
        nodeCount == snapshot.typedNodes.operand0NodeIds.len &&
        nodeCount == snapshot.typedNodes.operand1NodeIds.len &&
        nodeCount == snapshot.typedNodes.operand2NodeIds.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.originKinds.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.groupRows.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.sourceLocalNodeIndexes.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.declarationSourceLocalRows.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.patternSourceLocalRows.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.functionIds.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.definingTypedNodeIds.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.typeIds.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.ownershipKinds.len &&
        snapshot.valueDefinitions.producerSourceIndexes.len ==
            snapshot.valueDefinitions.proofKinds.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.parserProducerSourceIndexes.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.bindingOffsets.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.bindingCounts.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.functionIds.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.declarationSourceLocalRows.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.patternSourceLocalRows.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.definitionRows.len &&
        snapshot.valueDefinitionGroups.producerSourceIndexes.len ==
            snapshot.valueDefinitionGroups.consumedFlags.len &&
        snapshot.typedNodes.captureValueDefinitionRows.len ==
            snapshot.typedNodes.captureTypeIds.len &&
        snapshot.typedNodes.captureValueDefinitionRows.len ==
            snapshot.typedNodes.captureOwnershipKinds.len &&
        parserNodeCount == snapshot.parserNodes.parentNodeIds.len &&
        parserNodeCount == snapshot.parserNodes.kinds.len &&
        parserNodeCount == snapshot.parserNodes.spanIds.len &&
        parserNodeCount == snapshot.parserNodes.childStarts.len &&
        parserNodeCount == snapshot.parserNodes.childCounts.len &&
        parserNodeCount ==
            snapshot.parserNodes.bindingResolutionKinds.len &&
        parserNodeCount ==
            snapshot.parserNodes.bindingDeclarationSourceLocalRows.len &&
        parserNodeCount ==
            snapshot.parserNodes.bindingPatternSourceLocalRows.len &&
        spanCount == snapshot.spans.startBytes.len &&
        spanCount == snapshot.spans.endBytes.len &&
        snapshot.parserSidecars.statementRootNodeIds.len ==
            snapshot.parserSidecars.statementRootRoles.len &&
        snapshot.parserSidecars.statementRootNodeIds.len ==
            snapshot.parserSidecars.statementRootAnchorTokenIds.len &&
        snapshot.parserSidecars.statementRootNodeIds.len ==
            snapshot.parserSidecars.statementRootBindingDeclarationStarts.len &&
        snapshot.parserSidecars.statementRootNodeIds.len ==
            snapshot.parserSidecars.statementRootBindingDeclarationCounts.len

@borrows
fn csgCompilerFunctionOriginReceiptsBuild(
        snapshot: CsgCompilerSnapshotTables):
        CsgCompilerFunctionOriginReceiptTable =
    var out: CsgCompilerFunctionOriginReceiptTable
    let parserNodeCount = snapshot.parserNodes.sourceIds.len
    let functionCount = snapshot.functions.symbolIds.len
    var functionByBodySpan: int32[]
    setLen(functionByBodySpan, snapshot.spans.sourceIds.len)
    for spanId in 0..<functionByBodySpan.len:
        functionByBodySpan[spanId] = -1
    for functionId in 0..<functionCount:
        let bodySpanId = snapshot.functions.bodySpanIds[functionId]
        if !csgCompilerIndexValid(
               bodySpanId, functionByBodySpan.len) ||
           functionByBodySpan[bodySpanId] >= 0:
            out.error = " csg compiler snapshot: fragment body span identity invalid"
            return out
        functionByBodySpan[bodySpanId] = functionId
    if snapshot.parserSidecars.functionBodySpanIds.len != functionCount ||
       snapshot.parserSidecars.functionIndexes.len != functionCount ||
       snapshot.parserSidecars.functionDeclarationSpanIds.len !=
           functionCount:
        out.error = " csg compiler snapshot: fragment parser function coverage missing"
        return out
    var parserFunctionSeen: int32[]
    setLen(parserFunctionSeen, functionCount)
    var functionByParserRow: int32[]
    setLen(functionByParserRow, functionCount)
    var parserRowByReachable: int32[]
    setLen(parserRowByReachable, functionCount)
    for parserFunctionRow in 0..<functionCount:
        functionByParserRow[parserFunctionRow] = -1
        parserRowByReachable[parserFunctionRow] = -1
    for parserFunctionRow in 0..<functionCount:
        let bodySpanId =
            snapshot.parserSidecars.functionBodySpanIds[parserFunctionRow]
        if !csgCompilerIndexValid(bodySpanId, functionByBodySpan.len):
            out.error = " csg compiler snapshot: fragment parser body span invalid"
            return out
        let functionId = functionByBodySpan[bodySpanId]
        let reachableRow =
            snapshot.parserSidecars.functionIndexes[parserFunctionRow]
        if functionId < 0 || parserFunctionSeen[functionId] != 0 ||
           !csgCompilerIndexValid(reachableRow, functionCount) ||
           parserRowByReachable[reachableRow] >= 0:
            out.error = " csg compiler snapshot: fragment parser/function join invalid"
            return out
        parserFunctionSeen[functionId] = 1
        functionByParserRow[parserFunctionRow] = functionId
        parserRowByReachable[reachableRow] = parserFunctionRow
    var childOrdinals: int32[]
    var statementRootRows: int32[]
    var statementFunctionIds: int32[]
    var statementOrdinals: int32[]
    setLen(childOrdinals, parserNodeCount)
    setLen(statementRootRows, parserNodeCount)
    let statementCount =
        snapshot.parserSidecars.statementRootNodeIds.len
    setLen(statementFunctionIds, statementCount)
    setLen(statementOrdinals, statementCount)
    for nodeId in 0..<parserNodeCount:
        childOrdinals[nodeId] = -1
        statementRootRows[nodeId] = -1
    for statementRow in 0..<statementCount:
        statementFunctionIds[statementRow] = -1
        statementOrdinals[statementRow] = -1
    for parentId in 0..<parserNodeCount:
        let childStart = snapshot.parserNodes.childStarts[parentId]
        let childCount = snapshot.parserNodes.childCounts[parentId]
        if childStart < 0 || childCount < 0 ||
           childStart > snapshot.parserNodes.childNodeIds.len ||
           childCount >
               snapshot.parserNodes.childNodeIds.len - childStart:
            out.error = " csg compiler snapshot: fragment child CSR invalid"
            return out
        for childOffset in 0..<childCount:
            let childId =
                snapshot.parserNodes.childNodeIds[childStart + childOffset]
            if !csgCompilerIndexValid(childId, parserNodeCount) ||
               childOrdinals[childId] >= 0:
                out.error = " csg compiler snapshot: fragment child path invalid"
                return out
            childOrdinals[childId] = childOffset
    var functionStatementCounts: int32[]
    setLen(functionStatementCounts, functionCount)
    let declarationDomainCount =
        snapshot.parserSidecars.declarationFunctionRows.len
    if declarationDomainCount !=
           snapshot.parserSidecars.declarationKinds.len ||
       declarationDomainCount !=
           snapshot.parserSidecars.declarationOwnerIds.len ||
       declarationDomainCount !=
           snapshot.parserSidecars.declarationDefaultStatementRootRows.len:
        out.error = " csg compiler snapshot: fragment declaration columns invalid"
        return out
    let normalizedCount =
        snapshot.parserSidecars.normalizedExprParserNodeIds.len
    if normalizedCount !=
           snapshot.parserSidecars.normalizedExprFunctionIndexes.len ||
       normalizedCount !=
           snapshot.parserSidecars.normalizedExprStatementRoles.len:
        out.error = " csg compiler snapshot: fragment normalized identity columns invalid"
        return out
    var normalizedStatementFunctionIds: int32[]
    var normalizedStatementRoles: int32[]
    setLen(normalizedStatementFunctionIds, parserNodeCount)
    setLen(normalizedStatementRoles, parserNodeCount)
    for nodeId in 0..<parserNodeCount:
        normalizedStatementFunctionIds[nodeId] = -1
        normalizedStatementRoles[nodeId] = -1
    for normalizedRow in 0..<normalizedCount:
        let statementRole =
            snapshot.parserSidecars.normalizedExprStatementRoles[
                normalizedRow]
        if statementRole <= 0:
            continue
        let parserNodeId =
            snapshot.parserSidecars.normalizedExprParserNodeIds[
                normalizedRow]
        let reachableRow =
            snapshot.parserSidecars.normalizedExprFunctionIndexes[
                normalizedRow]
        if !csgCompilerIndexValid(parserNodeId, parserNodeCount) ||
           !csgCompilerIndexValid(reachableRow, parserRowByReachable.len):
            out.error = " csg compiler snapshot: fragment normalized statement identity invalid"
            return out
        let parserFunctionRow = parserRowByReachable[reachableRow]
        if parserFunctionRow < 0:
            out.error = " csg compiler snapshot: fragment normalized function identity missing"
            return out
        let functionId = functionByParserRow[parserFunctionRow]
        if functionId < 0 ||
           (normalizedStatementFunctionIds[parserNodeId] >= 0 &&
            (normalizedStatementFunctionIds[parserNodeId] != functionId ||
             normalizedStatementRoles[parserNodeId] != statementRole)):
            out.error = " csg compiler snapshot: fragment normalized statement authority split"
            return out
        normalizedStatementFunctionIds[parserNodeId] = functionId
        normalizedStatementRoles[parserNodeId] = statementRole
    for statementRow in 0..<snapshot.parserSidecars.statementRootNodeIds.len:
        let rootNodeId =
            snapshot.parserSidecars.statementRootNodeIds[statementRow]
        if !csgCompilerIndexValid(rootNodeId, parserNodeCount) ||
           statementRootRows[rootNodeId] >= 0:
            out.error = " csg compiler snapshot: fragment statement root invalid"
            return out
        let rootSpanId = snapshot.parserNodes.spanIds[rootNodeId]
        if !csgCompilerIndexValid(rootSpanId, snapshot.spans.sourceIds.len):
            out.error = " csg compiler snapshot: fragment statement span invalid"
            return out
        let rootSourceId = snapshot.spans.sourceIds[rootSpanId]
        let rootStart = snapshot.spans.startBytes[rootSpanId]
        let rootEnd = snapshot.spans.endBytes[rootSpanId]
        let statementRole =
            snapshot.parserSidecars.statementRootRoles[statementRow]
        let anchorTokenId =
            snapshot.parserSidecars.statementRootAnchorTokenIds[
                statementRow]
        if !csgCompilerIndexValid(
               anchorTokenId, snapshot.tokens.kinds.len):
            out.error = " csg compiler snapshot: fragment statement anchor invalid"
            return out
        let declarationStart =
            snapshot.parserSidecars.statementRootBindingDeclarationStarts[
                statementRow]
        let declarationCount =
            snapshot.parserSidecars.statementRootBindingDeclarationCounts[
                statementRow]
        var statementFunctionId: int32 = -1
        if declarationStart == -1 && declarationCount == 0:
            if normalizedStatementRoles[rootNodeId] >= 0 &&
               normalizedStatementRoles[rootNodeId] != statementRole:
                out.error = " csg compiler snapshot: fragment statement/normalized role split"
                return out
            statementFunctionId =
                normalizedStatementFunctionIds[rootNodeId]
        else:
            let declarationAuthorityRole =
                statementRole ==
                    CsgCompilerParserStatementBindingInitializer ||
                statementRole ==
                    CsgCompilerParserStatementParameterDefault ||
                statementRole == CsgCompilerParserStatementTypeDefault
            if !declarationAuthorityRole || declarationStart < 0 ||
               declarationCount <= 0 ||
               declarationStart >
                   snapshot.parserSidecars.declarationFunctionRows.len ||
               declarationCount >
                   snapshot.parserSidecars.declarationFunctionRows.len -
                       declarationStart:
                out.error = " csg compiler snapshot: fragment statement declaration authority invalid"
                return out
            let authorityParserFunctionRow =
                snapshot.parserSidecars.declarationFunctionRows[
                    declarationStart]
            for declarationOffset in 0..<declarationCount:
                let declarationRow = declarationStart + declarationOffset
                let declarationFunctionRow =
                    snapshot.parserSidecars.declarationFunctionRows[
                        declarationRow]
                let declarationKind =
                    snapshot.parserSidecars.declarationKinds[
                        declarationRow]
                let declarationOwner =
                    snapshot.parserSidecars.declarationOwnerIds[
                        declarationRow]
                let bindingDeclaration =
                    statementRole ==
                        CsgCompilerParserStatementBindingInitializer &&
                    declarationKind == CsgCompilerParserDeclarationLocal
                let typeDefaultDeclaration =
                    statementRole ==
                        CsgCompilerParserStatementTypeDefault &&
                    (declarationKind == CsgCompilerParserDeclarationType ||
                     declarationKind ==
                         CsgCompilerParserDeclarationField) &&
                    declarationFunctionRow == -1
                let parameterDefaultDeclaration =
                    statementRole ==
                        CsgCompilerParserStatementParameterDefault &&
                    snapshot.tokens.kinds[anchorTokenId] ==
                        CsgCompilerTokenAssign &&
                    declarationCount == 1 &&
                    declarationKind ==
                        CsgCompilerParserDeclarationParameter &&
                    snapshot.parserSidecars.declarationDefaultStatementRootRows[
                        declarationRow] == statementRow &&
                    declarationOwner >= 0 &&
                    declarationOwner <
                        snapshot.parserSidecars.declarationKinds.len &&
                    snapshot.parserSidecars.declarationKinds[
                        declarationOwner] ==
                        CsgCompilerParserDeclarationFunction &&
                    snapshot.parserSidecars.declarationFunctionRows[
                        declarationOwner] == declarationFunctionRow
                if declarationFunctionRow < -1 ||
                   declarationFunctionRow >= functionByParserRow.len ||
                   (!bindingDeclaration && !typeDefaultDeclaration &&
                    !parameterDefaultDeclaration) ||
                   authorityParserFunctionRow != declarationFunctionRow:
                    out.error = " csg compiler snapshot: fragment statement declaration/function split"
                    return out
            if authorityParserFunctionRow >= 0:
                statementFunctionId =
                    functionByParserRow[authorityParserFunctionRow]
                if statementFunctionId < 0:
                    out.error = " csg compiler snapshot: fragment statement function identity missing"
                    return out
                let authoritySpanId =
                    statementRole ==
                        CsgCompilerParserStatementParameterDefault ?
                        snapshot.parserSidecars.functionDeclarationSpanIds[
                            authorityParserFunctionRow] :
                        snapshot.functions.bodySpanIds[statementFunctionId]
                if !csgCompilerIndexValid(
                       authoritySpanId, snapshot.spans.sourceIds.len) ||
                   !csgCompilerIndexValid(
                       anchorTokenId, snapshot.tokens.spanIds.len):
                    out.error = " csg compiler snapshot: fragment statement authority span missing"
                    return out
                let anchorSpanId = snapshot.tokens.spanIds[anchorTokenId]
                if !csgCompilerIndexValid(
                       anchorSpanId, snapshot.spans.sourceIds.len) ||
                   snapshot.spans.sourceIds[authoritySpanId] != rootSourceId ||
                   snapshot.spans.startBytes[authoritySpanId] > rootStart ||
                   rootEnd > snapshot.spans.endBytes[authoritySpanId] ||
                   snapshot.spans.sourceIds[anchorSpanId] != rootSourceId ||
                   snapshot.spans.startBytes[anchorSpanId] <
                       snapshot.spans.startBytes[authoritySpanId] ||
                   snapshot.spans.endBytes[anchorSpanId] >
                       snapshot.spans.endBytes[authoritySpanId]:
                    out.error = " csg compiler snapshot: fragment statement declaration span split"
                    return out
            elif statementRole ==
                     CsgCompilerParserStatementParameterDefault:
                out.error = " csg compiler snapshot: fragment parameter default function missing"
                return out
        let normalizedFunctionId =
            normalizedStatementFunctionIds[rootNodeId]
        let normalizedRole = normalizedStatementRoles[rootNodeId]
        if normalizedRole >= 0 &&
           (normalizedRole != statementRole ||
            normalizedFunctionId != statementFunctionId):
            out.error = " csg compiler snapshot: fragment statement immutable authority split"
            return out
        if statementFunctionId >= 0:
            statementFunctionIds[statementRow] = statementFunctionId
            statementOrdinals[statementRow] =
                functionStatementCounts[statementFunctionId]
            functionStatementCounts[statementFunctionId] =
                functionStatementCounts[statementFunctionId] + 1
        elif statementRole ==
                 CsgCompilerParserStatementBindingInitializer &&
             declarationStart >= 0 &&
             declarationStart <
                 snapshot.parserSidecars.declarationFunctionRows.len &&
             snapshot.parserSidecars.declarationFunctionRows[
                 declarationStart] >= 0:
            out.error = " csg compiler snapshot: fragment binding initializer authority missing"
            return out
        elif statementRole ==
                 CsgCompilerParserStatementParameterDefault:
            out.error = " csg compiler snapshot: fragment parameter default authority missing"
            return out
        statementRootRows[rootNodeId] = statementRow
    for nodeId in 0..<parserNodeCount:
        add(out.cids, layout.FixedBytes32())
        add(out.functionIds, -1)
        let statementRow = statementRootRows[nodeId]
        if statementRow >= 0 &&
           statementFunctionIds[statementRow] >= 0:
            var buf = layout.ByteBufInit(128)
            csgCompilerTypeCidAppendText(
                buf, "cheng.csg_compiler.function_origin_root")
            csgCompilerTypeCidAppendU32(
                buf, statementOrdinals[statementRow])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.parserSidecars.statementRootRoles[
                    statementRow])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.parserNodes.kinds[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.parserNodes.bindingResolutionKinds[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.parserNodes.bindingDeclarationSourceLocalRows[
                    nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.parserNodes.bindingPatternSourceLocalRows[
                    nodeId])
            out.cids[nodeId] =
                hash256.Sha256Fixed(layout.ByteBufView(buf))
            out.functionIds[nodeId] =
                statementFunctionIds[statementRow]
            layout.ByteBufFree(buf)
            continue
        let parentId = snapshot.parserNodes.parentNodeIds[nodeId]
        if parentId == -1:
            continue
        if !csgCompilerIndexValid(parentId, nodeId) ||
           !csgCompilerCidObserved(out.cids[parentId]):
            if parentId < 0 || parentId >= nodeId:
                out.error = " csg compiler snapshot: fragment origin parent invalid"
                return out
            continue
        if childOrdinals[nodeId] < 0:
            out.error = " csg compiler snapshot: fragment origin child path missing"
            return out
        var buf = layout.ByteBufInit(128)
        csgCompilerTypeCidAppendText(
            buf, "cheng.csg_compiler.function_origin_child")
        layout.ByteBufAppendFixed32(buf, out.cids[parentId])
        csgCompilerTypeCidAppendU32(buf, childOrdinals[nodeId])
        csgCompilerTypeCidAppendU32(
            buf, snapshot.parserNodes.kinds[nodeId])
        csgCompilerTypeCidAppendU32(
            buf, snapshot.parserNodes.bindingResolutionKinds[nodeId])
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.parserNodes.bindingDeclarationSourceLocalRows[
                nodeId])
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.parserNodes.bindingPatternSourceLocalRows[nodeId])
        out.cids[nodeId] =
            hash256.Sha256Fixed(layout.ByteBufView(buf))
        out.functionIds[nodeId] = out.functionIds[parentId]
        layout.ByteBufFree(buf)
    for nodeId in 0..<parserNodeCount:
        let statementRow = statementRootRows[nodeId]
        if statementRow >= 0 &&
           statementFunctionIds[statementRow] >= 0 &&
           (out.functionIds[nodeId] !=
                statementFunctionIds[statementRow] ||
            !csgCompilerCidObserved(out.cids[nodeId])):
            out.error = Fmt" csg compiler snapshot: function origin capability publication split node={nodeId} statement={statementRow} observed={out.functionIds[nodeId]} expected={statementFunctionIds[statementRow]}"
            return out
    out.ok = true
    return out

@borrows
fn csgCompilerFragmentAppendOperandInto(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        functionId: int32,
        nodeStart: int32,
        nodeId: int32,
        operandNodeId: int32,
        err: var str): bool =
    if operandNodeId == -1:
        csgCompilerTypeCidAppendU32(buf, 0)
        return true
    if operandNodeId < nodeStart || operandNodeId >= nodeId ||
       operandNodeId >= snapshot.typedNodes.functionIds.len ||
       snapshot.typedNodes.functionIds[operandNodeId] != functionId:
        err = " csg compiler snapshot: fragment operand authority invalid"
        return false
    csgCompilerTypeCidAppendU32(buf, 1)
    csgCompilerTypeCidAppendU32(buf, operandNodeId - nodeStart)
    return true

@borrows
fn CsgCompilerFunctionFragmentCidsInto(
        snapshot: CsgCompilerSnapshotTables,
        out: var layout.FixedBytes32[],
        err: var str): bool =
    err = ""
    out = []
    if !csgCompilerFunctionFragmentColumnsAligned(snapshot):
        err = " csg compiler snapshot: function fragment columns mismatch"
        return false
    let functionCount = snapshot.functions.symbolIds.len
    let totalNodeCount = snapshot.typedNodes.functionIds.len
    # A type-only snapshot has one exact canonical fragment set: empty.
    # Non-function parser rows and portable Type/Symbol CIDs are independent
    # domains and must not trigger a parser reachability walk here.
    if functionCount == 0:
        if totalNodeCount != 0 ||
           snapshot.typedStatements.typedIrStatementIndexes.len != 0 ||
           snapshot.typedStatements.rootTypedNodeIds.len != 0 ||
           snapshot.typedNodes.captureValueDefinitionRows.len != 0 ||
           snapshot.valueDefinitions.producerSourceIndexes.len != 0 ||
           snapshot.valueDefinitionGroups.producerSourceIndexes.len !=
               0 ||
           snapshot.parserSidecars.functionBodySpanIds.len != 0:
            err = " csg compiler snapshot: zero-function fragment domain is not empty"
            return false
        return true
    var originReceipts =
        csgCompilerFunctionOriginReceiptsBuild(snapshot)
    if !originReceipts.ok:
        err = strings.CloneStr(originReceipts.error)
        return false
    for functionId in 0..<functionCount:
        let symbolId = snapshot.functions.symbolIds[functionId]
        let nodeStart = snapshot.functions.nodeStarts[functionId]
        let nodeCount = snapshot.functions.nodeCounts[functionId]
        let valueDefinitionStart =
            snapshot.functions.valueDefinitionStarts[functionId]
        let valueDefinitionCount =
            snapshot.functions.valueDefinitionCounts[functionId]
        let groupStart =
            snapshot.functions.valueDefinitionGroupStarts[functionId]
        let groupCount =
            snapshot.functions.valueDefinitionGroupCounts[functionId]
        if !csgCompilerIndexValid(
               symbolId, snapshot.symbols.symbolCids.len) ||
           !csgCompilerCidObserved(snapshot.symbols.symbolCids[symbolId]) ||
           !csgCompilerCidObserved(
               snapshot.functions.bodyContentCids[functionId]) ||
           !csgCompilerCidObserved(
               snapshot.functions.interfaceCids[functionId]) ||
           nodeStart < 0 || nodeCount <= 0 || nodeStart > totalNodeCount ||
           nodeCount > totalNodeCount - nodeStart ||
           valueDefinitionStart < 0 ||
           valueDefinitionCount < 0 ||
           valueDefinitionStart >
               snapshot.valueDefinitions.functionIds.len ||
           valueDefinitionCount >
               snapshot.valueDefinitions.functionIds.len -
                   valueDefinitionStart ||
           groupStart < 0 || groupCount < 0 ||
           groupStart >
               snapshot.valueDefinitionGroups.functionIds.len ||
           groupCount >
               snapshot.valueDefinitionGroups.functionIds.len -
                   groupStart:
            err = " csg compiler snapshot: fragment identity authority missing"
            return false
        var buf = layout.ByteBufInit(512)
        csgCompilerTypeCidAppendText(
            buf, "cheng.csg_compiler.function_fragment")
        layout.ByteBufAppendFixed32(
            buf, snapshot.symbols.symbolCids[symbolId])
        layout.ByteBufAppendFixed32(
            buf, snapshot.functions.bodyContentCids[functionId])
        layout.ByteBufAppendFixed32(
            buf, snapshot.functions.interfaceCids[functionId])
        csgCompilerTypeCidAppendU32(buf, nodeCount)
        csgCompilerTypeCidAppendU32(buf, groupCount)
        var statementCount: int32
        for statementId in 0..<
                snapshot.typedStatements.functionIds.len:
            if snapshot.typedStatements.functionIds[statementId] ==
                   functionId:
                statementCount = statementCount + 1
        csgCompilerTypeCidAppendU32(buf, statementCount)
        for statementId in 0..<
                snapshot.typedStatements.functionIds.len:
            if snapshot.typedStatements.functionIds[statementId] !=
                   functionId:
                continue
            let rootStart =
                snapshot.typedStatements.rootStarts[statementId]
            let rootCount =
                snapshot.typedStatements.rootCounts[statementId]
            if rootStart < 0 || rootCount < 0 ||
               rootStart >
                   snapshot.typedStatements.rootTypedNodeIds.len ||
               rootCount >
                   snapshot.typedStatements.rootTypedNodeIds.len -
                       rootStart:
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: fragment typed-statement CSR invalid"
                return false
            csgCompilerTypeCidAppendU32(buf, statementId)
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedStatements.typedIrStatementIndexes[
                    statementId])
            csgCompilerTypeCidAppendU32(buf, rootCount)
            for rootOffset in 0..<rootCount:
                let rootTypedNodeId =
                    snapshot.typedStatements.rootTypedNodeIds[
                        rootStart + rootOffset]
                if rootTypedNodeId < nodeStart ||
                   rootTypedNodeId >= nodeStart + nodeCount ||
                   snapshot.typedNodes.ownerStatementIds[
                       rootTypedNodeId] != statementId:
                    layout.ByteBufFree(buf)
                    err = " csg compiler snapshot: fragment typed-statement root invalid"
                    return false
                csgCompilerTypeCidAppendU32(
                    buf, rootTypedNodeId - nodeStart)
        for groupOffset in 0..<groupCount:
            let groupRow = groupStart + groupOffset
            if snapshot.valueDefinitionGroups.functionIds[groupRow] !=
                   functionId:
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: fragment value-definition group owner drift"
                return false
            csgCompilerTypeCidAppendU32(buf, groupRow)
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.producerSourceIndexes[
                    groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.parserProducerSourceIndexes[
                    groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                    groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.bindingOffsets[groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.bindingCounts[groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.declarationSourceLocalRows[
                    groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.patternSourceLocalRows[
                    groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.definitionRows[
                    groupRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitionGroups.consumedFlags[groupRow])
        csgCompilerTypeCidAppendU32(
            buf, valueDefinitionCount)
        for definitionOffset in 0..<
                valueDefinitionCount:
            let definitionRow =
                valueDefinitionStart + definitionOffset
            let definingTypedNodeId =
                snapshot.valueDefinitions.definingTypedNodeIds[
                    definitionRow]
            let definitionTypeId =
                snapshot.valueDefinitions.typeIds[definitionRow]
            if definingTypedNodeId < nodeStart ||
               definingTypedNodeId >= nodeStart + nodeCount ||
               snapshot.valueDefinitions.functionIds[definitionRow] !=
                   functionId ||
               !csgCompilerIndexValid(
                   definitionTypeId, snapshot.types.typeCids.len):
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: fragment value-definition authority missing"
                return false
            csgCompilerTypeCidAppendU32(buf, definitionRow)
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.originKinds[definitionRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.groupRows[definitionRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.producerSourceIndexes[
                    definitionRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.sourceLocalNodeIndexes[
                    definitionRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.declarationSourceLocalRows[
                    definitionRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.patternSourceLocalRows[
                    definitionRow])
            csgCompilerTypeCidAppendU32(
                buf, definingTypedNodeId - nodeStart)
            layout.ByteBufAppendFixed32(
                buf, snapshot.types.typeCids[definitionTypeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.ownershipKinds[
                    definitionRow])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.valueDefinitions.proofKinds[definitionRow])
        for nodeOffset in 0..<nodeCount:
            let nodeId = nodeStart + nodeOffset
            let typeId = snapshot.typedNodes.typeIds[nodeId]
            let captureStart = snapshot.typedNodes.captureStarts[nodeId]
            let captureCount = snapshot.typedNodes.captureCounts[nodeId]
            if snapshot.typedNodes.functionIds[nodeId] != functionId ||
               !csgCompilerIndexValid(
                   typeId, snapshot.types.typeCids.len) ||
               captureStart < 0 || captureCount < 0 ||
               captureStart >
                   snapshot.typedNodes.captureValueDefinitionRows.len ||
               captureCount >
                   snapshot.typedNodes.captureValueDefinitionRows.len -
                       captureStart ||
               !csgCompilerCidObserved(
                   snapshot.typedNodes.ownershipProofCids[nodeId]) ||
               !csgCompilerCidObserved(
                   snapshot.typedNodes.sendProofCids[nodeId]) ||
               !csgCompilerCidObserved(
                   snapshot.typedNodes.syncProofCids[nodeId]) ||
               !csgCompilerCidObserved(
                   snapshot.typedNodes.shareProofCids[nodeId]):
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: fragment typed-node proof missing"
                return false
            csgCompilerTypeCidAppendU32(buf, nodeOffset)
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.opKinds[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedNodes.bindingProducerSourceIndexes[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedNodes.bindingParserSourceLocalNodeRows[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedNodes.bindingDeclarationSourceLocalRows[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedNodes.bindingPatternSourceLocalRows[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedNodes.bindingValueDefinitionRows[nodeId])
            csgCompilerTypeCidAppendU32(
                buf,
                snapshot.typedNodes.producedValueDefinitionRows[nodeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.ownerStatementIds[nodeId])
            layout.ByteBufAppendFixed32(buf, snapshot.types.typeCids[typeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.valueKinds[nodeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.ownershipKinds[nodeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.ownershipProofKinds[nodeId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.typedNodes.ownershipProofCids[nodeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.sendConclusions[nodeId] ? 1 : 0)
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.sendProofKinds[nodeId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.typedNodes.sendProofCids[nodeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.syncConclusions[nodeId] ? 1 : 0)
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.syncProofKinds[nodeId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.typedNodes.syncProofCids[nodeId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.shareKinds[nodeId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.typedNodes.shareProofCids[nodeId])
            csgCompilerTypeCidAppendU32(buf, captureCount)
            for captureOffset in 0..<captureCount:
                let captureRow = captureStart + captureOffset
                let captureValueDefinitionRow =
                    snapshot.typedNodes.captureValueDefinitionRows[captureRow]
                let captureTypeId =
                    snapshot.typedNodes.captureTypeIds[captureRow]
                let captureOwnershipKind =
                    snapshot.typedNodes.captureOwnershipKinds[captureRow]
                if captureValueDefinitionRow < 0 ||
                   !csgCompilerIndexValid(
                       captureTypeId, snapshot.types.typeCids.len) ||
                   !csgCompilerOwnershipKindValid(captureOwnershipKind):
                    layout.ByteBufFree(buf)
                    err = " csg compiler snapshot: fragment capture invalid"
                    return false
                csgCompilerTypeCidAppendU32(
                    buf, captureValueDefinitionRow)
                layout.ByteBufAppendFixed32(
                    buf, snapshot.types.typeCids[captureTypeId])
                csgCompilerTypeCidAppendU32(
                    buf, captureOwnershipKind)
            csgCompilerTypeCidAppendU32(
                buf, snapshot.typedNodes.spanAuthorityKinds[nodeId])
            let originNodeId =
                snapshot.typedNodes.originParserNodeIds[nodeId]
            if originNodeId >= 0:
                if !csgCompilerIndexValid(
                       originNodeId, originReceipts.cids.len):
                    layout.ByteBufFree(buf)
                    err = " csg compiler snapshot: function-relative parser origin row invalid"
                    return false
                if originReceipts.functionIds[originNodeId] != functionId:
                    layout.ByteBufFree(buf)
                    err = Fmt" csg compiler snapshot: function origin receipt transfer split node={originNodeId} observed={originReceipts.functionIds[originNodeId]} expected={functionId}"
                    return false
                if !csgCompilerCidObserved(
                       originReceipts.cids[originNodeId]):
                    layout.ByteBufFree(buf)
                    err = " csg compiler snapshot: function-relative parser origin CID missing"
                    return false
                if snapshot.typedNodes.syntheticOriginKinds[nodeId] != 0:
                    layout.ByteBufFree(buf)
                    err = " csg compiler snapshot: function-relative parser origin synthetic split"
                    return false
                csgCompilerTypeCidAppendU32(buf, 1)
                layout.ByteBufAppendFixed32(
                    buf, originReceipts.cids[originNodeId])
            else:
                if snapshot.typedNodes.syntheticOriginKinds[nodeId] <= 0:
                    layout.ByteBufFree(buf)
                    err = " csg compiler snapshot: synthetic origin missing"
                    return false
                csgCompilerTypeCidAppendU32(buf, 0)
                csgCompilerTypeCidAppendU32(
                    buf, snapshot.typedNodes.syntheticOriginKinds[nodeId])
            if !csgCompilerFragmentAppendOperandInto(
                   buf, snapshot, functionId, nodeStart, nodeId,
                   snapshot.typedNodes.operand0NodeIds[nodeId], err) ||
               !csgCompilerFragmentAppendOperandInto(
                   buf, snapshot, functionId, nodeStart, nodeId,
                   snapshot.typedNodes.operand1NodeIds[nodeId], err) ||
               !csgCompilerFragmentAppendOperandInto(
                   buf, snapshot, functionId, nodeStart, nodeId,
                   snapshot.typedNodes.operand2NodeIds[nodeId], err):
                layout.ByteBufFree(buf)
                return false
        add(out, hash256.Sha256Fixed(layout.ByteBufView(buf)))
        layout.ByteBufFree(buf)
    return true

@borrows
fn CsgCompilerFunctionFragmentCidInto(
        snapshot: CsgCompilerSnapshotTables,
        functionId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    var fragmentCids: layout.FixedBytes32[]
    if !CsgCompilerFunctionFragmentCidsInto(snapshot, fragmentCids, err) ||
       !csgCompilerIndexValid(functionId, fragmentCids.len):
        if err == "":
            err = " csg compiler snapshot: fragment function row out of range"
        return false
    out = fragmentCids[functionId]
    return true

@borrows
fn csgCompilerTypedNodeProofBaseAppendInto(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        typedNodeId: int32,
        err: var str): bool =
    let count = snapshot.typedNodes.functionIds.len
    if !csgCompilerIndexValid(typedNodeId, count) ||
       typedNodeId >= snapshot.typedNodes.typedIrNodeIndexes.len ||
       typedNodeId >=
           snapshot.typedNodes.bindingProducerSourceIndexes.len ||
       typedNodeId >=
           snapshot.typedNodes.bindingParserSourceLocalNodeRows.len ||
       typedNodeId >=
           snapshot.typedNodes.bindingDeclarationSourceLocalRows.len ||
       typedNodeId >=
           snapshot.typedNodes.bindingPatternSourceLocalRows.len ||
       typedNodeId >=
           snapshot.typedNodes.bindingValueDefinitionRows.len ||
       typedNodeId >=
           snapshot.typedNodes.producedValueDefinitionRows.len ||
       typedNodeId >= snapshot.typedNodes.ownerStatementIds.len ||
       typedNodeId >= snapshot.typedNodes.opKinds.len ||
       typedNodeId >= snapshot.typedNodes.typeIds.len ||
       typedNodeId >= snapshot.typedNodes.valueKinds.len ||
       typedNodeId >= snapshot.typedNodes.captureStarts.len ||
       typedNodeId >= snapshot.typedNodes.captureCounts.len ||
       typedNodeId >= snapshot.typedNodes.ownershipKinds.len:
        err = " csg compiler snapshot: value proof row out of range"
        return false
    let functionId = snapshot.typedNodes.functionIds[typedNodeId]
    let typeId = snapshot.typedNodes.typeIds[typedNodeId]
    if !csgCompilerIndexValid(functionId,
           snapshot.functions.symbolIds.len) ||
       functionId >= snapshot.functions.interfaceCids.len ||
       functionId >= snapshot.functions.bodyContentCids.len ||
       functionId >= snapshot.functions.nodeStarts.len ||
       functionId >= snapshot.functions.nodeCounts.len ||
       !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len):
        err = " csg compiler snapshot: value proof identity missing"
        return false
    let symbolId = snapshot.functions.symbolIds[functionId]
    let functionNodeStart = snapshot.functions.nodeStarts[functionId]
    let functionNodeCount = snapshot.functions.nodeCounts[functionId]
    if !csgCompilerIndexValid(symbolId, snapshot.symbols.symbolCids.len) ||
       functionNodeStart < 0 || functionNodeCount <= 0 ||
       typedNodeId < functionNodeStart ||
       typedNodeId - functionNodeStart >= functionNodeCount:
        err = " csg compiler snapshot: value proof function missing"
        return false
    layout.ByteBufAppendFixed32(buf, snapshot.symbols.symbolCids[symbolId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.functions.interfaceCids[functionId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.functions.bodyContentCids[functionId])
    csgCompilerTypeCidAppendU32(
        buf, typedNodeId - functionNodeStart)
    csgCompilerTypeCidAppendU32(buf,
        snapshot.typedNodes.opKinds[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedNodes.bindingProducerSourceIndexes[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedNodes.bindingParserSourceLocalNodeRows[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedNodes.bindingDeclarationSourceLocalRows[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedNodes.bindingPatternSourceLocalRows[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedNodes.bindingValueDefinitionRows[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf,
        snapshot.typedNodes.producedValueDefinitionRows[typedNodeId])
    let ownerStatementId =
        snapshot.typedNodes.ownerStatementIds[typedNodeId]
    if !csgCompilerOptionalIndexValid(
           ownerStatementId,
           snapshot.typedStatements.functionIds.len) ||
       (ownerStatementId >= 0 &&
        (ownerStatementId >=
             snapshot.typedStatements.typedIrStatementIndexes.len ||
         ownerStatementId >=
             snapshot.typedStatements.rootStarts.len ||
         ownerStatementId >=
             snapshot.typedStatements.rootCounts.len ||
         snapshot.typedStatements.functionIds[ownerStatementId] !=
             functionId)):
        err = " csg compiler snapshot: value proof statement owner missing"
        return false
    csgCompilerTypeCidAppendU32(buf, ownerStatementId)
    if ownerStatementId >= 0:
        let rootStart =
            snapshot.typedStatements.rootStarts[ownerStatementId]
        let rootCount =
            snapshot.typedStatements.rootCounts[ownerStatementId]
        if rootStart < 0 || rootCount < 0 ||
           rootStart >
               snapshot.typedStatements.rootTypedNodeIds.len ||
           rootCount >
               snapshot.typedStatements.rootTypedNodeIds.len -
                   rootStart:
            err = " csg compiler snapshot: value proof statement root CSR missing"
            return false
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.typedStatements.typedIrStatementIndexes[
                ownerStatementId])
        csgCompilerTypeCidAppendU32(buf, rootCount)
        for rootOffset in 0..<rootCount:
            let rootTypedNodeId =
                snapshot.typedStatements.rootTypedNodeIds[
                    rootStart + rootOffset]
            if rootTypedNodeId < functionNodeStart ||
               rootTypedNodeId >=
                   functionNodeStart + functionNodeCount ||
               snapshot.typedNodes.ownerStatementIds[
                   rootTypedNodeId] != ownerStatementId:
                err = " csg compiler snapshot: value proof statement root missing"
                return false
            csgCompilerTypeCidAppendU32(
                buf, rootTypedNodeId - functionNodeStart)
    csgCompilerTypeCidAppendU32(buf,
        snapshot.typedNodes.valueKinds[typedNodeId])
    layout.ByteBufAppendFixed32(buf, snapshot.types.typeCids[typeId])
    csgCompilerTypeCidAppendU32(buf,
        snapshot.typedNodes.ownershipKinds[typedNodeId])
    let captureStart =
        snapshot.typedNodes.captureStarts[typedNodeId]
    let captureCount =
        snapshot.typedNodes.captureCounts[typedNodeId]
    if captureStart < 0 || captureCount < 0 ||
       captureStart >
           snapshot.typedNodes.captureValueDefinitionRows.len ||
       captureCount >
           snapshot.typedNodes.captureValueDefinitionRows.len -
               captureStart ||
       snapshot.typedNodes.captureValueDefinitionRows.len !=
           snapshot.typedNodes.captureTypeIds.len ||
       snapshot.typedNodes.captureValueDefinitionRows.len !=
           snapshot.typedNodes.captureOwnershipKinds.len:
        err = " csg compiler snapshot: value proof capture premise missing"
        return false
    csgCompilerTypeCidAppendU32(buf, captureCount)
    for captureOffset in 0..<captureCount:
        let captureRow = captureStart + captureOffset
        let captureTypeId =
            snapshot.typedNodes.captureTypeIds[captureRow]
        let captureOwnershipKind =
            snapshot.typedNodes.captureOwnershipKinds[captureRow]
        if snapshot.typedNodes.captureValueDefinitionRows[captureRow] < 0 ||
           !csgCompilerIndexValid(
               captureTypeId, snapshot.types.typeCids.len) ||
           !csgCompilerOwnershipKindValid(captureOwnershipKind):
            err = " csg compiler snapshot: value proof capture row invalid"
            return false
        csgCompilerTypeCidAppendU32(
            buf,
            snapshot.typedNodes.captureValueDefinitionRows[captureRow])
        layout.ByteBufAppendFixed32(
            buf, snapshot.types.typeCids[captureTypeId])
        csgCompilerTypeCidAppendU32(
            buf, captureOwnershipKind)
    return true

@borrows
fn csgCompilerTypedNodeTraitConclusionsInto(
        snapshot: CsgCompilerSnapshotTables,
        typedNodeId: int32,
        sendOut: var bool,
        syncOut: var bool,
        expectedProofKindOut: var int32,
        err: var str): bool =
    if !csgCompilerIndexValid(
           typedNodeId, snapshot.typedNodes.functionIds.len) ||
       typedNodeId >= snapshot.typedNodes.typeIds.len ||
       typedNodeId >= snapshot.typedNodes.valueKinds.len ||
       typedNodeId >= snapshot.typedNodes.captureCounts.len:
        err = " csg compiler snapshot: value trait row out of range"
        return false
    let typeId = snapshot.typedNodes.typeIds[typedNodeId]
    let valueKind = snapshot.typedNodes.valueKinds[typedNodeId]
    let captureCount = snapshot.typedNodes.captureCounts[typedNodeId]
    if !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) ||
       typeId >= snapshot.types.typeKinds.len ||
       typeId >= snapshot.types.traitConclusionKinds.len ||
       typeId >= snapshot.types.sendFlags.len ||
       typeId >= snapshot.types.syncFlags.len ||
       typeId >= snapshot.types.traitProofCids.len:
        err = " csg compiler snapshot: value trait type authority missing"
        return false
    if valueKind == CsgCompilerValueOrdinary:
        if captureCount != 0 ||
           snapshot.types.traitConclusionKinds[typeId] !=
               CsgCompilerTraitConclusionExact:
            err = " csg compiler snapshot: ordinary value lacks exact type trait conclusion"
            return false
        sendOut = snapshot.types.sendFlags[typeId]
        syncOut = snapshot.types.syncFlags[typeId]
        expectedProofKindOut = CsgCompilerValueProofTypeTrait
        return true
    # [function-address] Mirrors the producer's [op79] ptr scalar
    # binding: a Function row is a signature, not a function value.
    if valueKind == CsgCompilerValueFunctionAddress:
        if typeId >= snapshot.types.scalarKinds.len ||
           captureCount != 0 ||
           snapshot.types.typeKinds[typeId] != CsgCompilerTypeScalar ||
           snapshot.types.scalarKinds[typeId] != CsgCompilerScalarPtr:
            err = " csg compiler snapshot: invalid function-address value proof"
            return false
        sendOut = true
        syncOut = true
        expectedProofKindOut = CsgCompilerValueProofBoundary
        return true
    if valueKind == CsgCompilerValueClosure:
        if snapshot.types.typeKinds[typeId] !=
               CsgCompilerTypeFunction:
            err = " csg compiler snapshot: closure result is not a function type"
            return false
        let captureStart =
            snapshot.typedNodes.captureStarts[typedNodeId]
        if captureStart < 0 || captureCount < 0 ||
           captureStart >
               snapshot.typedNodes.captureValueDefinitionRows.len ||
           captureCount >
               snapshot.typedNodes.captureValueDefinitionRows.len -
                   captureStart:
            err = " csg compiler snapshot: closure capture CSR invalid"
            return false
        sendOut = true
        syncOut = true
        for captureOffset in 0..<captureCount:
            let captureRow = captureStart + captureOffset
            let captureTypeId =
                snapshot.typedNodes.captureTypeIds[captureRow]
            let captureOwnershipKind =
                snapshot.typedNodes.captureOwnershipKinds[captureRow]
            if !csgCompilerIndexValid(
                   captureTypeId, snapshot.types.typeCids.len) ||
               captureTypeId >= snapshot.types.sendFlags.len ||
               captureTypeId >= snapshot.types.syncFlags.len ||
               !csgCompilerOwnershipKindValid(captureOwnershipKind):
                err = " csg compiler snapshot: closure capture premise invalid"
                return false
            if captureOwnershipKind ==
                   CsgCompilerOwnershipBorrowed:
                sendOut = false
                syncOut = false
            else:
                sendOut =
                    sendOut && snapshot.types.sendFlags[captureTypeId]
                syncOut =
                    syncOut && snapshot.types.syncFlags[captureTypeId]
        expectedProofKindOut = CsgCompilerValueProofBoundary
        return true
    err = " csg compiler snapshot: invalid value kind"
    return false

@borrows
fn CsgCompilerTypedNodeOwnershipProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typedNodeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if typedNodeId < 0 ||
       typedNodeId >= snapshot.typedNodes.ownershipProofKinds.len ||
       typedNodeId >= snapshot.typedNodes.ownershipKinds.len ||
       typedNodeId >= snapshot.typedNodes.typeIds.len:
        err = " csg compiler snapshot: ownership proof row out of range"
        return false
    let typeId = snapshot.typedNodes.typeIds[typedNodeId]
    let ownershipKind =
        snapshot.typedNodes.ownershipKinds[typedNodeId]
    let ownershipProofKind =
        snapshot.typedNodes.ownershipProofKinds[typedNodeId]
    if !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) ||
       typeId >= snapshot.types.managedFlags.len ||
       typeId >= snapshot.types.traitProofCids.len ||
       !csgCompilerOwnershipKindValid(ownershipKind) ||
       !((ownershipProofKind == CsgCompilerValueProofTypeTrait &&
          !snapshot.types.managedFlags[typeId] &&
          ownershipKind == CsgCompilerOwnershipUnmanaged) ||
         (ownershipProofKind == CsgCompilerValueProofFlow &&
          ((!snapshot.types.managedFlags[typeId]) ||
           (snapshot.types.managedFlags[typeId] &&
            (ownershipKind == CsgCompilerOwnershipOwned ||
             ownershipKind == CsgCompilerOwnershipBorrowed))))):
        err = " csg compiler snapshot: immutable value ownership authority is missing"
        return false
    var buf = layout.ByteBufInit(256)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.value_ownership_proof")
    if !csgCompilerTypedNodeProofBaseAppendInto(
           buf, snapshot, typedNodeId, err):
        layout.ByteBufFree(buf)
        return false
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.ownershipProofKinds[typedNodeId])
    layout.ByteBufAppendFixed32(buf, snapshot.types.traitProofCids[typeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn CsgCompilerTypedNodeSendProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typedNodeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if typedNodeId < 0 ||
       typedNodeId >= snapshot.typedNodes.sendProofKinds.len ||
       typedNodeId >= snapshot.typedNodes.sendConclusions.len:
        err = " csg compiler snapshot: Send proof row out of range"
        return false
    var buf = layout.ByteBufInit(224)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.value_send_proof")
    if !csgCompilerTypedNodeProofBaseAppendInto(
           buf, snapshot, typedNodeId, err):
        layout.ByteBufFree(buf)
        return false
    let typeId = snapshot.typedNodes.typeIds[typedNodeId]
    var expectedSend: bool
    var expectedSync: bool
    var expectedProofKind: int32
    if !csgCompilerTypedNodeTraitConclusionsInto(
           snapshot, typedNodeId, expectedSend, expectedSync,
           expectedProofKind, err) ||
       snapshot.typedNodes.sendConclusions[typedNodeId] != expectedSend ||
       snapshot.typedNodes.sendProofKinds[typedNodeId] != expectedProofKind:
        layout.ByteBufFree(buf)
        if err == "":
            err = " csg compiler snapshot: Send conclusion mismatch"
        return false
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.sendProofKinds[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf, expectedSend ? 1 : 0)
    layout.ByteBufAppendFixed32(
        buf, snapshot.types.traitProofCids[typeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn CsgCompilerTypedNodeSyncProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typedNodeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if typedNodeId < 0 ||
       typedNodeId >= snapshot.typedNodes.syncProofKinds.len ||
       typedNodeId >= snapshot.typedNodes.syncConclusions.len:
        err = " csg compiler snapshot: Sync proof row out of range"
        return false
    var buf = layout.ByteBufInit(224)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.value_sync_proof")
    if !csgCompilerTypedNodeProofBaseAppendInto(
           buf, snapshot, typedNodeId, err):
        layout.ByteBufFree(buf)
        return false
    let typeId = snapshot.typedNodes.typeIds[typedNodeId]
    var expectedSend: bool
    var expectedSync: bool
    var expectedProofKind: int32
    if !csgCompilerTypedNodeTraitConclusionsInto(
           snapshot, typedNodeId, expectedSend, expectedSync,
           expectedProofKind, err) ||
       snapshot.typedNodes.syncConclusions[typedNodeId] != expectedSync ||
       snapshot.typedNodes.syncProofKinds[typedNodeId] != expectedProofKind:
        layout.ByteBufFree(buf)
        if err == "":
            err = " csg compiler snapshot: Sync conclusion mismatch"
        return false
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.syncProofKinds[typedNodeId])
    csgCompilerTypeCidAppendU32(
        buf, expectedSync ? 1 : 0)
    layout.ByteBufAppendFixed32(
        buf, snapshot.types.traitProofCids[typeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn CsgCompilerTypedNodeShareProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        typedNodeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if typedNodeId < 0 ||
       typedNodeId >= snapshot.typedNodes.shareKinds.len ||
       typedNodeId >= snapshot.typedNodes.ownershipKinds.len ||
       typedNodeId >= snapshot.typedNodes.ownershipProofCids.len ||
       typedNodeId >= snapshot.typedNodes.typeIds.len ||
       typedNodeId >= snapshot.typedNodes.sendProofCids.len ||
       typedNodeId >= snapshot.typedNodes.syncProofCids.len:
        err = " csg compiler snapshot: share proof row out of range"
        return false
    let typeId = snapshot.typedNodes.typeIds[typedNodeId]
    if !csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) ||
       typeId >= snapshot.types.managedFlags.len ||
       typedNodeId >= snapshot.typedNodes.sendConclusions.len ||
       typedNodeId >= snapshot.typedNodes.syncConclusions.len ||
       !csgCompilerCidObserved(
           snapshot.typedNodes.ownershipProofCids[typedNodeId]) ||
       !csgCompilerCidObserved(
           snapshot.typedNodes.sendProofCids[typedNodeId]) ||
       !csgCompilerCidObserved(
           snapshot.typedNodes.syncProofCids[typedNodeId]):
        err = " csg compiler snapshot: share proof premise missing"
        return false
    let ownershipKind = snapshot.typedNodes.ownershipKinds[typedNodeId]
    var expectedShareKind = CsgCompilerShareNone
    if snapshot.types.managedFlags[typeId] ||
       snapshot.typedNodes.valueKinds[typedNodeId] ==
           CsgCompilerValueClosure:
        if ownershipKind == CsgCompilerOwnershipBorrowed:
            expectedShareKind = CsgCompilerShareLocal
        elif ownershipKind == CsgCompilerOwnershipOwned:
            expectedShareKind =
                snapshot.typedNodes.sendConclusions[typedNodeId] &&
                snapshot.typedNodes.syncConclusions[typedNodeId] ?
                    CsgCompilerShareThreadSafe :
                    CsgCompilerShareLocal
        else:
            err = " csg compiler snapshot: managed share ownership missing"
            return false
    if snapshot.typedNodes.shareKinds[typedNodeId] !=
           expectedShareKind:
        err = " csg compiler snapshot: share conclusion mismatch"
        return false
    var buf = layout.ByteBufInit(256)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.value_share_proof")
    if !csgCompilerTypedNodeProofBaseAppendInto(
           buf, snapshot, typedNodeId, err):
        layout.ByteBufFree(buf)
        return false
    csgCompilerTypeCidAppendU32(
        buf, snapshot.typedNodes.shareKinds[typedNodeId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.typedNodes.ownershipProofCids[typedNodeId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.typedNodes.sendProofCids[typedNodeId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.typedNodes.syncProofCids[typedNodeId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

type
    csgCompilerBindingReverseIndex =
        sourceIdsByProducerSourceIndex: int32[]
        parserNodeStartsBySourceId: int32[]
        parserNodeCountsBySourceId: int32[]
        parserNodeRowsBySourceLocalSlot: int32[]
        declarationStartsBySourceId: int32[]
        declarationCountsBySourceId: int32[]
        patternStartsBySourceId: int32[]
        patternCountsBySourceId: int32[]
        parserFunctionRowsByFunctionId: int32[]
        bindingInitializerReachableRowsByParserNodeId: int32[]
        bindingInitializerStatementRowsByParserNodeId: int32[]

@borrows
fn csgCompilerBindingReverseIndexBuildInto(
        snapshot: CsgCompilerSnapshotTables,
        out: var csgCompilerBindingReverseIndex,
        err: var str): bool =
    out = csgCompilerBindingReverseIndex()
    let sourceCount =
        snapshot.parserSidecars.producerSourceIndexes.len
    let declarationCount =
        snapshot.parserSidecars.declarationSourceLocalRows.len
    let patternCount =
        snapshot.parserSidecars.patternSourceLocalRows.len
    let parserNodeCount = snapshot.parserNodes.sourceIds.len
    let parserFunctionCount =
        snapshot.parserSidecars.functionIndexes.len
    let functionCount = snapshot.functions.symbolIds.len
    let normalizedExprCount =
        snapshot.parserSidecars.normalizedExprParserNodeIds.len
    let statementRootCount =
        snapshot.parserSidecars.statementRootNodeIds.len
    if snapshot.sources.documentCids.len != sourceCount ||
       snapshot.parserSidecars.declarationProducerSourceIds.len !=
           declarationCount ||
       snapshot.parserSidecars.declarationKinds.len != declarationCount ||
       snapshot.parserSidecars.declarationFunctionRows.len !=
           declarationCount ||
       snapshot.parserSidecars.patternProducerSourceIds.len !=
           patternCount ||
       snapshot.parserSidecars.patternBindingDeclarationIds.len !=
           patternCount ||
       snapshot.parserNodes.producerNodeIds.len != parserNodeCount ||
       snapshot.parserSidecars.functionBodySpanIds.len !=
           parserFunctionCount ||
       snapshot.functions.bodySpanIds.len != functionCount ||
       snapshot.parserSidecars.normalizedExprFunctionIndexes.len !=
           normalizedExprCount ||
       snapshot.parserSidecars.normalizedExprStatementRoles.len !=
           normalizedExprCount ||
       snapshot.parserSidecars.statementRootRoles.len !=
           statementRootCount ||
       snapshot.parserSidecars.statementRootBindingDeclarationStarts.len !=
           statementRootCount ||
       snapshot.parserSidecars.statementRootBindingDeclarationCounts.len !=
           statementRootCount:
        err = " csg compiler snapshot: binding parser columns mismatch"
        return false
    setLen(out.sourceIdsByProducerSourceIndex, sourceCount)
    setLen(out.parserNodeStartsBySourceId, sourceCount)
    setLen(out.parserNodeCountsBySourceId, sourceCount)
    setLen(out.parserNodeRowsBySourceLocalSlot, parserNodeCount)
    setLen(out.declarationStartsBySourceId, sourceCount)
    setLen(out.declarationCountsBySourceId, sourceCount)
    setLen(out.patternStartsBySourceId, sourceCount)
    setLen(out.patternCountsBySourceId, sourceCount)
    setLen(out.parserFunctionRowsByFunctionId, functionCount)
    setLen(
        out.bindingInitializerReachableRowsByParserNodeId,
        parserNodeCount)
    setLen(
        out.bindingInitializerStatementRowsByParserNodeId,
        parserNodeCount)
    for parserNodeId in 0..<parserNodeCount:
        out.parserNodeRowsBySourceLocalSlot[parserNodeId] = -1
        out.bindingInitializerReachableRowsByParserNodeId[
            parserNodeId] = -1
        out.bindingInitializerStatementRowsByParserNodeId[
            parserNodeId] = -1
    for functionId in 0..<functionCount:
        out.parserFunctionRowsByFunctionId[functionId] = -1
    # The claim domain (producer source index) differs from the canonical
    # source id domain initialized here, so the whole reverse domain must
    # read -1 before the first claim: a canonical order that differs from
    # producer order is a valid bijection and must not trip the duplicate
    # arm through zero-filled slots.
    for sourceId in 0..<sourceCount:
        out.sourceIdsByProducerSourceIndex[sourceId] = -1
        out.declarationStartsBySourceId[sourceId] = -1
        out.patternStartsBySourceId[sourceId] = -1
    for sourceId in 0..<sourceCount:
        let producerSourceIndex =
            snapshot.parserSidecars.producerSourceIndexes[sourceId]
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sourceCount ||
           out.sourceIdsByProducerSourceIndex[
               producerSourceIndex] >= 0:
            err = " csg compiler snapshot: parser source reverse identity invalid"
            return false
        out.sourceIdsByProducerSourceIndex[
            producerSourceIndex] = sourceId
    for parserNodeId in 0..<parserNodeCount:
        let sourceId = snapshot.parserNodes.sourceIds[parserNodeId]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " csg compiler snapshot: parser node binding source invalid"
            return false
        out.parserNodeCountsBySourceId[sourceId] =
            out.parserNodeCountsBySourceId[sourceId] + 1
    var parserNodeCursor: int32
    for sourceId in 0..<sourceCount:
        out.parserNodeStartsBySourceId[sourceId] = parserNodeCursor
        parserNodeCursor =
            parserNodeCursor + out.parserNodeCountsBySourceId[sourceId]
    for parserNodeId in 0..<parserNodeCount:
        let sourceId = snapshot.parserNodes.sourceIds[parserNodeId]
        let sourceLocalNodeRow =
            snapshot.parserNodes.producerNodeIds[parserNodeId]
        if sourceLocalNodeRow < 0 ||
           sourceLocalNodeRow >=
               out.parserNodeCountsBySourceId[sourceId]:
            err = " csg compiler snapshot: parser node source-local identity invalid"
            return false
        let slot =
            out.parserNodeStartsBySourceId[sourceId] +
                sourceLocalNodeRow
        if out.parserNodeRowsBySourceLocalSlot[slot] >= 0:
            err = " csg compiler snapshot: duplicate parser node source-local identity"
            return false
        out.parserNodeRowsBySourceLocalSlot[slot] = parserNodeId
    var parserFunctionRowByBodySpan: int32[]
    setLen(
        parserFunctionRowByBodySpan,
        snapshot.spans.sourceIds.len)
    for spanId in 0..<parserFunctionRowByBodySpan.len:
        parserFunctionRowByBodySpan[spanId] = -1
    for parserFunctionRow in 0..<parserFunctionCount:
        let bodySpanId =
            snapshot.parserSidecars.functionBodySpanIds[
                parserFunctionRow]
        if bodySpanId < 0 ||
           bodySpanId >= parserFunctionRowByBodySpan.len ||
           parserFunctionRowByBodySpan[bodySpanId] >= 0:
            err = " csg compiler snapshot: parser function body identity invalid"
            return false
        parserFunctionRowByBodySpan[bodySpanId] = parserFunctionRow
    for functionId in 0..<functionCount:
        let bodySpanId = snapshot.functions.bodySpanIds[functionId]
        if bodySpanId < 0 ||
           bodySpanId >= parserFunctionRowByBodySpan.len ||
           parserFunctionRowByBodySpan[bodySpanId] < 0:
            err = " csg compiler snapshot: FunctionId parser row missing"
            return false
        out.parserFunctionRowsByFunctionId[functionId] =
            parserFunctionRowByBodySpan[bodySpanId]
    for normalizedExprRow in 0..<normalizedExprCount:
        if snapshot.parserSidecars.normalizedExprStatementRoles[
               normalizedExprRow] !=
               CsgCompilerParserStatementBindingInitializer:
            continue
        let parserNodeId =
            snapshot.parserSidecars.normalizedExprParserNodeIds[
                normalizedExprRow]
        let reachableFunctionRow =
            snapshot.parserSidecars.normalizedExprFunctionIndexes[
                normalizedExprRow]
        if parserNodeId < 0 || parserNodeId >= parserNodeCount ||
           reachableFunctionRow < 0 ||
           (out.bindingInitializerReachableRowsByParserNodeId[
                parserNodeId] >= 0 &&
            out.bindingInitializerReachableRowsByParserNodeId[
                parserNodeId] != reachableFunctionRow):
            err = " csg compiler snapshot: binding initializer function identity invalid"
            return false
        out.bindingInitializerReachableRowsByParserNodeId[
            parserNodeId] = reachableFunctionRow
    for statementRow in 0..<statementRootCount:
        if snapshot.parserSidecars.statementRootRoles[statementRow] !=
               CsgCompilerParserStatementBindingInitializer:
            continue
        let parserNodeId =
            snapshot.parserSidecars.statementRootNodeIds[statementRow]
        if parserNodeId < 0 || parserNodeId >= parserNodeCount ||
           out.bindingInitializerStatementRowsByParserNodeId[
               parserNodeId] >= 0:
            err = " csg compiler snapshot: binding initializer statement identity invalid"
            return false
        out.bindingInitializerStatementRowsByParserNodeId[
            parserNodeId] = statementRow
    for declarationRow in 0..<declarationCount:
        let sourceId =
            snapshot.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        if sourceId < 0 || sourceId >= sourceCount ||
           snapshot.parserSidecars.declarationSourceLocalRows[
               declarationRow] !=
               out.declarationCountsBySourceId[sourceId]:
            err = " csg compiler snapshot: declaration reverse identity invalid"
            return false
        if out.declarationStartsBySourceId[sourceId] < 0:
            out.declarationStartsBySourceId[sourceId] = declarationRow
        elif declarationRow !=
                 out.declarationStartsBySourceId[sourceId] +
                     out.declarationCountsBySourceId[sourceId]:
            err = " csg compiler snapshot: declaration source range split"
            return false
        out.declarationCountsBySourceId[sourceId] =
            out.declarationCountsBySourceId[sourceId] + 1
    for patternRow in 0..<patternCount:
        let sourceId =
            snapshot.parserSidecars.patternProducerSourceIds[patternRow]
        if sourceId < 0 || sourceId >= sourceCount ||
           snapshot.parserSidecars.patternSourceLocalRows[patternRow] !=
               out.patternCountsBySourceId[sourceId]:
            err = " csg compiler snapshot: Pattern reverse identity invalid"
            return false
        if out.patternStartsBySourceId[sourceId] < 0:
            out.patternStartsBySourceId[sourceId] = patternRow
        elif patternRow !=
                 out.patternStartsBySourceId[sourceId] +
                     out.patternCountsBySourceId[sourceId]:
            err = " csg compiler snapshot: Pattern source range split"
            return false
        out.patternCountsBySourceId[sourceId] =
            out.patternCountsBySourceId[sourceId] + 1
    return true

@borrows
fn csgCompilerValueDefinitionGroupsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        reverse: csgCompilerBindingReverseIndex,
        err: var str): bool =
    let groupCount =
        snapshot.valueDefinitionGroups.producerSourceIndexes.len
    let definitionCount =
        snapshot.valueDefinitions.producerSourceIndexes.len
    let functionCount = snapshot.functions.symbolIds.len
    if definitionCount != snapshot.valueDefinitions.groupRows.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.parserProducerSourceIndexes.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.bindingOffsets.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.bindingCounts.len ||
       groupCount != snapshot.valueDefinitionGroups.functionIds.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.declarationSourceLocalRows.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.patternSourceLocalRows.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.definitionRows.len ||
       groupCount !=
           snapshot.valueDefinitionGroups.consumedFlags.len ||
       functionCount !=
           snapshot.functions.valueDefinitionStarts.len ||
       functionCount !=
           snapshot.functions.valueDefinitionCounts.len ||
       functionCount !=
           snapshot.functions.valueDefinitionGroupStarts.len ||
       functionCount !=
           snapshot.functions.valueDefinitionGroupCounts.len ||
       functionCount != snapshot.functions.typedFunctionIndexes.len:
        err = " csg compiler snapshot: value-definition group columns mismatch"
        return false
    var groupSeen: bool[]
    setLen(groupSeen, groupCount)
    var functionIdsByTypedFunctionIndex: int32[]
    setLen(functionIdsByTypedFunctionIndex, functionCount)
    for typedFunctionIndex in 0..<functionCount:
        functionIdsByTypedFunctionIndex[typedFunctionIndex] = -1
    for functionId in 0..<functionCount:
        let typedFunctionIndex =
            snapshot.functions.typedFunctionIndexes[functionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionCount ||
           functionIdsByTypedFunctionIndex[typedFunctionIndex] >= 0:
            err = " csg compiler snapshot: value-definition typed function identity invalid"
            return false
        functionIdsByTypedFunctionIndex[typedFunctionIndex] =
            functionId
    var definitionCursor: int32
    var groupCursor: int32
    for typedFunctionIndex in 0..<functionCount:
        let functionId =
            functionIdsByTypedFunctionIndex[typedFunctionIndex]
        let definitionStart =
            snapshot.functions.valueDefinitionStarts[functionId]
        let functionDefinitionCount =
            snapshot.functions.valueDefinitionCounts[functionId]
        if definitionStart != definitionCursor ||
           functionDefinitionCount < 0 ||
           definitionStart > definitionCount ||
           functionDefinitionCount >
               definitionCount - definitionStart:
            err = " csg compiler snapshot: value-definition function range invalid"
            return false
        for definitionOffset in 0..<functionDefinitionCount:
            let definitionRow =
                definitionStart + definitionOffset
            if snapshot.valueDefinitions.functionIds[definitionRow] !=
                   functionId:
                err = " csg compiler snapshot: value-definition function ownership split"
                return false
        definitionCursor =
            definitionCursor + functionDefinitionCount
        let groupStart =
            snapshot.functions.valueDefinitionGroupStarts[functionId]
        let functionGroupCount =
            snapshot.functions.valueDefinitionGroupCounts[functionId]
        if groupStart != groupCursor || functionGroupCount < 0 ||
           groupStart > groupCount ||
           functionGroupCount > groupCount - groupStart:
            err = " csg compiler snapshot: value-definition function group range invalid"
            return false
        var previousInitializerRoot: int32 = -1
        var previousPatternSourceLocalRow: int32 = -1
        var previousBindingOffset: int32 = -1
        var previousBindingCount: int32
        for groupOffset in 0..<functionGroupCount:
            let groupRow = groupStart + groupOffset
            let initializerRoot =
                snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                    groupRow]
            let patternSourceLocalRow =
                snapshot.valueDefinitionGroups.patternSourceLocalRows[
                    groupRow]
            let bindingOffset =
                snapshot.valueDefinitionGroups.bindingOffsets[groupRow]
            let bindingCount =
                snapshot.valueDefinitionGroups.bindingCounts[groupRow]
            if groupSeen[groupRow] ||
               snapshot.valueDefinitionGroups.functionIds[groupRow] !=
                   functionId:
                err = " csg compiler snapshot: value-definition function group ownership split"
                return false
            if initializerRoot < previousInitializerRoot ||
               bindingOffset < 0 || bindingCount <= 0 ||
               bindingOffset >= bindingCount ||
               (initializerRoot == previousInitializerRoot &&
                (patternSourceLocalRow <=
                     previousPatternSourceLocalRow ||
                 bindingOffset != previousBindingOffset + 1 ||
                 bindingCount != previousBindingCount)) ||
               (initializerRoot > previousInitializerRoot &&
                (bindingOffset != 0 ||
                 (previousInitializerRoot >= 0 &&
                  previousBindingOffset != previousBindingCount - 1))):
                err = " csg compiler snapshot: value-definition root CSR invalid"
                return false
            groupSeen[groupRow] = true
            previousInitializerRoot = initializerRoot
            previousPatternSourceLocalRow = patternSourceLocalRow
            previousBindingOffset = bindingOffset
            previousBindingCount = bindingCount
        if functionGroupCount > 0 &&
           previousBindingOffset != previousBindingCount - 1:
            err = " csg compiler snapshot: value-definition root CSR incomplete"
            return false
        groupCursor = groupCursor + functionGroupCount
    if definitionCursor != definitionCount:
        err = " csg compiler snapshot: value-definition CSR incomplete"
        return false
    if groupCursor != groupCount:
        err = " csg compiler snapshot: value-definition group CSR incomplete"
        return false
    for groupRow in 0..<groupCount:
        if !groupSeen[groupRow]:
            err = " csg compiler snapshot: value-definition group coverage incomplete"
            return false
        let producerSourceIndex =
            snapshot.valueDefinitionGroups.producerSourceIndexes[
                groupRow]
        let parserProducerSourceIndex =
            snapshot.valueDefinitionGroups.parserProducerSourceIndexes[
                groupRow]
        let initializerRootSourceLocalNodeIndex =
            snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                groupRow]
        let bindingOffset =
            snapshot.valueDefinitionGroups.bindingOffsets[groupRow]
        let bindingCount =
            snapshot.valueDefinitionGroups.bindingCounts[groupRow]
        let functionId =
            snapshot.valueDefinitionGroups.functionIds[groupRow]
        let declarationSourceLocalRow =
            snapshot.valueDefinitionGroups.declarationSourceLocalRows[
                groupRow]
        let patternSourceLocalRow =
            snapshot.valueDefinitionGroups.patternSourceLocalRows[
                groupRow]
        let definitionRow =
            snapshot.valueDefinitionGroups.definitionRows[groupRow]
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               reverse.sourceIdsByProducerSourceIndex.len ||
           parserProducerSourceIndex < 0 ||
           parserProducerSourceIndex >=
               reverse.sourceIdsByProducerSourceIndex.len ||
           initializerRootSourceLocalNodeIndex < 0 ||
           bindingOffset < 0 || bindingCount <= 0 ||
           bindingOffset >= bindingCount ||
           !csgCompilerIndexValid(functionId, functionCount) ||
           !csgCompilerIndexValid(definitionRow, definitionCount) ||
           snapshot.valueDefinitionGroups.consumedFlags[groupRow] !=
               1:
            err = " csg compiler snapshot: value-definition group domain invalid"
            return false
        let sourceId =
            reverse.sourceIdsByProducerSourceIndex[
                producerSourceIndex]
        let parserSourceId =
            reverse.sourceIdsByProducerSourceIndex[
                parserProducerSourceIndex]
        if sourceId < 0 || parserSourceId != sourceId ||
           declarationSourceLocalRow < 0 ||
           declarationSourceLocalRow >=
               reverse.declarationCountsBySourceId[sourceId] ||
           patternSourceLocalRow < 0 ||
           patternSourceLocalRow >=
               reverse.patternCountsBySourceId[sourceId]:
            err = " csg compiler snapshot: value-definition group parser coordinate invalid"
            return false
        let declarationRow =
            reverse.declarationStartsBySourceId[sourceId] +
                declarationSourceLocalRow
        let patternRow =
            reverse.patternStartsBySourceId[sourceId] +
                patternSourceLocalRow
        let parserFunctionRow =
            reverse.parserFunctionRowsByFunctionId[functionId]
        if initializerRootSourceLocalNodeIndex >=
               reverse.parserNodeCountsBySourceId[sourceId]:
            # Decl-local groups registered by typed_expr carry a synthetic
            # initializer-root key (nodeCount + 1 + declarationRow, disjoint
            # from the parser value-expr node domain by construction).  Such
            # groups have no BindingInitializer statement root, so the
            # statement-root join below cannot apply.  Admit a group into
            # this arm only when the synthetic-key interval and every
            # remaining group coordinate jointly prove the decl-local shape;
            # any other out-of-domain root keeps the original verdict.
            if initializerRootSourceLocalNodeIndex ==
                   reverse.parserNodeCountsBySourceId[sourceId] ||
               initializerRootSourceLocalNodeIndex >
                   reverse.parserNodeCountsBySourceId[sourceId] +
                       reverse.declarationCountsBySourceId[sourceId] ||
               bindingCount != 1 || bindingOffset != 0 ||
               snapshot.parserSidecars.declarationKinds[
                   declarationRow] !=
                   CsgCompilerParserDeclarationLocal ||
               snapshot.parserSidecars.declarationFunctionRows[
                   declarationRow] != parserFunctionRow ||
               snapshot.parserSidecars.patternBindingDeclarationIds[
                   patternRow] != declarationRow ||
               snapshot.valueDefinitions.originKinds[definitionRow] !=
                   CsgCompilerValueDefinitionOriginBindingInitializer ||
               snapshot.valueDefinitions.groupRows[definitionRow] !=
                   groupRow ||
               snapshot.valueDefinitions.producerSourceIndexes[
                   definitionRow] != producerSourceIndex ||
               snapshot.valueDefinitions.declarationSourceLocalRows[
                   definitionRow] != declarationSourceLocalRow ||
               snapshot.valueDefinitions.patternSourceLocalRows[
                   definitionRow] != patternSourceLocalRow ||
               snapshot.valueDefinitions.functionIds[definitionRow] !=
                   functionId:
                err = " csg compiler snapshot: value-definition group parser coordinate invalid"
                return false
            continue
        let initializerParserNodeId =
            reverse.parserNodeRowsBySourceLocalSlot[
                reverse.parserNodeStartsBySourceId[sourceId] +
                    initializerRootSourceLocalNodeIndex]
        let statementRow =
            initializerParserNodeId < 0 ? -1 :
                reverse.bindingInitializerStatementRowsByParserNodeId[
                    initializerParserNodeId]
        let statementDeclarationStart =
            statementRow < 0 ? -1 :
                snapshot.parserSidecars.statementRootBindingDeclarationStarts[
                    statementRow]
        let statementDeclarationCount =
            statementRow < 0 ? 0 :
                snapshot.parserSidecars.statementRootBindingDeclarationCounts[
                    statementRow]
        if initializerParserNodeId < 0 ||
           parserFunctionRow < 0 ||
           statementRow < 0 ||
           statementDeclarationStart < 0 ||
           statementDeclarationCount <= 0 ||
           statementDeclarationStart >
               snapshot.parserSidecars.declarationKinds.len ||
           statementDeclarationCount >
               snapshot.parserSidecars.declarationKinds.len -
                   statementDeclarationStart ||
           bindingCount != statementDeclarationCount ||
           declarationRow < statementDeclarationStart ||
           declarationRow >=
               statementDeclarationStart + statementDeclarationCount ||
           bindingOffset != declarationRow - statementDeclarationStart ||
           snapshot.parserSidecars.declarationKinds[
               declarationRow] !=
               CsgCompilerParserDeclarationLocal ||
           snapshot.parserSidecars.declarationFunctionRows[
               declarationRow] != parserFunctionRow ||
           snapshot.parserSidecars.patternBindingDeclarationIds[
               patternRow] != declarationRow ||
           reverse.bindingInitializerReachableRowsByParserNodeId[
               initializerParserNodeId] !=
               snapshot.parserSidecars.functionIndexes[
                   parserFunctionRow] ||
           snapshot.valueDefinitions.originKinds[definitionRow] !=
               CsgCompilerValueDefinitionOriginBindingInitializer ||
           snapshot.valueDefinitions.groupRows[definitionRow] !=
               groupRow ||
           snapshot.valueDefinitions.producerSourceIndexes[
               definitionRow] != producerSourceIndex ||
           snapshot.valueDefinitions.declarationSourceLocalRows[
               definitionRow] != declarationSourceLocalRow ||
           snapshot.valueDefinitions.patternSourceLocalRows[
               definitionRow] != patternSourceLocalRow ||
           snapshot.valueDefinitions.functionIds[definitionRow] !=
               functionId:
            err = " csg compiler snapshot: value-definition group authority drift"
            return false
    return true

fn csgCompilerTypedOpIsExactManagedTemporaryProducer(
        opKind: int32): bool =
    return opKind == CsgCompilerTypedOpReturnStrLiteral ||
           opKind == CsgCompilerTypedOpCstringToStrCopy ||
           opKind == CsgCompilerTypedOpStrLit ||
           opKind == CsgCompilerTypedOpEmptySeqInit ||
           opKind == CsgCompilerTypedOpFmt ||
           opKind == CsgCompilerTypedOpStrAdd ||
           opKind == CsgCompilerTypedOpSeqLiteral ||
           opKind == CsgCompilerTypedOpClosure

@borrows
fn csgCompilerValueDefinitionsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        reverse: csgCompilerBindingReverseIndex,
        requireCompleteProof: bool,
        err: var str): bool =
    let count = snapshot.valueDefinitions.producerSourceIndexes.len
    if count != snapshot.valueDefinitions.originKinds.len ||
       count != snapshot.valueDefinitions.groupRows.len ||
       count != snapshot.valueDefinitions.sourceLocalNodeIndexes.len ||
       count !=
           snapshot.valueDefinitions.declarationSourceLocalRows.len ||
       count != snapshot.valueDefinitions.patternSourceLocalRows.len ||
       count != snapshot.valueDefinitions.functionIds.len ||
       count != snapshot.valueDefinitions.definingTypedNodeIds.len ||
       count != snapshot.valueDefinitions.typeIds.len ||
       count != snapshot.valueDefinitions.ownershipKinds.len ||
       count != snapshot.valueDefinitions.proofKinds.len:
        err = " csg compiler snapshot: value-definition columns mismatch"
        return false
    for definitionRow in 0..<count:
        let originKind =
            snapshot.valueDefinitions.originKinds[definitionRow]
        let groupRow =
            snapshot.valueDefinitions.groupRows[definitionRow]
        if originKind ==
               CsgCompilerValueDefinitionOriginBindingInitializer:
            if groupRow < 0 ||
               groupRow >=
                   snapshot.valueDefinitionGroups.producerSourceIndexes.len ||
               snapshot.valueDefinitionGroups.definitionRows[groupRow] !=
                   definitionRow:
                err = " csg compiler snapshot: binding value-definition group edge invalid"
                return false
        elif originKind ==
                 CsgCompilerValueDefinitionOriginParameter ||
             originKind ==
                 CsgCompilerValueDefinitionOriginCallResult ||
             originKind ==
                 CsgCompilerValueDefinitionOriginManagedTemporary:
            if groupRow != -1:
                err = " csg compiler snapshot: non-binding value-definition retained group edge"
                return false
        else:
            err = " csg compiler snapshot: value-definition origin invalid"
            return false
        let producerSourceIndex =
            snapshot.valueDefinitions.producerSourceIndexes[
                definitionRow]
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               reverse.sourceIdsByProducerSourceIndex.len:
            err = " csg compiler snapshot: value-definition producer source invalid"
            return false
        let sourceId =
            reverse.sourceIdsByProducerSourceIndex[producerSourceIndex]
        let sourceLocalNodeIndex =
            snapshot.valueDefinitions.sourceLocalNodeIndexes[
                definitionRow]
        let declarationSourceLocalRow =
            snapshot.valueDefinitions.declarationSourceLocalRows[
                definitionRow]
        let patternSourceLocalRow =
            snapshot.valueDefinitions.patternSourceLocalRows[
                definitionRow]
        if sourceId < 0:
            err = " csg compiler snapshot: value-definition source identity invalid"
            return false
        # Decl-local rows registered by typed_expr carry the declaration
        # source-local row in the sourceLocalNodeIndex column (the binding
        # origin contract requires a non-negative node coordinate, and a
        # bare declaration has no parser node).  Such a row is admitted
        # only when its group carries a synthetic initializer-root key and
        # every group/row coordinate jointly proves the decl-local shape;
        # every other row keeps the parser-node domain verdicts below.
        let declLocalSyntheticRow: bool =
            originKind ==
                CsgCompilerValueDefinitionOriginBindingInitializer &&
            csgCompilerIndexValid(
                groupRow,
                snapshot.valueDefinitionGroups.producerSourceIndexes.len) &&
            sourceLocalNodeIndex == declarationSourceLocalRow &&
            snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                groupRow] >
                reverse.parserNodeCountsBySourceId[sourceId] &&
            snapshot.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                groupRow] <=
                reverse.parserNodeCountsBySourceId[sourceId] +
                    reverse.declarationCountsBySourceId[sourceId] &&
            snapshot.valueDefinitionGroups.definitionRows[groupRow] ==
                definitionRow &&
            snapshot.valueDefinitionGroups.declarationSourceLocalRows[
                groupRow] == declarationSourceLocalRow &&
            snapshot.valueDefinitionGroups.patternSourceLocalRows[
                groupRow] == patternSourceLocalRow &&
            snapshot.valueDefinitionGroups.functionIds[groupRow] ==
                snapshot.valueDefinitions.functionIds[definitionRow] &&
            snapshot.valueDefinitionGroups.consumedFlags[groupRow] == 1
        var parserNodeId: int32 = -1
        if sourceLocalNodeIndex >= 0 && !declLocalSyntheticRow:
            if sourceLocalNodeIndex >=
                   reverse.parserNodeCountsBySourceId[sourceId]:
                err = " csg compiler snapshot: value-definition parser node invalid"
                return false
            parserNodeId =
                reverse.parserNodeRowsBySourceLocalSlot[
                    reverse.parserNodeStartsBySourceId[sourceId] +
                    sourceLocalNodeIndex]
            if parserNodeId < 0:
                err = " csg compiler snapshot: value-definition parser node missing"
                return false
        var declarationRow: int32 = -1
        if declarationSourceLocalRow >= 0:
            if declarationSourceLocalRow >=
                   reverse.declarationCountsBySourceId[sourceId]:
                err = " csg compiler snapshot: value-definition declaration coordinate invalid"
                return false
            declarationRow =
                reverse.declarationStartsBySourceId[sourceId] +
                    declarationSourceLocalRow
        var patternRow: int32 = -1
        if patternSourceLocalRow >= 0:
            if patternSourceLocalRow >=
                   reverse.patternCountsBySourceId[sourceId]:
                err = " csg compiler snapshot: value-definition Pattern coordinate invalid"
                return false
            patternRow =
                reverse.patternStartsBySourceId[sourceId] +
                    patternSourceLocalRow
        let functionId =
            snapshot.valueDefinitions.functionIds[definitionRow]
        let definingTypedNodeId =
            snapshot.valueDefinitions.definingTypedNodeIds[definitionRow]
        let typeId = snapshot.valueDefinitions.typeIds[definitionRow]
        let ownershipKind =
            snapshot.valueDefinitions.ownershipKinds[definitionRow]
        let proofKind =
            snapshot.valueDefinitions.proofKinds[definitionRow]
        if !csgCompilerIndexValid(
               functionId, snapshot.functions.symbolIds.len):
            err = " csg compiler snapshot: value-definition function invalid"
            return false
        # [wall117e] 判词富化（9289 layout field CID / wall98 先例同款）：
        # producer authority drift 七条件（typed-node 界 / produced 列界 /
        # function 归属 / producedValueDefinitionRows 反向指针 /
        # ownershipKind 值域 / ownershipKinds 相等 / proofKind 值域）判定
        # 实况全列入判词。definingTypedNodeId 越界时 node 侧各列不可寻址，
        # 诊断列条件化取 -1；守卫判定零改动，fail-closed 判据原样。
        var nodeFunctionIdForErr: int32 = -1
        var nodeProducedRowForErr: int32 = -1
        var nodeOwnershipKindForErr: int32 = -1
        var defOwnershipKindValidForErr: int32
        if csgCompilerOwnershipKindValid(ownershipKind):
            defOwnershipKindValidForErr = 1
        if csgCompilerIndexValid(
               definingTypedNodeId, snapshot.typedNodes.functionIds.len):
            nodeFunctionIdForErr =
                snapshot.typedNodes.functionIds[definingTypedNodeId]
        if definingTypedNodeId >= 0 &&
           definingTypedNodeId <
               snapshot.typedNodes.producedValueDefinitionRows.len:
            nodeProducedRowForErr =
                snapshot.typedNodes.producedValueDefinitionRows[
                    definingTypedNodeId]
            nodeOwnershipKindForErr =
                snapshot.typedNodes.ownershipKinds[definingTypedNodeId]
        # [wall117e] 契约对齐（producer 权威=typed_expr
        # typedExprIrValueDefinitionOwnershipMatchesNode）：非 Parameter 源
        # 要求定义所有权与产出节点 exprClass 相等；Parameter 源的定义所有权
        # 是 formal 本体权威（不可变非 @borrows 形参=Owned），而 ParamRef
        # 产出节点恒为借视（Borrowed），两者系同一 formals 的两个投影，
        # 契约本就不要求相等（快照表无 paramMutableFlags/borrowsArguments
        # 列，正向臂不可投影，producer 注册端已 panic 级守卫）。守卫对其余
        # 六条件与 Parameter 源原样保留，零弱化。
        if !csgCompilerIndexValid(
               definingTypedNodeId, snapshot.typedNodes.functionIds.len) ||
           definingTypedNodeId >=
               snapshot.typedNodes.producedValueDefinitionRows.len ||
           snapshot.typedNodes.functionIds[definingTypedNodeId] !=
               functionId ||
           snapshot.typedNodes.producedValueDefinitionRows[
               definingTypedNodeId] != definitionRow ||
           !csgCompilerOwnershipKindValid(ownershipKind) ||
           (originKind !=
                CsgCompilerValueDefinitionOriginParameter &&
            snapshot.typedNodes.ownershipKinds[definingTypedNodeId] !=
                ownershipKind) ||
           proofKind < CsgCompilerValueDefinitionTypeProofNone ||
           proofKind > CsgCompilerValueDefinitionTypeProofAggregate:
            err = Fmt" csg compiler snapshot: value-definition producer authority drift definition_row={definitionRow} function_id={functionId} defining_typed_node_id={definingTypedNodeId} typed_node_count={snapshot.typedNodes.functionIds.len} produced_rows_len={snapshot.typedNodes.producedValueDefinitionRows.len} node_function_id={nodeFunctionIdForErr} node_produced_row={nodeProducedRowForErr} definition_ownership_kind={ownershipKind} node_ownership_kind={nodeOwnershipKindForErr} definition_ownership_kind_valid={defOwnershipKindValidForErr} proof_kind={proofKind} proof_kind_none={CsgCompilerValueDefinitionTypeProofNone} proof_kind_aggregate={CsgCompilerValueDefinitionTypeProofAggregate}"
            return false
        let ownerStatementId =
            snapshot.typedNodes.ownerStatementIds[
                definingTypedNodeId]
        # A bare declaration binding (`var n: T` with no explicit
        # initializer) is registered by typed_expr as a desugared
        # synthetic NilPtr producing node that has no owning statement
        # and no parser origin.  The producer domain admits such a row
        # only through its exact detached zero-declaration template
        # (binding origin, owner -1, NilPtr op, parser origin -1,
        # Desugared synthetic origin, NoSource span authority); this
        # projection-side mirror keeps the full conjunction and is
        # fail-closed on any unreadable column.
        let detachedZeroDeclarationNode: bool =
            originKind ==
                CsgCompilerValueDefinitionOriginBindingInitializer &&
            ownerStatementId == -1 &&
            definingTypedNodeId < snapshot.typedNodes.opKinds.len &&
            snapshot.typedNodes.opKinds[definingTypedNodeId] ==
                CsgCompilerTypedOpNilPtr &&
            definingTypedNodeId <
                snapshot.typedNodes.originParserNodeIds.len &&
            snapshot.typedNodes.originParserNodeIds[
                definingTypedNodeId] == -1 &&
            definingTypedNodeId <
                snapshot.typedNodes.syntheticOriginKinds.len &&
            snapshot.typedNodes.syntheticOriginKinds[
                definingTypedNodeId] == 3 &&
            definingTypedNodeId <
                snapshot.typedNodes.spanAuthorityKinds.len &&
            snapshot.typedNodes.spanAuthorityKinds[
                definingTypedNodeId] == 2
        if (originKind ==
                CsgCompilerValueDefinitionOriginParameter &&
            ownerStatementId != -1) ||
           (originKind !=
                CsgCompilerValueDefinitionOriginParameter &&
            !detachedZeroDeclarationNode &&
            !csgCompilerIndexValid(
                ownerStatementId,
                snapshot.typedStatements.functionIds.len)):
            var nodeOpKindForErr: int32 = -1
            var nodeSyntheticKindForErr: int32 = -1
            var nodeOriginParserIdForErr: int32 = -2
            var nodeSpanAuthorityForErr: int32 = -1
            if definingTypedNodeId <
                   snapshot.typedNodes.opKinds.len:
                nodeOpKindForErr =
                    snapshot.typedNodes.opKinds[definingTypedNodeId]
            if definingTypedNodeId <
                   snapshot.typedNodes.syntheticOriginKinds.len:
                nodeSyntheticKindForErr =
                    snapshot.typedNodes.syntheticOriginKinds[
                        definingTypedNodeId]
            if definingTypedNodeId <
                   snapshot.typedNodes.originParserNodeIds.len:
                nodeOriginParserIdForErr =
                    snapshot.typedNodes.originParserNodeIds[
                        definingTypedNodeId]
            if definingTypedNodeId <
                   snapshot.typedNodes.spanAuthorityKinds.len:
                nodeSpanAuthorityForErr =
                    snapshot.typedNodes.spanAuthorityKinds[
                        definingTypedNodeId]
            err = Fmt" csg compiler snapshot: value-definition owner statement drift definition_row={definitionRow} origin_kind={originKind} function_id={functionId} defining_typed_node_id={definingTypedNodeId} owner_statement_id={ownerStatementId} typed_statement_count={snapshot.typedStatements.functionIds.len} typed_node_count={snapshot.typedNodes.functionIds.len} node_function_id={snapshot.typedNodes.functionIds[definingTypedNodeId]} node_op_kind={nodeOpKindForErr} node_synthetic_kind={nodeSyntheticKindForErr} node_origin_parser_id={nodeOriginParserIdForErr} node_span_authority={nodeSpanAuthorityForErr}"
            return false
        if originKind ==
               CsgCompilerValueDefinitionOriginParameter:
            if sourceLocalNodeIndex != -1 ||
               declarationRow < 0 ||
               patternRow != -1 ||
               snapshot.parserSidecars.declarationKinds[
                   declarationRow] !=
                   CsgCompilerParserDeclarationParameter ||
               snapshot.parserSidecars.declarationFunctionRows[
                   declarationRow] !=
                   reverse.parserFunctionRowsByFunctionId[functionId]:
                err = " csg compiler snapshot: parameter value-definition identity drift"
                return false
        elif originKind ==
                 CsgCompilerValueDefinitionOriginBindingInitializer:
            if (!declLocalSyntheticRow && parserNodeId < 0) ||
               declarationRow < 0 ||
               patternRow < 0 ||
               snapshot.parserSidecars.declarationKinds[declarationRow] !=
                   CsgCompilerParserDeclarationLocal ||
               snapshot.parserSidecars.declarationFunctionRows[
                   declarationRow] !=
                   reverse.parserFunctionRowsByFunctionId[functionId] ||
               snapshot.parserSidecars.patternBindingDeclarationIds[
                   patternRow] != declarationRow:
                err = " csg compiler snapshot: binding value-definition identity drift"
                return false
        elif originKind ==
                 CsgCompilerValueDefinitionOriginCallResult:
            if parserNodeId < 0 ||
               declarationRow != -1 ||
               patternRow != -1 ||
               snapshot.typedNodes.opKinds[definingTypedNodeId] !=
                   CsgCompilerTypedOpCallExpr ||
               snapshot.typedNodes.originParserNodeIds[
                   definingTypedNodeId] != parserNodeId:
                err = " csg compiler snapshot: call-result value-definition identity drift"
                return false
        else:
            if parserNodeId < 0 ||
               declarationRow != -1 ||
               patternRow != -1 ||
               ownershipKind != CsgCompilerOwnershipOwned ||
               !csgCompilerTypedOpIsExactManagedTemporaryProducer(
                   snapshot.typedNodes.opKinds[definingTypedNodeId]) ||
               snapshot.typedNodes.originParserNodeIds[
                   definingTypedNodeId] != parserNodeId ||
               (typeId >= 0 &&
                (typeId >= snapshot.types.managedFlags.len ||
                 !snapshot.types.managedFlags[typeId])):
                err = " csg compiler snapshot: managed temporary value-definition identity drift"
                return false
        if (requireCompleteProof &&
            (!csgCompilerIndexValid(
                 typeId, snapshot.types.typeCids.len) ||
             typeId >= snapshot.types.managedFlags.len ||
             snapshot.typedNodes.typeIds[definingTypedNodeId] !=
                 typeId)) ||
           (!requireCompleteProof &&
            (!csgCompilerOptionalIndexValid(
                 typeId, snapshot.types.typeCids.len) ||
             snapshot.typedNodes.typeIds[definingTypedNodeId] !=
                 typeId)) ||
           (typeId >= 0 &&
            typeId < snapshot.types.managedFlags.len &&
            snapshot.types.managedFlags[typeId] &&
            proofKind == CsgCompilerValueDefinitionTypeProofNone):
            err = " csg compiler snapshot: value-definition TypeId authority drift"
            return false
        let symbolId = snapshot.functions.symbolIds[functionId]
        if !csgCompilerIndexValid(
               symbolId, snapshot.symbols.sourceIds.len) ||
           snapshot.symbols.sourceIds[symbolId] != sourceId:
            err = " csg compiler snapshot: value-definition function source drift"
            return false
    return true

@borrows
fn csgCompilerTypedNodeBindingIdentityValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        reverse: csgCompilerBindingReverseIndex,
        row: int32,
        err: var str): bool =
    let producerSourceIndex =
        snapshot.typedNodes.bindingProducerSourceIndexes[row]
    let parserSourceLocalNodeRow =
        snapshot.typedNodes.bindingParserSourceLocalNodeRows[row]
    let declarationSourceLocalRow =
        snapshot.typedNodes.bindingDeclarationSourceLocalRows[row]
    let patternSourceLocalRow =
        snapshot.typedNodes.bindingPatternSourceLocalRows[row]
    let valueDefinitionRow =
        snapshot.typedNodes.bindingValueDefinitionRows[row]
    let opKind = snapshot.typedNodes.opKinds[row]
    let originParserNodeId =
        snapshot.typedNodes.originParserNodeIds[row]
    if producerSourceIndex == -1 &&
       parserSourceLocalNodeRow == -1 &&
       declarationSourceLocalRow == -1 &&
       patternSourceLocalRow == -1 &&
       valueDefinitionRow == -1:
        if originParserNodeId >= 0 &&
           (opKind == CsgCompilerTypedOpParamRef ||
            opKind == CsgCompilerTypedOpLocalRef):
            err = " csg compiler snapshot: source-backed reference binding identity missing"
            return false
        return true
    if (opKind != CsgCompilerTypedOpParamRef &&
        opKind != CsgCompilerTypedOpLocalRef) ||
       producerSourceIndex < 0 ||
       parserSourceLocalNodeRow < 0 ||
       declarationSourceLocalRow < 0 ||
       !csgCompilerIndexValid(
           originParserNodeId, snapshot.parserNodes.sourceIds.len):
        err = " csg compiler snapshot: invalid typed-node binding identity"
        return false
    let functionId = snapshot.typedNodes.functionIds[row]
    if !csgCompilerIndexValid(
           functionId, snapshot.functions.symbolIds.len):
        err = " csg compiler snapshot: typed-node binding owner missing"
        return false
    let symbolId = snapshot.functions.symbolIds[functionId]
    if !csgCompilerIndexValid(symbolId, snapshot.symbols.sourceIds.len):
        err = " csg compiler snapshot: typed-node binding source missing"
        return false
    let sourceId = snapshot.symbols.sourceIds[symbolId]
    if producerSourceIndex >=
           reverse.sourceIdsByProducerSourceIndex.len ||
       sourceId < 0 ||
       sourceId >= reverse.declarationCountsBySourceId.len ||
       reverse.sourceIdsByProducerSourceIndex[producerSourceIndex] !=
           sourceId ||
       snapshot.parserNodes.sourceIds[originParserNodeId] != sourceId ||
       snapshot.parserNodes.producerNodeIds[originParserNodeId] !=
           parserSourceLocalNodeRow:
        err = " csg compiler snapshot: typed-node parser source-local binding drift"
        return false
    if declarationSourceLocalRow >=
           reverse.declarationCountsBySourceId[sourceId]:
        err = " csg compiler snapshot: binding declaration identity missing"
        return false
    let declarationRow =
        reverse.declarationStartsBySourceId[sourceId] +
            declarationSourceLocalRow
    let parserFunctionRow =
        reverse.parserFunctionRowsByFunctionId[functionId]
    if opKind == CsgCompilerTypedOpParamRef:
        if snapshot.parserNodes.bindingResolutionKinds[
               originParserNodeId] !=
               CsgCompilerParserBindingResolutionParameter ||
           snapshot.parserNodes.bindingDeclarationSourceLocalRows[
               originParserNodeId] != declarationSourceLocalRow ||
           snapshot.parserNodes.bindingPatternSourceLocalRows[
               originParserNodeId] != -1 ||
           snapshot.parserSidecars.declarationKinds[declarationRow] !=
               CsgCompilerParserDeclarationParameter ||
           snapshot.parserSidecars.declarationFunctionRows[
               declarationRow] != parserFunctionRow ||
           patternSourceLocalRow != -1 ||
           !csgCompilerIndexValid(
               valueDefinitionRow,
               snapshot.valueDefinitions.originKinds.len) ||
           valueDefinitionRow >=
               snapshot.valueDefinitions.functionIds.len ||
           valueDefinitionRow >=
               snapshot.valueDefinitions.declarationSourceLocalRows.len ||
           snapshot.valueDefinitions.originKinds[valueDefinitionRow] !=
               CsgCompilerValueDefinitionOriginParameter ||
           snapshot.valueDefinitions.functionIds[valueDefinitionRow] !=
               functionId ||
           snapshot.valueDefinitions.declarationSourceLocalRows[
               valueDefinitionRow] != declarationSourceLocalRow:
            err = " csg compiler snapshot: parameter binding identity invalid"
            return false
        return true
    if snapshot.parserNodes.bindingResolutionKinds[
           originParserNodeId] !=
           CsgCompilerParserBindingResolutionPattern ||
       snapshot.parserNodes.bindingDeclarationSourceLocalRows[
           originParserNodeId] != declarationSourceLocalRow ||
       snapshot.parserNodes.bindingPatternSourceLocalRows[
           originParserNodeId] != patternSourceLocalRow ||
       snapshot.parserSidecars.declarationKinds[declarationRow] !=
           CsgCompilerParserDeclarationLocal ||
       snapshot.parserSidecars.declarationFunctionRows[
           declarationRow] != parserFunctionRow ||
       patternSourceLocalRow < 0 ||
       valueDefinitionRow < 0:
        err = " csg compiler snapshot: local binding identity invalid"
        return false
    if patternSourceLocalRow >=
           reverse.patternCountsBySourceId[sourceId]:
        err = " csg compiler snapshot: local Pattern identity missing"
        return false
    let patternRow =
        reverse.patternStartsBySourceId[sourceId] +
            patternSourceLocalRow
    if valueDefinitionRow >=
           snapshot.valueDefinitions.producerSourceIndexes.len ||
       snapshot.parserSidecars.patternBindingDeclarationIds[patternRow] !=
           declarationRow ||
       snapshot.valueDefinitions.producerSourceIndexes[valueDefinitionRow] !=
           producerSourceIndex ||
       snapshot.valueDefinitions.declarationSourceLocalRows[
           valueDefinitionRow] != declarationSourceLocalRow ||
       snapshot.valueDefinitions.patternSourceLocalRows[
           valueDefinitionRow] != patternSourceLocalRow ||
       snapshot.valueDefinitions.functionIds[valueDefinitionRow] !=
           functionId ||
       snapshot.valueDefinitions.typeIds[valueDefinitionRow] !=
           snapshot.typedNodes.typeIds[row]:
        err = " csg compiler snapshot: local Pattern/declaration binding drift"
        return false
    return true

@borrows
fn csgCompilerTypedNodeBindingAuthorityValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        requireCompleteProof: bool,
        err: var str): bool =
    let count = snapshot.typedNodes.functionIds.len
    if count != snapshot.typedNodes.bindingProducerSourceIndexes.len ||
       count !=
           snapshot.typedNodes.bindingParserSourceLocalNodeRows.len ||
       count !=
           snapshot.typedNodes.bindingDeclarationSourceLocalRows.len ||
       count != snapshot.typedNodes.bindingPatternSourceLocalRows.len ||
       count != snapshot.typedNodes.bindingValueDefinitionRows.len ||
       count != snapshot.typedNodes.producedValueDefinitionRows.len ||
       count != snapshot.typedNodes.ownerStatementIds.len ||
       count != snapshot.typedNodes.originParserNodeIds.len ||
       count != snapshot.typedNodes.opKinds.len ||
       count != snapshot.typedNodes.typeIds.len ||
       count != snapshot.typedNodes.ownershipKinds.len ||
       snapshot.parserNodes.sourceIds.len !=
           snapshot.parserNodes.producerNodeIds.len ||
       snapshot.parserNodes.sourceIds.len !=
           snapshot.parserNodes.bindingResolutionKinds.len ||
       snapshot.parserNodes.sourceIds.len !=
           snapshot.parserNodes.bindingDeclarationSourceLocalRows.len ||
       snapshot.parserNodes.sourceIds.len !=
           snapshot.parserNodes.bindingPatternSourceLocalRows.len ||
       snapshot.types.typeCids.len != snapshot.types.managedFlags.len:
        err = " csg compiler snapshot: binding authority columns mismatch"
        return false
    var reverse: csgCompilerBindingReverseIndex
    if !csgCompilerBindingReverseIndexBuildInto(
           snapshot, reverse, err) ||
       !csgCompilerValueDefinitionGroupsValidateInto(
           snapshot, reverse, err) ||
       !csgCompilerValueDefinitionsValidateInto(
           snapshot, reverse, requireCompleteProof, err):
        return false
    for row in 0..<count:
        if !csgCompilerTypedNodeBindingIdentityValidateInto(
               snapshot, reverse, row, err):
            return false
    return true

@borrows
fn CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    return csgCompilerTypedNodeBindingAuthorityValidateInto(
        snapshot, true, err)

@borrows
fn csgCompilerTypedStatementsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let statementCount =
        snapshot.typedStatements.typedIrStatementIndexes.len
    if statementCount != snapshot.typedStatements.functionIds.len ||
       statementCount != snapshot.typedStatements.rootStarts.len ||
       statementCount != snapshot.typedStatements.rootCounts.len:
        err = " csg compiler snapshot: typed-statement columns mismatch"
        return false
    var producerStatementSeen: int32[]
    setLen(producerStatementSeen, statementCount)
    var rootCursor: int32
    for statementId in 0..<statementCount:
        let producerStatementIndex =
            snapshot.typedStatements.typedIrStatementIndexes[
                statementId]
        let functionId =
            snapshot.typedStatements.functionIds[statementId]
        let rootStart =
            snapshot.typedStatements.rootStarts[statementId]
        let rootCount =
            snapshot.typedStatements.rootCounts[statementId]
        if !csgCompilerIndexValid(
               producerStatementIndex, statementCount) ||
           producerStatementSeen[producerStatementIndex] != 0 ||
           !csgCompilerIndexValid(
               functionId, snapshot.functions.symbolIds.len) ||
           rootStart != rootCursor ||
           rootCount < 0 ||
           rootCount >
               snapshot.typedStatements.rootTypedNodeIds.len -
                   rootStart:
            err = " csg compiler snapshot: typed-statement row invalid"
            seqs.FreeSeq(producerStatementSeen)
            return false
        producerStatementSeen[producerStatementIndex] = 1
        for rootOffset in 0..<rootCount:
            let rootTypedNodeId =
                snapshot.typedStatements.rootTypedNodeIds[
                    rootStart + rootOffset]
            if !csgCompilerIndexValid(
                   rootTypedNodeId,
                   snapshot.typedNodes.functionIds.len) ||
               snapshot.typedNodes.functionIds[rootTypedNodeId] !=
                   functionId ||
               rootTypedNodeId >=
                   snapshot.typedNodes.ownerStatementIds.len ||
               snapshot.typedNodes.ownerStatementIds[
                   rootTypedNodeId] != statementId:
                err = " csg compiler snapshot: typed-statement root edge invalid"
                seqs.FreeSeq(producerStatementSeen)
                return false
            for previousOffset in 0..<rootOffset:
                if snapshot.typedStatements.rootTypedNodeIds[
                       rootStart + previousOffset] ==
                       rootTypedNodeId:
                    err = " csg compiler snapshot: typed-statement root duplicated"
                    seqs.FreeSeq(producerStatementSeen)
                    return false
        rootCursor = rootCursor + rootCount
    if rootCursor != snapshot.typedStatements.rootTypedNodeIds.len:
        err = " csg compiler snapshot: typed-statement root CSR incomplete"
        seqs.FreeSeq(producerStatementSeen)
        return false
    seqs.FreeSeq(producerStatementSeen)
    return true

@borrows
fn CsgCompilerTypedStatementOwnerAuthorityStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let nodeCount = snapshot.typedNodes.functionIds.len
    if nodeCount != snapshot.typedNodes.ownerStatementIds.len ||
       nodeCount != snapshot.typedNodes.operand0NodeIds.len ||
       nodeCount != snapshot.typedNodes.operand1NodeIds.len ||
       nodeCount != snapshot.typedNodes.operand2NodeIds.len ||
       !csgCompilerTypedStatementsValidateInto(snapshot, err):
        if err == "":
            err = " csg compiler snapshot: typed owner-statement columns mismatch"
        return false
    var rootObserved: bool[]
    var hasParentWithinOwner: bool[]
    setLen(rootObserved, nodeCount)
    setLen(hasParentWithinOwner, nodeCount)
    for rootTypedNodeId in snapshot.typedStatements.rootTypedNodeIds:
        rootObserved[rootTypedNodeId] = true
    for nodeId in 0..<nodeCount:
        let functionId = snapshot.typedNodes.functionIds[nodeId]
        let ownerStatementId =
            snapshot.typedNodes.ownerStatementIds[nodeId]
        if !csgCompilerIndexValid(
               functionId, snapshot.functions.symbolIds.len) ||
           !csgCompilerOptionalIndexValid(
               ownerStatementId,
               snapshot.typedStatements.functionIds.len) ||
           (ownerStatementId >= 0 &&
            snapshot.typedStatements.functionIds[ownerStatementId] !=
                functionId):
            err = " csg compiler snapshot: typed node owner statement invalid"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
        let operand0 = snapshot.typedNodes.operand0NodeIds[nodeId]
        let operand1 = snapshot.typedNodes.operand1NodeIds[nodeId]
        let operand2 = snapshot.typedNodes.operand2NodeIds[nodeId]
        if (operand0 != -1 &&
            (operand0 < 0 || operand0 >= nodeId ||
             snapshot.typedNodes.functionIds[operand0] != functionId ||
             snapshot.typedNodes.ownerStatementIds[operand0] !=
                 ownerStatementId)) ||
           (operand1 != -1 &&
            (operand1 < 0 || operand1 >= nodeId ||
             snapshot.typedNodes.functionIds[operand1] != functionId ||
             snapshot.typedNodes.ownerStatementIds[operand1] !=
                 ownerStatementId)) ||
           (operand2 != -1 &&
            (operand2 < 0 || operand2 >= nodeId ||
             snapshot.typedNodes.functionIds[operand2] != functionId ||
             snapshot.typedNodes.ownerStatementIds[operand2] !=
                 ownerStatementId)):
            err = " csg compiler snapshot: typed node owner operand invalid"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
        if operand0 >= 0:
            hasParentWithinOwner[operand0] = true
        if operand1 >= 0:
            hasParentWithinOwner[operand1] = true
        if operand2 >= 0:
            hasParentWithinOwner[operand2] = true
    for nodeId in 0..<nodeCount:
        if snapshot.typedNodes.ownerStatementIds[nodeId] >= 0 &&
           !rootObserved[nodeId] &&
           !hasParentWithinOwner[nodeId]:
            err = " csg compiler snapshot: typed node disconnected from owner statement"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
    seqs.FreeSeq(rootObserved)
    seqs.FreeSeq(hasParentWithinOwner)
    err = ""
    return true

@borrows
fn csgCompilerTypedNodesValidateInto(snapshot: CsgCompilerSnapshotTables,
                                     requireCompleteProof: bool,
                                     err: var str): bool =
    let count = snapshot.typedNodes.functionIds.len
    if count != snapshot.typedNodes.typedIrNodeIndexes.len ||
       count != snapshot.typedNodes.bindingProducerSourceIndexes.len ||
       count !=
           snapshot.typedNodes.bindingParserSourceLocalNodeRows.len ||
       count !=
           snapshot.typedNodes.bindingDeclarationSourceLocalRows.len ||
       count != snapshot.typedNodes.bindingPatternSourceLocalRows.len ||
       count != snapshot.typedNodes.bindingValueDefinitionRows.len ||
       count != snapshot.typedNodes.ownerStatementIds.len ||
       count != snapshot.typedNodes.originParserNodeIds.len ||
       count != snapshot.typedNodes.syntheticOriginKinds.len ||
       count != snapshot.typedNodes.spanAuthorityKinds.len ||
       count != snapshot.typedNodes.opKinds.len ||
       count != snapshot.typedNodes.typeIds.len ||
       count != snapshot.typedNodes.valueKinds.len ||
       count != snapshot.typedNodes.captureStarts.len ||
       count != snapshot.typedNodes.captureCounts.len ||
       count != snapshot.typedNodes.ownershipKinds.len ||
       count != snapshot.typedNodes.ownershipProofKinds.len ||
       count != snapshot.typedNodes.ownershipProofCids.len ||
       count != snapshot.typedNodes.sendConclusions.len ||
       count != snapshot.typedNodes.sendProofKinds.len ||
       count != snapshot.typedNodes.sendProofCids.len ||
       count != snapshot.typedNodes.syncProofKinds.len ||
       count != snapshot.typedNodes.syncProofCids.len ||
       count != snapshot.typedNodes.syncConclusions.len ||
       count != snapshot.typedNodes.shareKinds.len ||
       count != snapshot.typedNodes.shareProofCids.len ||
       count != snapshot.typedNodes.spanIds.len ||
       count != snapshot.typedNodes.operand0NodeIds.len ||
       count != snapshot.typedNodes.operand1NodeIds.len ||
       count != snapshot.typedNodes.operand2NodeIds.len:
        err = " csg compiler snapshot: typed-node columns mismatch"
        return false
    if !csgCompilerTypedStatementsValidateInto(snapshot, err):
        return false
    if !csgCompilerTypedNodeBindingAuthorityValidateInto(
           snapshot, requireCompleteProof, err):
        return false
    var typedIrNodeSeen: int32[]
    setLen(typedIrNodeSeen, count)
    var ownerRootObserved: bool[]
    var ownerHasParent: bool[]
    setLen(ownerRootObserved, count)
    setLen(ownerHasParent, count)
    for rootTypedNodeId in
            snapshot.typedStatements.rootTypedNodeIds:
        ownerRootObserved[rootTypedNodeId] = true
    var captureCursor: int32
    for row in 0..<count:
        let typedIrNodeIndex = snapshot.typedNodes.typedIrNodeIndexes[row]
        let originParserNodeId =
            snapshot.typedNodes.originParserNodeIds[row]
        let syntheticOriginKind =
            snapshot.typedNodes.syntheticOriginKinds[row]
        let spanAuthorityKind =
            snapshot.typedNodes.spanAuthorityKinds[row]
        let function = snapshot.typedNodes.functionIds[row]
        let span = snapshot.typedNodes.spanIds[row]
        let sendProofKind = snapshot.typedNodes.sendProofKinds[row]
        let ownershipProofKind =
            snapshot.typedNodes.ownershipProofKinds[row]
        let ownershipProofObserved = csgCompilerCidObserved(
            snapshot.typedNodes.ownershipProofCids[row])
        let sendProofObserved = csgCompilerCidObserved(
            snapshot.typedNodes.sendProofCids[row])
        let syncProofKind = snapshot.typedNodes.syncProofKinds[row]
        let syncProofObserved = csgCompilerCidObserved(
            snapshot.typedNodes.syncProofCids[row])
        let shareKind = snapshot.typedNodes.shareKinds[row]
        let shareProofObserved = csgCompilerCidObserved(
            snapshot.typedNodes.shareProofCids[row])
        let producedValueDefinitionRow =
            snapshot.typedNodes.producedValueDefinitionRows[row]
        let ownerStatementId =
            snapshot.typedNodes.ownerStatementIds[row]
        if !csgCompilerIndexValid(typedIrNodeIndex, count) ||
           typedIrNodeSeen[typedIrNodeIndex] != 0 ||
           !csgCompilerIndexValid(function,
                                   snapshot.functions.symbolIds.len) ||
           !((originParserNodeId >= 0 &&
              originParserNodeId < snapshot.parserNodes.sourceIds.len &&
              snapshot.parserNodes.sourceIds[originParserNodeId] ==
                  snapshot.symbols.sourceIds[
                      snapshot.functions.symbolIds[function]] &&
              syntheticOriginKind == 0 &&
              spanAuthorityKind == 1 &&
              csgCompilerIndexValid(span,
                                    snapshot.spans.sourceIds.len) &&
              snapshot.parserNodes.spanIds[originParserNodeId] == span) ||
             (originParserNodeId == -1 && syntheticOriginKind > 0 &&
              syntheticOriginKind <= 5 &&
              spanAuthorityKind == 2 && span == -1)) ||
           snapshot.typedNodes.opKinds[row] <= 0 ||
           (requireCompleteProof &&
            !csgCompilerIndexValid(snapshot.typedNodes.typeIds[row],
                                   snapshot.types.typeCids.len)) ||
           (!requireCompleteProof &&
            !csgCompilerOptionalIndexValid(
                snapshot.typedNodes.typeIds[row],
                snapshot.types.typeCids.len)) ||
           !csgCompilerOwnershipKindValid(
               snapshot.typedNodes.ownershipKinds[row]) ||
           !csgCompilerOptionalIndexValid(
               ownerStatementId,
               snapshot.typedStatements.functionIds.len) ||
           (ownerStatementId >= 0 &&
            snapshot.typedStatements.functionIds[
                ownerStatementId] != function) ||
           !csgCompilerOptionalIndexValid(
               producedValueDefinitionRow,
               snapshot.valueDefinitions.functionIds.len) ||
           (producedValueDefinitionRow >= 0 &&
            (producedValueDefinitionRow >=
                 snapshot.valueDefinitions.definingTypedNodeIds.len ||
             snapshot.valueDefinitions.definingTypedNodeIds[
                 producedValueDefinitionRow] != row ||
             snapshot.valueDefinitions.functionIds[
                 producedValueDefinitionRow] != function)) ||
           snapshot.typedNodes.captureStarts[row] != captureCursor ||
           snapshot.typedNodes.captureCounts[row] < 0 ||
           snapshot.typedNodes.captureCounts[row] >
               snapshot.typedNodes.captureValueDefinitionRows.len -
                   captureCursor ||
           snapshot.typedNodes.captureValueDefinitionRows.len !=
               snapshot.typedNodes.captureTypeIds.len ||
           snapshot.typedNodes.captureValueDefinitionRows.len !=
               snapshot.typedNodes.captureOwnershipKinds.len ||
           !((ownershipProofKind == 0 && !ownershipProofObserved) ||
             csgCompilerValueProofKindValid(ownershipProofKind)) ||
           !((sendProofKind == 0 && !sendProofObserved) ||
             csgCompilerValueProofKindValid(sendProofKind)) ||
           !((syncProofKind == 0 && !syncProofObserved) ||
             csgCompilerValueProofKindValid(syncProofKind)) ||
           !((shareKind == 0 && !shareProofObserved) ||
             csgCompilerShareKindValid(shareKind)) ||
           (requireCompleteProof &&
            (snapshot.typedNodes.valueKinds[row] == 0 ||
             ownershipProofKind == 0 || sendProofKind == 0 ||
             syncProofKind == 0 || shareKind == 0)) ||
           (!requireCompleteProof &&
            ((snapshot.typedNodes.valueKinds[row] != 0 &&
              !csgCompilerValueKindValid(
                  snapshot.typedNodes.valueKinds[row])) ||
             (sendProofKind == 0 &&
              snapshot.typedNodes.sendConclusions[row]) ||
             (syncProofKind == 0 &&
              snapshot.typedNodes.syncConclusions[row]))) ||
           (span >= 0 && snapshot.spans.sourceIds[span] !=
               snapshot.symbols.sourceIds[
                   snapshot.functions.symbolIds[function]]):
            err = " csg compiler snapshot: invalid typed-node row"
            return false
        for offset in 0..<snapshot.typedNodes.captureCounts[row]:
            let captureRow = captureCursor + offset
            let captureValueDefinitionRow =
                snapshot.typedNodes.captureValueDefinitionRows[captureRow]
            let captureTypeId = snapshot.typedNodes.captureTypeIds[captureRow]
            let captureOwnershipKind =
                snapshot.typedNodes.captureOwnershipKinds[captureRow]
            if captureValueDefinitionRow < 0 ||
               !csgCompilerIndexValid(
                   captureTypeId, snapshot.types.typeCids.len) ||
               !csgCompilerOwnershipKindValid(captureOwnershipKind):
                err = " csg compiler snapshot: invalid closure capture premise"
                return false
        captureCursor = captureCursor +
            snapshot.typedNodes.captureCounts[row]
        typedIrNodeSeen[typedIrNodeIndex] = 1
        let functionStart = snapshot.functions.nodeStarts[function]
        if row > functionStart &&
           typedIrNodeIndex !=
               snapshot.typedNodes.typedIrNodeIndexes[row - 1] + 1:
            err = " csg compiler snapshot: typed-node producer indexes are not contiguous"
            return false
        let operand0 = snapshot.typedNodes.operand0NodeIds[row]
        let operand1 = snapshot.typedNodes.operand1NodeIds[row]
        let operand2 = snapshot.typedNodes.operand2NodeIds[row]
        if (operand0 != -1 &&
            (operand0 < functionStart || operand0 >= row ||
             snapshot.typedNodes.functionIds[operand0] != function ||
             snapshot.typedNodes.ownerStatementIds[operand0] !=
                 ownerStatementId)) ||
           (operand1 != -1 &&
            (operand1 < functionStart || operand1 >= row ||
             snapshot.typedNodes.functionIds[operand1] != function ||
             snapshot.typedNodes.ownerStatementIds[operand1] !=
                 ownerStatementId)) ||
           (operand2 != -1 &&
            (operand2 < functionStart || operand2 >= row ||
             snapshot.typedNodes.functionIds[operand2] != function ||
             snapshot.typedNodes.ownerStatementIds[operand2] !=
                 ownerStatementId)):
            err = " csg compiler snapshot: invalid typed-node operand"
            return false
        if operand0 >= 0:
            ownerHasParent[operand0] = true
        if operand1 >= 0:
            ownerHasParent[operand1] = true
        if operand2 >= 0:
            ownerHasParent[operand2] = true
        if requireCompleteProof || ownershipProofObserved ||
           sendProofObserved || syncProofObserved ||
           shareProofObserved:
            var expectedSendProofCid: layout.FixedBytes32
            var expectedSyncProofCid: layout.FixedBytes32
            var expectedShareProofCid: layout.FixedBytes32
            var expectedOwnershipProofCid: layout.FixedBytes32
            if (ownershipProofObserved &&
                (!CsgCompilerTypedNodeOwnershipProofCidInto(
                     snapshot, row, expectedOwnershipProofCid, err) ||
                 !layout.FixedBytes32Equal(
                     expectedOwnershipProofCid,
                     snapshot.typedNodes.ownershipProofCids[row]))) ||
               (sendProofObserved &&
                (!CsgCompilerTypedNodeSendProofCidInto(
                     snapshot, row, expectedSendProofCid, err) ||
                 !layout.FixedBytes32Equal(
                     expectedSendProofCid,
                     snapshot.typedNodes.sendProofCids[row]))) ||
               (syncProofObserved &&
                (!CsgCompilerTypedNodeSyncProofCidInto(
                     snapshot, row, expectedSyncProofCid, err) ||
                 !layout.FixedBytes32Equal(
                     expectedSyncProofCid,
                     snapshot.typedNodes.syncProofCids[row]))) ||
               (shareProofObserved &&
                (!CsgCompilerTypedNodeShareProofCidInto(
                     snapshot, row, expectedShareProofCid, err) ||
                 !layout.FixedBytes32Equal(
                     expectedShareProofCid,
                     snapshot.typedNodes.shareProofCids[row]))) ||
               (requireCompleteProof &&
                (!ownershipProofObserved || !sendProofObserved ||
                 !syncProofObserved || !shareProofObserved)):
                if err == "":
                    err = " csg compiler snapshot: value proof CID mismatch"
                return false
    if captureCursor !=
           snapshot.typedNodes.captureValueDefinitionRows.len:
        err = " csg compiler snapshot: closure capture coverage mismatch"
        return false
    for row in 0..<count:
        if snapshot.typedNodes.ownerStatementIds[row] >= 0 &&
           !ownerRootObserved[row] &&
           !ownerHasParent[row]:
            err = " csg compiler snapshot: typed node disconnected from owner statement roots"
            return false
    for typedIrNodeIndex in 0..<typedIrNodeSeen.len:
        if typedIrNodeSeen[typedIrNodeIndex] != 1:
            err = " csg compiler snapshot: typed-node producer coverage mismatch"
            return false
    if requireCompleteProof:
        var expectedFragmentCids: layout.FixedBytes32[]
        if !CsgCompilerFunctionFragmentCidsInto(
               snapshot, expectedFragmentCids, err):
            return false
        for functionId in 0..<snapshot.functions.symbolIds.len:
            if !layout.FixedBytes32Equal(
                   expectedFragmentCids[functionId],
                   snapshot.functions.fragmentCids[functionId]):
                err = " csg compiler snapshot: function fragment CID mismatch"
                return false
    return true

@borrows
fn CsgCompilerSourceInterfaceCidsInto(
        snapshot: CsgCompilerSnapshotTables,
        out: var layout.FixedBytes32[],
        err: var str): bool =
    err = ""
    out = []
    let sourceCount = snapshot.sources.documentCids.len
    let symbolCount = snapshot.symbols.symbolCids.len
    let dependencyCount = snapshot.dependencies.sourceIds.len
    if sourceCount <= 0 ||
       symbolCount != snapshot.symbols.interfaceCids.len ||
       symbolCount != snapshot.symbols.sourceIds.len ||
       symbolCount != snapshot.symbols.symbolKinds.len ||
       symbolCount != snapshot.symbols.exportedFlags.len ||
       dependencyCount != snapshot.dependencies.targetSourceIds.len ||
       dependencyCount != snapshot.dependencies.dependencyKinds.len ||
       dependencyCount != snapshot.dependencies.observedInterfaceCids.len:
        err = " csg compiler snapshot: source interface batch shape invalid"
        return false
    var exportStarts: int32[]
    var exportCounts: int32[]
    var exportCursors: int32[]
    var dependencyStarts: int32[]
    var dependencyCounts: int32[]
    setLen(exportStarts, sourceCount)
    setLen(exportCounts, sourceCount)
    setLen(exportCursors, sourceCount)
    setLen(dependencyStarts, sourceCount)
    setLen(dependencyCounts, sourceCount)
    for sourceId in 0..<sourceCount:
        dependencyStarts[sourceId] = -1
        if !csgCompilerCidObserved(snapshot.sources.documentCids[sourceId]):
            err = " csg compiler snapshot: source interface document missing"
            return false
    var exportedSymbolCount: int32
    for symbolId in 0..<symbolCount:
        let sourceId = snapshot.symbols.sourceIds[symbolId]
        if !csgCompilerIndexValid(sourceId, sourceCount):
            err = " csg compiler snapshot: source interface symbol source invalid"
            return false
        if snapshot.symbols.exportedFlags[symbolId]:
            exportCounts[sourceId] = exportCounts[sourceId] + 1
            exportedSymbolCount = exportedSymbolCount + 1
    var exportCursor: int32
    for sourceId in 0..<sourceCount:
        exportStarts[sourceId] = exportCursor
        exportCursors[sourceId] = exportCursor
        exportCursor = exportCursor + exportCounts[sourceId]
    var exportedSymbolIds: int32[]
    setLen(exportedSymbolIds, exportedSymbolCount)
    for symbolId in 0..<symbolCount:
        if !snapshot.symbols.exportedFlags[symbolId]:
            continue
        let sourceId = snapshot.symbols.sourceIds[symbolId]
        exportedSymbolIds[exportCursors[sourceId]] = symbolId
        exportCursors[sourceId] = exportCursors[sourceId] + 1
    var previousDependencySource: int32 = -1
    for dependencyId in 0..<dependencyCount:
        let sourceId = snapshot.dependencies.sourceIds[dependencyId]
        let targetSourceId =
            snapshot.dependencies.targetSourceIds[dependencyId]
        if !csgCompilerIndexValid(sourceId, sourceCount) ||
           !csgCompilerIndexValid(targetSourceId, sourceCount) ||
           sourceId < previousDependencySource:
            err = " csg compiler snapshot: source interface dependency order invalid"
            return false
        if dependencyStarts[sourceId] < 0:
            dependencyStarts[sourceId] = dependencyId
        dependencyCounts[sourceId] = dependencyCounts[sourceId] + 1
        previousDependencySource = sourceId
    for sourceId in 0..<sourceCount:
        var buf = layout.ByteBufInit(384)
        csgCompilerTypeCidAppendText(
            buf, "cheng.csg_compiler.source_interface")
        layout.ByteBufAppendFixed32(
            buf, snapshot.sources.documentCids[sourceId])
        csgCompilerTypeCidAppendU32(buf, exportCounts[sourceId])
        for offset in 0..<exportCounts[sourceId]:
            let symbolId =
                exportedSymbolIds[exportStarts[sourceId] + offset]
            if !csgCompilerCidObserved(
                   snapshot.symbols.symbolCids[symbolId]) ||
               !csgCompilerCidObserved(
                   snapshot.symbols.interfaceCids[symbolId]):
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: exported interface authority missing"
                return false
            layout.ByteBufAppendFixed32(
                buf, snapshot.symbols.symbolCids[symbolId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.symbols.interfaceCids[symbolId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.symbols.symbolKinds[symbolId])
        csgCompilerTypeCidAppendU32(buf, dependencyCounts[sourceId])
        let dependencyStart = dependencyStarts[sourceId]
        for offset in 0..<dependencyCounts[sourceId]:
            let dependencyId = dependencyStart + offset
            let targetSourceId =
                snapshot.dependencies.targetSourceIds[dependencyId]
            if !csgCompilerCidObserved(
                   snapshot.dependencies.observedInterfaceCids[
                       dependencyId]) ||
               !layout.FixedBytes32Equal(
                   snapshot.dependencies.observedInterfaceCids[
                       dependencyId],
                   snapshot.sources.interfaceCids[targetSourceId]) ||
               snapshot.dependencies.dependencyKinds[dependencyId] <= 0:
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: imported interface authority missing"
                return false
            layout.ByteBufAppendFixed32(
                buf, snapshot.sources.documentCids[targetSourceId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.dependencies.observedInterfaceCids[
                    dependencyId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.dependencies.dependencyKinds[dependencyId])
        add(out, hash256.Sha256Fixed(layout.ByteBufView(buf)))
        layout.ByteBufFree(buf)
    return true

# Builds the source-interface DAG only after every Symbol interface is
# canonical. Import targets are processed before their owners; caller seeds
# and stale observed-interface rows are ignored. All output stays local until
# the complete acyclic graph succeeds.
@borrows
fn CsgCompilerSourceInterfacesBuildInto(
        snapshot: CsgCompilerSnapshotTables,
        nextSourceInterfaceCids: var layout.FixedBytes32[],
        nextObservedInterfaceCids: var layout.FixedBytes32[],
        err: var str): bool =
    err = ""
    nextSourceInterfaceCids = []
    nextObservedInterfaceCids = []
    let sourceCount = snapshot.sources.documentCids.len
    let symbolCount = snapshot.symbols.symbolCids.len
    let dependencyCount = snapshot.dependencies.sourceIds.len
    if sourceCount <= 0 ||
       sourceCount != snapshot.sources.interfaceCids.len ||
       symbolCount != snapshot.symbols.interfaceCids.len ||
       symbolCount != snapshot.symbols.sourceIds.len ||
       symbolCount != snapshot.symbols.symbolKinds.len ||
       symbolCount != snapshot.symbols.exportedFlags.len ||
       dependencyCount != snapshot.dependencies.targetSourceIds.len ||
       dependencyCount != snapshot.dependencies.dependencyKinds.len ||
       dependencyCount !=
           snapshot.dependencies.observedInterfaceCids.len:
        err = " csg compiler snapshot: source interface finalization shape invalid"
        return false

    var exportStarts: int32[]
    var exportCounts: int32[]
    var exportCursors: int32[]
    var dependencyStarts: int32[]
    var dependencyCounts: int32[]
    var remainingDependencyCounts: int32[]
    var incomingStarts: int32[]
    var incomingCounts: int32[]
    var incomingCursors: int32[]
    var completed: bool[]
    setLen(exportStarts, sourceCount)
    setLen(exportCounts, sourceCount)
    setLen(exportCursors, sourceCount)
    setLen(dependencyStarts, sourceCount)
    setLen(dependencyCounts, sourceCount)
    setLen(remainingDependencyCounts, sourceCount)
    setLen(incomingStarts, sourceCount)
    setLen(incomingCounts, sourceCount)
    setLen(incomingCursors, sourceCount)
    setLen(completed, sourceCount)
    for sourceId in 0..<sourceCount:
        dependencyStarts[sourceId] = -1
        if !csgCompilerCidObserved(
               snapshot.sources.documentCids[sourceId]):
            err = " csg compiler snapshot: source interface document missing"
            return false

    var exportedSymbolCount: int32
    for symbolId in 0..<symbolCount:
        let sourceId = snapshot.symbols.sourceIds[symbolId]
        if !csgCompilerIndexValid(sourceId, sourceCount):
            err = " csg compiler snapshot: source interface symbol source invalid"
            return false
        if snapshot.symbols.exportedFlags[symbolId]:
            if !csgCompilerCidObserved(
                   snapshot.symbols.symbolCids[symbolId]) ||
               !csgCompilerCidObserved(
                   snapshot.symbols.interfaceCids[symbolId]):
                err = " csg compiler snapshot: exported interface authority missing"
                return false
            exportCounts[sourceId] = exportCounts[sourceId] + 1
            exportedSymbolCount = exportedSymbolCount + 1
    var exportCursor: int32
    for sourceId in 0..<sourceCount:
        exportStarts[sourceId] = exportCursor
        exportCursors[sourceId] = exportCursor
        exportCursor = exportCursor + exportCounts[sourceId]
    var exportedSymbolIds: int32[]
    setLen(exportedSymbolIds, exportedSymbolCount)
    for symbolId in 0..<symbolCount:
        if snapshot.symbols.exportedFlags[symbolId]:
            let sourceId = snapshot.symbols.sourceIds[symbolId]
            exportedSymbolIds[exportCursors[sourceId]] = symbolId
            exportCursors[sourceId] = exportCursors[sourceId] + 1

    for dependencyId in 0..<dependencyCount:
        let sourceId = snapshot.dependencies.sourceIds[dependencyId]
        let targetSourceId =
            snapshot.dependencies.targetSourceIds[dependencyId]
        let dependencyKind =
            snapshot.dependencies.dependencyKinds[dependencyId]
        if !csgCompilerIndexValid(sourceId, sourceCount) ||
           !csgCompilerIndexValid(targetSourceId, sourceCount) ||
           dependencyKind <= 0:
            err = " csg compiler snapshot: source interface dependency invalid"
            return false
        if dependencyId > 0:
            let previousSourceId =
                snapshot.dependencies.sourceIds[dependencyId - 1]
            let previousTargetSourceId =
                snapshot.dependencies.targetSourceIds[dependencyId - 1]
            if sourceId < previousSourceId ||
               (sourceId == previousSourceId &&
                targetSourceId < previousTargetSourceId) ||
               (sourceId == previousSourceId &&
                targetSourceId == previousTargetSourceId &&
                dependencyKind <=
                    snapshot.dependencies.dependencyKinds[
                        dependencyId - 1]):
                err = " csg compiler snapshot: source interface dependency order invalid"
                return false
        if dependencyStarts[sourceId] < 0:
            dependencyStarts[sourceId] = dependencyId
        dependencyCounts[sourceId] =
            dependencyCounts[sourceId] + 1
        incomingCounts[targetSourceId] =
            incomingCounts[targetSourceId] + 1

    var incomingCursor: int32
    for sourceId in 0..<sourceCount:
        remainingDependencyCounts[sourceId] =
            dependencyCounts[sourceId]
        incomingStarts[sourceId] = incomingCursor
        incomingCursors[sourceId] = incomingCursor
        incomingCursor = incomingCursor + incomingCounts[sourceId]
    var incomingOwnerSourceIds: int32[]
    setLen(incomingOwnerSourceIds, dependencyCount)
    for dependencyId in 0..<dependencyCount:
        let targetSourceId =
            snapshot.dependencies.targetSourceIds[dependencyId]
        incomingOwnerSourceIds[incomingCursors[targetSourceId]] =
            snapshot.dependencies.sourceIds[dependencyId]
        incomingCursors[targetSourceId] =
            incomingCursors[targetSourceId] + 1

    var queue: int32[]
    for sourceId in 0..<sourceCount:
        if remainingDependencyCounts[sourceId] == 0:
            add(queue, sourceId)
    setLen(nextSourceInterfaceCids, sourceCount)
    setLen(nextObservedInterfaceCids, dependencyCount)
    var queueCursor: int32
    var completedCount: int32
    while queueCursor < queue.len:
        let sourceId = queue[queueCursor]
        queueCursor = queueCursor + 1
        if completed[sourceId]:
            err = " csg compiler snapshot: source interface duplicate completion"
            return false
        var buf = layout.ByteBufInit(384)
        csgCompilerTypeCidAppendText(
            buf, "cheng.csg_compiler.source_interface")
        layout.ByteBufAppendFixed32(
            buf, snapshot.sources.documentCids[sourceId])
        csgCompilerTypeCidAppendU32(buf, exportCounts[sourceId])
        for offset in 0..<exportCounts[sourceId]:
            let symbolId =
                exportedSymbolIds[exportStarts[sourceId] + offset]
            layout.ByteBufAppendFixed32(
                buf, snapshot.symbols.symbolCids[symbolId])
            layout.ByteBufAppendFixed32(
                buf, snapshot.symbols.interfaceCids[symbolId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.symbols.symbolKinds[symbolId])
        csgCompilerTypeCidAppendU32(
            buf, dependencyCounts[sourceId])
        let dependencyStart = dependencyStarts[sourceId]
        for offset in 0..<dependencyCounts[sourceId]:
            let dependencyId = dependencyStart + offset
            let targetSourceId =
                snapshot.dependencies.targetSourceIds[dependencyId]
            if !completed[targetSourceId]:
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: source interface target not finalized"
                return false
            nextObservedInterfaceCids[dependencyId] =
                nextSourceInterfaceCids[targetSourceId]
            layout.ByteBufAppendFixed32(
                buf, snapshot.sources.documentCids[targetSourceId])
            layout.ByteBufAppendFixed32(
                buf, nextObservedInterfaceCids[dependencyId])
            csgCompilerTypeCidAppendU32(
                buf, snapshot.dependencies.dependencyKinds[dependencyId])
        nextSourceInterfaceCids[sourceId] =
            hash256.Sha256Fixed(layout.ByteBufView(buf))
        layout.ByteBufFree(buf)
        completed[sourceId] = true
        completedCount = completedCount + 1
        for incomingOffset in 0..<incomingCounts[sourceId]:
            let ownerSourceId =
                incomingOwnerSourceIds[
                    incomingStarts[sourceId] + incomingOffset]
            remainingDependencyCounts[ownerSourceId] =
                remainingDependencyCounts[ownerSourceId] - 1
            if remainingDependencyCounts[ownerSourceId] == 0:
                add(queue, ownerSourceId)
    if completedCount != sourceCount:
        err = " csg compiler snapshot: source interface dependency graph is cyclic"
        return false
    err = ""
    return true

# Public convenience commit. Producers whose snapshot descriptor itself is a
# `var` output must call the build form and commit its scalar rows in their own
# descriptor scope, avoiding a nested composite copy-on-write boundary.
fn CsgCompilerSourceInterfacesFinalizeInto(
        snapshot: var CsgCompilerSnapshotTables,
        err: var str): bool =
    var nextSourceInterfaceCids: layout.FixedBytes32[]
    var nextObservedInterfaceCids: layout.FixedBytes32[]
    if !CsgCompilerSourceInterfacesBuildInto(
           snapshot,
           nextSourceInterfaceCids,
           nextObservedInterfaceCids,
           err):
        return false
    for sourceId in 0..<nextSourceInterfaceCids.len:
        snapshot.sources.interfaceCids[sourceId] =
            nextSourceInterfaceCids[sourceId]
    for dependencyId in 0..<nextObservedInterfaceCids.len:
        snapshot.dependencies.observedInterfaceCids[dependencyId] =
            nextObservedInterfaceCids[dependencyId]
    err = ""
    return true

@borrows
fn csgCompilerDependencyGraphAcyclic(
        snapshot: CsgCompilerSnapshotTables): bool =
    let sourceCount = snapshot.sources.documentCids.len
    var indegrees: int32[]
    var starts: int32[]
    var counts: int32[]
    setLen(indegrees, sourceCount)
    setLen(starts, sourceCount)
    setLen(counts, sourceCount)
    for sourceId in 0..<sourceCount:
        starts[sourceId] = -1
    for row in 0..<snapshot.dependencies.sourceIds.len:
        let sourceId = snapshot.dependencies.sourceIds[row]
        let targetSourceId = snapshot.dependencies.targetSourceIds[row]
        if !csgCompilerIndexValid(sourceId, sourceCount) ||
           !csgCompilerIndexValid(targetSourceId, sourceCount):
            return false
        if starts[sourceId] < 0:
            starts[sourceId] = row
        counts[sourceId] = counts[sourceId] + 1
        indegrees[targetSourceId] = indegrees[targetSourceId] + 1
    var queue: int32[]
    for sourceId in 0..<sourceCount:
        if indegrees[sourceId] == 0:
            add(queue, sourceId)
    var queueCursor: int32
    var visited: int32
    while queueCursor < queue.len:
        let sourceId = queue[queueCursor]
        queueCursor = queueCursor + 1
        visited = visited + 1
        let start = starts[sourceId]
        if start < 0:
            continue
        for offset in 0..<counts[sourceId]:
            let targetSourceId =
                snapshot.dependencies.targetSourceIds[start + offset]
            indegrees[targetSourceId] = indegrees[targetSourceId] - 1
            if indegrees[targetSourceId] == 0:
                add(queue, targetSourceId)
    return visited == sourceCount

@borrows
fn csgCompilerDependenciesValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.dependencies.sourceIds.len
    if count != snapshot.dependencies.targetSourceIds.len ||
       count != snapshot.dependencies.spanIds.len ||
       count != snapshot.dependencies.dependencyKinds.len ||
       count != snapshot.dependencies.observedInterfaceCids.len:
        err = " csg compiler snapshot: dependency columns mismatch"
        return false
    for row in 0..<count:
        let source = snapshot.dependencies.sourceIds[row]
        let target = snapshot.dependencies.targetSourceIds[row]
        let span = snapshot.dependencies.spanIds[row]
        if !csgCompilerIndexValid(source, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(target, snapshot.sources.documentCids.len) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           snapshot.dependencies.dependencyKinds[row] <= 0 ||
           !layout.FixedBytes32Equal(
               snapshot.dependencies.observedInterfaceCids[row],
               snapshot.sources.interfaceCids[target]):
            err = " csg compiler snapshot: invalid dependency row"
            return false
        if row > 0:
            let previousSource = snapshot.dependencies.sourceIds[row - 1]
            let previousTarget = snapshot.dependencies.targetSourceIds[row - 1]
            if source < previousSource ||
               (source == previousSource && target < previousTarget) ||
               (source == previousSource && target == previousTarget &&
                snapshot.dependencies.dependencyKinds[row] <=
                    snapshot.dependencies.dependencyKinds[row - 1]):
                err = " csg compiler snapshot: dependencies are not canonical"
                return false
    if !csgCompilerDependencyGraphAcyclic(snapshot):
        err = " csg compiler snapshot: dependency graph is cyclic"
        return false
    var expectedInterfaceCids: layout.FixedBytes32[]
    if !CsgCompilerSourceInterfaceCidsInto(
           snapshot, expectedInterfaceCids, err):
        return false
    for sourceId in 0..<snapshot.sources.documentCids.len:
        if !layout.FixedBytes32Equal(
               expectedInterfaceCids[sourceId],
               snapshot.sources.interfaceCids[sourceId]):
            err = " csg compiler snapshot: source interface CID mismatch"
            return false
    return true

@borrows
fn CsgCompilerDiagnosticCompletionProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        completionId: int32,
        out: var layout.FixedBytes32,
        diagnosticCount: var int32,
        err: var str): bool =
    out = layout.FixedBytes32()
    diagnosticCount = 0
    if !csgCompilerIndexValid(
           completionId,
           snapshot.diagnosticCompletions.sourceIds.len) ||
       completionId >=
           snapshot.diagnosticCompletions.producerKinds.len ||
       completionId >=
           snapshot.diagnosticCompletions.requiredStarts.len ||
       completionId >=
           snapshot.diagnosticCompletions.requiredCounts.len ||
       completionId >=
           snapshot.diagnosticCompletions.rowStarts.len ||
       completionId >=
           snapshot.diagnosticCompletions.rowCounts.len ||
       completionId >=
           snapshot.diagnosticCompletions.producerReceiptCids.len ||
       !csgCompilerCidObserved(
           snapshot.diagnosticCompletions.requiredDomainCid) ||
       !csgCompilerCidObserved(
           snapshot.diagnosticCompletions.producerReceiptCids[
               completionId]):
        err = " csg compiler snapshot: diagnostic completion domain invalid"
        return false
    let sourceId =
        snapshot.diagnosticCompletions.sourceIds[completionId]
    let producerKind =
        snapshot.diagnosticCompletions.producerKinds[completionId]
    let requiredStart =
        snapshot.diagnosticCompletions.requiredStarts[completionId]
    let requiredCount =
        snapshot.diagnosticCompletions.requiredCounts[completionId]
    if !csgCompilerIndexValid(
           sourceId, snapshot.sources.documentCids.len) ||
       producerKind < CsgCompilerDiagnosticParser ||
       producerKind > CsgCompilerDiagnosticLayout ||
       requiredStart < 0 || requiredCount < 0 ||
       requiredStart >
           snapshot.diagnosticCompletions.requiredProducerIds.len ||
       requiredCount >
           snapshot.diagnosticCompletions.requiredProducerIds.len -
               requiredStart:
        err = " csg compiler snapshot: diagnostic completion CSR invalid"
        return false
    var buf = layout.ByteBufInit(384)
    csgCompilerParserIdentityAppendText(
        buf, "cheng.compiler.snapshot.production_diagnostic_completion")
    layout.ByteBufAppendFixed32(
        buf, snapshot.diagnosticCompletions.requiredDomainCid)
    layout.ByteBufAppendFixed32(
        buf, snapshot.sources.documentCids[sourceId])
    csgCompilerParserIdentityAppendU32(buf, sourceId)
    csgCompilerParserIdentityAppendU32(buf, producerKind)
    layout.ByteBufAppendFixed32(
        buf,
        snapshot.diagnosticCompletions.producerReceiptCids[
            completionId])
    csgCompilerParserIdentityAppendU32(buf, requiredCount)
    for offset in 0..<requiredCount:
        let requiredRow = requiredStart + offset
        if requiredRow >=
               snapshot.diagnosticCompletions.requiredProducerCids.len ||
           requiredRow >=
               snapshot.diagnosticCompletions.requiredResultIds.len ||
           requiredRow >=
               snapshot.diagnosticCompletions.requiredResultCids.len ||
           snapshot.diagnosticCompletions.requiredProducerIds[requiredRow] < 0 ||
           snapshot.diagnosticCompletions.requiredResultIds[requiredRow] < 0 ||
           !csgCompilerCidObserved(
               snapshot.diagnosticCompletions.requiredProducerCids[
                   requiredRow]) ||
           !csgCompilerCidObserved(
               snapshot.diagnosticCompletions.requiredResultCids[
                   requiredRow]):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: diagnostic required row invalid"
            return false
        csgCompilerParserIdentityAppendU32(
            buf,
            snapshot.diagnosticCompletions.requiredProducerIds[requiredRow])
        layout.ByteBufAppendFixed32(
            buf,
            snapshot.diagnosticCompletions.requiredProducerCids[requiredRow])
        csgCompilerParserIdentityAppendU32(
            buf,
            snapshot.diagnosticCompletions.requiredResultIds[requiredRow])
        layout.ByteBufAppendFixed32(
            buf,
            snapshot.diagnosticCompletions.requiredResultCids[requiredRow])
    for diagnosticId in 0..<snapshot.diagnostics.sourceIds.len:
        if snapshot.diagnostics.sourceIds[diagnosticId] !=
               sourceId ||
           snapshot.diagnostics.producerKinds[diagnosticId] !=
               producerKind:
            continue
        diagnosticCount = diagnosticCount + 1
        csgCompilerParserIdentityAppendU32(
            buf, snapshot.diagnostics.spanIds[diagnosticId])
        csgCompilerParserIdentityAppendU32(
            buf, snapshot.diagnostics.severities[diagnosticId])
        csgCompilerParserIdentityAppendU32(
            buf, snapshot.diagnostics.codeTextIds[diagnosticId])
        csgCompilerParserIdentityAppendU32(
            buf, snapshot.diagnostics.messageTextIds[diagnosticId])
        layout.ByteBufAppendFixed32(
            buf, snapshot.diagnostics.proofCids[diagnosticId])
    if diagnosticCount !=
           snapshot.diagnosticCompletions.rowCounts[completionId]:
        layout.ByteBufFree(buf)
        err = " csg compiler snapshot: diagnostic authority/denominator count split"
        return false
    csgCompilerParserIdentityAppendU32(buf, diagnosticCount)
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    if !csgCompilerBorrowedCidObserved(out):
        err = " csg compiler snapshot: diagnostic completion CID missing"
        return false
    err = ""
    return true

@borrows
fn CsgCompilerDiagnosticRowProofCidInto(
        snapshot: CsgCompilerSnapshotTables,
        completionRow: int32,
        diagnosticRow: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if !csgCompilerIndexValid(
           completionRow, snapshot.diagnosticCompletions.sourceIds.len) ||
       completionRow >=
           snapshot.diagnosticCompletions.producerReceiptCids.len ||
       !csgCompilerIndexValid(
           diagnosticRow, snapshot.diagnostics.sourceIds.len) ||
       diagnosticRow >= snapshot.diagnostics.spanIds.len ||
       diagnosticRow >= snapshot.diagnostics.producerKinds.len ||
       diagnosticRow >= snapshot.diagnostics.anchorKinds.len ||
       diagnosticRow >= snapshot.diagnostics.parserNodeIds.len ||
       diagnosticRow >= snapshot.diagnostics.ownerDeclarationIds.len ||
       diagnosticRow >= snapshot.diagnostics.severities.len ||
       diagnosticRow >= snapshot.diagnostics.codeTextIds.len ||
       diagnosticRow >= snapshot.diagnostics.messageTextIds.len:
        err = " csg compiler snapshot: diagnostic proof row out of range"
        return false
    let sourceId = snapshot.diagnostics.sourceIds[diagnosticRow]
    let spanId = snapshot.diagnostics.spanIds[diagnosticRow]
    let codeTextId = snapshot.diagnostics.codeTextIds[diagnosticRow]
    let messageTextId = snapshot.diagnostics.messageTextIds[diagnosticRow]
    if !csgCompilerIndexValid(
           sourceId, snapshot.sources.documentCids.len) ||
       !csgCompilerIndexValid(spanId, snapshot.spans.sourceIds.len) ||
       !csgCompilerIndexValid(codeTextId, snapshot.texts.len) ||
       !csgCompilerIndexValid(messageTextId, snapshot.texts.len) ||
       snapshot.diagnosticCompletions.sourceIds[completionRow] != sourceId ||
       snapshot.diagnosticCompletions.producerKinds[completionRow] !=
           snapshot.diagnostics.producerKinds[diagnosticRow]:
        err = " csg compiler snapshot: diagnostic proof identity split"
        return false
    let parserNodeId = snapshot.diagnostics.parserNodeIds[diagnosticRow]
    let ownerDeclarationId =
        snapshot.diagnostics.ownerDeclarationIds[diagnosticRow]
    if !csgCompilerOptionalIndexValid(
           parserNodeId, snapshot.parserNodes.sourceIds.len) ||
       !csgCompilerOptionalIndexValid(
           ownerDeclarationId, snapshot.declarations.declIds.len):
        err = " csg compiler snapshot: diagnostic proof anchor invalid"
        return false
    var buf = layout.ByteBufInit(384)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.diagnostic_row_proof")
    layout.ByteBufAppendFixed32(
        buf, snapshot.sources.documentCids[sourceId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.diagnostics.producerKinds[diagnosticRow])
    layout.ByteBufAppendFixed32(
        buf,
        snapshot.diagnosticCompletions.producerReceiptCids[completionRow])
    csgCompilerTypeCidAppendU32(buf, snapshot.spans.startBytes[spanId])
    csgCompilerTypeCidAppendU32(buf, snapshot.spans.endBytes[spanId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.diagnostics.anchorKinds[diagnosticRow])
    csgCompilerTypeCidAppendU32(buf, parserNodeId >= 0 ? 1 : 0)
    if parserNodeId >= 0:
        csgCompilerTypeCidAppendU32(
            buf, snapshot.parserNodes.producerNodeIds[parserNodeId])
    csgCompilerTypeCidAppendU32(buf, ownerDeclarationId >= 0 ? 1 : 0)
    if ownerDeclarationId >= 0:
        layout.ByteBufAppendFixed32(
            buf, snapshot.declarations.declKeyCids[ownerDeclarationId])
    csgCompilerTypeCidAppendU32(
        buf, snapshot.diagnostics.severities[diagnosticRow])
    csgCompilerTypeCidAppendText(buf, snapshot.texts[codeTextId])
    csgCompilerTypeCidAppendText(buf, snapshot.texts[messageTextId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn csgCompilerDiagnosticRowLess(
        snapshot: CsgCompilerSnapshotTables,
        left: int32,
        right: int32): bool =
    if snapshot.diagnostics.spanIds[left] !=
           snapshot.diagnostics.spanIds[right]:
        return snapshot.diagnostics.spanIds[left] <
               snapshot.diagnostics.spanIds[right]
    if snapshot.diagnostics.anchorKinds[left] !=
           snapshot.diagnostics.anchorKinds[right]:
        return snapshot.diagnostics.anchorKinds[left] <
               snapshot.diagnostics.anchorKinds[right]
    if snapshot.diagnostics.parserNodeIds[left] !=
           snapshot.diagnostics.parserNodeIds[right]:
        return snapshot.diagnostics.parserNodeIds[left] <
               snapshot.diagnostics.parserNodeIds[right]
    if snapshot.diagnostics.ownerDeclarationIds[left] !=
           snapshot.diagnostics.ownerDeclarationIds[right]:
        return snapshot.diagnostics.ownerDeclarationIds[left] <
               snapshot.diagnostics.ownerDeclarationIds[right]
    if snapshot.diagnostics.severities[left] !=
           snapshot.diagnostics.severities[right]:
        return snapshot.diagnostics.severities[left] <
               snapshot.diagnostics.severities[right]
    if snapshot.diagnostics.codeTextIds[left] !=
           snapshot.diagnostics.codeTextIds[right]:
        return snapshot.diagnostics.codeTextIds[left] <
               snapshot.diagnostics.codeTextIds[right]
    if snapshot.diagnostics.messageTextIds[left] !=
           snapshot.diagnostics.messageTextIds[right]:
        return snapshot.diagnostics.messageTextIds[left] <
               snapshot.diagnostics.messageTextIds[right]
    return csgCompilerCidLess(
        snapshot.diagnostics.proofCids[left],
        snapshot.diagnostics.proofCids[right])

@borrows
fn CsgCompilerDiagnosticAuthorityStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if CsgCompilerDiagnosticLayout - CsgCompilerDiagnosticParser + 1 !=
           CsgCompilerDiagnosticProducerCount:
        err = " csg compiler snapshot: diagnostic producer contract mismatch"
        return false
    let completionCount = snapshot.diagnosticCompletions.sourceIds.len
    if completionCount !=
           snapshot.diagnosticCompletions.producerKinds.len ||
       completionCount != snapshot.diagnosticCompletions.rowStarts.len ||
       completionCount != snapshot.diagnosticCompletions.rowCounts.len ||
       completionCount !=
           snapshot.diagnosticCompletions.producerReceiptCids.len ||
       completionCount !=
           snapshot.sources.documentCids.len *
               CsgCompilerDiagnosticProducerCount:
        err = " csg compiler snapshot: diagnostic completion columns mismatch"
        return false
    let diagnosticCount = snapshot.diagnostics.sourceIds.len
    if diagnosticCount != snapshot.diagnostics.spanIds.len ||
       diagnosticCount != snapshot.diagnostics.producerKinds.len ||
       diagnosticCount != snapshot.diagnostics.anchorKinds.len ||
       diagnosticCount != snapshot.diagnostics.parserNodeIds.len ||
       diagnosticCount != snapshot.diagnostics.ownerDeclarationIds.len ||
       diagnosticCount != snapshot.diagnostics.severities.len ||
       diagnosticCount != snapshot.diagnostics.codeTextIds.len ||
       diagnosticCount != snapshot.diagnostics.messageTextIds.len ||
       diagnosticCount != snapshot.diagnostics.proofCids.len:
        err = " csg compiler snapshot: diagnostic columns mismatch"
        return false
    var expectedRowStart: int32
    for completionRow in 0..<completionCount:
        let sourceId =
            snapshot.diagnosticCompletions.sourceIds[completionRow]
        let producerKind =
            snapshot.diagnosticCompletions.producerKinds[completionRow]
        let rowStart =
            snapshot.diagnosticCompletions.rowStarts[completionRow]
        let rowCount =
            snapshot.diagnosticCompletions.rowCounts[completionRow]
        let expectedSourceId =
            completionRow / CsgCompilerDiagnosticProducerCount
        let expectedProducerKind =
            CsgCompilerDiagnosticParser +
            completionRow % CsgCompilerDiagnosticProducerCount
        if sourceId != expectedSourceId ||
           producerKind != expectedProducerKind ||
           !csgCompilerIndexValid(
               sourceId, snapshot.sources.documentCids.len) ||
           rowStart != expectedRowStart || rowCount < 0 ||
           rowStart > diagnosticCount ||
           rowCount > diagnosticCount - rowStart ||
           !csgCompilerCidObserved(
               snapshot.diagnosticCompletions.producerReceiptCids[
                   completionRow]):
            err = " csg compiler snapshot: invalid diagnostic completion row"
            return false
        let rowEnd = rowStart + rowCount
        for diagnosticRow in rowStart..<rowEnd:
            let source = snapshot.diagnostics.sourceIds[diagnosticRow]
            let span = snapshot.diagnostics.spanIds[diagnosticRow]
            let anchorKind =
                snapshot.diagnostics.anchorKinds[diagnosticRow]
            let parserNodeId =
                snapshot.diagnostics.parserNodeIds[diagnosticRow]
            let ownerDeclarationId =
                snapshot.diagnostics.ownerDeclarationIds[diagnosticRow]
            if source != sourceId ||
               snapshot.diagnostics.producerKinds[diagnosticRow] !=
                   producerKind ||
               !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
               snapshot.spans.sourceIds[span] != source ||
               anchorKind < CsgCompilerDiagnosticAnchorSpan ||
               anchorKind >
                   CsgCompilerDiagnosticAnchorParserNodeOwnerDeclaration ||
               snapshot.diagnostics.severities[diagnosticRow] <
                   CsgCompilerDiagnosticSeverityError ||
               snapshot.diagnostics.severities[diagnosticRow] >
                   CsgCompilerDiagnosticSeverityHint ||
               !csgCompilerIndexValid(
                   snapshot.diagnostics.codeTextIds[diagnosticRow],
                   snapshot.texts.len) ||
               !csgCompilerIndexValid(
                   snapshot.diagnostics.messageTextIds[diagnosticRow],
                   snapshot.texts.len):
                err = " csg compiler snapshot: invalid diagnostic row"
                return false
            let needsParser =
                anchorKind == CsgCompilerDiagnosticAnchorParserNode ||
                anchorKind ==
                    CsgCompilerDiagnosticAnchorParserNodeOwnerDeclaration
            let needsOwner =
                anchorKind ==
                    CsgCompilerDiagnosticAnchorOwnerDeclaration ||
                anchorKind ==
                    CsgCompilerDiagnosticAnchorParserNodeOwnerDeclaration
            if (needsParser &&
                (!csgCompilerIndexValid(
                     parserNodeId, snapshot.parserNodes.sourceIds.len) ||
                 parserNodeId >= snapshot.parserNodes.spanIds.len ||
                 snapshot.parserNodes.sourceIds[parserNodeId] != source ||
                 snapshot.parserNodes.spanIds[parserNodeId] != span)) ||
               (!needsParser && parserNodeId != -1) ||
               (needsOwner &&
                (!csgCompilerIndexValid(
                     ownerDeclarationId,
                     snapshot.declarations.declIds.len) ||
                 !layout.FixedBytes32Equal(
                     snapshot.declarations.portableDocumentIdentityCids[
                         ownerDeclarationId],
                     snapshot.sources.documentCids[source]) ||
                 snapshot.spans.startBytes[span] <
                     snapshot.declarations.spanStartBytes[
                         ownerDeclarationId] ||
                 snapshot.spans.endBytes[span] >
                     snapshot.declarations.spanEndBytes[
                         ownerDeclarationId])) ||
               (!needsOwner && ownerDeclarationId != -1) ||
               (diagnosticRow > rowStart &&
                !csgCompilerDiagnosticRowLess(
                    snapshot, diagnosticRow - 1, diagnosticRow)):
                err = " csg compiler snapshot: invalid diagnostic authority"
                return false
            var expectedProof: layout.FixedBytes32
            # var-param `err` cannot be re-lent as a var-out actual under the
            # exact provenance audit; stage through a fresh local.
            var proofErr = ""
            if !CsgCompilerDiagnosticRowProofCidInto(
                   snapshot, completionRow, diagnosticRow,
                   expectedProof, proofErr):
                err = proofErr
                return false
            if !layout.FixedBytes32Equal(
                   expectedProof,
                   snapshot.diagnostics.proofCids[diagnosticRow]):
                err = " csg compiler snapshot: diagnostic proof mismatch"
                return false
        expectedRowStart = rowEnd
    if expectedRowStart != diagnosticCount:
        err = " csg compiler snapshot: diagnostic completion coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn csgCompilerDebugOpsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let debugCount = snapshot.debugOps.typedNodeIds.len
    if debugCount != snapshot.debugOps.functionIds.len ||
       debugCount != snapshot.debugOps.spanIds.len ||
       debugCount != snapshot.debugOps.symbolIds.len ||
       debugCount != snapshot.debugOps.opKinds.len:
        err = " csg compiler snapshot: debug columns mismatch"
        return false
    for row in 0..<debugCount:
        let node = snapshot.debugOps.typedNodeIds[row]
        let function = snapshot.debugOps.functionIds[row]
        let span = snapshot.debugOps.spanIds[row]
        if !csgCompilerIndexValid(node, snapshot.typedNodes.functionIds.len) ||
           !csgCompilerIndexValid(function,
                                   snapshot.functions.symbolIds.len) ||
           snapshot.typedNodes.functionIds[node] != function ||
           !csgCompilerOptionalIndexValid(
               span, snapshot.spans.sourceIds.len) ||
           snapshot.typedNodes.spanIds[node] != span ||
           !csgCompilerOptionalIndexValid(snapshot.debugOps.symbolIds[row],
                                           snapshot.symbols.symbolCids.len) ||
           snapshot.debugOps.opKinds[row] <= 0 ||
           (row > 0 && node <= snapshot.debugOps.typedNodeIds[row - 1]):
            err = " csg compiler snapshot: invalid debug row"
            return false
    err = ""
    return true

@borrows
fn csgCompilerDiagnosticsAbsentStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    if snapshot.diagnostics.sourceIds.len != 0 ||
       snapshot.diagnostics.spanIds.len != 0 ||
       snapshot.diagnostics.producerKinds.len != 0 ||
       snapshot.diagnostics.anchorKinds.len != 0 ||
       snapshot.diagnostics.parserNodeIds.len != 0 ||
       snapshot.diagnostics.ownerDeclarationIds.len != 0 ||
       snapshot.diagnostics.severities.len != 0 ||
       snapshot.diagnostics.codeTextIds.len != 0 ||
       snapshot.diagnostics.messageTextIds.len != 0 ||
       snapshot.diagnostics.proofCids.len != 0 ||
       snapshot.diagnosticCompletions.sourceIds.len != 0 ||
       snapshot.diagnosticCompletions.producerKinds.len != 0 ||
       snapshot.diagnosticCompletions.rowStarts.len != 0 ||
       snapshot.diagnosticCompletions.rowCounts.len != 0 ||
       snapshot.diagnosticCompletions.producerReceiptCids.len != 0 ||
       snapshot.diagnosticCompletions.requiredStarts.len != 0 ||
       snapshot.diagnosticCompletions.requiredCounts.len != 0 ||
       snapshot.diagnosticCompletions.proofCids.len != 0 ||
       snapshot.diagnosticCompletions.requiredProducerIds.len != 0 ||
       snapshot.diagnosticCompletions.requiredProducerCids.len != 0 ||
       snapshot.diagnosticCompletions.requiredResultIds.len != 0 ||
       snapshot.diagnosticCompletions.requiredResultCids.len != 0 ||
       csgCompilerCidObserved(
           snapshot.diagnosticCompletions.requiredDomainCid):
        err = " csg compiler snapshot: graph projection diagnostic lifecycle state invalid"
        return false
    err = ""
    return true

@borrows
fn CsgCompilerDiagnosticDenominatorStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let completionCount =
        snapshot.diagnosticCompletions.sourceIds.len
    let sourceCount = snapshot.sources.documentCids.len
    let producerKindCount =
        CsgCompilerDiagnosticLayout -
        CsgCompilerDiagnosticParser + 1
    let requiredCount =
        snapshot.diagnosticCompletions.requiredProducerIds.len
    if sourceCount >
           2147483647 / producerKindCount ||
       completionCount !=
           sourceCount * producerKindCount ||
       completionCount !=
           snapshot.diagnosticCompletions.producerKinds.len ||
       completionCount !=
           snapshot.diagnosticCompletions.requiredStarts.len ||
       completionCount !=
           snapshot.diagnosticCompletions.requiredCounts.len ||
       completionCount !=
           snapshot.diagnosticCompletions.rowCounts.len ||
       completionCount !=
           snapshot.diagnosticCompletions.proofCids.len ||
       requiredCount !=
           snapshot.diagnosticCompletions.requiredProducerCids.len ||
       requiredCount !=
           snapshot.diagnosticCompletions.requiredResultIds.len ||
       requiredCount !=
           snapshot.diagnosticCompletions.requiredResultCids.len ||
       !csgCompilerCidObserved(
           snapshot.diagnosticCompletions.requiredDomainCid):
        err = " csg compiler snapshot: diagnostic completion columns mismatch"
        return false
    var requiredCursor: int32
    for completionId in 0..<completionCount:
        let expectedSource =
            completionId / producerKindCount
        let expectedProducerKind =
            completionId % producerKindCount +
                CsgCompilerDiagnosticParser
        let completionRequiredCount =
            snapshot.diagnosticCompletions.requiredCounts[
                completionId]
        if snapshot.diagnosticCompletions.sourceIds[
               completionId] != expectedSource ||
           snapshot.diagnosticCompletions.producerKinds[
               completionId] != expectedProducerKind ||
           snapshot.diagnosticCompletions.requiredStarts[
               completionId] != requiredCursor ||
           requiredCursor > requiredCount ||
           completionRequiredCount < 0 ||
           completionRequiredCount > requiredCount - requiredCursor:
            err = " csg compiler snapshot: diagnostic completion CSR invalid"
            return false
        for offset in 0..<completionRequiredCount:
            let requiredRow = requiredCursor + offset
            let producerId =
                snapshot.diagnosticCompletions.requiredProducerIds[
                    requiredRow]
            let resultId =
                snapshot.diagnosticCompletions.requiredResultIds[
                    requiredRow]
            for previousOffset in 0..<offset:
                if snapshot.diagnosticCompletions.requiredProducerIds[
                       requiredCursor + previousOffset] == producerId:
                    err = " csg compiler snapshot: diagnostic producer row duplicated"
                    return false
            if producerId < 0 ||
               !csgCompilerCidObserved(
                   snapshot.diagnosticCompletions.requiredProducerCids[
                       requiredRow]) ||
               !csgCompilerCidObserved(
                   snapshot.diagnosticCompletions.requiredResultCids[
                       requiredRow]) ||
               (expectedProducerKind ==
                    CsgCompilerDiagnosticParser &&
                resultId != expectedSource) ||
               (expectedProducerKind ==
                    CsgCompilerDiagnosticType &&
                !csgCompilerIndexValid(
                    resultId, snapshot.types.typeCids.len)) ||
               ((expectedProducerKind ==
                     CsgCompilerDiagnosticOwnership ||
                 expectedProducerKind ==
                     CsgCompilerDiagnosticConcurrency) &&
                !csgCompilerIndexValid(
                    resultId,
                    snapshot.typedNodes.functionIds.len)) ||
               (expectedProducerKind ==
                    CsgCompilerDiagnosticLayout &&
                !csgCompilerIndexValid(
                    resultId, snapshot.layouts.typeIds.len)):
                err = " csg compiler snapshot: diagnostic result row invalid"
                return false
            if expectedProducerKind ==
                   CsgCompilerDiagnosticOwnership ||
               expectedProducerKind ==
                   CsgCompilerDiagnosticConcurrency:
                let functionId =
                    snapshot.typedNodes.functionIds[resultId]
                let symbolId =
                    functionId < 0 ||
                    functionId >= snapshot.functions.symbolIds.len ?
                        -1 : snapshot.functions.symbolIds[functionId]
                if !csgCompilerIndexValid(
                       symbolId, snapshot.symbols.sourceIds.len) ||
                   snapshot.symbols.sourceIds[symbolId] !=
                       expectedSource:
                    err = " csg compiler snapshot: diagnostic TypedNode result source drift"
                    return false
        requiredCursor =
            requiredCursor + completionRequiredCount
        var expectedProofCid: layout.FixedBytes32
        var expectedDiagnosticCount: int32
        if !CsgCompilerDiagnosticCompletionProofCidInto(
               snapshot,
               completionId,
               expectedProofCid,
               expectedDiagnosticCount,
               err):
            return false
        if snapshot.diagnosticCompletions.rowCounts[
               completionId] != expectedDiagnosticCount ||
           !layout.FixedBytes32Equal(
               snapshot.diagnosticCompletions.proofCids[
                   completionId],
               expectedProofCid):
            err = " csg compiler snapshot: diagnostic completion proof invalid"
            return false
    if requiredCursor != requiredCount:
        err = " csg compiler snapshot: diagnostic required CSR tail invalid"
        return false
    err = ""
    return true

@borrows
fn csgCompilerDebugAndDiagnosticsCompleteStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    if !csgCompilerDebugOpsValidateInto(snapshot, err):
        return false
    if !CsgCompilerDiagnosticAuthorityStrictValidateInto(
           snapshot, err):
        return false
    return CsgCompilerDiagnosticDenominatorStrictValidateInto(
        snapshot, err)

@borrows
fn CsgCompilerSnapshotTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch <= 0 ||
       !csgCompilerCidObserved(snapshot.predecessorReceiptCid):
        err = " csg compiler snapshot: invalid envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerTypesValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, true, err) ||
       !csgCompilerAnnotationTargetsValidateInto(snapshot, err) ||
       !csgCompilerLexicalScopesValidateInto(snapshot, err) ||
       !csgCompilerFunctionsAndReadsValidateInto(snapshot, err) ||
       !csgCompilerFunctionResultOwnershipExactValidateInto(
           snapshot, err) ||
       !csgCompilerParserFunctionIdentityValidateInto(snapshot, err) ||
       !csgCompilerReferencesAndCallsValidateInto(snapshot, err) ||
       !csgCompilerLayoutsValidateInto(snapshot, err) ||
       !csgCompilerTypedNodesValidateInto(snapshot, true, err) ||
       !csgCompilerDependenciesValidateInto(snapshot, err) ||
       !csgCompilerDebugAndDiagnosticsCompleteStrictValidateInto(
           snapshot, err):
        return false
    err = ""
    return true

# Public subset proof for producers that have exact symbol/function/read-set
# rows while the remaining tables are still blocked.  This is the same
# validator code as the full strict proof above; it never weakens a row rule.
@borrows
fn CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid partial envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerTypesValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, true, err) ||
       !csgCompilerAnnotationTargetsValidateInto(snapshot, err) ||
       !csgCompilerFunctionsAndReadsValidateInto(snapshot, err) ||
       !csgCompilerParserFunctionIdentityValidateInto(snapshot, err):
        return false
    err = ""
    return true

# Construction-only counterpart for the same exact Symbol/Function/ReadSet
# rows before atomic source-interface finalization. Every source interface must
# still be zero; this validator never authorizes publication or cargo encoding.
@borrows
fn CsgCompilerSnapshotUnsealedSymbolFunctionTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid unsealed symbol/function envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerUnsealedSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerTypesValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, true, err) ||
       !csgCompilerAnnotationTargetsValidateInto(snapshot, err) ||
       !csgCompilerFunctionsAndReadsValidateInto(snapshot, err) ||
       !csgCompilerParserFunctionIdentityValidateInto(snapshot, err):
        return false
    err = ""
    return true

# Construction-only proof for the exact resolved-call projection before the
# atomic source-interface finalization step. Every source interface must still
# be zero; prefilled and mixed sealed/unsealed source domains are rejected.
@borrows
fn CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid unsealed reference/call envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerUnsealedSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerTypesValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, true, err) ||
       !csgCompilerFunctionsValidateInto(snapshot, err) ||
       !csgCompilerExternFunctionsValidateInto(snapshot, err) ||
       !csgCompilerUnsealedReadsValidateInto(snapshot, err) ||
       !csgCompilerParserFunctionIdentityValidateInto(snapshot, err) ||
       !csgCompilerReferencesAndCallsValidateInto(snapshot, err):
        return false
    err = ""
    return true

# Construction-only exact Reference/Call proof after canonical read-set rebuild
# but before source-interface finalization. It differs from the publication
# validator only in requiring every source interface to remain zero.
@borrows
fn CsgCompilerSnapshotUnsealedReferenceCallReadTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid unsealed reference/call/read envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerUnsealedSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerTypesValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, true, err) ||
       !csgCompilerFunctionsAndReadsValidateInto(snapshot, err) ||
       !csgCompilerParserFunctionIdentityValidateInto(snapshot, err) ||
       !csgCompilerReferencesAndCallsValidateInto(snapshot, err):
        return false
    err = ""
    return true

# Public subset proof for the exact resolved-call projection.  It consumes the
# same parser/declaration/Symbol/Function/TypedNode rows as full strict
# validation, but does not admit unrelated unfinished TypedNode proof columns.
@borrows
fn CsgCompilerSnapshotReferenceCallTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid reference/call envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerTypesValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, true, err) ||
       !csgCompilerFunctionsAndReadsValidateInto(snapshot, err) ||
       !csgCompilerParserFunctionIdentityValidateInto(snapshot, err) ||
       !csgCompilerReferencesAndCallsValidateInto(snapshot, err):
        return false
    err = ""
    return true

# Inspection-only symbol/function/read-set projection. Parser-owned declaration
# receipts and SymbolCid are exact; missing TypeArena identities remain explicit
# -1 holes. This validator can never authorize cargo publication.
@borrows
fn CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid projection envelope"
        return false
    if !csgCompilerTextsValidateInto(snapshot, err) ||
       !csgCompilerSourcesValidateInto(snapshot, err) ||
       !csgCompilerSpansValidateInto(snapshot, err) ||
       !csgCompilerParserValidateInto(snapshot, err) ||
       !csgCompilerSymbolsValidateInto(snapshot, false, err) ||
       !csgCompilerFunctionsAndReadsValidateInto(snapshot, err):
        return false
    err = ""
    return true

# Public subset proof for the exact TypedExprIr node/type/debug projection.
# Empty TypedIR is valid; a non-empty node table always requires a complete
# canonical type table and matching DebugOp row.
@borrows
fn CsgCompilerSnapshotTypedNodeTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid typed-node envelope"
        return false
    if snapshot.typedNodes.functionIds.len > 0 &&
       snapshot.types.typeCids.len <= 0:
        err = " csg compiler snapshot: typed nodes have no type authority"
        return false
    if snapshot.types.typeCids.len > 0 &&
       !csgCompilerTypesValidateInto(snapshot, err):
        return false
    if !csgCompilerTypedNodesValidateInto(snapshot, true, err) ||
       !csgCompilerDebugAndDiagnosticsCompleteStrictValidateInto(
           snapshot, err):
        return false
    err = ""
    return true

# Projection validation preserves exact shape/range/CID/acyclic checks while
# allowing proof groups to remain unobserved. Every observed CID is recomputed;
# staged kinds without CIDs are not proof and keep admission blocked. Cargo
# publication always uses the complete validator above.
@borrows
fn CsgCompilerSnapshotTypedNodeProjectionTablesStrictValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    err = ""
    if snapshot.schemaVersion != CsgCompilerSnapshotSchemaVersionLatest ||
       snapshot.semanticEpoch < 0:
        err = " csg compiler snapshot: invalid typed-node projection envelope"
        return false
    if snapshot.types.typeCids.len > 0 &&
       !csgCompilerTypesValidateInto(snapshot, err):
        return false
    if !csgCompilerTypedNodesValidateInto(snapshot, false, err) ||
       !csgCompilerDebugOpsValidateInto(snapshot, err):
        return false
    # Graph projection precedes the diagnostic producer stage. Its phase
    # contract is mutually exclusive with the complete source x five-producer
    # seal required by full admission.
    if !csgCompilerDiagnosticsAbsentStrictValidateInto(snapshot, err):
        return false
    err = ""
    return true
