import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration
import std/seqs
import std/strings

# The compiler snapshot has exactly one live wire schema. Breaking changes
# replace this value and all producers/consumers atomically in place.
# [phaseB-enum-schema] v8: CsgCompilerTypeTable gains the enum variant
# payload CSR (variantStarts/variantCounts/variantNameTextIds/
# variantOrdinals/variantPayloadTypeIds), so a CsgCompilerTypeEnum row now
# carries its exact declared variant rows instead of being rejected.
const
    CsgCompilerSnapshotSchemaVersionLatest: int32 = 8

    CsgCompilerSymbolModule: int32 = 1
    CsgCompilerSymbolType: int32 = 2
    CsgCompilerSymbolFunction: int32 = 3
    CsgCompilerSymbolField: int32 = 4
    CsgCompilerSymbolParameter: int32 = 5
    CsgCompilerSymbolLocal: int32 = 6
    CsgCompilerSymbolGenericParameter: int32 = 7

    CsgCompilerReferenceRead: int32 = 1
    CsgCompilerReferenceWrite: int32 = 2
    CsgCompilerReferenceCall: int32 = 3
    CsgCompilerReferenceType: int32 = 4
    CsgCompilerReferenceImport: int32 = 5

    # Stable parser token wire kind.  The schema owns the copied numeric
    # contract so validation does not import the parser implementation.
    CsgCompilerTokenFmtString: int32 = 6
    CsgCompilerTokenAssign: int32 = 72
    CsgCompilerTokenBacktick: int32 = 57
    CsgCompilerParserStatementBindingInitializer: int32 = 1
    CsgCompilerParserStatementParameterDefault: int32 = 9
    CsgCompilerParserStatementTypeDefault: int32 = 10
    CsgCompilerParserDeclarationType: int32 = 2
    CsgCompilerParserDeclarationFunction: int32 = 3
    CsgCompilerParserDeclarationField: int32 = 4
    CsgCompilerParserDeclarationParameter: int32 = 5
    CsgCompilerParserDeclarationLocal: int32 = 6
    CsgCompilerParserScopeFunction: int32 = 3
    CsgCompilerParserValueExprIdentifier: int32 = 1
    CsgCompilerParserBindingResolutionNone: int32 = 0
    CsgCompilerParserBindingResolutionParameter: int32 = 1
    CsgCompilerParserBindingResolutionPattern: int32 = 2
    CsgCompilerParserAnnotationArgString: int32 = 3
    CsgCompilerParserScopeSource: int32 = 1
    CsgCompilerParserScopeType: int32 = 2
    CsgCompilerLexicalScopeProducerParser: int32 = 1
    CsgCompilerLexicalScopeProducerTypedExpr: int32 = 2
    CsgCompilerFunctionAnnotationThreadBoundary: int32 = 1
    CsgCompilerFunctionAnnotationBorrows: int32 = 2
    CsgCompilerFunctionAnnotationEscapes: int32 = 4
    CsgCompilerFunctionAnnotationWeak: int32 = 8
    CsgCompilerFunctionAnnotationTrustedAbi: int32 = 16
    CsgCompilerFunctionAnnotationNoAlloc: int32 = 32
    CsgCompilerFunctionAnnotationInterruptHandler: int32 = 64
    CsgCompilerFunctionAnnotationKeepExportBinding: int32 = 128
    CsgCompilerFunctionAnnotationBorrowResult: int32 = 256
    CsgCompilerFunctionAnnotationManualConsume: int32 = 512
    CsgCompilerFunctionAnnotationMask: int32 = 1023

    # External functions live in the same canonical Function Symbol domain,
    # but never masquerade as executable FunctionTable rows.
    CsgCompilerExternAbiC: int32 = 1

    # Native @ffi_handle effects are parser-owned wire values copied into the
    # snapshot schema so strict validation never imports parser implementation.
    CsgCompilerExternFfiHandleEffectProduce: int32 = 1
    CsgCompilerExternFfiHandleEffectBorrow: int32 = 2
    CsgCompilerExternFfiHandleEffectConsume: int32 = 3
    CsgCompilerExternFfiHandleUnwindNoUnwind: int32 = 1
    CsgCompilerExternFfiHandleTargetResult: int32 = 1
    CsgCompilerExternFfiHandleTargetParameter: int32 = 2
    CsgCompilerExternFfiHandleAbiCarrierUInt32: int32 = 1
    CsgCompilerExternFfiHandleAbiCarrierUInt64: int32 = 2
    CsgCompilerStandardIdentity: str = "csg_core::v1"
    CsgCompilerExternFfiHandleSchemaIdentity: str =
        "csg_dialect::native::extern_ffi_handle"
    CsgCompilerNativeProfileIdentity: str = "csg_dialect::native"
    CsgCompilerExternFfiHandleTypeDomain: str =
        "cheng.csg_compiler.extern_ffi_handle_type"
    CsgCompilerExternFfiHandleEffectDomain: str =
        "cheng.csg_compiler.extern_ffi_handle_effect"
    CsgCompilerExternFfiHandleContractDomain: str =
        "cheng.csg_compiler.extern_ffi_handle_contract"
    CsgCompilerExternFfiHandleInterfaceDomain: str =
        "cheng.csg_compiler.extern_ffi_handle_interface"
    CsgCompilerExternFfiHandleParameterSymbolDomain: str =
        "cheng.csg_compiler.extern_ffi_handle_parameter_symbol"
    CsgCompilerExternFfiHandleCargoDomain: str =
        "cheng.csg_compiler.extern_ffi_handle_cargo"

    # A read target is a portable semantic identity, never a snapshot-local
    # SymbolId.  The observed value is recomputed from the corresponding
    # canonical table before publication and again on every cache admission.
    CsgCompilerReadDomainSourceInterface: int32 = 1
    CsgCompilerReadDomainSymbolInterface: int32 = 2
    CsgCompilerReadDomainTypeIdentity: int32 = 3
    CsgCompilerReadDomainLayout: int32 = 4

    CsgCompilerOwnershipOwned: int32 = 1
    CsgCompilerOwnershipBorrowed: int32 = 2
    CsgCompilerOwnershipUnmanaged: int32 = 3

    # Type rows use the producer's immutable type-proof category.  These
    # values intentionally match TypedExprIr without importing the producer
    # module into the CSG schema boundary.
    CsgCompilerTypeScalar: int32 = 1
    CsgCompilerTypeObject: int32 = 2
    CsgCompilerTypeRefObject: int32 = 3
    CsgCompilerTypeEnum: int32 = 4
# [d1-dead-premise] reserved ordinal 5; no producer kind in TypedExprIr type arena (:14-29); dead until ref T ruling (wire ordinal held here; the three consumer branches are the ref-T wiring-day shape precedent).
    CsgCompilerTypeReference: int32 = 5
    CsgCompilerTypeBorrow: int32 = 6
    CsgCompilerTypeSequence: int32 = 7
    CsgCompilerTypeArray: int32 = 8
    CsgCompilerTypeTuple: int32 = 9
    CsgCompilerTypeApply: int32 = 10
    CsgCompilerTypeFunction: int32 = 11
    CsgCompilerTypeAlias: int32 = 12
    CsgCompilerTypeGenericParameter: int32 = 13

    CsgCompilerScalarBool: int32 = 1
    CsgCompilerScalarInt8: int32 = 2
    CsgCompilerScalarInt16: int32 = 3
    CsgCompilerScalarInt32: int32 = 4
    CsgCompilerScalarInt64: int32 = 5
    CsgCompilerScalarUInt8: int32 = 6
    CsgCompilerScalarUInt16: int32 = 7
    CsgCompilerScalarUInt32: int32 = 8
    CsgCompilerScalarUInt64: int32 = 9
    CsgCompilerScalarFloat32: int32 = 10
    CsgCompilerScalarFloat64: int32 = 11
    CsgCompilerScalarChar: int32 = 12
    CsgCompilerScalarStr: int32 = 13
    CsgCompilerScalarCString: int32 = 14
    CsgCompilerScalarVoid: int32 = 15
    CsgCompilerScalarPtr: int32 = 16
    # [builtin-ctor] Appended after `Ptr`: every existing portable scalar
    # ordinal keeps its value, so no existing type CID byte moves.
    CsgCompilerScalarTypedesc: int32 = 17
    CsgCompilerScalarSet: int32 = 18
    # [sabi-view] Appended after `Set`, so every existing portable scalar
    # ordinal keeps its value and no existing type CID byte moves.
    CsgCompilerScalarUtf8View: int32 = 19
    CsgCompilerScalarBytesView: int32 = 20

    CsgCompilerConstArgInt32: int32 = 1
    CsgCompilerConstArgBool: int32 = 2
    CsgCompilerConstArgChar: int32 = 3

    CsgCompilerTraitProofBuiltin: int32 = 1
    CsgCompilerTraitProofDeclaration: int32 = 2
    CsgCompilerTraitProofStructural: int32 = 3

    CsgCompilerTraitConclusionNone: int32 = 0
    CsgCompilerTraitConclusionExact: int32 = 1

    CsgCompilerValueProofTypeTrait: int32 = 1
    CsgCompilerValueProofFlow: int32 = 2
    CsgCompilerValueProofBoundary: int32 = 3

    CsgCompilerValueOrdinary: int32 = 1
    CsgCompilerValueFunctionAddress: int32 = 2
    CsgCompilerValueClosure: int32 = 3
    CsgCompilerValueDefinitionTypeProofNone: int32 = 0
    CsgCompilerValueDefinitionTypeProofAggregate: int32 = 5
    CsgCompilerValueDefinitionOriginParameter: int32 = 1
    CsgCompilerValueDefinitionOriginBindingInitializer: int32 = 2
    CsgCompilerValueDefinitionOriginCallResult: int32 = 3
    CsgCompilerValueDefinitionOriginManagedTemporary: int32 = 4
    # Stable TypedExprIr op wire kind. The schema copies the numeric contract
    # so identity rows can be validated without importing the producer
    # implementation.
    CsgCompilerTypedOpParamRef: int32 = 1
    CsgCompilerTypedOpReturnStrLiteral: int32 = 29
    CsgCompilerTypedOpCstringToStrCopy: int32 = 30
    CsgCompilerTypedOpLocalRef: int32 = 38
    CsgCompilerTypedOpStrLit: int32 = 39
    CsgCompilerTypedOpCallExpr: int32 = 66
    CsgCompilerTypedOpEmptySeqInit: int32 = 67
    CsgCompilerTypedOpNilPtr: int32 = 68
    CsgCompilerTypedOpFmt: int32 = 69
    CsgCompilerTypedOpStrAdd: int32 = 71
    CsgCompilerTypedOpSeqLiteral: int32 = 72
    CsgCompilerTypedOpClosure: int32 = 83

    CsgCompilerShareNone: int32 = 1
    CsgCompilerShareLocal: int32 = 2
    CsgCompilerShareThreadSafe: int32 = 3

    CsgCompilerDiagnosticParser: int32 = 1
    CsgCompilerDiagnosticType: int32 = 2
    CsgCompilerDiagnosticOwnership: int32 = 3
    CsgCompilerDiagnosticConcurrency: int32 = 4
    CsgCompilerDiagnosticLayout: int32 = 5
    CsgCompilerDiagnosticProducerCount: int32 = 5

    CsgCompilerDiagnosticSeverityError: int32 = 1
    CsgCompilerDiagnosticSeverityWarning: int32 = 2
    CsgCompilerDiagnosticSeverityInformation: int32 = 3
    CsgCompilerDiagnosticSeverityHint: int32 = 4

    CsgCompilerDiagnosticAnchorSpan: int32 = 1
    CsgCompilerDiagnosticAnchorParserNode: int32 = 2
    CsgCompilerDiagnosticAnchorOwnerDeclaration: int32 = 3
    CsgCompilerDiagnosticAnchorParserNodeOwnerDeclaration: int32 = 4

fn CsgCompilerFunctionAnnotationFlagsValid(flags: int32): bool =
    if flags < 0 ||
       (flags & CsgCompilerFunctionAnnotationMask) != flags:
        return false
    if (flags & CsgCompilerFunctionAnnotationBorrows) != 0 &&
       (flags & CsgCompilerFunctionAnnotationEscapes) != 0:
        return false
    return (flags & CsgCompilerFunctionAnnotationBorrows) == 0 ||
           (flags & CsgCompilerFunctionAnnotationManualConsume) == 0

fn CsgCompilerFunctionAnnotationHas(flags: int32,
                                      required: int32): bool =
    return CsgCompilerFunctionAnnotationFlagsValid(flags) &&
           required > 0 &&
           (required & CsgCompilerFunctionAnnotationMask) == required &&
           (flags & required) == required

type
    CsgCompilerSourceTable =
        documentCids: layout.FixedBytes32[]
        modulePathTextIds: int32[]
        contentCids: layout.FixedBytes32[]
        interfaceCids: layout.FixedBytes32[]

    CsgCompilerSpanTable =
        sourceIds: int32[]
        startBytes: int32[]
        endBytes: int32[]
        startLines: int32[]
        startColumns: int32[]
        endLines: int32[]
        endColumns: int32[]

    CsgCompilerParserNodeTable =
        sourceIds: int32[]
        # Original ParserValueExprTree node index. Canonical preorder may
        # reorder rows; this is the exact producer identity bridge.
        producerNodeIds: int32[]
        parentNodeIds: int32[]
        kinds: int32[]
        spanIds: int32[]
        childStarts: int32[]
        childCounts: int32[]
        childNodeIds: int32[]
        genericStarts: int32[]
        genericCounts: int32[]
        # Parser-authored lexical resolution for this exact producer node.
        # All identities remain source-local; no name/text reconstruction.
        bindingResolutionKinds: int32[]
        bindingDeclarationSourceLocalRows: int32[]
        bindingPatternSourceLocalRows: int32[]

    CsgCompilerTokenTable =
        sourceIds: int32[]
        sourceLocalRows: int32[]
        lexicalParentTokenIds: int32[]
        spanIds: int32[]
        kinds: int32[]
        valueTextIds: int32[]

    # Exact parser-owned source sidecars. Per-source CIDs bind the immutable
    # parser input and producer receipt; all auxiliary identities reference the
    # canonical span/node/token rows above by dense int32 index.
    CsgCompilerParserSidecarTable =
        sourceIds: int32[]
        producerSourceIndexes: int32[]
        parserInputCids: layout.FixedBytes32[]
        sidecarCids: layout.FixedBytes32[]
        declarationProducerSourceIds: int32[]
        declarationSourceLocalRows: int32[]
        declarationKinds: int32[]
        declarationNameTokenIds: int32[]
        declarationOwnerIds: int32[]
        declarationLexicalScopeIds: int32[]
        declarationFunctionRows: int32[]
        declarationTypeSyntaxRootIds: int32[]
        declarationDefaultStatementRootRows: int32[]
        declarationSpanIds: int32[]
        declarationNameSpanIds: int32[]
        declarationMutableFlags: bool[]
        declarationExportedFlags: bool[]
        declarationLexicalScopeProducerSourceIds: int32[]
        declarationLexicalScopeSourceLocalRows: int32[]
        declarationLexicalScopeKinds: int32[]
        declarationLexicalScopeParentIds: int32[]
        declarationLexicalScopeOwnerDeclarationIds: int32[]
        declarationLexicalScopeSpanIds: int32[]
        patternProducerSourceIds: int32[]
        patternSourceLocalRows: int32[]
        patternKinds: int32[]
        patternNameTokenIds: int32[]
        patternOwnerLexicalScopeIds: int32[]
        patternBindingDeclarationIds: int32[]
        patternTypeSyntaxRootIds: int32[]
        patternSpanIds: int32[]
        patternChildStarts: int32[]
        patternChildCounts: int32[]
        patternChildIds: int32[]
        # Complete parser-owned TypeSyntax/TypeConstExpr postorder. These rows
        # are the structural authority for every generic constraint/default;
        # snapshot TypeId relations below may not replace this syntax proof.
        typeSyntaxSourceIds: int32[]
        typeSyntaxProducerSourceIds: int32[]
        typeSyntaxSourceLocalRows: int32[]
        typeSyntaxKinds: int32[]
        typeSyntaxSpanIds: int32[]
        typeSyntaxOwnerTokenIds: int32[]
        typeSyntaxDeclarationOwnerTokenIds: int32[]
        typeSyntaxDeclarationOwnerIds: int32[]
        typeSyntaxGenericSymbolStarts: int32[]
        typeSyntaxGenericSymbolCounts: int32[]
        typeSyntaxChildStarts: int32[]
        typeSyntaxChildCounts: int32[]
        typeSyntaxChildIds: int32[]
        typeSyntaxBracketArgStarts: int32[]
        typeSyntaxBracketArgCounts: int32[]
        typeSyntaxBracketArgTokenStarts: int32[]
        typeSyntaxBracketArgTokenCounts: int32[]
        typeSyntaxBracketArgTypeIds: int32[]
        typeSyntaxBracketArgConstExprRootIds: int32[]
        typeConstExprKinds: int32[]
        typeConstExprProducerSourceIds: int32[]
        typeConstExprSourceTextIds: int32[]
        typeConstExprTokenIds: int32[]
        typeConstExprLeftChildIds: int32[]
        typeConstExprRightChildIds: int32[]
        typeConstExprIntegerValues: int32[]
        typeConstExprIdentityCids: layout.FixedBytes32[]
        typeSyntaxNameTokenIds: int32[]
        typeSyntaxFixedLengths: int32[]
        typeSyntaxQuestionTokenIds: int32[]
        typeSyntaxRootKinds: int32[]
        typeSyntaxEnumVariantStarts: int32[]
        typeSyntaxEnumVariantCounts: int32[]
        typeEnumVariantProducerSourceIds: int32[]
        typeEnumVariantDeclarationOwnerIds: int32[]
        typeEnumVariantDeclarationOwnerTokenIds: int32[]
        typeEnumVariantNameTokenIds: int32[]
        typeEnumVariantOrdinals: int32[]
        typeEnumVariantPayloadTypeSyntaxIds: int32[]
        # Row-level parser identities derived from this complete SoA and the
        # exact per-source sidecar CID. They are verified on every admission.
        typeSyntaxIdentityCids: layout.FixedBytes32[]
        # Exact parser TypeSyntaxId -> canonical TypeId bridge. Parser-only
        # skeletons carry -1; production sealing replaces every row from the
        # retained TypeArena mapping before diagnostic admission.
        typeSyntaxTypeIds: int32[]
        typeGenericSymbolProducerSourceIds: int32[]
        typeGenericSymbolSourceLocalRows: int32[]
        typeGenericSymbolDeclarationOwnerTokenIds: int32[]
        typeGenericSymbolNameTokenIds: int32[]
        typeGenericSymbolOrdinals: int32[]
        typeGenericSymbolSpanIds: int32[]
        typeGenericSymbolOwnerTypeSyntaxIds: int32[]
        typeGenericSymbolConstraintTypeSyntaxIds: int32[]
        typeGenericSymbolDefaultTypeSyntaxIds: int32[]
        typeGenericSymbolChildStarts: int32[]
        typeGenericSymbolChildCounts: int32[]
        typeGenericSymbolChildTypeSyntaxIds: int32[]
        typeGenericSymbolIdentityCids: layout.FixedBytes32[]
        annotationProducerSourceIds: int32[]
        annotationSourceLocalRows: int32[]
        annotationNameTokenIds: int32[]
        annotationTargetTokenIds: int32[]
        annotationSpanIds: int32[]
        annotationArgRootStarts: int32[]
        annotationArgRootCounts: int32[]
        annotationArgRootIds: int32[]
        annotationArgProducerSourceIds: int32[]
        annotationArgSourceLocalRows: int32[]
        annotationArgOwnerIds: int32[]
        annotationArgKinds: int32[]
        annotationArgTokenIds: int32[]
        annotationArgSeparatorTokenIds: int32[]
        annotationArgSpanIds: int32[]
        annotationArgChildStarts: int32[]
        annotationArgChildCounts: int32[]
        annotationArgChildIds: int32[]
        annotationIdentityCids: layout.FixedBytes32[]
        annotationArgIdentityCids: layout.FixedBytes32[]
        genericSpanIds: int32[]
        regionKinds: int32[]
        regionSpanIds: int32[]
        regionAnchorTokenIds: int32[]
        rootNodeIds: int32[]
        callEventNodeIds: int32[]
        statementRootNodeIds: int32[]
        statementRootRoles: int32[]
        statementRootAnchorTokenIds: int32[]
        statementRootBindingDeclarationStarts: int32[]
        statementRootBindingDeclarationCounts: int32[]
        statementRootAnchorLines: int32[]
        statementRootAnchorColumns: int32[]
        statementRootEndLines: int32[]
        statementRootEndColumns: int32[]
        normalizedExprProducerSourceIds: int32[]
        normalizedExprSourceLocalRows: int32[]
        normalizedExprFunctionIndexes: int32[]
        normalizedExprParserNodeIds: int32[]
        normalizedExprKinds: int32[]
        normalizedExprStatementRoles: int32[]
        functionIndexes: int32[]
        functionNameTextIds: int32[]
        functionNameSurfaceKinds: int32[]
        functionNameProofCids: layout.FixedBytes32[]
        functionSignatureLineNumbers: int32[]
        functionDeclarationSpanIds: int32[]
        functionDeclarationHeaderCids: layout.FixedBytes32[]
        functionDeclarationPathCids: layout.FixedBytes32[]
        functionNameSpanIds: int32[]
        functionBodySpanIds: int32[]
        functionAnnotationFlags: int32[]
        functionManualConsumeTargetParameterOrdinals: int32[]
        functionManualConsumeTargetParameterDeclarationIds: int32[]
        functionManualConsumeSourceParameterOrdinals: int32[]
        functionManualConsumeSourceParameterDeclarationIds: int32[]

    CsgCompilerTypeTable =
        typeCids: layout.FixedBytes32[]
        # Canonical snapshot TypeId -> retained producer TypeArenaId.
        # Structural rows are a bijection over the producer arena; synthesized
        # function-signature rows carry -1.  TypeCid deliberately excludes
        # this snapshot-local row relation.
        producerTypeArenaIds: int32[]
        canonicalTextIds: int32[]
        typeKinds: int32[]
        scalarKinds: int32[]
        declSymbolIds: int32[]
        elementTypeIds: int32[]
        arrayLengths: int32[]
        argStarts: int32[]
        argCounts: int32[]
        argTypeIds: int32[]
        # Parallel to argTypeIds.  Tuple fields carry their exact source name;
        # unnamed tuple elements and non-tuple type arguments use -1.
        argNameTextIds: int32[]
        constArgStarts: int32[]
        constArgCounts: int32[]
        constArgKinds: int32[]
        constArgValues: int32[]
        aliasTargetTypeIds: int32[]
        # Exact parser-owned generic parameter row for
        # CsgCompilerTypeGenericParameter; -1 for every other type kind.
        # TypeCid consumes this parser identity directly and never searches a
        # Symbol table whose TypeIds may still be awaiting canonical remap.
        genericParameterParserRows: int32[]
        managedFlags: bool[]
        sendFlags: bool[]
        syncFlags: bool[]
        traitConclusionKinds: int32[]
        traitProofKinds: int32[]
        traitProofCids: layout.FixedBytes32[]
        traitPremiseStarts: int32[]
        traitPremiseCounts: int32[]
        traitPremiseTypeIds: int32[]
        # [phaseB-enum-schema] Enum variant payload rows. For every
        # CsgCompilerTypeEnum type row, one row per declared variant in
        # declaration (ordinal) order; every other type row contributes zero
        # rows. variantNameTextIds/variantOrdinals/variantPayloadTypeIds are
        # one flattened CSR parallel to itself; payloadless variants carry
        # -1 in variantPayloadTypeIds. The enum row's trait premises are the
        # payloadTypeId subsequence of its variant rows.
        variantStarts: int32[]
        variantCounts: int32[]
        variantNameTextIds: int32[]
        variantOrdinals: int32[]
        variantPayloadTypeIds: int32[]

    CsgCompilerSymbolTable =
        symbolCids: layout.FixedBytes32[]
        interfaceCids: layout.FixedBytes32[]
        # Canonical declaration authority. SymbolCid is a one-way projection
        # of declKeyCid; DeclId is snapshot-local and never an identity input.
        declIds: int32[]
        declKeyCids: layout.FixedBytes32[]
        # Parser header/path receipts remain diagnostic producer cargo only.
        # They are forbidden from SymbolCid and DeclKey preimages.
        declarationHeaderCids: layout.FixedBytes32[]
        declarationPathCids: layout.FixedBytes32[]
        sourceIds: int32[]
        nameTextIds: int32[]
        nameSpanIds: int32[]
        nameTokenIds: int32[]
        qualifiedNameTextIds: int32[]
        symbolKinds: int32[]
        typeIds: int32[]
        declarationSpanIds: int32[]
        ownerSymbolIds: int32[]
        functionIds: int32[]
        # Exactly one of functionIds / externFunctionIds is present for a
        # Function Symbol. Every other Symbol carries -1 in both columns.
        externFunctionIds: int32[]
        exportedFlags: bool[]
        genericConstraintStarts: int32[]
        genericConstraintCounts: int32[]
        genericConstraintTypeIds: int32[]
        # Present only for CsgCompilerSymbolGenericParameter. The parser row is
        # a canonical int32 relation into typeGenericSymbol* above; ordinal and
        # default TypeId are part of the immutable interface.
        genericParameterParserRows: int32[]
        genericParameterOrdinals: int32[]
        genericParameterDefaultTypeIds: int32[]

    # Annotation syntax remains parser-owned. This table is the exact semantic
    # admission relation from every parser Annotation row to one canonical
    # target SymbolId/DeclId; no annotation AST is duplicated.
    CsgCompilerAnnotationTargetTable =
        sourceIds: int32[]
        parserAnnotationRows: int32[]
        targetTokenIds: int32[]
        targetParserDeclarationRows: int32[]
        targetSymbolIds: int32[]
        targetDeclIds: int32[]
        targetDeclKeyCids: layout.FixedBytes32[]

    # Exact lexical visibility at a source position. Scope rows are canonical
    # preorder (parentScopeId < child scope id). visibleSymbolIds is one
    # flattened SymbolId column sliced by visibleStarts/visibleCounts.
    CsgCompilerLexicalScopeTable =
        sourceIds: int32[]
        spanIds: int32[]
        parentScopeIds: int32[]
        # Exact producer domain and dense producer row. Parser rows index
        # declarationLexicalScope*; TypedExpr rows index scopes2_*.
        producerKinds: int32[]
        producerIds: int32[]
        # Exact parser scope anchoring this producer. Parser rows point to
        # themselves; TypedExpr rows point to the unique deepest containing
        # parser scope inside the owning declaration.
        parserBridgeScopeIds: int32[]
        # Canonical identities. Source scopes use -1; parser-owned scopes bind
        # their exact owner declaration; TypedExpr scopes bind FunctionId.
        ownerDeclIds: int32[]
        ownerFunctionIds: int32[]
        visibleStarts: int32[]
        visibleCounts: int32[]
        visibleSymbolIds: int32[]

    CsgCompilerFunctionTable =
        # Exact producer TypedExprIr function index. This is the only bridge
        # from a snapshot FunctionId back into lowering; names and source
        # positions are never identity keys.
        typedFunctionIndexes: int32[]
        symbolIds: int32[]
        bodySpanIds: int32[]
        bodyContentCids: layout.FixedBytes32[]
        fragmentCids: layout.FixedBytes32[]
        interfaceCids: layout.FixedBytes32[]
        annotationFlags: int32[]
        # Canonical callee result ownership summary. Borrowed is admitted only
        # when the exact parser annotation target carries @borrow_result;
        # otherwise a Cheng function summary is Owned. Call rows must project
        # this summary for managed results and bind it through interfaceCids.
        resultOwnershipKinds: int32[]
        # Canonical per-parameter ownership.  The CSR row order is identical
        # to the function Type row's argTypeIds order.  `var T` is Borrowed;
        # managed value parameters are Owned; unmanaged values are Unmanaged.
        # Consumers must not reconstruct this from names, call sites or
        # mutable lowering slots.
        parameterOwnershipStarts: int32[]
        parameterOwnershipCounts: int32[]
        parameterOwnershipKinds: int32[]
        # Resolved semantic @manual_consume relation. Presence is encoded
        # solely by annotationFlags bit 512; absent rows use -1/-1/zero.
        manualConsumeTargetParameterSymbolIds: int32[]
        manualConsumeSourceParameterSymbolIds: int32[]
        manualConsumeEffectCids: layout.FixedBytes32[]
        # Canonical TypedExpr value-definition-group CSR. These rows retain
        # producer order and are never reconstructed from names or locations.
        valueDefinitionStarts: int32[]
        valueDefinitionCounts: int32[]
        valueDefinitionGroupStarts: int32[]
        valueDefinitionGroupCounts: int32[]
        readStarts: int32[]
        readCounts: int32[]
        readSetPreimageCids: layout.FixedBytes32[]
        nodeStarts: int32[]
        nodeCounts: int32[]

    # Bodyless importc declarations keep the same Declaration/Symbol/Type
    # identity chain as Cheng functions. The exact parser declaration row and
    # structured ABI fields replace name/line heuristics.
    CsgCompilerExternFunctionTable =
        symbolIds: int32[]
        parserDeclarationRows: int32[]
        typeIds: int32[]
        externalNameTextIds: int32[]
        abiKinds: int32[]
        # -1 for parser-native `importc fn`; otherwise the exact structured
        # @importc parser Annotation row whose identity is CID-bound below.
        importAnnotationRows: int32[]
        interfaceCids: layout.FixedBytes32[]

    # Portable native FFI handle contracts are independent of the extern ABI
    # interface table above. Snapshot SymbolId is the only local coordinate;
    # parser rows, TypeArena TypeIds and CompilerCSG graph node ids are consumed
    # by the builder join and never persisted here.
    CsgCompilerExternFfiHandleContractTable =
        externSymbolIds: int32[]
        functionSymbolCids: layout.FixedBytes32[]
        parserProvenanceCids: layout.FixedBytes32[]
        unwindKinds: int32[]
        effectStarts: int32[]
        effectCounts: int32[]
        contractCids: layout.FixedBytes32[]
        interfaceCids: layout.FixedBytes32[]
        effectContractRows: int32[]
        effectKinds: int32[]
        effectTargetKinds: int32[]
        effectParameterOrdinals: int32[]
        effectParameterSymbolCids: layout.FixedBytes32[]
        effectTypeCids: layout.FixedBytes32[]
        effectAbiCarrierKinds: int32[]
        effectCids: layout.FixedBytes32[]
        cargoCid: layout.FixedBytes32

    CsgCompilerReadSetTable =
        readerFunctionIds: int32[]
        targetDomainKinds: int32[]
        targetPortableKeyCids: layout.FixedBytes32[]
        observedValueCids: layout.FixedBytes32[]
        reverseIndexCid: layout.FixedBytes32
        reverseTargetDomainKinds: int32[]
        reverseTargetPortableKeyCids: layout.FixedBytes32[]
        reverseStarts: int32[]
        reverseCounts: int32[]
        reverseReaderFunctionIds: int32[]
        reverseObservedValueCids: layout.FixedBytes32[]
        reverseForwardRowIds: int32[]

    CsgCompilerReferenceTable =
        sourceIds: int32[]
        spanIds: int32[]
        ownerFunctionIds: int32[]
        ownerSymbolIds: int32[]
        targetSymbolIds: int32[]
        referenceKinds: int32[]
        # Exact snapshot TypedNode row for ParamRef/LocalRef reads. Every
        # other reference kind carries -1; consumers never recover this edge
        # from name text or source coordinates.
        bindingTypedNodeIds: int32[]

    CsgCompilerCallTable =
        callReferenceIds: int32[]
        callerFunctionIds: int32[]
        calleeSymbolIds: int32[]
        # Exact TypedExprBuildIndex call-declaration row selected by the
        # CallExpr producer.  The target coordinate and immutable semantic
        # identities below are all derived from that row, never from text.
        targetCallDeclarationRows: int32[]
        targetSourceIds: int32[]
        # Source-local row in the parser all-declaration table. This is not
        # the NormalizedFunctionDecl ordinal retained by the call-declaration
        # producer; production admission proves that separate domain first.
        targetSourceLocalDeclarationRows: int32[]
        targetParserDeclarationRows: int32[]
        targetDeclIds: int32[]
        targetDeclKeyCids: layout.FixedBytes32[]
        targetSymbolCids: layout.FixedBytes32[]
        # Snapshot-local TypedNode row carrying the exact TypedExprIr
        # CallExpr/value definition. Result TypeId and ownership below must be
        # identical to this immutable producer row.
        resultTypedNodeIds: int32[]
        # Exact immutable value-definition row produced by the CallExpr.
        # This is a producer edge, not an identifier-binding source edge.
        resultValueDefinitionRows: int32[]
        resultTypeIds: int32[]
        resultOwnershipKinds: int32[]
        resultOwnershipProofKinds: int32[]
        resultOwnershipProofCids: layout.FixedBytes32[]

    CsgCompilerLayoutTable =
        layoutCids: layout.FixedBytes32[]
        typeIds: int32[]
        sizeBytes: int32[]
        alignBytes: int32[]
        fieldStarts: int32[]
        fieldCounts: int32[]

    CsgCompilerLayoutFieldTable =
        layoutIds: int32[]
        fieldSymbolIds: int32[]
        typeIds: int32[]
        offsetBytes: int32[]
        sizeBytes: int32[]
        alignBytes: int32[]

    CsgCompilerTypedStatementTable =
        # Exact producer TypedExprIr statement row and owning FunctionId.
        # rootTypedNodeIds is a CSR of every canonical statement expression
        # root; it is the independent admission authority for node ownership.
        typedIrStatementIndexes: int32[]
        functionIds: int32[]
        rootStarts: int32[]
        rootCounts: int32[]
        rootTypedNodeIds: int32[]

    CsgCompilerTypedNodeTable =
        # Exact producer TypedExprIr node index. Rows stay in the canonical
        # function CSR below; consumers prove a per-function bijection before
        # attaching DebugOp provenance to BodyIR.
        typedIrNodeIndexes: int32[]
        # Stable TypedExpr identifier-binding identity. This is the only
        # persisted binding key: producer source + parser source-local node +
        # declaration source-local row + Pattern source-local row +
        # value-definition row. Unbound rows carry -1 in every column.
        bindingProducerSourceIndexes: int32[]
        bindingParserSourceLocalNodeRows: int32[]
        bindingDeclarationSourceLocalRows: int32[]
        bindingPatternSourceLocalRows: int32[]
        bindingValueDefinitionRows: int32[]
        # Exact value-definition produced by this TypedNode. Reference-only
        # nodes carry -1; CallExpr/initializer/parameter producers carry their
        # immutable ValueDefinition row.
        producedValueDefinitionRows: int32[]
        # Exact TypedStatement row owning this node's expression DAG, or -1
        # for non-statement producer nodes such as parameter declarations.
        ownerStatementIds: int32[]
        originParserNodeIds: int32[]
        syntheticOriginKinds: int32[]
        spanAuthorityKinds: int32[]
        functionIds: int32[]
        opKinds: int32[]
        typeIds: int32[]
        valueKinds: int32[]
        captureStarts: int32[]
        captureCounts: int32[]
        # Exact TypedExprIr value-definition row identity. Capture rows never
        # use names, source lines, or Symbol rows as an approximate key.
        captureValueDefinitionRows: int32[]
        captureTypeIds: int32[]
        captureOwnershipKinds: int32[]
        ownershipKinds: int32[]
        ownershipProofKinds: int32[]
        ownershipProofCids: layout.FixedBytes32[]
        sendConclusions: bool[]
        sendProofKinds: int32[]
        sendProofCids: layout.FixedBytes32[]
        syncProofKinds: int32[]
        syncProofCids: layout.FixedBytes32[]
        syncConclusions: bool[]
        shareKinds: int32[]
        shareProofCids: layout.FixedBytes32[]
        spanIds: int32[]
        operand0NodeIds: int32[]
        operand1NodeIds: int32[]
        operand2NodeIds: int32[]

    CsgCompilerValueDefinitionTable =
        # Canonical TypedExpr value-definition rows in producer order.
        originKinds: int32[]
        groupRows: int32[]
        producerSourceIndexes: int32[]
        sourceLocalNodeIndexes: int32[]
        declarationSourceLocalRows: int32[]
        patternSourceLocalRows: int32[]
        functionIds: int32[]
        definingTypedNodeIds: int32[]
        typeIds: int32[]
        ownershipKinds: int32[]
        proofKinds: int32[]

    CsgCompilerValueDefinitionGroupTable =
        producerSourceIndexes: int32[]
        parserProducerSourceIndexes: int32[]
        initializerRootSourceLocalNodeIndexes: int32[]
        bindingOffsets: int32[]
        bindingCounts: int32[]
        functionIds: int32[]
        declarationSourceLocalRows: int32[]
        patternSourceLocalRows: int32[]
        definitionRows: int32[]
        consumedFlags: int32[]

    CsgCompilerDependencyTable =
        sourceIds: int32[]
        targetSourceIds: int32[]
        spanIds: int32[]
        dependencyKinds: int32[]
        observedInterfaceCids: layout.FixedBytes32[]

    CsgCompilerDebugOpTable =
        typedNodeIds: int32[]
        functionIds: int32[]
        spanIds: int32[]
        symbolIds: int32[]
        opKinds: int32[]

    CsgCompilerDiagnosticCompletionTable =
        # One canonical source×producer completion table. Diagnostic rows,
        # producer receipts and the required-result denominator are joined by
        # exact CSR indexes; no second completion representation exists.
        requiredDomainCid: layout.FixedBytes32
        sourceIds: int32[]
        producerKinds: int32[]
        rowStarts: int32[]
        rowCounts: int32[]
        producerReceiptCids: layout.FixedBytes32[]
        requiredStarts: int32[]
        requiredCounts: int32[]
        proofCids: layout.FixedBytes32[]
        requiredProducerIds: int32[]
        requiredProducerCids: layout.FixedBytes32[]
        requiredResultIds: int32[]
        requiredResultCids: layout.FixedBytes32[]

    CsgCompilerDiagnosticTable =
        sourceIds: int32[]
        spanIds: int32[]
        producerKinds: int32[]
        anchorKinds: int32[]
        parserNodeIds: int32[]
        ownerDeclarationIds: int32[]
        severities: int32[]
        codeTextIds: int32[]
        messageTextIds: int32[]
        proofCids: layout.FixedBytes32[]

    # All cross-row identities are snapshot-local int32 indexes. Text is held
    # once in a canonical sorted pool; tables are Arena/SoA-compatible and do
    # not retain object addresses, names, or source lines as identity keys.
    CsgCompilerSnapshotTables =
        schemaVersion: int32
        semanticEpoch: int64
        predecessorReceiptCid: layout.FixedBytes32
        texts: str[]
        sources: CsgCompilerSourceTable
        spans: CsgCompilerSpanTable
        parserNodes: CsgCompilerParserNodeTable
        tokens: CsgCompilerTokenTable
        parserSidecars: CsgCompilerParserSidecarTable
        types: CsgCompilerTypeTable
        declarations: declaration.SemanticSnapshotDeclarationTable
        symbols: CsgCompilerSymbolTable
        annotationTargets: CsgCompilerAnnotationTargetTable
        lexicalScopes: CsgCompilerLexicalScopeTable
        functions: CsgCompilerFunctionTable
        externFunctions: CsgCompilerExternFunctionTable
        externFfiHandleContracts: CsgCompilerExternFfiHandleContractTable
        readSet: CsgCompilerReadSetTable
        references: CsgCompilerReferenceTable
        calls: CsgCompilerCallTable
        layouts: CsgCompilerLayoutTable
        layoutFields: CsgCompilerLayoutFieldTable
        typedStatements: CsgCompilerTypedStatementTable
        typedNodes: CsgCompilerTypedNodeTable
        valueDefinitions: CsgCompilerValueDefinitionTable
        valueDefinitionGroups: CsgCompilerValueDefinitionGroupTable
        dependencies: CsgCompilerDependencyTable
        debugOps: CsgCompilerDebugOpTable
        diagnosticCompletions: CsgCompilerDiagnosticCompletionTable
        diagnostics: CsgCompilerDiagnosticTable

    # The two origin columns are one immutable call-result capability.  They
    # must cross the helper boundary through the same owned value definition;
    # independent mutable array outputs can otherwise publish split rows.
    CsgCompilerFunctionOriginReceiptTable =
        ok: bool
        cids: layout.FixedBytes32[]
        functionIds: int32[]
        error: str

@borrows
fn CsgCompilerSourceContentCid(sourceText: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(sourceText.len)
    for index in 0..<sourceText.len:
        layout.ByteBufAppendByte(buf, Int32(sourceText[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CsgCompilerFunctionBodyContentCidInto(
        documentCid: layout.FixedBytes32,
        sourceText: str,
        startByte: int32,
        endByte: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if layout.FixedBytes32Equal(documentCid, layout.FixedBytes32()) ||
       startByte < 0 || endByte <= startByte || endByte > sourceText.len:
        err = " csg compiler snapshot: invalid function body preimage"
        return false
    var buf = layout.ByteBufInit(96 + endByte - startByte)
    let domain = "cheng.csg_compiler.function_body_content"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[index]) & 255)
    layout.ByteBufAppendFixed32(buf, documentCid)
    for index in startByte..<endByte:
        layout.ByteBufAppendByte(buf, Int32(sourceText[index]) & 255)
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn CsgCompilerReadSetPreimageCidInto(
        readerSymbolCid: layout.FixedBytes32,
        targetDomainKinds: int32[],
        targetPortableKeyCids: layout.FixedBytes32[],
        observedValueCids: layout.FixedBytes32[],
        start: int32,
        count: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if layout.FixedBytes32Equal(readerSymbolCid, layout.FixedBytes32()) ||
       targetDomainKinds.len != targetPortableKeyCids.len ||
       targetDomainKinds.len != observedValueCids.len ||
       start < 0 || count < 0 || start > targetDomainKinds.len ||
       count > targetDomainKinds.len - start:
        err = " csg compiler snapshot: invalid read-set preimage shape"
        return false
    var buf = layout.ByteBufInit(96 + count * 68)
    let domain = "cheng.csg_compiler.function_read_set_preimage"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[index]) & 255)
    layout.ByteBufAppendFixed32(buf, readerSymbolCid)
    layout.ByteBufAppendByte(buf, (count >> 24) & 255)
    layout.ByteBufAppendByte(buf, (count >> 16) & 255)
    layout.ByteBufAppendByte(buf, (count >> 8) & 255)
    layout.ByteBufAppendByte(buf, count & 255)
    for offset in 0..<count:
        let row = start + offset
        let domainKind = targetDomainKinds[row]
        if domainKind < CsgCompilerReadDomainSourceInterface ||
           domainKind > CsgCompilerReadDomainLayout ||
           layout.FixedBytes32Equal(targetPortableKeyCids[row],
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(observedValueCids[row],
                                    layout.FixedBytes32()):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: invalid read-set preimage row"
            return false
        layout.ByteBufAppendByte(buf, (domainKind >> 24) & 255)
        layout.ByteBufAppendByte(buf, (domainKind >> 16) & 255)
        layout.ByteBufAppendByte(buf, (domainKind >> 8) & 255)
        layout.ByteBufAppendByte(buf, domainKind & 255)
        layout.ByteBufAppendFixed32(buf, targetPortableKeyCids[row])
        layout.ByteBufAppendFixed32(buf, observedValueCids[row])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn csgCompilerReadTargetObservedCidInto(
        snapshot: CsgCompilerSnapshotTables,
        domainKind: int32,
        portableKeyCid: layout.FixedBytes32,
        observedValueCid: var layout.FixedBytes32): bool =
    observedValueCid = layout.FixedBytes32()
    if !csgCompilerCidObserved(portableKeyCid):
        return false
    if domainKind == CsgCompilerReadDomainSourceInterface:
        let sourceId = csgCompilerCidFind(
            snapshot.sources.documentCids, portableKeyCid)
        if sourceId < 0 || sourceId >= snapshot.sources.interfaceCids.len:
            return false
        observedValueCid = snapshot.sources.interfaceCids[sourceId]
        return csgCompilerBorrowedCidObserved(observedValueCid)
    if domainKind == CsgCompilerReadDomainSymbolInterface:
        let symbolId = csgCompilerCidFind(
            snapshot.symbols.symbolCids, portableKeyCid)
        if symbolId < 0 || symbolId >= snapshot.symbols.interfaceCids.len:
            return false
        observedValueCid = snapshot.symbols.interfaceCids[symbolId]
        return csgCompilerBorrowedCidObserved(observedValueCid)
    if domainKind == CsgCompilerReadDomainTypeIdentity:
        let typeId = csgCompilerCidFind(
            snapshot.types.typeCids, portableKeyCid)
        if typeId < 0:
            return false
        observedValueCid = snapshot.types.typeCids[typeId]
        return true
    if domainKind == CsgCompilerReadDomainLayout:
        for layoutId in 0..<snapshot.layouts.typeIds.len:
            let typeId = snapshot.layouts.typeIds[layoutId]
            if layoutId < snapshot.layouts.layoutCids.len &&
               csgCompilerIndexValid(typeId, snapshot.types.typeCids.len) &&
               layout.FixedBytes32Equal(
                   snapshot.types.typeCids[typeId], portableKeyCid):
                observedValueCid = snapshot.layouts.layoutCids[layoutId]
                return csgCompilerBorrowedCidObserved(observedValueCid)
        return false
    return false

@borrows
fn csgCompilerCidFind(values: layout.FixedBytes32[],
                      target: layout.FixedBytes32): int32 =
    var low: int32
    var high = values.len
    while low < high:
        let middle = low + (high - low) / 2
        if csgCompilerCidLess(values[middle], target):
            low = middle + 1
        else:
            high = middle
    if low < values.len && layout.FixedBytes32Equal(values[low], target):
        return low
    return -1

@borrows
fn csgCompilerReadTargetLess(domainLeft: int32,
                             keyLeft: layout.FixedBytes32,
                             domainRight: int32,
                             keyRight: layout.FixedBytes32): bool =
    if domainLeft != domainRight:
        return domainLeft < domainRight
    return csgCompilerCidLess(keyLeft, keyRight)

@borrows
fn csgCompilerReadSetForwardPairSorted(
        domainKinds: int32[],
        keys: layout.FixedBytes32[],
        previousRow: int32,
        row: int32): bool =
    if previousRow < 0 || row <= previousRow ||
       previousRow >= domainKinds.len || row >= domainKinds.len ||
       previousRow >= keys.len || row >= keys.len:
        return false
    if domainKinds[previousRow] != domainKinds[row]:
        return domainKinds[previousRow] < domainKinds[row]
    return csgCompilerCidLess(keys[previousRow], keys[row])

@borrows
fn csgCompilerReadTargetOrderInto(snapshot: CsgCompilerSnapshotTables,
                                  order: var int32[]) =
    let readCount = snapshot.readSet.readerFunctionIds.len
    setLen(order, readCount)
    for row in 0..<readCount:
        order[row] = row
    # Stable LSD radix sort: portable key first, then domain kind.  Forward
    # row order is already FunctionId order, so equal targets retain canonical
    # reader order in the reverse CSR.
    var keyByte: int32 = layout.FixedBytes32Size - 1
    while keyByte >= 0:
        var counts: int32[]
        var offsets: int32[]
        setLen(counts, 256)
        setLen(offsets, 256)
        for index in 0..<order.len:
            let bucket = Int32(snapshot.readSet.targetPortableKeyCids[
                order[index]].data[keyByte])
            counts[bucket] = counts[bucket] + 1
        var cursor: int32
        for bucket in 0..<256:
            offsets[bucket] = cursor
            cursor = cursor + counts[bucket]
        var next: int32[]
        setLen(next, order.len)
        for index in 0..<order.len:
            let row = order[index]
            let bucket = Int32(
                snapshot.readSet.targetPortableKeyCids[row].data[keyByte])
            next[offsets[bucket]] = row
            offsets[bucket] = offsets[bucket] + 1
        order = next
        keyByte = keyByte - 1
    var domainByte: int32
    while domainByte < 4:
        var counts: int32[]
        var offsets: int32[]
        setLen(counts, 256)
        setLen(offsets, 256)
        let shift = domainByte * 8
        for index in 0..<order.len:
            let bucket = (snapshot.readSet.targetDomainKinds[
                order[index]] >> shift) & 255
            counts[bucket] = counts[bucket] + 1
        var cursor: int32
        for bucket in 0..<256:
            offsets[bucket] = cursor
            cursor = cursor + counts[bucket]
        var next: int32[]
        setLen(next, order.len)
        for index in 0..<order.len:
            let row = order[index]
            let bucket = (snapshot.readSet.targetDomainKinds[row] >> shift) & 255
            next[offsets[bucket]] = row
            offsets[bucket] = offsets[bucket] + 1
        order = next
        domainByte = domainByte + 1

@borrows
fn csgCompilerReadSetReverseExpectedInto(
        snapshot: CsgCompilerSnapshotTables,
        targetDomainKinds: var int32[],
        targetPortableKeyCids: var layout.FixedBytes32[],
        starts: var int32[],
        counts: var int32[],
        readerFunctionIds: var int32[],
        observedValueCids: var layout.FixedBytes32[],
        forwardRowIds: var int32[],
        indexCid: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    targetDomainKinds = []
    targetPortableKeyCids = []
    starts = []
    counts = []
    readerFunctionIds = []
    observedValueCids = []
    forwardRowIds = []
    let readCount = snapshot.readSet.readerFunctionIds.len
    if readCount != snapshot.readSet.targetDomainKinds.len ||
       readCount != snapshot.readSet.targetPortableKeyCids.len ||
       readCount != snapshot.readSet.observedValueCids.len:
        err = " csg compiler snapshot: reverse read-set source shape mismatch"
        return false
    var order: int32[]
    csgCompilerReadTargetOrderInto(snapshot, order)
    for row in 0..<readCount:
        var expectedObserved: layout.FixedBytes32
        if !csgCompilerIndexValid(snapshot.readSet.readerFunctionIds[row],
                                  snapshot.functions.symbolIds.len) ||
           !csgCompilerReadTargetObservedCidInto(
               snapshot, snapshot.readSet.targetDomainKinds[row],
               snapshot.readSet.targetPortableKeyCids[row],
               expectedObserved) ||
           !layout.FixedBytes32Equal(
               expectedObserved, snapshot.readSet.observedValueCids[row]):
            err = " csg compiler snapshot: invalid reverse read-set source row"
            return false
    for index in 0..<order.len:
        let row = order[index]
        let newTarget = index == 0 ||
            snapshot.readSet.targetDomainKinds[row] !=
                snapshot.readSet.targetDomainKinds[order[index - 1]] ||
            !layout.FixedBytes32Equal(
                snapshot.readSet.targetPortableKeyCids[row],
                snapshot.readSet.targetPortableKeyCids[order[index - 1]])
        if newTarget:
            add(targetDomainKinds,
                snapshot.readSet.targetDomainKinds[row])
            add(targetPortableKeyCids,
                snapshot.readSet.targetPortableKeyCids[row])
            add(starts, index)
            add(counts, 1)
        else:
            counts[counts.len - 1] = counts[counts.len - 1] + 1
    setLen(readerFunctionIds, readCount)
    setLen(observedValueCids, readCount)
    setLen(forwardRowIds, readCount)
    for reverseRow in 0..<readCount:
        let forwardRow = order[reverseRow]
        readerFunctionIds[reverseRow] =
            snapshot.readSet.readerFunctionIds[forwardRow]
        observedValueCids[reverseRow] =
            snapshot.readSet.observedValueCids[forwardRow]
        forwardRowIds[reverseRow] = forwardRow
    var buf = layout.ByteBufInit(
        128 + targetDomainKinds.len * 40 + readCount * 40)
    csgCompilerTypeCidAppendText(
        buf, "cheng.csg_compiler.read_set_reverse")
    csgCompilerTypeCidAppendU32(buf, targetDomainKinds.len)
    for targetId in 0..<targetDomainKinds.len:
        csgCompilerTypeCidAppendU32(buf, targetDomainKinds[targetId])
        layout.ByteBufAppendFixed32(buf, targetPortableKeyCids[targetId])
        csgCompilerTypeCidAppendU32(buf, starts[targetId])
        csgCompilerTypeCidAppendU32(buf, counts[targetId])
    csgCompilerTypeCidAppendU32(buf, readCount)
    for row in 0..<readCount:
        csgCompilerTypeCidAppendU32(buf, readerFunctionIds[row])
        layout.ByteBufAppendFixed32(buf, observedValueCids[row])
        csgCompilerTypeCidAppendU32(buf, forwardRowIds[row])
    indexCid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

# Canonical derived index builder.  It owns no semantic truth: every output
# column and the index CID are recomputed solely from the forward read-set.
fn CsgCompilerReadSetReverseBuildInto(
        snapshot: var CsgCompilerSnapshotTables,
        err: var str): bool =
    var targetDomainKinds: int32[]
    var targetPortableKeyCids: layout.FixedBytes32[]
    var starts: int32[]
    var counts: int32[]
    var readerFunctionIds: int32[]
    var observedValueCids: layout.FixedBytes32[]
    var forwardRowIds: int32[]
    var indexCid: layout.FixedBytes32
    if !csgCompilerReadSetReverseExpectedInto(
           snapshot, targetDomainKinds, targetPortableKeyCids,
           starts, counts, readerFunctionIds, observedValueCids,
           forwardRowIds, indexCid, err):
        return false
    snapshot.readSet.reverseIndexCid = indexCid
    snapshot.readSet.reverseTargetDomainKinds = targetDomainKinds
    snapshot.readSet.reverseTargetPortableKeyCids = targetPortableKeyCids
    snapshot.readSet.reverseStarts = starts
    snapshot.readSet.reverseCounts = counts
    snapshot.readSet.reverseReaderFunctionIds = readerFunctionIds
    snapshot.readSet.reverseObservedValueCids = observedValueCids
    snapshot.readSet.reverseForwardRowIds = forwardRowIds
    return true

@borrows
fn csgCompilerCloneI32Array(values: int32[]): int32[] =
    var out: int32[]
    for index in 0..<values.len:
        add(out, values[index])
    return out

@borrows
fn csgCompilerCloneBoolArray(values: bool[]): bool[] =
    var out: bool[]
    for index in 0..<values.len:
        add(out, values[index])
    return out

@borrows
fn csgCompilerOwnedTextCopy(value: str): str =
    return strings.stringsNewStringCopy(value.data, value.len)

@borrows
fn csgCompilerCloneTextArray(values: str[]): str[] =
    var out: str[]
    for index in 0..<values.len:
        add(out, csgCompilerOwnedTextCopy(values[index]))
    return out

@borrows
fn csgCompilerFixedBytes32Copy(
        value: layout.FixedBytes32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for index in 0..<layout.FixedBytes32Size:
        out.data[index] = value.data[index]
    return out

@borrows
fn csgCompilerCloneCidArray(
        values: layout.FixedBytes32[]): layout.FixedBytes32[] =
    var out: layout.FixedBytes32[]
    for index in 0..<values.len:
        add(out, csgCompilerFixedBytes32Copy(values[index]))
    return out

# Produces an independent owner for every mutable table column. Snapshot-local
# identities remain dense int32 indexes; no address or textual identity is
# introduced by publication.
@borrows
fn CsgCompilerSnapshotTablesClone(
        snapshot: CsgCompilerSnapshotTables): CsgCompilerSnapshotTables =
    var out: CsgCompilerSnapshotTables
    out.schemaVersion = snapshot.schemaVersion
    out.semanticEpoch = snapshot.semanticEpoch
    out.predecessorReceiptCid =
        csgCompilerFixedBytes32Copy(snapshot.predecessorReceiptCid)
    let cloned_texts = csgCompilerCloneTextArray(snapshot.texts)
    out.texts = cloned_texts
    let cloned_sources_documentCids = csgCompilerCloneCidArray(
        snapshot.sources.documentCids)
    out.sources.documentCids = cloned_sources_documentCids
    let cloned_sources_modulePathTextIds = csgCompilerCloneI32Array(
        snapshot.sources.modulePathTextIds)
    out.sources.modulePathTextIds = cloned_sources_modulePathTextIds
    let cloned_sources_contentCids = csgCompilerCloneCidArray(
        snapshot.sources.contentCids)
    out.sources.contentCids = cloned_sources_contentCids
    let cloned_sources_interfaceCids = csgCompilerCloneCidArray(
        snapshot.sources.interfaceCids)
    out.sources.interfaceCids = cloned_sources_interfaceCids
    let cloned_spans_sourceIds = csgCompilerCloneI32Array(snapshot.spans.sourceIds)
    out.spans.sourceIds = cloned_spans_sourceIds
    let cloned_spans_startBytes = csgCompilerCloneI32Array(snapshot.spans.startBytes)
    out.spans.startBytes = cloned_spans_startBytes
