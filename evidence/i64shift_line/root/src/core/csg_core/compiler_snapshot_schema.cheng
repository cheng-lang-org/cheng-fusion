    let cloned_valueDefinitionGroups_declarationSourceLocalRows = csgCompilerCloneI32Array(
            snapshot.valueDefinitionGroups.declarationSourceLocalRows)
    out.valueDefinitionGroups.declarationSourceLocalRows = cloned_valueDefinitionGroups_declarationSourceLocalRows
    let cloned_valueDefinitionGroups_patternSourceLocalRows = csgCompilerCloneI32Array(
            snapshot.valueDefinitionGroups.patternSourceLocalRows)
    out.valueDefinitionGroups.patternSourceLocalRows = cloned_valueDefinitionGroups_patternSourceLocalRows
    let cloned_valueDefinitionGroups_definitionRows = csgCompilerCloneI32Array(
            snapshot.valueDefinitionGroups.definitionRows)
    out.valueDefinitionGroups.definitionRows = cloned_valueDefinitionGroups_definitionRows
    let cloned_valueDefinitionGroups_consumedFlags = csgCompilerCloneI32Array(
            snapshot.valueDefinitionGroups.consumedFlags)
    out.valueDefinitionGroups.consumedFlags = cloned_valueDefinitionGroups_consumedFlags
    let cloned_dependencies_sourceIds = csgCompilerCloneI32Array(
        snapshot.dependencies.sourceIds)
    out.dependencies.sourceIds = cloned_dependencies_sourceIds
    let cloned_dependencies_targetSourceIds = csgCompilerCloneI32Array(
        snapshot.dependencies.targetSourceIds)
    out.dependencies.targetSourceIds = cloned_dependencies_targetSourceIds
    let cloned_dependencies_spanIds = csgCompilerCloneI32Array(
        snapshot.dependencies.spanIds)
    out.dependencies.spanIds = cloned_dependencies_spanIds
    let cloned_dependencies_dependencyKinds = csgCompilerCloneI32Array(
        snapshot.dependencies.dependencyKinds)
    out.dependencies.dependencyKinds = cloned_dependencies_dependencyKinds
    let cloned_dependencies_observedInterfaceCids = csgCompilerCloneCidArray(
        snapshot.dependencies.observedInterfaceCids)
    out.dependencies.observedInterfaceCids = cloned_dependencies_observedInterfaceCids
    let cloned_debugOps_typedNodeIds = csgCompilerCloneI32Array(
        snapshot.debugOps.typedNodeIds)
    out.debugOps.typedNodeIds = cloned_debugOps_typedNodeIds
    let cloned_debugOps_functionIds = csgCompilerCloneI32Array(
        snapshot.debugOps.functionIds)
    out.debugOps.functionIds = cloned_debugOps_functionIds
    let cloned_debugOps_spanIds = csgCompilerCloneI32Array(snapshot.debugOps.spanIds)
    out.debugOps.spanIds = cloned_debugOps_spanIds
    let cloned_debugOps_symbolIds = csgCompilerCloneI32Array(
        snapshot.debugOps.symbolIds)
    out.debugOps.symbolIds = cloned_debugOps_symbolIds
    let cloned_debugOps_opKinds = csgCompilerCloneI32Array(snapshot.debugOps.opKinds)
    out.debugOps.opKinds = cloned_debugOps_opKinds
    out.diagnosticCompletions.requiredDomainCid =
        csgCompilerFixedBytes32Copy(
            snapshot.diagnosticCompletions.requiredDomainCid)
    let cloned_diagnosticCompletions_sourceIds = csgCompilerCloneI32Array(
        snapshot.diagnosticCompletions.sourceIds)
    out.diagnosticCompletions.sourceIds = cloned_diagnosticCompletions_sourceIds
    let cloned_diagnosticCompletions_producerKinds = csgCompilerCloneI32Array(
        snapshot.diagnosticCompletions.producerKinds)
    out.diagnosticCompletions.producerKinds = cloned_diagnosticCompletions_producerKinds
    let cloned_diagnosticCompletions_rowStarts = csgCompilerCloneI32Array(
        snapshot.diagnosticCompletions.rowStarts)
    out.diagnosticCompletions.rowStarts = cloned_diagnosticCompletions_rowStarts
    let cloned_diagnosticCompletions_rowCounts = csgCompilerCloneI32Array(
        snapshot.diagnosticCompletions.rowCounts)
    out.diagnosticCompletions.rowCounts = cloned_diagnosticCompletions_rowCounts
    let cloned_diagnosticCompletions_producerReceiptCids = csgCompilerCloneCidArray(
        snapshot.diagnosticCompletions.producerReceiptCids)
    out.diagnosticCompletions.producerReceiptCids = cloned_diagnosticCompletions_producerReceiptCids
    let cloned_diagnosticCompletions_requiredStarts = csgCompilerCloneI32Array(
        snapshot.diagnosticCompletions.requiredStarts)
    out.diagnosticCompletions.requiredStarts = cloned_diagnosticCompletions_requiredStarts
    let cloned_diagnosticCompletions_requiredCounts = csgCompilerCloneI32Array(
        snapshot.diagnosticCompletions.requiredCounts)
    out.diagnosticCompletions.requiredCounts = cloned_diagnosticCompletions_requiredCounts
    let cloned_diagnosticCompletions_proofCids = csgCompilerCloneCidArray(
        snapshot.diagnosticCompletions.proofCids)
    out.diagnosticCompletions.proofCids = cloned_diagnosticCompletions_proofCids
    let cloned_diagnosticCompletions_requiredProducerIds = csgCompilerCloneI32Array(
            snapshot.diagnosticCompletions.requiredProducerIds)
    out.diagnosticCompletions.requiredProducerIds = cloned_diagnosticCompletions_requiredProducerIds
    let cloned_diagnosticCompletions_requiredProducerCids = csgCompilerCloneCidArray(
            snapshot.diagnosticCompletions.requiredProducerCids)
    out.diagnosticCompletions.requiredProducerCids = cloned_diagnosticCompletions_requiredProducerCids
    let cloned_diagnosticCompletions_requiredResultIds = csgCompilerCloneI32Array(
            snapshot.diagnosticCompletions.requiredResultIds)
    out.diagnosticCompletions.requiredResultIds = cloned_diagnosticCompletions_requiredResultIds
    let cloned_diagnosticCompletions_requiredResultCids = csgCompilerCloneCidArray(
            snapshot.diagnosticCompletions.requiredResultCids)
    out.diagnosticCompletions.requiredResultCids = cloned_diagnosticCompletions_requiredResultCids
    let cloned_diagnostics_sourceIds = csgCompilerCloneI32Array(
        snapshot.diagnostics.sourceIds)
    out.diagnostics.sourceIds = cloned_diagnostics_sourceIds
    let cloned_diagnostics_spanIds = csgCompilerCloneI32Array(
        snapshot.diagnostics.spanIds)
    out.diagnostics.spanIds = cloned_diagnostics_spanIds
    let cloned_diagnostics_producerKinds = csgCompilerCloneI32Array(
        snapshot.diagnostics.producerKinds)
    out.diagnostics.producerKinds = cloned_diagnostics_producerKinds
    let cloned_diagnostics_anchorKinds = csgCompilerCloneI32Array(
        snapshot.diagnostics.anchorKinds)
    out.diagnostics.anchorKinds = cloned_diagnostics_anchorKinds
    let cloned_diagnostics_parserNodeIds = csgCompilerCloneI32Array(
        snapshot.diagnostics.parserNodeIds)
    out.diagnostics.parserNodeIds = cloned_diagnostics_parserNodeIds
    let cloned_diagnostics_ownerDeclarationIds = csgCompilerCloneI32Array(
        snapshot.diagnostics.ownerDeclarationIds)
    out.diagnostics.ownerDeclarationIds = cloned_diagnostics_ownerDeclarationIds
    let cloned_diagnostics_severities = csgCompilerCloneI32Array(
        snapshot.diagnostics.severities)
    out.diagnostics.severities = cloned_diagnostics_severities
    let cloned_diagnostics_codeTextIds = csgCompilerCloneI32Array(
        snapshot.diagnostics.codeTextIds)
    out.diagnostics.codeTextIds = cloned_diagnostics_codeTextIds
    let cloned_diagnostics_messageTextIds = csgCompilerCloneI32Array(
        snapshot.diagnostics.messageTextIds)
    out.diagnostics.messageTextIds = cloned_diagnostics_messageTextIds
    let cloned_diagnostics_proofCids = csgCompilerCloneCidArray(
        snapshot.diagnostics.proofCids)
    out.diagnostics.proofCids = cloned_diagnostics_proofCids
    return out

fn CsgCompilerExternFfiHandleContractTableRelease(
        table: var CsgCompilerExternFfiHandleContractTable) =
    table = CsgCompilerExternFfiHandleContractTable()

fn CsgCompilerSnapshotTablesRelease(
        snapshot: var CsgCompilerSnapshotTables) =
    snapshot = CsgCompilerSnapshotTables()

@borrows
fn csgCompilerTextLess(left: str, right: str): bool =
    if left == right:
        return false
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] == right[index]:
            continue
        return left[index] < right[index]
    return left.len < right.len

@borrows
fn csgCompilerTextJsonRepresentable(value: str): bool =
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 && value[index] != '\n' && value[index] != '\r' &&
           value[index] != '\t':
            return false
    return true

@borrows
fn csgCompilerCidLess(left: layout.FixedBytes32,
                      right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] == right.data[index]:
            continue
        return left.data[index] < right.data[index]
    return false

@borrows
fn csgCompilerCidObserved(value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn csgCompilerBorrowedCidObserved(
        value: var layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if value.data[index] != 0:
            return true
    return false

fn csgCompilerIndexValid(index: int32, count: int32): bool =
    return index >= 0 && index < count

fn csgCompilerOptionalIndexValid(index: int32, count: int32): bool =
    return index == -1 || csgCompilerIndexValid(index, count)

fn csgCompilerOwnershipKindValid(kind: int32): bool =
    return kind == CsgCompilerOwnershipOwned ||
           kind == CsgCompilerOwnershipBorrowed ||
           kind == CsgCompilerOwnershipUnmanaged

@borrows
fn csgCompilerFunctionParameterOwnershipExpectedInto(
        snapshot: CsgCompilerSnapshotTables,
        functionTypeId: int32,
        parameterOffset: int32,
        out: var int32,
        err: var str): bool =
    if !csgCompilerIndexValid(
           functionTypeId, snapshot.types.typeKinds.len) ||
       functionTypeId >= snapshot.types.argStarts.len ||
       functionTypeId >= snapshot.types.argCounts.len ||
       snapshot.types.typeKinds[functionTypeId] !=
           CsgCompilerTypeFunction:
        err = " csg compiler snapshot: function parameter TypeId invalid"
        return false
    let argStart = snapshot.types.argStarts[functionTypeId]
    let argCount = snapshot.types.argCounts[functionTypeId]
    if argStart < 0 || argCount < 0 ||
       parameterOffset < 0 || parameterOffset >= argCount ||
       argStart > snapshot.types.argTypeIds.len ||
       argCount > snapshot.types.argTypeIds.len - argStart:
        err = " csg compiler snapshot: function parameter Type CSR invalid"
        return false
    let parameterTypeId =
        snapshot.types.argTypeIds[argStart + parameterOffset]
    if !csgCompilerIndexValid(
           parameterTypeId, snapshot.types.typeKinds.len) ||
       parameterTypeId >= snapshot.types.managedFlags.len:
        err = " csg compiler snapshot: function parameter exact TypeId invalid"
        return false
    if snapshot.types.typeKinds[parameterTypeId] ==
           CsgCompilerTypeBorrow:
        out = CsgCompilerOwnershipBorrowed
    elif snapshot.types.managedFlags[parameterTypeId]:
        out = CsgCompilerOwnershipOwned
    else:
        out = CsgCompilerOwnershipUnmanaged
    err = ""
    return true

fn csgCompilerSymbolKindValid(kind: int32): bool =
    return kind >= CsgCompilerSymbolModule &&
           kind <= CsgCompilerSymbolGenericParameter

fn csgCompilerReferenceKindValid(kind: int32): bool =
    return kind >= CsgCompilerReferenceRead &&
           kind <= CsgCompilerReferenceImport

fn csgCompilerPowerOfTwo(value: int32): bool =
    return value > 0 && (value & (value - 1)) == 0

@borrows
fn csgCompilerTextsValidateInto(snapshot: CsgCompilerSnapshotTables,
                                err: var str): bool =
    if snapshot.texts.len <= 0:
        err = " csg compiler snapshot: empty text pool"
        return false
    for textIndex in 0..<snapshot.texts.len:
        let current = snapshot.texts[textIndex]
        if current == "":
            err = Fmt" csg compiler snapshot: empty text row={textIndex}"
            return false
        if !csgCompilerTextJsonRepresentable(current):
            err = Fmt" csg compiler snapshot: non-json text row={textIndex} len={current.len}"
            return false
        if textIndex > 0 &&
           !csgCompilerTextLess(
               snapshot.texts[textIndex - 1], current):
            err = Fmt" csg compiler snapshot: non-canonical text order row={textIndex} previous_len={snapshot.texts[textIndex - 1].len} current_len={current.len} previous_first={Int32(snapshot.texts[textIndex - 1][0])} current_first={Int32(current[0])} previous={snapshot.texts[textIndex - 1]} current={current} equal={snapshot.texts[textIndex - 1] == current}"
            return false
    return true

@borrows
fn csgCompilerSourcesValidateInto(snapshot: CsgCompilerSnapshotTables,
                                  err: var str): bool =
    let count = snapshot.sources.documentCids.len
    if count <= 0 || count != snapshot.sources.modulePathTextIds.len ||
       count != snapshot.sources.contentCids.len ||
       count != snapshot.sources.interfaceCids.len:
        err = " csg compiler snapshot: source columns mismatch"
        return false
    for row in 0..<count:
        if !csgCompilerCidObserved(snapshot.sources.documentCids[row]):
            err = " csg compiler snapshot: source document CID missing"
            return false
        if !csgCompilerCidObserved(snapshot.sources.contentCids[row]):
            err = " csg compiler snapshot: source content CID missing"
            return false
        if !csgCompilerCidObserved(snapshot.sources.interfaceCids[row]):
            err = " csg compiler snapshot: source interface CID missing"
            return false
        if !csgCompilerIndexValid(snapshot.sources.modulePathTextIds[row],
                                  snapshot.texts.len):
            err = " csg compiler snapshot: source module-path TextId invalid"
            return false
        if row > 0 &&
           !csgCompilerCidLess(snapshot.sources.documentCids[row - 1],
                               snapshot.sources.documentCids[row]):
            err = " csg compiler snapshot: source document order invalid"
            return false
    return true

@borrows
fn csgCompilerUnsealedSourcesValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.sources.documentCids.len
    if count <= 0 || count != snapshot.sources.modulePathTextIds.len ||
       count != snapshot.sources.contentCids.len ||
       count != snapshot.sources.interfaceCids.len:
        err = " csg compiler snapshot: unsealed source columns mismatch"
        return false
    for row in 0..<count:
        if !csgCompilerCidObserved(snapshot.sources.documentCids[row]) ||
           !csgCompilerCidObserved(snapshot.sources.contentCids[row]) ||
           !layout.FixedBytes32Equal(
               snapshot.sources.interfaceCids[row],
               layout.FixedBytes32()) ||
           !csgCompilerIndexValid(
               snapshot.sources.modulePathTextIds[row],
               snapshot.texts.len) ||
           (row > 0 &&
            !csgCompilerCidLess(snapshot.sources.documentCids[row - 1],
                                snapshot.sources.documentCids[row])):
            err = " csg compiler snapshot: invalid unsealed source row"
            return false
    return true

@borrows
fn csgCompilerSpansValidateInto(snapshot: CsgCompilerSnapshotTables,
                                err: var str): bool =
    let count = snapshot.spans.sourceIds.len
    if count <= 0 || count != snapshot.spans.startBytes.len ||
       count != snapshot.spans.endBytes.len ||
       count != snapshot.spans.startLines.len ||
       count != snapshot.spans.startColumns.len ||
       count != snapshot.spans.endLines.len ||
       count != snapshot.spans.endColumns.len:
        err = " csg compiler snapshot: span columns mismatch"
        return false
    for row in 0..<count:
        if !csgCompilerIndexValid(snapshot.spans.sourceIds[row],
                                  snapshot.sources.documentCids.len) ||
           snapshot.spans.startBytes[row] < 0 ||
           snapshot.spans.endBytes[row] < snapshot.spans.startBytes[row] ||
           snapshot.spans.startLines[row] < 0 ||
           snapshot.spans.startColumns[row] < 0 ||
           snapshot.spans.endLines[row] < snapshot.spans.startLines[row] ||
           (snapshot.spans.endLines[row] == snapshot.spans.startLines[row] &&
            snapshot.spans.endColumns[row] <
                snapshot.spans.startColumns[row]) ||
           snapshot.spans.endColumns[row] < 0:
            err = " csg compiler snapshot: invalid span row"
            return false
        if row > 0:
            let previousSource = snapshot.spans.sourceIds[row - 1]
            let source = snapshot.spans.sourceIds[row]
            if source < previousSource ||
               (source == previousSource &&
                snapshot.spans.startBytes[row] <
                    snapshot.spans.startBytes[row - 1]) ||
               (source == previousSource &&
                snapshot.spans.startBytes[row] ==
                    snapshot.spans.startBytes[row - 1] &&
                snapshot.spans.endBytes[row] <=
                    snapshot.spans.endBytes[row - 1]):
                err = " csg compiler snapshot: spans are not canonical"
                return false
    return true

@borrows
fn csgCompilerParserDeclarationsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let sourceCount = snapshot.sources.documentCids.len
    let scopeCount =
        snapshot.parserSidecars.declarationLexicalScopeKinds.len
    if scopeCount <= 0 ||
       scopeCount != snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds.len ||
       scopeCount != snapshot.parserSidecars.declarationLexicalScopeSourceLocalRows.len ||
       scopeCount != snapshot.parserSidecars.declarationLexicalScopeParentIds.len ||
       scopeCount != snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds.len ||
       scopeCount != snapshot.parserSidecars.declarationLexicalScopeSpanIds.len:
        err = " csg compiler snapshot: declaration scope columns mismatch"
        return false
    let declarationCount = snapshot.parserSidecars.declarationKinds.len
    if declarationCount != snapshot.parserSidecars.declarationProducerSourceIds.len ||
       declarationCount != snapshot.parserSidecars.declarationSourceLocalRows.len ||
       declarationCount != snapshot.parserSidecars.declarationNameTokenIds.len ||
       declarationCount != snapshot.parserSidecars.declarationOwnerIds.len ||
       declarationCount != snapshot.parserSidecars.declarationLexicalScopeIds.len ||
       declarationCount != snapshot.parserSidecars.declarationFunctionRows.len ||
       declarationCount != snapshot.parserSidecars.declarationTypeSyntaxRootIds.len ||
       declarationCount !=
           snapshot.parserSidecars.declarationDefaultStatementRootRows.len ||
       declarationCount != snapshot.parserSidecars.declarationSpanIds.len ||
       declarationCount != snapshot.parserSidecars.declarationNameSpanIds.len ||
       declarationCount != snapshot.parserSidecars.declarationMutableFlags.len ||
       declarationCount != snapshot.parserSidecars.declarationExportedFlags.len:
        err = " csg compiler snapshot: declaration columns mismatch"
        return false
    var scopeSourceSeen: bool[]
    setLen(scopeSourceSeen, sourceCount)
    for scopeRow in 0..<scopeCount:
        let source = snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[scopeRow]
        let localRow = snapshot.parserSidecars.declarationLexicalScopeSourceLocalRows[scopeRow]
        let kind = snapshot.parserSidecars.declarationLexicalScopeKinds[scopeRow]
        let parent = snapshot.parserSidecars.declarationLexicalScopeParentIds[scopeRow]
        let owner = snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[scopeRow]
        let span = snapshot.parserSidecars.declarationLexicalScopeSpanIds[scopeRow]
        let ownerSpan =
            owner < 0 ? -1 :
                snapshot.parserSidecars.declarationSpanIds[owner]
        let firstForSource = scopeRow == 0 || source !=
            snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[scopeRow - 1]
        if !csgCompilerIndexValid(source, sourceCount) ||
           (scopeRow > 0 && source < snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[scopeRow - 1]) ||
           kind < 1 || kind > 4 ||
           localRow != (firstForSource ? 0 :
               snapshot.parserSidecars.declarationLexicalScopeSourceLocalRows[scopeRow - 1] + 1) ||
           parent < -1 || parent >= scopeRow ||
           (parent >= 0 && snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[parent] != source) ||
           owner < -1 || owner >= declarationCount ||
           (owner >= 0 && snapshot.parserSidecars.declarationProducerSourceIds[owner] != source) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           (owner >= 0 &&
            (!csgCompilerIndexValid(
                 ownerSpan, snapshot.spans.sourceIds.len) ||
             snapshot.spans.startBytes[ownerSpan] >
                 snapshot.spans.startBytes[span] ||
             snapshot.spans.endBytes[ownerSpan] <
                 snapshot.spans.endBytes[span])) ||
           (parent >= 0 &&
            (snapshot.spans.startBytes[span] <
                 snapshot.spans.startBytes[
                     snapshot.parserSidecars.declarationLexicalScopeSpanIds[
                         parent]] ||
             snapshot.spans.endBytes[span] >
                 snapshot.spans.endBytes[
                     snapshot.parserSidecars.declarationLexicalScopeSpanIds[
                         parent]])) ||
           (kind == 1 &&
            (parent != -1 || owner != -1 ||
             snapshot.spans.startBytes[span] != 0)):
            err = " csg compiler snapshot: invalid declaration scope row"
            return false
        scopeSourceSeen[source] = true
    for source in 0..<sourceCount:
        if !scopeSourceSeen[source]:
            err = " csg compiler snapshot: declaration scope source missing"
            return false
    var declarationFunctionCount: int32
    for row in 0..<declarationCount:
        if snapshot.parserSidecars.declarationKinds[row] ==
               CsgCompilerParserDeclarationFunction:
            declarationFunctionCount = declarationFunctionCount + 1
    var functionDeclarationSeen: bool[]
    setLen(functionDeclarationSeen, declarationFunctionCount)
    for row in 0..<declarationCount:
        let source =
            snapshot.parserSidecars.declarationProducerSourceIds[row]
        let localRow =
            snapshot.parserSidecars.declarationSourceLocalRows[row]
        let kind = snapshot.parserSidecars.declarationKinds[row]
        let token = snapshot.parserSidecars.declarationNameTokenIds[row]
        let owner = snapshot.parserSidecars.declarationOwnerIds[row]
        let scope = snapshot.parserSidecars.declarationLexicalScopeIds[row]
        let functionRow =
            snapshot.parserSidecars.declarationFunctionRows[row]
        let typeRoot =
            snapshot.parserSidecars.declarationTypeSyntaxRootIds[row]
        let defaultStatementRoot =
            snapshot.parserSidecars.declarationDefaultStatementRootRows[row]
        let span = snapshot.parserSidecars.declarationSpanIds[row]
        let nameSpan = snapshot.parserSidecars.declarationNameSpanIds[row]
        let firstForSource = row == 0 || source !=
            snapshot.parserSidecars.declarationProducerSourceIds[row - 1]
        if !csgCompilerIndexValid(source, sourceCount) ||
           (row > 0 && source < snapshot.parserSidecars.declarationProducerSourceIds[row - 1]) ||
           localRow != (firstForSource ? 0 :
               snapshot.parserSidecars.declarationSourceLocalRows[row - 1] + 1) ||
           kind < 1 || kind > 6 ||
           !csgCompilerIndexValid(token, snapshot.tokens.sourceIds.len) ||
           snapshot.tokens.sourceIds[token] != source ||
           owner < -1 || owner >= row ||
           (owner >= 0 && snapshot.parserSidecars.declarationProducerSourceIds[owner] != source) ||
           !csgCompilerIndexValid(scope, scopeCount) ||
           snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[scope] != source ||
           functionRow < -1 || functionRow >= declarationFunctionCount ||
           typeRoot < -1 ||
           defaultStatementRoot < -1 ||
           defaultStatementRoot >=
               snapshot.parserSidecars.statementRootNodeIds.len ||
           (kind != CsgCompilerParserDeclarationParameter &&
            defaultStatementRoot != -1) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           !csgCompilerIndexValid(nameSpan, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           snapshot.spans.sourceIds[nameSpan] != source ||
           (snapshot.tokens.spanIds[token] != nameSpan &&
            !(kind == CsgCompilerParserDeclarationFunction &&
              CsgCompilerBacktickNameTokenBracketValid(
                  snapshot.spans.startBytes,
                  snapshot.spans.endBytes,
                  snapshot.spans.sourceIds,
                  snapshot.tokens.sourceIds,
                  snapshot.tokens.spanIds,
                  snapshot.tokens.kinds,
                  source,
                  nameSpan,
                  token))) ||
           snapshot.spans.startBytes[nameSpan] <
               snapshot.spans.startBytes[span] ||
           snapshot.spans.endBytes[nameSpan] >
               snapshot.spans.endBytes[span]:
            err = " csg compiler snapshot: invalid declaration row"
            return false
        let ownerKind = owner < 0 ? 0 :
            snapshot.parserSidecars.declarationKinds[owner]
        if (kind == 1 &&
            (owner != -1 || functionRow != -1 || typeRoot != -1 ||
             snapshot.parserSidecars.declarationMutableFlags[row])) ||
           (kind == 2 &&
            (typeRoot < 0 || (owner >= 0 && ownerKind != 1))) ||
           (kind == 3 && functionRow < 0) ||
           (kind == 4 &&
            (owner < 0 || ownerKind != 2 || functionRow != -1 ||
             typeRoot < 0)) ||
           (kind == 5 &&
            (owner < 0 || ownerKind != 3 || functionRow < 0)) ||
           (kind == 6 &&
            ((functionRow >= 0 && (owner < 0 || ownerKind != 3)) ||
             (functionRow < 0 && owner >= 0 && ownerKind != 1 &&
              ownerKind != 2))):
            err = " csg compiler snapshot: declaration owner binding invalid"
            return false
        if kind == 3:
            if functionDeclarationSeen[functionRow]:
                err = " csg compiler snapshot: duplicate function declaration"
                return false
            functionDeclarationSeen[functionRow] = true
    for functionRow in 0..<functionDeclarationSeen.len:
        if !functionDeclarationSeen[functionRow]:
            err = " csg compiler snapshot: function declaration missing"
            return false
    var executableFunctionSeen: bool[]
    setLen(executableFunctionSeen,
        snapshot.parserSidecars.functionDeclarationSpanIds.len)
    for declarationRow in 0..<declarationCount:
        if snapshot.parserSidecars.declarationKinds[declarationRow] !=
               CsgCompilerParserDeclarationFunction:
            continue
        let declarationSpan =
            snapshot.parserSidecars.declarationSpanIds[declarationRow]
        let declarationNameSpan =
            snapshot.parserSidecars.declarationNameSpanIds[declarationRow]
        for parserFunctionRow in 0..<
                snapshot.parserSidecars.functionDeclarationSpanIds.len:
            if snapshot.parserSidecars.functionDeclarationSpanIds[
                   parserFunctionRow] != declarationSpan:
                continue
            if parserFunctionRow >=
                   snapshot.parserSidecars.functionNameSpanIds.len ||
               snapshot.parserSidecars.functionNameSpanIds[
                   parserFunctionRow] != declarationNameSpan ||
               executableFunctionSeen[parserFunctionRow]:
                err = " csg compiler snapshot: executable function declaration bridge ambiguous"
                return false
            executableFunctionSeen[parserFunctionRow] = true
    for parserFunctionRow in 0..<executableFunctionSeen.len:
        if !executableFunctionSeen[parserFunctionRow]:
            err = " csg compiler snapshot: executable function declaration missing"
            return false
    return true

@borrows
fn compilerSnapshotDeclarationForFunctionRow(
        snapshot: CsgCompilerSnapshotTables,
        functionRow: int32): int32 =
    for row in 0..<snapshot.parserSidecars.declarationKinds.len:
        if snapshot.parserSidecars.declarationKinds[row] == 3 &&
           snapshot.parserSidecars.declarationFunctionRows[row] == functionRow:
            return row
    return -1

@borrows
fn csgCompilerParserPatternsValidateInto(
        snapshot: CsgCompilerSnapshotTables,
        err: var str): bool =
    let count = snapshot.parserSidecars.patternKinds.len
    if count != snapshot.parserSidecars.patternProducerSourceIds.len ||
       count != snapshot.parserSidecars.patternSourceLocalRows.len ||
       count != snapshot.parserSidecars.patternNameTokenIds.len ||
       count != snapshot.parserSidecars.patternOwnerLexicalScopeIds.len ||
       count != snapshot.parserSidecars.patternBindingDeclarationIds.len ||
       count != snapshot.parserSidecars.patternTypeSyntaxRootIds.len ||
       count != snapshot.parserSidecars.patternSpanIds.len ||
       count != snapshot.parserSidecars.patternChildStarts.len ||
       count != snapshot.parserSidecars.patternChildCounts.len:
        err = " csg compiler snapshot: pattern columns mismatch"
        return false
    var childSeen: bool[]
    setLen(childSeen, count)
    var childCursor: int32
    for row in 0..<count:
        let source = snapshot.parserSidecars.patternProducerSourceIds[row]
        let localRow = snapshot.parserSidecars.patternSourceLocalRows[row]
        let kind = snapshot.parserSidecars.patternKinds[row]
        let nameToken = snapshot.parserSidecars.patternNameTokenIds[row]
        let scope = snapshot.parserSidecars.patternOwnerLexicalScopeIds[row]
        let declaration = snapshot.parserSidecars.patternBindingDeclarationIds[row]
        let typeSyntaxRoot =
            snapshot.parserSidecars.patternTypeSyntaxRootIds[row]
        let span = snapshot.parserSidecars.patternSpanIds[row]
        let childStart = snapshot.parserSidecars.patternChildStarts[row]
        let childCount = snapshot.parserSidecars.patternChildCounts[row]
        let firstForSource = row == 0 || source !=
            snapshot.parserSidecars.patternProducerSourceIds[row - 1]
        if !csgCompilerIndexValid(
               source, snapshot.sources.documentCids.len) ||
           (row > 0 && source <
                snapshot.parserSidecars.patternProducerSourceIds[row - 1]) ||
           localRow != (firstForSource ? 0 :
                snapshot.parserSidecars.patternSourceLocalRows[row - 1] + 1) ||
           kind < 1 || kind > 9 || nameToken < -1 ||
           nameToken >= snapshot.tokens.sourceIds.len ||
           (nameToken >= 0 &&
            snapshot.tokens.sourceIds[nameToken] != source) ||
           !csgCompilerIndexValid(
               scope,
               snapshot.parserSidecars.declarationLexicalScopeKinds.len) ||
           snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[scope] != source ||
           declaration < -1 || declaration >=
               snapshot.parserSidecars.declarationKinds.len ||
           typeSyntaxRoot < -1 ||
           typeSyntaxRoot >= snapshot.parserSidecars.typeSyntaxKinds.len ||
           (declaration >= 0 && snapshot.parserSidecars.declarationProducerSourceIds[declaration] != source) ||
           !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
           snapshot.spans.sourceIds[span] != source ||
           childStart != childCursor || childCount < 0 ||
           childStart > snapshot.parserSidecars.patternChildIds.len ||
           childCount > snapshot.parserSidecars.patternChildIds.len -
               childStart:
            err = " csg compiler snapshot: invalid pattern row"
            return false
        if kind == 1:
            if nameToken < 0 || declaration < 0 ||
               snapshot.parserSidecars.declarationKinds[declaration] != 6 ||
               snapshot.parserSidecars.declarationNameTokenIds[declaration] !=
                   nameToken ||
               snapshot.parserSidecars.declarationLexicalScopeIds[
                   declaration] != scope:
                err = " csg compiler snapshot: pattern binding drift"
                return false
        elif declaration != -1:
            err = " csg compiler snapshot: non-binding pattern declaration"
            return false
        for offset in 0..<childCount:
            let child = snapshot.parserSidecars.patternChildIds[
                childStart + offset]
            if child < 0 || child >= row || childSeen[child] ||
               snapshot.parserSidecars.patternProducerSourceIds[child] !=
                   source ||
               snapshot.parserSidecars.patternOwnerLexicalScopeIds[child] !=
                   scope:
                err = " csg compiler snapshot: invalid pattern child"
                return false
            childSeen[child] = true
        childCursor = childCursor + childCount
    if childCursor != snapshot.parserSidecars.patternChildIds.len:
        err = " csg compiler snapshot: pattern child coverage mismatch"
        return false
    return true

@borrows
fn CsgCompilerParserLexicalScopeIdentityCidInto(
        snapshot: CsgCompilerSnapshotTables,
        parserScopeId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let scopeCount =
        snapshot.parserSidecars.declarationLexicalScopeKinds.len
    if !csgCompilerIndexValid(parserScopeId, scopeCount) ||
       scopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds.len ||
       scopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeSourceLocalRows.len ||
       scopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeParentIds.len ||
       scopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds.len ||
       scopeCount !=
           snapshot.parserSidecars.declarationLexicalScopeSpanIds.len:
        err = " csg compiler snapshot: parser lexical scope identity row invalid"
        return false
    let sourceId =
        snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[
            parserScopeId]
    let spanId =
        snapshot.parserSidecars.declarationLexicalScopeSpanIds[
            parserScopeId]
    let parentScopeId =
        snapshot.parserSidecars.declarationLexicalScopeParentIds[
            parserScopeId]
    let ownerDeclarationId =
        snapshot.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
            parserScopeId]
    if !csgCompilerIndexValid(
           sourceId, snapshot.sources.documentCids.len) ||
       !csgCompilerIndexValid(
           sourceId, snapshot.parserSidecars.sidecarCids.len) ||
       !csgCompilerIndexValid(spanId, snapshot.spans.sourceIds.len) ||
       spanId >= snapshot.spans.startBytes.len ||
       spanId >= snapshot.spans.endBytes.len ||
       snapshot.spans.sourceIds[spanId] != sourceId ||
       !csgCompilerCidObserved(
           snapshot.parserSidecars.sidecarCids[sourceId]) ||
       parentScopeId < -1 || parentScopeId >= parserScopeId ||
       ownerDeclarationId < -1 ||
       ownerDeclarationId >=
           snapshot.parserSidecars.declarationKinds.len ||
       ownerDeclarationId >=
           snapshot.parserSidecars.declarationSourceLocalRows.len ||
       (parentScopeId >= 0 &&
        snapshot.parserSidecars.declarationLexicalScopeProducerSourceIds[
            parentScopeId] != sourceId) ||
       (ownerDeclarationId >= 0 &&
        snapshot.parserSidecars.declarationProducerSourceIds[
            ownerDeclarationId] != sourceId):
        err = " csg compiler snapshot: parser lexical scope identity preimage invalid"
        return false
    let parentSourceLocalRow =
        parentScopeId < 0 ? -1 :
            snapshot.parserSidecars.declarationLexicalScopeSourceLocalRows[
                parentScopeId]
    let ownerSourceLocalRow =
        ownerDeclarationId < 0 ? -1 :
            snapshot.parserSidecars.declarationSourceLocalRows[
                ownerDeclarationId]
    var buf = layout.ByteBufInit(144)
    csgCompilerParserIdentityAppendText(
        buf, "cheng.csg_compiler.parser_lexical_scope")
    layout.ByteBufAppendFixed32(
        buf, snapshot.sources.documentCids[sourceId])
    layout.ByteBufAppendFixed32(
        buf, snapshot.parserSidecars.sidecarCids[sourceId])
    csgCompilerParserIdentityAppendU32(
        buf,
        snapshot.parserSidecars.declarationLexicalScopeSourceLocalRows[
            parserScopeId])
    csgCompilerParserIdentityAppendU32(
        buf,
        snapshot.parserSidecars.declarationLexicalScopeKinds[
            parserScopeId])
    csgCompilerParserIdentityAppendU32(
        buf, parentSourceLocalRow)
    csgCompilerParserIdentityAppendU32(
        buf, ownerSourceLocalRow)
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.spans.startBytes[spanId])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.spans.endBytes[spanId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

fn csgCompilerParserIdentityAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn csgCompilerParserIdentityAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    csgCompilerParserIdentityAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn csgCompilerParserFunctionRowForDeclarationInto(
        snapshot: CsgCompilerSnapshotTables,
        parserDeclarationRow: int32,
        out: var int32,
        err: var str): bool =
    out = -1
    if !csgCompilerIndexValid(
           parserDeclarationRow,
           snapshot.parserSidecars.declarationSpanIds.len) ||
       parserDeclarationRow >=
           snapshot.parserSidecars.declarationNameSpanIds.len:
        err = " csg compiler snapshot: parser Function declaration missing"
        return false
    let declarationSpan =
        snapshot.parserSidecars.declarationSpanIds[
            parserDeclarationRow]
    let nameSpan =
        snapshot.parserSidecars.declarationNameSpanIds[
            parserDeclarationRow]
    for parserFunctionRow in 0..<
            snapshot.parserSidecars.functionDeclarationSpanIds.len:
        if snapshot.parserSidecars.functionDeclarationSpanIds[
               parserFunctionRow] != declarationSpan:
            continue
        if parserFunctionRow >=
               snapshot.parserSidecars.functionNameSpanIds.len ||
           snapshot.parserSidecars.functionNameSpanIds[
               parserFunctionRow] != nameSpan ||
           out >= 0:
            err = " csg compiler snapshot: parser Function span bridge ambiguous"
            return false
        out = parserFunctionRow
    if out < 0:
        err = " csg compiler snapshot: parser Function span bridge missing"
        return false
    err = ""
    return true

@borrows
fn csgCompilerParserIdentityAppendSpan(
        buf: var layout.ByteBuf,
        snapshot: CsgCompilerSnapshotTables,
        spanId: int32) =
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.spans.startBytes[spanId])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.spans.endBytes[spanId])

@borrows
fn CsgCompilerParserTypeSyntaxIdentityCidInto(
        snapshot: CsgCompilerSnapshotTables,
        row: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let count = snapshot.parserSidecars.typeSyntaxKinds.len
    if !csgCompilerIndexValid(row, count) ||
       row >= snapshot.parserSidecars.typeSyntaxSourceIds.len ||
       row >= snapshot.parserSidecars.typeSyntaxSourceLocalRows.len ||
       row >= snapshot.parserSidecars.typeSyntaxSpanIds.len ||
       row >= snapshot.parserSidecars.typeSyntaxChildStarts.len ||
       row >= snapshot.parserSidecars.typeSyntaxChildCounts.len ||
       row >= snapshot.parserSidecars.typeSyntaxBracketArgStarts.len ||
       row >= snapshot.parserSidecars.typeSyntaxBracketArgCounts.len ||
       row >= snapshot.parserSidecars.typeSyntaxGenericSymbolStarts.len ||
       row >= snapshot.parserSidecars.typeSyntaxGenericSymbolCounts.len ||
       row >= snapshot.parserSidecars.typeSyntaxEnumVariantStarts.len ||
       row >= snapshot.parserSidecars.typeSyntaxEnumVariantCounts.len:
        err = " csg compiler snapshot: TypeSyntax identity row out of range"
        return false
    let source = snapshot.parserSidecars.typeSyntaxSourceIds[row]
    let span = snapshot.parserSidecars.typeSyntaxSpanIds[row]
    let childStart = snapshot.parserSidecars.typeSyntaxChildStarts[row]
    let childCount = snapshot.parserSidecars.typeSyntaxChildCounts[row]
    let argStart =
        snapshot.parserSidecars.typeSyntaxBracketArgStarts[row]
    let argCount =
        snapshot.parserSidecars.typeSyntaxBracketArgCounts[row]
    if !csgCompilerIndexValid(
           source, snapshot.parserSidecars.sidecarCids.len) ||
       !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
       snapshot.spans.sourceIds[span] != source ||
       childStart < 0 || childCount < 0 ||
       childStart > snapshot.parserSidecars.typeSyntaxChildIds.len ||
       childCount >
           snapshot.parserSidecars.typeSyntaxChildIds.len - childStart ||
       argStart < 0 || argCount < 0 ||
       argStart >
           snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len ||
       argCount >
           snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts.len -
               argStart:
        err = " csg compiler snapshot: invalid TypeSyntax identity preimage"
        return false
    var buf = layout.ByteBufInit(384)
    csgCompilerParserIdentityAppendText(
        buf, "cheng.csg_compiler.parser_type_syntax")
    layout.ByteBufAppendFixed32(
        buf, snapshot.sources.documentCids[source])
    layout.ByteBufAppendFixed32(
        buf, snapshot.parserSidecars.sidecarCids[source])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeSyntaxSourceLocalRows[row])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeSyntaxKinds[row])
    csgCompilerParserIdentityAppendSpan(buf, snapshot, span)
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.tokens.sourceLocalRows[
            snapshot.parserSidecars.typeSyntaxOwnerTokenIds[row]])
    let declarationOwnerToken =
        snapshot.parserSidecars.typeSyntaxDeclarationOwnerTokenIds[row]
    csgCompilerParserIdentityAppendU32(
        buf, declarationOwnerToken < 0 ? -1 :
            snapshot.tokens.sourceLocalRows[declarationOwnerToken])
    let declarationOwner =
        snapshot.parserSidecars.typeSyntaxDeclarationOwnerIds[row]
    csgCompilerParserIdentityAppendU32(
        buf, declarationOwner < 0 ? -1 :
            snapshot.parserSidecars.typeSyntaxSourceLocalRows[
                declarationOwner])
    let nameToken = snapshot.parserSidecars.typeSyntaxNameTokenIds[row]
    csgCompilerParserIdentityAppendU32(
        buf, nameToken < 0 ? -1 :
            snapshot.tokens.sourceLocalRows[nameToken])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeSyntaxFixedLengths[row])
    let questionToken =
        snapshot.parserSidecars.typeSyntaxQuestionTokenIds[row]
    csgCompilerParserIdentityAppendU32(
        buf, questionToken < 0 ? -1 :
            snapshot.tokens.sourceLocalRows[questionToken])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeSyntaxRootKinds[row])
    csgCompilerParserIdentityAppendU32(buf, childCount)
    for offset in 0..<childCount:
        let child =
            snapshot.parserSidecars.typeSyntaxChildIds[childStart + offset]
        if child < 0 || child >= row ||
           child >= snapshot.parserSidecars.typeSyntaxIdentityCids.len ||
           !csgCompilerCidObserved(
               snapshot.parserSidecars.typeSyntaxIdentityCids[child]):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: TypeSyntax child identity missing"
            return false
        layout.ByteBufAppendFixed32(
            buf, snapshot.parserSidecars.typeSyntaxIdentityCids[child])
    csgCompilerParserIdentityAppendU32(buf, argCount)
    for offset in 0..<argCount:
        let argRow = argStart + offset
        let argType =
            snapshot.parserSidecars.typeSyntaxBracketArgTypeIds[argRow]
        let constRoot =
            snapshot.parserSidecars.typeSyntaxBracketArgConstExprRootIds[
                argRow]
        csgCompilerParserIdentityAppendU32(
            buf,
            snapshot.tokens.sourceLocalRows[
                snapshot.parserSidecars.typeSyntaxBracketArgTokenStarts[
                    argRow]])
        csgCompilerParserIdentityAppendU32(
            buf,
            snapshot.parserSidecars.typeSyntaxBracketArgTokenCounts[argRow])
        if argType >= 0:
            if argType >= row ||
               argType >= snapshot.parserSidecars.typeSyntaxIdentityCids.len ||
               !csgCompilerCidObserved(
                   snapshot.parserSidecars.typeSyntaxIdentityCids[argType]):
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: TypeSyntax bracket Type identity missing"
                return false
            layout.ByteBufAppendFixed32(
                buf, snapshot.parserSidecars.typeSyntaxIdentityCids[argType])
        else:
            layout.ByteBufAppendFixed32(buf, layout.FixedBytes32())
        if constRoot >= 0:
            if !csgCompilerIndexValid(
                   constRoot,
                   snapshot.parserSidecars.typeConstExprIdentityCids.len) ||
               !csgCompilerCidObserved(
                   snapshot.parserSidecars.typeConstExprIdentityCids[
                       constRoot]):
                layout.ByteBufFree(buf)
                err = " csg compiler snapshot: TypeSyntax const identity missing"
                return false
            layout.ByteBufAppendFixed32(
                buf,
                snapshot.parserSidecars.typeConstExprIdentityCids[constRoot])
        else:
            layout.ByteBufAppendFixed32(buf, layout.FixedBytes32())
    let genericStart =
        snapshot.parserSidecars.typeSyntaxGenericSymbolStarts[row]
    var localGenericStart: int32 = -1
    if genericStart >= 0:
        localGenericStart = 0
        for previous in 0..<genericStart:
            if snapshot.parserSidecars.typeGenericSymbolProducerSourceIds[
                   previous] == source:
                localGenericStart = localGenericStart + 1
    csgCompilerParserIdentityAppendU32(buf, localGenericStart)
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeSyntaxGenericSymbolCounts[row])
    let variantStart =
        snapshot.parserSidecars.typeSyntaxEnumVariantStarts[row]
    var localVariantStart: int32 = -1
    if variantStart >= 0:
        localVariantStart = 0
        for previous in 0..<variantStart:
            if snapshot.parserSidecars.typeEnumVariantProducerSourceIds[
                   previous] == source:
                localVariantStart = localVariantStart + 1
    csgCompilerParserIdentityAppendU32(buf, localVariantStart)
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeSyntaxEnumVariantCounts[row])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn CsgCompilerParserGenericParameterIdentityCidInto(
        snapshot: CsgCompilerSnapshotTables,
        row: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let count =
        snapshot.parserSidecars.typeGenericSymbolProducerSourceIds.len
    if !csgCompilerIndexValid(row, count):
        err = " csg compiler snapshot: generic parser identity row out of range"
        return false
    let source =
        snapshot.parserSidecars.typeGenericSymbolProducerSourceIds[row]
    let span = snapshot.parserSidecars.typeGenericSymbolSpanIds[row]
    let ownerType =
        snapshot.parserSidecars.typeGenericSymbolOwnerTypeSyntaxIds[row]
    let constraintType =
        snapshot.parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds[row]
    let defaultType =
        snapshot.parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds[row]
    if !csgCompilerIndexValid(
           source, snapshot.parserSidecars.sidecarCids.len) ||
       !csgCompilerIndexValid(span, snapshot.spans.sourceIds.len) ||
       !csgCompilerIndexValid(
           ownerType, snapshot.parserSidecars.typeSyntaxIdentityCids.len) ||
       !csgCompilerOptionalIndexValid(
           constraintType,
           snapshot.parserSidecars.typeSyntaxIdentityCids.len) ||
       !csgCompilerOptionalIndexValid(
           defaultType, snapshot.parserSidecars.typeSyntaxIdentityCids.len):
        err = " csg compiler snapshot: invalid generic parser identity preimage"
        return false
    var buf = layout.ByteBufInit(320)
    csgCompilerParserIdentityAppendText(
        buf, "cheng.csg_compiler.parser_generic_parameter")
    layout.ByteBufAppendFixed32(
        buf, snapshot.sources.documentCids[source])
    layout.ByteBufAppendFixed32(
        buf, snapshot.parserSidecars.sidecarCids[source])
    csgCompilerParserIdentityAppendU32(
        buf,
        snapshot.parserSidecars.typeGenericSymbolSourceLocalRows[row])
    csgCompilerParserIdentityAppendU32(
        buf,
        snapshot.tokens.sourceLocalRows[
            snapshot.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds[
                row]])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.tokens.sourceLocalRows[
            snapshot.parserSidecars.typeGenericSymbolNameTokenIds[row]])
    csgCompilerParserIdentityAppendU32(
        buf, snapshot.parserSidecars.typeGenericSymbolOrdinals[row])
    csgCompilerParserIdentityAppendSpan(buf, snapshot, span)
    layout.ByteBufAppendFixed32(
        buf, snapshot.parserSidecars.typeSyntaxIdentityCids[ownerType])
    layout.ByteBufAppendFixed32(
        buf, constraintType < 0 ? layout.FixedBytes32() :
            snapshot.parserSidecars.typeSyntaxIdentityCids[constraintType])
    layout.ByteBufAppendFixed32(
        buf, defaultType < 0 ? layout.FixedBytes32() :
            snapshot.parserSidecars.typeSyntaxIdentityCids[defaultType])
    let childStart =
        snapshot.parserSidecars.typeGenericSymbolChildStarts[row]
    let childCount =
        snapshot.parserSidecars.typeGenericSymbolChildCounts[row]
    csgCompilerParserIdentityAppendU32(buf, childCount)
    for offset in 0..<childCount:
        let child =
            snapshot.parserSidecars.typeGenericSymbolChildTypeSyntaxIds[
                childStart + offset]
        if !csgCompilerIndexValid(
               child, snapshot.parserSidecars.typeSyntaxIdentityCids.len):
            layout.ByteBufFree(buf)
            err = " csg compiler snapshot: generic child TypeSyntax missing"
            return false
        layout.ByteBufAppendFixed32(
            buf, snapshot.parserSidecars.typeSyntaxIdentityCids[child])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

