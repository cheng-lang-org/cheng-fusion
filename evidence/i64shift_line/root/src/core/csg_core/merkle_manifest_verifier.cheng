const
    CsgManifestVerifierObjectCountMax: int32 = 1048576
    CsgManifestVerifierPeakLiveArtifactBytesMax: int64 =
        1073741824
    CsgManifestVerifierBatchMemoryHardRed: str =
        "HARD_RED:store_staged_mapped_reader_and_bounded_semantic_admission_required"
    CsgManifestVerifierRequiredReaderInterface: str =
        "store_owned_staged_reader:map_canonical_csgc;feed_typed_object_once;finalize_after_complete_inventory;bounded_semantic_admission"
    CsgManifestVerifierStagedDynamicHardRed: str =
        "HARD_RED:cli_preallocation_owner_manifest_policy_binding_and_native_execution_identity_required"
    CsgManifestVerifierStagedProjectionDomain: str =
        "csg_core.store.manifest.staged_projection"
    CsgManifestVerifierLogicalReceiptDomain: str =
        "csg_core.store.manifest.logical_closure_receipt"
    CsgManifestVerifierAllocationReceiptWireCargoBytes: int32 = 436
    CsgManifestVerifierNativeExecutionHardRed: str =
        "HARD_RED:manifest_native_execution_identity_and_admission_binding_required"
    CsgManifestVerifierStagedPhaseEmpty: int32 = 0
    CsgManifestVerifierStagedPhaseConsuming: int32 = 1
    CsgManifestVerifierStagedPhaseFailed: int32 = 2
    CsgManifestVerifierStagedPhaseFinalized: int32 = 3
    CsgManifestObjectCanonicalCsgc: str =
        "canonical_csgc"
    CsgManifestObjectPartitionFacts: str =
        "partition_facts"
    CsgManifestObjectMembership: str =
        "membership"
    CsgManifestObjectNode: str = "node"
    CsgManifestObjectDependencyConsumer: str =
        "dependency_consumer"
    CsgManifestObjectDependencyProvider: str =
        "dependency_provider"
    CsgManifestObjectSummary: str = "summary"
    CsgManifestObjectQueryShard: str = "query_shard"

type
    CsgCoreMerkleManifestObject =
        kind: str
        index: int32
        cid: str
        bytes: rawbytes.Bytes

    CsgCoreMerkleManifestClosureResult =
        ok: bool
        error: str
        manifestCid: str
        factsRoot: str
        objectCount: int32
        queryIndexCount: int32
        residentInputArtifactBytes: int64
        peakLiveArtifactBytes: int64
        memoryHardRed: str

    CsgCoreMerkleManifestMemoryAudit =
        ok: bool
        error: str
        manifestWireBytes: int64
        objectWireBytes: int64
        residentInputArtifactBytes: int64
        largestTemporaryArtifactBytes: int64
        peakLiveArtifactBytes: int64
        objectCount: int32
        fullInventoryResident: bool
        reencodeOverlapsFullInventory: bool
        admissionOverlapsFullInventory: bool
        totalHeapBounded: bool
        hardRed: str
        requiredReaderInterface: str

    CsgCoreMerkleManifestStagedLimits =
        maxManifestWireBytes: int64
        maxObjectWireBytes: int64
        maxProjectionMetadataBytes: int64
        maxTotalWireBytes: int64
        maxObjectCount: int32
        maxFactCount: int32

    csgCoreMerkleManifestStagedObjectProjection =
        kind: str
        index: int32
        cid: str
        projectionBindingCid: str
        wireByteCount: int64
        standard: str
        profileSetCid: str
        schemaCid: str
        complete: bool
        primaryRoot: str
        secondaryRoot: str
        tertiaryRoot: str
        dependencyConsumerRoot: str
        dependencyProviderRoot: str
        queryShardRoot: str
        sourceId: str
        sourceCid: str
        factKind: str
        shardKey: str
        semanticProjection: str
        factCount: int32
        nodeCount: int32
        partitionCount: int32
        entryCount: int32
        dependencyCount: int32
        consumerShardCount: int32
        providerShardCount: int32
        queryIndexCount: int32
        queryShardCount: int32
        unsupportedCount: int32
        tombstoneCount: int32
        runtimeRequirementCount: int32

    csgCoreMerkleManifestStagedSemanticState =
        facts: str[]
        factKeys: str[]
        partitionFactStarts: int32[]
        partitionFactCounts: int32[]
        partitionSourceIds: str[]
        partitionSourceCids: str[]
        partitionFactsRoots: str[]
        expectedNodeCids: layout.FixedBytes32[]
        membershipPartitionIds: str[]
        membershipSourceIds: str[]
        membershipSourceCids: str[]
        membershipFactKeys: str[]
        membershipFactHashes: str[]
        membershipLeafCids: str[]
        dependencyConsumerSources: str[]
        dependencyConsumerProviders: str[]
        dependencyConsumerSelectors: str[]
        dependencyConsumerSubgraphs: str[]
        dependencyProviderSources: str[]
        dependencyProviderProviders: str[]
        dependencyProviderSelectors: str[]
        dependencyProviderSubgraphs: str[]
        expectedQueryKeys: str[]
        actualQueryKeys: str[]
        canonicalCsgcRebuilt: bool
        globalFactsValidated: bool
        membershipBindingsValidated: int32
        nodeBindingsValidated: int32

    CsgCoreMerkleManifestStagedState =
        phase: int32
        error: str
        manifestCid: str
        allocatorLayoutCid: str
        backingLimit: uint64
        manifest: merkle_manifest.CsgCoreMerkleManifest
        limits: CsgCoreMerkleManifestStagedLimits
        expectedObjectCount: int32
        consumedObjectCount: int32
        canonicalCsgcConsumed: int32
        partitionFactsConsumed: int32
        membershipConsumed: int32
        nodeConsumed: int32
        dependencyConsumerConsumed: int32
        dependencyProviderConsumed: int32
        summaryConsumed: int32
        queryShardConsumed: int32
        partitionFactCount: int64
        dependencyConsumerEntryCount: int64
        dependencyProviderEntryCount: int64
        queryEntryCount: int64
        totalObservedWireBytes: int64
        previousNodeCid: str
        semantic: csgCoreMerkleManifestStagedSemanticState

    CsgCoreMerkleManifestStagedResult =
        ok: bool
        error: str
        manifestCid: str
        factsRoot: str
        objectCount: int32
        queryIndexCount: int32
        totalObservedWireBytes: int64
        logicalInventoryComplete: bool
        totalHeapBounded: bool
        readerAuthorityProven: bool
        allocationReceiptVerified: bool
        receiptCidRecomputed: bool
        receiptCargoByteCount: int32
        canonicalReceiptCargoPresent: bool
        allocationReceiptCid: str
        logicalClosureReceiptCid: str
        nativeExecutionIdentityCid: str
        executionAdmissionReceiptCid: str
        nativeExecutionIdentityProven: bool
        executionReceiptBound: bool
        allocationLedgerProven: bool
        dynamicRssProven: bool
        productionReady: bool
        hardRed: str
        storeIdentityCid: str
        beforeStoreIdentity: str
        storeLayoutCid: str
        storeIdentityProven: bool

    csgCoreMerkleManifestFinalizePod =
        errorCode: int32
        manifestCid: layout.FixedBytes32
        factsRoot: layout.FixedBytes32
        csgcObjectCid: layout.FixedBytes32
        csgcByteCount: int64
        allocatorLayoutCid: layout.FixedBytes32
        backingLimit: uint64
        objectCount: int32
        queryIndexCount: int32
        totalObservedWireBytes: int64

    csgCoreMerkleManifestReceiptAudit =
        ok: bool
        cargoByteCount: int32
        cargo: rawbytes.Bytes
        receiptCid: layout.FixedBytes32

fn CsgCoreMerkleManifestCanonicalCsgcObjectKind(): str =
    return CsgManifestObjectCanonicalCsgc

fn CsgCoreMerkleManifestPartitionFactsObjectKind(): str =
    return CsgManifestObjectPartitionFacts

fn CsgCoreMerkleManifestMembershipObjectKind(): str =
    return CsgManifestObjectMembership

fn CsgCoreMerkleManifestNodeObjectKind(): str =
    return CsgManifestObjectNode

fn CsgCoreMerkleManifestDependencyConsumerObjectKind(): str =
    return CsgManifestObjectDependencyConsumer

fn CsgCoreMerkleManifestDependencyProviderObjectKind(): str =
    return CsgManifestObjectDependencyProvider

fn CsgCoreMerkleManifestSummaryObjectKind(): str =
    return CsgManifestObjectSummary

fn CsgCoreMerkleManifestQueryShardObjectKind(): str =
    return CsgManifestObjectQueryShard

fn CsgCoreMerkleManifestVerifierObjectCountMax(): int32 =
    return CsgManifestVerifierObjectCountMax

fn CsgCoreMerkleManifestVerifierPeakLiveArtifactBytesMax(): int64 =
    return CsgManifestVerifierPeakLiveArtifactBytesMax

fn CsgCoreMerkleManifestVerifierBatchMemoryHardRed(): str =
    return CsgManifestVerifierBatchMemoryHardRed

fn CsgCoreMerkleManifestVerifierRequiredReaderInterface(): str =
    return CsgManifestVerifierRequiredReaderInterface

@borrows
fn csgManifestVerifierCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgManifestVerifierFail(
        error: str):
        CsgCoreMerkleManifestClosureResult =
    var out: CsgCoreMerkleManifestClosureResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgManifestVerifierMemoryFail(
        error: str): CsgCoreMerkleManifestMemoryAudit =
    var out: CsgCoreMerkleManifestMemoryAudit
    out.error = strings.CloneStr(error)
    out.fullInventoryResident = true
    out.reencodeOverlapsFullInventory = true
    out.admissionOverlapsFullInventory = true
    out.hardRed = strings.CloneStr(
        CsgManifestVerifierBatchMemoryHardRed)
    out.requiredReaderInterface = strings.CloneStr(
        CsgManifestVerifierRequiredReaderInterface)
    return out

fn csgManifestVerifierCheckedAddInt64(
        left: int64,
        right: int64,
        value: var int64): bool =
    if left < 0 || right < 0 ||
       left > int64(9223372036854775807) - right:
        return false
    value = left + right
    return true

fn CsgCoreMerkleManifestStagedDefaultLimits():
        CsgCoreMerkleManifestStagedLimits =
    var out: CsgCoreMerkleManifestStagedLimits
    out.maxManifestWireBytes = int64(16777216)
    out.maxObjectWireBytes = int64(67108864)
    out.maxProjectionMetadataBytes = int64(65536)
    out.maxTotalWireBytes = int64(268435456)
    out.maxObjectCount = 262144
    out.maxFactCount = 262144
    return out

@borrows
fn csgManifestStagedAppendPart(
        out: var str,
        value: str) =
    out = csgManifestVerifierCat(
        out, strings.IntToStr(value.len))
    out = csgManifestVerifierCat(out, ":")
    out = csgManifestVerifierCat(out, value)

fn csgManifestStagedAppendInt32(
        out: var str,
        value: int32) =
    csgManifestStagedAppendPart(
        out, strings.IntToStr(value))

fn csgManifestStagedAppendInt64(
        out: var str,
        value: int64) =
    csgManifestStagedAppendPart(
        out, strings.Int64ToStr(value))

@borrows
fn csgManifestStagedProjectionTranscript(
        projection:
            csgCoreMerkleManifestStagedObjectProjection): str =
    var payload: str
    csgManifestStagedAppendPart(
        payload, CsgManifestVerifierStagedProjectionDomain)
    csgManifestStagedAppendInt32(payload, 31)
    csgManifestStagedAppendPart(payload, projection.kind)
    csgManifestStagedAppendInt32(payload, projection.index)
    csgManifestStagedAppendPart(payload, projection.cid)
    csgManifestStagedAppendInt64(
        payload, projection.wireByteCount)
    csgManifestStagedAppendPart(payload, projection.standard)
    csgManifestStagedAppendPart(
        payload, projection.profileSetCid)
    csgManifestStagedAppendPart(payload, projection.schemaCid)
    csgManifestStagedAppendInt32(
        payload, projection.complete ? 1 : 0)
    csgManifestStagedAppendPart(payload, projection.primaryRoot)
    csgManifestStagedAppendPart(payload, projection.secondaryRoot)
    csgManifestStagedAppendPart(payload, projection.tertiaryRoot)
    csgManifestStagedAppendPart(
        payload, projection.dependencyConsumerRoot)
    csgManifestStagedAppendPart(
        payload, projection.dependencyProviderRoot)
    csgManifestStagedAppendPart(
        payload, projection.queryShardRoot)
    csgManifestStagedAppendPart(payload, projection.sourceId)
    csgManifestStagedAppendPart(payload, projection.sourceCid)
    csgManifestStagedAppendPart(payload, projection.factKind)
    csgManifestStagedAppendPart(payload, projection.shardKey)
    csgManifestStagedAppendPart(
        payload, projection.semanticProjection)
    csgManifestStagedAppendInt32(payload, projection.factCount)
    csgManifestStagedAppendInt32(payload, projection.nodeCount)
    csgManifestStagedAppendInt32(
        payload, projection.partitionCount)
    csgManifestStagedAppendInt32(payload, projection.entryCount)
    csgManifestStagedAppendInt32(
        payload, projection.dependencyCount)
    csgManifestStagedAppendInt32(
        payload, projection.consumerShardCount)
    csgManifestStagedAppendInt32(
        payload, projection.providerShardCount)
    csgManifestStagedAppendInt32(
        payload, projection.queryIndexCount)
    csgManifestStagedAppendInt32(
        payload, projection.queryShardCount)
    csgManifestStagedAppendInt32(
        payload, projection.unsupportedCount)
    csgManifestStagedAppendInt32(
        payload, projection.tombstoneCount)
    csgManifestStagedAppendInt32(
        payload, projection.runtimeRequirementCount)
    return payload

@borrows
fn csgManifestStagedProjectionBindingCidFromTranscript(
        transcriptBytes: rawbytes.Bytes): str =
    return merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgManifestVerifierStagedProjectionDomain,
        transcriptBytes)

@borrows
fn csgManifestStagedProjectionBindingCid(
        projection:
            csgCoreMerkleManifestStagedObjectProjection): str =
    let transcript =
        csgManifestStagedProjectionTranscript(projection)
    let transcriptBytes = rawbytes.BytesFromString(transcript)
    let bindingCid =
        csgManifestStagedProjectionBindingCidFromTranscript(
            transcriptBytes)
    return bindingCid

@borrows
fn csgManifestStagedProjectionMetadataBytes(
        projection:
            csgCoreMerkleManifestStagedObjectProjection,
        transcriptBytes: rawbytes.Bytes,
        out: var int64): bool =
    # Transcript is marker + field count + 31 ordered field frames.
    # Binding CID is excluded from its hash, then added as one final frame.
    var bindingFrame: str
    csgManifestStagedAppendPart(
        bindingFrame, projection.projectionBindingCid)
    let bindingFrameBytes = rawbytes.BytesFromString(bindingFrame)
    let bindingFrameByteCount =
        int64(rawbytes.BytesLen(bindingFrameBytes))
    var total: int64
    if !csgManifestVerifierCheckedAddInt64(
           int64(rawbytes.BytesLen(transcriptBytes)),
           bindingFrameByteCount,
           total):
        return false
    out = total
    return true

@borrows
fn csgManifestStagedLimitsValid(
        limits: CsgCoreMerkleManifestStagedLimits): bool =
    return limits.maxManifestWireBytes >= int64(64) &&
        limits.maxManifestWireBytes <= int64(2147483647) &&
        limits.maxObjectWireBytes > 0 &&
        limits.maxObjectWireBytes <= int64(2147483647) &&
        limits.maxProjectionMetadataBytes > 0 &&
        limits.maxTotalWireBytes >= limits.maxObjectWireBytes &&
        limits.maxObjectCount > 0 &&
        limits.maxObjectCount <= CsgManifestVerifierObjectCountMax &&
        limits.maxFactCount > 0

@borrows
fn csgManifestStagedFail(
        state: var CsgCoreMerkleManifestStagedState,
        error: str): bool =
    state.phase = CsgManifestVerifierStagedPhaseFailed
    state.error = strings.CloneStr(error)
    return false

@borrows
fn csgManifestStagedBeginCore(
        expectedManifestCid: str,
        manifestBytes: rawbytes.Bytes,
        limits: CsgCoreMerkleManifestStagedLimits,
        state: var CsgCoreMerkleManifestStagedState): bool =
    var next: CsgCoreMerkleManifestStagedState
    next.phase = CsgManifestVerifierStagedPhaseFailed
    next.limits = limits
    state = next
    if !csgManifestStagedLimitsValid(limits):
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_limits_invalid")
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           expectedManifestCid):
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_expected_cid_invalid")
    let manifestWireBytes =
        int64(rawbytes.BytesLen(manifestBytes))
    if manifestWireBytes < int64(64) ||
       manifestWireBytes > limits.maxManifestWireBytes:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_manifest_wire_limit")
    var decoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            manifestBytes)
    if !decoded.ok:
        let decodeError = strings.CloneStr(decoded.error)
        decoded.lines = []
        return csgManifestStagedFail(
            state,
            csgManifestVerifierCat(
                "merkle_manifest_staged_manifest_decode ",
                decodeError))
    if decoded.cid != expectedManifestCid:
        decoded.lines = []
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_manifest_cid_mismatch")
    let manifest = decoded.manifest
    decoded.lines = []
    let expectedObjectCount =
        csgManifestVerifierExpectedObjectCount(manifest)
    if expectedObjectCount < 0 ||
       expectedObjectCount > limits.maxObjectCount:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_count_limit")
    if manifest.factCount > limits.maxFactCount:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_fact_count_limit")
    var ready: CsgCoreMerkleManifestStagedState
    ready.phase = CsgManifestVerifierStagedPhaseConsuming
    ready.manifestCid = strings.CloneStr(expectedManifestCid)
    ready.manifest = manifest
    ready.limits = limits
    ready.expectedObjectCount = expectedObjectCount
    ready.totalObservedWireBytes = manifestWireBytes
    state = ready
    if manifest.factCount == 0:
        var semanticError: str
        if !csgManifestSemanticFinalizeGlobalFacts(
               state, semanticError):
            return csgManifestStagedFail(state, semanticError)
    return true

@borrows
fn CsgCoreMerkleManifestStagedBeginLogical(
        expectedManifestCid: str,
        manifestBytes: rawbytes.Bytes,
        limits: CsgCoreMerkleManifestStagedLimits,
        state: var CsgCoreMerkleManifestStagedState): bool =
    return csgManifestStagedBeginCore(
        expectedManifestCid,
        manifestBytes,
        limits,
        state)

@borrows
fn CsgCoreMerkleManifestStagedBegin(
        expectedManifestCid: str,
        expectedAllocatorLayoutCid: str,
        expectedBackingLimit: uint64,
        manifestBytes: rawbytes.Bytes,
        limits: CsgCoreMerkleManifestStagedLimits,
        state: var CsgCoreMerkleManifestStagedState): bool =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           expectedAllocatorLayoutCid):
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_allocator_layout_cid_invalid")
    if expectedBackingLimit == uint64(0) ||
       expectedBackingLimit >
           mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_backing_limit_invalid")
    if !csgManifestStagedBeginCore(
           expectedManifestCid,
           manifestBytes,
           limits,
           state):
        return false
    state.allocatorLayoutCid =
        strings.CloneStr(expectedAllocatorLayoutCid)
    state.backingLimit = expectedBackingLimit
    return true

@borrows
fn csgManifestStagedExpectedObject(
        state: CsgCoreMerkleManifestStagedState,
        kind: var str,
        index: var int32,
        cid: var str): bool =
    var cursor = state.consumedObjectCount
    if cursor == 0:
        kind = strings.CloneStr(CsgManifestObjectCanonicalCsgc)
        cid = strings.CloneStr(state.manifest.csgcObjectCid)
        return true
    cursor = cursor - 1
    if cursor < state.manifest.partitions.len:
        kind = strings.CloneStr(CsgManifestObjectPartitionFacts)
        index = cursor
        cid = strings.CloneStr(
            state.manifest.partitions[cursor].factsCid)
        return true
    cursor = cursor - state.manifest.partitions.len
    if cursor < state.manifest.partitions.len:
        kind = strings.CloneStr(CsgManifestObjectMembership)
        index = cursor
        cid = strings.CloneStr(
            state.manifest.partitions[cursor].membershipCid)
        return true
    cursor = cursor - state.manifest.partitions.len
    if cursor < state.manifest.nodeCount:
        kind = strings.CloneStr(CsgManifestObjectNode)
        index = cursor
        if cursor >= state.semantic.expectedNodeCids.len:
            return false
        cid = csgManifestFixedToCid(
            state.semantic.expectedNodeCids[cursor])
        return true
    cursor = cursor - state.manifest.nodeCount
    if cursor < state.manifest.dependencyConsumerShards.len:
        kind = strings.CloneStr(
            CsgManifestObjectDependencyConsumer)
        index = cursor
        cid = strings.CloneStr(
            state.manifest.dependencyConsumerShards[cursor].cid)
        return true
    cursor =
        cursor - state.manifest.dependencyConsumerShards.len
    if cursor < state.manifest.dependencyProviderShards.len:
        kind = strings.CloneStr(
            CsgManifestObjectDependencyProvider)
        index = cursor
        cid = strings.CloneStr(
            state.manifest.dependencyProviderShards[cursor].cid)
        return true
    cursor =
        cursor - state.manifest.dependencyProviderShards.len
    if cursor == 0:
        kind = strings.CloneStr(CsgManifestObjectSummary)
        cid = strings.CloneStr(state.manifest.summaryCid)
        return true
    cursor = cursor - 1
    if cursor < state.manifest.queryShards.len:
        kind = strings.CloneStr(CsgManifestObjectQueryShard)
        index = cursor
        cid = strings.CloneStr(
            state.manifest.queryShards[cursor].cid)
        return true
    return false

@borrows
fn CsgCoreMerkleManifestStagedNextObjectIdentity(
        state: CsgCoreMerkleManifestStagedState,
        kind: var str,
        index: var int32,
        cid: var str): bool =
    if state.phase != CsgManifestVerifierStagedPhaseConsuming:
        return false
    return csgManifestStagedExpectedObject(
        state, kind, index, cid)

@borrows
fn csgManifestStagedCommonProjectionError(
        state: CsgCoreMerkleManifestStagedState,
        projection:
            csgCoreMerkleManifestStagedObjectProjection): str =
    if projection.standard != state.manifest.standard:
        return "merkle_manifest_staged_standard_mismatch"
    if projection.profileSetCid !=
       state.manifest.profileSetCid:
        return "merkle_manifest_staged_profile_set_mismatch"
    if projection.schemaCid != state.manifest.schemaCid:
        return "merkle_manifest_staged_schema_mismatch"
    if !projection.complete ||
       projection.unsupportedCount != 0 ||
       projection.tombstoneCount != 0 ||
       projection.runtimeRequirementCount != 0:
        return "merkle_manifest_staged_incomplete_projection"
    return ""

@borrows
fn csgManifestStagedNoSummaryRoots(
        projection:
            csgCoreMerkleManifestStagedObjectProjection): bool =
    return projection.dependencyConsumerRoot.len == 0 &&
        projection.dependencyProviderRoot.len == 0 &&
        projection.queryShardRoot.len == 0

@borrows
fn csgManifestStagedNoSourceFields(
        projection:
            csgCoreMerkleManifestStagedObjectProjection): bool =
    return projection.sourceId.len == 0 &&
        projection.sourceCid.len == 0 &&
        projection.factKind.len == 0

@borrows
fn csgManifestStagedNoAggregateCounts(
        projection:
            csgCoreMerkleManifestStagedObjectProjection): bool =
    return projection.nodeCount == 0 &&
        projection.partitionCount == 0 &&
        projection.dependencyCount == 0 &&
        projection.consumerShardCount == 0 &&
        projection.providerShardCount == 0 &&
        projection.queryIndexCount == 0 &&
        projection.queryShardCount == 0

@borrows
fn csgManifestStagedProjectionError(
        state: CsgCoreMerkleManifestStagedState,
        projection:
            csgCoreMerkleManifestStagedObjectProjection): str =
    let commonError =
        csgManifestStagedCommonProjectionError(
            state, projection)
    if commonError.len > 0:
        return commonError
    if projection.kind == CsgManifestObjectCanonicalCsgc:
        if projection.index != 0 ||
           projection.wireByteCount !=
               int64(state.manifest.csgcByteCount) ||
           projection.primaryRoot != state.manifest.csgcDirectoryCid ||
           projection.secondaryRoot != state.manifest.factsRoot ||
           projection.tertiaryRoot != state.manifest.dagRootCid ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           !csgManifestStagedNoSourceFields(projection) ||
           projection.shardKey.len != 0 ||
           projection.semanticProjection !=
               CsgManifestObjectCanonicalCsgc ||
           projection.factCount != state.manifest.factCount ||
           projection.nodeCount != state.manifest.nodeCount ||
           projection.partitionCount != 0 ||
           projection.entryCount != 0 ||
           projection.dependencyCount != 0 ||
           projection.consumerShardCount != 0 ||
           projection.providerShardCount != 0 ||
           projection.queryIndexCount != 0 ||
           projection.queryShardCount != 0:
            return "merkle_manifest_staged_csgc_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectPartitionFacts:
        if projection.index < 0 ||
           projection.index >= state.manifest.partitions.len:
            return "merkle_manifest_staged_partition_index_invalid"
        let descriptor = state.manifest.partitions[projection.index]
        if projection.primaryRoot != descriptor.factsRoot ||
           projection.secondaryRoot != descriptor.dagRootCid ||
           projection.tertiaryRoot.len != 0 ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           projection.sourceId != descriptor.sourceId ||
           projection.sourceCid != descriptor.sourceCid ||
           projection.factKind != descriptor.factKind ||
           projection.shardKey.len != 0 ||
           projection.semanticProjection !=
               CsgManifestObjectPartitionFacts ||
           projection.factCount != descriptor.factCount ||
           projection.entryCount != 0 ||
           !csgManifestStagedNoAggregateCounts(projection):
            return "merkle_manifest_staged_partition_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectMembership:
        if projection.index < 0 ||
           projection.index >= state.manifest.partitions.len:
            return "merkle_manifest_staged_membership_index_invalid"
        let descriptor = state.manifest.partitions[projection.index]
        if projection.primaryRoot != descriptor.factsRoot ||
           projection.secondaryRoot != descriptor.dagRootCid ||
           projection.tertiaryRoot.len != 0 ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           projection.sourceId != descriptor.sourceId ||
           projection.sourceCid != descriptor.sourceCid ||
           projection.factKind != descriptor.factKind ||
           projection.shardKey.len != 0 ||
           projection.semanticProjection != CsgManifestObjectMembership ||
           projection.factCount != descriptor.factCount ||
           projection.entryCount != descriptor.factCount ||
           !csgManifestStagedNoAggregateCounts(projection):
            return "merkle_manifest_staged_membership_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectNode:
        if projection.primaryRoot.len != 0 ||
           projection.secondaryRoot.len != 0 ||
           projection.tertiaryRoot.len != 0 ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           !csgManifestStagedNoSourceFields(projection) ||
           projection.shardKey.len != 0 ||
           projection.semanticProjection != CsgManifestObjectNode ||
           projection.factCount != 0 ||
           projection.entryCount != 0 ||
           !csgManifestStagedNoAggregateCounts(projection):
            return "merkle_manifest_staged_node_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectDependencyConsumer:
        if projection.index < 0 ||
           projection.index >=
               state.manifest.dependencyConsumerShards.len:
            return "merkle_manifest_staged_dependency_index_invalid"
        let descriptor =
            state.manifest.dependencyConsumerShards[projection.index]
        if projection.primaryRoot != descriptor.root ||
           projection.secondaryRoot.len != 0 ||
           projection.tertiaryRoot.len != 0 ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           !csgManifestStagedNoSourceFields(projection) ||
           projection.shardKey != descriptor.shardKey ||
           projection.semanticProjection !=
               merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection() ||
           projection.factCount != 0 ||
           projection.entryCount != descriptor.entryCount ||
           !csgManifestStagedNoAggregateCounts(projection):
            return "merkle_manifest_staged_dependency_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectDependencyProvider:
        if projection.index < 0 ||
           projection.index >=
               state.manifest.dependencyProviderShards.len:
            return "merkle_manifest_staged_dependency_index_invalid"
        let descriptor =
            state.manifest.dependencyProviderShards[projection.index]
        if projection.primaryRoot != descriptor.root ||
           projection.secondaryRoot.len != 0 ||
           projection.tertiaryRoot.len != 0 ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           !csgManifestStagedNoSourceFields(projection) ||
           projection.shardKey != descriptor.shardKey ||
           projection.semanticProjection !=
               merkle_artifacts.CsgCoreMerkleDependencyProviderProjection() ||
           projection.factCount != 0 ||
           projection.entryCount != descriptor.entryCount ||
           !csgManifestStagedNoAggregateCounts(projection):
            return "merkle_manifest_staged_dependency_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectSummary:
        if projection.index != 0 ||
           projection.primaryRoot != state.manifest.factsRoot ||
           projection.secondaryRoot != state.manifest.dagRootCid ||
           projection.tertiaryRoot != state.manifest.partitionRoot ||
           projection.dependencyConsumerRoot !=
               state.manifest.dependencyConsumerRoot ||
           projection.dependencyProviderRoot !=
               state.manifest.dependencyProviderRoot ||
           projection.queryShardRoot != state.manifest.queryShardRoot ||
           !csgManifestStagedNoSourceFields(projection) ||
           projection.shardKey.len != 0 ||
           projection.semanticProjection != CsgManifestObjectSummary ||
           projection.factCount != state.manifest.factCount ||
           projection.nodeCount != state.manifest.nodeCount ||
           projection.partitionCount != state.manifest.partitions.len ||
           projection.entryCount != 0 ||
           projection.dependencyCount != state.manifest.dependencyCount ||
           projection.consumerShardCount !=
               state.manifest.dependencyConsumerShards.len ||
           projection.providerShardCount !=
               state.manifest.dependencyProviderShards.len ||
           projection.queryIndexCount != state.manifest.queryIndexCount ||
           projection.queryShardCount != state.manifest.queryShards.len:
            return "merkle_manifest_staged_summary_projection_mismatch"
        return ""
    if projection.kind == CsgManifestObjectQueryShard:
        if projection.index < 0 ||
           projection.index >= state.manifest.queryShards.len:
            return "merkle_manifest_staged_query_index_invalid"
        let descriptor = state.manifest.queryShards[projection.index]
        if projection.primaryRoot != descriptor.root ||
           projection.secondaryRoot.len != 0 ||
           projection.tertiaryRoot.len != 0 ||
           !csgManifestStagedNoSummaryRoots(projection) ||
           !csgManifestStagedNoSourceFields(projection) ||
           projection.shardKey != descriptor.shardKey ||
           projection.semanticProjection != CsgManifestObjectQueryShard ||
           projection.factCount != 0 ||
           projection.entryCount != descriptor.entryCount ||
           !csgManifestStagedNoAggregateCounts(projection):
            return "merkle_manifest_staged_query_projection_mismatch"
        return ""
    return "merkle_manifest_staged_kind_invalid"

@borrows
fn csgManifestSemanticTuplePart(value: str): str =
    return csgManifestVerifierCat(
        csgManifestVerifierCat(
            strings.IntToStr(value.len), ":"),
        value)

@borrows
fn csgManifestSemanticDependencyKey(
        consumerSource: str,
        providerSource: str,
        selector: str,
        providerSubgraphCid: str): str =
    return csgManifestVerifierCat(
        csgManifestVerifierCat(
            csgManifestSemanticTuplePart(consumerSource),
            csgManifestSemanticTuplePart(providerSource)),
        csgManifestVerifierCat(
            csgManifestSemanticTuplePart(selector),
            csgManifestSemanticTuplePart(providerSubgraphCid)))

@borrows
fn csgManifestSemanticQueryKey(
        indexKind: str,
        term: str,
        factKey: str,
        factHash: str,
        leafCid: str,
        partitionId: str,
        sourceId: str,
        sourceCid: str): str =
    var out: str
    csgManifestStagedAppendPart(out, indexKind)
    csgManifestStagedAppendPart(out, term)
    csgManifestStagedAppendPart(out, factKey)
    csgManifestStagedAppendPart(out, factHash)
    csgManifestStagedAppendPart(out, leafCid)
    csgManifestStagedAppendPart(out, partitionId)
    csgManifestStagedAppendPart(out, sourceId)
    csgManifestStagedAppendPart(out, sourceCid)
    return out

@borrows
fn csgManifestSemanticSourcePresent(
        state: CsgCoreMerkleManifestStagedState,
        sourceId: str): bool =
    for i in 0..<state.semantic.partitionSourceIds.len:
        if state.semantic.partitionSourceIds[i] == sourceId:
            return true
    return false

@borrows
fn csgManifestSemanticSourceSubgraphPresent(
        state: CsgCoreMerkleManifestStagedState,
        sourceId: str,
        subgraphCid: str): bool =
    for i in 0..<state.semantic.partitionSourceIds.len:
        if state.semantic.partitionSourceIds[i] == sourceId &&
           state.semantic.partitionFactsRoots[i] == subgraphCid:
            return true
    return false

@borrows
fn csgManifestSemanticSourceCidConsistencyError(
        state: CsgCoreMerkleManifestStagedState): str =
    if state.semantic.partitionSourceIds.len !=
           state.semantic.partitionSourceCids.len:
        return "merkle_manifest_staged_source_columns_mismatch"
    let order = csgManifestVerifierSortedOrder(
        state.semantic.partitionSourceIds)
    for i in 1..<order.len:
        let previous = order[i - 1]
        let current = order[i]
        if state.semantic.partitionSourceIds[previous] ==
               state.semantic.partitionSourceIds[current] &&
           state.semantic.partitionSourceCids[previous] !=
               state.semantic.partitionSourceCids[current]:
            return "merkle_manifest_staged_source_cid_conflict"
    return ""

@borrows
fn csgManifestSemanticFinalizeGlobalFacts(
        state: var CsgCoreMerkleManifestStagedState,
        error: var str): bool =
    if state.manifest.factCount == 0:
        let emptyDag = merkle_dag.CsgCoreMerkleBuild([])
        if !emptyDag.ok || state.semantic.facts.len != 0 ||
           state.manifest.nodeCount != 0 ||
           emptyDag.factsRoot != state.manifest.factsRoot ||
           merkle_dag.CsgCoreMerkleDagRootCid(emptyDag) !=
               state.manifest.dagRootCid:
            error = "merkle_manifest_staged_empty_root_mismatch"
            return false
        var emptyCsgc = csgc.CsgCoreCsgcEncodeCanonicalLines([])
        if !emptyCsgc.ok ||
           merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
               emptyCsgc.bytes) != state.manifest.csgcObjectCid:
            rawbytes.BytesFree(emptyCsgc.bytes)
            error = "merkle_manifest_staged_empty_csgc_mismatch"
            return false
        let emptyCsgcError =
            merkle_manifest.CsgCoreMerkleManifestCanonicalCsgcError(
                state.manifest, emptyCsgc.bytes)
        rawbytes.BytesFree(emptyCsgc.bytes)
        if emptyCsgcError.len > 0:
            error = strings.CloneStr(emptyCsgcError)
            return false
        state.semantic.canonicalCsgcRebuilt = true
        state.semantic.globalFactsValidated = true
        error = ""
        return true
    var dag: merkle_dag.CsgCoreMerkleDag
    let validation =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            state.semantic.facts, dag)
    if !validation.valid || !validation.complete ||
       validation.factCount != state.manifest.factCount ||
       validation.standard != state.manifest.standard ||
       !validator.CsgCoreProfilesEqual(
           validation.profiles, state.manifest.profiles) ||
       validation.profileSetCid != state.manifest.profileSetCid ||
       validation.unsupportedCount != 0 ||
       validation.tombstoneCount != 0 ||
       validation.runtimeRequirementCount != 0:
        error = validation.errors.len > 0 ?
            csgManifestVerifierCat(
                "merkle_manifest_staged_fact_validation ",
                validation.errors[0]) :
            "merkle_manifest_staged_fact_validation_failed"
        return false
    if !dag.ok || dag.schemaCid != state.manifest.schemaCid ||
       dag.factCount != state.manifest.factCount ||
       dag.factsRoot != state.manifest.factsRoot ||
       merkle_dag.CsgCoreMerkleDagRootCid(dag) !=
           state.manifest.dagRootCid ||
       dag.nodeKinds.len != state.manifest.nodeCount:
        error = "merkle_manifest_staged_global_root_mismatch"
        return false
    let sourceError =
        csgManifestSemanticSourceCidConsistencyError(state)
    if sourceError.len > 0:
        error = strings.CloneStr(sourceError)
        return false
    var rebuilt =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            state.semantic.facts)
    if !rebuilt.ok ||
       merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
           rebuilt.bytes) != state.manifest.csgcObjectCid:
        rawbytes.BytesFree(rebuilt.bytes)
        error = "merkle_manifest_staged_csgc_rebuild_mismatch"
        return false
    let rebuiltError =
        merkle_manifest.CsgCoreMerkleManifestCanonicalCsgcError(
            state.manifest, rebuilt.bytes)
    rawbytes.BytesFree(rebuilt.bytes)
    if rebuiltError.len > 0:
        error = csgManifestVerifierCat(
            "merkle_manifest_staged_csgc_rebuild ",
            rebuiltError)
        return false
    var nodeCids: str[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        var nodeError: str
        let node = merkle_dag.CsgCoreMerkleDagNodeRecord(
            dag, nodeIndex, nodeError)
        if nodeError.len > 0:
            error = csgManifestVerifierCat(
                "merkle_manifest_staged_node_projection ",
                nodeError)
            return false
        add(
            nodeCids,
            merkle_dag.CsgCoreMerkleNodeRecordCid(node))
    let nodeOrder = csgManifestVerifierSortedOrder(nodeCids)
    for i in 0..<nodeOrder.len:
        if i > 0 &&
           csgManifestVerifierTextCompare(
               nodeCids[nodeOrder[i - 1]],
               nodeCids[nodeOrder[i]]) >= 0:
            error = "merkle_manifest_staged_node_identity_duplicate"
            return false
        var nodeIdentity: layout.FixedBytes32
        if !csgManifestCidToFixed(
               nodeCids[nodeOrder[i]], nodeIdentity):
            error = "merkle_manifest_staged_node_identity_invalid"
            return false
        add(state.semantic.expectedNodeCids, nodeIdentity)
    state.semantic.canonicalCsgcRebuilt = true
    state.semantic.globalFactsValidated = true
    error = ""
    return true

@borrows
fn csgManifestSemanticConsumePartition(
        state: var CsgCoreMerkleManifestStagedState,
        index: int32,
        decoded: merkle_artifacts.CsgCoreMerklePartitionFactsResult,
        error: var str): bool =
    add(state.semantic.partitionFactStarts, state.semantic.facts.len)
    add(state.semantic.partitionFactCounts, decoded.facts.len)
    add(
        state.semantic.partitionSourceIds,
        strings.CloneStr(state.manifest.partitions[index].sourceId))
    add(
        state.semantic.partitionSourceCids,
        strings.CloneStr(state.manifest.partitions[index].sourceCid))
    add(
        state.semantic.partitionFactsRoots,
        strings.CloneStr(state.manifest.partitions[index].factsRoot))
    let partitionDag = merkle_dag.CsgCoreMerkleBuild(decoded.facts)
    if !partitionDag.ok ||
       partitionDag.subgraphCid != state.manifest.partitions[index].factsRoot ||
       merkle_dag.CsgCoreMerkleDagRootCid(partitionDag) !=
           state.manifest.partitions[index].dagRootCid:
        error = "merkle_manifest_staged_partition_dag_mismatch"
        return false
    for factIndex in 0..<decoded.facts.len:
        let kind = field.CsgCoreJsonKind(decoded.facts[factIndex])
        var keyError: str
        let factKey = merkle_dag.CsgCoreMerkleFactKey(
            decoded.facts[factIndex], keyError)
        if !kind.found ||
           kind.value != state.manifest.partitions[index].factKind ||
           keyError.len > 0:
            error = "merkle_manifest_staged_partition_fact_mismatch"
            return false
        add(
            state.semantic.facts,
            strings.CloneStr(decoded.facts[factIndex]))
        add(
            state.semantic.factKeys,
            strings.CloneStr(factKey))
    if index == state.manifest.partitions.len - 1:
        return csgManifestSemanticFinalizeGlobalFacts(state, error)
    error = ""
    return true

@borrows
fn csgManifestSemanticAppendExpectedQuery(
        state: var CsgCoreMerkleManifestStagedState,
        indexKind: str,
        term: str,
        record: merkle_artifacts.CsgCoreMerkleMembershipRecord) =
    if term.len == 0:
        return
    add(
        state.semantic.expectedQueryKeys,
        csgManifestSemanticQueryKey(
            indexKind,
            term,
            record.factKey,
            record.factHash,
            record.leafCid,
            record.partitionId,
            record.sourceId,
            record.sourceCid))

@borrows
fn csgManifestSemanticConsumeMembership(
        state: var CsgCoreMerkleManifestStagedState,
        index: int32,
        decoded: merkle_artifacts.CsgCoreMerkleMembershipResult,
        error: var str): bool =
    let start = state.semantic.partitionFactStarts[index]
    let count = state.semantic.partitionFactCounts[index]
    var partitionFacts: str[]
    var partitionKeys: str[]
    for i in start..<(start + count):
        add(partitionFacts, strings.CloneStr(state.semantic.facts[i]))
        add(partitionKeys, strings.CloneStr(state.semantic.factKeys[i]))
    let dag = merkle_dag.CsgCoreMerkleBuild(partitionFacts)
    if !dag.ok || decoded.records.len != count:
        error = "merkle_manifest_staged_membership_dag_invalid"
        return false
    var leafKeys: str[]
    var leafFactHashes: str[]
    var leafCids: str[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        if dag.nodeKinds[nodeIndex] !=
           merkle_dag.CsgCoreMerkleLeafNodeKind():
            continue
        var nodeError: str
        let node = merkle_dag.CsgCoreMerkleDagNodeRecord(
            dag, nodeIndex, nodeError)
        if nodeError.len > 0:
            error = "merkle_manifest_staged_membership_leaf_invalid"
            return false
        add(leafKeys, strings.CloneStr(node.key))
        add(
            leafFactHashes,
            csgManifestFixedToCid(node.factHash))
        add(
            leafCids,
            merkle_dag.CsgCoreMerkleNodeRecordCid(node))
    let leafOrder = csgManifestVerifierSortedOrder(leafKeys)
    let factOrder = csgManifestVerifierSortedOrder(partitionKeys)
    let partitionId =
        merkle_manifest.CsgCoreMerklePartitionId(
            state.manifest.partitions[index])
    if leafOrder.len != decoded.records.len ||
       factOrder.len != decoded.records.len:
        error = "merkle_manifest_staged_membership_count_mismatch"
        return false
    for i in 0..<decoded.records.len:
        let leafAt = leafOrder[i]
        let factAt = factOrder[i]
        if decoded.records[i].partitionId != partitionId ||
           decoded.records[i].sourceId !=
               state.manifest.partitions[index].sourceId ||
           decoded.records[i].sourceCid !=
               state.manifest.partitions[index].sourceCid ||
           decoded.records[i].factKey != leafKeys[leafAt] ||
           decoded.records[i].factHash != leafFactHashes[leafAt] ||
           decoded.records[i].leafCid != leafCids[leafAt] ||
           decoded.records[i].factKey != partitionKeys[factAt]:
            error = "merkle_manifest_staged_membership_binding_mismatch"
            return false
        add(
            state.semantic.membershipPartitionIds,
            strings.CloneStr(decoded.records[i].partitionId))
        add(
            state.semantic.membershipSourceIds,
            strings.CloneStr(decoded.records[i].sourceId))
        add(
            state.semantic.membershipSourceCids,
            strings.CloneStr(decoded.records[i].sourceCid))
        add(
            state.semantic.membershipFactKeys,
            strings.CloneStr(decoded.records[i].factKey))
        add(
            state.semantic.membershipFactHashes,
            strings.CloneStr(decoded.records[i].factHash))
        add(
            state.semantic.membershipLeafCids,
            strings.CloneStr(decoded.records[i].leafCid))
        let kind = field.CsgCoreJsonKind(partitionFacts[factAt])
        if !kind.found:
            error = "merkle_manifest_staged_query_fact_kind_missing"
            return false
        csgManifestSemanticAppendExpectedQuery(
            state, "fact_key", decoded.records[i].factKey,
            decoded.records[i])
        csgManifestSemanticAppendExpectedQuery(
            state, "kind", kind.value, decoded.records[i])
        for fieldIndex in 0..<4:
            let fieldName =
                fieldIndex == 0 ? "symbol" :
                fieldIndex == 1 ? "name" :
                fieldIndex == 2 ? "file" : "caller"
            let optional =
                field.CsgCoreJsonTopStringField(
                    partitionFacts[factAt], fieldName)
            if optional.found:
                csgManifestSemanticAppendExpectedQuery(
                    state, fieldName, optional.value,
                    decoded.records[i])
    state.semantic.membershipBindingsValidated =
        state.semantic.membershipBindingsValidated + 1
    error = ""
    return true

@borrows
fn csgManifestSemanticConsumeDependency(
        state: var CsgCoreMerkleManifestStagedState,
        consumerProjection: bool,
        records: merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        error: var str): bool =
    for i in 0..<records.len:
        let record = records[i]
        if !csgManifestSemanticSourcePresent(
               state, record.consumerSource) ||
           !csgManifestSemanticSourcePresent(
               state, record.providerSource) ||
           !csgManifestSemanticSourceSubgraphPresent(
               state,
               record.providerSource,
               record.providerSubgraphCid):
            error = "merkle_manifest_staged_dependency_source_mismatch"
            return false
        if consumerProjection:
            add(state.semantic.dependencyConsumerSources,
                strings.CloneStr(record.consumerSource))
            add(state.semantic.dependencyConsumerProviders,
                strings.CloneStr(record.providerSource))
            add(state.semantic.dependencyConsumerSelectors,
                strings.CloneStr(record.selector))
            add(state.semantic.dependencyConsumerSubgraphs,
                strings.CloneStr(record.providerSubgraphCid))
        else:
            add(state.semantic.dependencyProviderSources,
                strings.CloneStr(record.consumerSource))
            add(state.semantic.dependencyProviderProviders,
                strings.CloneStr(record.providerSource))
            add(state.semantic.dependencyProviderSelectors,
                strings.CloneStr(record.selector))
            add(state.semantic.dependencyProviderSubgraphs,
                strings.CloneStr(record.providerSubgraphCid))
    error = ""
    return true

@borrows
fn csgManifestSemanticConsumeQuery(
        state: var CsgCoreMerkleManifestStagedState,
        records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]) =
    for i in 0..<records.len:
        let record = records[i]
        add(
            state.semantic.actualQueryKeys,
            csgManifestSemanticQueryKey(
                record.indexKind,
                record.term,
                record.factKey,
                record.factHash,
                record.leafCid,
                record.partitionId,
                record.sourceId,
                record.sourceCid))

@borrows
fn csgManifestStagedProjectionBase(
        state: CsgCoreMerkleManifestStagedState,
        kind: str,
        index: int32,
        wireByteCount: int64):
        csgCoreMerkleManifestStagedObjectProjection =
    var out: csgCoreMerkleManifestStagedObjectProjection
    out.kind = strings.CloneStr(kind)
    out.index = index
    out.wireByteCount = wireByteCount
    out.standard = strings.CloneStr(state.manifest.standard)
    out.profileSetCid = strings.CloneStr(state.manifest.profileSetCid)
    out.schemaCid = strings.CloneStr(state.manifest.schemaCid)
    out.complete = state.manifest.complete
    out.unsupportedCount = state.manifest.unsupportedCount
    out.tombstoneCount = state.manifest.tombstoneCount
    out.runtimeRequirementCount =
        state.manifest.runtimeRequirementCount
    return out

@borrows
fn csgManifestStagedDecodeObjectProjection(
        state: var CsgCoreMerkleManifestStagedState,
        kind: str,
        index: int32,
        expectedCid: str,
        bytes: rawbytes.Bytes,
        projection: var
            csgCoreMerkleManifestStagedObjectProjection,
        error: var str): bool =
    projection = csgManifestStagedProjectionBase(
        state, kind, index, int64(rawbytes.BytesLen(bytes)))
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(expectedCid):
        error = "merkle_manifest_staged_expected_object_cid_invalid"
        return false
    if kind == CsgManifestObjectCanonicalCsgc:
        let actualCid =
            merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
                bytes)
        let canonicalError =
            merkle_manifest.CsgCoreMerkleManifestCanonicalCsgcError(
                state.manifest, bytes)
        if actualCid != expectedCid || canonicalError.len > 0:
            error = canonicalError.len > 0 ?
                csgManifestVerifierCat(
                    "merkle_manifest_staged_csgc_decode ",
                    canonicalError) :
                "merkle_manifest_staged_csgc_cid_mismatch"
            return false
        projection.cid = strings.CloneStr(actualCid)
        projection.primaryRoot =
            strings.CloneStr(state.manifest.csgcDirectoryCid)
        projection.secondaryRoot =
            strings.CloneStr(state.manifest.factsRoot)
        projection.tertiaryRoot =
            strings.CloneStr(state.manifest.dagRootCid)
        projection.semanticProjection =
            strings.CloneStr(CsgManifestObjectCanonicalCsgc)
        projection.factCount = state.manifest.factCount
        projection.nodeCount = state.manifest.nodeCount
    elif kind == CsgManifestObjectPartitionFacts:
        var decoded =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(bytes)
        if !decoded.ok || decoded.cid != expectedCid:
            error = decoded.ok ?
                "merkle_manifest_staged_partition_cid_mismatch" :
                csgManifestVerifierCat(
                    "merkle_manifest_staged_partition_decode ",
                    decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return false
        if decoded.header.partitionId !=
               merkle_manifest.CsgCoreMerklePartitionId(
                   state.manifest.partitions[index]) ||
           decoded.header.sourceId !=
               state.manifest.partitions[index].sourceId ||
           decoded.header.sourceCid !=
               state.manifest.partitions[index].sourceCid ||
           decoded.header.factKind !=
               state.manifest.partitions[index].factKind:
            rawbytes.BytesFree(decoded.bytes)
            error = "merkle_manifest_staged_partition_header_mismatch"
            return false
        if !csgManifestSemanticConsumePartition(
               state, index, decoded, error):
            rawbytes.BytesFree(decoded.bytes)
            return false
        projection.cid = strings.CloneStr(decoded.cid)
        projection.primaryRoot = strings.CloneStr(decoded.factsRoot)
        projection.secondaryRoot = strings.CloneStr(decoded.dagRootCid)
        projection.sourceId = strings.CloneStr(decoded.header.sourceId)
        projection.sourceCid = strings.CloneStr(decoded.header.sourceCid)
        projection.factKind = strings.CloneStr(decoded.header.factKind)
        projection.semanticProjection =
            strings.CloneStr(CsgManifestObjectPartitionFacts)
        projection.factCount = decoded.factCount
        rawbytes.BytesFree(decoded.bytes)
    elif kind == CsgManifestObjectMembership:
        var decoded =
            merkle_artifacts.CsgCoreMerkleMembershipDecode(bytes)
        if !decoded.ok || decoded.cid != expectedCid:
            error = decoded.ok ?
                "merkle_manifest_staged_membership_cid_mismatch" :
                csgManifestVerifierCat(
                    "merkle_manifest_staged_membership_decode ",
                    decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return false
        if decoded.header.partitionId !=
               merkle_manifest.CsgCoreMerklePartitionId(
                   state.manifest.partitions[index]) ||
           decoded.header.sourceId !=
               state.manifest.partitions[index].sourceId ||
           decoded.header.sourceCid !=
               state.manifest.partitions[index].sourceCid ||
           decoded.header.factKind !=
               state.manifest.partitions[index].factKind ||
           decoded.header.factsCid !=
               state.manifest.partitions[index].factsCid ||
           decoded.header.factsRoot !=
               state.manifest.partitions[index].factsRoot ||
           decoded.header.dagRootCid !=
               state.manifest.partitions[index].dagRootCid ||
           decoded.header.factCount !=
               state.manifest.partitions[index].factCount ||
           decoded.recordCount !=
               state.manifest.partitions[index].factCount:
            rawbytes.BytesFree(decoded.bytes)
            error = "merkle_manifest_staged_membership_header_mismatch"
            return false
        if !csgManifestSemanticConsumeMembership(
               state, index, decoded, error):
            rawbytes.BytesFree(decoded.bytes)
            return false
        projection.cid = strings.CloneStr(decoded.cid)
        projection.primaryRoot =
            strings.CloneStr(decoded.header.factsRoot)
        projection.secondaryRoot =
            strings.CloneStr(decoded.header.dagRootCid)
        projection.sourceId = strings.CloneStr(decoded.header.sourceId)
        projection.sourceCid = strings.CloneStr(decoded.header.sourceCid)
        projection.factKind = strings.CloneStr(decoded.header.factKind)
        projection.semanticProjection =
            strings.CloneStr(CsgManifestObjectMembership)
        projection.factCount = decoded.header.factCount
        projection.entryCount = decoded.recordCount
        rawbytes.BytesFree(decoded.bytes)
    elif kind == CsgManifestObjectNode:
        var decoded =
            merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(bytes)
        if !decoded.ok || decoded.nodes.len != 1:
            error = decoded.ok ?
                "merkle_manifest_staged_node_cardinality_invalid" :
                csgManifestVerifierCat(
                    "merkle_manifest_staged_node_decode ",
                    decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return false
        let actualCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(decoded.nodes[0])
        rawbytes.BytesFree(decoded.bytes)
        if actualCid != expectedCid ||
           index < 0 ||
           index >= state.semantic.expectedNodeCids.len ||
           actualCid != csgManifestFixedToCid(
               state.semantic.expectedNodeCids[index]):
            error = "merkle_manifest_staged_node_cid_mismatch"
            return false
        state.semantic.nodeBindingsValidated =
            state.semantic.nodeBindingsValidated + 1
        projection.cid = strings.CloneStr(actualCid)
        projection.semanticProjection =
            strings.CloneStr(CsgManifestObjectNode)
    elif kind == CsgManifestObjectDependencyConsumer ||
         kind == CsgManifestObjectDependencyProvider:
        var decoded =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(bytes)
        if !decoded.ok || decoded.cid != expectedCid:
            error = decoded.ok ?
                "merkle_manifest_staged_dependency_cid_mismatch" :
                csgManifestVerifierCat(
                    "merkle_manifest_staged_dependency_decode ",
                    decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return false
        projection.cid = strings.CloneStr(decoded.cid)
        projection.profileSetCid =
            strings.CloneStr(decoded.header.profileSetCid)
        projection.primaryRoot = strings.CloneStr(decoded.shardRoot)
        projection.shardKey = strings.CloneStr(decoded.header.shardKey)
        projection.semanticProjection =
            strings.CloneStr(decoded.header.projection)
        projection.entryCount = decoded.entryCount
        if !csgManifestSemanticConsumeDependency(
               state,
               kind == CsgManifestObjectDependencyConsumer,
               decoded.records,
               error):
            rawbytes.BytesFree(decoded.bytes)
            return false
        rawbytes.BytesFree(decoded.bytes)
    elif kind == CsgManifestObjectSummary:
        var decoded =
            merkle_artifacts.CsgCoreMerkleSummaryDecode(bytes)
        if !decoded.ok || decoded.cid != expectedCid:
            error = decoded.ok ?
                "merkle_manifest_staged_summary_cid_mismatch" :
                csgManifestVerifierCat(
                    "merkle_manifest_staged_summary_decode ",
                    decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return false
        let header = decoded.header
        if !validator.CsgCoreProfilesEqual(
               header.profiles, state.manifest.profiles):
            rawbytes.BytesFree(decoded.bytes)
            error = "merkle_manifest_staged_summary_profiles_mismatch"
            return false
        projection.cid = strings.CloneStr(decoded.cid)
        projection.standard = strings.CloneStr(header.standard)
        projection.profileSetCid = strings.CloneStr(header.profileSetCid)
        projection.schemaCid = strings.CloneStr(header.schemaCid)
        projection.complete = header.complete
        projection.primaryRoot = strings.CloneStr(header.factsRoot)
        projection.secondaryRoot = strings.CloneStr(header.dagRootCid)
        projection.tertiaryRoot = strings.CloneStr(header.partitionRoot)
        projection.dependencyConsumerRoot =
            strings.CloneStr(header.dependencyConsumerRoot)
        projection.dependencyProviderRoot =
            strings.CloneStr(header.dependencyProviderRoot)
        projection.queryShardRoot = strings.CloneStr(header.queryShardRoot)
        projection.semanticProjection =
            strings.CloneStr(CsgManifestObjectSummary)
        projection.factCount = header.factCount
        projection.nodeCount = header.nodeCount
        projection.partitionCount = header.partitionCount
        projection.dependencyCount = header.dependencyCount
        projection.consumerShardCount =
            header.dependencyConsumerShardCount
        projection.providerShardCount =
            header.dependencyProviderShardCount
        projection.queryIndexCount = header.queryIndexCount
        projection.queryShardCount = header.queryShardCount
        projection.unsupportedCount = header.unsupportedCount
        projection.tombstoneCount = header.tombstoneCount
        projection.runtimeRequirementCount =
            header.runtimeRequirementCount
        rawbytes.BytesFree(decoded.bytes)
    elif kind == CsgManifestObjectQueryShard:
        var decoded =
            merkle_artifacts.CsgCoreMerkleQueryShardDecode(bytes)
        if !decoded.ok || decoded.cid != expectedCid:
            error = decoded.ok ?
                "merkle_manifest_staged_query_cid_mismatch" :
                csgManifestVerifierCat(
                    "merkle_manifest_staged_query_decode ",
                    decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return false
        projection.cid = strings.CloneStr(decoded.cid)
        projection.profileSetCid =
            strings.CloneStr(decoded.header.profileSetCid)
        projection.primaryRoot = strings.CloneStr(decoded.shardRoot)
        projection.shardKey = strings.CloneStr(decoded.header.bucket)
        projection.semanticProjection =
            strings.CloneStr(CsgManifestObjectQueryShard)
        projection.entryCount = decoded.entryCount
        csgManifestSemanticConsumeQuery(state, decoded.records)
        rawbytes.BytesFree(decoded.bytes)
    else:
        error = "merkle_manifest_staged_kind_invalid"
        return false
    projection.projectionBindingCid =
        csgManifestStagedProjectionBindingCid(projection)
    error = ""
    return true

@borrows
fn CsgCoreMerkleManifestStagedConsumeObject(
        state: var CsgCoreMerkleManifestStagedState,
        kind: str,
        index: int32,
        expectedCid: str,
        bytes: rawbytes.Bytes): bool =
    if state.phase != CsgManifestVerifierStagedPhaseConsuming:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_state_not_consuming")
    let wireByteCount = int64(rawbytes.BytesLen(bytes))
    var boundedTotalWireBytes: int64
    if wireByteCount <= 0 ||
       wireByteCount > state.limits.maxObjectWireBytes ||
       !csgManifestVerifierCheckedAddInt64(
           state.totalObservedWireBytes,
           wireByteCount,
           boundedTotalWireBytes) ||
       boundedTotalWireBytes > state.limits.maxTotalWireBytes:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_wire_limit")
    var expectedKind: str
    var expectedIndex: int32
    var inventoryCid: str
    if !csgManifestStagedExpectedObject(
           state, expectedKind, expectedIndex, inventoryCid) ||
       kind != expectedKind || index != expectedIndex ||
       (inventoryCid.len > 0 && expectedCid != inventoryCid):
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_inventory_identity_mismatch")
    var projection: csgCoreMerkleManifestStagedObjectProjection
    var error: str
    if !csgManifestStagedDecodeObjectProjection(
           state,
           kind,
           index,
           expectedCid,
           bytes,
           projection,
           error):
        return csgManifestStagedFail(state, error)
    return csgManifestStagedConsumeProjection(state, projection)

@borrows
fn csgManifestStagedConsumeProjection(
        state: var CsgCoreMerkleManifestStagedState,
        projection:
            csgCoreMerkleManifestStagedObjectProjection): bool =
    if state.phase != CsgManifestVerifierStagedPhaseConsuming:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_state_not_consuming")
    if state.consumedObjectCount >= state.expectedObjectCount:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_trailing_data")
    if projection.wireByteCount <= 0 ||
       projection.wireByteCount > state.limits.maxObjectWireBytes:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_wire_limit")
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           projection.cid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           projection.projectionBindingCid):
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_projection_cid_invalid")
    let projectionTranscript =
        csgManifestStagedProjectionTranscript(projection)
    let projectionTranscriptBytes =
        rawbytes.BytesFromString(projectionTranscript)
    let expectedBindingCid =
        csgManifestStagedProjectionBindingCidFromTranscript(
            projectionTranscriptBytes)
    if projection.projectionBindingCid != expectedBindingCid:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_projection_binding_mismatch")
    var projectionMetadataBytes: int64
    let projectionMetadataValid =
        csgManifestStagedProjectionMetadataBytes(
           projection,
           projectionTranscriptBytes,
           projectionMetadataBytes)
    if !projectionMetadataValid ||
       projectionMetadataBytes >
           state.limits.maxProjectionMetadataBytes:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_projection_wire_limit")
    var totalObservedWireBytes: int64
    if !csgManifestVerifierCheckedAddInt64(
           state.totalObservedWireBytes,
           projection.wireByteCount,
           totalObservedWireBytes) ||
       totalObservedWireBytes > state.limits.maxTotalWireBytes:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_total_wire_limit")
    var expectedKind: str
    var expectedIndex: int32
    var expectedCid: str
    if !csgManifestStagedExpectedObject(
           state, expectedKind, expectedIndex, expectedCid):
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_inventory_exhausted")
    if projection.kind != expectedKind:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_kind_mismatch")
    if projection.index != expectedIndex:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_index_mismatch")
    if expectedCid.len > 0 && projection.cid != expectedCid:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_object_cid_mismatch")
    if projection.kind == CsgManifestObjectNode &&
       state.previousNodeCid.len > 0 &&
       csgManifestVerifierTextCompare(
           state.previousNodeCid, projection.cid) >= 0:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_node_non_canonical")
    let projectionError =
        csgManifestStagedProjectionError(
            state, projection)
    if projectionError.len > 0:
        return csgManifestStagedFail(
            state, projectionError)
    if projection.kind == CsgManifestObjectCanonicalCsgc:
        state.canonicalCsgcConsumed =
            state.canonicalCsgcConsumed + 1
    elif projection.kind == CsgManifestObjectPartitionFacts:
        state.partitionFactsConsumed =
            state.partitionFactsConsumed + 1
        var nextPartitionFactCount: int64
        if !csgManifestVerifierCheckedAddInt64(
               state.partitionFactCount,
               int64(projection.factCount),
               nextPartitionFactCount):
            return csgManifestStagedFail(
                state, "merkle_manifest_staged_partition_count_overflow")
        state.partitionFactCount = nextPartitionFactCount
    elif projection.kind == CsgManifestObjectMembership:
        state.membershipConsumed = state.membershipConsumed + 1
    elif projection.kind == CsgManifestObjectNode:
        state.nodeConsumed = state.nodeConsumed + 1
        state.previousNodeCid = strings.CloneStr(projection.cid)
    elif projection.kind == CsgManifestObjectDependencyConsumer:
        state.dependencyConsumerConsumed =
            state.dependencyConsumerConsumed + 1
        var nextConsumerCount: int64
        if !csgManifestVerifierCheckedAddInt64(
               state.dependencyConsumerEntryCount,
               int64(projection.entryCount),
               nextConsumerCount):
            return csgManifestStagedFail(
                state, "merkle_manifest_staged_consumer_count_overflow")
        state.dependencyConsumerEntryCount = nextConsumerCount
    elif projection.kind == CsgManifestObjectDependencyProvider:
        state.dependencyProviderConsumed =
            state.dependencyProviderConsumed + 1
        var nextProviderCount: int64
        if !csgManifestVerifierCheckedAddInt64(
               state.dependencyProviderEntryCount,
               int64(projection.entryCount),
               nextProviderCount):
            return csgManifestStagedFail(
                state, "merkle_manifest_staged_provider_count_overflow")
        state.dependencyProviderEntryCount = nextProviderCount
    elif projection.kind == CsgManifestObjectSummary:
        state.summaryConsumed = state.summaryConsumed + 1
    elif projection.kind == CsgManifestObjectQueryShard:
        state.queryShardConsumed = state.queryShardConsumed + 1
        var nextQueryCount: int64
        if !csgManifestVerifierCheckedAddInt64(
               state.queryEntryCount,
               int64(projection.entryCount),
               nextQueryCount):
            return csgManifestStagedFail(
                state, "merkle_manifest_staged_query_count_overflow")
        state.queryEntryCount = nextQueryCount
    else:
        return csgManifestStagedFail(
            state, "merkle_manifest_staged_kind_unreachable")
    state.consumedObjectCount = state.consumedObjectCount + 1
    state.totalObservedWireBytes = totalObservedWireBytes
    return true

@borrows
fn csgManifestCidToFixed(
        value: str,
        out: var layout.FixedBytes32): bool =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(value):
        return false
    let hexText = strings.SliceBytes(value, 7, 64)
    let parsed = layout.FixedBytes32FromHex(hexText)
    if IsErr(parsed):
        return false
    out = Value(parsed)
    return true

@borrows
fn csgManifestFixedToCid(value: layout.FixedBytes32): str =
    return strings.ConcatStr(
        "sha256:", layout.FixedBytes32Hex(value))

@borrows
fn csgManifestSemanticSortedExactError(
        left: str[],
        right: str[],
        mismatchError: str,
        duplicateError: str): str =
    if left.len != right.len:
        return strings.CloneStr(mismatchError)
    let leftOrder = csgManifestVerifierSortedOrder(left)
    let rightOrder = csgManifestVerifierSortedOrder(right)
    for i in 0..<leftOrder.len:
        if left[leftOrder[i]] != right[rightOrder[i]]:
            return strings.CloneStr(mismatchError)
        if i > 0 &&
           (left[leftOrder[i - 1]] == left[leftOrder[i]] ||
            right[rightOrder[i - 1]] == right[rightOrder[i]]):
            return strings.CloneStr(duplicateError)
    return ""

@borrows
fn csgManifestSemanticDependencyError(
        state: CsgCoreMerkleManifestStagedState): str =
    let consumerCount =
        state.semantic.dependencyConsumerSources.len
    let providerCount =
        state.semantic.dependencyProviderSources.len
    if consumerCount != state.manifest.dependencyCount ||
       providerCount != state.manifest.dependencyCount ||
       state.semantic.dependencyConsumerProviders.len != consumerCount ||
       state.semantic.dependencyConsumerSelectors.len != consumerCount ||
       state.semantic.dependencyConsumerSubgraphs.len != consumerCount ||
       state.semantic.dependencyProviderProviders.len != providerCount ||
       state.semantic.dependencyProviderSelectors.len != providerCount ||
       state.semantic.dependencyProviderSubgraphs.len != providerCount:
        return "merkle_manifest_staged_dependency_columns_mismatch"
    var consumers: str[]
    var providers: str[]
    for i in 0..<consumerCount:
        add(
            consumers,
            csgManifestSemanticDependencyKey(
                state.semantic.dependencyConsumerSources[i],
                state.semantic.dependencyConsumerProviders[i],
                state.semantic.dependencyConsumerSelectors[i],
                state.semantic.dependencyConsumerSubgraphs[i]))
    for i in 0..<providerCount:
        add(
            providers,
            csgManifestSemanticDependencyKey(
                state.semantic.dependencyProviderSources[i],
                state.semantic.dependencyProviderProviders[i],
                state.semantic.dependencyProviderSelectors[i],
                state.semantic.dependencyProviderSubgraphs[i]))
    return csgManifestSemanticSortedExactError(
        consumers,
        providers,
        "merkle_manifest_staged_dependency_inverse_mismatch",
        "merkle_manifest_staged_dependency_duplicate")

@borrows
fn csgManifestSemanticClosureError(
        state: CsgCoreMerkleManifestStagedState): str =
    if !state.semantic.canonicalCsgcRebuilt ||
       !state.semantic.globalFactsValidated ||
       state.semantic.facts.len != state.manifest.factCount ||
       state.semantic.factKeys.len != state.manifest.factCount ||
       state.semantic.membershipBindingsValidated !=
           state.manifest.partitions.len ||
       state.semantic.membershipFactKeys.len !=
           state.manifest.factCount ||
       state.semantic.nodeBindingsValidated !=
           state.manifest.nodeCount ||
       state.semantic.expectedNodeCids.len !=
           state.manifest.nodeCount:
        return "merkle_manifest_staged_semantic_closure_incomplete"
    let dependencyError = csgManifestSemanticDependencyError(state)
    if dependencyError.len > 0:
        return dependencyError
    if state.semantic.actualQueryKeys.len !=
           state.manifest.queryIndexCount ||
       state.semantic.expectedQueryKeys.len !=
           state.manifest.queryIndexCount:
        return "merkle_manifest_staged_query_count_mismatch"
    return csgManifestSemanticSortedExactError(
        state.semantic.expectedQueryKeys,
        state.semantic.actualQueryKeys,
        "merkle_manifest_staged_query_inverse_mismatch",
        "merkle_manifest_staged_query_duplicate")

@borrows
fn csgManifestStagedFinalizePod(
        state: CsgCoreMerkleManifestStagedState):
        csgCoreMerkleManifestFinalizePod =
    var out: csgCoreMerkleManifestFinalizePod
    if state.phase != CsgManifestVerifierStagedPhaseConsuming:
        out.errorCode = 1
        return out
    if state.consumedObjectCount != state.expectedObjectCount:
        out.errorCode = 2
        return out
    if state.canonicalCsgcConsumed != 1 ||
       state.partitionFactsConsumed != state.manifest.partitions.len ||
       state.membershipConsumed != state.manifest.partitions.len ||
       state.nodeConsumed != state.manifest.nodeCount ||
       state.dependencyConsumerConsumed !=
           state.manifest.dependencyConsumerShards.len ||
       state.dependencyProviderConsumed !=
           state.manifest.dependencyProviderShards.len ||
       state.summaryConsumed != 1 ||
       state.queryShardConsumed != state.manifest.queryShards.len:
        out.errorCode = 3
        return out
    if state.partitionFactCount != int64(state.manifest.factCount):
        out.errorCode = 4
        return out
    if state.dependencyConsumerEntryCount !=
           int64(state.manifest.dependencyCount) ||
       state.dependencyProviderEntryCount !=
           int64(state.manifest.dependencyCount):
        out.errorCode = 5
        return out
    if state.queryEntryCount != int64(state.manifest.queryIndexCount):
        out.errorCode = 6
        return out
    let semanticError = csgManifestSemanticClosureError(state)
    if semanticError.len > 0:
        out.errorCode = 8
        return out
    if !csgManifestCidToFixed(
           state.manifestCid, out.manifestCid) ||
       !csgManifestCidToFixed(
           state.manifest.factsRoot, out.factsRoot) ||
       !csgManifestCidToFixed(
           state.manifest.csgcObjectCid, out.csgcObjectCid):
        out.errorCode = 7
        return out
    if state.allocatorLayoutCid.len > 0 &&
       !csgManifestCidToFixed(
           state.allocatorLayoutCid, out.allocatorLayoutCid):
        out.errorCode = 7
        return out
    out.backingLimit = state.backingLimit
    out.csgcByteCount = int64(state.manifest.csgcByteCount)
    out.objectCount = state.consumedObjectCount
    out.queryIndexCount = state.manifest.queryIndexCount
    out.totalObservedWireBytes = state.totalObservedWireBytes
    return out

fn csgManifestStagedReleaseManaged(
        state: var CsgCoreMerkleManifestStagedState) =
    state.error = ""
    state.manifestCid = ""
    state.allocatorLayoutCid = ""
    state.manifest = merkle_manifest.CsgCoreMerkleManifest()
    state.previousNodeCid = ""
    state.semantic = csgCoreMerkleManifestStagedSemanticState()

@borrows
fn csgManifestFixedWord(
        value: layout.FixedBytes32,
        wordIndex: int32): uint64 =
    var out: uint64
    let start = wordIndex * 8
    for byteIndex in 0..<8:
        out = (out << uint64(8)) |
            uint64(value.data[start + byteIndex])
    return out

# The canonical receipt cargo is the exact 436-byte preimage the independent
# system consumer hashes to the published receipt CID: a little-endian u64
# domain length, the domain text, then the 48 non-root wire fields in wire
# order. The cargo is real bytes, never a size constant, and is only accepted
# when it re-hashes to the receipt's published CID.
@borrows
fn csgManifestCargoPutU64LE(
        cargo: var rawbytes.Bytes,
        offset: var int32,
        value: uint64) =
    for byteIndex in 0..<8:
        rawbytes.BytesSet(
            cargo,
            offset + byteIndex,
            int32((value >> uint64(byteIndex * 8)) & uint64(255)))
    offset = offset + 8

@borrows
fn csgManifestAllocationReceiptWire(
        receipt: mapped_reader.CsgCoreCsgcMappedAllocationReceipt):
        system.RuntimeAllocationLedgerReceiptWire =
    var out: system.RuntimeAllocationLedgerReceiptWire
    out.abiMagic = uint64(0x43484c4452435054)
    out.abiByteSize = uint64(384)
    out.complete = receipt.complete ? 1 : 0
    out.active = receipt.active ? 1 : 0
    out.closed = receipt.closed ? 1 : 0
    out.operation = int32(receipt.operation)
    out.storageKind = int32(receipt.storageKind)
    out.rawManagedPointerAbaProven =
        receipt.rawManagedPointerAbaProven ? 1 : 0
    out.recursiveLockProven =
        receipt.recursiveLockProven ? 1 : 0
    out.capabilityGeneration = receipt.capabilityGeneration
    out.allocationId = receipt.allocationId
    out.ownerGeneration = receipt.ownerGeneration
    out.allocationGeneration = receipt.allocationGeneration
    out.slabId = receipt.slabId
    out.slabGeneration = receipt.slabGeneration
    out.slabBackingBytes = receipt.slabBackingBytes
    out.backingDeltaBytes = receipt.backingDeltaBytes
    out.reallocOverlapUsableBytes = receipt.reallocOverlapUsableBytes
    out.requestedPayloadBytes = receipt.requestedPayloadBytes
    out.usablePayloadBytes = receipt.usablePayloadBytes
    out.headerBytes = receipt.headerBytes
    out.backingBytes = receipt.backingBytes
    out.alignmentBytes = receipt.alignmentBytes
    out.layout0 = csgManifestFixedWord(receipt.allocatorLayoutCid, 0)
    out.layout1 = csgManifestFixedWord(receipt.allocatorLayoutCid, 1)
    out.layout2 = csgManifestFixedWord(receipt.allocatorLayoutCid, 2)
    out.layout3 = csgManifestFixedWord(receipt.allocatorLayoutCid, 3)
    out.ownerDomain0 = csgManifestFixedWord(receipt.ownerDomainCid, 0)
    out.ownerDomain1 = csgManifestFixedWord(receipt.ownerDomainCid, 1)
    out.ownerDomain2 = csgManifestFixedWord(receipt.ownerDomainCid, 2)
    out.ownerDomain3 = csgManifestFixedWord(receipt.ownerDomainCid, 3)
    out.eventChain0 = csgManifestFixedWord(receipt.eventChainCid, 0)
    out.eventChain1 = csgManifestFixedWord(receipt.eventChainCid, 1)
    out.eventChain2 = csgManifestFixedWord(receipt.eventChainCid, 2)
    out.eventChain3 = csgManifestFixedWord(receipt.eventChainCid, 3)
    out.backingLimit = receipt.backingLimit
    out.controlPlaneBackingBytes = receipt.controlPlaneBackingBytes
    out.liveBackingBytes = receipt.liveBackingBytes
    out.peakBackingBytes = receipt.peakBackingBytes
    out.liveMappedVirtualBytes = receipt.liveMappedVirtualBytes
    out.peakMappedVirtualBytes = receipt.peakMappedVirtualBytes
    out.liveAllocationCount = receipt.liveAllocationCount
    out.peakAllocationCount = receipt.peakAllocationCount
    out.liveMappingCount = receipt.liveMappingCount
    out.liveHandleCount = receipt.liveHandleCount
    out.peakHandleCount = receipt.peakHandleCount
    out.eventIndex = receipt.eventIndex
    out.receipt0 = csgManifestFixedWord(receipt.receiptCid, 0)
    out.receipt1 = csgManifestFixedWord(receipt.receiptCid, 1)
    out.receipt2 = csgManifestFixedWord(receipt.receiptCid, 2)
    out.receipt3 = csgManifestFixedWord(receipt.receiptCid, 3)
    return out

fn csgManifestRuntimeCidMatchesFixed(
        actual: system.RuntimeAllocationLedgerCid,
        expected: layout.FixedBytes32): bool =
    return actual.word0 == csgManifestFixedWord(expected, 0) &&
        actual.word1 == csgManifestFixedWord(expected, 1) &&
        actual.word2 == csgManifestFixedWord(expected, 2) &&
        actual.word3 == csgManifestFixedWord(expected, 3)

@borrows
fn csgManifestCanonicalReceiptCargo(
        receipt: mapped_reader.CsgCoreCsgcMappedAllocationReceipt):
        Result[rawbytes.Bytes] =
    let wire = csgManifestAllocationReceiptWire(receipt)
    var cargo = rawbytes.BytesAlloc(
        CsgManifestVerifierAllocationReceiptWireCargoBytes)
    if rawbytes.BytesLen(cargo) !=
       CsgManifestVerifierAllocationReceiptWireCargoBytes:
        return Err[rawbytes.Bytes](
            "merkle_manifest_receipt_cargo_alloc_failed")
    var offset: int32
    let domain = "cheng.runtime.allocation_ledger.receipt_wire"
    csgManifestCargoPutU64LE(cargo, offset, uint64(domain.len))
    for byteIndex in 0..<domain.len:
        rawbytes.BytesSet(cargo, offset, int32(domain[byteIndex]))
        offset = offset + 1
    csgManifestCargoPutU64LE(cargo, offset, wire.abiMagic)
    csgManifestCargoPutU64LE(cargo, offset, wire.abiByteSize)
    csgManifestCargoPutU64LE(cargo, offset, uint64(wire.complete))
    csgManifestCargoPutU64LE(cargo, offset, uint64(wire.active))
    csgManifestCargoPutU64LE(cargo, offset, uint64(wire.closed))
    csgManifestCargoPutU64LE(cargo, offset, uint64(wire.operation))
    csgManifestCargoPutU64LE(cargo, offset, uint64(wire.storageKind))
    csgManifestCargoPutU64LE(
        cargo, offset, uint64(wire.rawManagedPointerAbaProven))
    csgManifestCargoPutU64LE(
        cargo, offset, uint64(wire.recursiveLockProven))
    csgManifestCargoPutU64LE(cargo, offset, uint64(wire.reserved))
    csgManifestCargoPutU64LE(cargo, offset, wire.capabilityGeneration)
    csgManifestCargoPutU64LE(cargo, offset, wire.allocationId)
    csgManifestCargoPutU64LE(cargo, offset, wire.ownerGeneration)
    csgManifestCargoPutU64LE(cargo, offset, wire.allocationGeneration)
    csgManifestCargoPutU64LE(cargo, offset, wire.slabId)
    csgManifestCargoPutU64LE(cargo, offset, wire.slabGeneration)
    csgManifestCargoPutU64LE(cargo, offset, wire.slabBackingBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.backingDeltaBytes)
    csgManifestCargoPutU64LE(
        cargo, offset, wire.reallocOverlapUsableBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.requestedPayloadBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.usablePayloadBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.headerBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.backingBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.alignmentBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.layout0)
    csgManifestCargoPutU64LE(cargo, offset, wire.layout1)
    csgManifestCargoPutU64LE(cargo, offset, wire.layout2)
    csgManifestCargoPutU64LE(cargo, offset, wire.layout3)
    csgManifestCargoPutU64LE(cargo, offset, wire.ownerDomain0)
    csgManifestCargoPutU64LE(cargo, offset, wire.ownerDomain1)
    csgManifestCargoPutU64LE(cargo, offset, wire.ownerDomain2)
    csgManifestCargoPutU64LE(cargo, offset, wire.ownerDomain3)
    csgManifestCargoPutU64LE(cargo, offset, wire.eventChain0)
    csgManifestCargoPutU64LE(cargo, offset, wire.eventChain1)
    csgManifestCargoPutU64LE(cargo, offset, wire.eventChain2)
    csgManifestCargoPutU64LE(cargo, offset, wire.eventChain3)
    csgManifestCargoPutU64LE(cargo, offset, wire.backingLimit)
    csgManifestCargoPutU64LE(
        cargo, offset, wire.controlPlaneBackingBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.liveBackingBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.peakBackingBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.liveMappedVirtualBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.peakMappedVirtualBytes)
    csgManifestCargoPutU64LE(cargo, offset, wire.liveAllocationCount)
    csgManifestCargoPutU64LE(cargo, offset, wire.peakAllocationCount)
    csgManifestCargoPutU64LE(cargo, offset, wire.liveMappingCount)
    csgManifestCargoPutU64LE(cargo, offset, wire.liveHandleCount)
    csgManifestCargoPutU64LE(cargo, offset, wire.peakHandleCount)
    csgManifestCargoPutU64LE(cargo, offset, wire.eventIndex)
    if offset != CsgManifestVerifierAllocationReceiptWireCargoBytes:
        rawbytes.BytesFree(cargo)
        return Err[rawbytes.Bytes](
            "merkle_manifest_receipt_cargo_frame_mismatch")
    var cargoDigest = sha256.Sha256Digest(cargo)
    let cargoFixed = layout.FixedBytes32FromBytes(cargoDigest)
    rawbytes.BytesFree(cargoDigest)
    if IsErr(cargoFixed) ||
       !layout.FixedBytes32Equal(
           Value(cargoFixed), receipt.receiptCid):
        rawbytes.BytesFree(cargo)
        return Err[rawbytes.Bytes](
            "merkle_manifest_receipt_cargo_cid_mismatch")
    return Ok[rawbytes.Bytes](cargo)

@borrows
fn csgManifestAllocationReceiptAudit(
        expected: csgCoreMerkleManifestFinalizePod,
        receipt: mapped_reader.CsgCoreCsgcMappedAllocationReceipt):
        csgCoreMerkleManifestReceiptAudit =
    var out: csgCoreMerkleManifestReceiptAudit
    if expected.errorCode != 0 ||
       !receipt.beginAttempted || !receipt.ownerActivated ||
       !receipt.mappingReceiptValid || !receipt.closeAttempted ||
       !receipt.closeSucceeded || !receipt.complete || receipt.active ||
       !receipt.closed || !receipt.objectDigestVerified ||
       receipt.objectDigestCount != 1 ||
       receipt.verifiedByteLength != expected.csgcByteCount ||
       !receipt.expectedObjectCidValid ||
       !layout.FixedBytes32Equal(
           receipt.expectedObjectCid, expected.csgcObjectCid) ||
       receipt.capabilityGeneration == uint64(0) ||
       receipt.ownerGeneration != receipt.capabilityGeneration ||
       receipt.operation != system.RuntimeAllocationLedgerOpClose ||
       receipt.storageKind != system.RuntimeAllocationLedgerStorageNone ||
       receipt.backingLimit != expected.backingLimit ||
       receipt.backingLimit >
           mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit ||
       receipt.controlPlaneBackingBytes == uint64(0) ||
       receipt.liveBackingBytes != receipt.controlPlaneBackingBytes ||
       receipt.peakBackingBytes < receipt.liveBackingBytes ||
       receipt.peakBackingBytes > receipt.backingLimit ||
       receipt.liveMappedVirtualBytes != uint64(0) ||
       receipt.peakMappedVirtualBytes == uint64(0) ||
       receipt.liveAllocationCount != uint64(0) ||
       receipt.peakAllocationCount == uint64(0) ||
       receipt.liveMappingCount != uint64(0) ||
       receipt.liveHandleCount != uint64(0) ||
       receipt.peakHandleCount == uint64(0) ||
       !receipt.rawManagedPointerAbaProven ||
       !receipt.recursiveLockProven ||
       receipt.eventIndex == uint64(0) ||
       !layout.FixedBytes32Equal(
           receipt.allocatorLayoutCid, expected.allocatorLayoutCid):
        return out
    let ownerDomainBytes = rawbytes.BytesFromString(
        mapped_reader.CsgCoreCsgcMappedSessionOwnerDomain)
    var ownerDomainDigest = sha256.Sha256Digest(ownerDomainBytes)
    let ownerDomainFixed =
        layout.FixedBytes32FromBytes(ownerDomainDigest)
    rawbytes.BytesFree(ownerDomainDigest)
    if IsErr(ownerDomainFixed) ||
       !layout.FixedBytes32Equal(
           receipt.ownerDomainCid, Value(ownerDomainFixed)) ||
       layout.FixedBytes32Equal(
           receipt.eventChainCid, layout.FixedBytes32()):
        return out
    let wire = csgManifestAllocationReceiptWire(receipt)
    var recomputed: system.RuntimeAllocationLedgerCid
    if !system.RuntimeAllocationLedgerReceiptCidRecompute(
           wire, recomputed) ||
       !csgManifestRuntimeCidMatchesFixed(
           recomputed, receipt.receiptCid):
        return out
    let cargo = csgManifestCanonicalReceiptCargo(receipt)
    if IsErr(cargo):
        return out
    let cargoBytes = Value(cargo)
    out.ok = true
    out.cargoByteCount = rawbytes.BytesLen(cargoBytes)
    out.cargo = cargoBytes
    out.receiptCid = receipt.receiptCid
    return out

fn csgManifestStagedFinalizeError(errorCode: int32): str =
    if errorCode == 1:
        return "merkle_manifest_staged_finalize_state_invalid"
    if errorCode == 2:
        return "merkle_manifest_staged_inventory_incomplete"
    if errorCode == 3:
        return "merkle_manifest_staged_inventory_count_mismatch"
    if errorCode == 4:
        return "merkle_manifest_staged_fact_count_mismatch"
    if errorCode == 5:
        return "merkle_manifest_staged_dependency_count_mismatch"
    if errorCode == 6:
        return "merkle_manifest_staged_query_count_mismatch"
    if errorCode == 7:
        return "merkle_manifest_staged_identity_parse_failed"
    if errorCode == 8:
        return "merkle_manifest_staged_semantic_closure_incomplete"
    return "merkle_manifest_staged_receipt_or_execution_identity_unproven"

fn csgManifestLogicalClosureReceiptCid(
        expected: csgCoreMerkleManifestFinalizePod): str =
    var transcript: str
    csgManifestStagedAppendPart(
        transcript, CsgManifestVerifierLogicalReceiptDomain)
    csgManifestStagedAppendInt32(transcript, 6)
    csgManifestStagedAppendPart(
        transcript, csgManifestFixedToCid(expected.manifestCid))
    csgManifestStagedAppendPart(
        transcript, csgManifestFixedToCid(expected.factsRoot))
    csgManifestStagedAppendPart(
        transcript, csgManifestFixedToCid(expected.csgcObjectCid))
    csgManifestStagedAppendInt32(transcript, expected.objectCount)
    csgManifestStagedAppendInt32(
        transcript, expected.queryIndexCount)
    csgManifestStagedAppendInt64(
        transcript, expected.totalObservedWireBytes)
    let bytes = rawbytes.BytesFromString(transcript)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgManifestVerifierLogicalReceiptDomain, bytes)
    return receiptCid

fn CsgCoreMerkleManifestStagedFinalizeLogical(
        state: var CsgCoreMerkleManifestStagedState):
        CsgCoreMerkleManifestStagedResult =
    var semanticError: str
    if state.phase == CsgManifestVerifierStagedPhaseConsuming:
        semanticError = csgManifestSemanticClosureError(state)
    elif state.error.len > 0:
        semanticError = strings.CloneStr(state.error)
    let expected = csgManifestStagedFinalizePod(state)
    csgManifestStagedReleaseManaged(state)
    var out: CsgCoreMerkleManifestStagedResult
    if expected.errorCode != 0:
        out.error = semanticError.len > 0 ?
            semanticError :
            csgManifestStagedFinalizeError(expected.errorCode)
        state.phase = CsgManifestVerifierStagedPhaseFailed
        out.productionReady = false
        out.hardRed = strings.CloneStr(
            CsgManifestVerifierStagedDynamicHardRed)
        return out
    state.phase = CsgManifestVerifierStagedPhaseFinalized
    out.ok = true
    out.manifestCid = csgManifestFixedToCid(expected.manifestCid)
    out.factsRoot = csgManifestFixedToCid(expected.factsRoot)
    out.objectCount = expected.objectCount
    out.queryIndexCount = expected.queryIndexCount
    out.totalObservedWireBytes = expected.totalObservedWireBytes
    out.logicalInventoryComplete = true
    out.logicalClosureReceiptCid =
        csgManifestLogicalClosureReceiptCid(expected)
    out.totalHeapBounded = false
    out.readerAuthorityProven = false
    out.allocationReceiptVerified = false
    out.receiptCidRecomputed = false
    out.canonicalReceiptCargoPresent = false
    out.nativeExecutionIdentityProven = false
    out.executionReceiptBound = false
    out.allocationLedgerProven = false
    out.dynamicRssProven = false
    out.productionReady = false
    out.error = ""
    out.hardRed = strings.CloneStr(
        CsgManifestVerifierStagedDynamicHardRed)
    return out

fn CsgCoreMerkleManifestStagedFinalize(
        state: var CsgCoreMerkleManifestStagedState,
        reader: var mapped_reader.CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability):
        CsgCoreMerkleManifestStagedResult =
    # Capture only POD identities, release every managed manifest value, then
    # detach the reader. Only the process entry may close the session owner;
    # this reader-local snapshot is intentionally insufficient for admission.
    let expected = csgManifestStagedFinalizePod(state)
    csgManifestStagedReleaseManaged(state)
    let detached =
        mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
            reader, owner)
    var noCanonicalCargo: rawbytes.Bytes
    let receipt =
        mapped_reader.CsgCoreCsgcMappedReaderAllocationReceipt(
            reader, noCanonicalCargo)
    var audit = csgManifestAllocationReceiptAudit(expected, receipt)
    # Logical inventory may be complete, but admission is not finalized until
    # the post-close native execution binding exists.
    state.phase = CsgManifestVerifierStagedPhaseFailed
    var out: CsgCoreMerkleManifestStagedResult
    out.error = csgManifestStagedFinalizeError(
        expected.errorCode == 0 && IsOk(detached) && audit.ok ?
            0 : expected.errorCode)
    if expected.errorCode == 0:
        out.manifestCid = csgManifestFixedToCid(expected.manifestCid)
        out.factsRoot = csgManifestFixedToCid(expected.factsRoot)
        out.objectCount = expected.objectCount
        out.queryIndexCount = expected.queryIndexCount
        out.totalObservedWireBytes = expected.totalObservedWireBytes
        out.logicalInventoryComplete = true
        out.logicalClosureReceiptCid =
            csgManifestLogicalClosureReceiptCid(expected)
    out.allocationReceiptVerified = IsOk(detached) && audit.ok
    out.receiptCidRecomputed = audit.ok
    out.receiptCargoByteCount = audit.cargoByteCount
    if audit.ok:
        out.allocationReceiptCid =
            csgManifestFixedToCid(audit.receiptCid)
        let propagated =
            mapped_reader.CsgCoreCsgcMappedReaderAllocationReceipt(
                reader, audit.cargo)
        out.canonicalReceiptCargoPresent =
            propagated.canonicalReceiptCargoPresent
    rawbytes.BytesFree(audit.cargo)
    # No caller may prefill either future value. A native launcher must append
    # its immutable execution identity after close and create the final binding
    # {manifest_cid,facts_root,allocation_receipt_cid,native_identity_cid}.
    out.nativeExecutionIdentityCid = ""
    out.executionAdmissionReceiptCid = ""
    let allocationProven =
        expected.errorCode == 0 && IsOk(detached) && audit.ok
    out.totalHeapBounded = allocationProven
    out.readerAuthorityProven = allocationProven
    out.nativeExecutionIdentityProven = false
    out.executionReceiptBound = false
    out.allocationLedgerProven = allocationProven
    out.dynamicRssProven = false
    out.productionReady = false
    out.hardRed = strings.CloneStr(
        allocationProven ?
            CsgManifestVerifierNativeExecutionHardRed :
            CsgManifestVerifierStagedDynamicHardRed)
    return out

@borrows
fn CsgCoreMerkleManifestAuditReferencedObjectsWithLimit(
        manifestBytes: rawbytes.Bytes,
        objects: CsgCoreMerkleManifestObject[],
        maxPeakLiveArtifactBytes: int64):
        CsgCoreMerkleManifestMemoryAudit =
    if maxPeakLiveArtifactBytes <= 0:
        return csgManifestVerifierMemoryFail(
            "merkle_manifest_peak_live_wire_limit_invalid")
    if objects.len > CsgManifestVerifierObjectCountMax:
        return csgManifestVerifierMemoryFail(
            "merkle_manifest_object_count_memory_limit_exceeded")
    let manifestWireBytes =
        int64(rawbytes.BytesLen(manifestBytes))
    if manifestWireBytes < 0:
        return csgManifestVerifierMemoryFail(
            "merkle_manifest_manifest_wire_size_invalid")
    var objectWireBytes: int64
    var largestTemporaryArtifactBytes = manifestWireBytes
    for i in 0..<objects.len:
        let objectBytes =
            int64(rawbytes.BytesLen(objects[i].bytes))
        var nextObjectWireBytes: int64
        if objectBytes < 0 ||
           !csgManifestVerifierCheckedAddInt64(
               objectWireBytes,
               objectBytes,
               nextObjectWireBytes):
            return csgManifestVerifierMemoryFail(
                "merkle_manifest_object_wire_size_overflow")
        objectWireBytes = nextObjectWireBytes
        if objectBytes > largestTemporaryArtifactBytes:
            largestTemporaryArtifactBytes = objectBytes
    var residentInputArtifactBytes: int64
    if !csgManifestVerifierCheckedAddInt64(
           manifestWireBytes,
           objectWireBytes,
           residentInputArtifactBytes):
        return csgManifestVerifierMemoryFail(
            "merkle_manifest_resident_wire_size_overflow")
    var peakLiveArtifactBytes: int64
    if !csgManifestVerifierCheckedAddInt64(
           residentInputArtifactBytes,
           largestTemporaryArtifactBytes,
           peakLiveArtifactBytes):
        return csgManifestVerifierMemoryFail(
            "merkle_manifest_peak_live_wire_size_overflow")
    if peakLiveArtifactBytes > maxPeakLiveArtifactBytes:
        return csgManifestVerifierMemoryFail(
            "merkle_manifest_peak_live_wire_limit_exceeded")
    var out: CsgCoreMerkleManifestMemoryAudit
    out.ok = true
    out.manifestWireBytes = manifestWireBytes
    out.objectWireBytes = objectWireBytes
    out.residentInputArtifactBytes =
        residentInputArtifactBytes
    out.largestTemporaryArtifactBytes =
        largestTemporaryArtifactBytes
    out.peakLiveArtifactBytes = peakLiveArtifactBytes
    out.objectCount = objects.len
    out.fullInventoryResident = true
    out.reencodeOverlapsFullInventory = true
    out.admissionOverlapsFullInventory = true
    out.hardRed = strings.CloneStr(
        CsgManifestVerifierBatchMemoryHardRed)
    out.requiredReaderInterface = strings.CloneStr(
        CsgManifestVerifierRequiredReaderInterface)
    return out

@borrows
fn CsgCoreMerkleManifestAuditReferencedObjects(
        manifestBytes: rawbytes.Bytes,
        objects: CsgCoreMerkleManifestObject[]):
        CsgCoreMerkleManifestMemoryAudit =
    return CsgCoreMerkleManifestAuditReferencedObjectsWithLimit(
        manifestBytes,
        objects,
        CsgManifestVerifierPeakLiveArtifactBytesMax)

@borrows
fn csgManifestVerifierTextCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgManifestVerifierSortedOrder(
        keys: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, keys.len)
    setLen(scratch, keys.len)
    for i in 0..<keys.len:
        order[i] = i
    var width: int32 = 1
    while width < keys.len:
        var start: int32
        while start < keys.len:
            var middle = start + width
            if middle > keys.len:
                middle = keys.len
            var finish = middle + width
            if finish > keys.len:
                finish = keys.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgManifestVerifierTextCompare(
                        keys[order[left]],
                        keys[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    return order

@borrows
fn csgManifestVerifierSourceCidError(
        partitionSourceIds: str[],
        partitionSourceCids: str[],
        partitionFactStarts: int32[],
        partitionFactCounts: int32[],
        facts: str[]): str =
    if partitionSourceIds.len == 0 ||
       partitionSourceIds.len != partitionSourceCids.len ||
       partitionSourceIds.len != partitionFactStarts.len ||
       partitionSourceIds.len != partitionFactCounts.len:
        return "merkle_manifest_source_inventory_invalid"
    var expectedFactStart: int32
    for i in 0..<partitionFactStarts.len:
        let factStart = partitionFactStarts[i]
        let factCount = partitionFactCounts[i]
        if factStart != expectedFactStart || factCount < 0 ||
           factStart > facts.len - factCount:
            return "merkle_manifest_source_fact_range_invalid"
        expectedFactStart = expectedFactStart + factCount
    if expectedFactStart != facts.len:
        return "merkle_manifest_source_facts_extra"
    let partitionOrder =
        csgManifestVerifierSortedOrder(
            partitionSourceIds)
    var partitionAt: int32
    while partitionAt < partitionOrder.len:
        let partitionIndex =
            partitionOrder[partitionAt]
        let sourceId =
            partitionSourceIds[partitionIndex]
        let claimedSourceCid =
            partitionSourceCids[partitionIndex]
        var sourceFacts: str[]
        while partitionAt < partitionOrder.len &&
              partitionSourceIds[
                  partitionOrder[partitionAt]] == sourceId:
            let currentPartition =
                partitionOrder[partitionAt]
            if partitionSourceCids[currentPartition] !=
               claimedSourceCid:
                return "merkle_manifest_source_cid_conflict"
            let factStart =
                partitionFactStarts[currentPartition]
            let factCount =
                partitionFactCounts[currentPartition]
            for factIndex in factStart..<(factStart + factCount):
                add(
                    sourceFacts,
                    strings.CloneStr(facts[factIndex]))
            partitionAt = partitionAt + 1
        if sourceFacts.len == 0:
            return "merkle_manifest_source_facts_missing"
        let sourceDag =
            merkle_dag.CsgCoreMerkleBuild(sourceFacts)
        if !sourceDag.ok ||
           sourceDag.subgraphCid != claimedSourceCid:
            return "merkle_manifest_source_cid_mismatch"
    return ""

@borrows
fn csgManifestVerifierExpectedObjectCount(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest): int32 =
    var count: int64 = int64(2)
    count = count +
        int64(manifest.partitions.len) * int64(2)
    count = count + int64(manifest.nodeCount)
    count = count +
        int64(manifest.dependencyConsumerShards.len)
    count = count +
        int64(manifest.dependencyProviderShards.len)
    count = count + int64(manifest.queryShards.len)
    if count < int64(0) ||
       count > int64(2147483647):
        return -1
    return int32(count)

@borrows
fn csgManifestVerifierObjectError(
        object: CsgCoreMerkleManifestObject,
        expectedKind: str,
        expectedIndex: int32,
        expectedCid: str): str =
    if object.kind != expectedKind:
        return "merkle_manifest_object_kind_mismatch"
    if object.index != expectedIndex:
        return "merkle_manifest_object_index_mismatch"
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           object.cid):
        return "merkle_manifest_object_cid_invalid"
    if expectedCid.len > 0 && object.cid != expectedCid:
        return "merkle_manifest_object_cid_mismatch"
    return ""

@borrows
fn csgManifestVerifierSummaryMatches(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        summary:
            merkle_artifacts.CsgCoreMerkleSummaryResult): bool =
    let header = summary.header
    return summary.ok &&
        summary.cid == manifest.summaryCid &&
        header.standard == manifest.standard &&
        validator.CsgCoreProfilesEqual(
            header.profiles, manifest.profiles) &&
        header.profileSetCid == manifest.profileSetCid &&
        header.complete == manifest.complete &&
        header.schemaCid == manifest.schemaCid &&
        header.factsRoot == manifest.factsRoot &&
        header.dagRootCid == manifest.dagRootCid &&
        header.factCount == manifest.factCount &&
        header.nodeCount == manifest.nodeCount &&
        header.partitionRoot == manifest.partitionRoot &&
        header.partitionCount == manifest.partitions.len &&
        header.dependencyConsumerRoot ==
            manifest.dependencyConsumerRoot &&
        header.dependencyProviderRoot ==
            manifest.dependencyProviderRoot &&
        header.dependencyCount == manifest.dependencyCount &&
        header.dependencyConsumerShardCount ==
            manifest.dependencyConsumerShards.len &&
        header.dependencyProviderShardCount ==
            manifest.dependencyProviderShards.len &&
        header.queryShardRoot == manifest.queryShardRoot &&
        header.queryIndexCount == manifest.queryIndexCount &&
        header.queryShardCount == manifest.queryShards.len &&
        header.unsupportedCount == manifest.unsupportedCount &&
        header.tombstoneCount == manifest.tombstoneCount &&
        header.runtimeRequirementCount ==
            manifest.runtimeRequirementCount

@borrows
fn CsgCoreMerkleManifestVerifyReferencedObjects(
        expectedManifestCid: str,
        manifestBytes: rawbytes.Bytes,
        objects: CsgCoreMerkleManifestObject[]):
        CsgCoreMerkleManifestClosureResult =
    # This is exact logical artifact-wire accounting, not an RSS or total-heap
    # proof. The batch API remains blocked until every semantic heap is bounded.
    let memoryAudit =
        CsgCoreMerkleManifestAuditReferencedObjects(
            manifestBytes, objects)
    if !memoryAudit.ok:
        return csgManifestVerifierFail(
            csgManifestVerifierCat(
                "merkle_manifest_memory ",
                memoryAudit.error))
    if memoryAudit.hardRed.len > 0 ||
       !memoryAudit.totalHeapBounded:
        return csgManifestVerifierFail(
            csgManifestVerifierCat(
                "merkle_manifest_memory_hard_red ",
                memoryAudit.hardRed))
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           expectedManifestCid):
        return csgManifestVerifierFail(
            "merkle_manifest_expected_cid_invalid")
    var decodedManifest =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            manifestBytes)
    if !decodedManifest.ok:
        return csgManifestVerifierFail(
            csgManifestVerifierCat(
                "merkle_manifest_object_manifest_decode ",
                decodedManifest.error))
    if decodedManifest.cid != expectedManifestCid:
        return csgManifestVerifierFail(
            "merkle_manifest_expected_cid_mismatch")
    let verifiedManifestCid =
        strings.CloneStr(decodedManifest.cid)
    let manifest = decodedManifest.manifest
    decodedManifest.lines = []
    let expectedObjectCount =
        csgManifestVerifierExpectedObjectCount(manifest)
    if expectedObjectCount < 0 ||
       objects.len != expectedObjectCount:
        return csgManifestVerifierFail(
            "merkle_manifest_object_count_mismatch")

    var cursor: int32
    let csgcObject = objects[cursor]
    var objectError =
        csgManifestVerifierObjectError(
            csgcObject,
            CsgManifestObjectCanonicalCsgc,
            0,
            manifest.csgcObjectCid)
    if objectError.len > 0:
        return csgManifestVerifierFail(objectError)
    let actualCsgcCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            csgcObject.bytes)
    if actualCsgcCid != csgcObject.cid:
        return csgManifestVerifierFail(
            "merkle_manifest_csgc_object_cid_mismatch")
    let canonicalCsgcError =
        merkle_manifest.CsgCoreMerkleManifestCanonicalCsgcError(
            manifest, csgcObject.bytes)
    if canonicalCsgcError.len > 0:
        return csgManifestVerifierFail(
            csgManifestVerifierCat(
                "merkle_manifest_csgc_object ",
                canonicalCsgcError))
    cursor = cursor + 1

    var admission: merkle_admission.CsgCoreMerkleAdmissionArtifacts
    var partitionFacts: str[]
    var partitionSourceIds: str[]
    var partitionSourceCids: str[]
    var partitionFactStarts: int32[]
    var partitionFactCounts: int32[]
    for i in 0..<manifest.partitions.len:
        let object = objects[cursor]
        objectError =
            csgManifestVerifierObjectError(
                object,
                CsgManifestObjectPartitionFacts,
                i,
                manifest.partitions[i].factsCid)
        if objectError.len > 0:
            return csgManifestVerifierFail(objectError)
        var decoded =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                object.bytes)
        if !decoded.ok || decoded.cid != object.cid:
            let error =
                decoded.ok ?
                    "merkle_manifest_partition_cid_mismatch" :
                    csgManifestVerifierCat(
                        "merkle_manifest_partition_decode ",
                        decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(error)
        add(
            partitionSourceIds,
            strings.CloneStr(
                manifest.partitions[i].sourceId))
        add(
            partitionSourceCids,
            strings.CloneStr(
                manifest.partitions[i].sourceCid))
        add(partitionFactStarts, partitionFacts.len)
        add(partitionFactCounts, decoded.facts.len)
        for factIndex in 0..<decoded.facts.len:
            add(
                partitionFacts,
                strings.CloneStr(
                    decoded.facts[factIndex]))
        rawbytes.BytesFree(decoded.bytes)
        add(admission.partitionBytes, object.bytes)
        cursor = cursor + 1

    for i in 0..<manifest.partitions.len:
        let object = objects[cursor]
        objectError =
            csgManifestVerifierObjectError(
                object,
                CsgManifestObjectMembership,
                i,
                manifest.partitions[i].membershipCid)
        if objectError.len > 0:
            return csgManifestVerifierFail(objectError)
        var decoded =
            merkle_artifacts.CsgCoreMerkleMembershipDecode(
                object.bytes)
        if !decoded.ok || decoded.cid != object.cid:
            let error =
                decoded.ok ?
                    "merkle_manifest_membership_cid_mismatch" :
                    csgManifestVerifierCat(
                        "merkle_manifest_membership_decode ",
                        decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(error)
        rawbytes.BytesFree(decoded.bytes)
        add(admission.membershipBytes, object.bytes)
        cursor = cursor + 1

    var previousNodeCid: str
    for i in 0..<manifest.nodeCount:
        let object = objects[cursor]
        objectError =
            csgManifestVerifierObjectError(
                object,
                CsgManifestObjectNode,
                i,
                "")
        if objectError.len > 0:
            return csgManifestVerifierFail(objectError)
        var decoded =
            merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
                object.bytes)
        if !decoded.ok || decoded.nodes.len != 1:
            let error =
                decoded.ok ?
                    "merkle_manifest_node_cardinality_invalid" :
                    csgManifestVerifierCat(
                        "merkle_manifest_node_decode ",
                        decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(error)
        let actualNodeCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                decoded.nodes[0])
        if actualNodeCid != object.cid:
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(
                "merkle_manifest_node_cid_mismatch")
        if previousNodeCid.len > 0 &&
           csgManifestVerifierTextCompare(
               previousNodeCid, object.cid) >= 0:
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(
                "merkle_manifest_node_index_non_canonical")
        previousNodeCid = strings.CloneStr(object.cid)
        rawbytes.BytesFree(decoded.bytes)
        add(admission.nodeSegmentBytes, object.bytes)
        cursor = cursor + 1

    for i in 0..<manifest.dependencyConsumerShards.len:
        let object = objects[cursor]
        let descriptor =
            manifest.dependencyConsumerShards[i]
        objectError =
            csgManifestVerifierObjectError(
                object,
                CsgManifestObjectDependencyConsumer,
                i,
                descriptor.cid)
        if objectError.len > 0:
            return csgManifestVerifierFail(objectError)
        var decoded =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                object.bytes)
        if !decoded.ok || decoded.cid != object.cid ||
           decoded.shardRoot != descriptor.root ||
           decoded.entryCount != descriptor.entryCount ||
           decoded.header.profileSetCid !=
               manifest.profileSetCid ||
           decoded.header.projection !=
               merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection() ||
           decoded.header.shardKey != descriptor.shardKey:
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(
                "merkle_manifest_dependency_consumer_mismatch")
        rawbytes.BytesFree(decoded.bytes)
        add(
            admission.dependencyConsumerShardBytes,
            object.bytes)
        cursor = cursor + 1

    for i in 0..<manifest.dependencyProviderShards.len:
        let object = objects[cursor]
        let descriptor =
            manifest.dependencyProviderShards[i]
        objectError =
            csgManifestVerifierObjectError(
                object,
                CsgManifestObjectDependencyProvider,
                i,
                descriptor.cid)
        if objectError.len > 0:
            return csgManifestVerifierFail(objectError)
        var decoded =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                object.bytes)
        if !decoded.ok || decoded.cid != object.cid ||
           decoded.shardRoot != descriptor.root ||
           decoded.entryCount != descriptor.entryCount ||
           decoded.header.profileSetCid !=
               manifest.profileSetCid ||
           decoded.header.projection !=
               merkle_artifacts.CsgCoreMerkleDependencyProviderProjection() ||
           decoded.header.shardKey != descriptor.shardKey:
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(
                "merkle_manifest_dependency_provider_mismatch")
        rawbytes.BytesFree(decoded.bytes)
        add(
            admission.dependencyProviderShardBytes,
            object.bytes)
        cursor = cursor + 1

    let summaryObject = objects[cursor]
    objectError =
        csgManifestVerifierObjectError(
            summaryObject,
            CsgManifestObjectSummary,
            0,
            manifest.summaryCid)
    if objectError.len > 0:
        return csgManifestVerifierFail(objectError)
    var summary =
        merkle_artifacts.CsgCoreMerkleSummaryDecode(
            summaryObject.bytes)
    if summary.cid != summaryObject.cid ||
       !csgManifestVerifierSummaryMatches(
           manifest, summary):
        rawbytes.BytesFree(summary.bytes)
        return csgManifestVerifierFail(
            "merkle_manifest_summary_mismatch")
    rawbytes.BytesFree(summary.bytes)
    admission.summaryBytes = summaryObject.bytes
    cursor = cursor + 1

    for i in 0..<manifest.queryShards.len:
        let object = objects[cursor]
        let descriptor = manifest.queryShards[i]
        objectError =
            csgManifestVerifierObjectError(
                object,
                CsgManifestObjectQueryShard,
                i,
                descriptor.cid)
        if objectError.len > 0:
            return csgManifestVerifierFail(objectError)
        var decoded =
            merkle_artifacts.CsgCoreMerkleQueryShardDecode(
                object.bytes)
        if !decoded.ok || decoded.cid != object.cid ||
           decoded.shardRoot != descriptor.root ||
           decoded.entryCount != descriptor.entryCount ||
           decoded.header.profileSetCid !=
               manifest.profileSetCid ||
           decoded.header.bucket != descriptor.shardKey:
            rawbytes.BytesFree(decoded.bytes)
            return csgManifestVerifierFail(
                "merkle_manifest_query_shard_mismatch")
        rawbytes.BytesFree(decoded.bytes)
        add(admission.queryShardBytes, object.bytes)
        cursor = cursor + 1

    if cursor != objects.len:
        return csgManifestVerifierFail(
            "merkle_manifest_object_trailing_data")

    let sourceCidError =
        csgManifestVerifierSourceCidError(
            partitionSourceIds,
            partitionSourceCids,
            partitionFactStarts,
            partitionFactCounts,
            partitionFacts)
    if sourceCidError.len > 0:
        return csgManifestVerifierFail(sourceCidError)

    # This is the unique encoder/decoder congruence proof. Its full-size wire
    # buffer is released before the batch admission rebuilds semantic state.
    var rebuiltCsgc =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            partitionFacts)
    if !rebuiltCsgc.ok ||
       !rawbytes.BytesEqual(
           rebuiltCsgc.bytes, csgcObject.bytes):
        rawbytes.BytesFree(rebuiltCsgc.bytes)
        return csgManifestVerifierFail(
            "merkle_manifest_csgc_partition_bytes_mismatch")
    rawbytes.BytesFree(rebuiltCsgc.bytes)

    partitionFacts = []
    partitionSourceIds = []
    partitionSourceCids = []
    partitionFactStarts = []
    partitionFactCounts = []

    let verified =
        merkle_admission.CsgCoreMerkleAdmissionVerify(
            manifest, admission)
    if !verified.ok:
        return csgManifestVerifierFail(
            csgManifestVerifierCat(
                "merkle_manifest_object_admission ",
                verified.error))

    var out: CsgCoreMerkleManifestClosureResult
    out.ok = true
    out.manifestCid = strings.CloneStr(verifiedManifestCid)
    out.factsRoot = strings.CloneStr(manifest.factsRoot)
    out.objectCount = objects.len
    out.queryIndexCount = verified.queryIndexCount
    out.residentInputArtifactBytes =
        memoryAudit.residentInputArtifactBytes
    out.peakLiveArtifactBytes =
        memoryAudit.peakLiveArtifactBytes
    out.memoryHardRed = strings.CloneStr(memoryAudit.hardRed)
    return out
