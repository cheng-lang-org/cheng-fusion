import std/rawbytes
import std/result
import std/strings
import std/os
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store_artifact_codec
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_identity
import cheng/core/csg_core/merkle_transaction_receipt

type
    CsgCoreMerkleStoreSnapshotLookupResult =
        ok: bool
        error: str
        found: bool
        conflict: bool
        head: merkle_store_codec.CsgCoreMerkleStoreHeadIdentity
        manifest: merkle_manifest.CsgCoreMerkleManifest
        receipt:
            merkle_transaction_receipt.CsgCoreMerkleTransactionReceipt

    csgStoreSnapshotObjectReadResult =
        ok: bool
        error: str
        bytes: rawbytes.Bytes

@borrows
fn csgStoreSnapshotFail(
        error: str,
        conflict: bool = false):
        CsgCoreMerkleStoreSnapshotLookupResult =
    var out: CsgCoreMerkleStoreSnapshotLookupResult
    out.error = strings.CloneStr(error)
    out.conflict = conflict
    return out

@borrows
fn csgStoreSnapshotObjectFail(
        error: str): csgStoreSnapshotObjectReadResult =
    var out: csgStoreSnapshotObjectReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreSnapshotCidText(value: layout.FixedBytes32): str =
    return strings.ConcatStr(
        "sha256:", layout.FixedBytes32Hex(value))

@borrows
fn csgStoreSnapshotReadChild(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        category: str,
        finalName: str,
        fixedFileName: str,
        byteLimit: int64): csgStoreSnapshotObjectReadResult =
    if byteLimit <= 0:
        return csgStoreSnapshotObjectFail(
            "merkle_store_snapshot_child_limit_invalid")
    let opened =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityOpenObjectVerified(
            planning, category, finalName)
    if result.IsErr(opened):
        return csgStoreSnapshotObjectFail(result.Error(opened))
    let child = result.Value(opened)
    var noDirectories: str[]
    let exact = os.AtomicTreeVerifyExact(
        child,
        noDirectories,
        [strings.CloneStr(fixedFileName)])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(child)
        if result.IsErr(closed):
            panic("merkle store snapshot: invalid child close failed")
        return csgStoreSnapshotObjectFail(
            "merkle_store_snapshot_child_shape_invalid")
    let read = os.AtomicTreeReadStable(child, fixedFileName)
    let closed = os.AtomicTreeClose(child)
    if result.IsErr(closed):
        panic("merkle store snapshot: child close failed")
    if result.IsErr(read):
        return csgStoreSnapshotObjectFail(result.Error(read))
    var bytes = result.Value(read)
    let byteCount = rawbytes.BytesLen(bytes)
    if byteCount <= 0 || int64(byteCount) > byteLimit:
        rawbytes.BytesFree(bytes)
        return csgStoreSnapshotObjectFail(
            "merkle_store_snapshot_child_byte_limit_exceeded")
    var out: csgStoreSnapshotObjectReadResult
    out.ok = true
    out.bytes = bytes
    return out

@borrows
fn CsgCoreMerkleStoreSnapshotReadObject(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        kind: int32,
        expectedCid: str): csgStoreSnapshotObjectReadResult =
    if !merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactKindValid(
           kind) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(expectedCid):
        return csgStoreSnapshotObjectFail(
            "merkle_store_snapshot_object_identity_invalid")
    let category =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCategory(
            kind)
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(expectedCid)
    let byteLimit =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactByteLimit(
            kind)
    var read = csgStoreSnapshotReadChild(
        planning,
        category,
        finalName,
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName(),
        byteLimit)
    if !read.ok:
        return read
    var cidError: str
    let actualCid =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
            kind, read.bytes, cidError)
    if cidError.len > 0 || actualCid != expectedCid:
        rawbytes.BytesFree(read.bytes)
        return csgStoreSnapshotObjectFail(
            "merkle_store_snapshot_object_cid_mismatch")
    return read

@borrows
fn csgStoreSnapshotReadHead(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        predecessorCid: str):
        merkle_store_codec.CsgCoreMerkleStoreHeadCodecResult =
    let successorName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
            predecessorCid)
    if successorName.len == 0:
        var failed: merkle_store_codec.CsgCoreMerkleStoreHeadCodecResult
        failed.error =
            "merkle_store_snapshot_successor_name_invalid"
        return failed
    var read = csgStoreSnapshotReadChild(
        planning,
        merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
        successorName,
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName(),
        int64(1048576))
    if !read.ok:
        var failed: merkle_store_codec.CsgCoreMerkleStoreHeadCodecResult
        failed.error = strings.CloneStr(read.error)
        return failed
    var decoded: merkle_store_codec.CsgCoreMerkleStoreHeadCodecResult
    let memoEntry =
        merkle_store_codec.CsgCoreMerkleStoreHeadMemoLookupFromBytes(
            read.bytes)
    if memoEntry.found:
        rawbytes.BytesFree(read.bytes)
        decoded.ok = true
        decoded.head.generation = memoEntry.generation
        decoded.head.manifestCid = memoEntry.manifestCid
        decoded.head.previousHeadCid = memoEntry.previousHeadCid
        decoded.head.receiptCid = memoEntry.receiptCid
        decoded.head.headCid = memoEntry.headCid
    else:
        decoded = merkle_store_codec.CsgCoreMerkleStoreHeadDecode(read.bytes)
        rawbytes.BytesFree(read.bytes)
    return decoded

@borrows
fn csgStoreSnapshotReadManifest(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifestCid: str):
        merkle_manifest.CsgCoreMerkleManifestDecodeResult =
    var read = CsgCoreMerkleStoreSnapshotReadObject(
        planning,
        merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind(),
        manifestCid)
    if !read.ok:
        var failed: merkle_manifest.CsgCoreMerkleManifestDecodeResult
        failed.error = strings.CloneStr(read.error)
        return failed
    let decoded = merkle_manifest.CsgCoreMerkleManifestDecode(read.bytes)
    rawbytes.BytesFree(read.bytes)
    return decoded

@borrows
fn csgStoreSnapshotReadReceipt(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        receiptCid: str):
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptCodecResult =
    var read = CsgCoreMerkleStoreSnapshotReadObject(
        planning,
        merkle_store_artifact_codec.CsgCoreMerkleStoreReceiptArtifactKind(),
        receiptCid)
    if !read.ok:
        var failed: merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptCodecResult
        failed.error = strings.CloneStr(read.error)
        return failed
    var decoded =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptDecode(
            read.bytes)
    rawbytes.BytesFree(read.bytes)
    return decoded

type
    csgStoreSnapshotReceiptFieldsResult =
        ok: bool
        error: str

@borrows
fn csgStoreSnapshotReceiptFieldsFail(
        error: str): csgStoreSnapshotReceiptFieldsResult =
    var out: csgStoreSnapshotReceiptFieldsResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreSnapshotReadReceiptFields(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        receiptCid: str,
        fields: var
            merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoEntry):
        csgStoreSnapshotReceiptFieldsResult =
    # Memo-aware receipt field read for the generation scan: the receipt
    # bytes are digest-checked on every read (same strength as the object CID
    # check), and the strict-decode derivation is reused from the
    # same-compilation memo instead of decoding every generation's receipt on
    # every walk.  Only the found generation is fully decoded afterwards.
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(receiptCid):
        return csgStoreSnapshotReceiptFieldsFail(
            "merkle_store_snapshot_object_identity_invalid")
    let kind =
        merkle_store_artifact_codec.CsgCoreMerkleStoreReceiptArtifactKind()
    let category =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCategory(kind)
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(receiptCid)
    let byteLimit =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactByteLimit(kind)
    var read = csgStoreSnapshotReadChild(
        planning,
        category,
        finalName,
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName(),
        byteLimit)
    if !read.ok:
        return csgStoreSnapshotReceiptFieldsFail(read.error)
    let contentCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionReceiptDomain,
            read.bytes)
    if contentCid != receiptCid:
        rawbytes.BytesFree(read.bytes)
        return csgStoreSnapshotReceiptFieldsFail(
            "merkle_store_snapshot_object_cid_mismatch")
    let memoEntry =
        merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoLookup(
            contentCid)
    if memoEntry.found:
        rawbytes.BytesFree(read.bytes)
        fields = memoEntry
        var out: csgStoreSnapshotReceiptFieldsResult
        out.ok = true
        return out
    var decoded =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptDecode(
            read.bytes)
    rawbytes.BytesFree(read.bytes)
    if !decoded.ok:
        var failed = csgStoreSnapshotReceiptFieldsFail(decoded.error)
        rawbytes.BytesFree(decoded.bytes)
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptCodecDropLines(
            decoded)
        return failed
    fields.found = true
    fields.generation = decoded.receipt.generation
    fields.requestCid = decoded.receipt.requestCid
    fields.beforeHeadCid = decoded.receipt.beforeHeadCid
    fields.beforeManifestCid = decoded.receipt.beforeManifestCid
    fields.afterManifestCid = decoded.receipt.afterManifestCid
    fields.proofCid = decoded.receipt.proofCid
    fields.operationCount = decoded.receipt.operationCids.len
    rawbytes.BytesFree(decoded.bytes)
    merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptCodecDropLines(
        decoded)
    var out: csgStoreSnapshotReceiptFieldsResult
    out.ok = true
    return out

@borrows
fn csgStoreSnapshotManifestMatchesSummary(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        summary:
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotSummary):
        bool =
    return manifest.complete &&
        manifest.csgcByteCount == summary.csgcByteCount &&
        manifest.factCount == summary.factCount &&
        manifest.nodeCount == summary.nodeCount &&
        manifest.csgcDirectoryCid ==
            csgStoreSnapshotCidText(summary.csgcDirectoryCid) &&
        manifest.csgcObjectCid ==
            csgStoreSnapshotCidText(summary.csgcObjectCid) &&
        manifest.factsRoot ==
            csgStoreSnapshotCidText(summary.factsRoot) &&
        manifest.dagRootCid ==
            csgStoreSnapshotCidText(summary.dagRootCid) &&
        manifest.profileSetCid ==
            csgStoreSnapshotCidText(summary.profileSetCid) &&
        manifest.schemaCid ==
            csgStoreSnapshotCidText(summary.schemaCid) &&
        merkle_manifest.CsgCoreMerkleManifestError(manifest).len == 0

@borrows
fn csgStoreSnapshotReceiptFieldsMatchTransition(
        fields:
            merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoEntry,
        previous:
            merkle_store_codec.CsgCoreMerkleStoreHeadIdentity,
        next:
            merkle_store_codec.CsgCoreMerkleStoreHeadIdentity): bool =
    # Memo rows only ever hold strictly decoded and structurally validated
    # receipts (CsgCoreMerkleTransactionReceiptDecode refuses invalid
    # structures), so the structural error check of the full-receipt matcher
    # is implied by the memo contract.
    return fields.generation == next.generation &&
        next.generation == previous.generation + int64(1) &&
        fields.beforeHeadCid == previous.headCid &&
        fields.beforeManifestCid == previous.manifestCid &&
        fields.afterManifestCid == next.manifestCid

@borrows
fn CsgCoreMerkleStoreSnapshotFindRequest(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        snapshot:
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority,
        expectedBeforeHeadCid: str,
        requestCid: str): CsgCoreMerkleStoreSnapshotLookupResult =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           expectedBeforeHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(requestCid) ||
       !merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPlanningMatches(
           snapshot, planning):
        return csgStoreSnapshotFail(
            "merkle_store_snapshot_request_authority_invalid")
    let locked =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
            snapshot)
    if !locked.ok:
        return csgStoreSnapshotFail(locked.error)
    let expectedLatestHeadCid =
        csgStoreSnapshotCidText(locked.summary.headCid)
    let expectedLatestManifestCid =
        csgStoreSnapshotCidText(locked.summary.manifestCid)
    var predecessorCid: str = "none"
    var expectedGeneration: int64
    var previous: merkle_store_codec.CsgCoreMerkleStoreHeadIdentity
    var latest: merkle_store_codec.CsgCoreMerkleStoreHeadIdentity
    var found: bool
    var foundHead: merkle_store_codec.CsgCoreMerkleStoreHeadIdentity
    var foundReceipt: merkle_transaction_receipt.CsgCoreMerkleTransactionReceipt
    var scanning = true
    while scanning:
        let exists =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthoritySuccessorExists(
                planning, predecessorCid)
        if result.IsErr(exists):
            return csgStoreSnapshotFail(result.Error(exists))
        if !result.Value(exists):
            scanning = false
            continue
        var decoded = csgStoreSnapshotReadHead(
            planning, predecessorCid)
        if !decoded.ok ||
           decoded.head.generation != expectedGeneration ||
           decoded.head.previousHeadCid != predecessorCid ||
           decoded.head.headCid == predecessorCid:
            merkle_store_codec.CsgCoreMerkleStoreHeadCodecResultDrop(decoded)
            return csgStoreSnapshotFail(
                "merkle_store_snapshot_head_chain_invalid")
        if expectedGeneration == int64(0):
            if decoded.head.receiptCid != "none":
                merkle_store_codec.CsgCoreMerkleStoreHeadCodecResultDrop(decoded)
                return csgStoreSnapshotFail(
                    "merkle_store_snapshot_genesis_receipt_invalid")
        else:
            var fields:
                merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoEntry
            let receiptRead = csgStoreSnapshotReadReceiptFields(
                planning, decoded.head.receiptCid, fields)
            if !receiptRead.ok ||
               !csgStoreSnapshotReceiptFieldsMatchTransition(
                   fields, previous, decoded.head):
                merkle_store_codec.CsgCoreMerkleStoreHeadCodecResultDrop(decoded)
                return csgStoreSnapshotFail(
                    "merkle_store_snapshot_receipt_transition_invalid")
            if previous.headCid == expectedBeforeHeadCid:
                if fields.requestCid != requestCid:
                    merkle_store_codec.CsgCoreMerkleStoreHeadCodecResultDrop(decoded)
                    return csgStoreSnapshotFail(
                        "merkle_transaction_request_conflict", true)
                found = true
                foundHead = decoded.head
                var fullReceipt = csgStoreSnapshotReadReceipt(
                    planning, decoded.head.receiptCid)
                if !fullReceipt.ok:
                    merkle_store_codec.CsgCoreMerkleStoreHeadCodecResultDrop(decoded)
                    return csgStoreSnapshotFail(fullReceipt.error)
                foundReceipt = fullReceipt.receipt
                rawbytes.BytesFree(fullReceipt.bytes)
                merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptCodecDropLines(
                    fullReceipt)
        previous = decoded.head
        latest = decoded.head
        predecessorCid = strings.CloneStr(decoded.head.headCid)
        merkle_store_codec.CsgCoreMerkleStoreHeadCodecResultDrop(decoded)
        expectedGeneration = expectedGeneration + int64(1)
    if expectedGeneration == int64(0) ||
       latest.headCid != expectedLatestHeadCid ||
       latest.manifestCid != expectedLatestManifestCid ||
       latest.generation != locked.summary.storeGeneration:
        return csgStoreSnapshotFail(
            "merkle_store_snapshot_latest_head_mismatch")
    var currentManifest = csgStoreSnapshotReadManifest(
        planning, latest.manifestCid)
    if !currentManifest.ok ||
       currentManifest.cid != latest.manifestCid ||
       !csgStoreSnapshotManifestMatchesSummary(
           currentManifest.manifest, locked.summary):
        return csgStoreSnapshotFail(
            "merkle_store_snapshot_manifest_mismatch")
    var out: CsgCoreMerkleStoreSnapshotLookupResult
    out.ok = true
    if found:
        var foundManifest = csgStoreSnapshotReadManifest(
            planning, foundHead.manifestCid)
        if !foundManifest.ok ||
           foundManifest.cid != foundHead.manifestCid ||
           merkle_manifest.CsgCoreMerkleManifestError(
               foundManifest.manifest).len > 0:
            return csgStoreSnapshotFail(
                "merkle_store_snapshot_reused_manifest_invalid")
        out.found = true
        out.head = foundHead
        out.manifest = foundManifest.manifest
        out.receipt = foundReceipt
        return out
    if expectedBeforeHeadCid != latest.headCid:
        return csgStoreSnapshotFail(
            "merkle_transaction_expected_head_mismatch")
    out.head = latest
    out.manifest = currentManifest.manifest
    return out

@borrows
fn CsgCoreMerkleStoreSnapshotReadCurrent(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        snapshot:
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority):
        CsgCoreMerkleStoreSnapshotLookupResult =
    if !merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPlanningMatches(
           snapshot, planning):
        return csgStoreSnapshotFail(
            "merkle_store_snapshot_current_authority_invalid")
    let locked =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
            snapshot)
    if !locked.ok:
        return csgStoreSnapshotFail(locked.error)
    let expectedHeadCid =
        csgStoreSnapshotCidText(locked.summary.headCid)
    return CsgCoreMerkleStoreSnapshotFindRequest(
        planning,
        snapshot,
        expectedHeadCid,
        expectedHeadCid)
