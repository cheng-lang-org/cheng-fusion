import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_lowering_authority as snapshot_authority

const CsgCoreBodyIrCleanupSourceProjectionDomain: str =
    "cheng.csg_core.body_ir.cleanup_source_projection"

fn csgCoreBodyIrCleanupAuthorityAppendI32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, (value >> 24) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, value & 255)

fn csgCoreBodyIrCleanupAuthorityAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgCoreBodyIrCleanupAuthorityAppendI32(out, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(out, Int32(value[index]) & 255)

@borrows
fn CsgCoreBodyIrCleanupSourceProjectionCid(
        authority:
            snapshot_authority.CompilerSnapshotLoweringAuthorityHandle,
        factsRootCid: layout.FixedBytes32,
        functionId: int32,
        typedFunctionIndex: int32,
        fragmentCid: layout.FixedBytes32,
        interfaceCid: layout.FixedBytes32,
        loweringAuthorityCid: layout.FixedBytes32):
        layout.FixedBytes32 =
    var authorityErr: str
    let zeroCid = layout.FixedBytes32()
    let authorityValid =
        snapshot_authority.
            CompilerSnapshotLoweringAuthorityPlanOwnedStrictValidateInto(
            authority, authorityErr)
    let factsRootMatches =
        layout.FixedBytes32Equal(
            factsRootCid,
            snapshot_authority.CompilerSnapshotLoweringAuthorityFactsRootCid(
                authority))
    let loweringAuthorityMatches =
        layout.FixedBytes32Equal(
            loweringAuthorityCid,
            snapshot_authority.CompilerSnapshotLoweringAuthorityIdentityCid(
                authority))
    if !authorityValid ||
       functionId < 0 ||
       typedFunctionIndex < 0 ||
       layout.FixedBytes32Equal(factsRootCid, zeroCid) ||
       layout.FixedBytes32Equal(fragmentCid, zeroCid) ||
       layout.FixedBytes32Equal(interfaceCid, zeroCid) ||
       layout.FixedBytes32Equal(loweringAuthorityCid, zeroCid) ||
       !factsRootMatches ||
       !loweringAuthorityMatches:
        panic("csg body ir cleanup source projection authority invalid" +
              authorityErr)
    var bytes = layout.ByteBufInit(196)
    csgCoreBodyIrCleanupAuthorityAppendText(
        bytes, CsgCoreBodyIrCleanupSourceProjectionDomain)
    layout.ByteBufAppendFixed32(bytes, factsRootCid)
    csgCoreBodyIrCleanupAuthorityAppendI32(bytes, functionId)
    csgCoreBodyIrCleanupAuthorityAppendI32(bytes, typedFunctionIndex)
    layout.ByteBufAppendFixed32(bytes, fragmentCid)
    layout.ByteBufAppendFixed32(bytes, interfaceCid)
    layout.ByteBufAppendFixed32(bytes, loweringAuthorityCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    if layout.FixedBytes32Equal(out, zeroCid):
        panic("csg body ir cleanup source projection cid is zero")
    return out
