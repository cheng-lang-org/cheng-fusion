@borrows
fn csgCompilerDiagnosticFailureLines(
        artifact:
            var diagnostic_failure.DiagnosticFailureArtifact): str[] =
    return [csgCompilerFailureSchemaLine(),
            csgCompilerDiagnosticFailureArtifactLine(artifact)]

@borrows
fn csgCompilerDiagnosticFailureLinesStrictValidateInto(
        lines: str[],
        err: var str): bool =
    if lines.len != 2 ||
       lines[0] != csgCompilerFailureSchemaLine():
        err = " csg compiler diagnostic failure cargo: fact table count mismatch"
        return false
    let kind = json_field.CsgCoreJsonKind(lines[1])
    let checked = canonical.CsgCoreJsonCanonicalize(lines[1])
    let schemaVersion = json_field.CsgCoreJsonTopRawField(
        lines[1], "schemaVersion")
    let anchorKinds = json_field.CsgCoreJsonTopRawField(
        lines[1], "anchorKinds")
    let authorityRoot = json_field.CsgCoreJsonTopStringField(
        lines[1], "parserDiagnosticAuthorityRootCid")
    if !kind.found ||
       kind.value !=
           "csg_dialect::cheng_compiler::diagnostic_failure_artifact" ||
       !checked.ok || checked.value != lines[1] ||
       !schemaVersion.found ||
       schemaVersion.value != strings.IntToStr(
           diagnostic_failure.DiagnosticFailureSchemaVersionLatest):
        err = " csg compiler diagnostic failure cargo: schema mismatch"
        return false
    if !anchorKinds.found ||
       (anchorKinds.value != "[1]" &&
        anchorKinds.value != "[2]"):
        err = " csg compiler diagnostic failure cargo: event anchor mismatch"
        return false
    if !authorityRoot.found ||
       authorityRoot.value !=
           strings.ConcatStr(
               "sha256:",
               layout.FixedBytes32Hex(layout.FixedBytes32())):
        err = " csg compiler diagnostic failure cargo: event authority root mismatch"
        return false
    err = ""
    return true

@borrows
fn CsgCompilerDiagnosticFailureCargoBuild(
        artifact:
            var diagnostic_failure.DiagnosticFailureArtifact): CsgCompilerDiagnosticFailureCargo =
    var err: str
    if !diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
           artifact, err):
        var failed: CsgCompilerDiagnosticFailureCargo
        failed.error = err
        return failed
    if artifact.anchorKinds.len != 1 ||
       (artifact.anchorKinds[0] !=
            diagnostic_failure.DiagnosticFailureAnchorSource &&
        artifact.anchorKinds[0] !=
            diagnostic_failure.DiagnosticFailureAnchorSpan) ||
       csgCompilerFailureCidObserved(
           artifact.parserDiagnosticAuthorityRootCid):
        var failed: CsgCompilerDiagnosticFailureCargo
        failed.error =
            " csg compiler diagnostic failure cargo: structural authority required"
        return failed
    let lines = csgCompilerDiagnosticFailureLines(artifact)
    if !csgCompilerDiagnosticFailureLinesStrictValidateInto(lines, err):
        var failed: CsgCompilerDiagnosticFailureCargo
        failed.error = err
        return failed
    let admitted = csgCompilerCargoProductionAdmit(
        lines, " csg compiler diagnostic failure cargo")
    if !admitted.ok:
        var failed: CsgCompilerDiagnosticFailureCargo
        failed.error = admitted.error
        return failed
    var encoded = csgc.CsgCoreCsgcEncodeVerifiedLines(lines)
    if !encoded.ok:
        var failed: CsgCompilerDiagnosticFailureCargo
        failed.error = encoded.error
        return failed
    if encoded.factCount != admitted.factCount:
        var doomed = encoded.bytes
        encoded.bytes = rawbytes.emptyBytes()
        rawbytes.BytesFree(doomed)
        var failed: CsgCompilerDiagnosticFailureCargo
        failed.error =
            " csg compiler diagnostic failure cargo: encoded fact count mismatch"
        return failed
    var out: CsgCompilerDiagnosticFailureCargo
    out.ok = true
    out.factsRootCid = admitted.factsRootCid
    out.cargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(encoded.bytes))
    out.canonicalLines = lines
    out.csgcBytes = encoded.bytes
    return out

@borrows
fn CsgCompilerDiagnosticFailureCargoVerify(
        bytes: rawbytes.Bytes,
        expectedRoot: layout.FixedBytes32): CsgCompilerVerifiedDiagnosticFailureCargo =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    var failed: CsgCompilerVerifiedDiagnosticFailureCargo
    if !decoded.ok:
        failed.error = decoded.error
        return failed
    var err: str
    if !csgCompilerDiagnosticFailureLinesStrictValidateInto(
           decoded.lines, err):
        failed.error = err
        return failed
    let admitted = csgCompilerCargoProductionAdmit(
        decoded.lines, " csg compiler diagnostic failure cargo")
    if !admitted.ok:
        failed.error = admitted.error
        return failed
    if !layout.FixedBytes32Equal(
           admitted.factsRootCid, expectedRoot):
        failed.error =
            " csg compiler diagnostic failure cargo: facts root mismatch"
        return failed
    var out: CsgCompilerVerifiedDiagnosticFailureCargo
    out.ok = true
    out.factsRootCid = admitted.factsRootCid
    out.cargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(bytes))
    out.canonicalLines = decoded.lines
    return out

fn CsgCompilerDiagnosticFailureCargoRelease(
        cargo: var CsgCompilerDiagnosticFailureCargo) =
    rawbytes.BytesFree(cargo.csgcBytes)
    cargo.canonicalLines = []
    cargo.ok = false
