    csgCompilerCargoAppend(out, ",\"declSymbolIds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.declSymbolIds)
    csgCompilerCargoAppend(out, ",\"elementTypeIds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.elementTypeIds)
    csgCompilerCargoAppend(out, ",\"genericParameterParserRows\":")
    csgCompilerCargoAppendIntArray(
        out, snapshot.types.genericParameterParserRows)
    csgCompilerCargoAppend(out,
        ",\"kind\":\"csg_dialect::cheng_compiler::types\",\"managedFlags\":")
    csgCompilerCargoAppendBoolArray(out, snapshot.types.managedFlags)
    csgCompilerCargoAppend(out, ",\"producerTypeArenaIds\":")
    csgCompilerCargoAppendIntArray(
        out, snapshot.types.producerTypeArenaIds)
    csgCompilerCargoAppend(out, ",\"scalarKinds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.scalarKinds)
    csgCompilerCargoAppend(out, ",\"sendFlags\":")
    csgCompilerCargoAppendBoolArray(out, snapshot.types.sendFlags)
    csgCompilerCargoAppend(out, ",\"syncFlags\":")
    csgCompilerCargoAppendBoolArray(out, snapshot.types.syncFlags)
    csgCompilerCargoAppend(out, ",\"traitConclusionKinds\":")
    csgCompilerCargoAppendIntArray(
        out, snapshot.types.traitConclusionKinds)
    csgCompilerCargoAppend(out, ",\"traitPremiseCounts\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.traitPremiseCounts)
    csgCompilerCargoAppend(out, ",\"traitPremiseStarts\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.traitPremiseStarts)
    csgCompilerCargoAppend(out, ",\"traitPremiseTypeIds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.traitPremiseTypeIds)
    csgCompilerCargoAppend(out, ",\"traitProofCids\":")
    csgCompilerCargoAppendCidArray(out, snapshot.types.traitProofCids)
    csgCompilerCargoAppend(out, ",\"traitProofKinds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.traitProofKinds)
    csgCompilerCargoAppend(out, ",\"typeCids\":")
    csgCompilerCargoAppendCidArray(out, snapshot.types.typeCids)
    csgCompilerCargoAppend(out, ",\"typeKinds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.typeKinds)
    # [phaseB-enum-schema] Enum variant payload CSR columns ride the cargo
    # evidence line so a CsgCompilerTypeEnum row's declared variant rows are
    # fully covered by the snapshot cargo.
    csgCompilerCargoAppend(out, ",\"variantCounts\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.variantCounts)
    csgCompilerCargoAppend(out, ",\"variantNameTextIds\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.variantNameTextIds)
