    var lines: str[]
    add(lines, csgCompilerCargoSchemaLine())
    add(lines, csgCompilerCargoSnapshotLine(snapshot))
    add(lines, csgCompilerCargoTextsLine(snapshot))
    add(lines, csgCompilerCargoSourcesLine(snapshot))
    add(lines, csgCompilerCargoSpansLine(snapshot))
    add(lines, csgCompilerCargoParserLine(snapshot))
    add(lines, csgCompilerCargoTokensLine(snapshot))
    add(lines, csgCompilerCargoParserSidecarsLine(snapshot))
    add(lines, csgCompilerCargoTypesLine(snapshot))
    add(lines, csgCompilerCargoDeclarationsLine(snapshot))
    add(lines, csgCompilerCargoSymbolsLine(snapshot))
    add(lines, csgCompilerCargoAnnotationTargetsLine(snapshot))
    add(lines, csgCompilerCargoLexicalScopesLine(snapshot))
    add(lines, csgCompilerCargoFunctionsLine(snapshot))
    add(lines, csgCompilerCargoExternFunctionsLine(snapshot))
    add(lines, csgCompilerCargoReadSetLine(snapshot))
    add(lines, csgCompilerCargoReferencesLine(snapshot))
    add(lines, csgCompilerCargoCallsLine(snapshot))
    add(lines, csgCompilerCargoLayoutsLine(snapshot))
    add(lines, csgCompilerCargoLayoutFieldsLine(snapshot))
    add(lines, csgCompilerCargoTypedNodesLine(snapshot))
    add(lines, csgCompilerCargoDependenciesLine(snapshot))
    add(lines, csgCompilerCargoDebugLine(snapshot))
    add(lines, csgCompilerCargoDiagnosticCompletionsLine(snapshot))
    add(lines, csgCompilerCargoDiagnosticsLine(snapshot))
    return lines

@borrows
fn csgCompilerCargoLinesByteCount(
        lines: str[]): int32 =
    var byteCount: int64
    for index in 0..<lines.len:
        byteCount =
            byteCount +
            int64(lines[index].len) +
            int64(1)
        if byteCount > int64(2147483647):
            return -1
    return Int32(byteCount)

fn csgCompilerCargoExpectedKind(index: int32): str =
    if index == 0: return "csg.core.schema"
    if index == 1: return "csg_dialect::cheng_compiler::snapshot"
    if index == 2: return "csg_dialect::cheng_compiler::texts"
    if index == 3: return "csg_dialect::cheng_compiler::sources"
    if index == 4: return "csg_dialect::cheng_compiler::spans"
    if index == 5: return "csg_dialect::cheng_compiler::parser_nodes"
    if index == 6: return "csg_dialect::cheng_compiler::tokens"
    if index == 7: return "csg_dialect::cheng_compiler::parser_sidecars"
    if index == 8: return "csg_dialect::cheng_compiler::types"
    if index == 9: return "csg_dialect::cheng_compiler::declarations"
    if index == 10: return "csg_dialect::cheng_compiler::symbols"
    if index == 11: return "csg_dialect::cheng_compiler::annotation_targets"
    if index == 12: return "csg_dialect::cheng_compiler::lexical_scopes"
    if index == 13: return "csg_dialect::cheng_compiler::functions"
    if index == 14: return "csg_dialect::cheng_compiler::extern_functions"
    if index == 15: return "csg_dialect::cheng_compiler::read_set"
    if index == 16: return "csg_dialect::cheng_compiler::references"
    if index == 17: return "csg_dialect::cheng_compiler::calls"
    if index == 18: return "csg_dialect::cheng_compiler::layouts"
    if index == 19: return "csg_dialect::cheng_compiler::layout_fields"
    if index == 20: return "csg_dialect::cheng_compiler::typed_nodes"
    if index == 21: return "csg_dialect::cheng_compiler::dependencies"
    if index == 22: return "csg_dialect::cheng_compiler::debug_ops"
    if index == 23:
        return "csg_dialect::cheng_compiler::diagnostic_completions"
    if index == 24: return "csg_dialect::cheng_compiler::diagnostics"
    return ""

@borrows
fn csgCompilerCargoPositiveDecimal(value: str): bool =
    if value.len <= 0 || value.len > 19 ||
       value[0] < '1' || value[0] > '9':
        return false
    for index in 1..<value.len:
        if value[index] < '0' || value[index] > '9':
            return false
    if value.len == 19:
        let maximum = "9223372036854775807"
        for index in 0..<value.len:
            if value[index] < maximum[index]:
                return true
            if value[index] > maximum[index]:
                return false
    return true

@borrows
fn CsgCompilerCargoRestoreDialectOrder(
        lines: str[],
        err: var str): str[] =
    var expectedKinds: str[]
    for index in 0..<25:
        add(expectedKinds, csgCompilerCargoExpectedKind(index))
    let ordered =
        csgc.CsgCoreCsgcRestoreLinesByExpectedKind(
            lines, expectedKinds, err)
    if err != "":
        if err == "csgc_line_kind_count_mismatch":
            err = " csg compiler cargo: fact table count mismatch"
        elif err == "csgc_line_kind_missing":
            err = " csg compiler cargo: fact kind missing"
        else:
            err = " csg compiler cargo: fact table order mismatch"
    return ordered

@borrows
fn csgCompilerCargoLineSetExact(lines: str[], err: var str): bool =
    if lines.len != 25:
        err = " csg compiler cargo: fact table count mismatch"
        return false
    if lines[0] != csgCompilerCargoSchemaLine():
        err = " csg compiler cargo: canonical schema declaration mismatch"
        return false
    for index in 0..<lines.len:
        let kind = json_field.CsgCoreJsonKind(lines[index])
        if !kind.found || kind.value != csgCompilerCargoExpectedKind(index):
            err = " csg compiler cargo: fact table order mismatch"
            return false
    let schemaVersion = json_field.CsgCoreJsonTopRawField(
        lines[1], "schemaVersion")
    let semanticEpoch = json_field.CsgCoreJsonTopRawField(
        lines[1], "semanticEpoch")
    if !schemaVersion.found ||
       schemaVersion.value != strings.IntToStr(
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest) ||
       !semanticEpoch.found ||
       !csgCompilerCargoPositiveDecimal(semanticEpoch.value):
        err = " csg compiler cargo: snapshot schema/epoch mismatch"
        return false
    return true

@borrows
fn csgCompilerCargoSectionRoot(domain: str,
                               lines: str[],
                               indexes: int32[]): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(512)
    csgCompilerCargoAppendU32(bytes, domain.len)
    csgCompilerCargoAppend(bytes, domain)
    csgCompilerCargoAppendU32(bytes, indexes.len)
    for offset in 0..<indexes.len:
        let index = indexes[offset]
        if index < 0 || index >= lines.len:
            panic("csg_compiler_cargo_section_index_invalid")
        csgCompilerCargoAppendU32(bytes, lines[index].len)
        csgCompilerCargoAppend(bytes, lines[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn csgCompilerCargoLifecycleRoot(
        roots: CsgCompilerSnapshotProofRoots,
        factsRoot: layout.FixedBytes32,
        cargoCid: layout.FixedBytes32): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(384)
    csgCompilerCargoAppend(
        bytes, "cheng.csg.compiler_snapshot.lifecycle")
    layout.ByteBufAppendFixed32(bytes, roots.parserRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.typeRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.ownershipRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.callRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.layoutRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.dependencyRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.readSetRootCid)
    layout.ByteBufAppendFixed32(bytes, roots.reachabilityRootCid)
    layout.ByteBufAppendFixed32(bytes, factsRoot)
    layout.ByteBufAppendFixed32(bytes, cargoCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn csgCompilerCargoSectionProofRoots(
        lines: str[]): CsgCompilerSnapshotProofRoots =
    var out: CsgCompilerSnapshotProofRoots
    let parserRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.parser", lines,
        [1, 2, 3, 4, 5, 6, 7])
    out.parserRootCid = parserRootCid
    let typeRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.type", lines,
        [8, 9, 10, 11, 12, 13, 14])
    out.typeRootCid = typeRootCid
    let ownershipRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.ownership", lines, [13, 17, 20])
    out.ownershipRootCid = ownershipRootCid
    let callRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.call", lines, [14, 16, 17])
    out.callRootCid = callRootCid
    let layoutRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.layout", lines, [8, 18, 19])
    out.layoutRootCid = layoutRootCid
    let dependencyRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.dependency", lines, [3, 21])
    out.dependencyRootCid = dependencyRootCid
    let readSetRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.read_set", lines, [9, 10, 13, 15])
    out.readSetRootCid = readSetRootCid
    let reachabilityRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.reachability", lines,
        [9, 13, 14, 15, 17, 21])
    out.reachabilityRootCid = reachabilityRootCid
    return out

fn csgCompilerCargoProofRootsBindLifecycle(
        sectionRoots: CsgCompilerSnapshotProofRoots,
        factsRoot: layout.FixedBytes32,
        cargoCid: layout.FixedBytes32): CsgCompilerSnapshotProofRoots =
    var out = sectionRoots
    let lifecycleRootCid = csgCompilerCargoLifecycleRoot(
        out, factsRoot, cargoCid)
    out.lifecycleRootCid = lifecycleRootCid
    return out

@borrows
fn csgCompilerCargoLinesCanonical(lines: str[], err: var str): bool =
    # Packed SoA cargo keeps JSON facts compact ({n,o} column refs).
    # Packed nats are emitted in JSON canonical number form so partition
    # CanonicalFact(fact)==fact without building a JSON AST.
    return csgCompilerCargoLineSetExact(lines, err)

@borrows
fn csgCompilerCargoRewriteSnapshotSoaCid(
        line: str,
        soaCid: layout.FixedBytes32,
        rewritten: var str,
        err: var str): bool =
    let marker = "\"soaCid\":\"sha256:"
    var markerAt: int32 = -1
    var start: int32
    while start + marker.len <= line.len:
        var matched = true
        var offset: int32
        while offset < marker.len:
            if line[start + offset] != marker[offset]:
                matched = false
                break
            offset = offset + 1
        if matched:
            markerAt = start
            break
        start = start + 1
    let hexAt = markerAt + marker.len
    if markerAt < 0 || hexAt + 64 > line.len:
        err = " csg compiler cargo: snapshot soaCid field missing"
        return false
    let hex = layout.FixedBytes32Hex(soaCid)
    if hex.len != 64:
        err = " csg compiler cargo: snapshot soaCid invalid"
        return false
    var buf = layout.ByteBufInit(line.len)
    var index: int32
    while index < hexAt:
        layout.ByteBufAppendByte(buf, Int32(line[index]) & 255)
        index = index + 1
    index = 0
    while index < 64:
        layout.ByteBufAppendByte(buf, Int32(hex[index]) & 255)
        index = index + 1
    index = hexAt + 64
    while index < line.len:
        layout.ByteBufAppendByte(buf, Int32(line[index]) & 255)
        index = index + 1
    var bytes = layout.ByteBufToBytes(buf)
    rewritten = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn CsgCompilerSnapshotCargoBuild(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables): CsgCompilerSnapshotCargo =
    var err: str
    if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err):
        return csgCompilerCargoFail(err)
    csgCompilerCargoSoaPackBegin()
    var lines = csgCompilerCargoCanonicalLines(snapshot)
    var packed = csgCompilerCargoSoaPackFinish()
    let soaCid = hash256.Sha256Fixed(layout.ByteSpanFromBytes(packed))
    var snapshotLine: str
    if lines.len < 2 ||
       !csgCompilerCargoRewriteSnapshotSoaCid(
           lines[1], soaCid, snapshotLine, err):
        rawbytes.BytesFree(packed)
        return csgCompilerCargoFail(err)
    lines[1] = snapshotLine
    if !csgCompilerCargoLinesCanonical(lines, err):
        rawbytes.BytesFree(packed)
        return csgCompilerCargoFail(err)
    let admitted = csgCompilerCargoProductionAdmit(
        lines, " csg compiler cargo")
    if !admitted.ok:
        rawbytes.BytesFree(packed)
        return csgCompilerCargoFail(admitted.error)
    let jsonlBytes =
        csgCompilerCargoLinesByteCount(lines)
    if jsonlBytes < 0:
        rawbytes.BytesFree(packed)
        return csgCompilerCargoFail(
            " csg compiler cargo: canonical JSONL size out of range")
    var encoded = csgc.CsgCoreCsgcEncodeVerifiedLines(lines)
    if !encoded.ok:
        rawbytes.BytesFree(packed)
        return csgCompilerCargoFail(strings.ConcatStr(
            " csg compiler cargo: CSGC encode failed ", encoded.error))
    if encoded.factCount != admitted.factCount:
        var doomed = encoded.bytes
        encoded.bytes = rawbytes.emptyBytes()
        rawbytes.BytesFree(doomed)
        rawbytes.BytesFree(packed)
        return csgCompilerCargoFail(
            " csg compiler cargo: encoded fact count mismatch")
    # Packed SoA is hashed into snapshot soaCid. Merkle CSGC stays the
    # JSON fact encoding so the cargo store object matches cargo.csgcBytes.
    rawbytes.BytesFree(packed)
    let cargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(encoded.bytes))
    let encodedByteCount = rawbytes.BytesLen(encoded.bytes)
    let sectionProofRoots =
        csgCompilerCargoSectionProofRoots(lines)
    let proofRoots = csgCompilerCargoProofRootsBindLifecycle(
        sectionProofRoots, admitted.factsRootCid, cargoCid)
    var out: CsgCompilerSnapshotCargo
    out.ok = true
    out.standard = strings.CloneStr(admitted.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(
            admitted.profiles)
    out.profileSetCid =
        strings.CloneStr(admitted.profileSetCid)
    out.schemaNamespace =
        strings.CloneStr(admitted.schemaNamespace)
    out.schemaCid = strings.CloneStr(admitted.schemaCid)
    out.factsRoot = strings.CloneStr(admitted.factsRoot)
    out.factsSubgraphCid =
        strings.CloneStr(admitted.factsSubgraphCid)
    out.dagRootCid = strings.CloneStr(admitted.dagRootCid)
    out.factCount = admitted.factCount
    out.factsRootCid = admitted.factsRootCid
    out.cargoCid = cargoCid
    out.proofRoots = proofRoots
    out.canonicalLines = lines
    out.canonicalJsonlBytes = jsonlBytes
    out.csgcByteCount = encodedByteCount
    out.csgcBytes = encoded.bytes
    return out

@borrows
fn CsgCompilerSnapshotCargoVerify(
        bytes: rawbytes.Bytes,
        expectedRoot: layout.FixedBytes32): CsgCompilerSnapshotVerifiedCargo =
    let prefixLen = csgCompilerCargoCsgcPrefixLen(bytes)
    if prefixLen < 0:
        return csgCompilerVerifiedCargoFail(
            " csg compiler cargo: CSGC physical prefix invalid")
    var prefix = rawbytes.BytesSliceView(bytes, 0, prefixLen)
    let decoded = csgc.CsgCoreCsgcDecodeLines(prefix)
    if !decoded.ok:
        return csgCompilerVerifiedCargoFail(strings.ConcatStr(
            " csg compiler cargo: CSGC decode failed ", decoded.error))
    if decoded.lines.len >= 2:
        let physicalSoa = json_field.CsgCoreJsonTopRawField(
            decoded.lines[1], "physicalSoa")
        if physicalSoa.found:
            let packedLen = rawbytes.BytesLen(bytes) - prefixLen
            if packedLen > 0:
                var packed = rawbytes.BytesSliceView(
                    bytes, prefixLen, packedLen)
                let packedCid = hash256.Sha256Fixed(
                    layout.ByteSpanFromBytes(packed))
                let soaCidField = json_field.CsgCoreJsonTopStringField(
                    decoded.lines[1], "soaCid")
                let expectedSoa =
                    strings.ConcatStr(
                        "sha256:",
                        layout.FixedBytes32Hex(packedCid))
                if !soaCidField.found || soaCidField.value != expectedSoa:
                    return csgCompilerVerifiedCargoFail(
                        " csg compiler cargo: physical SoA cid mismatch")
    var err: str
    let dialectLines =
        CsgCompilerCargoRestoreDialectOrder(decoded.lines, err)
    if err != "":
        return csgCompilerVerifiedCargoFail(err)
    if !csgCompilerCargoLinesCanonical(dialectLines, err):
        return csgCompilerVerifiedCargoFail(err)
    let admitted = csgCompilerCargoProductionAdmit(
        dialectLines, " csg compiler cargo")
    if !admitted.ok:
        return csgCompilerVerifiedCargoFail(admitted.error)
    if !layout.FixedBytes32Equal(
           admitted.factsRootCid, expectedRoot):
        return csgCompilerVerifiedCargoFail(
            " csg compiler cargo: facts root mismatch")
    let cargoCid = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes))
    let sectionProofRoots =
        csgCompilerCargoSectionProofRoots(dialectLines)
    let proofRoots = csgCompilerCargoProofRootsBindLifecycle(
        sectionProofRoots, admitted.factsRootCid, cargoCid)
    var out: CsgCompilerSnapshotVerifiedCargo
    out.ok = true
    out.standard = strings.CloneStr(admitted.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(
            admitted.profiles)
    out.profileSetCid =
        strings.CloneStr(admitted.profileSetCid)
    out.schemaNamespace =
        strings.CloneStr(admitted.schemaNamespace)
    out.schemaCid = strings.CloneStr(admitted.schemaCid)
    out.factsRoot = strings.CloneStr(admitted.factsRoot)
    out.factsSubgraphCid =
        strings.CloneStr(admitted.factsSubgraphCid)
    out.dagRootCid = strings.CloneStr(admitted.dagRootCid)
    out.factCount = admitted.factCount
    out.factsRootCid = admitted.factsRootCid
    out.cargoCid = cargoCid
    out.proofRoots = proofRoots
    out.canonicalLines = dialectLines
    return out

@borrows
fn csgCompilerSnapshotMerkleFail(
        error: str): CsgCompilerSnapshotMerkleTransaction =
    var out: CsgCompilerSnapshotMerkleTransaction
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgCompilerSnapshotProofRootsEqual(
        left: CsgCompilerSnapshotProofRoots,
        right: CsgCompilerSnapshotProofRoots): bool =
    return layout.FixedBytes32Equal(
               left.parserRootCid, right.parserRootCid) &&
        layout.FixedBytes32Equal(
               left.typeRootCid, right.typeRootCid) &&
        layout.FixedBytes32Equal(
               left.ownershipRootCid, right.ownershipRootCid) &&
        layout.FixedBytes32Equal(
               left.callRootCid, right.callRootCid) &&
        layout.FixedBytes32Equal(
               left.layoutRootCid, right.layoutRootCid) &&
        layout.FixedBytes32Equal(
               left.dependencyRootCid, right.dependencyRootCid) &&
        layout.FixedBytes32Equal(
               left.readSetRootCid, right.readSetRootCid) &&
        layout.FixedBytes32Equal(
               left.reachabilityRootCid, right.reachabilityRootCid) &&
        layout.FixedBytes32Equal(
               left.lifecycleRootCid, right.lifecycleRootCid)

@borrows
fn csgCompilerSnapshotLinesEqual(
        left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn CsgCompilerSnapshotCargoMerkleSourceId(): str =
    let role = "csg_dialect::cheng_compiler::snapshot_cargo"
    var payload = layout.ByteBufInit(64)
    csgCompilerCargoAppendU32(payload, role.len)
    csgCompilerCargoAppend(payload, role)
    var bytes = layout.ByteBufToBytes(payload)
    let out =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.compiler_snapshot.source_identity",
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn CsgCompilerSnapshotEnvelopeSourceId(
        binding: CsgCompilerSnapshotEnvelopeBinding): str =
    if !csgCompilerSnapshotEnvelopeBindingValid(binding):
        return ""
    let role = "csg_core::compiler_snapshot_envelope"
    var payload = layout.ByteBufInit(512)
    csgCompilerCargoAppendU32(payload, role.len)
    csgCompilerCargoAppend(payload, role)
    csgCompilerCargoAppendU32(payload, binding.snapshotSchemaVersion)
    csgCompilerCargoAppendU32(payload, binding.standard.len)
    csgCompilerCargoAppend(payload, binding.standard)
    csgCompilerCargoAppendU32(payload, binding.profiles.len)
    for index in 0..<binding.profiles.len:
        csgCompilerCargoAppendU32(payload, binding.profiles[index].len)
        csgCompilerCargoAppend(payload, binding.profiles[index])
    csgCompilerCargoAppendU32(payload, binding.profileSetCid.len)
    csgCompilerCargoAppend(payload, binding.profileSetCid)
    csgCompilerCargoAppendU32(payload, binding.schemaNamespace.len)
    csgCompilerCargoAppend(payload, binding.schemaNamespace)
    csgCompilerCargoAppendU32(payload, binding.schemaCid.len)
    csgCompilerCargoAppend(payload, binding.schemaCid)
    var bytes = layout.ByteBufToBytes(payload)
    let out =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.compiler_snapshot.envelope_source_identity",
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

fn CsgCompilerSnapshotEnvelopeSchemaLine(): str =
    return "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"

@borrows
fn csgCompilerSnapshotEnvelopeCidObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn csgCompilerSnapshotEnvelopeBindingValid(
        binding: CsgCompilerSnapshotEnvelopeBinding): bool =
    if !binding.ok || binding.error.len != 0 ||
       binding.snapshotSchemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       binding.semanticEpoch <= int64(0) ||
       !csgCompilerSnapshotEnvelopeCidObserved(
           binding.snapshotPredecessorReceiptCid) ||
       !csgCompilerSnapshotEnvelopeCidObserved(binding.worldHeadCid) ||
       !csgCompilerSnapshotEnvelopeCidObserved(binding.executionCid) ||
       !csgCompilerSnapshotEnvelopeCidObserved(binding.sourceBundleCid) ||
       !csgCompilerSnapshotEnvelopeCidObserved(
           binding.sourceIdentityReceiptCid) ||
       (binding.originKind != CsgCompilerSnapshotEnvelopeOriginFresh &&
        binding.originKind !=
            CsgCompilerSnapshotEnvelopeOriginLegacyMigration) ||
       binding.cargoByteCount <= 0 ||
       !csgCompilerSnapshotEnvelopeCidObserved(binding.cargoCid) ||
       binding.standard != validator.CsgCoreStandardIdentity() ||
       validator.CsgCoreProfilesCanonicalError(binding.profiles).len != 0 ||
       binding.profileSetCid !=
           validator.CsgCoreProfileSetCidForIdentity(
               binding.standard,
               binding.schemaNamespace,
               binding.profiles) ||
       binding.schemaNamespace !=
           validator.CsgCoreSchemaNamespaceIdentity():
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(binding.originCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.previousEnvelopeHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.previousEnvelopeReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.cargoStoreIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.cargoStoreHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.cargoStoreManifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.cargoStoreReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.cargoStoreCsgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.profileSetCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(binding.schemaCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(binding.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.factsSubgraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(binding.dagRootCid):
        return false
    return csgCompilerSnapshotEnvelopeCidObserved(
               binding.proofRoots.parserRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.typeRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.ownershipRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.callRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.layoutRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.dependencyRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.readSetRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.reachabilityRootCid) &&
        csgCompilerSnapshotEnvelopeCidObserved(
            binding.proofRoots.lifecycleRootCid)

@borrows
fn CsgCompilerSnapshotEnvelopeBindingCid(
        binding: CsgCompilerSnapshotEnvelopeBinding): str =
    if !csgCompilerSnapshotEnvelopeBindingValid(binding):
        return ""
    var payload = layout.ByteBufInit(2048)
    let domain = "csg_core.compiler_snapshot.envelope_binding"
    csgCompilerCargoAppendU32(payload, domain.len)
    csgCompilerCargoAppend(payload, domain)
    csgCompilerCargoAppendU32(payload, binding.snapshotSchemaVersion)
    csgCompilerCargoAppendI64(payload, binding.semanticEpoch)
    layout.ByteBufAppendFixed32(
        payload, binding.snapshotPredecessorReceiptCid)
    layout.ByteBufAppendFixed32(payload, binding.worldHeadCid)
    layout.ByteBufAppendFixed32(payload, binding.executionCid)
    layout.ByteBufAppendFixed32(payload, binding.sourceBundleCid)
    layout.ByteBufAppendFixed32(
        payload, binding.sourceIdentityReceiptCid)
    csgCompilerCargoAppendU32(payload, binding.originCid.len)
    csgCompilerCargoAppend(payload, binding.originCid)
    csgCompilerCargoAppendU32(
        payload, binding.previousEnvelopeHeadCid.len)
    csgCompilerCargoAppend(payload, binding.previousEnvelopeHeadCid)
    csgCompilerCargoAppendU32(
        payload, binding.previousEnvelopeReceiptCid.len)
    csgCompilerCargoAppend(payload, binding.previousEnvelopeReceiptCid)
    csgCompilerCargoAppendU32(payload, binding.cargoStoreIdentityCid.len)
    csgCompilerCargoAppend(payload, binding.cargoStoreIdentityCid)
    csgCompilerCargoAppendU32(payload, binding.cargoStoreHeadCid.len)
    csgCompilerCargoAppend(payload, binding.cargoStoreHeadCid)
    csgCompilerCargoAppendU32(payload, binding.cargoStoreManifestCid.len)
    csgCompilerCargoAppend(payload, binding.cargoStoreManifestCid)
    csgCompilerCargoAppendU32(payload, binding.cargoStoreReceiptCid.len)
    csgCompilerCargoAppend(payload, binding.cargoStoreReceiptCid)
    csgCompilerCargoAppendU32(
        payload, binding.cargoStoreCsgcObjectCid.len)
    csgCompilerCargoAppend(payload, binding.cargoStoreCsgcObjectCid)
    csgCompilerCargoAppendU32(payload, binding.originKind)
    layout.ByteBufAppendFixed32(payload, binding.cargoCid)
    csgCompilerCargoAppendU32(payload, binding.cargoByteCount)
    csgCompilerCargoAppendU32(payload, binding.standard.len)
    csgCompilerCargoAppend(payload, binding.standard)
    csgCompilerCargoAppendU32(payload, binding.profiles.len)
    for index in 0..<binding.profiles.len:
        csgCompilerCargoAppendU32(payload, binding.profiles[index].len)
        csgCompilerCargoAppend(payload, binding.profiles[index])
    csgCompilerCargoAppendU32(payload, binding.profileSetCid.len)
    csgCompilerCargoAppend(payload, binding.profileSetCid)
    csgCompilerCargoAppendU32(payload, binding.schemaNamespace.len)
    csgCompilerCargoAppend(payload, binding.schemaNamespace)
    csgCompilerCargoAppendU32(payload, binding.schemaCid.len)
    csgCompilerCargoAppend(payload, binding.schemaCid)
    csgCompilerCargoAppendU32(payload, binding.factsRoot.len)
    csgCompilerCargoAppend(payload, binding.factsRoot)
    csgCompilerCargoAppendU32(payload, binding.factsSubgraphCid.len)
    csgCompilerCargoAppend(payload, binding.factsSubgraphCid)
    csgCompilerCargoAppendU32(payload, binding.dagRootCid.len)
    csgCompilerCargoAppend(payload, binding.dagRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.parserRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.typeRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.ownershipRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.callRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.layoutRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.dependencyRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.readSetRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.reachabilityRootCid)
    layout.ByteBufAppendFixed32(payload, binding.proofRoots.lifecycleRootCid)
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn csgCompilerSnapshotEnvelopeLine(
        binding: CsgCompilerSnapshotEnvelopeBinding,
        identityCid: str): str =
    var out = layout.ByteBufInit(4096)
    csgCompilerCargoAppend(
        out,
        "{\"dataKind\":\"compiler_snapshot_head\",\"id\":\"csg_core::compiler_snapshot_head\",\"kind\":\"csg.data\",\"value\":{\"cargoByteCount\":")
    csgCompilerCargoAppend(out, strings.IntToStr(binding.cargoByteCount))
    csgCompilerCargoAppend(out, ",\"cargoCallRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.callRootCid)
    csgCompilerCargoAppend(out, ",\"cargoCid\":")
    csgCompilerCargoAppendCid(out, binding.cargoCid)
    csgCompilerCargoAppend(out, ",\"cargoDagRootCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.dagRootCid))
    csgCompilerCargoAppend(out, ",\"cargoDependencyRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.dependencyRootCid)
    csgCompilerCargoAppend(out, ",\"cargoFactsRoot\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.factsRoot))
    csgCompilerCargoAppend(out, ",\"cargoFactsSubgraphCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.factsSubgraphCid))
    csgCompilerCargoAppend(out, ",\"cargoLayoutRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.layoutRootCid)
    csgCompilerCargoAppend(out, ",\"cargoLifecycleRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.lifecycleRootCid)
    csgCompilerCargoAppend(out, ",\"cargoOwnershipRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.ownershipRootCid)
    csgCompilerCargoAppend(out, ",\"cargoParserRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.parserRootCid)
    csgCompilerCargoAppend(out, ",\"cargoProfileSetCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.profileSetCid))
    csgCompilerCargoAppend(out, ",\"cargoProfiles\":")
    csgCompilerCargoAppendTextArray(out, binding.profiles)
    csgCompilerCargoAppend(out, ",\"cargoReachabilityRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.reachabilityRootCid)
    csgCompilerCargoAppend(out, ",\"cargoReadSetRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.readSetRootCid)
    csgCompilerCargoAppend(out, ",\"cargoSchemaCid\":")
    csgCompilerCargoAppend(out, canonical.CsgCoreJsonQuote(binding.schemaCid))
    csgCompilerCargoAppend(out, ",\"cargoSchemaNamespace\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.schemaNamespace))
    csgCompilerCargoAppend(out, ",\"cargoStandard\":")
    csgCompilerCargoAppend(out, canonical.CsgCoreJsonQuote(binding.standard))
    csgCompilerCargoAppend(out, ",\"cargoStoreCsgcObjectCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.cargoStoreCsgcObjectCid))
    csgCompilerCargoAppend(out, ",\"cargoStoreHeadCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.cargoStoreHeadCid))
    csgCompilerCargoAppend(out, ",\"cargoStoreIdentityCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.cargoStoreIdentityCid))
    csgCompilerCargoAppend(out, ",\"cargoStoreManifestCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.cargoStoreManifestCid))
    csgCompilerCargoAppend(out, ",\"cargoStoreReceiptCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.cargoStoreReceiptCid))
    csgCompilerCargoAppend(out, ",\"cargoTypeRootCid\":")
    csgCompilerCargoAppendCid(out, binding.proofRoots.typeRootCid)
    csgCompilerCargoAppend(out, ",\"envelopeSourceId\":")
    csgCompilerCargoAppend(
        out,
        canonical.CsgCoreJsonQuote(
            CsgCompilerSnapshotEnvelopeSourceId(binding)))
    csgCompilerCargoAppend(out, ",\"executionCid\":")
    csgCompilerCargoAppendCid(out, binding.executionCid)
    csgCompilerCargoAppend(out, ",\"identityCid\":")
    csgCompilerCargoAppend(out, canonical.CsgCoreJsonQuote(identityCid))
    csgCompilerCargoAppend(out, ",\"originCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.originCid))
    csgCompilerCargoAppend(out, ",\"originKind\":")
    csgCompilerCargoAppend(out, strings.IntToStr(binding.originKind))
    csgCompilerCargoAppend(out, ",\"previousEnvelopeHeadCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.previousEnvelopeHeadCid))
    csgCompilerCargoAppend(out, ",\"previousEnvelopeReceiptCid\":")
    csgCompilerCargoAppend(
        out, canonical.CsgCoreJsonQuote(binding.previousEnvelopeReceiptCid))
    csgCompilerCargoAppend(out, ",\"semanticEpoch\":")
    csgCompilerCargoAppend(out, strings.Int64ToStr(binding.semanticEpoch))
    csgCompilerCargoAppend(out, ",\"snapshotPredecessorReceiptCid\":")
    csgCompilerCargoAppendCid(out, binding.snapshotPredecessorReceiptCid)
    csgCompilerCargoAppend(out, ",\"snapshotSchemaVersion\":")
    csgCompilerCargoAppend(
        out, strings.IntToStr(binding.snapshotSchemaVersion))
    csgCompilerCargoAppend(out, ",\"sourceBundleCid\":")
    csgCompilerCargoAppendCid(out, binding.sourceBundleCid)
    csgCompilerCargoAppend(out, ",\"sourceIdentityReceiptCid\":")
    csgCompilerCargoAppendCid(out, binding.sourceIdentityReceiptCid)
    csgCompilerCargoAppend(
        out,
        ",\"subject\":\"csg_core::compiler_snapshot_head\"")
    csgCompilerCargoAppend(out, ",\"worldHeadCid\":")
    csgCompilerCargoAppendCid(out, binding.worldHeadCid)
    csgCompilerCargoAppend(out, "}}")
    return csgCompilerCargoFinishLine(out)

@borrows
fn CsgCompilerSnapshotEnvelopeIdentityBuild(
        binding: CsgCompilerSnapshotEnvelopeBinding):
        CsgCompilerSnapshotEnvelopeIdentity =
    var failed: CsgCompilerSnapshotEnvelopeIdentity
    let identityCid = CsgCompilerSnapshotEnvelopeBindingCid(binding)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(identityCid):
        failed.error = "csg_compiler_snapshot_envelope_binding_invalid"
        return failed
    let line = csgCompilerSnapshotEnvelopeLine(binding, identityCid)
    let checked = canonical.CsgCoreJsonCanonicalize(line)
    if !checked.ok || checked.value != line:
        failed.error = "csg_compiler_snapshot_envelope_noncanonical"
        return failed
    let lines = [CsgCompilerSnapshotEnvelopeSchemaLine(), line]
    let admitted = csgCompilerCargoProductionAdmit(
        lines, " csg compiler snapshot envelope")
    if !admitted.ok || admitted.factCount != 2:
        failed.error = admitted.error.len > 0 ?
            strings.CloneStr(admitted.error) :
            "csg_compiler_snapshot_envelope_admission_failed"
        return failed
    var sourcePayload = layout.ByteBufInit(lines[1].len + 256)
    csgCompilerCargoAppendU32(sourcePayload, lines.len)
    for index in 0..<lines.len:
        csgCompilerCargoAppendU32(sourcePayload, lines[index].len)
        csgCompilerCargoAppend(sourcePayload, lines[index])
    var sourceBytes = layout.ByteBufToBytes(sourcePayload)
    let sourceCid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        "csg_core.compiler_snapshot.envelope_source", sourceBytes)
    rawbytes.BytesFree(sourceBytes)
    layout.ByteBufFree(sourcePayload)
    var out: CsgCompilerSnapshotEnvelopeIdentity
    out.ok = true
    out.sourceId = CsgCompilerSnapshotEnvelopeSourceId(binding)
    out.sourceCid = sourceCid
    out.identityCid = identityCid
    out.canonicalLines = lines
    return out

fn CsgCompilerSnapshotEnvelopeBindingRelease(
        binding: var CsgCompilerSnapshotEnvelopeBinding) =
    seqs.freeSeqStrRelease(binding.profiles)
    binding = CsgCompilerSnapshotEnvelopeBinding()

fn CsgCompilerSnapshotEnvelopeIdentityRelease(
        identity: var CsgCompilerSnapshotEnvelopeIdentity) =
    seqs.freeSeqStrRelease(identity.canonicalLines)
    identity = CsgCompilerSnapshotEnvelopeIdentity()

fn CsgCompilerSnapshotMerkleTransactionRelease(
        transaction: var CsgCompilerSnapshotMerkleTransaction) =
    transaction = CsgCompilerSnapshotMerkleTransaction()

@borrows
fn csgCompilerSnapshotMerkleIdentityFromCargo(
        cargo: CsgCompilerSnapshotCargo):
        csgCompilerSnapshotMerkleIdentity =
    var failed: csgCompilerSnapshotMerkleIdentity
    if !cargo.ok:
        failed.error = "csg_compiler_snapshot_merkle_cargo_not_ok"
        return failed
    if cargo.canonicalLines.len == 0 ||
       cargo.csgcByteCount <= 0 ||
       rawbytes.BytesLen(cargo.csgcBytes) != cargo.csgcByteCount ||
       csgCompilerCargoLinesByteCount(cargo.canonicalLines) !=
           cargo.canonicalJsonlBytes:
        failed.error =
            "csg_compiler_snapshot_merkle_cargo_shape_mismatch"
        return failed
    let expectedFactsRoot = strings.ConcatStr(
        "sha256:", layout.FixedBytes32Hex(cargo.factsRootCid))
    if cargo.factsRoot != expectedFactsRoot:
        failed.error =
            "csg_compiler_snapshot_merkle_facts_root_text_mismatch"
        return failed
    let verified = CsgCompilerSnapshotCargoVerify(
        cargo.csgcBytes, cargo.factsRootCid)
    if !verified.ok:
        failed.error = strings.ConcatStr(
            "csg_compiler_snapshot_merkle_cargo_verify ",
            verified.error)
        return failed
    if !layout.FixedBytes32Equal(
           verified.cargoCid, cargo.cargoCid) ||
       !csgCompilerSnapshotProofRootsEqual(
           verified.proofRoots, cargo.proofRoots) ||
       !csgCompilerSnapshotLinesEqual(
           verified.canonicalLines, cargo.canonicalLines):
        failed.error =
            "csg_compiler_snapshot_merkle_cargo_identity_mismatch"
        return failed
    if verified.standard != cargo.standard ||
       !validator.CsgCoreProfilesEqual(
           verified.profiles, cargo.profiles) ||
       verified.profileSetCid != cargo.profileSetCid ||
       verified.schemaNamespace != cargo.schemaNamespace ||
       verified.schemaCid != cargo.schemaCid ||
       verified.factsRoot != cargo.factsRoot ||
       verified.factsSubgraphCid !=
           cargo.factsSubgraphCid ||
       verified.dagRootCid != cargo.dagRootCid ||
       verified.factCount != cargo.factCount ||
       verified.factCount != verified.canonicalLines.len ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           verified.factsSubgraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           verified.dagRootCid):
        failed.error =
            "csg_compiler_snapshot_merkle_subgraph_identity_mismatch"
        return failed
    var out: csgCompilerSnapshotMerkleIdentity
    out.ok = true
    out.standard = strings.CloneStr(verified.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(
            verified.profiles)
    out.profileSetCid =
        strings.CloneStr(verified.profileSetCid)
    out.schemaNamespace =
        strings.CloneStr(verified.schemaNamespace)
    out.schemaCid = strings.CloneStr(verified.schemaCid)
    out.factsRoot = strings.CloneStr(verified.factsRoot)
    out.factsSubgraphCid =
        strings.CloneStr(verified.factsSubgraphCid)
    out.dagRootCid = strings.CloneStr(verified.dagRootCid)
    out.sourceId = CsgCompilerSnapshotCargoMerkleSourceId()
    for i in 0..<verified.canonicalLines.len:
        add(
            out.canonicalLines,
            strings.CloneStr(verified.canonicalLines[i]))
    return out

@borrows
fn csgCompilerSnapshotMerkleReplacement(
        identity: csgCompilerSnapshotMerkleIdentity):
        merkle_transaction.CsgCoreMerkleTransactionReplacement =
    var out: merkle_transaction.CsgCoreMerkleTransactionReplacement
    out.sourceId = strings.CloneStr(identity.sourceId)
    out.sourceCid = strings.CloneStr(identity.factsSubgraphCid)
    out.requireDedicatedStore = true
    out.requiredStoreStandard = strings.CloneStr(identity.standard)
    out.requiredStoreProfiles =
        validator.CsgCoreProfilesClone(identity.profiles)
    out.requiredStoreProfileSetCid =
        strings.CloneStr(identity.profileSetCid)
    out.requiredStoreSchemaNamespace =
        strings.CloneStr(identity.schemaNamespace)
    out.requiredStoreSchemaCid = strings.CloneStr(identity.schemaCid)
    for i in 0..<identity.canonicalLines.len:
        add(
            out.facts,
            strings.CloneStr(identity.canonicalLines[i]))
    return out

@borrows
fn csgCompilerSnapshotMerkleBoundPlanRoot(
        factsSubgraphCid: str,
        receiptCid: str,
        transactionPlanRoot: str): str =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           factsSubgraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transactionPlanRoot):
        return ""
    var payload = layout.ByteBufInit(256)
    csgCompilerCargoAppendU32(payload, factsSubgraphCid.len)
    csgCompilerCargoAppend(payload, factsSubgraphCid)
    csgCompilerCargoAppendU32(payload, receiptCid.len)
    csgCompilerCargoAppend(payload, receiptCid)
    csgCompilerCargoAppendU32(payload, transactionPlanRoot.len)
    csgCompilerCargoAppend(payload, transactionPlanRoot)
    var bytes = layout.ByteBufToBytes(payload)
    let out =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.compiler_snapshot.plan_root",
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn csgCompilerSnapshotMerkleFinishApplied(
        identity: csgCompilerSnapshotMerkleIdentity,
        transaction:
            merkle_transaction.CsgCoreMerkleTransactionResult):
        CsgCompilerSnapshotMerkleTransaction =
    if !transaction.ok ||
       !transaction.planReady ||
       !transaction.productionApplied ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.requestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.headCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.receiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.planRoot) ||
       transaction.factCount != identity.canonicalLines.len:
        return csgCompilerSnapshotMerkleFail(
            "csg_compiler_snapshot_merkle_transaction_not_applied")
    let planRoot =
        csgCompilerSnapshotMerkleBoundPlanRoot(
            identity.factsSubgraphCid,
            transaction.receiptCid,
            transaction.planRoot)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(planRoot):
        return csgCompilerSnapshotMerkleFail(
            "csg_compiler_snapshot_merkle_plan_root_invalid")
    var out: CsgCompilerSnapshotMerkleTransaction
    out.ok = true
    out.planReady = true
    out.productionApplied = true
    out.reused = transaction.reused
    out.factsRoot = strings.CloneStr(identity.factsRoot)
    out.factsSubgraphCid =
        strings.CloneStr(identity.factsSubgraphCid)
    out.sourceId = strings.CloneStr(identity.sourceId)
    out.requestCid = strings.CloneStr(transaction.requestCid)
    out.transactionPlanRoot = strings.CloneStr(transaction.planRoot)
    out.planRoot = strings.CloneStr(planRoot)
    out.receiptCid = strings.CloneStr(transaction.receiptCid)
    out.headCid = strings.CloneStr(transaction.headCid)
    out.manifestCid = strings.CloneStr(transaction.manifestCid)
    out.operationCount = transaction.operationKinds.len
    if transaction.operationKinds.len == 1:
        out.operationKind = transaction.operationKinds[0]
    return out

@borrows
fn csgCompilerSnapshotCargoMerkleExecute(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        cargo: CsgCompilerSnapshotCargo,
        apply: bool): CsgCompilerSnapshotMerkleTransaction =
    let identity =
        csgCompilerSnapshotMerkleIdentityFromCargo(cargo)
    if !identity.ok:
        return csgCompilerSnapshotMerkleFail(identity.error)
    let replacement =
        csgCompilerSnapshotMerkleReplacement(identity)
    var planned =
        merkle_transaction.CsgCoreMerkleTransactionPlanStore(
            parentPath,
            storeName,
            expectedHeadCid,
            [strings.CloneStr(identity.sourceId)],
            [replacement])
    if !planned.ok || !planned.planReady:
        let failure = planned.error.len > 0 ?
            strings.CloneStr(planned.error) :
            "csg_compiler_snapshot_merkle_plan_failed"
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return csgCompilerSnapshotMerkleFail(failure)
    if planned.productionApplied:
        let reused = csgCompilerSnapshotMerkleFinishApplied(
            identity,
            planned)
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return reused
    if !apply:
        var out: CsgCompilerSnapshotMerkleTransaction
        out.ok = true
        out.planReady = true
        out.factsRoot = strings.CloneStr(identity.factsRoot)
        out.factsSubgraphCid =
            strings.CloneStr(identity.factsSubgraphCid)
        out.sourceId = strings.CloneStr(identity.sourceId)
        out.requestCid = strings.CloneStr(planned.requestCid)
        out.transactionPlanRoot = strings.CloneStr(planned.planRoot)
        out.headCid = strings.CloneStr(planned.headCid)
        out.manifestCid = strings.CloneStr(planned.manifestCid)
        out.operationCount = planned.operationKinds.len
        if planned.operationKinds.len == 1:
            out.operationKind = planned.operationKinds[0]
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return out
    var applied =
        merkle_transaction.CsgCoreMerkleTransactionApplyPrepared(
            planned)
    if !applied.ok:
        let failure = applied.error.len > 0 ?
            strings.CloneStr(applied.error) :
            "csg_compiler_snapshot_merkle_prepared_apply_failed"
        merkle_transaction.CsgCoreMerkleTransactionFree(applied)
        return csgCompilerSnapshotMerkleFail(failure)
    let out = csgCompilerSnapshotMerkleFinishApplied(
        identity,
        applied)
    merkle_transaction.CsgCoreMerkleTransactionFree(applied)
    return out

@borrows
fn CsgCompilerSnapshotCargoMerklePlan(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        cargo: CsgCompilerSnapshotCargo):
        CsgCompilerSnapshotMerkleTransaction =
    return csgCompilerSnapshotCargoMerkleExecute(
        parentPath, storeName, expectedHeadCid, cargo, false)

@borrows
fn CsgCompilerSnapshotCargoMerkleApply(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        cargo: CsgCompilerSnapshotCargo):
        CsgCompilerSnapshotMerkleTransaction =
    return csgCompilerSnapshotCargoMerkleExecute(
        parentPath, storeName, expectedHeadCid, cargo, true)

@borrows
fn csgCompilerSnapshotEnvelopeMerkleReplacement(
        identity: CsgCompilerSnapshotEnvelopeIdentity):
        merkle_transaction.CsgCoreMerkleTransactionReplacement =
    var out: merkle_transaction.CsgCoreMerkleTransactionReplacement
    let dag =
        validator.CsgCoreMerkleBuildBoundFromCanonicalLines(
            identity.canonicalLines)
    if !identity.ok || !dag.ok || dag.factCount != 2:
        return out
    out.sourceId = strings.CloneStr(identity.sourceId)
    out.sourceCid = strings.CloneStr(identity.sourceCid)
    out.requireDedicatedStore = true
    out.requiredStoreStandard = strings.CloneStr(dag.standard)
    out.requiredStoreProfiles =
        validator.CsgCoreProfilesClone(dag.profiles)
    out.requiredStoreProfileSetCid =
        validator.CsgCoreProfileSetCid(dag.profiles)
    out.requiredStoreSchemaNamespace =
        strings.CloneStr(dag.schemaNamespace)
    out.requiredStoreSchemaCid = strings.CloneStr(dag.schemaCid)
    for index in 0..<identity.canonicalLines.len:
        add(out.facts, strings.CloneStr(identity.canonicalLines[index]))
    return out

@borrows
fn csgCompilerSnapshotEnvelopeFinishApplied(
        identity: CsgCompilerSnapshotEnvelopeIdentity,
        transaction:
            merkle_transaction.CsgCoreMerkleTransactionResult):
        CsgCompilerSnapshotMerkleTransaction =
    if !identity.ok || !transaction.ok || !transaction.planReady ||
       !transaction.productionApplied || transaction.factCount != 2 ||
       (!transaction.reused &&
        (transaction.operationKinds.len != 1 ||
         transaction.operationKinds[0] !=
             merkle_transaction.CsgTransactionReplace)) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.requestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.headCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.receiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           transaction.planRoot):
        return csgCompilerSnapshotMerkleFail(
            "csg_compiler_snapshot_envelope_transaction_not_applied")
    let dag =
        validator.CsgCoreMerkleBuildBoundFromCanonicalLines(
            identity.canonicalLines)
    if !dag.ok || dag.factCount != 2:
        return csgCompilerSnapshotMerkleFail(
            "csg_compiler_snapshot_envelope_dag_invalid")
    var out: CsgCompilerSnapshotMerkleTransaction
    out.ok = true
    out.planReady = true
    out.productionApplied = true
    out.reused = transaction.reused
    out.factsRoot = strings.CloneStr(dag.factsRoot)
    out.factsSubgraphCid = strings.CloneStr(dag.subgraphCid)
    out.sourceId = strings.CloneStr(identity.sourceId)
    out.requestCid = strings.CloneStr(transaction.requestCid)
    out.transactionPlanRoot = strings.CloneStr(transaction.planRoot)
    out.planRoot = strings.CloneStr(transaction.planRoot)
    out.receiptCid = strings.CloneStr(transaction.receiptCid)
    out.headCid = strings.CloneStr(transaction.headCid)
    out.manifestCid = strings.CloneStr(transaction.manifestCid)
    out.operationCount = transaction.operationKinds.len
    if transaction.operationKinds.len == 1:
        out.operationKind = transaction.operationKinds[0]
    return out

@borrows
fn csgCompilerSnapshotEnvelopeMerkleExecute(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        binding: CsgCompilerSnapshotEnvelopeBinding,
        apply: bool): CsgCompilerSnapshotMerkleTransaction =
    let identity = CsgCompilerSnapshotEnvelopeIdentityBuild(binding)
    if !identity.ok:
        return csgCompilerSnapshotMerkleFail(identity.error)
    let replacement =
        csgCompilerSnapshotEnvelopeMerkleReplacement(identity)
    if replacement.facts.len != 2:
        return csgCompilerSnapshotMerkleFail(
            "csg_compiler_snapshot_envelope_replacement_invalid")
    var planned =
        merkle_transaction.CsgCoreMerkleTransactionPlanStore(
            parentPath,
            storeName,
            expectedHeadCid,
            [strings.CloneStr(identity.sourceId)],
            [replacement])
    if !planned.ok || !planned.planReady:
        let failure = planned.error.len > 0 ?
            strings.CloneStr(planned.error) :
            "csg_compiler_snapshot_envelope_plan_failed"
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return csgCompilerSnapshotMerkleFail(failure)
    if planned.productionApplied:
        let reused = csgCompilerSnapshotEnvelopeFinishApplied(
            identity, planned)
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return reused
    if planned.operationKinds.len != 1 ||
       planned.operationKinds[0] !=
           merkle_transaction.CsgTransactionReplace:
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return csgCompilerSnapshotMerkleFail(
            "csg_compiler_snapshot_envelope_single_replace_required")
    if !apply:
        let dag =
            validator.CsgCoreMerkleBuildBoundFromCanonicalLines(
                identity.canonicalLines)
        if !dag.ok || dag.factCount != 2:
            merkle_transaction.CsgCoreMerkleTransactionFree(planned)
            return csgCompilerSnapshotMerkleFail(
                "csg_compiler_snapshot_envelope_dag_invalid")
        var out: CsgCompilerSnapshotMerkleTransaction
        out.ok = true
        out.planReady = true
        out.factsRoot = strings.CloneStr(dag.factsRoot)
        out.factsSubgraphCid = strings.CloneStr(dag.subgraphCid)
        out.sourceId = strings.CloneStr(identity.sourceId)
        out.requestCid = strings.CloneStr(planned.requestCid)
        out.transactionPlanRoot = strings.CloneStr(planned.planRoot)
        out.headCid = strings.CloneStr(planned.headCid)
        out.manifestCid = strings.CloneStr(planned.manifestCid)
        out.operationCount = planned.operationKinds.len
        if planned.operationKinds.len == 1:
            out.operationKind = planned.operationKinds[0]
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return out
    var applied =
        merkle_transaction.CsgCoreMerkleTransactionApplyPrepared(planned)
    if !applied.ok:
        let failure = applied.error.len > 0 ?
            strings.CloneStr(applied.error) :
            "csg_compiler_snapshot_envelope_apply_failed"
        merkle_transaction.CsgCoreMerkleTransactionFree(applied)
        return csgCompilerSnapshotMerkleFail(failure)
    let out = csgCompilerSnapshotEnvelopeFinishApplied(identity, applied)
    merkle_transaction.CsgCoreMerkleTransactionFree(applied)
    return out

@borrows
fn csgCompilerSnapshotEnvelopeMerklePlan(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        binding: CsgCompilerSnapshotEnvelopeBinding):
        CsgCompilerSnapshotMerkleTransaction =
    return csgCompilerSnapshotEnvelopeMerkleExecute(
        parentPath, storeName, expectedHeadCid, binding, false)

@borrows
fn csgCompilerSnapshotEnvelopeMerkleApply(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        binding: CsgCompilerSnapshotEnvelopeBinding):
        CsgCompilerSnapshotMerkleTransaction =
    return csgCompilerSnapshotEnvelopeMerkleExecute(
        parentPath, storeName, expectedHeadCid, binding, true)

fn CsgCompilerSnapshotCargoRelease(cargo: var CsgCompilerSnapshotCargo) =
    rawbytes.BytesFree(cargo.csgcBytes)
    cargo.profiles = []
    cargo.canonicalLines = []
    cargo.csgcByteCount = 0
    cargo.canonicalJsonlBytes = 0
    cargo.ok = false

@borrows
fn csgCompilerFailureCidObserved(value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn csgCompilerFailureTextObserved(value: str): bool =
    if value == "":
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 && value[index] != '\n' && value[index] != '\r' &&
           value[index] != '\t':
            return false
    return true

@borrows
fn csgCompilerFailureCidLess(left: layout.FixedBytes32,
                             right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] != right.data[index]:
            return left.data[index] < right.data[index]
    return false

@borrows
fn csgCompilerDiagnosticFailureArtifactEmpty(
        artifact:
            var diagnostic_failure.DiagnosticFailureArtifact): bool =
    return diagnostic_failure.DiagnosticFailureArtifactReleased(artifact)

fn csgCompilerFailureStructuredAuthorityStrictValidateInto(
        facts: var CsgCompilerSnapshotFailureFacts,
        err: var str): bool =
    if facts.structuredDiagnosticAuthority.authorityKinds.len != 1:
        err = " csg compiler failure cargo: structured diagnostic authority split"
        return false
    let artifactAuthorityRoot =
        facts.structuredDiagnosticArtifact.parserDiagnosticAuthorityRootCid
    let authorityRoot =
        facts.structuredDiagnosticAuthority.authorityRootCid
    if !layout.FixedBytes32Equal(
           artifactAuthorityRoot, authorityRoot):
        err = " csg compiler failure cargo: structured diagnostic authority split"
        return false
    if !diagnostic_authority.ParserDiagnosticAuthorityStrictValidateInto(
           facts.structuredDiagnosticAuthority,
           facts.structuredDiagnosticProducerProjectionCids,
           err):
        return false
    let artifactAnchor =
        facts.structuredDiagnosticArtifact.anchorKinds[0]
    let authorityAnchor =
        facts.structuredDiagnosticAuthority.anchorKinds[0]
    var anchorMatches = false
    if artifactAnchor ==
           diagnostic_failure.DiagnosticFailureAnchorParserNode:
        anchorMatches =
            authorityAnchor ==
                diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNode
    elif artifactAnchor ==
             diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration:
        anchorMatches =
            authorityAnchor ==
                diagnostic_authority.ParserDiagnosticAuthorityAnchorOwnerDeclaration
    elif artifactAnchor ==
             diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration:
        anchorMatches =
            authorityAnchor ==
                diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration
    let authorityLocalSourceRow =
        facts.structuredDiagnosticAuthority.parserLocalProducerSourceRows[0]
    let authorityPortableSourceIndex =
        facts.structuredDiagnosticAuthority.portableProducerSourceIndexes[0]
    let artifactPortableSourceIndex =
        facts.structuredDiagnosticArtifact.producerSourceIndexes[0]
    let authoritySourceByteLength =
        facts.structuredDiagnosticAuthority.producerSourceByteLengths[0]
    let artifactSourceByteLength =
        facts.structuredDiagnosticArtifact.producerSourceByteLengths[0]
    let authorityContentCid =
        facts.structuredDiagnosticAuthority.producerContentCids[0]
    let artifactContentCid =
        facts.structuredDiagnosticArtifact.producerContentCids[0]
    let authorityParserNodeRow =
        facts.structuredDiagnosticAuthority.producerParserNodeRows[0]
    let artifactParserNodeRow =
        facts.structuredDiagnosticArtifact.parserNodeIds[0]
    let authorityOwnerRow =
        facts.structuredDiagnosticAuthority.ownerDeclarationSourceLocalRows[0]
    let artifactOwnerRow =
        facts.structuredDiagnosticArtifact.ownerDeclarationSourceLocalRows[0]
    let authorityStart =
        facts.structuredDiagnosticAuthority.diagnosticSpanStartBytes[0]
    let artifactStart =
        facts.structuredDiagnosticArtifact.spanStartBytes[0]
    let authorityEnd =
        facts.structuredDiagnosticAuthority.diagnosticSpanEndBytes[0]
    let artifactEnd =
        facts.structuredDiagnosticArtifact.spanEndBytes[0]
    let artifactSeverity =
        facts.structuredDiagnosticArtifact.severities[0]
    let authoritySeverity =
        facts.structuredDiagnosticAuthority.severities[0]
    let authorityCode =
        facts.structuredDiagnosticAuthority.codes[0]
    let artifactCode =
        facts.structuredDiagnosticArtifact.codes[0]
    let authorityMessage =
        facts.structuredDiagnosticAuthority.messages[0]
    let artifactMessage =
        facts.structuredDiagnosticArtifact.messages[0]
    if !anchorMatches ||
       authorityLocalSourceRow != 0 ||
       authorityPortableSourceIndex != artifactPortableSourceIndex ||
       authoritySourceByteLength != artifactSourceByteLength ||
       !layout.FixedBytes32Equal(
           authorityContentCid, artifactContentCid) ||
       authorityParserNodeRow != artifactParserNodeRow ||
       authorityOwnerRow != artifactOwnerRow ||
       authorityStart != artifactStart ||
       authorityEnd != artifactEnd ||
       artifactSeverity !=
           diagnostic_failure.DiagnosticFailureSeverityError ||
       authoritySeverity !=
           diagnostic_authority.ParserDiagnosticAuthoritySeverityError ||
       authorityCode != artifactCode ||
       authorityMessage != artifactMessage:
        err = " csg compiler failure cargo: structured diagnostic projection split"
        return false
    err = ""
    return true

@borrows
fn CsgCompilerSnapshotFailureFactsStrictValidateInto(
        facts: var CsgCompilerSnapshotFailureFacts,
        err: var str): bool =
    let sourceCount = facts.sourceDocumentCids.len
    let dependencyCount = facts.dependencySourceIds.len
    let diagnosticCount = facts.diagnosticSourceIds.len
    if facts.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       facts.semanticEpoch <= 0 ||
       facts.semanticEpoch != facts.sourceVersion ||
       facts.sourceVersion <= 0 || facts.completedStageBitmap <= 0 ||
       facts.missingFactBitmap <= 0 || sourceCount <= 0 ||
       sourceCount != facts.sourceContentPresent.len ||
       sourceCount != facts.sourceContentCids.len ||
       sourceCount != facts.sourceModulePaths.len ||
       sourceCount != facts.sourceProducerIndexes.len ||
       !csgCompilerFailureCidObserved(facts.worldHeadCid) ||
       !csgCompilerFailureCidObserved(facts.compilerExecutionCid) ||
       !csgCompilerFailureCidObserved(facts.sourceIdentityReceiptCid) ||
       (facts.sourceIdentityKind !=
            CsgCompilerSnapshotFailureSourceIdentityCanonicalFacts &&
        facts.sourceIdentityKind !=
            CsgCompilerSnapshotFailureSourceIdentityPortableReceipt) ||
       !csgCompilerFailureCidObserved(facts.sourceBundleCid) ||
       ((facts.completedStageBitmap &
            CsgCompilerSnapshotFailureStageParser) != 0 &&
        !csgCompilerFailureCidObserved(facts.parserReceiptCid)) ||
       ((facts.completedStageBitmap &
            CsgCompilerSnapshotFailureStageParser) == 0 &&
        csgCompilerFailureCidObserved(facts.parserReceiptCid)) ||
       ((facts.completedStageBitmap &
            CsgCompilerSnapshotFailureStageCompilerCsg) != 0 &&
        (!csgCompilerFailureCidObserved(
             facts.compilerCsgTransitionReceiptCid) ||
         !csgCompilerFailureCidObserved(facts.importGraphCid) ||
         !csgCompilerFailureCidObserved(facts.canonicalGraphCid) ||
         !csgCompilerFailureCidObserved(facts.graphCid) ||
         !csgCompilerFailureCidObserved(facts.retainedFactsCid))) ||
       ((facts.completedStageBitmap &
            CsgCompilerSnapshotFailureStageCompilerCsg) == 0 &&
        (csgCompilerFailureCidObserved(
             facts.compilerCsgTransitionReceiptCid) ||
         csgCompilerFailureCidObserved(facts.importGraphCid) ||
         csgCompilerFailureCidObserved(facts.canonicalGraphCid) ||
         csgCompilerFailureCidObserved(facts.graphCid) ||
         csgCompilerFailureCidObserved(facts.retainedFactsCid))) ||
       ((facts.completedStageBitmap &
            CsgCompilerSnapshotFailureStageAssessment) != 0 &&
        !csgCompilerFailureCidObserved(facts.admissionReceiptCid)) ||
       ((facts.completedStageBitmap &
            CsgCompilerSnapshotFailureStageAssessment) == 0 &&
        csgCompilerFailureCidObserved(facts.admissionReceiptCid)):
        err = " csg compiler failure cargo: invalid immutable identity"
        return false
    var producerSeen: int32[]
    setLen(producerSeen, sourceCount)
    for sourceId in 0..<sourceCount:
        let producerSourceIndex =
            facts.sourceProducerIndexes[sourceId]
        if !csgCompilerFailureCidObserved(
               facts.sourceDocumentCids[sourceId]) ||
           (facts.sourceContentPresent[sourceId] &&
            !csgCompilerFailureCidObserved(
                facts.sourceContentCids[sourceId])) ||
           (!facts.sourceContentPresent[sourceId] &&
            csgCompilerFailureCidObserved(
                facts.sourceContentCids[sourceId])) ||
           !csgCompilerFailureTextObserved(
               facts.sourceModulePaths[sourceId]) ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= sourceCount ||
           producerSeen[producerSourceIndex] != 0 ||
           (sourceId > 0 &&
            !csgCompilerFailureCidLess(
                facts.sourceDocumentCids[sourceId - 1],
                facts.sourceDocumentCids[sourceId])):
            err = " csg compiler failure cargo: invalid canonical source row"
            return false
        producerSeen[producerSourceIndex] = 1
    if dependencyCount != facts.dependencyTargetSourceIds.len ||
       dependencyCount != facts.dependencyKinds.len ||
       dependencyCount != facts.dependencyProducerRows.len:
        err = " csg compiler failure cargo: dependency columns mismatch"
        return false
    for row in 0..<dependencyCount:
        let sourceId = facts.dependencySourceIds[row]
        let targetSourceId = facts.dependencyTargetSourceIds[row]
        if sourceId < 0 || sourceId >= sourceCount || targetSourceId < 0 ||
           targetSourceId >= sourceCount || sourceId == targetSourceId ||
           facts.dependencyKinds[row] <= 0 ||
           facts.dependencyProducerRows[row] < 0 ||
           (row > 0 &&
            (sourceId < facts.dependencySourceIds[row - 1] ||
             (sourceId == facts.dependencySourceIds[row - 1] &&
              targetSourceId <
                  facts.dependencyTargetSourceIds[row - 1]) ||
             (sourceId == facts.dependencySourceIds[row - 1] &&
              targetSourceId ==
                  facts.dependencyTargetSourceIds[row - 1] &&
              facts.dependencyKinds[row] <
                  facts.dependencyKinds[row - 1]) ||
             (sourceId == facts.dependencySourceIds[row - 1] &&
              targetSourceId ==
                  facts.dependencyTargetSourceIds[row - 1] &&
              facts.dependencyKinds[row] ==
                  facts.dependencyKinds[row - 1] &&
              facts.dependencyProducerRows[row] <=
                  facts.dependencyProducerRows[row - 1]))):
            err = " csg compiler failure cargo: invalid canonical dependency row"
            return false
    if facts.sourceIdentityKind ==
           CsgCompilerSnapshotFailureSourceIdentityCanonicalFacts &&
       (!layout.FixedBytes32Equal(
            facts.sourceBundleCid,
            CsgCompilerSnapshotFailureCanonicalSourceBundleCid(facts)) ||
        !layout.FixedBytes32Equal(
            facts.sourceIdentityReceiptCid,
            CsgCompilerSnapshotFailureCanonicalSourceIdentityReceiptCid(
                facts))):
        err = " csg compiler failure cargo: canonical source identity drift"
        return false
    if diagnosticCount != sourceCount ||
       diagnosticCount != facts.diagnosticStartBytes.len ||
       diagnosticCount != facts.diagnosticEndBytes.len ||
       diagnosticCount != facts.diagnosticStartLines.len ||
       diagnosticCount != facts.diagnosticStartColumns.len ||
       diagnosticCount != facts.diagnosticEndLines.len ||
       diagnosticCount != facts.diagnosticEndColumns.len ||
       diagnosticCount != facts.diagnosticProducerKinds.len ||
       diagnosticCount != facts.diagnosticSeverities.len ||
       diagnosticCount != facts.diagnosticCodes.len ||
       diagnosticCount != facts.diagnosticMessages.len:
        err = " csg compiler failure cargo: diagnostic columns mismatch"
        return false
    for row in 0..<diagnosticCount:
        let sourceId = facts.diagnosticSourceIds[row]
        if sourceId != row || facts.diagnosticStartBytes[row] < 0 ||
           facts.diagnosticEndBytes[row] <
               facts.diagnosticStartBytes[row] ||
           facts.diagnosticStartLines[row] < 0 ||
           facts.diagnosticStartColumns[row] < 0 ||
           facts.diagnosticEndLines[row] <
               facts.diagnosticStartLines[row] ||
           (facts.diagnosticEndLines[row] ==
                facts.diagnosticStartLines[row] &&
            facts.diagnosticEndColumns[row] <
                facts.diagnosticStartColumns[row]) ||
           facts.diagnosticEndColumns[row] < 0 ||
           facts.diagnosticProducerKinds[row] <
               CsgCompilerSnapshotFailureDiagnosticSourceAdmission ||
           facts.diagnosticProducerKinds[row] >
               CsgCompilerSnapshotFailureDiagnosticSemanticAdmission ||
           (row > 0 && facts.diagnosticProducerKinds[row] !=
               facts.diagnosticProducerKinds[0]) ||
           facts.diagnosticSeverities[row] !=
               snapshot_schema.CsgCompilerDiagnosticSeverityError ||
           !csgCompilerFailureTextObserved(
               facts.diagnosticCodes[row]) ||
           !csgCompilerFailureTextObserved(
               facts.diagnosticMessages[row]):
            err = " csg compiler failure cargo: invalid diagnostic row"
            return false
    let failureProducerKind = facts.diagnosticProducerKinds[0]
    if ((failureProducerKind ==
            CsgCompilerSnapshotFailureDiagnosticSourceAdmission ||
         failureProducerKind ==
            CsgCompilerSnapshotFailureDiagnosticSystemLinkPlan) &&
        facts.completedStageBitmap !=
            CsgCompilerSnapshotFailureStageSourceEvent) ||
       (failureProducerKind ==
            CsgCompilerSnapshotFailureDiagnosticCompilerCsg &&
        facts.completedStageBitmap !=
            (CsgCompilerSnapshotFailureStageSourceEvent |
             CsgCompilerSnapshotFailureStageSystemLinkPlan)) ||
       (failureProducerKind ==
            CsgCompilerSnapshotFailureDiagnosticSemanticAdmission &&
        facts.completedStageBitmap !=
            (CsgCompilerSnapshotFailureStageParser |
             CsgCompilerSnapshotFailureStageCompilerCsg |
             CsgCompilerSnapshotFailureStageAssessment)):
        err = " csg compiler failure cargo: diagnostic stage binding split"
        return false
    let structuredRowCount =
        facts.structuredDiagnosticArtifact.producerKinds.len
    if structuredRowCount == 0:
        if !csgCompilerDiagnosticFailureArtifactEmpty(
               facts.structuredDiagnosticArtifact) ||
           !diagnostic_authority.ParserDiagnosticAuthorityReleased(
               facts.structuredDiagnosticAuthority) ||
           facts.structuredDiagnosticProducerProjectionCids.len != 0 ||
           facts.structuredDiagnosticProducerProjectionCids.cap != 0:
            err = " csg compiler failure cargo: partial structured diagnostic"
            return false
    else:
        if structuredRowCount != 1 ||
           facts.structuredDiagnosticArtifact.anchorKinds.len != 1 ||
           facts.sourceIdentityKind !=
               CsgCompilerSnapshotFailureSourceIdentityPortableReceipt ||
           failureProducerKind !=
               CsgCompilerSnapshotFailureDiagnosticCompilerCsg:
            err = " csg compiler failure cargo: structured diagnostic stage split"
            return false
        if !diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
               facts.structuredDiagnosticArtifact, err):
            return false
        let artifactAnchor =
            facts.structuredDiagnosticArtifact.anchorKinds[0]
        let hasStructuralAuthority =
            artifactAnchor ==
                diagnostic_failure.DiagnosticFailureAnchorParserNode ||
            artifactAnchor ==
                diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration ||
            artifactAnchor ==
                diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration
        let artifactAuthorityRoot =
            facts.structuredDiagnosticArtifact.parserDiagnosticAuthorityRootCid
        if hasStructuralAuthority:
            if !csgCompilerFailureStructuredAuthorityStrictValidateInto(
                   facts, err):
                return false
        elif !diagnostic_authority.ParserDiagnosticAuthorityReleased(
                 facts.structuredDiagnosticAuthority) ||
             facts.structuredDiagnosticProducerProjectionCids.len != 0 ||
             facts.structuredDiagnosticProducerProjectionCids.cap != 0 ||
             csgCompilerFailureCidObserved(
                 artifactAuthorityRoot):
            err = " csg compiler failure cargo: source/span diagnostic invented parser authority"
            return false
        var producerDocumentCids: layout.FixedBytes32[]
        var producerContentCids: layout.FixedBytes32[]
        setLen(producerDocumentCids, sourceCount)
        setLen(producerContentCids, sourceCount)
        for sourceId in 0..<sourceCount:
            let producerSourceIndex =
                facts.sourceProducerIndexes[sourceId]
            producerDocumentCids[producerSourceIndex] =
                facts.sourceDocumentCids[sourceId]
            producerContentCids[producerSourceIndex] =
                facts.sourceContentCids[sourceId]
        if !diagnostic_failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               facts.structuredDiagnosticArtifact,
               facts.sourceIdentityReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err):
            return false
        let artifactProducerSourceIndex =
            facts.structuredDiagnosticArtifact.producerSourceIndexes[0]
        var artifactSourceId: int32 = -1
        for sourceId in 0..<sourceCount:
            if facts.sourceProducerIndexes[sourceId] ==
                   artifactProducerSourceIndex:
                artifactSourceId = sourceId
        if artifactSourceId < 0 ||
           !facts.sourceContentPresent[artifactSourceId] ||
           facts.diagnosticStartBytes[artifactSourceId] !=
               facts.structuredDiagnosticArtifact.spanStartBytes[0] ||
           facts.diagnosticEndBytes[artifactSourceId] !=
               facts.structuredDiagnosticArtifact.spanEndBytes[0] ||
           facts.diagnosticSeverities[artifactSourceId] !=
               facts.structuredDiagnosticArtifact.severities[0] ||
           facts.diagnosticCodes[artifactSourceId] !=
               facts.structuredDiagnosticArtifact.codes[0] ||
           facts.diagnosticMessages[artifactSourceId] !=
               facts.structuredDiagnosticArtifact.messages[0]:
            err = " csg compiler failure cargo: structured diagnostic projection split"
            return false
    err = ""
    return true

fn CsgCompilerSnapshotFailureFactsClone(
        facts: var CsgCompilerSnapshotFailureFacts):
        CsgCompilerSnapshotFailureFacts =
    var out: CsgCompilerSnapshotFailureFacts
    out.schemaVersion = facts.schemaVersion
    out.semanticEpoch = facts.semanticEpoch
    out.sourceVersion = facts.sourceVersion
    out.worldHeadCid = facts.worldHeadCid
    out.compilerExecutionCid = facts.compilerExecutionCid
    out.sourceIdentityReceiptCid = facts.sourceIdentityReceiptCid
    out.sourceIdentityKind = facts.sourceIdentityKind
    out.sourceBundleCid = facts.sourceBundleCid
    out.parserReceiptCid = facts.parserReceiptCid
    out.compilerCsgTransitionReceiptCid =
        facts.compilerCsgTransitionReceiptCid
    out.importGraphCid = facts.importGraphCid
    out.canonicalGraphCid = facts.canonicalGraphCid
    out.graphCid = facts.graphCid
    out.retainedFactsCid = facts.retainedFactsCid
    out.admissionReceiptCid = facts.admissionReceiptCid
    out.completedStageBitmap = facts.completedStageBitmap
    out.missingFactBitmap = facts.missingFactBitmap
    for index in 0..<facts.sourceDocumentCids.len:
        add(out.sourceDocumentCids, facts.sourceDocumentCids[index])
        add(out.sourceContentPresent, facts.sourceContentPresent[index])
        add(out.sourceContentCids, facts.sourceContentCids[index])
        add(out.sourceModulePaths, strings.stringsNewStringCopy(
            facts.sourceModulePaths[index].data,
            facts.sourceModulePaths[index].len))
        add(out.sourceProducerIndexes,
            facts.sourceProducerIndexes[index])
    for index in 0..<facts.dependencySourceIds.len:
        add(out.dependencySourceIds, facts.dependencySourceIds[index])
        add(out.dependencyTargetSourceIds,
            facts.dependencyTargetSourceIds[index])
        add(out.dependencyKinds, facts.dependencyKinds[index])
        add(out.dependencyProducerRows,
            facts.dependencyProducerRows[index])
    for index in 0..<facts.diagnosticSourceIds.len:
        add(out.diagnosticSourceIds, facts.diagnosticSourceIds[index])
        add(out.diagnosticStartBytes, facts.diagnosticStartBytes[index])
        add(out.diagnosticEndBytes, facts.diagnosticEndBytes[index])
        add(out.diagnosticStartLines, facts.diagnosticStartLines[index])
        add(out.diagnosticStartColumns,
            facts.diagnosticStartColumns[index])
        add(out.diagnosticEndLines, facts.diagnosticEndLines[index])
        add(out.diagnosticEndColumns, facts.diagnosticEndColumns[index])
        add(out.diagnosticProducerKinds,
            facts.diagnosticProducerKinds[index])
        add(out.diagnosticSeverities, facts.diagnosticSeverities[index])
        add(out.diagnosticCodes, strings.stringsNewStringCopy(
            facts.diagnosticCodes[index].data,
            facts.diagnosticCodes[index].len))
        add(out.diagnosticMessages, strings.stringsNewStringCopy(
            facts.diagnosticMessages[index].data,
            facts.diagnosticMessages[index].len))
    if facts.structuredDiagnosticArtifact.producerKinds.len > 0:
        var cloneErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactCloneInto(
               facts.structuredDiagnosticArtifact,
               out.structuredDiagnosticArtifact,
               cloneErr):
            panic("csg_compiler_failure_structured_diagnostic_clone_invalid")
        if !diagnostic_authority.ParserDiagnosticAuthorityCloneInto(
               facts.structuredDiagnosticAuthority,
               facts.structuredDiagnosticProducerProjectionCids,
               out.structuredDiagnosticAuthority,
               cloneErr):
            panic("csg_compiler_failure_structured_authority_clone_invalid")
        for row in 0..<
                facts.structuredDiagnosticProducerProjectionCids.len:
            add(out.structuredDiagnosticProducerProjectionCids,
                facts.structuredDiagnosticProducerProjectionCids[row])
    return out

fn CsgCompilerSnapshotFailureFactsReleased(
        facts: var CsgCompilerSnapshotFailureFacts): bool =
    return facts.sourceDocumentCids.cap == 0 &&
           facts.sourceContentPresent.cap == 0 &&
           facts.sourceContentCids.cap == 0 &&
           facts.sourceModulePaths.cap == 0 &&
           facts.sourceProducerIndexes.cap == 0 &&
           facts.dependencySourceIds.cap == 0 &&
           facts.dependencyTargetSourceIds.cap == 0 &&
           facts.dependencyKinds.cap == 0 &&
           facts.dependencyProducerRows.cap == 0 &&
           facts.diagnosticSourceIds.cap == 0 &&
           facts.diagnosticStartBytes.cap == 0 &&
           facts.diagnosticEndBytes.cap == 0 &&
           facts.diagnosticStartLines.cap == 0 &&
           facts.diagnosticStartColumns.cap == 0 &&
           facts.diagnosticEndLines.cap == 0 &&
           facts.diagnosticEndColumns.cap == 0 &&
           facts.diagnosticProducerKinds.cap == 0 &&
           facts.diagnosticSeverities.cap == 0 &&
           facts.diagnosticCodes.cap == 0 &&
           facts.diagnosticMessages.cap == 0 &&
           diagnostic_failure.DiagnosticFailureArtifactReleased(
               facts.structuredDiagnosticArtifact) &&
           diagnostic_authority.ParserDiagnosticAuthorityReleased(
               facts.structuredDiagnosticAuthority) &&
           facts.structuredDiagnosticProducerProjectionCids.cap == 0

fn CsgCompilerSnapshotFailureFactsReleaseInto(
        facts: var CsgCompilerSnapshotFailureFacts,
        receipt: var CsgCompilerSnapshotFailureFactsReleaseReceipt) =
    receipt = CsgCompilerSnapshotFailureFactsReleaseReceipt()
    let freeCountBefore = system.memFreeCount()
    let releaseCountBefore = system.memReleaseCount()
    seqs.freeSeq(facts.sourceDocumentCids)
    seqs.freeSeq(facts.sourceContentPresent)
    seqs.freeSeq(facts.sourceContentCids)
    seqs.freeSeqStrRelease(facts.sourceModulePaths)
    seqs.freeSeq(facts.sourceProducerIndexes)
    seqs.freeSeq(facts.dependencySourceIds)
    seqs.freeSeq(facts.dependencyTargetSourceIds)
    seqs.freeSeq(facts.dependencyKinds)
    seqs.freeSeq(facts.dependencyProducerRows)
    seqs.freeSeq(facts.diagnosticSourceIds)
    seqs.freeSeq(facts.diagnosticStartBytes)
    seqs.freeSeq(facts.diagnosticEndBytes)
    seqs.freeSeq(facts.diagnosticStartLines)
    seqs.freeSeq(facts.diagnosticStartColumns)
    seqs.freeSeq(facts.diagnosticEndLines)
    seqs.freeSeq(facts.diagnosticEndColumns)
    seqs.freeSeq(facts.diagnosticProducerKinds)
    seqs.freeSeq(facts.diagnosticSeverities)
    seqs.freeSeqStrRelease(facts.diagnosticCodes)
    seqs.freeSeqStrRelease(facts.diagnosticMessages)
    var diagnosticArtifactRelease: diagnostic_failure.DiagnosticFailureArtifactReleaseReceipt
    diagnostic_failure.DiagnosticFailureArtifactReleaseInto(
        facts.structuredDiagnosticArtifact,
        diagnosticArtifactRelease)
    var diagnosticAuthorityRelease: diagnostic_authority.ParserDiagnosticAuthorityReleaseReceipt
    diagnostic_authority.ParserDiagnosticAuthorityReleaseInto(
        facts.structuredDiagnosticAuthority,
        diagnosticAuthorityRelease)
    seqs.freeSeq(facts.structuredDiagnosticProducerProjectionCids)
    receipt.physicalFreeCount =
        system.memFreeCount() - freeCountBefore
    receipt.orcReleaseCount =
        system.memReleaseCount() - releaseCountBefore
    receipt.storageReleased =
        CsgCompilerSnapshotFailureFactsReleased(facts)
    if !receipt.storageReleased:
        panic("csg compiler failure facts: release incomplete")
    facts = CsgCompilerSnapshotFailureFacts()

fn csgCompilerFailureSchemaLine(): str =
    return "{\"features\":[\"compiler_semantic_snapshot_failure\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"

