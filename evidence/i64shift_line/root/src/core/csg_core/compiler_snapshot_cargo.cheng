@borrows
fn csgCompilerFailureCanonicalLines(
        facts: var CsgCompilerSnapshotFailureFacts): str[] =
    var lines = [csgCompilerFailureSchemaLine(),
                 csgCompilerFailureMetadataLine(facts),
                 csgCompilerFailureSourcesLine(facts),
                 csgCompilerFailureDependenciesLine(facts),
                 csgCompilerFailureDiagnosticsLine(facts)]
    if facts.structuredDiagnosticArtifact.producerKinds.len > 0:
        add(lines, csgCompilerDiagnosticFailureArtifactLine(
            facts.structuredDiagnosticArtifact))
    if facts.structuredDiagnosticAuthority.authorityKinds.len > 0:
        add(lines, csgCompilerParserDiagnosticAuthorityLine(
            facts.structuredDiagnosticAuthority,
            facts.structuredDiagnosticProducerProjectionCids))
    return lines

@borrows
fn csgCompilerFailureLinesStrictValidateInto(
        lines: str[], err: var str): bool =
    if (lines.len != 5 && lines.len != 6 && lines.len != 7) ||
       lines[0] != csgCompilerFailureSchemaLine():
        err = " csg compiler failure cargo: fact table count mismatch"
        return false
    var kinds = ["csg.core.schema",
                 "csg_dialect::cheng_compiler::snapshot_failure",
                 "csg_dialect::cheng_compiler::failure_sources",
                 "csg_dialect::cheng_compiler::failure_dependencies",
                 "csg_dialect::cheng_compiler::failure_diagnostics"]
    if lines.len >= 6:
        add(kinds,
            "csg_dialect::cheng_compiler::diagnostic_failure_artifact")
    if lines.len == 7:
        add(kinds,
            "csg_dialect::cheng_compiler::parser_diagnostic_authority")
    for index in 0..<lines.len:
        let kind = json_field.CsgCoreJsonKind(lines[index])
        let checked = canonical.CsgCoreJsonCanonicalize(lines[index])
        if !kind.found || kind.value != kinds[index] || !checked.ok ||
           checked.value != lines[index]:
            err = " csg compiler failure cargo: non-canonical fact set"
            return false
    let schemaVersion = json_field.CsgCoreJsonTopRawField(
        lines[1], "schemaVersion")
    let semanticEpoch = json_field.CsgCoreJsonTopRawField(
        lines[1], "semanticEpoch")
    let sourceVersion = json_field.CsgCoreJsonTopRawField(
        lines[1], "sourceVersion")
    if !schemaVersion.found ||
       schemaVersion.value != strings.IntToStr(
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest) ||
       !semanticEpoch.found || !sourceVersion.found ||
       semanticEpoch.value != sourceVersion.value ||
       !csgCompilerCargoPositiveDecimal(semanticEpoch.value):
        err = " csg compiler failure cargo: schema/epoch mismatch"
        return false
    err = ""
    return true

@borrows
fn CsgCompilerSnapshotFailureCargoBuild(
        facts: var CsgCompilerSnapshotFailureFacts):
        CsgCompilerSnapshotFailureCargo =
    var err: str
    if !CsgCompilerSnapshotFailureFactsStrictValidateInto(facts, err):
        var failed: CsgCompilerSnapshotFailureCargo
        failed.error = err
        return failed
    let lines = csgCompilerFailureCanonicalLines(facts)
    if !csgCompilerFailureLinesStrictValidateInto(lines, err):
        var failed: CsgCompilerSnapshotFailureCargo
        failed.error = err
        return failed
    let admitted = csgCompilerCargoProductionAdmit(
        lines, " csg compiler failure cargo")
    if !admitted.ok:
        var failed: CsgCompilerSnapshotFailureCargo
        failed.error = admitted.error
        return failed
    var encoded = csgc.CsgCoreCsgcEncodeVerifiedLines(lines)
    if !encoded.ok:
        var failed: CsgCompilerSnapshotFailureCargo
        failed.error = strings.ConcatStr(
            " csg compiler failure cargo: CSGC encode failed ",
            encoded.error)
        return failed
    if encoded.factCount != admitted.factCount:
        var doomed = encoded.bytes
        encoded.bytes = rawbytes.emptyBytes()
        rawbytes.BytesFree(doomed)
        var failed: CsgCompilerSnapshotFailureCargo
        failed.error =
            " csg compiler failure cargo: encoded fact count mismatch"
        return failed
    var diagnosticIndexes: int32[] = [4]
    if lines.len >= 6:
        add(diagnosticIndexes, 5)
    if lines.len == 7:
        add(diagnosticIndexes, 6)
    var out: CsgCompilerSnapshotFailureCargo
    out.ok = true
    out.factsRootCid = admitted.factsRootCid
    out.cargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(encoded.bytes))
    out.diagnosticRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.failure_diagnostics",
        lines, diagnosticIndexes)
    out.canonicalLines = lines
    out.csgcBytes = encoded.bytes
    return out

@borrows
fn CsgCompilerSnapshotFailureCargoVerify(
        bytes: rawbytes.Bytes,
        expectedRoot: layout.FixedBytes32):
        CsgCompilerSnapshotVerifiedFailureCargo =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    var failed: CsgCompilerSnapshotVerifiedFailureCargo
    if !decoded.ok:
        failed.error = strings.ConcatStr(
            " csg compiler failure cargo: CSGC decode failed ",
            decoded.error)
        return failed
    var err: str
    if !csgCompilerFailureLinesStrictValidateInto(decoded.lines, err):
        failed.error = err
        return failed
    let admitted = csgCompilerCargoProductionAdmit(
        decoded.lines, " csg compiler failure cargo")
    if !admitted.ok:
        failed.error = admitted.error
        return failed
    if !layout.FixedBytes32Equal(
           admitted.factsRootCid, expectedRoot):
        failed.error = " csg compiler failure cargo: facts root mismatch"
        return failed
    var diagnosticIndexes: int32[] = [4]
    if decoded.lines.len >= 6:
        add(diagnosticIndexes, 5)
    if decoded.lines.len == 7:
        add(diagnosticIndexes, 6)
    var out: CsgCompilerSnapshotVerifiedFailureCargo
    out.ok = true
    out.factsRootCid = admitted.factsRootCid
    out.cargoCid = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes))
    out.diagnosticRootCid = csgCompilerCargoSectionRoot(
        "cheng.csg.compiler_snapshot.failure_diagnostics",
        decoded.lines, diagnosticIndexes)
    out.canonicalLines = decoded.lines
    return out

fn CsgCompilerSnapshotFailureCargoRelease(
        cargo: var CsgCompilerSnapshotFailureCargo) =
    rawbytes.BytesFree(cargo.csgcBytes)
    cargo.canonicalLines = []
    cargo.ok = false

