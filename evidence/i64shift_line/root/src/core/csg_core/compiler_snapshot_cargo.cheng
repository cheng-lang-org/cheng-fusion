    csgCompilerCargoAppendIntArray(out, snapshot.types.variantPayloadTypeIds)
    csgCompilerCargoAppend(out, ",\"variantStarts\":")
    csgCompilerCargoAppendIntArray(out, snapshot.types.variantStarts)
    csgCompilerCargoAppend(out, "}")
    return csgCompilerCargoFinishLine(out)

