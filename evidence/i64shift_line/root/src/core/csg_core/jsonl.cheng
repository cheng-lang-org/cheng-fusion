import std/strings

@borrows
fn csgJsonlLineEnd(text: str, start: int32, finish: int32, trimCr: bool): int32 =
    if trimCr && finish > start && text[finish - 1] == '\r':
        return finish - 1
    return finish

@borrows
fn csgJsonlAppendLine(out: var str[], text: str, start: int32, finish: int32, trimCr: bool) =
    let lineEnd = csgJsonlLineEnd(text, start, finish, trimCr)
    add(out, strings.CloneStrRange(text, start, lineEnd - start))

@borrows
fn CsgCoreJsonlSplitLines(text: str): str[] =
    var out: str[]
    var start: int32
    for i in 0..<text.len:
        if text[i] == '\n':
            csgJsonlAppendLine(out, text, start, i, true)
            start = i + 1
    if start < text.len:
        csgJsonlAppendLine(out, text, start, text.len, false)
    return out
