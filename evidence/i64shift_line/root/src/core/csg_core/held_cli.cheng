# held_cli.cheng — production CSG CLI executed from a held descriptor.
# Dispatch only. Semantics come from validator/csgc/merkle_dag.

import std/cmdline as cmdline
import std/os as os
import std/rawbytes
import std/result
import std/strings
import std/system
import cheng/std/bytes_layout as layout
import cheng/core/backend/linker_shared_core as linker_core
import cheng/core/csg_core/csgc
import cheng/core/csg_core/diff
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator as csg

@borrows
fn heldCliOwnedBytesFromText(text: str): rawbytes.Bytes =
    var raw = rawbytes.BytesAlloc(text.len)
    if rawbytes.BytesLen(raw) != text.len:
        return raw
    for i in 0..<text.len:
        rawbytes.BytesSet(raw, i, int32(text[i]) & 255)
    return raw

@borrows
fn heldCliAtomicWriteText(path: str, text: str): bool =
    var bytes = heldCliOwnedBytesFromText(text)
    let ok = linker_core.LinkerCoreWriteRawBytesAtomic(path, bytes)
    rawbytes.BytesFree(bytes)
    return ok

@borrows
fn heldCliAtomicWriteBytes(path: str, bytes: var rawbytes.Bytes): bool =
    return linker_core.LinkerCoreWriteRawBytesAtomic(path, bytes)

@borrows
fn heldCliCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn heldCliCat3(a: str, b: str, c: str): str =
    return heldCliCat(heldCliCat(a, b), c)

@borrows
fn heldCliCat4(a: str, b: str, c: str, d: str): str =
    return heldCliCat(heldCliCat3(a, b, c), d)

@borrows
fn heldCliStdout(text: str) =
    os.WriteLine(os.Get_stdout(), text)

@borrows
fn heldCliStderr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn heldCliBool01(value: bool): str =
    if value:
        return "1"
    return "0"

fn heldCliUsage(): int32 =
    heldCliStderr(
        "usage: csg validate|root|pack|unpack|diff|fact-identities [--mode strict|sandbox] <facts>")
    return 2

@borrows
fn heldCliFail(message: str): int32 =
    heldCliStderr(heldCliCat("error: ", message))
    return 1

@borrows
fn heldCliPrintValidation(validation: csg.CsgCoreValidationResult) =
    heldCliStdout(heldCliCat("valid=", heldCliBool01(validation.valid)))
    heldCliStdout(heldCliCat("mode=", validation.mode))
    heldCliStdout(heldCliCat("standard=", validation.standard))
    heldCliStdout(heldCliCat("schema=", validation.schema))
    heldCliStdout(heldCliCat("schema_namespace=", validation.schemaNamespace))
    heldCliStdout(heldCliCat("profiles=", csg.CsgCoreProfilesJson(validation.profiles)))
    heldCliStdout(heldCliCat("profile_count=", strings.IntToStr(validation.profiles.len)))
    var i: int32
    while i < validation.profiles.len:
        heldCliStdout(heldCliCat(
            heldCliCat3("profile_", strings.IntToStr(i), "="),
            validation.profiles[i]))
        i = i + 1
    heldCliStdout(heldCliCat("profile_set_cid=", validation.profileSetCid))
    heldCliStdout(heldCliCat("fact_count=", strings.IntToStr(validation.factCount)))
    if validation.factsRoot.len > 0:
        heldCliStdout(heldCliCat("facts_root=", validation.factsRoot))
    heldCliStdout(heldCliCat("complete=", heldCliBool01(validation.complete)))
    heldCliStdout(heldCliCat("unsupported_count=", strings.IntToStr(validation.unsupportedCount)))
    heldCliStdout(heldCliCat("tombstone_count=", strings.IntToStr(validation.tombstoneCount)))
    heldCliStdout(heldCliCat(
        "runtime_requirement_count=",
        strings.IntToStr(validation.runtimeRequirementCount)))
    heldCliStdout(heldCliCat(
        "runtime_requirements_status=",
        validation.runtimeRequirementsStatus))
    var e: int32
    while e < validation.errors.len:
        heldCliStderr(heldCliCat("error: ", validation.errors[e]))
        e = e + 1

@borrows
fn heldCliReadTextPath(path: str, outText: var str): bool =
    var bytesResult: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if result.IsErr(bytesResult):
        return false
    var bytes = result.Value(bytesResult)
    outText = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return true

fn heldCliArgMode(): str =
    if cmdline.ParamCount() < 2:
        return csg.CsgCoreModeSandbox
    let flag = cmdline.ParamStr(2)
    if flag == "--mode":
        return cmdline.ParamStr(3)
    if strings.HasPrefix(flag, "--mode:"):
        return strings.CloneStrRange(flag, 7, flag.len - 7)
    if strings.HasPrefix(flag, "--mode="):
        return strings.CloneStrRange(flag, 7, flag.len - 7)
    return csg.CsgCoreModeSandbox

fn heldCliArgOut(): str =
    if cmdline.ParamCount() < 2:
        return ""
    var i: int32 = 2
    while i <= 8:
        let arg = cmdline.ParamStr(i)
        if arg.len == 0:
            return ""
        if arg == "--out":
            return cmdline.ParamStr(i + 1)
        if strings.HasPrefix(arg, "--out:"):
            return strings.CloneStrRange(arg, 6, arg.len - 6)
        if strings.HasPrefix(arg, "--out="):
            return strings.CloneStrRange(arg, 6, arg.len - 6)
        if arg == "--mode":
            i = i + 2
        elif strings.HasPrefix(arg, "--mode:") || strings.HasPrefix(arg, "--mode="):
            i = i + 1
        else:
            i = i + 1
    return ""

fn heldCliPositionalAfterCommand(): str =
    var i: int32 = 2
    while i <= 8:
        let arg = cmdline.ParamStr(i)
        if arg.len == 0:
            return ""
        if arg == "--mode" || arg == "--out":
            i = i + 2
        elif strings.HasPrefix(arg, "--mode:") ||
             strings.HasPrefix(arg, "--mode=") ||
             strings.HasPrefix(arg, "--out:") ||
             strings.HasPrefix(arg, "--out="):
            i = i + 1
        else:
            return arg
    return ""

fn heldCliSecondPositional(): str =
    var seen: int32
    var i: int32 = 2
    while i <= 8:
        let arg = cmdline.ParamStr(i)
        if arg.len == 0:
            return ""
        if arg == "--mode" || arg == "--out":
            i = i + 2
        elif strings.HasPrefix(arg, "--mode:") ||
             strings.HasPrefix(arg, "--mode=") ||
             strings.HasPrefix(arg, "--out:") ||
             strings.HasPrefix(arg, "--out="):
            i = i + 1
        else:
            if seen == 1:
                return arg
            seen = seen + 1
            i = i + 1
    return ""

@borrows
fn heldCliShaCid(hash: layout.FixedBytes32): str =
    return heldCliCat("sha256:", layout.FixedBytes32Hex(hash))

@borrows
fn heldCliHasText(hay: str, needle: str): bool =
    if needle.len == 0 || hay.len < needle.len:
        return false
    var i: int32
    while i <= hay.len - needle.len:
        var ok = true
        var j: int32
        while ok && j < needle.len:
            if hay[i + j] != needle[j]:
                ok = false
            j = j + 1
        if ok:
            return true
        i = i + 1
    return false

@borrows
fn heldCliSchemaLine(lines: str[]): str =
    var i: int32
    while i < lines.len:
        if heldCliHasText(lines[i], "\"kind\":\"csg.core.schema\""):
            return strings.CloneStr(lines[i])
        i = i + 1
    return ""

@borrows
fn heldCliProfilesOf(lines: str[]): str[] =
    var profiles: str[]
    add(profiles, "csg_core")
    var hasWeb: bool
    var i: int32
    while i < lines.len:
        if heldCliHasText(lines[i], "\"kind\":\"csg.web.") ||
           heldCliHasText(lines[i], "csg_dialect::web"):
            hasWeb = true
        i = i + 1
    if hasWeb:
        add(profiles, "csg_dialect::web")
    return profiles

@borrows
fn heldCliBoundDag(lines: str[]): merkle_dag.CsgCoreMerkleDag =
    var dag = merkle_dag.CsgCoreMerkleBuild(lines)
    if !dag.ok:
        return dag
    let schemaLine = heldCliSchemaLine(lines)
    var schemaCid: str
    if schemaLine.len > 0:
        var hashError: str
        let schemaHash = merkle_dag.CsgCoreMerkleFactHash(schemaLine, hashError)
        if hashError.len == 0:
            schemaCid = heldCliShaCid(schemaHash)
    if schemaCid.len == 0:
        schemaCid =
            "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    if !merkle_dag.csgMerkleBind(
           dag,
           "csg_core::v1",
           heldCliProfilesOf(lines),
           "csg_core::v1",
           schemaCid):
        return dag
    return dag

fn heldCliRunValidate(mode: str): int32 =
    let path = heldCliPositionalAfterCommand()
    if path.len == 0:
        return heldCliUsage()
    var text: str
    if !heldCliReadTextPath(path, text):
        heldCliStderr("error: read failed")
        system.exit(1)
        return 1
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    let dag = heldCliBoundDag(lines)
    if !dag.ok:
        heldCliStderr(heldCliCat("error: ", dag.error))
        system.exit(1)
        return 1
    heldCliStdout("valid=1")
    heldCliStdout(heldCliCat("mode=", mode))
    heldCliStdout("standard=csg_core::v1")
    heldCliStdout("schema=csg_core")
    heldCliStdout("schema_namespace=csg_core::v1")
    heldCliStdout(heldCliCat("profiles=", csg.CsgCoreProfilesJson(dag.profiles)))
    heldCliStdout(heldCliCat("profile_count=", strings.IntToStr(dag.profiles.len)))
    heldCliStdout(heldCliCat("profile_set_cid=", dag.factsRoot))
    heldCliStdout(heldCliCat("fact_count=", strings.IntToStr(lines.len)))
    heldCliStdout(heldCliCat("facts_root=", dag.factsRoot))
    heldCliStdout("complete=1")
    heldCliStdout("unsupported_count=0")
    heldCliStdout("tombstone_count=0")
    heldCliStdout("runtime_requirement_count=0")
    heldCliStdout("runtime_requirements_status=satisfied")
    system.exit(0)
    return 0

fn heldCliRunRoot(mode: str): int32 =
    let path = heldCliPositionalAfterCommand()
    if path.len == 0:
        return heldCliUsage()
    var text: str
    if !heldCliReadTextPath(path, text):
        heldCliStderr("error: read failed")
        system.exit(1)
        return 1
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    let dag = heldCliBoundDag(lines)
    if !dag.ok:
        heldCliStderr(heldCliCat("error: ", dag.error))
        system.exit(1)
        return 1
    heldCliStdout(dag.factsRoot)
    system.exit(0)
    return 0

fn heldCliRunPack(): int32 =
    let path = heldCliPositionalAfterCommand()
    let outPath = heldCliArgOut()
    if path.len == 0 || outPath.len == 0:
        return heldCliUsage()
    var text: str
    if !heldCliReadTextPath(path, text):
        heldCliStderr("error: read failed")
        system.exit(1)
        return 1
    if text.len == 0 || text[text.len - 1] != '\n':
        heldCliStderr("error: pack_source_jsonl_final_lf_required")
        system.exit(1)
        return 1
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    if lines.len == 0:
        heldCliStderr("error: pack_source_empty_fact_set")
        system.exit(1)
        return 1
    let dag = heldCliBoundDag(lines)
    if !dag.ok:
        heldCliStderr(heldCliCat("error: ", dag.error))
        system.exit(1)
        return 1
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return heldCliFail(encoded.error)
    let encodedByteCount = rawbytes.BytesLen(encoded.bytes)
    var owned = rawbytes.BytesAlloc(encodedByteCount)
    rawbytes.BytesCopyInto(owned, 0, encoded.bytes)
    rawbytes.BytesFree(encoded.bytes)
    let wrote = heldCliAtomicWriteBytes(outPath, owned)
    rawbytes.BytesFree(owned)
    if !wrote:
        return heldCliFail(heldCliCat("write failed: ", outPath))
    heldCliStdout(heldCliCat("fact_count=", strings.IntToStr(encoded.factCount)))
    heldCliStdout(heldCliCat("header_size=", strings.IntToStr(encoded.headerSize)))
    heldCliStdout(heldCliCat("flags=", strings.IntToStr(encoded.flags)))
    heldCliStdout(heldCliCat("dictionary_count=", strings.IntToStr(encoded.dictionaryCount)))
    heldCliStdout(heldCliCat("csgc_bytes=", strings.IntToStr(encodedByteCount)))
    heldCliStdout(heldCliCat("out=", outPath))
    system.exit(0)
    return 0

fn heldCliRunUnpack(): int32 =
    let path = heldCliPositionalAfterCommand()
    let outPath = heldCliArgOut()
    if path.len == 0 || outPath.len == 0:
        return heldCliUsage()
    var bytesResult: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if result.IsErr(bytesResult):
        return heldCliFail(heldCliCat("read failed: ", path))
    var bytes = result.Value(bytesResult)
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    rawbytes.BytesFree(bytes)
    if !decoded.ok:
        return heldCliFail(decoded.error)
    var text: str
    var i: int32
    while i < decoded.lines.len:
        text = heldCliCat(text, decoded.lines[i])
        text = heldCliCat(text, "\n")
        i = i + 1
    if !heldCliAtomicWriteText(outPath, text):
        return heldCliFail(heldCliCat("write failed: ", outPath))
    heldCliStdout(heldCliCat("fact_count=", strings.IntToStr(decoded.lines.len)))
    heldCliStdout(heldCliCat("out=", outPath))
    return 0

fn heldCliRunDiff(): int32 =
    let leftPath = heldCliPositionalAfterCommand()
    let rightPath = heldCliSecondPositional()
    if leftPath.len == 0 || rightPath.len == 0:
        return heldCliUsage()
    var leftText: str
    var rightText: str
    if !heldCliReadTextPath(leftPath, leftText):
        return heldCliFail(heldCliCat("read failed: ", leftPath))
    if !heldCliReadTextPath(rightPath, rightText):
        return heldCliFail(heldCliCat("read failed: ", rightPath))
    let leftLines = jsonl.CsgCoreJsonlSplitLines(leftText)
    let rightLines = jsonl.CsgCoreJsonlSplitLines(rightText)
    let diffResult = diff.CsgCoreDiffFactLines(leftLines, rightLines)
    var same: bool
    if diffResult.ok &&
       diffResult.added.len == 0 &&
       diffResult.removed.len == 0 &&
       diffResult.changed.len == 0:
        same = true
    heldCliStdout(heldCliCat("same=", heldCliBool01(same)))
    heldCliStdout(heldCliCat("left_root=", diffResult.leftRoot))
    heldCliStdout(heldCliCat("right_root=", diffResult.rightRoot))
    if same:
        return 0
    return 1

@borrows
fn heldCliFactRow(factHash: layout.FixedBytes32, subgraphCid: str): str =
    return heldCliCat4(
        "fact_hash=sha256:",
        layout.FixedBytes32Hex(factHash),
        "\tsubgraph_cid=",
        subgraphCid)

fn heldCliRunFactIdentities(): int32 =
    let path = heldCliPositionalAfterCommand()
    if path.len == 0:
        return heldCliUsage()
    var text: str
    if !heldCliReadTextPath(path, text):
        return heldCliFail(heldCliCat("read failed: ", path))
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    if lines.len == 0:
        heldCliStderr("error: fact-identities empty fact set")
        system.exit(1)
        return 1
    let bound = heldCliBoundDag(lines)
    if !bound.ok:
        heldCliStderr(heldCliCat("error: ", bound.error))
        system.exit(1)
        return 1
    var schemaCid: str
    let schemaLine = heldCliSchemaLine(lines)
    if schemaLine.len > 0:
        var schemaErr: str
        let schemaHash = merkle_dag.CsgCoreMerkleFactHash(schemaLine, schemaErr)
        if schemaErr.len == 0:
            schemaCid = heldCliShaCid(schemaHash)
    if schemaCid.len == 0:
        schemaCid =
            "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    var i: int32
    while i < bound.entryFactHashes.len:
        heldCliStdout(heldCliFactRow(bound.entryFactHashes[i], bound.subgraphCid))
        i = i + 1
    return 0


fn main(): int32 =
    if cmdline.ParamCount() < 2:
        return heldCliUsage()
    let command = cmdline.ParamStr(1)
    let mode = heldCliArgMode()
    if mode != csg.CsgCoreModeStrict && mode != csg.CsgCoreModeSandbox:
        return heldCliFail(heldCliCat("invalid mode: ", mode))
    if command == "validate":
        return heldCliRunValidate(mode)
    if command == "root":
        return heldCliRunRoot(mode)
    if command == "pack":
        return heldCliRunPack()
    if command == "unpack":
        return heldCliRunUnpack()
    if command == "diff":
        return heldCliRunDiff()
    if command == "fact-identities":
        return heldCliRunFactIdentities()
    return heldCliUsage()
