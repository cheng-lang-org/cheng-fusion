import std/fs
import std/os
import std/rawbytes
import std/result
import std/strings
import std/system
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/csgc_mapped_reader
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec

const
    CsgCoreCsgcAuthorityDomain: str =
        "csg_core.csgc.lazy_authority"
    CsgCoreCsgcUpstreamTrustAnchorDomain: str =
        "csg_core.csgc.upstream_current_head_anchor"
    CsgCoreCsgcProductionPolicyDomain: str =
        "csg_core.csgc.production_store_policy"
    CsgCoreCsgcAuthoritySchema: str = "csg_core::v1"
    CsgCoreCsgcProductionPolicyEpoch: str =
        "persistent-user-store"
    csgCoreCsgcProductionPolicyDarwin: str = "darwin"
    csgCoreCsgcProductionPolicyLinux: str = "linux"
    csgCoreCsgcProductionPolicyStoreName: str = "csg-core"
    csgCoreCsgcProductionStoreMode: int32 = 448
    csgCoreCsgcProductionStoreModeMask: int32 = 4095

type
    csgCoreCsgcProductionStoreLocation =
        ok: bool
        error: str
        platform: str
        effectiveUid: int64
        parentPath: str
        storeName: str
        storeRoot: str

    csgCoreCsgcProductionStorePolicy =
        admitted: bool
        error: str
        standard: str
        policyEpoch: str
        platform: str
        effectiveUid: int64
        parentPath: str
        storeName: str
        storeRoot: str
        policyCid: str

    csgCoreCsgcUpstreamTrustAnchor =
        admitted: bool
        policyStandard: str
        policyEpoch: str
        policyPlatform: str
        policyEffectiveUid: int64
        policyParentPath: str
        policyStoreName: str
        policyStoreRoot: str
        policyCid: str
        storeRoot: str
        generation: int64
        headCid: str
        manifestCid: str
        factsRoot: str
        factCount: int32
        directoryCid: str
        csgcObjectCid: str
        csgcByteCount: int32
        bindingCid: str
        error: str

    # This type is deliberately module-private. Callers may retain the inferred
    # value returned by VerifyAndSeal, but cannot name or construct one.
    csgCoreCsgcAuthority =
        admitted: bool
        manifestCid: str
        factsRoot: str
        directoryCid: str
        csgcObjectCid: str
        csgcByteCount: int32
        authorityCid: str
        factCount: int32
        trustAnchor: csgCoreCsgcUpstreamTrustAnchor
        error: str

@borrows
fn csgcAuthorityAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgcAuthorityAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgcAuthorityAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

@borrows
fn csgcAuthorityBindingCidUnchecked(
        manifestCid: str,
        factsRoot: str,
        directoryCid: str,
        csgcObjectCid: str,
        csgcByteCount: int32,
        factCount: int32,
        anchorBindingCid: str): str =
    var payload = layout.ByteBufInit(320)
    csgcAuthorityAppendText(payload, CsgCoreCsgcAuthoritySchema)
    csgcAuthorityAppendText(payload, "manifest_cid")
    csgcAuthorityAppendText(payload, manifestCid)
    csgcAuthorityAppendText(payload, "facts_root")
    csgcAuthorityAppendText(payload, factsRoot)
    csgcAuthorityAppendText(payload, "directory_cid")
    csgcAuthorityAppendText(payload, directoryCid)
    csgcAuthorityAppendText(payload, "csgc_object_cid")
    csgcAuthorityAppendText(payload, csgcObjectCid)
    csgcAuthorityAppendText(payload, "csgc_byte_count")
    csgcAuthorityAppendText(
        payload, strings.IntToStr(csgcByteCount))
    csgcAuthorityAppendText(payload, "fact_count")
    csgcAuthorityAppendText(
        payload, strings.IntToStr(factCount))
    csgcAuthorityAppendText(payload, "anchor_binding_cid")
    csgcAuthorityAppendText(payload, anchorBindingCid)
    var bytes = layout.ByteBufToBytes(payload)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreCsgcAuthorityDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn csgcProductionPolicyBindingCidUnchecked(
        policy: csgCoreCsgcProductionStorePolicy): str =
    var payload = layout.ByteBufInit(512)
    csgcAuthorityAppendText(payload, "standard")
    csgcAuthorityAppendText(payload, policy.standard)
    csgcAuthorityAppendText(payload, "policy_epoch")
    csgcAuthorityAppendText(payload, policy.policyEpoch)
    csgcAuthorityAppendText(payload, "platform")
    csgcAuthorityAppendText(payload, policy.platform)
    csgcAuthorityAppendText(payload, "effective_uid")
    csgcAuthorityAppendText(
        payload, strings.Int64ToStr(policy.effectiveUid))
    csgcAuthorityAppendText(payload, "parent_path")
    csgcAuthorityAppendText(payload, policy.parentPath)
    csgcAuthorityAppendText(payload, "store_name")
    csgcAuthorityAppendText(payload, policy.storeName)
    csgcAuthorityAppendText(payload, "store_root")
    csgcAuthorityAppendText(payload, policy.storeRoot)
    var bytes = layout.ByteBufToBytes(payload)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreCsgcProductionPolicyDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn csgcProductionStoreLocationFail(
        message: str): csgCoreCsgcProductionStoreLocation =
    var out: csgCoreCsgcProductionStoreLocation
    out.error = strings.CloneStr(message)
    return out

fn csgcProductionStoreLocation():
        csgCoreCsgcProductionStoreLocation =
    let persistentRoot = os.PersistentUserDataRootIssue()
    if !persistentRoot.ok:
        return csgcProductionStoreLocationFail(
            strings.ConcatStr(
                "csgc_production_policy_persistent_root_failed:",
                persistentRoot.error))
    if persistentRoot.platform !=
           csgCoreCsgcProductionPolicyDarwin &&
       persistentRoot.platform !=
           csgCoreCsgcProductionPolicyLinux:
        return csgcProductionStoreLocationFail(
            "csgc_production_policy_platform_unknown")
    let effectiveUid = os.EffectiveUserId()
    if effectiveUid < int64(0) ||
       persistentRoot.effectiveUid != effectiveUid:
        return csgcProductionStoreLocationFail(
            "csgc_production_policy_effective_uid_mismatch")
    let canonicalParent = fs.Realpath(persistentRoot.rootPath)
    if !canonicalParent.ok:
        return csgcProductionStoreLocationFail(
            strings.ConcatStr(
                "csgc_production_policy_parent_not_canonical:realpath:",
                strings.ConcatStr(
                    canonicalParent.err.msg,
                    strings.ConcatStr(":", persistentRoot.rootPath))))
    if canonicalParent.value != persistentRoot.rootPath:
        return csgcProductionStoreLocationFail(
            strings.ConcatStr(
                "csgc_production_policy_parent_not_canonical:mismatch:",
                strings.ConcatStr(
                    persistentRoot.rootPath,
                    strings.ConcatStr("!=", canonicalParent.value))))
    if !fs.IsDir(persistentRoot.rootPath):
        return csgcProductionStoreLocationFail(
            strings.ConcatStr(
                "csgc_production_policy_parent_not_canonical:not_dir:",
                persistentRoot.rootPath))
    var out: csgCoreCsgcProductionStoreLocation
    out.platform = strings.CloneStr(persistentRoot.platform)
    out.effectiveUid = effectiveUid
    out.parentPath = strings.CloneStr(persistentRoot.rootPath)
    out.storeName = strings.CloneStr(
        csgCoreCsgcProductionPolicyStoreName)
    out.storeRoot = os.JoinPath(out.parentPath, out.storeName)
    if !os.IsAbsolute(out.storeRoot):
        return csgcProductionStoreLocationFail(
            "csgc_production_policy_store_root_not_absolute")
    out.ok = true
    return out

@borrows
fn csgcProductionPolicyValid(
        policy: csgCoreCsgcProductionStorePolicy): bool =
    if !policy.admitted || policy.error.len != 0 ||
       policy.standard != CsgCoreCsgcAuthoritySchema ||
       policy.policyEpoch != CsgCoreCsgcProductionPolicyEpoch ||
       policy.effectiveUid < int64(0) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           policy.policyCid):
        return false
    let location = csgcProductionStoreLocation()
    if !location.ok ||
       policy.platform != location.platform ||
       policy.effectiveUid != location.effectiveUid ||
       policy.parentPath != location.parentPath ||
       policy.storeName != location.storeName ||
       policy.storeRoot != location.storeRoot:
        return false
    return csgcProductionPolicyBindingCidUnchecked(policy) ==
        policy.policyCid

fn CsgCoreCsgcProductionPolicyIssue():
        csgCoreCsgcProductionStorePolicy =
    var out: csgCoreCsgcProductionStorePolicy
    let location = csgcProductionStoreLocation()
    if !location.ok:
        out.error = strings.CloneStr(location.error)
        return out
    out.standard = CsgCoreCsgcAuthoritySchema
    out.policyEpoch = CsgCoreCsgcProductionPolicyEpoch
    out.platform = strings.CloneStr(location.platform)
    out.effectiveUid = location.effectiveUid
    out.parentPath = strings.CloneStr(location.parentPath)
    out.storeName = strings.CloneStr(location.storeName)
    out.storeRoot = strings.CloneStr(location.storeRoot)
    out.policyCid =
        csgcProductionPolicyBindingCidUnchecked(out)
    out.admitted = true
    return out

fn CsgCoreCsgcHistoricalStoreAudit():
        merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult =
    # No caller-supplied path, store name, generation or expected CID enters
    # this authority boundary. The only store identity comes from OS policy.
    let policy = CsgCoreCsgcProductionPolicyIssue()
    if !csgcProductionPolicyValid(policy):
        var failed: merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult
        failed.error = strings.ConcatStr(
            "csgc_historical_production_policy_not_admitted:",
            policy.error)
        failed.verificationScope = "full_history"
        return failed
    let audit =
        merkle_store.CsgCoreMerkleStoreReadHistoricalAuthority(
            policy.parentPath,
            policy.storeName)
    if !audit.ok:
        return audit
    if audit.storeRoot != policy.storeRoot ||
       !csgcProductionStoreRootIdentityValid(
           policy, audit.storeRoot):
        var failed: merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult
        failed.error =
            "csgc_historical_store_identity_invalid"
        failed.verificationScope = "full_history"
        return failed
    return audit

@borrows
fn csgcProductionStoreRootIdentityValid(
        policy: csgCoreCsgcProductionStorePolicy,
        currentStoreRoot: str): bool =
    if currentStoreRoot != policy.storeRoot ||
       !fs.IsDir(currentStoreRoot) ||
       (fs.StatMode(currentStoreRoot) &
            csgCoreCsgcProductionStoreModeMask) !=
           csgCoreCsgcProductionStoreMode:
        return false
    let canonical = fs.Realpath(currentStoreRoot)
    return canonical.ok && canonical.value == policy.storeRoot

@borrows
fn csgcUpstreamTrustAnchorBindingCidUnchecked(
        anchor: csgCoreCsgcUpstreamTrustAnchor): str =
    var payload = layout.ByteBufInit(1024)
    csgcAuthorityAppendText(payload, "policy_standard")
    csgcAuthorityAppendText(payload, anchor.policyStandard)
    csgcAuthorityAppendText(payload, "policy_epoch")
    csgcAuthorityAppendText(payload, anchor.policyEpoch)
    csgcAuthorityAppendText(payload, "policy_platform")
    csgcAuthorityAppendText(payload, anchor.policyPlatform)
    csgcAuthorityAppendText(payload, "policy_effective_uid")
    csgcAuthorityAppendText(
        payload, strings.Int64ToStr(anchor.policyEffectiveUid))
    csgcAuthorityAppendText(payload, "policy_parent_path")
    csgcAuthorityAppendText(payload, anchor.policyParentPath)
    csgcAuthorityAppendText(payload, "policy_store_name")
    csgcAuthorityAppendText(payload, anchor.policyStoreName)
    csgcAuthorityAppendText(payload, "policy_store_root")
    csgcAuthorityAppendText(payload, anchor.policyStoreRoot)
    csgcAuthorityAppendText(payload, "policy_cid")
    csgcAuthorityAppendText(payload, anchor.policyCid)
    csgcAuthorityAppendText(payload, "store_root")
    csgcAuthorityAppendText(payload, anchor.storeRoot)
    csgcAuthorityAppendText(payload, "generation")
    csgcAuthorityAppendText(
        payload, strings.Int64ToStr(anchor.generation))
    csgcAuthorityAppendText(payload, "head_cid")
    csgcAuthorityAppendText(payload, anchor.headCid)
    csgcAuthorityAppendText(payload, "manifest_cid")
    csgcAuthorityAppendText(payload, anchor.manifestCid)
    csgcAuthorityAppendText(payload, "facts_root")
    csgcAuthorityAppendText(payload, anchor.factsRoot)
    csgcAuthorityAppendText(payload, "fact_count")
    csgcAuthorityAppendText(
        payload, strings.IntToStr(anchor.factCount))
    csgcAuthorityAppendText(payload, "directory_cid")
    csgcAuthorityAppendText(payload, anchor.directoryCid)
    csgcAuthorityAppendText(payload, "csgc_object_cid")
    csgcAuthorityAppendText(payload, anchor.csgcObjectCid)
    csgcAuthorityAppendText(payload, "csgc_byte_count")
    csgcAuthorityAppendText(
        payload, strings.IntToStr(anchor.csgcByteCount))
    var bytes = layout.ByteBufToBytes(payload)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreCsgcUpstreamTrustAnchorDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn csgcUpstreamTrustAnchorFail(
        message: str): csgCoreCsgcUpstreamTrustAnchor =
    var out: csgCoreCsgcUpstreamTrustAnchor
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgcProductionPolicyFromAnchor(
        anchor: csgCoreCsgcUpstreamTrustAnchor):
        csgCoreCsgcProductionStorePolicy =
    var policy: csgCoreCsgcProductionStorePolicy
    policy.admitted = true
    policy.standard = strings.CloneStr(anchor.policyStandard)
    policy.policyEpoch = strings.CloneStr(anchor.policyEpoch)
    policy.platform = strings.CloneStr(anchor.policyPlatform)
    policy.effectiveUid = anchor.policyEffectiveUid
    policy.parentPath = strings.CloneStr(anchor.policyParentPath)
    policy.storeName = strings.CloneStr(anchor.policyStoreName)
    policy.storeRoot = strings.CloneStr(anchor.policyStoreRoot)
    policy.policyCid = strings.CloneStr(anchor.policyCid)
    return policy

@borrows
fn csgcUpstreamTrustAnchorValid(
        anchor: csgCoreCsgcUpstreamTrustAnchor): bool =
    if !anchor.admitted || anchor.error.len != 0 ||
       anchor.policyStandard.len == 0 ||
       anchor.policyEpoch.len == 0 ||
       anchor.policyPlatform.len == 0 ||
       anchor.policyEffectiveUid < int64(0) ||
       anchor.policyParentPath.len == 0 ||
       anchor.policyStoreName.len == 0 ||
       anchor.policyStoreRoot.len == 0 ||
       anchor.storeRoot.len == 0 ||
       anchor.storeRoot != anchor.policyStoreRoot ||
       anchor.generation < int64(0) ||
       anchor.factCount <= 0 ||
       anchor.csgcByteCount < csgc.CsgCoreCsgcHeaderSize:
        return false
    let policy = csgcProductionPolicyFromAnchor(anchor)
    if !csgcProductionPolicyValid(policy):
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           anchor.headCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           anchor.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           anchor.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           anchor.directoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           anchor.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           anchor.bindingCid):
        return false
    # bindingCid detects internal field drift. Trust comes only from the full
    # current-HEAD read at the policy-selected store, not from this hash.
    return csgcUpstreamTrustAnchorBindingCidUnchecked(anchor) ==
        anchor.bindingCid

@borrows
fn CsgCoreCsgcUpstreamTrustAnchorReadCurrentHead(
        policy: csgCoreCsgcProductionStorePolicy):
        csgCoreCsgcUpstreamTrustAnchor =
    if !csgcProductionPolicyValid(policy):
        return csgcUpstreamTrustAnchorFail(
            strings.ConcatStr(
                "csgc_upstream_production_policy_not_admitted:",
                policy.error))
    let current =
        merkle_store.CsgCoreMerkleStoreReadHead(
            policy.parentPath,
            policy.storeName)
    if !current.ok:
        return csgcUpstreamTrustAnchorFail(
            strings.ConcatStr(
                "csgc_upstream_current_head_read_failed:",
                current.error))
    if !current.present:
        return csgcUpstreamTrustAnchorFail(
            "csgc_upstream_current_head_missing")
    if !csgcProductionStoreRootIdentityValid(
           policy, current.storeRoot):
        return csgcUpstreamTrustAnchorFail(
            "csgc_upstream_store_identity_invalid")
    # Genesis is never admitted as a production current HEAD: the read must
    # reach a real successor generation (generation > 0 with a bound
    # receipt), not the generation-0 bootstrap head.
    var genesisAdmissionError: str
    if !merkle_store.CsgCoreMerkleStoreHeadRejectGenesisForAdmission(
           current.head, genesisAdmissionError) ||
       current.manifest.factCount <= 0 ||
       current.manifest.csgcByteCount <
           csgc.CsgCoreCsgcHeaderSize ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0:
        return csgcUpstreamTrustAnchorFail(
            "csgc_upstream_current_head_not_admissible")
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           current.head.headCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           current.head.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           current.manifest.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           current.manifest.csgcDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           current.manifest.csgcObjectCid):
        return csgcUpstreamTrustAnchorFail(
            "csgc_upstream_current_head_identity_invalid")
    var out: csgCoreCsgcUpstreamTrustAnchor
    out.policyStandard = strings.CloneStr(policy.standard)
    out.policyEpoch = strings.CloneStr(policy.policyEpoch)
    out.policyPlatform = strings.CloneStr(policy.platform)
    out.policyEffectiveUid = policy.effectiveUid
    out.policyParentPath = strings.CloneStr(policy.parentPath)
    out.policyStoreName = strings.CloneStr(policy.storeName)
    out.policyStoreRoot = strings.CloneStr(policy.storeRoot)
    out.policyCid = strings.CloneStr(policy.policyCid)
    out.storeRoot = strings.CloneStr(current.storeRoot)
    out.generation = current.head.generation
    out.headCid = strings.CloneStr(current.head.headCid)
    out.manifestCid = strings.CloneStr(current.head.manifestCid)
    out.factsRoot = strings.CloneStr(current.manifest.factsRoot)
    out.factCount = current.manifest.factCount
    out.directoryCid =
        strings.CloneStr(current.manifest.csgcDirectoryCid)
    out.csgcObjectCid =
        strings.CloneStr(current.manifest.csgcObjectCid)
    out.csgcByteCount = current.manifest.csgcByteCount
    out.bindingCid =
        csgcUpstreamTrustAnchorBindingCidUnchecked(out)
    out.admitted = true
    return out

@borrows
fn CsgCoreCsgcUpstreamTrustAnchorError(
        anchor: csgCoreCsgcUpstreamTrustAnchor): str =
    return strings.CloneStr(anchor.error)

@borrows
fn csgcUpstreamTrustAnchorCurrentHeadMatches(
        anchor: csgCoreCsgcUpstreamTrustAnchor,
        error: var str): bool =
    let policy = csgcProductionPolicyFromAnchor(anchor)
    if !csgcProductionPolicyValid(policy):
        error = "csgc_authority_production_policy_changed"
        return false
    let current =
        merkle_store.CsgCoreMerkleStoreReadHead(
            policy.parentPath,
            policy.storeName)
    if !current.ok:
        error = strings.ConcatStr(
            "csgc_authority_current_head_read_failed:",
            current.error)
        return false
    if !current.present ||
       current.storeRoot != anchor.storeRoot ||
       !csgcProductionStoreRootIdentityValid(
           policy, current.storeRoot) ||
       current.head.generation != anchor.generation ||
       current.head.headCid != anchor.headCid ||
       current.head.manifestCid != anchor.manifestCid ||
       current.manifest.factsRoot != anchor.factsRoot ||
       current.manifest.factCount != anchor.factCount ||
       current.manifest.csgcDirectoryCid !=
           anchor.directoryCid ||
       current.manifest.csgcObjectCid !=
           anchor.csgcObjectCid ||
       current.manifest.csgcByteCount !=
           anchor.csgcByteCount ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0:
        error = "csgc_authority_current_head_changed"
        return false
    return true

@borrows
fn csgcAuthorityFail(message: str): csgCoreCsgcAuthority =
    var out: csgCoreCsgcAuthority
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgcAuthorityLazyFail(
        message: str): csgc.CsgCoreCsgcLazyLinesResult =
    var out: csgc.CsgCoreCsgcLazyLinesResult
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgcAuthorityLinesFail(
        message: str): csgc.CsgCoreCsgcLinesResult =
    var out: csgc.CsgCoreCsgcLinesResult
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgcAuthorityMappedReaderOpen(
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        trustAnchor: csgCoreCsgcUpstreamTrustAnchor,
        manifest: merkle_manifest.CsgCoreMerkleManifest):
        Result[csgc_mapped_reader.CsgCoreCsgcMappedReader] =
    if !csgcUpstreamTrustAnchorValid(trustAnchor) ||
       manifest.csgcObjectCid != trustAnchor.csgcObjectCid ||
       manifest.csgcByteCount != trustAnchor.csgcByteCount ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.csgcObjectCid):
        return Err[csgc_mapped_reader.CsgCoreCsgcMappedReader](
            "csgc_authority_mapped_reader_identity_invalid")
    let parentPath = os.JoinPath(
        trustAnchor.storeRoot, "csgc_objects")
    let finalName = strings.CloneStrRange(
        manifest.csgcObjectCid, 7, 64)
    return csgc_mapped_reader.CsgCoreCsgcMappedReaderOpenSessionOwned(
        owner,
        parentPath,
        finalName,
        "object.csgc",
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectDomain(),
        manifest.csgcObjectCid)

fn csgcAuthorityMappedReaderClose(
        reader: var csgc_mapped_reader.CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability): str =
    if !csgc_mapped_reader.CsgCoreCsgcMappedReaderIsOpen(reader):
        return ""
    let closed =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
            reader, owner)
    if IsErr(closed):
        return strings.CloneStr(Error(closed))
    return ""

@borrows
fn CsgCoreCsgcAuthorityVerifyAndSeal(
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        trustAnchor: csgCoreCsgcUpstreamTrustAnchor,
        manifestBytes: rawbytes.Bytes): csgCoreCsgcAuthority =
    if !csgcUpstreamTrustAnchorValid(trustAnchor):
        return csgcAuthorityFail(
            strings.ConcatStr(
                "csgc_authority_upstream_not_admitted:",
                trustAnchor.error))
    var initialHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           trustAnchor,
           initialHeadError):
        return csgcAuthorityFail(initialHeadError)
    let decoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            manifestBytes)
    if !decoded.ok:
        return csgcAuthorityFail(
            strings.ConcatStr(
                "csgc_authority_manifest_decode_failed:",
                decoded.error))
    if decoded.cid != trustAnchor.manifestCid:
        return csgcAuthorityFail(
            "csgc_authority_trusted_manifest_cid_mismatch")
    if decoded.manifest.factsRoot != trustAnchor.factsRoot:
        return csgcAuthorityFail(
            "csgc_authority_trusted_facts_root_mismatch")
    if decoded.manifest.factCount != trustAnchor.factCount:
        return csgcAuthorityFail(
            "csgc_authority_trusted_fact_count_mismatch")
    if decoded.manifest.csgcDirectoryCid !=
           trustAnchor.directoryCid:
        return csgcAuthorityFail(
            "csgc_authority_trusted_directory_cid_mismatch")
    if decoded.manifest.csgcObjectCid !=
           trustAnchor.csgcObjectCid ||
       decoded.manifest.csgcByteCount !=
           trustAnchor.csgcByteCount:
        return csgcAuthorityFail(
            "csgc_authority_trusted_object_identity_mismatch")
    let readerResult = csgcAuthorityMappedReaderOpen(
        owner, trustAnchor, decoded.manifest)
    if IsErr(readerResult):
        return csgcAuthorityFail(
            strings.ConcatStr(
                "csgc_authority_reader_open_failed:",
                Error(readerResult)))
    var reader = Value(readerResult)
    let mappedFactCount =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderFactCount(reader)
    if IsErr(mappedFactCount) ||
       Value(mappedFactCount) != decoded.manifest.factCount:
        let closeError = csgcAuthorityMappedReaderClose(reader, owner)
        if closeError.len > 0:
            return csgcAuthorityFail(
                "csgc_authority_fact_count_close_failed")
        return csgcAuthorityFail(
            "csgc_authority_fact_count_mismatch")
    let directoryCidResult =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderDirectoryCid(reader)
    if IsErr(directoryCidResult):
        let closeError = csgcAuthorityMappedReaderClose(reader, owner)
        if closeError.len > 0:
            return csgcAuthorityFail(
                "csgc_authority_directory_close_failed")
        return csgcAuthorityFail(
            strings.ConcatStr(
                "csgc_authority_directory_failed:",
                Error(directoryCidResult)))
    let directoryCid = Value(directoryCidResult)
    if directoryCid != decoded.manifest.csgcDirectoryCid:
        let closeError = csgcAuthorityMappedReaderClose(reader, owner)
        if closeError.len > 0:
            return csgcAuthorityFail(
                "csgc_authority_directory_mismatch_close_failed")
        return csgcAuthorityFail(
            "csgc_authority_manifest_directory_cid_mismatch")
    let closeError = csgcAuthorityMappedReaderClose(reader, owner)
    if closeError.len > 0:
        return csgcAuthorityFail(
            "csgc_authority_reader_close_failed")

    # Re-read immediately before any future admission so a HEAD change during
    # artifact verification cannot authorize a stale snapshot.
    var finalHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           trustAnchor,
           finalHeadError):
        return csgcAuthorityFail(finalHeadError)

    var out: csgCoreCsgcAuthority
    out.manifestCid = strings.CloneStr(decoded.cid)
    out.factsRoot = strings.CloneStr(decoded.manifest.factsRoot)
    out.directoryCid = strings.CloneStr(directoryCid)
    out.csgcObjectCid =
        strings.CloneStr(decoded.manifest.csgcObjectCid)
    out.csgcByteCount = decoded.manifest.csgcByteCount
    out.factCount = decoded.manifest.factCount
    out.trustAnchor = trustAnchor
    out.authorityCid =
        csgcAuthorityBindingCidUnchecked(
            out.manifestCid,
            out.factsRoot,
            out.directoryCid,
            out.csgcObjectCid,
            out.csgcByteCount,
            out.factCount,
            out.trustAnchor.bindingCid)
    out.admitted = true
    return out

@borrows
fn CsgCoreCsgcAuthorityIsValid(
        authority: csgCoreCsgcAuthority): bool =
    if !authority.admitted || authority.error.len != 0 ||
       authority.factCount <= 0 ||
       authority.csgcByteCount < csgc.CsgCoreCsgcHeaderSize ||
       !csgcUpstreamTrustAnchorValid(authority.trustAnchor) ||
       authority.manifestCid != authority.trustAnchor.manifestCid ||
       authority.factsRoot != authority.trustAnchor.factsRoot ||
       authority.directoryCid != authority.trustAnchor.directoryCid ||
       authority.csgcObjectCid !=
           authority.trustAnchor.csgcObjectCid ||
       authority.csgcByteCount !=
           authority.trustAnchor.csgcByteCount ||
       authority.factCount != authority.trustAnchor.factCount:
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           authority.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           authority.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           authority.directoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           authority.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           authority.authorityCid):
        return false
    return csgcAuthorityBindingCidUnchecked(
        authority.manifestCid,
        authority.factsRoot,
        authority.directoryCid,
        authority.csgcObjectCid,
        authority.csgcByteCount,
        authority.factCount,
        authority.trustAnchor.bindingCid) == authority.authorityCid

@borrows
fn csgcAuthorityBindCurrentHeadObjectBytes(
        trustAnchor: csgCoreCsgcUpstreamTrustAnchor,
        bytes: rawbytes.Bytes): csgCoreCsgcAuthority =
    if !csgcUpstreamTrustAnchorValid(trustAnchor):
        return csgcAuthorityFail(
            strings.ConcatStr(
                "csgc_authority_upstream_not_admitted:",
                trustAnchor.error))
    var initialHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           trustAnchor,
           initialHeadError):
        return csgcAuthorityFail(initialHeadError)
    if rawbytes.BytesLen(bytes) != trustAnchor.csgcByteCount:
        return csgcAuthorityFail(
            "csgc_authority_object_byte_count_mismatch")
    let objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(bytes)
    if objectCid != trustAnchor.csgcObjectCid:
        return csgcAuthorityFail(
            "csgc_authority_object_cid_mismatch")
    let directory = csgc.CsgCoreCsgcClaimDirectory(bytes)
    if !directory.ok:
        return csgcAuthorityFail(
            strings.ConcatStr(
                "csgc_authority_directory_claim_failed:",
                directory.error))
    if directory.factCount != trustAnchor.factCount:
        return csgcAuthorityFail(
            "csgc_authority_directory_fact_count_mismatch")
    if directory.directoryCid != trustAnchor.directoryCid:
        return csgcAuthorityFail(
            "csgc_authority_directory_cid_mismatch")

    # Do not mint the module-private capability until both byte identities and
    # the authoritative HEAD still name the same immutable object.
    var finalHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           trustAnchor,
           finalHeadError):
        return csgcAuthorityFail(finalHeadError)
    var out: csgCoreCsgcAuthority
    out.manifestCid = strings.CloneStr(trustAnchor.manifestCid)
    out.factsRoot = strings.CloneStr(trustAnchor.factsRoot)
    out.directoryCid = strings.CloneStr(directory.directoryCid)
    out.csgcObjectCid = strings.CloneStr(objectCid)
    out.csgcByteCount = rawbytes.BytesLen(bytes)
    out.factCount = directory.factCount
    out.trustAnchor = trustAnchor
    out.authorityCid =
        csgcAuthorityBindingCidUnchecked(
            out.manifestCid,
            out.factsRoot,
            out.directoryCid,
            out.csgcObjectCid,
            out.csgcByteCount,
            out.factCount,
            out.trustAnchor.bindingCid)
    out.admitted = true
    return out

@borrows
fn CsgCoreCsgcDecodeCurrentHeadAuthorized(
        trustAnchor: csgCoreCsgcUpstreamTrustAnchor,
        bytes: rawbytes.Bytes): csgc.CsgCoreCsgcLinesResult =
    let authority =
        csgcAuthorityBindCurrentHeadObjectBytes(
            trustAnchor, bytes)
    if !CsgCoreCsgcAuthorityIsValid(authority):
        return csgcAuthorityLinesFail(
            strings.ConcatStr(
                "csgc_authority_full_decode_not_admitted:",
                authority.error))
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return decoded
    if decoded.factCount != authority.factCount:
        return csgcAuthorityLinesFail(
            "csgc_authority_full_decode_fact_count_mismatch")
    var finalHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           authority.trustAnchor,
           finalHeadError):
        return csgcAuthorityLinesFail(finalHeadError)
    return decoded

@borrows
fn CsgCoreCsgcAuthorityError(
        authority: csgCoreCsgcAuthority): str =
    return strings.CloneStr(authority.error)

@borrows
fn CsgCoreCsgcDecodeFactKindAuthorized(
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        kind: str,
        authority: csgCoreCsgcAuthority):
        csgc.CsgCoreCsgcLazyLinesResult =
    if !CsgCoreCsgcAuthorityIsValid(authority):
        return csgcAuthorityLazyFail(
            strings.ConcatStr(
                "csgc_authority_not_admitted:",
                authority.error))
    var initialHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           authority.trustAnchor,
           initialHeadError):
        return csgcAuthorityLazyFail(initialHeadError)
    var manifest: merkle_manifest.CsgCoreMerkleManifest
    manifest.csgcObjectCid =
        strings.CloneStr(authority.csgcObjectCid)
    manifest.csgcByteCount = authority.csgcByteCount
    let readerResult = csgcAuthorityMappedReaderOpen(
        owner, authority.trustAnchor, manifest)
    if IsErr(readerResult):
        return csgcAuthorityLazyFail(
            strings.ConcatStr(
                "csgc_authority_reader_open_failed:",
                Error(readerResult)))
    var reader = Value(readerResult)
    let mappedFactCount =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderFactCount(reader)
    if IsErr(mappedFactCount) ||
       Value(mappedFactCount) != authority.factCount:
        let closeError = csgcAuthorityMappedReaderClose(reader, owner)
        if closeError.len > 0:
            return csgcAuthorityLazyFail(
                "csgc_authority_decode_fact_count_close_failed")
        return csgcAuthorityLazyFail(
            "csgc_authority_decode_fact_count_mismatch")
    let directoryCidResult =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderDirectoryCid(reader)
    if IsErr(directoryCidResult):
        let closeError = csgcAuthorityMappedReaderClose(reader, owner)
        if closeError.len > 0:
            return csgcAuthorityLazyFail(
                "csgc_authority_decode_directory_close_failed")
        return csgcAuthorityLazyFail(
            strings.ConcatStr(
                "csgc_authority_decode_directory_failed:",
                Error(directoryCidResult)))
    if Value(directoryCidResult) != authority.directoryCid:
        let closeError = csgcAuthorityMappedReaderClose(reader, owner)
        if closeError.len > 0:
            return csgcAuthorityLazyFail(
                "csgc_authority_decode_directory_mismatch_close_failed")
        return csgcAuthorityLazyFail(
            "csgc_authority_decode_directory_mismatch")
    let decoded =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderDecodeFactKind(
            reader, kind)
    var decodeReceiptMismatch: bool
    if decoded.ok:
        decodeReceiptMismatch =
            decoded.claimedDirectoryCid != authority.directoryCid ||
            decoded.totalFactCount != authority.factCount
    let decodeCloseError =
        csgcAuthorityMappedReaderClose(reader, owner)
    if decodeCloseError.len > 0:
        return csgcAuthorityLazyFail(
            "csgc_authority_decode_reader_close_failed")
    if !decoded.ok:
        return decoded
    if decodeReceiptMismatch:
        return csgcAuthorityLazyFail(
            "csgc_authority_decode_receipt_mismatch")
    var finalHeadError: str
    if !csgcUpstreamTrustAnchorCurrentHeadMatches(
           authority.trustAnchor,
           finalHeadError):
        return csgcAuthorityLazyFail(finalHeadError)
    return decoded
