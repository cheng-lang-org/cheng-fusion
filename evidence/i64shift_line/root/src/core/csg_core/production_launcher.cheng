    CsgCoreProductionLauncherLinuxPath: str =
        "/usr/libexec/cheng/csg-production-launcher"
    CsgCoreProductionBinaryLinuxPath: str =
        "/usr/libexec/cheng/csg-core-native"
    CsgCoreProductionLauncherStateInstallCandidateVerified: str =
