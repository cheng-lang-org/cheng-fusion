    CsgCoreProductionLauncherReceiptDomain: str =
        "csg_core.production_launcher.execution_receipt"
    CsgCoreProductionLauncherStateDomain: str =
        "csg_core.production_launcher.receipt_state"
    CsgCoreProductionSystemLinkExecAdmissionSchema: str =
        "csg_core::production_system_link_exec_admission::v1"
    CsgCoreProductionSystemLinkExecAdmissionDomain: str =
        "csg_core.production_system_link_exec.admission_receipt"
    CsgCoreProductionLauncherDarwin: str = "darwin-arm64"
    CsgCoreProductionLauncherLinux: str = "linux-x86_64"
    CsgCoreProductionLauncherDarwinPath: str =
