    CsgCoreProductionLauncherLinuxExecMethod: str =
        "execveat_at_empty_path"
    CsgCoreProductionRegularFileMode: int32 = 32768
    CsgCoreProductionFileTypeMask: int32 = 61440
    CsgCoreProductionWriteModeMask: int32 = 146
    CsgCoreProductionExecuteModeMask: int32 = 73
    CsgCoreProductionLauncherRuntimeHardRed: str =
        "HARD_RED:production_launcher_held_exec_event_source_unwired"
    CsgCoreProductionLauncherMilestoneExecutionScope: str =
        "csg_core.production_release_milestones"
    CsgCoreProductionLauncherMilestoneExecutionIssuer: str =
        "single_native_immutable_launcher_held_fd_or_os_receipt"
    CsgCoreProductionLauncherMilestoneExactAllocator: str =
