# The launcher owns the retained descriptor only through the typed
# held_exec_identity provider. Raw OS addresses and FFI surfaces stay inside
# that runtime provider; this production module carries only int32 handles.
import std/cmdline
import std/os
import std/rawbytes
import std/strings
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc_authority
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/runtime/production_system_link_capability as pre_exec_input
import cheng/core/runtime/production_held_exec_provider as held_exec_provider
import cheng/core/runtime/production_held_exec_event_issuer as event_issuer
import cheng/core/runtime/production_held_exec_darwin_capability as darwin_capability
import cheng/core/runtime/production_held_exec_spawn as spawn_bridge
import cheng/core/runtime/held_exec_identity as held_identity
import cheng/core/runtime/production_held_exec_terminal_guardian as terminal_guardian

