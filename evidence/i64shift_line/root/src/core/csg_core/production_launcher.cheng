    CsgCoreProductionLauncherErrLauncherIdentityInvalid: str =
        "production_launcher_e_launcher_identity_invalid"
    CsgCoreProductionLauncherErrBinaryIdentityInvalid: str =
        "production_launcher_e_binary_identity_invalid"
    CsgCoreProductionLauncherErrCoreCidInvalid: str =
        "production_launcher_e_core_cid_invalid"
    CsgCoreProductionLauncherErrRuntimeSessionMissing: str =
        "production_launcher_e_runtime_session_missing"
    CsgCoreProductionLauncherErrRuntimeSessionReplayed: str =
        "production_launcher_e_runtime_session_replayed"
    CsgCoreProductionLauncherErrRuntimeReceiptReplayed: str =
        "production_launcher_e_runtime_receipt_replayed"
    CsgCoreProductionLauncherErrStateTransitionInvalid: str =
        "production_launcher_e_state_transition_invalid"
    CsgCoreProductionLauncherErrEnvironmentPolluted: str =
        "production_launcher_e_environment_polluted"
    CsgCoreProductionLauncherErrDependencyClosureUnsealed: str =
        "production_launcher_e_dynamic_dependency_closure_unsealed"
    CsgCoreProductionLauncherErrManifestBindingInvalid: str =
        "production_launcher_e_manifest_binding_invalid"
    CsgCoreProductionLauncherErrAllocationReceiptMissing: str =
