type
    CsgCoreProductionFileIdentity =
        device: uint64
        inode: uint64
        mode: int32
        linkCount: uint64
        size: int64
        ownerUid: uint64
        ownerGid: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        bytesCid: str

    CsgCoreProductionExecutionObject =
        fixedPath: str
        namedBefore: CsgCoreProductionFileIdentity
        held: CsgCoreProductionFileIdentity
        namedAfter: CsgCoreProductionFileIdentity
        heldDescriptorTokenCid: str
        heldDescriptorIdentityCid: str
        namedPathFenceReceiptCid: str
        expectedBytesCid: str

    CsgCoreProductionLauncherStateStep =
        state: str
        previousStateCid: str
        stateCid: str

    CsgCoreProductionLauncherStateMachine =
        installCandidateVerified: CsgCoreProductionLauncherStateStep
        preExecVerified: CsgCoreProductionLauncherStateStep
        execTransitionObserved: CsgCoreProductionLauncherStateStep
        postExecVerified: CsgCoreProductionLauncherStateStep
        admitted: CsgCoreProductionLauncherStateStep

    CsgCoreProductionLauncherLinuxAuthority =
        fsVerityDigestCid: str
        inodeFlags: uint64
        inodeFlagsReceiptCid: str
        pidfdIdentityCid: str
        execveatReceiptCid: str
        fsVerityProven: bool
        inodeImmutableFlagsProven: bool
        pidfdIdentityProven: bool
        heldDescriptorExecProven: bool
        execveatEmptyPathProven: bool
        staticPieDependencyClosureProven: bool

    CsgCoreProductionLauncherDarwinAuthority =
        designatedRequirementCid: str
        teamIdentifier: str
        signingIdentifier: str
        cdhashCid: str
        auditTokenCid: str
        auditPidVersion: uint64
        dynamicGuestIdentityCid: str
        systemImmutableReceiptCid: str
        designatedRequirementProven: bool
        dynamicGuestProven: bool
        auditTokenProven: bool
        systemImmutableProven: bool
        hardenedRuntime: bool
        libraryValidation: bool
        adHocSignature: bool

    CsgCoreProductionPlatformAuthority =
        platform: str
        execMethod: str
        launcherSelfIdentityReceiptCid: str
        childProcessIdentityCid: str
        actualExecutionIdentityCid: str
        launcherSelfIdentityProven: bool
        actualExecutionIdentityProven: bool
        linux: CsgCoreProductionLauncherLinuxAuthority
        darwin: CsgCoreProductionLauncherDarwinAuthority

    CsgCoreProductionLauncherObservation =
        # This object is a caller claim. Even a structurally perfect instance
        # cannot become runtime authority without an opaque native issuer.
        standard: str
        platform: str
        stateMachine: CsgCoreProductionLauncherStateMachine
        launcher: CsgCoreProductionExecutionObject
        binary: CsgCoreProductionExecutionObject
        authority: CsgCoreProductionPlatformAuthority
        sessionNonceCid: str
        previousAdmittedSessionNonceCid: str
        previousAdmittedReceiptCid: str
        launcherSourceCid: str
        binarySourceCid: str
        compilerAuthorityCid: str
        externalAnchorCid: str
        argvCid: str
        environmentCid: str
        dependencyClosureCid: str
        manifestCid: str
        factsRoot: str
        allocationReceiptCid: str
        allocationReceiptChannelCid: str
        environmentSanitized: bool
        dependencyClosureSealed: bool
        namedPathExecutionForbidden: bool
        heldExecutionRequired: bool
        childWorkloadClosed: bool
        allocationReceiptObservedAfterChildClose: bool
        allocationReceiptAnonymousChannelProven: bool
        claimedRuntimeAuthorityCid: str
        claimedReceiptCid: str

    CsgCoreProductionLauncherAdmission =
        callerObservationTrusted: bool
        structurallyValid: bool
        stateMachineValid: bool
        identityBindingComplete: bool
        platformAuthorityComplete: bool
        runtimeSessionFreshnessProven: bool
        runtimeAuthorityProven: bool
        productionReady: bool
        terminalState: str
        sessionNonceCid: str
        launcherIdentityCid: str
        binaryIdentityCid: str
        childProcessIdentityCid: str
        actualExecutionIdentityCid: str
        manifestCid: str
        factsRoot: str
        allocationReceiptCid: str
        receiptCid: str
        hardRed: str
        error: str

    CsgCoreProductionSystemLinkExecAdmissionReceipt =
        schema: str
        commandCid: str
        inputSetCid: str
        outputContractCid: str
        currentHeadCid: str
        manifestCid: str
        csgcObjectCid: str
        factsRoot: str
        proofCid: str
        csgAuthorityReceiptCid: str
        launcherAdmissionReceiptCid: str
        receiptCid: str
        complete: bool

@borrows
fn CsgCoreProductionLauncherFixedPath(platform: str): str =
    if platform == CsgCoreProductionLauncherDarwin:
        return strings.CloneStr(CsgCoreProductionLauncherDarwinPath)
    if platform == CsgCoreProductionLauncherLinux:
        return strings.CloneStr(CsgCoreProductionLauncherLinuxPath)
    return ""

@borrows
fn CsgCoreProductionBinaryFixedPath(platform: str): str =
    if platform == CsgCoreProductionLauncherDarwin:
        return strings.CloneStr(CsgCoreProductionBinaryDarwinPath)
    if platform == CsgCoreProductionLauncherLinux:
        return strings.CloneStr(CsgCoreProductionBinaryLinuxPath)
    return ""

@borrows
fn productionLauncherAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn productionLauncherAppendText(
        out: var layout.ByteBuf,
        value: str) =
    productionLauncherAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

@borrows
fn productionLauncherAppendBool(
        out: var layout.ByteBuf,
        value: bool) =
    if value:
        productionLauncherAppendText(out, "true")
    else:
        productionLauncherAppendText(out, "false")

@borrows
fn productionLauncherAppendIdentity(
        out: var layout.ByteBuf,
        identity: CsgCoreProductionFileIdentity) =
    productionLauncherAppendText(out, strings.Uint64ToStr(identity.device))
    productionLauncherAppendText(out, strings.Uint64ToStr(identity.inode))
    productionLauncherAppendText(out, strings.IntToStr(identity.mode))
    productionLauncherAppendText(out, strings.Uint64ToStr(identity.linkCount))
    productionLauncherAppendText(out, strings.Int64ToStr(identity.size))
    productionLauncherAppendText(out, strings.Uint64ToStr(identity.ownerUid))
    productionLauncherAppendText(out, strings.Uint64ToStr(identity.ownerGid))
    productionLauncherAppendText(out, strings.Int64ToStr(identity.mtimeSec))
    productionLauncherAppendText(out, strings.Int64ToStr(identity.mtimeNsec))
    productionLauncherAppendText(out, strings.Int64ToStr(identity.ctimeSec))
    productionLauncherAppendText(out, strings.Int64ToStr(identity.ctimeNsec))
    productionLauncherAppendText(out, identity.bytesCid)

@borrows
fn productionLauncherAppendExecutionObject(
        out: var layout.ByteBuf,
        value: CsgCoreProductionExecutionObject) =
    productionLauncherAppendText(out, value.fixedPath)
    productionLauncherAppendIdentity(out, value.namedBefore)
    productionLauncherAppendIdentity(out, value.held)
    productionLauncherAppendIdentity(out, value.namedAfter)
    productionLauncherAppendText(out, value.heldDescriptorTokenCid)
    productionLauncherAppendText(out, value.heldDescriptorIdentityCid)
    productionLauncherAppendText(out, value.namedPathFenceReceiptCid)
    productionLauncherAppendText(out, value.expectedBytesCid)

@borrows
fn productionLauncherAppendAuthority(
        out: var layout.ByteBuf,
        value: CsgCoreProductionPlatformAuthority) =
    productionLauncherAppendText(out, value.platform)
    productionLauncherAppendText(out, value.execMethod)
    productionLauncherAppendText(out, value.launcherSelfIdentityReceiptCid)
    productionLauncherAppendText(out, value.childProcessIdentityCid)
    productionLauncherAppendText(out, value.actualExecutionIdentityCid)
    productionLauncherAppendBool(out, value.launcherSelfIdentityProven)
    productionLauncherAppendBool(out, value.actualExecutionIdentityProven)
    productionLauncherAppendText(out, value.linux.fsVerityDigestCid)
    productionLauncherAppendText(
        out, strings.Uint64ToStr(value.linux.inodeFlags))
    productionLauncherAppendText(out, value.linux.inodeFlagsReceiptCid)
    productionLauncherAppendText(out, value.linux.pidfdIdentityCid)
    productionLauncherAppendText(out, value.linux.execveatReceiptCid)
    productionLauncherAppendBool(out, value.linux.fsVerityProven)
    productionLauncherAppendBool(
        out, value.linux.inodeImmutableFlagsProven)
    productionLauncherAppendBool(out, value.linux.pidfdIdentityProven)
    productionLauncherAppendBool(out, value.linux.heldDescriptorExecProven)
    productionLauncherAppendBool(out, value.linux.execveatEmptyPathProven)
    productionLauncherAppendBool(
        out, value.linux.staticPieDependencyClosureProven)
    productionLauncherAppendText(out, value.darwin.designatedRequirementCid)
    productionLauncherAppendText(out, value.darwin.teamIdentifier)
    productionLauncherAppendText(out, value.darwin.signingIdentifier)
    productionLauncherAppendText(out, value.darwin.cdhashCid)
    productionLauncherAppendText(out, value.darwin.auditTokenCid)
    productionLauncherAppendText(
        out, strings.Uint64ToStr(value.darwin.auditPidVersion))
    productionLauncherAppendText(out, value.darwin.dynamicGuestIdentityCid)
    productionLauncherAppendText(out, value.darwin.systemImmutableReceiptCid)
    productionLauncherAppendBool(
        out, value.darwin.designatedRequirementProven)
    productionLauncherAppendBool(out, value.darwin.dynamicGuestProven)
    productionLauncherAppendBool(out, value.darwin.auditTokenProven)
    productionLauncherAppendBool(out, value.darwin.systemImmutableProven)
    productionLauncherAppendBool(out, value.darwin.hardenedRuntime)
    productionLauncherAppendBool(out, value.darwin.libraryValidation)
    productionLauncherAppendBool(out, value.darwin.adHocSignature)

@borrows
fn productionLauncherAppendObservationBinding(
        out: var layout.ByteBuf,
        observation: CsgCoreProductionLauncherObservation,
        launcherIdentityCid: str,
        binaryIdentityCid: str) =
    productionLauncherAppendText(out, observation.standard)
    productionLauncherAppendText(out, observation.platform)
    productionLauncherAppendExecutionObject(out, observation.launcher)
    productionLauncherAppendText(out, launcherIdentityCid)
    productionLauncherAppendExecutionObject(out, observation.binary)
    productionLauncherAppendText(out, binaryIdentityCid)
    productionLauncherAppendAuthority(out, observation.authority)
    productionLauncherAppendText(out, observation.sessionNonceCid)
    productionLauncherAppendText(
        out, observation.previousAdmittedSessionNonceCid)
    productionLauncherAppendText(out, observation.previousAdmittedReceiptCid)
    productionLauncherAppendText(out, observation.launcherSourceCid)
    productionLauncherAppendText(out, observation.binarySourceCid)
    productionLauncherAppendText(out, observation.compilerAuthorityCid)
    productionLauncherAppendText(out, observation.externalAnchorCid)
    productionLauncherAppendText(out, observation.argvCid)
    productionLauncherAppendText(out, observation.environmentCid)
    productionLauncherAppendText(out, observation.dependencyClosureCid)
    productionLauncherAppendBool(out, observation.environmentSanitized)
    productionLauncherAppendBool(out, observation.dependencyClosureSealed)
    productionLauncherAppendBool(
        out, observation.namedPathExecutionForbidden)
    productionLauncherAppendBool(out, observation.heldExecutionRequired)
    productionLauncherAppendText(
        out, observation.claimedRuntimeAuthorityCid)

@borrows
fn productionLauncherAppendAdmittedBinding(
        out: var layout.ByteBuf,
        observation: CsgCoreProductionLauncherObservation) =
    productionLauncherAppendText(out, "admitted_runtime_binding")
    productionLauncherAppendText(out, observation.manifestCid)
    productionLauncherAppendText(out, observation.factsRoot)
    productionLauncherAppendText(out, observation.allocationReceiptCid)
    productionLauncherAppendText(
        out, observation.allocationReceiptChannelCid)
    productionLauncherAppendText(
        out, observation.authority.actualExecutionIdentityCid)
    productionLauncherAppendBool(out, observation.childWorkloadClosed)
    productionLauncherAppendBool(
        out, observation.allocationReceiptObservedAfterChildClose)
    productionLauncherAppendBool(
        out, observation.allocationReceiptAnonymousChannelProven)

@borrows
fn productionLauncherFileIdentityEqual(
        left: CsgCoreProductionFileIdentity,
        right: CsgCoreProductionFileIdentity): bool =
    return left.device == right.device &&
        left.inode == right.inode &&
        left.mode == right.mode &&
        left.linkCount == right.linkCount &&
        left.size == right.size &&
        left.ownerUid == right.ownerUid &&
        left.ownerGid == right.ownerGid &&
        left.mtimeSec == right.mtimeSec &&
        left.mtimeNsec == right.mtimeNsec &&
        left.ctimeSec == right.ctimeSec &&
        left.ctimeNsec == right.ctimeNsec &&
        left.bytesCid == right.bytesCid

@borrows
fn productionLauncherFileIdentityValid(
        identity: CsgCoreProductionFileIdentity): bool =
    return identity.device != uint64(0) &&
        identity.inode != uint64(0) &&
        (identity.mode & CsgCoreProductionFileTypeMask) ==
            CsgCoreProductionRegularFileMode &&
        (identity.mode & CsgCoreProductionWriteModeMask) == 0 &&
        (identity.mode & CsgCoreProductionExecuteModeMask) != 0 &&
        identity.linkCount == uint64(1) &&
        identity.size > int64(0) &&
        identity.ownerUid == uint64(0) &&
        identity.ownerGid == uint64(0) &&
        identity.mtimeSec >= int64(0) &&
        identity.mtimeNsec >= int64(0) &&
        identity.mtimeNsec < int64(1000000000) &&
        identity.ctimeSec >= int64(0) &&
        identity.ctimeNsec >= int64(0) &&
        identity.ctimeNsec < int64(1000000000) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(identity.bytesCid)

@borrows
fn productionLauncherIdentityCid(
        identity: CsgCoreProductionFileIdentity): str =
    var payload = layout.ByteBufInit(384)
    productionLauncherAppendText(payload, CsgCoreProductionLauncherSchema)
    productionLauncherAppendText(payload, "file_identity")
    productionLauncherAppendIdentity(payload, identity)
    var bytes = layout.ByteBufToBytes(payload)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        "csg_core.production_launcher.file_identity",
        bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn CsgCoreProductionLauncherFileIdentityCid(
        identity: CsgCoreProductionFileIdentity): str =
    if !productionLauncherFileIdentityValid(identity):
        return ""
    return productionLauncherIdentityCid(identity)

@borrows
fn productionLauncherExecutionObjectValid(
        value: CsgCoreProductionExecutionObject,
        expectedPath: str): bool =
    if value.fixedPath != expectedPath ||
       !productionLauncherFileIdentityValid(value.namedBefore) ||
       !productionLauncherFileIdentityValid(value.held) ||
       !productionLauncherFileIdentityValid(value.namedAfter) ||
       !productionLauncherFileIdentityEqual(value.namedBefore, value.held) ||
       !productionLauncherFileIdentityEqual(value.held, value.namedAfter) ||
       value.expectedBytesCid != value.held.bytesCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.expectedBytesCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.heldDescriptorTokenCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.heldDescriptorIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.namedPathFenceReceiptCid):
        return false
    return value.heldDescriptorIdentityCid ==
        productionLauncherIdentityCid(value.held)

@borrows
fn productionLauncherCoreCidsValid(
        observation: CsgCoreProductionLauncherObservation): bool =
    return observation.launcherSourceCid != observation.binarySourceCid &&
        observation.launcher.held.bytesCid != observation.binary.held.bytesCid &&
        (observation.launcher.held.device != observation.binary.held.device ||
         observation.launcher.held.inode != observation.binary.held.inode) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.sessionNonceCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.previousAdmittedSessionNonceCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.previousAdmittedReceiptCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.launcherSourceCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.binarySourceCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.compilerAuthorityCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.externalAnchorCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(observation.argvCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.environmentCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.dependencyClosureCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.claimedRuntimeAuthorityCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            observation.claimedReceiptCid)

@borrows
fn productionLauncherLinuxFieldsEmpty(
        value: CsgCoreProductionLauncherLinuxAuthority): bool =
    return value.fsVerityDigestCid.len == 0 &&
        value.inodeFlags == uint64(0) &&
        value.inodeFlagsReceiptCid.len == 0 &&
        value.pidfdIdentityCid.len == 0 &&
        value.execveatReceiptCid.len == 0 &&
        !value.fsVerityProven &&
        !value.inodeImmutableFlagsProven &&
        !value.pidfdIdentityProven &&
        !value.heldDescriptorExecProven &&
        !value.execveatEmptyPathProven &&
        !value.staticPieDependencyClosureProven

@borrows
fn productionLauncherDarwinFieldsEmpty(
        value: CsgCoreProductionLauncherDarwinAuthority): bool =
    return value.designatedRequirementCid.len == 0 &&
        value.teamIdentifier.len == 0 &&
        value.signingIdentifier.len == 0 &&
        value.cdhashCid.len == 0 &&
        value.auditTokenCid.len == 0 &&
        value.auditPidVersion == uint64(0) &&
        value.dynamicGuestIdentityCid.len == 0 &&
        value.systemImmutableReceiptCid.len == 0 &&
        !value.designatedRequirementProven &&
        !value.dynamicGuestProven &&
        !value.auditTokenProven &&
        !value.systemImmutableProven &&
        !value.hardenedRuntime &&
        !value.libraryValidation &&
        !value.adHocSignature

@borrows
fn productionLauncherStateCidUnchecked(
        observation: CsgCoreProductionLauncherObservation,
        state: str,
        previousStateCid: str,
        launcherIdentityCid: str,
        binaryIdentityCid: str): str =
    var payload = layout.ByteBufInit(4096)
    productionLauncherAppendText(payload, CsgCoreProductionLauncherStateDomain)
    productionLauncherAppendText(payload, state)
    productionLauncherAppendText(payload, previousStateCid)
    productionLauncherAppendObservationBinding(
        payload,
        observation,
        launcherIdentityCid,
        binaryIdentityCid)
    if state == CsgCoreProductionLauncherStateAdmitted:
        productionLauncherAppendAdmittedBinding(payload, observation)
    var bytes = layout.ByteBufToBytes(payload)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionLauncherStateDomain,
        bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn productionLauncherBuildStateStep(
        observation: CsgCoreProductionLauncherObservation,
        state: str,
        previousStateCid: str,
        launcherIdentityCid: str,
        binaryIdentityCid: str): CsgCoreProductionLauncherStateStep =
    var out: CsgCoreProductionLauncherStateStep
    out.state = strings.CloneStr(state)
    out.previousStateCid = strings.CloneStr(previousStateCid)
    out.stateCid = productionLauncherStateCidUnchecked(
        observation,
        state,
        previousStateCid,
        launcherIdentityCid,
        binaryIdentityCid)
    return out

@borrows
fn CsgCoreProductionLauncherBuildClaimedStateMachine(
        observation: CsgCoreProductionLauncherObservation):
        CsgCoreProductionLauncherStateMachine =
    let launcherIdentityCid =
        productionLauncherIdentityCid(observation.launcher.held)
    let binaryIdentityCid =
        productionLauncherIdentityCid(observation.binary.held)
    var out: CsgCoreProductionLauncherStateMachine
    out.installCandidateVerified = productionLauncherBuildStateStep(
        observation,
        CsgCoreProductionLauncherStateInstallCandidateVerified,
        observation.externalAnchorCid,
        launcherIdentityCid,
        binaryIdentityCid)
    out.preExecVerified = productionLauncherBuildStateStep(
        observation,
        CsgCoreProductionLauncherStatePreExecVerified,
        out.installCandidateVerified.stateCid,
        launcherIdentityCid,
        binaryIdentityCid)
    out.execTransitionObserved = productionLauncherBuildStateStep(
        observation,
        CsgCoreProductionLauncherStateExecTransitionObserved,
        out.preExecVerified.stateCid,
        launcherIdentityCid,
        binaryIdentityCid)
    out.postExecVerified = productionLauncherBuildStateStep(
        observation,
        CsgCoreProductionLauncherStatePostExecVerified,
        out.execTransitionObserved.stateCid,
        launcherIdentityCid,
        binaryIdentityCid)
    out.admitted = productionLauncherBuildStateStep(
        observation,
        CsgCoreProductionLauncherStateAdmitted,
        out.postExecVerified.stateCid,
        launcherIdentityCid,
        binaryIdentityCid)
    return out

@borrows
fn productionLauncherStateStepValid(
        observation: CsgCoreProductionLauncherObservation,
        step: CsgCoreProductionLauncherStateStep,
        expectedState: str,
        expectedPreviousStateCid: str,
        launcherIdentityCid: str,
        binaryIdentityCid: str): bool =
    if step.state != expectedState ||
       step.previousStateCid != expectedPreviousStateCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(step.stateCid):
        return false
    return step.stateCid == productionLauncherStateCidUnchecked(
        observation,
        expectedState,
        expectedPreviousStateCid,
        launcherIdentityCid,
        binaryIdentityCid)

@borrows
fn productionLauncherStateMachineValid(
        observation: CsgCoreProductionLauncherObservation,
        launcherIdentityCid: str,
        binaryIdentityCid: str): bool =
    if !productionLauncherStateStepValid(
           observation,
           observation.stateMachine.installCandidateVerified,
           CsgCoreProductionLauncherStateInstallCandidateVerified,
           observation.externalAnchorCid,
           launcherIdentityCid,
           binaryIdentityCid):
        return false
    if !productionLauncherStateStepValid(
           observation,
           observation.stateMachine.preExecVerified,
           CsgCoreProductionLauncherStatePreExecVerified,
           observation.stateMachine.installCandidateVerified.stateCid,
           launcherIdentityCid,
           binaryIdentityCid):
        return false
    if !productionLauncherStateStepValid(
           observation,
           observation.stateMachine.execTransitionObserved,
           CsgCoreProductionLauncherStateExecTransitionObserved,
           observation.stateMachine.preExecVerified.stateCid,
           launcherIdentityCid,
           binaryIdentityCid):
        return false
    if !productionLauncherStateStepValid(
           observation,
           observation.stateMachine.postExecVerified,
           CsgCoreProductionLauncherStatePostExecVerified,
           observation.stateMachine.execTransitionObserved.stateCid,
           launcherIdentityCid,
           binaryIdentityCid):
        return false
    return productionLauncherStateStepValid(
        observation,
        observation.stateMachine.admitted,
        CsgCoreProductionLauncherStateAdmitted,
        observation.stateMachine.postExecVerified.stateCid,
        launcherIdentityCid,
        binaryIdentityCid)

@borrows
fn productionLauncherAppendStateStep(
        out: var layout.ByteBuf,
        step: CsgCoreProductionLauncherStateStep) =
    productionLauncherAppendText(out, step.state)
    productionLauncherAppendText(out, step.previousStateCid)
    productionLauncherAppendText(out, step.stateCid)

@borrows
fn productionLauncherReceiptCidUnchecked(
        observation: CsgCoreProductionLauncherObservation,
        launcherIdentityCid: str,
        binaryIdentityCid: str): str =
    var payload = layout.ByteBufInit(6144)
    productionLauncherAppendText(payload, CsgCoreProductionLauncherReceiptDomain)
    productionLauncherAppendObservationBinding(
        payload,
        observation,
        launcherIdentityCid,
        binaryIdentityCid)
    productionLauncherAppendAdmittedBinding(payload, observation)
    productionLauncherAppendStateStep(
        payload, observation.stateMachine.installCandidateVerified)
    productionLauncherAppendStateStep(
        payload, observation.stateMachine.preExecVerified)
    productionLauncherAppendStateStep(
        payload, observation.stateMachine.execTransitionObserved)
    productionLauncherAppendStateStep(
        payload, observation.stateMachine.postExecVerified)
    productionLauncherAppendStateStep(payload, observation.stateMachine.admitted)
    var bytes = layout.ByteBufToBytes(payload)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionLauncherReceiptDomain,
        bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn CsgCoreProductionLauncherClaimedReceiptCid(
        observation: CsgCoreProductionLauncherObservation): str =
    let launcherIdentityCid =
        productionLauncherIdentityCid(observation.launcher.held)
    let binaryIdentityCid =
        productionLauncherIdentityCid(observation.binary.held)
    return productionLauncherReceiptCidUnchecked(
        observation,
        launcherIdentityCid,
        binaryIdentityCid)

@borrows
fn productionLauncherSelfCertifyingCid(
        observation: CsgCoreProductionLauncherObservation): bool =
    return observation.claimedRuntimeAuthorityCid ==
            observation.claimedReceiptCid ||
        observation.externalAnchorCid == observation.claimedReceiptCid ||
        observation.sessionNonceCid == observation.claimedReceiptCid ||
        observation.compilerAuthorityCid == observation.claimedReceiptCid ||
        observation.manifestCid == observation.claimedReceiptCid ||
        observation.factsRoot == observation.claimedReceiptCid ||
        observation.allocationReceiptCid == observation.claimedReceiptCid ||
        observation.claimedRuntimeAuthorityCid ==
            observation.stateMachine.installCandidateVerified.stateCid ||
        observation.claimedRuntimeAuthorityCid ==
            observation.stateMachine.preExecVerified.stateCid ||
        observation.claimedRuntimeAuthorityCid ==
            observation.stateMachine.execTransitionObserved.stateCid ||
        observation.claimedRuntimeAuthorityCid ==
            observation.stateMachine.postExecVerified.stateCid ||
        observation.claimedRuntimeAuthorityCid ==
            observation.stateMachine.admitted.stateCid

fn productionLauncherFail(
        message: str): CsgCoreProductionLauncherAdmission =
    var out: CsgCoreProductionLauncherAdmission
    out.hardRed = strings.CloneStr(CsgCoreProductionLauncherRuntimeHardRed)
    out.error = strings.CloneStr(message)
    return out

@borrows
fn CsgCoreProductionLauncherAssess(
        observation: CsgCoreProductionLauncherObservation):
        CsgCoreProductionLauncherAdmission =
    if observation.standard != CsgCoreProductionLauncherSchema:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrSchemaMismatch)
    if observation.platform != observation.authority.platform:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrPlatformMismatch)
    let expectedLauncherPath =
        CsgCoreProductionLauncherFixedPath(observation.platform)
    let expectedBinaryPath =
        CsgCoreProductionBinaryFixedPath(observation.platform)
    if expectedLauncherPath.len == 0 || expectedBinaryPath.len == 0:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrPlatformUnsupported)
    if !productionLauncherExecutionObjectValid(
           observation.launcher,
           expectedLauncherPath):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrLauncherIdentityInvalid)
    if !productionLauncherExecutionObjectValid(
           observation.binary,
           expectedBinaryPath):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrBinaryIdentityInvalid)
    if observation.sessionNonceCid.len == 0:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrRuntimeSessionMissing)
    if !productionLauncherCoreCidsValid(observation):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrCoreCidInvalid)
    if observation.sessionNonceCid ==
       observation.previousAdmittedSessionNonceCid:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrRuntimeSessionReplayed)
    if observation.claimedReceiptCid ==
       observation.previousAdmittedReceiptCid:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrRuntimeReceiptReplayed)
    if !observation.environmentSanitized:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrEnvironmentPolluted)
    if !observation.dependencyClosureSealed:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrDependencyClosureUnsealed)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           observation.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           observation.factsRoot) ||
       observation.manifestCid == observation.factsRoot:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrManifestBindingInvalid)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           observation.allocationReceiptCid):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrAllocationReceiptMissing)
    if !observation.childWorkloadClosed ||
       !observation.allocationReceiptObservedAfterChildClose:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrAllocationReceiptBeforeChildClose)
    if !observation.allocationReceiptAnonymousChannelProven ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           observation.allocationReceiptChannelCid):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrAllocationReceiptChannelInvalid)
    if observation.allocationReceiptCid == observation.externalAnchorCid ||
       observation.allocationReceiptCid == observation.manifestCid ||
       observation.allocationReceiptCid == observation.factsRoot ||
       observation.allocationReceiptCid ==
           observation.previousAdmittedReceiptCid ||
       observation.allocationReceiptCid ==
           observation.stateMachine.installCandidateVerified.stateCid ||
       observation.allocationReceiptCid ==
           observation.stateMachine.preExecVerified.stateCid ||
       observation.allocationReceiptCid ==
           observation.stateMachine.execTransitionObserved.stateCid ||
       observation.allocationReceiptCid ==
           observation.stateMachine.postExecVerified.stateCid:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrAllocationReceiptPrefilled)
    if !observation.namedPathExecutionForbidden ||
       !observation.heldExecutionRequired:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrHeldExecutionMissing)
    let launcherIdentityCid =
        productionLauncherIdentityCid(observation.launcher.held)
    let binaryIdentityCid =
        productionLauncherIdentityCid(observation.binary.held)
    if !observation.authority.launcherSelfIdentityProven ||
       observation.authority.launcherSelfIdentityReceiptCid !=
           launcherIdentityCid ||
       !observation.authority.actualExecutionIdentityProven ||
       observation.authority.actualExecutionIdentityCid != binaryIdentityCid:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrActualExecutionIdentityMismatch)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           observation.authority.childProcessIdentityCid):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrActualExecutionIdentityMismatch)
    if observation.platform == CsgCoreProductionLauncherLinux:
        if !productionLauncherDarwinFieldsEmpty(observation.authority.darwin):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrPlatformFieldsInvalid)
        if !observation.authority.linux.fsVerityProven ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.linux.fsVerityDigestCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrLinuxFsVerityDigestMismatch)
        if !observation.authority.linux.inodeImmutableFlagsProven ||
           observation.authority.linux.inodeFlags == uint64(0) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.linux.inodeFlagsReceiptCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrLinuxInodeImmutableMissing)
        if !observation.authority.linux.heldDescriptorExecProven:
            return productionLauncherFail(
                CsgCoreProductionLauncherErrLinuxHeldFdIdentityMismatch)
        if observation.authority.execMethod !=
               CsgCoreProductionLauncherLinuxExecMethod ||
           !observation.authority.linux.execveatEmptyPathProven ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.linux.execveatReceiptCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrLinuxExecveatFailed)
        if !observation.authority.linux.pidfdIdentityProven ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.linux.pidfdIdentityCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrLinuxPidfdIdentityInvalid)
        if !observation.authority.linux.staticPieDependencyClosureProven:
            return productionLauncherFail(
                CsgCoreProductionLauncherErrDependencyClosureUnsealed)
    else:
        if !productionLauncherLinuxFieldsEmpty(observation.authority.linux):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrPlatformFieldsInvalid)
        if observation.authority.darwin.adHocSignature:
            return productionLauncherFail(
                CsgCoreProductionLauncherErrDarwinAdhocSignatureForbidden)
        if !observation.authority.darwin.designatedRequirementProven ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.darwin.designatedRequirementCid) ||
           observation.authority.darwin.teamIdentifier.len == 0 ||
           observation.authority.darwin.signingIdentifier.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.darwin.cdhashCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrDarwinDesignatedRequirementMismatch)
        if !observation.authority.darwin.dynamicGuestProven ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.darwin.dynamicGuestIdentityCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrDarwinDynamicGuestInvalid)
        if !observation.authority.darwin.auditTokenProven ||
           observation.authority.darwin.auditPidVersion == uint64(0) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.darwin.auditTokenCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrDarwinAuditTokenMismatch)
        if observation.authority.execMethod !=
               CsgCoreProductionLauncherDarwinExecMethod ||
           !observation.authority.darwin.hardenedRuntime ||
           !observation.authority.darwin.libraryValidation ||
           !observation.authority.darwin.systemImmutableProven ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               observation.authority.darwin.systemImmutableReceiptCid):
            return productionLauncherFail(
                CsgCoreProductionLauncherErrDarwinHardenedRuntimeMissing)
    if productionLauncherSelfCertifyingCid(observation):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrSelfCertifyingCid)
    if !productionLauncherStateMachineValid(
           observation,
           launcherIdentityCid,
           binaryIdentityCid):
        return productionLauncherFail(
            CsgCoreProductionLauncherErrStateTransitionInvalid)
    let receiptCid = productionLauncherReceiptCidUnchecked(
        observation,
        launcherIdentityCid,
        binaryIdentityCid)
    if observation.claimedReceiptCid != receiptCid:
        return productionLauncherFail(
            CsgCoreProductionLauncherErrReceiptCidMismatch)
    var out: CsgCoreProductionLauncherAdmission
    out.structurallyValid = true
    out.stateMachineValid = true
    out.identityBindingComplete = true
    out.platformAuthorityComplete = true
    out.terminalState = strings.CloneStr(
        CsgCoreProductionLauncherStateAdmitted)
    out.sessionNonceCid = strings.CloneStr(observation.sessionNonceCid)
    out.launcherIdentityCid = launcherIdentityCid
    out.binaryIdentityCid = binaryIdentityCid
    out.childProcessIdentityCid = strings.CloneStr(
        observation.authority.childProcessIdentityCid)
    out.actualExecutionIdentityCid = strings.CloneStr(
        observation.authority.actualExecutionIdentityCid)
    out.manifestCid = strings.CloneStr(observation.manifestCid)
    out.factsRoot = strings.CloneStr(observation.factsRoot)
    out.allocationReceiptCid = strings.CloneStr(
        observation.allocationReceiptCid)
    out.receiptCid = receiptCid
    out.hardRed = strings.CloneStr(
        CsgCoreProductionLauncherRuntimeHardRed)
    out.error = strings.CloneStr(
        CsgCoreProductionLauncherErrHeldExecEventSourceUnwired)
    return out

fn CsgCoreProductionLauncherMissingRuntimePrimitives(): str =
    return "CsgCoreProductionLauncherMainActivateHeldBinaryInto(sessionCapability,retainedBinaryFd,executableObjectCid,heldDescriptorIdentityCid,argvCid,environmentCid,planReceiptCid,proofCid,admissionReceiptCid)"

@borrows
fn productionLauncherSystemLinkExecAdmissionReceiptCidUnchecked(
        receipt: CsgCoreProductionSystemLinkExecAdmissionReceipt): str =
    var payload = layout.ByteBufInit(1024)
    productionLauncherAppendText(
        payload, CsgCoreProductionSystemLinkExecAdmissionDomain)
    productionLauncherAppendText(payload, receipt.schema)
    productionLauncherAppendText(payload, receipt.commandCid)
    productionLauncherAppendText(payload, receipt.inputSetCid)
    productionLauncherAppendText(payload, receipt.outputContractCid)
    productionLauncherAppendText(payload, receipt.currentHeadCid)
    productionLauncherAppendText(payload, receipt.manifestCid)
    productionLauncherAppendText(payload, receipt.csgcObjectCid)
    productionLauncherAppendText(payload, receipt.factsRoot)
    productionLauncherAppendText(payload, receipt.proofCid)
    productionLauncherAppendText(payload, receipt.csgAuthorityReceiptCid)
    productionLauncherAppendText(
        payload, receipt.launcherAdmissionReceiptCid)
    var bytes = layout.ByteBufToBytes(payload)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreProductionSystemLinkExecAdmissionDomain,
        bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn CsgCoreProductionLauncherSystemLinkExecAdmissionStrictValidateInto(
        receipt: CsgCoreProductionSystemLinkExecAdmissionReceipt,
        err: var str): bool =
    if receipt.schema != CsgCoreProductionSystemLinkExecAdmissionSchema ||
       !receipt.complete:
        err = "production launcher: system-link admission incomplete"
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.commandCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.inputSetCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.outputContractCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.currentHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.proofCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.csgAuthorityReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.launcherAdmissionReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           receipt.receiptCid):
        err = "production launcher: system-link admission CID invalid"
        return false
    if receipt.commandCid == receipt.inputSetCid ||
       receipt.commandCid == receipt.outputContractCid ||
       receipt.inputSetCid == receipt.outputContractCid ||
       receipt.currentHeadCid == receipt.manifestCid ||
       receipt.currentHeadCid == receipt.csgcObjectCid ||
       receipt.manifestCid == receipt.csgcObjectCid ||
       receipt.factsRoot == receipt.csgcObjectCid ||
       receipt.csgAuthorityReceiptCid ==
           receipt.launcherAdmissionReceiptCid:
        err = "production launcher: system-link authority identity aliased"
        return false
    let expectedReceiptCid =
        productionLauncherSystemLinkExecAdmissionReceiptCidUnchecked(receipt)
    if receipt.receiptCid != expectedReceiptCid:
        err = "production launcher: system-link admission receipt mismatch"
        return false
    err = ""
    return true

@borrows
fn CsgCoreProductionLauncherRequireSystemLinkExecAuthorityInto(
        providerReceipt:
            held_exec_provider.CsgCoreProductionHeldExecReceipt,
        out: var CsgCoreProductionSystemLinkExecAdmissionReceipt,
        err: var str): bool =
    out = CsgCoreProductionSystemLinkExecAdmissionReceipt()
    if !held_exec_provider.CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
           providerReceipt, err) ||
       providerReceipt.executionScope !=
           held_exec_provider.CsgCoreProductionHeldExecScopeSystemLink:
        if err.len == 0:
            err =
                "production launcher: system-link provider authority rejected"
        return false
    var candidate: CsgCoreProductionSystemLinkExecAdmissionReceipt
    candidate.schema = strings.CloneStr(
        CsgCoreProductionSystemLinkExecAdmissionSchema)
    candidate.commandCid = strings.CloneStr(
        providerReceipt.workload.commandCid)
    candidate.inputSetCid = strings.CloneStr(
        providerReceipt.workload.inputSetCid)
    candidate.outputContractCid = strings.CloneStr(
        providerReceipt.workload.outputContractCid)
    candidate.currentHeadCid = strings.CloneStr(
        providerReceipt.workload.currentHeadCid)
    candidate.manifestCid = strings.CloneStr(
        providerReceipt.workload.manifestCid)
    candidate.csgcObjectCid = strings.CloneStr(
        providerReceipt.workload.csgcObjectCid)
    candidate.factsRoot = strings.CloneStr(
        providerReceipt.workload.factsRoot)
    candidate.proofCid = strings.CloneStr(
        providerReceipt.workload.proofCid)
    candidate.csgAuthorityReceiptCid = strings.CloneStr(
        providerReceipt.workload.csgAuthorityReceiptCid)
    candidate.launcherAdmissionReceiptCid = strings.CloneStr(
        providerReceipt.receiptCid)
    candidate.complete = true
    candidate.receiptCid =
        productionLauncherSystemLinkExecAdmissionReceiptCidUnchecked(
            candidate)
    if !CsgCoreProductionLauncherSystemLinkExecAdmissionStrictValidateInto(
           candidate, err):
        return false
    out = candidate
    err = ""
    return true

# --- retained-fd arming edge (gaps 1, 2, 5) ---------------------------------
#
# The launcher is the only process-entry arming edge that owns all three facts
# at once: a retained (still-open) binary descriptor, the live session
# capability, and a closed admission receipt. It never re-resolves a pathname
# for execution; it opens O_CLOEXEC, keeps the descriptor, reuses
# held_exec_identity for the stat/bytes/native-image evidence (which opens and
# closes its own descriptor), and only spawns from the retained descriptor.

fn productionLauncherBytesPutU8(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: int32) =
    if off >= cap:
        return
    rawbytes.BytesSet(buf, off, value)
    off = off + 1

fn productionLauncherBytesPutU64(
        buf: var rawbytes.Bytes,
        off: var int32,
        cap: int32,
        value: uint64) =
    var shift: int32
    while shift < 8:
        productionLauncherBytesPutU8(
            buf, off, cap, int32((value >> (shift * 8)) & uint64(255)))
        shift = shift + 1

fn productionLauncherHashPrefix(buf: var rawbytes.Bytes, n: int32): str =
    var slim: rawbytes.Bytes
    slim = rawbytes.BytesAlloc(n)
    var index: int32
    while index < n:
        rawbytes.BytesSet(slim, index, rawbytes.BytesGet(buf, index))
        index = index + 1
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(slim))
    rawbytes.BytesFree(slim)
    return "sha256:" + layout.FixedBytes32Hex(digest)

fn productionLauncherStackCid2(
        domain: str,
        a: uint64,
        b: uint64): str =
    var buf: rawbytes.Bytes
    buf = rawbytes.BytesAlloc(160)
    var off: int32
    var index: int32
    while index < domain.len && off < 96:
        productionLauncherBytesPutU8(buf, off, 160, domain[index])
        index = index + 1
    productionLauncherBytesPutU64(buf, off, 160, a)
    productionLauncherBytesPutU64(buf, off, 160, b)
    let cid = productionLauncherHashPrefix(buf, off)
    rawbytes.BytesFree(buf)
    return cid

@borrows
fn productionLauncherHeldDescriptorTokenCid(
        device: uint64,
        inode: uint64): str =
    return productionLauncherStackCid2(
        CsgCoreProductionLauncherHeldTokenDomain, device, inode)

@borrows
fn productionLauncherImmutableReceiptCid(inodeFlags: uint64): str =
    return productionLauncherStackCid2(
        CsgCoreProductionLauncherImmutableReceiptDomain, inodeFlags, uint64(0))

fn productionLauncherProviderAuthorityCid(): str =
    return productionLauncherStackCid2(
        CsgCoreProductionLauncherProviderAuthorityDomain,
        uint64(1),
        uint64(0))

@borrows
fn productionLauncherWorkloadSubCid(
        domain: str,
        seed: str): str =
    var buf: rawbytes.Bytes
    buf = rawbytes.BytesAlloc(192)
    var off: int32
    var index: int32
    while index < domain.len && off < 64:
        productionLauncherBytesPutU8(buf, off, 192, domain[index])
        index = index + 1
    var seedOff: int32
    while seedOff < seed.len && off < 192:
        productionLauncherBytesPutU8(buf, off, 192, seed[seedOff])
        seedOff = seedOff + 1
    let cid = productionLauncherHashPrefix(buf, off)
    rawbytes.BytesFree(buf)
    return cid

fn CsgCoreProductionLauncherMainActivateHeldBinaryInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability,
        retainedBinaryFd: int32,
        executableObjectCid: str,
        heldDescriptorIdentityCid: str,
        argvCid: str,
        environmentCid: str,
        planReceiptCid: str,
        proofCid: str,
        admissionReceiptCid: str): bool =
    let _sessionCapability = sessionCapability
    let _executableObjectCid = executableObjectCid
    let _heldDescriptorIdentityCid = heldDescriptorIdentityCid
    let _argvCid = argvCid
    let _environmentCid = environmentCid
    let _planReceiptCid = planReceiptCid
    let _proofCid = proofCid
    let _admissionReceiptCid = admissionReceiptCid
    let _closed =
        held_identity.ChengHeldExecIdentityCloseRetainedFile(
            retainedBinaryFd)
    return productionLauncherActivateFail(
        "cross_process_admission_ticket_unwired")
# Process-entry session owner for system-link-exec only. The generated entry
# bridge captured argv before the source entry runs; RawParamEquals reads that
# runtime-owned view without allocating or exposing a pointer to Cheng code.
fn CsgCoreProductionLauncherBeginHeldSystemLinkSessionInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability): bool =
    sessionCapability.handle = uint64(0)
    sessionCapability.generation = uint64(0)
    sessionCapability.nonce0 = uint64(0)
    sessionCapability.nonce1 = uint64(0)
    if !cmdline.RawParamEquals(1, "system-link-exec"):
        return true
    return system.RuntimeAllocationLedgerSessionOwnerBegin(
        uint64(1073741824), sessionCapability)

fn CsgCoreProductionLauncherMoveProcessEntrySessionIntoProvider(
        sessionCapability:
            var system.RuntimeAllocationLedgerSessionCapability,
        outPreflightCloseOwner: var int32,
        err: var str): bool =
    err = ""
    outPreflightCloseOwner = -1
    if !held_exec_provider.CsgCoreProductionAdmittedInputAuthorityInitializeBeforeFork(
           sessionCapability,
           outPreflightCloseOwner):
        err = "production_launcher_e_admitted_input_session_move"
        return false
    if sessionCapability.handle != uint64(0) ||
       sessionCapability.generation != uint64(0) ||
       sessionCapability.nonce0 != uint64(0) ||
       sessionCapability.nonce1 != uint64(0) ||
       outPreflightCloseOwner <= 0:
        panic("production launcher session move did not clear source")
    return true

fn CsgCoreProductionLauncherCloseHeldSystemLinkSessionReceiptInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability,
        outReceipt: var system.RuntimeAllocationLedgerReceipt,
        err: var str): bool =
    outReceipt = system.RuntimeAllocationLedgerReceipt()
    err = ""
    if sessionCapability.handle == uint64(0):
        err = "production_launcher_e_allocation_session_missing"
        return false
    let closed =
        system.RuntimeAllocationLedgerSessionOwnerClose(sessionCapability)
    if !closed.ok || !closed.receipt.complete ||
       !closed.receipt.closed || closed.receipt.active:
        if closed.error.len > 0:
            err = strings.CloneStr(closed.error)
        else:
            err = "production_launcher_e_allocation_session_close"
        return false
    outReceipt = closed.receipt
    return true

fn CsgCoreProductionLauncherCloseHeldSystemLinkSessionInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability): bool =
    if sessionCapability.handle == uint64(0):
        return true
    var receipt: system.RuntimeAllocationLedgerReceipt
    var err: str
    return CsgCoreProductionLauncherCloseHeldSystemLinkSessionReceiptInto(
        sessionCapability, receipt, err)

fn CsgCoreProductionLauncherConsumeProviderCloseReadyAndCloseInto(
        err: var str): bool =
    return held_exec_provider.CsgCoreProductionAdmittedInputAuthorityConsumeCloseReadyAndCloseInto(
        err)

fn CsgCoreProductionLauncherConsumeProviderPreflightCloseReadyAndCloseInto(
        preflightCloseOwner: var int32,
        err: var str): bool =
    return held_exec_provider.CsgCoreProductionAdmittedInputAuthorityConsumePreflightCloseReadyAndCloseInto(
        preflightCloseOwner, err)

fn productionLauncherActivateFail(reason: str): bool =
    os.WriteLine(
        os.Get_stderr(),
        strings.ConcatStr("activate_fail=", reason))
    return false

# Production system-link activation is fail-closed until the inherited
# one-shot admission ticket and the child-owned terminal receipt are wired.
fn CsgCoreProductionLauncherMainActivateHeldSystemLinkInto(
        sessionCapability: var system.RuntimeAllocationLedgerSessionCapability): bool =
    let _sessionCapability = sessionCapability
    return productionLauncherActivateFail(
        "cross_process_admission_ticket_unwired")

# --- real parent/child production protocol ---------------------------------

fn productionLauncherStackCid4(
        domain: str,
        a: uint64,
        b: uint64,
        c: uint64,
        d: uint64): str =
    var buf: rawbytes.Bytes
    buf = rawbytes.BytesAlloc(192)
    var off: int32
    for index in 0..<domain.len:
        productionLauncherBytesPutU8(buf, off, 192, domain[index])
    productionLauncherBytesPutU64(buf, off, 192, a)
    productionLauncherBytesPutU64(buf, off, 192, b)
    productionLauncherBytesPutU64(buf, off, 192, c)
    productionLauncherBytesPutU64(buf, off, 192, d)
    let cid = productionLauncherHashPrefix(buf, off)
    rawbytes.BytesFree(buf)
    return cid

fn productionLauncherCloseTerminalRootOwner(ownerHandle: int32) =
    if ownerHandle <= 0:
        return
    var closeErr: str
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
           ownerHandle, closeErr):
        panic(strings.ConcatStr(
            "production launcher: terminal root owner close failed: ",
            closeErr))

fn productionLauncherDetachTerminalJournalOwner(journalOwner: int32) =
    if journalOwner <= 0:
        return
    var detachErr: str
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianDetachForRecoveryInto(
           journalOwner, detachErr):
        panic(strings.ConcatStr(
            "production launcher: terminal journal detach failed: ",
            detachErr))

@borrows
fn CsgCoreProductionLauncherAllocationReceiptCid(
        receipt: system.RuntimeAllocationLedgerReceipt): str =
    return productionLauncherStackCid4(
        "csg_core.production_held_exec.allocation_receipt",
        receipt.receiptCid.word0,
        receipt.receiptCid.word1,
        receipt.receiptCid.word2,
        receipt.receiptCid.word3)

fn CsgCoreProductionLauncherChildImportAtEntry(): int32 =
    return system.RuntimeHeldExecChildImport()

fn CsgCoreProductionLauncherChildTerminalCapsuleImportInto(
        outChildCapsuleOwner: var int32,
        err: var str): bool =
    return merkle_store.ProductionHeldExecTerminalCapsuleChildImportInto(
        outChildCapsuleOwner, err)

fn CsgCoreProductionLauncherChildAdmissionActive(): bool =
    return system.RuntimeHeldExecChildAdmissionActive()

@borrows
fn CsgCoreProductionLauncherPublishSystemLinkExecOutputInto(
        outputCid: str,
        compileReceiptCid: str,
        compileReceiptCanonical: str,
        outputPath: str,
        err: var str): bool =
    return system.RuntimeHeldExecChildPublishOutputInto(
        outputCid,
        compileReceiptCid,
        compileReceiptCanonical,
        outputPath,
        err)

@borrows
fn CsgCoreProductionLauncherFinishSystemLinkExecChildInto(
        childCapsuleOwner: int32,
        exitCode: int32,
        allocationReceipt: system.RuntimeAllocationLedgerReceipt,
        outTerminalReceiptCid: var str,
        err: var str): bool =
    if !allocationReceipt.complete ||
       !allocationReceipt.closed ||
       allocationReceipt.active:
        err = "production_launcher_e_allocation_receipt_open"
        return false
    let allocationReceiptCid =
        CsgCoreProductionLauncherAllocationReceiptCid(allocationReceipt)
    return system.RuntimeHeldExecChildFinishInto(
        childCapsuleOwner,
        exitCode,
        allocationReceiptCid,
        outTerminalReceiptCid,
        err)

# The only parent orchestration edge.  The provider issues the immutable
# admission before fork, owns ISSUED -> CLAIMED after the runtime has
# authenticated SCM_CREDENTIALS, and owns the terminal CAS before the runtime
# sends COMMITTED|ABORTED and reaps the child.
fn CsgCoreProductionLauncherRunAdmittedSystemLinkExecParentInto(
        preflightCloseOwner: var int32,
        producerHandle:
            var pre_exec_input.CsgCoreProductionPreExecInputProducerHandle,
        retainedBinaryFd: int32,
        outputPath: str,
    out: var spawn_bridge.CsgCoreProductionHeldExecSpawnResult,
    err: var str): bool =
    out = spawn_bridge.CsgCoreProductionHeldExecSpawnResult()
    if retainedBinaryFd <= 2:
        if retainedBinaryFd > 2:
            let _closedInvalidRetained =
                held_identity.ChengHeldExecIdentityCloseRetainedFile(
                    retainedBinaryFd)
        err = "production_launcher_e_pre_exec_producer_receipt"
        return false
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianInitializeBeforeLoop():
        let _closedGuardianInitRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        err = "production_launcher_e_terminal_guardian_initialize"
        return false
    let policy = csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    if !policy.admitted:
        let _closedPolicyRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        err = strings.ConcatStr(
            "production_launcher_e_store_policy:", policy.error)
        return false
    var headLease: merkle_store.CsgCoreMerkleStoreCurrentHeadLease
    if !merkle_store.CsgCoreMerkleStoreAcquireCurrentHeadSharedLease(
           policy.parentPath,
           policy.storeName,
           headLease,
           err):
        let _closedLeaseRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    if !merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseVerifyFence(
           headLease):
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(headLease)
        let _closedInitialFenceRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        err = "production_launcher_e_current_head_fence_before_owner"
        return false
    var storeRootOwnerHandle: int32
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerIssueInto(
           headLease,
           policy.policyCid,
           storeRootOwnerHandle,
           err):
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(headLease)
        let _closedRootIssueRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianRecoverAllInto(
           storeRootOwnerHandle, err):
        productionLauncherCloseTerminalRootOwner(storeRootOwnerHandle)
        let _closedRecoveryRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    if storeRootOwnerHandle <= 0:
        panic("production launcher terminal recovery root move failed")
    var ownerHandle: held_exec_provider.CsgCoreProductionPreExecInputOwnerHandle
    var ownerReceipt: held_exec_provider.CsgCoreProductionPreExecInputOwnerReceipt
    var envelopeBytes: str
    if !pre_exec_input.CsgCoreProductionPreExecInputProducerTakeAndIssueOwnerInto(
           producerHandle,
           envelopeBytes,
           ownerHandle,
           ownerReceipt,
           err):
        productionLauncherCloseTerminalRootOwner(storeRootOwnerHandle)
        let _closedOwnerRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    var activationBundleBytes: str
    var activationBundleCid: str
    var activationBundleErr: str
    if !held_exec_provider.CsgCoreProductionPreExecActivationBundleEncodeInto(
           envelopeBytes,
           ownerReceipt,
           activationBundleBytes,
           activationBundleCid,
           activationBundleErr):
        var abortActivationOwnerErr: str
        let _abortedActivationOwner =
            held_exec_provider.CsgCoreProductionPreExecInputOwnerAbortInto(
                ownerHandle, abortActivationOwnerErr)
        productionLauncherCloseTerminalRootOwner(storeRootOwnerHandle)
        let _closedActivationRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        err = strings.ConcatStr(
            "production_launcher_e_activation_bundle:",
            activationBundleErr)
        return false
    var bundleOwner = system.RuntimeHeldExecParentSealBundleOwner(
        activationBundleBytes, activationBundleCid)
    if bundleOwner <= 0:
        var abortUnsealedOwnerErr: str
        let _abortedUnsealedOwner =
            held_exec_provider.CsgCoreProductionPreExecInputOwnerAbortInto(
                ownerHandle, abortUnsealedOwnerErr)
        productionLauncherCloseTerminalRootOwner(storeRootOwnerHandle)
        let _closedUnsealedRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        err = "production_launcher_e_held_bundle_seal"
        return false
    let bundleDigestCid = strings.CloneStr(activationBundleCid)
    var rootOwnerBindingCid: str
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           storeRootOwnerHandle,
           rootOwnerBindingCid,
           err):
        if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("production launcher root-binding bundle abort failed")
        bundleOwner = -1
        var abortRootBindingOwnerErr: str
        let _abortedRootBindingOwner =
            held_exec_provider.CsgCoreProductionPreExecInputOwnerAbortInto(
                ownerHandle, abortRootBindingOwnerErr)
        productionLauncherCloseTerminalRootOwner(storeRootOwnerHandle)
        let _closedRootBindingRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    var admittedOwner: int32 = -1
    var providerHeldBundleCid: str
    let admittedIssued =
        held_exec_provider.CsgCoreProductionHeldExecProviderIssueAdmittedInputInto(
           preflightCloseOwner,
           ownerHandle.handleRow,
           storeRootOwnerHandle,
           bundleOwner,
           rootOwnerBindingCid,
           activationBundleBytes,
           admittedOwner,
           providerHeldBundleCid,
           err)
    if admittedIssued &&
       (ownerHandle.handleRow != -1 || bundleOwner != -1 ||
        storeRootOwnerHandle != -1):
        panic("production launcher admitted owner move publication failed")
    if !admittedIssued || providerHeldBundleCid != bundleDigestCid:
        if !admittedIssued:
            if bundleOwner > 0 &&
               !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
                panic("production launcher bundle owner abort failed")
            productionLauncherCloseTerminalRootOwner(storeRootOwnerHandle)
            var abortUnissuedOwnerErr: str
            let _abortedUnissuedOwner =
                held_exec_provider.CsgCoreProductionPreExecInputOwnerAbortInto(
                    ownerHandle, abortUnissuedOwnerErr)
        else:
            var abortDriftErr: str
            let _abortedDrift =
                merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
                    admittedOwner, abortDriftErr)
        let _closedUnissuedRetained =
            held_identity.ChengHeldExecIdentityCloseRetainedFile(
                retainedBinaryFd)
        return false
    var claim: spawn_bridge.CsgCoreProductionHeldExecClaimResult
    let beganClaim = spawn_bridge.CsgCoreProductionHeldExecBeginClaimInto(
        retainedBinaryFd, outputPath, claim, err)
    let closedOriginalRetained =
        held_identity.ChengHeldExecIdentityCloseRetainedFile(
            retainedBinaryFd)
    if !beganClaim || !closedOriginalRetained:
        if beganClaim:
            var resolveUnclosedErr: str
            let _resolvedUnclosed =
                spawn_bridge.CsgCoreProductionHeldExecAbortUnresolvedInto(
                    claim.session, resolveUnclosedErr)
        var abortIssuedErr: str
        let _abortedIssued =
            merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
                admittedOwner, abortIssuedErr)
        if beganClaim && !closedOriginalRetained:
            err = "production_launcher_e_retained_fd_close"
        return false
    var claimOwner: int32
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianBeginInto(
           claim.session,
           admittedOwner,
           claimOwner,
           err):
        var resolveAbortErr: str
        let _resolvedAbort =
            spawn_bridge.CsgCoreProductionHeldExecAbortUnresolvedInto(
                claim.session, resolveAbortErr)
        return false
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianActivateInto(
           claimOwner, err):
        var resolveActivateErr: str
        let _resolvedActivate =
            spawn_bridge.CsgCoreProductionHeldExecAbortUnresolvedInto(
                claim.session, resolveActivateErr)
        productionLauncherDetachTerminalJournalOwner(claimOwner)
        return false
    # The child installs its typed upload, fdatasyncs and closes the write
    # role before sending FINISHED. Exact inode readback moves the private
    # transport owner directly into the journal; it never reaches this layer.
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianFinishInto(
           claimOwner,
           outputPath,
           err):
        var resolveFinishedErr: str
        let _resolvedFinished =
            spawn_bridge.CsgCoreProductionHeldExecAbortUnresolvedInto(
                claim.session, resolveFinishedErr)
        productionLauncherDetachTerminalJournalOwner(claimOwner)
        return false
    # DECISION and provider finalization are journal-owned and happen before
    # either terminal transport may consume the exact decision owner.  A
    # failure here is recoverable from the durable session index; it must not
    # be rewritten into an in-memory ABORT.
    var decisionOwner: int32
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianFinalizeProviderInto(
           claimOwner,
           decisionOwner,
           err):
        return false
    if decisionOwner <= 0:
        panic("production launcher: durable decision owner lost")
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianObserveExitInto(
           claimOwner, err):
        return false
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianReapInto(
           claimOwner, err):
        return false
    var workloadExitCode: int32
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianDrainAfterReapInto(
           claimOwner, workloadExitCode, err):
        return false
    if !held_exec_provider.CsgCoreProductionAdmittedInputAuthorityCloseReady():
        panic("production launcher terminal drain lost CloseReady")
    out.exitCode = workloadExitCode
    err = ""
    return true

@borrows
fn CsgCoreProductionLauncherRunPreparedSystemLinkExecParent(
        preflightCloseOwner: var int32,
        producerHandle:
            var pre_exec_input.CsgCoreProductionPreExecInputProducerHandle,
        retainedBinaryFd: int32,
        outputPath: str): int32 =
    var result: spawn_bridge.CsgCoreProductionHeldExecSpawnResult
    var err: str
    if !CsgCoreProductionLauncherRunAdmittedSystemLinkExecParentInto(
           preflightCloseOwner,
           producerHandle,
           retainedBinaryFd,
           share(outputPath),
           result,
           err):
        os.WriteLine(
            os.Get_stderr(),
            strings.ConcatStr("HARD_RED:production_launcher_parent:", err))
        return 2
    return result.exitCode
