    CsgCoreProductionLauncherMilestoneTsActivation: str =
        "ts_generation_activation"
    CsgCoreProductionLauncherMilestoneLinuxExact1g: str =
        "linux_exact_1g_execution"
    CsgCoreProductionLauncherMilestoneChildCount: int32 = 5

    CsgCoreProductionLauncherErrSchemaMismatch: str =
