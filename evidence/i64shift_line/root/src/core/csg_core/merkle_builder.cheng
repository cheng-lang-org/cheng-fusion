import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

const
    CsgBuilderSchemaKind: str = "csg.core.schema"
    csgBuilderSchemaNamespace: str = "csg_core::v1"
    CsgBuilderRuntimeRequirementKind: str = "csg.runtime_requirement"
    CsgBuilderExternalSymbolKind: str = "csg.external_symbol"
    CsgBuilderMerkleManifestKind: str = "csg.merkle.manifest"

type
    CsgCoreMerkleBuilderSource =
        sourceId: str
        sourceCid: str
        facts: str[]
        factsProvenCanonical: bool

    CsgCoreMerkleBuilderLocalResult =
        ok: bool
        error: str
        factCount: int32
        partitions: merkle_artifacts.CsgCoreMerklePartitionFactsResult[]
        memberships: merkle_artifacts.CsgCoreMerkleMembershipResult[]
        manifestPartitions: merkle_manifest.CsgCoreMerklePartitionRecord[]
        queryRecords: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]

    CsgCoreMerkleBuilderDependencyCargo =
        ok: bool
        error: str
        consumerShards: merkle_artifacts.CsgCoreMerkleDependencyShardResult[]
        providerShards: merkle_artifacts.CsgCoreMerkleDependencyShardResult[]
        consumerDescriptors: merkle_manifest.CsgCoreMerkleShardDescriptor[]
        providerDescriptors: merkle_manifest.CsgCoreMerkleShardDescriptor[]
        consumerRoot: str
        providerRoot: str
        dependencyCount: int32

    CsgCoreMerkleBuilderQueryCargo =
        ok: bool
        error: str
        shards: merkle_artifacts.CsgCoreMerkleQueryShardResult[]
        descriptors: merkle_manifest.CsgCoreMerkleShardDescriptor[]
        root: str
        entryCount: int32

    CsgCoreMerkleBuilderResult =
        ok: bool
        error: str
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaCid: str
        factsRoot: str
        dagRootCid: str
        factCount: int32
        partitions: merkle_artifacts.CsgCoreMerklePartitionFactsResult[]
        memberships: merkle_artifacts.CsgCoreMerkleMembershipResult[]
        nodeSegments: merkle_store_codec.CsgCoreMerkleNodeSegmentResult[]
        dependencyCargo: CsgCoreMerkleBuilderDependencyCargo
        queryCargo: CsgCoreMerkleBuilderQueryCargo
        summary: merkle_artifacts.CsgCoreMerkleSummaryResult
        manifest: merkle_manifest.CsgCoreMerkleManifest
        manifestArtifact: merkle_manifest.CsgCoreMerkleManifestEncodeResult
        admission: merkle_admission.CsgCoreMerkleAdmissionResult

    csgBuilderFactEntry =
        sourceId: str
        sourceCid: str
        factKind: str
        factKey: str
        fact: str

    csgBuilderOrderKey =
        first: str
        second: str
        third: str
        fourth: str
        fifth: str
        original: int32

@borrows
fn csgBuilderCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgBuilderTextCompare(
        left: str,
        right: str): int32 =
    let common =
        if left.len < right.len:
            left.len
        else:
            right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgBuilderTuplePart(value: str): str =
    return csgBuilderCat(
        csgBuilderCat(
            strings.IntToStr(value.len), ":"),
        value)

@borrows
fn csgBuilderSourceSubgraphKey(
        sourceId: str,
        subgraphCid: str): str =
    return csgBuilderCat(
        csgBuilderTuplePart(sourceId),
        csgBuilderTuplePart(subgraphCid))

@borrows
fn csgBuilderHashCid(
        value: layout.FixedBytes32): str =
    return csgBuilderCat(
        "sha256:",
        layout.FixedBytes32Hex(value))

@borrows
fn csgBuilderSetError(
        out: var CsgCoreMerkleBuilderResult,
        error: str) =
    out.ok = false
    out.error = strings.CloneStr(error)

@borrows
fn csgBuilderOrderKeyCompare(
        left: csgBuilderOrderKey,
        right: csgBuilderOrderKey): int32 =
    var order =
        csgBuilderTextCompare(
            left.first, right.first)
    if order != 0:
        return order
    order =
        csgBuilderTextCompare(
            left.second, right.second)
    if order != 0:
        return order
    order =
        csgBuilderTextCompare(
            left.third, right.third)
    if order != 0:
        return order
    order =
        csgBuilderTextCompare(
            left.fourth, right.fourth)
    if order != 0:
        return order
    return csgBuilderTextCompare(
        left.fifth, right.fifth)

@borrows
fn csgBuilderOrder(
        keys: csgBuilderOrderKey[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, keys.len)
    setLen(scratch, keys.len)
    for i in 0..<keys.len:
        order[i] = i
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgBuilderOrderKeyCompare(
                        keys[order[left]],
                        keys[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var original: int32[]
    for i in 0..<order.len:
        add(original, keys[order[i]].original)
    return original

@borrows
fn csgBuilderEntryOrder(
        entries: csgBuilderFactEntry[]): int32[] =
    var keys: csgBuilderOrderKey[]
    for i in 0..<entries.len:
        var key: csgBuilderOrderKey
        key.first = strings.CloneStr(entries[i].sourceId)
        key.second = strings.CloneStr(entries[i].factKind)
        key.third = strings.CloneStr(entries[i].factKey)
        key.original = i
        add(keys, key)
    return csgBuilderOrder(keys)

@borrows
fn csgBuilderStringOrder(values: str[]): int32[] =
    var keys: csgBuilderOrderKey[]
    for i in 0..<values.len:
        var key: csgBuilderOrderKey
        key.first = strings.CloneStr(values[i])
        key.original = i
        add(keys, key)
    return csgBuilderOrder(keys)

@borrows
fn csgBuilderBinaryContains(
        values: str[],
        order: int32[],
        wanted: str): bool =
    var low: int32
    var high = order.len
    while low < high:
        let middle = low + (high - low) / 2
        let compared =
            csgBuilderTextCompare(
                values[order[middle]], wanted)
        if compared < 0:
            low = middle + 1
        else:
            high = middle
    return low < order.len &&
        values[order[low]] == wanted

@borrows
fn csgBuilderDependencyOrder(
        records:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        int32[] =
    var keys: csgBuilderOrderKey[]
    for i in 0..<records.len:
        var key: csgBuilderOrderKey
        key.first =
            strings.CloneStr(records[i].consumerSource)
        key.second =
            strings.CloneStr(records[i].providerSource)
        key.third = strings.CloneStr(records[i].selector)
        key.original = i
        add(keys, key)
    return csgBuilderOrder(keys)

@borrows
fn csgBuilderQueryOrder(
        records:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]):
        int32[] =
    var keys: csgBuilderOrderKey[]
    for i in 0..<records.len:
        var key: csgBuilderOrderKey
        key.first = strings.CloneStr(records[i].indexKind)
        key.second = strings.CloneStr(records[i].term)
        key.third = strings.CloneStr(records[i].factKey)
        key.fourth =
            strings.CloneStr(records[i].partitionId)
        key.fifth = strings.CloneStr(records[i].sourceId)
        key.original = i
        add(keys, key)
    return csgBuilderOrder(keys)

@borrows
fn csgBuilderCloneDependency(
        record:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        merkle_artifacts.CsgCoreMerkleDependencyRecord =
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord
    out.consumerSource =
        strings.CloneStr(record.consumerSource)
    out.providerSource =
        strings.CloneStr(record.providerSource)
    out.selector = strings.CloneStr(record.selector)
    out.providerSubgraphCid =
        strings.CloneStr(record.providerSubgraphCid)
    return out

@borrows
fn csgBuilderCloneQuery(
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        merkle_artifacts.CsgCoreMerkleQueryIndexRecord =
    var out: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    out.indexKind = strings.CloneStr(record.indexKind)
    out.term = strings.CloneStr(record.term)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid = strings.CloneStr(record.sourceCid)
    return out

@borrows
fn csgBuilderCloneMembership(
        record:
            merkle_artifacts.CsgCoreMerkleMembershipRecord):
        merkle_artifacts.CsgCoreMerkleMembershipRecord =
    var out: merkle_artifacts.CsgCoreMerkleMembershipRecord
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid = strings.CloneStr(record.sourceCid)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    return out

@borrows
fn csgBuilderPartitionId(
        sourceId: str,
        factKind: str): str =
    var identity: merkle_manifest.CsgCoreMerklePartitionRecord
    identity.sourceId = strings.CloneStr(sourceId)
    identity.factKind = strings.CloneStr(factKind)
    return merkle_manifest.CsgCoreMerklePartitionId(
        identity)

@borrows
fn csgBuilderMembership(
        partition:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult):
        merkle_artifacts.CsgCoreMerkleMembershipResult =
    let dag =
        merkle_dag.CsgCoreMerkleBuild(
            partition.facts)
    if !dag.ok:
        var failed: merkle_artifacts.CsgCoreMerkleMembershipResult
        failed.error =
            csgBuilderCat(
                "merkle_builder_membership_dag ",
                dag.error)
        return failed
    var unsorted: merkle_artifacts.CsgCoreMerkleMembershipRecord[]
    var keys: str[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        if dag.nodeKinds[nodeIndex] !=
           merkle_dag.CsgCoreMerkleLeafNodeKind():
            continue
        var nodeError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, nodeIndex, nodeError)
        if nodeError.len > 0:
            var failed: merkle_artifacts.CsgCoreMerkleMembershipResult
            failed.error =
                csgBuilderCat(
                    "merkle_builder_membership_record ",
                    nodeError)
            return failed
        var record: merkle_artifacts.CsgCoreMerkleMembershipRecord
        record.partitionId =
            strings.CloneStr(
                partition.header.partitionId)
        record.sourceId =
            strings.CloneStr(
                partition.header.sourceId)
        record.sourceCid =
            strings.CloneStr(
                partition.header.sourceCid)
        record.factKey = strings.CloneStr(node.key)
        record.factHash =
            csgBuilderHashCid(node.factHash)
        record.leafCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                node)
        add(keys, strings.CloneStr(record.factKey))
        add(unsorted, record)
    if unsorted.len != partition.factCount:
        var failed: merkle_artifacts.CsgCoreMerkleMembershipResult
        failed.error =
            "merkle_builder_membership_count_mismatch"
        return failed
    let order = csgBuilderStringOrder(keys)
    var records: merkle_artifacts.CsgCoreMerkleMembershipRecord[]
    for i in 0..<order.len:
        if i > 0 &&
           keys[order[i - 1]] == keys[order[i]]:
            var failed: merkle_artifacts.CsgCoreMerkleMembershipResult
            failed.error =
                "merkle_builder_membership_duplicate"
            return failed
        add(
            records,
            csgBuilderCloneMembership(
                unsorted[order[i]]))
    var header: merkle_artifacts.CsgCoreMerkleMembershipHeader
    header.partitionId =
        strings.CloneStr(
            partition.header.partitionId)
    header.sourceId =
        strings.CloneStr(partition.header.sourceId)
    header.sourceCid =
        strings.CloneStr(partition.header.sourceCid)
    header.factKind =
        strings.CloneStr(partition.header.factKind)
    header.factsCid = strings.CloneStr(partition.cid)
    header.factsRoot =
        strings.CloneStr(partition.factsRoot)
    header.dagRootCid =
        strings.CloneStr(partition.dagRootCid)
    header.factCount = partition.factCount
    return merkle_artifacts.CsgCoreMerkleMembershipEncode(
        header, records)

@borrows
fn csgBuilderManifestPartition(
        partition:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipResult):
        merkle_manifest.CsgCoreMerklePartitionRecord =
    var out: merkle_manifest.CsgCoreMerklePartitionRecord
    out.sourceId =
        strings.CloneStr(partition.header.sourceId)
    out.sourceCid =
        strings.CloneStr(partition.header.sourceCid)
    out.factKind =
        strings.CloneStr(partition.header.factKind)
    out.factsCid = strings.CloneStr(partition.cid)
    out.factsRoot =
        strings.CloneStr(partition.factsRoot)
    out.dagRootCid =
        strings.CloneStr(partition.dagRootCid)
    out.membershipCid =
        strings.CloneStr(membership.cid)
    out.factCount = partition.factCount
    return out

@borrows
fn csgBuilderAppendQuery(
        records: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        indexKind: str,
        term: str,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord) =
    if term.len == 0:
        return
    var record: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    record.indexKind = strings.CloneStr(indexKind)
    record.term = strings.CloneStr(term)
    record.factKey =
        strings.CloneStr(membership.factKey)
    record.factHash =
        strings.CloneStr(membership.factHash)
    record.leafCid =
        strings.CloneStr(membership.leafCid)
    record.partitionId =
        strings.CloneStr(membership.partitionId)
    record.sourceId =
        strings.CloneStr(membership.sourceId)
    record.sourceCid =
        strings.CloneStr(membership.sourceCid)
    add(records, record)

@borrows
fn csgBuilderAppendOptionalQuery(
        records: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        fact: str,
        fieldName: str,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord) =
    let value =
        field.CsgCoreJsonTopStringField(
            fact, fieldName)
    if value.found && value.value.len > 0:
        csgBuilderAppendQuery(
            records,
            fieldName,
            value.value,
            membership)

@borrows
fn csgBuilderAppendFactQueries(
        records: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        fact: str,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord):
        bool =
    let kind = field.CsgCoreJsonKind(fact)
    if !kind.found || kind.value.len == 0:
        return false
    csgBuilderAppendQuery(
        records,
        "fact_key",
        membership.factKey,
        membership)
    csgBuilderAppendQuery(
        records,
        "kind",
        kind.value,
        membership)
    csgBuilderAppendOptionalQuery(
        records, fact, "symbol", membership)
    csgBuilderAppendOptionalQuery(
        records, fact, "name", membership)
    csgBuilderAppendOptionalQuery(
        records, fact, "file", membership)
    csgBuilderAppendOptionalQuery(
        records, fact, "caller", membership)
    return true

@borrows
fn csgBuilderPrepareEntries(
        standard: str,
        profiles: str[],
        sources: CsgCoreMerkleBuilderSource[],
        entries: var csgBuilderFactEntry[],
        canonicalFacts: var str[],
        schemaLine: var str,
        globalDag: var merkle_dag.CsgCoreMerkleDag,
        error: var str): bool =
    error = ""
    if standard != validator.CsgCoreStandardIdentity():
        error = "merkle_builder_standard_invalid"
        return false
    let profileError =
        validator.CsgCoreProfilesCanonicalError(profiles)
    if profileError.len > 0:
        error = csgBuilderCat(
            "merkle_builder_profiles ",
            profileError)
        return false
    if sources.len == 0:
        error = "merkle_builder_sources_empty"
        return false
    var sourceIds: str[]
    for sourceIndex in 0..<sources.len:
        let source = sources[sourceIndex]
        if source.sourceId.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               source.sourceCid) ||
           source.facts.len == 0:
            error = "merkle_builder_source_invalid"
            return false
        add(
            sourceIds,
            strings.CloneStr(source.sourceId))
    let sourceOrder =
        csgBuilderStringOrder(sourceIds)
    for i in 1..<sourceOrder.len:
        if sourceIds[sourceOrder[i - 1]] ==
           sourceIds[sourceOrder[i]]:
            error = "merkle_builder_source_duplicate"
            return false
    for sourceIndex in 0..<sources.len:
        let source = sources[sourceIndex]
        for factIndex in 0..<source.facts.len:
            var canonical: str
            if source.factsProvenCanonical:
                canonical = source.facts[factIndex]
            else:
                var canonicalError: str
                canonical =
                    merkle_dag.CsgCoreMerkleCanonicalFact(
                        source.facts[factIndex],
                        canonicalError)
                if canonicalError.len > 0 ||
                   canonical != source.facts[factIndex]:
                    error =
                        "merkle_builder_fact_non_canonical"
                    return false
            let kind =
                field.CsgCoreJsonKind(canonical)
            if !kind.found || kind.value.len == 0:
                error = "merkle_builder_fact_kind_missing"
                return false
            if kind.value ==
                   CsgBuilderRuntimeRequirementKind ||
               kind.value ==
                   CsgBuilderExternalSymbolKind:
                error =
                    "merkle_builder_runtime_closure_not_proven"
                return false
            if kind.value == CsgBuilderMerkleManifestKind:
                error =
                    "merkle_builder_manifest_fact_forbidden"
                return false
            var keyError: str
            let key =
                merkle_dag.CsgCoreMerkleFactKeyFromCanonical(
                    canonical, keyError)
            if keyError.len > 0:
                error =
                    csgBuilderCat(
                        "merkle_builder_fact_key ",
                        keyError)
                return false
            var entry: csgBuilderFactEntry
            entry.sourceId =
                strings.CloneStr(source.sourceId)
            entry.sourceCid =
                strings.CloneStr(source.sourceCid)
            entry.factKind =
                strings.CloneStr(kind.value)
            entry.factKey = strings.CloneStr(key)
            entry.fact = strings.CloneStr(canonical)
            add(entries, entry)
            add(canonicalFacts, strings.CloneStr(canonical))
            if kind.value == CsgBuilderSchemaKind:
                if schemaLine.len > 0:
                    error =
                        "merkle_builder_schema_count_invalid"
                    return false
                schemaLine = strings.CloneStr(canonical)
    if schemaLine.len == 0:
        error = "merkle_builder_schema_count_invalid"
        return false
    let validation =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            canonicalFacts, globalDag)
    if !validation.valid ||
       !validation.complete ||
       validation.standard != standard ||
       !validator.CsgCoreProfilesEqual(
           validation.profiles, profiles) ||
       validation.profileSetCid !=
           validator.CsgCoreProfileSetCid(profiles) ||
       validation.factCount != canonicalFacts.len ||
       validation.unsupportedCount != 0 ||
       validation.tombstoneCount != 0:
        if validation.errors.len > 0:
            error =
                csgBuilderCat(
                    "merkle_builder_production_validation ",
                    validation.errors[0])
        else:
            error =
                "merkle_builder_production_validation_failed"
        return false
    var keys: str[]
    for i in 0..<entries.len:
        add(keys, strings.CloneStr(entries[i].factKey))
    let keyOrder = csgBuilderStringOrder(keys)
    for i in 1..<keyOrder.len:
        if keys[keyOrder[i - 1]] ==
           keys[keyOrder[i]]:
            error = "merkle_builder_fact_key_duplicate"
            return false
    return true

@borrows
fn csgBuilderPrepareLocalEntries(
        sources: CsgCoreMerkleBuilderSource[],
        entries: var csgBuilderFactEntry[],
        error: var str): bool =
    error = ""
    if sources.len == 0:
        error = "merkle_builder_local_sources_empty"
        return false
    var sourceIds: str[]
    for sourceIndex in 0..<sources.len:
        let source = sources[sourceIndex]
        if source.sourceId.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               source.sourceCid) ||
           source.facts.len == 0:
            error = "merkle_builder_local_source_invalid"
            return false
        add(
            sourceIds,
            strings.CloneStr(source.sourceId))
    let sourceOrder =
        csgBuilderStringOrder(sourceIds)
    for i in 1..<sourceOrder.len:
        if sourceIds[sourceOrder[i - 1]] ==
           sourceIds[sourceOrder[i]]:
            error = "merkle_builder_local_source_duplicate"
            return false
    for sourceIndex in 0..<sources.len:
        let source = sources[sourceIndex]
        for factIndex in 0..<source.facts.len:
            # Local rebuild must not re-parse producer-canonical JSONL into
            # CsgJsonValue (measured ~1.5GiB on an 8-line compile). The flag
            # is the same proof PrepareEntries already honors.
            var canonical: str
            if source.factsProvenCanonical:
                canonical = source.facts[factIndex]
            else:
                var canonicalError: str
                canonical =
                    merkle_dag.CsgCoreMerkleCanonicalFact(
                        source.facts[factIndex],
                        canonicalError)
                if canonicalError.len > 0 ||
                   canonical != source.facts[factIndex]:
                    error =
                        "merkle_builder_local_unproven_fact_non_canonical"
                    return false
            let kind =
                field.CsgCoreJsonKind(canonical)
            if !kind.found || kind.value.len == 0:
                error =
                    "merkle_builder_local_fact_kind_missing"
                return false
            if kind.value ==
                   CsgBuilderRuntimeRequirementKind ||
               kind.value ==
                   CsgBuilderExternalSymbolKind:
                error =
                    "merkle_builder_runtime_closure_not_proven"
                return false
            var keyError: str
            let key =
                merkle_dag.CsgCoreMerkleFactKeyFromCanonical(
                    canonical, keyError)
            if keyError.len > 0:
                error =
                    csgBuilderCat(
                        "merkle_builder_local_fact_key ",
                        keyError)
                return false
            var entry: csgBuilderFactEntry
            entry.sourceId =
                strings.CloneStr(source.sourceId)
            entry.sourceCid =
                strings.CloneStr(source.sourceCid)
            entry.factKind =
                strings.CloneStr(kind.value)
            entry.factKey = strings.CloneStr(key)
            entry.fact = strings.CloneStr(canonical)
            add(entries, entry)
    var keys: str[]
    for i in 0..<entries.len:
        add(keys, strings.CloneStr(entries[i].factKey))
    let keyOrder = csgBuilderStringOrder(keys)
    for i in 1..<keyOrder.len:
        if keys[keyOrder[i - 1]] ==
           keys[keyOrder[i]]:
            error =
                "merkle_builder_local_fact_key_duplicate"
            return false
    return true

@borrows
fn csgBuilderBuildPartitionsInto(
        entries: csgBuilderFactEntry[],
        partitions: var
            merkle_artifacts.CsgCoreMerklePartitionFactsResult[],
        memberships: var
            merkle_artifacts.CsgCoreMerkleMembershipResult[],
        manifestPartitions: var
            merkle_manifest.CsgCoreMerklePartitionRecord[],
        error: var str):
        bool =
    let order = csgBuilderEntryOrder(entries)
    var at: int32
    while at < order.len:
        let first = entries[order[at]]
        var finish = at + 1
        while finish < order.len &&
              entries[order[finish]].sourceId ==
                  first.sourceId &&
              entries[order[finish]].factKind ==
                  first.factKind:
            finish = finish + 1
        var facts: str[]
        for i in at..<finish:
            add(
                facts,
                strings.CloneStr(
                    entries[order[i]].fact))
        var header: merkle_artifacts.CsgCoreMerklePartitionFactsHeader
        header.partitionId =
            csgBuilderPartitionId(
                first.sourceId,
                first.factKind)
        header.sourceId =
            strings.CloneStr(first.sourceId)
        header.sourceCid =
            strings.CloneStr(first.sourceCid)
        header.factKind =
            strings.CloneStr(first.factKind)
        var partition =
            merkle_artifacts.CsgCoreMerklePartitionFactsEncode(
                header, facts)
        if !partition.ok:
            error =
                csgBuilderCat(
                    "merkle_builder_partition ",
                    partition.error)
            return false
        let membership =
            csgBuilderMembership(partition)
        if !membership.ok:
            rawbytes.BytesFree(partition.bytes)
            error =
                csgBuilderCat(
                    "merkle_builder_membership ",
                    membership.error)
            return false
        let manifestPartition =
            csgBuilderManifestPartition(
                partition, membership)
        add(partitions, partition)
        add(memberships, membership)
        add(
            manifestPartitions,
            manifestPartition)
        at = finish
    return true

@borrows
fn csgBuilderBuildPartitions(
        entries: csgBuilderFactEntry[],
        out: var CsgCoreMerkleBuilderResult):
        bool =
    var error: str
    if !csgBuilderBuildPartitionsInto(
           entries,
           out.partitions,
           out.memberships,
           out.manifest.partitions,
           error):
        csgBuilderSetError(out, error)
        return false
    return true

fn csgBuilderReleaseNodeSegment(
        segment: var
            merkle_store_codec.CsgCoreMerkleNodeSegmentResult) =
    rawbytes.BytesFree(segment.bytes)
    segment =
        merkle_store_codec.CsgCoreMerkleNodeSegmentResult()

fn csgBuilderFreeNodeSegments(
        segments: var
            merkle_store_codec.CsgCoreMerkleNodeSegmentResult[]) =
    for i in 0..<segments.len:
        csgBuilderReleaseNodeSegment(segments[i])
    segments = []

@borrows
fn csgBuilderCloneNode(
        node: merkle_dag.CsgCoreMerkleNodeRecord):
        merkle_dag.CsgCoreMerkleNodeRecord =
    var out: merkle_dag.CsgCoreMerkleNodeRecord
    out.kind = node.kind
    out.count = node.count
    out.splitBit = node.splitBit
    out.hash = node.hash
    out.key = strings.CloneStr(node.key)
    out.keyHash = node.keyHash
    out.factHash = node.factHash
    out.leftCount = node.leftCount
    out.leftHash = node.leftHash
    out.rightCount = node.rightCount
    out.rightHash = node.rightHash
    return out

@borrows
fn csgBuilderCloneNodeSegment(
        source:
            merkle_store_codec.CsgCoreMerkleNodeSegmentResult,
        out: var
            merkle_store_codec.CsgCoreMerkleNodeSegmentResult,
        error: var str): bool =
    let byteLength = rawbytes.BytesLen(source.bytes)
    if !source.ok ||
       source.nodeCount != source.nodes.len ||
       source.lines.len != source.nodes.len ||
       source.byteCount != byteLength:
        error =
            "merkle_builder_node_segment_clone_source_invalid"
        return false
    out.ok = source.ok
    out.error = strings.CloneStr(source.error)
    out.cid = strings.CloneStr(source.cid)
    out.nodeCount = source.nodeCount
    out.byteCount = source.byteCount
    for i in 0..<source.lines.len:
        add(out.lines, strings.CloneStr(source.lines[i]))
    for i in 0..<source.nodes.len:
        add(
            out.nodes,
            csgBuilderCloneNode(source.nodes[i]))
    out.bytes = rawbytes.BytesAlloc(byteLength)
    if rawbytes.BytesLen(out.bytes) != byteLength:
        error =
            "merkle_builder_node_segment_clone_allocation_failed"
        csgBuilderReleaseNodeSegment(out)
        return false
    rawbytes.BytesCopyInto(out.bytes, 0, source.bytes)
    return true

@borrows
fn csgBuilderBuildNodeSegments(
        dag: merkle_dag.CsgCoreMerkleDag,
        out: var CsgCoreMerkleBuilderResult):
        bool =
    var segments: merkle_store_codec.CsgCoreMerkleNodeSegmentResult[]
    var nodeCids: str[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        var nodeError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, nodeIndex, nodeError)
        if nodeError.len > 0:
            csgBuilderSetError(
                out,
                csgBuilderCat(
                    "merkle_builder_node_projection ",
                    nodeError))
            csgBuilderFreeNodeSegments(segments)
            return false
        let segment =
            merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
                [node])
        if !segment.ok:
            csgBuilderSetError(
                out,
                csgBuilderCat(
                    "merkle_builder_node_segment ",
                    segment.error))
            csgBuilderFreeNodeSegments(segments)
            return false
        add(
            nodeCids,
            merkle_dag.CsgCoreMerkleNodeRecordCid(node))
        add(segments, segment)
    let order = csgBuilderStringOrder(nodeCids)
    for i in 1..<order.len:
        if nodeCids[order[i - 1]] ==
           nodeCids[order[i]]:
            csgBuilderSetError(
                out,
                "merkle_builder_node_segment_duplicate")
            csgBuilderFreeNodeSegments(segments)
            return false
    for i in 0..<order.len:
        var sortedSegment: merkle_store_codec.CsgCoreMerkleNodeSegmentResult
        var cloneError: str
        if !csgBuilderCloneNodeSegment(
               segments[order[i]],
               sortedSegment,
               cloneError):
            csgBuilderSetError(out, cloneError)
            csgBuilderFreeNodeSegments(out.nodeSegments)
            csgBuilderFreeNodeSegments(segments)
            return false
        add(out.nodeSegments, sortedSegment)
    csgBuilderFreeNodeSegments(segments)
    out.manifest.nodeCount = out.nodeSegments.len
    return true

@borrows
fn csgBuilderDependencyCargoFail(
        error: str):
        CsgCoreMerkleBuilderDependencyCargo =
    var out: CsgCoreMerkleBuilderDependencyCargo
    out.error = strings.CloneStr(error)
    return out

fn CsgCoreMerkleBuilderDependencyCargoFree(
        out: var CsgCoreMerkleBuilderDependencyCargo) =
    for i in 0..<out.consumerShards.len:
        rawbytes.BytesFree(out.consumerShards[i].bytes)
    for i in 0..<out.providerShards.len:
        rawbytes.BytesFree(out.providerShards[i].bytes)
    out = CsgCoreMerkleBuilderDependencyCargo()

@borrows
fn csgBuilderPartitionSourceIds(
        partitions:
            merkle_manifest.CsgCoreMerklePartitionRecord[]):
        str[] =
    var raw: str[]
    for i in 0..<partitions.len:
        add(raw, strings.CloneStr(partitions[i].sourceId))
    let order = csgBuilderStringOrder(raw)
    var out: str[]
    for i in 0..<order.len:
        let source = raw[order[i]]
        if out.len == 0 ||
           out[out.len - 1] != source:
            add(out, strings.CloneStr(source))
    return out

@borrows
fn csgBuilderDependencyDescriptor(
        shard:
            merkle_artifacts.CsgCoreMerkleDependencyShardResult):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(shard.header.shardKey)
    out.cid = strings.CloneStr(shard.cid)
    out.root = strings.CloneStr(shard.shardRoot)
    out.entryCount = shard.entryCount
    return out

@borrows
fn CsgCoreMerkleBuilderEncodeDependencyCargo(
        profileSetCid: str,
        partitions:
            merkle_manifest.CsgCoreMerklePartitionRecord[],
        dependencies:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        CsgCoreMerkleBuilderDependencyCargo =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           profileSetCid):
        return csgBuilderDependencyCargoFail(
            "merkle_builder_dependency_profile_set_cid_invalid")
    let sourceIds =
        csgBuilderPartitionSourceIds(partitions)
    var subgraphKeys: str[]
    for i in 0..<partitions.len:
        add(
            subgraphKeys,
            csgBuilderSourceSubgraphKey(
                partitions[i].sourceId,
                partitions[i].factsRoot))
    let sourceOrder = csgBuilderStringOrder(sourceIds)
    let subgraphOrder =
        csgBuilderStringOrder(subgraphKeys)
    let order =
        csgBuilderDependencyOrder(dependencies)
    var sorted: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    for i in 0..<order.len:
        let record = dependencies[order[i]]
        if !csgBuilderBinaryContains(
               sourceIds,
               sourceOrder,
               record.consumerSource) ||
           !csgBuilderBinaryContains(
               sourceIds,
               sourceOrder,
               record.providerSource):
            return csgBuilderDependencyCargoFail(
                "merkle_builder_dependency_source_missing")
        let providerKey =
            csgBuilderSourceSubgraphKey(
                record.providerSource,
                record.providerSubgraphCid)
        if !csgBuilderBinaryContains(
               subgraphKeys,
               subgraphOrder,
               providerKey):
            return csgBuilderDependencyCargoFail(
                "merkle_builder_dependency_subgraph_mismatch")
        if i > 0:
            let previous = dependencies[order[i - 1]]
            if previous.consumerSource ==
                   record.consumerSource &&
               previous.providerSource ==
                   record.providerSource &&
               previous.selector == record.selector:
                if previous.providerSubgraphCid ==
                   record.providerSubgraphCid:
                    return csgBuilderDependencyCargoFail(
                        "merkle_builder_dependency_duplicate")
                return csgBuilderDependencyCargoFail(
                    "merkle_builder_dependency_identity_conflict")
        add(sorted, csgBuilderCloneDependency(record))

    var out: CsgCoreMerkleBuilderDependencyCargo
    for sourceIndex in 0..<sourceIds.len:
        let sourceId = sourceIds[sourceIndex]
        var consumerRecords: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
        var providerRecords: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
        for recordIndex in 0..<sorted.len:
            if sorted[recordIndex].consumerSource ==
               sourceId:
                add(
                    consumerRecords,
                    csgBuilderCloneDependency(
                        sorted[recordIndex]))
            if sorted[recordIndex].providerSource ==
               sourceId:
                add(
                    providerRecords,
                    csgBuilderCloneDependency(
                        sorted[recordIndex]))
        var consumerHeader: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
        consumerHeader.profileSetCid =
            strings.CloneStr(profileSetCid)
        consumerHeader.projection =
            merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection()
        consumerHeader.shardKey = strings.CloneStr(sourceId)
        let consumerShard =
            merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                consumerHeader, consumerRecords)
        if !consumerShard.ok:
            let failure =
                csgBuilderCat(
                    "merkle_builder_dependency_consumer_shard ",
                    consumerShard.error)
            CsgCoreMerkleBuilderDependencyCargoFree(out)
            return csgBuilderDependencyCargoFail(failure)
        let consumerDescriptor =
            csgBuilderDependencyDescriptor(consumerShard)
        add(out.consumerShards, consumerShard)
        add(out.consumerDescriptors, consumerDescriptor)

        var providerHeader: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
        providerHeader.profileSetCid =
            strings.CloneStr(profileSetCid)
        providerHeader.projection =
            merkle_artifacts.CsgCoreMerkleDependencyProviderProjection()
        providerHeader.shardKey = strings.CloneStr(sourceId)
        let providerShard =
            merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                providerHeader, providerRecords)
        if !providerShard.ok:
            let failure =
                csgBuilderCat(
                    "merkle_builder_dependency_provider_shard ",
                    providerShard.error)
            CsgCoreMerkleBuilderDependencyCargoFree(out)
            return csgBuilderDependencyCargoFail(failure)
        let providerDescriptor =
            csgBuilderDependencyDescriptor(providerShard)
        add(out.providerShards, providerShard)
        add(out.providerDescriptors, providerDescriptor)
    out.consumerRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
            out.consumerDescriptors)
    out.providerRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyProviderShardKind(),
            out.providerDescriptors)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.consumerRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.providerRoot):
        CsgCoreMerkleBuilderDependencyCargoFree(out)
        return csgBuilderDependencyCargoFail(
            "merkle_builder_dependency_descriptor_root_invalid")
    out.dependencyCount = sorted.len
    out.ok = true
    return out

@borrows
fn csgBuilderBuildDependencies(
        dependencies:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        out: var CsgCoreMerkleBuilderResult):
        bool =
    out.dependencyCargo =
        CsgCoreMerkleBuilderEncodeDependencyCargo(
            out.profileSetCid,
            out.manifest.partitions,
            dependencies)
    if !out.dependencyCargo.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_dependency ",
                out.dependencyCargo.error))
        return false
    return true

@borrows
fn csgBuilderCollectQueryRecords(
        entries: csgBuilderFactEntry[],
        memberships:
            merkle_artifacts.CsgCoreMerkleMembershipResult[],
        sorted: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        error: var str): bool =
    var records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    var keys: str[]
    for i in 0..<entries.len:
        add(keys, strings.CloneStr(entries[i].factKey))
    let factOrder = csgBuilderStringOrder(keys)
    var membershipKeys: str[]
    var membershipPartitions: int32[]
    var membershipRecords: int32[]
    for partitionIndex in 0..<memberships.len:
        for recordIndex in
                0..<memberships[
                    partitionIndex].records.len:
            add(
                membershipKeys,
                strings.CloneStr(
                    memberships[
                        partitionIndex].records[
                            recordIndex].factKey))
            add(membershipPartitions, partitionIndex)
            add(membershipRecords, recordIndex)
    let membershipOrder =
        csgBuilderStringOrder(membershipKeys)
    if factOrder.len != membershipOrder.len:
        error =
            "merkle_builder_query_membership_count_mismatch"
        return false
    for i in 0..<factOrder.len:
        let entry = entries[factOrder[i]]
        let membershipIndex = membershipOrder[i]
        if entry.factKey !=
           membershipKeys[membershipIndex]:
            error =
                "merkle_builder_query_membership_missing"
            return false
        let membership =
            memberships[
                membershipPartitions[
                    membershipIndex]].records[
                        membershipRecords[
                            membershipIndex]]
        if !csgBuilderAppendFactQueries(
               records, entry.fact, membership):
            error =
                "merkle_builder_query_fact_invalid"
            return false
    let order = csgBuilderQueryOrder(records)
    for i in 0..<order.len:
        if i > 0:
            let previous = share(records[order[i - 1]])
            let current = share(records[order[i]])
            if previous.indexKind == current.indexKind &&
               previous.term == current.term &&
               previous.factKey == current.factKey &&
               previous.partitionId ==
                   current.partitionId &&
               previous.sourceId == current.sourceId:
                error =
                    "merkle_builder_query_duplicate"
                return false
        add(
            sorted,
            csgBuilderCloneQuery(
                records[order[i]]))
    return true

@borrows
fn csgBuilderQueryCargoFail(
        error: str):
        CsgCoreMerkleBuilderQueryCargo =
    var out: CsgCoreMerkleBuilderQueryCargo
    out.error = strings.CloneStr(error)
    return out

fn CsgCoreMerkleBuilderQueryCargoFree(
        out: var CsgCoreMerkleBuilderQueryCargo) =
    for i in 0..<out.shards.len:
        rawbytes.BytesFree(out.shards[i].bytes)
    out = CsgCoreMerkleBuilderQueryCargo()

@borrows
fn csgBuilderQueryDescriptor(
        shard:
            merkle_artifacts.CsgCoreMerkleQueryShardResult):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(shard.header.bucket)
    out.cid = strings.CloneStr(shard.cid)
    out.root = strings.CloneStr(shard.shardRoot)
    out.entryCount = shard.entryCount
    return out

@borrows
fn CsgCoreMerkleBuilderEncodeQueryCargo(
        profileSetCid: str,
        records:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]):
        CsgCoreMerkleBuilderQueryCargo =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           profileSetCid):
        return csgBuilderQueryCargoFail(
            "merkle_builder_query_profile_set_cid_invalid")
    let order = csgBuilderQueryOrder(records)
    var sorted: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    for i in 0..<order.len:
        if i > 0:
            let previous = records[order[i - 1]]
            let current = records[order[i]]
            if previous.indexKind == current.indexKind &&
               previous.term == current.term &&
               previous.factKey == current.factKey &&
               previous.partitionId ==
                   current.partitionId &&
               previous.sourceId == current.sourceId:
                return csgBuilderQueryCargoFail(
                    "merkle_builder_query_duplicate")
        add(
            sorted,
            csgBuilderCloneQuery(records[order[i]]))
    var out: CsgCoreMerkleBuilderQueryCargo
    # Bucketize once. Recomputing a record bucket inside the 256-bucket
    # loop costs 256 sha256 digests per record.
    var recordBuckets: str[]
    for recordIndex in 0..<sorted.len:
        add(
            recordBuckets,
            merkle_artifacts.CsgCoreMerkleQueryBucket(
                sorted[recordIndex].indexKind,
                sorted[recordIndex].term))
    for bucketIndex in
            0..<merkle_artifacts.CsgCoreMerkleQueryBucketCount():
        let bucket =
            merkle_artifacts.CsgCoreMerkleQueryBucketName(
                bucketIndex)
        var bucketRecords: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
        for recordIndex in 0..<sorted.len:
            if recordBuckets[recordIndex] == bucket:
                add(
                    bucketRecords,
                    csgBuilderCloneQuery(
                        sorted[recordIndex]))
        # An empty bucket has no shard or descriptor. Absence is the
        # canonical empty shard for query, diff and closure validation.
        if bucketRecords.len == 0:
            continue
        var header: merkle_artifacts.CsgCoreMerkleQueryShardHeader
        header.profileSetCid =
            strings.CloneStr(profileSetCid)
        header.bucket = strings.CloneStr(bucket)
        let shard =
            merkle_artifacts.CsgCoreMerkleQueryShardEncode(
                header, bucketRecords)
        if !shard.ok:
            let failure =
                csgBuilderCat(
                    "merkle_builder_query_shard ",
                    shard.error)
            CsgCoreMerkleBuilderQueryCargoFree(out)
            return csgBuilderQueryCargoFail(failure)
        let descriptor = csgBuilderQueryDescriptor(shard)
        add(out.shards, shard)
        add(out.descriptors, descriptor)
    out.root =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            out.descriptors)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.root):
        CsgCoreMerkleBuilderQueryCargoFree(out)
        return csgBuilderQueryCargoFail(
            "merkle_builder_query_descriptor_root_invalid")
    out.entryCount = sorted.len
    out.ok = true
    return out

@borrows
fn csgBuilderBuildQueryIndex(
        entries: csgBuilderFactEntry[],
        out: var CsgCoreMerkleBuilderResult):
        bool =
    var records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    var error: str
    if !csgBuilderCollectQueryRecords(
           entries, out.memberships, records, error):
        csgBuilderSetError(out, error)
        return false
    out.queryCargo =
        CsgCoreMerkleBuilderEncodeQueryCargo(
            out.profileSetCid, records)
    if !out.queryCargo.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_query_index ",
                out.queryCargo.error))
        return false
    return true

@borrows
fn csgBuilderBuildSummary(
        out: var CsgCoreMerkleBuilderResult):
        bool =
    var header: merkle_artifacts.CsgCoreMerkleSummaryHeader
    header.standard = strings.CloneStr(out.standard)
    header.profiles =
        validator.CsgCoreProfilesClone(out.profiles)
    header.profileSetCid =
        strings.CloneStr(out.profileSetCid)
    header.complete = true
    header.schemaCid = strings.CloneStr(out.schemaCid)
    header.factsRoot = strings.CloneStr(out.factsRoot)
    header.dagRootCid =
        strings.CloneStr(out.dagRootCid)
    header.factCount = out.factCount
    header.nodeCount = out.manifest.nodeCount
    header.partitionRoot =
        strings.CloneStr(out.manifest.partitionRoot)
    header.partitionCount =
        out.manifest.partitions.len
    header.dependencyConsumerRoot =
        strings.CloneStr(
            out.dependencyCargo.consumerRoot)
    header.dependencyProviderRoot =
        strings.CloneStr(
            out.dependencyCargo.providerRoot)
    header.dependencyCount =
        out.dependencyCargo.dependencyCount
    header.dependencyConsumerShardCount =
        out.dependencyCargo.consumerShards.len
    header.dependencyProviderShardCount =
        out.dependencyCargo.providerShards.len
    header.queryShardRoot =
        strings.CloneStr(out.queryCargo.root)
    header.queryIndexCount =
        out.queryCargo.entryCount
    header.queryShardCount =
        out.queryCargo.shards.len
    out.summary =
        merkle_artifacts.CsgCoreMerkleSummaryEncode(
            header)
    if !out.summary.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_summary ",
                out.summary.error))
        return false
    return true

@borrows
fn csgBuilderBindCanonicalCsgcDirectory(
        canonicalFacts: str[],
        out: var CsgCoreMerkleBuilderResult): bool =
    var encoded =
        csgc.CsgCoreCsgcEncodeVerifiedLines(
            canonicalFacts)
    if !encoded.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_csgc ",
                encoded.error))
        return false
    if encoded.factCount != out.factCount ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           encoded.claimedDirectoryCid):
        rawbytes.BytesFree(encoded.bytes)
        csgBuilderSetError(
            out,
            "merkle_builder_csgc_directory_binding_failed")
        return false
    let bindingError =
        merkle_manifest.CsgCoreMerkleManifestBindCanonicalCsgcDirectory(
            out.manifest,
            encoded.bytes)
    if bindingError.len > 0 ||
       out.manifest.csgcDirectoryCid !=
           encoded.claimedDirectoryCid ||
       out.manifest.csgcByteCount !=
           rawbytes.BytesLen(encoded.bytes) ||
       out.manifest.csgcObjectCid !=
           merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
               encoded.bytes):
        rawbytes.BytesFree(encoded.bytes)
        csgBuilderSetError(
            out,
            bindingError.len > 0 ?
                bindingError :
                "merkle_builder_csgc_object_binding_failed")
        return false
    rawbytes.BytesFree(encoded.bytes)
    return true

@borrows
fn csgBuilderFinishManifest(
        canonicalFacts: str[],
        out: var CsgCoreMerkleBuilderResult):
        bool =
    out.manifest.standard =
        strings.CloneStr(out.standard)
    out.manifest.profiles =
        validator.CsgCoreProfilesClone(out.profiles)
    out.manifest.profileSetCid =
        strings.CloneStr(out.profileSetCid)
    out.manifest.complete = true
    out.manifest.schemaCid =
        strings.CloneStr(out.schemaCid)
    out.manifest.factsRoot =
        strings.CloneStr(out.factsRoot)
    out.manifest.dagRootCid =
        strings.CloneStr(out.dagRootCid)
    out.manifest.factCount = out.factCount
    out.manifest.dependencyConsumerShards =
        out.dependencyCargo.consumerDescriptors
    out.manifest.dependencyConsumerRoot =
        strings.CloneStr(
            out.dependencyCargo.consumerRoot)
    out.manifest.dependencyProviderShards =
        out.dependencyCargo.providerDescriptors
    out.manifest.dependencyProviderRoot =
        strings.CloneStr(
            out.dependencyCargo.providerRoot)
    out.manifest.dependencyCount =
        out.dependencyCargo.dependencyCount
    out.manifest.summaryCid =
        strings.CloneStr(out.summary.cid)
    out.manifest.queryShards =
        out.queryCargo.descriptors
    out.manifest.queryShardRoot =
        strings.CloneStr(out.queryCargo.root)
    out.manifest.queryIndexCount =
        out.queryCargo.entryCount
    if !csgBuilderBindCanonicalCsgcDirectory(
           canonicalFacts, out):
        return false
    out.manifestArtifact =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            out.manifest)
    if !out.manifestArtifact.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_manifest ",
                out.manifestArtifact.error))
        return false
    return true

@borrows
fn csgBuilderSelfAdmit(
        out: var CsgCoreMerkleBuilderResult):
        bool =
    var artifacts: merkle_admission.CsgCoreMerkleAdmissionArtifacts
    for i in 0..<out.partitions.len:
        add(
            artifacts.partitionBytes,
            out.partitions[i].bytes)
        add(
            artifacts.membershipBytes,
            out.memberships[i].bytes)
    for i in 0..<out.nodeSegments.len:
        add(
            artifacts.nodeSegmentBytes,
            out.nodeSegments[i].bytes)
    for i in 0..<out.dependencyCargo.consumerShards.len:
        add(
            artifacts.dependencyConsumerShardBytes,
            out.dependencyCargo.consumerShards[i].bytes)
    for i in 0..<out.dependencyCargo.providerShards.len:
        add(
            artifacts.dependencyProviderShardBytes,
            out.dependencyCargo.providerShards[i].bytes)
    artifacts.summaryBytes = out.summary.bytes
    for i in 0..<out.queryCargo.shards.len:
        add(
            artifacts.queryShardBytes,
            out.queryCargo.shards[i].bytes)
    out.admission =
        merkle_admission.CsgCoreMerkleAdmissionVerify(
            out.manifest, artifacts)
    if !out.admission.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_admission ",
                out.admission.error))
        return false
    return true

@borrows
fn CsgCoreMerkleBuilderBuildLocal(
        sources: CsgCoreMerkleBuilderSource[]):
        CsgCoreMerkleBuilderLocalResult =
    var out: CsgCoreMerkleBuilderLocalResult
    var entries: csgBuilderFactEntry[]
    var error: str
    if !csgBuilderPrepareLocalEntries(
           sources, entries, error):
        out.error = strings.CloneStr(error)
        return out
    if !csgBuilderBuildPartitionsInto(
           entries,
           out.partitions,
           out.memberships,
           out.manifestPartitions,
           error):
        let failure = strings.CloneStr(error)
        for i in 0..<out.partitions.len:
            rawbytes.BytesFree(
                out.partitions[i].bytes)
        for i in 0..<out.memberships.len:
            rawbytes.BytesFree(
                out.memberships[i].bytes)
        out = CsgCoreMerkleBuilderLocalResult()
        out.error = failure
        return out
    if !csgBuilderCollectQueryRecords(
           entries,
           out.memberships,
           out.queryRecords,
           error):
        let failure = strings.CloneStr(error)
        for i in 0..<out.partitions.len:
            rawbytes.BytesFree(
                out.partitions[i].bytes)
        for i in 0..<out.memberships.len:
            rawbytes.BytesFree(
                out.memberships[i].bytes)
        out = CsgCoreMerkleBuilderLocalResult()
        out.error = failure
        return out
    out.factCount = entries.len
    out.ok = true
    return out

fn CsgCoreMerkleBuilderLocalFree(
        out: var CsgCoreMerkleBuilderLocalResult) =
    for i in 0..<out.partitions.len:
        rawbytes.BytesFree(out.partitions[i].bytes)
    for i in 0..<out.memberships.len:
        rawbytes.BytesFree(out.memberships[i].bytes)
    out = CsgCoreMerkleBuilderLocalResult()

@borrows
fn CsgCoreMerkleBuildClosure(
        standard: str,
        profiles: str[],
        sources: CsgCoreMerkleBuilderSource[],
        dependencies:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        CsgCoreMerkleBuilderResult =
    var out: CsgCoreMerkleBuilderResult
    var entries: csgBuilderFactEntry[]
    var canonicalFacts: str[]
    var schemaLine: str
    var globalDag: merkle_dag.CsgCoreMerkleDag
    var error: str
    if !csgBuilderPrepareEntries(
           standard,
           profiles,
           sources,
           entries,
           canonicalFacts,
           schemaLine,
           globalDag,
           error):
        csgBuilderSetError(out, error)
        return out
    if !globalDag.ok:
        csgBuilderSetError(
            out,
            csgBuilderCat(
                "merkle_builder_global_dag ",
                globalDag.error))
        return out
    if globalDag.standard != standard ||
       !validator.CsgCoreProfilesEqual(
           globalDag.profiles, profiles) ||
       globalDag.schemaNamespace !=
           csgBuilderSchemaNamespace:
        csgBuilderSetError(
            out,
            "merkle_builder_global_binding_mismatch")
        return out
    out.standard = strings.CloneStr(globalDag.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(
            globalDag.profiles)
    out.profileSetCid =
        validator.CsgCoreProfileSetCid(
            globalDag.profiles)
    out.schemaCid =
        strings.CloneStr(globalDag.schemaCid)
    if globalDag.factCount != canonicalFacts.len:
        csgBuilderSetError(
            out,
            "merkle_builder_global_fact_count_mismatch")
        return out
    if globalDag.factsRoot.len == 0:
        csgBuilderSetError(
            out,
            "merkle_builder_global_facts_root_unbound")
        return out
    out.factsRoot =
        strings.CloneStr(globalDag.factsRoot)
    out.dagRootCid =
        merkle_dag.CsgCoreMerkleDagRootCid(
            globalDag)
    out.factCount = globalDag.factCount

    if !csgBuilderBuildPartitions(entries, out):
        return out
    if !csgBuilderBuildNodeSegments(globalDag, out):
        return out
    out.manifest.partitionRoot =
        merkle_manifest.CsgCoreMerklePartitionRoot(
            out.manifest.partitions)
    if !csgBuilderBuildDependencies(
           dependencies, out):
        return out
    if !csgBuilderBuildQueryIndex(entries, out):
        return out
    if !csgBuilderBuildSummary(out):
        return out
    if !csgBuilderFinishManifest(
           canonicalFacts, out):
        return out
    if !csgBuilderSelfAdmit(out):
        return out
    out.ok = true
    return out

fn CsgCoreMerkleBuilderFree(
        out: var CsgCoreMerkleBuilderResult) =
    for i in 0..<out.partitions.len:
        rawbytes.BytesFree(out.partitions[i].bytes)
    for i in 0..<out.memberships.len:
        rawbytes.BytesFree(out.memberships[i].bytes)
    csgBuilderFreeNodeSegments(out.nodeSegments)
    CsgCoreMerkleBuilderDependencyCargoFree(
        out.dependencyCargo)
    CsgCoreMerkleBuilderQueryCargoFree(
        out.queryCargo)
    rawbytes.BytesFree(out.summary.bytes)
    rawbytes.BytesFree(out.manifestArtifact.bytes)
    out = CsgCoreMerkleBuilderResult()
