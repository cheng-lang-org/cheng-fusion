fn nativeObjectParseDebugRelocation(
        line: str,
        out: var NativeObjectDebugRelocation): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    var kind: str
    if !nativeObjectJsonString(parsed.value, "kind", kind) ||
       kind != NativeObjectDebugRelocationKind ||
       !nativeObjectJsonNonnegativeInt32(
           parsed.value, "ordinal", out.ordinal) ||
       !nativeObjectJsonNonnegativeInt32(
           parsed.value,
           "sectionByteOffset",
           out.sectionByteOffset) ||
       !nativeObjectJsonInt32(
           parsed.value, "sectionKind", out.sectionKind) ||
