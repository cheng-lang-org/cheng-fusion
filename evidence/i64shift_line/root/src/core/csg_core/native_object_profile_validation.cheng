    return Fmt"{{\"id\":\"native-object-debug-relocation-{reloc.ordinal}\",\"kind\":\"csg_dialect::native::object_debug_relocation\",\"ordinal\":{reloc.ordinal},\"sectionByteOffset\":{reloc.sectionByteOffset},\"sectionKind\":{reloc.sectionKind},\"targetAddend\":{reloc.targetAddend},\"targetSymbolIndex\":{reloc.targetSymbolIndex},\"targetSymbolName\":{canonical.CsgCoreJsonQuote(reloc.targetSymbolName)},\"targetTextByteStart\":{reloc.targetTextByteStart}}}"

