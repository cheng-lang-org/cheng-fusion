fn nativeObjectLineIndexes(count: int32): int32[] =
    var out: int32[]
    setLen(out, count)
    for index in 0..<count:
        out[index] = -1
    return out

@borrows
fn nativeObjectIndexesComplete(indexes: var int32[]): bool =
    for index in 0..<indexes.len:
        if indexes[index] < 0:
            return false
    return true

@borrows
fn nativeObjectStoreChunkIndex(
        lineIndex: int32,
        chunk: var NativeObjectSectionChunk,
        section: str,
        byteCount: int32,
        chunkCount: int32,
        indexes: var int32[]): bool =
    if chunk.section != section ||
       chunk.ordinal < 0 || chunk.ordinal >= chunkCount ||
       indexes.len != chunkCount ||
       indexes[chunk.ordinal] >= 0:
        return false
    let expectedOffset = chunk.ordinal * NativeObjectChunkBytes
    var expectedCount = byteCount - expectedOffset
    if expectedCount > NativeObjectChunkBytes:
        expectedCount = NativeObjectChunkBytes
    if chunk.offset != expectedOffset ||
       chunk.byteCount != expectedCount ||
       !nativeObjectBase64Valid(
           chunk.payloadBase64, chunk.byteCount):
        return false
    indexes[chunk.ordinal] = lineIndex
    return true

@borrows
fn nativeObjectDigestHex(
        digest: rawbytes.Bytes,
        out: var str): bool =
    let parsed = layout.FixedBytes32FromBytes(digest)
    if IsErr(parsed):
        return false
    out = strings.ConcatStr(
        "sha256:", layout.FixedBytes32Hex(Value(parsed)))
    return true

@borrows
fn nativeObjectHashSection(
        lines: str[],
        indexes: int32[],
        expectedHash: str,
        chunkBuffer: var rawbytes.Bytes,
        outError: var str): bool =
    var state = sha256.Sha256TwoPartStateInit()
    for ordinal in 0..<indexes.len:
        var chunk: NativeObjectSectionChunk
        if indexes[ordinal] < 0 ||
           !nativeObjectParseSectionChunk(
               lines[indexes[ordinal]], chunk) ||
           !nativeObjectBase64DecodeInto(
               chunk.payloadBase64,
               chunkBuffer,
               chunk.byteCount):
            sha256.Sha256TwoPartStateRelease(state)
            outError = "native_object_profile_section_decode_invalid"
            return false
        let view =
            rawbytes.BytesView(
                chunkBuffer.data, chunk.byteCount)
        sha256.Sha256TwoPartUpdate(state, view)
    var digest = sha256.Sha256TwoPartFinish(state)
    var actualHash: str
    let digestOk = nativeObjectDigestHex(digest, actualHash)
    rawbytes.BytesFree(digest)
    if !digestOk:
        outError = "native_object_profile_section_digest_invalid"
        return false
    if actualHash != expectedHash:
        outError = "native_object_profile_section_hash_mismatch"
        return false
    return true

@borrows
fn nativeObjectSymbolRangeValid(
        manifest: var NativeObjectManifest,
        symbol: NativeObjectSymbol): bool =
    if len(symbol.name) <= 0:
        return false
    if symbol.undefined:
        return symbol.sectionIndex == -1 && symbol.global &&
            symbol.offset == int64(0) &&
            symbol.size == int64(0)
    if symbol.offset < int64(0) || symbol.size < int64(0):
        return false
    if symbol.sectionIndex == 0:
        return symbol.offset <= int64(manifest.textByteCount) &&
            symbol.size <=
                int64(manifest.textByteCount) - symbol.offset
    if symbol.sectionIndex != 1 ||
       manifest.dataByteCount <= 0:
        return false
    var dataBase =
        ((int64(manifest.textByteCount) + int64(7)) /
         int64(8)) * int64(8)
    if manifest.objectFormat == "coff":
        dataBase = int64(0)
    if symbol.offset < dataBase:
        return false
    let relativeOffset = symbol.offset - dataBase
    return relativeOffset <= int64(manifest.dataByteCount) &&
        symbol.size <=
            int64(manifest.dataByteCount) - relativeOffset

fn nativeObjectRelocationWidth(kind: int32): int64 =
    if kind == 1:
        return int64(8)
    if kind == 0 || kind == 2 || kind == 3 ||
       kind == 4 || kind == 5 || kind == 6:
        return int64(4)
    return int64(0)

fn nativeObjectRelocationPcRelative(kind: int32): bool =
    return kind == 2 || kind == 3 ||
        kind == 5 || kind == 6

fn nativeObjectRelocationNeedsAlignment(kind: int32): bool =
    return kind == 2 || kind == 3 ||
        kind == 4 || kind == 6

@borrows
fn nativeObjectRelocationSupported(
        manifest: var NativeObjectManifest,
        kind: int32): bool =
    if manifest.objectFormat == "macho":
        return kind == 1 || kind == 2 ||
            kind == 3 || kind == 4
    if manifest.objectFormat == "elf" &&
       manifest.targetTriple == "x86_64-unknown-linux-gnu":
        return kind == 0 || kind == 1 ||
            kind == 2 || kind == 5
    if manifest.objectFormat == "elf":
        return kind >= 0 && kind <= 6 && kind != 5
    if manifest.objectFormat == "coff":
        return kind == 0 || kind == 1 || kind == 2
    return false

@borrows
fn nativeObjectValidateSymbols(
        manifest: var NativeObjectManifest,
        symbols: var NativeObjectSymbol[]): str =
    var entrySeen = false
    for symbolIndex in 0..<symbols.len:
        let symbol = symbols[symbolIndex]
        if !nativeObjectSymbolRangeValid(manifest, symbol):
            return "native_object_profile_symbol_range_invalid"
        for previousIndex in 0..<symbolIndex:
            if symbols[previousIndex].name == symbol.name:
                return "native_object_profile_symbol_name_duplicate"
        if symbol.name == manifest.entryFunctionSymbol &&
           !symbol.undefined && symbol.sectionIndex == 0 &&
           symbol.global:
            entrySeen = true
    if !entrySeen:
        return "native_object_profile_entry_function_missing"
    return ""

@borrows
fn nativeObjectValidateRelocations(
        manifest: var NativeObjectManifest,
        symbols: var NativeObjectSymbol[],
        relocs: var NativeObjectRelocation[]): str =
    for relocIndex in 0..<relocs.len:
        let reloc = relocs[relocIndex]
        let width =
            nativeObjectRelocationWidth(reloc.relocationKind)
        if reloc.sectionIndex != 0 ||
           !nativeObjectRelocationSupported(
               manifest, reloc.relocationKind) ||
           width <= int64(0) || reloc.offset < int64(0) ||
           reloc.offset > int64(manifest.textByteCount) - width ||
           reloc.symbolIndex < 0 ||
           reloc.symbolIndex >= symbols.len ||
           reloc.pcRelative !=
               nativeObjectRelocationPcRelative(
                   reloc.relocationKind) ||
           (nativeObjectRelocationNeedsAlignment(
                reloc.relocationKind) &&
            reloc.offset % int64(4) != int64(0)) ||
           ((manifest.objectFormat == "macho" ||
             manifest.objectFormat == "coff") &&
            reloc.addend != int64(0)):
            return "native_object_profile_relocation_invalid"
        for previousIndex in 0..<relocIndex:
            let previous = relocs[previousIndex]
            if previous.sectionIndex == reloc.sectionIndex &&
               previous.offset == reloc.offset:
                return "native_object_profile_relocation_duplicate"
    return ""

@borrows
fn nativeObjectValidateDebugRelocations(
        manifest: var NativeObjectManifest,
        symbols: var NativeObjectSymbol[],
        relocs: var NativeObjectDebugRelocation[]): str =
    if !manifest.debugValid:
        if relocs.len != 0:
            return "native_object_profile_disabled_debug_present"
        return ""
    for relocIndex in 0..<relocs.len:
        let reloc = relocs[relocIndex]
        var sectionLength: int32
        if reloc.sectionKind == 1:
            sectionLength = manifest.debugLineByteCount
        elif reloc.sectionKind == 2:
            sectionLength = manifest.debugInfoByteCount
        else:
            return "native_object_profile_debug_section_invalid"
        if sectionLength < 8 || reloc.sectionByteOffset < 0 ||
           reloc.sectionByteOffset > sectionLength - 8 ||
           reloc.targetSymbolIndex < 0 ||
           reloc.targetSymbolIndex >= symbols.len ||
           reloc.targetAddend < 0:
            return "native_object_profile_debug_relocation_invalid"
        for previousIndex in 0..<relocIndex:
            let previous = relocs[previousIndex]
            if previous.sectionKind == reloc.sectionKind &&
               previous.sectionByteOffset ==
                   reloc.sectionByteOffset:
                return "native_object_profile_debug_relocation_duplicate"
        let target = symbols[reloc.targetSymbolIndex]
        if target.undefined || target.sectionIndex != 0 ||
           target.name != reloc.targetSymbolName ||
           target.offset > int64(2147483647) ||
           target.size > int64(2147483647) ||
           int64(reloc.targetAddend) > target.size ||
           int64(reloc.targetTextByteStart) !=
               target.offset + int64(reloc.targetAddend):
            return "native_object_profile_debug_target_mismatch"
    return ""

@borrows
fn CsgCoreNativeObjectProfileValidate(
        lines: str[]): CsgCoreNativeObjectProfileValidation =
    if lines.len <= 0:
        return nativeObjectValidationFail(
            "native_object_profile_empty")
    var schemaCount: int32
    var manifestCount: int32
    var manifest: NativeObjectManifest
    for lineIndex in 0..<lines.len:
        var kind: str
        if !nativeObjectFactKind(lines[lineIndex], kind):
            return nativeObjectValidationFail(
                nativeObjectIndexedError(
                    "native_object_profile_fact_invalid",
                    lineIndex))
        if kind == "csg.core.schema":
            schemaCount = schemaCount + 1
            if schemaCount > 1:
                return nativeObjectValidationFail(
                    "native_object_profile_schema_duplicate")
            if lines[lineIndex] != NativeObjectSchemaFact:
                return nativeObjectValidationFail(
                    "native_object_profile_schema_non_canonical")
        elif kind == NativeObjectManifestKind:
            manifestCount = manifestCount + 1
            if manifestCount > 1:
                return nativeObjectValidationFail(
                    "native_object_profile_manifest_duplicate")
            if !nativeObjectParseManifest(
                   lines[lineIndex], manifest):
                return nativeObjectValidationFail(
                    "native_object_profile_manifest_invalid")
        elif kind != NativeObjectSectionChunkKind &&
             kind != NativeObjectSymbolKind &&
             kind != NativeObjectRelocationKind &&
             kind != NativeObjectDebugRelocationKind:
            return nativeObjectValidationFail(
                strings.ConcatStr(
                    "native_object_profile_kind_unsupported:",
                    kind))
    if schemaCount != 1:
        return nativeObjectValidationFail(
            "native_object_profile_schema_missing")
    if manifestCount != 1:
        return nativeObjectValidationFail(
            "native_object_profile_manifest_missing")
    let expectedFactCount =
        int64(2) + int64(manifest.textChunkCount) +
        int64(manifest.dataChunkCount) +
        int64(manifest.debugLineChunkCount) +
        int64(manifest.debugInfoChunkCount) +
        int64(manifest.debugAbbrevChunkCount) +
        int64(manifest.symbolCount) +
        int64(manifest.relocationCount) +
        int64(manifest.debugRelocationCount)
    if expectedFactCount != int64(lines.len):
        return nativeObjectValidationFail(
            "native_object_profile_manifest_count_mismatch")
    var textIndexes =
        nativeObjectLineIndexes(manifest.textChunkCount)
    var dataIndexes =
        nativeObjectLineIndexes(manifest.dataChunkCount)
    var debugLineIndexes =
        nativeObjectLineIndexes(manifest.debugLineChunkCount)
    var debugInfoIndexes =
        nativeObjectLineIndexes(manifest.debugInfoChunkCount)
    var debugAbbrevIndexes =
        nativeObjectLineIndexes(manifest.debugAbbrevChunkCount)
    var symbolIndexes =
        nativeObjectLineIndexes(manifest.symbolCount)
    var relocationIndexes =
        nativeObjectLineIndexes(manifest.relocationCount)
    var debugRelocationIndexes =
        nativeObjectLineIndexes(manifest.debugRelocationCount)
    var symbols: NativeObjectSymbol[]
    var relocs: NativeObjectRelocation[]
    var debugRelocs: NativeObjectDebugRelocation[]
    setLen(symbols, manifest.symbolCount)
    setLen(relocs, manifest.relocationCount)
    setLen(debugRelocs, manifest.debugRelocationCount)
    for lineIndex in 0..<lines.len:
        var kind: str
        if !nativeObjectFactKind(lines[lineIndex], kind):
            return nativeObjectValidationFail(
                "native_object_profile_fact_changed")
        if kind == "csg.core.schema" ||
           kind == NativeObjectManifestKind:
            continue
        if kind == NativeObjectSectionChunkKind:
            var chunk: NativeObjectSectionChunk
            if !nativeObjectParseSectionChunk(
                   lines[lineIndex], chunk):
                return nativeObjectValidationFail(
                    "native_object_profile_section_chunk_invalid")
            var stored = false
            if chunk.section == "text":
                stored = nativeObjectStoreChunkIndex(
                    lineIndex, chunk, "text",
                    manifest.textByteCount,
                    manifest.textChunkCount,
                    textIndexes)
            elif chunk.section == "data":
                stored = nativeObjectStoreChunkIndex(
                    lineIndex, chunk, "data",
                    manifest.dataByteCount,
                    manifest.dataChunkCount,
                    dataIndexes)
            elif chunk.section == "debug_line":
                stored = nativeObjectStoreChunkIndex(
                    lineIndex, chunk, "debug_line",
                    manifest.debugLineByteCount,
                    manifest.debugLineChunkCount,
                    debugLineIndexes)
            elif chunk.section == "debug_info":
                stored = nativeObjectStoreChunkIndex(
                    lineIndex, chunk, "debug_info",
                    manifest.debugInfoByteCount,
                    manifest.debugInfoChunkCount,
                    debugInfoIndexes)
            elif chunk.section == "debug_abbrev":
                stored = nativeObjectStoreChunkIndex(
                    lineIndex, chunk, "debug_abbrev",
                    manifest.debugAbbrevByteCount,
                    manifest.debugAbbrevChunkCount,
                    debugAbbrevIndexes)
            if !stored:
                return nativeObjectValidationFail(
                    "native_object_profile_section_chunk_closure_invalid")
        elif kind == NativeObjectSymbolKind:
            var symbol: NativeObjectSymbol
            if !nativeObjectParseSymbol(
                   lines[lineIndex], symbol) ||
               symbol.ordinal < 0 ||
               symbol.ordinal >= symbols.len ||
               symbolIndexes[symbol.ordinal] >= 0:
                return nativeObjectValidationFail(
                    "native_object_profile_symbol_ordinal_invalid")
            symbolIndexes[symbol.ordinal] = lineIndex
            symbols[symbol.ordinal] = symbol
        elif kind == NativeObjectRelocationKind:
            var reloc: NativeObjectRelocation
            if !nativeObjectParseRelocation(
                   lines[lineIndex], reloc) ||
               reloc.ordinal < 0 ||
               reloc.ordinal >= relocs.len ||
               relocationIndexes[reloc.ordinal] >= 0:
                return nativeObjectValidationFail(
                    "native_object_profile_relocation_ordinal_invalid")
            relocationIndexes[reloc.ordinal] = lineIndex
            relocs[reloc.ordinal] = reloc
        else:
            var debugReloc: NativeObjectDebugRelocation
            if !nativeObjectParseDebugRelocation(
                   lines[lineIndex], debugReloc) ||
               debugReloc.ordinal < 0 ||
               debugReloc.ordinal >= debugRelocs.len ||
               debugRelocationIndexes[debugReloc.ordinal] >= 0:
                return nativeObjectValidationFail(
                    "native_object_profile_debug_relocation_ordinal_invalid")
            debugRelocationIndexes[debugReloc.ordinal] = lineIndex
            debugRelocs[debugReloc.ordinal] = debugReloc
    if !nativeObjectIndexesComplete(textIndexes) ||
       !nativeObjectIndexesComplete(dataIndexes) ||
       !nativeObjectIndexesComplete(debugLineIndexes) ||
       !nativeObjectIndexesComplete(debugInfoIndexes) ||
       !nativeObjectIndexesComplete(debugAbbrevIndexes) ||
       !nativeObjectIndexesComplete(symbolIndexes) ||
       !nativeObjectIndexesComplete(relocationIndexes) ||
       !nativeObjectIndexesComplete(debugRelocationIndexes):
        return nativeObjectValidationFail(
            "native_object_profile_ordinal_hole")
    let symbolError =
        nativeObjectValidateSymbols(manifest, symbols)
    if len(symbolError) > 0:
        return nativeObjectValidationFail(symbolError)
    let relocationError =
        nativeObjectValidateRelocations(
            manifest, symbols, relocs)
    if len(relocationError) > 0:
        return nativeObjectValidationFail(relocationError)
    let debugRelocationError =
        nativeObjectValidateDebugRelocations(
            manifest, symbols, debugRelocs)
    if len(debugRelocationError) > 0:
        return nativeObjectValidationFail(debugRelocationError)
    var chunkBuffer =
        rawbytes.BytesAlloc(NativeObjectChunkBytes)
    if rawbytes.BytesLen(chunkBuffer) != NativeObjectChunkBytes:
        rawbytes.BytesFree(chunkBuffer)
        return nativeObjectValidationFail(
            "native_object_profile_chunk_buffer_allocation_failed")
    var hashError: str
    if !nativeObjectHashSection(
           lines, textIndexes, manifest.textSha256,
           chunkBuffer, hashError) ||
       !nativeObjectHashSection(
           lines, dataIndexes, manifest.dataSha256,
           chunkBuffer, hashError) ||
       !nativeObjectHashSection(
           lines, debugLineIndexes, manifest.debugLineSha256,
           chunkBuffer, hashError) ||
       !nativeObjectHashSection(
           lines, debugInfoIndexes, manifest.debugInfoSha256,
           chunkBuffer, hashError) ||
       !nativeObjectHashSection(
           lines, debugAbbrevIndexes,
           manifest.debugAbbrevSha256,
           chunkBuffer, hashError):
        rawbytes.BytesFree(chunkBuffer)
        return nativeObjectValidationFail(hashError)
    rawbytes.BytesFree(chunkBuffer)
    return nativeObjectValidationOk()
