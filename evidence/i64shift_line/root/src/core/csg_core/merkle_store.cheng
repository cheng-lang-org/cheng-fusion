    csgStoreTerminalRecoveryRegistryStoreRootHashes = []
    csgStoreTerminalRecoveryRegistryBindingCids = []
    csgStoreTerminalRecoveryRegistryLockOwners = []
    csgStoreTerminalJournalRootOwnerNextRow = nil
    csgStoreTerminalJournalRootOwnerRegistryInit = 0
    csgStoreHeadLeaseStates = []
    csgStoreHeadLeaseEpochs = []
    csgStoreHeadLeaseExclusives = []
    csgStoreHeadLeaseAnchorOwned = []
    csgStoreHeadLeaseAnchors = []
    csgStoreHeadLeaseStoreRootHashes = []
    csgStoreHeadLeaseRegistryState = csgStoreHeadLeaseRegistryEmpty
    csgStoreHeadLeaseExclusiveLiveCount = 0
    csgStoreHeadLeaseEpochClock = 0
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return true

# The durable Reaped Ack is the only source of `retireOwner`.  This function
# consumes it before closing the fenced journal root, retires the exact claim
# and capsule rows, clears all row-owned ZRPC cargo, and only then publishes
# provider CloseReady.  ProviderFinalized and ordinary process exit cannot
# reach this edge.
fn ProductionTerminalJournalDrainAfterReapInto(
        journalOwner: int32,
        outExitCode: var int32,
        err: var str): bool =
    outExitCode = -1
    let row = journalOwner - 1
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil ||
       row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalRecoveredRows[row] != 0 ||
       atomic.LoadI32(productionTerminalJournalStates[row]) !=
           ProductionTerminalJournalStateReaped ||
       productionTerminalJournalObservationOwners[row] != -1 ||
       productionTerminalJournalDurableAppendOwners[row] != -1:
        err = "production_terminal_journal_drain_state_invalid"
        return false
    if productionTerminalJournalCloseReadyOwners[row] <= 0:
        var retireOwner = productionTerminalJournalRetireOwners[row]
        productionTerminalJournalRetireOwners[row] = -1
        var closeReadyOwner: int32
        if !system.RuntimeHeldExecTerminalRetireInto(
               retireOwner, closeReadyOwner):
            err = "production_terminal_journal_runtime_retire_failed"
            return false
        if retireOwner != -1 || closeReadyOwner <= 0:
            panic("production terminal journal retire move drift")
        productionTerminalJournalCloseReadyOwners[row] = closeReadyOwner
        closeReadyOwner = -1
    let workloadExitCode = productionTerminalJournalWorkloadExitCodes[row]
    if workloadExitCode < 0 || workloadExitCode > 255:
        err = "production_terminal_journal_drain_exit_invalid"
        return false
    if productionTerminalJournalRootOwnerHandles[row] <= 0:
        err = "production_terminal_journal_drain_root_missing"
        return false
    var rootCloseErr: str
    if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
           productionTerminalJournalRootOwnerHandles[row],
           rootCloseErr):
        err = strings.CloneStr(rootCloseErr)
        return false
    productionTerminalJournalRootOwnerHandles[row] = -1
    if !productionAdmittedClaimAuthorityRetireAfterRuntimeInto(
           productionTerminalJournalDurableClaimOwners[row],
           productionTerminalJournalRuntimeSessions[row],
           err):
        return false
    productionTerminalJournalDurableClaimOwners[row] = -1
    productionTerminalJournalProviderProofOwners[row] = -1
    productionTerminalJournalSessionCids[row] = ""
    productionTerminalJournalClaimReceiptCids[row] = ""
    productionTerminalJournalOwnerClaimReceiptCids[row] = ""
    productionTerminalJournalClaimedRecordReceiptCids[row] = ""
    productionTerminalJournalTerminalReceiptCids[row] = ""
    productionTerminalJournalChildIdentityCids[row] = ""
    productionTerminalJournalFinishedUploadCids[row] = ""
    productionTerminalJournalFinishedRecordReceiptCids[row] = ""
    productionTerminalJournalHeadFenceReceiptCids[row] = ""
    productionTerminalJournalDecisionRecordReceiptCids[row] = ""
    productionTerminalJournalDecisionCanonicalCids[row] = ""
    productionTerminalJournalDecisionCanonicals[row] = ""
    productionTerminalJournalExitObservationReceiptCids[row] = ""
    productionTerminalJournalExitObservedRecordReceiptCids[row] = ""
    productionTerminalJournalReapReceiptCids[row] = ""
    productionTerminalJournalReapedRecordReceiptCids[row] = ""
    productionTerminalJournalProviderReceiptCids[row] = ""
    productionTerminalJournalProviderFinalizedRecordReceiptCids[row] = ""
    productionTerminalJournalObservationCanonical[row] = ""
    productionTerminalJournalProjectedObservationCanonical[row] = ""
    productionTerminalJournalDurableObservationRecordCanonical[row] = ""
    productionTerminalJournalAdmissionCanonical[row] = ""
    productionTerminalJournalClaimedCanonical[row] = ""
    productionTerminalJournalDecisionOwners[row] = -1
    productionTerminalJournalDecisions[row] =
        ProductionTerminalJournalDecisionNone
    productionTerminalJournalRuntimeSessions[row] = -1
    productionTerminalJournalChildPids[row] = -1
    productionTerminalJournalChildUids[row] = uint32(0)
    productionTerminalJournalChildGids[row] = uint32(0)
    atomic.StoreI32(
        productionTerminalJournalDecisionOwnerStates[row],
        ProductionTerminalJournalDecisionOwnerNone)
    var closeReadyOwner = productionTerminalJournalCloseReadyOwners[row]
    productionTerminalJournalCloseReadyOwners[row] = -1
    atomic.StoreI32(
        productionTerminalJournalStates[row],
        ProductionTerminalJournalStateDetached)
    if !productionTerminalJournalReleaseTerminalRegistriesAfterDrain():
        panic("production terminal journal registry drain incomplete")
    if !pre_exec.CsgCoreProductionAdmittedInputAuthorityPublishCloseReadyInto(
           closeReadyOwner, err):
        panic("production terminal journal CloseReady publication failed")
    if closeReadyOwner != -1:
        panic("production terminal journal CloseReady source not cleared")
    outExitCode = workloadExitCode
    err = ""
    return true

@borrows
fn productionTerminalJournalAppendProviderFinalizedInto(
        handle: int32,
        providerFinalizationReceiptCid: str,
        outProviderFinalizedRecordReceiptCid: var str,
        err: var str): bool =
    outProviderFinalizedRecordReceiptCid = ""
    let row = productionTerminalJournalRowForHandle(
        handle, ProductionTerminalJournalStateDecision)
    if row < 0 ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           providerFinalizationReceiptCid):
        err = "production_terminal_journal_provider_finalize_input_invalid"
        return false
    var providerFinalizedRecordCanonical: str
    if !productionTerminalJournalAppendDerivedInto(
           row,
           ProductionTerminalJournalStateDecision,
           ProductionTerminalJournalStateWritingProviderFinalized,
           ProductionTerminalJournalStateProviderFinalized,
           ProductionTerminalJournalPhaseProviderFinalized,
           productionTerminalJournalDecisions[row],
           productionTerminalJournalDecisionRecordReceiptCids[row],
           providerFinalizationReceiptCid,
           productionTerminalJournalFinishedRecordReceiptCids[row],
           "",
           providerFinalizedRecordCanonical,
           outProviderFinalizedRecordReceiptCid,
           err):
        return false
    productionTerminalJournalProviderReceiptCids[row] =
        strings.CloneStr(providerFinalizationReceiptCid)
    productionTerminalJournalProviderFinalizedRecordReceiptCids[row] =
        strings.CloneStr(outProviderFinalizedRecordReceiptCid)
    return true

@borrows
fn productionTerminalJournalGetU32(
        bytes: rawbytes.Bytes,
        offset: int32): uint32 =
    var value: uint32
    for byteIndex in 0..<4:
        value = value |
            (uint32(rawbytes.BytesGet(bytes, offset + byteIndex) & 255) <<
             uint32(byteIndex * 8))
    return value

@borrows
fn productionTerminalJournalGetU64(
        bytes: rawbytes.Bytes,
        offset: int32): uint64 =
    var value: uint64
    for byteIndex in 0..<8:
        value = value |
            (uint64(rawbytes.BytesGet(bytes, offset + byteIndex) & 255) <<
             uint64(byteIndex * 8))
    return value

@borrows
fn productionTerminalJournalGetFixed32Into(
        bytes: rawbytes.Bytes,
        offset: int32,
        out: var layout.FixedBytes32) =
    for byteIndex in 0..<32:
        out.data[byteIndex] = uint8(
            rawbytes.BytesGet(bytes, offset + byteIndex) & 255)

@borrows
fn productionTerminalJournalBytesExactEqual(
        left: rawbytes.Bytes,
        right: rawbytes.Bytes): bool =
    return rawbytes.BytesEqual(left, right)

@borrows
fn productionTerminalJournalRecordDecodeInto(
        canonical: str,
        expectedPhase: int32,
        out: var productionTerminalJournalRecord): bool =
    out = productionTerminalJournalRecord()
    let phaseKnown =
        expectedPhase == ProductionTerminalJournalPhaseClaimed ||
        expectedPhase == ProductionTerminalJournalPhaseFinished ||
        expectedPhase == ProductionTerminalJournalPhaseDecision ||
        expectedPhase == ProductionTerminalJournalPhaseExitObserved ||
        expectedPhase == ProductionTerminalJournalPhaseReaped ||
        expectedPhase == ProductionTerminalJournalPhaseProviderFinalized
    if !phaseKnown ||
       canonical.len != ProductionTerminalJournalRecordBytes:
        return false
    let bytes = rawbytes.BytesFromString(canonical)
    if rawbytes.BytesGet(bytes, 0) != ProductionTerminalJournalMagic0 ||
       rawbytes.BytesGet(bytes, 1) != ProductionTerminalJournalMagic1 ||
       rawbytes.BytesGet(bytes, 2) != ProductionTerminalJournalMagic2 ||
       rawbytes.BytesGet(bytes, 3) != ProductionTerminalJournalMagic3 ||
       productionTerminalJournalGetU32(bytes, 4) !=
           uint32(ProductionTerminalJournalSchemaVersion) ||
       productionTerminalJournalGetU32(bytes, 8) !=
           uint32(expectedPhase):
        return false
    for byteIndex in 488..<ProductionTerminalJournalRecordBytes:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    out.phase = int32(productionTerminalJournalGetU32(bytes, 8))
    out.decision = int32(productionTerminalJournalGetU32(bytes, 12))
    productionTerminalJournalGetFixed32Into(bytes, 16, out.sessionCid)
    productionTerminalJournalGetFixed32Into(
        bytes, 48, out.predecessorReceipt)
    productionTerminalJournalGetFixed32Into(bytes, 80, out.claimReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 112, out.terminalReceipt)
    productionTerminalJournalGetFixed32Into(bytes, 144, out.evidenceA)
    productionTerminalJournalGetFixed32Into(bytes, 176, out.evidenceB)
    out.outputBytes = productionTerminalJournalGetU64(bytes, 208)
    out.workloadExitCode = int32(
        productionTerminalJournalGetU32(bytes, 216))
    out.childPid = int32(productionTerminalJournalGetU32(bytes, 220))
    out.childUid = productionTerminalJournalGetU32(bytes, 224)
    out.childGid = productionTerminalJournalGetU32(bytes, 228)
    productionTerminalJournalGetFixed32Into(bytes, 232, out.receipt)
    var observationAllZero = true
    for byteIndex in
            0..<ProductionTerminalJournalObservationCanonicalBytes:
        if rawbytes.BytesGet(bytes, 264 + byteIndex) != 0:
            observationAllZero = false
    let phaseHasObservation =
        expectedPhase == ProductionTerminalJournalPhaseExitObserved ||
        expectedPhase == ProductionTerminalJournalPhaseReaped
    if phaseHasObservation:
        if observationAllZero:
            return false
        var observationBytes = rawbytes.BytesSlice(
            bytes, 264, ProductionTerminalJournalObservationCanonicalBytes)
        out.observationCanonical =
            rawbytes.BytesToString(observationBytes)
        rawbytes.BytesFree(observationBytes)
    elif !observationAllZero:
        return false
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(out.sessionCid, zero) ||
       layout.FixedBytes32Equal(out.claimReceipt, zero) ||
       layout.FixedBytes32Equal(out.receipt, zero) ||
       out.childPid <= 0:
        return false
    if expectedPhase == ProductionTerminalJournalPhaseClaimed:
        if out.decision != ProductionTerminalJournalDecisionNone ||
           !layout.FixedBytes32Equal(out.predecessorReceipt, zero) ||
           !layout.FixedBytes32Equal(out.terminalReceipt, zero) ||
           layout.FixedBytes32Equal(out.evidenceA, zero) ||
           layout.FixedBytes32Equal(out.evidenceB, zero) ||
           out.outputBytes != uint64(0) || out.workloadExitCode != -1:
            return false
    else:
        if layout.FixedBytes32Equal(out.predecessorReceipt, zero) ||
           layout.FixedBytes32Equal(out.terminalReceipt, zero) ||
           layout.FixedBytes32Equal(out.evidenceA, zero) ||
           layout.FixedBytes32Equal(out.evidenceB, zero) ||
           out.outputBytes == uint64(0) || out.workloadExitCode < 0 ||
           out.workloadExitCode > 255:
            return false
        if expectedPhase == ProductionTerminalJournalPhaseFinished:
            if out.decision != ProductionTerminalJournalDecisionNone:
                return false
        elif (out.decision != ProductionTerminalJournalDecisionCommit &&
              out.decision != ProductionTerminalJournalDecisionAbort) ||
             (out.decision == ProductionTerminalJournalDecisionCommit &&
              out.workloadExitCode != 0) ||
             (out.decision == ProductionTerminalJournalDecisionAbort &&
              out.workloadExitCode == 0):
            return false
    if phaseHasObservation:
        let observationView = rawbytes.BytesFromString(
            out.observationCanonical)
        var observationReceiptCid: str
        if expectedPhase == ProductionTerminalJournalPhaseExitObserved:
            observationReceiptCid =
                merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
                    "cheng.runtime.held_exec.exit_observation.canonical.v1",
                    observationView)
            var observationDigest: layout.FixedBytes32
            if !productionTerminalJournalCidDigestInto(
                   observationReceiptCid, observationDigest) ||
               !layout.FixedBytes32Equal(
                   observationDigest, out.evidenceA):
                return false
        else:
            observationReceiptCid =
                merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
                    "cheng.runtime.held_exec.reap_observation.canonical.v1",
                    observationView)
            var observationDigest: layout.FixedBytes32
            if !productionTerminalJournalCidDigestInto(
                   observationReceiptCid, observationDigest):
                return false
            if !layout.FixedBytes32Equal(
                   observationDigest, out.evidenceA):
                return false
    let installedReceipt = out.receipt
    out.receipt = layout.FixedBytes32()
    var unsignedBytes = productionTerminalJournalRecordEncode(out)
    let computedReceiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            ProductionTerminalJournalRecordDomain, unsignedBytes)
    rawbytes.BytesFree(unsignedBytes)
    var computedReceipt: layout.FixedBytes32
    if !productionTerminalJournalCidDigestInto(
           computedReceiptCid, computedReceipt) ||
       !layout.FixedBytes32Equal(computedReceipt, installedReceipt):
        return false
    out.receipt = installedReceipt
    var reencoded = productionTerminalJournalRecordEncode(out)
    let byteExact = productionTerminalJournalBytesExactEqual(
        reencoded, bytes)
    rawbytes.BytesFree(reencoded)
    return byteExact

@borrows
fn productionTerminalJournalReplayCommonEqual(
        claimed: productionTerminalJournalRecord,
        record: productionTerminalJournalRecord): bool =
    return layout.FixedBytes32Equal(
               claimed.sessionCid, record.sessionCid) &&
        layout.FixedBytes32Equal(
               claimed.claimReceipt, record.claimReceipt) &&
        claimed.childPid == record.childPid &&
        claimed.childUid == record.childUid &&
        claimed.childGid == record.childGid

@borrows
fn productionTerminalJournalReplayWorkEqual(
        finished: productionTerminalJournalRecord,
        record: productionTerminalJournalRecord): bool =
    return layout.FixedBytes32Equal(
               finished.terminalReceipt, record.terminalReceipt) &&
        finished.outputBytes == record.outputBytes &&
        finished.workloadExitCode == record.workloadExitCode

# Decide whether a session already reached the exact durable provider-finalized
# boundary.  This is the only completed-session skip used by recovery.  It
# reuses the canonical record/admission/decision codecs and compares the
# decision mirror byte-for-byte; a directory name or phase filename alone is
# never sufficient.
fn productionTerminalJournalRecoveredSessionCompleteStrictInto(
        rootOwnerHandle: int32,
        outComplete: var bool,
        err: var str): bool =
    outComplete = false
    var canonical4: str
    let status4 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        rootOwnerHandle,
        ProductionTerminalJournalPhaseProviderFinalized,
        canonical4,
        err)
    if status4 < 0:
        return false
    if status4 == 0:
        err = ""
        return true
    var canonical1: str
    var canonical2: str
    var canonical3: str
    var decisionCanonical: str
    var mirrorCanonical: str
    var admissionCanonical: str
    if csgStoreTerminalJournalRootOwnerReadRecordInto(
           rootOwnerHandle,
           ProductionTerminalJournalPhaseClaimed,
           canonical1,
           err) != 1 ||
       csgStoreTerminalJournalRootOwnerReadRecordInto(
           rootOwnerHandle,
           ProductionTerminalJournalPhaseFinished,
           canonical2,
           err) != 1 ||
       csgStoreTerminalJournalRootOwnerReadRecordInto(
           rootOwnerHandle,
           ProductionTerminalJournalPhaseDecision,
           canonical3,
           err) != 1 ||
       csgStoreTerminalJournalRootOwnerReadDecisionInto(
           rootOwnerHandle, decisionCanonical, err) != 1 ||
       csgStoreTerminalJournalRootOwnerReadAdmissionProofInto(
           rootOwnerHandle, admissionCanonical, err) != 1 ||
       !csgStoreTerminalJournalRootOwnerReadDecisionMirrorInto(
           rootOwnerHandle, mirrorCanonical, err):
        if err.len == 0:
            err = "merkle_store_terminal_completed_session_phase_gap"
        return false
    var record1: productionTerminalJournalRecord
    var record2: productionTerminalJournalRecord
    var record3: productionTerminalJournalRecord
    var record4: productionTerminalJournalRecord
    var currentBindingCid: str
    var strictClaimed: journal_codec.ProductionTerminalJournalClaimedRecord
    var currentBindingDigest: layout.FixedBytes32
    var decisionCanonicalCid: str
    var decisionCanonicalDigest: layout.FixedBytes32
    var mirrorAllZero = true
    for byteIndex in 0..<mirrorCanonical.len:
        if mirrorCanonical[byteIndex] != uint8(0):
            mirrorAllZero = false
    let strict =
        productionTerminalJournalRecordDecodeInto(
            canonical1,
            ProductionTerminalJournalPhaseClaimed,
            record1) &&
        productionTerminalJournalRecordDecodeInto(
            canonical2,
            ProductionTerminalJournalPhaseFinished,
            record2) &&
        productionTerminalJournalRecordDecodeInto(
            canonical3,
            ProductionTerminalJournalPhaseDecision,
            record3) &&
        productionTerminalJournalRecordDecodeInto(
            canonical4,
            ProductionTerminalJournalPhaseProviderFinalized,
            record4) &&
        csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
            rootOwnerHandle, currentBindingCid, err) &&
        journal_codec.ProductionTerminalJournalClaimedDecodeStrictInto(
            canonical1,
            admissionCanonical,
            currentBindingCid,
            strictClaimed) &&
        productionTerminalJournalCidDigestInto(
            currentBindingCid, currentBindingDigest) &&
        layout.FixedBytes32Equal(record3.evidenceA, currentBindingDigest) &&
        productionTerminalJournalReplayCommonEqual(record1, record2) &&
        productionTerminalJournalReplayCommonEqual(record1, record3) &&
        productionTerminalJournalReplayCommonEqual(record1, record4) &&
        productionTerminalJournalReplayWorkEqual(record2, record3) &&
        productionTerminalJournalReplayWorkEqual(record2, record4) &&
        layout.FixedBytes32Equal(
            record2.predecessorReceipt, record1.receipt) &&
        layout.FixedBytes32Equal(
            record3.predecessorReceipt, record2.receipt) &&
        layout.FixedBytes32Equal(
            record4.predecessorReceipt, record3.receipt) &&
        record4.decision == record3.decision &&
        layout.FixedBytes32Equal(record4.evidenceB, record2.receipt) &&
        productionTerminalJournalDecisionCanonicalStrictInto(
            decisionCanonical,
            record3.decision,
            productionTerminalJournalCid(record1.claimReceipt),
            productionTerminalJournalCid(record2.terminalReceipt),
            productionTerminalJournalCid(record1.evidenceA),
            decisionCanonicalCid) &&
        productionTerminalJournalCidDigestInto(
            decisionCanonicalCid, decisionCanonicalDigest) &&
        layout.FixedBytes32Equal(
            decisionCanonicalDigest, record3.evidenceB)
    if !strict:
        if err.len == 0:
            err = "merkle_store_terminal_completed_session_strict_invalid"
        return false
    if mirrorAllZero:
        err = ""
        return true
    if mirrorCanonical != decisionCanonical:
        err = "merkle_store_terminal_completed_session_mirror_invalid"
        return false
    outComplete = true
    err = ""
    return true

@borrows
fn productionTerminalFinishedRecoveryProofDecodeStrictInto(
        canonical: str,
        compileReceiptCanonical: str,
        out: var productionTerminalFinishedRecoveryProof): bool =
    out = productionTerminalFinishedRecoveryProof()
    if canonical.len != 352:
        return false
    let bytes = rawbytes.BytesFromString(canonical)
    if rawbytes.BytesLen(bytes) != 352 ||
       rawbytes.BytesGet(bytes, 0) != int32('C') ||
       rawbytes.BytesGet(bytes, 1) != int32('F') ||
       rawbytes.BytesGet(bytes, 2) != int32('R') ||
       rawbytes.BytesGet(bytes, 3) != int32('1') ||
       rawbytes.BytesGet(bytes, 4) != 2:
        return false
    for byteIndex in 5..<8:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    for byteIndex in 24..<32:
        if rawbytes.BytesGet(bytes, byteIndex) != 0:
            return false
    let exitCode = productionTerminalJournalGetU64(bytes, 8)
    let outputBytes = productionTerminalJournalGetU64(bytes, 16)
    if exitCode > uint64(255) ||
       (exitCode == uint64(0) && outputBytes == uint64(0)) ||
       (exitCode != uint64(0) && outputBytes != uint64(0)):
        return false
    out.workloadExitCode = int32(exitCode)
    out.outputBytes = outputBytes
    productionTerminalJournalGetFixed32Into(
        bytes, 32, out.terminalReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 64, out.childIdentity)
    productionTerminalJournalGetFixed32Into(
        bytes, 96, out.outputDigest)
    productionTerminalJournalGetFixed32Into(
        bytes, 128, out.uploadDigest)
    productionTerminalJournalGetFixed32Into(
        bytes, 160, out.planReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 192, out.planEvidenceReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 224, out.compileReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 256, out.claimReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 288, out.ownerClaimReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 320, out.nonce)
    var zero: layout.FixedBytes32
    if layout.FixedBytes32Equal(out.terminalReceipt, zero) ||
       layout.FixedBytes32Equal(out.childIdentity, zero) ||
       layout.FixedBytes32Equal(out.uploadDigest, zero) ||
       layout.FixedBytes32Equal(out.planReceipt, zero) ||
       layout.FixedBytes32Equal(out.planEvidenceReceipt, zero) ||
       layout.FixedBytes32Equal(out.claimReceipt, zero) ||
       layout.FixedBytes32Equal(out.ownerClaimReceipt, zero) ||
       layout.FixedBytes32Equal(out.nonce, zero) ||
       (exitCode == uint64(0) &&
        (layout.FixedBytes32Equal(out.outputDigest, zero) ||
         layout.FixedBytes32Equal(out.compileReceipt, zero))):
        return false
    var compileReceipt: compile_receipt_codec.CompileReceipt
    var compileErr: str
    if exitCode == uint64(0) &&
       (!compile_receipt_codec.CompileReceiptCodecDecodeStrictInto(
            compileReceiptCanonical, compileReceipt, compileErr) ||
        !layout.FixedBytes32Equal(
            compileReceipt.receiptCid, out.compileReceipt) ||
        !layout.FixedBytes32Equal(
            compileReceipt.outputDigest, out.outputDigest)):
        return false
    if exitCode != uint64(0) && compileReceiptCanonical.len != 0:
        return false
    var rebuilt = rawbytes.BytesAlloc(352)
    rawbytes.BytesSet(rebuilt, 0, int32('C'))
    rawbytes.BytesSet(rebuilt, 1, int32('F'))
    rawbytes.BytesSet(rebuilt, 2, int32('R'))
    rawbytes.BytesSet(rebuilt, 3, int32('1'))
    rawbytes.BytesSet(rebuilt, 4, 2)
    productionTerminalJournalPutU64(
        rebuilt, 8, uint64(uint32(out.workloadExitCode)))
    productionTerminalJournalPutU64(rebuilt, 16, out.outputBytes)
    productionTerminalJournalPutFixed32(
        rebuilt, 32, out.terminalReceipt)
    productionTerminalJournalPutFixed32(
        rebuilt, 64, out.childIdentity)
    productionTerminalJournalPutFixed32(
        rebuilt, 96, out.outputDigest)
    productionTerminalJournalPutFixed32(
        rebuilt, 128, out.uploadDigest)
    productionTerminalJournalPutFixed32(
        rebuilt, 160, out.planReceipt)
    productionTerminalJournalPutFixed32(
        rebuilt, 192, out.planEvidenceReceipt)
    productionTerminalJournalPutFixed32(
        rebuilt, 224, out.compileReceipt)
    productionTerminalJournalPutFixed32(
        rebuilt, 256, out.claimReceipt)
    productionTerminalJournalPutFixed32(
        rebuilt, 288, out.ownerClaimReceipt)
    productionTerminalJournalPutFixed32(
        rebuilt, 320, out.nonce)
    let exact = rawbytes.BytesEqual(rebuilt, bytes)
    rawbytes.BytesFree(rebuilt)
    return exact

# Rebuild one durable journal session from disk using only the policy-bound
# root owner handle.  All CIDs and process identity are decoded from strict
# canonical records; no caller evidence can participate in recovery.
fn ProductionTerminalJournalRecoverInto(
        rootOwnerHandle: var int32,
        outJournalHandle: var int32): bool =
    outJournalHandle = -1
    if rootOwnerHandle <= 0:
        return false
    let ownedRootOwnerHandle = rootOwnerHandle
    rootOwnerHandle = -1
    var err: str
    let selected = csgStoreTerminalJournalRootOwnerRecoverNextInto(
        ownedRootOwnerHandle, err)
    if selected == 0:
        rootOwnerHandle = ownedRootOwnerHandle
        return false
    if selected != 1:
        panic(strings.ConcatStr(
            "production terminal journal: durable root recovery failed: ",
            err))
    var canonical1: str
    var canonical2: str
    var canonical3: str
    var canonical4: str
    var canonical5: str
    var canonical6: str
    var decisionCanonical: str
    var admissionCanonical: str
    let status1 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownedRootOwnerHandle, 1, canonical1, err)
    if status1 != 1:
        panic(strings.ConcatStr(
            "production terminal journal: claimed record read failed: ", err))
    var status2 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownedRootOwnerHandle, 2, canonical2, err)
    if status2 < 0:
        panic(strings.ConcatStr(
            "production terminal journal: finished record read failed: ", err))
    var status3 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownedRootOwnerHandle, 3, canonical3, err)
    if status3 < 0:
        panic(strings.ConcatStr(
            "production terminal journal: decision record read failed: ", err))
    let status4 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownedRootOwnerHandle, 4, canonical4, err)
    if status4 < 0:
        panic(strings.ConcatStr(
            "production terminal journal: provider record read failed: ", err))
    let status5 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownedRootOwnerHandle, 5, canonical5, err)
    if status5 < 0:
        panic(strings.ConcatStr(
            "production terminal journal: exit record read failed: ", err))
    let status6 = csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownedRootOwnerHandle, 6, canonical6, err)
    if status6 < 0:
        panic(strings.ConcatStr(
            "production terminal journal: reap record read failed: ", err))
    let decisionCanonicalStatus =
        csgStoreTerminalJournalRootOwnerReadDecisionInto(
            ownedRootOwnerHandle, decisionCanonical, err)
    if decisionCanonicalStatus < 0:
        panic(strings.ConcatStr(
            "production terminal journal: decision bytes read failed: ", err))
    let admissionCanonicalStatus =
        csgStoreTerminalJournalRootOwnerReadAdmissionProofInto(
            ownedRootOwnerHandle, admissionCanonical, err)
    if admissionCanonicalStatus != 1:
        panic(strings.ConcatStr(
            "production terminal journal: admission proof read failed: ", err))
    let phaseGap =
        (status2 == 1 && status1 != 1) ||
        (status3 == 1 && status2 != 1) ||
        (status4 == 1 && status3 != 1) ||
        (status5 == 1 && status4 != 1) ||
        (status6 == 1 && status5 != 1)
    if (status3 == 1 && decisionCanonicalStatus != 1) ||
       (status3 != 1 && decisionCanonicalStatus != 0) || phaseGap:
        panic("production terminal journal: durable phase gap")
    var record1: productionTerminalJournalRecord
    var record2: productionTerminalJournalRecord
    var record3: productionTerminalJournalRecord
    var record4: productionTerminalJournalRecord
    var record5: productionTerminalJournalRecord
    var record6: productionTerminalJournalRecord
    if !productionTerminalJournalRecordDecodeInto(
           canonical1, ProductionTerminalJournalPhaseClaimed, record1) ||
       (status2 == 1 && !productionTerminalJournalRecordDecodeInto(
            canonical2, ProductionTerminalJournalPhaseFinished, record2)) ||
       (status3 == 1 && !productionTerminalJournalRecordDecodeInto(
            canonical3, ProductionTerminalJournalPhaseDecision, record3)) ||
       (status4 == 1 && !productionTerminalJournalRecordDecodeInto(
            canonical4,
            ProductionTerminalJournalPhaseProviderFinalized,
            record4)) ||
       (status5 == 1 && !productionTerminalJournalRecordDecodeInto(
            canonical5,
            ProductionTerminalJournalPhaseExitObserved,
            record5)) ||
       (status6 == 1 && !productionTerminalJournalRecordDecodeInto(
            canonical6,
            ProductionTerminalJournalPhaseReaped,
            record6)):
        panic("production terminal journal: canonical record invalid")
    var currentRootOwnerBindingCid: str
    var strictClaimed: journal_codec.ProductionTerminalJournalClaimedRecord
    if !csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           ownedRootOwnerHandle,
           currentRootOwnerBindingCid,
           err) ||
       !journal_codec.ProductionTerminalJournalClaimedDecodeStrictInto(
           canonical1,
           admissionCanonical,
           currentRootOwnerBindingCid,
           strictClaimed):
        panic("production terminal journal: admission proof session binding invalid")
    var finishedRecoveryOwner: int32
    var finishedRecoveryProofCanonical: str
    var finishedRecoveryCompileCanonical: str
    var finishedRecoveryProof: productionTerminalFinishedRecoveryProof
    let finishedRecoveryOpened =
        csgStoreTerminalJournalRootOwnerFinishedRecoveryOwnerInto(
            ownedRootOwnerHandle,
            strictClaimed.childPid,
            strictClaimed.childBirthPlatform,
            strictClaimed.childBirth0,
            strictClaimed.childBirth1,
            finishedRecoveryOwner,
            err)
    var finishedRecoveryTaken = false
    if finishedRecoveryOpened && finishedRecoveryOwner > 0:
        finishedRecoveryTaken =
            system.RuntimeHeldExecFinishedRecoveryOwnerTakeCanonicalInto(
                finishedRecoveryOwner,
                finishedRecoveryProofCanonical,
                finishedRecoveryCompileCanonical)
    let finishedRecoveryValid = finishedRecoveryOpened &&
        finishedRecoveryOwner > 0 &&
        finishedRecoveryTaken &&
        productionTerminalFinishedRecoveryProofDecodeStrictInto(
               finishedRecoveryProofCanonical,
               finishedRecoveryCompileCanonical,
               finishedRecoveryProof) &&
        layout.FixedBytes32Equal(
               finishedRecoveryProof.claimReceipt,
               record1.claimReceipt) &&
        layout.FixedBytes32Equal(
               finishedRecoveryProof.ownerClaimReceipt,
               record1.evidenceA) &&
        !layout.FixedBytes32Equal(
               finishedRecoveryProof.terminalReceipt,
               finishedRecoveryProof.childIdentity) &&
        !layout.FixedBytes32Equal(
               finishedRecoveryProof.terminalReceipt,
               finishedRecoveryProof.uploadDigest) &&
        !layout.FixedBytes32Equal(
               finishedRecoveryProof.childIdentity,
               finishedRecoveryProof.uploadDigest)
    if finishedRecoveryOpened && !finishedRecoveryTaken &&
       finishedRecoveryOwner > 0 &&
       !system.RuntimeHeldExecFinishedRecoveryOwnerAbort(
           finishedRecoveryOwner):
        panic("production terminal journal: finished recovery owner cleanup failed")
    var finishedRecoveryComplete = false
    if finishedRecoveryOpened:
        finishedRecoveryComplete =
            csgStoreTerminalJournalRootOwnerFinishedRecoveryCompleteInto(
                ownedRootOwnerHandle, finishedRecoveryValid, err)
    if !finishedRecoveryValid || !finishedRecoveryComplete:
        panic(strings.ConcatStr(
            "production terminal journal: finished upload recovery proof invalid: ",
            err))
    if finishedRecoveryValid:
        if status2 == 0:
            record2.phase = ProductionTerminalJournalPhaseFinished
            record2.decision = ProductionTerminalJournalDecisionNone
            record2.sessionCid = record1.sessionCid
            record2.predecessorReceipt = record1.receipt
            record2.claimReceipt = record1.claimReceipt
            record2.terminalReceipt =
                finishedRecoveryProof.terminalReceipt
            record2.evidenceA = finishedRecoveryProof.childIdentity
            record2.evidenceB = finishedRecoveryProof.uploadDigest
            record2.outputBytes = finishedRecoveryProof.outputBytes
            record2.workloadExitCode =
                finishedRecoveryProof.workloadExitCode
            record2.childPid = record1.childPid
            record2.childUid = record1.childUid
            record2.childGid = record1.childGid
            var recoveredFinishedRecord =
                productionTerminalJournalRecordFinalize(record2)
            let recoveredFinishedReceiptCid =
                productionTerminalJournalCid(record2.receipt)
            if rawbytes.BytesLen(recoveredFinishedRecord) !=
                   ProductionTerminalJournalRecordBytes ||
               !merkle_store_codec.CsgCoreMerkleStoreCidValid(
                   recoveredFinishedReceiptCid) ||
               !productionTerminalJournalAppendRecordInto(
                   ownedRootOwnerHandle,
                   ProductionTerminalJournalPhaseFinished,
                   recoveredFinishedReceiptCid,
                   recoveredFinishedRecord,
                   "",
                   err):
                rawbytes.BytesFree(recoveredFinishedRecord)
                panic(strings.ConcatStr(
                    "production terminal journal: recovered finished append failed: ",
                    err))
            canonical2 = rawbytes.BytesToString(recoveredFinishedRecord)
            rawbytes.BytesFree(recoveredFinishedRecord)
            status2 = 1
        elif !layout.FixedBytes32Equal(
                   record2.terminalReceipt,
                   finishedRecoveryProof.terminalReceipt) ||
             !layout.FixedBytes32Equal(
                   record2.evidenceA,
                   finishedRecoveryProof.childIdentity) ||
             !layout.FixedBytes32Equal(
                   record2.evidenceB,
                   finishedRecoveryProof.uploadDigest) ||
             record2.outputBytes != finishedRecoveryProof.outputBytes ||
             record2.workloadExitCode !=
                 finishedRecoveryProof.workloadExitCode:
            panic("production terminal journal: finished upload record drift")
    if status2 == 1 && status3 == 0:
        let recoveredDecision =
            record2.workloadExitCode == 0 ?
                ProductionTerminalJournalDecisionCommit :
                ProductionTerminalJournalDecisionAbort
        var recoveredDecisionCanonicalCid: str
        if !productionTerminalJournalDecisionCanonicalBuildInto(
               finishedRecoveryProof.nonce,
               recoveredDecision,
               productionTerminalJournalCid(record1.claimReceipt),
               productionTerminalJournalCid(record2.terminalReceipt),
               productionTerminalJournalCid(record1.evidenceA),
               decisionCanonical,
               recoveredDecisionCanonicalCid):
            panic("production terminal journal: recovered decision build failed")
        var headFenceDigest: layout.FixedBytes32
        var decisionCanonicalDigest: layout.FixedBytes32
        if !productionTerminalJournalCidDigestInto(
               currentRootOwnerBindingCid, headFenceDigest) ||
           !productionTerminalJournalCidDigestInto(
               recoveredDecisionCanonicalCid, decisionCanonicalDigest):
            panic("production terminal journal: recovered decision evidence invalid")
        record3.phase = ProductionTerminalJournalPhaseDecision
        record3.decision = recoveredDecision
        record3.sessionCid = record1.sessionCid
        record3.predecessorReceipt = record2.receipt
        record3.claimReceipt = record1.claimReceipt
        record3.terminalReceipt = record2.terminalReceipt
        record3.evidenceA = headFenceDigest
        record3.evidenceB = decisionCanonicalDigest
        record3.outputBytes = record2.outputBytes
        record3.workloadExitCode = record2.workloadExitCode
        record3.childPid = record1.childPid
        record3.childUid = record1.childUid
        record3.childGid = record1.childGid
        var recoveredDecisionRecord =
            productionTerminalJournalRecordFinalize(record3)
        let recoveredDecisionRecordReceiptCid =
            productionTerminalJournalCid(record3.receipt)
        if rawbytes.BytesLen(recoveredDecisionRecord) !=
               ProductionTerminalJournalRecordBytes ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               recoveredDecisionRecordReceiptCid) ||
           !productionTerminalJournalAppendRecordInto(
               ownedRootOwnerHandle,
               ProductionTerminalJournalPhaseDecision,
               recoveredDecisionRecordReceiptCid,
               recoveredDecisionRecord,
               decisionCanonical,
               err):
            rawbytes.BytesFree(recoveredDecisionRecord)
            panic(strings.ConcatStr(
                "production terminal journal: recovered decision append failed: ",
                err))
        canonical3 = rawbytes.BytesToString(recoveredDecisionRecord)
        rawbytes.BytesFree(recoveredDecisionRecord)
        status3 = 1
    if status2 == 1 &&
       (!productionTerminalJournalReplayCommonEqual(record1, record2) ||
        !layout.FixedBytes32Equal(
            record2.predecessorReceipt, record1.receipt)):
        panic("production terminal journal: finished chain invalid")
    if status3 == 1 &&
       (!productionTerminalJournalReplayCommonEqual(record1, record3) ||
        !productionTerminalJournalReplayWorkEqual(record2, record3) ||
        !layout.FixedBytes32Equal(
            record3.predecessorReceipt, record2.receipt)):
        panic("production terminal journal: decision chain invalid")
    var decisionCanonicalCid: str
    if status3 == 1:
        var decisionCanonicalDigest: layout.FixedBytes32
        var recoveredDecisionNonce: layout.FixedBytes32
        if !productionTerminalJournalTextFixed32Into(
               decisionCanonical, 32, recoveredDecisionNonce) ||
           !layout.FixedBytes32Equal(
               recoveredDecisionNonce, finishedRecoveryProof.nonce) ||
           !productionTerminalJournalDecisionCanonicalStrictInto(
               decisionCanonical,
               record3.decision,
               productionTerminalJournalCid(record1.claimReceipt),
               productionTerminalJournalCid(record2.terminalReceipt),
               productionTerminalJournalCid(record1.evidenceA),
               decisionCanonicalCid) ||
           !productionTerminalJournalCidDigestInto(
               decisionCanonicalCid, decisionCanonicalDigest) ||
           !layout.FixedBytes32Equal(
               decisionCanonicalDigest, record3.evidenceB):
            panic("production terminal journal: decision bytes binding invalid")
    if status4 == 1 &&
       (!productionTerminalJournalReplayCommonEqual(record1, record4) ||
        !productionTerminalJournalReplayWorkEqual(record2, record4) ||
        record4.decision != record3.decision ||
        !layout.FixedBytes32Equal(
            record4.predecessorReceipt, record3.receipt) ||
        !layout.FixedBytes32Equal(record4.evidenceB, record2.receipt)):
        panic("production terminal journal: provider chain invalid")
    if status5 == 1 &&
       (!productionTerminalJournalReplayCommonEqual(record1, record5) ||
        !productionTerminalJournalReplayWorkEqual(record2, record5) ||
        record5.decision != record3.decision ||
        !layout.FixedBytes32Equal(
            record5.predecessorReceipt, record4.receipt) ||
        !layout.FixedBytes32Equal(record5.evidenceB, record3.receipt)):
        panic("production terminal journal: exit observation chain invalid")
    if status6 == 1 &&
       (!productionTerminalJournalReplayCommonEqual(record1, record6) ||
        !productionTerminalJournalReplayWorkEqual(record2, record6) ||
        record6.decision != record3.decision ||
        !layout.FixedBytes32Equal(
            record6.predecessorReceipt, record5.receipt) ||
        !layout.FixedBytes32Equal(record6.evidenceB, record5.evidenceA) ||
        record6.observationCanonical == record5.observationCanonical):
        panic("production terminal journal: reap chain invalid")
    var observationOwner: int32 = -1
    if status6 == 1:
        observationOwner =
            system.RuntimeHeldExecTerminalObservationImportCanonical(
                record6.observationCanonical)
    elif status5 == 1:
        observationOwner =
            system.RuntimeHeldExecTerminalObservationImportCanonical(
                record5.observationCanonical)
    if (status5 == 1 && observationOwner <= 0) ||
       (status5 != 1 && observationOwner != -1):
        panic("production terminal journal: observation replay import failed")
    let row = productionTerminalJournalAllocateRow()
    if row < 0:
        panic("production terminal journal: recovery arena exhausted")
    productionTerminalJournalRootOwnerHandles[row] = ownedRootOwnerHandle
    productionTerminalJournalSessionCids[row] =
        productionTerminalJournalCid(record1.sessionCid)
    productionTerminalJournalClaimReceiptCids[row] =
        productionTerminalJournalCid(record1.claimReceipt)
    productionTerminalJournalOwnerClaimReceiptCids[row] =
        productionTerminalJournalCid(record1.evidenceA)
    productionTerminalJournalClaimedRecordReceiptCids[row] =
        productionTerminalJournalCid(record1.receipt)
    productionTerminalJournalRuntimeSessions[row] = -1
    productionTerminalJournalChildPids[row] = record1.childPid
    productionTerminalJournalChildUids[row] = record1.childUid
    productionTerminalJournalChildGids[row] = record1.childGid
    productionTerminalJournalObservationOwners[row] = observationOwner
    productionTerminalJournalDecisionOwners[row] =
        status3 == 1 ? row + 1 : -1
    atomic.StoreI32(
        productionTerminalJournalDecisionOwnerStates[row],
        status3 == 1 ?
            ProductionTerminalJournalDecisionOwnerRecoveredProof :
            ProductionTerminalJournalDecisionOwnerNone)
    productionTerminalJournalRecoveredRows[row] = 1
    productionTerminalJournalAdmissionCanonical[row] =
        strings.CloneStr(admissionCanonical)
    productionTerminalJournalClaimedCanonical[row] =
        strings.CloneStr(canonical1)
    var recoveredState = ProductionTerminalJournalStateClaimed
    if status2 == 1:
        productionTerminalJournalTerminalReceiptCids[row] =
            productionTerminalJournalCid(record2.terminalReceipt)
        productionTerminalJournalChildIdentityCids[row] =
            productionTerminalJournalCid(record2.evidenceA)
        productionTerminalJournalFinishedUploadCids[row] =
            productionTerminalJournalCid(record2.evidenceB)
        productionTerminalJournalFinishedRecordReceiptCids[row] =
            productionTerminalJournalCid(record2.receipt)
        productionTerminalJournalOutputByteCounts[row] = record2.outputBytes
        productionTerminalJournalWorkloadExitCodes[row] =
            record2.workloadExitCode
        recoveredState = ProductionTerminalJournalStateFinished
    if status3 == 1:
        productionTerminalJournalHeadFenceReceiptCids[row] =
            productionTerminalJournalCid(record3.evidenceA)
        productionTerminalJournalDecisionRecordReceiptCids[row] =
            productionTerminalJournalCid(record3.receipt)
        productionTerminalJournalDecisionCanonicalCids[row] =
            strings.CloneStr(decisionCanonicalCid)
        productionTerminalJournalDecisionCanonicals[row] =
            strings.CloneStr(decisionCanonical)
        productionTerminalJournalDecisions[row] = record3.decision
        recoveredState = ProductionTerminalJournalStateDecision
    if status4 == 1:
        productionTerminalJournalProviderReceiptCids[row] =
            productionTerminalJournalCid(record4.evidenceA)
        productionTerminalJournalProviderFinalizedRecordReceiptCids[row] =
            productionTerminalJournalCid(record4.receipt)
        recoveredState = ProductionTerminalJournalStateProviderFinalized
    if status5 == 1:
        productionTerminalJournalExitObservationReceiptCids[row] =
            productionTerminalJournalCid(record5.evidenceA)
        productionTerminalJournalExitObservedRecordReceiptCids[row] =
            productionTerminalJournalCid(record5.receipt)
        productionTerminalJournalObservationCanonical[row] =
            strings.CloneStr(record5.observationCanonical)
        recoveredState = ProductionTerminalJournalStateExitObserved
    if status6 == 1:
        productionTerminalJournalReapReceiptCids[row] =
            productionTerminalJournalCid(record6.evidenceA)
        productionTerminalJournalReapedRecordReceiptCids[row] =
            productionTerminalJournalCid(record6.receipt)
        productionTerminalJournalObservationCanonical[row] =
            strings.CloneStr(record6.observationCanonical)
        recoveredState = ProductionTerminalJournalStateReaped
    atomic.StoreI32(productionTerminalJournalStates[row], recoveredState)
    outJournalHandle = row + 1
    return true

@borrows
fn productionTerminalJournalProviderReceiptCidInto(
        journalRow: int32,
        outReceiptCid: var str): bool =
    outReceiptCid = ""
    if journalRow < 0 || journalRow >= ProductionTerminalJournalRowCount:
        return false
    var rootOwnerBindingCid: str
    var rootOwnerErr: str
    if !csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           productionTerminalJournalRootOwnerHandles[journalRow],
           rootOwnerBindingCid,
           rootOwnerErr):
        return false
    var admissionProofReceiptCid: str
    if !journal_codec.ProductionTerminalJournalAdmissionProofReceiptStrictInto(
           productionTerminalJournalAdmissionCanonical[journalRow],
           rootOwnerBindingCid,
           productionTerminalJournalClaimReceiptCids[journalRow],
           productionTerminalJournalOwnerClaimReceiptCids[journalRow],
           admissionProofReceiptCid):
        return false
    var admissionDigest: layout.FixedBytes32
    var finishedDigest: layout.FixedBytes32
    var decisionDigest: layout.FixedBytes32
    var sessionDigest: layout.FixedBytes32
    if !productionTerminalJournalCidDigestInto(
           admissionProofReceiptCid, admissionDigest) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalFinishedRecordReceiptCids[journalRow],
           finishedDigest) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalDecisionRecordReceiptCids[journalRow],
           decisionDigest) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalSessionCids[journalRow],
           sessionDigest):
        return false
    var payload = rawbytes.BytesAlloc(132)
    productionTerminalJournalPutFixed32(payload, 0, admissionDigest)
    productionTerminalJournalPutFixed32(payload, 32, finishedDigest)
    productionTerminalJournalPutFixed32(payload, 64, decisionDigest)
    productionTerminalJournalPutFixed32(payload, 96, sessionDigest)
    productionTerminalJournalPutU32(
        payload,
        128,
        uint32(productionTerminalJournalDecisions[journalRow]))
    outReceiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            ProductionTerminalJournalProviderReceiptDomain,
            payload)
    rawbytes.BytesFree(payload)
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(outReceiptCid)

fn ProductionTerminalJournalRecoveredDecisionOwner(
        journalHandle: int32): int32 =
    if journalHandle <= 0 ||
       journalHandle > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        return -1
    let row = journalHandle - 1
    if row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalRecoveredRows[row] != 1:
        return -1
    let state = atomic.LoadI32(productionTerminalJournalStates[row])
    if state != ProductionTerminalJournalStateDecision &&
       state != ProductionTerminalJournalStateProviderFinalized &&
       state != ProductionTerminalJournalStateExitObserved &&
       state != ProductionTerminalJournalStateReaped:
        return -1
    let owner = productionTerminalJournalDecisionOwners[row]
    var canonicalCid: str
    if owner <= 0 ||
       owner != row + 1 ||
       atomic.LoadI32(
           productionTerminalJournalDecisionOwnerStates[row]) !=
           ProductionTerminalJournalDecisionOwnerRecoveredProof ||
       !productionTerminalJournalDecisionCanonicalStrictInto(
           productionTerminalJournalDecisionCanonicals[row],
           productionTerminalJournalDecisions[row],
           productionTerminalJournalClaimReceiptCids[row],
           productionTerminalJournalTerminalReceiptCids[row],
           productionTerminalJournalOwnerClaimReceiptCids[row],
           canonicalCid) ||
       canonicalCid != productionTerminalJournalDecisionCanonicalCids[row]:
        return -1
    return owner

@borrows
fn productionTerminalJournalRecoveredProviderExact(
        journalRow: int32,
        providerOwner: int32,
        providerReceiptCid: str): bool =
    if journalRow < 0 ||
       journalRow >= ProductionTerminalJournalRowCount ||
       providerOwner != journalRow + 1 ||
       productionTerminalJournalRecoveredRows[journalRow] != 1:
        return false
    let decision = productionTerminalJournalDecisions[journalRow]
    let expectedState = decision == ProductionTerminalJournalDecisionCommit ?
        ProductionTerminalJournalRecoveredProviderCommitted :
        ProductionTerminalJournalRecoveredProviderAborted
    if (decision != ProductionTerminalJournalDecisionCommit &&
        decision != ProductionTerminalJournalDecisionAbort) ||
       atomic.LoadI32(
           productionTerminalJournalRecoveredProviderStates[journalRow]) !=
           expectedState ||
       productionTerminalJournalRecoveredProviderOwnerHandles[journalRow] !=
           providerOwner:
        return false
    var rootBindingCid: str
    var rootErr: str
    var claimed: journal_codec.ProductionTerminalJournalClaimedRecord
    var recomputedProviderReceiptCid: str
    let decisionOwner =
        ProductionTerminalJournalRecoveredDecisionOwner(journalRow + 1)
    if !csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           productionTerminalJournalRootOwnerHandles[journalRow],
           rootBindingCid,
           rootErr) ||
       !journal_codec.ProductionTerminalJournalClaimedDecodeStrictInto(
           productionTerminalJournalClaimedCanonical[journalRow],
           productionTerminalJournalAdmissionCanonical[journalRow],
           rootBindingCid,
           claimed) ||
       !productionTerminalJournalProviderReceiptCidInto(
           journalRow, recomputedProviderReceiptCid):
        return false
    return decisionOwner > 0 &&
        productionTerminalJournalRecoveredProviderRootBindingCids[journalRow] ==
            rootBindingCid &&
        productionTerminalJournalRecoveredProviderSessionCids[journalRow] ==
            claimed.sessionCid &&
        productionTerminalJournalRecoveredProviderClaimReceiptCids[journalRow] ==
            claimed.claimReceiptCid &&
        productionTerminalJournalRecoveredProviderOwnerClaimReceiptCids[journalRow] ==
            claimed.ownerClaimReceiptCid &&
        productionTerminalJournalRecoveredProviderProofReceiptCids[journalRow] ==
            claimed.admissionProofReceiptCid &&
        productionTerminalJournalRecoveredProviderDecisionOwners[journalRow] ==
            decisionOwner &&
        productionTerminalJournalRecoveredProviderDecisions[journalRow] ==
            decision &&
        productionTerminalJournalRecoveredProviderReceiptCids[journalRow] ==
            providerReceiptCid &&
        providerReceiptCid == recomputedProviderReceiptCid &&
        claimed.sessionCid ==
            productionTerminalJournalSessionCids[journalRow] &&
        claimed.claimReceiptCid ==
            productionTerminalJournalClaimReceiptCids[journalRow] &&
        claimed.ownerClaimReceiptCid ==
            productionTerminalJournalOwnerClaimReceiptCids[journalRow] &&
        claimed.childPid == productionTerminalJournalChildPids[journalRow] &&
        claimed.childUid == productionTerminalJournalChildUids[journalRow] &&
        claimed.childGid == productionTerminalJournalChildGids[journalRow]

# The recovered provider owner is the journal row's private append-only owner.
# A single CAS reserves it, then strict CLAIMED/admission bytes and the exact
# recovered decision owner are copied into immutable SoA columns before the
# provider terminal CAS publishes COMMITTED or ABORTED.  No canonical bytes,
# CID, decision enum or second int32 owner enter through the public surface.
fn productionTerminalJournalRecoveredProviderFinalizeInto(
        journalRow: int32,
        outProviderOwner: var int32,
        outProviderReceiptCid: var str): bool =
    outProviderOwner = -1
    outProviderReceiptCid = ""
    if journalRow < 0 ||
       journalRow >= ProductionTerminalJournalRowCount ||
       productionTerminalJournalRecoveredRows[journalRow] != 1:
        return false
    let journalState = atomic.LoadI32(
        productionTerminalJournalStates[journalRow])
    if journalState != ProductionTerminalJournalStateDecision &&
       journalState != ProductionTerminalJournalStateProviderFinalized &&
       journalState != ProductionTerminalJournalStateExitObserved &&
       journalState != ProductionTerminalJournalStateReaped:
        return false
    let decisionOwner =
        ProductionTerminalJournalRecoveredDecisionOwner(journalRow + 1)
    let decision = productionTerminalJournalDecisions[journalRow]
    var rootBindingCid: str
    var rootErr: str
    var claimed: journal_codec.ProductionTerminalJournalClaimedRecord
    var providerReceiptCid: str
    if decisionOwner <= 0 ||
       !csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           productionTerminalJournalRootOwnerHandles[journalRow],
           rootBindingCid,
           rootErr) ||
       !journal_codec.ProductionTerminalJournalClaimedDecodeStrictInto(
           productionTerminalJournalClaimedCanonical[journalRow],
           productionTerminalJournalAdmissionCanonical[journalRow],
           rootBindingCid,
           claimed) ||
       claimed.sessionCid != productionTerminalJournalSessionCids[journalRow] ||
       claimed.claimReceiptCid !=
           productionTerminalJournalClaimReceiptCids[journalRow] ||
       claimed.ownerClaimReceiptCid !=
           productionTerminalJournalOwnerClaimReceiptCids[journalRow] ||
       claimed.childPid != productionTerminalJournalChildPids[journalRow] ||
       claimed.childUid != productionTerminalJournalChildUids[journalRow] ||
       claimed.childGid != productionTerminalJournalChildGids[journalRow] ||
       !productionTerminalJournalProviderReceiptCidInto(
           journalRow, providerReceiptCid):
        return false
    let providerOwner = journalRow + 1
    var providerState = atomic.LoadI32(
        productionTerminalJournalRecoveredProviderStates[journalRow])
    if providerState == ProductionTerminalJournalRecoveredProviderNone:
        if !atomic.CasI32(
               productionTerminalJournalRecoveredProviderStates[journalRow],
               ProductionTerminalJournalRecoveredProviderNone,
               ProductionTerminalJournalRecoveredProviderImporting):
            return false
        productionTerminalJournalRecoveredProviderOwnerHandles[journalRow] =
            providerOwner
        productionTerminalJournalRecoveredProviderRootBindingCids[journalRow] =
            strings.CloneStr(rootBindingCid)
        productionTerminalJournalRecoveredProviderSessionCids[journalRow] =
            strings.CloneStr(claimed.sessionCid)
        productionTerminalJournalRecoveredProviderClaimReceiptCids[journalRow] =
            strings.CloneStr(claimed.claimReceiptCid)
        productionTerminalJournalRecoveredProviderOwnerClaimReceiptCids[journalRow] =
            strings.CloneStr(claimed.ownerClaimReceiptCid)
        productionTerminalJournalRecoveredProviderProofReceiptCids[journalRow] =
            strings.CloneStr(claimed.admissionProofReceiptCid)
        productionTerminalJournalRecoveredProviderDecisionOwners[journalRow] =
            decisionOwner
        productionTerminalJournalRecoveredProviderDecisions[journalRow] =
            decision
        productionTerminalJournalRecoveredProviderReceiptCids[journalRow] =
            strings.CloneStr(providerReceiptCid)
        atomic.StoreI32(
            productionTerminalJournalRecoveredProviderStates[journalRow],
            ProductionTerminalJournalRecoveredProviderImported)
        providerState = ProductionTerminalJournalRecoveredProviderImported
    let terminalState = decision == ProductionTerminalJournalDecisionCommit ?
        ProductionTerminalJournalRecoveredProviderCommitted :
        ProductionTerminalJournalRecoveredProviderAborted
    if providerState == ProductionTerminalJournalRecoveredProviderImported:
        if !atomic.CasI32(
               productionTerminalJournalRecoveredProviderStates[journalRow],
               ProductionTerminalJournalRecoveredProviderImported,
               ProductionTerminalJournalRecoveredProviderFinalizing):
            return false
        atomic.StoreI32(
            productionTerminalJournalRecoveredProviderStates[journalRow],
            terminalState)
    if !productionTerminalJournalRecoveredProviderExact(
           journalRow, providerOwner, providerReceiptCid):
        return false
    outProviderOwner = providerOwner
    outProviderReceiptCid = strings.CloneStr(providerReceiptCid)
    return true

fn ProductionTerminalJournalFinalizeRecoveredProviderInto(
        journalHandle: int32,
        err: var str): bool =
    if journalHandle <= 0 ||
       journalHandle > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        err = "production_terminal_journal_recovered_provider_owner_invalid"
        return false
    let row = journalHandle - 1
    var providerOwner: int32
    var providerReceiptCid: str
    if row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       !productionTerminalJournalRecoveredProviderFinalizeInto(
           row, providerOwner, providerReceiptCid) ||
       providerOwner != row + 1 ||
       !productionTerminalJournalRecoveredProviderExact(
           row, providerOwner, providerReceiptCid):
        err = "production_terminal_journal_recovered_provider_authority_invalid"
        return false
    let state = atomic.LoadI32(productionTerminalJournalStates[row])
    if state == ProductionTerminalJournalStateProviderFinalized ||
       state == ProductionTerminalJournalStateExitObserved ||
       state == ProductionTerminalJournalStateReaped:
        if productionTerminalJournalProviderReceiptCids[row] !=
               providerReceiptCid:
            err = "production_terminal_journal_recovered_provider_receipt_drift"
            return false
        err = ""
        return true
    if state != ProductionTerminalJournalStateDecision:
        err = "production_terminal_journal_recovered_provider_phase_invalid"
        return false
    var recordReceiptCid: str
    if !productionTerminalJournalAppendProviderFinalizedInto(
           journalHandle,
           providerReceiptCid,
           recordReceiptCid,
           err):
        let concurrentState = atomic.LoadI32(
            productionTerminalJournalStates[row])
        if (concurrentState !=
                ProductionTerminalJournalStateProviderFinalized &&
            concurrentState != ProductionTerminalJournalStateExitObserved &&
            concurrentState != ProductionTerminalJournalStateReaped) ||
           productionTerminalJournalProviderReceiptCids[row] !=
               providerReceiptCid:
            return false
    err = ""
    return true

# Restart has no recoverable SEQPACKET parent.  The durable DECISION remains
# authoritative and is mirrored onto the pre-created inode using the exact
# canonical bytes already strict-imported from phase 03.  No socket fallback
# or caller-provided bytes participate.
fn ProductionTerminalJournalMirrorRecoveredDecisionInto(
        journalHandle: int32,
        err: var str): bool =
    let decisionOwner =
        ProductionTerminalJournalRecoveredDecisionOwner(journalHandle)
    if decisionOwner <= 0:
        err = "production_terminal_journal_recovered_mirror_owner_invalid"
        return false
    let row = journalHandle - 1
    let state = atomic.LoadI32(productionTerminalJournalStates[row])
    if productionTerminalJournalRecoveredRows[row] != 1 ||
       (state != ProductionTerminalJournalStateProviderFinalized &&
        state != ProductionTerminalJournalStateExitObserved &&
        state != ProductionTerminalJournalStateReaped):
        err = "production_terminal_journal_recovered_mirror_phase_invalid"
        return false
    var canonicalCid: str
    if !productionTerminalJournalDecisionCanonicalStrictInto(
           productionTerminalJournalDecisionCanonicals[row],
           productionTerminalJournalDecisions[row],
           productionTerminalJournalClaimReceiptCids[row],
           productionTerminalJournalTerminalReceiptCids[row],
           productionTerminalJournalOwnerClaimReceiptCids[row],
           canonicalCid) ||
       canonicalCid != productionTerminalJournalDecisionCanonicalCids[row] ||
       !csgStoreTerminalJournalRootOwnerInstallDecisionMirrorInto(
           productionTerminalJournalRootOwnerHandles[row],
           productionTerminalJournalDecisionCanonicals[row],
           err):
        if err.len == 0:
            err = "production_terminal_journal_recovered_mirror_invalid"
        return false
    err = ""
    return true

# Return the same policy/fence-bound owner only after the recovered session
# has released its active cursor.  This is the sole move edge that lets the
# guardian continue to the next durable session without reopening a path.
fn ProductionTerminalJournalDetachRecoveredAndReturnRootInto(
        journalHandle: int32,
        outRootOwner: var int32,
        err: var str): bool =
    outRootOwner = -1
    if journalHandle <= 0 ||
       journalHandle > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        err = "production_terminal_journal_recovered_detach_owner_invalid"
        return false
    let row = journalHandle - 1
    if row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalRecoveredRows[row] != 1:
        err = "production_terminal_journal_recovered_detach_owner_invalid"
        return false
    let prior = atomic.LoadI32(productionTerminalJournalStates[row])
    if (prior != ProductionTerminalJournalStateProviderFinalized &&
        prior != ProductionTerminalJournalStateExitObserved &&
        prior != ProductionTerminalJournalStateReaped) ||
       !atomic.CasI32(
           productionTerminalJournalStates[row],
           prior,
           ProductionTerminalJournalStateClosing):
        err = "production_terminal_journal_recovered_detach_phase_invalid"
        return false
    let rootOwner = productionTerminalJournalRootOwnerHandles[row]
    if rootOwner <= 0:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_recovered_root_missing"
        return false
    var releaseErr: str
    if !csgStoreTerminalJournalRootOwnerReleaseRecoveredSessionInto(
           rootOwner, releaseErr):
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = strings.CloneStr(releaseErr)
        return false
    productionTerminalJournalRootOwnerHandles[row] = -1
    atomic.StoreI32(
        productionTerminalJournalStates[row],
        ProductionTerminalJournalStateDetached)
    outRootOwner = rootOwner
    err = ""
    return true

@borrows
fn ProductionTerminalJournalReplayObservationOwner(
        journalHandle: int32): int32 =
    if journalHandle <= 0 ||
       journalHandle > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        return -1
    let row = journalHandle - 1
    let state = atomic.LoadI32(productionTerminalJournalStates[row])
    if state != ProductionTerminalJournalStateExitObserved &&
       state != ProductionTerminalJournalStateReaped:
        return -1
    return productionTerminalJournalObservationOwners[row]

fn productionTerminalJournalDetachForGuardianRecoveryInto(
        handle: int32,
        err: var str): bool =
    if handle <= 0 || handle > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        err = "production_terminal_journal_detach_handle_invalid"
        return false
    let row = handle - 1
    if row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalStates[row] == nil:
        err = "production_terminal_journal_detach_handle_invalid"
        return false
    let prior = atomic.LoadI32(productionTerminalJournalStates[row])
    if prior == ProductionTerminalJournalStateDetached:
        err = ""
        return true
    if (prior != ProductionTerminalJournalStateClaimed &&
        prior != ProductionTerminalJournalStateFinished &&
        prior != ProductionTerminalJournalStateDecision &&
        prior != ProductionTerminalJournalStateRecoveryRequired &&
        prior != ProductionTerminalJournalStateProviderFinalized &&
        prior != ProductionTerminalJournalStateExitObserved &&
        prior != ProductionTerminalJournalStateReaped) ||
       !atomic.CasI32(
           productionTerminalJournalStates[row],
           prior,
           ProductionTerminalJournalStateClosing):
        err = "production_terminal_journal_detach_state_invalid"
        return false
    let recovered = productionTerminalJournalRecoveredRows[row] != 0
    if !recovered &&
       prior != ProductionTerminalJournalStateProviderFinalized &&
       prior != ProductionTerminalJournalStateReaped:
        let transportOwner =
            productionTerminalJournalProviderProofOwners[row]
        if transportOwner > 0:
            if !system.RuntimeHeldExecTerminalCapsuleRoleOwnerAbort(
                   transportOwner):
                atomic.StoreI32(
                    productionTerminalJournalStates[row],
                    ProductionTerminalJournalStateRecoveryRequired)
                err = "production_terminal_journal_transport_abort_failed"
                return false
            productionTerminalJournalProviderProofOwners[row] = -1
        let durableClaimOwner =
            productionTerminalJournalDurableClaimOwners[row]
        if durableClaimOwner > 0:
            var authorityErr: str
            if !ProductionAdmittedClaimAuthorityFailAfterRootMoveInto(
                   durableClaimOwner,
                   authorityErr):
                atomic.StoreI32(
                    productionTerminalJournalStates[row],
                    ProductionTerminalJournalStateRecoveryRequired)
                err = strings.CloneStr(authorityErr)
                return false
            productionTerminalJournalDurableClaimOwners[row] = -1
    var closeError: str
    var released: bool
    if recovered:
        released = csgStoreTerminalJournalRootOwnerReleaseRecoveredSessionInto(
            productionTerminalJournalRootOwnerHandles[row],
            closeError)
    else:
        released = CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
            productionTerminalJournalRootOwnerHandles[row],
            closeError)
    if !released:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = strings.CloneStr(closeError)
        return false
    productionTerminalJournalRootOwnerHandles[row] = -1
    atomic.StoreI32(
        productionTerminalJournalStates[row],
        ProductionTerminalJournalStateDetached)
    err = ""
    return true

fn ProductionTerminalJournalDetachForGuardianRecoveryInto(
        handle: int32,
        err: var str): bool =
    return productionTerminalJournalDetachForGuardianRecoveryInto(
        handle, err)

@borrows
fn productionAdmittedClaimAuthorityFinishInto(
        durableClaimOwner: int32,
        outputPath: str,
        outFinishedProofOwner: var int32,
        outExitPermission0: var int32,
        outExitPermission1: var int32,
        outExitPermission2: var int32,
        outExitPermission3: var int32,
        outReapPermission0: var int32,
        outReapPermission1: var int32,
        outReapPermission2: var int32,
        outReapPermission3: var int32,
        err: var str): bool =
    outFinishedProofOwner = -1
    outExitPermission0 = 0
    outExitPermission1 = 0
    outExitPermission2 = 0
    outExitPermission3 = 0
    outReapPermission0 = 0
    outReapPermission1 = 0
    outReapPermission2 = 0
    outReapPermission3 = 0
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow) ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           ProductionAdmittedClaimOwnerActivated,
           ProductionAdmittedClaimOwnerFinishing):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let slot = productionAdmittedClaimOwnerSlots[ownerRow]
    if slot < 0 || slot >= ProductionAdmittedClaimSlotCount ||
       productionAdmittedClaimOwnerGenerations[ownerRow] !=
           productionAdmittedClaimSlotGenerations[slot]:
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    let capsuleOwner = productionAdmittedClaimOwnerCapsules[ownerRow]
    let runtimeSession = productionAdmittedClaimOwnerSessions[ownerRow]
    var finishedProofOwner: int32
    if capsuleOwner <= 0 || runtimeSession <= 0 ||
       !productionHeldExecTerminalCapsuleFinishInto(
           capsuleOwner,
           runtimeSession,
           outputPath,
           finishedProofOwner,
           outExitPermission0,
           outExitPermission1,
           outExitPermission2,
           outExitPermission3,
           outReapPermission0,
           outReapPermission1,
           outReapPermission2,
           outReapPermission3,
           err):
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        return false
    if !atomic.CasI32(
           productionAdmittedClaimSlotStates[slot],
           ProductionAdmittedClaimStateClaimed,
           ProductionAdmittedClaimStateFinished):
        if finishedProofOwner > 0 &&
           !system.RuntimeHeldExecTerminalCapsuleRoleOwnerAbort(
               finishedProofOwner):
            panic("admitted claim finished transport abort failed")
        outExitPermission0 = 0
        outExitPermission1 = 0
        outExitPermission2 = 0
        outExitPermission3 = 0
        outReapPermission0 = 0
        outReapPermission1 = 0
        outReapPermission2 = 0
        outReapPermission3 = 0
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        system.RuntimeAtomicStoreI32(
            productionAdmittedClaimState,
            ProductionAdmittedClaimStateRecoveryRequired)
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerFinished)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, ProductionAdmittedClaimStateFinished)
    outFinishedProofOwner = finishedProofOwner
    err = ""
    return true

fn ProductionAdmittedClaimAuthorityAbortInto(
        admittedOwner: var int32,
        err: var str): bool =
    var rootOwner: int32
    var bundleOwner: int32
    if !pre_exec.CsgCoreProductionAdmittedInputAbortInto(
           admittedOwner, rootOwner, bundleOwner, err):
        return false
    if bundleOwner > 0:
        if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim authority bundle owner abort failed")
    if rootOwner > 0:
        var closeErr: str
        if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               rootOwner, closeErr):
            panic(strings.ConcatStr(
                "admitted claim authority root close failed: ", closeErr))
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, ProductionAdmittedClaimStateAborted)
    err = ""
    return true

fn ProductionAdmittedClaimAuthorityStateCurrent(): int32 =
    let local = system.RuntimeAtomicLoadI32(productionAdmittedClaimState)
    if local != 0:
        return local
    return pre_exec.CsgCoreProductionAdmittedInputStateCurrent()
