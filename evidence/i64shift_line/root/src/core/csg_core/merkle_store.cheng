const
    CsgMerkleStoreArtifactNode: int32 = 1
    CsgMerkleStoreArtifactPartition: int32 = 2
    CsgMerkleStoreArtifactMembership: int32 = 3
    CsgMerkleStoreArtifactDependency: int32 = 4
    CsgMerkleStoreArtifactSummary: int32 = 5
    CsgMerkleStoreArtifactIndex: int32 = 6
    CsgMerkleStoreArtifactManifest: int32 = 7
    CsgMerkleStoreArtifactProof: int32 = 8
    CsgMerkleStoreArtifactOperation: int32 = 9
    CsgMerkleStoreArtifactReceipt: int32 = 10
    CsgMerkleStoreArtifactRequest: int32 = 11
    CsgMerkleStoreArtifactCanonicalCsgc: int32 = 12
    CsgMerkleStoreHeadDomain: str = "csg_core.store.head"
    CsgMerkleStoreHeadKind: str = "csg.merkle.head"
    CsgMerkleStoreManifestNativeExecutionBindingDomain: str =
        "csg_core.store.manifest_native_execution_binding"
    CsgMerkleStoreTransitionReceiptHeadBindingDomain: str =
        "csg_core.store.transition_receipt_head_binding"
    CsgMerkleStoreSuccessorFile: str = "head.csgc"
    CsgMerkleStoreMaxGeneration: int64 = 9223372036854775806
    CsgMerkleStoreRequestObjectMaxBytes: int64 = 67108864
    CsgMerkleStoreReceiptObjectMaxBytes: int64 = 67108864
    CsgMerkleStoreProofObjectMaxBytes: int64 = 262144
    CsgMerkleStoreOperationObjectMaxBytes: int64 = 1048576
    CsgMerkleStoreNodeObjectMaxBytes: int64 = 1048576
    CsgMerkleStoreGeneralObjectMaxBytes: int64 = 268435456
    CsgMerkleStoreAdmissionObjectBytesLimit: int64 = 536870912
    CsgMerkleStoreAdmissionObjectCountLimit: int32 = 524288
    CsgMerkleStoreAdmissionFactSlotLimit: int32 = 262144
    CsgMerkleStoreAdmissionDependencySlotLimit: int32 = 524288
    CsgMerkleStoreAdmissionQueryBucketLimit: int32 = 256
    CsgMerkleStoreAdmissionQueryRawSlotLimit: int32 = 786432
    CsgMerkleStoreProofPathLimit: int32 = 256

type
    CsgCoreMerkleStorePutResult =
        ok: bool
        error: str
        cid: str
        reused: bool
        writtenBytes: int64

    CsgCoreMerkleStoreReadResult =
        ok: bool
        error: str
        cid: str
        bytes: rawbytes.Bytes

    csgStoreRootVerifyResult =
        ok: bool
        error: str
        storeRoot: str
        reused: bool

    csgStoreObjectLengthResult =
        ok: bool
        error: str
        byteCount: int64

    CsgCoreMerkleHead =
        generation: int64
        manifestCid: str
        previousHeadCid: str
        receiptCid: str
        headCid: str

    CsgCoreMerkleHeadCodecResult =
        ok: bool
        error: str
        head: CsgCoreMerkleHead
        bytes: rawbytes.Bytes

    csgStoreSuccessorReadResult =
        ok: bool
        error: str
        exists: bool
        head: CsgCoreMerkleHead

    CsgCoreMerkleHeadReadResult =
        ok: bool
        error: str
        present: bool
        storeRoot: str
        head: CsgCoreMerkleHead
        manifest: merkle_manifest.CsgCoreMerkleManifest
        storeIdentityCid: str
        beforeStoreIdentity: str
        storeLayoutCid: str
        identityProven: bool

    CsgCoreMerkleManifestOnlyHeadReadResult =
        ok: bool
        error: str
        present: bool
        verificationScope: str
        fullClosureVerified: bool
        productionAdmission: bool
        generationRecordsRead: int32
        objectsRead: int32
        storeRoot: str
        head: CsgCoreMerkleHead
        manifest: merkle_manifest.CsgCoreMerkleManifest

    CsgCoreMerkleHistoricalGenerationRecord =
        generation: int64
        headCid: str
        previousHeadCid: str
        receiptCid: str
        manifestCid: str
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaCid: str
        factsRoot: str
        factCount: int32
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str

    CsgCoreMerkleHistoricalAuthorityReadResult =
        ok: bool
        error: str
        verificationScope: str
        fullHistoryVerified: bool
        successorChainVerified: bool
        receiptChainVerified: bool
        manifestClosuresVerified: bool
        storeRoot: str
        currentGeneration: int64
        currentHeadCid: str
        currentManifestCid: str
        generations: CsgCoreMerkleHistoricalGenerationRecord[]

    CsgCoreMerkleStoreShardedInvalidationResult =
        ok: bool
        error: str
        dependencyObjectsDecoded: int32
        invalidation:
            merkle_invalidation.CsgCoreMerkleInvalidationResult

    csgStoreSourceProjection =
        sourceId: str
        sourceCid: str
        factKeys: str[]
        factCids: str[]
        facts: str[]

    csgStoreAdmissionResourceBudget =
        sourceLimit: int32
        factSlotLimit: int32
        dependencySlotLimit: int32
        operationLimit: int32
        proofLimit: int32
        nodeLimit: int32
        queryBucketLimit: int32
        queryRawSlotLimit: int32
        objectCountLimit: int32
        objectBytesLimit: int64
        factSlots: int32
        dependencySlots: int32
        operationSlots: int32
        proofSlots: int32
        nodeSlots: int32
        queryRawSlots: int32
        objectCount: int32
        objectBytes: int64

    csgStoreManifestDependencyIndex =
        sourceIds: str[]
        providerBindings: str[]
        partitionIdentities: str[]
        partitionPositions: int32[]
        consumerShardKeys: str[]
        consumerShardPositions: int32[]
        providerShardKeys: str[]
        providerShardPositions: int32[]

@borrows
fn csgStoreCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgStoreCat3(
        a: str,
        b: str,
        c: str): str =
    return csgStoreCat(csgStoreCat(a, b), c)

@borrows
fn csgStoreJoin(a: str, b: str): str =
    return os.JoinPath(a, b)

@borrows
fn csgStoreCidName(cid: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreCidName(cid)

fn CsgCoreMerkleStoreNodeArtifactKind(): int32 =
    return CsgMerkleStoreArtifactNode

fn CsgCoreMerkleStorePartitionArtifactKind(): int32 =
    return CsgMerkleStoreArtifactPartition

fn CsgCoreMerkleStoreMembershipArtifactKind(): int32 =
    return CsgMerkleStoreArtifactMembership

fn CsgCoreMerkleStoreDependencyArtifactKind(): int32 =
    return CsgMerkleStoreArtifactDependency

fn CsgCoreMerkleStoreSummaryArtifactKind(): int32 =
    return CsgMerkleStoreArtifactSummary

fn CsgCoreMerkleStoreIndexArtifactKind(): int32 =
    return CsgMerkleStoreArtifactIndex

fn CsgCoreMerkleStoreManifestArtifactKind(): int32 =
    return CsgMerkleStoreArtifactManifest

fn CsgCoreMerkleStoreProofArtifactKind(): int32 =
    return CsgMerkleStoreArtifactProof

fn CsgCoreMerkleStoreOperationArtifactKind(): int32 =
    return CsgMerkleStoreArtifactOperation

fn CsgCoreMerkleStoreReceiptArtifactKind(): int32 =
    return CsgMerkleStoreArtifactReceipt

fn CsgCoreMerkleStoreRequestArtifactKind(): int32 =
    return CsgMerkleStoreArtifactRequest

fn CsgCoreMerkleStoreCanonicalCsgcArtifactKind(): int32 =
    return CsgMerkleStoreArtifactCanonicalCsgc

fn csgStoreArtifactCategory(kind: int32): str =
    if kind == CsgMerkleStoreArtifactNode:
        return "nodes"
    if kind == CsgMerkleStoreArtifactPartition:
        return "partitions"
    if kind == CsgMerkleStoreArtifactMembership:
        return "memberships"
    if kind == CsgMerkleStoreArtifactDependency:
        return "dependencies"
    if kind == CsgMerkleStoreArtifactSummary:
        return "summaries"
    if kind == CsgMerkleStoreArtifactIndex:
        return "indexes"
    if kind == CsgMerkleStoreArtifactManifest:
        return "manifests"
    if kind == CsgMerkleStoreArtifactProof:
        return "proofs"
    if kind == CsgMerkleStoreArtifactOperation:
        return "operations"
    if kind == CsgMerkleStoreArtifactReceipt:
        return "receipts"
    if kind == CsgMerkleStoreArtifactRequest:
        return "requests"
    if kind == CsgMerkleStoreArtifactCanonicalCsgc:
        return "csgc_objects"
    return ""

@borrows
fn CsgCoreMerkleStoreCanonicalCsgcRelativePath(
        objectCid: str): str =
    let objectName = csgStoreCidName(objectCid)
    if objectName.len == 0:
        return ""
    return csgStoreJoin(
        csgStoreJoin("csgc_objects", objectName),
        "object.csgc")

@borrows
fn csgStoreCanonicalCsgcMapFail(
        error: str):
        merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult =
    var out: merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleStoreMapCanonicalCsgcObject(
        storeRoot: str,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest):
        merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult =
    if !os.IsAbsolute(storeRoot):
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_root_invalid")
    let relativePath =
        CsgCoreMerkleStoreCanonicalCsgcRelativePath(
            manifest.csgcObjectCid)
    if relativePath.len == 0 || manifest.csgcByteCount < 64:
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_identity_invalid")
    let parent =
        csgStoreJoin(storeRoot, "csgc_objects")
    let opened =
        os.AtomicTreeOpenVerified(
            parent,
            csgStoreCidName(manifest.csgcObjectCid))
    if result.IsErr(opened):
        return csgStoreCanonicalCsgcMapFail(
            csgStoreCat(
                "merkle_store_canonical_csgc_map_open ",
                result.Error(opened)))
    let tree = result.Value(opened)
    let exact =
        os.AtomicTreeVerifyExact(
            tree, [], ["object.csgc"])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(tree)
        if result.IsErr(closed):
            return csgStoreCanonicalCsgcMapFail(
                "merkle_store_canonical_csgc_map_shape_close_failed")
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_shape_invalid")
    let mapped =
        os.AtomicTreeMapReadOnly(tree, "object.csgc")
    if result.IsErr(mapped):
        let closed = os.AtomicTreeClose(tree)
        if result.IsErr(closed):
            return csgStoreCanonicalCsgcMapFail(
                "merkle_store_canonical_csgc_map_open_close_failed")
        return csgStoreCanonicalCsgcMapFail(
            csgStoreCat(
                "merkle_store_canonical_csgc_map_file ",
                result.Error(mapped)))
    let region = result.Value(mapped)
    let closed = os.AtomicTreeClose(tree)
    if result.IsErr(closed):
        let regionClosed =
            os.ReadOnlyMappedRegionClose(region)
        if result.IsErr(regionClosed):
            panic(
                "merkle_store_canonical_csgc_map_tree_and_region_close_failed")
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_tree_close_failed")
    let byteLength =
        os.ReadOnlyMappedRegionByteLength(region)
    if result.IsErr(byteLength) ||
       result.Value(byteLength) !=
           int64(manifest.csgcByteCount):
        let regionClosed =
            os.ReadOnlyMappedRegionClose(region)
        if result.IsErr(regionClosed):
            panic(
                "merkle_store_canonical_csgc_map_length_close_failed")
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_length_mismatch")
    let hashDomain =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectDomain()
    let bound =
        os.ReadOnlyMappedRegionBindSha256Framed(
            region,
            hashDomain,
            manifest.csgcObjectCid)
    if result.IsErr(bound):
        let regionClosed =
            os.ReadOnlyMappedRegionClose(region)
        if result.IsErr(regionClosed):
            panic(
                "merkle_store_canonical_csgc_map_bind_close_failed")
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_cid_mismatch")
    let digestCount =
        os.ReadOnlyMappedRegionFullDigestCount(region)
    if result.IsErr(digestCount) ||
       result.Value(digestCount) != 1:
        let regionClosed =
            os.ReadOnlyMappedRegionClose(region)
        if result.IsErr(regionClosed):
            panic(
                "merkle_store_canonical_csgc_map_digest_close_failed")
        return csgStoreCanonicalCsgcMapFail(
            "merkle_store_canonical_csgc_map_digest_count_invalid")
    var out: merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult
    out.ok = true
    out.artifactKind = CsgMerkleStoreArtifactCanonicalCsgc
    out.hashDomain = hashDomain
    out.objectCid = strings.CloneStr(manifest.csgcObjectCid)
    out.byteCount = manifest.csgcByteCount
    out.storeRelativePath = relativePath
    out.region = region
    return out

@borrows
fn csgStorePutFail(
        error: str): CsgCoreMerkleStorePutResult =
    var out: CsgCoreMerkleStorePutResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreReadFail(
        error: str): CsgCoreMerkleStoreReadResult =
    var out: CsgCoreMerkleStoreReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreObjectLengthFail(
        error: str): csgStoreObjectLengthResult =
    var out: csgStoreObjectLengthResult
    out.error = strings.CloneStr(error)
    return out

fn csgStoreArtifactByteLimit(kind: int32): int64 =
    if kind == CsgMerkleStoreArtifactRequest:
        return CsgMerkleStoreRequestObjectMaxBytes
    if kind == CsgMerkleStoreArtifactReceipt:
        return CsgMerkleStoreReceiptObjectMaxBytes
    if kind == CsgMerkleStoreArtifactProof:
        return CsgMerkleStoreProofObjectMaxBytes
    if kind == CsgMerkleStoreArtifactOperation:
        return CsgMerkleStoreOperationObjectMaxBytes
    if kind == CsgMerkleStoreArtifactNode:
        return CsgMerkleStoreNodeObjectMaxBytes
    return CsgMerkleStoreGeneralObjectMaxBytes

@borrows
fn csgStoreArtifactCid(
        kind: int32,
        bytes: rawbytes.Bytes,
        error: var str): str =
    error = ""
    if kind == CsgMerkleStoreArtifactNode:
        var decoded =
            merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
                bytes)
        if !decoded.ok || decoded.nodes.len != 1:
            error = decoded.error
            if error.len == 0:
                error =
                    "merkle_store_node_object_cardinality_invalid"
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let semanticCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                decoded.nodes[0])
        rawbytes.BytesFree(decoded.bytes)
        return semanticCid
    if kind == CsgMerkleStoreArtifactPartition:
        var decoded =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactMembership:
        var decoded =
            merkle_artifacts.CsgCoreMerkleMembershipDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactDependency:
        var decoded =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactSummary:
        var decoded =
            merkle_artifacts.CsgCoreMerkleSummaryDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactIndex:
        var decoded =
            merkle_artifacts.CsgCoreMerkleQueryShardDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactManifest:
        var decoded =
            merkle_manifest.CsgCoreMerkleManifestDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            return ""
        return strings.CloneStr(decoded.cid)
    if kind == CsgMerkleStoreArtifactProof:
        var decoded =
            merkle_cargo.CsgCoreMerkleProofDecodeSelfCsgc(
                bytes)
        if !decoded.ok:
            error = decoded.error
            return ""
        return strings.CloneStr(decoded.cid)
    if kind == CsgMerkleStoreArtifactOperation:
        var decoded =
            merkle_transaction_operation.CsgCoreMerkleTransactionOperationDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactReceipt:
        var decoded =
            merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptDecode(
                bytes)
        if !decoded.ok:
            error = decoded.error
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactRequest:
        return merkle_transaction_request.CsgCoreMerkleTransactionRequestArtifactCid(
            bytes, error)
    if kind == CsgMerkleStoreArtifactCanonicalCsgc:
        let claim = csgc.CsgCoreCsgcClaimDirectory(bytes)
        let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
        if !claim.ok || !decoded.ok ||
           claim.factCount != decoded.factCount:
            error = "merkle_store_canonical_csgc_invalid"
            return ""
        return merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            bytes)
    error = "merkle_store_artifact_kind_invalid"
    return ""

@borrows
fn CsgCoreMerkleStoreArtifactCid(
        kind: int32,
        bytes: rawbytes.Bytes,
        error: var str): str =
    return csgStoreArtifactCid(
        kind, bytes, error)

@borrows
fn csgStoreObjectLength(
        storeRoot: str,
        kind: int32,
        expectedCid: str): csgStoreObjectLengthResult =
    if !os.IsAbsolute(storeRoot):
        return csgStoreObjectLengthFail(
            "merkle_store_root_not_absolute")
    let category = csgStoreArtifactCategory(kind)
    let finalName = csgStoreCidName(expectedCid)
    if category.len == 0 || finalName.len == 0:
        return csgStoreObjectLengthFail(
            "merkle_store_object_identity_invalid")
    let parent = csgStoreJoin(storeRoot, category)
    let opened = os.AtomicTreeOpenVerified(parent, finalName)
    if result.IsErr(opened):
        return csgStoreObjectLengthFail(
            "merkle_store_object_length_open_failed")
    let handle = result.Value(opened)
    let exact = os.AtomicTreeVerifyExact(
        handle, [], ["object.csgc"])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreObjectLengthFail(
                "merkle_store_object_length_shape_close_failed")
        return csgStoreObjectLengthFail(
            "merkle_store_object_length_shape_invalid")
    let mapped = os.AtomicTreeMapReadOnly(
        handle, "object.csgc")
    if result.IsErr(mapped):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreObjectLengthFail(
                "merkle_store_object_length_map_close_failed")
        return csgStoreObjectLengthFail(
            "merkle_store_object_length_map_failed")
    let region = result.Value(mapped)
    let byteLength = os.ReadOnlyMappedRegionByteLength(region)
    let regionClosed = os.ReadOnlyMappedRegionClose(region)
    let treeClosed = os.AtomicTreeClose(handle)
    if result.IsErr(regionClosed) || result.IsErr(treeClosed):
        return csgStoreObjectLengthFail(
            "merkle_store_object_length_close_failed")
    if result.IsErr(byteLength):
        return csgStoreObjectLengthFail(
            "merkle_store_object_length_unavailable")
    let count = result.Value(byteLength)
    let limit = csgStoreArtifactByteLimit(kind)
    if count <= 0 || count > limit:
        return csgStoreObjectLengthFail(
            "merkle_store_object_byte_limit_exceeded")
    var out: csgStoreObjectLengthResult
    out.ok = true
    out.byteCount = count
    return out

@borrows
fn csgStoreReadObjectRaw(
        storeRoot: str,
        kind: int32,
        expectedCid: str):
        CsgCoreMerkleStoreReadResult =
    let boundedLength =
        csgStoreObjectLength(
            storeRoot, kind, expectedCid)
    if !boundedLength.ok:
        return csgStoreReadFail(strings.CloneStr(boundedLength.error))
    if !os.IsAbsolute(storeRoot):
        return csgStoreReadFail(
            "merkle_store_root_not_absolute")
    let category =
        csgStoreArtifactCategory(kind)
    let finalName = csgStoreCidName(expectedCid)
    if category.len == 0 || finalName.len == 0:
        return csgStoreReadFail(
            "merkle_store_object_identity_invalid")
    let parent =
        csgStoreJoin(storeRoot, category)
    let opened =
        os.AtomicTreeOpenVerified(
            parent, finalName)
    if result.IsErr(opened):
        return csgStoreReadFail(
            csgStoreCat(
                "merkle_store_object_open ",
                result.Error(opened)))
    let handle = result.Value(opened)
    let exact =
        os.AtomicTreeVerifyExact(
            handle, [], ["object.csgc"])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreReadFail(
                "merkle_store_object_shape_and_close_failed")
        return csgStoreReadFail(
            "merkle_store_object_shape_invalid")
    let read =
        os.AtomicTreeReadStable(
            handle, "object.csgc")
    if result.IsErr(read):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreReadFail(
                "merkle_store_object_read_and_close_failed")
        return csgStoreReadFail(
            "merkle_store_object_read_failed")
    var bytes = result.Value(read)
    if int64(rawbytes.BytesLen(bytes)) !=
       boundedLength.byteCount:
        rawbytes.BytesFree(bytes)
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreReadFail(
                "merkle_store_object_length_drift_and_close_failed")
        return csgStoreReadFail(
            "merkle_store_object_length_drift")
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        rawbytes.BytesFree(bytes)
        return csgStoreReadFail(
            "merkle_store_object_close_failed")
    var out: CsgCoreMerkleStoreReadResult
    out.ok = true
    out.cid = strings.CloneStr(expectedCid)
    out.bytes = bytes
    return out

@borrows
fn CsgCoreMerkleStoreReadObject(
        storeRoot: str,
        kind: int32,
        expectedCid: str):
        CsgCoreMerkleStoreReadResult =
    var raw =
        csgStoreReadObjectRaw(
            storeRoot, kind, expectedCid)
    if !raw.ok:
        return raw
    var cidError: str
    let actualCid =
        csgStoreArtifactCid(
            kind, raw.bytes, cidError)
    if cidError.len > 0 ||
       actualCid != expectedCid:
        rawbytes.BytesFree(raw.bytes)
        return csgStoreReadFail(
            "merkle_store_object_cid_mismatch")
    var out: CsgCoreMerkleStoreReadResult
    out.ok = true
    out.cid = strings.CloneStr(actualCid)
    out.bytes = raw.bytes
    return out

@borrows
fn CsgCoreMerkleStorePutPreparedObject(
        session:
            var merkle_transaction_authority.CsgCoreMerklePrepublishSession):
        CsgCoreMerkleStorePutResult =
    let committed =
        merkle_transaction_authority.CsgCoreMerkleTransactionStoreNextArtifact(
            session)
    if !committed.ok:
        return csgStorePutFail(committed.error)
    var out: CsgCoreMerkleStorePutResult
    out.ok = true
    out.cid = strings.CloneStr(committed.cid)
    out.reused = committed.reused
    out.writtenBytes = committed.writtenBytes
    return out

fn CsgCoreMerkleStoreCommitPreparedSession(
        session:
            var merkle_transaction_authority.CsgCoreMerklePrepublishSession):
        merkle_transaction_authority.CsgCoreMerkleTransactionCommitSessionResult =
    # Publisher gate (domain C): a successor publish is only reachable while
    # this process holds a live exclusive current-HEAD lease, acquired before
    # the expected-HEAD read in the plan phase.  No lease => HARD_RED.
    if !CsgCoreMerkleStoreCurrentHeadLeaseExclusiveLive():
        var denied: merkle_transaction_authority.CsgCoreMerkleTransactionCommitSessionResult
        denied.error =
            "HARD_RED:csg_store_head_publish_lease_required"
        return denied
    return merkle_transaction_authority.CsgCoreMerkleTransactionCommitSession(
        session)

@borrows
fn csgStoreRootVerifyFail(
        error: str):
        csgStoreRootVerifyResult =
    var out: csgStoreRootVerifyResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreMarkerBytes(
        markerKind: str,
        markerId: str):
        rawbytes.Bytes =
    var line: str = "{\"id\":"
    line = csgStoreCat(
        line,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            markerId))
    line = csgStoreCat(line, ",\"kind\":")
    line = csgStoreCat(
        line,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            markerKind))
    line = csgStoreCat(line, "}")
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            [line])
    if !encoded.ok:
        return rawbytes.EmptyBytes()
    var out =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(encoded.bytes))
    rawbytes.BytesCopyInto(
        out, 0, encoded.bytes)
    rawbytes.BytesFree(encoded.bytes)
    return out

@borrows
fn csgStoreMarkerMatches(
        handle: os.AtomicTree,
        path: str,
        markerKind: str,
        markerId: str): bool =
    let read =
        os.AtomicTreeReadStable(handle, path)
    if result.IsErr(read):
        return false
    var actual = result.Value(read)
    var expected =
        csgStoreMarkerBytes(
            markerKind, markerId)
    let same =
        rawbytes.BytesEqual(actual, expected)
    rawbytes.BytesFree(actual)
    rawbytes.BytesFree(expected)
    return same

@borrows
fn csgStoreVerifyRoot(
        parentPath: str,
        storeName: str):
        csgStoreRootVerifyResult =
    let opened =
        os.AtomicTreeOpenVerified(
            parentPath, storeName)
    if result.IsErr(opened):
        return csgStoreRootVerifyFail(
            result.Error(opened))
    let handle = result.Value(opened)
    let categories =
        merkle_store_identity.CsgCoreMerkleStoreExpectedRootDirectories()
    let expectedFiles =
        merkle_store_identity.CsgCoreMerkleStoreExpectedRootFiles()
    let exact =
        os.AtomicTreeVerifyRootExact(
            handle,
            categories,
            expectedFiles)
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreRootVerifyFail(
                "merkle_store_root_shape_and_close_failed")
        return csgStoreRootVerifyFail(
            "merkle_store_root_shape_invalid")
    var ok =
        csgStoreMarkerMatches(
            handle,
            "store.csgc",
            "csg.merkle.store",
            merkle_store_identity.CsgCoreMerkleStoreLayoutIdentity())
    for i in 0..<categories.len:
        if ok:
            ok = csgStoreMarkerMatches(
                handle,
                csgStoreJoin(
                    categories[i],
                    "category.csgc"),
                "csg.merkle.store_category",
                categories[i])
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        return csgStoreRootVerifyFail(
            "merkle_store_root_close_failed")
    if !ok:
        return csgStoreRootVerifyFail(
            "merkle_store_root_marker_mismatch")
    var out: csgStoreRootVerifyResult
    out.ok = true
    out.reused = true
    out.storeRoot =
        csgStoreJoin(parentPath, storeName)
    return out

@borrows
fn csgStoreHeadCodecFail(
        error: str):
        CsgCoreMerkleHeadCodecResult =
    var out: CsgCoreMerkleHeadCodecResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreHeadReadFail(
        error: str):
        CsgCoreMerkleHeadReadResult =
    var out: CsgCoreMerkleHeadReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreManifestOnlyHeadReadFail(
        error: str):
        CsgCoreMerkleManifestOnlyHeadReadResult =
    var out: CsgCoreMerkleManifestOnlyHeadReadResult
    out.error = strings.CloneStr(error)
    out.verificationScope = "manifest_only"
    return out

@borrows
fn csgStoreHistoricalAuthorityReadFail(
        error: str):
        CsgCoreMerkleHistoricalAuthorityReadResult =
    var out: CsgCoreMerkleHistoricalAuthorityReadResult
    out.error = strings.CloneStr(error)
    out.verificationScope = "full_history"
    return out

@borrows
fn csgStoreManifestStagedFail(
        error: str):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var out: merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult
    out.error = strings.CloneStr(error)
    out.productionReady = false
    if strings.HasPrefix(error, "HARD_RED:"):
        out.hardRed = strings.CloneStr(error)
    return out

@borrows
fn csgStoreAppendU64BE(
        out: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(out, int32((value >> 56) & int64(255)))
    layout.ByteBufAppendByte(out, int32((value >> 48) & int64(255)))
    layout.ByteBufAppendByte(out, int32((value >> 40) & int64(255)))
    layout.ByteBufAppendByte(out, int32((value >> 32) & int64(255)))
    layout.ByteBufAppendByte(out, int32((value >> 24) & int64(255)))
    layout.ByteBufAppendByte(out, int32((value >> 16) & int64(255)))
    layout.ByteBufAppendByte(out, int32((value >> 8) & int64(255)))
    layout.ByteBufAppendByte(out, int32(value & int64(255)))

@borrows
fn csgStoreManifestNativeBindingCid(
        expectedManifestCid: str,
        executionRaw32: layout.FixedBytes32,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest): str =
    var expectedRaw32: layout.FixedBytes32
    var factsRootRaw32: layout.FixedBytes32
    var csgcObjectRaw32: layout.FixedBytes32
    var csgcDirectoryRaw32: layout.FixedBytes32
    var profileSetRaw32: layout.FixedBytes32
    var schemaRaw32: layout.FixedBytes32
    if !merkle_store_codec.csgStoreCodecParseCid(
           expectedManifestCid, expectedRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           manifest.factsRoot, factsRootRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           manifest.csgcObjectCid, csgcObjectRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           manifest.csgcDirectoryCid, csgcDirectoryRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           manifest.profileSetCid, profileSetRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           manifest.schemaCid, schemaRaw32):
        return ""
    var buf = layout.ByteBufInit(232)
    layout.ByteBufAppendFixed32(buf, executionRaw32)
    layout.ByteBufAppendFixed32(buf, expectedRaw32)
    layout.ByteBufAppendFixed32(buf, factsRootRaw32)
    layout.ByteBufAppendFixed32(buf, csgcObjectRaw32)
    layout.ByteBufAppendFixed32(buf, csgcDirectoryRaw32)
    layout.ByteBufAppendFixed32(buf, profileSetRaw32)
    layout.ByteBufAppendFixed32(buf, schemaRaw32)
    csgStoreAppendU64BE(buf, int64(manifest.factCount))
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    let bindingCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleStoreManifestNativeExecutionBindingDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    return bindingCid

@borrows
fn csgStoreTransitionReceiptHeadBindingCid(
        transactionReceiptCid: str,
        beforeHeadCid: str,
        afterHeadCid: str,
        bindingCid: var str): bool =
    var receiptRaw32: layout.FixedBytes32
    var beforeRaw32: layout.FixedBytes32
    var afterRaw32: layout.FixedBytes32
    if !merkle_store_codec.csgStoreCodecParseCid(
           transactionReceiptCid, receiptRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           beforeHeadCid, beforeRaw32) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           afterHeadCid, afterRaw32):
        return false
    var buf = layout.ByteBufInit(96)
    layout.ByteBufAppendFixed32(buf, receiptRaw32)
    layout.ByteBufAppendFixed32(buf, beforeRaw32)
    layout.ByteBufAppendFixed32(buf, afterRaw32)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    bindingCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleStoreTransitionReceiptHeadBindingDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(
        bindingCid)

@borrows
fn csgStoreConsumeManifestObject(
        storeRoot: str,
        artifactKind: int32,
        objectKind: str,
        objectIndex: int32,
        expectedCid: str,
        state: var
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedState,
        error: var str): bool =
    var loaded =
        csgStoreReadObjectRaw(
            storeRoot, artifactKind, expectedCid)
    if !loaded.ok:
        error = csgStoreCat(
            "merkle_store_manifest_object_read ",
            loaded.error)
        return false
    let consumed =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
            state,
            objectKind,
            objectIndex,
            expectedCid,
            loaded.bytes)
    rawbytes.BytesFree(loaded.bytes)
    if !consumed:
        error = strings.CloneStr(state.error)
        return false
    error = ""
    return true

@borrows
fn csgStoreConsumeManifestInventory(
        storeRoot: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        state: var
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedState,
        identity: var
            merkle_store_identity.CsgCoreMerkleStoreIdentityRecord,
        error: var str): bool =
    if !csgStoreConsumeManifestObject(
           storeRoot,
           CsgMerkleStoreArtifactCanonicalCsgc,
           merkle_manifest_verifier.CsgCoreMerkleManifestCanonicalCsgcObjectKind(),
           0,
           manifest.csgcObjectCid,
           state,
           error):
        return false
    for i in 0..<manifest.partitions.len:
        if !csgStoreConsumeManifestObject(
               storeRoot,
               CsgMerkleStoreArtifactPartition,
               merkle_manifest_verifier.CsgCoreMerkleManifestPartitionFactsObjectKind(),
               i,
               manifest.partitions[i].factsCid,
               state,
               error):
            return false
    for i in 0..<manifest.partitions.len:
        if !csgStoreConsumeManifestObject(
               storeRoot,
               CsgMerkleStoreArtifactMembership,
               merkle_manifest_verifier.CsgCoreMerkleManifestMembershipObjectKind(),
               i,
               manifest.partitions[i].membershipCid,
               state,
               error):
            return false
    for i in 0..<manifest.nodeCount:
        var nextKind: str
        var nextIndex: int32
        var nextCid: str
        if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedNextObjectIdentity(
               state, nextKind, nextIndex, nextCid) ||
           nextKind !=
               merkle_manifest_verifier.CsgCoreMerkleManifestNodeObjectKind() ||
           nextIndex != i:
            error = "merkle_store_node_inventory_identity_unavailable"
            return false
        if !csgStoreConsumeManifestObject(
               storeRoot,
               CsgMerkleStoreArtifactNode,
               nextKind,
               i,
               nextCid,
               state,
               error):
            return false
    for i in 0..<manifest.dependencyConsumerShards.len:
        if !csgStoreConsumeManifestObject(
               storeRoot,
               CsgMerkleStoreArtifactDependency,
               merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind(),
               i,
               manifest.dependencyConsumerShards[i].cid,
               state,
               error):
            return false
    for i in 0..<manifest.dependencyProviderShards.len:
        if !csgStoreConsumeManifestObject(
               storeRoot,
               CsgMerkleStoreArtifactDependency,
               merkle_manifest_verifier.CsgCoreMerkleManifestDependencyProviderObjectKind(),
               i,
               manifest.dependencyProviderShards[i].cid,
               state,
               error):
            return false
    if !csgStoreConsumeManifestObject(
           storeRoot,
           CsgMerkleStoreArtifactSummary,
           merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind(),
           0,
           manifest.summaryCid,
           state,
           error):
        return false
    for i in 0..<manifest.queryShards.len:
        if !csgStoreConsumeManifestObject(
               storeRoot,
               CsgMerkleStoreArtifactIndex,
               merkle_manifest_verifier.CsgCoreMerkleManifestQueryShardObjectKind(),
               i,
               manifest.queryShards[i].cid,
               state,
               error):
            return false
    if !merkle_store_identity.CsgCoreMerkleStoreIdentityReadVerifiedRecord(
           storeRoot, identity, error):
        return false
    error = ""
    return true

@borrows
fn CsgCoreMerkleStoreVerifyManifestClosureLogical(
        storeRoot: str,
        expectedManifestCid: str,
        manifest: var
            merkle_manifest.CsgCoreMerkleManifest):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var manifestObject = csgStoreReadObjectRaw(
        storeRoot,
        CsgMerkleStoreArtifactManifest,
        expectedManifestCid)
    if !manifestObject.ok:
        return csgStoreManifestStagedFail(
            csgStoreCat(
                "merkle_store_manifest_read ",
                manifestObject.error))
    var decoded = merkle_manifest.CsgCoreMerkleManifestDecode(
        manifestObject.bytes)
    if !decoded.ok || decoded.cid != expectedManifestCid:
        rawbytes.BytesFree(manifestObject.bytes)
        return csgStoreManifestStagedFail(
            "merkle_store_manifest_identity_mismatch")
    let storedManifest = decoded.manifest
    decoded.lines = []
    var state: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let begun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            expectedManifestCid,
            manifestObject.bytes,
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
            state)
    rawbytes.BytesFree(manifestObject.bytes)
    if !begun:
        return merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            state)
    var storeIdentity: merkle_store_identity.CsgCoreMerkleStoreIdentityRecord
    var consumeError: str
    if !csgStoreConsumeManifestInventory(
           storeRoot,
           storedManifest,
           state,
           storeIdentity,
           consumeError):
        let released =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                state)
        return csgStoreManifestStagedFail(consumeError)
    var logical =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            state)
    if logical.ok:
        manifest = storedManifest
        logical.storeIdentityCid =
            strings.CloneStr(storeIdentity.recordCid)
        logical.beforeStoreIdentity =
            strings.CloneStr(storeIdentity.beforeStoreIdentity)
        logical.storeLayoutCid =
            strings.CloneStr(storeIdentity.storeLayoutCid)
        logical.storeIdentityProven = true
    return logical

@borrows
fn csgStoreVerifyManifestClosure(
        storeRoot: str,
        expectedManifestCid: str,
        executionIdentity:
            execution_receipt.CompilerExecutionIdentity,
        manifest: var
            merkle_manifest.CsgCoreMerkleManifest):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var logicalManifest: merkle_manifest.CsgCoreMerkleManifest
    var logical = CsgCoreMerkleStoreVerifyManifestClosureLogical(
        storeRoot, expectedManifestCid, logicalManifest)
    if !logical.ok:
        return logical
    let identityVerified =
        execution_receipt.CompilerExecutionIdentityVerify(
            executionIdentity)
    if result.IsErr(identityVerified):
        return csgStoreManifestStagedFail(
            result.Error(identityVerified))
    var bindingCid = csgStoreManifestNativeBindingCid(
        expectedManifestCid,
        executionIdentity.executionRaw32,
        logicalManifest)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(bindingCid):
        return csgStoreManifestStagedFail(
            "HARD_RED:merkle_store_native_execution_identity_binding_invalid")
    logical.nativeExecutionIdentityCid = bindingCid
    logical.nativeExecutionIdentityProven = true
    logical.executionReceiptBound = true
    logical.hardRed = ""
    manifest = logicalManifest
    return logical

@borrows
fn CsgCoreMerkleHeadEncodeWithReceipt(
        generation: int64,
        manifestCid: str,
        previousHeadCid: str,
        receiptCid: str):
        CsgCoreMerkleHeadCodecResult =
    let encoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            generation,
            manifestCid,
            previousHeadCid,
            receiptCid)
    if !encoded.ok:
        return csgStoreHeadCodecFail(encoded.error)
    var out: CsgCoreMerkleHeadCodecResult
    out.ok = true
    out.head.generation = encoded.head.generation
    out.head.manifestCid = encoded.head.manifestCid
    out.head.previousHeadCid = encoded.head.previousHeadCid
    out.head.receiptCid = encoded.head.receiptCid
    out.head.headCid = encoded.head.headCid
    out.bytes = encoded.bytes
    return out

@borrows
fn CsgCoreMerkleHeadEncode(
        generation: int64,
        manifestCid: str,
        previousHeadCid: str):
        CsgCoreMerkleHeadCodecResult =
    return CsgCoreMerkleHeadEncodeWithReceipt(
        generation,
        manifestCid,
        previousHeadCid,
        "none")

@borrows
fn CsgCoreMerkleHeadDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleHeadCodecResult =
    let decoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadDecode(bytes)
    if !decoded.ok:
        return csgStoreHeadCodecFail(decoded.error)
    var out: CsgCoreMerkleHeadCodecResult
    out.ok = true
    out.head.generation = decoded.head.generation
    out.head.manifestCid = decoded.head.manifestCid
    out.head.previousHeadCid = decoded.head.previousHeadCid
    out.head.receiptCid = decoded.head.receiptCid
    out.head.headCid = decoded.head.headCid
    return out

@borrows
fn CsgCoreMerkleHeadCodecResultDrop(
        result: var CsgCoreMerkleHeadCodecResult) =
    # Local mirror of CsgCoreMerkleStoreHeadCodecResultDrop for this module's
    # head codec result record: deterministic release before the caller's next
    # decode allocations instead of overwrite-time release.
    var dropError = result.error
    var dropManifestCid = result.head.manifestCid
    var dropPreviousHeadCid = result.head.previousHeadCid
    var dropReceiptCid = result.head.receiptCid
    var dropHeadCid = result.head.headCid
    var dropBytes = result.bytes
    result.error = ""
    result.head = CsgCoreMerkleHead()
    result.bytes = rawbytes.Bytes()

@borrows
fn csgStoreHeadsEqual(
        left: CsgCoreMerkleHead,
        right: CsgCoreMerkleHead): bool =
    return left.generation == right.generation &&
        left.manifestCid == right.manifestCid &&
        left.previousHeadCid == right.previousHeadCid &&
        left.receiptCid == right.receiptCid &&
        left.headCid == right.headCid

@borrows
fn csgStoreSuccessorReadFail(
        error: str): csgStoreSuccessorReadResult =
    var out: csgStoreSuccessorReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreSuccessorName(
        previousHeadCid: str): str =
    if previousHeadCid == "none":
        return "genesis"
    return csgStoreCidName(previousHeadCid)

@borrows
fn csgStoreReadSuccessor(
        storeRoot: str,
        previousHeadCid: str):
        csgStoreSuccessorReadResult =
    if !os.IsAbsolute(storeRoot):
        return csgStoreSuccessorReadFail(
            "merkle_store_successor_root_invalid")
    let successorName =
        csgStoreSuccessorName(previousHeadCid)
    if successorName.len == 0:
        return csgStoreSuccessorReadFail(
            "merkle_store_successor_predecessor_invalid")
    let successorsPath =
        csgStoreJoin(storeRoot, "successors")
    let successorPath =
        csgStoreJoin(successorsPath, successorName)
    if !os.DirExists(successorPath):
        if os.FileExists(successorPath):
            return csgStoreSuccessorReadFail(
                "merkle_store_successor_shape_invalid")
        var absent: csgStoreSuccessorReadResult
        absent.ok = true
        return absent
    let opened =
        os.AtomicTreeOpenVerified(
            successorsPath, successorName)
    if result.IsErr(opened):
        return csgStoreSuccessorReadFail(
            csgStoreCat(
                "merkle_store_successor_open ",
                result.Error(opened)))
    let handle = result.Value(opened)
    let exact =
        os.AtomicTreeVerifyExact(
            handle, [], [CsgMerkleStoreSuccessorFile])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreSuccessorReadFail(
                "merkle_store_successor_shape_and_close_failed")
        return csgStoreSuccessorReadFail(
            "merkle_store_successor_shape_invalid")
    let read =
        os.AtomicTreeReadStable(
            handle, CsgMerkleStoreSuccessorFile)
    if result.IsErr(read):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            return csgStoreSuccessorReadFail(
                "merkle_store_successor_read_and_close_failed")
        return csgStoreSuccessorReadFail(
            "merkle_store_successor_read_failed")
    var bytes = result.Value(read)
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        rawbytes.BytesFree(bytes)
        return csgStoreSuccessorReadFail(
            "merkle_store_successor_close_failed")
    var decoded: CsgCoreMerkleHeadCodecResult
    let memoEntry =
        merkle_store_codec.CsgCoreMerkleStoreHeadMemoLookupFromBytes(bytes)
    if memoEntry.found:
        rawbytes.BytesFree(bytes)
        decoded.ok = true
        decoded.head.generation = memoEntry.generation
        decoded.head.manifestCid = memoEntry.manifestCid
        decoded.head.previousHeadCid = memoEntry.previousHeadCid
        decoded.head.receiptCid = memoEntry.receiptCid
        decoded.head.headCid = memoEntry.headCid
    else:
        decoded = CsgCoreMerkleHeadDecode(bytes)
        rawbytes.BytesFree(bytes)
    if !decoded.ok:
        CsgCoreMerkleHeadCodecResultDrop(decoded)
        return csgStoreSuccessorReadFail(decoded.error)
    if previousHeadCid == "none":
        if decoded.head.generation != int64(0) ||
           decoded.head.previousHeadCid != "none" ||
           decoded.head.receiptCid != "none":
            return csgStoreSuccessorReadFail(
                "merkle_store_successor_genesis_binding_invalid")
    elif decoded.head.generation <= int64(0) ||
         decoded.head.previousHeadCid != previousHeadCid ||
         decoded.head.headCid == previousHeadCid:
        return csgStoreSuccessorReadFail(
            "merkle_store_successor_binding_invalid")
    var out: csgStoreSuccessorReadResult
    out.ok = true
    out.exists = true
    out.head = decoded.head
    CsgCoreMerkleHeadCodecResultDrop(decoded)
    return out

@borrows
fn csgStoreSuccessorMatchesExact(
        actualHead: CsgCoreMerkleHead,
        expectedBytes: rawbytes.Bytes,
        expectedHead: CsgCoreMerkleHead): bool =
    if !csgStoreHeadsEqual(
           actualHead, expectedHead):
        return false
    var encoded =
        CsgCoreMerkleHeadEncodeWithReceipt(
            actualHead.generation,
            actualHead.manifestCid,
            actualHead.previousHeadCid,
            actualHead.receiptCid)
    if !encoded.ok:
        return false
    let exact =
        rawbytes.BytesEqual(
            encoded.bytes, expectedBytes)
    rawbytes.BytesFree(encoded.bytes)
    return exact

@borrows
fn csgStoreHistoricalGenerationRecord(
        head: CsgCoreMerkleHead,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest):
        CsgCoreMerkleHistoricalGenerationRecord =
    var out: CsgCoreMerkleHistoricalGenerationRecord
    out.generation = head.generation
    out.headCid = strings.CloneStr(head.headCid)
    out.previousHeadCid =
        strings.CloneStr(head.previousHeadCid)
    out.receiptCid = strings.CloneStr(head.receiptCid)
    out.manifestCid = strings.CloneStr(head.manifestCid)
    out.standard = strings.CloneStr(manifest.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(manifest.profiles)
    out.profileSetCid =
        strings.CloneStr(manifest.profileSetCid)
    out.schemaCid = strings.CloneStr(manifest.schemaCid)
    out.factsRoot = strings.CloneStr(manifest.factsRoot)
    out.factCount = manifest.factCount
    out.csgcByteCount = manifest.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(manifest.csgcDirectoryCid)
    out.csgcObjectCid =
        strings.CloneStr(manifest.csgcObjectCid)
    return out

@borrows
fn csgStoreHistoricalManifestAdmissible(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest): bool =
    return manifest.standard == validator.CsgCoreStandardIdentity() &&
        manifest.profiles.len > 0 &&
        manifest.profiles[0] == "csg_core" &&
        manifest.profileSetCid ==
            validator.CsgCoreProfileSetCid(manifest.profiles) &&
        manifest.schemaCid.len > 0 &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            manifest.schemaCid) &&
        manifest.factCount > 0 &&
        manifest.csgcByteCount >= csgc.CsgCoreCsgcHeaderSize &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            manifest.factsRoot) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            manifest.csgcDirectoryCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            manifest.csgcObjectCid) &&
        manifest.complete &&
        manifest.unsupportedCount == 0 &&
        manifest.tombstoneCount == 0 &&
        manifest.runtimeRequirementCount == 0

@borrows
fn CsgCoreMerkleStoreReadHistoricalAuthority(
        parentPath: str,
        storeName: str):
        CsgCoreMerkleHistoricalAuthorityReadResult =
    # The caller-facing path is not an authority. This primitive proves the
    # complete immutable history rooted at the store's real current HEAD; the
    # production wrapper supplies parentPath/storeName only from OS policy.
    let initial =
        csgStoreReadCurrentHeadCore(parentPath, storeName)
    if !initial.ok:
        return csgStoreHistoricalAuthorityReadFail(
            csgStoreCat(
                "merkle_store_historical_current_head ",
                initial.error))
    if !initial.present:
        return csgStoreHistoricalAuthorityReadFail(
            "merkle_store_historical_current_head_missing")
    if initial.head.generation < int64(0) ||
       initial.head.generation > int64(2147483646):
        return csgStoreHistoricalAuthorityReadFail(
            "merkle_store_historical_generation_count_invalid")

    let generationCount =
        int32(initial.head.generation + int64(1))

    var executionIdentity: execution_receipt.CompilerExecutionIdentity
    var executionIdentityError: str
    if !ssr.SevenStageCompilerExecutionIdentityCurrent(
           executionIdentity, executionIdentityError):
        return csgStoreHistoricalAuthorityReadFail(
            executionIdentityError)

    var predecessorCid: str = "none"
    var previousHead: CsgCoreMerkleHead
    var records: CsgCoreMerkleHistoricalGenerationRecord[]
    for generationIndex in 0..<generationCount:
        let generation = int64(generationIndex)
        let successor =
            csgStoreReadSuccessor(
                initial.storeRoot,
                predecessorCid)
        if !successor.ok:
            return csgStoreHistoricalAuthorityReadFail(
                csgStoreCat(
                    "merkle_store_historical_generation_read ",
                    successor.error))
        if !successor.exists ||
           successor.head.generation != generation:
            return csgStoreHistoricalAuthorityReadFail(
                "merkle_store_historical_generation_gap")
        if generationIndex == 0:
            if successor.head.previousHeadCid != "none" ||
               successor.head.receiptCid != "none":
                return csgStoreHistoricalAuthorityReadFail(
                    "merkle_store_historical_genesis_invalid")
        else:
            if successor.head.previousHeadCid !=
               previousHead.headCid:
                return csgStoreHistoricalAuthorityReadFail(
                    "merkle_store_historical_head_chain_mismatch")
            var receiptError: str
            if !csgStoreVerifyCommittedReceipt(
                   initial.storeRoot,
                   previousHead,
                   successor.head,
                   receiptError):
                return csgStoreHistoricalAuthorityReadFail(
                    csgStoreCat(
                        "merkle_store_historical_receipt ",
                        receiptError))
        var manifest: merkle_manifest.CsgCoreMerkleManifest
        let closure =
            csgStoreVerifyManifestClosure(
                initial.storeRoot,
                successor.head.manifestCid,
                executionIdentity,
                manifest)
        if !closure.ok:
            return csgStoreHistoricalAuthorityReadFail(
                csgStoreCat(
                    "merkle_store_historical_manifest_closure ",
                    closure.error))
        if !csgStoreHistoricalManifestAdmissible(manifest):
            return csgStoreHistoricalAuthorityReadFail(
                "merkle_store_historical_manifest_not_admissible")
        add(
            records,
            csgStoreHistoricalGenerationRecord(
                successor.head, manifest))
        predecessorCid =
            strings.CloneStr(successor.head.headCid)
        previousHead = successor.head

    if records.len == 0 ||
       previousHead.generation != initial.head.generation ||
       !csgStoreHeadsEqual(previousHead, initial.head):
        return csgStoreHistoricalAuthorityReadFail(
            "merkle_store_historical_current_head_mismatch")
    let finalHead =
        CsgCoreMerkleStoreReadHead(parentPath, storeName)
    if !finalHead.ok || !finalHead.present ||
       finalHead.storeRoot != initial.storeRoot ||
       !csgStoreHeadsEqual(finalHead.head, initial.head):
        return csgStoreHistoricalAuthorityReadFail(
            "merkle_store_historical_current_head_changed")

    var out: CsgCoreMerkleHistoricalAuthorityReadResult
    out.ok = true
    out.verificationScope = "full_successor_history"
    out.fullHistoryVerified = true
    out.successorChainVerified = true
    out.receiptChainVerified = true
    out.manifestClosuresVerified = true
    out.storeRoot = strings.CloneStr(initial.storeRoot)
    out.currentGeneration = initial.head.generation
    out.currentHeadCid = strings.CloneStr(initial.head.headCid)
    out.currentManifestCid =
        strings.CloneStr(initial.head.manifestCid)
    out.generations = records
    return out

@borrows
fn CsgCoreMerkleStoreAuditHeadHistory(
        parentPath: str,
        storeName: str):
        CsgCoreMerkleManifestOnlyHeadReadResult =
    let current =
        csgStoreReadCurrentHeadCore(
            parentPath, storeName)
    if !current.ok:
        return csgStoreManifestOnlyHeadReadFail(
            current.error)
    var out: CsgCoreMerkleManifestOnlyHeadReadResult
    out.ok = true
    out.present = current.present
    out.verificationScope = "full_successor_history"
    out.fullClosureVerified = current.present
    out.productionAdmission = false
    out.storeRoot = strings.CloneStr(current.storeRoot)
    if current.present:
        out.generationRecordsRead =
            int32(current.head.generation + int64(1))
        out.objectsRead = out.generationRecordsRead
        out.head = current.head
        out.manifest = current.manifest
    return out

@borrows
fn CsgCoreMerkleStoreReadManifestOnlyHead(
        parentPath: str,
        storeName: str):
        CsgCoreMerkleManifestOnlyHeadReadResult =
    let current =
        csgStoreReadCurrentHeadCore(
            parentPath, storeName)
    if !current.ok:
        return csgStoreManifestOnlyHeadReadFail(
            current.error)
    var out: CsgCoreMerkleManifestOnlyHeadReadResult
    out.ok = true
    out.present = current.present
    out.verificationScope = "successor_chain_logical"
    out.fullClosureVerified = current.present
    out.productionAdmission = false
    out.storeRoot = strings.CloneStr(current.storeRoot)
    if current.present:
        out.generationRecordsRead =
            int32(current.head.generation + int64(1))
        out.objectsRead = out.generationRecordsRead
        out.head = current.head
        out.manifest = current.manifest
    return out

@borrows
fn csgStoreReadCurrentHeadCore(
        parentPath: str,
        storeName: str):
        CsgCoreMerkleHeadReadResult =
    let root =
        csgStoreVerifyRoot(
            parentPath, storeName)
    if !root.ok:
        return csgStoreHeadReadFail(strings.CloneStr(root.error))
    let storeRoot = root.storeRoot
    var executionIdentity: execution_receipt.CompilerExecutionIdentity
    var executionIdentityError: str
    if !ssr.SevenStageCompilerExecutionIdentityCurrent(
           executionIdentity, executionIdentityError):
        return csgStoreHeadReadFail(executionIdentityError)
    var predecessor: str = "none"
    var expectedGeneration: int64
    var previousHead: CsgCoreMerkleHead
    var latestHead: CsgCoreMerkleHead
    var latestManifest: merkle_manifest.CsgCoreMerkleManifest
    var present: bool
    while true:
        var successor =
            csgStoreReadSuccessor(
                storeRoot, predecessor)
        if !successor.ok:
            return csgStoreHeadReadFail(successor.error)
        if !successor.exists:
            # Absence is the read linearization point.  Re-read the exact
            # predecessor key so a concurrent no-replace publish is either
            # included in this snapshot or forces another chain step.
            successor =
                csgStoreReadSuccessor(
                    storeRoot, predecessor)
            if !successor.ok:
                return csgStoreHeadReadFail(successor.error)
            if !successor.exists:
                var out: CsgCoreMerkleHeadReadResult
                out.ok = true
                out.present = present
                out.storeRoot = strings.CloneStr(storeRoot)
                if present:
                    out.head = latestHead
                    out.manifest = latestManifest
                return out
        if successor.head.generation != expectedGeneration:
            return csgStoreHeadReadFail(
                "merkle_store_successor_generation_gap")
        var manifest: merkle_manifest.CsgCoreMerkleManifest
        let logicalClosure =
            csgStoreVerifyManifestClosure(
                storeRoot,
                successor.head.manifestCid,
                executionIdentity,
                manifest)
        if !logicalClosure.ok:
            return csgStoreHeadReadFail(
                csgStoreCat(
                    "merkle_store_successor_manifest_closure ",
                    logicalClosure.error))
        if present:
            var receiptError: str
            if !csgStoreVerifyCommittedReceipt(
                   storeRoot,
                   previousHead,
                   successor.head,
                   receiptError):
                return csgStoreHeadReadFail(
                    csgStoreCat(
                        "merkle_store_successor_receipt ",
                        receiptError))
        previousHead = successor.head
        latestHead = successor.head
        latestManifest = manifest
        present = true
        predecessor =
            strings.CloneStr(successor.head.headCid)
        if expectedGeneration ==
           CsgMerkleStoreMaxGeneration:
            let overflow =
                csgStoreReadSuccessor(
                    storeRoot, predecessor)
            if !overflow.ok:
                return csgStoreHeadReadFail(overflow.error)
            if overflow.exists:
                return csgStoreHeadReadFail(
                    "merkle_store_successor_generation_overflow")
            let overflowConfirmed =
                csgStoreReadSuccessor(
                    storeRoot, predecessor)
            if !overflowConfirmed.ok:
                return csgStoreHeadReadFail(
                    overflowConfirmed.error)
            if overflowConfirmed.exists:
                return csgStoreHeadReadFail(
                    "merkle_store_successor_generation_overflow")
            var terminal: CsgCoreMerkleHeadReadResult
            terminal.ok = true
            terminal.present = true
            terminal.storeRoot = strings.CloneStr(storeRoot)
            terminal.head = latestHead
            terminal.manifest = latestManifest
            return terminal
        expectedGeneration =
            expectedGeneration + int64(1)

@borrows
fn csgStoreReadHeadIdentityBindError(
        receipt:
            merkle_store_identity.CsgCoreMerkleStoreIdentityReceipt,
        summary:
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotSummary,
        head: CsgCoreMerkleHead): str =
    if !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
           receipt):
        if receipt.error.len > 0:
            return strings.CloneStr(receipt.error)
        return "merkle_store_identity_record_missing"
    var receiptIdentity: layout.FixedBytes32
    if !merkle_store_codec.csgStoreCodecParseCid(
           receipt.beforeStoreIdentity, receiptIdentity) ||
       !layout.FixedBytes32Equal(
           receiptIdentity, summary.beforeStoreIdentity):
        return "merkle_store_identity_cid_drift"
    var headCid: layout.FixedBytes32
    var manifestCid: layout.FixedBytes32
    if !merkle_store_codec.csgStoreCodecParseCid(
           head.headCid, headCid) ||
       !merkle_store_codec.csgStoreCodecParseCid(
           head.manifestCid, manifestCid) ||
       !layout.FixedBytes32Equal(headCid, summary.headCid) ||
       !layout.FixedBytes32Equal(manifestCid, summary.manifestCid) ||
       head.generation != summary.storeGeneration:
        return "merkle_store_identity_successor_chain_mismatch"
    return ""

@borrows
fn CsgCoreMerkleStoreReadHead(
        parentPath: str,
        storeName: str):
        CsgCoreMerkleHeadReadResult =
    var opened =
        merkle_store_identity.CsgCoreMerkleStoreAcquirePathAuthority(
            parentPath,
            storeName,
            merkle_store_identity.CsgCoreMerkleStoreExistingOnly)
    if !opened.ok:
        return csgStoreHeadReadFail(opened.error)
    var pathAuthority = opened.authority
    opened.authority =
        merkle_store_identity.CsgCoreMerkleStorePathAuthority()
    var planningMove =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityMoveToPlanning(
            pathAuthority)
    if !planningMove.ok:
        return csgStoreHeadReadFail(planningMove.error)
    var planning = planningMove.authority
    planningMove.authority =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority()
    var issued =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIssueBeforeSnapshot(
            planning)
    if !issued.ok:
        let closeError =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityClose(
                planning)
        if closeError.len > 0:
            panic("merkle store: read planning cleanup failed")
        return csgStoreHeadReadFail(issued.error)
    var snapshot = issued.authority
    issued.authority =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
    var claimed =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotClaim(
            snapshot)
    if !claimed.ok:
        if snapshot.ownerId > 0:
            let snapshotError =
                merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPoison(
                    snapshot)
            if snapshotError.len > 0:
                panic("merkle store: read snapshot claim cleanup failed")
        let closeError =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityClose(
                planning)
        if closeError.len > 0:
            panic("merkle store: read claim planning cleanup failed")
        return csgStoreHeadReadFail(claimed.error)
    var claimedSnapshot = claimed.authority
    claimed.authority =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
    let current =
        merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadCurrent(
            planning,
            claimedSnapshot)
    var identityError: str
    var storeIdentityCid: str
    var beforeStoreIdentity: str
    var storeLayoutCid: str
    if current.ok:
        let locked =
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
                claimedSnapshot)
        if !locked.ok:
            identityError = strings.CloneStr(locked.error)
        else:
            var boundHead: CsgCoreMerkleHead
            boundHead.generation = current.head.generation
            boundHead.manifestCid = current.head.manifestCid
            boundHead.previousHeadCid = current.head.previousHeadCid
            boundHead.receiptCid = current.head.receiptCid
            boundHead.headCid = current.head.headCid
            identityError = csgStoreReadHeadIdentityBindError(
                planningMove.identityReceipt,
                locked.summary,
                boundHead)
            if identityError.len == 0:
                storeIdentityCid =
                    strings.CloneStr(
                        planningMove.identityReceipt.recordCid)
                beforeStoreIdentity =
                    strings.CloneStr(
                        planningMove.identityReceipt.beforeStoreIdentity)
                storeLayoutCid =
                    strings.CloneStr(
                        planningMove.identityReceipt.storeLayoutCid)
    let snapshotError =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPoison(
            claimedSnapshot)
    let closeError =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityClose(
            planning)
    if snapshotError.len > 0 || closeError.len > 0:
        panic("merkle store: read authority terminal failed")
    if !current.ok:
        return csgStoreHeadReadFail(current.error)
    if identityError.len > 0:
        return csgStoreHeadReadFail(identityError)
    var out: CsgCoreMerkleHeadReadResult
    out.ok = true
    out.present = true
    out.storeRoot = os.JoinPath(parentPath, storeName)
    out.head.generation = current.head.generation
    out.head.manifestCid = strings.CloneStr(current.head.manifestCid)
    out.head.previousHeadCid =
        strings.CloneStr(current.head.previousHeadCid)
    out.head.receiptCid = strings.CloneStr(current.head.receiptCid)
    out.head.headCid = strings.CloneStr(current.head.headCid)
    out.manifest = current.manifest
    out.storeIdentityCid = storeIdentityCid
    out.beforeStoreIdentity = beforeStoreIdentity
    out.storeLayoutCid = storeLayoutCid
    out.identityProven = true
    return out

@borrows
fn csgStoreDeriveHeadFromReceiptBytes(
        receiptBytes: rawbytes.Bytes,
        receipt: var
            merkle_transaction_receipt.CsgCoreMerkleTransactionReceipt,
        receiptCid: var str,
        derivedHead: var CsgCoreMerkleHead,
        err: var str): bool =
    # Single implementation of the receipt -> head four-tuple derivation:
    # strict decode, structural validation, canonical re-encode (which also
    # yields the receipt CID), then head re-derivation through
    # CsgCoreMerkleHeadEncodeWithReceipt.  Both the committed-receipt
    # verifier and the issue-side after-head derivation consume this helper;
    # do not duplicate the derivation anywhere else.
    var decoded =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptDecode(
            receiptBytes)
    if !decoded.ok:
        err = strings.CloneStr(decoded.error)
        rawbytes.BytesFree(decoded.bytes)
        return false
    let structureError =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptError(
            decoded.receipt)
    if structureError.len > 0:
        err = structureError
        rawbytes.BytesFree(decoded.bytes)
        return false
    var reencoded =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptEncode(
            decoded.receipt)
    if !reencoded.ok ||
       reencoded.cid != decoded.cid ||
       !rawbytes.BytesEqual(reencoded.bytes, receiptBytes):
        rawbytes.BytesFree(reencoded.bytes)
        rawbytes.BytesFree(decoded.bytes)
        err = "merkle_store_receipt_head_derivation_invalid"
        return false
    rawbytes.BytesFree(reencoded.bytes)
    var encoded =
        CsgCoreMerkleHeadEncodeWithReceipt(
            decoded.receipt.generation,
            decoded.receipt.afterManifestCid,
            decoded.receipt.beforeHeadCid,
            decoded.cid)
    if !encoded.ok:
        rawbytes.BytesFree(decoded.bytes)
        err = "merkle_store_receipt_head_derivation_invalid"
        return false
    receipt = decoded.receipt
    receiptCid = strings.CloneStr(decoded.cid)
    derivedHead = encoded.head
    rawbytes.BytesFree(encoded.bytes)
    rawbytes.BytesFree(decoded.bytes)
    return true

@borrows
fn CsgCoreMerkleStoreDeriveAfterHeadFromReceipt(
        receiptBytes: str,
        outHead: var CsgCoreMerkleHead,
        err: var str): bool =
    # Issue-side after-head derivation: the after HEAD is re-derived in place
    # from the canonical receipt bytes (generation / afterManifestCid /
    # beforeHeadCid / receiptCid four-tuple), never taken from a
    # caller-supplied head CID string.  Zero-operation receipts are already
    # rejected inside the shared helper by the receipt structural rules
    # (merkle_transaction_receipt zero_operation_not_publishable) and by the
    # committed-receipt read side; they are not re-implemented here.
    var bytes = rawbytes.BytesFromString(receiptBytes)
    var receipt: merkle_transaction_receipt.CsgCoreMerkleTransactionReceipt
    var receiptCid: str
    let derived =
        csgStoreDeriveHeadFromReceiptBytes(
            bytes, receipt, receiptCid, outHead, err)
    # bytes is a borrowed view of receiptBytes (@borrow_result); not freed.
    if !derived:
        return false
    if receipt.operationCids.len <= 0:
        err = "merkle_store_receipt_operation_count_invalid"
        return false
    return true

@borrows
fn CsgCoreMerkleStoreHeadRejectGenesisForAdmission(
        head: CsgCoreMerkleHead,
        err: var str): bool =
    # Genesis rejection for admission: a generation-0 head (or one still
    # carrying the genesis "none" sentinels) is never admitted as a
    # production current HEAD.  Returns true only for a real successor head.
    if head.generation <= int64(0) ||
       head.receiptCid == "none" ||
       head.previousHeadCid == "none":
        err = "HARD_RED:csg_store_current_head_genesis_not_admissible"
        return false
    return true

@borrows
fn csgStoreVerifyCommittedReceipt(
        storeRoot: str,
        previousHead: CsgCoreMerkleHead,
        head: CsgCoreMerkleHead,
        receiptError: var str): bool =
    if head.receiptCid == "none" ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           head.receiptCid):
        receiptError = "merkle_store_receipt_cid_invalid"
        return false
    var receiptObject =
        csgStoreReadObjectRaw(
            strings.CloneStr(storeRoot),
            CsgMerkleStoreArtifactReceipt,
            strings.CloneStr(head.receiptCid))
    if !receiptObject.ok:
        receiptError = strings.CloneStr(receiptObject.error)
        return false
    var receipt: merkle_transaction_receipt.CsgCoreMerkleTransactionReceipt
    var receiptCid: str
    var derivedHead: CsgCoreMerkleHead
    # Same-compilation decode memo (memory line w49 ①): the receipt derivation
    # (strict decode + canonical re-encode + content digest) is a pure
    # function of the receipt bytes.  The per-call digest check plus every
    # binding check below still run on each walk; only the repeated
    # decode/re-encode work is reused within this compilation.
    var derived = false
    var viewGeneration: int64
    var viewBeforeHeadCid: str
    var viewBeforeManifestCid: str
    var viewAfterManifestCid: str
    var viewProofCid: str
    var viewOperationCount: int32
    if merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoEnabled():
        let contentCid =
            merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
                CsgMerkleTransactionReceiptDomain,
                receiptObject.bytes)
        let memoEntry =
            merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoLookup(
                contentCid)
        if memoEntry.found:
            rawbytes.BytesFree(receiptObject.bytes)
            var encoded =
                CsgCoreMerkleHeadEncodeWithReceipt(
                    memoEntry.generation,
                    memoEntry.afterManifestCid,
                    memoEntry.beforeHeadCid,
                    contentCid)
            if !encoded.ok:
                receiptError =
                    "merkle_store_receipt_head_derivation_invalid"
                return false
            derivedHead = encoded.head
            rawbytes.BytesFree(encoded.bytes)
            receiptCid = contentCid
            viewGeneration = memoEntry.generation
            viewBeforeHeadCid = memoEntry.beforeHeadCid
            viewBeforeManifestCid = memoEntry.beforeManifestCid
            viewAfterManifestCid = memoEntry.afterManifestCid
            viewProofCid = memoEntry.proofCid
            viewOperationCount = memoEntry.operationCount
            derived = true
    if !derived:
        derived =
            csgStoreDeriveHeadFromReceiptBytes(
                receiptObject.bytes,
                receipt,
                receiptCid,
                derivedHead,
                receiptError)
        rawbytes.BytesFree(receiptObject.bytes)
        if !derived:
            return false
        viewGeneration = receipt.generation
        viewBeforeHeadCid = receipt.beforeHeadCid
        viewBeforeManifestCid = receipt.beforeManifestCid
        viewAfterManifestCid = receipt.afterManifestCid
        viewProofCid = receipt.proofCid
        viewOperationCount = receipt.operationCids.len
    if receiptCid != head.receiptCid:
        receiptError = "merkle_store_request_receipt_mismatch"
        return false
    if viewGeneration != head.generation ||
       viewGeneration !=
           previousHead.generation + int64(1):
        receiptError =
            "merkle_store_receipt_generation_mismatch"
        return false
    if viewBeforeHeadCid != previousHead.headCid:
        receiptError =
            "merkle_store_receipt_before_head_mismatch"
        return false
    if viewBeforeManifestCid != previousHead.manifestCid:
        receiptError =
            "merkle_store_receipt_before_manifest_mismatch"
        return false
    if viewAfterManifestCid != head.manifestCid:
        receiptError =
            "merkle_store_receipt_after_manifest_mismatch"
        return false
    if viewOperationCount <= 0:
        receiptError =
            "merkle_store_receipt_operation_count_invalid"
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           viewProofCid):
        receiptError =
            "merkle_store_receipt_proof_cid_invalid"
        return false
    if !csgStoreHeadsEqual(derivedHead, head):
        receiptError =
            "merkle_store_receipt_head_binding_mismatch"
        return false
    var bindingCid: str
    if !csgStoreTransitionReceiptHeadBindingCid(
           head.receiptCid,
           viewBeforeHeadCid,
           derivedHead.headCid,
           bindingCid):
        receiptError =
            "merkle_store_receipt_head_binding_invalid"
        return false
    return true

@borrows
fn csgStoreConsumeCount(
        used: var int32,
        amount: int32,
        limit: int32,
        label: str,
        error: var str): bool =
    if amount < 0 || used < 0 || amount > limit ||
       used > limit - amount:
        error = csgStoreCat(label, "_count_limit_exceeded")
        return false
    used = used + amount
    return true

@borrows
fn csgStoreConsumeBytes(
        used: var int64,
        amount: int64,
        limit: int64,
        label: str,
        error: var str): bool =
    if amount < 0 || used < 0 || amount > limit ||
       used > limit - amount:
        error = csgStoreCat(label, "_byte_limit_exceeded")
        return false
    used = used + amount
    return true

@borrows
fn csgStoreCheckedMulBytes(
        left: int64,
        right: int64,
        limit: int64,
        out: var int64,
        label: str,
        error: var str): bool =
    if left < int64(0) || right < int64(0) ||
       limit < int64(0):
        error = csgStoreCat(label, "_multiply_input_invalid")
        return false
    if right > int64(0) && left > limit / right:
        error = csgStoreCat(label, "_multiply_overflow")
        return false
    out = left * right
    return true

@borrows
fn csgStoreManifestResourceBounded(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        budget: csgStoreAdmissionResourceBudget,
        error: var str): bool =
    if manifest.factCount < 0 ||
       manifest.factCount > budget.factSlotLimit ||
       manifest.partitions.len > budget.factSlotLimit ||
       manifest.dependencyCount < 0 ||
       manifest.dependencyCount > budget.dependencySlotLimit ||
       manifest.dependencyConsumerShards.len > budget.sourceLimit ||
       manifest.dependencyProviderShards.len > budget.sourceLimit ||
       manifest.queryShards.len > budget.queryBucketLimit ||
       manifest.queryIndexCount < 0 ||
       manifest.queryIndexCount > budget.queryRawSlotLimit:
        error = "merkle_store_admission_manifest_count_limit_exceeded"
        return false
    var partitionFacts: int32
    for i in 0..<manifest.partitions.len:
        if !csgStoreConsumeCount(
               partitionFacts,
               manifest.partitions[i].factCount,
               budget.factSlotLimit,
               "merkle_store_admission_manifest_partition_fact",
               error):
            return false
    if partitionFacts != manifest.factCount:
        error = "merkle_store_admission_manifest_fact_count_mismatch"
        return false
    var consumerEntries: int32
    for i in 0..<manifest.dependencyConsumerShards.len:
        if !csgStoreConsumeCount(
               consumerEntries,
               manifest.dependencyConsumerShards[i].entryCount,
               budget.dependencySlotLimit,
               "merkle_store_admission_manifest_consumer_entry",
               error):
            return false
    var providerEntries: int32
    for i in 0..<manifest.dependencyProviderShards.len:
        if !csgStoreConsumeCount(
               providerEntries,
               manifest.dependencyProviderShards[i].entryCount,
               budget.dependencySlotLimit,
               "merkle_store_admission_manifest_provider_entry",
               error):
            return false
    if consumerEntries != manifest.dependencyCount ||
       providerEntries != manifest.dependencyCount:
        error = "merkle_store_admission_manifest_dependency_count_mismatch"
        return false
    var queryEntries: int32
    for i in 0..<manifest.queryShards.len:
        if !csgStoreConsumeCount(
               queryEntries,
               manifest.queryShards[i].entryCount,
               budget.queryRawSlotLimit,
               "merkle_store_admission_manifest_query_entry",
               error):
            return false
    if queryEntries != manifest.queryIndexCount:
        error = "merkle_store_admission_manifest_query_count_mismatch"
        return false
    return true

@borrows
fn csgStoreInitAdmissionResourceBudget(
        beforeManifest:
            merkle_manifest.CsgCoreMerkleManifest,
        afterManifest:
            merkle_manifest.CsgCoreMerkleManifest,
        budget: var csgStoreAdmissionResourceBudget,
        error: var str): bool =
    budget.sourceLimit =
        merkle_transaction_request.CsgCoreMerkleTransactionRequestSourceLimit()
    budget.factSlotLimit = CsgMerkleStoreAdmissionFactSlotLimit
    budget.dependencySlotLimit =
        CsgMerkleStoreAdmissionDependencySlotLimit
    budget.operationLimit =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptOperationLimit()
    budget.proofLimit = budget.operationLimit
    budget.nodeLimit =
        merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptReachableNodeLimit()
    budget.queryBucketLimit =
        CsgMerkleStoreAdmissionQueryBucketLimit
    budget.queryRawSlotLimit =
        CsgMerkleStoreAdmissionQueryRawSlotLimit
    budget.objectCountLimit =
        CsgMerkleStoreAdmissionObjectCountLimit
    var derivedObjectBytesLimit: int64
    if !csgStoreCheckedMulBytes(
           merkle_transaction_request.CsgCoreMerkleTransactionRequestLineByteLimit(),
           int64(8),
           CsgMerkleStoreAdmissionObjectBytesLimit,
           derivedObjectBytesLimit,
           "merkle_store_admission_object_budget",
           error) ||
       derivedObjectBytesLimit !=
           CsgMerkleStoreAdmissionObjectBytesLimit:
        error = "merkle_store_admission_object_budget_derivation_invalid"
        return false
    budget.objectBytesLimit = derivedObjectBytesLimit
    if !csgStoreManifestResourceBounded(
           beforeManifest, budget, error) ||
       !csgStoreManifestResourceBounded(
           afterManifest, budget, error):
        return false
    return true

@borrows
fn csgStoreAdmissionReadObject(
        storeRoot: str,
        kind: int32,
        cid: str,
        budget: var csgStoreAdmissionResourceBudget,
        error: var str): CsgCoreMerkleStoreReadResult =
    let length = csgStoreObjectLength(storeRoot, kind, cid)
    if !length.ok:
        error = strings.CloneStr(length.error)
        return csgStoreReadFail(strings.CloneStr(length.error))
    if !csgStoreConsumeCount(
           budget.objectCount,
           int32(1),
           budget.objectCountLimit,
           "merkle_store_admission_object",
           error) ||
       !csgStoreConsumeBytes(
           budget.objectBytes,
           length.byteCount,
           budget.objectBytesLimit,
           "merkle_store_admission_object",
           error):
        return csgStoreReadFail(strings.CloneStr(error))
    var object = CsgCoreMerkleStoreReadObject(
        storeRoot, kind, cid)
    if !object.ok:
        error = strings.CloneStr(object.error)
        return object
    if int64(rawbytes.BytesLen(object.bytes)) != length.byteCount:
        rawbytes.BytesFree(object.bytes)
        error = "merkle_store_admission_object_length_drift"
        return csgStoreReadFail(strings.CloneStr(error))
    return object

@borrows
fn csgStoreAdmissionConsumeOwnedBytes(
        bytes: rawbytes.Bytes,
        budget: var csgStoreAdmissionResourceBudget,
        label: str,
        error: var str): bool =
    return csgStoreConsumeBytes(
        budget.objectBytes,
        int64(rawbytes.BytesLen(bytes)),
        budget.objectBytesLimit,
        label,
        error)

@borrows
fn csgStoreTextCompare(left: str, right: str): int32 =
    let shared = left.len < right.len ? left.len : right.len
    for i in 0..<shared:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgStoreTextOrder(values: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, values.len)
    setLen(scratch, values.len)
    for i in 0..<values.len:
        order[i] = i
    var width: int32 = 1
    while width < values.len:
        var base: int32
        while base < values.len:
            let remaining = values.len - base
            let leftWidth =
                remaining < width ? remaining : width
            let middle = base + leftWidth
            let rightRemaining = values.len - middle
            let rightWidth =
                rightRemaining < width ? rightRemaining : width
            let finish = middle + rightWidth
            var left = base
            var right = middle
            var out = base
            while left < middle && right < finish:
                if csgStoreTextCompare(
                       values[order[right]],
                       values[order[left]]) < 0:
                    scratch[out] = order[right]
                    right = right + 1
                else:
                    scratch[out] = order[left]
                    left = left + 1
                out = out + 1
            while left < middle:
                scratch[out] = order[left]
                left = left + 1
                out = out + 1
            while right < finish:
                scratch[out] = order[right]
                right = right + 1
                out = out + 1
            base = finish
        for i in 0..<values.len:
            order[i] = scratch[i]
        if width > values.len - width:
            width = values.len
        else:
            width = width + width
    return order

fn csgStoreShardedInvalidationFail(
        error: str):
        CsgCoreMerkleStoreShardedInvalidationResult =
    var out: CsgCoreMerkleStoreShardedInvalidationResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreSortedTextIndex(
        values: str[],
        wanted: str): int32 =
    var low: int32
    var high = values.len
    while low < high:
        let middle = low + (high - low) / 2
        if csgStoreTextCompare(values[middle], wanted) < 0:
            low = middle + 1
        else:
            high = middle
    if low >= values.len || values[low] != wanted:
        return -1
    return low

@borrows
fn csgStoreFramedPair(
        domain: str,
        left: str,
        right: str): str =
    return csgStoreCat(
        domain,
        csgStoreCat(
            csgStoreCat(
                strings.IntToStr(left.len), ":"),
            csgStoreCat(
                left,
                csgStoreCat(
                    csgStoreCat(
                        strings.IntToStr(right.len), ":"),
                    right))))

@borrows
fn csgStoreProviderBinding(
        sourceId: str,
        factsRoot: str): str =
    return csgStoreFramedPair(
        "provider_binding:", sourceId, factsRoot)

@borrows
fn csgStorePartitionIdentity(
        sourceId: str,
        factKind: str): str =
    return csgStoreFramedPair(
        "partition_identity:", sourceId, factKind)

@borrows
fn csgStoreBuildShardDescriptorIndex(
        descriptors:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        label: str,
        keys: var str[],
        positions: var int32[],
        error: var str): bool =
    var rawKeys: str[]
    for i in 0..<descriptors.len:
        let descriptor = descriptors[i]
        if descriptor.shardKey.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               descriptor.cid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               descriptor.root) ||
           descriptor.entryCount < 0:
            error = csgStoreCat(
                label, "_descriptor_invalid")
            return false
        add(rawKeys, strings.CloneStr(descriptor.shardKey))
    let order = csgStoreTextOrder(rawKeys)
    for rank in 0..<order.len:
        if rank > 0 &&
           rawKeys[order[rank - 1]] == rawKeys[order[rank]]:
            error = csgStoreCat(
                label, "_descriptor_duplicate")
            return false
        add(keys, strings.CloneStr(rawKeys[order[rank]]))
        add(positions, order[rank])
    return true

@borrows
fn csgStoreBuildManifestDependencyIndex(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        index: var csgStoreManifestDependencyIndex,
        error: var str): bool =
    var rawSourceIds: str[]
    var rawProviderBindings: str[]
    var rawPartitionIdentities: str[]
    for i in 0..<manifest.partitions.len:
        let partition = manifest.partitions[i]
        if partition.sourceId.len == 0 ||
           partition.factKind.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               partition.factsRoot):
            error =
                "merkle_store_request_partition_identity_invalid"
            return false
        add(
            rawSourceIds,
            strings.CloneStr(partition.sourceId))
        add(
            rawProviderBindings,
            csgStoreProviderBinding(
                partition.sourceId,
                partition.factsRoot))
        add(
            rawPartitionIdentities,
            csgStorePartitionIdentity(
                partition.sourceId,
                partition.factKind))
    if rawSourceIds.len == 0:
        error = "merkle_store_request_sources_empty"
        return false
    let sourceOrder = csgStoreTextOrder(rawSourceIds)
    for rank in 0..<sourceOrder.len:
        if rank == 0 ||
           rawSourceIds[sourceOrder[rank - 1]] !=
               rawSourceIds[sourceOrder[rank]]:
            add(
                index.sourceIds,
                strings.CloneStr(
                    rawSourceIds[sourceOrder[rank]]))
    let providerOrder =
        csgStoreTextOrder(rawProviderBindings)
    for rank in 0..<providerOrder.len:
        if rank > 0 &&
           rawProviderBindings[providerOrder[rank - 1]] ==
               rawProviderBindings[providerOrder[rank]]:
            error =
                "merkle_store_request_provider_binding_duplicate"
            return false
        add(
            index.providerBindings,
            strings.CloneStr(
                rawProviderBindings[providerOrder[rank]]))
    let partitionOrder =
        csgStoreTextOrder(rawPartitionIdentities)
    for rank in 0..<partitionOrder.len:
        if rank > 0 &&
           rawPartitionIdentities[partitionOrder[rank - 1]] ==
               rawPartitionIdentities[partitionOrder[rank]]:
            error =
                "merkle_store_request_partition_identity_conflict"
            return false
        let partitionAt = partitionOrder[rank]
        add(
            index.partitionIdentities,
            strings.CloneStr(
                rawPartitionIdentities[partitionAt]))
        add(index.partitionPositions, partitionAt)
    if !csgStoreBuildShardDescriptorIndex(
           manifest.dependencyConsumerShards,
           "merkle_store_request_consumer",
           index.consumerShardKeys,
           index.consumerShardPositions,
           error) ||
       !csgStoreBuildShardDescriptorIndex(
           manifest.dependencyProviderShards,
           "merkle_store_request_provider",
           index.providerShardKeys,
           index.providerShardPositions,
           error):
        return false
    if index.consumerShardKeys.len != index.sourceIds.len ||
       index.providerShardKeys.len != index.sourceIds.len:
        error =
            "merkle_store_request_dependency_descriptor_count_mismatch"
        return false
    for i in 0..<index.sourceIds.len:
        if csgStoreSortedTextIndex(
               index.consumerShardKeys,
               index.sourceIds[i]) < 0 ||
           csgStoreSortedTextIndex(
               index.providerShardKeys,
               index.sourceIds[i]) < 0:
            error =
                "merkle_store_request_dependency_descriptor_missing"
            return false
    return true

@borrows
fn csgStoreDependencyBoundToManifest(
        index: csgStoreManifestDependencyIndex,
        record:
            merkle_artifacts.CsgCoreMerkleDependencyRecord,
        consumerIndex: var int32): bool =
    consumerIndex =
        csgStoreSortedTextIndex(
            index.sourceIds,
            record.consumerSource)
    if consumerIndex < 0:
        return false
    let providerBinding =
        csgStoreProviderBinding(
            record.providerSource,
            record.providerSubgraphCid)
    return csgStoreSortedTextIndex(
        index.providerBindings,
        providerBinding) >= 0

@borrows
fn csgStoreIndexedDescriptorAt(
        keys: str[],
        positions: int32[],
        shardKey: str): int32 =
    let rank =
        csgStoreSortedTextIndex(
            keys, shardKey)
    if rank < 0 || rank >= positions.len:
        return -1
    return positions[rank]

@borrows
fn csgStoreProviderShardDescriptorAt(
        index: csgStoreManifestDependencyIndex,
        providerSource: str): int32 =
    return csgStoreIndexedDescriptorAt(
        index.providerShardKeys,
        index.providerShardPositions,
        providerSource)

@borrows
fn csgStoreBuildShardedInvalidationIndexed(
        storeRoot: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        dependencyIndex: csgStoreManifestDependencyIndex,
        changedSources: str[],
        budget: var csgStoreAdmissionResourceBudget):
        CsgCoreMerkleStoreShardedInvalidationResult =
    if dependencyIndex.sourceIds.len > budget.sourceLimit ||
       changedSources.len > budget.sourceLimit:
        return csgStoreShardedInvalidationFail(
            "merkle_store_request_invalidation_source_limit_exceeded")
    let initial =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            dependencyIndex.sourceIds, [], changedSources)
    if !initial.ok:
        return csgStoreShardedInvalidationFail(
            csgStoreCat(
                "merkle_store_request_invalidation ",
                initial.error))
    var seen: bool[]
    setLen(seen, dependencyIndex.sourceIds.len)
    var queue: int32[]
    for i in 0..<initial.invalidatedSources.len:
        let sourceIndex =
            csgStoreSortedTextIndex(
                dependencyIndex.sourceIds,
                initial.invalidatedSources[i])
        if sourceIndex < 0 || seen[sourceIndex]:
            return csgStoreShardedInvalidationFail(
                "merkle_store_request_initial_source_index_invalid")
        seen[sourceIndex] = true
        add(queue, sourceIndex)
    var edges: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    var decodedCount: int32
    var cursor: int32
    while cursor < queue.len:
        let providerSource =
            dependencyIndex.sourceIds[queue[cursor]]
        cursor = cursor + 1
        let descriptorAt =
            csgStoreProviderShardDescriptorAt(
                dependencyIndex, providerSource)
        if descriptorAt < 0:
            return csgStoreShardedInvalidationFail(
                "merkle_store_request_provider_descriptor_missing")
        let descriptor =
            manifest.dependencyProviderShards[descriptorAt]
        var readError: str
        if !csgStoreConsumeCount(
               budget.dependencySlots,
               descriptor.entryCount,
               budget.dependencySlotLimit,
               "merkle_store_request_invalidation_dependency",
               readError):
            return csgStoreShardedInvalidationFail(readError)
        var object =
            csgStoreAdmissionReadObject(
                storeRoot,
                CsgMerkleStoreArtifactDependency,
                descriptor.cid,
                budget,
                readError)
        if !object.ok:
            return csgStoreShardedInvalidationFail(
                csgStoreCat(
                    "merkle_store_request_provider_read ",
                    object.error))
        var shard =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                object.bytes)
        rawbytes.BytesFree(object.bytes)
        decodedCount = decodedCount + 1
        if !csgStoreAdmissionConsumeOwnedBytes(
               shard.bytes,
               budget,
               "merkle_store_request_invalidation_decode",
               readError):
            rawbytes.BytesFree(shard.bytes)
            return csgStoreShardedInvalidationFail(readError)
        if !shard.ok ||
           shard.cid != descriptor.cid ||
           shard.shardRoot != descriptor.root ||
           shard.entryCount != descriptor.entryCount ||
           shard.header.profileSetCid !=
               manifest.profileSetCid ||
           shard.header.projection !=
               merkle_artifacts.CsgCoreMerkleDependencyProviderProjection() ||
           shard.header.shardKey != providerSource:
            rawbytes.BytesFree(shard.bytes)
            return csgStoreShardedInvalidationFail(
                "merkle_store_request_provider_projection_mismatch")
        for recordIndex in 0..<shard.records.len:
            let record = shard.records[recordIndex]
            var consumerIndex: int32
            if record.providerSource != providerSource ||
               !csgStoreDependencyBoundToManifest(
                   dependencyIndex,
                   record,
                   consumerIndex):
                rawbytes.BytesFree(shard.bytes)
                return csgStoreShardedInvalidationFail(
                    "merkle_store_request_provider_record_unbound")
            var edge: merkle_invalidation.CsgCoreMerkleDependencyEdge
            edge.consumerSource =
                strings.CloneStr(record.consumerSource)
            edge.providerSource =
                strings.CloneStr(record.providerSource)
            edge.selector = strings.CloneStr(record.selector)
            edge.providerSubgraphCid =
                strings.CloneStr(
                    record.providerSubgraphCid)
            add(edges, edge)
            if !seen[consumerIndex]:
                seen[consumerIndex] = true
                add(queue, consumerIndex)
        rawbytes.BytesFree(shard.bytes)
    let invalidation =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            dependencyIndex.sourceIds,
            edges,
            changedSources)
    if !invalidation.ok:
        return csgStoreShardedInvalidationFail(
            csgStoreCat(
                "merkle_store_request_invalidation ",
                invalidation.error))
    if queue.len != invalidation.invalidatedSources.len:
        return csgStoreShardedInvalidationFail(
            "merkle_store_request_invalidation_count_mismatch")
    for i in 0..<invalidation.invalidatedSources.len:
        let sourceIndex =
            csgStoreSortedTextIndex(
                dependencyIndex.sourceIds,
                invalidation.invalidatedSources[i])
        if sourceIndex < 0 || !seen[sourceIndex]:
            return csgStoreShardedInvalidationFail(
                "merkle_store_request_invalidation_projection_mismatch")
    var out: CsgCoreMerkleStoreShardedInvalidationResult
    out.ok = true
    out.dependencyObjectsDecoded = decodedCount
    out.invalidation = invalidation
    return out

@borrows
fn CsgCoreMerkleStoreBuildShardedInvalidation(
        storeRoot: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        changedSources: str[]):
        CsgCoreMerkleStoreShardedInvalidationResult =
    var dependencyIndex: csgStoreManifestDependencyIndex
    var indexError: str
    var budget: csgStoreAdmissionResourceBudget
    if !csgStoreInitAdmissionResourceBudget(
           manifest, manifest, budget, indexError):
        return csgStoreShardedInvalidationFail(indexError)
    if !csgStoreBuildManifestDependencyIndex(
           manifest, dependencyIndex, indexError):
        return csgStoreShardedInvalidationFail(indexError)
    return csgStoreBuildShardedInvalidationIndexed(
        storeRoot,
        manifest,
        dependencyIndex,
        changedSources,
        budget)

# ---------------------------------------------------------------------------
# Current-HEAD lease subsystem (capability atomic-switch domain C).
#
# The lease anchor is a held directory descriptor on the store root opened
# through os.AtomicTreeOpenVerifiedExclusiveOrAbsent: the bridge performs a
# component-wise no-symlink open, fstat dev/inode/mode identity checks with a
# reopen-join equality proof, and takes a nonblocking exclusive flock on the
# store root descriptor.  os.* currently exposes no LOCK_SH wrapper, so a
# shared lease is backed by the same exclusive anchor: strictly stronger for
# mutual exclusion (a concurrent reader is failed, never admitted without the
# anchor checks) and no identity check is skipped.  A LOCK_SH os.* bridge is
# a tracked gap owned by the os.cheng wave; when it lands, only the anchor
# open inside csgStoreHeadLeaseAcquire changes.
#
# Lock order: this anchor (store root) is always taken before any atomic-tree
# staging lock (storeRoot/successors).  Every flock involved is nonblocking,
# so ordering inversion surfaces as HARD_RED, never as a wait.
#
# In-process join: a second lease on the same store root inside one process
# shares the already-held anchor instead of double-flocking our own
# descriptor (flock conflicts across open file descriptions even inside one
# process).  The anchor is closed only when the owning row is released after
# every joined row has been released.
# ---------------------------------------------------------------------------

const
    csgStoreHeadLeaseSlotCount: int32 = 64
    csgStoreHeadLeaseRegistryEmpty: int32 = 0
    csgStoreHeadLeaseRegistryBuilding: int32 = 1
    csgStoreHeadLeaseRegistryReady: int32 = 2
    csgStoreHeadLeaseRegistryFailed: int32 = 3
    csgStoreHeadLeaseEmpty: int32 = 0
    csgStoreHeadLeaseLive: int32 = 1
    csgStoreHeadLeaseAnchorDomain: str =
        "csg_core.store.current_head_lease_anchor"

type
    # Opaque-by-convention lease value.  Callers may hold and pass it but
    # must not construct one: only the acquire functions mint a live lease,
    # and only release invalidates it.  The anchor descriptor itself stays
    # inside the module registry; the value carries int32 identity plus the
    # head triple captured under the anchor at acquire time.
    CsgCoreMerkleStoreCurrentHeadLease =
        leaseId: int32
        epoch: int32
        parentPath: str
        storeName: str
        storeRoot: str
        exclusive: bool
        headPresent: bool
        headGeneration: int64
        headCid: str
        manifestCid: str

var
    csgStoreHeadLeaseRegistryState: int32
    csgStoreHeadLeaseStates: int32[]
    csgStoreHeadLeaseEpochs: int32[]
    csgStoreHeadLeaseExclusives: int32[]
    csgStoreHeadLeaseAnchorOwned: int32[]
    csgStoreHeadLeaseAnchors: uint64[]
    csgStoreHeadLeaseStoreRootHashes: layout.FixedBytes32[]
    csgStoreHeadLeaseExclusiveLiveCount: int32
    csgStoreHeadLeaseEpochClock: int32

fn csgStoreHeadLeaseEnsureRegistry() =
    var builder: bool
    while !builder:
        os.CsgCurrentHeadLeaseRegistryLock()
        let observed = csgStoreHeadLeaseRegistryState
        if observed == csgStoreHeadLeaseRegistryReady:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return
        if observed == csgStoreHeadLeaseRegistryFailed:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("merkle store: head lease registry failed")
        if observed == csgStoreHeadLeaseRegistryEmpty:
            csgStoreHeadLeaseRegistryState =
                csgStoreHeadLeaseRegistryBuilding
            builder = true
            os.CsgCurrentHeadLeaseRegistryUnlock()
        elif observed == csgStoreHeadLeaseRegistryBuilding:
            let observedEpoch =
                os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("merkle store: head lease registry state invalid")
    var states: int32[]
    var epochs: int32[]
    var exclusives: int32[]
    var anchorOwned: int32[]
    var anchors: uint64[]
    var storeRootHashes: layout.FixedBytes32[]
    for i in 0..<csgStoreHeadLeaseSlotCount:
        add(states, csgStoreHeadLeaseEmpty)
        add(epochs, 0)
        add(exclusives, 0)
        add(anchorOwned, 0)
        add(anchors, uint64(0))
        add(storeRootHashes, layout.FixedBytes32())
    csgStoreHeadLeaseStates = states
    csgStoreHeadLeaseEpochs = epochs
    csgStoreHeadLeaseExclusives = exclusives
    csgStoreHeadLeaseAnchorOwned = anchorOwned
    csgStoreHeadLeaseAnchors = anchors
    csgStoreHeadLeaseStoreRootHashes = storeRootHashes
    csgStoreHeadLeaseExclusiveLiveCount = 0
    csgStoreHeadLeaseEpochClock = 0
    os.CsgCurrentHeadLeaseRegistryLock()
    if csgStoreHeadLeaseRegistryState !=
           csgStoreHeadLeaseRegistryBuilding:
        csgStoreHeadLeaseRegistryState = csgStoreHeadLeaseRegistryFailed
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("merkle store: head lease registry publication drift")
    csgStoreHeadLeaseRegistryState = csgStoreHeadLeaseRegistryReady
    if csgStoreHeadLeaseStates.len != csgStoreHeadLeaseSlotCount ||
       csgStoreHeadLeaseEpochs.len != csgStoreHeadLeaseSlotCount ||
       csgStoreHeadLeaseExclusives.len != csgStoreHeadLeaseSlotCount ||
       csgStoreHeadLeaseAnchorOwned.len != csgStoreHeadLeaseSlotCount ||
       csgStoreHeadLeaseAnchors.len != csgStoreHeadLeaseSlotCount ||
       csgStoreHeadLeaseStoreRootHashes.len !=
           csgStoreHeadLeaseSlotCount:
        csgStoreHeadLeaseRegistryState = csgStoreHeadLeaseRegistryFailed
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("merkle store: head lease registry publication invalid")
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()

fn csgStoreHeadLeaseLock() =
    os.CsgCurrentHeadLeaseRegistryLock()

fn csgStoreHeadLeaseUnlock() =
    os.CsgCurrentHeadLeaseRegistryUnlock()

@borrows
fn csgStoreHeadLeaseStoreRootHash(
        storeRoot: str,
        outHash: var layout.FixedBytes32): bool =
    # BytesFromString is @borrow_result: the view aliases the owned clone
    # and must not be freed.
    let owned = strings.CloneStr(storeRoot)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            csgStoreHeadLeaseAnchorDomain,
            rawbytes.BytesFromString(owned))
    return merkle_store_codec.csgStoreCodecParseCid(cid, outHash)

@borrows
fn csgStoreHeadLeaseFindAnchorLocked(
        rootHash: layout.FixedBytes32,
        exclusive: bool): uint64 =
    # Shared readers may join the same LOCK_SH open-file description inside
    # one process. Writers always open a distinct LOCK_EX OFD, so they cannot
    # inherit reader authority or bypass another writer's kernel wait.
    if exclusive:
        return uint64(0)
    for i in 0..<csgStoreHeadLeaseSlotCount:
        if csgStoreHeadLeaseStates[i] == csgStoreHeadLeaseLive &&
           csgStoreHeadLeaseExclusives[i] == 0 &&
           layout.FixedBytes32Equal(
               csgStoreHeadLeaseStoreRootHashes[i], rootHash):
            return csgStoreHeadLeaseAnchors[i]
    return uint64(0)

@borrows
fn csgStoreHeadLeaseRegisterLocked(
        rootHash: layout.FixedBytes32,
        anchor: uint64,
        owned: int32,
        exclusive: bool,
        outEpoch: var int32): int32 =
    var row: int32 = -1
    for i in 0..<csgStoreHeadLeaseSlotCount:
        if csgStoreHeadLeaseStates[i] == csgStoreHeadLeaseEmpty:
            row = i
            break
    if row < 0:
        return -1
    csgStoreHeadLeaseEpochClock = csgStoreHeadLeaseEpochClock + 1
    if csgStoreHeadLeaseEpochClock <= 0:
        csgStoreHeadLeaseEpochClock = 1
    csgStoreHeadLeaseStates[row] = csgStoreHeadLeaseLive
    csgStoreHeadLeaseEpochs[row] = csgStoreHeadLeaseEpochClock
    csgStoreHeadLeaseExclusives[row] = exclusive ? 1 : 0
    csgStoreHeadLeaseAnchorOwned[row] = owned
    csgStoreHeadLeaseAnchors[row] = anchor
    csgStoreHeadLeaseStoreRootHashes[row] = rootHash
    if exclusive:
        csgStoreHeadLeaseExclusiveLiveCount =
            csgStoreHeadLeaseExclusiveLiveCount + 1
    outEpoch = csgStoreHeadLeaseEpochClock
    return row

fn csgStoreHeadLeaseUnregisterLocked(row: int32) =
    if csgStoreHeadLeaseExclusives[row] != 0 &&
       csgStoreHeadLeaseExclusiveLiveCount > 0:
        csgStoreHeadLeaseExclusiveLiveCount =
            csgStoreHeadLeaseExclusiveLiveCount - 1
    csgStoreHeadLeaseStates[row] = csgStoreHeadLeaseEmpty
    csgStoreHeadLeaseEpochs[row] = 0
    csgStoreHeadLeaseExclusives[row] = 0
    csgStoreHeadLeaseAnchorOwned[row] = 0
    csgStoreHeadLeaseAnchors[row] = uint64(0)
    csgStoreHeadLeaseStoreRootHashes[row] = layout.FixedBytes32()

fn csgStoreHeadLeaseCloseAnchor(anchor: uint64) =
    let closed = os.AtomicTreeClose(anchor)
    if result.IsErr(closed):
        panic("merkle store: head lease anchor close failed")

@borrows
fn csgStoreHeadLeaseOpenAnchor(
        storeRoot: str,
        exclusive: bool): Result[os.AtomicTreeExclusiveOpenResult] =
    if exclusive:
        return os.AtomicTreeOpenVerifiedBlockingExclusiveOrAbsent(
            storeRoot, "successors")
    return os.AtomicTreeOpenVerifiedSharedOrAbsent(
        storeRoot, "successors")

@borrows
fn csgStoreHeadLeaseReadCurrentHead(
        storeRoot: str,
        present: var bool,
        head: var CsgCoreMerkleHead,
        err: var str): bool =
    # Chain walk for lease capture/fence.  This deliberately does NOT call
    # csgStoreReadCurrentHeadCore: that core requires the canonical compiler
    # execution identity (only active inside a --seven-stage compiler
    # process) and a path-authority flock on the store parent, neither of
    # which is available or legal inside publisher flows.  The walk keeps
    # every check the lease depends on: successor binding, generation
    # continuity, the absence double-read linearization point, and per-step
    # committed-receipt derivation.  Manifest-closure content admission is
    # not the lease's job and stays with CsgCoreMerkleStoreReadHead callers.
    var predecessor: str = "none"
    var expectedGeneration: int64
    var previousHead: CsgCoreMerkleHead
    while true:
        var successor =
            csgStoreReadSuccessor(storeRoot, predecessor)
        if !successor.ok:
            err = strings.CloneStr(successor.error)
            return false
        if !successor.exists:
            successor =
                csgStoreReadSuccessor(storeRoot, predecessor)
            if !successor.ok:
                err = strings.CloneStr(successor.error)
                return false
            if !successor.exists:
                return true
        if successor.head.generation != expectedGeneration:
            err = "merkle_store_successor_generation_gap"
            return false
        if present:
            var receiptError: str
            if !csgStoreVerifyCommittedReceipt(
                   storeRoot,
                   previousHead,
                   successor.head,
                   receiptError):
                err = csgStoreCat(
                    "merkle_store_successor_receipt ",
                    receiptError)
                return false
        previousHead = successor.head
        head = successor.head
        present = true
        predecessor =
            strings.CloneStr(successor.head.headCid)
        if expectedGeneration ==
           CsgMerkleStoreMaxGeneration:
            err = "merkle_store_successor_generation_overflow"
            return false
        expectedGeneration =
            expectedGeneration + int64(1)

@borrows
fn csgStoreHeadLeaseFillFromHead(
        row: int32,
        epoch: int32,
        parentPath: str,
        storeName: str,
        storeRoot: str,
        exclusive: bool,
        outLease: var CsgCoreMerkleStoreCurrentHeadLease,
        err: var str): bool =
    var present: bool
    var captured: CsgCoreMerkleHead
    if !csgStoreHeadLeaseReadCurrentHead(
           storeRoot, present, captured, err):
        let detail = strings.CloneStr(err)
        err = csgStoreCat(
            "HARD_RED:csg_store_head_lease_head_read ",
            detail)
        return false
    outLease.leaseId = row + 1
    outLease.epoch = epoch
    outLease.parentPath = strings.CloneStr(parentPath)
    outLease.storeName = strings.CloneStr(storeName)
    outLease.storeRoot = strings.CloneStr(storeRoot)
    outLease.exclusive = exclusive
    outLease.headPresent = present
    outLease.headGeneration = int64(-1)
    if present:
        outLease.headGeneration = captured.generation
        outLease.headCid = strings.CloneStr(captured.headCid)
        outLease.manifestCid =
            strings.CloneStr(captured.manifestCid)
    return true

@borrows
fn csgStoreHeadLeaseAcquire(
        parentPath: str,
        storeName: str,
        exclusive: bool,
        outLease: var CsgCoreMerkleStoreCurrentHeadLease,
        err: var str): bool =
    if !os.IsAbsolute(parentPath) || storeName.len == 0:
        err = "HARD_RED:csg_store_head_lease_anchor_path_invalid"
        return false
    let storeRoot = os.JoinPath(parentPath, storeName)
    var rootHash: layout.FixedBytes32
    if !csgStoreHeadLeaseStoreRootHash(storeRoot, rootHash):
        err = "HARD_RED:csg_store_head_lease_anchor_identity_invalid"
        return false
    csgStoreHeadLeaseEnsureRegistry()
    var anchor: uint64
    var owned: int32
    var epoch: int32
    var row: int32 = -1
    # Find and register under one lock.  An owning row therefore cannot be
    # released (and its anchor closed) between discovery and publication of
    # this joined row.
    csgStoreHeadLeaseLock()
    anchor = csgStoreHeadLeaseFindAnchorLocked(rootHash, exclusive)
    if anchor != uint64(0):
        row = csgStoreHeadLeaseRegisterLocked(
            rootHash, anchor, owned, exclusive, epoch)
    csgStoreHeadLeaseUnlock()
    if anchor == uint64(0):
        let opened = csgStoreHeadLeaseOpenAnchor(
            storeRoot, exclusive)
        if result.IsErr(opened):
            err = csgStoreCat(
                "HARD_RED:csg_store_head_lease_unavailable ",
                result.Error(opened))
            return false
        let candidate = result.Value(opened).tree
        if candidate == uint64(0):
            err = "HARD_RED:csg_store_head_lease_anchor_invalid"
            return false
        csgStoreHeadLeaseLock()
        anchor = csgStoreHeadLeaseFindAnchorLocked(rootHash, exclusive)
        if anchor == uint64(0):
            anchor = candidate
            owned = 1
        row = csgStoreHeadLeaseRegisterLocked(
            rootHash, anchor, owned, exclusive, epoch)
        csgStoreHeadLeaseUnlock()
        if owned == 0:
            # A concurrent acquirer published its anchor while this process
            # opened the candidate.  The registered row joined the published
            # anchor, so the unused candidate can now be closed.
            csgStoreHeadLeaseCloseAnchor(candidate)
    if row < 0:
        if owned != 0:
            csgStoreHeadLeaseCloseAnchor(anchor)
        err = "HARD_RED:csg_store_head_lease_registry_exhausted"
        return false
    if csgStoreHeadLeaseFillFromHead(
           row, epoch, parentPath, storeName, storeRoot,
           exclusive, outLease, err):
        return true
    csgStoreHeadLeaseLock()
    let stillOwned = csgStoreHeadLeaseAnchorOwned[row]
    csgStoreHeadLeaseUnregisterLocked(row)
    csgStoreHeadLeaseUnlock()
    if stillOwned != 0:
        csgStoreHeadLeaseCloseAnchor(anchor)
    return false

@borrows
fn CsgCoreMerkleStoreAcquireCurrentHeadSharedLease(
        parentPath: str,
        storeName: str,
        outLease: var CsgCoreMerkleStoreCurrentHeadLease,
        err: var str): bool =
    return csgStoreHeadLeaseAcquire(
        parentPath, storeName, false, outLease, err)

@borrows
fn CsgCoreMerkleStoreAcquireCurrentHeadExclusiveLease(
        parentPath: str,
        storeName: str,
        outLease: var CsgCoreMerkleStoreCurrentHeadLease,
        err: var str): bool =
    return csgStoreHeadLeaseAcquire(
        parentPath, storeName, true, outLease, err)

@borrows
fn CsgCoreMerkleStoreCurrentHeadLeaseIdOf(
        lease: CsgCoreMerkleStoreCurrentHeadLease): int32 =
    return lease.leaseId

fn CsgCoreMerkleStoreCurrentHeadLeaseVerifyFence(
        lease: var CsgCoreMerkleStoreCurrentHeadLease): bool =
    # Shared fence for the issue mid-point, post-claim check and pre-commit
    # final fence: the lease must still be live and the re-read current head
    # must equal the triple captured under the anchor at acquire time.
    if lease.leaseId <= 0:
        return false
    csgStoreHeadLeaseEnsureRegistry()
    csgStoreHeadLeaseLock()
    let row = lease.leaseId - 1
    let live = row < csgStoreHeadLeaseSlotCount &&
        csgStoreHeadLeaseStates[row] == csgStoreHeadLeaseLive &&
        csgStoreHeadLeaseEpochs[row] == lease.epoch
    csgStoreHeadLeaseUnlock()
    if !live:
        return false
    var present: bool
    var captured: CsgCoreMerkleHead
    var fenceError: str
    if !csgStoreHeadLeaseReadCurrentHead(
           strings.CloneStr(lease.storeRoot),
           present, captured, fenceError):
        return false
    if present != lease.headPresent:
        return false
    if !lease.headPresent:
        return true
    return captured.generation == lease.headGeneration &&
        captured.headCid == lease.headCid &&
        captured.manifestCid == lease.manifestCid

fn CsgCoreMerkleStoreCurrentHeadLeaseReleaseById(
        leaseId: int32,
        epoch: int32): bool =
    csgStoreHeadLeaseEnsureRegistry()
    if leaseId <= 0:
        return false
    csgStoreHeadLeaseLock()
    let row = leaseId - 1
    if row >= csgStoreHeadLeaseSlotCount ||
       csgStoreHeadLeaseStates[row] != csgStoreHeadLeaseLive ||
       csgStoreHeadLeaseEpochs[row] != epoch:
        csgStoreHeadLeaseUnlock()
        return false
    var anchorToClose: uint64
    if csgStoreHeadLeaseAnchorOwned[row] != 0:
        # If joined rows still reference this anchor, hand ownership to one
        # of them instead of closing from under them or failing.
        var heir: int32 = -1
        for i in 0..<csgStoreHeadLeaseSlotCount:
            if i != row &&
               csgStoreHeadLeaseStates[i] == csgStoreHeadLeaseLive &&
               csgStoreHeadLeaseAnchors[i] ==
                   csgStoreHeadLeaseAnchors[row]:
                heir = i
                break
        if heir >= 0:
            csgStoreHeadLeaseAnchorOwned[heir] = 1
        else:
            anchorToClose = csgStoreHeadLeaseAnchors[row]
    csgStoreHeadLeaseUnregisterLocked(row)
    csgStoreHeadLeaseUnlock()
    if anchorToClose != uint64(0):
        csgStoreHeadLeaseCloseAnchor(anchorToClose)
    return true

fn CsgCoreMerkleStoreCurrentHeadLeaseRelease(
        lease: var CsgCoreMerkleStoreCurrentHeadLease) =
    if lease.leaseId > 0:
        if !CsgCoreMerkleStoreCurrentHeadLeaseReleaseById(
               lease.leaseId, lease.epoch):
            panic("merkle store: head lease release invalid")
    lease = CsgCoreMerkleStoreCurrentHeadLease()

fn CsgCoreMerkleStoreCurrentHeadLeaseExclusiveLive(): bool =
    csgStoreHeadLeaseEnsureRegistry()
    csgStoreHeadLeaseLock()
    let count = csgStoreHeadLeaseExclusiveLiveCount
    csgStoreHeadLeaseUnlock()
    return count > 0

@borrows
fn CsgCoreMerkleStoreCurrentHeadLeaseExclusiveLiveForStore(
        parentPath: str,
        storeName: str): bool =
    if !os.IsAbsolute(parentPath) || storeName.len == 0:
        return false
    let storeRoot = os.JoinPath(parentPath, storeName)
    var rootHash: layout.FixedBytes32
    if !csgStoreHeadLeaseStoreRootHash(storeRoot, rootHash):
        return false
    csgStoreHeadLeaseEnsureRegistry()
    csgStoreHeadLeaseLock()
    var found = false
    for i in 0..<csgStoreHeadLeaseSlotCount:
        if csgStoreHeadLeaseStates[i] == csgStoreHeadLeaseLive &&
           csgStoreHeadLeaseExclusives[i] != 0 &&
           layout.FixedBytes32Equal(
               csgStoreHeadLeaseStoreRootHashes[i], rootHash):
            found = true
            break
    csgStoreHeadLeaseUnlock()
    return found

# ---------------------------------------------------------------------------
# Production terminal-journal store-root owner.
#
# A live current-HEAD shared lease is moved into one append-only int32 owner
# row.  The row is never reused.  Store paths, policy/root identities,
# AtomicTree descriptors and the lease epoch remain private SoA columns.
# Journal callers can only operate through the int32 row, so a caller path or
# a copied lease id can never select a durable terminal root.
# ---------------------------------------------------------------------------

const
    # Rows are immutable, append-only capability identities. They are never
    # recycled, so ABA is impossible; exhaustion is an explicit hard failure.
    csgStoreTerminalJournalRootOwnerRowCount: int32 = 16384
    csgStoreTerminalJournalRootOwnerEmpty: int32 = 0
    csgStoreTerminalJournalRootOwnerIssued: int32 = 1
    csgStoreTerminalJournalRootOwnerOpening: int32 = 2
    csgStoreTerminalJournalRootOwnerOpen: int32 = 3
    csgStoreTerminalJournalRootOwnerClosing: int32 = 4
    csgStoreTerminalJournalRootOwnerClosed: int32 = 5
    csgStoreTerminalJournalRootOwnerRecoveryRequired: int32 = 6
    csgStoreTerminalJournalRootOwnerReading: int32 = 7
    csgStoreTerminalJournalRootOwnerAppending: int32 = 8
    csgStoreTerminalJournalRootOwnerCapsuleIssuing: int32 = 9
    csgStoreTerminalRecoveryRegistryRowCount: int32 = 4096
    csgStoreTerminalRecoveryRegistryEmpty: int32 = 0
    csgStoreTerminalRecoveryRegistryReady: int32 = 1
    csgStoreTerminalRecoveryRegistryWaiting: int32 = 2
    csgStoreTerminalRecoveryRegistryHeld: int32 = 3
    csgStoreTerminalRecoveryRegistryReleasing: int32 = 4
    csgStoreTerminalRecoveryRegistryRecoveryRequired: int32 = 5
    csgStoreTerminalJournalRootPrefix: str =
        "terminal-journal-"
    csgStoreTerminalJournalRootPrefixBytes: int32 = 17
    csgStoreTerminalJournalEventsDirectory: str = "events"
    csgStoreTerminalJournalRecordFile: str = "record.bin"
    csgStoreTerminalJournalAdmissionProofFile: str =
        "admission-proof.bin"
    csgStoreTerminalJournalFinishedUploadFile: str =
        "finished-upload.bin"
    csgStoreTerminalJournalDecisionMirrorFile: str =
        "decision-mirror.bin"
    csgStoreTerminalJournalSessionLiveLockFile: str =
        "session-live.lock"
    csgStoreTerminalJournalDecisionFile: str = "decision.bin"
    csgStoreTerminalJournalFinishedName: str = "02-finished"
    csgStoreTerminalJournalDecisionName: str = "03-decision"
    csgStoreTerminalJournalProviderFinalizedName: str =
        "04-provider-finalized"
    csgStoreTerminalJournalExitObservedName: str = "05-exit-observed"
    csgStoreTerminalJournalReapedName: str = "06-reaped"
    csgStoreTerminalJournalRecordBytes: int32 = 512
    csgStoreTerminalJournalDecisionBytes: int32 = 768
    csgStoreTerminalJournalAdmissionProofMinBytes: int32 = 522
    csgStoreTerminalJournalAdmissionProofMaxBytes: int32 = 16777737
    csgStoreTerminalJournalRootOwnerBindingDomain: str =
        "csg_core.store.terminal_journal_root_owner.v1"

var
    csgStoreTerminalJournalRootOwnerRegistryInit: int32
    csgStoreTerminalJournalRootOwnerNextRow: atomic.I32
    csgStoreTerminalJournalRootOwnerStates: atomic.I32[]
    csgStoreTerminalJournalRootOwnerLeaseIds: int32[]
    csgStoreTerminalJournalRootOwnerLeaseEpochs: int32[]
    csgStoreTerminalJournalRootOwnerParentPaths: str[]
    csgStoreTerminalJournalRootOwnerStoreNames: str[]
    csgStoreTerminalJournalRootOwnerStoreRoots: str[]
    csgStoreTerminalJournalRootOwnerStoreRootHashes: layout.FixedBytes32[]
    csgStoreTerminalJournalRootOwnerPolicyCids: str[]
    csgStoreTerminalJournalRootOwnerBindingCids: str[]
    csgStoreTerminalJournalRootOwnerHeadPresent: int32[]
    csgStoreTerminalJournalRootOwnerHeadGenerations: int64[]
    csgStoreTerminalJournalRootOwnerHeadCids: str[]
    csgStoreTerminalJournalRootOwnerManifestCids: str[]
    csgStoreTerminalJournalRootOwnerSessionCids: str[]
    csgStoreTerminalJournalRootOwnerTrees: os.AtomicTree[]
    csgStoreTerminalJournalRootOwnerRecoveryLastNames: str[]
    csgStoreTerminalJournalRootOwnerRecoveryLockOwners: int32[]
    csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners: int32[]
    csgStoreTerminalJournalRootOwnerSessionLiveLockOwners: int32[]
    csgStoreTerminalJournalRootOwnerCapsuleRoleStates: atomic.I32[]
    csgStoreTerminalRecoveryRegistryStates: int32[]
    csgStoreTerminalRecoveryRegistryStoreRootHashes:
        layout.FixedBytes32[]
    csgStoreTerminalRecoveryRegistryBindingCids: str[]
    csgStoreTerminalRecoveryRegistryLockOwners: int32[]

fn csgStoreTerminalJournalRootOwnerInitializeBeforeGuardianLoop():
        bool =
    csgStoreHeadLeaseEnsureRegistry()
    var builder = false
    while !builder:
        os.CsgCurrentHeadLeaseRegistryLock()
        let state = system.RuntimeAtomicLoadI32(
            csgStoreTerminalJournalRootOwnerRegistryInit)
        if state == 2:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return true
        if state == 3:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
        if state == 0:
            builder = system.RuntimeAtomicCompareExchangeI32(
                csgStoreTerminalJournalRootOwnerRegistryInit, 0, 1)
            os.CsgCurrentHeadLeaseRegistryUnlock()
        elif state == 1:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("merkle store: terminal root registry state invalid")
    csgStoreTerminalJournalRootOwnerStates = []
    csgStoreTerminalJournalRootOwnerLeaseIds = []
    csgStoreTerminalJournalRootOwnerLeaseEpochs = []
    csgStoreTerminalJournalRootOwnerParentPaths = []
    csgStoreTerminalJournalRootOwnerStoreNames = []
    csgStoreTerminalJournalRootOwnerStoreRoots = []
    csgStoreTerminalJournalRootOwnerStoreRootHashes = []
    csgStoreTerminalJournalRootOwnerPolicyCids = []
    csgStoreTerminalJournalRootOwnerBindingCids = []
    csgStoreTerminalJournalRootOwnerHeadPresent = []
    csgStoreTerminalJournalRootOwnerHeadGenerations = []
    csgStoreTerminalJournalRootOwnerHeadCids = []
    csgStoreTerminalJournalRootOwnerManifestCids = []
    csgStoreTerminalJournalRootOwnerSessionCids = []
    csgStoreTerminalJournalRootOwnerTrees = []
    csgStoreTerminalJournalRootOwnerRecoveryLastNames = []
    csgStoreTerminalJournalRootOwnerRecoveryLockOwners = []
    csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners = []
    csgStoreTerminalJournalRootOwnerSessionLiveLockOwners = []
    csgStoreTerminalJournalRootOwnerCapsuleRoleStates = []
    csgStoreTerminalRecoveryRegistryStates = []
    csgStoreTerminalRecoveryRegistryStoreRootHashes = []
    csgStoreTerminalRecoveryRegistryBindingCids = []
    csgStoreTerminalRecoveryRegistryLockOwners = []
    for row in 0..<csgStoreTerminalJournalRootOwnerRowCount:
        add(csgStoreTerminalJournalRootOwnerStates,
            atomic.NewI32(csgStoreTerminalJournalRootOwnerEmpty))
        add(csgStoreTerminalJournalRootOwnerLeaseIds, 0)
        add(csgStoreTerminalJournalRootOwnerLeaseEpochs, 0)
        add(csgStoreTerminalJournalRootOwnerParentPaths, "")
        add(csgStoreTerminalJournalRootOwnerStoreNames, "")
        add(csgStoreTerminalJournalRootOwnerStoreRoots, "")
        add(csgStoreTerminalJournalRootOwnerStoreRootHashes,
            layout.FixedBytes32())
        add(csgStoreTerminalJournalRootOwnerPolicyCids, "")
        add(csgStoreTerminalJournalRootOwnerBindingCids, "")
        add(csgStoreTerminalJournalRootOwnerHeadPresent, 0)
        add(csgStoreTerminalJournalRootOwnerHeadGenerations, int64(-1))
        add(csgStoreTerminalJournalRootOwnerHeadCids, "")
        add(csgStoreTerminalJournalRootOwnerManifestCids, "")
        add(csgStoreTerminalJournalRootOwnerSessionCids, "")
        add(csgStoreTerminalJournalRootOwnerTrees, uint64(0))
        add(csgStoreTerminalJournalRootOwnerRecoveryLastNames, "")
        add(csgStoreTerminalJournalRootOwnerRecoveryLockOwners, -1)
        add(csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners, -1)
        add(csgStoreTerminalJournalRootOwnerSessionLiveLockOwners, -1)
        add(csgStoreTerminalJournalRootOwnerCapsuleRoleStates,
            atomic.NewI32(0))
    for recoveryRow in 0..<csgStoreTerminalRecoveryRegistryRowCount:
        add(csgStoreTerminalRecoveryRegistryStates,
            csgStoreTerminalRecoveryRegistryEmpty)
        add(csgStoreTerminalRecoveryRegistryStoreRootHashes,
            layout.FixedBytes32())
        add(csgStoreTerminalRecoveryRegistryBindingCids, "")
        add(csgStoreTerminalRecoveryRegistryLockOwners, -1)
    csgStoreTerminalJournalRootOwnerNextRow = atomic.NewI32(0)
    if csgStoreTerminalJournalRootOwnerNextRow == nil:
        os.CsgCurrentHeadLeaseRegistryLock()
        system.RuntimeAtomicStoreI32(
            csgStoreTerminalJournalRootOwnerRegistryInit, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        return false
    for row in 0..<csgStoreTerminalJournalRootOwnerRowCount:
        if csgStoreTerminalJournalRootOwnerStates[row] == nil:
            os.CsgCurrentHeadLeaseRegistryLock()
            system.RuntimeAtomicStoreI32(
                csgStoreTerminalJournalRootOwnerRegistryInit, 3)
            os.CsgCurrentHeadLeaseRegistryNotifyAll()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
        if csgStoreTerminalJournalRootOwnerCapsuleRoleStates[row] == nil:
            os.CsgCurrentHeadLeaseRegistryLock()
            system.RuntimeAtomicStoreI32(
                csgStoreTerminalJournalRootOwnerRegistryInit, 3)
            os.CsgCurrentHeadLeaseRegistryNotifyAll()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    os.CsgCurrentHeadLeaseRegistryLock()
    if system.RuntimeAtomicLoadI32(
           csgStoreTerminalJournalRootOwnerRegistryInit) != 1:
        system.RuntimeAtomicStoreI32(
            csgStoreTerminalJournalRootOwnerRegistryInit, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("merkle store: terminal root registry publication drift")
    system.RuntimeAtomicStoreI32(
        csgStoreTerminalJournalRootOwnerRegistryInit, 2)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return true

fn csgStoreTerminalJournalPutU32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: uint32) =
    rawbytes.BytesSet(bytes, offset, int32(value & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 1, int32((value >> 8) & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 2, int32((value >> 16) & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 3, int32((value >> 24) & uint32(255)))

fn csgStoreTerminalJournalPutU64(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: uint64) =
    for byteIndex in 0..<8:
        rawbytes.BytesSet(
            bytes,
            offset + byteIndex,
            int32((value >> uint64(byteIndex * 8)) & uint64(255)))

@borrows
fn csgStoreTerminalJournalPutFixed32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<32:
        rawbytes.BytesSet(
            bytes, offset + byteIndex, int32(value.data[byteIndex]))

@borrows
fn csgStoreTerminalJournalRootOwnerBindingCidInto(
        lease: CsgCoreMerkleStoreCurrentHeadLease,
        policyCid: str,
        storeRootHash: layout.FixedBytes32,
        outCid: var str): bool =
    var policyDigest: layout.FixedBytes32
    var headDigest: layout.FixedBytes32
    var manifestDigest: layout.FixedBytes32
    if !merkle_store_codec.csgStoreCodecParseCid(
           policyCid, policyDigest):
        return false
    if lease.headPresent &&
       (!merkle_store_codec.csgStoreCodecParseCid(
            lease.headCid, headDigest) ||
        !merkle_store_codec.csgStoreCodecParseCid(
            lease.manifestCid, manifestDigest)):
        return false
    # The durable binding excludes process-local lease row/epoch.  Those
    # values remain private liveness authority, while a recovery guardian
    # that reacquires the same policy/root/HEAD triple derives identical
    # durable bytes.
    var canonical = rawbytes.BytesAlloc(152)
    rawbytes.BytesSet(canonical, 0, 84)
    rawbytes.BytesSet(canonical, 1, 74)
    rawbytes.BytesSet(canonical, 2, 82)
    rawbytes.BytesSet(canonical, 3, 79)
    csgStoreTerminalJournalPutU32(canonical, 4, uint32(1))
    csgStoreTerminalJournalPutFixed32(canonical, 8, policyDigest)
    csgStoreTerminalJournalPutFixed32(canonical, 40, storeRootHash)
    csgStoreTerminalJournalPutU32(
        canonical, 72, uint32(lease.headPresent ? 1 : 0))
    csgStoreTerminalJournalPutU64(
        canonical, 76, uint64(lease.headGeneration))
    csgStoreTerminalJournalPutFixed32(canonical, 84, headDigest)
    csgStoreTerminalJournalPutFixed32(canonical, 116, manifestDigest)
    outCid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        csgStoreTerminalJournalRootOwnerBindingDomain,
        canonical)
    rawbytes.BytesFree(canonical)
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(outCid)

@borrows
fn csgStoreTerminalJournalRootOwnerLeaseInto(
        row: int32,
        outLease: var CsgCoreMerkleStoreCurrentHeadLease): bool =
    if csgStoreTerminalJournalRootOwnerRegistryInit != 2 ||
       csgStoreTerminalJournalRootOwnerNextRow == nil || row < 0 ||
       row >= atomic.LoadI32(
           csgStoreTerminalJournalRootOwnerNextRow):
        return false
    outLease.leaseId =
        csgStoreTerminalJournalRootOwnerLeaseIds[row]
    outLease.epoch =
        csgStoreTerminalJournalRootOwnerLeaseEpochs[row]
    outLease.parentPath = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerParentPaths[row])
    outLease.storeName = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerStoreNames[row])
    outLease.storeRoot = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerStoreRoots[row])
    outLease.headPresent =
        csgStoreTerminalJournalRootOwnerHeadPresent[row] != 0
    outLease.headGeneration =
        csgStoreTerminalJournalRootOwnerHeadGenerations[row]
    outLease.headCid = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerHeadCids[row])
    outLease.manifestCid = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerManifestCids[row])
    return outLease.leaseId > 0 && outLease.epoch > 0

fn csgStoreTerminalJournalRootOwnerFenceHeld(row: int32): bool =
    var lease: CsgCoreMerkleStoreCurrentHeadLease
    return csgStoreTerminalJournalRootOwnerLeaseInto(row, lease) &&
        CsgCoreMerkleStoreCurrentHeadLeaseVerifyFence(lease)

fn csgStoreTerminalJournalRootOwnerParentAuthority(row: int32): os.AtomicTree =
    if row < 0 || row >= csgStoreTerminalJournalRootOwnerRowCount:
        return uint64(0)
    csgStoreHeadLeaseEnsureRegistry()
    csgStoreHeadLeaseLock()
    let leaseRow = csgStoreTerminalJournalRootOwnerLeaseIds[row] - 1
    var authority: os.AtomicTree
    if leaseRow >= 0 && leaseRow < csgStoreHeadLeaseSlotCount &&
       csgStoreHeadLeaseStates[leaseRow] == csgStoreHeadLeaseLive &&
       csgStoreHeadLeaseEpochs[leaseRow] ==
           csgStoreTerminalJournalRootOwnerLeaseEpochs[row] &&
       layout.FixedBytes32Equal(
           csgStoreHeadLeaseStoreRootHashes[leaseRow],
           csgStoreTerminalJournalRootOwnerStoreRootHashes[row]):
        authority = csgStoreHeadLeaseAnchors[leaseRow]
    csgStoreHeadLeaseUnlock()
    return authority

fn csgStoreTerminalJournalRootOwnerVerifyFence(
        ownerHandle: int32): bool =
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        return false
    let row = ownerHandle - 1
    var prior: int32 = csgStoreTerminalJournalRootOwnerIssued
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerIssued,
           csgStoreTerminalJournalRootOwnerReading):
        prior = csgStoreTerminalJournalRootOwnerOpen
        if !atomic.CasI32(
               csgStoreTerminalJournalRootOwnerStates[row],
               csgStoreTerminalJournalRootOwnerOpen,
               csgStoreTerminalJournalRootOwnerReading):
            return false
    let valid = csgStoreTerminalJournalRootOwnerFenceHeld(row)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        valid ? prior :
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
    return valid

# Process-local singleflight for one durable store root.  The row is stable
# for the process lifetime; launcher startups reuse it instead of allocating
# one recovery-lock row per acquisition.  The native owner token carries its
# own generation, and release requires the exact token stored by the winner.
@borrows
fn csgStoreTerminalRecoveryRegistryAcquireInto(
        leaseAnchor: os.AtomicTree,
        storeRootHash: layout.FixedBytes32,
        bindingCid: str,
        outRegistryOwner: var int32,
        outLockOwner: var int32,
        err: var str): bool =
    outRegistryOwner = -1
    outLockOwner = -1
    var registryRow: int32 = -1
    while registryRow < 0:
        csgStoreHeadLeaseLock()
        var matchingRow: int32 = -1
        var emptyRow: int32 = -1
        for candidateRow in 0..<csgStoreTerminalRecoveryRegistryRowCount:
            if csgStoreTerminalRecoveryRegistryStates[candidateRow] ==
                   csgStoreTerminalRecoveryRegistryEmpty:
                if emptyRow < 0:
                    emptyRow = candidateRow
            elif layout.FixedBytes32Equal(
                   csgStoreTerminalRecoveryRegistryStoreRootHashes[
                       candidateRow],
                   storeRootHash):
                matchingRow = candidateRow
                break
        if matchingRow < 0:
            if emptyRow < 0:
                csgStoreHeadLeaseUnlock()
                err = "merkle_store_terminal_recovery_registry_exhausted"
                return false
            matchingRow = emptyRow
            csgStoreTerminalRecoveryRegistryStoreRootHashes[matchingRow] =
                storeRootHash
            csgStoreTerminalRecoveryRegistryBindingCids[matchingRow] =
                strings.CloneStr(bindingCid)
            csgStoreTerminalRecoveryRegistryLockOwners[matchingRow] = -1
            csgStoreTerminalRecoveryRegistryStates[matchingRow] =
                csgStoreTerminalRecoveryRegistryReady
        let state = csgStoreTerminalRecoveryRegistryStates[matchingRow]
        if state == csgStoreTerminalRecoveryRegistryReady:
            csgStoreTerminalRecoveryRegistryBindingCids[matchingRow] =
                strings.CloneStr(bindingCid)
            csgStoreTerminalRecoveryRegistryStates[matchingRow] =
                csgStoreTerminalRecoveryRegistryWaiting
            registryRow = matchingRow
            csgStoreHeadLeaseUnlock()
        elif state == csgStoreTerminalRecoveryRegistryWaiting ||
             state == csgStoreTerminalRecoveryRegistryHeld ||
             state == csgStoreTerminalRecoveryRegistryReleasing:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            csgStoreHeadLeaseUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            csgStoreHeadLeaseUnlock()
            err = "merkle_store_terminal_recovery_registry_failed"
            return false
    var lockOwner: int32
    if !os.AtomicTreeTerminalRecoveryLockOwnerAcquireInto(
           leaseAnchor, lockOwner, err):
        csgStoreHeadLeaseLock()
        if csgStoreTerminalRecoveryRegistryStates[registryRow] !=
               csgStoreTerminalRecoveryRegistryWaiting:
            csgStoreHeadLeaseUnlock()
            panic("merkle store: terminal recovery registry acquire drift")
        csgStoreTerminalRecoveryRegistryStates[registryRow] =
            csgStoreTerminalRecoveryRegistryReady
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        csgStoreHeadLeaseUnlock()
        return false
    csgStoreHeadLeaseLock()
    let exact =
        csgStoreTerminalRecoveryRegistryStates[registryRow] ==
            csgStoreTerminalRecoveryRegistryWaiting &&
        layout.FixedBytes32Equal(
            csgStoreTerminalRecoveryRegistryStoreRootHashes[registryRow],
            storeRootHash) &&
        csgStoreTerminalRecoveryRegistryBindingCids[registryRow] == bindingCid
    if !exact:
        csgStoreHeadLeaseUnlock()
        if !os.AtomicTreeTerminalRecoveryLockOwnerRelease(lockOwner):
            panic("merkle store: terminal recovery registry drift release")
        panic("merkle store: terminal recovery registry publication drift")
    csgStoreTerminalRecoveryRegistryLockOwners[registryRow] = lockOwner
    csgStoreTerminalRecoveryRegistryStates[registryRow] =
        csgStoreTerminalRecoveryRegistryHeld
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    csgStoreHeadLeaseUnlock()
    outRegistryOwner = registryRow + 1
    outLockOwner = lockOwner
    err = ""
    return true

fn csgStoreTerminalRecoveryRegistryReleaseInto(
        registryOwner: int32,
        lockOwner: int32,
        err: var str): bool =
    let registryRow = registryOwner - 1
    if registryRow < 0 ||
       registryRow >= csgStoreTerminalRecoveryRegistryRowCount ||
       lockOwner <= 0:
        err = "merkle_store_terminal_recovery_registry_owner_invalid"
        return false
    csgStoreHeadLeaseLock()
    if csgStoreTerminalRecoveryRegistryStates[registryRow] !=
           csgStoreTerminalRecoveryRegistryHeld ||
       csgStoreTerminalRecoveryRegistryLockOwners[registryRow] != lockOwner:
        csgStoreHeadLeaseUnlock()
        err = "merkle_store_terminal_recovery_registry_release_invalid"
        return false
    csgStoreTerminalRecoveryRegistryStates[registryRow] =
        csgStoreTerminalRecoveryRegistryReleasing
    csgStoreHeadLeaseUnlock()
    let released = os.AtomicTreeTerminalRecoveryLockOwnerRelease(lockOwner)
    csgStoreHeadLeaseLock()
    if csgStoreTerminalRecoveryRegistryStates[registryRow] !=
           csgStoreTerminalRecoveryRegistryReleasing ||
       csgStoreTerminalRecoveryRegistryLockOwners[registryRow] != lockOwner:
        csgStoreHeadLeaseUnlock()
        panic("merkle store: terminal recovery registry release drift")
    csgStoreTerminalRecoveryRegistryLockOwners[registryRow] = -1
    csgStoreTerminalRecoveryRegistryStates[registryRow] = released ?
        csgStoreTerminalRecoveryRegistryReady :
        csgStoreTerminalRecoveryRegistryRecoveryRequired
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    csgStoreHeadLeaseUnlock()
    if !released:
        err = "merkle_store_terminal_recovery_registry_unlock_failed"
        return false
    err = ""
    return true

fn csgStoreTerminalJournalRootOwnerReleaseRecoveryLockAfterLiveInto(
        ownerRow: int32,
        err: var str): bool =
    if ownerRow < 0 ||
       ownerRow >= csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_recovery_live_owner_invalid"
        return false
    let lockOwner =
        csgStoreTerminalJournalRootOwnerRecoveryLockOwners[ownerRow]
    let registryOwner =
        csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners[ownerRow]
    if atomic.LoadI32(
           csgStoreTerminalJournalRootOwnerStates[ownerRow]) !=
               csgStoreTerminalJournalRootOwnerOpen ||
       csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[ownerRow] <= 0 ||
       csgStoreTerminalJournalRootOwnerTrees[ownerRow] == uint64(0) ||
       csgStoreTerminalJournalRootOwnerSessionCids[ownerRow].len == 0 ||
       lockOwner <= 0 || registryOwner <= 0 ||
       !csgStoreTerminalJournalRootOwnerFenceHeld(ownerRow):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[ownerRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_recovery_live_join_invalid"
        return false
    if !csgStoreTerminalRecoveryRegistryReleaseInto(
           registryOwner, lockOwner, err):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[ownerRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_recovery_lock_release_failed"
        return false
    csgStoreTerminalJournalRootOwnerRecoveryLockOwners[ownerRow] = -1
    csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners[ownerRow] = -1
    err = ""
    return true

@borrows
fn CsgCoreMerkleStoreTerminalJournalRootOwnerIssueInto(
        lease: var CsgCoreMerkleStoreCurrentHeadLease,
        policyCid: str,
        outOwnerHandle: var int32,
        err: var str): bool =
    outOwnerHandle = -1
    if lease.leaseId <= 0 || lease.epoch <= 0 ||
       !os.IsAbsolute(lease.storeRoot) ||
       !CsgCoreMerkleStoreCurrentHeadLeaseVerifyFence(lease):
        err = "merkle_store_terminal_journal_head_lease_invalid"
        return false
    var storeRootHash: layout.FixedBytes32
    var bindingCid: str
    if !csgStoreHeadLeaseStoreRootHash(
           lease.storeRoot, storeRootHash) ||
       !csgStoreTerminalJournalRootOwnerBindingCidInto(
           lease, policyCid, storeRootHash, bindingCid):
        err = "merkle_store_terminal_journal_store_binding_invalid"
        return false
    if csgStoreTerminalJournalRootOwnerRegistryInit != 2 ||
       csgStoreTerminalJournalRootOwnerNextRow == nil:
        err = "merkle_store_terminal_journal_registry_uninitialized"
        return false
    csgStoreHeadLeaseEnsureRegistry()
    csgStoreHeadLeaseLock()
    let leaseRow = lease.leaseId - 1
    var leaseLive = leaseRow >= 0 &&
        leaseRow < csgStoreHeadLeaseSlotCount &&
        csgStoreHeadLeaseStates[leaseRow] == csgStoreHeadLeaseLive &&
        csgStoreHeadLeaseEpochs[leaseRow] == lease.epoch &&
        layout.FixedBytes32Equal(
            csgStoreHeadLeaseStoreRootHashes[leaseRow], storeRootHash)
    let leaseAnchor = leaseLive ? csgStoreHeadLeaseAnchors[leaseRow] :
        uint64(0)
    csgStoreHeadLeaseUnlock()
    if !leaseLive:
        err = "merkle_store_terminal_journal_head_lease_raced"
        return false
    var recoveryRegistryOwner: int32
    var recoveryLockOwner: int32
    if !csgStoreTerminalRecoveryRegistryAcquireInto(
           leaseAnchor,
           storeRootHash,
           bindingCid,
           recoveryRegistryOwner,
           recoveryLockOwner,
           err):
        return false
    # The blocking cross-process lock may have waited behind another
    # guardian. Re-read the durable HEAD fence before this process can mint
    # a recovery cursor; the earlier snapshot is not authority after wait.
    let fenceValidAfterWait =
        CsgCoreMerkleStoreCurrentHeadLeaseVerifyFence(lease)
    csgStoreHeadLeaseLock()
    leaseLive = fenceValidAfterWait && leaseRow >= 0 &&
        leaseRow < csgStoreHeadLeaseSlotCount &&
        csgStoreHeadLeaseStates[leaseRow] == csgStoreHeadLeaseLive &&
        csgStoreHeadLeaseEpochs[leaseRow] == lease.epoch &&
        csgStoreHeadLeaseAnchors[leaseRow] == leaseAnchor &&
        layout.FixedBytes32Equal(
            csgStoreHeadLeaseStoreRootHashes[leaseRow], storeRootHash)
    if !leaseLive:
        csgStoreHeadLeaseUnlock()
        var releaseErr: str
        if !csgStoreTerminalRecoveryRegistryReleaseInto(
               recoveryRegistryOwner, recoveryLockOwner, releaseErr):
            panic("merkle store: terminal recovery lock release after fence drift")
        err = "merkle_store_terminal_journal_head_lease_changed_while_waiting"
        return false
    let row = atomic.FetchAddI32(
        csgStoreTerminalJournalRootOwnerNextRow, 1)
    if row < 0 || row >= csgStoreTerminalJournalRootOwnerRowCount:
        csgStoreHeadLeaseUnlock()
        var releaseErr: str
        if !csgStoreTerminalRecoveryRegistryReleaseInto(
               recoveryRegistryOwner, recoveryLockOwner, releaseErr):
            panic("merkle store: terminal recovery lock release after arena exhaustion")
        err = "merkle_store_terminal_journal_owner_arena_exhausted"
        return false
    csgStoreTerminalJournalRootOwnerLeaseIds[row] = lease.leaseId
    csgStoreTerminalJournalRootOwnerLeaseEpochs[row] = lease.epoch
    csgStoreTerminalJournalRootOwnerParentPaths[row] =
        strings.CloneStr(lease.parentPath)
    csgStoreTerminalJournalRootOwnerStoreNames[row] =
        strings.CloneStr(lease.storeName)
    csgStoreTerminalJournalRootOwnerStoreRoots[row] =
        strings.CloneStr(lease.storeRoot)
    csgStoreTerminalJournalRootOwnerStoreRootHashes[row] = storeRootHash
    csgStoreTerminalJournalRootOwnerPolicyCids[row] =
        strings.CloneStr(policyCid)
    csgStoreTerminalJournalRootOwnerBindingCids[row] =
        strings.CloneStr(bindingCid)
    csgStoreTerminalJournalRootOwnerHeadPresent[row] =
        lease.headPresent ? 1 : 0
    csgStoreTerminalJournalRootOwnerHeadGenerations[row] =
        lease.headGeneration
    csgStoreTerminalJournalRootOwnerHeadCids[row] =
        strings.CloneStr(lease.headCid)
    csgStoreTerminalJournalRootOwnerManifestCids[row] =
        strings.CloneStr(lease.manifestCid)
    csgStoreTerminalJournalRootOwnerRecoveryLockOwners[row] =
        recoveryLockOwner
    csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners[row] =
        recoveryRegistryOwner
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerIssued)
    csgStoreHeadLeaseUnlock()
    # Ownership of the live lease row moved into the append-only owner row.
    # The caller can no longer release or copy authority from this value.
    lease = CsgCoreMerkleStoreCurrentHeadLease()
    outOwnerHandle = row + 1
    err = ""
    return true

fn csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
        ownerHandle: int32,
        outBindingCid: var str,
        err: var str): bool =
    outBindingCid = ""
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_owner_handle_invalid"
        return false
    let row = ownerHandle - 1
    var prior: int32 = csgStoreTerminalJournalRootOwnerIssued
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerIssued,
           csgStoreTerminalJournalRootOwnerReading):
        prior = csgStoreTerminalJournalRootOwnerOpen
        if !atomic.CasI32(
               csgStoreTerminalJournalRootOwnerStates[row],
               csgStoreTerminalJournalRootOwnerOpen,
               csgStoreTerminalJournalRootOwnerReading):
            err = "merkle_store_terminal_journal_owner_state_invalid"
            return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_owner_fence_invalid"
        return false
    outBindingCid = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerBindingCids[row])
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row], prior)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(outBindingCid):
        outBindingCid = ""
        err = "merkle_store_terminal_journal_owner_binding_invalid"
        return false
    err = ""
    return true

# Exact int32 root-owner projection used by the sole admitted-input issuer.
# The live lease, path and descriptor identity never leave this module.
fn CsgCoreMerkleStoreTerminalJournalRootOwnerCurrentBindingCidInto(
        ownerHandle: int32,
        outBindingCid: var str,
        err: var str): bool =
    return csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
        ownerHandle, outBindingCid, err)

@borrows
fn csgStoreTerminalJournalAbortOwned(
        row: int32,
        transaction: var os.AtomicTree,
        reason: str,
        err: var str): bool =
    if transaction != uint64(0):
        let aborted = os.AtomicTreeAbort(transaction)
        transaction = uint64(0)
        if result.IsErr(aborted):
            panic("merkle store: terminal journal abort failed")
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerRecoveryRequired)
    err = strings.CloneStr(reason)
    return false

fn csgStoreTerminalJournalCloseRootAndLiveLockOrPanic(
        root: os.AtomicTree,
        liveLockOwner: int32,
        failure: str) =
    if root != uint64(0):
        let closed = os.AtomicTreeClose(root)
        if result.IsErr(closed):
            panic(strings.ConcatStr(failure, ":root_close"))
    if liveLockOwner > 0 &&
       !os.AtomicTreeTerminalSessionLiveLockOwnerRelease(liveLockOwner):
        panic(strings.ConcatStr(failure, ":live_lock_release"))

@borrows
fn csgStoreTerminalJournalVerifyReadback(
        root: os.AtomicTree,
        directory: str,
        finalName: str,
        expected: rawbytes.Bytes,
        decisionCanonical: str,
        err: var str): bool =
    let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
        root, directory, finalName)
    if result.IsErr(opened):
        err = strings.CloneStr(result.Error(opened))
        return false
    let child = result.Value(opened)
    var noDirectories: str[]
    var exactShape = true
    if decisionCanonical.len == csgStoreTerminalJournalDecisionBytes:
        let exact = os.AtomicTreeVerifyExact(
            child,
            noDirectories,
            [strings.CloneStr(csgStoreTerminalJournalDecisionFile),
             strings.CloneStr(csgStoreTerminalJournalRecordFile)])
        exactShape = result.IsOk(exact)
    else:
        let exact = os.AtomicTreeVerifyExact(
            child,
            noDirectories,
            [strings.CloneStr(csgStoreTerminalJournalRecordFile)])
        exactShape = result.IsOk(exact)
    if !exactShape:
        let closedInvalid = os.AtomicTreeClose(child)
        if result.IsErr(closedInvalid):
            panic("merkle store: terminal journal invalid child close")
        err = "merkle_store_terminal_journal_child_shape_invalid"
        return false
    let read = os.AtomicTreeReadStable(
        child, csgStoreTerminalJournalRecordFile)
    if result.IsErr(read):
        let closedRead = os.AtomicTreeClose(child)
        if result.IsErr(closedRead):
            panic("merkle store: terminal journal child read close failed")
        err = strings.CloneStr(result.Error(read))
        return false
    var installed = result.Value(read)
    let matches = rawbytes.BytesEqual(installed, expected)
    rawbytes.BytesFree(installed)
    if !matches:
        let closedMismatch = os.AtomicTreeClose(child)
        if result.IsErr(closedMismatch):
            panic("merkle store: terminal journal mismatch close failed")
        err = "merkle_store_terminal_journal_readback_mismatch"
        return false
    if decisionCanonical.len == csgStoreTerminalJournalDecisionBytes:
        let decisionRead = os.AtomicTreeReadStable(
            child, csgStoreTerminalJournalDecisionFile)
        if result.IsErr(decisionRead):
            let closedDecisionRead = os.AtomicTreeClose(child)
            if result.IsErr(closedDecisionRead):
                panic("merkle store: terminal decision read close failed")
            err = strings.CloneStr(result.Error(decisionRead))
            return false
        var installedDecision = result.Value(decisionRead)
        var expectedDecision = rawbytes.BytesFromString(decisionCanonical)
        let decisionMatches = rawbytes.BytesEqual(
            installedDecision, expectedDecision)
        rawbytes.BytesFree(installedDecision)
        if !decisionMatches:
            let closedDecisionMismatch = os.AtomicTreeClose(child)
            if result.IsErr(closedDecisionMismatch):
                panic("merkle store: terminal decision mismatch close")
            err = "merkle_store_terminal_journal_decision_readback_mismatch"
            return false
    let closed = os.AtomicTreeClose(child)
    if result.IsErr(closed):
        panic("merkle store: terminal journal child close failed")
    return true

@borrows
fn csgStoreTerminalJournalRootOwnerOpenClaimedInto(
        ownerHandle: int32,
        sessionCid: str,
        claimedRecord: rawbytes.Bytes,
        admissionProofCanonical: rawbytes.Bytes,
        err: var str): bool =
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(sessionCid) ||
       rawbytes.BytesLen(claimedRecord) !=
           csgStoreTerminalJournalRecordBytes ||
       rawbytes.BytesLen(admissionProofCanonical) <
           csgStoreTerminalJournalAdmissionProofMinBytes ||
       rawbytes.BytesLen(admissionProofCanonical) >
           csgStoreTerminalJournalAdmissionProofMaxBytes:
        err = "merkle_store_terminal_journal_open_input_invalid"
        return false
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerIssued,
           csgStoreTerminalJournalRootOwnerOpening):
        err = "merkle_store_terminal_journal_open_state_invalid"
        return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_open_fence_invalid"
        return false
    let storeRoot = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerStoreRoots[row])
    let rootName = strings.ConcatStr(
        csgStoreTerminalJournalRootPrefix,
        merkle_store_codec.CsgCoreMerkleStoreCidName(sessionCid))
    let parentAuthority =
        csgStoreTerminalJournalRootOwnerParentAuthority(row)
    if parentAuthority == uint64(0):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_parent_authority_invalid"
        return false
    let opened =
        os.AtomicTreeOpenVerifiedSiblingFromExclusiveParentOrAbsent(
            parentAuthority, rootName)
    if result.IsErr(opened):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(opened))
        return false
    let openedValue = result.Value(opened)
    var root = openedValue.tree
    var sessionLiveLockOwner: int32 = -1
    if openedValue.kind == os.AtomicTreeExclusiveAbsent:
        let stagingName = strings.ConcatStr(
            ".terminal-journal-root-",
            strings.ConcatStr(
                merkle_store_codec.CsgCoreMerkleStoreCidName(sessionCid),
                strings.ConcatStr("-", strings.IntToStr(os.ProcessId()))))
        let begun = os.AtomicTreeBeginFromExclusiveAbsent(root, stagingName)
        if result.IsErr(begun):
            return csgStoreTerminalJournalAbortOwned(
                row, root, result.Error(begun), err)
        var transaction = result.Value(begun)
        if root != uint64(0):
            panic("merkle store: terminal journal absent root not consumed")
        let made = os.AtomicTreeMkdir(
            transaction, csgStoreTerminalJournalEventsDirectory)
        if result.IsErr(made):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(made), err)
        let written = os.AtomicTreeWriteExclusiveLeaseSync(
            transaction,
            csgStoreTerminalJournalRecordFile,
            claimedRecord)
        if result.IsErr(written):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(written), err)
        let proofWritten = os.AtomicTreeWriteExclusiveLeaseSync(
            transaction,
            csgStoreTerminalJournalAdmissionProofFile,
            admissionProofCanonical)
        if result.IsErr(proofWritten):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(proofWritten), err)
        let finishedSeed = rawbytes.EmptyBytes()
        let finishedWritten = os.AtomicTreeWriteExclusiveLeaseSync(
            transaction,
            csgStoreTerminalJournalFinishedUploadFile,
            finishedSeed)
        if result.IsErr(finishedWritten):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(finishedWritten), err)
        var decisionSeed = rawbytes.BytesAlloc(
            csgStoreTerminalJournalDecisionBytes)
        if rawbytes.BytesLen(decisionSeed) !=
           csgStoreTerminalJournalDecisionBytes:
            return csgStoreTerminalJournalAbortOwned(
                row,
                transaction,
                "merkle_store_terminal_journal_decision_seed_alloc_failed",
                err)
        let decisionWritten = os.AtomicTreeWriteExclusiveLeaseSync(
            transaction,
            csgStoreTerminalJournalDecisionMirrorFile,
            decisionSeed)
        rawbytes.BytesFree(decisionSeed)
        if result.IsErr(decisionWritten):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(decisionWritten), err)
        let liveLockSeed = rawbytes.EmptyBytes()
        let liveLockWritten = os.AtomicTreeWriteExclusiveLeaseSync(
            transaction,
            csgStoreTerminalJournalSessionLiveLockFile,
            liveLockSeed)
        if result.IsErr(liveLockWritten):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(liveLockWritten), err)
        let exact = os.AtomicTreeVerifyExact(
            transaction,
            [strings.CloneStr(csgStoreTerminalJournalEventsDirectory)],
            [strings.CloneStr(
                 csgStoreTerminalJournalAdmissionProofFile),
             strings.CloneStr(csgStoreTerminalJournalDecisionMirrorFile),
             strings.CloneStr(csgStoreTerminalJournalFinishedUploadFile),
             strings.CloneStr(csgStoreTerminalJournalRecordFile),
             strings.CloneStr(csgStoreTerminalJournalSessionLiveLockFile)])
        if result.IsErr(exact):
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(exact), err)
        if !os.AtomicTreeTerminalSessionLiveLockOwnerAcquirePreparedInto(
               transaction, sessionLiveLockOwner, err):
            let liveLockFailure = strings.CloneStr(err)
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, liveLockFailure, err)
        let committed =
            os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(
                transaction)
        if result.IsErr(committed):
            if !os.AtomicTreeTerminalSessionLiveLockOwnerRelease(
                   sessionLiveLockOwner):
                panic("merkle store: terminal live lock release after commit failure")
            sessionLiveLockOwner = -1
            return csgStoreTerminalJournalAbortOwned(
                row, transaction, result.Error(committed), err)
        if transaction != uint64(0):
            panic("merkle store: terminal journal root commit not consumed")
        root = result.Value(committed)
    else:
        let closedExisting = os.AtomicTreeClose(root)
        if result.IsErr(closedExisting):
            panic("merkle store: terminal journal existing root close")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = openedValue.kind == os.AtomicTreeExclusiveOpened ?
            "merkle_store_terminal_journal_session_already_exists" :
            "merkle_store_terminal_journal_root_open_kind_invalid"
        return false
    let rootExact = os.AtomicTreeVerifyRootExact(
        root,
        [strings.CloneStr(csgStoreTerminalJournalEventsDirectory)],
        [strings.CloneStr(csgStoreTerminalJournalAdmissionProofFile),
         strings.CloneStr(csgStoreTerminalJournalDecisionMirrorFile),
         strings.CloneStr(csgStoreTerminalJournalFinishedUploadFile),
         strings.CloneStr(csgStoreTerminalJournalRecordFile),
         strings.CloneStr(csgStoreTerminalJournalSessionLiveLockFile)])
    if result.IsErr(rootExact):
        csgStoreTerminalJournalCloseRootAndLiveLockOrPanic(
            root,
            sessionLiveLockOwner,
            "merkle store: terminal journal root shape")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_root_shape_invalid"
        return false
    if sessionLiveLockOwner <= 0:
        panic("merkle store: committed session live lock missing")
    let read = os.AtomicTreeReadStable(
        root, csgStoreTerminalJournalRecordFile)
    if result.IsErr(read):
        csgStoreTerminalJournalCloseRootAndLiveLockOrPanic(
            root,
            sessionLiveLockOwner,
            "merkle store: terminal journal root read")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(read))
        return false
    var installed = result.Value(read)
    let rootMatches = rawbytes.BytesEqual(installed, claimedRecord)
    rawbytes.BytesFree(installed)
    if !rootMatches:
        csgStoreTerminalJournalCloseRootAndLiveLockOrPanic(
            root,
            sessionLiveLockOwner,
            "merkle store: terminal journal root mismatch")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_claimed_replay_mismatch"
        return false
    let proofRead = os.AtomicTreeReadStable(
        root, csgStoreTerminalJournalAdmissionProofFile)
    if result.IsErr(proofRead):
        csgStoreTerminalJournalCloseRootAndLiveLockOrPanic(
            root,
            sessionLiveLockOwner,
            "merkle store: terminal admission proof read")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(proofRead))
        return false
    var installedProof = result.Value(proofRead)
    let proofMatches = rawbytes.BytesEqual(
        installedProof, admissionProofCanonical)
    rawbytes.BytesFree(installedProof)
    if !proofMatches:
        csgStoreTerminalJournalCloseRootAndLiveLockOrPanic(
            root,
            sessionLiveLockOwner,
            "merkle store: terminal admission proof mismatch")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_admission_proof_replay_mismatch"
        return false
    csgStoreTerminalJournalRootOwnerTrees[row] = root
    csgStoreTerminalJournalRootOwnerSessionCids[row] =
        strings.CloneStr(sessionCid)
    csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row] =
        sessionLiveLockOwner
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerOpen)
    if !csgStoreTerminalJournalRootOwnerReleaseRecoveryLockAfterLiveInto(
           row, err):
        return false
    err = ""
    return true

fn csgStoreTerminalJournalRootOwnerIssueCapsuleRoleOwnerInto(
        ownerHandle: int32,
        outProviderRoleOwner: var int32,
        outExitPermission0: var int32,
        outExitPermission1: var int32,
        outExitPermission2: var int32,
        outExitPermission3: var int32,
        outReapPermission0: var int32,
        outReapPermission1: var int32,
        outReapPermission2: var int32,
        outReapPermission3: var int32,
        err: var str): bool =
    outProviderRoleOwner = -1
    outExitPermission0 = 0
    outExitPermission1 = 0
    outExitPermission2 = 0
    outExitPermission3 = 0
    outReapPermission0 = 0
    outReapPermission1 = 0
    outReapPermission2 = 0
    outReapPermission3 = 0
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_capsule_owner_invalid"
        return false
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerCapsuleIssuing):
        err = "merkle_store_terminal_capsule_root_state_invalid"
        return false
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerCapsuleRoleStates[row], 0, 1):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerOpen)
        err = "merkle_store_terminal_capsule_roles_already_issued"
        return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerCapsuleRoleStates[row], 3)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_capsule_fence_invalid"
        return false
    let root = csgStoreTerminalJournalRootOwnerTrees[row]
    var providerRoleOwner: int32
    if root == uint64(0) ||
       !os.AtomicTreeOpenTerminalCapsuleRoleOwnerInto(
           root,
           providerRoleOwner,
           outExitPermission0,
           outExitPermission1,
           outExitPermission2,
           outExitPermission3,
           outReapPermission0,
           outReapPermission1,
           outReapPermission2,
           outReapPermission3,
           err) ||
       !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        if providerRoleOwner > 0 &&
           !os.AtomicTreeTerminalCapsuleRoleOwnerAbort(
               providerRoleOwner):
            panic("merkle store: terminal capsule role owner abort failed")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerCapsuleRoleStates[row], 3)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        if err.len == 0:
            err = "merkle_store_terminal_capsule_postopen_fence_invalid"
        outExitPermission0 = 0
        outExitPermission1 = 0
        outExitPermission2 = 0
        outExitPermission3 = 0
        outReapPermission0 = 0
        outReapPermission1 = 0
        outReapPermission2 = 0
        outReapPermission3 = 0
        return false
    outProviderRoleOwner = providerRoleOwner
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerCapsuleRoleStates[row], 2)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerOpen)
    err = ""
    return true

fn csgStoreTerminalJournalRootOwnerFinishedRecoveryOwnerInto(
        rootOwnerHandle: int32,
        childPid: int32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64,
        outRecoveryOwner: var int32,
        err: var str): bool =
    outRecoveryOwner = -1
    if rootOwnerHandle <= 0 ||
       rootOwnerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_finished_recovery_owner_invalid"
        return false
    let row = rootOwnerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerReading):
        err = "merkle_store_terminal_finished_recovery_state_invalid"
        return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_finished_recovery_fence_invalid"
        return false
    let tree = csgStoreTerminalJournalRootOwnerTrees[row]
    var recoveryOwner: int32
    let opened = tree != uint64(0) &&
        os.AtomicTreeOpenTerminalFinishedRecoveryOwnerInto(
            tree,
            childPid,
            childBirthPlatform,
            childBirth0,
            childBirth1,
            recoveryOwner,
            err)
    let fenceStillHeld = opened &&
        csgStoreTerminalJournalRootOwnerFenceHeld(row)
    if !fenceStillHeld:
        if recoveryOwner > 0 &&
           !system.RuntimeHeldExecFinishedRecoveryOwnerAbort(
               recoveryOwner):
            panic("merkle store: finished recovery owner abort failed")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        return false
    outRecoveryOwner = recoveryOwner
    err = ""
    return true

fn csgStoreTerminalJournalRootOwnerFinishedRecoveryCompleteInto(
        rootOwnerHandle: int32,
        strictComplete: bool,
        err: var str): bool =
    if rootOwnerHandle <= 0 ||
       rootOwnerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_finished_recovery_complete_invalid"
        return false
    let row = rootOwnerHandle - 1
    let valid = strictComplete &&
        csgStoreTerminalJournalRootOwnerFenceHeld(row)
    if !valid:
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_finished_recovery_complete_failed"
        return false
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerReading,
           csgStoreTerminalJournalRootOwnerOpen):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_finished_recovery_release_failed"
        return false
    err = ""
    return true

@borrows
fn csgStoreTerminalJournalRecoveryNameValid(name: str): bool =
    if name.len != csgStoreTerminalJournalRootPrefixBytes + 64 ||
       !strings.HasPrefix(name, csgStoreTerminalJournalRootPrefix):
        return false
    let suffix = strings.CloneStrRange(
        name, csgStoreTerminalJournalRootPrefixBytes, 64)
    let parsed = layout.FixedBytes32FromHex(suffix)
    return result.IsOk(parsed)

@borrows
fn csgStoreTerminalJournalEventsNamesValid(
        storeRoot: str,
        rootName: str): bool =
    let eventsPath = os.JoinPath(
        os.JoinPath(storeRoot, rootName),
        csgStoreTerminalJournalEventsDirectory)
    let names = os.ListDir(eventsPath)
    var seenFinished: bool
    var seenDecision: bool
    var seenExitObserved: bool
    var seenReaped: bool
    var seenProviderFinalized: bool
    for index in 0..<names.len:
        let name = names[index]
        if name == csgStoreTerminalJournalFinishedName &&
           !seenFinished:
            seenFinished = true
        elif name == csgStoreTerminalJournalDecisionName &&
             !seenDecision:
            seenDecision = true
        elif name == csgStoreTerminalJournalExitObservedName &&
             !seenExitObserved:
            seenExitObserved = true
        elif name == csgStoreTerminalJournalReapedName && !seenReaped:
            seenReaped = true
        elif name == csgStoreTerminalJournalProviderFinalizedName &&
             !seenProviderFinalized:
            seenProviderFinalized = true
        else:
            return false
    # No phase may appear after a missing predecessor.  This is only the
    # durable directory shape check; the journal decoder proves record bytes.
    return (!seenDecision || seenFinished) &&
        (!seenProviderFinalized || seenDecision) &&
        (!seenExitObserved || seenProviderFinalized) &&
        (!seenReaped || seenExitObserved)

@borrows
fn csgStoreTerminalJournalRecoverySelectNameInto(
        storeRoot: str,
        afterName: str,
        outName: var str,
        err: var str): bool =
    outName = ""
    let names = os.ListDir(storeRoot)
    for index in 0..<names.len:
        let name = names[index]
        if !strings.HasPrefix(name, csgStoreTerminalJournalRootPrefix):
            continue
        if !csgStoreTerminalJournalRecoveryNameValid(name):
            err = "merkle_store_terminal_journal_recover_name_invalid"
            return false
        if (afterName.len == 0 || cmp(name, afterName) > 0) &&
           (outName.len == 0 || cmp(name, outName) < 0):
            outName = strings.CloneStr(name)
    err = ""
    return true

fn csgStoreTerminalJournalRootOwnerSkipOpenedSessionInto(
        ownerRow: int32,
        returnState: int32,
        err: var str): bool =
    if ownerRow < 0 ||
       ownerRow >= csgStoreTerminalJournalRootOwnerRowCount ||
       !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[ownerRow],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerClosing):
        err = "merkle_store_terminal_journal_recover_skip_state_invalid"
        return false
    let tree = csgStoreTerminalJournalRootOwnerTrees[ownerRow]
    let liveLockOwner =
        csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[ownerRow]
    if tree == uint64(0) || liveLockOwner <= 0:
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[ownerRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_recover_skip_join_invalid"
        return false
    let closed = os.AtomicTreeClose(tree)
    if result.IsErr(closed) ||
       !os.AtomicTreeTerminalSessionLiveLockOwnerRelease(liveLockOwner):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[ownerRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = result.IsErr(closed) ? strings.CloneStr(result.Error(closed)) :
            "merkle_store_terminal_journal_live_lock_release_failed"
        return false
    csgStoreTerminalJournalRootOwnerTrees[ownerRow] = uint64(0)
    csgStoreTerminalJournalRootOwnerSessionCids[ownerRow] = ""
    csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[ownerRow] = -1
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[ownerRow], returnState)
    err = ""
    return true

# A provider-finalized session can be skipped before a session-live owner is
# minted.  The exact phase-chain verifier has already proved the immutable
# record bytes and the decision mirror.  This close path therefore requires
# that no live-lock owner was ever published for the row.
fn csgStoreTerminalJournalRootOwnerSkipCompletedWithoutLiveInto(
        ownerRow: int32,
        err: var str): bool =
    if ownerRow < 0 ||
       ownerRow >= csgStoreTerminalJournalRootOwnerRowCount ||
       !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[ownerRow],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerClosing):
        err = "merkle_store_terminal_journal_complete_skip_state_invalid"
        return false
    let tree = csgStoreTerminalJournalRootOwnerTrees[ownerRow]
    if tree == uint64(0) ||
       csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[ownerRow] != -1:
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[ownerRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_complete_skip_join_invalid"
        return false
    let closed = os.AtomicTreeClose(tree)
    if result.IsErr(closed):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[ownerRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(closed))
        return false
    csgStoreTerminalJournalRootOwnerTrees[ownerRow] = uint64(0)
    csgStoreTerminalJournalRootOwnerSessionCids[ownerRow] = ""
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[ownerRow],
        csgStoreTerminalJournalRootOwnerReading)
    err = ""
    return true

# Probe only for the immutable terminal candidate.  A nonexact mirror is not
# corruption yet: a live guardian may be between provider-finalized append
# and mirror completion.  Such rows continue to the session-live lock probe;
# only a lock holder may classify a nonexact candidate as crashed/corrupt.
fn csgStoreTerminalJournalRecoveredCompleteCandidateInto(
        tree: os.AtomicTree,
        outCandidate: var bool,
        err: var str): bool =
    outCandidate = false
    let phase4Exists = os.AtomicTreeVerifiedRootChildExists(
        tree,
        csgStoreTerminalJournalEventsDirectory,
        csgStoreTerminalJournalProviderFinalizedName)
    if result.IsErr(phase4Exists):
        err = strings.CloneStr(result.Error(phase4Exists))
        return false
    if !result.Value(phase4Exists):
        err = ""
        return true
    let phase3Exists = os.AtomicTreeVerifiedRootChildExists(
        tree,
        csgStoreTerminalJournalEventsDirectory,
        csgStoreTerminalJournalDecisionName)
    if result.IsErr(phase3Exists):
        err = strings.CloneStr(result.Error(phase3Exists))
        return false
    if !result.Value(phase3Exists):
        err = ""
        return true
    let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
        tree,
        csgStoreTerminalJournalEventsDirectory,
        csgStoreTerminalJournalDecisionName)
    if result.IsErr(opened):
        err = ""
        return true
    let child = result.Value(opened)
    var noDirectories: str[]
    let exact = os.AtomicTreeVerifyExact(
        child,
        noDirectories,
        [strings.CloneStr(csgStoreTerminalJournalDecisionFile),
         strings.CloneStr(csgStoreTerminalJournalRecordFile)])
    if result.IsErr(exact):
        let closedInvalid = os.AtomicTreeClose(child)
        if result.IsErr(closedInvalid):
            panic("merkle store: terminal complete candidate invalid close")
        err = ""
        return true
    let decisionRead = os.AtomicTreeReadStable(
        child, csgStoreTerminalJournalDecisionFile)
    let closed = os.AtomicTreeClose(child)
    if result.IsErr(closed):
        panic("merkle store: terminal complete candidate decision close")
    if result.IsErr(decisionRead):
        err = ""
        return true
    var decisionBytes = result.Value(decisionRead)
    let mirrorRead = os.AtomicTreeReadStable(
        tree, csgStoreTerminalJournalDecisionMirrorFile)
    if result.IsErr(mirrorRead):
        rawbytes.BytesFree(decisionBytes)
        err = ""
        return true
    var mirrorBytes = result.Value(mirrorRead)
    if rawbytes.BytesLen(decisionBytes) ==
           csgStoreTerminalJournalDecisionBytes &&
       rawbytes.BytesLen(mirrorBytes) ==
           csgStoreTerminalJournalDecisionBytes &&
       rawbytes.BytesEqual(decisionBytes, mirrorBytes):
        outCandidate = true
    rawbytes.BytesFree(decisionBytes)
    rawbytes.BytesFree(mirrorBytes)
    err = ""
    return true

# Select and open the lexicographically first durable session not yet visited
# by this guardian startup.  The caller supplies only the policy-bound int32
# root owner.  Session identity is recovered from the verified directory and
# the immutable CLAIMED record; no CID/path text enters through the API.
fn csgStoreTerminalJournalRootOwnerRecoverNextInto(
        ownerHandle: int32,
        err: var str): int32 =
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_recover_handle_invalid"
        return -1
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerIssued,
           csgStoreTerminalJournalRootOwnerReading):
        err = "merkle_store_terminal_journal_recover_state_invalid"
        return -1
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_recover_fence_invalid"
        return -1
    let storeRoot = strings.CloneStr(
        csgStoreTerminalJournalRootOwnerStoreRoots[row])
    while true:
        var selectedName: str
        if !csgStoreTerminalJournalRecoverySelectNameInto(
               storeRoot,
               csgStoreTerminalJournalRootOwnerRecoveryLastNames[row],
               selectedName,
               err):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            return -1
        if selectedName.len == 0:
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerIssued)
            err = ""
            return 0
        let parentAuthority =
            csgStoreTerminalJournalRootOwnerParentAuthority(row)
        if parentAuthority == uint64(0):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = "merkle_store_terminal_journal_recover_parent_authority_invalid"
            return -1
        let opened =
            os.AtomicTreeOpenVerifiedSiblingFromExclusiveParentOrAbsent(
                parentAuthority, selectedName)
        if result.IsErr(opened):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = strings.CloneStr(result.Error(opened))
            return -1
        let openedValue = result.Value(opened)
        let tree = openedValue.tree
        if openedValue.kind != os.AtomicTreeExclusiveOpened:
            let closedAbsent = os.AtomicTreeClose(tree)
            if result.IsErr(closedAbsent):
                panic("merkle store: terminal recovery absent root close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = "merkle_store_terminal_journal_recover_root_absent"
            return -1
        let rootExact = os.AtomicTreeVerifyRootExact(
            tree,
            [strings.CloneStr(csgStoreTerminalJournalEventsDirectory)],
            [strings.CloneStr(csgStoreTerminalJournalAdmissionProofFile),
             strings.CloneStr(csgStoreTerminalJournalDecisionMirrorFile),
             strings.CloneStr(csgStoreTerminalJournalFinishedUploadFile),
             strings.CloneStr(csgStoreTerminalJournalRecordFile),
             strings.CloneStr(csgStoreTerminalJournalSessionLiveLockFile)])
        if result.IsErr(rootExact) ||
           !csgStoreTerminalJournalEventsNamesValid(storeRoot, selectedName):
            let closedInvalid = os.AtomicTreeClose(tree)
            if result.IsErr(closedInvalid):
                panic("merkle store: terminal recovery invalid root close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = result.IsErr(rootExact) ?
                strings.CloneStr(result.Error(rootExact)) :
                "merkle_store_terminal_journal_recover_events_invalid"
            return -1
        let claimedRead = os.AtomicTreeReadStable(
            tree, csgStoreTerminalJournalRecordFile)
        if result.IsErr(claimedRead):
            let closedClaimedError = os.AtomicTreeClose(tree)
            if result.IsErr(closedClaimedError):
                panic("merkle store: terminal recovery claimed read close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = strings.CloneStr(result.Error(claimedRead))
            return -1
        var claimedBytes = result.Value(claimedRead)
        var sessionDigest: layout.FixedBytes32
        if rawbytes.BytesLen(claimedBytes) ==
               csgStoreTerminalJournalRecordBytes:
            for byteIndex in 0..<32:
                sessionDigest.data[byteIndex] = uint8(
                    rawbytes.BytesGet(claimedBytes, 16 + byteIndex) & 255)
        let expectedName = strings.ConcatStr(
            csgStoreTerminalJournalRootPrefix,
            layout.FixedBytes32Hex(sessionDigest))
        rawbytes.BytesFree(claimedBytes)
        if expectedName != selectedName:
            let closedIdentityError = os.AtomicTreeClose(tree)
            if result.IsErr(closedIdentityError):
                panic("merkle store: terminal recovery identity close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = "merkle_store_terminal_journal_recover_identity_invalid"
            return -1
        var completeCandidate = false
        if !csgStoreTerminalJournalRecoveredCompleteCandidateInto(
               tree, completeCandidate, err):
            let closedCandidateError = os.AtomicTreeClose(tree)
            if result.IsErr(closedCandidateError):
                panic("merkle store: terminal complete candidate close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            return -1
        if completeCandidate:
            csgStoreTerminalJournalRootOwnerTrees[row] = tree
            csgStoreTerminalJournalRootOwnerSessionCids[row] =
                strings.ConcatStr(
                    "sha256:", layout.FixedBytes32Hex(sessionDigest))
            csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row] = -1
            csgStoreTerminalJournalRootOwnerRecoveryLastNames[row] =
                strings.CloneStr(selectedName)
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerOpen)
            var precheckedComplete = false
            if !productionTerminalJournalRecoveredSessionCompleteStrictInto(
                   row + 1, precheckedComplete, err) ||
               !precheckedComplete:
                atomic.StoreI32(
                    csgStoreTerminalJournalRootOwnerStates[row],
                    csgStoreTerminalJournalRootOwnerRecoveryRequired)
                if err.len == 0:
                    err = "merkle_store_terminal_completed_candidate_drift"
                return -1
            if !csgStoreTerminalJournalRootOwnerSkipCompletedWithoutLiveInto(
                   row, err):
                return -1
            continue
        var liveLockOwner: int32
        var liveBusy: bool
        if !os.AtomicTreeTerminalSessionLiveLockOwnerTryAcquireInto(
               tree, liveLockOwner, liveBusy, err):
            let closedLockError = os.AtomicTreeClose(tree)
            if result.IsErr(closedLockError):
                panic("merkle store: terminal live lock error root close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            return -1
        if liveBusy:
            let closedLive = os.AtomicTreeClose(tree)
            if result.IsErr(closedLive):
                panic("merkle store: terminal live session skip close")
            csgStoreTerminalJournalRootOwnerRecoveryLastNames[row] =
                strings.CloneStr(selectedName)
            continue
        if liveLockOwner <= 0:
            panic("merkle store: terminal live lock acquisition drift")
        csgStoreTerminalJournalRootOwnerTrees[row] = tree
        csgStoreTerminalJournalRootOwnerSessionCids[row] =
            strings.ConcatStr("sha256:", layout.FixedBytes32Hex(sessionDigest))
        csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row] =
            liveLockOwner
        csgStoreTerminalJournalRootOwnerRecoveryLastNames[row] =
            strings.CloneStr(selectedName)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerOpen)
        var completed = false
        if !productionTerminalJournalRecoveredSessionCompleteStrictInto(
               row + 1, completed, err):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            return -1
        if completed:
            if !csgStoreTerminalJournalRootOwnerSkipOpenedSessionInto(
                   row, csgStoreTerminalJournalRootOwnerReading, err):
                return -1
            continue
        err = ""
        return 1

# Close only the currently recovered session tree and return the same
# policy/fence-bound activation owner to Issued so RecoverNext can advance its
# private int32 cursor.  The live HEAD lease remains owned until CloseInto.
fn csgStoreTerminalJournalRootOwnerReleaseRecoveredSessionInto(
        ownerHandle: int32,
        err: var str): bool =
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_recover_release_invalid"
        return false
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerClosing):
        err = "merkle_store_terminal_journal_recover_release_state_invalid"
        return false
    let tree = csgStoreTerminalJournalRootOwnerTrees[row]
    let liveLockOwner =
        csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row]
    if tree == uint64(0) || liveLockOwner <= 0:
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_recover_release_tree_invalid"
        return false
    let closed = os.AtomicTreeClose(tree)
    if result.IsErr(closed):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(closed))
        return false
    if !os.AtomicTreeTerminalSessionLiveLockOwnerRelease(liveLockOwner):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_recover_live_lock_release_failed"
        return false
    csgStoreTerminalJournalRootOwnerTrees[row] = uint64(0)
    csgStoreTerminalJournalRootOwnerSessionCids[row] = ""
    csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row] = -1
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerIssued)
    err = ""
    return true

@borrows
fn csgStoreTerminalJournalPhaseName(phase: int32): str =
    if phase == 2:
        return strings.CloneStr(csgStoreTerminalJournalFinishedName)
    if phase == 3:
        return strings.CloneStr(csgStoreTerminalJournalDecisionName)
    if phase == 4:
        return strings.CloneStr(
            csgStoreTerminalJournalProviderFinalizedName)
    if phase == 5:
        return strings.CloneStr(csgStoreTerminalJournalExitObservedName)
    if phase == 6:
        return strings.CloneStr(csgStoreTerminalJournalReapedName)
    return ""

# Return 1 for an exact durable record, 0 for an absent suffix phase, and -1
# for corruption/fence loss.  The managed bytes are a ZRPC payload, not an
# identity; the root/session authority remains the opaque int32 owner row.
fn csgStoreTerminalJournalRootOwnerReadRecordInto(
        ownerHandle: int32,
        phase: int32,
        outRecordCanonical: var str,
        err: var str): int32 =
    outRecordCanonical = ""
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount ||
       phase < 1 || phase > 6:
        err = "merkle_store_terminal_journal_read_handle_invalid"
        return -1
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerReading):
        err = "merkle_store_terminal_journal_read_state_invalid"
        return -1
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_read_fence_invalid"
        return -1
    let root = csgStoreTerminalJournalRootOwnerTrees[row]
    var readResult: result.Result[rawbytes.Bytes]
    var child: os.AtomicTree
    if phase == 1:
        readResult = os.AtomicTreeReadStable(
            root, csgStoreTerminalJournalRecordFile)
    else:
        let phaseName = csgStoreTerminalJournalPhaseName(phase)
        let exists = os.AtomicTreeVerifiedRootChildExists(
            root,
            csgStoreTerminalJournalEventsDirectory,
            phaseName)
        if result.IsErr(exists):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = strings.CloneStr(result.Error(exists))
            return -1
        if !result.Value(exists):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerOpen)
            err = ""
            return 0
        let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
            root,
            csgStoreTerminalJournalEventsDirectory,
            phaseName)
        if result.IsErr(opened):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = strings.CloneStr(result.Error(opened))
            return -1
        child = result.Value(opened)
        var noDirectories: str[]
        var exactShape = true
        if phase == 3:
            let exact = os.AtomicTreeVerifyExact(
                child,
                noDirectories,
                [strings.CloneStr(csgStoreTerminalJournalDecisionFile),
                 strings.CloneStr(csgStoreTerminalJournalRecordFile)])
            exactShape = result.IsOk(exact)
        else:
            let exact = os.AtomicTreeVerifyExact(
                child,
                noDirectories,
                [strings.CloneStr(csgStoreTerminalJournalRecordFile)])
            exactShape = result.IsOk(exact)
        if !exactShape:
            let closedInvalid = os.AtomicTreeClose(child)
            if result.IsErr(closedInvalid):
                panic("merkle store: terminal recovery child close")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = "merkle_store_terminal_journal_recover_child_invalid"
            return -1
        readResult = os.AtomicTreeReadStable(
            child, csgStoreTerminalJournalRecordFile)
    if child != uint64(0):
        let closedChild = os.AtomicTreeClose(child)
        if result.IsErr(closedChild):
            panic("merkle store: terminal recovery child read close")
    if result.IsErr(readResult):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(readResult))
        return -1
    var recordBytes = result.Value(readResult)
    if rawbytes.BytesLen(recordBytes) !=
           csgStoreTerminalJournalRecordBytes:
        rawbytes.BytesFree(recordBytes)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_recover_record_size_invalid"
        return -1
    outRecordCanonical = rawbytes.BytesToString(recordBytes)
    rawbytes.BytesFree(recordBytes)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerOpen)
    err = ""
    return 1

# Read only the exact decision ZRPC payload from a verified phase-3 child.
# The caller receives managed bytes; root/session authority never leaves the
# opaque owner row.
fn csgStoreTerminalJournalRootOwnerReadDecisionInto(
        ownerHandle: int32,
        outDecisionCanonical: var str,
        err: var str): int32 =
    outDecisionCanonical = ""
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_decision_read_handle_invalid"
        return -1
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerReading):
        err = "merkle_store_terminal_journal_decision_read_state_invalid"
        return -1
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_decision_read_fence_invalid"
        return -1
    let root = csgStoreTerminalJournalRootOwnerTrees[row]
    let exists = os.AtomicTreeVerifiedRootChildExists(
        root,
        csgStoreTerminalJournalEventsDirectory,
        csgStoreTerminalJournalDecisionName)
    if result.IsErr(exists):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(exists))
        return -1
    if !result.Value(exists):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerOpen)
        err = ""
        return 0
    let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
        root,
        csgStoreTerminalJournalEventsDirectory,
        csgStoreTerminalJournalDecisionName)
    if result.IsErr(opened):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(opened))
        return -1
    let child = result.Value(opened)
    var noDirectories: str[]
    let exact = os.AtomicTreeVerifyExact(
        child,
        noDirectories,
        [strings.CloneStr(csgStoreTerminalJournalDecisionFile),
         strings.CloneStr(csgStoreTerminalJournalRecordFile)])
    if result.IsErr(exact):
        let closedInvalid = os.AtomicTreeClose(child)
        if result.IsErr(closedInvalid):
            panic("merkle store: terminal decision invalid close")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_decision_shape_invalid"
        return -1
    let read = os.AtomicTreeReadStable(
        child, csgStoreTerminalJournalDecisionFile)
    let closed = os.AtomicTreeClose(child)
    if result.IsErr(closed):
        panic("merkle store: terminal decision read close failed")
    if result.IsErr(read):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(read))
        return -1
    var bytes = result.Value(read)
    if rawbytes.BytesLen(bytes) != csgStoreTerminalJournalDecisionBytes:
        rawbytes.BytesFree(bytes)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_decision_size_invalid"
        return -1
    outDecisionCanonical = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerOpen)
    err = ""
    return 1

fn csgStoreTerminalJournalRootOwnerReadDecisionMirrorInto(
        ownerHandle: int32,
        outDecisionCanonical: var str,
        err: var str): bool =
    outDecisionCanonical = ""
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_mirror_read_handle_invalid"
        return false
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerReading):
        err = "merkle_store_terminal_journal_mirror_read_state_invalid"
        return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_mirror_read_fence_invalid"
        return false
    let read = os.AtomicTreeReadStable(
        csgStoreTerminalJournalRootOwnerTrees[row],
        csgStoreTerminalJournalDecisionMirrorFile)
    if result.IsErr(read):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(read))
        return false
    var bytes = result.Value(read)
    if rawbytes.BytesLen(bytes) != csgStoreTerminalJournalDecisionBytes:
        rawbytes.BytesFree(bytes)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_mirror_size_invalid"
        return false
    outDecisionCanonical = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerOpen)
    err = ""
    return true

# Export the exact provider admission ZRPC payload from the currently opened
# verified session root. The bytes are not identity; the policy/fence-bound
# root-owner int32 remains the only authority used by recovery.
fn csgStoreTerminalJournalRootOwnerReadAdmissionProofInto(
        ownerHandle: int32,
        outAdmissionCanonical: var str,
        err: var str): int32 =
    outAdmissionCanonical = ""
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_admission_read_handle_invalid"
        return -1
    let row = ownerHandle - 1
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerReading):
        err = "merkle_store_terminal_journal_admission_read_state_invalid"
        return -1
    if !csgStoreTerminalJournalRootOwnerFenceHeld(row):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_admission_read_fence_invalid"
        return -1
    let root = csgStoreTerminalJournalRootOwnerTrees[row]
    let read = os.AtomicTreeReadStable(
        root, csgStoreTerminalJournalAdmissionProofFile)
    if result.IsErr(read):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(read))
        return -1
    var bytes = result.Value(read)
    let byteCount = rawbytes.BytesLen(bytes)
    if byteCount < csgStoreTerminalJournalAdmissionProofMinBytes ||
       byteCount > csgStoreTerminalJournalAdmissionProofMaxBytes:
        rawbytes.BytesFree(bytes)
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_journal_admission_size_invalid"
        return -1
    outAdmissionCanonical = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerOpen)
    err = ""
    return 1

fn CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
        ownerHandle: int32,
        err: var str): bool =
    if ownerHandle <= 0 ||
       ownerHandle > csgStoreTerminalJournalRootOwnerRowCount:
        err = "merkle_store_terminal_journal_close_handle_invalid"
        return false
    let row = ownerHandle - 1
    if csgStoreTerminalJournalRootOwnerRegistryInit != 2 ||
       csgStoreTerminalJournalRootOwnerNextRow == nil ||
       row >= atomic.LoadI32(
           csgStoreTerminalJournalRootOwnerNextRow):
        err = "merkle_store_terminal_journal_close_state_invalid"
        return false
    var prior: int32 = csgStoreTerminalJournalRootOwnerIssued
    if !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[row],
           csgStoreTerminalJournalRootOwnerIssued,
           csgStoreTerminalJournalRootOwnerClosing):
        prior = csgStoreTerminalJournalRootOwnerOpen
        if !atomic.CasI32(
               csgStoreTerminalJournalRootOwnerStates[row],
               csgStoreTerminalJournalRootOwnerOpen,
               csgStoreTerminalJournalRootOwnerClosing):
            prior = csgStoreTerminalJournalRootOwnerRecoveryRequired
            if !atomic.CasI32(
                   csgStoreTerminalJournalRootOwnerStates[row],
                   csgStoreTerminalJournalRootOwnerRecoveryRequired,
                   csgStoreTerminalJournalRootOwnerClosing):
                err = "merkle_store_terminal_journal_close_state_invalid"
                return false
    let tree = csgStoreTerminalJournalRootOwnerTrees[row]
    let leaseId = csgStoreTerminalJournalRootOwnerLeaseIds[row]
    let leaseEpoch = csgStoreTerminalJournalRootOwnerLeaseEpochs[row]
    if tree != uint64(0):
        let closed = os.AtomicTreeClose(tree)
        if result.IsErr(closed):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[row],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = strings.CloneStr(result.Error(closed))
            return false
    let sessionLiveLockOwner =
        csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row]
    if sessionLiveLockOwner > 0 &&
       !os.AtomicTreeTerminalSessionLiveLockOwnerRelease(
           sessionLiveLockOwner):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_session_live_lock_close_failed"
        return false
    csgStoreTerminalJournalRootOwnerSessionLiveLockOwners[row] = -1
    let recoveryLockOwner =
        csgStoreTerminalJournalRootOwnerRecoveryLockOwners[row]
    let recoveryRegistryOwner =
        csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners[row]
    if (recoveryLockOwner > 0) != (recoveryRegistryOwner > 0):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_recovery_registry_join_invalid"
        return false
    if recoveryLockOwner > 0 &&
       !csgStoreTerminalRecoveryRegistryReleaseInto(
           recoveryRegistryOwner, recoveryLockOwner, err):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[row],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        return false
    csgStoreTerminalJournalRootOwnerRecoveryLockOwners[row] = -1
    csgStoreTerminalJournalRootOwnerRecoveryRegistryOwners[row] = -1
    if !CsgCoreMerkleStoreCurrentHeadLeaseReleaseById(
           leaseId, leaseEpoch):
        panic("merkle store: terminal journal lease release failed")
    csgStoreTerminalJournalRootOwnerTrees[row] = uint64(0)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[row],
        csgStoreTerminalJournalRootOwnerClosed)
    err = ""
    return true

# Terminal capsule authority is colocated with the live HEAD/root owner. Raw
# descriptors never cross a module boundary: callers carry only append-only
# int32 owner rows, while this module joins them to the exact fenced store row.
const
    ProductionHeldExecTerminalCapsuleRowCount: int32 = 4096
    ProductionHeldExecTerminalCapsuleStateBuilding: int32 = 1
    ProductionHeldExecTerminalCapsuleStateIssued: int32 = 2
    ProductionHeldExecTerminalCapsuleStateActivating: int32 = 3
    ProductionHeldExecTerminalCapsuleStateActive: int32 = 4
    ProductionHeldExecTerminalCapsuleStateAborting: int32 = 5
    ProductionHeldExecTerminalCapsuleStateAborted: int32 = 6
    ProductionHeldExecTerminalCapsuleStateRecoveryRequired: int32 = 7
    ProductionHeldExecTerminalCapsuleStateFinishing: int32 = 8
    ProductionHeldExecTerminalCapsuleStateFinished: int32 = 9
    ProductionHeldExecTerminalCapsuleStateRetiring: int32 = 10
    ProductionHeldExecTerminalCapsuleStateRetired: int32 = 11
    ProductionHeldExecTerminalCapsuleDecisionBytes: int32 = 768
    ProductionHeldExecTerminalCapsuleHardRed: str =
        "HARD_RED:production_terminal_capsule_activate_failed"

var
    productionHeldExecTerminalCapsuleRegistryState: int32
    productionHeldExecTerminalCapsuleNextRow: atomic.I32
    productionHeldExecTerminalCapsuleStates: atomic.I32[]
    productionHeldExecTerminalCapsuleRootOwners: int32[]
    productionHeldExecTerminalCapsuleRuntimeSessions: int32[]
    productionHeldExecTerminalCapsuleProviderRoleOwners: int32[]
    productionHeldExecTerminalCapsuleExitPermission0: int32[]
    productionHeldExecTerminalCapsuleExitPermission1: int32[]
    productionHeldExecTerminalCapsuleExitPermission2: int32[]
    productionHeldExecTerminalCapsuleExitPermission3: int32[]
    productionHeldExecTerminalCapsuleReapPermission0: int32[]
    productionHeldExecTerminalCapsuleReapPermission1: int32[]
    productionHeldExecTerminalCapsuleReapPermission2: int32[]
    productionHeldExecTerminalCapsuleReapPermission3: int32[]
    productionHeldExecTerminalCapsuleHeldBundleCids: str[]
    productionHeldExecTerminalCapsuleOwnerClaimReceiptCids: str[]

fn ProductionHeldExecTerminalCapsuleInitializeBeforeFork(): bool =
    csgStoreHeadLeaseEnsureRegistry()
    var builder = false
    while !builder:
        os.CsgCurrentHeadLeaseRegistryLock()
        let state = system.RuntimeAtomicLoadI32(
            productionHeldExecTerminalCapsuleRegistryState)
        if state == 2:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return true
        if state == 3:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
        if state == 0:
            builder = system.RuntimeAtomicCompareExchangeI32(
                productionHeldExecTerminalCapsuleRegistryState, 0, 1)
            os.CsgCurrentHeadLeaseRegistryUnlock()
        elif state == 1:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("production terminal capsule registry state invalid")
    setLen(
        productionHeldExecTerminalCapsuleStates,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(
        productionHeldExecTerminalCapsuleRootOwners,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(
        productionHeldExecTerminalCapsuleRuntimeSessions,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(
        productionHeldExecTerminalCapsuleProviderRoleOwners,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleExitPermission0,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleExitPermission1,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleExitPermission2,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleExitPermission3,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleReapPermission0,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleReapPermission1,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleReapPermission2,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(productionHeldExecTerminalCapsuleReapPermission3,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(
        productionHeldExecTerminalCapsuleHeldBundleCids,
        ProductionHeldExecTerminalCapsuleRowCount)
    setLen(
        productionHeldExecTerminalCapsuleOwnerClaimReceiptCids,
        ProductionHeldExecTerminalCapsuleRowCount)
    for row in 0..<ProductionHeldExecTerminalCapsuleRowCount:
        productionHeldExecTerminalCapsuleStates[row] = atomic.NewI32(0)
        productionHeldExecTerminalCapsuleRootOwners[row] = -1
        productionHeldExecTerminalCapsuleRuntimeSessions[row] = -1
        productionHeldExecTerminalCapsuleProviderRoleOwners[row] = -1
        productionHeldExecTerminalCapsuleExitPermission0[row] = 0
        productionHeldExecTerminalCapsuleExitPermission1[row] = 0
        productionHeldExecTerminalCapsuleExitPermission2[row] = 0
        productionHeldExecTerminalCapsuleExitPermission3[row] = 0
        productionHeldExecTerminalCapsuleReapPermission0[row] = 0
        productionHeldExecTerminalCapsuleReapPermission1[row] = 0
        productionHeldExecTerminalCapsuleReapPermission2[row] = 0
        productionHeldExecTerminalCapsuleReapPermission3[row] = 0
        productionHeldExecTerminalCapsuleHeldBundleCids[row] = ""
        productionHeldExecTerminalCapsuleOwnerClaimReceiptCids[row] = ""
        if productionHeldExecTerminalCapsuleStates[row] == nil:
            os.CsgCurrentHeadLeaseRegistryLock()
            system.RuntimeAtomicStoreI32(
                productionHeldExecTerminalCapsuleRegistryState, 3)
            os.CsgCurrentHeadLeaseRegistryNotifyAll()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    productionHeldExecTerminalCapsuleNextRow = atomic.NewI32(0)
    if productionHeldExecTerminalCapsuleNextRow == nil:
        os.CsgCurrentHeadLeaseRegistryLock()
        system.RuntimeAtomicStoreI32(
            productionHeldExecTerminalCapsuleRegistryState, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        return false
    os.CsgCurrentHeadLeaseRegistryLock()
    if system.RuntimeAtomicLoadI32(
           productionHeldExecTerminalCapsuleRegistryState) != 1:
        system.RuntimeAtomicStoreI32(
            productionHeldExecTerminalCapsuleRegistryState, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("production terminal capsule registry publication drift")
    system.RuntimeAtomicStoreI32(
        productionHeldExecTerminalCapsuleRegistryState, 2)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return true

fn productionHeldExecTerminalCapsuleCloseAll(row: int32) =
    let providerRoleOwner =
        productionHeldExecTerminalCapsuleProviderRoleOwners[row]
    if providerRoleOwner > 0 &&
       !system.RuntimeHeldExecTerminalCapsuleRoleOwnerAbort(
           providerRoleOwner):
        panic("production terminal capsule provider role abort failed")
    productionHeldExecTerminalCapsuleProviderRoleOwners[row] = -1
    productionHeldExecTerminalCapsuleExitPermission0[row] = 0
    productionHeldExecTerminalCapsuleExitPermission1[row] = 0
    productionHeldExecTerminalCapsuleExitPermission2[row] = 0
    productionHeldExecTerminalCapsuleExitPermission3[row] = 0
    productionHeldExecTerminalCapsuleReapPermission0[row] = 0
    productionHeldExecTerminalCapsuleReapPermission1[row] = 0
    productionHeldExecTerminalCapsuleReapPermission2[row] = 0
    productionHeldExecTerminalCapsuleReapPermission3[row] = 0

# The root-owner provider opens two different open-file descriptions for each
# fixed inode and proves their dev/ino equality. The child gets only the
# FINISHED O_WRONLY side and DECISION O_RDONLY side; their opposite sides stay
# in this guardian-owned SoA. The bundle is already an opaque provider owner;
# it is joined and moved into the same provider role row only after both inode
# pairs exist.
fn ProductionHeldExecTerminalCapsuleIssueInto(
        rootOwner: int32,
        bundleOwner: var int32,
        runtimeSession: int32,
        outCapsuleOwner: var int32,
        err: var str): bool =
    outCapsuleOwner = -1
    if productionHeldExecTerminalCapsuleRegistryState != 2 ||
       rootOwner <= 0 || bundleOwner <= 0 || runtimeSession <= 0:
        err = "production_terminal_capsule_owner_invalid"
        return false
    let row = atomic.FetchAddI32(
        productionHeldExecTerminalCapsuleNextRow, 1)
    if row < 0 || row >= ProductionHeldExecTerminalCapsuleRowCount:
        err = "production_terminal_capsule_owner_arena_exhausted"
        return false
    atomic.StoreI32(
        productionHeldExecTerminalCapsuleStates[row],
        ProductionHeldExecTerminalCapsuleStateBuilding)
    var admissionCanonical: str
    var admission: admission_codec.ProductionHeldExecAdmissionProof
    if csgStoreTerminalJournalRootOwnerReadAdmissionProofInto(
           rootOwner, admissionCanonical, err) != 1 ||
       !admission_codec.ProductionHeldExecAdmissionProofDecodeStrictInto(
           admissionCanonical, admission):
        atomic.StoreI32(
            productionHeldExecTerminalCapsuleStates[row],
            ProductionHeldExecTerminalCapsuleStateRecoveryRequired)
        if err.len == 0:
            err = "production_terminal_capsule_admission_proof_invalid"
        return false
    var providerRoleOwner: int32
    var exitPermission0: int32
    var exitPermission1: int32
    var exitPermission2: int32
    var exitPermission3: int32
    var reapPermission0: int32
    var reapPermission1: int32
    var reapPermission2: int32
    var reapPermission3: int32
    if !csgStoreTerminalJournalRootOwnerIssueCapsuleRoleOwnerInto(
           rootOwner,
           providerRoleOwner,
           exitPermission0,
           exitPermission1,
           exitPermission2,
           exitPermission3,
           reapPermission0,
           reapPermission1,
           reapPermission2,
           reapPermission3,
           err):
        atomic.StoreI32(
            productionHeldExecTerminalCapsuleStates[row],
            ProductionHeldExecTerminalCapsuleStateRecoveryRequired)
        return false
    if !system.runtimeHeldExecTerminalCapsuleRoleBindBundleOwner(
           providerRoleOwner,
           bundleOwner):
        if !system.RuntimeHeldExecTerminalCapsuleRoleOwnerAbort(
               providerRoleOwner):
            panic("production terminal capsule provider bind abort failed")
        atomic.StoreI32(
            productionHeldExecTerminalCapsuleStates[row],
            ProductionHeldExecTerminalCapsuleStateRecoveryRequired)
        err = "production_terminal_capsule_bundle_owner_bind_failed"
        return false
    productionHeldExecTerminalCapsuleRootOwners[row] = rootOwner
    productionHeldExecTerminalCapsuleRuntimeSessions[row] = runtimeSession
    productionHeldExecTerminalCapsuleProviderRoleOwners[row] =
        providerRoleOwner
    productionHeldExecTerminalCapsuleExitPermission0[row] = exitPermission0
    productionHeldExecTerminalCapsuleExitPermission1[row] = exitPermission1
    productionHeldExecTerminalCapsuleExitPermission2[row] = exitPermission2
    productionHeldExecTerminalCapsuleExitPermission3[row] = exitPermission3
    productionHeldExecTerminalCapsuleReapPermission0[row] = reapPermission0
    productionHeldExecTerminalCapsuleReapPermission1[row] = reapPermission1
    productionHeldExecTerminalCapsuleReapPermission2[row] = reapPermission2
    productionHeldExecTerminalCapsuleReapPermission3[row] = reapPermission3
    exitPermission0 = 0
    exitPermission1 = 0
    exitPermission2 = 0
    exitPermission3 = 0
    reapPermission0 = 0
    reapPermission1 = 0
    reapPermission2 = 0
    reapPermission3 = 0
    productionHeldExecTerminalCapsuleHeldBundleCids[row] =
        strings.CloneStr(admission.heldBundleCid)
    productionHeldExecTerminalCapsuleOwnerClaimReceiptCids[row] =
        strings.CloneStr(admission.ownerClaimReceiptCid)
    atomic.StoreI32(
        productionHeldExecTerminalCapsuleStates[row],
        ProductionHeldExecTerminalCapsuleStateIssued)
    outCapsuleOwner = row + 1
    err = ""
    return true

fn ProductionHeldExecTerminalCapsuleAbortInto(
        capsuleOwner: var int32,
        err: var str): bool =
    let row = capsuleOwner - 1
    if productionHeldExecTerminalCapsuleRegistryState != 2 || row < 0 ||
       row >= ProductionHeldExecTerminalCapsuleRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalCapsuleNextRow):
        err = "production_terminal_capsule_owner_invalid"
        return false
    let state = atomic.LoadI32(
        productionHeldExecTerminalCapsuleStates[row])
    if (state != ProductionHeldExecTerminalCapsuleStateIssued &&
        state != ProductionHeldExecTerminalCapsuleStateActive &&
        state != ProductionHeldExecTerminalCapsuleStateFinished &&
        state != ProductionHeldExecTerminalCapsuleStateRecoveryRequired) ||
       !atomic.CasI32(
           productionHeldExecTerminalCapsuleStates[row],
           state,
           ProductionHeldExecTerminalCapsuleStateAborting):
        err = "production_terminal_capsule_owner_invalid"
        return false
    capsuleOwner = -1
    productionHeldExecTerminalCapsuleCloseAll(row)
    atomic.StoreI32(
        productionHeldExecTerminalCapsuleStates[row],
        ProductionHeldExecTerminalCapsuleStateAborted)
    err = ""
    return true

@borrows
fn productionHeldExecTerminalCapsuleFinishInto(
        capsuleOwner: int32,
        runtimeSession: int32,
        outputPath: str,
        outFinishedProofOwner: var int32,
        outExitPermission0: var int32,
        outExitPermission1: var int32,
        outExitPermission2: var int32,
        outExitPermission3: var int32,
        outReapPermission0: var int32,
        outReapPermission1: var int32,
        outReapPermission2: var int32,
        outReapPermission3: var int32,
        err: var str): bool =
    outFinishedProofOwner = -1
    outExitPermission0 = 0
    outExitPermission1 = 0
    outExitPermission2 = 0
    outExitPermission3 = 0
    outReapPermission0 = 0
    outReapPermission1 = 0
    outReapPermission2 = 0
    outReapPermission3 = 0
    let row = capsuleOwner - 1
    if productionHeldExecTerminalCapsuleRegistryState != 2 || row < 0 ||
       row >= ProductionHeldExecTerminalCapsuleRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalCapsuleNextRow) ||
       runtimeSession <= 0 ||
       productionHeldExecTerminalCapsuleRuntimeSessions[row] !=
           runtimeSession ||
       !atomic.CasI32(
           productionHeldExecTerminalCapsuleStates[row],
           ProductionHeldExecTerminalCapsuleStateActive,
           ProductionHeldExecTerminalCapsuleStateFinishing):
        err = "production_terminal_capsule_finish_owner_invalid"
        return false
    let providerRoleOwner =
        productionHeldExecTerminalCapsuleProviderRoleOwners[row]
    let finishedProofOwner =
        system.RuntimeHeldExecParentFinishCapsuleOwner(
            runtimeSession, providerRoleOwner, outputPath)
    var compileReceiptCanonical: str
    var compileReceipt: compile_receipt_codec.CompileReceipt
    if finishedProofOwner != providerRoleOwner || finishedProofOwner <= 0 ||
       !system.RuntimeHeldExecFinishedCompileReceiptExportCanonicalInto(
           finishedProofOwner, compileReceiptCanonical) ||
       !compile_receipt_codec.CompileReceiptCodecDecodeStrictInto(
           compileReceiptCanonical, compileReceipt, err) ||
       (productionHeldExecTerminalCapsuleExitPermission0[row] == 0 &&
        productionHeldExecTerminalCapsuleExitPermission1[row] == 0 &&
        productionHeldExecTerminalCapsuleExitPermission2[row] == 0 &&
        productionHeldExecTerminalCapsuleExitPermission3[row] == 0) ||
       (productionHeldExecTerminalCapsuleReapPermission0[row] == 0 &&
        productionHeldExecTerminalCapsuleReapPermission1[row] == 0 &&
        productionHeldExecTerminalCapsuleReapPermission2[row] == 0 &&
        productionHeldExecTerminalCapsuleReapPermission3[row] == 0) ||
       (productionHeldExecTerminalCapsuleExitPermission0[row] ==
            productionHeldExecTerminalCapsuleReapPermission0[row] &&
        productionHeldExecTerminalCapsuleExitPermission1[row] ==
            productionHeldExecTerminalCapsuleReapPermission1[row] &&
        productionHeldExecTerminalCapsuleExitPermission2[row] ==
            productionHeldExecTerminalCapsuleReapPermission2[row] &&
        productionHeldExecTerminalCapsuleExitPermission3[row] ==
            productionHeldExecTerminalCapsuleReapPermission3[row]):
        atomic.StoreI32(
            productionHeldExecTerminalCapsuleStates[row],
            ProductionHeldExecTerminalCapsuleStateRecoveryRequired)
        if err.len == 0:
            err = "production_terminal_capsule_finished_readback_invalid"
        return false
    productionHeldExecTerminalCapsuleProviderRoleOwners[row] = -1
    outExitPermission0 =
        productionHeldExecTerminalCapsuleExitPermission0[row]
    outExitPermission1 =
        productionHeldExecTerminalCapsuleExitPermission1[row]
    outExitPermission2 =
        productionHeldExecTerminalCapsuleExitPermission2[row]
    outExitPermission3 =
        productionHeldExecTerminalCapsuleExitPermission3[row]
    outReapPermission0 =
        productionHeldExecTerminalCapsuleReapPermission0[row]
    outReapPermission1 =
        productionHeldExecTerminalCapsuleReapPermission1[row]
    outReapPermission2 =
        productionHeldExecTerminalCapsuleReapPermission2[row]
    outReapPermission3 =
        productionHeldExecTerminalCapsuleReapPermission3[row]
    productionHeldExecTerminalCapsuleExitPermission0[row] = 0
    productionHeldExecTerminalCapsuleExitPermission1[row] = 0
    productionHeldExecTerminalCapsuleExitPermission2[row] = 0
    productionHeldExecTerminalCapsuleExitPermission3[row] = 0
    productionHeldExecTerminalCapsuleReapPermission0[row] = 0
    productionHeldExecTerminalCapsuleReapPermission1[row] = 0
    productionHeldExecTerminalCapsuleReapPermission2[row] = 0
    productionHeldExecTerminalCapsuleReapPermission3[row] = 0
    atomic.StoreI32(
        productionHeldExecTerminalCapsuleStates[row],
        ProductionHeldExecTerminalCapsuleStateFinished)
    outFinishedProofOwner = finishedProofOwner
    err = ""
    return true

# After exec the backend imports the three SCM_RIGHTS roles and publishes a
# child-local append-only owner. No descriptor number crosses this Cheng
# boundary; later FINISHED/DECISION operations consume only this int32 row.
fn ProductionHeldExecTerminalCapsuleChildImportInto(
        outChildOwner: var int32,
        err: var str): bool =
    outChildOwner = -1
    if !ProductionHeldExecTerminalCapsuleInitializeBeforeFork():
        err = "production_terminal_capsule_child_registry_invalid"
        return false
    let localOwner = system.RuntimeHeldExecChildCapsuleRoleOwner()
    if localOwner <= 0:
        err = "production_terminal_capsule_child_roles_missing"
        return false
    outChildOwner = localOwner
    err = ""
    return true

fn ProductionHeldExecTerminalCapsuleActivateInto(
        capsuleOwner: int32,
        runtimeSession: int32,
        err: var str): bool =
    let row = capsuleOwner - 1
    if productionHeldExecTerminalCapsuleRegistryState != 2 || row < 0 ||
       row >= ProductionHeldExecTerminalCapsuleRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalCapsuleNextRow) ||
       runtimeSession <= 0 ||
       productionHeldExecTerminalCapsuleRuntimeSessions[row] !=
           runtimeSession ||
       !atomic.CasI32(
           productionHeldExecTerminalCapsuleStates[row],
           ProductionHeldExecTerminalCapsuleStateIssued,
           ProductionHeldExecTerminalCapsuleStateActivating):
        err = "production_terminal_capsule_owner_invalid"
        return false
    let providerRoleOwner =
        productionHeldExecTerminalCapsuleProviderRoleOwners[row]
    let activated = system.RuntimeHeldExecParentActivateCapsuleOwner(
        runtimeSession,
        productionHeldExecTerminalCapsuleOwnerClaimReceiptCids[row],
        providerRoleOwner)
    if activated.status != 1 || activated.session != runtimeSession:
        atomic.StoreI32(
            productionHeldExecTerminalCapsuleStates[row],
            ProductionHeldExecTerminalCapsuleStateRecoveryRequired)
        err = strings.CloneStr(ProductionHeldExecTerminalCapsuleHardRed)
        return false
    atomic.StoreI32(
        productionHeldExecTerminalCapsuleStates[row],
        ProductionHeldExecTerminalCapsuleStateActive)
    err = ""
    return true

# Durable terminal continuation. Admitted ISSUE and the unique consume CAS live
# only in production_held_exec_provider; this arena begins from the immutable
# claimed value-definition and moved int32 root/bundle owners returned by that
# provider. It cannot mint or reconstruct an admitted capability.

const
    ProductionAdmittedClaimSlotCount: int32 = 4
    ProductionAdmittedClaimHandleRowCount: int32 = 16384
    ProductionAdmittedClaimStateEmpty: int32 = 0
    ProductionAdmittedClaimStateBuilding: int32 = 1
    ProductionAdmittedClaimStateIssued: int32 = 2
    ProductionAdmittedClaimStateClaimed: int32 = 3
    ProductionAdmittedClaimStateFinished: int32 = 4
    ProductionAdmittedClaimStateCommitted: int32 = 5
    ProductionAdmittedClaimStateAborted: int32 = 6
    ProductionAdmittedClaimStateFinalizing: int32 = 7
    ProductionAdmittedClaimStateRecoveryRequired: int32 = 8
    ProductionAdmittedClaimOwnerPrepared: int32 = 1
    ProductionAdmittedClaimOwnerIssued: int32 = 2
    ProductionAdmittedClaimOwnerAborted: int32 = 3
    ProductionAdmittedClaimOwnerMovingRoot: int32 = 4
    ProductionAdmittedClaimOwnerRootMoved: int32 = 5
    ProductionAdmittedClaimOwnerActivating: int32 = 6
    ProductionAdmittedClaimOwnerActivated: int32 = 7
    ProductionAdmittedClaimOwnerRecoveryRequired: int32 = 8
    ProductionAdmittedClaimOwnerFinishing: int32 = 9
    ProductionAdmittedClaimOwnerFinished: int32 = 10
    ProductionAdmittedClaimOwnerFinalizing: int32 = 11
    ProductionAdmittedClaimOwnerCommitted: int32 = 12
    ProductionAdmittedClaimOwnerAbortedAfterDecision: int32 = 13
    ProductionAdmittedClaimOwnerRetiring: int32 = 14
    ProductionAdmittedClaimOwnerRetired: int32 = 15
    ProductionAdmittedClaimStateRetired: int32 = 9
    ProductionAdmittedClaimErrState: str =
        "production_admitted_claim_authority_e_state"
    ProductionAdmittedClaimErrIdentity: str =
        "production_admitted_claim_authority_e_identity"

var productionAdmittedClaimRegistryState: int32
var productionAdmittedClaimSlotStates: atomic.I32[]
var productionAdmittedClaimSlotOwnerLocks: atomic.I32[]
var productionAdmittedClaimSlotGenerations: uint64[]
var productionAdmittedClaimSlotRootOwners: int32[]
var productionAdmittedClaimSlotBundleOwners: int32[]
var productionAdmittedClaimSlotCapsuleOwners: int32[]
var productionAdmittedClaimSlotParentSessions: int32[]
var productionAdmittedClaimSlotChildPids: int32[]
var productionAdmittedClaimSlotChildUids: uint32[]
var productionAdmittedClaimSlotChildGids: uint32[]
var productionAdmittedClaimSlotAdmittedCids: str[]
var productionAdmittedClaimSlotLeaseCids: str[]
var productionAdmittedClaimSlotRootBindingCids: str[]
var productionAdmittedClaimSlotHeldBundleCids: str[]
var productionAdmittedClaimSlotActivationBytes: str[]
var productionAdmittedClaimSlotRequestIdentityCids: str[]
var productionAdmittedClaimSlotClaimReceiptCids: str[]
var productionAdmittedClaimSlotOwnerClaimReceiptCids: str[]
var productionAdmittedClaimNextOwnerRow: atomic.I32
var productionAdmittedClaimOwnerStates: atomic.I32[]
var productionAdmittedClaimOwnerSlots: int32[]
var productionAdmittedClaimOwnerGenerations: uint64[]
var productionAdmittedClaimOwnerSessions: int32[]
var productionAdmittedClaimOwnerCapsules: int32[]
var productionAdmittedClaimOwnerClaimedReceiptCids: str[]
var productionAdmittedClaimState: int32

fn ProductionAdmittedClaimAuthorityInitializeBeforeFork(): bool =
    csgStoreHeadLeaseEnsureRegistry()
    if !pre_exec.CsgCoreProductionAdmittedInputAuthorityReady() ||
       !ProductionHeldExecTerminalCapsuleInitializeBeforeFork():
        return false
    var builder = false
    while !builder:
        os.CsgCurrentHeadLeaseRegistryLock()
        let state = system.RuntimeAtomicLoadI32(
            productionAdmittedClaimRegistryState)
        if state == 2:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return true
        if state == 3:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
        if state == 0:
            builder = system.RuntimeAtomicCompareExchangeI32(
                productionAdmittedClaimRegistryState, 0, 1)
            os.CsgCurrentHeadLeaseRegistryUnlock()
        elif state == 1:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("production admitted claim registry state invalid")
    setLen(productionAdmittedClaimSlotStates,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotOwnerLocks,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotGenerations,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotRootOwners,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotBundleOwners,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotCapsuleOwners,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotParentSessions,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotChildPids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotChildUids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotChildGids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotAdmittedCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotLeaseCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotRootBindingCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotHeldBundleCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotActivationBytes,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotRequestIdentityCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotClaimReceiptCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimSlotOwnerClaimReceiptCids,
        ProductionAdmittedClaimSlotCount)
    setLen(productionAdmittedClaimOwnerStates,
        ProductionAdmittedClaimHandleRowCount)
    setLen(productionAdmittedClaimOwnerSlots,
        ProductionAdmittedClaimHandleRowCount)
    setLen(productionAdmittedClaimOwnerGenerations,
        ProductionAdmittedClaimHandleRowCount)
    setLen(productionAdmittedClaimOwnerSessions,
        ProductionAdmittedClaimHandleRowCount)
    setLen(productionAdmittedClaimOwnerCapsules,
        ProductionAdmittedClaimHandleRowCount)
    setLen(productionAdmittedClaimOwnerClaimedReceiptCids,
        ProductionAdmittedClaimHandleRowCount)
    for slot in 0..<ProductionAdmittedClaimSlotCount:
        productionAdmittedClaimSlotStates[slot] = atomic.NewI32(0)
        productionAdmittedClaimSlotOwnerLocks[slot] = atomic.NewI32(0)
        productionAdmittedClaimSlotGenerations[slot] = uint64(0)
        productionAdmittedClaimSlotRootOwners[slot] = -1
        productionAdmittedClaimSlotBundleOwners[slot] = -1
        productionAdmittedClaimSlotCapsuleOwners[slot] = -1
        productionAdmittedClaimSlotParentSessions[slot] = -1
        productionAdmittedClaimSlotChildPids[slot] = -1
    for row in 0..<ProductionAdmittedClaimHandleRowCount:
        productionAdmittedClaimOwnerStates[row] = atomic.NewI32(0)
        productionAdmittedClaimOwnerSlots[row] = -1
        productionAdmittedClaimOwnerSessions[row] = -1
        productionAdmittedClaimOwnerCapsules[row] = -1
    productionAdmittedClaimNextOwnerRow = atomic.NewI32(0)
    if productionAdmittedClaimNextOwnerRow == nil:
        os.CsgCurrentHeadLeaseRegistryLock()
        system.RuntimeAtomicStoreI32(
            productionAdmittedClaimRegistryState, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        return false
    for slot in 0..<ProductionAdmittedClaimSlotCount:
        if productionAdmittedClaimSlotStates[slot] == nil ||
           productionAdmittedClaimSlotOwnerLocks[slot] == nil:
            os.CsgCurrentHeadLeaseRegistryLock()
            system.RuntimeAtomicStoreI32(
                productionAdmittedClaimRegistryState, 3)
            os.CsgCurrentHeadLeaseRegistryNotifyAll()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    for row in 0..<ProductionAdmittedClaimHandleRowCount:
        if productionAdmittedClaimOwnerStates[row] == nil:
            os.CsgCurrentHeadLeaseRegistryLock()
            system.RuntimeAtomicStoreI32(
                productionAdmittedClaimRegistryState, 3)
            os.CsgCurrentHeadLeaseRegistryNotifyAll()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    os.CsgCurrentHeadLeaseRegistryLock()
    if system.RuntimeAtomicLoadI32(
           productionAdmittedClaimRegistryState) != 1:
        system.RuntimeAtomicStoreI32(
            productionAdmittedClaimRegistryState, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("production admitted claim registry publication drift")
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimRegistryState, 2)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return true

fn productionAdmittedClaimAbortBeforeDurableInto(
        slot: int32,
        ownerRow: int32) =
    let bundleOwner = productionAdmittedClaimSlotBundleOwners[slot]
    if bundleOwner > 0:
        if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim pre-durable bundle owner abort failed")
        productionAdmittedClaimSlotBundleOwners[slot] = -1
    let rootOwner = productionAdmittedClaimSlotRootOwners[slot]
    if rootOwner > 0:
        var rootErr: str
        if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               rootOwner, rootErr):
            panic(strings.ConcatStr(
                "admitted claim pre-durable root close failed: ", rootErr))
        productionAdmittedClaimSlotRootOwners[slot] = -1
    if ownerRow >= 0:
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerAborted)
    atomic.StoreI32(
        productionAdmittedClaimSlotStates[slot],
        ProductionAdmittedClaimStateAborted)
    atomic.StoreI32(productionAdmittedClaimSlotOwnerLocks[slot], 0)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, ProductionAdmittedClaimStateAborted)

fn productionAdmittedClaimEnterRecoveryAfterDurableInto(
        slot: int32,
        ownerRow: int32,
        capsuleOwner: int32) =
    if capsuleOwner > 0:
        var ownedCapsule = capsuleOwner
        var capsuleErr: str
        if !ProductionHeldExecTerminalCapsuleAbortInto(
               ownedCapsule, capsuleErr):
            panic(strings.ConcatStr(
                "admitted claim durable capsule abort failed: ",
                capsuleErr))
    let bundleOwner = productionAdmittedClaimSlotBundleOwners[slot]
    if bundleOwner > 0:
        if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim durable bundle owner abort failed")
        productionAdmittedClaimSlotBundleOwners[slot] = -1
    let rootOwner = productionAdmittedClaimSlotRootOwners[slot]
    if rootOwner > 0:
        var rootErr: str
        if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               rootOwner, rootErr):
            panic(strings.ConcatStr(
                "admitted claim durable root close failed: ", rootErr))
        productionAdmittedClaimSlotRootOwners[slot] = -1
    productionAdmittedClaimSlotCapsuleOwners[slot] = -1
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerRecoveryRequired)
    atomic.StoreI32(
        productionAdmittedClaimSlotStates[slot],
        ProductionAdmittedClaimStateRecoveryRequired)
    atomic.StoreI32(productionAdmittedClaimSlotOwnerLocks[slot], 0)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState,
        ProductionAdmittedClaimStateRecoveryRequired)

# CLAIM authenticates kernel credentials and derives the immutable proof. The
# same root owner first installs and reads back CLAIMED plus its exact proof;
# only that now-named durable session may issue the direct-inode capsule. A
# later capsule failure is therefore a recoverable durable CLAIMED session,
# never an unissued request that a caller may abort or retry.
fn ProductionAdmittedClaimAuthorityClaimDurableInto(
        admittedOwner: var int32,
        runtimeSession: int32,
        outDurableClaimOwner: var int32,
        err: var str): bool =
    outDurableClaimOwner = -1
    var claimedInput: pre_exec.CsgCoreProductionAdmittedInputClaim
    var rootOwner: int32
    var bundleOwner: int32
    if !pre_exec.CsgCoreProductionAdmittedInputClaimInto(
           admittedOwner,
           runtimeSession,
           claimedInput,
           rootOwner,
           bundleOwner,
           err):
        if bundleOwner > 0 &&
           !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim provider-failure bundle abort failed")
        if rootOwner > 0:
            var closeProviderFailureErr: str
            if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
                   rootOwner, closeProviderFailureErr):
                panic(strings.ConcatStr(
                    "admitted claim provider-failure root close failed: ",
                    closeProviderFailureErr))
        return false
    var rootBindingCid: str
    if rootOwner <= 0 || bundleOwner <= 0 ||
       !csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           rootOwner, rootBindingCid, err) ||
       rootBindingCid != claimedInput.rootOwnerBindingCid:
        if bundleOwner > 0 &&
           !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim root-drift bundle abort failed")
        if rootOwner > 0:
            var closeRootDriftErr: str
            if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
                   rootOwner, closeRootDriftErr):
                panic(strings.ConcatStr(
                    "admitted claim root-drift close failed: ",
                    closeRootDriftErr))
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    var slot: int32 = -1
    for scan in 0..<ProductionAdmittedClaimSlotCount:
        if slot >= 0:
            break
        let prior = atomic.LoadI32(productionAdmittedClaimSlotStates[scan])
        if (prior == ProductionAdmittedClaimStateEmpty ||
            prior == ProductionAdmittedClaimStateCommitted ||
            prior == ProductionAdmittedClaimStateAborted) &&
           atomic.CasI32(
               productionAdmittedClaimSlotStates[scan],
               prior,
               ProductionAdmittedClaimStateBuilding):
            if atomic.CasI32(
                   productionAdmittedClaimSlotOwnerLocks[scan], 0, 1):
                slot = scan
            else:
                atomic.StoreI32(
                    productionAdmittedClaimSlotStates[scan], prior)
    if slot < 0:
        if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim terminal-arena bundle abort failed")
        var closeArenaErr: str
        if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               rootOwner, closeArenaErr):
            panic(strings.ConcatStr(
                "admitted claim terminal-arena root close failed: ",
                closeArenaErr))
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    productionAdmittedClaimSlotGenerations[slot] =
        claimedInput.generation
    productionAdmittedClaimSlotRootOwners[slot] = rootOwner
    productionAdmittedClaimSlotBundleOwners[slot] = bundleOwner
    productionAdmittedClaimSlotParentSessions[slot] = runtimeSession
    productionAdmittedClaimSlotChildPids[slot] = claimedInput.childPid
    productionAdmittedClaimSlotChildUids[slot] = claimedInput.childUid
    productionAdmittedClaimSlotChildGids[slot] = claimedInput.childGid
    productionAdmittedClaimSlotAdmittedCids[slot] =
        strings.CloneStr(claimedInput.admittedInputCid)
    productionAdmittedClaimSlotLeaseCids[slot] =
        strings.CloneStr(claimedInput.leaseCid)
    productionAdmittedClaimSlotRootBindingCids[slot] =
        strings.CloneStr(claimedInput.rootOwnerBindingCid)
    productionAdmittedClaimSlotHeldBundleCids[slot] =
        strings.CloneStr(claimedInput.heldBundleCid)
    productionAdmittedClaimSlotActivationBytes[slot] =
        strings.CloneStr(claimedInput.activationBundleBytes)
    productionAdmittedClaimSlotRequestIdentityCids[slot] =
        strings.CloneStr(claimedInput.requestIdentityCid)
    productionAdmittedClaimSlotClaimReceiptCids[slot] =
        strings.CloneStr(claimedInput.claimReceiptCid)
    productionAdmittedClaimSlotOwnerClaimReceiptCids[slot] =
        strings.CloneStr(claimedInput.ownerClaimReceiptCid)
    var proof: admission_codec.ProductionHeldExecAdmissionProof
    proof.generation = claimedInput.generation
    proof.admittedInputCid = strings.CloneStr(
        claimedInput.admittedInputCid)
    proof.heldBundleCid = strings.CloneStr(claimedInput.heldBundleCid)
    proof.leaseCid = strings.CloneStr(claimedInput.leaseCid)
    proof.rootOwnerBindingCid = strings.CloneStr(
        claimedInput.rootOwnerBindingCid)
    proof.claimReceiptCid = strings.CloneStr(
        claimedInput.claimReceiptCid)
    proof.ownerClaimReceiptCid = strings.CloneStr(
        claimedInput.ownerClaimReceiptCid)
    proof.activationBundleBytes = strings.CloneStr(
        claimedInput.activationBundleBytes)
    let canonical = admission_codec.ProductionHeldExecAdmissionProofEncode(
        proof)
    var strict: admission_codec.ProductionHeldExecAdmissionProof
    if canonical.len <=
           admission_codec.ProductionHeldExecAdmissionProofFixedBytes ||
       !admission_codec.ProductionHeldExecAdmissionProofDecodeStrictInto(
           canonical, strict):
        productionAdmittedClaimAbortBeforeDurableInto(slot, -1)
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    var claimed: journal_codec.ProductionTerminalJournalClaimedRecord
    if !journal_codec.ProductionTerminalJournalClaimedEncodeStrictInto(
           canonical,
           claimedInput.childBirthReceiptCid,
           claimedInput.childPid,
           claimedInput.childUid,
           claimedInput.childGid,
           claimedInput.childBirthPlatform,
           claimedInput.childBirth0,
           claimedInput.childBirth1,
           claimed):
        productionAdmittedClaimAbortBeforeDurableInto(slot, -1)
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    let ownerRow = atomic.FetchAddI32(
        productionAdmittedClaimNextOwnerRow, 1)
    if ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount:
        productionAdmittedClaimAbortBeforeDurableInto(slot, -1)
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    productionAdmittedClaimOwnerSlots[ownerRow] = slot
    productionAdmittedClaimOwnerGenerations[ownerRow] =
        claimedInput.generation
    productionAdmittedClaimOwnerSessions[ownerRow] = runtimeSession
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerPrepared)
    let claimedView = rawbytes.BytesFromString(claimed.canonical)
    let proofView = rawbytes.BytesFromString(canonical)
    if !csgStoreTerminalJournalRootOwnerOpenClaimedInto(
           productionAdmittedClaimSlotRootOwners[slot],
           claimed.sessionCid,
           claimedView,
           proofView,
           err):
        productionAdmittedClaimEnterRecoveryAfterDurableInto(
            slot, ownerRow, -1)
        return false
    productionAdmittedClaimOwnerClaimedReceiptCids[ownerRow] =
        strings.CloneStr(claimed.recordReceiptCid)
    var capsuleOwner: int32
    if !ProductionHeldExecTerminalCapsuleIssueInto(
           productionAdmittedClaimSlotRootOwners[slot],
           productionAdmittedClaimSlotBundleOwners[slot],
           runtimeSession,
           capsuleOwner,
           err):
        productionAdmittedClaimEnterRecoveryAfterDurableInto(
            slot, ownerRow, capsuleOwner)
        return false
    if capsuleOwner <= 0 ||
       productionAdmittedClaimSlotBundleOwners[slot] != -1:
        err = "production_admitted_claim_authority_e_capsule_move"
        productionAdmittedClaimEnterRecoveryAfterDurableInto(
            slot, ownerRow, capsuleOwner)
        return false
    productionAdmittedClaimSlotCapsuleOwners[slot] = capsuleOwner
    productionAdmittedClaimOwnerCapsules[ownerRow] = capsuleOwner
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerIssued)
    atomic.StoreI32(
        productionAdmittedClaimSlotStates[slot],
        ProductionAdmittedClaimStateClaimed)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, ProductionAdmittedClaimStateClaimed)
    outDurableClaimOwner = ownerRow + 1
    err = ""
    return true
fn productionAdmittedClaimAuthorityMoveRootInto(
        durableClaimOwner: int32,
        outRootOwner: var int32,
        outRuntimeSession: var int32,
        err: var str): bool =
    outRootOwner = -1
    outRuntimeSession = -1
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow) ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           ProductionAdmittedClaimOwnerIssued,
           ProductionAdmittedClaimOwnerMovingRoot):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let slot = productionAdmittedClaimOwnerSlots[ownerRow]
    let generation = productionAdmittedClaimOwnerGenerations[ownerRow]
    if slot < 0 || slot >= ProductionAdmittedClaimSlotCount ||
       generation != productionAdmittedClaimSlotGenerations[slot] ||
       atomic.LoadI32(productionAdmittedClaimSlotStates[slot]) !=
           ProductionAdmittedClaimStateClaimed ||
       productionAdmittedClaimSlotRootOwners[slot] <= 0 ||
       productionAdmittedClaimOwnerSessions[ownerRow] <= 0 ||
       productionAdmittedClaimOwnerCapsules[ownerRow] <= 0 ||
       productionAdmittedClaimOwnerCapsules[ownerRow] !=
           productionAdmittedClaimSlotCapsuleOwners[slot]:
        let capsuleOwner =
            productionAdmittedClaimSlotCapsuleOwners[slot]
        productionAdmittedClaimEnterRecoveryAfterDurableInto(
            slot, ownerRow, capsuleOwner)
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    outRootOwner = productionAdmittedClaimSlotRootOwners[slot]
    outRuntimeSession = productionAdmittedClaimOwnerSessions[ownerRow]
    productionAdmittedClaimSlotRootOwners[slot] = -1
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerRootMoved)
    err = ""
    return true

fn ProductionAdmittedClaimAuthorityReleaseDurableForRecoveryInto(
        durableClaimOwner: int32,
        err: var str): bool =
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow) ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           ProductionAdmittedClaimOwnerIssued,
           ProductionAdmittedClaimOwnerRecoveryRequired):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let slot = productionAdmittedClaimOwnerSlots[ownerRow]
    if slot < 0 || slot >= ProductionAdmittedClaimSlotCount ||
       productionAdmittedClaimOwnerGenerations[ownerRow] !=
           productionAdmittedClaimSlotGenerations[slot] ||
       !atomic.CasI32(
           productionAdmittedClaimSlotStates[slot],
           ProductionAdmittedClaimStateClaimed,
           ProductionAdmittedClaimStateRecoveryRequired):
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    let capsuleOwner = productionAdmittedClaimSlotCapsuleOwners[slot]
    if capsuleOwner > 0:
        var ownedCapsule = capsuleOwner
        var capsuleErr: str
        if !ProductionHeldExecTerminalCapsuleAbortInto(
               ownedCapsule, capsuleErr):
            panic(strings.ConcatStr(
                "admitted claim durable capsule abort failed: ", capsuleErr))
        productionAdmittedClaimSlotCapsuleOwners[slot] = -1
        productionAdmittedClaimOwnerCapsules[ownerRow] = -1
    let bundleOwner = productionAdmittedClaimSlotBundleOwners[slot]
    if bundleOwner > 0:
        if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
            panic("admitted claim durable bundle owner abort failed")
        productionAdmittedClaimSlotBundleOwners[slot] = -1
    let rootOwner = productionAdmittedClaimSlotRootOwners[slot]
    if rootOwner > 0:
        var rootErr: str
        if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               rootOwner, rootErr):
            panic(strings.ConcatStr(
                "admitted claim durable root close failed: ", rootErr))
        productionAdmittedClaimSlotRootOwners[slot] = -1
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState,
        ProductionAdmittedClaimStateRecoveryRequired)
    atomic.StoreI32(productionAdmittedClaimSlotOwnerLocks[slot], 0)
    err = ""
    return true

fn ProductionAdmittedClaimAuthorityFailAfterRootMoveInto(
        durableClaimOwner: int32,
        err: var str): bool =
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let prior = atomic.LoadI32(
        productionAdmittedClaimOwnerStates[ownerRow])
    if (prior != ProductionAdmittedClaimOwnerRootMoved &&
        prior != ProductionAdmittedClaimOwnerActivated &&
        prior != ProductionAdmittedClaimOwnerFinished &&
        prior != ProductionAdmittedClaimOwnerRecoveryRequired) ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           prior,
           ProductionAdmittedClaimOwnerRecoveryRequired):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let slot = productionAdmittedClaimOwnerSlots[ownerRow]
    if slot < 0 || slot >= ProductionAdmittedClaimSlotCount ||
       productionAdmittedClaimOwnerGenerations[ownerRow] !=
           productionAdmittedClaimSlotGenerations[slot]:
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    let capsuleOwner = productionAdmittedClaimSlotCapsuleOwners[slot]
    if capsuleOwner > 0:
        var ownedCapsule = capsuleOwner
        var capsuleErr: str
        if !ProductionHeldExecTerminalCapsuleAbortInto(
               ownedCapsule, capsuleErr):
            panic(strings.ConcatStr(
                "admitted claim moved capsule abort failed: ", capsuleErr))
        productionAdmittedClaimSlotCapsuleOwners[slot] = -1
    atomic.StoreI32(
        productionAdmittedClaimSlotStates[slot],
        ProductionAdmittedClaimStateAborted)
    atomic.StoreI32(productionAdmittedClaimSlotOwnerLocks[slot], 0)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, ProductionAdmittedClaimStateAborted)
    err = ""
    return true

fn ProductionAdmittedClaimAuthorityActivateInto(
        durableClaimOwner: int32,
        err: var str): bool =
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow) ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           ProductionAdmittedClaimOwnerRootMoved,
           ProductionAdmittedClaimOwnerActivating):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let capsuleOwner = productionAdmittedClaimOwnerCapsules[ownerRow]
    let runtimeSession = productionAdmittedClaimOwnerSessions[ownerRow]
    if capsuleOwner <= 0 || runtimeSession <= 0 ||
       !ProductionHeldExecTerminalCapsuleActivateInto(
           capsuleOwner, runtimeSession, err):
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        return false
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerActivated)
    err = ""
    return true

# The terminal journal is part of this same authority boundary. The following
# phase machine is intentionally colocated with the fenced root and CLAIM
# owners so no raw tree, canonical record, CID tuple or decision bit can cross
# a module boundary and be reminted by a caller.
# Durable held-exec terminal journal.
#
# The public identity is one append-only int32 row.  AtomicTree descriptors,
# CIDs and phase state stay in private Arena/SoA columns.  A verified record
# is published only after exclusive write, exact shape verification,
# no-replace commit, verified reopen and byte-for-byte stable readback.
#
# The helpers encode the complete durable chain, but remain module-private.
# DECISION must be invoked only by the stable guardian that also owns the
# workload channel and pidfd/kqueue observation.  Until that process boundary
# is wired, no production caller may import this helper or claim crash recovery.

const
    ProductionTerminalJournalSchemaVersion: int32 = 1
    ProductionTerminalJournalRecordBytes: int32 = 512
    ProductionTerminalJournalDecisionCanonicalBytes: int32 = 768
    ProductionTerminalJournalObservationCanonicalBytes: int32 = 224
    ProductionTerminalJournalObservationMagic: uint64 =
        uint64(6075999405536927567)
    ProductionTerminalJournalObservationVersion: uint64 = uint64(1)
    ProductionTerminalJournalObservationPhaseExit: int32 = 1
    ProductionTerminalJournalObservationPhaseReap: int32 = 2
    ProductionTerminalJournalRowCount: int32 = 4096
    ProductionTerminalJournalStateEmpty: int32 = 0
    ProductionTerminalJournalStateClaimed: int32 = 1
    ProductionTerminalJournalStateWritingFinished: int32 = 2
    ProductionTerminalJournalStateFinished: int32 = 3
    ProductionTerminalJournalStateRecoveryRequired: int32 = 4
    ProductionTerminalJournalStateClosing: int32 = 5
    ProductionTerminalJournalStateDetached: int32 = 6
    ProductionTerminalJournalStateWritingDecision: int32 = 7
    ProductionTerminalJournalStateDecision: int32 = 8
    ProductionTerminalJournalStateWritingExitObserved: int32 = 9
    ProductionTerminalJournalStateExitObserved: int32 = 10
    ProductionTerminalJournalStateWritingReaped: int32 = 11
    ProductionTerminalJournalStateReaped: int32 = 12
    ProductionTerminalJournalStateWritingProviderFinalized: int32 = 13
    ProductionTerminalJournalStateProviderFinalized: int32 = 14
    ProductionTerminalJournalPhaseClaimed: int32 = 1
    ProductionTerminalJournalPhaseFinished: int32 = 2
    ProductionTerminalJournalPhaseDecision: int32 = 3
    # DECISION is the durable semantic linearization point.  It does not
    # authorize session close: only the durable Reaped observation Ack can
    # mint the runtime retire owner that drains transport/root/CSG authority.
    ProductionTerminalJournalPhaseProviderFinalized: int32 = 4
    ProductionTerminalJournalPhaseExitObserved: int32 = 5
    ProductionTerminalJournalPhaseReaped: int32 = 6
    ProductionTerminalJournalDecisionNone: int32 = 0
    ProductionTerminalJournalDecisionCommit: int32 = 1
    ProductionTerminalJournalDecisionAbort: int32 = 2
    ProductionTerminalJournalDecisionOwnerNone: int32 = 0
    ProductionTerminalJournalDecisionOwnerLive: int32 = 1
    ProductionTerminalJournalDecisionOwnerTaken: int32 = 2
    ProductionTerminalJournalDecisionOwnerRecoveredProof: int32 = 3
    ProductionTerminalJournalDecisionOwnerSending: int32 = 4
    ProductionTerminalJournalRecoveredProviderNone: int32 = 0
    ProductionTerminalJournalRecoveredProviderImporting: int32 = 1
    ProductionTerminalJournalRecoveredProviderImported: int32 = 2
    ProductionTerminalJournalRecoveredProviderFinalizing: int32 = 3
    ProductionTerminalJournalRecoveredProviderCommitted: int32 = 4
    ProductionTerminalJournalRecoveredProviderAborted: int32 = 5
    ProductionTerminalJournalRecoveredProviderRecoveryRequired: int32 = 6
    ProductionTerminalJournalMagic0: int32 = 67
    ProductionTerminalJournalMagic1: int32 = 84
    ProductionTerminalJournalMagic2: int32 = 74
    ProductionTerminalJournalMagic3: int32 = 82
    ProductionTerminalJournalRecordDomain: str =
        "cheng.runtime.held_exec.terminal_journal.record.v1"
    ProductionTerminalJournalProviderReceiptDomain: str =
        "cheng.runtime.held_exec.recovered_provider_finalize.v1"
    ProductionTerminalJournalEventsDirectory: str = "events"
    ProductionTerminalJournalRecordFile: str = "record.bin"
    ProductionTerminalJournalDecisionFile: str = "decision.bin"
    ProductionTerminalJournalFinishedName: str = "02-finished"
    ProductionTerminalJournalDecisionName: str = "03-decision"
    ProductionTerminalJournalProviderFinalizedName: str =
        "04-provider-finalized"
    ProductionTerminalJournalExitObservedName: str = "05-exit-observed"
    ProductionTerminalJournalReapedName: str = "06-reaped"

type
    productionTerminalJournalRecord =
        phase: int32
        decision: int32
        sessionCid: layout.FixedBytes32
        predecessorReceipt: layout.FixedBytes32
        claimReceipt: layout.FixedBytes32
        terminalReceipt: layout.FixedBytes32
        evidenceA: layout.FixedBytes32
        evidenceB: layout.FixedBytes32
        outputBytes: uint64
        workloadExitCode: int32
        childPid: int32
        childUid: uint32
        childGid: uint32
        receipt: layout.FixedBytes32
        observationCanonical: str
    productionTerminalFinishedRecoveryProof =
        workloadExitCode: int32
        outputBytes: uint64
        terminalReceipt: layout.FixedBytes32
        childIdentity: layout.FixedBytes32
        outputDigest: layout.FixedBytes32
        uploadDigest: layout.FixedBytes32
        planReceipt: layout.FixedBytes32
        planEvidenceReceipt: layout.FixedBytes32
        compileReceipt: layout.FixedBytes32
        claimReceipt: layout.FixedBytes32
        ownerClaimReceipt: layout.FixedBytes32
        nonce: layout.FixedBytes32

var
    productionTerminalJournalRegistryInit: int32
    productionTerminalJournalNextRow: atomic.I32
    productionTerminalJournalStates: atomic.I32[]
    productionTerminalJournalRootOwnerHandles: int32[]
    productionTerminalJournalSessionCids: str[]
    productionTerminalJournalClaimReceiptCids: str[]
    productionTerminalJournalOwnerClaimReceiptCids: str[]
    productionTerminalJournalClaimedRecordReceiptCids: str[]
    productionTerminalJournalTerminalReceiptCids: str[]
    productionTerminalJournalChildIdentityCids: str[]
    productionTerminalJournalFinishedUploadCids: str[]
    productionTerminalJournalFinishedRecordReceiptCids: str[]
    productionTerminalJournalHeadFenceReceiptCids: str[]
    productionTerminalJournalDecisionRecordReceiptCids: str[]
    productionTerminalJournalDecisionCanonicalCids: str[]
    productionTerminalJournalDecisionCanonicals: str[]
    productionTerminalJournalExitObservationReceiptCids: str[]
    productionTerminalJournalExitObservedRecordReceiptCids: str[]
    productionTerminalJournalReapReceiptCids: str[]
    productionTerminalJournalReapedRecordReceiptCids: str[]
    productionTerminalJournalProviderReceiptCids: str[]
    productionTerminalJournalProviderFinalizedRecordReceiptCids: str[]
    productionTerminalJournalDecisions: int32[]
    productionTerminalJournalDecisionOwners: int32[]
    productionTerminalJournalDecisionOwnerStates: atomic.I32[]
    productionTerminalJournalOutputByteCounts: uint64[]
    productionTerminalJournalWorkloadExitCodes: int32[]
    productionTerminalJournalRuntimeSessions: int32[]
    productionTerminalJournalDurableClaimOwners: int32[]
    productionTerminalJournalProviderProofOwners: int32[]
    productionTerminalJournalExitPermission0: int32[]
    productionTerminalJournalExitPermission1: int32[]
    productionTerminalJournalExitPermission2: int32[]
    productionTerminalJournalExitPermission3: int32[]
    productionTerminalJournalReapPermission0: int32[]
    productionTerminalJournalReapPermission1: int32[]
    productionTerminalJournalReapPermission2: int32[]
    productionTerminalJournalReapPermission3: int32[]
    productionTerminalJournalBindOwners: int32[]
    productionTerminalJournalBindPhases: int32[]
    productionTerminalJournalCommitPermission0: int32[]
    productionTerminalJournalCommitPermission1: int32[]
    productionTerminalJournalCommitPermission2: int32[]
    productionTerminalJournalCommitPermission3: int32[]
    productionTerminalJournalChildPids: int32[]
    productionTerminalJournalChildUids: uint32[]
    productionTerminalJournalChildGids: uint32[]
    productionTerminalJournalObservationCanonical: str[]
    productionTerminalJournalProjectedObservationCanonical: str[]
    productionTerminalJournalDurableObservationRecordCanonical: str[]
    productionTerminalJournalObservationOwners: int32[]
    productionTerminalJournalDurableAppendOwners: int32[]
    productionTerminalJournalRetireOwners: int32[]
    productionTerminalJournalCloseReadyOwners: int32[]
    productionTerminalJournalRecoveredRows: int32[]
    productionTerminalJournalAdmissionCanonical: str[]
    productionTerminalJournalClaimedCanonical: str[]
    productionTerminalJournalRecoveredProviderStates: atomic.I32[]
    productionTerminalJournalRecoveredProviderOwnerHandles: int32[]
    productionTerminalJournalRecoveredProviderRootBindingCids: str[]
    productionTerminalJournalRecoveredProviderSessionCids: str[]
    productionTerminalJournalRecoveredProviderClaimReceiptCids: str[]
    productionTerminalJournalRecoveredProviderOwnerClaimReceiptCids: str[]
    productionTerminalJournalRecoveredProviderProofReceiptCids: str[]
    productionTerminalJournalRecoveredProviderDecisionOwners: int32[]
    productionTerminalJournalRecoveredProviderDecisions: int32[]
    productionTerminalJournalRecoveredProviderReceiptCids: str[]

fn productionTerminalJournalPutU32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: uint32) =
    rawbytes.BytesSet(bytes, offset, int32(value & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 1, int32((value >> 8) & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 2, int32((value >> 16) & uint32(255)))
    rawbytes.BytesSet(
        bytes, offset + 3, int32((value >> 24) & uint32(255)))

fn productionTerminalJournalPutU64(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: uint64) =
    for byteIndex in 0..<8:
        rawbytes.BytesSet(
            bytes,
            offset + byteIndex,
            int32((value >> uint64(byteIndex * 8)) & uint64(255)))

@borrows
fn productionTerminalJournalPutFixed32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<32:
        rawbytes.BytesSet(
            bytes, offset + byteIndex, int32(value.data[byteIndex]))

@borrows
fn productionTerminalJournalCidDigestInto(
        cid: str,
        out: var layout.FixedBytes32): bool =
    return merkle_store_codec.csgStoreCodecParseCid(cid, out) &&
        !layout.FixedBytes32Equal(out, layout.FixedBytes32())

@borrows
fn productionTerminalJournalCid(
        digest: layout.FixedBytes32): str =
    if layout.FixedBytes32Equal(digest, layout.FixedBytes32()):
        return ""
    return "sha256:" + layout.FixedBytes32Hex(digest)

fn productionTerminalJournalDigestFromLimbs(
        limb0: uint64,
        limb1: uint64,
        limb2: uint64,
        limb3: uint64): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for byteIndex in 0..<32:
        let limbIndex = byteIndex / 8
        var limb = limb0
        if limbIndex == 1:
            limb = limb1
        elif limbIndex == 2:
            limb = limb2
        elif limbIndex == 3:
            limb = limb3
        out.data[byteIndex] = uint8(
            (limb >> uint64((byteIndex % 8) * 8)) & uint64(255))
    return out

@borrows
fn productionTerminalJournalTextU32(
        value: str,
        offset: int32): int32 =
    if offset < 0 || offset > value.len - 4:
        return -1
    return int32(value[offset]) |
        (int32(value[offset + 1]) << 8) |
        (int32(value[offset + 2]) << 16) |
        (int32(value[offset + 3]) << 24)

@borrows
fn productionTerminalJournalTextU64(
        value: str,
        offset: int32): uint64 =
    if offset < 0 || offset > value.len - 8:
        return uint64(0)
    var out: uint64
    for byteIndex in 0..<8:
        out = out |
            (uint64(value[offset + byteIndex]) <<
             uint64(byteIndex * 8))
    return out

@borrows
fn productionTerminalJournalTextFixed32Into(
        value: str,
        offset: int32,
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    if offset < 0 || offset > value.len - 32:
        return false
    for byteIndex in 0..<32:
        out.data[byteIndex] = uint8(value[offset + byteIndex])
    return !layout.FixedBytes32Equal(out, layout.FixedBytes32())

@borrows
fn productionTerminalJournalObservationCanonicalStrictInto(
        row: int32,
        canonical: str,
        expectedPhase: int32,
        outProjectedCanonicalCid: var str,
        outEvidenceCid: var str): bool =
    outProjectedCanonicalCid = ""
    outEvidenceCid = ""
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       canonical.len != ProductionTerminalJournalObservationCanonicalBytes ||
       (expectedPhase != ProductionTerminalJournalObservationPhaseExit &&
        expectedPhase != ProductionTerminalJournalObservationPhaseReap):
        return false
    let childPid = int32(
        productionTerminalJournalTextU64(canonical, 24))
    let childUid = uint32(
        productionTerminalJournalTextU64(canonical, 32))
    let childGid = uint32(
        productionTerminalJournalTextU64(canonical, 40))
    let signalNumber = int32(
        productionTerminalJournalTextU64(canonical, 48))
    let siCode = int32(
        productionTerminalJournalTextU64(canonical, 56))
    let rawStatus = int32(
        productionTerminalJournalTextU64(canonical, 64))
    let exitCode = int32(
        productionTerminalJournalTextU64(canonical, 72))
    let rawWaitStatus = int32(
        productionTerminalJournalTextU64(canonical, 80))
    let platformTupleValid =
        (signalNumber == 17 && rawWaitStatus == -1) ||
        (signalNumber == 20 &&
         (expectedPhase == ProductionTerminalJournalObservationPhaseExit ?
             rawWaitStatus == -1 : rawWaitStatus >= 0))
    if productionTerminalJournalTextU64(canonical, 0) !=
           ProductionTerminalJournalObservationMagic ||
       productionTerminalJournalTextU64(canonical, 8) !=
           ProductionTerminalJournalObservationVersion ||
       productionTerminalJournalTextU64(canonical, 16) !=
           uint64(expectedPhase) ||
       childPid != productionTerminalJournalChildPids[row] ||
       childUid != productionTerminalJournalChildUids[row] ||
       childGid != productionTerminalJournalChildGids[row] ||
       signalNumber <= 0 || siCode < 1 || siCode > 3 || rawStatus < 0 ||
       exitCode != 0 || !platformTupleValid ||
       productionTerminalJournalRuntimeSessions[row] <= 0 ||
       productionTerminalJournalTextU64(canonical, 216) !=
           uint64(productionTerminalJournalRuntimeSessions[row]):
        return false
    var claimDigest: layout.FixedBytes32
    var ownerClaimDigest: layout.FixedBytes32
    var terminalDigest: layout.FixedBytes32
    var embeddedReceipt: layout.FixedBytes32
    var expectedClaim: layout.FixedBytes32
    var expectedOwnerClaim: layout.FixedBytes32
    var expectedTerminal: layout.FixedBytes32
    if !productionTerminalJournalTextFixed32Into(
           canonical, 88, claimDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 120, ownerClaimDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 152, terminalDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 184, embeddedReceipt) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalClaimReceiptCids[row], expectedClaim) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalOwnerClaimReceiptCids[row],
           expectedOwnerClaim) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalTerminalReceiptCids[row],
           expectedTerminal) ||
       !layout.FixedBytes32Equal(claimDigest, expectedClaim) ||
       !layout.FixedBytes32Equal(ownerClaimDigest, expectedOwnerClaim) ||
       !layout.FixedBytes32Equal(terminalDigest, expectedTerminal):
        return false
    var rebuilt = rawbytes.BytesAlloc(
        ProductionTerminalJournalObservationCanonicalBytes)
    productionTerminalJournalPutU64(
        rebuilt, 0, ProductionTerminalJournalObservationMagic)
    productionTerminalJournalPutU64(
        rebuilt, 8, ProductionTerminalJournalObservationVersion)
    productionTerminalJournalPutU64(rebuilt, 16, uint64(expectedPhase))
    productionTerminalJournalPutU64(rebuilt, 24, uint64(childPid))
    productionTerminalJournalPutU64(rebuilt, 32, uint64(childUid))
    productionTerminalJournalPutU64(rebuilt, 40, uint64(childGid))
    productionTerminalJournalPutU64(rebuilt, 48, uint64(signalNumber))
    productionTerminalJournalPutU64(rebuilt, 56, uint64(siCode))
    productionTerminalJournalPutU64(rebuilt, 64, uint64(rawStatus))
    productionTerminalJournalPutU64(rebuilt, 72, uint64(exitCode))
    productionTerminalJournalPutU64(rebuilt, 80, uint64(rawWaitStatus))
    productionTerminalJournalPutFixed32(rebuilt, 88, expectedClaim)
    productionTerminalJournalPutFixed32(rebuilt, 120, expectedOwnerClaim)
    productionTerminalJournalPutFixed32(rebuilt, 152, expectedTerminal)
    productionTerminalJournalPutU64(
        rebuilt,
        216,
        uint64(productionTerminalJournalRuntimeSessions[row]))
    let embeddedReceiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "cheng.runtime.held_exec.terminal_observation.canonical.v1",
            rebuilt)
    var computedReceipt: layout.FixedBytes32
    if !productionTerminalJournalCidDigestInto(
           embeddedReceiptCid, computedReceipt) ||
       !layout.FixedBytes32Equal(computedReceipt, embeddedReceipt):
        rawbytes.BytesFree(rebuilt)
        return false
    productionTerminalJournalPutFixed32(rebuilt, 184, computedReceipt)
    var exact = true
    for byteIndex in 0..<ProductionTerminalJournalObservationCanonicalBytes:
        if rawbytes.BytesGet(rebuilt, byteIndex) !=
           int32(canonical[byteIndex]):
            exact = false
    if exact:
        outProjectedCanonicalCid =
            merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
                "cheng.runtime.held_exec.terminal_observation.projected_canonical.v1",
                rebuilt)
        let evidenceDomain = expectedPhase ==
            ProductionTerminalJournalObservationPhaseExit ?
                "cheng.runtime.held_exec.exit_observation.canonical.v1" :
                "cheng.runtime.held_exec.reap_observation.canonical.v1"
        outEvidenceCid =
            merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
                evidenceDomain, rebuilt)
        exact =
            merkle_store_codec.CsgCoreMerkleStoreCidValid(
                outProjectedCanonicalCid) &&
            merkle_store_codec.CsgCoreMerkleStoreCidValid(outEvidenceCid)
    rawbytes.BytesFree(rebuilt)
    return exact

# Strictly decode and re-encode the fourth frame inside the terminal
# authority. The expected decision and three evidence digests come only from
# this journal row; canonical bytes can never mint authority by themselves.
@borrows
fn productionTerminalJournalDecisionCanonicalStrictInto(
        canonical: str,
        expectedDecision: int32,
        expectedClaimReceiptCid: str,
        expectedTerminalReceiptCid: str,
        expectedOwnerClaimReceiptCid: str,
        outCanonicalCid: var str): bool =
    outCanonicalCid = ""
    if canonical.len != ProductionTerminalJournalDecisionCanonicalBytes ||
       (expectedDecision != ProductionTerminalJournalDecisionCommit &&
        expectedDecision != ProductionTerminalJournalDecisionAbort):
        return false
    let expectedKind = expectedDecision ==
        ProductionTerminalJournalDecisionCommit ? uint64(4) : uint64(5)
    if productionTerminalJournalTextU64(canonical, 0) !=
           uint64(4848207723554137671) ||
       productionTerminalJournalTextU64(canonical, 8) != uint64(1) ||
       productionTerminalJournalTextU64(canonical, 16) != expectedKind ||
       productionTerminalJournalTextU64(canonical, 24) != uint64(4):
        return false
    for byteIndex in 192..<ProductionTerminalJournalDecisionCanonicalBytes:
        if canonical[byteIndex] != uint8(0):
            return false
    var nonceDigest: layout.FixedBytes32
    var claimDigest: layout.FixedBytes32
    var terminalDigest: layout.FixedBytes32
    var ownerClaimDigest: layout.FixedBytes32
    var embeddedReceipt: layout.FixedBytes32
    var expectedClaim: layout.FixedBytes32
    var expectedTerminal: layout.FixedBytes32
    var expectedOwnerClaim: layout.FixedBytes32
    if !productionTerminalJournalTextFixed32Into(
           canonical, 32, nonceDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 64, claimDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 96, terminalDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 128, ownerClaimDigest) ||
       !productionTerminalJournalTextFixed32Into(
           canonical, 160, embeddedReceipt) ||
       !productionTerminalJournalCidDigestInto(
           expectedClaimReceiptCid,
           expectedClaim) ||
       !productionTerminalJournalCidDigestInto(
           expectedTerminalReceiptCid,
           expectedTerminal) ||
       !productionTerminalJournalCidDigestInto(
           expectedOwnerClaimReceiptCid,
           expectedOwnerClaim) ||
       !layout.FixedBytes32Equal(claimDigest, expectedClaim) ||
       !layout.FixedBytes32Equal(terminalDigest, expectedTerminal) ||
       !layout.FixedBytes32Equal(ownerClaimDigest, expectedOwnerClaim):
        return false
    var rebuilt = rawbytes.BytesAlloc(
        ProductionTerminalJournalDecisionCanonicalBytes)
    productionTerminalJournalPutU64(
        rebuilt, 0, uint64(4848207723554137671))
    productionTerminalJournalPutU64(rebuilt, 8, uint64(1))
    productionTerminalJournalPutU64(rebuilt, 16, expectedKind)
    productionTerminalJournalPutU64(rebuilt, 24, uint64(4))
    productionTerminalJournalPutFixed32(rebuilt, 32, nonceDigest)
    productionTerminalJournalPutFixed32(rebuilt, 64, expectedClaim)
    productionTerminalJournalPutFixed32(rebuilt, 96, expectedTerminal)
    productionTerminalJournalPutFixed32(rebuilt, 128, expectedOwnerClaim)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "cheng.runtime.held_exec.durable_decision.canonical.v1",
            rebuilt)
    var computedReceipt: layout.FixedBytes32
    if !productionTerminalJournalCidDigestInto(
           receiptCid, computedReceipt) ||
       !layout.FixedBytes32Equal(computedReceipt, embeddedReceipt):
        rawbytes.BytesFree(rebuilt)
        return false
    productionTerminalJournalPutFixed32(
        rebuilt, 160, computedReceipt)
    var exact = true
    for byteIndex in 0..<ProductionTerminalJournalDecisionCanonicalBytes:
        if rawbytes.BytesGet(rebuilt, byteIndex) !=
           int32(canonical[byteIndex]):
            exact = false
    if exact:
        outCanonicalCid =
            merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
                "cheng.runtime.held_exec.durable_decision.canonical.v1",
                rebuilt)
        exact = merkle_store_codec.CsgCoreMerkleStoreCidValid(
            outCanonicalCid)
    rawbytes.BytesFree(rebuilt)
    return exact

# Build the only recovery-side fourth-frame canonical from FINISHED bytes
# already strict-decoded from the fixed inode.  The returned bytes are not an
# authority: only the no-replace DECISION append below can publish them.
@borrows
fn productionTerminalJournalDecisionCanonicalBuildInto(
        nonce: layout.FixedBytes32,
        decision: int32,
        claimReceiptCid: str,
        terminalReceiptCid: str,
        ownerClaimReceiptCid: str,
        outCanonical: var str,
        outCanonicalCid: var str): bool =
    outCanonical = ""
    outCanonicalCid = ""
    if layout.FixedBytes32Equal(nonce, layout.FixedBytes32()) ||
       (decision != ProductionTerminalJournalDecisionCommit &&
        decision != ProductionTerminalJournalDecisionAbort):
        return false
    var claim: layout.FixedBytes32
    var terminal: layout.FixedBytes32
    var ownerClaim: layout.FixedBytes32
    if !productionTerminalJournalCidDigestInto(claimReceiptCid, claim) ||
       !productionTerminalJournalCidDigestInto(
           terminalReceiptCid, terminal) ||
       !productionTerminalJournalCidDigestInto(
           ownerClaimReceiptCid, ownerClaim):
        return false
    var bytes = rawbytes.BytesAlloc(
        ProductionTerminalJournalDecisionCanonicalBytes)
    productionTerminalJournalPutU64(
        bytes, 0, uint64(4848207723554137671))
    productionTerminalJournalPutU64(bytes, 8, uint64(1))
    productionTerminalJournalPutU64(
        bytes,
        16,
        decision == ProductionTerminalJournalDecisionCommit ?
            uint64(4) : uint64(5))
    productionTerminalJournalPutU64(bytes, 24, uint64(4))
    productionTerminalJournalPutFixed32(bytes, 32, nonce)
    productionTerminalJournalPutFixed32(bytes, 64, claim)
    productionTerminalJournalPutFixed32(bytes, 96, terminal)
    productionTerminalJournalPutFixed32(bytes, 128, ownerClaim)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "cheng.runtime.held_exec.durable_decision.canonical.v1",
            bytes)
    var receipt: layout.FixedBytes32
    if !productionTerminalJournalCidDigestInto(receiptCid, receipt):
        rawbytes.BytesFree(bytes)
        return false
    productionTerminalJournalPutFixed32(bytes, 160, receipt)
    let canonical = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    var canonicalCid: str
    if !productionTerminalJournalDecisionCanonicalStrictInto(
           canonical,
           decision,
           claimReceiptCid,
           terminalReceiptCid,
           ownerClaimReceiptCid,
           canonicalCid):
        return false
    outCanonical = strings.CloneStr(canonical)
    outCanonicalCid = strings.CloneStr(canonicalCid)
    return true

@borrows
fn productionTerminalJournalRecordEncode(
        record: productionTerminalJournalRecord): rawbytes.Bytes =
    var bytes = rawbytes.BytesAlloc(ProductionTerminalJournalRecordBytes)
    rawbytes.BytesSet(bytes, 0, ProductionTerminalJournalMagic0)
    rawbytes.BytesSet(bytes, 1, ProductionTerminalJournalMagic1)
    rawbytes.BytesSet(bytes, 2, ProductionTerminalJournalMagic2)
    rawbytes.BytesSet(bytes, 3, ProductionTerminalJournalMagic3)
    productionTerminalJournalPutU32(
        bytes, 4, uint32(ProductionTerminalJournalSchemaVersion))
    productionTerminalJournalPutU32(bytes, 8, uint32(record.phase))
    productionTerminalJournalPutU32(bytes, 12, uint32(record.decision))
    productionTerminalJournalPutFixed32(bytes, 16, record.sessionCid)
    productionTerminalJournalPutFixed32(
        bytes, 48, record.predecessorReceipt)
    productionTerminalJournalPutFixed32(bytes, 80, record.claimReceipt)
    productionTerminalJournalPutFixed32(bytes, 112, record.terminalReceipt)
    productionTerminalJournalPutFixed32(bytes, 144, record.evidenceA)
    productionTerminalJournalPutFixed32(bytes, 176, record.evidenceB)
    productionTerminalJournalPutU64(bytes, 208, record.outputBytes)
    productionTerminalJournalPutU32(
        bytes, 216, uint32(record.workloadExitCode))
    productionTerminalJournalPutU32(
        bytes, 220, uint32(record.childPid))
    productionTerminalJournalPutU32(bytes, 224, record.childUid)
    productionTerminalJournalPutU32(bytes, 228, record.childGid)
    productionTerminalJournalPutFixed32(bytes, 232, record.receipt)
    if record.observationCanonical.len ==
           ProductionTerminalJournalObservationCanonicalBytes:
        for byteIndex in
                0..<ProductionTerminalJournalObservationCanonicalBytes:
            rawbytes.BytesSet(
                bytes,
                264 + byteIndex,
                int32(record.observationCanonical[byteIndex]))
    return bytes

fn productionTerminalJournalRecordFinalize(
        record: var productionTerminalJournalRecord): rawbytes.Bytes =
    record.receipt = layout.FixedBytes32()
    var unsignedBytes = productionTerminalJournalRecordEncode(record)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            ProductionTerminalJournalRecordDomain,
            unsignedBytes)
    rawbytes.BytesFree(unsignedBytes)
    if !productionTerminalJournalCidDigestInto(
           receiptCid, record.receipt):
        return rawbytes.EmptyBytes()
    return productionTerminalJournalRecordEncode(record)

fn productionTerminalJournalInitializeBeforeGuardianLoop(): bool =
    if !csgStoreTerminalJournalRootOwnerInitializeBeforeGuardianLoop():
        return false
    var builder = false
    while !builder:
        os.CsgCurrentHeadLeaseRegistryLock()
        let state = system.RuntimeAtomicLoadI32(
            productionTerminalJournalRegistryInit)
        if state == 2:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return true
        if state == 3:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
        if state == 0:
            builder = system.RuntimeAtomicCompareExchangeI32(
                productionTerminalJournalRegistryInit, 0, 1)
            os.CsgCurrentHeadLeaseRegistryUnlock()
        elif state == 1:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("production terminal journal registry state invalid")
    setLen(
        productionTerminalJournalStates,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRootOwnerHandles,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalSessionCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalClaimReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalOwnerClaimReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalClaimedRecordReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalTerminalReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalChildIdentityCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalFinishedUploadCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalFinishedRecordReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalHeadFenceReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDecisionRecordReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDecisionCanonicalCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDecisionCanonicals,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalExitObservationReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalExitObservedRecordReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalReapReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalReapedRecordReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalProviderReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalProviderFinalizedRecordReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDecisions,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDecisionOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDecisionOwnerStates,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalOutputByteCounts,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalWorkloadExitCodes,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRuntimeSessions,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDurableClaimOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalProviderProofOwners,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalExitPermission0,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalExitPermission1,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalExitPermission2,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalExitPermission3,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalReapPermission0,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalReapPermission1,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalReapPermission2,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalReapPermission3,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalBindOwners,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalBindPhases,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalCommitPermission0,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalCommitPermission1,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalCommitPermission2,
        ProductionTerminalJournalRowCount)
    setLen(productionTerminalJournalCommitPermission3,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalChildPids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalChildUids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalChildGids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalObservationCanonical,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalProjectedObservationCanonical,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDurableObservationRecordCanonical,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalObservationOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalDurableAppendOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRetireOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalCloseReadyOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredRows,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalAdmissionCanonical,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalClaimedCanonical,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderStates,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderOwnerHandles,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderRootBindingCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderSessionCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderClaimReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderOwnerClaimReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderProofReceiptCids,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderDecisionOwners,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderDecisions,
        ProductionTerminalJournalRowCount)
    setLen(
        productionTerminalJournalRecoveredProviderReceiptCids,
        ProductionTerminalJournalRowCount)
    var ok: bool = true
    for row in 0..<ProductionTerminalJournalRowCount:
        productionTerminalJournalStates[row] =
            atomic.NewI32(ProductionTerminalJournalStateEmpty)
        if productionTerminalJournalStates[row] == nil:
            ok = false
        productionTerminalJournalRootOwnerHandles[row] = -1
        productionTerminalJournalSessionCids[row] = ""
        productionTerminalJournalClaimReceiptCids[row] = ""
        productionTerminalJournalOwnerClaimReceiptCids[row] = ""
        productionTerminalJournalClaimedRecordReceiptCids[row] = ""
        productionTerminalJournalTerminalReceiptCids[row] = ""
        productionTerminalJournalChildIdentityCids[row] = ""
        productionTerminalJournalFinishedUploadCids[row] = ""
        productionTerminalJournalFinishedRecordReceiptCids[row] = ""
        productionTerminalJournalHeadFenceReceiptCids[row] = ""
        productionTerminalJournalDecisionRecordReceiptCids[row] = ""
        productionTerminalJournalDecisionCanonicalCids[row] = ""
        productionTerminalJournalDecisionCanonicals[row] = ""
        productionTerminalJournalExitObservationReceiptCids[row] = ""
        productionTerminalJournalExitObservedRecordReceiptCids[row] = ""
        productionTerminalJournalReapReceiptCids[row] = ""
        productionTerminalJournalReapedRecordReceiptCids[row] = ""
        productionTerminalJournalProviderReceiptCids[row] = ""
        productionTerminalJournalProviderFinalizedRecordReceiptCids[row] = ""
        productionTerminalJournalDecisions[row] =
            ProductionTerminalJournalDecisionNone
        productionTerminalJournalDecisionOwners[row] = -1
        productionTerminalJournalDecisionOwnerStates[row] =
            atomic.NewI32(0)
        if productionTerminalJournalDecisionOwnerStates[row] == nil:
            ok = false
        productionTerminalJournalOutputByteCounts[row] = uint64(0)
        productionTerminalJournalWorkloadExitCodes[row] = int32(-1)
        productionTerminalJournalRuntimeSessions[row] = int32(-1)
        productionTerminalJournalDurableClaimOwners[row] = int32(-1)
        productionTerminalJournalProviderProofOwners[row] = int32(-1)
        productionTerminalJournalExitPermission0[row] = 0
        productionTerminalJournalExitPermission1[row] = 0
        productionTerminalJournalExitPermission2[row] = 0
        productionTerminalJournalExitPermission3[row] = 0
        productionTerminalJournalReapPermission0[row] = 0
        productionTerminalJournalReapPermission1[row] = 0
        productionTerminalJournalReapPermission2[row] = 0
        productionTerminalJournalReapPermission3[row] = 0
        productionTerminalJournalBindOwners[row] = -1
        productionTerminalJournalBindPhases[row] = 0
        productionTerminalJournalCommitPermission0[row] = 0
        productionTerminalJournalCommitPermission1[row] = 0
        productionTerminalJournalCommitPermission2[row] = 0
        productionTerminalJournalCommitPermission3[row] = 0
        productionTerminalJournalChildPids[row] = int32(-1)
        productionTerminalJournalChildUids[row] = uint32(0)
        productionTerminalJournalChildGids[row] = uint32(0)
        productionTerminalJournalObservationCanonical[row] = ""
        productionTerminalJournalProjectedObservationCanonical[row] = ""
        productionTerminalJournalDurableObservationRecordCanonical[row] = ""
        productionTerminalJournalObservationOwners[row] = -1
        productionTerminalJournalDurableAppendOwners[row] = -1
        productionTerminalJournalRetireOwners[row] = -1
        productionTerminalJournalCloseReadyOwners[row] = -1
        productionTerminalJournalRecoveredRows[row] = 0
        productionTerminalJournalAdmissionCanonical[row] = ""
        productionTerminalJournalClaimedCanonical[row] = ""
        productionTerminalJournalRecoveredProviderStates[row] =
            atomic.NewI32(0)
        if productionTerminalJournalRecoveredProviderStates[row] == nil:
            ok = false
        productionTerminalJournalRecoveredProviderOwnerHandles[row] = -1
        productionTerminalJournalRecoveredProviderRootBindingCids[row] = ""
        productionTerminalJournalRecoveredProviderSessionCids[row] = ""
        productionTerminalJournalRecoveredProviderClaimReceiptCids[row] = ""
        productionTerminalJournalRecoveredProviderOwnerClaimReceiptCids[row] = ""
        productionTerminalJournalRecoveredProviderProofReceiptCids[row] = ""
        productionTerminalJournalRecoveredProviderDecisionOwners[row] = -1
        productionTerminalJournalRecoveredProviderDecisions[row] =
            ProductionTerminalJournalDecisionNone
        productionTerminalJournalRecoveredProviderReceiptCids[row] = ""
    productionTerminalJournalNextRow = atomic.NewI32(0)
    if productionTerminalJournalNextRow == nil:
        ok = false
    if !ok:
        os.CsgCurrentHeadLeaseRegistryLock()
        system.RuntimeAtomicStoreI32(
            productionTerminalJournalRegistryInit, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        return false
    os.CsgCurrentHeadLeaseRegistryLock()
    if system.RuntimeAtomicLoadI32(
           productionTerminalJournalRegistryInit) != 1:
        system.RuntimeAtomicStoreI32(
            productionTerminalJournalRegistryInit, 3)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("production terminal journal registry publication drift")
    system.RuntimeAtomicStoreI32(
        productionTerminalJournalRegistryInit, 2)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return true

# Guardian startup is the sole public initialization phase. It accepts no
# path, PID, CID or caller-selected evidence; all durable authority is issued
# later through opaque int32 root/session owners.
fn ProductionTerminalJournalInitializeBeforeGuardianLoop(): bool =
    return productionTerminalJournalInitializeBeforeGuardianLoop()

# The durable claim owner is the sole authority input. This function moves
# the already-open, fence-bound root handle into the journal row exactly once.
# The raw AtomicTree never leaves this module and remains joined to that root
# row while the journal reconstructs every field from no-replace files.
fn ProductionTerminalJournalBeginFromDurableClaimOwnerInto(
        durableClaimOwner: var int32,
        outJournalOwner: var int32,
        err: var str): bool =
    outJournalOwner = -1
    if durableClaimOwner <= 0:
        err = "production_terminal_journal_claim_owner_invalid"
        return false
    let ownedDurableClaimOwner = durableClaimOwner
    let row = productionTerminalJournalAllocateRow()
    if row < 0:
        err = "production_terminal_journal_owner_arena_exhausted"
        return false
    productionTerminalJournalDurableClaimOwners[row] =
        ownedDurableClaimOwner
    durableClaimOwner = -1
    outJournalOwner = row + 1
    atomic.StoreI32(
        productionTerminalJournalStates[row],
        ProductionTerminalJournalStateRecoveryRequired)
    var rootOwner: int32
    var runtimeSession: int32
    if !productionAdmittedClaimAuthorityMoveRootInto(
           ownedDurableClaimOwner,
           rootOwner,
           runtimeSession,
           err):
        productionTerminalJournalDurableClaimOwners[row] = -1
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateDetached)
        return false
    productionTerminalJournalRootOwnerHandles[row] = rootOwner
    var claimedCanonical: str
    var admissionCanonical: str
    var rootBindingCid: str
    let claimedRead =
        csgStoreTerminalJournalRootOwnerReadRecordInto(
            rootOwner,
            ProductionTerminalJournalPhaseClaimed,
            claimedCanonical,
            err)
    var admissionRead: int32 = -1
    if claimedRead == 1:
        admissionRead =
            csgStoreTerminalJournalRootOwnerReadAdmissionProofInto(
                rootOwner, admissionCanonical, err)
    var decoded: journal_codec.ProductionTerminalJournalClaimedRecord
    let strictValid = claimedRead == 1 && admissionRead == 1 &&
        csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
            rootOwner, rootBindingCid, err) &&
        journal_codec.ProductionTerminalJournalClaimedDecodeStrictInto(
            claimedCanonical,
            admissionCanonical,
            rootBindingCid,
            decoded)
    if !strictValid:
        let failure = strings.CloneStr(err)
        var closeErr: str
        if !CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               rootOwner, closeErr):
            panic(strings.ConcatStr(
                "production terminal journal claimed close failed: ",
                closeErr))
        productionTerminalJournalRootOwnerHandles[row] = -1
        var authorityErr: str
        if !ProductionAdmittedClaimAuthorityFailAfterRootMoveInto(
               ownedDurableClaimOwner, authorityErr):
            panic(strings.ConcatStr(
                "production terminal journal claim authority detach failed: ",
                authorityErr))
        productionTerminalJournalDurableClaimOwners[row] = -1
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateDetached)
        err = failure.len > 0 ? failure :
            "production_terminal_journal_claimed_strict_invalid"
        return false
    productionTerminalJournalSessionCids[row] =
        strings.CloneStr(decoded.sessionCid)
    productionTerminalJournalClaimReceiptCids[row] =
        strings.CloneStr(decoded.claimReceiptCid)
    productionTerminalJournalOwnerClaimReceiptCids[row] =
        strings.CloneStr(decoded.ownerClaimReceiptCid)
    productionTerminalJournalClaimedRecordReceiptCids[row] =
        strings.CloneStr(decoded.recordReceiptCid)
    productionTerminalJournalRuntimeSessions[row] = runtimeSession
    productionTerminalJournalDurableClaimOwners[row] =
        ownedDurableClaimOwner
    productionTerminalJournalChildPids[row] = decoded.childPid
    productionTerminalJournalChildUids[row] = decoded.childUid
    productionTerminalJournalChildGids[row] = decoded.childGid
    productionTerminalJournalAdmissionCanonical[row] =
        strings.CloneStr(admissionCanonical)
    productionTerminalJournalClaimedCanonical[row] =
        strings.CloneStr(claimedCanonical)
    productionTerminalJournalRecoveredRows[row] = 0
    atomic.StoreI32(
        productionTerminalJournalStates[row],
        ProductionTerminalJournalStateClaimed)
    err = ""
    return true

fn ProductionTerminalJournalActivateAdmittedInto(
        journalOwner: int32,
        err: var str): bool =
    let row = productionTerminalJournalRowForHandle(
        journalOwner, ProductionTerminalJournalStateClaimed)
    if row < 0 || productionTerminalJournalRecoveredRows[row] != 0 ||
       productionTerminalJournalDurableClaimOwners[row] <= 0:
        err = "production_terminal_journal_activate_owner_invalid"
        return false
    return ProductionAdmittedClaimAuthorityActivateInto(
        productionTerminalJournalDurableClaimOwners[row], err)

@borrows
fn ProductionTerminalJournalFinishAdmittedInto(
        journalOwner: int32,
        outputPath: str,
        err: var str): bool =
    let row = productionTerminalJournalRowForHandle(
        journalOwner, ProductionTerminalJournalStateClaimed)
    if row < 0 || productionTerminalJournalRecoveredRows[row] != 0 ||
       productionTerminalJournalDurableClaimOwners[row] <= 0 ||
       !atomic.CasI32(
           productionTerminalJournalStates[row],
           ProductionTerminalJournalStateClaimed,
           ProductionTerminalJournalStateWritingFinished):
        err = "production_terminal_journal_finish_owner_invalid"
        return false
    var finishedProofOwner: int32
    var exitPermission0: int32
    var exitPermission1: int32
    var exitPermission2: int32
    var exitPermission3: int32
    var reapPermission0: int32
    var reapPermission1: int32
    var reapPermission2: int32
    var reapPermission3: int32
    if !productionAdmittedClaimAuthorityFinishInto(
           productionTerminalJournalDurableClaimOwners[row],
           outputPath,
           finishedProofOwner,
           exitPermission0,
           exitPermission1,
           exitPermission2,
           exitPermission3,
           reapPermission0,
           reapPermission1,
           reapPermission2,
           reapPermission3,
           err):
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        return false
    if !productionTerminalJournalAppendFinishedOwnerInto(
           journalOwner,
           finishedProofOwner,
           exitPermission0,
           exitPermission1,
           exitPermission2,
           exitPermission3,
           reapPermission0,
           reapPermission1,
           reapPermission2,
           reapPermission3,
           err):
        if finishedProofOwner > 0:
            if !system.RuntimeHeldExecTerminalCapsuleRoleOwnerAbort(
                   finishedProofOwner):
                panic("production terminal journal orphan transport abort failed")
            finishedProofOwner = -1
        exitPermission0 = 0
        exitPermission1 = 0
        exitPermission2 = 0
        exitPermission3 = 0
        reapPermission0 = 0
        reapPermission1 = 0
        reapPermission2 = 0
        reapPermission3 = 0
        return false
    err = ""
    return true

fn productionTerminalJournalAllocateRow(): int32 =
    if productionTerminalJournalRegistryInit != 2 ||
       productionTerminalJournalNextRow == nil:
        return -1
    while true:
        let row = atomic.LoadI32(productionTerminalJournalNextRow)
        if row < 0 || row >= ProductionTerminalJournalRowCount:
            return -1
        if atomic.CasI32(
               productionTerminalJournalNextRow, row, row + 1):
            return row

@borrows
fn productionTerminalJournalRowForHandle(
        handle: int32,
        requiredState: int32): int32 =
    if handle <= 0 || handle > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        return -1
    let row = handle - 1
    if row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalStates[row] == nil ||
       atomic.LoadI32(productionTerminalJournalStates[row]) !=
           requiredState ||
       productionTerminalJournalRootOwnerHandles[row] <= 0 ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           productionTerminalJournalSessionCids[row]):
        return -1
    return row

@borrows
fn productionTerminalJournalAppendRecordInto(
        rootOwnerHandle: int32,
        phase: int32,
        recordReceiptCid: str,
        recordBytes: rawbytes.Bytes,
        decisionCanonical: str,
        err: var str): bool =
    var finalName: str
    if phase == ProductionTerminalJournalPhaseFinished:
        finalName = ProductionTerminalJournalFinishedName
    elif phase == ProductionTerminalJournalPhaseDecision:
        finalName = ProductionTerminalJournalDecisionName
    elif phase == ProductionTerminalJournalPhaseProviderFinalized:
        finalName = ProductionTerminalJournalProviderFinalizedName
    elif phase == ProductionTerminalJournalPhaseExitObserved:
        finalName = ProductionTerminalJournalExitObservedName
    elif phase == ProductionTerminalJournalPhaseReaped:
        finalName = ProductionTerminalJournalReapedName
    else:
        err = "production_terminal_journal_append_phase_invalid"
        return false
    if rootOwnerHandle <= 0 ||
       rootOwnerHandle > csgStoreTerminalJournalRootOwnerRowCount ||
       rawbytes.BytesLen(recordBytes) !=
           ProductionTerminalJournalRecordBytes ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(recordReceiptCid) ||
       (phase == ProductionTerminalJournalPhaseDecision &&
        decisionCanonical.len !=
            ProductionTerminalJournalDecisionCanonicalBytes) ||
       (phase != ProductionTerminalJournalPhaseDecision &&
        decisionCanonical.len != 0):
        err = "production_terminal_journal_append_input_invalid"
        return false
    let rootRow = rootOwnerHandle - 1
    if csgStoreTerminalJournalRootOwnerRegistryInit != 2 ||
       csgStoreTerminalJournalRootOwnerNextRow == nil ||
       rootRow >= atomic.LoadI32(
           csgStoreTerminalJournalRootOwnerNextRow) ||
       !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[rootRow],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerAppending):
        err = "production_terminal_journal_append_owner_invalid"
        return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(rootRow):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "production_terminal_journal_append_fence_invalid"
        return false
    let rootTree = csgStoreTerminalJournalRootOwnerTrees[rootRow]
    if rootTree == uint64(0):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "production_terminal_journal_append_tree_missing"
        return false
    let stagingName = strings.ConcatStr(
        ".terminal-journal-event-",
        strings.ConcatStr(
            merkle_store_codec.CsgCoreMerkleStoreCidName(recordReceiptCid),
            strings.ConcatStr("-", strings.IntToStr(os.ProcessId()))))
    let begun = os.AtomicTreeBeginChildFromVerifiedRoot(
        rootTree,
        ProductionTerminalJournalEventsDirectory,
        stagingName,
        finalName)
    if result.IsErr(begun):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerOpen)
        err = strings.CloneStr(result.Error(begun))
        return false
    let childTree = result.Value(begun)
    let recordWritten = os.AtomicTreeWriteExclusiveLeaseSync(
        childTree, ProductionTerminalJournalRecordFile, recordBytes)
    if result.IsErr(recordWritten) || !result.Value(recordWritten):
        let aborted = os.AtomicTreeAbort(childTree)
        if result.IsErr(aborted) || !result.Value(aborted):
            panic("production terminal journal: record abort failed")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerOpen)
        err = result.IsErr(recordWritten) ?
            strings.CloneStr(result.Error(recordWritten)) :
            "production_terminal_journal_record_write_failed"
        return false
    if phase == ProductionTerminalJournalPhaseDecision:
        var decisionBytes = rawbytes.BytesFromString(decisionCanonical)
        let decisionWritten = os.AtomicTreeWriteExclusiveLeaseSync(
            childTree,
            ProductionTerminalJournalDecisionFile,
            decisionBytes)
        if result.IsErr(decisionWritten) ||
           !result.Value(decisionWritten):
            let aborted = os.AtomicTreeAbort(childTree)
            if result.IsErr(aborted) || !result.Value(aborted):
                panic("production terminal journal: decision abort failed")
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[rootRow],
                csgStoreTerminalJournalRootOwnerOpen)
            err = result.IsErr(decisionWritten) ?
                strings.CloneStr(result.Error(decisionWritten)) :
                "production_terminal_journal_decision_write_failed"
            return false
    var noDirectories: str[]
    var expectedFiles = [
        strings.CloneStr(ProductionTerminalJournalRecordFile)]
    if phase == ProductionTerminalJournalPhaseDecision:
        expectedFiles = [
            strings.CloneStr(ProductionTerminalJournalDecisionFile),
            strings.CloneStr(ProductionTerminalJournalRecordFile)]
    let verified = os.AtomicTreeVerifyExact(
        childTree, noDirectories, expectedFiles)
    if result.IsErr(verified) || !result.Value(verified):
        let aborted = os.AtomicTreeAbort(childTree)
        if result.IsErr(aborted) || !result.Value(aborted):
            panic("production terminal journal: shape abort failed")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerOpen)
        err = result.IsErr(verified) ?
            strings.CloneStr(result.Error(verified)) :
            "production_terminal_journal_shape_invalid"
        return false
    let committed = os.AtomicTreeCommitNoReplace(childTree)
    if result.IsErr(committed):
        let aborted = os.AtomicTreeAbort(childTree)
        if result.IsErr(aborted) || !result.Value(aborted):
            panic("production terminal journal: commit abort failed")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerOpen)
        err = strings.CloneStr(result.Error(committed))
        return false
    let commitKind = result.Value(committed)
    if commitKind == os.AtomicTreeCommitted:
        let closed = os.AtomicTreeClose(childTree)
        if result.IsErr(closed) || !result.Value(closed):
            atomic.StoreI32(
                csgStoreTerminalJournalRootOwnerStates[rootRow],
                csgStoreTerminalJournalRootOwnerRecoveryRequired)
            err = "production_terminal_journal_committed_close_failed"
            return false
    elif commitKind == os.AtomicTreeDestinationExists:
        let aborted = os.AtomicTreeAbort(childTree)
        if result.IsErr(aborted) || !result.Value(aborted):
            panic("production terminal journal: replay abort failed")
    elif commitKind == os.AtomicTreeCommittedDurabilityUnknown:
        let closed = os.AtomicTreeClose(childTree)
        if result.IsErr(closed) || !result.Value(closed):
            panic("production terminal journal: uncertain close failed")
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "production_terminal_journal_commit_durability_unknown"
        return false
    else:
        panic("production terminal journal: impossible commit result")

    let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
        rootTree,
        ProductionTerminalJournalEventsDirectory,
        finalName)
    if result.IsErr(opened):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(opened))
        return false
    let readbackTree = result.Value(opened)
    var readbackRecord: rawbytes.Bytes
    var readbackDecision: rawbytes.Bytes
    let readbackShape = os.AtomicTreeVerifyExact(
        readbackTree, noDirectories, expectedFiles)
    var recordReadOk = false
    if result.IsOk(readbackShape) && result.Value(readbackShape):
        let recordRead = os.AtomicTreeReadStable(
            readbackTree, ProductionTerminalJournalRecordFile)
        if result.IsOk(recordRead):
            readbackRecord = result.Value(recordRead)
            recordReadOk = true
        else:
            err = strings.CloneStr(result.Error(recordRead))
    elif result.IsErr(readbackShape):
        err = strings.CloneStr(result.Error(readbackShape))
    else:
        err = "production_terminal_journal_readback_shape_invalid"
    var decisionReadOk =
        phase != ProductionTerminalJournalPhaseDecision
    if recordReadOk && phase == ProductionTerminalJournalPhaseDecision:
        let decisionRead = os.AtomicTreeReadStable(
            readbackTree, ProductionTerminalJournalDecisionFile)
        if result.IsOk(decisionRead):
            readbackDecision = result.Value(decisionRead)
            decisionReadOk = true
        else:
            err = strings.CloneStr(result.Error(decisionRead))
    var expectedDecisionBytes = rawbytes.BytesFromString(decisionCanonical)
    let exact = recordReadOk && decisionReadOk &&
        rawbytes.BytesEqual(readbackRecord, recordBytes) &&
        (phase != ProductionTerminalJournalPhaseDecision ||
         rawbytes.BytesEqual(readbackDecision, expectedDecisionBytes))
    if rawbytes.BytesLen(readbackRecord) > 0:
        rawbytes.BytesFree(readbackRecord)
    if rawbytes.BytesLen(readbackDecision) > 0:
        rawbytes.BytesFree(readbackDecision)
    let readbackClosed = os.AtomicTreeClose(readbackTree)
    if result.IsErr(readbackClosed) || !result.Value(readbackClosed):
        panic("production terminal journal: readback close failed")
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[rootRow],
        exact ? csgStoreTerminalJournalRootOwnerOpen :
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
    if !exact:
        if err.len == 0:
            err = "production_terminal_journal_readback_mismatch"
        return false
    err = ""
    return true

@borrows
fn csgStoreTerminalJournalRootOwnerInstallDecisionMirrorInto(
        rootOwnerHandle: int32,
        canonical: str,
        err: var str): bool =
    if rootOwnerHandle <= 0 ||
       rootOwnerHandle > csgStoreTerminalJournalRootOwnerRowCount ||
       canonical.len != csgStoreTerminalJournalDecisionBytes:
        err = "merkle_store_terminal_decision_mirror_input_invalid"
        return false
    let rootRow = rootOwnerHandle - 1
    if csgStoreTerminalJournalRootOwnerRegistryInit != 2 ||
       csgStoreTerminalJournalRootOwnerNextRow == nil ||
       rootRow >= atomic.LoadI32(
           csgStoreTerminalJournalRootOwnerNextRow) ||
       !atomic.CasI32(
           csgStoreTerminalJournalRootOwnerStates[rootRow],
           csgStoreTerminalJournalRootOwnerOpen,
           csgStoreTerminalJournalRootOwnerAppending):
        err = "merkle_store_terminal_decision_mirror_owner_invalid"
        return false
    if !csgStoreTerminalJournalRootOwnerFenceHeld(rootRow):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_decision_mirror_fence_invalid"
        return false
    let rootTree = csgStoreTerminalJournalRootOwnerTrees[rootRow]
    if rootTree == uint64(0):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = "merkle_store_terminal_decision_mirror_tree_missing"
        return false
    var canonicalBytes = rawbytes.BytesFromString(canonical)
    let rewritten = os.AtomicTreeRewriteExistingLeaseSync(
        rootTree,
        csgStoreTerminalJournalDecisionMirrorFile,
        canonicalBytes)
    if result.IsErr(rewritten) || !result.Value(rewritten):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = result.IsErr(rewritten) ?
            strings.CloneStr(result.Error(rewritten)) :
            "merkle_store_terminal_decision_mirror_rewrite_failed"
        return false
    let readback = os.AtomicTreeReadStable(
        rootTree, csgStoreTerminalJournalDecisionMirrorFile)
    if result.IsErr(readback):
        atomic.StoreI32(
            csgStoreTerminalJournalRootOwnerStates[rootRow],
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
        err = strings.CloneStr(result.Error(readback))
        return false
    var installed = result.Value(readback)
    let exact = rawbytes.BytesEqual(installed, canonicalBytes) &&
        csgStoreTerminalJournalRootOwnerFenceHeld(rootRow)
    rawbytes.BytesFree(installed)
    atomic.StoreI32(
        csgStoreTerminalJournalRootOwnerStates[rootRow],
        exact ? csgStoreTerminalJournalRootOwnerOpen :
            csgStoreTerminalJournalRootOwnerRecoveryRequired)
    if !exact:
        err = "merkle_store_terminal_decision_mirror_readback_mismatch"
        return false
    err = ""
    return true
# CLAIMED installation now belongs to the admitted-claim authority. The
# journal regains a live row only by consuming its durable int32 owner and
# moving the already-installed root handle; no raw canonical/public begin
# entry is retained as a second authority path.
@borrows
fn productionTerminalJournalAppendFinishedInto(
        handle: int32,
        childIdentityCid: str,
        terminalReceiptCid: str,
        finishedUploadCid: str,
        outputBytes: uint64,
        workloadExitCode: int32,
        outFinishedRecordReceiptCid: var str,
        err: var str): bool =
    outFinishedRecordReceiptCid = ""
    let row = productionTerminalJournalRowForHandle(
        handle, ProductionTerminalJournalStateWritingFinished)
    if row < 0:
        err = "production_terminal_journal_finished_state_invalid"
        return false
    if outputBytes == uint64(0) ||
       workloadExitCode < 0 || workloadExitCode > 255:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_state_invalid"
        return false
    var sessionDigest: layout.FixedBytes32
    var predecessorDigest: layout.FixedBytes32
    var claimDigest: layout.FixedBytes32
    var terminalDigest: layout.FixedBytes32
    var childIdentityDigest: layout.FixedBytes32
    var finishedUploadDigest: layout.FixedBytes32
    let evidenceValid =
        productionTerminalJournalCidDigestInto(
            productionTerminalJournalSessionCids[row], sessionDigest) &&
        productionTerminalJournalCidDigestInto(
            productionTerminalJournalClaimedRecordReceiptCids[row],
            predecessorDigest) &&
        productionTerminalJournalCidDigestInto(
            productionTerminalJournalClaimReceiptCids[row], claimDigest) &&
        productionTerminalJournalCidDigestInto(
            terminalReceiptCid, terminalDigest) &&
        productionTerminalJournalCidDigestInto(
            childIdentityCid, childIdentityDigest) &&
        productionTerminalJournalCidDigestInto(
            finishedUploadCid, finishedUploadDigest) &&
        !layout.FixedBytes32Equal(terminalDigest, childIdentityDigest) &&
        !layout.FixedBytes32Equal(terminalDigest, finishedUploadDigest) &&
        !layout.FixedBytes32Equal(childIdentityDigest, finishedUploadDigest)
    if !evidenceValid:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_evidence_invalid"
        return false
    var record: productionTerminalJournalRecord
    record.phase = ProductionTerminalJournalPhaseFinished
    record.decision = ProductionTerminalJournalDecisionNone
    record.sessionCid = sessionDigest
    record.predecessorReceipt = predecessorDigest
    record.claimReceipt = claimDigest
    record.terminalReceipt = terminalDigest
    record.evidenceA = childIdentityDigest
    record.evidenceB = finishedUploadDigest
    record.outputBytes = outputBytes
    record.workloadExitCode = workloadExitCode
    record.childPid = productionTerminalJournalChildPids[row]
    record.childUid = productionTerminalJournalChildUids[row]
    record.childGid = productionTerminalJournalChildGids[row]
    var recordBytes = productionTerminalJournalRecordFinalize(record)
    let finishedRecordReceiptCid =
        productionTerminalJournalCid(record.receipt)
    if rawbytes.BytesLen(recordBytes) !=
           ProductionTerminalJournalRecordBytes ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           finishedRecordReceiptCid):
        rawbytes.BytesFree(recordBytes)
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_record_invalid"
        return false
    if !productionTerminalJournalAppendRecordInto(
           productionTerminalJournalRootOwnerHandles[row],
           ProductionTerminalJournalPhaseFinished,
           finishedRecordReceiptCid,
           recordBytes,
           "",
           err):
        rawbytes.BytesFree(recordBytes)
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        return false
    rawbytes.BytesFree(recordBytes)
    productionTerminalJournalTerminalReceiptCids[row] =
        strings.CloneStr(terminalReceiptCid)
    productionTerminalJournalChildIdentityCids[row] =
        strings.CloneStr(childIdentityCid)
    productionTerminalJournalFinishedUploadCids[row] =
        strings.CloneStr(finishedUploadCid)
    productionTerminalJournalFinishedRecordReceiptCids[row] =
        strings.CloneStr(finishedRecordReceiptCid)
    productionTerminalJournalOutputByteCounts[row] = outputBytes
    productionTerminalJournalWorkloadExitCodes[row] = workloadExitCode
    atomic.StoreI32(
        productionTerminalJournalStates[row],
        ProductionTerminalJournalStateFinished)
    outFinishedRecordReceiptCid =
        strings.CloneStr(finishedRecordReceiptCid)
    err = ""
    return true

@borrows
fn productionTerminalJournalAppendFinishedOwnerInto(
        journalOwner: int32,
        finishedProofOwner: var int32,
        exitPermission0: var int32,
        exitPermission1: var int32,
        exitPermission2: var int32,
        exitPermission3: var int32,
        reapPermission0: var int32,
        reapPermission1: var int32,
        reapPermission2: var int32,
        reapPermission3: var int32,
        err: var str): bool =
    let row = productionTerminalJournalRowForHandle(
        journalOwner, ProductionTerminalJournalStateWritingFinished)
    if row < 0 || finishedProofOwner <= 0 ||
       (exitPermission0 == 0 && exitPermission1 == 0 &&
        exitPermission2 == 0 && exitPermission3 == 0) ||
       (reapPermission0 == 0 && reapPermission1 == 0 &&
        reapPermission2 == 0 && reapPermission3 == 0) ||
       (exitPermission0 == reapPermission0 &&
        exitPermission1 == reapPermission1 &&
        exitPermission2 == reapPermission2 &&
        exitPermission3 == reapPermission3) ||
       productionTerminalJournalProviderProofOwners[row] > 0:
        if row >= 0:
            atomic.StoreI32(
                productionTerminalJournalStates[row],
                ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_owner_invalid"
        return false
    productionTerminalJournalProviderProofOwners[row] = finishedProofOwner
    finishedProofOwner = -1
    productionTerminalJournalExitPermission0[row] = exitPermission0
    productionTerminalJournalExitPermission1[row] = exitPermission1
    productionTerminalJournalExitPermission2[row] = exitPermission2
    productionTerminalJournalExitPermission3[row] = exitPermission3
    productionTerminalJournalReapPermission0[row] = reapPermission0
    productionTerminalJournalReapPermission1[row] = reapPermission1
    productionTerminalJournalReapPermission2[row] = reapPermission2
    productionTerminalJournalReapPermission3[row] = reapPermission3
    exitPermission0 = 0
    exitPermission1 = 0
    exitPermission2 = 0
    exitPermission3 = 0
    reapPermission0 = 0
    reapPermission1 = 0
    reapPermission2 = 0
    reapPermission3 = 0
    let transportOwner =
        productionTerminalJournalProviderProofOwners[row]
    var canonical: str
    if !system.RuntimeHeldExecFinishedProofExportCanonicalInto(
           transportOwner, canonical) || canonical.len != 256:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_owner_export_invalid"
        return false
    let bytes = rawbytes.BytesFromString(canonical)
    if rawbytes.BytesLen(bytes) != 256 ||
       rawbytes.BytesGet(bytes, 0) != int32('C') ||
       rawbytes.BytesGet(bytes, 1) != int32('F') ||
       rawbytes.BytesGet(bytes, 2) != int32('P') ||
       rawbytes.BytesGet(bytes, 3) != int32('1') ||
       rawbytes.BytesGet(bytes, 4) != 1 ||
       rawbytes.BytesGet(bytes, 5) != 0 ||
       rawbytes.BytesGet(bytes, 6) != 0 ||
       rawbytes.BytesGet(bytes, 7) != 0:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_owner_schema_invalid"
        return false
    let session = productionTerminalJournalGetU64(bytes, 8)
    let workloadExit = productionTerminalJournalGetU64(bytes, 16)
    let outputBytes = productionTerminalJournalGetU64(bytes, 24)
    var terminalReceipt: layout.FixedBytes32
    var childIdentity: layout.FixedBytes32
    var outputDigest: layout.FixedBytes32
    var uploadDigest: layout.FixedBytes32
    var planReceipt: layout.FixedBytes32
    var claimReceipt: layout.FixedBytes32
    var ownerClaimReceipt: layout.FixedBytes32
    productionTerminalJournalGetFixed32Into(
        bytes, 32, terminalReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 64, childIdentity)
    productionTerminalJournalGetFixed32Into(
        bytes, 96, outputDigest)
    productionTerminalJournalGetFixed32Into(
        bytes, 128, uploadDigest)
    productionTerminalJournalGetFixed32Into(
        bytes, 160, planReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 192, claimReceipt)
    productionTerminalJournalGetFixed32Into(
        bytes, 224, ownerClaimReceipt)
    var expectedClaim: layout.FixedBytes32
    var expectedOwnerClaim: layout.FixedBytes32
    var zero: layout.FixedBytes32
    if session != uint64(productionTerminalJournalRuntimeSessions[row]) ||
       workloadExit > uint64(255) || outputBytes == uint64(0) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalClaimReceiptCids[row],
           expectedClaim) ||
       !productionTerminalJournalCidDigestInto(
           productionTerminalJournalOwnerClaimReceiptCids[row],
           expectedOwnerClaim) ||
       !layout.FixedBytes32Equal(claimReceipt, expectedClaim) ||
       !layout.FixedBytes32Equal(ownerClaimReceipt, expectedOwnerClaim) ||
       layout.FixedBytes32Equal(terminalReceipt, zero) ||
       layout.FixedBytes32Equal(childIdentity, zero) ||
       layout.FixedBytes32Equal(outputDigest, zero) ||
       layout.FixedBytes32Equal(uploadDigest, zero) ||
       layout.FixedBytes32Equal(planReceipt, zero) ||
       layout.FixedBytes32Equal(terminalReceipt, childIdentity) ||
       layout.FixedBytes32Equal(terminalReceipt, uploadDigest) ||
       layout.FixedBytes32Equal(childIdentity, uploadDigest):
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_finished_owner_join_invalid"
        return false
    var finishedRecordReceiptCid: str
    if !productionTerminalJournalAppendFinishedInto(
        journalOwner,
        productionTerminalJournalCid(childIdentity),
        productionTerminalJournalCid(terminalReceipt),
        productionTerminalJournalCid(uploadDigest),
        outputBytes,
        int32(workloadExit),
        finishedRecordReceiptCid,
        err):
        return false
    # The already-bound transport owner moved into this journal row before
    # validation. Every failure therefore leaves one reachable holder; no
    # guardian or launcher receives a copy.
    return true

@borrows
fn productionTerminalJournalAppendDerivedInto(
        row: int32,
        priorState: int32,
        writingState: int32,
        nextState: int32,
        phase: int32,
        decision: int32,
        predecessorReceiptCid: str,
        evidenceACid: str,
        evidenceBCid: str,
        decisionCanonical: str,
        outRecordCanonical: var str,
        outRecordReceiptCid: var str,
        err: var str): bool =
    outRecordCanonical = ""
    outRecordReceiptCid = ""
    if !atomic.CasI32(
           productionTerminalJournalStates[row],
           priorState,
           writingState):
        err = "production_terminal_journal_transition_state_invalid"
        return false
    var sessionDigest: layout.FixedBytes32
    var predecessorDigest: layout.FixedBytes32
    var claimDigest: layout.FixedBytes32
    var terminalDigest: layout.FixedBytes32
    var evidenceADigest: layout.FixedBytes32
    var evidenceBDigest: layout.FixedBytes32
    let requiredEvidenceValid =
        productionTerminalJournalCidDigestInto(
            productionTerminalJournalSessionCids[row], sessionDigest) &&
        productionTerminalJournalCidDigestInto(
            predecessorReceiptCid, predecessorDigest) &&
        productionTerminalJournalCidDigestInto(
            productionTerminalJournalClaimReceiptCids[row], claimDigest) &&
        productionTerminalJournalCidDigestInto(
            productionTerminalJournalTerminalReceiptCids[row],
            terminalDigest) &&
        productionTerminalJournalCidDigestInto(
            evidenceACid, evidenceADigest)
    var optionalEvidenceValid: bool = true
    if evidenceBCid.len > 0:
        optionalEvidenceValid =
            productionTerminalJournalCidDigestInto(
                evidenceBCid, evidenceBDigest)
    if !requiredEvidenceValid || !optionalEvidenceValid ||
       layout.FixedBytes32Equal(predecessorDigest, evidenceADigest) ||
       (evidenceBCid.len > 0 &&
        (layout.FixedBytes32Equal(predecessorDigest, evidenceBDigest) ||
         layout.FixedBytes32Equal(evidenceADigest, evidenceBDigest))):
        atomic.StoreI32(
            productionTerminalJournalStates[row], priorState)
        err = "production_terminal_journal_transition_evidence_invalid"
        return false
    var record: productionTerminalJournalRecord
    record.phase = phase
    record.decision = decision
    record.sessionCid = sessionDigest
    record.predecessorReceipt = predecessorDigest
    record.claimReceipt = claimDigest
    record.terminalReceipt = terminalDigest
    record.evidenceA = evidenceADigest
    record.evidenceB = evidenceBDigest
    record.outputBytes = productionTerminalJournalOutputByteCounts[row]
    record.workloadExitCode =
        productionTerminalJournalWorkloadExitCodes[row]
    record.childPid = productionTerminalJournalChildPids[row]
    record.childUid = productionTerminalJournalChildUids[row]
    record.childGid = productionTerminalJournalChildGids[row]
    record.observationCanonical = strings.CloneStr(
        productionTerminalJournalObservationCanonical[row])
    var recordBytes = productionTerminalJournalRecordFinalize(record)
    let recordReceiptCid = productionTerminalJournalCid(record.receipt)
    if rawbytes.BytesLen(recordBytes) !=
           ProductionTerminalJournalRecordBytes ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(recordReceiptCid):
        rawbytes.BytesFree(recordBytes)
        atomic.StoreI32(
            productionTerminalJournalStates[row], priorState)
        err = "production_terminal_journal_transition_record_invalid"
        return false
    outRecordCanonical = rawbytes.BytesToString(recordBytes)
    if outRecordCanonical.len != ProductionTerminalJournalRecordBytes:
        rawbytes.BytesFree(recordBytes)
        atomic.StoreI32(
            productionTerminalJournalStates[row], priorState)
        err = "production_terminal_journal_transition_record_canonical_invalid"
        return false
    if phase == ProductionTerminalJournalPhaseExitObserved ||
       phase == ProductionTerminalJournalPhaseReaped:
        productionTerminalJournalDurableObservationRecordCanonical[row] =
            strings.CloneStr(outRecordCanonical)
        if productionTerminalJournalDurableObservationRecordCanonical[row] !=
               outRecordCanonical:
            rawbytes.BytesFree(recordBytes)
            atomic.StoreI32(
                productionTerminalJournalStates[row], priorState)
            err = "production_terminal_journal_transition_record_stage_invalid"
            return false
    var appended: bool
    if phase == ProductionTerminalJournalPhaseDecision:
        appended = productionTerminalJournalAppendRecordInto(
            productionTerminalJournalRootOwnerHandles[row],
            phase,
            recordReceiptCid,
            recordBytes,
            decisionCanonical,
            err)
    else:
        appended = productionTerminalJournalAppendRecordInto(
            productionTerminalJournalRootOwnerHandles[row],
            phase,
            recordReceiptCid,
            recordBytes,
            "",
            err)
    if !appended:
        rawbytes.BytesFree(recordBytes)
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        return false
    rawbytes.BytesFree(recordBytes)
    atomic.StoreI32(
        productionTerminalJournalStates[row], nextState)
    outRecordReceiptCid = strings.CloneStr(recordReceiptCid)
    err = ""
    return true

# The successful stable readback inside this call is the only DECISION
# linearization point.  The guardian may send COMMITTED|ABORTED only after it
# returns true; a different retry collides at the no-replace child and fails
# the byte-for-byte readback join.
@borrows
fn productionTerminalJournalAppendDecisionInto(
        handle: int32,
        outDecisionRecordReceiptCid: var str,
        err: var str): bool =
    outDecisionRecordReceiptCid = ""
    let row = productionTerminalJournalRowForHandle(
        handle, ProductionTerminalJournalStateFinished)
    let workloadExitCode = row >= 0 ?
        productionTerminalJournalWorkloadExitCodes[row] : -1
    var headFenceReceiptCid: str
    var headFenceErr: str
    if row < 0 || workloadExitCode < 0 || workloadExitCode > 255 ||
       !csgStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           productionTerminalJournalRootOwnerHandles[row],
           headFenceReceiptCid,
           headFenceErr) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           headFenceReceiptCid):
        err = "production_terminal_journal_decision_input_invalid"
        return false
    let decision = workloadExitCode == 0 ?
        ProductionTerminalJournalDecisionCommit :
        ProductionTerminalJournalDecisionAbort
    var decisionCanonical: str
    if productionTerminalJournalProviderProofOwners[row] <= 0 ||
       !system.RuntimeHeldExecTerminalTransportProjectDecisionCanonicalInto(
           productionTerminalJournalProviderProofOwners[row],
           decisionCanonical):
        err = "production_terminal_journal_decision_canonical_invalid"
        return false
    var decisionCanonicalCid: str
    if !productionTerminalJournalDecisionCanonicalStrictInto(
           decisionCanonical,
           decision,
           productionTerminalJournalClaimReceiptCids[row],
           productionTerminalJournalTerminalReceiptCids[row],
           productionTerminalJournalOwnerClaimReceiptCids[row],
           decisionCanonicalCid):
        err = "production_terminal_journal_decision_canonical_cid_invalid"
        return false
    var decisionRecordCanonical: str
    if !productionTerminalJournalAppendDerivedInto(
           row,
           ProductionTerminalJournalStateFinished,
           ProductionTerminalJournalStateWritingDecision,
           ProductionTerminalJournalStateDecision,
           ProductionTerminalJournalPhaseDecision,
           decision,
           productionTerminalJournalFinishedRecordReceiptCids[row],
           headFenceReceiptCid,
           decisionCanonicalCid,
           decisionCanonical,
           decisionRecordCanonical,
           outDecisionRecordReceiptCid,
           err):
        return false
    productionTerminalJournalHeadFenceReceiptCids[row] =
        strings.CloneStr(headFenceReceiptCid)
    productionTerminalJournalDecisionRecordReceiptCids[row] =
        strings.CloneStr(outDecisionRecordReceiptCid)
    productionTerminalJournalDecisionCanonicalCids[row] =
        strings.CloneStr(decisionCanonicalCid)
    productionTerminalJournalDecisionCanonicals[row] =
        strings.CloneStr(decisionCanonical)
    productionTerminalJournalDecisions[row] = decision
    productionTerminalJournalDecisionOwners[row] = row + 1
    var reexportedDecisionCanonical: str
    if !system.RuntimeHeldExecTerminalTransportProjectDecisionCanonicalInto(
           productionTerminalJournalProviderProofOwners[row],
           reexportedDecisionCanonical) ||
       reexportedDecisionCanonical != decisionCanonical:
        atomic.StoreI32(
            productionTerminalJournalStates[row],
            ProductionTerminalJournalStateRecoveryRequired)
        err = "production_terminal_journal_decision_projection_drift"
        return false
    atomic.StoreI32(
        productionTerminalJournalDecisionOwnerStates[row],
        ProductionTerminalJournalDecisionOwnerLive)
    return true

# DECISION is already durable when this private transition runs. The journal
# and admitted provider share this module, so no caller-supplied decision,
# receipt CID or pair of guessable owner rows crosses an authority boundary.
fn productionAdmittedClaimAuthorityFinalizeDurableDecisionInto(
        durableClaimOwner: int32,
        runtimeSession: int32,
        decision: int32,
        err: var str): bool =
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow) ||
       runtimeSession <= 0 ||
       (decision != ProductionTerminalJournalDecisionCommit &&
        decision != ProductionTerminalJournalDecisionAbort):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let slot = productionAdmittedClaimOwnerSlots[ownerRow]
    if slot < 0 || slot >= ProductionAdmittedClaimSlotCount ||
       productionAdmittedClaimOwnerGenerations[ownerRow] !=
           productionAdmittedClaimSlotGenerations[slot] ||
       productionAdmittedClaimOwnerSessions[ownerRow] != runtimeSession ||
       productionAdmittedClaimOwnerCapsules[ownerRow] <= 0 ||
       productionAdmittedClaimOwnerCapsules[ownerRow] !=
           productionAdmittedClaimSlotCapsuleOwners[slot]:
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    let terminalOwnerState = decision ==
        ProductionTerminalJournalDecisionCommit ?
        ProductionAdmittedClaimOwnerCommitted :
        ProductionAdmittedClaimOwnerAbortedAfterDecision
    let terminalSlotState = decision ==
        ProductionTerminalJournalDecisionCommit ?
        ProductionAdmittedClaimStateCommitted :
        ProductionAdmittedClaimStateAborted
    let priorOwnerState = atomic.LoadI32(
        productionAdmittedClaimOwnerStates[ownerRow])
    let priorSlotState = atomic.LoadI32(
        productionAdmittedClaimSlotStates[slot])
    if priorOwnerState == terminalOwnerState &&
       priorSlotState == terminalSlotState:
        err = ""
        return true
    if priorOwnerState != ProductionAdmittedClaimOwnerFinished ||
       priorSlotState != ProductionAdmittedClaimStateFinished ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           ProductionAdmittedClaimOwnerFinished,
           ProductionAdmittedClaimOwnerFinalizing):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    if !atomic.CasI32(
           productionAdmittedClaimSlotStates[slot],
           ProductionAdmittedClaimStateFinished,
           ProductionAdmittedClaimStateFinalizing):
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        system.RuntimeAtomicStoreI32(
            productionAdmittedClaimState,
            ProductionAdmittedClaimStateRecoveryRequired)
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    atomic.StoreI32(
        productionAdmittedClaimSlotStates[slot], terminalSlotState)
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow], terminalOwnerState)
    atomic.StoreI32(productionAdmittedClaimSlotOwnerLocks[slot], 0)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, terminalSlotState)
    err = ""
    return true

# Runtime transport retirement has already consumed the Reaped retire owner.
# This private join is the only successful teardown of the durable claim and
# terminal capsule rows; abort/recovery paths remain separate and cannot be
# relabelled as a successful retire.
fn productionAdmittedClaimAuthorityRetireAfterRuntimeInto(
        durableClaimOwner: int32,
        runtimeSession: int32,
        err: var str): bool =
    let ownerRow = durableClaimOwner - 1
    if productionAdmittedClaimRegistryState != 2 || ownerRow < 0 ||
       ownerRow >= ProductionAdmittedClaimHandleRowCount ||
       ownerRow >= atomic.LoadI32(productionAdmittedClaimNextOwnerRow) ||
       runtimeSession <= 0:
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let priorOwnerState = atomic.LoadI32(
        productionAdmittedClaimOwnerStates[ownerRow])
    if (priorOwnerState != ProductionAdmittedClaimOwnerCommitted &&
        priorOwnerState !=
            ProductionAdmittedClaimOwnerAbortedAfterDecision) ||
       !atomic.CasI32(
           productionAdmittedClaimOwnerStates[ownerRow],
           priorOwnerState,
           ProductionAdmittedClaimOwnerRetiring):
        err = strings.CloneStr(ProductionAdmittedClaimErrState)
        return false
    let slot = productionAdmittedClaimOwnerSlots[ownerRow]
    let capsuleOwner = productionAdmittedClaimOwnerCapsules[ownerRow]
    let capsuleRow = capsuleOwner - 1
    let expectedSlotState =
        priorOwnerState == ProductionAdmittedClaimOwnerCommitted ?
            ProductionAdmittedClaimStateCommitted :
            ProductionAdmittedClaimStateAborted
    if slot < 0 || slot >= ProductionAdmittedClaimSlotCount ||
       capsuleRow < 0 ||
       capsuleRow >= ProductionHeldExecTerminalCapsuleRowCount ||
       productionAdmittedClaimOwnerGenerations[ownerRow] !=
           productionAdmittedClaimSlotGenerations[slot] ||
       productionAdmittedClaimOwnerSessions[ownerRow] != runtimeSession ||
       productionAdmittedClaimSlotParentSessions[slot] != runtimeSession ||
       atomic.LoadI32(productionAdmittedClaimSlotStates[slot]) !=
           expectedSlotState ||
       productionAdmittedClaimSlotRootOwners[slot] != -1 ||
       productionAdmittedClaimSlotBundleOwners[slot] != -1 ||
       productionAdmittedClaimSlotCapsuleOwners[slot] != capsuleOwner ||
       productionHeldExecTerminalCapsuleRuntimeSessions[capsuleRow] !=
           runtimeSession ||
       productionHeldExecTerminalCapsuleProviderRoleOwners[capsuleRow] !=
           -1 ||
       !atomic.CasI32(
           productionHeldExecTerminalCapsuleStates[capsuleRow],
           ProductionHeldExecTerminalCapsuleStateFinished,
           ProductionHeldExecTerminalCapsuleStateRetiring) ||
       !atomic.CasI32(
           productionAdmittedClaimSlotStates[slot],
           expectedSlotState,
           ProductionAdmittedClaimStateRetired):
        atomic.StoreI32(
            productionAdmittedClaimOwnerStates[ownerRow],
            ProductionAdmittedClaimOwnerRecoveryRequired)
        system.RuntimeAtomicStoreI32(
            productionAdmittedClaimState,
            ProductionAdmittedClaimStateRecoveryRequired)
        err = strings.CloneStr(ProductionAdmittedClaimErrIdentity)
        return false
    productionHeldExecTerminalCapsuleRootOwners[capsuleRow] = -1
    productionHeldExecTerminalCapsuleRuntimeSessions[capsuleRow] = -1
    productionHeldExecTerminalCapsuleHeldBundleCids[capsuleRow] = ""
    productionHeldExecTerminalCapsuleOwnerClaimReceiptCids[capsuleRow] = ""
    atomic.StoreI32(
        productionHeldExecTerminalCapsuleStates[capsuleRow],
        ProductionHeldExecTerminalCapsuleStateRetired)
    productionAdmittedClaimSlotCapsuleOwners[slot] = -1
    productionAdmittedClaimSlotParentSessions[slot] = -1
    productionAdmittedClaimSlotChildPids[slot] = -1
    productionAdmittedClaimSlotChildUids[slot] = uint32(0)
    productionAdmittedClaimSlotChildGids[slot] = uint32(0)
    productionAdmittedClaimSlotAdmittedCids[slot] = ""
    productionAdmittedClaimSlotLeaseCids[slot] = ""
    productionAdmittedClaimSlotRootBindingCids[slot] = ""
    productionAdmittedClaimSlotHeldBundleCids[slot] = ""
    productionAdmittedClaimSlotActivationBytes[slot] = ""
    productionAdmittedClaimSlotRequestIdentityCids[slot] = ""
    productionAdmittedClaimSlotClaimReceiptCids[slot] = ""
    productionAdmittedClaimSlotOwnerClaimReceiptCids[slot] = ""
    productionAdmittedClaimOwnerCapsules[ownerRow] = -1
    productionAdmittedClaimOwnerSessions[ownerRow] = -1
    atomic.StoreI32(
        productionAdmittedClaimOwnerStates[ownerRow],
        ProductionAdmittedClaimOwnerRetired)
    atomic.StoreI32(productionAdmittedClaimSlotOwnerLocks[slot], 0)
    system.RuntimeAtomicStoreI32(
        productionAdmittedClaimState, ProductionAdmittedClaimStateRetired)
    err = ""
    return true

# The live provider transition and its durable marker are one journal-owned
# continuation from FINISHED.  The caller supplies only the journal owner;
# HEAD fence, claim owner, runtime session, decision and provider receipt are
# recovered from private immutable SoA rows.
fn ProductionTerminalJournalFinalizeProviderFromFinishedInto(
        journalOwner: int32,
        outDecisionOwner: var int32,
        err: var str): bool =
    outDecisionOwner = -1
    if journalOwner <= 0 ||
       journalOwner > ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil:
        err = "production_terminal_journal_finalize_owner_invalid"
        return false
    let row = journalOwner - 1
    if row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalRecoveredRows[row] != 0:
        err = "production_terminal_journal_finalize_owner_invalid"
        return false
    var state = atomic.LoadI32(productionTerminalJournalStates[row])
    if state == ProductionTerminalJournalStateFinished:
        var decisionRecordReceiptCid: str
        if !productionTerminalJournalAppendDecisionInto(
               journalOwner, decisionRecordReceiptCid, err):
            return false
        state = atomic.LoadI32(productionTerminalJournalStates[row])
    let decisionOwner = productionTerminalJournalDecisionOwners[row]
    if state != ProductionTerminalJournalStateDecision ||
       decisionOwner <= 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0:
        err = "production_terminal_journal_finalize_decision_invalid"
        return false
    var providerReceiptCid: str
    if !productionTerminalJournalProviderReceiptCidInto(
           row, providerReceiptCid) ||
       !productionAdmittedClaimAuthorityFinalizeDurableDecisionInto(
           productionTerminalJournalDurableClaimOwners[row],
           productionTerminalJournalRuntimeSessions[row],
           productionTerminalJournalDecisions[row],
           err):
        if err.len == 0:
            err = "production_terminal_journal_provider_finalize_invalid"
        return false
    var providerFinalizedRecordReceiptCid: str
    if !productionTerminalJournalAppendProviderFinalizedInto(
           journalOwner,
           providerReceiptCid,
           providerFinalizedRecordReceiptCid,
           err):
        return false
    outDecisionOwner = decisionOwner
    err = ""
    return true

# The journal owns every authority needed for both terminal transports.  It
# first installs the exact durable fourth-frame bytes in the read-only child
# mirror, then consumes the same decision owner once for the socket send.
# No decision owner or durability witness is accepted from the caller.
fn ProductionTerminalJournalMirrorAndSendDecisionInto(
        journalOwner: int32,
        err: var str): bool =
    let row = productionTerminalJournalRowForHandle(
        journalOwner, ProductionTerminalJournalStateProviderFinalized)
    if row < 0 || productionTerminalJournalRecoveredRows[row] != 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0 ||
       productionTerminalJournalProviderProofOwners[row] <= 0 ||
       productionTerminalJournalDecisionOwners[row] != row + 1:
        err = "production_terminal_journal_decision_transport_owner_invalid"
        return false
    let priorOwnerState = atomic.LoadI32(
        productionTerminalJournalDecisionOwnerStates[row])
    if priorOwnerState == ProductionTerminalJournalDecisionOwnerTaken:
        err = ""
        return true
    if priorOwnerState != ProductionTerminalJournalDecisionOwnerLive ||
       !atomic.CasI32(
           productionTerminalJournalDecisionOwnerStates[row],
           ProductionTerminalJournalDecisionOwnerLive,
           ProductionTerminalJournalDecisionOwnerSending):
        err = "production_terminal_journal_decision_transport_state_invalid"
        return false
    var projectedCanonical: str
    var projectedCanonicalCid: str
    let canonical = productionTerminalJournalDecisionCanonicals[row]
    let canonicalValid =
        system.RuntimeHeldExecTerminalTransportProjectDecisionCanonicalInto(
            productionTerminalJournalProviderProofOwners[row],
            projectedCanonical) &&
        projectedCanonical == canonical &&
        productionTerminalJournalDecisionCanonicalStrictInto(
            canonical,
            productionTerminalJournalDecisions[row],
            productionTerminalJournalClaimReceiptCids[row],
            productionTerminalJournalTerminalReceiptCids[row],
            productionTerminalJournalOwnerClaimReceiptCids[row],
            projectedCanonicalCid) &&
        projectedCanonicalCid ==
            productionTerminalJournalDecisionCanonicalCids[row]
    if !canonicalValid ||
       !csgStoreTerminalJournalRootOwnerInstallDecisionMirrorInto(
           productionTerminalJournalRootOwnerHandles[row],
           canonical,
           err):
        atomic.StoreI32(
            productionTerminalJournalDecisionOwnerStates[row],
            ProductionTerminalJournalDecisionOwnerLive)
        if err.len == 0:
            err = "production_terminal_journal_decision_transport_projection_invalid"
        return false
    let sent = system.RuntimeHeldExecTerminalTransportSendDecision(
        productionTerminalJournalProviderProofOwners[row])
    if sent.status != 1 ||
       sent.session != productionTerminalJournalProviderProofOwners[row]:
        atomic.StoreI32(
            productionTerminalJournalDecisionOwnerStates[row],
            ProductionTerminalJournalDecisionOwnerLive)
        err = "production_terminal_journal_decision_socket_send_failed"
        return false
    var sentCanonical: str
    if !system.RuntimeHeldExecTerminalTransportProjectDecisionCanonicalInto(
           productionTerminalJournalProviderProofOwners[row],
           sentCanonical) ||
       sentCanonical != canonical:
        atomic.StoreI32(
            productionTerminalJournalDecisionOwnerStates[row],
            ProductionTerminalJournalDecisionOwnerTaken)
        panic("production terminal journal: sent canonical drift")
    atomic.StoreI32(
        productionTerminalJournalDecisionOwnerStates[row],
        ProductionTerminalJournalDecisionOwnerTaken)
    err = ""
    return true

fn productionTerminalJournalBindDurablePrefixInto(
        row: int32,
        expectedPhase: int32,
        err: var str): bool =
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       (expectedPhase != ProductionTerminalJournalObservationPhaseExit &&
        expectedPhase != ProductionTerminalJournalObservationPhaseReap) ||
       productionTerminalJournalProviderProofOwners[row] <= 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0:
        err = "production_terminal_journal_bind_identity_invalid"
        return false
    if productionTerminalJournalBindOwners[row] > 0:
        if productionTerminalJournalBindPhases[row] != expectedPhase:
            err = "production_terminal_journal_bind_phase_drift"
            return false
        err = ""
        return true
    var permission0: int32
    var permission1: int32
    var permission2: int32
    var permission3: int32
    var predecessorReceiptCid: str
    var evidenceBReceiptCid: str
    if expectedPhase == ProductionTerminalJournalObservationPhaseExit:
        permission0 = productionTerminalJournalExitPermission0[row]
        permission1 = productionTerminalJournalExitPermission1[row]
        permission2 = productionTerminalJournalExitPermission2[row]
        permission3 = productionTerminalJournalExitPermission3[row]
        productionTerminalJournalExitPermission0[row] = 0
        productionTerminalJournalExitPermission1[row] = 0
        productionTerminalJournalExitPermission2[row] = 0
        productionTerminalJournalExitPermission3[row] = 0
        predecessorReceiptCid = strings.CloneStr(
            productionTerminalJournalProviderFinalizedRecordReceiptCids[row])
        evidenceBReceiptCid = strings.CloneStr(
            productionTerminalJournalDecisionRecordReceiptCids[row])
    else:
        permission0 = productionTerminalJournalReapPermission0[row]
        permission1 = productionTerminalJournalReapPermission1[row]
        permission2 = productionTerminalJournalReapPermission2[row]
        permission3 = productionTerminalJournalReapPermission3[row]
        productionTerminalJournalReapPermission0[row] = 0
        productionTerminalJournalReapPermission1[row] = 0
        productionTerminalJournalReapPermission2[row] = 0
        productionTerminalJournalReapPermission3[row] = 0
        predecessorReceiptCid = strings.CloneStr(
            productionTerminalJournalExitObservedRecordReceiptCids[row])
        evidenceBReceiptCid = strings.CloneStr(
            productionTerminalJournalExitObservationReceiptCids[row])
    var bindOwner: int32
    var commitPermission0: int32
    var commitPermission1: int32
    var commitPermission2: int32
    var commitPermission3: int32
    if !system.RuntimeHeldExecTerminalObservationBindDurablePrefixInto(
           productionTerminalJournalProviderProofOwners[row],
           productionTerminalJournalRuntimeSessions[row],
           expectedPhase,
           permission0,
           permission1,
           permission2,
           permission3,
           productionTerminalJournalSessionCids[row],
           predecessorReceiptCid,
           evidenceBReceiptCid,
           bindOwner,
           commitPermission0,
           commitPermission1,
           commitPermission2,
           commitPermission3):
        if expectedPhase == ProductionTerminalJournalObservationPhaseExit:
            productionTerminalJournalExitPermission0[row] = permission0
            productionTerminalJournalExitPermission1[row] = permission1
            productionTerminalJournalExitPermission2[row] = permission2
            productionTerminalJournalExitPermission3[row] = permission3
        else:
            productionTerminalJournalReapPermission0[row] = permission0
            productionTerminalJournalReapPermission1[row] = permission1
            productionTerminalJournalReapPermission2[row] = permission2
            productionTerminalJournalReapPermission3[row] = permission3
        err = "production_terminal_journal_bind_failed"
        return false
    productionTerminalJournalBindOwners[row] = bindOwner
    productionTerminalJournalBindPhases[row] = expectedPhase
    productionTerminalJournalCommitPermission0[row] = commitPermission0
    productionTerminalJournalCommitPermission1[row] = commitPermission1
    productionTerminalJournalCommitPermission2[row] = commitPermission2
    productionTerminalJournalCommitPermission3[row] = commitPermission3
    commitPermission0 = 0
    commitPermission1 = 0
    commitPermission2 = 0
    commitPermission3 = 0
    err = ""
    return true

# The runtime mints the append authority only after this journal has moved a
# one-shot bind owner and fresh commit permission through the public boundary.
@borrows
fn productionTerminalJournalCommitDurableAppendInto(
        row: int32,
        expectedPhase: int32,
        projectedCanonicalCid: str,
        durableRecordCanonical: str,
        durableRecordReceiptCid: str,
        err: var str): bool =
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       (expectedPhase != ProductionTerminalJournalObservationPhaseExit &&
        expectedPhase != ProductionTerminalJournalObservationPhaseReap):
        err = "production_terminal_journal_durable_append_identity_invalid"
        return false
    if !productionTerminalJournalBindDurablePrefixInto(
           row, expectedPhase, err):
        return false
    if productionTerminalJournalProviderProofOwners[row] <= 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0 ||
       productionTerminalJournalObservationOwners[row] <= 0 ||
       productionTerminalJournalBindOwners[row] <= 0 ||
       productionTerminalJournalBindPhases[row] != expectedPhase ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           projectedCanonicalCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           durableRecordReceiptCid) ||
       durableRecordCanonical.len != ProductionTerminalJournalRecordBytes ||
       durableRecordCanonical !=
           productionTerminalJournalDurableObservationRecordCanonical[row] ||
       productionTerminalJournalTextU64(
           productionTerminalJournalProjectedObservationCanonical[row],
           16) != uint64(expectedPhase):
        err = "production_terminal_journal_durable_append_identity_invalid"
        return false
    if productionTerminalJournalDurableAppendOwners[row] > 0:
        err = ""
        return true
    var bindOwner = productionTerminalJournalBindOwners[row]
    var commitPermission0 = productionTerminalJournalCommitPermission0[row]
    var commitPermission1 = productionTerminalJournalCommitPermission1[row]
    var commitPermission2 = productionTerminalJournalCommitPermission2[row]
    var commitPermission3 = productionTerminalJournalCommitPermission3[row]
    productionTerminalJournalBindOwners[row] = -1
    productionTerminalJournalBindPhases[row] = 0
    productionTerminalJournalCommitPermission0[row] = 0
    productionTerminalJournalCommitPermission1[row] = 0
    productionTerminalJournalCommitPermission2[row] = 0
    productionTerminalJournalCommitPermission3[row] = 0
    var durableAppendOwner: int32
    if !system.RuntimeHeldExecTerminalObservationCommitDurableAppendInto(
           bindOwner,
           productionTerminalJournalRuntimeSessions[row],
           commitPermission0,
           commitPermission1,
           commitPermission2,
           commitPermission3,
           productionTerminalJournalObservationOwners[row],
           projectedCanonicalCid,
           durableRecordCanonical,
           durableRecordReceiptCid,
           durableAppendOwner) ||
       durableAppendOwner <= 0:
        productionTerminalJournalBindOwners[row] = bindOwner
        productionTerminalJournalBindPhases[row] = expectedPhase
        productionTerminalJournalCommitPermission0[row] = commitPermission0
        productionTerminalJournalCommitPermission1[row] = commitPermission1
        productionTerminalJournalCommitPermission2[row] = commitPermission2
        productionTerminalJournalCommitPermission3[row] = commitPermission3
        err = "production_terminal_journal_durable_append_commit_failed"
        return false
    productionTerminalJournalDurableAppendOwners[row] = durableAppendOwner
    err = ""
    return true

@borrows
fn productionTerminalJournalAppendExitObservedInto(
        handle: int32,
        observationCanonical: str,
        outProjectedCanonicalCid: var str,
        outDurableRecordCanonical: var str,
        outExitObservedRecordReceiptCid: var str,
        err: var str): bool =
    outProjectedCanonicalCid = ""
    outDurableRecordCanonical = ""
    outExitObservedRecordReceiptCid = ""
    let row = productionTerminalJournalRowForHandle(
        handle, ProductionTerminalJournalStateProviderFinalized)
    var exitObservationReceiptCid: str
    if row < 0 ||
       !productionTerminalJournalObservationCanonicalStrictInto(
           row,
           observationCanonical,
           ProductionTerminalJournalObservationPhaseExit,
           outProjectedCanonicalCid,
           exitObservationReceiptCid):
        err = "production_terminal_journal_exit_observation_identity_invalid"
        return false
    let staged =
        productionTerminalJournalProjectedObservationCanonical[row]
    if staged.len > 0 && staged != observationCanonical:
        err = "production_terminal_journal_exit_observation_projection_drift"
        return false
    if staged.len == 0:
        productionTerminalJournalProjectedObservationCanonical[row] =
            strings.CloneStr(observationCanonical)
    productionTerminalJournalObservationCanonical[row] =
        strings.CloneStr(observationCanonical)
    if !productionTerminalJournalAppendDerivedInto(
           row,
           ProductionTerminalJournalStateProviderFinalized,
           ProductionTerminalJournalStateWritingExitObserved,
           ProductionTerminalJournalStateExitObserved,
           ProductionTerminalJournalPhaseExitObserved,
           productionTerminalJournalDecisions[row],
           productionTerminalJournalProviderFinalizedRecordReceiptCids[row],
           exitObservationReceiptCid,
           productionTerminalJournalDecisionRecordReceiptCids[row],
           "",
           outDurableRecordCanonical,
           outExitObservedRecordReceiptCid,
           err):
        return false
    productionTerminalJournalExitObservationReceiptCids[row] =
        strings.CloneStr(exitObservationReceiptCid)
    productionTerminalJournalExitObservedRecordReceiptCids[row] =
        strings.CloneStr(outExitObservedRecordReceiptCid)
    if !productionTerminalJournalCommitDurableAppendInto(
           row,
           ProductionTerminalJournalObservationPhaseExit,
           outProjectedCanonicalCid,
           outDurableRecordCanonical,
           outExitObservedRecordReceiptCid,
           err):
        return false
    err = ""
    return true

@borrows
fn productionTerminalJournalAppendReapedInto(
        handle: int32,
        observationCanonical: str,
        outProjectedCanonicalCid: var str,
        outDurableRecordCanonical: var str,
        outReapedRecordReceiptCid: var str,
        err: var str): bool =
    outProjectedCanonicalCid = ""
    outDurableRecordCanonical = ""
    outReapedRecordReceiptCid = ""
    let row = productionTerminalJournalRowForHandle(
        handle, ProductionTerminalJournalStateExitObserved)
    var reapReceiptCid: str
    if row < 0 ||
       !productionTerminalJournalObservationCanonicalStrictInto(
           row,
           observationCanonical,
           ProductionTerminalJournalObservationPhaseReap,
           outProjectedCanonicalCid,
           reapReceiptCid) ||
       reapReceiptCid ==
           productionTerminalJournalExitObservationReceiptCids[row]:
        err = "production_terminal_journal_reap_observation_identity_invalid"
        return false
    let staged =
        productionTerminalJournalProjectedObservationCanonical[row]
    if staged.len > 0 && staged != observationCanonical:
        err = "production_terminal_journal_reap_observation_projection_drift"
        return false
    if staged.len == 0:
        productionTerminalJournalProjectedObservationCanonical[row] =
            strings.CloneStr(observationCanonical)
    productionTerminalJournalObservationCanonical[row] =
        strings.CloneStr(observationCanonical)
    if !productionTerminalJournalAppendDerivedInto(
           row,
           ProductionTerminalJournalStateExitObserved,
           ProductionTerminalJournalStateWritingReaped,
           ProductionTerminalJournalStateReaped,
           ProductionTerminalJournalPhaseReaped,
           productionTerminalJournalDecisions[row],
           productionTerminalJournalExitObservedRecordReceiptCids[row],
           reapReceiptCid,
           productionTerminalJournalExitObservationReceiptCids[row],
           "",
           outDurableRecordCanonical,
           outReapedRecordReceiptCid,
           err):
        return false
    productionTerminalJournalReapReceiptCids[row] =
        strings.CloneStr(reapReceiptCid)
    productionTerminalJournalReapedRecordReceiptCids[row] =
        strings.CloneStr(outReapedRecordReceiptCid)
    if !productionTerminalJournalCommitDurableAppendInto(
           row,
           ProductionTerminalJournalObservationPhaseReap,
           outProjectedCanonicalCid,
           outDurableRecordCanonical,
           outReapedRecordReceiptCid,
           err):
        return false
    err = ""
    return true

fn productionTerminalJournalAckObservationInto(
        row: int32,
        expectedPhase: int32,
        err: var str): bool =
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       productionTerminalJournalObservationOwners[row] <= 0 ||
       productionTerminalJournalDurableAppendOwners[row] <= 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0 ||
       productionTerminalJournalDurableObservationRecordCanonical[row].len !=
           ProductionTerminalJournalRecordBytes ||
       productionTerminalJournalTextU64(
           productionTerminalJournalProjectedObservationCanonical[row],
           16) != uint64(expectedPhase):
        err = "production_terminal_journal_observation_ack_identity_invalid"
        return false
    var observationOwner =
        productionTerminalJournalObservationOwners[row]
    var durableAppendOwner =
        productionTerminalJournalDurableAppendOwners[row]
    var retireOwner: int32 = -1
    productionTerminalJournalObservationOwners[row] = -1
    productionTerminalJournalDurableAppendOwners[row] = -1
    if !system.RuntimeHeldExecTerminalObservationAckInto(
           productionTerminalJournalRuntimeSessions[row],
           observationOwner,
           durableAppendOwner,
           retireOwner):
        err = "production_terminal_journal_observation_ack_failed"
        return false
    if (expectedPhase == ProductionTerminalJournalObservationPhaseReap &&
        retireOwner <= 0) ||
       (expectedPhase == ProductionTerminalJournalObservationPhaseExit &&
        retireOwner != -1):
        panic("production terminal journal retire owner phase drift")
    if retireOwner > 0:
        if productionTerminalJournalRetireOwners[row] > 0 ||
           productionTerminalJournalCloseReadyOwners[row] > 0:
            panic("production terminal journal duplicate retire owner")
        productionTerminalJournalRetireOwners[row] = retireOwner
        retireOwner = -1
    productionTerminalJournalProjectedObservationCanonical[row] = ""
    productionTerminalJournalDurableObservationRecordCanonical[row] = ""
    err = ""
    return true

fn ProductionTerminalJournalObserveExitFromProviderFinalizedInto(
        journalOwner: int32,
        err: var str): bool =
    let row = journalOwner - 1
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil ||
       row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalRecoveredRows[row] != 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0:
        err = "production_terminal_journal_exit_observation_state_invalid"
        return false
    let state = atomic.LoadI32(productionTerminalJournalStates[row])
    if state == ProductionTerminalJournalStateExitObserved &&
       productionTerminalJournalObservationOwners[row] > 0:
        var projectedCanonicalCid: str
        var evidenceCid: str
        if !productionTerminalJournalObservationCanonicalStrictInto(
               row,
               productionTerminalJournalProjectedObservationCanonical[row],
               ProductionTerminalJournalObservationPhaseExit,
               projectedCanonicalCid,
               evidenceCid) ||
           evidenceCid !=
               productionTerminalJournalExitObservationReceiptCids[row]:
            err = "production_terminal_journal_exit_observation_resume_invalid"
            return false
        if productionTerminalJournalDurableAppendOwners[row] <= 0 &&
           !productionTerminalJournalCommitDurableAppendInto(
               row,
               ProductionTerminalJournalObservationPhaseExit,
               projectedCanonicalCid,
               productionTerminalJournalDurableObservationRecordCanonical[
                   row],
               productionTerminalJournalExitObservedRecordReceiptCids[row],
               err):
            return false
        return productionTerminalJournalAckObservationInto(
            row,
            ProductionTerminalJournalObservationPhaseExit,
            err)
    if state != ProductionTerminalJournalStateProviderFinalized:
        err = "production_terminal_journal_exit_observation_state_invalid"
        return false
    if productionTerminalJournalObservationOwners[row] <= 0:
        let observationOwner =
            system.RuntimeHeldExecParentTerminalObserveExit(
                productionTerminalJournalRuntimeSessions[row])
        if observationOwner <= 0:
            err = "production_terminal_journal_exit_observation_runtime_failed"
            return false
        productionTerminalJournalObservationOwners[row] = observationOwner
    var observationCanonical: str
    if !system.RuntimeHeldExecTerminalObservationProjectCanonicalInto(
           productionTerminalJournalRuntimeSessions[row],
           productionTerminalJournalObservationOwners[row],
           observationCanonical):
        err = "production_terminal_journal_exit_observation_project_failed"
        return false
    var projectedCanonicalCid: str
    var durableRecordCanonical: str
    var durableRecordReceiptCid: str
    if !productionTerminalJournalAppendExitObservedInto(
           journalOwner,
           observationCanonical,
           projectedCanonicalCid,
           durableRecordCanonical,
           durableRecordReceiptCid,
           err):
        return false
    return productionTerminalJournalAckObservationInto(
        row,
        ProductionTerminalJournalObservationPhaseExit,
        err)

fn ProductionTerminalJournalReapFromExitObservedInto(
        journalOwner: int32,
        err: var str): bool =
    let row = journalOwner - 1
    if row < 0 || row >= ProductionTerminalJournalRowCount ||
       productionTerminalJournalNextRow == nil ||
       row >= atomic.LoadI32(productionTerminalJournalNextRow) ||
       productionTerminalJournalRecoveredRows[row] != 0 ||
       productionTerminalJournalRuntimeSessions[row] <= 0:
        err = "production_terminal_journal_reap_observation_state_invalid"
        return false
    let state = atomic.LoadI32(productionTerminalJournalStates[row])
    if state == ProductionTerminalJournalStateReaped &&
       productionTerminalJournalObservationOwners[row] > 0:
        var projectedCanonicalCid: str
        var evidenceCid: str
        if !productionTerminalJournalObservationCanonicalStrictInto(
               row,
               productionTerminalJournalProjectedObservationCanonical[row],
               ProductionTerminalJournalObservationPhaseReap,
               projectedCanonicalCid,
               evidenceCid) ||
           evidenceCid != productionTerminalJournalReapReceiptCids[row]:
            err = "production_terminal_journal_reap_observation_resume_invalid"
            return false
        if productionTerminalJournalDurableAppendOwners[row] <= 0 &&
           !productionTerminalJournalCommitDurableAppendInto(
               row,
               ProductionTerminalJournalObservationPhaseReap,
               projectedCanonicalCid,
               productionTerminalJournalDurableObservationRecordCanonical[
                   row],
               productionTerminalJournalReapedRecordReceiptCids[row],
               err):
            return false
        return productionTerminalJournalAckObservationInto(
            row,
            ProductionTerminalJournalObservationPhaseReap,
            err)
    if state != ProductionTerminalJournalStateExitObserved:
        err = "production_terminal_journal_reap_observation_state_invalid"
        return false
    if productionTerminalJournalObservationOwners[row] <= 0:
        let observationOwner =
            system.RuntimeHeldExecParentTerminalReap(
                productionTerminalJournalRuntimeSessions[row])
        if observationOwner <= 0:
            err = "production_terminal_journal_reap_observation_runtime_failed"
            return false
        productionTerminalJournalObservationOwners[row] = observationOwner
    var observationCanonical: str
    if !system.RuntimeHeldExecTerminalObservationProjectCanonicalInto(
           productionTerminalJournalRuntimeSessions[row],
           productionTerminalJournalObservationOwners[row],
           observationCanonical):
        err = "production_terminal_journal_reap_observation_project_failed"
        return false
    var projectedCanonicalCid: str
    var durableRecordCanonical: str
    var durableRecordReceiptCid: str
    if !productionTerminalJournalAppendReapedInto(
           journalOwner,
           observationCanonical,
           projectedCanonicalCid,
           durableRecordCanonical,
           durableRecordReceiptCid,
           err):
        return false
    return productionTerminalJournalAckObservationInto(
        row,
        ProductionTerminalJournalObservationPhaseReap,
        err)

fn productionTerminalJournalReleaseTerminalRegistriesAfterDrain(): bool =
    os.CsgCurrentHeadLeaseRegistryLock()
    let journalRows = productionTerminalJournalNextRow == nil ? 0 :
        atomic.LoadI32(productionTerminalJournalNextRow)
    for row in 0..<journalRows:
        let state = atomic.LoadI32(productionTerminalJournalStates[row])
        if state != ProductionTerminalJournalStateEmpty &&
           state != ProductionTerminalJournalStateDetached:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    let rootRows = csgStoreTerminalJournalRootOwnerNextRow == nil ? 0 :
        atomic.LoadI32(csgStoreTerminalJournalRootOwnerNextRow)
    for row in 0..<rootRows:
        let state = atomic.LoadI32(
            csgStoreTerminalJournalRootOwnerStates[row])
        if state != csgStoreTerminalJournalRootOwnerEmpty &&
           state != csgStoreTerminalJournalRootOwnerClosed:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    let claimRows = productionAdmittedClaimNextOwnerRow == nil ? 0 :
        atomic.LoadI32(productionAdmittedClaimNextOwnerRow)
    for row in 0..<claimRows:
        let state = atomic.LoadI32(productionAdmittedClaimOwnerStates[row])
        if state != 0 && state != ProductionAdmittedClaimOwnerAborted &&
           state != ProductionAdmittedClaimOwnerRetired:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    let capsuleRows = productionHeldExecTerminalCapsuleNextRow == nil ? 0 :
        atomic.LoadI32(productionHeldExecTerminalCapsuleNextRow)
    for row in 0..<capsuleRows:
        let state = atomic.LoadI32(
            productionHeldExecTerminalCapsuleStates[row])
        if state != 0 &&
           state != ProductionHeldExecTerminalCapsuleStateAborted &&
           state != ProductionHeldExecTerminalCapsuleStateRetired:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    for row in 0..<csgStoreHeadLeaseStates.len:
        if csgStoreHeadLeaseStates[row] != csgStoreHeadLeaseEmpty:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    for row in 0..<csgStoreTerminalRecoveryRegistryStates.len:
        let state = csgStoreTerminalRecoveryRegistryStates[row]
        if (state != csgStoreTerminalRecoveryRegistryEmpty &&
            state != csgStoreTerminalRecoveryRegistryReady) ||
           csgStoreTerminalRecoveryRegistryLockOwners[row] != -1:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    productionTerminalJournalStates = []
    productionTerminalJournalRootOwnerHandles = []
    productionTerminalJournalSessionCids = []
    productionTerminalJournalClaimReceiptCids = []
    productionTerminalJournalOwnerClaimReceiptCids = []
    productionTerminalJournalClaimedRecordReceiptCids = []
    productionTerminalJournalTerminalReceiptCids = []
    productionTerminalJournalChildIdentityCids = []
    productionTerminalJournalFinishedUploadCids = []
    productionTerminalJournalFinishedRecordReceiptCids = []
    productionTerminalJournalHeadFenceReceiptCids = []
    productionTerminalJournalDecisionRecordReceiptCids = []
    productionTerminalJournalDecisionCanonicalCids = []
    productionTerminalJournalDecisionCanonicals = []
    productionTerminalJournalExitObservationReceiptCids = []
    productionTerminalJournalExitObservedRecordReceiptCids = []
    productionTerminalJournalReapReceiptCids = []
    productionTerminalJournalReapedRecordReceiptCids = []
    productionTerminalJournalProviderReceiptCids = []
    productionTerminalJournalProviderFinalizedRecordReceiptCids = []
    productionTerminalJournalDecisions = []
    productionTerminalJournalDecisionOwners = []
    productionTerminalJournalDecisionOwnerStates = []
    productionTerminalJournalOutputByteCounts = []
    productionTerminalJournalWorkloadExitCodes = []
    productionTerminalJournalRuntimeSessions = []
    productionTerminalJournalDurableClaimOwners = []
    productionTerminalJournalProviderProofOwners = []
    productionTerminalJournalExitPermission0 = []
    productionTerminalJournalExitPermission1 = []
    productionTerminalJournalExitPermission2 = []
    productionTerminalJournalExitPermission3 = []
    productionTerminalJournalReapPermission0 = []
    productionTerminalJournalReapPermission1 = []
    productionTerminalJournalReapPermission2 = []
    productionTerminalJournalReapPermission3 = []
    productionTerminalJournalBindOwners = []
    productionTerminalJournalBindPhases = []
    productionTerminalJournalCommitPermission0 = []
    productionTerminalJournalCommitPermission1 = []
    productionTerminalJournalCommitPermission2 = []
    productionTerminalJournalCommitPermission3 = []
    productionTerminalJournalChildPids = []
