import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_store_codec

const
    CsgMerkleTransactionIdentitySchema: str =
        "csg_core::v1"
    CsgMerkleTransactionRequestDomain: str =
        "csg_core.store.transaction_request"
    CsgMerkleTransactionPlanDomain: str =
        "csg_core.store.transaction_plan"
    CsgMerkleSemanticPlanDomain: str =
        "csg_core.semantic_plan.v1"
    CsgMerkleTransactionRequestMaxSourceCount: int32 =
        131072
    CsgMerkleTransactionRequestMaxFactCount: int32 =
        131072
    CsgMerkleTransactionRequestMaxDependencyCount: int32 =
        524288
    CsgMerkleTransactionRequestMaxLineCount: int32 =
        655361
    CsgMerkleTransactionRequestMaxLineBytes: int64 =
        67108864

type
    CsgCoreMerkleTransactionRequestFact =
        factKey: str
        factCid: str

    CsgCoreMerkleTransactionRequestDependency =
        providerSource: str
        providerFactKind: str
        selector: str

    CsgCoreMerkleTransactionRequestReplacement =
        sourceId: str
        sourceCid: str
        facts: CsgCoreMerkleTransactionRequestFact[]
        dependencies:
            CsgCoreMerkleTransactionRequestDependency[]

    CsgCoreMerkleTransactionRequest =
        expectedBeforeHeadCid: str
        changedSources: str[]
        replacements:
            CsgCoreMerkleTransactionRequestReplacement[]

    CsgCoreMerkleTransactionPlan =
        requestCid: str
        beforeHeadCid: str
        beforeManifestCid: str
        beforeCsgcDirectoryCid: str
        beforeFactsRoot: str
        beforeDagRootCid: str
        beforeFactCount: int32
        afterCsgcDirectoryCid: str
        afterFactsRoot: str
        afterDagRootCid: str
        afterFactCount: int32
        invalidationCid: str
        operationKinds: int32[]
        operationFactKeys: str[]
        operationCids: str[]

    CsgCoreMerkleTransactionRequestCidResult =
        ok: bool
        error: str
        requestCid: str
        factCount: int32
        lines: str[]
        bytes: rawbytes.Bytes

    CsgCoreMerkleTransactionRequestDecodeResult =
        ok: bool
        error: str
        requestCid: str
        factCount: int32
        request: CsgCoreMerkleTransactionRequest
        lines: str[]

    CsgCoreMerkleTransactionPlanRootResult =
        ok: bool
        error: str
        planRoot: str
        factCount: int32
        lines: str[]
        bytes: rawbytes.Bytes

    CsgCoreMerkleSemanticPlan =
        beforeStoreIdentity: str
        sealedBeforeContentCid: str
        beforeHeadCid: str
        beforeManifestCid: str
        beforeGeneration: int64
        requestCid: str
        invalidationPlanCid: str
        semanticManifestSkeletonCid: str
        operationCid: str
        proofCid: str
        semanticCarrierCid: str
        formatId: str

    CsgCoreMerkleSemanticPlanRootResult =
        ok: bool
        error: str
        planRoot: str

fn CsgCoreMerkleTransactionRequestSourceLimit(): int32 =
    return CsgMerkleTransactionRequestMaxSourceCount

fn CsgCoreMerkleTransactionRequestFactLimit(): int32 =
    return CsgMerkleTransactionRequestMaxFactCount

fn CsgCoreMerkleTransactionRequestDependencyLimit(): int32 =
    return CsgMerkleTransactionRequestMaxDependencyCount

fn CsgCoreMerkleTransactionRequestLineLimit(): int32 =
    return CsgMerkleTransactionRequestMaxLineCount

fn CsgCoreMerkleTransactionRequestLineByteLimit(): int64 =
    return CsgMerkleTransactionRequestMaxLineBytes

@borrows
fn csgRequestCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgRequestAppend(out: var str, value: str) =
    out = csgRequestCat(out, value)

@borrows
fn csgRequestJson(value: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(
        value)

@borrows
fn csgRequestTextCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgRequestTextOrder(values: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, values.len)
    setLen(scratch, values.len)
    for i in 0..<values.len:
        order[i] = i
    var width: int32 = 1
    while width < values.len:
        var base: int32
        while base < values.len:
            let remaining = values.len - base
            let leftWidth =
                remaining < width ? remaining : width
            let middle = base + leftWidth
            let rightRemaining = values.len - middle
            let rightWidth =
                rightRemaining < width ? rightRemaining : width
            let finish = middle + rightWidth
            var left = base
            var right = middle
            var at = base
            while left < middle && right < finish:
                if csgRequestTextCompare(
                       values[order[right]],
                       values[order[left]]) < 0:
                    scratch[at] = order[right]
                    right = right + 1
                else:
                    scratch[at] = order[left]
                    left = left + 1
                at = at + 1
            while left < middle:
                scratch[at] = order[left]
                left = left + 1
                at = at + 1
            while right < finish:
                scratch[at] = order[right]
                right = right + 1
                at = at + 1
            base = finish
        for i in 0..<values.len:
            order[i] = scratch[i]
        if width > values.len - width:
            width = values.len
        else:
            width = width + width
    return order

@borrows
fn csgRequestTuple(value: str): str =
    return csgRequestCat(
        csgRequestCat(strings.IntToStr(value.len), ":"),
        value)

@borrows
fn csgPlanOperationIdentity(
        operationKind: int32,
        operationFactKey: str): str =
    return csgRequestCat(
        csgRequestCat(
            strings.IntToStr(operationKind), "|"),
        csgRequestTuple(operationFactKey))

@borrows
fn csgRequestDependencyKey(
        dependency:
            CsgCoreMerkleTransactionRequestDependency): str =
    return csgRequestCat(
        csgRequestCat(
            csgRequestTuple(dependency.providerSource),
            csgRequestTuple(dependency.providerFactKind)),
        csgRequestTuple(dependency.selector))

@borrows
fn csgRequestIndexText(index: int32): str =
    if index < 0:
        return ""
    let raw = strings.IntToStr(index)
    if raw.len > 10:
        return ""
    var out: str
    for _ in 0..<(10 - raw.len):
        csgRequestAppend(out, "0")
    csgRequestAppend(out, raw)
    return out

@borrows
fn csgRequestIndexedId(
        prefix: str,
        index: int32): str =
    return csgRequestCat(
        prefix, csgRequestIndexText(index))

@borrows
fn csgRequestNestedId(
        prefix: str,
        first: int32,
        middle: str,
        second: int32): str =
    return csgRequestCat(
        csgRequestCat(
            csgRequestIndexedId(prefix, first),
            middle),
        csgRequestIndexText(second))

@borrows
fn csgRequestFail(
        error: str):
        CsgCoreMerkleTransactionRequestCidResult =
    var out: CsgCoreMerkleTransactionRequestCidResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgPlanFail(
        error: str):
        CsgCoreMerkleTransactionPlanRootResult =
    var out: CsgCoreMerkleTransactionPlanRootResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgRequestCidError(
        label: str,
        cid: str): str =
    if merkle_store_codec.CsgCoreMerkleStoreCidValid(
           cid):
        return ""
    return csgRequestCat(label, "_invalid")

@borrows
fn csgRequestLinesError(lines: str[]): str =
    if lines.len == 0:
        return "merkle_transaction_identity_empty"
    if lines.len > CsgMerkleTransactionRequestMaxLineCount:
        return "merkle_transaction_identity_line_count_limit_exceeded"
    var totalBytes: int64
    for i in 0..<lines.len:
        totalBytes = totalBytes + int64(lines[i].len)
        if totalBytes >
           CsgMerkleTransactionRequestMaxLineBytes:
            return "merkle_transaction_identity_line_bytes_limit_exceeded"
    return ""

@borrows
fn csgRequestError(
        request: CsgCoreMerkleTransactionRequest): str =
    let headError = csgRequestCidError(
        "merkle_transaction_request_expected_before_head_cid",
        request.expectedBeforeHeadCid)
    if headError.len > 0:
        return headError
    if request.changedSources.len >
           CsgMerkleTransactionRequestMaxSourceCount ||
       request.replacements.len >
           CsgMerkleTransactionRequestMaxSourceCount:
        return "merkle_transaction_request_source_count_limit_exceeded"

    let changedOrder =
        csgRequestTextOrder(request.changedSources)
    for rank in 0..<changedOrder.len:
        let sourceId =
            request.changedSources[changedOrder[rank]]
        if sourceId.len == 0:
            return "merkle_transaction_request_changed_source_invalid"
        if rank > 0 &&
           request.changedSources[changedOrder[rank - 1]] ==
               sourceId:
            return "merkle_transaction_request_changed_source_duplicate"

    var replacementKeys: str[]
    for i in 0..<request.replacements.len:
        add(
            replacementKeys,
            strings.CloneStr(
                request.replacements[i].sourceId))
    let replacementOrder =
        csgRequestTextOrder(replacementKeys)
    var factCount: int64
    var dependencyCount: int64
    for rank in 0..<replacementOrder.len:
        let replacement =
            request.replacements[replacementOrder[rank]]
        if replacement.sourceId.len == 0 ||
           replacement.facts.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               replacement.sourceCid):
            return "merkle_transaction_request_replacement_invalid"
        if rank > 0 &&
           request.replacements[
               replacementOrder[rank - 1]].sourceId ==
               replacement.sourceId:
            return "merkle_transaction_request_replacement_duplicate"
        factCount = factCount +
            int64(replacement.facts.len)
        dependencyCount = dependencyCount +
            int64(replacement.dependencies.len)
        if factCount >
           int64(CsgMerkleTransactionRequestMaxFactCount):
            return "merkle_transaction_request_fact_count_limit_exceeded"
        if dependencyCount >
           int64(CsgMerkleTransactionRequestMaxDependencyCount):
            return "merkle_transaction_request_dependency_count_limit_exceeded"

        var factKeys: str[]
        for i in 0..<replacement.facts.len:
            let fact = replacement.facts[i]
            if fact.factKey.len == 0 ||
               !merkle_store_codec.CsgCoreMerkleStoreCidValid(
                   fact.factCid):
                return "merkle_transaction_request_fact_invalid"
            add(factKeys, strings.CloneStr(fact.factKey))
        let factOrder = csgRequestTextOrder(factKeys)
        for i in 1..<factOrder.len:
            if factKeys[factOrder[i - 1]] ==
               factKeys[factOrder[i]]:
                return "merkle_transaction_request_fact_duplicate"

        var dependencyKeys: str[]
        for i in 0..<replacement.dependencies.len:
            let dependency = replacement.dependencies[i]
            if dependency.providerSource.len == 0 ||
               dependency.providerFactKind.len == 0 ||
               dependency.selector.len == 0:
                return "merkle_transaction_request_dependency_invalid"
            add(
                dependencyKeys,
                csgRequestDependencyKey(dependency))
        let dependencyOrder =
            csgRequestTextOrder(dependencyKeys)
        for i in 1..<dependencyOrder.len:
            if dependencyKeys[dependencyOrder[i - 1]] ==
               dependencyKeys[dependencyOrder[i]]:
                return "merkle_transaction_request_dependency_duplicate"

    let lineCount = int64(1) +
        int64(request.changedSources.len) +
        int64(request.replacements.len) +
        factCount + dependencyCount
    if lineCount >
       int64(CsgMerkleTransactionRequestMaxLineCount):
        return "merkle_transaction_request_line_count_limit_exceeded"
    return ""

@borrows
fn csgRequestHeaderLine(
        request: CsgCoreMerkleTransactionRequest): str =
    var out: str = "{\"changed_source_count\":"
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(
                request.changedSources.len)))
    csgRequestAppend(out, ",\"expected_before_head_cid\":")
    csgRequestAppend(
        out,
        csgRequestJson(request.expectedBeforeHeadCid))
    csgRequestAppend(out, ",\"id\":\"request\"")
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_request\"")
    csgRequestAppend(out, ",\"replacement_count\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(
                request.replacements.len)))
    csgRequestAppend(out, ",\"schema\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            CsgMerkleTransactionIdentitySchema))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgRequestChangedSourceLine(
        index: int32,
        sourceId: str): str =
    var out: str = "{\"id\":"
    csgRequestAppend(
        out,
        csgRequestJson(
            csgRequestIndexedId(
                "changed-source:", index)))
    csgRequestAppend(out, ",\"index\":")
    csgRequestAppend(
        out, csgRequestJson(strings.IntToStr(index)))
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_changed_source\"")
    csgRequestAppend(out, ",\"source_id\":")
    csgRequestAppend(out, csgRequestJson(sourceId))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgRequestReplacementLine(
        index: int32,
        replacement:
            CsgCoreMerkleTransactionRequestReplacement): str =
    var out: str = "{\"dependency_count\":"
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(
                replacement.dependencies.len)))
    csgRequestAppend(out, ",\"fact_count\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(replacement.facts.len)))
    csgRequestAppend(out, ",\"id\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            csgRequestIndexedId(
                "replacement:", index)))
    csgRequestAppend(out, ",\"index\":")
    csgRequestAppend(
        out, csgRequestJson(strings.IntToStr(index)))
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_replacement\"")
    csgRequestAppend(out, ",\"source_cid\":")
    csgRequestAppend(
        out, csgRequestJson(replacement.sourceCid))
    csgRequestAppend(out, ",\"source_id\":")
    csgRequestAppend(
        out, csgRequestJson(replacement.sourceId))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgRequestFactLine(
        sourceIndex: int32,
        factIndex: int32,
        fact: CsgCoreMerkleTransactionRequestFact): str =
    var out: str = "{\"fact_cid\":"
    csgRequestAppend(out, csgRequestJson(fact.factCid))
    csgRequestAppend(out, ",\"fact_index\":")
    csgRequestAppend(
        out,
        csgRequestJson(strings.IntToStr(factIndex)))
    csgRequestAppend(out, ",\"fact_key\":")
    csgRequestAppend(out, csgRequestJson(fact.factKey))
    csgRequestAppend(out, ",\"id\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            csgRequestNestedId(
                "replacement:", sourceIndex,
                ":fact:", factIndex)))
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_request_fact\"")
    csgRequestAppend(out, ",\"source_index\":")
    csgRequestAppend(
        out,
        csgRequestJson(strings.IntToStr(sourceIndex)))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgRequestDependencyLine(
        sourceIndex: int32,
        dependencyIndex: int32,
        dependency:
            CsgCoreMerkleTransactionRequestDependency): str =
    var out: str = "{\"dependency_index\":"
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(dependencyIndex)))
    csgRequestAppend(out, ",\"id\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            csgRequestNestedId(
                "replacement:", sourceIndex,
                ":dependency:", dependencyIndex)))
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_request_dependency\"")
    csgRequestAppend(out, ",\"provider_fact_kind\":")
    csgRequestAppend(
        out,
        csgRequestJson(dependency.providerFactKind))
    csgRequestAppend(out, ",\"provider_source\":")
    csgRequestAppend(
        out,
        csgRequestJson(dependency.providerSource))
    csgRequestAppend(out, ",\"selector\":")
    csgRequestAppend(
        out, csgRequestJson(dependency.selector))
    csgRequestAppend(out, ",\"source_index\":")
    csgRequestAppend(
        out,
        csgRequestJson(strings.IntToStr(sourceIndex)))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgRequestLines(
        request: CsgCoreMerkleTransactionRequest): str[] =
    var lines: str[]
    add(lines, csgRequestHeaderLine(request))

    let changedOrder =
        csgRequestTextOrder(request.changedSources)
    for rank in 0..<changedOrder.len:
        add(
            lines,
            csgRequestChangedSourceLine(
                rank,
                request.changedSources[
                    changedOrder[rank]]))

    var replacementKeys: str[]
    for i in 0..<request.replacements.len:
        add(
            replacementKeys,
            strings.CloneStr(
                request.replacements[i].sourceId))
    let replacementOrder =
        csgRequestTextOrder(replacementKeys)
    for sourceRank in 0..<replacementOrder.len:
        let replacement =
            request.replacements[
                replacementOrder[sourceRank]]
        add(
            lines,
            csgRequestReplacementLine(
                sourceRank, replacement))

        var factKeys: str[]
        for i in 0..<replacement.facts.len:
            add(
                factKeys,
                strings.CloneStr(
                    replacement.facts[i].factKey))
        let factOrder = csgRequestTextOrder(factKeys)
        for factRank in 0..<factOrder.len:
            add(
                lines,
                csgRequestFactLine(
                    sourceRank,
                    factRank,
                    replacement.facts[
                        factOrder[factRank]]))

        var dependencyKeys: str[]
        for i in 0..<replacement.dependencies.len:
            add(
                dependencyKeys,
                csgRequestDependencyKey(
                    replacement.dependencies[i]))
        let dependencyOrder =
            csgRequestTextOrder(dependencyKeys)
        for dependencyRank in
                0..<dependencyOrder.len:
            add(
                lines,
                csgRequestDependencyLine(
                    sourceRank,
                    dependencyRank,
                    replacement.dependencies[
                        dependencyOrder[
                            dependencyRank]]))
    return lines

@borrows
fn CsgCoreMerkleTransactionRequestCid(
        request: CsgCoreMerkleTransactionRequest):
        CsgCoreMerkleTransactionRequestCidResult =
    let requestError = csgRequestError(request)
    if requestError.len > 0:
        return csgRequestFail(requestError)
    let sourceLines = csgRequestLines(request)
    let linesError = csgRequestLinesError(sourceLines)
    if linesError.len > 0:
        return csgRequestFail(linesError)
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            sourceLines)
    if !encoded.ok:
        return csgRequestFail(
            csgRequestCat(
                "merkle_transaction_request_encode ",
                encoded.error))
    let canonical =
        csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !canonical.ok ||
       canonical.factCount != sourceLines.len:
        rawbytes.BytesFree(encoded.bytes)
        return csgRequestFail(
            "merkle_transaction_request_encode_self_check")
    let requestCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionRequestDomain,
            encoded.bytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           requestCid):
        rawbytes.BytesFree(encoded.bytes)
        return csgRequestFail(
            "merkle_transaction_request_cid_invalid")
    var out: CsgCoreMerkleTransactionRequestCidResult
    out.ok = true
    out.requestCid = strings.CloneStr(requestCid)
    out.factCount = canonical.factCount
    out.lines = canonical.lines
    out.bytes = encoded.bytes
    return out

@borrows
fn CsgCoreMerkleTransactionRequestArtifactCid(
        bytes: rawbytes.Bytes,
        error: var str): str =
    error = ""
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok || decoded.factCount <= 0 ||
       decoded.lines.len != decoded.factCount:
        error = "merkle_transaction_request_artifact_decode_failed"
        return ""
    var headerCount: int32
    for i in 0..<decoded.lines.len:
        let kind =
            field.CsgCoreJsonTopStringField(
                decoded.lines[i], "kind")
        let id =
            field.CsgCoreJsonTopStringField(
                decoded.lines[i], "id")
        if !kind.found || !id.found || id.value.len == 0:
            error =
                "merkle_transaction_request_artifact_fact_identity_invalid"
            return ""
        if kind.value ==
           "csg.merkle.transaction_request":
            let schema =
                field.CsgCoreJsonTopStringField(
                    decoded.lines[i], "schema")
            let expectedHead =
                field.CsgCoreJsonTopStringField(
                    decoded.lines[i],
                    "expected_before_head_cid")
            if id.value != "request" ||
               !schema.found ||
               schema.value !=
                   CsgMerkleTransactionIdentitySchema ||
               !expectedHead.found ||
               !merkle_store_codec.CsgCoreMerkleStoreCidValid(
                   expectedHead.value):
                error =
                    "merkle_transaction_request_artifact_header_invalid"
                return ""
            headerCount = headerCount + 1
        elif kind.value !=
                 "csg.merkle.transaction_changed_source" &&
             kind.value !=
                 "csg.merkle.transaction_replacement" &&
             kind.value !=
                 "csg.merkle.transaction_request_fact" &&
             kind.value !=
                 "csg.merkle.transaction_request_dependency":
            error =
                "merkle_transaction_request_artifact_kind_invalid"
            return ""
    if headerCount != 1:
        error =
            "merkle_transaction_request_artifact_header_count_invalid"
        return ""
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            decoded.lines)
    if !encoded.ok:
        error =
            "merkle_transaction_request_artifact_reencode_failed"
        return ""
    let canonical =
        rawbytes.BytesEqual(encoded.bytes, bytes)
    rawbytes.BytesFree(encoded.bytes)
    if !canonical:
        error =
            "merkle_transaction_request_artifact_non_canonical"
        return ""
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionRequestDomain,
            bytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(cid):
        error =
            "merkle_transaction_request_artifact_cid_invalid"
        return ""
    return cid

@borrows
fn csgRequestDecodeFail(
        error: str):
        CsgCoreMerkleTransactionRequestDecodeResult =
    var out: CsgCoreMerkleTransactionRequestDecodeResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgRequestStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgRequestNat32Field(
        line: str,
        name: str,
        out: var int32): bool =
    var text: str
    if !csgRequestStringField(line, name, text) ||
       !merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           text, out) ||
       out < 0 || text != strings.IntToStr(out):
        return false
    return true

@borrows
fn csgRequestDecodeHeader(
        line: str,
        request: var CsgCoreMerkleTransactionRequest,
        changedSourceCount: var int32,
        replacementCount: var int32): bool =
    var id: str
    var kind: str
    var schema: str
    if !csgRequestNat32Field(
           line,
           "changed_source_count",
           changedSourceCount) ||
       !csgRequestStringField(
           line,
           "expected_before_head_cid",
           request.expectedBeforeHeadCid) ||
       !csgRequestStringField(line, "id", id) ||
       !csgRequestStringField(line, "kind", kind) ||
       !csgRequestNat32Field(
           line,
           "replacement_count",
           replacementCount) ||
       !csgRequestStringField(line, "schema", schema):
        return false
    return id == "request" &&
        kind == "csg.merkle.transaction_request" &&
        schema == CsgMerkleTransactionIdentitySchema &&
        changedSourceCount <=
            CsgMerkleTransactionRequestMaxSourceCount &&
        replacementCount <=
            CsgMerkleTransactionRequestMaxSourceCount

@borrows
fn csgRequestDecodeChangedSource(
        line: str,
        expectedIndex: int32,
        sourceId: var str): bool =
    var id: str
    var index: int32
    var kind: str
    return csgRequestStringField(line, "id", id) &&
        csgRequestNat32Field(line, "index", index) &&
        csgRequestStringField(line, "kind", kind) &&
        csgRequestStringField(line, "source_id", sourceId) &&
        index == expectedIndex &&
        id == csgRequestIndexedId(
            "changed-source:", expectedIndex) &&
        kind == "csg.merkle.transaction_changed_source"

@borrows
fn csgRequestDecodeReplacement(
        line: str,
        expectedIndex: int32,
        replacement:
            var CsgCoreMerkleTransactionRequestReplacement,
        factCount: var int32,
        dependencyCount: var int32): bool =
    var id: str
    var index: int32
    var kind: str
    if !csgRequestNat32Field(
           line, "dependency_count", dependencyCount) ||
       !csgRequestNat32Field(
           line, "fact_count", factCount) ||
       !csgRequestStringField(line, "id", id) ||
       !csgRequestNat32Field(line, "index", index) ||
       !csgRequestStringField(line, "kind", kind) ||
       !csgRequestStringField(
           line, "source_cid", replacement.sourceCid) ||
       !csgRequestStringField(
           line, "source_id", replacement.sourceId):
        return false
    return index == expectedIndex &&
        id == csgRequestIndexedId(
            "replacement:", expectedIndex) &&
        kind == "csg.merkle.transaction_replacement" &&
        factCount <= CsgMerkleTransactionRequestMaxFactCount &&
        dependencyCount <=
            CsgMerkleTransactionRequestMaxDependencyCount

@borrows
fn csgRequestDecodeFact(
        line: str,
        sourceIndex: int32,
        factIndex: int32,
        fact: var CsgCoreMerkleTransactionRequestFact): bool =
    var id: str
    var parsedFactIndex: int32
    var parsedSourceIndex: int32
    var kind: str
    return csgRequestStringField(
            line, "fact_cid", fact.factCid) &&
        csgRequestNat32Field(
            line, "fact_index", parsedFactIndex) &&
        csgRequestStringField(
            line, "fact_key", fact.factKey) &&
        csgRequestStringField(line, "id", id) &&
        csgRequestStringField(line, "kind", kind) &&
        csgRequestNat32Field(
            line, "source_index", parsedSourceIndex) &&
        parsedFactIndex == factIndex &&
        parsedSourceIndex == sourceIndex &&
        id == csgRequestNestedId(
            "replacement:", sourceIndex,
            ":fact:", factIndex) &&
        kind == "csg.merkle.transaction_request_fact"

@borrows
fn csgRequestDecodeDependency(
        line: str,
        sourceIndex: int32,
        dependencyIndex: int32,
        dependency:
            var CsgCoreMerkleTransactionRequestDependency): bool =
    var id: str
    var parsedDependencyIndex: int32
    var parsedSourceIndex: int32
    var kind: str
    return csgRequestNat32Field(
            line,
            "dependency_index",
            parsedDependencyIndex) &&
        csgRequestStringField(line, "id", id) &&
        csgRequestStringField(line, "kind", kind) &&
        csgRequestStringField(
            line,
            "provider_fact_kind",
            dependency.providerFactKind) &&
        csgRequestStringField(
            line,
            "provider_source",
            dependency.providerSource) &&
        csgRequestStringField(
            line, "selector", dependency.selector) &&
        csgRequestNat32Field(
            line, "source_index", parsedSourceIndex) &&
        parsedDependencyIndex == dependencyIndex &&
        parsedSourceIndex == sourceIndex &&
        id == csgRequestNestedId(
            "replacement:", sourceIndex,
            ":dependency:", dependencyIndex) &&
        kind == "csg.merkle.transaction_request_dependency"

@borrows
fn CsgCoreMerkleTransactionRequestDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleTransactionRequestDecodeResult =
    let directory =
        csgc.CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        return csgRequestDecodeFail(
            csgRequestCat(
                "merkle_transaction_request_decode ",
                directory.error))
    if directory.factCount <= 0 ||
       directory.factCount >
           CsgMerkleTransactionRequestMaxLineCount:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_line_count_limit_exceeded")
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgRequestDecodeFail(
            csgRequestCat(
                "merkle_transaction_request_decode ",
                decoded.error))
    let linesError = csgRequestLinesError(decoded.lines)
    if linesError.len > 0 ||
       decoded.factCount != decoded.lines.len:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_lines_invalid")
    var request: CsgCoreMerkleTransactionRequest
    var changedSourceCount: int32
    var replacementCount: int32
    var headerIndex: int32 = -1
    var headerCount: int32
    var changedLines: int32[]
    var replacementLines: int32[]
    var factLines: int32[]
    var dependencyLines: int32[]
    var unknownKind: bool
    for i in 0..<decoded.lines.len:
        var kind: str
        if !csgRequestStringField(decoded.lines[i], "kind", kind):
            unknownKind = true
        elif kind == "csg.merkle.transaction_request":
            headerIndex = i
            headerCount = headerCount + 1
        elif kind == "csg.merkle.transaction_changed_source":
            add(changedLines, i)
        elif kind == "csg.merkle.transaction_replacement":
            add(replacementLines, i)
        elif kind == "csg.merkle.transaction_request_fact":
            add(factLines, i)
        elif kind == "csg.merkle.transaction_request_dependency":
            add(dependencyLines, i)
        else:
            unknownKind = true
    if headerCount != 1:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_header_invalid")
    if unknownKind:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_kind_invalid")
    if !csgRequestDecodeHeader(
           decoded.lines[headerIndex],
           request,
           changedSourceCount,
           replacementCount):
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_header_invalid")
    if changedLines.len != changedSourceCount:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_changed_source_count_mismatch")
    if replacementLines.len != replacementCount:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_replacement_count_mismatch")
    var changedSlots: int32[]
    setLen(changedSlots, changedSourceCount)
    for j in 0..<changedSourceCount:
        changedSlots[j] = -1
    for j in 0..<changedLines.len:
        var changedRank: int32
        if !csgRequestNat32Field(
               decoded.lines[changedLines[j]],
               "index",
               changedRank) ||
           changedRank >= changedSourceCount:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_changed_source_invalid")
        if changedSlots[changedRank] != -1:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_changed_source_invalid")
        changedSlots[changedRank] = changedLines[j]
    for changedIndex in 0..<changedSourceCount:
        var sourceId: str
        if !csgRequestDecodeChangedSource(
               decoded.lines[changedSlots[changedIndex]],
               changedIndex,
               sourceId):
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_changed_source_invalid")
        add(request.changedSources, sourceId)
    var replacementSlots: int32[]
    setLen(replacementSlots, replacementCount)
    for j in 0..<replacementCount:
        replacementSlots[j] = -1
    for j in 0..<replacementLines.len:
        var sourceRank: int32
        if !csgRequestNat32Field(
               decoded.lines[replacementLines[j]],
               "index",
               sourceRank) ||
           sourceRank >= replacementCount:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_replacement_invalid")
        if replacementSlots[sourceRank] != -1:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_replacement_invalid")
        replacementSlots[sourceRank] = replacementLines[j]
    var factCounts: int32[]
    var factBases: int32[]
    var dependencyCounts: int32[]
    var dependencyBases: int32[]
    setLen(factCounts, replacementCount)
    setLen(factBases, replacementCount)
    setLen(dependencyCounts, replacementCount)
    setLen(dependencyBases, replacementCount)
    var totalFacts: int64
    var totalDependencies: int64
    for sourceIndex in 0..<replacementCount:
        var counted: CsgCoreMerkleTransactionRequestReplacement
        var factCount: int32
        var dependencyCount: int32
        if !csgRequestDecodeReplacement(
               decoded.lines[replacementSlots[sourceIndex]],
               sourceIndex,
               counted,
               factCount,
               dependencyCount):
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_replacement_invalid")
        factBases[sourceIndex] = int32(totalFacts)
        dependencyBases[sourceIndex] = int32(totalDependencies)
        factCounts[sourceIndex] = factCount
        dependencyCounts[sourceIndex] = dependencyCount
        totalFacts = totalFacts + int64(factCount)
        totalDependencies =
            totalDependencies + int64(dependencyCount)
        if totalFacts >
               int64(CsgMerkleTransactionRequestMaxFactCount) ||
           totalDependencies >
               int64(CsgMerkleTransactionRequestMaxDependencyCount):
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_count_limit_exceeded")
    if int64(factLines.len) != totalFacts:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_fact_count_mismatch")
    if int64(dependencyLines.len) != totalDependencies:
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_dependency_count_mismatch")
    var factSlots: int32[]
    setLen(factSlots, int32(totalFacts))
    for j in 0..<int32(totalFacts):
        factSlots[j] = -1
    for j in 0..<factLines.len:
        var factSource: int32
        var factRank: int32
        if !csgRequestNat32Field(
               decoded.lines[factLines[j]],
               "source_index",
               factSource) ||
           !csgRequestNat32Field(
               decoded.lines[factLines[j]],
               "fact_index",
               factRank) ||
           factSource >= replacementCount:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_fact_invalid")
        if factRank >= factCounts[factSource]:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_fact_invalid")
        let factSlot = factBases[factSource] + factRank
        if factSlots[factSlot] != -1:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_fact_invalid")
        factSlots[factSlot] = factLines[j]
    var dependencySlots: int32[]
    setLen(dependencySlots, int32(totalDependencies))
    for j in 0..<int32(totalDependencies):
        dependencySlots[j] = -1
    for j in 0..<dependencyLines.len:
        var dependencySource: int32
        var dependencyRank: int32
        if !csgRequestNat32Field(
               decoded.lines[dependencyLines[j]],
               "source_index",
               dependencySource) ||
           !csgRequestNat32Field(
               decoded.lines[dependencyLines[j]],
               "dependency_index",
               dependencyRank) ||
           dependencySource >= replacementCount:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_dependency_invalid")
        if dependencyRank >= dependencyCounts[dependencySource]:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_dependency_invalid")
        let dependencySlot =
            dependencyBases[dependencySource] + dependencyRank
        if dependencySlots[dependencySlot] != -1:
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_dependency_invalid")
        dependencySlots[dependencySlot] = dependencyLines[j]
    for sourceIndex in 0..<replacementCount:
        var replacement: CsgCoreMerkleTransactionRequestReplacement
        var factCount: int32
        var dependencyCount: int32
        if !csgRequestDecodeReplacement(
               decoded.lines[replacementSlots[sourceIndex]],
               sourceIndex,
               replacement,
               factCount,
               dependencyCount):
            return csgRequestDecodeFail(
                "merkle_transaction_request_decode_replacement_invalid")
        let factBase = factBases[sourceIndex]
        for factIndex in 0..<factCount:
            var fact: CsgCoreMerkleTransactionRequestFact
            if !csgRequestDecodeFact(
                   decoded.lines[
                       factSlots[factBase + factIndex]],
                   sourceIndex,
                   factIndex,
                   fact):
                return csgRequestDecodeFail(
                    "merkle_transaction_request_decode_fact_invalid")
            add(replacement.facts, fact)
        let dependencyBase = dependencyBases[sourceIndex]
        for dependencyIndex in 0..<dependencyCount:
            var dependency: CsgCoreMerkleTransactionRequestDependency
            if !csgRequestDecodeDependency(
                   decoded.lines[
                       dependencySlots[
                           dependencyBase + dependencyIndex]],
                   sourceIndex,
                   dependencyIndex,
                   dependency):
                return csgRequestDecodeFail(
                    "merkle_transaction_request_decode_dependency_invalid")
            add(replacement.dependencies, dependency)
        add(request.replacements, replacement)
    let semanticError = csgRequestError(request)
    if semanticError.len > 0:
        return csgRequestDecodeFail(
            csgRequestCat(
                "merkle_transaction_request_decode_semantic ",
                semanticError))
    var canonical =
        CsgCoreMerkleTransactionRequestCid(request)
    if !canonical.ok ||
       canonical.factCount != decoded.factCount ||
       !rawbytes.BytesEqual(canonical.bytes, bytes):
        rawbytes.BytesFree(canonical.bytes)
        return csgRequestDecodeFail(
            "merkle_transaction_request_decode_non_canonical")
    var out: CsgCoreMerkleTransactionRequestDecodeResult
    out.ok = true
    out.requestCid = strings.CloneStr(canonical.requestCid)
    out.factCount = canonical.factCount
    out.request = request
    out.lines = decoded.lines
    rawbytes.BytesFree(canonical.bytes)
    return out

@borrows
fn csgPlanError(
        plan: CsgCoreMerkleTransactionPlan): str =
    let requestError = csgRequestCidError(
        "merkle_transaction_plan_request_cid",
        plan.requestCid)
    if requestError.len > 0:
        return requestError
    let beforeHeadError = csgRequestCidError(
        "merkle_transaction_plan_before_head_cid",
        plan.beforeHeadCid)
    if beforeHeadError.len > 0:
        return beforeHeadError
    let beforeManifestError = csgRequestCidError(
        "merkle_transaction_plan_before_manifest_cid",
        plan.beforeManifestCid)
    if beforeManifestError.len > 0:
        return beforeManifestError
    let beforeDirectoryError = csgRequestCidError(
        "merkle_transaction_plan_before_csgc_directory_cid",
        plan.beforeCsgcDirectoryCid)
    if beforeDirectoryError.len > 0:
        return beforeDirectoryError
    let beforeFactsError = csgRequestCidError(
        "merkle_transaction_plan_before_facts_root",
        plan.beforeFactsRoot)
    if beforeFactsError.len > 0:
        return beforeFactsError
    let beforeDagError = csgRequestCidError(
        "merkle_transaction_plan_before_dag_root_cid",
        plan.beforeDagRootCid)
    if beforeDagError.len > 0:
        return beforeDagError
    let afterDirectoryError = csgRequestCidError(
        "merkle_transaction_plan_after_csgc_directory_cid",
        plan.afterCsgcDirectoryCid)
    if afterDirectoryError.len > 0:
        return afterDirectoryError
    let afterFactsError = csgRequestCidError(
        "merkle_transaction_plan_after_facts_root",
        plan.afterFactsRoot)
    if afterFactsError.len > 0:
        return afterFactsError
    let afterDagError = csgRequestCidError(
        "merkle_transaction_plan_after_dag_root_cid",
        plan.afterDagRootCid)
    if afterDagError.len > 0:
        return afterDagError
    if plan.beforeFactCount <= 0 ||
       plan.afterFactCount <= 0:
        return "merkle_transaction_plan_fact_count_invalid"
    let invalidationError = csgRequestCidError(
        "merkle_transaction_plan_invalidation_cid",
        plan.invalidationCid)
    if invalidationError.len > 0:
        return invalidationError
    if plan.operationKinds.len !=
           plan.operationFactKeys.len ||
       plan.operationKinds.len !=
           plan.operationCids.len:
        return "merkle_transaction_plan_operation_shape_invalid"
    if plan.operationKinds.len >
       CsgMerkleTransactionRequestMaxFactCount:
        return "merkle_transaction_plan_operation_count_limit_exceeded"
    var previousOperationIdentity: str
    for i in 0..<plan.operationKinds.len:
        if plan.operationKinds[i] < 1 ||
           plan.operationKinds[i] > 3:
            return "merkle_transaction_plan_operation_kind_invalid"
        if plan.operationFactKeys[i].len == 0:
            return "merkle_transaction_plan_operation_fact_key_invalid"
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               plan.operationCids[i]):
            return "merkle_transaction_plan_operation_cid_invalid"
        let operationIdentity =
            csgPlanOperationIdentity(
                plan.operationKinds[i],
                plan.operationFactKeys[i])
        if i > 0 &&
           csgRequestTextCompare(
               previousOperationIdentity,
               operationIdentity) >= 0:
            return "merkle_transaction_plan_operation_order_invalid"
        previousOperationIdentity = operationIdentity
    if plan.operationKinds.len == 0 &&
       (plan.beforeCsgcDirectoryCid !=
            plan.afterCsgcDirectoryCid ||
        plan.beforeFactsRoot != plan.afterFactsRoot ||
        plan.beforeDagRootCid != plan.afterDagRootCid ||
        plan.beforeFactCount != plan.afterFactCount):
        return "merkle_transaction_plan_noop_transition_invalid"
    let operationOrder =
        csgRequestTextOrder(plan.operationFactKeys)
    for i in 1..<operationOrder.len:
        if plan.operationFactKeys[operationOrder[i - 1]] ==
           plan.operationFactKeys[operationOrder[i]]:
            return "merkle_transaction_plan_operation_duplicate"
    let operationCidOrder =
        csgRequestTextOrder(plan.operationCids)
    for i in 1..<operationCidOrder.len:
        if plan.operationCids[operationCidOrder[i - 1]] ==
           plan.operationCids[operationCidOrder[i]]:
            return "merkle_transaction_plan_operation_cid_duplicate"
    if int64(plan.operationKinds.len) + int64(1) >
       int64(CsgMerkleTransactionRequestMaxLineCount):
        return "merkle_transaction_plan_line_count_limit_exceeded"
    return ""

@borrows
fn csgPlanHeaderLine(
        plan: CsgCoreMerkleTransactionPlan): str =
    var out: str = "{\"after_csgc_directory_cid\":"
    csgRequestAppend(
        out, csgRequestJson(plan.afterCsgcDirectoryCid))
    csgRequestAppend(out, ",\"after_dag_root_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.afterDagRootCid))
    csgRequestAppend(out, ",\"after_fact_count\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(plan.afterFactCount)))
    csgRequestAppend(out, ",\"after_facts_root\":")
    csgRequestAppend(
        out, csgRequestJson(plan.afterFactsRoot))
    csgRequestAppend(out, ",\"before_csgc_directory_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.beforeCsgcDirectoryCid))
    csgRequestAppend(out, ",\"before_dag_root_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.beforeDagRootCid))
    csgRequestAppend(out, ",\"before_fact_count\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(plan.beforeFactCount)))
    csgRequestAppend(out, ",\"before_facts_root\":")
    csgRequestAppend(
        out, csgRequestJson(plan.beforeFactsRoot))
    csgRequestAppend(out, ",\"before_head_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.beforeHeadCid))
    csgRequestAppend(out, ",\"before_manifest_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.beforeManifestCid))
    csgRequestAppend(out, ",\"id\":\"plan\"")
    csgRequestAppend(out, ",\"invalidation_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.invalidationCid))
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_plan\"")
    csgRequestAppend(out, ",\"operation_count\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(plan.operationKinds.len)))
    csgRequestAppend(out, ",\"request_cid\":")
    csgRequestAppend(
        out, csgRequestJson(plan.requestCid))
    csgRequestAppend(out, ",\"schema\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            CsgMerkleTransactionIdentitySchema))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgPlanOperationLine(
        index: int32,
        operationKind: int32,
        operationFactKey: str,
        operationCid: str): str =
    var out: str = "{\"fact_key\":"
    csgRequestAppend(
        out, csgRequestJson(operationFactKey))
    csgRequestAppend(out, ",\"id\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            csgRequestIndexedId(
                "operation:", index)))
    csgRequestAppend(out, ",\"index\":")
    csgRequestAppend(
        out, csgRequestJson(strings.IntToStr(index)))
    csgRequestAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_plan_operation\"")
    csgRequestAppend(out, ",\"operation_cid\":")
    csgRequestAppend(
        out, csgRequestJson(operationCid))
    csgRequestAppend(out, ",\"operation_kind\":")
    csgRequestAppend(
        out,
        csgRequestJson(
            strings.IntToStr(operationKind)))
    csgRequestAppend(out, "}")
    return out

@borrows
fn csgPlanLines(
        plan: CsgCoreMerkleTransactionPlan): str[] =
    var lines: str[]
    add(lines, csgPlanHeaderLine(plan))
    for i in 0..<plan.operationKinds.len:
        add(
            lines,
            csgPlanOperationLine(
                i,
                plan.operationKinds[i],
                plan.operationFactKeys[i],
                plan.operationCids[i]))
    return lines

@borrows
fn CsgCoreMerkleTransactionPlanRoot(
        plan: CsgCoreMerkleTransactionPlan):
        CsgCoreMerkleTransactionPlanRootResult =
    let planError = csgPlanError(plan)
    if planError.len > 0:
        return csgPlanFail(planError)
    let sourceLines = csgPlanLines(plan)
    let linesError = csgRequestLinesError(sourceLines)
    if linesError.len > 0:
        return csgPlanFail(linesError)
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            sourceLines)
    if !encoded.ok:
        return csgPlanFail(
            csgRequestCat(
                "merkle_transaction_plan_encode ",
                encoded.error))
    let canonical =
        csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !canonical.ok ||
       canonical.factCount != sourceLines.len:
        rawbytes.BytesFree(encoded.bytes)
        return csgPlanFail(
            "merkle_transaction_plan_encode_self_check")
    let planRoot =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionPlanDomain,
            encoded.bytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           planRoot):
        rawbytes.BytesFree(encoded.bytes)
        return csgPlanFail(
            "merkle_transaction_plan_root_invalid")
    var out: CsgCoreMerkleTransactionPlanRootResult
    out.ok = true
    out.planRoot = strings.CloneStr(planRoot)
    out.factCount = canonical.factCount
    out.lines = canonical.lines
    out.bytes = encoded.bytes
    return out

fn csgSemanticPlanAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgSemanticPlanAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgSemanticPlanAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

@borrows
fn CsgCoreMerkleSemanticPlanError(
        plan: CsgCoreMerkleSemanticPlan): str =
    if plan.beforeGeneration < 0:
        return "merkle_semantic_plan_generation_invalid"
    if plan.formatId.len == 0:
        return "merkle_semantic_plan_format_invalid"
    let cids = [
        strings.CloneStr(plan.beforeStoreIdentity),
        strings.CloneStr(plan.sealedBeforeContentCid),
        strings.CloneStr(plan.beforeHeadCid),
        strings.CloneStr(plan.beforeManifestCid),
        strings.CloneStr(plan.requestCid),
        strings.CloneStr(plan.invalidationPlanCid),
        strings.CloneStr(plan.semanticManifestSkeletonCid),
        strings.CloneStr(plan.operationCid),
        strings.CloneStr(plan.proofCid),
        strings.CloneStr(plan.semanticCarrierCid)]
    for i in 0..<cids.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               cids[i]):
            return "merkle_semantic_plan_cid_invalid"
    return ""

@borrows
fn CsgCoreMerkleSemanticPlanRoot(
        plan: CsgCoreMerkleSemanticPlan):
        CsgCoreMerkleSemanticPlanRootResult =
    let error = CsgCoreMerkleSemanticPlanError(plan)
    if error.len > 0:
        var failed: CsgCoreMerkleSemanticPlanRootResult
        failed.error = strings.CloneStr(error)
        return failed
    var preimage = layout.ByteBufInit(1024)
    csgSemanticPlanAppendText(
        preimage, CsgMerkleSemanticPlanDomain)
    csgSemanticPlanAppendText(
        preimage, plan.beforeStoreIdentity)
    csgSemanticPlanAppendText(
        preimage, plan.sealedBeforeContentCid)
    csgSemanticPlanAppendText(preimage, plan.beforeHeadCid)
    csgSemanticPlanAppendText(preimage, plan.beforeManifestCid)
    csgSemanticPlanAppendText(
        preimage, strings.Int64ToStr(plan.beforeGeneration))
    csgSemanticPlanAppendText(preimage, plan.requestCid)
    csgSemanticPlanAppendText(preimage, plan.invalidationPlanCid)
    csgSemanticPlanAppendText(
        preimage, plan.semanticManifestSkeletonCid)
    csgSemanticPlanAppendText(preimage, plan.operationCid)
    csgSemanticPlanAppendText(preimage, plan.proofCid)
    csgSemanticPlanAppendText(preimage, plan.semanticCarrierCid)
    csgSemanticPlanAppendText(preimage, plan.formatId)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    var out: CsgCoreMerkleSemanticPlanRootResult
    out.ok = true
    out.planRoot = csgRequestCat(
        "sha256:", layout.FixedBytes32Hex(digest))
    return out

fn CsgCoreMerkleTransactionRequestCidFree(
        out: var CsgCoreMerkleTransactionRequestCidResult) =
    rawbytes.BytesFree(out.bytes)
    out = CsgCoreMerkleTransactionRequestCidResult()

fn CsgCoreMerkleTransactionPlanRootFree(
        out: var CsgCoreMerkleTransactionPlanRootResult) =
    rawbytes.BytesFree(out.bytes)
    out = CsgCoreMerkleTransactionPlanRootResult()
