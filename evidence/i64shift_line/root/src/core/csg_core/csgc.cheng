import std/rawbytes
import std/seqs
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec as merkle_store_codec

const
    # Little-endian integer whose exact wire bytes are ASCII "CSGC".
    CsgCoreCsgcMagic = 1128747843
    CsgCoreCsgcHeaderSize = 64
    CsgCoreCsgcFlagNone = 0
    CsgCoreCsgcTokenDictRef = 1
    CsgCoreCsgcTokenInlineUtf8 = 2
    CsgCoreCsgcSectionDictionary = 1
    CsgCoreCsgcSectionFactKind = 2
    CsgCoreCsgcDirectoryPrefixSize = 8
    CsgCoreCsgcSectionFixedSize = 45
    CsgCoreCsgcSectionDigestSize = 32
    CsgCoreCsgcSectionHashDomain = "csg_core.csgc.section"
    CsgCoreCsgcDirectoryHashDomain =
        "csg_core.csgc.directory.claim"
    CsgCoreCsgcProjectionReceiptDomain =
        "csg_core.csgc_projection_receipt.v1"

type
    CsgCoreCsgcLinesResult =
        ok: bool
        lines: str[]
        headerSize: int32
        flags: int32
        factCount: int32
        error: str

    CsgCoreCsgcBytesResult =
        ok: bool
        bytes: rawbytes.Bytes
        headerSize: int32
        flags: int32
        factCount: int32
        dictionaryCount: int32
        claimedDirectoryCid: str
        error: str

    CsgCoreCsgcProjectionReceipt =
        ok: bool
        error: str
        sourceFactsRoot: str
        formatId: str
        factCount: int32
        byteCount: int32
        directoryCid: str
        objectCid: str
        receiptCid: str
        bytes: rawbytes.Bytes

    CsgCoreCsgcDirectoryClaim =
        ok: bool
        error: str
        factCount: int32
        directoryCid: str

    CsgCoreCsgcSectionDirectory =
        ok: bool
        headerSize: int32
        flags: int32
        factCount: int32
        bodySize: int32
        directorySize: int32
        sectionTags: int32[]
        sectionKinds: str[]
        sectionOffsets: int32[]
        sectionLengths: int32[]
        sectionItemCounts: int32[]
        sectionHashes: layout.FixedBytes32[]
        error: str

    CsgCoreCsgcSectionIterator =
        nextIndex: int32

    CsgCoreCsgcSectionView =
        ok: bool
        done: bool
        index: int32
        tag: int32
        kind: str
        offset: int32
        length: int32
        itemCount: int32
        claimedCid: str
        error: str

    CsgCoreCsgcDictionaryResult =
        ok: bool
        entries: str[]
        sectionBytes: int32
        error: str

    CsgCoreCsgcLazyLinesResult =
        ok: bool
        found: bool
        kind: str
        lines: str[]
        totalFactCount: int32
        decodedFactCount: int32
        dictionaryCount: int32
        directoryBytes: int32
        decodedSectionBytes: int32
        claimedDirectoryCid: str
        error: str

    CsgCoreCsgcDecodedFactLine =
        ok: bool
        done: bool
        line: str
        error: str

    CsgCoreCsgcFactLineStream =
        ok: bool
        error: str
        directory: CsgCoreCsgcSectionDirectory
        dictionary: str[]
        dictionaryIndex: csgCoreCsgcStringIndex
        sectionIndex: int32
        remaining: int32
        cursor: int32
        finish: int32
        yielded: int32
        factCount: int32
        sectionKeys: str[]
        sectionKeyHashes: layout.FixedBytes32[]

    csgCoreCsgcVarintRead =
        ok: bool
        value: int32
        nextOffset: int32
        error: str

    csgCoreCsgcLineRead =
        ok: bool
        line: str
        nextOffset: int32
        error: str

    csgCoreCsgcHeaderRead =
        ok: bool
        headerSize: int32
        flags: int32
        factCount: int32
        bodySize: int32
        error: str

    CsgCoreCsgcTokenLine =
        tokens: str[]
        dictRefs: int32[]

    csgCoreCsgcStringIndex =
        slots: int32[]
        mask: int32
        used: int32

    csgCoreCsgcStringLookup =
        ok: bool
        foundIndex: int32
        slot: int32

    csgCoreCsgcDecodedDictionary =
        ok: bool
        entries: str[]
        index: csgCoreCsgcStringIndex
        sectionBytes: int32
        error: str

    csgCoreCsgcFactSection =
        kind: str
        lineRows: int32[]
        payloadOffset: int32
        payloadLength: int32
        digest: layout.FixedBytes32

    csgCoreCsgcFactSectionsResult =
        ok: bool
        sections: csgCoreCsgcFactSection[]
        error: str

@borrows
fn csgcCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgcCat3(a: str, b: str, c: str): str =
    return csgcCat(csgcCat(a, b), c)

@borrows
fn csgcCat4(a: str, b: str, c: str, d: str): str =
    return csgcCat(csgcCat3(a, b, c), d)

@borrows
fn csgcFail(error: str): CsgCoreCsgcLinesResult =
    var result: CsgCoreCsgcLinesResult
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcBytesFail(error: str): CsgCoreCsgcBytesResult =
    var result: CsgCoreCsgcBytesResult
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcVarintFail(error: str): csgCoreCsgcVarintRead =
    var result: csgCoreCsgcVarintRead
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcLineReadFail(error: str): csgCoreCsgcLineRead =
    var result: csgCoreCsgcLineRead
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcHeaderFail(error: str): csgCoreCsgcHeaderRead =
    var result: csgCoreCsgcHeaderRead
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcDirectoryFail(error: str): CsgCoreCsgcSectionDirectory =
    var result: CsgCoreCsgcSectionDirectory
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcDictionaryFail(error: str): CsgCoreCsgcDictionaryResult =
    var result: CsgCoreCsgcDictionaryResult
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcDecodedDictionaryFail(
        error: str): csgCoreCsgcDecodedDictionary =
    var result: csgCoreCsgcDecodedDictionary
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcLazyFail(error: str): CsgCoreCsgcLazyLinesResult =
    var result: CsgCoreCsgcLazyLinesResult
    result.error = strings.CloneStr(error)
    return result

@borrows
fn csgcSectionViewFail(error: str): CsgCoreCsgcSectionView =
    var result: CsgCoreCsgcSectionView
    result.error = strings.CloneStr(error)
    return result

fn csgcCheckedAdd(left: int32,
                  right: int32,
                  out: var int32): bool =
    if left < 0 || right < 0 ||
       left > 2147483647 - right:
        return false
    out = left + right
    return true

fn csgcCheckedRangeEnd(offset: int32,
                       length: int32,
                       limit: int32,
                       out: var int32): bool =
    if limit < 0 ||
       !csgcCheckedAdd(offset, length, out):
        return false
    return out <= limit

@borrows
fn csgcReadU8(bytes: rawbytes.Bytes, offset: int32): int32 =
    if offset < 0 || offset >= rawbytes.BytesLen(bytes):
        return -1
    return rawbytes.BytesGet(bytes, offset) & 255

@borrows
fn csgcReadU16LE(bytes: rawbytes.Bytes, offset: int32): int32 =
    let totalLen = rawbytes.BytesLen(bytes)
    if offset < 0 || totalLen < 2 || offset > totalLen - 2:
        return -1
    let b0 = rawbytes.BytesGet(bytes, offset) & 255
    let b1 = rawbytes.BytesGet(bytes, offset + 1) & 255
    return b0 | (b1 << 8)

@borrows
fn csgcReadU32LE(bytes: rawbytes.Bytes, offset: int32): int32 =
    let totalLen = rawbytes.BytesLen(bytes)
    if offset < 0 || totalLen < 4 || offset > totalLen - 4:
        return -1
    let b0 = rawbytes.BytesGet(bytes, offset) & 255
    let b1 = rawbytes.BytesGet(bytes, offset + 1) & 255
    let b2 = rawbytes.BytesGet(bytes, offset + 2) & 255
    let b3 = rawbytes.BytesGet(bytes, offset + 3) & 255
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn csgcWriteU8(bytes: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)

fn csgcWriteU16LE(bytes: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(bytes, offset + 1, (value >> 8) & 255)

fn csgcWriteU32LE(bytes: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(bytes, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(bytes, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(bytes, offset + 3, (value >> 24) & 255)

@borrows
fn csgcWriteFixed32(bytes: var rawbytes.Bytes,
                    offset: int32,
                    value: layout.FixedBytes32) =
    for i in 0..<CsgCoreCsgcSectionDigestSize:
        rawbytes.BytesSet(
            bytes, offset + i, int32(value.data[i]) & 255)

@borrows
fn csgcReadFixed32(bytes: rawbytes.Bytes,
                   offset: int32,
                   limit: int32,
                   out: var layout.FixedBytes32): bool =
    var finish: int32
    if limit > rawbytes.BytesLen(bytes) ||
       !csgcCheckedRangeEnd(
           offset, CsgCoreCsgcSectionDigestSize,
           limit, finish):
        return false
    for i in 0..<CsgCoreCsgcSectionDigestSize:
        out.data[i] =
            UInt8(rawbytes.BytesGet(bytes, offset + i) & 255)
    return true

fn csgcVarintLen(value: int32): int32 =
    var v = value
    var length: int32 = 1
    while v >= 128:
        length = length + 1
        v = v >> 7
    return length

fn csgcStringIndexCapacity(entryLimit: int32): int32 =
    if entryLimit < 0 || entryLimit > 134217728:
        panic("csgc_string_index_entry_limit")
    var needed = entryLimit * 2
    if needed < 8:
        needed = 8
    var capacity: int32 = 8
    while capacity < needed:
        capacity = capacity * 2
    return capacity

fn csgcStringIndexInit(
        entryLimit: int32): csgCoreCsgcStringIndex =
    let capacity = csgcStringIndexCapacity(entryLimit)
    var index: csgCoreCsgcStringIndex
    for i in 0..<capacity:
        add(index.slots, 0)
    index.mask = capacity - 1
    return index

@borrows
fn csgcStringHash(value: str): uint64 =
    var hashValue =
        (uint64(1469598103) * uint64(1000000000)) +
        uint64(934665603)
    for i in 0..<value.len:
        hashValue =
            hashValue ^
            (uint64(int32(value[i])) & uint64(255))
        hashValue =
            hashValue *
            ((uint64(1099511628) * uint64(1000)) +
             uint64(211))
    return hashValue

@borrows
fn csgcStringIndexGet(
        index: csgCoreCsgcStringIndex,
        keys: str[],
        value: str): int32 =
    if index.slots.len == 0:
        return -1
    var slot =
        int32(csgcStringHash(value) &
              uint64(index.mask))
    for scanned in 0..<index.slots.len:
        let entry = index.slots[slot]
        if entry == 0:
            return -1
        let keyIndex = entry - 1
        if keyIndex >= 0 && keyIndex < keys.len &&
           keys[keyIndex] == value:
            return keyIndex
        slot = (slot + 1) & index.mask
    return -1

@borrows
fn csgcStringIndexLookup(
        index: csgCoreCsgcStringIndex,
        keys: str[],
        value: str): csgCoreCsgcStringLookup =
    var result: csgCoreCsgcStringLookup
    result.foundIndex = -1
    result.slot = -1
    if index.slots.len == 0:
        return result
    var slot =
        int32(csgcStringHash(value) &
              uint64(index.mask))
    for scanned in 0..<index.slots.len:
        let entry = index.slots[slot]
        if entry == 0:
            result.ok = true
            result.slot = slot
            return result
        let existing = entry - 1
        if existing >= 0 && existing < keys.len &&
           keys[existing] == value:
            result.ok = true
            result.foundIndex = existing
            result.slot = slot
            return result
        slot = (slot + 1) & index.mask
    return result

@borrows
fn csgcStringIndexGrown(
        index: csgCoreCsgcStringIndex,
        keys: str[]): csgCoreCsgcStringIndex =
    var failed: csgCoreCsgcStringIndex
    failed.mask = -1
    if index.slots.len <= 0 ||
       index.slots.len > 134217728:
        return failed
    let nextCapacity = index.slots.len * 2
    var nextIndex: csgCoreCsgcStringIndex
    for i in 0..<nextCapacity:
        add(nextIndex.slots, 0)
    nextIndex.mask = nextCapacity - 1
    for i in 0..<index.slots.len:
        let entry = index.slots[i]
        if entry <= 0:
            continue
        let keyIndex = entry - 1
        if keyIndex < 0 || keyIndex >= keys.len:
            return failed
        let value = keys[keyIndex]
        var slot =
            int32(csgcStringHash(value) &
                  uint64(nextIndex.mask))
        var inserted = false
        for scanned in 0..<nextIndex.slots.len:
            if nextIndex.slots[slot] == 0:
                nextIndex.slots[slot] = keyIndex + 1
                nextIndex.used = nextIndex.used + 1
                inserted = true
                break
            slot = (slot + 1) & nextIndex.mask
        if !inserted:
            return failed
    if nextIndex.used != index.used:
        return failed
    return nextIndex

@borrows
fn csgcInlineTokenCost(token: str): int64 =
    return int64(1) +
        int64(csgcVarintLen(token.len)) +
        int64(token.len)

@borrows
fn csgcDictEntryCost(token: str): int64 =
    return int64(csgcVarintLen(token.len)) +
        int64(token.len)

fn csgcDictRefTokenCost(dictIndex: int32): int64 =
    return int64(1) +
        int64(csgcVarintLen(dictIndex))

@borrows
fn csgcDictNetSavings(
        token: str,
        count: int32,
        dictIndex: int32): int64 =
    return (int64(count) * csgcInlineTokenCost(token)) -
        (csgcDictEntryCost(token) +
         int64(count) * csgcDictRefTokenCost(dictIndex))

fn csgcWriteVarint(bytes: var rawbytes.Bytes, offset: int32, value: int32): int32 =
    var v = value
    var cursor = offset
    while v >= 128:
        rawbytes.BytesSet(bytes, cursor, (v & 127) | 128)
        cursor = cursor + 1
        v = v >> 7
    rawbytes.BytesSet(bytes, cursor, v & 127)
    return cursor + 1

@borrows
fn csgcReadVarintBounded(bytes: rawbytes.Bytes,
                         offset: int32,
                         limit: int32): csgCoreCsgcVarintRead =
    if offset < 0 || limit < 0 ||
       limit > rawbytes.BytesLen(bytes) || offset > limit:
        return csgcVarintFail("varint_offset_out_of_range")
    var out: csgCoreCsgcVarintRead
    var cursor = offset
    var value: int32
    var shift: int32
    while cursor < limit:
        let b = rawbytes.BytesGet(bytes, cursor) & 255
        if shift > 28:
            return csgcVarintFail("varint_overflow")
        if shift == 28 && (b & 127) > 7:
            return csgcVarintFail("varint_overflow")
        value = value | ((b & 127) << shift)
        cursor = cursor + 1
        if (b & 128) == 0:
            if cursor - offset != csgcVarintLen(value):
                return csgcVarintFail(
                    "non_canonical_varint")
            out.ok = true
            out.value = value
            out.nextOffset = cursor
            return out
        shift = shift + 7
    return csgcVarintFail("truncated_varint")

@borrows
fn csgcUtf8Valid(
        bytes: rawbytes.Bytes,
        start: int32,
        length: int32): bool =
    if start < 0 || length < 0 ||
       start > rawbytes.BytesLen(bytes) - length:
        return false
    let finish = start + length
    var cursor = start
    while cursor < finish:
        let b0 = rawbytes.BytesGet(bytes, cursor) & 255
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if cursor + 1 >= finish:
                return false
            let b1 =
                rawbytes.BytesGet(bytes, cursor + 1) & 255
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if cursor + 2 >= finish:
                return false
            let b1 =
                rawbytes.BytesGet(bytes, cursor + 1) & 255
            let b2 =
                rawbytes.BytesGet(bytes, cursor + 2) & 255
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if cursor + 3 >= finish:
                return false
            let b1 =
                rawbytes.BytesGet(bytes, cursor + 1) & 255
            let b2 =
                rawbytes.BytesGet(bytes, cursor + 2) & 255
            let b3 =
                rawbytes.BytesGet(bytes, cursor + 3) & 255
            if b2 < 128 || b2 > 191 ||
               b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

@borrows
fn csgcSliceString(bytes: rawbytes.Bytes, start: int32, length: int32): str =
    if start < 0 || length < 0 ||
       start > rawbytes.BytesLen(bytes) - length:
        return ""
    let view = rawbytes.BytesSliceView(bytes, start, length)
    return rawbytes.BytesToString(view)

@borrows
fn csgcDecodeLine(
        bytes: rawbytes.Bytes,
        dictionary: str[],
        dictionaryIndex: csgCoreCsgcStringIndex,
        totalLen: int32,
        offset: int32): csgCoreCsgcLineRead =
    if totalLen < 0 || totalLen > rawbytes.BytesLen(bytes) ||
       offset < 0 || offset > totalLen:
        return csgcLineReadFail("line_range_out_of_bounds")
    let tokenCountRead =
        csgcReadVarintBounded(bytes, offset, totalLen)
    if !tokenCountRead.ok:
        return csgcLineReadFail(
            csgcCat("truncated_token_count ", tokenCountRead.error))
    let tokenCount = tokenCountRead.value
    var cursor = tokenCountRead.nextOffset
    if tokenCount < 0 || tokenCount > totalLen - cursor:
        return csgcLineReadFail("token_count_out_of_range")
    var lineBuf = layout.ByteBufInit(64)
    var wireTokens: str[]
    for j in 0..<tokenCount:
        if cursor >= totalLen:
            layout.ByteBufFree(lineBuf)
            return csgcLineReadFail("truncated_token_tag")
        let tag = csgcReadU8(bytes, cursor)
        cursor = cursor + 1
        if tag == CsgCoreCsgcTokenDictRef:
            let refRead =
                csgcReadVarintBounded(bytes, cursor, totalLen)
            if !refRead.ok:
                let error =
                    csgcCat("truncated_dict_ref ", refRead.error)
                layout.ByteBufFree(lineBuf)
                return csgcLineReadFail(error)
            cursor = refRead.nextOffset
            if refRead.value < 0 || refRead.value >= dictionary.len:
                layout.ByteBufFree(lineBuf)
                return csgcLineReadFail("bad_dict_ref")
            let tokenBytes =
                rawbytes.BytesFromString(dictionary[refRead.value])
            layout.ByteBufAppendBytes(lineBuf, tokenBytes)
            add(
                wireTokens,
                strings.CloneStr(
                    dictionary[refRead.value]))
        elif tag == CsgCoreCsgcTokenInlineUtf8:
            let lenRead =
                csgcReadVarintBounded(bytes, cursor, totalLen)
            if !lenRead.ok:
                let error =
                    csgcCat("truncated_inline_len ", lenRead.error)
                layout.ByteBufFree(lineBuf)
                return csgcLineReadFail(error)
            let inlineLen = lenRead.value
            cursor = lenRead.nextOffset
            if inlineLen < 0 ||
               cursor > totalLen - inlineLen:
                layout.ByteBufFree(lineBuf)
                return csgcLineReadFail("truncated_inline_bytes")
            if !csgcUtf8Valid(bytes, cursor, inlineLen):
                layout.ByteBufFree(lineBuf)
                return csgcLineReadFail("invalid_utf8")
            let tokenBytes =
                rawbytes.BytesSliceView(bytes, cursor, inlineLen)
            let token =
                rawbytes.BytesToString(tokenBytes)
            if csgcStringIndexGet(
                   dictionaryIndex,
                   dictionary,
                   token) >= 0:
                layout.ByteBufFree(lineBuf)
                return csgcLineReadFail(
                    "non_canonical_inline_dictionary_token")
            layout.ByteBufAppendBytes(lineBuf, tokenBytes)
            add(wireTokens, token)
            cursor = cursor + inlineLen
        else:
            let error = csgcCat(
                "unsupported_token_tag ", strings.IntToStr(tag))
            layout.ByteBufFree(lineBuf)
            return csgcLineReadFail(error)
    var lineBytes = layout.ByteBufToBytes(lineBuf)
    let line = rawbytes.BytesToString(lineBytes)
    rawbytes.BytesFree(lineBytes)
    layout.ByteBufFree(lineBuf)
    let canonicalTokens =
        CsgCoreCsgcTokenizeCanonicalLine(line)
    if canonicalTokens.len != wireTokens.len:
        return csgcLineReadFail(
            "non_canonical_token_stream")
    for i in 0..<canonicalTokens.len:
        if canonicalTokens[i] != wireTokens[i]:
            return csgcLineReadFail(
                "non_canonical_token_stream")
    var result: csgCoreCsgcLineRead
    result.ok = true
    result.line = line
    result.nextOffset = cursor
    return result

@borrows
fn CsgCoreCsgcTokenizeCanonicalLine(line: str): str[] =
    let bytes = rawbytes.BytesFromString(line)
    var tokens: str[]
    var cursor: int32
    var tokenStart: int32
    let total = rawbytes.BytesLen(bytes)
    while cursor < total:
        let b = rawbytes.BytesGet(bytes, cursor) & 255
        if b == 34:
            if cursor > tokenStart:
                let prefixToken =
                    csgcSliceString(bytes, tokenStart, cursor - tokenStart)
                add(tokens, prefixToken)
            let stringStart = cursor
            cursor = cursor + 1
            var escaped = false
            var done = false
            while cursor < total && !done:
                let sb = rawbytes.BytesGet(bytes, cursor) & 255
                if escaped:
                    escaped = false
                    cursor = cursor + 1
                elif sb == 92:
                    escaped = true
                    cursor = cursor + 1
                elif sb == 34:
                    cursor = cursor + 1
                    done = true
                else:
                    cursor = cursor + 1
            let stringToken =
                csgcSliceString(bytes, stringStart, cursor - stringStart)
            add(tokens, stringToken)
            tokenStart = cursor
        else:
            cursor = cursor + 1
    if tokenStart < total:
        let suffixToken =
            csgcSliceString(bytes, tokenStart, total - tokenStart)
        add(tokens, suffixToken)
    return tokens

@borrows
fn csgcBuildTokenLines(lines: str[]): CsgCoreCsgcTokenLine[] =
    var tokenLines: CsgCoreCsgcTokenLine[]
    for i in 0..<lines.len:
        var tokenLine: CsgCoreCsgcTokenLine
        let tokens = CsgCoreCsgcTokenizeCanonicalLine(lines[i])
        tokenLine.tokens = tokens
        add(tokenLines, tokenLine)
    return tokenLines

@borrows
fn csgcBuildDictionary(tokenLines: CsgCoreCsgcTokenLine[]): str[] =
    var candidates: str[]
    var counts: int32[]
    var candidateIndex =
        csgcStringIndexInit(16)
    for i in 0..<tokenLines.len:
        for j in 0..<tokenLines[i].tokens.len:
            if tokenLines[i].tokens[j].len >= 2:
                let existing =
                    csgcStringIndexGet(
                        candidateIndex,
                        candidates,
                        tokenLines[i].tokens[j])
                if existing >= 0:
                    counts[existing] = counts[existing] + 1
                else:
                    if int64(candidateIndex.used + 1) *
                           int64(10) >=
                       int64(candidateIndex.slots.len) *
                           int64(7):
                        let grown =
                            csgcStringIndexGrown(
                                candidateIndex,
                                candidates)
                        if grown.mask < 0:
                            panic(
                                "csgc_candidate_index_grow_failed")
                        candidateIndex = grown
                    let insertion =
                        csgcStringIndexLookup(
                            candidateIndex,
                            candidates,
                            tokenLines[i].tokens[j])
                    if !insertion.ok ||
                       insertion.foundIndex >= 0 ||
                       insertion.slot < 0:
                        panic(
                            "csgc_candidate_index_lookup_failed")
                    let ownedToken =
                        strings.stringsNewStringCopy(
                            tokenLines[i].tokens[j].data,
                            tokenLines[i].tokens[j].len)
                    add(candidates, ownedToken)
                    add(counts, 1)
                    candidateIndex.slots[insertion.slot] =
                        candidates.len
                    candidateIndex.used =
                        candidateIndex.used + 1
    # Dictionary references encode the final UTF-8-sorted index.  Decide
    # admission only after sorting so the 128 -> 129 entry LEB128 width
    # transition is charged to the token that will actually occupy it.
    let sortedCandidates =
        csgcSortedStrings(candidates)
    var dictionary: str[]
    for i in 0..<sortedCandidates.len:
        let originalIndex =
            csgcStringIndexGet(
                candidateIndex,
                candidates,
                sortedCandidates[i])
        if originalIndex < 0 || originalIndex >= counts.len:
            panic("csgc_sorted_candidate_count_missing")
        if counts[originalIndex] >= 2 &&
           csgcDictNetSavings(
               sortedCandidates[i],
               counts[originalIndex],
               dictionary.len) > 0:
            add(
                dictionary,
                strings.CloneStr(sortedCandidates[i]))
    return dictionary

@borrows
fn csgcBuildTokenRefs(tokenLines: var CsgCoreCsgcTokenLine[],
                       dictionary: str[]) =
    var dictionaryIndex =
        csgcStringIndexInit(dictionary.len)
    for i in 0..<dictionary.len:
        let insertion =
            csgcStringIndexLookup(
                dictionaryIndex,
                dictionary,
                dictionary[i])
        if !insertion.ok ||
           insertion.foundIndex >= 0 ||
           insertion.slot < 0:
            panic("csgc_dictionary_index_insert_failed")
        dictionaryIndex.slots[insertion.slot] = i + 1
        dictionaryIndex.used = dictionaryIndex.used + 1
    for i in 0..<tokenLines.len:
        for j in 0..<tokenLines[i].tokens.len:
            let dictRef =
                csgcStringIndexGet(
                    dictionaryIndex,
                    dictionary,
                    tokenLines[i].tokens[j])
            if dictRef >= 0:
                add(tokenLines[i].dictRefs, dictRef)
            else:
                add(tokenLines[i].dictRefs, -1)

@borrows
fn csgcDictionaryPayloadLen(dictionary: str[]): int64 =
    var size: int64 = int64(4)
    for i in 0..<dictionary.len:
        size = size +
            int64(csgcVarintLen(dictionary[i].len)) +
            int64(dictionary[i].len)
    return size

@borrows
fn csgcFactSectionPayloadLen(
        tokenLines: CsgCoreCsgcTokenLine[],
        lineRows: int32[]): int64 =
    var size: int64 = int64(4)
    for i in 0..<lineRows.len:
        let row = lineRows[i]
        if row < 0 || row >= tokenLines.len ||
           tokenLines[row].dictRefs.len !=
               tokenLines[row].tokens.len:
            return int64(-1)
        size = size +
            int64(csgcVarintLen(tokenLines[row].tokens.len))
        for j in 0..<tokenLines[row].tokens.len:
            let dictIndex = tokenLines[row].dictRefs[j]
            if dictIndex >= 0:
                size = size + int64(1) +
                    int64(csgcVarintLen(dictIndex))
            else:
                size = size + int64(1) +
                    int64(
                        csgcVarintLen(
                            tokenLines[row].tokens[j].len)) +
                    int64(tokenLines[row].tokens[j].len)
    return size

@borrows
fn csgcWriteUtf8(bytes: var rawbytes.Bytes, offset: int32, text: str): int32 =
    var cursor = csgcWriteVarint(bytes, offset, text.len)
    let textBytes = rawbytes.BytesFromString(text)
    rawbytes.BytesCopyInto(bytes, cursor, textBytes)
    return cursor + text.len

@borrows
fn csgcCanonicalFactOrder(
        lines: str[],
        error: var str): str[] =
    error = ""
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            error = "csgc_empty_fact_line"
            var emptyLines: str[]
            return emptyLines
    let physicalOrder =
        merkle_dag.CsgCoreMerklePhysicalOrderFromCanonical(
            lines)
    if !physicalOrder.ok:
        error = csgcCat(
            "csgc_physical_order_failed ",
            physicalOrder.error)
        var emptyLines: str[]
        return emptyLines
    if physicalOrder.canonicalLines.len != lines.len:
        error = "csgc_empty_fact_line"
        var emptyLines: str[]
        return emptyLines
    var ordered: str[]
    for i in 0..<physicalOrder.canonicalLines.len:
        add(ordered, strings.CloneStr(physicalOrder.canonicalLines[i]))
    return ordered

@borrows
fn csgcUtf8ByteCompare(left: str, right: str): int32 =
    let common = left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgcSortedStrings(values: str[]): str[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, values.len)
    setLen(scratch, values.len)
    for i in 0..<values.len:
        order[i] = i
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                var takeLeft = left < middle
                if takeLeft && right < finish:
                    takeLeft = csgcUtf8ByteCompare(
                        values[order[left]],
                        values[order[right]]) <= 0
                if takeLeft:
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var sorted: str[]
    for i in 0..<order.len:
        add(sorted, strings.CloneStr(values[order[i]]))
    return sorted

@borrows
fn csgcBuildFactSections(
        orderedLines: str[]): csgCoreCsgcFactSectionsResult =
    var kinds: str[]
    var rowKindIds: int32[]
    var kindIndex = csgcStringIndexInit(16)
    for i in 0..<orderedLines.len:
        let kind = field.CsgCoreJsonKind(orderedLines[i])
        if !kind.found || kind.value.len == 0:
            var failed: csgCoreCsgcFactSectionsResult
            failed.error = "csgc_fact_kind_missing"
            return failed
        var kindId =
            csgcStringIndexGet(kindIndex, kinds, kind.value)
        if kindId < 0:
            if int64(kindIndex.used + 1) * int64(10) >=
               int64(kindIndex.slots.len) * int64(7):
                let grown = csgcStringIndexGrown(kindIndex, kinds)
                if grown.mask < 0:
                    var failed: csgCoreCsgcFactSectionsResult
                    failed.error = "csgc_kind_index_grow_failed"
                    return failed
                kindIndex = grown
            let insertion =
                csgcStringIndexLookup(kindIndex, kinds, kind.value)
            if !insertion.ok || insertion.foundIndex >= 0 ||
               insertion.slot < 0:
                var failed: csgCoreCsgcFactSectionsResult
                failed.error = "csgc_kind_index_insert_failed"
                return failed
            add(kinds, strings.CloneStr(kind.value))
            kindIndex.slots[insertion.slot] = kinds.len
            kindIndex.used = kindIndex.used + 1
            kindId = kinds.len - 1
        add(rowKindIds, kindId)

    let sortedKinds = csgcSortedStrings(kinds)
    var sortedIndex = csgcStringIndexInit(sortedKinds.len)
    var sections: csgCoreCsgcFactSection[]
    for i in 0..<sortedKinds.len:
        let insertion =
            csgcStringIndexLookup(
                sortedIndex, sortedKinds, sortedKinds[i])
        if !insertion.ok || insertion.foundIndex >= 0 ||
           insertion.slot < 0:
            var failed: csgCoreCsgcFactSectionsResult
            failed.error = "csgc_sorted_kind_index_failed"
            return failed
        sortedIndex.slots[insertion.slot] = i + 1
        sortedIndex.used = sortedIndex.used + 1
        var section: csgCoreCsgcFactSection
        section.kind = strings.CloneStr(sortedKinds[i])
        add(sections, section)

    # Map candidate kind ids to sorted section indexes once, so the
    # row partition needs no second JSON scan over every fact line.
    var candidateToSorted: int32[]
    for k in 0..<kinds.len:
        let sectionIndex =
            csgcStringIndexGet(
                sortedIndex, sortedKinds, kinds[k])
        if sectionIndex < 0 || sectionIndex >= sections.len:
            var failed: csgCoreCsgcFactSectionsResult
            failed.error = "csgc_kind_partition_failed"
            return failed
        add(candidateToSorted, sectionIndex)

    for i in 0..<orderedLines.len:
        let sectionIndex = candidateToSorted[rowKindIds[i]]
        if sectionIndex < 0 || sectionIndex >= sections.len:
            var failed: csgCoreCsgcFactSectionsResult
            failed.error = "csgc_kind_partition_failed"
            return failed
        add(
            sections[sectionIndex].lineRows, i)

    var result: csgCoreCsgcFactSectionsResult
    result.ok = true
    result.sections = sections
    return result

@borrows
fn csgcDirectoryLen(
        sections: csgCoreCsgcFactSection[]): int64 =
    var size = int64(CsgCoreCsgcDirectoryPrefixSize) +
        int64(CsgCoreCsgcSectionFixedSize + 1)
    for i in 0..<sections.len:
        size = size +
            int64(CsgCoreCsgcSectionFixedSize) +
            int64(csgcVarintLen(sections[i].kind.len)) +
            int64(sections[i].kind.len)
    return size

@borrows
fn csgcCanonicalDictionaryError(
        lines: str[],
        dictionary: str[]): str =
    let tokenLines = csgcBuildTokenLines(lines)
    let expectedDictionary =
        csgcBuildDictionary(tokenLines)
    if expectedDictionary.len != dictionary.len:
        return "non_canonical_dictionary"
    for i in 0..<dictionary.len:
        if expectedDictionary[i] != dictionary[i]:
            return "non_canonical_dictionary"
    return ""

@borrows
fn csgcCanonicalFactOrderError(
        lines: str[]): str =
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            return "csgc_empty_fact_line"
    var orderError: str
    if !merkle_dag.CsgCoreMerklePhysicalOrderIsIdentity(
           lines, orderError):
        if orderError.len > 0:
            return csgcCat("non_canonical_facts ", orderError)
        return "non_canonical_csgc"
    return ""

@borrows
fn CsgCoreCsgcCanonicalProjectionError(
        groupedLines: str[],
        dictionary: str[]): str =
    # Mapped readers must not own a second dictionary or fact-order
    # algorithm.  They decode every physical section, then submit that
    # projection here so the same canonical encoder rules decide whether the
    # complete object has one valid wire representation.
    # groupedLines are section-major, not global physical order. Walk the
    # physical permutation when building the dictionary; do not clone fact
    # payloads into a second seq.
    for lineIndex in 0..<groupedLines.len:
        if groupedLines[lineIndex].len == 0:
            return "csgc_empty_fact_line"
    var orderError: str
    let order =
        merkle_dag.CsgCoreMerklePhysicalOrderIndexesFromCanonical(
            groupedLines, orderError)
    if orderError.len > 0:
        return csgcCat("non_canonical_facts ", orderError)
    if order.len != groupedLines.len:
        return "non_canonical_csgc"
    var tokenLines: CsgCoreCsgcTokenLine[]
    for rank in 0..<order.len:
        let source = order[rank]
        if source < 0 || source >= groupedLines.len:
            return "non_canonical_csgc"
        var tokenLine: CsgCoreCsgcTokenLine
        tokenLine.tokens =
            CsgCoreCsgcTokenizeCanonicalLine(groupedLines[source])
        add(tokenLines, tokenLine)
    let expectedDictionary = csgcBuildDictionary(tokenLines)
    if expectedDictionary.len != dictionary.len:
        return "non_canonical_dictionary"
    for i in 0..<dictionary.len:
        if expectedDictionary[i] != dictionary[i]:
            return "non_canonical_dictionary"
    return ""

fn csgcByteBufAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn csgcByteBufAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    csgcByteBufAppendU32(buf, value.len)
    let valueBytes = rawbytes.BytesFromString(value)
    layout.ByteBufAppendBytes(buf, valueBytes)

@borrows
fn csgcSectionDigest(
        bytes: rawbytes.Bytes,
        tag: int32,
        kind: str,
        itemCount: int32,
        payloadOffset: int32,
        payloadLength: int32): layout.FixedBytes32 =
    var prefixCapacity: int32
    if !csgcCheckedAdd(96, kind.len, prefixCapacity):
        panic("csgc_section_digest_prefix_overflow")
    var prefix = layout.ByteBufInit(prefixCapacity)
    csgcByteBufAppendText(prefix, CsgCoreCsgcSectionHashDomain)
    layout.ByteBufAppendByte(prefix, tag)
    csgcByteBufAppendText(prefix, kind)
    csgcByteBufAppendU32(prefix, itemCount)
    csgcByteBufAppendU32(prefix, payloadLength)
    let allBytes = layout.ByteSpanFromBytes(bytes)
    let payload =
        layout.ByteSpanSlice(
            allBytes, payloadOffset, payloadLength)
    var allBytesData = allBytes.data
    var payloadData = payload.data
    var prefixView = layout.ByteBufView(prefix)
    var prefixViewData = prefixView.data
    let digest = hash256.Sha256FixedTwo(
        prefixView, payload)
    rawbytes.BytesFree(allBytesData)
    rawbytes.BytesFree(payloadData)
    rawbytes.BytesFree(prefixViewData)
    layout.ByteBufFree(prefix)
    return digest

@borrows
fn csgcDirectoryDigest(
        bytes: rawbytes.Bytes,
        headerSize: int32,
        flags: int32,
        factCount: int32,
        bodySize: int32,
        directorySize: int32): layout.FixedBytes32 =
    var prefix = layout.ByteBufInit(128)
    csgcByteBufAppendText(
        prefix, CsgCoreCsgcDirectoryHashDomain)
    csgcByteBufAppendU32(prefix, CsgCoreCsgcMagic)
    csgcByteBufAppendU32(prefix, headerSize)
    csgcByteBufAppendU32(prefix, flags)
    csgcByteBufAppendU32(prefix, factCount)
    csgcByteBufAppendU32(prefix, 0)
    csgcByteBufAppendU32(prefix, bodySize)
    let allBytes = layout.ByteSpanFromBytes(bytes)
    let directoryBytes = layout.ByteSpanSlice(
        allBytes, headerSize, directorySize)
    var allBytesData = allBytes.data
    var directoryBytesData = directoryBytes.data
    var prefixView = layout.ByteBufView(prefix)
    var prefixViewData = prefixView.data
    let digest = hash256.Sha256FixedTwo(
        prefixView, directoryBytes)
    rawbytes.BytesFree(allBytesData)
    rawbytes.BytesFree(directoryBytesData)
    rawbytes.BytesFree(prefixViewData)
    layout.ByteBufFree(prefix)
    return digest

@borrows
fn csgcDirectoryCid(
        bytes: rawbytes.Bytes,
        directory: CsgCoreCsgcSectionDirectory): str =
    let digest = csgcDirectoryDigest(
        bytes,
        directory.headerSize,
        directory.flags,
        directory.factCount,
        directory.bodySize,
        directory.directorySize)
    return csgcCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgcDirectoryShapeValid(
        directory: CsgCoreCsgcSectionDirectory): bool =
    let count = directory.sectionTags.len
    return directory.ok && count >= 1 &&
        directory.sectionKinds.len == count &&
        directory.sectionOffsets.len == count &&
        directory.sectionLengths.len == count &&
        directory.sectionItemCounts.len == count &&
        directory.sectionHashes.len == count

@borrows
fn csgcSectionDigestMatches(
        bytes: rawbytes.Bytes,
        directory: CsgCoreCsgcSectionDirectory,
        sectionIndex: int32): bool =
    if !csgcDirectoryShapeValid(directory) ||
       sectionIndex < 0 ||
       sectionIndex >= directory.sectionTags.len:
        return false
    var absoluteOffset: int32
    if !csgcCheckedAdd(
           CsgCoreCsgcHeaderSize,
           directory.sectionOffsets[sectionIndex],
           absoluteOffset):
        return false
    let digest = csgcSectionDigest(
        bytes,
        directory.sectionTags[sectionIndex],
        directory.sectionKinds[sectionIndex],
        directory.sectionItemCounts[sectionIndex],
        absoluteOffset,
        directory.sectionLengths[sectionIndex])
    return layout.FixedBytes32Equal(
        digest, directory.sectionHashes[sectionIndex])

@borrows
fn csgcWriteSectionEntry(
        bytes: var rawbytes.Bytes,
        offset: int32,
        tag: int32,
        kind: str,
        payloadOffset: int32,
        payloadLength: int32,
        itemCount: int32,
        digest: layout.FixedBytes32): int32 =
    var cursor = offset
    csgcWriteU8(bytes, cursor, tag)
    cursor = cursor + 1
    cursor = csgcWriteUtf8(bytes, cursor, kind)
    csgcWriteU32LE(bytes, cursor, payloadOffset)
    cursor = cursor + 4
    csgcWriteU32LE(bytes, cursor, payloadLength)
    cursor = cursor + 4
    csgcWriteU32LE(bytes, cursor, itemCount)
    cursor = cursor + 4
    csgcWriteFixed32(bytes, cursor, digest)
    return cursor + CsgCoreCsgcSectionDigestSize

@borrows
fn csgcReadHeader(
        bytes: rawbytes.Bytes): csgCoreCsgcHeaderRead =
    let totalLen = rawbytes.BytesLen(bytes)
    if totalLen < CsgCoreCsgcHeaderSize:
        return csgcHeaderFail("truncated_header")
    let magic = csgcReadU32LE(bytes, 0)
    if magic != CsgCoreCsgcMagic:
        return csgcHeaderFail(
            csgcCat("bad_magic ", strings.IntToStr(magic)))
    let headerSize = csgcReadU16LE(bytes, 4)
    if headerSize != CsgCoreCsgcHeaderSize:
        return csgcHeaderFail(
            csgcCat(
                "unsupported_header_size ",
                strings.IntToStr(headerSize)))
    let flags = csgcReadU16LE(bytes, 6)
    if flags != CsgCoreCsgcFlagNone:
        return csgcHeaderFail(
            csgcCat(
                "unsupported_csgc_flags ",
                strings.IntToStr(flags)))
    let factCount = csgcReadU32LE(bytes, 8)
    let compressedSize = csgcReadU32LE(bytes, 12)
    if compressedSize != 0:
        return csgcHeaderFail("compressed_body_unsupported")
    let bodySize = csgcReadU32LE(bytes, 16)
    if factCount < 0 || bodySize < 0:
        return csgcHeaderFail("header_u32_out_of_range")
    let actualBodySize = totalLen - CsgCoreCsgcHeaderSize
    if bodySize != actualBodySize:
        if bodySize > actualBodySize:
            return csgcHeaderFail(
                csgcCat4(
                    "truncated_body_size_mismatch body=",
                    strings.IntToStr(bodySize),
                    " actual=",
                    strings.IntToStr(actualBodySize)))
        return csgcHeaderFail("trailing_bytes")
    for i in 20..<CsgCoreCsgcHeaderSize:
        if csgcReadU8(bytes, i) != 0:
            return csgcHeaderFail("nonzero_reserved_header")
    var result: csgCoreCsgcHeaderRead
    result.ok = true
    result.headerSize = headerSize
    result.flags = flags
    result.factCount = factCount
    result.bodySize = bodySize
    return result

@borrows
fn CsgCoreCsgcParseSectionDirectory(
        bytes: rawbytes.Bytes): CsgCoreCsgcSectionDirectory =
    let header = csgcReadHeader(bytes)
    if !header.ok:
        return csgcDirectoryFail(header.error)
    if header.bodySize < CsgCoreCsgcDirectoryPrefixSize:
        return csgcDirectoryFail("truncated_section_directory")
    let bodyOffset = CsgCoreCsgcHeaderSize
    let directorySize = csgcReadU32LE(bytes, bodyOffset)
    let sectionCount = csgcReadU32LE(bytes, bodyOffset + 4)
    if directorySize < CsgCoreCsgcDirectoryPrefixSize ||
       directorySize > header.bodySize:
        return csgcDirectoryFail(
            "section_directory_size_out_of_range")
    if sectionCount < 1 ||
       sectionCount >
           (directorySize - CsgCoreCsgcDirectoryPrefixSize) /
               (CsgCoreCsgcSectionFixedSize + 1):
        return csgcDirectoryFail("section_count_out_of_range")
    var directoryEnd: int32
    if !csgcCheckedAdd(bodyOffset, directorySize, directoryEnd):
        return csgcDirectoryFail("section_directory_overflow")

    var result: CsgCoreCsgcSectionDirectory
    result.headerSize = header.headerSize
    result.flags = header.flags
    result.factCount = header.factCount
    result.bodySize = header.bodySize
    result.directorySize = directorySize
    var cursor = bodyOffset + CsgCoreCsgcDirectoryPrefixSize
    var expectedPayloadOffset = directorySize
    var previousKind: str
    var countedFacts: int32
    for i in 0..<sectionCount:
        if cursor >= directoryEnd:
            return csgcDirectoryFail("truncated_section_entry")
        let tag = csgcReadU8(bytes, cursor)
        cursor = cursor + 1
        let kindLenRead =
            csgcReadVarintBounded(bytes, cursor, directoryEnd)
        if !kindLenRead.ok:
            return csgcDirectoryFail(
                csgcCat(
                    "truncated_section_kind ",
                    kindLenRead.error))
        let kindLen = kindLenRead.value
        if kindLen < 0 || kindLen > 2147483647 - 96:
            return csgcDirectoryFail(
                "section_kind_size_out_of_range")
        cursor = kindLenRead.nextOffset
        var kindEnd: int32
        if !csgcCheckedRangeEnd(
               cursor, kindLen, directoryEnd, kindEnd):
            return csgcDirectoryFail("truncated_section_kind_bytes")
        if !csgcUtf8Valid(bytes, cursor, kindLen):
            return csgcDirectoryFail("invalid_section_kind_utf8")
        let kind = csgcSliceString(bytes, cursor, kindLen)
        cursor = kindEnd
        var entryEnd: int32
        if !csgcCheckedRangeEnd(
               cursor, 12 + CsgCoreCsgcSectionDigestSize,
               directoryEnd, entryEnd):
            return csgcDirectoryFail("truncated_section_entry")
        let payloadOffset = csgcReadU32LE(bytes, cursor)
        let payloadLength = csgcReadU32LE(bytes, cursor + 4)
        let itemCount = csgcReadU32LE(bytes, cursor + 8)
        cursor = cursor + 12
        var digest: layout.FixedBytes32
        if !csgcReadFixed32(
               bytes, cursor, directoryEnd, digest):
            return csgcDirectoryFail("truncated_section_cid")
        cursor = entryEnd
        if payloadOffset < 0 || payloadLength < 0 ||
           itemCount < 0:
            return csgcDirectoryFail("section_u32_out_of_range")
        if i == 0:
            if tag != CsgCoreCsgcSectionDictionary || kind.len != 0:
                return csgcDirectoryFail(
                    "non_canonical_dictionary_section")
        else:
            if tag != CsgCoreCsgcSectionFactKind || kind.len == 0:
                return csgcDirectoryFail(
                    "non_canonical_fact_section")
            if previousKind.len > 0 &&
               csgcUtf8ByteCompare(previousKind, kind) >= 0:
                return csgcDirectoryFail(
                    "non_canonical_section_order")
            previousKind = strings.CloneStr(kind)
            if itemCount == 0:
                return csgcDirectoryFail("empty_fact_section")
        if payloadLength < 4:
            return csgcDirectoryFail("section_length_out_of_range")
        if payloadOffset < expectedPayloadOffset:
            return csgcDirectoryFail("section_overlap")
        if payloadOffset > expectedPayloadOffset:
            return csgcDirectoryFail("non_canonical_section_gap")
        var payloadEnd: int32
        if !csgcCheckedRangeEnd(
               payloadOffset, payloadLength,
               header.bodySize, payloadEnd):
            return csgcDirectoryFail("section_range_out_of_bounds")
        expectedPayloadOffset = payloadEnd
        if i == 0:
            if itemCount > 134217728:
                return csgcDirectoryFail(
                    "dictionary_count_out_of_range")
            if itemCount > (payloadLength - 4) / 3:
                return csgcDirectoryFail(
                    "dictionary_count_out_of_range")
        else:
            if itemCount > payloadLength - 4:
                return csgcDirectoryFail("fact_count_out_of_range")
            if countedFacts > 2147483647 - itemCount:
                return csgcDirectoryFail("fact_count_overflow")
            countedFacts = countedFacts + itemCount
        add(result.sectionTags, tag)
        add(result.sectionKinds, kind)
        add(result.sectionOffsets, payloadOffset)
        add(result.sectionLengths, payloadLength)
        add(result.sectionItemCounts, itemCount)
        add(result.sectionHashes, digest)

    if cursor != directoryEnd:
        return csgcDirectoryFail(
            "non_canonical_section_directory_size")
    if expectedPayloadOffset != header.bodySize:
        return csgcDirectoryFail("trailing_bytes")
    if countedFacts != header.factCount:
        return csgcDirectoryFail(
            csgcCat4(
                "fact_count_mismatch header=",
                strings.IntToStr(header.factCount),
                " sections=",
                strings.IntToStr(countedFacts)))
    result.ok = true
    return result

@borrows
fn CsgCoreCsgcClaimDirectory(
        bytes: rawbytes.Bytes): CsgCoreCsgcDirectoryClaim =
    let directory =
        CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        var failed: CsgCoreCsgcDirectoryClaim
        failed.error = strings.CloneStr(directory.error)
        return failed
    let directoryCid =
        csgcDirectoryCid(bytes, directory)
    if directory.factCount < 0 ||
       directoryCid.len != 71 ||
       !strings.HasPrefix(directoryCid, "sha256:"):
        var failed: CsgCoreCsgcDirectoryClaim
        failed.error = "csgc_directory_claim_invalid"
        return failed
    var out: CsgCoreCsgcDirectoryClaim
    out.ok = true
    out.factCount = directory.factCount
    out.directoryCid = strings.CloneStr(directoryCid)
    return out

fn CsgCoreCsgcSectionIteratorInit(): CsgCoreCsgcSectionIterator =
    # `iterator` 为词法硬关键字(parser.cheng:14203 关键字表), 不能作绑定名
    # (stage3 宽松接受, committed parser 拒) —— 规范迁移改名 iter。
    var iter: CsgCoreCsgcSectionIterator
    return iter

@borrows
fn CsgCoreCsgcSectionIteratorNext(
        directory: CsgCoreCsgcSectionDirectory,
        iter: var CsgCoreCsgcSectionIterator): CsgCoreCsgcSectionView =
    if !csgcDirectoryShapeValid(directory):
        return csgcSectionViewFail("section_directory_not_valid")
    if iter.nextIndex < 0 ||
       iter.nextIndex > directory.sectionTags.len:
        return csgcSectionViewFail("section_iterator_out_of_range")
    if iter.nextIndex == directory.sectionTags.len:
        var done: CsgCoreCsgcSectionView
        done.ok = true
        done.done = true
        return done
    let index = iter.nextIndex
    iter.nextIndex = iter.nextIndex + 1
    var view: CsgCoreCsgcSectionView
    view.ok = true
    view.index = index
    view.tag = directory.sectionTags[index]
    view.kind = strings.CloneStr(directory.sectionKinds[index])
    view.offset = directory.sectionOffsets[index]
    view.length = directory.sectionLengths[index]
    view.itemCount = directory.sectionItemCounts[index]
    view.claimedCid = csgcCat(
        "sha256:",
        layout.FixedBytes32Hex(directory.sectionHashes[index]))
    return view

@borrows
fn CsgCoreCsgcEncodeCanonicalLines(lines: str[]): CsgCoreCsgcBytesResult =
    var orderError: str
    var orderedLines =
        csgcCanonicalFactOrder(lines, orderError)
    if orderError.len > 0:
        return csgcBytesFail(orderError)
    return csgcEncodeFromOrdered(orderedLines)

@borrows
fn CsgCoreCsgcEncodeVerifiedLines(
        lines: str[]): CsgCoreCsgcBytesResult =
    # Precondition: the caller has already proven every line non-empty
    # and byte-identical to its own canonical form (the pack CLI does
    # this while reading).  Skip the redundant parse+serialize passes
    # and derive the ordering keys straight from the verified text.
    var canonicalLines: str[]
    var factKeys: str[]
    var keyHashes: layout.FixedBytes32[]
    for i in 0..<lines.len:
        if lines[i].len == 0:
            return csgcBytesFail("csgc_empty_fact_line")
        let factHash =
            merkle_dag.csgMerkleFactHashCanonical(lines[i])
        var keyError: str
        let key =
            merkle_dag.csgMerkleKeyForFact(
                lines[i], factHash, keyError)
        if keyError.len > 0:
            return csgcBytesFail(keyError)
        add(canonicalLines, share(lines[i]))
        add(factKeys, strings.CloneStr(key))
        add(keyHashes, merkle_dag.csgMerkleKeyHash(key))
    var orderError: str
    let order =
        merkle_dag.csgMerklePhysicalOrderIndexes(
            factKeys, keyHashes, orderError)
    if orderError.len > 0:
        return csgcBytesFail(
            csgcCat("csgc_physical_order_failed ", orderError))
    var ordered: str[]
    for rank in 0..<order.len:
        add(
            ordered,
            share(canonicalLines[order[rank]]))
    return csgcEncodeFromOrdered(ordered)

fn CsgCoreCsgcEncodeCanonicalLinesConsume(
        lines: var str[]): CsgCoreCsgcBytesResult =
    # Move fact payloads into encoder order. Receipt decode already
    # dropped the DecodeLines set; do not clone a second copy here.
    var orderError: str
    let order =
        merkle_dag.CsgCoreMerklePhysicalOrderIndexesFromCanonical(
            lines, orderError)
    if orderError.len > 0:
        return csgcBytesFail(
            csgcCat("csgc_physical_order_failed ", orderError))
    if order.len != lines.len:
        return csgcBytesFail("csgc_empty_fact_line")
    var ordered: str[]
    for rank in 0..<order.len:
        let source = order[rank]
        if source < 0 || source >= lines.len:
            return csgcBytesFail("non_canonical_csgc")
        var line = lines[source]
        lines[source] = ""
        add(ordered, line)
    return csgcEncodeFromOrdered(ordered)

fn csgcEncodeFromOrdered(
        orderedLines: var str[]): CsgCoreCsgcBytesResult =
    var allTokenLines = csgcBuildTokenLines(orderedLines)
    var sectionResult =
        csgcBuildFactSections(orderedLines)
    let orderedFactCount = orderedLines.len
    seqs.freeSeqStrRelease(orderedLines)
    if !sectionResult.ok:
        return csgcBytesFail(sectionResult.error)
    let dictionary = csgcBuildDictionary(allTokenLines)
    csgcBuildTokenRefs(allTokenLines, dictionary)
    var sections = sectionResult.sections
    let directoryLen64 = csgcDirectoryLen(sections)
    let dictionaryPayloadLen64 =
        csgcDictionaryPayloadLen(dictionary)
    var bodyLen64 = directoryLen64 + dictionaryPayloadLen64
    for i in 0..<sections.len:
        let payloadLen64 =
            csgcFactSectionPayloadLen(
                allTokenLines, sections[i].lineRows)
        if payloadLen64 < int64(4) ||
           payloadLen64 > int64(2147483647):
            return csgcBytesFail(
                "csgc_fact_section_size_out_of_range")
        sections[i].payloadLength = Int32(payloadLen64)
        bodyLen64 = bodyLen64 + payloadLen64
    if bodyLen64 < int64(0) ||
       bodyLen64 >
           int64(2147483647 - CsgCoreCsgcHeaderSize):
        return csgcBytesFail("csgc_body_size_out_of_range")
    if directoryLen64 > int64(2147483647) ||
       dictionaryPayloadLen64 > int64(2147483647):
        return csgcBytesFail("csgc_section_size_out_of_range")
    let bodyLen = Int32(bodyLen64)
    let directoryLen = Int32(directoryLen64)
    let dictionaryPayloadLen = Int32(dictionaryPayloadLen64)
    let dictionaryPayloadOffset = directoryLen
    var nextPayloadOffset: int32
    if !csgcCheckedAdd(
           dictionaryPayloadOffset,
           dictionaryPayloadLen,
           nextPayloadOffset):
        return csgcBytesFail("csgc_section_offset_overflow")
    for i in 0..<sections.len:
        sections[i].payloadOffset = nextPayloadOffset
        if !csgcCheckedAdd(
               nextPayloadOffset,
               sections[i].payloadLength,
               nextPayloadOffset):
            return csgcBytesFail("csgc_section_offset_overflow")
    if nextPayloadOffset != bodyLen:
        return csgcBytesFail("csgc_body_layout_mismatch")
    let totalLen = CsgCoreCsgcHeaderSize + bodyLen
    var bytes = rawbytes.BytesAlloc(totalLen)
    if rawbytes.BytesLen(bytes) != totalLen:
        return csgcBytesFail("alloc_failed")

    csgcWriteU32LE(bytes, 0, CsgCoreCsgcMagic)
    csgcWriteU16LE(bytes, 4, CsgCoreCsgcHeaderSize)
    csgcWriteU16LE(bytes, 6, CsgCoreCsgcFlagNone)
    csgcWriteU32LE(bytes, 8, orderedFactCount)
    csgcWriteU32LE(bytes, 12, 0)
    csgcWriteU32LE(bytes, 16, bodyLen)
    for i in 20..<CsgCoreCsgcHeaderSize:
        csgcWriteU8(bytes, i, 0)

    csgcWriteU32LE(
        bytes, CsgCoreCsgcHeaderSize, directoryLen)
    csgcWriteU32LE(
        bytes, CsgCoreCsgcHeaderSize + 4,
        sections.len + 1)

    var offset =
        CsgCoreCsgcHeaderSize + dictionaryPayloadOffset
    csgcWriteU32LE(bytes, offset, dictionary.len)
    offset = offset + 4
    for i in 0..<dictionary.len:
        offset = csgcWriteUtf8(bytes, offset, dictionary[i])
    if offset != CsgCoreCsgcHeaderSize +
                     dictionaryPayloadOffset +
                     dictionaryPayloadLen:
        rawbytes.BytesFree(bytes)
        return csgcBytesFail(
            "csgc_dictionary_section_size_mismatch")

    for sectionIndex in 0..<sections.len:
        offset = CsgCoreCsgcHeaderSize +
            sections[sectionIndex].payloadOffset
        csgcWriteU32LE(
            bytes, offset,
            sections[sectionIndex].lineRows.len)
        offset = offset + 4
        for i in 0..<sections[sectionIndex].lineRows.len:
            let row = sections[sectionIndex].lineRows[i]
            if row < 0 || row >= allTokenLines.len:
                rawbytes.BytesFree(bytes)
                return csgcBytesFail(
                    "csgc_fact_section_row_out_of_range")
            offset = csgcWriteVarint(
                bytes,
                offset,
                allTokenLines[row].tokens.len)
            for j in 0..<allTokenLines[row].tokens.len:
                let dictIndex =
                    allTokenLines[row].dictRefs[j]
                if dictIndex >= 0:
                    csgcWriteU8(
                        bytes, offset, CsgCoreCsgcTokenDictRef)
                    offset = offset + 1
                    offset = csgcWriteVarint(
                        bytes, offset, dictIndex)
                else:
                    csgcWriteU8(
                        bytes, offset, CsgCoreCsgcTokenInlineUtf8)
                    offset = offset + 1
                    offset = csgcWriteUtf8(
                        bytes,
                        offset,
                        allTokenLines[row].tokens[j])
        if offset != CsgCoreCsgcHeaderSize +
                         sections[sectionIndex].payloadOffset +
                         sections[sectionIndex].payloadLength:
            rawbytes.BytesFree(bytes)
            return csgcBytesFail(
                "csgc_fact_section_size_mismatch")

    let dictionaryDigest = csgcSectionDigest(
        bytes,
        CsgCoreCsgcSectionDictionary,
        "",
        dictionary.len,
        CsgCoreCsgcHeaderSize + dictionaryPayloadOffset,
        dictionaryPayloadLen)
    for i in 0..<sections.len:
        sections[i].digest = csgcSectionDigest(
            bytes,
            CsgCoreCsgcSectionFactKind,
            sections[i].kind,
            sections[i].lineRows.len,
            CsgCoreCsgcHeaderSize + sections[i].payloadOffset,
            sections[i].payloadLength)

    var directoryCursor =
        CsgCoreCsgcHeaderSize + CsgCoreCsgcDirectoryPrefixSize
    directoryCursor = csgcWriteSectionEntry(
        bytes,
        directoryCursor,
        CsgCoreCsgcSectionDictionary,
        "",
        dictionaryPayloadOffset,
        dictionaryPayloadLen,
        dictionary.len,
        dictionaryDigest)
    for i in 0..<sections.len:
        directoryCursor = csgcWriteSectionEntry(
            bytes,
            directoryCursor,
            CsgCoreCsgcSectionFactKind,
            sections[i].kind,
            sections[i].payloadOffset,
            sections[i].payloadLength,
            sections[i].lineRows.len,
            sections[i].digest)
    if directoryCursor != CsgCoreCsgcHeaderSize + directoryLen:
        rawbytes.BytesFree(bytes)
        return csgcBytesFail(
            "csgc_section_directory_size_mismatch")

    let encodedDirectory =
        CsgCoreCsgcParseSectionDirectory(bytes)
    if !encodedDirectory.ok:
        rawbytes.BytesFree(bytes)
        return csgcBytesFail(encodedDirectory.error)
    let claimedDirectoryCid =
        csgcDirectoryCid(bytes, encodedDirectory)
    var result: CsgCoreCsgcBytesResult
    result.ok = true
    result.headerSize = CsgCoreCsgcHeaderSize
    result.flags = CsgCoreCsgcFlagNone
    result.factCount = orderedFactCount
    result.dictionaryCount = dictionary.len
    result.claimedDirectoryCid =
        claimedDirectoryCid
    result.bytes = bytes
    return result

@borrows
fn csgcDecodeDictionarySection(
        bytes: rawbytes.Bytes,
        directory: CsgCoreCsgcSectionDirectory): csgCoreCsgcDecodedDictionary =
    if !csgcDirectoryShapeValid(directory):
        return csgcDecodedDictionaryFail("section_directory_not_valid")
    if !csgcSectionDigestMatches(bytes, directory, 0):
        return csgcDecodedDictionaryFail("section_cid_mismatch")
    var start: int32
    if !csgcCheckedAdd(
           CsgCoreCsgcHeaderSize,
           directory.sectionOffsets[0], start):
        return csgcDecodedDictionaryFail("section_range_out_of_bounds")
    var finish: int32
    if !csgcCheckedRangeEnd(
           start, directory.sectionLengths[0],
           rawbytes.BytesLen(bytes), finish):
        return csgcDecodedDictionaryFail("section_range_out_of_bounds")
    let dictCount = csgcReadU32LE(bytes, start)
    if dictCount < 0 ||
       dictCount != directory.sectionItemCounts[0]:
        return csgcDecodedDictionaryFail("dictionary_count_mismatch")
    var dictionary: str[]
    var dictionaryIndex = csgcStringIndexInit(dictCount)
    var cursor = start + 4
    for i in 0..<dictCount:
        let lenRead =
            csgcReadVarintBounded(bytes, cursor, finish)
        if !lenRead.ok:
            return csgcDecodedDictionaryFail(
                csgcCat("truncated_dict_len ", lenRead.error))
        let itemLen = lenRead.value
        cursor = lenRead.nextOffset
        if itemLen < 2:
            return csgcDecodedDictionaryFail(
                "non_canonical_dictionary_entry")
        if cursor > finish - itemLen:
            return csgcDecodedDictionaryFail("truncated_dict_bytes")
        if !csgcUtf8Valid(bytes, cursor, itemLen):
            return csgcDecodedDictionaryFail("invalid_utf8")
        let item = csgcSliceString(bytes, cursor, itemLen)
        if csgcStringIndexGet(
               dictionaryIndex, dictionary, item) >= 0:
            return csgcDecodedDictionaryFail(
                "duplicate_dictionary_entry")
        if dictionary.len > 0 &&
           csgcUtf8ByteCompare(
               dictionary[dictionary.len - 1], item) >= 0:
            return csgcDecodedDictionaryFail(
                "non_canonical_dictionary_order")
        let insertion = csgcStringIndexLookup(
            dictionaryIndex, dictionary, item)
        if !insertion.ok || insertion.foundIndex >= 0 ||
           insertion.slot < 0:
            return csgcDecodedDictionaryFail(
                "dictionary_index_insert_failed")
        add(dictionary, item)
        dictionaryIndex.slots[insertion.slot] = dictionary.len
        dictionaryIndex.used = dictionaryIndex.used + 1
        cursor = cursor + itemLen
    if cursor != finish:
        return csgcDecodedDictionaryFail(
            "non_canonical_dictionary_section_size")
    var result: csgCoreCsgcDecodedDictionary
    result.ok = true
    result.sectionBytes = directory.sectionLengths[0]
    result.index = dictionaryIndex
    result.entries = dictionary
    return result

@borrows
fn csgcDecodeFactSection(
        bytes: rawbytes.Bytes,
        directory: CsgCoreCsgcSectionDirectory,
        sectionIndex: int32,
        dictionary: str[],
        dictionaryIndex: csgCoreCsgcStringIndex): CsgCoreCsgcLinesResult =
    if !csgcDirectoryShapeValid(directory) ||
       sectionIndex <= 0 ||
       sectionIndex >= directory.sectionTags.len:
        return csgcFail("fact_section_index_out_of_range")
    if !csgcSectionDigestMatches(
           bytes, directory, sectionIndex):
        return csgcFail("section_cid_mismatch")
    var start: int32
    if !csgcCheckedAdd(
           CsgCoreCsgcHeaderSize,
           directory.sectionOffsets[sectionIndex], start):
        return csgcFail("section_range_out_of_bounds")
    var finish: int32
    if !csgcCheckedRangeEnd(
           start,
           directory.sectionLengths[sectionIndex],
           rawbytes.BytesLen(bytes), finish):
        return csgcFail("section_range_out_of_bounds")
    let sectionFactCount = csgcReadU32LE(bytes, start)
    if sectionFactCount < 0 ||
       sectionFactCount !=
           directory.sectionItemCounts[sectionIndex]:
        return csgcFail("section_fact_count_mismatch")
    var lines: str[]
    var cursor = start + 4
    for i in 0..<sectionFactCount:
        let lineRead = csgcDecodeLine(
            bytes,
            dictionary,
            dictionaryIndex,
            finish,
            cursor)
        if !lineRead.ok:
            return csgcFail(lineRead.error)
        let kind = field.CsgCoreJsonKind(lineRead.line)
        if !kind.found ||
           kind.value != directory.sectionKinds[sectionIndex]:
            return csgcFail("fact_kind_section_mismatch")
        cursor = lineRead.nextOffset
        add(lines, strings.CloneStr(lineRead.line))
    if cursor != finish:
        return csgcFail("non_canonical_fact_section_size")
    let orderError = csgcCanonicalFactOrderError(lines)
    if orderError.len > 0:
        return csgcFail(orderError)
    var result: CsgCoreCsgcLinesResult
    result.ok = true
    result.lines = lines
    result.factCount = sectionFactCount
    return result

@borrows
fn csgcFindFactSection(
        directory: CsgCoreCsgcSectionDirectory,
        kind: str): int32 =
    var low: int32 = 1
    var high = directory.sectionKinds.len
    while low < high:
        let middle = low + (high - low) / 2
        let order = csgcUtf8ByteCompare(
            directory.sectionKinds[middle], kind)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < directory.sectionKinds.len &&
       directory.sectionKinds[low] == kind:
        return low
    return -1

@borrows
fn CsgCoreCsgcDecodeDictionary(
        bytes: rawbytes.Bytes): CsgCoreCsgcDictionaryResult =
    let directory = CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        return csgcDictionaryFail(directory.error)
    let decoded = csgcDecodeDictionarySection(bytes, directory)
    if !decoded.ok:
        return csgcDictionaryFail(decoded.error)
    var result: CsgCoreCsgcDictionaryResult
    result.ok = true
    result.sectionBytes = decoded.sectionBytes
    result.entries = decoded.entries
    return result

@borrows
fn CsgCoreCsgcDecodeFactKindClaimed(
        bytes: rawbytes.Bytes,
        kind: str): CsgCoreCsgcLazyLinesResult =
    if kind.len == 0:
        return csgcLazyFail("fact_kind_empty")
    let directory = CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        return csgcLazyFail(directory.error)
    let claimedDirectoryCid =
        csgcDirectoryCid(bytes, directory)
    let sectionIndex = csgcFindFactSection(directory, kind)
    if sectionIndex < 0:
        var empty: CsgCoreCsgcLazyLinesResult
        empty.ok = true
        empty.kind = strings.CloneStr(kind)
        empty.totalFactCount = directory.factCount
        empty.directoryBytes = directory.directorySize
        empty.claimedDirectoryCid =
            strings.CloneStr(claimedDirectoryCid)
        return empty
    let dictionary =
        csgcDecodeDictionarySection(bytes, directory)
    if !dictionary.ok:
        return csgcLazyFail(dictionary.error)
    let decoded = csgcDecodeFactSection(
        bytes,
        directory,
        sectionIndex,
        dictionary.entries,
        dictionary.index)
    if !decoded.ok:
        return csgcLazyFail(decoded.error)
    var decodedSectionBytes: int32
    if !csgcCheckedAdd(
           dictionary.sectionBytes,
           directory.sectionLengths[sectionIndex],
           decodedSectionBytes):
        return csgcLazyFail("decoded_section_size_overflow")
    var result: CsgCoreCsgcLazyLinesResult
    result.ok = true
    result.found = true
    result.kind = strings.CloneStr(kind)
    result.totalFactCount = directory.factCount
    result.decodedFactCount = decoded.factCount
    result.dictionaryCount = dictionary.entries.len
    result.directoryBytes = directory.directorySize
    result.decodedSectionBytes = decodedSectionBytes
    result.claimedDirectoryCid =
        strings.CloneStr(claimedDirectoryCid)
    result.lines = decoded.lines
    return result

@borrows
fn CsgCoreCsgcRestoreLinesByExpectedKind(
        lines: str[],
        expectedKinds: str[],
        err: var str): str[] =
    var ordered: str[]
    if lines.len != expectedKinds.len || expectedKinds.len <= 0:
        err = "csgc_line_kind_count_mismatch"
        return ordered
    setLen(ordered, expectedKinds.len)
    var seen: bool[]
    setLen(seen, expectedKinds.len)
    for lineIndex in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[lineIndex])
        if !kind.found:
            err = "csgc_line_kind_missing"
            var empty: str[]
            return empty
        var slot: int32 = -1
        for expected in 0..<expectedKinds.len:
            if slot < 0 && expectedKinds[expected] == kind.value:
                slot = expected
        if slot < 0 || seen[slot]:
            err = "csgc_line_kind_order_mismatch"
            var empty: str[]
            return empty
        seen[slot] = true
        ordered[slot] = strings.CloneStr(lines[lineIndex])
    for expected in 0..<expectedKinds.len:
        if !seen[expected]:
            err = "csgc_line_kind_order_mismatch"
            var empty: str[]
            return empty
    err = ""
    return ordered

@borrows
fn CsgCoreCsgcDecodeLines(
        bytes: rawbytes.Bytes): CsgCoreCsgcLinesResult =
    let directory = CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        return csgcFail(directory.error)
    let dictionary =
        csgcDecodeDictionarySection(bytes, directory)
    if !dictionary.ok:
        return csgcFail(dictionary.error)
    var groupedLines: str[]
    for sectionIndex in 1..<directory.sectionTags.len:
        var decoded = csgcDecodeFactSection(
            bytes,
            directory,
            sectionIndex,
            dictionary.entries,
            dictionary.index)
        if !decoded.ok:
            return csgcFail(decoded.error)
        for i in 0..<decoded.lines.len:
            var line = decoded.lines[i]
            decoded.lines[i] = ""
            add(groupedLines, line)
    if groupedLines.len != directory.factCount:
        return csgcFail("decoded_fact_count_mismatch")
    var orderError: str
    let order =
        merkle_dag.CsgCoreMerklePhysicalOrderIndexesFromCanonical(
            groupedLines, orderError)
    if orderError.len > 0:
        return csgcFail(csgcCat("csgc_physical_order_failed ", orderError))
    if order.len != groupedLines.len:
        return csgcFail("csgc_empty_fact_line")
    var orderedLines: str[]
    for rank in 0..<order.len:
        let source = order[rank]
        if source < 0 || source >= groupedLines.len:
            return csgcFail("non_canonical_csgc")
        var line = groupedLines[source]
        groupedLines[source] = ""
        add(orderedLines, line)
    let dictionaryError = csgcCanonicalDictionaryError(
        orderedLines, dictionary.entries)
    if dictionaryError.len > 0:
        return csgcFail(dictionaryError)
    var result: CsgCoreCsgcLinesResult
    result.ok = true
    result.lines = orderedLines
    result.headerSize = directory.headerSize
    result.flags = directory.flags
    result.factCount = directory.factCount
    return result

@borrows
fn csgcDecodedFactLineFail(error: str): CsgCoreCsgcDecodedFactLine =
    var result: CsgCoreCsgcDecodedFactLine
    result.error = strings.CloneStr(error)
    return result

fn csgcFactLineStreamDropSectionKeys(
        stream: var CsgCoreCsgcFactLineStream) =
    seqs.freeSeqStrRelease(stream.sectionKeys)
    seqs.chengSeqFreeTyped(stream.sectionKeyHashes)

@borrows
fn csgcSectionKeysPhysicalIdentityError(
        keys: str[],
        keyHashes: layout.FixedBytes32[]): str =
    if keys.len != keyHashes.len:
        return "merkle_physical_order_shape_mismatch"
    if keys.len <= 0:
        return ""
    var orderError: str
    let order = merkle_dag.csgMerklePhysicalOrderIndexes(
        keys, keyHashes, orderError)
    if orderError.len > 0:
        return orderError
    if order.len != keys.len:
        return "non_canonical_csgc"
    for i in 0..<order.len:
        if order[i] != i:
            return "non_canonical_csgc"
    return ""

@borrows
fn CsgCoreCsgcFactLineStreamOpen(
        bytes: rawbytes.Bytes): CsgCoreCsgcFactLineStream =
    var stream: CsgCoreCsgcFactLineStream
    let directory = CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        stream.error = strings.CloneStr(directory.error)
        return stream
    let dictionary = csgcDecodeDictionarySection(bytes, directory)
    if !dictionary.ok:
        stream.error = strings.CloneStr(dictionary.error)
        return stream
    stream.ok = true
    stream.directory = directory
    stream.dictionary = dictionary.entries
    stream.dictionaryIndex = dictionary.index
    stream.sectionIndex = 1
    stream.factCount = directory.factCount
    return stream

fn CsgCoreCsgcFactLineStreamClose(
        stream: var CsgCoreCsgcFactLineStream) =
    seqs.freeSeqStrRelease(stream.dictionary)
    csgcFactLineStreamDropSectionKeys(stream)
    stream.ok = false
    stream.remaining = 0
    stream.yielded = 0
    stream.factCount = 0
    stream.sectionIndex = 0
    stream.cursor = 0
    stream.finish = 0

@borrows
fn CsgCoreCsgcFactLineStreamNext(
        bytes: rawbytes.Bytes,
        stream: var CsgCoreCsgcFactLineStream):
        CsgCoreCsgcDecodedFactLine =
    if !stream.ok:
        if stream.error.len > 0:
            return csgcDecodedFactLineFail(stream.error)
        return csgcDecodedFactLineFail("csgc_fact_line_stream_closed")
    while stream.remaining <= 0:
        if stream.sectionIndex >= stream.directory.sectionTags.len:
            if stream.yielded != stream.factCount:
                stream.ok = false
                return csgcDecodedFactLineFail(
                    "decoded_fact_count_mismatch")
            var done: CsgCoreCsgcDecodedFactLine
            done.ok = true
            done.done = true
            return done
        let sectionIndex = stream.sectionIndex
        if !csgcDirectoryShapeValid(stream.directory) ||
           sectionIndex <= 0 ||
           sectionIndex >= stream.directory.sectionTags.len:
            stream.ok = false
            return csgcDecodedFactLineFail(
                "fact_section_index_out_of_range")
        if !csgcSectionDigestMatches(
               bytes, stream.directory, sectionIndex):
            stream.ok = false
            return csgcDecodedFactLineFail("section_cid_mismatch")
        var start: int32
        if !csgcCheckedAdd(
               CsgCoreCsgcHeaderSize,
               stream.directory.sectionOffsets[sectionIndex],
               start):
            stream.ok = false
            return csgcDecodedFactLineFail(
                "section_range_out_of_bounds")
        var finish: int32
        if !csgcCheckedRangeEnd(
               start,
               stream.directory.sectionLengths[sectionIndex],
               rawbytes.BytesLen(bytes),
               finish):
            stream.ok = false
            return csgcDecodedFactLineFail(
                "section_range_out_of_bounds")
        let sectionFactCount = csgcReadU32LE(bytes, start)
        if sectionFactCount < 0 ||
           sectionFactCount !=
               stream.directory.sectionItemCounts[sectionIndex]:
            stream.ok = false
            return csgcDecodedFactLineFail(
                "section_fact_count_mismatch")
        stream.cursor = start + 4
        stream.finish = finish
        stream.remaining = sectionFactCount
        stream.sectionIndex = sectionIndex + 1
        csgcFactLineStreamDropSectionKeys(stream)
        if stream.remaining <= 0:
            if stream.cursor != stream.finish:
                stream.ok = false
                return csgcDecodedFactLineFail(
                    "non_canonical_fact_section_size")
    let lineRead = csgcDecodeLine(
        bytes,
        stream.dictionary,
        stream.dictionaryIndex,
        stream.finish,
        stream.cursor)
    if !lineRead.ok:
        stream.ok = false
        return csgcDecodedFactLineFail(lineRead.error)
    let kind = field.CsgCoreJsonKind(lineRead.line)
    let openedSection = stream.sectionIndex - 1
    if !kind.found ||
       openedSection <= 0 ||
       openedSection >= stream.directory.sectionKinds.len ||
       kind.value != stream.directory.sectionKinds[openedSection]:
        stream.ok = false
        return csgcDecodedFactLineFail("fact_kind_section_mismatch")
    let factHash =
        merkle_dag.csgMerkleFactHashCanonical(lineRead.line)
    var keyError: str
    let key = merkle_dag.csgMerkleKeyForFact(
        lineRead.line, factHash, keyError)
    if keyError.len > 0:
        stream.ok = false
        return csgcDecodedFactLineFail(keyError)
    add(stream.sectionKeys, strings.CloneStr(key))
    add(stream.sectionKeyHashes, merkle_dag.csgMerkleKeyHash(key))
    stream.cursor = lineRead.nextOffset
    stream.remaining = stream.remaining - 1
    stream.yielded = stream.yielded + 1
    if stream.remaining <= 0:
        if stream.cursor != stream.finish:
            stream.ok = false
            return csgcDecodedFactLineFail(
                "non_canonical_fact_section_size")
        let orderError = csgcSectionKeysPhysicalIdentityError(
            stream.sectionKeys, stream.sectionKeyHashes)
        csgcFactLineStreamDropSectionKeys(stream)
        if orderError.len > 0:
            stream.ok = false
            return csgcDecodedFactLineFail(
                csgcCat("non_canonical_facts ", orderError))
    var result: CsgCoreCsgcDecodedFactLine
    result.ok = true
    result.line = lineRead.line
    return result

@borrows
fn csgcProjectionCidTextValid(value: str): bool =
    if value.len != 71 ||
       !strings.HasPrefix(value, "sha256:"):
        return false
    for i in 7..<value.len:
        let c = value[i]
        if !((c >= '0' && c <= '9') ||
             (c >= 'a' && c <= 'f')):
            return false
    return true

@borrows
fn CsgCoreCsgcProjectionReceiptCid(
        receipt: CsgCoreCsgcProjectionReceipt): str =
    var preimage = layout.ByteBufInit(512)
    csgcByteBufAppendText(
        preimage, CsgCoreCsgcProjectionReceiptDomain)
    csgcByteBufAppendText(preimage, receipt.sourceFactsRoot)
    csgcByteBufAppendText(preimage, receipt.formatId)
    csgcByteBufAppendText(
        preimage, strings.IntToStr(receipt.factCount))
    csgcByteBufAppendText(
        preimage, strings.IntToStr(receipt.byteCount))
    csgcByteBufAppendText(preimage, receipt.directoryCid)
    csgcByteBufAppendText(preimage, receipt.objectCid)
    var preimageView = layout.ByteBufView(preimage)
    var preimageViewData = preimageView.data
    let digest = hash256.Sha256Fixed(preimageView)
    rawbytes.BytesFree(preimageViewData)
    layout.ByteBufFree(preimage)
    return csgcCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn CsgCoreCsgcProjectionReceiptStructuralError(
        receipt: CsgCoreCsgcProjectionReceipt): str =
    if !receipt.ok || receipt.error.len > 0:
        return "csgc_projection_receipt_failed"
    if receipt.formatId.len == 0:
        return "csgc_projection_format_invalid"
    if receipt.factCount < 0 ||
       receipt.byteCount != rawbytes.BytesLen(receipt.bytes) ||
       receipt.byteCount < CsgCoreCsgcHeaderSize:
        return "csgc_projection_count_invalid"
    if !csgcProjectionCidTextValid(receipt.sourceFactsRoot) ||
       !csgcProjectionCidTextValid(receipt.directoryCid) ||
       !csgcProjectionCidTextValid(receipt.objectCid) ||
       !csgcProjectionCidTextValid(receipt.receiptCid):
        return "csgc_projection_cid_invalid"
    if CsgCoreCsgcProjectionReceiptCid(receipt) !=
       receipt.receiptCid:
        return "csgc_projection_receipt_cid_mismatch"
    let claim = CsgCoreCsgcClaimDirectory(receipt.bytes)
    if !claim.ok || claim.factCount != receipt.factCount ||
       claim.directoryCid != receipt.directoryCid:
        return "csgc_projection_directory_mismatch"
    if merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
           receipt.bytes) != receipt.objectCid:
        return "csgc_projection_object_cid_mismatch"
    return ""

@borrows
fn CsgCoreCsgcProjectionReceiptError(
        receipt: CsgCoreCsgcProjectionReceipt): str =
    let structuralError =
        CsgCoreCsgcProjectionReceiptStructuralError(receipt)
    if structuralError.len > 0:
        return structuralError
    let decoded = CsgCoreCsgcDecodeLines(receipt.bytes)
    if !decoded.ok || decoded.factCount != receipt.factCount:
        return "csgc_projection_decode_mismatch"
    var encoded = CsgCoreCsgcEncodeCanonicalLines(decoded.lines)
    if !encoded.ok:
        return "csgc_projection_reencode_failed"
    let same = rawbytes.BytesEqual(encoded.bytes, receipt.bytes)
    rawbytes.BytesFree(encoded.bytes)
    if !same:
        return "csgc_projection_non_canonical"
    return ""

fn CsgCoreCsgcProjectionReceiptFree(
        receipt: var CsgCoreCsgcProjectionReceipt) =
    rawbytes.BytesFree(receipt.bytes)
    receipt = CsgCoreCsgcProjectionReceipt()

@borrows
fn CsgCoreCsgcPathLooksBinary(path: str): bool =
    return strings.HasSuffix(path, ".csgc")
