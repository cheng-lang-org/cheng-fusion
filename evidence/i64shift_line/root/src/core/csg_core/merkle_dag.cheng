import std/strings
import std/result
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/identity
import std/rawbytes

const
    CsgMerkleLeafNode: int32 = 1
    CsgMerkleBranchNode: int32 = 2
    CsgMerkleHashBits: int32 = 256
    CsgMerkleKeyDomain: str = "csg_core.merkle.key"
    CsgMerkleFactDomain: str = "csg_core.merkle.fact"
    CsgMerkleLeafDomain: str = "csg_core.merkle.leaf"
    CsgMerkleBranchDomain: str = "csg_core.merkle.branch"
    CsgMerkleEmptyDomain: str = "csg_core.merkle.empty"
    CsgMerkleSubgraphDomain: str = "csg_core.merkle.subgraph"
    CsgMerkleFactsRootDomain: str = "csg_core.merkle.facts_root"

type
    CsgCoreMerkleDag =
        ok: bool
        error: str
        factCount: int32
        rootNode: int32
        standard: str
        profiles: str[]
        schemaNamespace: str
        schemaCid: str
        dagRootCid: str
        subgraphCid: str
        factsRoot: str
        entryKeys: str[]
        entryFacts: str[]
        entryKeyHashes: layout.FixedBytes32[]
        entryFactHashes: layout.FixedBytes32[]
        nodeKinds: int32[]
        nodeSplitBits: int32[]
        nodeLefts: int32[]
        nodeRights: int32[]
        nodeEntries: int32[]
        nodeCounts: int32[]
        nodeHashes: layout.FixedBytes32[]

    CsgCoreMerkleProof =
        ok: bool
        error: str
        factCount: int32
        standard: str
        profiles: str[]
        schemaNamespace: str
        schemaCid: str
        dagRootCid: str
        subgraphCid: str
        factsRoot: str
        queryKey: str
        exists: bool
        terminalPresent: bool
        terminalKey: str
        terminalFactHash: layout.FixedBytes32
        splitBits: int32[]
        directions: int32[]
        siblingCounts: int32[]
        siblingHashes: layout.FixedBytes32[]

    CsgCoreMerkleFactProof =
        ok: bool
        error: str
        fact: str
        proof: CsgCoreMerkleProof

    csgCoreMerkleProofLookup =
        proof: CsgCoreMerkleProof
        entry: int32

    CsgCoreMerkleVerifyResult =
        ok: bool
        error: str
        exists: bool
        factCount: int32
        dagRootCid: str
        subgraphCid: str
        factsRoot: str

    CsgCoreMerkleNodeRecord =
        kind: int32
        count: int32
        splitBit: int32
        hash: layout.FixedBytes32
        key: str
        keyHash: layout.FixedBytes32
        factHash: layout.FixedBytes32
        leftCount: int32
        leftHash: layout.FixedBytes32
        rightCount: int32
        rightHash: layout.FixedBytes32

    CsgCoreMerkleReplayBinding =
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaNamespace: str
        schemaCid: str
        bindingIdentityReceiptCid: str

    CsgCoreMerkleReplayResult =
        ok: bool
        error: str
        beforeBinding: CsgCoreMerkleReplayBinding
        afterBinding: CsgCoreMerkleReplayBinding
        beforeDagRootCid: str
        afterDagRootCid: str
        beforeSubgraphCid: str
        afterSubgraphCid: str
        beforeFactsRoot: str
        afterFactsRoot: str
        beforeCount: int32
        afterCount: int32
        canonicalFact: str
        factHash: layout.FixedBytes32
        rebuiltNodeCount: int64
        reusedNodeCount: int64
        nodes: CsgCoreMerkleNodeRecord[]

    CsgCoreMerkleReplayDelta =
        ok: bool
        error: str
        replay: CsgCoreMerkleReplayResult

    csgCoreMerklePatchResult =
        ok: bool
        error: str
        beforeBinding: CsgCoreMerkleReplayBinding
        afterBinding: CsgCoreMerkleReplayBinding
        beforeDagRootCid: str
        afterDagRootCid: str
        beforeSubgraphCid: str
        afterSubgraphCid: str
        beforeFactsRoot: str
        afterFactsRoot: str
        beforeCount: int32
        afterCount: int32
        canonicalFact: str
        factHash: layout.FixedBytes32
        rebuiltNodeCount: int64
        reusedNodeCount: int64
        nodes: CsgCoreMerkleNodeRecord[]

    CsgCoreMerklePhysicalOrderResult =
        ok: bool
        error: str
        canonicalLines: str[]

@borrows
fn csgMerkleCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn csgMerkleAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn csgMerkleAppendText(buf: var layout.ByteBuf, text: str) =
    csgMerkleAppendU32(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

@borrows
fn csgMerkleAppendCid(buf: var layout.ByteBuf,
                      value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn csgMerkleUtf8Valid(text: str): bool =
    var cursor: int32
    while cursor < text.len:
        let b0 = int32(text[cursor]) & 255
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if cursor + 1 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if cursor + 2 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if cursor + 3 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            let b3 = int32(text[cursor + 3]) & 255
            if b2 < 128 || b2 > 191 ||
               b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

@borrows
fn csgMerkleUtf8ByteCompare(left: str, right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgMerkleHashCompare(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): int32 =
    for i in 0..<32:
        let leftByte = int32(left.data[i]) & 255
        let rightByte = int32(right.data[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    return 0

@borrows
fn csgMerklePhysicalOrderIndexes(
        keys: str[],
        keyHashes: layout.FixedBytes32[],
        error: var str): int32[] =
    var order: int32[]
    error = ""
    if keys.len != keyHashes.len:
        error = "merkle_physical_order_shape_mismatch"
        return order
    var scratch: int32[]
    setLen(order, keys.len)
    setLen(scratch, keys.len)
    for i in 0..<keys.len:
        order[i] = i
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                var takeLeft = left < middle
                if takeLeft && right < finish:
                    let hashOrder = csgMerkleHashCompare(
                        keyHashes[order[left]],
                        keyHashes[order[right]])
                    takeLeft = hashOrder < 0 ||
                        (hashOrder == 0 &&
                         csgMerkleUtf8ByteCompare(
                             keys[order[left]],
                             keys[order[right]]) <= 0)
                if takeLeft:
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    for i in 1..<order.len:
        let previous = order[i - 1]
        let current = order[i]
        if csgMerkleHashCompare(
               keyHashes[previous],
               keyHashes[current]) == 0:
            if keys[previous] == keys[current]:
                error = csgMerkleCat(
                    "merkle_duplicate_fact_key ",
                    keys[current])
            else:
                error = "merkle_key_hash_collision"
            var empty: int32[]
            return empty
    return order

@borrows
fn csgMerkleParseCid(
        text: str,
        out: var layout.FixedBytes32): bool =
    if text.len != 71 ||
       !strings.HasPrefix(text, "sha256:"):
        return false
    let hexText =
        strings.CloneStrRange(text, 7, 64)
    let parsed =
        layout.FixedBytes32FromHex(hexText)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return layout.FixedBytes32Hex(out) == hexText

@borrows
fn csgMerkleBindingError(
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str): str =
    if standard.len == 0 ||
       !csgMerkleUtf8Valid(standard):
        return "merkle_binding_standard_invalid"
    if profiles.len == 0:
        return "merkle_binding_profiles_empty"
    for i in 0..<profiles.len:
        if profiles[i].len == 0 ||
           !csgMerkleUtf8Valid(profiles[i]):
            return "merkle_binding_profile_invalid"
        if i > 0 &&
           csgMerkleUtf8ByteCompare(
               profiles[i - 1], profiles[i]) >= 0:
            return "merkle_binding_profiles_noncanonical"
    if schemaNamespace.len == 0 ||
       !csgMerkleUtf8Valid(schemaNamespace):
        return "merkle_binding_schema_namespace_invalid"
    var schemaHash: layout.FixedBytes32
    if !csgMerkleParseCid(schemaCid, schemaHash):
        return "merkle_binding_schema_cid_invalid"
    return ""

fn csgMerkleFinishHash(buf: var layout.ByteBuf): layout.FixedBytes32 =
    var bufView = layout.ByteBufView(buf)
    var bufViewData = bufView.data
    let digest = hash256.Sha256Fixed(bufView)
    rawbytes.BytesFree(bufViewData)
    layout.ByteBufFree(buf)
    return digest

@borrows
fn csgMerkleHashText(domain: str, text: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(domain.len + text.len + 16)
    csgMerkleAppendText(buf, domain)
    csgMerkleAppendText(buf, text)
    return csgMerkleFinishHash(buf)

@borrows
fn csgMerkleFactHashCanonical(
        canonicalFact: str): layout.FixedBytes32 =
    return csgMerkleHashText(CsgMerkleFactDomain, canonicalFact)

# ---------------------------------------------------------------------------
# [phaseC-w5] Fact memo (per-compilation).  CsgCoreJsonCanonicalize builds a
# full CsgJsonValue AST per fact line; one bootstrap window requests
# canonical/key/hash for the same fact text many times (transaction fact-key
# scans, request identity, admission seal, cargo verify), and every repeat
# rebuilt that AST.  In-tree measurements pin the AST cost for snapshot
# payload lines at ~1.3GiB / ~1.5GiB MALLOC_SMALL (see the comments at
# CsgCoreMerklePhysicalOrderFromCanonical and
# csgCoreProductionCanonicalInputError), so repeats dominate the bootstrap
# RSS ratchet.  The memo keeps exactly one authoritative AST computation per
# distinct fact text per compilation:
#   - a row is served only after a full str equality match on the fact text
#     (length + prefix prefilter first), so identity is exact;
#   - every miss runs the authoritative canonicalize path unchanged;
#   - missing row fields (key/hash) are derived from the row's canonical
#     text via the same pure functions, never re-ASTed;
#   - rows live for ONE compilation only (reset at the compiler entry next
#     to the store decode memo reset); cross-compilation reuse is forbidden;
#   - the table is row- and byte-capped and never evicts; over-cap facts
#     simply stay on the authoritative path, so correctness never depends
#     on the memo.
# ---------------------------------------------------------------------------

const
    CsgFactMemoMaxRows: int32 = 8192
    CsgFactMemoMaxRowBytes: int64 = int64(67108864)

var
    csgFactMemoRowFacts: str[]
    csgFactMemoRowCanonicals: str[]
    csgFactMemoRowKeys: str[]
    csgFactMemoRowKeysValid: bool[]
    csgFactMemoRowFactHashes: layout.FixedBytes32[]
    csgFactMemoRowHashesValid: bool[]
    csgFactMemoRowCount: int32
    csgFactMemoScanHint: int32
    csgFactMemoRowBytes: int64
    csgFactMemoHits: int64
    csgFactMemoMisses: int64

fn CsgCoreMerkleFactMemoResetForNewCompilation() =
    csgFactMemoRowFacts = []
    csgFactMemoRowCanonicals = []
    csgFactMemoRowKeys = []
    csgFactMemoRowKeysValid = []
    csgFactMemoRowFactHashes = []
    csgFactMemoRowHashesValid = []
    csgFactMemoRowCount = 0
    csgFactMemoScanHint = 0
    csgFactMemoRowBytes = 0
    csgFactMemoHits = 0
    csgFactMemoMisses = 0

@borrows
fn csgFactMemoPrefilterMatch(fact: str, rowFact: str): bool =
    if fact.len != rowFact.len:
        return false
    var probe = fact.len
    if probe > 8:
        probe = 8
    var i: int32
    while i < probe:
        if fact[i] != rowFact[i]:
            return false
        i = i + 1
    return fact == rowFact

@borrows
fn csgFactMemoFind(fact: str): int32 =
    if csgFactMemoRowCount <= 0:
        csgFactMemoMisses = csgFactMemoMisses + 1
        return -1
    for offset in 0..<csgFactMemoRowCount:
        var row = csgFactMemoScanHint + offset
        if row >= csgFactMemoRowCount:
            row = row - csgFactMemoRowCount
        if csgFactMemoPrefilterMatch(fact, csgFactMemoRowFacts[row]):
            csgFactMemoScanHint = row
            csgFactMemoHits = csgFactMemoHits + 1
            return row
    csgFactMemoMisses = csgFactMemoMisses + 1
    return -1

@borrows
fn csgFactMemoInsert(fact: str,
                     canonicalFact: str,
                     key: str,
                     keyValid: bool,
                     factHash: layout.FixedBytes32,
                     hashValid: bool) =
    if csgFactMemoRowCount >= CsgFactMemoMaxRows:
        return
    let rowBytes = int64(fact.len + canonicalFact.len + key.len)
    if csgFactMemoRowBytes + rowBytes > CsgFactMemoMaxRowBytes:
        return
    add(csgFactMemoRowFacts, strings.CloneStr(fact))
    add(csgFactMemoRowCanonicals, strings.CloneStr(canonicalFact))
    add(csgFactMemoRowKeys, strings.CloneStr(key))
    add(csgFactMemoRowKeysValid, keyValid)
    add(csgFactMemoRowFactHashes, factHash)
    add(csgFactMemoRowHashesValid, hashValid)
    csgFactMemoRowCount = csgFactMemoRowCount + 1
    csgFactMemoRowBytes = csgFactMemoRowBytes + rowBytes

# [phaseC-w5] Memo-aware canonicalize with the raw JSON-layer error text
# (used by the direct JSON-layer call sites below so they no longer rebuild
# the AST for a fact text the memo has already canonicalized).
@borrows
fn csgMerkleCanonicalizeViaMemo(fact: str, error: var str): str =
    let memoRow = csgFactMemoFind(fact)
    if memoRow >= 0:
        error = ""
        return strings.CloneStr(csgFactMemoRowCanonicals[memoRow])
    let result = canonical.CsgCoreJsonCanonicalize(fact)
    if !result.ok:
        error = strings.CloneStr(result.error)
        return ""
    let value = strings.CloneStr(result.value)
    csgFactMemoInsert(fact, value, "", false,
        layout.FixedBytes32(), false)
    return value

@borrows
fn csgMerkleCanonicalizeFact(
        fact: str,
        error: var str): str =
    error = ""
    let result = canonical.CsgCoreJsonCanonicalize(fact)
    if !result.ok:
        error = csgMerkleCat(
            "merkle_fact_canonicalization_failed ",
            result.error)
        return ""
    return strings.CloneStr(result.value)

@borrows
fn csgMerkleKeyForFact(canonicalFact: str,
                       factHash: layout.FixedBytes32,
                       error: var str): str =
    error = ""
    let kindValue = field.CsgCoreJsonKind(canonicalFact)
    if !kindValue.found || kindValue.value.len == 0:
        error = "merkle_fact_missing_kind"
        return ""
    let idValue = field.CsgCoreJsonId(canonicalFact)
    if idValue.found:
        if idValue.value.len == 0:
            error = "merkle_fact_empty_id"
            return ""
        return csgMerkleCat("id:", idValue.value)
    return csgMerkleCat(
        csgMerkleCat(
            csgMerkleCat("anonymous:", kindValue.value),
            ":"),
        layout.FixedBytes32Hex(factHash))

@borrows
fn CsgCoreMerkleFactKeyFromCanonical(
        canonicalFact: str,
        error: var str): str =
    error = ""
    let factHash =
        csgMerkleFactHashCanonical(canonicalFact)
    return csgMerkleKeyForFact(
        canonicalFact, factHash, error)

@borrows
fn CsgCoreMerkleFactKey(fact: str, error: var str): str =
    let memoRow = csgFactMemoFind(fact)
    if memoRow >= 0:
        if csgFactMemoRowKeysValid[memoRow]:
            error = ""
            return strings.CloneStr(csgFactMemoRowKeys[memoRow])
        var factHash: layout.FixedBytes32
        if csgFactMemoRowHashesValid[memoRow]:
            factHash = csgFactMemoRowFactHashes[memoRow]
        else:
            factHash = csgMerkleFactHashCanonical(
                csgFactMemoRowCanonicals[memoRow])
            csgFactMemoRowFactHashes[memoRow] = factHash
            csgFactMemoRowHashesValid[memoRow] = true
        let memoKey = csgMerkleKeyForFact(
            csgFactMemoRowCanonicals[memoRow], factHash, error)
        if error.len > 0:
            return ""
        csgFactMemoRowKeys[memoRow] = strings.CloneStr(memoKey)
        csgFactMemoRowKeysValid[memoRow] = true
        return memoKey
    let canonicalFact =
        csgMerkleCanonicalizeFact(fact, error)
    if error.len > 0:
        return ""
    let factHash = csgMerkleFactHashCanonical(canonicalFact)
    let key = csgMerkleKeyForFact(canonicalFact, factHash, error)
    if error.len > 0:
        return ""
    csgFactMemoInsert(fact, canonicalFact, key, true, factHash, true)
    return key

@borrows
fn CsgCoreMerkleCanonicalFact(
        fact: str,
        error: var str): str =
    let memoRow = csgFactMemoFind(fact)
    if memoRow >= 0:
        error = ""
        return strings.CloneStr(csgFactMemoRowCanonicals[memoRow])
    let canonicalFact = csgMerkleCanonicalizeFact(fact, error)
    if error.len > 0:
        return ""
    csgFactMemoInsert(fact, canonicalFact, "", false,
        layout.FixedBytes32(), false)
    return canonicalFact

@borrows
fn CsgCoreMerkleFactHash(
        fact: str,
        error: var str): layout.FixedBytes32 =
    let memoRow = csgFactMemoFind(fact)
    if memoRow >= 0:
        if csgFactMemoRowHashesValid[memoRow]:
            error = ""
            return csgFactMemoRowFactHashes[memoRow]
        let factHash = csgMerkleFactHashCanonical(
            csgFactMemoRowCanonicals[memoRow])
        csgFactMemoRowFactHashes[memoRow] = factHash
        csgFactMemoRowHashesValid[memoRow] = true
        error = ""
        return factHash
    let canonicalFact =
        csgMerkleCanonicalizeFact(fact, error)
    if error.len > 0:
        return layout.FixedBytes32()
    let factHash = csgMerkleFactHashCanonical(canonicalFact)
    csgFactMemoInsert(fact, canonicalFact, "", false, factHash, true)
    return factHash

@borrows
fn CsgCoreMerkleKeyHash(
        key: str): layout.FixedBytes32 =
    return csgMerkleKeyHash(key)

@borrows
fn csgMerkleKeyHash(key: str): layout.FixedBytes32 =
    return csgMerkleHashText(CsgMerkleKeyDomain, key)

@borrows
fn csgMerkleLeafHash(keyHash: layout.FixedBytes32,
                     factHash: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    csgMerkleAppendText(buf, CsgMerkleLeafDomain)
    csgMerkleAppendCid(buf, keyHash)
    csgMerkleAppendCid(buf, factHash)
    return csgMerkleFinishHash(buf)

@borrows
fn csgMerkleBranchHash(splitBit: int32,
                       leftCount: int32,
                       leftHash: layout.FixedBytes32,
                       rightCount: int32,
                       rightHash: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(112)
    csgMerkleAppendText(buf, CsgMerkleBranchDomain)
    csgMerkleAppendU32(buf, splitBit)
    csgMerkleAppendU32(buf, leftCount)
    csgMerkleAppendCid(buf, leftHash)
    csgMerkleAppendU32(buf, rightCount)
    csgMerkleAppendCid(buf, rightHash)
    return csgMerkleFinishHash(buf)

fn csgMerkleEmptyHash(): layout.FixedBytes32 =
    return csgMerkleHashText(CsgMerkleEmptyDomain, "")

@borrows
fn csgMerkleSubgraphHash(
        factCount: int32,
        dagRoot: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    csgMerkleAppendText(buf, CsgMerkleSubgraphDomain)
    csgMerkleAppendU32(buf, factCount)
    csgMerkleAppendCid(buf, dagRoot)
    return csgMerkleFinishHash(buf)

@borrows
fn csgMerkleFactsRootHash(
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaHash: layout.FixedBytes32,
        subgraphHash: layout.FixedBytes32):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    csgMerkleAppendText(buf, CsgMerkleFactsRootDomain)
    csgMerkleAppendText(buf, standard)
    csgMerkleAppendU32(buf, profiles.len)
    for i in 0..<profiles.len:
        csgMerkleAppendText(buf, profiles[i])
    csgMerkleAppendText(buf, schemaNamespace)
    csgMerkleAppendCid(buf, schemaHash)
    csgMerkleAppendCid(buf, subgraphHash)
    return csgMerkleFinishHash(buf)

@borrows
fn csgMerkleNodeCidText(
        hash: layout.FixedBytes32): str =
    return csgMerkleCat(
        "sha256:", layout.FixedBytes32Hex(hash))

@borrows
fn csgMerkleLeafRecord(
        key: str,
        factHash: layout.FixedBytes32):
        CsgCoreMerkleNodeRecord =
    var out: CsgCoreMerkleNodeRecord
    out.kind = CsgMerkleLeafNode
    out.count = 1
    out.splitBit = -1
    out.key = strings.CloneStr(key)
    out.keyHash = csgMerkleKeyHash(key)
    out.factHash = layout.FixedBytes32Copy(factHash)
    out.hash = csgMerkleLeafHash(
        out.keyHash, out.factHash)
    return out

@borrows
fn csgMerkleBranchRecord(
        splitBit: int32,
        leftCount: int32,
        leftHash: layout.FixedBytes32,
        rightCount: int32,
        rightHash: layout.FixedBytes32):
        CsgCoreMerkleNodeRecord =
    var out: CsgCoreMerkleNodeRecord
    out.kind = CsgMerkleBranchNode
    out.count = leftCount + rightCount
    out.splitBit = splitBit
    out.leftCount = leftCount
    out.leftHash = layout.FixedBytes32Copy(leftHash)
    out.rightCount = rightCount
    out.rightHash = layout.FixedBytes32Copy(rightHash)
    out.hash = csgMerkleBranchHash(
        splitBit,
        leftCount,
        leftHash,
        rightCount,
        rightHash)
    return out

@borrows
fn CsgCoreMerkleNodeRecordError(
        node: CsgCoreMerkleNodeRecord): str =
    let zeroHash = layout.FixedBytes32()
    if node.kind == CsgMerkleLeafNode:
        if node.count != 1 || node.splitBit != -1 ||
           node.key.len == 0 ||
           !csgMerkleUtf8Valid(node.key) ||
           node.leftCount != 0 || node.rightCount != 0 ||
           !layout.FixedBytes32Equal(
               node.leftHash, zeroHash) ||
           !layout.FixedBytes32Equal(
               node.rightHash, zeroHash):
            return "merkle_leaf_record_shape_invalid"
        if layout.FixedBytes32Equal(
               node.keyHash, zeroHash) ||
           layout.FixedBytes32Equal(
               node.factHash, zeroHash) ||
           layout.FixedBytes32Equal(
               node.hash, zeroHash):
            return "merkle_leaf_record_zero_hash"
        let expectedKeyHash =
            csgMerkleKeyHash(node.key)
        if !layout.FixedBytes32Equal(
               expectedKeyHash, node.keyHash):
            return "merkle_leaf_record_key_hash_mismatch"
        let expectedHash = csgMerkleLeafHash(
            expectedKeyHash, node.factHash)
        if !layout.FixedBytes32Equal(
               expectedHash, node.hash):
            return "merkle_leaf_record_hash_mismatch"
        return ""
    if node.kind != CsgMerkleBranchNode:
        return "merkle_node_record_kind_invalid"
    if node.splitBit < 0 ||
       node.splitBit >= CsgMerkleHashBits ||
       node.leftCount <= 0 || node.rightCount <= 0 ||
       node.leftCount > 2147483647 - node.rightCount ||
       node.count != node.leftCount + node.rightCount ||
       node.key.len != 0 ||
       !layout.FixedBytes32Equal(
           node.keyHash, zeroHash) ||
       !layout.FixedBytes32Equal(
           node.factHash, zeroHash):
        return "merkle_branch_record_shape_invalid"
    if layout.FixedBytes32Equal(
           node.leftHash, zeroHash) ||
       layout.FixedBytes32Equal(
           node.rightHash, zeroHash) ||
       layout.FixedBytes32Equal(
           node.hash, zeroHash):
        return "merkle_branch_record_zero_hash"
    if layout.FixedBytes32Equal(
           node.leftHash, node.rightHash):
        return "merkle_branch_record_children_equal"
    let expectedHash = csgMerkleBranchHash(
        node.splitBit,
        node.leftCount,
        node.leftHash,
        node.rightCount,
        node.rightHash)
    if !layout.FixedBytes32Equal(
           expectedHash, node.hash):
        return "merkle_branch_record_hash_mismatch"
    return ""

fn CsgCoreMerkleLeafNodeKind(): int32 =
    return CsgMerkleLeafNode

fn CsgCoreMerkleBranchNodeKind(): int32 =
    return CsgMerkleBranchNode

@borrows
fn CsgCoreMerkleNodeRecordCid(
        node: CsgCoreMerkleNodeRecord): str =
    let error = CsgCoreMerkleNodeRecordError(node)
    if error.len > 0:
        return csgMerkleCat("invalid:", error)
    return csgMerkleNodeCidText(node.hash)

@borrows
fn CsgCoreMerkleDagNodeRecord(
        dag: CsgCoreMerkleDag,
        nodeIndex: int32,
        error: var str): CsgCoreMerkleNodeRecord =
    error = ""
    var out: CsgCoreMerkleNodeRecord
    if !dag.ok:
        error = csgMerkleCat(
            "merkle_dag_invalid ", dag.error)
        return out
    if nodeIndex < 0 ||
       nodeIndex >= dag.nodeKinds.len ||
       nodeIndex >= dag.nodeCounts.len ||
       nodeIndex >= dag.nodeHashes.len:
        error = "merkle_dag_node_out_of_range"
        return out
    if dag.nodeKinds[nodeIndex] ==
       CsgMerkleLeafNode:
        if nodeIndex >= dag.nodeEntries.len:
            error = "merkle_dag_leaf_entry_column_missing"
            return out
        let entryIndex =
            dag.nodeEntries[nodeIndex]
        if entryIndex < 0 ||
           entryIndex >= dag.entryKeys.len ||
           entryIndex >= dag.entryFactHashes.len:
            error = "merkle_dag_leaf_entry_out_of_range"
            return out
        out = csgMerkleLeafRecord(
            dag.entryKeys[entryIndex],
            dag.entryFactHashes[entryIndex])
    elif dag.nodeKinds[nodeIndex] ==
         CsgMerkleBranchNode:
        if nodeIndex >= dag.nodeSplitBits.len ||
           nodeIndex >= dag.nodeLefts.len ||
           nodeIndex >= dag.nodeRights.len:
            error =
                "merkle_dag_branch_column_missing"
            return out
        let left = dag.nodeLefts[nodeIndex]
        let right = dag.nodeRights[nodeIndex]
        if left < 0 || right < 0 ||
           left >= dag.nodeCounts.len ||
           right >= dag.nodeCounts.len ||
           left >= dag.nodeHashes.len ||
           right >= dag.nodeHashes.len:
            error =
                "merkle_dag_branch_child_out_of_range"
            return out
        out = csgMerkleBranchRecord(
            dag.nodeSplitBits[nodeIndex],
            dag.nodeCounts[left],
            dag.nodeHashes[left],
            dag.nodeCounts[right],
            dag.nodeHashes[right])
    else:
        error = "merkle_dag_node_kind_invalid"
        return out
    if out.count != dag.nodeCounts[nodeIndex] ||
       !layout.FixedBytes32Equal(
           out.hash, dag.nodeHashes[nodeIndex]):
        error = "merkle_dag_node_record_mismatch"
        return CsgCoreMerkleNodeRecord()
    error = CsgCoreMerkleNodeRecordError(out)
    if error.len > 0:
        return CsgCoreMerkleNodeRecord()
    return out

@borrows
fn csgMerkleBit(value: layout.FixedBytes32, bitIndex: int32): int32 =
    if bitIndex < 0 || bitIndex >= CsgMerkleHashBits:
        return -1
    let byteIndex = bitIndex / 8
    let bitInByte = 7 - (bitIndex % 8)
    return (int32(value.data[byteIndex]) >> bitInByte) & 1

@borrows
fn csgMerkleFirstDifferentBit(a: layout.FixedBytes32,
                              b: layout.FixedBytes32): int32 =
    for byteIndex in 0..<32:
        let av = int32(a.data[byteIndex]) & 255
        let bv = int32(b.data[byteIndex]) & 255
        if av == bv:
            continue
        let diff = av ^ bv
        for bitOffset in 0..<8:
            if (diff & (1 << (7 - bitOffset))) != 0:
                return byteIndex * 8 + bitOffset
    return -1

fn csgMerkleAddLeaf(dag: var CsgCoreMerkleDag,
                     entryIndex: int32): int32 =
    let nodeIndex = dag.nodeKinds.len
    add(dag.nodeKinds, CsgMerkleLeafNode)
    add(dag.nodeSplitBits, -1)
    add(dag.nodeLefts, -1)
    add(dag.nodeRights, -1)
    add(dag.nodeEntries, entryIndex)
    add(dag.nodeCounts, 1)
    add(dag.nodeHashes,
        csgMerkleLeafHash(
            dag.entryKeyHashes[entryIndex],
            dag.entryFactHashes[entryIndex]))
    return nodeIndex

fn csgMerkleAddBranch(dag: var CsgCoreMerkleDag,
                       splitBit: int32,
                       leftNode: int32,
                       rightNode: int32): int32 =
    let nodeIndex = dag.nodeKinds.len
    add(dag.nodeKinds, CsgMerkleBranchNode)
    add(dag.nodeSplitBits, splitBit)
    add(dag.nodeLefts, leftNode)
    add(dag.nodeRights, rightNode)
    add(dag.nodeEntries, -1)
    add(dag.nodeCounts, 0)
    add(dag.nodeHashes, layout.FixedBytes32())
    return nodeIndex

@borrows
fn csgMerkleFindTerminalLeaf(dag: CsgCoreMerkleDag,
                             keyHash: layout.FixedBytes32): int32 =
    var node = dag.rootNode
    while node >= 0 && dag.nodeKinds[node] == CsgMerkleBranchNode:
        let bit = csgMerkleBit(keyHash, dag.nodeSplitBits[node])
        if bit == 0:
            node = dag.nodeLefts[node]
        else:
            node = dag.nodeRights[node]
    return node

fn csgMerkleInsertEntry(dag: var CsgCoreMerkleDag,
                        entryIndex: int32): bool =
    let leafNode = csgMerkleAddLeaf(dag, entryIndex)
    if dag.rootNode < 0:
        dag.rootNode = leafNode
        return true

    let keyHash = dag.entryKeyHashes[entryIndex]
    let terminal = csgMerkleFindTerminalLeaf(dag, keyHash)
    if terminal < 0 ||
       dag.nodeKinds[terminal] != CsgMerkleLeafNode:
        dag.error = "merkle_terminal_leaf_missing"
        return false
    let terminalEntry = dag.nodeEntries[terminal]
    if layout.FixedBytes32Equal(
           keyHash,
           dag.entryKeyHashes[terminalEntry]):
        if dag.entryKeys[entryIndex] == dag.entryKeys[terminalEntry]:
            dag.error = csgMerkleCat(
                "merkle_duplicate_fact_key ",
                dag.entryKeys[entryIndex])
        else:
            dag.error = "merkle_key_hash_collision"
        return false

    let splitBit = csgMerkleFirstDifferentBit(
        keyHash,
        dag.entryKeyHashes[terminalEntry])
    if splitBit < 0:
        dag.error = "merkle_key_hash_collision"
        return false

    var parent: int32 = -1
    var current = dag.rootNode
    while dag.nodeKinds[current] == CsgMerkleBranchNode &&
          dag.nodeSplitBits[current] < splitBit:
        parent = current
        if csgMerkleBit(keyHash, dag.nodeSplitBits[current]) == 0:
            current = dag.nodeLefts[current]
        else:
            current = dag.nodeRights[current]

    var branch: int32
    if csgMerkleBit(keyHash, splitBit) == 0:
        branch = csgMerkleAddBranch(
            dag, splitBit, leafNode, current)
    else:
        branch = csgMerkleAddBranch(
            dag, splitBit, current, leafNode)
    if parent < 0:
        dag.rootNode = branch
    elif csgMerkleBit(keyHash, dag.nodeSplitBits[parent]) == 0:
        dag.nodeLefts[parent] = branch
    else:
        dag.nodeRights[parent] = branch
    return true

fn csgMerkleComputeNode(dag: var CsgCoreMerkleDag,
                        node: int32): layout.FixedBytes32 =
    if node < 0 || node >= dag.nodeKinds.len:
        dag.error = "merkle_node_out_of_range"
        return layout.FixedBytes32()
    if dag.nodeKinds[node] == CsgMerkleLeafNode:
        dag.nodeCounts[node] = 1
        return layout.FixedBytes32Copy(
            dag.nodeHashes[node])
    if dag.nodeKinds[node] != CsgMerkleBranchNode:
        dag.error = "merkle_node_kind_invalid"
        return layout.FixedBytes32()
    let left = dag.nodeLefts[node]
    let right = dag.nodeRights[node]
    if left < 0 || right < 0 || left == right:
        dag.error = "merkle_branch_children_invalid"
        return layout.FixedBytes32()
    let leftHash = csgMerkleComputeNode(dag, left)
    if dag.error.len > 0:
        return layout.FixedBytes32()
    let rightHash = csgMerkleComputeNode(dag, right)
    if dag.error.len > 0:
        return layout.FixedBytes32()
    let leftCount = dag.nodeCounts[left]
    let rightCount = dag.nodeCounts[right]
    if leftCount <= 0 || rightCount <= 0 ||
       leftCount > 2147483647 - rightCount:
        dag.error = "merkle_branch_count_invalid"
        return layout.FixedBytes32()
    dag.nodeCounts[node] = leftCount + rightCount
    dag.nodeHashes[node] = csgMerkleBranchHash(
        dag.nodeSplitBits[node],
        leftCount,
        leftHash,
        rightCount,
        rightHash)
    return layout.FixedBytes32Copy(
        dag.nodeHashes[node])

@borrows
fn csgMerkleInsertCanonicalFact(
        dag: var CsgCoreMerkleDag,
        canonicalFact: str,
        lineNumber: int32): bool =
    let factHash =
        csgMerkleFactHashCanonical(canonicalFact)
    var keyError: str
    let key = csgMerkleKeyForFact(
        canonicalFact, factHash, keyError)
    if keyError.len > 0:
        dag.error = csgMerkleCat(
            csgMerkleCat(
                csgMerkleCat(
                    "merkle_line ",
                    strings.IntToStr(lineNumber)),
                " "),
            keyError)
        return false
    let keyHash = csgMerkleKeyHash(key)
    add(dag.entryKeys, key)
    add(dag.entryFacts, share(canonicalFact))
    add(dag.entryKeyHashes, keyHash)
    add(dag.entryFactHashes, factHash)
    return csgMerkleInsertEntry(
        dag, dag.entryKeys.len - 1)

fn csgMerkleFinishBuild(
        dag: var CsgCoreMerkleDag):
        bool =
    dag.factCount = dag.entryKeys.len
    var dagRoot = csgMerkleEmptyHash()
    if dag.rootNode >= 0:
        dagRoot = csgMerkleComputeNode(dag, dag.rootNode)
        if dag.error.len > 0:
            return false
        if dag.nodeCounts[dag.rootNode] != dag.factCount:
            dag.error = "merkle_root_count_mismatch"
            return false
    dag.dagRootCid = csgMerkleNodeCidText(dagRoot)
    dag.subgraphCid = csgMerkleNodeCidText(
        csgMerkleSubgraphHash(
            dag.factCount, dagRoot))
    dag.ok = true
    return true

@borrows
fn csgMerkleBuildCanonical(
        canonicalLines: str[]): CsgCoreMerkleDag =
    # Input is already canonical JSONL. Re-parsing each line into a
    # CsgJsonValue AST was measured at ~1.5GiB on an 8-line compile.
    var dag: CsgCoreMerkleDag
    dag.rootNode = -1
    for lineIndex in 0..<canonicalLines.len:
        if canonicalLines[lineIndex].len == 0:
            dag.error =
                csgMerkleCat(
                    csgMerkleCat(
                        "merkle_line ",
                        strings.IntToStr(lineIndex + 1)),
                    " empty")
            return dag
        if !csgMerkleInsertCanonicalFact(
                dag, canonicalLines[lineIndex],
                lineIndex + 1):
            return dag
    let _ = csgMerkleFinishBuild(dag)
    return dag

@borrows
fn CsgCoreMerkleBuildFromCanonicalLines(
        canonicalLines: str[]): CsgCoreMerkleDag =
    return csgMerkleBuildCanonical(canonicalLines)

@borrows
fn CsgCoreMerkleBuild(lines: str[]): CsgCoreMerkleDag =
    var dag: CsgCoreMerkleDag
    dag.rootNode = -1
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            continue
        # [phaseC-w5] canonicalize through the per-compilation fact memo so
        # repeated builds over the same fact text stop re-building the JSON
        # AST; error text unchanged.
        var canonicalError: str
        let canonicalValue =
            csgMerkleCanonicalizeViaMemo(
                lines[lineIndex], canonicalError)
        if canonicalError.len > 0:
            var failed: CsgCoreMerkleDag
            failed.error =
                csgMerkleCat(
                    csgMerkleCat(
                        csgMerkleCat(
                            "merkle_line ",
                            strings.IntToStr(lineIndex + 1)),
                        " canonicalization_failed "),
                    canonicalError)
            return failed
        if !csgMerkleInsertCanonicalFact(
                dag, canonicalValue,
                lineIndex + 1):
            return dag
    let _ = csgMerkleFinishBuild(dag)
    return dag


@borrows
fn CsgCoreMerklePhysicalOrderFromCanonical(
        canonicalLines: str[]): CsgCoreMerklePhysicalOrderResult =
    # CSGC/canonical JSONL already has one wire form. Re-parsing each
    # line into a CsgJsonValue AST was measured at 1.3GiB MALLOC_SMALL
    # while reading the current snapshot to compile an 8-line program.
    var out: CsgCoreMerklePhysicalOrderResult
    var factKeys: str[]
    var keyHashes: layout.FixedBytes32[]
    for lineIndex in 0..<canonicalLines.len:
        if canonicalLines[lineIndex].len == 0:
            continue
        let factHash =
            csgMerkleFactHashCanonical(canonicalLines[lineIndex])
        var keyError: str
        let key = csgMerkleKeyForFact(
            canonicalLines[lineIndex],
            factHash,
            keyError)
        if keyError.len > 0:
            out.error =
                csgMerkleCat(
                    csgMerkleCat(
                        csgMerkleCat(
                            "merkle_line ",
                            strings.IntToStr(lineIndex + 1)),
                        " "),
                    keyError)
            return out
        add(factKeys, strings.CloneStr(key))
        add(keyHashes, csgMerkleKeyHash(key))

    var orderError: str
    let order = csgMerklePhysicalOrderIndexes(
        factKeys, keyHashes, orderError)
    if orderError.len > 0:
        out.error = strings.CloneStr(orderError)
        return out

    var sourceIndex: int32
    for rank in 0..<order.len:
        sourceIndex = order[rank]
        if sourceIndex < 0 || sourceIndex >= canonicalLines.len:
            out.error = "merkle_physical_order_source_out_of_range"
            return out
        add(
            out.canonicalLines,
            strings.CloneStr(canonicalLines[sourceIndex]))
    out.ok = true
    return out

@borrows
fn CsgCoreMerklePhysicalOrderIndexesFromCanonical(
        canonicalLines: str[],
        error: var str): int32[] =
    error = ""
    var factKeys: str[]
    var keyHashes: layout.FixedBytes32[]
    var emptyOrder: int32[]
    for lineIndex in 0..<canonicalLines.len:
        if canonicalLines[lineIndex].len == 0:
            error = "merkle_physical_order_empty_line"
            return emptyOrder
        let factHash =
            csgMerkleFactHashCanonical(canonicalLines[lineIndex])
        var keyError: str
        let key = csgMerkleKeyForFact(
            canonicalLines[lineIndex],
            factHash,
            keyError)
        if keyError.len > 0:
            error = strings.CloneStr(keyError)
            return emptyOrder
        add(factKeys, strings.CloneStr(key))
        add(keyHashes, csgMerkleKeyHash(key))
    var orderError: str
    let order = csgMerklePhysicalOrderIndexes(
        factKeys, keyHashes, orderError)
    if orderError.len > 0:
        error = strings.CloneStr(orderError)
        return emptyOrder
    if order.len != canonicalLines.len:
        error = "merkle_physical_order_shape_mismatch"
        return emptyOrder
    return order

@borrows
fn CsgCoreMerklePhysicalOrderIsIdentity(
        canonicalLines: str[],
        error: var str): bool =
    # Order-identity check for CSGC decode/projection. Cloning every fact
    # line into a second seq was a 400MB+ live set on snapshot read.
    let order = CsgCoreMerklePhysicalOrderIndexesFromCanonical(
        canonicalLines, error)
    if error.len > 0:
        return false
    for i in 0..<order.len:
        if order[i] != i:
            return false
    return true

@borrows
fn CsgCoreMerklePhysicalOrder(
        lines: str[]): CsgCoreMerklePhysicalOrderResult =
    var canonicalLines: str[]
    var out: CsgCoreMerklePhysicalOrderResult
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            continue
        # [phaseC-w5] canonicalize through the per-compilation fact memo;
        # error text unchanged.
        var canonicalError: str
        let canonicalValue =
            csgMerkleCanonicalizeViaMemo(
                lines[lineIndex], canonicalError)
        if canonicalError.len > 0:
            out.error =
                csgMerkleCat(
                    csgMerkleCat(
                        csgMerkleCat(
                            "merkle_line ",
                            strings.IntToStr(lineIndex + 1)),
                        " canonicalization_failed "),
                    canonicalError)
            return out
        add(
            canonicalLines,
            canonicalValue)
    return CsgCoreMerklePhysicalOrderFromCanonical(canonicalLines)

@borrows
fn csgMerkleBind(
        dag: var CsgCoreMerkleDag,
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str): bool =
    if !dag.ok:
        return false
    if dag.standard.len > 0 ||
       dag.profiles.len > 0 ||
       dag.schemaNamespace.len > 0 ||
       dag.schemaCid.len > 0 ||
       dag.factsRoot.len > 0:
        dag.ok = false
        dag.error = "merkle_dag_already_bound"
        return false
    let bindingError = csgMerkleBindingError(
        standard,
        profiles,
        schemaNamespace,
        schemaCid)
    if bindingError.len > 0:
        dag.ok = false
        dag.error = strings.CloneStr(bindingError)
        return false
    var dagRoot: layout.FixedBytes32
    var subgraphHash: layout.FixedBytes32
    var schemaHash: layout.FixedBytes32
    if !csgMerkleParseCid(dag.dagRootCid, dagRoot):
        dag.ok = false
        dag.error = "merkle_dag_root_cid_invalid"
        return false
    if !csgMerkleParseCid(
           dag.subgraphCid, subgraphHash):
        dag.ok = false
        dag.error = "merkle_subgraph_cid_invalid"
        return false
    let expectedSubgraph = csgMerkleSubgraphHash(
        dag.factCount, dagRoot)
    if !layout.FixedBytes32Equal(
           expectedSubgraph, subgraphHash):
        dag.ok = false
        dag.error = "merkle_subgraph_cid_mismatch"
        return false
    let _ = csgMerkleParseCid(schemaCid, schemaHash)
    dag.standard = strings.CloneStr(standard)
    for i in 0..<profiles.len:
        add(dag.profiles, strings.CloneStr(profiles[i]))
    dag.schemaNamespace =
        strings.CloneStr(schemaNamespace)
    dag.schemaCid = strings.CloneStr(schemaCid)
    dag.factsRoot = csgMerkleNodeCidText(
        csgMerkleFactsRootHash(
            standard,
            profiles,
            schemaNamespace,
            schemaHash,
            subgraphHash))
    return true

@borrows
fn CsgCoreMerkleBuildBound(
        lines: str[],
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str): CsgCoreMerkleDag =
    var canonicalLines: str[]
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            var failed: CsgCoreMerkleDag
            failed.error =
                csgMerkleCat(
                    csgMerkleCat(
                        "merkle_line ",
                        strings.IntToStr(lineIndex + 1)),
                    " empty")
            return failed
        var canonicalError: str
        let canonical =
            csgMerkleCanonicalizeFact(
                lines[lineIndex], canonicalError)
        if canonicalError.len > 0:
            var failed: CsgCoreMerkleDag
            failed.error =
                csgMerkleCat(
                    csgMerkleCat(
                        csgMerkleCat(
                            "merkle_line ",
                            strings.IntToStr(lineIndex + 1)),
                        " canonicalization_failed "),
                    canonicalError)
            return failed
        if canonical != lines[lineIndex]:
            var failed: CsgCoreMerkleDag
            failed.error =
                csgMerkleCat(
                    csgMerkleCat(
                        "merkle_line ",
                        strings.IntToStr(lineIndex + 1)),
                    " noncanonical")
            return failed
        add(canonicalLines, canonical)
    return CsgCoreMerkleBuildCanonicalBound(
        canonicalLines,
        standard,
        profiles,
        schemaNamespace,
        schemaCid)

@borrows
fn CsgCoreMerkleBuildCanonicalBound(
        canonicalLines: str[],
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str): CsgCoreMerkleDag =
    var dag = csgMerkleBuildCanonical(
        canonicalLines)
    if dag.ok:
        let _ = csgMerkleBind(
            dag,
            standard,
            profiles,
            schemaNamespace,
            schemaCid)
    return dag

@borrows
fn CsgCoreMerkleFactsRootFromCanonicalLines(
        canonicalLines: str[],
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str): str =
    let dag = CsgCoreMerkleBuildCanonicalBound(
        canonicalLines,
        standard,
        profiles,
        schemaNamespace,
        schemaCid)
    if !dag.ok:
        return csgMerkleCat("invalid:", dag.error)
    return strings.CloneStr(dag.factsRoot)

@borrows
fn csgMerkleSubgraphText(
        factCount: int32,
        dagRoot: layout.FixedBytes32): str =
    return csgMerkleNodeCidText(
        csgMerkleSubgraphHash(
            factCount, dagRoot))

@borrows
fn csgMerkleFactsRootText(
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaHash: layout.FixedBytes32,
        subgraphHash: layout.FixedBytes32): str =
    return csgMerkleNodeCidText(
        csgMerkleFactsRootHash(
            standard,
            profiles,
            schemaNamespace,
            schemaHash,
            subgraphHash))

fn csgMerkleProofFail(error: str): CsgCoreMerkleProof =
    var out: CsgCoreMerkleProof
    out.error = error
    return out

@borrows
fn csgMerkleProveDagShapeError(
        dag: CsgCoreMerkleDag): str =
    if dag.factCount < 0 ||
       dag.entryKeys.len != dag.factCount ||
       dag.entryKeyHashes.len != dag.factCount ||
       dag.entryFactHashes.len != dag.factCount:
        return "merkle_proof_entry_columns_invalid"
    let expectedNodeCount = dag.factCount == 0 ?
        int64(0) : int64(dag.factCount) * int64(2) - int64(1)
    if expectedNodeCount > int64(2147483647) ||
       int64(dag.nodeKinds.len) != expectedNodeCount ||
       dag.nodeSplitBits.len != dag.nodeKinds.len ||
       dag.nodeLefts.len != dag.nodeKinds.len ||
       dag.nodeRights.len != dag.nodeKinds.len ||
       dag.nodeEntries.len != dag.nodeKinds.len ||
       dag.nodeCounts.len != dag.nodeKinds.len ||
       dag.nodeHashes.len != dag.nodeKinds.len:
        return "merkle_proof_node_columns_invalid"
    if dag.factCount == 0:
        if dag.rootNode != -1:
            return "merkle_proof_empty_root_invalid"
        return ""
    if dag.rootNode < 0 ||
       dag.rootNode >= dag.nodeKinds.len ||
       dag.nodeCounts[dag.rootNode] != dag.factCount:
        return "merkle_proof_root_shape_invalid"
    return ""

@borrows
fn csgMerkleProveKeyLookup(
        dag: CsgCoreMerkleDag,
        queryKey: str): csgCoreMerkleProofLookup =
    var lookup: csgCoreMerkleProofLookup
    lookup.entry = -1
    if !dag.ok:
        lookup.proof = csgMerkleProofFail(
            csgMerkleCat("merkle_dag_invalid ", dag.error))
        return lookup
    let shapeError = csgMerkleProveDagShapeError(dag)
    if shapeError.len > 0:
        lookup.proof = csgMerkleProofFail(shapeError)
        return lookup
    if dag.factsRoot.len == 0:
        lookup.proof = csgMerkleProofFail(
            "merkle_dag_binding_missing")
        return lookup
    let bindingError = csgMerkleBindingError(
        dag.standard,
        dag.profiles,
        dag.schemaNamespace,
        dag.schemaCid)
    if bindingError.len > 0:
        lookup.proof = csgMerkleProofFail(bindingError)
        return lookup
    if queryKey.len == 0:
        lookup.proof = csgMerkleProofFail(
            "merkle_query_key_empty")
        return lookup
    if !csgMerkleUtf8Valid(queryKey):
        lookup.proof = csgMerkleProofFail(
            "merkle_query_key_utf8_invalid")
        return lookup

    var out: CsgCoreMerkleProof
    out.factCount = dag.factCount
    out.standard = strings.CloneStr(dag.standard)
    for i in 0..<dag.profiles.len:
        add(out.profiles, strings.CloneStr(dag.profiles[i]))
    out.schemaNamespace =
        strings.CloneStr(dag.schemaNamespace)
    out.schemaCid = strings.CloneStr(dag.schemaCid)
    out.dagRootCid = strings.CloneStr(dag.dagRootCid)
    out.subgraphCid =
        strings.CloneStr(dag.subgraphCid)
    out.factsRoot = strings.CloneStr(dag.factsRoot)
    out.queryKey = strings.CloneStr(queryKey)
    if dag.rootNode < 0:
        if dag.factCount != 0:
            lookup.proof = csgMerkleProofFail(
                "merkle_empty_root_count_mismatch")
            return lookup
        out.ok = true
        lookup.proof = out
        return lookup

    let queryKeyHash = csgMerkleKeyHash(queryKey)
    var node = dag.rootNode
    var previousSplitBit: int32 = -1
    var pathDepth: int32
    while true:
        if node < 0 || node >= dag.nodeKinds.len:
            lookup.proof = csgMerkleProofFail(
                "merkle_proof_path_node_invalid")
            return lookup
        if dag.nodeKinds[node] == CsgMerkleLeafNode:
            break
        if dag.nodeKinds[node] != CsgMerkleBranchNode:
            lookup.proof = csgMerkleProofFail(
                "merkle_proof_path_kind_invalid")
            return lookup
        let splitBit = dag.nodeSplitBits[node]
        if splitBit < 0 || splitBit >= CsgMerkleHashBits ||
           splitBit <= previousSplitBit ||
           pathDepth >= CsgMerkleHashBits:
            lookup.proof = csgMerkleProofFail(
                "merkle_proof_path_split_invalid")
            return lookup
        let left = dag.nodeLefts[node]
        let right = dag.nodeRights[node]
        if left < 0 || left >= dag.nodeKinds.len ||
           right < 0 || right >= dag.nodeKinds.len ||
           left == right:
            lookup.proof = csgMerkleProofFail(
                "merkle_proof_path_child_invalid")
            return lookup
        let direction = csgMerkleBit(queryKeyHash, splitBit)
        add(out.splitBits, dag.nodeSplitBits[node])
        add(out.directions, direction)
        if direction == 0:
            add(out.siblingCounts, dag.nodeCounts[right])
            add(out.siblingHashes, dag.nodeHashes[right])
            node = left
        else:
            add(out.siblingCounts, dag.nodeCounts[left])
            add(out.siblingHashes, dag.nodeHashes[left])
            node = right
        previousSplitBit = splitBit
        pathDepth = pathDepth + 1

    if node < 0 || node >= dag.nodeKinds.len ||
       dag.nodeKinds[node] != CsgMerkleLeafNode:
        lookup.proof = csgMerkleProofFail(
            "merkle_proof_terminal_missing")
        return lookup
    let entry = dag.nodeEntries[node]
    if entry < 0 || entry >= dag.entryKeys.len:
        lookup.proof = csgMerkleProofFail(
            "merkle_proof_terminal_entry_invalid")
        return lookup
    out.terminalPresent = true
    out.terminalKey =
        strings.CloneStr(dag.entryKeys[entry])
    out.terminalFactHash = dag.entryFactHashes[entry]
    out.exists = out.terminalKey == queryKey
    out.ok = true
    lookup.proof = out
    lookup.entry = entry
    return lookup

@borrows
fn CsgCoreMerkleProveKey(
        dag: CsgCoreMerkleDag,
        queryKey: str): CsgCoreMerkleProof =
    let lookup = csgMerkleProveKeyLookup(dag, queryKey)
    return lookup.proof

@borrows
fn csgMerkleFactProofFail(
        error: str): CsgCoreMerkleFactProof =
    var out: CsgCoreMerkleFactProof
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleProveFactAtKey(
        dag: CsgCoreMerkleDag,
        queryKey: str): CsgCoreMerkleFactProof =
    if dag.entryFacts.len != dag.entryKeys.len ||
       dag.entryFacts.len != dag.entryFactHashes.len:
        return csgMerkleFactProofFail(
            "merkle_fact_table_shape_invalid")
    let lookup = csgMerkleProveKeyLookup(dag, queryKey)
    if !lookup.proof.ok:
        return csgMerkleFactProofFail(
            csgMerkleCat(
                "merkle_fact_lookup_proof ",
                lookup.proof.error))
    if !lookup.proof.exists:
        return csgMerkleFactProofFail(
            "merkle_fact_lookup_missing")
    let entry = lookup.entry
    if entry < 0 || entry >= dag.entryKeys.len ||
       dag.entryKeys[entry] != queryKey:
        return csgMerkleFactProofFail(
            "merkle_fact_lookup_entry_invalid")
    let canonicalFact = dag.entryFacts[entry]
    var canonicalError: str
    let exactCanonicalFact = CsgCoreMerkleCanonicalFact(
        canonicalFact, canonicalError)
    var keyError: str
    let exactKey = CsgCoreMerkleFactKey(
        canonicalFact, keyError)
    let verified = CsgCoreMerkleVerifyFact(
        lookup.proof, dag.factsRoot, canonicalFact)
    if canonicalError.len > 0 ||
       exactCanonicalFact != canonicalFact ||
       keyError.len > 0 || exactKey != queryKey ||
       !layout.FixedBytes32Equal(
           csgMerkleFactHashCanonical(canonicalFact),
           dag.entryFactHashes[entry]) ||
       !verified.ok:
        return csgMerkleFactProofFail(
            "merkle_fact_lookup_identity_invalid")
    var out: CsgCoreMerkleFactProof
    out.ok = true
    out.fact = strings.CloneStr(canonicalFact)
    out.proof = lookup.proof
    return out

@borrows
fn CsgCoreMerkleFactAtKey(
        dag: CsgCoreMerkleDag,
        queryKey: str,
        fact: var str): str =
    let exact = CsgCoreMerkleProveFactAtKey(
        dag, queryKey)
    if !exact.ok:
        return strings.CloneStr(exact.error)
    fact = strings.CloneStr(exact.fact)
    return ""

@borrows
fn CsgCoreMerkleProveCanonicalLines(
        canonicalLines: str[],
        queryKey: str,
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str): CsgCoreMerkleProof =
    let dag = CsgCoreMerkleBuildCanonicalBound(
        canonicalLines,
        standard,
        profiles,
        schemaNamespace,
        schemaCid)
    return CsgCoreMerkleProveKey(dag, queryKey)

fn csgMerkleVerifyFail(error: str): CsgCoreMerkleVerifyResult =
    var out: CsgCoreMerkleVerifyResult
    out.error = error
    return out

@borrows
fn csgMerkleProofShapeValid(
        proof: CsgCoreMerkleProof,
        error: var str): bool =
    let count = proof.splitBits.len
    if count != proof.directions.len ||
       count != proof.siblingCounts.len ||
       count != proof.siblingHashes.len:
        error = "merkle_proof_path_length_mismatch"
        return false
    var previousBit: int32 = -1
    for i in 0..<count:
        if proof.splitBits[i] <= previousBit ||
           proof.splitBits[i] >= CsgMerkleHashBits:
            error = "merkle_proof_split_order_invalid"
            return false
        if proof.directions[i] != 0 &&
           proof.directions[i] != 1:
            error = "merkle_proof_direction_invalid"
            return false
        if proof.siblingCounts[i] <= 0:
            error = "merkle_proof_sibling_count_invalid"
            return false
        if layout.FixedBytes32Equal(
               proof.siblingHashes[i],
               layout.FixedBytes32()):
            error = "merkle_proof_sibling_hash_invalid"
            return false
        previousBit = proof.splitBits[i]
    return true

@borrows
fn csgMerkleProofFold(
        proof: CsgCoreMerkleProof,
        startHash: layout.FixedBytes32,
        startCount: int32,
        startAt: int32,
        stopBefore: int32,
        outHash: var layout.FixedBytes32,
        outCount: var int32,
        error: var str): bool =
    var hash = startHash
    var count = startCount
    var i = startAt
    while i > stopBefore:
        let siblingCount = proof.siblingCounts[i]
        if count <= 0 ||
           count > 2147483647 - siblingCount:
            error = "merkle_proof_count_overflow"
            return false
        if proof.directions[i] == 0:
            hash = csgMerkleBranchHash(
                proof.splitBits[i],
                count,
                hash,
                siblingCount,
                proof.siblingHashes[i])
        else:
            hash = csgMerkleBranchHash(
                proof.splitBits[i],
                siblingCount,
                proof.siblingHashes[i],
                count,
                hash)
        count = count + siblingCount
        i = i - 1
    outHash = hash
    outCount = count
    return true

@borrows
fn csgMerkleVerifyProofTransport(
        proof: CsgCoreMerkleProof): CsgCoreMerkleVerifyResult =
    if !proof.ok:
        return csgMerkleVerifyFail(
            csgMerkleCat("merkle_proof_invalid ", proof.error))
    if proof.error.len > 0:
        return csgMerkleVerifyFail(
            "merkle_proof_success_error_nonempty")
    if proof.queryKey.len == 0:
        return csgMerkleVerifyFail("merkle_query_key_empty")
    if !csgMerkleUtf8Valid(proof.queryKey):
        return csgMerkleVerifyFail(
            "merkle_query_key_utf8_invalid")
    if proof.factCount < 0:
        return csgMerkleVerifyFail(
            "merkle_proof_fact_count_invalid")
    let bindingError = csgMerkleBindingError(
        proof.standard,
        proof.profiles,
        proof.schemaNamespace,
        proof.schemaCid)
    if bindingError.len > 0:
        return csgMerkleVerifyFail(bindingError)
    var reportedDagRoot: layout.FixedBytes32
    var reportedSubgraph: layout.FixedBytes32
    var reportedFactsRoot: layout.FixedBytes32
    if !csgMerkleParseCid(
           proof.dagRootCid, reportedDagRoot):
        return csgMerkleVerifyFail(
            "merkle_proof_dag_root_cid_invalid")
    if !csgMerkleParseCid(
           proof.subgraphCid, reportedSubgraph):
        return csgMerkleVerifyFail(
            "merkle_proof_subgraph_cid_invalid")
    if !csgMerkleParseCid(
           proof.factsRoot, reportedFactsRoot):
        return csgMerkleVerifyFail(
            "merkle_proof_facts_root_invalid")
    var shapeError: str
    if !csgMerkleProofShapeValid(proof, shapeError):
        return csgMerkleVerifyFail(shapeError)

    var dagRoot = csgMerkleEmptyHash()
    var rootCount: int32
    let zeroHash = layout.FixedBytes32()
    if proof.factCount == 0:
        if proof.terminalPresent ||
           proof.exists ||
           proof.splitBits.len != 0 ||
           proof.terminalKey.len != 0 ||
           !layout.FixedBytes32Equal(
               proof.terminalFactHash, zeroHash):
            return csgMerkleVerifyFail(
                "merkle_empty_proof_shape_invalid")
    else:
        if !proof.terminalPresent ||
           proof.terminalKey.len == 0:
            return csgMerkleVerifyFail(
                "merkle_proof_terminal_missing")
        if !csgMerkleUtf8Valid(proof.terminalKey):
            return csgMerkleVerifyFail(
                "merkle_proof_terminal_key_utf8_invalid")
        if layout.FixedBytes32Equal(
               proof.terminalFactHash, zeroHash):
            return csgMerkleVerifyFail(
                "merkle_proof_terminal_fact_hash_invalid")
        let queryKeyHash =
            csgMerkleKeyHash(proof.queryKey)
        let terminalKeyHash =
            csgMerkleKeyHash(proof.terminalKey)
        if layout.FixedBytes32Equal(
               queryKeyHash, terminalKeyHash) &&
           proof.queryKey != proof.terminalKey:
            return csgMerkleVerifyFail(
                "merkle_key_hash_collision")
        if proof.exists !=
           (proof.queryKey == proof.terminalKey):
            return csgMerkleVerifyFail(
                "merkle_proof_existence_mismatch")
        for i in 0..<proof.splitBits.len:
            let queryDirection =
                csgMerkleBit(
                    queryKeyHash, proof.splitBits[i])
            let terminalDirection =
                csgMerkleBit(
                    terminalKeyHash, proof.splitBits[i])
            if queryDirection != proof.directions[i] ||
               terminalDirection != proof.directions[i]:
                return csgMerkleVerifyFail(
                    "merkle_proof_direction_mismatch")
        let leafHash = csgMerkleLeafHash(
            terminalKeyHash, proof.terminalFactHash)
        var foldError: str
        if !csgMerkleProofFold(
               proof,
               leafHash,
               1,
               proof.splitBits.len - 1,
               -1,
               dagRoot,
               rootCount,
               foldError):
            return csgMerkleVerifyFail(foldError)
    if rootCount != proof.factCount:
        return csgMerkleVerifyFail(
            "merkle_proof_fact_count_mismatch")
    if !layout.FixedBytes32Equal(
           dagRoot, reportedDagRoot):
        return csgMerkleVerifyFail(
            "merkle_proof_dag_root_cid_mismatch")

    let expectedSubgraph = csgMerkleSubgraphHash(
        rootCount, dagRoot)
    if !layout.FixedBytes32Equal(
           expectedSubgraph, reportedSubgraph):
        return csgMerkleVerifyFail(
            "merkle_proof_subgraph_cid_mismatch")

    var schemaHash: layout.FixedBytes32
    let _ = csgMerkleParseCid(
        proof.schemaCid, schemaHash)
    let expectedFactsRoot =
        csgMerkleFactsRootHash(
            proof.standard,
            proof.profiles,
            proof.schemaNamespace,
            schemaHash,
            expectedSubgraph)
    if !layout.FixedBytes32Equal(
           expectedFactsRoot, reportedFactsRoot):
        return csgMerkleVerifyFail(
            "merkle_proof_facts_root_mismatch")

    var out: CsgCoreMerkleVerifyResult
    out.ok = true
    out.exists = proof.exists
    out.factCount = rootCount
    out.dagRootCid = csgMerkleNodeCidText(dagRoot)
    out.subgraphCid =
        csgMerkleNodeCidText(expectedSubgraph)
    out.factsRoot =
        csgMerkleNodeCidText(expectedFactsRoot)
    return out

@borrows
fn csgMerkleExpectedFactsRootValid(
        expectedFactsRoot: str): bool =
    var parsed: layout.FixedBytes32
    return csgMerkleParseCid(
        expectedFactsRoot, parsed)

@borrows
fn CsgCoreMerkleVerifyProof(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str):
        CsgCoreMerkleVerifyResult =
    if !csgMerkleExpectedFactsRootValid(
           expectedFactsRoot):
        return csgMerkleVerifyFail(
            "merkle_expected_facts_root_invalid")
    let verified =
        csgMerkleVerifyProofTransport(proof)
    if !verified.ok:
        return verified
    if verified.factsRoot != expectedFactsRoot:
        return csgMerkleVerifyFail(
            "merkle_proof_expected_facts_root_mismatch")
    return verified

@borrows
fn CsgCoreMerkleVerifyFact(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): CsgCoreMerkleVerifyResult =
    let verified = CsgCoreMerkleVerifyProof(
        proof, expectedFactsRoot)
    if !verified.ok:
        return verified
    if !verified.exists:
        return csgMerkleVerifyFail(
            "merkle_fact_not_in_proof")
    var keyError: str
    let canonicalFact =
        csgMerkleCanonicalizeFact(fact, keyError)
    if keyError.len > 0:
        return csgMerkleVerifyFail(keyError)
    if canonicalFact != fact:
        return csgMerkleVerifyFail(
            "merkle_fact_noncanonical")
    let factHash =
        csgMerkleFactHashCanonical(canonicalFact)
    let factKey = csgMerkleKeyForFact(
        canonicalFact, factHash, keyError)
    if keyError.len > 0:
        return csgMerkleVerifyFail(keyError)
    if factKey != proof.queryKey:
        return csgMerkleVerifyFail(
            "merkle_fact_key_mismatch")
    if !layout.FixedBytes32Equal(
           factHash, proof.terminalFactHash):
        return csgMerkleVerifyFail(
            "merkle_fact_hash_mismatch")
    return verified

@borrows
fn csgMerkleReplayFail(
        proof: CsgCoreMerkleProof,
        error: str): CsgCoreMerkleReplayResult =
    var out: CsgCoreMerkleReplayResult
    out.error = strings.CloneStr(error)
    out.beforeDagRootCid =
        strings.CloneStr(proof.dagRootCid)
    out.beforeSubgraphCid =
        strings.CloneStr(proof.subgraphCid)
    out.beforeFactsRoot =
        strings.CloneStr(proof.factsRoot)
    out.beforeCount = proof.factCount
    return out

@borrows
fn CsgCoreMerkleReplayReplace(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): CsgCoreMerkleReplayResult =
    return csgMerkleReplayFail(
        proof,
        "merkle_replay_replace_requires_verified_before_fact")

@borrows
fn CsgCoreMerkleReplayDelete(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str):
        CsgCoreMerkleReplayResult =
    return csgMerkleReplayFail(
        proof,
        "merkle_replay_delete_requires_admitted_bound_delta")

@borrows
fn CsgCoreMerkleReplayInsert(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): CsgCoreMerkleReplayResult =
    return csgMerkleReplayFail(
        proof,
        "merkle_replay_insert_requires_admitted_bound_delta")

@borrows
fn csgMerkleProfilesEqual(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn CsgCoreMerkleReplayBindingFromProof(
        proof: CsgCoreMerkleProof): CsgCoreMerkleReplayBinding =
    var out: CsgCoreMerkleReplayBinding
    let receipt = identity.CsgCoreBindingIdentityIssue(
        proof.standard,
        proof.schemaNamespace,
        proof.schemaCid,
        proof.profiles)
    if !receipt.ok:
        return out
    out.standard = strings.CloneStr(receipt.standard)
    out.profiles =
        identity.CsgCoreProfilesClone(receipt.profiles)
    out.profileSetCid = strings.CloneStr(receipt.profileSetCid)
    out.schemaNamespace =
        strings.CloneStr(receipt.schemaNamespace)
    out.schemaCid = strings.CloneStr(receipt.schemaCid)
    out.bindingIdentityReceiptCid =
        strings.CloneStr(receipt.bindingIdentityReceiptCid)
    return out

@borrows
fn csgMerkleReplayBindingClone(
        source: CsgCoreMerkleReplayBinding):
        CsgCoreMerkleReplayBinding =
    var out: CsgCoreMerkleReplayBinding
    out.standard = strings.CloneStr(source.standard)
    out.profiles = identity.CsgCoreProfilesClone(source.profiles)
    out.profileSetCid = strings.CloneStr(source.profileSetCid)
    out.schemaNamespace = strings.CloneStr(source.schemaNamespace)
    out.schemaCid = strings.CloneStr(source.schemaCid)
    out.bindingIdentityReceiptCid =
        strings.CloneStr(source.bindingIdentityReceiptCid)
    return out

@borrows
fn csgMerkleReplayBindingError(
        binding: CsgCoreMerkleReplayBinding): str =
    let bindingError = csgMerkleBindingError(
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid)
    if bindingError.len > 0:
        return bindingError
    let receipt = identity.CsgCoreBindingIdentityIssue(
        binding.standard,
        binding.schemaNamespace,
        binding.schemaCid,
        binding.profiles)
    if !receipt.ok:
        return "merkle_replay_binding_identity_invalid"
    if binding.profileSetCid != receipt.profileSetCid:
        return "merkle_replay_profile_set_cid_mismatch"
    if binding.bindingIdentityReceiptCid !=
       receipt.bindingIdentityReceiptCid:
        return "merkle_replay_binding_identity_receipt_cid_mismatch"
    return ""

@borrows
fn csgMerkleReplayBindingMatchesProof(
        binding: CsgCoreMerkleReplayBinding,
        proof: CsgCoreMerkleProof): bool =
    return binding.standard == proof.standard &&
        csgMerkleProfilesEqual(
            binding.profiles, proof.profiles) &&
        binding.schemaNamespace == proof.schemaNamespace &&
        binding.schemaCid == proof.schemaCid

@borrows
fn csgMerkleReplayFactContract(
        fact: str,
        canonicalFact: var str,
        factKind: var str,
        factKey: var str): str =
    var canonicalError: str
    canonicalFact =
        csgMerkleCanonicalizeFact(fact, canonicalError)
    if canonicalError.len > 0:
        return canonicalError
    if canonicalFact != fact:
        return "merkle_replay_fact_noncanonical"
    let kind = field.CsgCoreJsonKind(canonicalFact)
    if !kind.found || kind.value.len == 0:
        return "merkle_replay_fact_kind_missing"
    factKind = strings.CloneStr(kind.value)
    let factHash =
        csgMerkleFactHashCanonical(canonicalFact)
    var keyError: str
    factKey = csgMerkleKeyForFact(
        canonicalFact, factHash, keyError)
    if keyError.len > 0:
        return keyError
    return ""

@borrows
fn csgMerkleReplayBeforeFactError(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        beforeFact: str,
        canonicalFact: var str,
        factKind: var str,
        factKey: var str): str =
    let factError = csgMerkleReplayFactContract(
        beforeFact, canonicalFact, factKind, factKey)
    if factError.len > 0:
        return factError
    let verified = CsgCoreMerkleVerifyFact(
        proof, expectedFactsRoot, canonicalFact)
    if !verified.ok:
        return strings.CloneStr(verified.error)
    if !verified.exists:
        return "merkle_replay_before_fact_not_proven"
    return ""

@borrows
fn csgMerkleProofDagRootHash(
        proof: CsgCoreMerkleProof,
        trustedExpectedFactsRoot: str,
        outHash: var layout.FixedBytes32,
        error: var str): bool =
    error = ""
    let verified =
        CsgCoreMerkleVerifyProof(
            proof, trustedExpectedFactsRoot)
    if !verified.ok:
        error = verified.error
        return false
    return csgMerkleParseCid(
        verified.dagRootCid, outHash)

@borrows
fn CsgCoreMerkleProofDagRootCid(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str): str =
    var rootHash: layout.FixedBytes32
    var error: str
    if !csgMerkleProofDagRootHash(
           proof,
           expectedFactsRoot,
           rootHash,
           error):
        return csgMerkleCat("invalid:", error)
    return csgMerkleNodeCidText(rootHash)

@borrows
fn CsgCoreMerkleDagRootCid(
        dag: CsgCoreMerkleDag): str =
    if !dag.ok:
        return csgMerkleCat(
            "invalid:", dag.error)
    var expected = csgMerkleEmptyHash()
    if dag.rootNode < 0:
        if dag.factCount != 0:
            return "invalid:merkle_empty_root_count_mismatch"
    else:
        if dag.rootNode >= dag.nodeHashes.len ||
           dag.rootNode >= dag.nodeCounts.len:
            return "invalid:merkle_root_node_out_of_range"
        if dag.nodeCounts[dag.rootNode] !=
           dag.factCount:
            return "invalid:merkle_root_count_mismatch"
        expected = layout.FixedBytes32Copy(
            dag.nodeHashes[dag.rootNode])
    var reported: layout.FixedBytes32
    if !csgMerkleParseCid(
           dag.dagRootCid, reported):
        return "invalid:merkle_dag_root_cid_invalid"
    if !layout.FixedBytes32Equal(
           expected, reported):
        return "invalid:merkle_dag_root_cid_mismatch"
    return strings.CloneStr(dag.dagRootCid)

@borrows
fn CsgCoreMerkleSubgraphCidForDagRoot(
        factCount: int32,
        dagRootCid: str,
        error: var str): str =
    error = ""
    if factCount < 0:
        error = "merkle_dag_root_input_invalid"
        return ""
    var dagRoot: layout.FixedBytes32
    if !csgMerkleParseCid(
           dagRootCid, dagRoot):
        error = "merkle_dag_root_cid_invalid"
        return ""
    return csgMerkleSubgraphText(
        factCount, dagRoot)

@borrows
fn CsgCoreMerkleFactsRootForSubgraph(
        standard: str,
        profiles: str[],
        schemaNamespace: str,
        schemaCid: str,
        subgraphCid: str,
        error: var str): str =
    error = csgMerkleBindingError(
        standard,
        profiles,
        schemaNamespace,
        schemaCid)
    if error.len > 0:
        return ""
    var schemaHash: layout.FixedBytes32
    var subgraphHash: layout.FixedBytes32
    let _ = csgMerkleParseCid(
        schemaCid, schemaHash)
    if !csgMerkleParseCid(
           subgraphCid, subgraphHash):
        error = "merkle_subgraph_cid_invalid"
        return ""
    return csgMerkleFactsRootText(
        standard,
        profiles,
        schemaNamespace,
        schemaHash,
        subgraphHash)

@borrows
fn csgMerklePatchFail(
        proof: CsgCoreMerkleProof,
        error: str): csgCoreMerklePatchResult =
    var out: csgCoreMerklePatchResult
    out.error = strings.CloneStr(error)
    out.beforeBinding =
        CsgCoreMerkleReplayBindingFromProof(proof)
    out.afterBinding =
        CsgCoreMerkleReplayBindingFromProof(proof)
    out.beforeDagRootCid =
        strings.CloneStr(proof.dagRootCid)
    out.beforeSubgraphCid =
        strings.CloneStr(proof.subgraphCid)
    out.beforeFactsRoot =
        strings.CloneStr(proof.factsRoot)
    out.beforeCount = proof.factCount
    return out

@borrows
fn csgMerklePatchStart(
        proof: CsgCoreMerkleProof):
        csgCoreMerklePatchResult =
    var out: csgCoreMerklePatchResult
    out.beforeBinding =
        CsgCoreMerkleReplayBindingFromProof(proof)
    out.afterBinding =
        CsgCoreMerkleReplayBindingFromProof(proof)
    out.beforeDagRootCid =
        strings.CloneStr(proof.dagRootCid)
    out.beforeSubgraphCid =
        strings.CloneStr(proof.subgraphCid)
    out.beforeFactsRoot =
        strings.CloneStr(proof.factsRoot)
    out.beforeCount = proof.factCount
    return out

@borrows
fn csgMerklePatchFinish(
        proof: CsgCoreMerkleProof,
        out: var csgCoreMerklePatchResult,
        rootHash: layout.FixedBytes32,
        factCount: int32): bool =
    if factCount < 0:
        out.error = "merkle_patch_fact_count_invalid"
        return false
    for i in 0..<out.nodes.len:
        let nodeError =
            CsgCoreMerkleNodeRecordError(
                out.nodes[i])
        if nodeError.len > 0:
            out.error = csgMerkleCat(
                "merkle_patch_node_invalid ",
                nodeError)
            return false
    let totalNodeCount =
        factCount == 0 ?
        int64(0) :
        int64(factCount) * int64(2) - int64(1)
    let rebuiltNodeCount = int64(out.nodes.len)
    if rebuiltNodeCount > totalNodeCount:
        out.error = "merkle_patch_rebuilt_count_invalid"
        return false
    out.afterDagRootCid =
        csgMerkleNodeCidText(rootHash)
    let subgraphHash =
        csgMerkleSubgraphHash(
            factCount, rootHash)
    out.afterSubgraphCid =
        csgMerkleNodeCidText(subgraphHash)
    var schemaHash: layout.FixedBytes32
    if !csgMerkleParseCid(
           proof.schemaCid, schemaHash):
        out.error = "merkle_patch_schema_cid_invalid"
        return false
    out.afterFactsRoot =
        csgMerkleFactsRootText(
            proof.standard,
            proof.profiles,
            proof.schemaNamespace,
            schemaHash,
            subgraphHash)
    out.afterCount = factCount
    out.rebuiltNodeCount = rebuiltNodeCount
    out.reusedNodeCount =
        totalNodeCount - rebuiltNodeCount
    out.ok = true
    return true

@borrows
fn csgMerklePatchReplaceExact(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): csgCoreMerklePatchResult =
    let verified =
        CsgCoreMerkleVerifyProof(
            proof, expectedFactsRoot)
    if !verified.ok:
        return csgMerklePatchFail(
            proof, verified.error)
    if !verified.exists:
        return csgMerklePatchFail(
            proof, "merkle_replace_missing_key")

    var keyError: str
    let canonicalFact =
        csgMerkleCanonicalizeFact(fact, keyError)
    if keyError.len > 0:
        return csgMerklePatchFail(proof, keyError)
    if canonicalFact != fact:
        return csgMerklePatchFail(
            proof, "merkle_patch_fact_non_canonical")
    let factHash =
        csgMerkleFactHashCanonical(canonicalFact)
    let factKey = csgMerkleKeyForFact(
        canonicalFact, factHash, keyError)
    if keyError.len > 0:
        return csgMerklePatchFail(proof, keyError)
    if factKey != proof.queryKey:
        return csgMerklePatchFail(
            proof, "merkle_replace_key_mismatch")

    var out = csgMerklePatchStart(proof)
    out.canonicalFact =
        strings.CloneStr(canonicalFact)
    out.factHash =
        layout.FixedBytes32Copy(factHash)
    if layout.FixedBytes32Equal(
           factHash, proof.terminalFactHash):
        var unchangedRoot: layout.FixedBytes32
        var unchangedError: str
        if !csgMerkleProofDagRootHash(
               proof,
               expectedFactsRoot,
               unchangedRoot,
               unchangedError):
            return csgMerklePatchFail(
                proof, unchangedError)
        let _ = csgMerklePatchFinish(
            proof, out, unchangedRoot, proof.factCount)
        return out

    let leaf =
        csgMerkleLeafRecord(factKey, factHash)
    let leafHash =
        layout.FixedBytes32Copy(leaf.hash)
    add(out.nodes, leaf)
    var currentHash =
        layout.FixedBytes32Copy(leafHash)
    var currentCount: int32 = 1
    var pathIndex = proof.splitBits.len - 1
    while pathIndex >= 0:
        var branch: CsgCoreMerkleNodeRecord
        if proof.directions[pathIndex] == 0:
            branch = csgMerkleBranchRecord(
                proof.splitBits[pathIndex],
                currentCount,
                currentHash,
                proof.siblingCounts[pathIndex],
                proof.siblingHashes[pathIndex])
        else:
            branch = csgMerkleBranchRecord(
                proof.splitBits[pathIndex],
                proof.siblingCounts[pathIndex],
                proof.siblingHashes[pathIndex],
                currentCount,
                currentHash)
        let branchHash =
            layout.FixedBytes32Copy(branch.hash)
        let branchCount = branch.count
        add(out.nodes, branch)
        currentHash =
            layout.FixedBytes32Copy(branchHash)
        currentCount = branchCount
        pathIndex = pathIndex - 1
    if currentCount != proof.factCount:
        return csgMerklePatchFail(
            proof, "merkle_replace_count_mismatch")
    let _ = csgMerklePatchFinish(
        proof, out, currentHash, currentCount)
    return out

@borrows
fn csgMerklePatchDeleteExact(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str):
        csgCoreMerklePatchResult =
    let verified =
        CsgCoreMerkleVerifyProof(
            proof, expectedFactsRoot)
    if !verified.ok:
        return csgMerklePatchFail(
            proof, verified.error)
    if !verified.exists:
        return csgMerklePatchFail(
            proof, "merkle_delete_missing_key")

    var out = csgMerklePatchStart(proof)
    if proof.factCount == 1:
        let _ = csgMerklePatchFinish(
            proof, out, csgMerkleEmptyHash(), 0)
        return out
    if proof.splitBits.len == 0:
        return csgMerklePatchFail(
            proof, "merkle_delete_parent_missing")

    let deepest = proof.splitBits.len - 1
    var currentHash =
        layout.FixedBytes32Copy(
            proof.siblingHashes[deepest])
    var currentCount =
        proof.siblingCounts[deepest]
    var pathIndex = deepest - 1
    while pathIndex >= 0:
        var branch: CsgCoreMerkleNodeRecord
        if proof.directions[pathIndex] == 0:
            branch = csgMerkleBranchRecord(
                proof.splitBits[pathIndex],
                currentCount,
                currentHash,
                proof.siblingCounts[pathIndex],
                proof.siblingHashes[pathIndex])
        else:
            branch = csgMerkleBranchRecord(
                proof.splitBits[pathIndex],
                proof.siblingCounts[pathIndex],
                proof.siblingHashes[pathIndex],
                currentCount,
                currentHash)
        let branchHash =
            layout.FixedBytes32Copy(branch.hash)
        let branchCount = branch.count
        add(out.nodes, branch)
        currentHash =
            layout.FixedBytes32Copy(branchHash)
        currentCount = branchCount
        pathIndex = pathIndex - 1
    if currentCount != proof.factCount - 1:
        return csgMerklePatchFail(
            proof, "merkle_delete_count_mismatch")
    let _ = csgMerklePatchFinish(
        proof, out, currentHash, currentCount)
    return out

@borrows
fn csgMerklePatchInsertExact(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): csgCoreMerklePatchResult =
    let verified =
        CsgCoreMerkleVerifyProof(
            proof, expectedFactsRoot)
    if !verified.ok:
        return csgMerklePatchFail(
            proof, verified.error)
    if verified.exists:
        return csgMerklePatchFail(
            proof, "merkle_insert_duplicate_key")
    if proof.factCount >= 2147483647:
        return csgMerklePatchFail(
            proof, "merkle_insert_count_overflow")

    var keyError: str
    let canonicalFact =
        csgMerkleCanonicalizeFact(fact, keyError)
    if keyError.len > 0:
        return csgMerklePatchFail(proof, keyError)
    if canonicalFact != fact:
        return csgMerklePatchFail(
            proof, "merkle_patch_fact_non_canonical")
    let factHash =
        csgMerkleFactHashCanonical(canonicalFact)
    let factKey = csgMerkleKeyForFact(
        canonicalFact, factHash, keyError)
    if keyError.len > 0:
        return csgMerklePatchFail(proof, keyError)
    if factKey != proof.queryKey:
        return csgMerklePatchFail(
            proof, "merkle_insert_key_mismatch")

    var out = csgMerklePatchStart(proof)
    out.canonicalFact =
        strings.CloneStr(canonicalFact)
    out.factHash =
        layout.FixedBytes32Copy(factHash)
    let leaf =
        csgMerkleLeafRecord(factKey, factHash)
    let leafHash =
        layout.FixedBytes32Copy(leaf.hash)
    let keyHash =
        layout.FixedBytes32Copy(leaf.keyHash)
    add(out.nodes, leaf)
    if proof.factCount == 0:
        let _ = csgMerklePatchFinish(
            proof, out, leafHash, 1)
        return out

    let terminalKeyHash =
        csgMerkleKeyHash(proof.terminalKey)
    let splitBit = csgMerkleFirstDifferentBit(
        keyHash, terminalKeyHash)
    if splitBit < 0:
        return csgMerklePatchFail(
            proof, "merkle_insert_key_hash_collision")

    var oldSubtreeHash = csgMerkleLeafHash(
        terminalKeyHash, proof.terminalFactHash)
    var oldSubtreeCount: int32 = 1
    var pathIndex = proof.splitBits.len - 1
    while pathIndex >= 0 &&
          proof.splitBits[pathIndex] > splitBit:
        let siblingCount =
            proof.siblingCounts[pathIndex]
        if oldSubtreeCount >
           2147483647 - siblingCount:
            return csgMerklePatchFail(
                proof, "merkle_insert_count_overflow")
        if proof.directions[pathIndex] == 0:
            oldSubtreeHash = csgMerkleBranchHash(
                proof.splitBits[pathIndex],
                oldSubtreeCount,
                oldSubtreeHash,
                siblingCount,
                proof.siblingHashes[pathIndex])
        else:
            oldSubtreeHash = csgMerkleBranchHash(
                proof.splitBits[pathIndex],
                siblingCount,
                proof.siblingHashes[pathIndex],
                oldSubtreeCount,
                oldSubtreeHash)
        oldSubtreeCount =
            oldSubtreeCount + siblingCount
        pathIndex = pathIndex - 1
    if pathIndex >= 0 &&
       proof.splitBits[pathIndex] == splitBit:
        return csgMerklePatchFail(
            proof, "merkle_insert_split_collision")

    var inserted: CsgCoreMerkleNodeRecord
    if csgMerkleBit(keyHash, splitBit) == 0:
        inserted = csgMerkleBranchRecord(
            splitBit,
            1,
            leafHash,
            oldSubtreeCount,
            oldSubtreeHash)
    else:
        inserted = csgMerkleBranchRecord(
            splitBit,
            oldSubtreeCount,
            oldSubtreeHash,
            1,
            leafHash)
    let insertedHash =
        layout.FixedBytes32Copy(inserted.hash)
    let insertedCount = inserted.count
    add(out.nodes, inserted)
    var currentHash =
        layout.FixedBytes32Copy(insertedHash)
    var currentCount = insertedCount
    while pathIndex >= 0:
        var branch: CsgCoreMerkleNodeRecord
        if proof.directions[pathIndex] == 0:
            branch = csgMerkleBranchRecord(
                proof.splitBits[pathIndex],
                currentCount,
                currentHash,
                proof.siblingCounts[pathIndex],
                proof.siblingHashes[pathIndex])
        else:
            branch = csgMerkleBranchRecord(
                proof.splitBits[pathIndex],
                proof.siblingCounts[pathIndex],
                proof.siblingHashes[pathIndex],
                currentCount,
                currentHash)
        let branchHash =
            layout.FixedBytes32Copy(branch.hash)
        let branchCount = branch.count
        add(out.nodes, branch)
        currentHash =
            layout.FixedBytes32Copy(branchHash)
        currentCount = branchCount
        pathIndex = pathIndex - 1
    if currentCount != proof.factCount + 1:
        return csgMerklePatchFail(
            proof, "merkle_insert_count_mismatch")
    let _ = csgMerklePatchFinish(
        proof, out, currentHash, currentCount)
    return out

@borrows
fn csgCoreMerklePatchReplace(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): csgCoreMerklePatchResult =
    return csgMerklePatchFail(
        proof,
        "merkle_patch_replace_requires_verified_before_fact")

@borrows
fn csgCoreMerklePatchDelete(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str):
        csgCoreMerklePatchResult =
    return csgMerklePatchFail(
        proof,
        "merkle_patch_delete_requires_admitted_bound_delta")

@borrows
fn csgCoreMerklePatchInsert(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        fact: str): csgCoreMerklePatchResult =
    return csgMerklePatchFail(
        proof,
        "merkle_patch_insert_requires_admitted_bound_delta")

@borrows
fn csgMerklePatchReplaceBound(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        beforeFact: str,
        afterFact: str): csgCoreMerklePatchResult =
    let binding =
        CsgCoreMerkleReplayBindingFromProof(proof)
    let bindingError =
        csgMerkleReplayBindingError(binding)
    if bindingError.len > 0 ||
       !csgMerkleReplayBindingMatchesProof(
           binding, proof):
        if bindingError.len > 0:
            return csgMerklePatchFail(
                proof, bindingError)
        return csgMerklePatchFail(
            proof, "merkle_replay_before_binding_mismatch")

    var oldCanonical: str
    var oldKind: str
    var oldKey: str
    let oldError = csgMerkleReplayBeforeFactError(
        proof,
        expectedFactsRoot,
        beforeFact,
        oldCanonical,
        oldKind,
        oldKey)
    if oldError.len > 0:
        return csgMerklePatchFail(
            proof, oldError)

    var newCanonical: str
    var newKind: str
    var newKey: str
    let newError = csgMerkleReplayFactContract(
        afterFact,
        newCanonical,
        newKind,
        newKey)
    if newError.len > 0:
        return csgMerklePatchFail(
            proof, newError)
    if oldKind == "csg.core.schema" ||
       newKind == "csg.core.schema":
        return csgMerklePatchFail(
            proof,
            "merkle_replay_schema_mutation_forbidden")
    if oldKey != newKey || oldKey != proof.queryKey:
        return csgMerklePatchFail(
            proof,
            "merkle_replay_replace_key_mismatch")
    if oldKind != newKind:
        return csgMerklePatchFail(
            proof,
            "merkle_replay_replace_kind_mismatch")
    if oldCanonical == newCanonical:
        return csgMerklePatchFail(
            proof,
            "merkle_replay_replace_unchanged")
    let patch = csgMerklePatchReplaceExact(
        proof, expectedFactsRoot, newCanonical)
    if !patch.ok:
        return csgMerklePatchFail(
            proof, patch.error)
    if layout.FixedBytes32Equal(
           patch.factHash, proof.terminalFactHash):
        return csgMerklePatchFail(
            proof,
            "merkle_replay_fact_hash_collision")
    if patch.afterFactsRoot == patch.beforeFactsRoot:
        return csgMerklePatchFail(
            proof,
            "merkle_replay_root_collision")
    return patch

@borrows
fn csgCoreMerklePatchDeleteBound(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        beforeFact: str): csgCoreMerklePatchResult =
    return csgMerklePatchFail(
        proof,
        "merkle_patch_delete_requires_admitted_bound_delta")

@borrows
fn csgCoreMerklePatchInsertBound(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        afterFact: str): csgCoreMerklePatchResult =
    return csgMerklePatchFail(
        proof,
        "merkle_patch_insert_requires_admitted_bound_delta")

@borrows
fn csgMerkleNodeRecordClone(
        source: CsgCoreMerkleNodeRecord):
        CsgCoreMerkleNodeRecord =
    var out: CsgCoreMerkleNodeRecord
    out.kind = source.kind
    out.count = source.count
    out.splitBit = source.splitBit
    out.hash = layout.FixedBytes32Copy(source.hash)
    out.key = strings.CloneStr(source.key)
    out.keyHash = layout.FixedBytes32Copy(source.keyHash)
    out.factHash = layout.FixedBytes32Copy(source.factHash)
    out.leftCount = source.leftCount
    out.leftHash = layout.FixedBytes32Copy(source.leftHash)
    out.rightCount = source.rightCount
    out.rightHash = layout.FixedBytes32Copy(source.rightHash)
    return out

@borrows
fn csgMerkleReplayFromPatch(
        patch: csgCoreMerklePatchResult):
        CsgCoreMerkleReplayResult =
    var out: CsgCoreMerkleReplayResult
    out.ok = patch.ok
    out.error = strings.CloneStr(patch.error)
    out.beforeBinding =
        csgMerkleReplayBindingClone(patch.beforeBinding)
    out.afterBinding =
        csgMerkleReplayBindingClone(patch.afterBinding)
    out.beforeDagRootCid =
        strings.CloneStr(patch.beforeDagRootCid)
    out.afterDagRootCid =
        strings.CloneStr(patch.afterDagRootCid)
    out.beforeSubgraphCid =
        strings.CloneStr(patch.beforeSubgraphCid)
    out.afterSubgraphCid =
        strings.CloneStr(patch.afterSubgraphCid)
    out.beforeFactsRoot =
        strings.CloneStr(patch.beforeFactsRoot)
    out.afterFactsRoot =
        strings.CloneStr(patch.afterFactsRoot)
    out.beforeCount = patch.beforeCount
    out.afterCount = patch.afterCount
    out.canonicalFact =
        strings.CloneStr(patch.canonicalFact)
    out.factHash =
        layout.FixedBytes32Copy(patch.factHash)
    out.rebuiltNodeCount = patch.rebuiltNodeCount
    out.reusedNodeCount = patch.reusedNodeCount
    for i in 0..<patch.nodes.len:
        add(
            out.nodes,
            csgMerkleNodeRecordClone(patch.nodes[i]))
    return out

@borrows
fn csgMerkleReplayReplaceStructureError(
        proof: CsgCoreMerkleProof,
        replay: CsgCoreMerkleReplayResult): str =
    if proof.factCount < 1:
        return "merkle_replay_replace_before_count_invalid"
    var expectedCount: int64 = 1
    var expectedReused: int64
    for i in 0..<proof.siblingCounts.len:
        if proof.siblingCounts[i] < 1:
            return "merkle_replay_sibling_count_invalid"
        expectedCount =
            expectedCount + int64(proof.siblingCounts[i])
        expectedReused =
            expectedReused +
            int64(proof.siblingCounts[i]) * int64(2) -
            int64(1)
    let expectedRebuilt =
        int64(proof.splitBits.len) + int64(1)
    let expectedTotal =
        int64(proof.factCount) * int64(2) - int64(1)
    if expectedCount != int64(proof.factCount) ||
       replay.beforeCount != proof.factCount ||
       replay.afterCount != proof.factCount:
        return "merkle_replay_replace_count_identity_invalid"
    if replay.nodes.len != proof.splitBits.len + 1 ||
       replay.rebuiltNodeCount != expectedRebuilt ||
       replay.reusedNodeCount != expectedReused ||
       expectedRebuilt + expectedReused != expectedTotal:
        return "merkle_replay_replace_node_count_identity_invalid"
    for i in 0..<replay.nodes.len:
        let cid = CsgCoreMerkleNodeRecordCid(replay.nodes[i])
        for previous in 0..<i:
            if CsgCoreMerkleNodeRecordCid(
                   replay.nodes[previous]) == cid:
                return "merkle_replay_replace_duplicate_node"
    if replay.nodes.len == 0 ||
       CsgCoreMerkleNodeRecordCid(
           replay.nodes[replay.nodes.len - 1]) !=
           replay.afterDagRootCid:
        return "merkle_replay_replace_root_node_mismatch"
    return ""

@borrows
fn csgMerkleReplayDeltaFail(
        proof: CsgCoreMerkleProof,
        error: str): CsgCoreMerkleReplayDelta =
    var out: CsgCoreMerkleReplayDelta
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleReplayReplaceBound(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        beforeFact: str,
        afterFact: str): CsgCoreMerkleReplayDelta =
    let patch =
        csgMerklePatchReplaceBound(
            proof,
            expectedFactsRoot,
            beforeFact,
            afterFact)
    if !patch.ok:
        return csgMerkleReplayDeltaFail(
            proof, patch.error)
    let replay =
        csgMerkleReplayFromPatch(patch)
    let structureError =
        csgMerkleReplayReplaceStructureError(
            proof, replay)
    if structureError.len > 0:
        return csgMerkleReplayDeltaFail(
            proof, structureError)
    var out: CsgCoreMerkleReplayDelta
    out.ok = true
    out.replay = replay
    return out

@borrows
fn CsgCoreMerkleReplayDeleteBound(
        proof: CsgCoreMerkleProof,
        expectedFactsRoot: str,
        beforeFact: str): CsgCoreMerkleReplayDelta =
