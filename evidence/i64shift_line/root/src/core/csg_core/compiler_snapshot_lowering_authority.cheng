# Not the runtime event lock: that lock is also malloc. Issue/StoreRow
# hash CIDs with ByteBuf under this mutex.
@importc("cheng_native_csg_store_identity_registry_lock_bridge")
fn compilerSnapshotAuthorityEventLock()

@importc("cheng_native_csg_store_identity_registry_unlock_bridge")
fn compilerSnapshotAuthorityEventUnlock()

const
    compilerSnapshotAuthorityRegistrySlotCount: int32 = 1024
    compilerSnapshotAuthorityStateEmpty: int32 = 0
    compilerSnapshotAuthorityStateIssued: int32 = 1
    compilerSnapshotAuthorityStatePlanOwned: int32 = 2
    compilerSnapshotAuthorityStateReleased: int32 = 3
    compilerSnapshotAuthorityRegistryEmpty: int32 = 0
    compilerSnapshotAuthorityRegistryBuilding: int32 = 1
    compilerSnapshotAuthorityRegistryReady: int32 = 2
    compilerSnapshotAuthorityI32ColumnCount: int32 = 11
    compilerSnapshotAuthorityFixed32ColumnCount: int32 = 34
    compilerSnapshotAuthorityArenaPayloadBytes: int32 = 1159168
    compilerSnapshotAuthorityArenaAllocationCount: int32 = 45
    compilerSnapshotAuthorityPayloadDomain: str =
        "cheng.csg_core.compiler_snapshot_lowering_authority.payload"
    compilerSnapshotAuthorityIdentityDomain: str =
        "cheng.csg_core.compiler_snapshot_lowering_authority.identity"
    compilerSnapshotAuthorityReleaseDomain: str =
        "cheng.csg_core.compiler_snapshot_lowering_authority.release"
    compilerSnapshotAuthorityProofCargoDomain: str =
        "cheng.csg_core.compiler_snapshot_lowering_authority.proof_cargo.v1"

type
    CompilerSnapshotLoweringAuthorityHandle =
        ownerId: int32
        generation: int32
        leaseNonce: layout.FixedBytes32

    CompilerSnapshotLoweringAuthorityProductionBinding =
        currentHeadCid: layout.FixedBytes32
        manifestCid: layout.FixedBytes32
        csgcObjectCid: layout.FixedBytes32
        factsRootCid: layout.FixedBytes32
        proofCargoCid: layout.FixedBytes32
        transactionReceiptCid: layout.FixedBytes32
        cargoStoreIdentityCid: layout.FixedBytes32
        envelopeStoreIdentityCid: layout.FixedBytes32
        envelopeHeadCid: layout.FixedBytes32
        envelopeManifestCid: layout.FixedBytes32
        envelopeReceiptCid: layout.FixedBytes32
        envelopeMigrationReceiptCid: layout.FixedBytes32
        envelopeCsgcObjectCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        cargoSchemaCid: layout.FixedBytes32
        cargoProfileSetCid: layout.FixedBytes32
        cargoFactCount: int32
        cargoComplete: bool

    CompilerSnapshotLoweringAuthorityStoreBinding =
        cargoStoreIdentityCid: layout.FixedBytes32
        cargoStoreHeadCid: layout.FixedBytes32
        cargoStoreManifestCid: layout.FixedBytes32
        cargoStoreReceiptCid: layout.FixedBytes32
        cargoStoreCsgcObjectCid: layout.FixedBytes32
        envelopeStoreIdentityCid: layout.FixedBytes32
        envelopeHeadCid: layout.FixedBytes32
        envelopeManifestCid: layout.FixedBytes32
        envelopeReceiptCid: layout.FixedBytes32
        envelopeMigrationReceiptCid: layout.FixedBytes32
        envelopeCsgcObjectCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        cargoSchemaCid: layout.FixedBytes32
        cargoProfileSetCid: layout.FixedBytes32
        cargoFactCount: int32
        cargoComplete: bool

    compilerSnapshotLoweringAuthorityIdentityInput =
        sourceSnapshotCount: int32
        importEdgeCount: int32
        unresolvedImportCount: int32
        sourcePackageIdCid: layout.FixedBytes32
        entryModulePathCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        entrySourceCid: layout.FixedBytes32
        importGraphCid: layout.FixedBytes32
        sourceIdentityReceiptCid: layout.FixedBytes32
        parserReceiptCid: layout.FixedBytes32
        graphCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        compilerCsgTransitionReceiptCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerExecutionCid: layout.FixedBytes32
        compilerPackageCid: layout.FixedBytes32
        snapshotPredecessorReceiptCid: layout.FixedBytes32

    compilerSnapshotLoweringAuthoritySnapshotProjection =
        schemaVersion: int32
        semanticEpoch: int64
        factCount: int32
        factsRootCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        schemaCid: layout.FixedBytes32
        profileSetCid: layout.FixedBytes32
        predecessorReceiptCid: layout.FixedBytes32

    compilerSnapshotLoweringAuthorityProofCargoProjection =
        cargoStoreIdentityCid: layout.FixedBytes32
        csgcObjectCid: layout.FixedBytes32
        factsRootCid: layout.FixedBytes32
        headCid: layout.FixedBytes32
        manifestCid: layout.FixedBytes32
        transactionReceiptCid: layout.FixedBytes32
        schemaCid: layout.FixedBytes32
        profileSetCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        proofCargoCid: layout.FixedBytes32
        complete: bool
        factCount: int32
        envelopeStoreIdentityCid: layout.FixedBytes32
        envelopeHeadCid: layout.FixedBytes32
        envelopeManifestCid: layout.FixedBytes32
        envelopeReceiptCid: layout.FixedBytes32
        envelopeMigrationReceiptCid: layout.FixedBytes32
        envelopeCsgcObjectCid: layout.FixedBytes32

    # Private DOD registry. Every live fact is stored in one PhaseArenaStore;
    # refs are immutable column descriptors and never become public identity.
    compilerSnapshotLoweringAuthorityRegistry =
        store: phase.PhaseArenaStore
        arena: phase.PhaseArenaHandle
        states: phase.PhaseArenaRef
        generations: phase.PhaseArenaRef
        schemaVersions: phase.PhaseArenaRef
        semanticEpochHigh: phase.PhaseArenaRef
        semanticEpochLow: phase.PhaseArenaRef
        factCounts: phase.PhaseArenaRef
        completeFlags: phase.PhaseArenaRef
        sourceSnapshotCounts: phase.PhaseArenaRef
        importEdgeCounts: phase.PhaseArenaRef
        unresolvedImportCounts: phase.PhaseArenaRef
        functionProjectionBound: phase.PhaseArenaRef
        factsRootCids: phase.PhaseArenaRef
        headCids: phase.PhaseArenaRef
        manifestCids: phase.PhaseArenaRef
        receiptCids: phase.PhaseArenaRef
        schemaCids: phase.PhaseArenaRef
        profileSetCids: phase.PhaseArenaRef
        cargoCids: phase.PhaseArenaRef
        csgcObjectCids: phase.PhaseArenaRef
        proofCargoCids: phase.PhaseArenaRef
        cargoStoreIdentityCids: phase.PhaseArenaRef
        envelopeStoreIdentityCids: phase.PhaseArenaRef
        envelopeHeadCids: phase.PhaseArenaRef
        envelopeManifestCids: phase.PhaseArenaRef
        envelopeReceiptCids: phase.PhaseArenaRef
        envelopeMigrationReceiptCids: phase.PhaseArenaRef
        envelopeCsgcObjectCids: phase.PhaseArenaRef
        sourcePackageIdCids: phase.PhaseArenaRef
        entryModulePathCids: phase.PhaseArenaRef
        sourceBundleCids: phase.PhaseArenaRef
        entrySourceCids: phase.PhaseArenaRef
        importGraphCids: phase.PhaseArenaRef
        sourceIdentityReceiptCids: phase.PhaseArenaRef
        parserReceiptCids: phase.PhaseArenaRef
        graphCids: phase.PhaseArenaRef
        canonicalGraphCids: phase.PhaseArenaRef
        transitionReceiptCids: phase.PhaseArenaRef
        worldHeadCids: phase.PhaseArenaRef
        compilerExecutionCids: phase.PhaseArenaRef
        compilerPackageCids: phase.PhaseArenaRef
        snapshotPredecessorReceiptCids: phase.PhaseArenaRef
        payloadCids: phase.PhaseArenaRef
        identityCids: phase.PhaseArenaRef
        functionProjectionCids: phase.PhaseArenaRef
        leaseNonces: phase.PhaseArenaRef

var
    compilerSnapshotAuthorityRegistryState: int32
    compilerSnapshotAuthorityRegistry:
        compilerSnapshotLoweringAuthorityRegistry

fn compilerSnapshotAuthorityLock() =
    compilerSnapshotAuthorityEventLock()

fn compilerSnapshotAuthorityUnlock() =
    compilerSnapshotAuthorityEventUnlock()

fn compilerSnapshotAuthorityRefMatchesArena(
        value: phase.PhaseArenaRef,
        arena: phase.PhaseArenaHandle): bool =
    return phase.PhaseArenaRefIsValid(value) &&
        value.arenaId == arena.arenaId &&
        value.generation == arena.generation

fn compilerSnapshotAuthorityRegistryShapeValid(): bool =
    let arena = compilerSnapshotAuthorityRegistry.arena
    return compilerSnapshotAuthorityRegistryState ==
               compilerSnapshotAuthorityRegistryReady &&
        phase.PhaseArenaHandleIsValid(arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.states, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.generations, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.schemaVersions, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.semanticEpochHigh, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.semanticEpochLow, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.factCounts, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.completeFlags, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.sourceSnapshotCounts, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.importEdgeCounts, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.unresolvedImportCounts, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.functionProjectionBound,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.factsRootCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.headCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.manifestCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.receiptCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.schemaCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.profileSetCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.cargoCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.csgcObjectCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.proofCargoCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.cargoStoreIdentityCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.envelopeStoreIdentityCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.envelopeHeadCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.envelopeManifestCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.envelopeReceiptCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.envelopeMigrationReceiptCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.envelopeCsgcObjectCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.sourcePackageIdCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.entryModulePathCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.sourceBundleCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.entrySourceCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.importGraphCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.sourceIdentityReceiptCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.parserReceiptCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.graphCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.canonicalGraphCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.transitionReceiptCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.worldHeadCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.compilerExecutionCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.compilerPackageCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.snapshotPredecessorReceiptCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.payloadCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.identityCids, arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.functionProjectionCids,
            arena) &&
        compilerSnapshotAuthorityRefMatchesArena(
            compilerSnapshotAuthorityRegistry.leaseNonces, arena)

fn compilerSnapshotAuthorityRegistryBuildInto(
        out: var compilerSnapshotLoweringAuthorityRegistry) =
    if phase.PhaseArenaHandleIsValid(out.arena):
        panic("compiler snapshot lowering authority: registry output owned")
    phase.PhaseArenaStoreInit(
        out.store,
        1,
        compilerSnapshotAuthorityArenaPayloadBytes,
        compilerSnapshotAuthorityArenaAllocationCount)
    out.arena = phase.PhaseArenaStoreOpenArena(
        out.store,
        1,
        compilerSnapshotAuthorityArenaPayloadBytes,
        compilerSnapshotAuthorityArenaAllocationCount)
    out.states = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.generations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.schemaVersions = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.semanticEpochHigh = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.semanticEpochLow = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.factCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.completeFlags = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.sourceSnapshotCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.importEdgeCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.unresolvedImportCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.functionProjectionBound = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, compilerSnapshotAuthorityRegistrySlotCount)
    out.factsRootCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.headCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.manifestCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.receiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.schemaCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.profileSetCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.cargoCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.csgcObjectCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.proofCargoCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.cargoStoreIdentityCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.envelopeStoreIdentityCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.envelopeHeadCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.envelopeManifestCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.envelopeReceiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.envelopeMigrationReceiptCids =
        phase.PhaseArenaStoreAllocRefAligned(
            out.store, out.arena,
            compilerSnapshotAuthorityRegistrySlotCount *
                layout.FixedBytes32Size,
            8)
    out.envelopeCsgcObjectCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.sourcePackageIdCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.entryModulePathCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.sourceBundleCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.entrySourceCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.importGraphCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.sourceIdentityReceiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.parserReceiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.graphCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.canonicalGraphCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.transitionReceiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.worldHeadCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.compilerExecutionCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.compilerPackageCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.snapshotPredecessorReceiptCids =
        phase.PhaseArenaStoreAllocRefAligned(
            out.store, out.arena,
            compilerSnapshotAuthorityRegistrySlotCount *
                layout.FixedBytes32Size,
            8)
    out.payloadCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.identityCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.functionProjectionCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    out.leaseNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        compilerSnapshotAuthorityRegistrySlotCount * layout.FixedBytes32Size,
        8)
    let report = phase.PhaseArenaStoreArenaReport(out.store, out.arena)
    if report.usedBytes != compilerSnapshotAuthorityArenaPayloadBytes ||
       report.allocationCount !=
           compilerSnapshotAuthorityArenaAllocationCount ||
       report.spillCount != 0:
        panic("compiler snapshot lowering authority: arena layout drift")

fn compilerSnapshotAuthorityEnsureRegistry() =
    compilerSnapshotAuthorityLock()
    let observedState = compilerSnapshotAuthorityRegistryState
    if observedState == compilerSnapshotAuthorityRegistryReady:
        compilerSnapshotAuthorityUnlock()
        return
    if observedState != compilerSnapshotAuthorityRegistryEmpty:
        compilerSnapshotAuthorityUnlock()
        panic("compiler snapshot lowering authority: concurrent registry initialization")
    compilerSnapshotAuthorityRegistryState =
        compilerSnapshotAuthorityRegistryBuilding
    compilerSnapshotAuthorityUnlock()
    # Event lock is also malloc's lock. Arena init must not run while held.
    var candidate: compilerSnapshotLoweringAuthorityRegistry
    compilerSnapshotAuthorityRegistryBuildInto(candidate)
    compilerSnapshotAuthorityLock()
    if compilerSnapshotAuthorityRegistryState !=
           compilerSnapshotAuthorityRegistryBuilding:
        compilerSnapshotAuthorityUnlock()
        panic("compiler snapshot lowering authority: registry publication drift")
    compilerSnapshotAuthorityRegistry = candidate
    compilerSnapshotAuthorityRegistryState =
        compilerSnapshotAuthorityRegistryReady
    if !compilerSnapshotAuthorityRegistryShapeValid():
        compilerSnapshotAuthorityUnlock()
        panic("compiler snapshot lowering authority: registry publication invalid")
    compilerSnapshotAuthorityUnlock()
    candidate = compilerSnapshotLoweringAuthorityRegistry()

fn compilerSnapshotAuthorityI32At(
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        compilerSnapshotAuthorityRegistry.store,
        compilerSnapshotAuthorityRegistry.arena,
        column,
        row)

fn compilerSnapshotAuthoritySetI32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        compilerSnapshotAuthorityRegistry.store,
        compilerSnapshotAuthorityRegistry.arena,
        column,
        row,
        value)

fn compilerSnapshotAuthorityI64At(
        highColumn: phase.PhaseArenaRef,
        lowColumn: phase.PhaseArenaRef,
        row: int32): int64 =
    let high = compilerSnapshotAuthorityI32At(highColumn, row)
    let low = compilerSnapshotAuthorityI32At(lowColumn, row)
    return (int64(high) << 32) | (int64(low) & int64(4294967295))

fn compilerSnapshotAuthoritySetI64(
        highColumn: phase.PhaseArenaRef,
        lowColumn: phase.PhaseArenaRef,
        row: int32,
        value: int64) =
    compilerSnapshotAuthoritySetI32(highColumn, row, Int32(value >> 32))
    compilerSnapshotAuthoritySetI32(lowColumn, row, Int32(value))

@borrows
fn compilerSnapshotAuthorityFixed32At(
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    let base = row * layout.FixedBytes32Size
    for byteIndex in 0..<layout.FixedBytes32Size:
        out.data[byteIndex] = uint8(phase.PhaseArenaStoreGetByte(
            compilerSnapshotAuthorityRegistry.store,
            compilerSnapshotAuthorityRegistry.arena,
            column,
            base + byteIndex))
    return out

fn compilerSnapshotAuthoritySetFixed32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    let base = row * layout.FixedBytes32Size
    for byteIndex in 0..<layout.FixedBytes32Size:
        phase.PhaseArenaStoreSetByte(
            compilerSnapshotAuthorityRegistry.store,
            compilerSnapshotAuthorityRegistry.arena,
            column,
            base + byteIndex,
            int32(value.data[byteIndex]))

fn compilerSnapshotAuthorityAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, (value >> 24) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, value & 255)

fn compilerSnapshotAuthorityAppendI64(
        out: var layout.ByteBuf,
        value: int64) =
    compilerSnapshotAuthorityAppendU32(out, Int32(value >> 32))
    compilerSnapshotAuthorityAppendU32(out, Int32(value))

fn compilerSnapshotAuthorityAppendBool(
        out: var layout.ByteBuf,
        value: bool) =
    compilerSnapshotAuthorityAppendU32(out, value ? 1 : 0)

@borrows
fn compilerSnapshotAuthorityAppendText(
        out: var layout.ByteBuf,
        value: str) =
    compilerSnapshotAuthorityAppendU32(out, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(out, Int32(value[index]) & 255)

@borrows
fn compilerSnapshotAuthorityAppendFixed32Field(
        out: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    compilerSnapshotAuthorityAppendU32(out, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(out, value)

@borrows
fn compilerSnapshotAuthorityCidObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn compilerSnapshotAuthorityStoreBindingObserved(
        value: CompilerSnapshotLoweringAuthorityStoreBinding): bool =
    return compilerSnapshotAuthorityCidObserved(
               value.cargoStoreIdentityCid) &&
        compilerSnapshotAuthorityCidObserved(value.cargoStoreHeadCid) &&
        compilerSnapshotAuthorityCidObserved(value.cargoStoreManifestCid) &&
        compilerSnapshotAuthorityCidObserved(value.cargoStoreReceiptCid) &&
        compilerSnapshotAuthorityCidObserved(value.cargoStoreCsgcObjectCid) &&
        compilerSnapshotAuthorityCidObserved(
            value.envelopeStoreIdentityCid) &&
        compilerSnapshotAuthorityCidObserved(value.envelopeHeadCid) &&
        compilerSnapshotAuthorityCidObserved(value.envelopeManifestCid) &&
        compilerSnapshotAuthorityCidObserved(value.envelopeReceiptCid) &&
        compilerSnapshotAuthorityCidObserved(
            value.envelopeMigrationReceiptCid) &&
        compilerSnapshotAuthorityCidObserved(value.envelopeCsgcObjectCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreIdentityCid,
            value.envelopeStoreIdentityCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreHeadCid, value.envelopeHeadCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreManifestCid, value.envelopeManifestCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreReceiptCid, value.envelopeReceiptCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreCsgcObjectCid,
            value.envelopeCsgcObjectCid)

@borrows
fn compilerSnapshotAuthorityStoreBindingEqual(
        left: CompilerSnapshotLoweringAuthorityStoreBinding,
        right: CompilerSnapshotLoweringAuthorityStoreBinding): bool =
    return layout.FixedBytes32Equal(
               left.cargoStoreIdentityCid,
               right.cargoStoreIdentityCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreHeadCid, right.cargoStoreHeadCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreManifestCid, right.cargoStoreManifestCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreReceiptCid, right.cargoStoreReceiptCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreCsgcObjectCid,
            right.cargoStoreCsgcObjectCid) &&
        layout.FixedBytes32Equal(
            left.envelopeStoreIdentityCid,
            right.envelopeStoreIdentityCid) &&
        layout.FixedBytes32Equal(
            left.envelopeHeadCid, right.envelopeHeadCid) &&
        layout.FixedBytes32Equal(
            left.envelopeManifestCid, right.envelopeManifestCid) &&
        layout.FixedBytes32Equal(
            left.envelopeReceiptCid, right.envelopeReceiptCid) &&
        layout.FixedBytes32Equal(
            left.envelopeMigrationReceiptCid,
            right.envelopeMigrationReceiptCid) &&
        layout.FixedBytes32Equal(
            left.envelopeCsgcObjectCid,
            right.envelopeCsgcObjectCid)

fn compilerSnapshotAuthoritySystemLeaseNonceInto(
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    var entropy = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    if rawbytes.BytesLen(entropy) != layout.FixedBytes32Size:
        rawbytes.BytesFree(entropy)
        panic("compiler snapshot lowering authority: lease entropy allocation failed")
    if !rand.RandomFill(entropy):
        for byteIndex in 0..<rawbytes.BytesLen(entropy):
            rawbytes.BytesSet(entropy, byteIndex, 0)
        rawbytes.BytesFree(entropy)
        err =
            " compiler snapshot lowering authority: system entropy unavailable"
        return false
    for byteIndex in 0..<layout.FixedBytes32Size:
        out.data[byteIndex] = uint8(rawbytes.BytesGet(entropy, byteIndex))
        rawbytes.BytesSet(entropy, byteIndex, 0)
    rawbytes.BytesFree(entropy)
    if !compilerSnapshotAuthorityCidObserved(out):
        out = layout.FixedBytes32()
        err =
            " compiler snapshot lowering authority: zero system entropy nonce"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotAuthoritySourceIdentityReceiptCid(
        identity: compilerSnapshotLoweringAuthorityIdentityInput):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(384)
    compilerSnapshotAuthorityAppendText(
        bytes, "cheng.compiler.portable_source_identity_receipt")
    compilerSnapshotAuthorityAppendU32(bytes, 4)
    compilerSnapshotAuthorityAppendU32(
        bytes, identity.sourceSnapshotCount)
    compilerSnapshotAuthorityAppendU32(bytes, 4)
    compilerSnapshotAuthorityAppendU32(bytes, identity.importEdgeCount)
    compilerSnapshotAuthorityAppendU32(bytes, 4)
    compilerSnapshotAuthorityAppendU32(
        bytes, identity.unresolvedImportCount)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourcePackageIdCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.entryModulePathCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourceBundleCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.entrySourceCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.importGraphCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn compilerSnapshotAuthorityTransitionReceiptCid(
        identity: compilerSnapshotLoweringAuthorityIdentityInput):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(256)
    compilerSnapshotAuthorityAppendText(
        bytes, "cheng.compiler.csg_transition_receipt")
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourceIdentityReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.parserReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, identity.graphCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.canonicalGraphCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn compilerSnapshotAuthorityPredecessorReceiptCid(
        identity: compilerSnapshotLoweringAuthorityIdentityInput):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(384)
    compilerSnapshotAuthorityAppendText(
        bytes, "cheng.semantic_snapshot.compiler_predecessor")
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourceIdentityReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.compilerCsgTransitionReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, identity.graphCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.canonicalGraphCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.worldHeadCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.compilerExecutionCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.compilerPackageCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourceBundleCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn compilerSnapshotAuthorityIdentityInputShapeValid(
        identity: compilerSnapshotLoweringAuthorityIdentityInput): bool =
    if identity.sourceSnapshotCount <= 0 ||
       identity.importEdgeCount < 0 ||
       identity.unresolvedImportCount != 0:
        return false
    if !compilerSnapshotAuthorityCidObserved(identity.sourcePackageIdCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.entryModulePathCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.sourceBundleCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.entrySourceCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.importGraphCid) ||
       !compilerSnapshotAuthorityCidObserved(
           identity.sourceIdentityReceiptCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.parserReceiptCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.graphCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.canonicalGraphCid) ||
       !compilerSnapshotAuthorityCidObserved(
           identity.compilerCsgTransitionReceiptCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.worldHeadCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.compilerExecutionCid) ||
       !compilerSnapshotAuthorityCidObserved(identity.compilerPackageCid) ||
       !compilerSnapshotAuthorityCidObserved(
           identity.snapshotPredecessorReceiptCid):
        return false
    return true

@borrows
fn compilerSnapshotAuthorityIdentityInputValid(
        identity: compilerSnapshotLoweringAuthorityIdentityInput): bool =
    return compilerSnapshotAuthorityIdentityInputShapeValid(identity) &&
        layout.FixedBytes32Equal(
               identity.sourceIdentityReceiptCid,
               compilerSnapshotAuthoritySourceIdentityReceiptCid(identity)) &&
        layout.FixedBytes32Equal(
            identity.compilerCsgTransitionReceiptCid,
            compilerSnapshotAuthorityTransitionReceiptCid(identity)) &&
        layout.FixedBytes32Equal(
            identity.snapshotPredecessorReceiptCid,
            compilerSnapshotAuthorityPredecessorReceiptCid(identity))

@borrows
fn compilerSnapshotAuthorityProofCargoCidFromValues(
        cargoStoreIdentityCid: layout.FixedBytes32,
        csgcObjectCid: layout.FixedBytes32,
        factsRootCid: layout.FixedBytes32,
        headCid: layout.FixedBytes32,
        manifestCid: layout.FixedBytes32,
        transactionReceiptCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        profileSetCid: layout.FixedBytes32,
        cargoCid: layout.FixedBytes32,
        complete: bool,
        factCount: int32): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(512)
    compilerSnapshotAuthorityAppendText(
        bytes, compilerSnapshotAuthorityProofCargoDomain)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, cargoStoreIdentityCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, csgcObjectCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, factsRootCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, headCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, manifestCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, transactionReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, schemaCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, profileSetCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, cargoCid)
    compilerSnapshotAuthorityAppendBool(bytes, complete)
    compilerSnapshotAuthorityAppendU32(bytes, factCount)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn compilerSnapshotAuthorityPayloadCidFromValues(
        schemaVersion: int32,
        semanticEpoch: int64,
        factCount: int32,
        complete: bool,
        factsRootCid: layout.FixedBytes32,
        headCid: layout.FixedBytes32,
        manifestCid: layout.FixedBytes32,
        receiptCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        profileSetCid: layout.FixedBytes32,
        cargoCid: layout.FixedBytes32,
        csgcObjectCid: layout.FixedBytes32,
        proofCargoCid: layout.FixedBytes32,
        storage: CompilerSnapshotLoweringAuthorityStoreBinding,
        identity: compilerSnapshotLoweringAuthorityIdentityInput):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(1408)
    compilerSnapshotAuthorityAppendText(
        bytes, compilerSnapshotAuthorityPayloadDomain)
    compilerSnapshotAuthorityAppendU32(bytes, schemaVersion)
    compilerSnapshotAuthorityAppendI64(bytes, semanticEpoch)
    compilerSnapshotAuthorityAppendU32(bytes, factCount)
    compilerSnapshotAuthorityAppendBool(bytes, complete)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, factsRootCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, headCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, manifestCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, receiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, schemaCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, profileSetCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, cargoCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, csgcObjectCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, proofCargoCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.cargoStoreIdentityCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.cargoStoreHeadCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.cargoStoreManifestCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.cargoStoreReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.cargoStoreCsgcObjectCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.envelopeStoreIdentityCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.envelopeHeadCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.envelopeManifestCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.envelopeReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.envelopeMigrationReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, storage.envelopeCsgcObjectCid)
    compilerSnapshotAuthorityAppendU32(
        bytes, identity.sourceSnapshotCount)
    compilerSnapshotAuthorityAppendU32(bytes, identity.importEdgeCount)
    compilerSnapshotAuthorityAppendU32(
        bytes, identity.unresolvedImportCount)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourcePackageIdCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.entryModulePathCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourceBundleCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.entrySourceCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.importGraphCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.sourceIdentityReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.parserReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, identity.graphCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.canonicalGraphCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.compilerCsgTransitionReceiptCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.worldHeadCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.compilerExecutionCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.compilerPackageCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, identity.snapshotPredecessorReceiptCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn compilerSnapshotAuthorityIdentityCidFromValues(
        ownerId: int32,
        generation: int32,
        payloadCid: layout.FixedBytes32): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(160)
    compilerSnapshotAuthorityAppendText(
        bytes, compilerSnapshotAuthorityIdentityDomain)
    compilerSnapshotAuthorityAppendU32(bytes, ownerId)
    compilerSnapshotAuthorityAppendU32(bytes, generation)
    compilerSnapshotAuthorityAppendFixed32Field(bytes, payloadCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn compilerSnapshotAuthorityHexNibble(value: char): int32 =
    if value >= '0' && value <= '9':
        return Int32(value) - Int32('0')
    if value >= 'a' && value <= 'f':
        return Int32(value) - Int32('a') + 10
    return -1

@borrows
fn compilerSnapshotAuthorityCidTextInto(
        text: str,
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    if !merkle_codec.CsgCoreMerkleStoreCidValid(text):
        return false
    for byteIndex in 0..<layout.FixedBytes32Size:
        let high = compilerSnapshotAuthorityHexNibble(
            text[7 + byteIndex * 2])
        let low = compilerSnapshotAuthorityHexNibble(
            text[7 + byteIndex * 2 + 1])
        if high < 0 || low < 0:
            out = layout.FixedBytes32()
            return false
        out.data[byteIndex] = uint8((high << 4) | low)
    return text == "sha256:" + layout.FixedBytes32Hex(out)

fn compilerSnapshotAuthorityIdentityAt(
        slot: int32): compilerSnapshotLoweringAuthorityIdentityInput =
    var out: compilerSnapshotLoweringAuthorityIdentityInput
    out.sourceSnapshotCount =
        compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.sourceSnapshotCounts, slot)
    out.importEdgeCount = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.importEdgeCounts, slot)
    out.unresolvedImportCount =
        compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.unresolvedImportCounts, slot)
    out.sourcePackageIdCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.sourcePackageIdCids, slot)
    out.entryModulePathCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.entryModulePathCids, slot)
    out.sourceBundleCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.sourceBundleCids, slot)
    out.entrySourceCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.entrySourceCids, slot)
    out.importGraphCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.importGraphCids, slot)
    out.sourceIdentityReceiptCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.sourceIdentityReceiptCids,
            slot)
    out.parserReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.parserReceiptCids, slot)
    out.graphCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.graphCids, slot)
    out.canonicalGraphCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.canonicalGraphCids, slot)
    out.compilerCsgTransitionReceiptCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.transitionReceiptCids, slot)
    out.worldHeadCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.worldHeadCids, slot)
    out.compilerExecutionCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.compilerExecutionCids, slot)
    out.compilerPackageCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.compilerPackageCids, slot)
    out.snapshotPredecessorReceiptCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.snapshotPredecessorReceiptCids,
            slot)
    return out

fn compilerSnapshotAuthorityStoreBindingAt(
        slot: int32): CompilerSnapshotLoweringAuthorityStoreBinding =
    var out: CompilerSnapshotLoweringAuthorityStoreBinding
    out.cargoStoreIdentityCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.cargoStoreIdentityCids, slot)
    out.cargoStoreHeadCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.headCids, slot)
    out.cargoStoreManifestCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.manifestCids, slot)
    out.cargoStoreReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.receiptCids, slot)
    out.cargoStoreCsgcObjectCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.csgcObjectCids, slot)
    out.envelopeStoreIdentityCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeStoreIdentityCids, slot)
    out.envelopeHeadCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeHeadCids, slot)
    out.envelopeManifestCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeManifestCids, slot)
    out.envelopeReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeReceiptCids, slot)
    out.envelopeMigrationReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeMigrationReceiptCids,
        slot)
    out.envelopeCsgcObjectCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeCsgcObjectCids, slot)
    out.cargoCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.cargoCids, slot)
    out.cargoSchemaCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.schemaCids, slot)
    out.cargoProfileSetCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.profileSetCids, slot)
    out.cargoFactCount = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.factCounts, slot)
    out.cargoComplete = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.completeFlags, slot) == 1
    return out

fn compilerSnapshotAuthorityRowValid(
        slot: int32,
        requiredState: int32): bool =
    if slot < 0 || slot >= compilerSnapshotAuthorityRegistrySlotCount ||
       compilerSnapshotAuthorityI32At(
           compilerSnapshotAuthorityRegistry.states, slot) != requiredState ||
       compilerSnapshotAuthorityI32At(
           compilerSnapshotAuthorityRegistry.generations, slot) <= 0 ||
       compilerSnapshotAuthorityI32At(
           compilerSnapshotAuthorityRegistry.schemaVersions, slot) !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       compilerSnapshotAuthorityI64At(
           compilerSnapshotAuthorityRegistry.semanticEpochHigh,
           compilerSnapshotAuthorityRegistry.semanticEpochLow,
           slot) <= int64(0) ||
       compilerSnapshotAuthorityI32At(
           compilerSnapshotAuthorityRegistry.factCounts, slot) <= 0:
        return false
    if compilerSnapshotAuthorityI32At(
           compilerSnapshotAuthorityRegistry.completeFlags, slot) != 1:
        return false
    let identity = compilerSnapshotAuthorityIdentityAt(slot)
    let storage = compilerSnapshotAuthorityStoreBindingAt(slot)
    if !compilerSnapshotAuthorityIdentityInputShapeValid(identity) ||
       !compilerSnapshotAuthorityStoreBindingObserved(storage):
        return false
    let projectionBound = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.functionProjectionBound, slot)
    let projectionObserved = compilerSnapshotAuthorityCidObserved(
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.functionProjectionCids, slot))
    return ((projectionBound == 0 && !projectionObserved) ||
            (projectionBound == 1 && projectionObserved)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.leaseNonces, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.factsRootCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.headCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.manifestCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.receiptCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.schemaCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.profileSetCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.cargoCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.csgcObjectCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.proofCargoCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.payloadCids, slot)) &&
        compilerSnapshotAuthorityCidObserved(
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.identityCids, slot))

@borrows
fn compilerSnapshotAuthorityHandleSlot(
        handle: CompilerSnapshotLoweringAuthorityHandle): int32 =
    if handle.ownerId <= 0 ||
       handle.ownerId > compilerSnapshotAuthorityRegistrySlotCount ||
       handle.generation <= 0:
        return -1
    return handle.ownerId - 1

@borrows
fn compilerSnapshotAuthorityHandleRowValid(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        requiredState: int32): bool =
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    return slot >= 0 &&
        compilerSnapshotAuthorityCidObserved(handle.leaseNonce) &&
        compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.generations, slot) ==
                handle.generation &&
        layout.FixedBytes32Equal(
            handle.leaseNonce,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.leaseNonces, slot)) &&
        compilerSnapshotAuthorityRowValid(slot, requiredState)

fn compilerSnapshotAuthorityStoreRow(
        slot: int32,
        generation: int32,
        schemaVersion: int32,
        semanticEpoch: int64,
        factCount: int32,
        complete: bool,
        factsRootCid: layout.FixedBytes32,
        headCid: layout.FixedBytes32,
        manifestCid: layout.FixedBytes32,
        receiptCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        profileSetCid: layout.FixedBytes32,
        cargoCid: layout.FixedBytes32,
        csgcObjectCid: layout.FixedBytes32,
        proofCargoCid: layout.FixedBytes32,
        storage: CompilerSnapshotLoweringAuthorityStoreBinding,
        identity: compilerSnapshotLoweringAuthorityIdentityInput,
        payloadCid: layout.FixedBytes32,
        leaseNonce: layout.FixedBytes32) =
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.generations, slot, generation)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.schemaVersions,
        slot,
        schemaVersion)
    compilerSnapshotAuthoritySetI64(
        compilerSnapshotAuthorityRegistry.semanticEpochHigh,
        compilerSnapshotAuthorityRegistry.semanticEpochLow,
        slot,
        semanticEpoch)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.factCounts, slot, factCount)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.completeFlags,
        slot,
        complete ? 1 : 0)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.sourceSnapshotCounts,
        slot,
        identity.sourceSnapshotCount)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.importEdgeCounts,
        slot,
        identity.importEdgeCount)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.unresolvedImportCounts,
        slot,
        identity.unresolvedImportCount)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.functionProjectionBound,
        slot,
        0)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.factsRootCids, slot, factsRootCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.headCids, slot, headCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.manifestCids, slot, manifestCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.receiptCids, slot, receiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.schemaCids, slot, schemaCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.profileSetCids, slot, profileSetCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.cargoCids, slot, cargoCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.csgcObjectCids,
        slot,
        csgcObjectCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.proofCargoCids,
        slot,
        proofCargoCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.cargoStoreIdentityCids,
        slot,
        storage.cargoStoreIdentityCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.envelopeStoreIdentityCids,
        slot,
        storage.envelopeStoreIdentityCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.envelopeHeadCids,
        slot,
        storage.envelopeHeadCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.envelopeManifestCids,
        slot,
        storage.envelopeManifestCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.envelopeReceiptCids,
        slot,
        storage.envelopeReceiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.envelopeMigrationReceiptCids,
        slot,
        storage.envelopeMigrationReceiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.envelopeCsgcObjectCids,
        slot,
        storage.envelopeCsgcObjectCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.sourcePackageIdCids,
        slot,
        identity.sourcePackageIdCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.entryModulePathCids,
        slot,
        identity.entryModulePathCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.sourceBundleCids,
        slot,
        identity.sourceBundleCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.entrySourceCids,
        slot,
        identity.entrySourceCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.importGraphCids,
        slot,
        identity.importGraphCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.sourceIdentityReceiptCids,
        slot,
        identity.sourceIdentityReceiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.parserReceiptCids,
        slot,
        identity.parserReceiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.graphCids, slot, identity.graphCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.canonicalGraphCids,
        slot,
        identity.canonicalGraphCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.transitionReceiptCids,
        slot,
        identity.compilerCsgTransitionReceiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.worldHeadCids,
        slot,
        identity.worldHeadCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.compilerExecutionCids,
        slot,
        identity.compilerExecutionCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.compilerPackageCids,
        slot,
        identity.compilerPackageCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.snapshotPredecessorReceiptCids,
        slot,
        identity.snapshotPredecessorReceiptCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.payloadCids, slot, payloadCid)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.identityCids,
        slot,
        compilerSnapshotAuthorityIdentityCidFromValues(
            slot + 1, generation, payloadCid))
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.functionProjectionCids,
        slot,
        layout.FixedBytes32())
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.leaseNonces,
        slot,
        leaseNonce)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.states,
        slot,
        compilerSnapshotAuthorityStateIssued)

fn compilerSnapshotAuthorityIssuePreparedInto(
        schemaVersion: int32,
        semanticEpoch: int64,
        factCount: int32,
        complete: bool,
        factsRootCid: layout.FixedBytes32,
        headCid: layout.FixedBytes32,
        manifestCid: layout.FixedBytes32,
        receiptCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        profileSetCid: layout.FixedBytes32,
        cargoCid: layout.FixedBytes32,
        csgcObjectCid: layout.FixedBytes32,
        proofCargoCid: layout.FixedBytes32,
        storage: CompilerSnapshotLoweringAuthorityStoreBinding,
        identity: compilerSnapshotLoweringAuthorityIdentityInput,
        out: var CompilerSnapshotLoweringAuthorityHandle,
        err: var str): bool =
    out = CompilerSnapshotLoweringAuthorityHandle()
    let payloadCid = compilerSnapshotAuthorityPayloadCidFromValues(
        schemaVersion, semanticEpoch, factCount, complete, factsRootCid, headCid,
        manifestCid, receiptCid, schemaCid, profileSetCid, cargoCid,
        csgcObjectCid, proofCargoCid, storage, identity)
    if schemaVersion != snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       semanticEpoch <= int64(0) || factCount <= 0 || !complete ||
       !compilerSnapshotAuthorityCidObserved(factsRootCid) ||
       !compilerSnapshotAuthorityCidObserved(headCid) ||
       !compilerSnapshotAuthorityCidObserved(manifestCid) ||
       !compilerSnapshotAuthorityCidObserved(receiptCid) ||
       !compilerSnapshotAuthorityCidObserved(schemaCid) ||
       !compilerSnapshotAuthorityCidObserved(profileSetCid) ||
       !compilerSnapshotAuthorityCidObserved(cargoCid) ||
       !compilerSnapshotAuthorityCidObserved(csgcObjectCid) ||
       !compilerSnapshotAuthorityCidObserved(proofCargoCid) ||
       !compilerSnapshotAuthorityStoreBindingObserved(storage) ||
       !layout.FixedBytes32Equal(
           headCid, storage.cargoStoreHeadCid) ||
       !layout.FixedBytes32Equal(
           manifestCid, storage.cargoStoreManifestCid) ||
       !layout.FixedBytes32Equal(
           receiptCid, storage.cargoStoreReceiptCid) ||
       !layout.FixedBytes32Equal(
           csgcObjectCid, storage.cargoStoreCsgcObjectCid) ||
       !layout.FixedBytes32Equal(
           proofCargoCid,
           compilerSnapshotAuthorityProofCargoCidFromValues(
               storage.cargoStoreIdentityCid,
               csgcObjectCid, factsRootCid, headCid, manifestCid,
               receiptCid, schemaCid, profileSetCid, cargoCid,
               complete, factCount)) ||
       !compilerSnapshotAuthorityIdentityInputValid(identity) ||
       !compilerSnapshotAuthorityCidObserved(payloadCid):
        err = " compiler snapshot lowering authority: prepared identity invalid"
        return false
    var issuedLeaseNonce: layout.FixedBytes32
    if !compilerSnapshotAuthoritySystemLeaseNonceInto(
           issuedLeaseNonce, err):
        return false
    compilerSnapshotAuthorityEnsureRegistry()
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid():
        compilerSnapshotAuthorityUnlock()
        panic("compiler snapshot lowering authority: registry shape drift")
    for slot in 0..<compilerSnapshotAuthorityRegistrySlotCount:
        let state = compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.states, slot)
        if (state == compilerSnapshotAuthorityStateIssued ||
            state == compilerSnapshotAuthorityStatePlanOwned) &&
           layout.FixedBytes32Equal(
               compilerSnapshotAuthorityFixed32At(
                   compilerSnapshotAuthorityRegistry.payloadCids, slot),
               payloadCid):
            compilerSnapshotAuthorityUnlock()
            err =
                " compiler snapshot lowering authority: duplicate live issue"
            return false
    var selectedSlot: int32 = -1
    for slot in 0..<compilerSnapshotAuthorityRegistrySlotCount:
        let state = compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.states, slot)
        if state == compilerSnapshotAuthorityStateEmpty ||
           state == compilerSnapshotAuthorityStateReleased:
            selectedSlot = slot
            break
    if selectedSlot < 0:
        compilerSnapshotAuthorityUnlock()
        err = " compiler snapshot lowering authority: registry exhausted"
        return false
    let previousGeneration =
        compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.generations, selectedSlot)
    if previousGeneration == 2147483647:
        compilerSnapshotAuthorityUnlock()
        err = " compiler snapshot lowering authority: generation exhausted"
        return false
    let generation = previousGeneration + 1
    compilerSnapshotAuthorityStoreRow(
        selectedSlot, generation, schemaVersion, semanticEpoch, factCount,
        complete,
        factsRootCid, headCid, manifestCid, receiptCid, schemaCid,
        profileSetCid, cargoCid, csgcObjectCid, proofCargoCid, storage,
        identity, payloadCid, issuedLeaseNonce)
    out.ownerId = selectedSlot + 1
    out.generation = generation
    out.leaseNonce = issuedLeaseNonce
    if !compilerSnapshotAuthorityHandleRowValid(
           out, compilerSnapshotAuthorityStateIssued):
        compilerSnapshotAuthorityUnlock()
        panic("compiler snapshot lowering authority: issue commit drift")
    compilerSnapshotAuthorityUnlock()
    err = ""
    return true

@borrows
fn compilerSnapshotAuthorityImmutableCargoRejectTag(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        storage: CompilerSnapshotLoweringAuthorityStoreBinding,
        current: merkle_store.CsgCoreMerkleHeadReadResult,
        verified: snapshot_cargo.CsgCompilerSnapshotVerifiedCargo,
        canonicalCsgcObjectCidText: str,
        cargoStoreIdentityCidText: str): str =
    if !verified.ok:
        return "verified.ok"
    if verified.error.len != 0:
        return "verified.error"
    if !layout.FixedBytes32Equal(verified.cargoCid, cargo.cargoCid):
        return "verified.cargoCid"
    if !layout.FixedBytes32Equal(verified.factsRootCid, cargo.factsRootCid):
        return "verified.factsRootCid"
    if verified.standard != cargo.standard:
        return "verified.standard"
    if !validator.CsgCoreProfilesEqual(verified.profiles, cargo.profiles):
        return "verified.profiles"
    if verified.profileSetCid != cargo.profileSetCid:
        return "verified.profileSetCid"
    if verified.schemaNamespace != cargo.schemaNamespace:
        return "verified.schemaNamespace"
    if verified.schemaCid != cargo.schemaCid:
        return "verified.schemaCid"
    if verified.factsRoot != cargo.factsRoot:
        return "verified.factsRoot"
    if verified.factsSubgraphCid != cargo.factsSubgraphCid:
        return "verified.factsSubgraphCid"
    if verified.dagRootCid != cargo.dagRootCid:
        return "verified.dagRootCid"
    if verified.factCount != cargo.factCount:
        return "verified.factCount"
    if verified.canonicalLines.len != cargo.canonicalLines.len:
        return "verified.canonicalLines.len"
    if !current.ok:
        return "current.ok"
    if !current.present:
        return "current.present"
    if current.error.len != 0:
        return "current.error"
    if !merkle_codec.CsgCoreMerkleStoreCidValid(current.storeIdentityCid):
        return "current.storeIdentityCid"
    if current.head.headCid !=
       "sha256:" + layout.FixedBytes32Hex(storage.cargoStoreHeadCid):
        return "current.head.headCid"
    if current.head.manifestCid !=
       "sha256:" + layout.FixedBytes32Hex(storage.cargoStoreManifestCid):
        return "current.head.manifestCid"
    if current.head.receiptCid !=
       "sha256:" + layout.FixedBytes32Hex(storage.cargoStoreReceiptCid):
        return "current.head.receiptCid"
    if current.manifest.csgcObjectCid != canonicalCsgcObjectCidText:
        return "current.manifest.csgcObjectCid"
    if current.manifest.standard != cargo.standard:
        return "current.manifest.standard"
    if !validator.CsgCoreProfilesEqual(
           current.manifest.profiles, cargo.profiles):
        return "current.manifest.profiles"
    if current.manifest.factsRoot != cargo.factsRoot:
        return "current.manifest.factsRoot"
    if current.manifest.dagRootCid != cargo.dagRootCid:
        return "current.manifest.dagRootCid"
    if current.manifest.schemaCid != cargo.schemaCid:
        return "current.manifest.schemaCid"
    if current.manifest.profileSetCid != cargo.profileSetCid:
        return "current.manifest.profileSetCid"
    if current.manifest.factCount != cargo.factCount:
        return "current.manifest.factCount"
    if !current.manifest.complete:
        return "current.manifest.complete"
    return ""

@borrows
fn CompilerSnapshotLoweringAuthorityIssueCurrentInto(
        cargo: var snapshot_cargo.CsgCompilerSnapshotCargo,
        storage: CompilerSnapshotLoweringAuthorityStoreBinding,
        current: merkle_store.CsgCoreMerkleHeadReadResult,
        snapshotSchemaVersion: int32,
        snapshotSemanticEpoch: int64,
        sourceSnapshotCount: int32,
        importEdgeCount: int32,
        unresolvedImportCount: int32,
        sourcePackageIdCid: layout.FixedBytes32,
        entryModulePathCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        entrySourceCid: layout.FixedBytes32,
        importGraphCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        parserReceiptCid: layout.FixedBytes32,
        graphCid: layout.FixedBytes32,
        canonicalGraphCid: layout.FixedBytes32,
        compilerCsgTransitionReceiptCid: layout.FixedBytes32,
        worldHeadCid: layout.FixedBytes32,
        compilerExecutionCid: layout.FixedBytes32,
        compilerPackageCid: layout.FixedBytes32,
        snapshotPredecessorReceiptCid: layout.FixedBytes32,
        out: var CompilerSnapshotLoweringAuthorityHandle,
        err: var str): bool =
    out = CompilerSnapshotLoweringAuthorityHandle()
    if !cargo.ok || cargo.factCount <= 0 ||
       !compilerSnapshotAuthorityStoreBindingObserved(storage):
        err = " compiler snapshot lowering authority: issue input rejected"
        return false
    let verified = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        cargo.csgcBytes, cargo.factsRootCid)
    let canonicalCsgcObjectCidText =
        merkle_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            cargo.csgcBytes)
    let cargoStoreIdentityCidText =
        "sha256:" +
        layout.FixedBytes32Hex(storage.cargoStoreIdentityCid)
    let rejectTag = compilerSnapshotAuthorityImmutableCargoRejectTag(
        cargo,
        storage,
        current,
        verified,
        canonicalCsgcObjectCidText,
        cargoStoreIdentityCidText)
    if rejectTag.len != 0:
        err = " compiler snapshot lowering authority: immutable Cargo rejected:" +
            rejectTag
        return false
    for lineIndex in 0..<verified.canonicalLines.len:
        if verified.canonicalLines[lineIndex] !=
           cargo.canonicalLines[lineIndex]:
            err =
                " compiler snapshot lowering authority: verified facts drift"
            return false
    var headCid: layout.FixedBytes32
    var manifestCid: layout.FixedBytes32
    var transactionReceiptCid: layout.FixedBytes32
    var schemaCid: layout.FixedBytes32
    var profileSetCid: layout.FixedBytes32
    var csgcObjectCid: layout.FixedBytes32
    var canonicalCsgcObjectCid: layout.FixedBytes32
    headCid = storage.cargoStoreHeadCid
    manifestCid = storage.cargoStoreManifestCid
    transactionReceiptCid = storage.cargoStoreReceiptCid
    csgcObjectCid = storage.cargoStoreCsgcObjectCid
    if !compilerSnapshotAuthorityCidTextInto(
           canonicalCsgcObjectCidText, canonicalCsgcObjectCid) ||
       !layout.FixedBytes32Equal(
           canonicalCsgcObjectCid, csgcObjectCid) ||
       !compilerSnapshotAuthorityCidTextInto(cargo.schemaCid, schemaCid) ||
       !compilerSnapshotAuthorityCidTextInto(
           cargo.profileSetCid, profileSetCid):
        err = " compiler snapshot lowering authority: CID decode rejected"
        return false
    let proofCargoCid =
        compilerSnapshotAuthorityProofCargoCidFromValues(
            storage.cargoStoreIdentityCid,
            csgcObjectCid, cargo.factsRootCid, headCid, manifestCid,
            transactionReceiptCid, schemaCid, profileSetCid,
            cargo.cargoCid, true, cargo.factCount)
    if !compilerSnapshotAuthorityCidObserved(proofCargoCid):
        err =
            " compiler snapshot lowering authority: proof cargo CID rejected"
        return false
    var identity: compilerSnapshotLoweringAuthorityIdentityInput
    identity.sourceSnapshotCount = sourceSnapshotCount
    identity.importEdgeCount = importEdgeCount
    identity.unresolvedImportCount = unresolvedImportCount
    identity.sourcePackageIdCid = sourcePackageIdCid
    identity.entryModulePathCid = entryModulePathCid
    identity.sourceBundleCid = sourceBundleCid
    identity.entrySourceCid = entrySourceCid
    identity.importGraphCid = importGraphCid
    identity.sourceIdentityReceiptCid = sourceIdentityReceiptCid
    identity.parserReceiptCid = parserReceiptCid
    identity.graphCid = graphCid
    identity.canonicalGraphCid = canonicalGraphCid
    identity.compilerCsgTransitionReceiptCid =
        compilerCsgTransitionReceiptCid
    identity.worldHeadCid = worldHeadCid
    identity.compilerExecutionCid = compilerExecutionCid
    identity.compilerPackageCid = compilerPackageCid
    identity.snapshotPredecessorReceiptCid = snapshotPredecessorReceiptCid
    return compilerSnapshotAuthorityIssuePreparedInto(
        snapshotSchemaVersion, snapshotSemanticEpoch, cargo.factCount,
        true,
        cargo.factsRootCid, headCid, manifestCid, transactionReceiptCid,
        schemaCid, profileSetCid, cargo.cargoCid, csgcObjectCid,
        proofCargoCid, storage, identity, out, err)

@borrows
fn CompilerSnapshotLoweringAuthorityCanonicalEmpty(
        handle: CompilerSnapshotLoweringAuthorityHandle): bool =
    return handle.ownerId == 0 && handle.generation == 0 &&
        !compilerSnapshotAuthorityCidObserved(handle.leaseNonce)

@borrows
fn CompilerSnapshotLoweringAuthorityIssuedStrictValidateInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        err: var str): bool =
    compilerSnapshotAuthorityLock()
    let valid = compilerSnapshotAuthorityRegistryShapeValid() &&
        compilerSnapshotAuthorityHandleRowValid(
            handle, compilerSnapshotAuthorityStateIssued)
    compilerSnapshotAuthorityUnlock()
    if !valid:
        err = " compiler snapshot lowering authority: issued handle rejected"
        return false
    err = ""
    return true

fn compilerSnapshotAuthoritySnapshotProjectionInto(
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        out: var compilerSnapshotLoweringAuthoritySnapshotProjection,
        err: var str): bool =
    out = compilerSnapshotLoweringAuthoritySnapshotProjection()
    if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err):
        return false
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    defer:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    var schemaCid: layout.FixedBytes32
    var profileSetCid: layout.FixedBytes32
    if !cargo.ok || cargo.factCount <= 0 ||
       !compilerSnapshotAuthorityCidTextInto(cargo.schemaCid, schemaCid) ||
       !compilerSnapshotAuthorityCidTextInto(
           cargo.profileSetCid, profileSetCid):
        err =
            " compiler snapshot lowering authority: snapshot projection invalid"
        return false
    out.schemaVersion = snapshot.schemaVersion
    out.semanticEpoch = snapshot.semanticEpoch
    out.factCount = cargo.factCount
    out.factsRootCid = cargo.factsRootCid
    out.cargoCid = cargo.cargoCid
    out.schemaCid = schemaCid
    out.profileSetCid = profileSetCid
    out.predecessorReceiptCid = snapshot.predecessorReceiptCid
    err = ""
    return true

fn compilerSnapshotAuthoritySnapshotProjectionMatchesRow(
        projection:
            compilerSnapshotLoweringAuthoritySnapshotProjection,
        slot: int32): bool =
    return projection.schemaVersion ==
               compilerSnapshotAuthorityI32At(
                   compilerSnapshotAuthorityRegistry.schemaVersions, slot) &&
        projection.semanticEpoch == compilerSnapshotAuthorityI64At(
            compilerSnapshotAuthorityRegistry.semanticEpochHigh,
            compilerSnapshotAuthorityRegistry.semanticEpochLow,
            slot) &&
        projection.factCount == compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.factCounts, slot) &&
        layout.FixedBytes32Equal(
            projection.factsRootCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.factsRootCids, slot)) &&
        layout.FixedBytes32Equal(
            projection.cargoCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.cargoCids, slot)) &&
        layout.FixedBytes32Equal(
            projection.schemaCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.schemaCids, slot)) &&
        layout.FixedBytes32Equal(
            projection.profileSetCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.profileSetCids, slot)) &&
        layout.FixedBytes32Equal(
            projection.predecessorReceiptCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.snapshotPredecessorReceiptCids,
                slot))

fn compilerSnapshotAuthorityActualIdentityMatchesRow(
        slot: int32,
        actual: compilerSnapshotLoweringAuthorityIdentityInput): bool =
    let expected = compilerSnapshotAuthorityIdentityAt(slot)
    return actual.sourceSnapshotCount == expected.sourceSnapshotCount &&
        actual.importEdgeCount == expected.importEdgeCount &&
        actual.unresolvedImportCount == expected.unresolvedImportCount &&
        layout.FixedBytes32Equal(
            actual.sourcePackageIdCid, expected.sourcePackageIdCid) &&
        layout.FixedBytes32Equal(
            actual.entryModulePathCid, expected.entryModulePathCid) &&
        layout.FixedBytes32Equal(
            actual.sourceBundleCid, expected.sourceBundleCid) &&
        layout.FixedBytes32Equal(
            actual.entrySourceCid, expected.entrySourceCid) &&
        layout.FixedBytes32Equal(
            actual.importGraphCid, expected.importGraphCid) &&
        layout.FixedBytes32Equal(
            actual.sourceIdentityReceiptCid,
            expected.sourceIdentityReceiptCid) &&
        layout.FixedBytes32Equal(
            actual.parserReceiptCid, expected.parserReceiptCid) &&
        layout.FixedBytes32Equal(actual.graphCid, expected.graphCid) &&
        layout.FixedBytes32Equal(
            actual.canonicalGraphCid, expected.canonicalGraphCid) &&
        layout.FixedBytes32Equal(
            actual.compilerCsgTransitionReceiptCid,
            expected.compilerCsgTransitionReceiptCid) &&
        layout.FixedBytes32Equal(
            actual.worldHeadCid, expected.worldHeadCid) &&
        layout.FixedBytes32Equal(
            actual.compilerExecutionCid, expected.compilerExecutionCid) &&
        layout.FixedBytes32Equal(
            actual.compilerPackageCid, expected.compilerPackageCid) &&
        layout.FixedBytes32Equal(
            actual.snapshotPredecessorReceiptCid,
            expected.snapshotPredecessorReceiptCid)

fn CompilerSnapshotLoweringAuthorityAbortIssued(
        handle: var CompilerSnapshotLoweringAuthorityHandle) =
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if compilerSnapshotAuthorityRegistryShapeValid() && slot >= 0 &&
       compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStateIssued):
        compilerSnapshotAuthoritySetFixed32(
            compilerSnapshotAuthorityRegistry.leaseNonces,
            slot,
            layout.FixedBytes32())
        compilerSnapshotAuthoritySetI32(
            compilerSnapshotAuthorityRegistry.states,
            slot,
            compilerSnapshotAuthorityStateReleased)
    compilerSnapshotAuthorityUnlock()
    handle = CompilerSnapshotLoweringAuthorityHandle()

@borrows
fn CompilerSnapshotLoweringAuthorityClaimPlanOwnedInto(
        handle: var CompilerSnapshotLoweringAuthorityHandle,
        storage: CompilerSnapshotLoweringAuthorityStoreBinding,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        sourceSnapshotCount: int32,
        importEdgeCount: int32,
        unresolvedImportCount: int32,
        sourcePackageIdCid: layout.FixedBytes32,
        entryModulePathCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        entrySourceCid: layout.FixedBytes32,
        importGraphCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        parserReceiptCid: layout.FixedBytes32,
        graphCid: layout.FixedBytes32,
        canonicalGraphCid: layout.FixedBytes32,
        compilerCsgTransitionReceiptCid: layout.FixedBytes32,
        err: var str): bool =
    var projection: compilerSnapshotLoweringAuthoritySnapshotProjection
    if !compilerSnapshotAuthorityStoreBindingObserved(storage) ||
       !compilerSnapshotAuthoritySnapshotProjectionInto(
           snapshot, projection, err):
        CompilerSnapshotLoweringAuthorityAbortIssued(handle)
        return false
    var planOwnedLeaseNonce: layout.FixedBytes32
    if !compilerSnapshotAuthoritySystemLeaseNonceInto(
           planOwnedLeaseNonce, err):
        CompilerSnapshotLoweringAuthorityAbortIssued(handle)
        return false
    var actual: compilerSnapshotLoweringAuthorityIdentityInput
    actual.sourceSnapshotCount = sourceSnapshotCount
    actual.importEdgeCount = importEdgeCount
    actual.unresolvedImportCount = unresolvedImportCount
    actual.sourcePackageIdCid = sourcePackageIdCid
    actual.entryModulePathCid = entryModulePathCid
    actual.sourceBundleCid = sourceBundleCid
    actual.entrySourceCid = entrySourceCid
    actual.importGraphCid = importGraphCid
    actual.sourceIdentityReceiptCid = sourceIdentityReceiptCid
    actual.parserReceiptCid = parserReceiptCid
    actual.graphCid = graphCid
    actual.canonicalGraphCid = canonicalGraphCid
    actual.compilerCsgTransitionReceiptCid =
        compilerCsgTransitionReceiptCid
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStateIssued):
        compilerSnapshotAuthorityUnlock()
        CompilerSnapshotLoweringAuthorityAbortIssued(handle)
        err = " compiler snapshot lowering authority: claim handle rejected"
        return false
    actual.worldHeadCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.worldHeadCids, slot)
    actual.compilerExecutionCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.compilerExecutionCids, slot)
    actual.compilerPackageCid =
        compilerSnapshotAuthorityFixed32At(
            compilerSnapshotAuthorityRegistry.compilerPackageCids, slot)
    actual.snapshotPredecessorReceiptCid = projection.predecessorReceiptCid
    if !compilerSnapshotAuthorityActualIdentityMatchesRow(slot, actual) ||
       !compilerSnapshotAuthoritySnapshotProjectionMatchesRow(
           projection, slot) ||
       !compilerSnapshotAuthorityStoreBindingEqual(
           storage,
           compilerSnapshotAuthorityStoreBindingAt(slot)):
        compilerSnapshotAuthoritySetFixed32(
            compilerSnapshotAuthorityRegistry.leaseNonces,
            slot,
            layout.FixedBytes32())
        compilerSnapshotAuthoritySetI32(
            compilerSnapshotAuthorityRegistry.states,
            slot,
            compilerSnapshotAuthorityStateReleased)
        compilerSnapshotAuthorityUnlock()
        CompilerSnapshotLoweringAuthorityAbortIssued(handle)
        if err.len == 0:
            err =
                " compiler snapshot lowering authority: cross-CSG claim rejected"
        return false
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.leaseNonces,
        slot,
        planOwnedLeaseNonce)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.states,
        slot,
        compilerSnapshotAuthorityStatePlanOwned)
    handle.leaseNonce = planOwnedLeaseNonce
    if !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthorityUnlock()
        panic("compiler snapshot lowering authority: claim commit drift")
    compilerSnapshotAuthorityUnlock()
    err = ""
    return true

@borrows
fn CompilerSnapshotLoweringAuthorityPlanOwnedStrictValidateInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        err: var str): bool =
    compilerSnapshotAuthorityLock()
    let valid = compilerSnapshotAuthorityRegistryShapeValid() &&
        compilerSnapshotAuthorityHandleRowValid(
            handle, compilerSnapshotAuthorityStatePlanOwned)
    compilerSnapshotAuthorityUnlock()
    if !valid:
        err =
            " compiler snapshot lowering authority: PlanOwned handle rejected"
        return false
    err = ""
    return true

fn compilerSnapshotAuthorityProofCargoProjectionAt(
        slot: int32):
        compilerSnapshotLoweringAuthorityProofCargoProjection =
    var out: compilerSnapshotLoweringAuthorityProofCargoProjection
    out.cargoStoreIdentityCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.cargoStoreIdentityCids, slot)
    out.csgcObjectCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.csgcObjectCids, slot)
    out.factsRootCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.factsRootCids, slot)
    out.headCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.headCids, slot)
    out.manifestCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.manifestCids, slot)
    out.transactionReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.receiptCids, slot)
    out.cargoStoreIdentityCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.cargoStoreIdentityCids, slot)
    out.envelopeStoreIdentityCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeStoreIdentityCids, slot)
    out.envelopeHeadCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeHeadCids, slot)
    out.envelopeManifestCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeManifestCids, slot)
    out.envelopeReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeReceiptCids, slot)
    out.envelopeMigrationReceiptCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeMigrationReceiptCids,
        slot)
    out.envelopeCsgcObjectCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.envelopeCsgcObjectCids, slot)
    out.schemaCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.schemaCids, slot)
    out.profileSetCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.profileSetCids, slot)
    out.cargoCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.cargoCids, slot)
    out.proofCargoCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.proofCargoCids, slot)
    out.complete = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.completeFlags, slot) == 1
    out.factCount = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.factCounts, slot)
    return out

fn compilerSnapshotAuthorityProofCargoProjectionMatchesRow(
        projection:
            compilerSnapshotLoweringAuthorityProofCargoProjection,
        slot: int32): bool =
    let current = compilerSnapshotAuthorityProofCargoProjectionAt(slot)
    return projection.complete == current.complete &&
        projection.factCount == current.factCount &&
        layout.FixedBytes32Equal(
            projection.cargoStoreIdentityCid,
            current.cargoStoreIdentityCid) &&
        layout.FixedBytes32Equal(
            projection.csgcObjectCid, current.csgcObjectCid) &&
        layout.FixedBytes32Equal(
            projection.factsRootCid, current.factsRootCid) &&
        layout.FixedBytes32Equal(projection.headCid, current.headCid) &&
        layout.FixedBytes32Equal(
            projection.manifestCid, current.manifestCid) &&
        layout.FixedBytes32Equal(
            projection.transactionReceiptCid,
            current.transactionReceiptCid) &&
        layout.FixedBytes32Equal(projection.schemaCid, current.schemaCid) &&
        layout.FixedBytes32Equal(
            projection.profileSetCid, current.profileSetCid) &&
        layout.FixedBytes32Equal(projection.cargoCid, current.cargoCid) &&
        layout.FixedBytes32Equal(
            projection.proofCargoCid, current.proofCargoCid)

@borrows
fn CompilerSnapshotLoweringAuthorityProofCargoCidStrictRecomputeInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    var projection: compilerSnapshotLoweringAuthorityProofCargoProjection
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthorityUnlock()
        err =
            "compiler_snapshot_lowering_authority_proof_cargo_handle_rejected"
        return false
    projection = compilerSnapshotAuthorityProofCargoProjectionAt(slot)
    compilerSnapshotAuthorityUnlock()
    let recomputed = compilerSnapshotAuthorityProofCargoCidFromValues(
        projection.cargoStoreIdentityCid,
        projection.csgcObjectCid, projection.factsRootCid,
        projection.headCid, projection.manifestCid,
        projection.transactionReceiptCid, projection.schemaCid,
        projection.profileSetCid, projection.cargoCid,
        projection.complete, projection.factCount)
    if !compilerSnapshotAuthorityCidObserved(recomputed):
        err =
            "compiler_snapshot_lowering_authority_proof_cargo_zero"
        return false
    compilerSnapshotAuthorityLock()
    let stable = compilerSnapshotAuthorityRegistryShapeValid() &&
        slot >= 0 &&
        compilerSnapshotAuthorityHandleRowValid(
            handle, compilerSnapshotAuthorityStatePlanOwned) &&
        compilerSnapshotAuthorityProofCargoProjectionMatchesRow(
            projection, slot) &&
        layout.FixedBytes32Equal(projection.proofCargoCid, recomputed)
    compilerSnapshotAuthorityUnlock()
    if !stable:
        err =
            "compiler_snapshot_lowering_authority_proof_cargo_recompute_mismatch"
        return false
    out = recomputed
    err = ""
    return true

@borrows
fn CompilerSnapshotLoweringAuthorityProductionArtifactsBoundStrictValidateInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        expectedHeadCid: layout.FixedBytes32,
        expectedManifestCid: layout.FixedBytes32,
        expectedCsgcObjectCid: layout.FixedBytes32,
        expectedFactsRootCid: layout.FixedBytes32,
        expectedProofCargoCid: layout.FixedBytes32,
        expectedTransactionReceiptCid: layout.FixedBytes32,
        err: var str): bool =
    if !compilerSnapshotAuthorityCidObserved(expectedHeadCid) ||
       !compilerSnapshotAuthorityCidObserved(expectedManifestCid) ||
       !compilerSnapshotAuthorityCidObserved(expectedCsgcObjectCid) ||
       !compilerSnapshotAuthorityCidObserved(expectedFactsRootCid) ||
       !compilerSnapshotAuthorityCidObserved(expectedProofCargoCid) ||
       !compilerSnapshotAuthorityCidObserved(
           expectedTransactionReceiptCid):
        err =
            "compiler_snapshot_lowering_authority_production_cid_invalid"
        return false
    var recomputedProofCargoCid: layout.FixedBytes32
    if !CompilerSnapshotLoweringAuthorityProofCargoCidStrictRecomputeInto(
           handle, recomputedProofCargoCid, err):
        return false
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthorityUnlock()
        err =
            "compiler_snapshot_lowering_authority_production_handle_rejected"
        return false
    if !layout.FixedBytes32Equal(
           expectedHeadCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.headCids, slot)):
        compilerSnapshotAuthorityUnlock()
        err = "system_link_exec_production_current_head_unbound"
        return false
    if !layout.FixedBytes32Equal(
           expectedManifestCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.manifestCids, slot)):
        compilerSnapshotAuthorityUnlock()
        err = "system_link_exec_production_manifest_unbound"
        return false
    if !layout.FixedBytes32Equal(
           expectedCsgcObjectCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.csgcObjectCids, slot)):
        compilerSnapshotAuthorityUnlock()
        err = "system_link_exec_production_csgc_object_unbound"
        return false
    if !layout.FixedBytes32Equal(
           expectedFactsRootCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.factsRootCids, slot)):
        compilerSnapshotAuthorityUnlock()
        err = "system_link_exec_production_facts_root_unbound"
        return false
    if !layout.FixedBytes32Equal(
           expectedProofCargoCid, recomputedProofCargoCid) ||
       !layout.FixedBytes32Equal(
           expectedProofCargoCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.proofCargoCids, slot)):
        compilerSnapshotAuthorityUnlock()
        err = "system_link_exec_production_proof_cargo_unbound"
        return false
    if !layout.FixedBytes32Equal(
           expectedTransactionReceiptCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.receiptCids, slot)):
        compilerSnapshotAuthorityUnlock()
        err =
            "system_link_exec_production_csg_authority_receipt_unbound"
        return false
    compilerSnapshotAuthorityUnlock()
    err = ""
    return true

@borrows
fn CompilerSnapshotLoweringAuthorityProductionBindingInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        out: var CompilerSnapshotLoweringAuthorityProductionBinding,
        err: var str): bool =
    out = CompilerSnapshotLoweringAuthorityProductionBinding()
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthorityUnlock()
        err =
            "compiler_snapshot_lowering_authority_production_binding_rejected"
        return false
    let stored = compilerSnapshotAuthorityStoreBindingAt(slot)
    out.currentHeadCid = stored.cargoStoreHeadCid
    out.manifestCid = stored.cargoStoreManifestCid
    out.csgcObjectCid = stored.cargoStoreCsgcObjectCid
    out.factsRootCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.factsRootCids, slot)
    out.proofCargoCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.proofCargoCids, slot)
    out.transactionReceiptCid = stored.cargoStoreReceiptCid
    out.cargoStoreIdentityCid = stored.cargoStoreIdentityCid
    out.envelopeStoreIdentityCid = stored.envelopeStoreIdentityCid
    out.envelopeHeadCid = stored.envelopeHeadCid
    out.envelopeManifestCid = stored.envelopeManifestCid
    out.envelopeReceiptCid = stored.envelopeReceiptCid
    out.envelopeMigrationReceiptCid = stored.envelopeMigrationReceiptCid
    out.envelopeCsgcObjectCid = stored.envelopeCsgcObjectCid
    out.cargoCid = stored.cargoCid
    out.cargoSchemaCid = stored.cargoSchemaCid
    out.cargoProfileSetCid = stored.cargoProfileSetCid
    out.cargoFactCount = stored.cargoFactCount
    out.cargoComplete = stored.cargoComplete
    compilerSnapshotAuthorityUnlock()
    if !compilerSnapshotAuthorityCidObserved(out.currentHeadCid) ||
       !compilerSnapshotAuthorityCidObserved(out.manifestCid) ||
       !compilerSnapshotAuthorityCidObserved(out.csgcObjectCid) ||
       !compilerSnapshotAuthorityCidObserved(out.factsRootCid) ||
       !compilerSnapshotAuthorityCidObserved(out.proofCargoCid) ||
       !compilerSnapshotAuthorityCidObserved(out.transactionReceiptCid) ||
       !compilerSnapshotAuthorityCidObserved(out.cargoStoreIdentityCid) ||
       !compilerSnapshotAuthorityCidObserved(
           out.envelopeStoreIdentityCid) ||
       !compilerSnapshotAuthorityCidObserved(out.envelopeHeadCid) ||
       !compilerSnapshotAuthorityCidObserved(out.envelopeManifestCid) ||
       !compilerSnapshotAuthorityCidObserved(out.envelopeReceiptCid) ||
       !compilerSnapshotAuthorityCidObserved(
           out.envelopeMigrationReceiptCid) ||
       !compilerSnapshotAuthorityCidObserved(out.envelopeCsgcObjectCid) ||
       !compilerSnapshotAuthorityCidObserved(out.cargoCid) ||
       !compilerSnapshotAuthorityCidObserved(out.cargoSchemaCid) ||
       !compilerSnapshotAuthorityCidObserved(out.cargoProfileSetCid) ||
       out.cargoFactCount <= 0 || !out.cargoComplete:
        out = CompilerSnapshotLoweringAuthorityProductionBinding()
        err =
            "compiler_snapshot_lowering_authority_production_binding_incomplete"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotAuthorityPlanOwnedCidAt(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        column: phase.PhaseArenaRef,
        message: str): layout.FixedBytes32 =
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthorityUnlock()
        panic(strings.CloneStr(message))
    let out = compilerSnapshotAuthorityFixed32At(column, slot)
    compilerSnapshotAuthorityUnlock()
    return out

@borrows
fn CompilerSnapshotLoweringAuthorityIdentityCid(
        handle: CompilerSnapshotLoweringAuthorityHandle):
        layout.FixedBytes32 =
    return compilerSnapshotAuthorityPlanOwnedCidAt(
        handle,
        compilerSnapshotAuthorityRegistry.identityCids,
        "compiler snapshot lowering authority: identity query rejected")

@borrows
fn CompilerSnapshotLoweringAuthorityFactsRootCid(
        handle: CompilerSnapshotLoweringAuthorityHandle):
        layout.FixedBytes32 =
    return compilerSnapshotAuthorityPlanOwnedCidAt(
        handle,
        compilerSnapshotAuthorityRegistry.factsRootCids,
        "compiler snapshot lowering authority: facts root query rejected")

@borrows
fn CompilerSnapshotLoweringAuthorityCargoCid(
        handle: CompilerSnapshotLoweringAuthorityHandle):
        layout.FixedBytes32 =
    return compilerSnapshotAuthorityPlanOwnedCidAt(
        handle,
        compilerSnapshotAuthorityRegistry.cargoCids,
        "compiler snapshot lowering authority: cargo query rejected")

@borrows
fn CompilerSnapshotLoweringAuthorityGraphCid(
