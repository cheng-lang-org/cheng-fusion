        handle,
        compilerSnapshotAuthorityRegistry.sourceBundleCids,
        "compiler snapshot lowering authority: source bundle query rejected")

@borrows
fn CompilerSnapshotLoweringAuthoritySnapshotPredecessorReceiptCid(
        handle: CompilerSnapshotLoweringAuthorityHandle):
        layout.FixedBytes32 =
    return compilerSnapshotAuthorityPlanOwnedCidAt(
        handle,
        compilerSnapshotAuthorityRegistry.snapshotPredecessorReceiptCids,
        "compiler snapshot lowering authority: predecessor query rejected")

fn CompilerSnapshotLoweringAuthorityPlanOwnedSnapshotMatchesInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        graphCid: layout.FixedBytes32,
        canonicalGraphCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        err: var str): bool =
    var projection: compilerSnapshotLoweringAuthoritySnapshotProjection
    if !compilerSnapshotAuthoritySnapshotProjectionInto(
           snapshot, projection, err):
        return false
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned) ||
       !layout.FixedBytes32Equal(
           graphCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.graphCids, slot)) ||
       !layout.FixedBytes32Equal(
           canonicalGraphCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.canonicalGraphCids,
               slot)) ||
       !layout.FixedBytes32Equal(
           sourceBundleCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.sourceBundleCids,
               slot)) ||
       !compilerSnapshotAuthoritySnapshotProjectionMatchesRow(
           projection, slot):
        compilerSnapshotAuthorityUnlock()
        if err.len == 0:
            err =
                " compiler snapshot lowering authority: live projection drift"
        return false
    compilerSnapshotAuthorityUnlock()
    err = ""
    return true

fn CompilerSnapshotLoweringAuthorityAbortPlanOwned(
        handle: var CompilerSnapshotLoweringAuthorityHandle) =
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if compilerSnapshotAuthorityRegistryShapeValid() && slot >= 0 &&
       compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthoritySetFixed32(
            compilerSnapshotAuthorityRegistry.leaseNonces,
            slot,
            layout.FixedBytes32())
        compilerSnapshotAuthoritySetI32(
            compilerSnapshotAuthorityRegistry.states,
            slot,
            compilerSnapshotAuthorityStateReleased)
    compilerSnapshotAuthorityUnlock()
    handle = CompilerSnapshotLoweringAuthorityHandle()

fn CompilerSnapshotLoweringAuthorityBindFunctionProjectionInto(
        handle: var CompilerSnapshotLoweringAuthorityHandle,
        functionProjectionCid: layout.FixedBytes32,
        err: var str): bool =
    if !compilerSnapshotAuthorityCidObserved(functionProjectionCid):
        CompilerSnapshotLoweringAuthorityAbortPlanOwned(handle)
        err =
            " compiler snapshot lowering authority: zero function projection"
        return false
    var boundLeaseNonce: layout.FixedBytes32
    if !compilerSnapshotAuthoritySystemLeaseNonceInto(boundLeaseNonce, err):
        CompilerSnapshotLoweringAuthorityAbortPlanOwned(handle)
        return false
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned) ||
       compilerSnapshotAuthorityI32At(
           compilerSnapshotAuthorityRegistry.functionProjectionBound,
           slot) != 0 ||
       compilerSnapshotAuthorityCidObserved(
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.functionProjectionCids,
               slot)):
        compilerSnapshotAuthorityUnlock()
        CompilerSnapshotLoweringAuthorityAbortPlanOwned(handle)
        err =
            " compiler snapshot lowering authority: function projection bind rejected"
        return false
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.functionProjectionCids,
        slot,
        functionProjectionCid)
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.functionProjectionBound,
        slot,
        1)
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.leaseNonces,
        slot,
        boundLeaseNonce)
    handle.leaseNonce = boundLeaseNonce
    let committed =
        compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.functionProjectionBound,
            slot) == 1 &&
        layout.FixedBytes32Equal(
            functionProjectionCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.functionProjectionCids,
                slot)) &&
        compilerSnapshotAuthorityHandleRowValid(
            handle, compilerSnapshotAuthorityStatePlanOwned)
    compilerSnapshotAuthorityUnlock()
    if !committed:
        panic("compiler snapshot lowering authority: function projection commit drift")
    err = ""
    return true

@borrows
fn CompilerSnapshotLoweringAuthorityFunctionProjectionMatchesInto(
        handle: CompilerSnapshotLoweringAuthorityHandle,
        functionProjectionCid: layout.FixedBytes32,
        err: var str): bool =
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    compilerSnapshotAuthorityLock()
    let valid = compilerSnapshotAuthorityRegistryShapeValid() &&
        slot >= 0 &&
        compilerSnapshotAuthorityHandleRowValid(
            handle, compilerSnapshotAuthorityStatePlanOwned) &&
        compilerSnapshotAuthorityI32At(
            compilerSnapshotAuthorityRegistry.functionProjectionBound,
            slot) == 1 &&
        compilerSnapshotAuthorityCidObserved(functionProjectionCid) &&
        layout.FixedBytes32Equal(
            functionProjectionCid,
            compilerSnapshotAuthorityFixed32At(
                compilerSnapshotAuthorityRegistry.functionProjectionCids,
                slot))
    compilerSnapshotAuthorityUnlock()
    if !valid:
        err =
            " compiler snapshot lowering authority: function projection rejected"
        return false
    err = ""
    return true

fn CompilerSnapshotLoweringAuthorityReleasePlanOwnedInto(
        handle: var CompilerSnapshotLoweringAuthorityHandle,
        expectedIdentityCid: layout.FixedBytes32,
        expectedFunctionProjectionCid: layout.FixedBytes32,
        releaseCid: var layout.FixedBytes32,
        err: var str): bool =
    releaseCid = layout.FixedBytes32()
    let ownerId = handle.ownerId
    let generation = handle.generation
    let slot = compilerSnapshotAuthorityHandleSlot(handle)
    var bytes = layout.ByteBufInit(224)
    compilerSnapshotAuthorityAppendText(
        bytes, compilerSnapshotAuthorityReleaseDomain)
    compilerSnapshotAuthorityAppendU32(bytes, ownerId)
    compilerSnapshotAuthorityAppendU32(bytes, generation)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, expectedIdentityCid)
    compilerSnapshotAuthorityAppendFixed32Field(
        bytes, expectedFunctionProjectionCid)
    compilerSnapshotAuthorityAppendU32(
        bytes, compilerSnapshotAuthorityStateReleased)
    let candidateReleaseCid =
        hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    if !compilerSnapshotAuthorityCidObserved(candidateReleaseCid):
        panic("compiler snapshot lowering authority: zero release CID")
    compilerSnapshotAuthorityLock()
    if !compilerSnapshotAuthorityRegistryShapeValid() || slot < 0 ||
       !compilerSnapshotAuthorityHandleRowValid(
           handle, compilerSnapshotAuthorityStatePlanOwned):
        compilerSnapshotAuthorityUnlock()
        handle = CompilerSnapshotLoweringAuthorityHandle()
        err =
            " compiler snapshot lowering authority: duplicate or stale release"
        return false
    let projectionBound = compilerSnapshotAuthorityI32At(
        compilerSnapshotAuthorityRegistry.functionProjectionBound,
        slot)
    let storedProjectionCid = compilerSnapshotAuthorityFixed32At(
        compilerSnapshotAuthorityRegistry.functionProjectionCids,
        slot)
    let projectionBindingValid =
        (projectionBound == 0 &&
         !compilerSnapshotAuthorityCidObserved(
             expectedFunctionProjectionCid) &&
         !compilerSnapshotAuthorityCidObserved(storedProjectionCid)) ||
        (projectionBound == 1 &&
         compilerSnapshotAuthorityCidObserved(
             expectedFunctionProjectionCid) &&
         layout.FixedBytes32Equal(
             expectedFunctionProjectionCid, storedProjectionCid))
    if !projectionBindingValid ||
       !layout.FixedBytes32Equal(
           expectedIdentityCid,
           compilerSnapshotAuthorityFixed32At(
               compilerSnapshotAuthorityRegistry.identityCids, slot)):
        compilerSnapshotAuthorityUnlock()
        CompilerSnapshotLoweringAuthorityAbortPlanOwned(handle)
        err =
            " compiler snapshot lowering authority: release binding rejected"
        return false
    compilerSnapshotAuthoritySetFixed32(
        compilerSnapshotAuthorityRegistry.leaseNonces,
        slot,
        layout.FixedBytes32())
    compilerSnapshotAuthoritySetI32(
        compilerSnapshotAuthorityRegistry.states,
        slot,
        compilerSnapshotAuthorityStateReleased)
    compilerSnapshotAuthorityUnlock()
    releaseCid = candidateReleaseCid
    handle = CompilerSnapshotLoweringAuthorityHandle()
    err = ""
    return true
