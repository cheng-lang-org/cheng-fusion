    return compilerSnapshotAuthorityPlanOwnedCidAt(
        handle,
        compilerSnapshotAuthorityRegistry.graphCids,
        "compiler snapshot lowering authority: graph query rejected")

@borrows
fn CompilerSnapshotLoweringAuthorityCanonicalGraphCid(
