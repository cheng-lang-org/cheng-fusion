import std/rawbytes
import std/strings
import std/tables
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator

const
    CsgRelfactsSchema: str = "csg_relfacts::v1"
    CsgRelfactsTransitionKind: str = "canonical_delta"
    CsgRelfactsAssert: int32 = 1
    CsgRelfactsRetract: int32 = 2

type
    CsgCoreRelfactsOperation =
        kind: int32
        fact: str

    CsgCoreRelfactsReplayResult =
        ok: bool
        error: str
        eventCount: int32
        assertCount: int32
        retractCount: int32
        beforeFactCount: int32
        afterFactCount: int32
        finalCanonicalFacts: str[]
        beforeDagRootCid: str
        afterDagRootCid: str
        beforeSubgraphCid: str
        afterSubgraphCid: str
        beforeFactsRoot: str
        afterFactsRoot: str
        transitionKind: str
        verifiedAgainstBeforeFacts: bool
        verifiedAgainstAfterFacts: bool

    CsgCoreRelfactsEncodeResult =
        ok: bool
        error: str
        text: str
        replay: CsgCoreRelfactsReplayResult

    csgRelfactsTextResult =
        ok: bool
        error: str
        value: str

    csgRelfactsRecordIndexResult =
        ok: bool
        error: str
        recordStarts: int32[]
        recordLengths: int32[]

    csgRelfactsFactIdentity =
        ok: bool
        error: str
        canonicalFact: str
        factKey: str
        factHash: str

    csgRelfactsEvent =
        ok: bool
        error: str
        kind: int32
        canonicalFact: str
        factKey: str

@borrows
fn csgRelfactsCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgRelfactsAt(ordinal: int32, error: str): str =
    return csgRelfactsCat(
        csgRelfactsCat(
            csgRelfactsCat(
                "relfacts_event ",
                strings.IntToStr(ordinal)),
            " "),
        error)

@borrows
fn csgRelfactsTextFail(error: str): csgRelfactsTextResult =
    var out: csgRelfactsTextResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgRelfactsReplayFail(error: str): CsgCoreRelfactsReplayResult =
    var out: CsgCoreRelfactsReplayResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgRelfactsBufText(buf: var layout.ByteBuf, text: str) =
    let bytes = rawbytes.BytesFromString(text)
    layout.ByteBufAppendBytes(buf, bytes)

@borrows
fn csgRelfactsBufQuoted(
        buf: var layout.ByteBuf,
        text: str,
        error: var str): bool =
    let quoted = canonical.CsgCoreJsonQuoteChecked(text)
    if !quoted.ok:
        error = csgRelfactsCat(
            "relfacts_json_quote_failed ",
            quoted.error)
        return false
    csgRelfactsBufText(buf, quoted.value)
    return true

fn csgRelfactsFinishText(
        buf: var layout.ByteBuf): csgRelfactsTextResult =
    var bytes = layout.ByteBufToBytes(buf)
    let text = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    var out: csgRelfactsTextResult
    out.ok = true
    out.value = text
    return out

@borrows
fn csgRelfactsFinishCanonicalLine(
        buf: var layout.ByteBuf): csgRelfactsTextResult =
    let text = csgRelfactsFinishText(buf)
    if !text.ok:
        return text
    let checked = canonical.CsgCoreJsonCanonicalize(text.value)
    if !checked.ok:
        return csgRelfactsTextFail(
            csgRelfactsCat(
                "relfacts_internal_record_invalid ",
                checked.error))
    if checked.value != text.value:
        return csgRelfactsTextFail(
            "relfacts_internal_record_noncanonical")
    return text

@borrows
fn csgRelfactsProfilesJson(
        profiles: str[]): csgRelfactsTextResult =
    var buf = layout.ByteBufInit(128)
    layout.ByteBufAppendByte(buf, int32('['))
    var error: str
    for i in 0..<profiles.len:
        if i > 0:
            layout.ByteBufAppendByte(buf, int32(','))
        if !csgRelfactsBufQuoted(buf, profiles[i], error):
            layout.ByteBufFree(buf)
            return csgRelfactsTextFail(error)
    layout.ByteBufAppendByte(buf, int32(']'))
    return csgRelfactsFinishText(buf)

@borrows
fn csgRelfactsHeaderLine(
        beforeDag: merkle_dag.CsgCoreMerkleDag,
        afterDag: merkle_dag.CsgCoreMerkleDag,
        eventCount: int32): csgRelfactsTextResult =
    if eventCount < 0:
        return csgRelfactsTextFail(
            "relfacts_event_count_invalid")
    if !beforeDag.ok:
        return csgRelfactsTextFail(
            csgRelfactsCat(
                "relfacts_before_binding_invalid ",
                beforeDag.error))
    if !afterDag.ok:
        return csgRelfactsTextFail(
            csgRelfactsCat(
                "relfacts_after_binding_invalid ",
                afterDag.error))
    let beforeProfilesJson =
        csgRelfactsProfilesJson(beforeDag.profiles)
    if !beforeProfilesJson.ok:
        return beforeProfilesJson
    let afterProfilesJson =
        csgRelfactsProfilesJson(afterDag.profiles)
    if !afterProfilesJson.ok:
        return afterProfilesJson

    var buf = layout.ByteBufInit(768)
    var error: str
    csgRelfactsBufText(buf, "{\"after_fact_count\":")
    csgRelfactsBufText(
        buf, strings.IntToStr(afterDag.factCount))
    csgRelfactsBufText(buf, ",\"after_facts_root\":")
    if !csgRelfactsBufQuoted(buf, afterDag.factsRoot, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"after_profiles\":")
    csgRelfactsBufText(buf, afterProfilesJson.value)
    csgRelfactsBufText(buf, ",\"after_schema_cid\":")
    if !csgRelfactsBufQuoted(buf, afterDag.schemaCid, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"after_schema_namespace\":")
    if !csgRelfactsBufQuoted(
            buf, afterDag.schemaNamespace, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"after_standard\":")
    if !csgRelfactsBufQuoted(buf, afterDag.standard, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"before_fact_count\":")
    csgRelfactsBufText(
        buf, strings.IntToStr(beforeDag.factCount))
    csgRelfactsBufText(buf, ",\"before_facts_root\":")
    if !csgRelfactsBufQuoted(buf, beforeDag.factsRoot, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"before_profiles\":")
    csgRelfactsBufText(buf, beforeProfilesJson.value)
    csgRelfactsBufText(buf, ",\"before_schema_cid\":")
    if !csgRelfactsBufQuoted(buf, beforeDag.schemaCid, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"before_schema_namespace\":")
    if !csgRelfactsBufQuoted(
            buf, beforeDag.schemaNamespace, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"before_standard\":")
    if !csgRelfactsBufQuoted(buf, beforeDag.standard, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"event_count\":")
    csgRelfactsBufText(buf, strings.IntToStr(eventCount))
    csgRelfactsBufText(buf, ",\"schema\":")
    if !csgRelfactsBufQuoted(buf, CsgRelfactsSchema, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"transition_kind\":")
    if !csgRelfactsBufQuoted(
            buf, CsgRelfactsTransitionKind, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    layout.ByteBufAppendByte(buf, int32('}'))
    return csgRelfactsFinishCanonicalLine(buf)

@borrows
fn csgRelfactsIdentity(
        fact: str): csgRelfactsFactIdentity =
    var out: csgRelfactsFactIdentity
    var error: str
    out.canonicalFact =
        merkle_dag.CsgCoreMerkleCanonicalFact(
            fact, error)
    if error.len > 0:
        out.error = csgRelfactsCat(
            "relfacts_fact_invalid ", error)
        return out
    out.factKey =
        merkle_dag.CsgCoreMerkleFactKey(
            out.canonicalFact, error)
    if error.len > 0:
        out.error = csgRelfactsCat(
            "relfacts_fact_key_invalid ", error)
        return out
    let hash =
        merkle_dag.CsgCoreMerkleFactHash(
            out.canonicalFact, error)
    if error.len > 0:
        out.error = csgRelfactsCat(
            "relfacts_fact_hash_invalid ", error)
        return out
    out.factHash = csgRelfactsCat(
        "sha256:", layout.FixedBytes32Hex(hash))
    out.ok = true
    return out

@borrows
fn csgRelfactsEventLine(
        ordinal: int32,
        operation: CsgCoreRelfactsOperation):
        csgRelfactsTextResult =
    if ordinal < 0:
        return csgRelfactsTextFail(
            "relfacts_ordinal_invalid")
    var opText: str
    if operation.kind == CsgRelfactsAssert:
        opText = "Assert"
    elif operation.kind == CsgRelfactsRetract:
        opText = "Retract"
    else:
        return csgRelfactsTextFail(
            "relfacts_operation_kind_invalid")

    let identity = csgRelfactsIdentity(operation.fact)
    if !identity.ok:
        return csgRelfactsTextFail(identity.error)
    var buf = layout.ByteBufInit(
        identity.canonicalFact.len + 256)
    var error: str
    csgRelfactsBufText(buf, "{\"fact\":")
    if !csgRelfactsBufQuoted(
            buf, identity.canonicalFact, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"fact_hash\":")
    if !csgRelfactsBufQuoted(
            buf, identity.factHash, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"fact_key\":")
    if !csgRelfactsBufQuoted(
            buf, identity.factKey, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"op\":")
    if !csgRelfactsBufQuoted(buf, opText, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    csgRelfactsBufText(buf, ",\"ordinal\":")
    csgRelfactsBufText(buf, strings.IntToStr(ordinal))
    csgRelfactsBufText(buf, ",\"schema\":")
    if !csgRelfactsBufQuoted(
            buf, CsgRelfactsSchema, error):
        layout.ByteBufFree(buf)
        return csgRelfactsTextFail(error)
    layout.ByteBufAppendByte(buf, int32('}'))
    return csgRelfactsFinishCanonicalLine(buf)

@borrows
fn csgRelfactsSplitStrict(
        text: str): csgRelfactsRecordIndexResult =
    var out: csgRelfactsRecordIndexResult
    if text.len == 0:
        out.error = "relfacts_sidecar_empty"
        return out
    if text[text.len - 1] != '\n':
        out.error = "relfacts_final_newline_missing"
        return out
    var start: int32
    for i in 0..<text.len:
        if text[i] == '\r':
            out.error = "relfacts_cr_forbidden"
            return out
        if text[i] == '\n':
            if i == start:
                out.error = "relfacts_blank_record"
                return out
            add(out.recordStarts, start)
            add(out.recordLengths, i - start)
            start = i + 1
    if start != text.len:
        out.error = "relfacts_split_incomplete"
        return out
    out.ok = true
    return out

@borrows
fn csgRelfactsCanonicalRecordError(line: str): str =
    let checked = canonical.CsgCoreJsonCanonicalize(line)
    if !checked.ok:
        return csgRelfactsCat(
            "relfacts_record_invalid ", checked.error)
    if checked.value != line:
        return "relfacts_record_noncanonical"
    return ""

@borrows
fn csgRelfactsHeaderError(
        line: str,
        beforeDag: merkle_dag.CsgCoreMerkleDag,
        afterDag: merkle_dag.CsgCoreMerkleDag,
        eventCount: int32): str =
    let canonicalError =
        csgRelfactsCanonicalRecordError(line)
    if canonicalError.len > 0:
        return canonicalError
    let expected = csgRelfactsHeaderLine(
        beforeDag, afterDag, eventCount)
    if !expected.ok:
        return expected.error

    let actualSchema =
        field.CsgCoreJsonTopStringField(line, "schema")
    if !actualSchema.found ||
       actualSchema.value != CsgRelfactsSchema:
        return "relfacts_schema_mismatch"
    let actualTransitionKind =
        field.CsgCoreJsonTopStringField(
            line, "transition_kind")
    if !actualTransitionKind.found ||
       actualTransitionKind.value !=
           CsgRelfactsTransitionKind:
        return "relfacts_transition_kind_mismatch"
    let beforeFactCount =
        field.CsgCoreJsonTopRawField(
            line, "before_fact_count")
    if !beforeFactCount.found ||
       beforeFactCount.value !=
           strings.IntToStr(beforeDag.factCount):
        return "relfacts_before_fact_count_mismatch"
    let afterFactCount =
        field.CsgCoreJsonTopRawField(
            line, "after_fact_count")
    if !afterFactCount.found ||
       afterFactCount.value !=
           strings.IntToStr(afterDag.factCount):
        return "relfacts_after_fact_count_mismatch"
    let beforeFactsRoot =
        field.CsgCoreJsonTopStringField(
            line, "before_facts_root")
    if !beforeFactsRoot.found ||
       beforeFactsRoot.value != beforeDag.factsRoot:
        return "relfacts_before_facts_root_mismatch"
    let afterFactsRoot =
        field.CsgCoreJsonTopStringField(
            line, "after_facts_root")
    if !afterFactsRoot.found ||
       afterFactsRoot.value != afterDag.factsRoot:
        return "relfacts_after_facts_root_mismatch"
    let beforeStandard =
        field.CsgCoreJsonTopStringField(
            line, "before_standard")
    if !beforeStandard.found ||
       beforeStandard.value != beforeDag.standard:
        return "relfacts_before_standard_mismatch"
    let afterStandard =
        field.CsgCoreJsonTopStringField(
            line, "after_standard")
    if !afterStandard.found ||
       afterStandard.value != afterDag.standard:
        return "relfacts_after_standard_mismatch"
    let expectedBeforeProfiles =
        csgRelfactsProfilesJson(beforeDag.profiles)
    if !expectedBeforeProfiles.ok:
        return expectedBeforeProfiles.error
    let actualBeforeProfiles =
        field.CsgCoreJsonTopRawField(
            line, "before_profiles")
    if !actualBeforeProfiles.found ||
       actualBeforeProfiles.value !=
           expectedBeforeProfiles.value:
        return "relfacts_before_profiles_mismatch"
    let expectedAfterProfiles =
        csgRelfactsProfilesJson(afterDag.profiles)
    if !expectedAfterProfiles.ok:
        return expectedAfterProfiles.error
    let actualAfterProfiles =
        field.CsgCoreJsonTopRawField(
            line, "after_profiles")
    if !actualAfterProfiles.found ||
       actualAfterProfiles.value !=
           expectedAfterProfiles.value:
        return "relfacts_after_profiles_mismatch"
    let beforeNamespace =
        field.CsgCoreJsonTopStringField(
            line, "before_schema_namespace")
    if !beforeNamespace.found ||
       beforeNamespace.value != beforeDag.schemaNamespace:
        return "relfacts_before_schema_namespace_mismatch"
    let afterNamespace =
        field.CsgCoreJsonTopStringField(
            line, "after_schema_namespace")
    if !afterNamespace.found ||
       afterNamespace.value != afterDag.schemaNamespace:
        return "relfacts_after_schema_namespace_mismatch"
    let beforeSchemaCid =
        field.CsgCoreJsonTopStringField(
            line, "before_schema_cid")
    if !beforeSchemaCid.found ||
       beforeSchemaCid.value != beforeDag.schemaCid:
        return "relfacts_before_schema_cid_mismatch"
    let afterSchemaCid =
        field.CsgCoreJsonTopStringField(
            line, "after_schema_cid")
    if !afterSchemaCid.found ||
       afterSchemaCid.value != afterDag.schemaCid:
        return "relfacts_after_schema_cid_mismatch"
    let actualEventCount =
        field.CsgCoreJsonTopRawField(line, "event_count")
    if !actualEventCount.found ||
       actualEventCount.value !=
           strings.IntToStr(eventCount):
        return "relfacts_event_count_mismatch"
    if line != expected.value:
        return "relfacts_header_shape_mismatch"
    return ""

@borrows
fn csgRelfactsParseEvent(
        line: str,
        expectedOrdinal: int32): csgRelfactsEvent =
    var out: csgRelfactsEvent
    let canonicalError =
        csgRelfactsCanonicalRecordError(line)
    if canonicalError.len > 0:
        out.error = strings.CloneStr(canonicalError)
        return out
    let schema =
        field.CsgCoreJsonTopStringField(line, "schema")
    if !schema.found || schema.value != CsgRelfactsSchema:
        out.error = "relfacts_schema_mismatch"
        return out
    let ordinal =
        field.CsgCoreJsonTopRawField(line, "ordinal")
    if !ordinal.found ||
       ordinal.value != strings.IntToStr(expectedOrdinal):
        out.error = "relfacts_ordinal_mismatch"
        return out
    let op = field.CsgCoreJsonTopStringField(line, "op")
    if !op.found:
        out.error = "relfacts_operation_missing"
        return out
    if op.value == "Assert":
        out.kind = CsgRelfactsAssert
    elif op.value == "Retract":
        out.kind = CsgRelfactsRetract
    else:
        out.error = "relfacts_operation_invalid"
        return out
    let factValue =
        field.CsgCoreJsonTopStringField(line, "fact")
    if !factValue.found || factValue.value.len == 0:
        out.error = "relfacts_fact_missing"
        return out
    let identity = csgRelfactsIdentity(factValue.value)
    if !identity.ok:
        out.error = strings.CloneStr(identity.error)
        return out
    if identity.canonicalFact != factValue.value:
        out.error = "relfacts_fact_noncanonical"
        return out
    let factKey =
        field.CsgCoreJsonTopStringField(line, "fact_key")
    if !factKey.found || factKey.value != identity.factKey:
        out.error = "relfacts_fact_key_mismatch"
        return out
    let factHash =
        field.CsgCoreJsonTopStringField(line, "fact_hash")
    if !factHash.found || factHash.value != identity.factHash:
        out.error = "relfacts_fact_hash_mismatch"
        return out
    var expectedOperation: CsgCoreRelfactsOperation
    expectedOperation.kind = out.kind
    expectedOperation.fact = strings.CloneStr(
        identity.canonicalFact)
    let expected = csgRelfactsEventLine(
        expectedOrdinal, expectedOperation)
    if !expected.ok:
        out.error = strings.CloneStr(expected.error)
        return out
    if line != expected.value:
        out.error = "relfacts_event_shape_mismatch"
        return out
    out.canonicalFact = strings.CloneStr(
        identity.canonicalFact)
    out.factKey = strings.CloneStr(identity.factKey)
    out.ok = true
    return out

@borrows
fn csgRelfactsDiffOperations(
        beforeFacts: str[],
        beforeKeys: str[],
        beforeRows: tables.Table[int32],
        afterFacts: str[],
        afterKeys: str[],
        afterRows: tables.Table[int32]):
        CsgCoreRelfactsOperation[] =
    var operations: CsgCoreRelfactsOperation[]
    for row in 0..<beforeFacts.len:
        var afterRow: int32
        let found = tables.TableTryGet[int32](
            afterRows, beforeKeys[row], afterRow)
        if !found || beforeFacts[row] != afterFacts[afterRow]:
            add(
                operations,
                CsgCoreRelfactsRetractOperation(
                    beforeFacts[row]))
    for row in 0..<afterFacts.len:
        var beforeRow: int32
        let found = tables.TableTryGet[int32](
            beforeRows, afterKeys[row], beforeRow)
        if !found || afterFacts[row] != beforeFacts[beforeRow]:
            add(
                operations,
                CsgCoreRelfactsAssertOperation(
                    afterFacts[row]))
    return operations

@borrows
fn csgRelfactsReplayCore(
        text: str,
        beforeCanonicalFacts: str[],
        afterCanonicalFacts: str[],
        beforeStandard: str,
        beforeProfiles: str[],
        beforeSchemaNamespace: str,
        beforeSchemaCid: str,
        afterStandard: str,
        afterProfiles: str[],
        afterSchemaNamespace: str,
        afterSchemaCid: str): CsgCoreRelfactsReplayResult =
    var beforeFacts: str[]
    var beforeKeys: str[]
    var beforeRows = tables.TableInit[int32](64)
    var afterFacts: str[]
    var afterKeys: str[]
    var afterRows = tables.TableInit[int32](64)
    var indexError: str
    if !csgRelfactsBuildCanonicalIndex(
            beforeCanonicalFacts,
            "before",
            beforeFacts,
            beforeKeys,
            beforeRows,
            indexError):
        return csgRelfactsReplayFail(indexError)
    if !csgRelfactsBuildCanonicalIndex(
            afterCanonicalFacts,
            "after",
            afterFacts,
            afterKeys,
            afterRows,
            indexError):
        return csgRelfactsReplayFail(indexError)
    let expectedOperations = csgRelfactsDiffOperations(
        beforeFacts,
        beforeKeys,
        beforeRows,
        afterFacts,
        afterKeys,
        afterRows)
    var beforeDag: merkle_dag.CsgCoreMerkleDag
    let beforeAdmission =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            beforeFacts, beforeDag)
    if !beforeAdmission.valid ||
       !beforeAdmission.complete ||
       !beforeDag.ok:
        return csgRelfactsReplayFail(
            "relfacts_before_production_admission_failed")
    if beforeStandard != beforeAdmission.standard ||
       !validator.CsgCoreProfilesEqual(
           beforeProfiles, beforeAdmission.profiles) ||
       beforeSchemaNamespace !=
           beforeAdmission.schemaNamespace ||
       beforeSchemaCid != beforeDag.schemaCid:
        return csgRelfactsReplayFail(
            "relfacts_before_binding_mismatch")
    var afterDag: merkle_dag.CsgCoreMerkleDag
    let afterAdmission =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            afterFacts, afterDag)
    if !afterAdmission.valid ||
       !afterAdmission.complete ||
       !afterDag.ok:
        return csgRelfactsReplayFail(
            "relfacts_after_production_admission_failed")
    if afterStandard != afterAdmission.standard ||
       !validator.CsgCoreProfilesEqual(
           afterProfiles, afterAdmission.profiles) ||
       afterSchemaNamespace !=
           afterAdmission.schemaNamespace ||
       afterSchemaCid != afterDag.schemaCid:
        return csgRelfactsReplayFail(
            "relfacts_after_binding_mismatch")
    if expectedOperations.len == 2 &&
       expectedOperations[0].kind == CsgRelfactsRetract &&
       expectedOperations[1].kind == CsgRelfactsAssert:
        var beforeKeyError: str
        let replacedBeforeKey =
            merkle_dag.CsgCoreMerkleFactKey(
                expectedOperations[0].fact,
                beforeKeyError)
        var afterKeyError: str
        let replacedAfterKey =
            merkle_dag.CsgCoreMerkleFactKey(
                expectedOperations[1].fact,
                afterKeyError)
        let beforeKind = field.CsgCoreJsonKind(
            expectedOperations[0].fact)
        let afterKind = field.CsgCoreJsonKind(
            expectedOperations[1].fact)
        if beforeKeyError.len > 0 ||
           afterKeyError.len > 0 ||
           replacedBeforeKey != replacedAfterKey ||
           !beforeKind.found || !afterKind.found ||
           beforeKind.value != afterKind.value:
            return csgRelfactsReplayFail(
                "relfacts_replace_identity_mismatch")
        let validated =
            merkle_admission.CsgCoreMerkleValidateLocalNamedReplace(
                beforeFacts,
                expectedOperations[1].fact,
                replacedBeforeKey)
        let exact = validated.ok &&
            validated.beforeFactsRoot == beforeDag.factsRoot &&
            validated.beforeDagRootCid == beforeDag.dagRootCid &&
            validated.afterFactsRoot == afterDag.factsRoot &&
            validated.afterDagRootCid == afterDag.dagRootCid &&
            validated.afterFactCount == afterDag.factCount
        if !exact:
            return csgRelfactsReplayFail(
                "relfacts_sealed_replay_mismatch")
    if expectedOperations.len == 0 &&
       beforeDag.factsRoot != afterDag.factsRoot:
        return csgRelfactsReplayFail(
            "relfacts_binding_only_transition_forbidden")
    let split = csgRelfactsSplitStrict(text)
    if !split.ok:
        return csgRelfactsReplayFail(split.error)
    if split.recordStarts.len < 1 ||
       split.recordStarts.len !=
           split.recordLengths.len:
        return csgRelfactsReplayFail(
            "relfacts_header_missing")
    let headerLine = strings.CloneStrRange(
        text,
        split.recordStarts[0],
        split.recordLengths[0])
    let headerError = csgRelfactsHeaderError(
        headerLine,
        beforeDag,
        afterDag,
        expectedOperations.len)
    if headerError.len > 0:
        return csgRelfactsReplayFail(headerError)
    if split.recordStarts.len - 1 !=
       expectedOperations.len:
        return csgRelfactsReplayFail(
            "relfacts_event_count_mismatch")

    var rowByKey = beforeRows
    var facts = beforeFacts
    var keys = beforeKeys
    var active: bool[]
    for row in 0..<facts.len:
        add(active, true)
    var assertCount: int32
    var retractCount: int32
    for lineIndex in 1..<split.recordStarts.len:
        let ordinal = lineIndex - 1
        let line = strings.CloneStrRange(
            text,
            split.recordStarts[lineIndex],
            split.recordLengths[lineIndex])
        let event = csgRelfactsParseEvent(
            line, ordinal)
        if !event.ok:
            return csgRelfactsReplayFail(
                csgRelfactsAt(ordinal, event.error))
        let expectedOperation = expectedOperations[ordinal]
        if event.kind != expectedOperation.kind ||
           event.canonicalFact != expectedOperation.fact:
            return csgRelfactsReplayFail(
                csgRelfactsAt(
                    ordinal,
                    "relfacts_deterministic_diff_mismatch"))
        var previousRow: int32
        let found = tables.TableTryGet[int32](
            rowByKey, event.factKey, previousRow)
        if found &&
           (previousRow < 0 ||
            previousRow >= facts.len ||
            keys[previousRow] != event.factKey):
            return csgRelfactsReplayFail(
                csgRelfactsAt(
                    ordinal,
                    "relfacts_index_corrupt"))
        if event.kind == CsgRelfactsAssert:
            if found && active[previousRow]:
                return csgRelfactsReplayFail(
                    csgRelfactsAt(
                        ordinal,
                        csgRelfactsCat(
                            "relfacts_duplicate_assert ",
                            event.factKey)))
            if found:
                facts[previousRow] = strings.CloneStr(
                    event.canonicalFact)
                active[previousRow] = true
            else:
                let newRow = facts.len
                add(facts, strings.CloneStr(
                    event.canonicalFact))
                add(keys, strings.CloneStr(event.factKey))
                add(active, true)
                let beforeTableLen =
                    tables.TableLen[int32](rowByKey)
                tables.TablePut[int32](
                    rowByKey, strings.CloneStr(event.factKey), newRow)
                var committedRow: int32
                if !tables.TableTryGet[int32](
                        rowByKey,
                        event.factKey,
                        committedRow) ||
                   committedRow != newRow:
                    return csgRelfactsReplayFail(
                        csgRelfactsAt(
                            ordinal,
                            "relfacts_index_commit_failed"))
                let afterTableLen =
                    tables.TableLen[int32](rowByKey)
                if afterTableLen != beforeTableLen + 1:
                    return csgRelfactsReplayFail(
                        csgRelfactsAt(
                            ordinal,
                            "relfacts_index_count_mismatch"))
            assertCount = assertCount + 1
        elif event.kind == CsgRelfactsRetract:
            if !found || !active[previousRow]:
                return csgRelfactsReplayFail(
                    csgRelfactsAt(
                        ordinal,
                        csgRelfactsCat(
                            "relfacts_retract_missing ",
                            event.factKey)))
            if facts[previousRow] != event.canonicalFact:
                return csgRelfactsReplayFail(
                    csgRelfactsAt(
                        ordinal,
                        csgRelfactsCat(
                            "relfacts_retract_fact_mismatch ",
                            event.factKey)))
            active[previousRow] = false
            retractCount = retractCount + 1
        else:
            return csgRelfactsReplayFail(
                csgRelfactsAt(
                    ordinal,
                    "relfacts_operation_state_invalid"))
    var finalFacts: str[]
    for row in 0..<facts.len:
        if active[row]:
            add(finalFacts, strings.CloneStr(facts[row]))
    let physicalOrder =
        merkle_dag.CsgCoreMerklePhysicalOrder(finalFacts)
    if !physicalOrder.ok:
        return csgRelfactsReplayFail(
            csgRelfactsCat(
                "relfacts_physical_order_failed ",
                physicalOrder.error))
    let finalDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            physicalOrder.canonicalLines,
            afterStandard,
            afterProfiles,
            afterSchemaNamespace,
            afterSchemaCid)
    if !finalDag.ok:
        return csgRelfactsReplayFail(
            csgRelfactsCat(
                "relfacts_unique_root_failed ",
                finalDag.error))
    if finalDag.factCount != afterDag.factCount ||
       finalDag.dagRootCid != afterDag.dagRootCid ||
       finalDag.subgraphCid != afterDag.subgraphCid ||
       finalDag.factsRoot != afterDag.factsRoot ||
       physicalOrder.canonicalLines.len != afterFacts.len:
        return csgRelfactsReplayFail(
            "relfacts_after_facts_root_mismatch")
    for row in 0..<physicalOrder.canonicalLines.len:
        if physicalOrder.canonicalLines[row] != afterFacts[row]:
            return csgRelfactsReplayFail(
                "relfacts_after_facts_set_mismatch")
    var out: CsgCoreRelfactsReplayResult
    out.ok = true
    out.eventCount = split.recordStarts.len - 1
    out.assertCount = assertCount
    out.retractCount = retractCount
    out.beforeFactCount = beforeDag.factCount
    out.afterFactCount = finalDag.factCount
    out.finalCanonicalFacts =
        physicalOrder.canonicalLines
    out.beforeDagRootCid = strings.CloneStr(
        beforeDag.dagRootCid)
    out.afterDagRootCid = strings.CloneStr(
        finalDag.dagRootCid)
    out.beforeSubgraphCid = strings.CloneStr(
        beforeDag.subgraphCid)
    out.afterSubgraphCid = strings.CloneStr(
        finalDag.subgraphCid)
    out.beforeFactsRoot = strings.CloneStr(
        beforeDag.factsRoot)
    out.afterFactsRoot = strings.CloneStr(
        afterDag.factsRoot)
    out.transitionKind = CsgRelfactsTransitionKind
    out.verifiedAgainstBeforeFacts = true
    out.verifiedAgainstAfterFacts = true
    return out

fn CsgCoreRelfactsSchema(): str =
    return CsgRelfactsSchema

fn CsgCoreRelfactsTransitionKind(): str =
    return CsgRelfactsTransitionKind

@borrows
fn CsgCoreRelfactsAssertOperation(
        fact: str): CsgCoreRelfactsOperation =
    var out: CsgCoreRelfactsOperation
    out.kind = CsgRelfactsAssert
    out.fact = strings.CloneStr(fact)
    return out

@borrows
fn CsgCoreRelfactsRetractOperation(
        fact: str): CsgCoreRelfactsOperation =
    var out: CsgCoreRelfactsOperation
    out.kind = CsgRelfactsRetract
    out.fact = strings.CloneStr(fact)
    return out

@borrows
fn CsgCoreRelfactsEncode(
        operations: CsgCoreRelfactsOperation[],
        beforeCanonicalFacts: str[],
        afterCanonicalFacts: str[],
        beforeStandard: str,
        beforeProfiles: str[],
        beforeSchemaNamespace: str,
        beforeSchemaCid: str,
        afterStandard: str,
        afterProfiles: str[],
        afterSchemaNamespace: str,
        afterSchemaCid: str): CsgCoreRelfactsEncodeResult =
    var out: CsgCoreRelfactsEncodeResult
    let beforeDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            beforeCanonicalFacts,
            beforeStandard,
            beforeProfiles,
            beforeSchemaNamespace,
            beforeSchemaCid)
    if !beforeDag.ok:
        out.error = csgRelfactsCat(
            "relfacts_before_root_failed ",
            beforeDag.error)
        return out
    let afterDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            afterCanonicalFacts,
            afterStandard,
            afterProfiles,
            afterSchemaNamespace,
            afterSchemaCid)
    if !afterDag.ok:
        out.error = csgRelfactsCat(
            "relfacts_after_root_failed ",
            afterDag.error)
        return out
    let header = csgRelfactsHeaderLine(
        beforeDag,
        afterDag,
        operations.len)
    if !header.ok:
        out.error = strings.CloneStr(header.error)
        return out
    var buf = layout.ByteBufInit(4096)
    csgRelfactsBufText(buf, header.value)
    layout.ByteBufAppendByte(buf, int32('\n'))
    for ordinal in 0..<operations.len:
        let line = csgRelfactsEventLine(
            ordinal, operations[ordinal])
        if !line.ok:
            layout.ByteBufFree(buf)
            out.error = csgRelfactsAt(
                ordinal, line.error)
            return out
        csgRelfactsBufText(buf, line.value)
        layout.ByteBufAppendByte(buf, int32('\n'))
    let text = csgRelfactsFinishText(buf)
    if !text.ok:
        out.error = strings.CloneStr(text.error)
        return out
    let replay = csgRelfactsReplayCore(
        text.value,
        beforeCanonicalFacts,
        afterCanonicalFacts,
        beforeStandard,
        beforeProfiles,
        beforeSchemaNamespace,
        beforeSchemaCid,
        afterStandard,
        afterProfiles,
        afterSchemaNamespace,
        afterSchemaCid)
    if !replay.ok:
        out.error = csgRelfactsCat(
            "relfacts_encode_replay_failed ",
            replay.error)
        return out
    out.ok = true
    out.text = strings.CloneStr(text.value)
    out.replay = replay
    return out

@borrows
fn CsgCoreRelfactsReplayCanonicalTransition(
        text: str,
        beforeCanonicalFacts: str[],
        afterCanonicalFacts: str[],
        beforeStandard: str,
        beforeProfiles: str[],
        beforeSchemaNamespace: str,
        beforeSchemaCid: str,
        afterStandard: str,
        afterProfiles: str[],
        afterSchemaNamespace: str,
        afterSchemaCid: str): CsgCoreRelfactsReplayResult =
    return csgRelfactsReplayCore(
        text,
        beforeCanonicalFacts,
        afterCanonicalFacts,
        beforeStandard,
        beforeProfiles,
        beforeSchemaNamespace,
        beforeSchemaCid,
        afterStandard,
        afterProfiles,
        afterSchemaNamespace,
        afterSchemaCid)

@borrows
fn csgRelfactsBuildCanonicalIndex(
        inputFacts: str[],
        side: str,
        orderedFacts: var str[],
        keys: var str[],
        rowByKey: var tables.Table[int32],
        error: var str): bool =
    if inputFacts.len == 0:
        return true
    for i in 0..<inputFacts.len:
        if inputFacts[i].len == 0:
            error = csgRelfactsCat(
                csgRelfactsCat("relfacts_", side),
                "_facts_empty_line")
            return false
        var canonicalError: str
        let canonicalFact =
            merkle_dag.CsgCoreMerkleCanonicalFact(
                inputFacts[i], canonicalError)
        if canonicalError.len > 0:
            error = csgRelfactsCat(
                csgRelfactsCat(
                    csgRelfactsCat("relfacts_", side),
                    "_facts_invalid "),
                canonicalError)
            return false
        if canonicalFact != inputFacts[i]:
            error = csgRelfactsCat(
                csgRelfactsCat("relfacts_", side),
                "_facts_noncanonical")
            return false
    let physicalOrder =
        merkle_dag.CsgCoreMerklePhysicalOrder(inputFacts)
    if !physicalOrder.ok:
        error = csgRelfactsCat(
            csgRelfactsCat(
                csgRelfactsCat("relfacts_", side),
                "_facts_order_failed "),
            physicalOrder.error)
        return false
    orderedFacts = physicalOrder.canonicalLines
    for row in 0..<orderedFacts.len:
        let identity = csgRelfactsIdentity(orderedFacts[row])
        if !identity.ok:
            error = csgRelfactsCat(
                csgRelfactsCat(
                    csgRelfactsCat("relfacts_", side),
                    "_facts_identity_failed "),
                identity.error)
            return false
        var existingRow: int32
        if tables.TableTryGet[int32](
                rowByKey, identity.factKey, existingRow):
            error = csgRelfactsCat(
                csgRelfactsCat(
                    csgRelfactsCat("relfacts_", side),
                    "_facts_duplicate_key "),
                identity.factKey)
            return false
        let beforeLen = tables.TableLen[int32](rowByKey)
        tables.TablePut[int32](
            rowByKey, strings.CloneStr(identity.factKey), row)
        var committedRow: int32
        if !tables.TableTryGet[int32](
                rowByKey,
                identity.factKey,
                committedRow) ||
           committedRow != row ||
           tables.TableLen[int32](rowByKey) != beforeLen + 1:
            error = csgRelfactsCat(
                csgRelfactsCat("relfacts_", side),
                "_facts_index_commit_failed")
            return false
        add(keys, strings.CloneStr(identity.factKey))
    return true

@borrows
fn CsgCoreRelfactsEncodeCanonicalTransition(
        beforeCanonicalFacts: str[],
        afterCanonicalFacts: str[],
        beforeStandard: str,
        beforeProfiles: str[],
        beforeSchemaNamespace: str,
        beforeSchemaCid: str,
        afterStandard: str,
        afterProfiles: str[],
        afterSchemaNamespace: str,
        afterSchemaCid: str): CsgCoreRelfactsEncodeResult =
    var beforeFacts: str[]
    var beforeKeys: str[]
    var beforeRows = tables.TableInit[int32](64)
    var afterFacts: str[]
    var afterKeys: str[]
    var afterRows = tables.TableInit[int32](64)
    var error: str
    if !csgRelfactsBuildCanonicalIndex(
            beforeCanonicalFacts,
            "before",
            beforeFacts,
            beforeKeys,
            beforeRows,
            error):
        var failed: CsgCoreRelfactsEncodeResult
        failed.error = strings.CloneStr(error)
        return failed
    if !csgRelfactsBuildCanonicalIndex(
            afterCanonicalFacts,
            "after",
            afterFacts,
            afterKeys,
            afterRows,
            error):
        var failed: CsgCoreRelfactsEncodeResult
        failed.error = strings.CloneStr(error)
        return failed

    let operations = csgRelfactsDiffOperations(
        beforeFacts,
        beforeKeys,
        beforeRows,
        afterFacts,
        afterKeys,
        afterRows)

    var encoded = CsgCoreRelfactsEncode(
        operations,
        beforeFacts,
        afterFacts,
        beforeStandard,
        beforeProfiles,
        beforeSchemaNamespace,
        beforeSchemaCid,
        afterStandard,
        afterProfiles,
        afterSchemaNamespace,
        afterSchemaCid)
    if !encoded.ok:
        return encoded
    if !encoded.replay.verifiedAgainstBeforeFacts ||
       !encoded.replay.verifiedAgainstAfterFacts:
        var failed: CsgCoreRelfactsEncodeResult
        failed.error = "relfacts_transition_verify_failed"
        return failed
    return encoded
