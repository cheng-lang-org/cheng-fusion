        session: CsgCoreMerklePrepublishSession
        finalManifestCid: str
        projectionReceiptCid: str
        transactionReceiptCid: str

    CsgCoreMerkleTransactionArtifactCommitResult =
        ok: bool
        error: str
        complete: bool
        nextOrdinal: int32
        artifactCount: int32
        objectWriteCount: int32
        artifactKind: int32
        cid: str
        reused: bool
        writtenBytes: int64

    CsgCoreMerkleTransactionCommitSessionResult =
        ok: bool
        error: str
        finalManifestCid: str
        transactionReceiptCid: str
        headCid: str


    csgTransactionAuthorityObjectWriteResult =
        ok: bool
        error: str
        reused: bool

    csgTransactionAuthorityHeadCanonicalInput =
        ok: bool
        error: str
        storeGeneration: int64
        finalManifestCid: layout.FixedBytes32
        transactionReceiptCid: layout.FixedBytes32
        headCid: layout.FixedBytes32
        head: merkle_store_codec.CsgCoreMerkleStoreHeadIdentity
        headBytes: rawbytes.Bytes

    csgTransactionAuthorityHeadPhysicalResult =
        ok: bool
        error: str

    csgTransactionAuthorityArtifactArenaOwner =
        store: phase.PhaseArenaStore
        arena: phase.PhaseArenaHandle
        kinds: phase.PhaseArenaRef
        cidDigests: phase.PhaseArenaRef
        byteOffsets: phase.PhaseArenaRef
        byteLengths: phase.PhaseArenaRef
        bytes: phase.PhaseArenaRef
        artifactCount: int32
        totalObjectBytes: int32

    csgTransactionAuthorityPreparedArtifacts =
        ok: bool
        error: str
        owner: csgTransactionAuthorityArtifactArenaOwner
        projectionReceiptCid: str
        finalManifestCid: str
        transactionReceiptCid: str
        finalManifestOrdinal: int32
        transactionReceiptOrdinal: int32

    csgTransactionAuthorityRegistryStorage =
        store: phase.PhaseArenaStore
        arena: phase.PhaseArenaHandle
        states: phase.PhaseArenaRef
        epochs: phase.PhaseArenaRef
        kinds: phase.PhaseArenaRef
        nextArtifactOrdinals: phase.PhaseArenaRef
        artifactCounts: phase.PhaseArenaRef
        objectWriteCounts: phase.PhaseArenaRef
        pathAuthorityOwnerIds: phase.PhaseArenaRef
        pathAuthorityGenerations: phase.PhaseArenaRef
        finalManifestOrdinals: phase.PhaseArenaRef
        transactionReceiptOrdinals: phase.PhaseArenaRef
        mappedCompletionOwnerIds: phase.PhaseArenaRef
        mappedCompletionGenerations: phase.PhaseArenaRef
        sealedBeforeOwnerIds: phase.PhaseArenaRef
        sealedBeforeGenerations: phase.PhaseArenaRef
        sealedBeforeKinds: phase.PhaseArenaRef
        beforeStoreGenerationLow: phase.PhaseArenaRef
        beforeStoreGenerationHigh: phase.PhaseArenaRef
        authenticators: phase.PhaseArenaRef
        semanticFingerprints: phase.PhaseArenaRef
        semanticPlanRoots: phase.PhaseArenaRef
        projectionReceiptCids: phase.PhaseArenaRef
        finalManifestCids: phase.PhaseArenaRef
        transactionReceiptCids: phase.PhaseArenaRef
        pathAuthorityLineageBindings: phase.PhaseArenaRef
        pathAuthorityStageNonces: phase.PhaseArenaRef
        artifactClaimAuthenticators: phase.PhaseArenaRef
        mappedCompletionNonces: phase.PhaseArenaRef
        mappedCompletionBindings: phase.PhaseArenaRef
        sealedBeforeAuthenticators: phase.PhaseArenaRef
        sealedBeforeBindings: phase.PhaseArenaRef
        beforeStoreIdentities: phase.PhaseArenaRef
        beforeHeadCids: phase.PhaseArenaRef
        beforeManifestCids: phase.PhaseArenaRef
        beforeFactsRoots: phase.PhaseArenaRef
        artifactOwners: csgTransactionAuthorityArtifactArenaOwner[]

var
    csgTransactionAuthorityRegistryState: int32
    csgTransactionAuthorityRegistry:
        csgTransactionAuthorityRegistryStorage

@borrows
fn csgTransactionAuthorityCat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

fn csgTransactionAuthorityAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgTransactionAuthorityAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgTransactionAuthorityAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

fn csgTransactionAuthorityDigestText(
        out: var layout.ByteBuf): str =
    let digest = hash256.Sha256Fixed(layout.ByteBufView(out))
    layout.ByteBufFree(out)
    return csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgTransactionAuthoritySemanticCarrierCid(
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate): str =
    var preimage = layout.ByteBufInit(4096)
    csgTransactionAuthorityAppendText(
        preimage, csgTransactionSemanticCarrierDomain)
    csgTransactionAuthorityAppendText(preimage, candidate.queryKey)
    csgTransactionAuthorityAppendText(preimage, candidate.beforeFact)
    csgTransactionAuthorityAppendText(preimage, candidate.afterFact)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeBinding.standard)
    csgTransactionAuthorityAppendText(
        preimage,
        strings.IntToStr(candidate.replay.beforeBinding.profiles.len))
    for i in 0..<candidate.replay.beforeBinding.profiles.len:
        csgTransactionAuthorityAppendText(
            preimage, candidate.replay.beforeBinding.profiles[i])
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeBinding.profileSetCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeBinding.schemaNamespace)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeBinding.schemaCid)
    csgTransactionAuthorityAppendText(
        preimage,
        candidate.replay.beforeBinding.bindingIdentityReceiptCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterBinding.standard)
    csgTransactionAuthorityAppendText(
        preimage,
        strings.IntToStr(candidate.replay.afterBinding.profiles.len))
    for i in 0..<candidate.replay.afterBinding.profiles.len:
        csgTransactionAuthorityAppendText(
            preimage, candidate.replay.afterBinding.profiles[i])
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterBinding.profileSetCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterBinding.schemaNamespace)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterBinding.schemaCid)
    csgTransactionAuthorityAppendText(
        preimage,
        candidate.replay.afterBinding.bindingIdentityReceiptCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeDagRootCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterDagRootCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeSubgraphCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterSubgraphCid)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.beforeFactsRoot)
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.afterFactsRoot)
    csgTransactionAuthorityAppendText(
        preimage, strings.IntToStr(candidate.replay.beforeCount))
    csgTransactionAuthorityAppendText(
        preimage, strings.IntToStr(candidate.replay.afterCount))
    csgTransactionAuthorityAppendText(
        preimage, candidate.replay.canonicalFact)
    csgTransactionAuthorityAppendText(
        preimage, layout.FixedBytes32Hex(candidate.replay.factHash))
    csgTransactionAuthorityAppendText(
        preimage,
        strings.Int64ToStr(candidate.replay.rebuiltNodeCount))
    csgTransactionAuthorityAppendText(
        preimage,
        strings.Int64ToStr(candidate.replay.reusedNodeCount))
    csgTransactionAuthorityAppendText(
        preimage, strings.IntToStr(candidate.replay.nodes.len))
    for i in 0..<candidate.replay.nodes.len:
        csgTransactionAuthorityAppendText(
            preimage,
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                candidate.replay.nodes[i]))
    return csgTransactionAuthorityDigestText(preimage)

@borrows
fn CsgCoreMerkleTransactionSemanticCarrierCid(
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate): str =
    return csgTransactionAuthoritySemanticCarrierCid(candidate)

@borrows
fn csgTransactionAuthoritySemanticFail(
        error: str): CsgCoreMerkleTransactionSemanticVerifyResult =
    var out: CsgCoreMerkleTransactionSemanticVerifyResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthoritySameTexts(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn CsgCoreMerkleTransactionAuthorityVerifyInMemory(
        input: CsgCoreMerkleTransactionSemanticInput,
        semanticPlan: request.CsgCoreMerkleSemanticPlan,
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate):
        CsgCoreMerkleTransactionSemanticVerifyResult =
    if !candidate.replay.ok || !candidate.proof.ok ||
       candidate.replacementCount != 1:
        return csgTransactionAuthoritySemanticFail(
            "merkle_transaction_authority_admission_invalid")
    var requestIdentity =
        request.CsgCoreMerkleTransactionRequestCid(input.request)
    let requestMatches = requestIdentity.ok &&
        requestIdentity.requestCid == semanticPlan.requestCid
    request.CsgCoreMerkleTransactionRequestCidFree(requestIdentity)
    if !requestMatches:
        return csgTransactionAuthoritySemanticFail(
            "merkle_transaction_authority_request_mismatch")
    let operationError =
        operation.CsgCoreMerkleTransactionOperationError(
            input.operation)
    if operationError.len > 0:
        return csgTransactionAuthoritySemanticFail(operationError)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           input.operationCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           input.proofCid) ||
       input.operation.proofCid != input.proofCid ||
       input.operation.queryKey != candidate.queryKey ||
       input.operation.beforeFact != candidate.beforeFact ||
       input.operation.afterFact != candidate.afterFact ||
       input.operation.beforeFactsRoot !=
           candidate.replay.beforeFactsRoot ||
       input.operation.afterFactsRoot !=
           candidate.replay.afterFactsRoot ||
       input.operation.beforeDagRootCid !=
           candidate.replay.beforeDagRootCid ||
       input.operation.afterDagRootCid !=
           candidate.replay.afterDagRootCid ||
       input.operation.beforeFactCount != candidate.replay.beforeCount ||
       input.operation.afterFactCount != candidate.replay.afterCount ||
       !csgTransactionAuthoritySameTexts(
           input.operation.beforeProfiles,
           candidate.replay.beforeBinding.profiles) ||
       !csgTransactionAuthoritySameTexts(
           input.operation.afterProfiles,
           candidate.replay.afterBinding.profiles) ||
       input.operation.beforeProfileSetCid !=
           candidate.replay.beforeBinding.profileSetCid ||
       input.operation.afterProfileSetCid !=
           candidate.replay.afterBinding.profileSetCid:
        return csgTransactionAuthoritySemanticFail(
            "merkle_transaction_authority_operation_mismatch")
    let skeletonError =
        merkle_manifest.CsgCoreMerkleSemanticManifestSkeletonError(
            input.skeleton)
    if skeletonError.len > 0:
        return csgTransactionAuthoritySemanticFail(skeletonError)
    if input.skeleton.standard !=
           candidate.replay.afterBinding.standard ||
       !csgTransactionAuthoritySameTexts(
           input.skeleton.profiles,
           candidate.replay.afterBinding.profiles) ||
       input.skeleton.factsRoot != candidate.replay.afterFactsRoot ||
       input.skeleton.dagRootCid != candidate.replay.afterDagRootCid ||
       input.skeleton.factCount != candidate.replay.afterCount ||
       input.skeleton.profileSetCid !=
           candidate.replay.afterBinding.profileSetCid ||
       input.skeleton.schemaCid !=
           candidate.replay.afterBinding.schemaCid:
        return csgTransactionAuthoritySemanticFail(
            "merkle_transaction_authority_skeleton_mismatch")
    let skeletonCid =
        merkle_manifest.CsgCoreMerkleSemanticManifestSkeletonCid(
            input.skeleton)
    let carrierCid =
        csgTransactionAuthoritySemanticCarrierCid(candidate)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(skeletonCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(carrierCid) ||
       semanticPlan.semanticManifestSkeletonCid != skeletonCid ||
       semanticPlan.semanticCarrierCid != carrierCid ||
       semanticPlan.operationCid != input.operationCid ||
       semanticPlan.proofCid != input.proofCid:
        return csgTransactionAuthoritySemanticFail(
            "merkle_transaction_authority_plan_binding_mismatch")
    let planRoot =
        request.CsgCoreMerkleSemanticPlanRoot(semanticPlan)
    if !planRoot.ok:
        return csgTransactionAuthoritySemanticFail(planRoot.error)
    var out: CsgCoreMerkleTransactionSemanticVerifyResult
    out.ok = true
    out.semanticCarrierCid = strings.CloneStr(carrierCid)
    out.semanticManifestSkeletonCid = strings.CloneStr(skeletonCid)
    out.semanticPlanRoot = strings.CloneStr(planRoot.planRoot)
    return out

fn csgTransactionAuthorityLock() =
    os.CsgTransactionAuthorityRegistryLock()

fn csgTransactionAuthorityUnlock() =
    os.CsgTransactionAuthorityRegistryUnlock()

fn csgTransactionAuthorityRefMatches(
        value: phase.PhaseArenaRef,
        arena: phase.PhaseArenaHandle): bool =
    return phase.PhaseArenaRefIsValid(value) &&
        value.arenaId == arena.arenaId &&
        value.generation == arena.generation

fn csgTransactionAuthorityRegistryShapeValid(): bool =
    let arena = csgTransactionAuthorityRegistry.arena
    return csgTransactionAuthorityRegistryState ==
               csgTransactionAuthorityRegistryReady &&
        phase.PhaseArenaHandleIsValid(arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.states, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.epochs, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.kinds, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.nextArtifactOrdinals, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.artifactCounts, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.objectWriteCounts, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.pathAuthorityOwnerIds, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.pathAuthorityGenerations,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.finalManifestOrdinals,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.transactionReceiptOrdinals,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.mappedCompletionOwnerIds,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.mappedCompletionGenerations,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.sealedBeforeOwnerIds,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.sealedBeforeGenerations,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.sealedBeforeKinds,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.beforeStoreGenerationLow,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.beforeStoreGenerationHigh,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.authenticators, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.semanticFingerprints, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.semanticPlanRoots, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.projectionReceiptCids, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.finalManifestCids, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.transactionReceiptCids, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.pathAuthorityStageNonces,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.artifactClaimAuthenticators,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.mappedCompletionNonces,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.mappedCompletionBindings,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.sealedBeforeAuthenticators,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.sealedBeforeBindings,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.beforeStoreIdentities,
            arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.beforeHeadCids, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.beforeManifestCids, arena) &&
        csgTransactionAuthorityRefMatches(
            csgTransactionAuthorityRegistry.beforeFactsRoots, arena) &&
        csgTransactionAuthorityRegistry.artifactOwners.len ==
            csgTransactionAuthorityRegistrySlotCount

fn csgTransactionAuthorityRegistryBuild(
        out: var csgTransactionAuthorityRegistryStorage) =
    phase.PhaseArenaStoreInit(
        out.store,
        1,
        csgTransactionAuthorityRegistryPayloadBytes,
        csgTransactionAuthorityRegistryAllocationCount)
    out.arena = phase.PhaseArenaStoreOpenArena(
        out.store,
        1,
        csgTransactionAuthorityRegistryPayloadBytes,
        csgTransactionAuthorityRegistryAllocationCount)
    out.states = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.epochs = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.kinds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.nextArtifactOrdinals = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.artifactCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.objectWriteCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.pathAuthorityOwnerIds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.pathAuthorityGenerations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.finalManifestOrdinals = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.transactionReceiptOrdinals =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgTransactionAuthorityRegistrySlotCount)
    out.mappedCompletionOwnerIds =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgTransactionAuthorityRegistrySlotCount)
    out.mappedCompletionGenerations =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgTransactionAuthorityRegistrySlotCount)
    out.sealedBeforeOwnerIds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.sealedBeforeGenerations =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgTransactionAuthorityRegistrySlotCount)
    out.sealedBeforeKinds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgTransactionAuthorityRegistrySlotCount)
    out.beforeStoreGenerationLow =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgTransactionAuthorityRegistrySlotCount)
    out.beforeStoreGenerationHigh =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgTransactionAuthorityRegistrySlotCount)
    let fixedBytes =
        csgTransactionAuthorityRegistrySlotCount *
        layout.FixedBytes32Size
    out.authenticators = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.semanticFingerprints = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.semanticPlanRoots = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.projectionReceiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.finalManifestCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.transactionReceiptCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.pathAuthorityLineageBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.pathAuthorityStageNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.artifactClaimAuthenticators =
        phase.PhaseArenaStoreAllocRefAligned(
            out.store, out.arena, fixedBytes, 8)
    out.mappedCompletionNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.mappedCompletionBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.sealedBeforeAuthenticators =
        phase.PhaseArenaStoreAllocRefAligned(
            out.store, out.arena, fixedBytes, 8)
    out.sealedBeforeBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.beforeStoreIdentities = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.beforeHeadCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.beforeManifestCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.beforeFactsRoots = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    setLen(
        out.artifactOwners,
        csgTransactionAuthorityRegistrySlotCount)
    let report = phase.PhaseArenaStoreArenaReport(out.store, out.arena)
    if report.usedBytes != csgTransactionAuthorityRegistryPayloadBytes ||
       report.allocationCount !=
           csgTransactionAuthorityRegistryAllocationCount ||
       report.spillCount != 0:
        panic("merkle transaction authority: registry layout drift")

fn csgTransactionAuthorityEnsureRegistry() =
    var builder: bool
    while !builder:
        csgTransactionAuthorityLock()
        let observed = csgTransactionAuthorityRegistryState
        if observed == csgTransactionAuthorityRegistryReady:
            csgTransactionAuthorityUnlock()
            return
        if observed == csgTransactionAuthorityRegistryFailed:
            csgTransactionAuthorityUnlock()
            panic("merkle transaction authority: registry failed")
        if observed == csgTransactionAuthorityRegistryEmpty:
            csgTransactionAuthorityRegistryState =
                csgTransactionAuthorityRegistryBuilding
            builder = true
            csgTransactionAuthorityUnlock()
        elif observed == csgTransactionAuthorityRegistryBuilding:
            let observedEpoch =
                os.CsgTransactionAuthorityRegistryEpoch()
            csgTransactionAuthorityUnlock()
            os.CsgTransactionAuthorityRegistryWait(observedEpoch)
        else:
            csgTransactionAuthorityUnlock()
            panic("merkle transaction authority: registry state invalid")
    var candidate: csgTransactionAuthorityRegistryStorage
    csgTransactionAuthorityRegistryBuild(candidate)
    csgTransactionAuthorityRegistry = candidate
    candidate = csgTransactionAuthorityRegistryStorage()
    csgTransactionAuthorityLock()
    if csgTransactionAuthorityRegistryState !=
       csgTransactionAuthorityRegistryBuilding:
        csgTransactionAuthorityRegistryState =
            csgTransactionAuthorityRegistryFailed
        os.CsgTransactionAuthorityRegistryNotifyAll()
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: registry publication drift")
    csgTransactionAuthorityRegistryState =
        csgTransactionAuthorityRegistryReady
    if !csgTransactionAuthorityRegistryShapeValid():
        csgTransactionAuthorityRegistryState =
            csgTransactionAuthorityRegistryFailed
        os.CsgTransactionAuthorityRegistryNotifyAll()
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: registry invalid")
    os.CsgTransactionAuthorityRegistryNotifyAll()
    csgTransactionAuthorityUnlock()

fn csgTransactionAuthorityI32(
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        csgTransactionAuthorityRegistry.store,
        csgTransactionAuthorityRegistry.arena,
        column,
        row)

fn csgTransactionAuthoritySetI32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        csgTransactionAuthorityRegistry.store,
        csgTransactionAuthorityRegistry.arena,
        column,
        row,
        value)

fn csgTransactionAuthorityFixed(
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    let base = row * layout.FixedBytes32Size
    for i in 0..<layout.FixedBytes32Size:
        out.data[i] = uint8(phase.PhaseArenaStoreGetByte(
            csgTransactionAuthorityRegistry.store,
            csgTransactionAuthorityRegistry.arena,
            column,
            base + i))
    return out

@borrows
fn csgTransactionAuthoritySetFixed(
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    let base = row * layout.FixedBytes32Size
    for i in 0..<layout.FixedBytes32Size:
        phase.PhaseArenaStoreSetByte(
            csgTransactionAuthorityRegistry.store,
            csgTransactionAuthorityRegistry.arena,
            column,
            base + i,
            int32(value.data[i]))

fn csgTransactionAuthorityStorePreparedPath(
        row: int32,
        authority:
            merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthority) =
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.pathAuthorityOwnerIds,
        row,
        authority.ownerId)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.pathAuthorityGenerations,
        row,
        authority.generation)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.pathAuthorityStageNonces,
        row,
        authority.stageNonce)

fn csgTransactionAuthorityLoadPreparedPath(
        row: int32,
        authority:
            var merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthority) =
    authority.ownerId = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.pathAuthorityOwnerIds, row)
    authority.generation = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.pathAuthorityGenerations, row)
    authority.stageNonce = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityStageNonces, row)

fn csgTransactionAuthorityStoreSessionPath(
        row: int32,
        authority:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority) =
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.pathAuthorityOwnerIds,
        row,
        authority.ownerId)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.pathAuthorityGenerations,
        row,
        authority.generation)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.pathAuthorityStageNonces,
        row,
        authority.stageNonce)

fn csgTransactionAuthorityLoadSessionPath(
        row: int32,
        authority:
            var merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority) =
    authority.ownerId = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.pathAuthorityOwnerIds, row)
    authority.generation = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.pathAuthorityGenerations, row)
    authority.stageNonce = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityStageNonces, row)

fn csgTransactionAuthorityBytesSetI32(
        bytes: var rawbytes.Bytes,
        row: int32,
        value: int32) =
    let base = row * 4
    rawbytes.BytesSet(bytes, base, value & 255)
    rawbytes.BytesSet(bytes, base + 1, (value >> 8) & 255)
    rawbytes.BytesSet(bytes, base + 2, (value >> 16) & 255)
    rawbytes.BytesSet(bytes, base + 3, (value >> 24) & 255)

fn csgTransactionAuthorityArtifactOwnerRelease(
        owner: var csgTransactionAuthorityArtifactArenaOwner) =
    if phase.PhaseArenaStoreStorageReleased(owner.store):
        owner = csgTransactionAuthorityArtifactArenaOwner()
        return
    if !phase.PhaseArenaHandleIsValid(owner.arena):
        panic("merkle transaction authority: artifact arena handle invalid")
    phase.PhaseArenaStoreCloseArena(owner.store, owner.arena)
    let released = phase.PhaseArenaStoreDestroyWithReceipt(owner.store)
    if !released.storageReleased || released.releasedBufferCount <= 0 ||
       released.releasedBytes <= int64(0):
        panic("merkle transaction authority: artifact arena release failed")
    owner = csgTransactionAuthorityArtifactArenaOwner()

fn csgTransactionAuthorityArtifactOwnerShapeValid(
        owner: var csgTransactionAuthorityArtifactArenaOwner): bool =
    if owner.artifactCount <= 0 || owner.totalObjectBytes <= 0 ||
       !phase.PhaseArenaHandleIsValid(owner.arena):
        return false
    let arena = owner.arena
    if !csgTransactionAuthorityRefMatches(owner.kinds, arena) ||
       !csgTransactionAuthorityRefMatches(owner.cidDigests, arena) ||
       !csgTransactionAuthorityRefMatches(owner.byteOffsets, arena) ||
       !csgTransactionAuthorityRefMatches(owner.byteLengths, arena) ||
       !csgTransactionAuthorityRefMatches(owner.bytes, arena):
        return false
    let report = phase.PhaseArenaStoreArenaReport(owner.store, arena)
    return report.spillCount == 0 && report.allocationCount == 5 &&
        report.liveAllocationCount == 5 &&
        report.usedBytes == report.capacityBytes

@borrows
fn csgTransactionAuthorityBytesClone(
        source: rawbytes.Bytes): rawbytes.Bytes =
    let byteCount = rawbytes.BytesLen(source)
    var out = rawbytes.BytesAlloc(byteCount)
    if rawbytes.BytesLen(out) != byteCount:
        rawbytes.BytesFree(out)
        return rawbytes.Bytes()
    rawbytes.BytesCopyInto(out, 0, source)
    return out

fn csgTransactionAuthorityArtifactsFree(
        artifacts: var CsgCoreMerkleTransactionArtifactInput[]) =
    for i in 0..<artifacts.len:
        rawbytes.BytesFree(artifacts[i].bytes)
    artifacts = []

@borrows
fn csgTransactionAuthorityArtifactReferencedBySkeleton(
        skeleton: merkle_manifest.CsgCoreMerkleSemanticManifestSkeleton,
        kind: int32,
        cid: str): bool =
    if kind ==
       merkle_store_artifact_codec.CsgCoreMerkleStorePartitionArtifactKind():
        for i in 0..<skeleton.partitions.len:
            if skeleton.partitions[i].factsCid == cid:
                return true
        return false
    if kind ==
       merkle_store_artifact_codec.CsgCoreMerkleStoreMembershipArtifactKind():
        for i in 0..<skeleton.partitions.len:
            if skeleton.partitions[i].membershipCid == cid:
                return true
        return false
    if kind ==
       merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind():
        for i in 0..<skeleton.dependencyConsumerShards.len:
            if skeleton.dependencyConsumerShards[i].cid == cid:
                return true
        for i in 0..<skeleton.dependencyProviderShards.len:
            if skeleton.dependencyProviderShards[i].cid == cid:
                return true
        return false
    if kind ==
       merkle_store_artifact_codec.CsgCoreMerkleStoreIndexArtifactKind():
        for i in 0..<skeleton.queryShards.len:
            if skeleton.queryShards[i].cid == cid:
                return true
        return false
    if kind ==
       merkle_store_artifact_codec.CsgCoreMerkleStoreSummaryArtifactKind():
        return skeleton.summaryCid == cid
    return false

@borrows
fn csgTransactionAuthorityBaseArtifactContains(
        artifacts: CsgCoreMerkleTransactionArtifactInput[],
        kind: int32,
        cid: str): bool =
    for i in 0..<artifacts.len:
        if artifacts[i].kind == kind && artifacts[i].cid == cid:
            return true
    return false

@borrows
fn csgTransactionAuthorityBaseArtifactsError(
        skeleton: merkle_manifest.CsgCoreMerkleSemanticManifestSkeleton,
        artifacts: CsgCoreMerkleTransactionArtifactInput[]): str =
    for i in 0..<artifacts.len:
        if !csgTransactionAuthorityArtifactReferencedBySkeleton(
               skeleton, artifacts[i].kind, artifacts[i].cid):
            return "merkle_transaction_base_artifact_unreferenced"
        for j in 0..<i:
            if artifacts[j].cid == artifacts[i].cid:
                return "merkle_transaction_base_artifact_duplicate"
    for i in 0..<skeleton.partitions.len:
        if !csgTransactionAuthorityBaseArtifactContains(
               artifacts,
               merkle_store_artifact_codec.CsgCoreMerkleStorePartitionArtifactKind(),
               skeleton.partitions[i].factsCid) ||
           !csgTransactionAuthorityBaseArtifactContains(
               artifacts,
               merkle_store_artifact_codec.CsgCoreMerkleStoreMembershipArtifactKind(),
               skeleton.partitions[i].membershipCid):
            return "merkle_transaction_base_partition_artifact_missing"
    for i in 0..<skeleton.dependencyConsumerShards.len:
        if !csgTransactionAuthorityBaseArtifactContains(
               artifacts,
               merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind(),
               skeleton.dependencyConsumerShards[i].cid):
            return "merkle_transaction_base_dependency_consumer_missing"
    for i in 0..<skeleton.dependencyProviderShards.len:
        if !csgTransactionAuthorityBaseArtifactContains(
               artifacts,
               merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind(),
               skeleton.dependencyProviderShards[i].cid):
            return "merkle_transaction_base_dependency_provider_missing"
    for i in 0..<skeleton.queryShards.len:
        if !csgTransactionAuthorityBaseArtifactContains(
               artifacts,
               merkle_store_artifact_codec.CsgCoreMerkleStoreIndexArtifactKind(),
               skeleton.queryShards[i].cid):
            return "merkle_transaction_base_query_artifact_missing"
    if !csgTransactionAuthorityBaseArtifactContains(
           artifacts,
           merkle_store_artifact_codec.CsgCoreMerkleStoreSummaryArtifactKind(),
           skeleton.summaryCid):
        return "merkle_transaction_base_summary_artifact_missing"
    return ""

# Physical element swaps on an aggregate-element sequence are outside the
# cold backend's staged take scope (findings.md 2026-08-13 案卷); canonical
# order is materialized as an index permutation instead. Only int32 elements
# move; cid reads flow straight into the @borrows comparator without
# element-local binds.
@borrows
fn csgTransactionAuthorityArtifactOrderInto(
        artifacts: CsgCoreMerkleTransactionArtifactInput[],
        orderOut: var int32[]) =
    orderOut = []
    for index in 0..<artifacts.len:
        add(orderOut, index)
    for index in 1..<artifacts.len:
        var cursor = index
        while cursor > 0 && csgTransactionAuthorityTextCompare(
                artifacts[orderOut[cursor]].cid,
                artifacts[orderOut[cursor - 1]].cid) < 0:
            let swappedIndex = orderOut[cursor]
            orderOut[cursor] = orderOut[cursor - 1]
            orderOut[cursor - 1] = swappedIndex
            cursor = cursor - 1

@borrows
fn csgTransactionAuthorityArtifactOwnerBuild(
        artifacts: CsgCoreMerkleTransactionArtifactInput[],
        order: int32[],
        owner: var csgTransactionAuthorityArtifactArenaOwner,
        artifactCids: var str[]): str =
    if artifacts.len <= 0 ||
       artifacts.len > csgTransactionAuthorityArtifactCountLimit ||
       order.len != artifacts.len ||
       !phase.PhaseArenaStoreStorageReleased(owner.store):
        return "merkle_transaction_artifact_arena_input_invalid"
    var totalObjectBytes: int64
    for i in 0..<artifacts.len:
        let row = order[i]
        if row < 0 || row >= artifacts.len:
            return "merkle_transaction_artifact_arena_input_invalid"
        let byteCount = rawbytes.BytesLen(artifacts[row].bytes)
        let byteLimit =
            merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactByteLimit(
                artifacts[row].kind)
        var artifactCidError: str
        let artifactCid =
            merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
                artifacts[row].kind,
                artifacts[row].bytes,
                artifactCidError)
        if !merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactKindValid(
               artifacts[row].kind) ||
           byteLimit <= int64(0) ||
           byteCount <= 0 || int64(byteCount) > byteLimit ||
           artifactCidError.len > 0 ||
           artifactCid != artifacts[row].cid ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               artifacts[row].cid) ||
           (i > 0 && csgTransactionAuthorityTextCompare(
               artifacts[order[i - 1]].cid, artifacts[row].cid) >= 0):
            return "merkle_transaction_artifact_arena_row_invalid"
        if int64(byteCount) >
           csgTransactionAuthorityArtifactArenaByteLimit -
               totalObjectBytes:
            return "merkle_transaction_artifact_arena_byte_limit"
        totalObjectBytes = totalObjectBytes + int64(byteCount)
        add(artifactCids, strings.CloneStr(artifacts[row].cid))
    var capacity: int64
    capacity = phase.PhaseArenaAlign(capacity, int64(4)) +
        int64(artifacts.len) * int64(4)
    capacity = phase.PhaseArenaAlign(capacity, int64(8)) +
        int64(artifacts.len) * int64(layout.FixedBytes32Size)
    capacity = phase.PhaseArenaAlign(capacity, int64(4)) +
        int64(artifacts.len) * int64(4)
    capacity = phase.PhaseArenaAlign(capacity, int64(4)) +
        int64(artifacts.len) * int64(4)
    capacity = phase.PhaseArenaAlign(capacity, int64(8)) +
        totalObjectBytes
    if capacity <= int64(0) ||
       capacity > csgTransactionAuthorityArtifactArenaByteLimit:
        return "merkle_transaction_artifact_arena_capacity_invalid"
    phase.PhaseArenaStoreInit(owner.store, 1, int32(capacity), 5)
    owner.arena = phase.PhaseArenaStoreOpenArena(
        owner.store, 1, int32(capacity), 5)
    owner.kinds = phase.PhaseArenaStoreReserveI32Column(
        owner.store, owner.arena, artifacts.len)
    owner.cidDigests = phase.PhaseArenaStoreAllocRefAligned(
        owner.store,
        owner.arena,
        artifacts.len * layout.FixedBytes32Size,
        8)
    owner.byteOffsets = phase.PhaseArenaStoreReserveI32Column(
        owner.store, owner.arena, artifacts.len)
    owner.byteLengths = phase.PhaseArenaStoreReserveI32Column(
        owner.store, owner.arena, artifacts.len)
    owner.bytes = phase.PhaseArenaStoreAllocRefAligned(
        owner.store, owner.arena, int32(totalObjectBytes), 8)
    var kindBytes = rawbytes.BytesAlloc(artifacts.len * 4)
    var cidBytes = rawbytes.BytesAlloc(
        artifacts.len * layout.FixedBytes32Size)
    var offsetBytes = rawbytes.BytesAlloc(artifacts.len * 4)
    var lengthBytes = rawbytes.BytesAlloc(artifacts.len * 4)
    if rawbytes.BytesLen(kindBytes) != artifacts.len * 4 ||
       rawbytes.BytesLen(cidBytes) !=
           artifacts.len * layout.FixedBytes32Size ||
       rawbytes.BytesLen(offsetBytes) != artifacts.len * 4 ||
       rawbytes.BytesLen(lengthBytes) != artifacts.len * 4:
        rawbytes.BytesFree(kindBytes)
        rawbytes.BytesFree(cidBytes)
        rawbytes.BytesFree(offsetBytes)
        rawbytes.BytesFree(lengthBytes)
        csgTransactionAuthorityArtifactOwnerRelease(owner)
        return "merkle_transaction_artifact_arena_metadata_alloc_failed"
    var objectOffset: int32
    for i in 0..<artifacts.len:
        let row = order[i]
        csgTransactionAuthorityBytesSetI32(
            kindBytes, i, artifacts[row].kind)
        csgTransactionAuthorityBytesSetI32(
            offsetBytes, i, objectOffset)
        let byteCount = rawbytes.BytesLen(artifacts[row].bytes)
        csgTransactionAuthorityBytesSetI32(
            lengthBytes, i, byteCount)
        let hexText = strings.CloneStrRange(artifacts[row].cid, 7, 64)
        let parsed = layout.FixedBytes32FromHex(hexText)
        if result.IsErr(parsed):
            panic("merkle transaction authority: validated cid parse failed")
        let digest = result.Value(parsed)
        let cidBase = i * layout.FixedBytes32Size
        for j in 0..<layout.FixedBytes32Size:
            rawbytes.BytesSet(
                cidBytes, cidBase + j, int32(digest.data[j]))
        phase.PhaseArenaStoreCopyBytesInto(
            owner.store,
            owner.arena,
            owner.bytes,
            objectOffset,
            artifacts[row].bytes,
            0,
            byteCount)
        objectOffset = objectOffset + byteCount
    phase.PhaseArenaStoreCopyBytesInto(
        owner.store, owner.arena, owner.kinds, 0, kindBytes, 0,
        rawbytes.BytesLen(kindBytes))
    phase.PhaseArenaStoreCopyBytesInto(
        owner.store, owner.arena, owner.cidDigests, 0, cidBytes, 0,
        rawbytes.BytesLen(cidBytes))
    phase.PhaseArenaStoreCopyBytesInto(
        owner.store, owner.arena, owner.byteOffsets, 0, offsetBytes, 0,
        rawbytes.BytesLen(offsetBytes))
    phase.PhaseArenaStoreCopyBytesInto(
        owner.store, owner.arena, owner.byteLengths, 0, lengthBytes, 0,
        rawbytes.BytesLen(lengthBytes))
    rawbytes.BytesFree(kindBytes)
    rawbytes.BytesFree(cidBytes)
    rawbytes.BytesFree(offsetBytes)
    rawbytes.BytesFree(lengthBytes)
    owner.artifactCount = artifacts.len
    owner.totalObjectBytes = int32(totalObjectBytes)
    if objectOffset != owner.totalObjectBytes ||
       !csgTransactionAuthorityArtifactOwnerShapeValid(owner):
        csgTransactionAuthorityArtifactOwnerRelease(owner)
        return "merkle_transaction_artifact_arena_shape_invalid"
    return ""

fn csgTransactionAuthorityArtifactOwnerRead(
        owner: var csgTransactionAuthorityArtifactArenaOwner,
        ordinal: int32,
        kind: var int32,
        cid: var str,
        bytes: var rawbytes.Bytes) =
    if !csgTransactionAuthorityArtifactOwnerShapeValid(owner) ||
       ordinal < 0 || ordinal >= owner.artifactCount ||
       rawbytes.BytesLen(bytes) != 0:
        panic("merkle transaction authority: artifact read invalid")
    kind = phase.PhaseArenaStoreI32ColumnGet(
        owner.store, owner.arena, owner.kinds, ordinal)
    let cidBase = ordinal * layout.FixedBytes32Size
    var digestBytes = phase.PhaseArenaStoreCopyBytesOut(
        owner.store,
        owner.arena,
        owner.cidDigests,
        cidBase,
        layout.FixedBytes32Size)
    let parsedDigest = layout.FixedBytes32FromBytes(digestBytes)
    rawbytes.BytesFree(digestBytes)
    if result.IsErr(parsedDigest):
        panic("merkle transaction authority: artifact cid digest invalid")
    let digest = result.Value(parsedDigest)
    cid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(digest))
    let byteOffset = phase.PhaseArenaStoreI32ColumnGet(
        owner.store, owner.arena, owner.byteOffsets, ordinal)
    let byteCount = phase.PhaseArenaStoreI32ColumnGet(
        owner.store, owner.arena, owner.byteLengths, ordinal)
    if byteOffset < 0 || byteCount <= 0 ||
       byteOffset > owner.totalObjectBytes - byteCount:
        panic("merkle transaction authority: artifact byte range invalid")
    bytes = phase.PhaseArenaStoreCopyBytesOut(
        owner.store, owner.arena, owner.bytes, byteOffset, byteCount)

fn csgTransactionAuthorityArtifactOwnerIdentity(
        owner: var csgTransactionAuthorityArtifactArenaOwner,
        ordinal: int32,
        kind: var int32,
        cid: var str,
        byteCount: var int32) =
    var bytes: rawbytes.Bytes
    csgTransactionAuthorityArtifactOwnerRead(
        owner, ordinal, kind, cid, bytes)
    byteCount = rawbytes.BytesLen(bytes)
    rawbytes.BytesFree(bytes)

fn csgTransactionAuthorityFindLiveLineageRow(
        lineageBinding: layout.FixedBytes32,
        kind: int32,
        liveState: int32): int32 =
    if layout.FixedBytes32Equal(
           lineageBinding, layout.FixedBytes32()):
        return -1
    var row: int32 = -1
    for i in 0..<csgTransactionAuthorityRegistrySlotCount:
        if csgTransactionAuthorityI32(
               csgTransactionAuthorityRegistry.states, i) == liveState &&
           csgTransactionAuthorityI32(
               csgTransactionAuthorityRegistry.kinds, i) == kind &&
           layout.FixedBytes32Equal(
               csgTransactionAuthorityFixed(
                   csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
                   i),
               lineageBinding):
            if row >= 0:
                panic("merkle transaction authority: lineage collision")
            row = i
    return row

@borrows
fn csgTransactionAuthorityTerminalSucceeded(
        terminal:
            merkle_store_identity.CsgCoreMerkleStoreStageTerminalResult):
        bool =
    return terminal.ok && terminal.terminal

fn csgTransactionAuthorityClearRow(row: int32) =
    if !phase.PhaseArenaStoreStorageReleased(
           csgTransactionAuthorityRegistry.artifactOwners[row].store):
        panic("merkle transaction authority: clear with live artifacts")
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.kinds, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.nextArtifactOrdinals, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.artifactCounts, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.objectWriteCounts, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.pathAuthorityOwnerIds, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.pathAuthorityGenerations, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.finalManifestOrdinals, row, -1)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.transactionReceiptOrdinals,
        row,
        -1)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.mappedCompletionOwnerIds, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.mappedCompletionGenerations,
        row,
        0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.sealedBeforeOwnerIds, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.sealedBeforeGenerations, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.sealedBeforeKinds, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationLow,
        row,
        0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationHigh,
        row,
        0)
    let zero = layout.FixedBytes32()
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.authenticators, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.semanticFingerprints, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.semanticPlanRoots, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.projectionReceiptCids, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.finalManifestCids, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.transactionReceiptCids, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
        row,
        zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.pathAuthorityStageNonces,
        row,
        zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.artifactClaimAuthenticators,
        row,
        zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.mappedCompletionNonces, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.mappedCompletionBindings, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.sealedBeforeAuthenticators,
        row,
        zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.sealedBeforeBindings, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeStoreIdentities, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeHeadCids, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeManifestCids, row, zero)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeFactsRoots, row, zero)

fn csgTransactionAuthorityPublishPoisoned(row: int32) =
    csgTransactionAuthorityClearRow(row)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStatePoisoned)

fn csgTransactionAuthorityPublishCommitted(row: int32) =
    csgTransactionAuthorityClearRow(row)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateCommitted)

fn csgTransactionAuthorityNonce(
        out: var layout.FixedBytes32): bool =
    var bytes = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    if rawbytes.BytesLen(bytes) != layout.FixedBytes32Size ||
       !rand.RandomFill(bytes):
        rawbytes.BytesFree(bytes)
        return false
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return !layout.FixedBytes32Equal(out, layout.FixedBytes32())

@borrows
fn csgTransactionAuthorityAppendFixed32(
        out: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    for i in 0..<layout.FixedBytes32Size:
        layout.ByteBufAppendByte(out, int32(value.data[i]))

@borrows
fn csgTransactionAuthorityCidInto(
        value: str,
        out: var layout.FixedBytes32): bool =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(value):
        return false
    let hexText = strings.CloneStrRange(value, 7, 64)
    let parsed = layout.FixedBytes32FromHex(hexText)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return true

@borrows
fn csgTransactionAuthorityTransitionReceiptHeadBindingCid(
        transactionReceiptCid: str,
        beforeHeadCid: str,
        afterHeadCid: str,
        bindingCid: var str): bool =
    var receiptRaw32: layout.FixedBytes32
    var beforeRaw32: layout.FixedBytes32
    var afterRaw32: layout.FixedBytes32
    if !csgTransactionAuthorityCidInto(
           transactionReceiptCid, receiptRaw32) ||
       !csgTransactionAuthorityCidInto(
           beforeHeadCid, beforeRaw32) ||
       !csgTransactionAuthorityCidInto(
           afterHeadCid, afterRaw32):
        return false
    var buf = layout.ByteBufInit(96)
    csgTransactionAuthorityAppendFixed32(buf, receiptRaw32)
    csgTransactionAuthorityAppendFixed32(buf, beforeRaw32)
    csgTransactionAuthorityAppendFixed32(buf, afterRaw32)
    var bytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    bindingCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            csgTransactionTransitionReceiptHeadBindingDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(
        bindingCid)

@borrows
fn csgTransactionAuthorityBeforeJoinValid(
        projection:
            merkle_admission.CsgCoreMerkleSealedBeforeProjection,
        snapshot:
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotSummary,
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate,
        plan: request.CsgCoreMerkleSemanticPlan): bool =
    var planStoreIdentity: layout.FixedBytes32
    var planHeadCid: layout.FixedBytes32
    var planManifestCid: layout.FixedBytes32
    var planFactsRoot: layout.FixedBytes32
    var beforeDagRootCid: layout.FixedBytes32
    var beforeCsgcDirectoryCid: layout.FixedBytes32
    var beforeCsgcObjectCid: layout.FixedBytes32
    var beforeProfileSetCid: layout.FixedBytes32
    var beforeSchemaCid: layout.FixedBytes32
    if !csgTransactionAuthorityCidInto(
           plan.beforeStoreIdentity, planStoreIdentity) ||
       !csgTransactionAuthorityCidInto(plan.beforeHeadCid, planHeadCid) ||
       !csgTransactionAuthorityCidInto(
           plan.beforeManifestCid, planManifestCid) ||
       !csgTransactionAuthorityCidInto(
           projection.summary.beforeFactsRoot, planFactsRoot) ||
       !csgTransactionAuthorityCidInto(
           projection.summary.beforeDagRootCid, beforeDagRootCid) ||
       !csgTransactionAuthorityCidInto(
           projection.beforeCsgcDirectoryCid,
           beforeCsgcDirectoryCid) ||
       !csgTransactionAuthorityCidInto(
           projection.beforeCsgcObjectCid, beforeCsgcObjectCid) ||
       !csgTransactionAuthorityCidInto(
           candidate.replay.beforeBinding.profileSetCid,
           beforeProfileSetCid) ||
       !csgTransactionAuthorityCidInto(
           candidate.replay.beforeBinding.schemaCid,
           beforeSchemaCid):
        return false
    return projection.summary.sealedBeforeContentCid ==
               plan.sealedBeforeContentCid &&
        projection.summary.beforeFactsRoot ==
            candidate.replay.beforeFactsRoot &&
        projection.summary.beforeDagRootCid ==
            candidate.replay.beforeDagRootCid &&
        projection.summary.beforeSubgraphCid ==
            candidate.replay.beforeSubgraphCid &&
        projection.summary.beforeFactCount ==
            candidate.replay.beforeCount &&
        projection.beforeCsgcDirectoryCid ==
            candidate.beforeCsgcDirectoryCid &&
        projection.beforeCsgcObjectCid ==
            candidate.beforeCsgcObjectCid &&
        projection.bindingIdentityReceiptCid ==
            candidate.replay.beforeBinding.bindingIdentityReceiptCid &&
        candidate.beforeFactCount == candidate.replay.beforeCount &&
        candidate.beforeFactsRoot == candidate.replay.beforeFactsRoot &&
        candidate.beforeDagRootCid == candidate.replay.beforeDagRootCid &&
        candidate.beforeSubgraphCid == candidate.replay.beforeSubgraphCid &&
        layout.FixedBytes32Equal(
            snapshot.beforeStoreIdentity, planStoreIdentity) &&
        layout.FixedBytes32Equal(snapshot.headCid, planHeadCid) &&
        layout.FixedBytes32Equal(snapshot.manifestCid, planManifestCid) &&
        layout.FixedBytes32Equal(snapshot.factsRoot, planFactsRoot) &&
        layout.FixedBytes32Equal(
            snapshot.dagRootCid, beforeDagRootCid) &&
        layout.FixedBytes32Equal(
            snapshot.csgcDirectoryCid, beforeCsgcDirectoryCid) &&
        layout.FixedBytes32Equal(
            snapshot.csgcObjectCid, beforeCsgcObjectCid) &&
        layout.FixedBytes32Equal(
            snapshot.profileSetCid, beforeProfileSetCid) &&
        layout.FixedBytes32Equal(snapshot.schemaCid, beforeSchemaCid) &&
        snapshot.factCount == projection.summary.beforeFactCount &&
        snapshot.storeGeneration == plan.beforeGeneration

@borrows
fn csgTransactionAuthorityCompletionMatchesSnapshot(
        snapshot:
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotSummary,
        completion:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionSummary):
        bool =
    return layout.FixedBytes32Equal(
               completion.sourceLineageBinding,
               snapshot.sourceLineageBinding) &&
        layout.FixedBytes32Equal(
            completion.snapshotBinding,
            snapshot.snapshotBinding) &&
        layout.FixedBytes32Equal(
            completion.beforeStoreIdentity,
            snapshot.beforeStoreIdentity) &&
        layout.FixedBytes32Equal(completion.headCid, snapshot.headCid) &&
        layout.FixedBytes32Equal(
            completion.manifestCid, snapshot.manifestCid) &&
        completion.storeGeneration == snapshot.storeGeneration &&
        completion.csgcByteCount == snapshot.csgcByteCount &&
        completion.factCount == snapshot.factCount &&
        completion.readCount == completion.factCount &&
        completion.nodeCount == snapshot.nodeCount &&
        layout.FixedBytes32Equal(
            completion.csgcDirectoryCid,
            snapshot.csgcDirectoryCid) &&
        layout.FixedBytes32Equal(
            completion.csgcObjectCid,
            snapshot.csgcObjectCid) &&
        layout.FixedBytes32Equal(
            completion.factsRoot, snapshot.factsRoot) &&
        layout.FixedBytes32Equal(
            completion.dagRootCid, snapshot.dagRootCid) &&
        layout.FixedBytes32Equal(
            completion.profileSetCid, snapshot.profileSetCid) &&
        layout.FixedBytes32Equal(
            completion.schemaCid, snapshot.schemaCid) &&
        !layout.FixedBytes32Equal(
            completion.traversalDigest, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            completion.completionBinding, layout.FixedBytes32())

@borrows
fn csgTransactionAuthorityFingerprint(
        semantic: CsgCoreMerkleTransactionSemanticVerifyResult,
        plan: request.CsgCoreMerkleSemanticPlan,
        sealedBeforeBinding: layout.FixedBytes32,
        mappedCompletionBinding: layout.FixedBytes32):
        layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(1024)
    csgTransactionAuthorityAppendText(
        preimage, semantic.semanticCarrierCid)
    csgTransactionAuthorityAppendText(
        preimage, semantic.semanticManifestSkeletonCid)
    csgTransactionAuthorityAppendText(
        preimage, semantic.semanticPlanRoot)
    csgTransactionAuthorityAppendText(
        preimage, plan.beforeStoreIdentity)
    csgTransactionAuthorityAppendText(
        preimage, plan.sealedBeforeContentCid)
    csgTransactionAuthorityAppendText(preimage, plan.beforeHeadCid)
    csgTransactionAuthorityAppendText(preimage, plan.beforeManifestCid)
    csgTransactionAuthorityAppendText(
        preimage, strings.Int64ToStr(plan.beforeGeneration))
    csgTransactionAuthorityAppendFixed32(
        preimage, sealedBeforeBinding)
    csgTransactionAuthorityAppendFixed32(
        preimage, mappedCompletionBinding)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgTransactionAuthorityTextDigest(value: str): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(value.len + 8)
    csgTransactionAuthorityAppendText(preimage, value)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgTransactionAuthorityHandleMatches(
        ownerId: int32,
        epoch: int32,
        kind: int32,
        authenticator: layout.FixedBytes32,
        state: int32): bool =
    if ownerId <= 0 ||
       ownerId > csgTransactionAuthorityRegistrySlotCount ||
       epoch <= 0 ||
       layout.FixedBytes32Equal(
           authenticator, layout.FixedBytes32()):
        return false
    let row = ownerId - 1
    return csgTransactionAuthorityI32(
               csgTransactionAuthorityRegistry.states, row) == state &&
        csgTransactionAuthorityI32(
            csgTransactionAuthorityRegistry.epochs, row) == epoch &&
        csgTransactionAuthorityI32(
            csgTransactionAuthorityRegistry.kinds, row) == kind &&
        layout.FixedBytes32Equal(
            csgTransactionAuthorityFixed(
                csgTransactionAuthorityRegistry.authenticators, row),
            authenticator)

@borrows
fn csgTransactionAuthorityStoreMappedCompletion(
        row: int32,
        verified:
            merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken,
        sealedBeforeBinding: layout.FixedBytes32,
        completion:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority,
        summary:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionSummary) =
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.sealedBeforeOwnerIds,
        row,
        verified.ownerId)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.sealedBeforeGenerations,
        row,
        verified.generation)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.sealedBeforeKinds,
        row,
        verified.kind)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.sealedBeforeAuthenticators,
        row,
        verified.authenticator)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.sealedBeforeBindings,
        row,
        sealedBeforeBinding)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.mappedCompletionOwnerIds,
        row,
        completion.ownerId)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.mappedCompletionGenerations,
        row,
        completion.generation)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.mappedCompletionNonces,
        row,
        completion.nonce)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.mappedCompletionBindings,
        row,
        completion.binding)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeStoreIdentities,
        row,
        summary.beforeStoreIdentity)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeHeadCids,
        row,
        summary.headCid)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeManifestCids,
        row,
        summary.manifestCid)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.beforeFactsRoots,
        row,
        summary.factsRoot)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationLow,
        row,
        int32(summary.storeGeneration & int64(4294967295)))
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationHigh,
        row,
        int32((summary.storeGeneration >> 32) & int64(4294967295)))

fn csgTransactionAuthorityLoadMappedCompletion(
        row: int32,
        verified:
            var merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken,
        completion:
            var merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority) =
    if row < 0 || row >= csgTransactionAuthorityRegistrySlotCount:
        panic("merkle transaction authority: before authority row invalid")
    verified.ownerId = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.sealedBeforeOwnerIds, row)
    verified.generation = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.sealedBeforeGenerations, row)
    verified.kind = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.sealedBeforeKinds, row)
    verified.authenticator = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.sealedBeforeAuthenticators, row)
    completion.ownerId = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.mappedCompletionOwnerIds, row)
    completion.generation = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.mappedCompletionGenerations, row)
    completion.nonce = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.mappedCompletionNonces, row)
    completion.binding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.mappedCompletionBindings, row)

@borrows
fn csgTransactionAuthorityAdmissionTerminalSucceeded(
        terminal:
            merkle_admission.CsgCoreMerkleSealedBeforeTerminalResult):
        bool =
    return terminal.ok && terminal.terminal

fn csgTransactionAuthorityClosePlanningPath(
        planningAuthority:
            var merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority) =
    if planningAuthority.ownerId <= 0:
        return
    let closeError =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityClose(
            planningAuthority)
    if closeError.len > 0:
        panic("merkle transaction authority: planning path cleanup failed")

fn csgTransactionAuthorityPoisonSnapshot(
        snapshot:
            var merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority) =
    if snapshot.ownerId <= 0:
        return
    let snapshotError =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPoison(
            snapshot)
    if snapshotError.len > 0:
        panic("merkle transaction authority: snapshot cleanup failed")

fn csgTransactionAuthorityPoisonLive(
        live: var merkle_admission.CsgCoreMerkleSealedBeforeLiveToken) =
    let sealedTerminal =
        merkle_admission.CsgCoreMerkleSealedBeforeLivePoison(live)
    if !csgTransactionAuthorityAdmissionTerminalSucceeded(
           sealedTerminal):
        panic("merkle transaction authority: sealed live cleanup failed")

fn csgTransactionAuthorityPoisonClaimedToken(
        claimed:
            var merkle_admission.CsgCoreMerkleSealedBeforeClaimedToken) =
    let sealedTerminal =
        merkle_admission.CsgCoreMerkleSealedBeforeClaimedPoison(claimed)
    if !csgTransactionAuthorityAdmissionTerminalSucceeded(
           sealedTerminal):
        panic("merkle transaction authority: sealed claim cleanup failed")

fn csgTransactionAuthorityPoisonRead(
        reading: var merkle_admission.CsgCoreMerkleSealedBeforeReadToken) =
    let sealedTerminal =
        merkle_admission.CsgCoreMerkleSealedBeforeReadPoison(reading)
    if !csgTransactionAuthorityAdmissionTerminalSucceeded(
           sealedTerminal):
        panic("merkle transaction authority: sealed read cleanup failed")

fn csgTransactionAuthorityPoisonReadAndMapped(
        reading: var merkle_admission.CsgCoreMerkleSealedBeforeReadToken,
        mapped:
            var merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority) =
    csgTransactionAuthorityPoisonRead(reading)
    let mappedError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoison(mapped)
    if mappedError.len > 0:
        panic("merkle transaction authority: mapped reader cleanup failed")

fn csgTransactionAuthorityPoisonReadAndCompletion(
        reading: var merkle_admission.CsgCoreMerkleSealedBeforeReadToken,
        completion:
            var merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority) =
    csgTransactionAuthorityPoisonRead(reading)
    let completionError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
            completion)
    if completionError.len > 0:
        panic("merkle transaction authority: mapped completion cleanup failed")

fn csgTransactionAuthorityPoisonVerifiedRead(
        verified:
            var merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken) =
    let sealedTerminal =
        merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadPoison(
            verified)
    if !csgTransactionAuthorityAdmissionTerminalSucceeded(
           sealedTerminal):
        panic("merkle transaction authority: sealed verified cleanup failed")

fn csgTransactionAuthorityPoisonBeforeAuthorities(
        reading: var merkle_admission.CsgCoreMerkleSealedBeforeReadToken,
        snapshot:
            var merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority) =
    csgTransactionAuthorityPoisonRead(reading)
    let snapshotError =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPoison(
            snapshot)
    if snapshotError.len > 0:
        panic("merkle transaction authority: before authority cleanup failed")

fn csgTransactionAuthorityPoisonMappedCompletion(
        verified:
            var merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken,
        completion:
            var merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority) =
    csgTransactionAuthorityPoisonVerifiedRead(verified)
    let completionError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
            completion)
    if completionError.len > 0:
        panic("merkle transaction authority: mapped completion cleanup failed")

@borrows
fn csgTransactionAuthorityPrepareFail(
        error: str): CsgCoreMerkleTransactionPrepareResult =
    var out: CsgCoreMerkleTransactionPrepareResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityPreparedArtifactsFail(
        error: str,
        artifacts: var CsgCoreMerkleTransactionArtifactInput[],
        owner: var csgTransactionAuthorityArtifactArenaOwner):
        csgTransactionAuthorityPreparedArtifacts =
    csgTransactionAuthorityArtifactsFree(artifacts)
    if !phase.PhaseArenaStoreStorageReleased(owner.store):
        csgTransactionAuthorityArtifactOwnerRelease(owner)
    var out: csgTransactionAuthorityPreparedArtifacts
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityAppendOwnedArtifact(
        artifacts: var CsgCoreMerkleTransactionArtifactInput[],
        kind: int32,
        cid: str,
        bytes: var rawbytes.Bytes) =
    var artifact: CsgCoreMerkleTransactionArtifactInput
    artifact.kind = kind
    artifact.cid = strings.CloneStr(cid)
    artifact.bytes = bytes
    bytes = rawbytes.Bytes()
    add(artifacts, artifact)

fn csgTransactionAuthorityTextSort(values: var str[]) =
    # Managed element stores into the same sequence fail the exact alias
    # audit, so in-place swaps are out. Selection-append: comparator reads
    # `values[i]` without a let-bind, output rows arrive via add(share).
    # A var-param seq cannot be share()'d, and `var input = values; values = []`
    # is a projection borrow plus replace (body-store-freeze).
    var picked: int32[]
    for i in 0..<values.len:
        add(picked, 0)
    var output: str[]
    let count = values.len
    for round in 0..<count:
        var minIndex = -1
        for i in 0..<count:
            if picked[i] != 0:
                continue
            if minIndex < 0 || csgTransactionAuthorityTextCompare(
                    values[i], values[minIndex]) < 0:
                minIndex = i
        if minIndex < 0:
            panic("merkle transaction authority: text sort pick failed")
        add(output, strings.CloneStr(values[minIndex]))
        picked[minIndex] = 1
    values = output
    output = []

@borrows
fn csgTransactionAuthorityBuildPreparedArtifacts(
        input: CsgCoreMerkleTransactionSemanticInput,
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate,
        semantic: CsgCoreMerkleTransactionSemanticVerifyResult,
        semanticPlan: request.CsgCoreMerkleSemanticPlan,
        stream:
            var projection_stream.CsgCoreCsgcProjectionStreamResult):
        csgTransactionAuthorityPreparedArtifacts =
    var artifacts: CsgCoreMerkleTransactionArtifactInput[]
    var owner: csgTransactionAuthorityArtifactArenaOwner
    let baseError = csgTransactionAuthorityBaseArtifactsError(
        input.skeleton, input.baseArtifacts)
    if baseError.len > 0:
        return csgTransactionAuthorityPreparedArtifactsFail(
            baseError, artifacts, owner)
    for i in 0..<input.baseArtifacts.len:
        var cloned = csgTransactionAuthorityBytesClone(
            input.baseArtifacts[i].bytes)
        if rawbytes.BytesLen(cloned) !=
           rawbytes.BytesLen(input.baseArtifacts[i].bytes):
            return csgTransactionAuthorityPreparedArtifactsFail(
                "merkle_transaction_base_artifact_clone_failed",
                artifacts,
                owner)
        csgTransactionAuthorityAppendOwnedArtifact(
            artifacts,
            input.baseArtifacts[i].kind,
            input.baseArtifacts[i].cid,
            cloned)

    var requestArtifact =
        request.CsgCoreMerkleTransactionRequestCid(input.request)
    if !requestArtifact.ok ||
       requestArtifact.requestCid != semanticPlan.requestCid:
        request.CsgCoreMerkleTransactionRequestCidFree(requestArtifact)
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_request_artifact_invalid",
            artifacts,
            owner)
    csgTransactionAuthorityAppendOwnedArtifact(
        artifacts,
        merkle_store_artifact_codec.CsgCoreMerkleStoreRequestArtifactKind(),
        requestArtifact.requestCid,
        requestArtifact.bytes)
    request.CsgCoreMerkleTransactionRequestCidFree(requestArtifact)

    var operationArtifact =
        operation.CsgCoreMerkleTransactionOperationEncode(
            input.operation)
    if !operationArtifact.ok ||
       operationArtifact.cid != input.operationCid:
        rawbytes.BytesFree(operationArtifact.bytes)
        rawbytes.BytesFree(operationArtifact.proofBytes)
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_operation_artifact_invalid",
            artifacts,
            owner)
    csgTransactionAuthorityAppendOwnedArtifact(
        artifacts,
        merkle_store_artifact_codec.CsgCoreMerkleStoreOperationArtifactKind(),
        operationArtifact.cid,
        operationArtifact.bytes)
    rawbytes.BytesFree(operationArtifact.proofBytes)

    var proofArtifact = merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
        candidate.proof,
        candidate.replay.beforeFactsRoot)
    if !proofArtifact.ok || proofArtifact.cid != input.proofCid:
        rawbytes.BytesFree(proofArtifact.bytes)
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_proof_artifact_invalid",
            artifacts,
            owner)
    csgTransactionAuthorityAppendOwnedArtifact(
        artifacts,
        merkle_store_artifact_codec.CsgCoreMerkleStoreProofArtifactKind(),
        proofArtifact.cid,
        proofArtifact.bytes)

    var reachableNodeCids: str[]
    for i in 0..<candidate.replay.nodes.len:
        let nodeCid = merkle_dag.CsgCoreMerkleNodeRecordCid(
            candidate.replay.nodes[i])
        var nodeArtifact =
            merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
                [candidate.replay.nodes[i]])
        if !nodeArtifact.ok:
            rawbytes.BytesFree(nodeArtifact.bytes)
            return csgTransactionAuthorityPreparedArtifactsFail(
                "merkle_transaction_node_artifact_invalid",
                artifacts,
                owner)
        var nodeArtifactCidError: str
        let actualNodeCid =
            merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
                merkle_store_artifact_codec.CsgCoreMerkleStoreNodeArtifactKind(),
                nodeArtifact.bytes,
                nodeArtifactCidError)
        if nodeArtifactCidError.len > 0 ||
           actualNodeCid != nodeCid:
            rawbytes.BytesFree(nodeArtifact.bytes)
            return csgTransactionAuthorityPreparedArtifactsFail(
                "merkle_transaction_node_artifact_invalid",
                artifacts,
                owner)
        add(reachableNodeCids, strings.CloneStr(nodeCid))
        csgTransactionAuthorityAppendOwnedArtifact(
            artifacts,
            merkle_store_artifact_codec.CsgCoreMerkleStoreNodeArtifactKind(),
            nodeCid,
            nodeArtifact.bytes)
    csgTransactionAuthorityTextSort(reachableNodeCids)

    var projection: csgc.CsgCoreCsgcProjectionReceipt
    projection.ok = true
    projection.sourceFactsRoot = strings.CloneStr(
        candidate.replay.afterFactsRoot)
    projection.formatId = strings.CloneStr(semanticPlan.formatId)
    projection.factCount = stream.factCount
    projection.byteCount = stream.byteCount
    projection.directoryCid = strings.CloneStr(stream.directoryCid)
    projection.objectCid = strings.CloneStr(stream.objectCid)
    projection.bytes = stream.bytes
    stream.bytes = rawbytes.Bytes()
    projection.receiptCid =
        csgc.CsgCoreCsgcProjectionReceiptCid(projection)
    let projectionError =
        csgc.CsgCoreCsgcProjectionReceiptStructuralError(projection)
    if projectionError.len > 0:
        rawbytes.BytesFree(projection.bytes)
        return csgTransactionAuthorityPreparedArtifactsFail(
            projectionError, artifacts, owner)
    var finalized =
        merkle_manifest.CsgCoreMerkleManifestFinalizeVerifiedProjection(
            input.skeleton, projection)
    if !finalized.ok:
        rawbytes.BytesFree(projection.bytes)
        return csgTransactionAuthorityPreparedArtifactsFail(
            finalized.error, artifacts, owner)
    var manifestArtifact =
        merkle_manifest.CsgCoreMerkleManifestEncode(finalized.manifest)
    if !manifestArtifact.ok:
        rawbytes.BytesFree(projection.bytes)
        rawbytes.BytesFree(manifestArtifact.bytes)
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_manifest_artifact_invalid",
            artifacts,
            owner)
    csgTransactionAuthorityAppendOwnedArtifact(
        artifacts,
        merkle_store_artifact_codec.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
        projection.objectCid,
        projection.bytes)
    csgTransactionAuthorityAppendOwnedArtifact(
        artifacts,
        merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind(),
        manifestArtifact.cid,
        manifestArtifact.bytes)

    var closureOrder: int32[]
    csgTransactionAuthorityArtifactOrderInto(artifacts, closureOrder)
    var closureCids: str[]
    for i in 0..<artifacts.len:
        add(closureCids, strings.CloneStr(artifacts[closureOrder[i]].cid))
    let artifactClosureCid =
        CsgCoreMerkleTransactionArtifactClosureCid(closureCids)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           artifactClosureCid):
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_artifact_closure_invalid",
            artifacts,
            owner)

    var transactionReceipt: receipt.CsgCoreMerkleTransactionReceipt
    transactionReceipt.schema = "csg_core::v1"
    transactionReceipt.generation =
        semanticPlan.beforeGeneration + int64(1)
    transactionReceipt.requestCid =
        strings.CloneStr(semanticPlan.requestCid)
    transactionReceipt.planRoot =
        strings.CloneStr(semantic.semanticPlanRoot)
    transactionReceipt.beforeStoreIdentity =
        strings.CloneStr(semanticPlan.beforeStoreIdentity)
    transactionReceipt.sealedBeforeContentCid =
        strings.CloneStr(semanticPlan.sealedBeforeContentCid)
    transactionReceipt.semanticCarrierCid =
        strings.CloneStr(semantic.semanticCarrierCid)
    transactionReceipt.projectionReceiptCid =
        strings.CloneStr(projection.receiptCid)
    transactionReceipt.proofCid = strings.CloneStr(input.proofCid)
    transactionReceipt.artifactClosureCid =
        strings.CloneStr(artifactClosureCid)
    transactionReceipt.beforeHeadCid =
        strings.CloneStr(semanticPlan.beforeHeadCid)
    transactionReceipt.beforeManifestCid =
        strings.CloneStr(semanticPlan.beforeManifestCid)
    transactionReceipt.afterManifestCid =
        strings.CloneStr(manifestArtifact.cid)
    transactionReceipt.beforeCsgcDirectoryCid =
        strings.CloneStr(candidate.beforeCsgcDirectoryCid)
    transactionReceipt.afterCsgcDirectoryCid =
        strings.CloneStr(projection.directoryCid)
    transactionReceipt.beforeFactsRoot =
        strings.CloneStr(candidate.replay.beforeFactsRoot)
    transactionReceipt.afterFactsRoot =
        strings.CloneStr(candidate.replay.afterFactsRoot)
    transactionReceipt.beforeDagRootCid =
        strings.CloneStr(candidate.replay.beforeDagRootCid)
    transactionReceipt.afterDagRootCid =
        strings.CloneStr(candidate.replay.afterDagRootCid)
    transactionReceipt.beforeFactCount = candidate.replay.beforeCount
    transactionReceipt.afterFactCount = candidate.replay.afterCount
    transactionReceipt.invalidationCid =
        strings.CloneStr(semanticPlan.invalidationPlanCid)
    add(transactionReceipt.plannedOperationKinds, input.operation.kind)
    add(
        transactionReceipt.plannedOperationFactKeys,
        strings.CloneStr(input.operation.queryKey))
    add(
        transactionReceipt.operationCids,
        strings.CloneStr(input.operationCid))
    transactionReceipt.reachableNewNodeCids = reachableNodeCids
    var encodedReceipt =
        receipt.CsgCoreMerkleTransactionReceiptEncode(
            transactionReceipt)
    if !encodedReceipt.ok:
        rawbytes.BytesFree(encodedReceipt.bytes)
        let receiptArtifactError =
            csgTransactionAuthorityCat(
                "merkle_transaction_receipt_artifact_invalid ",
                encodedReceipt.error)
        return csgTransactionAuthorityPreparedArtifactsFail(
            receiptArtifactError,
            artifacts,
            owner)
    csgTransactionAuthorityAppendOwnedArtifact(
        artifacts,
        merkle_store_artifact_codec.CsgCoreMerkleStoreReceiptArtifactKind(),
        encodedReceipt.cid,
        encodedReceipt.bytes)
    var artifactOrder: int32[]
    csgTransactionAuthorityArtifactOrderInto(artifacts, artifactOrder)
    var artifactCids: str[]
    var finalManifestOrdinal: int32 = -1
    var transactionReceiptOrdinal: int32 = -1
    for i in 0..<artifacts.len:
        let orderedIndex = artifactOrder[i]
        add(artifactCids, strings.CloneStr(artifacts[orderedIndex].cid))
        if artifacts[orderedIndex].kind ==
           merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind() &&
           artifacts[orderedIndex].cid == manifestArtifact.cid:
            finalManifestOrdinal = i
        if artifacts[orderedIndex].kind ==
           merkle_store_artifact_codec.CsgCoreMerkleStoreReceiptArtifactKind() &&
           artifacts[orderedIndex].cid == encodedReceipt.cid:
            transactionReceiptOrdinal = i
    if finalManifestOrdinal < 0 || transactionReceiptOrdinal < 0:
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_commit_artifact_ordinal_missing",
            artifacts,
            owner)
    var builtArtifactCids: str[]
    let ownerError = csgTransactionAuthorityArtifactOwnerBuild(
        artifacts, artifactOrder, owner, builtArtifactCids)
    if ownerError.len > 0 || !csgTransactionAuthoritySameTexts(
           artifactCids, builtArtifactCids):
        return csgTransactionAuthorityPreparedArtifactsFail(
            "merkle_transaction_artifact_arena_invalid",
            artifacts,
            owner)
    csgTransactionAuthorityArtifactsFree(artifacts)
    var out: csgTransactionAuthorityPreparedArtifacts
    out.ok = true
    out.owner = owner
    owner = csgTransactionAuthorityArtifactArenaOwner()
    out.projectionReceiptCid = strings.CloneStr(projection.receiptCid)
    out.finalManifestCid = strings.CloneStr(manifestArtifact.cid)
    out.transactionReceiptCid = strings.CloneStr(encodedReceipt.cid)
    out.finalManifestOrdinal = finalManifestOrdinal
    out.transactionReceiptOrdinal = transactionReceiptOrdinal
    return out

@borrows
fn csgTransactionAuthorityIssuePreparedForVerifiedSemantic(
        planningAuthority:
            var merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        semantic: CsgCoreMerkleTransactionSemanticVerifyResult,
        semanticPlan: request.CsgCoreMerkleSemanticPlan,
        verified:
            var merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken,
        sealedBeforeBinding: layout.FixedBytes32,
        completion:
            var merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority,
        completionSummary:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionSummary,
        preparedArtifacts:
            var csgTransactionAuthorityPreparedArtifacts):
        CsgCoreMerkleTransactionPrepareResult =
    if !semantic.ok:
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_semantic_invalid")
    var projectionReceiptDigest: layout.FixedBytes32
    var finalManifestDigest: layout.FixedBytes32
    var transactionReceiptDigest: layout.FixedBytes32
    var finalManifestKind: int32
    var finalManifestCid: str
    var finalManifestBytes: int32
    var transactionReceiptKind: int32
    var transactionReceiptCid: str
    var transactionReceiptBytes: int32
    if !preparedArtifacts.ok ||
       !csgTransactionAuthorityArtifactOwnerShapeValid(
           preparedArtifacts.owner) ||
       preparedArtifacts.finalManifestOrdinal < 0 ||
       preparedArtifacts.finalManifestOrdinal >=
           preparedArtifacts.owner.artifactCount ||
       preparedArtifacts.transactionReceiptOrdinal < 0 ||
       preparedArtifacts.transactionReceiptOrdinal >=
           preparedArtifacts.owner.artifactCount ||
       preparedArtifacts.finalManifestOrdinal ==
           preparedArtifacts.transactionReceiptOrdinal ||
       !csgTransactionAuthorityCidInto(
           preparedArtifacts.projectionReceiptCid,
           projectionReceiptDigest) ||
       !csgTransactionAuthorityCidInto(
           preparedArtifacts.finalManifestCid,
           finalManifestDigest) ||
       !csgTransactionAuthorityCidInto(
           preparedArtifacts.transactionReceiptCid,
           transactionReceiptDigest):
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_artifacts_invalid")
    csgTransactionAuthorityArtifactOwnerIdentity(
        preparedArtifacts.owner,
        preparedArtifacts.finalManifestOrdinal,
        finalManifestKind,
        finalManifestCid,
        finalManifestBytes)
    csgTransactionAuthorityArtifactOwnerIdentity(
        preparedArtifacts.owner,
        preparedArtifacts.transactionReceiptOrdinal,
        transactionReceiptKind,
        transactionReceiptCid,
        transactionReceiptBytes)
    if finalManifestKind !=
           merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind() ||
       transactionReceiptKind !=
           merkle_store_artifact_codec.CsgCoreMerkleStoreReceiptArtifactKind() ||
       finalManifestCid != preparedArtifacts.finalManifestCid ||
       transactionReceiptCid != preparedArtifacts.transactionReceiptCid ||
       finalManifestBytes <= 0 || transactionReceiptBytes <= 0:
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_commit_artifacts_invalid")
    var authenticator: layout.FixedBytes32
    if !csgTransactionAuthorityNonce(authenticator):
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_authenticator_failed")
    let fingerprint =
        csgTransactionAuthorityFingerprint(
            semantic,
            semanticPlan,
            sealedBeforeBinding,
            completion.binding)
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    var row: int32 = -1
    for i in 0..<csgTransactionAuthorityRegistrySlotCount:
        let state = csgTransactionAuthorityI32(
            csgTransactionAuthorityRegistry.states, i)
        let priorEpoch = csgTransactionAuthorityI32(
            csgTransactionAuthorityRegistry.epochs, i)
        if row < 0 && priorEpoch >= 0 &&
           priorEpoch < csgTransactionAuthorityEpochMax &&
           (state == csgTransactionAuthorityStateEmpty ||
            state == csgTransactionAuthorityStatePoisoned ||
            state == csgTransactionAuthorityStateCommitted):
            row = i
    if row < 0:
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_registry_full")
    let epoch = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.epochs, row) + 1
    csgTransactionAuthorityClearRow(row)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.epochs, row, epoch)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.kinds,
        row,
        csgTransactionAuthorityKindPrepared)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.authenticators,
        row,
        authenticator)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.semanticFingerprints,
        row,
        fingerprint)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.semanticPlanRoots,
        row,
        csgTransactionAuthorityTextDigest(semantic.semanticPlanRoot))
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.nextArtifactOrdinals, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.artifactCounts, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.objectWriteCounts, row, 0)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStatePrepareClaimed)
    csgTransactionAuthorityUnlock()
    var staged =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityMoveToPrepared(
            planningAuthority)
    if !staged.ok:
        csgTransactionAuthorityLock()
        if csgTransactionAuthorityHandleMatches(
               row + 1,
               epoch,
               csgTransactionAuthorityKindPrepared,
               authenticator,
               csgTransactionAuthorityStatePrepareClaimed):
            csgTransactionAuthorityPublishPoisoned(row)
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityPrepareFail(staged.error)
    let pathBinding =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityBinding(
            staged.authority)
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityLineageBinding(
            staged.authority)
    let pathValid =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityIsValid(
            staged.authority)
    let receiptValid =
        merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            staged.identityReceipt)
    if layout.FixedBytes32Equal(
           pathBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           pathLineageBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           authenticator, pathBinding) ||
       layout.FixedBytes32Equal(
           authenticator, pathLineageBinding) ||
       !pathValid || !receiptValid ||
       staged.identityReceipt.beforeStoreIdentity !=
           semanticPlan.beforeStoreIdentity ||
       staged.identityReceipt.formatId != semanticPlan.formatId:
        let terminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
                pathLineageBinding)
        if !csgTransactionAuthorityTerminalSucceeded(terminal):
            panic("merkle transaction authority: prepared path cleanup failed")
        csgTransactionAuthorityLock()
        if csgTransactionAuthorityHandleMatches(
               row + 1,
               epoch,
               csgTransactionAuthorityKindPrepared,
               authenticator,
               csgTransactionAuthorityStatePrepareClaimed):
            csgTransactionAuthorityPublishPoisoned(row)
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_path_authority_join_failed")
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           row + 1,
           epoch,
           csgTransactionAuthorityKindPrepared,
           authenticator,
           csgTransactionAuthorityStatePrepareClaimed):
        csgTransactionAuthorityUnlock()
        let terminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
                pathLineageBinding)
        if !csgTransactionAuthorityTerminalSucceeded(terminal):
            panic("merkle transaction authority: prepared path cleanup failed")
        panic("merkle transaction authority: prepare transition drift")
    csgTransactionAuthorityUnlock()
    csgTransactionAuthorityRegistry.artifactOwners[row] =
        preparedArtifacts.owner
    preparedArtifacts.owner =
        csgTransactionAuthorityArtifactArenaOwner()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           row + 1,
           epoch,
           csgTransactionAuthorityKindPrepared,
           authenticator,
           csgTransactionAuthorityStatePrepareClaimed) ||
       !csgTransactionAuthorityArtifactOwnerShapeValid(
           csgTransactionAuthorityRegistry.artifactOwners[row]):
        csgTransactionAuthorityUnlock()
        csgTransactionAuthorityArtifactOwnerRelease(
            csgTransactionAuthorityRegistry.artifactOwners[row])
        let terminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
                pathLineageBinding)
        if !csgTransactionAuthorityTerminalSucceeded(terminal):
            panic("merkle transaction authority: artifact publish path cleanup failed")
        panic("merkle transaction authority: artifact publication drift")
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.artifactCounts,
        row,
        csgTransactionAuthorityRegistry.artifactOwners[row].artifactCount)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.finalManifestOrdinals,
        row,
        preparedArtifacts.finalManifestOrdinal)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.transactionReceiptOrdinals,
        row,
        preparedArtifacts.transactionReceiptOrdinal)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.projectionReceiptCids,
        row,
        projectionReceiptDigest)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.finalManifestCids,
        row,
        finalManifestDigest)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.transactionReceiptCids,
        row,
        transactionReceiptDigest)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
        row,
        pathLineageBinding)
    csgTransactionAuthorityStorePreparedPath(row, staged.authority)
    csgTransactionAuthorityStoreMappedCompletion(
        row,
        verified,
        sealedBeforeBinding,
        completion,
        completionSummary)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStatePreparedLive)
    csgTransactionAuthorityUnlock()
    verified =
        merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken()
    completion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    var out: CsgCoreMerkleTransactionPrepareResult
    out.ok = true
    out.prepared.ownerId = row + 1
    out.prepared.epoch = epoch
    out.prepared.kind = csgTransactionAuthorityKindPrepared
    out.prepared.authenticator =
        layout.FixedBytes32Copy(authenticator)
    staged.authority =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthority()
    out.semanticCarrierCid =
        strings.CloneStr(semantic.semanticCarrierCid)
    out.semanticManifestSkeletonCid =
        strings.CloneStr(semantic.semanticManifestSkeletonCid)
    out.semanticPlanRoot = strings.CloneStr(semantic.semanticPlanRoot)
    return out

fn CsgCoreMerkleTransactionPrepare(
        input: var CsgCoreMerkleTransactionSemanticInput,
        semanticPlan: request.CsgCoreMerkleSemanticPlan,
        planning:
            var merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        snapshot:
            var merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority,
        sealedIssue:
            merkle_admission.CsgCoreMerkleSealedBeforeIssueResult):
        CsgCoreMerkleTransactionPrepareResult =
    var issued = sealedIssue
    var planningAuthority = planning
    planning =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority()
    var snapshotAuthority = snapshot
    snapshot =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
    defer:
        csgTransactionAuthorityPoisonSnapshot(snapshotAuthority)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
    if !merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIsValid(
           planningAuthority) ||
       !merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPlanningMatches(
           snapshotAuthority, planningAuthority):
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_before_authority_invalid")
    if !issued.ok:
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_sealed_issue_invalid")
    let semantic =
        CsgCoreMerkleTransactionAuthorityVerifyInMemory(
            input, semanticPlan, issued.candidate)
    if !semantic.ok:
        var rejectedLive = issued.live
        issued.live =
            merkle_admission.CsgCoreMerkleSealedBeforeLiveToken()
        csgTransactionAuthorityPoisonLive(rejectedLive)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(semantic.error)
    var live = issued.live
    issued.live = merkle_admission.CsgCoreMerkleSealedBeforeLiveToken()
    var claimed =
        merkle_admission.CsgCoreMerkleSealedBeforeClaim(live)
    if !claimed.ok ||
       !layout.FixedBytes32Equal(
           claimed.bindingDigest, issued.bindingDigest):
        if claimed.ok:
            csgTransactionAuthorityPoisonClaimedToken(
                claimed.claimed)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_sealed_claim_invalid")
    let sealedProjection =
        merkle_admission.CsgCoreMerkleSealedBeforeClaimedProjection(
            claimed.claimed,
            claimed.bindingDigest)
    if !sealedProjection.ok:
        csgTransactionAuthorityPoisonClaimedToken(claimed.claimed)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_sealed_projection_invalid")
    var heldItem = issued.candidate
    issued.candidate =
        merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate()
    var openedRead =
        merkle_admission.CsgCoreMerkleSealedBeforeClaimedOpenRead(
            claimed.claimed,
            claimed.bindingDigest,
            heldItem)
    if !openedRead.ok:
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(openedRead.error)
    var reading = openedRead.reading
    openedRead.reading =
        merkle_admission.CsgCoreMerkleSealedBeforeReadToken()
    let lockedSnapshot =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
            snapshotAuthority)
    if !lockedSnapshot.ok:
        csgTransactionAuthorityPoisonBeforeAuthorities(
            reading,
            snapshotAuthority)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(
            lockedSnapshot.error)
    if !csgTransactionAuthorityBeforeJoinValid(
           sealedProjection.projection,
           lockedSnapshot.summary,
           heldItem,
           semanticPlan):
        csgTransactionAuthorityPoisonBeforeAuthorities(
            reading,
            snapshotAuthority)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_before_authority_join_failed")
    var mappedIssue =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotIssueMappedCsgc(
            snapshotAuthority)
    if !mappedIssue.ok:
        csgTransactionAuthorityPoisonRead(reading)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(mappedIssue.error)
    var mapped = mappedIssue.authority
    mappedIssue.authority =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority()
    let expectedAfter =
        projection_stream.CsgCoreCsgcProjectionStreamExpectedAfterFromReplay(
            heldItem.replay,
            heldItem.proof,
            openedRead.beforePhysicalOrdinal,
            heldItem.queryKey,
            heldItem.beforeFact,
            heldItem.afterFact)
    if !expectedAfter.ok:
        csgTransactionAuthorityPoisonReadAndMapped(reading, mapped)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(expectedAfter.error)
    var projected =
        projection_stream.CsgCoreCsgcProjectionStreamMaterialize(
            mapped,
            lockedSnapshot.summary.factCount,
            openedRead.beforePhysicalOrdinal,
            heldItem.queryKey,
            heldItem.beforeFact,
            heldItem.afterFact,
            expectedAfter.expected)
    if !projected.ok:
        csgTransactionAuthorityPoisonRead(reading)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(projected.error)
    var completion = projected.completion
    projected.completion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    let lockedCompletion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcLockedCompletion(
            completion)
    if !lockedCompletion.ok ||
       !csgTransactionAuthorityCompletionMatchesSnapshot(
           lockedSnapshot.summary, lockedCompletion.summary):
        rawbytes.BytesFree(projected.bytes)
        csgTransactionAuthorityPoisonReadAndCompletion(
            reading, completion)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        if !lockedCompletion.ok:
            return csgTransactionAuthorityPrepareFail(
                lockedCompletion.error)
        return csgTransactionAuthorityPrepareFail(
            "merkle_transaction_prepare_mapped_completion_mismatch")
    var verified =
        merkle_admission.CsgCoreMerkleSealedBeforeReadVerifyMapped(
            reading,
            openedRead.bindingDigest,
            completion)
    if !verified.ok:
        rawbytes.BytesFree(projected.bytes)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(verified.error)
    var verifiedReading = verified.verified
    verified.verified =
        merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken()
    completion = verified.completion
    verified.completion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    var preparedArtifacts =
        csgTransactionAuthorityBuildPreparedArtifacts(
            input,
            heldItem,
            semantic,
            semanticPlan,
            projected)
    if !preparedArtifacts.ok:
        rawbytes.BytesFree(projected.bytes)
        csgTransactionAuthorityPoisonMappedCompletion(
            verifiedReading,
            completion)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
        return csgTransactionAuthorityPrepareFail(
            preparedArtifacts.error)
    let prepared =
        csgTransactionAuthorityIssuePreparedForVerifiedSemantic(
            planningAuthority,
            semantic,
            semanticPlan,
            verifiedReading,
            openedRead.bindingDigest,
            completion,
            lockedCompletion.summary,
            preparedArtifacts)
    if !prepared.ok:
        if !phase.PhaseArenaStoreStorageReleased(
               preparedArtifacts.owner.store):
            csgTransactionAuthorityArtifactOwnerRelease(
                preparedArtifacts.owner)
        csgTransactionAuthorityPoisonMappedCompletion(
            verifiedReading,
            completion)
        csgTransactionAuthorityClosePlanningPath(planningAuthority)
    return prepared

@borrows
fn CsgCoreMerklePreparedTransactionIsValid(
        prepared: CsgCoreMerklePreparedTransaction): bool =
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
        prepared.ownerId,
        prepared.epoch,
        prepared.kind,
        prepared.authenticator,
        csgTransactionAuthorityStatePreparedLive):
        csgTransactionAuthorityUnlock()
        return false
    let row = prepared.ownerId - 1
    var pathAuthority: merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthority
    csgTransactionAuthorityLoadPreparedPath(row, pathAuthority)
    let storedLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    let storedAuthoritiesValid =
        !layout.FixedBytes32Equal(
            csgTransactionAuthorityFixed(
                csgTransactionAuthorityRegistry.sealedBeforeBindings,
                row),
            layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            csgTransactionAuthorityFixed(
                csgTransactionAuthorityRegistry.mappedCompletionBindings,
                row),
            layout.FixedBytes32())
    csgTransactionAuthorityUnlock()
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityLineageBinding(
            pathAuthority)
    return storedAuthoritiesValid &&
        !layout.FixedBytes32Equal(
            pathLineageBinding, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            pathLineageBinding, storedLineageBinding) &&
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityIsValid(
            pathAuthority)

fn CsgCoreMerklePreparedTransactionPoison(
        prepared: var CsgCoreMerklePreparedTransaction): str =
    var consumed = prepared
    prepared = CsgCoreMerklePreparedTransaction()
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStatePreparedLive):
        csgTransactionAuthorityUnlock()
        return "merkle_transaction_prepared_poison_invalid"
    let row = consumed.ownerId - 1
    let ownerId = row + 1
    let epoch = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.epochs, row)
    let authenticator = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.authenticators, row)
    let storedLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
        row)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStatePreparedClaimed)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(
        row,
        verified,
        completion)
    csgTransactionAuthorityUnlock()
    csgTransactionAuthorityPoisonMappedCompletion(
        verified,
        completion)
    let terminal =
        merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
            storedLineageBinding)
    if !csgTransactionAuthorityTerminalSucceeded(terminal):
        panic("merkle transaction authority: prepared poison path close failed")
    csgTransactionAuthorityArtifactOwnerRelease(
        csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           ownerId,
           epoch,
           csgTransactionAuthorityKindPrepared,
           authenticator,
           csgTransactionAuthorityStatePreparedClaimed):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: prepared poison rejoin failed")
    csgTransactionAuthorityPublishPoisoned(row)
    csgTransactionAuthorityUnlock()
    return ""

@borrows
fn csgTransactionAuthorityTextCompare(
        left: str,
        right: str): int32 =
    let common = left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn CsgCoreMerkleTransactionArtifactClosureCid(
        artifactCids: str[]): str =
    if artifactCids.len == 0:
        return "invalid:merkle_transaction_artifact_closure_empty"
    var preimage = layout.ByteBufInit(2048)
    csgTransactionAuthorityAppendText(
        preimage, csgTransactionArtifactClosureDomain)
    csgTransactionAuthorityAppendText(
        preimage, strings.IntToStr(artifactCids.len))
    for i in 0..<artifactCids.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               artifactCids[i]) ||
           (i > 0 &&
            csgTransactionAuthorityTextCompare(
                artifactCids[i - 1], artifactCids[i]) >= 0):
            layout.ByteBufFree(preimage)
            return "invalid:merkle_transaction_artifact_closure"
        csgTransactionAuthorityAppendText(preimage, artifactCids[i])
    return csgTransactionAuthorityDigestText(preimage)

@borrows
fn csgTransactionAuthorityContains(
        values: str[],
        value: str): bool =
    for i in 0..<values.len:
        if values[i] == value:
            return true
    return false

@borrows
fn csgTransactionAuthorityPoisonClaimed(
        ownerId: int32,
        epoch: int32,
        authenticator: layout.FixedBytes32) =
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           ownerId,
           epoch,
           csgTransactionAuthorityKindPrepared,
           authenticator,
           csgTransactionAuthorityStatePreparedClaimed):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: claimed poison rejoin failed")
    let row = ownerId - 1
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(
        row, verified, completion)
    csgTransactionAuthorityUnlock()
    csgTransactionAuthorityPoisonMappedCompletion(
        verified, completion)
    csgTransactionAuthorityArtifactOwnerRelease(
        csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           ownerId,
           epoch,
           csgTransactionAuthorityKindPrepared,
           authenticator,
           csgTransactionAuthorityStatePreparedClaimed):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: claimed poison drift")
    csgTransactionAuthorityPublishPoisoned(row)
    csgTransactionAuthorityUnlock()

@borrows
fn csgTransactionAuthorityPrepublishFail(
        error: str): CsgCoreMerkleTransactionPrepublishResult =
    var out: CsgCoreMerkleTransactionPrepublishResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityPrepublishPoisonWithPath(
        ownerId: int32,
        epoch: int32,
        authenticator: layout.FixedBytes32,
        pathLineageBinding: layout.FixedBytes32,
        error: str): CsgCoreMerkleTransactionPrepublishResult =
    let terminal =
        merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
            pathLineageBinding)
    if !csgTransactionAuthorityTerminalSucceeded(terminal):
        panic("merkle transaction authority: session path poison failed")
    csgTransactionAuthorityPoisonClaimed(
        ownerId, epoch, authenticator)
    return csgTransactionAuthorityPrepublishFail(error)

@borrows
fn csgTransactionAuthorityPrepublishClosePreparedPath(
        ownerId: int32,
        epoch: int32,
        authenticator: layout.FixedBytes32,
        pathLineageBinding: layout.FixedBytes32,
        error: str): CsgCoreMerkleTransactionPrepublishResult =
    let terminal =
        merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
            pathLineageBinding)
    if !csgTransactionAuthorityTerminalSucceeded(terminal):
        panic("merkle transaction authority: prepared path close failed")
    csgTransactionAuthorityPoisonClaimed(
        ownerId, epoch, authenticator)
    return csgTransactionAuthorityPrepublishFail(error)

@borrows
fn CsgCoreMerkleTransactionPrepublishVerifyInMemory(
        prepared: var CsgCoreMerklePreparedTransaction):
        CsgCoreMerkleTransactionPrepublishResult =
    var consumed = prepared
    prepared = CsgCoreMerklePreparedTransaction()
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStatePreparedLive):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityPrepublishFail(
            "merkle_transaction_prepublish_prepared_invalid")
    let row = consumed.ownerId - 1
    let claimedOwnerId = row + 1
    let claimedEpoch = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.epochs, row)
    let claimedAuthenticator = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.authenticators, row)
    let storedPreparedLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    let storedCompletionBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.mappedCompletionBindings, row)
    let storedBeforeStoreIdentity = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeStoreIdentities, row)
    let storedBeforeHeadCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeHeadCids, row)
    let storedBeforeManifestCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeManifestCids, row)
    let storedBeforeFactsRoot = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeFactsRoots, row)
    let storedProjectionReceiptCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.projectionReceiptCids, row)
    let storedFinalManifestCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.finalManifestCids, row)
    let storedTransactionReceiptCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.transactionReceiptCids, row)
    let generationLow = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationLow, row)
    let generationHigh = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationHigh, row)
    let storedGeneration =
        (int64(generationHigh) << 32) |
        (int64(generationLow) & int64(4294967295))
    let storedArtifactCount = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.artifactCounts, row)
    let storedFinalManifestOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.finalManifestOrdinals, row)
    let storedTransactionReceiptOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.transactionReceiptOrdinals, row)
    var preparedPathAuthority: merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthority
    csgTransactionAuthorityLoadPreparedPath(row, preparedPathAuthority)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(row, verified, completion)
    let storedShapeValid =
        !layout.FixedBytes32Equal(
            storedPreparedLineageBinding, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            storedCompletionBinding, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            storedProjectionReceiptCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            storedFinalManifestCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            storedTransactionReceiptCid, layout.FixedBytes32()) &&
        storedArtifactCount > 0 &&
        storedFinalManifestOrdinal >= 0 &&
        storedFinalManifestOrdinal < storedArtifactCount &&
        storedTransactionReceiptOrdinal >= 0 &&
        storedTransactionReceiptOrdinal < storedArtifactCount &&
        storedFinalManifestOrdinal != storedTransactionReceiptOrdinal &&
        csgTransactionAuthorityRegistry.artifactOwners[row].artifactCount ==
            storedArtifactCount &&
        csgTransactionAuthorityArtifactOwnerShapeValid(
            csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStatePreparedClaimed)
    csgTransactionAuthorityUnlock()
    if !storedShapeValid:
        return csgTransactionAuthorityPrepublishClosePreparedPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            "merkle_transaction_prepublish_registry_invalid")
    let suppliedPreparedLineageBinding =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityLineageBinding(
            preparedPathAuthority)
    if !layout.FixedBytes32Equal(
           suppliedPreparedLineageBinding,
           storedPreparedLineageBinding) ||
       !merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityIsValid(
           preparedPathAuthority):
        return csgTransactionAuthorityPrepublishClosePreparedPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            "merkle_transaction_prepublish_prepared_path_invalid")
    var movedPath =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityMoveToSession(
            preparedPathAuthority)
    if !movedPath.ok:
        return csgTransactionAuthorityPrepublishClosePreparedPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            movedPath.error)
    var sessionPathAuthority = movedPath.authority
    movedPath.authority =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority()
    let sessionPathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            sessionPathAuthority)
    var receiptStoreIdentity: layout.FixedBytes32
    let sessionPathJoined =
        layout.FixedBytes32Equal(
            sessionPathLineageBinding,
            storedPreparedLineageBinding) &&
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
            sessionPathAuthority) &&
        merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            movedPath.identityReceipt) &&
        csgTransactionAuthorityCidInto(
            movedPath.identityReceipt.beforeStoreIdentity,
            receiptStoreIdentity) &&
        layout.FixedBytes32Equal(
            receiptStoreIdentity,
            storedBeforeStoreIdentity)
    if !sessionPathJoined:
        return csgTransactionAuthorityPrepublishPoisonWithPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            "merkle_transaction_prepublish_session_path_invalid")
    let lockedCompletion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcLockedCompletion(
            completion)
    let completionJoined = lockedCompletion.ok &&
        layout.FixedBytes32Equal(
            completion.binding,
            storedCompletionBinding) &&
        layout.FixedBytes32Equal(
            lockedCompletion.summary.beforeStoreIdentity,
            storedBeforeStoreIdentity) &&
        layout.FixedBytes32Equal(
            lockedCompletion.summary.headCid,
            storedBeforeHeadCid) &&
        layout.FixedBytes32Equal(
            lockedCompletion.summary.manifestCid,
            storedBeforeManifestCid) &&
        layout.FixedBytes32Equal(
            lockedCompletion.summary.factsRoot,
            storedBeforeFactsRoot) &&
        lockedCompletion.summary.storeGeneration == storedGeneration &&
        lockedCompletion.summary.readCount ==
            lockedCompletion.summary.factCount
    if !completionJoined:
        return csgTransactionAuthorityPrepublishPoisonWithPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            "merkle_transaction_prepublish_completion_invalid")
    var sessionAuthenticator: layout.FixedBytes32
    if !csgTransactionAuthorityNonce(sessionAuthenticator) ||
       layout.FixedBytes32Equal(
           sessionAuthenticator, claimedAuthenticator) ||
       layout.FixedBytes32Equal(
           sessionAuthenticator, storedPreparedLineageBinding) ||
       layout.FixedBytes32Equal(
           sessionAuthenticator, storedCompletionBinding):
        return csgTransactionAuthorityPrepublishPoisonWithPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            "merkle_transaction_prepublish_authenticator_failed")
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           claimedOwnerId,
           claimedEpoch,
           csgTransactionAuthorityKindPrepared,
           claimedAuthenticator,
           csgTransactionAuthorityStatePreparedClaimed) ||
       csgTransactionAuthorityI32(
           csgTransactionAuthorityRegistry.artifactCounts, row) !=
           storedArtifactCount ||
       csgTransactionAuthorityI32(
           csgTransactionAuthorityRegistry.finalManifestOrdinals, row) !=
           storedFinalManifestOrdinal ||
       csgTransactionAuthorityI32(
           csgTransactionAuthorityRegistry.transactionReceiptOrdinals, row) !=
           storedTransactionReceiptOrdinal ||
       !layout.FixedBytes32Equal(
           csgTransactionAuthorityFixed(
               csgTransactionAuthorityRegistry.mappedCompletionBindings,
               row),
           storedCompletionBinding) ||
       !csgTransactionAuthorityArtifactOwnerShapeValid(
           csgTransactionAuthorityRegistry.artifactOwners[row]):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityPrepublishPoisonWithPath(
            claimedOwnerId,
            claimedEpoch,
            claimedAuthenticator,
            storedPreparedLineageBinding,
            "merkle_transaction_prepublish_transition_invalid")
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.kinds,
        row,
        csgTransactionAuthorityKindSession)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.authenticators,
        row,
        sessionAuthenticator)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
        row,
        sessionPathLineageBinding)
    csgTransactionAuthorityStoreSessionPath(row, sessionPathAuthority)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateSessionLive)
    csgTransactionAuthorityUnlock()
    var out: CsgCoreMerkleTransactionPrepublishResult
    out.ok = true
    out.session.ownerId = claimedOwnerId
    out.session.epoch = claimedEpoch
    out.session.kind = csgTransactionAuthorityKindSession
    out.session.authenticator =
        layout.FixedBytes32Copy(sessionAuthenticator)
    sessionPathAuthority =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority()
    out.finalManifestCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(storedFinalManifestCid))
    out.projectionReceiptCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(storedProjectionReceiptCid))
    out.transactionReceiptCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(storedTransactionReceiptCid))
    return out
@borrows
fn csgTransactionAuthorityArtifactCommitFail(
        error: str): CsgCoreMerkleTransactionArtifactCommitResult =
    var out: CsgCoreMerkleTransactionArtifactCommitResult
    out.error = strings.CloneStr(error)
    return out

fn csgTransactionAuthorityStoreNextPoisonedFail(
        session: var CsgCoreMerklePrepublishSession,
        error: str): CsgCoreMerkleTransactionArtifactCommitResult =
    let terminalError = CsgCoreMerklePrepublishSessionPoison(session)
    if terminalError.len > 0:
        return csgTransactionAuthorityArtifactCommitFail(
            csgTransactionAuthorityCat(
                csgTransactionAuthorityCat(error, ":terminal:"),
                terminalError))
    return csgTransactionAuthorityArtifactCommitFail(error)

fn csgTransactionAuthorityPoisonArtifactRow(
        ownerId: int32,
        epoch: int32,
        authenticator: layout.FixedBytes32,
        expectedState: int32,
        lineageBinding: layout.FixedBytes32) =
    let row = ownerId - 1
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           ownerId,
           epoch,
           csgTransactionAuthorityKindSession,
           authenticator,
           expectedState):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: artifact poison claim drift")
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateSessionPoisoning)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(
        row, verified, completion)
    csgTransactionAuthorityUnlock()
    csgTransactionAuthorityPoisonMappedCompletion(
        verified, completion)
    let terminal =
        merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
            lineageBinding)
    if !csgTransactionAuthorityTerminalSucceeded(terminal):
        panic("merkle transaction authority: artifact path poison failed")
    csgTransactionAuthorityArtifactOwnerRelease(
        csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           ownerId,
           epoch,
           csgTransactionAuthorityKindSession,
           authenticator,
           csgTransactionAuthorityStateSessionPoisoning):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: artifact poison rejoin failed")
    csgTransactionAuthorityPublishPoisoned(row)
    csgTransactionAuthorityUnlock()

@borrows
fn csgTransactionAuthorityObjectWriteFail(
        error: str): csgTransactionAuthorityObjectWriteResult =
    var out: csgTransactionAuthorityObjectWriteResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityVerifyStoredObject(
        pathAuthority:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        artifactKind: int32,
        objectCid: str,
        expectedBytes: rawbytes.Bytes):
        csgTransactionAuthorityObjectWriteResult =
    let category =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCategory(
            artifactKind)
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(objectCid)
    if category.len == 0 || finalName.len == 0:
        return csgTransactionAuthorityObjectWriteFail(
            "merkle_transaction_object_identity_invalid")
    let opened =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityOpenObjectVerified(
            pathAuthority,
            category,
            finalName)
    if result.IsErr(opened):
        return csgTransactionAuthorityObjectWriteFail(
            result.Error(opened))
    let handle = result.Value(opened)
    let objectFile =
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName()
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(objectFile)])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle transaction authority: object shape close failed")
        return csgTransactionAuthorityObjectWriteFail(
            "merkle_transaction_object_shape_invalid")
    let read = os.AtomicTreeReadStable(handle, objectFile)
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle transaction authority: object read close failed")
    if result.IsErr(read):
        return csgTransactionAuthorityObjectWriteFail(
            result.Error(read))
    var storedBytes = result.Value(read)
    var cidError: str
    let actualCid =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
            artifactKind,
            storedBytes,
            cidError)
    let exactBytes = rawbytes.BytesEqual(storedBytes, expectedBytes)
    rawbytes.BytesFree(storedBytes)
    if cidError.len > 0 || actualCid != objectCid || !exactBytes:
        return csgTransactionAuthorityObjectWriteFail(
            "merkle_transaction_object_readback_mismatch")
    var out: csgTransactionAuthorityObjectWriteResult
    out.ok = true
    return out

@borrows
fn csgTransactionAuthorityAbortObjectWrite(
        handle: os.AtomicTree,
        error: str): csgTransactionAuthorityObjectWriteResult =
    let aborted = os.AtomicTreeAbort(handle)
    if result.IsErr(aborted):
        panic("merkle transaction authority: object abort failed")
    return csgTransactionAuthorityObjectWriteFail(error)

@borrows
fn csgTransactionAuthorityWriteStoredObject(
        pathAuthority:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        artifactKind: int32,
        objectCid: str,
        bytes: rawbytes.Bytes,
        claimAuthenticator: layout.FixedBytes32):
        csgTransactionAuthorityObjectWriteResult =
    let category =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCategory(
            artifactKind)
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(objectCid)
    let byteLimit =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactByteLimit(
            artifactKind)
    var cidError: str
    let actualCid =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
            artifactKind,
            bytes,
            cidError)
    let pathStageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBinding(
            pathAuthority)
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            pathAuthority)
    if category.len == 0 || finalName.len == 0 ||
       byteLimit <= int64(0) ||
       int64(rawbytes.BytesLen(bytes)) <= int64(0) ||
       int64(rawbytes.BytesLen(bytes)) > byteLimit ||
       cidError.len > 0 || actualCid != objectCid ||
       layout.FixedBytes32Equal(
           claimAuthenticator, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           pathStageBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           pathLineageBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           claimAuthenticator, pathStageBinding) ||
       layout.FixedBytes32Equal(
           claimAuthenticator, pathLineageBinding) ||
       !merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
           pathAuthority):
        return csgTransactionAuthorityObjectWriteFail(
            "merkle_transaction_object_candidate_invalid")
    let stagingName = strings.ConcatStr(
        strings.ConcatStr(".transaction-object-", finalName),
        strings.ConcatStr(
            "-", layout.FixedBytes32Hex(claimAuthenticator)))
    let begun =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBeginObjectTransaction(
            pathAuthority,
            category,
            stagingName,
            finalName)
    if result.IsErr(begun):
        return csgTransactionAuthorityObjectWriteFail(
            result.Error(begun))
    let handle = result.Value(begun)
    let objectFile =
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName()
    let write = os.AtomicTreeWriteExclusiveLeaseSync(
        handle,
        objectFile,
        bytes)
    if result.IsErr(write):
        return csgTransactionAuthorityAbortObjectWrite(
            handle, result.Error(write))
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(objectFile)])
    if result.IsErr(exact):
        return csgTransactionAuthorityAbortObjectWrite(
            handle, result.Error(exact))
    let sealed = os.AtomicTreeSealReadOnly(handle, objectFile)
    if result.IsErr(sealed):
        return csgTransactionAuthorityAbortObjectWrite(
            handle, result.Error(sealed))
    let committed = os.AtomicTreeCommitNoReplace(handle)
    if result.IsErr(committed):
        return csgTransactionAuthorityAbortObjectWrite(
            handle, result.Error(committed))
    let commitKind = result.Value(committed)
    if commitKind == os.AtomicTreeDestinationExists:
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle transaction authority: existing object abort failed")
        let verified = csgTransactionAuthorityVerifyStoredObject(
            pathAuthority,
            artifactKind,
            objectCid,
            bytes)
        if !verified.ok:
            return verified
        var reused: csgTransactionAuthorityObjectWriteResult
        reused.ok = true
        reused.reused = true
        return reused
    if commitKind != os.AtomicTreeCommitted &&
       commitKind != os.AtomicTreeCommittedDurabilityUnknown:
        panic("merkle transaction authority: object commit kind invalid")
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle transaction authority: committed object close failed")
    let verified = csgTransactionAuthorityVerifyStoredObject(
        pathAuthority,
        artifactKind,
        objectCid,
        bytes)
    if !verified.ok:
        panic("merkle transaction authority: object readback failed")
    if commitKind == os.AtomicTreeCommittedDurabilityUnknown:
        panic("merkle transaction authority: object durability unknown")
    var out: csgTransactionAuthorityObjectWriteResult
    out.ok = true
    return out

fn CsgCoreMerkleTransactionStoreNextArtifact(
        session: var CsgCoreMerklePrepublishSession):
        CsgCoreMerkleTransactionArtifactCommitResult =
    var consumed = session
    session = CsgCoreMerklePrepublishSession()
    var claimAuthenticator: layout.FixedBytes32
    var nextSessionAuthenticator: layout.FixedBytes32
    if !csgTransactionAuthorityNonce(claimAuthenticator) ||
       !csgTransactionAuthorityNonce(nextSessionAuthenticator):
        return csgTransactionAuthorityStoreNextPoisonedFail(
            consumed,
            "merkle_transaction_store_next_nonce_failed")
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionLive):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityStoreNextPoisonedFail(
            consumed,
            "merkle_transaction_store_next_session_invalid")
    let row = consumed.ownerId - 1
    var pathAuthority: merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority
    csgTransactionAuthorityLoadSessionPath(row, pathAuthority)
    let storedLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
        row)
    csgTransactionAuthorityUnlock()
    let pathStageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBinding(
            pathAuthority)
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            pathAuthority)
    if layout.FixedBytes32Equal(
           pathStageBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           pathLineageBinding, layout.FixedBytes32()) ||
       !merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
           pathAuthority):
        return csgTransactionAuthorityStoreNextPoisonedFail(
            consumed,
            "merkle_transaction_store_next_path_invalid")
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionLive):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityStoreNextPoisonedFail(
            consumed,
            "merkle_transaction_store_next_session_rejoin_invalid")
    let ordinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.nextArtifactOrdinals, row)
    let artifactCount = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.artifactCounts, row)
    if ordinal < 0 || ordinal >= artifactCount ||
       !layout.FixedBytes32Equal(
           pathLineageBinding, storedLineageBinding) ||
       !csgTransactionAuthorityArtifactOwnerShapeValid(
           csgTransactionAuthorityRegistry.artifactOwners[row]) ||
       csgTransactionAuthorityRegistry.artifactOwners[row].artifactCount !=
           artifactCount ||
       layout.FixedBytes32Equal(
           claimAuthenticator, consumed.authenticator) ||
       layout.FixedBytes32Equal(
           claimAuthenticator, pathStageBinding) ||
       layout.FixedBytes32Equal(
           claimAuthenticator, pathLineageBinding) ||
       layout.FixedBytes32Equal(
           nextSessionAuthenticator, consumed.authenticator) ||
       layout.FixedBytes32Equal(
           nextSessionAuthenticator, claimAuthenticator) ||
       layout.FixedBytes32Equal(
           nextSessionAuthenticator, pathStageBinding) ||
       layout.FixedBytes32Equal(
           nextSessionAuthenticator, pathLineageBinding):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityStoreNextPoisonedFail(
            consumed,
            "merkle_transaction_store_next_join_invalid")
    let ownerId = consumed.ownerId
    let epoch = consumed.epoch
    let oldSessionAuthenticator =
        layout.FixedBytes32Copy(consumed.authenticator)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.artifactClaimAuthenticators,
        row,
        claimAuthenticator)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateArtifactClaiming)
    csgTransactionAuthorityUnlock()
    let secondStageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBinding(
            pathAuthority)
    let secondLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            pathAuthority)
    if !layout.FixedBytes32Equal(
           secondStageBinding, pathStageBinding) ||
       !layout.FixedBytes32Equal(
           secondLineageBinding, pathLineageBinding) ||
       !merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
           pathAuthority):
        csgTransactionAuthorityPoisonArtifactRow(
            ownerId,
            epoch,
            oldSessionAuthenticator,
            csgTransactionAuthorityStateArtifactClaiming,
            storedLineageBinding)
        return csgTransactionAuthorityArtifactCommitFail(
            "merkle_transaction_store_next_path_rejoin_failed")
    var kind: int32
    var cid: str
    var bytes: rawbytes.Bytes
    csgTransactionAuthorityArtifactOwnerRead(
        csgTransactionAuthorityRegistry.artifactOwners[row],
        ordinal,
        kind,
        cid,
        bytes)
    let committed = csgTransactionAuthorityWriteStoredObject(
        pathAuthority,
        kind,
        cid,
        bytes,
        claimAuthenticator)
    if !committed.ok:
        rawbytes.BytesFree(bytes)
        csgTransactionAuthorityPoisonArtifactRow(
            ownerId,
            epoch,
            oldSessionAuthenticator,
            csgTransactionAuthorityStateArtifactClaiming,
            storedLineageBinding)
        return csgTransactionAuthorityArtifactCommitFail(committed.error)
    let byteCount = rawbytes.BytesLen(bytes)
    rawbytes.BytesFree(bytes)
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           ownerId,
           epoch,
           csgTransactionAuthorityKindSession,
           oldSessionAuthenticator,
           csgTransactionAuthorityStateArtifactClaiming) ||
       csgTransactionAuthorityI32(
           csgTransactionAuthorityRegistry.nextArtifactOrdinals,
           row) != ordinal ||
       !layout.FixedBytes32Equal(
           csgTransactionAuthorityFixed(
               csgTransactionAuthorityRegistry.artifactClaimAuthenticators,
               row),
           claimAuthenticator) ||
       !layout.FixedBytes32Equal(
           csgTransactionAuthorityFixed(
               csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
               row),
           storedLineageBinding):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: object commit rejoin drift")
    let nextOrdinal = ordinal + 1
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.nextArtifactOrdinals,
        row,
        nextOrdinal)
    if !committed.reused:
        csgTransactionAuthoritySetI32(
            csgTransactionAuthorityRegistry.objectWriteCounts,
            row,
            csgTransactionAuthorityI32(
                csgTransactionAuthorityRegistry.objectWriteCounts,
                row) + 1)
    let objectWriteCount = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.objectWriteCounts, row)
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.artifactClaimAuthenticators,
        row,
        layout.FixedBytes32())
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.authenticators,
        row,
        nextSessionAuthenticator)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateSessionLive)
    csgTransactionAuthorityUnlock()
    session.ownerId = ownerId
    session.epoch = epoch
    session.kind = csgTransactionAuthorityKindSession
    session.authenticator =
        layout.FixedBytes32Copy(nextSessionAuthenticator)
    var out: CsgCoreMerkleTransactionArtifactCommitResult
    out.ok = true
    out.complete = nextOrdinal == artifactCount
    out.nextOrdinal = nextOrdinal
    out.artifactCount = artifactCount
    out.objectWriteCount = objectWriteCount
    out.artifactKind = kind
    out.cid = strings.CloneStr(cid)
    out.reused = committed.reused
    if !committed.reused:
        out.writtenBytes = int64(byteCount)
    return out

@borrows
fn csgTransactionAuthorityCommitSessionFail(
        error: str): CsgCoreMerkleTransactionCommitSessionResult =
    var out: CsgCoreMerkleTransactionCommitSessionResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityHeadCanonicalFail(
        error: str): csgTransactionAuthorityHeadCanonicalInput =
    var out: csgTransactionAuthorityHeadCanonicalInput
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityHeadPhysicalFail(
        error: str): csgTransactionAuthorityHeadPhysicalResult =
    var out: csgTransactionAuthorityHeadPhysicalResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityHeadCanonicalize(
        summary:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionSummary,
        finalManifestBytes: rawbytes.Bytes,
        transactionReceiptBytes: rawbytes.Bytes):
        csgTransactionAuthorityHeadCanonicalInput =
    if summary.storeGeneration < int64(0) ||
       summary.storeGeneration >=
           merkle_store_codec.CsgCoreMerkleStoreMaxGeneration():
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_generation_invalid")
    let manifestDecoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(finalManifestBytes)
    if !manifestDecoded.ok || !manifestDecoded.manifest.complete:
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_manifest_invalid")
    var manifestEncoded =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            manifestDecoded.manifest)
    if !manifestEncoded.ok ||
       manifestEncoded.cid != manifestDecoded.cid ||
       !rawbytes.BytesEqual(manifestEncoded.bytes, finalManifestBytes):
        rawbytes.BytesFree(manifestEncoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_manifest_non_canonical")
    rawbytes.BytesFree(manifestEncoded.bytes)
    var receiptDecoded =
        receipt.CsgCoreMerkleTransactionReceiptDecode(
            transactionReceiptBytes)
    if !receiptDecoded.ok:
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_receipt_invalid")
    let decodedReceipt = receiptDecoded.receipt
    let manifest = manifestDecoded.manifest
    let beforeHeadCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(summary.headCid))
    let beforeManifestCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(summary.manifestCid))
    let beforeFactsRoot = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(summary.factsRoot))
    let beforeDagRootCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(summary.dagRootCid))
    let beforeCsgcDirectoryCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(summary.csgcDirectoryCid))
    let nextGeneration = summary.storeGeneration + int64(1)
    if decodedReceipt.generation != nextGeneration ||
       decodedReceipt.beforeHeadCid != beforeHeadCid ||
       decodedReceipt.beforeManifestCid != beforeManifestCid ||
       decodedReceipt.beforeFactsRoot != beforeFactsRoot ||
       decodedReceipt.beforeDagRootCid != beforeDagRootCid ||
       decodedReceipt.beforeCsgcDirectoryCid != beforeCsgcDirectoryCid ||
       decodedReceipt.beforeFactCount != summary.factCount ||
       decodedReceipt.afterManifestCid != manifestDecoded.cid ||
       decodedReceipt.afterFactsRoot != manifest.factsRoot ||
       decodedReceipt.afterDagRootCid != manifest.dagRootCid ||
       decodedReceipt.afterCsgcDirectoryCid != manifest.csgcDirectoryCid ||
       decodedReceipt.afterFactCount != manifest.factCount:
        rawbytes.BytesFree(receiptDecoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_receipt_completion_mismatch")
    var receiptEncoded =
        receipt.CsgCoreMerkleTransactionReceiptEncode(decodedReceipt)
    if !receiptEncoded.ok ||
       receiptEncoded.cid != receiptDecoded.cid ||
       !rawbytes.BytesEqual(
           receiptEncoded.bytes, transactionReceiptBytes):
        rawbytes.BytesFree(receiptEncoded.bytes)
        rawbytes.BytesFree(receiptDecoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_receipt_non_canonical")
    rawbytes.BytesFree(receiptEncoded.bytes)
    var headEncoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            nextGeneration,
            manifestDecoded.cid,
            beforeHeadCid,
            receiptDecoded.cid)
    if !headEncoded.ok:
        rawbytes.BytesFree(receiptDecoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            headEncoded.error)
    let headDecoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadDecode(
            headEncoded.bytes)
    if !headDecoded.ok ||
       headDecoded.head.generation != nextGeneration ||
       headDecoded.head.manifestCid != manifestDecoded.cid ||
       headDecoded.head.previousHeadCid != beforeHeadCid ||
       headDecoded.head.receiptCid != receiptDecoded.cid ||
       headDecoded.head.headCid != headEncoded.head.headCid:
        rawbytes.BytesFree(headEncoded.bytes)
        rawbytes.BytesFree(receiptDecoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_decode_mismatch")
    var headReencoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            headDecoded.head.generation,
            headDecoded.head.manifestCid,
            headDecoded.head.previousHeadCid,
            headDecoded.head.receiptCid)
    if !headReencoded.ok ||
       headReencoded.head.headCid != headDecoded.head.headCid ||
       !rawbytes.BytesEqual(headReencoded.bytes, headEncoded.bytes):
        rawbytes.BytesFree(headReencoded.bytes)
        rawbytes.BytesFree(headEncoded.bytes)
        rawbytes.BytesFree(receiptDecoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_non_canonical")
    rawbytes.BytesFree(headReencoded.bytes)
    var finalManifestCid: layout.FixedBytes32
    var transactionReceiptCid: layout.FixedBytes32
    var headCid: layout.FixedBytes32
    if !csgTransactionAuthorityCidInto(
           manifestDecoded.cid, finalManifestCid) ||
       !csgTransactionAuthorityCidInto(
           receiptDecoded.cid, transactionReceiptCid) ||
       !csgTransactionAuthorityCidInto(
           headDecoded.head.headCid, headCid):
        rawbytes.BytesFree(headEncoded.bytes)
        rawbytes.BytesFree(receiptDecoded.bytes)
        return csgTransactionAuthorityHeadCanonicalFail(
            "merkle_transaction_head_cid_invalid")
    rawbytes.BytesFree(receiptDecoded.bytes)
    var out: csgTransactionAuthorityHeadCanonicalInput
    out.ok = true
    out.storeGeneration = nextGeneration
    out.finalManifestCid = finalManifestCid
    out.transactionReceiptCid = transactionReceiptCid
    out.headCid = headCid
    out.head = headDecoded.head
    out.headBytes = headEncoded.bytes
    return out

@borrows
fn csgTransactionAuthorityHeadAbort(
        handle: os.AtomicTree,
        error: str): csgTransactionAuthorityHeadPhysicalResult =
    let aborted = os.AtomicTreeAbort(handle)
    if result.IsErr(aborted):
        panic("merkle transaction authority: head abort failed")
    return csgTransactionAuthorityHeadPhysicalFail(error)

@borrows
fn csgTransactionAuthorityHeadVerifyStored(
        pathAuthority:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        finalName: str,
        expectedHead:
            merkle_store_codec.CsgCoreMerkleStoreHeadIdentity,
        expectedBytes: rawbytes.Bytes):
        csgTransactionAuthorityHeadPhysicalResult =
    let opened =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityOpenObjectVerified(
            pathAuthority,
            merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
            finalName)
    if result.IsErr(opened):
        return csgTransactionAuthorityHeadPhysicalFail(
            result.Error(opened))
    let handle = result.Value(opened)
    let headFile =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName()
    let exact = os.AtomicTreeVerifyExact(handle, [], [share(headFile)])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle transaction authority: head shape close failed")
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_stored_shape_invalid")
    let read = os.AtomicTreeReadStable(handle, headFile)
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle transaction authority: head read close failed")
    if result.IsErr(read):
        return csgTransactionAuthorityHeadPhysicalFail(
            result.Error(read))
    var bytes = result.Value(read)
    let decoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadDecode(bytes)
    if !decoded.ok:
        rawbytes.BytesFree(bytes)
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_stored_decode_invalid")
    var reencoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            decoded.head.generation,
            decoded.head.manifestCid,
            decoded.head.previousHeadCid,
            decoded.head.receiptCid)
    let matches = reencoded.ok &&
        decoded.head.generation == expectedHead.generation &&
        decoded.head.manifestCid == expectedHead.manifestCid &&
        decoded.head.previousHeadCid == expectedHead.previousHeadCid &&
        decoded.head.receiptCid == expectedHead.receiptCid &&
        decoded.head.headCid == expectedHead.headCid &&
        reencoded.head.headCid == expectedHead.headCid &&
        rawbytes.BytesEqual(bytes, expectedBytes) &&
        rawbytes.BytesEqual(reencoded.bytes, expectedBytes)
    rawbytes.BytesFree(reencoded.bytes)
    rawbytes.BytesFree(bytes)
    if !matches:
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_stored_mismatch")
    var bindingCid: str
    if !csgTransactionAuthorityTransitionReceiptHeadBindingCid(
           decoded.head.receiptCid,
           decoded.head.previousHeadCid,
           reencoded.head.headCid,
           bindingCid):
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_stored_binding_invalid")
    var out: csgTransactionAuthorityHeadPhysicalResult
    out.ok = true
    return out

fn csgCrashProbeSigstopNumber(): int32 =
    let raw = os.getEnv("CSG_SUCCESSOR_CRASH_SIGSTOP_NUM")
    if raw == "17":
        return 17
    if raw == "19":
        return 19
    return 0

@borrows
fn csgTransactionAuthorityCrashBoundaryPark(
        boundary: str): int32 =
    let armed = os.getEnv("CSG_SUCCESSOR_CRASH_BOUNDARY")
    if !strings.Streq(armed, boundary):
        return 0
    let sigstopNumber = csgCrashProbeSigstopNumber()
    if sigstopNumber == 0:
        return 0
    let line = csgTransactionAuthorityCat(
        csgTransactionAuthorityCat("PARKED ", boundary), "\n")
    os.WriteLine(os.Get_stdout(), line)
    if os.C_fflush(os.Get_stdout()) != 0:
        return -1
    os.Kill(
        os.ProcessId(), sigstopNumber)
    return 0

@borrows
fn csgTransactionAuthorityHeadWritePhysical(
        pathAuthority:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        canonical: csgTransactionAuthorityHeadCanonicalInput,
        nonce: layout.FixedBytes32):
        csgTransactionAuthorityHeadPhysicalResult =
    let predecessorCid = canonical.head.previousHeadCid
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
            predecessorCid)
    if finalName.len == 0:
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_successor_name_invalid")
    let predecessorTail =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthoritySuccessorExists(
            pathAuthority,
            predecessorCid)
    if result.IsErr(predecessorTail):
        return csgTransactionAuthorityHeadPhysicalFail(
            result.Error(predecessorTail))
    if result.Value(predecessorTail):
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_successor_already_present")
    let stagingName = csgTransactionAuthorityCat(
        csgTransactionAuthorityCat(".txn-head-", finalName),
        csgTransactionAuthorityCat(
            "-", layout.FixedBytes32Hex(nonce)))
    let begun =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBeginObjectTransaction(
            pathAuthority,
            merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
            stagingName,
            finalName)
    if result.IsErr(begun):
        return csgTransactionAuthorityHeadPhysicalFail(
            result.Error(begun))
    let handle = result.Value(begun)
    let headFile =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName()
    if csgTransactionAuthorityCrashBoundaryPark(
           "BeforeObjectCommit") != 0:
        panic("merkle transaction authority: crash boundary park failed")
    let write = os.AtomicTreeWriteExclusiveLeaseSync(
        handle, headFile, canonical.headBytes)
    if result.IsErr(write):
        return csgTransactionAuthorityHeadAbort(
            handle, result.Error(write))
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(headFile)])
    if result.IsErr(exact):
        return csgTransactionAuthorityHeadAbort(
            handle, result.Error(exact))
    let sealed = os.AtomicTreeSealReadOnly(handle, headFile)
    if result.IsErr(sealed):
        return csgTransactionAuthorityHeadAbort(
            handle, result.Error(sealed))
    if csgTransactionAuthorityCrashBoundaryPark(
           "AfterObjectCommitBeforeSuccessorRename") != 0:
        panic("merkle transaction authority: crash boundary park failed")
    let committed = os.AtomicTreeCommitNoReplace(handle)
    if result.IsErr(committed):
        return csgTransactionAuthorityHeadAbort(
            handle, result.Error(committed))
    let commitKind = result.Value(committed)
    if commitKind == os.AtomicTreeDestinationExists:
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle transaction authority: head conflict abort failed")
        return csgTransactionAuthorityHeadPhysicalFail(
            "merkle_transaction_head_successor_conflict")
    if commitKind == os.AtomicTreeCommittedDurabilityUnknown:
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle transaction authority: uncertain head close failed")
        panic("merkle transaction authority: head durability unknown")
    if commitKind != os.AtomicTreeCommitted:
        panic("merkle transaction authority: head commit kind invalid")
    if csgTransactionAuthorityCrashBoundaryPark(
           "AfterSuccessorRenameBeforeParentSync") != 0:
        panic("merkle transaction authority: crash boundary park failed")
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle transaction authority: committed head close failed")
    let verified = csgTransactionAuthorityHeadVerifyStored(
        pathAuthority,
        finalName,
        canonical.head,
        canonical.headBytes)
    if !verified.ok:
        panic("merkle transaction authority: committed head readback failed")
    let nextTail =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthoritySuccessorExists(
            pathAuthority,
            canonical.head.headCid)
    if result.IsErr(nextTail) || result.Value(nextTail):
        panic("merkle transaction authority: committed next tail invalid")
    if csgTransactionAuthorityCrashBoundaryPark(
           "AfterParentSync") != 0:
        panic("merkle transaction authority: crash boundary park failed")
    var out: csgTransactionAuthorityHeadPhysicalResult
    out.ok = true
    return out

@borrows
fn csgTransactionAuthorityHeadClaimFail(
        error: str): CsgCoreMerkleTransactionHeadCommitClaimResult =
    var out: CsgCoreMerkleTransactionHeadCommitClaimResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityHeadSummaryFail(
        error: str): CsgCoreMerkleTransactionHeadCommitGrantSummaryResult =
    var out: CsgCoreMerkleTransactionHeadCommitGrantSummaryResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityHeadArtifactsFail(
        error: str): CsgCoreMerkleTransactionHeadCommitArtifactsResult =
    var out: CsgCoreMerkleTransactionHeadCommitArtifactsResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionAuthorityHeadFinalizeFail(
        error: str): CsgCoreMerkleTransactionHeadCommitFinalizeResult =
    var out: CsgCoreMerkleTransactionHeadCommitFinalizeResult
    out.error = strings.CloneStr(error)
    return out

fn csgTransactionAuthorityClaimHeadCommit(
        session: var CsgCoreMerklePrepublishSession):
        CsgCoreMerkleTransactionHeadCommitClaimResult =
    var consumed = session
    session = CsgCoreMerklePrepublishSession()
    var grantAuthenticator: layout.FixedBytes32
    if !csgTransactionAuthorityNonce(grantAuthenticator):
        let terminalError =
            CsgCoreMerklePrepublishSessionPoison(consumed)
        if terminalError.len > 0:
            panic("merkle transaction authority: head claim nonce cleanup failed")
        return csgTransactionAuthorityHeadClaimFail(
            "merkle_transaction_head_claim_nonce_failed")
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionLive):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityHeadClaimFail(
            "merkle_transaction_head_claim_session_invalid")
    let row = consumed.ownerId - 1
    let nextOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.nextArtifactOrdinals, row)
    let artifactCount = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.artifactCounts, row)
    let finalManifestOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.finalManifestOrdinals, row)
    let transactionReceiptOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.transactionReceiptOrdinals, row)
    let pathLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    if artifactCount <= 0 || nextOrdinal != artifactCount ||
       finalManifestOrdinal < 0 || finalManifestOrdinal >= artifactCount ||
       transactionReceiptOrdinal < 0 ||
       transactionReceiptOrdinal >= artifactCount ||
       finalManifestOrdinal == transactionReceiptOrdinal ||
       !csgTransactionAuthorityArtifactOwnerShapeValid(
           csgTransactionAuthorityRegistry.artifactOwners[row]) ||
       csgTransactionAuthorityRegistry.artifactOwners[row].artifactCount !=
           artifactCount ||
       layout.FixedBytes32Equal(
           grantAuthenticator, consumed.authenticator) ||
       layout.FixedBytes32Equal(
           grantAuthenticator, pathLineageBinding):
        csgTransactionAuthorityUnlock()
        let terminalError =
            CsgCoreMerklePrepublishSessionPoison(consumed)
        if terminalError.len > 0:
            panic("merkle transaction authority: head claim validation cleanup failed")
        return csgTransactionAuthorityHeadClaimFail(
            "merkle_transaction_head_claim_completeness_invalid")
    csgTransactionAuthoritySetFixed(
        csgTransactionAuthorityRegistry.authenticators,
        row,
        grantAuthenticator)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateSessionCommitting)
    csgTransactionAuthorityUnlock()
    var grant: CsgCoreMerkleTransactionHeadCommitGrant
    grant.ownerId = consumed.ownerId
    grant.epoch = consumed.epoch
    grant.kind = csgTransactionAuthorityKindSession
    grant.authenticator = layout.FixedBytes32Copy(grantAuthenticator)
    let summary =
        csgTransactionAuthorityLockedHeadCommitGrant(grant)
    var artifacts =
        csgTransactionAuthorityReadHeadCommitArtifacts(grant)
    let joined = summary.ok && artifacts.ok
    rawbytes.BytesFree(artifacts.finalManifestBytes)
    rawbytes.BytesFree(artifacts.transactionReceiptBytes)
    if !joined:
        let summaryError = strings.CloneStr(summary.error)
        let artifactError = strings.CloneStr(artifacts.error)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: head claim rejoin cleanup failed")
        return csgTransactionAuthorityHeadClaimFail(
            summaryError.len > 0 ? summaryError : artifactError)
    var out: CsgCoreMerkleTransactionHeadCommitClaimResult
    out.ok = true
    out.grant = grant
    grant = CsgCoreMerkleTransactionHeadCommitGrant()
    return out

@borrows
fn csgTransactionAuthorityLockedHeadCommitGrant(
        grant: CsgCoreMerkleTransactionHeadCommitGrant):
        CsgCoreMerkleTransactionHeadCommitGrantSummaryResult =
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           grant.ownerId,
           grant.epoch,
           grant.kind,
           grant.authenticator,
           csgTransactionAuthorityStateSessionCommitting):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityHeadSummaryFail(
            "merkle_transaction_head_grant_invalid")
    let row = grant.ownerId - 1
    var pathAuthority: merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority
    csgTransactionAuthorityLoadSessionPath(row, pathAuthority)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(row, verified, completion)
    let storedLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    let finalManifestCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.finalManifestCids, row)
    let transactionReceiptCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.transactionReceiptCids, row)
    let beforeStoreIdentity = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeStoreIdentities, row)
    let beforeHeadCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeHeadCids, row)
    let beforeManifestCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeManifestCids, row)
    let beforeFactsRoot = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeFactsRoots, row)
    let beforeGenerationLow = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationLow, row)
    let beforeGenerationHigh = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationHigh, row)
    csgTransactionAuthorityUnlock()
    let pathStageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBinding(
            pathAuthority)
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            pathAuthority)
    let locked =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcLockedCompletion(
            completion)
    var sourceError: str
    if !merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
           pathAuthority):
        sourceError = "path_invalid"
    elif layout.FixedBytes32Equal(
           pathStageBinding, layout.FixedBytes32()):
        sourceError = "path_stage_binding_invalid"
    elif !layout.FixedBytes32Equal(
           pathLineageBinding, storedLineageBinding):
        sourceError = "path_lineage_mismatch"
    elif !locked.ok:
        sourceError = "completion_invalid"
    elif !layout.FixedBytes32Equal(
           locked.summary.sourceLineageBinding, pathLineageBinding):
        sourceError = "completion_lineage_mismatch"
    elif !layout.FixedBytes32Equal(
           locked.summary.beforeStoreIdentity, beforeStoreIdentity):
        sourceError = "store_identity_mismatch"
    elif !layout.FixedBytes32Equal(
           locked.summary.headCid, beforeHeadCid):
        sourceError = "head_mismatch"
    elif !layout.FixedBytes32Equal(
           locked.summary.manifestCid, beforeManifestCid):
        sourceError = "manifest_mismatch"
    elif !layout.FixedBytes32Equal(
           locked.summary.factsRoot, beforeFactsRoot):
        sourceError = "facts_root_mismatch"
    elif int32(
           locked.summary.storeGeneration & int64(4294967295)) !=
           beforeGenerationLow ||
         int32(
           (locked.summary.storeGeneration >> 32) &
               int64(4294967295)) != beforeGenerationHigh:
        sourceError = "generation_mismatch"
    elif layout.FixedBytes32Equal(
           finalManifestCid, layout.FixedBytes32()):
        sourceError = "final_manifest_invalid"
    elif layout.FixedBytes32Equal(
           transactionReceiptCid, layout.FixedBytes32()):
        sourceError = "transaction_receipt_invalid"
    if sourceError.len > 0:
        return csgTransactionAuthorityHeadSummaryFail(
            csgTransactionAuthorityCat(
                "merkle_transaction_head_grant_source_invalid ",
                sourceError))
    csgTransactionAuthorityLock()
    let rejoined = csgTransactionAuthorityHandleMatches(
        grant.ownerId,
        grant.epoch,
        grant.kind,
        grant.authenticator,
        csgTransactionAuthorityStateSessionCommitting)
    csgTransactionAuthorityUnlock()
    if !rejoined:
        return csgTransactionAuthorityHeadSummaryFail(
            "merkle_transaction_head_grant_rejoin_invalid")
    var out: CsgCoreMerkleTransactionHeadCommitGrantSummaryResult
    out.ok = true
    out.summary.transactionOwnerId = grant.ownerId
    out.summary.transactionEpoch = grant.epoch
    out.summary.grantAuthenticator =
        layout.FixedBytes32Copy(grant.authenticator)
    out.summary.pathStageBinding =
        layout.FixedBytes32Copy(pathStageBinding)
    out.summary.pathLineageBinding =
        layout.FixedBytes32Copy(pathLineageBinding)
    out.summary.finalManifestCid =
        layout.FixedBytes32Copy(finalManifestCid)
    out.summary.transactionReceiptCid =
        layout.FixedBytes32Copy(transactionReceiptCid)
    out.summary.completion = locked.summary
    return out

@borrows
fn csgTransactionAuthorityReadHeadCommitArtifacts(
        grant: CsgCoreMerkleTransactionHeadCommitGrant):
        CsgCoreMerkleTransactionHeadCommitArtifactsResult =
    let locked = csgTransactionAuthorityLockedHeadCommitGrant(grant)
    if !locked.ok:
        return csgTransactionAuthorityHeadArtifactsFail(locked.error)
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           grant.ownerId,
           grant.epoch,
           grant.kind,
           grant.authenticator,
           csgTransactionAuthorityStateSessionCommitting):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityHeadArtifactsFail(
            "merkle_transaction_head_artifacts_grant_invalid")
    let row = grant.ownerId - 1
    let finalManifestOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.finalManifestOrdinals, row)
    let transactionReceiptOrdinal = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.transactionReceiptOrdinals, row)
    csgTransactionAuthorityUnlock()
    var finalManifestKind: int32
    var finalManifestCid: str
    var finalManifestBytes: rawbytes.Bytes
    csgTransactionAuthorityArtifactOwnerRead(
        csgTransactionAuthorityRegistry.artifactOwners[row],
        finalManifestOrdinal,
        finalManifestKind,
        finalManifestCid,
        finalManifestBytes)
    var transactionReceiptKind: int32
    var transactionReceiptCid: str
    var transactionReceiptBytes: rawbytes.Bytes
    csgTransactionAuthorityArtifactOwnerRead(
        csgTransactionAuthorityRegistry.artifactOwners[row],
        transactionReceiptOrdinal,
        transactionReceiptKind,
        transactionReceiptCid,
        transactionReceiptBytes)
    var finalManifestDigest: layout.FixedBytes32
    var transactionReceiptDigest: layout.FixedBytes32
    let exact = finalManifestKind ==
            merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind() &&
        transactionReceiptKind ==
            merkle_store_artifact_codec.CsgCoreMerkleStoreReceiptArtifactKind() &&
        csgTransactionAuthorityCidInto(
            finalManifestCid, finalManifestDigest) &&
        csgTransactionAuthorityCidInto(
            transactionReceiptCid, transactionReceiptDigest) &&
        layout.FixedBytes32Equal(
            finalManifestDigest, locked.summary.finalManifestCid) &&
        layout.FixedBytes32Equal(
            transactionReceiptDigest,
            locked.summary.transactionReceiptCid)
    if !exact:
        rawbytes.BytesFree(finalManifestBytes)
        rawbytes.BytesFree(transactionReceiptBytes)
        return csgTransactionAuthorityHeadArtifactsFail(
            "merkle_transaction_head_artifacts_identity_invalid")
    var out: CsgCoreMerkleTransactionHeadCommitArtifactsResult
    out.ok = true
    out.finalManifestBytes = finalManifestBytes
    out.transactionReceiptBytes = transactionReceiptBytes
    return out

fn csgTransactionAuthorityHeadCommitGrantPoison(
        grant: var CsgCoreMerkleTransactionHeadCommitGrant): str =
    var consumed = grant
    grant = CsgCoreMerkleTransactionHeadCommitGrant()
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionCommitting):
        csgTransactionAuthorityUnlock()
        return "merkle_transaction_head_grant_poison_invalid"
    let row = consumed.ownerId - 1
    let lineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateSessionPoisoning)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(row, verified, completion)
    csgTransactionAuthorityUnlock()
    csgTransactionAuthorityPoisonMappedCompletion(verified, completion)
    let terminal =
        merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
            lineageBinding)
    if !csgTransactionAuthorityTerminalSucceeded(terminal):
        panic("merkle transaction authority: head grant path poison failed")
    csgTransactionAuthorityArtifactOwnerRelease(
        csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           csgTransactionAuthorityKindSession,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionPoisoning):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: head grant poison rejoin failed")
    csgTransactionAuthorityPublishPoisoned(row)
    csgTransactionAuthorityUnlock()
    return ""

@borrows
fn csgTransactionAuthorityHeadStoredMatches(
        pathAuthority:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        beforeHeadCid: layout.FixedBytes32,
        beforeGeneration: int64,
        expected:
            CsgCoreMerkleTransactionHeadCommitFinalizeExpectation): bool =
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
            csgTransactionAuthorityCat(
                "sha256:", layout.FixedBytes32Hex(beforeHeadCid)))
    if finalName.len == 0:
        return false
    let opened =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityOpenObjectVerified(
            pathAuthority,
            merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
            finalName)
    if result.IsErr(opened):
        return false
    let handle = result.Value(opened)
    let exact = os.AtomicTreeVerifyExact(
        handle,
        [],
        [merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName()])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle transaction authority: head shape close failed")
        return false
    let read = os.AtomicTreeReadStable(
        handle,
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName())
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle transaction authority: head stable close failed")
    if result.IsErr(read):
        return false
    var bytes = result.Value(read)
    let decoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadDecode(bytes)
    let finalManifestCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(expected.finalManifestCid))
    let transactionReceiptCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(expected.transactionReceiptCid))
    let headCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(expected.headCid))
    var reencoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            decoded.head.generation,
            decoded.head.manifestCid,
            decoded.head.previousHeadCid,
            decoded.head.receiptCid)
    let matches = decoded.ok && reencoded.ok &&
        decoded.head.generation == beforeGeneration + int64(1) &&
        decoded.head.manifestCid == finalManifestCid &&
        decoded.head.previousHeadCid == csgTransactionAuthorityCat(
            "sha256:", layout.FixedBytes32Hex(beforeHeadCid)) &&
        decoded.head.receiptCid == transactionReceiptCid &&
        decoded.head.headCid == headCid &&
        reencoded.head.headCid == headCid &&
        rawbytes.BytesEqual(reencoded.bytes, bytes)
    rawbytes.BytesFree(reencoded.bytes)
    rawbytes.BytesFree(bytes)
    return matches

fn csgTransactionAuthorityFinalizeHeadCommitGrant(
        grant: var CsgCoreMerkleTransactionHeadCommitGrant,
        expected:
            CsgCoreMerkleTransactionHeadCommitFinalizeExpectation):
        CsgCoreMerkleTransactionHeadCommitFinalizeResult =
    var consumed = grant
    grant = CsgCoreMerkleTransactionHeadCommitGrant()
    if layout.FixedBytes32Equal(
           expected.finalManifestCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           expected.transactionReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(expected.headCid, layout.FixedBytes32()):
        var invalidGrant = consumed
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(invalidGrant)
        if poisonError.len > 0:
            panic("merkle transaction authority: invalid finalize cleanup failed")
        return csgTransactionAuthorityHeadFinalizeFail(
            "merkle_transaction_head_finalize_expectation_invalid")
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionCommitting):
        csgTransactionAuthorityUnlock()
        return csgTransactionAuthorityHeadFinalizeFail(
            "merkle_transaction_head_finalize_grant_invalid")
    let row = consumed.ownerId - 1
    let storedFinalManifestCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.finalManifestCids, row)
    let storedTransactionReceiptCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.transactionReceiptCids, row)
    let beforeHeadCid = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.beforeHeadCids, row)
    let beforeGenerationLow = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationLow, row)
    let beforeGenerationHigh = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.beforeStoreGenerationHigh, row)
    let beforeGeneration =
        (int64(beforeGenerationHigh) << 32) |
        (int64(beforeGenerationLow) & int64(4294967295))
    let sealedBeforeBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.sealedBeforeBindings, row)
    let lineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    var pathAuthority: merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority
    csgTransactionAuthorityLoadSessionPath(row, pathAuthority)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(row, verified, completion)
    let expectationMatches = layout.FixedBytes32Equal(
            expected.finalManifestCid, storedFinalManifestCid) &&
        layout.FixedBytes32Equal(
            expected.transactionReceiptCid, storedTransactionReceiptCid)
    csgTransactionAuthorityUnlock()
    if !expectationMatches ||
       !csgTransactionAuthorityHeadStoredMatches(
           pathAuthority,
           beforeHeadCid,
           beforeGeneration,
           expected):
        var unmatchedGrant = consumed
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(unmatchedGrant)
        if poisonError.len > 0:
            panic("merkle transaction authority: finalize mismatch cleanup failed")
        return csgTransactionAuthorityHeadFinalizeFail(
            "merkle_transaction_head_finalize_physical_mismatch")
    let verifiedTerminal =
        merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadConsume(
            verified,
            sealedBeforeBinding)
    if !csgTransactionAuthorityAdmissionTerminalSucceeded(
           verifiedTerminal):
        let completionError =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                completion)
        if completionError.len > 0:
            panic("merkle transaction authority: finalize verified cleanup failed")
        let pathTerminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
                lineageBinding)
        if !csgTransactionAuthorityTerminalSucceeded(pathTerminal):
            panic("merkle transaction authority: finalize verified path cleanup failed")
        csgTransactionAuthorityArtifactOwnerRelease(
            csgTransactionAuthorityRegistry.artifactOwners[row])
        csgTransactionAuthorityLock()
        csgTransactionAuthorityPublishPoisoned(row)
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: verified consume after head failed")
    let completionError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcConsumeCompletion(
            completion)
    if completionError.len > 0:
        let pathTerminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
                lineageBinding)
        if !csgTransactionAuthorityTerminalSucceeded(pathTerminal):
            panic("merkle transaction authority: finalize completion path cleanup failed")
        csgTransactionAuthorityArtifactOwnerRelease(
            csgTransactionAuthorityRegistry.artifactOwners[row])
        csgTransactionAuthorityLock()
        csgTransactionAuthorityPublishPoisoned(row)
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: completion consume after head failed")
    let pathCloseError =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityClose(
            pathAuthority)
    if pathCloseError.len > 0:
        csgTransactionAuthorityArtifactOwnerRelease(
            csgTransactionAuthorityRegistry.artifactOwners[row])
        csgTransactionAuthorityLock()
        csgTransactionAuthorityPublishPoisoned(row)
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: path close after head failed")
    csgTransactionAuthorityArtifactOwnerRelease(
        csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           csgTransactionAuthorityKindSession,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionCommitting):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: finalize publication rejoin failed")
    csgTransactionAuthorityPublishCommitted(row)
    csgTransactionAuthorityUnlock()
    var out: CsgCoreMerkleTransactionHeadCommitFinalizeResult
    out.ok = true
    return out

fn CsgCoreMerkleTransactionCommitSession(
        session: var CsgCoreMerklePrepublishSession):
        CsgCoreMerkleTransactionCommitSessionResult =
    var claimed = csgTransactionAuthorityClaimHeadCommit(session)
    if !claimed.ok:
        return csgTransactionAuthorityCommitSessionFail(
            claimed.error)
    var grant = claimed.grant
    claimed.grant = CsgCoreMerkleTransactionHeadCommitGrant()
    let locked =
        csgTransactionAuthorityLockedHeadCommitGrant(grant)
    var artifacts =
        csgTransactionAuthorityReadHeadCommitArtifacts(grant)
    if !locked.ok || !artifacts.ok:
        let inputError = locked.error.len > 0 ?
            strings.CloneStr(locked.error) :
            strings.CloneStr(artifacts.error)
        rawbytes.BytesFree(artifacts.finalManifestBytes)
        rawbytes.BytesFree(artifacts.transactionReceiptBytes)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: head input cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(inputError)
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           grant.ownerId,
           grant.epoch,
           grant.kind,
           grant.authenticator,
           csgTransactionAuthorityStateSessionCommitting):
        csgTransactionAuthorityUnlock()
        rawbytes.BytesFree(artifacts.finalManifestBytes)
        rawbytes.BytesFree(artifacts.transactionReceiptBytes)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: head path cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(
            "merkle_transaction_head_path_grant_invalid")
    var pathAuthority: merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority
    csgTransactionAuthorityLoadSessionPath(
        grant.ownerId - 1, pathAuthority)
    csgTransactionAuthorityUnlock()
    let pathStageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBinding(
            pathAuthority)
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            pathAuthority)
    let pathExact =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
            pathAuthority) &&
        layout.FixedBytes32Equal(
            pathStageBinding, locked.summary.pathStageBinding) &&
        layout.FixedBytes32Equal(
            pathLineageBinding, locked.summary.pathLineageBinding) &&
        layout.FixedBytes32Equal(
            locked.summary.completion.sourceLineageBinding,
            pathLineageBinding)
    if !pathExact:
        rawbytes.BytesFree(artifacts.finalManifestBytes)
        rawbytes.BytesFree(artifacts.transactionReceiptBytes)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: invalid head path cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(
            "merkle_transaction_head_path_identity_invalid")
    var canonical = csgTransactionAuthorityHeadCanonicalize(
        locked.summary.completion,
        artifacts.finalManifestBytes,
        artifacts.transactionReceiptBytes)
    rawbytes.BytesFree(artifacts.finalManifestBytes)
    rawbytes.BytesFree(artifacts.transactionReceiptBytes)
    if !canonical.ok:
        let canonicalError = strings.CloneStr(canonical.error)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: canonical head cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(canonicalError)
    if !layout.FixedBytes32Equal(
           canonical.finalManifestCid,
           locked.summary.finalManifestCid) ||
       !layout.FixedBytes32Equal(
           canonical.transactionReceiptCid,
           locked.summary.transactionReceiptCid):
        rawbytes.BytesFree(canonical.headBytes)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: head CID cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(
            "merkle_transaction_head_artifact_cid_mismatch")
    var nonce: layout.FixedBytes32
    if !csgTransactionAuthorityNonce(nonce) ||
       layout.FixedBytes32Equal(nonce, grant.authenticator) ||
       layout.FixedBytes32Equal(nonce, pathStageBinding) ||
       layout.FixedBytes32Equal(nonce, pathLineageBinding) ||
       layout.FixedBytes32Equal(
           nonce, locked.summary.completion.completionBinding) ||
       layout.FixedBytes32Equal(nonce, canonical.finalManifestCid) ||
       layout.FixedBytes32Equal(
           nonce, canonical.transactionReceiptCid) ||
       layout.FixedBytes32Equal(nonce, canonical.headCid):
        rawbytes.BytesFree(canonical.headBytes)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: head nonce cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(
            "merkle_transaction_head_nonce_invalid")
    let written = csgTransactionAuthorityHeadWritePhysical(
        pathAuthority,
        canonical,
        nonce)
    rawbytes.BytesFree(canonical.headBytes)
    if !written.ok:
        let writeError = strings.CloneStr(written.error)
        let poisonError =
            csgTransactionAuthorityHeadCommitGrantPoison(grant)
        if poisonError.len > 0:
            panic("merkle transaction authority: head write cleanup failed")
        return csgTransactionAuthorityCommitSessionFail(writeError)
    var expected: CsgCoreMerkleTransactionHeadCommitFinalizeExpectation
    expected.finalManifestCid =
        layout.FixedBytes32Copy(canonical.finalManifestCid)
    expected.transactionReceiptCid =
        layout.FixedBytes32Copy(canonical.transactionReceiptCid)
    expected.headCid = layout.FixedBytes32Copy(canonical.headCid)
    let finalized = csgTransactionAuthorityFinalizeHeadCommitGrant(
        grant,
        expected)
    if !finalized.ok:
        panic("merkle transaction authority: finalize after head commit failed")
    var out: CsgCoreMerkleTransactionCommitSessionResult
    out.ok = true
    out.finalManifestCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(expected.finalManifestCid))
    out.transactionReceiptCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(expected.transactionReceiptCid))
    out.headCid = csgTransactionAuthorityCat(
        "sha256:", layout.FixedBytes32Hex(expected.headCid))
    return out

@borrows
fn CsgCoreMerklePrepublishSessionIsValid(
        session: CsgCoreMerklePrepublishSession): bool =
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
        session.ownerId,
        session.epoch,
        session.kind,
        session.authenticator,
        csgTransactionAuthorityStateSessionLive):
        csgTransactionAuthorityUnlock()
        return false
    let row = session.ownerId - 1
    var pathAuthority: merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority
    csgTransactionAuthorityLoadSessionPath(row, pathAuthority)
    let storedLineageBinding = csgTransactionAuthorityFixed(
        csgTransactionAuthorityRegistry.pathAuthorityLineageBindings, row)
    csgTransactionAuthorityUnlock()
    let pathLineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            pathAuthority)
    return !layout.FixedBytes32Equal(
            pathLineageBinding, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            pathLineageBinding, storedLineageBinding) &&
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
            pathAuthority)

fn CsgCoreMerklePrepublishSessionPoison(
        session: var CsgCoreMerklePrepublishSession): str =
    var consumed = session
    session = CsgCoreMerklePrepublishSession()
    csgTransactionAuthorityEnsureRegistry()
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           consumed.ownerId,
           consumed.epoch,
           consumed.kind,
           consumed.authenticator,
           csgTransactionAuthorityStateSessionLive):
        csgTransactionAuthorityUnlock()
        return "merkle_transaction_session_poison_invalid"
    let row = consumed.ownerId - 1
    let claimedOwnerId = row + 1
    let claimedEpoch = csgTransactionAuthorityI32(
        csgTransactionAuthorityRegistry.epochs, row)
    let claimedAuthenticator =
        csgTransactionAuthorityFixed(
            csgTransactionAuthorityRegistry.authenticators, row)
    let storedPathLineageBinding =
        csgTransactionAuthorityFixed(
            csgTransactionAuthorityRegistry.pathAuthorityLineageBindings,
            row)
    csgTransactionAuthoritySetI32(
        csgTransactionAuthorityRegistry.states,
        row,
        csgTransactionAuthorityStateSessionPoisoning)
    var verified: merkle_admission.CsgCoreMerkleSealedBeforeVerifiedReadToken
    var completion: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    csgTransactionAuthorityLoadMappedCompletion(
        row, verified, completion)
    csgTransactionAuthorityUnlock()
    csgTransactionAuthorityPoisonMappedCompletion(
        verified, completion)
    let terminal =
        merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
            storedPathLineageBinding)
    if !csgTransactionAuthorityTerminalSucceeded(terminal):
        panic("merkle transaction authority: session path poison failed")
    csgTransactionAuthorityArtifactOwnerRelease(
        csgTransactionAuthorityRegistry.artifactOwners[row])
    csgTransactionAuthorityLock()
    if !csgTransactionAuthorityHandleMatches(
           claimedOwnerId,
           claimedEpoch,
           csgTransactionAuthorityKindSession,
           claimedAuthenticator,
           csgTransactionAuthorityStateSessionPoisoning):
        csgTransactionAuthorityUnlock()
        panic("merkle transaction authority: session poison rejoin failed")
    csgTransactionAuthorityPublishPoisoned(row)
    csgTransactionAuthorityUnlock()
    return ""
