        "csg_core.semantic_replace_carrier.v1"
    csgTransactionArtifactClosureDomain: str =
        "csg_core.transaction_artifact_closure.v1"
    csgTransactionTransitionReceiptHeadBindingDomain: str =
        "csg_core.store.transition_receipt_head_binding"
    csgTransactionAuthorityRegistrySlotCount: int32 = 128
    csgTransactionAuthorityRegistryPayloadBytes: int32 = 78336
    csgTransactionAuthorityRegistryAllocationCount: int32 = 34
    csgTransactionAuthorityEpochMax: int32 = 2147483647
    csgTransactionAuthorityRegistryEmpty: int32 = 0
    csgTransactionAuthorityRegistryBuilding: int32 = 1
    csgTransactionAuthorityRegistryReady: int32 = 2
    csgTransactionAuthorityRegistryFailed: int32 = 3
    csgTransactionAuthorityKindPrepared: int32 = 1
    csgTransactionAuthorityKindSession: int32 = 2
    csgTransactionAuthorityStateEmpty: int32 = 0
    csgTransactionAuthorityStatePreparedLive: int32 = 1
    csgTransactionAuthorityStatePreparedClaimed: int32 = 2
    csgTransactionAuthorityStateSessionLive: int32 = 3
    csgTransactionAuthorityStatePrepareClaimed: int32 = 4
    csgTransactionAuthorityStateSessionPoisoning: int32 = 5
    csgTransactionAuthorityStateArtifactClaiming: int32 = 6
    csgTransactionAuthorityStateArtifactClaimed: int32 = 7
    csgTransactionAuthorityStateCommitted: int32 = 8
    csgTransactionAuthorityStatePoisoned: int32 = 9
    csgTransactionAuthorityStateSessionCommitting: int32 = 10
    csgTransactionAuthorityArtifactCountLimit: int32 = 524288
    csgTransactionAuthorityArtifactArenaByteLimit: int64 = 536870912

type
    CsgCoreMerkleTransactionArtifactInput =
        kind: int32
        cid: str
        bytes: rawbytes.Bytes

    CsgCoreMerkleTransactionSemanticInput =
        operation: operation.CsgCoreMerkleTransactionOperation
        operationCid: str
        proofCid: str
        request: request.CsgCoreMerkleTransactionRequest
        baseArtifacts: CsgCoreMerkleTransactionArtifactInput[]
        skeleton:
            merkle_manifest.CsgCoreMerkleSemanticManifestSkeleton

    CsgCoreMerkleTransactionSemanticVerifyResult =
        ok: bool
        error: str
        semanticCarrierCid: str
        semanticManifestSkeletonCid: str
        semanticPlanRoot: str

    CsgCoreMerklePreparedTransaction =
        ownerId: int32
        epoch: int32
        kind: int32
        authenticator: layout.FixedBytes32

    CsgCoreMerklePrepublishSession =
        ownerId: int32
        epoch: int32
        kind: int32
        authenticator: layout.FixedBytes32

    CsgCoreMerkleTransactionHeadCommitGrant =
        ownerId: int32
        epoch: int32
        kind: int32
        authenticator: layout.FixedBytes32

    CsgCoreMerkleTransactionHeadCommitClaimResult =
        ok: bool
        error: str
        grant: CsgCoreMerkleTransactionHeadCommitGrant

    CsgCoreMerkleTransactionHeadCommitGrantSummary =
        transactionOwnerId: int32
        transactionEpoch: int32
        grantAuthenticator: layout.FixedBytes32
        pathStageBinding: layout.FixedBytes32
        pathLineageBinding: layout.FixedBytes32
        finalManifestCid: layout.FixedBytes32
        transactionReceiptCid: layout.FixedBytes32
        completion:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionSummary

    CsgCoreMerkleTransactionHeadCommitGrantSummaryResult =
        ok: bool
        error: str
        summary: CsgCoreMerkleTransactionHeadCommitGrantSummary

    CsgCoreMerkleTransactionHeadCommitArtifactsResult =
        ok: bool
