# plugin_trade_record — 插件单元 CSG 链交易对象纯值 codec (S4-C, 纯加法)。
# 设计: /dev 设计卷 step4-fetch-design-20260827 DESIGN.md §2 (交易对象形态)。
# 上游先例: csg_core/identity.cheng (Issue→IsValid 重算自检闭环 :199-253)、
# merkle_transaction_receipt.cheng (kind/域标签拼写纪律 :13-18 + Max 上限常量
# 纪律 :23-30)、backend2_plugin_cid.cheng (严格 Decode 逐字节游标范式 :216-321)。
#
# 铁律 (同 backend2_plugin_cid 头注): 零 import 编译器状态 — 只允许 std /
# layout / hash256 / csg_core/identity / backend2_cid / backend2_plugin_cid,
# 全部纯函数, 无模块级可变态。IO 不住这里: 链解析/下载在取件客户端层
# csg_plugin_pickup.cheng (S4-C), 本模块只做 record 的构造/互证/编解码。
#
# 本 record 是 capability 交易对象的 payload; 它本身不进 merkle store, 由发
# 布方作为一次 merkle transaction 的 operation payload 上链 (复用
# merkle_transaction_receipt 的 operationCid/proofCid 机制, 本模块不重做账
# 本)。发布半 (回填 issuanceProofCid 后二次 Encode 固化) 落位 cheng-fusion
# 正式仓 (plan Step5), 映射关系冻结在设计 §2.3。
#
# 自指 tradeCid: 其余全部字段按线序 (域标签 + formatVersion + 除 tradeCidHex
# 外的声明序字段) 重算 sha256 == tradeCidHex。Issue 构造期自检与领取后复检
# 共用同一重算函数 ChengPluginTradeRecordVerifySelfCid (identity IsValid 同
# 构: 不是信字段, 而是整条重造再逐字段比对)。重算不等 = 身份校验失败 =
# panic (csg_pickup_trade_cid_recompute_mismatch), 绝不走 Err。
#
# Err/panic 边界 (§4 不变量镜像): Err 只表示「结构不可用/构造入参非法」
# (Decode 严格模式逐字上抛 / Issue 入参守卫); 一切身份与互证校验失败
# (self-cid / record↔receipt 三方相等 / provenance) panic, 绝不用 Err 吞。
#
# T6 裁定 (设计 §7 要求实施 commit 显式二选一, 禁并存): 链件入缓存走
# 「record→receipt 降格映射」— ChengPluginTradeRecordDemoteToReceipt 按
# chain-origin 行构造 PluginPickupReceipt 后即与本地/缓存件共用同一
# Store/LoadCached/VerifyGates 路径, 不把 record 直携进 Store。理由: record
# 直携会 fork 存储路径, 破坏「同构 receipt 无 origin 分叉」的机械保证 (设计
# §3 三点)。
#
# 参数形态 (stage3 方言铁律, 同 S4-A/B): 只读 str / rawbytes.Bytes 一律
# @borrows 值传; var 仅留给 record/receipt 结构体 (与 pcid 校验原语同形)。

import std/result
import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/identity
import cheng/core/backend2/backend2_cid as b2cid
import cheng/core/backend2/backend2_plugin_cid as pcid

const
    ChengPluginTradeKind: str = "cheng.codegen.plugin_trade.v1"
    ChengPluginTradeDomainTag: str = "cheng.backend2.plugin.trade_record"
    # 256MiB 上限, 溢出拒发 (设计 §2.2 冻结)
    ChengPluginTradeMaxArtifactBytes: int64 = 268435456
    chengPluginTradeFormatVersion: int32 = 1

# 构造入参守卫错误族 (Issue 返回 Err; "invalid:" 前缀纪律镜像 identity.cheng
# :131-136; 逐常量冻结, 设计 §2.2)
const
    ChengPluginTradeErrorQuadMissing: str =
        "invalid:cheng_plugin_trade_quad_missing"
    ChengPluginTradeErrorZeroClosureOrCompilerHash: str =
        "invalid:cheng_plugin_trade_zero_closure_or_compiler_hash"
    ChengPluginTradeErrorBadContractVersion: str =
        "invalid:cheng_plugin_trade_bad_contract_version"
    ChengPluginTradeErrorArtifactTooLarge: str =
        "invalid:cheng_plugin_trade_artifact_too_large"
    ChengPluginTradeErrorEmptySigner: str =
        "invalid:cheng_plugin_trade_empty_signer"
    ChengPluginTradeErrorIssuanceProofCid: str =
        "invalid:cheng_plugin_trade_issuance_proof_cid"
    ChengPluginTradeErrorIssuerGeneration: str =
        "invalid:cheng_plugin_trade_issuer_generation"

# 线格式结构错误族 (Decode 严格模式 Err; 命名镜像 backend2_plugin_cid receipt
# 族; 逐常量冻结)
const
    ChengPluginTradeErrorTruncated: str = "csg_pickup_trade_truncated"
    ChengPluginTradeErrorTrailingBytes: str = "csg_pickup_trade_trailing_bytes"
    ChengPluginTradeErrorBadDomainTag: str = "csg_pickup_trade_bad_domain_tag"
    ChengPluginTradeErrorBadFormatVersion: str =
        "csg_pickup_trade_bad_format_version"
    ChengPluginTradeErrorBadKind: str = "csg_pickup_trade_bad_kind"
    ChengPluginTradeErrorBadTradeCidHex: str =
        "csg_pickup_trade_bad_trade_cid_hex"
    ChengPluginTradeErrorBadContentCid: str =
        "csg_pickup_trade_bad_content_cid"
    ChengPluginTradeErrorBadIssuanceProofCid: str =
        "csg_pickup_trade_bad_issuance_proof_cid"
    ChengPluginTradeErrorEmptyTargetTriple: str =
        "csg_pickup_trade_empty_target_triple"
    ChengPluginTradeDecodeBadContractVersion: str =
        "csg_pickup_trade_bad_contract_version"
    ChengPluginTradeErrorBadByteCount: str = "csg_pickup_trade_bad_byte_count"

type
    ChengPluginTradeRecord =
        kind: str                          # 恒 ChengPluginTradeKind
        tradeCidHex: str                   # 自指: 其余字段重算 == 自身
        # ---- D2 四元组 (逐字对应 PluginPickupReceipt 四槽) ----
        sourceClosureHash: layout.FixedBytes32
        compilerHash: layout.FixedBytes32
        targetTriple: str
        contractVersion: int32
        # ---- artifact 绑定 ----
        artifactByteCount: int64
        artifactSha256: layout.FixedBytes32            # 裸 32B (字节门锚点)
        artifactContentCid: str            # 71 字符 "sha256:<hex>" 形, bind 互证
        # ---- provenance / issuance ----
        issuedBySignerId: str              # 链签发者 ID; 私有 registry 命中才算授权
        issuanceProofCid: str              # 链上 issuance fact 的 proofCid (71 字符形)
        issuerGeneration: int64            # (owner_id, generation) 流转键代数成分

# ---- 内部 append 族 (复用 b2cid 转发别名; int64 为本模块唯一私有增量) ----

# LE 字节序 (append 族纪律); UInt64 移位范式镜像
# tooling/compiler_execution_stage_receipt.cheng AppendU64BE (既有方言先例)
fn chengPluginTradeAppendI64(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))

# ---- 自指 tradeCid: 域标签 + formatVersion + 除 tradeCidHex 外全部声明序字段 ----

@borrows
fn chengPluginTradeComputeTradeCid(record: var ChengPluginTradeRecord): str =
    var buf: layout.ByteBuf = layout.ByteBufInit(1024)
    b2cid.Backend2CidAppendText(buf, ChengPluginTradeDomainTag)
    b2cid.Backend2CidAppendU32(buf, chengPluginTradeFormatVersion)
    b2cid.Backend2CidAppendText(buf, record.kind)
    b2cid.Backend2CidAppendFixed32(buf, record.sourceClosureHash)
    b2cid.Backend2CidAppendFixed32(buf, record.compilerHash)
    b2cid.Backend2CidAppendText(buf, record.targetTriple)
    b2cid.Backend2CidAppendU32(buf, record.contractVersion)
    chengPluginTradeAppendI64(buf, record.artifactByteCount)
    b2cid.Backend2CidAppendFixed32(buf, record.artifactSha256)
    b2cid.Backend2CidAppendText(buf, record.artifactContentCid)
    b2cid.Backend2CidAppendText(buf, record.issuedBySignerId)
    b2cid.Backend2CidAppendText(buf, record.issuanceProofCid)
    chengPluginTradeAppendI64(buf, record.issuerGeneration)
    return layout.FixedBytes32Hex(b2cid.Backend2CidBufSha256(buf))

# Issue 构造期自检与领取后复检共用 (identity IsValid 同构: 重算 != 自身即 panic)
@borrows
fn ChengPluginTradeRecordVerifySelfCid(record: var ChengPluginTradeRecord) =
    let recomputed = chengPluginTradeComputeTradeCid(record)
    if recomputed != record.tradeCidHex:
        panic(Fmt"csg_pickup_trade_cid_recompute_mismatch cid={record.tradeCidHex} recomputed={recomputed}")

# ---- Issue: 构造期全套守卫 + self-check; 任一失败 Err, 无降级 ----

@borrows
fn ChengPluginTradeRecordIssue(sourceClosureHash: layout.FixedBytes32,
                               compilerHash: layout.FixedBytes32,
                               targetTriple: str,
                               contractVersion: int32,
                               artifact: rawbytes.Bytes,
                               issuedBySignerId: str,
                               issuanceProofCid: str,
                               issuerGeneration: int64): Result[ChengPluginTradeRecord] =
    if targetTriple == "":
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorQuadMissing)
    if b2cid.Backend2CidFixed32IsZero(sourceClosureHash) ||
       b2cid.Backend2CidFixed32IsZero(compilerHash):
        return Err[ChengPluginTradeRecord](
            ChengPluginTradeErrorZeroClosureOrCompilerHash)
    if contractVersion < 1:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadContractVersion)
    let byteCount = Int64(rawbytes.BytesLen(artifact))
    if byteCount > ChengPluginTradeMaxArtifactBytes:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorArtifactTooLarge)
    if len(issuedBySignerId) == 0:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorEmptySigner)
    if !identity.csgCoreIdentityCidValid(issuanceProofCid):
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorIssuanceProofCid)
    if issuerGeneration < 1:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorIssuerGeneration)
    var out: ChengPluginTradeRecord
    out.kind = strings.CloneStr(ChengPluginTradeKind)
    out.sourceClosureHash = sourceClosureHash
    out.compilerHash = compilerHash
    out.targetTriple = strings.CloneStr(targetTriple)
    out.contractVersion = contractVersion
    out.artifactByteCount = byteCount
    out.artifactSha256 = pcid.Backend2ContentSha256OfBytes(artifact)
    out.artifactContentCid = strings.CloneStr(
        "sha256:" + layout.FixedBytes32Hex(out.artifactSha256))
    out.issuedBySignerId = strings.CloneStr(issuedBySignerId)
    out.issuanceProofCid = strings.CloneStr(issuanceProofCid)
    out.issuerGeneration = issuerGeneration
    out.tradeCidHex = chengPluginTradeComputeTradeCid(out)
    # self-check (IsValid 同构): 构造即复检, 共用同一重算函数
    ChengPluginTradeRecordVerifySelfCid(out)
    return Ok[ChengPluginTradeRecord](out)

# ---- BindToReceipt: record↔receipt 双向一致性硬闸 (三方相等纪律落地点) ----
#   record.artifactSha256 == receipt.artifactSha256
#   record 四元组逐槽 == receipt 四元组槽 ∧ 重算出同一 pickupCidHex
#   record.artifactByteCount == receipt.artifactByteCount
#   record.artifactContentCid 前缀剥除后逐字 == hex(artifactSha256)
# 任一不等 panic: csg_pickup_trade_receipt_bind_mismatch (校验失败不走 Err)。

@borrows
fn ChengPluginTradeRecordBindToReceipt(record: var ChengPluginTradeRecord,
                                       receipt: var pcid.PluginPickupReceipt) =
    ChengPluginTradeRecordVerifySelfCid(record)
    if !layout.FixedBytes32Equal(record.artifactSha256, receipt.artifactSha256):
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=artifact_sha256")
    if !layout.FixedBytes32Equal(record.sourceClosureHash, receipt.sourceClosureHash):
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=source_closure_hash")
    if !layout.FixedBytes32Equal(record.compilerHash, receipt.compilerHash):
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=compiler_hash")
    if record.targetTriple != receipt.targetTriple:
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=target_triple")
    if record.contractVersion != receipt.contractVersion:
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=contract_version")
    if record.artifactByteCount != Int64(receipt.artifactByteCount):
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=artifact_byte_count")
    let recomputedPickupCid = pcid.Backend2ComputePluginPickupCid(
        record.sourceClosureHash, record.compilerHash,
        record.targetTriple, record.contractVersion)
    if recomputedPickupCid != receipt.pickupCidHex:
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=pickup_cid recomputed={recomputedPickupCid}")
    let contentExpect = "sha256:" + layout.FixedBytes32Hex(record.artifactSha256)
    if record.artifactContentCid != contentExpect:
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=artifact_content_cid")

# ---- T6 降格映射: record → chain-origin receipt (取件客户端消费的唯一入口) ----
# 按 chain-origin 行构造 receipt: origin=chain / signerId=issuedBySignerId /
# proofCid=hex(issuanceProofCid)。Make 内部 provenance 守卫 + 本函数 BindToReceipt
# 三方相等硬闸; 任一失败 panic, 绝不降级。

@borrows
fn ChengPluginTradeRecordDemoteToReceipt(
        record: var ChengPluginTradeRecord,
        artifact: rawbytes.Bytes): pcid.PluginPickupReceipt =
    ChengPluginTradeRecordVerifySelfCid(record)
    if !strings.HasPrefix(record.issuanceProofCid, "sha256:"):
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=issuance_proof_cid")
    let proofHex = strings.DropPrefix(record.issuanceProofCid, "sha256:")
    var proofParse = layout.FixedBytes32FromHex(proofHex)
    if IsErr(proofParse):
        panic(Fmt"csg_pickup_trade_receipt_bind_mismatch cid={record.tradeCidHex} field=issuance_proof_cid")
    let proofCid = Value(proofParse)
    var receipt = pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginChain,
        record.sourceClosureHash, record.compilerHash,
        record.targetTriple, record.contractVersion,
        artifact, record.issuedBySignerId, proofCid)
    ChengPluginTradeRecordBindToReceipt(record, receipt)
    return receipt

# ---- codec: Encode (域标签 + formatVersion + 声明序逐字段同一 append 族) ----

@borrows
fn ChengPluginTradeRecordEncode(record: var ChengPluginTradeRecord): rawbytes.Bytes =
    var buf: layout.ByteBuf = layout.ByteBufInit(1024)
    b2cid.Backend2CidAppendText(buf, ChengPluginTradeDomainTag)
    b2cid.Backend2CidAppendU32(buf, chengPluginTradeFormatVersion)
    b2cid.Backend2CidAppendText(buf, record.kind)
    b2cid.Backend2CidAppendText(buf, record.tradeCidHex)
    b2cid.Backend2CidAppendFixed32(buf, record.sourceClosureHash)
    b2cid.Backend2CidAppendFixed32(buf, record.compilerHash)
    b2cid.Backend2CidAppendText(buf, record.targetTriple)
    b2cid.Backend2CidAppendU32(buf, record.contractVersion)
    chengPluginTradeAppendI64(buf, record.artifactByteCount)
    b2cid.Backend2CidAppendFixed32(buf, record.artifactSha256)
    b2cid.Backend2CidAppendText(buf, record.artifactContentCid)
    b2cid.Backend2CidAppendText(buf, record.issuedBySignerId)
    b2cid.Backend2CidAppendText(buf, record.issuanceProofCid)
    chengPluginTradeAppendI64(buf, record.issuerGeneration)
    var out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    return out

# ---- codec: Decode 严格模式 (游标穷尽; 截断/尾字节/坏域/坏版本/坏 kind/坏
# cid 形/quad 缺位/负字节数/超上限一律显式 Err; 镜像 backend2_plugin_cid :216-321) ----

@borrows
fn chengPluginTradeReadU32(data: rawbytes.Bytes, cursor: var int32): Result[int32] =
    if cursor < 0 || cursor > data.len || data.len - cursor < 4:
        return Err[int32](ChengPluginTradeErrorTruncated)
    let off = cursor
    let b0 = rawbytes.BytesGet(data, off)
    let b1 = rawbytes.BytesGet(data, off + 1)
    let b2 = rawbytes.BytesGet(data, off + 2)
    let b3 = rawbytes.BytesGet(data, off + 3)
    cursor = off + 4
    return Ok[int32](b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

@borrows
fn chengPluginTradeReadText(data: rawbytes.Bytes, cursor: var int32): Result[str] =
    var lenRes = chengPluginTradeReadU32(data, cursor)
    if IsErr(lenRes):
        return Err[str](ChengPluginTradeErrorTruncated)
    let n = Value(lenRes)
    if n < 0 || n > data.len - cursor:
        return Err[str](ChengPluginTradeErrorTruncated)
    let text = rawbytes.BytesToString(rawbytes.BytesSliceView(data, cursor, n))
    cursor = cursor + n
    return Ok[str](text)

@borrows
fn chengPluginTradeReadFixed32(
        data: rawbytes.Bytes,
        cursor: var int32): Result[layout.FixedBytes32] =
    if cursor < 0 || cursor > data.len || data.len - cursor < 32:
        return Err[layout.FixedBytes32](ChengPluginTradeErrorTruncated)
    var out: layout.FixedBytes32
    for i in 0..<32:
        out.data[i] = UInt8(rawbytes.BytesGet(data, cursor + i))
    cursor = cursor + 32
    return Ok[layout.FixedBytes32](out)

@borrows
fn chengPluginTradeReadI64(data: rawbytes.Bytes, cursor: var int32): Result[int64] =
    if cursor < 0 || cursor > data.len || data.len - cursor < 8:
        return Err[int64](ChengPluginTradeErrorTruncated)
    var raw: uint64 = UInt64(0)
    for i in 0..<8:
        raw = raw | (UInt64(rawbytes.BytesGet(data, cursor + i)) << UInt64(8 * i))
    cursor = cursor + 8
    return Ok[int64](Int64(raw))

@borrows
fn ChengPluginTradeRecordDecode(data: rawbytes.Bytes): Result[ChengPluginTradeRecord] =
    var cursor = 0
    var tagRes = chengPluginTradeReadText(data, cursor)
    if IsErr(tagRes):
        return Err[ChengPluginTradeRecord](Error(tagRes))
    if Value(tagRes) != ChengPluginTradeDomainTag:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadDomainTag)
    var verRes = chengPluginTradeReadU32(data, cursor)
    if IsErr(verRes):
        return Err[ChengPluginTradeRecord](Error(verRes))
    if Value(verRes) != chengPluginTradeFormatVersion:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadFormatVersion)
    var out: ChengPluginTradeRecord
    var kindRes = chengPluginTradeReadText(data, cursor)
    if IsErr(kindRes):
        return Err[ChengPluginTradeRecord](Error(kindRes))
    out.kind = Value(kindRes)
    if out.kind != ChengPluginTradeKind:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadKind)
    var cidRes = chengPluginTradeReadText(data, cursor)
    if IsErr(cidRes):
        return Err[ChengPluginTradeRecord](Error(cidRes))
    out.tradeCidHex = Value(cidRes)
    var cidParse = layout.FixedBytes32FromHex(out.tradeCidHex)
    if IsErr(cidParse):
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadTradeCidHex)
    var closureRes = chengPluginTradeReadFixed32(data, cursor)
    if IsErr(closureRes):
        return Err[ChengPluginTradeRecord](Error(closureRes))
    out.sourceClosureHash = Value(closureRes)
    var compilerRes = chengPluginTradeReadFixed32(data, cursor)
    if IsErr(compilerRes):
        return Err[ChengPluginTradeRecord](Error(compilerRes))
    out.compilerHash = Value(compilerRes)
    if b2cid.Backend2CidFixed32IsZero(out.sourceClosureHash) ||
       b2cid.Backend2CidFixed32IsZero(out.compilerHash):
        return Err[ChengPluginTradeRecord](
            ChengPluginTradeErrorZeroClosureOrCompilerHash)
    var tripleRes = chengPluginTradeReadText(data, cursor)
    if IsErr(tripleRes):
        return Err[ChengPluginTradeRecord](Error(tripleRes))
    out.targetTriple = Value(tripleRes)
    if len(out.targetTriple) == 0:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorEmptyTargetTriple)
    var contractRes = chengPluginTradeReadU32(data, cursor)
    if IsErr(contractRes):
        return Err[ChengPluginTradeRecord](Error(contractRes))
    out.contractVersion = Value(contractRes)
    if out.contractVersion < 1:
        return Err[ChengPluginTradeRecord](ChengPluginTradeDecodeBadContractVersion)
    var countRes = chengPluginTradeReadI64(data, cursor)
    if IsErr(countRes):
        return Err[ChengPluginTradeRecord](Error(countRes))
    out.artifactByteCount = Value(countRes)
    if out.artifactByteCount < 0:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadByteCount)
    if out.artifactByteCount > ChengPluginTradeMaxArtifactBytes:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorArtifactTooLarge)
    var shaRes = chengPluginTradeReadFixed32(data, cursor)
    if IsErr(shaRes):
        return Err[ChengPluginTradeRecord](Error(shaRes))
    out.artifactSha256 = Value(shaRes)
    var contentRes = chengPluginTradeReadText(data, cursor)
    if IsErr(contentRes):
        return Err[ChengPluginTradeRecord](Error(contentRes))
    out.artifactContentCid = Value(contentRes)
    if !identity.csgCoreIdentityCidValid(out.artifactContentCid):
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadContentCid)
    var signerRes = chengPluginTradeReadText(data, cursor)
    if IsErr(signerRes):
        return Err[ChengPluginTradeRecord](Error(signerRes))
    out.issuedBySignerId = Value(signerRes)
    var proofRes = chengPluginTradeReadText(data, cursor)
    if IsErr(proofRes):
        return Err[ChengPluginTradeRecord](Error(proofRes))
    out.issuanceProofCid = Value(proofRes)
    if !identity.csgCoreIdentityCidValid(out.issuanceProofCid):
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorBadIssuanceProofCid)
    var genRes = chengPluginTradeReadI64(data, cursor)
    if IsErr(genRes):
        return Err[ChengPluginTradeRecord](Error(genRes))
    out.issuerGeneration = Value(genRes)
    if cursor != data.len:
        return Err[ChengPluginTradeRecord](ChengPluginTradeErrorTrailingBytes)
    return Ok[ChengPluginTradeRecord](out)
