@borrows
fn csgQueryReportHitLine(
        hit: CsgCoreMerkleQueryHit,
        ordinal: int32,
        pathCount: int32): str =
    let proof = hit.proof
    let profileSetCid =
        validator.CsgCoreProfileSetCid(
            proof.profiles)
    var terminalFactHash: str
    if proof.terminalPresent:
        terminalFactHash =
            layout.FixedBytes32Hex(proof.terminalFactHash)
    var out: str = "{\"dag_root_cid\":"
    csgQueryAppend(out, csgQueryJson(proof.dagRootCid))
    csgQueryAppend(out, ",\"exists\":")
    csgQueryAppend(out, csgQueryBoolText(proof.exists))
    csgQueryAppend(out, ",\"fact\":")
    csgQueryAppend(out, csgQueryJson(hit.fact))
    csgQueryAppend(out, ",\"fact_count\":")
    csgQueryAppend(out, strings.IntToStr(proof.factCount))
    csgQueryAppend(out, ",\"fact_hash\":")
    csgQueryAppend(out, csgQueryJson(hit.factHash))
    csgQueryAppend(out, ",\"fact_key\":")
    csgQueryAppend(out, csgQueryJson(hit.factKey))
    csgQueryAppend(out, ",\"facts_root\":")
    csgQueryAppend(out, csgQueryJson(proof.factsRoot))
    csgQueryAppend(out, ",\"hit_ordinal\":")
    csgQueryAppend(out, strings.IntToStr(ordinal))
    csgQueryAppend(out, ",\"kind\":")
    csgQueryAppend(out, csgQueryJson(CsgMerkleLocalQueryHitKind))
    csgQueryAppend(out, ",\"leaf_cid\":")
    csgQueryAppend(out, csgQueryJson(hit.leafCid))
    csgQueryAppend(out, ",\"path_count\":")
    csgQueryAppend(out, strings.IntToStr(pathCount))
    csgQueryAppend(out, ",\"profile_set_cid\":")
    csgQueryAppend(out, csgQueryJson(profileSetCid))
    csgQueryAppend(out, ",\"profiles\":")
    csgQueryAppend(
        out, csgQueryProfilesJson(proof.profiles))
    csgQueryAppend(out, ",\"schema_cid\":")
    csgQueryAppend(out, csgQueryJson(proof.schemaCid))
    csgQueryAppend(out, ",\"schema_namespace\":")
    csgQueryAppend(out, csgQueryJson(proof.schemaNamespace))
    csgQueryAppend(out, ",\"standard\":")
    csgQueryAppend(out, csgQueryJson(proof.standard))
    csgQueryAppend(out, ",\"subgraph_cid\":")
    csgQueryAppend(out, csgQueryJson(proof.subgraphCid))
    csgQueryAppend(out, ",\"terminal_fact_hash\":")
    csgQueryAppend(out, csgQueryJson(terminalFactHash))
    csgQueryAppend(out, ",\"terminal_key\":")
    csgQueryAppend(out, csgQueryJson(proof.terminalKey))
    csgQueryAppend(out, ",\"terminal_present\":")
    csgQueryAppend(out, csgQueryBoolText(proof.terminalPresent))
    csgQueryAppend(out, "}")
    return out

@borrows
fn csgQueryReportStepLine(
        proof: merkle_dag.CsgCoreMerkleProof,
        hitOrdinal: int32,
        ordinal: int32): str =
    var out: str = "{\"direction\":"
    csgQueryAppend(
        out, strings.IntToStr(proof.directions[ordinal]))
    csgQueryAppend(out, ",\"hit_ordinal\":")
    csgQueryAppend(out, strings.IntToStr(hitOrdinal))
    csgQueryAppend(out, ",\"id\":")
    csgQueryAppend(
        out,
        csgQueryJson(
            csgQueryCat(
                csgQueryCat(
                    csgQueryCat(
                        "hit:", strings.IntToStr(hitOrdinal)),
                    ":step:"),
                strings.IntToStr(ordinal))))
    csgQueryAppend(out, ",\"kind\":")
    csgQueryAppend(
        out, csgQueryJson(CsgMerkleLocalQueryProofStepKind))
    csgQueryAppend(out, ",\"ordinal\":")
    csgQueryAppend(out, strings.IntToStr(ordinal))
    csgQueryAppend(out, ",\"sibling_count\":")
    csgQueryAppend(
        out, strings.IntToStr(proof.siblingCounts[ordinal]))
    csgQueryAppend(out, ",\"sibling_hash\":")
    csgQueryAppend(
        out,
        csgQueryJson(
            layout.FixedBytes32Hex(
                proof.siblingHashes[ordinal])))
    csgQueryAppend(out, ",\"split_bit\":")
    csgQueryAppend(
        out, strings.IntToStr(proof.splitBits[ordinal]))
    csgQueryAppend(out, "}")
    return out

fn csgQueryReportArtifactFail(
        error: str): CsgCoreMerkleQueryReportArtifact =
    var out: CsgCoreMerkleQueryReportArtifact
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleQueryReportEncode(
        head:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult,
        query: CsgCoreMerkleQueryResult):
        CsgCoreMerkleQueryReportArtifact =
    if !query.ok ||
       !csgQueryManifestOnlyAuthorityValid(head):
        return csgQueryReportArtifactFail(
            "merkle_query_report_source_invalid")
    if query.verificationScope != "local_query" ||
       query.fullClosureVerified || query.productionAdmission:
        return csgQueryReportArtifactFail(
            "merkle_query_report_scope_invalid")
    var expectedSubgraphCid: str
    var manifestBindingError: str
    if !csgQueryManifestBinding(
           head.manifest,
           expectedSubgraphCid,
           manifestBindingError):
        return csgQueryReportArtifactFail(
            manifestBindingError)
    if query.headGeneration != head.head.generation ||
       query.headCid != head.head.headCid ||
       query.manifestCid != head.head.manifestCid ||
       query.csgcByteCount != head.manifest.csgcByteCount ||
       query.csgcDirectoryCid !=
           head.manifest.csgcDirectoryCid ||
       query.csgcObjectCid != head.manifest.csgcObjectCid ||
       query.factCount != head.manifest.factCount ||
       query.factsRoot != head.manifest.factsRoot ||
       query.dagRootCid != head.manifest.dagRootCid ||
       query.subgraphCid != expectedSubgraphCid ||
       query.queryShardRoot != head.manifest.queryShardRoot ||
       query.generationRecordsRead != 2 ||
       query.manifestObjectsRead != 2 ||
       query.term.len == 0 ||
       !csgQuerySupportedIndexKind(query.indexKind):
        return csgQueryReportArtifactFail(
            "merkle_query_report_source_binding_mismatch")
    let reportBucket =
        merkle_artifacts.CsgCoreMerkleQueryBucket(
            query.indexKind, query.term)
    if reportBucket.len == 0:
        return csgQueryReportArtifactFail(
            "merkle_query_report_query_shard_binding_mismatch")
    if query.queryBucket != reportBucket:
        return csgQueryReportArtifactFail(
            "merkle_query_report_query_shard_binding_mismatch")
    if query.queryKeyRoot !=
       csgQueryKeyRoot(
           query.indexKind,
           query.term,
           query.queryBucket):
        return csgQueryReportArtifactFail(
            "merkle_query_report_query_key_root_mismatch")
    let reportDescriptorAt =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            head.manifest.queryShards, reportBucket)
    if (reportDescriptorAt < 0 &&
        (query.queryShardObjectsRead != 0 ||
         query.queryShardBytesRead != 0 ||
         query.queryShardCid.len != 0 ||
         query.queryShardContentRoot.len != 0 ||
         query.queryShardEntryCount != 0 ||
         query.hits.len != 0)) ||
       (reportDescriptorAt >= 0 &&
        (query.queryShardObjectsRead != 1 ||
         query.queryShardBytesRead <= 0 ||
         query.queryShardCid !=
             head.manifest.queryShards[reportDescriptorAt].cid ||
         query.queryShardContentRoot !=
             head.manifest.queryShards[reportDescriptorAt].root ||
         query.queryShardEntryCount !=
             head.manifest.queryShards[reportDescriptorAt].entryCount)):
        return csgQueryReportArtifactFail(
            "merkle_query_report_query_shard_binding_mismatch")
    if query.partitionObjectsRead < 0 ||
       query.membershipObjectsRead < 0 ||
       query.proofNodeObjectsRead < 0 ||
       query.partitionObjectsRead !=
           query.membershipObjectsRead:
        return csgQueryReportArtifactFail(
            "merkle_query_report_object_count_mismatch")
    let objectTotal =
        int64(query.manifestObjectsRead) +
        int64(query.queryShardObjectsRead) +
        int64(query.partitionObjectsRead) +
        int64(query.membershipObjectsRead) +
        int64(query.proofNodeObjectsRead)
    if objectTotal > 2147483647 ||
       int64(query.objectsRead) != objectTotal:
        return csgQueryReportArtifactFail(
            "merkle_query_report_object_count_mismatch")
    var byteTotal: int64
    if !csgQueryAccumulateByteCount(
           byteTotal, query.manifestBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, query.queryShardBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, query.partitionBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, query.membershipBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, query.proofNodeBytesRead) ||
       query.contentObjectBytesRead != byteTotal:
        return csgQueryReportArtifactFail(
            "merkle_query_report_byte_count_mismatch")
    var pathStepCount: int32
    for i in 0..<query.hits.len:
        let proof = query.hits[i].proof
        if !validator.CsgCoreProfilesEqual(
               proof.profiles,
               head.manifest.profiles) ||
           proof.standard != head.manifest.standard ||
           proof.schemaNamespace != CsgMerkleQuerySchemaNamespace ||
           proof.schemaCid != head.manifest.schemaCid ||
           proof.dagRootCid != query.dagRootCid ||
           proof.factsRoot != query.factsRoot ||
           proof.queryKey != query.hits[i].factKey:
            return csgQueryReportArtifactFail(
                "merkle_query_report_proof_binding_mismatch")
        let verified = merkle_dag.CsgCoreMerkleVerifyFact(
            proof, query.factsRoot, query.hits[i].fact)
        if !verified.ok:
            return csgQueryReportArtifactFail(
                csgQueryCat(
                    "merkle_query_report_proof_invalid ",
                    verified.error))
        if pathStepCount >
           2147483647 - proof.splitBits.len:
            return csgQueryReportArtifactFail(
                "merkle_query_report_path_count_overflow")
        pathStepCount = pathStepCount + proof.splitBits.len
    if query.resultRoot !=
       csgQueryResultRoot(
           query.headCid,
           query.manifestCid,
           query.factsRoot,
           query.queryShardCid,
           query.queryKeyRoot,
           query.hits):
        return csgQueryReportArtifactFail(
            "merkle_query_report_result_root_mismatch")
    let header =
        csgQueryReportHeaderValue(
            head, query, pathStepCount)
    var lines: str[]
    add(lines, csgQueryReportHeaderLine(header))
    for i in 0..<query.hits.len:
        add(
            lines,
            csgQueryReportHitLine(
                query.hits[i],
                i,
                query.hits[i].proof.splitBits.len))
        for j in 0..<query.hits[i].proof.splitBits.len:
            add(
                lines,
                csgQueryReportStepLine(
                    query.hits[i].proof, i, j))
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgQueryReportArtifactFail(
            csgQueryCat(
                "merkle_query_report_encode ", encoded.error))
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !decoded.ok || decoded.lines.len != lines.len:
        rawbytes.BytesFree(encoded.bytes)
        return csgQueryReportArtifactFail(
            "merkle_query_report_encode_self_check")
    var out: CsgCoreMerkleQueryReportArtifact
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleLocalQueryReportDomain,
            encoded.bytes)
    out.lines = decoded.lines
    out.bytes = encoded.bytes
    return out

fn csgQueryReportVerifyFail(
        error: str): CsgCoreMerkleQueryReportVerifyResult =
    var out: CsgCoreMerkleQueryReportVerifyResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgQueryReportString(
        line: str,
        name: str,
        out: var str): bool =
    let value = field.CsgCoreJsonTopStringField(line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgQueryReportRaw(
        line: str,
        name: str,
        out: var str): bool =
    let value = field.CsgCoreJsonTopRawField(line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgQueryReportProfiles(
        line: str,
        name: str,
        out: var str[]): bool =
    var raw: str
    if !csgQueryReportRaw(line, name, raw):
        return false
    let parsed = json.ParseJsonSafe(raw)
    if !parsed.success || parsed.value.kind != json.JArray:
        return false
    for i in 0..<parsed.value.a.len:
        if parsed.value.a[i].kind != json.JString:
            return false
        add(out, strings.CloneStr(parsed.value.a[i].s))
    return true

@borrows
fn csgQueryReportParseInt64Text(
        text: str,
        out: var int64): bool =
    if text.len == 0 ||
       (text.len > 1 && text[0] == '0'):
        return false
    var value: int64
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        let digit = int64(int32(ch) - int32('0'))
        if value > (9223372036854775807 - digit) / 10:
            return false
        value = value * 10 + digit
    out = value
    return true

@borrows
fn csgQueryReportInt64(
        line: str,
        name: str,
        out: var int64): bool =
    var text: str
    return csgQueryReportRaw(line, name, text) &&
        csgQueryReportParseInt64Text(text, out)

@borrows
fn csgQueryReportInt32(
        line: str,
        name: str,
        out: var int32): bool =
    var value: int64
    if !csgQueryReportInt64(line, name, value) ||
       value > 2147483647:
        return false
    out = int32(value)
    return true

@borrows
fn csgQueryReportBool(
        line: str,
        name: str,
        out: var bool): bool =
    var text: str
    if !csgQueryReportRaw(line, name, text):
        return false
    if text == "false":
        out = false
        return true
    if text == "true":
        out = true
        return true
    return false

@borrows
fn csgQueryReportHash(
        line: str,
        name: str,
        out: var layout.FixedBytes32): bool =
    var text: str
    if !csgQueryReportString(line, name, text) ||
       text.len != 64:
        return false
    let parsed = layout.FixedBytes32FromHex(text)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return layout.FixedBytes32Hex(out) == text

@borrows
fn csgQueryCidHash(
        cid: str,
        out: var layout.FixedBytes32): bool =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(cid):
        return false
    let parsed = layout.FixedBytes32FromHex(
        strings.CloneStrRange(cid, 7, 64))
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return csgQueryHashCid(out) == cid

@borrows
fn csgQueryReportParseHeader(
        line: str,
        out: var csgMerkleQueryReportHeader,
        error: var str): bool =
    var completeReport: bool
    var fullClosureVerified: bool
    var productionAdmission: bool
    var kind: str
    var readScope: str
    var verificationScope: str
    if !csgQueryReportBool(
           line, "complete_report", completeReport) ||
       !csgQueryReportInt64(
           line,
           "content_object_bytes_read",
           out.contentObjectBytesRead) ||
       !csgQueryReportInt32(
           line, "csgc_byte_count", out.csgcByteCount) ||
       !csgQueryReportString(
           line, "csgc_directory_cid", out.csgcDirectoryCid) ||
       !csgQueryReportString(
           line, "csgc_object_cid", out.csgcObjectCid) ||
       !csgQueryReportString(
           line, "dag_root_cid", out.dagRootCid) ||
       !csgQueryReportInt32(
           line, "fact_count", out.factCount) ||
       !csgQueryReportString(
           line, "facts_root", out.factsRoot) ||
       !csgQueryReportBool(
           line,
           "full_closure_verified",
           fullClosureVerified) ||
       !csgQueryReportInt64(
           line, "generation", out.generation) ||
       !csgQueryReportInt32(
           line,
           "generation_records_read",
           out.generationRecordsRead) ||
       !csgQueryReportString(
           line, "head_cid", out.headCid) ||
       !csgQueryReportInt32(
           line, "hit_count", out.hitCount) ||
       !csgQueryReportString(
           line, "index_kind", out.indexKind) ||
       !csgQueryReportString(line, "kind", kind) ||
       !csgQueryReportInt64(
           line,
           "manifest_bytes_read",
           out.manifestBytesRead) ||
       !csgQueryReportString(
           line, "manifest_cid", out.manifestCid) ||
       !csgQueryReportInt32(
           line,
           "manifest_objects_read",
           out.manifestObjectsRead) ||
       !csgQueryReportInt64(
           line,
           "membership_bytes_read",
           out.membershipBytesRead) ||
       !csgQueryReportInt32(
           line,
           "membership_objects_read",
           out.membershipObjectsRead) ||
       !csgQueryReportInt32(
           line, "objects_read", out.objectsRead) ||
       !csgQueryReportInt64(
           line,
           "partition_bytes_read",
           out.partitionBytesRead) ||
       !csgQueryReportInt32(
           line,
           "partition_objects_read",
           out.partitionObjectsRead) ||
       !csgQueryReportInt32(
           line,
           "path_step_count",
           out.pathStepCount) ||
       !csgQueryReportBool(
           line,
           "production_admission",
           productionAdmission) ||
       !csgQueryReportString(
           line,
           "profile_set_cid",
           out.profileSetCid) ||
       !csgQueryReportProfiles(
           line, "profiles", out.profiles) ||
       !csgQueryReportInt64(
           line,
           "proof_node_bytes_read",
           out.proofNodeBytesRead) ||
       !csgQueryReportInt32(
           line,
           "proof_node_objects_read",
           out.proofNodeObjectsRead) ||
       !csgQueryReportString(
           line, "query_bucket", out.queryBucket) ||
       !csgQueryReportString(
           line, "query_key_root", out.queryKeyRoot) ||
       !csgQueryReportInt64(
           line,
           "query_shard_bytes_read",
           out.queryShardBytesRead) ||
       !csgQueryReportString(
           line, "query_shard_cid", out.queryShardCid) ||
       !csgQueryReportString(
           line,
           "query_shard_content_root",
           out.queryShardContentRoot) ||
       !csgQueryReportInt32(
           line,
           "query_shard_entry_count",
           out.queryShardEntryCount) ||
       !csgQueryReportInt32(
           line,
           "query_shard_objects_read",
           out.queryShardObjectsRead) ||
       !csgQueryReportString(
           line, "query_shard_root", out.queryShardRoot) ||
       !csgQueryReportString(
           line, "read_accounting_scope", readScope) ||
       !csgQueryReportString(
           line, "result_root", out.resultRoot) ||
       !csgQueryReportString(
           line, "schema_cid", out.schemaCid) ||
       !csgQueryReportString(
           line, "standard", out.standard) ||
       !csgQueryReportString(
           line, "subgraph_cid", out.subgraphCid) ||
       !csgQueryReportString(line, "term", out.term) ||
       !csgQueryReportString(
           line, "verification_scope", verificationScope):
        error = "merkle_query_report_header_field_invalid"
        return false
    if completeReport || fullClosureVerified ||
       productionAdmission ||
       kind != CsgMerkleLocalQueryReportKind ||
       readScope != "content_addressed_objects" ||
       verificationScope != "local_query" ||
       !csgQuerySupportedIndexKind(out.indexKind) ||
       out.term.len == 0 ||
       out.standard != validator.CsgCoreStandardIdentity() ||
       validator.CsgCoreProfilesCanonicalError(
           out.profiles).len > 0 ||
       out.profileSetCid !=
           validator.CsgCoreProfileSetCid(out.profiles) ||
       out.csgcByteCount < csgc.CsgCoreCsgcHeaderSize ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.headCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.csgcDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.dagRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.subgraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.queryShardRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.queryKeyRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.resultRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.schemaCid):
        error = "merkle_query_report_header_binding_invalid"
        return false
    var rootBindingError: str
    let expectedSubgraphCid =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            out.factCount,
            out.dagRootCid,
            rootBindingError)
    if rootBindingError.len > 0:
        error = "merkle_query_report_root_binding_invalid"
        return false
    let expectedFactsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            out.standard,
            out.profiles,
            CsgMerkleQuerySchemaNamespace,
            out.schemaCid,
            out.subgraphCid,
            rootBindingError)
    if rootBindingError.len > 0 ||
       expectedSubgraphCid != out.subgraphCid ||
       expectedFactsRoot != out.factsRoot:
        error = "merkle_query_report_root_binding_invalid"
        return false
    let expectedBucket =
        merkle_artifacts.CsgCoreMerkleQueryBucket(
            out.indexKind, out.term)
    if expectedBucket.len == 0 ||
       out.queryBucket != expectedBucket ||
       out.queryKeyRoot !=
           csgQueryKeyRoot(
               out.indexKind,
               out.term,
               out.queryBucket) ||
       (out.queryShardCid.len == 0 &&
        (out.queryShardContentRoot.len != 0 ||
         out.queryShardEntryCount != 0)) ||
       (out.queryShardCid.len > 0 &&
        (!merkle_store_codec.CsgCoreMerkleStoreCidValid(
             out.queryShardCid) ||
         !merkle_store_codec.CsgCoreMerkleStoreCidValid(
             out.queryShardContentRoot) ||
         out.queryShardEntryCount < 0)):
        error = "merkle_query_report_query_shard_binding_invalid"
        return false
    if csgQueryReportHeaderLine(out) != line:
        error = "merkle_query_report_header_noncanonical"
        return false
    return true

@borrows
fn csgQueryReportParseHit(
        line: str,
        expectedOrdinal: int32,
        out: var csgMerkleQueryDecodedHit,
        error: var str): bool =
    var kind: str
    var profiles: str[]
    var profileSetCid: str
    var ordinal: int32
    var terminalFactHashText: str
    var terminalFactHash: layout.FixedBytes32
    if !csgQueryReportString(
           line, "dag_root_cid", out.hit.proof.dagRootCid) ||
       !csgQueryReportBool(line, "exists", out.hit.proof.exists) ||
       !csgQueryReportString(line, "fact", out.hit.fact) ||
       !csgQueryReportInt32(
           line, "fact_count", out.hit.proof.factCount) ||
       !csgQueryReportString(
           line, "fact_hash", out.hit.factHash) ||
       !csgQueryReportString(
           line, "fact_key", out.hit.factKey) ||
       !csgQueryReportString(
           line, "facts_root", out.hit.proof.factsRoot) ||
       !csgQueryReportInt32(
           line, "hit_ordinal", ordinal) ||
       !csgQueryReportString(line, "kind", kind) ||
       !csgQueryReportString(
           line, "leaf_cid", out.hit.leafCid) ||
       !csgQueryReportInt32(
           line, "path_count", out.pathCount) ||
       !csgQueryReportString(
           line, "profile_set_cid", profileSetCid) ||
       !csgQueryReportProfiles(
           line, "profiles", profiles) ||
       !csgQueryReportString(
           line, "schema_cid", out.hit.proof.schemaCid) ||
       !csgQueryReportString(
           line,
           "schema_namespace",
           out.hit.proof.schemaNamespace) ||
       !csgQueryReportString(
           line, "standard", out.hit.proof.standard) ||
       !csgQueryReportString(
           line, "subgraph_cid", out.hit.proof.subgraphCid) ||
       !csgQueryReportString(
           line,
           "terminal_fact_hash",
           terminalFactHashText) ||
       !csgQueryReportString(
           line, "terminal_key", out.hit.proof.terminalKey) ||
       !csgQueryReportBool(
           line,
           "terminal_present",
           out.hit.proof.terminalPresent):
        error = "merkle_query_report_hit_field_invalid"
        return false
    if ordinal != expectedOrdinal ||
       kind != CsgMerkleLocalQueryHitKind ||
       out.pathCount > 256 ||
       validator.CsgCoreProfilesCanonicalError(
           profiles).len > 0 ||
       profileSetCid !=
           validator.CsgCoreProfileSetCid(profiles) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.hit.factHash) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.hit.leafCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.hit.proof.dagRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.hit.proof.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.hit.proof.schemaCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.hit.proof.subgraphCid):
        error = "merkle_query_report_hit_binding_invalid"
        return false
    if out.hit.proof.terminalPresent:
        let parsed =
            layout.FixedBytes32FromHex(terminalFactHashText)
        if result.IsErr(parsed) ||
           terminalFactHashText.len != 64:
            error =
                "merkle_query_report_terminal_hash_invalid"
            return false
        terminalFactHash = result.Value(parsed)
        if layout.FixedBytes32Hex(terminalFactHash) !=
           terminalFactHashText:
            error =
                "merkle_query_report_terminal_hash_noncanonical"
            return false
        out.hit.proof.terminalFactHash = terminalFactHash
    elif terminalFactHashText.len != 0 ||
         out.hit.proof.terminalKey.len != 0:
        error = "merkle_query_report_terminal_shape_invalid"
        return false
    out.hit.proof.profiles =
        validator.CsgCoreProfilesClone(profiles)
    out.hit.proof.queryKey = strings.CloneStr(out.hit.factKey)
    out.hit.proof.ok = true
    if csgQueryReportHitLine(
           out.hit, expectedOrdinal, out.pathCount) != line:
        error = "merkle_query_report_hit_noncanonical"
        return false
    return true

@borrows
fn csgQueryReportParseStep(
        line: str,
        expectedHitOrdinal: int32,
        expectedOrdinal: int32,
        proof: var merkle_dag.CsgCoreMerkleProof,
        error: var str): bool =
    var direction: int32
    var hitOrdinal: int32
    var id: str
    var kind: str
    var ordinal: int32
    var siblingCount: int32
    var siblingHash: layout.FixedBytes32
    var splitBit: int32
    if !csgQueryReportInt32(
           line, "direction", direction) ||
       !csgQueryReportInt32(
           line, "hit_ordinal", hitOrdinal) ||
       !csgQueryReportString(line, "id", id) ||
       !csgQueryReportString(line, "kind", kind) ||
       !csgQueryReportInt32(line, "ordinal", ordinal) ||
       !csgQueryReportInt32(
           line, "sibling_count", siblingCount) ||
       !csgQueryReportHash(
           line, "sibling_hash", siblingHash) ||
       !csgQueryReportInt32(
           line, "split_bit", splitBit):
        error = "merkle_query_report_step_field_invalid"
        return false
    let expectedId =
        csgQueryCat(
            csgQueryCat(
                csgQueryCat(
                    "hit:",
                    strings.IntToStr(expectedHitOrdinal)),
                ":step:"),
            strings.IntToStr(expectedOrdinal))
    if direction > 1 ||
       hitOrdinal != expectedHitOrdinal ||
       ordinal != expectedOrdinal ||
       id != expectedId ||
       kind != CsgMerkleLocalQueryProofStepKind ||
       siblingCount <= 0 || splitBit >= 256:
        error = "merkle_query_report_step_binding_invalid"
        return false
    add(proof.directions, direction)
    add(proof.siblingCounts, siblingCount)
    add(proof.siblingHashes, siblingHash)
    add(proof.splitBits, splitBit)
    if csgQueryReportStepLine(
           proof, expectedHitOrdinal, expectedOrdinal) != line:
        error = "merkle_query_report_step_noncanonical"
        return false
    return true

@borrows
fn csgQueryReportLineOrdinal(
        line: str,
        fieldName: str,
        out: var int32): bool =
    return csgQueryReportInt32(line, fieldName, out)

@borrows
fn csgQueryReportHitLeafValid(
        hit: CsgCoreMerkleQueryHit): bool =
    var factHash: layout.FixedBytes32
    var leafHash: layout.FixedBytes32
    if !csgQueryCidHash(hit.factHash, factHash) ||
       !csgQueryCidHash(hit.leafCid, leafHash):
        return false
    var node: merkle_dag.CsgCoreMerkleNodeRecord
    node.kind = merkle_dag.CsgCoreMerkleLeafNodeKind()
    node.count = 1
    node.splitBit = -1
    node.hash = leafHash
    node.key = strings.CloneStr(hit.factKey)
    node.keyHash =
        merkle_dag.CsgCoreMerkleKeyHash(hit.factKey)
    node.factHash = factHash
    return merkle_dag.CsgCoreMerkleNodeRecordCid(node) ==
        hit.leafCid

@borrows
fn csgQueryReportVerifyHit(
        header: csgMerkleQueryReportHeader,
        hit: CsgCoreMerkleQueryHit,
        previousFactKey: str,
        error: var str): bool =
    let proof = hit.proof
    if !validator.CsgCoreProfilesEqual(
           proof.profiles, header.profiles) ||
       proof.standard != header.standard ||
       proof.schemaNamespace != CsgMerkleQuerySchemaNamespace ||
       proof.schemaCid != header.schemaCid ||
       proof.dagRootCid != header.dagRootCid ||
       proof.factsRoot != header.factsRoot ||
       proof.factCount != header.factCount ||
       proof.queryKey != hit.factKey ||
       !proof.exists || !proof.terminalPresent ||
       proof.terminalKey != hit.factKey:
        error = "merkle_query_report_hit_proof_binding_mismatch"
        return false
    if previousFactKey.len > 0 &&
       csgQueryTextCompare(previousFactKey, hit.factKey) >= 0:
        error = "merkle_query_report_hit_order_invalid"
        return false
    var canonicalError: str
    let canonicalFact =
        merkle_dag.CsgCoreMerkleCanonicalFact(
            hit.fact, canonicalError)
    if canonicalError.len > 0 || canonicalFact != hit.fact:
        error = "merkle_query_report_fact_noncanonical"
        return false
    let factKey = merkle_dag.CsgCoreMerkleFactKey(
        hit.fact, canonicalError)
    if canonicalError.len > 0 || factKey != hit.factKey:
        error = "merkle_query_report_fact_key_mismatch"
        return false
    let factHash = csgQueryFactHashCid(
        hit.fact, canonicalError)
    if canonicalError.len > 0 || factHash != hit.factHash:
        error = "merkle_query_report_fact_hash_mismatch"
        return false
    if !csgQueryReportHitLeafValid(hit):
        error = "merkle_query_report_leaf_cid_mismatch"
        return false
    var record: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    record.indexKind = strings.CloneStr(header.indexKind)
    record.term = strings.CloneStr(header.term)
    record.factKey = strings.CloneStr(hit.factKey)
    if !csgQueryRecordMatchesFact(record, hit.fact):
        error = "merkle_query_report_term_mismatch"
        return false
    let verified = merkle_dag.CsgCoreMerkleVerifyFact(
        proof, header.factsRoot, hit.fact)
    if !verified.ok:
        error = csgQueryCat(
            "merkle_query_report_path_invalid ", verified.error)
        return false
    return true

@borrows
fn CsgCoreMerkleQueryReportVerify(
        bytes: rawbytes.Bytes,
        expectedReportCid: str,
        expected: CsgCoreMerkleQueryExpectedBinding):
        CsgCoreMerkleQueryReportVerifyResult =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           expectedReportCid) ||
       !csgQueryExpectedBindingValid(expected):
        return csgQueryReportVerifyFail(
            "merkle_query_report_expected_binding_invalid")
    let actualReportCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleLocalQueryReportDomain, bytes)
    if actualReportCid != expectedReportCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_cid_mismatch")
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgQueryReportVerifyFail(
            csgQueryCat(
                "merkle_query_report_decode ", decoded.error))
    var headerIndex: int32 = -1
    var hitLineCount: int32
    var stepLineCount: int32
    for i in 0..<decoded.lines.len:
        let kind = field.CsgCoreJsonKind(decoded.lines[i])
        if !kind.found:
            return csgQueryReportVerifyFail(
                "merkle_query_report_line_kind_missing")
        if kind.value == CsgMerkleLocalQueryReportKind:
            if headerIndex >= 0:
                return csgQueryReportVerifyFail(
                    "merkle_query_report_header_duplicate")
            headerIndex = i
        elif kind.value == CsgMerkleLocalQueryHitKind:
            var ordinal: int32
            if !csgQueryReportLineOrdinal(
                   decoded.lines[i], "hit_ordinal", ordinal):
                return csgQueryReportVerifyFail(
                    "merkle_query_report_hit_ordinal_invalid")
            hitLineCount = hitLineCount + 1
        elif kind.value ==
             CsgMerkleLocalQueryProofStepKind:
            var hitOrdinal: int32
            var ordinal: int32
            if !csgQueryReportLineOrdinal(
                   decoded.lines[i],
                   "hit_ordinal",
                   hitOrdinal) ||
               !csgQueryReportLineOrdinal(
                   decoded.lines[i], "ordinal", ordinal):
                return csgQueryReportVerifyFail(
                    "merkle_query_report_step_ordinal_invalid")
            stepLineCount = stepLineCount + 1
        else:
            return csgQueryReportVerifyFail(
                "merkle_query_report_line_kind_invalid")
    if headerIndex < 0:
        return csgQueryReportVerifyFail(
            "merkle_query_report_header_missing")
    var header: csgMerkleQueryReportHeader
    var error: str
    if !csgQueryReportParseHeader(
           decoded.lines[headerIndex], header, error):
        return csgQueryReportVerifyFail(error)
    if header.generation != expected.headGeneration:
        return csgQueryReportVerifyFail(
            "merkle_query_report_head_generation_mismatch")
    if header.headCid != expected.headCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_head_cid_mismatch")
    if header.manifestCid != expected.manifestCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_manifest_cid_mismatch")
    if header.csgcByteCount != expected.csgcByteCount:
        return csgQueryReportVerifyFail(
            "merkle_query_report_csgc_byte_count_mismatch")
    if header.csgcDirectoryCid != expected.csgcDirectoryCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_csgc_directory_cid_mismatch")
    if header.csgcObjectCid != expected.csgcObjectCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_csgc_object_cid_mismatch")
    if header.factsRoot != expected.factsRoot:
        return csgQueryReportVerifyFail(
            "merkle_query_report_facts_root_mismatch")
    if header.subgraphCid != expected.subgraphCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_subgraph_cid_mismatch")
    if header.queryBucket != expected.queryBucket:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_bucket_mismatch")
    if header.queryShardRoot != expected.queryShardRoot:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_shard_root_mismatch")
    if header.queryShardCid != expected.queryShardCid:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_shard_cid_mismatch")
    if header.queryShardContentRoot !=
       expected.queryShardContentRoot:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_shard_content_root_mismatch")
    if header.queryShardEntryCount !=
       expected.queryShardEntryCount:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_shard_entry_count_mismatch")
    if header.queryKeyRoot != expected.queryKeyRoot:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_key_root_mismatch")
    if header.resultRoot != expected.resultRoot:
        return csgQueryReportVerifyFail(
            "merkle_query_report_result_root_mismatch")
    if header.indexKind != expected.indexKind ||
       header.term != expected.term:
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_binding_mismatch")
    if header.hitCount != hitLineCount ||
       header.pathStepCount != stepLineCount ||
       decoded.lines.len !=
           1 + hitLineCount + stepLineCount:
        return csgQueryReportVerifyFail(
            "merkle_query_report_line_count_mismatch")
    if header.generation < int64(0) ||
       header.generationRecordsRead != 2:
        return csgQueryReportVerifyFail(
            "merkle_query_report_generation_count_mismatch")
    let objectTotal =
        int64(header.manifestObjectsRead) +
        int64(header.queryShardObjectsRead) +
        int64(header.partitionObjectsRead) +
        int64(header.membershipObjectsRead) +
        int64(header.proofNodeObjectsRead)
    if header.manifestObjectsRead != 2 ||
       header.queryShardObjectsRead < 0 ||
       header.queryShardObjectsRead > 1 ||
       header.partitionObjectsRead < 0 ||
       header.membershipObjectsRead < 0 ||
       header.proofNodeObjectsRead < 0 ||
       header.partitionObjectsRead !=
           header.membershipObjectsRead ||
       objectTotal > 2147483647 ||
       int64(header.objectsRead) != objectTotal:
        return csgQueryReportVerifyFail(
            "merkle_query_report_object_count_mismatch")
    if (header.queryShardObjectsRead == 0 &&
        (header.queryShardCid.len != 0 ||
         header.queryShardContentRoot.len != 0 ||
         header.queryShardEntryCount != 0)) ||
       (header.queryShardObjectsRead == 1 &&
        (!merkle_store_codec.CsgCoreMerkleStoreCidValid(
             header.queryShardCid) ||
         !merkle_store_codec.CsgCoreMerkleStoreCidValid(
             header.queryShardContentRoot) ||
         header.queryShardEntryCount < 0)):
        return csgQueryReportVerifyFail(
            "merkle_query_report_query_shard_cid_mismatch")
    var byteTotal: int64
    if !csgQueryAccumulateByteCount(
           byteTotal, header.manifestBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, header.queryShardBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, header.partitionBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, header.membershipBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, header.proofNodeBytesRead) ||
       header.contentObjectBytesRead != byteTotal:
        return csgQueryReportVerifyFail(
            "merkle_query_report_byte_count_mismatch")
    if header.manifestBytesRead <= 0 ||
       (header.queryShardObjectsRead == 0) !=
           (header.queryShardBytesRead == 0) ||
       (header.partitionObjectsRead == 0) !=
           (header.partitionBytesRead == 0) ||
       (header.membershipObjectsRead == 0) !=
           (header.membershipBytesRead == 0) ||
       (header.proofNodeObjectsRead == 0) !=
           (header.proofNodeBytesRead == 0):
        return csgQueryReportVerifyFail(
            "merkle_query_report_byte_accounting_invalid")
    if (header.queryShardObjectsRead == 0 &&
        (header.hitCount != 0 ||
         header.partitionObjectsRead != 0 ||
         header.membershipObjectsRead != 0 ||
         header.proofNodeObjectsRead != 0)) ||
       (header.hitCount > 0 &&
        (header.partitionObjectsRead <= 0 ||
         header.proofNodeObjectsRead <= 0)) ||
       int64(header.proofNodeObjectsRead) >
           int64(header.hitCount) +
           int64(header.pathStepCount):
        return csgQueryReportVerifyFail(
            "merkle_query_report_read_shape_invalid")

    var hits: csgMerkleQueryDecodedHit[]
    var reconstructed: str[]
    add(reconstructed, csgQueryReportHeaderLine(header))
    var hitLineIndexes: int32[]
    for hitOrdinal in 0..<header.hitCount:
        add(hitLineIndexes, -1)
    for lineIndex in 0..<decoded.lines.len:
        let kind = field.CsgCoreJsonKind(decoded.lines[lineIndex])
        if !kind.found ||
           kind.value != CsgMerkleLocalQueryHitKind:
            continue
        var ordinal: int32
        if !csgQueryReportLineOrdinal(
               decoded.lines[lineIndex],
               "hit_ordinal",
               ordinal) ||
           ordinal >= header.hitCount:
            return csgQueryReportVerifyFail(
                "merkle_query_report_hit_ordinal_invalid")
        if hitLineIndexes[ordinal] >= 0:
            return csgQueryReportVerifyFail(
                "merkle_query_report_hit_duplicate")
        hitLineIndexes[ordinal] = lineIndex
    for hitOrdinal in 0..<header.hitCount:
        let foundIndex = hitLineIndexes[hitOrdinal]
        if foundIndex < 0:
            return csgQueryReportVerifyFail(
                "merkle_query_report_hit_missing")
        var decodedHit: csgMerkleQueryDecodedHit
        if !csgQueryReportParseHit(
               decoded.lines[foundIndex],
               hitOrdinal,
               decodedHit,
               error):
            return csgQueryReportVerifyFail(error)
        add(hits, decodedHit)

    var stepStarts: int32[]
    var expectedPathStepCount: int64
    for hitOrdinal in 0..<hits.len:
        add(stepStarts, int32(expectedPathStepCount))
        expectedPathStepCount =
            expectedPathStepCount +
            int64(hits[hitOrdinal].pathCount)
        if expectedPathStepCount > 2147483647:
            return csgQueryReportVerifyFail(
                "merkle_query_report_path_count_overflow")
    if int32(expectedPathStepCount) !=
       header.pathStepCount:
        return csgQueryReportVerifyFail(
            "merkle_query_report_path_count_mismatch")
    var stepLineIndexes: int32[]
    for stepOrdinal in 0..<header.pathStepCount:
        add(stepLineIndexes, -1)
    for lineIndex in 0..<decoded.lines.len:
        let kind = field.CsgCoreJsonKind(decoded.lines[lineIndex])
        if !kind.found ||
           kind.value != CsgMerkleLocalQueryProofStepKind:
            continue
        var hitOrdinal: int32
        var stepOrdinal: int32
        if !csgQueryReportLineOrdinal(
               decoded.lines[lineIndex],
               "hit_ordinal",
               hitOrdinal) ||
           !csgQueryReportLineOrdinal(
               decoded.lines[lineIndex],
               "ordinal",
               stepOrdinal) ||
           hitOrdinal >= hits.len ||
           stepOrdinal >= hits[hitOrdinal].pathCount:
            return csgQueryReportVerifyFail(
                "merkle_query_report_step_ordinal_invalid")
        let flatIndex = stepStarts[hitOrdinal] + stepOrdinal
        if stepLineIndexes[flatIndex] >= 0:
            return csgQueryReportVerifyFail(
                "merkle_query_report_step_duplicate")
        stepLineIndexes[flatIndex] = lineIndex

    var parsedStepCount: int32
    var previousFactKey: str
    for hitOrdinal in 0..<hits.len:
        var proof = hits[hitOrdinal].hit.proof
        add(
            reconstructed,
            csgQueryReportHitLine(
                hits[hitOrdinal].hit,
                hitOrdinal,
                hits[hitOrdinal].pathCount))
        for stepOrdinal in 0..<hits[hitOrdinal].pathCount:
            let foundIndex =
                stepLineIndexes[
                    stepStarts[hitOrdinal] + stepOrdinal]
            if foundIndex < 0:
                return csgQueryReportVerifyFail(
                    "merkle_query_report_step_missing")
            if !csgQueryReportParseStep(
                   decoded.lines[foundIndex],
                   hitOrdinal,
                   stepOrdinal,
                   proof,
                   error):
                return csgQueryReportVerifyFail(error)
            add(
                reconstructed,
                csgQueryReportStepLine(
                    proof, hitOrdinal, stepOrdinal))
            parsedStepCount = parsedStepCount + 1
        hits[hitOrdinal].hit.proof = proof
        if !csgQueryReportVerifyHit(
               header,
               hits[hitOrdinal].hit,
               previousFactKey,
               error):
            return csgQueryReportVerifyFail(error)
        previousFactKey =
            strings.CloneStr(hits[hitOrdinal].hit.factKey)
    if parsedStepCount != header.pathStepCount:
        return csgQueryReportVerifyFail(
            "merkle_query_report_path_count_mismatch")
    let actualResultRoot =
        csgQueryDecodedResultRoot(
            header.headCid,
            header.manifestCid,
            header.factsRoot,
            header.queryShardCid,
            header.queryKeyRoot,
            hits)
    if actualResultRoot != header.resultRoot:
        return csgQueryReportVerifyFail(
            "merkle_query_report_result_root_mismatch")
    if header.hitCount > 0 &&
       header.proofNodeObjectsRead <= 0:
        return csgQueryReportVerifyFail(
            "merkle_query_report_proof_read_missing")
    var reencoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(reconstructed)
    if !reencoded.ok:
        return csgQueryReportVerifyFail(
            "merkle_query_report_reencode_failed")
    let canonical = rawbytes.BytesEqual(bytes, reencoded.bytes)
    rawbytes.BytesFree(reencoded.bytes)
    if !canonical:
        return csgQueryReportVerifyFail(
            "merkle_query_report_noncanonical")
    var out: CsgCoreMerkleQueryReportVerifyResult
    out.ok = true
    out.reportCid = strings.CloneStr(actualReportCid)
    out.headGeneration = header.generation
    out.headCid = strings.CloneStr(header.headCid)
    out.manifestCid = strings.CloneStr(header.manifestCid)
    out.csgcByteCount = header.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(header.csgcDirectoryCid)
    out.csgcObjectCid = strings.CloneStr(header.csgcObjectCid)
    out.factCount = header.factCount
    out.factsRoot = strings.CloneStr(header.factsRoot)
    out.dagRootCid = strings.CloneStr(header.dagRootCid)
    out.subgraphCid = strings.CloneStr(header.subgraphCid)
    out.queryBucket = strings.CloneStr(header.queryBucket)
    out.queryShardRoot = strings.CloneStr(header.queryShardRoot)
    out.queryShardCid = strings.CloneStr(header.queryShardCid)
    out.queryShardContentRoot =
        strings.CloneStr(header.queryShardContentRoot)
    out.queryShardEntryCount = header.queryShardEntryCount
    out.queryKeyRoot = strings.CloneStr(header.queryKeyRoot)
    out.resultRoot = strings.CloneStr(header.resultRoot)
    out.indexKind = strings.CloneStr(header.indexKind)
    out.term = strings.CloneStr(header.term)
    out.hitCount = header.hitCount
    out.pathStepCount = header.pathStepCount
    out.objectsRead = header.objectsRead
    out.contentObjectBytesRead =
        header.contentObjectBytesRead
    out.completeReport = false
    out.fullClosureVerified = false
    out.productionAdmission = false
    return out

@borrows
fn csgQueryReport(
        head:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult,
        out: CsgCoreMerkleQueryResult): str =
    var report: str =
        "{\"complete_report\":false,\"content_object_bytes_read\":"
    csgQueryAppend(
        report, strings.Int64ToStr(out.contentObjectBytesRead))
    csgQueryAppend(report, ",\"full_closure_verified\":false")
    csgQueryAppend(report, ",\"generation_records_read\":")
    csgQueryAppend(
        report,
        strings.IntToStr(out.generationRecordsRead))
    csgQueryAppend(report, ",\"head\":{\"generation\":")
    csgQueryAppend(
        report,
        strings.Int64ToStr(out.headGeneration))
    csgQueryAppend(report, ",\"head_cid\":")
    csgQueryAppend(report, csgQueryJson(out.headCid))
    csgQueryAppend(report, "},\"hit_count\":")
    csgQueryAppend(
        report, strings.IntToStr(out.hits.len))
    csgQueryAppend(report, ",\"hits\":[")
    for i in 0..<out.hits.len:
        if i > 0:
            csgQueryAppend(report, ",")
        csgQueryAppend(
            report,
            csgQueryHitReport(out.hits[i]))
    csgQueryAppend(report, "],\"kind\":")
    csgQueryAppend(
        report,
        csgQueryJson(CsgMerkleLocalQueryReportKind))
    csgQueryAppend(
        report, ",\"lowering_admission\":false")
    csgQueryAppend(report, ",\"manifest\":{\"cid\":")
    csgQueryAppend(report, csgQueryJson(out.manifestCid))
    csgQueryAppend(report, ",\"csgc_byte_count\":")
    csgQueryAppend(
        report, strings.IntToStr(out.csgcByteCount))
    csgQueryAppend(report, ",\"csgc_directory_cid\":")
    csgQueryAppend(report, csgQueryJson(out.csgcDirectoryCid))
    csgQueryAppend(report, ",\"csgc_object_cid\":")
    csgQueryAppend(report, csgQueryJson(out.csgcObjectCid))
    csgQueryAppend(report, ",\"dag_root_cid\":")
    csgQueryAppend(report, csgQueryJson(out.dagRootCid))
    csgQueryAppend(report, ",\"fact_count\":")
    csgQueryAppend(
        report,
        strings.IntToStr(head.manifest.factCount))
    csgQueryAppend(report, ",\"facts_root\":")
    csgQueryAppend(report, csgQueryJson(out.factsRoot))
    csgQueryAppend(report, ",\"profile_set_cid\":")
    csgQueryAppend(
        report,
        csgQueryJson(
            head.manifest.profileSetCid))
    csgQueryAppend(report, ",\"profiles\":")
    csgQueryAppend(
        report,
        csgQueryProfilesJson(
            head.manifest.profiles))
    csgQueryAppend(report, ",\"standard\":")
    csgQueryAppend(
        report, csgQueryJson(head.manifest.standard))
    csgQueryAppend(report, ",\"subgraph_cid\":")
    csgQueryAppend(report, csgQueryJson(out.subgraphCid))
    csgQueryAppend(
        report,
        "},\"object_bytes_read_by_kind\":{\"manifest\":")
    csgQueryAppend(
        report, strings.Int64ToStr(out.manifestBytesRead))
    csgQueryAppend(report, ",\"membership\":")
    csgQueryAppend(
        report, strings.Int64ToStr(out.membershipBytesRead))
    csgQueryAppend(report, ",\"partition\":")
    csgQueryAppend(
        report, strings.Int64ToStr(out.partitionBytesRead))
    csgQueryAppend(report, ",\"proof_node\":")
    csgQueryAppend(
        report, strings.Int64ToStr(out.proofNodeBytesRead))
    csgQueryAppend(report, ",\"query_shard\":")
    csgQueryAppend(
        report, strings.Int64ToStr(out.queryShardBytesRead))
    csgQueryAppend(report, "},\"objects_read\":")
    csgQueryAppend(
        report, strings.IntToStr(out.objectsRead))
    csgQueryAppend(
        report, ",\"objects_read_by_kind\":{\"manifest\":")
    csgQueryAppend(
        report,
        strings.IntToStr(out.manifestObjectsRead))
    csgQueryAppend(report, ",\"membership\":")
    csgQueryAppend(
        report,
        strings.IntToStr(out.membershipObjectsRead))
    csgQueryAppend(report, ",\"partition\":")
    csgQueryAppend(
        report,
        strings.IntToStr(out.partitionObjectsRead))
    csgQueryAppend(report, ",\"proof_node\":")
    csgQueryAppend(
        report,
        strings.IntToStr(out.proofNodeObjectsRead))
    csgQueryAppend(report, ",\"query_shard\":")
    csgQueryAppend(
        report,
        strings.IntToStr(out.queryShardObjectsRead))
    csgQueryAppend(report, "},\"production_admission\":false")
    csgQueryAppend(report, ",\"query\":{\"bucket\":")
    csgQueryAppend(report, csgQueryJson(out.queryBucket))
    csgQueryAppend(report, ",\"index_kind\":")
    csgQueryAppend(report, csgQueryJson(out.indexKind))
    csgQueryAppend(report, ",\"query_key_root\":")
    csgQueryAppend(report, csgQueryJson(out.queryKeyRoot))
    csgQueryAppend(report, ",\"query_shard_cid\":")
    csgQueryAppend(report, csgQueryJson(out.queryShardCid))
    csgQueryAppend(report, ",\"query_shard_content_root\":")
    csgQueryAppend(
        report, csgQueryJson(out.queryShardContentRoot))
    csgQueryAppend(report, ",\"query_shard_entry_count\":")
    csgQueryAppend(
        report, strings.IntToStr(out.queryShardEntryCount))
    csgQueryAppend(report, ",\"query_shard_root\":")
    csgQueryAppend(report, csgQueryJson(out.queryShardRoot))
    csgQueryAppend(report, ",\"term\":")
    csgQueryAppend(report, csgQueryJson(out.term))
    csgQueryAppend(report, "},\"report_cid\":")
    csgQueryAppend(report, csgQueryJson(out.reportCid))
    csgQueryAppend(report, ",\"result_root\":")
    csgQueryAppend(report, csgQueryJson(out.resultRoot))
    csgQueryAppend(
        report,
        ",\"verification_scope\":\"local_query\"}")
    return report

@borrows
fn csgQueryManifestBytesRead(
        head:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult,
        error: var str): int64 =
    var encoded =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            head.manifest)
    if !encoded.ok ||
       encoded.cid != head.head.manifestCid:
        if encoded.ok:
            rawbytes.BytesFree(encoded.bytes)
        error = "merkle_query_manifest_reencode_mismatch"
        return 0
    let byteCount = int64(rawbytes.BytesLen(encoded.bytes))
    rawbytes.BytesFree(encoded.bytes)
    if byteCount <= 0:
        error = "merkle_query_manifest_byte_count_invalid"
        return 0
    return byteCount

@borrows
fn CsgCoreMerkleStoreQuery(
        parentPath: str,
        storeName: str,
        indexKind: str,
        term: str): CsgCoreMerkleQueryResult =
    if !csgQuerySupportedIndexKind(indexKind):
        return csgQueryFail(
            "merkle_query_index_kind_invalid")
    if term.len == 0:
        return csgQueryFail(
            "merkle_query_term_empty")
    let head =
        merkle_store.CsgCoreMerkleStoreReadManifestOnlyHead(
            parentPath, storeName)
    if !head.ok:
        return csgQueryFail(
            csgQueryCat(
                "merkle_query_head ",
                head.error))
    if !head.present:
        return csgQueryFail(
            "merkle_query_head_missing")
    if !csgQueryManifestOnlyAuthorityValid(head):
        return csgQueryFail(
            "merkle_query_head_authority_invalid")
    var subgraphCid: str
    var manifestBindingError: str
    if !csgQueryManifestBinding(
           head.manifest,
           subgraphCid,
           manifestBindingError):
        return csgQueryFail(manifestBindingError)
    var accountingError: str
    let manifestBytesRead =
        csgQueryManifestBytesRead(head, accountingError)
    if accountingError.len > 0:
        return csgQueryFail(accountingError)

    let bucket =
        merkle_artifacts.CsgCoreMerkleQueryBucket(
            indexKind, term)
    if bucket.len == 0:
        return csgQueryFail(
            "merkle_query_bucket_invalid")
    let queryKeyRoot =
        csgQueryKeyRoot(indexKind, term, bucket)
    let descriptorAt =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            head.manifest.queryShards, bucket)
    if descriptorAt < 0:
        /* Sparse manifests omit empty buckets: an absent descriptor
           means no record can match, which is an empty hit set, not
           a store-corruption error. */
        var confirmedGenerationRecordsRead: int32
        var confirmedManifestObjectsRead: int32
        var confirmedManifestBytesRead: int64
        var headRecheckError: str
        if !csgQueryConfirmHead(
               parentPath,
               storeName,
               head,
               confirmedGenerationRecordsRead,
               confirmedManifestObjectsRead,
               confirmedManifestBytesRead,
               headRecheckError):
            return csgQueryFail(headRecheckError)
        var totalManifestBytesRead = manifestBytesRead
        if !csgQueryAccumulateByteCount(
               totalManifestBytesRead,
               confirmedManifestBytesRead):
            return csgQueryFail(
                "merkle_query_manifest_byte_count_overflow")
        var empty: CsgCoreMerkleQueryResult
        empty.ok = true
        empty.verificationScope = "local_query"
        empty.fullClosureVerified = false
        empty.productionAdmission = false
        empty.generationRecordsRead =
            head.generationRecordsRead +
            confirmedGenerationRecordsRead
        empty.manifestObjectsRead =
            head.objectsRead +
            confirmedManifestObjectsRead
        empty.objectsRead = empty.manifestObjectsRead
        empty.manifestBytesRead = totalManifestBytesRead
        empty.contentObjectBytesRead =
            totalManifestBytesRead
        empty.headGeneration = head.head.generation
        empty.headCid = strings.CloneStr(head.head.headCid)
        empty.manifestCid =
            strings.CloneStr(head.head.manifestCid)
        empty.csgcByteCount = head.manifest.csgcByteCount
        empty.csgcDirectoryCid =
            strings.CloneStr(head.manifest.csgcDirectoryCid)
        empty.csgcObjectCid =
            strings.CloneStr(head.manifest.csgcObjectCid)
        empty.factCount = head.manifest.factCount
        empty.factsRoot =
            strings.CloneStr(head.manifest.factsRoot)
        empty.dagRootCid =
            strings.CloneStr(head.manifest.dagRootCid)
        empty.subgraphCid = strings.CloneStr(subgraphCid)
        empty.queryBucket = strings.CloneStr(bucket)
        empty.queryShardRoot =
            strings.CloneStr(head.manifest.queryShardRoot)
        empty.queryKeyRoot = strings.CloneStr(queryKeyRoot)
        empty.indexKind = strings.CloneStr(indexKind)
        empty.term = strings.CloneStr(term)
        empty.resultRoot =
            csgQueryResultRoot(
                empty.headCid,
                empty.manifestCid,
                empty.factsRoot,
                empty.queryShardCid,
                empty.queryKeyRoot,
                empty.hits)
        var artifact =
            CsgCoreMerkleQueryReportEncode(head, empty)
        if !artifact.ok:
            return csgQueryFail(artifact.error)
        let expected =
            CsgCoreMerkleQueryExpectedBindingFromResult(empty)
        let verified = CsgCoreMerkleQueryReportVerify(
            artifact.bytes,
            artifact.cid,
            expected)
        if !verified.ok:
            rawbytes.BytesFree(artifact.bytes)
            return csgQueryFail(
                csgQueryCat(
                    "merkle_query_report_self_verify ",
                    verified.error))
        empty.reportCid = strings.CloneStr(artifact.cid)
        empty.reportLines = artifact.lines
        empty.reportBytes = artifact.bytes
        empty.report = csgQueryReport(head, empty)
        return empty
    let descriptor =
        head.manifest.queryShards[descriptorAt]
    var indexObject =
        merkle_store.CsgCoreMerkleStoreReadObject(
            head.storeRoot,
            merkle_store.CsgCoreMerkleStoreIndexArtifactKind(),
            descriptor.cid)
    if !indexObject.ok:
        return csgQueryFail(
            csgQueryCat(
                "merkle_query_index_read ",
                indexObject.error))
    let queryShardBytesRead =
        int64(rawbytes.BytesLen(indexObject.bytes))
    var index =
        merkle_artifacts.CsgCoreMerkleQueryShardDecode(
            indexObject.bytes)
    rawbytes.BytesFree(indexObject.bytes)
    if !index.ok ||
       index.cid != descriptor.cid ||
       index.header.profileSetCid !=
           head.manifest.profileSetCid ||
       index.header.bucket != bucket ||
       index.shardRoot != descriptor.root ||
       index.entryCount != descriptor.entryCount ||
       index.entryCount != index.records.len:
        if index.ok:
            rawbytes.BytesFree(index.bytes)
        return csgQueryFail(
            "merkle_query_index_manifest_mismatch")

    var first: int32
    var finish: int32
    csgQueryFindRange(
        index.records,
        indexKind,
        term,
        first,
        finish)
    var loaded: csgMerkleLoadedQueryPartition[]
    var loadedNodes: csgMerkleLoadedQueryNode[]
    var hits: CsgCoreMerkleQueryHit[]
    var previousFactKey: str
    var error: str
    for recordIndex in first..<finish:
        let record = index.records[recordIndex]
        if recordIndex > first &&
           record.factKey == previousFactKey:
            error = "merkle_query_duplicate_fact"
            break
        previousFactKey =
            strings.CloneStr(record.factKey)
        var duplicatePartition: bool
        let manifestIndex =
            csgQueryManifestPartitionIndex(
                head.manifest,
                record,
                duplicatePartition)
        if duplicatePartition:
            error =
                "merkle_query_manifest_partition_duplicate"
            break
        if manifestIndex < 0:
            error =
                "merkle_query_manifest_partition_missing"
            break
        var loadedIndex =
            csgQueryLoadedIndex(
                loaded, manifestIndex)
        if loadedIndex < 0:
            loadedIndex =
                csgQueryLoadPartition(
                    head.storeRoot,
                    head.manifest,
                    manifestIndex,
                    loaded,
                    error)
            if error.len > 0:
                break
        let expected =
            head.manifest.partitions[manifestIndex]
        let partition = loaded[loadedIndex].partition
        let membership = loaded[loadedIndex].membership
        var factKeyError: str
        let factIndex =
            csgQueryPartitionFactIndex(
                partition,
                record.factKey,
                factKeyError)
        if factKeyError.len > 0:
            error = factKeyError
            break
        if factIndex < 0:
            error = "merkle_query_partition_fact_missing"
            break
        let membershipIndex =
            csgQueryMembershipRecordIndex(
                membership, record.factKey)
        if membershipIndex < 0:
            error =
                "merkle_query_membership_record_missing"
            break
        let membershipRecord =
            membership.records[membershipIndex]
        let fact = partition.facts[factIndex]
        var hashError: str
        let factHash =
            csgQueryFactHashCid(fact, hashError)
        if hashError.len > 0:
            error = csgQueryCat(
                "merkle_query_fact_hash ",
                hashError)
            break
        if membershipRecord.partitionId !=
               record.partitionId ||
           membershipRecord.sourceId !=
               record.sourceId ||
           membershipRecord.sourceCid !=
               record.sourceCid ||
           membershipRecord.factKey !=
               record.factKey ||
           membershipRecord.factHash !=
               record.factHash ||
           membershipRecord.leafCid !=
               record.leafCid ||
           factHash != record.factHash:
            error = "merkle_query_fact_binding_mismatch"
            break
        if !csgQueryRecordMatchesFact(
               record, fact):
            error =
                "merkle_query_index_term_mismatch"
            break
        var proof = csgQueryProofFromStore(
            head.storeRoot,
            head.manifest,
            record.factKey,
            loadedNodes,
            error)
        if error.len > 0:
            break
        let proofVerified =
            merkle_dag.CsgCoreMerkleVerifyFact(
                proof, head.manifest.factsRoot, fact)
        if !proofVerified.ok:
            error = csgQueryCat(
                "merkle_query_fact_proof ",
                proofVerified.error)
            break
        var hit = csgQueryHit(record, expected, fact)
        hit.proof = proof
        add(hits, hit)

    let partitionObjectsRead = loaded.len
    var partitionBytesRead: int64
    var membershipBytesRead: int64
    for i in 0..<loaded.len:
        if !csgQueryAccumulateByteCount(
               partitionBytesRead,
               loaded[i].partitionBytesRead) ||
           !csgQueryAccumulateByteCount(
               membershipBytesRead,
               loaded[i].membershipBytesRead):
            error = "merkle_query_partition_byte_count_overflow"
            break
    let proofNodeObjectsRead = loadedNodes.len
    var proofNodeBytesRead: int64
    if error.len == 0:
        for i in 0..<loadedNodes.len:
            if !csgQueryAccumulateByteCount(
                   proofNodeBytesRead,
                   loadedNodes[i].byteCount):
                error = "merkle_query_proof_byte_count_overflow"
                break
    csgQueryFreeLoaded(loaded)
    rawbytes.BytesFree(index.bytes)
    if error.len > 0:
        return csgQueryFail(error)
    var confirmedGenerationRecordsRead: int32
    var confirmedManifestObjectsRead: int32
    var confirmedManifestBytesRead: int64
    var headRecheckError: str
    if !csgQueryConfirmHead(
           parentPath,
           storeName,
           head,
           confirmedGenerationRecordsRead,
           confirmedManifestObjectsRead,
           confirmedManifestBytesRead,
           headRecheckError):
        return csgQueryFail(headRecheckError)
    var totalManifestBytesRead = manifestBytesRead
    if !csgQueryAccumulateByteCount(
           totalManifestBytesRead,
           confirmedManifestBytesRead):
        return csgQueryFail(
            "merkle_query_manifest_byte_count_overflow")

    var out: CsgCoreMerkleQueryResult
    out.ok = true
    out.verificationScope = "local_query"
    out.fullClosureVerified = false
    out.productionAdmission = false
    out.generationRecordsRead =
        head.generationRecordsRead +
        confirmedGenerationRecordsRead
    out.manifestObjectsRead =
        head.objectsRead +
        confirmedManifestObjectsRead
    out.queryShardObjectsRead = 1
    out.partitionObjectsRead =
        partitionObjectsRead
    out.membershipObjectsRead =
        partitionObjectsRead
    out.proofNodeObjectsRead =
        proofNodeObjectsRead
    let objectTotal =
        int64(out.manifestObjectsRead) +
        int64(out.queryShardObjectsRead) +
        int64(out.partitionObjectsRead) +
        int64(out.membershipObjectsRead) +
        int64(out.proofNodeObjectsRead)
    if objectTotal > 2147483647:
        return csgQueryFail(
            "merkle_query_object_count_overflow")
    out.objectsRead = int32(objectTotal)
    out.manifestBytesRead = totalManifestBytesRead
    out.queryShardBytesRead = queryShardBytesRead
    out.partitionBytesRead = partitionBytesRead
    out.membershipBytesRead = membershipBytesRead
    out.proofNodeBytesRead = proofNodeBytesRead
    var byteTotal: int64
    if !csgQueryAccumulateByteCount(
           byteTotal, out.manifestBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, out.queryShardBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, out.partitionBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, out.membershipBytesRead) ||
       !csgQueryAccumulateByteCount(
           byteTotal, out.proofNodeBytesRead):
        return csgQueryFail(
            "merkle_query_byte_count_overflow")
    out.contentObjectBytesRead = byteTotal
    out.headGeneration = head.head.generation
    out.headCid = strings.CloneStr(head.head.headCid)
    out.manifestCid =
        strings.CloneStr(head.head.manifestCid)
    out.csgcByteCount = head.manifest.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(head.manifest.csgcDirectoryCid)
    out.csgcObjectCid =
        strings.CloneStr(head.manifest.csgcObjectCid)
    out.factCount = head.manifest.factCount
    out.factsRoot =
        strings.CloneStr(head.manifest.factsRoot)
    out.dagRootCid =
        strings.CloneStr(head.manifest.dagRootCid)
    out.subgraphCid = strings.CloneStr(subgraphCid)
    out.queryBucket = strings.CloneStr(bucket)
    out.queryShardRoot =
        strings.CloneStr(head.manifest.queryShardRoot)
    out.queryShardCid = strings.CloneStr(descriptor.cid)
    out.queryShardContentRoot = strings.CloneStr(descriptor.root)
    out.queryShardEntryCount = descriptor.entryCount
    out.queryKeyRoot = strings.CloneStr(queryKeyRoot)
    out.indexKind = strings.CloneStr(indexKind)
    out.term = strings.CloneStr(term)
    out.hits = hits
    out.resultRoot =
        csgQueryResultRoot(
            out.headCid,
            out.manifestCid,
            out.factsRoot,
            out.queryShardCid,
            out.queryKeyRoot,
            out.hits)
    var artifact = CsgCoreMerkleQueryReportEncode(head, out)
    if !artifact.ok:
        return csgQueryFail(artifact.error)
    let expected =
        CsgCoreMerkleQueryExpectedBindingFromResult(out)
    let verified = CsgCoreMerkleQueryReportVerify(
        artifact.bytes,
        artifact.cid,
        expected)
    if !verified.ok:
        rawbytes.BytesFree(artifact.bytes)
        return csgQueryFail(
            csgQueryCat(
                "merkle_query_report_self_verify ",
                verified.error))
    out.reportCid = strings.CloneStr(artifact.cid)
    out.reportLines = artifact.lines
    out.reportBytes = artifact.bytes
    out.report = csgQueryReport(head, out)
    return out
