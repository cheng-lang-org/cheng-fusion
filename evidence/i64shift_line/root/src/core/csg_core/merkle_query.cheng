import cheng/core/csg_core/validator

const
    CsgMerkleLocalQueryReportKind: str = "csg.merkle.local_query_report"
    CsgMerkleLocalQueryHitKind: str = "csg.merkle.local_query_hit"
    CsgMerkleLocalQueryProofStepKind: str =
        "csg.merkle.local_query_proof_step"
    CsgMerkleLocalQueryReportDomain: str =
        "csg_core.store.local_query_report"
    CsgMerkleLocalQueryKeyRootDomain: str =
        "csg_core.store.local_query_key_root"
    CsgMerkleLocalQueryResultRootDomain: str =
        "csg_core.store.local_query_result_root"
    CsgMerkleQuerySchemaNamespace: str = "csg_core::v1"

type
    CsgCoreMerkleQueryHit =
        fact: str
        factKey: str
        factHash: str
        leafCid: str
        partitionId: str
        partitionCid: str
        membershipCid: str
        sourceId: str
        sourceCid: str
        proof: merkle_dag.CsgCoreMerkleProof

    CsgCoreMerkleQueryResult =
        ok: bool
        error: str
        verificationScope: str
        fullClosureVerified: bool
        productionAdmission: bool
        generationRecordsRead: int32
        objectsRead: int32
        manifestObjectsRead: int32
        queryShardObjectsRead: int32
        partitionObjectsRead: int32
        membershipObjectsRead: int32
        proofNodeObjectsRead: int32
        contentObjectBytesRead: int64
        manifestBytesRead: int64
        queryShardBytesRead: int64
        partitionBytesRead: int64
        membershipBytesRead: int64
        proofNodeBytesRead: int64
        headGeneration: int64
        headCid: str
        manifestCid: str
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str
        factCount: int32
        factsRoot: str
        dagRootCid: str
        subgraphCid: str
        queryBucket: str
        queryShardRoot: str
        queryShardCid: str
        queryShardContentRoot: str
        queryShardEntryCount: int32
        queryKeyRoot: str
        resultRoot: str
        indexKind: str
        term: str
        hits: CsgCoreMerkleQueryHit[]
        report: str
        reportCid: str
        reportLines: str[]
        reportBytes: rawbytes.Bytes

    CsgCoreMerkleQueryReportArtifact =
        ok: bool
        error: str
        cid: str
        lines: str[]
        bytes: rawbytes.Bytes

    CsgCoreMerkleQueryReportVerifyResult =
        ok: bool
        error: str
        reportCid: str
        headGeneration: int64
        headCid: str
        manifestCid: str
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str
        factCount: int32
        factsRoot: str
        dagRootCid: str
        subgraphCid: str
        queryBucket: str
        queryShardRoot: str
        queryShardCid: str
        queryShardContentRoot: str
        queryShardEntryCount: int32
        queryKeyRoot: str
        resultRoot: str
        indexKind: str
        term: str
        hitCount: int32
        pathStepCount: int32
        objectsRead: int32
        contentObjectBytesRead: int64
        completeReport: bool
        fullClosureVerified: bool
        productionAdmission: bool

    CsgCoreMerkleQueryExpectedBinding =
        headGeneration: int64
        headCid: str
        manifestCid: str
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str
        factsRoot: str
        subgraphCid: str
        queryBucket: str
        queryShardRoot: str
        queryShardCid: str
        queryShardContentRoot: str
        queryShardEntryCount: int32
        queryKeyRoot: str
        resultRoot: str
        indexKind: str
        term: str

    csgMerkleLoadedQueryPartition =
        manifestIndex: int32
        partition: merkle_artifacts.CsgCoreMerklePartitionFactsResult
        membership: merkle_artifacts.CsgCoreMerkleMembershipResult
        partitionBytesRead: int64
        membershipBytesRead: int64

    csgMerkleLoadedQueryNode =
        cid: str
        byteCount: int64
        node: merkle_dag.CsgCoreMerkleNodeRecord

    csgMerkleQueryReportHeader =
        generation: int64
        generationRecordsRead: int32
        headCid: str
        manifestCid: str
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str
        factsRoot: str
        dagRootCid: str
        subgraphCid: str
        factCount: int32
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaCid: str
        indexKind: str
        term: str
        hitCount: int32
        pathStepCount: int32
        objectsRead: int32
        manifestObjectsRead: int32
        queryBucket: str
        queryShardObjectsRead: int32
        queryShardRoot: str
        queryShardCid: str
        queryShardContentRoot: str
        queryShardEntryCount: int32
        partitionObjectsRead: int32
        membershipObjectsRead: int32
        proofNodeObjectsRead: int32
        contentObjectBytesRead: int64
        manifestBytesRead: int64
        queryShardBytesRead: int64
        partitionBytesRead: int64
        membershipBytesRead: int64
        proofNodeBytesRead: int64
        queryKeyRoot: str
        resultRoot: str

    csgMerkleQueryDecodedHit =
        hit: CsgCoreMerkleQueryHit
        pathCount: int32

@borrows
fn csgQueryCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgQueryAppend(out: var str, value: str) =
    out = csgQueryCat(out, value)

fn csgQueryRootAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn csgQueryRootAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    csgQueryRootAppendU32(buf, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[i])

fn csgQueryRootFinish(
        buf: var layout.ByteBuf): str =
    let digest = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return csgQueryCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgQueryKeyRoot(
        indexKind: str,
        term: str,
        bucket: str): str =
    var buf = layout.ByteBufInit(256)
    csgQueryRootAppendText(
        buf, CsgMerkleLocalQueryKeyRootDomain)
    csgQueryRootAppendText(buf, indexKind)
    csgQueryRootAppendText(buf, term)
    csgQueryRootAppendText(buf, bucket)
    return csgQueryRootFinish(buf)

@borrows
fn csgQueryRootAppendHit(
        buf: var layout.ByteBuf,
        hit: CsgCoreMerkleQueryHit) =
    csgQueryRootAppendText(buf, hit.factKey)
    csgQueryRootAppendText(buf, hit.factHash)
    csgQueryRootAppendText(buf, hit.leafCid)
    csgQueryRootAppendText(buf, hit.partitionId)
    csgQueryRootAppendText(buf, hit.partitionCid)
    csgQueryRootAppendText(buf, hit.membershipCid)
    csgQueryRootAppendText(buf, hit.sourceId)
    csgQueryRootAppendText(buf, hit.sourceCid)

@borrows
fn csgQueryResultRoot(
        headCid: str,
        manifestCid: str,
        factsRoot: str,
        queryShardCid: str,
        queryKeyRoot: str,
        hits: CsgCoreMerkleQueryHit[]): str =
    var buf = layout.ByteBufInit(512)
    csgQueryRootAppendText(
        buf, CsgMerkleLocalQueryResultRootDomain)
    csgQueryRootAppendText(buf, headCid)
    csgQueryRootAppendText(buf, manifestCid)
    csgQueryRootAppendText(buf, factsRoot)
    csgQueryRootAppendText(buf, queryShardCid)
    csgQueryRootAppendText(buf, queryKeyRoot)
    csgQueryRootAppendU32(buf, hits.len)
    for i in 0..<hits.len:
        csgQueryRootAppendHit(buf, hits[i])
    return csgQueryRootFinish(buf)

@borrows
fn csgQueryDecodedResultRoot(
        headCid: str,
        manifestCid: str,
        factsRoot: str,
        queryShardCid: str,
        queryKeyRoot: str,
        hits: csgMerkleQueryDecodedHit[]): str =
    var buf = layout.ByteBufInit(512)
    csgQueryRootAppendText(
        buf, CsgMerkleLocalQueryResultRootDomain)
    csgQueryRootAppendText(buf, headCid)
    csgQueryRootAppendText(buf, manifestCid)
    csgQueryRootAppendText(buf, factsRoot)
    csgQueryRootAppendText(buf, queryShardCid)
    csgQueryRootAppendText(buf, queryKeyRoot)
    csgQueryRootAppendU32(buf, hits.len)
    for i in 0..<hits.len:
        csgQueryRootAppendHit(buf, hits[i].hit)
    return csgQueryRootFinish(buf)

@borrows
fn csgQueryJson(value: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(
        value)

@borrows
fn csgQueryProfilesJson(profiles: str[]): str =
    var out = "["
    for i in 0..<profiles.len:
        if i > 0:
            csgQueryAppend(out, ",")
        csgQueryAppend(out, csgQueryJson(profiles[i]))
    csgQueryAppend(out, "]")
    return out

@borrows
fn csgQueryTextCompare(
        left: str,
        right: str): int32 =
    let common =
        if left.len < right.len:
            left.len
        else:
            right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgQueryPairCompare(
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        indexKind: str,
        term: str): int32 =
    let kindOrder =
        csgQueryTextCompare(
            record.indexKind, indexKind)
    if kindOrder != 0:
        return kindOrder
    return csgQueryTextCompare(record.term, term)

@borrows
fn csgQuerySupportedIndexKind(
        indexKind: str): bool =
    return indexKind == "fact_key" ||
        indexKind == "kind" ||
        indexKind == "symbol" ||
        indexKind == "name" ||
        indexKind == "file" ||
        indexKind == "caller"

@borrows
fn csgQueryFail(error: str):
        CsgCoreMerkleQueryResult =
    var out: CsgCoreMerkleQueryResult
    out.error = strings.CloneStr(error)
    out.verificationScope = "local_query"
    return out

@borrows
fn csgQueryManifestOnlyAuthorityValid(
        head:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult):
        bool =
    return head.ok && head.present &&
        head.verificationScope == "successor_chain_logical" &&
        head.fullClosureVerified &&
        !head.productionAdmission &&
        head.generationRecordsRead ==
            int32(head.head.generation + int64(1)) &&
        head.objectsRead == head.generationRecordsRead &&
        head.storeRoot.len > 0 &&
        head.head.generation >= int64(0) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            head.head.headCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            head.head.manifestCid)

@borrows
fn csgQuerySameHead(
        before:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult,
        after:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult):
        bool =
    return csgQueryManifestOnlyAuthorityValid(before) &&
        csgQueryManifestOnlyAuthorityValid(after) &&
        before.storeRoot == after.storeRoot &&
        before.head.generation == after.head.generation &&
        before.head.manifestCid == after.head.manifestCid &&
        before.head.previousHeadCid == after.head.previousHeadCid &&
        before.head.receiptCid == after.head.receiptCid &&
        before.head.headCid == after.head.headCid

@borrows
fn csgQueryConfirmHead(
        parentPath: str,
        storeName: str,
        before:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult,
        generationRecordsRead: var int32,
        manifestObjectsRead: var int32,
        manifestBytesRead: var int64,
        error: var str): bool =
    error = ""
    let after =
        merkle_store.CsgCoreMerkleStoreReadManifestOnlyHead(
            parentPath, storeName)
    if !after.ok:
        error = csgQueryCat(
            "merkle_query_head_recheck ",
            after.error)
        return false
    if !csgQuerySameHead(before, after):
        error = "merkle_query_head_changed"
        return false
    var accountingError: str
    let byteCount =
        csgQueryManifestBytesRead(
            after, accountingError)
    if accountingError.len > 0:
        error = strings.CloneStr(accountingError)
        return false
    generationRecordsRead = after.generationRecordsRead
    manifestObjectsRead = after.objectsRead
    manifestBytesRead = byteCount
    return true

@borrows
fn csgQueryManifestBinding(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        subgraphCid: var str,
        error: var str): bool =
    error = merkle_manifest.CsgCoreMerkleManifestError(
        manifest)
    if error.len > 0:
        error = csgQueryCat(
            "merkle_query_manifest_binding ", error)
        return false
    subgraphCid =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            manifest.factCount,
            manifest.dagRootCid,
            error)
    if error.len > 0:
        error = "merkle_query_subgraph_binding_invalid"
        return false
    let expectedFactsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            manifest.standard,
            manifest.profiles,
            CsgMerkleQuerySchemaNamespace,
            manifest.schemaCid,
            subgraphCid,
            error)
    if error.len > 0 ||
       expectedFactsRoot != manifest.factsRoot:
        error = "merkle_query_facts_root_binding_invalid"
        return false
    return true

@borrows
fn csgQueryExpectedBindingValid(
        binding: CsgCoreMerkleQueryExpectedBinding): bool =
    if binding.headGeneration < int64(0) ||
       binding.csgcByteCount < csgc.CsgCoreCsgcHeaderSize ||
       binding.term.len == 0 ||
       !csgQuerySupportedIndexKind(binding.indexKind) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.headCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.csgcDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.subgraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.queryShardRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.queryKeyRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.resultRoot):
        return false
    let expectedBucket =
        merkle_artifacts.CsgCoreMerkleQueryBucket(
            binding.indexKind, binding.term)
    if expectedBucket.len == 0 ||
       binding.queryBucket != expectedBucket ||
       binding.queryKeyRoot !=
           csgQueryKeyRoot(
               binding.indexKind,
               binding.term,
               binding.queryBucket):
        return false
    if binding.queryShardCid.len == 0:
        return binding.queryShardContentRoot.len == 0 &&
            binding.queryShardEntryCount == 0
    return binding.queryShardEntryCount >= 0 &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            binding.queryShardCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            binding.queryShardContentRoot)

@borrows
fn CsgCoreMerkleQueryExpectedBindingFromResult(
        query: CsgCoreMerkleQueryResult):
        CsgCoreMerkleQueryExpectedBinding =
    var out: CsgCoreMerkleQueryExpectedBinding
    out.headGeneration = query.headGeneration
    out.headCid = strings.CloneStr(query.headCid)
    out.manifestCid = strings.CloneStr(query.manifestCid)
    out.csgcByteCount = query.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(query.csgcDirectoryCid)
    out.csgcObjectCid = strings.CloneStr(query.csgcObjectCid)
    out.factsRoot = strings.CloneStr(query.factsRoot)
    out.subgraphCid = strings.CloneStr(query.subgraphCid)
    out.queryBucket = strings.CloneStr(query.queryBucket)
    out.queryShardRoot = strings.CloneStr(query.queryShardRoot)
    out.queryShardCid = strings.CloneStr(query.queryShardCid)
    out.queryShardContentRoot =
        strings.CloneStr(query.queryShardContentRoot)
    out.queryShardEntryCount = query.queryShardEntryCount
    out.queryKeyRoot = strings.CloneStr(query.queryKeyRoot)
    out.resultRoot = strings.CloneStr(query.resultRoot)
    out.indexKind = strings.CloneStr(query.indexKind)
    out.term = strings.CloneStr(query.term)
    return out

@borrows
fn csgQueryFindRange(
        records:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        indexKind: str,
        term: str,
        first: var int32,
        finish: var int32) =
    var low: int32
    var high: int32 = records.len
    while low < high:
        let middle = low + (high - low) / 2
        if csgQueryPairCompare(
               records[middle],
               indexKind,
               term) < 0:
            low = middle + 1
        else:
            high = middle
    first = low
    high = records.len
    while low < high:
        let middle = low + (high - low) / 2
        if csgQueryPairCompare(
               records[middle],
               indexKind,
               term) <= 0:
            low = middle + 1
        else:
            high = middle
    finish = low

@borrows
fn csgQueryManifestPartitionIndex(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        duplicate: var bool): int32 =
    var found: int32 = -1
    duplicate = false
    for i in 0..<manifest.partitions.len:
        let partitionId =
            merkle_manifest.CsgCoreMerklePartitionId(
                manifest.partitions[i])
        if partitionId == record.partitionId &&
           manifest.partitions[i].sourceId ==
               record.sourceId &&
           manifest.partitions[i].sourceCid ==
               record.sourceCid:
            if found >= 0:
                duplicate = true
                return -1
            found = i
    return found

@borrows
fn csgQueryLoadedIndex(
        loaded: csgMerkleLoadedQueryPartition[],
        manifestIndex: int32): int32 =
    for i in 0..<loaded.len:
        if loaded[i].manifestIndex == manifestIndex:
            return i
    return -1

fn csgQueryFreeLoaded(
        loaded: var csgMerkleLoadedQueryPartition[]) =
    for i in 0..<loaded.len:
        rawbytes.BytesFree(loaded[i].partition.bytes)
        rawbytes.BytesFree(loaded[i].membership.bytes)
    loaded = []

@borrows
fn csgQueryPartitionMatchesManifest(
        expected:
            merkle_manifest.CsgCoreMerklePartitionRecord,
        actual:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult):
        bool =
    return actual.cid == expected.factsCid &&
        actual.header.partitionId ==
            merkle_manifest.CsgCoreMerklePartitionId(
                expected) &&
        actual.header.sourceId == expected.sourceId &&
        actual.header.sourceCid == expected.sourceCid &&
        actual.header.factKind == expected.factKind &&
        actual.factsRoot == expected.factsRoot &&
        actual.dagRootCid == expected.dagRootCid &&
        actual.factCount == expected.factCount &&
        actual.facts.len == expected.factCount

@borrows
fn csgQueryMembershipMatchesManifest(
        expected:
            merkle_manifest.CsgCoreMerklePartitionRecord,
        actual:
            merkle_artifacts.CsgCoreMerkleMembershipResult):
        bool =
    return actual.cid == expected.membershipCid &&
        actual.header.partitionId ==
            merkle_manifest.CsgCoreMerklePartitionId(
                expected) &&
        actual.header.sourceId == expected.sourceId &&
        actual.header.sourceCid == expected.sourceCid &&
        actual.header.factKind == expected.factKind &&
        actual.header.factsCid == expected.factsCid &&
        actual.header.factsRoot == expected.factsRoot &&
        actual.header.dagRootCid == expected.dagRootCid &&
        actual.header.factCount == expected.factCount &&
        actual.recordCount == expected.factCount &&
        actual.records.len == expected.factCount

@borrows
fn csgQueryLoadPartition(
        storeRoot: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        manifestIndex: int32,
        loaded: var csgMerkleLoadedQueryPartition[],
        error: var str): int32 =
    error = ""
    let expected = manifest.partitions[manifestIndex]
    var partitionObject =
        merkle_store.CsgCoreMerkleStoreReadObject(
            storeRoot,
            merkle_store.CsgCoreMerkleStorePartitionArtifactKind(),
            expected.factsCid)
    if !partitionObject.ok:
        error = csgQueryCat(
            "merkle_query_partition_read ",
            partitionObject.error)
        return -1
    let partitionBytesRead =
        int64(rawbytes.BytesLen(partitionObject.bytes))
    var partition =
        merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
            partitionObject.bytes)
    rawbytes.BytesFree(partitionObject.bytes)
    if !partition.ok ||
       !csgQueryPartitionMatchesManifest(
           expected, partition):
        if partition.ok:
            rawbytes.BytesFree(partition.bytes)
        error = "merkle_query_partition_mismatch"
        return -1

    var membershipObject =
        merkle_store.CsgCoreMerkleStoreReadObject(
            storeRoot,
            merkle_store.CsgCoreMerkleStoreMembershipArtifactKind(),
            expected.membershipCid)
    if !membershipObject.ok:
        rawbytes.BytesFree(partition.bytes)
        error = csgQueryCat(
            "merkle_query_membership_read ",
            membershipObject.error)
        return -1
    let membershipBytesRead =
        int64(rawbytes.BytesLen(membershipObject.bytes))
    var membership =
        merkle_artifacts.CsgCoreMerkleMembershipDecode(
            membershipObject.bytes)
    rawbytes.BytesFree(membershipObject.bytes)
    if !membership.ok ||
       !csgQueryMembershipMatchesManifest(
           expected, membership):
        rawbytes.BytesFree(partition.bytes)
        if membership.ok:
            rawbytes.BytesFree(membership.bytes)
        error = "merkle_query_membership_mismatch"
        return -1

    var item: csgMerkleLoadedQueryPartition
    item.manifestIndex = manifestIndex
    item.partition = partition
    item.membership = membership
    item.partitionBytesRead = partitionBytesRead
    item.membershipBytesRead = membershipBytesRead
    add(loaded, item)
    return loaded.len - 1

@borrows
fn csgQueryPartitionFactIndex(
        partition:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult,
        factKey: str,
        error: var str): int32 =
    error = ""
    var low: int32
    var high: int32 = partition.facts.len
    while low < high:
        let middle = low + (high - low) / 2
        var keyError: str
        let middleKey =
            merkle_dag.CsgCoreMerkleFactKey(
                partition.facts[middle],
                keyError)
        if keyError.len > 0:
            error = csgQueryCat(
                "merkle_query_partition_fact_key ",
                keyError)
            return -1
        if csgQueryTextCompare(
               middleKey, factKey) < 0:
            low = middle + 1
        else:
            high = middle
    if low >= partition.facts.len:
        return -1
    var keyError: str
    let foundKey =
        merkle_dag.CsgCoreMerkleFactKey(
            partition.facts[low], keyError)
    if keyError.len > 0:
        error = csgQueryCat(
            "merkle_query_partition_fact_key ",
            keyError)
        return -1
    if foundKey != factKey:
        return -1
    return low

@borrows
fn csgQueryMembershipRecordIndex(
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipResult,
        factKey: str): int32 =
    var low: int32
    var high: int32 = membership.records.len
    while low < high:
        let middle = low + (high - low) / 2
        if csgQueryTextCompare(
               membership.records[middle].factKey,
               factKey) < 0:
            low = middle + 1
        else:
            high = middle
    if low >= membership.records.len ||
       membership.records[low].factKey != factKey:
        return -1
    return low

@borrows
fn csgQueryFactHashCid(
        fact: str,
        error: var str): str =
    let digest =
        merkle_dag.CsgCoreMerkleFactHash(
            fact, error)
    if error.len > 0:
        return ""
    return csgQueryCat(
        "sha256:",
        layout.FixedBytes32Hex(digest))

@borrows
fn csgQueryHashCid(
        hash: layout.FixedBytes32): str =
    return csgQueryCat(
        "sha256:", layout.FixedBytes32Hex(hash))

@borrows
fn csgQueryCloneNode(
        node: merkle_dag.CsgCoreMerkleNodeRecord):
        merkle_dag.CsgCoreMerkleNodeRecord =
    var out: merkle_dag.CsgCoreMerkleNodeRecord
    out.kind = node.kind
    out.count = node.count
    out.splitBit = node.splitBit
    out.hash = node.hash
    out.key = strings.CloneStr(node.key)
    out.keyHash = node.keyHash
    out.factHash = node.factHash
    out.leftCount = node.leftCount
    out.leftHash = node.leftHash
    out.rightCount = node.rightCount
    out.rightHash = node.rightHash
    return out

@borrows
fn csgQueryLoadedNodeIndex(
        loaded: csgMerkleLoadedQueryNode[],
        cid: str): int32 =
    for i in 0..<loaded.len:
        if loaded[i].cid == cid:
            return i
    return -1

@borrows
fn csgQueryReadProofNode(
        storeRoot: str,
        nodeCid: str,
        loaded: var csgMerkleLoadedQueryNode[],
        error: var str): int32 =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           nodeCid):
        error = "merkle_query_proof_node_cid_invalid"
        return -1
    let existing = csgQueryLoadedNodeIndex(loaded, nodeCid)
    if existing >= 0:
        return existing
    var object =
        merkle_store.CsgCoreMerkleStoreReadObject(
            storeRoot,
            merkle_store.CsgCoreMerkleStoreNodeArtifactKind(),
            nodeCid)
    if !object.ok:
        error = csgQueryCat(
            "merkle_query_proof_node_read ", object.error)
        return -1
    let byteCount = int64(rawbytes.BytesLen(object.bytes))
    var decoded =
        merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
            object.bytes)
    rawbytes.BytesFree(object.bytes)
    if !decoded.ok || decoded.nodes.len != 1:
        rawbytes.BytesFree(decoded.bytes)
        error = "merkle_query_proof_node_decode_invalid"
        return -1
    let node = csgQueryCloneNode(decoded.nodes[0])
    rawbytes.BytesFree(decoded.bytes)
    if merkle_dag.CsgCoreMerkleNodeRecordCid(node) != nodeCid:
        error = "merkle_query_proof_node_cid_mismatch"
        return -1
    var item: csgMerkleLoadedQueryNode
    item.cid = strings.CloneStr(nodeCid)
    item.byteCount = byteCount
    item.node = node
    add(loaded, item)
    return loaded.len - 1

@borrows
fn csgQueryKeyBit(
        hash: layout.FixedBytes32,
        bitIndex: int32): int32 =
    if bitIndex < 0 || bitIndex >= 256:
        return -1
    let byteIndex = bitIndex / 8
    let bitInByte = 7 - (bitIndex % 8)
    return (int32(hash.data[byteIndex]) >> bitInByte) & 1

@borrows
fn csgQueryProofFromStore(
        storeRoot: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        factKey: str,
        loaded: var csgMerkleLoadedQueryNode[],
        error: var str): merkle_dag.CsgCoreMerkleProof =
    var proof: merkle_dag.CsgCoreMerkleProof
    error = ""
    if factKey.len == 0:
        error = "merkle_query_proof_fact_key_empty"
        return proof
    var bindingError: str
    let subgraphCid =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            manifest.factCount,
            manifest.dagRootCid,
            bindingError)
    if bindingError.len > 0:
        error = csgQueryCat(
            "merkle_query_proof_subgraph ", bindingError)
        return proof
    let profiles =
        validator.CsgCoreProfilesClone(
            manifest.profiles)
    let expectedFactsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            manifest.standard,
            profiles,
            CsgMerkleQuerySchemaNamespace,
            manifest.schemaCid,
            subgraphCid,
            bindingError)
    if bindingError.len > 0:
        error = csgQueryCat(
            "merkle_query_proof_binding ", bindingError)
        return proof
    if expectedFactsRoot != manifest.factsRoot:
        error = "merkle_query_proof_root_binding_mismatch"
        return proof
    proof.factCount = manifest.factCount
    proof.standard = strings.CloneStr(manifest.standard)
    proof.profiles = profiles
    proof.schemaNamespace = CsgMerkleQuerySchemaNamespace
    proof.schemaCid = strings.CloneStr(manifest.schemaCid)
    proof.dagRootCid = strings.CloneStr(manifest.dagRootCid)
    proof.subgraphCid = strings.CloneStr(subgraphCid)
    proof.factsRoot = strings.CloneStr(manifest.factsRoot)
    proof.queryKey = strings.CloneStr(factKey)
    if manifest.factCount == 0:
        proof.ok = true
        let verified = merkle_dag.CsgCoreMerkleVerifyProof(
            proof, manifest.factsRoot)
        if !verified.ok:
            error = csgQueryCat(
                "merkle_query_proof_invalid ", verified.error)
            proof.ok = false
        return proof

    let keyHash = merkle_dag.CsgCoreMerkleKeyHash(factKey)
    var currentCid = strings.CloneStr(manifest.dagRootCid)
    var previousSplit: int32 = -1
    var depth: int32
    while depth <= 256:
        depth = depth + 1
        let nodeIndex = csgQueryReadProofNode(
            storeRoot, currentCid, loaded, error)
        if nodeIndex < 0:
            return proof
        let node = loaded[nodeIndex].node
        if node.kind == merkle_dag.CsgCoreMerkleLeafNodeKind():
            proof.terminalPresent = true
            proof.terminalKey = strings.CloneStr(node.key)
            proof.terminalFactHash = node.factHash
            proof.exists = node.key == factKey
            proof.ok = true
            let verified = merkle_dag.CsgCoreMerkleVerifyProof(
                proof, manifest.factsRoot)
            if !verified.ok:
                error = csgQueryCat(
                    "merkle_query_proof_invalid ", verified.error)
                proof.ok = false
            return proof
        if node.kind !=
               merkle_dag.CsgCoreMerkleBranchNodeKind() ||
           node.splitBit <= previousSplit:
            error = "merkle_query_proof_path_order_invalid"
            return proof
        previousSplit = node.splitBit
        let direction = csgQueryKeyBit(keyHash, node.splitBit)
        if direction < 0:
            error = "merkle_query_proof_split_invalid"
            return proof
        add(proof.splitBits, node.splitBit)
        add(proof.directions, direction)
        if direction == 0:
            add(proof.siblingCounts, node.rightCount)
            add(proof.siblingHashes, node.rightHash)
            currentCid = csgQueryHashCid(node.leftHash)
        else:
            add(proof.siblingCounts, node.leftCount)
            add(proof.siblingHashes, node.leftHash)
            currentCid = csgQueryHashCid(node.rightHash)
    error = "merkle_query_proof_path_depth_invalid"
    return proof

@borrows
fn csgQueryRecordMatchesFact(
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        fact: str): bool =
    if record.indexKind == "fact_key":
        return record.term == record.factKey
    if record.indexKind == "kind":
        let kind = field.CsgCoreJsonKind(fact)
        return kind.found && kind.value == record.term
    let value =
        field.CsgCoreJsonTopStringField(
            fact, record.indexKind)
    return value.found && value.value == record.term

@borrows
fn csgQueryHit(
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        expected:
            merkle_manifest.CsgCoreMerklePartitionRecord,
        fact: str): CsgCoreMerkleQueryHit =
    var out: CsgCoreMerkleQueryHit
    out.fact = strings.CloneStr(fact)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.partitionCid =
        strings.CloneStr(expected.factsCid)
    out.membershipCid =
        strings.CloneStr(expected.membershipCid)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid = strings.CloneStr(record.sourceCid)
    return out

@borrows
fn csgQueryHitReport(
        hit: CsgCoreMerkleQueryHit): str =
    var out: str = "{\"fact\":"
    csgQueryAppend(out, hit.fact)
    csgQueryAppend(out, ",\"fact_hash\":")
    csgQueryAppend(out, csgQueryJson(hit.factHash))
    csgQueryAppend(out, ",\"fact_key\":")
    csgQueryAppend(out, csgQueryJson(hit.factKey))
    csgQueryAppend(out, ",\"leaf_cid\":")
    csgQueryAppend(out, csgQueryJson(hit.leafCid))
    csgQueryAppend(out, ",\"membership_cid\":")
    csgQueryAppend(out, csgQueryJson(hit.membershipCid))
    csgQueryAppend(out, ",\"partition_cid\":")
    csgQueryAppend(out, csgQueryJson(hit.partitionCid))
    csgQueryAppend(out, ",\"partition_id\":")
    csgQueryAppend(out, csgQueryJson(hit.partitionId))
    csgQueryAppend(out, ",\"source_cid\":")
    csgQueryAppend(out, csgQueryJson(hit.sourceCid))
    csgQueryAppend(out, ",\"source_id\":")
    csgQueryAppend(out, csgQueryJson(hit.sourceId))
    csgQueryAppend(out, "}")
    return out

fn csgQueryBoolText(value: bool): str =
    if value:
        return "true"
    return "false"

fn csgQueryAccumulateByteCount(
        total: var int64,
        value: int64): bool =
    if value < 0 || total > 9223372036854775807 - value:
        return false
    total = total + value
    return true

@borrows
fn csgQueryReportHeaderValue(
        head:
            merkle_store.CsgCoreMerkleManifestOnlyHeadReadResult,
        out: CsgCoreMerkleQueryResult,
        pathStepCount: int32): csgMerkleQueryReportHeader =
    var header: csgMerkleQueryReportHeader
    header.generation = head.head.generation
    header.generationRecordsRead = out.generationRecordsRead
    header.headCid = strings.CloneStr(out.headCid)
    header.manifestCid = strings.CloneStr(out.manifestCid)
    header.csgcByteCount = out.csgcByteCount
    header.csgcDirectoryCid =
        strings.CloneStr(out.csgcDirectoryCid)
    header.csgcObjectCid = strings.CloneStr(out.csgcObjectCid)
    header.factsRoot = strings.CloneStr(out.factsRoot)
    header.dagRootCid = strings.CloneStr(out.dagRootCid)
    header.subgraphCid = strings.CloneStr(out.subgraphCid)
    header.factCount = out.factCount
    header.standard = strings.CloneStr(head.manifest.standard)
    header.profiles =
        validator.CsgCoreProfilesClone(
            head.manifest.profiles)
    header.profileSetCid =
        strings.CloneStr(
            head.manifest.profileSetCid)
    header.schemaCid = strings.CloneStr(head.manifest.schemaCid)
    header.indexKind = strings.CloneStr(out.indexKind)
    header.term = strings.CloneStr(out.term)
    header.hitCount = out.hits.len
    header.pathStepCount = pathStepCount
    header.objectsRead = out.objectsRead
    header.manifestObjectsRead = out.manifestObjectsRead
    header.queryBucket = strings.CloneStr(out.queryBucket)
    header.queryShardObjectsRead = out.queryShardObjectsRead
    header.queryShardRoot = strings.CloneStr(out.queryShardRoot)
    header.queryShardCid = strings.CloneStr(out.queryShardCid)
    header.queryShardContentRoot =
        strings.CloneStr(out.queryShardContentRoot)
    header.queryShardEntryCount = out.queryShardEntryCount
    header.queryKeyRoot = strings.CloneStr(out.queryKeyRoot)
    header.resultRoot = strings.CloneStr(out.resultRoot)
    header.partitionObjectsRead = out.partitionObjectsRead
    header.membershipObjectsRead = out.membershipObjectsRead
    header.proofNodeObjectsRead = out.proofNodeObjectsRead
    header.contentObjectBytesRead = out.contentObjectBytesRead
    header.manifestBytesRead = out.manifestBytesRead
    header.queryShardBytesRead = out.queryShardBytesRead
    header.partitionBytesRead = out.partitionBytesRead
    header.membershipBytesRead = out.membershipBytesRead
    header.proofNodeBytesRead = out.proofNodeBytesRead
    return header

