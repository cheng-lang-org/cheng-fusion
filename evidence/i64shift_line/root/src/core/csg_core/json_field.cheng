import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout

type
    CsgCoreJsonFieldResult =
        found: bool
        value: str

fn csgJsonFieldNotFound(): CsgCoreJsonFieldResult =
    var result: CsgCoreJsonFieldResult
    return result

fn csgJsonFieldFound(value: str): CsgCoreJsonFieldResult =
    var result: CsgCoreJsonFieldResult
    result.found = true
    result.value = value
    return result

@borrows
fn csgJsonFieldFoundOwnedRange(text: str,
                               start: int32,
                               count: int32): CsgCoreJsonFieldResult =
    if start < 0 || count <= 0 || start > text.len - count:
        return csgJsonFieldNotFound()
    let view = strings.SliceBytes(text, start, count)
    let owned = strings.stringsNewStringCopy(view.data, view.len)
    return csgJsonFieldFound(owned)

fn csgJsonFieldIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn csgJsonFieldSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && csgJsonFieldIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn csgJsonFieldSkipString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

@borrows
fn csgJsonFieldNameMatches(text: str, quotePos: int32, afterQuote: int32, name: str): bool =
    let size = afterQuote - quotePos - 2
    if size != name.len:
        return false
    var i: int32
    for i in i..<size:
        if text[quotePos + 1 + i] != name[i]:
            return false
    return true

@borrows
fn csgJsonFieldSkipValue(text: str, start: int32): int32 =
    var i: int32 = csgJsonFieldSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = csgJsonFieldSkipString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}':
            i = i + 1
        return i

    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = csgJsonFieldSkipString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn csgJsonFieldUnquoteHexDigit(ch: char, out: var int32): bool =
    if ch >= '0' && ch <= '9':
        out = int32(ch) - int32('0')
        return true
    if ch >= 'a' && ch <= 'f':
        out = int32(ch) - int32('a') + 10
        return true
    return false

fn csgJsonFieldDecodeString(text: str, quotePos: int32, afterQuote: int32): CsgCoreJsonFieldResult =
    if quotePos < 0 || afterQuote > text.len ||
       afterQuote - quotePos < 2:
        return csgJsonFieldNotFound()
    if text[quotePos] != '"' || text[afterQuote - 1] != '"':
        return csgJsonFieldNotFound()
    let closeQuote = afterQuote - 1
    var buf = layout.ByteBufInit(afterQuote - quotePos)
    var ok = true
    var i: int32 = quotePos + 1
    while ok && i < closeQuote:
        let ch = text[i]
        let value = int32(ch) & 255
        if ch == '"':
            ok = false
        elif ch == '\\':
            if i + 1 >= closeQuote:
                ok = false
            else:
                let esc = text[i + 1]
                var decoded: int32 = -1
                var advance: int32 = 2
                if esc == '"' || esc == '\\' || esc == '/':
                    decoded = int32(esc) & 255
                elif esc == 'b':
                    decoded = 8
                elif esc == 't':
                    decoded = 9
                elif esc == 'n':
                    decoded = 10
                elif esc == 'f':
                    decoded = 12
                elif esc == 'r':
                    decoded = 13
                elif esc == 'u':
                    if i + 6 <= closeQuote &&
                       text[i + 2] == '0' &&
                       text[i + 3] == '0':
                        var hi: int32
                        var lo: int32
                        if csgJsonFieldUnquoteHexDigit(
                               text[i + 4], hi) &&
                           csgJsonFieldUnquoteHexDigit(
                               text[i + 5], lo):
                            let code = hi * 16 + lo
                            if code < 32 && code != 8 &&
                               code != 9 && code != 10 &&
                               code != 12 && code != 13:
                                decoded = code
                                advance = 6
                if decoded < 0:
                    ok = false
                else:
                    layout.ByteBufAppendByte(buf, decoded)
                    i = i + advance
        elif value < 32:
            ok = false
        else:
            layout.ByteBufAppendByte(buf, value)
            i = i + 1
    if !ok:
        layout.ByteBufFree(buf)
        return csgJsonFieldNotFound()
    var bytes = layout.ByteBufToBytes(buf)
    let decodedText = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return csgJsonFieldFound(decodedText)

@borrows
fn CsgCoreJsonTopStringField(line: str, name: str): CsgCoreJsonFieldResult =
    var i: int32 = csgJsonFieldSkipWs(line, 0)
    if i >= line.len || line[i] != '{':
        return csgJsonFieldNotFound()
    i = i + 1
    while i < line.len:
        i = csgJsonFieldSkipWs(line, i)
        if i >= line.len || line[i] == '}':
            return csgJsonFieldNotFound()
        if line[i] == ',':
            i = i + 1
            continue
        if line[i] != '"':
            return csgJsonFieldNotFound()

        let keyEnd = csgJsonFieldSkipString(line, i)
        if keyEnd < 0:
            return csgJsonFieldNotFound()
        let matched = csgJsonFieldNameMatches(line, i, keyEnd, name)
        var valueStart: int32 = csgJsonFieldSkipWs(line, keyEnd)
        if valueStart >= line.len || line[valueStart] != ':':
            return csgJsonFieldNotFound()
        valueStart = csgJsonFieldSkipWs(line, valueStart + 1)
        if matched:
            if valueStart >= line.len || line[valueStart] != '"':
                return csgJsonFieldNotFound()
            let valueEnd = csgJsonFieldSkipString(line, valueStart)
            if valueEnd < 0:
                return csgJsonFieldNotFound()
            let ownedLine = strings.CloneStr(line)
            return csgJsonFieldDecodeString(
                ownedLine, valueStart, valueEnd)
        i = csgJsonFieldSkipValue(line, valueStart)
    return csgJsonFieldNotFound()

@borrows
fn CsgCoreJsonTopRawField(line: str, name: str): CsgCoreJsonFieldResult =
    var i: int32 = csgJsonFieldSkipWs(line, 0)
    if i >= line.len || line[i] != '{':
        return csgJsonFieldNotFound()
    i = i + 1
    while i < line.len:
        i = csgJsonFieldSkipWs(line, i)
        if i >= line.len || line[i] == '}':
            return csgJsonFieldNotFound()
        if line[i] == ',':
            i = i + 1
            continue
        if line[i] != '"':
            return csgJsonFieldNotFound()

        let keyEnd = csgJsonFieldSkipString(line, i)
        if keyEnd < 0:
            return csgJsonFieldNotFound()
        let matched = csgJsonFieldNameMatches(line, i, keyEnd, name)
        var valueStart: int32 = csgJsonFieldSkipWs(line, keyEnd)
        if valueStart >= line.len || line[valueStart] != ':':
            return csgJsonFieldNotFound()
        valueStart = csgJsonFieldSkipWs(line, valueStart + 1)
        let valueEnd = csgJsonFieldSkipValue(line, valueStart)
        if matched:
            if valueEnd <= valueStart:
                return csgJsonFieldNotFound()
            return csgJsonFieldFoundOwnedRange(
                line, valueStart, valueEnd - valueStart)
        i = valueEnd
    return csgJsonFieldNotFound()

@borrows
fn CsgCoreJsonKind(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "kind")

@borrows
fn CsgCoreJsonId(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "id")

@borrows
fn CsgCoreJsonSchema(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "schema")

@borrows
fn CsgCoreJsonPath(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "path")

@borrows
fn CsgCoreJsonName(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "name")

@borrows
fn CsgCoreJsonCode(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "code")

@borrows
fn CsgCoreJsonMessage(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "message")

@borrows
fn CsgCoreJsonReason(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "reason")

@borrows
fn CsgCoreJsonOriginalTextHash(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "original_text_hash")

@borrows
fn CsgCoreJsonImpactScope(line: str): CsgCoreJsonFieldResult =
    return CsgCoreJsonTopStringField(line, "impact_scope")
