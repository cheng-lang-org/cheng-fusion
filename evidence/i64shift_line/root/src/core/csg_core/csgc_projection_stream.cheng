import std/rawbytes
import std/result
import std/seqs
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/identity
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_identity
import cheng/core/ir/phase_arena as phase

const
    csgProjectionStreamFactLimit: int32 = 262144
    csgProjectionStreamLineByteLimit: int32 = 268435456
    csgProjectionStreamSingleLineByteLimit: int32 = 67108864
    csgProjectionStreamKeyByteLimit: int32 = 67108864
    csgProjectionStreamKindByteLimit: int32 = 16777216
    csgProjectionStreamCandidateLimit: int32 = 1048576
    csgProjectionStreamCandidateSlotCount: int32 = 2097152
    csgProjectionStreamKindLimit: int32 = 65536
    csgProjectionStreamKindSlotCount: int32 = 131072
    csgProjectionStreamTokenOccurrenceLimit: int32 = 16777216
    csgProjectionStreamEncodedByteLimit: int32 = 268435456
    csgProjectionStreamArenaAllocationCount: int32 = 40
    csgProjectionStreamArenaPayloadSlackBytes: int32 = 4096
    csgProjectionStreamModuleRetainedCeilingBytes: int64 = 1006632960
    csgProjectionStreamMerkleDepthLimit: int32 = 256
    csgProjectionStreamProofCommitmentDomain: str =
        "csg_core.csgc_projection_stream.proof_commitment.v1"

type
    CsgCoreCsgcProjectionStreamExpectedAfterSemantic =
        binding: merkle_dag.CsgCoreMerkleReplayBinding
        afterFactsRoot: str
        afterDagRootCid: str
        afterSubgraphCid: str
        afterProofCommitment: str
        proofSplitBits: int32[]
        proofDirections: int32[]
        proofSiblingCounts: int32[]
        proofSiblingHashes: layout.FixedBytes32[]

    CsgCoreCsgcProjectionStreamExpectedAfterResult =
        ok: bool
        error: str
        expected: CsgCoreCsgcProjectionStreamExpectedAfterSemantic

    CsgCoreCsgcProjectionStreamResult =
        ok: bool
        error: str
        factCount: int32
        byteCount: int32
        directoryCid: str
        objectCid: str
        bytes: rawbytes.Bytes
        completion:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority

    csgProjectionStreamReplacement =
        beforeDigest: layout.FixedBytes32
        afterDigest: layout.FixedBytes32
        keyHash: layout.FixedBytes32

    csgProjectionStreamLookup =
        ok: bool
        foundIndex: int32
        slot: int32

    csgProjectionStreamTokenCursor =
        scanCursor: int32
        tokenStart: int32
        pendingStart: int32
        pendingLength: int32
        done: bool

    csgProjectionStreamToken =
        ok: bool
        done: bool
        start: int32
        length: int32

    csgProjectionStreamPlan =
        dictionaryCount: int32
        dictionaryPayloadLength: int32
        directoryLength: int32
        bodyLength: int32
        totalLength: int32

    csgProjectionStreamMerkleNode =
        ok: bool
        error: str
        count: int32
        hash: layout.FixedBytes32

    csgProjectionStreamRootPlan =
        dagRootCid: str
        subgraphCid: str
        replacementProofCommitment: str

    csgProjectionStreamState = object
        store: phase.PhaseArenaStore
        arena: phase.PhaseArenaHandle
        factCount: int32
        lineByteCount: int32
        keyByteCount: int32
        kindByteCount: int32
        candidateCount: int32
        kindCount: int32
        candidateSlotCount: int32
        kindSlotCount: int32
        replacementSourceOrdinal: int32
        replacementCanonicalOrdinal: int32

        lineBytes: phase.PhaseArenaRef
        keyBytes: phase.PhaseArenaRef
        kindBytes: phase.PhaseArenaRef

        lineOffsets: phase.PhaseArenaRef
        lineLengths: phase.PhaseArenaRef
        keyOffsets: phase.PhaseArenaRef
        keyLengths: phase.PhaseArenaRef
        rowKinds: phase.PhaseArenaRef
        rowEncodedLengths: phase.PhaseArenaRef
        replacementFlags: phase.PhaseArenaRef
        physicalOrder: phase.PhaseArenaRef
        physicalScratch: phase.PhaseArenaRef
        sectionRows: phase.PhaseArenaRef
        keyHashes: phase.PhaseArenaRef
        factDigests: phase.PhaseArenaRef

        candidateOffsets: phase.PhaseArenaRef
        candidateLengths: phase.PhaseArenaRef
        candidateCounts: phase.PhaseArenaRef
        candidateDictIndexes: phase.PhaseArenaRef
        candidateOrder: phase.PhaseArenaRef
        candidateScratch: phase.PhaseArenaRef
        candidateSlots: phase.PhaseArenaRef

        kindOffsets: phase.PhaseArenaRef
        kindLengths: phase.PhaseArenaRef
        kindCounts: phase.PhaseArenaRef
        kindRanks: phase.PhaseArenaRef
        kindOrder: phase.PhaseArenaRef
        kindScratch: phase.PhaseArenaRef
        kindStarts: phase.PhaseArenaRef
        kindCursors: phase.PhaseArenaRef
        kindPayloadLengths: phase.PhaseArenaRef
        kindPayloadOffsets: phase.PhaseArenaRef
        kindSlots: phase.PhaseArenaRef

        proofSplitBits: phase.PhaseArenaRef
        proofDirections: phase.PhaseArenaRef
        proofSiblingCounts: phase.PhaseArenaRef
        proofSiblingHashes: phase.PhaseArenaRef
        proofDepth: int32

    # Single-pass mapped feed staging. The mapped authority allows exactly one
    # sequential traversal, so the feed lands in owned sequences first; the
    # arena is then opened with measured byte budgets and loaded once.
    csgProjectionStreamFeedBuffer =
        lines: str[]
        keys: str[]
        lineOffsets: int32[]
        lineLengths: int32[]
        keyOffsets: int32[]
        keyLengths: int32[]
        replacementFlags: int32[]
        keyHashes: layout.FixedBytes32[]
        factDigests: layout.FixedBytes32[]
        lineByteCount: int32
        keyByteCount: int32
        replacementSourceOrdinal: int32

@borrows
fn csgProjectionStreamFail(error: str): CsgCoreCsgcProjectionStreamResult =
    var out: CsgCoreCsgcProjectionStreamResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgProjectionStreamCat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

fn csgProjectionStreamCheckedAdd(
        left: int32,
        right: int32,
        out: var int32): bool =
    if left < 0 || right < 0 || left > 2147483647 - right:
        return false
    out = left + right
    return true

fn csgProjectionStreamVarintLength(value: int32): int32 =
    if value < 0:
        return -1
    var current = value
    var length: int32 = 1
    while current >= 128:
        length = length + 1
        current = current >> 7
    return length

@borrows
fn csgProjectionStreamHashText(value: str): uint64 =
    var hashValue =
        (uint64(1469598103) * uint64(1000000000)) +
        uint64(934665603)
    for index in 0..<value.len:
        hashValue = hashValue ^
            (uint64(int32(value[index])) & uint64(255))
        hashValue = hashValue *
            ((uint64(1099511628) * uint64(1000)) + uint64(211))
    return hashValue

@borrows
fn csgProjectionStreamHashTextRange(
        value: str,
        start: int32,
        length: int32): uint64 =
    if start < 0 || length <= 0 || start > value.len - length:
        return uint64(0)
    var hashValue =
        (uint64(1469598103) * uint64(1000000000)) +
        uint64(934665603)
    for index in 0..<length:
        hashValue = hashValue ^
            (uint64(int32(value[start + index])) & uint64(255))
        hashValue = hashValue *
            ((uint64(1099511628) * uint64(1000)) + uint64(211))
    return hashValue

@borrows
fn csgProjectionStreamI32Get(
        state: var csgProjectionStreamState,
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        state.store, state.arena, column, row)

@borrows
fn csgProjectionStreamI32Set(
        state: var csgProjectionStreamState,
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        state.store, state.arena, column, row, value)

@borrows
fn csgProjectionStreamFixed32Set(
        state: var csgProjectionStreamState,
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    let base = row * 32
    for index in 0..<32:
        phase.PhaseArenaStoreSetByte(
            state.store,
            state.arena,
            column,
            base + index,
            int32(value.data[index]) & 255)

@borrows
fn csgProjectionStreamFixed32Matches(
        state: var csgProjectionStreamState,
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32): bool =
    let base = row * 32
    for index in 0..<32:
        if phase.PhaseArenaStoreGetByte(
               state.store,
               state.arena,
               column,
               base + index) !=
           (int32(value.data[index]) & 255):
            return false
    return true

@borrows
fn csgProjectionStreamFixed32Get(
        state: var csgProjectionStreamState,
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    let base = row * 32
    for index in 0..<32:
        out.data[index] = UInt8(
            phase.PhaseArenaStoreGetByte(
                state.store,
                state.arena,
                column,
                base + index) & 255)
    return out

@borrows
fn csgProjectionStreamFixed32CompareRows(
        state: var csgProjectionStreamState,
        column: phase.PhaseArenaRef,
        leftRow: int32,
        rightRow: int32): int32 =
    let leftBase = leftRow * 32
    let rightBase = rightRow * 32
    for index in 0..<32:
        let left = phase.PhaseArenaStoreGetByte(
            state.store, state.arena, column, leftBase + index)
        let right = phase.PhaseArenaStoreGetByte(
            state.store, state.arena, column, rightBase + index)
        if left < right:
            return -1
        if left > right:
            return 1
    return 0

@borrows
fn csgProjectionStreamTextMatches(
        state: var csgProjectionStreamState,
        region: phase.PhaseArenaRef,
        offset: int32,
        length: int32,
        value: str): bool =
    if length != value.len:
        return false
    for index in 0..<length:
        if phase.PhaseArenaStoreGetByte(
               state.store,
               state.arena,
               region,
               offset + index) !=
           (int32(value[index]) & 255):
            return false
    return true

@borrows
fn csgProjectionStreamTextRangeMatches(
        state: var csgProjectionStreamState,
        region: phase.PhaseArenaRef,
        offset: int32,
        length: int32,
        value: str,
        valueStart: int32): bool =
    if length <= 0 || valueStart < 0 ||
       valueStart > value.len - length:
        return false
    for index in 0..<length:
        if phase.PhaseArenaStoreGetByte(
               state.store,
               state.arena,
               region,
               offset + index) !=
           (int32(value[valueStart + index]) & 255):
            return false
    return true

@borrows
fn csgProjectionStreamTokenNext(
        line: str,
        cursor: var csgProjectionStreamTokenCursor):
        csgProjectionStreamToken =
    var out: csgProjectionStreamToken
    if cursor.done:
        out.ok = true
        out.done = true
        return out
    if cursor.pendingLength > 0:
        out.ok = true
        out.start = cursor.pendingStart
        out.length = cursor.pendingLength
        cursor.pendingStart = 0
        cursor.pendingLength = 0
        return out
    while cursor.scanCursor < line.len:
        if line[cursor.scanCursor] != '"':
            cursor.scanCursor = cursor.scanCursor + 1
            continue
        let stringStart = cursor.scanCursor
        cursor.scanCursor = cursor.scanCursor + 1
        var escaped = false
        var closed = false
        while cursor.scanCursor < line.len && !closed:
            if escaped:
                escaped = false
                cursor.scanCursor = cursor.scanCursor + 1
            elif line[cursor.scanCursor] == '\\':
                escaped = true
                cursor.scanCursor = cursor.scanCursor + 1
            elif line[cursor.scanCursor] == '"':
                cursor.scanCursor = cursor.scanCursor + 1
                closed = true
            else:
                cursor.scanCursor = cursor.scanCursor + 1
        if !closed:
            return out
        let stringLength = cursor.scanCursor - stringStart
        if stringStart > cursor.tokenStart:
            out.ok = true
            out.start = cursor.tokenStart
            out.length = stringStart - cursor.tokenStart
            cursor.pendingStart = stringStart
            cursor.pendingLength = stringLength
            cursor.tokenStart = cursor.scanCursor
            return out
        out.ok = true
        out.start = stringStart
        out.length = stringLength
        cursor.tokenStart = cursor.scanCursor
        return out
    if cursor.tokenStart < line.len:
        out.ok = true
        out.start = cursor.tokenStart
        out.length = line.len - cursor.tokenStart
        cursor.tokenStart = line.len
        cursor.done = true
        return out
    cursor.done = true
    out.ok = true
    out.done = true
    return out

@borrows
fn csgProjectionStreamRegionCompare(
        state: var csgProjectionStreamState,
        region: phase.PhaseArenaRef,
        leftOffset: int32,
        leftLength: int32,
        rightOffset: int32,
        rightLength: int32): int32 =
    var common = leftLength
    if rightLength < common:
        common = rightLength
    for index in 0..<common:
        let left = phase.PhaseArenaStoreGetByte(
            state.store, state.arena, region, leftOffset + index)
        let right = phase.PhaseArenaStoreGetByte(
            state.store, state.arena, region, rightOffset + index)
        if left < right:
            return -1
        if left > right:
            return 1
    if leftLength < rightLength:
        return -1
    if leftLength > rightLength:
        return 1
    return 0

@borrows
fn csgProjectionStreamRegionText(
        state: var csgProjectionStreamState,
        region: phase.PhaseArenaRef,
        offset: int32,
        length: int32): str =
    var bytes = phase.PhaseArenaStoreCopyBytesOut(
        state.store, state.arena, region, offset, length)
    let text = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return text

@borrows
fn csgProjectionStreamCopyTextInto(
        state: var csgProjectionStreamState,
        region: phase.PhaseArenaRef,
        offset: int32,
        value: str) =
    let bytes = rawbytes.BytesFromString(value)
    phase.PhaseArenaStoreCopyBytesInto(
        state.store,
        state.arena,
        region,
        offset,
        bytes,
        0,
        value.len)

fn csgProjectionStreamPow2Ceil(value: int32): int32 =
    var out: int32 = 1
    while out < value:
        out = out * 2
    return out

fn csgProjectionStreamClampBudget(
        value: int32,
        floor: int32,
        ceiling: int32): int32 =
    var out = value
    if out < floor:
        out = floor
    if out > ceiling:
        out = ceiling
    return out

@borrows
fn csgProjectionStreamInit(
        state: var csgProjectionStreamState,
        factCount: int32,
        lineByteCount: int32,
        keyByteCount: int32) =
    # Byte regions are sized to the measured after-image; kind/candidate
    # structures use provable upper bounds (distinct kinds <= factCount,
    # distinct kind bytes and dictionary candidates <= line bytes, because
    # each interned token is at least one line byte and each distinct kind
    # has a distinct witness line). The hard limits stay the validation
    # contract, so exhaustion errors fire under identical conditions.
    let lineByteBudget = csgProjectionStreamClampBudget(
        lineByteCount, 1, csgProjectionStreamLineByteLimit)
    let keyByteBudget = csgProjectionStreamClampBudget(
        keyByteCount, 1, csgProjectionStreamKeyByteLimit)
    let kindByteBudget = csgProjectionStreamClampBudget(
        lineByteCount, 1, csgProjectionStreamKindByteLimit)
    let kindCountBudget = csgProjectionStreamClampBudget(
        factCount, 1, csgProjectionStreamKindLimit)
    let kindSlotBudget = csgProjectionStreamPow2Ceil(kindCountBudget * 2)
    let candidateBudget = csgProjectionStreamClampBudget(
        lineByteCount, 1, csgProjectionStreamCandidateLimit)
    let candidateSlotBudget =
        csgProjectionStreamPow2Ceil(candidateBudget * 2)
    let payloadBytes =
        lineByteBudget + keyByteBudget + kindByteBudget +
        factCount * 104 +
        candidateBudget * 24 + candidateSlotBudget * 4 +
        kindCountBudget * 40 + kindSlotBudget * 4 +
        csgProjectionStreamMerkleDepthLimit * 44 +
        csgProjectionStreamArenaPayloadSlackBytes
    phase.PhaseArenaStoreInit(
        state.store,
        1,
        payloadBytes,
        csgProjectionStreamArenaAllocationCount)
    state.arena = phase.PhaseArenaStoreOpenArena(
        state.store,
        1,
        payloadBytes,
        csgProjectionStreamArenaAllocationCount)
    state.factCount = factCount
    state.candidateSlotCount = candidateSlotBudget
    state.kindSlotCount = kindSlotBudget
    state.replacementSourceOrdinal = -1
    state.replacementCanonicalOrdinal = -1

    state.lineBytes = phase.PhaseArenaStoreAllocRefAligned(
        state.store, state.arena, lineByteBudget, 8)
    state.keyBytes = phase.PhaseArenaStoreAllocRefAligned(
        state.store, state.arena, keyByteBudget, 8)
    state.kindBytes = phase.PhaseArenaStoreAllocRefAligned(
        state.store, state.arena, kindByteBudget, 8)

    state.lineOffsets = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.lineLengths = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.keyOffsets = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.keyLengths = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.rowKinds = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.rowEncodedLengths = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.replacementFlags = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.physicalOrder = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.physicalScratch = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.sectionRows = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, factCount)
    state.keyHashes = phase.PhaseArenaStoreAllocRefAligned(
        state.store, state.arena, factCount * 32, 8)
    state.factDigests = phase.PhaseArenaStoreAllocRefAligned(
        state.store, state.arena, factCount * 32, 8)

    state.candidateOffsets = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateBudget)
    state.candidateLengths = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateBudget)
    state.candidateCounts = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateBudget)
    state.candidateDictIndexes = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateBudget)
    state.candidateOrder = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateBudget)
    state.candidateScratch = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateBudget)
    state.candidateSlots = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, candidateSlotBudget)

    state.kindOffsets = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindLengths = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindCounts = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindRanks = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindOrder = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindScratch = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindStarts = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindCursors = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindPayloadLengths = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindPayloadOffsets = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindCountBudget)
    state.kindSlots = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, kindSlotBudget)
    state.proofSplitBits = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, csgProjectionStreamMerkleDepthLimit)
    state.proofDirections = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, csgProjectionStreamMerkleDepthLimit)
    state.proofSiblingCounts = phase.PhaseArenaStoreReserveI32Column(
        state.store, state.arena, csgProjectionStreamMerkleDepthLimit)
    state.proofSiblingHashes = phase.PhaseArenaStoreAllocRefAligned(
        state.store,
        state.arena,
        csgProjectionStreamMerkleDepthLimit * 32,
        8)

fn csgProjectionStreamDestroy(state: var csgProjectionStreamState) =
    phase.PhaseArenaStoreCloseArena(state.store, state.arena)
    let receipt = phase.PhaseArenaStoreDestroyWithReceipt(state.store)
    if !receipt.storageReleased ||
       receipt.releasedBufferCount <= 0 ||
       receipt.releasedBytes <= int64(0):
        panic("csgc_projection_stream_arena_release_incomplete")

@borrows
fn csgProjectionStreamValidateReplacement(
        factCount: int32,
        expectedCanonicalOrdinal: int32,
        queryKey: str,
        beforeFact: str,
        afterFact: str,
        replacement: var csgProjectionStreamReplacement): str =
    if factCount <= 0 || factCount > csgProjectionStreamFactLimit:
        return "csgc_projection_stream_fact_count_out_of_range"
    if expectedCanonicalOrdinal < 0 ||
       expectedCanonicalOrdinal >= factCount:
        return "csgc_projection_stream_replacement_ordinal_out_of_range"
    if queryKey.len == 0 ||
       queryKey.len > csgProjectionStreamKeyByteLimit:
        return "csgc_projection_stream_query_key_out_of_range"
    if beforeFact.len == 0 || afterFact.len == 0 ||
       beforeFact.len > csgProjectionStreamSingleLineByteLimit ||
       afterFact.len > csgProjectionStreamSingleLineByteLimit:
        return "csgc_projection_stream_replacement_fact_out_of_range"
    if beforeFact == afterFact:
        return "csgc_projection_stream_replacement_not_changed"
    var error: str
    let canonicalBefore =
        merkle_dag.CsgCoreMerkleCanonicalFact(beforeFact, error)
    if error.len > 0 || canonicalBefore != beforeFact:
        return "csgc_projection_stream_before_fact_not_canonical"
    error = ""
    let canonicalAfter =
        merkle_dag.CsgCoreMerkleCanonicalFact(afterFact, error)
    if error.len > 0 || canonicalAfter != afterFact:
        return "csgc_projection_stream_after_fact_not_canonical"
    error = ""
    let beforeKey = merkle_dag.CsgCoreMerkleFactKey(beforeFact, error)
    if error.len > 0 || beforeKey != queryKey:
        return "csgc_projection_stream_before_key_mismatch"
    error = ""
    let afterKey = merkle_dag.CsgCoreMerkleFactKey(afterFact, error)
    if error.len > 0 || afterKey != queryKey:
        return "csgc_projection_stream_after_key_mismatch"
    error = ""
    replacement.beforeDigest =
        merkle_dag.CsgCoreMerkleFactHash(beforeFact, error)
    if error.len > 0 || layout.FixedBytes32Equal(
           replacement.beforeDigest, layout.FixedBytes32()):
        return "csgc_projection_stream_before_digest_invalid"
    error = ""
    replacement.afterDigest =
        merkle_dag.CsgCoreMerkleFactHash(afterFact, error)
    if error.len > 0 || layout.FixedBytes32Equal(
           replacement.afterDigest, layout.FixedBytes32()):
        return "csgc_projection_stream_after_digest_invalid"
    replacement.keyHash = merkle_dag.CsgCoreMerkleKeyHash(queryKey)
    if layout.FixedBytes32Equal(
           replacement.keyHash, layout.FixedBytes32()):
        return "csgc_projection_stream_key_hash_invalid"
    return ""

@borrows
fn csgProjectionStreamCandidateLookupRange(
        state: var csgProjectionStreamState,
        value: str,
        valueStart: int32,
        valueLength: int32): csgProjectionStreamLookup =
    var out: csgProjectionStreamLookup
    out.foundIndex = -1
    out.slot = -1
    if valueStart < 0 || valueLength < 2 ||
       valueStart > value.len - valueLength:
        return out
    var slot = int32(
        csgProjectionStreamHashTextRange(
            value, valueStart, valueLength) &
        uint64(state.candidateSlotCount - 1))
    for scanned in 0..<state.candidateSlotCount:
        let entry = csgProjectionStreamI32Get(
            state, state.candidateSlots, slot)
        if entry == 0:
            out.ok = true
            out.slot = slot
            return out
        let index = entry - 1
        if index < 0 || index >= state.candidateCount:
            return out
        let offset = csgProjectionStreamI32Get(
            state, state.candidateOffsets, index)
        let length = csgProjectionStreamI32Get(
            state, state.candidateLengths, index)
        if length == valueLength &&
           csgProjectionStreamTextRangeMatches(
               state,
               state.lineBytes,
               offset,
               length,
               value,
               valueStart):
            out.ok = true
            out.foundIndex = index
            out.slot = slot
            return out
        slot = (slot + 1) &
            (state.candidateSlotCount - 1)
    return out

@borrows
fn csgProjectionStreamKindLookup(
        state: var csgProjectionStreamState,
        value: str): csgProjectionStreamLookup =
    var out: csgProjectionStreamLookup
    out.foundIndex = -1
    out.slot = -1
    var slot = int32(
        csgProjectionStreamHashText(value) &
        uint64(state.kindSlotCount - 1))
    for scanned in 0..<state.kindSlotCount:
        let entry = csgProjectionStreamI32Get(
            state, state.kindSlots, slot)
        if entry == 0:
            out.ok = true
            out.slot = slot
            return out
        let index = entry - 1
        if index < 0 || index >= state.kindCount:
            return out
        let offset = csgProjectionStreamI32Get(
            state, state.kindOffsets, index)
        let length = csgProjectionStreamI32Get(
            state, state.kindLengths, index)
        if csgProjectionStreamTextMatches(
               state, state.kindBytes, offset, length, value):
            out.ok = true
            out.foundIndex = index
            out.slot = slot
            return out
        slot = (slot + 1) & (state.kindSlotCount - 1)
    return out

@borrows
fn csgProjectionStreamRowCompare(
        state: var csgProjectionStreamState,
        leftRow: int32,
        rightRow: int32): int32 =
    let hashOrder = csgProjectionStreamFixed32CompareRows(
        state, state.keyHashes, leftRow, rightRow)
    if hashOrder != 0:
        return hashOrder
    let leftOffset = csgProjectionStreamI32Get(
        state, state.keyOffsets, leftRow)
    let leftLength = csgProjectionStreamI32Get(
        state, state.keyLengths, leftRow)
    let rightOffset = csgProjectionStreamI32Get(
        state, state.keyOffsets, rightRow)
    let rightLength = csgProjectionStreamI32Get(
        state, state.keyLengths, rightRow)
    return csgProjectionStreamRegionCompare(
        state,
        state.keyBytes,
        leftOffset,
        leftLength,
        rightOffset,
        rightLength)

@borrows
fn csgProjectionStreamCandidateCompare(
        state: var csgProjectionStreamState,
        leftRow: int32,
        rightRow: int32): int32 =
    let leftOffset = csgProjectionStreamI32Get(
        state, state.candidateOffsets, leftRow)
    let leftLength = csgProjectionStreamI32Get(
        state, state.candidateLengths, leftRow)
    let rightOffset = csgProjectionStreamI32Get(
        state, state.candidateOffsets, rightRow)
    let rightLength = csgProjectionStreamI32Get(
        state, state.candidateLengths, rightRow)
    return csgProjectionStreamRegionCompare(
        state,
        state.lineBytes,
        leftOffset,
        leftLength,
        rightOffset,
        rightLength)

@borrows
fn csgProjectionStreamKindCompare(
        state: var csgProjectionStreamState,
        leftRow: int32,
        rightRow: int32): int32 =
    let leftOffset = csgProjectionStreamI32Get(
        state, state.kindOffsets, leftRow)
    let leftLength = csgProjectionStreamI32Get(
        state, state.kindLengths, leftRow)
    let rightOffset = csgProjectionStreamI32Get(
        state, state.kindOffsets, rightRow)
    let rightLength = csgProjectionStreamI32Get(
        state, state.kindLengths, rightRow)
    return csgProjectionStreamRegionCompare(
        state,
        state.kindBytes,
        leftOffset,
        leftLength,
        rightOffset,
        rightLength)

@borrows
fn csgProjectionStreamSortPhysical(
        state: var csgProjectionStreamState): str =
    let physicalOrder = state.physicalOrder
    let physicalScratch = state.physicalScratch
    let keyHashes = state.keyHashes
    let replacementFlags = state.replacementFlags
    for index in 0..<state.factCount:
        csgProjectionStreamI32Set(
            state, physicalOrder, index, index)
    var width: int32 = 1
    while width < state.factCount:
        var start: int32
        while start < state.factCount:
            var middle = start + width
            if middle > state.factCount:
                middle = state.factCount
            var finish = middle + width
            if finish > state.factCount:
                finish = state.factCount
            var left = start
            var right = middle
            for writeAt in start..<finish:
                var takeLeft = left < middle
                if takeLeft && right < finish:
                    let leftRow = csgProjectionStreamI32Get(
                        state, physicalOrder, left)
                    let rightRow = csgProjectionStreamI32Get(
                        state, physicalOrder, right)
                    takeLeft = csgProjectionStreamRowCompare(
                        state, leftRow, rightRow) <= 0
                var taken: int32
                if takeLeft:
                    taken = csgProjectionStreamI32Get(
                        state, physicalOrder, left)
                    left = left + 1
                else:
                    taken = csgProjectionStreamI32Get(
                        state, physicalOrder, right)
                    right = right + 1
                csgProjectionStreamI32Set(
                    state, physicalScratch, writeAt, taken)
            start = finish
        for index in 0..<state.factCount:
            let copied = csgProjectionStreamI32Get(
                state, physicalScratch, index)
            csgProjectionStreamI32Set(
                state, physicalOrder, index, copied)
        if width > state.factCount / 2:
            width = state.factCount
        else:
            width = width * 2
    for index in 0..<state.factCount:
        let row = csgProjectionStreamI32Get(
            state, physicalOrder, index)
        if row < 0 || row >= state.factCount:
            return "csgc_projection_stream_physical_order_corrupt"
        if index > 0:
            let previous = csgProjectionStreamI32Get(
                state, physicalOrder, index - 1)
            if csgProjectionStreamFixed32CompareRows(
                   state, keyHashes, previous, row) == 0:
                if csgProjectionStreamRowCompare(
                       state, previous, row) == 0:
                    return "csgc_projection_stream_duplicate_fact_key"
                return "csgc_projection_stream_key_hash_collision"
        if csgProjectionStreamI32Get(
               state, replacementFlags, row) == 1:
            if state.replacementCanonicalOrdinal >= 0:
                return "csgc_projection_stream_replacement_not_unique"
            state.replacementCanonicalOrdinal = index
    if state.replacementCanonicalOrdinal < 0:
        return "csgc_projection_stream_replacement_missing"
    return ""

@borrows
fn csgProjectionStreamMerkleNodeFail(
        error: str): csgProjectionStreamMerkleNode =
    var out: csgProjectionStreamMerkleNode
    out.error = strings.CloneStr(error)
    return out

fn csgProjectionStreamHashBuffer(
        buffer: var layout.ByteBuf): layout.FixedBytes32 =
    let digest = hash256.Sha256Fixed(layout.ByteBufView(buffer))
    layout.ByteBufFree(buffer)
    return digest

@borrows
fn csgProjectionStreamMerkleHashText(
        domain: str,
        value: str): layout.FixedBytes32 =
    var buffer = layout.ByteBufInit(64 + domain.len + value.len)
    csgProjectionStreamAppendText(buffer, domain)
    csgProjectionStreamAppendText(buffer, value)
    return csgProjectionStreamHashBuffer(buffer)

@borrows
fn csgProjectionStreamMerkleLeafHash(
        keyHash: layout.FixedBytes32,
        factHash: layout.FixedBytes32): layout.FixedBytes32 =
    var buffer = layout.ByteBufInit(96)
    csgProjectionStreamAppendText(buffer, merkle_dag.CsgMerkleLeafDomain)
    layout.ByteBufAppendFixed32(buffer, keyHash)
    layout.ByteBufAppendFixed32(buffer, factHash)
    return csgProjectionStreamHashBuffer(buffer)

@borrows
fn csgProjectionStreamMerkleBranchHash(
        splitBit: int32,
        leftCount: int32,
        leftHash: layout.FixedBytes32,
        rightCount: int32,
        rightHash: layout.FixedBytes32): layout.FixedBytes32 =
    var buffer = layout.ByteBufInit(112)
    csgProjectionStreamAppendText(buffer, merkle_dag.CsgMerkleBranchDomain)
    csgProjectionStreamAppendU32(buffer, splitBit)
    csgProjectionStreamAppendU32(buffer, leftCount)
    layout.ByteBufAppendFixed32(buffer, leftHash)
    csgProjectionStreamAppendU32(buffer, rightCount)
    layout.ByteBufAppendFixed32(buffer, rightHash)
    return csgProjectionStreamHashBuffer(buffer)

@borrows
fn csgProjectionStreamMerkleSubgraphHash(
        factCount: int32,
        dagRoot: layout.FixedBytes32): layout.FixedBytes32 =
    var buffer = layout.ByteBufInit(96)
    csgProjectionStreamAppendText(
        buffer, merkle_dag.CsgMerkleSubgraphDomain)
    csgProjectionStreamAppendU32(buffer, factCount)
    layout.ByteBufAppendFixed32(buffer, dagRoot)
    return csgProjectionStreamHashBuffer(buffer)

@borrows
fn csgProjectionStreamMerkleBit(
        value: layout.FixedBytes32,
        bitIndex: int32): int32 =
    if bitIndex < 0 || bitIndex >= csgProjectionStreamMerkleDepthLimit:
        return -1
    let byteIndex = bitIndex / 8
    let bitInByte = 7 - (bitIndex % 8)
    return (int32(value.data[byteIndex]) >> bitInByte) & 1

@borrows
fn csgProjectionStreamFirstDifferentBitRows(
        state: var csgProjectionStreamState,
        leftRow: int32,
        rightRow: int32): int32 =
    let left = csgProjectionStreamFixed32Get(
        state, state.keyHashes, leftRow)
    let right = csgProjectionStreamFixed32Get(
        state, state.keyHashes, rightRow)
    for byteIndex in 0..<32:
        let difference =
            (int32(left.data[byteIndex]) & 255) ^
            (int32(right.data[byteIndex]) & 255)
        if difference == 0:
            continue
        for bitOffset in 0..<8:
            if (difference & (1 << (7 - bitOffset))) != 0:
                return byteIndex * 8 + bitOffset
    return -1

@borrows
fn csgProjectionStreamBuildMerkleRange(
        state: var csgProjectionStreamState,
        start: int32,
        finish: int32,
        targetOrdinal: int32,
        pathDepth: int32): csgProjectionStreamMerkleNode =
    if start < 0 || finish > state.factCount || start >= finish:
        return csgProjectionStreamMerkleNodeFail(
            "csgc_projection_stream_merkle_range_invalid")
    let containsTarget =
        targetOrdinal >= start && targetOrdinal < finish
    if containsTarget:
        if pathDepth < 0 ||
           pathDepth >= csgProjectionStreamMerkleDepthLimit:
            return csgProjectionStreamMerkleNodeFail(
                "csgc_projection_stream_merkle_proof_depth_invalid")
    elif pathDepth >= 0:
        return csgProjectionStreamMerkleNodeFail(
            "csgc_projection_stream_merkle_proof_target_drift")
    if finish - start == 1:
        let row = csgProjectionStreamI32Get(
            state, state.physicalOrder, start)
        let keyHash = csgProjectionStreamFixed32Get(
            state, state.keyHashes, row)
        let factHash = csgProjectionStreamFixed32Get(
            state, state.factDigests, row)
        var leaf: csgProjectionStreamMerkleNode
        leaf.ok = true
        leaf.count = 1
        leaf.hash = csgProjectionStreamMerkleLeafHash(keyHash, factHash)
        return leaf

    let firstRow = csgProjectionStreamI32Get(
        state, state.physicalOrder, start)
    let lastRow = csgProjectionStreamI32Get(
        state, state.physicalOrder, finish - 1)
    let splitBit = csgProjectionStreamFirstDifferentBitRows(
        state, firstRow, lastRow)
    if splitBit < 0:
        return csgProjectionStreamMerkleNodeFail(
            "csgc_projection_stream_merkle_key_hash_collision")
    var low = start
    var high = finish
    while low < high:
        let middle = low + (high - low) / 2
        let row = csgProjectionStreamI32Get(
            state, state.physicalOrder, middle)
        let keyHash = csgProjectionStreamFixed32Get(
            state, state.keyHashes, row)
        if csgProjectionStreamMerkleBit(keyHash, splitBit) == 0:
            low = middle + 1
        else:
            high = middle
    let split = low
    if split <= start || split >= finish:
        return csgProjectionStreamMerkleNodeFail(
            "csgc_projection_stream_merkle_partition_invalid")

    var leftDepth: int32 = -1
    var rightDepth: int32 = -1
    var direction: int32 = -1
    if containsTarget:
        if targetOrdinal < split:
            leftDepth = pathDepth + 1
            direction = 0
        else:
            rightDepth = pathDepth + 1
            direction = 1
    let left = csgProjectionStreamBuildMerkleRange(
        state, start, split, targetOrdinal, leftDepth)
    if !left.ok:
        return left
    let right = csgProjectionStreamBuildMerkleRange(
        state, split, finish, targetOrdinal, rightDepth)
    if !right.ok:
        return right
    if left.count <= 0 || right.count <= 0 ||
       left.count > 2147483647 - right.count:
        return csgProjectionStreamMerkleNodeFail(
            "csgc_projection_stream_merkle_count_invalid")
    if containsTarget:
        csgProjectionStreamI32Set(
            state, state.proofSplitBits, pathDepth, splitBit)
        csgProjectionStreamI32Set(
            state, state.proofDirections, pathDepth, direction)
        if direction == 0:
            csgProjectionStreamI32Set(
                state, state.proofSiblingCounts, pathDepth, right.count)
            csgProjectionStreamFixed32Set(
                state,
                state.proofSiblingHashes,
                pathDepth,
                right.hash)
        else:
            csgProjectionStreamI32Set(
                state, state.proofSiblingCounts, pathDepth, left.count)
            csgProjectionStreamFixed32Set(
                state,
                state.proofSiblingHashes,
                pathDepth,
                left.hash)
        if state.proofDepth < pathDepth + 1:
            state.proofDepth = pathDepth + 1
    var branch: csgProjectionStreamMerkleNode
    branch.ok = true
    branch.count = left.count + right.count
    branch.hash = csgProjectionStreamMerkleBranchHash(
        splitBit, left.count, left.hash, right.count, right.hash)
    return branch

@borrows
fn csgProjectionStreamProofCommitmentParts(
        factCount: int32,
        replacementSourceOrdinal: int32,
        replacementCanonicalOrdinal: int32,
        queryKey: str,
        replacement: csgProjectionStreamReplacement,
        dagRoot: layout.FixedBytes32,
        splitBits: int32[],
        directions: int32[],
        siblingCounts: int32[],
        siblingHashes: layout.FixedBytes32[]): str =
    var buffer = layout.ByteBufInit(16384)
    csgProjectionStreamAppendText(
        buffer, csgProjectionStreamProofCommitmentDomain)
    csgProjectionStreamAppendU32(buffer, factCount)
    csgProjectionStreamAppendU32(
        buffer, replacementSourceOrdinal)
    csgProjectionStreamAppendU32(
        buffer, replacementCanonicalOrdinal)
    csgProjectionStreamAppendText(buffer, queryKey)
    layout.ByteBufAppendFixed32(buffer, replacement.beforeDigest)
    layout.ByteBufAppendFixed32(buffer, replacement.afterDigest)
    layout.ByteBufAppendFixed32(buffer, dagRoot)
    csgProjectionStreamAppendU32(buffer, splitBits.len)
    for depth in 0..<splitBits.len:
        csgProjectionStreamAppendU32(buffer, splitBits[depth])
        csgProjectionStreamAppendU32(buffer, directions[depth])
        csgProjectionStreamAppendU32(buffer, siblingCounts[depth])
        layout.ByteBufAppendFixed32(buffer, siblingHashes[depth])
    let digest = csgProjectionStreamHashBuffer(buffer)
    return csgProjectionStreamCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgProjectionStreamProofCommitment(
        state: var csgProjectionStreamState,
        queryKey: str,
        replacement: csgProjectionStreamReplacement,
        dagRoot: layout.FixedBytes32): str =
    var splitBits: int32[]
    var directions: int32[]
    var siblingCounts: int32[]
    var siblingHashes: layout.FixedBytes32[]
    for depth in 0..<state.proofDepth:
        add(
            splitBits,
            csgProjectionStreamI32Get(
                state, state.proofSplitBits, depth))
        add(
            directions,
            csgProjectionStreamI32Get(
                state, state.proofDirections, depth))
        add(
            siblingCounts,
            csgProjectionStreamI32Get(
                state, state.proofSiblingCounts, depth))
        add(
            siblingHashes,
            csgProjectionStreamFixed32Get(
                state, state.proofSiblingHashes, depth))
    return csgProjectionStreamProofCommitmentParts(
        state.factCount,
        state.replacementSourceOrdinal,
        state.replacementCanonicalOrdinal,
        queryKey,
        replacement,
        dagRoot,
        splitBits,
        directions,
        siblingCounts,
        siblingHashes)

@borrows
fn csgProjectionStreamExpectedAfterFail(
        error: str): CsgCoreCsgcProjectionStreamExpectedAfterResult =
    var out: CsgCoreCsgcProjectionStreamExpectedAfterResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreCsgcProjectionStreamExpectedAfterFromReplay(
        replay: merkle_dag.CsgCoreMerkleReplayResult,
        proof: merkle_dag.CsgCoreMerkleProof,
        replacementOrdinal: int32,
        queryKey: str,
        beforeFact: str,
        afterFact: str):
        CsgCoreCsgcProjectionStreamExpectedAfterResult =
    if !replay.ok || replay.error.len > 0 ||
       !proof.ok || proof.error.len > 0 || !proof.exists ||
       replacementOrdinal < 0 ||
       replay.beforeCount <= 0 ||
       replay.beforeCount != replay.afterCount ||
       proof.factCount != replay.beforeCount ||
       proof.queryKey != queryKey ||
       proof.factsRoot != replay.beforeFactsRoot ||
       proof.dagRootCid != replay.beforeDagRootCid ||
       proof.subgraphCid != replay.beforeSubgraphCid ||
       proof.splitBits.len > csgProjectionStreamMerkleDepthLimit ||
       proof.splitBits.len != proof.directions.len ||
       proof.splitBits.len != proof.siblingCounts.len ||
       proof.splitBits.len != proof.siblingHashes.len:
        return csgProjectionStreamExpectedAfterFail(
            "csgc_projection_stream_expected_replay_shape_invalid")
    let verified = merkle_dag.CsgCoreMerkleVerifyProof(
        proof, replay.beforeFactsRoot)
    if !verified.ok || !verified.exists ||
       verified.factCount != replay.beforeCount ||
       verified.dagRootCid != replay.beforeDagRootCid ||
       verified.subgraphCid != replay.beforeSubgraphCid ||
       verified.factsRoot != replay.beforeFactsRoot:
        return csgProjectionStreamExpectedAfterFail(
            "csgc_projection_stream_expected_before_proof_invalid")
    var replacement: csgProjectionStreamReplacement
    let replacementError = csgProjectionStreamValidateReplacement(
        replay.afterCount,
        replacementOrdinal,
        queryKey,
        beforeFact,
        afterFact,
        replacement)
    if replacementError.len > 0 ||
       !layout.FixedBytes32Equal(
           proof.terminalFactHash, replacement.beforeDigest) ||
       replay.canonicalFact != afterFact ||
       !layout.FixedBytes32Equal(replay.factHash, replacement.afterDigest):
        return csgProjectionStreamExpectedAfterFail(
            "csgc_projection_stream_expected_replacement_invalid")
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           replay.afterDagRootCid):
        return csgProjectionStreamExpectedAfterFail(
            "csgc_projection_stream_expected_after_root_invalid")
    let parsed = layout.FixedBytes32FromHex(
        strings.CloneStrRange(replay.afterDagRootCid, 7, 64))
    if result.IsErr(parsed):
        return csgProjectionStreamExpectedAfterFail(
            "csgc_projection_stream_expected_after_root_parse_failed")
    var out: CsgCoreCsgcProjectionStreamExpectedAfterResult
    out.ok = true
    out.expected.binding.standard =
        strings.CloneStr(replay.afterBinding.standard)
    out.expected.binding.profiles =
        identity.CsgCoreProfilesClone(replay.afterBinding.profiles)
    out.expected.binding.profileSetCid =
        strings.CloneStr(replay.afterBinding.profileSetCid)
    out.expected.binding.schemaNamespace =
        strings.CloneStr(replay.afterBinding.schemaNamespace)
    out.expected.binding.schemaCid =
        strings.CloneStr(replay.afterBinding.schemaCid)
    out.expected.binding.bindingIdentityReceiptCid =
        strings.CloneStr(replay.afterBinding.bindingIdentityReceiptCid)
    out.expected.afterFactsRoot =
        strings.CloneStr(replay.afterFactsRoot)
    out.expected.afterDagRootCid =
        strings.CloneStr(replay.afterDagRootCid)
    out.expected.afterSubgraphCid =
        strings.CloneStr(replay.afterSubgraphCid)
    for depth in 0..<proof.splitBits.len:
        add(out.expected.proofSplitBits, proof.splitBits[depth])
        add(out.expected.proofDirections, proof.directions[depth])
        add(out.expected.proofSiblingCounts, proof.siblingCounts[depth])
        add(out.expected.proofSiblingHashes, proof.siblingHashes[depth])
    # Source ordinal is CSGC section-walk order (kinds lexicographic);
    # canonical ordinal is key-hash rank. They coincide only for a
    # single-kind object. The commitment is hashed later with both.
    out.expected.afterProofCommitment = ""
    return out

@borrows
fn csgProjectionStreamComputeRoots(
        state: var csgProjectionStreamState,
        queryKey: str,
        replacement: csgProjectionStreamReplacement,
        roots: var csgProjectionStreamRootPlan): str =
    state.proofDepth = 0
    let root = csgProjectionStreamBuildMerkleRange(
        state,
        0,
        state.factCount,
        state.replacementCanonicalOrdinal,
        0)
    if !root.ok:
        return root.error
    if root.count != state.factCount ||
       layout.FixedBytes32Equal(root.hash, layout.FixedBytes32()):
        return "csgc_projection_stream_merkle_root_invalid"
    let subgraph = csgProjectionStreamMerkleSubgraphHash(
        state.factCount, root.hash)
    if layout.FixedBytes32Equal(subgraph, layout.FixedBytes32()):
        return "csgc_projection_stream_subgraph_root_invalid"
    roots.dagRootCid = csgProjectionStreamCat(
        "sha256:", layout.FixedBytes32Hex(root.hash))
    roots.subgraphCid = csgProjectionStreamCat(
        "sha256:", layout.FixedBytes32Hex(subgraph))
    roots.replacementProofCommitment =
        csgProjectionStreamProofCommitment(
            state, queryKey, replacement, root.hash)
    if roots.dagRootCid.len != 71 || roots.subgraphCid.len != 71 ||
       roots.replacementProofCommitment.len != 71:
        return "csgc_projection_stream_root_cid_invalid"
    return ""

@borrows
fn csgProjectionStreamExpectedAfterSemanticError(
        roots: csgProjectionStreamRootPlan,
        expected:
            CsgCoreCsgcProjectionStreamExpectedAfterSemantic,
        factCount: int32,
        replacementSourceOrdinal: int32,
        replacementCanonicalOrdinal: int32,
        queryKey: str,
        replacement: csgProjectionStreamReplacement): str =
    let binding = identity.CsgCoreBindingIdentityIssue(
        expected.binding.standard,
        expected.binding.schemaNamespace,
        expected.binding.schemaCid,
        expected.binding.profiles)
    if !binding.ok ||
       binding.profileSetCid != expected.binding.profileSetCid ||
       binding.bindingIdentityReceiptCid !=
           expected.binding.bindingIdentityReceiptCid:
        return "csgc_projection_stream_expected_binding_invalid"
    var factsRootError: str
    let computedFactsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            expected.binding.standard,
            expected.binding.profiles,
            expected.binding.schemaNamespace,
            expected.binding.schemaCid,
            roots.subgraphCid,
            factsRootError)
    if factsRootError.len > 0:
        return csgProjectionStreamCat(
            "csgc_projection_stream_facts_root_recompute_failed ",
            factsRootError)
    if roots.dagRootCid != expected.afterDagRootCid:
        return "csgc_projection_stream_expected_dag_root_mismatch"
    if roots.subgraphCid != expected.afterSubgraphCid:
        return "csgc_projection_stream_expected_subgraph_mismatch"
    if computedFactsRoot != expected.afterFactsRoot:
        return "csgc_projection_stream_expected_facts_root_mismatch"
    if expected.proofSplitBits.len != expected.proofDirections.len ||
       expected.proofSplitBits.len != expected.proofSiblingCounts.len ||
       expected.proofSplitBits.len != expected.proofSiblingHashes.len:
        return "csgc_projection_stream_expected_proof_shape_invalid"
    let parsed = layout.FixedBytes32FromHex(
        strings.CloneStrRange(expected.afterDagRootCid, 7, 64))
    if result.IsErr(parsed):
        return "csgc_projection_stream_expected_after_root_parse_failed"
    let expectedCommitment =
        csgProjectionStreamProofCommitmentParts(
            factCount,
            replacementSourceOrdinal,
            replacementCanonicalOrdinal,
            queryKey,
            replacement,
            result.Value(parsed),
            expected.proofSplitBits,
            expected.proofDirections,
            expected.proofSiblingCounts,
            expected.proofSiblingHashes)
    if roots.replacementProofCommitment != expectedCommitment:
        return "csgc_projection_stream_expected_proof_commitment_mismatch"
    return ""

@borrows
fn csgProjectionStreamSortCandidates(
        state: var csgProjectionStreamState) =
    let candidateOrder = state.candidateOrder
    let candidateScratch = state.candidateScratch
    for index in 0..<state.candidateCount:
        csgProjectionStreamI32Set(
            state, candidateOrder, index, index)
    var width: int32 = 1
    while width < state.candidateCount:
        var start: int32
        while start < state.candidateCount:
            var middle = start + width
            if middle > state.candidateCount:
                middle = state.candidateCount
            var finish = middle + width
            if finish > state.candidateCount:
                finish = state.candidateCount
            var left = start
            var right = middle
            for writeAt in start..<finish:
                var takeLeft = left < middle
                if takeLeft && right < finish:
                    let leftRow = csgProjectionStreamI32Get(
                        state, candidateOrder, left)
                    let rightRow = csgProjectionStreamI32Get(
                        state, candidateOrder, right)
                    takeLeft = csgProjectionStreamCandidateCompare(
                        state, leftRow, rightRow) <= 0
                var taken: int32
                if takeLeft:
                    taken = csgProjectionStreamI32Get(
                        state, candidateOrder, left)
                    left = left + 1
                else:
                    taken = csgProjectionStreamI32Get(
                        state, candidateOrder, right)
                    right = right + 1
                csgProjectionStreamI32Set(
                    state, candidateScratch, writeAt, taken)
            start = finish
        for index in 0..<state.candidateCount:
            let copied = csgProjectionStreamI32Get(
                state, candidateScratch, index)
            csgProjectionStreamI32Set(
                state, candidateOrder, index, copied)
        if width > state.candidateCount / 2:
            width = state.candidateCount
        else:
            width = width * 2

@borrows
fn csgProjectionStreamSortKinds(
        state: var csgProjectionStreamState) =
    let kindOrder = state.kindOrder
    let kindScratch = state.kindScratch
    let kindRanks = state.kindRanks
    for index in 0..<state.kindCount:
        csgProjectionStreamI32Set(state, kindOrder, index, index)
    var width: int32 = 1
    while width < state.kindCount:
        var start: int32
        while start < state.kindCount:
            var middle = start + width
            if middle > state.kindCount:
                middle = state.kindCount
            var finish = middle + width
            if finish > state.kindCount:
                finish = state.kindCount
            var left = start
            var right = middle
            for writeAt in start..<finish:
                var takeLeft = left < middle
                if takeLeft && right < finish:
                    let leftRow = csgProjectionStreamI32Get(
                        state, kindOrder, left)
                    let rightRow = csgProjectionStreamI32Get(
                        state, kindOrder, right)
                    takeLeft = csgProjectionStreamKindCompare(
                        state, leftRow, rightRow) <= 0
                var taken: int32
                if takeLeft:
                    taken = csgProjectionStreamI32Get(
                        state, kindOrder, left)
                    left = left + 1
                else:
                    taken = csgProjectionStreamI32Get(
                        state, kindOrder, right)
                    right = right + 1
                csgProjectionStreamI32Set(
                    state, kindScratch, writeAt, taken)
            start = finish
        for index in 0..<state.kindCount:
            let copied = csgProjectionStreamI32Get(
                state, kindScratch, index)
            csgProjectionStreamI32Set(
                state, kindOrder, index, copied)
        if width > state.kindCount / 2:
            width = state.kindCount
        else:
            width = width * 2
    for rank in 0..<state.kindCount:
        let kindIndex = csgProjectionStreamI32Get(
            state, kindOrder, rank)
        csgProjectionStreamI32Set(
            state, kindRanks, kindIndex, rank)

@borrows
fn csgProjectionStreamFeedMapped(
        feed: var csgProjectionStreamFeedBuffer,
        authority:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority,
        factCount: int32,
        queryKey: str,
        beforeFact: str,
        afterFact: str,
        replacement: csgProjectionStreamReplacement): str =
    var sourceByteCount: int32
    for ordinal in 0..<factCount:
        let read =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcReadFact(
                authority, ordinal)
        if !read.ok:
            return csgProjectionStreamCat(
                "csgc_projection_stream_mapped_read_failed ", read.error)
        if read.ordinal != ordinal || read.line.len == 0 ||
           read.line.len > csgProjectionStreamSingleLineByteLimit:
            return "csgc_projection_stream_mapped_fact_shape_invalid"
        if sourceByteCount >
           csgProjectionStreamLineByteLimit - read.line.len:
            return "csgc_projection_stream_source_line_bytes_exhausted"
        sourceByteCount = sourceByteCount + read.line.len
        var error: str
        let canonical =
            merkle_dag.CsgCoreMerkleCanonicalFact(read.line, error)
        if error.len > 0 || canonical != read.line:
            return "csgc_projection_stream_mapped_fact_not_canonical"
        error = ""
        let digest = merkle_dag.CsgCoreMerkleFactHash(read.line, error)
        if error.len > 0 ||
           !layout.FixedBytes32Equal(digest, read.factDigest):
            return "csgc_projection_stream_mapped_fact_digest_mismatch"
        error = ""
        let key = merkle_dag.CsgCoreMerkleFactKey(read.line, error)
        if error.len > 0 || key.len == 0:
            return "csgc_projection_stream_mapped_fact_key_invalid"

        let keyHash = merkle_dag.CsgCoreMerkleKeyHash(key)
        if layout.FixedBytes32Equal(keyHash, layout.FixedBytes32()):
            return "csgc_projection_stream_fact_key_hash_invalid"
        var outputLine = read.line
        var outputDigest = read.factDigest
        var replacementFlag: int32
        if key == queryKey:
            if feed.replacementSourceOrdinal >= 0 ||
               read.line != beforeFact ||
               !layout.FixedBytes32Equal(
                   read.factDigest, replacement.beforeDigest) ||
               !layout.FixedBytes32Equal(
                   keyHash, replacement.keyHash):
                return "csgc_projection_stream_replacement_source_mismatch"
            feed.replacementSourceOrdinal = ordinal
            replacementFlag = 1
            outputLine = strings.CloneStr(afterFact)
            outputDigest = replacement.afterDigest
        let outputLength = outputLine.len
        let keyLength = key.len
        if feed.lineByteCount >
           csgProjectionStreamLineByteLimit - outputLength:
            return "csgc_projection_stream_output_line_bytes_exhausted"
        if feed.keyByteCount >
           csgProjectionStreamKeyByteLimit - keyLength:
            return "csgc_projection_stream_key_bytes_exhausted"
        add(feed.lines, outputLine)
        add(feed.keys, key)
        add(feed.lineOffsets, feed.lineByteCount)
        add(feed.lineLengths, outputLength)
        add(feed.keyOffsets, feed.keyByteCount)
        add(feed.keyLengths, keyLength)
        add(feed.replacementFlags, replacementFlag)
        add(feed.keyHashes, keyHash)
        add(feed.factDigests, outputDigest)
        feed.lineByteCount = feed.lineByteCount + outputLength
        feed.keyByteCount = feed.keyByteCount + keyLength
    if feed.replacementSourceOrdinal < 0:
        return "csgc_projection_stream_replacement_source_missing"
    return ""

fn csgProjectionStreamLoadFeed(
        state: var csgProjectionStreamState,
        feed: var csgProjectionStreamFeedBuffer) =
    if feed.lines.len != state.factCount ||
       feed.keys.len != state.factCount ||
       feed.lineOffsets.len != state.factCount ||
       feed.lineLengths.len != state.factCount ||
       feed.keyOffsets.len != state.factCount ||
       feed.keyLengths.len != state.factCount ||
       feed.replacementFlags.len != state.factCount ||
       feed.keyHashes.len != state.factCount ||
       feed.factDigests.len != state.factCount:
        panic("csgc_projection_stream_feed_shape_drift")
    for ordinal in 0..<state.factCount:
        let line = feed.lines[ordinal]
        let key = feed.keys[ordinal]
        if feed.lineOffsets[ordinal] != state.lineByteCount ||
           feed.lineLengths[ordinal] != line.len ||
           feed.keyOffsets[ordinal] != state.keyByteCount ||
           feed.keyLengths[ordinal] != key.len:
            panic("csgc_projection_stream_feed_shape_drift")
        csgProjectionStreamCopyTextInto(
            state, state.lineBytes, state.lineByteCount, line)
        csgProjectionStreamCopyTextInto(
            state, state.keyBytes, state.keyByteCount, key)
        csgProjectionStreamI32Set(
            state, state.lineOffsets, ordinal, state.lineByteCount)
        csgProjectionStreamI32Set(
            state, state.lineLengths, ordinal, line.len)
        csgProjectionStreamI32Set(
            state, state.keyOffsets, ordinal, state.keyByteCount)
        csgProjectionStreamI32Set(
            state, state.keyLengths, ordinal, key.len)
        csgProjectionStreamI32Set(
            state,
            state.replacementFlags,
            ordinal,
            feed.replacementFlags[ordinal])
        csgProjectionStreamFixed32Set(
            state, state.keyHashes, ordinal, feed.keyHashes[ordinal])
        csgProjectionStreamFixed32Set(
            state, state.factDigests, ordinal, feed.factDigests[ordinal])
        state.lineByteCount = state.lineByteCount + line.len
        state.keyByteCount = state.keyByteCount + key.len
    state.replacementSourceOrdinal = feed.replacementSourceOrdinal
    seqs.freeSeq(feed.lines)
    seqs.freeSeq(feed.keys)
    seqs.freeSeq(feed.lineOffsets)
    seqs.freeSeq(feed.lineLengths)
    seqs.freeSeq(feed.keyOffsets)
    seqs.freeSeq(feed.keyLengths)
    seqs.freeSeq(feed.replacementFlags)
    seqs.freeSeq(feed.keyHashes)
    seqs.freeSeq(feed.factDigests)

@borrows
fn csgProjectionStreamRowText(
        state: var csgProjectionStreamState,
        row: int32): str =
    return csgProjectionStreamRegionText(
        state,
        state.lineBytes,
        csgProjectionStreamI32Get(state, state.lineOffsets, row),
        csgProjectionStreamI32Get(state, state.lineLengths, row))

@borrows
fn csgProjectionStreamRowIntegrity(
        state: var csgProjectionStreamState,
        row: int32,
        line: str): str =
    if row < 0 || row >= state.factCount ||
       line.len != csgProjectionStreamI32Get(
           state, state.lineLengths, row):
        return "csgc_projection_stream_row_shape_invalid"
    var error: str
    let canonical = merkle_dag.CsgCoreMerkleCanonicalFact(line, error)
    if error.len > 0 || canonical != line:
        return "csgc_projection_stream_row_not_canonical"
    error = ""
    let digest = merkle_dag.CsgCoreMerkleFactHash(line, error)
    if error.len > 0 ||
       !csgProjectionStreamFixed32Matches(
           state, state.factDigests, row, digest):
        return "csgc_projection_stream_row_digest_drift"
    error = ""
    let key = merkle_dag.CsgCoreMerkleFactKey(line, error)
    if error.len > 0 || key.len == 0:
        return "csgc_projection_stream_row_key_invalid"
    let keyOffset = csgProjectionStreamI32Get(
        state, state.keyOffsets, row)
    let keyLength = csgProjectionStreamI32Get(
        state, state.keyLengths, row)
    if !csgProjectionStreamTextMatches(
           state, state.keyBytes, keyOffset, keyLength, key):
        return "csgc_projection_stream_row_key_drift"
    let keyHash = merkle_dag.CsgCoreMerkleKeyHash(key)
    if !csgProjectionStreamFixed32Matches(
           state, state.keyHashes, row, keyHash):
        return "csgc_projection_stream_row_key_hash_drift"
    return ""

@borrows
fn csgProjectionStreamInternKind(
        state: var csgProjectionStreamState,
        row: int32,
        kind: str): str =
    let lookup = csgProjectionStreamKindLookup(state, kind)
    if !lookup.ok:
        return "csgc_projection_stream_kind_index_exhausted"
    var kindIndex = lookup.foundIndex
    if kindIndex < 0:
        if state.kindCount >= csgProjectionStreamKindLimit:
            return "csgc_projection_stream_kind_count_exhausted"
        if state.kindByteCount >
           csgProjectionStreamKindByteLimit - kind.len:
            return "csgc_projection_stream_kind_bytes_exhausted"
        kindIndex = state.kindCount
        csgProjectionStreamCopyTextInto(
            state, state.kindBytes, state.kindByteCount, kind)
        csgProjectionStreamI32Set(
            state, state.kindOffsets, kindIndex, state.kindByteCount)
        csgProjectionStreamI32Set(
            state, state.kindLengths, kindIndex, kind.len)
        csgProjectionStreamI32Set(
            state, state.kindCounts, kindIndex, 0)
        csgProjectionStreamI32Set(
            state, state.kindPayloadLengths, kindIndex, 4)
        csgProjectionStreamI32Set(
            state, state.kindSlots, lookup.slot, kindIndex + 1)
        state.kindByteCount = state.kindByteCount + kind.len
        state.kindCount = state.kindCount + 1
    let count = csgProjectionStreamI32Get(
        state, state.kindCounts, kindIndex)
    if count >= state.factCount:
        return "csgc_projection_stream_kind_count_overflow"
    csgProjectionStreamI32Set(
        state, state.kindCounts, kindIndex, count + 1)
    csgProjectionStreamI32Set(
        state, state.rowKinds, row, kindIndex)
    return ""

@borrows
fn csgProjectionStreamInternCandidate(
        state: var csgProjectionStreamState,
        line: str,
        tokenStart: int32,
        tokenLength: int32,
        tokenOffset: int32): str =
    let lookup = csgProjectionStreamCandidateLookupRange(
        state, line, tokenStart, tokenLength)
    if !lookup.ok:
        return "csgc_projection_stream_candidate_index_exhausted"
    if lookup.foundIndex >= 0:
        let count = csgProjectionStreamI32Get(
            state, state.candidateCounts, lookup.foundIndex)
        if count >= csgProjectionStreamTokenOccurrenceLimit:
            return "csgc_projection_stream_candidate_count_overflow"
        csgProjectionStreamI32Set(
            state,
            state.candidateCounts,
            lookup.foundIndex,
            count + 1)
        return ""
    if state.candidateCount >= csgProjectionStreamCandidateLimit:
        return "csgc_projection_stream_candidate_count_exhausted"
    let candidateIndex = state.candidateCount
    csgProjectionStreamI32Set(
        state, state.candidateOffsets, candidateIndex, tokenOffset)
    csgProjectionStreamI32Set(
        state, state.candidateLengths, candidateIndex, tokenLength)
    csgProjectionStreamI32Set(
        state, state.candidateCounts, candidateIndex, 1)
    csgProjectionStreamI32Set(
        state, state.candidateDictIndexes, candidateIndex, -1)
    csgProjectionStreamI32Set(
        state, state.candidateSlots, lookup.slot, candidateIndex + 1)
    state.candidateCount = state.candidateCount + 1
    return ""

@borrows
fn csgProjectionStreamPlanFacts(
        state: var csgProjectionStreamState): str =
    var tokenOccurrences: int32
    for physicalOrdinal in 0..<state.factCount:
        let row = csgProjectionStreamI32Get(
            state, state.physicalOrder, physicalOrdinal)
        let line = csgProjectionStreamRowText(state, row)
        let integrityError =
            csgProjectionStreamRowIntegrity(state, row, line)
        if integrityError.len > 0:
            return integrityError
        let kind = field.CsgCoreJsonKind(line)
        if !kind.found || kind.value.len == 0:
            return "csgc_projection_stream_fact_kind_missing"
        let kindError =
            csgProjectionStreamInternKind(state, row, kind.value)
        if kindError.len > 0:
            return kindError
        let lineOffset = csgProjectionStreamI32Get(
            state, state.lineOffsets, row)
        var tokenCursor: csgProjectionStreamTokenCursor
        var coveredBytes: int32
        var rowTokenCount: int32
        var token = csgProjectionStreamTokenNext(line, tokenCursor)
        while token.ok && !token.done:
            if token.length <= 0 || token.start != coveredBytes ||
               token.start > line.len - token.length:
                return "csgc_projection_stream_token_partition_invalid"
            if tokenOccurrences >=
               csgProjectionStreamTokenOccurrenceLimit:
                return "csgc_projection_stream_token_occurrences_exhausted"
            tokenOccurrences = tokenOccurrences + 1
            rowTokenCount = rowTokenCount + 1
            if token.length >= 2:
                let candidateError = csgProjectionStreamInternCandidate(
                    state,
                    line,
                    token.start,
                    token.length,
                    lineOffset + token.start)
                if candidateError.len > 0:
                    return candidateError
            coveredBytes = coveredBytes + token.length
            token = csgProjectionStreamTokenNext(line, tokenCursor)
        if !token.ok || rowTokenCount <= 0 || coveredBytes != line.len:
            return "csgc_projection_stream_token_partition_invalid"
    if state.kindCount <= 0:
        return "csgc_projection_stream_kind_partition_empty"
    csgProjectionStreamSortCandidates(state)
    csgProjectionStreamSortKinds(state)
    return ""

fn csgProjectionStreamDictionarySavings(
        tokenLength: int32,
        count: int32,
        dictionaryIndex: int32): int64 =
    let inlineCost = int64(1) +
        int64(csgProjectionStreamVarintLength(tokenLength)) +
        int64(tokenLength)
    let entryCost =
        int64(csgProjectionStreamVarintLength(tokenLength)) +
        int64(tokenLength)
    let referenceCost = int64(1) +
        int64(csgProjectionStreamVarintLength(dictionaryIndex))
    return int64(count) * inlineCost -
        (entryCost + int64(count) * referenceCost)

@borrows
fn csgProjectionStreamAdmitDictionary(
        state: var csgProjectionStreamState,
        plan: var csgProjectionStreamPlan): str =
    var payloadLength: int32 = 4
    for sortedIndex in 0..<state.candidateCount:
        let candidateIndex = csgProjectionStreamI32Get(
            state, state.candidateOrder, sortedIndex)
        let tokenLength = csgProjectionStreamI32Get(
            state, state.candidateLengths, candidateIndex)
        let count = csgProjectionStreamI32Get(
            state, state.candidateCounts, candidateIndex)
        if tokenLength < 2 || count <= 0:
            return "csgc_projection_stream_candidate_shape_invalid"
        if count >= 2 &&
           csgProjectionStreamDictionarySavings(
               tokenLength, count, plan.dictionaryCount) > int64(0):
            let entryLength =
                csgProjectionStreamVarintLength(tokenLength) + tokenLength
            if payloadLength >
               csgProjectionStreamEncodedByteLimit - entryLength:
                return "csgc_projection_stream_dictionary_bytes_exhausted"
            csgProjectionStreamI32Set(
                state,
                state.candidateDictIndexes,
                candidateIndex,
                plan.dictionaryCount)
            plan.dictionaryCount = plan.dictionaryCount + 1
            payloadLength = payloadLength + entryLength
    plan.dictionaryPayloadLength = payloadLength
    return ""

@borrows
fn csgProjectionStreamTokenWireLength(
        state: var csgProjectionStreamState,
        line: str,
        tokenStart: int32,
        tokenLength: int32,
        out: var int32): bool =
    var dictIndex: int32 = -1
    if tokenLength >= 2:
        let lookup = csgProjectionStreamCandidateLookupRange(
            state, line, tokenStart, tokenLength)
        if !lookup.ok || lookup.foundIndex < 0:
            return false
        dictIndex = csgProjectionStreamI32Get(
            state, state.candidateDictIndexes, lookup.foundIndex)
    if dictIndex >= 0:
        out = 1 + csgProjectionStreamVarintLength(dictIndex)
    else:
        out = 1 +
            csgProjectionStreamVarintLength(tokenLength) + tokenLength
    return true

@borrows
fn csgProjectionStreamPlanWire(
        state: var csgProjectionStreamState,
        plan: var csgProjectionStreamPlan): str =
    var tokenOccurrences: int32
    for physicalOrdinal in 0..<state.factCount:
        let row = csgProjectionStreamI32Get(
            state, state.physicalOrder, physicalOrdinal)
        let line = csgProjectionStreamRowText(state, row)
        let integrityError =
            csgProjectionStreamRowIntegrity(state, row, line)
        if integrityError.len > 0:
            return integrityError
        var tokenCursor: csgProjectionStreamTokenCursor
        var rowTokenCount: int32
        var coveredBytes: int32
        var tokenBytesLength: int32
        var tokenLength: int32
        var token = csgProjectionStreamTokenNext(line, tokenCursor)
        while token.ok && !token.done:
            if token.length <= 0 || token.start != coveredBytes ||
               token.start > line.len - token.length:
                return "csgc_projection_stream_wire_token_partition_invalid"
            if tokenOccurrences >=
               csgProjectionStreamTokenOccurrenceLimit:
                return "csgc_projection_stream_wire_token_limit_exhausted"
            tokenOccurrences = tokenOccurrences + 1
            rowTokenCount = rowTokenCount + 1
            tokenLength = 0
            if !csgProjectionStreamTokenWireLength(
                   state,
                   line,
                   token.start,
                   token.length,
                   tokenLength):
                return "csgc_projection_stream_candidate_lookup_drift"
            if tokenBytesLength >
               csgProjectionStreamEncodedByteLimit - tokenLength:
                return "csgc_projection_stream_row_wire_size_exhausted"
            tokenBytesLength = tokenBytesLength + tokenLength
            coveredBytes = coveredBytes + token.length
            token = csgProjectionStreamTokenNext(line, tokenCursor)
        if !token.ok || rowTokenCount <= 0 || coveredBytes != line.len:
            return "csgc_projection_stream_wire_token_partition_invalid"
        let countLength = csgProjectionStreamVarintLength(rowTokenCount)
        if tokenBytesLength >
           csgProjectionStreamEncodedByteLimit - countLength:
            return "csgc_projection_stream_row_wire_size_exhausted"
        let rowLength = countLength + tokenBytesLength
        csgProjectionStreamI32Set(
            state, state.rowEncodedLengths, row, rowLength)
        let kindIndex = csgProjectionStreamI32Get(
            state, state.rowKinds, row)
        if kindIndex < 0 || kindIndex >= state.kindCount:
            return "csgc_projection_stream_row_kind_invalid"
        let payloadLength = csgProjectionStreamI32Get(
            state, state.kindPayloadLengths, kindIndex)
        if payloadLength >
           csgProjectionStreamEncodedByteLimit - rowLength:
            return "csgc_projection_stream_section_bytes_exhausted"
        csgProjectionStreamI32Set(
            state,
            state.kindPayloadLengths,
            kindIndex,
            payloadLength + rowLength)

    var directoryLength = csgc.CsgCoreCsgcDirectoryPrefixSize +
        csgc.CsgCoreCsgcSectionFixedSize + 1
    for rank in 0..<state.kindCount:
        let kindIndex = csgProjectionStreamI32Get(
            state, state.kindOrder, rank)
        let kindLength = csgProjectionStreamI32Get(
            state, state.kindLengths, kindIndex)
        let entryLength = csgc.CsgCoreCsgcSectionFixedSize +
            csgProjectionStreamVarintLength(kindLength) + kindLength
        if directoryLength >
           csgProjectionStreamEncodedByteLimit - entryLength:
            return "csgc_projection_stream_directory_bytes_exhausted"
        directoryLength = directoryLength + entryLength
    plan.directoryLength = directoryLength

    var nextPayloadOffset: int32
    if !csgProjectionStreamCheckedAdd(
           directoryLength,
           plan.dictionaryPayloadLength,
           nextPayloadOffset):
        return "csgc_projection_stream_payload_offset_overflow"
    var groupedCount: int32
    for rank in 0..<state.kindCount:
        let kindIndex = csgProjectionStreamI32Get(
            state, state.kindOrder, rank)
        let count = csgProjectionStreamI32Get(
            state, state.kindCounts, kindIndex)
        let payloadLength = csgProjectionStreamI32Get(
            state, state.kindPayloadLengths, kindIndex)
        if count <= 0 || payloadLength < 4:
            return "csgc_projection_stream_section_shape_invalid"
        csgProjectionStreamI32Set(
            state, state.kindRanks, kindIndex, rank)
        csgProjectionStreamI32Set(
            state, state.kindStarts, kindIndex, groupedCount)
        csgProjectionStreamI32Set(
            state, state.kindCursors, kindIndex, groupedCount)
        csgProjectionStreamI32Set(
            state, state.kindPayloadOffsets, kindIndex, nextPayloadOffset)
        if groupedCount > state.factCount - count:
            return "csgc_projection_stream_grouped_count_overflow"
        groupedCount = groupedCount + count
        if !csgProjectionStreamCheckedAdd(
               nextPayloadOffset, payloadLength, nextPayloadOffset):
            return "csgc_projection_stream_payload_offset_overflow"
    if groupedCount != state.factCount:
        return "csgc_projection_stream_grouped_count_mismatch"
    plan.bodyLength = nextPayloadOffset
    if plan.bodyLength >
       csgProjectionStreamEncodedByteLimit - csgc.CsgCoreCsgcHeaderSize:
        return "csgc_projection_stream_encoded_bytes_exhausted"
    plan.totalLength = csgc.CsgCoreCsgcHeaderSize + plan.bodyLength

    for physicalOrdinal in 0..<state.factCount:
        let row = csgProjectionStreamI32Get(
            state, state.physicalOrder, physicalOrdinal)
        let kindIndex = csgProjectionStreamI32Get(
            state, state.rowKinds, row)
        let cursor = csgProjectionStreamI32Get(
            state, state.kindCursors, kindIndex)
        let start = csgProjectionStreamI32Get(
            state, state.kindStarts, kindIndex)
        let count = csgProjectionStreamI32Get(
            state, state.kindCounts, kindIndex)
        if cursor < start || cursor >= start + count:
            return "csgc_projection_stream_section_cursor_invalid"
        csgProjectionStreamI32Set(
            state, state.sectionRows, cursor, row)
        csgProjectionStreamI32Set(
            state, state.kindCursors, kindIndex, cursor + 1)
    for kindIndex in 0..<state.kindCount:
        if csgProjectionStreamI32Get(
               state, state.kindCursors, kindIndex) !=
           csgProjectionStreamI32Get(
               state, state.kindStarts, kindIndex) +
           csgProjectionStreamI32Get(
               state, state.kindCounts, kindIndex):
            return "csgc_projection_stream_section_group_incomplete"
    return ""

fn csgProjectionStreamWriteU8(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)

fn csgProjectionStreamWriteU16(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(bytes, offset + 1, (value >> 8) & 255)

fn csgProjectionStreamWriteU32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(bytes, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(bytes, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(bytes, offset + 3, (value >> 24) & 255)

fn csgProjectionStreamWriteVarint(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: int32): int32 =
    var current = value
    var cursor = offset
    while current >= 128:
        csgProjectionStreamWriteU8(
            bytes, cursor, (current & 127) | 128)
        cursor = cursor + 1
        current = current >> 7
    csgProjectionStreamWriteU8(bytes, cursor, current & 127)
    return cursor + 1

@borrows
fn csgProjectionStreamWriteText(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: str): int32 =
    var cursor = csgProjectionStreamWriteVarint(
        bytes, offset, value.len)
    let valueBytes = rawbytes.BytesFromString(value)
    rawbytes.BytesCopyInto(bytes, cursor, valueBytes)
    return cursor + value.len

@borrows
fn csgProjectionStreamWriteTextRange(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: str,
        valueStart: int32,
        valueLength: int32): int32 =
    var cursor = csgProjectionStreamWriteVarint(
        bytes, offset, valueLength)
    let valueBytes = rawbytes.BytesFromString(value)
    let valueView = rawbytes.BytesSliceView(
        valueBytes, valueStart, valueLength)
    rawbytes.BytesCopyInto(bytes, cursor, valueView)
    return cursor + valueLength

@borrows
fn csgProjectionStreamWriteFixed32(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: layout.FixedBytes32) =
    for index in 0..<32:
        rawbytes.BytesSet(
            bytes, offset + index, int32(value.data[index]) & 255)

@borrows
fn csgProjectionStreamCopyRegionInto(
        state: var csgProjectionStreamState,
        region: phase.PhaseArenaRef,
        regionOffset: int32,
        count: int32,
        bytes: var rawbytes.Bytes,
        outputOffset: int32) =
    var source = phase.PhaseArenaStoreCopyBytesOut(
        state.store, state.arena, region, regionOffset, count)
    rawbytes.BytesCopyInto(bytes, outputOffset, source)
    rawbytes.BytesFree(source)

fn csgProjectionStreamAppendU32(
        buffer: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buffer, value & 255)
    layout.ByteBufAppendByte(buffer, (value >> 8) & 255)
    layout.ByteBufAppendByte(buffer, (value >> 16) & 255)
    layout.ByteBufAppendByte(buffer, (value >> 24) & 255)

@borrows
fn csgProjectionStreamAppendText(
        buffer: var layout.ByteBuf,
        value: str) =
    csgProjectionStreamAppendU32(buffer, value.len)
    let valueBytes = rawbytes.BytesFromString(value)
    layout.ByteBufAppendBytes(buffer, valueBytes)

@borrows
fn csgProjectionStreamSectionDigest(
        bytes: rawbytes.Bytes,
        tag: int32,
        kind: str,
        itemCount: int32,
        payloadOffset: int32,
        payloadLength: int32): layout.FixedBytes32 =
    if kind.len > 2147483551:
        panic("csgc_projection_stream_section_digest_prefix_overflow")
    var prefix = layout.ByteBufInit(96 + kind.len)
    csgProjectionStreamAppendText(
        prefix, csgc.CsgCoreCsgcSectionHashDomain)
    layout.ByteBufAppendByte(prefix, tag)
    csgProjectionStreamAppendText(prefix, kind)
    csgProjectionStreamAppendU32(prefix, itemCount)
    csgProjectionStreamAppendU32(prefix, payloadLength)
    let allBytes = layout.ByteSpanFromBytes(bytes)
    let payload = layout.ByteSpanSlice(
        allBytes, payloadOffset, payloadLength)
    let digest = hash256.Sha256FixedTwo(
        layout.ByteBufView(prefix), payload)
    layout.ByteBufFree(prefix)
    return digest

@borrows
fn csgProjectionStreamWriteSectionEntry(
        bytes: var rawbytes.Bytes,
        offset: int32,
        tag: int32,
        kind: str,
        payloadOffset: int32,
        payloadLength: int32,
        itemCount: int32,
        digest: layout.FixedBytes32): int32 =
    var cursor = offset
    csgProjectionStreamWriteU8(bytes, cursor, tag)
    cursor = cursor + 1
    cursor = csgProjectionStreamWriteText(bytes, cursor, kind)
    csgProjectionStreamWriteU32(bytes, cursor, payloadOffset)
    cursor = cursor + 4
    csgProjectionStreamWriteU32(bytes, cursor, payloadLength)
    cursor = cursor + 4
    csgProjectionStreamWriteU32(bytes, cursor, itemCount)
    cursor = cursor + 4
    csgProjectionStreamWriteFixed32(bytes, cursor, digest)
    return cursor + csgc.CsgCoreCsgcSectionDigestSize

@borrows
fn csgProjectionStreamEmitRow(
        state: var csgProjectionStreamState,
        row: int32,
        bytes: var rawbytes.Bytes,
        offset: int32,
        nextOffset: var int32): str =
    let line = csgProjectionStreamRowText(state, row)
    let integrityError =
        csgProjectionStreamRowIntegrity(state, row, line)
    if integrityError.len > 0:
        return integrityError
    var countCursor: csgProjectionStreamTokenCursor
    var tokenCount: int32
    var countedBytes: int32
    var countedToken = csgProjectionStreamTokenNext(line, countCursor)
    while countedToken.ok && !countedToken.done:
        if countedToken.length <= 0 ||
           countedToken.start != countedBytes ||
           countedToken.start > line.len - countedToken.length ||
           tokenCount >= csgProjectionStreamTokenOccurrenceLimit:
            return "csgc_projection_stream_emit_token_count_invalid"
        tokenCount = tokenCount + 1
        countedBytes = countedBytes + countedToken.length
        countedToken = csgProjectionStreamTokenNext(line, countCursor)
    if !countedToken.ok || tokenCount <= 0 || countedBytes != line.len:
        return "csgc_projection_stream_emit_token_count_invalid"
    var cursor = csgProjectionStreamWriteVarint(
        bytes, offset, tokenCount)
    var emitCursor: csgProjectionStreamTokenCursor
    var emittedTokens: int32
    var emittedBytes: int32
    var emittedToken = csgProjectionStreamTokenNext(line, emitCursor)
    while emittedToken.ok && !emittedToken.done:
        if emittedToken.length <= 0 ||
           emittedToken.start != emittedBytes ||
           emittedToken.start > line.len - emittedToken.length:
            return "csgc_projection_stream_emit_token_partition_invalid"
        var dictIndex: int32 = -1
        if emittedToken.length >= 2:
            let lookup = csgProjectionStreamCandidateLookupRange(
                state,
                line,
                emittedToken.start,
                emittedToken.length)
            if !lookup.ok || lookup.foundIndex < 0:
                return "csgc_projection_stream_emit_candidate_missing"
            dictIndex = csgProjectionStreamI32Get(
                state,
                state.candidateDictIndexes,
                lookup.foundIndex)
        if dictIndex >= 0:
            csgProjectionStreamWriteU8(
                bytes, cursor, csgc.CsgCoreCsgcTokenDictRef)
            cursor = cursor + 1
            cursor = csgProjectionStreamWriteVarint(
                bytes, cursor, dictIndex)
        else:
            csgProjectionStreamWriteU8(
                bytes, cursor, csgc.CsgCoreCsgcTokenInlineUtf8)
            cursor = cursor + 1
            cursor = csgProjectionStreamWriteTextRange(
                bytes,
                cursor,
                line,
                emittedToken.start,
                emittedToken.length)
        emittedTokens = emittedTokens + 1
        emittedBytes = emittedBytes + emittedToken.length
        emittedToken = csgProjectionStreamTokenNext(line, emitCursor)
    if !emittedToken.ok || emittedTokens != tokenCount ||
       emittedBytes != line.len ||
       cursor - offset != csgProjectionStreamI32Get(
           state, state.rowEncodedLengths, row):
        return "csgc_projection_stream_emit_row_size_mismatch"
    nextOffset = cursor
    return ""

@borrows
fn csgProjectionStreamEmit(
        state: var csgProjectionStreamState,
        plan: csgProjectionStreamPlan):
        CsgCoreCsgcProjectionStreamResult =
    var bytes = rawbytes.BytesAlloc(plan.totalLength)
    if rawbytes.BytesLen(bytes) != plan.totalLength || bytes.data == nil:
        rawbytes.BytesFree(bytes)
        return csgProjectionStreamFail(
            "csgc_projection_stream_output_allocation_failed")

    csgProjectionStreamWriteU32(bytes, 0, csgc.CsgCoreCsgcMagic)
    csgProjectionStreamWriteU16(
        bytes, 4, csgc.CsgCoreCsgcHeaderSize)
    csgProjectionStreamWriteU16(
        bytes, 6, csgc.CsgCoreCsgcFlagNone)
    csgProjectionStreamWriteU32(bytes, 8, state.factCount)
    csgProjectionStreamWriteU32(bytes, 12, 0)
    csgProjectionStreamWriteU32(bytes, 16, plan.bodyLength)
    for index in 20..<csgc.CsgCoreCsgcHeaderSize:
        csgProjectionStreamWriteU8(bytes, index, 0)

    csgProjectionStreamWriteU32(
        bytes, csgc.CsgCoreCsgcHeaderSize, plan.directoryLength)
    csgProjectionStreamWriteU32(
        bytes,
        csgc.CsgCoreCsgcHeaderSize + 4,
        state.kindCount + 1)

    let dictionaryPayloadOffset = plan.directoryLength
    var cursor = csgc.CsgCoreCsgcHeaderSize +
        dictionaryPayloadOffset
    csgProjectionStreamWriteU32(
        bytes, cursor, plan.dictionaryCount)
    cursor = cursor + 4
    var emittedDictionaryCount: int32
    for sortedIndex in 0..<state.candidateCount:
        let candidateIndex = csgProjectionStreamI32Get(
            state, state.candidateOrder, sortedIndex)
        let dictIndex = csgProjectionStreamI32Get(
            state, state.candidateDictIndexes, candidateIndex)
        if dictIndex < 0:
            continue
        if dictIndex != emittedDictionaryCount:
            rawbytes.BytesFree(bytes)
            return csgProjectionStreamFail(
                "csgc_projection_stream_dictionary_index_drift")
        let tokenOffset = csgProjectionStreamI32Get(
            state, state.candidateOffsets, candidateIndex)
        let tokenLength = csgProjectionStreamI32Get(
            state, state.candidateLengths, candidateIndex)
        cursor = csgProjectionStreamWriteVarint(
            bytes, cursor, tokenLength)
        csgProjectionStreamCopyRegionInto(
            state,
            state.lineBytes,
            tokenOffset,
            tokenLength,
            bytes,
            cursor)
        cursor = cursor + tokenLength
        emittedDictionaryCount = emittedDictionaryCount + 1
    if emittedDictionaryCount != plan.dictionaryCount ||
       cursor != csgc.CsgCoreCsgcHeaderSize +
                     dictionaryPayloadOffset +
                     plan.dictionaryPayloadLength:
        rawbytes.BytesFree(bytes)
        return csgProjectionStreamFail(
            "csgc_projection_stream_dictionary_size_mismatch")

    for rank in 0..<state.kindCount:
        let kindIndex = csgProjectionStreamI32Get(
            state, state.kindOrder, rank)
        let payloadOffset = csgProjectionStreamI32Get(
            state, state.kindPayloadOffsets, kindIndex)
        let payloadLength = csgProjectionStreamI32Get(
            state, state.kindPayloadLengths, kindIndex)
        let itemCount = csgProjectionStreamI32Get(
            state, state.kindCounts, kindIndex)
        let start = csgProjectionStreamI32Get(
            state, state.kindStarts, kindIndex)
        cursor = csgc.CsgCoreCsgcHeaderSize + payloadOffset
        csgProjectionStreamWriteU32(bytes, cursor, itemCount)
        cursor = cursor + 4
        for sectionOrdinal in 0..<itemCount:
            let row = csgProjectionStreamI32Get(
                state, state.sectionRows, start + sectionOrdinal)
            var nextOffset: int32
            let emitError = csgProjectionStreamEmitRow(
                state, row, bytes, cursor, nextOffset)
            if emitError.len > 0:
                rawbytes.BytesFree(bytes)
                return csgProjectionStreamFail(emitError)
            cursor = nextOffset
        if cursor != csgc.CsgCoreCsgcHeaderSize +
                         payloadOffset + payloadLength:
            rawbytes.BytesFree(bytes)
            return csgProjectionStreamFail(
                "csgc_projection_stream_section_size_mismatch")

    let dictionaryDigest = csgProjectionStreamSectionDigest(
        bytes,
        csgc.CsgCoreCsgcSectionDictionary,
        "",
        plan.dictionaryCount,
        csgc.CsgCoreCsgcHeaderSize + dictionaryPayloadOffset,
        plan.dictionaryPayloadLength)
    var directoryCursor = csgc.CsgCoreCsgcHeaderSize +
        csgc.CsgCoreCsgcDirectoryPrefixSize
    directoryCursor = csgProjectionStreamWriteSectionEntry(
        bytes,
        directoryCursor,
        csgc.CsgCoreCsgcSectionDictionary,
        "",
        dictionaryPayloadOffset,
        plan.dictionaryPayloadLength,
        plan.dictionaryCount,
        dictionaryDigest)
    for rank in 0..<state.kindCount:
        let kindIndex = csgProjectionStreamI32Get(
            state, state.kindOrder, rank)
        let kind = csgProjectionStreamRegionText(
            state,
            state.kindBytes,
            csgProjectionStreamI32Get(
                state, state.kindOffsets, kindIndex),
            csgProjectionStreamI32Get(
                state, state.kindLengths, kindIndex))
        let payloadOffset = csgProjectionStreamI32Get(
            state, state.kindPayloadOffsets, kindIndex)
        let payloadLength = csgProjectionStreamI32Get(
            state, state.kindPayloadLengths, kindIndex)
        let itemCount = csgProjectionStreamI32Get(
            state, state.kindCounts, kindIndex)
        let digest = csgProjectionStreamSectionDigest(
            bytes,
            csgc.CsgCoreCsgcSectionFactKind,
            kind,
            itemCount,
            csgc.CsgCoreCsgcHeaderSize + payloadOffset,
            payloadLength)
        directoryCursor = csgProjectionStreamWriteSectionEntry(
            bytes,
            directoryCursor,
            csgc.CsgCoreCsgcSectionFactKind,
            kind,
            payloadOffset,
            payloadLength,
            itemCount,
            digest)
    if directoryCursor !=
       csgc.CsgCoreCsgcHeaderSize + plan.directoryLength:
        rawbytes.BytesFree(bytes)
        return csgProjectionStreamFail(
            "csgc_projection_stream_directory_size_mismatch")

    let claim = csgc.CsgCoreCsgcClaimDirectory(bytes)
    if !claim.ok || claim.factCount != state.factCount ||
       claim.directoryCid.len != 71 ||
       !strings.HasPrefix(claim.directoryCid, "sha256:"):
        rawbytes.BytesFree(bytes)
        return csgProjectionStreamFail(
            "csgc_projection_stream_directory_claim_failed")
    let objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(bytes)
    if objectCid.len != 71 ||
       !strings.HasPrefix(objectCid, "sha256:"):
        rawbytes.BytesFree(bytes)
        return csgProjectionStreamFail(
            "csgc_projection_stream_object_cid_failed")
    var out: CsgCoreCsgcProjectionStreamResult
    out.ok = true
    out.factCount = state.factCount
    out.byteCount = plan.totalLength
    out.directoryCid = strings.CloneStr(claim.directoryCid)
    out.objectCid = strings.CloneStr(objectCid)
    out.bytes = bytes
    return out

@borrows
fn csgProjectionStreamPoisonMappedFail(
        error: str,
        authority: var
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority):
        CsgCoreCsgcProjectionStreamResult =
    let out = csgProjectionStreamFail(error)
    let poisonError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoison(
            authority)
    if poisonError.len > 0:
        panic("csgc_projection_stream_mapped_poison_failed")
    return out

fn csgProjectionStreamPoisonMappedStateFail(
        error: str,
        state: var csgProjectionStreamState,
        authority: var
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority):
        CsgCoreCsgcProjectionStreamResult =
    let out = csgProjectionStreamFail(error)
    let poisonError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoison(
            authority)
    if poisonError.len > 0:
        panic("csgc_projection_stream_mapped_poison_failed")
    csgProjectionStreamDestroy(state)
    return out

fn csgProjectionStreamPoisonCompletionStateFail(
        error: str,
        state: var csgProjectionStreamState,
        completion: var
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority):
        CsgCoreCsgcProjectionStreamResult =
    let out = csgProjectionStreamFail(error)
    let poisonError =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
            completion)
    if poisonError.len > 0:
        panic("csgc_projection_stream_completion_poison_failed")
    csgProjectionStreamDestroy(state)
    return out

@borrows
fn CsgCoreCsgcProjectionStreamMaterialize(
        authority: var
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority,
        factCount: int32,
        expectedCanonicalOrdinal: int32,
        queryKey: str,
        beforeFact: str,
        afterFact: str,
        expectedAfter:
            CsgCoreCsgcProjectionStreamExpectedAfterSemantic):
        CsgCoreCsgcProjectionStreamResult =
    var replacement: csgProjectionStreamReplacement
    let replacementError = csgProjectionStreamValidateReplacement(
        factCount,
        expectedCanonicalOrdinal,
        queryKey,
        beforeFact,
        afterFact,
        replacement)
    if replacementError.len > 0:
        return csgProjectionStreamPoisonMappedFail(
            replacementError, authority)

    var feed: csgProjectionStreamFeedBuffer
    feed.replacementSourceOrdinal = -1
    let feedError = csgProjectionStreamFeedMapped(
        feed,
        authority,
        factCount,
        queryKey,
        beforeFact,
        afterFact,
        replacement)
    if feedError.len > 0:
        return csgProjectionStreamPoisonMappedFail(
            strings.CloneStr(feedError), authority)
    var state: csgProjectionStreamState
    csgProjectionStreamInit(
        state, factCount, feed.lineByteCount, feed.keyByteCount)
    csgProjectionStreamLoadFeed(state, feed)
    let orderError = csgProjectionStreamSortPhysical(state)
    if orderError.len > 0:
        return csgProjectionStreamPoisonMappedStateFail(
            strings.CloneStr(orderError), state, authority)
    if state.replacementCanonicalOrdinal != expectedCanonicalOrdinal:
        return csgProjectionStreamPoisonMappedStateFail(
            "csgc_projection_stream_replacement_canonical_ordinal_mismatch",
            state,
            authority)

    let finished =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcFinish(
            authority)
    if !finished.ok:
        let out = csgProjectionStreamFail(
            csgProjectionStreamCat(
                "csgc_projection_stream_mapped_finish_failed ",
                finished.error))
        csgProjectionStreamDestroy(state)
        return out
    var completion = finished.authority

    var roots: csgProjectionStreamRootPlan
    let rootError = csgProjectionStreamComputeRoots(
        state, queryKey, replacement, roots)
    if rootError.len > 0:
        return csgProjectionStreamPoisonCompletionStateFail(
            strings.CloneStr(rootError), state, completion)
    let semanticError =
        csgProjectionStreamExpectedAfterSemanticError(
            roots,
            expectedAfter,
            state.factCount,
            state.replacementSourceOrdinal,
            state.replacementCanonicalOrdinal,
            queryKey,
            replacement)
    if semanticError.len > 0:
        return csgProjectionStreamPoisonCompletionStateFail(
            strings.CloneStr(semanticError), state, completion)

    let factPlanError = csgProjectionStreamPlanFacts(state)
    if factPlanError.len > 0:
        return csgProjectionStreamPoisonCompletionStateFail(
            strings.CloneStr(factPlanError), state, completion)
    var plan: csgProjectionStreamPlan
    let dictionaryError =
        csgProjectionStreamAdmitDictionary(state, plan)
    if dictionaryError.len > 0:
        return csgProjectionStreamPoisonCompletionStateFail(
            strings.CloneStr(dictionaryError), state, completion)
    let wirePlanError = csgProjectionStreamPlanWire(state, plan)
    if wirePlanError.len > 0:
        return csgProjectionStreamPoisonCompletionStateFail(
            strings.CloneStr(wirePlanError), state, completion)
    let emitted = csgProjectionStreamEmit(state, plan)
    if !emitted.ok:
        return csgProjectionStreamPoisonCompletionStateFail(
            strings.CloneStr(emitted.error), state, completion)
    var out = emitted
    out.completion = completion
    csgProjectionStreamDestroy(state)
    return out
