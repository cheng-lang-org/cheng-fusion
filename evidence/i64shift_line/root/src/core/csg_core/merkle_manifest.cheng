import std/rawbytes
import std/result
import std/json
import std/seqs
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

const
    CsgMerkleManifestDomain: str = "csg_core.store.manifest"
    CsgMerkleSemanticManifestDomain: str =
        "csg_core.semantic_manifest_skeleton.v1"
    CsgMerkleSchemaNamespace: str = "csg_core::v1"
    CsgMerkleManifestKind: str = "csg.merkle.manifest"
    CsgMerklePartitionKind: str = "csg.merkle.partition"
    CsgMerkleDependencyConsumerShardKind: str = "csg.merkle.dependency_consumer_shard"
    CsgMerkleDependencyProviderShardKind: str = "csg.merkle.dependency_provider_shard"
    CsgMerkleQueryShardKind: str = "csg.merkle.query_shard_descriptor"
    CsgMerkleQueryShardCount: int32 = 256

type
    CsgCoreMerklePartitionRecord =
        sourceId: str
        sourceCid: str
        factKind: str
        factsCid: str
        factsRoot: str
        dagRootCid: str
        membershipCid: str
        factCount: int32

    CsgCoreMerkleShardDescriptor =
        shardKey: str
        cid: str
        root: str
        entryCount: int32

    CsgCoreMerkleManifest =
        standard: str
        profiles: str[]
        profileSetCid: str
        complete: bool
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str
        schemaCid: str
        factsRoot: str
        dagRootCid: str
        factCount: int32
        nodeCount: int32
        partitions: CsgCoreMerklePartitionRecord[]
        partitionRoot: str
        dependencyConsumerShards: CsgCoreMerkleShardDescriptor[]
        dependencyConsumerRoot: str
        dependencyProviderShards: CsgCoreMerkleShardDescriptor[]
        dependencyProviderRoot: str
        dependencyCount: int32
        queryShards: CsgCoreMerkleShardDescriptor[]
        queryShardRoot: str
        queryIndexCount: int32
        summaryCid: str
        unsupportedCount: int32
        tombstoneCount: int32
        runtimeRequirementCount: int32

    CsgCoreMerkleSemanticManifestSkeleton =
        standard: str
        profiles: str[]
        profileSetCid: str
        complete: bool
        schemaCid: str
        factsRoot: str
        dagRootCid: str
        factCount: int32
        nodeCount: int32
        partitions: CsgCoreMerklePartitionRecord[]
        partitionRoot: str
        dependencyConsumerShards: CsgCoreMerkleShardDescriptor[]
        dependencyConsumerRoot: str
        dependencyProviderShards: CsgCoreMerkleShardDescriptor[]
        dependencyProviderRoot: str
        dependencyCount: int32
        queryShards: CsgCoreMerkleShardDescriptor[]
        queryShardRoot: str
        queryIndexCount: int32
        summaryCid: str
        unsupportedCount: int32
        tombstoneCount: int32
        runtimeRequirementCount: int32

    CsgCoreMerkleManifestFinalizeResult =
        ok: bool
        error: str
        manifest: CsgCoreMerkleManifest

    CsgCoreMerkleManifestEncodeResult =
        ok: bool
        error: str
        cid: str
        lines: str[]
        bytes: rawbytes.Bytes

    CsgCoreMerkleManifestDecodeResult =
        ok: bool
        error: str
        cid: str
        manifest: CsgCoreMerkleManifest
        lines: str[]

@borrows
fn csgManifestCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgManifestAppend(out: var str, value: str) =
    out = csgManifestCat(out, value)

@borrows
fn csgManifestJson(value: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(
        value)

@borrows
fn csgManifestTuplePart(value: str): str =
    return csgManifestCat(
        csgManifestCat(
            strings.IntToStr(value.len), ":"),
        value)

@borrows
fn csgManifestTextCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn CsgCoreMerklePartitionClone(
        partition: CsgCoreMerklePartitionRecord):
        CsgCoreMerklePartitionRecord =
    var out: CsgCoreMerklePartitionRecord
    out.sourceId = strings.CloneStr(partition.sourceId)
    out.sourceCid = strings.CloneStr(partition.sourceCid)
    out.factKind = strings.CloneStr(partition.factKind)
    out.factsCid = strings.CloneStr(partition.factsCid)
    out.factsRoot = strings.CloneStr(partition.factsRoot)
    out.dagRootCid = strings.CloneStr(partition.dagRootCid)
    out.membershipCid = strings.CloneStr(partition.membershipCid)
    out.factCount = partition.factCount
    return out

@borrows
fn csgManifestInt32(
        text: str,
        out: var int32): bool =
    return merkle_store_codec.CsgCoreMerkleStoreParseInt32(
        text, out)

@borrows
fn csgManifestStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgManifestStringArray(values: str[]): str =
    var out = "["
    for i in 0..<values.len:
        if i > 0:
            csgManifestAppend(out, ",")
        csgManifestAppend(
            out, csgManifestJson(values[i]))
    csgManifestAppend(out, "]")
    return out

@borrows
fn csgManifestStringArrayField(
        line: str,
        name: str,
        out: var str[]): bool =
    let raw =
        field.CsgCoreJsonTopRawField(line, name)
    if !raw.found:
        return false
    let parsed = json.ParseJsonSafe(raw.value)
    if !parsed.success ||
       parsed.value.kind != json.JArray:
        return false
    for i in 0..<parsed.value.a.len:
        if parsed.value.a[i].kind != json.JString:
            return false
        add(
            out,
            strings.CloneStr(parsed.value.a[i].s))
    return true

@borrows
fn CsgCoreMerklePartitionId(
        partition: CsgCoreMerklePartitionRecord):
        str =
    let pair =
        csgManifestCat(
            csgManifestTuplePart(partition.sourceId),
            csgManifestTuplePart(partition.factKind))
    let digest =
        merkle_dag.CsgCoreMerkleKeyHash(
            csgManifestCat("partition:", pair))
    return csgManifestCat(
        "partition:",
        layout.FixedBytes32Hex(digest))

@borrows
fn CsgCoreMerklePartitionLine(
        partition: CsgCoreMerklePartitionRecord):
        str =
    var out: str = "{\"dag_root_cid\":"
    csgManifestAppend(out, csgManifestJson(partition.dagRootCid))
    csgManifestAppend(out, ",\"fact_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(partition.factCount)))
    csgManifestAppend(out, ",\"fact_kind\":")
    csgManifestAppend(out, csgManifestJson(partition.factKind))
    csgManifestAppend(out, ",\"facts_cid\":")
    csgManifestAppend(out, csgManifestJson(partition.factsCid))
    csgManifestAppend(out, ",\"facts_root\":")
    csgManifestAppend(out, csgManifestJson(partition.factsRoot))
    csgManifestAppend(out, ",\"id\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            CsgCoreMerklePartitionId(partition)))
    csgManifestAppend(
        out,
        ",\"kind\":\"csg.merkle.partition\"")
    csgManifestAppend(out, ",\"membership_cid\":")
    csgManifestAppend(
        out,
        csgManifestJson(partition.membershipCid))
    csgManifestAppend(out, ",\"source_cid\":")
    csgManifestAppend(out, csgManifestJson(partition.sourceCid))
    csgManifestAppend(out, ",\"source_id\":")
    csgManifestAppend(out, csgManifestJson(partition.sourceId))
    csgManifestAppend(out, "}")
    return out

@borrows
fn csgManifestPartitionLines(
        partitions: CsgCoreMerklePartitionRecord[]):
        str[] =
    var out: str[]
    for i in 0..<partitions.len:
        add(
            out,
            CsgCoreMerklePartitionLine(partitions[i]))
    return out

@borrows
fn CsgCoreMerklePartitionRoot(
        partitions: CsgCoreMerklePartitionRecord[]):
        str =
    let dag =
        merkle_dag.CsgCoreMerkleBuild(
            csgManifestPartitionLines(partitions))
    if !dag.ok:
        return csgManifestCat("invalid:", dag.error)
    return strings.CloneStr(dag.subgraphCid)

@borrows
fn csgManifestShardDescriptorId(
        kind: str,
        descriptor: CsgCoreMerkleShardDescriptor):
        str =
    let pair =
        csgManifestCat(
            csgManifestTuplePart(kind),
            csgManifestTuplePart(descriptor.shardKey))
    return csgManifestCat(
        "shard:",
        layout.FixedBytes32Hex(
            merkle_dag.CsgCoreMerkleKeyHash(
                csgManifestCat(
                    "manifest_shard:", pair))))

@borrows
fn CsgCoreMerkleShardDescriptorLine(
        kind: str,
        descriptor: CsgCoreMerkleShardDescriptor):
        str =
    var out: str = "{\"cid\":"
    csgManifestAppend(out, csgManifestJson(descriptor.cid))
    csgManifestAppend(out, ",\"entry_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(descriptor.entryCount)))
    csgManifestAppend(out, ",\"id\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            csgManifestShardDescriptorId(
                kind, descriptor)))
    csgManifestAppend(out, ",\"kind\":")
    csgManifestAppend(out, csgManifestJson(kind))
    csgManifestAppend(out, ",\"root\":")
    csgManifestAppend(out, csgManifestJson(descriptor.root))
    csgManifestAppend(out, ",\"shard_key\":")
    csgManifestAppend(out, csgManifestJson(descriptor.shardKey))
    csgManifestAppend(out, "}")
    return out

@borrows
fn CsgCoreMerkleShardDescriptorRoot(
        kind: str,
        descriptors: CsgCoreMerkleShardDescriptor[]):
        str =
    var lines: str[]
    for i in 0..<descriptors.len:
        add(
            lines,
            CsgCoreMerkleShardDescriptorLine(
                kind, descriptors[i]))
    let dag = merkle_dag.CsgCoreMerkleBuild(lines)
    if !dag.ok:
        return csgManifestCat("invalid:", dag.error)
    return strings.CloneStr(dag.subgraphCid)

fn CsgCoreMerkleDependencyConsumerShardKind(): str =
    return CsgMerkleDependencyConsumerShardKind

fn CsgCoreMerkleDependencyProviderShardKind(): str =
    return CsgMerkleDependencyProviderShardKind

fn CsgCoreMerkleQueryShardKind(): str =
    return CsgMerkleQueryShardKind

fn CsgCoreMerkleQueryShardCount(): int32 =
    return CsgMerkleQueryShardCount

fn CsgCoreMerkleExpectedNodeCount(
        factCount: int32): int32 =
    if factCount < 0 ||
       factCount > int32(1073741824):
        return -1
    if factCount == 0:
        return 0
    return factCount * int32(2) - int32(1)

fn csgManifestQueryBucketName(bucket: int32): str =
    if bucket < 0 || bucket >= CsgMerkleQueryShardCount:
        return ""
    let digits = "0123456789abcdef"
    return csgManifestCat(
        strings.CloneStrRange(
            digits, bucket / 16, 1),
        strings.CloneStrRange(
            digits, bucket % 16, 1))

@borrows
fn csgManifestCloneDescriptor(
        descriptor: CsgCoreMerkleShardDescriptor):
        CsgCoreMerkleShardDescriptor =
    var out: CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(descriptor.shardKey)
    out.cid = strings.CloneStr(descriptor.cid)
    out.root = strings.CloneStr(descriptor.root)
    out.entryCount = descriptor.entryCount
    return out

@borrows
fn CsgCoreMerkleShardDescriptorsSort(
        descriptors: CsgCoreMerkleShardDescriptor[]):
        CsgCoreMerkleShardDescriptor[] =
    var order: int32[]
    var scratch: int32[]
    for i in 0..<descriptors.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgManifestTextCompare(
                        descriptors[order[left]].shardKey,
                        descriptors[order[right]].shardKey) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var out: CsgCoreMerkleShardDescriptor[]
    for i in 0..<order.len:
        add(
            out,
            csgManifestCloneDescriptor(
                descriptors[order[i]]))
    return out

@borrows
fn CsgCoreMerkleShardDescriptorIndex(
        descriptors: CsgCoreMerkleShardDescriptor[],
        shardKey: str): int32 =
    var low: int32
    var high = descriptors.len
    while low < high:
        let middle = low + (high - low) / 2
        let compared =
            csgManifestTextCompare(
                descriptors[middle].shardKey,
                shardKey)
        if compared < 0:
            low = middle + 1
        else:
            high = middle
    if low < descriptors.len &&
       descriptors[low].shardKey == shardKey:
        return low
    return -1

@borrows
fn csgManifestDescriptorSetError(
        kind: str,
        descriptors: CsgCoreMerkleShardDescriptor[]):
        str =
    for i in 0..<descriptors.len:
        let descriptor = descriptors[i]
        if descriptor.shardKey.len == 0 ||
           descriptor.entryCount < 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               descriptor.cid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               descriptor.root):
            return "merkle_manifest_shard_descriptor_invalid"
    if kind == CsgMerkleQueryShardKind:
        if descriptors.len > CsgMerkleQueryShardCount:
            return "merkle_manifest_query_shard_count_invalid"
        for i in 0..<descriptors.len:
            /* Two lowercase hex digits exactly; sparse manifests keep
               only a sorted subset of the 256 possible buckets. */
            if descriptors[i].shardKey.len != 2:
                return "merkle_manifest_query_shard_bucket_invalid"
            for c in 0..<descriptors[i].shardKey.len:
                let ch = descriptors[i].shardKey[c]
                if (ch < '0' || ch > '9') &&
                   (ch < 'a' || ch > 'f'):
                    return "merkle_manifest_query_shard_bucket_invalid"
    for i in 1..<descriptors.len:
        let compared =
            csgManifestTextCompare(
                descriptors[i - 1].shardKey,
                descriptors[i].shardKey)
        if compared == 0:
            return "merkle_manifest_shard_descriptor_duplicate"
        if compared > 0:
            return "merkle_manifest_shard_descriptor_non_canonical_order"
    if kind != CsgMerkleQueryShardKind &&
       kind != CsgMerkleDependencyConsumerShardKind &&
       kind != CsgMerkleDependencyProviderShardKind:
        return "merkle_manifest_shard_kind_invalid"
    return ""

@borrows
fn csgManifestSourcePresent(
        partitions: CsgCoreMerklePartitionRecord[],
        sourceId: str): bool =
    for i in 0..<partitions.len:
        if partitions[i].sourceId == sourceId:
            return true
    return false

@borrows
fn csgManifestSourceCount(
        partitions: CsgCoreMerklePartitionRecord[]):
        int32 =
    var count: int32
    for i in 0..<partitions.len:
        var first = true
        for previous in 0..<i:
            if partitions[previous].sourceId ==
               partitions[i].sourceId:
                first = false
        if first:
            count = count + 1
    return count

@borrows
fn csgManifestDescriptorEntryCount(
        descriptors: CsgCoreMerkleShardDescriptor[]):
        int64 =
    var out: int64
    for i in 0..<descriptors.len:
        out = out + int64(descriptors[i].entryCount)
    return out

@borrows
fn csgManifestHeaderLine(
        manifest: CsgCoreMerkleManifest): str =
    var out: str = "{\"complete\":\"1\""
    csgManifestAppend(out, ",\"csgc_byte_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.csgcByteCount)))
    csgManifestAppend(out, ",\"csgc_directory_cid\":")
    csgManifestAppend(
        out, csgManifestJson(manifest.csgcDirectoryCid))
    csgManifestAppend(out, ",\"csgc_object_cid\":")
    csgManifestAppend(
        out, csgManifestJson(manifest.csgcObjectCid))
    csgManifestAppend(out, ",\"dag_root_cid\":")
    csgManifestAppend(out, csgManifestJson(manifest.dagRootCid))
    csgManifestAppend(
        out, ",\"dependency_consumer_root\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            manifest.dependencyConsumerRoot))
    csgManifestAppend(
        out, ",\"dependency_consumer_shard_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(
                manifest.dependencyConsumerShards.len)))
    csgManifestAppend(out, ",\"dependency_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.dependencyCount)))
    csgManifestAppend(
        out, ",\"dependency_provider_root\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            manifest.dependencyProviderRoot))
    csgManifestAppend(
        out, ",\"dependency_provider_shard_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(
                manifest.dependencyProviderShards.len)))
    csgManifestAppend(out, ",\"fact_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(strings.IntToStr(manifest.factCount)))
    csgManifestAppend(out, ",\"facts_root\":")
    csgManifestAppend(out, csgManifestJson(manifest.factsRoot))
    csgManifestAppend(out, ",\"id\":\"manifest\"")
    csgManifestAppend(
        out, ",\"kind\":\"csg.merkle.manifest\"")
    csgManifestAppend(out, ",\"node_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(strings.IntToStr(manifest.nodeCount)))
    csgManifestAppend(out, ",\"partition_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.partitions.len)))
    csgManifestAppend(out, ",\"partition_root\":")
    csgManifestAppend(
        out, csgManifestJson(manifest.partitionRoot))
    csgManifestAppend(out, ",\"profile_set_cid\":")
    csgManifestAppend(
        out, csgManifestJson(manifest.profileSetCid))
    csgManifestAppend(out, ",\"profiles\":")
    csgManifestAppend(
        out, csgManifestStringArray(manifest.profiles))
    csgManifestAppend(out, ",\"query_index_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.queryIndexCount)))
    csgManifestAppend(out, ",\"query_shard_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.queryShards.len)))
    csgManifestAppend(out, ",\"query_shard_root\":")
    csgManifestAppend(
        out, csgManifestJson(manifest.queryShardRoot))
    csgManifestAppend(
        out, ",\"runtime_requirement_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(
                manifest.runtimeRequirementCount)))
    csgManifestAppend(out, ",\"schema_cid\":")
    csgManifestAppend(out, csgManifestJson(manifest.schemaCid))
    csgManifestAppend(out, ",\"standard\":")
    csgManifestAppend(out, csgManifestJson(manifest.standard))
    csgManifestAppend(out, ",\"summary_cid\":")
    csgManifestAppend(out, csgManifestJson(manifest.summaryCid))
    csgManifestAppend(out, ",\"tombstone_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.tombstoneCount)))
    csgManifestAppend(out, ",\"unsupported_count\":")
    csgManifestAppend(
        out,
        csgManifestJson(
            strings.IntToStr(manifest.unsupportedCount)))
    csgManifestAppend(out, "}")
    return out

@borrows
fn csgMerkleManifestError(
        manifest: CsgCoreMerkleManifest,
        requireProjection: bool): str =
    if manifest.standard !=
       validator.CsgCoreStandardIdentity():
        return "merkle_manifest_standard_invalid"
    let profileError =
        validator.CsgCoreProfilesCanonicalError(
            manifest.profiles)
    if profileError.len > 0:
        return csgManifestCat(
            "merkle_manifest_profiles ",
            profileError)
    if manifest.profileSetCid !=
       validator.CsgCoreProfileSetCid(
           manifest.profiles):
        return "merkle_manifest_profile_set_cid_mismatch"
    if !manifest.complete ||
       manifest.unsupportedCount != 0 ||
       manifest.tombstoneCount != 0 ||
       manifest.runtimeRequirementCount != 0:
        return "merkle_manifest_production_admission_failed"
    if (requireProjection && manifest.csgcByteCount < 64) ||
       manifest.factCount < 0 ||
       manifest.nodeCount < 0 ||
       manifest.dependencyCount < 0 ||
       manifest.queryIndexCount < 0:
        return "merkle_manifest_count_invalid"
    if (requireProjection &&
        (!merkle_store_codec.CsgCoreMerkleStoreCidValid(
             manifest.csgcDirectoryCid) ||
         !merkle_store_codec.CsgCoreMerkleStoreCidValid(
             manifest.csgcObjectCid))) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.schemaCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.dagRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.partitionRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.dependencyConsumerRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.dependencyProviderRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.queryShardRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.summaryCid):
        return "merkle_manifest_cid_invalid"
    var rootError: str
    let globalSubgraphCid =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            manifest.factCount,
            manifest.dagRootCid,
            rootError)
    if rootError.len > 0:
        return "merkle_manifest_dag_root_mismatch"
    let expectedFactsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            manifest.standard,
            manifest.profiles,
            CsgMerkleSchemaNamespace,
            manifest.schemaCid,
            globalSubgraphCid,
            rootError)
    if rootError.len > 0 ||
       expectedFactsRoot != manifest.factsRoot:
        return "merkle_manifest_facts_root_mismatch"

    var partitionFactCount: int64
    for i in 0..<manifest.partitions.len:
        let partition = manifest.partitions[i]
        if partition.sourceId.len == 0 ||
           partition.factKind.len == 0 ||
           partition.factCount <= 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               partition.sourceCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               partition.factsCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               partition.factsRoot) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               partition.dagRootCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               partition.membershipCid):
            return "merkle_manifest_partition_invalid"
        var partitionRootError: str
        let expectedPartitionSubgraphCid =
            merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
                partition.factCount,
                partition.dagRootCid,
                partitionRootError)
        if partitionRootError.len > 0 ||
           expectedPartitionSubgraphCid !=
               partition.factsRoot:
            return "merkle_manifest_partition_subgraph_cid_mismatch"
        let identity =
            CsgCoreMerklePartitionId(partition)
        for previous in 0..<i:
            if CsgCoreMerklePartitionId(
                   manifest.partitions[previous]) ==
               identity:
                return "merkle_manifest_partition_duplicate"
        partitionFactCount =
            partitionFactCount +
            int64(partition.factCount)
    if partitionFactCount != int64(manifest.factCount):
        return "merkle_manifest_partition_fact_count_mismatch"
    if manifest.factCount > 0 &&
       manifest.partitions.len == 0:
        return "merkle_manifest_nonempty_objects_missing"
    if manifest.factCount == 0 &&
       manifest.partitions.len != 0:
        return "merkle_manifest_empty_objects_present"
    let expectedNodeCount =
        CsgCoreMerkleExpectedNodeCount(
            manifest.factCount)
    if expectedNodeCount < 0:
        return "merkle_manifest_fact_count_overflow"
    if manifest.nodeCount != expectedNodeCount:
        return "merkle_manifest_node_count_mismatch"
    if CsgCoreMerklePartitionRoot(
           manifest.partitions) !=
       manifest.partitionRoot:
        return "merkle_manifest_partition_root_mismatch"

    let consumerError =
        csgManifestDescriptorSetError(
            CsgMerkleDependencyConsumerShardKind,
            manifest.dependencyConsumerShards)
    if consumerError.len > 0:
        return consumerError
    let providerError =
        csgManifestDescriptorSetError(
            CsgMerkleDependencyProviderShardKind,
            manifest.dependencyProviderShards)
    if providerError.len > 0:
        return providerError
    let queryError =
        csgManifestDescriptorSetError(
            CsgMerkleQueryShardKind,
            manifest.queryShards)
    if queryError.len > 0:
        return queryError
    let sourceCount =
        csgManifestSourceCount(manifest.partitions)
    if manifest.dependencyConsumerShards.len !=
           sourceCount ||
       manifest.dependencyProviderShards.len !=
           sourceCount:
        return "merkle_manifest_dependency_shard_source_count_mismatch"
    for i in 0..<manifest.dependencyConsumerShards.len:
        let source =
            manifest.dependencyConsumerShards[i].shardKey
        if !csgManifestSourcePresent(
               manifest.partitions, source) ||
           CsgCoreMerkleShardDescriptorIndex(
               manifest.dependencyProviderShards,
               source) < 0:
            return "merkle_manifest_dependency_shard_source_mismatch"
    let consumerEntries =
        csgManifestDescriptorEntryCount(
            manifest.dependencyConsumerShards)
    let providerEntries =
        csgManifestDescriptorEntryCount(
            manifest.dependencyProviderShards)
    if consumerEntries != providerEntries ||
       consumerEntries != int64(manifest.dependencyCount):
        return "merkle_manifest_dependency_projection_count_mismatch"
    if csgManifestDescriptorEntryCount(
           manifest.queryShards) !=
       int64(manifest.queryIndexCount):
        return "merkle_manifest_query_count_mismatch"
    if CsgCoreMerkleShardDescriptorRoot(
           CsgMerkleDependencyConsumerShardKind,
           manifest.dependencyConsumerShards) !=
       manifest.dependencyConsumerRoot:
        return "merkle_manifest_dependency_consumer_root_mismatch"
    if CsgCoreMerkleShardDescriptorRoot(
           CsgMerkleDependencyProviderShardKind,
           manifest.dependencyProviderShards) !=
       manifest.dependencyProviderRoot:
        return "merkle_manifest_dependency_provider_root_mismatch"
    if CsgCoreMerkleShardDescriptorRoot(
           CsgMerkleQueryShardKind,
           manifest.queryShards) !=
       manifest.queryShardRoot:
        return "merkle_manifest_query_shard_root_mismatch"
    if requireProjection && manifest.factCount == 0:
        let emptyDag = merkle_dag.CsgCoreMerkleBuild([])
        if !emptyDag.ok ||
           manifest.dagRootCid !=
               merkle_dag.CsgCoreMerkleDagRootCid(
                   emptyDag):
            return "merkle_manifest_empty_root_mismatch"
    return ""

@borrows
fn CsgCoreMerkleManifestError(
        manifest: CsgCoreMerkleManifest): str =
    return csgMerkleManifestError(manifest, true)

@borrows
fn csgManifestFromSkeleton(
        skeleton: CsgCoreMerkleSemanticManifestSkeleton):
        CsgCoreMerkleManifest =
    var out: CsgCoreMerkleManifest
    out.standard = strings.CloneStr(skeleton.standard)
    out.profiles = validator.CsgCoreProfilesClone(skeleton.profiles)
    out.profileSetCid = strings.CloneStr(skeleton.profileSetCid)
    out.complete = skeleton.complete
    out.schemaCid = strings.CloneStr(skeleton.schemaCid)
    out.factsRoot = strings.CloneStr(skeleton.factsRoot)
    out.dagRootCid = strings.CloneStr(skeleton.dagRootCid)
    out.factCount = skeleton.factCount
    out.nodeCount = skeleton.nodeCount
    for i in 0..<skeleton.partitions.len:
        add(
            out.partitions,
            CsgCoreMerklePartitionClone(skeleton.partitions[i]))
    out.partitionRoot = strings.CloneStr(skeleton.partitionRoot)
    for i in 0..<skeleton.dependencyConsumerShards.len:
        add(
            out.dependencyConsumerShards,
            csgManifestCloneDescriptor(
                skeleton.dependencyConsumerShards[i]))
    out.dependencyConsumerRoot =
        strings.CloneStr(skeleton.dependencyConsumerRoot)
    for i in 0..<skeleton.dependencyProviderShards.len:
        add(
            out.dependencyProviderShards,
            csgManifestCloneDescriptor(
                skeleton.dependencyProviderShards[i]))
    out.dependencyProviderRoot =
        strings.CloneStr(skeleton.dependencyProviderRoot)
    out.dependencyCount = skeleton.dependencyCount
    for i in 0..<skeleton.queryShards.len:
        add(
            out.queryShards,
            csgManifestCloneDescriptor(skeleton.queryShards[i]))
    out.queryShardRoot = strings.CloneStr(skeleton.queryShardRoot)
    out.queryIndexCount = skeleton.queryIndexCount
    out.summaryCid = strings.CloneStr(skeleton.summaryCid)
    out.unsupportedCount = skeleton.unsupportedCount
    out.tombstoneCount = skeleton.tombstoneCount
    out.runtimeRequirementCount = skeleton.runtimeRequirementCount
    return out

@borrows
fn CsgCoreMerkleSemanticManifestSkeletonError(
        skeleton: CsgCoreMerkleSemanticManifestSkeleton): str =
    if skeleton.factCount <= 0:
        return "merkle_semantic_manifest_replace_count_invalid"
    let manifest = csgManifestFromSkeleton(skeleton)
    return csgMerkleManifestError(manifest, false)

fn csgManifestSemanticAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgManifestSemanticAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgManifestSemanticAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

@borrows
fn CsgCoreMerkleSemanticManifestSkeletonCid(
        skeleton: CsgCoreMerkleSemanticManifestSkeleton): str =
    if CsgCoreMerkleSemanticManifestSkeletonError(
           skeleton).len > 0:
        return "invalid:merkle_semantic_manifest_skeleton"
    var preimage = layout.ByteBufInit(4096)
    csgManifestSemanticAppendText(
        preimage, CsgMerkleSemanticManifestDomain)
    csgManifestSemanticAppendText(preimage, skeleton.standard)
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.profiles.len))
    for i in 0..<skeleton.profiles.len:
        csgManifestSemanticAppendText(preimage, skeleton.profiles[i])
    csgManifestSemanticAppendText(preimage, skeleton.profileSetCid)
    csgManifestSemanticAppendText(
        preimage, skeleton.complete ? "1" : "0")
    csgManifestSemanticAppendText(preimage, skeleton.schemaCid)
    csgManifestSemanticAppendText(preimage, skeleton.factsRoot)
    csgManifestSemanticAppendText(preimage, skeleton.dagRootCid)
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.factCount))
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.nodeCount))
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.partitions.len))
    for i in 0..<skeleton.partitions.len:
        csgManifestSemanticAppendText(
            preimage,
            CsgCoreMerklePartitionLine(skeleton.partitions[i]))
    csgManifestSemanticAppendText(preimage, skeleton.partitionRoot)
    csgManifestSemanticAppendText(
        preimage,
        strings.IntToStr(skeleton.dependencyConsumerShards.len))
    for i in 0..<skeleton.dependencyConsumerShards.len:
        csgManifestSemanticAppendText(
            preimage,
            CsgCoreMerkleShardDescriptorLine(
                CsgMerkleDependencyConsumerShardKind,
                skeleton.dependencyConsumerShards[i]))
    csgManifestSemanticAppendText(
        preimage, skeleton.dependencyConsumerRoot)
    csgManifestSemanticAppendText(
        preimage,
        strings.IntToStr(skeleton.dependencyProviderShards.len))
    for i in 0..<skeleton.dependencyProviderShards.len:
        csgManifestSemanticAppendText(
            preimage,
            CsgCoreMerkleShardDescriptorLine(
                CsgMerkleDependencyProviderShardKind,
                skeleton.dependencyProviderShards[i]))
    csgManifestSemanticAppendText(
        preimage, skeleton.dependencyProviderRoot)
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.dependencyCount))
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.queryShards.len))
    for i in 0..<skeleton.queryShards.len:
        csgManifestSemanticAppendText(
            preimage,
            CsgCoreMerkleShardDescriptorLine(
                CsgMerkleQueryShardKind,
                skeleton.queryShards[i]))
    csgManifestSemanticAppendText(preimage, skeleton.queryShardRoot)
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.queryIndexCount))
    csgManifestSemanticAppendText(preimage, skeleton.summaryCid)
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.unsupportedCount))
    csgManifestSemanticAppendText(
        preimage, strings.IntToStr(skeleton.tombstoneCount))
    csgManifestSemanticAppendText(
        preimage,
        strings.IntToStr(skeleton.runtimeRequirementCount))
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return csgManifestCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgManifestFinalizeProjectionChecked(
        skeleton: CsgCoreMerkleSemanticManifestSkeleton,
        projection: csgc.CsgCoreCsgcProjectionReceipt):
        CsgCoreMerkleManifestFinalizeResult =
    var out: CsgCoreMerkleManifestFinalizeResult
    let skeletonError =
        CsgCoreMerkleSemanticManifestSkeletonError(skeleton)
    if skeletonError.len > 0:
        out.error = strings.CloneStr(skeletonError)
        return out
    if projection.sourceFactsRoot != skeleton.factsRoot ||
       projection.factCount != skeleton.factCount:
        out.error = "merkle_manifest_projection_semantic_mismatch"
        return out
    let objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            projection.bytes)
    if objectCid != projection.objectCid:
        out.error = "merkle_manifest_projection_object_cid_mismatch"
        return out
    var manifest = csgManifestFromSkeleton(skeleton)
    manifest.csgcByteCount = projection.byteCount
    manifest.csgcDirectoryCid =
        strings.CloneStr(projection.directoryCid)
    manifest.csgcObjectCid = strings.CloneStr(projection.objectCid)
    let manifestError = CsgCoreMerkleManifestError(manifest)
    if manifestError.len > 0:
        out.error = strings.CloneStr(manifestError)
        return out
    out.ok = true
    out.manifest = manifest
    return out

@borrows
fn CsgCoreMerkleManifestFinalizeProjection(
        skeleton: CsgCoreMerkleSemanticManifestSkeleton,
        projection: csgc.CsgCoreCsgcProjectionReceipt):
        CsgCoreMerkleManifestFinalizeResult =
    let projectionError =
        csgc.CsgCoreCsgcProjectionReceiptError(projection)
    if projectionError.len > 0:
        var out: CsgCoreMerkleManifestFinalizeResult
        out.error = strings.CloneStr(projectionError)
        return out
    return csgManifestFinalizeProjectionChecked(
        skeleton, projection)

@borrows
fn CsgCoreMerkleManifestFinalizeVerifiedProjection(
        skeleton: CsgCoreMerkleSemanticManifestSkeleton,
        projection: csgc.CsgCoreCsgcProjectionReceipt):
        CsgCoreMerkleManifestFinalizeResult =
    let projectionError =
        csgc.CsgCoreCsgcProjectionReceiptStructuralError(
            projection)
    if projectionError.len > 0:
        var out: CsgCoreMerkleManifestFinalizeResult
        out.error = strings.CloneStr(projectionError)
        return out
    return csgManifestFinalizeProjectionChecked(
        skeleton, projection)

@borrows
fn csgManifestEnvelopeObjectFieldIndex(
        value: json.JsonNode,
        key: str): int32 =
    if value.kind != json.JObject ||
       value.okeys.len != value.ovalues.len:
        return -1
    for index in 0..<value.okeys.len:
        if value.okeys[index] == key:
            return index
    return -1

@borrows
fn csgManifestEnvelopeStringField(
        value: json.JsonNode,
        key: str,
        out: var str): bool =
    let index = csgManifestEnvelopeObjectFieldIndex(value, key)
    if index < 0 || value.ovalues[index].kind != json.JString:
        return false
    out = value.ovalues[index].s
    return true

@borrows
fn csgManifestCompilerSnapshotEnvelopeExpectedKindsInto(
        manifest: CsgCoreMerkleManifest,
        decodedLines: str[],
        expectedKinds: var str[]): bool =
    expectedKinds = []
    if decodedLines.len != 2:
        return false
    if manifest.standard != validator.CsgCoreStandardIdentity() ||
       manifest.profiles.len != 1 ||
       manifest.profiles[0] != validator.CsgCoreBaseProfileIdentity() ||
       manifest.profileSetCid !=
           validator.CsgCoreProfileSetCidForIdentity(
               manifest.standard,
               CsgMerkleSchemaNamespace,
               manifest.profiles) ||
       manifest.factCount != 2 || manifest.partitions.len != 2:
        return false
    let expectedSchemaLine =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var schemaLineIndex: int32 = -1
    var dataLineIndex: int32 = -1
    for lineIndex in 0..<decodedLines.len:
        let factKind = field.CsgCoreJsonKind(decodedLines[lineIndex])
        if factKind.found && factKind.value == "csg.core.schema":
            if schemaLineIndex >= 0:
                return false
            schemaLineIndex = lineIndex
        elif factKind.found && factKind.value == "csg.data":
            if dataLineIndex >= 0:
                return false
            dataLineIndex = lineIndex
    if schemaLineIndex < 0 || dataLineIndex < 0 ||
       decodedLines[schemaLineIndex] != expectedSchemaLine:
        return false
    let parsed = json.ParseJsonSafe(decodedLines[dataLineIndex])
    if !parsed.success || parsed.value.kind != json.JObject ||
       parsed.value.okeys.len != 4 ||
       parsed.value.okeys[0] != "dataKind" ||
       parsed.value.okeys[1] != "id" ||
       parsed.value.okeys[2] != "kind" ||
       parsed.value.okeys[3] != "value":
        return false
    var dataKind: str
    var id: str
    var kind: str
    if !csgManifestEnvelopeStringField(
           parsed.value, "dataKind", dataKind) ||
       dataKind != "compiler_snapshot_head" ||
       !csgManifestEnvelopeStringField(parsed.value, "id", id) ||
       id != "csg_core::compiler_snapshot_head" ||
       !csgManifestEnvelopeStringField(parsed.value, "kind", kind) ||
       kind != "csg.data":
        return false
    let valueIndex =
        csgManifestEnvelopeObjectFieldIndex(parsed.value, "value")
    if valueIndex < 0 ||
       parsed.value.ovalues[valueIndex].kind != json.JObject:
        return false
    let value = parsed.value.ovalues[valueIndex]
    let valueKeys = [
        "cargoByteCount",
        "cargoCallRootCid",
        "cargoCid",
        "cargoDagRootCid",
        "cargoDependencyRootCid",
        "cargoFactsRoot",
        "cargoFactsSubgraphCid",
        "cargoLayoutRootCid",
        "cargoLifecycleRootCid",
        "cargoOwnershipRootCid",
        "cargoParserRootCid",
        "cargoProfileSetCid",
        "cargoProfiles",
        "cargoReachabilityRootCid",
        "cargoReadSetRootCid",
        "cargoSchemaCid",
        "cargoSchemaNamespace",
        "cargoStandard",
        "cargoStoreCsgcObjectCid",
        "cargoStoreHeadCid",
        "cargoStoreIdentityCid",
        "cargoStoreManifestCid",
        "cargoStoreReceiptCid",
        "cargoTypeRootCid",
        "envelopeSourceId",
        "executionCid",
        "identityCid",
        "originCid",
        "originKind",
        "previousEnvelopeHeadCid",
        "previousEnvelopeReceiptCid",
        "semanticEpoch",
        "snapshotPredecessorReceiptCid",
        "snapshotSchemaVersion",
        "sourceBundleCid",
        "sourceIdentityReceiptCid",
        "subject",
        "worldHeadCid"]
    if value.okeys.len != valueKeys.len:
        return false
    for index in 0..<valueKeys.len:
        if value.okeys[index] != valueKeys[index]:
            return false
    let cidKeys = [
        "cargoCallRootCid",
        "cargoCid",
        "cargoDagRootCid",
        "cargoDependencyRootCid",
        "cargoFactsRoot",
        "cargoFactsSubgraphCid",
        "cargoLayoutRootCid",
        "cargoLifecycleRootCid",
        "cargoOwnershipRootCid",
        "cargoParserRootCid",
        "cargoProfileSetCid",
        "cargoReachabilityRootCid",
        "cargoReadSetRootCid",
        "cargoSchemaCid",
        "cargoStoreCsgcObjectCid",
        "cargoStoreHeadCid",
        "cargoStoreIdentityCid",
        "cargoStoreManifestCid",
        "cargoStoreReceiptCid",
        "cargoTypeRootCid",
        "envelopeSourceId",
        "executionCid",
        "identityCid",
        "originCid",
        "previousEnvelopeHeadCid",
        "previousEnvelopeReceiptCid",
        "snapshotPredecessorReceiptCid",
        "sourceBundleCid",
        "sourceIdentityReceiptCid",
        "worldHeadCid"]
    for index in 0..<cidKeys.len:
        var cid: str
        if !csgManifestEnvelopeStringField(value, cidKeys[index], cid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(cid):
            return false
    let byteCountIndex =
        csgManifestEnvelopeObjectFieldIndex(value, "cargoByteCount")
    let originKindIndex =
        csgManifestEnvelopeObjectFieldIndex(value, "originKind")
    let semanticEpochIndex =
        csgManifestEnvelopeObjectFieldIndex(value, "semanticEpoch")
    let schemaVersionIndex =
        csgManifestEnvelopeObjectFieldIndex(value, "snapshotSchemaVersion")
    if byteCountIndex < 0 || originKindIndex < 0 ||
       semanticEpochIndex < 0 || schemaVersionIndex < 0 ||
       value.ovalues[byteCountIndex].kind != json.JInt ||
       value.ovalues[byteCountIndex].i <= int64(0) ||
       value.ovalues[originKindIndex].kind != json.JInt ||
       (value.ovalues[originKindIndex].i != int64(1) &&
        value.ovalues[originKindIndex].i != int64(2)) ||
       value.ovalues[semanticEpochIndex].kind != json.JInt ||
       value.ovalues[semanticEpochIndex].i <= int64(0) ||
       value.ovalues[schemaVersionIndex].kind != json.JInt ||
       value.ovalues[schemaVersionIndex].i <= int64(0):
        return false
    var subject: str
    var cargoStandard: str
    var cargoSchemaNamespace: str
    var cargoProfileSetCid: str
    var envelopeSourceId: str
    if !csgManifestEnvelopeStringField(value, "subject", subject) ||
       subject != "csg_core::compiler_snapshot_head" ||
       !csgManifestEnvelopeStringField(
           value, "cargoStandard", cargoStandard) ||
       cargoStandard != validator.CsgCoreStandardIdentity() ||
       !csgManifestEnvelopeStringField(
           value, "cargoSchemaNamespace", cargoSchemaNamespace) ||
       cargoSchemaNamespace != CsgMerkleSchemaNamespace ||
       !csgManifestEnvelopeStringField(
           value, "cargoProfileSetCid", cargoProfileSetCid) ||
       !csgManifestEnvelopeStringField(
           value, "envelopeSourceId", envelopeSourceId):
        return false
    let cargoProfilesIndex =
        csgManifestEnvelopeObjectFieldIndex(value, "cargoProfiles")
    if cargoProfilesIndex < 0 ||
       value.ovalues[cargoProfilesIndex].kind != json.JArray ||
       value.ovalues[cargoProfilesIndex].a.len != 2 ||
       value.ovalues[cargoProfilesIndex].a[0].kind != json.JString ||
       value.ovalues[cargoProfilesIndex].a[0].s !=
           validator.CsgCoreBaseProfileIdentity() ||
       value.ovalues[cargoProfilesIndex].a[1].kind != json.JString ||
       value.ovalues[cargoProfilesIndex].a[1].s !=
           "csg_dialect::cheng_compiler":
        return false
    var cargoProfiles: str[]
    add(cargoProfiles, strings.CloneStr(
        value.ovalues[cargoProfilesIndex].a[0].s))
    add(cargoProfiles, strings.CloneStr(
        value.ovalues[cargoProfilesIndex].a[1].s))
    let cargoProfileSetValid =
        cargoProfileSetCid ==
            validator.CsgCoreProfileSetCidForIdentity(
                cargoStandard,
                cargoSchemaNamespace,
                cargoProfiles)
    seqs.freeSeqStrRelease(cargoProfiles)
    if !cargoProfileSetValid:
        return false
    if manifest.partitions[0].sourceId != envelopeSourceId ||
       manifest.partitions[1].sourceId != envelopeSourceId ||
       manifest.partitions[0].sourceCid !=
           manifest.partitions[1].sourceCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.partitions[0].sourceId) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           manifest.partitions[0].sourceCid) ||
       manifest.partitions[0].factKind != "csg.core.schema" ||
       manifest.partitions[1].factKind != "csg.data" ||
       manifest.partitions[0].factCount != 1 ||
       manifest.partitions[1].factCount != 1:
        return false
    add(expectedKinds, "csg.core.schema")
    add(expectedKinds, "csg.data")
    return true

@borrows
fn csgManifestCanonicalCsgcBindingError(
        manifest: CsgCoreMerkleManifest,
        csgcBytes: rawbytes.Bytes,
        directoryCid: var str,
        objectCid: var str,
        byteCount: var int32): str =
    directoryCid = ""
    objectCid = ""
    byteCount = rawbytes.BytesLen(csgcBytes)
    if byteCount < 64:
        return "merkle_manifest_csgc_byte_count_invalid"
    let claim = csgc.CsgCoreCsgcClaimDirectory(csgcBytes)
    if !claim.ok:
        return csgManifestCat(
            "merkle_manifest_csgc_directory ",
            claim.error)
    if claim.factCount != manifest.factCount:
        return "merkle_manifest_csgc_fact_count_mismatch"
    let decoded = csgc.CsgCoreCsgcDecodeLines(csgcBytes)
    if !decoded.ok || decoded.factCount != claim.factCount:
        return "merkle_manifest_csgc_decode_mismatch"
    var dialectErr: str
    var expectedKinds: str[]
    if !csgManifestCompilerSnapshotEnvelopeExpectedKindsInto(
           manifest, decoded.lines, expectedKinds):
        expectedKinds = [
            "csg.core.schema",
            "csg_dialect::cheng_compiler::snapshot",
            "csg_dialect::cheng_compiler::texts",
            "csg_dialect::cheng_compiler::sources",
            "csg_dialect::cheng_compiler::spans",
            "csg_dialect::cheng_compiler::parser_nodes",
            "csg_dialect::cheng_compiler::tokens",
            "csg_dialect::cheng_compiler::parser_sidecars",
            "csg_dialect::cheng_compiler::types",
            "csg_dialect::cheng_compiler::declarations",
            "csg_dialect::cheng_compiler::symbols",
            "csg_dialect::cheng_compiler::annotation_targets",
            "csg_dialect::cheng_compiler::lexical_scopes",
            "csg_dialect::cheng_compiler::functions",
            "csg_dialect::cheng_compiler::extern_functions",
            "csg_dialect::cheng_compiler::read_set",
            "csg_dialect::cheng_compiler::references",
            "csg_dialect::cheng_compiler::calls",
            "csg_dialect::cheng_compiler::layouts",
            "csg_dialect::cheng_compiler::layout_fields",
            "csg_dialect::cheng_compiler::typed_nodes",
            "csg_dialect::cheng_compiler::dependencies",
            "csg_dialect::cheng_compiler::debug_ops",
            "csg_dialect::cheng_compiler::diagnostic_completions",
            "csg_dialect::cheng_compiler::diagnostics"]
    let dialectLines =
        csgc.CsgCoreCsgcRestoreLinesByExpectedKind(
            decoded.lines, expectedKinds, dialectErr)
    if dialectErr != "":
        return "merkle_manifest_csgc_facts_binding_mismatch"
    var dag: merkle_dag.CsgCoreMerkleDag
    let validation =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            dialectLines, dag)
    if !validation.valid || !validation.complete ||
       validation.standard != manifest.standard ||
       !validator.CsgCoreProfilesEqual(
           validation.profiles, manifest.profiles) ||
       validation.profileSetCid != manifest.profileSetCid ||
       validation.factsRoot != manifest.factsRoot ||
       validation.factCount != manifest.factCount ||
       validation.unsupportedCount != 0 ||
       validation.tombstoneCount != 0:
        return "merkle_manifest_csgc_facts_binding_mismatch"
    if !dag.ok || dag.factCount != manifest.factCount ||
       dag.factsRoot != manifest.factsRoot ||
       dag.dagRootCid != manifest.dagRootCid ||
       dag.schemaCid != manifest.schemaCid:
        return "merkle_manifest_csgc_dag_binding_mismatch"
    directoryCid = strings.CloneStr(claim.directoryCid)
    objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            csgcBytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           objectCid):
        return "merkle_manifest_csgc_object_cid_invalid"
    return ""

@borrows
fn CsgCoreMerkleManifestBindCanonicalCsgcDirectory(
        manifest: var CsgCoreMerkleManifest,
        csgcBytes: rawbytes.Bytes): str =
    var directoryCid: str
    var objectCid: str
    var byteCount: int32
    let error =
        csgManifestCanonicalCsgcBindingError(
            manifest,
            csgcBytes,
            directoryCid,
            objectCid,
            byteCount)
    if error.len > 0:
        return error
    manifest.csgcByteCount = byteCount
    manifest.csgcDirectoryCid = directoryCid
    manifest.csgcObjectCid = objectCid
    return ""

@borrows
fn CsgCoreMerkleManifestCanonicalCsgcError(
        manifest: CsgCoreMerkleManifest,
        csgcBytes: rawbytes.Bytes): str =
    var directoryCid: str
    var objectCid: str
    var byteCount: int32
    let error =
        csgManifestCanonicalCsgcBindingError(
            manifest,
            csgcBytes,
            directoryCid,
            objectCid,
            byteCount)
    if error.len > 0:
        return error
    if manifest.csgcByteCount != byteCount:
        return "merkle_manifest_csgc_byte_count_mismatch"
    if manifest.csgcDirectoryCid != directoryCid:
        return "merkle_manifest_csgc_directory_cid_mismatch"
    if manifest.csgcObjectCid != objectCid:
        return "merkle_manifest_csgc_object_cid_mismatch"
    return ""

@borrows
fn csgManifestEncodeFail(
        error: str):
        CsgCoreMerkleManifestEncodeResult =
    var out: CsgCoreMerkleManifestEncodeResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgManifestAppendDescriptorLines(
        lines: var str[],
        kind: str,
        descriptors: CsgCoreMerkleShardDescriptor[]) =
    for i in 0..<descriptors.len:
        add(
            lines,
            CsgCoreMerkleShardDescriptorLine(
                kind, descriptors[i]))

@borrows
fn CsgCoreMerkleManifestEncode(
        manifest: CsgCoreMerkleManifest):
        CsgCoreMerkleManifestEncodeResult =
    let manifestError =
        CsgCoreMerkleManifestError(manifest)
    if manifestError.len > 0:
        return csgManifestEncodeFail(manifestError)
    var lines: str[]
    add(lines, csgManifestHeaderLine(manifest))
    let partitionLines =
        csgManifestPartitionLines(manifest.partitions)
    for i in 0..<partitionLines.len:
        add(
            lines,
            strings.CloneStr(partitionLines[i]))
    csgManifestAppendDescriptorLines(
        lines,
        CsgMerkleDependencyConsumerShardKind,
        manifest.dependencyConsumerShards)
    csgManifestAppendDescriptorLines(
        lines,
        CsgMerkleDependencyProviderShardKind,
        manifest.dependencyProviderShards)
    csgManifestAppendDescriptorLines(
        lines,
        CsgMerkleQueryShardKind,
        manifest.queryShards)
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgManifestEncodeFail(
            csgManifestCat(
                "merkle_manifest_encode ",
                encoded.error))
    let canonical =
        csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !canonical.ok ||
       canonical.lines.len != lines.len:
        rawbytes.BytesFree(encoded.bytes)
        return csgManifestEncodeFail(
            "merkle_manifest_encode_self_check")
    var out: CsgCoreMerkleManifestEncodeResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleManifestDomain,
            encoded.bytes)
    out.lines = canonical.lines
    out.bytes = encoded.bytes
    return out

@borrows
fn csgManifestDecodePartition(
        line: str,
        out: var CsgCoreMerklePartitionRecord,
        error: var str): bool =
    var factCountText: str
    var idText: str
    if !csgManifestStringField(
           line, "dag_root_cid", out.dagRootCid) ||
       !csgManifestStringField(
           line, "fact_count", factCountText) ||
       !csgManifestStringField(
           line, "fact_kind", out.factKind) ||
       !csgManifestStringField(
           line, "facts_cid", out.factsCid) ||
       !csgManifestStringField(
           line, "facts_root", out.factsRoot) ||
       !csgManifestStringField(
           line, "id", idText) ||
       !csgManifestStringField(
           line, "membership_cid",
           out.membershipCid) ||
       !csgManifestStringField(
           line, "source_cid", out.sourceCid) ||
       !csgManifestStringField(
           line, "source_id", out.sourceId) ||
       !csgManifestInt32(
           factCountText, out.factCount):
        error = "merkle_manifest_partition_field_invalid"
        return false
    if idText != CsgCoreMerklePartitionId(out) ||
       CsgCoreMerklePartitionLine(out) != line:
        error = "merkle_manifest_partition_non_canonical"
        return false
    return true

@borrows
fn csgManifestDecodeDescriptor(
        line: str,
        kind: str,
        out: var CsgCoreMerkleShardDescriptor,
        error: var str): bool =
    var entryCountText: str
    var idText: str
    if !csgManifestStringField(
           line, "cid", out.cid) ||
       !csgManifestStringField(
           line, "entry_count", entryCountText) ||
       !csgManifestStringField(
           line, "id", idText) ||
       !csgManifestStringField(
           line, "root", out.root) ||
       !csgManifestStringField(
           line, "shard_key", out.shardKey) ||
       !csgManifestInt32(
           entryCountText, out.entryCount):
        error = "merkle_manifest_shard_field_invalid"
        return false
    if idText !=
           csgManifestShardDescriptorId(kind, out) ||
       CsgCoreMerkleShardDescriptorLine(
           kind, out) != line:
        error = "merkle_manifest_shard_non_canonical"
        return false
    return true

@borrows
fn csgManifestDecodeHeader(
        line: str,
        out: var CsgCoreMerkleManifest,
        expectedPartitionCount: var int32,
        expectedConsumerShardCount: var int32,
        expectedProviderShardCount: var int32,
        expectedQueryShardCount: var int32,
        error: var str): bool =
    var completeText: str
    var csgcByteCountText: str
    var consumerCountText: str
    var dependencyCountText: str
    var factCountText: str
    var idText: str
    var nodeCountText: str
    var partitionCountText: str
    var providerCountText: str
    var queryIndexCountText: str
    var queryShardCountText: str
    var runtimeCountText: str
    var tombstoneCountText: str
    var unsupportedCountText: str
    if !csgManifestStringField(
           line, "complete", completeText) ||
       !csgManifestStringField(
           line, "csgc_byte_count",
           csgcByteCountText) ||
       !csgManifestStringField(
           line, "csgc_directory_cid",
           out.csgcDirectoryCid) ||
       !csgManifestStringField(
           line, "csgc_object_cid",
           out.csgcObjectCid) ||
       !csgManifestStringField(
           line, "dag_root_cid", out.dagRootCid) ||
       !csgManifestStringField(
           line, "dependency_consumer_root",
           out.dependencyConsumerRoot) ||
       !csgManifestStringField(
           line, "dependency_consumer_shard_count",
           consumerCountText) ||
       !csgManifestStringField(
           line, "dependency_count",
           dependencyCountText) ||
       !csgManifestStringField(
           line, "dependency_provider_root",
           out.dependencyProviderRoot) ||
       !csgManifestStringField(
           line, "dependency_provider_shard_count",
           providerCountText) ||
       !csgManifestStringField(
           line, "fact_count", factCountText) ||
       !csgManifestStringField(
           line, "facts_root", out.factsRoot) ||
       !csgManifestStringField(
           line, "id", idText) ||
       !csgManifestStringField(
           line, "node_count", nodeCountText) ||
       !csgManifestStringField(
           line, "partition_count",
           partitionCountText) ||
       !csgManifestStringField(
           line, "partition_root",
           out.partitionRoot) ||
       !csgManifestStringField(
           line, "profile_set_cid",
           out.profileSetCid) ||
       !csgManifestStringArrayField(
           line, "profiles", out.profiles) ||
       !csgManifestStringField(
           line, "query_index_count",
           queryIndexCountText) ||
       !csgManifestStringField(
           line, "query_shard_count",
           queryShardCountText) ||
       !csgManifestStringField(
           line, "query_shard_root",
           out.queryShardRoot) ||
       !csgManifestStringField(
           line, "runtime_requirement_count",
           runtimeCountText) ||
       !csgManifestStringField(
           line, "schema_cid", out.schemaCid) ||
       !csgManifestStringField(
           line, "standard", out.standard) ||
       !csgManifestStringField(
           line, "summary_cid", out.summaryCid) ||
       !csgManifestStringField(
           line, "tombstone_count",
           tombstoneCountText) ||
       !csgManifestStringField(
           line, "unsupported_count",
           unsupportedCountText):
        error = "merkle_manifest_header_field_missing"
        return false
    if idText != "manifest" ||
       completeText != "1" ||
       !csgManifestInt32(
           csgcByteCountText,
           out.csgcByteCount) ||
       !csgManifestInt32(
           consumerCountText,
           expectedConsumerShardCount) ||
       !csgManifestInt32(
           dependencyCountText,
           out.dependencyCount) ||
       !csgManifestInt32(
           factCountText, out.factCount) ||
       !csgManifestInt32(
           nodeCountText, out.nodeCount) ||
       !csgManifestInt32(
           partitionCountText,
           expectedPartitionCount) ||
       !csgManifestInt32(
           providerCountText,
           expectedProviderShardCount) ||
       !csgManifestInt32(
           queryIndexCountText,
           out.queryIndexCount) ||
       !csgManifestInt32(
           queryShardCountText,
           expectedQueryShardCount) ||
       !csgManifestInt32(
           runtimeCountText,
           out.runtimeRequirementCount) ||
       !csgManifestInt32(
           tombstoneCountText,
           out.tombstoneCount) ||
       !csgManifestInt32(
           unsupportedCountText,
           out.unsupportedCount):
        error = "merkle_manifest_header_field_invalid"
        return false
    out.complete = true
    return true

@borrows
fn csgManifestDecodeFail(
        error: str):
        CsgCoreMerkleManifestDecodeResult =
    var out: CsgCoreMerkleManifestDecodeResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgManifestHeaderIndex(lines: str[]): int32 =
    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if kind.found &&
           kind.value == CsgMerkleManifestKind:
            return i
    return -1

@borrows
fn CsgCoreMerkleManifestDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleManifestDecodeResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgManifestDecodeFail(
            csgManifestCat(
                "merkle_manifest_decode ",
                decoded.error))
    var manifest: CsgCoreMerkleManifest
    var expectedPartitionCount: int32 = -1
    var expectedConsumerShardCount: int32 = -1
    var expectedProviderShardCount: int32 = -1
    var expectedQueryShardCount: int32 = -1
    var headerCount: int32
    for i in 0..<decoded.lines.len:
        let kind =
            field.CsgCoreJsonKind(decoded.lines[i])
        if !kind.found:
            return csgManifestDecodeFail(
                "merkle_manifest_line_kind_missing")
        if kind.value == CsgMerkleManifestKind:
            if headerCount != 0:
                return csgManifestDecodeFail(
                    "merkle_manifest_header_duplicate")
            var error: str
            if !csgManifestDecodeHeader(
                   decoded.lines[i],
                   manifest,
                   expectedPartitionCount,
                   expectedConsumerShardCount,
                   expectedProviderShardCount,
                   expectedQueryShardCount,
                   error):
                return csgManifestDecodeFail(error)
            headerCount = 1
        elif kind.value == CsgMerklePartitionKind:
            var partition: CsgCoreMerklePartitionRecord
            var error: str
            if !csgManifestDecodePartition(
                   decoded.lines[i],
                   partition,
                   error):
                return csgManifestDecodeFail(error)
            add(manifest.partitions, partition)
        elif kind.value ==
             CsgMerkleDependencyConsumerShardKind:
            var descriptor: CsgCoreMerkleShardDescriptor
            var error: str
            if !csgManifestDecodeDescriptor(
                   decoded.lines[i],
                   kind.value,
                   descriptor,
                   error):
                return csgManifestDecodeFail(error)
            add(
                manifest.dependencyConsumerShards,
                descriptor)
        elif kind.value ==
             CsgMerkleDependencyProviderShardKind:
            var descriptor: CsgCoreMerkleShardDescriptor
            var error: str
            if !csgManifestDecodeDescriptor(
                   decoded.lines[i],
                   kind.value,
                   descriptor,
                   error):
                return csgManifestDecodeFail(error)
            add(
                manifest.dependencyProviderShards,
                descriptor)
        elif kind.value == CsgMerkleQueryShardKind:
            var descriptor: CsgCoreMerkleShardDescriptor
            var error: str
            if !csgManifestDecodeDescriptor(
                   decoded.lines[i],
                   kind.value,
                   descriptor,
                   error):
                return csgManifestDecodeFail(error)
            add(manifest.queryShards, descriptor)
        else:
            return csgManifestDecodeFail(
                "merkle_manifest_line_kind_invalid")
    manifest.dependencyConsumerShards =
        CsgCoreMerkleShardDescriptorsSort(
            manifest.dependencyConsumerShards)
    manifest.dependencyProviderShards =
        CsgCoreMerkleShardDescriptorsSort(
            manifest.dependencyProviderShards)
    manifest.queryShards =
        CsgCoreMerkleShardDescriptorsSort(
            manifest.queryShards)
    if headerCount != 1 ||
       expectedPartitionCount != manifest.partitions.len ||
       expectedConsumerShardCount !=
           manifest.dependencyConsumerShards.len ||
       expectedProviderShardCount !=
           manifest.dependencyProviderShards.len ||
       expectedQueryShardCount !=
           manifest.queryShards.len:
        return csgManifestDecodeFail(
            "merkle_manifest_line_count_mismatch")
    let manifestError =
        CsgCoreMerkleManifestError(manifest)
    if manifestError.len > 0:
        return csgManifestDecodeFail(manifestError)
    let headerIndex =
        csgManifestHeaderIndex(decoded.lines)
    if headerIndex < 0 ||
       csgManifestHeaderLine(manifest) !=
           decoded.lines[headerIndex]:
        return csgManifestDecodeFail(
            "merkle_manifest_header_non_canonical")
    var reencoded =
        CsgCoreMerkleManifestEncode(manifest)
    if !reencoded.ok:
        return csgManifestDecodeFail(reencoded.error)
    if !rawbytes.BytesEqual(bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgManifestDecodeFail(
            "merkle_manifest_non_canonical")
    var out: CsgCoreMerkleManifestDecodeResult
    out.ok = true
    out.cid = strings.CloneStr(reencoded.cid)
    out.manifest = manifest
    out.lines = decoded.lines
    rawbytes.BytesFree(reencoded.bytes)
    return out
