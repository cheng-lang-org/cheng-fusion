import std/os
import std/rawbytes
import std/result
import std/strings
import std/system
import std/tables
import std/crypto/sha256
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_types

const
    CsgCoreCsgcMappedWindowMax = 65536
    CsgCoreCsgcMappedCanonicalReceiptCargoBytes: int32 = 436
    CsgCoreCsgcMappedSectionCountMax = 65536
    CsgCoreCsgcMappedAllocationBackingLimit: uint64 =
        uint64(1073741824)
    CsgCoreCsgcMappedAllocationOwnerDomain: str =
        "csg_core::csgc_mapped_reader"
    CsgCoreCsgcMappedAllocationHardRed = 1
    CsgCoreCsgcMappedAllocationHardRedReason =
        "HARD_RED:reader_entry_is_not_process_preallocation_boundary"
    CsgCoreCsgcMappedCliPreallocationHardRedReason =
        "HARD_RED:dedicated_subprocess_or_cli_preallocation_owner_required"
    CsgCoreCsgcMappedPreopenedTreeHardRedReason =
        "HARD_RED:csgc_mapped_preopened_tree_precedes_runtime_owner"
    CsgCoreCsgcMappedPreopenedRegionHardRedReason =
        "HARD_RED:csgc_mapped_preopened_region_precedes_runtime_owner"
    CsgCoreCsgcMappedPremappedCarrierHardRedReason =
        "HARD_RED:csgc_mapped_premapped_identity_carrier_is_constructible"
    CsgCoreCsgcMappedOwnerBeginHardRedReason =
        "HARD_RED:csgc_mapped_runtime_owner_begin_requires_process_zero_baseline"
    CsgCoreCsgcMappedOwnerCloseHardRedReason =
        "HARD_RED:csgc_mapped_runtime_owner_close_receipt_unavailable"
    CsgCoreCsgcMappedReceiptCargoHardRedReason =
        "HARD_RED:canonical_receipt_cargo_and_native_execution_identity_unavailable"
    CsgCoreCsgcMappedManagedErrorCloseHardRedReason =
        "HARD_RED:managed_error_live_before_owner_close"
    CsgCoreCsgcMappedReceiptMissingCanonicalCargo: str =
        "canonicalReceiptCargoBytes"
    CsgCoreCsgcMappedReceiptMissingNativeExecutionIdentity: str =
        "nativeExecutionIdentityCid"
    CsgCoreCsgcMappedSessionOwnerDomain: str =
        "csg_core::process_entry_session_owner"
    CsgCoreCsgcMappedSessionScopeHardRedReason =
        "HARD_RED:csgc_mapped_session_scope_required_for_detach"
    csgcMappedOpenErrorOwnerBegin: int32 = 1
    csgcMappedOpenErrorTreeOpen: int32 = 2
    csgcMappedOpenErrorMap: int32 = 3
    csgcMappedOpenErrorLength: int32 = 4
    csgcMappedOpenErrorCid: int32 = 5
    csgcMappedOpenErrorDigestBind: int32 = 6
    csgcMappedOpenErrorDigestCount: int32 = 7
    csgcMappedOpenErrorCanonicalMetadata: int32 = 8
    csgcMappedOpenErrorMappingReceipt: int32 = 9
    csgcMappedOpenErrorTreeShape: int32 = 10
    csgcMappedOpenErrorCanonicalObject: int32 = 11

type
    CsgCoreCsgcMappedSection =
        tag: int32
        kindOffset: int64
        kindLength: int32
        payloadOffset: int64
        payloadLength: int32
        itemCount: int32
        digest: layout.FixedBytes32
        digestVerified: bool

    CsgCoreCsgcMappedReader =
        tree: os.AtomicTree
        region: os.ReadOnlyMappedRegion
        byteLength: int64
        headerSize: int32
        flags: int32
        factCount: int32
        bodySize: int32
        directorySize: int32
        sections: CsgCoreCsgcMappedSection[]
        canonicalSealVerified: bool
        canonicalSealFactCount: int32
        canonicalSealSectionCount: int32
        ordinalNext: int32
        ordinalSectionIndex: int32
        ordinalSectionStart: int32
        ordinalLines: str[]
        runtimeOwner: csgCoreCsgcMappedRuntimeOwner

    csgCoreCsgcMappedRuntimeOwner =
        beginAttempted: bool
        active: bool
        mappingReceiptValid: bool
        objectDigestVerified: bool
        objectDigestCount: int32
        verifiedByteLength: int64
        closeAttempted: bool
        closeSucceeded: bool
        sessionScope: bool
        verifiedTreeScope: bool
        ownerGeneration: uint64
        mappingReceipt: system.RuntimeAllocationLedgerReceipt
        closeReceipt: system.RuntimeAllocationLedgerReceipt
        expectedObjectCid: layout.FixedBytes32
        expectedObjectCidValid: bool

    csgCoreCsgcMappedTreeAttempt =
        ok: bool
        tree: os.AtomicTree

    csgCoreCsgcMappedRegionAttempt =
        ok: bool
        region: os.ReadOnlyMappedRegion

    csgCoreCsgcMappedInt64Attempt =
        ok: bool
        value: int64

    csgCoreCsgcMappedBoolAttempt =
        ok: bool

    csgCoreCsgcMappedCidAttempt =
        ok: bool
        value: layout.FixedBytes32

    csgCoreCsgcMappedSnapshotAttempt =
        ok: bool
        receipt: system.RuntimeAllocationLedgerReceipt

    CsgCoreCsgcMappedAllocationReceipt =
        beginAttempted: bool
        ownerActivated: bool
        mappingReceiptValid: bool
        objectDigestVerified: bool
        objectDigestCount: int32
        verifiedByteLength: int64
        closeAttempted: bool
        closeSucceeded: bool
        expectedObjectCid: layout.FixedBytes32
        expectedObjectCidValid: bool
        complete: bool
        active: bool
        closed: bool
        allocationId: uint64
        capabilityGeneration: uint64
        ownerGeneration: uint64
        operation: system.RuntimeAllocationLedgerOperation
        storageKind: system.RuntimeAllocationLedgerStorageKind
        allocationGeneration: uint64
        slabId: uint64
        slabGeneration: uint64
        slabBackingBytes: uint64
        backingDeltaBytes: uint64
        reallocOverlapUsableBytes: uint64
        requestedPayloadBytes: uint64
        usablePayloadBytes: uint64
        headerBytes: uint64
        backingBytes: uint64
        alignmentBytes: uint64
        allocatorLayoutCid: layout.FixedBytes32
        ownerDomainCid: layout.FixedBytes32
        eventChainCid: layout.FixedBytes32
        backingLimit: uint64
        receiptCid: layout.FixedBytes32
        controlPlaneBackingBytes: uint64
        liveBackingBytes: uint64
        peakBackingBytes: uint64
        liveMappedVirtualBytes: uint64
        peakMappedVirtualBytes: uint64
        liveAllocationCount: uint64
        peakAllocationCount: uint64
        liveMappingCount: uint64
        eventIndex: uint64
        liveHandleCount: uint64
        peakHandleCount: uint64
        rawManagedPointerAbaProven: bool
        recursiveLockProven: bool
        ownerDomainCidPresent: bool
        eventChainCidPresent: bool
        canonicalReceiptCargoPresent: bool
        receiptCidRecomputed: bool
        nativeExecutionIdentityPresent: bool
        allocationLedgerProven: bool
        totalHeapBounded: bool
        productionReady: bool
        hardRedCode: int32
        hardRedReason: str

    CsgCoreCsgcMappedSectionInfo =
        index: int32
        tag: int32
        kindByteLength: int32
        payloadByteLength: int32
        itemCount: int32
        digestVerified: bool

    CsgCoreCsgcMappedOrdinalFact =
        ordinal: int32
        line: str
        factDigest: layout.FixedBytes32

    csgCoreCsgcMappedVarint =
        ok: bool
        value: int32
        nextOffset: int64
        error: str

    csgCoreCsgcMappedCompare =
        ok: bool
        order: int32
        error: str

    csgCoreCsgcMappedDecodeNeeds =
        ok: bool
        error: str
        dictionaryRefs: tables.Table[int32]
        resolvedRefs: str[]
        inlineTokens: tables.Table[bool]
        dictionary: str[]

    csgCoreCsgcMappedLinesResult =
        ok: bool
        error: str
        lines: str[]

fn csgcMappedRuntimeCidToFixed(
        cid: system.RuntimeAllocationLedgerCid): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for byteIndex in 0..<32:
        let wordIndex = byteIndex / 8
        var word: uint64
        if wordIndex == 0:
            word = cid.word0
        elif wordIndex == 1:
            word = cid.word1
        elif wordIndex == 2:
            word = cid.word2
        else:
            word = cid.word3
        let shift = uint64((7 - (byteIndex - wordIndex * 8)) * 8)
        out.data[byteIndex] =
            UInt8((word >> shift) & uint64(255))
    return out

fn csgcMappedRuntimeMappingReceipt(
        reader: var CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability): bool =
    if !reader.runtimeOwner.active || reader.byteLength <= int64(0) ||
       !csgcMappedObjectDigestReceiptValid(reader):
        return false
    let snapshot = system.RuntimeAllocationLedgerSessionOwnerSnapshot(
        owner)
    if !snapshot.ok:
        return false
    let receipt = snapshot.receipt
    let valid = !receipt.complete && !receipt.closed &&
        receipt.ownerGeneration ==
            reader.runtimeOwner.ownerGeneration &&
        receipt.liveMappingCount == uint64(1) &&
        receipt.liveMappedVirtualBytes >= uint64(reader.byteLength) &&
        receipt.peakMappedVirtualBytes >=
            receipt.liveMappedVirtualBytes &&
        receipt.eventIndex > uint64(1)
    var state = reader.runtimeOwner
    state.mappingReceipt = receipt
    state.mappingReceiptValid = valid
    reader.runtimeOwner = state
    return valid

fn csgcMappedOwnedScratchAlloc(
        reader: var CsgCoreCsgcMappedReader,
        byteCount: int32): rawbytes.Bytes =
    if byteCount <= 0:
        panic("csgc_mapped_allocation_ledger_scratch_size_invalid")
    var out = rawbytes.BytesAlloc(byteCount)
    if rawbytes.BytesLen(out) != byteCount:
        rawbytes.BytesFree(out)
        panic("csgc_mapped_runtime_owner_scratch_alloc_failed")
    return out

@borrows
fn csgcMappedOwnedScratchAdopt(
        reader: var CsgCoreCsgcMappedReader,
        bytes: rawbytes.Bytes) =
    if rawbytes.BytesLen(bytes) < 0:
        panic("csgc_mapped_runtime_owner_scratch_adopt_invalid")

fn csgcMappedOwnedScratchFree(
        reader: var CsgCoreCsgcMappedReader,
        bytes: var rawbytes.Bytes) =
    let byteCount = rawbytes.BytesLen(bytes)
    if byteCount == 0:
        return
    if byteCount < 0:
        panic("csgc_mapped_runtime_owner_scratch_release_invalid")
    rawbytes.BytesFree(bytes)

fn csgcMappedWindowFree(
        reader: var CsgCoreCsgcMappedReader,
        bytes: var rawbytes.Bytes) =
    let byteCount = rawbytes.BytesLen(bytes)
    if byteCount <= 0:
        panic("csgc_mapped_runtime_owner_window_release_invalid")
    rawbytes.BytesFree(bytes)

fn csgcMappedByteBufInit(
        reader: var CsgCoreCsgcMappedReader,
        requestedCapacity: int32): layout.ByteBuf =
    return layout.ByteBufInit(requestedCapacity)

@borrows
fn csgcMappedByteBufAppendBytes(
        reader: var CsgCoreCsgcMappedReader,
        buffer: var layout.ByteBuf,
        bytes: rawbytes.Bytes) =
    layout.ByteBufAppendBytes(buffer, bytes)

@borrows
fn csgcMappedByteBufToBytes(
        reader: var CsgCoreCsgcMappedReader,
        buffer: layout.ByteBuf): rawbytes.Bytes =
    var out = layout.ByteBufToBytes(buffer)
    return out

fn csgcMappedByteBufFree(
        reader: var CsgCoreCsgcMappedReader,
        buffer: var layout.ByteBuf) =
    layout.ByteBufFree(buffer)

fn csgcMappedReleaseSections(
        reader: var CsgCoreCsgcMappedReader) =
    reader.sections = []

fn csgcMappedReleaseOrdinalLines(
        reader: var CsgCoreCsgcMappedReader) =
    reader.ordinalLines = []

fn csgcMappedInvalidateAuthority(
        reader: var CsgCoreCsgcMappedReader) =
    reader.canonicalSealVerified = false
    reader.canonicalSealFactCount = 0
    reader.canonicalSealSectionCount = 0
    reader.headerSize = 0
    reader.flags = 0
    reader.factCount = 0
    reader.bodySize = 0
    reader.directorySize = 0
    reader.byteLength = int64(0)
    reader.ordinalNext = 0
    reader.ordinalSectionIndex = 0
    reader.ordinalSectionStart = 0
    csgcMappedReleaseOrdinalLines(reader)
    csgcMappedReleaseSections(reader)
    var state = reader.runtimeOwner
    state.mappingReceiptValid = false
    state.objectDigestVerified = false
    state.objectDigestCount = 0
    state.verifiedByteLength = int64(0)
    state.expectedObjectCid = layout.FixedBytes32()
    state.expectedObjectCidValid = false
    state.mappingReceipt = system.RuntimeAllocationLedgerReceipt()
    reader.runtimeOwner = state

fn csgcMappedCloseOsOwners(
        reader: var CsgCoreCsgcMappedReader): bool =
    var ok = true
    if reader.region != os.ReadOnlyMappedRegion(0):
        let closedRegion = os.ReadOnlyMappedRegionClose(reader.region)
        reader.region = os.ReadOnlyMappedRegion(0)
        if IsErr(closedRegion):
            ok = false
    if reader.tree != os.AtomicTree(0):
        let closedTree = os.AtomicTreeClose(reader.tree)
        reader.tree = os.AtomicTree(0)
        if IsErr(closedTree):
            ok = false
    return ok

fn csgcMappedRuntimeSnapshotAttempt(
        owner: var system.RuntimeAllocationLedgerSessionCapability):
        csgCoreCsgcMappedSnapshotAttempt =
    let snapshot =
        system.RuntimeAllocationLedgerSessionOwnerSnapshot(owner)
    var out: csgCoreCsgcMappedSnapshotAttempt
    if !snapshot.ok:
        return out
    out.ok = true
    out.receipt = snapshot.receipt
    return out

@borrows
fn csgcMappedTreeOpenAttempt(
        parentPath: str,
        finalName: str): csgCoreCsgcMappedTreeAttempt =
    let opened = os.AtomicTreeOpenVerified(parentPath, finalName)
    var out: csgCoreCsgcMappedTreeAttempt
    if IsErr(opened):
        return out
    out.ok = true
    out.tree = Value(opened)
    return out

@borrows
fn csgcMappedRegionOpenAttempt(
        tree: os.AtomicTree,
        relativePath: str): csgCoreCsgcMappedRegionAttempt =
    let mapped = os.AtomicTreeMapReadOnly(tree, relativePath)
    var out: csgCoreCsgcMappedRegionAttempt
    if IsErr(mapped):
        return out
    out.ok = true
    out.region = Value(mapped)
    return out

fn csgcMappedRegionLengthAttempt(
        region: os.ReadOnlyMappedRegion):
        csgCoreCsgcMappedInt64Attempt =
    let measured = os.ReadOnlyMappedRegionByteLength(region)
    var out: csgCoreCsgcMappedInt64Attempt
    if IsErr(measured):
        return out
    out.ok = true
    out.value = Value(measured)
    return out

@borrows
fn csgcMappedRegionBindAttempt(
        region: os.ReadOnlyMappedRegion,
        hashDomain: str,
        expectedCid: str): csgCoreCsgcMappedBoolAttempt =
    let bound = os.ReadOnlyMappedRegionBindSha256Framed(
        region, hashDomain, expectedCid)
    var out: csgCoreCsgcMappedBoolAttempt
    if IsErr(bound) || !Value(bound):
        return out
    out.ok = true
    return out

fn csgcMappedRecordObjectDigestReceipt(
        reader: var CsgCoreCsgcMappedReader): bool =
    if reader.region == os.ReadOnlyMappedRegion(0) ||
       reader.byteLength < int64(csgc.CsgCoreCsgcHeaderSize):
        return false
    let measured = os.ReadOnlyMappedRegionByteLength(reader.region)
    let digestCount =
        os.ReadOnlyMappedRegionFullDigestCount(reader.region)
    if IsErr(measured) || IsErr(digestCount):
        return false
    let measuredValue = Value(measured)
    let digestCountValue = Value(digestCount)
    if measuredValue != reader.byteLength || digestCountValue != 1:
        return false
    var state = reader.runtimeOwner
    state.objectDigestVerified = true
    state.objectDigestCount = digestCountValue
    state.verifiedByteLength = measuredValue
    reader.runtimeOwner = state
    return true

@borrows
fn csgcMappedObjectDigestReceiptValid(
        reader: CsgCoreCsgcMappedReader): bool =
    if !reader.runtimeOwner.objectDigestVerified ||
       reader.runtimeOwner.objectDigestCount != 1 ||
       reader.runtimeOwner.verifiedByteLength != reader.byteLength ||
       !reader.runtimeOwner.expectedObjectCidValid ||
       reader.region == os.ReadOnlyMappedRegion(0):
        return false
    let measured = os.ReadOnlyMappedRegionByteLength(reader.region)
    let digestCount =
        os.ReadOnlyMappedRegionFullDigestCount(reader.region)
    return IsOk(measured) && Value(measured) == reader.byteLength &&
        IsOk(digestCount) && Value(digestCount) == 1

@borrows
fn csgcMappedExpectedCidAttempt(
        expectedCid: str): csgCoreCsgcMappedCidAttempt =
    var out: csgCoreCsgcMappedCidAttempt
    if expectedCid.len != 71 ||
       !strings.HasPrefix(expectedCid, "sha256:"):
        return out
    let hexText = strings.SliceBytes(expectedCid, 7, 64)
    let parsed = layout.FixedBytes32FromHex(hexText)
    if IsErr(parsed):
        return out
    let value = Value(parsed)
    if layout.FixedBytes32Hex(value) != hexText ||
       layout.FixedBytes32Equal(value, layout.FixedBytes32()):
        return out
    out.ok = true
    out.value = value
    return out

fn csgcMappedRuntimeOwnerSessionDetach(
        reader: var CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability): bool =
    # A session reader never closes the ledger owner. It releases only its
    # own sections, mapping, and tree, then proves from a fresh snapshot that
    # those ledger events drained before the still-active capability is
    # handed back to the session.
    if !reader.runtimeOwner.beginAttempted ||
       !reader.runtimeOwner.active ||
       reader.runtimeOwner.closeAttempted:
        panic("csgc_mapped_session_detach_state_invalid")
    csgcMappedReleaseSections(reader)
    let osOwnersClosed = csgcMappedCloseOsOwners(reader)
    var state = reader.runtimeOwner
    state.closeAttempted = true
    reader.runtimeOwner = state
    let snapshot = csgcMappedRuntimeSnapshotAttempt(owner)
    state = reader.runtimeOwner
    if !snapshot.ok:
        panic("csgc_mapped_session_detach_snapshot_terminal_failure")
    let receipt = snapshot.receipt
    let receiptShapeValid = receipt.active &&
        !receipt.complete && !receipt.closed &&
        receipt.ownerGeneration == state.ownerGeneration &&
        receipt.liveMappedVirtualBytes == uint64(0) &&
        receipt.liveMappingCount == uint64(0) &&
        receipt.eventIndex > state.mappingReceipt.eventIndex &&
        receipt.liveHandleCount == uint64(0)
    if !osOwnersClosed || !receiptShapeValid:
        panic("csgc_mapped_session_detach_receipt_terminal_failure")
    state.active = false
    state.closeSucceeded = true
    state.closeReceipt = receipt
    reader.runtimeOwner = state
    return true

fn csgcMappedOpenPanic(errorCode: int32) =
    if errorCode == csgcMappedOpenErrorOwnerBegin:
        panic("csgc_mapped_production_owner_begin_failed")
    if errorCode == csgcMappedOpenErrorTreeOpen:
        panic("csgc_mapped_production_tree_open_failed")
    if errorCode == csgcMappedOpenErrorMap:
        panic("csgc_mapped_production_map_failed")
    if errorCode == csgcMappedOpenErrorLength:
        panic("csgc_mapped_production_length_invalid")
    if errorCode == csgcMappedOpenErrorCid:
        panic("csgc_mapped_production_expected_cid_invalid")
    if errorCode == csgcMappedOpenErrorDigestBind:
        panic("csgc_mapped_production_digest_bind_failed")
    if errorCode == csgcMappedOpenErrorDigestCount:
        panic("csgc_mapped_production_digest_count_invalid")
    if errorCode == csgcMappedOpenErrorCanonicalMetadata:
        panic("csgc_mapped_production_canonical_metadata_invalid")
    if errorCode == csgcMappedOpenErrorMappingReceipt:
        panic("csgc_mapped_production_mapping_receipt_invalid")
    if errorCode == csgcMappedOpenErrorTreeShape:
        panic("csgc_mapped_production_tree_shape_invalid")
    if errorCode == csgcMappedOpenErrorCanonicalObject:
        panic("csgc_mapped_production_canonical_object_invalid")
    panic("csgc_mapped_production_unknown_failure")

fn csgcMappedAbortOpen(
        reader: var CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        errorCode: int32) =
    csgcMappedInvalidateAuthority(reader)
    if !csgcMappedRuntimeOwnerSessionDetach(reader, owner):
        panic("csgc_mapped_production_abort_detach_failed")
    csgcMappedOpenPanic(errorCode)

@borrows
fn csgcMappedReadWindow(
        reader: var CsgCoreCsgcMappedReader,
        offset: int64,
        length: int32): Result[rawbytes.Bytes] =
    if !csgcMappedObjectDigestReceiptValid(reader):
        return Err[rawbytes.Bytes](
            "csgc_mapped_object_digest_receipt_invalid")
    if offset < 0 || length <= 0 ||
       length > CsgCoreCsgcMappedWindowMax ||
       reader.byteLength < 0 ||
       int64(length) > reader.byteLength ||
       offset > reader.byteLength - int64(length):
        return Err[rawbytes.Bytes](
            "csgc_mapped_window_range_out_of_bounds")
    var readResult = os.ReadOnlyMappedRegionReadWindow(
        reader.region, offset, length)
    if IsErr(readResult):
        return Err[rawbytes.Bytes](Error(readResult))
    var out = rawbytes.BytesTake(readResult.value)
    let actualLength = rawbytes.BytesLen(out)
    if actualLength != length:
        if actualLength > 0:
            rawbytes.BytesFree(out)
        else:
            rawbytes.BytesFree(out)
        return Err[rawbytes.Bytes](
            "csgc_mapped_window_receipt_length_mismatch")
    return Ok[rawbytes.Bytes](out)

@borrows
fn csgcMappedReadU8(
        bytes: rawbytes.Bytes,
        offset: int32): int32 =
    if offset < 0 || offset >= rawbytes.BytesLen(bytes):
        return -1
    return rawbytes.BytesGet(bytes, offset) & 255

@borrows
fn csgcMappedReadU16LE(
        bytes: rawbytes.Bytes,
        offset: int32): int32 =
    if offset < 0 || rawbytes.BytesLen(bytes) < 2 ||
       offset > rawbytes.BytesLen(bytes) - 2:
        return -1
    let b0 = rawbytes.BytesGet(bytes, offset) & 255
    let b1 = rawbytes.BytesGet(bytes, offset + 1) & 255
    return b0 | (b1 << 8)

@borrows
fn csgcMappedReadU32LE(
        bytes: rawbytes.Bytes,
        offset: int32): int64 =
    if offset < 0 || rawbytes.BytesLen(bytes) < 4 ||
       offset > rawbytes.BytesLen(bytes) - 4:
        return int64(-1)
    let b0 = int64(rawbytes.BytesGet(bytes, offset) & 255)
    let b1 = int64(rawbytes.BytesGet(bytes, offset + 1) & 255)
    let b2 = int64(rawbytes.BytesGet(bytes, offset + 2) & 255)
    let b3 = int64(rawbytes.BytesGet(bytes, offset + 3) & 255)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn csgcMappedVarintLen(value: int32): int32 =
    if value < 0:
        return -1
    var length = 1
    var remaining = value
    while remaining >= 128:
        remaining = remaining >> 7
        length = length + 1
    return length

@borrows
fn csgcMappedReadVarint(
        reader: var CsgCoreCsgcMappedReader,
        offset: int64,
        limit: int64): csgCoreCsgcMappedVarint =
    var failed: csgCoreCsgcMappedVarint
    if offset < 0 || limit < 0 ||
       offset > limit || limit > reader.byteLength:
        failed.error = "csgc_mapped_varint_range_out_of_bounds"
        return failed
    var cursor = offset
    var value: int32
    var shift: int32
    while cursor < limit:
        var oneResult =
            csgcMappedReadWindow(reader, cursor, 1)
        if IsErr(oneResult):
            failed.error = strings.CloneStr(Error(oneResult))
            return failed
        var one = rawbytes.BytesTake(oneResult.value)
        let byteValue = csgcMappedReadU8(one, 0)
        rawbytes.BytesFree(one)
        if shift > 28 ||
           (shift == 28 && (byteValue & 127) > 7):
            failed.error = "csgc_mapped_varint_overflow"
            return failed
        value = value | ((byteValue & 127) << shift)
        cursor = cursor + 1
        if (byteValue & 128) == 0:
            if cursor - offset != int64(csgcMappedVarintLen(value)):
                failed.error = "csgc_mapped_non_canonical_varint"
                return failed
            var out: csgCoreCsgcMappedVarint
            out.ok = true
            out.value = value
            out.nextOffset = cursor
            return out
        shift = shift + 7
    failed.error = "csgc_mapped_truncated_varint"
    return failed

@borrows
fn csgcMappedUtf8RangeError(
        reader: var CsgCoreCsgcMappedReader,
        offset: int64,
        length: int32): str =
    if offset < 0 || length < 0 ||
       int64(length) > reader.byteLength ||
       offset > reader.byteLength - int64(length):
        return "csgc_mapped_utf8_range_out_of_bounds"
    var cursor: int32
    var needed: int32
    var firstContinuation = false
    var firstLow: int32
    var firstHigh: int32
    while cursor < length:
        let remaining = length - cursor
        let chunkLength = remaining < CsgCoreCsgcMappedWindowMax ?
            remaining : CsgCoreCsgcMappedWindowMax
        var chunkResult = csgcMappedReadWindow(
            reader,
            offset + int64(cursor),
            chunkLength)
        if IsErr(chunkResult):
            return strings.CloneStr(Error(chunkResult))
        var chunk = rawbytes.BytesTake(chunkResult.value)
        for index in 0..<chunkLength:
            let byteValue = rawbytes.BytesGet(chunk, index) & 255
            if needed > 0:
                let low = firstContinuation ? firstLow : 128
                let high = firstContinuation ? firstHigh : 191
                if byteValue < low || byteValue > high:
                    csgcMappedWindowFree(reader, chunk)
                    return "csgc_mapped_invalid_utf8"
                firstContinuation = false
                needed = needed - 1
            elif byteValue >= 194 && byteValue <= 223:
                needed = 1
                firstContinuation = true
                firstLow = 128
                firstHigh = 191
            elif byteValue >= 224 && byteValue <= 239:
                needed = 2
                firstContinuation = true
                if byteValue == 224:
                    firstLow = 160
                    firstHigh = 191
                elif byteValue == 237:
                    firstLow = 128
                    firstHigh = 159
                else:
                    firstLow = 128
                    firstHigh = 191
            elif byteValue >= 240 && byteValue <= 244:
                needed = 3
                firstContinuation = true
                if byteValue == 240:
                    firstLow = 144
                    firstHigh = 191
                elif byteValue == 244:
                    firstLow = 128
                    firstHigh = 143
                else:
                    firstLow = 128
                    firstHigh = 191
            elif byteValue > 127:
                csgcMappedWindowFree(reader, chunk)
                return "csgc_mapped_invalid_utf8"
        csgcMappedWindowFree(reader, chunk)
        cursor = cursor + chunkLength
    if needed != 0:
        return "csgc_mapped_truncated_utf8"
    return ""

@borrows
fn csgcMappedCompareRanges(
        reader: var CsgCoreCsgcMappedReader,
        leftOffset: int64,
        leftLength: int32,
        rightOffset: int64,
        rightLength: int32): csgCoreCsgcMappedCompare =
    var failed: csgCoreCsgcMappedCompare
    if leftOffset < 0 || rightOffset < 0 ||
       leftLength < 0 || rightLength < 0 ||
       int64(leftLength) > reader.byteLength ||
       leftOffset > reader.byteLength - int64(leftLength) ||
       int64(rightLength) > reader.byteLength ||
       rightOffset > reader.byteLength - int64(rightLength):
        failed.error = "csgc_mapped_kind_compare_range_out_of_bounds"
        return failed
    let commonLength = leftLength < rightLength ?
        leftLength : rightLength
    var cursor: int32
    while cursor < commonLength:
        let remaining = commonLength - cursor
        let chunkLength = remaining < CsgCoreCsgcMappedWindowMax ?
            remaining : CsgCoreCsgcMappedWindowMax
        var leftResult = csgcMappedReadWindow(
            reader,
            leftOffset + int64(cursor),
            chunkLength)
        if IsErr(leftResult):
            failed.error = strings.CloneStr(Error(leftResult))
            return failed
        var left = rawbytes.BytesTake(leftResult.value)
        var rightResult = csgcMappedReadWindow(
            reader,
            rightOffset + int64(cursor),
            chunkLength)
        if IsErr(rightResult):
            csgcMappedWindowFree(reader, left)
            failed.error = strings.CloneStr(Error(rightResult))
            return failed
        var right = rawbytes.BytesTake(rightResult.value)
        for index in 0..<chunkLength:
            let leftByte = rawbytes.BytesGet(left, index) & 255
            let rightByte = rawbytes.BytesGet(right, index) & 255
            if leftByte != rightByte:
                csgcMappedWindowFree(reader, left)
                csgcMappedWindowFree(reader, right)
                var out: csgCoreCsgcMappedCompare
                out.ok = true
                out.order = leftByte < rightByte ? -1 : 1
                return out
        csgcMappedWindowFree(reader, left)
        csgcMappedWindowFree(reader, right)
        cursor = cursor + chunkLength
    var out: csgCoreCsgcMappedCompare
    out.ok = true
    if leftLength < rightLength:
        out.order = -1
    elif leftLength > rightLength:
        out.order = 1
    return out

@borrows
fn csgcMappedUtf8ByteCompare(
        left: str,
        right: str): int32 =
    let leftView = rawbytes.BytesFromString(left)
    let rightView = rawbytes.BytesFromString(right)
    let commonLength = left.len < right.len ? left.len : right.len
    for index in 0..<commonLength:
        let leftByte = rawbytes.BytesGet(leftView, index) & 255
        let rightByte = rawbytes.BytesGet(rightView, index) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

fn csgcMappedReadU32At(
        reader: var CsgCoreCsgcMappedReader,
        offset: int64): csgCoreCsgcMappedVarint =
    var failed: csgCoreCsgcMappedVarint
    var bytesResult = csgcMappedReadWindow(
        reader, offset, 4)
    if IsErr(bytesResult):
        failed.error = strings.CloneStr(Error(bytesResult))
        return failed
    var bytes = rawbytes.BytesTake(bytesResult.value)
    let value = csgcMappedReadU32LE(bytes, 0)
    rawbytes.BytesFree(bytes)
    if value < 0 || value > 2147483647:
        failed.error = "csgc_mapped_u32_out_of_range"
        return failed
    var out: csgCoreCsgcMappedVarint
    out.ok = true
    out.value = int32(value)
    out.nextOffset = offset + 4
    return out

fn csgcMappedReadByteAt(
        reader: var CsgCoreCsgcMappedReader,
        offset: int64): csgCoreCsgcMappedVarint =
    var failed: csgCoreCsgcMappedVarint
    var bytesResult = csgcMappedReadWindow(
        reader, offset, 1)
    if IsErr(bytesResult):
        failed.error = strings.CloneStr(Error(bytesResult))
        return failed
    var bytes = rawbytes.BytesTake(bytesResult.value)
    let value = csgcMappedReadU8(bytes, 0)
    rawbytes.BytesFree(bytes)
    var out: csgCoreCsgcMappedVarint
    out.ok = true
    out.value = value
    out.nextOffset = offset + 1
    return out

@borrows
fn csgcMappedReadUtf8String(
        reader: var CsgCoreCsgcMappedReader,
        offset: int64,
        length: int32): Result[str] =
    if length < 0:
        return Err[str]("csgc_mapped_string_length_negative")
    let utf8Error = csgcMappedUtf8RangeError(
        reader, offset, length)
    if utf8Error.len > 0:
        return Err[str](utf8Error)
    let initialCapacity = length < CsgCoreCsgcMappedWindowMax ?
        length : CsgCoreCsgcMappedWindowMax
    var buffer = csgcMappedByteBufInit(reader, initialCapacity)
    var cursor: int32
    while cursor < length:
        let remaining = length - cursor
        let chunkLength = remaining < CsgCoreCsgcMappedWindowMax ?
            remaining : CsgCoreCsgcMappedWindowMax
        var chunkResult = csgcMappedReadWindow(
            reader,
            offset + int64(cursor),
            chunkLength)
        if IsErr(chunkResult):
            csgcMappedByteBufFree(reader, buffer)
            return Err[str](Error(chunkResult))
        var chunk = rawbytes.BytesTake(chunkResult.value)
        csgcMappedByteBufAppendBytes(reader, buffer, chunk)
        csgcMappedWindowFree(reader, chunk)
        cursor = cursor + chunkLength
    var textBytes = csgcMappedByteBufToBytes(reader, buffer)
    let text = rawbytes.BytesToString(textBytes)
    csgcMappedOwnedScratchFree(reader, textBytes)
    csgcMappedByteBufFree(reader, buffer)
    return Ok[str](text)

@borrows
fn csgcMappedLazyFail(
        message: str): csgc.CsgCoreCsgcLazyLinesResult =
    var out: csgc.CsgCoreCsgcLazyLinesResult
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgcMappedOperationError(
        reader: var CsgCoreCsgcMappedReader,
        error: str): str =
    # Closing while a managed error is live makes the runtime receipt reject
    # its own live-allocation invariant. This path stays unavailable until a
    # POD error code can leave the owner scope and a launcher closes afterward.
    return CsgCoreCsgcMappedManagedErrorCloseHardRedReason

@borrows
fn csgcMappedParseHeader(
        reader: var CsgCoreCsgcMappedReader): str =
    if reader.byteLength < int64(csgc.CsgCoreCsgcHeaderSize):
        return "csgc_mapped_truncated_header"
    var headerResult = csgcMappedReadWindow(
        reader,
        int64(0),
        csgc.CsgCoreCsgcHeaderSize)
    if IsErr(headerResult):
        return strings.CloneStr(Error(headerResult))
    var header = rawbytes.BytesTake(headerResult.value)
    let magic = csgcMappedReadU32LE(header, 0)
    let headerSize = csgcMappedReadU16LE(header, 4)
    let flags = csgcMappedReadU16LE(header, 6)
    let factCountValue = csgcMappedReadU32LE(header, 8)
    let compressedSize = csgcMappedReadU32LE(header, 12)
    let bodySizeValue = csgcMappedReadU32LE(header, 16)
    if magic != int64(csgc.CsgCoreCsgcMagic):
        csgcMappedWindowFree(reader, header)
        return "csgc_mapped_bad_magic"
    if headerSize != csgc.CsgCoreCsgcHeaderSize:
        csgcMappedWindowFree(reader, header)
        return "csgc_mapped_unsupported_header_size"
    if flags != csgc.CsgCoreCsgcFlagNone:
        csgcMappedWindowFree(reader, header)
        return "csgc_mapped_unsupported_flags"
    if compressedSize != 0:
        csgcMappedWindowFree(reader, header)
        return "csgc_mapped_compressed_body_unsupported"
    if factCountValue < 0 || factCountValue > 2147483647 ||
       bodySizeValue < 0 || bodySizeValue > 2147483647:
        csgcMappedWindowFree(reader, header)
        return "csgc_mapped_header_integer_out_of_range"
    for index in 20..<csgc.CsgCoreCsgcHeaderSize:
        if (rawbytes.BytesGet(header, index) & 255) != 0:
            csgcMappedWindowFree(reader, header)
            return "csgc_mapped_nonzero_reserved_header"
    csgcMappedWindowFree(reader, header)
    if bodySizeValue > 2147483647 -
           int64(csgc.CsgCoreCsgcHeaderSize):
        return "csgc_mapped_header_size_overflow"
    let expectedByteLength =
        int64(csgc.CsgCoreCsgcHeaderSize) + bodySizeValue
    if expectedByteLength != reader.byteLength:
        return "csgc_mapped_truncated_or_trailing_body"
    reader.headerSize = headerSize
    reader.flags = flags
    reader.factCount = int32(factCountValue)
    reader.bodySize = int32(bodySizeValue)
    return ""

@borrows
fn csgcMappedParseDirectory(
        reader: var CsgCoreCsgcMappedReader): str =
    if reader.bodySize < csgc.CsgCoreCsgcDirectoryPrefixSize:
        return "csgc_mapped_truncated_section_directory"
    let bodyOffset = int64(csgc.CsgCoreCsgcHeaderSize)
    var prefixResult = csgcMappedReadWindow(
        reader,
        bodyOffset,
        csgc.CsgCoreCsgcDirectoryPrefixSize)
    if IsErr(prefixResult):
        return strings.CloneStr(Error(prefixResult))
    var prefix = rawbytes.BytesTake(prefixResult.value)
    let directorySizeValue = csgcMappedReadU32LE(prefix, 0)
    let sectionCountValue = csgcMappedReadU32LE(prefix, 4)
    csgcMappedWindowFree(reader, prefix)
    if directorySizeValue <
           int64(csgc.CsgCoreCsgcDirectoryPrefixSize) ||
       directorySizeValue > int64(reader.bodySize) ||
       directorySizeValue > 2147483647:
        return "csgc_mapped_directory_size_out_of_range"
    let minimumEntryBytes =
        csgc.CsgCoreCsgcSectionFixedSize + 1
    if sectionCountValue < 1 ||
       sectionCountValue >
           int64(CsgCoreCsgcMappedSectionCountMax) ||
       sectionCountValue >
           (directorySizeValue -
            int64(csgc.CsgCoreCsgcDirectoryPrefixSize)) /
               int64(minimumEntryBytes):
        return "csgc_mapped_section_count_out_of_range"
    let directorySize = int32(directorySizeValue)
    let sectionCount = int32(sectionCountValue)
    let directoryEnd = bodyOffset + directorySizeValue
    if directoryEnd < bodyOffset ||
       directoryEnd > reader.byteLength:
        return "csgc_mapped_directory_range_overflow"
    reader.directorySize = directorySize
    var cursor = bodyOffset +
        int64(csgc.CsgCoreCsgcDirectoryPrefixSize)
    var expectedPayloadOffset = directorySizeValue
    var countedFacts: int64
    var previousKindOffset: int64
    var previousKindLength: int32
    for index in 0..<sectionCount:
        if cursor >= directoryEnd:
            return "csgc_mapped_truncated_section_entry"
        var tagResult = csgcMappedReadWindow(
            reader, cursor, 1)
        if IsErr(tagResult):
            return strings.CloneStr(Error(tagResult))
        var tagBytes = rawbytes.BytesTake(tagResult.value)
        let tag = rawbytes.BytesGet(tagBytes, 0) & 255
        csgcMappedWindowFree(reader, tagBytes)
        cursor = cursor + 1
        let kindLengthResult = csgcMappedReadVarint(
            reader,
            cursor,
            directoryEnd)
        if !kindLengthResult.ok:
            return strings.CloneStr(kindLengthResult.error)
        let kindLength = kindLengthResult.value
        cursor = kindLengthResult.nextOffset
        if kindLength < 0 ||
           int64(kindLength) > directoryEnd - cursor:
            return "csgc_mapped_section_kind_range_out_of_bounds"
        let kindOffset = cursor
        let fixedTailLength =
            12 + csgc.CsgCoreCsgcSectionDigestSize
        if int64(kindLength) >
           directoryEnd - cursor - int64(fixedTailLength):
            return "csgc_mapped_truncated_section_kind_or_entry"
        let utf8Error = csgcMappedUtf8RangeError(
            reader,
            kindOffset,
            kindLength)
        if utf8Error.len > 0:
            return utf8Error
        cursor = cursor + int64(kindLength)
        var tailResult = csgcMappedReadWindow(
            reader,
            cursor,
            fixedTailLength)
        if IsErr(tailResult):
            return strings.CloneStr(Error(tailResult))
        var tail = rawbytes.BytesTake(tailResult.value)
        let payloadOffsetValue = csgcMappedReadU32LE(tail, 0)
        let payloadLengthValue = csgcMappedReadU32LE(tail, 4)
        let itemCountValue = csgcMappedReadU32LE(tail, 8)
        if payloadOffsetValue < 0 || payloadOffsetValue > 2147483647 ||
           payloadLengthValue < 0 || payloadLengthValue > 2147483647 ||
           itemCountValue < 0 || itemCountValue > 2147483647:
            csgcMappedWindowFree(reader, tail)
            return "csgc_mapped_section_integer_out_of_range"
        var digest: layout.FixedBytes32
        for digestIndex in 0..<csgc.CsgCoreCsgcSectionDigestSize:
            digest.data[digestIndex] = UInt8(
                rawbytes.BytesGet(tail, 12 + digestIndex) & 255)
        csgcMappedWindowFree(reader, tail)
        cursor = cursor + int64(fixedTailLength)
        let payloadOffset = int32(payloadOffsetValue)
        let payloadLength = int32(payloadLengthValue)
        let itemCount = int32(itemCountValue)
        if index == 0:
            if tag != csgc.CsgCoreCsgcSectionDictionary ||
               kindLength != 0:
                return "csgc_mapped_non_canonical_dictionary_section"
        else:
            if tag != csgc.CsgCoreCsgcSectionFactKind ||
               kindLength == 0:
                return "csgc_mapped_non_canonical_fact_section"
            if index > 1:
                let compared = csgcMappedCompareRanges(
                    reader,
                    previousKindOffset,
                    previousKindLength,
                    kindOffset,
                    kindLength)
                if !compared.ok:
                    return strings.CloneStr(compared.error)
                if compared.order == 0:
                    return "csgc_mapped_duplicate_section_kind"
                if compared.order > 0:
                    return "csgc_mapped_non_canonical_section_order"
            previousKindOffset = kindOffset
            previousKindLength = kindLength
            if itemCount == 0:
                return "csgc_mapped_empty_fact_section"
        if payloadLength < 4:
            return "csgc_mapped_section_length_out_of_range"
        if payloadOffsetValue < expectedPayloadOffset:
            return "csgc_mapped_section_overlap"
        if payloadOffsetValue > expectedPayloadOffset:
            return "csgc_mapped_non_canonical_section_gap"
        if payloadLengthValue >
           int64(reader.bodySize) - payloadOffsetValue:
            return "csgc_mapped_section_range_out_of_bounds"
        expectedPayloadOffset =
            payloadOffsetValue + payloadLengthValue
        if expectedPayloadOffset < payloadOffsetValue:
            return "csgc_mapped_section_range_overflow"
        if index == 0:
            if itemCount > 134217728 ||
               itemCount > (payloadLength - 4) / 3:
                return "csgc_mapped_dictionary_count_out_of_range"
        else:
            if itemCount > payloadLength - 4:
                return "csgc_mapped_fact_count_out_of_range"
            if countedFacts > 2147483647 - int64(itemCount):
                return "csgc_mapped_fact_count_overflow"
            countedFacts = countedFacts + int64(itemCount)
        var section: CsgCoreCsgcMappedSection
        section.tag = tag
        section.kindOffset = kindOffset
        section.kindLength = kindLength
        section.payloadOffset =
            bodyOffset + payloadOffsetValue
        section.payloadLength = payloadLength
        section.itemCount = itemCount
        section.digest = digest
        add(reader.sections, section)
    if cursor != directoryEnd:
        return "csgc_mapped_non_canonical_directory_size"
    if expectedPayloadOffset != int64(reader.bodySize):
        return "csgc_mapped_truncated_section_payloads"
    if countedFacts != int64(reader.factCount):
        return "csgc_mapped_fact_count_mismatch"
    return ""

fn csgcMappedCanonicalMetadataValid(
        reader: var CsgCoreCsgcMappedReader): bool =
    let headerError = csgcMappedParseHeader(reader)
    if headerError.len > 0:
        return false
    let directoryError = csgcMappedParseDirectory(reader)
    return directoryError.len == 0

fn csgcMappedInitializeRuntimeOwner(
        reader: var CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability) =
    var state: csgCoreCsgcMappedRuntimeOwner
    state.beginAttempted = true
    state.active = true
    state.sessionScope = true
    state.ownerGeneration = owner.generation
    reader.runtimeOwner = state

fn csgcMappedReleaseCanonicalMapManaged(
        mapped: var merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult) =
    mapped.error = ""
    mapped.hashDomain = ""
    mapped.objectCid = ""
    mapped.storeRelativePath = ""

@borrows
fn csgcMappedVerifiedTreeFail(
        reader: var CsgCoreCsgcMappedReader,
        error: str): Result[CsgCoreCsgcMappedReader] =
    let closed = csgcMappedCloseOsOwners(reader)
    reader = CsgCoreCsgcMappedReader()
    if !closed:
        panic("csgc mapped verified tree: owner close failed")
    return Err[CsgCoreCsgcMappedReader](strings.CloneStr(error))

@borrows
fn CsgCoreCsgcMappedReaderOpenVerifiedTreeOwned(
        tree: var os.AtomicTree,
        relativePath: str,
        hashDomain: str,
        expectedCid: str): Result[CsgCoreCsgcMappedReader] =
    var reader: CsgCoreCsgcMappedReader
    if tree == os.AtomicTree(0):
        return Err[CsgCoreCsgcMappedReader](
            "csgc_mapped_verified_tree_invalid")
    reader.tree = tree
    tree = os.AtomicTree(0)
    var state: csgCoreCsgcMappedRuntimeOwner
    state.beginAttempted = true
    state.active = true
    state.verifiedTreeScope = true
    reader.runtimeOwner = state

    let expected = csgcMappedExpectedCidAttempt(expectedCid)
    if !expected.ok:
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_cid_invalid")
    state = reader.runtimeOwner
    state.expectedObjectCid = expected.value
    state.expectedObjectCidValid = true
    reader.runtimeOwner = state

    let exact = os.AtomicTreeVerifyExact(
        reader.tree, [], [strings.CloneStr(relativePath)])
    if IsErr(exact):
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_shape_invalid")
    let mapped = csgcMappedRegionOpenAttempt(
        reader.tree, relativePath)
    if !mapped.ok:
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_map_failed")
    reader.region = mapped.region
    let measured = csgcMappedRegionLengthAttempt(reader.region)
    if !measured.ok ||
       measured.value < int64(csgc.CsgCoreCsgcHeaderSize) ||
       measured.value > int64(2147483647):
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_length_invalid")
    reader.byteLength = measured.value
    let bound = csgcMappedRegionBindAttempt(
        reader.region, hashDomain, expectedCid)
    if !bound.ok:
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_object_mismatch")
    if !csgcMappedRecordObjectDigestReceipt(reader):
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_digest_invalid")
    if !csgcMappedCanonicalMetadataValid(reader):
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_metadata_invalid")
    if !csgcMappedWholeObjectCanonicalSeal(reader):
        return csgcMappedVerifiedTreeFail(
            reader, "csgc_mapped_verified_tree_canonical_invalid")
    reader.ordinalNext = 0
    reader.ordinalSectionIndex = 1
    reader.ordinalSectionStart = 0
    return Ok[CsgCoreCsgcMappedReader](reader)

@borrows
fn CsgCoreCsgcMappedReaderOpen(
        tree: os.AtomicTree,
        relativePath: str,
        hashDomain: str,
        expectedCid: str): Result[CsgCoreCsgcMappedReader] =
    # A caller-owned tree is already a live runtime handle. The exact owner
    # must start before that handle exists, so this legacy shape is fail-stop.
    return Err[CsgCoreCsgcMappedReader](
        CsgCoreCsgcMappedPreopenedTreeHardRedReason)

@borrows
fn CsgCoreCsgcMappedReaderOpenProduction(
        parentPath: str,
        finalName: str,
        relativePath: str,
        hashDomain: str,
        expectedCid: str): Result[CsgCoreCsgcMappedReader] =
    # Managed str arguments already exist before this function can begin the
    # process-global ledger owner, so self-begin can never prove a zero-allocation
    # baseline. Only the owned entry below may perform production reads.
    return Err[CsgCoreCsgcMappedReader](
        CsgCoreCsgcMappedCliPreallocationHardRedReason)

@borrows
fn CsgCoreCsgcMappedReaderOpenProductionOwned(
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        parentPath: str,
        finalName: str,
        relativePath: str,
        hashDomain: str,
        expectedCid: str): Result[CsgCoreCsgcMappedReader] =
    var reader: CsgCoreCsgcMappedReader
    csgcMappedInitializeRuntimeOwner(reader, owner)
    let snapshot = csgcMappedRuntimeSnapshotAttempt(owner)
    if !snapshot.ok || !snapshot.receipt.active ||
       snapshot.receipt.complete || snapshot.receipt.closed ||
       snapshot.receipt.ownerGeneration != owner.generation ||
       snapshot.receipt.liveMappingCount != uint64(0) ||
       snapshot.receipt.liveHandleCount != uint64(0):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorOwnerBegin)

    let expected = csgcMappedExpectedCidAttempt(expectedCid)
    if !expected.ok:
        csgcMappedAbortOpen(reader, owner, csgcMappedOpenErrorCid)
    var state = reader.runtimeOwner
    state.expectedObjectCid = expected.value
    state.expectedObjectCidValid = true
    reader.runtimeOwner = state

    let opened = csgcMappedTreeOpenAttempt(parentPath, finalName)
    if !opened.ok:
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorTreeOpen)
    reader.tree = opened.tree

    let exactRelativePath = strings.CloneStr(relativePath)
    let exact = os.AtomicTreeVerifyExact(
        reader.tree, [], [exactRelativePath])
    if IsErr(exact):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorTreeShape)

    let mapped = csgcMappedRegionOpenAttempt(
        reader.tree, relativePath)
    if !mapped.ok:
        csgcMappedAbortOpen(reader, owner, csgcMappedOpenErrorMap)
    reader.region = mapped.region

    let measured = csgcMappedRegionLengthAttempt(reader.region)
    if !measured.ok || measured.value < int64(csgc.CsgCoreCsgcHeaderSize) ||
       measured.value > int64(2147483647):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorLength)
    reader.byteLength = measured.value

    let bound = csgcMappedRegionBindAttempt(
        reader.region, hashDomain, expectedCid)
    if !bound.ok:
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorDigestBind)
    if !csgcMappedRecordObjectDigestReceipt(reader):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorDigestCount)
    if !csgcMappedCanonicalMetadataValid(reader):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorCanonicalMetadata)
    if !csgcMappedWholeObjectCanonicalSeal(reader):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorCanonicalObject)
    if !csgcMappedRuntimeMappingReceipt(reader, owner):
        csgcMappedAbortOpen(
            reader, owner, csgcMappedOpenErrorMappingReceipt)
    return Ok[CsgCoreCsgcMappedReader](reader)

fn CsgCoreCsgcMappedReaderOpenCanonicalObjectOwned(
        mapped: var merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult,
        owner: var system.RuntimeAllocationLedgerSessionCapability):
        Result[CsgCoreCsgcMappedReader] =
    # The region handle is ledger-owned, but the adjacent objectCid,
    # byteCount, and hashDomain fields are caller-constructible. Rebinding the
    # region would perform a forbidden second full-object digest. Consume and
    # detach only the mapping, then reject this surface unconditionally. The
    # process-entry session remains the sole owner-close authority.
    var reader: CsgCoreCsgcMappedReader
    csgcMappedInitializeRuntimeOwner(reader, owner)
    reader.region = mapped.region
    mapped.region = os.ReadOnlyMappedRegion(0)
    csgcMappedReleaseCanonicalMapManaged(mapped)
    if !csgcMappedRuntimeOwnerSessionDetach(reader, owner):
        panic("csgc_mapped_premapped_reject_detach_failed")
    return Err[CsgCoreCsgcMappedReader](
        CsgCoreCsgcMappedPremappedCarrierHardRedReason)

fn CsgCoreCsgcMappedReaderOpenCanonicalObject(
        mapped: var merkle_store_types.CsgCoreMerkleStoreCanonicalCsgcMapResult):
        Result[CsgCoreCsgcMappedReader] =
    # A region alone cannot prove which runtime owner recorded its mmap. The
    # owned entry above requires the original unforgeable owner capability.
    if mapped.region != os.ReadOnlyMappedRegion(0):
        let closed = os.ReadOnlyMappedRegionClose(mapped.region)
        mapped.region = os.ReadOnlyMappedRegion(0)
        if IsErr(closed):
            panic("csgc_mapped_preopened_region_close_failed")
    return Err[CsgCoreCsgcMappedReader](
        CsgCoreCsgcMappedPreopenedRegionHardRedReason)

fn CsgCoreCsgcMappedSessionOwnerBegin(
        backingLimit: uint64,
        owner: var
            system.RuntimeAllocationLedgerSessionCapability): bool =
    # The session owner must be issued before any managed allocation exists,
    # so this edge takes no managed argument and the module fixes the nominal
    # session domain. The runtime begin core still hard-fails unless the
    # process heap, registry, and probe baselines are all exactly zero.
    return system.RuntimeAllocationLedgerSessionOwnerBegin(
        backingLimit, owner)

fn CsgCoreCsgcMappedSessionOwnerClose(
        owner: var system.RuntimeAllocationLedgerSessionCapability):
        system.RuntimeAllocationLedgerReceiptResult =
    # The single terminal close of the session owner. The runtime close core
    # hard-fails unless the whole session first drained every allocation,
    # mapping, and handle it recorded.
    return system.RuntimeAllocationLedgerSessionOwnerClose(owner)

@borrows
fn CsgCoreCsgcMappedReaderOpenSessionOwned(
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        parentPath: str,
        finalName: str,
        relativePath: str,
        hashDomain: str,
        expectedCid: str): Result[CsgCoreCsgcMappedReader] =
    # The explicit var capability proves that the process session retains
    # authority. The reader may attach, map, snapshot, and detach; it never
    # begins, closes, returns, or replaces the session owner.
    let opened = CsgCoreCsgcMappedReaderOpenProductionOwned(
        owner,
        parentPath,
        finalName,
        relativePath,
        hashDomain,
        expectedCid)
    if IsErr(opened):
        return opened
    var reader = Value(opened)
    var state = reader.runtimeOwner
    state.sessionScope = true
    reader.runtimeOwner = state
    return Ok[CsgCoreCsgcMappedReader](reader)

@borrows
fn CsgCoreCsgcMappedReaderIsOpen(
        reader: CsgCoreCsgcMappedReader): bool =
    return reader.runtimeOwner.active &&
        (reader.runtimeOwner.mappingReceiptValid ||
         reader.runtimeOwner.verifiedTreeScope) &&
        reader.region != os.ReadOnlyMappedRegion(0)

@borrows
fn csgcMappedReaderAuthorized(
        reader: CsgCoreCsgcMappedReader): bool =
    return CsgCoreCsgcMappedReaderIsOpen(reader) &&
        csgcMappedObjectDigestReceiptValid(reader) &&
        reader.canonicalSealVerified &&
        reader.canonicalSealFactCount == reader.factCount &&
        reader.canonicalSealSectionCount == reader.sections.len

@borrows
fn CsgCoreCsgcMappedReaderFactCount(
        reader: CsgCoreCsgcMappedReader): Result[int32] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[int32]("csgc_mapped_reader_closed")
    return Ok[int32](reader.factCount)

@borrows
fn CsgCoreCsgcMappedReaderByteLength(
        reader: CsgCoreCsgcMappedReader): Result[int32] =
    if !csgcMappedReaderAuthorized(reader) ||
       reader.byteLength <= int64(0) ||
       reader.byteLength > int64(2147483647):
        return Err[int32]("csgc_mapped_reader_closed")
    return Ok[int32](int32(reader.byteLength))

fn CsgCoreCsgcMappedReaderDirectoryCid(
        reader: var CsgCoreCsgcMappedReader): Result[str] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[str]("csgc_mapped_reader_closed")
    var state = sha256.Sha256TwoPartStateInit()
    csgcMappedShaUpdateText(
        reader, state, csgc.CsgCoreCsgcDirectoryHashDomain)
    csgcMappedShaUpdateU32(reader, state, csgc.CsgCoreCsgcMagic)
    csgcMappedShaUpdateU32(reader, state, reader.headerSize)
    csgcMappedShaUpdateU32(reader, state, reader.flags)
    csgcMappedShaUpdateU32(reader, state, reader.factCount)
    csgcMappedShaUpdateU32(reader, state, 0)
    csgcMappedShaUpdateU32(reader, state, reader.bodySize)
    let directoryError = csgcMappedShaUpdateRange(
        reader,
        state,
        int64(reader.headerSize),
        reader.directorySize)
    if directoryError.len > 0:
        sha256.Sha256TwoPartStateRelease(state)
        return Err[str](csgcMappedOperationError(
            reader, directoryError))
    var digestBytes = sha256.Sha256TwoPartFinish(state)
    csgcMappedOwnedScratchAdopt(reader, digestBytes)
    let digestHex = rawbytes.BytesToHex(digestBytes)
    csgcMappedOwnedScratchFree(reader, digestBytes)
    return Ok[str](strings.ConcatStr("sha256:", digestHex))

@borrows
fn CsgCoreCsgcMappedReaderSectionCount(
        reader: CsgCoreCsgcMappedReader): Result[int32] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[int32]("csgc_mapped_reader_closed")
    return Ok[int32](reader.sections.len)

fn CsgCoreCsgcMappedReaderSectionInfo(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32): Result[CsgCoreCsgcMappedSectionInfo] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[CsgCoreCsgcMappedSectionInfo](
            "csgc_mapped_reader_closed")
    if sectionIndex < 0 || sectionIndex >= reader.sections.len:
        return Err[CsgCoreCsgcMappedSectionInfo](
            csgcMappedOperationError(
                reader, "csgc_mapped_section_index_out_of_range"))
    let section = reader.sections[sectionIndex]
    var info: CsgCoreCsgcMappedSectionInfo
    info.index = sectionIndex
    info.tag = section.tag
    info.kindByteLength = section.kindLength
    info.payloadByteLength = section.payloadLength
    info.itemCount = section.itemCount
    info.digestVerified = section.digestVerified
    return Ok[CsgCoreCsgcMappedSectionInfo](info)

@borrows
fn CsgCoreCsgcMappedReaderFindSection(
        reader: var CsgCoreCsgcMappedReader,
        kind: str): Result[int32] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[int32]("csgc_mapped_reader_closed")
    # BytesFromString is a borrowed view over kind; freeing it would free str storage.
    let kindView = rawbytes.BytesFromString(kind)
    for sectionIndex in 0..<reader.sections.len:
        let section = reader.sections[sectionIndex]
        if section.kindLength == rawbytes.BytesLen(kindView):
            var matches = true
            var cursor: int32
            while cursor < section.kindLength && matches:
                let remaining = section.kindLength - cursor
                let chunkLength =
                    remaining < CsgCoreCsgcMappedWindowMax ?
                        remaining : CsgCoreCsgcMappedWindowMax
                var chunkResult = csgcMappedReadWindow(
                    reader,
                    section.kindOffset + int64(cursor),
                    chunkLength)
                if IsErr(chunkResult):
                    return Err[int32](csgcMappedOperationError(
                        reader, Error(chunkResult)))
                var chunk = rawbytes.BytesTake(chunkResult.value)
                for index in 0..<chunkLength:
                    if rawbytes.BytesGet(chunk, index) !=
                       rawbytes.BytesGet(kindView, cursor + index):
                        matches = false
                csgcMappedWindowFree(reader, chunk)
                cursor = cursor + chunkLength
            if matches:
                return Ok[int32](sectionIndex)
    return Ok[int32](-1)

fn csgcMappedShaUpdateU32(
        reader: var CsgCoreCsgcMappedReader,
        state: var sha256.Sha256TwoPartState,
        value: int32) =
    if value < 0:
        panic("csgc_mapped_sha_u32_negative")
    var encoded = csgcMappedOwnedScratchAlloc(reader, 4)
    rawbytes.BytesSet(encoded, 0, value & 255)
    rawbytes.BytesSet(encoded, 1, (value >> 8) & 255)
    rawbytes.BytesSet(encoded, 2, (value >> 16) & 255)
    rawbytes.BytesSet(encoded, 3, (value >> 24) & 255)
    sha256.Sha256TwoPartUpdate(state, encoded)
    csgcMappedOwnedScratchFree(reader, encoded)

@borrows
fn csgcMappedShaUpdateText(
        reader: var CsgCoreCsgcMappedReader,
        state: var sha256.Sha256TwoPartState,
        value: str) =
    csgcMappedShaUpdateU32(reader, state, value.len)
    # BytesFromString is a borrowed view over value; freeing it would free str storage.
    let valueView = rawbytes.BytesFromString(value)
    sha256.Sha256TwoPartUpdate(state, valueView)

@borrows
fn csgcMappedShaUpdateRange(
        reader: var CsgCoreCsgcMappedReader,
        state: var sha256.Sha256TwoPartState,
        offset: int64,
        length: int32): str =
    if offset < 0 || length < 0 ||
       int64(length) > reader.byteLength ||
       offset > reader.byteLength - int64(length):
        return "csgc_mapped_digest_range_out_of_bounds"
    var cursor: int32
    while cursor < length:
        let remaining = length - cursor
        let chunkLength = remaining < CsgCoreCsgcMappedWindowMax ?
            remaining : CsgCoreCsgcMappedWindowMax
        var chunkResult = csgcMappedReadWindow(
            reader,
            offset + int64(cursor),
            chunkLength)
        if IsErr(chunkResult):
            return strings.CloneStr(Error(chunkResult))
        var chunk = rawbytes.BytesTake(chunkResult.value)
        sha256.Sha256TwoPartUpdate(state, chunk)
        csgcMappedWindowFree(reader, chunk)
        cursor = cursor + chunkLength
    return ""

fn csgcMappedVerifySectionForCanonicalSeal(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32): bool =
    if sectionIndex < 0 || sectionIndex >= reader.sections.len:
        return false
    var section = reader.sections[sectionIndex]
    if section.digestVerified:
        return true
    var state = sha256.Sha256TwoPartStateInit()
    csgcMappedShaUpdateText(
        reader, state, csgc.CsgCoreCsgcSectionHashDomain)
    var tagBytes = csgcMappedOwnedScratchAlloc(reader, 1)
    rawbytes.BytesSet(tagBytes, 0, section.tag)
    sha256.Sha256TwoPartUpdate(state, tagBytes)
    csgcMappedOwnedScratchFree(reader, tagBytes)
    csgcMappedShaUpdateU32(reader, state, section.kindLength)
    let kindError = csgcMappedShaUpdateRange(
        reader,
        state,
        section.kindOffset,
        section.kindLength)
    if kindError.len > 0:
        sha256.Sha256TwoPartStateRelease(state)
        return false
    csgcMappedShaUpdateU32(reader, state, section.itemCount)
    csgcMappedShaUpdateU32(reader, state, section.payloadLength)
    let payloadError = csgcMappedShaUpdateRange(
        reader,
        state,
        section.payloadOffset,
        section.payloadLength)
    if payloadError.len > 0:
        sha256.Sha256TwoPartStateRelease(state)
        return false
    var digestBytes = sha256.Sha256TwoPartFinish(state)
    csgcMappedOwnedScratchAdopt(reader, digestBytes)
    let digestResult = layout.FixedBytes32FromBytes(digestBytes)
    csgcMappedOwnedScratchFree(reader, digestBytes)
    if IsErr(digestResult):
        return false
    if !layout.FixedBytes32Equal(
           Value(digestResult), section.digest):
        return false
    section.digestVerified = true
    reader.sections[sectionIndex] = section
    return true

fn CsgCoreCsgcMappedReaderVerifySection(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32): Result[bool] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[bool]("csgc_mapped_reader_closed")
    if sectionIndex < 0 || sectionIndex >= reader.sections.len:
        return Err[bool](csgcMappedOperationError(
            reader, "csgc_mapped_section_index_out_of_range"))
    if !csgcMappedVerifySectionForCanonicalSeal(
            reader, sectionIndex):
        return Err[bool](csgcMappedOperationError(
            reader, "csgc_mapped_section_digest_mismatch"))
    return Ok[bool](true)

@borrows
fn csgcMappedNeedsFail(
        message: str): csgCoreCsgcMappedDecodeNeeds =
    var out: csgCoreCsgcMappedDecodeNeeds
    out.error = strings.CloneStr(message)
    return out

fn csgcMappedDecodeNeedsInit(): csgCoreCsgcMappedDecodeNeeds =
    var out: csgCoreCsgcMappedDecodeNeeds
    out.dictionaryRefs = tables.TableInit[int32](64)
    out.inlineTokens = tables.TableInit[bool](64)
    return out

fn csgcMappedCollectDecodeNeedsInto(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32,
        out: var csgCoreCsgcMappedDecodeNeeds): str =
    if sectionIndex <= 0 || sectionIndex >= reader.sections.len:
        return "csgc_mapped_decode_section_index_out_of_range"
    let section = reader.sections[sectionIndex]
    let dictionaryCount = reader.sections[0].itemCount
    let sectionEnd = section.payloadOffset +
        int64(section.payloadLength)
    let countRead = csgcMappedReadU32At(
        reader, section.payloadOffset)
    if !countRead.ok:
        return strings.CloneStr(countRead.error)
    if countRead.value != section.itemCount:
        return "csgc_mapped_section_fact_count_mismatch"
    var cursor = countRead.nextOffset
    for lineIndex in 0..<section.itemCount:
        let tokenCountRead = csgcMappedReadVarint(
            reader,
            cursor,
            sectionEnd)
        if !tokenCountRead.ok:
            return strings.CloneStr(tokenCountRead.error)
        let tokenCount = tokenCountRead.value
        cursor = tokenCountRead.nextOffset
        if tokenCount < 0 || int64(tokenCount) > sectionEnd - cursor:
            return "csgc_mapped_token_count_out_of_range"
        for tokenIndex in 0..<tokenCount:
            let tagRead = csgcMappedReadByteAt(reader, cursor)
            if !tagRead.ok:
                return strings.CloneStr(tagRead.error)
            cursor = tagRead.nextOffset
            if tagRead.value == csgc.CsgCoreCsgcTokenDictRef:
                let refRead = csgcMappedReadVarint(
                    reader,
                    cursor,
                    sectionEnd)
                if !refRead.ok:
                    return strings.CloneStr(refRead.error)
                cursor = refRead.nextOffset
                if refRead.value < 0 ||
                   refRead.value >= dictionaryCount:
                    return "csgc_mapped_bad_dict_ref"
                let key = strings.IntToStr(refRead.value)
                var slot: int32
                if !tables.TableTryGet[int32](
                        out.dictionaryRefs, key, slot):
                    slot = out.resolvedRefs.len
                    add(out.resolvedRefs, "")
                    let beforeLen = tables.TableLen[int32](
                        out.dictionaryRefs)
                    tables.TablePut[int32](
                        out.dictionaryRefs,
                        strings.CloneStr(key),
                        slot)
                    var committedSlot: int32
                    if !tables.TableTryGet[int32](
                            out.dictionaryRefs,
                            key,
                            committedSlot) ||
                       committedSlot != slot ||
                       tables.TableLen[int32](out.dictionaryRefs) !=
                           beforeLen + 1:
                        return "csgc_mapped_dict_ref_index_failed"
            elif tagRead.value ==
                   csgc.CsgCoreCsgcTokenInlineUtf8:
                let lengthRead = csgcMappedReadVarint(
                    reader,
                    cursor,
                    sectionEnd)
                if !lengthRead.ok:
                    return strings.CloneStr(lengthRead.error)
                let inlineLength = lengthRead.value
                cursor = lengthRead.nextOffset
                if inlineLength <= 0 ||
                   int64(inlineLength) > sectionEnd - cursor:
                    return "csgc_mapped_inline_range_out_of_bounds"
                let inlineResult = csgcMappedReadUtf8String(
                    reader, cursor, inlineLength)
                if IsErr(inlineResult):
                    return strings.CloneStr(Error(inlineResult))
                let inlineToken = Value(inlineResult)
                if !tables.TableHas[bool](
                        out.inlineTokens, inlineToken):
                    tables.TablePut[bool](
                        out.inlineTokens,
                        strings.CloneStr(inlineToken),
                        true)
                    if !tables.TableHas[bool](
                            out.inlineTokens, inlineToken):
                        return "csgc_mapped_inline_index_failed"
                cursor = cursor + int64(inlineLength)
            else:
                return "csgc_mapped_unsupported_token_tag"
    if cursor != sectionEnd:
        return "csgc_mapped_non_canonical_fact_section_size"
    return ""

fn csgcMappedCollectDecodeNeeds(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32): csgCoreCsgcMappedDecodeNeeds =
    var out = csgcMappedDecodeNeedsInit()
    let error = csgcMappedCollectDecodeNeedsInto(
        reader, sectionIndex, out)
    if error.len > 0:
        return csgcMappedNeedsFail(error)
    out.ok = true
    return out

fn csgcMappedResolveDictionary(
        reader: var CsgCoreCsgcMappedReader,
        needs: var csgCoreCsgcMappedDecodeNeeds): str =
    if reader.sections.len < 1:
        return "csgc_mapped_dictionary_missing"
    if needs.dictionary.len != 0:
        return "csgc_mapped_dictionary_resolution_reused"
    let section = reader.sections[0]
    let sectionEnd = section.payloadOffset +
        int64(section.payloadLength)
    let countRead = csgcMappedReadU32At(
        reader, section.payloadOffset)
    if !countRead.ok:
        return strings.CloneStr(countRead.error)
    if countRead.value != section.itemCount:
        return "csgc_mapped_dictionary_count_mismatch"
    var previous: str
    var cursor = countRead.nextOffset
    for dictionaryIndex in 0..<section.itemCount:
        let lengthRead = csgcMappedReadVarint(
            reader,
            cursor,
            sectionEnd)
        if !lengthRead.ok:
            return strings.CloneStr(lengthRead.error)
        let itemLength = lengthRead.value
        cursor = lengthRead.nextOffset
        if itemLength < 2 ||
           int64(itemLength) > sectionEnd - cursor:
            return "csgc_mapped_dictionary_range_out_of_bounds"
        let itemResult = csgcMappedReadUtf8String(
            reader, cursor, itemLength)
        if IsErr(itemResult):
            return strings.CloneStr(Error(itemResult))
        let item = Value(itemResult)
        if dictionaryIndex > 0 &&
           csgcMappedUtf8ByteCompare(previous, item) >= 0:
            return "csgc_mapped_non_canonical_dictionary_order"
        if tables.TableHas[bool](needs.inlineTokens, item):
            return "csgc_mapped_non_canonical_inline_dictionary_token"
        add(needs.dictionary, strings.CloneStr(item))
        let key = strings.IntToStr(dictionaryIndex)
        var slot: int32
        if tables.TableTryGet[int32](
                needs.dictionaryRefs, key, slot):
            if slot < 0 || slot >= needs.resolvedRefs.len ||
               needs.resolvedRefs[slot].len != 0:
                return "csgc_mapped_dictionary_resolution_invalid"
            needs.resolvedRefs[slot] = strings.CloneStr(item)
        previous = strings.CloneStr(item)
        cursor = cursor + int64(itemLength)
    if cursor != sectionEnd:
        return "csgc_mapped_non_canonical_dictionary_section_size"
    if tables.TableLen[int32](needs.dictionaryRefs) !=
       needs.resolvedRefs.len:
        return "csgc_mapped_dictionary_resolution_count_mismatch"
    if needs.dictionary.len != section.itemCount:
        return "csgc_mapped_dictionary_projection_count_mismatch"
    for slot in 0..<needs.resolvedRefs.len:
        if needs.resolvedRefs[slot].len == 0:
            return "csgc_mapped_dictionary_reference_unresolved"
    return ""

@borrows
fn csgcMappedLinesFail(
        message: str): csgCoreCsgcMappedLinesResult =
    var out: csgCoreCsgcMappedLinesResult
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgcMappedDecodeFactLines(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32,
        kind: str,
        needs: var csgCoreCsgcMappedDecodeNeeds):
        csgCoreCsgcMappedLinesResult =
    let section = reader.sections[sectionIndex]
    let sectionEnd = section.payloadOffset +
        int64(section.payloadLength)
    let countRead = csgcMappedReadU32At(
        reader, section.payloadOffset)
    if !countRead.ok || countRead.value != section.itemCount:
        return csgcMappedLinesFail(
            "csgc_mapped_section_fact_count_mismatch")
    var lines: str[]
    var cursor = countRead.nextOffset
    for lineIndex in 0..<section.itemCount:
        let tokenCountRead = csgcMappedReadVarint(
            reader,
            cursor,
            sectionEnd)
        if !tokenCountRead.ok:
            return csgcMappedLinesFail(tokenCountRead.error)
        let tokenCount = tokenCountRead.value
        cursor = tokenCountRead.nextOffset
        if tokenCount < 0 || int64(tokenCount) > sectionEnd - cursor:
            return csgcMappedLinesFail(
                "csgc_mapped_token_count_out_of_range")
        var lineBuffer = csgcMappedByteBufInit(reader, 64)
        var wireTokens: str[]
        for tokenIndex in 0..<tokenCount:
            let tagRead = csgcMappedReadByteAt(reader, cursor)
            if !tagRead.ok:
                csgcMappedByteBufFree(reader, lineBuffer)
                return csgcMappedLinesFail(tagRead.error)
            cursor = tagRead.nextOffset
            if tagRead.value == csgc.CsgCoreCsgcTokenDictRef:
                let refRead = csgcMappedReadVarint(
                    reader,
                    cursor,
                    sectionEnd)
                if !refRead.ok:
                    csgcMappedByteBufFree(reader, lineBuffer)
                    return csgcMappedLinesFail(refRead.error)
                cursor = refRead.nextOffset
                let key = strings.IntToStr(refRead.value)
                var slot: int32
                if !tables.TableTryGet[int32](
                        needs.dictionaryRefs, key, slot) ||
                   slot < 0 || slot >= needs.resolvedRefs.len ||
                   needs.resolvedRefs[slot].len == 0:
                    csgcMappedByteBufFree(reader, lineBuffer)
                    return csgcMappedLinesFail(
                        "csgc_mapped_bad_dict_ref")
                let tokenView = rawbytes.BytesFromString(
                    needs.resolvedRefs[slot])
                csgcMappedByteBufAppendBytes(
                    reader, lineBuffer, tokenView)
                add(wireTokens, strings.CloneStr(
                    needs.resolvedRefs[slot]))
            elif tagRead.value ==
                   csgc.CsgCoreCsgcTokenInlineUtf8:
                let lengthRead = csgcMappedReadVarint(
                    reader,
                    cursor,
                    sectionEnd)
                if !lengthRead.ok:
                    csgcMappedByteBufFree(reader, lineBuffer)
                    return csgcMappedLinesFail(lengthRead.error)
                let inlineLength = lengthRead.value
                cursor = lengthRead.nextOffset
                if inlineLength <= 0 ||
                   int64(inlineLength) > sectionEnd - cursor:
                    csgcMappedByteBufFree(reader, lineBuffer)
                    return csgcMappedLinesFail(
                        "csgc_mapped_inline_range_out_of_bounds")
                let inlineResult = csgcMappedReadUtf8String(
                    reader, cursor, inlineLength)
                if IsErr(inlineResult):
                    csgcMappedByteBufFree(reader, lineBuffer)
                    return csgcMappedLinesFail(Error(inlineResult))
                let inlineToken = Value(inlineResult)
                if !tables.TableHas[bool](
                        needs.inlineTokens, inlineToken):
                    csgcMappedByteBufFree(reader, lineBuffer)
                    return csgcMappedLinesFail(
                        "csgc_mapped_inline_token_not_indexed")
                let tokenView = rawbytes.BytesFromString(inlineToken)
                csgcMappedByteBufAppendBytes(
                    reader, lineBuffer, tokenView)
                add(wireTokens, inlineToken)
                cursor = cursor + int64(inlineLength)
            else:
                csgcMappedByteBufFree(reader, lineBuffer)
                return csgcMappedLinesFail(
                    "csgc_mapped_unsupported_token_tag")
        var lineBytes = csgcMappedByteBufToBytes(reader, lineBuffer)
        let line = rawbytes.BytesToString(lineBytes)
        csgcMappedOwnedScratchFree(reader, lineBytes)
        csgcMappedByteBufFree(reader, lineBuffer)
        let canonicalTokens =
            csgc.CsgCoreCsgcTokenizeCanonicalLine(line)
        if canonicalTokens.len != wireTokens.len:
            return csgcMappedLinesFail(
                "csgc_mapped_non_canonical_token_stream")
        for tokenIndex in 0..<canonicalTokens.len:
            if canonicalTokens[tokenIndex] != wireTokens[tokenIndex]:
                return csgcMappedLinesFail(
                    "csgc_mapped_non_canonical_token_stream")
        let lineKind = field.CsgCoreJsonKind(line)
        if !lineKind.found || lineKind.value != kind:
            return csgcMappedLinesFail(
                "csgc_mapped_fact_kind_section_mismatch")
        add(lines, line)
    if cursor != sectionEnd:
        return csgcMappedLinesFail(
            "csgc_mapped_non_canonical_fact_section_size")
    let physicalOrder =
        merkle_dag.CsgCoreMerklePhysicalOrder(lines)
    if !physicalOrder.ok ||
       physicalOrder.canonicalLines.len != lines.len:
        return csgcMappedLinesFail(
            "csgc_mapped_fact_order_failed")
    for lineIndex in 0..<lines.len:
        if physicalOrder.canonicalLines[lineIndex] != lines[lineIndex]:
            return csgcMappedLinesFail(
                "csgc_mapped_non_canonical_fact_order")
    var out: csgCoreCsgcMappedLinesResult
    out.ok = true
    out.lines = lines
    return out

fn csgcMappedWholeObjectCanonicalSeal(
        reader: var CsgCoreCsgcMappedReader): bool =
    reader.canonicalSealVerified = false
    reader.canonicalSealFactCount = 0
    reader.canonicalSealSectionCount = 0
    if reader.sections.len < 1:
        return false

    var needs = csgcMappedDecodeNeedsInit()
    for sectionIndex in 0..<reader.sections.len:
        if !csgcMappedVerifySectionForCanonicalSeal(
                reader, sectionIndex):
            return false
        if sectionIndex > 0:
            let needsError = csgcMappedCollectDecodeNeedsInto(
                reader, sectionIndex, needs)
            if needsError.len > 0:
                return false

    let dictionaryError = csgcMappedResolveDictionary(
        reader, needs)
    if dictionaryError.len > 0:
        return false
    needs.ok = true

    var groupedLines: str[]
    for sectionIndex in 1..<reader.sections.len:
        let section = reader.sections[sectionIndex]
        let kindResult = csgcMappedReadUtf8String(
            reader, section.kindOffset, section.kindLength)
        if IsErr(kindResult):
            return false
        let kind = Value(kindResult)
        var decoded = csgcMappedDecodeFactLines(
            reader, sectionIndex, kind, needs)
        if !decoded.ok:
            return false
        for lineIndex in 0..<decoded.lines.len:
            var line = decoded.lines[lineIndex]
            decoded.lines[lineIndex] = ""
            add(groupedLines, line)
    if groupedLines.len != reader.factCount:
        return false
    let projectionError =
        csgc.CsgCoreCsgcCanonicalProjectionError(
            groupedLines, needs.dictionary)
    if projectionError.len > 0:
        return false

    reader.canonicalSealFactCount = groupedLines.len
    reader.canonicalSealSectionCount = reader.sections.len
    reader.canonicalSealVerified = true
    return true

fn csgcMappedLoadOrdinalSection(
        reader: var CsgCoreCsgcMappedReader): str =
    if reader.ordinalLines.len > 0:
        return ""
    while reader.ordinalSectionIndex < reader.sections.len:
        let sectionIndex = reader.ordinalSectionIndex
        let section = reader.sections[sectionIndex]
        if sectionIndex <= 0 ||
           reader.ordinalSectionStart != reader.ordinalNext:
            return "csgc_mapped_ordinal_cursor_invalid"
        if section.itemCount == 0:
            reader.ordinalSectionIndex = sectionIndex + 1
            continue
        let kindResult = csgcMappedReadUtf8String(
            reader, section.kindOffset, section.kindLength)
        if IsErr(kindResult):
            return strings.CloneStr(Error(kindResult))
        let kind = Value(kindResult)
        var needs = csgcMappedCollectDecodeNeeds(
            reader, sectionIndex)
        if !needs.ok:
            return strings.CloneStr(needs.error)
        let dictionaryError = csgcMappedResolveDictionary(
            reader, needs)
        if dictionaryError.len > 0:
            return dictionaryError
        var decoded = csgcMappedDecodeFactLines(
            reader, sectionIndex, kind, needs)
        if !decoded.ok ||
           decoded.lines.len != section.itemCount:
            return "csgc_mapped_ordinal_section_invalid"
        reader.ordinalLines = decoded.lines
        decoded.lines = []
        return ""
    if reader.ordinalNext != reader.factCount:
        return "csgc_mapped_ordinal_traversal_truncated"
    return ""

fn CsgCoreCsgcMappedReaderReadOrdinal(
        reader: var CsgCoreCsgcMappedReader,
        ordinal: int32): Result[CsgCoreCsgcMappedOrdinalFact] =
    if !csgcMappedReaderAuthorized(reader) ||
       !reader.runtimeOwner.verifiedTreeScope:
        return Err[CsgCoreCsgcMappedOrdinalFact](
            "csgc_mapped_ordinal_reader_closed")
    if ordinal != reader.ordinalNext ||
       ordinal < 0 || ordinal >= reader.factCount:
        return Err[CsgCoreCsgcMappedOrdinalFact](
            "csgc_mapped_ordinal_not_next")
    let loadError = csgcMappedLoadOrdinalSection(reader)
    if loadError.len > 0:
        return Err[CsgCoreCsgcMappedOrdinalFact](loadError)
    let localOrdinal = ordinal - reader.ordinalSectionStart
    if localOrdinal < 0 ||
       localOrdinal >= reader.ordinalLines.len:
        return Err[CsgCoreCsgcMappedOrdinalFact](
            "csgc_mapped_ordinal_section_range_invalid")
    let line = strings.CloneStr(reader.ordinalLines[localOrdinal])
    var factError: str
    let factDigest = merkle_dag.CsgCoreMerkleFactHash(
        line, factError)
    if factError.len > 0 ||
       layout.FixedBytes32Equal(
           factDigest, layout.FixedBytes32()):
        return Err[CsgCoreCsgcMappedOrdinalFact](
            "csgc_mapped_ordinal_fact_invalid")
    reader.ordinalNext = ordinal + 1
    if localOrdinal + 1 == reader.ordinalLines.len:
        reader.ordinalSectionStart = reader.ordinalNext
        reader.ordinalSectionIndex =
            reader.ordinalSectionIndex + 1
        csgcMappedReleaseOrdinalLines(reader)
    var out: CsgCoreCsgcMappedOrdinalFact
    out.ordinal = ordinal
    out.line = line
    out.factDigest = factDigest
    return Ok[CsgCoreCsgcMappedOrdinalFact](out)

@borrows
fn CsgCoreCsgcMappedReaderOrdinalTraversalComplete(
        reader: CsgCoreCsgcMappedReader): bool =
    return csgcMappedReaderAuthorized(reader) &&
        reader.runtimeOwner.verifiedTreeScope &&
        reader.ordinalNext == reader.factCount &&
        reader.ordinalSectionStart == reader.factCount &&
        reader.ordinalLines.len == 0

@borrows
fn csgcMappedDecodeFail(
        reader: var CsgCoreCsgcMappedReader,
        message: str): csgc.CsgCoreCsgcLazyLinesResult =
    return csgcMappedLazyFail(
        CsgCoreCsgcMappedManagedErrorCloseHardRedReason)

@borrows
fn CsgCoreCsgcMappedReaderDecodeFactKind(
        reader: var CsgCoreCsgcMappedReader,
        kind: str): csgc.CsgCoreCsgcLazyLinesResult =
    if !csgcMappedReaderAuthorized(reader):
        return csgcMappedLazyFail("csgc_mapped_reader_closed")
    if kind.len == 0:
        return csgcMappedDecodeFail(
            reader, "csgc_mapped_fact_kind_empty")
    let directoryCidResult =
        CsgCoreCsgcMappedReaderDirectoryCid(reader)
    if IsErr(directoryCidResult):
        return csgcMappedDecodeFail(
            reader, Error(directoryCidResult))
    let directoryCid = Value(directoryCidResult)
    let dictionaryVerified =
        CsgCoreCsgcMappedReaderVerifySection(reader, 0)
    if IsErr(dictionaryVerified):
        return csgcMappedDecodeFail(
            reader, Error(dictionaryVerified))
    let sectionResult =
        CsgCoreCsgcMappedReaderFindSection(reader, kind)
    if IsErr(sectionResult):
        return csgcMappedDecodeFail(
            reader, Error(sectionResult))
    let sectionIndex = Value(sectionResult)
    if sectionIndex < 0:
        var missing: csgc.CsgCoreCsgcLazyLinesResult
        missing.ok = true
        missing.kind = strings.CloneStr(kind)
        missing.totalFactCount = reader.factCount
        missing.directoryBytes = reader.directorySize
        missing.claimedDirectoryCid = strings.CloneStr(directoryCid)
        return missing
    let sectionVerified =
        CsgCoreCsgcMappedReaderVerifySection(
            reader, sectionIndex)
    if IsErr(sectionVerified):
        return csgcMappedDecodeFail(
            reader, Error(sectionVerified))
    var needs = csgcMappedCollectDecodeNeeds(
        reader, sectionIndex)
    if !needs.ok:
        return csgcMappedDecodeFail(reader, needs.error)
    let dictionaryError = csgcMappedResolveDictionary(
        reader, needs)
    if dictionaryError.len > 0:
        return csgcMappedDecodeFail(reader, dictionaryError)
    let decoded = csgcMappedDecodeFactLines(
        reader, sectionIndex, kind, needs)
    if !decoded.ok:
        return csgcMappedDecodeFail(reader, decoded.error)
    let dictionaryBytes = reader.sections[0].payloadLength
    let sectionBytes = reader.sections[sectionIndex].payloadLength
    if dictionaryBytes > 2147483647 - sectionBytes:
        return csgcMappedDecodeFail(
            reader, "csgc_mapped_decoded_section_size_overflow")
    var out: csgc.CsgCoreCsgcLazyLinesResult
    out.ok = true
    out.found = true
    out.kind = strings.CloneStr(kind)
    out.lines = decoded.lines
    out.totalFactCount = reader.factCount
    out.decodedFactCount = reader.sections[sectionIndex].itemCount
    out.dictionaryCount = reader.sections[0].itemCount
    out.directoryBytes = reader.directorySize
    out.decodedSectionBytes = dictionaryBytes + sectionBytes
    out.claimedDirectoryCid = strings.CloneStr(directoryCid)
    return out

@borrows
fn CsgCoreCsgcMappedReaderAllocationReceipt(
        reader: CsgCoreCsgcMappedReader,
        canonicalReceiptCargo: rawbytes.Bytes):
        CsgCoreCsgcMappedAllocationReceipt =
    let state = reader.runtimeOwner
    let receipt = state.closeReceipt
    var out: CsgCoreCsgcMappedAllocationReceipt
    out.beginAttempted = state.beginAttempted
    out.ownerActivated = state.ownerGeneration != uint64(0)
    out.mappingReceiptValid = state.mappingReceiptValid
    out.objectDigestVerified = state.objectDigestVerified
    out.objectDigestCount = state.objectDigestCount
    out.verifiedByteLength = state.verifiedByteLength
    out.closeAttempted = state.closeAttempted
    out.closeSucceeded = state.closeSucceeded
    out.expectedObjectCid = state.expectedObjectCid
    out.expectedObjectCidValid = state.expectedObjectCidValid
    out.complete = receipt.complete
    out.active = receipt.active
    out.closed = receipt.closed
    out.allocationId = receipt.allocationId
    out.capabilityGeneration = state.ownerGeneration
    out.ownerGeneration = receipt.ownerGeneration
    out.operation = receipt.operation
    out.storageKind = receipt.storageKind
    out.allocationGeneration = receipt.allocationGeneration
    out.slabId = receipt.slabId
    out.slabGeneration = receipt.slabGeneration
    out.slabBackingBytes = receipt.slabBackingBytes
    out.backingDeltaBytes = receipt.backingDeltaBytes
    out.reallocOverlapUsableBytes =
        receipt.reallocOverlapUsableBytes
    out.requestedPayloadBytes = receipt.requestedPayloadBytes
    out.usablePayloadBytes = receipt.usablePayloadBytes
    out.headerBytes = receipt.headerBytes
    out.backingBytes = receipt.backingBytes
    out.alignmentBytes = receipt.alignmentBytes
    out.allocatorLayoutCid = csgcMappedRuntimeCidToFixed(
        receipt.allocatorLayoutCid)
    out.ownerDomainCid = csgcMappedRuntimeCidToFixed(
        receipt.ownerDomainCid)
    out.eventChainCid = csgcMappedRuntimeCidToFixed(
        receipt.eventChainCid)
    out.backingLimit = receipt.backingLimit
    out.receiptCid = csgcMappedRuntimeCidToFixed(
        receipt.receiptCid)
    out.controlPlaneBackingBytes = receipt.controlPlaneBackingBytes
    out.liveBackingBytes = receipt.liveBackingBytes
    out.peakBackingBytes = receipt.peakBackingBytes
    out.liveMappedVirtualBytes = receipt.liveMappedVirtualBytes
    out.peakMappedVirtualBytes = receipt.peakMappedVirtualBytes
    out.liveAllocationCount = receipt.liveAllocationCount
    out.peakAllocationCount = receipt.peakAllocationCount
    out.liveMappingCount = receipt.liveMappingCount
    out.eventIndex = receipt.eventIndex
    out.liveHandleCount = receipt.liveHandleCount
    out.peakHandleCount = receipt.peakHandleCount
    out.rawManagedPointerAbaProven =
        receipt.rawManagedPointerAbaProven
    out.recursiveLockProven = receipt.recursiveLockProven
    # The runtime exposes both chained CIDs but not canonical cargo bytes or a
    # native execution identity. The manifest verifier reconstructs the
    # canonical receipt cargo (the 436-byte wire preimage) after close and
    # hands it back through this projection; presence is reported from the
    # actual cargo bytes, never asserted without them. Production admission
    # stays rejected until the native launcher identity is bound.
    out.ownerDomainCidPresent = !layout.FixedBytes32Equal(
        out.ownerDomainCid, layout.FixedBytes32())
    out.eventChainCidPresent = !layout.FixedBytes32Equal(
        out.eventChainCid, layout.FixedBytes32())
    out.canonicalReceiptCargoPresent =
        rawbytes.BytesLen(canonicalReceiptCargo) ==
        CsgCoreCsgcMappedCanonicalReceiptCargoBytes
    out.receiptCidRecomputed = false
    out.nativeExecutionIdentityPresent = false
    # The runtime close certifies both production proofs after the drain
    # verification, and the receipt wire records the session's peak backing
    # against its admitted limit. The reader projects both facts directly;
    # the manifest verifier still owns transcript reconstruction and cargo.
    out.allocationLedgerProven =
        state.closeSucceeded &&
        receipt.rawManagedPointerAbaProven &&
        receipt.recursiveLockProven
    out.totalHeapBounded =
        state.closeSucceeded &&
        receipt.peakBackingBytes <= receipt.backingLimit
    out.productionReady = false
    out.hardRedCode = CsgCoreCsgcMappedAllocationHardRed
    if !state.beginAttempted:
        out.hardRedReason =
            CsgCoreCsgcMappedCliPreallocationHardRedReason
    elif !state.closeSucceeded:
        out.hardRedReason =
            CsgCoreCsgcMappedOwnerCloseHardRedReason
    else:
        out.hardRedReason =
            CsgCoreCsgcMappedReceiptCargoHardRedReason
    return out

fn CsgCoreCsgcMappedReaderReadSectionWindowCopy(
        reader: var CsgCoreCsgcMappedReader,
        sectionIndex: int32,
        sectionOffset: int32,
        length: int32): Result[rawbytes.Bytes] =
    if !csgcMappedReaderAuthorized(reader):
        return Err[rawbytes.Bytes]("csgc_mapped_reader_closed")
    if sectionIndex < 0 || sectionIndex >= reader.sections.len:
        return Err[rawbytes.Bytes](csgcMappedOperationError(
            reader, "csgc_mapped_section_index_out_of_range"))
    let section = reader.sections[sectionIndex]
    if sectionOffset < 0 || length <= 0 ||
       length > CsgCoreCsgcMappedWindowMax ||
       length > section.payloadLength ||
       sectionOffset > section.payloadLength - length:
        return Err[rawbytes.Bytes](csgcMappedOperationError(
            reader, "csgc_mapped_section_window_out_of_range"))
    let verified = CsgCoreCsgcMappedReaderVerifySection(
        reader, sectionIndex)
    if IsErr(verified):
        return Err[rawbytes.Bytes](Error(verified))
    let copyResult = csgcMappedReadWindow(
        reader,
        section.payloadOffset + int64(sectionOffset),
        length)
    if IsErr(copyResult):
        return Err[rawbytes.Bytes](csgcMappedOperationError(
            reader, Error(copyResult)))
    return copyResult

fn CsgCoreCsgcMappedReaderClose(
        reader: var CsgCoreCsgcMappedReader): Result[bool] =
    let _ = reader
    return Err[bool](CsgCoreCsgcMappedSessionScopeHardRedReason)

fn csgcMappedVerifiedTreeClose(
        reader: var CsgCoreCsgcMappedReader,
        requireComplete: bool): Result[bool] =
    if !reader.runtimeOwner.verifiedTreeScope ||
       !reader.runtimeOwner.active ||
       reader.runtimeOwner.closeAttempted:
        return Err[bool](
            "csgc_mapped_verified_tree_close_invalid")
    if requireComplete &&
       !CsgCoreCsgcMappedReaderOrdinalTraversalComplete(reader):
        return Err[bool](
            "csgc_mapped_verified_tree_traversal_incomplete")
    let digestValid = csgcMappedObjectDigestReceiptValid(reader)
    csgcMappedReleaseOrdinalLines(reader)
    csgcMappedReleaseSections(reader)
    let ownersClosed = csgcMappedCloseOsOwners(reader)
    reader = CsgCoreCsgcMappedReader()
    if !ownersClosed:
        return Err[bool](
            "csgc_mapped_verified_tree_owner_close_failed")
    if !digestValid:
        panic("csgc mapped verified tree: digest receipt drift")
    return Ok[bool](true)

fn CsgCoreCsgcMappedReaderVerifiedTreeFinish(
        reader: var CsgCoreCsgcMappedReader): Result[bool] =
    return csgcMappedVerifiedTreeClose(reader, true)

fn CsgCoreCsgcMappedReaderVerifiedTreePoison(
        reader: var CsgCoreCsgcMappedReader): Result[bool] =
    return csgcMappedVerifiedTreeClose(reader, false)

fn CsgCoreCsgcMappedReaderSessionClose(
        reader: var CsgCoreCsgcMappedReader,
        owner: var system.RuntimeAllocationLedgerSessionCapability):
        Result[bool] =
    # Session-scoped close: unmap and release this reader, prove the drain
    # from a fresh snapshot, then hand the still-active owner capability
    # remains with the process entry. The session owner itself is closed once
    # entry through CsgCoreCsgcMappedSessionOwnerClose.
    if !reader.runtimeOwner.sessionScope:
        return Err[bool](
            CsgCoreCsgcMappedSessionScopeHardRedReason)
    if reader.runtimeOwner.closeAttempted ||
       !reader.runtimeOwner.active:
        return Err[bool](
            CsgCoreCsgcMappedOwnerCloseHardRedReason)
    let objectDigestReceiptValid = csgcMappedObjectDigestReceiptValid(reader)
    if owner.generation != reader.runtimeOwner.ownerGeneration:
        return Err[bool](CsgCoreCsgcMappedOwnerCloseHardRedReason)
    if !csgcMappedRuntimeOwnerSessionDetach(reader, owner):
        return Err[bool](
            CsgCoreCsgcMappedOwnerCloseHardRedReason)
    if !objectDigestReceiptValid:
        panic("csgc_mapped_object_digest_receipt_close_mismatch")
    return Ok[bool](true)
