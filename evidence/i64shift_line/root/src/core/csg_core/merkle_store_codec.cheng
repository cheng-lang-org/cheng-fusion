import std/rawbytes
import std/result
import std/seqs
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag

const
    CsgMerkleStoreCanonicalCsgcObjectDomain: str =
        "csg_core.store.canonical_csgc_object"
    CsgMerkleStoreNodeSegmentDomain: str = "csg_core.store.node_segment"
    CsgMerkleStoreLeafKind: str = "csg.merkle.node.leaf"
    CsgMerkleStoreBranchKind: str = "csg.merkle.node.branch"
    CsgMerkleStoreHeadDomain: str = "csg_core.store.head"
    CsgMerkleStoreHeadKind: str = "csg.merkle.head"
    CsgMerkleStoreMaxGeneration: int64 = 9223372036854775806

type
    CsgCoreMerkleNodeSegmentResult =
        ok: bool
        error: str
        cid: str
        nodeCount: int32
        byteCount: int32
        lines: str[]
        nodes: merkle_dag.CsgCoreMerkleNodeRecord[]
        bytes: rawbytes.Bytes

    CsgCoreMerkleStoreHeadIdentity =
        generation: int64
        manifestCid: str
        previousHeadCid: str
        receiptCid: str
        headCid: str

    CsgCoreMerkleStoreHeadCodecResult =
        ok: bool
        error: str
        head: CsgCoreMerkleStoreHeadIdentity
        bytes: rawbytes.Bytes

@borrows
fn csgStoreCodecCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgStoreCodecAppend(
        out: var str,
        part: str) =
    out = csgStoreCodecCat(out, part)

@borrows
fn csgStoreCodecJsonString(text: str): str =
    return canonical.CsgCoreJsonQuote(text)

@borrows
fn CsgCoreMerkleStoreJsonString(
        text: str): str =
    return csgStoreCodecJsonString(text)

fn csgStoreCodecAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(
        buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(
        buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(
        buf, (value >> 24) & 255)

@borrows
fn csgStoreCodecAppendText(
        buf: var layout.ByteBuf,
        text: str) =
    csgStoreCodecAppendU32(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

@borrows
fn csgStoreCodecWriteU32(
        heap: var rawbytes.Bytes,
        offset: int32,
        value: int32) =
    rawbytes.BytesSet(heap, offset, value & 255)
    rawbytes.BytesSet(heap, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(heap, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(heap, offset + 3, (value >> 24) & 255)

@borrows
fn csgStoreCodecCidDigest(
        domain: str,
        bytes: rawbytes.Bytes): layout.FixedBytes32 =
    let byteCount = rawbytes.BytesLen(bytes)
    let total = 4 + domain.len + 4 + byteCount
    var heap = rawbytes.BytesAlloc(total)
    csgStoreCodecWriteU32(heap, 0, domain.len)
    var di: int32
    while di < domain.len:
        rawbytes.BytesSet(heap, 4 + di, domain[di])
        di = di + 1
    csgStoreCodecWriteU32(heap, 4 + domain.len, byteCount)
    var bi: int32
    while bi < byteCount:
        rawbytes.BytesSet(
            heap,
            8 + domain.len + bi,
            rawbytes.BytesGet(bytes, bi))
        bi = bi + 1
    var heapSpan = layout.ByteSpanFromBytes(heap)
    var heapSpanData = heapSpan.data
    let digest = hash256.Sha256Fixed(heapSpan)
    rawbytes.BytesFree(heapSpanData)
    rawbytes.BytesFree(heap)
    return digest

@borrows
fn csgStoreCodecCidBytes(
        domain: str,
        bytes: rawbytes.Bytes): str =
    let digest = csgStoreCodecCidDigest(domain, bytes)
    return csgStoreCodecCat(
        "sha256:",
        layout.FixedBytes32Hex(digest))

@borrows
fn CsgCoreMerkleStoreDomainBytesCid(
        domain: str,
        bytes: rawbytes.Bytes): str =
    if domain.len == 0 ||
       rawbytes.BytesLen(bytes) < 0:
        return "invalid:merkle_store_domain_bytes"
    return csgStoreCodecCidBytes(
        domain, bytes)

@borrows
fn CsgCoreMerkleStoreCanonicalCsgcObjectCid(
        bytes: rawbytes.Bytes): str =
    return CsgCoreMerkleStoreDomainBytesCid(
        CsgMerkleStoreCanonicalCsgcObjectDomain,
        bytes)

fn CsgCoreMerkleStoreCanonicalCsgcObjectDomain(): str =
    return strings.CloneStr(
        CsgMerkleStoreCanonicalCsgcObjectDomain)

@borrows
fn csgStoreCodecParseCid(
        text: str,
        out: var layout.FixedBytes32): bool =
    if text.len != 71 ||
       !strings.HasPrefix(text, "sha256:"):
        return false
    let hexText =
        strings.CloneStrRange(text, 7, 64)
    let parsed =
        layout.FixedBytes32FromHex(hexText)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return layout.FixedBytes32Hex(out) == hexText

@borrows
fn CsgCoreMerkleStoreCidValid(
        text: str): bool =
    var parsed: layout.FixedBytes32
    return csgStoreCodecParseCid(text, parsed) &&
        !layout.FixedBytes32Equal(
            parsed, layout.FixedBytes32())

@borrows
fn CsgCoreMerkleStoreCidName(cid: str): str =
    if !CsgCoreMerkleStoreCidValid(cid):
        return ""
    return strings.CloneStrRange(cid, 7, 64)

@borrows
fn CsgCoreMerkleStoreSuccessorName(
        previousHeadCid: str): str =
    if previousHeadCid == "none":
        return "genesis"
    return CsgCoreMerkleStoreCidName(previousHeadCid)

fn CsgCoreMerkleStoreGenerationName(
        generation: int64): str =
    if generation < int64(0) ||
       generation > CsgMerkleStoreMaxGeneration:
        return ""
    let digits = strings.Int64ToStr(generation)
    if digits.len > 20:
        return ""
    var out: str
    let padding = 20 - digits.len
    for i in 0..<padding:
        out = csgStoreCodecCat(out, "0")
    return csgStoreCodecCat(out, digits)

@borrows
fn CsgCoreMerkleStoreParseGenerationName(
        text: str,
        out: var int64): bool =
    if text.len != 20:
        return false
    var value: int64
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        let digit = int64(int32(ch) - int32('0'))
        if value >
           (CsgMerkleStoreMaxGeneration - digit) /
               int64(10):
            return false
        value = value * int64(10) + digit
    if CsgCoreMerkleStoreGenerationName(value) != text:
        return false
    out = value
    return true

fn CsgCoreMerkleStoreMaxGeneration(): int64 =
    return CsgMerkleStoreMaxGeneration

fn CsgCoreMerkleStoreSuccessorCategoryName(): str =
    return "successors"

fn CsgCoreMerkleStoreManifestCategoryName(): str =
    return "manifests"

fn CsgCoreMerkleStoreSuccessorFileName(): str =
    return "head.csgc"

fn CsgCoreMerkleStoreObjectFileName(): str =
    return "object.csgc"

@borrows
fn CsgCoreMerkleStoreParseInt32(
        text: str,
        out: var int32): bool =
    if text.len == 0:
        return false
    var negative = false
    var start: int32
    if text[0] == '-':
        negative = true
        start = 1
        if text.len == 1:
            return false
    if text.len - start > 1 && text[start] == '0':
        return false
    var magnitude: int64
    let limit =
        negative ? int64(2147483648) : int64(2147483647)
    for i in start..<text.len:
        if text[i] < '0' || text[i] > '9':
            return false
        let digit = int64(int32(text[i]) - int32('0'))
        if magnitude > (limit - digit) / int64(10):
            return false
        magnitude = magnitude * int64(10) + digit
    if negative:
        if magnitude == int64(0):
            return false
        if magnitude == int64(2147483648):
            out = -2147483647 - 1
        else:
            out = -int32(magnitude)
    else:
        out = int32(magnitude)
    return true

@borrows
fn csgStoreCodecInt32(
        text: str,
        out: var int32): bool =
    return CsgCoreMerkleStoreParseInt32(text, out)

@borrows
fn csgStoreCodecStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(
            line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgStoreCodecHeadFail(
        error: str):
        CsgCoreMerkleStoreHeadCodecResult =
    var out: CsgCoreMerkleStoreHeadCodecResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleStoreHeadCodecResultDrop(
        result: var CsgCoreMerkleStoreHeadCodecResult) =
    # Explicit deterministic release of a head codec result (decode or encode
    # product).  Mirrors CsgCoreMerkleTransactionReceiptCodecDropLines: the
    # owned strings/bytes move to locals and the fields reset to empty, so
    # per-generation walk loops release before the next iteration's decode
    # allocations instead of relying on overwrite-time release.
    var dropError = result.error
    var dropManifestCid = result.head.manifestCid
    var dropPreviousHeadCid = result.head.previousHeadCid
    var dropReceiptCid = result.head.receiptCid
    var dropHeadCid = result.head.headCid
    var dropBytes = result.bytes
    result.error = ""
    result.head = CsgCoreMerkleStoreHeadIdentity()
    result.bytes = rawbytes.Bytes()

@borrows
fn csgStoreCodecHeadLine(
        generation: int64,
        manifestCid: str,
        previousHeadCid: str,
        receiptCid: str): str =
    var out: str = "{\"generation\":"
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            CsgCoreMerkleStoreGenerationName(generation)))
    csgStoreCodecAppend(out, ",\"id\":\"head\"")
    csgStoreCodecAppend(
        out, ",\"kind\":\"csg.merkle.head\"")
    csgStoreCodecAppend(out, ",\"manifest_cid\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(manifestCid))
    csgStoreCodecAppend(
        out, ",\"previous_head_cid\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(previousHeadCid))
    csgStoreCodecAppend(out, ",\"receipt_cid\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(receiptCid))
    return csgStoreCodecCat(out, "}")

@borrows
fn CsgCoreMerkleStoreHeadEncodeWithReceipt(
        generation: int64,
        manifestCid: str,
        previousHeadCid: str,
        receiptCid: str):
        CsgCoreMerkleStoreHeadCodecResult =
    if CsgCoreMerkleStoreGenerationName(generation).len != 20 ||
       !CsgCoreMerkleStoreCidValid(manifestCid):
        return csgStoreCodecHeadFail(
            "merkle_store_head_identity_invalid")
    if generation == int64(0):
        if previousHeadCid != "none":
            return csgStoreCodecHeadFail(
                "merkle_store_head_initial_previous_invalid")
        if receiptCid != "none":
            return csgStoreCodecHeadFail(
                "merkle_store_head_initial_receipt_invalid")
    else:
        if !CsgCoreMerkleStoreCidValid(previousHeadCid):
            return csgStoreCodecHeadFail(
                "merkle_store_head_previous_invalid")
        if !CsgCoreMerkleStoreCidValid(receiptCid):
            return csgStoreCodecHeadFail(
                "merkle_store_head_receipt_required")
    let line = csgStoreCodecHeadLine(
        generation,
        manifestCid,
        previousHeadCid,
        receiptCid)
    let encoded = csgc.CsgCoreCsgcEncodeCanonicalLines([line])
    if !encoded.ok:
        return csgStoreCodecHeadFail(
            csgStoreCodecCat(
                "merkle_store_head_encode ",
                encoded.error))
    var out: CsgCoreMerkleStoreHeadCodecResult
    out.ok = true
    out.head.generation = generation
    out.head.manifestCid = strings.CloneStr(manifestCid)
    out.head.previousHeadCid = strings.CloneStr(previousHeadCid)
    out.head.receiptCid = strings.CloneStr(receiptCid)
    out.head.headCid = CsgCoreMerkleStoreDomainBytesCid(
        CsgMerkleStoreHeadDomain,
        encoded.bytes)
    out.bytes = encoded.bytes
    return out

@borrows
fn CsgCoreMerkleStoreHeadEncode(
        generation: int64,
        manifestCid: str,
        previousHeadCid: str):
        CsgCoreMerkleStoreHeadCodecResult =
    return CsgCoreMerkleStoreHeadEncodeWithReceipt(
        generation,
        manifestCid,
        previousHeadCid,
        "none")

@borrows
fn CsgCoreMerkleStoreHeadDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleStoreHeadCodecResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgStoreCodecHeadFail(
            csgStoreCodecCat(
                "merkle_store_head_decode ",
                decoded.error))
    if decoded.lines.len != 1:
        return csgStoreCodecHeadFail(
            "merkle_store_head_line_count_invalid")
    let kind = field.CsgCoreJsonKind(decoded.lines[0])
    var generationText: str
    var idText: str
    var manifestCid: str
    var previousHeadCid: str
    var receiptCid: str
    if !kind.found || kind.value != CsgMerkleStoreHeadKind ||
       !csgStoreCodecStringField(
           decoded.lines[0], "generation", generationText) ||
       !csgStoreCodecStringField(decoded.lines[0], "id", idText) ||
       !csgStoreCodecStringField(
           decoded.lines[0], "manifest_cid", manifestCid) ||
       !csgStoreCodecStringField(
           decoded.lines[0], "previous_head_cid", previousHeadCid) ||
       !csgStoreCodecStringField(
           decoded.lines[0], "receipt_cid", receiptCid) ||
       idText != "head":
        return csgStoreCodecHeadFail(
            "merkle_store_head_field_invalid")
    var generation: int64
    if !CsgCoreMerkleStoreParseGenerationName(
           generationText, generation):
        return csgStoreCodecHeadFail(
            "merkle_store_head_generation_invalid")
    var reencoded = CsgCoreMerkleStoreHeadEncodeWithReceipt(
        generation,
        manifestCid,
        previousHeadCid,
        receiptCid)
    if !reencoded.ok:
        return reencoded
    if !rawbytes.BytesEqual(bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgStoreCodecHeadFail(
            "merkle_store_head_non_canonical")
    var out: CsgCoreMerkleStoreHeadCodecResult
    out.ok = true
    out.head = reencoded.head
    rawbytes.BytesFree(reencoded.bytes)
    # Same-compilation decode memo: the head identity is a pure function of
    # the canonical head bytes, so the verified decode result is keyed by the
    # content digest of exactly these bytes.  Canonical equality was just
    # proven above, so key(bytes) == out.head.headCid.
    CsgCoreMerkleStoreHeadMemoInsertFromIdentity(
        CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleStoreHeadDomain, bytes),
        out.head)
    return out

@borrows
fn csgStoreCodecLeafLine(
        node: merkle_dag.CsgCoreMerkleNodeRecord):
        str =
    var out: str = "{\"count\":"
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            strings.IntToStr(node.count)))
    csgStoreCodecAppend(
        out, ",\"fact_hash\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            csgStoreCodecCat(
                "sha256:",
                layout.FixedBytes32Hex(
                    node.factHash))))
    csgStoreCodecAppend(out, ",\"id\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                node)))
    csgStoreCodecAppend(out, ",\"key\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(node.key))
    csgStoreCodecAppend(out, ",\"key_hash\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            csgStoreCodecCat(
                "sha256:",
                layout.FixedBytes32Hex(
                    node.keyHash))))
    csgStoreCodecAppend(
        out,
        ",\"kind\":\"csg.merkle.node.leaf\"}")
    return out

@borrows
fn csgStoreCodecBranchLine(
        node: merkle_dag.CsgCoreMerkleNodeRecord):
        str =
    var out: str = "{\"count\":"
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            strings.IntToStr(node.count)))
    csgStoreCodecAppend(out, ",\"id\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                node)))
    csgStoreCodecAppend(
        out,
        ",\"kind\":\"csg.merkle.node.branch\"")
    csgStoreCodecAppend(out, ",\"left_cid\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            csgStoreCodecCat(
                "sha256:",
                layout.FixedBytes32Hex(
                    node.leftHash))))
    csgStoreCodecAppend(out, ",\"left_count\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            strings.IntToStr(node.leftCount)))
    csgStoreCodecAppend(out, ",\"right_cid\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            csgStoreCodecCat(
                "sha256:",
                layout.FixedBytes32Hex(
                    node.rightHash))))
    csgStoreCodecAppend(out, ",\"right_count\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            strings.IntToStr(node.rightCount)))
    csgStoreCodecAppend(out, ",\"split_bit\":")
    csgStoreCodecAppend(
        out,
        csgStoreCodecJsonString(
            strings.IntToStr(node.splitBit)))
    csgStoreCodecAppend(out, "}")
    return out

@borrows
fn CsgCoreMerkleNodeRecordLine(
        node: merkle_dag.CsgCoreMerkleNodeRecord):
        str =
    let nodeError =
        merkle_dag.CsgCoreMerkleNodeRecordError(
            node)
    if nodeError.len > 0:
        return csgStoreCodecCat(
            "invalid:", nodeError)
    if node.kind ==
       merkle_dag.CsgCoreMerkleLeafNodeKind():
        return csgStoreCodecLeafLine(node)
    return csgStoreCodecBranchLine(node)

@borrows
fn csgStoreCodecDecodeLeaf(
        line: str,
        out: var merkle_dag.CsgCoreMerkleNodeRecord,
        error: var str): bool =
    var countText: str
    var idText: str
    var key: str
    var keyHashText: str
    var factHashText: str
    if !csgStoreCodecStringField(
           line, "count", countText) ||
       !csgStoreCodecStringField(
           line, "id", idText) ||
       !csgStoreCodecStringField(
           line, "key", key) ||
       !csgStoreCodecStringField(
           line, "key_hash", keyHashText) ||
       !csgStoreCodecStringField(
           line, "fact_hash", factHashText):
        error = "merkle_store_leaf_field_missing"
        return false
    out.kind =
        merkle_dag.CsgCoreMerkleLeafNodeKind()
    out.splitBit = -1
    out.key = strings.CloneStr(key)
    if !csgStoreCodecInt32(
           countText, out.count) ||
       !csgStoreCodecParseCid(
           idText, out.hash) ||
       !csgStoreCodecParseCid(
           keyHashText, out.keyHash) ||
       !csgStoreCodecParseCid(
           factHashText, out.factHash):
        error = "merkle_store_leaf_field_invalid"
        return false
    let nodeError =
        merkle_dag.CsgCoreMerkleNodeRecordError(
            out)
    if nodeError.len > 0:
        error = nodeError
        return false
    if CsgCoreMerkleNodeRecordLine(out) != line:
        error = "merkle_store_leaf_non_canonical"
        return false
    return true

@borrows
fn csgStoreCodecDecodeBranch(
        line: str,
        out: var merkle_dag.CsgCoreMerkleNodeRecord,
        error: var str): bool =
    var countText: str
    var idText: str
    var leftCidText: str
    var leftCountText: str
    var rightCidText: str
    var rightCountText: str
    var splitBitText: str
    if !csgStoreCodecStringField(
           line, "count", countText) ||
       !csgStoreCodecStringField(
           line, "id", idText) ||
       !csgStoreCodecStringField(
           line, "left_cid", leftCidText) ||
       !csgStoreCodecStringField(
           line, "left_count", leftCountText) ||
       !csgStoreCodecStringField(
           line, "right_cid", rightCidText) ||
       !csgStoreCodecStringField(
           line, "right_count", rightCountText) ||
       !csgStoreCodecStringField(
           line, "split_bit", splitBitText):
        error =
            "merkle_store_branch_field_missing"
        return false
    out.kind =
        merkle_dag.CsgCoreMerkleBranchNodeKind()
    if !csgStoreCodecInt32(
           countText, out.count) ||
       !csgStoreCodecParseCid(
           idText, out.hash) ||
       !csgStoreCodecParseCid(
           leftCidText, out.leftHash) ||
       !csgStoreCodecInt32(
           leftCountText, out.leftCount) ||
       !csgStoreCodecParseCid(
           rightCidText, out.rightHash) ||
       !csgStoreCodecInt32(
           rightCountText, out.rightCount) ||
       !csgStoreCodecInt32(
           splitBitText, out.splitBit):
        error =
            "merkle_store_branch_field_invalid"
        return false
    let nodeError =
        merkle_dag.CsgCoreMerkleNodeRecordError(
            out)
    if nodeError.len > 0:
        error = nodeError
        return false
    if CsgCoreMerkleNodeRecordLine(out) != line:
        error =
            "merkle_store_branch_non_canonical"
        return false
    return true

@borrows
fn CsgCoreMerkleNodeRecordDecode(
        line: str,
        out: var merkle_dag.CsgCoreMerkleNodeRecord,
        error: var str): bool =
    out = merkle_dag.CsgCoreMerkleNodeRecord()
    error = ""
    let kind = field.CsgCoreJsonKind(line)
    if !kind.found:
        error = "merkle_store_node_kind_missing"
        return false
    if kind.value == CsgMerkleStoreLeafKind:
        return csgStoreCodecDecodeLeaf(
            line, out, error)
    if kind.value == CsgMerkleStoreBranchKind:
        return csgStoreCodecDecodeBranch(
            line, out, error)
    error = "merkle_store_node_kind_invalid"
    return false

fn csgStoreCodecSegmentFail(
        error: str):
        CsgCoreMerkleNodeSegmentResult =
    var out: CsgCoreMerkleNodeSegmentResult
    out.error = error
    return out

@borrows
fn CsgCoreMerkleNodeSegmentEncode(
        nodes: merkle_dag.CsgCoreMerkleNodeRecord[]):
        CsgCoreMerkleNodeSegmentResult =
    if nodes.len <= 0:
        return csgStoreCodecSegmentFail(
            "merkle_store_node_segment_empty")
    var lines: str[]
    for i in 0..<nodes.len:
        let line =
            CsgCoreMerkleNodeRecordLine(nodes[i])
        if strings.HasPrefix(line, "invalid:"):
            return csgStoreCodecSegmentFail(line)
        add(lines, line)
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            lines)
    if !encoded.ok:
        return csgStoreCodecSegmentFail(
            csgStoreCodecCat(
                "merkle_store_node_segment_encode ",
                encoded.error))
    let canonical =
        csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !canonical.ok ||
       canonical.lines.len != nodes.len:
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreCodecSegmentFail(
            "merkle_store_node_segment_encode_self_check")
    var canonicalNodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for i in 0..<canonical.lines.len:
        var node: merkle_dag.CsgCoreMerkleNodeRecord
        var nodeError: str
        if !CsgCoreMerkleNodeRecordDecode(
               canonical.lines[i],
               node,
               nodeError):
            rawbytes.BytesFree(encoded.bytes)
            return csgStoreCodecSegmentFail(
                csgStoreCodecCat(
                    "merkle_store_node_segment_encode_self_check ",
                    nodeError))
        add(canonicalNodes, node)
    var out: CsgCoreMerkleNodeSegmentResult
    out.ok = true
    out.cid = csgStoreCodecCidBytes(
        CsgMerkleStoreNodeSegmentDomain,
        encoded.bytes)
    out.nodeCount = nodes.len
    out.byteCount =
        rawbytes.BytesLen(encoded.bytes)
    out.lines = canonical.lines
    out.nodes = canonicalNodes
    out.bytes = encoded.bytes
    return out

@borrows
fn CsgCoreMerkleNodeSegmentDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleNodeSegmentResult =
    let decoded =
        csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgStoreCodecSegmentFail(
            csgStoreCodecCat(
                "merkle_store_node_segment_decode ",
                decoded.error))
    if decoded.factCount <= 0:
        return csgStoreCodecSegmentFail(
            "merkle_store_node_segment_empty")
    var nodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for i in 0..<decoded.lines.len:
        var node: merkle_dag.CsgCoreMerkleNodeRecord
        var error: str
        if !CsgCoreMerkleNodeRecordDecode(
               decoded.lines[i], node, error):
            return csgStoreCodecSegmentFail(
                csgStoreCodecCat(
                    "merkle_store_node_segment_node ",
                    error))
        add(nodes, node)
    var reencoded =
        CsgCoreMerkleNodeSegmentEncode(nodes)
    if !reencoded.ok:
        return reencoded
    if !rawbytes.BytesEqual(
           bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgStoreCodecSegmentFail(
            "merkle_store_node_segment_non_canonical")
    var out: CsgCoreMerkleNodeSegmentResult
    out.ok = true
    out.cid = strings.CloneStr(reencoded.cid)
    out.nodeCount = nodes.len
    out.byteCount = rawbytes.BytesLen(bytes)
    out.lines = decoded.lines
    out.nodes = nodes
    out.bytes = reencoded.bytes
    return out

# ---------------------------------------------------------------------------
# Same-compilation content-addressed decode memo (memory line w49 ①).
#
# What is cached: the verified decode derivation of content-addressed store
# objects (head identities keyed by the digest of the canonical head bytes,
# receipt field derivations keyed by the digest of the receipt bytes).  The
# derivation is a pure function of the bytes, and the bytes are pinned by the
# per-call digest check on every read path, so a memo hit carries exactly the
# verification strength of the cached part; every caller still performs its
# own digest check plus all binding checks (generation continuity, before/
# after head/manifest binding, request binding) on each walk.
#
# Scope invariant: rows live for ONE compilation only.  The compiler entry
# (BuildSystemLinkExecPlanWithWorldAndChannelInto) calls
# CsgCoreMerkleStoreDecodeMemoResetForNewCompilation before any store walk,
# and every walker runs on that single compilation thread, so no lock is
# required.  Cross-compilation or cross-process reuse is forbidden.
# ---------------------------------------------------------------------------

const
    CsgStoreDecodeMemoMaxRows: int32 = 4096

type
    CsgCoreMerkleStoreHeadMemoEntry =
        found: bool
        generation: int64
        manifestCid: str
        previousHeadCid: str
        receiptCid: str
        headCid: str

    CsgCoreMerkleTransactionReceiptMemoEntry =
        found: bool
        generation: int64
        requestCid: str
        beforeHeadCid: str
        beforeManifestCid: str
        afterManifestCid: str
        proofCid: str
        operationCount: int32

    CsgCoreMerkleStoreDecodeMemoStats =
        headRowCount: int32
        receiptRowCount: int32
        headHits: int64
        headMisses: int64
        receiptHits: int64
        receiptMisses: int64
        resets: int64

var
    csgStoreHeadMemoKeys: str[]
    csgStoreHeadMemoGenerations: int64[]
    csgStoreHeadMemoManifestCids: str[]
    csgStoreHeadMemoPreviousHeadCids: str[]
    csgStoreHeadMemoReceiptCids: str[]
    csgStoreHeadMemoHeadCids: str[]
    csgStoreHeadMemoRowCount: int32
    csgStoreHeadMemoScanHint: int32
    csgStoreHeadMemoHits: int64
    csgStoreHeadMemoMisses: int64

    csgStoreReceiptMemoKeys: str[]
    csgStoreReceiptMemoGenerations: int64[]
    csgStoreReceiptMemoRequestCids: str[]
    csgStoreReceiptMemoBeforeHeadCids: str[]
    csgStoreReceiptMemoBeforeManifestCids: str[]
    csgStoreReceiptMemoAfterManifestCids: str[]
    csgStoreReceiptMemoProofCids: str[]
    csgStoreReceiptMemoOperationCounts: int32[]
    csgStoreReceiptMemoRowCount: int32
    csgStoreReceiptMemoScanHint: int32
    csgStoreReceiptMemoHits: int64
    csgStoreReceiptMemoMisses: int64

    csgStoreDecodeMemoResets: int64

@borrows
fn csgStoreDecodeMemoFindRow(keys: str[],
                             rowCount: int32,
                             hint: var int32,
                             key: str): int32 =
    if rowCount <= 0:
        return -1
    for offset in 0..<rowCount:
        var row = hint + offset
        if row >= rowCount:
            row = row - rowCount
        if keys[row] == key:
            hint = row + 1
            if hint >= rowCount:
                hint = 0
            return row
    return -1

@borrows
fn CsgCoreMerkleStoreHeadMemoLookup(
        key: str): CsgCoreMerkleStoreHeadMemoEntry =
    var out: CsgCoreMerkleStoreHeadMemoEntry
    let row = csgStoreDecodeMemoFindRow(
        csgStoreHeadMemoKeys,
        csgStoreHeadMemoRowCount,
        csgStoreHeadMemoScanHint,
        key)
    if row < 0:
        csgStoreHeadMemoMisses = csgStoreHeadMemoMisses + 1
        return out
    csgStoreHeadMemoHits = csgStoreHeadMemoHits + 1
    out.found = true
    out.generation = csgStoreHeadMemoGenerations[row]
    out.manifestCid = csgStoreHeadMemoManifestCids[row]
    out.previousHeadCid = csgStoreHeadMemoPreviousHeadCids[row]
    out.receiptCid = csgStoreHeadMemoReceiptCids[row]
    out.headCid = csgStoreHeadMemoHeadCids[row]
    return out

@borrows
fn CsgCoreMerkleStoreHeadMemoLookupFromBytes(
        bytes: rawbytes.Bytes): CsgCoreMerkleStoreHeadMemoEntry =
    # Memo lookup keyed by the content digest of the raw successor bytes.
    # Canonical equality with the encoded form was proven on the fill path,
    # so digest(bytes) identifies exactly the memoized derivation.
    if csgStoreHeadMemoRowCount <= 0:
        csgStoreHeadMemoMisses = csgStoreHeadMemoMisses + 1
        var empty: CsgCoreMerkleStoreHeadMemoEntry
        return empty
    return CsgCoreMerkleStoreHeadMemoLookup(
        CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleStoreHeadDomain, bytes))

@borrows
fn CsgCoreMerkleStoreHeadMemoInsertFromIdentity(
        key: str,
        head: CsgCoreMerkleStoreHeadIdentity) =
    if key.len == 0 ||
       csgStoreHeadMemoRowCount >= CsgStoreDecodeMemoMaxRows:
        return
    add(csgStoreHeadMemoKeys, strings.CloneStr(key))
    add(csgStoreHeadMemoGenerations, head.generation)
    add(csgStoreHeadMemoManifestCids, strings.CloneStr(head.manifestCid))
    add(csgStoreHeadMemoPreviousHeadCids, strings.CloneStr(head.previousHeadCid))
    add(csgStoreHeadMemoReceiptCids, strings.CloneStr(head.receiptCid))
    add(csgStoreHeadMemoHeadCids, strings.CloneStr(head.headCid))
    csgStoreHeadMemoRowCount = csgStoreHeadMemoRowCount + 1

@borrows
fn CsgCoreMerkleTransactionReceiptMemoEnabled(): bool =
    return csgStoreReceiptMemoRowCount > 0

@borrows
fn CsgCoreMerkleTransactionReceiptMemoLookup(
        key: str): CsgCoreMerkleTransactionReceiptMemoEntry =
    var out: CsgCoreMerkleTransactionReceiptMemoEntry
    let row = csgStoreDecodeMemoFindRow(
        csgStoreReceiptMemoKeys,
        csgStoreReceiptMemoRowCount,
        csgStoreReceiptMemoScanHint,
        key)
    if row < 0:
        csgStoreReceiptMemoMisses = csgStoreReceiptMemoMisses + 1
        return out
    csgStoreReceiptMemoHits = csgStoreReceiptMemoHits + 1
    out.found = true
    out.generation = csgStoreReceiptMemoGenerations[row]
    out.requestCid = csgStoreReceiptMemoRequestCids[row]
    out.beforeHeadCid = csgStoreReceiptMemoBeforeHeadCids[row]
    out.beforeManifestCid = csgStoreReceiptMemoBeforeManifestCids[row]
    out.afterManifestCid = csgStoreReceiptMemoAfterManifestCids[row]
    out.proofCid = csgStoreReceiptMemoProofCids[row]
    out.operationCount = csgStoreReceiptMemoOperationCounts[row]
    return out

@borrows
fn CsgCoreMerkleTransactionReceiptMemoInsertFromFields(
        key: str,
        generation: int64,
        requestCid: str,
        beforeHeadCid: str,
        beforeManifestCid: str,
        afterManifestCid: str,
        proofCid: str,
        operationCount: int32) =
    if key.len == 0 ||
       csgStoreReceiptMemoRowCount >= CsgStoreDecodeMemoMaxRows:
        return
    add(csgStoreReceiptMemoKeys, strings.CloneStr(key))
    add(csgStoreReceiptMemoGenerations, generation)
    add(csgStoreReceiptMemoRequestCids, strings.CloneStr(requestCid))
    add(csgStoreReceiptMemoBeforeHeadCids, strings.CloneStr(beforeHeadCid))
    add(csgStoreReceiptMemoBeforeManifestCids, strings.CloneStr(beforeManifestCid))
    add(csgStoreReceiptMemoAfterManifestCids, strings.CloneStr(afterManifestCid))
    add(csgStoreReceiptMemoProofCids, strings.CloneStr(proofCid))
    add(csgStoreReceiptMemoOperationCounts, operationCount)
    csgStoreReceiptMemoRowCount = csgStoreReceiptMemoRowCount + 1

fn CsgCoreMerkleStoreDecodeMemoResetForNewCompilation() =
    # Compilation boundary: release every memo row (all rows become
    # unreachable together).  Statistics counters restart with the rows so
    # the report always describes exactly one compilation.
    seqs.freeSeqStrRelease(csgStoreHeadMemoKeys)
    csgStoreHeadMemoKeys = []
    seqs.freeSeqStrRelease(csgStoreHeadMemoManifestCids)
    csgStoreHeadMemoManifestCids = []
    seqs.freeSeqStrRelease(csgStoreHeadMemoPreviousHeadCids)
    csgStoreHeadMemoPreviousHeadCids = []
    seqs.freeSeqStrRelease(csgStoreHeadMemoReceiptCids)
    csgStoreHeadMemoReceiptCids = []
    seqs.freeSeqStrRelease(csgStoreHeadMemoHeadCids)
    csgStoreHeadMemoHeadCids = []
    csgStoreHeadMemoGenerations = []
    csgStoreHeadMemoRowCount = 0
    csgStoreHeadMemoScanHint = 0
    csgStoreHeadMemoHits = 0
    csgStoreHeadMemoMisses = 0
    seqs.freeSeqStrRelease(csgStoreReceiptMemoKeys)
    csgStoreReceiptMemoKeys = []
    seqs.freeSeqStrRelease(csgStoreReceiptMemoRequestCids)
    csgStoreReceiptMemoRequestCids = []
    seqs.freeSeqStrRelease(csgStoreReceiptMemoBeforeHeadCids)
    csgStoreReceiptMemoBeforeHeadCids = []
    seqs.freeSeqStrRelease(csgStoreReceiptMemoBeforeManifestCids)
    csgStoreReceiptMemoBeforeManifestCids = []
    seqs.freeSeqStrRelease(csgStoreReceiptMemoAfterManifestCids)
    csgStoreReceiptMemoAfterManifestCids = []
    seqs.freeSeqStrRelease(csgStoreReceiptMemoProofCids)
    csgStoreReceiptMemoProofCids = []
    csgStoreReceiptMemoGenerations = []
    csgStoreReceiptMemoOperationCounts = []
    csgStoreReceiptMemoRowCount = 0
    csgStoreReceiptMemoScanHint = 0
    csgStoreReceiptMemoHits = 0
    csgStoreReceiptMemoMisses = 0
    csgStoreDecodeMemoResets = csgStoreDecodeMemoResets + 1

fn CsgCoreMerkleStoreDecodeMemoStatsGet(): CsgCoreMerkleStoreDecodeMemoStats =
    var out: CsgCoreMerkleStoreDecodeMemoStats
    out.headRowCount = csgStoreHeadMemoRowCount
    out.receiptRowCount = csgStoreReceiptMemoRowCount
    out.headHits = csgStoreHeadMemoHits
    out.headMisses = csgStoreHeadMemoMisses
    out.receiptHits = csgStoreReceiptMemoHits
    out.receiptMisses = csgStoreReceiptMemoMisses
    out.resets = csgStoreDecodeMemoResets
    return out
