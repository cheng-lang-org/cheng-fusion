import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout

const
    CsgJsonKindNull = 0
    CsgJsonKindBool = 1
    CsgJsonKindNumber = 2
    CsgJsonKindString = 3
    CsgJsonKindArray = 4
    CsgJsonKindObject = 5
    CsgJsonMaxNestingDepth: int32 = 256
    # 2M nodes: generated scene facts legitimately embed raster-image pixel
    # arrays (one array element per pixel); 65536 rejected real production
    # documents. Worst-case transient AST memory stays bounded (~100MB).
    CsgJsonMaxNodeCount: int32 = 2097152
    CsgJsonMaxNumberBytes: int32 = 1048576
    CsgJsonMaxPlainScale: int32 = 4096
    CsgJsonMaxInputBytes: int32 = 67108864
    CsgJsonMaxOutputBytes: int64 = 67108864

type
    CsgCoreJsonCanonicalResult =
        ok: bool
        value: str
        error: str

    CsgJsonValue =
        kind: int32
        boolValue: bool
        text: str
        keys: str[]
        values: CsgJsonValue[]
        order: int32[]

    CsgJsonParseState =
        text: str
        pos: int32
        depth: int32
        nodeCount: int32
        ok: bool = true
        error: str

    CsgJsonSignedDigits =
        negative: bool
        digits: int32[]

fn csgJsonCanonicalOk(value: str): CsgCoreJsonCanonicalResult =
    var result: CsgCoreJsonCanonicalResult
    result.ok = true
    result.value = value
    return result

fn csgJsonCanonicalFail(error: str): CsgCoreJsonCanonicalResult =
    var result: CsgCoreJsonCanonicalResult
    result.error = error
    return result

fn csgJsonSetError(state: var CsgJsonParseState, error: str) =
    if state.error.len == 0:
        state.error = error
    state.ok = false

fn csgJsonIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

fn csgJsonSkipWs(state: var CsgJsonParseState) =
    while state.pos < state.text.len && csgJsonIsWs(state.text[state.pos]):
        state.pos = state.pos + 1

@borrows
fn csgJsonUtf8Valid(text: str): bool =
    var cursor: int32
    while cursor < text.len:
        let remaining = text.len - cursor
        let b0 = int32(text[cursor]) & 255
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if remaining < 2:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if remaining < 3:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if remaining < 4:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            let b3 = int32(text[cursor + 3]) & 255
            if b2 < 128 || b2 > 191 ||
               b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

@borrows
fn csgJsonStrLess(left: str, right: str): bool =
    if left == right:
        return false
    let leftLen = left.len
    let rightLen = right.len
    let sharedLen = leftLen < rightLen ? leftLen : rightLen
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return (int32(left[i]) & 255) <
               (int32(right[i]) & 255)
    return leftLen < rightLen

@borrows
fn csgJsonObjectOrder(keys: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, keys.len)
    setLen(scratch, keys.len)
    for i in 0..<keys.len:
        order[i] = i
    var width: int32 = 1
    while width < keys.len:
        var base: int32
        while base < keys.len:
            var middle = base + width
            if middle > keys.len:
                middle = keys.len
            var finish = middle + width
            if finish > keys.len:
                finish = keys.len
            var left = base
            var right = middle
            var out = base
            while left < middle && right < finish:
                if csgJsonStrLess(
                       keys[order[right]],
                       keys[order[left]]):
                    scratch[out] = order[right]
                    right = right + 1
                else:
                    scratch[out] = order[left]
                    left = left + 1
                out = out + 1
            while left < middle:
                scratch[out] = order[left]
                left = left + 1
                out = out + 1
            while right < finish:
                scratch[out] = order[right]
                right = right + 1
                out = out + 1
            base = finish
        for i in 0..<keys.len:
            order[i] = scratch[i]
        if width > keys.len - width:
            width = keys.len
        else:
            width = width + width
    return order

fn csgJsonFinalizeObject(
        state: var CsgJsonParseState,
        out: var CsgJsonValue): bool =
    out.order = csgJsonObjectOrder(out.keys)
    for i in 1..<out.order.len:
        if out.keys[out.order[i - 1]] ==
           out.keys[out.order[i]]:
            csgJsonSetError(state, "duplicate_object_key")
            return false
    return true

fn csgJsonHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    return -1

fn csgJsonReadHex4(
        state: var CsgJsonParseState,
        out: var int32): bool =
    if state.pos < 0 || state.pos > state.text.len ||
       state.text.len - state.pos < 4:
        csgJsonSetError(state, "invalid_unicode_escape")
        return false
    var value: int32
    for i in 0..<4:
        let digit = csgJsonHexValue(state.text[state.pos + i])
        if digit < 0:
            csgJsonSetError(state, "invalid_unicode_escape")
            return false
        value = value * 16 + digit
    state.pos = state.pos + 4
    out = value
    return true

fn csgJsonAppendCodepoint(
        state: var CsgJsonParseState,
        buf: var layout.ByteBuf,
        codepoint: int32): bool =
    if codepoint < 0 || codepoint > 1114111 ||
       (codepoint >= 55296 && codepoint <= 57343):
        csgJsonSetError(state, "invalid_unicode_scalar")
        return false
    var count: int32 = 1
    if codepoint > 127:
        count = 2
    if codepoint > 2047:
        count = 3
    if codepoint > 65535:
        count = 4
    if count == 1:
        layout.ByteBufAppendByte(buf, codepoint)
    elif count == 2:
        layout.ByteBufAppendByte(buf, 192 + codepoint / 64)
        layout.ByteBufAppendByte(buf, 128 + codepoint % 64)
    elif count == 3:
        layout.ByteBufAppendByte(buf, 224 + codepoint / 4096)
        layout.ByteBufAppendByte(
            buf, 128 + (codepoint / 64) % 64)
        layout.ByteBufAppendByte(buf, 128 + codepoint % 64)
    else:
        layout.ByteBufAppendByte(buf, 240 + codepoint / 262144)
        layout.ByteBufAppendByte(
            buf, 128 + (codepoint / 4096) % 64)
        layout.ByteBufAppendByte(
            buf, 128 + (codepoint / 64) % 64)
        layout.ByteBufAppendByte(buf, 128 + codepoint % 64)
    return true

fn csgJsonParseStringFail(
        state: var CsgJsonParseState,
        buf: var layout.ByteBuf,
        error: str): bool =
    layout.ByteBufFree(buf)
    csgJsonSetError(state, error)
    return false

fn csgJsonParseString(state: var CsgJsonParseState, out: var str): bool =
    if state.pos >= state.text.len || state.text[state.pos] != '"':
        csgJsonSetError(state, "expected_string")
        return false
    state.pos = state.pos + 1
    var buf = layout.ByteBufInit(64)
    while state.pos < state.text.len:
        let ch = state.text[state.pos]
        if ch == '"':
            state.pos = state.pos + 1
            let expectedLen = layout.ByteBufLen(buf)
            var bytes = layout.ByteBufToBytes(buf)
            out = rawbytes.BytesToString(bytes)
            if out.len != expectedLen:
                rawbytes.BytesFree(bytes)
                layout.ByteBufFree(buf)
                panic("json_parse_string_allocation_failed")
            rawbytes.BytesFree(bytes)
            layout.ByteBufFree(buf)
            return true
        if ch != '\\':
            let raw = int32(ch) & 255
            if raw < 32:
                return csgJsonParseStringFail(
                    state, buf, "raw_control_in_string")
            layout.ByteBufAppendByte(buf, raw)
            state.pos = state.pos + 1
            continue
        if state.text.len - state.pos < 2:
            return csgJsonParseStringFail(
                state, buf, "unterminated_escape")
        let esc = state.text[state.pos + 1]
        var decoded: int32 = -1
        if esc == '"':
            decoded = int32('"')
        elif esc == '\\':
            decoded = int32('\\')
        elif esc == '/':
            decoded = int32('/')
        elif esc == 'b':
            decoded = 8
        elif esc == 'f':
            decoded = 12
        elif esc == 'n':
            decoded = 10
        elif esc == 'r':
            decoded = 13
        elif esc == 't':
            decoded = 9
        if decoded >= 0:
            layout.ByteBufAppendByte(buf, decoded)
            state.pos = state.pos + 2
            continue
        if esc != 'u':
            return csgJsonParseStringFail(
                state, buf, "unsupported_escape")
        state.pos = state.pos + 2
        var first: int32
        if !csgJsonReadHex4(state, first):
            layout.ByteBufFree(buf)
            return false
        var codepoint = first
        if first >= 55296 && first <= 56319:
            if state.text.len - state.pos < 6 ||
               state.text[state.pos] != '\\' ||
               state.text[state.pos + 1] != 'u':
                return csgJsonParseStringFail(
                    state, buf, "invalid_surrogate_pair")
            state.pos = state.pos + 2
            var second: int32
            if !csgJsonReadHex4(state, second):
                layout.ByteBufFree(buf)
                return false
            if second < 56320 || second > 57343:
                return csgJsonParseStringFail(
                    state, buf, "invalid_surrogate_pair")
            codepoint =
                65536 + (first - 55296) * 1024 +
                (second - 56320)
        elif first >= 56320 && first <= 57343:
            return csgJsonParseStringFail(
                state, buf, "isolated_low_surrogate")
        if !csgJsonAppendCodepoint(state, buf, codepoint):
            layout.ByteBufFree(buf)
            return false
    return csgJsonParseStringFail(
        state, buf, "unterminated_string")

fn csgJsonIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn csgJsonSignedTrim(value: var CsgJsonSignedDigits) =
    var out: int32[]
    for i in 0..<value.digits.len:
        add(out, value.digits[i])
    while out.len > 1 &&
          out[out.len - 1] == 0:
        setLen(out, out.len - 1)
    if out.len == 0:
        add(out, 0)
    value.digits = out
    if value.digits.len == 1 && value.digits[0] == 0:
        value.negative = false

@borrows
fn csgJsonDigitsCompare(left: int32[], right: int32[]): int32 =
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    var i = left.len
    while i > 0:
        i = i - 1
        if left[i] < right[i]:
            return -1
        if left[i] > right[i]:
            return 1
    return 0

@borrows
fn csgJsonDigitsAdd(left: int32[], right: int32[]): int32[] =
    let count = left.len > right.len ? left.len : right.len
    var out: int32[]
    setLen(out, count + 1)
    var carry: int32
    for i in 0..<count:
        var sum = carry
        if i < left.len:
            sum = sum + left[i]
        if i < right.len:
            sum = sum + right[i]
        out[i] = sum % 10
        carry = sum / 10
    out[count] = carry
    if carry == 0:
        setLen(out, count)
    return out

@borrows
fn csgJsonDigitsSubtract(left: int32[], right: int32[]): int32[] =
    var out: int32[]
    setLen(out, left.len)
    var borrow: int32
    for i in 0..<left.len:
        var digit = left[i] - borrow
        if i < right.len:
            digit = digit - right[i]
        if digit < 0:
            digit = digit + 10
            borrow = 1
        else:
            borrow = 0
        out[i] = digit
    while out.len > 1 && out[out.len - 1] == 0:
        setLen(out, out.len - 1)
    return out

@borrows
fn csgJsonSignedFromExponent(
        text: str,
        start: int32,
        finish: int32,
        negative: bool): CsgJsonSignedDigits =
    var out: CsgJsonSignedDigits
    out.negative = negative
    var cursor = finish
    while cursor > start:
        cursor = cursor - 1
        add(out.digits, int32(text[cursor]) - int32('0'))
    csgJsonSignedTrim(out)
    return out

fn csgJsonSignedAddSmall(
        value: var CsgJsonSignedDigits,
        delta: int64) =
    if delta == int64(0):
        return
    var magnitude = delta
    var deltaNegative = false
    if magnitude < int64(0):
        deltaNegative = true
        magnitude = -magnitude
    var deltaDigits: int32[]
    while magnitude > int64(0):
        add(deltaDigits, int32(magnitude % int64(10)))
        magnitude = magnitude / int64(10)
    if value.negative == deltaNegative:
        value.digits = csgJsonDigitsAdd(value.digits, deltaDigits)
        csgJsonSignedTrim(value)
        return
    let compared = csgJsonDigitsCompare(value.digits, deltaDigits)
    if compared == 0:
        var digits: int32[]
        setLen(digits, 1)
        digits[0] = 0
        value.digits = digits
        value.negative = false
    elif compared > 0:
        value.digits =
            csgJsonDigitsSubtract(value.digits, deltaDigits)
    else:
        value.digits =
            csgJsonDigitsSubtract(deltaDigits, value.digits)
        value.negative = deltaNegative
    csgJsonSignedTrim(value)

@borrows
fn csgJsonSignedText(value: CsgJsonSignedDigits): str =
    var buf = layout.ByteBufInit(value.digits.len + 1)
    if value.negative:
        layout.ByteBufAppendByte(buf, int32('-'))
    var cursor = value.digits.len
    while cursor > 0:
        cursor = cursor - 1
        layout.ByteBufAppendByte(
            buf, int32('0') + value.digits[cursor])
    let expectedLen = layout.ByteBufLen(buf)
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    if out.len != expectedLen:
        rawbytes.BytesFree(bytes)
        layout.ByteBufFree(buf)
        panic("json_signed_text_allocation_failed")
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return out

@borrows
fn csgJsonSignedBounded(
        value: CsgJsonSignedDigits,
        limit: int32,
        out: var int32): bool =
    if limit < 0:
        return false
    var magnitude: int64
    var cursor = value.digits.len
    while cursor > 0:
        cursor = cursor - 1
        let digit = int64(value.digits[cursor])
        if digit < int64(0) || digit > int64(9) ||
           digit > int64(limit) ||
           magnitude > (int64(limit) - digit) / int64(10):
            return false
        magnitude = magnitude * int64(10) + digit
    out = int32(magnitude)
    if value.negative:
        out = -out
    return true

fn csgJsonZeros(count: int32): str =
    if count <= 0:
        return ""
    var buf = layout.ByteBufInit(count)
    for i in 0..<count:
        layout.ByteBufAppendByte(buf, int32('0'))
    let expectedLen = layout.ByteBufLen(buf)
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    if out.len != expectedLen:
        rawbytes.BytesFree(bytes)
        layout.ByteBufFree(buf)
        panic("json_zero_text_allocation_failed")
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return out

@borrows
fn csgJsonAppendNumberPart(out: var str, part: str) =
    out = strings.ConcatStr(out, part)

@borrows
fn csgJsonCanonicalNumber(
        text: str,
        negative: bool,
        integerStart: int32,
        integerFinish: int32,
        fractionStart: int32,
        fractionFinish: int32,
        exponentStart: int32,
        exponentFinish: int32,
        exponentNegative: bool): str =
    let integerPart =
        strings.SliceBytes(
            text, integerStart, integerFinish - integerStart)
    let fractionPart =
        strings.SliceBytes(
            text, fractionStart, fractionFinish - fractionStart)
    var coefficientRaw =
        strings.ConcatStr(integerPart, fractionPart)
    var first: int32
    while first < coefficientRaw.len &&
          coefficientRaw[first] == '0':
        first = first + 1
    if first == coefficientRaw.len:
        return "0"
    var finish = coefficientRaw.len
    while finish > first && coefficientRaw[finish - 1] == '0':
        finish = finish - 1
    let coefficientView =
        strings.SliceBytes(
            coefficientRaw, first, finish - first)
    let coefficient = strings.CloneStr(coefficientView)
    let fractionLength = fractionFinish - fractionStart
    let trailingZeros = coefficientRaw.len - finish
    let scaleDelta =
        int64(trailingZeros) - int64(fractionLength)
    var scale =
        csgJsonSignedFromExponent(
            text,
            exponentStart,
            exponentFinish,
            exponentNegative)
    csgJsonSignedAddSmall(scale, scaleDelta)
    var scientificExponent =
        csgJsonSignedFromExponent(
            text,
            exponentStart,
            exponentFinish,
            exponentNegative)
    csgJsonSignedAddSmall(
        scientificExponent,
        scaleDelta + int64(coefficient.len - 1))
    let exponentText = csgJsonSignedText(scientificExponent)

    var scientific: str
    if negative:
        scientific = "-"
    csgJsonAppendNumberPart(
        scientific,
        strings.SliceBytes(coefficient, 0, 1))
    if coefficient.len > 1:
        csgJsonAppendNumberPart(scientific, ".")
        csgJsonAppendNumberPart(
            scientific,
            strings.SliceBytes(
                coefficient, 1, coefficient.len - 1))
    if exponentText != "0":
        csgJsonAppendNumberPart(scientific, "e")
        csgJsonAppendNumberPart(scientific, exponentText)

    var scaleValue: int32
    if !csgJsonSignedBounded(
           scale, CsgJsonMaxPlainScale, scaleValue):
        return scientific
    var plainLength: int64
    if scaleValue >= 0:
        plainLength = int64(coefficient.len) + int64(scaleValue)
    else:
        let point = coefficient.len + scaleValue
        if point > 0:
            plainLength = int64(coefficient.len + 1)
        else:
            plainLength =
                int64(2 - point + coefficient.len)
    var scientificLength = int64(scientific.len)
    if negative:
        scientificLength = scientificLength - int64(1)
    if plainLength > scientificLength:
        return scientific

    var plain: str
    if negative:
        plain = "-"
    if scaleValue >= 0:
        csgJsonAppendNumberPart(plain, coefficient)
        csgJsonAppendNumberPart(plain, csgJsonZeros(scaleValue))
        return plain
    let point = coefficient.len + scaleValue
    if point > 0:
        csgJsonAppendNumberPart(
            plain,
            strings.SliceBytes(coefficient, 0, point))
        csgJsonAppendNumberPart(plain, ".")
        csgJsonAppendNumberPart(
            plain,
            strings.SliceBytes(
                coefficient, point, coefficient.len - point))
        return plain
    csgJsonAppendNumberPart(plain, "0.")
    csgJsonAppendNumberPart(plain, csgJsonZeros(-point))
    csgJsonAppendNumberPart(plain, coefficient)
    return plain

fn csgJsonConsumeNumberByte(
        state: var CsgJsonParseState,
        start: int32): bool =
    if start < 0 || state.pos < start ||
       state.pos - start >= CsgJsonMaxNumberBytes:
        csgJsonSetError(state, "json_number_too_long")
        return false
    state.pos = state.pos + 1
    return true

fn csgJsonParseNumber(state: var CsgJsonParseState, out: var CsgJsonValue): bool =
    let start = state.pos
    var negative = false
    if state.pos < state.text.len && state.text[state.pos] == '-':
        negative = true
        if !csgJsonConsumeNumberByte(state, start):
            return false
    let integerStart = state.pos
    if state.pos >= state.text.len || !csgJsonIsDigit(state.text[state.pos]):
        csgJsonSetError(state, "expected_integer")
        return false
    if state.text[state.pos] == '0':
        if !csgJsonConsumeNumberByte(state, start):
            return false
        if state.pos < state.text.len && csgJsonIsDigit(state.text[state.pos]):
            csgJsonSetError(state, "invalid_integer")
            return false
    else:
        while state.pos < state.text.len && csgJsonIsDigit(state.text[state.pos]):
            if !csgJsonConsumeNumberByte(state, start):
                return false
    let integerFinish = state.pos
    var fractionStart = state.pos
    var fractionFinish = state.pos
    if state.pos < state.text.len && state.text[state.pos] == '.':
        if !csgJsonConsumeNumberByte(state, start):
            return false
        fractionStart = state.pos
        if state.pos >= state.text.len || !csgJsonIsDigit(state.text[state.pos]):
            csgJsonSetError(state, "invalid_number_fraction")
            return false
        while state.pos < state.text.len && csgJsonIsDigit(state.text[state.pos]):
            if !csgJsonConsumeNumberByte(state, start):
                return false
        fractionFinish = state.pos
    var exponentNegative = false
    var exponentStart = state.pos
    var exponentFinish = state.pos
    if state.pos < state.text.len && (state.text[state.pos] == 'e' || state.text[state.pos] == 'E'):
        if !csgJsonConsumeNumberByte(state, start):
            return false
        if state.pos < state.text.len && (state.text[state.pos] == '+' || state.text[state.pos] == '-'):
            exponentNegative = state.text[state.pos] == '-'
            if !csgJsonConsumeNumberByte(state, start):
                return false
        exponentStart = state.pos
        if state.pos >= state.text.len || !csgJsonIsDigit(state.text[state.pos]):
            csgJsonSetError(state, "invalid_number_exponent")
            return false
        while state.pos < state.text.len && csgJsonIsDigit(state.text[state.pos]):
            if !csgJsonConsumeNumberByte(state, start):
                return false
        exponentFinish = state.pos
    if state.pos - start > CsgJsonMaxNumberBytes:
        csgJsonSetError(state, "json_number_too_long")
        return false
    out.kind = CsgJsonKindNumber
    out.text =
        csgJsonCanonicalNumber(
            state.text,
            negative,
            integerStart,
            integerFinish,
            fractionStart,
            fractionFinish,
            exponentStart,
            exponentFinish,
            exponentNegative)
    return true

@borrows
fn csgJsonMatchLiteral(state: var CsgJsonParseState, literal: str): bool =
    if state.pos < 0 || state.pos > state.text.len ||
       literal.len > state.text.len - state.pos:
        return false
    for i in 0..<literal.len:
        if state.text[state.pos + i] != literal[i]:
            return false
    state.pos = state.pos + literal.len
    return true

fn csgJsonParseValue(state: var CsgJsonParseState, out: var CsgJsonValue): bool =
    csgJsonSkipWs(state)
    if state.pos >= state.text.len:
        csgJsonSetError(state, "expected_value")
        return false
    if state.nodeCount >= CsgJsonMaxNodeCount:
        csgJsonSetError(state, "json_node_limit_exceeded")
        return false
    state.nodeCount = state.nodeCount + 1
    let ch = state.text[state.pos]
    if ch == '{':
        if state.depth >= CsgJsonMaxNestingDepth:
            csgJsonSetError(state, "json_nesting_too_deep")
            return false
        state.depth = state.depth + 1
        out.kind = CsgJsonKindObject
        state.pos = state.pos + 1
        csgJsonSkipWs(state)
        if state.pos < state.text.len && state.text[state.pos] == '}':
            state.pos = state.pos + 1
            state.depth = state.depth - 1
            return true
        while state.ok:
            var key: str
            if !csgJsonParseString(state, key):
                return false
            csgJsonSkipWs(state)
            if state.pos >= state.text.len || state.text[state.pos] != ':':
                csgJsonSetError(state, "expected_object_colon")
                return false
            state.pos = state.pos + 1
            var objectValue: CsgJsonValue
            if !csgJsonParseValue(state, objectValue):
                return false
            add(out.keys, key)
            add(out.values, objectValue)
            csgJsonSkipWs(state)
            if state.pos >= state.text.len:
                csgJsonSetError(state, "unterminated_object")
                return false
            if state.text[state.pos] == '}':
                state.pos = state.pos + 1
                state.depth = state.depth - 1
                return csgJsonFinalizeObject(state, out)
            if state.text[state.pos] != ',':
                csgJsonSetError(state, "expected_object_comma")
                return false
            state.pos = state.pos + 1
            csgJsonSkipWs(state)
        return false
    if ch == '[':
        if state.depth >= CsgJsonMaxNestingDepth:
            csgJsonSetError(state, "json_nesting_too_deep")
            return false
        state.depth = state.depth + 1
        out.kind = CsgJsonKindArray
        state.pos = state.pos + 1
        csgJsonSkipWs(state)
        if state.pos < state.text.len && state.text[state.pos] == ']':
            state.pos = state.pos + 1
            state.depth = state.depth - 1
            return true
        while state.ok:
            var arrayValue: CsgJsonValue
            if !csgJsonParseValue(state, arrayValue):
                return false
            add(out.values, arrayValue)
            csgJsonSkipWs(state)
            if state.pos >= state.text.len:
                csgJsonSetError(state, "unterminated_array")
                return false
            if state.text[state.pos] == ']':
                state.pos = state.pos + 1
                state.depth = state.depth - 1
                return true
            if state.text[state.pos] != ',':
                csgJsonSetError(state, "expected_array_comma")
                return false
            state.pos = state.pos + 1
            csgJsonSkipWs(state)
        return false
    if ch == '"':
        out.kind = CsgJsonKindString
        return csgJsonParseString(state, out.text)
    if ch == '-' || csgJsonIsDigit(ch):
        return csgJsonParseNumber(state, out)
    if csgJsonMatchLiteral(state, "true"):
        out.kind = CsgJsonKindBool
        out.boolValue = true
        return true
    if csgJsonMatchLiteral(state, "false"):
        out.kind = CsgJsonKindBool
        return true
    if csgJsonMatchLiteral(state, "null"):
        out.kind = CsgJsonKindNull
        return true
    csgJsonSetError(state, "unsupported_value")
    return false

fn csgJsonEmitSetError(error: var str, value: str) =
    if error.len == 0:
        error = value

fn csgJsonEmitReserve(
        written: var int64,
        count: int32,
        error: var str): bool =
    if count < 0 || written < int64(0) ||
       written > CsgJsonMaxOutputBytes ||
       int64(count) > CsgJsonMaxOutputBytes - written:
        csgJsonEmitSetError(error, "json_output_limit_exceeded")
        return false
    written = written + int64(count)
    return true

fn csgJsonEmitAppendByte(
        buf: var layout.ByteBuf,
        written: var int64,
        error: var str,
        value: int32): bool =
    if !csgJsonEmitReserve(written, 1, error):
        return false
    layout.ByteBufAppendByte(buf, value)
    return true

@borrows
fn csgJsonEmitAppendText(
        buf: var layout.ByteBuf,
        written: var int64,
        error: var str,
        text: str): bool =
    if !csgJsonEmitReserve(written, text.len, error):
        return false
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, int32(text[i]) & 255)
    return true

fn csgJsonHexDigit(value: int32): int32 =
    if value < 10:
        return int32('0') + value
    return int32('a') + value - 10

@borrows
fn csgJsonEmitStringInto(
        text: str,
        buf: var layout.ByteBuf,
        written: var int64,
        error: var str): bool =
    if !csgJsonEmitAppendByte(
           buf, written, error, int32('"')):
        return false
    for i in 0..<text.len:
        let value = int32(text[i]) & 255
        if value == int32('"') || value == int32('\\'):
            if !csgJsonEmitAppendByte(
                   buf, written, error, int32('\\')) ||
               !csgJsonEmitAppendByte(
                   buf, written, error, value):
                return false
        elif value == 8 || value == 9 || value == 10 ||
             value == 12 || value == 13:
            var escaped = int32('b')
            if value == 9:
                escaped = int32('t')
            elif value == 10:
                escaped = int32('n')
            elif value == 12:
                escaped = int32('f')
            elif value == 13:
                escaped = int32('r')
            if !csgJsonEmitAppendByte(
                   buf, written, error, int32('\\')) ||
               !csgJsonEmitAppendByte(
                   buf, written, error, escaped):
                return false
        elif value < 32:
            if !csgJsonEmitReserve(written, 6, error):
                return false
            layout.ByteBufAppendByte(buf, int32('\\'))
            layout.ByteBufAppendByte(buf, int32('u'))
            layout.ByteBufAppendByte(buf, int32('0'))
            layout.ByteBufAppendByte(buf, int32('0'))
            layout.ByteBufAppendByte(
                buf, csgJsonHexDigit(value / 16))
            layout.ByteBufAppendByte(
                buf, csgJsonHexDigit(value % 16))
        else:
            if !csgJsonEmitAppendByte(
                   buf, written, error, value):
                return false
    return csgJsonEmitAppendByte(
        buf, written, error, int32('"'))

@borrows
fn csgJsonEmitValueInto(
        value: CsgJsonValue,
        buf: var layout.ByteBuf,
        written: var int64,
        error: var str): bool =
    if value.kind == CsgJsonKindNull:
        return csgJsonEmitAppendText(
            buf, written, error, "null")
    if value.kind == CsgJsonKindBool:
        return csgJsonEmitAppendText(
            buf,
            written,
            error,
            value.boolValue ? "true" : "false")
    if value.kind == CsgJsonKindNumber:
        return csgJsonEmitAppendText(
            buf, written, error, value.text)
    if value.kind == CsgJsonKindString:
        return csgJsonEmitStringInto(
            value.text, buf, written, error)
    if value.kind == CsgJsonKindArray:
        if !csgJsonEmitAppendByte(
               buf, written, error, int32('[')):
            return false
        for i in 0..<value.values.len:
            if i > 0 &&
               !csgJsonEmitAppendByte(
                   buf, written, error, int32(',')):
                return false
            if !csgJsonEmitValueInto(
                   value.values[i], buf, written, error):
                return false
        return csgJsonEmitAppendByte(
            buf, written, error, int32(']'))
    if value.kind == CsgJsonKindObject:
        if value.keys.len != value.values.len ||
           value.order.len != value.keys.len:
            csgJsonEmitSetError(error, "invalid_json_object_shape")
            return false
        if !csgJsonEmitAppendByte(
               buf, written, error, int32('{')):
            return false
        for i in 0..<value.order.len:
            let at = value.order[i]
            if at < 0 || at >= value.keys.len:
                csgJsonEmitSetError(
                    error, "invalid_json_object_order")
                return false
            if i > 0 &&
               !csgJsonEmitAppendByte(
                   buf, written, error, int32(',')):
                return false
            if !csgJsonEmitStringInto(
                   value.keys[at], buf, written, error) ||
               !csgJsonEmitAppendByte(
                   buf, written, error, int32(':')) ||
               !csgJsonEmitValueInto(
                   value.values[at], buf, written, error):
                return false
        return csgJsonEmitAppendByte(
            buf, written, error, int32('}'))
    csgJsonEmitSetError(error, "invalid_json_value_kind")
    return false

@borrows
fn csgJsonEmitCanonical(
        value: CsgJsonValue): CsgCoreJsonCanonicalResult =
    var buf = layout.ByteBufInit(256)
    var written: int64
    var error: str
    if !csgJsonEmitValueInto(value, buf, written, error):
        layout.ByteBufFree(buf)
        if error.len == 0:
            error = "json_emit_failed"
        return csgJsonCanonicalFail(error)
    if int64(layout.ByteBufLen(buf)) != written:
        layout.ByteBufFree(buf)
        panic("json_emit_length_invariant")
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    if int64(out.len) != written:
        rawbytes.BytesFree(bytes)
        layout.ByteBufFree(buf)
        panic("json_emit_string_allocation_failed")
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return csgJsonCanonicalOk(out)

fn CsgCoreJsonInputByteLimit(): int32 =
    return CsgJsonMaxInputBytes

fn CsgCoreJsonNumberByteLimit(): int32 =
    return CsgJsonMaxNumberBytes

fn CsgCoreJsonOutputByteLimit(): int32 =
    return int32(CsgJsonMaxOutputBytes)

@borrows
fn CsgCoreJsonCanonicalize(text: str): CsgCoreJsonCanonicalResult =
    if text.len > CsgJsonMaxInputBytes:
        return csgJsonCanonicalFail("json_input_too_large")
    if !csgJsonUtf8Valid(text):
        return csgJsonCanonicalFail("invalid_utf8")
    var state: CsgJsonParseState
    state.text = strings.CloneStr(text)
    state.ok = true
    var value: CsgJsonValue
    if !csgJsonParseValue(state, value):
        return csgJsonCanonicalFail(strings.CloneStr(state.error))
    csgJsonSkipWs(state)
    if state.pos != state.text.len:
        return csgJsonCanonicalFail("trailing_input")
    return csgJsonEmitCanonical(value)

@borrows
fn CsgCoreJsonQuoteChecked(
        text: str): CsgCoreJsonCanonicalResult =
    if text.len > CsgJsonMaxInputBytes:
        return csgJsonCanonicalFail("json_input_too_large")
    if !csgJsonUtf8Valid(text):
        return csgJsonCanonicalFail("invalid_utf8")
    var buf = layout.ByteBufInit(256)
    var written: int64
    var error: str
    if !csgJsonEmitStringInto(text, buf, written, error):
        layout.ByteBufFree(buf)
        if error.len == 0:
            error = "json_emit_failed"
        return csgJsonCanonicalFail(error)
    if int64(layout.ByteBufLen(buf)) != written:
        layout.ByteBufFree(buf)
        panic("json_quote_length_invariant")
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    if int64(out.len) != written:
        rawbytes.BytesFree(bytes)
        layout.ByteBufFree(buf)
        panic("json_quote_string_allocation_failed")
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return csgJsonCanonicalOk(out)

@borrows
fn CsgCoreJsonQuote(text: str): str =
    let result = CsgCoreJsonQuoteChecked(text)
    if !result.ok:
        panic(strings.CloneStr(result.error))
    return strings.CloneStr(result.value)
