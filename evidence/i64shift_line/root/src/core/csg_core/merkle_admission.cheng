    csgAdmissionStateClaimed: int32 = 3
    csgAdmissionStateReading: int32 = 4
    csgAdmissionStateConsumed: int32 = 5
    csgAdmissionStatePoisoned: int32 = 6
    csgAdmissionStateVerifyingMapped: int32 = 7
    csgAdmissionStateVerifiedRead: int32 = 8
    csgAdmissionKindLive: int32 = 1
    csgAdmissionKindClaimed: int32 = 2
    csgAdmissionKindReading: int32 = 3
    csgAdmissionKindVerifiedRead: int32 = 4
    CsgMerkleSchemaKind: str = "csg.core.schema"

type
    CsgCoreMerkleAdmissionArtifacts =
        partitionBytes: rawbytes.Bytes[]
        membershipBytes: rawbytes.Bytes[]
        nodeSegmentBytes: rawbytes.Bytes[]
        dependencyConsumerShardBytes: rawbytes.Bytes[]
        dependencyProviderShardBytes: rawbytes.Bytes[]
        summaryBytes: rawbytes.Bytes
        queryShardBytes: rawbytes.Bytes[]

    CsgCoreMerkleAdmissionResult =
        ok: bool
        error: str
        queryIndexCount: int32

    CsgCoreMerkleIncrementalOperation =
        kind: int32
        proof: merkle_dag.CsgCoreMerkleProof
        fact: str
        afterProfiles: str[]
        afterProfileSetCid: str

    CsgCoreMerkleIncrementalArtifacts =
        previousPartitionBytes: rawbytes.Bytes[]
        previousMembershipBytes: rawbytes.Bytes[]
        nextPartitionBytes: rawbytes.Bytes[]
        nextMembershipBytes: rawbytes.Bytes[]
        previousDependencyConsumerShardBytes: rawbytes.Bytes[]
        nextDependencyConsumerShardBytes: rawbytes.Bytes[]
        previousDependencyProviderShardBytes: rawbytes.Bytes[]
        nextDependencyProviderShardBytes: rawbytes.Bytes[]
        previousQueryShardBytes: rawbytes.Bytes[]
        nextQueryShardBytes: rawbytes.Bytes[]
        nextSummaryBytes: rawbytes.Bytes

    CsgCoreMerkleIncrementalAdmissionResult =
        ok: bool
        error: str
        computedNodeCids: str[]

    CsgCoreMerkleLocalNamedReplaceValidation =
        ok: bool
        error: str
        beforeFactsRoot: str
        beforeDagRootCid: str
        beforeFactCount: int32
        afterFactsRoot: str
        afterDagRootCid: str
        afterFactCount: int32

    CsgCoreMerkleSealedBeforeContent =
        ok: bool
