        beforeDagRootCid: str
        beforeSubgraphCid: str
        beforeFactCount: int32
        beforeCsgcDirectoryCid: str
        beforeCsgcObjectCid: str
        schemaFact: str
        queryKey: str
        beforePhysicalOrdinal: int32
        validatorKind: str
        replacementScope: int32
        replacementCount: int32
        beforeFact: str
        afterFact: str
        proof: merkle_dag.CsgCoreMerkleProof
        replay: merkle_dag.CsgCoreMerkleReplayResult

    csgAdmissionHeldItemDigestSet =
        cidsValid: bool
        contentCid: layout.FixedBytes32
        factsRoot: layout.FixedBytes32
        dagRoot: layout.FixedBytes32
        subgraph: layout.FixedBytes32
        directory: layout.FixedBytes32
        object: layout.FixedBytes32
        schemaFact: layout.FixedBytes32
        queryKey: layout.FixedBytes32
        beforeFact: layout.FixedBytes32
        afterFact: layout.FixedBytes32
