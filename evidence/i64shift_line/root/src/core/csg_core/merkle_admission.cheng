        "csg_core.sealed_before_projection.v1"
    csgAdmissionSealedBeforeReplacementArtifactDomain: str =
        "csg_core.sealed_before_replacement_artifact.v1"
    csgAdmissionRegistrySlotCount: int32 = 128
    csgAdmissionRegistryPayloadBytes: int32 = 81408
    csgAdmissionRegistryAllocationCount: int32 = 26
    csgAdmissionRegistryGenerationMax: int32 = 2147483647
    csgAdmissionRegistryEmpty: int32 = 0
    csgAdmissionRegistryBuilding: int32 = 1
    csgAdmissionRegistryReady: int32 = 2
    csgAdmissionRegistryFailed: int32 = 3
