    csgAdmissionSealedBeforePayloadDomain: str =
        "csg_core.sealed_before_payload.v1"
    csgAdmissionSealedBeforeBindingDomain: str =
        "csg_core.sealed_before_live_binding.v1"
    csgAdmissionSealedBeforeLiveAuthDomain: str =
        "csg_core.sealed_before_live_auth.v1"
    csgAdmissionSealedBeforeClaimedAuthDomain: str =
        "csg_core.sealed_before_claimed_auth.v1"
    csgAdmissionSealedBeforeReadingAuthDomain: str =
