        replay: layout.FixedBytes32
        validatorKind: layout.FixedBytes32
        artifact: layout.FixedBytes32

    CsgCoreMerkleSealedBeforeBindingResult =
        ok: bool
        error: str
        bindingDigest: layout.FixedBytes32

    CsgCoreMerkleSealedBeforeTerminalResult =
        ok: bool
        error: str
        terminalLoser: bool
        winner: bool
        terminal: bool
        consumed: bool
        poisoned: bool

    csgAdmissionRegistryStorage =
        store: phase.PhaseArenaStore
        arena: phase.PhaseArenaHandle
        states: phase.PhaseArenaRef
        generations: phase.PhaseArenaRef
        kinds: phase.PhaseArenaRef
        replacementScopes: phase.PhaseArenaRef
        factCounts: phase.PhaseArenaRef
        readPositions: phase.PhaseArenaRef
        authenticators: phase.PhaseArenaRef
        bindingDigests: phase.PhaseArenaRef
        payloadDigests: phase.PhaseArenaRef
        lineageNonces: phase.PhaseArenaRef
        contentCidDigests: phase.PhaseArenaRef
        bindingIdentityDigests: phase.PhaseArenaRef
        csgcDirectoryDigests: phase.PhaseArenaRef
        csgcObjectDigests: phase.PhaseArenaRef
        factsRootDigests: phase.PhaseArenaRef
        dagRootDigests: phase.PhaseArenaRef
        subgraphDigests: phase.PhaseArenaRef
        schemaFactDigests: phase.PhaseArenaRef
        queryKeyDigests: phase.PhaseArenaRef
        beforeFactDigests: phase.PhaseArenaRef
        afterFactDigests: phase.PhaseArenaRef
        proofDigests: phase.PhaseArenaRef
        replayDigests: phase.PhaseArenaRef
        validatorKindDigests: phase.PhaseArenaRef
        projectionDigests: phase.PhaseArenaRef
        beforePhysicalOrdinals: phase.PhaseArenaRef

var
    csgAdmissionRegistryState: int32
    csgAdmissionRegistry: csgAdmissionRegistryStorage

@borrows
fn csgAdmissionCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgAdmissionFail(
        error: str): CsgCoreMerkleAdmissionResult =
    var out: CsgCoreMerkleAdmissionResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionSealedBeforeFail(
        error: str): CsgCoreMerkleSealedBeforeContent =
    var out: CsgCoreMerkleSealedBeforeContent
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionSealedReplayFail(
        error: str): CsgCoreMerkleSealedReplayDelta =
    var out: CsgCoreMerkleSealedReplayDelta
    out.error = strings.CloneStr(error)
    return out

fn csgAdmissionAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, uint8(value & 255))
    layout.ByteBufAppendByte(out, uint8((value >> 8) & 255))
    layout.ByteBufAppendByte(out, uint8((value >> 16) & 255))
    layout.ByteBufAppendByte(out, uint8((value >> 24) & 255))

@borrows
fn csgAdmissionAppendText(
        out: var layout.ByteBuf,
        text: str) =
    csgAdmissionAppendU32(out, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(out, text[i])

@borrows
fn csgAdmissionSealedBeforeContentCid(
        dag: merkle_dag.CsgCoreMerkleDag,
        csgcDirectoryCid: str,
        csgcObjectCid: str,
        schemaFact: str): str =
    let binding = identity.CsgCoreBindingIdentityIssue(
        dag.standard,
        dag.schemaNamespace,
        dag.schemaCid,
        dag.profiles)
    if !identity.CsgCoreBindingIdentityReceiptIsValid(binding):
        return ""
    var preimage = layout.ByteBufInit(768)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforeContentDomain)
    csgAdmissionAppendText(
        preimage, binding.bindingIdentityReceiptCid)
    csgAdmissionAppendText(preimage, csgcDirectoryCid)
    csgAdmissionAppendText(preimage, csgcObjectCid)
    csgAdmissionAppendText(preimage, schemaFact)
    csgAdmissionAppendText(preimage, dag.factsRoot)
    csgAdmissionAppendText(preimage, dag.dagRootCid)
    csgAdmissionAppendText(preimage, dag.subgraphCid)
    csgAdmissionAppendU32(preimage, dag.factCount)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return csgAdmissionCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgAdmissionExactFactAtKey(
        facts: str[],
        queryKey: str,
        fact: var str): str =
    var matchCount: int32
    for i in 0..<facts.len:
        var keyError: str
        let factKey =
            merkle_dag.CsgCoreMerkleFactKey(
                facts[i], keyError)
        if keyError.len > 0:
            return csgAdmissionCat(
                "merkle_admitted_delta_fact_key ",
                keyError)
        if factKey == queryKey:
            fact = strings.CloneStr(facts[i])
            matchCount = matchCount + 1
    if matchCount != 1:
        return "merkle_admitted_delta_fact_cardinality_invalid"
    return ""

@borrows
fn CsgCoreMerkleSealBeforeContent(
        beforeCanonicalFacts: str[]): CsgCoreMerkleSealedBeforeContent =
    var beforeDag: merkle_dag.CsgCoreMerkleDag
    let beforeAdmission =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            beforeCanonicalFacts, beforeDag)
    if !beforeAdmission.valid ||
       !beforeAdmission.complete ||
       !beforeDag.ok ||
       beforeAdmission.factCount != beforeDag.factCount ||
       beforeAdmission.factsRoot != beforeDag.factsRoot ||
       beforeDag.factCount <= 0 ||
       beforeDag.entryFacts.len != beforeDag.factCount:
        return csgAdmissionSealedBeforeFail(
            "merkle_sealed_before_admission_failed")
    var schemaFact: str
    var schemaFactCount: int32
    for i in 0..<beforeCanonicalFacts.len:
        let kind = field.CsgCoreJsonKind(beforeCanonicalFacts[i])
        if kind.found && kind.value == CsgMerkleSchemaKind:
            schemaFact = strings.CloneStr(beforeCanonicalFacts[i])
            schemaFactCount = schemaFactCount + 1
    if schemaFactCount != 1:
        return csgAdmissionSealedBeforeFail(
            "merkle_sealed_before_schema_cardinality_invalid")
    # Producer-canonical JSONL is already the physical stream. Encode for
    # the CSGC object CID, then keep the input lines — decode-roundtrip
    # cloned the full snapshot payload (~400MB measured on snapshot read).
    var encoded = csgc.CsgCoreCsgcEncodeVerifiedLines(
        beforeCanonicalFacts)
    if !encoded.ok || encoded.factCount != beforeDag.factCount:
        rawbytes.BytesFree(encoded.bytes)
        return csgAdmissionSealedBeforeFail(
            "merkle_sealed_before_csgc_failed")
    let objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            encoded.bytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           encoded.claimedDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(objectCid):
        rawbytes.BytesFree(encoded.bytes)
        return csgAdmissionSealedBeforeFail(
            "merkle_sealed_before_csgc_identity_invalid")
    let contentCid = csgAdmissionSealedBeforeContentCid(
        beforeDag,
        encoded.claimedDirectoryCid,
        objectCid,
        schemaFact)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(contentCid):
        rawbytes.BytesFree(encoded.bytes)
        return csgAdmissionSealedBeforeFail(
            "merkle_sealed_before_content_identity_invalid")
    var orderError: str
    let order =
        merkle_dag.CsgCoreMerklePhysicalOrderIndexesFromCanonical(
            beforeCanonicalFacts, orderError)
    if orderError.len > 0 ||
       order.len != beforeCanonicalFacts.len:
        rawbytes.BytesFree(encoded.bytes)
        return csgAdmissionSealedBeforeFail(
            "merkle_sealed_before_physical_order_failed")
    var physicalFacts: str[]
    for rank in 0..<order.len:
        let source = order[rank]
        if source < 0 || source >= beforeCanonicalFacts.len:
            rawbytes.BytesFree(encoded.bytes)
            return csgAdmissionSealedBeforeFail(
                "merkle_sealed_before_physical_order_failed")
        add(physicalFacts, share(beforeCanonicalFacts[source]))
    var out: CsgCoreMerkleSealedBeforeContent
    out.ok = true
    out.contentCid = strings.CloneStr(contentCid)
    out.csgcDirectoryCid =
        strings.CloneStr(encoded.claimedDirectoryCid)
    out.csgcObjectCid = strings.CloneStr(objectCid)
    out.schemaFact = strings.CloneStr(schemaFact)
    out.physicalFacts = physicalFacts
    out.dag = beforeDag
    rawbytes.BytesFree(encoded.bytes)
    return out

@borrows
fn CsgCoreMerkleSealedBeforeContentError(
        sealed: CsgCoreMerkleSealedBeforeContent): str =
    if !sealed.ok || sealed.error.len > 0 ||
       !sealed.dag.ok || sealed.dag.factCount <= 0 ||
       sealed.physicalFacts.len != sealed.dag.factCount ||
       sealed.dag.entryFacts.len != sealed.dag.entryKeys.len ||
       sealed.dag.entryFacts.len != sealed.dag.entryFactHashes.len ||
       sealed.dag.entryFacts.len != sealed.dag.factCount ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           sealed.csgcDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           sealed.csgcObjectCid):
        return "merkle_sealed_before_shape_invalid"
    let schemaKind = field.CsgCoreJsonKind(sealed.schemaFact)
    var schemaCanonicalError: str
    let canonicalSchema = merkle_dag.CsgCoreMerkleCanonicalFact(
        sealed.schemaFact, schemaCanonicalError)
    if !schemaKind.found ||
       schemaKind.value != CsgMerkleSchemaKind ||
       schemaCanonicalError.len > 0 ||
       canonicalSchema != sealed.schemaFact:
        return "merkle_sealed_before_schema_invalid"
    let contentCid = csgAdmissionSealedBeforeContentCid(
        sealed.dag,
        sealed.csgcDirectoryCid,
        sealed.csgcObjectCid,
        sealed.schemaFact)
    if contentCid != sealed.contentCid:
        return "merkle_sealed_before_content_identity_mismatch"
    return ""

@borrows
fn CsgCoreMerkleAdmitReplaceFromSealedBeforeContent(
        sealed: CsgCoreMerkleSealedBeforeContent,
        afterFact: str,
        queryKey: str): CsgCoreMerkleSealedReplayDelta =
    let sealedError = CsgCoreMerkleSealedBeforeContentError(sealed)
    if sealedError.len > 0:
        return csgAdmissionSealedReplayFail(sealedError)
    if queryKey.len == 0:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_query_key_empty")
    var canonicalError: str
    let canonicalAfter = merkle_dag.CsgCoreMerkleCanonicalFact(
        afterFact, canonicalError)
    if canonicalError.len > 0 || canonicalAfter != afterFact:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_after_fact_noncanonical")
    var afterKeyError: str
    let afterKey = merkle_dag.CsgCoreMerkleFactKey(
        canonicalAfter, afterKeyError)
    if afterKeyError.len > 0 || afterKey != queryKey:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_after_key_mismatch")
    let beforeFactProof =
        merkle_dag.CsgCoreMerkleProveFactAtKey(
            sealed.dag, queryKey)
    if !beforeFactProof.ok:
        return csgAdmissionSealedReplayFail(
            beforeFactProof.error)
    let beforeFact = beforeFactProof.fact
    if beforeFact == canonicalAfter:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_no_state_change")
    let localAdmission =
        validator.CsgCoreProductionValidateNamedReplacementFact(
            canonicalAfter)
    if !localAdmission.valid ||
       !localAdmission.complete ||
       localAdmission.factCount != 1 ||
       localAdmission.replacementScope !=
           validator.CsgCoreProductionLocalNamedReplacementScope() ||
       localAdmission.unsupportedCount != 0 ||
       localAdmission.tombstoneCount != 0 ||
       localAdmission.runtimeRequirementCount != 0:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_local_admission_failed")
    let beforeKind = field.CsgCoreJsonKind(beforeFact)
    let afterKind = field.CsgCoreJsonKind(canonicalAfter)
    if !beforeKind.found || !afterKind.found ||
       beforeKind.value != afterKind.value ||
       beforeKind.value == CsgMerkleSchemaKind:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_kind_changed")
    let proof = beforeFactProof.proof
    if !proof.ok || !proof.exists:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_proof_failed")
    let replayDelta = merkle_dag.CsgCoreMerkleReplayReplaceBound(
        proof,
        sealed.dag.factsRoot,
        beforeFact,
        canonicalAfter)
    if !replayDelta.ok:
        return csgAdmissionSealedReplayFail(
            csgAdmissionCat(
                "merkle_sealed_replay ", replayDelta.error))
    let replay = replayDelta.replay
    if replay.beforeFactsRoot != sealed.dag.factsRoot ||
       replay.beforeDagRootCid != sealed.dag.dagRootCid ||
       replay.beforeSubgraphCid != sealed.dag.subgraphCid ||
       replay.beforeCount != sealed.dag.factCount ||
       replay.afterCount != sealed.dag.factCount ||
       replay.canonicalFact != canonicalAfter:
        return csgAdmissionSealedReplayFail(
            "merkle_sealed_replay_binding_mismatch")
    var out: CsgCoreMerkleSealedReplayDelta
    out.ok = true
    out.sealedBeforeContentCid =
        strings.CloneStr(sealed.contentCid)
    out.beforeCsgcDirectoryCid =
        strings.CloneStr(sealed.csgcDirectoryCid)
    out.beforeCsgcObjectCid = strings.CloneStr(sealed.csgcObjectCid)
    out.queryKey = strings.CloneStr(queryKey)
    out.beforeFact = strings.CloneStr(beforeFact)
    out.afterFact = strings.CloneStr(canonicalAfter)
    out.proof = proof
    out.replay = replay
    return out

@borrows
fn csgAdmissionAppendFixed32(
        out: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(out, value)

@borrows
fn csgAdmissionAppendReplayBinding(
        out: var layout.ByteBuf,
        binding: merkle_dag.CsgCoreMerkleReplayBinding) =
    csgAdmissionAppendText(out, binding.standard)
    csgAdmissionAppendU32(out, binding.profiles.len)
    for i in 0..<binding.profiles.len:
        csgAdmissionAppendText(out, binding.profiles[i])
    csgAdmissionAppendText(out, binding.profileSetCid)
    csgAdmissionAppendText(out, binding.schemaNamespace)
    csgAdmissionAppendText(out, binding.schemaCid)
    csgAdmissionAppendText(
        out, binding.bindingIdentityReceiptCid)

@borrows
fn csgAdmissionAppendProof(
        out: var layout.ByteBuf,
        proof: merkle_dag.CsgCoreMerkleProof) =
    csgAdmissionAppendU32(out, proof.factCount)
    csgAdmissionAppendText(out, proof.standard)
    csgAdmissionAppendU32(out, proof.profiles.len)
    for i in 0..<proof.profiles.len:
        csgAdmissionAppendText(out, proof.profiles[i])
    csgAdmissionAppendText(out, proof.schemaNamespace)
    csgAdmissionAppendText(out, proof.schemaCid)
    csgAdmissionAppendText(out, proof.dagRootCid)
    csgAdmissionAppendText(out, proof.subgraphCid)
    csgAdmissionAppendText(out, proof.factsRoot)
    csgAdmissionAppendText(out, proof.queryKey)
    csgAdmissionAppendU32(out, proof.exists ? 1 : 0)
    csgAdmissionAppendU32(out, proof.terminalPresent ? 1 : 0)
    csgAdmissionAppendText(out, proof.terminalKey)
    csgAdmissionAppendFixed32(out, proof.terminalFactHash)
    csgAdmissionAppendU32(out, proof.splitBits.len)
    for i in 0..<proof.splitBits.len:
        csgAdmissionAppendU32(out, proof.splitBits[i])
        csgAdmissionAppendU32(out, proof.directions[i])
        csgAdmissionAppendU32(out, proof.siblingCounts[i])
        csgAdmissionAppendFixed32(out, proof.siblingHashes[i])

@borrows
fn csgAdmissionAppendReplay(
        out: var layout.ByteBuf,
        replay: merkle_dag.CsgCoreMerkleReplayResult) =
    csgAdmissionAppendReplayBinding(out, replay.beforeBinding)
    csgAdmissionAppendReplayBinding(out, replay.afterBinding)
    csgAdmissionAppendText(out, replay.beforeDagRootCid)
    csgAdmissionAppendText(out, replay.afterDagRootCid)
    csgAdmissionAppendText(out, replay.beforeSubgraphCid)
    csgAdmissionAppendText(out, replay.afterSubgraphCid)
    csgAdmissionAppendText(out, replay.beforeFactsRoot)
    csgAdmissionAppendText(out, replay.afterFactsRoot)
    csgAdmissionAppendU32(out, replay.beforeCount)
    csgAdmissionAppendU32(out, replay.afterCount)
    csgAdmissionAppendText(out, replay.canonicalFact)
    csgAdmissionAppendFixed32(out, replay.factHash)
    csgAdmissionAppendText(
        out, strings.Int64ToStr(replay.rebuiltNodeCount))
    csgAdmissionAppendText(
        out, strings.Int64ToStr(replay.reusedNodeCount))
    csgAdmissionAppendU32(out, replay.nodes.len)
    for i in 0..<replay.nodes.len:
        csgAdmissionAppendText(
            out,
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                replay.nodes[i]))

@borrows
fn csgAdmissionTextDigest(text: str): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(text.len + 96)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforeTextDigestDomain)
    csgAdmissionAppendText(preimage, text)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgAdmissionCidDigest(
        cid: str,
        out: var layout.FixedBytes32): bool =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(cid):
        return false
    let hexText = strings.CloneStrRange(cid, 7, 64)
    let parsed = layout.FixedBytes32FromHex(hexText)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return true

@borrows
fn csgAdmissionCidText(
        digest: layout.FixedBytes32): str =
    return csgAdmissionCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgAdmissionProofDigest(
        proof: merkle_dag.CsgCoreMerkleProof): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(4096)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforeProofDigestDomain)
    csgAdmissionAppendProof(preimage, proof)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgAdmissionReplayDigest(
        replay: merkle_dag.CsgCoreMerkleReplayResult):
        layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(4096)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforeReplayDigestDomain)
    csgAdmissionAppendReplay(preimage, replay)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgAdmissionProjectionDigest(
        payloadDigest: layout.FixedBytes32,
        contentCidDigest: layout.FixedBytes32,
        bindingIdentityDigest: layout.FixedBytes32,
        csgcDirectoryDigest: layout.FixedBytes32,
        csgcObjectDigest: layout.FixedBytes32,
        factsRootDigest: layout.FixedBytes32,
        dagRootDigest: layout.FixedBytes32,
        subgraphDigest: layout.FixedBytes32,
        schemaFactDigest: layout.FixedBytes32,
        queryKeyDigest: layout.FixedBytes32,
        beforeFactDigest: layout.FixedBytes32,
        afterFactDigest: layout.FixedBytes32,
        proofDigest: layout.FixedBytes32,
        replayDigest: layout.FixedBytes32,
        validatorKindDigest: layout.FixedBytes32,
        beforePhysicalOrdinal: int32,
        replacementScope: int32,
        factCount: int32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(768)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforeProjectionDomain)
    csgAdmissionAppendFixed32(preimage, payloadDigest)
    csgAdmissionAppendFixed32(preimage, contentCidDigest)
    csgAdmissionAppendFixed32(preimage, bindingIdentityDigest)
    csgAdmissionAppendFixed32(preimage, csgcDirectoryDigest)
    csgAdmissionAppendFixed32(preimage, csgcObjectDigest)
    csgAdmissionAppendFixed32(preimage, factsRootDigest)
    csgAdmissionAppendFixed32(preimage, dagRootDigest)
    csgAdmissionAppendFixed32(preimage, subgraphDigest)
    csgAdmissionAppendFixed32(preimage, schemaFactDigest)
    csgAdmissionAppendFixed32(preimage, queryKeyDigest)
    csgAdmissionAppendFixed32(preimage, beforeFactDigest)
    csgAdmissionAppendFixed32(preimage, afterFactDigest)
    csgAdmissionAppendFixed32(preimage, proofDigest)
    csgAdmissionAppendFixed32(preimage, replayDigest)
    csgAdmissionAppendFixed32(preimage, validatorKindDigest)
    csgAdmissionAppendU32(preimage, beforePhysicalOrdinal)
    csgAdmissionAppendU32(preimage, replacementScope)
    csgAdmissionAppendU32(preimage, factCount)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgAdmissionReplacementArtifactDigest(
        bindingDigest: layout.FixedBytes32,
        csgcDirectoryDigest: layout.FixedBytes32,
        csgcObjectDigest: layout.FixedBytes32,
        beforePhysicalOrdinal: int32,
        replacementCount: int32,
        beforeFactDigest: layout.FixedBytes32,
        afterFactDigest: layout.FixedBytes32,
        proofDigest: layout.FixedBytes32,
        replayDigest: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(512)
    csgAdmissionAppendText(
        preimage,
        csgAdmissionSealedBeforeReplacementArtifactDomain)
    csgAdmissionAppendFixed32(preimage, bindingDigest)
    csgAdmissionAppendFixed32(preimage, csgcDirectoryDigest)
    csgAdmissionAppendFixed32(preimage, csgcObjectDigest)
    csgAdmissionAppendU32(preimage, beforePhysicalOrdinal)
    csgAdmissionAppendU32(preimage, replacementCount)
    csgAdmissionAppendFixed32(preimage, beforeFactDigest)
    csgAdmissionAppendFixed32(preimage, afterFactDigest)
    csgAdmissionAppendFixed32(preimage, proofDigest)
    csgAdmissionAppendFixed32(preimage, replayDigest)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgAdmissionReadCandidateShapeError(
        heldItem: CsgCoreMerkleSealedBeforeReadCandidate): str =
    let pathCount = heldItem.proof.splitBits.len
    if !heldItem.proof.ok:
        return "merkle_sealed_authority_candidate_proof_not_ok"
    if heldItem.proof.error.len != 0:
        return "merkle_sealed_authority_candidate_proof_error_nonempty"
    if !heldItem.proof.exists:
        return "merkle_sealed_authority_candidate_proof_absent"
    if pathCount != heldItem.proof.directions.len ||
       pathCount != heldItem.proof.siblingCounts.len ||
       pathCount != heldItem.proof.siblingHashes.len:
        return "merkle_sealed_authority_candidate_proof_columns_mismatch"
    if pathCount > 256:
        return "merkle_sealed_authority_candidate_proof_too_deep"
    if !heldItem.replay.ok:
        return "merkle_sealed_authority_candidate_replay_not_ok"
    if heldItem.replay.error.len != 0:
        return "merkle_sealed_authority_candidate_replay_error_nonempty"
    if heldItem.replay.nodes.len > 256:
        return "merkle_sealed_authority_candidate_replay_too_large"
    return ""

@borrows
fn csgAdmissionHeldItemDigests(
        heldItem: CsgCoreMerkleSealedBeforeReadCandidate,
        storedBinding: layout.FixedBytes32):
        csgAdmissionHeldItemDigestSet =
    if csgAdmissionReadCandidateShapeError(heldItem).len > 0:
        panic("merkle admission authority: candidate shape unchecked")
    var out: csgAdmissionHeldItemDigestSet
    var contentCid: layout.FixedBytes32
    var factsRoot: layout.FixedBytes32
    var dagRoot: layout.FixedBytes32
    var subgraph: layout.FixedBytes32
    var directory: layout.FixedBytes32
    var object: layout.FixedBytes32
    out.cidsValid =
        csgAdmissionCidDigest(
            heldItem.sealedBeforeContentCid, contentCid) &&
        csgAdmissionCidDigest(
            heldItem.beforeFactsRoot, factsRoot) &&
        csgAdmissionCidDigest(
            heldItem.beforeDagRootCid, dagRoot) &&
        csgAdmissionCidDigest(
            heldItem.beforeSubgraphCid, subgraph) &&
        csgAdmissionCidDigest(
            heldItem.beforeCsgcDirectoryCid, directory) &&
        csgAdmissionCidDigest(
            heldItem.beforeCsgcObjectCid, object)
    out.contentCid = contentCid
    out.factsRoot = factsRoot
    out.dagRoot = dagRoot
    out.subgraph = subgraph
    out.directory = directory
    out.object = object
    out.beforeFact = csgAdmissionTextDigest(heldItem.beforeFact)
    out.afterFact = csgAdmissionTextDigest(heldItem.afterFact)
    out.schemaFact = csgAdmissionTextDigest(heldItem.schemaFact)
    out.queryKey = csgAdmissionTextDigest(heldItem.queryKey)
    out.validatorKind =
        csgAdmissionTextDigest(heldItem.validatorKind)
    out.proof = csgAdmissionProofDigest(heldItem.proof)
    out.replay = csgAdmissionReplayDigest(heldItem.replay)
    out.artifact = csgAdmissionReplacementArtifactDigest(
        storedBinding,
        out.directory,
        out.object,
        heldItem.beforePhysicalOrdinal,
        heldItem.replacementCount,
        out.beforeFact,
        out.afterFact,
        out.proof,
        out.replay)
    return out

@borrows
fn csgAdmissionSealedBeforePayloadDigest(
        sealed: CsgCoreMerkleSealedBeforeContent,
        delta: CsgCoreMerkleSealedReplayDelta,
        bindingIdentityReceiptCid: str,
        beforePhysicalOrdinal: int32,
        validatorKind: str,
        replacementScope: int32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(8192)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforePayloadDomain)
    csgAdmissionAppendText(preimage, sealed.contentCid)
    csgAdmissionAppendText(preimage, bindingIdentityReceiptCid)
    csgAdmissionAppendText(preimage, sealed.csgcDirectoryCid)
    csgAdmissionAppendText(preimage, sealed.csgcObjectCid)
    csgAdmissionAppendText(preimage, sealed.schemaFact)
    csgAdmissionAppendText(preimage, sealed.dag.factsRoot)
    csgAdmissionAppendText(preimage, sealed.dag.dagRootCid)
    csgAdmissionAppendText(preimage, sealed.dag.subgraphCid)
    csgAdmissionAppendU32(preimage, sealed.dag.factCount)
    csgAdmissionAppendU32(preimage, sealed.physicalFacts.len)
    for i in 0..<sealed.physicalFacts.len:
        csgAdmissionAppendText(preimage, sealed.physicalFacts[i])
    csgAdmissionAppendU32(preimage, beforePhysicalOrdinal)
    csgAdmissionAppendText(preimage, validatorKind)
    csgAdmissionAppendU32(preimage, replacementScope)
    csgAdmissionAppendText(preimage, delta.sealedBeforeContentCid)
    csgAdmissionAppendText(preimage, delta.beforeCsgcDirectoryCid)
    csgAdmissionAppendText(preimage, delta.beforeCsgcObjectCid)
    csgAdmissionAppendText(preimage, delta.queryKey)
    csgAdmissionAppendText(preimage, delta.beforeFact)
    csgAdmissionAppendText(preimage, delta.afterFact)
    csgAdmissionAppendProof(preimage, delta.proof)
    csgAdmissionAppendReplay(preimage, delta.replay)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

@borrows
fn csgAdmissionSealedBeforeLineageBinding(
        payloadDigest: layout.FixedBytes32,
        lineageNonce: layout.FixedBytes32,
        ownerId: int32,
        generation: int32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(192)
    csgAdmissionAppendText(
        preimage, csgAdmissionSealedBeforeBindingDomain)
    csgAdmissionAppendFixed32(preimage, payloadDigest)
    csgAdmissionAppendFixed32(preimage, lineageNonce)
    csgAdmissionAppendU32(preimage, ownerId)
    csgAdmissionAppendU32(preimage, generation)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

fn csgAdmissionLock() =
    os.CsgMerkleAdmissionRegistryLock()

fn csgAdmissionUnlock() =
    os.CsgMerkleAdmissionRegistryUnlock()

fn csgAdmissionRefMatches(
        value: phase.PhaseArenaRef,
        arena: phase.PhaseArenaHandle): bool =
    return phase.PhaseArenaRefIsValid(value) &&
        value.arenaId == arena.arenaId &&
        value.generation == arena.generation

fn csgAdmissionRegistryShapeValid(): bool =
    let arena = csgAdmissionRegistry.arena
    return csgAdmissionRegistryState == csgAdmissionRegistryReady &&
        phase.PhaseArenaHandleIsValid(arena) &&
        csgAdmissionRefMatches(csgAdmissionRegistry.states, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.generations, arena) &&
        csgAdmissionRefMatches(csgAdmissionRegistry.kinds, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.replacementScopes, arena) &&
        csgAdmissionRefMatches(csgAdmissionRegistry.factCounts, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.readPositions, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.authenticators, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.bindingDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.payloadDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.lineageNonces, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.contentCidDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.bindingIdentityDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.csgcDirectoryDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.csgcObjectDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.factsRootDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.dagRootDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.subgraphDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.schemaFactDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.queryKeyDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.beforeFactDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.afterFactDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.proofDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.replayDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.validatorKindDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.projectionDigests, arena) &&
        csgAdmissionRefMatches(
            csgAdmissionRegistry.beforePhysicalOrdinals, arena)

fn csgAdmissionRegistryBuild(): csgAdmissionRegistryStorage =
    var out: csgAdmissionRegistryStorage
    phase.PhaseArenaStoreInit(
        out.store,
        1,
        csgAdmissionRegistryPayloadBytes,
        csgAdmissionRegistryAllocationCount)
    out.arena = phase.PhaseArenaStoreOpenArena(
        out.store,
        1,
        csgAdmissionRegistryPayloadBytes,
        csgAdmissionRegistryAllocationCount)
    out.states = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgAdmissionRegistrySlotCount)
    out.generations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgAdmissionRegistrySlotCount)
    out.kinds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgAdmissionRegistrySlotCount)
    out.replacementScopes = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgAdmissionRegistrySlotCount)
    out.factCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgAdmissionRegistrySlotCount)
    out.readPositions = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgAdmissionRegistrySlotCount)
    out.beforePhysicalOrdinals =
        phase.PhaseArenaStoreReserveI32Column(
            out.store,
            out.arena,
            csgAdmissionRegistrySlotCount)
    let fixedBytes =
        csgAdmissionRegistrySlotCount * layout.FixedBytes32Size
    out.authenticators = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.bindingDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.payloadDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.lineageNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.contentCidDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.bindingIdentityDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.csgcDirectoryDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.csgcObjectDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.factsRootDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.dagRootDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.subgraphDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.schemaFactDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.queryKeyDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.beforeFactDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.afterFactDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.proofDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.replayDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.validatorKindDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    out.projectionDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena, fixedBytes, 8)
    let report = phase.PhaseArenaStoreArenaReport(out.store, out.arena)
    if report.usedBytes != csgAdmissionRegistryPayloadBytes ||
       report.allocationCount != csgAdmissionRegistryAllocationCount ||
       report.spillCount != 0:
        panic("merkle admission authority: registry layout drift")
    return out

fn csgAdmissionEnsureRegistry() =
    var builder: bool
    while !builder:
        csgAdmissionLock()
        let observed = csgAdmissionRegistryState
        if observed == csgAdmissionRegistryReady:
            csgAdmissionUnlock()
            return
        if observed == csgAdmissionRegistryFailed:
            csgAdmissionUnlock()
            panic("merkle admission authority: registry failed")
        if observed == csgAdmissionRegistryEmpty:
            csgAdmissionRegistryState = csgAdmissionRegistryBuilding
            builder = true
            csgAdmissionUnlock()
        elif observed == csgAdmissionRegistryBuilding:
            let observedEpoch = os.CsgMerkleAdmissionRegistryEpoch()
            csgAdmissionUnlock()
            os.CsgMerkleAdmissionRegistryWait(observedEpoch)
        else:
            csgAdmissionUnlock()
            panic("merkle admission authority: registry state invalid")
    var candidate = csgAdmissionRegistryBuild()
    csgAdmissionRegistry = candidate
    candidate = csgAdmissionRegistryStorage()
    csgAdmissionLock()
    if csgAdmissionRegistryState != csgAdmissionRegistryBuilding:
        csgAdmissionRegistryState = csgAdmissionRegistryFailed
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        panic("merkle admission authority: publication drift")
    csgAdmissionRegistryState = csgAdmissionRegistryReady
    if !csgAdmissionRegistryShapeValid():
        csgAdmissionRegistryState = csgAdmissionRegistryFailed
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        panic("merkle admission authority: registry invalid")
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()

fn csgAdmissionI32(
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        csgAdmissionRegistry.store,
        csgAdmissionRegistry.arena,
        column,
        row)

fn csgAdmissionSetI32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        csgAdmissionRegistry.store,
        csgAdmissionRegistry.arena,
        column,
        row,
        value)

fn csgAdmissionFixed32(
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var bytes = phase.PhaseArenaStoreCopyBytesOut(
        csgAdmissionRegistry.store,
        csgAdmissionRegistry.arena,
        column,
        row * layout.FixedBytes32Size,
        layout.FixedBytes32Size)
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        panic("merkle admission authority: fixed32 read failed")
    return result.Value(parsed)

fn csgAdmissionSetFixed32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    var bytes = layout.FixedBytes32ToBytes(value)
    phase.PhaseArenaStoreCopyBytesInto(
        csgAdmissionRegistry.store,
        csgAdmissionRegistry.arena,
        column,
        row * layout.FixedBytes32Size,
        bytes,
        0,
        layout.FixedBytes32Size)
    rawbytes.BytesFree(bytes)

fn csgAdmissionClearPayload(row: int32) =
    csgAdmissionSetI32(csgAdmissionRegistry.kinds, row, 0)
    csgAdmissionSetI32(
        csgAdmissionRegistry.replacementScopes, row, 0)
    csgAdmissionSetI32(csgAdmissionRegistry.factCounts, row, 0)
    csgAdmissionSetI32(csgAdmissionRegistry.readPositions, row, -1)
    let zero = layout.FixedBytes32()
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.authenticators, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.bindingDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.payloadDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.lineageNonces, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.contentCidDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.bindingIdentityDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.csgcDirectoryDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.csgcObjectDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.factsRootDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.dagRootDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.subgraphDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.schemaFactDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.queryKeyDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.beforeFactDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.afterFactDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.proofDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.replayDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.validatorKindDigests, row, zero)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.projectionDigests, row, zero)
    csgAdmissionSetI32(
        csgAdmissionRegistry.beforePhysicalOrdinals, row, -1)

fn csgAdmissionNonce(
        out: var layout.FixedBytes32): bool =
    var bytes = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    if rawbytes.BytesLen(bytes) != layout.FixedBytes32Size ||
       !rand.RandomFill(bytes):
        rawbytes.BytesFree(bytes)
        return false
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return !layout.FixedBytes32Equal(out, layout.FixedBytes32())

@borrows
fn csgAdmissionStageAuthenticator(
        nonce: layout.FixedBytes32,
        bindingDigest: layout.FixedBytes32,
        generation: int32,
        kind: int32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(192)
    if kind == csgAdmissionKindLive:
        csgAdmissionAppendText(
            preimage, csgAdmissionSealedBeforeLiveAuthDomain)
    elif kind == csgAdmissionKindClaimed:
        csgAdmissionAppendText(
            preimage, csgAdmissionSealedBeforeClaimedAuthDomain)
    elif kind == csgAdmissionKindReading:
        csgAdmissionAppendText(
            preimage, csgAdmissionSealedBeforeReadingAuthDomain)
    elif kind == csgAdmissionKindVerifiedRead:
        csgAdmissionAppendText(
            preimage, csgAdmissionSealedBeforeVerifiedReadAuthDomain)
    else:
        layout.ByteBufFree(preimage)
        return layout.FixedBytes32()
    csgAdmissionAppendFixed32(preimage, nonce)
    csgAdmissionAppendFixed32(preimage, bindingDigest)
    csgAdmissionAppendU32(preimage, generation)
    csgAdmissionAppendU32(preimage, kind)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

fn csgAdmissionFixed32Collides(
        column: phase.PhaseArenaRef,
        value: layout.FixedBytes32): bool =
    if layout.FixedBytes32Equal(
           value, layout.FixedBytes32()):
        return true
    for row in 0..<csgAdmissionRegistrySlotCount:
        let state = csgAdmissionI32(
            csgAdmissionRegistry.states, row)
        if state != csgAdmissionStateEmpty &&
           layout.FixedBytes32Equal(
               csgAdmissionFixed32(
                   column, row),
               value):
            return true
    return false

fn csgAdmissionAuthenticatorCollides(
        authenticator: layout.FixedBytes32): bool =
    return csgAdmissionFixed32Collides(
        csgAdmissionRegistry.authenticators, authenticator)

fn csgAdmissionPayloadActive(
        payloadDigest: layout.FixedBytes32): bool =
    for row in 0..<csgAdmissionRegistrySlotCount:
        let state = csgAdmissionI32(
            csgAdmissionRegistry.states, row)
        if (state == csgAdmissionStateIssuing ||
            state == csgAdmissionStateLive ||
            state == csgAdmissionStateClaimed ||
            state == csgAdmissionStateReading) &&
           layout.FixedBytes32Equal(
               csgAdmissionFixed32(
                   csgAdmissionRegistry.payloadDigests, row),
               payloadDigest):
            return true
    return false

fn csgAdmissionTerminalPayloadRow(
        payloadDigest: layout.FixedBytes32): int32 =
    var row: int32 = -1
    var matchCount: int32
    for i in 0..<csgAdmissionRegistrySlotCount:
        let state = csgAdmissionI32(
            csgAdmissionRegistry.states, i)
        if (state == csgAdmissionStateConsumed ||
            state == csgAdmissionStatePoisoned) &&
           layout.FixedBytes32Equal(
               csgAdmissionFixed32(
                   csgAdmissionRegistry.payloadDigests, i),
               payloadDigest):
            row = i
            matchCount = matchCount + 1
    if matchCount > 1:
        return -2
    return row

@borrows
fn csgAdmissionHandleMatches(
        ownerId: int32,
        generation: int32,
        kind: int32,
        authenticator: layout.FixedBytes32,
        state: int32): bool =
    if ownerId <= 0 || ownerId > csgAdmissionRegistrySlotCount ||
       generation <= 0 ||
       layout.FixedBytes32Equal(
           authenticator, layout.FixedBytes32()):
        return false
    let row = ownerId - 1
    return csgAdmissionI32(
               csgAdmissionRegistry.states, row) == state &&
        csgAdmissionI32(
            csgAdmissionRegistry.generations, row) == generation &&
        csgAdmissionI32(
            csgAdmissionRegistry.kinds, row) == kind &&
        layout.FixedBytes32Equal(
            csgAdmissionFixed32(
                csgAdmissionRegistry.authenticators, row),
            authenticator)

@borrows
fn csgAdmissionPhysicalOrdinal(
        sealed: CsgCoreMerkleSealedBeforeContent,
        delta: CsgCoreMerkleSealedReplayDelta,
        ordinal: var int32): str =
    ordinal = -1
    if sealed.physicalFacts.len != sealed.dag.factCount ||
       sealed.physicalFacts.len <= 0:
        return "merkle_sealed_authority_physical_stream_invalid"
    var matches: int32
    for i in 0..<sealed.physicalFacts.len:
        # Physical facts are encode-proven canonical JSONL. Re-parsing each
        # line into a CsgJsonValue AST was measured at ~1.5GiB on snapshot
        # read; key and byte identity use the stored line directly.
        var keyError: str
        let key = merkle_dag.CsgCoreMerkleFactKeyFromCanonical(
            sealed.physicalFacts[i], keyError)
        if keyError.len > 0:
            return "merkle_sealed_authority_physical_key_invalid"
        if key == delta.queryKey:
            if sealed.physicalFacts[i] != delta.beforeFact:
                return "merkle_sealed_authority_physical_fact_mismatch"
            ordinal = i
            matches = matches + 1
    if matches != 1 || ordinal < 0:
        return "merkle_sealed_authority_physical_cardinality_invalid"
    return ""

@borrows
fn csgAdmissionIssueFail(
        error: str): CsgCoreMerkleSealedBeforeIssueResult =
    var out: CsgCoreMerkleSealedBeforeIssueResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionClaimFail(
        error: str): CsgCoreMerkleSealedBeforeClaimResult =
    var out: CsgCoreMerkleSealedBeforeClaimResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionOpenReadFail(
        error: str): CsgCoreMerkleSealedBeforeOpenReadResult =
    var out: CsgCoreMerkleSealedBeforeOpenReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionVerifyMappedFail(
        error: str): CsgCoreMerkleSealedBeforeVerifyMappedResult =
    var out: CsgCoreMerkleSealedBeforeVerifyMappedResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionProjectionFail(
        error: str): CsgCoreMerkleSealedBeforeProjectionResult =
    var out: CsgCoreMerkleSealedBeforeProjectionResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionBindingFail(
        error: str): CsgCoreMerkleSealedBeforeBindingResult =
    var out: CsgCoreMerkleSealedBeforeBindingResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgAdmissionTerminalFail(
        error: str): CsgCoreMerkleSealedBeforeTerminalResult =
    var out: CsgCoreMerkleSealedBeforeTerminalResult
    out.error = strings.CloneStr(error)
    return out

fn csgAdmissionMintLive(
        sealed: CsgCoreMerkleSealedBeforeContent,
        delta: CsgCoreMerkleSealedReplayDelta,
        bindingIdentityReceiptCid: str,
        validatorKind: str,
        replacementScope: int32):
        CsgCoreMerkleSealedBeforeIssueResult =
    var beforePhysicalOrdinal: int32
    let ordinalError = csgAdmissionPhysicalOrdinal(
        sealed, delta, beforePhysicalOrdinal)
    if ordinalError.len > 0:
        return csgAdmissionIssueFail(ordinalError)
    if !sealed.ok || !delta.ok ||
       delta.sealedBeforeContentCid != sealed.contentCid ||
       delta.beforeCsgcDirectoryCid != sealed.csgcDirectoryCid ||
       delta.beforeCsgcObjectCid != sealed.csgcObjectCid ||
       replacementScope !=
           validator.CsgCoreProductionLocalNamedReplacementScope() ||
       validatorKind.len == 0:
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_payload_invalid")
    let payloadDigest = csgAdmissionSealedBeforePayloadDigest(
        sealed,
        delta,
        bindingIdentityReceiptCid,
        beforePhysicalOrdinal,
        validatorKind,
        replacementScope)
    if layout.FixedBytes32Equal(
           payloadDigest, layout.FixedBytes32()):
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_payload_digest_invalid")
    var contentDigest: layout.FixedBytes32
    var bindingIdentityDigest: layout.FixedBytes32
    var csgcDirectoryDigest: layout.FixedBytes32
    var csgcObjectDigest: layout.FixedBytes32
    var factsRootDigest: layout.FixedBytes32
    var dagRootDigest: layout.FixedBytes32
    var subgraphDigest: layout.FixedBytes32
    if !csgAdmissionCidDigest(sealed.contentCid, contentDigest) ||
       !csgAdmissionCidDigest(
           bindingIdentityReceiptCid, bindingIdentityDigest) ||
       !csgAdmissionCidDigest(
           sealed.csgcDirectoryCid, csgcDirectoryDigest) ||
       !csgAdmissionCidDigest(
           sealed.csgcObjectCid, csgcObjectDigest) ||
       !csgAdmissionCidDigest(
           sealed.dag.factsRoot, factsRootDigest) ||
       !csgAdmissionCidDigest(
           sealed.dag.dagRootCid, dagRootDigest) ||
       !csgAdmissionCidDigest(
           sealed.dag.subgraphCid, subgraphDigest):
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_projection_cid_invalid")
    let schemaFactDigest =
        csgAdmissionTextDigest(sealed.schemaFact)
    let queryKeyDigest = csgAdmissionTextDigest(delta.queryKey)
    let beforeFactDigest = csgAdmissionTextDigest(delta.beforeFact)
    let afterFactDigest = csgAdmissionTextDigest(delta.afterFact)
    let proofDigest = csgAdmissionProofDigest(delta.proof)
    let replayDigest = csgAdmissionReplayDigest(delta.replay)
    let validatorKindDigest =
        csgAdmissionTextDigest(validatorKind)
    let projectionDigest = csgAdmissionProjectionDigest(
        payloadDigest,
        contentDigest,
        bindingIdentityDigest,
        csgcDirectoryDigest,
        csgcObjectDigest,
        factsRootDigest,
        dagRootDigest,
        subgraphDigest,
        schemaFactDigest,
        queryKeyDigest,
        beforeFactDigest,
        afterFactDigest,
        proofDigest,
        replayDigest,
        validatorKindDigest,
        beforePhysicalOrdinal,
        replacementScope,
        sealed.dag.factCount)
    if layout.FixedBytes32Equal(
           projectionDigest, layout.FixedBytes32()):
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_projection_digest_invalid")
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if csgAdmissionPayloadActive(payloadDigest):
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_payload_already_live")
    var row = csgAdmissionTerminalPayloadRow(payloadDigest)
    if row == -2:
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_terminal_payload_collision")
    if row >= 0 && csgAdmissionI32(
           csgAdmissionRegistry.generations, row) >=
           csgAdmissionRegistryGenerationMax:
        csgAdmissionClearPayload(row)
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        row = -1
    if row < 0:
        for i in 0..<csgAdmissionRegistrySlotCount:
            let state = csgAdmissionI32(
                csgAdmissionRegistry.states, i)
            let priorGeneration = csgAdmissionI32(
                csgAdmissionRegistry.generations, i)
            if row < 0 && priorGeneration >= 0 &&
               priorGeneration < csgAdmissionRegistryGenerationMax &&
               (state == csgAdmissionStateEmpty ||
                state == csgAdmissionStateConsumed ||
                state == csgAdmissionStatePoisoned):
                row = i
    if row < 0:
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_registry_full")
    let generation = csgAdmissionI32(
        csgAdmissionRegistry.generations, row) + 1
    csgAdmissionClearPayload(row)
    csgAdmissionSetI32(
        csgAdmissionRegistry.generations, row, generation)
    csgAdmissionSetI32(
        csgAdmissionRegistry.kinds, row, csgAdmissionKindLive)
    csgAdmissionSetI32(
        csgAdmissionRegistry.states, row, csgAdmissionStateIssuing)
    var lineageNonce: layout.FixedBytes32
    if !csgAdmissionNonce(lineageNonce):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_lineage_nonce_failed")
    if csgAdmissionFixed32Collides(
           csgAdmissionRegistry.lineageNonces,
           lineageNonce):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_lineage_nonce_collision")
    let bindingDigest = csgAdmissionSealedBeforeLineageBinding(
        payloadDigest, lineageNonce, row + 1, generation)
    if layout.FixedBytes32Equal(
           bindingDigest, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(bindingDigest, payloadDigest) ||
       csgAdmissionFixed32Collides(
           csgAdmissionRegistry.bindingDigests,
           bindingDigest):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_binding_collision")
    var authenticatorNonce: layout.FixedBytes32
    if !csgAdmissionNonce(authenticatorNonce):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_authenticator_nonce_failed")
    let authenticator = csgAdmissionStageAuthenticator(
        authenticatorNonce,
        bindingDigest,
        generation,
        csgAdmissionKindLive)
    if csgAdmissionAuthenticatorCollides(authenticator) ||
       layout.FixedBytes32Equal(authenticator, bindingDigest):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_authenticator_collision")
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.authenticators, row, authenticator)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.bindingDigests, row, bindingDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.payloadDigests, row, payloadDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.lineageNonces, row, lineageNonce)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.contentCidDigests, row, contentDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.bindingIdentityDigests,
        row,
        bindingIdentityDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.csgcDirectoryDigests,
        row,
        csgcDirectoryDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.csgcObjectDigests,
        row,
        csgcObjectDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.factsRootDigests, row, factsRootDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.dagRootDigests, row, dagRootDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.subgraphDigests, row, subgraphDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.schemaFactDigests,
        row,
        schemaFactDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.queryKeyDigests, row, queryKeyDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.beforeFactDigests,
        row,
        beforeFactDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.afterFactDigests,
        row,
        afterFactDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.proofDigests, row, proofDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.replayDigests, row, replayDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.validatorKindDigests,
        row,
        validatorKindDigest)
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.projectionDigests,
        row,
        projectionDigest)
    csgAdmissionSetI32(
        csgAdmissionRegistry.replacementScopes,
        row,
        replacementScope)
    csgAdmissionSetI32(
        csgAdmissionRegistry.factCounts,
        row,
        sealed.dag.factCount)
    csgAdmissionSetI32(
        csgAdmissionRegistry.beforePhysicalOrdinals,
        row,
        beforePhysicalOrdinal)
    csgAdmissionSetI32(
        csgAdmissionRegistry.states, row, csgAdmissionStateLive)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeIssueResult
    out.ok = true
    out.live.ownerId = row + 1
    out.live.generation = generation
    out.live.kind = csgAdmissionKindLive
    out.live.authenticator = layout.FixedBytes32Copy(authenticator)
    out.bindingDigest = layout.FixedBytes32Copy(bindingDigest)
    out.candidate.sealedBeforeContentCid = sealed.contentCid
    out.candidate.beforeFactsRoot = sealed.dag.factsRoot
    out.candidate.beforeDagRootCid = sealed.dag.dagRootCid
    out.candidate.beforeSubgraphCid = sealed.dag.subgraphCid
    out.candidate.beforeFactCount = sealed.dag.factCount
    out.candidate.beforeCsgcDirectoryCid = sealed.csgcDirectoryCid
    out.candidate.beforeCsgcObjectCid = sealed.csgcObjectCid
    out.candidate.schemaFact = sealed.schemaFact
    out.candidate.queryKey = delta.queryKey
    out.candidate.beforePhysicalOrdinal = beforePhysicalOrdinal
    out.candidate.validatorKind = validatorKind
    out.candidate.replacementScope = replacementScope
    out.candidate.replacementCount = 1
    out.candidate.beforeFact = delta.beforeFact
    out.candidate.afterFact = delta.afterFact
    out.candidate.proof = delta.proof
    out.candidate.replay = delta.replay
    return out

@borrows
fn CsgCoreMerkleSealBeforeAuthority(
        beforeCanonicalFacts: str[],
        afterFact: str,
        queryKey: str): CsgCoreMerkleSealedBeforeIssueResult =
    var sealed = CsgCoreMerkleSealBeforeContent(
        beforeCanonicalFacts)
    if !sealed.ok:
        return csgAdmissionIssueFail(sealed.error)
    var delta = CsgCoreMerkleAdmitReplaceFromSealedBeforeContent(
        sealed, afterFact, queryKey)
    if !delta.ok:
        return csgAdmissionIssueFail(delta.error)
    let afterKind = field.CsgCoreJsonKind(delta.afterFact)
    if !afterKind.found || afterKind.value == CsgMerkleSchemaKind:
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_validator_kind_invalid")
    let binding = identity.CsgCoreBindingIdentityIssue(
        sealed.dag.standard,
        sealed.dag.schemaNamespace,
        sealed.dag.schemaCid,
        sealed.dag.profiles)
    if !identity.CsgCoreBindingIdentityReceiptIsValid(binding):
        return csgAdmissionIssueFail(
            "merkle_sealed_authority_binding_identity_invalid")
    var validatorKind = strings.CloneStr(afterKind.value)
    return csgAdmissionMintLive(
        sealed,
        delta,
        strings.CloneStr(binding.bindingIdentityReceiptCid),
        validatorKind,
        validator.CsgCoreProductionLocalNamedReplacementScope())

@borrows
fn CsgCoreMerkleValidateLocalNamedReplace(
        beforeCanonicalFacts: str[],
        afterFact: str,
        queryKey: str): CsgCoreMerkleLocalNamedReplaceValidation =
    var sealed = CsgCoreMerkleSealBeforeContent(beforeCanonicalFacts)
    if !sealed.ok:
        var failed: CsgCoreMerkleLocalNamedReplaceValidation
        failed.error = strings.CloneStr(sealed.error)
        return failed
    var delta = CsgCoreMerkleAdmitReplaceFromSealedBeforeContent(
        sealed, afterFact, queryKey)
    if !delta.ok:
        var failed: CsgCoreMerkleLocalNamedReplaceValidation
        failed.error = strings.CloneStr(delta.error)
        return failed
    var out: CsgCoreMerkleLocalNamedReplaceValidation
    out.ok = true
    out.beforeFactsRoot = strings.CloneStr(sealed.dag.factsRoot)
    out.beforeDagRootCid = strings.CloneStr(sealed.dag.dagRootCid)
    out.beforeFactCount = sealed.dag.factCount
    out.afterFactsRoot = strings.CloneStr(delta.replay.afterFactsRoot)
    out.afterDagRootCid = strings.CloneStr(delta.replay.afterDagRootCid)
    out.afterFactCount = delta.replay.afterCount
    return out

fn CsgCoreMerkleSealedBeforeClaim(
        live: var CsgCoreMerkleSealedBeforeLiveToken):
        CsgCoreMerkleSealedBeforeClaimResult =
    let ownerId = live.ownerId
    let generation = live.generation
    let kind = live.kind
    let oldAuthenticator =
        layout.FixedBytes32Copy(live.authenticator)
    live = CsgCoreMerkleSealedBeforeLiveToken()
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           oldAuthenticator,
           csgAdmissionStateLive):
        csgAdmissionUnlock()
        return csgAdmissionClaimFail(
            "merkle_sealed_authority_live_token_invalid")
    let row = ownerId - 1
    if !csgAdmissionPayloadValid(row):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionClaimFail(
            "merkle_sealed_authority_claim_payload_invalid")
    let bindingDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.bindingDigests, row)
    var nonce: layout.FixedBytes32
    if !csgAdmissionNonce(nonce):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionClaimFail(
            "merkle_sealed_authority_claim_nonce_failed")
    let claimedAuthenticator = csgAdmissionStageAuthenticator(
        nonce,
        bindingDigest,
        generation,
        csgAdmissionKindClaimed)
    if csgAdmissionAuthenticatorCollides(claimedAuthenticator) ||
       layout.FixedBytes32Equal(
           claimedAuthenticator, oldAuthenticator) ||
       layout.FixedBytes32Equal(
           claimedAuthenticator, bindingDigest):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionClaimFail(
            "merkle_sealed_authority_claim_authenticator_collision")
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.authenticators,
        row,
        claimedAuthenticator)
    csgAdmissionSetI32(
        csgAdmissionRegistry.kinds, row, csgAdmissionKindClaimed)
    csgAdmissionSetI32(
        csgAdmissionRegistry.states, row, csgAdmissionStateClaimed)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeClaimResult
    out.ok = true
    out.claimed.ownerId = ownerId
    out.claimed.generation = generation
    out.claimed.kind = csgAdmissionKindClaimed
    out.claimed.authenticator =
        layout.FixedBytes32Copy(claimedAuthenticator)
    out.bindingDigest = layout.FixedBytes32Copy(bindingDigest)
    return out

@borrows
fn CsgCoreMerkleSealedBeforeClaimedOpenRead(
        claimed: var CsgCoreMerkleSealedBeforeClaimedToken,
        storedBinding: layout.FixedBytes32,
        heldItem: CsgCoreMerkleSealedBeforeReadCandidate):
        CsgCoreMerkleSealedBeforeOpenReadResult =
    let ownerId = claimed.ownerId
    let generation = claimed.generation
    let kind = claimed.kind
    let oldAuthenticator =
        layout.FixedBytes32Copy(claimed.authenticator)
    claimed = CsgCoreMerkleSealedBeforeClaimedToken()
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           oldAuthenticator,
           csgAdmissionStateClaimed):
        csgAdmissionUnlock()
        return csgAdmissionOpenReadFail(
            "merkle_sealed_authority_claimed_token_invalid")
    let row = ownerId - 1
    let registryBinding = csgAdmissionFixed32(
        csgAdmissionRegistry.bindingDigests, row)
    if !layout.FixedBytes32Equal(
           registryBinding, storedBinding) ||
       !csgAdmissionPayloadValid(row):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionOpenReadFail(
            "merkle_sealed_authority_open_read_rejoin_failed")
    let shapeError = csgAdmissionReadCandidateShapeError(heldItem)
    if shapeError.len > 0:
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionOpenReadFail(shapeError)
    let digests = csgAdmissionHeldItemDigests(
        heldItem, storedBinding)
    if !csgAdmissionHeldItemMatches(row, heldItem, digests):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionOpenReadFail(
            "merkle_sealed_authority_candidate_digest_mismatch")
    var nonce: layout.FixedBytes32
    if !csgAdmissionNonce(nonce):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionOpenReadFail(
            "merkle_sealed_authority_open_read_nonce_failed")
    let readingAuthenticator = csgAdmissionStageAuthenticator(
        nonce,
        registryBinding,
        generation,
        csgAdmissionKindReading)
    if csgAdmissionAuthenticatorCollides(readingAuthenticator) ||
       layout.FixedBytes32Equal(
           readingAuthenticator, oldAuthenticator) ||
       layout.FixedBytes32Equal(
           readingAuthenticator, registryBinding):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionOpenReadFail(
            "merkle_sealed_authority_open_read_authenticator_collision")
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.authenticators,
        row,
        readingAuthenticator)
    csgAdmissionSetI32(
        csgAdmissionRegistry.kinds, row, csgAdmissionKindReading)
    csgAdmissionSetI32(
        csgAdmissionRegistry.readPositions, row, 0)
    csgAdmissionSetI32(
        csgAdmissionRegistry.states, row, csgAdmissionStateReading)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeOpenReadResult
    out.ok = true
    out.reading.ownerId = ownerId
    out.reading.generation = generation
    out.reading.kind = csgAdmissionKindReading
    out.reading.authenticator =
        layout.FixedBytes32Copy(readingAuthenticator)
    out.bindingDigest = layout.FixedBytes32Copy(registryBinding)
    out.beforePhysicalOrdinal = heldItem.beforePhysicalOrdinal
    out.beforeFactDigest = layout.FixedBytes32Copy(
        digests.beforeFact)
    out.proofDigest = layout.FixedBytes32Copy(digests.proof)
    out.replayDigest = layout.FixedBytes32Copy(digests.replay)
    out.replacementArtifactDigest = layout.FixedBytes32Copy(
        digests.artifact)
    return out

fn csgAdmissionPayloadValid(row: int32): bool =
    if row < 0 || row >= csgAdmissionRegistrySlotCount:
        return false
    let generation = csgAdmissionI32(
        csgAdmissionRegistry.generations, row)
    let factCount = csgAdmissionI32(
        csgAdmissionRegistry.factCounts, row)
    let ordinal = csgAdmissionI32(
        csgAdmissionRegistry.beforePhysicalOrdinals, row)
    let replacementScope = csgAdmissionI32(
        csgAdmissionRegistry.replacementScopes, row)
    if generation <= 0 || factCount <= 0 ||
       ordinal < 0 || ordinal >= factCount ||
       replacementScope !=
           validator.CsgCoreProductionLocalNamedReplacementScope():
        return false
    let payloadDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.payloadDigests, row)
    let lineageNonce = csgAdmissionFixed32(
        csgAdmissionRegistry.lineageNonces, row)
    let storedBinding = csgAdmissionFixed32(
        csgAdmissionRegistry.bindingDigests, row)
    let recomputedBinding =
        csgAdmissionSealedBeforeLineageBinding(
            payloadDigest,
            lineageNonce,
            row + 1,
            generation)
    if !layout.FixedBytes32Equal(
           recomputedBinding, storedBinding):
        return false
    let recomputedProjection = csgAdmissionProjectionDigest(
        payloadDigest,
        csgAdmissionFixed32(
            csgAdmissionRegistry.contentCidDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.bindingIdentityDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.csgcDirectoryDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.csgcObjectDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.factsRootDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.dagRootDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.subgraphDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.schemaFactDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.queryKeyDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.beforeFactDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.afterFactDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.proofDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.replayDigests, row),
        csgAdmissionFixed32(
            csgAdmissionRegistry.validatorKindDigests, row),
        ordinal,
        replacementScope,
        factCount)
    return layout.FixedBytes32Equal(
        recomputedProjection,
        csgAdmissionFixed32(
            csgAdmissionRegistry.projectionDigests, row))

@borrows
fn csgAdmissionHeldItemMatches(
        row: int32,
        heldItem: CsgCoreMerkleSealedBeforeReadCandidate,
        digests: csgAdmissionHeldItemDigestSet): bool =
    return digests.cidsValid &&
        heldItem.proof.splitBits.len <= 256 &&
        heldItem.replay.nodes.len <= 256 &&
        heldItem.beforeFactCount == csgAdmissionI32(
            csgAdmissionRegistry.factCounts, row) &&
        heldItem.beforePhysicalOrdinal == csgAdmissionI32(
            csgAdmissionRegistry.beforePhysicalOrdinals, row) &&
        heldItem.replacementScope == csgAdmissionI32(
            csgAdmissionRegistry.replacementScopes, row) &&
        heldItem.replacementCount == 1 &&
        layout.FixedBytes32Equal(
            digests.contentCid,
            csgAdmissionFixed32(
                csgAdmissionRegistry.contentCidDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.factsRoot,
            csgAdmissionFixed32(
                csgAdmissionRegistry.factsRootDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.dagRoot,
            csgAdmissionFixed32(
                csgAdmissionRegistry.dagRootDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.subgraph,
            csgAdmissionFixed32(
                csgAdmissionRegistry.subgraphDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.directory,
            csgAdmissionFixed32(
                csgAdmissionRegistry.csgcDirectoryDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.object,
            csgAdmissionFixed32(
                csgAdmissionRegistry.csgcObjectDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.schemaFact,
            csgAdmissionFixed32(
                csgAdmissionRegistry.schemaFactDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.queryKey,
            csgAdmissionFixed32(
                csgAdmissionRegistry.queryKeyDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.beforeFact,
            csgAdmissionFixed32(
                csgAdmissionRegistry.beforeFactDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.afterFact,
            csgAdmissionFixed32(
                csgAdmissionRegistry.afterFactDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.proof,
            csgAdmissionFixed32(
                csgAdmissionRegistry.proofDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.replay,
            csgAdmissionFixed32(
                csgAdmissionRegistry.replayDigests, row)) &&
        layout.FixedBytes32Equal(
            digests.validatorKind,
            csgAdmissionFixed32(
                csgAdmissionRegistry.validatorKindDigests, row)) &&
        !layout.FixedBytes32Equal(
            digests.artifact, layout.FixedBytes32())

@borrows
fn CsgCoreMerkleSealedBeforeClaimedBinding(
        claimed: CsgCoreMerkleSealedBeforeClaimedToken):
        CsgCoreMerkleSealedBeforeBindingResult =
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           claimed.ownerId,
           claimed.generation,
           claimed.kind,
           claimed.authenticator,
           csgAdmissionStateClaimed):
        csgAdmissionUnlock()
        return csgAdmissionBindingFail(
            "merkle_sealed_authority_claimed_token_invalid")
    let row = claimed.ownerId - 1
    if !csgAdmissionPayloadValid(row):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionBindingFail(
            "merkle_sealed_authority_binding_rejoin_failed")
    var out: CsgCoreMerkleSealedBeforeBindingResult
    out.ok = true
    out.bindingDigest = layout.FixedBytes32Copy(
        csgAdmissionFixed32(
            csgAdmissionRegistry.bindingDigests, row))
    csgAdmissionUnlock()
    return out

fn csgAdmissionProjectionFromRow(
        row: int32,
        registryBinding: layout.FixedBytes32):
        CsgCoreMerkleSealedBeforeProjection =
    var projection: CsgCoreMerkleSealedBeforeProjection
    projection.summary.sealedBeforeContentCid =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.contentCidDigests, row))
    projection.summary.beforeFactsRoot =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.factsRootDigests, row))
    projection.summary.beforeDagRootCid =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.dagRootDigests, row))
    projection.summary.beforeSubgraphCid =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.subgraphDigests, row))
    projection.summary.beforeFactCount = csgAdmissionI32(
        csgAdmissionRegistry.factCounts, row)
    projection.bindingDigest =
        layout.FixedBytes32Copy(registryBinding)
    projection.bindingIdentityReceiptCid =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.bindingIdentityDigests, row))
    projection.beforeCsgcDirectoryCid =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.csgcDirectoryDigests, row))
    projection.beforeCsgcObjectCid =
        csgAdmissionCidText(csgAdmissionFixed32(
            csgAdmissionRegistry.csgcObjectDigests, row))
    projection.schemaFactDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.schemaFactDigests, row)
    projection.queryKeyDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.queryKeyDigests, row)
    projection.beforeFactDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.beforeFactDigests, row)
    projection.afterFactDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.afterFactDigests, row)
    projection.beforePhysicalOrdinal = csgAdmissionI32(
        csgAdmissionRegistry.beforePhysicalOrdinals, row)
    projection.validatorKindDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.validatorKindDigests, row)
    projection.replacementScope = csgAdmissionI32(
        csgAdmissionRegistry.replacementScopes, row)
    projection.proofDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.proofDigests, row)
    projection.replayDigest = csgAdmissionFixed32(
        csgAdmissionRegistry.replayDigests, row)
    return projection

@borrows
fn CsgCoreMerkleSealedBeforeClaimedProjection(
        claimed: CsgCoreMerkleSealedBeforeClaimedToken,
        storedBinding: layout.FixedBytes32):
        CsgCoreMerkleSealedBeforeProjectionResult =
    if layout.FixedBytes32Equal(
           storedBinding, layout.FixedBytes32()):
        return csgAdmissionProjectionFail(
            "merkle_sealed_authority_projection_binding_empty")
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           claimed.ownerId,
           claimed.generation,
           claimed.kind,
           claimed.authenticator,
           csgAdmissionStateClaimed):
        csgAdmissionUnlock()
        return csgAdmissionProjectionFail(
            "merkle_sealed_authority_claimed_token_invalid")
    let row = claimed.ownerId - 1
    let registryBinding = csgAdmissionFixed32(
        csgAdmissionRegistry.bindingDigests, row)
    if !layout.FixedBytes32Equal(
           registryBinding, storedBinding) ||
       !csgAdmissionPayloadValid(row):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionProjectionFail(
            "merkle_sealed_authority_projection_rejoin_failed")
    let projection = csgAdmissionProjectionFromRow(
        row, registryBinding)
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeProjectionResult
    out.ok = true
    out.projection = projection
    return out

@borrows
fn csgAdmissionMappedCompletionMatches(
        row: int32,
        summary:
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionSummary):
        bool =
    return summary.factCount == csgAdmissionI32(
               csgAdmissionRegistry.factCounts, row) &&
        summary.readCount == summary.factCount &&
        layout.FixedBytes32Equal(
            summary.csgcDirectoryCid,
            csgAdmissionFixed32(
                csgAdmissionRegistry.csgcDirectoryDigests, row)) &&
        layout.FixedBytes32Equal(
            summary.csgcObjectCid,
            csgAdmissionFixed32(
                csgAdmissionRegistry.csgcObjectDigests, row)) &&
        layout.FixedBytes32Equal(
            summary.factsRoot,
            csgAdmissionFixed32(
                csgAdmissionRegistry.factsRootDigests, row)) &&
        layout.FixedBytes32Equal(
            summary.dagRootCid,
            csgAdmissionFixed32(
                csgAdmissionRegistry.dagRootDigests, row))

fn csgAdmissionPoisonVerifyingMapped(
        ownerId: int32,
        generation: int32,
        kind: int32,
        authenticator: layout.FixedBytes32) =
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           authenticator,
           csgAdmissionStateVerifyingMapped):
        csgAdmissionUnlock()
        panic("merkle admission authority: mapped verify terminal drift")
    csgAdmissionSetI32(
        csgAdmissionRegistry.states,
        ownerId - 1,
        csgAdmissionStatePoisoned)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()

fn CsgCoreMerkleSealedBeforeReadVerifyMapped(
        reading: var CsgCoreMerkleSealedBeforeReadToken,
        storedBinding: layout.FixedBytes32,
        completion:
            var merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority):
        CsgCoreMerkleSealedBeforeVerifyMappedResult =
    let ownerId = reading.ownerId
    let generation = reading.generation
    let kind = reading.kind
    let oldAuthenticator =
        layout.FixedBytes32Copy(reading.authenticator)
    reading = CsgCoreMerkleSealedBeforeReadToken()
    var heldCompletion = completion
    completion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           oldAuthenticator,
           csgAdmissionStateReading):
        csgAdmissionUnlock()
        let completionError =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                heldCompletion)
        if completionError.len > 0:
            panic("merkle admission authority: invalid mapped token cleanup failed")
        return csgAdmissionVerifyMappedFail(
            "merkle_sealed_authority_mapped_read_token_invalid")
    let row = ownerId - 1
    let registryBinding = csgAdmissionFixed32(
        csgAdmissionRegistry.bindingDigests, row)
    if !layout.FixedBytes32Equal(
           registryBinding, storedBinding) ||
       !csgAdmissionPayloadValid(row) ||
       csgAdmissionI32(
           csgAdmissionRegistry.readPositions, row) != 0:
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        let completionError =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                heldCompletion)
        if completionError.len > 0:
            panic("merkle admission authority: mapped rejoin cleanup failed")
        return csgAdmissionVerifyMappedFail(
            "merkle_sealed_authority_mapped_read_rejoin_failed")
    csgAdmissionSetI32(
        csgAdmissionRegistry.states,
        row,
        csgAdmissionStateVerifyingMapped)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    let lockedCompletion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcLockedCompletion(
            heldCompletion)
    var nonce: layout.FixedBytes32
    let nonceOk = csgAdmissionNonce(nonce)
    if !lockedCompletion.ok || !nonceOk:
        csgAdmissionPoisonVerifyingMapped(
            ownerId,
            generation,
            kind,
            oldAuthenticator)
        let completionError =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                heldCompletion)
        if lockedCompletion.ok && completionError.len > 0:
            panic("merkle admission authority: mapped completion cleanup failed")
        if !lockedCompletion.ok:
            return csgAdmissionVerifyMappedFail(lockedCompletion.error)
        return csgAdmissionVerifyMappedFail(
            "merkle_sealed_authority_mapped_verify_nonce_failed")
    let verifiedAuthenticator = csgAdmissionStageAuthenticator(
        nonce,
        registryBinding,
        generation,
        csgAdmissionKindVerifiedRead)
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           oldAuthenticator,
           csgAdmissionStateVerifyingMapped) ||
       !layout.FixedBytes32Equal(
           csgAdmissionFixed32(
               csgAdmissionRegistry.bindingDigests, row),
           registryBinding) ||
       !csgAdmissionPayloadValid(row) ||
       csgAdmissionI32(
           csgAdmissionRegistry.readPositions, row) != 0:
        csgAdmissionUnlock()
        let completionError =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                heldCompletion)
        if completionError.len > 0:
            panic("merkle admission authority: mapped completion rejoin cleanup failed")
        panic("merkle admission authority: mapped verify rejoin drift")
    if !csgAdmissionMappedCompletionMatches(
           row, lockedCompletion.summary) ||
       layout.FixedBytes32Equal(
           verifiedAuthenticator, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           verifiedAuthenticator, oldAuthenticator) ||
       layout.FixedBytes32Equal(
           verifiedAuthenticator, registryBinding) ||
       csgAdmissionAuthenticatorCollides(verifiedAuthenticator):
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        let completionError =
            merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                heldCompletion)
        if completionError.len > 0:
            panic("merkle admission authority: mapped mismatch cleanup failed")
        return csgAdmissionVerifyMappedFail(
            "merkle_sealed_authority_mapped_completion_mismatch")
    csgAdmissionSetFixed32(
        csgAdmissionRegistry.authenticators,
        row,
        verifiedAuthenticator)
    csgAdmissionSetI32(
        csgAdmissionRegistry.kinds,
        row,
        csgAdmissionKindVerifiedRead)
    csgAdmissionSetI32(
        csgAdmissionRegistry.readPositions,
        row,
        1)
    csgAdmissionSetI32(
        csgAdmissionRegistry.states,
        row,
        csgAdmissionStateVerifiedRead)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeVerifyMappedResult
    out.ok = true
    out.verified.ownerId = ownerId
    out.verified.generation = generation
    out.verified.kind = csgAdmissionKindVerifiedRead
    out.verified.authenticator =
        layout.FixedBytes32Copy(verifiedAuthenticator)
    out.completion = heldCompletion
    heldCompletion =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    return out

fn csgAdmissionPoisonExact(
        ownerId: int32,
        generation: int32,
        kind: int32,
        authenticator: layout.FixedBytes32,
        requiredState: int32):
        CsgCoreMerkleSealedBeforeTerminalResult =
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           authenticator,
           requiredState):
        csgAdmissionUnlock()
        return csgAdmissionTerminalFail(
            "merkle_sealed_authority_poison_token_invalid")
    let row = ownerId - 1
    csgAdmissionSetI32(
        csgAdmissionRegistry.states, row, csgAdmissionStatePoisoned)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeTerminalResult
    out.ok = true
    out.winner = true
    out.terminal = true
    out.poisoned = true
    return out

fn CsgCoreMerkleSealedBeforeLivePoison(
        live: var CsgCoreMerkleSealedBeforeLiveToken):
        CsgCoreMerkleSealedBeforeTerminalResult =
    let ownerId = live.ownerId
    let generation = live.generation
    let kind = live.kind
    let authenticator = layout.FixedBytes32Copy(live.authenticator)
    live = CsgCoreMerkleSealedBeforeLiveToken()
    return csgAdmissionPoisonExact(
        ownerId,
        generation,
        kind,
        authenticator,
        csgAdmissionStateLive)

fn CsgCoreMerkleSealedBeforeClaimedPoison(
        claimed: var CsgCoreMerkleSealedBeforeClaimedToken):
        CsgCoreMerkleSealedBeforeTerminalResult =
    let ownerId = claimed.ownerId
    let generation = claimed.generation
    let kind = claimed.kind
    let authenticator = layout.FixedBytes32Copy(claimed.authenticator)
    claimed = CsgCoreMerkleSealedBeforeClaimedToken()
    return csgAdmissionPoisonExact(
        ownerId,
        generation,
        kind,
        authenticator,
        csgAdmissionStateClaimed)

fn CsgCoreMerkleSealedBeforeReadPoison(
        reading: var CsgCoreMerkleSealedBeforeReadToken):
        CsgCoreMerkleSealedBeforeTerminalResult =
    let ownerId = reading.ownerId
    let generation = reading.generation
    let kind = reading.kind
    let authenticator = layout.FixedBytes32Copy(reading.authenticator)
    reading = CsgCoreMerkleSealedBeforeReadToken()
    return csgAdmissionPoisonExact(
        ownerId,
        generation,
        kind,
        authenticator,
        csgAdmissionStateReading)

fn CsgCoreMerkleSealedBeforeVerifiedReadPoison(
        verified: var CsgCoreMerkleSealedBeforeVerifiedReadToken):
        CsgCoreMerkleSealedBeforeTerminalResult =
    let ownerId = verified.ownerId
    let generation = verified.generation
    let kind = verified.kind
    let authenticator =
        layout.FixedBytes32Copy(verified.authenticator)
    verified = CsgCoreMerkleSealedBeforeVerifiedReadToken()
    return csgAdmissionPoisonExact(
        ownerId,
        generation,
        kind,
        authenticator,
        csgAdmissionStateVerifiedRead)

fn csgAdmissionConsumeWinner(
        verified: var CsgCoreMerkleSealedBeforeVerifiedReadToken,
        storedBinding: layout.FixedBytes32):
        CsgCoreMerkleSealedBeforeTerminalResult =
    let ownerId = verified.ownerId
    let generation = verified.generation
    let kind = verified.kind
    let authenticator =
        layout.FixedBytes32Copy(verified.authenticator)
    verified = CsgCoreMerkleSealedBeforeVerifiedReadToken()
    csgAdmissionEnsureRegistry()
    csgAdmissionLock()
    if !csgAdmissionHandleMatches(
           ownerId,
           generation,
           kind,
           authenticator,
           csgAdmissionStateVerifiedRead):
        csgAdmissionUnlock()
        return csgAdmissionTerminalFail(
            "merkle_sealed_authority_consume_read_token_invalid")
    let row = ownerId - 1
    if !layout.FixedBytes32Equal(
           csgAdmissionFixed32(
               csgAdmissionRegistry.bindingDigests, row),
           storedBinding) ||
       !csgAdmissionPayloadValid(row) ||
       csgAdmissionI32(
           csgAdmissionRegistry.readPositions, row) != 1:
        csgAdmissionSetI32(
            csgAdmissionRegistry.states,
            row,
            csgAdmissionStatePoisoned)
        os.CsgMerkleAdmissionRegistryNotifyAll()
        csgAdmissionUnlock()
        return csgAdmissionTerminalFail(
            "merkle_sealed_authority_consume_rejoin_failed")
    csgAdmissionSetI32(
        csgAdmissionRegistry.states, row, csgAdmissionStateConsumed)
    os.CsgMerkleAdmissionRegistryNotifyAll()
    csgAdmissionUnlock()
    var out: CsgCoreMerkleSealedBeforeTerminalResult
    out.ok = true
    out.winner = true
    out.terminal = true
    out.consumed = true
    return out

fn CsgCoreMerkleSealedBeforeVerifiedReadConsume(
        verified: var CsgCoreMerkleSealedBeforeVerifiedReadToken,
        storedBinding: layout.FixedBytes32):
        CsgCoreMerkleSealedBeforeTerminalResult =
    return csgAdmissionConsumeWinner(
        verified, storedBinding)

@borrows
fn csgAdmissionTextCompare(
        left: str,
        right: str): int32 =
    let common =
        if left.len < right.len:
            left.len
        else:
            right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgAdmissionSortedOrder(
        keys: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, keys.len)
    setLen(scratch, keys.len)
    for i in 0..<keys.len:
        order[i] = i
    var width: int32 = 1
    while width < keys.len:
        var left: int32
        while left < keys.len:
            var middle = left + width
            if middle > keys.len:
                middle = keys.len
            var right = middle + width
            if right > keys.len:
                right = keys.len
            var leftAt = left
            var rightAt = middle
            var writeAt = left
            while leftAt < middle &&
                  rightAt < right:
                if csgAdmissionTextCompare(
                       keys[order[leftAt]],
                       keys[order[rightAt]]) <= 0:
                    scratch[writeAt] =
                        order[leftAt]
                    leftAt = leftAt + 1
                else:
                    scratch[writeAt] =
                        order[rightAt]
                    rightAt = rightAt + 1
                writeAt = writeAt + 1
            while leftAt < middle:
                scratch[writeAt] = order[leftAt]
                leftAt = leftAt + 1
                writeAt = writeAt + 1
            while rightAt < right:
                scratch[writeAt] = order[rightAt]
                rightAt = rightAt + 1
                writeAt = writeAt + 1
            for i in left..<right:
                order[i] = scratch[i]
            left = right
        if width > keys.len / 2:
            width = keys.len
        else:
            width = width * 2
    return order

@borrows
fn csgAdmissionBinaryContains(
        keys: str[],
        order: int32[],
        wanted: str): bool =
    var low: int32
    var high = order.len
    while low < high:
        let middle = low + (high - low) / 2
        let compared =
            csgAdmissionTextCompare(
                keys[order[middle]], wanted)
        if compared < 0:
            low = middle + 1
        else:
            high = middle
    return low < order.len &&
        keys[order[low]] == wanted

@borrows
fn csgAdmissionTuplePart(value: str): str =
    return csgAdmissionCat(
        csgAdmissionCat(
            strings.IntToStr(value.len), ":"),
        value)

@borrows
fn csgAdmissionSourceSubgraphKey(
        sourceId: str,
        subgraphCid: str): str =
    return csgAdmissionCat(
        csgAdmissionTuplePart(sourceId),
        csgAdmissionTuplePart(subgraphCid))

@borrows
fn csgAdmissionHashCid(
        value: layout.FixedBytes32): str =
    return csgAdmissionCat(
        "sha256:",
        layout.FixedBytes32Hex(value))

@borrows
fn csgAdmissionCloneNode(
        node: merkle_dag.CsgCoreMerkleNodeRecord):
        merkle_dag.CsgCoreMerkleNodeRecord =
    var out: merkle_dag.CsgCoreMerkleNodeRecord
    out.kind = node.kind
    out.count = node.count
    out.splitBit = node.splitBit
    out.hash = node.hash
    out.key = strings.CloneStr(node.key)
    out.keyHash = node.keyHash
    out.factHash = node.factHash
    out.leftCount = node.leftCount
    out.leftHash = node.leftHash
    out.rightCount = node.rightCount
    out.rightHash = node.rightHash
    return out

@borrows
fn csgAdmissionCloneMembership(
        record:
            merkle_artifacts.CsgCoreMerkleMembershipRecord):
        merkle_artifacts.CsgCoreMerkleMembershipRecord =
    var out: merkle_artifacts.CsgCoreMerkleMembershipRecord
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid =
        strings.CloneStr(record.sourceCid)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    return out

@borrows
fn csgAdmissionCloneQuery(
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        merkle_artifacts.CsgCoreMerkleQueryIndexRecord =
    var out: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    out.indexKind =
        strings.CloneStr(record.indexKind)
    out.term = strings.CloneStr(record.term)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid =
        strings.CloneStr(record.sourceCid)
    return out

@borrows
fn csgAdmissionCloneDependency(
        record:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        merkle_artifacts.CsgCoreMerkleDependencyRecord =
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord
    out.consumerSource =
        strings.CloneStr(record.consumerSource)
    out.providerSource =
        strings.CloneStr(record.providerSource)
    out.selector = strings.CloneStr(record.selector)
    out.providerSubgraphCid =
        strings.CloneStr(record.providerSubgraphCid)
    return out

@borrows
fn csgAdmissionDependencyCompare(
        left:
            merkle_artifacts.CsgCoreMerkleDependencyRecord,
        right:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        int32 =
    var order =
        csgAdmissionTextCompare(
            left.consumerSource,
            right.consumerSource)
    if order != 0:
        return order
    order =
        csgAdmissionTextCompare(
            left.providerSource,
            right.providerSource)
    if order != 0:
        return order
    order =
        csgAdmissionTextCompare(
            left.selector, right.selector)
    if order != 0:
        return order
    return csgAdmissionTextCompare(
        left.providerSubgraphCid,
        right.providerSubgraphCid)

@borrows
fn csgAdmissionSortDependencies(
        records:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        merkle_artifacts.CsgCoreMerkleDependencyRecord[] =
    var order: int32[]
    var scratch: int32[]
    for i in 0..<records.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgAdmissionDependencyCompare(
                        records[order[left]],
                        records[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    for i in 0..<order.len:
        add(
            out,
            csgAdmissionCloneDependency(
                records[order[i]]))
    return out

@borrows
fn csgAdmissionDependencyEqual(
        left:
            merkle_artifacts.CsgCoreMerkleDependencyRecord,
        right:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        bool =
    return left.consumerSource == right.consumerSource &&
        left.providerSource == right.providerSource &&
        left.selector == right.selector &&
        left.providerSubgraphCid ==
            right.providerSubgraphCid

@borrows
fn csgAdmissionDependencyProjectionError(
        consumers:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        providers:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        str =
    let left = csgAdmissionSortDependencies(consumers)
    let right = csgAdmissionSortDependencies(providers)
    if left.len != right.len:
        return "merkle_admission_dependency_projection_count_mismatch"
    for i in 0..<left.len:
        if !csgAdmissionDependencyEqual(
               left[i], right[i]):
            return "merkle_admission_dependency_projection_bijection_failed"
        if i > 0 &&
           csgAdmissionDependencyEqual(
               left[i - 1], left[i]):
            return "merkle_admission_dependency_projection_duplicate"
    return ""

@borrows
fn csgAdmissionDependencyShardMatches(
        descriptor:
            merkle_manifest.CsgCoreMerkleShardDescriptor,
        profileSetCid: str,
        projection: str,
        shard:
            merkle_artifacts.CsgCoreMerkleDependencyShardResult):
        bool =
    return shard.ok &&
        shard.cid == descriptor.cid &&
        shard.shardRoot == descriptor.root &&
        shard.entryCount == descriptor.entryCount &&
        shard.header.profileSetCid == profileSetCid &&
        shard.header.projection == projection &&
        shard.header.shardKey == descriptor.shardKey

@borrows
fn csgAdmissionQueryShardMatches(
        descriptor:
            merkle_manifest.CsgCoreMerkleShardDescriptor,
        profileSetCid: str,
        shard:
            merkle_artifacts.CsgCoreMerkleQueryShardResult):
        bool =
    return shard.ok &&
        shard.cid == descriptor.cid &&
        shard.shardRoot == descriptor.root &&
        shard.entryCount == descriptor.entryCount &&
        shard.header.profileSetCid == profileSetCid &&
        shard.header.bucket == descriptor.shardKey

@borrows
fn csgAdmissionPartitionMatches(
        manifestPartition:
            merkle_manifest.CsgCoreMerklePartitionRecord,
        partition:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult):
        bool =
    return partition.cid ==
               manifestPartition.factsCid &&
        partition.header.partitionId ==
            merkle_manifest.CsgCoreMerklePartitionId(
                manifestPartition) &&
        partition.header.sourceId ==
            manifestPartition.sourceId &&
        partition.header.sourceCid ==
            manifestPartition.sourceCid &&
        partition.header.factKind ==
            manifestPartition.factKind &&
        partition.factsRoot ==
            manifestPartition.factsRoot &&
        partition.dagRootCid ==
            manifestPartition.dagRootCid &&
        partition.factCount ==
            manifestPartition.factCount

@borrows
fn csgAdmissionMembershipMatches(
        manifestPartition:
            merkle_manifest.CsgCoreMerklePartitionRecord,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipResult):
        bool =
    let partitionId =
        merkle_manifest.CsgCoreMerklePartitionId(
            manifestPartition)
    return membership.cid ==
               manifestPartition.membershipCid &&
        membership.header.partitionId ==
            partitionId &&
        membership.header.sourceId ==
            manifestPartition.sourceId &&
        membership.header.sourceCid ==
            manifestPartition.sourceCid &&
        membership.header.factKind ==
            manifestPartition.factKind &&
        membership.header.factsCid ==
            manifestPartition.factsCid &&
        membership.header.factsRoot ==
            manifestPartition.factsRoot &&
        membership.header.dagRootCid ==
            manifestPartition.dagRootCid &&
        membership.header.factCount ==
            manifestPartition.factCount &&
        membership.recordCount ==
            manifestPartition.factCount

@borrows
fn csgAdmissionMembershipError(
        dag: merkle_dag.CsgCoreMerkleDag,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipResult):
        str =
    var leaves: merkle_dag.CsgCoreMerkleNodeRecord[]
    var leafKeys: str[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        if dag.nodeKinds[nodeIndex] !=
           merkle_dag.CsgCoreMerkleLeafNodeKind():
            continue
        var projectionError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, nodeIndex, projectionError)
        if projectionError.len > 0:
            return csgAdmissionCat(
                "merkle_admission_membership_projection ",
                projectionError)
        add(leaves, csgAdmissionCloneNode(node))
        add(leafKeys, strings.CloneStr(node.key))
    if leaves.len != membership.records.len:
        return "merkle_admission_membership_count_mismatch"
    let leafOrder =
        csgAdmissionSortedOrder(leafKeys)
    for i in 0..<leafOrder.len:
        let leaf = leaves[leafOrder[i]]
        let actual = membership.records[i]
        if actual.factKey != leaf.key ||
           actual.factHash !=
               csgAdmissionHashCid(leaf.factHash) ||
           actual.leafCid !=
               merkle_dag.CsgCoreMerkleNodeRecordCid(
                   leaf):
            return "merkle_admission_membership_binding_mismatch"
    return ""

@borrows
fn csgAdmissionQueryCompare(
        left:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        right:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        int32 =
    var order =
        csgAdmissionTextCompare(
            left.indexKind, right.indexKind)
    if order != 0:
        return order
    order =
        csgAdmissionTextCompare(
            left.term, right.term)
    if order != 0:
        return order
    order =
        csgAdmissionTextCompare(
            left.factKey, right.factKey)
    if order != 0:
        return order
    order =
        csgAdmissionTextCompare(
            left.partitionId,
            right.partitionId)
    if order != 0:
        return order
    return csgAdmissionTextCompare(
        left.sourceId, right.sourceId)

@borrows
fn csgAdmissionSortQueries(
        records:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        out: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]) =
    out = []
    var order: int32[]
    var scratch: int32[]
    setLen(order, records.len)
    setLen(scratch, records.len)
    for i in 0..<records.len:
        order[i] = i
    var width: int32 = 1
    while width < records.len:
        var left: int32
        while left < records.len:
            var middle = left + width
            if middle > records.len:
                middle = records.len
            var right = middle + width
            if right > records.len:
                right = records.len
            var leftAt = left
            var rightAt = middle
            var writeAt = left
            while leftAt < middle &&
                  rightAt < right:
                if csgAdmissionQueryCompare(
                       records[order[leftAt]],
                       records[order[rightAt]]) <= 0:
                    scratch[writeAt] =
                        order[leftAt]
                    leftAt = leftAt + 1
                else:
                    scratch[writeAt] =
                        order[rightAt]
                    rightAt = rightAt + 1
                writeAt = writeAt + 1
            while leftAt < middle:
                scratch[writeAt] = order[leftAt]
                leftAt = leftAt + 1
                writeAt = writeAt + 1
            while rightAt < right:
                scratch[writeAt] = order[rightAt]
                rightAt = rightAt + 1
                writeAt = writeAt + 1
            for i in left..<right:
                order[i] = scratch[i]
            left = right
        if width > records.len / 2:
            width = records.len
        else:
            width = width * 2
    for i in 0..<order.len:
        add(
            out,
            csgAdmissionCloneQuery(
                records[order[i]]))

@borrows
fn csgAdmissionAppendQuery(
        records: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        indexKind: str,
        term: str,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord) =
    if term.len == 0:
        return
    var record: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    record.indexKind = strings.CloneStr(indexKind)
    record.term = strings.CloneStr(term)
    record.factKey =
        strings.CloneStr(membership.factKey)
    record.factHash =
        strings.CloneStr(membership.factHash)
    record.leafCid =
        strings.CloneStr(membership.leafCid)
    record.partitionId =
        strings.CloneStr(membership.partitionId)
    record.sourceId =
        strings.CloneStr(membership.sourceId)
    record.sourceCid =
        strings.CloneStr(membership.sourceCid)
    add(records, record)

@borrows
fn csgAdmissionAppendOptionalQuery(
        records: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        line: str,
        fieldName: str,
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord) =
    let value =
        field.CsgCoreJsonTopStringField(
            line, fieldName)
    if value.found && value.value.len > 0:
        csgAdmissionAppendQuery(
            records,
            fieldName,
            value.value,
            membership)

@borrows
fn csgAdmissionQueryEqual(
        left:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        right:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        bool =
    return left.indexKind == right.indexKind &&
        left.term == right.term &&
        left.factKey == right.factKey &&
        left.factHash == right.factHash &&
        left.leafCid == right.leafCid &&
        left.partitionId == right.partitionId &&
        left.sourceId == right.sourceId &&
        left.sourceCid == right.sourceCid

@borrows
fn csgAdmissionAppendPartitionQueries(
        facts: str[],
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord[],
        out: var
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        error: var str): bool =
    if facts.len != membership.len:
        error =
            "merkle_admission_partition_query_count_mismatch"
        return false
    for factIndex in 0..<facts.len:
        var keyError: str
        let factKey =
            merkle_dag.CsgCoreMerkleFactKeyFromCanonical(
                facts[factIndex], keyError)
        if keyError.len > 0:
            error =
                "merkle_admission_partition_query_fact_key_invalid"
            return false
        let membershipIndex =
            csgAdmissionMembershipRecordAt(
                membership, factKey)
        if membershipIndex < 0:
            error =
                "merkle_admission_partition_query_membership_missing"
            return false
        let record = membership[membershipIndex]
        let kind =
            field.CsgCoreJsonKind(facts[factIndex])
        if !kind.found:
            error =
                "merkle_admission_partition_query_kind_missing"
            return false
        csgAdmissionAppendQuery(
            out, "fact_key", record.factKey, record)
        csgAdmissionAppendQuery(
            out, "kind", kind.value, record)
        csgAdmissionAppendOptionalQuery(
            out, facts[factIndex], "symbol", record)
        csgAdmissionAppendOptionalQuery(
            out, facts[factIndex], "name", record)
        csgAdmissionAppendOptionalQuery(
            out, facts[factIndex], "file", record)
        csgAdmissionAppendOptionalQuery(
            out, facts[factIndex], "caller", record)
    return true

@borrows
fn csgAdmissionSummaryMatches(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        summary:
            merkle_artifacts.CsgCoreMerkleSummaryResult,
        queryIndexCount: int32): bool =
    let header = summary.header
    return summary.cid == manifest.summaryCid &&
        header.standard == manifest.standard &&
        validator.CsgCoreProfilesEqual(
            header.profiles, manifest.profiles) &&
        header.profileSetCid == manifest.profileSetCid &&
        header.complete == manifest.complete &&
        header.schemaCid == manifest.schemaCid &&
        header.factsRoot == manifest.factsRoot &&
        header.dagRootCid == manifest.dagRootCid &&
        header.factCount == manifest.factCount &&
        header.nodeCount == manifest.nodeCount &&
        header.partitionRoot ==
            manifest.partitionRoot &&
        header.partitionCount ==
            manifest.partitions.len &&
        header.dependencyConsumerRoot ==
            manifest.dependencyConsumerRoot &&
        header.dependencyProviderRoot ==
            manifest.dependencyProviderRoot &&
        header.dependencyCount ==
            manifest.dependencyCount &&
        header.dependencyConsumerShardCount ==
            manifest.dependencyConsumerShards.len &&
        header.dependencyProviderShardCount ==
            manifest.dependencyProviderShards.len &&
        header.queryShardRoot ==
            manifest.queryShardRoot &&
        header.queryIndexCount ==
            queryIndexCount &&
        header.queryShardCount ==
            manifest.queryShards.len &&
        header.unsupportedCount ==
            manifest.unsupportedCount &&
        header.tombstoneCount ==
            manifest.tombstoneCount &&
        header.runtimeRequirementCount ==
            manifest.runtimeRequirementCount

@borrows
fn CsgCoreMerkleAdmissionVerify(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        artifacts: CsgCoreMerkleAdmissionArtifacts):
        CsgCoreMerkleAdmissionResult =
    let manifestError =
        merkle_manifest.CsgCoreMerkleManifestError(
            manifest)
    if manifestError.len > 0:
        return csgAdmissionFail(
            csgAdmissionCat(
                "merkle_admission_manifest ",
                manifestError))
    if artifacts.partitionBytes.len !=
           manifest.partitions.len ||
       artifacts.membershipBytes.len !=
           manifest.partitions.len ||
       artifacts.nodeSegmentBytes.len !=
           manifest.nodeCount ||
       artifacts.dependencyConsumerShardBytes.len !=
           manifest.dependencyConsumerShards.len ||
       artifacts.dependencyProviderShardBytes.len !=
           manifest.dependencyProviderShards.len ||
       artifacts.queryShardBytes.len !=
           manifest.queryShards.len:
        return csgAdmissionFail(
            "merkle_admission_artifact_count_mismatch")

    var globalFacts: str[]
    var globalFactKeys: str[]
    var globalMembership: merkle_artifacts.CsgCoreMerkleMembershipRecord[]
    var sourceIds: str[]
    var sourceCids: str[]
    var sourceSubgraphKeys: str[]

    for partitionIndex in 0..<manifest.partitions.len:
        var partition =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                artifacts.partitionBytes[partitionIndex])
        rawbytes.BytesFree(partition.bytes)
        if !partition.ok:
            return csgAdmissionFail(
                csgAdmissionCat(
                    "merkle_admission_partition ",
                    partition.error))
        let manifestPartition =
            manifest.partitions[partitionIndex]
        if !csgAdmissionPartitionMatches(
               manifestPartition, partition):
            return csgAdmissionFail(
                "merkle_admission_partition_manifest_mismatch")
        let partitionDag =
            merkle_dag.CsgCoreMerkleBuildFromCanonicalLines(
                partition.facts)
        if !partitionDag.ok ||
           partitionDag.subgraphCid !=
               manifestPartition.factsRoot ||
           merkle_dag.CsgCoreMerkleDagRootCid(
               partitionDag) !=
               manifestPartition.dagRootCid:
            return csgAdmissionFail(
                "merkle_admission_partition_dag_mismatch")
        for factIndex in 0..<partition.facts.len:
            let kind =
                field.CsgCoreJsonKind(
                    partition.facts[factIndex])
            if !kind.found ||
               kind.value !=
                   manifestPartition.factKind:
                return csgAdmissionFail(
                    "merkle_admission_partition_kind_mismatch")
            var keyError: str
            let factKey =
                merkle_dag.CsgCoreMerkleFactKeyFromCanonical(
                    partition.facts[factIndex],
                    keyError)
            if keyError.len > 0:
                return csgAdmissionFail(
                    csgAdmissionCat(
                        "merkle_admission_fact_key ",
                        keyError))
            add(
                globalFacts,
                strings.CloneStr(
                    partition.facts[factIndex]))
            add(
                globalFactKeys,
                strings.CloneStr(factKey))

        var membership =
            merkle_artifacts.CsgCoreMerkleMembershipDecode(
                artifacts.membershipBytes[
                    partitionIndex])
        rawbytes.BytesFree(membership.bytes)
        if !membership.ok:
            return csgAdmissionFail(
                csgAdmissionCat(
                    "merkle_admission_membership ",
                    membership.error))
        if !csgAdmissionMembershipMatches(
               manifestPartition, membership):
            return csgAdmissionFail(
                "merkle_admission_membership_manifest_mismatch")
        let membershipError =
            csgAdmissionMembershipError(
                partitionDag, membership)
        if membershipError.len > 0:
            return csgAdmissionFail(membershipError)
        for recordIndex in 0..<membership.records.len:
            add(
                globalMembership,
                csgAdmissionCloneMembership(
                    membership.records[recordIndex]))

        add(
            sourceIds,
            strings.CloneStr(
                manifestPartition.sourceId))
        add(
            sourceCids,
            strings.CloneStr(
                manifestPartition.sourceCid))
        add(
            sourceSubgraphKeys,
            csgAdmissionSourceSubgraphKey(
                manifestPartition.sourceId,
                manifestPartition.factsRoot))

    var globalDag: merkle_dag.CsgCoreMerkleDag
    let validation =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            globalFacts, globalDag)
    if !validation.valid ||
       !validation.complete ||
       validation.factCount != manifest.factCount ||
       validation.standard != manifest.standard ||
       !validator.CsgCoreProfilesEqual(
           validation.profiles, manifest.profiles) ||
       validation.profileSetCid != manifest.profileSetCid ||
       validation.unsupportedCount != 0 ||
       validation.tombstoneCount != 0:
        if validation.errors.len > 0:
            return csgAdmissionFail(
                csgAdmissionCat(
                    "merkle_admission_fact_validation ",
                    validation.errors[0]))
        return csgAdmissionFail(
            "merkle_admission_fact_validation_failed")
    if !globalDag.ok ||
       globalDag.schemaCid != manifest.schemaCid ||
       globalDag.factCount != manifest.factCount ||
       globalDag.factsRoot != manifest.factsRoot ||
       merkle_dag.CsgCoreMerkleDagRootCid(
           globalDag) != manifest.dagRootCid:
        return csgAdmissionFail(
            "merkle_admission_global_root_mismatch")

    let sourceOrder =
        csgAdmissionSortedOrder(sourceIds)
    for i in 1..<sourceOrder.len:
        let previous = sourceOrder[i - 1]
        let current = sourceOrder[i]
        if sourceIds[previous] ==
               sourceIds[current] &&
           sourceCids[previous] !=
               sourceCids[current]:
            return csgAdmissionFail(
                "merkle_admission_source_cid_conflict")
    let subgraphOrder =
        csgAdmissionSortedOrder(
            sourceSubgraphKeys)

    var nodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for segmentIndex in 0..<artifacts.nodeSegmentBytes.len:
        var segment =
            merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
                artifacts.nodeSegmentBytes[
                    segmentIndex])
        rawbytes.BytesFree(segment.bytes)
        if !segment.ok:
            return csgAdmissionFail(
                "merkle_admission_node_segment_mismatch")
        if segment.nodes.len != 1:
            return csgAdmissionFail(
                "merkle_admission_node_segment_cardinality_invalid")
        for nodeIndex in 0..<segment.nodes.len:
            add(
                nodes,
                csgAdmissionCloneNode(
                    segment.nodes[nodeIndex]))
    let closureError =
        merkle_closure.CsgCoreMerkleNodeClosureError(
            globalDag, nodes)
    if closureError.len > 0:
        return csgAdmissionFail(closureError)


    var consumerRecords: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    for shardIndex in
            0..<manifest.dependencyConsumerShards.len:
        var shard =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                artifacts.dependencyConsumerShardBytes[
                    shardIndex])
        rawbytes.BytesFree(shard.bytes)
        if !csgAdmissionDependencyShardMatches(
               manifest.dependencyConsumerShards[
                   shardIndex],
               manifest.profileSetCid,
               merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection(),
               shard):
            return csgAdmissionFail(
                "merkle_admission_dependency_consumer_shard_mismatch")
        for recordIndex in 0..<shard.records.len:
            add(
                consumerRecords,
                csgAdmissionCloneDependency(
                    shard.records[recordIndex]))

    var providerRecords: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    for shardIndex in
            0..<manifest.dependencyProviderShards.len:
        var shard =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                artifacts.dependencyProviderShardBytes[
                    shardIndex])
        rawbytes.BytesFree(shard.bytes)
        if !csgAdmissionDependencyShardMatches(
               manifest.dependencyProviderShards[
                   shardIndex],
               manifest.profileSetCid,
               merkle_artifacts.CsgCoreMerkleDependencyProviderProjection(),
               shard):
            return csgAdmissionFail(
                "merkle_admission_dependency_provider_shard_mismatch")
        for recordIndex in 0..<shard.records.len:
            add(
                providerRecords,
                csgAdmissionCloneDependency(
                    shard.records[recordIndex]))
    if consumerRecords.len != manifest.dependencyCount ||
       providerRecords.len != manifest.dependencyCount:
        return csgAdmissionFail(
            "merkle_admission_dependency_count_mismatch")
    let projectionError =
        csgAdmissionDependencyProjectionError(
            consumerRecords, providerRecords)
    if projectionError.len > 0:
        return csgAdmissionFail(projectionError)
    for i in 0..<consumerRecords.len:
        let record = consumerRecords[i]
        if !csgAdmissionBinaryContains(
               sourceIds,
               sourceOrder,
               record.consumerSource) ||
           !csgAdmissionBinaryContains(
               sourceIds,
               sourceOrder,
               record.providerSource):
            return csgAdmissionFail(
                "merkle_admission_dependency_source_missing")
        let providerKey =
            csgAdmissionSourceSubgraphKey(
                record.providerSource,
                record.providerSubgraphCid)
        if !csgAdmissionBinaryContains(
               sourceSubgraphKeys,
               subgraphOrder,
               providerKey):
            return csgAdmissionFail(
                "merkle_admission_dependency_subgraph_mismatch")

    var queryRecords: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    for shardIndex in 0..<manifest.queryShards.len:
        var shard =
            merkle_artifacts.CsgCoreMerkleQueryShardDecode(
                artifacts.queryShardBytes[shardIndex])
        rawbytes.BytesFree(shard.bytes)
        if !csgAdmissionQueryShardMatches(
               manifest.queryShards[shardIndex],
               manifest.profileSetCid,
               shard):
            return csgAdmissionFail(
                "merkle_admission_query_shard_mismatch")
        for recordIndex in 0..<shard.records.len:
            add(
                queryRecords,
                csgAdmissionCloneQuery(
                    shard.records[recordIndex]))
    if queryRecords.len != manifest.queryIndexCount:
        return csgAdmissionFail(
            "merkle_admission_query_index_count_mismatch")
    var sortedQueryRecords: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    csgAdmissionSortQueries(
        queryRecords, sortedQueryRecords)

    var membershipKeys: str[]
    for i in 0..<globalMembership.len:
        add(
            membershipKeys,
            strings.CloneStr(
                globalMembership[i].factKey))
    let factOrder =
        csgAdmissionSortedOrder(globalFactKeys)
    let membershipOrder =
        csgAdmissionSortedOrder(membershipKeys)
    if factOrder.len != membershipOrder.len:
        return csgAdmissionFail(
            "merkle_admission_global_membership_count_mismatch")
    var expectedQueries: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    for i in 0..<factOrder.len:
        let factIndex = factOrder[i]
        let membershipIndex = membershipOrder[i]
        if globalFactKeys[factIndex] !=
           membershipKeys[membershipIndex]:
            return csgAdmissionFail(
                "merkle_admission_global_membership_key_mismatch")
        let membership =
            globalMembership[membershipIndex]
        let line = globalFacts[factIndex]
        let kind = field.CsgCoreJsonKind(line)
        if !kind.found:
            return csgAdmissionFail(
                "merkle_admission_query_fact_kind_missing")
        csgAdmissionAppendQuery(
            expectedQueries,
            "fact_key",
            membership.factKey,
            membership)
        csgAdmissionAppendQuery(
            expectedQueries,
            "kind",
            kind.value,
            membership)
        csgAdmissionAppendOptionalQuery(
            expectedQueries,
            line,
            "symbol",
            membership)
        csgAdmissionAppendOptionalQuery(
            expectedQueries,
            line,
            "name",
            membership)
        csgAdmissionAppendOptionalQuery(
            expectedQueries,
            line,
            "file",
            membership)
        csgAdmissionAppendOptionalQuery(
            expectedQueries,
            line,
            "caller",
            membership)
    var sortedExpectedQueries: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    csgAdmissionSortQueries(
        expectedQueries, sortedExpectedQueries)
    if sortedExpectedQueries.len !=
       sortedQueryRecords.len:
        return csgAdmissionFail(
            "merkle_admission_query_index_count_mismatch")
    for i in 0..<sortedExpectedQueries.len:
        if !csgAdmissionQueryEqual(
               sortedExpectedQueries[i],
               sortedQueryRecords[i]):
            return csgAdmissionFail(
                "merkle_admission_query_index_entry_mismatch")

    var summary =
        merkle_artifacts.CsgCoreMerkleSummaryDecode(
            artifacts.summaryBytes)
    rawbytes.BytesFree(summary.bytes)
    if !summary.ok:
        return csgAdmissionFail(
            csgAdmissionCat(
                "merkle_admission_summary ",
                summary.error))
    if !csgAdmissionSummaryMatches(
           manifest, summary, sortedQueryRecords.len):
        return csgAdmissionFail(
            "merkle_admission_summary_manifest_mismatch")

    var out: CsgCoreMerkleAdmissionResult
    out.ok = true
    out.queryIndexCount = sortedQueryRecords.len
    return out

@borrows
fn csgAdmissionContainsText(
        values: str[],
        wanted: str): bool =
    for i in 0..<values.len:
        if values[i] == wanted:
            return true
    return false

@borrows
fn csgAdmissionDescriptorKeyUnion(
        previous:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        next:
            merkle_manifest.CsgCoreMerkleShardDescriptor[]): str[] =
    var values: str[]
    for i in 0..<previous.len:
        add(
            values,
            strings.CloneStr(previous[i].shardKey))
    for i in 0..<next.len:
        add(values, strings.CloneStr(next[i].shardKey))
    let sorted =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            values)
    var out: str[]
    for i in 0..<sorted.len:
        if i == 0 || sorted[i] != sorted[i - 1]:
            add(out, strings.CloneStr(sorted[i]))
    return out

@borrows
fn csgAdmissionSortedUnique(
        values: str[],
        out: var str[]): bool =
    out =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            values)
    for i in 0..<out.len:
        if out[i].len == 0:
            return false
        if i > 0 && out[i - 1] == out[i]:
            return false
    return true

@borrows
fn csgAdmissionSortedSetEqual(
        left: str[],
        right: str[]): bool =
    var sortedLeft: str[]
    var sortedRight: str[]
    if !csgAdmissionSortedUnique(left, sortedLeft) ||
       !csgAdmissionSortedUnique(right, sortedRight) ||
       sortedLeft.len != sortedRight.len:
        return false
    for i in 0..<sortedLeft.len:
        if sortedLeft[i] != sortedRight[i]:
            return false
    return true

@borrows
fn csgAdmissionCanonicalKeySet(
        values: str[]): bool =
    var sorted: str[]
    if !csgAdmissionSortedUnique(values, sorted) ||
       sorted.len != values.len:
        return false
    for i in 0..<values.len:
        if values[i] != sorted[i]:
            return false
    return true

@borrows
fn csgAdmissionDescriptorEqual(
        left:
            merkle_manifest.CsgCoreMerkleShardDescriptor,
        right:
            merkle_manifest.CsgCoreMerkleShardDescriptor):
        bool =
    return left.shardKey == right.shardKey &&
        left.cid == right.cid &&
        left.root == right.root &&
        left.entryCount == right.entryCount

@borrows
fn csgAdmissionDescriptorTransitionError(
        previous:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        next:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        touchedKeys: str[]): str =
    if previous.len != next.len:
        return "merkle_incremental_shard_descriptor_count_changed"
    for i in 0..<previous.len:
        let nextAt =
            merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
                next, previous[i].shardKey)
        if nextAt < 0:
            return "merkle_incremental_shard_descriptor_removed"
        if !csgAdmissionContainsText(
               touchedKeys, previous[i].shardKey) &&
           !csgAdmissionDescriptorEqual(
               previous[i], next[nextAt]):
            return "merkle_incremental_untouched_shard_changed"
    for i in 0..<next.len:
        if merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
               previous, next[i].shardKey) < 0:
            return "merkle_incremental_shard_descriptor_injected"
    return ""

/* Sparse query manifests: a touched bucket may gain or lose its
   descriptor (the canonical empty shard owns no descriptor);
   untouched buckets must keep a bit-identical descriptor. */
@borrows
fn csgAdmissionQueryDescriptorTransitionError(
        previous:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        next:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        touchedKeys: str[]): str =
    for i in 0..<previous.len:
        let nextAt =
            merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
                next, previous[i].shardKey)
        if nextAt < 0:
            if !csgAdmissionContainsText(
                   touchedKeys, previous[i].shardKey):
                return "merkle_incremental_shard_descriptor_removed"
            continue
        if !csgAdmissionContainsText(
               touchedKeys, previous[i].shardKey) &&
           !csgAdmissionDescriptorEqual(
               previous[i], next[nextAt]):
            return "merkle_incremental_untouched_shard_changed"
    for i in 0..<next.len:
        if merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
               previous, next[i].shardKey) < 0 &&
           !csgAdmissionContainsText(
               touchedKeys, next[i].shardKey):
            return "merkle_incremental_shard_descriptor_injected"
    return ""

@borrows
fn csgAdmissionDependencyBoundToManifest(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        record:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        bool =
    var consumerFound: bool
    var providerFound: bool
    for i in 0..<manifest.partitions.len:
        if manifest.partitions[i].sourceId ==
           record.consumerSource:
            consumerFound = true
        if manifest.partitions[i].sourceId ==
               record.providerSource &&
           manifest.partitions[i].factsRoot ==
               record.providerSubgraphCid:
            providerFound = true
    return consumerFound && providerFound

@borrows
fn csgAdmissionDependenciesExact(
        left:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        right:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        bool =
    let sortedLeft = csgAdmissionSortDependencies(left)
    let sortedRight = csgAdmissionSortDependencies(right)
    if sortedLeft.len != sortedRight.len:
        return false
    for i in 0..<sortedLeft.len:
        if !csgAdmissionDependencyEqual(
               sortedLeft[i], sortedRight[i]):
            return false
    return true

@borrows
fn csgAdmissionQueriesExact(
        left:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        right:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]):
        bool =
    var sortedLeft: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    var sortedRight: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    csgAdmissionSortQueries(left, sortedLeft)
    csgAdmissionSortQueries(right, sortedRight)
    if sortedLeft.len != sortedRight.len:
        return false
    for i in 0..<sortedLeft.len:
        if !csgAdmissionQueryEqual(
               sortedLeft[i], sortedRight[i]):
            return false
    return true

@borrows
fn csgAdmissionMembershipRecordAt(
        records:
            merkle_artifacts.CsgCoreMerkleMembershipRecord[],
        factKey: str): int32 =
    for i in 0..<records.len:
        if records[i].factKey == factKey:
            return i
    return -1

@borrows
fn csgAdmissionOperationAt(
        keys: str[],
        factKey: str): int32 =
    for i in 0..<keys.len:
        if keys[i] == factKey:
            return i
    return -1

@borrows
fn csgAdmissionAppendCanonicalFacts(
        facts: str[],
        keys: var str[],
        values: var str[],
        error: var str): bool =
    for i in 0..<facts.len:
        var canonicalError: str
        let canonical =
            merkle_dag.CsgCoreMerkleCanonicalFact(
                facts[i], canonicalError)
        if canonicalError.len > 0 ||
           canonical != facts[i]:
            error =
                "merkle_incremental_fact_not_canonical"
            return false
        var keyError: str
        let key =
            merkle_dag.CsgCoreMerkleFactKey(
                canonical, keyError)
        if keyError.len > 0:
            error =
                "merkle_incremental_fact_key_invalid"
            return false
        if csgAdmissionOperationAt(keys, key) >= 0:
            error =
                "merkle_incremental_changed_fact_key_duplicate"
            return false
        add(keys, strings.CloneStr(key))
        add(values, strings.CloneStr(canonical))
    return true

@borrows
fn csgAdmissionCompilerClosureValidationError(
        next:
            merkle_manifest.CsgCoreMerkleManifest,
        facts: str[],
        changedPartitionCount: int32): str =
    if !csgAdmissionContainsText(
           next.profiles,
           "csg_dialect::cheng_compiler"):
        return ""
    if changedPartitionCount != next.partitions.len:
        return "merkle_incremental_compiler_closure_incomplete"
    let validation =
        validator.CsgCoreProductionAdmitFactLines(facts)
    if !validation.valid ||
       !validation.complete ||
       validation.factCount != next.factCount ||
       validation.standard != next.standard ||
       !validator.CsgCoreProfilesEqual(
           validation.profiles, next.profiles) ||
       validation.profileSetCid != next.profileSetCid ||
       validation.unsupportedCount != 0 ||
       validation.tombstoneCount != 0:
        if validation.errors.len > 0:
            return csgAdmissionCat(
                "merkle_incremental_compiler_validation ",
                validation.errors[0])
        return "merkle_incremental_compiler_validation_failed"
    return ""
