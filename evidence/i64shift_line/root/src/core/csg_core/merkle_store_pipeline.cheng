import std/rawbytes
import std/result
import std/strings
import std/fs
import std/hashmaps
import std/crypto/rand
import std/os
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_manifest_verifier
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_artifact_codec
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_identity

type
    CsgCoreMerkleStoreBootstrapResult =
        ok: bool
        published: bool
        reused: bool
        error: str
        storeRoot: str
        manifestCid: str
        head: merkle_store.CsgCoreMerkleHead
        objectWriteCount: int32
        objectReuseCount: int32

    csgStoreBootstrapObjectReadResult =
        ok: bool
        error: str
        bytes: rawbytes.Bytes

    csgStoreBootstrapObjectWriteResult =
        ok: bool
        error: str
        reused: bool

    csgStoreBootstrapCanonicalResult =
        ok: bool
        error: str
        bytes: rawbytes.Bytes

    csgStoreBootstrapGenesisResult =
        ok: bool
        error: str
        reused: bool
        head: merkle_store.CsgCoreMerkleHead

    csgStoreBootstrapArtifactIndex =
        rowsByIdentity: hashmaps.HashMapStrInt
        sourceKinds: int32[]
        sourceRows: int32[]
        consumed: int32[]

const
    csgStoreBootstrapArtifactPartition: int32 = 1
    csgStoreBootstrapArtifactMembership: int32 = 2
    csgStoreBootstrapArtifactNode: int32 = 3
    csgStoreBootstrapArtifactDependencyConsumer: int32 = 4
    csgStoreBootstrapArtifactDependencyProvider: int32 = 5
    csgStoreBootstrapArtifactSummary: int32 = 6
    csgStoreBootstrapArtifactQuery: int32 = 7

@borrows
fn csgStoreBootstrapFail(
        error: str): CsgCoreMerkleStoreBootstrapResult =
    var out: CsgCoreMerkleStoreBootstrapResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreBootstrapObjectReadFail(
        error: str): csgStoreBootstrapObjectReadResult =
    var out: csgStoreBootstrapObjectReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreBootstrapCanonicalFail(
        error: str): csgStoreBootstrapCanonicalResult =
    var out: csgStoreBootstrapCanonicalResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreBootstrapGenesisFail(
        error: str): csgStoreBootstrapGenesisResult =
    var out: csgStoreBootstrapGenesisResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreBootstrapLogicalFail(
        error: str):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var out: merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult
    out.error = strings.CloneStr(error)
    return out

fn csgStoreBootstrapNonce(
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    var bytes = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    if rawbytes.BytesLen(bytes) != layout.FixedBytes32Size ||
       !rand.RandomFill(bytes):
        rawbytes.BytesFree(bytes)
        return false
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return !layout.FixedBytes32Equal(
        out, layout.FixedBytes32())

fn csgStoreBootstrapCloseSession(
        session:
            var merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority) =
    if session.ownerId <= 0:
        return
    let closeError =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityClose(
            session)
    if closeError.len > 0:
        panic("merkle store bootstrap: session close failed")

@borrows
fn csgStoreBootstrapReadObject(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        artifactKind: int32,
        expectedCid: str): csgStoreBootstrapObjectReadResult =
    let category =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCategory(
            artifactKind)
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(expectedCid)
    if category.len == 0 || finalName.len == 0:
        return csgStoreBootstrapObjectReadFail(
            "merkle_store_bootstrap_object_identity_invalid")
    let opened =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityOpenObjectVerified(
            session,
            category,
            finalName)
    if result.IsErr(opened):
        return csgStoreBootstrapObjectReadFail(result.Error(opened))
    let handle = result.Value(opened)
    let objectFile =
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName()
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(objectFile)])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle store bootstrap: object shape close failed")
        return csgStoreBootstrapObjectReadFail(
            "merkle_store_bootstrap_object_shape_invalid")
    let read = os.AtomicTreeReadStable(handle, objectFile)
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle store bootstrap: object read close failed")
    if result.IsErr(read):
        return csgStoreBootstrapObjectReadFail(result.Error(read))
    var bytes = result.Value(read)
    var cidError: str
    let actualCid =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
            artifactKind,
            bytes,
            cidError)
    if cidError.len > 0 || actualCid != expectedCid:
        rawbytes.BytesFree(bytes)
        return csgStoreBootstrapObjectReadFail(
            "merkle_store_bootstrap_object_cid_mismatch")
    var out: csgStoreBootstrapObjectReadResult
    out.ok = true
    out.bytes = bytes
    return out

@borrows
fn csgStoreBootstrapConsumeBytes(
        objectKind: str,
        objectIndex: int32,
        expectedCid: str,
        bytes: rawbytes.Bytes,
        state: var
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedState,
        error: var str): bool =
    var nextKind: str
    var nextIndex: int32
    var nextCid: str
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedNextObjectIdentity(
           state,
           nextKind,
           nextIndex,
           nextCid) ||
       nextKind != objectKind || nextIndex != objectIndex ||
       nextCid != expectedCid:
        error = strings.ConcatStr(
            strings.ConcatStr(
                strings.ConcatStr(
                    "merkle_store_bootstrap_next ",
                    nextKind),
                strings.ConcatStr(
                    "#", strings.IntToStr(nextIndex))),
            strings.ConcatStr(
                strings.ConcatStr(" ", nextCid),
                strings.ConcatStr(" != ", expectedCid)))
        return false
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
           state,
           objectKind,
           objectIndex,
           expectedCid,
           bytes):
        error = strings.ConcatStr(
            strings.ConcatStr(
                strings.ConcatStr(
                    "merkle_store_bootstrap_object ",
                    objectKind),
                strings.ConcatStr(
                    "#", strings.IntToStr(objectIndex))),
            strings.ConcatStr(" ", state.error))
        return false
    error = ""
    return true

@borrows
fn csgStoreBootstrapConsumeStored(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        artifactKind: int32,
        objectKind: str,
        objectIndex: int32,
        expectedCid: str,
        state: var
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedState,
        error: var str): bool =
    var loaded = csgStoreBootstrapReadObject(
        session,
        artifactKind,
        expectedCid)
    if !loaded.ok:
        error = strings.CloneStr(loaded.error)
        return false
    let consumed = csgStoreBootstrapConsumeBytes(
        objectKind,
        objectIndex,
        expectedCid,
        loaded.bytes,
        state,
        error)
    rawbytes.BytesFree(loaded.bytes)
    return consumed

@borrows
fn csgStoreBootstrapCanonicalCsgc(
        closure: merkle_builder.CsgCoreMerkleBuilderResult):
        csgStoreBootstrapCanonicalResult =
    var facts: str[]
    for i in 0..<closure.partitions.len:
        var decoded =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                closure.partitions[i].bytes)
        if !decoded.ok || decoded.cid != closure.partitions[i].cid:
            rawbytes.BytesFree(decoded.bytes)
            return csgStoreBootstrapCanonicalFail(
                "merkle_store_bootstrap_partition_invalid")
        for factIndex in 0..<decoded.facts.len:
            add(facts, strings.CloneStr(decoded.facts[factIndex]))
        rawbytes.BytesFree(decoded.bytes)
    if facts.len != closure.manifest.factCount:
        return csgStoreBootstrapCanonicalFail(
            "merkle_store_bootstrap_fact_count_mismatch")
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(facts)
    if !encoded.ok || encoded.factCount != closure.manifest.factCount ||
       encoded.claimedDirectoryCid !=
           closure.manifest.csgcDirectoryCid ||
       rawbytes.BytesLen(encoded.bytes) !=
           closure.manifest.csgcByteCount ||
       merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
           encoded.bytes) != closure.manifest.csgcObjectCid:
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreBootstrapCanonicalFail(
            "merkle_store_bootstrap_canonical_csgc_mismatch")
    let bindingError =
        merkle_manifest.CsgCoreMerkleManifestCanonicalCsgcError(
            closure.manifest,
            encoded.bytes)
    if bindingError.len > 0:
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreBootstrapCanonicalFail(bindingError)
    var out: csgStoreBootstrapCanonicalResult
    out.ok = true
    out.bytes = encoded.bytes
    return out

@borrows
fn csgStoreBootstrapArtifactIdentityKey(
        objectKind: str,
        cid: str): str =
    return strings.ConcatStr(
        strings.ConcatStr(
            strings.ConcatStr(
                strings.IntToStr(objectKind.len), ":"),
            objectKind),
        cid)

@borrows
fn csgStoreBootstrapArtifactIndexAdd(
        index: var csgStoreBootstrapArtifactIndex,
        objectKind: str,
        cid: str,
        sourceKind: int32,
        sourceRow: int32,
        error: var str): bool =
    if objectKind.len == 0 ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(cid) ||
       sourceKind < csgStoreBootstrapArtifactPartition ||
       sourceKind > csgStoreBootstrapArtifactQuery ||
       sourceRow < 0 ||
       index.sourceKinds.len != index.sourceRows.len ||
       index.sourceKinds.len != index.consumed.len:
        error = "merkle_store_bootstrap_artifact_index_input_invalid"
        return false
    let key = csgStoreBootstrapArtifactIdentityKey(
        objectKind, cid)
    var found: bool
    let existing = hashmaps.HashMapStrIntGetMutEx(
        index.rowsByIdentity, key, found)
    if found:
        error = "merkle_store_bootstrap_artifact_identity_duplicate"
        return false
    let recordRow = index.sourceKinds.len
    hashmaps.HashMapStrIntPut(
        index.rowsByIdentity, key, recordRow)
    add(index.sourceKinds, sourceKind)
    add(index.sourceRows, sourceRow)
    add(index.consumed, 0)
    error = ""
    return true

@borrows
fn csgStoreBootstrapArtifactIndexBuild(
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        index: var csgStoreBootstrapArtifactIndex,
        error: var str): bool =
    let entryCount =
        Int64(closure.partitions.len) +
        Int64(closure.memberships.len) +
        Int64(closure.nodeSegments.len) +
        Int64(closure.dependencyCargo.consumerShards.len) +
        Int64(closure.dependencyCargo.providerShards.len) +
        Int64(closure.queryCargo.shards.len) +
        Int64(1)
    if entryCount <= Int64(0) ||
       entryCount > Int64(1048575):
        error = "merkle_store_bootstrap_artifact_count_invalid"
        return false
    let capacity =
        hashmaps.HashMapStrIntCapacityForEntryLimit(
            Int32(entryCount))
    hashmaps.HashMapStrIntInitInPlace(
        index.rowsByIdentity, capacity)
    for i in 0..<closure.partitions.len:
        if !csgStoreBootstrapArtifactIndexAdd(
               index,
               merkle_manifest_verifier.CsgCoreMerkleManifestPartitionFactsObjectKind(),
               closure.partitions[i].cid,
               csgStoreBootstrapArtifactPartition,
               i,
               error):
            return false
    for i in 0..<closure.memberships.len:
        if !csgStoreBootstrapArtifactIndexAdd(
               index,
               merkle_manifest_verifier.CsgCoreMerkleManifestMembershipObjectKind(),
               closure.memberships[i].cid,
               csgStoreBootstrapArtifactMembership,
               i,
               error):
            return false
    for i in 0..<closure.nodeSegments.len:
        if !closure.nodeSegments[i].ok ||
           closure.nodeSegments[i].nodeCount != 1 ||
           closure.nodeSegments[i].nodes.len != 1:
            error = "merkle_store_bootstrap_node_cardinality_invalid"
            return false
        let nodeCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                closure.nodeSegments[i].nodes[0])
        if !csgStoreBootstrapArtifactIndexAdd(
               index,
               merkle_manifest_verifier.CsgCoreMerkleManifestNodeObjectKind(),
               nodeCid,
               csgStoreBootstrapArtifactNode,
               i,
               error):
            return false
    for i in 0..<closure.dependencyCargo.consumerShards.len:
        if !csgStoreBootstrapArtifactIndexAdd(
               index,
               merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind(),
               closure.dependencyCargo.consumerShards[i].cid,
               csgStoreBootstrapArtifactDependencyConsumer,
               i,
               error):
            return false
    for i in 0..<closure.dependencyCargo.providerShards.len:
        if !csgStoreBootstrapArtifactIndexAdd(
               index,
               merkle_manifest_verifier.CsgCoreMerkleManifestDependencyProviderObjectKind(),
               closure.dependencyCargo.providerShards[i].cid,
               csgStoreBootstrapArtifactDependencyProvider,
               i,
               error):
            return false
    if !csgStoreBootstrapArtifactIndexAdd(
           index,
           merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind(),
           closure.summary.cid,
           csgStoreBootstrapArtifactSummary,
           0,
           error):
        return false
    for i in 0..<closure.queryCargo.shards.len:
        if !csgStoreBootstrapArtifactIndexAdd(
               index,
               merkle_manifest_verifier.CsgCoreMerkleManifestQueryShardObjectKind(),
               closure.queryCargo.shards[i].cid,
               csgStoreBootstrapArtifactQuery,
               i,
               error):
            return false
    if index.sourceKinds.len != Int32(entryCount):
        error = "merkle_store_bootstrap_artifact_index_count_mismatch"
        return false
    error = ""
    return true

@borrows
fn csgStoreBootstrapConsumeIndexedArtifact(
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        index: var csgStoreBootstrapArtifactIndex,
        state: var
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedState,
        error: var str): bool =
    var objectKind: str
    var objectIndex: int32
    var expectedCid: str
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedNextObjectIdentity(
           state,
           objectKind,
           objectIndex,
           expectedCid):
        error = "merkle_store_bootstrap_artifact_inventory_exhausted"
        return false
    let key = csgStoreBootstrapArtifactIdentityKey(
        objectKind, expectedCid)
    var found: bool
    let recordRow = hashmaps.HashMapStrIntGetMutEx(
        index.rowsByIdentity, key, found)
    if !found || recordRow < 0 ||
       recordRow >= index.sourceKinds.len ||
       recordRow >= index.sourceRows.len ||
       recordRow >= index.consumed.len ||
       index.consumed[recordRow] != 0:
        error = "merkle_store_bootstrap_artifact_identity_unavailable"
        return false
    let sourceKind = index.sourceKinds[recordRow]
    let sourceRow = index.sourceRows[recordRow]
    var consumed: bool
    if sourceKind == csgStoreBootstrapArtifactPartition &&
       sourceRow < closure.partitions.len:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.partitions[sourceRow].bytes,
            state,
            error)
    elif sourceKind == csgStoreBootstrapArtifactMembership &&
         sourceRow < closure.memberships.len:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.memberships[sourceRow].bytes,
            state,
            error)
    elif sourceKind == csgStoreBootstrapArtifactNode &&
         sourceRow < closure.nodeSegments.len:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.nodeSegments[sourceRow].bytes,
            state,
            error)
    elif sourceKind == csgStoreBootstrapArtifactDependencyConsumer &&
         sourceRow < closure.dependencyCargo.consumerShards.len:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.dependencyCargo.consumerShards[sourceRow].bytes,
            state,
            error)
    elif sourceKind == csgStoreBootstrapArtifactDependencyProvider &&
         sourceRow < closure.dependencyCargo.providerShards.len:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.dependencyCargo.providerShards[sourceRow].bytes,
            state,
            error)
    elif sourceKind == csgStoreBootstrapArtifactSummary &&
         sourceRow == 0:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.summary.bytes,
            state,
            error)
    elif sourceKind == csgStoreBootstrapArtifactQuery &&
         sourceRow < closure.queryCargo.shards.len:
        consumed = csgStoreBootstrapConsumeBytes(
            objectKind,
            objectIndex,
            expectedCid,
            closure.queryCargo.shards[sourceRow].bytes,
            state,
            error)
    else:
        error = "merkle_store_bootstrap_artifact_source_invalid"
        return false
    if !consumed:
        return false
    index.consumed[recordRow] = 1
    return true

@borrows
fn csgStoreBootstrapArtifactIndexComplete(
        index: csgStoreBootstrapArtifactIndex): bool =
    if index.sourceKinds.len != index.sourceRows.len ||
       index.sourceKinds.len != index.consumed.len:
        return false
    for i in 0..<index.consumed.len:
        if index.consumed[i] != 1:
            return false
    return true

@borrows
fn csgStoreBootstrapVerifyCandidate(
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        canonicalCsgcBytes: rawbytes.Bytes):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var index: csgStoreBootstrapArtifactIndex
    var error: str
    if !csgStoreBootstrapArtifactIndexBuild(
           closure, index, error):
        return csgStoreBootstrapLogicalFail(error)
    var state: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let begun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            closure.manifestArtifact.cid,
            closure.manifestArtifact.bytes,
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
            state)
    if !begun:
        return merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            state)
    if !csgStoreBootstrapConsumeBytes(
           merkle_manifest_verifier.CsgCoreMerkleManifestCanonicalCsgcObjectKind(),
           0,
           closure.manifest.csgcObjectCid,
           canonicalCsgcBytes,
           state,
           error):
        let released =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                state)
        return csgStoreBootstrapLogicalFail(error)
    for ignored in 0..<index.sourceKinds.len:
        if !csgStoreBootstrapConsumeIndexedArtifact(
               closure,
               index,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(error)
    if !csgStoreBootstrapArtifactIndexComplete(index):
        let released =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                state)
        return csgStoreBootstrapLogicalFail(
            "merkle_store_bootstrap_artifact_index_incomplete")
    return merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
        state)

@borrows
fn csgStoreBootstrapVerifyStored(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        manifestCid: str):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var manifestObject = csgStoreBootstrapReadObject(
        session,
        merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind(),
        manifestCid)
    if !manifestObject.ok:
        return csgStoreBootstrapLogicalFail(manifestObject.error)
    let decoded = merkle_manifest.CsgCoreMerkleManifestDecode(
        manifestObject.bytes)
    if !decoded.ok || decoded.cid != manifestCid:
        rawbytes.BytesFree(manifestObject.bytes)
        return csgStoreBootstrapLogicalFail(
            "merkle_store_bootstrap_manifest_identity_mismatch")
    let manifest = decoded.manifest
    var state: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let begun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            manifestCid,
            manifestObject.bytes,
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
            state)
    rawbytes.BytesFree(manifestObject.bytes)
    if !begun:
        return merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            state)
    var error: str
    if !csgStoreBootstrapConsumeStored(
           session,
           merkle_store_artifact_codec.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
           merkle_manifest_verifier.CsgCoreMerkleManifestCanonicalCsgcObjectKind(),
           0,
           manifest.csgcObjectCid,
           state,
           error):
        let released =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                state)
        return csgStoreBootstrapLogicalFail(error)
    for i in 0..<manifest.partitions.len:
        if !csgStoreBootstrapConsumeStored(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStorePartitionArtifactKind(),
               merkle_manifest_verifier.CsgCoreMerkleManifestPartitionFactsObjectKind(),
               i,
               manifest.partitions[i].factsCid,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(error)
    for i in 0..<manifest.partitions.len:
        if !csgStoreBootstrapConsumeStored(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreMembershipArtifactKind(),
               merkle_manifest_verifier.CsgCoreMerkleManifestMembershipObjectKind(),
               i,
               manifest.partitions[i].membershipCid,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(error)
    for i in 0..<manifest.nodeCount:
        var nextKind: str
        var nextIndex: int32
        var nextCid: str
        if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedNextObjectIdentity(
               state,
               nextKind,
               nextIndex,
               nextCid) ||
           nextKind !=
               merkle_manifest_verifier.CsgCoreMerkleManifestNodeObjectKind() ||
           nextIndex != i ||
           !csgStoreBootstrapConsumeStored(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreNodeArtifactKind(),
               nextKind,
               i,
               nextCid,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(
                error.len > 0 ?
                    error :
                    "merkle_store_bootstrap_node_identity_unavailable")
    for i in 0..<manifest.dependencyConsumerShards.len:
        if !csgStoreBootstrapConsumeStored(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind(),
               merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind(),
               i,
               manifest.dependencyConsumerShards[i].cid,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(error)
    for i in 0..<manifest.dependencyProviderShards.len:
        if !csgStoreBootstrapConsumeStored(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind(),
               merkle_manifest_verifier.CsgCoreMerkleManifestDependencyProviderObjectKind(),
               i,
               manifest.dependencyProviderShards[i].cid,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(error)
    if !csgStoreBootstrapConsumeStored(
           session,
           merkle_store_artifact_codec.CsgCoreMerkleStoreSummaryArtifactKind(),
           merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind(),
           0,
           manifest.summaryCid,
           state,
           error):
        let released =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                state)
        return csgStoreBootstrapLogicalFail(error)
    for i in 0..<manifest.queryShards.len:
        if !csgStoreBootstrapConsumeStored(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreIndexArtifactKind(),
               merkle_manifest_verifier.CsgCoreMerkleManifestQueryShardObjectKind(),
               i,
               manifest.queryShards[i].cid,
               state,
               error):
            let released =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
                    state)
            return csgStoreBootstrapLogicalFail(error)
    return merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
        state)

@borrows
fn csgStoreBootstrapObjectWriteFail(
        error: str): csgStoreBootstrapObjectWriteResult =
    var out: csgStoreBootstrapObjectWriteResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreBootstrapAbortObjectWrite(
        handle: os.AtomicTree,
        error: str): csgStoreBootstrapObjectWriteResult =
    let aborted = os.AtomicTreeAbort(handle)
    if result.IsErr(aborted):
        panic("merkle store bootstrap: object abort failed")
    return csgStoreBootstrapObjectWriteFail(error)

@borrows
fn csgStoreBootstrapVerifyObjectBytes(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        artifactKind: int32,
        objectCid: str,
        expectedBytes: rawbytes.Bytes): str =
    var stored = csgStoreBootstrapReadObject(
        session,
        artifactKind,
        objectCid)
    if !stored.ok:
        return strings.CloneStr(stored.error)
    let exact = rawbytes.BytesEqual(stored.bytes, expectedBytes)
    rawbytes.BytesFree(stored.bytes)
    if !exact:
        return "merkle_store_bootstrap_object_readback_mismatch"
    return ""

@borrows
fn csgStoreBootstrapWriteObject(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        artifactKind: int32,
        objectCid: str,
        bytes: rawbytes.Bytes): csgStoreBootstrapObjectWriteResult =
    let category =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCategory(
            artifactKind)
    let finalName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(objectCid)
    let byteLimit =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactByteLimit(
            artifactKind)
    var cidError: str
    let actualCid =
        merkle_store_artifact_codec.CsgCoreMerkleStoreArtifactCid(
            artifactKind,
            bytes,
            cidError)
    let stageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBinding(
            session)
    let lineageBinding =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
            session)
    if category.len == 0 || finalName.len == 0 ||
       byteLimit <= int64(0) ||
       rawbytes.BytesLen(bytes) <= 0 ||
       int64(rawbytes.BytesLen(bytes)) > byteLimit ||
       cidError.len > 0 || actualCid != objectCid ||
       layout.FixedBytes32Equal(
           stageBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           lineageBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(stageBinding, lineageBinding) ||
       !merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
           session):
        return csgStoreBootstrapObjectWriteFail(
            "merkle_store_bootstrap_object_candidate_invalid")
    var nonce: layout.FixedBytes32
    if !csgStoreBootstrapNonce(nonce) ||
       layout.FixedBytes32Equal(nonce, stageBinding) ||
       layout.FixedBytes32Equal(nonce, lineageBinding):
        return csgStoreBootstrapObjectWriteFail(
            "merkle_store_bootstrap_object_nonce_invalid")
    let stagingName = strings.ConcatStr(
        strings.ConcatStr(".bootstrap-object-", finalName),
        strings.ConcatStr("-", layout.FixedBytes32Hex(nonce)))
    let begun =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBeginObjectTransaction(
            session,
            category,
            stagingName,
            finalName)
    if result.IsErr(begun):
        return csgStoreBootstrapObjectWriteFail(result.Error(begun))
    let handle = result.Value(begun)
    let objectFile =
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName()
    let write = os.AtomicTreeWriteExclusiveLeaseSync(
        handle,
        objectFile,
        bytes)
    if result.IsErr(write):
        return csgStoreBootstrapAbortObjectWrite(
            handle, result.Error(write))
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(objectFile)])
    if result.IsErr(exact):
        return csgStoreBootstrapAbortObjectWrite(
            handle, result.Error(exact))
    let sealed = os.AtomicTreeSealReadOnly(handle, objectFile)
    if result.IsErr(sealed):
        return csgStoreBootstrapAbortObjectWrite(
            handle, result.Error(sealed))
    let committed = os.AtomicTreeCommitNoReplace(handle)
    if result.IsErr(committed):
        return csgStoreBootstrapAbortObjectWrite(
            handle, result.Error(committed))
    let commitKind = result.Value(committed)
    if commitKind == os.AtomicTreeDestinationExists:
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle store bootstrap: existing object abort failed")
        let verifyError = csgStoreBootstrapVerifyObjectBytes(
            session, artifactKind, objectCid, bytes)
        if verifyError.len > 0:
            return csgStoreBootstrapObjectWriteFail(verifyError)
        var reused: csgStoreBootstrapObjectWriteResult
        reused.ok = true
        reused.reused = true
        return reused
    if commitKind == os.AtomicTreeCommittedDurabilityUnknown:
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle store bootstrap: uncertain object close failed")
        panic("merkle store bootstrap: object durability unknown")
    if commitKind != os.AtomicTreeCommitted:
        panic("merkle store bootstrap: object commit kind invalid")
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle store bootstrap: committed object close failed")
    let verifyError = csgStoreBootstrapVerifyObjectBytes(
        session, artifactKind, objectCid, bytes)
    if verifyError.len > 0:
        panic("merkle store bootstrap: committed object readback failed")
    var out: csgStoreBootstrapObjectWriteResult
    out.ok = true
    return out

@borrows
fn csgStoreBootstrapPut(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        kind: int32,
        cid: str,
        bytes: rawbytes.Bytes,
        out: var CsgCoreMerkleStoreBootstrapResult): bool =
    let put = csgStoreBootstrapWriteObject(
        session,
        kind,
        cid,
        bytes)
    if !put.ok:
        out.error = strings.CloneStr(put.error)
        return false
    if put.reused:
        out.objectReuseCount = out.objectReuseCount + 1
    else:
        out.objectWriteCount = out.objectWriteCount + 1
    return true

@borrows
fn csgStoreBootstrapReadGenesis(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        expectedManifestCid: str,
        expectedBytes: rawbytes.Bytes): csgStoreBootstrapGenesisResult =
    let successorName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName("none")
    let opened =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityOpenObjectVerified(
            session,
            merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
            successorName)
    if result.IsErr(opened):
        return csgStoreBootstrapGenesisFail(result.Error(opened))
    let handle = result.Value(opened)
    let headFile =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName()
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(headFile)])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle store bootstrap: genesis shape close failed")
        return csgStoreBootstrapGenesisFail(
            "merkle_store_bootstrap_genesis_shape_invalid")
    let read = os.AtomicTreeReadStable(handle, headFile)
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle store bootstrap: genesis read close failed")
    if result.IsErr(read):
        return csgStoreBootstrapGenesisFail(result.Error(read))
    var bytes = result.Value(read)
    let decoded = merkle_store_codec.CsgCoreMerkleStoreHeadDecode(bytes)
    let exactBytes = rawbytes.BytesEqual(bytes, expectedBytes)
    rawbytes.BytesFree(bytes)
    if !decoded.ok || !exactBytes ||
       decoded.head.generation != int64(0) ||
       decoded.head.manifestCid != expectedManifestCid ||
       decoded.head.previousHeadCid != "none" ||
       decoded.head.receiptCid != "none":
        return csgStoreBootstrapGenesisFail(
            "merkle_store_bootstrap_genesis_mismatch")
    var out: csgStoreBootstrapGenesisResult
    out.ok = true
    out.reused = true
    out.head.generation = decoded.head.generation
    out.head.manifestCid = strings.CloneStr(decoded.head.manifestCid)
    out.head.previousHeadCid =
        strings.CloneStr(decoded.head.previousHeadCid)
    out.head.receiptCid = strings.CloneStr(decoded.head.receiptCid)
    out.head.headCid = strings.CloneStr(decoded.head.headCid)
    return out

@borrows
fn csgStoreBootstrapCommitGenesis(
        session:
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority,
        manifestCid: str,
        parentPath: str,
        storeName: str): csgStoreBootstrapGenesisResult =
    # Genesis is a publisher: the exclusive current-HEAD lease must be held
    # by the caller for this store before any successor byte is written.
    if !merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseExclusiveLiveForStore(
           parentPath, storeName):
        return csgStoreBootstrapGenesisFail(
            "HARD_RED:csg_store_head_publish_lease_required")
    var encoded =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            int64(0),
            manifestCid,
            "none",
            "none")
    if !encoded.ok:
        return csgStoreBootstrapGenesisFail(encoded.error)
    let existing =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthoritySuccessorExists(
            session,
            "none")
    if result.IsErr(existing):
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreBootstrapGenesisFail(result.Error(existing))
    if result.Value(existing):
        var reused = csgStoreBootstrapReadGenesis(
            session,
            manifestCid,
            encoded.bytes)
        rawbytes.BytesFree(encoded.bytes)
        return reused
    var nonce: layout.FixedBytes32
    if !csgStoreBootstrapNonce(nonce):
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreBootstrapGenesisFail(
            "merkle_store_bootstrap_genesis_nonce_unavailable")
    let successorName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName("none")
    let stagingName = strings.ConcatStr(
        ".bootstrap-head-",
        layout.FixedBytes32Hex(nonce))
    let begun =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityBeginObjectTransaction(
            session,
            merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
            stagingName,
            successorName)
    if result.IsErr(begun):
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreBootstrapGenesisFail(result.Error(begun))
    let handle = result.Value(begun)
    let headFile =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName()
    let write = os.AtomicTreeWriteExclusiveLeaseSync(
        handle,
        headFile,
        encoded.bytes)
    if result.IsErr(write):
        rawbytes.BytesFree(encoded.bytes)
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle store bootstrap: genesis write abort failed")
        return csgStoreBootstrapGenesisFail(result.Error(write))
    let exact = os.AtomicTreeVerifyExact(
        handle, [], [share(headFile)])
    if result.IsErr(exact):
        rawbytes.BytesFree(encoded.bytes)
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle store bootstrap: genesis shape abort failed")
        return csgStoreBootstrapGenesisFail(result.Error(exact))
    let sealed = os.AtomicTreeSealReadOnly(handle, headFile)
    if result.IsErr(sealed):
        rawbytes.BytesFree(encoded.bytes)
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle store bootstrap: genesis seal abort failed")
        return csgStoreBootstrapGenesisFail(result.Error(sealed))
    let committed = os.AtomicTreeCommitNoReplace(handle)
    if result.IsErr(committed):
        rawbytes.BytesFree(encoded.bytes)
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            panic("merkle store bootstrap: genesis commit abort failed")
        return csgStoreBootstrapGenesisFail(result.Error(committed))
    let commitKind = result.Value(committed)
    if commitKind == os.AtomicTreeDestinationExists:
        let aborted = os.AtomicTreeAbort(handle)
        if result.IsErr(aborted):
            rawbytes.BytesFree(encoded.bytes)
            panic("merkle store bootstrap: genesis existing abort failed")
    elif commitKind == os.AtomicTreeCommitted ||
         commitKind == os.AtomicTreeCommittedDurabilityUnknown:
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            rawbytes.BytesFree(encoded.bytes)
            panic("merkle store bootstrap: genesis committed close failed")
    else:
        rawbytes.BytesFree(encoded.bytes)
        panic("merkle store bootstrap: genesis commit kind invalid")
    var verified = csgStoreBootstrapReadGenesis(
        session,
        manifestCid,
        encoded.bytes)
    rawbytes.BytesFree(encoded.bytes)
    if !verified.ok:
        panic("merkle store bootstrap: genesis readback failed")
    if commitKind == os.AtomicTreeCommittedDurabilityUnknown:
        panic("merkle store bootstrap: genesis durability unknown")
    let tail =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthoritySuccessorExists(
            session,
            verified.head.headCid)
    if result.IsErr(tail) || result.Value(tail):
        panic("merkle store bootstrap: genesis tail drift")
    verified.reused = commitKind == os.AtomicTreeDestinationExists
    return verified

@borrows
fn csgCoreMerkleStoreBootstrap(
        parentPath: str,
        storeName: str,
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        requireAbsent: bool): CsgCoreMerkleStoreBootstrapResult =
    if !closure.ok || !closure.admission.ok ||
       !closure.dependencyCargo.ok || !closure.queryCargo.ok ||
       !closure.summary.ok || !closure.manifestArtifact.ok ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           closure.manifestArtifact.cid) ||
       closure.manifest.factsRoot != closure.factsRoot ||
       closure.manifest.dagRootCid != closure.dagRootCid ||
       closure.manifest.factCount != closure.factCount ||
       closure.partitions.len != closure.memberships.len:
        return csgStoreBootstrapFail(
            "merkle_store_bootstrap_closure_invalid")
    let storeRoot = os.JoinPath(parentPath, storeName)
    if requireAbsent && fs.Exists(storeRoot):
        return csgStoreBootstrapFail(
            "merkle_store_bootstrap_store_already_exists")
    var canonical = csgStoreBootstrapCanonicalCsgc(closure)
    if !canonical.ok:
        return csgStoreBootstrapFail(canonical.error)
    defer:
        rawbytes.BytesFree(canonical.bytes)
    let candidate = csgStoreBootstrapVerifyCandidate(
        closure,
        canonical.bytes)
    if !candidate.ok ||
       candidate.manifestCid != closure.manifestArtifact.cid ||
       candidate.factsRoot != closure.manifest.factsRoot ||
       candidate.objectCount <= 0 ||
       candidate.queryIndexCount != closure.manifest.queryIndexCount ||
       candidate.logicalClosureReceiptCid.len == 0:
        return csgStoreBootstrapFail(
            candidate.error.len > 0 ?
                candidate.error :
                "merkle_store_bootstrap_candidate_closure_invalid")
    var opened =
        merkle_store_identity.CsgCoreMerkleStoreAcquirePathAuthority(
            parentPath,
            storeName,
            merkle_store_identity.CsgCoreMerkleStoreInitializeIfAbsent)
    if !opened.ok:
        return csgStoreBootstrapFail(opened.error)
    if requireAbsent && opened.reused:
        var existingPath = opened.authority
        opened.authority =
            merkle_store_identity.CsgCoreMerkleStorePathAuthority()
        let closeError =
            merkle_store_identity.CsgCoreMerkleStorePathAuthorityClose(
                existingPath)
        if closeError.len > 0:
            panic("merkle store bootstrap: existing path close failed")
        return csgStoreBootstrapFail(
            "merkle_store_bootstrap_store_already_exists")
    var pathAuthority = opened.authority
    opened.authority =
        merkle_store_identity.CsgCoreMerkleStorePathAuthority()
    var planningMove =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityMoveToPlanning(
            pathAuthority)
    if !planningMove.ok:
        return csgStoreBootstrapFail(planningMove.error)
    var planning = planningMove.authority
    planningMove.authority =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority()
    var preparedMove =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityMoveToPrepared(
            planning)
    if !preparedMove.ok:
        return csgStoreBootstrapFail(preparedMove.error)
    var prepared = preparedMove.authority
    preparedMove.authority =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthority()
    var sessionMove =
        merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityMoveToSession(
            prepared)
    if !sessionMove.ok:
        return csgStoreBootstrapFail(sessionMove.error)
    var session = sessionMove.authority
    sessionMove.authority =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority()
    defer:
        csgStoreBootstrapCloseSession(session)
    # Publisher gate (domain C): genesis is a publisher.  Hold the exclusive
    # current-HEAD lease for the whole bootstrap; acquire failure is
    # HARD_RED, never a skipped check.  The store root exists here because
    # the path authority above initialized it when absent.
    var headLease: merkle_store.CsgCoreMerkleStoreCurrentHeadLease
    var headLeaseError: str
    if !merkle_store.CsgCoreMerkleStoreAcquireCurrentHeadExclusiveLease(
           parentPath, storeName, headLease, headLeaseError):
        return csgStoreBootstrapFail(headLeaseError)
    defer:
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(headLease)

    let genesisExists =
        merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthoritySuccessorExists(
            session,
            "none")
    if result.IsErr(genesisExists):
        return csgStoreBootstrapFail(result.Error(genesisExists))
    var expectedHead =
        merkle_store_codec.CsgCoreMerkleStoreHeadEncodeWithReceipt(
            int64(0),
            closure.manifestArtifact.cid,
            "none",
            "none")
    if !expectedHead.ok:
        return csgStoreBootstrapFail(expectedHead.error)
    if result.Value(genesisExists):
        var existing = csgStoreBootstrapReadGenesis(
            session,
            closure.manifestArtifact.cid,
            expectedHead.bytes)
        rawbytes.BytesFree(expectedHead.bytes)
        if !existing.ok:
            return csgStoreBootstrapFail(existing.error)
        let stored = csgStoreBootstrapVerifyStored(
            session,
            closure.manifestArtifact.cid)
        if !stored.ok ||
           stored.logicalClosureReceiptCid !=
               candidate.logicalClosureReceiptCid:
            return csgStoreBootstrapFail(
                stored.error.len > 0 ?
                    stored.error :
                    "merkle_store_bootstrap_reused_closure_mismatch")
        csgStoreBootstrapCloseSession(session)
        var reused: CsgCoreMerkleStoreBootstrapResult
        reused.ok = true
        reused.published = true
        reused.reused = true
        reused.storeRoot = os.JoinPath(parentPath, storeName)
        reused.manifestCid =
            strings.CloneStr(closure.manifestArtifact.cid)
        reused.head = existing.head
        return reused
    rawbytes.BytesFree(expectedHead.bytes)

    var out: CsgCoreMerkleStoreBootstrapResult
    out.storeRoot = os.JoinPath(parentPath, storeName)
    out.manifestCid = strings.CloneStr(closure.manifestArtifact.cid)
    if !csgStoreBootstrapPut(
           session,
           merkle_store_artifact_codec.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
           closure.manifest.csgcObjectCid,
           canonical.bytes,
           out):
        return out
    for i in 0..<closure.partitions.len:
        if !csgStoreBootstrapPut(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStorePartitionArtifactKind(),
               closure.partitions[i].cid,
               closure.partitions[i].bytes,
               out) ||
           !csgStoreBootstrapPut(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreMembershipArtifactKind(),
               closure.memberships[i].cid,
               closure.memberships[i].bytes,
               out):
            return out
    for i in 0..<closure.nodeSegments.len:
        let nodeCid = merkle_dag.CsgCoreMerkleNodeRecordCid(
            closure.nodeSegments[i].nodes[0])
        if !csgStoreBootstrapPut(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreNodeArtifactKind(),
               nodeCid,
               closure.nodeSegments[i].bytes,
               out):
            return out
    for i in 0..<closure.dependencyCargo.consumerShards.len:
        if !csgStoreBootstrapPut(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind(),
               closure.dependencyCargo.consumerShards[i].cid,
               closure.dependencyCargo.consumerShards[i].bytes,
               out):
            return out
    for i in 0..<closure.dependencyCargo.providerShards.len:
        if !csgStoreBootstrapPut(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreDependencyArtifactKind(),
               closure.dependencyCargo.providerShards[i].cid,
               closure.dependencyCargo.providerShards[i].bytes,
               out):
            return out
    if !csgStoreBootstrapPut(
           session,
           merkle_store_artifact_codec.CsgCoreMerkleStoreSummaryArtifactKind(),
           closure.summary.cid,
           closure.summary.bytes,
           out):
        return out
    for i in 0..<closure.queryCargo.shards.len:
        if !csgStoreBootstrapPut(
               session,
               merkle_store_artifact_codec.CsgCoreMerkleStoreIndexArtifactKind(),
               closure.queryCargo.shards[i].cid,
               closure.queryCargo.shards[i].bytes,
               out):
            return out
    if !csgStoreBootstrapPut(
           session,
           merkle_store_artifact_codec.CsgCoreMerkleStoreManifestArtifactKind(),
           closure.manifestArtifact.cid,
           closure.manifestArtifact.bytes,
           out):
        return out
    let stored = csgStoreBootstrapVerifyStored(
        session,
        closure.manifestArtifact.cid)
    if !stored.ok ||
       stored.logicalClosureReceiptCid !=
           candidate.logicalClosureReceiptCid:
        out.ok = false
        out.error =
            stored.error.len > 0 ?
                strings.CloneStr(stored.error) :
                "merkle_store_bootstrap_stored_closure_mismatch"
        return out
    let published = csgStoreBootstrapCommitGenesis(
        session,
        closure.manifestArtifact.cid,
        parentPath,
        storeName)
    if !published.ok:
        out.error = strings.CloneStr(published.error)
        return out
    if requireAbsent && published.reused:
        out.error =
            "merkle_store_bootstrap_head_publish_raced"
        return out
    csgStoreBootstrapCloseSession(session)
    out.head = published.head
    out.reused = published.reused
    out.published = true
    out.ok = true
    return out

@borrows
fn CsgCoreMerkleStoreBootstrap(
        parentPath: str,
        storeName: str,
        closure: merkle_builder.CsgCoreMerkleBuilderResult):
