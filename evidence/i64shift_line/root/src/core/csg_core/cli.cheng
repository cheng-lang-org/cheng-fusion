const
    CsgCliProductionEnvelope: str = "production-workload"
    CsgCliProductionAdmitCommand: str = "admit"
    CsgCliProductionOwnerDomain: str =
        "csg_core.production_workload.admit"
    CsgCliProductionReceiptFd: int32 = 3
    CsgCliProductionReceiptBufferBytes: int32 = 4096
    CsgCliProductionBackingLimit: uint64 = uint64(1073741824)
    CsgCliProductionErrorNone: int32 = 0
    CsgCliProductionErrorEnvelope: int32 = 10
    CsgCliProductionErrorOwnerBegin: int32 = 20
    CsgCliProductionErrorDispatch: int32 = 40
    CsgCliProductionErrorFactsIdentity: int32 = 41
    CsgCliProductionErrorShaCacheClose: int32 = 45
    CsgCliProductionErrorCloseLiveOwners: int32 = 50
    CsgCliProductionErrorClose: int32 = 51
    CsgCliProductionErrorCloseReceipt: int32 = 52
    CsgCliProductionErrorReceiptWrite: int32 = 60

type
    CsgCliLinesResult =
        ok: bool
        lines: str[]
        error: str

    CsgCliCanonicalResult =
        ok: bool
        lines: str[]
        error: str

    CsgCliFactIdentitiesArgs =
        ok: bool
        inputPath: str
        outPath: str
        error: str

    CsgCliAuthorizedDecodeArgs =
        ok: bool
        manifestPath: str
        outPath: str
        kinds: str[]
        error: str

    CsgCliRelfactsFacts =
        ok: bool
        error: str
        canonicalLines: str[]
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaNamespace: str
        schemaCid: str
        factsRoot: str
        factCount: int32

    CsgCliCidPod =
        word0: uint64
        word1: uint64
        word2: uint64
        word3: uint64

    CsgCliProductionFactsIdentityPod =
        present: bool
        factsRoot: CsgCliCidPod
        profileSetCid: CsgCliCidPod
        factCount: int32
        complete: bool

    CsgCliProductionDispatchPod =
        exitCode: int32
        errorCode: int32
        facts: CsgCliProductionFactsIdentityPod

    CsgCliProductionOwnerPod =
        ok: bool
        handle: uint64
        generation: uint64
        errorCode: int32

    CsgCliProductionExecutionPod =
        commandExitCode: int32
        errorCode: int32
        ownerActivated: bool
        ownerGeneration: uint64
        shaCacheCloseAttempted: bool
        shaCacheClosed: bool
        facts: CsgCliProductionFactsIdentityPod
        allocationReceiptPresent: bool
        allocationComplete: bool
        allocationClosed: bool
        allocationOwnerGeneration: uint64
        allocationBackingLimit: uint64
        allocationControlPlaneBackingBytes: uint64
        allocationLiveBackingBytes: uint64
        allocationPeakBackingBytes: uint64
        allocationLiveMappedVirtualBytes: uint64
        allocationPeakMappedVirtualBytes: uint64
        allocationLiveAllocationCount: uint64
        allocationPeakAllocationCount: uint64
        allocationLiveMappingCount: uint64
        allocationEventIndex: uint64
        allocatorLayoutCid: CsgCliCidPod
        ownerDomainCid: CsgCliCidPod
        eventChainCid: CsgCliCidPod
        allocationReceiptCid: CsgCliCidPod

type
    csgCliProcessEntrySession =
        ownerIssued: bool
        closeAttempted: bool
        closed: bool
        owner: system.RuntimeAllocationLedgerSessionCapability

@importc("cheng_host_openat")
fn csgCliOpenAtBridge(
        dirFd: int32,
        path: cstring,
        flags: int32,
        mode: int32): int32

@importc("close")
fn csgCliCloseBridge(fd: int32): int32

@importc("cheng_host_write_runtime")
fn csgCliWriteBridge(
        fd: int32, data: ptr, count: int32): int64

@importc("cheng_errno")
fn csgCliErrnoBridge(): int32

@borrows
fn csgCliCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgCliCat3(a: str, b: str, c: str): str =
    return csgCliCat(csgCliCat(a, b), c)

@borrows
fn csgCliCat4(a: str, b: str, c: str, d: str): str =
    return csgCliCat(csgCliCat3(a, b, c), d)

@borrows
fn csgCliOwnedBytesFromText(text: str): rawbytes.Bytes =
    var raw = rawbytes.BytesAlloc(text.len)
    if rawbytes.BytesLen(raw) != text.len:
        return raw
    for i in 0..<text.len:
        rawbytes.BytesSet(raw, i, int32(text[i]) & 255)
    return raw

@borrows
fn csgCliAtomicWriteText(path: str, text: str): bool =
    var bytes = csgCliOwnedBytesFromText(text)
    let ok = linker_core.LinkerCoreWriteRawBytesAtomic(path, bytes)
    rawbytes.BytesFree(bytes)
    return ok

@borrows
fn csgCliAtomicWriteBytes(path: str, bytes: var rawbytes.Bytes): bool =
    return linker_core.LinkerCoreWriteRawBytesAtomic(path, bytes)

@borrows
fn csgCliStdout(text: str) =
    os.WriteLine(os.Get_stdout(), text)

@borrows
fn csgCliStderr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn csgCliBool01(value: bool): str =
    if value:
        return "1"
    return "0"

fn csgCliUsage(): int32 =
    csgCliStderr("usage: csg validate|merged-scan|admit|root|fact-identities|diff|index|index-query|pack|unpack|decode-kinds-authorized|edit|prove|verify-proof|replay|relfacts [--mode strict|sandbox] <facts>")
    csgCliStderr("       csg production-workload admit [--mode strict] <facts>")
    csgCliStderr("       csg validate|fact-identities|merged-scan --mode sandbox --canonical-input <caller-proven canonical JSONL>")
    csgCliStderr("       csg fact-identities --out identities.txt --mode strict facts.debug.jsonl")
    csgCliStderr("       csg pack --out out.csgc facts.debug.jsonl")
    csgCliStderr("       csg unpack --out facts.debug.jsonl facts.csgc")
    csgCliStderr("       csg decode-kinds-authorized --manifest current-head.manifest.csgc --out selected.jsonl --kind exact-kind [--kind exact-kind ...]")
    csgCliStderr("       csg index --out facts.idx.json facts.csgc")
    csgCliStderr("       csg index-query --store-parent /absolute/path --store-name store --kind fact_key|kind|symbol|name|file|caller --term exact-term")
    csgCliStderr("       csg edit append|replace|delete --out out.csgc [--receipt-out receipt.json] [--id id] [--fact json] facts.csgc")
    csgCliStderr("       csg prove --key fact-key --out proof.csgc facts.csgc")
    csgCliStderr("       csg verify-proof --facts-root sha256:... [--fact canonical-json] proof.csgc")
    csgCliStderr("       csg replay is disabled; use csg relfacts replay with admitted before/after CSGC")
    csgCliStderr("       csg relfacts encode --before previous.csgc --after current.csgc --out changes.relfacts")
    csgCliStderr("       csg relfacts replay --before previous.csgc --sidecar changes.relfacts --after current.csgc")
    csgCliStderr("       csg store-bootstrap facts.jsonl")
    return 2

@borrows
fn csgCliReadLines(path: str): CsgCliLinesResult =
    var out: CsgCliLinesResult
    if csgc.CsgCoreCsgcPathLooksBinary(path):
        var bytesResult: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
        if !bytesResult.ok:
            out.error = csgCliCat("read failed: ", path)
            return out
        let decoded = csgc.CsgCoreCsgcDecodeLines(rawbytes.BytesTake(bytesResult.value))
        if !decoded.ok:
            out.error = decoded.error
            return out
        out.ok = true
        out.lines = decoded.lines
        return out
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        out.error = csgCliCat("read failed: ", path)
        return out
    out.ok = true
    out.lines = jsonl.CsgCoreJsonlSplitLines(result.Value(readResult))
    return out

@borrows
fn csgCliDecodeProductionCsgcBytes(
        bytes: rawbytes.Bytes): csgc.CsgCoreCsgcLinesResult =
    let policy =
        csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    let trustAnchor =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorReadCurrentHead(
                policy)
    let trustAnchorError =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorError(
            trustAnchor)
    if trustAnchorError.len > 0:
        var failed: csgc.CsgCoreCsgcLinesResult
        failed.error = strings.CloneStr(trustAnchorError)
        return failed
    return csgc_authority.CsgCoreCsgcDecodeCurrentHeadAuthorized(
            trustAnchor, bytes)

@borrows
fn csgCliReadAuthorizedProductionCsgcLines(
        path: str): CsgCliLinesResult =
    var out: CsgCliLinesResult
    if !csgc.CsgCoreCsgcPathLooksBinary(path):
        out.error = "production_admission_csgc_required"
        return out
    var stableRead = chengpath.PathStableReadBytes(path)
    if !stableRead.ok:
        out.error = csgCliCat(
            "production_admission_read_failed:",
            stableRead.error)
        return out
    let decoded =
        csgCliDecodeProductionCsgcBytes(
            stableRead.bytes)
    rawbytes.BytesFree(stableRead.bytes)
    if !decoded.ok:
        out.error = csgCliCat(
            "production_admission_csgc_authority_failed:",
            decoded.error)
        return out
    out.ok = true
    out.lines = decoded.lines
    return out

@borrows
fn csgCliReadCanonicalPackSourceLines(
        path: str): CsgCliLinesResult =
    var out: CsgCliLinesResult
    if csgc.CsgCoreCsgcPathLooksBinary(path):
        out.error = "pack_source_jsonl_required"
        return out
    var stableRead = chengpath.PathStableReadBytes(path)
    if !stableRead.ok:
        out.error = csgCliCat(
            "pack_source_read_failed:",
            stableRead.error)
        return out
    let text = rawbytes.BytesToString(stableRead.bytes)
    rawbytes.BytesFree(stableRead.bytes)
    if text.len == 0 || text[text.len - 1] != '\n':
        out.error = "pack_source_jsonl_final_lf_required"
        return out
    for byteIndex in 0..<text.len:
        if text[byteIndex] == '\r':
            out.error = "pack_source_jsonl_cr_forbidden"
            return out
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    if lines.len == 0:
        out.error = "pack_source_empty_fact_set"
        return out
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            out.error = "pack_source_jsonl_empty_record"
            return out
        let canonicalLine =
            canonical.CsgCoreJsonCanonicalize(
                lines[lineIndex])
        if !canonicalLine.ok:
            out.error = csgCliCat4(
                "pack_source_line_",
                strings.IntToStr(lineIndex + 1),
                "_invalid:",
                canonicalLine.error)
            return out
        if canonicalLine.value != lines[lineIndex]:
            out.error = csgCliCat3(
                "pack_source_line_",
                strings.IntToStr(lineIndex + 1),
                "_non_canonical")
            return out
        add(out.lines, strings.CloneStr(lines[lineIndex]))
    out.ok = true
    return out

@borrows
fn csgCliCanonicalizeLines(lines: str[]): CsgCliCanonicalResult =
    var out: CsgCliCanonicalResult
    for i in 0..<lines.len:
        if lines[i].len > 0:
            let canon = canonical.CsgCoreJsonCanonicalize(lines[i])
            if !canon.ok:
                out.error = csgCliCat4("line ", strings.IntToStr(i + 1), ": ", canon.error)
                return out
            add(out.lines, strings.CloneStr(canon.value))
    out.ok = true
    return out

@borrows
fn csgCliValidateLines(lines: str[], mode: str, validation: var csg.CsgCoreValidationResult, canonicalLines: var str[]): bool =
    validation = csg.CsgCoreValidateFactLines(lines, mode)
    let canonicalResult = csgCliCanonicalizeLines(lines)
    if !canonicalResult.ok:
        validation.valid = false
        validation.complete = false
        validation.errorCount = validation.errorCount + 1
        add(
            validation.errors,
            strings.CloneStr(canonicalResult.error))
        return false
    canonicalLines = canonicalResult.lines
    return validation.valid

@borrows
fn csgCliPrintValidation(validation: csg.CsgCoreValidationResult) =
    csgCliStdout(csgCliCat("valid=", csgCliBool01(validation.valid)))
    csgCliStdout(csgCliCat("mode=", validation.mode))
    csgCliStdout(csgCliCat("standard=", validation.standard))
    csgCliStdout(csgCliCat("schema=", validation.schema))
    csgCliStdout(
        csgCliCat(
            "schema_namespace=",
            validation.schemaNamespace))
    csgCliStdout(
        csgCliCat(
            "profiles=",
            csg.CsgCoreProfilesJson(validation.profiles)))
    csgCliStdout(
        csgCliCat(
            "profile_count=",
            strings.IntToStr(validation.profiles.len)))
    for i in 0..<validation.profiles.len:
        csgCliStdout(
            csgCliCat(
                csgCliCat3(
                    "profile_", strings.IntToStr(i), "="),
                validation.profiles[i]))
    csgCliStdout(
        csgCliCat(
            "profile_set_cid=",
            validation.profileSetCid))
    csgCliStdout(csgCliCat("fact_count=", strings.IntToStr(validation.factCount)))
    if validation.factsRoot.len > 0:
        csgCliStdout(csgCliCat("facts_root=", validation.factsRoot))
    csgCliStdout(csgCliCat("complete=", csgCliBool01(validation.complete)))
    csgCliStdout(csgCliCat("unsupported_count=", strings.IntToStr(validation.unsupportedCount)))
    csgCliStdout(csgCliCat("tombstone_count=", strings.IntToStr(validation.tombstoneCount)))
    csgCliStdout(
        csgCliCat(
            "runtime_requirement_count=",
            strings.IntToStr(
                validation.runtimeRequirementCount)))
    csgCliStdout(
        csgCliCat(
            "runtime_requirements_status=",
            validation.runtimeRequirementsStatus))

@borrows
fn csgCliPrintErrors(validation: csg.CsgCoreValidationResult) =
    for i in 0..<validation.errors.len:
        csgCliStderr(csgCliCat("error: ", validation.errors[i]))

@borrows
fn csgCliIsInlineModeFlag(arg: str): bool =
    return strings.HasPrefix(arg, "--mode:") || strings.HasPrefix(arg, "--mode=")

@borrows
fn csgCliIsInlineEditFlag(arg: str): bool =
    return strings.HasPrefix(arg, "--out:") || strings.HasPrefix(arg, "--out=") ||
        strings.HasPrefix(arg, "--receipt-out:") || strings.HasPrefix(arg, "--receipt-out=") ||
        strings.HasPrefix(arg, "--fact:") || strings.HasPrefix(arg, "--fact=") ||
        strings.HasPrefix(arg, "--id:") || strings.HasPrefix(arg, "--id=") ||
        strings.HasPrefix(arg, "--key:") || strings.HasPrefix(arg, "--key=") ||
        strings.HasPrefix(arg, "--kind:") || strings.HasPrefix(arg, "--kind=") ||
        strings.HasPrefix(arg, "--facts-root:") ||
        strings.HasPrefix(arg, "--facts-root=") ||
        csgCliIsInlineModeFlag(arg)

@borrows
fn csgCliFlagTakesValue(arg: str): bool =
    return arg == "--mode" || arg == "--out" ||
        arg == "--receipt-out" || arg == "--fact" ||
        arg == "--id" || arg == "--key" ||
        arg == "--kind" ||
        arg == "--facts-root"

fn csgCliPositionalArgFrom(
        firstParam: int32, index: int32): str =
    var seen: int32
    var i = firstParam
    let count = cmdline.ParamCount()
    while i <= count:
        let arg = cmdline.ParamStr(i)
        if arg == "--mode":
            i = i + 2
        elif arg == "--canonical-input":
            i = i + 1
        elif csgCliIsInlineModeFlag(arg):
            i = i + 1
        else:
            seen = seen + 1
            if seen == index:
                return arg
            i = i + 1
    return ""

fn csgCliPositionalArg(index: int32): str =
    return csgCliPositionalArgFrom(2, index)

fn csgCliCidHexNibble(value: int32): int32 =
    if value >= int32('0') && value <= int32('9'):
        return value - int32('0')
    if value >= int32('a') && value <= int32('f'):
        return value - int32('a') + 10
    return -1

fn csgCliCidPodSetWord(
        out: var CsgCliCidPod,
        index: int32,
        value: uint64): bool =
    if index == 0:
        out.word0 = value
        return true
    if index == 1:
        out.word1 = value
        return true
    if index == 2:
        out.word2 = value
        return true
    if index == 3:
        out.word3 = value
        return true
    return false

@borrows
fn csgCliCidPodFromText(
        value: str,
        out: var CsgCliCidPod): bool =
    if value.len != 71 ||
       value[0] != 's' || value[1] != 'h' ||
       value[2] != 'a' || value[3] != '2' ||
       value[4] != '5' || value[5] != '6' ||
       value[6] != ':':
        return false
    for wordIndex in 0..<4:
        var word: uint64
        for nibbleIndex in 0..<16:
            let nibble = csgCliCidHexNibble(
                int32(value[7 + wordIndex * 16 + nibbleIndex]))
            if nibble < 0:
                return false
            word = (word << uint64(4)) | uint64(nibble)
        if !csgCliCidPodSetWord(out, wordIndex, word):
            return false
    return true

@borrows
fn csgCliCidPodNonZero(value: CsgCliCidPod): bool =
    return value.word0 != uint64(0) ||
        value.word1 != uint64(0) ||
        value.word2 != uint64(0) ||
        value.word3 != uint64(0)

@borrows
fn csgCliReadCanonicalJsonlLines(path: str): CsgCliLinesResult =
    # Canonical-JSONL contract read: stable bytes, final LF required, CR
    # forbidden, then line split. No per-line canonicalization here; the
    # caller owns the canonical-input proof (same verified-input boundary as
    # the csgc EncodeVerifiedLines precedent).
    var out: CsgCliLinesResult
    var stableRead = chengpath.PathStableReadBytes(path)
    if !stableRead.ok:
        out.error = csgCliCat("read failed: ", path)
        return out
    let text = rawbytes.BytesToString(stableRead.bytes)
    rawbytes.BytesFree(stableRead.bytes)
    if text.len == 0 || text[text.len - 1] != '\n':
        out.error = "noncanonical JSONL framing"
        return out
    for byteIndex in 0..<text.len:
        if text[byteIndex] == '\r':
            out.error = "noncanonical JSONL CR"
            return out
    out.ok = true
    out.lines = jsonl.CsgCoreJsonlSplitLines(text)
    return out

@borrows
fn csgCliRunValidateCanonical(mode: str, path: str): int32 =
    # Caller-proven canonical input contract (ts-csg sandbox extract bridge):
    # skip the per-line re-canonicalization. Field-scan admission and the
    # bound facts root stay byte-identical to the plain validate on the same
    # canonical lines.
    if mode != csg.CsgCoreModeSandbox:
        csgCliStderr(
            "error: validate --canonical-input requires --mode sandbox")
        return 2
    if csgc.CsgCoreCsgcPathLooksBinary(path):
        csgCliStderr(
            "error: validate --canonical-input requires canonical JSONL")
        return 1
    let readResult = csgCliReadCanonicalJsonlLines(path)
    if !readResult.ok:
        csgCliStderr(
            csgCliCat("error: ", readResult.error))
        return 1
    let validation =
        csg.CsgCoreValidateCanonicalFactLines(
            readResult.lines, mode)
    csgCliPrintValidation(validation)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    return 0

@borrows
fn csgCliRunFactIdentitiesCanonicalRows(path: str): int32 =
    # Caller-proven canonical input contract (ts-csg sandbox extract bridge):
    # per-line fact_hash plus a content-only unbound subgraph_cid on stdout,
    # without re-canonicalizing each line. Rows are byte-identical to the
    # plain sandbox fact-identities on the same canonical lines.
    if csgc.CsgCoreCsgcPathLooksBinary(path):
        csgCliStderr(
            "error: fact-identities --canonical-input requires canonical JSONL")
        return 1
    let readResult = csgCliReadCanonicalJsonlLines(path)
    if !readResult.ok:
        csgCliStderr(
            csgCliCat("error: ", readResult.error))
        return 1
    if readResult.lines.len == 0:
        csgCliStderr(
            "error: fact-identities empty fact set")
        return 1
    for lineIndex in 0..<readResult.lines.len:
        let factHash =
            merkle_dag.csgMerkleFactHashCanonical(
                readResult.lines[lineIndex])
        var oneFact: str[]
        add(
            oneFact,
            strings.CloneStr(
                readResult.lines[lineIndex]))
        let oneDag = merkle_dag.CsgCoreMerkleBuildFromCanonicalLines(oneFact)
        if !oneDag.ok || oneDag.factCount != 1 ||
           oneDag.subgraphCid.len != 71 ||
           !strings.HasPrefix(oneDag.subgraphCid, "sha256:"):
            csgCliStderr(
                csgCliCat3(
                    "error: fact-identities bound subgraph failed at line ",
                    strings.IntToStr(lineIndex + 1),
                    csgCliCat(": ", oneDag.error)))
            return 1
        csgCliStdout(
            csgCliCat4(
                "fact_hash=sha256:",
                layout.FixedBytes32Hex(factHash),
                "\tsubgraph_cid=",
                oneDag.subgraphCid))
    return 0

@borrows
fn csgCliRunValidate(mode: str): int32 =
    let path = csgCliPositionalArg(1)
    if path.len == 0:
        return csgCliUsage()
    if cmdline.HasFlag("--canonical-input"):
        return csgCliRunValidateCanonical(mode, path)
    let readResult = csgCliReadLines(path)
    if !readResult.ok:
        csgCliStderr(csgCliCat("error: ", readResult.error))
        return 1
    let validation =
        csg.CsgCoreValidateFactLines(
            readResult.lines, mode)
    csgCliPrintValidation(validation)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    return 0

@borrows
fn csgCliRunMergedScan(mode: str): int32 =
    # Single-pass merged scan (ts-csg one-click extract bridge): one stable
    # read and one JSONL split feed both the sandbox validation and the
    # per-fact identity rows. The validation's internal bound DAG build
    # already derives every line's fact hash and key hash, so the identity
    # rows are emitted straight from that DAG instead of re-scanning each
    # line. stdout carries the exact `validate --canonical-input` field
    # block followed by the exact `fact-identities --canonical-input` rows;
    # both are byte-identical to the standalone subcommands on the same
    # caller-proven canonical input.
    if mode != csg.CsgCoreModeSandbox:
        csgCliStderr(
            "error: merged-scan requires --mode sandbox")
        return 2
    if !cmdline.HasFlag("--canonical-input"):
        csgCliStderr(
            "error: merged-scan requires --canonical-input")
        return 2
    let path = csgCliPositionalArg(1)
    if path.len == 0:
        return csgCliUsage()
    if csgc.CsgCoreCsgcPathLooksBinary(path):
        csgCliStderr(
            "error: merged-scan requires canonical JSONL")
        return 1
    let readResult = csgCliReadCanonicalJsonlLines(path)
    if !readResult.ok:
        csgCliStderr(
            csgCliCat("error: ", readResult.error))
        return 1
    var dag: merkle_dag.CsgCoreMerkleDag
    let validation =
        csg.csgCoreValidateFactLinesInto(
            readResult.lines, mode, dag, false, true)
    csgCliPrintValidation(validation)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    if !dag.ok || dag.factCount != readResult.lines.len ||
       dag.entryFactHashes.len != readResult.lines.len ||
       dag.entryKeyHashes.len != readResult.lines.len:
        csgCliStderr(
            "error: merged-scan identity dag incomplete")
        return 1
    for lineIndex in 0..<readResult.lines.len:
        let leafHash =
            merkle_dag.csgMerkleLeafHash(
                dag.entryKeyHashes[lineIndex],
                dag.entryFactHashes[lineIndex])
        csgCliStdout(
            csgCliCat4(
                "fact_hash=sha256:",
                layout.FixedBytes32Hex(
                    dag.entryFactHashes[lineIndex]),
                "\tsubgraph_cid=",
                merkle_dag.csgMerkleSubgraphText(1, leafHash)))
    return 0

@borrows
fn csgCliRunAdmitPathInto(
        mode: str,
        path: str,
        factsIdentity: var CsgCliProductionFactsIdentityPod): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: production admission requires strict mode")
        return 2
    if path.len == 0:
        return csgCliUsage()
    let readResult = csgCliReadAuthorizedProductionCsgcLines(path)
    if !readResult.ok:
        csgCliStderr(
            csgCliCat("error: ", readResult.error))
        return 1
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            readResult.lines)
    csgCliPrintValidation(validation)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    if validation.standard != csg.CsgCoreStandardIdentity() ||
       validation.schemaNamespace != csg.CsgCoreSchemaNamespaceIdentity() ||
       validation.factCount <= 0 ||
       !validation.complete ||
       !csgCliCidPodFromText(
           validation.factsRoot, factsIdentity.factsRoot) ||
       !csgCliCidPodFromText(
           validation.profileSetCid, factsIdentity.profileSetCid):
        csgCliStderr(
            "error: production facts identity is incomplete")
        return 1
    factsIdentity.factCount = validation.factCount
    factsIdentity.complete = validation.complete
    factsIdentity.present = true
    return 0

@borrows
fn csgCliRunAdmitInto(
        mode: str,
        factsIdentity: var CsgCliProductionFactsIdentityPod): int32 =
    return csgCliRunAdmitPathInto(
        mode, csgCliPositionalArg(1), factsIdentity)

@borrows
fn csgCliRunAdmit(mode: str): int32 =
    var factsIdentity: CsgCliProductionFactsIdentityPod
    return csgCliRunAdmitInto(mode, factsIdentity)

@borrows
fn csgCliRunRoot(mode: str): int32 =
    let path = csgCliPositionalArg(1)
    if path.len == 0:
        return csgCliUsage()
    var readResult: CsgCliLinesResult
    if mode == csg.CsgCoreModeStrict:
        readResult = csgCliReadAuthorizedProductionCsgcLines(path)
    else:
        readResult = csgCliReadLines(path)
    if !readResult.ok:
        csgCliStderr(csgCliCat("error: ", readResult.error))
        return 1
    var validation: csg.CsgCoreValidationResult
    if mode == csg.CsgCoreModeStrict:
        validation =
            csg.CsgCoreProductionAdmitFactLines(
                readResult.lines)
    else:
        validation =
            csg.CsgCoreValidateFactLines(
                readResult.lines, mode)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    csgCliStdout(validation.factsRoot)
    return 0

@borrows
fn csgCliStoreBootstrapSourceCid(text: str): str =
    var bytes = rawbytes.BytesAlloc(text.len)
    for i in 0..<text.len:
        rawbytes.BytesSet(bytes, i, int32(text[i]) & 255)
    let out =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.external.source", bytes)
    rawbytes.BytesFree(bytes)
    return out

fn csgCliRunStoreBootstrap(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr("error: store-bootstrap requires --mode strict")
        return 2
    let path = csgCliPositionalArg(1)
    if path.len == 0:
        return csgCliUsage()
    let readResult = csgCliReadCanonicalPackSourceLines(path)
    if !readResult.ok:
        csgCliStderr(csgCliCat("error: ", readResult.error))
        return 1
    let validation =
        csg.CsgCoreProductionAdmitFactLines(readResult.lines)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    let text = data_edit.CsgDataEditLinesText(readResult.lines)
    var source: merkle_builder.CsgCoreMerkleBuilderSource
    source.sourceId = strings.CloneStr(
        "source:csg-cli-store-bootstrap")
    source.sourceCid = csgCliStoreBootstrapSourceCid(text)
    for i in 0..<readResult.lines.len:
        add(source.facts, strings.CloneStr(readResult.lines[i]))
    var closure = merkle_builder.CsgCoreMerkleBuildClosure(
        validation.standard, validation.profiles, [source], [])
    defer:
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
    if !closure.ok:
        csgCliStderr(csgCliCat("error: ", closure.error))
        return 1
    if closure.factsRoot != validation.factsRoot ||
       closure.factCount != validation.factCount:
        csgCliStderr(
            "error: store_bootstrap_closure_identity_mismatch")
        return 1
    let policy = csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    if !policy.admitted:
        csgCliStderr(csgCliCat("error: ", policy.error))
        return 1
    let bootstrap =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            policy.parentPath, policy.storeName, closure)
    if !bootstrap.ok || !bootstrap.published || bootstrap.reused ||
       bootstrap.head.generation != int64(0) ||
       bootstrap.head.previousHeadCid != "none" ||
       bootstrap.head.manifestCid != closure.manifestArtifact.cid:
        if bootstrap.error.len > 0:
            csgCliStderr(csgCliCat("error: ", bootstrap.error))
        else:
            csgCliStderr("error: store_bootstrap_genesis_rejected")
        return 1
    csgCliStdout(csgCliCat("store_root=", bootstrap.storeRoot))
    csgCliStdout(csgCliCat("manifest_cid=", bootstrap.manifestCid))
    csgCliStdout(csgCliCat("facts_root=", closure.factsRoot))
    csgCliStdout(csgCliCat("head_cid=", bootstrap.head.headCid))
    return 0

@borrows
fn csgCliFactIdentitiesArgsFail(
        message: str): CsgCliFactIdentitiesArgs =
    var out: CsgCliFactIdentitiesArgs
    out.error = strings.CloneStr(message)
    return out

fn csgCliParseFactIdentitiesArgs():
        CsgCliFactIdentitiesArgs =
    var out: CsgCliFactIdentitiesArgs
    var inputCount: int32
    var outCount: int32
    var modeCount: int32
    var i: int32 = 2
    let count = cmdline.ParamCount()
    # ParamCount() is program-inclusive (ParamStr(0) = argv[0]), so valid
    # indices are 0..count-1. `i <= count` read one past the end; the phantom
    # empty string counted as a second positional and every invocation failed
    # fact_identities_argument_cardinality. Bound must be exclusive.
    while i < count:
        let arg = cmdline.ParamStr(i)
        if arg == "--out":
            outCount = outCount + 1
            if i == count:
                return csgCliFactIdentitiesArgsFail(
                    "fact_identities_out_value_missing")
            out.outPath = cmdline.ParamStr(i + 1)
            i = i + 2
        elif strings.HasPrefix(arg, "--out:") ||
             strings.HasPrefix(arg, "--out="):
            outCount = outCount + 1
            out.outPath = csgCliInlineFlagValue(
                arg, "--out:", "--out=")
            i = i + 1
        elif arg == "--mode":
            modeCount = modeCount + 1
            if i == count:
                return csgCliFactIdentitiesArgsFail(
                    "fact_identities_mode_value_missing")
            i = i + 2
        elif arg == "--canonical-input":
            i = i + 1
        elif csgCliIsInlineModeFlag(arg):
            modeCount = modeCount + 1
            i = i + 1
        elif strings.HasPrefix(arg, "--"):
            return csgCliFactIdentitiesArgsFail(
                "fact_identities_unknown_flag")
        else:
            inputCount = inputCount + 1
            out.inputPath = arg
            i = i + 1
    # --out is required for strict (hash-pinned output file) and optional
    # for sandbox (rows go to stdout); the mode is resolved by the caller.
    if inputCount != 1 || outCount > 1 ||
       modeCount > 1:
        return csgCliFactIdentitiesArgsFail(
            "fact_identities_argument_cardinality")
    if out.inputPath.len == 0 ||
       out.inputPath == out.outPath:
        return csgCliFactIdentitiesArgsFail(
            "fact_identities_path_invalid")
    out.ok = true
    return out

@borrows
fn csgCliFactIdentitiesAbortOutput(
        parentFd: int32,
        outputFd: int32,
        outputLeaf: str,
        platformCode: int32,
        message: str): int32 =
    if !chengpath.PathStableAbortStaging(
           parentFd,
           outputFd,
           outputLeaf,
           platformCode):
        panic("fact_identities_output_cleanup_failed")
    csgCliStderr(csgCliCat("error: ", message))
    return 1

@borrows
fn csgCliFactIdentitiesAbortHashedOutput(
        parentFd: int32,
        outputFd: int32,
        outputLeaf: str,
        platformCode: int32,
        hashState: var sha256.Sha256TwoPartState,
        message: str): int32 =
    sha256.Sha256TwoPartStateRelease(hashState)
    return csgCliFactIdentitiesAbortOutput(
        parentFd,
        outputFd,
        outputLeaf,
        platformCode,
        message)

@borrows
fn csgCliRunFactIdentitiesSandbox(): int32 =
    # Raw-fact identity contract (ts-csg bridge): per-line fact_hash plus a
    # content-only unbound subgraph_cid, rows on stdout. Strict admission is
    # deliberately not applied here; canonicality still is.
    let args = csgCliParseFactIdentitiesArgs()
    if !args.ok:
        csgCliStderr(csgCliCat("error: ", args.error))
        return 2
    if cmdline.HasFlag("--canonical-input"):
        # Sandbox is guaranteed by the caller; raw-fact identities are
        # sandbox-only and the canonical contract ships the same scope.
        return csgCliRunFactIdentitiesCanonicalRows(args.inputPath)
    if csgc.CsgCoreCsgcPathLooksBinary(args.inputPath):
        csgCliStderr(
            "error: fact-identities requires canonical JSONL")
        return 1
    var stableRead = chengpath.PathStableReadBytes(args.inputPath)
    if !stableRead.ok:
        csgCliStderr(
            csgCliCat(
                "error: fact-identities read failed: ",
                stableRead.error))
        return 1
    let text = rawbytes.BytesToString(stableRead.bytes)
    rawbytes.BytesFree(stableRead.bytes)
    if text.len == 0 || text[text.len - 1] != '\n':
        csgCliStderr(
            "error: fact-identities noncanonical JSONL framing")
        return 1
    for byteIndex in 0..<text.len:
        if text[byteIndex] == '\r':
            csgCliStderr(
                "error: fact-identities noncanonical JSONL CR")
            return 1
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    if lines.len == 0:
        csgCliStderr(
            "error: fact-identities empty fact set")
        return 1
    let canonicalResult = csgCliCanonicalizeLines(lines)
    if !canonicalResult.ok:
        csgCliStderr(
            csgCliCat(
                "error: fact-identities ",
                canonicalResult.error))
        return 1
    if canonicalResult.lines.len != lines.len:
        csgCliStderr(
            "error: fact-identities empty JSONL record")
        return 1
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0 ||
           lines[lineIndex] != canonicalResult.lines[lineIndex]:
            csgCliStderr(
                csgCliCat3(
                    "error: fact-identities line ",
                    strings.IntToStr(lineIndex + 1),
                    " is not canonical JSON"))
            return 1
    for lineIndex in 0..<canonicalResult.lines.len:
        var hashError: str
        let factHash =
            merkle_dag.CsgCoreMerkleFactHash(
                canonicalResult.lines[lineIndex],
                hashError)
        if hashError.len > 0:
            csgCliStderr(
                csgCliCat3(
                    "error: fact-identities hash failed at line ",
                    strings.IntToStr(lineIndex + 1),
                    csgCliCat(": ", hashError)))
            return 1
        var oneFact: str[]
        add(
            oneFact,
            strings.CloneStr(
                canonicalResult.lines[lineIndex]))
        let oneDag = merkle_dag.CsgCoreMerkleBuild(oneFact)
        if !oneDag.ok || oneDag.factCount != 1 ||
           oneDag.subgraphCid.len != 71 ||
           !strings.HasPrefix(oneDag.subgraphCid, "sha256:"):
            csgCliStderr(
                csgCliCat3(
                    "error: fact-identities bound subgraph failed at line ",
                    strings.IntToStr(lineIndex + 1),
                    csgCliCat(": ", oneDag.error)))
            return 1
        csgCliStdout(
            csgCliCat4(
                "fact_hash=sha256:",
                layout.FixedBytes32Hex(factHash),
                "\tsubgraph_cid=",
                oneDag.subgraphCid))
    return 0

@borrows
fn csgCliRunFactIdentities(mode: str): int32 =
    if mode == csg.CsgCoreModeSandbox:
        return csgCliRunFactIdentitiesSandbox()
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: fact-identities requires strict mode")
        return 2
    if cmdline.HasFlag("--canonical-input"):
        csgCliStderr(
            "error: fact-identities --canonical-input requires --mode sandbox")
        return 2
    let args = csgCliParseFactIdentitiesArgs()
    if !args.ok:
        csgCliStderr(csgCliCat("error: ", args.error))
        return 2
    if args.outPath.len == 0:
        csgCliStderr(
            "error: fact-identities requires --out in strict mode")
        return 2
    if csgc.CsgCoreCsgcPathLooksBinary(args.inputPath):
        csgCliStderr(
            "error: fact-identities requires canonical JSONL")
        return 1

    var stableRead = chengpath.PathStableReadBytes(args.inputPath)
    if !stableRead.ok:
        csgCliStderr(
            csgCliCat(
                "error: fact-identities read failed: ",
                stableRead.error))
        return 1
    let text = rawbytes.BytesToString(stableRead.bytes)
    rawbytes.BytesFree(stableRead.bytes)
    if text.len == 0 || text[text.len - 1] != '\n':
        csgCliStderr(
            "error: fact-identities noncanonical JSONL framing")
        return 1
    for byteIndex in 0..<text.len:
        if text[byteIndex] == '\r':
            csgCliStderr(
                "error: fact-identities noncanonical JSONL CR")
            return 1

    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    if lines.len == 0:
        csgCliStderr(
            "error: fact-identities empty fact set")
        return 1
    let canonicalResult = csgCliCanonicalizeLines(lines)
    if !canonicalResult.ok:
        csgCliStderr(
            csgCliCat(
                "error: fact-identities ",
                canonicalResult.error))
        return 1
    if canonicalResult.lines.len != lines.len:
        csgCliStderr(
            "error: fact-identities empty JSONL record")
        return 1
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0 ||
           lines[lineIndex] != canonicalResult.lines[lineIndex]:
            csgCliStderr(
                csgCliCat3(
                    "error: fact-identities line ",
                    strings.IntToStr(lineIndex + 1),
                    " is not canonical JSON"))
            return 1

    let validation =
        csg.CsgCoreProductionAdmitFactLines(lines)
    if validation.unsupportedCount != 0:
        csgCliStderr(
            "error: fact-identities unsupported forbidden")
        return 1
    if validation.tombstoneCount != 0:
        csgCliStderr(
            "error: fact-identities tombstone forbidden")
        return 1
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    if !validation.complete:
        csgCliStderr(
            "error: fact-identities complete=true required")
        return 1

    let binding =
        csg.CsgCoreRootBindingFromCanonicalLines(
            canonicalResult.lines)
    if !binding.ok:
        csgCliStderr(
            csgCliCat(
                "error: fact-identities binding failed: ",
                binding.error))
        return 1

    let expectedOutputBytes =
        Int64(canonicalResult.lines.len) * Int64(167)
    if expectedOutputBytes <= Int64(0) ||
       expectedOutputBytes > Int64(1073741824):
        csgCliStderr(
            "error: fact-identities output size exceeds 1 GiB")
        return 1

    var platformError: str
    let platformCode = chengpath.PathStablePlatformCode(platformError)
    if platformCode == 0:
        csgCliStderr(csgCliCat(
            "error: fact-identities output platform failed: ",
            platformError))
        return 1
    let outputPath = chengpath.PathStablePathResolve(args.outPath)
    if !outputPath.ok:
        csgCliStderr(csgCliCat(
            "error: fact-identities output path failed: ",
            outputPath.error))
        return 1
    var parentFd: int32
    var parentIdentity: chengpath.PathStableFileIdentity
    var parentError: str
    if !chengpath.PathStableParentOpen(
            chengpath.PathStablePathClone(outputPath),
            platformCode,
            true,
            parentFd,
            parentIdentity,
            parentError):
        csgCliStderr(csgCliCat(
            "error: fact-identities output parent failed: ",
            parentError))
        return 1
    if (parentIdentity.mode & int32(63)) != 0:
        if csgCliCloseBridge(parentFd) != 0:
            panic("fact_identities_output_parent_close_failed")
        csgCliStderr(
            "error: fact-identities output parent is not private")
        return 1
    let initialOutputStatus = chengpath.PathStableNamedStatus(
        parentFd, outputPath.leaf, platformCode)
    if initialOutputStatus != 0:
        if csgCliCloseBridge(parentFd) != 0:
            panic("fact_identities_output_parent_close_failed")
        if initialOutputStatus > 0:
            csgCliStderr(
                "error: fact-identities output already exists")
        else:
            csgCliStderr(
                "error: fact-identities output probe failed")
        return 1
    let outputFd = csgCliOpenAtBridge(
        parentFd,
        StrToCStringTemp(outputPath.leaf),
        chengpath.PathStableWriteNewFlags(platformCode),
        384)
    if outputFd < 0:
        if csgCliCloseBridge(parentFd) != 0:
            panic("fact_identities_output_parent_close_failed")
        csgCliStderr(
            "error: fact-identities output exclusive create failed")
        return 1
    var initialIdentity: chengpath.PathStableFileIdentity
    var namedInitialIdentity: chengpath.PathStableFileIdentity
    let initialIdentityOk = chengpath.PathStableIdentityRead(
        outputFd,
        platformCode,
        int32(32768),
        true,
        initialIdentity)
    let namedInitialIdentityOk = chengpath.PathStableNamedIdentityRead(
        parentFd,
        outputPath.leaf,
        platformCode,
        int32(32768),
        true,
        namedInitialIdentity)
    let effectiveUid = os.EffectiveUserId()
    if !initialIdentityOk || !namedInitialIdentityOk ||
       !chengpath.PathStableIdentityEqual(
           initialIdentity, namedInitialIdentity) ||
       initialIdentity.size != Int64(0) ||
       (initialIdentity.mode & int32(511)) != int32(384) ||
       effectiveUid < Int64(0) ||
       initialIdentity.ownerUid != uint64(effectiveUid) ||
       !chengpath.PathStableParentStillBound(
           chengpath.PathStablePathClone(outputPath),
           platformCode,
           parentIdentity):
        return csgCliFactIdentitiesAbortOutput(
            parentFd,
            outputFd,
            outputPath.leaf,
            platformCode,
            "fact-identities output initial identity invalid")

    var outputBytes: int64
    var outputHashState = sha256.Sha256TwoPartStateInit()
    for lineIndex in 0..<canonicalResult.lines.len:
        var hashError: str
        let factHash =
            merkle_dag.CsgCoreMerkleFactHash(
                canonicalResult.lines[lineIndex],
                hashError)
        if hashError.len > 0:
            return csgCliFactIdentitiesAbortHashedOutput(
                parentFd,
                outputFd,
                outputPath.leaf,
                platformCode,
                outputHashState,
                csgCliCat3(
                    "fact-identities hash failed at line ",
                    strings.IntToStr(lineIndex + 1),
                    csgCliCat(": ", hashError)))
        var oneFact: str[]
        add(
            oneFact,
            strings.CloneStr(
                canonicalResult.lines[lineIndex]))
        let oneDag =
            merkle_dag.CsgCoreMerkleBuildCanonicalBound(
                oneFact,
                binding.standard,
                binding.profiles,
                binding.schemaNamespace,
                binding.schemaCid)
        if !oneDag.ok || oneDag.factCount != 1 ||
           oneDag.factsRoot.len != 71 ||
           !strings.HasPrefix(oneDag.factsRoot, "sha256:") ||
           oneDag.subgraphCid.len != 71 ||
           !strings.HasPrefix(oneDag.subgraphCid, "sha256:"):
            return csgCliFactIdentitiesAbortHashedOutput(
                parentFd,
                outputFd,
                outputPath.leaf,
                platformCode,
                outputHashState,
                csgCliCat3(
                    "fact-identities bound subgraph failed at line ",
                    strings.IntToStr(lineIndex + 1),
                    csgCliCat(": ", oneDag.error)))
        let row = csgCliCat4(
                "fact_hash=sha256:",
                layout.FixedBytes32Hex(factHash),
                "\tsubgraph_cid=",
                oneDag.subgraphCid)
        let framedRow = csgCliCat(row, "\n")
        if framedRow.len != 167 ||
           outputBytes + Int64(framedRow.len) >
               expectedOutputBytes:
            return csgCliFactIdentitiesAbortHashedOutput(
                parentFd,
                outputFd,
                outputPath.leaf,
                platformCode,
                outputHashState,
                "fact-identities output row write failed")
        let rowBytes = rawbytes.BytesFromString(framedRow)
        sha256.Sha256TwoPartUpdate(outputHashState, rowBytes)
        if !chengpath.PathStableWriteAll(outputFd, rowBytes):
            return csgCliFactIdentitiesAbortHashedOutput(
                parentFd,
                outputFd,
                outputPath.leaf,
                platformCode,
                outputHashState,
                "fact-identities output row write failed")
        outputBytes = outputBytes + Int64(framedRow.len)

    if outputBytes != expectedOutputBytes:
        return csgCliFactIdentitiesAbortHashedOutput(
            parentFd,
            outputFd,
            outputPath.leaf,
            platformCode,
            outputHashState,
            "fact-identities output size invalid")
    if !chengpath.PathStableFsync(outputFd):
        return csgCliFactIdentitiesAbortHashedOutput(
            parentFd,
            outputFd,
            outputPath.leaf,
            platformCode,
            outputHashState,
            "fact-identities output fsync failed")
    var outputDigest =
        sha256.Sha256TwoPartFinish(outputHashState)
    let outputSha256Cid = csgCliCat(
        "sha256:", rawbytes.BytesToHex(outputDigest))
    rawbytes.BytesFree(outputDigest)
    if outputSha256Cid.len != 71:
        return csgCliFactIdentitiesAbortOutput(
            parentFd,
            outputFd,
            outputPath.leaf,
            platformCode,
            "fact-identities output digest invalid")
    var finalBeforeSync: chengpath.PathStableFileIdentity
    var namedBeforeSync: chengpath.PathStableFileIdentity
    let finalBeforeSyncOk = chengpath.PathStableIdentityRead(
        outputFd,
        platformCode,
        int32(32768),
        true,
        finalBeforeSync)
    let namedBeforeSyncOk = chengpath.PathStableNamedIdentityRead(
        parentFd,
        outputPath.leaf,
        platformCode,
        int32(32768),
        true,
        namedBeforeSync)
    if !finalBeforeSyncOk || !namedBeforeSyncOk ||
       !chengpath.PathStableSameNode(initialIdentity, finalBeforeSync) ||
       !chengpath.PathStableIdentityEqual(
           finalBeforeSync, namedBeforeSync) ||
       finalBeforeSync.size != outputBytes ||
       (finalBeforeSync.mode & int32(511)) != int32(384) ||
       finalBeforeSync.ownerUid != uint64(effectiveUid) ||
       !chengpath.PathStableParentStillBound(
           chengpath.PathStablePathClone(outputPath),
           platformCode,
           parentIdentity) ||
       !chengpath.PathStableFsync(parentFd):
        return csgCliFactIdentitiesAbortOutput(
            parentFd,
            outputFd,
            outputPath.leaf,
            platformCode,
            "fact-identities output pre-close verification failed")
    var finalAfterSync: chengpath.PathStableFileIdentity
    var namedAfterSync: chengpath.PathStableFileIdentity
    let finalAfterSyncOk = chengpath.PathStableIdentityRead(
        outputFd,
        platformCode,
        int32(32768),
        true,
        finalAfterSync)
    let namedAfterSyncOk = chengpath.PathStableNamedIdentityRead(
        parentFd,
        outputPath.leaf,
        platformCode,
        int32(32768),
        true,
        namedAfterSync)
    if !finalAfterSyncOk || !namedAfterSyncOk ||
       !chengpath.PathStableIdentityEqual(
           finalBeforeSync, finalAfterSync) ||
       !chengpath.PathStableIdentityEqual(
           finalAfterSync, namedAfterSync) ||
       !chengpath.PathStableParentStillBound(
           chengpath.PathStablePathClone(outputPath),
           platformCode,
           parentIdentity):
        return csgCliFactIdentitiesAbortOutput(
            parentFd,
            outputFd,
            outputPath.leaf,
            platformCode,
            "fact-identities output final identity changed")
    let outputCloseRc = csgCliCloseBridge(outputFd)
    let parentCloseRc = csgCliCloseBridge(parentFd)
    if outputCloseRc != 0 || parentCloseRc != 0:
        panic("fact_identities_output_close_failed")
    csgCliStdout(csgCliCat(
        "fact_count=",
        strings.IntToStr(canonicalResult.lines.len)))
    csgCliStdout(csgCliCat(
        "output_bytes=",
        strings.Int64ToStr(outputBytes)))
    csgCliStdout(csgCliCat(
        "output_sha256_cid=", outputSha256Cid))
    csgCliStdout(csgCliCat(
        "output_dev=",
        strings.Uint64ToStr(finalAfterSync.device)))
    csgCliStdout(csgCliCat(
        "output_inode=",
        strings.Uint64ToStr(finalAfterSync.inode)))
    csgCliStdout(csgCliCat(
        "output_mode=",
        strings.IntToStr(finalAfterSync.mode)))
    csgCliStdout(csgCliCat(
        "output_nlink=",
        strings.Uint64ToStr(finalAfterSync.linkCount)))
    csgCliStdout(csgCliCat(
        "output_uid=",
        strings.Uint64ToStr(finalAfterSync.ownerUid)))
    csgCliStdout(csgCliCat(
        "output_gid=",
        strings.Uint64ToStr(finalAfterSync.ownerGid)))
    csgCliStdout(csgCliCat(
        "output_size=",
        strings.Int64ToStr(finalAfterSync.size)))
    csgCliStdout(csgCliCat(
        "output_mtime_sec=",
        strings.Int64ToStr(finalAfterSync.mtimeSec)))
    csgCliStdout(csgCliCat(
        "output_mtime_nsec=",
        strings.Int64ToStr(finalAfterSync.mtimeNsec)))
    csgCliStdout(csgCliCat(
        "output_ctime_sec=",
        strings.Int64ToStr(finalAfterSync.ctimeSec)))
    csgCliStdout(csgCliCat(
        "output_ctime_nsec=",
        strings.Int64ToStr(finalAfterSync.ctimeNsec)))
    return 0

@borrows
fn csgCliValidateDiffSide(lines: str[], mode: str, label: str, canonicalLines: var str[]): bool =
    var validation: csg.CsgCoreValidationResult
    if !csgCliValidateLines(lines, mode, validation, canonicalLines):
        for i in 0..<validation.errors.len:
            csgCliStderr(csgCliCat4("error: ", label, ": ", validation.errors[i]))
        return false
    return true

@borrows
fn csgCliRunDiff(mode: str): int32 =
    let leftPath = csgCliPositionalArg(1)
    let rightPath = csgCliPositionalArg(2)
    if leftPath.len == 0 || rightPath.len == 0:
        return csgCliUsage()
    let leftRead = csgCliReadLines(leftPath)
    if !leftRead.ok:
        csgCliStderr(csgCliCat("error: ", leftRead.error))
        return 1
    var rightLines: str[]
    if rightPath == leftPath:
        rightLines = leftRead.lines
    else:
        let rightRead = csgCliReadLines(rightPath)
        if !rightRead.ok:
            csgCliStderr(csgCliCat("error: ", rightRead.error))
            return 1
        rightLines = rightRead.lines
    var leftCanonical: str[]
    var rightCanonical: str[]
    if !csgCliValidateDiffSide(leftRead.lines, mode, "left", leftCanonical):
        return 1
    if !csgCliValidateDiffSide(rightLines, mode, "right", rightCanonical):
        return 1
    let diffResult = diff.CsgCoreDiffCanonicalLines(leftCanonical, rightCanonical)
    if !diffResult.ok:
        csgCliStderr(csgCliCat("error: ", diffResult.error))
        return 1
    let same = diffResult.added.len == 0 && diffResult.removed.len == 0 && diffResult.changed.len == 0
    csgCliStdout(csgCliCat("same=", csgCliBool01(same)))
    csgCliStdout(csgCliCat("left_root=", diffResult.leftRoot))
    csgCliStdout(csgCliCat("right_root=", diffResult.rightRoot))
    csgCliStdout(csgCliCat("added_count=", strings.IntToStr(diffResult.added.len)))
    csgCliStdout(csgCliCat("removed_count=", strings.IntToStr(diffResult.removed.len)))
    csgCliStdout(csgCliCat("changed_count=", strings.IntToStr(diffResult.changed.len)))
    for i in 0..<diffResult.added.len:
        csgCliStdout(csgCliCat("added ", diffResult.added[i]))
    for i in 0..<diffResult.removed.len:
        csgCliStdout(csgCliCat("removed ", diffResult.removed[i]))
    for i in 0..<diffResult.changed.len:
        csgCliStdout(csgCliCat("changed ", diffResult.changed[i]))
    if same:
        return 0
    return 1

@borrows
fn csgCliRunIndex(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: production CSG index requires strict mode")
        return 2
    let path = csgCliPackInputPath()
    let outPath = cmdline.ReadFlagOrDefault("--out", "")
    if path.len == 0 || outPath.len == 0:
        return csgCliUsage()
    let readResult = csgCliReadAuthorizedProductionCsgcLines(path)
    if !readResult.ok:
        csgCliStderr(csgCliCat("error: ", readResult.error))
        return 1
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            readResult.lines)
    if !validation.valid:
        csgCliPrintErrors(validation)
        return 1
    let indexRoot =
        strings.CloneStr(validation.factsRoot)
    let indexJson = csg_index.CsgCoreIndexJson(
        readResult.lines, indexRoot, validation.complete)
    if !csgCliAtomicWriteText(outPath, indexJson):
        csgCliStderr(csgCliCat("error: write failed: ", outPath))
        return 1
    csgCliStdout(
        csgCliCat(
            "facts_root=", validation.factsRoot))
    csgCliStdout(csgCliCat("out=", outPath))
    return 0

fn csgCliParseIndexQueryArgs(
        error: var str): bool =
    let count = cmdline.ParamCount()
    var storeParentCount: int32
    var storeNameCount: int32
    var kindCount: int32
    var termCount: int32
    var modeCount: int32
    var i: int32 = 2
    while i <= count:
        let arg = cmdline.ParamStr(i)
        if arg == "--store-parent":
            storeParentCount = storeParentCount + 1
            if i == count ||
               cmdline.ParamStr(i + 1).len == 0 ||
               strings.HasPrefix(
                   cmdline.ParamStr(i + 1), "--"):
                error = "csg_index_query_flag_value_missing"
                return false
            i = i + 2
        elif strings.HasPrefix(arg, "--store-parent:") ||
             strings.HasPrefix(arg, "--store-parent="):
            storeParentCount = storeParentCount + 1
            i = i + 1
        elif arg == "--store-name":
            storeNameCount = storeNameCount + 1
            if i == count ||
               cmdline.ParamStr(i + 1).len == 0 ||
               strings.HasPrefix(
                   cmdline.ParamStr(i + 1), "--"):
                error = "csg_index_query_flag_value_missing"
                return false
            i = i + 2
        elif strings.HasPrefix(arg, "--store-name:") ||
             strings.HasPrefix(arg, "--store-name="):
            storeNameCount = storeNameCount + 1
            i = i + 1
        elif arg == "--kind":
            kindCount = kindCount + 1
            if i == count ||
               cmdline.ParamStr(i + 1).len == 0 ||
               strings.HasPrefix(
                   cmdline.ParamStr(i + 1), "--"):
                error = "csg_index_query_flag_value_missing"
                return false
            i = i + 2
        elif strings.HasPrefix(arg, "--kind:") ||
             strings.HasPrefix(arg, "--kind="):
            kindCount = kindCount + 1
            i = i + 1
        elif arg == "--term":
            termCount = termCount + 1
            if i == count ||
               cmdline.ParamStr(i + 1).len == 0 ||
               strings.HasPrefix(
                   cmdline.ParamStr(i + 1), "--"):
                error = "csg_index_query_flag_value_missing"
                return false
            i = i + 2
        elif strings.HasPrefix(arg, "--term:") ||
             strings.HasPrefix(arg, "--term="):
            termCount = termCount + 1
            i = i + 1
        elif arg == "--mode":
            modeCount = modeCount + 1
            if i == count ||
               cmdline.ParamStr(i + 1).len == 0 ||
               strings.HasPrefix(
                   cmdline.ParamStr(i + 1), "--"):
                error = "csg_index_query_flag_value_missing"
                return false
            i = i + 2
        elif csgCliIsInlineModeFlag(arg):
            modeCount = modeCount + 1
            i = i + 1
        elif strings.HasPrefix(arg, "--"):
            error = "csg_index_query_unknown_flag"
            return false
        else:
            error = "csg_index_query_positional_forbidden"
            return false
    if storeParentCount != 1 ||
       storeNameCount != 1 ||
       kindCount != 1 ||
       termCount != 1 ||
       modeCount > 1:
        error = "csg_index_query_flag_cardinality"
        return false
    return true

@borrows
fn csgCliRunIndexQuery(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: store index query requires strict mode")
        return 2
    var argumentError: str
    if !csgCliParseIndexQueryArgs(argumentError):
        csgCliStderr(csgCliCat(
            "error: ", argumentError))
        return 2
    let storeParent =
        cmdline.ReadFlagOrDefault("--store-parent", "")
    let storeName =
        cmdline.ReadFlagOrDefault("--store-name", "")
    let indexKind =
        cmdline.ReadFlagOrDefault("--kind", "")
    let term =
        cmdline.ReadFlagOrDefault("--term", "")
    if storeParent.len == 0 ||
       storeName.len == 0 ||
       indexKind.len == 0 ||
       term.len == 0:
        csgCliStderr(
            "error: csg_index_query_flag_value_missing")
        return 2
    var query = merkle_query.CsgCoreMerkleStoreQuery(
        storeParent,
        storeName,
        indexKind,
        term)
    if !query.ok:
        rawbytes.BytesFree(query.reportBytes)
        csgCliStderr(csgCliCat(
            "error: ", query.error))
        return 1
    if query.verificationScope != "local_query" ||
       query.fullClosureVerified ||
       query.productionAdmission ||
       query.report.len == 0 ||
       query.reportCid.len == 0 ||
       rawbytes.BytesLen(query.reportBytes) == 0:
        rawbytes.BytesFree(query.reportBytes)
        csgCliStderr(
            "error: csg_index_query_scope_invariant_failed")
        return 1
    let expected =
        merkle_query.CsgCoreMerkleQueryExpectedBindingFromResult(
            query)
    let verified = merkle_query.CsgCoreMerkleQueryReportVerify(
        query.reportBytes,
        query.reportCid,
        expected)
    if !verified.ok ||
       verified.completeReport ||
       verified.fullClosureVerified ||
       verified.productionAdmission:
        rawbytes.BytesFree(query.reportBytes)
        csgCliStderr(
            "error: csg_index_query_report_verify_failed")
        return 1
    csgCliStdout(query.report)
    rawbytes.BytesFree(query.reportBytes)
    return 0

@borrows
fn csgCliAuthorizedArgsFail(
        message: str): CsgCliAuthorizedDecodeArgs =
    var out: CsgCliAuthorizedDecodeArgs
    out.error = strings.CloneStr(message)
    return out

@borrows
fn csgCliTextCompare(left: str, right: str): int32 =
    let common =
        if left.len < right.len:
            left.len
        else:
            right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgCliFactKindValid(kind: str): bool =
    if kind.len == 0:
        return false
    for i in 0..<kind.len:
        let value = int32(kind[i]) & 255
        let alpha =
            (value >= 65 && value <= 90) ||
            (value >= 97 && value <= 122)
        let digit = value >= 48 && value <= 57
        if !alpha && !digit && value != 46 &&
           value != 58 && value != 95:
            return false
    return true

@borrows
fn csgCliInlineFlagValue(
        arg: str,
        colonPrefix: str,
        equalPrefix: str): str =
    if strings.HasPrefix(arg, colonPrefix):
        return strings.CloneStrRange(
            arg,
            colonPrefix.len,
            arg.len - colonPrefix.len)
    if strings.HasPrefix(arg, equalPrefix):
        return strings.CloneStrRange(
            arg,
            equalPrefix.len,
            arg.len - equalPrefix.len)
    return ""

fn csgCliParseAuthorizedDecodeArgs():
        CsgCliAuthorizedDecodeArgs =
    var out: CsgCliAuthorizedDecodeArgs
    var manifestCount: int32
    var outCount: int32
    var modeCount: int32
    var i: int32 = 2
    let count = cmdline.ParamCount()
    while i <= count:
        let arg = cmdline.ParamStr(i)
        if arg == "--manifest":
            manifestCount = manifestCount + 1
            if i == count:
                return csgCliAuthorizedArgsFail(
                    "csgc_authorized_manifest_value_missing")
            out.manifestPath = cmdline.ParamStr(i + 1)
            i = i + 2
        elif strings.HasPrefix(arg, "--manifest:") ||
             strings.HasPrefix(arg, "--manifest="):
            manifestCount = manifestCount + 1
            out.manifestPath = csgCliInlineFlagValue(
                arg, "--manifest:", "--manifest=")
            i = i + 1
        elif arg == "--out":
            outCount = outCount + 1
            if i == count:
                return csgCliAuthorizedArgsFail(
                    "csgc_authorized_out_value_missing")
            out.outPath = cmdline.ParamStr(i + 1)
            i = i + 2
        elif strings.HasPrefix(arg, "--out:") ||
             strings.HasPrefix(arg, "--out="):
            outCount = outCount + 1
            out.outPath = csgCliInlineFlagValue(
                arg, "--out:", "--out=")
            i = i + 1
        elif arg == "--kind":
            if i == count:
                return csgCliAuthorizedArgsFail(
                    "csgc_authorized_kind_value_missing")
            add(out.kinds, cmdline.ParamStr(i + 1))
            i = i + 2
        elif strings.HasPrefix(arg, "--kind:") ||
             strings.HasPrefix(arg, "--kind="):
            add(
                out.kinds,
                csgCliInlineFlagValue(
                    arg, "--kind:", "--kind="))
            i = i + 1
        elif arg == "--mode":
            modeCount = modeCount + 1
            if i == count:
                return csgCliAuthorizedArgsFail(
                    "csgc_authorized_mode_value_missing")
            i = i + 2
        elif csgCliIsInlineModeFlag(arg):
            modeCount = modeCount + 1
            i = i + 1
        else:
            return csgCliAuthorizedArgsFail(
                "csgc_authorized_unexpected_argument")
    if manifestCount != 1 || outCount != 1 || modeCount > 1 ||
       out.kinds.len == 0:
        return csgCliAuthorizedArgsFail(
            "csgc_authorized_argument_cardinality")
    if out.manifestPath.len == 0 || out.outPath.len == 0 ||
       out.manifestPath == out.outPath:
        return csgCliAuthorizedArgsFail(
            "csgc_authorized_path_invalid")
    for kindIndex in 0..<out.kinds.len:
        if !csgCliFactKindValid(out.kinds[kindIndex]):
            return csgCliAuthorizedArgsFail(
                "csgc_authorized_kind_invalid")
        if kindIndex > 0 &&
           csgCliTextCompare(
               out.kinds[kindIndex - 1],
               out.kinds[kindIndex]) >= 0:
            return csgCliAuthorizedArgsFail(
                "csgc_authorized_kinds_not_strictly_sorted")
    out.ok = true
    return out

@borrows
fn csgCliRunDecodeKindsAuthorized(
        session: var csgCliProcessEntrySession,
        mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: authorized CSGC decode requires strict mode")
        return 2
    let args = csgCliParseAuthorizedDecodeArgs()
    if !args.ok:
        csgCliStderr(csgCliCat("error: ", args.error))
        return 2
    if os.FileExists(args.outPath) ||
       os.DirExists(args.outPath):
        csgCliStderr(
            "error: csgc_authorized_output_already_exists")
        return 1

    var manifestRead: Result[rawbytes.Bytes] =
        os.ReadFileBytesResult(args.manifestPath)
    if result.IsErr(manifestRead):
        csgCliStderr(csgCliCat(
            "error: read failed: ", args.manifestPath))
        return 1

    var manifestBytes = rawbytes.BytesTake(manifestRead.value)
    let policy =
        csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    let trustAnchor =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorReadCurrentHead(
            policy)
    let trustError =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorError(
            trustAnchor)
    if trustError.len != 0:
        rawbytes.BytesFree(manifestBytes)
        csgCliStderr(csgCliCat("error: ", trustError))
        return 1
    let authority =
        csgc_authority.CsgCoreCsgcAuthorityVerifyAndSeal(
            session.owner,
            trustAnchor,
            manifestBytes)
    rawbytes.BytesFree(manifestBytes)
    if !csgc_authority.CsgCoreCsgcAuthorityIsValid(
           authority):
        let authorityError =
            csgc_authority.CsgCoreCsgcAuthorityError(
                authority)
        csgCliStderr(csgCliCat(
            "error: ", authorityError))
        return 1

    var selectedLines: str[]
    var kindFound: bool[]
    var kindCounts: int32[]
    var sourceFactCount: int32
    var directoryCid: str
    for kindIndex in 0..<args.kinds.len:
        let decoded =
            csgc_authority.CsgCoreCsgcDecodeFactKindAuthorized(
                session.owner,
                args.kinds[kindIndex],
                authority)
        if !decoded.ok ||
           decoded.kind != args.kinds[kindIndex] ||
           decoded.decodedFactCount != decoded.lines.len ||
           decoded.found != (decoded.decodedFactCount > 0):
            let decodeError =
                if decoded.error.len != 0:
                    strings.CloneStr(decoded.error)
                else:
                    "csgc_authorized_decode_receipt_invalid"
            csgCliStderr(csgCliCat(
                "error: ", decodeError))
            return 1
        if kindIndex == 0:
            sourceFactCount = decoded.totalFactCount
            directoryCid = strings.CloneStr(
                decoded.claimedDirectoryCid)
        elif decoded.totalFactCount != sourceFactCount ||
             decoded.claimedDirectoryCid != directoryCid:
            csgCliStderr(
                "error: csgc_authorized_cross_section_receipt_mismatch")
            return 1
        add(kindFound, decoded.found)
        add(kindCounts, decoded.decodedFactCount)
        for lineIndex in 0..<decoded.lines.len:
            add(
                selectedLines,
                strings.CloneStr(decoded.lines[lineIndex]))
    if sourceFactCount <= 0 || selectedLines.len <= 0 ||
       selectedLines.len > sourceFactCount:
        csgCliStderr(
            "error: csgc_authorized_selected_count_invalid")
        return 1
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            selectedLines)
    if !validation.valid || !validation.complete ||
       validation.factCount != selectedLines.len:
        csgCliPrintErrors(validation)
        csgCliStderr(
            "error: csgc_authorized_selected_facts_not_admissible")
        return 1
    # The process-entry issuer and mapped-reader borrow chain are complete.
    # Publication remains unreachable until the launcher owns an atomic
    # staging descriptor and binds its terminal close receipt.
    csgCliStderr(
        "error: HARD_RED:csgc_authority_launcher_staging_close_receipt_missing")
    return 70

fn csgCliPackInputPath(): str =
    let count = cmdline.ParamCount()
    var i: int32 = 2
    while i <= count:
        let arg = cmdline.ParamStr(i)
        if arg == "--out" || arg == "--mode":
            i = i + 2
        elif strings.HasPrefix(arg, "--out:") || strings.HasPrefix(arg, "--out=") || csgCliIsInlineModeFlag(arg):
            i = i + 1
        else:
            return arg
    return ""

@borrows
fn csgCliRunPack(mode: str): int32 =
    let path = csgCliPackInputPath()
    let outPath = cmdline.ReadFlagOrDefault("--out", "")
    if path.len == 0 || outPath.len == 0:
        return csgCliUsage()
    let readResult = csgCliReadCanonicalPackSourceLines(path)
    if !readResult.ok:
        csgCliStderr(csgCliCat("error: ", readResult.error))
        return 1
    if mode == csg.CsgCoreModeStrict:
        # Strict pack = production admission + container. Sandbox pack =
        # canonical-lines-only intermediate container (legacy contract the
        # ts-csg pipeline packs debug/main artifacts under).
        let validation =
            csg.CsgCoreProductionAdmitFactLines(
                readResult.lines)
        if !validation.valid || !validation.complete:
            csgCliPrintErrors(validation)
            return 1
    var encoded = csgc.CsgCoreCsgcEncodeVerifiedLines(readResult.lines)
    if !encoded.ok:
        csgCliStderr(csgCliCat("error: ", encoded.error))
        return 1
    var bytes = rawbytes.BytesTake(encoded.bytes)
    let encodedByteCount = rawbytes.BytesLen(bytes)
    if !csgCliAtomicWriteBytes(outPath, bytes):
        rawbytes.BytesFree(bytes)
        csgCliStderr(csgCliCat("error: write failed: ", outPath))
        return 1
    # Same total CsgDataEditLinesText would produce (each line + LF)
    # without materializing the full canonical text buffer.
    var canonicalJsonlBytes: int32
    for i in 0..<readResult.lines.len:
        canonicalJsonlBytes =
            canonicalJsonlBytes + readResult.lines[i].len + 1
    csgCliStdout(csgCliCat(
        "canonical_jsonl_bytes=",
        strings.IntToStr(canonicalJsonlBytes)))
    rawbytes.BytesFree(bytes)
    csgCliStdout(csgCliCat("fact_count=", strings.IntToStr(encoded.factCount)))
    csgCliStdout(csgCliCat(
        "header_size=",
        strings.IntToStr(encoded.headerSize)))
    csgCliStdout(csgCliCat(
        "flags=", strings.IntToStr(encoded.flags)))
    csgCliStdout(csgCliCat(
        "dictionary_count=",
        strings.IntToStr(encoded.dictionaryCount)))
    csgCliStdout(csgCliCat(
        "csgc_bytes=", strings.IntToStr(encodedByteCount)))
    csgCliStdout(csgCliCat("out=", outPath))
    return 0

@borrows
fn csgCliRunUnpack(mode: str): int32 =
    let path = csgCliPackInputPath()
    let outPath = cmdline.ReadFlagOrDefault("--out", "")
    if path.len == 0 || outPath.len == 0:
        return csgCliUsage()
    if !csgc.CsgCoreCsgcPathLooksBinary(path):
        csgCliStderr("error: production CSGC unpack requires .csgc input")
        return 2
    var stableRead = chengpath.PathStableReadBytes(path)
    if !stableRead.ok:
        csgCliStderr(csgCliCat(
            "error: production unpack read failed: ",
            stableRead.error))
        return 1
    let decoded =
        csgCliDecodeProductionCsgcBytes(
            stableRead.bytes)
    rawbytes.BytesFree(stableRead.bytes)
    if !decoded.ok:
        csgCliStderr(csgCliCat(
            "error: production unpack authority failed: ",
            decoded.error))
        return 1
    var admittedFactsRoot: str = ""
    var admittedComplete: int32 = 0

    if mode == csg.CsgCoreModeStrict:
        # Strict unpack = decode + production admission. Sandbox unpack =
        # pure decode of the canonical container (legacy contract).
        let validation =
            csg.CsgCoreProductionAdmitFactLines(
                decoded.lines)
        if !validation.valid:
            csgCliPrintErrors(validation)
            return 1
        admittedFactsRoot = strings.CloneStr(validation.factsRoot)
        if validation.complete:
            admittedComplete = 1

    let text =
        data_edit.CsgDataEditLinesText(
            decoded.lines)
    if !csgCliAtomicWriteText(outPath, text):
        csgCliStderr(csgCliCat(
            "error: write failed: ", outPath))
        return 1
    csgCliStdout(csgCliCat(
        "header_size=",
        strings.IntToStr(decoded.headerSize)))
    csgCliStdout(csgCliCat(
        "flags=", strings.IntToStr(decoded.flags)))
    csgCliStdout(csgCliCat(
        "fact_count=",
        strings.IntToStr(decoded.factCount)))
    # facts_root/complete come from admission; sandbox decode-only unpack
    # reports them unset (bridge consumers read the decoded text, not these).
    if mode == csg.CsgCoreModeStrict:
        csgCliStdout(csgCliCat(
            "facts_root=",
            admittedFactsRoot))
        csgCliStdout(csgCliCat(
            "complete=",
            csgCliBool01(admittedComplete)))
    else:
        csgCliStdout("facts_root=")
        csgCliStdout("complete=0")
    csgCliStdout(csgCliCat("out=", outPath))
    return 0

fn csgCliEditInputPath(): str =
    let count = cmdline.ParamCount()
    var i: int32 = 3
    while i <= count:
        let arg = cmdline.ParamStr(i)
        if csgCliFlagTakesValue(arg):
            i = i + 2
        elif csgCliIsInlineEditFlag(arg):
            i = i + 1
        else:
            return arg
    return ""

fn csgCliBuildEditOperation(action: str): data_edit.CsgDataEditOperation =
    let targetId = cmdline.ReadFlagOrDefault("--id", "")
    let fact = cmdline.ReadFlagOrDefault("--fact", "")
    if action == "append":
        return data_edit.CsgDataEditAppendFact(fact)
    if action == "replace":
        return data_edit.CsgDataEditReplaceById(targetId, fact)
    if action == "delete":
        return data_edit.CsgDataEditDeleteById(targetId)
    var op: data_edit.CsgDataEditOperation
    return op

@borrows
fn csgCliWriteReceiptIfRequested(path: str, receipt: str): bool =
    if path.len == 0:
        return true
    return csgCliAtomicWriteText(path, receipt)

@borrows
fn csgCliRunEdit(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: production CSGC edit requires strict mode")
        return 2
    let action = cmdline.ParamStr(2)
    if action != "append" && action != "replace" && action != "delete":
        return csgCliUsage()
    let inputPath = csgCliEditInputPath()
    let outPath = cmdline.ReadFlagOrDefault("--out", "")
    let receiptPath = cmdline.ReadFlagOrDefault("--receipt-out", "")
    if inputPath.len == 0 || outPath.len == 0:
        return csgCliUsage()
    if (action == "append" || action == "replace") && cmdline.ReadFlagOrDefault("--fact", "").len == 0:
        csgCliStderr("error: --fact required")
        return 2
    if action == "delete" && cmdline.ReadFlagOrDefault("--id", "").len == 0:
        csgCliStderr("error: --id required")
        return 2

    if !csgc.CsgCoreCsgcPathLooksBinary(inputPath):
        csgCliStderr("error: production CSGC edit requires .csgc input")
        return 2
    var stableRead = chengpath.PathStableReadBytes(inputPath)
    if !stableRead.ok:
        csgCliStderr(csgCliCat(
            "error: production edit read failed: ",
            stableRead.error))
        return 1
    let authorized =
        csgCliDecodeProductionCsgcBytes(
            stableRead.bytes)
    if !authorized.ok:
        rawbytes.BytesFree(stableRead.bytes)
        csgCliStderr(csgCliCat(
            "error: production edit authority failed: ",
            authorized.error))
        return 1
    var ops: data_edit.CsgDataEditOperation[]
    add(ops, csgCliBuildEditOperation(action))
    var edited =
        data_edit.CsgDataEditApplyCsgcBytes(
            stableRead.bytes, ops)
    rawbytes.BytesFree(stableRead.bytes)
    if !edited.ok:
        csgCliStderr(csgCliCat("error: ", edited.error))
        if !csgCliWriteReceiptIfRequested(receiptPath, edited.receipt):
            csgCliStderr(csgCliCat("error: receipt write failed: ", receiptPath))
        return 1
    var outBytes = rawbytes.BytesTake(edited.bytes)
    if !csgCliAtomicWriteBytes(outPath, outBytes):
        rawbytes.BytesFree(outBytes)
        csgCliStderr(csgCliCat("error: write failed: ", outPath))
        return 1
    if !csgCliWriteReceiptIfRequested(receiptPath, edited.receipt):
        rawbytes.BytesFree(outBytes)
        csgCliStderr(csgCliCat("error: receipt write failed: ", receiptPath))
        return 1
    rawbytes.BytesFree(outBytes)
    csgCliStdout(csgCliCat("before_root=", edited.beforeRoot))
    csgCliStdout(csgCliCat("after_root=", edited.afterRoot))
    csgCliStdout(csgCliCat("fact_count=", strings.IntToStr(edited.lines.len)))
    return 0

fn csgCliMerkleInputPath(startAt: int32): str =
    let count = cmdline.ParamCount()
    var i = startAt
    while i <= count:
        let arg = cmdline.ParamStr(i)
        if csgCliFlagTakesValue(arg):
            i = i + 2
        elif csgCliIsInlineEditFlag(arg):
            i = i + 1
        else:
            return arg
    return ""

@borrows
fn csgCliRunProve(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: production Merkle proof requires strict mode")
        return 2
    let inputPath = csgCliMerkleInputPath(2)
    let outPath = cmdline.ReadFlagOrDefault("--out", "")
    let queryKey = cmdline.ReadFlagOrDefault("--key", "")
    if inputPath.len == 0 ||
       outPath.len == 0 ||
       queryKey.len == 0:
        return csgCliUsage()
    let readResult =
        csgCliReadAuthorizedProductionCsgcLines(inputPath)
    if !readResult.ok:
        csgCliStderr(csgCliCat(
            "error: ", readResult.error))
        return 1
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            readResult.lines)
    if !validation.valid || !validation.complete:
        csgCliPrintErrors(validation)
        return 1
    let dag =
        csg.CsgCoreMerkleBuildBoundFromCanonicalLines(
            readResult.lines)
    if !dag.ok:
        csgCliStderr(csgCliCat(
            "error: ", dag.error))
        return 1
    let proof = merkle_dag.CsgCoreMerkleProveKey(
        dag, queryKey)
    var cargo =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
            proof, dag.factsRoot)
    if !cargo.ok:
        csgCliStderr(csgCliCat(
            "error: ", cargo.error))
        return 1
    var proofBytes = rawbytes.BytesTake(cargo.bytes)
    if !csgCliAtomicWriteBytes(outPath, proofBytes):
        rawbytes.BytesFree(proofBytes)
        csgCliStderr(csgCliCat(
            "error: write failed: ", outPath))
        return 1
    rawbytes.BytesFree(proofBytes)
    csgCliStdout(csgCliCat("facts_root=", proof.factsRoot))
    csgCliStdout(csgCliCat(
        "exists=", csgCliBool01(proof.exists)))
    csgCliStdout(csgCliCat(
        "path_count=",
        strings.IntToStr(proof.splitBits.len)))
    csgCliStdout(csgCliCat("out=", outPath))
    return 0

@borrows
fn csgCliReadProofCargo(
        inputPath: str,
        trustedExpectedFactsRoot: str):
        merkle_cargo.CsgCoreMerkleProofCargoResult =
    var readResult: Result[rawbytes.Bytes] =
        os.ReadFileBytesResult(inputPath)
    if result.IsErr(readResult):
        var failed: merkle_cargo.CsgCoreMerkleProofCargoResult
        failed.error = csgCliCat(
            "read failed: ", inputPath)
        return failed
    var proofBytes = rawbytes.BytesTake(readResult.value)
    let decoded =
        merkle_cargo.CsgCoreMerkleProofDecodeCsgc(
            proofBytes, trustedExpectedFactsRoot)
    rawbytes.BytesFree(proofBytes)
    return decoded

fn csgCliRunVerifyProof(): int32 =
    let inputPath = csgCliMerkleInputPath(2)
    let expectedFactsRoot =
        cmdline.ReadFlagOrDefault(
            "--facts-root", "")
    if inputPath.len == 0 ||
       expectedFactsRoot.len == 0:
        if expectedFactsRoot.len == 0:
            csgCliStderr(
                "error: --facts-root required")
        return csgCliUsage()
    let cargo = csgCliReadProofCargo(inputPath, expectedFactsRoot)
    if !cargo.ok:
        csgCliStderr(csgCliCat(
            "error: ", cargo.error))
        return 1
    let fact = cmdline.ReadFlagOrDefault("--fact", "")
    var verified: merkle_dag.CsgCoreMerkleVerifyResult
    if fact.len == 0:
        verified =
            merkle_dag.CsgCoreMerkleVerifyProof(
                cargo.proof,
                expectedFactsRoot)
    else:
        let canonicalFact =
            canonical.CsgCoreJsonCanonicalize(fact)
        if !canonicalFact.ok:
            csgCliStderr(csgCliCat(
                "error: ", canonicalFact.error))
            return 1
        verified =
            merkle_dag.CsgCoreMerkleVerifyFact(
                cargo.proof,
                expectedFactsRoot,
                canonicalFact.value)
    if !verified.ok:
        csgCliStderr(csgCliCat(
            "error: ", verified.error))
        return 1
    csgCliStdout("valid=1")
    csgCliStdout(csgCliCat(
        "exists=", csgCliBool01(verified.exists)))
    csgCliStdout(csgCliCat(
        "fact_count=",
        strings.IntToStr(verified.factCount)))
    csgCliStdout(csgCliCat(
        "facts_root=", verified.factsRoot))
    return 0

fn csgCliRunReplay(): int32 =
    let action = cmdline.ParamStr(2)
    if action != "insert" &&
       action != "replace" &&
       action != "delete":
        return csgCliUsage()
    csgCliStderr(
        "error: proof-only replay disabled; use csg relfacts replay with admitted before and after CSGC")
    return 1

@borrows
fn csgCliProfilesEqual(
        left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn csgCliRelfactsFactsFromAuthorized(
        facts:
            csgc_historical_authority.CsgCoreCsgcHistoricalFacts):
        CsgCliRelfactsFacts =
    var out: CsgCliRelfactsFacts
    if facts.factCount <= 0 ||
       facts.canonicalLines.len != facts.factCount ||
       facts.standard != csg.CsgCoreStandardIdentity() ||
       facts.schemaNamespace != csg.CsgCoreSchemaNamespaceIdentity() ||
       facts.factsRoot.len == 0 ||
       facts.profileSetCid.len == 0 ||
       facts.schemaCid.len == 0:
        out.error =
            "relfacts_historical_authorized_facts_invalid"
        return out
    for i in 0..<facts.canonicalLines.len:
        add(
            out.canonicalLines,
            strings.CloneStr(facts.canonicalLines[i]))
    out.standard = strings.CloneStr(facts.standard)
    out.profiles = csg.CsgCoreProfilesClone(facts.profiles)
    out.profileSetCid = strings.CloneStr(facts.profileSetCid)
    out.schemaNamespace = strings.CloneStr(facts.schemaNamespace)
    out.schemaCid = strings.CloneStr(facts.schemaCid)
    out.factsRoot = strings.CloneStr(facts.factsRoot)
    out.factCount = facts.factCount
    out.ok = true
    return out

@borrows
fn csgCliPrintRelfactsReplay(
        replay: relfacts.CsgCoreRelfactsReplayResult) =
    csgCliStdout(csgCliCat(
        "schema=", relfacts.CsgCoreRelfactsSchema()))
    csgCliStdout(csgCliCat(
        "transition_kind=", replay.transitionKind))
    csgCliStdout("replay_base=trusted_before_csgc")
    csgCliStdout("valid=1")
    csgCliStdout("complete=1")
    csgCliStdout(csgCliCat(
        "event_count=",
        strings.IntToStr(replay.eventCount)))
    csgCliStdout(csgCliCat(
        "assert_count=",
        strings.IntToStr(replay.assertCount)))
    csgCliStdout(csgCliCat(
        "retract_count=",
        strings.IntToStr(replay.retractCount)))
    csgCliStdout(csgCliCat(
        "before_fact_count=",
        strings.IntToStr(replay.beforeFactCount)))
    csgCliStdout(csgCliCat(
        "after_fact_count=",
        strings.IntToStr(replay.afterFactCount)))
    csgCliStdout(csgCliCat(
        "fact_count=",
        strings.IntToStr(replay.afterFactCount)))
    csgCliStdout(csgCliCat(
        "fact_hash_count=",
        strings.IntToStr(replay.eventCount)))
    csgCliStdout("subgraph_cid_count=2")
    csgCliStdout(csgCliCat(
        "relfacts_diff_assert_count=",
        strings.IntToStr(replay.assertCount)))
    csgCliStdout(csgCliCat(
        "relfacts_diff_retract_count=",
        strings.IntToStr(replay.retractCount)))
    csgCliStdout(csgCliCat(
        "before_dag_root_cid=", replay.beforeDagRootCid))
    csgCliStdout(csgCliCat(
        "after_dag_root_cid=", replay.afterDagRootCid))
    csgCliStdout(csgCliCat(
        "before_subgraph_cid=", replay.beforeSubgraphCid))
    csgCliStdout(csgCliCat(
        "after_subgraph_cid=", replay.afterSubgraphCid))
    csgCliStdout(csgCliCat(
        "before_facts_root=", replay.beforeFactsRoot))
    csgCliStdout(csgCliCat(
        "after_facts_root=", replay.afterFactsRoot))
    csgCliStdout(csgCliCat(
        "facts_root=", replay.afterFactsRoot))
    csgCliStdout(csgCliCat(
        "verified_against_before_facts=",
        csgCliBool01(
            replay.verifiedAgainstBeforeFacts)))
    csgCliStdout(csgCliCat(
        "verified_against_after_facts=",
        csgCliBool01(
            replay.verifiedAgainstAfterFacts)))

@borrows
fn csgCliRunRelfactsEncode(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: relfacts encode requires strict mode")
        return 2
    # Explicit non-production audit surface: this command only reads the
    # historical authority and writes a query artifact.  It never compiles,
    # never spawns and its --out artifact carries no production success
    # marker.  Production admission for relfacts is a separate capability
    # project; until then this command holds no production authority.
    csgCliStderr(
        "note: relfacts encode is a non-production audit command")
    let beforePath =
        cmdline.ReadFlagOrDefault("--before", "")
    let afterPath =
        cmdline.ReadFlagOrDefault("--after", "")
    let outPath =
        cmdline.ReadFlagOrDefault("--out", "")
    if beforePath.len == 0 ||
       afterPath.len == 0 ||
       outPath.len == 0:
        return csgCliUsage()
    let historyAuthority =
        csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityIssue()
    if !csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityIsValid(
                historyAuthority):
        csgCliStderr(csgCliCat(
            "error: ",
            csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityError(
                    historyAuthority)))
        return 1
    var beforeRead = chengpath.PathStableReadBytes(beforePath)
    if !beforeRead.ok:
        csgCliStderr(csgCliCat(
            "error: relfacts_before_read_failed ",
            beforeRead.error))
        return 1
    var afterRead = chengpath.PathStableReadBytes(afterPath)
    if !afterRead.ok:
        rawbytes.BytesFree(beforeRead.bytes)
        csgCliStderr(csgCliCat(
            "error: relfacts_after_read_failed ",
            afterRead.error))
        return 1
    let authorizedPair =
        csgc_historical_authority.CsgCoreCsgcHistoricalAuthorizePair(
                historyAuthority,
                beforeRead.bytes,
                afterRead.bytes)
    rawbytes.BytesFree(afterRead.bytes)
    rawbytes.BytesFree(beforeRead.bytes)
    if !csgc_historical_authority.CsgCoreCsgcHistoricalPairIsValid(
                authorizedPair):
        csgCliStderr(csgCliCat(
            "error: ",
            csgc_historical_authority.CsgCoreCsgcHistoricalPairError(
                    authorizedPair)))
        return 1
    let beforeFacts =
        csgCliRelfactsFactsFromAuthorized(
            csgc_historical_authority.CsgCoreCsgcHistoricalPairBeforeFacts(
                    authorizedPair))
    let afterFacts =
        csgCliRelfactsFactsFromAuthorized(
            csgc_historical_authority.CsgCoreCsgcHistoricalPairAfterFacts(
                    authorizedPair))
    if !beforeFacts.ok || !afterFacts.ok:
        csgCliStderr(
            "error: relfacts_historical_pair_projection_failed")
        return 1
    let encoded =
        relfacts.CsgCoreRelfactsEncodeCanonicalTransition(
            beforeFacts.canonicalLines,
            afterFacts.canonicalLines,
            beforeFacts.standard,
            beforeFacts.profiles,
            beforeFacts.schemaNamespace,
            beforeFacts.schemaCid,
            afterFacts.standard,
            afterFacts.profiles,
            afterFacts.schemaNamespace,
            afterFacts.schemaCid)
    if !encoded.ok ||
       !encoded.replay.verifiedAgainstBeforeFacts ||
       !encoded.replay.verifiedAgainstAfterFacts ||
       encoded.replay.beforeDagRootCid.len == 0 ||
       encoded.replay.afterDagRootCid.len == 0 ||
       encoded.replay.beforeSubgraphCid.len == 0 ||
       encoded.replay.afterSubgraphCid.len == 0 ||
       encoded.replay.transitionKind !=
           relfacts.CsgCoreRelfactsTransitionKind() ||
       encoded.replay.beforeFactsRoot != beforeFacts.factsRoot ||
       encoded.replay.afterFactsRoot != afterFacts.factsRoot ||
       encoded.replay.beforeFactCount != beforeFacts.factCount ||
       encoded.replay.afterFactCount != afterFacts.factCount:
        csgCliStderr(csgCliCat(
            "error: relfacts_encode_failed ",
            encoded.error))
        return 1
    if !csgc_historical_authority.CsgCoreCsgcHistoricalPairFinalFence(
                authorizedPair):
        csgCliStderr(
            "error: relfacts_historical_final_fence_changed")
        return 1
    var writeError: str
    if !chengpath.PathStableWriteNewText(
            outPath, encoded.text, writeError):
        csgCliStderr(csgCliCat(
            "error: relfacts_write_failed ", writeError))
        return 1
    csgCliPrintRelfactsReplay(encoded.replay)
    csgCliStdout(csgCliCat("out=", outPath))
    return 0

@borrows
fn csgCliRunRelfactsReplay(mode: str): int32 =
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: relfacts replay requires strict mode")
        return 2
    # Explicit non-production audit surface: same contract as relfacts
    # encode — historical authority read plus query output only, never a
    # production admission, compile or spawn.
    csgCliStderr(
        "note: relfacts replay is a non-production audit command")
    let beforePath =
        cmdline.ReadFlagOrDefault("--before", "")
    let sidecarPath =
        cmdline.ReadFlagOrDefault("--sidecar", "")
    let afterPath =
        cmdline.ReadFlagOrDefault("--after", "")
    if beforePath.len == 0 ||
       sidecarPath.len == 0 ||
       afterPath.len == 0:
        return csgCliUsage()
    let historyAuthority =
        csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityIssue()
    if !csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityIsValid(
                historyAuthority):
        csgCliStderr(csgCliCat(
            "error: ",
            csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityError(
                    historyAuthority)))
        return 1
    var beforeRead = chengpath.PathStableReadBytes(beforePath)
    if !beforeRead.ok:
        csgCliStderr(csgCliCat(
            "error: relfacts_before_read_failed ",
            beforeRead.error))
        return 1
    var afterRead = chengpath.PathStableReadBytes(afterPath)
    if !afterRead.ok:
        rawbytes.BytesFree(beforeRead.bytes)
        csgCliStderr(csgCliCat(
            "error: relfacts_after_read_failed ",
            afterRead.error))
        return 1
    let authorizedPair =
        csgc_historical_authority.CsgCoreCsgcHistoricalAuthorizePair(
                historyAuthority,
                beforeRead.bytes,
                afterRead.bytes)
    rawbytes.BytesFree(afterRead.bytes)
    rawbytes.BytesFree(beforeRead.bytes)
    if !csgc_historical_authority.CsgCoreCsgcHistoricalPairIsValid(
                authorizedPair):
        csgCliStderr(csgCliCat(
            "error: ",
            csgc_historical_authority.CsgCoreCsgcHistoricalPairError(
                    authorizedPair)))
        return 1
    let beforeFacts =
        csgCliRelfactsFactsFromAuthorized(
            csgc_historical_authority.CsgCoreCsgcHistoricalPairBeforeFacts(
                    authorizedPair))
    let afterFacts =
        csgCliRelfactsFactsFromAuthorized(
            csgc_historical_authority.CsgCoreCsgcHistoricalPairAfterFacts(
                    authorizedPair))
    if !beforeFacts.ok || !afterFacts.ok:
        csgCliStderr(
            "error: relfacts_historical_pair_projection_failed")
        return 1
    var sidecarRead = chengpath.PathStableReadBytes(sidecarPath)
    if !sidecarRead.ok:
        csgCliStderr(csgCliCat(
            "error: relfacts_sidecar_read_failed ",
            sidecarRead.error))
        return 1
    let sidecarText = rawbytes.BytesToString(
        sidecarRead.bytes)
    rawbytes.BytesFree(sidecarRead.bytes)
    let replay =
        relfacts.CsgCoreRelfactsReplayCanonicalTransition(
            sidecarText,
            beforeFacts.canonicalLines,
            afterFacts.canonicalLines,
            beforeFacts.standard,
            beforeFacts.profiles,
            beforeFacts.schemaNamespace,
            beforeFacts.schemaCid,
            afterFacts.standard,
            afterFacts.profiles,
            afterFacts.schemaNamespace,
            afterFacts.schemaCid)
    if !replay.ok ||
       !replay.verifiedAgainstBeforeFacts ||
       !replay.verifiedAgainstAfterFacts ||
       replay.beforeDagRootCid.len == 0 ||
       replay.afterDagRootCid.len == 0 ||
       replay.beforeSubgraphCid.len == 0 ||
       replay.afterSubgraphCid.len == 0 ||
       replay.transitionKind !=
           relfacts.CsgCoreRelfactsTransitionKind() ||
       replay.beforeFactsRoot != beforeFacts.factsRoot ||
       replay.afterFactsRoot != afterFacts.factsRoot ||
       replay.beforeFactCount != beforeFacts.factCount ||
       replay.afterFactCount != afterFacts.factCount:
        csgCliStderr(csgCliCat(
            "error: relfacts_replay_failed ",
            replay.error))
        return 1
    if !csgc_historical_authority.CsgCoreCsgcHistoricalPairFinalFence(
                authorizedPair):
        csgCliStderr(
            "error: relfacts_historical_final_fence_changed")
        return 1
    csgCliPrintRelfactsReplay(replay)
    return 0

@borrows
fn csgCliRelfactsInlineFlag(
        arg: str, flag: str): bool =
    return strings.HasPrefix(
               arg, csgCliCat(flag, ":")) ||
        strings.HasPrefix(
            arg, csgCliCat(flag, "="))

@borrows
fn csgCliRelfactsFlagId(
        action: str, arg: str): int32 =
    if arg == "--mode" ||
        csgCliRelfactsInlineFlag(arg, "--mode"):
        return 1
    if arg == "--before" ||
       csgCliRelfactsInlineFlag(arg, "--before"):
        return 2
    if action == "encode":
        if arg == "--after" ||
           csgCliRelfactsInlineFlag(arg, "--after"):
            return 3
        if arg == "--out" ||
           csgCliRelfactsInlineFlag(arg, "--out"):
            return 4
    elif action == "replay":
        if arg == "--sidecar" ||
           csgCliRelfactsInlineFlag(arg, "--sidecar"):
            return 3
        if arg == "--after" ||
           csgCliRelfactsInlineFlag(arg, "--after"):
            return 4
    return 0

@borrows
fn csgCliRelfactsFlagName(
        action: str, flagId: int32): str =
    if flagId == 1:
        return "--mode"
    if flagId == 2:
        return "--before"
    if flagId == 3:
        if action == "encode":
            return "--after"
        return "--sidecar"
    if flagId == 4:
        if action == "replay":
            return "--after"
        return "--out"
    return ""

@borrows
fn csgCliRelfactsArgsValid(
        action: str, error: var str): bool =
    var seen: bool[5]
    var previousFlagId: int32
    var index: int32 = 3
    let count = cmdline.ParamCount()
    while index <= count:
        let arg = cmdline.ParamStr(index)
        let flagId = csgCliRelfactsFlagId(action, arg)
        if flagId == 0:
            error = csgCliCat(
                "unknown relfacts argument: ", arg)
            return false
        let flagName =
            csgCliRelfactsFlagName(action, flagId)
        if seen[flagId]:
            error = csgCliCat(
                "duplicate relfacts argument: ",
                flagName)
            return false
        if flagId <= previousFlagId:
            error = csgCliCat(
                "out-of-order relfacts argument: ",
                flagName)
            return false
        seen[flagId] = true
        previousFlagId = flagId
        if arg == flagName:
            if index >= count:
                error = csgCliCat(
                    "missing relfacts argument value: ",
                    flagName)
                return false
            let value = cmdline.ParamStr(index + 1)
            if value.len == 0 ||
               strings.HasPrefix(value, "--"):
                error = csgCliCat(
                    "invalid relfacts argument value: ",
                    flagName)
                return false
            index = index + 2
        else:
            if arg.len <= flagName.len + 1:
                error = csgCliCat(
                    "empty relfacts argument value: ",
                    flagName)
                return false
            index = index + 1
    if !seen[2]:
        error = "missing relfacts argument: --before"
        return false
    if action == "encode":
        if !seen[3]:
            error = "missing relfacts argument: --after"
            return false
        if !seen[4]:
            error = "missing relfacts argument: --out"
            return false
    elif action == "replay":
        if !seen[3]:
            error = "missing relfacts argument: --sidecar"
            return false
        if !seen[4]:
            error = "missing relfacts argument: --after"
            return false
    else:
        error = "unknown relfacts action"
        return false
    return true

@borrows
fn csgCliRunRelfacts(mode: str): int32 =
    let action = cmdline.ParamStr(2)
    var error: str
    if action == "encode":
        if !csgCliRelfactsArgsValid(action, error):
            csgCliStderr(csgCliCat("error: ", error))
            return 2
        return csgCliRunRelfactsEncode(mode)
    if action == "replay":
        if !csgCliRelfactsArgsValid(action, error):
            csgCliStderr(csgCliCat("error: ", error))
            return 2
        return csgCliRunRelfactsReplay(mode)
    return csgCliUsage()

fn csgCliProductionEnvelopePresentRaw(): bool =
    return cmdline.RawParamEquals(
        1, CsgCliProductionEnvelope)

fn csgCliProductionEnvelopeValidRaw(): bool =
    return csgCliProductionEnvelopePresentRaw() &&
        cmdline.RawParamEquals(
            2, CsgCliProductionAdmitCommand)

fn csgCliProductionOwnerBegin(): CsgCliProductionOwnerPod =
    var out: CsgCliProductionOwnerPod
    let opened = system.RuntimeAllocationLedgerBegin(
        CsgCliProductionOwnerDomain,
        CsgCliProductionBackingLimit)
    if !opened.ok:
        out.errorCode = CsgCliProductionErrorOwnerBegin
        return out
    out.ok = true
    out.handle = opened.owner.handle
    out.generation = opened.owner.generation
    return out

@borrows
fn csgCliCidPodFromRuntime(
        value: system.RuntimeAllocationLedgerCid): CsgCliCidPod =
    var out: CsgCliCidPod
    out.word0 = value.word0
    out.word1 = value.word1
    out.word2 = value.word2
    out.word3 = value.word3
    return out

fn csgCliProductionOwnerClose(
        owner: CsgCliProductionOwnerPod,
        out: var CsgCliProductionExecutionPod) =
    var ownerHandle: system.RuntimeAllocationLedgerOwner
    ownerHandle.handle = owner.handle
    ownerHandle.generation = owner.generation
    let closed = system.RuntimeAllocationLedgerClose(ownerHandle)
    if !closed.ok:
        if closed.error ==
                "allocation_ledger_close_with_live_owners":
            out.errorCode =
                CsgCliProductionErrorCloseLiveOwners
        else:
            out.errorCode = CsgCliProductionErrorClose
        return
    let receipt = closed.receipt
    let allocatorLayoutCid =
        csgCliCidPodFromRuntime(receipt.allocatorLayoutCid)
    let ownerDomainCid =
        csgCliCidPodFromRuntime(receipt.ownerDomainCid)
    let eventChainCid =
        csgCliCidPodFromRuntime(receipt.eventChainCid)
    let allocationReceiptCid =
        csgCliCidPodFromRuntime(receipt.receiptCid)
    if !receipt.complete || !receipt.closed ||
       receipt.operation !=
           system.RuntimeAllocationLedgerOpClose ||
       receipt.storageKind !=
           system.RuntimeAllocationLedgerStorageNone ||
       receipt.ownerGeneration != owner.generation ||
       receipt.backingLimit != CsgCliProductionBackingLimit ||
       receipt.controlPlaneBackingBytes == uint64(0) ||
       receipt.liveBackingBytes !=
           receipt.controlPlaneBackingBytes ||
       receipt.peakBackingBytes < receipt.liveBackingBytes ||
       receipt.peakBackingBytes > receipt.backingLimit ||
       receipt.liveMappedVirtualBytes != uint64(0) ||
       receipt.liveAllocationCount != uint64(0) ||
       receipt.liveMappingCount != uint64(0) ||
       receipt.eventIndex == uint64(0) ||
       !csgCliCidPodNonZero(allocatorLayoutCid) ||
       !csgCliCidPodNonZero(ownerDomainCid) ||
       !csgCliCidPodNonZero(eventChainCid) ||
       !csgCliCidPodNonZero(allocationReceiptCid):
        out.errorCode = CsgCliProductionErrorCloseReceipt
        return
    out.allocationReceiptPresent = true
    out.allocationComplete = receipt.complete
    out.allocationClosed = receipt.closed
    out.allocationOwnerGeneration = receipt.ownerGeneration
    out.allocationBackingLimit = receipt.backingLimit
    out.allocationControlPlaneBackingBytes =
        receipt.controlPlaneBackingBytes
    out.allocationLiveBackingBytes = receipt.liveBackingBytes
    out.allocationPeakBackingBytes = receipt.peakBackingBytes
    out.allocationLiveMappedVirtualBytes =
        receipt.liveMappedVirtualBytes
    out.allocationPeakMappedVirtualBytes =
        receipt.peakMappedVirtualBytes
    out.allocationLiveAllocationCount =
        receipt.liveAllocationCount
    out.allocationPeakAllocationCount =
        receipt.peakAllocationCount
    out.allocationLiveMappingCount = receipt.liveMappingCount
    out.allocationEventIndex = receipt.eventIndex
    out.allocatorLayoutCid = allocatorLayoutCid
    out.ownerDomainCid = ownerDomainCid
    out.eventChainCid = eventChainCid
    out.allocationReceiptCid = allocationReceiptCid

fn csgCliDispatchProductionAdmit(): CsgCliProductionDispatchPod =
    var out: CsgCliProductionDispatchPod
    if cmdline.ParamCount() < 2:
        out.exitCode = csgCliUsage()
        out.errorCode = CsgCliProductionErrorDispatch
        return out
    let command = cmdline.ParamStr(2)
    if command != CsgCliProductionAdmitCommand:
        csgCliStderr(
            "error: production workload command is not admitted")
        out.exitCode = 2
        out.errorCode = CsgCliProductionErrorDispatch
        return out
    let mode = cmdline.ReadFlagOrDefault(
        "--mode", csg.CsgCoreModeStrict)
    if mode != csg.CsgCoreModeStrict:
        csgCliStderr(
            "error: production workload requires strict mode")
        out.exitCode = 2
        out.errorCode = CsgCliProductionErrorDispatch
        return out
    let path = csgCliPositionalArgFrom(3, 1)
    out.exitCode = csgCliRunAdmitPathInto(
        mode, path, out.facts)
    if out.exitCode != 0:
        out.errorCode = CsgCliProductionErrorDispatch
    elif !out.facts.present || !out.facts.complete ||
         out.facts.factCount <= 0 ||
         !csgCliCidPodNonZero(out.facts.factsRoot) ||
         !csgCliCidPodNonZero(out.facts.profileSetCid):
        out.errorCode = CsgCliProductionErrorFactsIdentity
    return out

fn csgCliRawReceiptAppendByte(
        buffer: var uint8[4096],
        position: var int32,
        value: int32): bool =
    if position < 0 ||
       position >= CsgCliProductionReceiptBufferBytes:
        return false
    buffer[position] = uint8(value & 255)
    position = position + 1
    return true

@borrows
fn csgCliRawReceiptAppendText(
        buffer: var uint8[4096],
        position: var int32,
        value: str): bool =
    if value.len < 0 || position < 0 ||
       value.len >
           CsgCliProductionReceiptBufferBytes - position:
        return false
    for index in 0..<value.len:
        buffer[position] =
            uint8(int32(value[index]) & 255)
        position = position + 1
    return true

fn csgCliRawReceiptAppendU64(
        buffer: var uint8[4096],
        position: var int32,
        value: uint64): bool =
    if value == uint64(0):
        return csgCliRawReceiptAppendByte(
            buffer, position, int32('0'))
    var digits: uint8[20]
    var count: int32
    var remaining = value
    while remaining > uint64(0) && count < 20:
        digits[count] = uint8(
            int32(remaining % uint64(10)) + int32('0'))
        count = count + 1
        remaining = remaining / uint64(10)
    if remaining != uint64(0) || count <= 0:
        return false
    for index in 0..<count:
        if !csgCliRawReceiptAppendByte(
                buffer,
                position,
                int32(digits[count - 1 - index])):
            return false
    return true

fn csgCliRawReceiptAppendI32(
        buffer: var uint8[4096],
        position: var int32,
        value: int32): bool =
    if value < 0:
        if !csgCliRawReceiptAppendByte(
                buffer, position, int32('-')):
            return false
        return csgCliRawReceiptAppendU64(
            buffer, position, uint64(-int64(value)))
    return csgCliRawReceiptAppendU64(
        buffer, position, uint64(value))

fn csgCliRawReceiptAppendBool(
        buffer: var uint8[4096],
        position: var int32,
        value: bool): bool =
    if value:
        return csgCliRawReceiptAppendByte(
            buffer, position, int32('1'))
    return csgCliRawReceiptAppendByte(
        buffer, position, int32('0'))

@borrows
fn csgCliCidPodWord(
        value: CsgCliCidPod,
        index: int32): uint64 =
    if index == 0:
        return value.word0
    if index == 1:
        return value.word1
    if index == 2:
        return value.word2
    if index == 3:
        return value.word3
    return uint64(0)

@borrows
fn csgCliRawReceiptAppendCid(
        buffer: var uint8[4096],
        position: var int32,
        value: CsgCliCidPod): bool =
    if !csgCliRawReceiptAppendText(
            buffer, position, "sha256:"):
        return false
    for wordIndex in 0..<4:
        let word = csgCliCidPodWord(value, wordIndex)
        for nibbleIndex in 0..<16:
            let shift = uint64((15 - nibbleIndex) * 4)
            let nibble = int32(
                (word >> shift) & uint64(15))
            let digit = nibble < 10 ?
                int32('0') + nibble :
                int32('a') + nibble - 10
            if !csgCliRawReceiptAppendByte(
                    buffer, position, digit):
                return false
    return true

fn csgCliRawReceiptAppendNewline(
        buffer: var uint8[4096],
        position: var int32): bool =
    return csgCliRawReceiptAppendByte(
        buffer, position, int32('\n'))

fn csgCliRawReceiptWriteAll(
        fd: int32,
        buffer: var uint8[4096],
        length: int32): bool =
    if fd < 0 || length <= 0 ||
       length > CsgCliProductionReceiptBufferBytes:
        return false
    var offset: int32
    while offset < length:
        let written = csgCliWriteBridge(
            fd,
            rawmem_support.RawmemPtrAdd(
                ptr(&buffer), offset),
            length - offset)
        if written < int64(0):
            if csgCliErrnoBridge() == 4:
                continue
            return false
        if written == int64(0) ||
           written > int64(length - offset):
            return false
        offset = offset + int32(written)
    return true

fn csgCliWriteProductionExecutionReceiptRaw(
        receipt: CsgCliProductionExecutionPod): bool =
    var buffer: uint8[4096]
    var position: int32
    var ok = csgCliRawReceiptAppendText(
        buffer,
        position,
        "schema=csg_core::execution_admission_receipt::v1\n")
    if receipt.errorCode == CsgCliProductionErrorNone:
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position,
            "status=CANDIDATE_PARENT_SEAL_REQUIRED\n")
    else:
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "status=HARD_RED\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "command=admit\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "command_exit_code=")
    ok = ok && csgCliRawReceiptAppendI32(
        buffer, position, receipt.commandExitCode)
    ok = ok && csgCliRawReceiptAppendNewline(
        buffer, position)
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "error_code=")
    ok = ok && csgCliRawReceiptAppendI32(
        buffer, position, receipt.errorCode)
    ok = ok && csgCliRawReceiptAppendNewline(
        buffer, position)
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "sha256_cache_close_attempted=")
    ok = ok && csgCliRawReceiptAppendBool(
        buffer, position, receipt.shaCacheCloseAttempted)
    ok = ok && csgCliRawReceiptAppendNewline(
        buffer, position)
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "sha256_cache_closed=")
    ok = ok && csgCliRawReceiptAppendBool(
        buffer, position, receipt.shaCacheClosed)
    ok = ok && csgCliRawReceiptAppendNewline(
        buffer, position)
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "manifest_identity_present=0\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "facts_identity_present=")
    ok = ok && csgCliRawReceiptAppendBool(
        buffer, position, receipt.facts.present)
    ok = ok && csgCliRawReceiptAppendNewline(
        buffer, position)
    if receipt.facts.present:
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "facts_root=")
        ok = ok && csgCliRawReceiptAppendCid(
            buffer, position, receipt.facts.factsRoot)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "profile_set_cid=")
        ok = ok && csgCliRawReceiptAppendCid(
            buffer, position, receipt.facts.profileSetCid)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "fact_count=")
        ok = ok && csgCliRawReceiptAppendI32(
            buffer, position, receipt.facts.factCount)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "allocation_receipt_present=")
    ok = ok && csgCliRawReceiptAppendBool(
        buffer, position, receipt.allocationReceiptPresent)
    ok = ok && csgCliRawReceiptAppendNewline(
        buffer, position)
    if receipt.allocationReceiptPresent:
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "allocation_receipt_cid=")
        ok = ok && csgCliRawReceiptAppendCid(
            buffer, position, receipt.allocationReceiptCid)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "allocator_layout_cid=")
        ok = ok && csgCliRawReceiptAppendCid(
            buffer, position, receipt.allocatorLayoutCid)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "owner_domain_cid=")
        ok = ok && csgCliRawReceiptAppendCid(
            buffer, position, receipt.ownerDomainCid)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "event_chain_cid=")
        ok = ok && csgCliRawReceiptAppendCid(
            buffer, position, receipt.eventChainCid)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "allocation_event_index=")
        ok = ok && csgCliRawReceiptAppendU64(
            buffer, position, receipt.allocationEventIndex)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "allocation_backing_limit=")
        ok = ok && csgCliRawReceiptAppendU64(
            buffer, position, receipt.allocationBackingLimit)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position, "allocation_peak_backing_bytes=")
        ok = ok && csgCliRawReceiptAppendU64(
            buffer, position, receipt.allocationPeakBackingBytes)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position,
            "allocation_peak_mapped_virtual_bytes=")
        ok = ok && csgCliRawReceiptAppendU64(
            buffer,
            position,
            receipt.allocationPeakMappedVirtualBytes)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
        ok = ok && csgCliRawReceiptAppendText(
            buffer, position,
            "allocation_peak_allocation_count=")
        ok = ok && csgCliRawReceiptAppendU64(
            buffer,
            position,
            receipt.allocationPeakAllocationCount)
        ok = ok && csgCliRawReceiptAppendNewline(
            buffer, position)
    ok = ok && csgCliRawReceiptAppendText(
        buffer,
        position,
        "binding_scope=facts_identity+allocation_receipt\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer,
        position,
        "final_receipt_cid_issuer=native_launcher_parent\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer,
        position,
        "caller_receipt_expectation=forbidden\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "production_ready=0\n")
    ok = ok && csgCliRawReceiptAppendText(
        buffer, position, "receipt_frame_complete=1\n")
    if !ok:
        return false
    return csgCliRawReceiptWriteAll(
        CsgCliProductionReceiptFd, buffer, position)

fn csgCliRunProductionAdmit(): int32 =
    var execution: CsgCliProductionExecutionPod
    let owner = csgCliProductionOwnerBegin()
    if !owner.ok:
        execution.errorCode = owner.errorCode
        execution.commandExitCode = 70
        cmdline.ClearCapturedCmdLine()
        if !csgCliWriteProductionExecutionReceiptRaw(execution):
            return 74
        return 70
    execution.ownerActivated = true
    execution.ownerGeneration = owner.generation
    let dispatched = csgCliDispatchProductionAdmit()
    execution.commandExitCode = dispatched.exitCode
    execution.errorCode = dispatched.errorCode
    execution.facts = dispatched.facts
    cmdline.ClearCapturedCmdLine()
    execution.shaCacheCloseAttempted = true
    execution.shaCacheClosed =
        sha256.Sha256SharedKTableClose()
    if !execution.shaCacheClosed:
        execution.errorCode =
            CsgCliProductionErrorShaCacheClose
    csgCliProductionOwnerClose(owner, execution)
    if !csgCliWriteProductionExecutionReceiptRaw(execution):
        return 74
    if execution.errorCode != CsgCliProductionErrorNone:
        return 70
    return execution.commandExitCode

fn csgCliProcessEntrySessionRetire(
        session: var csgCliProcessEntrySession) =
    if !session.ownerIssued || session.closeAttempted || session.closed ||
       session.owner.handle == uint64(0) ||
       session.owner.generation == uint64(0):
        panic("csg_cli_process_entry_session_owner_state_invalid")
    let ownerGeneration = session.owner.generation
    session.closeAttempted = true
    let closed = csgc_mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(
        session.owner)
    if !closed.ok || !closed.receipt.complete ||
       closed.receipt.active || !closed.receipt.closed ||
       closed.receipt.capabilityGeneration != ownerGeneration ||
       closed.receipt.ownerGeneration != ownerGeneration ||
       closed.receipt.operation !=
           system.RuntimeAllocationLedgerOpClose ||
       closed.receipt.storageKind !=
           system.RuntimeAllocationLedgerStorageNone ||
       closed.receipt.backingLimit !=
           csgc_mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit ||
       closed.receipt.controlPlaneBackingBytes == uint64(0) ||
       closed.receipt.liveBackingBytes !=
           closed.receipt.controlPlaneBackingBytes ||
       closed.receipt.peakBackingBytes <
           closed.receipt.liveBackingBytes ||
       closed.receipt.peakBackingBytes >
           closed.receipt.backingLimit ||
       closed.receipt.liveMappedVirtualBytes != uint64(0) ||
       closed.receipt.liveAllocationCount != uint64(0) ||
       closed.receipt.liveMappingCount != uint64(0) ||
       closed.receipt.liveHandleCount != uint64(0) ||
       !closed.receipt.rawManagedPointerAbaProven ||
       !closed.receipt.recursiveLockProven ||
       closed.receipt.eventIndex == uint64(0) ||
       closed.receipt.receiptCid.word0 == uint64(0) &&
           closed.receipt.receiptCid.word1 == uint64(0) &&
           closed.receipt.receiptCid.word2 == uint64(0) &&
           closed.receipt.receiptCid.word3 == uint64(0):
        panic("csg_cli_process_entry_session_owner_retire_failed")
    session.owner.handle = uint64(0)
    session.owner.generation = uint64(0)
    session.ownerIssued = false
    session.closed = true

fn csgCliCsgcAuthoritySessionDispatch(
        session: var csgCliProcessEntrySession): int32 =
    let command = cmdline.ParamStr(1)
    if command == "decode-kinds-authorized":
        let mode = cmdline.ReadFlagOrDefault(
            "--mode", csg.CsgCoreModeStrict)
        return csgCliRunDecodeKindsAuthorized(
            session, mode)
    return csgCliUsage()

fn csgCliCsgcAuthoritySession(
        session: var csgCliProcessEntrySession): int32 =
    if !session.ownerIssued:
        cmdline.ClearCapturedCmdLine()
        csgCliStderr(
            "error: HARD_RED:csgc_authority_process_entry_owner_required")
        return 70
    let rc = csgCliCsgcAuthoritySessionDispatch(session)
    cmdline.ClearCapturedCmdLine()
    if !sha256.Sha256SharedKTableClose():
        panic("csg_cli_process_entry_session_sha_cache_close_failed")
    csgCliProcessEntrySessionRetire(session)
    return rc

fn csgCliDispatchCaptured(): int32 =
    if cmdline.ParamCount() < 1:
        return csgCliUsage()
    let command = cmdline.ParamStr(1)
    let mode = cmdline.ReadFlagOrDefault("--mode", csg.CsgCoreModeStrict)
    if mode != csg.CsgCoreModeStrict && mode != csg.CsgCoreModeSandbox:
        csgCliStderr(csgCliCat("error: invalid mode: ", mode))
        return 2
    if command == "validate":
        return csgCliRunValidate(mode)
    if command == "merged-scan":
        return csgCliRunMergedScan(mode)
    if command == "admit":
        return csgCliRunAdmit(mode)
    if command == "root":
        return csgCliRunRoot(mode)
    if command == "fact-identities":
        return csgCliRunFactIdentities(mode)
    if command == "diff":
        return csgCliRunDiff(mode)
    if command == "index":
        return csgCliRunIndex(mode)
    if command == "index-query":
        return csgCliRunIndexQuery(mode)
    if command == "pack":
        return csgCliRunPack(mode)
    if command == "unpack":
        return csgCliRunUnpack(mode)
    if command == "edit":
        return csgCliRunEdit(mode)
    if command == "prove":
        return csgCliRunProve(mode)
    if command == "verify-proof":
        return csgCliRunVerifyProof()
    if command == "replay":
        return csgCliRunReplay()
    if command == "relfacts":
        return csgCliRunRelfacts(mode)
    if command == "store-bootstrap":
        return csgCliRunStoreBootstrap(mode)
    return csgCliUsage()

fn main(argc: int32, argv: str*): int32 =
    # The nominal process-entry session owner is issued before any managed
    # allocation exists, including command-line capture; the runtime begin
    # core hard-fails unless the process heap, registry, and probe baselines
    # are all exactly zero. Non-authority commands retire it before any
    # managed work; the authority session holds it to its terminal close.
    var session: csgCliProcessEntrySession
    if !csgc_mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
           csgc_mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
           session.owner):
        panic("csg_cli_process_entry_session_owner_begin_failed")
    session.ownerIssued = true
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.RawParamEquals(1, "decode-kinds-authorized"):
        return csgCliCsgcAuthoritySession(session)
    csgCliProcessEntrySessionRetire(session)
    if csgCliProductionEnvelopePresentRaw():
        if !csgCliProductionEnvelopeValidRaw():
            var execution: CsgCliProductionExecutionPod
            execution.commandExitCode = 2
            execution.errorCode = CsgCliProductionErrorEnvelope
            cmdline.ClearCapturedCmdLine()
            if !csgCliWriteProductionExecutionReceiptRaw(
                    execution):
                return 74
            return 70
        return csgCliRunProductionAdmit()
    return csgCliDispatchCaptured()
