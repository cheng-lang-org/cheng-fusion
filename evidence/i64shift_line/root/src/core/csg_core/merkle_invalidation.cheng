import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec

type
    CsgCoreMerkleDependencyEdge =
        consumerSource: str
        providerSource: str
        selector: str
        providerSubgraphCid: str

    CsgCoreMerkleInvalidationResult =
        ok: bool
        error: str
        dependencyRoot: str
        sourceSetRoot: str
        invalidationRoot: str
        changedSources: str[]
        invalidatedSources: str[]
        untouchedSources: str[]
        dependencyCount: int32

@borrows
fn csgInvalidationCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgInvalidationCat3(
        a: str,
        b: str,
        c: str): str =
    return csgInvalidationCat(
        csgInvalidationCat(a, b), c)

@borrows
fn csgInvalidationTuplePart(
        value: str): str =
    return csgInvalidationCat3(
        strings.IntToStr(value.len),
        ":",
        value)

@borrows
fn csgInvalidationEdgeHash(
        edge: CsgCoreMerkleDependencyEdge):
        layout.FixedBytes32 =
    let pair =
        csgInvalidationCat(
            csgInvalidationTuplePart(
                edge.consumerSource),
            csgInvalidationCat(
                csgInvalidationTuplePart(
                    edge.providerSource),
                csgInvalidationTuplePart(
                    edge.selector)))
    return merkle_dag.CsgCoreMerkleKeyHash(
        csgInvalidationCat(
            "dependency:", pair))

@borrows
fn csgInvalidationEdgeIdentity(
        edge: CsgCoreMerkleDependencyEdge): str =
    return csgInvalidationCat(
        "dep:",
        layout.FixedBytes32Hex(
            csgInvalidationEdgeHash(edge)))

@borrows
fn csgInvalidationSourceHash(
        source: str): layout.FixedBytes32 =
    return merkle_dag.CsgCoreMerkleKeyHash(
        csgInvalidationCat(
            "source:", source))

@borrows
fn csgInvalidationSourceIdentity(
        source: str): str =
    return csgInvalidationCat(
        "source:",
        layout.FixedBytes32Hex(
            csgInvalidationSourceHash(source)))

@borrows
fn csgInvalidationHash64(
        value: layout.FixedBytes32): uint64 =
    var out: uint64
    for i in 0..<8:
        out = out |
            (uint64(value.data[i]) <<
             uint64(i * 8))
    return out

fn csgInvalidationIndexCapacity(
        itemCount: int32): int32 =
    if itemCount < 0:
        return -1
    let target = int64(itemCount) * int64(2)
    var capacity: int32 = 8
    while int64(capacity) < target:
        if capacity > 1073741823:
            return -1
        capacity = capacity * 2
    return capacity

@borrows
fn csgInvalidationSourceIndexInsert(
        sources: str[],
        sourceHashes: layout.FixedBytes32[],
        sourceIndex: int32,
        slots: var int32[]): int32 =
    if sourceIndex < 0 ||
       sourceIndex >= sources.len ||
       sourceIndex >= sourceHashes.len ||
       slots.len <= 0:
        return 3
    let sourceHash = sourceHashes[sourceIndex]
    var bucket =
        int32(
            csgInvalidationHash64(sourceHash) &
            uint64(slots.len - 1))
    for probe in 0..<slots.len:
        let previousPlusOne = slots[bucket]
        if previousPlusOne == 0:
            slots[bucket] = sourceIndex + 1
            return 0
        let previousIndex = previousPlusOne - 1
        if previousIndex < 0 ||
           previousIndex >= sourceIndex:
            return 3
        if layout.FixedBytes32Equal(
               sourceHashes[previousIndex],
               sourceHash):
            if sources[previousIndex] ==
               sources[sourceIndex]:
                return 1
            return 2
        bucket = (bucket + 1) &
            (slots.len - 1)
    return 4

@borrows
fn csgInvalidationSourceIndex(
        sources: str[],
        sourceHashes: layout.FixedBytes32[],
        slots: int32[],
        source: str): int32 =
    if sources.len != sourceHashes.len ||
       slots.len <= 0:
        return -3
    let sourceHash =
        csgInvalidationSourceHash(source)
    var bucket =
        int32(
            csgInvalidationHash64(sourceHash) &
            uint64(slots.len - 1))
    for probe in 0..<slots.len:
        let sourcePlusOne = slots[bucket]
        if sourcePlusOne == 0:
            return -1
        let sourceIndex = sourcePlusOne - 1
        if sourceIndex < 0 ||
           sourceIndex >= sources.len:
            return -3
        if layout.FixedBytes32Equal(
               sourceHashes[sourceIndex],
               sourceHash):
            if sources[sourceIndex] == source:
                return sourceIndex
            return -2
        bucket = (bucket + 1) &
            (slots.len - 1)
    return -4

@borrows
fn CsgCoreMerkleSourceCidCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgInvalidationMergeOrderPass(
        values: str[],
        source: var int32[],
        destination: var int32[],
        width: int32) =
    let count = source.len
    var leftStart: int32
    while leftStart < count:
        let midRaw =
            int64(leftStart) + int64(width)
        var mid = count
        if midRaw < int64(count):
            mid = int32(midRaw)
        let rightEndRaw =
            int64(leftStart) + int64(width) * int64(2)
        var rightEnd = count
        if rightEndRaw < int64(count):
            rightEnd = int32(rightEndRaw)
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            if left < mid &&
               (right >= rightEnd ||
                CsgCoreMerkleSourceCidCompare(
                    values[source[left]],
                    values[source[right]]) <= 0):
                destination[outIndex] = source[left]
                left = left + 1
            else:
                destination[outIndex] = source[right]
                right = right + 1
        leftStart = rightEnd

@borrows
fn CsgCoreMerkleInvalidationSorted(
        values: str[]): str[] =
    let indexCapacity =
        csgInvalidationIndexCapacity(values.len)
    if indexCapacity < 0:
        panic(
            "merkle_invalidation_sort_index_capacity_overflow")
    var hashes: layout.FixedBytes32[]
    var indexSlots: int32[]
    var order: int32[]
    var scratch: int32[]
    setLen(indexSlots, indexCapacity)
    for i in 0..<values.len:
        add(
            hashes,
            csgInvalidationSourceHash(values[i]))
        let insertStatus =
            csgInvalidationSourceIndexInsert(
                values, hashes, i, indexSlots)
        if insertStatus == 2:
            panic(
                "merkle_invalidation_sort_hash_collision")
        if insertStatus == 3:
            panic(
                "merkle_invalidation_sort_index_corrupt")
        if insertStatus == 4:
            panic(
                "merkle_invalidation_sort_index_full")
        if insertStatus != 0 && insertStatus != 1:
            panic(
                "merkle_invalidation_sort_index_status_invalid")
        add(order, i)
        add(scratch, i)
    var width: int32 = 1
    var readScratch: bool
    while width < order.len:
        if readScratch:
            csgInvalidationMergeOrderPass(
                values, scratch, order, width)
        else:
            csgInvalidationMergeOrderPass(
                values, order, scratch, width)
        readScratch = !readScratch
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    if readScratch:
        for i in 0..<order.len:
            order[i] = scratch[i]
    var out: str[]
    for i in 0..<order.len:
        add(
            out,
            strings.CloneStr(values[order[i]]))
    return out

@borrows
fn csgInvalidationDependencyLine(
        edge: CsgCoreMerkleDependencyEdge): str =
    var out = csgInvalidationCat(
        "{\"consumer_source\":",
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            edge.consumerSource))
    out = csgInvalidationCat(
        out, ",\"id\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            csgInvalidationEdgeIdentity(edge)))
    out = csgInvalidationCat(
        out,
        ",\"kind\":\"csg.merkle.dependency\"")
    out = csgInvalidationCat(
        out, ",\"provider_source\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            edge.providerSource))
    out = csgInvalidationCat(
        out, ",\"provider_subgraph_cid\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            edge.providerSubgraphCid))
    out = csgInvalidationCat(
        out, ",\"selector\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            edge.selector))
    return csgInvalidationCat(out, "}")

@borrows
fn csgInvalidationSourceLine(
        source: str,
        changed: bool): str =
    var out: str = "{\"id\":"
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            csgInvalidationSourceIdentity(source)))
    out = csgInvalidationCat(
        out,
        ",\"kind\":\"csg.merkle.invalidated_source\"")
    out = csgInvalidationCat(
        out, ",\"source_id\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            source))
    out = csgInvalidationCat(
        out, ",\"status\":")
    if changed:
        out = csgInvalidationCat(
            out, "\"changed\"")
    else:
        out = csgInvalidationCat(
            out, "\"dependent\"")
    return csgInvalidationCat(out, "}")

@borrows
fn csgInvalidationSourceSetLine(
        source: str): str =
    var out: str = "{\"id\":"
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            csgInvalidationSourceIdentity(source)))
    out = csgInvalidationCat(
        out,
        ",\"kind\":\"csg.merkle.source_identity\"")
    out = csgInvalidationCat(
        out, ",\"source_id\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            source))
    return csgInvalidationCat(out, "}")

@borrows
fn csgInvalidationBindingIdentity(
        dependencyRoot: str,
        sourceSetRoot: str): str =
    let pair =
        csgInvalidationCat(
            csgInvalidationTuplePart(dependencyRoot),
            csgInvalidationTuplePart(sourceSetRoot))
    return csgInvalidationCat(
        "invalidation:",
        layout.FixedBytes32Hex(
            merkle_dag.CsgCoreMerkleKeyHash(
                csgInvalidationCat(
                    "invalidation_binding:", pair))))

@borrows
fn csgInvalidationBindingLine(
        dependencyRoot: str,
        sourceSetRoot: str,
        changedCount: int32,
        invalidatedCount: int32,
        sourceCount: int32): str =
    var out: str = "{\"changed_count\":"
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            strings.IntToStr(changedCount)))
    out = csgInvalidationCat(
        out, ",\"dependency_root\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            dependencyRoot))
    out = csgInvalidationCat(out, ",\"id\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            csgInvalidationBindingIdentity(
                dependencyRoot, sourceSetRoot)))
    out = csgInvalidationCat(
        out, ",\"invalidated_count\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            strings.IntToStr(invalidatedCount)))
    out = csgInvalidationCat(
        out,
        ",\"kind\":\"csg.merkle.invalidation_binding\"")
    out = csgInvalidationCat(
        out, ",\"source_count\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            strings.IntToStr(sourceCount)))
    out = csgInvalidationCat(
        out, ",\"source_set_root\":")
    out = csgInvalidationCat(
        out,
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            sourceSetRoot))
    return csgInvalidationCat(out, "}")

@borrows
fn csgInvalidationFail(
        error: str):
        CsgCoreMerkleInvalidationResult =
    var out: CsgCoreMerkleInvalidationResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleInvalidationBuild(
        sources: str[],
        dependencies: CsgCoreMerkleDependencyEdge[],
        changedSources: str[]):
        CsgCoreMerkleInvalidationResult =
    if sources.len <= 0:
        return csgInvalidationFail(
            "merkle_invalidation_sources_empty")
    if changedSources.len <= 0:
        return csgInvalidationFail(
            "merkle_invalidation_changed_empty")

    let sourceIndexCapacity =
        csgInvalidationIndexCapacity(sources.len)
    if sourceIndexCapacity < 0:
        return csgInvalidationFail(
            "merkle_invalidation_source_index_capacity_overflow")
    var sourceHashes: layout.FixedBytes32[]
    var sourceIndexSlots: int32[]
    setLen(sourceIndexSlots, sourceIndexCapacity)
    for i in 0..<sources.len:
        if sources[i].len == 0:
            return csgInvalidationFail(
                "merkle_invalidation_source_empty")
        add(
            sourceHashes,
            csgInvalidationSourceHash(sources[i]))
        let insertStatus =
            csgInvalidationSourceIndexInsert(
                sources,
                sourceHashes,
                i,
                sourceIndexSlots)
        if insertStatus == 1:
            return csgInvalidationFail(
                "merkle_invalidation_source_duplicate")
        if insertStatus == 2:
            return csgInvalidationFail(
                "merkle_invalidation_source_hash_collision")
        if insertStatus == 3:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_corrupt")
        if insertStatus == 4:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_full")
        if insertStatus != 0:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_status_invalid")

    var changedMask: bool[]
    var invalidatedMask: bool[]
    var reverseCounts: int32[]
    for i in 0..<sources.len:
        add(changedMask, false)
        add(invalidatedMask, false)
        add(reverseCounts, 0)

    for i in 0..<changedSources.len:
        let sourceIndex =
            csgInvalidationSourceIndex(
                sources,
                sourceHashes,
                sourceIndexSlots,
                changedSources[i])
        if sourceIndex == -2:
            return csgInvalidationFail(
                "merkle_invalidation_source_hash_collision")
        if sourceIndex == -3:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_corrupt")
        if sourceIndex == -4:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_full")
        if sourceIndex < -4:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_status_invalid")
        if sourceIndex < 0:
            return csgInvalidationFail(
                "merkle_invalidation_changed_unknown")
        if changedMask[sourceIndex]:
            return csgInvalidationFail(
                "merkle_invalidation_changed_duplicate")
        changedMask[sourceIndex] = true
        invalidatedMask[sourceIndex] = true

    var dependencyLines: str[]
    var edgeConsumers: int32[]
    var edgeProviders: int32[]
    let edgeIndexCapacity =
        csgInvalidationIndexCapacity(dependencies.len)
    if edgeIndexCapacity < 0:
        return csgInvalidationFail(
            "merkle_invalidation_dependency_index_capacity_overflow")
    var edgeHashes: layout.FixedBytes32[]
    var edgeIndexSlots: int32[]
    setLen(edgeIndexSlots, edgeIndexCapacity)
    for edgeIndex in 0..<dependencies.len:
        let edge = dependencies[edgeIndex]
        if edge.consumerSource.len == 0 ||
           edge.providerSource.len == 0 ||
           edge.selector.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               edge.providerSubgraphCid):
            return csgInvalidationFail(
                "merkle_invalidation_dependency_invalid")
        let consumer =
            csgInvalidationSourceIndex(
                sources,
                sourceHashes,
                sourceIndexSlots,
                edge.consumerSource)
        let provider =
            csgInvalidationSourceIndex(
                sources,
                sourceHashes,
                sourceIndexSlots,
                edge.providerSource)
        if consumer == -2 || provider == -2:
            return csgInvalidationFail(
                "merkle_invalidation_source_hash_collision")
        if consumer == -3 || provider == -3:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_corrupt")
        if consumer == -4 || provider == -4:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_full")
        if consumer < -4 || provider < -4:
            return csgInvalidationFail(
                "merkle_invalidation_source_index_status_invalid")
        if consumer < 0 || provider < 0:
            return csgInvalidationFail(
                "merkle_invalidation_dependency_unknown_source")
        if consumer == provider:
            return csgInvalidationFail(
                "merkle_invalidation_dependency_self_edge")
        let edgeHash =
            csgInvalidationEdgeHash(edge)
        let edgeHash64 =
            csgInvalidationHash64(edgeHash)
        add(edgeHashes, edgeHash)
        var edgeBucket =
            int32(
                edgeHash64 &
                uint64(edgeIndexSlots.len - 1))
        var edgeInserted: bool
        for probe in 0..<edgeIndexSlots.len:
            let previousPlusOne =
                edgeIndexSlots[edgeBucket]
            if previousPlusOne == 0:
                edgeIndexSlots[edgeBucket] =
                    edgeIndex + 1
                edgeInserted = true
                break
            let previousIndex =
                previousPlusOne - 1
            if previousIndex < 0 ||
               previousIndex >= edgeIndex:
                return csgInvalidationFail(
                    "merkle_invalidation_dependency_index_corrupt")
            if layout.FixedBytes32Equal(
                   edgeHashes[previousIndex],
                   edgeHashes[edgeIndex]):
                if dependencies[previousIndex].consumerSource ==
                       edge.consumerSource &&
                   dependencies[previousIndex].providerSource ==
                       edge.providerSource &&
                   dependencies[previousIndex].selector ==
                       edge.selector:
                    if dependencies[
                           previousIndex].providerSubgraphCid ==
                       edge.providerSubgraphCid:
                        return csgInvalidationFail(
                            "merkle_invalidation_dependency_duplicate")
                    return csgInvalidationFail(
                        "merkle_invalidation_dependency_identity_conflict")
                return csgInvalidationFail(
                    "merkle_invalidation_dependency_hash_collision")
            edgeBucket = (edgeBucket + 1) &
                (edgeIndexSlots.len - 1)
        if !edgeInserted:
            return csgInvalidationFail(
                "merkle_invalidation_dependency_index_full")
        add(edgeConsumers, consumer)
        add(edgeProviders, provider)
        if reverseCounts[provider] >= dependencies.len:
            return csgInvalidationFail(
                "merkle_invalidation_reverse_count_overflow")
        reverseCounts[provider] =
            reverseCounts[provider] + 1
        add(
            dependencyLines,
            csgInvalidationDependencyLine(edge))

    var reverseOffsets: int32[]
    add(reverseOffsets, 0)
    for sourceIndex in 0..<sources.len:
        let nextOffset =
            int64(reverseOffsets[sourceIndex]) +
            int64(reverseCounts[sourceIndex])
        if nextOffset < 0 ||
           nextOffset > int64(dependencies.len):
            return csgInvalidationFail(
                "merkle_invalidation_reverse_offset_overflow")
        add(
            reverseOffsets,
            int32(nextOffset))
    if reverseOffsets[reverseOffsets.len - 1] !=
       dependencies.len:
        return csgInvalidationFail(
            "merkle_invalidation_reverse_count_mismatch")
    var reverseNext: int32[]
    for sourceIndex in 0..<sources.len:
        add(
            reverseNext,
            reverseOffsets[sourceIndex])
    var reverseConsumers: int32[]
    for edgeIndex in 0..<dependencies.len:
        add(reverseConsumers, -1)
    for edgeIndex in 0..<dependencies.len:
        let provider = edgeProviders[edgeIndex]
        let slot = reverseNext[provider]
        reverseConsumers[slot] =
            edgeConsumers[edgeIndex]
        reverseNext[provider] = slot + 1

    var queue: int32[]
    for sourceIndex in 0..<sources.len:
        if changedMask[sourceIndex]:
            add(queue, sourceIndex)
    var queueIndex: int32
    while queueIndex < queue.len:
        let provider = queue[queueIndex]
        queueIndex = queueIndex + 1
        var edgeSlot = reverseOffsets[provider]
        while edgeSlot <
              reverseOffsets[provider + 1]:
            let consumer =
                reverseConsumers[edgeSlot]
            if consumer < 0:
                return csgInvalidationFail(
                    "merkle_invalidation_reverse_csr_invalid")
            if !invalidatedMask[consumer]:
                invalidatedMask[consumer] = true
                add(queue, consumer)
            edgeSlot = edgeSlot + 1

    var changedOut: str[]
    var invalidatedOut: str[]
    var untouchedOut: str[]
    var invalidationLines: str[]
    var sourceSetLines: str[]
    for sourceIndex in 0..<sources.len:
        add(
            sourceSetLines,
            csgInvalidationSourceSetLine(
                sources[sourceIndex]))
        if changedMask[sourceIndex]:
            add(
                changedOut,
                strings.CloneStr(sources[sourceIndex]))
        if invalidatedMask[sourceIndex]:
            add(
                invalidatedOut,
                strings.CloneStr(sources[sourceIndex]))
            add(
                invalidationLines,
                csgInvalidationSourceLine(
                    sources[sourceIndex],
                    changedMask[sourceIndex]))
        else:
            add(
                untouchedOut,
                strings.CloneStr(sources[sourceIndex]))

    let dependencyDag =
        merkle_dag.CsgCoreMerkleBuild(
            dependencyLines)
    if !dependencyDag.ok:
        return csgInvalidationFail(
            csgInvalidationCat(
                "merkle_invalidation_dependency_root ",
                dependencyDag.error))
    let sourceSetDag =
        merkle_dag.CsgCoreMerkleBuild(
            sourceSetLines)
    if !sourceSetDag.ok:
        return csgInvalidationFail(
            csgInvalidationCat(
                "merkle_invalidation_source_set_root ",
                sourceSetDag.error))
    add(
        invalidationLines,
        csgInvalidationBindingLine(
            dependencyDag.subgraphCid,
            sourceSetDag.subgraphCid,
            changedOut.len,
            invalidatedOut.len,
            sources.len))
    let invalidationDag =
        merkle_dag.CsgCoreMerkleBuild(
            invalidationLines)
    if !invalidationDag.ok:
        return csgInvalidationFail(
            csgInvalidationCat(
                "merkle_invalidation_plan_root ",
                invalidationDag.error))

    var out: CsgCoreMerkleInvalidationResult
    out.ok = true
    out.dependencyRoot =
        strings.CloneStr(dependencyDag.subgraphCid)
    out.sourceSetRoot =
        strings.CloneStr(sourceSetDag.subgraphCid)
    out.invalidationRoot =
        strings.CloneStr(invalidationDag.subgraphCid)
    out.changedSources =
        CsgCoreMerkleInvalidationSorted(changedOut)
    out.invalidatedSources =
        CsgCoreMerkleInvalidationSorted(invalidatedOut)
    out.untouchedSources =
        CsgCoreMerkleInvalidationSorted(untouchedOut)
    out.dependencyCount = dependencies.len
    return out
