    else:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " unsupported oracle asset fact kind: ", kind))

@borrows
fn csgInnovationSha256CidValid(value: str): bool =
    if value.len != 71 ||
       !strings.HasPrefix(value, "sha256:"):
        return false
    for i in 7..<value.len:
        let ch = value[i]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn csgRequireInnovationSha256Field(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str) =
    let value = csgRequireStringField(
        result, lineNo, raw, kind, key)
    if value.len > 0 &&
       !csgInnovationSha256CidValid(value):
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " invalid sha256 field ", key)))

@borrows
fn csgRequireInnovationVectorField(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    csgFactFieldContractRegister(
        result, lineNo, "vectorValues")
    let rawField =
        jfield.CsgCoreJsonTopRawField(raw, "vectorValues")
    if !rawField.found:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " missing field vectorValues")))
        return
    let parsed = json.ParseJsonSafe(rawField.value)
    var dimension: int32
    if !parsed.success || parsed.value.kind != json.JArray ||
       parsed.value.a.len <= 0 ||
       parsed.value.a.len > 4096 ||
       !csgTryInt32Field(raw, "dimension", dimension) ||
       dimension != parsed.value.a.len:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " invalid vectorValues shape")))
        return
    var nonZero = false
    for i in 0..<parsed.value.a.len:
        if parsed.value.a[i].kind != json.JInt ||
           parsed.value.a[i].i < int64(-32767) ||
           parsed.value.a[i].i > int64(32767):
            csgAddError(
                result,
                csgCat4(
                    "line ", strings.IntToStr(lineNo), " ",
                    csgCat(kind, " invalid vectorValues component")))
            return
        if parsed.value.a[i].i != int64(0):
            nonZero = true
    if !nonZero:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " zero vectorValues are forbidden")))

@borrows
fn csgValidateInnovationEmbeddingVectorCid(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    let modelCid =
        jfield.CsgCoreJsonTopStringField(raw, "modelCid")
    let tokenizerCid =
        jfield.CsgCoreJsonTopStringField(raw, "tokenizerCid")
    let toolCid =
        jfield.CsgCoreJsonTopStringField(raw, "toolCid")
    let quantization =
        jfield.CsgCoreJsonTopStringField(raw, "quantization")
    let vectorCid =
        jfield.CsgCoreJsonTopStringField(raw, "vectorCid")
    let vectorField =
        jfield.CsgCoreJsonTopRawField(raw, "vectorValues")
    var dimension: int32
    var normalizationScale: int32
    if !modelCid.found || !tokenizerCid.found || !toolCid.found ||
       !quantization.found || !vectorCid.found || !vectorField.found ||
       !csgTryInt32Field(raw, "dimension", dimension) ||
       !csgTryInt32Field(raw, "normalizationScale", normalizationScale):
        return
    let parsed = json.ParseJsonSafe(vectorField.value)
    if !parsed.success || parsed.value.kind != json.JArray ||
       parsed.value.a.len != dimension:
        return
    var preimage = "schema=unimaker.innovation.embedding.vector.v1"
    preimage = csgCat3(preimage, "\n", modelCid.value)
    preimage = csgCat3(preimage, "\n", tokenizerCid.value)
    preimage = csgCat3(preimage, "\n", toolCid.value)
    preimage = csgCat3(
        preimage, "\n", strings.IntToStr(normalizationScale))
    preimage = csgCat3(preimage, "\n", quantization.value)
    preimage = csgCat3(preimage, "\n", strings.IntToStr(dimension))
    for valueIndex in 0..<parsed.value.a.len:
        if parsed.value.a[valueIndex].kind != json.JInt:
            return
        preimage = csgCat3(
            preimage, "\n",
            strings.Int64ToStr(parsed.value.a[valueIndex].i))
    let digest =
        sha256.Sha256Digest(rawbytes.BytesFromString(preimage))
    let expected =
        csgCat("sha256:", rawbytes.BytesToHex(digest))
    if vectorCid.value != expected:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " vectorCid does not bind vectorValues")))

@borrows
fn csgValidateInnovationClaimChartSemantics(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    var requiredCount: int32
    var matchedCount: int32
    let allRequired =
        jfield.CsgCoreJsonTopRawField(raw, "allRequiredCandidate")
    if !csgTryInt32Field(raw, "requiredCount", requiredCount) ||
       !csgTryInt32Field(raw, "matchedCount", matchedCount) ||
       !allRequired.found:
        return
    if matchedCount > requiredCount ||
       (csgRawFieldIsTrue(allRequired.value) !=
        (matchedCount == requiredCount)):
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " inconsistent claim chart counts")))

@borrows
fn csgRequireUnimakerProductFactFields(result: var CsgCoreValidationResult,
                                       lineNo: int32,
                                       raw: str,
                                       kind: str) =
    if kind == "csg_dialect::unimaker_product::certificate":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "productId")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
        csgRequireStringField(result, lineNo, raw, kind, "trustLevel")
        csgRequireStringField(result, lineNo, raw, kind, "productRoot")
        csgRequireStringField(result, lineNo, raw, kind, "oracleReceiptHash")
        csgRequireStringField(result, lineNo, raw, kind, "mediaAssetCid")
        csgRequireRawField(result, lineNo, raw, kind, "priceE8")
        csgRequireRawField(result, lineNo, raw, kind, "inventory")
        csgRequireRawField(result, lineNo, raw, kind, "validUntilMs")
        csgRequireStringField(result, lineNo, raw, kind, "receiptHash")
    elif kind == "csg_dialect::unimaker_product::innovation_document":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireInt32RangeField(result, lineNo, raw, kind, "documentKind", 1, 2)
        csgRequireStringField(result, lineNo, raw, kind, "externalId")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "titleHash")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "sourceCid")
        csgRequireStringField(result, lineNo, raw, kind, "sourceUri")
        csgRequireNonnegativeInt64Field(result, lineNo, raw, kind, "publicationDate")
        csgRequireNonnegativeInt64Field(result, lineNo, raw, kind, "priorityDate")
        csgRequireStringField(result, lineNo, raw, kind, "jurisdiction")
        csgRequireStringField(result, lineNo, raw, kind, "language")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "licenseHash")
        csgRequireStringField(result, lineNo, raw, kind, "semanticStatus")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
    elif kind == "csg_dialect::unimaker_product::innovation_claim":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "documentId")
        csgRequirePositiveInt32Field(result, lineNo, raw, kind, "claimNumber")
        csgRequireStringField(result, lineNo, raw, kind, "parentClaimId")
        csgRequireBoolField(result, lineNo, raw, kind, "independent")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "claimTextHash")
        csgRequireStringField(result, lineNo, raw, kind, "semanticStatus")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
    elif kind == "csg_dialect::unimaker_product::innovation_claim_element":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "claimId")
        csgRequireNonnegativeInt32Field(result, lineNo, raw, kind, "ordinal")
        csgRequireBoolField(result, lineNo, raw, kind, "required")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "elementTextHash")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "technicalEffectHash")
        csgRequireStringField(result, lineNo, raw, kind, "semanticStatus")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
    elif kind == "csg_dialect::unimaker_product::innovation_paper_contribution":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "documentId")
        csgRequireNonnegativeInt32Field(result, lineNo, raw, kind, "ordinal")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "contributionHash")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "methodHash")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "evidenceHash")
        csgRequireStringField(result, lineNo, raw, kind, "semanticStatus")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
    elif kind == "csg_dialect::unimaker_product::innovation_product_evidence":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "productId")
        csgRequireNonnegativeInt32Field(result, lineNo, raw, kind, "ordinal")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "evidenceHash")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "sourceCid")
        csgRequireNonnegativeInt64Field(result, lineNo, raw, kind, "observedAtMs")
        csgRequireStringField(result, lineNo, raw, kind, "semanticStatus")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
    elif kind == "csg_dialect::unimaker_product::innovation_embedding_receipt":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireInt32RangeField(result, lineNo, raw, kind, "targetKind", 1, 5)
        csgRequireStringField(result, lineNo, raw, kind, "targetId")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "sourceFactCid")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "modelCid")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "tokenizerCid")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "toolCid")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "vectorCid")
        csgRequirePositiveInt32Field(result, lineNo, raw, kind, "dimension")
        csgRequirePositiveInt32Field(result, lineNo, raw, kind, "normalizationScale")
        csgRequireStringField(result, lineNo, raw, kind, "quantization")
        csgRequireInnovationVectorField(result, lineNo, raw, kind)
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
        csgValidateInnovationEmbeddingVectorCid(result, lineNo, raw, kind)
    elif kind == "csg_dialect::unimaker_product::innovation_claim_chart":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "claimId")
        csgRequireStringField(result, lineNo, raw, kind, "productId")
        csgRequirePositiveInt32Field(result, lineNo, raw, kind, "requiredCount")
        csgRequireNonnegativeInt32Field(result, lineNo, raw, kind, "matchedCount")
        csgRequireBoolField(result, lineNo, raw, kind, "allRequiredCandidate")
        csgRequireTrueField(result, lineNo, raw, kind, "candidateOnly")
        csgRequireInt32RangeField(
            result, lineNo, raw, kind,
            "thresholdMicros", -1000000, 1000000)
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "corpusFactsRoot")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "modelCid")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "tokenizerCid")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "toolCid")
        csgRequireInt32RangeField(result, lineNo, raw, kind, "dimension", 1, 4096)
        csgRequirePositiveInt32Field(result, lineNo, raw, kind, "normalizationScale")
        csgRequireStringField(result, lineNo, raw, kind, "quantization")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "alignmentRoot")
        csgRequireInnovationSha256Field(result, lineNo, raw, kind, "receiptHash")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
        csgValidateInnovationClaimChartSemantics(result, lineNo, raw, kind)
    else:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " unsupported UniMaker product fact kind: ", kind))

@borrows
fn csgRequireVexaFactFields(result: var CsgCoreValidationResult,
                            lineNo: int32,
                            raw: str,
                            kind: str) =
    if kind == "csg_dialect::vexa::asset":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "assetKind")
        csgRequireStringField(result, lineNo, raw, kind, "sourceProfile")
        csgRequireStringField(result, lineNo, raw, kind, "subjectId")
        csgRequireStringField(result, lineNo, raw, kind, "trustLevel")
        csgRequireStringField(result, lineNo, raw, kind, "factRoot")
        csgRequireStringField(result, lineNo, raw, kind, "collateralHash")
        csgRequireStringField(result, lineNo, raw, kind, "capabilityHash")
        csgRequireStringField(result, lineNo, raw, kind, "riskHash")
        csgRequireRawField(result, lineNo, raw, kind, "eligibleForPlan")
        csgRequireStringField(result, lineNo, raw, kind, "reason")
    elif kind == "csg_dialect::vexa::deterministic_plan":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
        csgRequireStringField(result, lineNo, raw, kind, "assetId")
        csgRequireStringField(result, lineNo, raw, kind, "assetFactRoot")
        csgRequireStringField(result, lineNo, raw, kind, "actionKind")
        csgRequireStringField(result, lineNo, raw, kind, "preconditionHash")
        csgRequireStringField(result, lineNo, raw, kind, "capabilityHash")
        csgRequireStringField(result, lineNo, raw, kind, "riskHash")
        csgRequireRawField(result, lineNo, raw, kind, "createdAtMs")
        csgRequireRawField(result, lineNo, raw, kind, "validUntilMs")
        csgRequireStringField(result, lineNo, raw, kind, "planRoot")
        csgRequireStringField(result, lineNo, raw, kind, "proofHash")
    elif kind == "csg_dialect::vexa::execution_receipt":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "planRoot")
        csgRequireStringField(result, lineNo, raw, kind, "executorId")
        csgRequireStringField(result, lineNo, raw, kind, "executionStateHash")
        csgRequireStringField(result, lineNo, raw, kind, "outputStateHash")
        csgRequireRawField(result, lineNo, raw, kind, "executedAtMs")
        csgRequireStringField(result, lineNo, raw, kind, "status")
        csgRequireStringField(result, lineNo, raw, kind, "receiptHash")
    elif kind == "csg_dialect::vexa::recoverable_cell":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "factsRoot")
        csgRequireStringField(result, lineNo, raw, kind, "planRoot")
        csgRequireStringField(result, lineNo, raw, kind, "receiptHash")
        csgRequireStringField(result, lineNo, raw, kind, "stateRoot")
        csgRequireStringField(result, lineNo, raw, kind, "resumeTokenHash")
        csgRequireStringField(result, lineNo, raw, kind, "recoveryRoot")
        csgRequireTrueField(result, lineNo, raw, kind, "complete")
    else:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " unsupported Vexa fact kind: ", kind))

@borrows
