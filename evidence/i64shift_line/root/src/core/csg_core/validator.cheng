        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireRawField(result, lineNo, raw, kind, "chainId")
        csgRequireStringField(result, lineNo, raw, kind, "environmentHash")
        csgRequireStringField(result, lineNo, raw, kind, "executionSubstrateHash")
