@borrows
fn csgRequireExactJsonObjectFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        expected: str[]) =
    for expectedIndex in 0..<expected.len:
        csgFactFieldContractRegister(
            result, lineNo, expected[expectedIndex])
    let parsed = json.ParseJsonSafe(raw)
    if !parsed.success || parsed.value.kind != json.JObject:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " must be a JSON object")))
        return
    if parsed.value.okeys.len != expected.len:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " field set mismatch")))
        return
    for keyIndex in 0..<parsed.value.okeys.len:
        var allowed = false
        for expectedIndex in 0..<expected.len:
            if parsed.value.okeys[keyIndex] == expected[expectedIndex]:
                allowed = true
                break
        if !allowed:
            csgAddError(
                result,
                csgCat4(
                    "line ", strings.IntToStr(lineNo), " ",
                    csgCat(kind,
                           csgCat(" unknown field: ",
                                  parsed.value.okeys[keyIndex]))))
            return

@borrows
fn csgRequireCMigrationFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    if kind == "csg_dialect::c::translation_unit":
        let expected: str[] = [
            "functionCount", "id", "kind", "module", "path", "target"]
        csgRequireExactJsonObjectFields(
            result, lineNo, raw, kind, expected)
        csgRequireNonnegativeInt32Field(
            result, lineNo, raw, kind, "functionCount")
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(result, lineNo, raw, kind, "path")
        csgRequireStringField(result, lineNo, raw, kind, "target")
    elif kind == "csg_dialect::c::function":
        let expected: str[] = [
            "id", "kind", "module", "name", "qualType"]
        csgRequireExactJsonObjectFields(
            result, lineNo, raw, kind, expected)
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "qualType")
    else:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo),
                " unsupported C migration fact kind: ", kind))

@borrows
fn csgRequirePythonMigrationFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    if kind == "csg_dialect::python::module":
        let expected: str[] = [
            "bytecode", "entry", "id", "kind", "module",
            "pythonVersion", "symbolCount"]
        csgRequireExactJsonObjectFields(
            result, lineNo, raw, kind, expected)
        csgRequireRawField(result, lineNo, raw, kind, "bytecode")
        let bytecode =
            jfield.CsgCoreJsonTopRawField(raw, "bytecode")
        if bytecode.found:
            let parsedBytecode = json.ParseJsonSafe(bytecode.value)
            if !parsedBytecode.success ||
               parsedBytecode.value.kind != json.JArray:
                csgAddError(
                    result,
                    csgCat4(
                        "line ", strings.IntToStr(lineNo), " ",
                        csgCat(kind, " bytecode must be an array")))
        csgRequireStringField(result, lineNo, raw, kind, "entry")
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(
            result, lineNo, raw, kind, "pythonVersion")
        csgRequireNonnegativeInt32Field(
            result, lineNo, raw, kind, "symbolCount")
    else:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo),
                " unsupported Python migration fact kind: ", kind))

