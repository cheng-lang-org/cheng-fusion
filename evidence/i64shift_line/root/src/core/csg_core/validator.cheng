        csgRequireRawField(result, lineNo, raw, kind, "maxSubmitBlock")
        csgRequireStringField(result, lineNo, raw, kind, "broadcastPolicyHash")
        csgRequireStringField(result, lineNo, raw, kind, "requestHash")
    else:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " unsupported finance fact kind: ", kind))

@borrows
fn csgRequireAdditionalCoreFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    if kind == "csg.project":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "root")
        csgRequireRawField(
            result, lineNo, raw, kind, "sourceFileCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "runtimes")
        csgRequireRawField(
            result, lineNo, raw, kind, "compilerOptions")
    elif kind == "csg.import":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(
            result, lineNo, raw, kind, "classification")
        csgRequireStringField(result, lineNo, raw, kind, "runtime")
        csgRequireRawField(result, lineNo, raw, kind, "typeOnly")
        csgRequireRawField(result, lineNo, raw, kind, "named")
    elif kind == "csg.export":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        let named =
            jfield.CsgCoreJsonTopRawField(raw, "named")
        let assignment =
            jfield.CsgCoreJsonTopRawField(raw, "exportEquals")
        if named.found:
            csgRequireRawField(
                result, lineNo, raw, kind, "named")
            csgRequireRawField(
                result, lineNo, raw, kind, "typeOnly")
        elif assignment.found:
            csgRequireRawField(
                result, lineNo, raw, kind, "exportEquals")
            csgRequireStringField(
                result, lineNo, raw, kind, "expressionKind")
            csgRequireStringField(
                result, lineNo, raw, kind, "expressionText")
        else:
            if result.mode == CsgCoreModeStrict:
                # Sandbox parity with the legacy production binary: bare
                # re-export facts are tolerated outside strict admission.
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "csg.export requires named or exportEquals"))
    elif kind == "csg.type_decl":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "declKind")
        csgRequireRawField(result, lineNo, raw, kind, "members")
    elif kind == "csg.class":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "symbol")
        csgRequireRawField(
            result, lineNo, raw, kind, "typeParameters")
    elif kind == "csg.class_heritage":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "class")
        csgRequireStringField(
            result, lineNo, raw, kind, "heritageKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "expression")
        csgRequireRawField(
            result, lineNo, raw, kind, "typeArguments")
    elif kind == "csg.jsx":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        let jsxKind =
            csgRequireStringField(
                result, lineNo, raw, kind, "jsxKind")
        let tagName =
            csgRequireStringFieldAllowEmpty(
                result, lineNo, raw, kind, "tagName")
        if jsxKind == "JsxFragment":
            if tagName.len != 0:
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "csg.jsx fragment tagName must be empty"))
        elif tagName.len == 0:
            csgAddError(
                result,
                csgCat4(
                    "line ",
                    strings.IntToStr(lineNo),
                    " ",
                    "csg.jsx non-fragment tagName must be nonempty"))
        csgRequireRawField(result, lineNo, raw, kind, "props")
        csgRequireRawField(result, lineNo, raw, kind, "children")
    elif kind == "csg.inline_handler":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "propName")
        csgRequireStringField(
            result, lineNo, raw, kind, "expression")
        csgRequireStringField(
            result, lineNo, raw, kind, "handlerFn")
    elif kind == "csg.async_function":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "function")
        csgRequireStringField(result, lineNo, raw, kind, "runtime")
        csgRequireStringField(
            result, lineNo, raw, kind, "stateMachine")
    elif kind == "csg.call":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "calleeText")
        csgRequireStringField(
            result, lineNo, raw, kind, "calleeKind")
        csgRequireRawField(
            result, lineNo, raw, kind, "argumentCount")
        csgRequireStringField(
            result, lineNo, raw, kind, "returnType")
    elif kind == "csg.binding":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "declarationKind")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireRawField(result, lineNo, raw, kind, "path")
        csgRequireStringField(result, lineNo, raw, kind, "type")
    elif kind == "csg.type":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "typeKind")
        csgRequireStringField(result, lineNo, raw, kind, "text")
        csgRequireRawField(result, lineNo, raw, kind, "flags")
    elif kind == "csg.data":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "dataKind")
        csgRequireRawField(result, lineNo, raw, kind, "value")
    elif kind == "csg.block":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "function")
        csgRequireStringField(
            result, lineNo, raw, kind, "blockKind")
    elif kind == "csg.op":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "function")
        csgRequireStringField(result, lineNo, raw, kind, "block")
        csgRequireStringField(result, lineNo, raw, kind, "opKind")
    elif kind == "csg.debug_map":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireRawField(result, lineNo, raw, kind, "loc")
        csgRequireStringField(result, lineNo, raw, kind, "target")
    elif kind == "csg.term":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "function")
        csgRequireStringField(result, lineNo, raw, kind, "block")
        csgRequireStringField(
            result, lineNo, raw, kind, "termKind")
    else:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " unsupported core fact kind: ",
                kind))

@borrows
fn csgRequireWebMediaFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str): bool =
    if kind == "csg.web.media_asset":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        csgRequireStringField(result, lineNo, raw, kind, "bundleCid")
        csgRequireStringField(result, lineNo, raw, kind, "mime")
        csgRequireRawField(result, lineNo, raw, kind, "kindCode")
        csgRequireRawField(result, lineNo, raw, kind, "durationMs")
        csgRequireStringField(result, lineNo, raw, kind, "codec")
        csgRequireRawField(
            result, lineNo, raw, kind,
            "initSegmentByteLength")
        csgRequireStringField(
            result, lineNo, raw, kind, "transport")
        csgRequireStringField(
            result, lineNo, raw, kind, "fecScheme")
        csgRequireStringField(
            result, lineNo, raw, kind, "contentSignature")
        csgRequireStringField(result, lineNo, raw, kind, "catalogCid")
        csgRequireStringField(result, lineNo, raw, kind, "catalogKey")
        csgRequireStringField(
            result, lineNo, raw, kind, "rebuildTemplateCid")
        csgRequireStringField(
            result, lineNo, raw, kind, "rebuildTemplateKey")
        csgRequireRawField(
            result, lineNo, raw, kind, "objectTargetBytes")
        csgRequireRawField(
            result, lineNo, raw, kind, "sourceBlockBytes")
        csgRequireRawField(result, lineNo, raw, kind, "objectCount")
        csgRequireRawField(result, lineNo, raw, kind, "dropletCount")
        csgRequireRawField(result, lineNo, raw, kind, "objects")
        csgRequireRawField(result, lineNo, raw, kind, "droplets")
        return true
    if kind == "csg.web.media_playback_slot":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(result, lineNo, raw, kind, "assetFact")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        csgRequireStringField(result, lineNo, raw, kind, "manifestCid")
        csgRequireStringField(
            result, lineNo, raw, kind, "providerKind")
        csgRequireStringField(result, lineNo, raw, kind, "stateRef")
        csgRequireStringField(
            result, lineNo, raw, kind, "decodeProvider")
        csgRequireStringField(
            result, lineNo, raw, kind, "textureProvider")
        csgRequireStringField(
            result, lineNo, raw, kind, "audioProvider")
        return true
    if kind == "csg.web.media_control_action":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "payloadSchema")
        csgRequireStringField(result, lineNo, raw, kind, "dispatch")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        return true
    if kind == "csg.web.media_control_receipt":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "receiptCid")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        csgRequireRawField(result, lineNo, raw, kind, "kindCode")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "payloadSchema")
        csgRequireRawField(result, lineNo, raw, kind, "payload")
        csgRequireStringField(result, lineNo, raw, kind, "dispatch")
        csgRequireRawField(
            result, lineNo, raw, kind, "sourceStateCode")
        csgRequireRawField(
            result, lineNo, raw, kind, "resultStateCode")
        csgRequireRawField(result, lineNo, raw, kind, "statusCode")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        return true
    if kind == "csg.web.media_lifecycle_event":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        let eventKind =
            csgRequireStringField(
                result, lineNo, raw, kind, "eventKind")
        csgRequireStringField(result, lineNo, raw, kind, "eventCid")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        let bundleCid =
            csgRequireStringFieldAllowEmpty(
                result, lineNo, raw, kind, "bundleCid")
        csgRequireStringField(result, lineNo, raw, kind, "manifestCid")
        csgRequireRawField(result, lineNo, raw, kind, "kindCode")
        csgRequireStringField(
            result, lineNo, raw, kind, "payloadSchema")
        csgRequireRawField(result, lineNo, raw, kind, "payload")
        let transport =
            csgRequireStringFieldAllowEmpty(
                result, lineNo, raw, kind, "transport")
        if eventKind == "OpenAsset" ||
           eventKind == "PublishAsset":
            if bundleCid.len == 0 ||
               transport != "moq":
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "media open/publish event requires bundleCid and moq transport"))
        elif eventKind == "EditAsset" ||
             eventKind == "LoadedMetadata" ||
             eventKind == "Waiting" ||
             eventKind == "Playing" ||
             eventKind == "TimeUpdate" ||
             eventKind == "Ended":
            if transport.len != 0:
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "media edit/DOM lifecycle transport must be empty"))
        elif eventKind.len > 0:
            csgAddError(
                result,
                csgCat4(
                    "line ",
                    strings.IntToStr(lineNo),
                    " unsupported media lifecycle eventKind: ",
                    eventKind))
        csgRequireStringField(result, lineNo, raw, kind, "dispatch")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireRawField(
            result, lineNo, raw, kind, "sourceStateCode")
        csgRequireRawField(
            result, lineNo, raw, kind, "resultStateCode")
        csgRequireRawField(result, lineNo, raw, kind, "statusCode")
        csgRequireRawField(result, lineNo, raw, kind, "objectCount")
        csgRequireRawField(result, lineNo, raw, kind, "dropletCount")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        return true
    if kind == "csg.web.media_frame_receipt":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        let receiptKind =
            csgRequireStringField(
                result, lineNo, raw, kind, "receiptKind")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        csgRequireStringField(result, lineNo, raw, kind, "manifestCid")
        csgRequireRawField(result, lineNo, raw, kind, "kindCode")
        csgRequireRawField(result, lineNo, raw, kind, "firstFrameCid")
        csgRequireRawField(result, lineNo, raw, kind, "firstImageCid")
        csgRequireRawField(result, lineNo, raw, kind, "firstAudioCid")
        csgRequireRawField(result, lineNo, raw, kind, "audioDataCid")
        csgRequireRawField(result, lineNo, raw, kind, "bytesReady")
        csgRequireRawField(
            result, lineNo, raw, kind, "initSegmentCid")
        csgRequireRawField(
            result, lineNo, raw, kind, "initBytesReady")
        csgRequireRawField(result, lineNo, raw, kind, "sourceCode")
        csgRequireRawField(result, lineNo, raw, kind, "verified")
        let textureProvider =
            csgRequireStringFieldAllowEmpty(
                result, lineNo, raw, kind, "textureProvider")
        csgRequireRawField(
            result, lineNo, raw, kind, "textureHandle")
        csgRequireRawField(
            result, lineNo, raw, kind, "textureReady")
        csgRequireRawField(
            result, lineNo, raw, kind, "decodedWidth")
        csgRequireRawField(
            result, lineNo, raw, kind, "decodedHeight")
        csgRequireNonnegativeInt32Field(
            result, lineNo, raw, kind, "pixelFormat")
        csgRequireRawField(
            result, lineNo, raw, kind, "pixelBufferHandle")
        let audioProvider =
            csgRequireStringFieldAllowEmpty(
                result, lineNo, raw, kind, "audioProvider")
        if receiptKind == "Frame" ||
           receiptKind == "Image":
            if textureProvider.len == 0:
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "media frame/image receipt requires textureProvider"))
        elif receiptKind == "Audio":
            if audioProvider.len == 0:
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "media audio receipt requires audioProvider"))
        elif receiptKind.len > 0:
            csgAddError(
                result,
                csgCat4(
                    "line ",
                    strings.IntToStr(lineNo),
                    " unsupported media receiptKind: ",
                    receiptKind))
        csgRequireRawField(
            result, lineNo, raw, kind, "sampleRateHz")
        csgRequireRawField(
            result, lineNo, raw, kind, "channelCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "bitsPerSample")
        csgRequireRawField(
            result, lineNo, raw, kind, "pcmDataOffset")
        csgRequireRawField(
            result, lineNo, raw, kind, "pcmDataBytes")
        csgRequireRawField(
            result, lineNo, raw, kind, "startedAtMs")
        csgRequireRawField(result, lineNo, raw, kind, "elapsedMs")
        csgRequireRawField(
            result, lineNo, raw, kind, "openToMediaMs")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        return true
    if kind == "csg.web.media_receipt_identity":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(
            result, lineNo, raw, kind, "receiptFactId")
        csgRequireStringField(result, lineNo, raw, kind, "receiptCid")
        csgRequireStringField(
            result, lineNo, raw, kind, "receiptKind")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        csgRequireStringField(result, lineNo, raw, kind, "manifestCid")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        return true
    if kind == "csg.web.media_delivery_receipt":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "receiptCid")
        csgRequireStringField(
            result, lineNo, raw, kind, "receiptKind")
        csgRequireStringField(result, lineNo, raw, kind, "slotId")
        csgRequireStringField(result, lineNo, raw, kind, "assetCid")
        csgRequireStringField(result, lineNo, raw, kind, "bundleCid")
        csgRequireStringField(result, lineNo, raw, kind, "manifestCid")
        csgRequireRawField(result, lineNo, raw, kind, "kindCode")
        csgRequireStringField(
            result, lineNo, raw, kind, "transport")
        csgRequireStringField(
            result, lineNo, raw, kind, "publishEventCid")
        csgRequireStringField(
            result, lineNo, raw, kind, "openEventCid")
        csgRequireStringField(
            result, lineNo, raw, kind, "firstMediaCid")
        csgRequireRawField(result, lineNo, raw, kind, "sourceCode")
        csgRequireRawField(
            result, lineNo, raw, kind, "announcedBytes")
        csgRequireRawField(
            result, lineNo, raw, kind, "transferredBytes")
        csgRequireRawField(result, lineNo, raw, kind, "bytesReady")
        csgRequireRawField(result, lineNo, raw, kind, "objectCount")
        csgRequireRawField(result, lineNo, raw, kind, "dropletCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "remoteFetchMs")
        csgRequireRawField(
            result, lineNo, raw, kind, "openToMediaMs")
        csgRequireRawField(result, lineNo, raw, kind, "budgetMs")
        csgRequireRawField(result, lineNo, raw, kind, "statusCode")
        csgRequireRawField(result, lineNo, raw, kind, "verified")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        return true
    return false

@borrows
fn csgRequireWebSceneFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str): bool =
    if !csgStartsWith(kind, "csg.web.scene."):
        return false
    csgRequireStringField(result, lineNo, raw, kind, "id")
    if kind == "csg.web.scene.schema":
        csgRequireStringField(result, lineNo, raw, kind, "schema")
        csgRequireRawField(result, lineNo, raw, kind, "features")
    elif kind == "csg.web.scene.project":
        csgRequireStringField(
            result, lineNo, raw, kind, "runtimeTarget")
        csgRequireRawField(result, lineNo, raw, kind, "routeCount")
        csgRequireRawField(result, lineNo, raw, kind, "width")
        csgRequireRawField(result, lineNo, raw, kind, "height")
        csgRequireRawField(result, lineNo, raw, kind, "nodeCount")
        csgRequireRawField(result, lineNo, raw, kind, "propCount")
        csgRequireRawField(result, lineNo, raw, kind, "styleCount")
        csgRequireRawField(result, lineNo, raw, kind, "layoutCount")
        csgRequireRawField(result, lineNo, raw, kind, "paintCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "resourceCount")
        csgRequireRawField(result, lineNo, raw, kind, "layerCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "mediaAssetCount")
        csgRequireRawField(
            result, lineNo, raw, kind,
            "mediaPlaybackSlotCount")
        csgRequireRawField(
            result, lineNo, raw, kind,
            "mediaControlActionCount")
    elif kind == "csg.web.scene.state_default":
        csgRequireStringField(
            result, lineNo, raw, kind, "stateRef")
        csgRequireRawField(result, lineNo, raw, kind, "value")
    elif kind == "csg.web.scene.route":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireRawField(result, lineNo, raw, kind, "width")
        csgRequireRawField(result, lineNo, raw, kind, "height")
        csgRequireRawField(result, lineNo, raw, kind, "childCount")
        csgRequireRawField(result, lineNo, raw, kind, "layerCount")
        csgRequireRawField(result, lineNo, raw, kind, "root")
    elif kind == "csg.web.scene.node":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireNonnegativeInt32Field(
            result, lineNo, raw, kind, "parentNodeId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        let nodeKind =
            csgRequireStringField(
                result, lineNo, raw, kind, "nodeKind")
        csgRequireRawField(result, lineNo, raw, kind, "childCount")
        csgRequireRawField(result, lineNo, raw, kind, "propCount")
        csgRequireRawField(result, lineNo, raw, kind, "styleCount")
        csgRequireRawField(result, lineNo, raw, kind, "layoutCount")
        csgRequireRawField(result, lineNo, raw, kind, "paintCount")
        csgRequireRawField(result, lineNo, raw, kind, "layerId")
        if nodeKind == "text":
            csgRequireRawField(result, lineNo, raw, kind, "text")
        elif nodeKind == "element":
            csgRequireStringField(
                result, lineNo, raw, kind, "tagName")
        elif nodeKind != "fragment" &&
             nodeKind.len > 0:
            csgAddError(
                result,
                csgCat4(
                    "line ",
                    strings.IntToStr(lineNo),
                    " unsupported scene nodeKind: ",
                    nodeKind))
    elif kind == "csg.web.scene.event_handler":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireRawField(
            result, lineNo, raw, kind, "propOrdinal")
        csgRequireStringField(result, lineNo, raw, kind, "propName")
        csgRequireStringField(
            result, lineNo, raw, kind, "eventName")
        csgRequireRawField(result, lineNo, raw, kind, "handler")
        csgRequireStringField(
            result, lineNo, raw, kind, "valueKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionKind")
        csgRequireRawField(result, lineNo, raw, kind, "effect")
        csgRequireRawField(result, lineNo, raw, kind, "data")
    elif kind == "csg.web.scene.layer":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequireRawField(result, lineNo, raw, kind, "layerId")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
    elif kind == "csg.web.scene.prop" ||
         kind == "csg.web.scene.style" ||
        kind == "csg.web.scene.layout":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireStringField(result, lineNo, raw, kind, "propName")
        csgRequireRawField(result, lineNo, raw, kind, "propValue")
        csgRequireStringField(
            result, lineNo, raw, kind, "valueKind")
    elif kind == "csg.web.scene.component_prop":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequireStringField(
            result, lineNo, raw, kind, "component")
        csgRequireStringField(result, lineNo, raw, kind, "propName")
        csgRequireStringField(
            result, lineNo, raw, kind, "valueKind")
        csgRequireRawField(result, lineNo, raw, kind, "mount")
    elif kind == "csg.web.scene.css_utility" ||
         kind == "csg.web.scene.css_variant_rule":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireRawField(
            result, lineNo, raw, kind, "propOrdinal")
        csgRequireStringField(result, lineNo, raw, kind, "propName")
        csgRequireStringField(
            result, lineNo, raw, kind, "className")
        csgRequireStringField(
            result, lineNo, raw, kind, "valueKind")
        csgRequireRawField(result, lineNo, raw, kind, "data")
    elif kind == "csg.web.scene.hit_target":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionName")
    elif kind == "csg.web.scene.route_edge":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetRouteId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
    elif kind == "csg.web.scene.route_hit_rect":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetRouteId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireRawField(result, lineNo, raw, kind, "x")
        csgRequireRawField(result, lineNo, raw, kind, "y")
        csgRequireRawField(result, lineNo, raw, kind, "width")
        csgRequireRawField(result, lineNo, raw, kind, "height")
    elif kind == "csg.web.scene.paint":
        csgRequireStringField(result, lineNo, raw, kind, "routeId")
        csgRequireRawField(result, lineNo, raw, kind, "routeIndex")
        csgRequirePositiveInt32Field(
            result, lineNo, raw, kind, "nodeId")
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireStringField(result, lineNo, raw, kind, "opKind")
    elif kind == "csg.web.scene.resource":
        csgRequireRawField(result, lineNo, raw, kind, "ordinal")
        csgRequireStringField(
            result, lineNo, raw, kind, "resourceKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "resourceId")
        csgRequireStringField(result, lineNo, raw, kind, "hash")
        csgRequireRawField(result, lineNo, raw, kind, "byteSize")
    else:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " unsupported scene fact kind: ",
                kind))
    return true

@borrows
fn csgRequireWebFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    if csgRequireWebMediaFactFields(
           result, lineNo, raw, kind):
        return
    if csgRequireWebSceneFactFields(
           result, lineNo, raw, kind):
        return
    if kind == "csg.web.schema":
        csgRequireStringField(
            result, lineNo, raw, kind, "language")
        csgRequireStringField(result, lineNo, raw, kind, "schema")
        csgRequireRawField(result, lineNo, raw, kind, "features")
        csgRequireStringField(result, lineNo, raw, kind, "extends")
        return

    csgRequireStringField(result, lineNo, raw, kind, "id")
    if kind == "csg.web.project":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreSchema")
        csgRequireStringField(
            result, lineNo, raw, kind, "projectRoot")
        csgRequireRawField(result, lineNo, raw, kind, "runtimes")
        csgRequireRawField(result, lineNo, raw, kind, "entryRoots")
        csgRequireStringField(
            result, lineNo, raw, kind, "engineDependency")
        csgRequireStringField(
            result, lineNo, raw, kind, "runtimeTarget")
        csgRequireRawField(
            result, lineNo, raw, kind, "coreFactCount")
    elif kind == "csg.web.module_import_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(result, lineNo, raw, kind, "runtime")
    elif kind == "csg.web.js_function_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireRawField(result, lineNo, raw, kind, "async")
        csgRequireRawField(result, lineNo, raw, kind, "generator")
        csgRequireRawField(result, lineNo, raw, kind, "exported")
        csgRequireRawField(
            result, lineNo, raw, kind, "parameters")
        csgRequireStringField(
            result, lineNo, raw, kind, "returnType")
    elif kind == "csg.web.js_call_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetText")
        csgRequireRawField(
            result, lineNo, raw, kind, "argumentCount")
    elif kind == "csg.web.js_class_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "symbol")
        csgRequireRawField(result, lineNo, raw, kind, "exported")
        csgRequireRawField(result, lineNo, raw, kind, "abstract")
        csgRequireRawField(
            result, lineNo, raw, kind, "typeParameters")
        csgRequireRawField(
            result, lineNo, raw, kind, "heritageCount")
    elif kind == "csg.web.js_class_heritage_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(result, lineNo, raw, kind, "class")
        csgRequireStringField(
            result, lineNo, raw, kind, "heritageKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "expression")
        csgRequireRawField(
            result, lineNo, raw, kind, "typeArguments")
    elif kind == "csg.web.jsx_element":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        let jsxKind =
            csgRequireStringField(
                result, lineNo, raw, kind, "jsxKind")
        let tagName =
            csgRequireStringFieldAllowEmpty(
                result, lineNo, raw, kind, "tagName")
        if jsxKind == "JsxFragment":
            if tagName.len != 0:
                csgAddError(
                    result,
                    csgCat4(
                        "line ",
                        strings.IntToStr(lineNo),
                        " ",
                        "csg.web.jsx_element fragment tagName must be empty"))
        elif tagName.len == 0:
            csgAddError(
                result,
                csgCat4(
                    "line ",
                    strings.IntToStr(lineNo),
                    " ",
                    "csg.web.jsx_element non-fragment tagName must be nonempty"))
        csgRequireRawField(
            result, lineNo, raw, kind, "attributeCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "childCount")
        csgRequireRawField(result, lineNo, raw, kind, "props")
        csgRequireRawField(result, lineNo, raw, kind, "children")
        csgRequireStringField(
            result, lineNo, raw, kind, "lowering")
    elif kind == "csg.web.dom_node_template":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireRawField(result, lineNo, raw, kind, "owner")
        csgRequireStringField(
            result, lineNo, raw, kind, "tagName")
        csgRequireStringField(
            result, lineNo, raw, kind, "nodeKind")
        csgRequireStringField(result, lineNo, raw, kind, "domain")
        csgRequireRawField(
            result, lineNo, raw, kind, "attributeCount")
        csgRequireRawField(
            result, lineNo, raw, kind, "childCount")
        csgRequireRawField(result, lineNo, raw, kind, "props")
        csgRequireRawField(result, lineNo, raw, kind, "children")
        csgRequireStringField(
            result, lineNo, raw, kind, "runtimeTarget")
    elif kind == "csg.web.runtime_requirement":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreRequirement")
        csgRequireStringField(result, lineNo, raw, kind, "domain")
        csgRequireStringField(
            result, lineNo, raw, kind, "requirementKind")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "runtime")
        csgRequireStringField(result, lineNo, raw, kind, "source")
        csgRequireStringField(
            result, lineNo, raw, kind, "providerStatus")
    elif kind == "csg.web.external_symbol":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreExternalSymbol")
        csgRequireStringField(result, lineNo, raw, kind, "domain")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "runtime")
        csgRequireStringField(result, lineNo, raw, kind, "source")
        csgRequireStringField(
            result, lineNo, raw, kind, "providerStatus")
    elif kind == "csg.web.unsupported_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(result, lineNo, raw, kind, "code")
        csgRequireStringField(result, lineNo, raw, kind, "message")
        result.unsupportedCount =
            result.unsupportedCount + 1
        if result.mode == CsgCoreModeStrict:
            csgAddError(
                result,
                csgCat(
                    "unsupported Web semantic not allowed in strict mode: ",
                    kind))
    elif kind == "csg.web.control_surface":
        csgRequireRawField(result, lineNo, raw, kind, "coreFact")
        csgRequireStringField(
            result, lineNo, raw, kind, "nodeTemplate")
        csgRequireRawField(result, lineNo, raw, kind, "owner")
        csgRequireStringField(result, lineNo, raw, kind, "role")
        csgRequireStringField(result, lineNo, raw, kind, "label")
        csgRequireStringField(
            result, lineNo, raw, kind, "stateRef")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionKind")
        csgRequireRawField(
            result, lineNo, raw, kind, "routeTarget")
        csgRequireStringField(
            result, lineNo, raw, kind, "payloadSchema")
        csgRequireStringField(result, lineNo, raw, kind, "effect")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        csgRequireStringField(
            result, lineNo, raw, kind, "sourceFile")
        csgRequireRawField(
            result, lineNo, raw, kind, "sourceLine")
    elif kind == "csg.web.voice_computer_use_scenario":
        csgRequireStringField(
            result, lineNo, raw, kind, "controlSurface")
        csgRequireStringField(
            result, lineNo, raw, kind, "nodeTemplate")
        csgRequireStringField(
            result, lineNo, raw, kind, "scenarioKind")
        csgRequireStringField(result, lineNo, raw, kind, "role")
        csgRequireStringField(result, lineNo, raw, kind, "label")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "payloadSchema")
        csgRequireStringField(
            result, lineNo, raw, kind, "utteranceTemplate")
        csgRequireStringField(
            result, lineNo, raw, kind, "computerUseMode")
        csgRequireStringField(
            result, lineNo, raw, kind, "automationPath")
        csgRequireStringField(
            result, lineNo, raw, kind, "eventEffect")
        csgRequireStringField(result, lineNo, raw, kind, "dispatch")
        csgRequireRawField(
            result, lineNo, raw, kind, "visualClickFallback")
        csgRequireStringField(
            result, lineNo, raw, kind, "hardFailReason")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
    elif kind == "csg.web.computer_use_action":
        csgRequireStringField(
            result, lineNo, raw, kind, "controlSurface")
        csgRequireStringField(
            result, lineNo, raw, kind, "semanticId")
        csgRequireStringField(
            result, lineNo, raw, kind, "nodeTemplate")
        csgRequireRawField(result, lineNo, raw, kind, "owner")
        csgRequireStringField(result, lineNo, raw, kind, "role")
        csgRequireStringField(result, lineNo, raw, kind, "label")
        csgRequireStringField(
            result, lineNo, raw, kind, "actionKind")
        csgRequireRawField(
            result, lineNo, raw, kind, "routeTarget")
        csgRequireStringField(
            result, lineNo, raw, kind, "payloadSchema")
        csgRequireStringField(
            result, lineNo, raw, kind, "effectClass")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
        csgRequireStringField(result, lineNo, raw, kind, "dispatch")
        csgRequireRawField(
            result, lineNo, raw, kind, "visualClickFallback")
        csgRequireStringField(
            result, lineNo, raw, kind, "sourceFile")
        csgRequireRawField(
            result, lineNo, raw, kind, "sourceLine")
    elif kind == "csg.web.voice_task_template":
        csgRequireStringField(
            result, lineNo, raw, kind, "templateId")
        csgRequireStringField(
            result, lineNo, raw, kind, "taskKind")
        csgRequireRawField(
            result, lineNo, raw, kind, "utterancePatterns")
        csgRequireRawField(result, lineNo, raw, kind, "stepIds")
        csgRequireStringField(
            result, lineNo, raw, kind, "riskPolicy")
    elif kind == "csg.web.voice_task_step":
        csgRequireStringField(
            result, lineNo, raw, kind, "templateId")
        csgRequireRawField(
            result, lineNo, raw, kind, "stepIndex")
        csgRequireStringField(
            result, lineNo, raw, kind, "computerUseAction")
        csgRequireStringField(
            result, lineNo, raw, kind, "semanticId")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetActionKind")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetRole")
        csgRequireStringField(
            result, lineNo, raw, kind, "targetLabel")
        csgRequireRawField(
            result, lineNo, raw, kind, "targetSourceFile")
        csgRequireRawField(
            result, lineNo, raw, kind, "payloadBinding")
        csgRequireStringField(
            result, lineNo, raw, kind, "effectClass")
        csgRequireRawField(
            result, lineNo, raw, kind, "confirmationRequired")
        csgRequireRawField(
            result, lineNo, raw, kind, "confirmationGateId")
        csgRequireRawField(
            result, lineNo, raw, kind, "confirmationMode")
        csgRequireRawField(
            result, lineNo, raw, kind, "blockedUntilConfirmed")
        csgRequireStringField(result, lineNo, raw, kind, "guard")
        csgRequireStringField(result, lineNo, raw, kind, "trace")
    elif kind == "csg.web.confirmation_gate":
        csgRequireStringField(
            result, lineNo, raw, kind, "voiceTaskStep")
        csgRequireStringField(
            result, lineNo, raw, kind, "templateId")
        csgRequireStringField(
            result, lineNo, raw, kind, "computerUseAction")
        csgRequireStringField(
            result, lineNo, raw, kind, "semanticId")
        csgRequireStringField(
            result, lineNo, raw, kind, "effectClass")
        csgRequireStringField(
            result, lineNo, raw, kind, "confirmationMode")
        csgRequireRawField(
            result, lineNo, raw, kind, "blockedUntilConfirmed")
        csgRequireStringField(
            result, lineNo, raw, kind, "confirmIntent")
    elif kind == "csg.web.subgraph_cid":
        csgRequireStringField(
            result, lineNo, raw, kind, "sourceFact")
        csgRequireStringField(
            result, lineNo, raw, kind, "sourceKind")
        csgRequireStringField(result, lineNo, raw, kind, "cid")
        csgRequireRawField(result, lineNo, raw, kind, "target")
    elif kind == "csg.web.surface_owner":
        csgRequireStringField(
            result, lineNo, raw, kind, "surface")
        csgRequireStringField(
            result, lineNo, raw, kind, "ownerFile")
        csgRequireRawField(result, lineNo, raw, kind, "isKey")
    elif kind == "csg.web.truth_ref":
        csgRequireStringField(
            result, lineNo, raw, kind, "surface")
        csgRequireStringField(
            result, lineNo, raw, kind, "nodeRef")
        csgRequireStringField(
            result, lineNo, raw, kind, "ownerFact")
        csgRequireOptionalStringField(
            result, lineNo, raw, kind, "geometryRef")
        csgRequireOptionalStringField(
            result, lineNo, raw, kind, "cssRef")
        csgRequireOptionalStringField(
            result, lineNo, raw, kind, "screenshotRef")
    elif kind == "csg.web.pixel_region":
        csgRequireStringField(
            result, lineNo, raw, kind, "surface")
        csgRequireStringField(result, lineNo, raw, kind, "region")
        csgRequireRawField(result, lineNo, raw, kind, "x")
        csgRequireRawField(result, lineNo, raw, kind, "y")
        csgRequireRawField(result, lineNo, raw, kind, "width")
        csgRequireRawField(result, lineNo, raw, kind, "height")
        csgRequireStringField(
            result, lineNo, raw, kind, "ownerFact")
    else:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " unsupported Web fact kind: ",
                kind))

@borrows
fn csgCoreValidateFactLinesInto(
        lines: str[],
        mode: str,
        dag: var merkle_dag.CsgCoreMerkleDag,
        localNamedReplacementOnly: bool = false,
        canonicalLinesProven: bool = false): CsgCoreValidationResult =
    var result: CsgCoreValidationResult
    result.valid = true
    result.mode = strings.stringsNewStringCopy(mode.data, mode.len)
    result.standard = CsgCoreStandardIdentity()
    result.schema = CsgCoreSchemaNameIdentity()
    result.schemaNamespace = CsgCoreSchemaNamespaceIdentity()
    result.runtimeRequirementsStatus =
        CsgCoreRuntimeRequirementsSatisfied
    result.complete = true
    if mode != CsgCoreModeStrict && mode != CsgCoreModeSandbox:
        csgAddError(result, csgCat("invalid CSG validate mode: ", mode))
        return result

    var hasCoreSchema: bool
    var compilerSnapshotSchemaFeatureKind: int32
    var compilerSnapshotFactFamily: int32
    var idx: int32
    for idx in idx..<lines.len:
        let lineNo = idx + 1
        let rawLine = lines[idx]
        # blank line: nothing to validate, fall through to next line (empty
        # `if` suite is spec-illegal — positive-condition form, same semantics).
        if rawLine.len != 0 &&
           (!csgStartsWith(rawLine, "{") || !csgContains(rawLine, "}")):
            csgAddError(result, csgCat("line ", csgCat(strings.IntToStr(lineNo), " is not a JSON object fact")))
        elif rawLine.len != 0:
            csgFactFieldContractBegin(result, lineNo)
            let kindValue = jfield.CsgCoreJsonKind(rawLine)
            let kind: str = kindValue.value
            if kind == "":
                csgAddError(result, csgCat("line ", csgCat(strings.IntToStr(lineNo), " missing string field kind")))
            else:
                let idValue = jfield.CsgCoreJsonId(rawLine)
                if idValue.found:
                    if idValue.value.len == 0:
                        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat(kind, " empty id")))
                result.factCount = result.factCount + 1
                let completeValue =
                    jfield.CsgCoreJsonTopRawField(
                        rawLine, "complete")
                if completeValue.found:
                    if csgRawFieldIsFalse(completeValue.value):
                        csgFactFieldContractRegister(
                            result, lineNo, "complete")
                        result.complete = false
                        if result.mode == CsgCoreModeStrict:
                            csgAddError(
                                result,
                                csgCat4(
                                    "line ",
                                    strings.IntToStr(lineNo),
                                    " ",
                                    csgCat(
                                        kind,
                                        " complete=false not allowed in strict mode")))
                    elif !csgRawFieldIsTrue(completeValue.value):
                        csgFactFieldContractRegister(
                            result, lineNo, "complete")
                        csgAddError(
                            result,
                            csgCat4(
                                "line ",
                                strings.IntToStr(lineNo),
                                " ",
                                csgCat(
                                    kind,
                                    " complete field must be boolean")))
                if kind == "csg.runtime_requirement" ||
                   kind == "csg.web.runtime_requirement":
                    result.runtimeRequirementCount =
                        result.runtimeRequirementCount + 1
                    result.runtimeRequirementsStatus =
                        CsgCoreRuntimeRequirementsOpen
                    result.complete = false
                    if result.mode == CsgCoreModeStrict:
                        csgAddError(
                            result,
                            csgCat4(
                                "line ",
                                strings.IntToStr(lineNo),
                                " ",
                                csgCat(
                                    kind,
                                    " open runtime requirement not allowed in strict mode")))
                if kind == "csg.core.schema":
                    hasCoreSchema = true
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "id")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "language")
                    let schema = csgRequireStringField(result, lineNo, rawLine, kind, "schema")
                    if schema != CsgCoreSchemaNameIdentity():
                        csgAddError(result, csgCat("csg.core.schema must declare schema=", CsgCoreSchemaNameIdentity()))
                    csgRequireRawField(result, lineNo, rawLine, kind, "features")
                    csgRequireCanonicalCoreSchemaFeatures(
                        result, lineNo, rawLine, kind)
                    let features = jfield.CsgCoreJsonTopRawField(
                        rawLine, "features")
                    if features.found && features.value ==
                           "[\"compiler_semantic_snapshot\"]":
                        compilerSnapshotSchemaFeatureKind = 1
                    elif features.found && features.value ==
                           "[\"compiler_semantic_snapshot_failure\"]":
                        compilerSnapshotSchemaFeatureKind = 2
                elif kind == "csg.module":
                    csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    csgRequireStringField(result, lineNo, rawLine, kind, "path")
                    csgRequireStringField(result, lineNo, rawLine, kind, "sha256")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "file")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "name")
                elif kind == "csg.symbol":
                    csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    csgRequireStringField(result, lineNo, rawLine, kind, "name")
                    csgRequireStringField(result, lineNo, rawLine, kind, "symbolKind")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "caller")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "file")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "fqName")
                    csgRequireOptionalStringField(
                        result, lineNo, rawLine, kind, "symbol")
                    csgRequireOptionalBoolField(
                        result, lineNo, rawLine, kind, "exported")
                    csgRequireOptionalPositionObjectField(
                        result, lineNo, rawLine, kind,
                        "loc", "column")
                elif kind == "csg.function":
                    csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    csgRequireStringField(result, lineNo, rawLine, kind, "name")
                    csgRequireStringField(result, lineNo, rawLine, kind, "symbol")
                    csgRequireStringField(result, lineNo, rawLine, kind, "returnType")
                    csgRequireOptionalBoolField(
                        result, lineNo, rawLine, kind, "abiExport")
                    csgRequireOptionalBoolField(
                        result, lineNo, rawLine, kind, "exported")
                    csgRequireOptionalPositionObjectField(
                        result, lineNo, rawLine, kind,
                        "loc", "column")
                    csgRequireParametersField(
                        result, lineNo, rawLine, kind)
                elif kind == "csg.runtime_requirement":
                    csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    csgRequireStringField(result, lineNo, rawLine, kind, "name")
                    csgRequireStringField(result, lineNo, rawLine, kind, "runtime")
                    csgRequireStringField(result, lineNo, rawLine, kind, "source")
                    csgRequireStringField(result, lineNo, rawLine, kind, "requirementKind")
                elif kind == "csg.external_symbol":
                    csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    csgRequireStringField(result, lineNo, rawLine, kind, "name")
                    csgRequireStringField(result, lineNo, rawLine, kind, "runtime")
                    csgRequireStringField(result, lineNo, rawLine, kind, "source")
                elif kind == "csg.unsupported":
                    let unsupportedId =
                        csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    csgRequireStringField(result, lineNo, rawLine, kind, "code")
                    csgRequireStringField(result, lineNo, rawLine, kind, "message")
                    result.unsupportedCount = result.unsupportedCount + 1
                    if result.mode == CsgCoreModeStrict:
                        if unsupportedId.len > 0:
                            csgAddError(result, csgCat("unsupported semantic not allowed in strict mode: ", unsupportedId))
                        else:
                            csgAddError(result, "unsupported semantic not allowed in strict mode: unknown")
                elif kind == "csg_core::tombstone":
                    let tombstoneId = csgRequireStringField(result, lineNo, rawLine, kind, "id")
                    let schema = csgRequireStringField(result, lineNo, rawLine, kind, "schema")
                    csgRequireStringField(result, lineNo, rawLine, kind, "reason")
                    csgRequireStringField(result, lineNo, rawLine, kind, "original_text_hash")
                    csgRequireStringField(result, lineNo, rawLine, kind, "impact_scope")
                    csgRequireOptionalPositionObjectField(
                        result, lineNo, rawLine, kind,
                        "source_span", "col")
                    if schema != CsgCoreSchemaNameIdentity():
                        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " csg_core::tombstone schema must be ", CsgCoreSchemaNameIdentity()))
                    result.tombstoneCount = result.tombstoneCount + 1
                    if result.mode == CsgCoreModeStrict:
                        if tombstoneId.len > 0:
                            csgAddError(result, csgCat("tombstone not allowed in strict mode: ", tombstoneId))
                        else:
                            csgAddError(result, "tombstone not allowed in strict mode: unknown")
                elif csgStartsWith(kind,
                                   "csg_dialect::c::"):
                    csgRequireCMigrationFactFields(
                        result, lineNo, rawLine, kind)
                elif csgStartsWith(kind,
                                   "csg_dialect::cheng_compiler::"):
                    let factFamily =
                        csgChengCompilerFailureFactKind(kind) ? 2 : 1
                    if compilerSnapshotFactFamily == 0:
                        compilerSnapshotFactFamily = factFamily
                    elif compilerSnapshotFactFamily != factFamily:
                        csgAddError(
                            result,
                            "mixed compiler snapshot fact families")
                    csgRequireChengCompilerFactFields(result, lineNo,
                                                      rawLine, kind)
                elif csgStartsWith(kind,
                                   "csg_dialect::python::"):
                    csgRequirePythonMigrationFactFields(
                        result, lineNo, rawLine, kind)
                elif csgStartsWith(kind,
                                   "csg_dialect::native::"):
                    csgRequireNativeFactFields(
                        result, lineNo, rawLine, kind)
                elif csgStartsWith(kind, "csg_dialect::finance::"):
                    csgRequireFinanceFactFields(result, lineNo, rawLine, kind)
                elif csgStartsWith(kind, "csg_dialect::oracle_asset::"):
                    csgRequireOracleAssetFactFields(result, lineNo, rawLine, kind)
                elif csgStartsWith(kind, "csg_dialect::unimaker_product::"):
                    csgRequireUnimakerProductFactFields(result, lineNo, rawLine, kind)
                elif csgStartsWith(kind, "csg_dialect::vexa::"):
                    csgRequireVexaFactFields(result, lineNo, rawLine, kind)
                elif csgStartsWith(kind, "csg.web."):
                    csgRequireWebFactFields(
                        result, lineNo, rawLine, kind)
                elif csgStartsWith(kind, "csg."):
                    csgRequireAdditionalCoreFactFields(
                        result, lineNo, rawLine, kind)
                else:
                    csgAddError(
                        result,
                        csgCat4(
                            "line ",
                            strings.IntToStr(lineNo),
                            " unsupported fact kind: ",
                            kind))
            csgFactFieldContractFinish(
                result, lineNo, rawLine, kind)
            add(
                result.factExactKinds,
                strings.CloneStr(kind))
            add(
                result.factReplacementScopes,
                csgCoreReplacementScopeForExactKind(kind))

    if result.factExactKinds.len != result.factCount ||
       result.factReplacementScopes.len != result.factCount:
        csgAddError(
            result,
            "replacement policy issuance does not cover every exact fact kind")
    if result.factCount == 0:
        csgAddError(result, "no CSG facts found")
    if !localNamedReplacementOnly && !hasCoreSchema:
        csgAddError(result, "missing csg.core.schema fact")
    if !localNamedReplacementOnly &&
       compilerSnapshotFactFamily != 0 &&
       (compilerSnapshotSchemaFeatureKind == 0 ||
        compilerSnapshotSchemaFeatureKind != compilerSnapshotFactFamily):
        csgAddError(
            result,
            "compiler snapshot schema feature is not canonical")
    if !localNamedReplacementOnly && result.valid &&
       compilerSnapshotSchemaFeatureKind == 1 &&
       compilerSnapshotFactFamily == 1:
        var wireErr: str
        if !CsgCoreValidateChengCompilerSnapshotWireInto(lines, wireErr):
            csgAddError(result, wireErr)
    if !localNamedReplacementOnly && result.valid &&
       compilerSnapshotSchemaFeatureKind == 2 &&
       compilerSnapshotFactFamily == 2:
        var failureWireErr: str
        if !csgCompilerDiagnosticFailureWireValidateInto(
                lines, failureWireErr):
            csgAddError(result, failureWireErr)
    if result.unsupportedCount > 0 ||
       result.tombstoneCount > 0 ||
       result.runtimeRequirementCount > 0:
        result.complete = false
    if !result.valid:
        result.complete = false
    if result.valid && !localNamedReplacementOnly:
        if canonicalLinesProven:
            dag = CsgCoreMerkleBuildBoundFromCanonicalLines(lines)
        else:
            dag = CsgCoreMerkleBuildBoundFromLines(lines)
        if !dag.ok:
            csgAddError(
                result,
                csgCat(
                    "Merkle admission failed: ",
                    dag.error))
            result.complete = false
        else:
            result.factsRoot =
                strings.CloneStr(dag.factsRoot)
            result.profiles =
                CsgCoreProfilesClone(dag.profiles)
            result.profileSetCid =
                CsgCoreProfileSetCid(dag.profiles)
    return result

@borrows
fn CsgCoreValidateFactLines(
        lines: str[],
        mode: str): CsgCoreValidationResult =
    var dag: merkle_dag.CsgCoreMerkleDag
    return csgCoreValidateFactLinesInto(
        lines, mode, dag)

@borrows
fn CsgCoreValidateCanonicalFactLines(
        lines: str[],
        mode: str): CsgCoreValidationResult =
    # Caller-proven canonical input contract (same boundary as the csgc
    # EncodeVerifiedLines precedent): every line is already canonical JSON,
    # so the bound-tree build reuses the bytes as-is instead of re-running
    # per-line canonicalization. Field-scan admission and the produced
    # factsRoot/profiles are byte-identical to CsgCoreValidateFactLines on
    # the same canonical input.
    var dag: merkle_dag.CsgCoreMerkleDag
    return csgCoreValidateFactLinesInto(
        lines, mode, dag, false, true)

@borrows
fn CsgCoreProductionValidateNamedReplacementFact(
        fact: str): CsgCoreValidationResult =
    var canonicalError: str
    let canonicalFact =
        merkle_dag.CsgCoreMerkleCanonicalFact(
            fact, canonicalError)
    var keyError: str
    let key = merkle_dag.CsgCoreMerkleFactKey(
        canonicalFact, keyError)
    let kind = jfield.CsgCoreJsonKind(canonicalFact)
    var requiredScope = CsgCoreReplacementScopeImmutable
    if kind.found:
        requiredScope =
            csgCoreReplacementScopeForExactKind(kind.value)
    if canonicalError.len > 0 || canonicalFact != fact ||
       keyError.len > 0 || !csgStartsWith(key, "id:") ||
       !kind.found || kind.value.len == 0 ||
       requiredScope != CsgCoreReplacementScopeLocalNamed:
        return csgCoreIncrementalRejected(
            [],
            "named replacement fact is not locally admissible",
            0, 0, 0)
    var localFacts = [strings.CloneStr(canonicalFact)]
    var ignoredDag: merkle_dag.CsgCoreMerkleDag
    var result = csgCoreValidateFactLinesInto(
        localFacts,
        CsgCoreModeStrict,
        ignoredDag,
        true)
    if result.factCount != 1 ||
       result.unsupportedCount != 0 ||
       result.tombstoneCount != 0 ||
       result.runtimeRequirementCount != 0 ||
       result.factExactKinds.len != 1 ||
       result.factReplacementScopes.len != 1 ||
       result.factExactKinds[0] != kind.value ||
       result.factReplacementScopes[0] != requiredScope ||
       result.factReplacementScopes[0] !=
           CsgCoreReplacementScopeLocalNamed:
        return csgCoreIncrementalRejected(
            [],
            "named replacement fact contribution is incomplete",
            result.unsupportedCount,
            result.tombstoneCount,
            result.runtimeRequirementCount)
    if !result.valid || !result.complete:
        return result
    result.replacementScope =
        result.factReplacementScopes[0]
    return result

fn CsgCoreProductionLocalNamedReplacementScope(): int32 =
    return CsgCoreReplacementScopeLocalNamed

@borrows
fn csgCoreProductionCanonicalInputError(
        lines: str[]): str =
    # Field-scan only. Full MerkleCanonicalFact builds a CsgJsonValue AST
    # (~1.5GiB measured on an 8-line compile) and is not 768MiB-safe.
    for i in 0..<lines.len:
        if lines[i].len == 0:
            return csgCat3(
                "line ",
                strings.IntToStr(i + 1),
                " production fact is empty")
        if lines[i][0] != '{':
            return csgCat3(
                "line ",
                strings.IntToStr(i + 1),
                " production fact is not a JSON object")
        let kind = jfield.CsgCoreJsonKind(lines[i])
        if !kind.found || kind.value.len == 0:
            return csgCat3(
                "line ",
                strings.IntToStr(i + 1),
                " production fact kind missing")
    return ""

@borrows
fn csgCoreProductionCanonicalRejected(
        message: str): CsgCoreValidationResult =
    var result: CsgCoreValidationResult
    result.valid = true
    result.mode = CsgCoreModeStrict
    result.standard = CsgCoreStandardIdentity()
    result.schema = CsgCoreSchemaNameIdentity()
    result.schemaNamespace = CsgCoreSchemaNamespaceIdentity()
    result.complete = true
    result.runtimeRequirementsStatus =
        CsgCoreRuntimeRequirementsSatisfied
    csgAddError(result, strings.CloneStr(message))
    result.complete = false
    return result

@borrows
fn CsgCoreProductionAdmitFactLines(
        lines: str[]): CsgCoreValidationResult =
    let canonicalInputError =
        csgCoreProductionCanonicalInputError(lines)
    if canonicalInputError.len > 0:
        return csgCoreProductionCanonicalRejected(
            canonicalInputError)
    var result =
        CsgCoreValidateFactLines(
            lines, CsgCoreModeStrict)
    if result.valid && !result.complete:
        csgAddError(
            result,
            "production admission requires complete=true")
        result.valid = false
    return result

@borrows
fn CsgCoreProductionAdmitFactLinesWithDag(
        lines: str[],
        dag: var merkle_dag.CsgCoreMerkleDag):
        CsgCoreValidationResult =
    dag = merkle_dag.CsgCoreMerkleDag()
    let canonicalInputError =
        csgCoreProductionCanonicalInputError(lines)
    if canonicalInputError.len > 0:
        return csgCoreProductionCanonicalRejected(
            canonicalInputError)
    var result =
        csgCoreValidateFactLinesInto(
            lines, CsgCoreModeStrict, dag, false, true)
    if result.valid && !result.complete:
        csgAddError(
            result,
            "production admission requires complete=true")
        result.valid = false
    return result

@borrows
fn csgCoreIncrementalRejected(
        expectedProfiles: str[],
        message: str,
        unsupportedCount: int32,
        tombstoneCount: int32,
        runtimeRequirementCount: int32):
        CsgCoreValidationResult =
    var result: CsgCoreValidationResult
    result.valid = true
    result.mode = CsgCoreModeStrict
    result.standard = CsgCoreStandardIdentity()
    result.schema = CsgCoreSchemaNameIdentity()
    result.schemaNamespace = CsgCoreSchemaNamespaceIdentity()
    result.profiles =
        CsgCoreProfilesClone(expectedProfiles)
    result.profileSetCid =
        CsgCoreProfileSetCid(expectedProfiles)
    result.factCount = 1
    result.complete = true
    result.unsupportedCount = unsupportedCount
    result.tombstoneCount = tombstoneCount
    result.runtimeRequirementCount = runtimeRequirementCount
    if runtimeRequirementCount > 0:
        result.runtimeRequirementsStatus =
            CsgCoreRuntimeRequirementsOpen
    else:
        result.runtimeRequirementsStatus =
            CsgCoreRuntimeRequirementsSatisfied
    csgAddError(result, strings.CloneStr(message))
    result.complete = false
    return result

@borrows
fn CsgCoreProductionAdmitIncrementalFact(
        fact: str,
        expectedProfiles: str[]):
        CsgCoreValidationResult =
    let profileError =
        CsgCoreProfilesCanonicalError(
            expectedProfiles)
    if profileError.len > 0:
        return csgCoreIncrementalRejected(
            expectedProfiles,
            csgCat(
                "incremental fact profiles invalid: ",
                profileError),
            0, 0, 0)
    let kind = jfield.CsgCoreJsonKind(fact)
    if !kind.found || kind.value.len == 0:
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental fact kind is missing",
            0, 0, 0)
    if kind.value == "csg.core.schema":
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental schema mutation is forbidden",
            0, 0, 0)
    if kind.value == "csg.unsupported":
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental unsupported fact is incomplete",
            1, 0, 0)
    if kind.value == "csg_core::tombstone":
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental tombstone fact is incomplete",
            0, 1, 0)
    if kind.value == "csg.runtime_requirement" ||
       kind.value == "csg.web.runtime_requirement":
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental runtime requirement is unresolved",
            0, 0, 1)
    if csgStartsWith(
           kind.value,
           "csg_dialect::cheng_compiler::"):
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental compiler fact requires complete closure",
            0, 0, 0)
    var canonicalError: str
    let canonical =
        merkle_dag.CsgCoreMerkleCanonicalFact(
            fact, canonicalError)
    if canonicalError.len > 0 || canonical != fact:
        return csgCoreIncrementalRejected(
            expectedProfiles,
            "incremental fact is not canonical",
            0, 0, 0)
    # A single fact plus a profile list cannot prove the canonical schema
    # fact, observed feature closure, or the unchanged facts that bind those
    # profiles.  Incremental production callers must submit complete
    # canonical before/after CSGC snapshots and replay a delta whose roots
    # match both full admissions.
    return csgCoreIncrementalRejected(
        expectedProfiles,
        "incremental fact requires complete admitted before/after CSGC",
        0, 0, 0)

@borrows
fn CsgCoreProfilesJson(values: str[]): str =
    var out = "["
    for i in 0..<values.len:
        if i > 0:
            out = csgCat(out, ",")
        out = csgCat(out, "\"")
        out = csgCat(out, values[i])
        out = csgCat(out, "\"")
    return csgCat(out, "]")

@borrows
fn CsgCoreValidationReportJson(result: CsgCoreValidationResult): str =
    var out = "{"
    out = csgCat(out, csgCat4("\"standard\":\"", result.standard, "\",", ""))
    out = csgCat(out, csgCat4("\"schema\":\"", result.schema, "\",", ""))
    out = csgCat(out, csgCat4("\"schema_namespace\":\"", result.schemaNamespace, "\",", ""))
    out = csgCat(out, csgCat4("\"mode\":\"", result.mode, "\",", ""))
    out = csgCat(out, csgCat3("\"profiles\":", CsgCoreProfilesJson(result.profiles), ","))
    out = csgCat(out, csgCat4("\"profile_set_cid\":\"", result.profileSetCid, "\",", ""))
    if result.factsRoot.len > 0:
        out = csgCat(out, csgCat4("\"facts_root\":\"", result.factsRoot, "\",", ""))
    out = csgCat(out, csgCat3("\"valid\":", csgBoolJson(result.valid), ","))
    out = csgCat(out, csgCat3("\"complete\":", csgBoolJson(result.complete), ","))
    out = csgCat(out, csgCat3("\"fact_count\":", strings.IntToStr(result.factCount), ","))
    out = csgCat(out, csgCat3("\"unsupported_count\":", strings.IntToStr(result.unsupportedCount), ","))
    out = csgCat(out, csgCat3("\"tombstone_count\":", strings.IntToStr(result.tombstoneCount), ","))
    out = csgCat(out, csgCat3("\"runtime_requirement_count\":", strings.IntToStr(result.runtimeRequirementCount), ","))
    out = csgCat(out, csgCat4("\"runtime_requirements_status\":\"", result.runtimeRequirementsStatus, "\",", ""))
    out = csgCat(out, csgCat3("\"error_count\":", strings.IntToStr(result.errorCount), "}"))
    return out
