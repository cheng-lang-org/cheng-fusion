             "csg_dialect::native::object_debug_relocation":
        let expected: str[] = [
            "id", "kind", "ordinal", "sectionByteOffset",
            "sectionKind", "targetAddend", "targetSymbolIndex",
            "targetSymbolName", "targetTextByteStart"]
        csgRequireExactJsonObjectFields(
            result, lineNo, raw, kind, expected)
