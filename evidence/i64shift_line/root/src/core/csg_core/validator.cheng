        csgRequireStringField(
            result, lineNo, raw, kind, "targetSymbolName")
        csgRequireNonnegativeInt32Field(
            result, lineNo, raw, kind, "targetTextByteStart")
    else:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " unsupported native fact kind: ",
                kind))

