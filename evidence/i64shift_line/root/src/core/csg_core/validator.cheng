fn csgCompilerWireSymbolKindToDeclarationKind(kind: int32): int32 =
    if kind == 1:
        return declaration.SemanticSnapshotDeclarationKindModule
    if kind == 2:
        return declaration.SemanticSnapshotDeclarationKindType
    if kind == 3:
        return declaration.SemanticSnapshotDeclarationKindFunction
    if kind == 4:
        return declaration.SemanticSnapshotDeclarationKindField
    if kind == 5:
        return declaration.SemanticSnapshotDeclarationKindParameter
    if kind == 6:
        return declaration.SemanticSnapshotDeclarationKindLocal
    if kind == 7:
        return declaration.SemanticSnapshotDeclarationKindGenericParameter
    return 0

fn csgCompilerWireSymbolKindMatchesDeclarationKind(
        symbolKind: int32,
        declarationKind: int32): bool =
    if symbolKind == 6:
        return declarationKind ==
                   declaration.SemanticSnapshotDeclarationKindGlobal ||
               declarationKind ==
                   declaration.SemanticSnapshotDeclarationKindConst ||
               declarationKind ==
                   declaration.SemanticSnapshotDeclarationKindLocal
    return csgCompilerWireSymbolKindToDeclarationKind(symbolKind) ==
           declarationKind

@borrows
fn csgCompilerWireCidEqual(left: layout.FixedBytes32,
                           right: layout.FixedBytes32): bool =
    return layout.FixedBytes32Equal(left, right)

@borrows
fn csgCompilerWireCidLess(left: layout.FixedBytes32,
                          right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] == right.data[index]:
            continue
        return left.data[index] < right.data[index]
    return false

@borrows
fn csgCompilerWireDeclarationQualifiedNameInto(
        facts: var CsgCoreChengCompilerWireFacts,
        declId: int32,
        out: var str): bool =
    if declId < 0 || declId >= facts.snapshot.declarations.declIds.len:
        return false
    var chain: int32[]
    var current = declId
    while current >= 0:
        add(chain, current)
        current = facts.snapshot.declarations.ownerDeclIds[current]
    if chain.len <= 0:
        return false
    var cursor: int32 = chain.len - 1
    if facts.snapshot.declarations.declarationKinds[chain[cursor]] !=
           declaration.SemanticSnapshotDeclarationKindModule:
        return false
    out = facts.snapshot.declarations.canonicalNames[chain[cursor]]
    cursor = cursor - 1
    var firstMember = true
    while cursor >= 0:
        out = strings.ConcatStr(
            strings.ConcatStr(out, firstMember ? "::" : "."),
            facts.snapshot.declarations.canonicalNames[chain[cursor]])
        firstMember = false
        cursor = cursor - 1
    return true

@borrows
fn csgCompilerWireSymbolCoordinateValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        symbolId: int32,
        err: var str): bool =
    let sourceId = facts.snapshot.symbols.sourceIds[symbolId]
    let nameTextId = facts.symbolNameTextIds[symbolId]
    let nameSpanId = facts.snapshot.symbols.nameSpanIds[symbolId]
    let nameTokenId = facts.snapshot.symbols.nameTokenIds[symbolId]
    let qualifiedNameTextId =
        facts.symbolQualifiedNameTextIds[symbolId]
    let declarationSpanId =
        facts.snapshot.symbols.declarationSpanIds[symbolId]
    let symbolKind = facts.snapshot.symbols.symbolKinds[symbolId]
    if sourceId < 0 || sourceId >= facts.snapshot.sources.documentCids.len ||
       sourceId >= facts.sourceModulePathTextIds.len ||
       nameTextId < 0 || nameTextId >= facts.snapshot.texts.len ||
       qualifiedNameTextId < 0 ||
       qualifiedNameTextId >= facts.snapshot.texts.len:
        return csgCompilerWireFail(err, "invalid Symbol source coordinate")
    if symbolKind != 1:
        # Identifier surfaces keep the original single-token authority.
        # Backtick operator names tokenize as separate punctuation tokens and
        # their name token is the opening backtick token (the parser's
        # declaration name token domain), so the direct form cannot hold and
        # the opener/closer bracket + byte-coverage authority decides instead.
        let directNameTokenHolds =
            nameSpanId >= 0 &&
            nameSpanId < facts.snapshot.spans.sourceIds.len &&
            facts.snapshot.spans.sourceIds[nameSpanId] == sourceId &&
            nameTokenId >= 0 && nameTokenId < facts.tokenSourceIds.len &&
            nameTokenId < facts.tokenValueTextIds.len &&
            facts.tokenSourceIds[nameTokenId] == sourceId &&
            facts.tokenSpanIds[nameTokenId] == nameSpanId &&
            facts.tokenValueTextIds[nameTokenId] == nameTextId
        let declarationSpanHolds =
            declarationSpanId >= 0 &&
            declarationSpanId < facts.snapshot.spans.sourceIds.len &&
            facts.snapshot.spans.sourceIds[declarationSpanId] == sourceId
        if !declarationSpanHolds ||
           (!directNameTokenHolds &&
            !snapshot_schema.CsgCompilerBacktickNameTokenAuthorityValid(
                facts.snapshot.spans.startBytes,
                facts.snapshot.spans.endBytes,
                facts.snapshot.spans.sourceIds,
                facts.tokenSourceIds,
                facts.tokenSpanIds,
                facts.tokenKinds,
                facts.tokenValueTextIds,
                facts.snapshot.texts,
                sourceId,
                nameSpanId,
                nameTokenId,
                nameTextId)):
            return csgCompilerWireFail(
                err, "Symbol name lacks exact token authority")
        return true
    let modulePathTextId = facts.sourceModulePathTextIds[sourceId]
    if modulePathTextId < 0 || modulePathTextId >= facts.snapshot.texts.len ||
       qualifiedNameTextId != modulePathTextId:
        return csgCompilerWireFail(err, "module Symbol path authority drift")
    var moduleDeclaration: int32 = -1
    for row in 0..<facts.snapshot.parserSidecars.declarationKinds.len:
        if facts.snapshot.parserSidecars.declarationKinds[row] != 1 ||
           facts.snapshot.parserSidecars.declarationProducerSourceIds[row] != sourceId:
            continue
        if moduleDeclaration >= 0:
            return csgCompilerWireFail(
                err, "duplicate module declaration authority")
        moduleDeclaration = row
    if moduleDeclaration < 0:
        if nameTextId != modulePathTextId || nameSpanId != -1 ||
           nameTokenId != -1 || declarationSpanId != -1:
            return csgCompilerWireFail(
                err, "implicit module fabricated a source coordinate")
        return true
    if nameTokenId !=
           facts.snapshot.parserSidecars.declarationNameTokenIds[moduleDeclaration] ||
       nameSpanId !=
           facts.snapshot.parserSidecars.declarationNameSpanIds[moduleDeclaration] ||
       declarationSpanId !=
           facts.snapshot.parserSidecars.declarationSpanIds[moduleDeclaration] ||
       nameSpanId < 0 || nameSpanId >= facts.snapshot.spans.sourceIds.len ||
       facts.snapshot.spans.sourceIds[nameSpanId] != sourceId ||
       nameTokenId < 0 || nameTokenId >= facts.tokenSourceIds.len ||
       facts.tokenSourceIds[nameTokenId] != sourceId ||
       facts.tokenSpanIds[nameTokenId] != nameSpanId ||
       facts.tokenValueTextIds[nameTokenId] != nameTextId ||
       declarationSpanId < 0 ||
       declarationSpanId >= facts.snapshot.spans.sourceIds.len ||
       facts.snapshot.spans.sourceIds[declarationSpanId] != sourceId:
        return csgCompilerWireFail(
            err, "explicit module coordinate authority drift")
    return true

@borrows
fn csgCompilerWireGenericTypesValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    if facts.snapshot.types.typeCids.len !=
           facts.snapshot.types.typeKinds.len ||
       facts.snapshot.types.typeCids.len !=
           facts.typeGenericParameterParserRows.len ||
       facts.snapshot.types.typeCids.len !=
           facts.snapshot.types.producerTypeArenaIds.len:
        return csgCompilerWireFail(
            err, "generic Type column shape mismatch")
    var parserSeen: bool[]
    var producerTypeArenaSeen: bool[]
    var producerTypeArenaCount: int32
    setLen(parserSeen, facts.parserGenericProducerSourceIds.len)
    setLen(producerTypeArenaSeen, facts.snapshot.types.typeCids.len)
    for typeId in 0..<facts.snapshot.types.typeCids.len:
        let parserRow = facts.typeGenericParameterParserRows[typeId]
        let producerTypeArenaId =
            facts.snapshot.types.producerTypeArenaIds[typeId]
        let genericType =
            facts.snapshot.types.typeKinds[typeId] ==
                CsgCoreCompilerTypeGenericParameter
        if genericType != (parserRow >= 0):
            return csgCompilerWireFail(
                err, "generic Type parser relation missing")
        if parserRow >= 0:
            if parserRow >= parserSeen.len || parserSeen[parserRow]:
                return csgCompilerWireFail(
                    err, "generic Type parser relation is not bijective")
            parserSeen[parserRow] = true
        if producerTypeArenaId < -1 ||
           (facts.snapshot.types.typeKinds[typeId] ==
                CsgCoreCompilerTypeFunction) !=
               (producerTypeArenaId == -1) ||
           (producerTypeArenaId >= 0 &&
            (producerTypeArenaId >= producerTypeArenaSeen.len ||
             producerTypeArenaSeen[producerTypeArenaId])):
            return csgCompilerWireFail(
                err, "producer TypeArena bridge is not bijective")
        if producerTypeArenaId >= 0:
            producerTypeArenaSeen[producerTypeArenaId] = true
            producerTypeArenaCount =
                producerTypeArenaCount + 1
    for parserRow in 0..<parserSeen.len:
        if !parserSeen[parserRow]:
            return csgCompilerWireFail(
                err, "parser generic parameter lacks Type")
    for producerTypeArenaId in 0..<producerTypeArenaSeen.len:
        if (producerTypeArenaId < producerTypeArenaCount) !=
               producerTypeArenaSeen[producerTypeArenaId]:
            return csgCompilerWireFail(
                err, "producer TypeArena bridge coverage is not exact")
    return true

@borrows
fn csgCompilerWireSymbolsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let count = facts.symbolCids.len
    if count <= 0 ||
       facts.symbolDeclIds.len != count ||
       facts.snapshot.symbols.declKeyCids.len != count ||
       facts.symbolInterfaceCids.len != count ||
       facts.snapshot.symbols.sourceIds.len != count ||
       facts.symbolNameTextIds.len != count ||
       facts.snapshot.symbols.nameSpanIds.len != count ||
       facts.snapshot.symbols.nameTokenIds.len != count ||
       facts.symbolQualifiedNameTextIds.len != count ||
       facts.snapshot.symbols.typeIds.len != count ||
       facts.snapshot.symbols.symbolKinds.len != count ||
       facts.snapshot.symbols.declarationSpanIds.len != count ||
       facts.snapshot.symbols.ownerSymbolIds.len != count ||
       facts.symbolDeclarationHeaderCids.len != count ||
       facts.symbolDeclarationPathCids.len != count ||
       facts.symbolExportedFlags.len != count ||
       facts.symbolFunctionIds.len != count ||
       facts.symbolExternFunctionIds.len != count ||
       facts.symbolGenericConstraintStarts.len != count ||
       facts.symbolGenericConstraintCounts.len != count ||
       facts.symbolGenericParameterParserRows.len != count ||
       facts.symbolGenericParameterOrdinals.len != count ||
       facts.symbolGenericParameterDefaultTypeIds.len != count ||
       facts.snapshot.types.typeCids.len != facts.typeGenericParameterParserRows.len ||
       facts.snapshot.sources.documentCids.len !=
           facts.sourceModulePathTextIds.len ||
       facts.snapshot.spans.sourceIds.len != facts.snapshot.spans.startBytes.len ||
       facts.snapshot.spans.sourceIds.len != facts.snapshot.spans.endBytes.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.startLines.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.startColumns.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.endLines.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.endColumns.len ||
       facts.tokenSourceIds.len != facts.tokenSourceLocalRows.len ||
       facts.tokenSourceIds.len != facts.tokenLexicalParentIds.len ||
       facts.tokenSourceIds.len != facts.tokenKinds.len ||
       facts.tokenSourceIds.len != facts.tokenSpanIds.len ||
       facts.tokenSourceIds.len != facts.tokenValueTextIds.len ||
       facts.snapshot.parserSidecars.declarationKinds.len !=
           facts.snapshot.parserSidecars.declarationProducerSourceIds.len ||
       facts.snapshot.parserSidecars.declarationKinds.len !=
           facts.snapshot.parserSidecars.declarationNameTokenIds.len ||
       facts.snapshot.parserSidecars.declarationKinds.len !=
           facts.snapshot.parserSidecars.declarationSpanIds.len ||
       facts.snapshot.parserSidecars.declarationKinds.len !=
           facts.snapshot.parserSidecars.declarationNameSpanIds.len:
        return csgCompilerWireFail(err, "semantic column shape mismatch")
    let parserGenericCount = facts.parserGenericProducerSourceIds.len
    if parserGenericCount != facts.parserGenericSourceLocalRows.len ||
       parserGenericCount !=
           facts.parserGenericDeclarationOwnerTokenIds.len ||
       parserGenericCount != facts.parserGenericNameTokenIds.len ||
       parserGenericCount != facts.parserGenericOrdinals.len ||
       parserGenericCount != facts.parserGenericSpanIds.len ||
       parserGenericCount !=
           facts.parserGenericConstraintTypeSyntaxIds.len ||
       parserGenericCount !=
           facts.parserGenericDefaultTypeSyntaxIds.len ||
       parserGenericCount != facts.parserGenericIdentityCids.len:
        return csgCompilerWireFail(
            err, "generic parser column shape mismatch")
    var declarationSeen: bool[]
    var symbolByDeclaration: int32[]
    var genericParserSeen: bool[]
    setLen(declarationSeen, facts.snapshot.declarations.declIds.len)
    setLen(symbolByDeclaration, facts.snapshot.declarations.declIds.len)
    setLen(genericParserSeen, parserGenericCount)
    for declId in 0..<symbolByDeclaration.len:
        symbolByDeclaration[declId] = -1
    var genericConstraintCursor: int32
    for symbolId in 0..<count:
        let declId = facts.symbolDeclIds[symbolId]
        let sourceId = facts.snapshot.symbols.sourceIds[symbolId]
        let nameTextId = facts.symbolNameTextIds[symbolId]
        let typeId = facts.snapshot.symbols.typeIds[symbolId]
        let ownerSymbolId = facts.snapshot.symbols.ownerSymbolIds[symbolId]
        let symbolKind = facts.snapshot.symbols.symbolKinds[symbolId]
        let functionId = facts.symbolFunctionIds[symbolId]
        let externFunctionId =
            facts.symbolExternFunctionIds[symbolId]
        if declId < 0 || declId >= facts.snapshot.declarations.declIds.len ||
           sourceId < 0 || sourceId >= facts.snapshot.sources.documentCids.len ||
           nameTextId < 0 || nameTextId >= facts.snapshot.texts.len ||
           symbolKind < 1 || symbolKind > 7 ||
           (symbolKind == 1 && typeId != -1) ||
           (symbolKind != 1 &&
            (typeId < 0 || typeId >= facts.snapshot.types.typeCids.len)) ||
           ownerSymbolId < -1 || ownerSymbolId >= count ||
           ownerSymbolId == symbolId || declarationSeen[declId] ||
           (symbolKind == 3 &&
            ((functionId >= 0) == (externFunctionId >= 0) ||
             (functionId >= 0 &&
              (functionId >= facts.snapshot.functions.symbolIds.len ||
               facts.snapshot.functions.symbolIds[functionId] != symbolId)) ||
             (externFunctionId >= 0 &&
              (externFunctionId >= facts.externFunctionSymbolIds.len ||
               facts.externFunctionSymbolIds[externFunctionId] !=
                   symbolId)))) ||
           (symbolKind != 3 &&
            (functionId != -1 || externFunctionId != -1)) ||
           (symbolId > 0 &&
            !csgCompilerWireCidLess(
                facts.symbolCids[symbolId - 1],
                facts.symbolCids[symbolId])):
            return csgCompilerWireFail(err, "invalid Symbol/DeclId join")
        let genericParserRow =
            facts.symbolGenericParameterParserRows[symbolId]
        let genericOrdinal =
            facts.symbolGenericParameterOrdinals[symbolId]
        let genericDefaultTypeId =
            facts.symbolGenericParameterDefaultTypeIds[symbolId]
        let genericConstraintStart =
            facts.symbolGenericConstraintStarts[symbolId]
        let genericConstraintCount =
            facts.symbolGenericConstraintCounts[symbolId]
        if genericConstraintStart != genericConstraintCursor ||
           genericConstraintCount < 0 ||
           genericConstraintCount >
               facts.symbolGenericConstraintTypeIds.len -
                   genericConstraintStart ||
           genericDefaultTypeId < -1 ||
           genericDefaultTypeId >= facts.snapshot.types.typeCids.len:
            return csgCompilerWireFail(
                err, "invalid generic Symbol relation range")
        if symbolKind == 7:
            if genericParserRow < 0 ||
               genericParserRow >=
                   facts.parserGenericProducerSourceIds.len ||
               genericParserSeen[genericParserRow] ||
               genericOrdinal < 0 ||
               typeId >= facts.typeGenericParameterParserRows.len ||
               facts.typeGenericParameterParserRows[typeId] !=
                   genericParserRow ||
               genericConstraintCount > 1 ||
               facts.parserGenericProducerSourceIds[genericParserRow] !=
                   sourceId ||
               facts.parserGenericNameTokenIds[genericParserRow] !=
                   facts.snapshot.symbols.nameTokenIds[symbolId] ||
               ownerSymbolId < 0 ||
               facts.parserGenericDeclarationOwnerTokenIds[
                   genericParserRow] !=
                       facts.snapshot.symbols.nameTokenIds[ownerSymbolId] ||
               facts.parserGenericOrdinals[genericParserRow] !=
                   genericOrdinal ||
               facts.parserGenericSpanIds[genericParserRow] !=
                   facts.snapshot.symbols.declarationSpanIds[symbolId] ||
               !csgCompilerWireCidEqual(
                   facts.parserGenericIdentityCids[genericParserRow],
                   facts.symbolDeclarationHeaderCids[symbolId]) ||
               !csgCompilerWireCidEqual(
                   facts.parserGenericIdentityCids[genericParserRow],
                   facts.symbolDeclarationPathCids[symbolId]) ||
               (facts.parserGenericConstraintTypeSyntaxIds[
                    genericParserRow] < 0) !=
                   (genericConstraintCount == 0) ||
               (facts.parserGenericDefaultTypeSyntaxIds[
                    genericParserRow] < 0) !=
                   (genericDefaultTypeId < 0):
                return csgCompilerWireFail(
                    err, "generic Symbol parser relation drift")
            genericParserSeen[genericParserRow] = true
        elif genericParserRow != -1 || genericOrdinal != -1 ||
             genericDefaultTypeId != -1 || genericConstraintCount != 0:
            return csgCompilerWireFail(
                err, "non-generic Symbol carried generic relation")
        for offset in 0..<genericConstraintCount:
            let constraintTypeId =
                facts.symbolGenericConstraintTypeIds[
                    genericConstraintStart + offset]
            if constraintTypeId < 0 ||
               constraintTypeId >= facts.snapshot.types.typeCids.len:
                return csgCompilerWireFail(
                    err, "generic constraint TypeId out of range")
        genericConstraintCursor =
            genericConstraintCursor + genericConstraintCount
        var qualifiedName: str
        if !csgCompilerWireDeclarationQualifiedNameInto(
               facts, declId, qualifiedName) ||
           facts.snapshot.texts[facts.symbolQualifiedNameTextIds[symbolId]] !=
               qualifiedName ||
           !csgCompilerWireSymbolCoordinateValidateInto(
               facts, symbolId, err):
            if err == "":
                err = " Symbol qualified declaration name drift"
            return false
        if !csgCompilerWireCidEqual(
               facts.snapshot.symbols.declKeyCids[symbolId],
               facts.snapshot.declarations.declKeyCids[declId]) ||
           !csgCompilerWireCidEqual(
               facts.symbolCids[symbolId],
               facts.snapshot.symbols.declKeyCids[symbolId]) ||
           !csgCompilerWireCidEqual(
               facts.snapshot.sources.documentCids[sourceId],
               facts.snapshot.declarations.portableDocumentIdentityCids[declId]) ||
           (symbolKind != 1 &&
            !csgCompilerWireCidEqual(
                facts.snapshot.types.typeCids[typeId],
                facts.snapshot.declarations.portableSignatureTypeExpressionCids[
                    declId])) ||
           (symbolKind == 1 &&
            facts.snapshot.declarations.canonicalNames[declId] !=
                facts.snapshot.texts[facts.sourceModulePathTextIds[sourceId]]) ||
           (symbolKind != 1 &&
            facts.snapshot.texts[nameTextId] !=
                facts.snapshot.declarations.canonicalNames[declId]) ||
           !csgCompilerWireSymbolKindMatchesDeclarationKind(
               symbolKind,
               facts.snapshot.declarations.declarationKinds[declId]):
            return csgCompilerWireFail(err, "Symbol declaration authority drift")
        declarationSeen[declId] = true
        symbolByDeclaration[declId] = symbolId
    if genericConstraintCursor !=
           facts.symbolGenericConstraintTypeIds.len:
        return csgCompilerWireFail(
            err, "generic constraint coverage mismatch")
    for parserRow in 0..<genericParserSeen.len:
        if !genericParserSeen[parserRow]:
            return csgCompilerWireFail(
                err, "parser generic parameter lacks Symbol")
    var moduleBySource: int32[]
    setLen(moduleBySource, facts.snapshot.sources.documentCids.len)
    for sourceId in 0..<moduleBySource.len:
        moduleBySource[sourceId] = -1
    for declId in 0..<facts.snapshot.declarations.declIds.len:
        if facts.snapshot.declarations.declarationKinds[declId] ==
               declaration.SemanticSnapshotDeclarationKindModule:
            var matchedSource: int32 = -1
            for sourceId in 0..<facts.snapshot.sources.documentCids.len:
                if csgCompilerWireCidEqual(
                       facts.snapshot.sources.documentCids[sourceId],
                       facts.snapshot.declarations.portableDocumentIdentityCids[
                           declId]):
                    if matchedSource >= 0:
                        return csgCompilerWireFail(
                            err, "ambiguous module document")
                    matchedSource = sourceId
            if matchedSource < 0 || moduleBySource[matchedSource] >= 0:
                return csgCompilerWireFail(
                    err, "module declaration coverage mismatch")
            let moduleTextId =
                facts.sourceModulePathTextIds[matchedSource]
            if moduleTextId < 0 || moduleTextId >= facts.snapshot.texts.len ||
               facts.snapshot.texts[moduleTextId] !=
                   facts.snapshot.declarations.canonicalNames[declId]:
                return csgCompilerWireFail(
                    err, "module declaration name mismatch")
            moduleBySource[matchedSource] = declId
        elif !declarationSeen[declId]:
            return csgCompilerWireFail(err, "declaration lacks Symbol row")
    for sourceId in 0..<moduleBySource.len:
        if moduleBySource[sourceId] < 0 ||
           !declarationSeen[moduleBySource[sourceId]]:
            return csgCompilerWireFail(
                err, "source module Symbol missing")
    for symbolId in 0..<count:
        let declId = facts.symbolDeclIds[symbolId]
        let ownerDeclId = facts.snapshot.declarations.ownerDeclIds[declId]
        let ownerSymbolId = facts.snapshot.symbols.ownerSymbolIds[symbolId]
        if ownerDeclId < 0:
            if ownerSymbolId != -1:
                return csgCompilerWireFail(err, "module Symbol owner remap")
        elif ownerDeclId >= symbolByDeclaration.len ||
             symbolByDeclaration[ownerDeclId] < 0 ||
             ownerSymbolId != symbolByDeclaration[ownerDeclId]:
            return csgCompilerWireFail(err, "Symbol owner remap")
    return true

@borrows
fn csgCompilerWireDeclarationForFunctionRow(
        facts: var CsgCoreChengCompilerWireFacts,
        functionRow: int32): int32 =
    for row in 0..<facts.snapshot.parserSidecars.declarationKinds.len:
        if facts.snapshot.parserSidecars.declarationKinds[row] == 3 &&
           facts.snapshot.parserSidecars.declarationFunctionRows[row] == functionRow:
            return row
    return -1

@borrows
fn csgCompilerWireParserPatternsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let count = facts.snapshot.parserSidecars.patternKinds.len
    if count != facts.snapshot.parserSidecars.patternProducerSourceIds.len ||
       count != facts.snapshot.parserSidecars.patternSourceLocalRows.len ||
       count != facts.parserPatternNameTokenIds.len ||
       count != facts.parserPatternOwnerLexicalScopeIds.len ||
       count != facts.snapshot.parserSidecars.patternBindingDeclarationIds.len ||
       count != facts.parserPatternSpanIds.len ||
       count != facts.parserPatternChildStarts.len ||
       count != facts.parserPatternChildCounts.len:
        return csgCompilerWireFail(err, "parser pattern shape mismatch")
    var childSeen: bool[]
    var bindingDeclarationSeen: bool[]
    setLen(childSeen, count)
    setLen(bindingDeclarationSeen, facts.snapshot.parserSidecars.declarationKinds.len)
    var childCursor: int32
    for row in 0..<count:
        let source = facts.snapshot.parserSidecars.patternProducerSourceIds[row]
        let localRow = facts.snapshot.parserSidecars.patternSourceLocalRows[row]
        let kind = facts.snapshot.parserSidecars.patternKinds[row]
        let nameToken = facts.parserPatternNameTokenIds[row]
        let scope = facts.parserPatternOwnerLexicalScopeIds[row]
        let declaration = facts.snapshot.parserSidecars.patternBindingDeclarationIds[row]
        let span = facts.parserPatternSpanIds[row]
        let childStart = facts.parserPatternChildStarts[row]
        let childCount = facts.parserPatternChildCounts[row]
        let firstForSource = row == 0 || source !=
            facts.snapshot.parserSidecars.patternProducerSourceIds[row - 1]
        if source < 0 || source >= facts.snapshot.sources.documentCids.len ||
           (row > 0 && source <
                facts.snapshot.parserSidecars.patternProducerSourceIds[row - 1]) ||
           localRow != (firstForSource ? 0 :
                facts.snapshot.parserSidecars.patternSourceLocalRows[row - 1] + 1) ||
           kind < 1 || kind > 9 || nameToken < -1 ||
           nameToken >= facts.tokenSourceIds.len ||
           (nameToken >= 0 && facts.tokenSourceIds[nameToken] != source) ||
           scope < 0 || scope >= facts.parserDeclarationScopeKinds.len ||
           facts.parserDeclarationScopeProducerSourceIds[scope] != source ||
           declaration < -1 ||
           declaration >= facts.snapshot.parserSidecars.declarationKinds.len ||
           (declaration >= 0 &&
            facts.snapshot.parserSidecars.declarationProducerSourceIds[declaration] != source) ||
           span < 0 || span >= facts.snapshot.spans.sourceIds.len ||
           facts.snapshot.spans.sourceIds[span] != source ||
           childStart != childCursor || childCount < 0 ||
           childStart > facts.parserPatternChildIds.len ||
           childCount > facts.parserPatternChildIds.len - childStart:
            return csgCompilerWireFail(err, "invalid parser pattern")
        if kind == 1:
            if nameToken < 0 || declaration < 0 ||
               bindingDeclarationSeen[declaration] ||
               facts.snapshot.parserSidecars.declarationKinds[declaration] != 6 ||
               facts.snapshot.parserSidecars.declarationNameTokenIds[declaration] != nameToken ||
               facts.parserDeclarationLexicalScopeIds[declaration] != scope:
                return csgCompilerWireFail(
                    err, "parser pattern binding drift")
            bindingDeclarationSeen[declaration] = true
        elif declaration != -1:
            return csgCompilerWireFail(
                err, "non-binding parser pattern declaration")
        for offset in 0..<childCount:
            let child = facts.parserPatternChildIds[childStart + offset]
            if child < 0 || child >= row || childSeen[child] ||
               facts.snapshot.parserSidecars.patternProducerSourceIds[child] != source ||
               facts.parserPatternOwnerLexicalScopeIds[child] != scope:
                return csgCompilerWireFail(err, "invalid parser pattern child")
            childSeen[child] = true
        childCursor = childCursor + childCount
    if childCursor != facts.parserPatternChildIds.len:
        return csgCompilerWireFail(
            err, "parser pattern child coverage mismatch")
    return true

@borrows
fn csgCompilerWireParserDeclarationsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let sourceCount = facts.snapshot.sources.documentCids.len
    if facts.snapshot.spans.sourceIds.len != facts.snapshot.spans.startBytes.len ||
       facts.snapshot.spans.sourceIds.len != facts.snapshot.spans.endBytes.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.startLines.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.startColumns.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.endLines.len ||
       facts.snapshot.spans.sourceIds.len !=
           facts.snapshot.spans.endColumns.len:
        return csgCompilerWireFail(err, "parser span shape mismatch")
    for span in 0..<facts.snapshot.spans.sourceIds.len:
        if facts.snapshot.spans.sourceIds[span] < 0 ||
           facts.snapshot.spans.sourceIds[span] >= sourceCount ||
           facts.snapshot.spans.startBytes[span] < 0 ||
           facts.snapshot.spans.endBytes[span] <= facts.snapshot.spans.startBytes[span]:
            return csgCompilerWireFail(err, "invalid parser span source")
    if facts.tokenSourceIds.len != facts.tokenSourceLocalRows.len ||
       facts.tokenSourceIds.len != facts.tokenLexicalParentIds.len ||
       facts.tokenSourceIds.len != facts.tokenKinds.len ||
       facts.tokenSourceIds.len != facts.tokenSpanIds.len ||
       facts.tokenSourceIds.len != facts.tokenValueTextIds.len:
        return csgCompilerWireFail(err, "parser token shape mismatch")
    var previousSource: int32 = -1
    var expectedSourceLocalRow: int32
    var previousRootEndByte: int32 = -1
    var previousChildEndBytes: int32[]
    setLen(previousChildEndBytes, facts.tokenSourceIds.len)
    for token in 0..<previousChildEndBytes.len:
        previousChildEndBytes[token] = -1
    for token in 0..<facts.tokenSourceIds.len:
        let source = facts.tokenSourceIds[token]
        let span = facts.tokenSpanIds[token]
        let lexicalParent = facts.tokenLexicalParentIds[token]
        if source < 0 || source >= sourceCount ||
           source < previousSource ||
           span < 0 || span >= facts.snapshot.spans.sourceIds.len ||
           facts.snapshot.spans.sourceIds[span] != source ||
           facts.tokenKinds[token] <= 0 ||
           facts.tokenValueTextIds[token] < 0 ||
           facts.tokenValueTextIds[token] >= facts.snapshot.texts.len:
            return csgCompilerWireFail(err, "invalid parser token")
        if source != previousSource:
            expectedSourceLocalRow = 0
            previousRootEndByte = -1
        if facts.tokenSourceLocalRows[token] != expectedSourceLocalRow ||
           lexicalParent < -1 || lexicalParent >= token:
            return csgCompilerWireFail(err, "invalid parser token identity")
        let startByte = facts.snapshot.spans.startBytes[span]
        let endByte = facts.snapshot.spans.endBytes[span]
        if lexicalParent == -1:
            if startByte < previousRootEndByte:
                return csgCompilerWireFail(
                    err, "invalid parser primary token order")
            previousRootEndByte = endByte
        else:
            let parentSpan = facts.tokenSpanIds[lexicalParent]
            if facts.tokenSourceIds[lexicalParent] != source ||
               facts.tokenKinds[lexicalParent] !=
                   CsgCoreParserTokenFmtString ||
               startByte <= facts.snapshot.spans.startBytes[parentSpan] ||
               endByte >= facts.snapshot.spans.endBytes[parentSpan] ||
               startByte < previousChildEndBytes[lexicalParent]:
                return csgCompilerWireFail(
                    err, "invalid parser interpolation token identity")
            previousChildEndBytes[lexicalParent] = endByte
        previousSource = source
        expectedSourceLocalRow = expectedSourceLocalRow + 1
    let scopeCount = facts.parserDeclarationScopeKinds.len
    if scopeCount <= 0 ||
       scopeCount != facts.parserDeclarationScopeProducerSourceIds.len ||
       scopeCount != facts.parserDeclarationScopeSourceLocalRows.len ||
       scopeCount != facts.parserDeclarationScopeParentIds.len ||
       scopeCount !=
           facts.parserDeclarationScopeOwnerDeclarationIds.len:
        return csgCompilerWireFail(
            err, "parser declaration scope shape mismatch")
    let count = facts.snapshot.parserSidecars.declarationKinds.len
    if count != facts.snapshot.parserSidecars.declarationProducerSourceIds.len ||
       count != facts.snapshot.parserSidecars.declarationSourceLocalRows.len ||
       count != facts.snapshot.parserSidecars.declarationNameTokenIds.len ||
       count != facts.snapshot.parserSidecars.declarationOwnerIds.len ||
       count != facts.parserDeclarationLexicalScopeIds.len ||
       count != facts.snapshot.parserSidecars.declarationFunctionRows.len ||
       count !=
           facts.snapshot.parserSidecars.declarationDefaultStatementRootRows.len ||
       count != facts.parserDeclarationTypeSyntaxRootIds.len ||
       count != facts.snapshot.parserSidecars.declarationSpanIds.len ||
       count != facts.snapshot.parserSidecars.declarationNameSpanIds.len ||
       count != facts.parserDeclarationMutableFlags.len ||
       count != facts.parserDeclarationExportedFlags.len:
        return csgCompilerWireFail(
            err, "parser declaration shape mismatch")
    var scopeSourceSeen: bool[]
    setLen(scopeSourceSeen, sourceCount)
    for scopeRow in 0..<scopeCount:
        let source = facts.parserDeclarationScopeProducerSourceIds[scopeRow]
        let localRow = facts.parserDeclarationScopeSourceLocalRows[scopeRow]
        let kind = facts.parserDeclarationScopeKinds[scopeRow]
        let parent = facts.parserDeclarationScopeParentIds[scopeRow]
        let owner = facts.parserDeclarationScopeOwnerDeclarationIds[scopeRow]
        let firstForSource = scopeRow == 0 || source !=
            facts.parserDeclarationScopeProducerSourceIds[scopeRow - 1]
        if source < 0 || source >= sourceCount ||
           (scopeRow > 0 && source <
                facts.parserDeclarationScopeProducerSourceIds[scopeRow - 1]) ||
           localRow != (firstForSource ? 0 :
                facts.parserDeclarationScopeSourceLocalRows[scopeRow - 1] + 1) ||
           kind < 1 || kind > 4 || parent < -1 || parent >= scopeRow ||
           (parent >= 0 &&
            facts.parserDeclarationScopeProducerSourceIds[parent] != source) ||
           owner < -1 || owner >= count ||
           (owner >= 0 &&
            facts.snapshot.parserSidecars.declarationProducerSourceIds[owner] != source) ||
           (kind == 1 && (parent != -1 || owner != -1)):
            return csgCompilerWireFail(
                err, "invalid parser declaration scope")
        scopeSourceSeen[source] = true
    for source in 0..<sourceCount:
        if !scopeSourceSeen[source]:
            return csgCompilerWireFail(
                err, "parser declaration scope source missing")
    var parserDeclarationFunctionCount: int32
    for row in 0..<count:
        if facts.snapshot.parserSidecars.declarationKinds[row] == 3:
            parserDeclarationFunctionCount =
                parserDeclarationFunctionCount + 1
    var functionSeen: bool[]
    setLen(functionSeen, parserDeclarationFunctionCount)
    for row in 0..<count:
        let source = facts.snapshot.parserSidecars.declarationProducerSourceIds[row]
        let localRow = facts.snapshot.parserSidecars.declarationSourceLocalRows[row]
        let kind = facts.snapshot.parserSidecars.declarationKinds[row]
        let owner =
            facts.snapshot.parserSidecars.declarationOwnerIds[row]
        let scope = facts.parserDeclarationLexicalScopeIds[row]
        let functionRow = facts.snapshot.parserSidecars.declarationFunctionRows[row]
        let defaultStatementRoot =
            facts.snapshot.parserSidecars.declarationDefaultStatementRootRows[
                row]
        let nameToken = facts.snapshot.parserSidecars.declarationNameTokenIds[row]
        let span = facts.snapshot.parserSidecars.declarationSpanIds[row]
        let nameSpan = facts.snapshot.parserSidecars.declarationNameSpanIds[row]
        let firstForSource = row == 0 || source !=
            facts.snapshot.parserSidecars.declarationProducerSourceIds[row - 1]
        if source < 0 || source >= sourceCount ||
           (row > 0 && source <
                facts.snapshot.parserSidecars.declarationProducerSourceIds[row - 1]) ||
           localRow != (firstForSource ? 0 :
                facts.snapshot.parserSidecars.declarationSourceLocalRows[row - 1] + 1) ||
           kind < 1 || kind > 6 || owner < -1 || owner >= row ||
           nameToken < 0 || nameToken >= facts.tokenSourceIds.len ||
           facts.tokenSourceIds[nameToken] != source ||
           span < 0 || span >= facts.snapshot.spans.sourceIds.len ||
           nameSpan < 0 || nameSpan >= facts.snapshot.spans.sourceIds.len ||
           facts.snapshot.spans.sourceIds[span] != source ||
           facts.snapshot.spans.sourceIds[nameSpan] != source ||
           facts.tokenSpanIds[nameToken] != nameSpan ||
           (owner >= 0 &&
            facts.snapshot.parserSidecars.declarationProducerSourceIds[owner] != source) ||
           scope < 0 || scope >= scopeCount ||
           facts.parserDeclarationScopeProducerSourceIds[scope] != source ||
           functionRow < -1 || functionRow >= functionSeen.len ||
           defaultStatementRoot < -1 ||
           defaultStatementRoot >=
               facts.snapshot.parserSidecars.statementRootNodeIds.len ||
           (kind != 5 && defaultStatementRoot != -1) ||
           facts.parserDeclarationTypeSyntaxRootIds[row] < -1:
            return csgCompilerWireFail(err, "invalid parser declaration")
        let ownerKind = owner < 0 ? 0 :
            facts.snapshot.parserSidecars.declarationKinds[owner]
        if (kind == 1 &&
            (owner != -1 || functionRow != -1 ||
             facts.parserDeclarationTypeSyntaxRootIds[row] != -1 ||
             facts.parserDeclarationMutableFlags[row])) ||
           (kind == 2 &&
            (facts.parserDeclarationTypeSyntaxRootIds[row] < 0 ||
             (owner >= 0 && ownerKind != 1))) ||
           (kind == 3 && functionRow < 0) ||
           (kind == 4 &&
            (owner < 0 || ownerKind != 2 || functionRow != -1 ||
             facts.parserDeclarationTypeSyntaxRootIds[row] < 0)) ||
           (kind == 5 &&
            (owner < 0 || ownerKind != 3 || functionRow < 0)) ||
           (kind == 6 &&
            ((functionRow >= 0 && (owner < 0 || ownerKind != 3)) ||
             (functionRow < 0 && owner >= 0 && ownerKind != 1 &&
              ownerKind != 2))):
            return csgCompilerWireFail(
                err, "parser declaration owner binding drift")
        if kind == 3:
            if functionRow < 0 || functionSeen[functionRow]:
                return csgCompilerWireFail(
                    err, "parser function declaration drift")
            functionSeen[functionRow] = true
    for functionRow in 0..<functionSeen.len:
        if !functionSeen[functionRow]:
            return csgCompilerWireFail(
                err, "parser function declaration missing")
    let statementCount =
        facts.snapshot.parserSidecars.statementRootNodeIds.len
    if statementCount !=
           facts.snapshot.parserSidecars.statementRootRoles.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootAnchorTokenIds.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootBindingDeclarationStarts.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootBindingDeclarationCounts.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootAnchorLines.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootAnchorColumns.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootEndLines.len ||
       statementCount !=
           facts.snapshot.parserSidecars.statementRootEndColumns.len:
        return csgCompilerWireFail(
            err, "parser statement root shape mismatch")
    for statementRow in 0..<statementCount:
        let node =
            facts.snapshot.parserSidecars.statementRootNodeIds[
                statementRow]
        let role =
            facts.snapshot.parserSidecars.statementRootRoles[
                statementRow]
        let anchorToken =
            facts.snapshot.parserSidecars.statementRootAnchorTokenIds[
                statementRow]
        let declarationStart =
            facts.snapshot.parserSidecars.statementRootBindingDeclarationStarts[
                statementRow]
        let declarationCount =
            facts.snapshot.parserSidecars.statementRootBindingDeclarationCounts[
                statementRow]
        if node < 0 || node >= facts.snapshot.parserNodes.sourceIds.len ||
           anchorToken < 0 || anchorToken >= facts.tokenSourceIds.len ||
           role <= 0:
            return csgCompilerWireFail(
                err, "invalid parser statement root")
        let nodeSpan = facts.snapshot.parserNodes.spanIds[node]
        let anchorSpan = facts.tokenSpanIds[anchorToken]
        if nodeSpan < 0 ||
           nodeSpan >= facts.snapshot.spans.sourceIds.len ||
           anchorSpan < 0 ||
           anchorSpan >= facts.snapshot.spans.sourceIds.len ||
           facts.tokenSourceIds[anchorToken] !=
               facts.snapshot.parserNodes.sourceIds[node] ||
           facts.snapshot.parserSidecars.statementRootAnchorLines[
               statementRow] !=
               facts.snapshot.spans.startLines[anchorSpan] ||
           facts.snapshot.parserSidecars.statementRootAnchorColumns[
               statementRow] !=
               facts.snapshot.spans.startColumns[anchorSpan]:
            return csgCompilerWireFail(
                err, "parser statement root anchor drift")
        let declarationAuthority =
            role ==
                snapshot_schema.CsgCompilerParserStatementBindingInitializer ||
            role ==
                snapshot_schema.CsgCompilerParserStatementParameterDefault ||
            role ==
                snapshot_schema.CsgCompilerParserStatementTypeDefault
        if !declarationAuthority:
            if declarationStart != -1 || declarationCount != 0:
                return csgCompilerWireFail(
                    err,
                    "parser statement root unexpected declaration authority")
            continue
        if facts.tokenKinds[anchorToken] !=
               snapshot_schema.CsgCompilerTokenAssign ||
           declarationStart < 0 || declarationCount <= 0 ||
           declarationStart > count ||
           declarationCount > count - declarationStart:
            return csgCompilerWireFail(
                err, "parser statement declaration range drift")
        if (role ==
                snapshot_schema.CsgCompilerParserStatementParameterDefault ||
            role ==
                snapshot_schema.CsgCompilerParserStatementTypeDefault) &&
           declarationCount != 1:
            return csgCompilerWireFail(
                err, "parser declaration default cardinality drift")
        let anchorStart =
            facts.snapshot.spans.startBytes[anchorSpan]
        for declarationOffset in 0..<declarationCount:
            let declarationRow =
                declarationStart + declarationOffset
            let declarationKind =
                facts.snapshot.parserSidecars.declarationKinds[
                    declarationRow]
            let declarationSpan =
                facts.snapshot.parserSidecars.declarationSpanIds[
                    declarationRow]
            let declarationNameToken =
                facts.snapshot.parserSidecars.declarationNameTokenIds[
                    declarationRow]
            if declarationSpan < 0 ||
               declarationSpan >= facts.snapshot.spans.sourceIds.len ||
               declarationNameToken < 0 ||
               declarationNameToken >= facts.tokenSpanIds.len ||
               facts.snapshot.parserSidecars.declarationProducerSourceIds[
                   declarationRow] !=
                   facts.snapshot.parserNodes.sourceIds[node] ||
               facts.snapshot.spans.startBytes[declarationSpan] >=
                   anchorStart ||
               facts.snapshot.spans.startBytes[
                   facts.tokenSpanIds[declarationNameToken]] >=
                   anchorStart:
                return csgCompilerWireFail(
                    err, "parser statement declaration span drift")
            if role ==
                   snapshot_schema.CsgCompilerParserStatementBindingInitializer:
                if declarationKind !=
                       snapshot_schema.CsgCompilerParserDeclarationLocal ||
                   facts.snapshot.spans.endBytes[declarationSpan] !=
                       facts.snapshot.spans.endBytes[nodeSpan]:
                    return csgCompilerWireFail(
                        err, "parser binding declaration authority drift")
            elif role ==
                     snapshot_schema.CsgCompilerParserStatementTypeDefault:
                let scope =
                    facts.parserDeclarationLexicalScopeIds[
                        declarationRow]
                let typeAuthority =
                    declarationKind ==
                        snapshot_schema.CsgCompilerParserDeclarationType &&
                    facts.parserDeclarationScopeKinds[scope] == 1
                let fieldAuthority =
                    declarationKind ==
                        snapshot_schema.CsgCompilerParserDeclarationField &&
                    facts.parserDeclarationScopeKinds[scope] == 2
                if facts.snapshot.parserSidecars.declarationFunctionRows[
                       declarationRow] != -1 ||
                   (!typeAuthority && !fieldAuthority) ||
                   facts.snapshot.spans.endBytes[declarationSpan] <
                       facts.snapshot.spans.endBytes[nodeSpan]:
                    return csgCompilerWireFail(
                        err, "parser type default authority drift")
            else:
                let owner =
                    facts.snapshot.parserSidecars.declarationOwnerIds[
                        declarationRow]
                let functionRow =
                    facts.snapshot.parserSidecars.declarationFunctionRows[
                        declarationRow]
                let scope =
                    facts.parserDeclarationLexicalScopeIds[
                        declarationRow]
                if declarationKind !=
                       snapshot_schema.CsgCompilerParserDeclarationParameter ||
                   facts.snapshot.parserSidecars.declarationDefaultStatementRootRows[
                           declarationRow] != statementRow ||
                   owner < 0 ||
                   facts.snapshot.parserSidecars.declarationKinds[owner] !=
                       snapshot_schema.CsgCompilerParserDeclarationFunction ||
                   functionRow < 0 ||
                   facts.snapshot.parserSidecars.declarationFunctionRows[
                       owner] != functionRow ||
                   facts.parserDeclarationScopeKinds[scope] !=
                       snapshot_schema.CsgCompilerParserScopeFunction ||
                   facts.parserDeclarationScopeOwnerDeclarationIds[
                       scope] != owner ||
                   facts.parserDeclarationScopeProducerSourceIds[
                       scope] !=
                       facts.snapshot.parserSidecars.declarationProducerSourceIds[
                           declarationRow] ||
                   facts.snapshot.spans.endBytes[declarationSpan] !=
                       facts.snapshot.spans.endBytes[nodeSpan]:
                    return csgCompilerWireFail(
                        err, "parser parameter default authority drift")
    var executableParserSeen: bool[]
    setLen(
        executableParserSeen,
        facts.parserFunctionDeclarationSpanIds.len)
    for parserFunctionRow in 0..<executableParserSeen.len:
        var declarationMatchCount: int32
        for declarationRow in 0..<count:
            if facts.snapshot.parserSidecars.declarationKinds[declarationRow] == 3 &&
               facts.snapshot.parserSidecars.declarationSpanIds[declarationRow] ==
                   facts.parserFunctionDeclarationSpanIds[
                       parserFunctionRow] &&
               facts.snapshot.parserSidecars.declarationNameSpanIds[declarationRow] ==
                   facts.parserFunctionNameSpanIds[parserFunctionRow]:
                declarationMatchCount = declarationMatchCount + 1
        if declarationMatchCount != 1:
            return csgCompilerWireFail(
                err, "parser executable function declaration bridge drift")
        executableParserSeen[parserFunctionRow] = true
    return true

@borrows
fn csgCompilerWireParserNodeBindingsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let nodeCount = facts.snapshot.parserNodes.sourceIds.len
    let sourceCount = facts.snapshot.sources.documentCids.len
    if nodeCount <= 0 ||
       nodeCount != facts.snapshot.parserNodes.producerNodeIds.len ||
       nodeCount != facts.snapshot.parserNodes.kinds.len ||
       nodeCount != facts.snapshot.parserNodes.spanIds.len ||
       nodeCount != facts.snapshot.parserNodes.bindingResolutionKinds.len ||
       nodeCount !=
           facts.snapshot.parserNodes.bindingDeclarationSourceLocalRows.len ||
       nodeCount !=
           facts.snapshot.parserNodes.bindingPatternSourceLocalRows.len:
        return csgCompilerWireFail(
            err, "parser node binding columns mismatch")
    var declarationStarts: int32[]
    var declarationCounts: int32[]
    var patternStarts: int32[]
    var patternCounts: int32[]
    setLen(declarationStarts, sourceCount)
    setLen(declarationCounts, sourceCount)
    setLen(patternStarts, sourceCount)
    setLen(patternCounts, sourceCount)
    for source in 0..<sourceCount:
        declarationStarts[source] = -1
        patternStarts[source] = -1
    for declarationRow in 0..<facts.snapshot.parserSidecars.declarationKinds.len:
        let source =
            facts.snapshot.parserSidecars.declarationProducerSourceIds[declarationRow]
        if declarationStarts[source] < 0:
            declarationStarts[source] = declarationRow
        declarationCounts[source] = declarationCounts[source] + 1
    for patternRow in 0..<facts.snapshot.parserSidecars.patternKinds.len:
        let source = facts.snapshot.parserSidecars.patternProducerSourceIds[patternRow]
        if patternStarts[source] < 0:
            patternStarts[source] = patternRow
        patternCounts[source] = patternCounts[source] + 1
    for parserNodeId in 0..<nodeCount:
        let source = facts.snapshot.parserNodes.sourceIds[parserNodeId]
        let resolutionKind =
            facts.snapshot.parserNodes.bindingResolutionKinds[parserNodeId]
        let declarationSourceLocalRow =
            facts.snapshot.parserNodes.bindingDeclarationSourceLocalRows[
                parserNodeId]
        let patternSourceLocalRow =
            facts.snapshot.parserNodes.bindingPatternSourceLocalRows[parserNodeId]
        if source < 0 || source >= sourceCount ||
           facts.snapshot.parserNodes.kinds[parserNodeId] <= 0 ||
           resolutionKind < CsgCoreParserBindingResolutionNone ||
           resolutionKind > CsgCoreParserBindingResolutionPattern:
            return csgCompilerWireFail(
                err, "parser node binding row invalid")
        if resolutionKind == CsgCoreParserBindingResolutionNone:
            if declarationSourceLocalRow != -1 ||
               patternSourceLocalRow != -1:
                return csgCompilerWireFail(
                    err, "unresolved parser node carries binding identity")
            continue
        if facts.snapshot.parserNodes.kinds[parserNodeId] !=
               CsgCoreParserValueExprIdentifier ||
           declarationSourceLocalRow < 0 ||
           declarationSourceLocalRow >= declarationCounts[source] ||
           declarationStarts[source] < 0:
            return csgCompilerWireFail(
                err, "parser binding declaration identity invalid")
        let declarationRow =
            declarationStarts[source] + declarationSourceLocalRow
        if resolutionKind ==
               CsgCoreParserBindingResolutionParameter:
            if facts.snapshot.parserSidecars.declarationKinds[declarationRow] != 5 ||
               patternSourceLocalRow != -1:
                return csgCompilerWireFail(
                    err, "parser parameter binding identity invalid")
            continue
        if facts.snapshot.parserSidecars.declarationKinds[declarationRow] != 6 ||
           patternSourceLocalRow < 0 ||
           patternSourceLocalRow >= patternCounts[source] ||
           patternStarts[source] < 0:
            return csgCompilerWireFail(
                err, "parser Pattern binding identity invalid")
        let patternRow = patternStarts[source] + patternSourceLocalRow
        if facts.snapshot.parserSidecars.patternBindingDeclarationIds[patternRow] !=
               declarationRow:
            return csgCompilerWireFail(
                err, "parser Pattern/declaration identity drift")
    return true

@borrows
fn csgCompilerWireParserFunctionsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let count = facts.snapshot.functions.symbolIds.len
    if count != facts.snapshot.functions.bodySpanIds.len ||
       count != facts.snapshot.functions.typedFunctionIndexes.len ||
       count != facts.snapshot.parserSidecars.functionBodySpanIds.len ||
       count != facts.snapshot.parserSidecars.functionIndexes.len ||
       count != facts.parserFunctionDeclarationSpanIds.len ||
       count != facts.parserFunctionNameTextIds.len ||
       count != facts.parserFunctionNameSpanIds.len ||
       count != facts.parserFunctionNameSurfaceKinds.len ||
       count != facts.parserFunctionNameProofCids.len ||
       count != facts.parserFunctionDeclarationHeaderCids.len ||
       count != facts.parserFunctionDeclarationPathCids.len ||
       count !=
           facts.snapshot.parserSidecars.functionAnnotationFlags.len ||
       count != facts.snapshot.functions.annotationFlags.len:
        return csgCompilerWireFail(
            err, "parser/function proof coverage mismatch")
    var functionSeen: bool[]
    setLen(functionSeen, count)
    for parserRow in 0..<count:
        let parserFunctionId =
            facts.snapshot.parserSidecars.functionIndexes[parserRow]
        if parserFunctionId < 0 || parserFunctionId >= count:
            return csgCompilerWireFail(
                err, "parser FunctionId bridge out of range")
        let producerFunctionIndex =
            facts.snapshot.functions.typedFunctionIndexes[
                parserFunctionId]
        if producerFunctionIndex < 0 || producerFunctionIndex >= count:
            return csgCompilerWireFail(
                err, "typed Function producer index out of range")
        let parserBodySpan = facts.snapshot.parserSidecars.functionBodySpanIds[parserRow]
        var functionId: int32 = -1
        for candidate in 0..<count:
            if facts.snapshot.functions.typedFunctionIndexes[candidate] !=
                   producerFunctionIndex:
                continue
            if functionId >= 0:
                return csgCompilerWireFail(
                    err, "typed Function identity is ambiguous")
            functionId = candidate
        if functionId < 0 ||
           functionId != parserFunctionId ||
           facts.snapshot.functions.bodySpanIds[functionId] != parserBodySpan ||
           functionSeen[functionId]:
            return csgCompilerWireFail(
                err, "parser/function typed identity remap")
        let symbolId = facts.snapshot.functions.symbolIds[functionId]
        if symbolId < 0 || symbolId >= facts.symbolDeclIds.len:
            return csgCompilerWireFail(err, "function SymbolId out of range")
        let declId = facts.symbolDeclIds[symbolId]
        let nameTextId = facts.parserFunctionNameTextIds[parserRow]
        let parserDeclarationRow =
            csgCompilerWireDeclarationForFunctionRow(facts, parserRow)
        if declId < 0 || declId >= facts.snapshot.declarations.declIds.len:
            return csgCompilerWireFail(
                err, "parser/function DeclId invalid")
        if parserDeclarationRow < 0:
            return csgCompilerWireFail(
                err, "parser/function declaration row missing")
        if facts.snapshot.parserSidecars.declarationProducerSourceIds[
               parserDeclarationRow] !=
               facts.snapshot.symbols.sourceIds[symbolId]:
            return csgCompilerWireFail(
                err, "parser/function source drift")
        if facts.parserDeclarationExportedFlags[parserDeclarationRow] !=
               facts.symbolExportedFlags[symbolId]:
            return csgCompilerWireFail(
                err, "parser/function export flag drift")
        if nameTextId < 0 || nameTextId >= facts.snapshot.texts.len:
            return csgCompilerWireFail(
                err, "parser/function name text invalid")
        if facts.snapshot.symbols.symbolKinds[symbolId] != 3 ||
           facts.symbolFunctionIds[symbolId] != functionId ||
           facts.symbolExternFunctionIds[symbolId] != -1:
            return csgCompilerWireFail(
                err, "parser/function Symbol kind drift")
        if facts.snapshot.symbols.declarationSpanIds[symbolId] !=
               facts.parserFunctionDeclarationSpanIds[parserRow]:
            return csgCompilerWireFail(
                err, "parser/function declaration span drift")
        if facts.snapshot.symbols.nameSpanIds[symbolId] !=
               facts.parserFunctionNameSpanIds[parserRow]:
            return csgCompilerWireFail(
                err, "parser/function name span drift")
        if facts.symbolNameTextIds[symbolId] != nameTextId:
            return csgCompilerWireFail(
                err, "parser/function name text drift")
        if facts.snapshot.declarations.nameSurfaceKinds[declId] !=
               facts.parserFunctionNameSurfaceKinds[parserRow]:
            return csgCompilerWireFail(
                err, "parser/function name surface drift")
        if facts.snapshot.declarations.canonicalNames[declId] !=
               facts.snapshot.texts[nameTextId]:
            return csgCompilerWireFail(
                err, "parser/function canonical name drift")
        if !csgCompilerWireCidEqual(
               facts.snapshot.declarations.parserValidatedNameProofCids[
                   declId],
               facts.parserFunctionNameProofCids[parserRow]):
            return csgCompilerWireFail(
                err, "parser/function name proof CID drift")
        if !csgCompilerWireCidEqual(
               facts.symbolDeclarationHeaderCids[symbolId],
               facts.parserFunctionDeclarationHeaderCids[parserRow]):
            return csgCompilerWireFail(
                err, "parser/function header CID drift")
        if !csgCompilerWireCidEqual(
               facts.symbolDeclarationPathCids[symbolId],
               facts.parserFunctionDeclarationPathCids[parserRow]):
            return csgCompilerWireFail(
                err, "parser/function path CID drift")
        if !snapshot_schema.CsgCompilerFunctionAnnotationFlagsValid(
               facts.snapshot.functions.annotationFlags[functionId]) ||
           !snapshot_schema.CsgCompilerFunctionAnnotationFlagsValid(
               facts.snapshot.parserSidecars.functionAnnotationFlags[
                   parserRow]) ||
           facts.snapshot.functions.annotationFlags[functionId] !=
               facts.snapshot.parserSidecars.functionAnnotationFlags[
                   parserRow]:
            return csgCompilerWireFail(
                err, "parser/function annotation flag drift")
        functionSeen[functionId] = true
    for functionId in 0..<count:
        if !functionSeen[functionId]:
            return csgCompilerWireFail(
                err, "parser/function proof row missing")
    return true

@borrows
fn csgCompilerWireManualConsumeValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let functionCount = facts.snapshot.functions.symbolIds.len
    let parserFunctionCount =
        facts.snapshot.parserSidecars.functionBodySpanIds.len
    if functionCount != parserFunctionCount ||
       functionCount != facts.snapshot.functions.typedFunctionIndexes.len ||
       parserFunctionCount !=
           facts.snapshot.parserSidecars.functionIndexes.len ||
       parserFunctionCount !=
           facts.snapshot.parserSidecars.functionAnnotationFlags.len ||
       parserFunctionCount !=
           facts.snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals.len ||
       parserFunctionCount !=
           facts.snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds.len ||
       parserFunctionCount !=
           facts.snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals.len ||
       parserFunctionCount !=
           facts.snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds.len ||
       functionCount !=
           facts.snapshot.functions.manualConsumeTargetParameterSymbolIds.len ||
       functionCount !=
           facts.snapshot.functions.manualConsumeSourceParameterSymbolIds.len ||
       functionCount !=
           facts.snapshot.functions.manualConsumeEffectCids.len:
        return csgCompilerWireFail(
            err, "manual consume column shape mismatch")
    var functionSeen: bool[]
    setLen(functionSeen, functionCount)
    for parserRow in 0..<parserFunctionCount:
        let parserFunctionId =
            facts.snapshot.parserSidecars.functionIndexes[parserRow]
        if parserFunctionId < 0 || parserFunctionId >= functionCount:
            return csgCompilerWireFail(
                err, "manual consume parser FunctionId out of range")
        let producerFunctionIndex =
            facts.snapshot.functions.typedFunctionIndexes[
                parserFunctionId]
        if producerFunctionIndex < 0 ||
           producerFunctionIndex >= functionCount:
            return csgCompilerWireFail(
                err, "manual consume typed Function index out of range")
        let parserBodySpan =
            facts.snapshot.parserSidecars.functionBodySpanIds[parserRow]
        var functionId: int32 = -1
        for candidate in 0..<functionCount:
            if facts.snapshot.functions.typedFunctionIndexes[candidate] !=
                   producerFunctionIndex:
                continue
            if functionId >= 0:
                return csgCompilerWireFail(
                    err, "manual consume typed Function identity ambiguous")
            functionId = candidate
        if functionId < 0 ||
           functionId != parserFunctionId ||
           facts.snapshot.functions.bodySpanIds[functionId] != parserBodySpan ||
           functionSeen[functionId]:
            return csgCompilerWireFail(
                err, "manual consume typed Function identity missing")
        functionSeen[functionId] = true
        let flags =
            facts.snapshot.parserSidecars.functionAnnotationFlags[
                parserRow]
        let targetOrdinal =
            facts.snapshot.parserSidecars.functionManualConsumeTargetParameterOrdinals[
                parserRow]
        let targetDeclaration =
            facts.snapshot.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
                parserRow]
        let sourceOrdinal =
            facts.snapshot.parserSidecars.functionManualConsumeSourceParameterOrdinals[
                parserRow]
        let sourceDeclaration =
            facts.snapshot.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
                parserRow]
        let targetSymbol =
            facts.snapshot.functions.manualConsumeTargetParameterSymbolIds[
                functionId]
        let sourceSymbol =
            facts.snapshot.functions.manualConsumeSourceParameterSymbolIds[
                functionId]
        let present =
            snapshot_schema.CsgCompilerFunctionAnnotationHas(
                flags,
                snapshot_schema.CsgCompilerFunctionAnnotationManualConsume)
        if !present:
            if targetOrdinal != -1 || targetDeclaration != -1 ||
               sourceOrdinal != -1 || sourceDeclaration != -1 ||
               targetSymbol != -1 || sourceSymbol != -1 ||
               !csgCompilerWireCidEqual(
                   facts.snapshot.functions.manualConsumeEffectCids[
                       functionId],
                   layout.FixedBytes32()):
                return csgCompilerWireFail(
                    err, "absent manual consume relation non-empty")
            continue
        let functionDeclaration =
            csgCompilerWireDeclarationForFunctionRow(facts, parserRow)
        if functionDeclaration < 0 ||
           targetOrdinal < 0 || sourceOrdinal < 0 ||
           targetOrdinal == sourceOrdinal ||
           targetDeclaration < 0 ||
           targetDeclaration >=
               facts.snapshot.parserSidecars.declarationKinds.len ||
           sourceDeclaration < 0 ||
           sourceDeclaration >=
               facts.snapshot.parserSidecars.declarationKinds.len ||
           targetDeclaration == sourceDeclaration ||
           facts.snapshot.parserSidecars.declarationKinds[
               targetDeclaration] != 5 ||
           facts.snapshot.parserSidecars.declarationKinds[
               sourceDeclaration] != 5 ||
           facts.snapshot.parserSidecars.declarationOwnerIds[
               targetDeclaration] != functionDeclaration ||
           facts.snapshot.parserSidecars.declarationOwnerIds[
               sourceDeclaration] != functionDeclaration:
            return csgCompilerWireFail(
                err, "manual consume parser relation invalid")
        var observedTargetOrdinal: int32 = -1
        var observedSourceOrdinal: int32 = -1
        var parameterOrdinal: int32
        for declarationRow in 0..<
                facts.snapshot.parserSidecars.declarationKinds.len:
            if facts.snapshot.parserSidecars.declarationKinds[
                   declarationRow] != 5 ||
               facts.snapshot.parserSidecars.declarationOwnerIds[
                   declarationRow] != functionDeclaration:
                continue
            if declarationRow == targetDeclaration:
                observedTargetOrdinal = parameterOrdinal
            if declarationRow == sourceDeclaration:
                observedSourceOrdinal = parameterOrdinal
            parameterOrdinal = parameterOrdinal + 1
        var expectedEffectCid: layout.FixedBytes32
        if observedTargetOrdinal != targetOrdinal ||
           observedSourceOrdinal != sourceOrdinal ||
           !snapshot_schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               facts.snapshot,
               functionId,
               expectedEffectCid,
               err) ||
           !csgCompilerWireCidEqual(
               facts.snapshot.functions.manualConsumeEffectCids[
                   functionId],
               expectedEffectCid):
            if err == "":
                err = "manual consume semantic effect drift"
            return false
    for functionId in 0..<functionCount:
        if !functionSeen[functionId]:
            return csgCompilerWireFail(
                err, "manual consume Function coverage missing")
    return true

@borrows
fn csgCompilerWireFunctionParameterOwnershipValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let functionCount = facts.snapshot.functions.symbolIds.len
    let typeCount = facts.snapshot.types.typeCids.len
    if functionCount !=
           facts.functionParameterOwnershipStarts.len ||
       functionCount !=
           facts.functionParameterOwnershipCounts.len ||
       typeCount != facts.snapshot.types.typeKinds.len ||
       typeCount != facts.typeArgStarts.len ||
       typeCount != facts.typeArgCounts.len ||
       typeCount != facts.snapshot.types.managedFlags.len:
        return csgCompilerWireFail(
            err, "function parameter ownership column shape mismatch")
    var ownershipCursor: int32
    for functionId in 0..<functionCount:
        let symbolId = facts.snapshot.functions.symbolIds[functionId]
        if symbolId < 0 || symbolId >= facts.snapshot.symbols.typeIds.len:
            return csgCompilerWireFail(
                err, "function parameter ownership SymbolId invalid")
        let functionTypeId = facts.snapshot.symbols.typeIds[symbolId]
        if functionTypeId < 0 || functionTypeId >= typeCount ||
           facts.snapshot.types.typeKinds[functionTypeId] !=
               CsgCoreCompilerTypeFunction:
            return csgCompilerWireFail(
                err, "function parameter ownership TypeId invalid")
        let typeArgStart = facts.typeArgStarts[functionTypeId]
        let typeArgCount = facts.typeArgCounts[functionTypeId]
        let ownershipStart =
            facts.functionParameterOwnershipStarts[functionId]
        let ownershipCount =
            facts.functionParameterOwnershipCounts[functionId]
        if typeArgStart < 0 || typeArgCount < 0 ||
           typeArgStart > facts.typeArgTypeIds.len ||
           typeArgCount >
               facts.typeArgTypeIds.len - typeArgStart ||
           ownershipStart != ownershipCursor ||
           ownershipCount != typeArgCount ||
           ownershipCount < 0 ||
           ownershipCount >
               facts.functionParameterOwnershipKinds.len -
                   ownershipCursor:
            return csgCompilerWireFail(
                err, "function parameter ownership CSR drift")
        for offset in 0..<ownershipCount:
            let parameterTypeId =
                facts.typeArgTypeIds[typeArgStart + offset]
            if parameterTypeId < 0 || parameterTypeId >= typeCount:
                return csgCompilerWireFail(
                    err, "function parameter ownership exact TypeId invalid")
            var expectedOwnershipKind =
                CsgCoreCompilerOwnershipUnmanaged
            if facts.snapshot.types.typeKinds[parameterTypeId] ==
                   CsgCoreCompilerTypeBorrow:
                expectedOwnershipKind =
                    CsgCoreCompilerOwnershipBorrowed
            elif facts.snapshot.types.managedFlags[parameterTypeId]:
                expectedOwnershipKind =
                    CsgCoreCompilerOwnershipOwned
            if facts.functionParameterOwnershipKinds[
                   ownershipCursor + offset] != expectedOwnershipKind:
                return csgCompilerWireFail(
                    err, "function parameter ownership Type proof drift")
        ownershipCursor = ownershipCursor + ownershipCount
    if ownershipCursor !=
           facts.functionParameterOwnershipKinds.len:
        return csgCompilerWireFail(
            err, "function parameter ownership coverage mismatch")
    return true

@borrows
fn csgCompilerWireFunctionResultOwnershipValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let functionCount = facts.snapshot.functions.symbolIds.len
    let annotationCount =
        facts.parserAnnotationProducerSourceIds.len
    if functionCount != facts.functionResultOwnershipKinds.len ||
       functionCount != facts.snapshot.functions.annotationFlags.len ||
       annotationCount != facts.parserAnnotationNameTokenIds.len ||
       annotationCount != facts.parserAnnotationArgRootCounts.len ||
       annotationCount != facts.annotationTargetParserRows.len ||
       annotationCount != facts.annotationTargetSymbolIds.len ||
       annotationCount != facts.annotationTargetDeclIds.len:
        return csgCompilerWireFail(
            err, "function result ownership column shape mismatch")
    for functionId in 0..<functionCount:
        let symbolId = facts.snapshot.functions.symbolIds[functionId]
        if symbolId < 0 ||
           symbolId >= facts.symbolFunctionIds.len ||
           symbolId >= facts.symbolDeclIds.len ||
           facts.symbolFunctionIds[symbolId] != functionId:
            return csgCompilerWireFail(
                err, "function result ownership FunctionId split")
        var borrowResultCount: int32
        for annotationTargetRow in 0..<annotationCount:
            if facts.annotationTargetSymbolIds[
                   annotationTargetRow] != symbolId:
                continue
            let parserAnnotationRow =
                facts.annotationTargetParserRows[
                    annotationTargetRow]
            if parserAnnotationRow < 0 ||
               parserAnnotationRow >= annotationCount:
                return csgCompilerWireFail(
                    err, "function result annotation row invalid")
            let nameTokenId =
                facts.parserAnnotationNameTokenIds[
                    parserAnnotationRow]
            if nameTokenId < 0 ||
               nameTokenId >= facts.tokenValueTextIds.len:
                return csgCompilerWireFail(
                    err, "function result annotation name missing")
            let nameTextId =
                facts.tokenValueTextIds[nameTokenId]
            if nameTextId < 0 || nameTextId >= facts.snapshot.texts.len:
                return csgCompilerWireFail(
                    err, "function result annotation text missing")
            if facts.snapshot.texts[nameTextId] != "borrow_result":
                continue
            if facts.parserAnnotationArgRootCounts[
                   parserAnnotationRow] != 0:
                return csgCompilerWireFail(
                    err, "@borrow_result function summary has arguments")
            if facts.annotationTargetDeclIds[
                   annotationTargetRow] !=
                   facts.symbolDeclIds[symbolId]:
                return csgCompilerWireFail(
                    err, "@borrow_result exact DeclId target drift")
            borrowResultCount = borrowResultCount + 1
        if borrowResultCount > 1:
            return csgCompilerWireFail(
                err, "duplicate @borrow_result function summary")
        let expected =
            borrowResultCount == 1 ?
                CsgCoreCompilerOwnershipBorrowed :
                CsgCoreCompilerOwnershipOwned
        let flags = facts.snapshot.functions.annotationFlags[functionId]
        let flagExpected =
            (flags & CsgCoreFunctionAnnotationBorrowResult) != 0 ?
                CsgCoreCompilerOwnershipBorrowed :
                CsgCoreCompilerOwnershipOwned
        if !snapshot_schema.CsgCompilerFunctionAnnotationFlagsValid(flags) ||
           expected != flagExpected ||
           facts.functionResultOwnershipKinds[functionId] != expected:
            return csgCompilerWireFail(
                err, "function result ownership annotation drift")
    return true

@borrows
fn csgCompilerWireAnnotationTargetsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let count = facts.annotationTargetSourceIds.len
    let annotationCount = facts.parserAnnotationProducerSourceIds.len
    let declarationCount = facts.snapshot.parserSidecars.declarationKinds.len
    let spanCount = facts.snapshot.spans.sourceIds.len
    let tokenCount = facts.tokenSourceIds.len
    if count != facts.annotationTargetParserRows.len ||
       count != facts.annotationTargetTokenIds.len ||
       count != facts.annotationTargetParserDeclarationRows.len ||
       count != facts.annotationTargetSymbolIds.len ||
       count != facts.annotationTargetDeclIds.len ||
       count != facts.annotationTargetDeclKeyCids.len ||
       count != annotationCount ||
       annotationCount != facts.parserAnnotationTargetTokenIds.len:
        return csgCompilerWireFail(
            err, "annotation target column shape mismatch")
    var startGroupBySpan: int32[]
    setLen(startGroupBySpan, spanCount)
    var startGroupCount: int32
    var previousSource: int32 = -1
    var previousStart: int32 = -1
    for spanId in 0..<spanCount:
        let sourceId = facts.snapshot.spans.sourceIds[spanId]
        let startByte = facts.snapshot.spans.startBytes[spanId]
        if sourceId < previousSource ||
           (sourceId == previousSource && startByte < previousStart):
            return csgCompilerWireFail(
                err, "annotation target span order drift")
        if spanId == 0 || sourceId != previousSource ||
           startByte != previousStart:
            startGroupCount = startGroupCount + 1
        startGroupBySpan[spanId] = startGroupCount - 1
        previousSource = sourceId
        previousStart = startByte
    var declarationByStartGroup: int32[]
    var declarationByNameToken: int32[]
    var symbolByParserDeclaration: int32[]
    setLen(declarationByStartGroup, startGroupCount)
    setLen(declarationByNameToken, tokenCount)
    setLen(symbolByParserDeclaration, declarationCount)
    for row in 0..<declarationByStartGroup.len:
        declarationByStartGroup[row] = -1
    for row in 0..<declarationByNameToken.len:
        declarationByNameToken[row] = -1
    for row in 0..<symbolByParserDeclaration.len:
        symbolByParserDeclaration[row] = -1
    for declarationRow in 0..<declarationCount:
        let spanId = facts.snapshot.parserSidecars.declarationSpanIds[declarationRow]
        let nameTokenId =
            facts.snapshot.parserSidecars.declarationNameTokenIds[declarationRow]
        if spanId < 0 || spanId >= spanCount:
            return csgCompilerWireFail(
                err, "annotation declaration span missing")
        let startGroup = startGroupBySpan[spanId]
        if declarationByStartGroup[startGroup] == -1:
            declarationByStartGroup[startGroup] = declarationRow
        else:
            declarationByStartGroup[startGroup] = -2
        if nameTokenId >= 0:
            if nameTokenId >= tokenCount ||
               declarationByNameToken[nameTokenId] >= 0:
                return csgCompilerWireFail(
                    err, "annotation declaration name token ambiguous")
            declarationByNameToken[nameTokenId] = declarationRow
    for symbolId in 0..<facts.symbolCids.len:
        let nameTokenId = facts.snapshot.symbols.nameTokenIds[symbolId]
        if nameTokenId < 0:
            continue
        if nameTokenId >= tokenCount:
            return csgCompilerWireFail(
                err, "annotation Symbol name token out of range")
        let declarationRow = declarationByNameToken[nameTokenId]
        if declarationRow < 0:
            if facts.snapshot.symbols.symbolKinds[symbolId] == 7:
                continue
            return csgCompilerWireFail(
                err, "annotation Symbol lacks parser declaration")
        if symbolByParserDeclaration[declarationRow] >= 0 ||
           facts.snapshot.symbols.sourceIds[symbolId] !=
               facts.snapshot.parserSidecars.declarationProducerSourceIds[declarationRow] ||
           facts.snapshot.symbols.nameSpanIds[symbolId] !=
               facts.snapshot.parserSidecars.declarationNameSpanIds[declarationRow] ||
           facts.snapshot.symbols.declarationSpanIds[symbolId] !=
               facts.snapshot.parserSidecars.declarationSpanIds[declarationRow]:
            return csgCompilerWireFail(
                err, "annotation declaration/Symbol relation drift")
        symbolByParserDeclaration[declarationRow] = symbolId
    var parserSeen: bool[]
    setLen(parserSeen, annotationCount)
    for row in 0..<count:
        let sourceId = facts.annotationTargetSourceIds[row]
        let parserRow = facts.annotationTargetParserRows[row]
        let targetTokenId = facts.annotationTargetTokenIds[row]
        let targetParserDeclaration =
            facts.annotationTargetParserDeclarationRows[row]
        let targetSymbolId = facts.annotationTargetSymbolIds[row]
        let targetDeclId = facts.annotationTargetDeclIds[row]
        let targetDeclKeyCid =
            facts.annotationTargetDeclKeyCids[row]
        if parserRow != row || parserRow < 0 ||
           parserRow >= annotationCount || parserSeen[parserRow] ||
           sourceId !=
               facts.parserAnnotationProducerSourceIds[parserRow] ||
           targetTokenId !=
               facts.parserAnnotationTargetTokenIds[parserRow] ||
           targetTokenId < 0 || targetTokenId >= tokenCount ||
           facts.tokenSourceIds[targetTokenId] != sourceId:
            return csgCompilerWireFail(
                err, "annotation target parser relation drift")
        let anchorSpanId = facts.tokenSpanIds[targetTokenId]
        if anchorSpanId < 0 || anchorSpanId >= spanCount:
            return csgCompilerWireFail(
                err, "annotation target anchor span missing")
        let exactDeclaration =
            declarationByStartGroup[startGroupBySpan[anchorSpanId]]
        if exactDeclaration < 0 ||
           targetParserDeclaration != exactDeclaration ||
           facts.snapshot.parserSidecars.declarationProducerSourceIds[exactDeclaration] !=
               sourceId ||
           targetSymbolId < 0 ||
           targetSymbolId >= facts.symbolCids.len ||
           symbolByParserDeclaration[exactDeclaration] != targetSymbolId ||
           targetDeclId < 0 ||
           targetDeclId >= facts.snapshot.declarations.declIds.len ||
           facts.symbolDeclIds[targetSymbolId] != targetDeclId ||
           !layout.FixedBytes32Equal(
               targetDeclKeyCid,
               facts.snapshot.declarations.declKeyCids[targetDeclId]) ||
           !layout.FixedBytes32Equal(
               targetDeclKeyCid,
               facts.snapshot.symbols.declKeyCids[targetSymbolId]):
            return csgCompilerWireFail(
                err, "annotation target exact identity drift")
        parserSeen[parserRow] = true
    for parserRow in 0..<parserSeen.len:
        if !parserSeen[parserRow]:
            return csgCompilerWireFail(
                err, "annotation target relation missing")
    return true

@borrows
fn csgCompilerWireExternFunctionsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let count = facts.externFunctionSymbolIds.len
    if count != facts.externFunctionParserDeclarationRows.len ||
       count != facts.externFunctionTypeIds.len ||
       count != facts.externFunctionExternalNameTextIds.len ||
       count != facts.externFunctionAbiKinds.len ||
       count != facts.externFunctionImportAnnotationRows.len ||
       count != facts.externFunctionInterfaceCids.len:
        return csgCompilerWireFail(
            err, "extern function column shape mismatch")
    var previousSymbolId: int32 = -1
    for externFunctionId in 0..<count:
        let symbolId =
            facts.externFunctionSymbolIds[externFunctionId]
        let parserDeclarationRow =
            facts.externFunctionParserDeclarationRows[externFunctionId]
        let typeId = facts.externFunctionTypeIds[externFunctionId]
        let externalNameTextId =
            facts.externFunctionExternalNameTextIds[externFunctionId]
        let importAnnotationRow =
            facts.externFunctionImportAnnotationRows[externFunctionId]
        if symbolId < 0 || symbolId >= facts.snapshot.symbols.symbolKinds.len ||
           symbolId <= previousSymbolId ||
           facts.snapshot.symbols.symbolKinds[symbolId] != 3 ||
           facts.symbolFunctionIds[symbolId] != -1 ||
           facts.symbolExternFunctionIds[symbolId] != externFunctionId ||
           parserDeclarationRow < 0 ||
           parserDeclarationRow >= facts.snapshot.parserSidecars.declarationKinds.len ||
           facts.snapshot.parserSidecars.declarationKinds[parserDeclarationRow] != 3 ||
           facts.snapshot.parserSidecars.declarationProducerSourceIds[
               parserDeclarationRow] != facts.snapshot.symbols.sourceIds[symbolId] ||
           facts.snapshot.parserSidecars.declarationNameTokenIds[
               parserDeclarationRow] != facts.snapshot.symbols.nameTokenIds[symbolId] ||
           facts.snapshot.parserSidecars.declarationNameSpanIds[
               parserDeclarationRow] != facts.snapshot.symbols.nameSpanIds[symbolId] ||
           facts.snapshot.parserSidecars.declarationSpanIds[
               parserDeclarationRow] !=
               facts.snapshot.symbols.declarationSpanIds[symbolId] ||
           typeId < 0 ||
           typeId >= facts.snapshot.types.typeKinds.len ||
           facts.snapshot.types.typeKinds[typeId] !=
               CsgCoreCompilerTypeFunction ||
           facts.snapshot.symbols.typeIds[symbolId] != typeId ||
           externalNameTextId < 0 ||
           externalNameTextId >= facts.snapshot.texts.len ||
           facts.snapshot.texts[externalNameTextId] == "" ||
           facts.externFunctionAbiKinds[externFunctionId] != 1 ||
           !csgCompilerWireCidEqual(
               facts.externFunctionInterfaceCids[externFunctionId],
               facts.symbolInterfaceCids[symbolId]) ||
           csgCompilerWireCidEqual(
               facts.externFunctionInterfaceCids[externFunctionId],
               layout.FixedBytes32()):
            return csgCompilerWireFail(
                err, "invalid extern function identity relation")
        if importAnnotationRow < 0:
            if externalNameTextId != facts.symbolNameTextIds[symbolId]:
                return csgCompilerWireFail(
                    err, "parser-native extern name drift")
        else:
            if importAnnotationRow >=
                   facts.parserAnnotationProducerSourceIds.len ||
               facts.parserAnnotationProducerSourceIds[
                   importAnnotationRow] != facts.snapshot.symbols.sourceIds[symbolId] ||
               importAnnotationRow >=
                   facts.annotationTargetParserRows.len ||
               facts.annotationTargetParserRows[importAnnotationRow] !=
                   importAnnotationRow ||
               facts.annotationTargetSymbolIds[importAnnotationRow] !=
                   symbolId:
                return csgCompilerWireFail(
                    err, "extern annotation identity drift")
        previousSymbolId = symbolId
    return true

@borrows
fn csgCompilerWireTypedNodeBindingsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    if !snapshot_schema.CsgCompilerTypedStatementOwnerAuthorityStrictValidateInto(
           facts.snapshot, err) ||
       !snapshot_schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
           facts.snapshot, err):
        return false
    return snapshot_schema.CsgCompilerBindingReferencesStrictValidateInto(
        facts.snapshot, err)

@borrows
fn csgCompilerWireReferencesValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let referenceCount = facts.snapshot.references.sourceIds.len
    if referenceCount != facts.snapshot.references.spanIds.len ||
       referenceCount != facts.snapshot.references.ownerFunctionIds.len ||
       referenceCount != facts.snapshot.references.ownerSymbolIds.len ||
       referenceCount != facts.snapshot.references.targetSymbolIds.len ||
       referenceCount != facts.snapshot.references.referenceKinds.len ||
       referenceCount != facts.snapshot.references.bindingTypedNodeIds.len:
        return csgCompilerWireFail(err, "reference column shape mismatch")
    for referenceId in 0..<referenceCount:
        let sourceId = facts.snapshot.references.sourceIds[referenceId]
        let spanId = facts.snapshot.references.spanIds[referenceId]
        let ownerFunctionId =
            facts.snapshot.references.ownerFunctionIds[referenceId]
        let ownerSymbolId = facts.snapshot.references.ownerSymbolIds[referenceId]
        let targetSymbolId = facts.snapshot.references.targetSymbolIds[referenceId]
        let referenceKind = facts.snapshot.references.referenceKinds[referenceId]
        if sourceId < 0 ||
           sourceId >= facts.snapshot.sources.documentCids.len ||
           spanId < 0 || spanId >= facts.snapshot.spans.sourceIds.len ||
           facts.snapshot.spans.sourceIds[spanId] != sourceId ||
           ownerSymbolId < 0 ||
           ownerSymbolId >= facts.snapshot.symbols.symbolKinds.len ||
           facts.snapshot.symbols.sourceIds[ownerSymbolId] != sourceId ||
           targetSymbolId < 0 ||
           targetSymbolId >= facts.snapshot.symbols.symbolKinds.len ||
           referenceKind < 1 || referenceKind > 5:
            return csgCompilerWireFail(err, "invalid reference row")
        let ownerKind = facts.snapshot.symbols.symbolKinds[ownerSymbolId]
        if ownerKind == 3:
            if ownerFunctionId < 0 ||
               ownerFunctionId >= facts.snapshot.functions.symbolIds.len ||
               facts.snapshot.functions.symbolIds[ownerFunctionId] != ownerSymbolId:
                return csgCompilerWireFail(
                    err, "reference Function owner split")
        elif ownerKind != 1 && ownerKind != 2:
            return csgCompilerWireFail(
                err, "invalid reference semantic owner")
        elif ownerFunctionId != -1:
            return csgCompilerWireFail(
                err, "non-Function reference owner has FunctionId")
        let targetKind = facts.snapshot.symbols.symbolKinds[targetSymbolId]
        if (referenceKind == 3 && targetKind != 3) ||
           (referenceKind == 4 && targetKind != 2) ||
           (referenceKind == 5 && targetKind != 1):
            return csgCompilerWireFail(
                err, "reference target kind mismatch")
        if referenceId > 0:
            let previousTarget =
                facts.snapshot.references.targetSymbolIds[referenceId - 1]
            let previousSource =
                facts.snapshot.references.sourceIds[referenceId - 1]
            let previousSpan =
                facts.snapshot.references.spanIds[referenceId - 1]
            let previousTyped =
                facts.snapshot.references.bindingTypedNodeIds[
                    referenceId - 1]
            let typed =
                facts.snapshot.references.bindingTypedNodeIds[
                    referenceId]
            if targetSymbolId < previousTarget ||
               (targetSymbolId == previousTarget &&
                sourceId < previousSource) ||
               (targetSymbolId == previousTarget &&
                sourceId == previousSource &&
                spanId < previousSpan) ||
               (targetSymbolId == previousTarget &&
                sourceId == previousSource &&
                spanId == previousSpan &&
                typed <= previousTyped):
                return csgCompilerWireFail(
                    err, "references are not canonical")
    let callCount = facts.callReferenceIds.len
    if callCount != facts.callCallerFunctionIds.len ||
       callCount != facts.callCalleeSymbolIds.len ||
       callCount != facts.callTargetCallDeclarationRows.len ||
       callCount != facts.callTargetSourceIds.len ||
       callCount !=
           facts.callTargetSourceLocalDeclarationRows.len ||
       callCount != facts.callTargetParserDeclarationRows.len ||
       callCount != facts.callTargetDeclIds.len ||
       callCount != facts.callTargetDeclKeyCids.len ||
       callCount != facts.callTargetSymbolCids.len ||
       callCount != facts.callResultTypedNodeIds.len ||
       callCount != facts.callResultValueDefinitionRows.len ||
       callCount != facts.callResultTypeIds.len ||
       callCount != facts.callResultOwnershipKinds.len ||
       callCount != facts.callResultOwnershipProofKinds.len ||
       callCount != facts.callResultOwnershipProofCids.len:
        return csgCompilerWireFail(err, "call column shape mismatch")
    for callId in 0..<callCount:
        let referenceId = facts.callReferenceIds[callId]
        let callerFunctionId = facts.callCallerFunctionIds[callId]
        let calleeSymbolId = facts.callCalleeSymbolIds[callId]
        let targetCallDeclarationRow =
            facts.callTargetCallDeclarationRows[callId]
        let targetSourceId = facts.callTargetSourceIds[callId]
        let targetLocalDeclarationRow =
            facts.callTargetSourceLocalDeclarationRows[callId]
        let targetParserDeclarationRow =
            facts.callTargetParserDeclarationRows[callId]
        let targetDeclId = facts.callTargetDeclIds[callId]
        let resultTypedNodeId =
            facts.callResultTypedNodeIds[callId]
        let resultValueDefinitionRow =
            facts.callResultValueDefinitionRows[callId]
        let resultTypeId = facts.callResultTypeIds[callId]
        let resultOwnershipKind =
            facts.callResultOwnershipKinds[callId]
        let resultOwnershipProofKind =
            facts.callResultOwnershipProofKinds[callId]
        if referenceId < 0 || referenceId >= referenceCount ||
           callerFunctionId < 0 ||
           callerFunctionId >= facts.snapshot.functions.symbolIds.len ||
           calleeSymbolId < 0 ||
           calleeSymbolId >= facts.snapshot.symbols.symbolKinds.len ||
           facts.snapshot.references.referenceKinds[referenceId] != 3 ||
           facts.snapshot.references.ownerFunctionIds[referenceId] !=
               callerFunctionId ||
           facts.snapshot.references.ownerSymbolIds[referenceId] !=
               facts.snapshot.functions.symbolIds[callerFunctionId] ||
           facts.snapshot.references.targetSymbolIds[referenceId] !=
               calleeSymbolId ||
           facts.snapshot.references.bindingTypedNodeIds[referenceId] != -1 ||
           facts.snapshot.symbols.symbolKinds[calleeSymbolId] != 3 ||
           targetCallDeclarationRow < 0 ||
           targetSourceId < 0 ||
           targetSourceId >= facts.snapshot.sources.documentCids.len ||
           facts.snapshot.symbols.sourceIds[calleeSymbolId] != targetSourceId ||
           targetParserDeclarationRow < 0 ||
           targetParserDeclarationRow >=
               facts.snapshot.parserSidecars.declarationKinds.len ||
           facts.snapshot.parserSidecars.declarationProducerSourceIds[
               targetParserDeclarationRow] != targetSourceId ||
           facts.snapshot.parserSidecars.declarationSourceLocalRows[
               targetParserDeclarationRow] !=
               targetLocalDeclarationRow ||
           facts.snapshot.parserSidecars.declarationKinds[
               targetParserDeclarationRow] != 3 ||
           facts.snapshot.parserSidecars.declarationNameTokenIds[
               targetParserDeclarationRow] !=
               facts.snapshot.symbols.nameTokenIds[calleeSymbolId] ||
           facts.snapshot.parserSidecars.declarationSpanIds[
               targetParserDeclarationRow] !=
               facts.snapshot.symbols.declarationSpanIds[calleeSymbolId] ||
           targetDeclId < 0 ||
           targetDeclId >= facts.snapshot.declarations.declIds.len ||
           facts.snapshot.declarations.declIds[targetDeclId] != targetDeclId ||
           facts.snapshot.declarations.declarationKinds[targetDeclId] !=
               declaration.SemanticSnapshotDeclarationKindFunction ||
           facts.symbolDeclIds[calleeSymbolId] != targetDeclId ||
           !csgCompilerWireCidEqual(
               facts.callTargetDeclKeyCids[callId],
               facts.snapshot.declarations.declKeyCids[targetDeclId]) ||
           !csgCompilerWireCidEqual(
               facts.callTargetDeclKeyCids[callId],
               facts.snapshot.symbols.declKeyCids[calleeSymbolId]) ||
           !csgCompilerWireCidEqual(
               facts.callTargetSymbolCids[callId],
               facts.symbolCids[calleeSymbolId]) ||
           csgCompilerWireCidEqual(
               facts.callTargetDeclKeyCids[callId],
               layout.FixedBytes32()) ||
           csgCompilerWireCidEqual(
               facts.callTargetSymbolCids[callId],
               layout.FixedBytes32()) ||
           resultTypedNodeId < 0 ||
           resultTypedNodeId >= facts.snapshot.typedNodes.functionIds.len ||
           resultTypedNodeId >= facts.snapshot.typedNodes.opKinds.len ||
           resultTypedNodeId >= facts.snapshot.typedNodes.typeIds.len ||
           resultTypedNodeId >= facts.snapshot.typedNodes.ownershipKinds.len ||
           resultTypedNodeId >=
               facts.typedNodeOwnershipProofKinds.len ||
           resultTypedNodeId >= facts.snapshot.typedNodes.spanIds.len ||
           resultTypedNodeId >=
               facts.snapshot.typedNodes.producedValueDefinitionRows.len ||
           resultValueDefinitionRow < 0 ||
           resultValueDefinitionRow >=
               facts.snapshot.valueDefinitions.functionIds.len ||
           resultValueDefinitionRow >=
               facts.snapshot.valueDefinitions.originKinds.len ||
           resultValueDefinitionRow >=
               facts.snapshot.valueDefinitions.definingTypedNodeIds.len ||
           facts.snapshot.typedNodes.functionIds[resultTypedNodeId] !=
               callerFunctionId ||
           facts.snapshot.typedNodes.producedValueDefinitionRows[
               resultTypedNodeId] != resultValueDefinitionRow ||
           facts.snapshot.valueDefinitions.functionIds[
               resultValueDefinitionRow] != callerFunctionId ||
           facts.snapshot.valueDefinitions.definingTypedNodeIds[
               resultValueDefinitionRow] != resultTypedNodeId ||
           (facts.snapshot.valueDefinitions.originKinds[
                resultValueDefinitionRow] !=
                snapshot_schema.CsgCompilerValueDefinitionOriginBindingInitializer &&
            facts.snapshot.valueDefinitions.originKinds[
                resultValueDefinitionRow] !=
                snapshot_schema.CsgCompilerValueDefinitionOriginCallResult) ||
           facts.snapshot.typedNodes.opKinds[resultTypedNodeId] != 66 ||
           facts.snapshot.typedNodes.spanIds[resultTypedNodeId] !=
               facts.snapshot.references.spanIds[referenceId] ||
           facts.snapshot.typedNodes.typeIds[resultTypedNodeId] != resultTypeId ||
           resultTypeId < 0 || resultTypeId >= facts.snapshot.types.typeCids.len ||
           facts.snapshot.typedNodes.ownershipKinds[resultTypedNodeId] !=
               resultOwnershipKind ||
           (resultOwnershipKind != CsgCoreCompilerOwnershipOwned &&
            resultOwnershipKind != CsgCoreCompilerOwnershipBorrowed &&
            resultOwnershipKind !=
                CsgCoreCompilerOwnershipUnmanaged) ||
           facts.typedNodeOwnershipProofKinds[resultTypedNodeId] !=
               resultOwnershipProofKind ||
           resultOwnershipProofKind < 1 ||
           resultOwnershipProofKind > 3 ||
           csgCompilerWireCidEqual(
               facts.callResultOwnershipProofCids[callId],
               layout.FixedBytes32()) ||
           (callId > 0 &&
            referenceId <= facts.callReferenceIds[callId - 1]):
            return csgCompilerWireFail(
                err, "invalid exact Call reference join")
        let targetFunctionId =
            facts.symbolFunctionIds[calleeSymbolId]
        let targetExternFunctionId =
            facts.symbolExternFunctionIds[calleeSymbolId]
        if (targetFunctionId >= 0) == (targetExternFunctionId >= 0):
            return csgCompilerWireFail(
                err, "call target function domain drift")
        if targetFunctionId >= 0:
            if targetFunctionId >= facts.snapshot.functions.bodySpanIds.len ||
               targetFunctionId >=
                   facts.functionResultOwnershipKinds.len ||
               resultTypeId >= facts.snapshot.types.managedFlags.len:
                return csgCompilerWireFail(
                    err, "call target FunctionId out of range")
            let expectedResultOwnership =
                facts.snapshot.types.managedFlags[resultTypeId] ?
                    facts.functionResultOwnershipKinds[
                        targetFunctionId] :
                    CsgCoreCompilerOwnershipUnmanaged
            if resultOwnershipKind != expectedResultOwnership:
                return csgCompilerWireFail(
                    err, "call result ownership disagrees with callee summary")
            var parserFunctionRow: int32 = -1
            for candidate in 0..<facts.snapshot.parserSidecars.functionBodySpanIds.len:
                if facts.snapshot.parserSidecars.functionBodySpanIds[candidate] ==
                       facts.snapshot.functions.bodySpanIds[targetFunctionId]:
                    if parserFunctionRow >= 0:
                        return csgCompilerWireFail(
                            err, "call target parser Function ambiguous")
                    parserFunctionRow = candidate
            if parserFunctionRow < 0 ||
               csgCompilerWireDeclarationForFunctionRow(
                   facts, parserFunctionRow) !=
                   targetParserDeclarationRow:
                return csgCompilerWireFail(
                    err, "call target Function parser row drift")
        elif targetExternFunctionId >=
                 facts.externFunctionSymbolIds.len ||
             facts.externFunctionSymbolIds[
                 targetExternFunctionId] != calleeSymbolId ||
             facts.externFunctionParserDeclarationRows[
                 targetExternFunctionId] !=
                 targetParserDeclarationRow ||
             facts.externFunctionTypeIds[targetExternFunctionId] !=
                 facts.snapshot.symbols.typeIds[calleeSymbolId] ||
             !csgCompilerWireCidEqual(
                 facts.externFunctionInterfaceCids[
                     targetExternFunctionId],
                 facts.symbolInterfaceCids[calleeSymbolId]):
            return csgCompilerWireFail(
                err, "call target ExternFunction row drift")
    return true

@borrows
fn csgCompilerWireTypeSyntaxIdentityValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    let count = facts.parserTypeSyntaxKinds.len
    if count != facts.parserTypeSyntaxSourceIds.len ||
       count != facts.parserTypeSyntaxProducerSourceIds.len ||
       count != facts.parserTypeSyntaxSourceLocalRows.len:
        return csgCompilerWireFail(
            err, "TypeSyntax source-local identity columns mismatch")
    var sourceRows: int32[]
    setLen(sourceRows, facts.snapshot.sources.documentCids.len)
    for row in 0..<count:
        let source = facts.parserTypeSyntaxSourceIds[row]
        if source < 0 || source >= sourceRows.len ||
           facts.parserTypeSyntaxProducerSourceIds[row] != source ||
           facts.parserTypeSyntaxSourceLocalRows[row] !=
               sourceRows[source] ||
           facts.parserTypeSyntaxKinds[row] <= 0:
            return csgCompilerWireFail(
                err, "TypeSyntax source-local identity invalid")
        sourceRows[source] = sourceRows[source] + 1
    return true

@borrows
fn csgCompilerWireDiagnosticsValidateInto(
        facts: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    if !snapshot_schema.CsgCompilerDiagnosticAuthorityStrictValidateInto(
           facts.snapshot, err):
        return false
    return snapshot_schema.CsgCompilerDiagnosticDenominatorStrictValidateInto(
        facts.snapshot, err)

@borrows
fn CsgCoreValidateChengCompilerSnapshotWireInto(
        lines: str[],
        err: var str): bool =
    err = ""
    # Merkle admission reorders facts by partition key. Snapshot identity
    # is the kind, not lines[1].
    var lineIndex: int32
    while lineIndex < lines.len:
        let kind = jfield.CsgCoreJsonKind(lines[lineIndex])
        if kind.found &&
           kind.value == "csg_dialect::cheng_compiler::snapshot":
            let physicalSoa = jfield.CsgCoreJsonTopRawField(
                lines[lineIndex], "physicalSoa")
            if physicalSoa.found && csgRawFieldIsTrue(physicalSoa.value):
                # SoA columns stay packed in the CSGC physical stream. JSON
                # facts only carry kind/index identity; table relations were
                # already StrictValidate'd on the live SoA producer.
                return true
        lineIndex = lineIndex + 1
    var facts: CsgCoreChengCompilerWireFacts
    if !csgCompilerWireDecodeInto(lines, facts, err):
        return false
    var valid = declaration.SemanticSnapshotDeclarationTableStrictValidateInto(
        facts.snapshot.declarations, err)
    if valid:
        valid = csgCompilerWireGenericTypesValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireSymbolsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireParserDeclarationsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireParserPatternsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireParserNodeBindingsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireFunctionParameterOwnershipValidateInto(
            facts, err)
    if valid:
        valid = csgCompilerWireParserFunctionsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireManualConsumeValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireAnnotationTargetsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireFunctionResultOwnershipValidateInto(
            facts, err)
    if valid:
        valid = csgCompilerWireExternFunctionsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireTypedNodeBindingsValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireReferencesValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireTypeSyntaxIdentityValidateInto(facts, err)
    if valid:
        valid = csgCompilerWireDiagnosticsValidateInto(facts, err)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        facts.snapshot.declarations)
    if !valid && err == "":
        err = " csg compiler wire: semantic relation validation failed"
    return valid

@borrows
fn csgCompilerParserDiagnosticAuthorityWireValidateInto(
        line: str,
        artifact: var diagnostic_failure.DiagnosticFailureArtifact,
        err: var str): bool =
    var authority: diagnostic_authority.ParserDiagnosticAuthority
    var expectedProducerProjectionCids: layout.FixedBytes32[]
    if !csgCompilerWireIntField(
           line, "schemaVersion", authority.schemaVersion, err) ||
       !csgCompilerWireIntArrayField(
           line, "authorityKinds", authority.authorityKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "parserLocalProducerSourceRows",
           authority.parserLocalProducerSourceRows, err) ||
       !csgCompilerWireIntArrayField(
           line, "portableProducerSourceIndexes",
           authority.portableProducerSourceIndexes, err) ||
       !csgCompilerWireIntArrayField(
           line, "producerSourceByteLengths",
           authority.producerSourceByteLengths, err) ||
       !csgCompilerWireCidArrayField(
           line, "producerContentCids",
           authority.producerContentCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "parserInputCids", authority.parserInputCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "sourceSidecarCids",
           authority.sourceSidecarCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "diagnosticCompletionCids",
           authority.diagnosticCompletionCids, err) ||
       !csgCompilerWireIntArrayField(
           line, "anchorKinds", authority.anchorKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "canonicalParserNodeRows",
           authority.canonicalParserNodeRows, err) ||
       !csgCompilerWireIntArrayField(
           line, "producerParserNodeRows",
           authority.producerParserNodeRows, err) ||
       !csgCompilerWireIntArrayField(
           line, "parserNodeKinds", authority.parserNodeKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "parserNodeSpanStartBytes",
           authority.parserNodeSpanStartBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "parserNodeSpanEndBytes",
           authority.parserNodeSpanEndBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDeclarationSourceLocalRows",
           authority.ownerDeclarationSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDeclarationKinds",
           authority.ownerDeclarationKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDeclarationSpanStartBytes",
           authority.ownerDeclarationSpanStartBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDeclarationSpanEndBytes",
           authority.ownerDeclarationSpanEndBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "diagnosticSpanIds",
           authority.diagnosticSpanIds, err) ||
       !csgCompilerWireIntArrayField(
           line, "diagnosticSpanStartBytes",
           authority.diagnosticSpanStartBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "diagnosticSpanEndBytes",
           authority.diagnosticSpanEndBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "severities", authority.severities, err) ||
       !csgCompilerWireTextArrayField(
           line, "codes", authority.codes, err) ||
       !csgCompilerWireTextArrayField(
           line, "messages", authority.messages, err) ||
       !csgCompilerWireCidArrayField(
           line, "producerProjectionCids",
           authority.producerProjectionCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "proofCids", authority.proofCids, err) ||
       !csgCompilerWireCidField(
           line, "authorityRootCid",
           authority.authorityRootCid, err) ||
       !csgCompilerWireCidArrayField(
           line, "expectedProducerProjectionCids",
           expectedProducerProjectionCids, err):
        return false
    if !diagnostic_authority.ParserDiagnosticAuthorityStrictValidateInto(
           authority, expectedProducerProjectionCids, err):
        return false
    if authority.authorityKinds.len != 1 ||
       artifact.producerKinds.len != 1 ||
       !layout.FixedBytes32Equal(
           artifact.parserDiagnosticAuthorityRootCid,
           authority.authorityRootCid):
        err = " csg compiler failure wire: structured authority split"
        return false
    let artifactAnchor = artifact.anchorKinds[0]
    let authorityAnchor = authority.anchorKinds[0]
    var anchorMatches = false
    if artifactAnchor ==
           diagnostic_failure.DiagnosticFailureAnchorParserNode:
        anchorMatches =
            authorityAnchor ==
                diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNode
    elif artifactAnchor ==
             diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration:
        anchorMatches =
            authorityAnchor ==
                diagnostic_authority.ParserDiagnosticAuthorityAnchorOwnerDeclaration
    elif artifactAnchor ==
             diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration:
        anchorMatches =
            authorityAnchor ==
                diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration
    if !anchorMatches ||
       authority.parserLocalProducerSourceRows[0] != 0 ||
       authority.portableProducerSourceIndexes[0] !=
           artifact.producerSourceIndexes[0] ||
       authority.producerSourceByteLengths[0] !=
           artifact.producerSourceByteLengths[0] ||
       !layout.FixedBytes32Equal(
           authority.producerContentCids[0],
           artifact.producerContentCids[0]) ||
       authority.producerParserNodeRows[0] !=
           artifact.parserNodeIds[0] ||
       authority.ownerDeclarationSourceLocalRows[0] !=
           artifact.ownerDeclarationSourceLocalRows[0] ||
       authority.diagnosticSpanStartBytes[0] !=
           artifact.spanStartBytes[0] ||
       authority.diagnosticSpanEndBytes[0] !=
           artifact.spanEndBytes[0] ||
       artifact.severities[0] !=
           diagnostic_failure.DiagnosticFailureSeverityError ||
       authority.severities[0] !=
           diagnostic_authority.ParserDiagnosticAuthoritySeverityError ||
       authority.codes[0] != artifact.codes[0] ||
       authority.messages[0] != artifact.messages[0]:
        err = " csg compiler failure wire: structured authority projection split"
        return false
    err = ""
    return true

@borrows
fn csgCompilerDiagnosticFailureWireValidateInto(
        lines: str[],
        err: var str): bool =
    var artifactLine: int32 = -1
    for index in 0..<lines.len:
        let kind = jfield.CsgCoreJsonKind(lines[index])
        if kind.found &&
           kind.value ==
               "csg_dialect::cheng_compiler::diagnostic_failure_artifact":
            if artifactLine >= 0:
                err = " csg compiler failure wire: duplicate artifact"
                return false
            artifactLine = index
    if artifactLine < 0:
        err = ""
        return true
    if lines[0] !=
           "{\"features\":[\"compiler_semantic_snapshot_failure\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}":
        err = " csg compiler failure wire: artifact family split"
        return false
    let standaloneArtifact = lines.len == 2 && artifactLine == 1
    let canonicalFailure =
        (lines.len == 6 || lines.len == 7) && artifactLine == 5
    if !standaloneArtifact && !canonicalFailure:
        err = " csg compiler failure wire: artifact family split"
        return false
    if canonicalFailure:
        let metadataKind = jfield.CsgCoreJsonKind(lines[1])
        let sourcesKind = jfield.CsgCoreJsonKind(lines[2])
        let dependenciesKind = jfield.CsgCoreJsonKind(lines[3])
        let diagnosticsKind = jfield.CsgCoreJsonKind(lines[4])
        if !metadataKind.found ||
           metadataKind.value !=
               "csg_dialect::cheng_compiler::snapshot_failure" ||
           !sourcesKind.found ||
           sourcesKind.value !=
               "csg_dialect::cheng_compiler::failure_sources" ||
           !dependenciesKind.found ||
           dependenciesKind.value !=
               "csg_dialect::cheng_compiler::failure_dependencies" ||
           !diagnosticsKind.found ||
           diagnosticsKind.value !=
               "csg_dialect::cheng_compiler::failure_diagnostics":
            err = " csg compiler failure wire: canonical family split"
            return false
        if lines.len == 7:
            let authorityKind = jfield.CsgCoreJsonKind(lines[6])
            if !authorityKind.found ||
               authorityKind.value !=
                   "csg_dialect::cheng_compiler::parser_diagnostic_authority":
                err = " csg compiler failure wire: canonical authority split"
                return false
    let line = lines[artifactLine]
    var artifact: diagnostic_failure.DiagnosticFailureArtifact
    if !csgCompilerWireIntField(
           line, "schemaVersion", artifact.schemaVersion, err) ||
       !csgCompilerWireIntArrayField(
           line, "producerKinds", artifact.producerKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "producerSourceIndexes",
           artifact.producerSourceIndexes, err) ||
       !csgCompilerWireIntArrayField(
           line, "producerSourceSnapshotCounts",
           artifact.producerSourceSnapshotCounts, err) ||
       !csgCompilerWireIntArrayField(
           line, "producerSourceByteLengths",
           artifact.producerSourceByteLengths, err) ||
       !csgCompilerWireCidArrayField(
           line, "producerSourceIdentityReceiptCids",
           artifact.producerSourceIdentityReceiptCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "producerDocumentCids",
           artifact.producerDocumentCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "producerContentCids",
           artifact.producerContentCids, err) ||
       !csgCompilerWireIntArrayField(
           line, "anchorKinds", artifact.anchorKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "parserNodeIds", artifact.parserNodeIds, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDeclarationSourceLocalRows",
           artifact.ownerDeclarationSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
           line, "spanStartBytes", artifact.spanStartBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "spanEndBytes", artifact.spanEndBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "severities", artifact.severities, err) ||
       !csgCompilerWireTextArrayField(
           line, "codes", artifact.codes, err) ||
       !csgCompilerWireTextArrayField(
           line, "messages", artifact.messages, err) ||
       !csgCompilerWireCidArrayField(
           line, "proofCids", artifact.proofCids, err) ||
       !csgCompilerWireCidField(
           line, "parserDiagnosticAuthorityRootCid",
           artifact.parserDiagnosticAuthorityRootCid, err) ||
       !csgCompilerWireCidField(
           line, "receiptCid", artifact.receiptCid, err):
        return false
    if !diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
           artifact, err):
        return false
    let artifactAnchor = artifact.anchorKinds[0]
    let structuralArtifact =
        artifactAnchor ==
            diagnostic_failure.DiagnosticFailureAnchorParserNode ||
        artifactAnchor ==
            diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration ||
        artifactAnchor ==
            diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration
    let authorityRootObserved =
        !layout.FixedBytes32Equal(
            artifact.parserDiagnosticAuthorityRootCid,
            layout.FixedBytes32())
    if standaloneArtifact:
        if structuralArtifact || authorityRootObserved:
            err = " csg compiler failure wire: structural authority required"
            return false
        err = ""
        return true
    if structuralArtifact:
        if lines.len != 7 ||
           !csgCompilerParserDiagnosticAuthorityWireValidateInto(
               lines[6], artifact, err):
            if err == "":
                err = " csg compiler failure wire: structural authority required"
            return false
    elif lines.len != 6 || authorityRootObserved:
        err = " csg compiler failure wire: source/span diagnostic invented parser authority"
        return false
    var sourceIdentityKind: int32
    var sourceIdentityReceiptCid: layout.FixedBytes32
    var sourceDocumentCids: layout.FixedBytes32[]
    var sourceContentCids: layout.FixedBytes32[]
    var sourceProducerIndexes: int32[]
    var diagnosticSourceIds: int32[]
    var diagnosticStartBytes: int32[]
    var diagnosticEndBytes: int32[]
    var diagnosticProducerKinds: int32[]
    var diagnosticSeverities: int32[]
    var diagnosticCodes: str[]
    var diagnosticMessages: str[]
    if !csgCompilerWireIntField(
           lines[1], "sourceIdentityKind",
           sourceIdentityKind, err) ||
       !csgCompilerWireCidField(
           lines[1], "sourceIdentityReceiptCid",
           sourceIdentityReceiptCid, err) ||
       !csgCompilerWireCidArrayField(
           lines[2], "documentCids", sourceDocumentCids, err) ||
       !csgCompilerWireCidArrayField(
           lines[2], "contentCids", sourceContentCids, err) ||
       !csgCompilerWireIntArrayField(
           lines[2], "producerIndexes",
           sourceProducerIndexes, err) ||
       !csgCompilerWireIntArrayField(
           lines[4], "sourceIds", diagnosticSourceIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[4], "startBytes", diagnosticStartBytes, err) ||
       !csgCompilerWireIntArrayField(
           lines[4], "endBytes", diagnosticEndBytes, err) ||
       !csgCompilerWireIntArrayField(
           lines[4], "producerKinds",
           diagnosticProducerKinds, err) ||
       !csgCompilerWireIntArrayField(
           lines[4], "severities", diagnosticSeverities, err) ||
       !csgCompilerWireTextArrayField(
           lines[4], "codes", diagnosticCodes, err) ||
       !csgCompilerWireTextArrayField(
           lines[4], "messages", diagnosticMessages, err):
        return false
    let sourceCount = sourceDocumentCids.len
    if sourceIdentityKind != 2 ||
       sourceCount <= 0 ||
       sourceContentCids.len != sourceCount ||
       sourceProducerIndexes.len != sourceCount ||
       diagnosticSourceIds.len != sourceCount ||
       diagnosticStartBytes.len != sourceCount ||
       diagnosticEndBytes.len != sourceCount ||
       diagnosticProducerKinds.len != sourceCount ||
       diagnosticSeverities.len != sourceCount ||
       diagnosticCodes.len != sourceCount ||
       diagnosticMessages.len != sourceCount ||
       artifact.producerKinds.len != 1:
        err = " csg compiler failure wire: structured columns split"
        return false
    var producerDocumentCids: layout.FixedBytes32[]
    var producerContentCids: layout.FixedBytes32[]
    var producerSeen: int32[]
    setLen(producerDocumentCids, sourceCount)
    setLen(producerContentCids, sourceCount)
    setLen(producerSeen, sourceCount)
    for sourceId in 0..<sourceCount:
        let producerSourceIndex =
            sourceProducerIndexes[sourceId]
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sourceCount ||
           producerSeen[producerSourceIndex] != 0 ||
           diagnosticSourceIds[sourceId] != sourceId:
            err = " csg compiler failure wire: producer identity split"
            return false
        producerSeen[producerSourceIndex] = 1
        producerDocumentCids[producerSourceIndex] =
            sourceDocumentCids[sourceId]
        producerContentCids[producerSourceIndex] =
            sourceContentCids[sourceId]
    if !diagnostic_failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
           artifact,
           sourceIdentityReceiptCid,
           producerDocumentCids,
           producerContentCids,
           err):
        return false
    let artifactProducerSourceIndex =
        artifact.producerSourceIndexes[0]
    var artifactSourceId: int32 = -1
    for sourceId in 0..<sourceCount:
        if sourceProducerIndexes[sourceId] ==
               artifactProducerSourceIndex:
            artifactSourceId = sourceId
    if artifactSourceId < 0 ||
       diagnosticProducerKinds[artifactSourceId] != 3 ||
       diagnosticStartBytes[artifactSourceId] !=
           artifact.spanStartBytes[0] ||
       diagnosticEndBytes[artifactSourceId] !=
           artifact.spanEndBytes[0] ||
       diagnosticSeverities[artifactSourceId] !=
           artifact.severities[0] ||
       diagnosticCodes[artifactSourceId] != artifact.codes[0] ||
       diagnosticMessages[artifactSourceId] != artifact.messages[0]:
        err = " csg compiler failure wire: structured projection split"
        return false
    err = ""
    return true

@borrows
fn csgChengCompilerFailureFactKind(kind: str): bool =
    return kind == "csg_dialect::cheng_compiler::snapshot_failure" ||
        kind == "csg_dialect::cheng_compiler::failure_sources" ||
        kind == "csg_dialect::cheng_compiler::failure_dependencies" ||
        kind == "csg_dialect::cheng_compiler::failure_diagnostics" ||
        kind ==
            "csg_dialect::cheng_compiler::diagnostic_failure_artifact" ||
        kind ==
            "csg_dialect::cheng_compiler::parser_diagnostic_authority"

@borrows
fn csgCompilerWirePositiveDecimal(value: str): bool =
    if value.len <= 0 || value.len > 19 ||
       value[0] < '1' || value[0] > '9':
        return false
    for index in 1..<value.len:
        if value[index] < '0' || value[index] > '9':
            return false
    if value.len == 19:
        let maximum = "9223372036854775807"
        for index in 0..<value.len:
            if value[index] < maximum[index]:
                return true
            if value[index] > maximum[index]:
                return false
    return true

@borrows
fn csgRequireChengCompilerFactFields(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    if kind == "csg_dialect::cheng_compiler::snapshot":
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind,
                              "predecessorReceiptCid")
        csgRequireRawField(result, lineNo, raw, kind, "schemaVersion")
        csgRequireRawField(result, lineNo, raw, kind, "semanticEpoch")
        let snapshotId = jfield.CsgCoreJsonTopStringField(raw, "id")
        if !snapshotId.found ||
           snapshotId.value !=
               "csg_dialect::cheng_compiler::snapshot":
            csgAddError(result, csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                "snapshot identity is not canonical"))
        let schemaVersion = jfield.CsgCoreJsonTopRawField(
            raw, "schemaVersion")
        let semanticEpoch = jfield.CsgCoreJsonTopRawField(
            raw, "semanticEpoch")
        if !schemaVersion.found || !semanticEpoch.found ||
           schemaVersion.value != strings.IntToStr(
               snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest) ||
           !csgCompilerWirePositiveDecimal(semanticEpoch.value):
            csgAddError(result, csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                "snapshot schema/epoch is not current"))
        if csgHasJsonField(raw, "version"):
            csgAddError(result, csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                "snapshot version field is not canonical"))
        if csgHasJsonField(raw, "physicalSoa"):
            csgRequireRawField(result, lineNo, raw, kind, "physicalSoa")
            csgRequireStringField(result, lineNo, raw, kind, "soaCid")
    elif kind == "csg_dialect::cheng_compiler::texts":
        csgRequireRawField(result, lineNo, raw, kind, "texts")
        # Compact physical-SoA cargo keeps the same field names; values are
        # {n,o} packed-column refs instead of JSON arrays.
    elif kind == "csg_dialect::cheng_compiler::sources":
        csgRequireRawField(result, lineNo, raw, kind, "contentCids")
        csgRequireRawField(result, lineNo, raw, kind, "documentCids")
        csgRequireRawField(result, lineNo, raw, kind, "interfaceCids")
        csgRequireRawField(result, lineNo, raw, kind, "modulePathTextIds")
    elif kind == "csg_dialect::cheng_compiler::spans":
        csgRequireRawField(result, lineNo, raw, kind, "endBytes")
        csgRequireRawField(result, lineNo, raw, kind, "endColumns")
        csgRequireRawField(result, lineNo, raw, kind, "endLines")
        csgRequireRawField(result, lineNo, raw, kind, "sourceIds")
        csgRequireRawField(result, lineNo, raw, kind, "startBytes")
        csgRequireRawField(result, lineNo, raw, kind, "startColumns")
        csgRequireRawField(result, lineNo, raw, kind, "startLines")
    elif kind == "csg_dialect::cheng_compiler::parser_nodes":
        csgRequireRawField(
            result, lineNo, raw, kind,
            "bindingDeclarationSourceLocalRows")
        csgRequireRawField(
            result, lineNo, raw, kind,
            "bindingPatternSourceLocalRows")
        csgRequireRawField(
            result, lineNo, raw, kind, "bindingResolutionKinds")
        csgRequireRawField(result, lineNo, raw, kind, "childCounts")
        csgRequireRawField(result, lineNo, raw, kind, "childNodeIds")
        csgRequireRawField(result, lineNo, raw, kind, "childStarts")
        csgRequireRawField(result, lineNo, raw, kind, "genericCounts")
        csgRequireRawField(result, lineNo, raw, kind, "genericStarts")
        csgRequireRawField(result, lineNo, raw, kind, "kinds")
        csgRequireRawField(result, lineNo, raw, kind, "parentNodeIds")
        csgRequireRawField(result, lineNo, raw, kind, "producerNodeIds")
        csgRequireRawField(result, lineNo, raw, kind, "sourceIds")
        csgRequireRawField(result, lineNo, raw, kind, "spanIds")
    elif kind == "csg_dialect::cheng_compiler::tokens":
        csgRequireRawField(result, lineNo, raw, kind, "kinds")
