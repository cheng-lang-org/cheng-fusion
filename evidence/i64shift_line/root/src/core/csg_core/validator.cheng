@borrows
fn csgCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgCat3(a: str, b: str, c: str): str =
    return csgCat(csgCat(a, b), c)

@borrows
fn csgCat4(a: str, b: str, c: str, d: str): str =
    return csgCat(csgCat3(a, b, c), d)

@borrows
fn csgStartsWith(text: str, prefix: str): bool =
    return strings.HasPrefix(text, prefix)

@borrows
fn csgContains(text: str, needle: str): bool =
    return strings.StrContains(text, needle)

fn csgIsJsonWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn csgRawFieldIsTrue(rawValue: str): bool =
    var start: int32
    while start < rawValue.len && csgIsJsonWs(rawValue[start]):
        start = start + 1
    var stop: int32 = rawValue.len - 1
    while stop >= start && csgIsJsonWs(rawValue[stop]):
        stop = stop - 1
    if stop - start + 1 != 4:
        return false
    return rawValue[start] == 't' &&
        rawValue[start + 1] == 'r' &&
        rawValue[start + 2] == 'u' &&
        rawValue[start + 3] == 'e'

@borrows
fn csgRawFieldIsFalse(rawValue: str): bool =
    var start: int32
    while start < rawValue.len && csgIsJsonWs(rawValue[start]):
        start = start + 1
    var stop: int32 = rawValue.len - 1
    while stop >= start && csgIsJsonWs(rawValue[stop]):
        stop = stop - 1
    if stop - start + 1 != 5:
        return false
    return rawValue[start] == 'f' &&
        rawValue[start + 1] == 'a' &&
        rawValue[start + 2] == 'l' &&
        rawValue[start + 3] == 's' &&
        rawValue[start + 4] == 'e'

fn csgBoolJson(value: bool): str =
    if value:
        return "true"
    return "false"

@borrows
fn csgCanonicalLinesText(lines: str[]): str =
    var out: str
    var idx: int32
    for idx in idx..<lines.len:
        if lines[idx].len > 0:
            out = csgCat(out, lines[idx])
            out = csgCat(out, "\n")
    return out

@borrows
fn csgCoreReplacementScopeForExactKind(kind: str): int32 =
    # Every admitted kind is immutable unless this exact, field-local kind is
    # deliberately issued LocalNamed here. Prefixes and id presence are not a
    # replacement policy: future cross-fact kinds must remain immutable until
    # their complete closure contract is reviewed and added explicitly.
    if kind == "csg.module" ||
       kind == "csg.symbol" ||
       kind == "csg.function" ||
       kind == "csg.external_symbol":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg.project" ||
       kind == "csg.import" ||
       kind == "csg.export" ||
       kind == "csg.type_decl" ||
       kind == "csg.class" ||
       kind == "csg.class_heritage" ||
       kind == "csg.jsx" ||
       kind == "csg.inline_handler" ||
       kind == "csg.async_function" ||
       kind == "csg.call" ||
       kind == "csg.binding" ||
       kind == "csg.type" ||
       kind == "csg.data" ||
       kind == "csg.block" ||
       kind == "csg.op" ||
       kind == "csg.debug_map" ||
       kind == "csg.term":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg_dialect::c::translation_unit" ||
       kind == "csg_dialect::c::function" ||
       kind == "csg_dialect::python::module":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg_dialect::cheng_compiler::snapshot":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg_dialect::native::object_emission_plan" ||
       kind == "csg_dialect::native::object_section_chunk" ||
       kind == "csg_dialect::native::object_symbol" ||
       kind == "csg_dialect::native::object_relocation" ||
       kind == "csg_dialect::native::object_debug_relocation":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg_dialect::oracle_asset::observation" ||
       kind == "csg_dialect::oracle_asset::hyperliquid_mid_source" ||
       kind == "csg_dialect::unimaker_product::certificate" ||
       kind == "csg_dialect::unimaker_product::innovation_document" ||
       kind == "csg_dialect::unimaker_product::innovation_claim" ||
       kind == "csg_dialect::unimaker_product::innovation_claim_element" ||
       kind == "csg_dialect::unimaker_product::innovation_paper_contribution" ||
       kind == "csg_dialect::unimaker_product::innovation_product_evidence" ||
       kind == "csg_dialect::unimaker_product::innovation_embedding_receipt" ||
       kind == "csg_dialect::unimaker_product::innovation_claim_chart":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg_dialect::vexa::asset" ||
       kind == "csg_dialect::vexa::deterministic_plan" ||
       kind == "csg_dialect::vexa::execution_receipt" ||
       kind == "csg_dialect::vexa::recoverable_cell":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg_dialect::finance::intent" ||
       kind == "csg_dialect::finance::policy" ||
       kind == "csg_dialect::finance::state_snapshot" ||
       kind == "csg_dialect::finance::contract_profile" ||
       kind == "csg_dialect::finance::simulation_result" ||
       kind == "csg_dialect::finance::certified_transaction" ||
       kind == "csg_dialect::finance::audit_trace" ||
       kind == "csg_dialect::finance::typed_action" ||
       kind == "csg_dialect::finance::policy_receipt" ||
       kind == "csg_dialect::finance::state_snapshot_receipt" ||
       kind == "csg_dialect::finance::contract_registry_entry" ||
       kind == "csg_dialect::finance::simulation_receipt" ||
       kind == "csg_dialect::finance::payload_receipt" ||
       kind == "csg_dialect::finance::signer_session" ||
       kind == "csg_dialect::finance::execution_substrate" ||
       kind == "csg_dialect::finance::production_transaction_environment" ||
       kind == "csg_dialect::finance::signed_transaction" ||
       kind == "csg_dialect::finance::broadcast_request":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg.web.media_asset" ||
       kind == "csg.web.media_playback_slot" ||
       kind == "csg.web.media_control_action" ||
       kind == "csg.web.media_control_receipt" ||
       kind == "csg.web.media_lifecycle_event" ||
       kind == "csg.web.media_frame_receipt" ||
       kind == "csg.web.media_receipt_identity" ||
       kind == "csg.web.media_delivery_receipt":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg.web.scene.project" ||
       kind == "csg.web.scene.state_default" ||
       kind == "csg.web.scene.route" ||
       kind == "csg.web.scene.node" ||
       kind == "csg.web.scene.event_handler" ||
       kind == "csg.web.scene.layer" ||
       kind == "csg.web.scene.prop" ||
       kind == "csg.web.scene.layout" ||
       kind == "csg.web.scene.component_prop" ||
       kind == "csg.web.scene.css_utility" ||
       kind == "csg.web.scene.style" ||
       kind == "csg.web.scene.css_variant_rule" ||
       kind == "csg.web.scene.hit_target" ||
       kind == "csg.web.scene.route_edge" ||
       kind == "csg.web.scene.route_hit_rect" ||
       kind == "csg.web.scene.paint" ||
       kind == "csg.web.scene.resource":
        return CsgCoreReplacementScopeLocalNamed
    if kind == "csg.web.project" ||
       kind == "csg.web.module_import_ref" ||
       kind == "csg.web.js_function_ref" ||
       kind == "csg.web.js_call_ref" ||
       kind == "csg.web.js_class_ref" ||
       kind == "csg.web.js_class_heritage_ref" ||
       kind == "csg.web.jsx_element" ||
       kind == "csg.web.dom_node_template" ||
       kind == "csg.web.external_symbol" ||
       kind == "csg.web.control_surface" ||
       kind == "csg.web.voice_computer_use_scenario" ||
       kind == "csg.web.computer_use_action" ||
       kind == "csg.web.voice_task_template" ||
       kind == "csg.web.voice_task_step" ||
       kind == "csg.web.confirmation_gate" ||
       kind == "csg.web.subgraph_cid" ||
       kind == "csg.web.surface_owner" ||
       kind == "csg.web.truth_ref" ||
       kind == "csg.web.pixel_region":
        return CsgCoreReplacementScopeLocalNamed
    return CsgCoreReplacementScopeImmutable

@borrows
fn csgCoreSchemaFeatureRank(feature: str): int32 =
    if feature == "core-facts":
        return 0
    if feature == "runtime-closure":
        return 1
    if feature == "csg_dialect::c":
        return 2
    if feature == "csg_dialect::python":
        return 3
    if feature == "csg_dialect::web":
        return 4
    if feature == "finance":
        return 5
    if feature == "oracle-asset":
        return 6
    if feature == "external-source-proof":
        return 7
    if feature == "oracle-signed-quorum":
        return 8
    if feature == "unimaker-product":
        return 9
    if feature == "vexa":
        return 10
    if feature == "vexa-plan":
        return 11
    if feature == "execution-receipt":
        return 12
    if feature == "recoverable-cell":
        return 13
    if feature == "compiler_semantic_snapshot":
        return 14
    if feature == "compiler_semantic_snapshot_failure":
        return 15
    if feature == "native_object_emission_plan_replay":
        return 16
    return -1

@borrows
fn csgCoreSchemaFeatureBits(
        raw: str,
        bits: var int32): str =
    bits = 0
    let field =
        jfield.CsgCoreJsonTopRawField(raw, "features")
    if !field.found:
        return "features field is missing"
    let parsed = json.ParseJsonSafe(field.value)
    if !parsed.success || parsed.value.kind != json.JArray:
        return "features must be an array"
    var previousRank: int32 = -1
    for featureIndex in 0..<parsed.value.a.len:
        if parsed.value.a[featureIndex].kind != json.JString ||
           parsed.value.a[featureIndex].s.len == 0:
            return "features must contain strings"
        let rank = csgCoreSchemaFeatureRank(
            parsed.value.a[featureIndex].s)
        if rank < 0:
            return csgCat(
                "unsupported feature: ",
                parsed.value.a[featureIndex].s)
        if rank <= previousRank:
            return "features are not canonical"
        bits = bits | (int32(1) << rank)
        previousRank = rank
    return ""

@borrows
fn csgRequireCanonicalCoreSchemaFeatures(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    var bits: int32
    let featureError =
        csgCoreSchemaFeatureBits(raw, bits)
    if featureError.len > 0:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " ", featureError)))

