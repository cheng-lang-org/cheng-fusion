        csgRequireRawField(result, lineNo, raw, kind, "uiTrustedPath")
        csgRequireRawField(result, lineNo, raw, kind, "networkPinned")
        csgRequireRawField(result, lineNo, raw, kind, "noDynamicCodeLoading")
        csgRequireRawField(result, lineNo, raw, kind, "noVisualTransactionPath")
        csgRequireRawField(result, lineNo, raw, kind, "noClipboardTransactionPath")
    elif kind == "csg_dialect::finance::production_transaction_environment":
        csgRequireStringField(result, lineNo, raw, kind, "id")
