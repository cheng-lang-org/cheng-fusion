    return identity.CsgCoreBaseProfileIdentity()

@borrows
fn csgCoreFactFeatureBits(raw: str, kind: str): int32 =
    if kind == "csg.core.schema":
        return 0
    if csgStartsWith(
           kind, "csg_dialect::cheng_compiler::"):
        if csgChengCompilerFailureFactKind(kind):
            return CsgCoreFeatureCompilerSnapshotFailure
        return CsgCoreFeatureCompilerSnapshot
    if csgStartsWith(kind, "csg_dialect::native::"):
        return CsgCoreFeatureNativeObjectReplay
    if csgStartsWith(kind, "csg_dialect::c::"):
        return CsgCoreFeatureCoreFacts |
            CsgCoreFeatureRuntimeClosure |
            CsgCoreFeatureDialectC
    if csgStartsWith(kind, "csg_dialect::python::"):
        return CsgCoreFeatureCoreFacts |
            CsgCoreFeatureRuntimeClosure |
            CsgCoreFeatureDialectPython
    if csgStartsWith(kind, "csg_dialect::web::") ||
       csgStartsWith(kind, "csg.web.") ||
       csgStartsWith(kind, "csg.js."):
        return CsgCoreFeatureCoreFacts |
            CsgCoreFeatureRuntimeClosure |
            CsgCoreFeatureDialectWeb
    if csgStartsWith(kind, "csg_dialect::finance::"):
        return CsgCoreFeatureCoreFacts |
            CsgCoreFeatureFinance
    if csgStartsWith(kind, "csg_dialect::oracle_asset::"):
        var bits = CsgCoreFeatureCoreFacts |
            CsgCoreFeatureOracleAsset
        if kind ==
               "csg_dialect::oracle_asset::hyperliquid_mid_source":
            bits = bits | CsgCoreFeatureExternalSourceProof
        elif kind == "csg_dialect::oracle_asset::observation":
            let sourceKind =
                jfield.CsgCoreJsonTopStringField(
                    raw, "sourceKind")
            if sourceKind.found &&
               sourceKind.value == "oracle_signed_price_quorum":
                bits = bits | CsgCoreFeatureOracleSignedQuorum
        return bits
    if csgStartsWith(
           kind, "csg_dialect::unimaker_product::"):
        return CsgCoreFeatureCoreFacts |
            CsgCoreFeatureUnimakerProduct
    if csgStartsWith(kind, "csg_dialect::vexa::"):
        var bits = CsgCoreFeatureCoreFacts |
            CsgCoreFeatureVexa
        if kind == "csg_dialect::vexa::deterministic_plan":
            bits = bits | CsgCoreFeatureVexaPlan
        elif kind == "csg_dialect::vexa::execution_receipt":
            bits = bits | CsgCoreFeatureExecutionReceipt
        elif kind == "csg_dialect::vexa::recoverable_cell":
            bits = bits | CsgCoreFeatureRecoverableCell
        return bits
    if kind == "csg.runtime_requirement" ||
       kind == "csg.external_symbol":
        return CsgCoreFeatureCoreFacts |
            CsgCoreFeatureRuntimeClosure
    if csgStartsWith(kind, "csg.") ||
       kind == "csg_core::tombstone":
        return CsgCoreFeatureCoreFacts
    return -1

@borrows
fn csgRootBindingProfiles(
        lines: str[],
        profiles: var str[],
        schemaCid: var str): str =
    var declaredFeatureBits: int32 = -1
    var observedFeatureBits: int32
    var schemaCount: int32
    for lineIndex in 0..<lines.len:
        if lines[lineIndex].len == 0:
            continue
        let kindValue =
            jfield.CsgCoreJsonKind(lines[lineIndex])
        if !kindValue.found || kindValue.value.len == 0:
            return csgCat(
                "root_binding_missing_kind_line_",
                strings.IntToStr(lineIndex + 1))
        if kindValue.value == "csg.core.schema":
            schemaCount = schemaCount + 1
            if schemaCount > 1:
                return "root_binding_schema_fact_not_unique"
            let schemaValue =
                jfield.CsgCoreJsonTopStringField(
                    lines[lineIndex], "schema")
            if !schemaValue.found ||
               schemaValue.value != CsgCoreSchemaNameIdentity():
                return "root_binding_schema_standard_mismatch"
            var schemaFeatureBits: int32
            let featureError =
                csgCoreSchemaFeatureBits(
                    lines[lineIndex], schemaFeatureBits)
            if featureError.len > 0:
                return csgCat(
                    "root_binding_schema_features_invalid ",
                    featureError)
            declaredFeatureBits = schemaFeatureBits
            var hashError: str
            let schemaHash =
                merkle_dag.CsgCoreMerkleFactHash(
                    lines[lineIndex], hashError)
            if hashError.len > 0:
                return csgCat(
                    "root_binding_schema_hash_failed ",
                    hashError)
            schemaCid = csgCat(
                "sha256:",
                layout.FixedBytes32Hex(schemaHash))
        else:
            let factFeatureBits =
                csgCoreFactFeatureBits(
                    lines[lineIndex], kindValue.value)
            if factFeatureBits < 0:
                return csgCat(
                    "root_binding_unknown_fact_family ",
                    kindValue.value)
            observedFeatureBits =
                observedFeatureBits | factFeatureBits
    if schemaCount != 1:
        return "root_binding_schema_fact_not_unique"
    if declaredFeatureBits != observedFeatureBits:
        return "root_binding_schema_features_not_closed"

    add(profiles, CsgCoreBaseProfileIdentity())
    if (declaredFeatureBits & CsgCoreFeatureDialectC) != 0:
        add(profiles, "csg_dialect::c")
    if (declaredFeatureBits &
            (CsgCoreFeatureCompilerSnapshot |
             CsgCoreFeatureCompilerSnapshotFailure)) != 0:
        add(profiles, "csg_dialect::cheng_compiler")
    if (declaredFeatureBits & CsgCoreFeatureFinance) != 0:
        add(profiles, "csg_dialect::finance")
    if (declaredFeatureBits &
            CsgCoreFeatureNativeObjectReplay) != 0:
        add(profiles, "csg_dialect::native")
    if (declaredFeatureBits & CsgCoreFeatureOracleAsset) != 0:
        add(profiles, "csg_dialect::oracle_asset")
    if (declaredFeatureBits & CsgCoreFeatureDialectPython) != 0:
        add(profiles, "csg_dialect::python")
    if (declaredFeatureBits & CsgCoreFeatureUnimakerProduct) != 0:
        add(profiles, "csg_dialect::unimaker_product")
    if (declaredFeatureBits & CsgCoreFeatureVexa) != 0:
        add(profiles, "csg_dialect::vexa")
    if (declaredFeatureBits & CsgCoreFeatureDialectWeb) != 0:
        add(profiles, "csg_dialect::web")
    return CsgCoreProfilesCanonicalError(profiles)

@borrows
fn CsgCoreRootBindingFromCanonicalLines(
        canonicalLines: str[]): CsgCoreRootBinding =
    var profiles: str[]
    var schemaCid: str
    let bindingError =
        csgRootBindingProfiles(
            canonicalLines, profiles, schemaCid)
    if bindingError.len > 0:
        var failed: CsgCoreRootBinding
        failed.error = strings.CloneStr(bindingError)
        return failed
    let receipt = identity.CsgCoreBindingIdentityIssue(
        CsgCoreStandardIdentity(),
        CsgCoreSchemaNamespaceIdentity(),
        schemaCid,
        profiles)
    if !receipt.ok:
        var failed: CsgCoreRootBinding
        failed.error = strings.CloneStr(receipt.error)
        return failed
    var out: CsgCoreRootBinding
    out.ok = true
    out.standard = strings.CloneStr(receipt.standard)
    out.profiles = CsgCoreProfilesClone(receipt.profiles)
    out.profileSetCid = strings.CloneStr(receipt.profileSetCid)
    out.schemaNamespace = strings.CloneStr(receipt.schemaNamespace)
    out.schemaCid = strings.CloneStr(receipt.schemaCid)
    out.bindingIdentityReceiptCid =
        strings.CloneStr(receipt.bindingIdentityReceiptCid)
    return out

@borrows
fn CsgCoreMerkleBuildBoundFromCanonicalLines(
        canonicalLines: str[]):
        merkle_dag.CsgCoreMerkleDag =
    let binding =
        CsgCoreRootBindingFromCanonicalLines(
            canonicalLines)
    if !binding.ok:
        var failed: merkle_dag.CsgCoreMerkleDag
        failed.error = strings.CloneStr(binding.error)
        return failed
    return merkle_dag.CsgCoreMerkleBuildCanonicalBound(
        canonicalLines,
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid)

@borrows
fn CsgCoreMerkleBuildBoundFromLines(
        lines: str[]):
        merkle_dag.CsgCoreMerkleDag =
    var canonicalLines: str[]
    for i in 0..<lines.len:
        if lines[i].len == 0:
            var failed: merkle_dag.CsgCoreMerkleDag
            failed.error = csgCat3(
                "root_binding_line ",
                strings.IntToStr(i + 1),
                " empty")
            return failed
        var canonicalError: str
        let canonical =
            merkle_dag.CsgCoreMerkleCanonicalFact(
                lines[i], canonicalError)
        if canonicalError.len > 0:
            var failed: merkle_dag.CsgCoreMerkleDag
            failed.error = csgCat(
                "root_binding_canonicalize ",
                canonicalError)
            return failed
        if canonical != lines[i]:
            var failed: merkle_dag.CsgCoreMerkleDag
            failed.error = csgCat3(
                "root_binding_line ",
                strings.IntToStr(i + 1),
                " noncanonical")
            return failed
        add(canonicalLines, canonical)
    let binding =
        CsgCoreRootBindingFromCanonicalLines(
            canonicalLines)
    if !binding.ok:
        var failed: merkle_dag.CsgCoreMerkleDag
        failed.error = strings.CloneStr(binding.error)
        return failed
    return merkle_dag.CsgCoreMerkleBuildCanonicalBound(
        canonicalLines,
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid)

@borrows
fn CsgCoreFactsRootFromCanonicalLines(
        canonicalLines: str[]): str =
    var root: layout.FixedBytes32
    var rootText: str
    var error: str
    if !CsgCoreFactsRootFromCanonicalLinesInto(
           canonicalLines,
           root,
           rootText,
           error):
        return csgCat("invalid:", error)
    return rootText

@borrows
fn CsgCoreFactsRootFromCanonicalLinesInto(
        canonicalLines: str[],
        root: var layout.FixedBytes32,
        rootText: var str,
        error: var str): bool =
    let dag =
        CsgCoreMerkleBuildBoundFromCanonicalLines(
            canonicalLines)
    if !dag.ok:
        error = strings.CloneStr(dag.error)
        return false
    if !csgCompilerWireDecodeCidText(
           dag.factsRoot, root):
        error = "facts_root_cid_invalid"
        return false
    rootText = strings.CloneStr(dag.factsRoot)
    error = ""
    return true

@borrows
fn csgHasJsonField(raw: str, key: str): bool =
    return jfield.CsgCoreJsonTopRawField(raw, key).found

@borrows
fn csgFactFieldContractRegister(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        key: str) =
    if lineNo <= 0 ||
       result.factFieldContractLineNo != lineNo ||
       key.len == 0:
        return
    for keyIndex in 0..<result.factFieldContractKeys.len:
        if result.factFieldContractKeys[keyIndex] == key:
            return
    add(
        result.factFieldContractKeys,
        strings.CloneStr(key))

fn csgFactFieldContractBegin(
        result: var CsgCoreValidationResult,
        lineNo: int32) =
    result.factFieldContractKeys = []
    result.factFieldContractLineNo = lineNo
    csgFactFieldContractRegister(
        result, lineNo, "kind")

@borrows
fn csgFactFieldContractFinish(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    if result.mode != CsgCoreModeStrict:
        # Sandbox parity with the production legacy binary: field-set
        # contracts are a strict-mode admission rule. The old binary never
        # enforced them in sandbox, and the ts-csg extractor emits richer
        # legacy shapes, so sandbox stays tolerant.
        return
    if lineNo <= 0 ||
       result.factFieldContractLineNo != lineNo:
        csgAddError(
            result,
            csgCat3(
                "line ", strings.IntToStr(lineNo),
                " fact field contract state mismatch"))
        return
    let parsed = json.ParseJsonSafe(raw)
    if !parsed.success || parsed.value.kind != json.JObject:
        csgAddError(
            result,
            csgCat3(
                "line ", strings.IntToStr(lineNo),
                " fact field contract requires an object"))
        result.factFieldContractKeys = []
        result.factFieldContractLineNo = 0
        return
    if parsed.value.okeys.len !=
           result.factFieldContractKeys.len:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat(kind, " field set mismatch")))
    else:
        for keyIndex in 0..<parsed.value.okeys.len:
            var recognized = false
            for contractIndex in
                    0..<result.factFieldContractKeys.len:
                if result.factFieldContractKeys[contractIndex] ==
                       parsed.value.okeys[keyIndex]:
                    recognized = true
                    break
            if !recognized:
                csgAddError(
                    result,
                    csgCat4(
                        "line ", strings.IntToStr(lineNo), " ",
                        csgCat(
                            kind,
                            csgCat(" unknown field: ",
                                   parsed.value.okeys[keyIndex]))))
                break
    result.factFieldContractKeys = []
    result.factFieldContractLineNo = 0

@borrows
fn csgRequireRawField(result: var CsgCoreValidationResult,
                      lineNo: int32,
                      raw: str,
                      kind: str,
                      key: str) =
    csgFactFieldContractRegister(result, lineNo, key)
    if !csgHasJsonField(raw, key):
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat3(kind, " missing field ", key)))

@borrows
fn csgRequireStringField(result: var CsgCoreValidationResult,
                         lineNo: int32,
                         raw: str,
                         kind: str,
                         key: str): str =
    csgFactFieldContractRegister(result, lineNo, key)
    let found = jfield.CsgCoreJsonTopStringField(raw, key)
    if found.found && found.value.len > 0:
        return strings.stringsNewStringCopy(
            found.value.data, found.value.len)
    csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat3(kind, " missing string field ", key)))
    return ""

@borrows
fn csgRequireStringFieldAllowEmpty(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str): str =
    csgFactFieldContractRegister(result, lineNo, key)
    let found =
        jfield.CsgCoreJsonTopStringField(raw, key)
    if found.found:
        return strings.stringsNewStringCopy(
            found.value.data, found.value.len)
    csgAddError(
        result,
        csgCat4(
            "line ",
            strings.IntToStr(lineNo),
            " ",
            csgCat3(
                kind,
                " missing string field ",
                key)))
    return ""

@borrows
fn csgRequireOptionalStringField(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str) =
    let rawField =
        jfield.CsgCoreJsonTopRawField(raw, key)
    if !rawField.found:
        return
    csgFactFieldContractRegister(result, lineNo, key)
    let stringField =
        jfield.CsgCoreJsonTopStringField(raw, key)
    if !stringField.found ||
       stringField.value.len == 0:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " ",
                csgCat3(
                    kind,
                    " invalid optional string field ",
                    key)))

@borrows
fn csgJsonObjectFieldIndex(
        value: json.JsonNode,
        key: str): int32 =
    if value.kind != json.JObject ||
       value.okeys.len != value.ovalues.len:
        return -1
    for index in 0..<value.okeys.len:
        if value.okeys[index] == key:
            return index
    return -1

@borrows
fn csgAddNestedFieldError(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        kind: str,
        key: str,
        message: str) =
    if result.mode != CsgCoreModeStrict:
        # Sandbox parity: nested shape contracts (exact position objects,
        # exact {name,type} parameters) are strict-admission rules; the
        # legacy production binary did not enforce them in sandbox.
        return
    csgAddError(
        result,
        csgCat4(
            "line ", strings.IntToStr(lineNo), " ",
            csgCat3(kind, csgCat(" ", key), message)))

@borrows
fn csgRequireOptionalPositionObjectField(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str,
        columnKey: str) =
    let rawField =
        jfield.CsgCoreJsonTopRawField(raw, key)
    if !rawField.found:
        return
    csgFactFieldContractRegister(result, lineNo, key)
    let parsed = json.ParseJsonSafe(rawField.value)
    if !parsed.success || parsed.value.kind != json.JObject ||
       parsed.value.okeys.len != 3 ||
       parsed.value.ovalues.len != 3:
        csgAddNestedFieldError(
            result, lineNo, kind, key,
            " must be an exact position object")
        return
    for nestedIndex in 0..<parsed.value.okeys.len:
        if parsed.value.okeys[nestedIndex] != columnKey &&
           parsed.value.okeys[nestedIndex] != "file" &&
           parsed.value.okeys[nestedIndex] != "line":
            csgAddNestedFieldError(
                result, lineNo, kind, key,
                " contains an unknown position field")
            return
    let columnIndex =
        csgJsonObjectFieldIndex(parsed.value, columnKey)
    let fileIndex =
        csgJsonObjectFieldIndex(parsed.value, "file")
    let lineIndex =
        csgJsonObjectFieldIndex(parsed.value, "line")
    if columnIndex < 0 || fileIndex < 0 || lineIndex < 0 ||
       parsed.value.ovalues[columnIndex].kind != json.JInt ||
       parsed.value.ovalues[columnIndex].i < 0 ||
       parsed.value.ovalues[columnIndex].i > int64(2147483647) ||
       parsed.value.ovalues[fileIndex].kind != json.JString ||
       parsed.value.ovalues[fileIndex].s.len == 0 ||
       parsed.value.ovalues[lineIndex].kind != json.JInt ||
       parsed.value.ovalues[lineIndex].i <= 0 ||
       parsed.value.ovalues[lineIndex].i > int64(2147483647):
        csgAddNestedFieldError(
            result, lineNo, kind, key,
            " position values are invalid")

@borrows
fn csgRequireParametersField(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str) =
    csgFactFieldContractRegister(
        result, lineNo, "parameters")
    let rawField =
        jfield.CsgCoreJsonTopRawField(raw, "parameters")
    if !rawField.found:
        csgAddNestedFieldError(
            result, lineNo, kind, "parameters",
            " is required; empty parameters must be []")
        return
    let parsed = json.ParseJsonSafe(rawField.value)
    if !parsed.success || parsed.value.kind != json.JArray:
        csgAddNestedFieldError(
            result, lineNo, kind, "parameters",
            " must be an array")
        return
    for parameterIndex in 0..<parsed.value.a.len:
        if parsed.value.a[parameterIndex].kind != json.JObject ||
           parsed.value.a[parameterIndex].okeys.len != 2 ||
           parsed.value.a[parameterIndex].ovalues.len != 2:
            csgAddNestedFieldError(
                result, lineNo, kind, "parameters",
                " entries must be exact {name,type} objects")
            return
        let nameIndex =
            csgJsonObjectFieldIndex(parsed.value.a[parameterIndex], "name")
        let typeIndex =
            csgJsonObjectFieldIndex(parsed.value.a[parameterIndex], "type")
        if nameIndex < 0 || typeIndex < 0 ||
           parsed.value.a[parameterIndex].ovalues[nameIndex].kind !=
               json.JString ||
           parsed.value.a[parameterIndex].ovalues[nameIndex].s.len == 0 ||
           parsed.value.a[parameterIndex].ovalues[typeIndex].kind !=
               json.JString ||
           parsed.value.a[parameterIndex].ovalues[typeIndex].s.len == 0:
            csgAddNestedFieldError(
                result, lineNo, kind, "parameters",
                " entries require nonempty string name and type")
            return
        for priorIndex in 0..<parameterIndex:
            let priorNameIndex =
                csgJsonObjectFieldIndex(parsed.value.a[priorIndex], "name")
            if priorNameIndex >= 0 &&
               parsed.value.a[priorIndex].ovalues[priorNameIndex].kind ==
                   json.JString &&
               parsed.value.a[priorIndex].ovalues[priorNameIndex].s ==
                   parsed.value.a[parameterIndex].ovalues[nameIndex].s:
                csgAddNestedFieldError(
                    result, lineNo, kind, "parameters",
                    " contains a duplicate name")
                return

@borrows
fn csgRequireOptionalBoolField(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str) =
    let found = jfield.CsgCoreJsonTopRawField(raw, key)
    if !found.found:
        return
    csgFactFieldContractRegister(result, lineNo, key)
    if !csgRawFieldIsTrue(found.value) &&
       !csgRawFieldIsFalse(found.value):
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(
                    kind,
                    " invalid optional boolean field ",
                    key)))

@borrows
fn csgCanonicalIntegerFieldText(
        text: str,
        out: var int32): bool =
    # Read-side companion of the fact-line canonicality proof.  Raw numeric
    # fact fields are admissible not only as plain int32 digits
    # (CsgCoreMerkleStoreParseInt32) but also in the exact JSON canonical
    # integer form that CsgCoreJsonCanonicalize rewrites whole-decimal
    # values into (1000 -> 1e3 because the scientific form is strictly
    # shorter).  The accepted set is exactly the canonicalizer's image over
    # int32 values: parse the text to an exact integer without float64,
    # re-canonicalize its plain decimal with the canonicalizer authority,
    # and accept only when the round-trip reproduces the input bytes.
    # Everything else (1E3, 1.0e3, 10e2, +1000, 0x3E8, leading zeros,
    # non-integral fractions) is refused, so this widens nothing beyond the
    # canonical form the plan/replay contract already demands.
    var negative = false
    var pos: int32
    if pos < text.len && text[pos] == '-':
        negative = true
        pos = pos + 1
    var magnitude: int64
    var digitCount: int32
    var leadingZero = false
    while pos < text.len && text[pos] >= '0' && text[pos] <= '9':
        if digitCount == 0 && text[pos] == '0':
            leadingZero = true
        let digit = int64(int32(text[pos]) - int32('0'))
        if magnitude > (int64(9223372036854775807) - digit) / int64(10):
            return false
        magnitude = magnitude * int64(10) + digit
        digitCount = digitCount + 1
        pos = pos + 1
    if digitCount == 0:
        return false
    if leadingZero && digitCount > 1:
        return false
    var shift: int32
    if pos < text.len && text[pos] == '.':
        pos = pos + 1
        var fractionDigits: int32
        while pos < text.len && text[pos] >= '0' && text[pos] <= '9':
            let digit = int64(int32(text[pos]) - int32('0'))
            if magnitude > (int64(9223372036854775807) - digit) / int64(10):
                return false
            magnitude = magnitude * int64(10) + digit
            fractionDigits = fractionDigits + 1
            pos = pos + 1
        if fractionDigits == 0:
            return false
        shift = 0 - fractionDigits
    if pos < text.len && (text[pos] == 'e' || text[pos] == 'E'):
        pos = pos + 1
        var exponentNegative = false
        if pos < text.len && (text[pos] == '+' || text[pos] == '-'):
            exponentNegative = text[pos] == '-'
            pos = pos + 1
        var exponent: int32
        var exponentDigits: int32
        while pos < text.len && text[pos] >= '0' && text[pos] <= '9':
            if exponent > 4096:
                return false
            exponent = exponent * 10 + (int32(text[pos]) - int32('0'))
            exponentDigits = exponentDigits + 1
            pos = pos + 1
        if exponentDigits == 0:
            return false
        if exponentNegative:
            shift = shift - exponent
        else:
            shift = shift + exponent
    if pos != text.len:
        return false
    while shift > 0:
        if magnitude > int64(9223372036854775807) / int64(10):
            return false
        magnitude = magnitude * int64(10)
        shift = shift - 1
    while shift < 0:
        if magnitude % int64(10) != 0:
            return false
        magnitude = magnitude / int64(10)
        shift = shift + 1
    if negative:
        magnitude = 0 - magnitude
    if magnitude < int64(-2147483648) ||
       magnitude > int64(2147483647):
        return false
    let value = int32(magnitude)
    let plain = strings.Int64ToStr(magnitude)
    let roundTrip =
        canonical.CsgCoreJsonCanonicalize(plain)
    if !roundTrip.ok || roundTrip.value != text:
        return false
    out = value
    return true

@borrows
fn csgTryInt32Field(
        raw: str,
        key: str,
        value: var int32): bool =
    let found =
        jfield.CsgCoreJsonTopRawField(raw, key)
    if !found.found || found.value.len <= 0 ||
       found.value.len > 11:
        return false
    if merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           found.value, value):
        return true
    return csgCanonicalIntegerFieldText(
        found.value, value)

@borrows
fn csgRequirePositiveInt32Field(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str) =
    csgFactFieldContractRegister(result, lineNo, key)
    var value: int32
    if !csgTryInt32Field(raw, key, value):
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " ",
                csgCat3(
                    kind,
                    " missing int32 field ",
                    key)))
        return
    if value <= 0:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " ",
                csgCat3(
                    kind,
                    " field must be positive: ",
                    key)))

@borrows
fn csgRequireNonnegativeInt32Field(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str) =
    csgFactFieldContractRegister(result, lineNo, key)
    var value: int32
    if !csgTryInt32Field(raw, key, value):
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " ",
                csgCat3(
                    kind,
                    " missing int32 field ",
                    key)))
        return
    if value < 0:
        csgAddError(
            result,
            csgCat4(
                "line ",
                strings.IntToStr(lineNo),
                " ",
                csgCat3(
                    kind,
                    " field must be nonnegative: ",
                    key)))

@borrows
fn csgRequireInt32RangeField(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str,
        minimum: int32,
        maximum: int32) =
    csgFactFieldContractRegister(result, lineNo, key)
    let found = jfield.CsgCoreJsonTopRawField(raw, key)
    if !found.found:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " missing int32 field ", key)))
        return
    let parsed = json.ParseJsonSafe(found.value)
    var value64: int64
    var valid = false
    if parsed.success && parsed.value.kind == json.JInt:
        value64 = parsed.value.i
        valid = true
    elif parsed.success && parsed.value.kind == json.JFloat &&
         parsed.value.f >= -2147483648.0 &&
         parsed.value.f <= 2147483647.0:
        value64 = int64(parsed.value.f)
        valid = parsed.value.f == float64(value64)
    if !valid || value64 < int64(-2147483648) ||
       value64 > int64(2147483647):
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " invalid int32 field ", key)))
        return
    let value = int32(value64)
    if value < minimum || value > maximum:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " int32 field out of range: ", key)))

@borrows
fn csgRequireNonnegativeInt64Field(
        result: var CsgCoreValidationResult,
        lineNo: int32,
        raw: str,
        kind: str,
        key: str) =
    csgFactFieldContractRegister(result, lineNo, key)
    let found = jfield.CsgCoreJsonTopRawField(raw, key)
    if !found.found:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " missing int64 field ", key)))
        return
    let parsed = json.ParseJsonSafe(found.value)
    var valid = false
    if parsed.success && parsed.value.kind == json.JInt:
        valid = parsed.value.i >= int64(0)
    elif parsed.success && parsed.value.kind == json.JFloat &&
         parsed.value.f >= 0.0 &&
         parsed.value.f <= 9007199254740991.0:
        let exact = int64(parsed.value.f)
        valid = parsed.value.f == float64(exact)
    if !valid:
        csgAddError(
            result,
            csgCat4(
                "line ", strings.IntToStr(lineNo), " ",
                csgCat3(kind, " invalid nonnegative int64 field ", key)))

@borrows
fn csgRequireTrueField(result: var CsgCoreValidationResult,
                       lineNo: int32,
                       raw: str,
                       kind: str,
                       key: str) =
    csgFactFieldContractRegister(result, lineNo, key)
    let found = jfield.CsgCoreJsonTopRawField(raw, key)
    if found.found && csgRawFieldIsTrue(found.value):
        return
    if found.found:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat3(kind, " field must be true: ", key)))
    else:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat3(kind, " missing true field ", key)))

@borrows
fn csgRequireBoolField(result: var CsgCoreValidationResult,
                       lineNo: int32,
                       raw: str,
                       kind: str,
                       key: str) =
    csgFactFieldContractRegister(result, lineNo, key)
    let found = jfield.CsgCoreJsonTopRawField(raw, key)
    if found.found &&
       (csgRawFieldIsTrue(found.value) ||
        csgRawFieldIsFalse(found.value)):
        return
    if found.found:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat3(kind, " field must be boolean: ", key)))
    else:
        csgAddError(result, csgCat4("line ", strings.IntToStr(lineNo), " ", csgCat3(kind, " missing boolean field ", key)))

fn csgAddError(result: var CsgCoreValidationResult, message: str) =
    add(result.errors, message)
    result.errorCount = result.errorCount + 1
    result.valid = false

fn csgCompilerWireFail(err: var str, message: str): bool =
    err = csgCat(" csg compiler wire: ", message)
    return false

@borrows
fn csgCompilerWireDecodeStringAt(raw: str,
                                 cursor: var int32,
                                 out: var str): bool =
    out = ""
    if cursor < 0 || cursor >= raw.len || raw[cursor] != '"':
        return false
    cursor = cursor + 1
    var segmentStart = cursor
    while cursor < raw.len:
        let ch = raw[cursor]
        if ch == '"':
            if cursor > segmentStart:
                out = strings.ConcatStr(out, strings.SliceBytes(
                    raw, segmentStart, cursor - segmentStart))
            cursor = cursor + 1
            return true
        if ch != '\\':
            if Int32(ch) < 32:
                return false
            cursor = cursor + 1
            continue
        if cursor + 1 >= raw.len:
            return false
        if cursor > segmentStart:
            out = strings.ConcatStr(out, strings.SliceBytes(
                raw, segmentStart, cursor - segmentStart))
        let escaped = raw[cursor + 1]
        if escaped == '"':
            out = strings.ConcatStr(out, "\"")
        elif escaped == '\\':
            out = strings.ConcatStr(out, "\\")
        elif escaped == '/':
            out = strings.ConcatStr(out, "/")
        elif escaped == 'n':
            out = strings.ConcatStr(out, "\n")
        elif escaped == 'r':
            out = strings.ConcatStr(out, "\r")
        elif escaped == 't':
            out = strings.ConcatStr(out, "\t")
        else:
            return false
        cursor = cursor + 2
        segmentStart = cursor
    return false

@borrows
fn csgCompilerWireDecodeStringArray(raw: str,
                                    out: var str[]): bool =
    out = []
    if raw.len < 2 || raw[0] != '[':
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        var value: str
        if !csgCompilerWireDecodeStringAt(raw, cursor, value):
            return false
        add(out, value)
        if cursor >= raw.len:
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            return false
        cursor = cursor + 1
    return false

@borrows
fn csgCompilerWireDecodeIntArray(raw: str,
                                 out: var int32[]): bool =
    out = []
    if raw.len < 2 || raw[0] != '[':
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        let start = cursor
        if raw[cursor] == '-':
            cursor = cursor + 1
        if cursor >= raw.len || raw[cursor] < '0' || raw[cursor] > '9':
            return false
        if raw[cursor] == '0':
            cursor = cursor + 1
            if cursor < raw.len && raw[cursor] >= '0' &&
               raw[cursor] <= '9':
                return false
        else:
            while cursor < raw.len && raw[cursor] >= '0' &&
                  raw[cursor] <= '9':
                cursor = cursor + 1
        # Canonical integer tail (e.g. 1e3 for 1000): the whole-decimal
        # rewrite of the line canonicalizer is admissible wherever plain
        # digits are, subject to the same round-trip proof applied below.
        if cursor < raw.len && raw[cursor] == '.':
            cursor = cursor + 1
            if cursor >= raw.len || raw[cursor] < '0' ||
               raw[cursor] > '9':
                return false
            while cursor < raw.len && raw[cursor] >= '0' &&
                  raw[cursor] <= '9':
                cursor = cursor + 1
        if cursor < raw.len && (raw[cursor] == 'e' ||
                                raw[cursor] == 'E'):
            cursor = cursor + 1
            if cursor < raw.len && (raw[cursor] == '+' ||
                                    raw[cursor] == '-'):
                cursor = cursor + 1
            if cursor >= raw.len || raw[cursor] < '0' ||
               raw[cursor] > '9':
                return false
            while cursor < raw.len && raw[cursor] >= '0' &&
                  raw[cursor] <= '9':
                cursor = cursor + 1
        let numberText = strings.SliceBytes(raw, start, cursor - start)
        if numberText.len > 11:
            return false
        var value: int32
        if !merkle_store_codec.CsgCoreMerkleStoreParseInt32(
               numberText, value) &&
           !csgCanonicalIntegerFieldText(numberText, value):
            return false
        add(out, value)
        if cursor >= raw.len:
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            return false
        cursor = cursor + 1
    return false

@borrows
fn csgCompilerWireDecodeBoolArray(raw: str,
                                  out: var bool[]): bool =
    out = []
    if raw.len < 2 || raw[0] != '[':
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        if cursor + 4 <= raw.len &&
           strings.SliceBytes(raw, cursor, 4) == "true":
            add(out, true)
            cursor = cursor + 4
        elif cursor + 5 <= raw.len &&
             strings.SliceBytes(raw, cursor, 5) == "false":
            add(out, false)
            cursor = cursor + 5
        else:
            return false
        if cursor >= raw.len:
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            return false
        cursor = cursor + 1
    return false

@borrows
fn csgCompilerWireDecodeCidText(text: str,
                               out: var layout.FixedBytes32): bool =
    if text.len != 71 || !strings.HasPrefix(text, "sha256:"):
        return false
    let parsed = layout.FixedBytes32FromHex(
        strings.SliceBytes(text, 7, 64))
    if !IsOk(parsed):
        return false
    out = Value(parsed)
    if layout.FixedBytes32Hex(out) != strings.SliceBytes(text, 7, 64):
        return false
    return true

@borrows
fn csgCompilerWireDecodeCidArray(raw: str,
                                 out: var layout.FixedBytes32[]): bool =
    out = []
    if raw.len < 2 || raw[0] != '[':
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        var text: str
        if !csgCompilerWireDecodeStringAt(raw, cursor, text):
            return false
        var cid: layout.FixedBytes32
        if !csgCompilerWireDecodeCidText(text, cid):
            return false
        add(out, cid)
        if cursor >= raw.len:
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            return false
        cursor = cursor + 1
    return false

@borrows
fn csgCompilerWireRawField(line: str,
                           key: str,
                           raw: var str,
                           err: var str): bool =
    let field = jfield.CsgCoreJsonTopRawField(line, key)
    if !field.found:
        return csgCompilerWireFail(
            err, strings.ConcatStr("missing field ", key))
    raw = strings.stringsNewStringCopy(
        field.value.data, field.value.len)
    return true

@borrows
fn csgCompilerWireIntArrayField(line: str,
                                key: str,
                                out: var int32[],
                                err: var str): bool =
    var raw: str
    if !csgCompilerWireRawField(line, key, raw, err):
        return false
    if !csgCompilerWireDecodeIntArray(raw, out):
        return csgCompilerWireFail(
            err, strings.ConcatStr("invalid int array ", key))
    return true

@borrows
fn csgCompilerWireBoolArrayField(line: str,
                                 key: str,
                                 out: var bool[],
                                 err: var str): bool =
    var raw: str
    if !csgCompilerWireRawField(line, key, raw, err):
        return false
    if !csgCompilerWireDecodeBoolArray(raw, out):
        return csgCompilerWireFail(
            err, strings.ConcatStr("invalid bool array ", key))
    return true

@borrows
fn csgCompilerWireTextArrayField(line: str,
                                 key: str,
                                 out: var str[],
                                 err: var str): bool =
    var raw: str
    if !csgCompilerWireRawField(line, key, raw, err):
        return false
    if !csgCompilerWireDecodeStringArray(raw, out):
        return csgCompilerWireFail(
            err, strings.ConcatStr("invalid text array ", key))
    return true

@borrows
fn csgCompilerWireCidArrayField(line: str,
                                key: str,
                                out: var layout.FixedBytes32[],
                                err: var str): bool =
    var raw: str
    if !csgCompilerWireRawField(line, key, raw, err):
        return false
    if !csgCompilerWireDecodeCidArray(raw, out):
        return csgCompilerWireFail(
            err, strings.ConcatStr("invalid CID array ", key))
    return true

@borrows
fn csgCompilerWireIntField(line: str,
                           key: str,
                           out: var int32,
                           err: var str): bool =
    var raw: str
    if !csgCompilerWireRawField(line, key, raw, err):
        return false
    if raw.len <= 0 || raw.len > 11:
        return csgCompilerWireFail(
            err, strings.ConcatStr("invalid int field ", key))
    if merkle_store_codec.CsgCoreMerkleStoreParseInt32(raw, out):
        return true
    if csgCanonicalIntegerFieldText(raw, out):
        return true
    return csgCompilerWireFail(
        err, strings.ConcatStr("invalid int field ", key))

@borrows
fn csgCompilerWireCidField(line: str,
                           key: str,
                           out: var layout.FixedBytes32,
                           err: var str): bool =
    let field = jfield.CsgCoreJsonTopStringField(line, key)
    if !field.found || !csgCompilerWireDecodeCidText(field.value, out):
        return csgCompilerWireFail(
            err, strings.ConcatStr("invalid CID field ", key))
    return true

@borrows
fn csgCompilerWireDeclarationTableDecodeInto(
        line: str,
        out: var declaration.SemanticSnapshotDeclarationTable,
        err: var str): bool =
    var table: declaration.SemanticSnapshotDeclarationTable
    if !csgCompilerWireIntArrayField(
           line, "declIds", table.declIds, err) ||
       !csgCompilerWireCidArrayField(
           line, "declKeyCids", table.declKeyCids, err) ||
       !csgCompilerWireIntArrayField(
           line, "declarationKinds", table.declarationKinds, err) ||
       !csgCompilerWireCidArrayField(
           line, "lexicalScopeCids", table.lexicalScopeCids, err) ||
       !csgCompilerWireIntField(
           line, "maxOwnerDepth", table.maxOwnerDepth, err) ||
       !csgCompilerWireIntArrayField(
           line, "nameSurfaceKinds", table.nameSurfaceKinds, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDeclIds", table.ownerDeclIds, err) ||
       !csgCompilerWireIntArrayField(
           line, "ownerDepths", table.ownerDepths, err) ||
       !csgCompilerWireCidArrayField(
           line, "parserValidatedNameProofCids",
           table.parserValidatedNameProofCids, err) ||
       !csgCompilerWireCidArrayField(
           line, "portableDocumentIdentityCids",
           table.portableDocumentIdentityCids, err) ||
       !csgCompilerWireTextArrayField(
           line, "portableDocumentModulePaths",
           table.portableDocumentModulePaths, err) ||
       !csgCompilerWireTextArrayField(
           line, "portableDocumentPackageIds",
           table.portableDocumentPackageIds, err) ||
       !csgCompilerWireCidArrayField(
           line, "portableSignatureTypeExpressionCids",
           table.portableSignatureTypeExpressionCids, err) ||
       !csgCompilerWireIntArrayField(
           line, "spanEndBytes", table.spanEndBytes, err) ||
       !csgCompilerWireIntArrayField(
           line, "spanStartBytes", table.spanStartBytes, err) ||
       !csgCompilerWireTextArrayField(
           line, "canonicalNames", table.canonicalNames, err) ||
       !csgCompilerWireCidField(line, "tableCid", table.tableCid, err):
        declaration.SemanticSnapshotDeclarationTableReleaseInto(table)
        return false
    let bytesField = jfield.CsgCoreJsonTopStringField(
        line, "canonicalBytesHex")
    if !bytesField.found || bytesField.value.len <= 0 ||
       bytesField.value.len % 2 != 0:
        declaration.SemanticSnapshotDeclarationTableReleaseInto(table)
        return csgCompilerWireFail(err, "invalid declaration canonical bytes")
    let canonicalBytes = rawbytes.BytesFromHex(bytesField.value)
    table.canonicalBytes = canonicalBytes
    if rawbytes.BytesLen(table.canonicalBytes) * 2 !=
           bytesField.value.len ||
       rawbytes.BytesToHex(table.canonicalBytes) != bytesField.value:
        declaration.SemanticSnapshotDeclarationTableReleaseInto(table)
        return csgCompilerWireFail(err, "invalid declaration canonical hex")
    out = table
    return true

@borrows
fn csgCompilerWireDecodeInto(
        incomingLines: str[],
        out: var CsgCoreChengCompilerWireFacts,
        err: var str): bool =
    var facts: CsgCoreChengCompilerWireFacts
    if incomingLines.len != 25:
        return csgCompilerWireFail(err, "fact table count mismatch")
    let expectedKinds = [
        "csg.core.schema",
        "csg_dialect::cheng_compiler::snapshot",
        "csg_dialect::cheng_compiler::texts",
        "csg_dialect::cheng_compiler::sources",
        "csg_dialect::cheng_compiler::spans",
        "csg_dialect::cheng_compiler::parser_nodes",
        "csg_dialect::cheng_compiler::tokens",
        "csg_dialect::cheng_compiler::parser_sidecars",
        "csg_dialect::cheng_compiler::types",
        "csg_dialect::cheng_compiler::declarations",
        "csg_dialect::cheng_compiler::symbols",
        "csg_dialect::cheng_compiler::annotation_targets",
        "csg_dialect::cheng_compiler::lexical_scopes",
        "csg_dialect::cheng_compiler::functions",
        "csg_dialect::cheng_compiler::extern_functions",
        "csg_dialect::cheng_compiler::read_set",
        "csg_dialect::cheng_compiler::references",
        "csg_dialect::cheng_compiler::calls",
        "csg_dialect::cheng_compiler::layouts",
        "csg_dialect::cheng_compiler::layout_fields",
        "csg_dialect::cheng_compiler::typed_nodes",
        "csg_dialect::cheng_compiler::dependencies",
        "csg_dialect::cheng_compiler::debug_ops",
        "csg_dialect::cheng_compiler::diagnostic_completions",
        "csg_dialect::cheng_compiler::diagnostics"]
    var orderErr: str
    let ordered =
        csgc.CsgCoreCsgcRestoreLinesByExpectedKind(
            incomingLines, expectedKinds, orderErr)
    if orderErr != "":
        return csgCompilerWireFail(err, "declaration table order mismatch")
    let lines = ordered
    let declarationsKind = jfield.CsgCoreJsonKind(lines[9])
    if !declarationsKind.found || declarationsKind.value !=
           "csg_dialect::cheng_compiler::declarations":
        return csgCompilerWireFail(err, "declaration table order mismatch")
    if !csgCompilerWireDeclarationTableDecodeInto(
            lines[9], facts.snapshot.declarations, err) ||
       !csgCompilerWireTextArrayField(
            lines[2], "texts", facts.snapshot.texts, err) ||
       !csgCompilerWireCidArrayField(
            lines[3], "documentCids", facts.snapshot.sources.documentCids, err) ||
       !csgCompilerWireIntArrayField(
            lines[3], "modulePathTextIds",
            facts.sourceModulePathTextIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "sourceIds", facts.snapshot.spans.sourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "startBytes", facts.snapshot.spans.startBytes, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "endBytes", facts.snapshot.spans.endBytes, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "startLines", facts.snapshot.spans.startLines, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "startColumns",
            facts.snapshot.spans.startColumns, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "endLines", facts.snapshot.spans.endLines, err) ||
       !csgCompilerWireIntArrayField(
            lines[4], "endColumns", facts.snapshot.spans.endColumns, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "sourceIds", facts.snapshot.parserNodes.sourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "producerNodeIds", facts.snapshot.parserNodes.producerNodeIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "kinds", facts.snapshot.parserNodes.kinds, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "spanIds", facts.snapshot.parserNodes.spanIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "bindingResolutionKinds",
            facts.snapshot.parserNodes.bindingResolutionKinds, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "bindingDeclarationSourceLocalRows",
            facts.snapshot.parserNodes.bindingDeclarationSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
            lines[5], "bindingPatternSourceLocalRows",
            facts.snapshot.parserNodes.bindingPatternSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "sourceIds",
            facts.snapshot.parserSidecars.sourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "producerSourceIndexes",
            facts.snapshot.parserSidecars.producerSourceIndexes, err) ||
       !csgCompilerWireIntArrayField(
            lines[6], "sourceIds", facts.tokenSourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[6], "sourceLocalRows",
            facts.tokenSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
            lines[6], "lexicalParentTokenIds",
            facts.tokenLexicalParentIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[6], "kinds", facts.tokenKinds, err) ||
       !csgCompilerWireIntArrayField(
            lines[6], "spanIds", facts.tokenSpanIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[6], "valueTextIds", facts.tokenValueTextIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "typeSyntaxSourceIds",
            facts.parserTypeSyntaxSourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "typeSyntaxProducerSourceIds",
            facts.parserTypeSyntaxProducerSourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "typeSyntaxSourceLocalRows",
            facts.parserTypeSyntaxSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "typeSyntaxKinds",
            facts.parserTypeSyntaxKinds, err) ||
       !csgCompilerWireCidArrayField(
            lines[8], "typeCids", facts.snapshot.types.typeCids, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "typeKinds", facts.snapshot.types.typeKinds, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "elementTypeIds",
            facts.snapshot.types.elementTypeIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "argStarts", facts.typeArgStarts, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "argCounts", facts.typeArgCounts, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "argTypeIds", facts.typeArgTypeIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "genericParameterParserRows",
            facts.typeGenericParameterParserRows, err) ||
       !csgCompilerWireIntArrayField(
            lines[8], "producerTypeArenaIds",
            facts.snapshot.types.producerTypeArenaIds, err) ||
       !csgCompilerWireBoolArrayField(
            lines[8], "managedFlags", facts.snapshot.types.managedFlags, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "declIds", facts.symbolDeclIds, err) ||
       !csgCompilerWireCidArrayField(
            lines[10], "declKeyCids",
            facts.snapshot.symbols.declKeyCids, err) ||
       !csgCompilerWireCidArrayField(
            lines[10], "symbolCids", facts.symbolCids, err) ||
       !csgCompilerWireCidArrayField(
            lines[10], "interfaceCids", facts.symbolInterfaceCids, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "sourceIds", facts.snapshot.symbols.sourceIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "nameTextIds", facts.symbolNameTextIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "nameSpanIds", facts.snapshot.symbols.nameSpanIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "nameTokenIds", facts.snapshot.symbols.nameTokenIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "qualifiedNameTextIds",
            facts.symbolQualifiedNameTextIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "typeIds", facts.snapshot.symbols.typeIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "symbolKinds", facts.snapshot.symbols.symbolKinds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "declarationSpanIds",
            facts.snapshot.symbols.declarationSpanIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "ownerSymbolIds", facts.snapshot.symbols.ownerSymbolIds, err) ||
       !csgCompilerWireCidArrayField(
            lines[10], "declarationHeaderCids",
            facts.symbolDeclarationHeaderCids, err) ||
       !csgCompilerWireCidArrayField(
           lines[10], "declarationPathCids",
            facts.symbolDeclarationPathCids, err) ||
       !csgCompilerWireBoolArrayField(
            lines[10], "exportedFlags",
            facts.symbolExportedFlags, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "functionIds",
            facts.symbolFunctionIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "externFunctionIds",
            facts.symbolExternFunctionIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "genericConstraintStarts",
            facts.symbolGenericConstraintStarts, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "genericConstraintCounts",
            facts.symbolGenericConstraintCounts, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "genericConstraintTypeIds",
            facts.symbolGenericConstraintTypeIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "genericParameterParserRows",
            facts.symbolGenericParameterParserRows, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "genericParameterOrdinals",
            facts.symbolGenericParameterOrdinals, err) ||
       !csgCompilerWireIntArrayField(
            lines[10], "genericParameterDefaultTypeIds",
            facts.symbolGenericParameterDefaultTypeIds, err):
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            facts.snapshot.declarations)
        return false
    if !csgCompilerWireIntArrayField(
           lines[7], "declarationProducerSourceIds",
           facts.snapshot.parserSidecars.declarationProducerSourceIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationSourceLocalRows",
           facts.snapshot.parserSidecars.declarationSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationKinds",
           facts.snapshot.parserSidecars.declarationKinds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationNameTokenIds",
           facts.snapshot.parserSidecars.declarationNameTokenIds, err) ||
       !csgCompilerWireIntArrayField(
            lines[7], "declarationOwnerIds",
           facts.snapshot.parserSidecars.declarationOwnerIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationLexicalScopeIds",
           facts.parserDeclarationLexicalScopeIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationFunctionRows",
           facts.snapshot.parserSidecars.declarationFunctionRows, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationDefaultStatementRootRows",
           facts.snapshot.parserSidecars.declarationDefaultStatementRootRows,
           err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationTypeSyntaxRootIds",
           facts.parserDeclarationTypeSyntaxRootIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationSpanIds",
           facts.snapshot.parserSidecars.declarationSpanIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationNameSpanIds",
           facts.snapshot.parserSidecars.declarationNameSpanIds, err) ||
       !csgCompilerWireBoolArrayField(
           lines[7], "declarationMutableFlags",
           facts.parserDeclarationMutableFlags, err) ||
       !csgCompilerWireBoolArrayField(
           lines[7], "declarationExportedFlags",
           facts.parserDeclarationExportedFlags, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationLexicalScopeProducerSourceIds",
           facts.parserDeclarationScopeProducerSourceIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationLexicalScopeSourceLocalRows",
           facts.parserDeclarationScopeSourceLocalRows, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationLexicalScopeKinds",
           facts.parserDeclarationScopeKinds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationLexicalScopeParentIds",
           facts.parserDeclarationScopeParentIds, err) ||
       !csgCompilerWireIntArrayField(
           lines[7], "declarationLexicalScopeOwnerDeclarationIds",
           facts.parserDeclarationScopeOwnerDeclarationIds, err) ||
