@borrows
fn csgArtifactsMembershipFail(
        error: str):
        CsgCoreMerkleMembershipResult =
    var out: CsgCoreMerkleMembershipResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleMembershipEncode(
        header: CsgCoreMerkleMembershipHeader,
        records: CsgCoreMerkleMembershipRecord[]):
        CsgCoreMerkleMembershipResult =
    if header.sourceId.len == 0 ||
       header.factKind.len == 0 ||
       header.factCount <= 0:
        return csgArtifactsMembershipFail(
            "merkle_membership_header_invalid")
    if csgArtifactsReservedKind(header.factKind):
        return csgArtifactsMembershipFail(
            "merkle_membership_fact_kind_reserved")
    if header.partitionId !=
       csgArtifactsPartitionId(
           header.sourceId, header.factKind):
        return csgArtifactsMembershipFail(
            "merkle_membership_partition_id_mismatch")
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.sourceCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.factsCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.dagRootCid):
        return csgArtifactsMembershipFail(
            "merkle_membership_header_cid_invalid")
    if !csgArtifactsSubgraphForDag(
           header.factCount,
           header.dagRootCid,
           header.factsRoot):
        return csgArtifactsMembershipFail(
            "merkle_membership_facts_root_mismatch")
    if records.len != header.factCount:
        return csgArtifactsMembershipFail(
            "merkle_membership_count_mismatch")
    for i in 0..<records.len:
        if records[i].partitionId !=
               header.partitionId ||
           records[i].sourceId != header.sourceId ||
           records[i].sourceCid != header.sourceCid:
            return csgArtifactsMembershipFail(
                "merkle_membership_scope_mismatch")
        let recordError =
            csgArtifactsLeafBindingError(
                records[i].factKey,
                records[i].factHash,
                records[i].leafCid)
        if recordError.len > 0:
            return csgArtifactsMembershipFail(
                recordError)
        if i > 0:
            let order =
                csgArtifactsMembershipRecordCompare(
                    records[i - 1].factKey,
                    records[i].factKey)
            if order == 0:
                return csgArtifactsMembershipFail(
                    "merkle_membership_duplicate")
            if order > 0:
                return csgArtifactsMembershipFail(
                    "merkle_membership_non_canonical_order")
    var recordLines: str[]
    for i in 0..<records.len:
        add(
            recordLines,
            csgArtifactsMembershipRecordLine(
                records[i]))
    let rootDag =
        merkle_dag.CsgCoreMerkleBuild(
            recordLines)
    if !rootDag.ok:
        return csgArtifactsMembershipFail(
            csgArtifactsCat(
                "merkle_membership_root ",
                rootDag.error))
    var wire: csgMerkleMembershipWireHeader
    wire.header =
        csgArtifactsCloneMembershipHeader(
            header)
    wire.membershipRoot =
        strings.CloneStr(rootDag.subgraphCid)
    wire.recordCount = records.len
    var lines: str[]
    add(
        lines,
        csgArtifactsMembershipHeaderLine(wire))
    for i in 0..<recordLines.len:
        add(
            lines,
            strings.CloneStr(recordLines[i]))
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgArtifactsMembershipFail(
            csgArtifactsCat(
                "merkle_membership_encode ",
                encoded.error))
    var out: CsgCoreMerkleMembershipResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreMerkleMembershipDomain,
            encoded.bytes)
    out.bytes = encoded.bytes
    out.lines = lines
    out.header =
        csgArtifactsCloneMembershipHeader(
            header)
    out.membershipRoot =
        strings.CloneStr(rootDag.subgraphCid)
    out.recordCount = records.len
    for i in 0..<records.len:
        add(
            out.records,
            csgArtifactsCloneMembershipRecord(
                records[i]))
    return out

@borrows
fn csgArtifactsDecodeMembershipHeader(
        line: str,
        out: var csgMerkleMembershipWireHeader,
        error: var str): bool =
    var entryCountText: str
    var factCountText: str
    var idText: str
    if !csgArtifactsStringField(
           line, "dag_root_cid",
           out.header.dagRootCid) ||
       !csgArtifactsStringField(
           line, "entry_count",
           entryCountText) ||
       !csgArtifactsStringField(
           line, "fact_count",
           factCountText) ||
       !csgArtifactsStringField(
           line, "fact_kind",
           out.header.factKind) ||
       !csgArtifactsStringField(
           line, "facts_cid",
           out.header.factsCid) ||
       !csgArtifactsStringField(
           line, "facts_root",
           out.header.factsRoot) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "membership_root",
           out.membershipRoot) ||
       !csgArtifactsStringField(
           line, "partition_id",
           out.header.partitionId) ||
       !csgArtifactsStringField(
           line, "source_cid",
           out.header.sourceCid) ||
       !csgArtifactsStringField(
           line, "source_id",
           out.header.sourceId) ||
       !csgArtifactsInt32(
           entryCountText, out.recordCount) ||
       !csgArtifactsInt32(
           factCountText,
           out.header.factCount):
        error =
            "merkle_membership_header_field_invalid"
        return false
    if idText !=
       csgArtifactsMembershipHeaderId(
           out.header.partitionId) ||
       csgArtifactsMembershipHeaderLine(out) != line:
        error =
            "merkle_membership_header_non_canonical"
        return false
    return true

@borrows
fn csgArtifactsDecodeMembershipRecord(
        line: str,
        out: var CsgCoreMerkleMembershipRecord,
        error: var str): bool =
    var idText: str
    if !csgArtifactsStringField(
           line, "fact_hash", out.factHash) ||
       !csgArtifactsStringField(
           line, "fact_key", out.factKey) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "leaf_cid", out.leafCid) ||
       !csgArtifactsStringField(
           line, "partition_id",
           out.partitionId) ||
       !csgArtifactsStringField(
           line, "source_cid", out.sourceCid) ||
       !csgArtifactsStringField(
           line, "source_id", out.sourceId):
        error =
            "merkle_membership_record_field_invalid"
        return false
    if idText !=
       csgArtifactsMembershipRecordId(out) ||
       csgArtifactsMembershipRecordLine(out) != line:
        error =
            "merkle_membership_record_non_canonical"
        return false
    return true

@borrows
fn CsgCoreMerkleMembershipDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleMembershipResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgArtifactsMembershipFail(
            csgArtifactsCat(
                "merkle_membership_decode ",
                decoded.error))
    var wire: csgMerkleMembershipWireHeader
    var headerSeen: bool
    var records: CsgCoreMerkleMembershipRecord[]
    for i in 0..<decoded.lines.len:
        let kind =
            field.CsgCoreJsonKind(decoded.lines[i])
        if !kind.found:
            return csgArtifactsMembershipFail(
                "merkle_membership_line_kind_missing")
        if kind.value == CsgMerkleMembershipHeaderKind:
            if headerSeen:
                return csgArtifactsMembershipFail(
                    "merkle_membership_header_duplicate")
            var headerError: str
            if !csgArtifactsDecodeMembershipHeader(
                   decoded.lines[i],
                   wire,
                   headerError):
                return csgArtifactsMembershipFail(
                    headerError)
            headerSeen = true
        elif kind.value == CsgMerkleMembershipKind:
            var record: CsgCoreMerkleMembershipRecord
            var recordError: str
            if !csgArtifactsDecodeMembershipRecord(
                   decoded.lines[i],
                   record,
                   recordError):
                return csgArtifactsMembershipFail(
                    recordError)
            add(records, record)
        else:
            return csgArtifactsMembershipFail(
                "merkle_membership_kind_invalid")
    if !headerSeen:
        return csgArtifactsMembershipFail(
            "merkle_membership_header_missing")
    var sortedRecords: CsgCoreMerkleMembershipRecord[]
    csgArtifactsSortMembershipRecords(
        records, sortedRecords)
    var reencoded =
        CsgCoreMerkleMembershipEncode(
            wire.header, sortedRecords)
    if !reencoded.ok:
        return reencoded
    if wire.recordCount !=
           reencoded.recordCount ||
       wire.membershipRoot !=
           reencoded.membershipRoot:
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsMembershipFail(
            "merkle_membership_header_mismatch")
    if !rawbytes.BytesEqual(
           bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsMembershipFail(
            "merkle_membership_non_canonical")
    return reencoded

fn CsgCoreMerkleDependencyConsumerProjection(): str =
    return "consumer"

fn CsgCoreMerkleDependencyProviderProjection(): str =
    return "provider"

@borrows
fn csgArtifactsCloneDependencyHeader(
        header: CsgCoreMerkleDependencyShardHeader):
        CsgCoreMerkleDependencyShardHeader =
    var out: CsgCoreMerkleDependencyShardHeader
    out.profileSetCid =
        strings.CloneStr(header.profileSetCid)
    out.projection = strings.CloneStr(header.projection)
    out.shardKey = strings.CloneStr(header.shardKey)
    return out

@borrows
fn csgArtifactsCloneDependencyRecord(
        record: CsgCoreMerkleDependencyRecord):
        CsgCoreMerkleDependencyRecord =
    var out: CsgCoreMerkleDependencyRecord
    out.consumerSource =
        strings.CloneStr(record.consumerSource)
    out.providerSource =
        strings.CloneStr(record.providerSource)
    out.selector = strings.CloneStr(record.selector)
    out.providerSubgraphCid =
        strings.CloneStr(
            record.providerSubgraphCid)
    return out

@borrows
fn csgArtifactsDependencyRecordId(
        record: CsgCoreMerkleDependencyRecord):
        str =
    let pair =
        csgArtifactsCat(
            csgArtifactsTuplePart(
                record.consumerSource),
            csgArtifactsCat(
                csgArtifactsTuplePart(
                    record.providerSource),
                csgArtifactsTuplePart(
                    record.selector)))
    let digest =
        merkle_dag.CsgCoreMerkleKeyHash(
            csgArtifactsCat(
                "dependency:", pair))
    return csgArtifactsCat(
        "dep:",
        layout.FixedBytes32Hex(digest))

@borrows
fn csgArtifactsDependencyRecordCompare(
        left: CsgCoreMerkleDependencyRecord,
        right: CsgCoreMerkleDependencyRecord):
        int32 =
    var order =
        csgArtifactsTextCompare(
            left.consumerSource,
            right.consumerSource)
    if order != 0:
        return order
    order =
        csgArtifactsTextCompare(
            left.providerSource,
            right.providerSource)
    if order != 0:
        return order
    return csgArtifactsTextCompare(
        left.selector, right.selector)

@borrows
fn csgArtifactsDependencyHeaderError(
        header: CsgCoreMerkleDependencyShardHeader):
        str =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.profileSetCid):
        return "merkle_dependency_profile_set_cid_invalid"
    if header.projection !=
           CsgCoreMerkleDependencyConsumerProjection() &&
       header.projection !=
           CsgCoreMerkleDependencyProviderProjection():
        return "merkle_dependency_projection_invalid"
    if header.shardKey.len == 0:
        return "merkle_dependency_shard_key_empty"
    return ""

@borrows
fn csgArtifactsDependencyRecordsOrderError(
        header: CsgCoreMerkleDependencyShardHeader,
        records: CsgCoreMerkleDependencyRecord[]):
        str =
    for i in 0..<records.len:
        if records[i].consumerSource.len == 0 ||
           records[i].providerSource.len == 0 ||
           records[i].selector.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               records[i].providerSubgraphCid):
            return "merkle_dependency_record_invalid"
        if records[i].consumerSource ==
           records[i].providerSource:
            return "merkle_dependency_self_edge"
        if header.projection ==
               CsgCoreMerkleDependencyConsumerProjection() &&
           records[i].consumerSource != header.shardKey:
            return "merkle_dependency_consumer_shard_mismatch"
        if header.projection ==
               CsgCoreMerkleDependencyProviderProjection() &&
           records[i].providerSource != header.shardKey:
            return "merkle_dependency_provider_shard_mismatch"
        if i > 0:
            let order =
                csgArtifactsDependencyRecordCompare(
                    records[i - 1], records[i])
            if order == 0:
                return "merkle_dependency_duplicate"
            if order > 0:
                return "merkle_dependency_non_canonical_order"
    return ""

@borrows
fn csgArtifactsSortDependencyRecords(
        records: CsgCoreMerkleDependencyRecord[],
        out: var CsgCoreMerkleDependencyRecord[]) =
    out = []
    var order: int32[]
    var scratch: int32[]
    for i in 0..<records.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgArtifactsDependencyRecordCompare(
                        records[order[left]],
                        records[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    for i in 0..<order.len:
        add(
            out,
            csgArtifactsCloneDependencyRecord(
                records[order[i]]))

@borrows
fn csgArtifactsDependencyRecordLine(
        record: CsgCoreMerkleDependencyRecord):
        str =
    var out: str = "{\"consumer_source\":"
    csgArtifactsAppend(
        out,
        csgArtifactsJson(record.consumerSource))
    csgArtifactsAppend(out, ",\"id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            csgArtifactsDependencyRecordId(
                record)))
    csgArtifactsAppend(
        out,
        ",\"kind\":\"csg.merkle.dependency\"")
    csgArtifactsAppend(out, ",\"provider_source\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(record.providerSource))
    csgArtifactsAppend(
        out, ",\"provider_subgraph_cid\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            record.providerSubgraphCid))
    csgArtifactsAppend(out, ",\"selector\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(record.selector))
    csgArtifactsAppend(out, "}")
    return out

@borrows
fn csgArtifactsDependencyHeaderLine(
        wire: csgMerkleDependencyWireHeader):
        str =
    var out: str = "{\"entry_count\":"
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                wire.entryCount)))
    let shardTuple =
        csgArtifactsCat(
            csgArtifactsTuplePart(
                wire.header.projection),
            csgArtifactsTuplePart(
                wire.header.shardKey))
    let shardId =
        csgArtifactsCat(
            "dependency-shard:",
            layout.FixedBytes32Hex(
                merkle_dag.CsgCoreMerkleKeyHash(
                    csgArtifactsCat(
                        "dependency_shard:",
                        shardTuple))))
    csgArtifactsAppend(out, ",\"id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(shardId))
    csgArtifactsAppend(
        out,
        ",\"kind\":\"csg.merkle.dependency_shard\"")
    csgArtifactsAppend(out, ",\"profile_set_cid\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            wire.header.profileSetCid))
    csgArtifactsAppend(out, ",\"projection\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            wire.header.projection))
    csgArtifactsAppend(out, ",\"shard_key\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.header.shardKey))
    csgArtifactsAppend(out, ",\"shard_root\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.shardRoot))
    csgArtifactsAppend(out, "}")
    return out

@borrows
fn csgArtifactsDependencyFail(
        error: str):
        CsgCoreMerkleDependencyShardResult =
    var out: CsgCoreMerkleDependencyShardResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleDependencyShardEncode(
        header: CsgCoreMerkleDependencyShardHeader,
        records: CsgCoreMerkleDependencyRecord[]):
        CsgCoreMerkleDependencyShardResult =
    let headerError =
        csgArtifactsDependencyHeaderError(header)
    if headerError.len > 0:
        return csgArtifactsDependencyFail(
            headerError)
    let orderError =
        csgArtifactsDependencyRecordsOrderError(
            header, records)
    if orderError.len > 0:
        return csgArtifactsDependencyFail(
            orderError)
    var recordLines: str[]
    for i in 0..<records.len:
        add(
            recordLines,
            csgArtifactsDependencyRecordLine(
                records[i]))
    let rootDag =
        merkle_dag.CsgCoreMerkleBuild(
            recordLines)
    if !rootDag.ok:
        return csgArtifactsDependencyFail(
            csgArtifactsCat(
                "merkle_dependency_root ",
                rootDag.error))
    var wire: csgMerkleDependencyWireHeader
    wire.header =
        csgArtifactsCloneDependencyHeader(header)
    wire.shardRoot =
        strings.CloneStr(rootDag.subgraphCid)
    wire.entryCount = records.len
    var lines: str[]
    add(
        lines,
        csgArtifactsDependencyHeaderLine(wire))
    for i in 0..<recordLines.len:
        add(
            lines,
            strings.CloneStr(recordLines[i]))
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgArtifactsDependencyFail(
            csgArtifactsCat(
                "merkle_dependency_encode ",
                encoded.error))
    var out: CsgCoreMerkleDependencyShardResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreMerkleDependencyDomain,
            encoded.bytes)
    out.bytes = encoded.bytes
    out.lines = lines
    out.header =
        csgArtifactsCloneDependencyHeader(header)
    out.shardRoot =
        strings.CloneStr(rootDag.subgraphCid)
    out.entryCount = records.len
    for i in 0..<records.len:
        add(
            out.records,
            csgArtifactsCloneDependencyRecord(
                records[i]))
    return out

@borrows
fn csgArtifactsDecodeDependencyHeader(
        line: str,
        out: var csgMerkleDependencyWireHeader,
        error: var str): bool =
    var countText: str
    var idText: str
    if !csgArtifactsStringField(
           line, "entry_count",
           countText) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "profile_set_cid",
           out.header.profileSetCid) ||
       !csgArtifactsStringField(
           line, "projection",
           out.header.projection) ||
       !csgArtifactsStringField(
           line, "shard_key",
           out.header.shardKey) ||
       !csgArtifactsStringField(
           line, "shard_root",
           out.shardRoot) ||
       !csgArtifactsInt32(
           countText, out.entryCount):
        error =
            "merkle_dependency_header_field_invalid"
        return false
    let shardTuple =
        csgArtifactsCat(
            csgArtifactsTuplePart(
                out.header.projection),
            csgArtifactsTuplePart(
                out.header.shardKey))
    let expectedId =
        csgArtifactsCat(
            "dependency-shard:",
            layout.FixedBytes32Hex(
                merkle_dag.CsgCoreMerkleKeyHash(
                    csgArtifactsCat(
                        "dependency_shard:",
                        shardTuple))))
    if idText != expectedId ||
       csgArtifactsDependencyHeaderLine(out) != line:
        error =
            "merkle_dependency_header_non_canonical"
        return false
    return true

@borrows
fn csgArtifactsDecodeDependencyRecord(
        line: str,
        out: var CsgCoreMerkleDependencyRecord,
        error: var str): bool =
    var idText: str
    if !csgArtifactsStringField(
           line, "consumer_source",
           out.consumerSource) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "provider_source",
           out.providerSource) ||
       !csgArtifactsStringField(
           line, "provider_subgraph_cid",
           out.providerSubgraphCid) ||
       !csgArtifactsStringField(
           line, "selector", out.selector):
        error =
            "merkle_dependency_record_field_invalid"
        return false
    if idText !=
       csgArtifactsDependencyRecordId(out) ||
       csgArtifactsDependencyRecordLine(out) != line:
        error =
            "merkle_dependency_record_non_canonical"
        return false
    return true

@borrows
fn CsgCoreMerkleDependencyShardDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleDependencyShardResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgArtifactsDependencyFail(
            csgArtifactsCat(
                "merkle_dependency_decode ",
                decoded.error))
    var wire: csgMerkleDependencyWireHeader
    var headerSeen: bool
    var records: CsgCoreMerkleDependencyRecord[]
    for i in 0..<decoded.lines.len:
        let kind =
            field.CsgCoreJsonKind(decoded.lines[i])
        if !kind.found:
            return csgArtifactsDependencyFail(
                "merkle_dependency_line_kind_missing")
        if kind.value == CsgMerkleDependencyHeaderKind:
            if headerSeen:
                return csgArtifactsDependencyFail(
                    "merkle_dependency_header_duplicate")
            var headerError: str
            if !csgArtifactsDecodeDependencyHeader(
                   decoded.lines[i],
                   wire,
                   headerError):
                return csgArtifactsDependencyFail(
                    headerError)
            headerSeen = true
        elif kind.value == CsgMerkleDependencyKind:
            var record: CsgCoreMerkleDependencyRecord
            var recordError: str
            if !csgArtifactsDecodeDependencyRecord(
                   decoded.lines[i],
                   record,
                   recordError):
                return csgArtifactsDependencyFail(
                    recordError)
            add(records, record)
        else:
            return csgArtifactsDependencyFail(
                "merkle_dependency_kind_invalid")
    if !headerSeen:
        return csgArtifactsDependencyFail(
            "merkle_dependency_header_missing")
    var sortedRecords: CsgCoreMerkleDependencyRecord[]
    csgArtifactsSortDependencyRecords(
        records, sortedRecords)
    var reencoded =
        CsgCoreMerkleDependencyShardEncode(
            wire.header, sortedRecords)
    if !reencoded.ok:
        return reencoded
    if wire.entryCount !=
           reencoded.entryCount ||
       wire.shardRoot != reencoded.shardRoot:
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsDependencyFail(
            "merkle_dependency_header_mismatch")
    if !rawbytes.BytesEqual(
           bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsDependencyFail(
            "merkle_dependency_non_canonical")
    return reencoded

@borrows
fn csgArtifactsCloneSummaryHeader(
        header: CsgCoreMerkleSummaryHeader):
        CsgCoreMerkleSummaryHeader =
    var out: CsgCoreMerkleSummaryHeader
    out.standard = strings.CloneStr(header.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(header.profiles)
    out.profileSetCid =
        strings.CloneStr(header.profileSetCid)
    out.complete = header.complete
    out.schemaCid = strings.CloneStr(header.schemaCid)
    out.factsRoot =
        strings.CloneStr(header.factsRoot)
    out.dagRootCid =
        strings.CloneStr(header.dagRootCid)
    out.factCount = header.factCount
    out.nodeCount = header.nodeCount
    out.partitionRoot =
        strings.CloneStr(header.partitionRoot)
    out.partitionCount = header.partitionCount
    out.dependencyConsumerRoot =
        strings.CloneStr(
            header.dependencyConsumerRoot)
    out.dependencyProviderRoot =
        strings.CloneStr(
            header.dependencyProviderRoot)
    out.dependencyCount = header.dependencyCount
    out.dependencyConsumerShardCount =
        header.dependencyConsumerShardCount
    out.dependencyProviderShardCount =
        header.dependencyProviderShardCount
    out.queryShardRoot =
        strings.CloneStr(header.queryShardRoot)
    out.queryIndexCount = header.queryIndexCount
    out.queryShardCount = header.queryShardCount
    out.unsupportedCount = header.unsupportedCount
    out.tombstoneCount = header.tombstoneCount
    out.runtimeRequirementCount =
        header.runtimeRequirementCount
    return out

@borrows
fn csgArtifactsSummaryHeaderError(
        header: CsgCoreMerkleSummaryHeader):
        str =
    if header.standard !=
       validator.CsgCoreStandardIdentity():
        return "merkle_summary_standard_invalid"
    let profileError =
        validator.CsgCoreProfilesCanonicalError(
            header.profiles)
    if profileError.len > 0:
        return csgArtifactsCat(
            "merkle_summary_profiles ", profileError)
    if header.profileSetCid !=
       validator.CsgCoreProfileSetCid(header.profiles):
        return "merkle_summary_profile_set_cid_mismatch"
    if !header.complete ||
       header.unsupportedCount != 0 ||
       header.tombstoneCount != 0 ||
       header.runtimeRequirementCount != 0:
        return "merkle_summary_production_admission_failed"
    if header.factCount < 0 ||
       header.nodeCount < 0 ||
       header.partitionCount < 0 ||
       header.dependencyCount < 0 ||
       header.dependencyConsumerShardCount < 0 ||
       header.dependencyProviderShardCount < 0 ||
       header.queryIndexCount < 0 ||
       header.queryShardCount < 0 ||
       header.queryShardCount >
           CsgCoreMerkleQueryBucketCount():
        return "merkle_summary_count_invalid"
    if header.factCount > 0 &&
       (header.nodeCount <= 0 ||
        header.partitionCount <= 0):
        return "merkle_summary_nonempty_structure_missing"
    if header.factCount == 0 &&
       (header.nodeCount != 0 ||
        header.partitionCount != 0):
        return "merkle_summary_empty_structure_present"
    let expectedNodeCount =
        merkle_manifest.CsgCoreMerkleExpectedNodeCount(
            header.factCount)
    if expectedNodeCount < 0:
        return "merkle_summary_fact_count_overflow"
    if header.nodeCount != expectedNodeCount:
        return "merkle_summary_node_count_mismatch"
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.schemaCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.dagRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.partitionRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.dependencyConsumerRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.dependencyProviderRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.queryShardRoot):
        return "merkle_summary_cid_invalid"
    if !csgArtifactsBoundRootForDag(
           header.standard,
           header.profiles,
           header.schemaCid,
           header.factCount,
           header.dagRootCid,
           header.factsRoot):
        return "merkle_summary_facts_root_mismatch"
    return ""

@borrows
fn csgArtifactsSummaryLine(
        header: CsgCoreMerkleSummaryHeader):
        str =
    var out: str = "{\"complete\":\"1\""
    csgArtifactsAppend(out, ",\"dag_root_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(header.dagRootCid))
    csgArtifactsAppend(
        out, ",\"dependency_consumer_root\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            header.dependencyConsumerRoot))
    csgArtifactsAppend(
        out, ",\"dependency_consumer_shard_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.dependencyConsumerShardCount)))
    csgArtifactsAppend(out, ",\"dependency_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.dependencyCount)))
    csgArtifactsAppend(
        out, ",\"dependency_provider_root\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            header.dependencyProviderRoot))
    csgArtifactsAppend(
        out, ",\"dependency_provider_shard_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.dependencyProviderShardCount)))
    csgArtifactsAppend(out, ",\"fact_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(header.factCount)))
    csgArtifactsAppend(out, ",\"facts_root\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(header.factsRoot))
    csgArtifactsAppend(out, ",\"id\":\"summary\"")
    csgArtifactsAppend(
        out, ",\"kind\":\"csg.merkle.summary\"")
    csgArtifactsAppend(out, ",\"node_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(header.nodeCount)))
    csgArtifactsAppend(out, ",\"partition_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.partitionCount)))
    csgArtifactsAppend(out, ",\"partition_root\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(header.partitionRoot))
    csgArtifactsAppend(out, ",\"profile_set_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(header.profileSetCid))
    csgArtifactsAppend(out, ",\"profiles\":")
    csgArtifactsAppend(
        out, csgArtifactsStringArray(header.profiles))
    csgArtifactsAppend(out, ",\"query_index_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.queryIndexCount)))
    csgArtifactsAppend(out, ",\"query_shard_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.queryShardCount)))
    csgArtifactsAppend(out, ",\"query_shard_root\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(header.queryShardRoot))
    csgArtifactsAppend(
        out, ",\"runtime_requirement_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.runtimeRequirementCount)))
    csgArtifactsAppend(out, ",\"schema_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(header.schemaCid))
    csgArtifactsAppend(out, ",\"standard\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(header.standard))
    csgArtifactsAppend(out, ",\"tombstone_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.tombstoneCount)))
    csgArtifactsAppend(out, ",\"unsupported_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(
                header.unsupportedCount)))
    csgArtifactsAppend(out, "}")
    return out

@borrows
fn csgArtifactsSummaryFail(
        error: str):
        CsgCoreMerkleSummaryResult =
    var out: CsgCoreMerkleSummaryResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleSummaryEncode(
        header: CsgCoreMerkleSummaryHeader):
        CsgCoreMerkleSummaryResult =
    let headerError =
        csgArtifactsSummaryHeaderError(header)
    if headerError.len > 0:
        return csgArtifactsSummaryFail(
            headerError)
    let lines = [csgArtifactsSummaryLine(header)]
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgArtifactsSummaryFail(
            csgArtifactsCat(
                "merkle_summary_encode ",
                encoded.error))
    var out: CsgCoreMerkleSummaryResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreMerkleSummaryDomain,
            encoded.bytes)
    out.bytes = encoded.bytes
    out.lines = lines
    out.header =
        csgArtifactsCloneSummaryHeader(header)
    return out

@borrows
fn csgArtifactsDecodeSummaryHeader(
        line: str,
        out: var CsgCoreMerkleSummaryHeader,
        error: var str): bool =
    var completeText: str
    var dependencyConsumerShardCountText: str
    var dependencyCountText: str
    var dependencyProviderShardCountText: str
    var factCountText: str
    var idText: str
    var nodeCountText: str
    var partitionCountText: str
    var queryIndexCountText: str
    var queryShardCountText: str
    var runtimeCountText: str
    var tombstoneCountText: str
    var unsupportedCountText: str
    if !csgArtifactsStringField(
           line, "complete", completeText) ||
       !csgArtifactsStringField(
           line, "dag_root_cid",
           out.dagRootCid) ||
       !csgArtifactsStringField(
           line, "dependency_consumer_root",
           out.dependencyConsumerRoot) ||
       !csgArtifactsStringField(
           line, "dependency_consumer_shard_count",
           dependencyConsumerShardCountText) ||
       !csgArtifactsStringField(
           line, "dependency_count",
           dependencyCountText) ||
       !csgArtifactsStringField(
           line, "dependency_provider_root",
           out.dependencyProviderRoot) ||
       !csgArtifactsStringField(
           line, "dependency_provider_shard_count",
           dependencyProviderShardCountText) ||
       !csgArtifactsStringField(
           line, "fact_count", factCountText) ||
       !csgArtifactsStringField(
           line, "facts_root", out.factsRoot) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "node_count",
           nodeCountText) ||
       !csgArtifactsStringField(
           line, "partition_count",
           partitionCountText) ||
       !csgArtifactsStringField(
           line, "partition_root",
           out.partitionRoot) ||
       !csgArtifactsStringField(
           line, "profile_set_cid",
           out.profileSetCid) ||
       !csgArtifactsStringArrayField(
           line, "profiles", out.profiles) ||
       !csgArtifactsStringField(
           line, "query_index_count",
           queryIndexCountText) ||
       !csgArtifactsStringField(
           line, "query_shard_count",
           queryShardCountText) ||
       !csgArtifactsStringField(
           line, "query_shard_root",
           out.queryShardRoot) ||
       !csgArtifactsStringField(
           line, "runtime_requirement_count",
           runtimeCountText) ||
       !csgArtifactsStringField(
           line, "schema_cid", out.schemaCid) ||
       !csgArtifactsStringField(
           line, "standard", out.standard) ||
       !csgArtifactsStringField(
           line, "tombstone_count",
           tombstoneCountText) ||
       !csgArtifactsStringField(
           line, "unsupported_count",
           unsupportedCountText) ||
       !csgArtifactsInt32(
           dependencyCountText,
           out.dependencyCount) ||
       !csgArtifactsInt32(
           dependencyConsumerShardCountText,
           out.dependencyConsumerShardCount) ||
       !csgArtifactsInt32(
           dependencyProviderShardCountText,
           out.dependencyProviderShardCount) ||
       !csgArtifactsInt32(
           factCountText, out.factCount) ||
       !csgArtifactsInt32(
           nodeCountText,
           out.nodeCount) ||
       !csgArtifactsInt32(
           partitionCountText,
           out.partitionCount) ||
       !csgArtifactsInt32(
           queryIndexCountText,
           out.queryIndexCount) ||
       !csgArtifactsInt32(
           queryShardCountText,
           out.queryShardCount) ||
       !csgArtifactsInt32(
           runtimeCountText,
           out.runtimeRequirementCount) ||
       !csgArtifactsInt32(
           tombstoneCountText,
           out.tombstoneCount) ||
       !csgArtifactsInt32(
           unsupportedCountText,
           out.unsupportedCount):
        error = "merkle_summary_field_invalid"
        return false
    if completeText != "1":
        error = "merkle_summary_complete_invalid"
        return false
    out.complete = true
    if idText != "summary" ||
       csgArtifactsSummaryLine(out) != line:
        error = "merkle_summary_non_canonical"
        return false
    return true

@borrows
fn CsgCoreMerkleSummaryDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleSummaryResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgArtifactsSummaryFail(
            csgArtifactsCat(
                "merkle_summary_decode ",
                decoded.error))
    if decoded.lines.len != 1:
        return csgArtifactsSummaryFail(
            "merkle_summary_line_count_invalid")
    let kind =
        field.CsgCoreJsonKind(decoded.lines[0])
    if !kind.found ||
       kind.value != CsgMerkleSummaryKind:
        return csgArtifactsSummaryFail(
            "merkle_summary_kind_invalid")
    var header: CsgCoreMerkleSummaryHeader
    var headerError: str
    if !csgArtifactsDecodeSummaryHeader(
           decoded.lines[0],
           header,
           headerError):
        return csgArtifactsSummaryFail(
            headerError)
    var reencoded =
        CsgCoreMerkleSummaryEncode(header)
    if !reencoded.ok:
        return reencoded
    if !rawbytes.BytesEqual(
           bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsSummaryFail(
            "merkle_summary_non_canonical_bytes")
    return reencoded

@borrows
fn csgArtifactsCloneQueryHeader(
        header: CsgCoreMerkleQueryShardHeader):
        CsgCoreMerkleQueryShardHeader =
    var out: CsgCoreMerkleQueryShardHeader
    out.profileSetCid =
        strings.CloneStr(header.profileSetCid)
    out.bucket = strings.CloneStr(header.bucket)
    return out

fn CsgCoreMerkleQueryBucketCount(): int32 =
    return 256

fn CsgCoreMerkleQueryBucketName(bucket: int32): str =
    if bucket < 0 ||
       bucket >= CsgCoreMerkleQueryBucketCount():
        return ""
    let digits = "0123456789abcdef"
    return csgArtifactsCat(
        strings.CloneStrRange(
            digits, bucket / 16, 1),
        strings.CloneStrRange(
            digits, bucket % 16, 1))

@borrows
fn CsgCoreMerkleQueryBucket(
        indexKind: str,
        term: str): str =
    let pair =
        csgArtifactsCat(
            csgArtifactsTuplePart(indexKind),
            csgArtifactsTuplePart(term))
    let digest =
        merkle_dag.CsgCoreMerkleKeyHash(
            csgArtifactsCat(
                "csg_core.query_bucket:", pair))
    return CsgCoreMerkleQueryBucketName(
        int32(digest.data[0]) & 255)

@borrows
fn csgArtifactsQueryBucketValid(bucket: str): bool =
    # A bucket is the byte rendered as two lowercase hex digits.
    if bucket.len != 2:
        return false
    for i in 0..<bucket.len:
        let c = bucket[i]
        if (c < '0' || c > '9') && (c < 'a' || c > 'f'):
            return false
    return true

@borrows
fn csgArtifactsCloneQueryRecord(
        record: CsgCoreMerkleQueryIndexRecord):
        CsgCoreMerkleQueryIndexRecord =
    var out: CsgCoreMerkleQueryIndexRecord
    out.indexKind =
        strings.CloneStr(record.indexKind)
    out.term = strings.CloneStr(record.term)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid =
        strings.CloneStr(record.sourceCid)
    return out

@borrows
fn csgArtifactsQueryHeaderError(
        header: CsgCoreMerkleQueryShardHeader):
        str =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.profileSetCid):
        return "merkle_query_index_header_invalid"
    if !csgArtifactsQueryBucketValid(header.bucket):
        return "merkle_query_index_bucket_invalid"
    return ""

@borrows
fn csgArtifactsQueryRecordId(
        record: CsgCoreMerkleQueryIndexRecord):
        str =
    let pair =
        csgArtifactsCat(
            csgArtifactsTuplePart(
                record.indexKind),
            csgArtifactsCat(
                csgArtifactsTuplePart(record.term),
                csgArtifactsCat(
                    csgArtifactsTuplePart(
                        record.factKey),
                    csgArtifactsCat(
                        csgArtifactsTuplePart(
                            record.partitionId),
                        csgArtifactsTuplePart(
                            record.sourceId)))))
    let digest =
        merkle_dag.CsgCoreMerkleKeyHash(
            csgArtifactsCat(
                "query_index:", pair))
    return csgArtifactsCat(
        "query:",
        layout.FixedBytes32Hex(digest))

@borrows
fn csgArtifactsQueryRecordCompare(
        left: CsgCoreMerkleQueryIndexRecord,
        right: CsgCoreMerkleQueryIndexRecord):
        int32 =
    var order =
        csgArtifactsTextCompare(
            left.indexKind, right.indexKind)
    if order != 0:
        return order
    order =
        csgArtifactsTextCompare(
            left.term, right.term)
    if order != 0:
        return order
    order =
        csgArtifactsTextCompare(
            left.factKey, right.factKey)
    if order != 0:
        return order
    order =
        csgArtifactsTextCompare(
            left.partitionId,
            right.partitionId)
    if order != 0:
        return order
    return csgArtifactsTextCompare(
        left.sourceId, right.sourceId)

@borrows
fn csgArtifactsQueryRecordError(
        record: CsgCoreMerkleQueryIndexRecord):
        str =
    if record.indexKind.len == 0 ||
       record.term.len == 0 ||
       record.partitionId.len == 0 ||
       record.sourceId.len == 0 ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           record.sourceCid):
        return "merkle_query_index_record_invalid"
    return csgArtifactsLeafBindingError(
        record.factKey,
        record.factHash,
        record.leafCid)

@borrows
fn csgArtifactsQueryRecordsOrderError(
        header: CsgCoreMerkleQueryShardHeader,
        records: CsgCoreMerkleQueryIndexRecord[]):
        str =
    for i in 0..<records.len:
        let recordError =
            csgArtifactsQueryRecordError(records[i])
        if recordError.len > 0:
            return recordError
        if CsgCoreMerkleQueryBucket(
               records[i].indexKind,
               records[i].term) != header.bucket:
            return "merkle_query_index_bucket_mismatch"
        if i > 0:
            let order =
                csgArtifactsQueryRecordCompare(
                    records[i - 1], records[i])
            if order == 0:
                return "merkle_query_index_duplicate"
            if order > 0:
                return "merkle_query_index_non_canonical_order"
    return ""

@borrows
fn csgArtifactsSortQueryRecords(
        records: CsgCoreMerkleQueryIndexRecord[],
        out: var CsgCoreMerkleQueryIndexRecord[]) =
    out = []
    var order: int32[]
    var scratch: int32[]
    for i in 0..<records.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgArtifactsQueryRecordCompare(
                        records[order[left]],
                        records[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    for i in 0..<order.len:
        add(
            out,
            csgArtifactsCloneQueryRecord(
                records[order[i]]))

@borrows
fn csgArtifactsQueryRecordLine(
        record: CsgCoreMerkleQueryIndexRecord):
        str =
    var out: str = "{\"fact_hash\":"
    csgArtifactsAppend(
        out, csgArtifactsJson(record.factHash))
    csgArtifactsAppend(out, ",\"fact_key\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.factKey))
    csgArtifactsAppend(out, ",\"id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            csgArtifactsQueryRecordId(record)))
    csgArtifactsAppend(out, ",\"index_kind\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.indexKind))
    csgArtifactsAppend(
        out,
        ",\"kind\":\"csg.merkle.query_index_entry\"")
    csgArtifactsAppend(out, ",\"leaf_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.leafCid))
    csgArtifactsAppend(out, ",\"partition_id\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.partitionId))
    csgArtifactsAppend(out, ",\"source_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.sourceCid))
    csgArtifactsAppend(out, ",\"source_id\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.sourceId))
    csgArtifactsAppend(out, ",\"term\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.term))
    csgArtifactsAppend(out, "}")
    return out

@borrows
fn csgArtifactsQueryHeaderLine(
        wire: csgMerkleQueryIndexWireHeader):
        str =
    var out: str = "{\"bucket\":"
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.header.bucket))
    csgArtifactsAppend(out, ",\"entry_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(wire.entryCount)))
    csgArtifactsAppend(out, ",\"id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            csgArtifactsCat(
                "query-shard:",
                wire.header.bucket)))
    csgArtifactsAppend(
        out,
        ",\"kind\":\"csg.merkle.query_shard\"")
    csgArtifactsAppend(out, ",\"profile_set_cid\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            wire.header.profileSetCid))
    csgArtifactsAppend(out, ",\"shard_root\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.shardRoot))
    csgArtifactsAppend(out, "}")
    return out

@borrows
fn csgArtifactsQueryFail(
        error: str):
        CsgCoreMerkleQueryShardResult =
    var out: CsgCoreMerkleQueryShardResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleQueryShardEncode(
        header: CsgCoreMerkleQueryShardHeader,
        records: CsgCoreMerkleQueryIndexRecord[]):
        CsgCoreMerkleQueryShardResult =
    let headerError =
        csgArtifactsQueryHeaderError(header)
    if headerError.len > 0:
        return csgArtifactsQueryFail(
            headerError)
    let orderError =
        csgArtifactsQueryRecordsOrderError(
            header, records)
    if orderError.len > 0:
        return csgArtifactsQueryFail(
            orderError)
    var recordLines: str[]
    for i in 0..<records.len:
        add(
            recordLines,
            csgArtifactsQueryRecordLine(
                records[i]))
    let rootDag =
        merkle_dag.CsgCoreMerkleBuild(
            recordLines)
    if !rootDag.ok:
        return csgArtifactsQueryFail(
            csgArtifactsCat(
                "merkle_query_index_root ",
                rootDag.error))
    var wire: csgMerkleQueryIndexWireHeader
    wire.header =
        csgArtifactsCloneQueryHeader(header)
    wire.shardRoot =
        strings.CloneStr(rootDag.subgraphCid)
    wire.entryCount = records.len
    var lines: str[]
    add(lines, csgArtifactsQueryHeaderLine(wire))
    for i in 0..<recordLines.len:
        add(
            lines,
            strings.CloneStr(recordLines[i]))
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgArtifactsQueryFail(
            csgArtifactsCat(
                "merkle_query_index_encode ",
                encoded.error))
    var out: CsgCoreMerkleQueryShardResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreMerkleQueryIndexDomain,
            encoded.bytes)
    out.bytes = encoded.bytes
    out.lines = lines
    out.header =
        csgArtifactsCloneQueryHeader(header)
    out.shardRoot =
        strings.CloneStr(rootDag.subgraphCid)
    out.entryCount = records.len
    for i in 0..<records.len:
        add(
            out.records,
            csgArtifactsCloneQueryRecord(
                records[i]))
    return out

@borrows
fn csgArtifactsDecodeQueryHeader(
        line: str,
        out: var csgMerkleQueryIndexWireHeader,
        error: var str): bool =
    var entryCountText: str
    var idText: str
    if !csgArtifactsStringField(
           line, "bucket",
           out.header.bucket) ||
       !csgArtifactsStringField(
           line, "entry_count",
           entryCountText) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "profile_set_cid",
           out.header.profileSetCid) ||
       !csgArtifactsStringField(
           line, "shard_root",
           out.shardRoot) ||
       !csgArtifactsInt32(
           entryCountText, out.entryCount):
        error =
            "merkle_query_index_header_field_invalid"
        return false
    if idText !=
           csgArtifactsCat(
               "query-shard:",
               out.header.bucket) ||
       csgArtifactsQueryHeaderLine(out) != line:
        error =
            "merkle_query_index_header_non_canonical"
        return false
    return true

@borrows
fn csgArtifactsDecodeQueryRecord(
        line: str,
        out: var CsgCoreMerkleQueryIndexRecord,
        error: var str): bool =
    var idText: str
    if !csgArtifactsStringField(
           line, "fact_hash", out.factHash) ||
       !csgArtifactsStringField(
           line, "fact_key", out.factKey) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "index_kind", out.indexKind) ||
       !csgArtifactsStringField(
           line, "leaf_cid", out.leafCid) ||
       !csgArtifactsStringField(
           line, "partition_id",
           out.partitionId) ||
       !csgArtifactsStringField(
           line, "source_cid", out.sourceCid) ||
       !csgArtifactsStringField(
           line, "source_id", out.sourceId) ||
       !csgArtifactsStringField(
           line, "term", out.term):
        error =
            "merkle_query_index_record_field_invalid"
        return false
    if idText != csgArtifactsQueryRecordId(out) ||
       csgArtifactsQueryRecordLine(out) != line:
        error =
            "merkle_query_index_record_non_canonical"
        return false
    return true

@borrows
fn CsgCoreMerkleQueryShardDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleQueryShardResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgArtifactsQueryFail(
            csgArtifactsCat(
                "merkle_query_index_decode ",
                decoded.error))
    var wire: csgMerkleQueryIndexWireHeader
    var headerSeen: bool
    var records: CsgCoreMerkleQueryIndexRecord[]
    for i in 0..<decoded.lines.len:
        let kind =
            field.CsgCoreJsonKind(decoded.lines[i])
        if !kind.found:
            return csgArtifactsQueryFail(
                "merkle_query_index_line_kind_missing")
        if kind.value == CsgMerkleQueryIndexKind:
            if headerSeen:
                return csgArtifactsQueryFail(
                    "merkle_query_index_header_duplicate")
            var headerError: str
            if !csgArtifactsDecodeQueryHeader(
                   decoded.lines[i],
                   wire,
                   headerError):
                return csgArtifactsQueryFail(
                    headerError)
            headerSeen = true
        elif kind.value ==
             CsgMerkleQueryIndexEntryKind:
            var record: CsgCoreMerkleQueryIndexRecord
            var recordError: str
            if !csgArtifactsDecodeQueryRecord(
                   decoded.lines[i],
                   record,
                   recordError):
                return csgArtifactsQueryFail(
                    recordError)
            add(records, record)
        else:
            return csgArtifactsQueryFail(
                "merkle_query_index_kind_invalid")
    if !headerSeen:
        return csgArtifactsQueryFail(
            "merkle_query_index_header_missing")
    var sortedRecords: CsgCoreMerkleQueryIndexRecord[]
    csgArtifactsSortQueryRecords(
        records, sortedRecords)
    var reencoded =
        CsgCoreMerkleQueryShardEncode(
            wire.header, sortedRecords)
    if !reencoded.ok:
        return reencoded
    if wire.entryCount != reencoded.entryCount ||
       wire.shardRoot != reencoded.shardRoot:
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsQueryFail(
            "merkle_query_index_header_mismatch")
    if !rawbytes.BytesEqual(
           bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsQueryFail(
            "merkle_query_index_non_canonical")
    return reencoded
