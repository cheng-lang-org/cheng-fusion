import std/rawbytes
import std/result
import std/json
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

const
    CsgCoreMerklePartitionFactsDomain: str = "csg_core.store.partition_facts"
    CsgCoreMerkleMembershipDomain: str = "csg_core.store.membership"
    CsgCoreMerkleDependencyDomain: str = "csg_core.store.dependency_shard"
    CsgCoreMerkleSummaryDomain: str = "csg_core.store.summary"
    CsgCoreMerkleQueryIndexDomain: str = "csg_core.store.query_shard"

    CsgMerklePartitionFactsKind: str = "csg.merkle.partition_facts"
    CsgMerkleMembershipHeaderKind: str = "csg.merkle.membership_header"
    CsgMerkleMembershipKind: str = "csg.merkle.membership"
    CsgMerkleDependencyHeaderKind: str = "csg.merkle.dependency_shard"
    CsgMerkleDependencyKind: str = "csg.merkle.dependency"
    CsgMerkleSummaryKind: str = "csg.merkle.summary"
    CsgMerkleQueryIndexKind: str = "csg.merkle.query_shard"
    CsgMerkleQueryIndexEntryKind: str = "csg.merkle.query_index_entry"
    csgCoreSchemaNamespace: str = "csg_core::v1"

type
    CsgCoreMerklePartitionFactsHeader =
        partitionId: str
        sourceId: str
        sourceCid: str
        factKind: str

    CsgCoreMerklePartitionFactsResult =
        ok: bool
        error: str
        cid: str
        bytes: rawbytes.Bytes
        lines: str[]
        header: CsgCoreMerklePartitionFactsHeader
        factsRoot: str
        dagRootCid: str
        factCount: int32
        facts: str[]

    CsgCoreMerkleMembershipHeader =
        partitionId: str
        sourceId: str
        sourceCid: str
        factKind: str
        factsCid: str
        factsRoot: str
        dagRootCid: str
        factCount: int32

    CsgCoreMerkleMembershipRecord =
        partitionId: str
        sourceId: str
        sourceCid: str
        factKey: str
        factHash: str
        leafCid: str

    CsgCoreMerkleMembershipResult =
        ok: bool
        error: str
        cid: str
        bytes: rawbytes.Bytes
        lines: str[]
        header: CsgCoreMerkleMembershipHeader
        membershipRoot: str
        recordCount: int32
        records: CsgCoreMerkleMembershipRecord[]

    CsgCoreMerkleDependencyShardHeader =
        profileSetCid: str
        projection: str
        shardKey: str

    CsgCoreMerkleDependencyRecord =
        consumerSource: str
        providerSource: str
        selector: str
        providerSubgraphCid: str

    CsgCoreMerkleDependencyShardResult =
        ok: bool
        error: str
        cid: str
        bytes: rawbytes.Bytes
        lines: str[]
        header: CsgCoreMerkleDependencyShardHeader
        shardRoot: str
        entryCount: int32
        records: CsgCoreMerkleDependencyRecord[]

    CsgCoreMerkleSummaryHeader =
        standard: str
        profiles: str[]
        profileSetCid: str
        complete: bool
        schemaCid: str
        factsRoot: str
        dagRootCid: str
        factCount: int32
        nodeCount: int32
        partitionRoot: str
        partitionCount: int32
        dependencyConsumerRoot: str
        dependencyProviderRoot: str
        dependencyCount: int32
        dependencyConsumerShardCount: int32
        dependencyProviderShardCount: int32
        queryShardRoot: str
        queryIndexCount: int32
        queryShardCount: int32
        unsupportedCount: int32
        tombstoneCount: int32
        runtimeRequirementCount: int32

    CsgCoreMerkleSummaryResult =
        ok: bool
        error: str
        cid: str
        bytes: rawbytes.Bytes
        lines: str[]
        header: CsgCoreMerkleSummaryHeader

    CsgCoreMerkleQueryShardHeader =
        profileSetCid: str
        bucket: str

    CsgCoreMerkleQueryIndexRecord =
        indexKind: str
        term: str
        factKey: str
        factHash: str
        leafCid: str
        partitionId: str
        sourceId: str
        sourceCid: str

    CsgCoreMerkleQueryShardResult =
        ok: bool
        error: str
        cid: str
        bytes: rawbytes.Bytes
        lines: str[]
        header: CsgCoreMerkleQueryShardHeader
        shardRoot: str
        entryCount: int32
        records: CsgCoreMerkleQueryIndexRecord[]

    csgMerklePartitionFactsWireHeader =
        header: CsgCoreMerklePartitionFactsHeader
        factsRoot: str
        dagRootCid: str
        factCount: int32

    csgMerkleMembershipWireHeader =
        header: CsgCoreMerkleMembershipHeader
        membershipRoot: str
        recordCount: int32

    csgMerkleDependencyWireHeader =
        header: CsgCoreMerkleDependencyShardHeader
        shardRoot: str
        entryCount: int32

    csgMerkleQueryIndexWireHeader =
        header: CsgCoreMerkleQueryShardHeader
        shardRoot: str
        entryCount: int32

@borrows
fn csgArtifactsCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgArtifactsCat3(
        a: str,
        b: str,
        c: str): str =
    return csgArtifactsCat(
        csgArtifactsCat(a, b), c)

@borrows
fn csgArtifactsAppend(
        out: var str,
        value: str) =
    out = csgArtifactsCat(out, value)

@borrows
fn csgArtifactsJson(text: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(
        text)

@borrows
fn csgArtifactsStringArray(values: str[]): str =
    var out = "["
    for i in 0..<values.len:
        if i > 0:
            csgArtifactsAppend(out, ",")
        csgArtifactsAppend(
            out, csgArtifactsJson(values[i]))
    csgArtifactsAppend(out, "]")
    return out

@borrows
fn csgArtifactsStringArrayField(
        line: str,
        name: str,
        out: var str[]): bool =
    let raw = field.CsgCoreJsonTopRawField(line, name)
    if !raw.found:
        return false
    let parsed = json.ParseJsonSafe(raw.value)
    if !parsed.success || parsed.value.kind != json.JArray:
        return false
    for i in 0..<parsed.value.a.len:
        if parsed.value.a[i].kind != json.JString:
            return false
        add(out, strings.CloneStr(parsed.value.a[i].s))
    return true

@borrows
fn csgArtifactsTuplePart(value: str): str =
    return csgArtifactsCat3(
        strings.IntToStr(value.len),
        ":",
        value)

@borrows
fn csgArtifactsTextCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgArtifactsStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(
            line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgArtifactsInt32(
        text: str,
        out: var int32): bool =
    return merkle_store_codec.CsgCoreMerkleStoreParseInt32(
        text, out)

@borrows
fn csgArtifactsParseCid(
        text: str,
        out: var layout.FixedBytes32): bool =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           text):
        return false
    let parsed =
        layout.FixedBytes32FromHex(
            strings.CloneStrRange(text, 7, 64))
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return true

@borrows
fn csgArtifactsSubgraphForDag(
        factCount: int32,
        dagRootCid: str,
        expectedSubgraphCid: str): bool =
    var error: str
    let subgraphCid =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            factCount,
            dagRootCid,
            error)
    return error.len == 0 &&
        subgraphCid == expectedSubgraphCid

@borrows
fn csgArtifactsBoundRootForDag(
        standard: str,
        profiles: str[],
        schemaCid: str,
        factCount: int32,
        dagRootCid: str,
        expectedFactsRoot: str): bool =
    var error: str
    let subgraphCid =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            factCount,
            dagRootCid,
            error)
    if error.len > 0:
        return false
    let factsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            standard,
            profiles,
            csgCoreSchemaNamespace,
            schemaCid,
            subgraphCid,
            error)
    return error.len == 0 &&
        factsRoot == expectedFactsRoot

@borrows
fn csgArtifactsLeafBindingError(
        factKey: str,
        factHash: str,
        leafCid: str): str =
    if factKey.len == 0:
        return "merkle_artifact_fact_key_empty"
    var factHashBytes: layout.FixedBytes32
    var leafCidBytes: layout.FixedBytes32
    if !csgArtifactsParseCid(
           factHash, factHashBytes) ||
       !csgArtifactsParseCid(
           leafCid, leafCidBytes):
        return "merkle_artifact_leaf_cid_invalid"
    var node: merkle_dag.CsgCoreMerkleNodeRecord
    node.kind =
        merkle_dag.CsgCoreMerkleLeafNodeKind()
    node.count = 1
    node.splitBit = -1
    node.hash = leafCidBytes
    node.key = strings.CloneStr(factKey)
    node.keyHash =
        merkle_dag.CsgCoreMerkleKeyHash(factKey)
    node.factHash = factHashBytes
    let nodeError =
        merkle_dag.CsgCoreMerkleNodeRecordError(
            node)
    if nodeError.len > 0:
        return csgArtifactsCat(
            "merkle_artifact_leaf_binding ",
            nodeError)
    return ""

@borrows
fn csgArtifactsPartitionId(
        sourceId: str,
        factKind: str): str =
    var partition: merkle_manifest.CsgCoreMerklePartitionRecord
    partition.sourceId = strings.CloneStr(sourceId)
    partition.factKind = strings.CloneStr(factKind)
    return merkle_manifest.CsgCoreMerklePartitionId(
        partition)

@borrows
fn csgArtifactsReservedKind(kind: str): bool =
    return kind == CsgMerklePartitionFactsKind ||
        kind == CsgMerkleMembershipHeaderKind ||
        kind == CsgMerkleMembershipKind ||
        kind == CsgMerkleDependencyHeaderKind ||
        kind == CsgMerkleDependencyKind ||
        kind == CsgMerkleSummaryKind ||
        kind == CsgMerkleQueryIndexKind ||
        kind == CsgMerkleQueryIndexEntryKind

@borrows
fn csgArtifactsClonePartitionHeader(
        header: CsgCoreMerklePartitionFactsHeader):
        CsgCoreMerklePartitionFactsHeader =
    var out: CsgCoreMerklePartitionFactsHeader
    out.partitionId =
        strings.CloneStr(header.partitionId)
    out.sourceId = strings.CloneStr(header.sourceId)
    out.sourceCid =
        strings.CloneStr(header.sourceCid)
    out.factKind = strings.CloneStr(header.factKind)
    return out

@borrows
fn csgArtifactsPartitionHeaderError(
        header: CsgCoreMerklePartitionFactsHeader):
        str =
    if header.sourceId.len == 0 ||
       header.factKind.len == 0:
        return "merkle_partition_facts_identity_empty"
    if csgArtifactsReservedKind(header.factKind):
        return "merkle_partition_facts_kind_reserved"
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           header.sourceCid):
        return "merkle_partition_facts_source_cid_invalid"
    if header.partitionId !=
       csgArtifactsPartitionId(
           header.sourceId, header.factKind):
        return "merkle_partition_facts_partition_id_mismatch"
    return ""

@borrows
fn csgArtifactsPartitionHeaderId(
        partitionId: str): str =
    return csgArtifactsCat(
        "partition-facts-header:", partitionId)

@borrows
fn csgArtifactsPartitionHeaderLine(
        wire: csgMerklePartitionFactsWireHeader):
        str =
    var out: str = "{\"dag_root_cid\":"
    csgArtifactsAppend(
        out, csgArtifactsJson(wire.dagRootCid))
    csgArtifactsAppend(out, ",\"fact_count\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            strings.IntToStr(wire.factCount)))
    csgArtifactsAppend(out, ",\"fact_kind\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.header.factKind))
    csgArtifactsAppend(out, ",\"facts_root\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(wire.factsRoot))
    csgArtifactsAppend(out, ",\"id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            csgArtifactsPartitionHeaderId(
                wire.header.partitionId)))
    csgArtifactsAppend(
        out,
        ",\"kind\":\"csg.merkle.partition_facts\"")
    csgArtifactsAppend(out, ",\"partition_id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            wire.header.partitionId))
    csgArtifactsAppend(out, ",\"source_cid\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.header.sourceCid))
    csgArtifactsAppend(out, ",\"source_id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(wire.header.sourceId))
    csgArtifactsAppend(out, "}")
    return out

@borrows
fn csgArtifactsFactKey(
        fact: str,
        error: var str): str =
    return merkle_dag.CsgCoreMerkleFactKey(
        fact, error)

@borrows
fn csgArtifactsFactsOrderError(
        facts: str[],
        factKind: str): str =
    var previousKey: str
    for i in 0..<facts.len:
        var canonicalError: str
        let canonicalFact =
            merkle_dag.CsgCoreMerkleCanonicalFact(
                facts[i], canonicalError)
        if canonicalError.len > 0 ||
           canonicalFact != facts[i]:
            return "merkle_partition_facts_non_canonical_fact"
        let kind = field.CsgCoreJsonKind(facts[i])
        if !kind.found || kind.value != factKind:
            return "merkle_partition_facts_kind_mismatch"
        var keyError: str
        let key =
            csgArtifactsFactKey(facts[i], keyError)
        if keyError.len > 0:
            return csgArtifactsCat(
                "merkle_partition_facts_key ",
                keyError)
        if i > 0:
            let order =
                csgArtifactsTextCompare(
                    previousKey, key)
            if order == 0:
                return "merkle_partition_facts_duplicate"
            if order > 0:
                return "merkle_partition_facts_non_canonical_order"
        previousKey = strings.CloneStr(key)
    return ""

@borrows
fn csgArtifactsSortFacts(
        facts: str[],
        out: var str[]): bool =
    out = []
    var order: int32[]
    var scratch: int32[]
    var keys: str[]
    for i in 0..<facts.len:
        var keyError: str
        let key =
            csgArtifactsFactKey(facts[i], keyError)
        if keyError.len > 0:
            return false
        add(keys, strings.CloneStr(key))
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgArtifactsTextCompare(
                        keys[order[left]],
                        keys[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    for i in 0..<order.len:
        add(
            out,
            strings.CloneStr(facts[order[i]]))
    return true

@borrows
fn csgArtifactsPartitionFail(
        error: str):
        CsgCoreMerklePartitionFactsResult =
    var out: CsgCoreMerklePartitionFactsResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerklePartitionFactsEncode(
        header: CsgCoreMerklePartitionFactsHeader,
        facts: str[]):
        CsgCoreMerklePartitionFactsResult =
    let headerError =
        csgArtifactsPartitionHeaderError(header)
    if headerError.len > 0:
        return csgArtifactsPartitionFail(
            headerError)
    if facts.len <= 0:
        return csgArtifactsPartitionFail(
            "merkle_partition_facts_empty")
    let orderError =
        csgArtifactsFactsOrderError(
            facts, header.factKind)
    if orderError.len > 0:
        return csgArtifactsPartitionFail(
            orderError)
    let dag =
        merkle_dag.CsgCoreMerkleBuild(facts)
    if !dag.ok:
        return csgArtifactsPartitionFail(
            csgArtifactsCat(
                "merkle_partition_facts_dag ",
                dag.error))
    let dagRootCid =
        merkle_dag.CsgCoreMerkleDagRootCid(dag)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           dagRootCid):
        return csgArtifactsPartitionFail(
            "merkle_partition_facts_dag_root_invalid")
    var wire: csgMerklePartitionFactsWireHeader
    wire.header =
        csgArtifactsClonePartitionHeader(header)
    wire.factsRoot =
        strings.CloneStr(dag.subgraphCid)
    wire.dagRootCid = strings.CloneStr(dagRootCid)
    wire.factCount = facts.len
    var lines: str[]
    add(
        lines,
        csgArtifactsPartitionHeaderLine(wire))
    for i in 0..<facts.len:
        add(lines, strings.CloneStr(facts[i]))
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgArtifactsPartitionFail(
            csgArtifactsCat(
                "merkle_partition_facts_encode ",
                encoded.error))
    var out: CsgCoreMerklePartitionFactsResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreMerklePartitionFactsDomain,
            encoded.bytes)
    out.bytes = encoded.bytes
    out.lines = lines
    out.header =
        csgArtifactsClonePartitionHeader(header)
    out.factsRoot =
        strings.CloneStr(dag.subgraphCid)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.factCount = facts.len
    for i in 0..<facts.len:
        add(out.facts, strings.CloneStr(facts[i]))
    return out

@borrows
fn csgArtifactsDecodePartitionHeader(
        line: str,
        out: var csgMerklePartitionFactsWireHeader,
        error: var str): bool =
    var countText: str
    var idText: str
    if !csgArtifactsStringField(
           line, "dag_root_cid",
           out.dagRootCid) ||
       !csgArtifactsStringField(
           line, "fact_count", countText) ||
       !csgArtifactsStringField(
           line, "fact_kind",
           out.header.factKind) ||
       !csgArtifactsStringField(
           line, "facts_root",
           out.factsRoot) ||
       !csgArtifactsStringField(
           line, "id", idText) ||
       !csgArtifactsStringField(
           line, "partition_id",
           out.header.partitionId) ||
       !csgArtifactsStringField(
           line, "source_cid",
           out.header.sourceCid) ||
       !csgArtifactsStringField(
           line, "source_id",
           out.header.sourceId) ||
       !csgArtifactsInt32(
           countText, out.factCount):
        error =
            "merkle_partition_facts_header_field_invalid"
        return false
    if idText !=
       csgArtifactsPartitionHeaderId(
           out.header.partitionId) ||
       csgArtifactsPartitionHeaderLine(out) != line:
        error =
            "merkle_partition_facts_header_non_canonical"
        return false
    return true

@borrows
fn CsgCoreMerklePartitionFactsDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerklePartitionFactsResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgArtifactsPartitionFail(
            csgArtifactsCat(
                "merkle_partition_facts_decode ",
                decoded.error))
    var wire: csgMerklePartitionFactsWireHeader
    var headerSeen: bool
    var facts: str[]
    for i in 0..<decoded.lines.len:
        let kind =
            field.CsgCoreJsonKind(decoded.lines[i])
        if !kind.found:
            return csgArtifactsPartitionFail(
                "merkle_partition_facts_line_kind_missing")
        if kind.value == CsgMerklePartitionFactsKind:
            if headerSeen:
                return csgArtifactsPartitionFail(
                    "merkle_partition_facts_header_duplicate")
            var headerError: str
            if !csgArtifactsDecodePartitionHeader(
                   decoded.lines[i],
                   wire,
                   headerError):
                return csgArtifactsPartitionFail(
                    headerError)
            headerSeen = true
        else:
            add(
                facts,
                strings.CloneStr(decoded.lines[i]))
    if !headerSeen:
        return csgArtifactsPartitionFail(
            "merkle_partition_facts_header_missing")
    var sortedFacts: str[]
    if !csgArtifactsSortFacts(
           facts, sortedFacts):
        return csgArtifactsPartitionFail(
            "merkle_partition_facts_sort_failed")
    var reencoded =
        CsgCoreMerklePartitionFactsEncode(
            wire.header, sortedFacts)
    if !reencoded.ok:
        return reencoded
    if wire.factCount != reencoded.factCount ||
       wire.factsRoot != reencoded.factsRoot ||
       wire.dagRootCid != reencoded.dagRootCid:
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsPartitionFail(
            "merkle_partition_facts_header_mismatch")
    if !rawbytes.BytesEqual(
           bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgArtifactsPartitionFail(
            "merkle_partition_facts_non_canonical")
    return reencoded

@borrows
fn csgArtifactsCloneMembershipHeader(
        header: CsgCoreMerkleMembershipHeader):
        CsgCoreMerkleMembershipHeader =
    var out: CsgCoreMerkleMembershipHeader
    out.partitionId =
        strings.CloneStr(header.partitionId)
    out.sourceId = strings.CloneStr(header.sourceId)
    out.sourceCid =
        strings.CloneStr(header.sourceCid)
    out.factKind = strings.CloneStr(header.factKind)
    out.factsCid = strings.CloneStr(header.factsCid)
    out.factsRoot =
        strings.CloneStr(header.factsRoot)
    out.dagRootCid =
        strings.CloneStr(header.dagRootCid)
    out.factCount = header.factCount
    return out

@borrows
fn csgArtifactsCloneMembershipRecord(
        record: CsgCoreMerkleMembershipRecord):
        CsgCoreMerkleMembershipRecord =
    var out: CsgCoreMerkleMembershipRecord
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid =
        strings.CloneStr(record.sourceCid)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    return out

@borrows
fn csgArtifactsMembershipHeaderId(
        partitionId: str): str =
    return csgArtifactsCat(
        "membership-header:", partitionId)

@borrows
fn csgArtifactsMembershipRecordId(
        record: CsgCoreMerkleMembershipRecord):
        str =
    let pair =
        csgArtifactsCat(
            csgArtifactsTuplePart(
                record.partitionId),
            csgArtifactsTuplePart(
                record.factKey))
    let digest =
        merkle_dag.CsgCoreMerkleKeyHash(
            csgArtifactsCat(
                "membership:", pair))
    return csgArtifactsCat(
        "membership:",
        layout.FixedBytes32Hex(digest))

@borrows
fn csgArtifactsMembershipRecordCompare(
        leftFactKey: str,
        rightFactKey: str):
        int32 =
    return csgArtifactsTextCompare(
        leftFactKey, rightFactKey)

@borrows
fn csgArtifactsSortMembershipRecords(
        records: var CsgCoreMerkleMembershipRecord[],
        out: var CsgCoreMerkleMembershipRecord[]) =
    out = []
    var order: int32[]
    var scratch: int32[]
    for i in 0..<records.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgArtifactsMembershipRecordCompare(
                        records[order[left]].factKey,
                        records[
                            order[right]].factKey) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    for i in 0..<order.len:
        add(
            out,
            csgArtifactsCloneMembershipRecord(
                records[order[i]]))

@borrows
fn csgArtifactsMembershipRecordLine(
        record: CsgCoreMerkleMembershipRecord):
        str =
    var out: str = "{\"fact_hash\":"
    csgArtifactsAppend(
        out, csgArtifactsJson(record.factHash))
    csgArtifactsAppend(out, ",\"fact_key\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.factKey))
    csgArtifactsAppend(out, ",\"id\":")
    csgArtifactsAppend(
        out,
        csgArtifactsJson(
            csgArtifactsMembershipRecordId(
                record)))
    csgArtifactsAppend(
        out,
        ",\"kind\":\"csg.merkle.membership\"")
    csgArtifactsAppend(out, ",\"leaf_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.leafCid))
    csgArtifactsAppend(out, ",\"partition_id\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.partitionId))
    csgArtifactsAppend(out, ",\"source_cid\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.sourceCid))
    csgArtifactsAppend(out, ",\"source_id\":")
    csgArtifactsAppend(
        out, csgArtifactsJson(record.sourceId))
    csgArtifactsAppend(out, "}")
    return out

