import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec

@borrows
fn csgClosureCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgClosureHash64(
        value: layout.FixedBytes32): uint64 =
    var out: uint64
    for i in 0..<8:
        out = out |
            (uint64(value.data[i]) <<
             uint64(i * 8))
    return out

@borrows
fn CsgCoreMerkleNodeClosureError(
        dag: merkle_dag.CsgCoreMerkleDag,
        nodes: merkle_dag.CsgCoreMerkleNodeRecord[]):
        str =
    if !dag.ok:
        return csgClosureCat(
            "merkle_closure_dag_invalid ",
            dag.error)
    if nodes.len != dag.nodeKinds.len:
        return "merkle_closure_node_count_mismatch"

    let targetCapacity =
        int64(nodes.len) * int64(2)
    var capacity: int32 = 8
    while int64(capacity) < targetCapacity:
        if capacity > 1073741823:
            return "merkle_closure_node_index_capacity_overflow"
        capacity = capacity * 2
    var nodeIndex: int32[]
    setLen(nodeIndex, capacity)
    for i in 0..<nodes.len:
        let nodeError =
            merkle_dag.CsgCoreMerkleNodeRecordError(
                nodes[i])
        if nodeError.len > 0:
            return csgClosureCat(
                "merkle_closure_node_invalid ",
                nodeError)
        var bucket =
            int32(
                csgClosureHash64(nodes[i].hash) &
                uint64(capacity - 1))
        var inserted: bool
        for probe in 0..<capacity:
            let previousPlusOne =
                nodeIndex[bucket]
            if previousPlusOne == 0:
                nodeIndex[bucket] = i + 1
                inserted = true
                break
            let previousIndex =
                previousPlusOne - 1
            if previousIndex < 0 ||
               previousIndex >= i:
                return "merkle_closure_node_index_corrupt"
            if layout.FixedBytes32Equal(
                   nodes[previousIndex].hash,
                   nodes[i].hash):
                return "merkle_closure_node_duplicate"
            bucket = (bucket + 1) &
                (capacity - 1)
        if !inserted:
            return "merkle_closure_node_index_full"

    for expectedIndex in 0..<dag.nodeKinds.len:
        var projectionError: str
        let expected =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, expectedIndex, projectionError)
        if projectionError.len > 0:
            return csgClosureCat(
                "merkle_closure_projection_failed ",
                projectionError)
        var bucket =
            int32(
                csgClosureHash64(expected.hash) &
                uint64(capacity - 1))
        var foundIndex: int32 = -1
        for probe in 0..<capacity:
            let actualPlusOne =
                nodeIndex[bucket]
            if actualPlusOne == 0:
                break
            let actualIndex = actualPlusOne - 1
            if actualIndex < 0 ||
               actualIndex >= nodes.len:
                return "merkle_closure_node_index_corrupt"
            if layout.FixedBytes32Equal(
                   nodes[actualIndex].hash,
                   expected.hash):
                foundIndex = actualIndex
                break
            bucket = (bucket + 1) &
                (capacity - 1)
        if foundIndex < 0:
            return "merkle_closure_node_missing"
        if merkle_store_codec.CsgCoreMerkleNodeRecordLine(
               nodes[foundIndex]) !=
           merkle_store_codec.CsgCoreMerkleNodeRecordLine(
               expected):
            return "merkle_closure_node_payload_mismatch"
    return ""
