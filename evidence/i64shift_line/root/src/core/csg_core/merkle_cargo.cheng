import std/rawbytes
import std/result
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec

const
    CsgMerkleProofDomain: str = "csg_core.store.proof"
    CsgMerkleProofKind: str = "csg.merkle.proof"
    CsgMerkleProofProfileKind: str = "csg.merkle.proof_profile"
    CsgMerkleProofStepKind: str = "csg.merkle.proof_step"

type
    CsgCoreMerkleProofCargoResult =
        ok: bool
        error: str
        cid: str
        proof: merkle_dag.CsgCoreMerkleProof
        lines: str[]
        bytes: rawbytes.Bytes

@borrows
fn csgMerkleCargoCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgMerkleCargoAppend(out: var str, part: str) =
    out = csgMerkleCargoCat(out, part)

@borrows
fn csgMerkleCargoJsonString(text: str): str =
    return canonical.CsgCoreJsonQuote(text)

fn csgMerkleCargoBool(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn csgMerkleCargoHeader(
        proof: merkle_dag.CsgCoreMerkleProof): str =
    var terminalFactHash: str
    if proof.terminalPresent:
        terminalFactHash =
            layout.FixedBytes32Hex(proof.terminalFactHash)
    var out: str = "{\"dag_root_cid\":"
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.dagRootCid))
    csgMerkleCargoAppend(out, ",\"exists\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            csgMerkleCargoBool(proof.exists)))
    csgMerkleCargoAppend(out, ",\"fact_count\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(proof.factCount)))
    csgMerkleCargoAppend(out, ",\"facts_root\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.factsRoot))
    csgMerkleCargoAppend(
        out, ",\"kind\":\"csg.merkle.proof\"")
    csgMerkleCargoAppend(out, ",\"path_count\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(proof.splitBits.len)))
    csgMerkleCargoAppend(out, ",\"profile_count\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(proof.profiles.len)))
    csgMerkleCargoAppend(out, ",\"query_key\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(proof.queryKey))
    csgMerkleCargoAppend(out, ",\"schema_cid\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.schemaCid))
    csgMerkleCargoAppend(
        out, ",\"schema_namespace\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.schemaNamespace))
    csgMerkleCargoAppend(out, ",\"standard\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.standard))
    csgMerkleCargoAppend(out, ",\"subgraph_cid\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.subgraphCid))
    csgMerkleCargoAppend(out, ",\"terminal_fact_hash\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(terminalFactHash))
    csgMerkleCargoAppend(out, ",\"terminal_key\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(proof.terminalKey))
    csgMerkleCargoAppend(out, ",\"terminal_present\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            csgMerkleCargoBool(proof.terminalPresent)))
    csgMerkleCargoAppend(out, "}")
    return out

@borrows
fn csgMerkleCargoProfile(
        proof: merkle_dag.CsgCoreMerkleProof,
        index: int32): str =
    var out: str = "{\"id\":"
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            csgMerkleCargoCat(
                "profile:", strings.IntToStr(index))))
    csgMerkleCargoAppend(
        out, ",\"kind\":\"csg.merkle.proof_profile\"")
    csgMerkleCargoAppend(out, ",\"ordinal\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(index)))
    csgMerkleCargoAppend(out, ",\"profile\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            proof.profiles[index]))
    csgMerkleCargoAppend(out, "}")
    return out

@borrows
fn csgMerkleCargoStep(
        proof: merkle_dag.CsgCoreMerkleProof,
        index: int32): str =
    var out: str = "{\"direction\":"
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(proof.directions[index])))
    csgMerkleCargoAppend(out, ",\"id\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            csgMerkleCargoCat(
                "step:", strings.IntToStr(index))))
    csgMerkleCargoAppend(
        out, ",\"kind\":\"csg.merkle.proof_step\"")
    csgMerkleCargoAppend(out, ",\"ordinal\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(index)))
    csgMerkleCargoAppend(out, ",\"sibling_count\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(proof.siblingCounts[index])))
    csgMerkleCargoAppend(out, ",\"sibling_hash\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            layout.FixedBytes32Hex(
                proof.siblingHashes[index])))
    csgMerkleCargoAppend(out, ",\"split_bit\":")
    csgMerkleCargoAppend(
        out, csgMerkleCargoJsonString(
            strings.IntToStr(proof.splitBits[index])))
    csgMerkleCargoAppend(out, "}")
    return out

fn csgMerkleCargoFail(
        error: str): CsgCoreMerkleProofCargoResult =
    var out: CsgCoreMerkleProofCargoResult
    out.error = error
    return out

@borrows
fn CsgCoreMerkleProofEncodeCsgc(
        proof: merkle_dag.CsgCoreMerkleProof,
        trustedExpectedFactsRoot: str):
        CsgCoreMerkleProofCargoResult =
    let trusted =
        merkle_dag.CsgCoreMerkleVerifyProof(
            proof, trustedExpectedFactsRoot)
    if !trusted.ok:
        return csgMerkleCargoFail(
            csgMerkleCargoCat(
                "merkle_proof_encode_trusted_verification ",
                trusted.error))
    var lines: str[]
    add(lines, csgMerkleCargoHeader(proof))
    for i in 0..<proof.profiles.len:
        add(lines, csgMerkleCargoProfile(proof, i))
    for i in 0..<proof.splitBits.len:
        add(lines, csgMerkleCargoStep(proof, i))
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgMerkleCargoFail(
            csgMerkleCargoCat(
                "merkle_proof_encode_csgc ",
                encoded.error))
    let canonical =
        csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !canonical.ok:
        rawbytes.BytesFree(encoded.bytes)
        return csgMerkleCargoFail(
            "merkle_proof_encode_canonical_readback")
    var out: CsgCoreMerkleProofCargoResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleProofDomain,
            encoded.bytes)
    out.lines = canonical.lines
    out.bytes = encoded.bytes
    return out

@borrows
fn csgMerkleCargoUnquoteHexDigit(
        ch: char,
        out: var int32): bool =
    if ch >= '0' && ch <= '9':
        out = int32(ch) - int32('0')
        return true
    if ch >= 'a' && ch <= 'f':
        out = int32(ch) - int32('a') + 10
        return true
    return false

@borrows
fn csgMerkleCargoUnquote(raw: str, out: var str): bool =
    if raw.len < 2 || raw[0] != '"' ||
       raw[raw.len - 1] != '"':
        return false
    var buf = layout.ByteBufInit(raw.len)
    let last = raw.len - 1
    var i: int32 = 1
    var ok = true
    while ok && i < last:
        let ch = raw[i]
        let value = int32(ch) & 255
        if ch == '"':
            ok = false
        elif ch == '\\':
            if i + 1 >= last:
                ok = false
            else:
                let esc = raw[i + 1]
                var decoded: int32 = -1
                var advance: int32 = 2
                if esc == '"' || esc == '\\' || esc == '/':
                    decoded = int32(esc) & 255
                elif esc == 'b':
                    decoded = 8
                elif esc == 't':
                    decoded = 9
                elif esc == 'n':
                    decoded = 10
                elif esc == 'f':
                    decoded = 12
                elif esc == 'r':
                    decoded = 13
                elif esc == 'u':
                    if i + 6 <= last &&
                       raw[i + 2] == '0' &&
                       raw[i + 3] == '0':
                        var hi: int32
                        var lo: int32
                        if csgMerkleCargoUnquoteHexDigit(
                               raw[i + 4], hi) &&
                           csgMerkleCargoUnquoteHexDigit(
                               raw[i + 5], lo):
                            let code = hi * 16 + lo
                            if code < 32 && code != 8 &&
                               code != 9 && code != 10 &&
                               code != 12 && code != 13:
                                decoded = code
                                advance = 6
                if decoded < 0:
                    ok = false
                else:
                    layout.ByteBufAppendByte(buf, decoded)
                    i = i + advance
        elif value < 32:
            ok = false
        else:
            layout.ByteBufAppendByte(buf, value)
            i = i + 1
    if !ok:
        layout.ByteBufFree(buf)
        return false
    var bytes = layout.ByteBufToBytes(buf)
    out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return true

@borrows
fn csgMerkleCargoString(
        line: str,
        name: str,
        out: var str): bool =
    let raw =
        field.CsgCoreJsonTopRawField(line, name)
    if !raw.found:
        return false
    return csgMerkleCargoUnquote(raw.value, out)

@borrows
fn csgMerkleCargoInt(
        line: str,
        name: str,
        out: var int32): bool =
    var text: str
    if !csgMerkleCargoString(line, name, text) ||
       text.len == 0:
        return false
    var value: int32
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        let digit = int32(ch) - int32('0')
        if value > (2147483647 - digit) / 10:
            return false
        value = value * 10 + digit
    out = value
    return true

@borrows
fn csgMerkleCargoBoolParse(
        line: str,
        name: str,
        out: var bool): bool =
    var text: str
    if !csgMerkleCargoString(line, name, text):
        return false
    if text == "0":
        out = false
        return true
    if text == "1":
        out = true
        return true
    return false

@borrows
fn csgMerkleCargoHash(
        line: str,
        name: str,
        out: var layout.FixedBytes32): bool =
    var text: str
    if !csgMerkleCargoString(line, name, text):
        return false
    let parsed = layout.FixedBytes32FromHex(text)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    let stableHash = layout.FixedBytes32Copy(out)
    return layout.FixedBytes32Hex(stableHash) == text

@borrows
fn csgMerkleCargoParseHeader(
        line: str,
        proof: var merkle_dag.CsgCoreMerkleProof,
        pathCount: var int32,
        profileCount: var int32): bool =
    var kind: str
    var terminalHashText: str
    if !csgMerkleCargoString(
           line, "dag_root_cid",
           proof.dagRootCid) ||
       !csgMerkleCargoString(line, "kind", kind) ||
       kind != CsgMerkleProofKind ||
       !csgMerkleCargoBoolParse(
           line, "exists", proof.exists) ||
       !csgMerkleCargoInt(
           line, "fact_count", proof.factCount) ||
       !csgMerkleCargoInt(
           line, "path_count", pathCount) ||
       !csgMerkleCargoInt(
           line, "profile_count", profileCount) ||
       !csgMerkleCargoString(
           line, "query_key", proof.queryKey) ||
       !csgMerkleCargoString(
           line, "facts_root", proof.factsRoot) ||
       !csgMerkleCargoString(
           line, "schema_cid", proof.schemaCid) ||
       !csgMerkleCargoString(
           line, "schema_namespace",
           proof.schemaNamespace) ||
       !csgMerkleCargoString(
           line, "standard", proof.standard) ||
       !csgMerkleCargoString(
           line, "subgraph_cid",
           proof.subgraphCid) ||
       !csgMerkleCargoString(
           line, "terminal_fact_hash",
           terminalHashText) ||
       !csgMerkleCargoString(
           line, "terminal_key",
           proof.terminalKey) ||
       !csgMerkleCargoBoolParse(
           line, "terminal_present",
           proof.terminalPresent):
        return false
    if proof.terminalPresent:
        if terminalHashText.len != 64 ||
           !csgMerkleCargoHash(
               line,
               "terminal_fact_hash",
               proof.terminalFactHash):
            return false
    elif terminalHashText.len != 0 ||
         proof.terminalKey.len != 0:
        return false
    return true

@borrows
fn csgMerkleCargoParseProfile(
        line: str,
        index: int32,
        proof: var merkle_dag.CsgCoreMerkleProof): bool =
    var kind: str
    var id: str
    var ordinal: int32
    var profile: str
    if !csgMerkleCargoString(line, "kind", kind) ||
       kind != CsgMerkleProofProfileKind ||
       !csgMerkleCargoString(line, "id", id) ||
       id != csgMerkleCargoCat(
           "profile:", strings.IntToStr(index)) ||
       !csgMerkleCargoInt(
           line, "ordinal", ordinal) ||
       ordinal != index ||
       !csgMerkleCargoString(
           line, "profile", profile):
        return false
    add(proof.profiles, profile)
    return true

@borrows
fn csgMerkleCargoParseStep(
        line: str,
        index: int32,
        proof: var merkle_dag.CsgCoreMerkleProof): bool =
    var kind: str
    var id: str
    var ordinal: int32
    var direction: int32
    var siblingCount: int32
    var siblingHash: layout.FixedBytes32
    var splitBit: int32
    if !csgMerkleCargoString(line, "kind", kind) ||
       kind != CsgMerkleProofStepKind ||
       !csgMerkleCargoString(line, "id", id) ||
       id != csgMerkleCargoCat(
           "step:", strings.IntToStr(index)) ||
       !csgMerkleCargoInt(
           line, "ordinal", ordinal) ||
       ordinal != index ||
       !csgMerkleCargoInt(
           line, "direction", direction) ||
       !csgMerkleCargoInt(
           line, "sibling_count", siblingCount) ||
       !csgMerkleCargoHash(
           line, "sibling_hash", siblingHash) ||
       !csgMerkleCargoInt(
           line, "split_bit", splitBit):
        return false
    add(proof.directions, direction)
    add(proof.siblingCounts, siblingCount)
    add(proof.siblingHashes, siblingHash)
    add(proof.splitBits, splitBit)
    return true

@borrows
fn CsgCoreMerkleProofDecodeCsgc(
        bytes: rawbytes.Bytes,
        trustedExpectedFactsRoot: str):
        CsgCoreMerkleProofCargoResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgMerkleCargoFail(
            csgMerkleCargoCat(
                "merkle_proof_decode_csgc ",
                decoded.error))
    if decoded.lines.len == 0:
        return csgMerkleCargoFail(
            "merkle_proof_cargo_empty")
    var proof: merkle_dag.CsgCoreMerkleProof
    var pathCount: int32
    var profileCount: int32
    var headerIndex: int32 = -1
    var stepCount: int32
    var profileLineCount: int32
    for i in 0..<decoded.lines.len:
        var kind: str
        if !csgMerkleCargoString(
               decoded.lines[i], "kind", kind):
            return csgMerkleCargoFail(
                "merkle_proof_line_kind_missing")
        if kind == CsgMerkleProofKind:
            if headerIndex >= 0:
                return csgMerkleCargoFail(
                    "merkle_proof_header_duplicate")
            headerIndex = i
        elif kind == CsgMerkleProofProfileKind:
            profileLineCount = profileLineCount + 1
        elif kind == CsgMerkleProofStepKind:
            stepCount = stepCount + 1
        else:
            return csgMerkleCargoFail(
                "merkle_proof_line_kind_invalid")
    if headerIndex < 0 ||
       !csgMerkleCargoParseHeader(
           decoded.lines[headerIndex],
           proof,
           pathCount,
           profileCount):
        return csgMerkleCargoFail(
            "merkle_proof_header_invalid")
    if pathCount != stepCount ||
       profileCount != profileLineCount ||
       decoded.lines.len !=
           stepCount + profileLineCount + 1:
        return csgMerkleCargoFail(
            "merkle_proof_cargo_count_mismatch")
    for i in 0..<profileCount:
        var profileIndex: int32 = -1
        for j in 0..<decoded.lines.len:
            var kind: str
            var ordinal: int32
            if csgMerkleCargoString(
                   decoded.lines[j], "kind", kind) &&
               kind == CsgMerkleProofProfileKind &&
               csgMerkleCargoInt(
                   decoded.lines[j], "ordinal", ordinal) &&
               ordinal == i:
                if profileIndex >= 0:
                    return csgMerkleCargoFail(
                        csgMerkleCargoCat(
                            "merkle_proof_profile_duplicate ",
                            strings.IntToStr(i)))
                profileIndex = j
        if profileIndex < 0 ||
           !csgMerkleCargoParseProfile(
               decoded.lines[profileIndex], i, proof):
            return csgMerkleCargoFail(
                csgMerkleCargoCat(
                    "merkle_proof_profile_invalid ",
                    strings.IntToStr(i)))
    for i in 0..<pathCount:
        var stepIndex: int32 = -1
        for j in 0..<decoded.lines.len:
            var kind: str
            var ordinal: int32
            if csgMerkleCargoString(
                   decoded.lines[j], "kind", kind) &&
               kind == CsgMerkleProofStepKind &&
               csgMerkleCargoInt(
                   decoded.lines[j], "ordinal", ordinal) &&
               ordinal == i:
                if stepIndex >= 0:
                    return csgMerkleCargoFail(
                        csgMerkleCargoCat(
                            "merkle_proof_step_duplicate ",
                            strings.IntToStr(i)))
                stepIndex = j
        if stepIndex < 0 ||
           !csgMerkleCargoParseStep(
               decoded.lines[stepIndex], i, proof):
            return csgMerkleCargoFail(
                csgMerkleCargoCat(
                    "merkle_proof_step_invalid ",
                    strings.IntToStr(i)))
    proof.ok = true
    let trusted =
        merkle_dag.CsgCoreMerkleVerifyProof(
            proof, trustedExpectedFactsRoot)
    if !trusted.ok:
        return csgMerkleCargoFail(
            csgMerkleCargoCat(
                "merkle_proof_decode_trusted_verification ",
                trusted.error))
    var canonicalCargo =
        CsgCoreMerkleProofEncodeCsgc(
            proof, trustedExpectedFactsRoot)
    if !canonicalCargo.ok:
        return csgMerkleCargoFail(
            csgMerkleCargoCat(
                "merkle_proof_reencode_failed ",
                canonicalCargo.error))
    let canonical =
        rawbytes.BytesEqual(bytes, canonicalCargo.bytes)
    rawbytes.BytesFree(canonicalCargo.bytes)
    if !canonical:
        return csgMerkleCargoFail(
            "merkle_proof_cargo_noncanonical")
    var out: CsgCoreMerkleProofCargoResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleProofDomain,
            bytes)
    out.proof = proof
    out.lines = decoded.lines
    return out

@borrows
fn CsgCoreMerkleProofDecodeSelfCsgc(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleProofCargoResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgMerkleCargoFail(
            csgMerkleCargoCat(
                "merkle_proof_self_decode_csgc ",
                decoded.error))
    var factsRoot: str
    var headerCount: int32
    for i in 0..<decoded.lines.len:
        var kind: str
        if !csgMerkleCargoString(
               decoded.lines[i], "kind", kind):
            return csgMerkleCargoFail(
                "merkle_proof_self_line_kind_missing")
        if kind == CsgMerkleProofKind:
            headerCount = headerCount + 1
            if !csgMerkleCargoString(
                   decoded.lines[i],
                   "facts_root",
                   factsRoot):
                return csgMerkleCargoFail(
                    "merkle_proof_self_facts_root_missing")
    if headerCount != 1 ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           factsRoot):
        return csgMerkleCargoFail(
            "merkle_proof_self_header_invalid")
    return CsgCoreMerkleProofDecodeCsgc(
        bytes, factsRoot)
