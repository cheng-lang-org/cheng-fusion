var
    csgStoreIdentityAuthorityRegistryState: int32
    csgStoreIdentityAuthorityRegistry:
        csgStoreIdentityAuthorityRegistryStorage
    csgStoreBeforeSnapshotRegistryState: int32
    csgStoreBeforeSnapshotRegistry:
        csgStoreBeforeSnapshotRegistryStorage
    csgStoreMappedCsgcRegistryState: int32
    csgStoreMappedCsgcRegistry:
        csgStoreMappedCsgcRegistryStorage
    csgStoreMappedCsgcReaders:
        csgc_mapped_reader.CsgCoreCsgcMappedReader[128]

fn csgStoreIdentityAuthorityLock() =
    os.CsgStoreIdentityRegistryLock()

fn csgStoreIdentityAuthorityUnlock() =
    os.CsgStoreIdentityRegistryUnlock()

fn csgStoreIdentityAuthorityRefMatchesArena(
        value: phase.PhaseArenaRef,
        arena: phase.PhaseArenaHandle): bool =
    return phase.PhaseArenaRefIsValid(value) &&
        value.arenaId == arena.arenaId &&
        value.generation == arena.generation

fn csgStoreIdentityAuthorityRegistryShapeValid(): bool =
    let arena = csgStoreIdentityAuthorityRegistry.arena
    return csgStoreIdentityAuthorityRegistryState ==
               csgStoreIdentityRegistryReady &&
        phase.PhaseArenaHandleIsValid(arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.states, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.generations, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.handleLow, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.handleHigh, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.storeInstanceSeeds, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.storeLayoutCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.beforeStoreIdentities, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.recordCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.leaseNonces, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.receiptNonces, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.stageBindings, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreIdentityAuthorityRegistry.lineageBindings, arena)

fn csgStoreIdentityAuthorityRegistryBuildInto(
        out: var csgStoreIdentityAuthorityRegistryStorage) =
    if phase.PhaseArenaHandleIsValid(out.arena):
        panic("merkle store identity: registry output owned")
    phase.PhaseArenaStoreInit(
        out.store,
        1,
        csgStoreIdentityRegistryPayloadBytes,
        csgStoreIdentityRegistryAllocationCount)
    out.arena = phase.PhaseArenaStoreOpenArena(
        out.store,
        1,
        csgStoreIdentityRegistryPayloadBytes,
        csgStoreIdentityRegistryAllocationCount)
    out.states = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreIdentityAuthoritySlotCount)
    out.generations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreIdentityAuthoritySlotCount)
    out.handleLow = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreIdentityAuthoritySlotCount)
    out.handleHigh = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreIdentityAuthoritySlotCount)
    out.storeInstanceSeeds = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.storeLayoutCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.beforeStoreIdentities = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.recordCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.leaseNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.receiptNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.stageBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    out.lineageBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreIdentityAuthoritySlotCount * layout.FixedBytes32Size,
        8)
    let report = phase.PhaseArenaStoreArenaReport(out.store, out.arena)
    if report.usedBytes != csgStoreIdentityRegistryPayloadBytes ||
       report.allocationCount !=
           csgStoreIdentityRegistryAllocationCount ||
       report.spillCount != 0:
        panic("merkle store identity: registry layout drift")

fn csgStoreIdentityAuthorityEnsureRegistry() =
    var builder: bool
    while !builder:
        csgStoreIdentityAuthorityLock()
        let observed = csgStoreIdentityAuthorityRegistryState
        if observed == csgStoreIdentityRegistryReady:
            csgStoreIdentityAuthorityUnlock()
            return
        if observed == csgStoreIdentityRegistryFailed:
            csgStoreIdentityAuthorityUnlock()
            panic("merkle store identity: registry initialization failed")
        if observed == csgStoreIdentityRegistryEmpty:
            csgStoreIdentityAuthorityRegistryState =
                csgStoreIdentityRegistryBuilding
            builder = true
            csgStoreIdentityAuthorityUnlock()
        elif observed == csgStoreIdentityRegistryBuilding:
            let observedEpoch =
                os.CsgStoreIdentityRegistryEpoch()
            csgStoreIdentityAuthorityUnlock()
            os.CsgStoreIdentityRegistryWait(observedEpoch)
        else:
            csgStoreIdentityAuthorityUnlock()
            panic("merkle store identity: registry state invalid")
    var candidate: csgStoreIdentityAuthorityRegistryStorage
    csgStoreIdentityAuthorityRegistryBuildInto(candidate)
    # The BUILDING state has one owner. Publish the managed candidate outside
    # the registry lock so retain/release and allocator work cannot recurse.
    csgStoreIdentityAuthorityRegistry = candidate
    candidate = csgStoreIdentityAuthorityRegistryStorage()
    csgStoreIdentityAuthorityLock()
    if csgStoreIdentityAuthorityRegistryState !=
           csgStoreIdentityRegistryBuilding:
        csgStoreIdentityAuthorityRegistryState =
            csgStoreIdentityRegistryFailed
        os.CsgStoreIdentityRegistryNotifyAll()
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store identity: registry publication drift")
    csgStoreIdentityAuthorityRegistryState =
        csgStoreIdentityRegistryReady
    if !csgStoreIdentityAuthorityRegistryShapeValid():
        csgStoreIdentityAuthorityRegistryState =
            csgStoreIdentityRegistryFailed
        os.CsgStoreIdentityRegistryNotifyAll()
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store identity: registry publication invalid")
    os.CsgStoreIdentityRegistryNotifyAll()
    csgStoreIdentityAuthorityUnlock()

fn csgStoreBeforeSnapshotRegistryShapeValid(): bool =
    let arena = csgStoreBeforeSnapshotRegistry.arena
    return csgStoreBeforeSnapshotRegistryState ==
               csgStoreIdentityRegistryReady &&
        phase.PhaseArenaHandleIsValid(arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.states, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.generations, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.sourceOwnerIds, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.sourceGenerations, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.storeGenerationLow, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.storeGenerationHigh, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.headRawLengths, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.manifestObjectLengths, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.csgcByteCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.factCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.nodeCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.sourceLeaseNonces, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.sourceLineageBindings, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.beforeStoreIdentities, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.headCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.manifestCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.csgcDirectoryCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.csgcObjectCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.factsRoots, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.dagRootCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.profileSetCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.schemaCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.headRawDigests, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.manifestObjectDigests, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.authorityNonces, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreBeforeSnapshotRegistry.snapshotBindings, arena)

fn csgStoreBeforeSnapshotRegistryBuildInto(
        out: var csgStoreBeforeSnapshotRegistryStorage) =
    if phase.PhaseArenaHandleIsValid(out.arena):
        panic("merkle store before snapshot: registry output owned")
    phase.PhaseArenaStoreInit(
        out.store,
        1,
        csgStoreBeforeSnapshotRegistryPayloadBytes,
        csgStoreBeforeSnapshotRegistryAllocationCount)
    out.arena = phase.PhaseArenaStoreOpenArena(
        out.store,
        1,
        csgStoreBeforeSnapshotRegistryPayloadBytes,
        csgStoreBeforeSnapshotRegistryAllocationCount)
    out.states = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.generations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.sourceOwnerIds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.sourceGenerations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.storeGenerationLow = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.storeGenerationHigh = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.headRawLengths = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.manifestObjectLengths = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.csgcByteCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.factCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.nodeCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreBeforeSnapshotSlotCount)
    out.sourceLeaseNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.sourceLineageBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.beforeStoreIdentities = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.headCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.manifestCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.csgcDirectoryCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.csgcObjectCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.factsRoots = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.dagRootCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.profileSetCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.schemaCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.headRawDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.manifestObjectDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.authorityNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    out.snapshotBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreBeforeSnapshotSlotCount * layout.FixedBytes32Size, 8)
    let report = phase.PhaseArenaStoreArenaReport(out.store, out.arena)
    if report.usedBytes != csgStoreBeforeSnapshotRegistryPayloadBytes ||
       report.allocationCount !=
           csgStoreBeforeSnapshotRegistryAllocationCount ||
       report.spillCount != 0:
        panic("merkle store before snapshot: registry layout drift")

fn csgStoreBeforeSnapshotEnsureRegistry() =
    var builder: bool
    while !builder:
        csgStoreIdentityAuthorityLock()
        let observed = csgStoreBeforeSnapshotRegistryState
        if observed == csgStoreIdentityRegistryReady:
            csgStoreIdentityAuthorityUnlock()
            return
        if observed == csgStoreIdentityRegistryFailed:
            csgStoreIdentityAuthorityUnlock()
            panic("merkle store before snapshot: registry init failed")
        if observed == csgStoreIdentityRegistryEmpty:
            csgStoreBeforeSnapshotRegistryState =
                csgStoreIdentityRegistryBuilding
            builder = true
            csgStoreIdentityAuthorityUnlock()
        elif observed == csgStoreIdentityRegistryBuilding:
            let observedEpoch = os.CsgStoreIdentityRegistryEpoch()
            csgStoreIdentityAuthorityUnlock()
            os.CsgStoreIdentityRegistryWait(observedEpoch)
        else:
            csgStoreIdentityAuthorityUnlock()
            panic("merkle store before snapshot: registry state invalid")
    var candidate: csgStoreBeforeSnapshotRegistryStorage
    csgStoreBeforeSnapshotRegistryBuildInto(candidate)
    csgStoreBeforeSnapshotRegistry = candidate
    candidate = csgStoreBeforeSnapshotRegistryStorage()
    csgStoreIdentityAuthorityLock()
    if csgStoreBeforeSnapshotRegistryState !=
           csgStoreIdentityRegistryBuilding:
        csgStoreBeforeSnapshotRegistryState =
            csgStoreIdentityRegistryFailed
        os.CsgStoreIdentityRegistryNotifyAll()
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store before snapshot: registry publish drift")
    csgStoreBeforeSnapshotRegistryState = csgStoreIdentityRegistryReady
    if !csgStoreBeforeSnapshotRegistryShapeValid():
        csgStoreBeforeSnapshotRegistryState =
            csgStoreIdentityRegistryFailed
        os.CsgStoreIdentityRegistryNotifyAll()
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store before snapshot: registry publish invalid")
    os.CsgStoreIdentityRegistryNotifyAll()
    csgStoreIdentityAuthorityUnlock()

fn csgStoreMappedCsgcRegistryShapeValid(): bool =
    let arena = csgStoreMappedCsgcRegistry.arena
    return csgStoreMappedCsgcRegistryState ==
               csgStoreIdentityRegistryReady &&
        phase.PhaseArenaHandleIsValid(arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.states, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.generations, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.sourceOwnerIds, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.sourceGenerations, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.storeGenerationLow, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.storeGenerationHigh, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.nextOrdinals, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.readCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.factCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.nodeCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.csgcByteCounts, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.sourceLineageBindings, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.sourceSnapshotBindings, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.beforeStoreIdentities, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.headCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.manifestCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.csgcDirectoryCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.csgcObjectCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.factsRoots, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.dagRootCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.profileSetCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.schemaCids, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.authorityNonces, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.mappedBindings, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.traversalDigests, arena) &&
        csgStoreIdentityAuthorityRefMatchesArena(
            csgStoreMappedCsgcRegistry.completionBindings, arena)

fn csgStoreMappedCsgcRegistryBuildInto(
        out: var csgStoreMappedCsgcRegistryStorage) =
    if phase.PhaseArenaHandleIsValid(out.arena):
        panic("merkle store mapped csgc: registry output owned")
    phase.PhaseArenaStoreInit(
        out.store,
        1,
        csgStoreMappedCsgcRegistryPayloadBytes,
        csgStoreMappedCsgcRegistryAllocationCount)
    out.arena = phase.PhaseArenaStoreOpenArena(
        out.store,
        1,
        csgStoreMappedCsgcRegistryPayloadBytes,
        csgStoreMappedCsgcRegistryAllocationCount)
    out.states = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.generations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.sourceOwnerIds = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.sourceGenerations = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.storeGenerationLow = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.storeGenerationHigh = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.nextOrdinals = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.readCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.factCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.nodeCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.csgcByteCounts = phase.PhaseArenaStoreReserveI32Column(
        out.store, out.arena, csgStoreMappedCsgcSlotCount)
    out.sourceLineageBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.sourceSnapshotBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.beforeStoreIdentities = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.headCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.manifestCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.csgcDirectoryCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.csgcObjectCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.factsRoots = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.dagRootCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.profileSetCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.schemaCids = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.authorityNonces = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.mappedBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.traversalDigests = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    out.completionBindings = phase.PhaseArenaStoreAllocRefAligned(
        out.store, out.arena,
        csgStoreMappedCsgcSlotCount * layout.FixedBytes32Size, 8)
    let report = phase.PhaseArenaStoreArenaReport(out.store, out.arena)
    if report.usedBytes != csgStoreMappedCsgcRegistryPayloadBytes ||
       report.allocationCount !=
           csgStoreMappedCsgcRegistryAllocationCount ||
       report.spillCount != 0:
        panic("merkle store mapped csgc: registry layout drift")

fn csgStoreMappedCsgcEnsureRegistry() =
    var builder: bool
    while !builder:
        csgStoreIdentityAuthorityLock()
        let observed = csgStoreMappedCsgcRegistryState
        if observed == csgStoreIdentityRegistryReady:
            csgStoreIdentityAuthorityUnlock()
            return
        if observed == csgStoreIdentityRegistryFailed:
            csgStoreIdentityAuthorityUnlock()
            panic("merkle store mapped csgc: registry init failed")
        if observed == csgStoreIdentityRegistryEmpty:
            csgStoreMappedCsgcRegistryState =
                csgStoreIdentityRegistryBuilding
            builder = true
            csgStoreIdentityAuthorityUnlock()
        elif observed == csgStoreIdentityRegistryBuilding:
            let observedEpoch = os.CsgStoreIdentityRegistryEpoch()
            csgStoreIdentityAuthorityUnlock()
            os.CsgStoreIdentityRegistryWait(observedEpoch)
        else:
            csgStoreIdentityAuthorityUnlock()
            panic("merkle store mapped csgc: registry state invalid")
    var candidate: csgStoreMappedCsgcRegistryStorage
    csgStoreMappedCsgcRegistryBuildInto(candidate)
    csgStoreMappedCsgcRegistry = candidate
    candidate = csgStoreMappedCsgcRegistryStorage()
    csgStoreIdentityAuthorityLock()
    if csgStoreMappedCsgcRegistryState !=
           csgStoreIdentityRegistryBuilding:
        csgStoreMappedCsgcRegistryState =
            csgStoreIdentityRegistryFailed
        os.CsgStoreIdentityRegistryNotifyAll()
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: registry publish drift")
    csgStoreMappedCsgcRegistryState = csgStoreIdentityRegistryReady
    if !csgStoreMappedCsgcRegistryShapeValid():
        csgStoreMappedCsgcRegistryState =
            csgStoreIdentityRegistryFailed
        os.CsgStoreIdentityRegistryNotifyAll()
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: registry publish invalid")
    os.CsgStoreIdentityRegistryNotifyAll()
    csgStoreIdentityAuthorityUnlock()

fn csgStoreBeforeSnapshotI32At(
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        csgStoreBeforeSnapshotRegistry.store,
        csgStoreBeforeSnapshotRegistry.arena,
        column,
        row)

fn csgStoreBeforeSnapshotSetI32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        csgStoreBeforeSnapshotRegistry.store,
        csgStoreBeforeSnapshotRegistry.arena,
        column,
        row,
        value)

fn csgStoreBeforeSnapshotFixed32At(
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var bytes = phase.PhaseArenaStoreCopyBytesOut(
        csgStoreBeforeSnapshotRegistry.store,
        csgStoreBeforeSnapshotRegistry.arena,
        column,
        row * layout.FixedBytes32Size,
        layout.FixedBytes32Size)
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        panic("merkle store before snapshot: fixed32 read invalid")
    return result.Value(parsed)

fn csgStoreBeforeSnapshotSetFixed32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    var bytes = layout.FixedBytes32ToBytes(value)
    phase.PhaseArenaStoreCopyBytesInto(
        csgStoreBeforeSnapshotRegistry.store,
        csgStoreBeforeSnapshotRegistry.arena,
        column,
        row * layout.FixedBytes32Size,
        bytes,
        0,
        layout.FixedBytes32Size)
    rawbytes.BytesFree(bytes)

fn csgStoreMappedCsgcI32At(
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        csgStoreMappedCsgcRegistry.store,
        csgStoreMappedCsgcRegistry.arena,
        column,
        row)

fn csgStoreMappedCsgcSetI32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        csgStoreMappedCsgcRegistry.store,
        csgStoreMappedCsgcRegistry.arena,
        column,
        row,
        value)

fn csgStoreMappedCsgcFixed32At(
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var bytes = phase.PhaseArenaStoreCopyBytesOut(
        csgStoreMappedCsgcRegistry.store,
        csgStoreMappedCsgcRegistry.arena,
        column,
        row * layout.FixedBytes32Size,
        layout.FixedBytes32Size)
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        panic("merkle store mapped csgc: fixed32 read invalid")
    return result.Value(parsed)

fn csgStoreMappedCsgcSetFixed32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    var bytes = layout.FixedBytes32ToBytes(value)
    phase.PhaseArenaStoreCopyBytesInto(
        csgStoreMappedCsgcRegistry.store,
        csgStoreMappedCsgcRegistry.arena,
        column,
        row * layout.FixedBytes32Size,
        bytes,
        0,
        layout.FixedBytes32Size)
    rawbytes.BytesFree(bytes)

fn csgStoreIdentityAuthorityI32At(
        column: phase.PhaseArenaRef,
        row: int32): int32 =
    return phase.PhaseArenaStoreI32ColumnGet(
        csgStoreIdentityAuthorityRegistry.store,
        csgStoreIdentityAuthorityRegistry.arena,
        column,
        row)

fn csgStoreIdentityAuthoritySetI32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: int32) =
    phase.PhaseArenaStoreI32ColumnSet(
        csgStoreIdentityAuthorityRegistry.store,
        csgStoreIdentityAuthorityRegistry.arena,
        column,
        row,
        value)

fn csgStoreIdentityAuthorityFixed32At(
        column: phase.PhaseArenaRef,
        row: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    let base = row * layout.FixedBytes32Size
    for byteIndex in 0..<layout.FixedBytes32Size:
        out.data[byteIndex] = uint8(phase.PhaseArenaStoreGetByte(
            csgStoreIdentityAuthorityRegistry.store,
            csgStoreIdentityAuthorityRegistry.arena,
            column,
            base + byteIndex))
    return out

fn csgStoreIdentityAuthoritySetFixed32(
        column: phase.PhaseArenaRef,
        row: int32,
        value: layout.FixedBytes32) =
    let base = row * layout.FixedBytes32Size
    for byteIndex in 0..<layout.FixedBytes32Size:
        phase.PhaseArenaStoreSetByte(
            csgStoreIdentityAuthorityRegistry.store,
            csgStoreIdentityAuthorityRegistry.arena,
            column,
            base + byteIndex,
            int32(value.data[byteIndex]))

fn csgStoreIdentityAuthorityHandleAt(row: int32): os.AtomicTree =
    let low = csgStoreIdentityAuthorityI32At(
        csgStoreIdentityAuthorityRegistry.handleLow, row)
    let high = csgStoreIdentityAuthorityI32At(
        csgStoreIdentityAuthorityRegistry.handleHigh, row)
    return (uint64(uint32(high)) << uint64(32)) |
        uint64(uint32(low))

fn csgStoreIdentityAuthoritySetHandle(
        row: int32,
        handle: os.AtomicTree) =
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.handleLow,
        row,
        int32(uint32(handle & uint64(4294967295))))
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.handleHigh,
        row,
        int32(uint32((handle >> uint64(32)) &
                     uint64(4294967295))))

@borrows
fn csgStoreIdentityCat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

fn csgStoreIdentityAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgStoreIdentityAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgStoreIdentityAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

fn csgStoreIdentityFinishCid(
        out: var layout.ByteBuf): str =
    let digest = hash256.Sha256Fixed(layout.ByteBufView(out))
    layout.ByteBufFree(out)
    return csgStoreIdentityCat(
        "sha256:", layout.FixedBytes32Hex(digest))

fn CsgCoreMerkleStoreOrderedCanonicalCategoryNames(): str[] =
    return [
        "csgc_objects",
        "dependencies",
        "indexes",
        "manifests",
        "memberships",
        "nodes",
        "operations",
        "partitions",
        "proofs",
        "receipts",
        "requests",
        "successors",
        "summaries"
    ]

fn CsgCoreMerkleStoreLayoutIdentity(): str =
    let categories =
        CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    var out: str
    for i in 0..<categories.len:
        if i > 0:
            out = csgStoreIdentityCat(out, ",")
        out = csgStoreIdentityCat(out, categories[i])
    return out

fn CsgCoreMerkleStoreExpectedRootDirectories(): str[] =
    return CsgCoreMerkleStoreOrderedCanonicalCategoryNames()

fn CsgCoreMerkleStoreExpectedRootFiles(): str[] =
    return ["store.csgc", "store.identity.csgc"]

fn csgStoreIdentityExpectedInitialFiles(): str[] =
    let categories =
        CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    var out: str[]
    for i in 0..<categories.len:
        if categories[i] == "successors":
            add(out, "store.csgc")
            add(out, "store.identity.csgc")
        add(
            out,
            csgStoreIdentityJoin(
                categories[i], "category.csgc"))
    return out

@borrows
fn csgStoreIdentityJoin(
        left: str,
        right: str): str =
    if left.len == 0:
        return strings.CloneStr(right)
    if right.len == 0:
        return strings.CloneStr(left)
    if left[left.len - 1] == '/':
        return csgStoreIdentityCat(left, right)
    return csgStoreIdentityCat(
        csgStoreIdentityCat(left, "/"), right)

@borrows
fn csgStoreIdentitySameStrings(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn csgStoreIdentityCloneStrings(values: str[]): str[] =
    var out: str[]
    for i in 0..<values.len:
        add(out, strings.CloneStr(values[i]))
    return out

@borrows
fn csgStoreIdentityCategoriesCanonical(
        categories: str[]): bool =
    let expected =
        CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    return csgStoreIdentitySameStrings(categories, expected)

@borrows
fn csgStoreLayoutCid(
        formatId: str,
        markerSchema: str,
        categories: str[]): str =
    var out = layout.ByteBufInit(384)
    csgStoreIdentityAppendText(
        out, csgCoreMerkleStoreLayoutDomain)
    csgStoreIdentityAppendText(out, formatId)
    csgStoreIdentityAppendText(out, markerSchema)
    csgStoreIdentityAppendU32(out, categories.len)
    for i in 0..<categories.len:
        csgStoreIdentityAppendText(out, categories[i])
    return csgStoreIdentityFinishCid(out)

@borrows
fn csgBeforeStoreIdentity(
        formatId: str,
        storeLayoutCid: str,
        storeInstanceSeed: layout.FixedBytes32): str =
    var out = layout.ByteBufInit(192)
    csgStoreIdentityAppendText(
        out, csgCoreMerkleStoreIdentityDomain)
    csgStoreIdentityAppendText(out, formatId)
    csgStoreIdentityAppendText(out, storeLayoutCid)
    csgStoreIdentityAppendU32(
        out, layout.FixedBytes32Size)
    for i in 0..<layout.FixedBytes32Size:
        layout.ByteBufAppendByte(
            out, int32(storeInstanceSeed.data[i]) & 255)
    return csgStoreIdentityFinishCid(out)

@borrows
fn csgStoreIdentityIssueSeed(
        storeInstanceSeed: layout.FixedBytes32):
        CsgCoreMerkleStoreIdentityRecord =
    var out: CsgCoreMerkleStoreIdentityRecord
    if layout.FixedBytes32Equal(
           storeInstanceSeed, layout.FixedBytes32()):
        return out
    let categories =
        CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    out.formatId = csgCoreMerkleStoreFormatId
    out.markerSchema = csgCoreMerkleStoreMarkerSchema
    out.orderedCanonicalCategoryNames =
        csgStoreIdentityCloneStrings(categories)
    out.storeLayoutCid = csgStoreLayoutCid(
        out.formatId,
        out.markerSchema,
        out.orderedCanonicalCategoryNames)
    out.storeInstanceSeed =
        layout.FixedBytes32Copy(storeInstanceSeed)
    out.beforeStoreIdentity = csgBeforeStoreIdentity(
        out.formatId,
        out.storeLayoutCid,
        out.storeInstanceSeed)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.storeLayoutCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.beforeStoreIdentity):
        return CsgCoreMerkleStoreIdentityRecord()
    return out

@borrows
fn csgStoreIdentityCoreValid(
        record: CsgCoreMerkleStoreIdentityRecord): bool =
    if record.formatId != csgCoreMerkleStoreFormatId ||
       record.markerSchema != csgCoreMerkleStoreMarkerSchema ||
       !csgStoreIdentityCategoriesCanonical(
           record.orderedCanonicalCategoryNames):
        return false
    let expected = csgStoreIdentityIssueSeed(
        record.storeInstanceSeed)
    return expected.formatId.len > 0 &&
        expected.formatId == record.formatId &&
        expected.markerSchema == record.markerSchema &&
        csgStoreIdentitySameStrings(
            expected.orderedCanonicalCategoryNames,
            record.orderedCanonicalCategoryNames) &&
        expected.storeLayoutCid == record.storeLayoutCid &&
        expected.beforeStoreIdentity ==
            record.beforeStoreIdentity

@borrows
fn csgStoreIdentityReceiptFromRecord(
        ownerId: int32,
        generation: int32,
        receiptNonce: layout.FixedBytes32,
        record: CsgCoreMerkleStoreIdentityRecord):
        CsgCoreMerkleStoreIdentityReceipt =
    var out: CsgCoreMerkleStoreIdentityReceipt
    if ownerId <= 0 || generation <= 0 ||
       layout.FixedBytes32Equal(
           receiptNonce, layout.FixedBytes32()) ||
       !csgStoreIdentityCoreValid(record) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(record.recordCid):
        out.error = "merkle_store_identity_record_invalid"
        return out
    out.ok = true
    out.ownerId = ownerId
    out.generation = generation
    out.receiptNonce = layout.FixedBytes32Copy(receiptNonce)
    out.formatId = strings.CloneStr(record.formatId)
    out.markerSchema = strings.CloneStr(record.markerSchema)
    out.orderedCanonicalCategoryNames =
        csgStoreIdentityCloneStrings(record.orderedCanonicalCategoryNames)
    out.storeLayoutCid = strings.CloneStr(record.storeLayoutCid)
    out.storeInstanceSeed = layout.FixedBytes32Copy(record.storeInstanceSeed)
    out.beforeStoreIdentity = strings.CloneStr(record.beforeStoreIdentity)
    out.recordCid = strings.CloneStr(record.recordCid)
    return out

@borrows
fn csgStoreIdentityJsonString(value: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(value)

@borrows
fn CsgCoreMerkleStoreMarkerBytes(
        markerKind: str,
        markerId: str): rawbytes.Bytes =
    var line = "{\"id\":"
    line = csgStoreIdentityCat(
        line, csgStoreIdentityJsonString(markerId))
    line = csgStoreIdentityCat(line, ",\"kind\":")
    line = csgStoreIdentityCat(
        line, csgStoreIdentityJsonString(markerKind))
    line = csgStoreIdentityCat(line, "}")
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines([line])
    if !encoded.ok:
        return rawbytes.EmptyBytes()
    return encoded.bytes

@borrows
fn csgStoreIdentityMarkerMatches(
        handle: os.AtomicTree,
        path: str,
        markerKind: str,
        markerId: str): bool =
    let read = os.AtomicTreeReadStable(handle, path)
    if result.IsErr(read):
        return false
    var actual = result.Value(read)
    var expected =
        CsgCoreMerkleStoreMarkerBytes(markerKind, markerId)
    let same = rawbytes.BytesLen(expected) > 0 &&
        rawbytes.BytesEqual(actual, expected)
    rawbytes.BytesFree(actual)
    rawbytes.BytesFree(expected)
    return same

@borrows
fn csgStoreIdentityWriteMarker(
        handle: os.AtomicTree,
        path: str,
        markerKind: str,
        markerId: str): str =
    var bytes = CsgCoreMerkleStoreMarkerBytes(markerKind, markerId)
    if rawbytes.BytesLen(bytes) <= 0:
        rawbytes.BytesFree(bytes)
        return "merkle_store_identity_marker_encode_failed"
    let wrote = os.AtomicTreeWriteExclusiveLeaseSync(
        handle, path, bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(wrote):
        return strings.CloneStr(result.Error(wrote))
    return ""

@borrows
fn csgStoreIdentityRecordLine(
        record: CsgCoreMerkleStoreIdentityRecord): str =
    var line = "{\"beforeStoreIdentity\":"
    line = csgStoreIdentityCat(
        line,
        csgStoreIdentityJsonString(
            record.beforeStoreIdentity))
    line = csgStoreIdentityCat(line, ",\"formatId\":")
    line = csgStoreIdentityCat(
        line, csgStoreIdentityJsonString(record.formatId))
    line = csgStoreIdentityCat(line, ",\"kind\":")
    line = csgStoreIdentityCat(
        line,
        csgStoreIdentityJsonString(
            csgCoreMerkleStoreIdentityKind))
    line = csgStoreIdentityCat(line, ",\"markerSchema\":")
    line = csgStoreIdentityCat(
        line, csgStoreIdentityJsonString(record.markerSchema))
    line = csgStoreIdentityCat(
        line, ",\"storeInstanceSeed\":")
    line = csgStoreIdentityCat(
        line,
        csgStoreIdentityJsonString(
            layout.FixedBytes32Hex(
                record.storeInstanceSeed)))
    line = csgStoreIdentityCat(line, ",\"storeLayoutCid\":")
    line = csgStoreIdentityCat(
        line,
        csgStoreIdentityJsonString(
            record.storeLayoutCid))
    return csgStoreIdentityCat(line, "}")

@borrows
fn csgStoreIdentityCodecFail(
        error: str): CsgCoreMerkleStoreIdentityCodecResult =
    var out: CsgCoreMerkleStoreIdentityCodecResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreMerkleStoreIdentityRecordEncode(
        record: CsgCoreMerkleStoreIdentityRecord):
        CsgCoreMerkleStoreIdentityCodecResult =
    if !csgStoreIdentityCoreValid(record):
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_record_invalid")
    let line = csgStoreIdentityRecordLine(record)
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines([share(line)])
    if !encoded.ok:
        return csgStoreIdentityCodecFail(
            csgStoreIdentityCat(
                "merkle_store_identity_encode ",
                encoded.error))
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if !decoded.ok || decoded.factCount != 1 ||
       decoded.lines.len != 1 || decoded.lines[0] != line:
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_encode_self_check")
    let recordCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            csgCoreMerkleStoreIdentityRecordDomain,
            encoded.bytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(recordCid):
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_record_cid_invalid")
    if record.recordCid.len > 0 &&
       record.recordCid != recordCid:
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_record_cid_mismatch")
    var canonical = csgStoreIdentityIssueSeed(
        record.storeInstanceSeed)
    if canonical.formatId.len == 0:
        rawbytes.BytesFree(encoded.bytes)
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_reissue_failed")
    canonical.recordCid = strings.CloneStr(recordCid)
    var out: CsgCoreMerkleStoreIdentityCodecResult
    out.ok = true
    out.record = canonical
    out.lines = decoded.lines
    out.bytes = encoded.bytes
    return out

fn csgCoreMerkleStoreIdentityRecordCreate():
        CsgCoreMerkleStoreIdentityCodecResult =
    var seedBytes = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    if rawbytes.BytesLen(seedBytes) != layout.FixedBytes32Size ||
       !rand.RandomFill(seedBytes):
        rawbytes.BytesFree(seedBytes)
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_entropy_unavailable")
    let parsed = layout.FixedBytes32FromBytes(seedBytes)
    rawbytes.BytesFree(seedBytes)
    if result.IsErr(parsed):
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_seed_parse_failed")
    let record = csgStoreIdentityIssueSeed(result.Value(parsed))
    if record.formatId.len == 0:
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_seed_invalid")
    return CsgCoreMerkleStoreIdentityRecordEncode(record)

@borrows
fn csgStoreIdentityWriteNewRecord(
        handle: os.AtomicTree): str =
    if handle == uint64(0):
        return "merkle_store_identity_initialize_handle_invalid"
    var created = csgCoreMerkleStoreIdentityRecordCreate()
    if !created.ok:
        return strings.CloneStr(created.error)
    let wrote = os.AtomicTreeWriteExclusiveLeaseSync(
        handle,
        "store.identity.csgc",
        created.bytes)
    if result.IsErr(wrote):
        rawbytes.BytesFree(created.bytes)
        return strings.CloneStr(result.Error(wrote))
    let read = os.AtomicTreeReadStable(
        handle, "store.identity.csgc")
    if result.IsErr(read):
        rawbytes.BytesFree(created.bytes)
        return strings.CloneStr(result.Error(read))
    var stored = result.Value(read)
    var replay = CsgCoreMerkleStoreIdentityRecordDecode(stored)
    let valid = replay.ok &&
        rawbytes.BytesEqual(created.bytes, stored) &&
        rawbytes.BytesEqual(created.bytes, replay.bytes) &&
        created.record.recordCid == replay.record.recordCid &&
        created.record.beforeStoreIdentity ==
            replay.record.beforeStoreIdentity
    if replay.ok:
        rawbytes.BytesFree(replay.bytes)
    rawbytes.BytesFree(stored)
    rawbytes.BytesFree(created.bytes)
    if !valid:
        return "merkle_store_identity_initialize_replay_failed"
    return ""

@borrows
fn csgStoreIdentityRequiredString(
        line: str,
        name: str,
        out: var str): bool =
    let value = field.CsgCoreJsonTopStringField(line, name)
    if !value.found:
        return false
    out = strings.CloneStr(value.value)
    return true

@borrows
fn CsgCoreMerkleStoreIdentityRecordDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleStoreIdentityCodecResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok || decoded.factCount != 1 ||
       decoded.lines.len != 1:
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_decode_invalid")
    var beforeStoreIdentity: str
    var formatId: str
    var kind: str
    var markerSchema: str
    var seedHex: str
    var storeLayoutCid: str
    if !csgStoreIdentityRequiredString(
           decoded.lines[0], "beforeStoreIdentity", beforeStoreIdentity) ||
       !csgStoreIdentityRequiredString(
           decoded.lines[0], "formatId", formatId) ||
       !csgStoreIdentityRequiredString(decoded.lines[0], "kind", kind) ||
       !csgStoreIdentityRequiredString(
           decoded.lines[0], "markerSchema", markerSchema) ||
       !csgStoreIdentityRequiredString(
           decoded.lines[0], "storeInstanceSeed", seedHex) ||
       !csgStoreIdentityRequiredString(
           decoded.lines[0], "storeLayoutCid", storeLayoutCid) ||
       kind != csgCoreMerkleStoreIdentityKind:
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_record_fields_invalid")
    let parsed = layout.FixedBytes32FromHex(seedHex)
    if result.IsErr(parsed):
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_seed_invalid")
    var record = csgStoreIdentityIssueSeed(result.Value(parsed))
    if record.formatId.len == 0 || record.formatId != formatId ||
       record.markerSchema != markerSchema ||
       record.storeLayoutCid != storeLayoutCid ||
       record.beforeStoreIdentity != beforeStoreIdentity:
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_record_binding_mismatch")
    var reencoded = CsgCoreMerkleStoreIdentityRecordEncode(record)
    if !reencoded.ok:
        return reencoded
    if !rawbytes.BytesEqual(bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgStoreIdentityCodecFail(
            "merkle_store_identity_record_noncanonical")
    return reencoded

@borrows
fn csgStoreIdentityReadFail(
        error: str): csgCoreMerkleStoreIdentityReadResult =
    var out: csgCoreMerkleStoreIdentityReadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreIdentityReadOpened(
        handle: os.AtomicTree): csgCoreMerkleStoreIdentityReadResult =
    let categories =
        CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    let expectedDirs =
        CsgCoreMerkleStoreExpectedRootDirectories()
    let expectedFiles =
        CsgCoreMerkleStoreExpectedRootFiles()
    let exact = os.AtomicTreeVerifyRootExact(
        handle, expectedDirs, expectedFiles)
    if result.IsErr(exact):
        return csgStoreIdentityReadFail(
            "merkle_store_identity_root_shape_invalid")
    if !csgStoreIdentityMarkerMatches(
           handle,
           "store.csgc",
           "csg.merkle.store",
           CsgCoreMerkleStoreLayoutIdentity()):
        return csgStoreIdentityReadFail(
            "merkle_store_identity_store_marker_invalid")
    for i in 0..<categories.len:
        if !csgStoreIdentityMarkerMatches(
               handle,
               csgStoreIdentityJoin(
                   categories[i], "category.csgc"),
               "csg.merkle.store_category",
               categories[i]):
            return csgStoreIdentityReadFail(
                "merkle_store_identity_category_marker_invalid")
    let read = os.AtomicTreeReadStable(
        handle, "store.identity.csgc")
    if result.IsErr(read):
        return csgStoreIdentityReadFail(
            "merkle_store_identity_record_missing")
    var bytes = result.Value(read)
    var decoded = CsgCoreMerkleStoreIdentityRecordDecode(bytes)
    rawbytes.BytesFree(bytes)
    if !decoded.ok:
        return csgStoreIdentityReadFail(decoded.error)
    rawbytes.BytesFree(decoded.bytes)
    var out: csgCoreMerkleStoreIdentityReadResult
    out.ok = true
    out.record = decoded.record
    return out

@borrows
fn CsgCoreMerkleStoreIdentityReadVerifiedRecord(
        storeRoot: str,
        record: var CsgCoreMerkleStoreIdentityRecord,
        error: var str): bool =
    if !os.IsAbsolute(storeRoot):
        error = "merkle_store_identity_root_not_absolute"
        return false
    let split = os.SplitFile(storeRoot)
    if split.dir.len == 0 || split.name.len == 0:
        error = "merkle_store_identity_root_path_invalid"
        return false
    let opened = os.AtomicTreeOpenVerified(split.dir, split.name)
    if result.IsErr(opened):
        error = csgStoreIdentityCat(
            "merkle_store_identity_record_missing ",
            result.Error(opened))
        return false
    let handle = result.Value(opened)
    let read = csgStoreIdentityReadOpened(handle)
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        error = "merkle_store_identity_read_close_failed"
        return false
    if !read.ok:
        error = strings.CloneStr(read.error)
        return false
    record = read.record
    error = ""
    return true

@borrows
fn csgStoreIdentityCidTextInto(
        text: str,
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(text):
        return false
    let hexText = strings.CloneStrRange(text, 7, 64)
    let parsed = layout.FixedBytes32FromHex(hexText)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return layout.FixedBytes32Hex(out) == hexText

fn csgStoreIdentityAuthorityNonce(
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    var bytes = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    if rawbytes.BytesLen(bytes) != layout.FixedBytes32Size ||
       !rand.RandomFill(bytes):
        rawbytes.BytesFree(bytes)
        return false
    let parsed = layout.FixedBytes32FromBytes(bytes)
    rawbytes.BytesFree(bytes)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return !layout.FixedBytes32Equal(out, layout.FixedBytes32())

@borrows
fn csgStoreIdentityPathOpenFail(
        error: str): CsgCoreMerkleStorePathAuthorityOpenResult =
    var out: CsgCoreMerkleStorePathAuthorityOpenResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreIdentityPathHandleFail(
        handle: os.AtomicTree,
        error: str): CsgCoreMerkleStorePathAuthorityOpenResult =
    if handle != uint64(0):
        let closed = os.AtomicTreeClose(handle)
        if result.IsErr(closed):
            panic("merkle store identity: failed open handle close failed")
    return csgStoreIdentityPathOpenFail(error)

@borrows
fn csgStoreIdentityHandleFail(
        error: str): csgCoreMerkleStoreIdentityHandleResult =
    var out: csgCoreMerkleStoreIdentityHandleResult
    out.error = strings.CloneStr(error)
    return out

fn csgStoreIdentityAbortOwned(
        handle: var os.AtomicTree,
        error: str): csgCoreMerkleStoreIdentityHandleResult =
    if handle != uint64(0):
        let aborted = os.AtomicTreeAbort(handle)
        handle = uint64(0)
        if result.IsErr(aborted):
            panic("merkle store identity: transaction abort failed")
    return csgStoreIdentityHandleFail(error)

fn csgStoreIdentityCloseOwned(
        handle: var os.AtomicTree,
        error: str): csgCoreMerkleStoreIdentityHandleResult =
    if handle != uint64(0):
        let closed = os.AtomicTreeClose(handle)
        handle = uint64(0)
        if result.IsErr(closed):
            panic("merkle store identity: exclusive handle close failed")
    return csgStoreIdentityHandleFail(error)

fn csgStoreIdentityStagingName(out: var str): bool =
    out = ""
    var nonce: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(nonce):
        return false
    out = csgStoreIdentityCat(
        "csg-store-stage-", layout.FixedBytes32Hex(nonce))
    return out.len > 0

fn csgStoreIdentityInitializeAbsent(
        absentHandle: var os.AtomicTree):
        csgCoreMerkleStoreIdentityHandleResult =
    var stagingName: str
    if !csgStoreIdentityStagingName(stagingName):
        return csgStoreIdentityCloseOwned(
            absentHandle,
            "merkle_store_identity_staging_nonce_unavailable")
    let begun = os.AtomicTreeBeginFromExclusiveAbsent(
        absentHandle, stagingName)
    if result.IsErr(begun):
        return csgStoreIdentityCloseOwned(
            absentHandle, result.Error(begun))
    var transaction = result.Value(begun)
    if absentHandle != uint64(0) || transaction == uint64(0):
        panic("merkle store identity: begin consumption invalid")
    let categories =
        CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    for i in 0..<categories.len:
        let made = os.AtomicTreeMkdir(transaction, categories[i])
        if result.IsErr(made):
            return csgStoreIdentityAbortOwned(
                transaction, result.Error(made))
        let markerError = csgStoreIdentityWriteMarker(
            transaction,
            csgStoreIdentityJoin(categories[i], "category.csgc"),
            "csg.merkle.store_category",
            categories[i])
        if markerError.len > 0:
            return csgStoreIdentityAbortOwned(
                transaction, markerError)
    let storeMarkerError = csgStoreIdentityWriteMarker(
        transaction,
        "store.csgc",
        "csg.merkle.store",
        CsgCoreMerkleStoreLayoutIdentity())
    if storeMarkerError.len > 0:
        return csgStoreIdentityAbortOwned(
            transaction, storeMarkerError)
    let identityError = csgStoreIdentityWriteNewRecord(transaction)
    if identityError.len > 0:
        return csgStoreIdentityAbortOwned(
            transaction, identityError)
    let exact = os.AtomicTreeVerifyExact(
        transaction,
        CsgCoreMerkleStoreExpectedRootDirectories(),
        csgStoreIdentityExpectedInitialFiles())
    if result.IsErr(exact):
        return csgStoreIdentityAbortOwned(
            transaction, result.Error(exact))
    let committed =
        os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(transaction)
    if result.IsErr(committed):
        return csgStoreIdentityAbortOwned(
            transaction, result.Error(committed))
    if transaction != uint64(0):
        panic("merkle store identity: commit consumption invalid")
    let openedHandle = result.Value(committed)
    if openedHandle == uint64(0):
        return csgStoreIdentityHandleFail(
            "merkle_store_identity_commit_handle_invalid")
    var out: csgCoreMerkleStoreIdentityHandleResult
    out.ok = true
    out.handle = openedHandle
    return out

@borrows
fn csgStoreIdentityPublishAuthority(
        handle: os.AtomicTree,
        record: CsgCoreMerkleStoreIdentityRecord,
        reused: bool): CsgCoreMerkleStorePathAuthorityOpenResult =
    var leaseNonce: layout.FixedBytes32
    var receiptNonce: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(leaseNonce) ||
       !csgStoreIdentityAuthorityNonce(receiptNonce) ||
       layout.FixedBytes32Equal(leaseNonce, receiptNonce):
        return csgStoreIdentityPathHandleFail(
            handle, "merkle_store_identity_nonce_unavailable")
    var storeLayoutCid: layout.FixedBytes32
    var beforeStoreIdentity: layout.FixedBytes32
    var recordCid: layout.FixedBytes32
    if !csgStoreIdentityCidTextInto(
           record.storeLayoutCid, storeLayoutCid) ||
       !csgStoreIdentityCidTextInto(
           record.beforeStoreIdentity, beforeStoreIdentity) ||
       !csgStoreIdentityCidTextInto(
           record.recordCid, recordCid):
        return csgStoreIdentityPathHandleFail(
            handle, "merkle_store_identity_record_cid_invalid")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid():
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityPathHandleFail(
            handle, "merkle_store_identity_registry_invalid")
    var row: int32 = -1
    var reusableGenerationExhausted: bool
    var reusableGenerationInvalid: bool
    for i in 0..<csgStoreIdentityAuthoritySlotCount:
        let state = csgStoreIdentityAuthorityI32At(
            csgStoreIdentityAuthorityRegistry.states, i)
        let reusable =
            state == csgStoreIdentityAuthorityEmpty ||
            state == csgStoreIdentityAuthorityClosed ||
            state == csgStoreIdentityAuthorityPoisoned
        if reusable:
            let candidateGeneration = csgStoreIdentityAuthorityI32At(
                csgStoreIdentityAuthorityRegistry.generations, i)
            if candidateGeneration < 0:
                reusableGenerationInvalid = true
            elif candidateGeneration >= 2147483646:
                reusableGenerationExhausted = true
            elif row < 0:
                row = i
    if row < 0:
        csgStoreIdentityAuthorityUnlock()
        if reusableGenerationInvalid:
            return csgStoreIdentityPathHandleFail(
                handle, "merkle_store_identity_generation_invalid")
        if reusableGenerationExhausted:
            return csgStoreIdentityPathHandleFail(
                handle, "merkle_store_identity_generation_exhausted")
        return csgStoreIdentityPathHandleFail(
            handle, "merkle_store_identity_registry_full")
    let previousGeneration = csgStoreIdentityAuthorityI32At(
        csgStoreIdentityAuthorityRegistry.generations, row)
    if previousGeneration < 0 || previousGeneration >= 2147483646:
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store identity: selected generation invalid")
    let generation = previousGeneration + 1
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.generations,
        row,
        generation)
    csgStoreIdentityAuthoritySetHandle(row, handle)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.storeInstanceSeeds,
        row,
        record.storeInstanceSeed)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.storeLayoutCids,
        row,
        storeLayoutCid)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.beforeStoreIdentities,
        row,
        beforeStoreIdentity)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.recordCids,
        row,
        recordCid)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.leaseNonces,
        row,
        leaseNonce)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.receiptNonces,
        row,
        receiptNonce)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.stageBindings,
        row,
        layout.FixedBytes32())
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.lineageBindings,
        row,
        layout.FixedBytes32())
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.states,
        row,
        csgStoreIdentityAuthorityLiveOpen)
    csgStoreIdentityAuthorityUnlock()
    var authority: CsgCoreMerkleStorePathAuthority
    authority.ownerId = row + 1
    authority.generation = generation
    authority.leaseNonce = leaseNonce
    let receipt = csgStoreIdentityReceiptFromRecord(
        authority.ownerId,
        authority.generation,
        receiptNonce,
        record)
    if !receipt.ok:
        var failedAuthority = authority
        let closeError =
            CsgCoreMerkleStorePathAuthorityClose(failedAuthority)
        if closeError.len > 0:
            panic("merkle store identity: receipt issue cleanup failed")
        return csgStoreIdentityPathOpenFail(receipt.error)
    var out: CsgCoreMerkleStorePathAuthorityOpenResult
    out.ok = true
    out.reused = reused
    out.authority = authority
    out.identityReceipt = receipt
    return out

@borrows
fn CsgCoreMerkleStoreAcquirePathAuthority(
        parentPath: str,
        storeName: str,
        intent: CsgCoreMerkleStorePathIntent):
        CsgCoreMerkleStorePathAuthorityOpenResult =
    if intent != CsgCoreMerkleStoreExistingOnly &&
       intent != CsgCoreMerkleStoreInitializeIfAbsent:
        return csgStoreIdentityPathOpenFail(
            "merkle_store_identity_intent_invalid")
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parentPath, storeName)
    if result.IsErr(opened):
        return csgStoreIdentityPathOpenFail(result.Error(opened))
    let openedValue = result.Value(opened)
    var handle = openedValue.tree
    var reused: bool
    if openedValue.kind == os.AtomicTreeExclusiveOpened:
        reused = true
    elif openedValue.kind == os.AtomicTreeExclusiveAbsent:
        if intent != CsgCoreMerkleStoreInitializeIfAbsent:
            return csgStoreIdentityPathHandleFail(
                handle, "merkle_store_identity_store_absent")
        let initialized = csgStoreIdentityInitializeAbsent(handle)
        if !initialized.ok:
            return csgStoreIdentityPathOpenFail(initialized.error)
        handle = initialized.handle
    else:
        return csgStoreIdentityPathHandleFail(
            handle, "merkle_store_identity_open_kind_invalid")
    if handle == uint64(0):
        return csgStoreIdentityPathOpenFail(
            "merkle_store_identity_open_handle_invalid")
    let read = csgStoreIdentityReadOpened(handle)
    if !read.ok:
        return csgStoreIdentityPathHandleFail(handle, read.error)
    return csgStoreIdentityPublishAuthority(
        handle, read.record, reused)

@borrows
fn csgStoreIdentityStageRowMatches(
        ownerId: int32,
        generation: int32,
        stageNonce: layout.FixedBytes32,
        requiredState: int32): bool =
    if ownerId <= 0 ||
       ownerId > csgStoreIdentityAuthoritySlotCount ||
       generation <= 0 ||
       layout.FixedBytes32Equal(
           stageNonce, layout.FixedBytes32()):
        return false
    let row = ownerId - 1
    return csgStoreIdentityAuthorityI32At(
               csgStoreIdentityAuthorityRegistry.states, row) ==
               requiredState &&
        csgStoreIdentityAuthorityI32At(
            csgStoreIdentityAuthorityRegistry.generations, row) ==
            generation &&
        csgStoreIdentityAuthorityHandleAt(row) != uint64(0) &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.leaseNonces, row),
            stageNonce)

@borrows
fn csgStoreIdentityAuthorityRowMatches(
        authority: CsgCoreMerkleStorePathAuthority,
        requiredState: int32): bool =
    return csgStoreIdentityStageRowMatches(
        authority.ownerId,
        authority.generation,
        authority.leaseNonce,
        requiredState)

fn csgStoreIdentityAuthorityStateReceiptable(state: int32): bool =
    return state == csgStoreIdentityAuthorityLiveOpen ||
        state == csgStoreIdentityAuthorityPlanningOwned ||
        state == csgStoreIdentityAuthorityPreparedOwned ||
        state == csgStoreIdentityAuthoritySessionOwned

@borrows
fn csgStoreIdentityStageMoveFail(
        error: str): csgStoreIdentityStageMoveResult =
    var out: csgStoreIdentityStageMoveResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreIdentityStageBindingValue(
        ownerId: int32,
        generation: int32,
        state: int32,
        handle: os.AtomicTree,
        stageNonce: layout.FixedBytes32,
        receiptNonce: layout.FixedBytes32,
        lineageBinding: layout.FixedBytes32,
        beforeStoreIdentity: layout.FixedBytes32,
        recordCid: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(256)
    csgStoreIdentityAppendText(
        preimage, csgStoreIdentityStageBindingDomain)
    csgStoreIdentityAppendU32(preimage, ownerId)
    csgStoreIdentityAppendU32(preimage, generation)
    csgStoreIdentityAppendU32(preimage, state)
    csgStoreIdentityAppendU32(
        preimage, int32(uint32(handle & uint64(4294967295))))
    csgStoreIdentityAppendU32(
        preimage,
        int32(uint32((handle >> uint64(32)) & uint64(4294967295))))
    layout.ByteBufAppendFixed32(preimage, stageNonce)
    layout.ByteBufAppendFixed32(preimage, receiptNonce)
    layout.ByteBufAppendFixed32(preimage, lineageBinding)
    layout.ByteBufAppendFixed32(preimage, beforeStoreIdentity)
    layout.ByteBufAppendFixed32(preimage, recordCid)
    let binding = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return binding

fn csgStoreIdentityMoveStage(
        ownerId: int32,
        generation: int32,
        stageNonce: layout.FixedBytes32,
        requiredState: int32,
        nextState: int32,
        nextStageNonce: layout.FixedBytes32,
        nextReceiptNonce: layout.FixedBytes32,
        newLineageBinding: layout.FixedBytes32):
        csgStoreIdentityStageMoveResult =
    if !((requiredState == csgStoreIdentityAuthorityLiveOpen &&
          nextState == csgStoreIdentityAuthorityPlanningOwned) ||
         (requiredState == csgStoreIdentityAuthorityPlanningOwned &&
          nextState == csgStoreIdentityAuthorityPreparedOwned) ||
         (requiredState == csgStoreIdentityAuthorityPreparedOwned &&
          nextState == csgStoreIdentityAuthoritySessionOwned)):
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_transition_invalid")
    if layout.FixedBytes32Equal(
           nextStageNonce, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           nextReceiptNonce, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(nextStageNonce, nextReceiptNonce):
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_nonce_invalid")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           ownerId,
           generation,
           stageNonce,
           requiredState):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_authority_invalid")
    let row = ownerId - 1
    let storedReceiptNonce = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.receiptNonces, row)
    let storedLineageBinding = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.lineageBindings, row)
    if layout.FixedBytes32Equal(nextStageNonce, stageNonce) ||
       layout.FixedBytes32Equal(nextStageNonce, storedReceiptNonce) ||
       layout.FixedBytes32Equal(nextReceiptNonce, stageNonce) ||
       layout.FixedBytes32Equal(nextReceiptNonce, storedReceiptNonce) ||
       (!layout.FixedBytes32Equal(
            storedLineageBinding, layout.FixedBytes32()) &&
        (layout.FixedBytes32Equal(
             nextStageNonce, storedLineageBinding) ||
         layout.FixedBytes32Equal(
             nextReceiptNonce, storedLineageBinding))):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_nonce_not_rotated")
    if generation >= 2147483646:
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_generation_exhausted")
    var nextLineageBinding = storedLineageBinding
    if requiredState == csgStoreIdentityAuthorityLiveOpen:
        if layout.FixedBytes32Equal(
               newLineageBinding, layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(newLineageBinding, nextStageNonce) ||
           layout.FixedBytes32Equal(newLineageBinding, nextReceiptNonce) ||
           layout.FixedBytes32Equal(newLineageBinding, stageNonce) ||
           layout.FixedBytes32Equal(
               newLineageBinding, storedReceiptNonce) ||
           !layout.FixedBytes32Equal(
               storedLineageBinding, layout.FixedBytes32()):
            csgStoreIdentityAuthorityUnlock()
            return csgStoreIdentityStageMoveFail(
                "merkle_store_identity_lineage_binding_invalid")
        nextLineageBinding = newLineageBinding
    elif !layout.FixedBytes32Equal(
             newLineageBinding, layout.FixedBytes32()) ||
         layout.FixedBytes32Equal(
             storedLineageBinding, layout.FixedBytes32()):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_lineage_binding_drift")
    let nextGeneration = generation + 1
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    let beforeStoreIdentity = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.beforeStoreIdentities, row)
    let recordCid = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.recordCids, row)
    csgStoreIdentityAuthorityUnlock()
    let nextBinding = csgStoreIdentityStageBindingValue(
        ownerId,
        nextGeneration,
        nextState,
        handle,
        nextStageNonce,
        nextReceiptNonce,
        nextLineageBinding,
        beforeStoreIdentity,
        recordCid)
    if layout.FixedBytes32Equal(
           nextBinding, layout.FixedBytes32()):
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_binding_invalid")
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           ownerId,
           generation,
           stageNonce,
           requiredState) ||
       csgStoreIdentityAuthorityHandleAt(row) != handle ||
       !layout.FixedBytes32Equal(
           csgStoreIdentityAuthorityFixed32At(
               csgStoreIdentityAuthorityRegistry.receiptNonces, row),
           storedReceiptNonce) ||
       !layout.FixedBytes32Equal(
           csgStoreIdentityAuthorityFixed32At(
               csgStoreIdentityAuthorityRegistry.beforeStoreIdentities,
               row),
           beforeStoreIdentity) ||
       !layout.FixedBytes32Equal(
           csgStoreIdentityAuthorityFixed32At(
               csgStoreIdentityAuthorityRegistry.recordCids, row),
           recordCid) ||
       !layout.FixedBytes32Equal(
           csgStoreIdentityAuthorityFixed32At(
               csgStoreIdentityAuthorityRegistry.lineageBindings, row),
           storedLineageBinding):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityStageMoveFail(
            "merkle_store_identity_stage_transition_drift")
    if requiredState == csgStoreIdentityAuthorityLiveOpen:
        for i in 0..<csgStoreIdentityAuthoritySlotCount:
            if i != row && layout.FixedBytes32Equal(
                   csgStoreIdentityAuthorityFixed32At(
                       csgStoreIdentityAuthorityRegistry.lineageBindings,
                       i),
                   nextLineageBinding):
                csgStoreIdentityAuthorityUnlock()
                return csgStoreIdentityStageMoveFail(
                    "merkle_store_identity_lineage_binding_collision")
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.generations,
        row,
        nextGeneration)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.leaseNonces,
        row,
        nextStageNonce)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.receiptNonces,
        row,
        nextReceiptNonce)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.stageBindings,
        row,
        nextBinding)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.lineageBindings,
        row,
        nextLineageBinding)
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.states,
        row,
        nextState)
    csgStoreIdentityAuthorityUnlock()
    var out: csgStoreIdentityStageMoveResult
    out.ok = true
    out.ownerId = ownerId
    out.generation = nextGeneration
    out.stageNonce = nextStageNonce
    out.receiptNonce = nextReceiptNonce
    return out

fn csgStoreIdentityCloseStage(
        ownerId: int32,
        generation: int32,
        stageNonce: layout.FixedBytes32,
        requiredState: int32,
        terminalState: int32): str =
    if terminalState != csgStoreIdentityAuthorityClosed &&
       terminalState != csgStoreIdentityAuthorityPoisoned:
        return "merkle_store_identity_terminal_state_invalid"
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           ownerId,
           generation,
           stageNonce,
           requiredState):
        csgStoreIdentityAuthorityUnlock()
        return "merkle_store_identity_stage_close_invalid"
    let row = ownerId - 1
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.states,
        row,
        terminalState)
    csgStoreIdentityAuthoritySetHandle(row, uint64(0))
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.leaseNonces,
        row,
        layout.FixedBytes32())
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.receiptNonces,
        row,
        layout.FixedBytes32())
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.stageBindings,
        row,
        layout.FixedBytes32())
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.lineageBindings,
        row,
        layout.FixedBytes32())
    csgStoreIdentityAuthorityUnlock()
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle store identity: stage close failed")
    return ""

@borrows
fn csgStoreIdentityStageTerminalFail(
        error: str): CsgCoreMerkleStoreStageTerminalResult =
    var out: CsgCoreMerkleStoreStageTerminalResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreIdentityTerminalByLineageBinding(
        lineageBinding: layout.FixedBytes32,
        terminalState: int32): CsgCoreMerkleStoreStageTerminalResult =
    if layout.FixedBytes32Equal(
           lineageBinding, layout.FixedBytes32()):
        return csgStoreIdentityStageTerminalFail(
            "merkle_store_identity_lineage_binding_invalid")
    if terminalState != csgStoreIdentityAuthorityClosed &&
       terminalState != csgStoreIdentityAuthorityPoisoned:
        return csgStoreIdentityStageTerminalFail(
            "merkle_store_identity_terminal_state_invalid")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid():
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityStageTerminalFail(
            "merkle_store_identity_registry_invalid")
    var row: int32 = -1
    for i in 0..<csgStoreIdentityAuthoritySlotCount:
        let state = csgStoreIdentityAuthorityI32At(
            csgStoreIdentityAuthorityRegistry.states, i)
        if (state == csgStoreIdentityAuthorityPlanningOwned ||
            state == csgStoreIdentityAuthorityPreparedOwned ||
            state == csgStoreIdentityAuthoritySessionOwned) &&
           layout.FixedBytes32Equal(
               csgStoreIdentityAuthorityFixed32At(
                   csgStoreIdentityAuthorityRegistry.lineageBindings, i),
               lineageBinding):
            if row >= 0:
                csgStoreIdentityAuthorityUnlock()
                panic("merkle store identity: lineage binding collision")
            row = i
    if row < 0:
        csgStoreIdentityAuthorityUnlock()
        var terminal: CsgCoreMerkleStoreStageTerminalResult
        terminal.ok = true
        terminal.terminal = true
        return terminal
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    if handle == uint64(0):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store identity: lineage handle missing")
    csgStoreIdentityAuthoritySetI32(
        csgStoreIdentityAuthorityRegistry.states, row, terminalState)
    csgStoreIdentityAuthoritySetHandle(row, uint64(0))
    let zero = layout.FixedBytes32()
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.leaseNonces, row, zero)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.receiptNonces, row, zero)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.stageBindings, row, zero)
    csgStoreIdentityAuthoritySetFixed32(
        csgStoreIdentityAuthorityRegistry.lineageBindings, row, zero)
    csgStoreIdentityAuthorityUnlock()
    let closed = os.AtomicTreeClose(handle)
    if result.IsErr(closed):
        panic("merkle store identity: lineage terminal close failed")
    var out: CsgCoreMerkleStoreStageTerminalResult
    out.ok = true
    out.won = true
    out.terminal = true
    return out

@borrows
fn csgStoreIdentityReceiptRowMatches(
        ownerId: int32,
        generation: int32,
        receiptNonce: layout.FixedBytes32,
        requiredState: int32): bool =
    if ownerId <= 0 ||
       ownerId > csgStoreIdentityAuthoritySlotCount ||
       generation <= 0 ||
       layout.FixedBytes32Equal(
           receiptNonce, layout.FixedBytes32()):
        return false
    let row = ownerId - 1
    return csgStoreIdentityAuthorityI32At(
               csgStoreIdentityAuthorityRegistry.states, row) ==
               requiredState &&
        csgStoreIdentityAuthorityI32At(
            csgStoreIdentityAuthorityRegistry.generations, row) ==
            generation &&
        csgStoreIdentityAuthorityHandleAt(row) != uint64(0) &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.receiptNonces, row),
            receiptNonce)

@borrows
fn csgStoreIdentityReceiptFail(
        error: str): CsgCoreMerkleStoreIdentityReceipt =
    var out: CsgCoreMerkleStoreIdentityReceipt
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreIdentityLiveReceipt(
        ownerId: int32,
        generation: int32,
        receiptNonce: layout.FixedBytes32,
        requiredState: int32):
        CsgCoreMerkleStoreIdentityReceipt =
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       ownerId <= 0 ||
       ownerId > csgStoreIdentityAuthoritySlotCount:
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_receipt_authority_invalid")
    let row = ownerId - 1
    let activeState = csgStoreIdentityAuthorityI32At(
        csgStoreIdentityAuthorityRegistry.states, row)
    if (requiredState != csgStoreIdentityAuthorityAnyOwned &&
        activeState != requiredState) ||
       !csgStoreIdentityAuthorityStateReceiptable(activeState) ||
       !csgStoreIdentityReceiptRowMatches(
           ownerId,
           generation,
           receiptNonce,
           activeState):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_receipt_authority_invalid")
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    let seed = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.storeInstanceSeeds, row)
    let storedLayoutCid = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.storeLayoutCids, row)
    let storedIdentity = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.beforeStoreIdentities, row)
    let storedRecordCid = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.recordCids, row)
    csgStoreIdentityAuthorityUnlock()
    var expected = csgStoreIdentityIssueSeed(seed)
    if expected.formatId.len == 0:
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_path_reissue_failed")
    var encoded = CsgCoreMerkleStoreIdentityRecordEncode(expected)
    if !encoded.ok:
        return csgStoreIdentityReceiptFail(encoded.error)
    expected = encoded.record
    rawbytes.BytesFree(encoded.bytes)
    var expectedLayoutCid: layout.FixedBytes32
    var expectedIdentity: layout.FixedBytes32
    var expectedRecordCid: layout.FixedBytes32
    if !csgStoreIdentityCidTextInto(
           expected.storeLayoutCid, expectedLayoutCid) ||
       !csgStoreIdentityCidTextInto(
           expected.beforeStoreIdentity, expectedIdentity) ||
       !csgStoreIdentityCidTextInto(
           expected.recordCid, expectedRecordCid) ||
       !layout.FixedBytes32Equal(
           expectedLayoutCid, storedLayoutCid) ||
       !layout.FixedBytes32Equal(
           expectedIdentity, storedIdentity) ||
       !layout.FixedBytes32Equal(
           expectedRecordCid, storedRecordCid):
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_path_registry_drift")
    let live = csgStoreIdentityReadOpened(handle)
    if !live.ok ||
       live.record.storeLayoutCid != expected.storeLayoutCid ||
       live.record.beforeStoreIdentity !=
           expected.beforeStoreIdentity ||
       live.record.recordCid != expected.recordCid ||
       !layout.FixedBytes32Equal(
           live.record.storeInstanceSeed,
           expected.storeInstanceSeed):
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_path_live_join_failed")
    # The OS verification runs without the registry lock. Rejoin the same
    # capability generation and payload before issuing the trusted receipt.
    csgStoreIdentityAuthorityLock()
    let joined =
        csgStoreIdentityAuthorityRegistryShapeValid() &&
        csgStoreIdentityReceiptRowMatches(
            ownerId,
            generation,
            receiptNonce,
            activeState) &&
        csgStoreIdentityAuthorityHandleAt(row) == handle &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.storeInstanceSeeds, row),
            seed) &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.storeLayoutCids, row),
            storedLayoutCid) &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.beforeStoreIdentities, row),
            storedIdentity) &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.recordCids, row),
            storedRecordCid)
    csgStoreIdentityAuthorityUnlock()
    if !joined:
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_path_linearization_failed")
    return csgStoreIdentityReceiptFromRecord(
        ownerId,
        generation,
        receiptNonce,
        live.record)

@borrows
fn csgStoreIdentityStageIdentityReceipt(
        ownerId: int32,
        generation: int32,
        stageNonce: layout.FixedBytes32,
        requiredState: int32):
        CsgCoreMerkleStoreIdentityReceipt =
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           ownerId,
           generation,
           stageNonce,
           requiredState):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreIdentityReceiptFail(
            "merkle_store_identity_path_authority_invalid")
    let row = ownerId - 1
    let receiptNonce = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.receiptNonces, row)
    csgStoreIdentityAuthorityUnlock()
    return csgStoreIdentityLiveReceipt(
        ownerId,
        generation,
        receiptNonce,
        requiredState)

@borrows
fn csgStoreIdentityStageBinding(
        ownerId: int32,
        generation: int32,
        stageNonce: layout.FixedBytes32,
        requiredState: int32): layout.FixedBytes32 =
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           ownerId,
           generation,
           stageNonce,
           requiredState):
        csgStoreIdentityAuthorityUnlock()
        return layout.FixedBytes32()
    let row = ownerId - 1
    let binding = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.stageBindings, row)
    csgStoreIdentityAuthorityUnlock()
    if layout.FixedBytes32Equal(binding, layout.FixedBytes32()):
        return layout.FixedBytes32()
    return binding

@borrows
fn csgStoreIdentityLineageBinding(
        ownerId: int32,
        generation: int32,
        stageNonce: layout.FixedBytes32,
        requiredState: int32): layout.FixedBytes32 =
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           ownerId,
           generation,
           stageNonce,
           requiredState):
        csgStoreIdentityAuthorityUnlock()
        return layout.FixedBytes32()
    let row = ownerId - 1
    let binding = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.lineageBindings, row)
    csgStoreIdentityAuthorityUnlock()
    if layout.FixedBytes32Equal(binding, layout.FixedBytes32()):
        return layout.FixedBytes32()
    return binding

@borrows
fn CsgCoreMerkleStorePathAuthorityIdentityReceipt(
        authority: CsgCoreMerkleStorePathAuthority):
        CsgCoreMerkleStoreIdentityReceipt =
    return csgStoreIdentityStageIdentityReceipt(
        authority.ownerId,
        authority.generation,
        authority.leaseNonce,
        csgStoreIdentityAuthorityLiveOpen)

@borrows
fn CsgCoreMerkleStorePathAuthorityIsValid(
        authority: CsgCoreMerkleStorePathAuthority): bool =
    let receipt =
        CsgCoreMerkleStorePathAuthorityIdentityReceipt(authority)
    return receipt.ok

fn CsgCoreMerkleStorePathAuthorityClose(
        authority: var CsgCoreMerkleStorePathAuthority): str =
    let consumed = authority
    authority = CsgCoreMerkleStorePathAuthority()
    return csgStoreIdentityCloseStage(
        consumed.ownerId,
        consumed.generation,
        consumed.leaseNonce,
        csgStoreIdentityAuthorityLiveOpen,
        csgStoreIdentityAuthorityClosed)

@borrows
fn csgStoreIdentityPlanningPathFail(
        error: str): CsgCoreMerkleStorePlanningPathAuthorityResult =
    var out: CsgCoreMerkleStorePlanningPathAuthorityResult
    out.error = strings.CloneStr(error)
    return out

fn CsgCoreMerkleStorePathAuthorityMoveToPlanning(
        authority: var CsgCoreMerkleStorePathAuthority):
        CsgCoreMerkleStorePlanningPathAuthorityResult =
    let consumed = authority
    authority = CsgCoreMerkleStorePathAuthority()
    var nextStageNonce: layout.FixedBytes32
    var nextReceiptNonce: layout.FixedBytes32
    var lineageBinding: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(nextStageNonce) ||
       !csgStoreIdentityAuthorityNonce(nextReceiptNonce) ||
       !csgStoreIdentityAuthorityNonce(lineageBinding) ||
       layout.FixedBytes32Equal(nextStageNonce, nextReceiptNonce) ||
       layout.FixedBytes32Equal(nextStageNonce, lineageBinding) ||
       layout.FixedBytes32Equal(nextReceiptNonce, lineageBinding):
        let ignoredClose = csgStoreIdentityCloseStage(
            consumed.ownerId,
            consumed.generation,
            consumed.leaseNonce,
            csgStoreIdentityAuthorityLiveOpen,
            csgStoreIdentityAuthorityClosed)
        return csgStoreIdentityPlanningPathFail(
            "merkle_store_identity_planning_nonce_unavailable")
    let moved = csgStoreIdentityMoveStage(
        consumed.ownerId,
        consumed.generation,
        consumed.leaseNonce,
        csgStoreIdentityAuthorityLiveOpen,
        csgStoreIdentityAuthorityPlanningOwned,
        nextStageNonce,
        nextReceiptNonce,
        lineageBinding)
    if !moved.ok:
        let ignoredClose = csgStoreIdentityCloseStage(
            consumed.ownerId,
            consumed.generation,
            consumed.leaseNonce,
            csgStoreIdentityAuthorityLiveOpen,
            csgStoreIdentityAuthorityClosed)
        return csgStoreIdentityPlanningPathFail(moved.error)
    var planning: CsgCoreMerkleStorePlanningPathAuthority
    planning.ownerId = moved.ownerId
    planning.generation = moved.generation
    planning.stageNonce = moved.stageNonce
    let receipt = csgStoreIdentityLiveReceipt(
        moved.ownerId,
        moved.generation,
        moved.receiptNonce,
        csgStoreIdentityAuthorityPlanningOwned)
    if !receipt.ok:
        let cleanupError = csgStoreIdentityCloseStage(
            planning.ownerId,
            planning.generation,
            planning.stageNonce,
            csgStoreIdentityAuthorityPlanningOwned,
            csgStoreIdentityAuthorityPoisoned)
        if cleanupError.len > 0:
            panic("merkle store identity: planning transition cleanup failed")
        return csgStoreIdentityPlanningPathFail(receipt.error)
    var out: CsgCoreMerkleStorePlanningPathAuthorityResult
    out.ok = true
    out.authority = planning
    out.identityReceipt = receipt
    return out

