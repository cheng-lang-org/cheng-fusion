fn CsgCoreMerkleStorePlanningPathAuthorityMoveToPrepared(
        authority: var CsgCoreMerkleStorePlanningPathAuthority):
        CsgCoreMerkleStorePreparedPathAuthorityResult =
    let consumed = authority
    authority = CsgCoreMerkleStorePlanningPathAuthority()
    var nextStageNonce: layout.FixedBytes32
    var nextReceiptNonce: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(nextStageNonce) ||
       !csgStoreIdentityAuthorityNonce(nextReceiptNonce) ||
       layout.FixedBytes32Equal(nextStageNonce, nextReceiptNonce):
        let ignoredClose = csgStoreIdentityCloseStage(
            consumed.ownerId,
            consumed.generation,
            consumed.stageNonce,
            csgStoreIdentityAuthorityPlanningOwned,
            csgStoreIdentityAuthorityClosed)
        return csgStoreIdentityPreparedPathFail(
            "merkle_store_identity_prepare_nonce_unavailable")
    let moved = csgStoreIdentityMoveStage(
        consumed.ownerId,
        consumed.generation,
        consumed.stageNonce,
        csgStoreIdentityAuthorityPlanningOwned,
        csgStoreIdentityAuthorityPreparedOwned,
        nextStageNonce,
        nextReceiptNonce,
        layout.FixedBytes32())
    if !moved.ok:
        let ignoredClose = csgStoreIdentityCloseStage(
            consumed.ownerId,
            consumed.generation,
            consumed.stageNonce,
            csgStoreIdentityAuthorityPlanningOwned,
            csgStoreIdentityAuthorityClosed)
        return csgStoreIdentityPreparedPathFail(moved.error)
    var prepared: CsgCoreMerkleStorePreparedPathAuthority
    prepared.ownerId = moved.ownerId
    prepared.generation = moved.generation
    prepared.stageNonce = moved.stageNonce
    let receipt = csgStoreIdentityLiveReceipt(
        moved.ownerId,
        moved.generation,
        moved.receiptNonce,
        csgStoreIdentityAuthorityPreparedOwned)
    if !receipt.ok:
        let cleanupError = csgStoreIdentityCloseStage(
            prepared.ownerId,
            prepared.generation,
            prepared.stageNonce,
            csgStoreIdentityAuthorityPreparedOwned,
            csgStoreIdentityAuthorityPoisoned)
        if cleanupError.len > 0:
            panic("merkle store identity: planning prepare cleanup failed")
        return csgStoreIdentityPreparedPathFail(receipt.error)
    var out: CsgCoreMerkleStorePreparedPathAuthorityResult
    out.ok = true
    out.authority = prepared
    out.identityReceipt = receipt
    return out

