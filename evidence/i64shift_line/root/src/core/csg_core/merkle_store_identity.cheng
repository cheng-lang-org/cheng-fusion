@borrows
fn csgStoreIdentityCanonicalCategory(
        canonicalCategory: str): bool =
    let categories = CsgCoreMerkleStoreOrderedCanonicalCategoryNames()
    for i in 0..<categories.len:
        if categories[i] == canonicalCategory:
            return true
    return false

@borrows
fn CsgCoreMerkleStorePlanningPathAuthorityOpenObjectVerified(
        authority: CsgCoreMerkleStorePlanningPathAuthority,
        canonicalCategory: str,
        finalName: str): result.Result[os.AtomicTree] =
    if !csgStoreIdentityCanonicalCategory(canonicalCategory):
        return result.Err[os.AtomicTree](
            "merkle_store_identity_object_category_invalid")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           authority.ownerId,
           authority.generation,
           authority.stageNonce,
           csgStoreIdentityAuthorityPlanningOwned):
        csgStoreIdentityAuthorityUnlock()
        return result.Err[os.AtomicTree](
            "merkle_store_identity_planning_object_authority_invalid")
    let row = authority.ownerId - 1
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
        handle, canonicalCategory, finalName)
    let joined = csgStoreIdentityStageRowMatches(
        authority.ownerId,
        authority.generation,
        authority.stageNonce,
        csgStoreIdentityAuthorityPlanningOwned) &&
        csgStoreIdentityAuthorityHandleAt(row) == handle
    csgStoreIdentityAuthorityUnlock()
    if !joined:
        if result.IsOk(opened):
            let child = result.Value(opened)
            let closed = os.AtomicTreeClose(child)
            if result.IsErr(closed):
                panic("merkle store identity: planning object drift close failed")
        panic("merkle store identity: planning object authority drift")
    return opened

@borrows
fn CsgCoreMerkleStorePlanningPathAuthoritySuccessorExists(
        authority: CsgCoreMerkleStorePlanningPathAuthority,
        predecessorCid: str): result.Result[bool] =
    let successorName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
            predecessorCid)
    if successorName.len == 0:
        return result.Err[bool](
            "merkle_store_identity_successor_predecessor_invalid")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           authority.ownerId,
           authority.generation,
           authority.stageNonce,
           csgStoreIdentityAuthorityPlanningOwned):
        csgStoreIdentityAuthorityUnlock()
        return result.Err[bool](
            "merkle_store_identity_planning_successor_authority_invalid")
    let row = authority.ownerId - 1
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    let exists = os.AtomicTreeVerifiedRootChildExists(
        handle,
        merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
        successorName)
    let joined = csgStoreIdentityStageRowMatches(
        authority.ownerId,
        authority.generation,
        authority.stageNonce,
        csgStoreIdentityAuthorityPlanningOwned) &&
        csgStoreIdentityAuthorityHandleAt(row) == handle
    csgStoreIdentityAuthorityUnlock()
    if !joined:
        panic("merkle store identity: planning successor authority drift")
    return exists

@borrows
fn CsgCoreMerkleStoreSessionPathAuthorityBeginObjectTransaction(
        authority: CsgCoreMerkleStoreSessionPathAuthority,
        canonicalCategory: str,
        stagingName: str,
        finalName: str): result.Result[os.AtomicTree] =
    if !csgStoreIdentityCanonicalCategory(canonicalCategory):
        return result.Err[os.AtomicTree](
            "merkle_store_identity_object_category_invalid")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           authority.ownerId,
           authority.generation,
           authority.stageNonce,
           csgStoreIdentityAuthoritySessionOwned):
        csgStoreIdentityAuthorityUnlock()
        return result.Err[os.AtomicTree](
            "merkle_store_identity_session_object_authority_invalid")
    let row = authority.ownerId - 1
    let handle = csgStoreIdentityAuthorityHandleAt(row)
    let begun = os.AtomicTreeBeginChildFromVerifiedRoot(
        handle,
        canonicalCategory,
        stagingName,
        finalName)
    let joined = csgStoreIdentityStageRowMatches(
        authority.ownerId,
        authority.generation,
        authority.stageNonce,
        csgStoreIdentityAuthoritySessionOwned) &&
        csgStoreIdentityAuthorityHandleAt(row) == handle
    csgStoreIdentityAuthorityUnlock()
    if !joined:
        if result.IsOk(begun):
            let transaction = result.Value(begun)
            let aborted = os.AtomicTreeAbort(transaction)
            if result.IsErr(aborted):
                panic("merkle store identity: object begin rejoin abort failed")
        panic("merkle store identity: object begin authority drift")
    return begun

