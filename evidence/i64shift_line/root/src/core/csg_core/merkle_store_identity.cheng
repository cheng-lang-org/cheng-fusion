fn CsgCoreMerkleStorePreparedPathAuthorityMoveToSession(
        authority: var CsgCoreMerkleStorePreparedPathAuthority):
        CsgCoreMerkleStoreSessionPathAuthorityResult =
    let consumed = authority
    authority = CsgCoreMerkleStorePreparedPathAuthority()
    var nextStageNonce: layout.FixedBytes32
    var nextReceiptNonce: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(nextStageNonce) ||
       !csgStoreIdentityAuthorityNonce(nextReceiptNonce) ||
       layout.FixedBytes32Equal(nextStageNonce, nextReceiptNonce):
        let ignoredClose = csgStoreIdentityCloseStage(
            consumed.ownerId,
            consumed.generation,
            consumed.stageNonce,
            csgStoreIdentityAuthorityPreparedOwned,
            csgStoreIdentityAuthorityClosed)
        return csgStoreIdentitySessionPathFail(
            "merkle_store_identity_session_nonce_unavailable")
    let moved = csgStoreIdentityMoveStage(
        consumed.ownerId,
        consumed.generation,
        consumed.stageNonce,
        csgStoreIdentityAuthorityPreparedOwned,
        csgStoreIdentityAuthoritySessionOwned,
        nextStageNonce,
        nextReceiptNonce,
        layout.FixedBytes32())
    if !moved.ok:
        let ignoredClose = csgStoreIdentityCloseStage(
            consumed.ownerId,
            consumed.generation,
            consumed.stageNonce,
            csgStoreIdentityAuthorityPreparedOwned,
            csgStoreIdentityAuthorityClosed)
        return csgStoreIdentitySessionPathFail(moved.error)
    var session: CsgCoreMerkleStoreSessionPathAuthority
    session.ownerId = moved.ownerId
    session.generation = moved.generation
    session.stageNonce = moved.stageNonce
    let receipt = csgStoreIdentityLiveReceipt(
        moved.ownerId,
        moved.generation,
        moved.receiptNonce,
        csgStoreIdentityAuthoritySessionOwned)
    if !receipt.ok:
        let cleanupError = csgStoreIdentityCloseStage(
            session.ownerId,
            session.generation,
            session.stageNonce,
            csgStoreIdentityAuthoritySessionOwned,
            csgStoreIdentityAuthorityPoisoned)
        if cleanupError.len > 0:
            panic("merkle store identity: session transition cleanup failed")
        return csgStoreIdentitySessionPathFail(receipt.error)
    var out: CsgCoreMerkleStoreSessionPathAuthorityResult
    out.ok = true
    out.authority = session
    out.identityReceipt = receipt
    return out

