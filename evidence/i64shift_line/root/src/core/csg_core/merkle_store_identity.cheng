@borrows
fn csgStoreBeforeSnapshotMaterialFail(
        error: str): csgStoreBeforeSnapshotMaterial =
    var out: csgStoreBeforeSnapshotMaterial
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreBeforeSnapshotReadChildFile(
        root: os.AtomicTree,
        canonicalCategory: str,
        finalName: str,
        fixedFileName: str): result.Result[rawbytes.Bytes] =
    let opened = os.AtomicTreeOpenChildFromVerifiedRoot(
        root,
        canonicalCategory,
        finalName)
    if result.IsErr(opened):
        return result.Err[rawbytes.Bytes](result.Error(opened))
    let child = result.Value(opened)
    var noDirectories: str[]
    let exact = os.AtomicTreeVerifyExact(
        child,
        noDirectories,
        [strings.CloneStr(fixedFileName)])
    if result.IsErr(exact):
        let closed = os.AtomicTreeClose(child)
        if result.IsErr(closed):
            panic("merkle store before snapshot: invalid child close failed")
        return result.Err[rawbytes.Bytes](
            "merkle_store_before_snapshot_child_shape_invalid")
    let read = os.AtomicTreeReadStable(child, fixedFileName)
    let closed = os.AtomicTreeClose(child)
    if result.IsErr(closed):
        panic("merkle store before snapshot: child close failed")
    if result.IsErr(read):
        return result.Err[rawbytes.Bytes](result.Error(read))
    return result.Ok[rawbytes.Bytes](result.Value(read))

@borrows
fn csgStoreBeforeSnapshotReadCurrent(
        root: os.AtomicTree): csgStoreBeforeSnapshotMaterial =
    if root == uint64(0):
        return csgStoreBeforeSnapshotMaterialFail(
            "merkle_store_before_snapshot_root_invalid")
    let successorCategory =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName()
    let successorFile =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorFileName()
    var predecessorCid: str = "none"
    var expectedGeneration: int64
    var found: bool
    var latest: merkle_store_codec.CsgCoreMerkleStoreHeadIdentity
    var headRawDigest: layout.FixedBytes32
    var headRawLength: int32
    var scanning: bool = true
    while scanning:
        let successorName =
            merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
                predecessorCid)
        if successorName.len == 0:
            return csgStoreBeforeSnapshotMaterialFail(
                "merkle_store_before_snapshot_successor_name_invalid")
        let exists = os.AtomicTreeVerifiedRootChildExists(
            root,
            successorCategory,
            successorName)
        if result.IsErr(exists):
            return csgStoreBeforeSnapshotMaterialFail(
                result.Error(exists))
        if !result.Value(exists):
            scanning = false
            continue
        if expectedGeneration >
           merkle_store_codec.CsgCoreMerkleStoreMaxGeneration():
            return csgStoreBeforeSnapshotMaterialFail(
                "merkle_store_before_snapshot_generation_exhausted")
        let read = csgStoreBeforeSnapshotReadChildFile(
            root,
            successorCategory,
            successorName,
            successorFile)
        if result.IsErr(read):
            return csgStoreBeforeSnapshotMaterialFail(
                result.Error(read))
        var bytes = result.Value(read)
        let decoded =
            merkle_store_codec.CsgCoreMerkleStoreHeadDecode(bytes)
        if !decoded.ok ||
           decoded.head.generation != expectedGeneration ||
           decoded.head.previousHeadCid != predecessorCid ||
           decoded.head.headCid == predecessorCid:
            rawbytes.BytesFree(bytes)
            return csgStoreBeforeSnapshotMaterialFail(
                "merkle_store_before_snapshot_head_chain_invalid")
        headRawLength = rawbytes.BytesLen(bytes)
        if headRawLength <= 0:
            rawbytes.BytesFree(bytes)
            return csgStoreBeforeSnapshotMaterialFail(
                "merkle_store_before_snapshot_head_empty")
        headRawDigest = hash256.Sha256Fixed(
            layout.ByteSpanFromBytes(bytes))
        rawbytes.BytesFree(bytes)
        latest = decoded.head
        predecessorCid = strings.CloneStr(decoded.head.headCid)
        expectedGeneration = expectedGeneration + int64(1)
        found = true
    if !found:
        return csgStoreBeforeSnapshotMaterialFail(
            "merkle_store_before_snapshot_head_absent")
    let manifestName =
        merkle_store_codec.CsgCoreMerkleStoreCidName(
            latest.manifestCid)
    if manifestName.len == 0:
        return csgStoreBeforeSnapshotMaterialFail(
            "merkle_store_before_snapshot_manifest_name_invalid")
    let manifestRead = csgStoreBeforeSnapshotReadChildFile(
        root,
        merkle_store_codec.CsgCoreMerkleStoreManifestCategoryName(),
        manifestName,
        merkle_store_codec.CsgCoreMerkleStoreObjectFileName())
    if result.IsErr(manifestRead):
        return csgStoreBeforeSnapshotMaterialFail(
            result.Error(manifestRead))
    var manifestBytes = result.Value(manifestRead)
    let decodedManifest =
        merkle_manifest.CsgCoreMerkleManifestDecode(manifestBytes)
    if !decodedManifest.ok ||
       decodedManifest.cid != latest.manifestCid ||
       !decodedManifest.manifest.complete:
        rawbytes.BytesFree(manifestBytes)
        return csgStoreBeforeSnapshotMaterialFail(
            "merkle_store_before_snapshot_manifest_identity_invalid")
    var csgcDirectoryCid: layout.FixedBytes32
    var csgcObjectCid: layout.FixedBytes32
    var factsRoot: layout.FixedBytes32
    var dagRootCid: layout.FixedBytes32
    var profileSetCid: layout.FixedBytes32
    var schemaCid: layout.FixedBytes32
    if decodedManifest.manifest.csgcByteCount < 64 ||
       decodedManifest.manifest.factCount < 0 ||
       decodedManifest.manifest.nodeCount < 0 ||
       !csgStoreIdentityCidTextInto(
           decodedManifest.manifest.csgcDirectoryCid,
           csgcDirectoryCid) ||
       !csgStoreIdentityCidTextInto(
           decodedManifest.manifest.csgcObjectCid,
           csgcObjectCid) ||
       !csgStoreIdentityCidTextInto(
           decodedManifest.manifest.factsRoot,
           factsRoot) ||
       !csgStoreIdentityCidTextInto(
           decodedManifest.manifest.dagRootCid,
           dagRootCid) ||
       !csgStoreIdentityCidTextInto(
           decodedManifest.manifest.profileSetCid,
           profileSetCid) ||
       !csgStoreIdentityCidTextInto(
           decodedManifest.manifest.schemaCid,
           schemaCid):
        rawbytes.BytesFree(manifestBytes)
        return csgStoreBeforeSnapshotMaterialFail(
            "merkle_store_before_snapshot_manifest_projection_invalid")
    let manifestObjectLength = rawbytes.BytesLen(manifestBytes)
    if manifestObjectLength <= 0:
        rawbytes.BytesFree(manifestBytes)
        return csgStoreBeforeSnapshotMaterialFail(
            "merkle_store_before_snapshot_manifest_empty")
    let manifestObjectDigest = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(manifestBytes))
    rawbytes.BytesFree(manifestBytes)
    var out: csgStoreBeforeSnapshotMaterial
    out.ok = true
    out.head = latest
    out.csgcByteCount = decodedManifest.manifest.csgcByteCount
    out.factCount = decodedManifest.manifest.factCount
    out.nodeCount = decodedManifest.manifest.nodeCount
    out.csgcDirectoryCid = csgcDirectoryCid
    out.csgcObjectCid = csgcObjectCid
    out.factsRoot = factsRoot
    out.dagRootCid = dagRootCid
    out.profileSetCid = profileSetCid
    out.schemaCid = schemaCid
    out.headRawDigest = headRawDigest
    out.headRawLength = headRawLength
    out.manifestObjectDigest = manifestObjectDigest
    out.manifestObjectLength = manifestObjectLength
    return out

fn csgStoreBeforeSnapshotBinding(
        sourceLineageBinding: layout.FixedBytes32,
        beforeStoreIdentity: layout.FixedBytes32,
        headCid: layout.FixedBytes32,
        manifestCid: layout.FixedBytes32,
        storeGeneration: int64,
        csgcByteCount: int32,
        factCount: int32,
        nodeCount: int32,
        csgcDirectoryCid: layout.FixedBytes32,
        csgcObjectCid: layout.FixedBytes32,
        factsRoot: layout.FixedBytes32,
        dagRootCid: layout.FixedBytes32,
        profileSetCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        headRawDigest: layout.FixedBytes32,
        headRawLength: int32,
        manifestObjectDigest: layout.FixedBytes32,
        manifestObjectLength: int32,
        issueNonce: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(640)
    csgStoreIdentityAppendText(
        preimage,
        csgStoreBeforeSnapshotBindingDomain)
    layout.ByteBufAppendFixed32(preimage, sourceLineageBinding)
    layout.ByteBufAppendFixed32(preimage, beforeStoreIdentity)
    layout.ByteBufAppendFixed32(preimage, headCid)
    layout.ByteBufAppendFixed32(preimage, manifestCid)
    csgStoreIdentityAppendU32(
        preimage,
        int32(uint32(uint64(storeGeneration) & uint64(4294967295))))
    csgStoreIdentityAppendU32(
        preimage,
        int32(uint32(
            (uint64(storeGeneration) >> uint64(32)) &
                uint64(4294967295))))
    csgStoreIdentityAppendU32(preimage, csgcByteCount)
    csgStoreIdentityAppendU32(preimage, factCount)
    csgStoreIdentityAppendU32(preimage, nodeCount)
    layout.ByteBufAppendFixed32(preimage, csgcDirectoryCid)
    layout.ByteBufAppendFixed32(preimage, csgcObjectCid)
    layout.ByteBufAppendFixed32(preimage, factsRoot)
    layout.ByteBufAppendFixed32(preimage, dagRootCid)
    layout.ByteBufAppendFixed32(preimage, profileSetCid)
    layout.ByteBufAppendFixed32(preimage, schemaCid)
    layout.ByteBufAppendFixed32(preimage, headRawDigest)
    csgStoreIdentityAppendU32(preimage, headRawLength)
    layout.ByteBufAppendFixed32(preimage, manifestObjectDigest)
    csgStoreIdentityAppendU32(preimage, manifestObjectLength)
    layout.ByteBufAppendFixed32(preimage, issueNonce)
    let binding = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return binding

fn csgStoreBeforeSnapshotClearRow(row: int32) =
    let zero = layout.FixedBytes32()
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.sourceOwnerIds, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.sourceGenerations, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.storeGenerationLow, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.storeGenerationHigh, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.headRawLengths, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.manifestObjectLengths, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.csgcByteCounts, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.factCounts, row, 0)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.nodeCounts, row, 0)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.sourceLeaseNonces, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.sourceLineageBindings, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.beforeStoreIdentities, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.headCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.manifestCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.csgcDirectoryCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.csgcObjectCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.factsRoots, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.dagRootCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.profileSetCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.schemaCids, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.headRawDigests, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.manifestObjectDigests, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.authorityNonces, row, zero)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.snapshotBindings, row, zero)

fn csgStoreBeforeSnapshotStoreGenerationAt(row: int32): int64 =
    let low = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.storeGenerationLow, row)
    let high = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.storeGenerationHigh, row)
    let bits =
        (uint64(uint32(high)) << uint64(32)) |
        uint64(uint32(low))
    return int64(bits)

fn csgStoreBeforeSnapshotSetStoreGeneration(
        row: int32,
        generation: int64) =
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.storeGenerationLow,
        row,
        int32(uint32(
            uint64(generation) & uint64(4294967295))))
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.storeGenerationHigh,
        row,
        int32(uint32(
            (uint64(generation) >> uint64(32)) &
                uint64(4294967295))))

@borrows
fn csgStoreBeforeSnapshotRowMatches(
        authority: CsgCoreMerkleStoreBeforeSnapshotAuthority,
        requiredState: int32): bool =
    if authority.ownerId <= 0 ||
       authority.ownerId > csgStoreBeforeSnapshotSlotCount ||
       authority.generation <= 0 ||
       layout.FixedBytes32Equal(
           authority.nonce, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           authority.binding, layout.FixedBytes32()):
        return false
    let row = authority.ownerId - 1
    return csgStoreBeforeSnapshotI32At(
               csgStoreBeforeSnapshotRegistry.states, row) ==
               requiredState &&
        csgStoreBeforeSnapshotI32At(
            csgStoreBeforeSnapshotRegistry.generations, row) ==
            authority.generation &&
        layout.FixedBytes32Equal(
            csgStoreBeforeSnapshotFixed32At(
                csgStoreBeforeSnapshotRegistry.authorityNonces, row),
            authority.nonce) &&
        layout.FixedBytes32Equal(
            csgStoreBeforeSnapshotFixed32At(
                csgStoreBeforeSnapshotRegistry.snapshotBindings, row),
            authority.binding)

fn csgStoreBeforeSnapshotSummaryAt(
        row: int32): CsgCoreMerkleStoreBeforeSnapshotSummary =
    var out: CsgCoreMerkleStoreBeforeSnapshotSummary
    out.sourceLineageBinding = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.sourceLineageBindings, row)
    out.beforeStoreIdentity = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.beforeStoreIdentities, row)
    out.headCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.headCids, row)
    out.manifestCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.manifestCids, row)
    out.storeGeneration = csgStoreBeforeSnapshotStoreGenerationAt(row)
    out.csgcByteCount = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.csgcByteCounts, row)
    out.factCount = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.factCounts, row)
    out.nodeCount = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.nodeCounts, row)
    out.csgcDirectoryCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.csgcDirectoryCids, row)
    out.csgcObjectCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.csgcObjectCids, row)
    out.factsRoot = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.factsRoots, row)
    out.dagRootCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.dagRootCids, row)
    out.profileSetCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.profileSetCids, row)
    out.schemaCid = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.schemaCids, row)
    out.headRawDigest = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.headRawDigests, row)
    out.headRawLength = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.headRawLengths, row)
    out.manifestObjectDigest = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.manifestObjectDigests, row)
    out.manifestObjectLength = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.manifestObjectLengths, row)
    out.snapshotBinding = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.snapshotBindings, row)
    return out

@borrows
fn CsgCoreMerkleStorePlanningPathAuthorityIssueBeforeSnapshot(
        authority: CsgCoreMerkleStorePlanningPathAuthority):
        CsgCoreMerkleStoreBeforeSnapshotIssueResult =
    let liveReceipt =
        CsgCoreMerkleStorePlanningPathAuthorityIdentityReceipt(authority)
    if !liveReceipt.ok:
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_source_invalid")
    var issueNonce: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(issueNonce):
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_nonce_unavailable")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           authority.ownerId,
           authority.generation,
           authority.stageNonce,
           csgStoreIdentityAuthorityPlanningOwned):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_source_invalid")
    let sourceRow = authority.ownerId - 1
    let sourceHandle = csgStoreIdentityAuthorityHandleAt(sourceRow)
    let sourceBeforeStoreIdentity =
        csgStoreIdentityAuthorityFixed32At(
            csgStoreIdentityAuthorityRegistry.beforeStoreIdentities,
            sourceRow)
    let sourceLineageBinding = csgStoreIdentityAuthorityFixed32At(
        csgStoreIdentityAuthorityRegistry.lineageBindings, sourceRow)
    csgStoreIdentityAuthorityUnlock()
    var receiptBeforeStoreIdentity: layout.FixedBytes32
    if !csgStoreIdentityCidTextInto(
           liveReceipt.beforeStoreIdentity,
           receiptBeforeStoreIdentity) ||
       !layout.FixedBytes32Equal(
           receiptBeforeStoreIdentity,
           sourceBeforeStoreIdentity):
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_identity_mismatch")
    if layout.FixedBytes32Equal(
           sourceLineageBinding, layout.FixedBytes32()):
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_lineage_invalid")
    let material = csgStoreBeforeSnapshotReadCurrent(sourceHandle)
    if !material.ok:
        return csgStoreBeforeSnapshotIssueFail(material.error)
    var headCid: layout.FixedBytes32
    var manifestCid: layout.FixedBytes32
    if !csgStoreIdentityCidTextInto(material.head.headCid, headCid) ||
       !csgStoreIdentityCidTextInto(
           material.head.manifestCid, manifestCid):
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_head_identity_invalid")
    let snapshotBinding = csgStoreBeforeSnapshotBinding(
        sourceLineageBinding,
        sourceBeforeStoreIdentity,
        headCid,
        manifestCid,
        material.head.generation,
        material.csgcByteCount,
        material.factCount,
        material.nodeCount,
        material.csgcDirectoryCid,
        material.csgcObjectCid,
        material.factsRoot,
        material.dagRootCid,
        material.profileSetCid,
        material.schemaCid,
        material.headRawDigest,
        material.headRawLength,
        material.manifestObjectDigest,
        material.manifestObjectLength,
        issueNonce)
    if layout.FixedBytes32Equal(
           snapshotBinding, layout.FixedBytes32()):
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_binding_invalid")
    let nextSuccessorName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
            material.head.headCid)
    if nextSuccessorName.len == 0:
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_tail_name_invalid")
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreIdentityStageRowMatches(
           authority.ownerId,
           authority.generation,
           authority.stageNonce,
           csgStoreIdentityAuthorityPlanningOwned) ||
       csgStoreIdentityAuthorityHandleAt(sourceRow) != sourceHandle ||
       !layout.FixedBytes32Equal(
           csgStoreIdentityAuthorityFixed32At(
               csgStoreIdentityAuthorityRegistry.lineageBindings,
               sourceRow),
           sourceLineageBinding) ||
       !layout.FixedBytes32Equal(
           csgStoreIdentityAuthorityFixed32At(
               csgStoreIdentityAuthorityRegistry.beforeStoreIdentities,
               sourceRow),
           sourceBeforeStoreIdentity):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_source_drift")
    let tailExists = os.AtomicTreeVerifiedRootChildExists(
        sourceHandle,
        merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
        nextSuccessorName)
    if result.IsErr(tailExists) || result.Value(tailExists):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_head_drift")
    var row: int32 = -1
    var reusableGenerationInvalid: bool
    var reusableGenerationExhausted: bool
    for i in 0..<csgStoreBeforeSnapshotSlotCount:
        let state = csgStoreBeforeSnapshotI32At(
            csgStoreBeforeSnapshotRegistry.states, i)
        if (state == csgStoreBeforeSnapshotLive ||
            state == csgStoreBeforeSnapshotClaimed ||
            state == csgStoreBeforeSnapshotMapping) &&
           layout.FixedBytes32Equal(
               csgStoreBeforeSnapshotFixed32At(
                   csgStoreBeforeSnapshotRegistry.sourceLineageBindings,
                   i),
               sourceLineageBinding):
            csgStoreIdentityAuthorityUnlock()
            return csgStoreBeforeSnapshotIssueFail(
                "merkle_store_before_snapshot_source_duplicate")
        if state == csgStoreBeforeSnapshotEmpty ||
           state == csgStoreBeforeSnapshotConsumed ||
           state == csgStoreBeforeSnapshotPoisoned:
            let candidateGeneration = csgStoreBeforeSnapshotI32At(
                csgStoreBeforeSnapshotRegistry.generations, i)
            if candidateGeneration < 0:
                reusableGenerationInvalid = true
            elif candidateGeneration >= 2147483646:
                reusableGenerationExhausted = true
            elif row < 0:
                row = i
    if row < 0:
        csgStoreIdentityAuthorityUnlock()
        if reusableGenerationInvalid:
            return csgStoreBeforeSnapshotIssueFail(
                "merkle_store_before_snapshot_generation_invalid")
        if reusableGenerationExhausted:
            return csgStoreBeforeSnapshotIssueFail(
                "merkle_store_before_snapshot_generation_exhausted")
        return csgStoreBeforeSnapshotIssueFail(
            "merkle_store_before_snapshot_registry_full")
    let previousGeneration = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.generations, row)
    if previousGeneration < 0 || previousGeneration >= 2147483646:
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store before snapshot: selected generation invalid")
    let generation = previousGeneration + 1
    csgStoreBeforeSnapshotClearRow(row)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.generations, row, generation)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.sourceOwnerIds,
        row,
        authority.ownerId)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.sourceGenerations,
        row,
        authority.generation)
    csgStoreBeforeSnapshotSetStoreGeneration(
        row,
        material.head.generation)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.headRawLengths,
        row,
        material.headRawLength)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.manifestObjectLengths,
        row,
        material.manifestObjectLength)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.csgcByteCounts,
        row,
        material.csgcByteCount)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.factCounts,
        row,
        material.factCount)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.nodeCounts,
        row,
        material.nodeCount)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.sourceLeaseNonces,
        row,
        authority.stageNonce)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.sourceLineageBindings,
        row,
        sourceLineageBinding)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.beforeStoreIdentities,
        row,
        sourceBeforeStoreIdentity)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.headCids, row, headCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.manifestCids, row, manifestCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.csgcDirectoryCids,
        row,
        material.csgcDirectoryCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.csgcObjectCids,
        row,
        material.csgcObjectCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.factsRoots,
        row,
        material.factsRoot)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.dagRootCids,
        row,
        material.dagRootCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.profileSetCids,
        row,
        material.profileSetCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.schemaCids,
        row,
        material.schemaCid)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.headRawDigests,
        row,
        material.headRawDigest)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.manifestObjectDigests,
        row,
        material.manifestObjectDigest)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.authorityNonces,
        row,
        issueNonce)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.snapshotBindings,
        row,
        snapshotBinding)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.states,
        row,
        csgStoreBeforeSnapshotLive)
    csgStoreIdentityAuthorityUnlock()
    var snapshotAuthority: CsgCoreMerkleStoreBeforeSnapshotAuthority
    snapshotAuthority.ownerId = row + 1
    snapshotAuthority.generation = generation
    snapshotAuthority.nonce = issueNonce
    snapshotAuthority.binding = snapshotBinding
    var out: CsgCoreMerkleStoreBeforeSnapshotIssueResult
    out.ok = true
    out.authority = snapshotAuthority
    return out

fn CsgCoreMerkleStoreBeforeSnapshotClaim(
        authority: var CsgCoreMerkleStoreBeforeSnapshotAuthority):
        CsgCoreMerkleStoreBeforeSnapshotClaimResult =
    var nextNonce: layout.FixedBytes32
    if !csgStoreIdentityAuthorityNonce(nextNonce):
        return csgStoreBeforeSnapshotClaimFail(
            "merkle_store_before_snapshot_claim_nonce_unavailable")
    let consumed = authority
    authority = CsgCoreMerkleStoreBeforeSnapshotAuthority()
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRowMatches(
           consumed,
           csgStoreBeforeSnapshotLive):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreBeforeSnapshotClaimFail(
            "merkle_store_before_snapshot_claim_invalid")
    if consumed.generation >= 2147483646 ||
       layout.FixedBytes32Equal(nextNonce, consumed.nonce) ||
       layout.FixedBytes32Equal(nextNonce, consumed.binding):
        let terminalRow = consumed.ownerId - 1
        csgStoreBeforeSnapshotClearRow(terminalRow)
        csgStoreBeforeSnapshotSetI32(
            csgStoreBeforeSnapshotRegistry.states,
            terminalRow,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        return csgStoreBeforeSnapshotClaimFail(
            "merkle_store_before_snapshot_claim_rotation_invalid")
    let row = consumed.ownerId - 1
    let nextGeneration = consumed.generation + 1
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.generations,
        row,
        nextGeneration)
    csgStoreBeforeSnapshotSetFixed32(
        csgStoreBeforeSnapshotRegistry.authorityNonces,
        row,
        nextNonce)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.states,
        row,
        csgStoreBeforeSnapshotClaimed)
    let summary = csgStoreBeforeSnapshotSummaryAt(row)
    csgStoreIdentityAuthorityUnlock()
    var claimed: CsgCoreMerkleStoreBeforeSnapshotAuthority
    claimed.ownerId = consumed.ownerId
    claimed.generation = nextGeneration
    claimed.nonce = nextNonce
    claimed.binding = consumed.binding
    var out: CsgCoreMerkleStoreBeforeSnapshotClaimResult
    out.ok = true
    out.authority = claimed
    out.summary = summary
    return out

@borrows
fn CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
        authority: CsgCoreMerkleStoreBeforeSnapshotAuthority):
        CsgCoreMerkleStoreBeforeSnapshotSummaryResult =
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRowMatches(
           authority, csgStoreBeforeSnapshotClaimed):
        csgStoreIdentityAuthorityUnlock()
        var failed: CsgCoreMerkleStoreBeforeSnapshotSummaryResult
        failed.error =
            "merkle_store_before_snapshot_locked_summary_invalid"
        return failed
    let summary = csgStoreBeforeSnapshotSummaryAt(
        authority.ownerId - 1)
    csgStoreIdentityAuthorityUnlock()
    var out: CsgCoreMerkleStoreBeforeSnapshotSummaryResult
    out.ok = true
    out.summary = summary
    return out

@borrows
fn CsgCoreMerkleStoreBeforeSnapshotPlanningMatches(
        snapshot: CsgCoreMerkleStoreBeforeSnapshotAuthority,
        planning: CsgCoreMerkleStorePlanningPathAuthority): bool =
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRowMatches(
           snapshot, csgStoreBeforeSnapshotClaimed) ||
       !csgStoreIdentityStageRowMatches(
           planning.ownerId,
           planning.generation,
           planning.stageNonce,
           csgStoreIdentityAuthorityPlanningOwned):
        csgStoreIdentityAuthorityUnlock()
        return false
    let row = snapshot.ownerId - 1
    let matches =
        csgStoreBeforeSnapshotI32At(
            csgStoreBeforeSnapshotRegistry.sourceOwnerIds, row) ==
            planning.ownerId &&
        csgStoreBeforeSnapshotI32At(
            csgStoreBeforeSnapshotRegistry.sourceGenerations, row) ==
            planning.generation &&
        layout.FixedBytes32Equal(
            csgStoreBeforeSnapshotFixed32At(
                csgStoreBeforeSnapshotRegistry.sourceLeaseNonces, row),
            planning.stageNonce) &&
        !layout.FixedBytes32Equal(
            csgStoreBeforeSnapshotFixed32At(
                csgStoreBeforeSnapshotRegistry.sourceLineageBindings,
                row),
            layout.FixedBytes32())
    csgStoreIdentityAuthorityUnlock()
    return matches

fn CsgCoreMerkleStoreBeforeSnapshotPoison(
        authority: var CsgCoreMerkleStoreBeforeSnapshotAuthority): str =
    let consumed = authority
    authority = CsgCoreMerkleStoreBeforeSnapshotAuthority()
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !(csgStoreBeforeSnapshotRowMatches(
             consumed,
             csgStoreBeforeSnapshotLive) ||
         csgStoreBeforeSnapshotRowMatches(
             consumed,
             csgStoreBeforeSnapshotClaimed)):
        csgStoreIdentityAuthorityUnlock()
        return "merkle_store_before_snapshot_poison_invalid"
    let row = consumed.ownerId - 1
    csgStoreBeforeSnapshotClearRow(row)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.states,
        row,
        csgStoreBeforeSnapshotPoisoned)
    csgStoreIdentityAuthorityUnlock()
    return ""

@borrows
fn csgStoreMappedCsgcIssueFail(
        error: str): CsgCoreMerkleStoreMappedCsgcIssueResult =
    var out: CsgCoreMerkleStoreMappedCsgcIssueResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreMappedCsgcFactFail(
        error: str): CsgCoreMerkleStoreMappedCsgcFactResult =
    var out: CsgCoreMerkleStoreMappedCsgcFactResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreMappedCsgcFinishFail(
        error: str): CsgCoreMerkleStoreMappedCsgcFinishResult =
    var out: CsgCoreMerkleStoreMappedCsgcFinishResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgStoreMappedCsgcCompletionSummaryFail(
        error: str):
        CsgCoreMerkleStoreMappedCsgcCompletionSummaryResult =
    var out: CsgCoreMerkleStoreMappedCsgcCompletionSummaryResult
    out.error = strings.CloneStr(error)
    return out

fn csgStoreMappedCsgcClearRow(row: int32) =
    let zero = layout.FixedBytes32()
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.sourceOwnerIds, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.sourceGenerations, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.storeGenerationLow, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.storeGenerationHigh, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.nextOrdinals, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.readCounts, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.factCounts, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.nodeCounts, row, 0)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.csgcByteCounts, row, 0)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.sourceLineageBindings, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.beforeStoreIdentities, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.headCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.manifestCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.csgcDirectoryCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.csgcObjectCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.factsRoots, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.dagRootCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.profileSetCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.schemaCids, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.authorityNonces, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.mappedBindings, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.traversalDigests, row, zero)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.completionBindings, row, zero)

fn csgStoreMappedCsgcStoreGenerationAt(row: int32): int64 =
    let low = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.storeGenerationLow, row)
    let high = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.storeGenerationHigh, row)
    let bits =
        (uint64(uint32(high)) << uint64(32)) |
        uint64(uint32(low))
    return int64(bits)

fn csgStoreMappedCsgcSetStoreGeneration(
        row: int32,
        generation: int64) =
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.storeGenerationLow,
        row,
        int32(uint32(
            uint64(generation) & uint64(4294967295))))
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.storeGenerationHigh,
        row,
        int32(uint32(
            (uint64(generation) >> uint64(32)) &
                uint64(4294967295))))

@borrows
fn csgStoreMappedCsgcRowMatches(
        authority: CsgCoreMerkleStoreMappedCsgcAuthority,
        requiredState: int32): bool =
    if authority.ownerId <= 0 ||
       authority.ownerId > csgStoreMappedCsgcSlotCount ||
       authority.generation <= 0 ||
       layout.FixedBytes32Equal(
           authority.nonce, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           authority.binding, layout.FixedBytes32()):
        return false
    let row = authority.ownerId - 1
    return csgStoreMappedCsgcI32At(
               csgStoreMappedCsgcRegistry.states, row) ==
               requiredState &&
        csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.generations, row) ==
            authority.generation &&
        layout.FixedBytes32Equal(
            csgStoreMappedCsgcFixed32At(
                csgStoreMappedCsgcRegistry.authorityNonces, row),
            authority.nonce) &&
        layout.FixedBytes32Equal(
            csgStoreMappedCsgcFixed32At(
                csgStoreMappedCsgcRegistry.mappedBindings, row),
            authority.binding)

@borrows
fn csgStoreMappedCsgcCompletionRowMatches(
        authority: CsgCoreMerkleStoreMappedCsgcCompletionAuthority): bool =
    if authority.ownerId <= 0 ||
       authority.ownerId > csgStoreMappedCsgcSlotCount ||
       authority.generation <= 0 ||
       layout.FixedBytes32Equal(
           authority.nonce, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           authority.binding, layout.FixedBytes32()):
        return false
    let row = authority.ownerId - 1
    return csgStoreMappedCsgcI32At(
               csgStoreMappedCsgcRegistry.states, row) ==
               csgStoreMappedCsgcCompletion &&
        csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.generations, row) ==
            authority.generation &&
        layout.FixedBytes32Equal(
            csgStoreMappedCsgcFixed32At(
                csgStoreMappedCsgcRegistry.authorityNonces, row),
            authority.nonce) &&
        layout.FixedBytes32Equal(
            csgStoreMappedCsgcFixed32At(
                csgStoreMappedCsgcRegistry.completionBindings, row),
            authority.binding)

fn csgStoreMappedCsgcBinding(
        summary: CsgCoreMerkleStoreBeforeSnapshotSummary,
        nonce: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(640)
    csgStoreIdentityAppendText(
        preimage, csgStoreMappedCsgcBindingDomain)
    layout.ByteBufAppendFixed32(preimage, summary.snapshotBinding)
    layout.ByteBufAppendFixed32(preimage, summary.beforeStoreIdentity)
    layout.ByteBufAppendFixed32(preimage, summary.headCid)
    layout.ByteBufAppendFixed32(preimage, summary.manifestCid)
    layout.ByteBufAppendFixed32(preimage, summary.csgcDirectoryCid)
    layout.ByteBufAppendFixed32(preimage, summary.csgcObjectCid)
    layout.ByteBufAppendFixed32(preimage, summary.factsRoot)
    layout.ByteBufAppendFixed32(preimage, summary.dagRootCid)
    layout.ByteBufAppendFixed32(preimage, summary.profileSetCid)
    layout.ByteBufAppendFixed32(preimage, summary.schemaCid)
    csgStoreIdentityAppendU32(preimage, summary.csgcByteCount)
    csgStoreIdentityAppendU32(preimage, summary.factCount)
    csgStoreIdentityAppendU32(preimage, summary.nodeCount)
    layout.ByteBufAppendFixed32(preimage, nonce)
    let binding = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return binding

fn csgStoreMappedCsgcTraversalInitial(
        binding: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(128)
    csgStoreIdentityAppendText(
        preimage, csgStoreMappedCsgcTraversalDomain)
    layout.ByteBufAppendFixed32(preimage, binding)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

fn csgStoreMappedCsgcTraversalStep(
        previous: layout.FixedBytes32,
        ordinal: int32,
        factDigest: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(128)
    csgStoreIdentityAppendText(
        preimage, csgStoreMappedCsgcTraversalDomain)
    layout.ByteBufAppendFixed32(preimage, previous)
    csgStoreIdentityAppendU32(preimage, ordinal)
    layout.ByteBufAppendFixed32(preimage, factDigest)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

fn csgStoreMappedCsgcCompletionBinding(
        row: int32,
        completionNonce: layout.FixedBytes32): layout.FixedBytes32 =
    var preimage = layout.ByteBufInit(768)
    csgStoreIdentityAppendText(
        preimage, csgStoreMappedCsgcCompletionBindingDomain)
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.sourceLineageBindings, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.beforeStoreIdentities, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.headCids, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.manifestCids, row))
    let storeGeneration = csgStoreMappedCsgcStoreGenerationAt(row)
    csgStoreIdentityAppendU32(
        preimage,
        int32(uint32(
            uint64(storeGeneration) & uint64(4294967295))))
    csgStoreIdentityAppendU32(
        preimage,
        int32(uint32(
            (uint64(storeGeneration) >> uint64(32)) &
                uint64(4294967295))))
    csgStoreIdentityAppendU32(
        preimage,
        csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.csgcByteCounts, row))
    csgStoreIdentityAppendU32(
        preimage,
        csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.factCounts, row))
    csgStoreIdentityAppendU32(
        preimage,
        csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.nodeCounts, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.csgcDirectoryCids, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.csgcObjectCids, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.factsRoots, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.dagRootCids, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.profileSetCids, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.schemaCids, row))
    csgStoreIdentityAppendU32(
        preimage,
        csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.readCounts, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.traversalDigests, row))
    layout.ByteBufAppendFixed32(
        preimage,
        csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.mappedBindings, row))
    layout.ByteBufAppendFixed32(preimage, completionNonce)
    let binding = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return binding

fn csgStoreMappedCsgcCompletionSummaryAt(
        row: int32): CsgCoreMerkleStoreMappedCsgcCompletionSummary =
    var out: CsgCoreMerkleStoreMappedCsgcCompletionSummary
    out.sourceLineageBinding = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.sourceLineageBindings, row)
    out.snapshotBinding = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row)
    out.beforeStoreIdentity = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.beforeStoreIdentities, row)
    out.headCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.headCids, row)
    out.manifestCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.manifestCids, row)
    out.storeGeneration = csgStoreMappedCsgcStoreGenerationAt(row)
    out.csgcByteCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.csgcByteCounts, row)
    out.factCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.factCounts, row)
    out.nodeCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.nodeCounts, row)
    out.csgcDirectoryCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.csgcDirectoryCids, row)
    out.csgcObjectCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.csgcObjectCids, row)
    out.factsRoot = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.factsRoots, row)
    out.dagRootCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.dagRootCids, row)
    out.profileSetCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.profileSetCids, row)
    out.schemaCid = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.schemaCids, row)
    out.readCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.readCounts, row)
    out.traversalDigest = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.traversalDigests, row)
    out.mappedBinding = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.mappedBindings, row)
    out.completionBinding = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.completionBindings, row)
    return out

fn csgStoreBeforeSnapshotTerminalMappedRow(
        row: int32,
        generation: int32,
        binding: layout.FixedBytes32,
        terminalState: int32) =
    if row < 0 || row >= csgStoreBeforeSnapshotSlotCount ||
       !(terminalState == csgStoreBeforeSnapshotConsumed ||
         terminalState == csgStoreBeforeSnapshotPoisoned):
        panic("merkle store mapped csgc: source terminal invalid")
    if csgStoreBeforeSnapshotI32At(
           csgStoreBeforeSnapshotRegistry.states, row) !=
           csgStoreBeforeSnapshotMapping ||
       csgStoreBeforeSnapshotI32At(
           csgStoreBeforeSnapshotRegistry.generations, row) !=
           generation ||
       !layout.FixedBytes32Equal(
           csgStoreBeforeSnapshotFixed32At(
               csgStoreBeforeSnapshotRegistry.snapshotBindings, row),
           binding):
        panic("merkle store mapped csgc: source terminal drift")
    csgStoreBeforeSnapshotClearRow(row)
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.states, row, terminalState)

fn csgStoreBeforeSnapshotPoisonMapping(
        authority: CsgCoreMerkleStoreBeforeSnapshotAuthority) =
    csgStoreIdentityAuthorityLock()
    let row = authority.ownerId - 1
    if !csgStoreBeforeSnapshotRegistryShapeValid() ||
       row < 0 || row >= csgStoreBeforeSnapshotSlotCount ||
       csgStoreBeforeSnapshotI32At(
           csgStoreBeforeSnapshotRegistry.states, row) !=
           csgStoreBeforeSnapshotMapping ||
       csgStoreBeforeSnapshotI32At(
           csgStoreBeforeSnapshotRegistry.generations, row) !=
           authority.generation ||
       !layout.FixedBytes32Equal(
           csgStoreBeforeSnapshotFixed32At(
               csgStoreBeforeSnapshotRegistry.snapshotBindings, row),
           authority.binding):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: source poison drift")
    csgStoreBeforeSnapshotTerminalMappedRow(
        row,
        authority.generation,
        authority.binding,
        csgStoreBeforeSnapshotPoisoned)
    csgStoreIdentityAuthorityUnlock()

fn CsgCoreMerkleStoreBeforeSnapshotIssueMappedCsgc(
        authority: var CsgCoreMerkleStoreBeforeSnapshotAuthority):
        CsgCoreMerkleStoreMappedCsgcIssueResult =
    var consumed = authority
    authority = CsgCoreMerkleStoreBeforeSnapshotAuthority()
    var mappedNonce: layout.FixedBytes32
    let mappedNonceAvailable =
        csgStoreIdentityAuthorityNonce(mappedNonce)
    if !mappedNonceAvailable:
        let poisonError =
            CsgCoreMerkleStoreBeforeSnapshotPoison(consumed)
        if poisonError.len > 0:
            return csgStoreMappedCsgcIssueFail(
                "merkle_store_mapped_csgc_nonce_poison_failed")
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_nonce_unavailable")
    csgStoreIdentityAuthorityEnsureRegistry()
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreIdentityAuthorityRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreBeforeSnapshotRowMatches(
           consumed, csgStoreBeforeSnapshotClaimed):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_snapshot_invalid")
    let snapshotRow = consumed.ownerId - 1
    let summary = csgStoreBeforeSnapshotSummaryAt(snapshotRow)
    let sourceOwnerId = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.sourceOwnerIds, snapshotRow)
    let sourceGeneration = csgStoreBeforeSnapshotI32At(
        csgStoreBeforeSnapshotRegistry.sourceGenerations, snapshotRow)
    let sourceLeaseNonce = csgStoreBeforeSnapshotFixed32At(
        csgStoreBeforeSnapshotRegistry.sourceLeaseNonces, snapshotRow)
    var sourceAuthority: CsgCoreMerkleStorePlanningPathAuthority
    sourceAuthority.ownerId = sourceOwnerId
    sourceAuthority.generation = sourceGeneration
    sourceAuthority.stageNonce = sourceLeaseNonce
    if !csgStoreIdentityStageRowMatches(
           sourceAuthority.ownerId,
           sourceAuthority.generation,
           sourceAuthority.stageNonce,
           csgStoreIdentityAuthorityPlanningOwned):
        csgStoreBeforeSnapshotClearRow(snapshotRow)
        csgStoreBeforeSnapshotSetI32(
            csgStoreBeforeSnapshotRegistry.states,
            snapshotRow,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_source_invalid")
    let sourceRow = sourceOwnerId - 1
    let sourceHandle = csgStoreIdentityAuthorityHandleAt(sourceRow)
    let headCidText = csgStoreIdentityCat(
        "sha256:", layout.FixedBytes32Hex(summary.headCid))
    let nextSuccessorName =
        merkle_store_codec.CsgCoreMerkleStoreSuccessorName(
            headCidText)
    if nextSuccessorName.len == 0:
        csgStoreBeforeSnapshotClearRow(snapshotRow)
        csgStoreBeforeSnapshotSetI32(
            csgStoreBeforeSnapshotRegistry.states,
            snapshotRow,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_head_invalid")
    let mappedTailExists = os.AtomicTreeVerifiedRootChildExists(
        sourceHandle,
        merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
        nextSuccessorName)
    if result.IsErr(mappedTailExists) ||
       result.Value(mappedTailExists):
        csgStoreBeforeSnapshotClearRow(snapshotRow)
        csgStoreBeforeSnapshotSetI32(
            csgStoreBeforeSnapshotRegistry.states,
            snapshotRow,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_head_drift")
    let objectName = layout.FixedBytes32Hex(summary.csgcObjectCid)
    let openedChild = os.AtomicTreeOpenChildFromVerifiedRoot(
        sourceHandle, "csgc_objects", objectName)
    if result.IsErr(openedChild):
        csgStoreBeforeSnapshotClearRow(snapshotRow)
        csgStoreBeforeSnapshotSetI32(
            csgStoreBeforeSnapshotRegistry.states,
            snapshotRow,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_object_absent")
    csgStoreBeforeSnapshotSetI32(
        csgStoreBeforeSnapshotRegistry.states,
        snapshotRow,
        csgStoreBeforeSnapshotMapping)
    csgStoreIdentityAuthorityUnlock()

    var child = result.Value(openedChild)
    let objectCidText = csgStoreIdentityCat(
        "sha256:", layout.FixedBytes32Hex(summary.csgcObjectCid))
    var openedReader =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderOpenVerifiedTreeOwned(
            child,
            merkle_store_codec.CsgCoreMerkleStoreObjectFileName(),
            merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectDomain(),
            objectCidText)
    if result.IsErr(openedReader):
        csgStoreBeforeSnapshotPoisonMapping(consumed)
        return csgStoreMappedCsgcIssueFail(result.Error(openedReader))
    var reader = result.Value(openedReader)
    let factCount =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderFactCount(reader)
    let byteLength =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderByteLength(reader)
    let directoryCid =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderDirectoryCid(reader)
    var actualDirectoryCid: layout.FixedBytes32
    let readerMatches = result.IsOk(factCount) &&
        result.Value(factCount) == summary.factCount &&
        result.IsOk(byteLength) &&
        result.Value(byteLength) == summary.csgcByteCount &&
        result.IsOk(directoryCid) &&
        csgStoreIdentityCidTextInto(
            result.Value(directoryCid), actualDirectoryCid) &&
        layout.FixedBytes32Equal(
            actualDirectoryCid, summary.csgcDirectoryCid)
    if !readerMatches:
        let closed =
            csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
                reader)
        if result.IsErr(closed):
            panic("merkle store mapped csgc: mismatch close failed")
        csgStoreBeforeSnapshotPoisonMapping(consumed)
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_manifest_mismatch")
    let mappedBinding = csgStoreMappedCsgcBinding(
        summary, mappedNonce)
    let traversalDigest = csgStoreMappedCsgcTraversalInitial(
        mappedBinding)
    if layout.FixedBytes32Equal(
           mappedBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           traversalDigest, layout.FixedBytes32()):
        let closed =
            csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
                reader)
        if result.IsErr(closed):
            panic("merkle store mapped csgc: binding close failed")
        csgStoreBeforeSnapshotPoisonMapping(consumed)
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_binding_invalid")

    csgStoreIdentityAuthorityLock()
    let sourceStillExact =
        csgStoreIdentityAuthorityRegistryShapeValid() &&
        csgStoreBeforeSnapshotRegistryShapeValid() &&
        csgStoreMappedCsgcRegistryShapeValid() &&
        csgStoreBeforeSnapshotI32At(
            csgStoreBeforeSnapshotRegistry.states,
            snapshotRow) == csgStoreBeforeSnapshotMapping &&
        csgStoreBeforeSnapshotI32At(
            csgStoreBeforeSnapshotRegistry.generations,
            snapshotRow) == consumed.generation &&
        layout.FixedBytes32Equal(
            csgStoreBeforeSnapshotFixed32At(
                csgStoreBeforeSnapshotRegistry.snapshotBindings,
                snapshotRow),
            consumed.binding) &&
        csgStoreIdentityStageRowMatches(
            sourceAuthority.ownerId,
            sourceAuthority.generation,
            sourceAuthority.stageNonce,
            csgStoreIdentityAuthorityPlanningOwned) &&
        csgStoreIdentityAuthorityHandleAt(sourceRow) == sourceHandle &&
        layout.FixedBytes32Equal(
            csgStoreIdentityAuthorityFixed32At(
                csgStoreIdentityAuthorityRegistry.lineageBindings,
                sourceRow),
            summary.sourceLineageBinding)
    var tailStillAbsent: bool
    if sourceStillExact:
        let tailCheck = os.AtomicTreeVerifiedRootChildExists(
            sourceHandle,
            merkle_store_codec.CsgCoreMerkleStoreSuccessorCategoryName(),
            nextSuccessorName)
        tailStillAbsent =
            result.IsOk(tailCheck) && !result.Value(tailCheck)
    if !sourceStillExact || !tailStillAbsent:
        csgStoreBeforeSnapshotTerminalMappedRow(
            snapshotRow,
            consumed.generation,
            consumed.binding,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        let closed =
            csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
                reader)
        if result.IsErr(closed):
            panic("merkle store mapped csgc: drift close failed")
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_source_drift")
    var mappedRow: int32 = -1
    var mappedGenerationInvalid: bool
    var mappedGenerationExhausted: bool
    for i in 0..<csgStoreMappedCsgcSlotCount:
        let state = csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.states, i)
        if state == csgStoreMappedCsgcEmpty ||
           state == csgStoreMappedCsgcFinished ||
           state == csgStoreMappedCsgcPoisoned:
            let generation = csgStoreMappedCsgcI32At(
                csgStoreMappedCsgcRegistry.generations, i)
            if generation < 0:
                mappedGenerationInvalid = true
            elif generation >= 2147483646:
                mappedGenerationExhausted = true
            elif mappedRow < 0 &&
                 !csgc_mapped_reader.CsgCoreCsgcMappedReaderIsOpen(
                     csgStoreMappedCsgcReaders[i]):
                mappedRow = i
    if mappedRow < 0:
        csgStoreBeforeSnapshotTerminalMappedRow(
            snapshotRow,
            consumed.generation,
            consumed.binding,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreIdentityAuthorityUnlock()
        let closed =
            csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
                reader)
        if result.IsErr(closed):
            panic("merkle store mapped csgc: full close failed")
        if mappedGenerationInvalid:
            return csgStoreMappedCsgcIssueFail(
                "merkle_store_mapped_csgc_generation_invalid")
        if mappedGenerationExhausted:
            return csgStoreMappedCsgcIssueFail(
                "merkle_store_mapped_csgc_generation_exhausted")
        return csgStoreMappedCsgcIssueFail(
            "merkle_store_mapped_csgc_registry_full")
    let previousGeneration = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.generations, mappedRow)
    let mappedGeneration = previousGeneration + 1
    csgStoreMappedCsgcClearRow(mappedRow)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.generations,
        mappedRow,
        mappedGeneration)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.sourceOwnerIds,
        mappedRow,
        consumed.ownerId)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.sourceGenerations,
        mappedRow,
        consumed.generation)
    csgStoreMappedCsgcSetStoreGeneration(
        mappedRow,
        summary.storeGeneration)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.factCounts,
        mappedRow,
        summary.factCount)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.nodeCounts,
        mappedRow,
        summary.nodeCount)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.csgcByteCounts,
        mappedRow,
        summary.csgcByteCount)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.sourceLineageBindings,
        mappedRow,
        summary.sourceLineageBinding)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.sourceSnapshotBindings,
        mappedRow,
        summary.snapshotBinding)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.beforeStoreIdentities,
        mappedRow,
        summary.beforeStoreIdentity)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.headCids,
        mappedRow,
        summary.headCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.manifestCids,
        mappedRow,
        summary.manifestCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.csgcDirectoryCids,
        mappedRow,
        summary.csgcDirectoryCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.csgcObjectCids,
        mappedRow,
        summary.csgcObjectCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.factsRoots,
        mappedRow,
        summary.factsRoot)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.dagRootCids,
        mappedRow,
        summary.dagRootCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.profileSetCids,
        mappedRow,
        summary.profileSetCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.schemaCids,
        mappedRow,
        summary.schemaCid)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.authorityNonces,
        mappedRow,
        mappedNonce)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.mappedBindings,
        mappedRow,
        mappedBinding)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.traversalDigests,
        mappedRow,
        traversalDigest)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.states,
        mappedRow,
        csgStoreMappedCsgcBuilding)
    csgStoreIdentityAuthorityUnlock()

    csgStoreMappedCsgcReaders[mappedRow] = reader
    reader = csgc_mapped_reader.CsgCoreCsgcMappedReader()
    csgStoreIdentityAuthorityLock()
    if !csgStoreMappedCsgcRegistryShapeValid() ||
       csgStoreMappedCsgcI32At(
           csgStoreMappedCsgcRegistry.states,
           mappedRow) != csgStoreMappedCsgcBuilding ||
       csgStoreMappedCsgcI32At(
           csgStoreMappedCsgcRegistry.generations,
           mappedRow) != mappedGeneration ||
       !layout.FixedBytes32Equal(
           csgStoreMappedCsgcFixed32At(
               csgStoreMappedCsgcRegistry.mappedBindings,
               mappedRow),
           mappedBinding):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: reader publish drift")
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.states,
        mappedRow,
        csgStoreMappedCsgcLive)
    csgStoreIdentityAuthorityUnlock()
    var mappedAuthority: CsgCoreMerkleStoreMappedCsgcAuthority
    mappedAuthority.ownerId = mappedRow + 1
    mappedAuthority.generation = mappedGeneration
    mappedAuthority.nonce = mappedNonce
    mappedAuthority.binding = mappedBinding
    var out: CsgCoreMerkleStoreMappedCsgcIssueResult
    out.ok = true
    out.authority = mappedAuthority
    return out

@borrows
fn CsgCoreMerkleStoreMappedCsgcReadFact(
        authority: CsgCoreMerkleStoreMappedCsgcAuthority,
        ordinal: int32): CsgCoreMerkleStoreMappedCsgcFactResult =
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreMappedCsgcRowMatches(
           authority, csgStoreMappedCsgcLive):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcFactFail(
            "merkle_store_mapped_csgc_token_invalid")
    let row = authority.ownerId - 1
    let nextOrdinal = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.nextOrdinals, row)
    let factCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.factCounts, row)
    let readCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.readCounts, row)
    if ordinal != nextOrdinal ||
       ordinal != readCount ||
       ordinal < 0 || ordinal >= factCount:
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcFactFail(
            "merkle_store_mapped_csgc_ordinal_not_next")
    let read =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderReadOrdinal(
            csgStoreMappedCsgcReaders[row], ordinal)
    if result.IsErr(read):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcFactFail(result.Error(read))
    let fact = result.Value(read)
    if fact.ordinal != ordinal ||
       layout.FixedBytes32Equal(
           fact.factDigest, layout.FixedBytes32()):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: reader ordinal drift")
    let previousDigest = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.traversalDigests, row)
    let nextDigest = csgStoreMappedCsgcTraversalStep(
        previousDigest, ordinal, fact.factDigest)
    if layout.FixedBytes32Equal(
           nextDigest, layout.FixedBytes32()):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: traversal digest invalid")
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.nextOrdinals,
        row,
        ordinal + 1)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.readCounts,
        row,
        readCount + 1)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.traversalDigests,
        row,
        nextDigest)
    var out: CsgCoreMerkleStoreMappedCsgcFactResult
    out.ok = true
    out.ordinal = ordinal
    out.line = strings.CloneStr(fact.line)
    out.factDigest = fact.factDigest
    csgStoreIdentityAuthorityUnlock()
    return out

fn CsgCoreMerkleStoreMappedCsgcFinish(
        authority: var CsgCoreMerkleStoreMappedCsgcAuthority):
        CsgCoreMerkleStoreMappedCsgcFinishResult =
    var consumed = authority
    authority = CsgCoreMerkleStoreMappedCsgcAuthority()
    var completionNonce: layout.FixedBytes32
    let completionNonceAvailable =
        csgStoreIdentityAuthorityNonce(completionNonce)
    if !completionNonceAvailable:
        let poisonError =
            CsgCoreMerkleStoreMappedCsgcPoison(consumed)
        if poisonError.len > 0:
            return csgStoreMappedCsgcFinishFail(
                "merkle_store_mapped_csgc_completion_nonce_poison_failed")
        return csgStoreMappedCsgcFinishFail(
            "merkle_store_mapped_csgc_completion_nonce_unavailable")
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreMappedCsgcRowMatches(
           consumed, csgStoreMappedCsgcLive):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcFinishFail(
            "merkle_store_mapped_csgc_finish_invalid")
    let row = consumed.ownerId - 1
    let factCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.factCounts, row)
    let nextOrdinal = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.nextOrdinals, row)
    let readCount = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.readCounts, row)
    if nextOrdinal != factCount || readCount != factCount ||
       !csgc_mapped_reader.CsgCoreCsgcMappedReaderOrdinalTraversalComplete(
           csgStoreMappedCsgcReaders[row]):
        let sourceOwnerId = csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.sourceOwnerIds, row)
        let sourceGeneration = csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.sourceGenerations, row)
        let sourceBinding = csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row)
        let closed =
            csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
                csgStoreMappedCsgcReaders[row])
        csgStoreBeforeSnapshotTerminalMappedRow(
            sourceOwnerId - 1,
            sourceGeneration,
            sourceBinding,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreMappedCsgcClearRow(row)
        csgStoreMappedCsgcSetI32(
            csgStoreMappedCsgcRegistry.states,
            row,
            csgStoreMappedCsgcPoisoned)
        csgStoreIdentityAuthorityUnlock()
        if result.IsErr(closed):
            panic("merkle store mapped csgc: incomplete close failed")
        return csgStoreMappedCsgcFinishFail(
            "merkle_store_mapped_csgc_traversal_incomplete")
    if consumed.generation >= 2147483646 ||
       layout.FixedBytes32Equal(completionNonce, consumed.nonce) ||
       layout.FixedBytes32Equal(completionNonce, consumed.binding):
        let sourceOwnerId = csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.sourceOwnerIds, row)
        let sourceGeneration = csgStoreMappedCsgcI32At(
            csgStoreMappedCsgcRegistry.sourceGenerations, row)
        let sourceBinding = csgStoreMappedCsgcFixed32At(
            csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row)
        let closed =
            csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
                csgStoreMappedCsgcReaders[row])
        csgStoreBeforeSnapshotTerminalMappedRow(
            sourceOwnerId - 1,
            sourceGeneration,
            sourceBinding,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreMappedCsgcClearRow(row)
        csgStoreMappedCsgcSetI32(
            csgStoreMappedCsgcRegistry.states,
            row,
            csgStoreMappedCsgcPoisoned)
        csgStoreIdentityAuthorityUnlock()
        if result.IsErr(closed):
            panic("merkle store mapped csgc: rotation close failed")
        return csgStoreMappedCsgcFinishFail(
            "merkle_store_mapped_csgc_completion_rotation_invalid")
    let completionBinding = csgStoreMappedCsgcCompletionBinding(
        row, completionNonce)
    if layout.FixedBytes32Equal(
           completionBinding, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           completionBinding, consumed.binding) ||
       layout.FixedBytes32Equal(
           completionBinding, completionNonce):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: completion binding invalid")
    let sourceOwnerId = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.sourceOwnerIds, row)
    let sourceGeneration = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.sourceGenerations, row)
    let sourceBinding = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row)
    let closed =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreeFinish(
            csgStoreMappedCsgcReaders[row])
    let closeOk = result.IsOk(closed) && result.Value(closed)
    if !closeOk:
        csgStoreBeforeSnapshotTerminalMappedRow(
            sourceOwnerId - 1,
            sourceGeneration,
            sourceBinding,
            csgStoreBeforeSnapshotPoisoned)
        csgStoreMappedCsgcClearRow(row)
        csgStoreMappedCsgcSetI32(
            csgStoreMappedCsgcRegistry.states,
            row,
            csgStoreMappedCsgcPoisoned)
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcFinishFail(
            "merkle_store_mapped_csgc_finish_close_failed")
    csgStoreBeforeSnapshotTerminalMappedRow(
        sourceOwnerId - 1,
        sourceGeneration,
        sourceBinding,
        csgStoreBeforeSnapshotConsumed)
    let completionGeneration = consumed.generation + 1
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.generations,
        row,
        completionGeneration)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.authorityNonces,
        row,
        completionNonce)
    csgStoreMappedCsgcSetFixed32(
        csgStoreMappedCsgcRegistry.completionBindings,
        row,
        completionBinding)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.states,
        row,
        csgStoreMappedCsgcCompletion)
    csgStoreIdentityAuthorityUnlock()
    var completion: CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    completion.ownerId = consumed.ownerId
    completion.generation = completionGeneration
    completion.nonce = completionNonce
    completion.binding = completionBinding
    var out: CsgCoreMerkleStoreMappedCsgcFinishResult
    out.ok = true
    out.authority = completion
    return out

@borrows
fn CsgCoreMerkleStoreMappedCsgcLockedCompletion(
        authority: CsgCoreMerkleStoreMappedCsgcCompletionAuthority):
        CsgCoreMerkleStoreMappedCsgcCompletionSummaryResult =
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreMappedCsgcCompletionRowMatches(authority):
        csgStoreIdentityAuthorityUnlock()
        return csgStoreMappedCsgcCompletionSummaryFail(
            "merkle_store_mapped_csgc_locked_completion_invalid")
    let row = authority.ownerId - 1
    let summary = csgStoreMappedCsgcCompletionSummaryAt(row)
    if summary.factCount < 0 ||
       summary.readCount != summary.factCount ||
       !layout.FixedBytes32Equal(
           summary.completionBinding, authority.binding) ||
       layout.FixedBytes32Equal(
           summary.traversalDigest, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           summary.mappedBinding, layout.FixedBytes32()):
        csgStoreIdentityAuthorityUnlock()
        panic("merkle store mapped csgc: completion summary drift")
    csgStoreIdentityAuthorityUnlock()
    var out: CsgCoreMerkleStoreMappedCsgcCompletionSummaryResult
    out.ok = true
    out.summary = summary
    return out

fn CsgCoreMerkleStoreMappedCsgcConsumeCompletion(
        authority: var CsgCoreMerkleStoreMappedCsgcCompletionAuthority):
        str =
    let consumed = authority
    authority = CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreMappedCsgcCompletionRowMatches(consumed):
        csgStoreIdentityAuthorityUnlock()
        return "merkle_store_mapped_csgc_completion_consume_invalid"
    let row = consumed.ownerId - 1
    csgStoreMappedCsgcClearRow(row)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.states,
        row,
        csgStoreMappedCsgcFinished)
    csgStoreIdentityAuthorityUnlock()
    return ""

fn CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
        authority: var CsgCoreMerkleStoreMappedCsgcCompletionAuthority):
        str =
    let consumed = authority
    authority = CsgCoreMerkleStoreMappedCsgcCompletionAuthority()
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreMappedCsgcCompletionRowMatches(consumed):
        csgStoreIdentityAuthorityUnlock()
        return "merkle_store_mapped_csgc_completion_poison_invalid"
    let row = consumed.ownerId - 1
    csgStoreMappedCsgcClearRow(row)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.states,
        row,
        csgStoreMappedCsgcPoisoned)
    csgStoreIdentityAuthorityUnlock()
    return ""

fn CsgCoreMerkleStoreMappedCsgcPoison(
        authority: var CsgCoreMerkleStoreMappedCsgcAuthority): str =
    let consumed = authority
    authority = CsgCoreMerkleStoreMappedCsgcAuthority()
    csgStoreBeforeSnapshotEnsureRegistry()
    csgStoreMappedCsgcEnsureRegistry()
    csgStoreIdentityAuthorityLock()
    if !csgStoreBeforeSnapshotRegistryShapeValid() ||
       !csgStoreMappedCsgcRegistryShapeValid() ||
       !csgStoreMappedCsgcRowMatches(
           consumed, csgStoreMappedCsgcLive):
        csgStoreIdentityAuthorityUnlock()
        return "merkle_store_mapped_csgc_poison_invalid"
    let row = consumed.ownerId - 1
    let sourceOwnerId = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.sourceOwnerIds, row)
    let sourceGeneration = csgStoreMappedCsgcI32At(
        csgStoreMappedCsgcRegistry.sourceGenerations, row)
    let sourceBinding = csgStoreMappedCsgcFixed32At(
        csgStoreMappedCsgcRegistry.sourceSnapshotBindings, row)
    let closed =
        csgc_mapped_reader.CsgCoreCsgcMappedReaderVerifiedTreePoison(
            csgStoreMappedCsgcReaders[row])
    csgStoreBeforeSnapshotTerminalMappedRow(
        sourceOwnerId - 1,
        sourceGeneration,
        sourceBinding,
        csgStoreBeforeSnapshotPoisoned)
    csgStoreMappedCsgcClearRow(row)
    csgStoreMappedCsgcSetI32(
        csgStoreMappedCsgcRegistry.states,
        row,
        csgStoreMappedCsgcPoisoned)
    csgStoreIdentityAuthorityUnlock()
    if result.IsErr(closed) || !result.Value(closed):
        return "merkle_store_mapped_csgc_poison_close_failed"
    return ""

@borrows
fn CsgCoreMerkleStoreIdentityReceiptIsValid(
        receipt: CsgCoreMerkleStoreIdentityReceipt): bool =
    if !receipt.ok || receipt.error.len > 0:
        return false
    let live = csgStoreIdentityLiveReceipt(
        receipt.ownerId,
        receipt.generation,
        receipt.receiptNonce,
        csgStoreIdentityAuthorityAnyOwned)
    if !live.ok:
        return false
    return live.ownerId == receipt.ownerId &&
        live.generation == receipt.generation &&
        layout.FixedBytes32Equal(
            live.receiptNonce, receipt.receiptNonce) &&
        live.formatId == receipt.formatId &&
        live.markerSchema == receipt.markerSchema &&
        csgStoreIdentitySameStrings(
            live.orderedCanonicalCategoryNames,
            receipt.orderedCanonicalCategoryNames) &&
        live.storeLayoutCid == receipt.storeLayoutCid &&
        layout.FixedBytes32Equal(
            live.storeInstanceSeed, receipt.storeInstanceSeed) &&
        live.beforeStoreIdentity == receipt.beforeStoreIdentity &&
        live.recordCid == receipt.recordCid

fn CsgCoreMerkleStoreIdentityFormatId(): str =
    return csgCoreMerkleStoreFormatId

fn CsgCoreMerkleStoreIdentityMarkerSchema(): str =
    return csgCoreMerkleStoreMarkerSchema
