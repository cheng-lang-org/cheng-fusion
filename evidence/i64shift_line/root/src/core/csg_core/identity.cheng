import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    csgCoreIdentityStandard: str = "csg_core::v1"
    csgCoreIdentitySchemaName: str = "csg_core"
    csgCoreIdentitySchemaNamespace: str = "csg_core::v1"
    csgCoreIdentityBaseProfile: str = "csg_core"
    csgCoreMerkleKeyDomain: str = "csg_core.merkle.key"
    csgCoreProfileSetDomain: str = "csg_core.profile_set"
    csgCoreBindingReceiptDomain: str =
        "csg_core.binding_identity_receipt.v1"

type
    CsgCoreBindingIdentityReceipt =
        ok: bool
        error: str
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaNamespace: str
        schemaCid: str
        bindingIdentityReceiptCid: str

@borrows
fn csgCoreIdentityCat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

@borrows
fn csgCoreIdentityCat3(first: str, second: str, third: str): str =
    return csgCoreIdentityCat(
        csgCoreIdentityCat(first, second), third)

fn csgCoreIdentityAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgCoreIdentityAppendText(
        out: var layout.ByteBuf,
        text: str) =
    csgCoreIdentityAppendU32(out, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(out, text[i])

fn csgCoreIdentityFinishCid(out: var layout.ByteBuf): str =
    let digest = hash256.Sha256Fixed(layout.ByteBufView(out))
    layout.ByteBufFree(out)
    return csgCoreIdentityCat(
        "sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn csgCoreIdentityHashText(domain: str, text: str): str =
    var out = layout.ByteBufInit(domain.len + text.len + 16)
    csgCoreIdentityAppendText(out, domain)
    csgCoreIdentityAppendText(out, text)
    return csgCoreIdentityFinishCid(out)

@borrows
fn csgCoreIdentityTextCompare(left: str, right: str): int32 =
    let common = left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgCoreIdentityProfileSupported(profile: str): bool =
    return profile == csgCoreIdentityBaseProfile ||
        profile == "csg_dialect::c" ||
        profile == "csg_dialect::cheng_compiler" ||
        profile == "csg_dialect::finance" ||
        profile == "csg_dialect::native" ||
        profile == "csg_dialect::oracle_asset" ||
        profile == "csg_dialect::python" ||
        profile == "csg_dialect::unimaker_product" ||
        profile == "csg_dialect::vexa" ||
        profile == "csg_dialect::web"

@borrows
fn CsgCoreProfilesCanonicalError(profiles: str[]): str =
    if profiles.len == 0:
        return "csg_profiles_empty"
    if profiles[0] != csgCoreIdentityBaseProfile:
        return "csg_profiles_base_missing"
    for i in 0..<profiles.len:
        if !csgCoreIdentityProfileSupported(profiles[i]):
            return csgCoreIdentityCat(
                "csg_profiles_unknown ", profiles[i])
        if i > 0 &&
           csgCoreIdentityTextCompare(
               profiles[i - 1], profiles[i]) >= 0:
            return "csg_profiles_noncanonical"
    return ""

@borrows
fn CsgCoreProfilesEqual(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn CsgCoreProfilesClone(profiles: str[]): str[] =
    var out: str[]
    for i in 0..<profiles.len:
        add(out, strings.CloneStr(profiles[i]))
    return out

@borrows
fn CsgCoreProfileSetCidForIdentity(
        standard: str,
        schemaNamespace: str,
        profiles: str[]): str =
    if standard.len == 0:
        return "invalid:csg_profile_set_standard_empty"
    if schemaNamespace.len == 0:
        return "invalid:csg_profile_set_schema_namespace_empty"
    let profileError = CsgCoreProfilesCanonicalError(profiles)
    if profileError.len > 0:
        return csgCoreIdentityCat("invalid:", profileError)
    var payload = csgCoreProfileSetDomain
    payload = csgCoreIdentityCat(
        payload,
        csgCoreIdentityCat3(
            strings.IntToStr(standard.len), ":", standard))
    payload = csgCoreIdentityCat(
        payload,
        csgCoreIdentityCat3(
            strings.IntToStr(schemaNamespace.len),
            ":",
            schemaNamespace))
    for i in 0..<profiles.len:
        payload = csgCoreIdentityCat(
            payload,
            csgCoreIdentityCat3(
                strings.IntToStr(profiles[i].len),
                ":",
                profiles[i]))
    return csgCoreIdentityHashText(csgCoreMerkleKeyDomain, payload)

@borrows
fn CsgCoreProfileSetCid(profiles: str[]): str =
    return CsgCoreProfileSetCidForIdentity(
        csgCoreIdentityStandard,
        csgCoreIdentitySchemaNamespace,
        profiles)

@borrows
fn csgCoreIdentityCidValid(value: str): bool =
    if value.len != 71:
        return false
    if value[0] != 's' || value[1] != 'h' ||
       value[2] != 'a' || value[3] != '2' ||
       value[4] != '5' || value[5] != '6' ||
       value[6] != ':':
        return false
    for i in 7..<71:
        let ch = value[i]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn csgCoreBindingReceiptCid(
        standard: str,
        profiles: str[],
        profileSetCid: str,
        schemaNamespace: str,
        schemaCid: str): str =
    var out = layout.ByteBufInit(256)
    csgCoreIdentityAppendText(out, csgCoreBindingReceiptDomain)
    csgCoreIdentityAppendText(out, standard)
    csgCoreIdentityAppendText(out, schemaNamespace)
    csgCoreIdentityAppendText(out, schemaCid)
    csgCoreIdentityAppendText(out, profileSetCid)
    csgCoreIdentityAppendU32(out, profiles.len)
    for i in 0..<profiles.len:
        csgCoreIdentityAppendText(out, profiles[i])
    return csgCoreIdentityFinishCid(out)

@borrows
fn CsgCoreBindingIdentityIssue(
        standard: str,
        schemaNamespace: str,
        schemaCid: str,
        profiles: str[]): CsgCoreBindingIdentityReceipt =
    var out: CsgCoreBindingIdentityReceipt
    if standard != csgCoreIdentityStandard:
        out.error = "csg_binding_standard_invalid"
        return out
    if schemaNamespace != csgCoreIdentitySchemaNamespace:
        out.error = "csg_binding_schema_namespace_invalid"
        return out
    if !csgCoreIdentityCidValid(schemaCid):
        out.error = "csg_binding_schema_cid_invalid"
        return out
    let profileError = CsgCoreProfilesCanonicalError(profiles)
    if profileError.len > 0:
        out.error = strings.CloneStr(profileError)
        return out
    out.standard = strings.CloneStr(standard)
    out.profiles = CsgCoreProfilesClone(profiles)
    out.schemaNamespace = strings.CloneStr(schemaNamespace)
    out.schemaCid = strings.CloneStr(schemaCid)
    out.profileSetCid = CsgCoreProfileSetCidForIdentity(
        standard, schemaNamespace, profiles)
    if out.profileSetCid.len != 71:
        out.error = "csg_binding_profile_set_cid_invalid"
        return out
    out.bindingIdentityReceiptCid = csgCoreBindingReceiptCid(
        out.standard,
        out.profiles,
        out.profileSetCid,
        out.schemaNamespace,
        out.schemaCid)
    out.ok = true
    return out

@borrows
fn CsgCoreBindingIdentityReceiptIsValid(
        receipt: CsgCoreBindingIdentityReceipt): bool =
    if !receipt.ok || receipt.error.len > 0:
        return false
    let expected = CsgCoreBindingIdentityIssue(
        receipt.standard,
        receipt.schemaNamespace,
        receipt.schemaCid,
        receipt.profiles)
    return expected.ok &&
        expected.standard == receipt.standard &&
        CsgCoreProfilesEqual(expected.profiles, receipt.profiles) &&
        expected.profileSetCid == receipt.profileSetCid &&
        expected.schemaNamespace == receipt.schemaNamespace &&
        expected.schemaCid == receipt.schemaCid &&
        expected.bindingIdentityReceiptCid ==
            receipt.bindingIdentityReceiptCid

fn CsgCoreStandardIdentity(): str =
    return csgCoreIdentityStandard

fn CsgCoreSchemaNameIdentity(): str =
    return csgCoreIdentitySchemaName

fn CsgCoreSchemaNamespaceIdentity(): str =
    return csgCoreIdentitySchemaNamespace

fn CsgCoreBaseProfileIdentity(): str =
    return csgCoreIdentityBaseProfile
