import std/rawbytes
import std/seqs
import std/strings
import std/os
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_store_codec

const
    CsgMerkleTransactionReceiptDomain: str =
        "csg_core.store.transaction_receipt"
    CsgMerkleTransactionAuthorityReceiptDomain: str =
        "csg_core.transaction_authority_receipt.v1"
    CsgMerkleTransactionReceiptSchema: str =
        "csg_core::v1"
    CsgMerkleTransactionReceiptKind: str =
        "csg.merkle.transaction_receipt"
    CsgMerkleTransactionOperationRefKind: str =
        "csg.merkle.transaction_operation_ref"
    CsgMerkleTransactionReachableNodeKind: str =
        "csg.merkle.transaction_reachable_new_node"
    CsgMerkleTransactionReceiptMaxGeneration: int64 =
        9223372036854775806
    CsgMerkleTransactionReceiptMaxOperationCount: int32 =
        131072
    CsgMerkleTransactionReceiptMaxReachableNodeCount: int32 =
        524288
    CsgMerkleTransactionReceiptMaxLineCount: int32 =
        655361

type
    CsgCoreMerkleTransactionReceipt =
        schema: str
        generation: int64
        requestCid: str
        planRoot: str
        beforeStoreIdentity: str
        sealedBeforeContentCid: str
        semanticCarrierCid: str
        projectionReceiptCid: str
        proofCid: str
        artifactClosureCid: str
        beforeHeadCid: str
        beforeManifestCid: str
        afterManifestCid: str
        beforeCsgcDirectoryCid: str
        afterCsgcDirectoryCid: str
        beforeFactsRoot: str
        afterFactsRoot: str
        beforeDagRootCid: str
        afterDagRootCid: str
        beforeFactCount: int32
        afterFactCount: int32
        invalidationCid: str
        plannedOperationKinds: int32[]
        plannedOperationFactKeys: str[]
        operationCids: str[]
        reachableNewNodeCids: str[]

    CsgCoreMerkleTransactionReceiptCodecResult =
        ok: bool
        error: str
        cid: str
        factCount: int32
        receipt: CsgCoreMerkleTransactionReceipt
        lines: str[]
        bytes: rawbytes.Bytes

    CsgCoreMerkleTransactionAuthorityReceipt =
        generation: int64
        beforeStoreIdentity: str
        sealedBeforeContentCid: str
        semanticPlanRoot: str
        semanticCarrierCid: str
        projectionReceiptCid: str
        finalManifestCid: str
        beforeHeadCid: str
        beforeManifestCid: str
        afterManifestCid: str
        beforeFactsRoot: str
        afterFactsRoot: str
        beforeDagRootCid: str
        afterDagRootCid: str
        beforeFactCount: int32
        afterFactCount: int32
        operationCid: str
        proofCid: str
        artifactClosureCid: str

    CsgCoreMerkleTransactionAuthorityReceiptCidResult =
        ok: bool
        error: str
        cid: str

fn CsgCoreMerkleTransactionReceiptOperationLimit(): int32 =
    return CsgMerkleTransactionReceiptMaxOperationCount

fn CsgCoreMerkleTransactionReceiptReachableNodeLimit(): int32 =
    return CsgMerkleTransactionReceiptMaxReachableNodeCount

fn CsgCoreMerkleTransactionReceiptLineLimit(): int32 =
    return CsgMerkleTransactionReceiptMaxLineCount

@borrows
fn csgReceiptCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgReceiptAppend(
        out: var str,
        value: str) =
    out = csgReceiptCat(out, value)

@borrows
fn csgReceiptJson(value: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(
        value)

@borrows
fn csgReceiptStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(
            line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgReceiptTextCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgReceiptTextOrder(values: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, values.len)
    setLen(scratch, values.len)
    for i in 0..<values.len:
        order[i] = i
    var width: int32 = 1
    while width < values.len:
        var base: int32
        while base < values.len:
            let remaining = values.len - base
            let leftWidth =
                remaining < width ? remaining : width
            let middle = base + leftWidth
            let rightRemaining = values.len - middle
            let rightWidth =
                rightRemaining < width ? rightRemaining : width
            let finish = middle + rightWidth
            var left = base
            var right = middle
            var out = base
            while left < middle && right < finish:
                if csgReceiptTextCompare(
                       values[order[right]],
                       values[order[left]]) < 0:
                    scratch[out] = order[right]
                    right = right + 1
                else:
                    scratch[out] = order[left]
                    left = left + 1
                out = out + 1
            while left < middle:
                scratch[out] = order[left]
                left = left + 1
                out = out + 1
            while right < finish:
                scratch[out] = order[right]
                right = right + 1
                out = out + 1
            base = finish
        for i in 0..<values.len:
            order[i] = scratch[i]
        if width > values.len - width:
            width = values.len
        else:
            width = width + width
    return order

@borrows
fn csgReceiptInt32(
        text: str,
        out: var int32): bool =
    return merkle_store_codec.CsgCoreMerkleStoreParseInt32(
        text, out) && out >= 0

@borrows
fn csgReceiptInt64(
        text: str,
        out: var int64): bool =
    if text.len == 0 ||
       (text.len > 1 && text[0] == '0'):
        return false
    var value: int64
    for i in 0..<text.len:
        let ch = int32(text[i])
        if ch < int32('0') || ch > int32('9'):
            return false
        let digit = int64(ch - int32('0'))
        if value >
           (CsgMerkleTransactionReceiptMaxGeneration - digit) / 10:
            return false
        value = value * 10 + digit
    if value <= 0 ||
       value > CsgMerkleTransactionReceiptMaxGeneration:
        return false
    out = value
    return true

@borrows
fn csgReceiptIndexText(index: int32): str =
    if index < 0:
        return ""
    let raw = strings.IntToStr(index)
    if raw.len > 10:
        return ""
    var out: str
    for _ in 0..<(10 - raw.len):
        csgReceiptAppend(out, "0")
    csgReceiptAppend(out, raw)
    return out

@borrows
fn csgReceiptIndexedId(
        prefix: str,
        index: int32): str =
    return csgReceiptCat(
        prefix, csgReceiptIndexText(index))

@borrows
fn csgReceiptFail(
        error: str):
        CsgCoreMerkleTransactionReceiptCodecResult =
    var out: CsgCoreMerkleTransactionReceiptCodecResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgReceiptCidError(
        label: str,
        cid: str): str =
    if merkle_store_codec.CsgCoreMerkleStoreCidValid(
           cid):
        return ""
    return csgReceiptCat(label, "_invalid")

@borrows
fn csgReceiptOperationCidsError(
        values: str[]): str =
    if values.len >
       CsgMerkleTransactionReceiptMaxOperationCount:
        return "merkle_transaction_receipt_operation_count_limit_exceeded"
    for i in 0..<values.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               values[i]):
            return "merkle_transaction_receipt_operation_cid_invalid"
    let order = csgReceiptTextOrder(values)
    for i in 1..<order.len:
        if values[order[i - 1]] == values[order[i]]:
            return "merkle_transaction_receipt_operation_duplicate"
    return ""

@borrows
fn csgReceiptReachableNodeCidsError(
        values: str[]): str =
    if values.len >
       CsgMerkleTransactionReceiptMaxReachableNodeCount:
        return "merkle_transaction_receipt_reachable_node_count_limit_exceeded"
    for i in 0..<values.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               values[i]):
            return "merkle_transaction_receipt_reachable_node_cid_invalid"
        if i > 0:
            let order = csgReceiptTextCompare(
                values[i - 1], values[i])
            if order == 0:
                return "merkle_transaction_receipt_reachable_node_duplicate"
            if order > 0:
                return "merkle_transaction_receipt_reachable_nodes_not_sorted"
    return ""

@borrows
fn csgReceiptTransitionError(
        receipt: CsgCoreMerkleTransactionReceipt): str =
    if receipt.operationCids.len == 0:
        if receipt.reachableNewNodeCids.len != 0 ||
           receipt.beforeManifestCid !=
               receipt.afterManifestCid ||
           receipt.beforeCsgcDirectoryCid !=
               receipt.afterCsgcDirectoryCid ||
           receipt.beforeFactsRoot !=
               receipt.afterFactsRoot ||
           receipt.beforeDagRootCid !=
               receipt.afterDagRootCid ||
           receipt.beforeFactCount !=
               receipt.afterFactCount:
            return "merkle_transaction_receipt_noop_transition_invalid"
        return "merkle_transaction_receipt_zero_operation_not_publishable"

    var expectedFactCount =
        int64(receipt.beforeFactCount)
    for i in 0..<receipt.plannedOperationKinds.len:
        let operationKind =
            receipt.plannedOperationKinds[i]
        if operationKind == 1:
            expectedFactCount = expectedFactCount - int64(1)
        elif operationKind == 3:
            expectedFactCount = expectedFactCount + int64(1)
        elif operationKind != 2:
            return "merkle_transaction_receipt_operation_kind_invalid"
        if expectedFactCount < 0 ||
           expectedFactCount > int64(2147483647):
            return "merkle_transaction_receipt_fact_count_transition_invalid"
    if expectedFactCount != int64(receipt.afterFactCount):
        return "merkle_transaction_receipt_fact_count_transition_mismatch"
    if receipt.beforeManifestCid ==
           receipt.afterManifestCid ||
       receipt.beforeCsgcDirectoryCid ==
           receipt.afterCsgcDirectoryCid ||
       receipt.beforeFactsRoot ==
           receipt.afterFactsRoot ||
       receipt.beforeDagRootCid ==
           receipt.afterDagRootCid:
        return "merkle_transaction_receipt_state_binding_unchanged"
    return ""

@borrows
fn CsgCoreMerkleTransactionReceiptError(
        receipt: CsgCoreMerkleTransactionReceipt): str =
    if receipt.schema !=
       CsgMerkleTransactionReceiptSchema:
        return "merkle_transaction_receipt_schema_invalid"
    if receipt.generation <= 0 ||
       receipt.generation >
           CsgMerkleTransactionReceiptMaxGeneration:
        return "merkle_transaction_receipt_generation_invalid"
    let beforeHeadError = csgReceiptCidError(
        "merkle_transaction_receipt_before_head_cid",
        receipt.beforeHeadCid)
    if beforeHeadError.len > 0:
        return beforeHeadError
    let beforeManifestError = csgReceiptCidError(
        "merkle_transaction_receipt_before_manifest_cid",
        receipt.beforeManifestCid)
    if beforeManifestError.len > 0:
        return beforeManifestError
    let afterManifestError = csgReceiptCidError(
        "merkle_transaction_receipt_after_manifest_cid",
        receipt.afterManifestCid)
    if afterManifestError.len > 0:
        return afterManifestError
    let beforeDirectoryError = csgReceiptCidError(
        "merkle_transaction_receipt_before_csgc_directory_cid",
        receipt.beforeCsgcDirectoryCid)
    if beforeDirectoryError.len > 0:
        return beforeDirectoryError
    let afterDirectoryError = csgReceiptCidError(
        "merkle_transaction_receipt_after_csgc_directory_cid",
        receipt.afterCsgcDirectoryCid)
    if afterDirectoryError.len > 0:
        return afterDirectoryError
    if receipt.beforeFactCount <= 0 ||
       receipt.afterFactCount <= 0:
        return "merkle_transaction_receipt_fact_count_invalid"
    let beforeFactsError = csgReceiptCidError(
        "merkle_transaction_receipt_before_facts_root",
        receipt.beforeFactsRoot)
    if beforeFactsError.len > 0:
        return beforeFactsError
    let afterFactsError = csgReceiptCidError(
        "merkle_transaction_receipt_after_facts_root",
        receipt.afterFactsRoot)
    if afterFactsError.len > 0:
        return afterFactsError
    let beforeDagError = csgReceiptCidError(
        "merkle_transaction_receipt_before_dag_root_cid",
        receipt.beforeDagRootCid)
    if beforeDagError.len > 0:
        return beforeDagError
    let afterDagError = csgReceiptCidError(
        "merkle_transaction_receipt_after_dag_root_cid",
        receipt.afterDagRootCid)
    if afterDagError.len > 0:
        return afterDagError
    let invalidationError = csgReceiptCidError(
        "merkle_transaction_receipt_invalidation_cid",
        receipt.invalidationCid)
    if invalidationError.len > 0:
        return invalidationError
    let operationError =
        csgReceiptOperationCidsError(
            receipt.operationCids)
    if operationError.len > 0:
        return operationError
    if receipt.plannedOperationKinds.len !=
           receipt.operationCids.len ||
       receipt.plannedOperationFactKeys.len !=
           receipt.operationCids.len:
        return "merkle_transaction_receipt_planned_operation_shape_invalid"
    let transitionError =
        csgReceiptTransitionError(receipt)
    if transitionError.len > 0:
        return transitionError
    let reachableError =
        csgReceiptReachableNodeCidsError(
            receipt.reachableNewNodeCids)
    if reachableError.len > 0:
        return reachableError
    let requestCidError = csgReceiptCidError(
        "merkle_transaction_receipt_request_cid",
        receipt.requestCid)
    if requestCidError.len > 0:
        return requestCidError
    let planRootError = csgReceiptCidError(
        "merkle_transaction_receipt_plan_root",
        receipt.planRoot)
    if planRootError.len > 0:
        return planRootError
    let durableBindings = [
        strings.CloneStr(receipt.beforeStoreIdentity),
        strings.CloneStr(receipt.sealedBeforeContentCid),
        strings.CloneStr(receipt.semanticCarrierCid),
        strings.CloneStr(receipt.projectionReceiptCid),
        strings.CloneStr(receipt.proofCid),
        strings.CloneStr(receipt.artifactClosureCid)]
    for i in 0..<durableBindings.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               durableBindings[i]):
            return "merkle_transaction_receipt_durable_binding_invalid"
    if receipt.operationCids.len != 1 ||
       receipt.proofCid.len == 0:
        return "merkle_transaction_receipt_single_replace_binding_invalid"
    return ""

@borrows
fn csgReceiptHeaderLine(
        receipt: CsgCoreMerkleTransactionReceipt,
        operationCount: int32,
        reachableNewNodeCount: int32): str =
    var out: str = "{\"after_csgc_directory_cid\":"
    csgReceiptAppend(
        out,
        csgReceiptJson(
            receipt.afterCsgcDirectoryCid))
    csgReceiptAppend(out, ",\"after_dag_root_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.afterDagRootCid))
    csgReceiptAppend(out, ",\"after_fact_count\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            strings.IntToStr(receipt.afterFactCount)))
    csgReceiptAppend(out, ",\"after_facts_root\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.afterFactsRoot))
    csgReceiptAppend(out, ",\"after_manifest_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.afterManifestCid))
    csgReceiptAppend(out, ",\"artifact_closure_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.artifactClosureCid))
    csgReceiptAppend(out, ",\"before_csgc_directory_cid\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            receipt.beforeCsgcDirectoryCid))
    csgReceiptAppend(out, ",\"before_dag_root_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.beforeDagRootCid))
    csgReceiptAppend(out, ",\"before_fact_count\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            strings.IntToStr(receipt.beforeFactCount)))
    csgReceiptAppend(out, ",\"before_facts_root\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.beforeFactsRoot))
    csgReceiptAppend(out, ",\"before_head_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.beforeHeadCid))
    csgReceiptAppend(out, ",\"before_manifest_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.beforeManifestCid))
    csgReceiptAppend(out, ",\"before_store_identity\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.beforeStoreIdentity))
    csgReceiptAppend(out, ",\"generation\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            strings.Int64ToStr(receipt.generation)))
    csgReceiptAppend(out, ",\"id\":\"receipt\"")
    csgReceiptAppend(out, ",\"invalidation_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.invalidationCid))
    csgReceiptAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_receipt\"")
    csgReceiptAppend(out, ",\"operation_count\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            strings.IntToStr(operationCount)))
    csgReceiptAppend(out, ",\"plan_root\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.planRoot))
    csgReceiptAppend(out, ",\"projection_receipt_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.projectionReceiptCid))
    csgReceiptAppend(out, ",\"proof_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.proofCid))
    csgReceiptAppend(
        out, ",\"reachable_new_node_count\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            strings.IntToStr(reachableNewNodeCount)))
    csgReceiptAppend(out, ",\"request_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.requestCid))
    csgReceiptAppend(out, ",\"schema\":")
    csgReceiptAppend(out, csgReceiptJson(receipt.schema))
    csgReceiptAppend(out, ",\"sealed_before_content_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.sealedBeforeContentCid))
    csgReceiptAppend(out, ",\"semantic_carrier_cid\":")
    csgReceiptAppend(
        out, csgReceiptJson(receipt.semanticCarrierCid))
    csgReceiptAppend(out, "}")
    return out

@borrows
fn csgReceiptOperationLine(
        index: int32,
        operationCid: str,
        operationKind: int32,
        operationFactKey: str): str =
    var out: str = "{\"fact_key\":"
    csgReceiptAppend(
        out, csgReceiptJson(operationFactKey))
    csgReceiptAppend(out, ",\"id\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            csgReceiptIndexedId(
                "operation:", index)))
    csgReceiptAppend(out, ",\"index\":")
    csgReceiptAppend(
        out, csgReceiptJson(strings.IntToStr(index)))
    csgReceiptAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_operation_ref\"")
    csgReceiptAppend(out, ",\"operation_cid\":")
    csgReceiptAppend(out, csgReceiptJson(operationCid))
    csgReceiptAppend(out, ",\"operation_kind\":")
    csgReceiptAppend(
        out,
        csgReceiptJson(
            strings.IntToStr(operationKind)))
    csgReceiptAppend(out, "}")
    return out

@borrows
fn csgReceiptReachableNodeLine(
        index: int32,
        nodeCid: str): str =
    var out: str = "{\"id\":"
    csgReceiptAppend(
        out,
        csgReceiptJson(
            csgReceiptIndexedId(
                "reachable-new-node:", index)))
    csgReceiptAppend(out, ",\"index\":")
    csgReceiptAppend(
        out, csgReceiptJson(strings.IntToStr(index)))
    csgReceiptAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_reachable_new_node\"")
    csgReceiptAppend(out, ",\"node_cid\":")
    csgReceiptAppend(out, csgReceiptJson(nodeCid))
    csgReceiptAppend(out, "}")
    return out

@borrows
fn csgReceiptLines(
        receipt: CsgCoreMerkleTransactionReceipt): str[] =
    var lines: str[]
    add(
        lines,
        csgReceiptHeaderLine(
            receipt,
            receipt.operationCids.len,
            receipt.reachableNewNodeCids.len))
    for i in 0..<receipt.operationCids.len:
        add(
            lines,
            csgReceiptOperationLine(
                i,
                receipt.operationCids[i],
                receipt.plannedOperationKinds[i],
                receipt.plannedOperationFactKeys[i]))
    for i in 0..<receipt.reachableNewNodeCids.len:
        add(
            lines,
            csgReceiptReachableNodeLine(
                i, receipt.reachableNewNodeCids[i]))
    return lines

@borrows
fn csgReceiptDecodeHeader(
        line: str,
        receipt: var CsgCoreMerkleTransactionReceipt,
        operationCount: var int32,
        reachableNewNodeCount: var int32,
        error: var str): bool =
    var idText: str
    var generationText: str
    var afterFactCountText: str
    var beforeFactCountText: str
    var operationCountText: str
    var reachableNewNodeCountText: str
    if !csgReceiptStringField(
           line,
           "artifact_closure_cid",
           receipt.artifactClosureCid) ||
       !csgReceiptStringField(
           line,
           "after_csgc_directory_cid",
           receipt.afterCsgcDirectoryCid) ||
       !csgReceiptStringField(
           line,
           "after_dag_root_cid",
           receipt.afterDagRootCid) ||
       !csgReceiptStringField(
           line,
           "after_fact_count",
           afterFactCountText) ||
       !csgReceiptStringField(
           line,
           "after_facts_root",
           receipt.afterFactsRoot) ||
        !csgReceiptStringField(
           line,
           "after_manifest_cid",
           receipt.afterManifestCid) ||
       !csgReceiptStringField(
           line,
           "before_csgc_directory_cid",
           receipt.beforeCsgcDirectoryCid) ||
       !csgReceiptStringField(
           line,
           "before_dag_root_cid",
           receipt.beforeDagRootCid) ||
       !csgReceiptStringField(
           line,
           "before_fact_count",
           beforeFactCountText) ||
       !csgReceiptStringField(
           line,
           "before_facts_root",
           receipt.beforeFactsRoot) ||
       !csgReceiptStringField(
           line,
           "before_head_cid",
           receipt.beforeHeadCid) ||
        !csgReceiptStringField(
            line,
            "before_manifest_cid",
            receipt.beforeManifestCid) ||
       !csgReceiptStringField(
           line,
           "before_store_identity",
           receipt.beforeStoreIdentity) ||
        !csgReceiptStringField(
            line, "generation", generationText) ||
        !csgReceiptStringField(line, "id", idText) ||
       !csgReceiptStringField(
           line,
           "invalidation_cid",
           receipt.invalidationCid) ||
       !csgReceiptStringField(
           line,
           "operation_count",
           operationCountText) ||
       !csgReceiptStringField(
           line, "plan_root", receipt.planRoot) ||
       !csgReceiptStringField(
           line,
           "projection_receipt_cid",
           receipt.projectionReceiptCid) ||
       !csgReceiptStringField(
           line, "proof_cid", receipt.proofCid) ||
       !csgReceiptStringField(
           line,
           "reachable_new_node_count",
           reachableNewNodeCountText) ||
       !csgReceiptStringField(
           line, "request_cid", receipt.requestCid) ||
       !csgReceiptStringField(
           line, "schema", receipt.schema) ||
       !csgReceiptStringField(
           line,
           "sealed_before_content_cid",
           receipt.sealedBeforeContentCid) ||
       !csgReceiptStringField(
           line,
           "semantic_carrier_cid",
           receipt.semanticCarrierCid) ||
       !csgReceiptInt32(
           afterFactCountText,
           receipt.afterFactCount) ||
       !csgReceiptInt32(
           beforeFactCountText,
           receipt.beforeFactCount) ||
       !csgReceiptInt32(
           operationCountText,
           operationCount) ||
        !csgReceiptInt32(
            reachableNewNodeCountText,
            reachableNewNodeCount) ||
        !csgReceiptInt64(
            generationText,
            receipt.generation):
        error =
            "merkle_transaction_receipt_header_field_invalid"
        return false
    if idText != "receipt" ||
       csgReceiptHeaderLine(
           receipt,
           operationCount,
           reachableNewNodeCount) != line:
        error =
            "merkle_transaction_receipt_header_non_canonical"
        return false
    return true

@borrows
fn csgReceiptDecodeOperation(
        line: str,
        index: var int32,
        operationCid: var str,
        operationKind: var int32,
        operationFactKey: var str,
        error: var str): bool =
    var idText: str
    var indexText: str
    var operationKindText: str
    if !csgReceiptStringField(
           line, "fact_key", operationFactKey) ||
       !csgReceiptStringField(line, "id", idText) ||
       !csgReceiptStringField(line, "index", indexText) ||
       !csgReceiptStringField(
           line, "operation_cid", operationCid) ||
       !csgReceiptStringField(
           line, "operation_kind", operationKindText) ||
       !csgReceiptInt32(indexText, index) ||
       !csgReceiptInt32(
           operationKindText, operationKind):
        error =
            "merkle_transaction_receipt_operation_field_invalid"
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           operationCid):
        error =
            "merkle_transaction_receipt_operation_cid_invalid"
        return false
    if operationKind < 1 || operationKind > 3:
        error =
            "merkle_transaction_receipt_operation_kind_invalid"
        return false
    if operationFactKey.len == 0:
        error =
            "merkle_transaction_receipt_operation_fact_key_invalid"
        return false
    if idText !=
           csgReceiptIndexedId(
               "operation:", index) ||
       csgReceiptOperationLine(
           index,
           operationCid,
           operationKind,
           operationFactKey) != line:
        error =
            "merkle_transaction_receipt_operation_non_canonical"
        return false
    return true

@borrows
fn csgReceiptDecodeReachableNode(
        line: str,
        index: var int32,
        nodeCid: var str,
        error: var str): bool =
    var idText: str
    var indexText: str
    if !csgReceiptStringField(line, "id", idText) ||
       !csgReceiptStringField(line, "index", indexText) ||
       !csgReceiptStringField(
           line, "node_cid", nodeCid) ||
       !csgReceiptInt32(indexText, index):
        error =
            "merkle_transaction_receipt_node_field_invalid"
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           nodeCid):
        error =
            "merkle_transaction_receipt_reachable_node_cid_invalid"
        return false
    if idText !=
           csgReceiptIndexedId(
               "reachable-new-node:", index) ||
       csgReceiptReachableNodeLine(
           index, nodeCid) != line:
        error =
            "merkle_transaction_receipt_node_non_canonical"
        return false
    return true

fn CsgCoreMerkleTransactionReceiptCodecDropLines(
        result: var CsgCoreMerkleTransactionReceiptCodecResult) =
    var dropLines = result.lines
    result.lines = []

@borrows
fn csgReceiptParseLines(
        lines: str[],
        receipt: var CsgCoreMerkleTransactionReceipt,
        error: var str): bool =
    receipt = CsgCoreMerkleTransactionReceipt()
    error = ""
    if lines.len <= 0:
        error = "merkle_transaction_receipt_empty"
        return false
    if lines.len > CsgMerkleTransactionReceiptMaxLineCount:
        error =
            "merkle_transaction_receipt_line_count_limit_exceeded"
        return false

    var headerSeen: bool
    var operationCount: int32
    var reachableNewNodeCount: int32
    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if !kind.found:
            error =
                "merkle_transaction_receipt_kind_missing"
            return false
        if kind.value ==
           CsgMerkleTransactionReceiptKind:
            if headerSeen:
                error =
                    "merkle_transaction_receipt_header_duplicate"
                return false
            if !csgReceiptDecodeHeader(
                   lines[i],
                   receipt,
                   operationCount,
                   reachableNewNodeCount,
                   error):
                return false
            headerSeen = true
        elif kind.value !=
             CsgMerkleTransactionOperationRefKind &&
             kind.value !=
             CsgMerkleTransactionReachableNodeKind:
            error =
                "merkle_transaction_receipt_kind_invalid"
            return false
    if !headerSeen:
        error =
            "merkle_transaction_receipt_header_missing"
        return false
    if operationCount > lines.len - 1 ||
       reachableNewNodeCount > lines.len - 1 ||
       int64(operationCount) +
           int64(reachableNewNodeCount) !=
           int64(lines.len - 1):
        error =
            "merkle_transaction_receipt_count_mismatch"
        return false
    if operationCount >
       CsgMerkleTransactionReceiptMaxOperationCount:
        error =
            "merkle_transaction_receipt_operation_count_limit_exceeded"
        return false
    if reachableNewNodeCount >
       CsgMerkleTransactionReceiptMaxReachableNodeCount:
        error =
            "merkle_transaction_receipt_reachable_node_count_limit_exceeded"
        return false

    setLen(
        receipt.operationCids,
        operationCount)
    setLen(
        receipt.plannedOperationKinds,
        operationCount)
    setLen(
        receipt.plannedOperationFactKeys,
        operationCount)
    setLen(
        receipt.reachableNewNodeCids,
        reachableNewNodeCount)
    var operationSeen: bool[]
    var nodeSeen: bool[]
    setLen(operationSeen, operationCount)
    setLen(nodeSeen, reachableNewNodeCount)

    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if kind.value ==
           CsgMerkleTransactionOperationRefKind:
            var index: int32
            var operationCid: str
            var operationKind: int32
            var operationFactKey: str
            if !csgReceiptDecodeOperation(
                   lines[i],
                   index,
                   operationCid,
                   operationKind,
                   operationFactKey,
                   error):
                return false
            if index < 0 ||
               index >= operationCount:
                error =
                    "merkle_transaction_receipt_operation_index_out_of_range"
                return false
            if operationSeen[index]:
                error =
                    "merkle_transaction_receipt_operation_index_duplicate"
                return false
            operationSeen[index] = true
            receipt.operationCids[index] = operationCid
            receipt.plannedOperationKinds[index] =
                operationKind
            receipt.plannedOperationFactKeys[index] =
                operationFactKey
        elif kind.value ==
             CsgMerkleTransactionReachableNodeKind:
            var index: int32
            var nodeCid: str
            if !csgReceiptDecodeReachableNode(
                   lines[i], index, nodeCid, error):
                return false
            if index < 0 ||
               index >= reachableNewNodeCount:
                error =
                    "merkle_transaction_receipt_node_index_out_of_range"
                return false
            if nodeSeen[index]:
                error =
                    "merkle_transaction_receipt_node_index_duplicate"
                return false
            nodeSeen[index] = true
            receipt.reachableNewNodeCids[index] = nodeCid

    for i in 0..<operationSeen.len:
        if !operationSeen[i]:
            error =
                "merkle_transaction_receipt_operation_index_missing"
            return false
    for i in 0..<nodeSeen.len:
        if !nodeSeen[i]:
            error =
                "merkle_transaction_receipt_node_index_missing"
            return false
    error = CsgCoreMerkleTransactionReceiptError(
        receipt)
    return error.len == 0

fn csgReceiptParseAndReleaseLines(
        lines: var str[],
        receipt: var CsgCoreMerkleTransactionReceipt,
        error: var str): bool =
    if !csgReceiptParseLines(lines, receipt, error):
        return false
    var dropLines = lines
    lines = []
    return true

@borrows
fn csgReceiptSameStrings(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn csgReceiptSameInt32s(
        left: int32[],
        right: int32[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn csgReceiptSame(
        left: CsgCoreMerkleTransactionReceipt,
        right: CsgCoreMerkleTransactionReceipt): bool =
    return left.schema == right.schema &&
        left.generation == right.generation &&
        left.requestCid == right.requestCid &&
        left.planRoot == right.planRoot &&
        left.beforeStoreIdentity == right.beforeStoreIdentity &&
        left.sealedBeforeContentCid == right.sealedBeforeContentCid &&
        left.semanticCarrierCid == right.semanticCarrierCid &&
        left.projectionReceiptCid == right.projectionReceiptCid &&
        left.proofCid == right.proofCid &&
        left.artifactClosureCid == right.artifactClosureCid &&
        left.beforeHeadCid == right.beforeHeadCid &&
        left.beforeManifestCid == right.beforeManifestCid &&
        left.afterManifestCid == right.afterManifestCid &&
        left.beforeCsgcDirectoryCid ==
            right.beforeCsgcDirectoryCid &&
        left.afterCsgcDirectoryCid ==
            right.afterCsgcDirectoryCid &&
        left.beforeFactsRoot == right.beforeFactsRoot &&
        left.afterFactsRoot == right.afterFactsRoot &&
        left.beforeDagRootCid == right.beforeDagRootCid &&
        left.afterDagRootCid == right.afterDagRootCid &&
        left.beforeFactCount == right.beforeFactCount &&
        left.afterFactCount == right.afterFactCount &&
        left.invalidationCid == right.invalidationCid &&
        csgReceiptSameInt32s(
            left.plannedOperationKinds,
            right.plannedOperationKinds) &&
        csgReceiptSameStrings(
            left.plannedOperationFactKeys,
            right.plannedOperationFactKeys) &&
        csgReceiptSameStrings(
            left.operationCids,
            right.operationCids) &&
        csgReceiptSameStrings(
            left.reachableNewNodeCids,
            right.reachableNewNodeCids)

@borrows
fn CsgCoreMerkleTransactionAuthorityReceiptError(
        receipt: CsgCoreMerkleTransactionAuthorityReceipt): str =
    if receipt.generation <= 0 ||
       receipt.beforeFactCount <= 0 ||
       receipt.beforeFactCount != receipt.afterFactCount:
        return "merkle_transaction_authority_receipt_count_invalid"
    if receipt.beforeManifestCid == receipt.afterManifestCid ||
       receipt.beforeFactsRoot == receipt.afterFactsRoot ||
       receipt.beforeDagRootCid == receipt.afterDagRootCid:
        return "merkle_transaction_authority_receipt_unchanged"
    let cids = [
        strings.CloneStr(receipt.beforeStoreIdentity),
        strings.CloneStr(receipt.sealedBeforeContentCid),
        strings.CloneStr(receipt.semanticPlanRoot),
        strings.CloneStr(receipt.semanticCarrierCid),
        strings.CloneStr(receipt.projectionReceiptCid),
        strings.CloneStr(receipt.finalManifestCid),
        strings.CloneStr(receipt.beforeHeadCid),
        strings.CloneStr(receipt.beforeManifestCid),
        strings.CloneStr(receipt.afterManifestCid),
        strings.CloneStr(receipt.beforeFactsRoot),
        strings.CloneStr(receipt.afterFactsRoot),
        strings.CloneStr(receipt.beforeDagRootCid),
        strings.CloneStr(receipt.afterDagRootCid),
        strings.CloneStr(receipt.operationCid),
        strings.CloneStr(receipt.proofCid),
        strings.CloneStr(receipt.artifactClosureCid)]
    for i in 0..<cids.len:
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(cids[i]):
            return "merkle_transaction_authority_receipt_cid_invalid"
    if receipt.finalManifestCid != receipt.afterManifestCid:
        return "merkle_transaction_authority_receipt_manifest_mismatch"
    return ""

fn csgAuthorityReceiptAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgAuthorityReceiptAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgAuthorityReceiptAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

@borrows
fn CsgCoreMerkleTransactionAuthorityReceiptCid(
        receipt: CsgCoreMerkleTransactionAuthorityReceipt):
        CsgCoreMerkleTransactionAuthorityReceiptCidResult =
    var out: CsgCoreMerkleTransactionAuthorityReceiptCidResult
    let error =
        CsgCoreMerkleTransactionAuthorityReceiptError(receipt)
    if error.len > 0:
        out.error = strings.CloneStr(error)
        return out
    var preimage = layout.ByteBufInit(2048)
    csgAuthorityReceiptAppendText(
        preimage, strings.Int64ToStr(receipt.generation))
    csgAuthorityReceiptAppendText(
        preimage, receipt.beforeStoreIdentity)
    csgAuthorityReceiptAppendText(
        preimage, receipt.sealedBeforeContentCid)
    csgAuthorityReceiptAppendText(preimage, receipt.semanticPlanRoot)
    csgAuthorityReceiptAppendText(preimage, receipt.semanticCarrierCid)
    csgAuthorityReceiptAppendText(preimage, receipt.projectionReceiptCid)
    csgAuthorityReceiptAppendText(preimage, receipt.finalManifestCid)
    csgAuthorityReceiptAppendText(preimage, receipt.beforeHeadCid)
    csgAuthorityReceiptAppendText(preimage, receipt.beforeManifestCid)
    csgAuthorityReceiptAppendText(preimage, receipt.afterManifestCid)
    csgAuthorityReceiptAppendText(preimage, receipt.beforeFactsRoot)
    csgAuthorityReceiptAppendText(preimage, receipt.afterFactsRoot)
    csgAuthorityReceiptAppendText(preimage, receipt.beforeDagRootCid)
    csgAuthorityReceiptAppendText(preimage, receipt.afterDagRootCid)
    csgAuthorityReceiptAppendText(
        preimage, strings.IntToStr(receipt.beforeFactCount))
    csgAuthorityReceiptAppendText(
        preimage, strings.IntToStr(receipt.afterFactCount))
    csgAuthorityReceiptAppendText(preimage, receipt.operationCid)
    csgAuthorityReceiptAppendText(preimage, receipt.proofCid)
    csgAuthorityReceiptAppendText(preimage, receipt.artifactClosureCid)
    # Spec migration: ByteBufView yields a ByteSpan view, while BytesCopyInto's
    # src formal requires the exact Bytes domain. ByteSpanToBytes is the exact
    # owned-copy converter (BytesAlloc + RawmemCopy) and replaces the manual
    # alloc/copy pair below-free.
    var ownedBytes = layout.ByteSpanToBytes(layout.ByteBufView(preimage))
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionAuthorityReceiptDomain,
            ownedBytes)
    rawbytes.BytesFree(ownedBytes)
    layout.ByteBufFree(preimage)
    return out

@borrows
fn CsgCoreMerkleTransactionReceiptEncode(
        receipt: CsgCoreMerkleTransactionReceipt):
        CsgCoreMerkleTransactionReceiptCodecResult =
    let receiptError =
        CsgCoreMerkleTransactionReceiptError(receipt)
    if receiptError.len > 0:
        return csgReceiptFail(receiptError)
    var sourceLines = csgReceiptLines(receipt)
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLinesConsume(
            sourceLines)
    seqs.freeSeqStrRelease(sourceLines)
    if !encoded.ok:
        return csgReceiptFail(
            csgReceiptCat(
                "merkle_transaction_receipt_encode ",
                encoded.error))
    var out: CsgCoreMerkleTransactionReceiptCodecResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionReceiptDomain,
            encoded.bytes)
    out.factCount = encoded.factCount
    out.receipt = receipt
    out.bytes = encoded.bytes
    return out

fn csgReceiptEnsureCount(
        items: var str[],
        count: int32): bool =
    if count < 0:
        return false
    if items.len > count:
        return false
    if items.len < count:
        setLen(items, count)
    return true

fn csgReceiptEnsureIndex(
        items: var str[],
        seen: var bool[],
        headerSeen: bool,
        count: int32,
        index: int32): bool =
    if index < 0:
        return false
    if headerSeen:
        return index < count && index < items.len && index < seen.len
    if index >= items.len:
        setLen(items, index + 1)
    if index >= seen.len:
        setLen(seen, index + 1)
    return true

fn csgReceiptEnsureInt32Count(
        items: var int32[],
        count: int32): bool =
    if count < 0:
        return false
    if items.len > count:
        return false
    if items.len < count:
        setLen(items, count)
    return true

fn csgReceiptEnsureInt32Index(
        items: var int32[],
        headerSeen: bool,
        count: int32,
        index: int32): bool =
    if index < 0:
        return false
    if headerSeen:
        return index < count && index < items.len
    if index >= items.len:
        setLen(items, index + 1)
    return true

fn csgReceiptParseStream(
        bytes: rawbytes.Bytes,
        stream: var csgc.CsgCoreCsgcFactLineStream,
        receipt: var CsgCoreMerkleTransactionReceipt,
        error: var str): bool =
    receipt = CsgCoreMerkleTransactionReceipt()
    error = ""
    var headerSeen: bool
    var operationCount: int32
    var reachableNewNodeCount: int32
    var operationSeen: bool[]
    var nodeSeen: bool[]
    var scanning = true
    while scanning:
        var item = csgc.CsgCoreCsgcFactLineStreamNext(bytes, stream)
        if !item.ok:
            error = strings.CloneStr(item.error)
            var dropFailedLine = item.line
            item.line = ""
            return false
        if item.done:
            scanning = false
            continue
        var line = item.line
        item.line = ""
        let kind = field.CsgCoreJsonKind(line)
        if !kind.found:
            error = "merkle_transaction_receipt_kind_missing"
            var dropLine = line
            line = ""
            return false
        if kind.value == CsgMerkleTransactionReceiptKind:
            if headerSeen:
                error = "merkle_transaction_receipt_header_duplicate"
                var dropLine = line
                line = ""
                return false
            if !csgReceiptDecodeHeader(
                   line,
                   receipt,
                   operationCount,
                   reachableNewNodeCount,
                   error):
                var dropLine = line
                line = ""
                return false
            headerSeen = true
            if operationCount >
               CsgMerkleTransactionReceiptMaxOperationCount:
                error =
                    "merkle_transaction_receipt_operation_count_limit_exceeded"
                var dropLine = line
                line = ""
                return false
            if reachableNewNodeCount >
               CsgMerkleTransactionReceiptMaxReachableNodeCount:
                error =
                    "merkle_transaction_receipt_reachable_node_count_limit_exceeded"
                var dropLine = line
                line = ""
                return false
            if !csgReceiptEnsureCount(
                   receipt.operationCids, operationCount) ||
               !csgReceiptEnsureInt32Count(
                   receipt.plannedOperationKinds, operationCount) ||
               !csgReceiptEnsureCount(
                   receipt.plannedOperationFactKeys, operationCount) ||
               !csgReceiptEnsureCount(
                   receipt.reachableNewNodeCids,
                   reachableNewNodeCount):
                error = "merkle_transaction_receipt_count_mismatch"
                var dropLine = line
                line = ""
                return false
            if operationSeen.len > operationCount ||
               nodeSeen.len > reachableNewNodeCount:
                error = "merkle_transaction_receipt_count_mismatch"
                var dropLine = line
                line = ""
                return false
            if operationSeen.len < operationCount:
                setLen(operationSeen, operationCount)
            if nodeSeen.len < reachableNewNodeCount:
                setLen(nodeSeen, reachableNewNodeCount)
        elif kind.value == CsgMerkleTransactionOperationRefKind:
            var index: int32
            var operationCid: str
            var operationKind: int32
            var operationFactKey: str
            if !csgReceiptDecodeOperation(
                   line,
                   index,
                   operationCid,
                   operationKind,
                   operationFactKey,
                   error):
                var dropLine = line
                line = ""
                return false
            if !csgReceiptEnsureIndex(
                   receipt.operationCids,
                   operationSeen,
                   headerSeen,
                   operationCount,
                   index) ||
               !csgReceiptEnsureInt32Index(
                   receipt.plannedOperationKinds,
                   headerSeen,
                   operationCount,
                   index) ||
               !csgReceiptEnsureCount(
                   receipt.plannedOperationFactKeys,
                   receipt.operationCids.len):
                error =
                    "merkle_transaction_receipt_operation_index_out_of_range"
                var dropLine = line
                line = ""
                return false
            if index >= receipt.plannedOperationFactKeys.len:
                setLen(
                    receipt.plannedOperationFactKeys,
                    receipt.operationCids.len)
            if operationSeen[index]:
                error =
                    "merkle_transaction_receipt_operation_index_duplicate"
                var dropLine = line
                line = ""
                return false
            operationSeen[index] = true
            receipt.operationCids[index] = operationCid
            receipt.plannedOperationKinds[index] = operationKind
            receipt.plannedOperationFactKeys[index] = operationFactKey
        elif kind.value == CsgMerkleTransactionReachableNodeKind:
            var index: int32
            var nodeCid: str
            if !csgReceiptDecodeReachableNode(
                   line, index, nodeCid, error):
                var dropLine = line
                line = ""
                return false
            if !csgReceiptEnsureIndex(
                   receipt.reachableNewNodeCids,
                   nodeSeen,
                   headerSeen,
                   reachableNewNodeCount,
                   index):
                error =
                    "merkle_transaction_receipt_node_index_out_of_range"
                var dropLine = line
                line = ""
                return false
            if nodeSeen[index]:
                error =
                    "merkle_transaction_receipt_node_index_duplicate"
                var dropLine = line
                line = ""
                return false
            nodeSeen[index] = true
            receipt.reachableNewNodeCids[index] = nodeCid
        else:
            error = "merkle_transaction_receipt_kind_invalid"
            var dropLine = line
            line = ""
            return false
        var dropLine = line
        line = ""
    if !headerSeen:
        error = "merkle_transaction_receipt_header_missing"
        return false
    if receipt.operationCids.len != operationCount ||
       receipt.plannedOperationKinds.len != operationCount ||
       receipt.plannedOperationFactKeys.len != operationCount ||
       receipt.reachableNewNodeCids.len != reachableNewNodeCount:
        error = "merkle_transaction_receipt_count_mismatch"
        return false
    for i in 0..<operationSeen.len:
        if !operationSeen[i]:
            error =
                "merkle_transaction_receipt_operation_index_missing"
            return false
    for i in 0..<nodeSeen.len:
        if !nodeSeen[i]:
            error =
                "merkle_transaction_receipt_node_index_missing"
            return false
    if int64(operationCount) +
           int64(reachableNewNodeCount) +
           int64(1) !=
           int64(stream.yielded):
        error = "merkle_transaction_receipt_count_mismatch"
        return false
    error = CsgCoreMerkleTransactionReceiptError(receipt)
    return error.len == 0

@borrows
fn CsgCoreMerkleTransactionReceiptDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleTransactionReceiptCodecResult =
    let directory =
        csgc.CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok:
        return csgReceiptFail(
            csgReceiptCat(
                "merkle_transaction_receipt_decode ",
                directory.error))
    if directory.factCount <= 0 ||
       directory.factCount >
           CsgMerkleTransactionReceiptMaxLineCount:
        return csgReceiptFail(
            "merkle_transaction_receipt_decode_line_count_limit_exceeded")
    var stream = csgc.CsgCoreCsgcFactLineStreamOpen(bytes)
    if !stream.ok:
        return csgReceiptFail(
            csgReceiptCat(
                "merkle_transaction_receipt_decode ",
                stream.error))
    var receipt: CsgCoreMerkleTransactionReceipt
    var parseError: str
    if !csgReceiptParseStream(
           bytes, stream, receipt, parseError):
        csgc.CsgCoreCsgcFactLineStreamClose(stream)
        return csgReceiptFail(parseError)
    csgc.CsgCoreCsgcFactLineStreamClose(stream)
    let _droppedLineRelief = os.ProcessMemoryPressureRelief()
    var out: CsgCoreMerkleTransactionReceiptCodecResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionReceiptDomain,
            bytes)
    out.factCount = directory.factCount
    out.receipt = receipt
    let byteCount = rawbytes.BytesLen(bytes)
    out.bytes = rawbytes.BytesAlloc(byteCount)
    rawbytes.BytesCopyInto(out.bytes, 0, bytes)
    # Same-compilation decode memo (memory line w49 ①): the receipt field
    # derivation is a pure function of these content-addressed bytes, so the
    # strictly validated decode result is memoized under its content digest.
    # Every read path still performs its own digest check plus binding checks;
    # only the repeated decode work is reused.
    merkle_store_codec.CsgCoreMerkleTransactionReceiptMemoInsertFromFields(
        out.cid,
        receipt.generation,
        receipt.requestCid,
        receipt.beforeHeadCid,
        receipt.beforeManifestCid,
        receipt.afterManifestCid,
        receipt.proofCid,
        receipt.operationCids.len)
    return out
