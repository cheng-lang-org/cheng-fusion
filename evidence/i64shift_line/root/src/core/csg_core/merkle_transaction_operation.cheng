import std/rawbytes
import std/json
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_cargo
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

const
    CsgMerkleTransactionOperationDomain: str =
        "csg_core.store.transaction_operation"
    CsgMerkleTransactionOperationSchema: str =
        "csg_core::v1"
    CsgMerkleTransactionOperationKind: str =
        "csg.merkle.transaction_operation"
    CsgMerkleTransactionDelete: int32 = 1
    CsgMerkleTransactionReplace: int32 = 2
    CsgMerkleTransactionInsert: int32 = 3

type
    CsgCoreMerkleTransactionOperation =
        schema: str
        kind: int32
        proofCid: str
        queryKey: str
        beforeFact: str
        beforeFactCid: str
        afterFact: str
        afterFactCid: str
        fact: str
        factCid: str
        beforeProfiles: str[]
        beforeProfileSetCid: str
        afterProfiles: str[]
        afterProfileSetCid: str
        beforeFactsRoot: str
        afterFactsRoot: str
        beforeDagRootCid: str
        afterDagRootCid: str
        beforeFactCount: int32
        afterFactCount: int32

    CsgCoreMerkleTransactionOperationCodecResult =
        ok: bool
        error: str
        cid: str
        operation: CsgCoreMerkleTransactionOperation
        lines: str[]
        bytes: rawbytes.Bytes
        proofBytes: rawbytes.Bytes

fn CsgCoreMerkleTransactionDeleteKind(): int32 =
    return CsgMerkleTransactionDelete

fn CsgCoreMerkleTransactionReplaceKind(): int32 =
    return CsgMerkleTransactionReplace

fn CsgCoreMerkleTransactionInsertKind(): int32 =
    return CsgMerkleTransactionInsert

@borrows
fn CsgCoreMerkleTransactionOperationClone(
        operation:
            CsgCoreMerkleTransactionOperation):
        CsgCoreMerkleTransactionOperation =
    var out: CsgCoreMerkleTransactionOperation
    out.schema = strings.CloneStr(operation.schema)
    out.kind = operation.kind
    out.proofCid = strings.CloneStr(operation.proofCid)
    out.queryKey = strings.CloneStr(operation.queryKey)
    out.beforeFact = strings.CloneStr(operation.beforeFact)
    out.beforeFactCid = strings.CloneStr(operation.beforeFactCid)
    out.afterFact = strings.CloneStr(operation.afterFact)
    out.afterFactCid = strings.CloneStr(operation.afterFactCid)
    out.fact = strings.CloneStr(operation.fact)
    out.factCid = strings.CloneStr(operation.factCid)
    out.beforeProfiles =
        validator.CsgCoreProfilesClone(operation.beforeProfiles)
    out.beforeProfileSetCid =
        strings.CloneStr(operation.beforeProfileSetCid)
    out.afterProfiles =
        validator.CsgCoreProfilesClone(operation.afterProfiles)
    out.afterProfileSetCid =
        strings.CloneStr(operation.afterProfileSetCid)
    out.beforeFactsRoot =
        strings.CloneStr(operation.beforeFactsRoot)
    out.afterFactsRoot =
        strings.CloneStr(operation.afterFactsRoot)
    out.beforeDagRootCid =
        strings.CloneStr(operation.beforeDagRootCid)
    out.afterDagRootCid =
        strings.CloneStr(operation.afterDagRootCid)
    out.beforeFactCount = operation.beforeFactCount
    out.afterFactCount = operation.afterFactCount
    return out

@borrows
fn csgOperationCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgOperationAppend(
        out: var str,
        value: str) =
    out = csgOperationCat(out, value)

@borrows
fn csgOperationJson(value: str): str =
    return merkle_store_codec.CsgCoreMerkleStoreJsonString(
        value)

@borrows
fn csgOperationStringArray(values: str[]): str =
    var out = "["
    for i in 0..<values.len:
        if i > 0:
            csgOperationAppend(out, ",")
        csgOperationAppend(out, csgOperationJson(values[i]))
    csgOperationAppend(out, "]")
    return out

@borrows
fn csgOperationStringArrayField(
        line: str,
        name: str,
        out: var str[]): bool =
    let raw = field.CsgCoreJsonTopRawField(line, name)
    if !raw.found:
        return false
    let parsed = json.ParseJsonSafe(raw.value)
    if !parsed.success || parsed.value.kind != json.JArray:
        return false
    for i in 0..<parsed.value.a.len:
        if parsed.value.a[i].kind != json.JString:
            return false
        add(out, strings.CloneStr(parsed.value.a[i].s))
    return true

@borrows
fn csgOperationFail(
        error: str):
        CsgCoreMerkleTransactionOperationCodecResult =
    var out: CsgCoreMerkleTransactionOperationCodecResult
    out.error = strings.CloneStr(error)
    return out

fn csgOperationKindText(kind: int32): str =
    if kind == CsgMerkleTransactionDelete:
        return "delete"
    if kind == CsgMerkleTransactionReplace:
        return "replace"
    if kind == CsgMerkleTransactionInsert:
        return "insert"
    return ""

@borrows
fn csgOperationKindParse(
        text: str,
        out: var int32): bool =
    if text == "delete":
        out = CsgMerkleTransactionDelete
        return true
    if text == "replace":
        out = CsgMerkleTransactionReplace
        return true
    if text == "insert":
        out = CsgMerkleTransactionInsert
        return true
    return false

@borrows
fn csgOperationStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(
            line, name)
    if !value.found:
        return false
    out = value.value
    return true

@borrows
fn csgOperationInt32(
        text: str,
        out: var int32): bool =
    return merkle_store_codec.CsgCoreMerkleStoreParseInt32(
        text, out) && out >= 0

@borrows
fn csgOperationFactCid(
        fact: str,
        error: var str): str =
    let hash =
        merkle_dag.CsgCoreMerkleFactHash(
            fact, error)
    if error.len > 0:
        return ""
    return csgOperationCat(
        "sha256:", layout.FixedBytes32Hex(hash))

@borrows
fn CsgCoreMerkleTransactionOperationError(
        operation:
            CsgCoreMerkleTransactionOperation): str =
    if operation.schema !=
       CsgMerkleTransactionOperationSchema:
        return "merkle_transaction_operation_schema_invalid"
    if csgOperationKindText(operation.kind).len == 0:
        return "merkle_transaction_operation_kind_invalid"
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           operation.proofCid):
        return "merkle_transaction_operation_proof_cid_invalid"
    if operation.queryKey.len == 0:
        return "merkle_transaction_operation_query_key_empty"
    let beforeProfileError =
        validator.CsgCoreProfilesCanonicalError(
            operation.beforeProfiles)
    let afterProfileError =
        validator.CsgCoreProfilesCanonicalError(
            operation.afterProfiles)
    if beforeProfileError.len > 0 ||
       afterProfileError.len > 0:
        return "merkle_transaction_operation_profiles_invalid"
    if operation.beforeProfileSetCid !=
           validator.CsgCoreProfileSetCid(
               operation.beforeProfiles) ||
       operation.afterProfileSetCid !=
           validator.CsgCoreProfileSetCid(
               operation.afterProfiles):
        return "merkle_transaction_operation_profile_set_cid_mismatch"
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           operation.beforeFactsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           operation.afterFactsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           operation.beforeDagRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           operation.afterDagRootCid):
        return "merkle_transaction_operation_root_invalid"
    if operation.beforeFactCount < 0 ||
       operation.afterFactCount < 0:
        return "merkle_transaction_operation_count_invalid"
    if operation.beforeFactsRoot ==
           operation.afterFactsRoot ||
       operation.beforeDagRootCid ==
           operation.afterDagRootCid:
        return "merkle_transaction_operation_no_state_change"
    if operation.kind != CsgMerkleTransactionReplace:
        return "merkle_transaction_operation_requires_bound_replace"
    if operation.beforeFactCount <= 0 ||
       operation.afterFactCount !=
           operation.beforeFactCount:
        return "merkle_transaction_operation_replace_count_invalid"
    if !validator.CsgCoreProfilesEqual(
           operation.beforeProfiles,
           operation.afterProfiles) ||
       operation.beforeProfileSetCid !=
           operation.afterProfileSetCid:
        return "merkle_transaction_operation_replace_binding_changed"
    if operation.fact != operation.afterFact ||
       operation.factCid != operation.afterFactCid:
        return "merkle_transaction_operation_legacy_after_alias_mismatch"
    var beforeError: str
    let canonicalBefore =
        merkle_dag.CsgCoreMerkleCanonicalFact(
            operation.beforeFact, beforeError)
    if beforeError.len > 0 ||
       canonicalBefore != operation.beforeFact:
        return "merkle_transaction_operation_before_fact_non_canonical"
    var afterError: str
    let canonicalAfter =
        merkle_dag.CsgCoreMerkleCanonicalFact(
            operation.afterFact, afterError)
    if afterError.len > 0 ||
       canonicalAfter != operation.afterFact:
        return "merkle_transaction_operation_after_fact_non_canonical"
    let beforeKey =
        merkle_dag.CsgCoreMerkleFactKey(
            canonicalBefore, beforeError)
    let afterKey =
        merkle_dag.CsgCoreMerkleFactKey(
            canonicalAfter, afterError)
    if beforeError.len > 0 || afterError.len > 0 ||
       beforeKey != operation.queryKey ||
       afterKey != operation.queryKey:
        return "merkle_transaction_operation_fact_key_mismatch"
    let beforeKind = field.CsgCoreJsonKind(canonicalBefore)
    let afterKind = field.CsgCoreJsonKind(canonicalAfter)
    if !beforeKind.found || !afterKind.found ||
       beforeKind.value != afterKind.value:
        return "merkle_transaction_operation_fact_kind_mismatch"
    if beforeKind.value == "csg.core.schema":
        return "merkle_transaction_operation_schema_mutation_forbidden"
    let localAdmission =
        validator.CsgCoreProductionValidateNamedReplacementFact(
            canonicalAfter)
    if !localAdmission.valid || !localAdmission.complete ||
       localAdmission.factCount != 1 ||
       localAdmission.factExactKinds.len != 1 ||
       localAdmission.factExactKinds[0] != afterKind.value ||
       localAdmission.replacementScope !=
           validator.CsgCoreProductionLocalNamedReplacementScope():
        return "merkle_transaction_operation_requires_admitted_bound_delta"
    let beforeFactCid =
        csgOperationFactCid(
            canonicalBefore, beforeError)
    let afterFactCid =
        csgOperationFactCid(
            canonicalAfter, afterError)
    if beforeError.len > 0 ||
       beforeFactCid != operation.beforeFactCid:
        return "merkle_transaction_operation_before_fact_cid_mismatch"
    if afterError.len > 0 ||
       afterFactCid != operation.afterFactCid:
        return "merkle_transaction_operation_after_fact_cid_mismatch"
    return ""

@borrows
fn csgOperationLine(
        operation:
            CsgCoreMerkleTransactionOperation): str =
    var out: str = "{\"after_dag_root_cid\":"
    csgOperationAppend(
        out, csgOperationJson(operation.afterDagRootCid))
    csgOperationAppend(out, ",\"after_fact\":")
    csgOperationAppend(out, csgOperationJson(operation.afterFact))
    csgOperationAppend(out, ",\"after_fact_cid\":")
    csgOperationAppend(
        out, csgOperationJson(operation.afterFactCid))
    csgOperationAppend(out, ",\"after_fact_count\":")
    csgOperationAppend(
        out,
        csgOperationJson(
            strings.IntToStr(operation.afterFactCount)))
    csgOperationAppend(out, ",\"after_facts_root\":")
    csgOperationAppend(
        out, csgOperationJson(operation.afterFactsRoot))
    csgOperationAppend(out, ",\"after_profile_set_cid\":")
    csgOperationAppend(
        out, csgOperationJson(operation.afterProfileSetCid))
    csgOperationAppend(out, ",\"after_profiles\":")
    csgOperationAppend(
        out, csgOperationStringArray(operation.afterProfiles))
    csgOperationAppend(out, ",\"before_dag_root_cid\":")
    csgOperationAppend(
        out, csgOperationJson(operation.beforeDagRootCid))
    csgOperationAppend(out, ",\"before_fact\":")
    csgOperationAppend(out, csgOperationJson(operation.beforeFact))
    csgOperationAppend(out, ",\"before_fact_cid\":")
    csgOperationAppend(
        out, csgOperationJson(operation.beforeFactCid))
    csgOperationAppend(out, ",\"before_fact_count\":")
    csgOperationAppend(
        out,
        csgOperationJson(
            strings.IntToStr(operation.beforeFactCount)))
    csgOperationAppend(out, ",\"before_facts_root\":")
    csgOperationAppend(
        out, csgOperationJson(operation.beforeFactsRoot))
    csgOperationAppend(out, ",\"before_profile_set_cid\":")
    csgOperationAppend(
        out, csgOperationJson(operation.beforeProfileSetCid))
    csgOperationAppend(out, ",\"before_profiles\":")
    csgOperationAppend(
        out, csgOperationStringArray(operation.beforeProfiles))
    csgOperationAppend(out, ",\"fact\":")
    csgOperationAppend(out, csgOperationJson(operation.fact))
    csgOperationAppend(out, ",\"fact_cid\":")
    csgOperationAppend(out, csgOperationJson(operation.factCid))
    csgOperationAppend(out, ",\"id\":\"operation\"")
    csgOperationAppend(
        out,
        ",\"kind\":\"csg.merkle.transaction_operation\"")
    csgOperationAppend(out, ",\"operation_kind\":")
    csgOperationAppend(
        out,
        csgOperationJson(
            csgOperationKindText(operation.kind)))
    csgOperationAppend(out, ",\"proof_cid\":")
    csgOperationAppend(
        out, csgOperationJson(operation.proofCid))
    csgOperationAppend(out, ",\"query_key\":")
    csgOperationAppend(
        out, csgOperationJson(operation.queryKey))
    csgOperationAppend(out, ",\"schema\":")
    csgOperationAppend(
        out, csgOperationJson(operation.schema))
    csgOperationAppend(out, "}")
    return out

@borrows
fn csgOperationDecodeLine(
        line: str,
        operation: var
            CsgCoreMerkleTransactionOperation,
        error: var str): bool =
    var idText: str
    var kindText: str
    var operationKindText: str
    var beforeCountText: str
    var afterCountText: str
    if !csgOperationStringField(
           line, "after_dag_root_cid",
           operation.afterDagRootCid) ||
       !csgOperationStringField(
           line, "after_fact", operation.afterFact) ||
       !csgOperationStringField(
           line, "after_fact_cid", operation.afterFactCid) ||
       !csgOperationStringField(
           line, "after_fact_count", afterCountText) ||
       !csgOperationStringField(
           line, "after_facts_root",
           operation.afterFactsRoot) ||
       !csgOperationStringField(
           line, "after_profile_set_cid",
           operation.afterProfileSetCid) ||
       !csgOperationStringArrayField(
           line, "after_profiles", operation.afterProfiles) ||
       !csgOperationStringField(
           line, "before_dag_root_cid",
           operation.beforeDagRootCid) ||
       !csgOperationStringField(
           line, "before_fact", operation.beforeFact) ||
       !csgOperationStringField(
           line, "before_fact_cid", operation.beforeFactCid) ||
       !csgOperationStringField(
           line, "before_fact_count", beforeCountText) ||
       !csgOperationStringField(
           line, "before_facts_root",
           operation.beforeFactsRoot) ||
       !csgOperationStringField(
           line, "before_profile_set_cid",
           operation.beforeProfileSetCid) ||
       !csgOperationStringArrayField(
           line, "before_profiles", operation.beforeProfiles) ||
       !csgOperationStringField(
           line, "fact", operation.fact) ||
       !csgOperationStringField(
           line, "fact_cid", operation.factCid) ||
       !csgOperationStringField(line, "id", idText) ||
       !csgOperationStringField(line, "kind", kindText) ||
       !csgOperationStringField(
           line, "operation_kind", operationKindText) ||
       !csgOperationStringField(
           line, "proof_cid", operation.proofCid) ||
       !csgOperationStringField(
           line, "query_key", operation.queryKey) ||
       !csgOperationStringField(
           line, "schema", operation.schema) ||
       !csgOperationKindParse(
           operationKindText, operation.kind) ||
       !csgOperationInt32(
           beforeCountText, operation.beforeFactCount) ||
       !csgOperationInt32(
           afterCountText, operation.afterFactCount):
        error =
            "merkle_transaction_operation_field_invalid"
        return false
    if idText != "operation" ||
       kindText != CsgMerkleTransactionOperationKind ||
       csgOperationLine(operation) != line:
        error =
            "merkle_transaction_operation_non_canonical"
        return false
    error =
        CsgCoreMerkleTransactionOperationError(operation)
    return error.len == 0

@borrows
fn csgOperationSame(
        left: CsgCoreMerkleTransactionOperation,
        right: CsgCoreMerkleTransactionOperation): bool =
    return left.schema == right.schema &&
        left.kind == right.kind &&
        left.proofCid == right.proofCid &&
        left.queryKey == right.queryKey &&
        left.beforeFact == right.beforeFact &&
        left.beforeFactCid == right.beforeFactCid &&
        left.afterFact == right.afterFact &&
        left.afterFactCid == right.afterFactCid &&
        left.fact == right.fact &&
        left.factCid == right.factCid &&
        validator.CsgCoreProfilesEqual(
            left.beforeProfiles, right.beforeProfiles) &&
        left.beforeProfileSetCid ==
            right.beforeProfileSetCid &&
        validator.CsgCoreProfilesEqual(
            left.afterProfiles, right.afterProfiles) &&
        left.afterProfileSetCid ==
            right.afterProfileSetCid &&
        left.beforeFactsRoot == right.beforeFactsRoot &&
        left.afterFactsRoot == right.afterFactsRoot &&
        left.beforeDagRootCid == right.beforeDagRootCid &&
        left.afterDagRootCid == right.afterDagRootCid &&
        left.beforeFactCount == right.beforeFactCount &&
        left.afterFactCount == right.afterFactCount

@borrows
fn CsgCoreMerkleTransactionOperationEncode(
        operation:
            CsgCoreMerkleTransactionOperation):
        CsgCoreMerkleTransactionOperationCodecResult =
    let operationError =
        CsgCoreMerkleTransactionOperationError(operation)
    if operationError.len > 0:
        return csgOperationFail(operationError)
    var line = csgOperationLine(operation)
    var canonicalLines = [line]
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(canonicalLines)
    if !encoded.ok:
        return csgOperationFail(
            csgOperationCat(
                "merkle_transaction_operation_encode ",
                encoded.error))
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    var decodedOperation: CsgCoreMerkleTransactionOperation
    var decodeError: str
    if !decoded.ok || decoded.lines.len != 1 ||
       !csgOperationDecodeLine(
           decoded.lines[0],
           decodedOperation,
           decodeError) ||
       !csgOperationSame(operation, decodedOperation):
        rawbytes.BytesFree(encoded.bytes)
        return csgOperationFail(
            "merkle_transaction_operation_encode_self_check")
    var out: CsgCoreMerkleTransactionOperationCodecResult
    out.ok = true
    out.cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgMerkleTransactionOperationDomain,
            encoded.bytes)
    out.operation = decodedOperation
    out.lines = decoded.lines
    out.bytes = encoded.bytes
    return out

@borrows
fn CsgCoreMerkleTransactionOperationDecode(
        bytes: rawbytes.Bytes):
        CsgCoreMerkleTransactionOperationCodecResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgOperationFail(
            csgOperationCat(
                "merkle_transaction_operation_decode ",
                decoded.error))
    var operation: CsgCoreMerkleTransactionOperation
    var decodeError: str
    if decoded.lines.len != 1 ||
       !csgOperationDecodeLine(
           decoded.lines[0], operation, decodeError):
        if decodeError.len == 0:
            decodeError =
                "merkle_transaction_operation_line_count_invalid"
        return csgOperationFail(decodeError)
    var reencoded =
        CsgCoreMerkleTransactionOperationEncode(operation)
    if !reencoded.ok:
        return reencoded
    if !rawbytes.BytesEqual(bytes, reencoded.bytes):
        rawbytes.BytesFree(reencoded.bytes)
        return csgOperationFail(
            "merkle_transaction_operation_non_canonical")
    return reencoded

@borrows
fn CsgCoreMerkleTransactionOperationBuild(
        kind: int32,
        proof: merkle_dag.CsgCoreMerkleProof,
        expectedBeforeFactsRoot: str,
        afterProfiles: str[],
        fact: str):
        CsgCoreMerkleTransactionOperationCodecResult =
    return csgOperationFail(
        "merkle_transaction_operation_legacy_build_disabled")

@borrows
fn CsgCoreMerkleTransactionOperationBuildReplaceBound(
        proof: merkle_dag.CsgCoreMerkleProof,
        expectedBeforeFactsRoot: str,
        beforeFact: str,
        afterFact: str):
        CsgCoreMerkleTransactionOperationCodecResult =
    return csgOperationFail(
        "merkle_transaction_operation_requires_admitted_delta")

@borrows
fn CsgCoreMerkleTransactionOperationBuildSealedReplace(
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate):
        CsgCoreMerkleTransactionOperationCodecResult =
    let candidateAfterKind = field.CsgCoreJsonKind(candidate.afterFact)
    if !candidate.proof.ok || !candidate.replay.ok ||
       candidate.replacementCount != 1 ||
       candidate.queryKey.len == 0 || candidate.beforeFact.len == 0 ||
       candidate.afterFact.len == 0 ||
       !candidateAfterKind.found ||
       candidateAfterKind.value != candidate.validatorKind ||
       candidate.replacementScope !=
           validator.CsgCoreProductionLocalNamedReplacementScope() ||
       candidate.replay.beforeBinding.standard !=
           validator.CsgCoreStandardIdentity() ||
       candidate.replay.beforeBinding.schemaNamespace !=
           validator.CsgCoreSchemaNamespaceIdentity() ||
       !validator.CsgCoreProfilesEqual(
           candidate.replay.beforeBinding.profiles,
           candidate.proof.profiles) ||
       !validator.CsgCoreProfilesEqual(
           candidate.replay.afterBinding.profiles,
           candidate.proof.profiles) ||
       candidate.replay.beforeBinding.profileSetCid !=
           candidate.replay.afterBinding.profileSetCid ||
       candidate.replay.beforeBinding.schemaCid !=
           candidate.replay.afterBinding.schemaCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           candidate.beforeCsgcDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           candidate.beforeCsgcObjectCid):
        return csgOperationFail(
            "merkle_transaction_operation_sealed_binding_invalid")
    var proofCargo =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
            candidate.proof,
            candidate.replay.beforeFactsRoot)
    if !proofCargo.ok:
        return csgOperationFail(
            csgOperationCat(
                "merkle_transaction_operation_proof ",
                proofCargo.error))
    var beforeError: str
    let beforeFactCid =
        csgOperationFactCid(candidate.beforeFact, beforeError)
    var afterError: str
    let afterFactCid =
        csgOperationFactCid(candidate.afterFact, afterError)
    if beforeError.len > 0 || afterError.len > 0:
        rawbytes.BytesFree(proofCargo.bytes)
        return csgOperationFail(
            "merkle_transaction_operation_fact_cid_invalid")
    var operation: CsgCoreMerkleTransactionOperation
    operation.schema = CsgMerkleTransactionOperationSchema
    operation.kind = CsgMerkleTransactionReplace
    operation.proofCid = strings.CloneStr(proofCargo.cid)
    operation.queryKey = strings.CloneStr(candidate.queryKey)
    operation.beforeFact = strings.CloneStr(candidate.beforeFact)
    operation.beforeFactCid = strings.CloneStr(beforeFactCid)
    operation.afterFact = strings.CloneStr(candidate.afterFact)
    operation.afterFactCid = strings.CloneStr(afterFactCid)
    operation.fact = strings.CloneStr(candidate.afterFact)
    operation.factCid = strings.CloneStr(afterFactCid)
    operation.beforeProfiles =
        validator.CsgCoreProfilesClone(
            candidate.replay.beforeBinding.profiles)
    operation.beforeProfileSetCid =
        strings.CloneStr(
            candidate.replay.beforeBinding.profileSetCid)
    operation.afterProfiles =
        validator.CsgCoreProfilesClone(
            candidate.replay.afterBinding.profiles)
    operation.afterProfileSetCid =
        strings.CloneStr(candidate.replay.afterBinding.profileSetCid)
    operation.beforeFactsRoot =
        strings.CloneStr(candidate.replay.beforeFactsRoot)
    operation.afterFactsRoot =
        strings.CloneStr(candidate.replay.afterFactsRoot)
    operation.beforeDagRootCid =
        strings.CloneStr(candidate.replay.beforeDagRootCid)
    operation.afterDagRootCid =
        strings.CloneStr(candidate.replay.afterDagRootCid)
    operation.beforeFactCount = candidate.replay.beforeCount
    operation.afterFactCount = candidate.replay.afterCount
    var encoded = CsgCoreMerkleTransactionOperationEncode(operation)
    if !encoded.ok:
        rawbytes.BytesFree(proofCargo.bytes)
        return encoded
    encoded.proofBytes = proofCargo.bytes
    return encoded
