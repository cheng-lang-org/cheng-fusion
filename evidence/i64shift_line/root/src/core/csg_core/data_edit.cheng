import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator

const
    CsgDataEditOpAppend = 1
    CsgDataEditOpReplaceById = 2
    CsgDataEditOpDeleteById = 3
    CsgDataEditReceiptSchema = "csg_data_edit.receipt"

type
    CsgDataEditOperation =
        kind: int32
        targetId: str
        fact: str

    CsgDataEditResult =
        ok: bool
        complete: bool
        lines: str[]
        beforeRoot: str
        afterRoot: str
        appendedCount: int32
        replacedCount: int32
        deletedCount: int32
        merkleReplayCount: int32
        merkleReplayVerified: bool
        error: str
        receipt: str

    CsgDataEditCsgcResult =
        ok: bool
        bytes: rawbytes.Bytes
        receipt: str
        beforeRoot: str
        afterRoot: str
        error: str
        lines: str[]

@borrows
fn csgDataEditCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgDataEditCat3(a: str, b: str, c: str): str =
    return csgDataEditCat(csgDataEditCat(a, b), c)

@borrows
fn csgDataEditCat4(a: str, b: str, c: str, d: str): str =
    return csgDataEditCat(csgDataEditCat3(a, b, c), d)

@borrows
fn csgDataEditAppendText(out: var str, part: str) =
    out = csgDataEditCat(out, part)

fn csgDataEditBool(value: bool): str =
    if value:
        return "true"
    return "false"

@borrows
fn csgDataEditJsonString(text: str): str =
    return canonical.CsgCoreJsonQuote(text)

@borrows
fn CsgDataEditReceiptJson(result: CsgDataEditResult): str =
    var out: str = "{"
    csgDataEditAppendText(out, "\"afterRoot\":")
    csgDataEditAppendText(out, csgDataEditJsonString(result.afterRoot))
    csgDataEditAppendText(out, ",\"appendedCount\":")
    csgDataEditAppendText(out, strings.IntToStr(result.appendedCount))
    csgDataEditAppendText(out, ",\"beforeRoot\":")
    csgDataEditAppendText(out, csgDataEditJsonString(result.beforeRoot))
    csgDataEditAppendText(out, ",\"complete\":")
    csgDataEditAppendText(out, csgDataEditBool(result.complete))
    csgDataEditAppendText(out, ",\"deletedCount\":")
    csgDataEditAppendText(out, strings.IntToStr(result.deletedCount))
    csgDataEditAppendText(out, ",\"error\":")
    csgDataEditAppendText(out, csgDataEditJsonString(result.error))
    csgDataEditAppendText(out, ",\"factCount\":")
    csgDataEditAppendText(out, strings.IntToStr(result.lines.len))
    csgDataEditAppendText(out, ",\"merkle_replay_count\":")
    csgDataEditAppendText(
        out, strings.IntToStr(result.merkleReplayCount))
    csgDataEditAppendText(out, ",\"merkle_replay_verified\":")
    csgDataEditAppendText(
        out, csgDataEditBool(result.merkleReplayVerified))
    csgDataEditAppendText(out, ",\"ok\":")
    csgDataEditAppendText(out, csgDataEditBool(result.ok))
    csgDataEditAppendText(out, ",\"replacedCount\":")
    csgDataEditAppendText(out, strings.IntToStr(result.replacedCount))
    csgDataEditAppendText(out, ",\"schema\":")
    csgDataEditAppendText(
        out, csgDataEditJsonString(CsgDataEditReceiptSchema))
    csgDataEditAppendText(out, "}")
    return out

fn csgDataEditFail(
        result: CsgDataEditResult,
        error: str): CsgDataEditResult =
    result.ok = false
    result.complete = false
    result.error = error
    if result.afterRoot.len == 0:
        result.afterRoot =
            strings.CloneStr(result.beforeRoot)
    result.receipt = CsgDataEditReceiptJson(result)
    return result

@borrows
fn csgDataEditCloneLines(lines: str[]): str[] =
    var cloned: str[]
    for i in 0..<lines.len:
        add(cloned, strings.CloneStr(lines[i]))
    return cloned

@borrows
fn csgDataEditAdmissionError(
        prefix: str,
        admission: validator.CsgCoreValidationResult): str =
    if admission.errors.len > 0:
        return csgDataEditCat3(
            prefix, " ", admission.errors[0])
    return strings.CloneStr(prefix)

@borrows
fn CsgDataEditAppendFact(fact: str): CsgDataEditOperation =
    var op: CsgDataEditOperation
    op.kind = CsgDataEditOpAppend
    op.fact = share(fact)
    return op

@borrows
fn CsgDataEditReplaceById(targetId: str, fact: str): CsgDataEditOperation =
    var op: CsgDataEditOperation
    op.kind = CsgDataEditOpReplaceById
    op.targetId = share(targetId)
    op.fact = share(fact)
    return op

@borrows
fn CsgDataEditDeleteById(targetId: str): CsgDataEditOperation =
    var op: CsgDataEditOperation
    op.kind = CsgDataEditOpDeleteById
    op.targetId = share(targetId)
    return op

@borrows
fn csgDataEditCanonicalize(raw: str, label: str, outLine: var str, error: var str): bool =
    let canon = canonical.CsgCoreJsonCanonicalize(raw)
    if !canon.ok:
        error = csgDataEditCat3(label, ": ", canon.error)
        return false
    outLine = canon.value
    return true

@borrows
fn csgDataEditCanonicalizeFactWithId(raw: str, label: str, outLine: var str, outId: var str, error: var str): bool =
    if !csgDataEditCanonicalize(raw, label, outLine, error):
        return false
    let id = field.CsgCoreJsonId(outLine)
    if !id.found || id.value.len == 0:
        error = csgDataEditCat(label, ": missing_id")
        return false
    outId = id.value
    return true

@borrows
fn csgDataEditLineId(line: str): str =
    let id = field.CsgCoreJsonId(line)
    if id.found:
        return strings.CloneStr(id.value)
    return ""

@borrows
fn csgDataEditCountId(lines: str[], targetId: str): int32 =
    var count: int32
    for i in 0..<lines.len:
        if csgDataEditLineId(lines[i]) == targetId:
            count = count + 1
    return count

@borrows
fn csgDataEditFindId(lines: str[], targetId: str): int32 =
    for i in 0..<lines.len:
        if csgDataEditLineId(lines[i]) == targetId:
            return i
    return -1

@borrows
fn csgDataEditExactReplacement(
        before: str[],
        after: str[],
        queryKey: var str,
        afterFact: var str): bool =
    if before.len != after.len:
        return false
    var changed: int32
    for i in 0..<before.len:
        if before[i] == after[i]:
            continue
        changed = changed + 1
        if changed != 1:
            return false
        var beforeError: str
        let beforeKey = merkle_dag.CsgCoreMerkleFactKey(
            before[i], beforeError)
        var afterError: str
        let afterKey = merkle_dag.CsgCoreMerkleFactKey(
            after[i], afterError)
        if beforeError.len > 0 || afterError.len > 0 ||
           beforeKey != afterKey:
            return false
        queryKey = strings.CloneStr(beforeKey)
        afterFact = strings.CloneStr(after[i])
    return changed == 1 && queryKey.len > 0 && afterFact.len > 0

@borrows
fn csgDataEditAppend(current: var str[], op: CsgDataEditOperation, result: var CsgDataEditResult): bool =
    var line: str
    var id: str
    var error: str
    if !csgDataEditCanonicalizeFactWithId(op.fact, "append_fact", line, id, error):
        result.error = error
        return false
    if csgDataEditCountId(current, id) != 0:
        result.error = csgDataEditCat("append_duplicate_id ", id)
        return false
    add(current, line)
    result.appendedCount = result.appendedCount + 1
    return true

@borrows
fn csgDataEditReplace(current: var str[], op: CsgDataEditOperation, result: var CsgDataEditResult): bool =
    var line: str
    var id: str
    var error: str
    if !csgDataEditCanonicalizeFactWithId(op.fact, "replace_fact", line, id, error):
        result.error = error
        return false
    var targetId = strings.CloneStr(op.targetId)
    if targetId.len == 0:
        targetId = strings.CloneStr(id)
    if targetId != id:
        result.error = csgDataEditCat4("replace_id_mismatch target=", targetId, " fact=", id)
        return false
    let count = csgDataEditCountId(current, targetId)
    if count == 0:
        result.error = csgDataEditCat("replace_missing_id ", targetId)
        return false
    if count != 1:
        result.error = csgDataEditCat("replace_duplicate_id ", targetId)
        return false
    let index = csgDataEditFindId(current, targetId)
    if index < 0:
        result.error = csgDataEditCat("replace_missing_id ", targetId)
        return false
    current[index] = line
    result.replacedCount = result.replacedCount + 1
    return true

@borrows
fn csgDataEditDelete(current: var str[], op: CsgDataEditOperation, result: var CsgDataEditResult): bool =
    let targetId = op.targetId
    if targetId.len == 0:
        result.error = "delete_missing_target_id"
        return false
    let count = csgDataEditCountId(current, targetId)
    if count == 0:
        result.error = csgDataEditCat("delete_missing_id ", targetId)
        return false
    if count != 1:
        result.error = csgDataEditCat("delete_duplicate_id ", targetId)
        return false
    var next: str[]
    for i in 0..<current.len:
        if csgDataEditLineId(current[i]) != targetId:
            add(next, strings.CloneStr(current[i]))
    current = next
    result.deletedCount = result.deletedCount + 1
    return true

@borrows
fn CsgDataEditApplyLines(lines: str[], ops: CsgDataEditOperation[]): CsgDataEditResult =
    var result: CsgDataEditResult
    if ops.len != 1 ||
       ops[0].kind != CsgDataEditOpReplaceById:
        return csgDataEditFail(
            result,
            "data_edit_requires_single_admitted_replace")
    var current: str[]
    for i in 0..<lines.len:
        if lines[i].len == 0:
            continue
        var canonicalLine: str
        var error: str
        if !csgDataEditCanonicalize(lines[i], csgDataEditCat("line ", strings.IntToStr(i + 1)), canonicalLine, error):
            return csgDataEditFail(result, strings.CloneStr(error))
        add(current, canonicalLine)

    let initialAdmission =
        validator.CsgCoreProductionAdmitFactLines(current)
    if !initialAdmission.valid ||
       !initialAdmission.complete:
        result.lines = current
        return csgDataEditFail(
            result,
            csgDataEditAdmissionError(
                "input_admission_failed",
                initialAdmission))
    result.beforeRoot =
        strings.CloneStr(initialAdmission.factsRoot)
    result.afterRoot =
        strings.CloneStr(initialAdmission.factsRoot)
    for i in 0..<ops.len:
        let op = ops[i]
        var candidate =
            csgDataEditCloneLines(current)
        var candidateDelta: CsgDataEditResult
        var ok: bool
        if op.kind == CsgDataEditOpAppend:
            ok = csgDataEditAppend(
                candidate, op, candidateDelta)
        elif op.kind == CsgDataEditOpReplaceById:
            ok = csgDataEditReplace(
                candidate, op, candidateDelta)
        elif op.kind == CsgDataEditOpDeleteById:
            ok = csgDataEditDelete(
                candidate, op, candidateDelta)
        else:
            candidateDelta.error =
                csgDataEditCat(
                    "unknown_edit_op ",
                    strings.IntToStr(op.kind))
            ok = false
        if !ok:
            result.lines = current
            return csgDataEditFail(
                result, strings.CloneStr(candidateDelta.error))
        let candidateAdmission =
            validator.CsgCoreProductionAdmitFactLines(
                candidate)
        if !candidateAdmission.valid ||
           !candidateAdmission.complete:
            result.lines = current
            return csgDataEditFail(
                result,
                csgDataEditAdmissionError(
                    "candidate_admission_failed",
                    candidateAdmission))
        if op.kind == CsgDataEditOpReplaceById:
            var queryKey: str
            var afterFact: str
            if !csgDataEditExactReplacement(
                   current, candidate, queryKey, afterFact):
                result.lines = current
                return csgDataEditFail(
                    result,
                    "data_edit_replacement_identity_mismatch")
            let validated =
                merkle_admission.CsgCoreMerkleValidateLocalNamedReplace(
                    current, afterFact, queryKey)
            let exact = validated.ok &&
                validated.beforeFactsRoot == result.afterRoot &&
                validated.beforeFactCount == current.len &&
                validated.afterFactsRoot ==
                    candidateAdmission.factsRoot &&
                validated.afterFactCount == candidate.len
            if !exact:
                result.lines = current
                return csgDataEditFail(
                    result,
                    "data_edit_sealed_replay_mismatch")
            result.merkleReplayCount =
                result.merkleReplayCount + 1
        current = candidate
        result.appendedCount =
            result.appendedCount +
            candidateDelta.appendedCount
        result.replacedCount =
            result.replacedCount +
            candidateDelta.replacedCount
        result.deletedCount =
            result.deletedCount +
            candidateDelta.deletedCount
        result.afterRoot =
            strings.CloneStr(
                candidateAdmission.factsRoot)

    let physicalOrder =
        merkle_dag.CsgCoreMerklePhysicalOrder(
            current)
    if !physicalOrder.ok ||
       physicalOrder.canonicalLines.len != current.len:
        if physicalOrder.error.len > 0:
            result.error = csgDataEditCat(
                "physical_order_failed ",
                physicalOrder.error)
        else:
            result.error =
                "physical_order_fact_count_mismatch"
        result.lines = current
        return csgDataEditFail(
            result, strings.CloneStr(result.error))
    result.lines = physicalOrder.canonicalLines
    result.ok = true
    result.complete = true
    result.merkleReplayVerified =
        result.merkleReplayCount == result.replacedCount
    result.receipt = CsgDataEditReceiptJson(result)
    return result

@borrows
fn CsgDataEditLinesText(lines: str[]): str =
    var total: int32
    for i in 0..<lines.len:
        total = total + lines[i].len + 1
    var buf = layout.ByteBufInit(total)
    for i in 0..<lines.len:
        let lineBytes = rawbytes.BytesFromString(lines[i])
        layout.ByteBufAppendBytes(buf, lineBytes)
        layout.ByteBufAppendByte(buf, 10)
    var textBytes = layout.ByteBufToBytes(buf)
    let text = rawbytes.BytesToString(textBytes)
    rawbytes.BytesFree(textBytes)
    layout.ByteBufFree(buf)
    return text

@borrows
fn csgDataEditCsgcFail(error: str): CsgDataEditCsgcResult =
    var result: CsgDataEditCsgcResult
    result.error = strings.CloneStr(error)
    var editResult: CsgDataEditResult
    editResult.error = strings.CloneStr(error)
    editResult.receipt = CsgDataEditReceiptJson(editResult)
    result.receipt =
        strings.CloneStr(editResult.receipt)
    return result

@borrows
fn CsgDataEditApplyCsgcBytes(bytes: rawbytes.Bytes, ops: CsgDataEditOperation[]): CsgDataEditCsgcResult =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return csgDataEditCsgcFail(decoded.error)
    let edited = CsgDataEditApplyLines(decoded.lines, ops)
    if !edited.ok:
        var failed: CsgDataEditCsgcResult
        failed.error = edited.error
        failed.receipt = edited.receipt
        failed.beforeRoot = edited.beforeRoot
        failed.afterRoot = edited.afterRoot
        failed.lines = edited.lines
        return failed
    let encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(edited.lines)
    if !encoded.ok:
        return csgDataEditCsgcFail(encoded.error)
    var result: CsgDataEditCsgcResult
    result.ok = true
    result.bytes = encoded.bytes
    result.receipt = edited.receipt
    result.beforeRoot = edited.beforeRoot
    result.afterRoot = edited.afterRoot
    result.lines = edited.lines
    return result
