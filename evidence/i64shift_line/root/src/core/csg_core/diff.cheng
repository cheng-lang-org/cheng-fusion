import std/strings
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator

type
    CsgCoreDiffResult =
        ok: bool
        error: str
        leftRoot: str
        rightRoot: str
        added: str[]
        removed: str[]
        changed: str[]

    csgCoreDiffFacts =
        keys: str[]
        values: str[]
        canonicalLines: str[]

@borrows
fn csgDiffCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgDiffCat3(a: str, b: str, c: str): str =
    return csgDiffCat(csgDiffCat(a, b), c)

@borrows
fn csgDiffCat4(a: str, b: str, c: str, d: str): str =
    return csgDiffCat(csgDiffCat3(a, b, c), d)

fn csgDiffFail(error: str): CsgCoreDiffResult =
    var result: CsgCoreDiffResult
    result.error = error
    return result

@borrows
fn csgDiffStrLess(left: str, right: str): bool =
    if left == right:
        return false
    let leftLen = left.len
    let rightLen = right.len
    let sharedLen = leftLen < rightLen ? leftLen : rightLen
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return leftLen < rightLen

@borrows
fn csgDiffFindKey(keys: str[], key: str): int32 =
    for i in 0..<keys.len:
        if keys[i] == key:
            return i
    return -1

@borrows
fn csgDiffSortPerm(keys: str[]): int32[] =
    var perm: int32[]
    setLen(perm, keys.len)
    for i in 0..<keys.len:
        perm[i] = i
    for pos in 0..<keys.len:
        var best = pos
        var k = pos + 1
        while k < keys.len:
            if csgDiffStrLess(keys[perm[k]], keys[perm[best]]):
                best = k
            k = k + 1
        let tmp = perm[pos]
        perm[pos] = perm[best]
        perm[best] = tmp
    return perm

@borrows
fn csgDiffSortPairs(keys: str[], values: str[], outKeys: var str[], outValues: var str[]) =
    let perm = csgDiffSortPerm(keys)
    for i in 0..<perm.len:
        let at = perm[i]
        add(outKeys, strings.CloneStr(keys[at]))
        add(outValues, strings.CloneStr(values[at]))

@borrows
fn csgDiffSortKeys(keys: str[], out: var str[]) =
    let perm = csgDiffSortPerm(keys)
    for i in 0..<perm.len:
        add(out, strings.CloneStr(keys[perm[i]]))

@borrows
fn csgDiffBuildKey(line: str, index: int32, key: var str, error: var str): bool =
    var keyError: str
    key = merkle_dag.CsgCoreMerkleFactKey(
        line, keyError)
    if keyError.len > 0:
        error = csgDiffCat4(
            "invalid fact key at line ",
            strings.IntToStr(index + 1),
            ": ",
            keyError)
        return false
    return true

@borrows
fn csgDiffCanonicalizeLines(lines: str[], side: str, facts: var csgCoreDiffFacts, error: var str): bool =
    for i in 0..<lines.len:
        let canon = canonical.CsgCoreJsonCanonicalize(lines[i])
        if !canon.ok:
            error = csgDiffCat4(side, " line ", strings.IntToStr(i + 1), csgDiffCat(": ", canon.error))
            return false
        var key: str
        if !csgDiffBuildKey(canon.value, i, key, error):
            error = csgDiffCat3(side, " ", error)
            return false
        if csgDiffFindKey(facts.keys, key) >= 0:
            error = csgDiffCat3(side, " duplicate key ", key)
            return false
        add(facts.keys, key)
        add(facts.values, strings.CloneStr(canon.value))
        add(facts.canonicalLines, strings.CloneStr(canon.value))
    var sortedKeys: str[]
    var sortedValues: str[]
    csgDiffSortPairs(facts.keys, facts.values, sortedKeys, sortedValues)
    facts.keys = sortedKeys
    facts.values = sortedValues
    return true

@borrows
fn CsgCoreDiffCanonicalJsonLines(leftLines: str[], rightLines: str[]): CsgCoreDiffResult =
    var leftFacts: csgCoreDiffFacts
    var rightFacts: csgCoreDiffFacts
    var error: str
    if !csgDiffCanonicalizeLines(leftLines, "left", leftFacts, error):
        return csgDiffFail(error)
    if !csgDiffCanonicalizeLines(rightLines, "right", rightFacts, error):
        return csgDiffFail(error)

    var result: CsgCoreDiffResult
    result.ok = true
    result.leftRoot = validator.CsgCoreFactsRootFromCanonicalLines(leftFacts.canonicalLines)
    result.rightRoot = validator.CsgCoreFactsRootFromCanonicalLines(rightFacts.canonicalLines)

    for i in 0..<leftFacts.keys.len:
        let rightIndex = csgDiffFindKey(rightFacts.keys, leftFacts.keys[i])
        if rightIndex < 0:
            add(result.removed, strings.CloneStr(leftFacts.keys[i]))
        elif leftFacts.values[i] != rightFacts.values[rightIndex]:
            add(result.changed, strings.CloneStr(leftFacts.keys[i]))

    for i in 0..<rightFacts.keys.len:
        if csgDiffFindKey(leftFacts.keys, rightFacts.keys[i]) < 0:
            add(result.added, strings.CloneStr(rightFacts.keys[i]))

    var sortedAdded: str[]
    csgDiffSortKeys(result.added, sortedAdded)
    result.added = sortedAdded
    var sortedRemoved: str[]
    csgDiffSortKeys(result.removed, sortedRemoved)
    result.removed = sortedRemoved
    var sortedChanged: str[]
    csgDiffSortKeys(result.changed, sortedChanged)
    result.changed = sortedChanged
    return result

@borrows
fn CsgCoreDiffCanonicalLines(leftLines: str[], rightLines: str[]): CsgCoreDiffResult =
    return CsgCoreDiffCanonicalJsonLines(leftLines, rightLines)

@borrows
fn CsgCoreDiffFactLines(leftLines: str[], rightLines: str[]): CsgCoreDiffResult =
    return CsgCoreDiffCanonicalJsonLines(leftLines, rightLines)
