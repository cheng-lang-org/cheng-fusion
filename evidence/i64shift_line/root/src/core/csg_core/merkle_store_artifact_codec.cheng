import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_cargo
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_transaction_operation
import cheng/core/csg_core/merkle_transaction_receipt
import cheng/core/csg_core/merkle_transaction_request

const
    CsgMerkleStoreArtifactNode: int32 = 1
    CsgMerkleStoreArtifactPartition: int32 = 2
    CsgMerkleStoreArtifactMembership: int32 = 3
    CsgMerkleStoreArtifactDependency: int32 = 4
    CsgMerkleStoreArtifactSummary: int32 = 5
    CsgMerkleStoreArtifactIndex: int32 = 6
    CsgMerkleStoreArtifactManifest: int32 = 7
    CsgMerkleStoreArtifactProof: int32 = 8
    CsgMerkleStoreArtifactOperation: int32 = 9
    CsgMerkleStoreArtifactReceipt: int32 = 10
    CsgMerkleStoreArtifactRequest: int32 = 11
    CsgMerkleStoreArtifactCanonicalCsgc: int32 = 12

    CsgMerkleStoreRequestObjectMaxBytes: int64 = 67108864
    CsgMerkleStoreReceiptObjectMaxBytes: int64 = 67108864
    CsgMerkleStoreProofObjectMaxBytes: int64 = 262144
    CsgMerkleStoreOperationObjectMaxBytes: int64 = 1048576
    CsgMerkleStoreNodeObjectMaxBytes: int64 = 1048576
    CsgMerkleStoreGeneralObjectMaxBytes: int64 = 268435456

fn CsgCoreMerkleStoreNodeArtifactKind(): int32 =
    return CsgMerkleStoreArtifactNode

fn CsgCoreMerkleStorePartitionArtifactKind(): int32 =
    return CsgMerkleStoreArtifactPartition

fn CsgCoreMerkleStoreMembershipArtifactKind(): int32 =
    return CsgMerkleStoreArtifactMembership

fn CsgCoreMerkleStoreDependencyArtifactKind(): int32 =
    return CsgMerkleStoreArtifactDependency

fn CsgCoreMerkleStoreSummaryArtifactKind(): int32 =
    return CsgMerkleStoreArtifactSummary

fn CsgCoreMerkleStoreIndexArtifactKind(): int32 =
    return CsgMerkleStoreArtifactIndex

fn CsgCoreMerkleStoreManifestArtifactKind(): int32 =
    return CsgMerkleStoreArtifactManifest

fn CsgCoreMerkleStoreProofArtifactKind(): int32 =
    return CsgMerkleStoreArtifactProof

fn CsgCoreMerkleStoreOperationArtifactKind(): int32 =
    return CsgMerkleStoreArtifactOperation

fn CsgCoreMerkleStoreReceiptArtifactKind(): int32 =
    return CsgMerkleStoreArtifactReceipt

fn CsgCoreMerkleStoreRequestArtifactKind(): int32 =
    return CsgMerkleStoreArtifactRequest

fn CsgCoreMerkleStoreCanonicalCsgcArtifactKind(): int32 =
    return CsgMerkleStoreArtifactCanonicalCsgc

fn CsgCoreMerkleStoreArtifactKindValid(kind: int32): bool =
    return kind >= CsgMerkleStoreArtifactNode &&
        kind <= CsgMerkleStoreArtifactCanonicalCsgc

fn CsgCoreMerkleStoreArtifactCategory(kind: int32): str =
    if kind == CsgMerkleStoreArtifactNode:
        return "nodes"
    if kind == CsgMerkleStoreArtifactPartition:
        return "partitions"
    if kind == CsgMerkleStoreArtifactMembership:
        return "memberships"
    if kind == CsgMerkleStoreArtifactDependency:
        return "dependencies"
    if kind == CsgMerkleStoreArtifactSummary:
        return "summaries"
    if kind == CsgMerkleStoreArtifactIndex:
        return "indexes"
    if kind == CsgMerkleStoreArtifactManifest:
        return "manifests"
    if kind == CsgMerkleStoreArtifactProof:
        return "proofs"
    if kind == CsgMerkleStoreArtifactOperation:
        return "operations"
    if kind == CsgMerkleStoreArtifactReceipt:
        return "receipts"
    if kind == CsgMerkleStoreArtifactRequest:
        return "requests"
    if kind == CsgMerkleStoreArtifactCanonicalCsgc:
        return "csgc_objects"
    return ""

fn CsgCoreMerkleStoreArtifactByteLimit(kind: int32): int64 =
    if kind == CsgMerkleStoreArtifactRequest:
        return CsgMerkleStoreRequestObjectMaxBytes
    if kind == CsgMerkleStoreArtifactReceipt:
        return CsgMerkleStoreReceiptObjectMaxBytes
    if kind == CsgMerkleStoreArtifactProof:
        return CsgMerkleStoreProofObjectMaxBytes
    if kind == CsgMerkleStoreArtifactOperation:
        return CsgMerkleStoreOperationObjectMaxBytes
    if kind == CsgMerkleStoreArtifactNode:
        return CsgMerkleStoreNodeObjectMaxBytes
    if CsgCoreMerkleStoreArtifactKindValid(kind):
        return CsgMerkleStoreGeneralObjectMaxBytes
    return int64(0)

@borrows
fn CsgCoreMerkleStoreArtifactCid(
        kind: int32,
        bytes: rawbytes.Bytes,
        error: var str): str =
    error = ""
    if kind == CsgMerkleStoreArtifactNode:
        var decoded =
            merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
                bytes)
        if !decoded.ok || decoded.nodes.len != 1:
            error = strings.CloneStr(decoded.error)
            if error.len == 0:
                error =
                    "merkle_store_node_object_cardinality_invalid"
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let semanticCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                decoded.nodes[0])
        rawbytes.BytesFree(decoded.bytes)
        return semanticCid
    if kind == CsgMerkleStoreArtifactPartition:
        var decoded =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactMembership:
        var decoded =
            merkle_artifacts.CsgCoreMerkleMembershipDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactDependency:
        var decoded =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactSummary:
        var decoded =
            merkle_artifacts.CsgCoreMerkleSummaryDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactIndex:
        var decoded =
            merkle_artifacts.CsgCoreMerkleQueryShardDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactManifest:
        let decoded =
            merkle_manifest.CsgCoreMerkleManifestDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            return ""
        return strings.CloneStr(decoded.cid)
    if kind == CsgMerkleStoreArtifactProof:
        let decoded =
            merkle_cargo.CsgCoreMerkleProofDecodeSelfCsgc(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            return ""
        return strings.CloneStr(decoded.cid)
    if kind == CsgMerkleStoreArtifactOperation:
        var decoded =
            merkle_transaction_operation.CsgCoreMerkleTransactionOperationDecode(
                bytes)
        if !decoded.ok:
            error = strings.CloneStr(decoded.error)
            rawbytes.BytesFree(decoded.bytes)
            return ""
        let cid = strings.CloneStr(decoded.cid)
        rawbytes.BytesFree(decoded.bytes)
        return cid
    if kind == CsgMerkleStoreArtifactReceipt:
        let directory = csgc.CsgCoreCsgcParseSectionDirectory(bytes)
        if !directory.ok ||
           directory.factCount <= 0 ||
           directory.factCount >
               merkle_transaction_receipt.CsgCoreMerkleTransactionReceiptLineLimit():
            error = directory.error.len > 0 ?
                strings.CloneStr(directory.error) :
                "merkle_store_receipt_object_invalid"
            return ""
        return merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            merkle_transaction_receipt.CsgMerkleTransactionReceiptDomain,
            bytes)
    if kind == CsgMerkleStoreArtifactRequest:
        return merkle_transaction_request.CsgCoreMerkleTransactionRequestArtifactCid(
            bytes, error)
    if kind == CsgMerkleStoreArtifactCanonicalCsgc:
        let claim = csgc.CsgCoreCsgcClaimDirectory(bytes)
        if !claim.ok:
            error = "merkle_store_canonical_csgc_invalid"
            return ""
        return merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            bytes)
    error = "merkle_store_artifact_kind_invalid"
    return ""
