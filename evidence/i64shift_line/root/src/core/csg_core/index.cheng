import std/strings
import std/bytes_layout as layout
import std/rawbytes
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as jfield
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

const
    CsgCoreIndexSchema: str = "csg-core.index"
    CsgCoreIndexStandard: str = "csg_core::v1"
    CsgCoreIndexPayloadDomain: str = "csg_core.index.payload"
    CsgCoreIndexPayloadSchema: str = "csg-core.index.payload"
    CsgCoreIndexKeyFile: int32 = 1
    CsgCoreIndexKeySymbol: int32 = 2
    CsgCoreIndexKeyFunction: int32 = 3
    CsgCoreIndexKeyCall: int32 = 4

type
    CsgCoreIndexFile =
        file: str
        moduleId: str
        factCount: int32
        symbolCount: int32
        functionCount: int32
        callCount: int32

    CsgCoreIndexSymbol =
        id: str
        name: str
        symbolKind: str
        file: str
        line: str
        column: str
        exported: bool
        fqName: str

    CsgCoreIndexFunction =
        id: str
        name: str
        symbol: str
        file: str
        line: str
        column: str
        exported: bool
        callCount: int32

    CsgCoreIndexCall =
        id: str
        file: str
        line: str
        column: str
        owner: str
        calleeText: str
        calleeKind: str
        targetRefId: str
        targetName: str

    CsgCoreIndexBinding =
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaNamespace: str
        schemaCid: str
        factsRoot: str
        dagRootCid: str
        subgraphCid: str
        factCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str
        csgcByteCount: int32
        indexPayloadCid: str

    CsgCoreIndexBindingResult =
        ok: bool
        binding: CsgCoreIndexBinding
        error: str

    CsgCoreIndexArtifact =
        binding: CsgCoreIndexBinding
        complete: bool
        files: CsgCoreIndexFile[]
        symbols: CsgCoreIndexSymbol[]
        functions: CsgCoreIndexFunction[]
        calls: CsgCoreIndexCall[]

    CsgCoreIndexLoadResult =
        ok: bool
        artifact: CsgCoreIndexArtifact
        error: str

    CsgCoreIndexQueryResult =
        ok: bool
        found: bool
        row: int32 = -1
        error: str

    csgCoreIndexReadState =
        text: str
        pos: int32
        error: str

fn csgIndexBoolJson(value: bool): str =
    if value:
        return "true"
    return "false"

@borrows
fn csgIndexBufStr(buf: var layout.ByteBuf, text: str) =
    let textBytes = rawbytes.BytesFromString(text)
    layout.ByteBufAppendBytes(buf, textBytes)

@borrows
fn csgIndexBufInt(buf: var layout.ByteBuf, value: int32) =
    let text = strings.IntToStr(value)
    csgIndexBufStr(buf, text)

@borrows
fn csgIndexBufQuote(buf: var layout.ByteBuf, text: str) =
    let quoted = canonical.CsgCoreJsonQuoteChecked(text)
    if !quoted.ok:
        panic("csg_index_invalid_utf8_string")
    csgIndexBufStr(buf, quoted.value)

@borrows
fn csgIndexAppendStringArray(
        buf: var layout.ByteBuf,
        values: str[]) =
    csgIndexBufStr(buf, "[")
    for i in 0..<values.len:
        if i > 0:
            csgIndexBufStr(buf, ",")
        csgIndexBufQuote(buf, values[i])
    csgIndexBufStr(buf, "]")

@borrows
fn csgIndexRawTrue(raw: str): bool =
    return raw == "true"

@borrows
fn csgIndexStringField(line: str, key: str): str =
    let found = jfield.CsgCoreJsonTopStringField(line, key)
    if found.found:
        return strings.CloneStr(found.value)
    return ""

@borrows
fn csgIndexRawField(line: str, key: str): str =
    let found = jfield.CsgCoreJsonTopRawField(line, key)
    if found.found:
        return strings.CloneStr(found.value)
    return ""

@borrows
fn csgIndexLocRaw(line: str): str =
    return csgIndexRawField(line, "loc")

@borrows
fn csgIndexLocFile(line: str): str =
    let loc = csgIndexLocRaw(line)
    if loc.len == 0:
        return ""
    return csgIndexStringField(loc, "file")

@borrows
fn csgIndexLocLine(line: str): str =
    let loc = csgIndexLocRaw(line)
    if loc.len == 0:
        return "0"
    let raw = csgIndexRawField(loc, "line")
    if raw.len == 0:
        return "0"
    return strings.CloneStr(raw)

@borrows
fn csgIndexLocColumn(line: str): str =
    let loc = csgIndexLocRaw(line)
    if loc.len == 0:
        return "0"
    let raw = csgIndexRawField(loc, "column")
    if raw.len == 0:
        return "0"
    return strings.CloneStr(raw)

@borrows
fn csgIndexLineFile(line: str, kind: str): str =
    if kind == "csg.module":
        return csgIndexStringField(line, "path")
    return csgIndexLocFile(line)

@borrows
fn csgIndexFindFile(files: CsgCoreIndexFile[], file: str): int32 =
    for i in 0..<files.len:
        if files[i].file == file:
            return i
    return -1

@borrows
fn csgIndexEnsureFile(files: var CsgCoreIndexFile[], file: str): int32 =
    let existing = csgIndexFindFile(files, file)
    if existing >= 0:
        return existing
    var item: CsgCoreIndexFile
    item.file = file
    add(files, item)
    return files.len - 1

@borrows
fn csgIndexIncrementFileFact(files: var CsgCoreIndexFile[], file: str) =
    if file.len == 0:
        return
    let index = csgIndexEnsureFile(files, file)
    var item = files[index]
    item.factCount = item.factCount + 1
    files[index] = item

@borrows
fn csgIndexBuildTargetField(rawTarget: str, key: str): str =
    if rawTarget.len == 0:
        return ""
    return csgIndexStringField(rawTarget, key)

@borrows
fn csgIndexOwnerCallCount(calls: CsgCoreIndexCall[], owner: str): int32 =
    if owner.len == 0:
        return 0
    var count: int32
    for i in 0..<calls.len:
        if calls[i].owner == owner:
            count = count + 1
    return count

@borrows
fn csgIndexScanLine(line: str,
                    files: var CsgCoreIndexFile[],
                    symbols: var CsgCoreIndexSymbol[],
                    functions: var CsgCoreIndexFunction[],
                    calls: var CsgCoreIndexCall[]) =
    let kindValue = jfield.CsgCoreJsonKind(line)
    if !kindValue.found:
        return
    let kind = kindValue.value
    let file = csgIndexLineFile(line, kind)
    csgIndexIncrementFileFact(files, file)
    if kind == "csg.module":
        let index = csgIndexEnsureFile(files, file)
        var fileItem = files[index]
        fileItem.moduleId = csgIndexStringField(line, "id")
        files[index] = fileItem
    elif kind == "csg.symbol":
        if file.len == 0:
            return
        let index = csgIndexEnsureFile(files, file)
        var fileItem = files[index]
        fileItem.symbolCount = fileItem.symbolCount + 1
        files[index] = fileItem
        var item: CsgCoreIndexSymbol
        item.id = csgIndexStringField(line, "id")
        item.name = csgIndexStringField(line, "name")
        item.symbolKind = csgIndexStringField(line, "symbolKind")
        item.file = file
        item.line = csgIndexLocLine(line)
        item.column = csgIndexLocColumn(line)
        item.exported = csgIndexRawTrue(csgIndexRawField(line, "exported"))
        item.fqName = csgIndexStringField(line, "fqName")
        add(symbols, item)
    elif kind == "csg.function":
        if file.len == 0:
            return
        let index = csgIndexEnsureFile(files, file)
        var fileItem = files[index]
        fileItem.functionCount = fileItem.functionCount + 1
        files[index] = fileItem
        var item: CsgCoreIndexFunction
        item.id = csgIndexStringField(line, "id")
        item.name = csgIndexStringField(line, "name")
        item.symbol = csgIndexStringField(line, "symbol")
        item.file = file
        item.line = csgIndexLocLine(line)
        item.column = csgIndexLocColumn(line)
        item.exported = csgIndexRawTrue(csgIndexRawField(line, "exported"))
        add(functions, item)
    elif kind == "csg.call":
        if file.len == 0:
            return
        let index = csgIndexEnsureFile(files, file)
        var fileItem = files[index]
        fileItem.callCount = fileItem.callCount + 1
        files[index] = fileItem
        let target = csgIndexRawField(line, "target")
        var item: CsgCoreIndexCall
        item.id = csgIndexStringField(line, "id")
        item.file = file
        item.line = csgIndexLocLine(line)
        item.column = csgIndexLocColumn(line)
        item.owner = csgIndexStringField(line, "owner")
        item.calleeText = csgIndexStringField(line, "calleeText")
        item.calleeKind = csgIndexStringField(line, "calleeKind")
        item.targetRefId = csgIndexBuildTargetField(target, "id")
        item.targetName = csgIndexBuildTargetField(target, "name")
        add(calls, item)

@borrows
fn csgIndexApplyCallCounts(functions: var CsgCoreIndexFunction[], calls: CsgCoreIndexCall[]) =
    for i in 0..<functions.len:
        var item = functions[i]
        item.callCount = csgIndexOwnerCallCount(calls, item.id)
        functions[i] = item

@borrows
fn csgIndexAppendFileJson(buf: var layout.ByteBuf, item: CsgCoreIndexFile) =
    csgIndexBufStr(buf, "{\"call_count\":")
    csgIndexBufInt(buf, item.callCount)
    csgIndexBufStr(buf, ",\"fact_count\":")
    csgIndexBufInt(buf, item.factCount)
    csgIndexBufStr(buf, ",\"file\":")
    csgIndexBufQuote(buf, item.file)
    csgIndexBufStr(buf, ",\"function_count\":")
    csgIndexBufInt(buf, item.functionCount)
    csgIndexBufStr(buf, ",\"module_id\":")
    csgIndexBufQuote(buf, item.moduleId)
    csgIndexBufStr(buf, ",\"symbol_count\":")
    csgIndexBufInt(buf, item.symbolCount)
    csgIndexBufStr(buf, "}")

@borrows
fn csgIndexAppendSymbolJson(buf: var layout.ByteBuf, item: CsgCoreIndexSymbol) =
    csgIndexBufStr(buf, "{\"column\":")
    csgIndexBufStr(buf, item.column)
    csgIndexBufStr(buf, ",\"exported\":")
    csgIndexBufStr(buf, csgIndexBoolJson(item.exported))
    csgIndexBufStr(buf, ",\"file\":")
    csgIndexBufQuote(buf, item.file)
    csgIndexBufStr(buf, ",\"fq_name\":")
    csgIndexBufQuote(buf, item.fqName)
    csgIndexBufStr(buf, ",\"id\":")
    csgIndexBufQuote(buf, item.id)
    csgIndexBufStr(buf, ",\"line\":")
    csgIndexBufStr(buf, item.line)
    csgIndexBufStr(buf, ",\"name\":")
    csgIndexBufQuote(buf, item.name)
    csgIndexBufStr(buf, ",\"symbol_kind\":")
    csgIndexBufQuote(buf, item.symbolKind)
    csgIndexBufStr(buf, "}")

@borrows
fn csgIndexAppendFunctionJson(buf: var layout.ByteBuf, item: CsgCoreIndexFunction) =
    csgIndexBufStr(buf, "{\"call_count\":")
    csgIndexBufInt(buf, item.callCount)
    csgIndexBufStr(buf, ",\"column\":")
    csgIndexBufStr(buf, item.column)
    csgIndexBufStr(buf, ",\"exported\":")
    csgIndexBufStr(buf, csgIndexBoolJson(item.exported))
    csgIndexBufStr(buf, ",\"file\":")
    csgIndexBufQuote(buf, item.file)
    csgIndexBufStr(buf, ",\"id\":")
    csgIndexBufQuote(buf, item.id)
    csgIndexBufStr(buf, ",\"line\":")
    csgIndexBufStr(buf, item.line)
    csgIndexBufStr(buf, ",\"name\":")
    csgIndexBufQuote(buf, item.name)
    csgIndexBufStr(buf, ",\"symbol\":")
    csgIndexBufQuote(buf, item.symbol)
    csgIndexBufStr(buf, "}")

@borrows
fn csgIndexAppendCallJson(buf: var layout.ByteBuf, item: CsgCoreIndexCall) =
    csgIndexBufStr(buf, "{\"callee_kind\":")
    csgIndexBufQuote(buf, item.calleeKind)
    csgIndexBufStr(buf, ",\"callee_text\":")
    csgIndexBufQuote(buf, item.calleeText)
    csgIndexBufStr(buf, ",\"column\":")
    csgIndexBufStr(buf, item.column)
    csgIndexBufStr(buf, ",\"file\":")
    csgIndexBufQuote(buf, item.file)
    csgIndexBufStr(buf, ",\"id\":")
    csgIndexBufQuote(buf, item.id)
    csgIndexBufStr(buf, ",\"line\":")
    csgIndexBufStr(buf, item.line)
    csgIndexBufStr(buf, ",\"owner\":")
    csgIndexBufQuote(buf, item.owner)
    csgIndexBufStr(buf, ",\"target_name\":")
    csgIndexBufQuote(buf, item.targetName)
    csgIndexBufStr(buf, ",\"target_ref_id\":")
    csgIndexBufQuote(buf, item.targetRefId)
    csgIndexBufStr(buf, "}")

@borrows
fn csgIndexTextCompare(left: str, right: str): int32 =
    let shared = left.len < right.len ? left.len : right.len
    for i in 0..<shared:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgIndexCanonicalOrder(keys: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, keys.len)
    setLen(scratch, keys.len)
    for i in 0..<keys.len:
        if keys[i].len == 0:
            panic("csg_index_empty_key")
        order[i] = i
    var width: int32 = 1
    while width < order.len:
        var base: int32
        while base < order.len:
            var middle = base + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = base
            var right = middle
            var out = base
            while left < middle && right < finish:
                if csgIndexTextCompare(
                       keys[order[right]], keys[order[left]]) < 0:
                    scratch[out] = order[right]
                    right = right + 1
                else:
                    scratch[out] = order[left]
                    left = left + 1
                out = out + 1
            while left < middle:
                scratch[out] = order[left]
                left = left + 1
                out = out + 1
            while right < finish:
                scratch[out] = order[right]
                right = right + 1
                out = out + 1
            base = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len - width:
            width = order.len
        else:
            width = width + width
    for i in 1..<order.len:
        if keys[order[i - 1]] == keys[order[i]]:
            panic("csg_index_duplicate_key")
    return order

@borrows
fn csgIndexFileOrder(items: CsgCoreIndexFile[]): int32[] =
    var keys: str[]
    for i in 0..<items.len:
        add(keys, strings.CloneStr(items[i].file))
    return csgIndexCanonicalOrder(keys)

@borrows
fn csgIndexSymbolOrder(items: CsgCoreIndexSymbol[]): int32[] =
    var keys: str[]
    for i in 0..<items.len:
        add(keys, strings.CloneStr(items[i].id))
    return csgIndexCanonicalOrder(keys)

@borrows
fn csgIndexFunctionOrder(items: CsgCoreIndexFunction[]): int32[] =
    var keys: str[]
    for i in 0..<items.len:
        add(keys, strings.CloneStr(items[i].id))
    return csgIndexCanonicalOrder(keys)

@borrows
fn csgIndexCallOrder(items: CsgCoreIndexCall[]): int32[] =
    var keys: str[]
    for i in 0..<items.len:
        add(keys, strings.CloneStr(items[i].id))
    return csgIndexCanonicalOrder(keys)

@borrows
fn csgIndexAppendFiles(buf: var layout.ByteBuf, items: CsgCoreIndexFile[]) =
    let order = csgIndexFileOrder(items)
    csgIndexBufStr(buf, "[")
    for i in 0..<order.len:
        if i > 0:
            csgIndexBufStr(buf, ",")
        csgIndexAppendFileJson(buf, items[order[i]])
    csgIndexBufStr(buf, "]")

@borrows
fn csgIndexAppendSymbols(buf: var layout.ByteBuf, items: CsgCoreIndexSymbol[]) =
    let order = csgIndexSymbolOrder(items)
    csgIndexBufStr(buf, "[")
    for i in 0..<order.len:
        if i > 0:
            csgIndexBufStr(buf, ",")
        csgIndexAppendSymbolJson(buf, items[order[i]])
    csgIndexBufStr(buf, "]")

@borrows
fn csgIndexAppendFunctions(buf: var layout.ByteBuf, items: CsgCoreIndexFunction[]) =
    let order = csgIndexFunctionOrder(items)
    csgIndexBufStr(buf, "[")
    for i in 0..<order.len:
        if i > 0:
            csgIndexBufStr(buf, ",")
        csgIndexAppendFunctionJson(buf, items[order[i]])
    csgIndexBufStr(buf, "]")

@borrows
fn csgIndexAppendCalls(buf: var layout.ByteBuf, items: CsgCoreIndexCall[]) =
    let order = csgIndexCallOrder(items)
    csgIndexBufStr(buf, "[")
    for i in 0..<order.len:
        if i > 0:
            csgIndexBufStr(buf, ",")
        csgIndexAppendCallJson(buf, items[order[i]])
    csgIndexBufStr(buf, "]")

@borrows
fn csgIndexRowsFromCanonicalLines(
        lines: str[],
        files: var CsgCoreIndexFile[],
        symbols: var CsgCoreIndexSymbol[],
        functions: var CsgCoreIndexFunction[],
        calls: var CsgCoreIndexCall[]) =
    files = []
    symbols = []
    functions = []
    calls = []
    for i in 0..<lines.len:
        if lines[i].len > 0:
            csgIndexScanLine(
                lines[i], files, symbols, functions, calls)
    csgIndexApplyCallCounts(functions, calls)

@borrows
fn csgIndexPayloadJson(
        files: CsgCoreIndexFile[],
        symbols: CsgCoreIndexSymbol[],
        functions: CsgCoreIndexFunction[],
        calls: CsgCoreIndexCall[]): str =
    var buf = layout.ByteBufInit(65536)
    csgIndexBufStr(buf, "{\"calls\":")
    csgIndexAppendCalls(buf, calls)
    csgIndexBufStr(buf, ",\"files\":")
    csgIndexAppendFiles(buf, files)
    csgIndexBufStr(buf, ",\"functions\":")
    csgIndexAppendFunctions(buf, functions)
    csgIndexBufStr(buf, ",\"schema\":")
    csgIndexBufQuote(buf, CsgCoreIndexPayloadSchema)
    csgIndexBufStr(buf, ",\"symbols\":")
    csgIndexAppendSymbols(buf, symbols)
    csgIndexBufStr(buf, "}")
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return out

@borrows
fn csgIndexPayloadCid(
        files: CsgCoreIndexFile[],
        symbols: CsgCoreIndexSymbol[],
        functions: CsgCoreIndexFunction[],
        calls: CsgCoreIndexCall[]): str =
    let payload = csgIndexPayloadJson(
        files, symbols, functions, calls)
    let payloadBytes = rawbytes.BytesFromString(payload)
    return merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        CsgCoreIndexPayloadDomain, payloadBytes)

@borrows
fn csgIndexProfilesEqual(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn csgIndexBindingError(binding: CsgCoreIndexBinding): str =
    if binding.standard != CsgCoreIndexStandard ||
       binding.schemaNamespace != CsgCoreIndexStandard:
        return "csg_index_binding_standard_mismatch"
    let profilesError =
        validator.CsgCoreProfilesCanonicalError(
            binding.profiles)
    if profilesError.len > 0:
        return "csg_index_binding_profiles_invalid"
    if binding.profileSetCid !=
       validator.CsgCoreProfileSetCid(binding.profiles):
        return "csg_index_binding_profile_set_cid_mismatch"
    if binding.factCount <= 0 ||
       binding.csgcByteCount < csgc.CsgCoreCsgcHeaderSize:
        return "csg_index_binding_count_invalid"
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.schemaCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.factsRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.dagRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.subgraphCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.csgcDirectoryCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           binding.indexPayloadCid):
        return "csg_index_binding_cid_invalid"
    var bindingError: str
    let expectedSubgraph =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            binding.factCount,
            binding.dagRootCid,
            bindingError)
    if bindingError.len > 0 ||
       expectedSubgraph != binding.subgraphCid:
        return "csg_index_binding_subgraph_cid_mismatch"
    let expectedFactsRoot =
        merkle_dag.CsgCoreMerkleFactsRootForSubgraph(
            binding.standard,
            binding.profiles,
            binding.schemaNamespace,
            binding.schemaCid,
            binding.subgraphCid,
            bindingError)
    if bindingError.len > 0 ||
       expectedFactsRoot != binding.factsRoot:
        return "csg_index_binding_facts_root_mismatch"
    return ""

@borrows
fn csgIndexBindingEqual(
        left: CsgCoreIndexBinding,
        right: CsgCoreIndexBinding): bool =
    return left.standard == right.standard &&
        csgIndexProfilesEqual(left.profiles, right.profiles) &&
        left.profileSetCid == right.profileSetCid &&
        left.schemaNamespace == right.schemaNamespace &&
        left.schemaCid == right.schemaCid &&
        left.factsRoot == right.factsRoot &&
        left.dagRootCid == right.dagRootCid &&
        left.subgraphCid == right.subgraphCid &&
        left.factCount == right.factCount &&
        left.csgcDirectoryCid == right.csgcDirectoryCid &&
        left.csgcObjectCid == right.csgcObjectCid &&
        left.csgcByteCount == right.csgcByteCount &&
        left.indexPayloadCid == right.indexPayloadCid

@borrows
fn CsgCoreIndexBindingFromCanonicalLines(
        lines: str[]): CsgCoreIndexBindingResult =
    let dag =
        validator.CsgCoreMerkleBuildBoundFromCanonicalLines(
            lines)
    if !dag.ok:
        var failed: CsgCoreIndexBindingResult
        failed.error = strings.ConcatStr(
            "csg_index_binding_merkle ", dag.error)
        return failed
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        var failed: CsgCoreIndexBindingResult
        failed.error = strings.ConcatStr(
            "csg_index_binding_csgc ", encoded.error)
        return failed
    if encoded.factCount != dag.factCount:
        rawbytes.BytesFree(encoded.bytes)
        var failed: CsgCoreIndexBindingResult
        failed.error = "csg_index_binding_fact_count_mismatch"
        return failed
    var binding: CsgCoreIndexBinding
    binding.standard = strings.CloneStr(dag.standard)
    binding.profiles =
        validator.CsgCoreProfilesClone(dag.profiles)
    binding.profileSetCid =
        validator.CsgCoreProfileSetCid(dag.profiles)
    binding.schemaNamespace =
        strings.CloneStr(dag.schemaNamespace)
    binding.schemaCid = strings.CloneStr(dag.schemaCid)
    binding.factsRoot = strings.CloneStr(dag.factsRoot)
    binding.dagRootCid = strings.CloneStr(dag.dagRootCid)
    binding.subgraphCid = strings.CloneStr(dag.subgraphCid)
    binding.factCount = dag.factCount
    binding.csgcDirectoryCid =
        strings.CloneStr(encoded.claimedDirectoryCid)
    binding.csgcObjectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            encoded.bytes)
    binding.csgcByteCount = rawbytes.BytesLen(encoded.bytes)
    var files: CsgCoreIndexFile[]
    var symbols: CsgCoreIndexSymbol[]
    var functions: CsgCoreIndexFunction[]
    var calls: CsgCoreIndexCall[]
    csgIndexRowsFromCanonicalLines(
        lines, files, symbols, functions, calls)
    binding.indexPayloadCid = csgIndexPayloadCid(
        files, symbols, functions, calls)
    rawbytes.BytesFree(encoded.bytes)
    let bindingError = csgIndexBindingError(binding)
    if bindingError.len > 0:
        var failed: CsgCoreIndexBindingResult
        failed.error = bindingError
        return failed
    var out: CsgCoreIndexBindingResult
    out.ok = true
    out.binding = binding
    return out

@borrows
fn CsgCoreIndexJson(lines: str[], factsRoot: str, complete: bool): str =
    let bindingResult =
        CsgCoreIndexBindingFromCanonicalLines(lines)
    if !bindingResult.ok:
        panic(strings.CloneStr(bindingResult.error))
    let binding = bindingResult.binding
    if factsRoot != binding.factsRoot:
        panic("csg_index_facts_root_mismatch")
    var files: CsgCoreIndexFile[]
    var symbols: CsgCoreIndexSymbol[]
    var functions: CsgCoreIndexFunction[]
    var calls: CsgCoreIndexCall[]
    csgIndexRowsFromCanonicalLines(
        lines, files, symbols, functions, calls)
    if csgIndexPayloadCid(files, symbols, functions, calls) !=
       binding.indexPayloadCid:
        panic("csg_index_payload_cid_mismatch")
    var buf = layout.ByteBufInit(65536)
    csgIndexBufStr(buf, "{\"calls\":")
    csgIndexAppendCalls(buf, calls)
    csgIndexBufStr(buf, ",\"complete\":")
    csgIndexBufStr(buf, csgIndexBoolJson(complete))
    csgIndexBufStr(buf, ",\"counts\":{\"calls\":")
    csgIndexBufInt(buf, calls.len)
    csgIndexBufStr(buf, ",\"files\":")
    csgIndexBufInt(buf, files.len)
    csgIndexBufStr(buf, ",\"functions\":")
    csgIndexBufInt(buf, functions.len)
    csgIndexBufStr(buf, ",\"symbols\":")
    csgIndexBufInt(buf, symbols.len)
    csgIndexBufStr(buf, "},\"csgc_byte_count\":")
    csgIndexBufInt(buf, binding.csgcByteCount)
    csgIndexBufStr(buf, ",\"csgc_directory_cid\":")
    csgIndexBufQuote(buf, binding.csgcDirectoryCid)
    csgIndexBufStr(buf, ",\"csgc_object_cid\":")
    csgIndexBufQuote(buf, binding.csgcObjectCid)
    csgIndexBufStr(buf, ",\"dag_root_cid\":")
    csgIndexBufQuote(buf, binding.dagRootCid)
    csgIndexBufStr(buf, ",\"fact_count\":")
    csgIndexBufInt(buf, binding.factCount)
    csgIndexBufStr(buf, ",\"facts_root\":")
    csgIndexBufQuote(buf, binding.factsRoot)
    csgIndexBufStr(buf, ",\"files\":")
    csgIndexAppendFiles(buf, files)
    csgIndexBufStr(buf, ",\"functions\":")
    csgIndexAppendFunctions(buf, functions)
    csgIndexBufStr(buf, ",\"index_payload_cid\":")
    csgIndexBufQuote(buf, binding.indexPayloadCid)
    csgIndexBufStr(buf, ",\"profile_set_cid\":")
    csgIndexBufQuote(buf, binding.profileSetCid)
    csgIndexBufStr(buf, ",\"profiles\":")
    csgIndexAppendStringArray(buf, binding.profiles)
    csgIndexBufStr(buf, ",\"schema\":")
    csgIndexBufQuote(buf, CsgCoreIndexSchema)
    csgIndexBufStr(buf, ",\"schema_cid\":")
    csgIndexBufQuote(buf, binding.schemaCid)
    csgIndexBufStr(buf, ",\"schema_namespace\":")
    csgIndexBufQuote(buf, binding.schemaNamespace)
    csgIndexBufStr(buf, ",\"standard\":")
    csgIndexBufQuote(buf, binding.standard)
    csgIndexBufStr(buf, ",\"subgraph_cid\":")
    csgIndexBufQuote(buf, binding.subgraphCid)
    csgIndexBufStr(buf, ",\"symbols\":")
    csgIndexAppendSymbols(buf, symbols)
    csgIndexBufStr(buf, "}")
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return out

@borrows
fn csgIndexReadSetError(state: var csgCoreIndexReadState, error: str) =
    if state.error.len == 0:
        state.error = strings.CloneStr(error)

@borrows
fn csgIndexReadLiteral(
        state: var csgCoreIndexReadState,
        literal: str): bool =
    if state.pos < 0 || state.pos > state.text.len ||
       literal.len > state.text.len - state.pos:
        csgIndexReadSetError(state, "csg_index_truncated")
        return false
    for i in 0..<literal.len:
        if state.text[state.pos + i] != literal[i]:
            csgIndexReadSetError(state, "csg_index_non_canonical")
            return false
    state.pos = state.pos + literal.len
    return true

fn csgIndexHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    return -1

@borrows
fn csgIndexReadString(
        state: var csgCoreIndexReadState,
        out: var str): bool =
    if state.pos < 0 || state.pos >= state.text.len:
        csgIndexReadSetError(state, "csg_index_truncated")
        return false
    if state.text[state.pos] != '"':
        csgIndexReadSetError(state, "csg_index_string_expected")
        return false
    let tokenStart = state.pos
    state.pos = state.pos + 1
    var buf = layout.ByteBufInit(32)
    var closed: bool
    while state.pos < state.text.len && !closed:
        let value = int32(state.text[state.pos]) & 255
        if value == int32('"'):
            state.pos = state.pos + 1
            closed = true
        elif value < 32:
            layout.ByteBufFree(buf)
            csgIndexReadSetError(state, "csg_index_control_byte")
            return false
        elif value != int32('\\'):
            layout.ByteBufAppendByte(buf, value)
            state.pos = state.pos + 1
        else:
            state.pos = state.pos + 1
            if state.pos >= state.text.len:
                layout.ByteBufFree(buf)
                csgIndexReadSetError(state, "csg_index_truncated")
                return false
            let escaped = state.text[state.pos]
            var decoded: int32 = -1
            if escaped == '"':
                decoded = int32('"')
            elif escaped == '\\':
                decoded = int32('\\')
            elif escaped == '/':
                decoded = int32('/')
            elif escaped == 'b':
                decoded = 8
            elif escaped == 't':
                decoded = 9
            elif escaped == 'n':
                decoded = 10
            elif escaped == 'f':
                decoded = 12
            elif escaped == 'r':
                decoded = 13
            elif escaped == 'u':
                if state.text.len - state.pos < 5:
                    layout.ByteBufFree(buf)
                    csgIndexReadSetError(state, "csg_index_truncated")
                    return false
                let h0 = csgIndexHexValue(state.text[state.pos + 1])
                let h1 = csgIndexHexValue(state.text[state.pos + 2])
                let h2 = csgIndexHexValue(state.text[state.pos + 3])
                let h3 = csgIndexHexValue(state.text[state.pos + 4])
                if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0:
                    layout.ByteBufFree(buf)
                    csgIndexReadSetError(state, "csg_index_unicode_escape")
                    return false
                decoded = h0 * 4096 + h1 * 256 + h2 * 16 + h3
                if decoded > 255:
                    layout.ByteBufFree(buf)
                    csgIndexReadSetError(state, "csg_index_non_canonical")
                    return false
                state.pos = state.pos + 4
            else:
                layout.ByteBufFree(buf)
                csgIndexReadSetError(state, "csg_index_escape_invalid")
                return false
            layout.ByteBufAppendByte(buf, decoded)
            state.pos = state.pos + 1
    if !closed:
        layout.ByteBufFree(buf)
        csgIndexReadSetError(state, "csg_index_truncated")
        return false
    var bytes = layout.ByteBufToBytes(buf)
    let decodedText = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    let quoted = canonical.CsgCoreJsonQuoteChecked(decodedText)
    if !quoted.ok:
        csgIndexReadSetError(state, "csg_index_invalid_utf8")
        return false
    let token = strings.CloneStrRange(
        state.text, tokenStart, state.pos - tokenStart)
    if quoted.value != token:
        csgIndexReadSetError(state, "csg_index_non_canonical")
        return false
    out = decodedText
    return true

@borrows
fn csgIndexReadNat32(
        state: var csgCoreIndexReadState,
        out: var int32): bool =
    if state.pos < 0 || state.pos >= state.text.len:
        csgIndexReadSetError(state, "csg_index_truncated")
        return false
    let first = state.text[state.pos]
    if first < '0' || first > '9':
        csgIndexReadSetError(state, "csg_index_integer_expected")
        return false
    if first == '0':
        state.pos = state.pos + 1
        if state.pos < state.text.len &&
           state.text[state.pos] >= '0' && state.text[state.pos] <= '9':
            csgIndexReadSetError(state, "csg_index_non_canonical")
            return false
        out = 0
        return true
    var value: int32
    while state.pos < state.text.len &&
          state.text[state.pos] >= '0' && state.text[state.pos] <= '9':
        let digit = int32(state.text[state.pos]) - int32('0')
        if value > (2147483647 - digit) / 10:
            csgIndexReadSetError(state, "csg_index_integer_overflow")
            return false
        value = value * 10 + digit
        state.pos = state.pos + 1
    out = value
    return true

@borrows
fn csgIndexReadNatText(
        state: var csgCoreIndexReadState,
        out: var str): bool =
    var value: int32
    if !csgIndexReadNat32(state, value):
        return false
    out = strings.IntToStr(value)
    return true

@borrows
fn csgIndexReadBool(
        state: var csgCoreIndexReadState,
        out: var bool): bool =
    if state.pos < 0 || state.pos >= state.text.len:
        csgIndexReadSetError(state, "csg_index_truncated")
        return false
    if state.text[state.pos] == 't':
        if !csgIndexReadLiteral(state, "true"):
            return false
        out = true
        return true
    if state.text[state.pos] == 'f':
        if !csgIndexReadLiteral(state, "false"):
            return false
        out = false
        return true
    csgIndexReadSetError(state, "csg_index_boolean_expected")
    return false

@borrows
fn csgIndexReadStringArray(
        state: var csgCoreIndexReadState,
        values: var str[]): bool =
    if !csgIndexReadLiteral(state, "["):
        return false
    if state.pos < state.text.len && state.text[state.pos] == ']':
        state.pos = state.pos + 1
        return true
    var previous: str
    var done: bool
    while !done:
        var value: str
        if !csgIndexReadString(state, value):
            return false
        if value.len == 0:
            csgIndexReadSetError(
                state, "csg_index_profile_empty")
            return false
        if previous.len > 0 &&
           csgIndexTextCompare(previous, value) >= 0:
            csgIndexReadSetError(
                state, "csg_index_profiles_not_canonical")
            return false
        previous = strings.CloneStr(value)
        add(values, value)
        if !csgIndexReadArrayCloseOrComma(state, done):
            return false
    return true

@borrows
fn csgIndexReadFile(
        state: var csgCoreIndexReadState,
        item: var CsgCoreIndexFile): bool =
    return csgIndexReadLiteral(state, "{\"call_count\":") &&
           csgIndexReadNat32(state, item.callCount) &&
           csgIndexReadLiteral(state, ",\"fact_count\":") &&
           csgIndexReadNat32(state, item.factCount) &&
           csgIndexReadLiteral(state, ",\"file\":") &&
           csgIndexReadString(state, item.file) &&
           csgIndexReadLiteral(state, ",\"function_count\":") &&
           csgIndexReadNat32(state, item.functionCount) &&
           csgIndexReadLiteral(state, ",\"module_id\":") &&
           csgIndexReadString(state, item.moduleId) &&
           csgIndexReadLiteral(state, ",\"symbol_count\":") &&
           csgIndexReadNat32(state, item.symbolCount) &&
           csgIndexReadLiteral(state, "}")

@borrows
fn csgIndexReadSymbol(
        state: var csgCoreIndexReadState,
        item: var CsgCoreIndexSymbol): bool =
    return csgIndexReadLiteral(state, "{\"column\":") &&
           csgIndexReadNatText(state, item.column) &&
           csgIndexReadLiteral(state, ",\"exported\":") &&
           csgIndexReadBool(state, item.exported) &&
           csgIndexReadLiteral(state, ",\"file\":") &&
           csgIndexReadString(state, item.file) &&
           csgIndexReadLiteral(state, ",\"fq_name\":") &&
           csgIndexReadString(state, item.fqName) &&
           csgIndexReadLiteral(state, ",\"id\":") &&
           csgIndexReadString(state, item.id) &&
           csgIndexReadLiteral(state, ",\"line\":") &&
           csgIndexReadNatText(state, item.line) &&
           csgIndexReadLiteral(state, ",\"name\":") &&
           csgIndexReadString(state, item.name) &&
           csgIndexReadLiteral(state, ",\"symbol_kind\":") &&
           csgIndexReadString(state, item.symbolKind) &&
           csgIndexReadLiteral(state, "}")

@borrows
fn csgIndexReadFunction(
        state: var csgCoreIndexReadState,
        item: var CsgCoreIndexFunction): bool =
    return csgIndexReadLiteral(state, "{\"call_count\":") &&
           csgIndexReadNat32(state, item.callCount) &&
           csgIndexReadLiteral(state, ",\"column\":") &&
           csgIndexReadNatText(state, item.column) &&
           csgIndexReadLiteral(state, ",\"exported\":") &&
           csgIndexReadBool(state, item.exported) &&
           csgIndexReadLiteral(state, ",\"file\":") &&
           csgIndexReadString(state, item.file) &&
           csgIndexReadLiteral(state, ",\"id\":") &&
           csgIndexReadString(state, item.id) &&
           csgIndexReadLiteral(state, ",\"line\":") &&
           csgIndexReadNatText(state, item.line) &&
           csgIndexReadLiteral(state, ",\"name\":") &&
           csgIndexReadString(state, item.name) &&
           csgIndexReadLiteral(state, ",\"symbol\":") &&
           csgIndexReadString(state, item.symbol) &&
           csgIndexReadLiteral(state, "}")

@borrows
fn csgIndexReadCall(
        state: var csgCoreIndexReadState,
        item: var CsgCoreIndexCall): bool =
    return csgIndexReadLiteral(state, "{\"callee_kind\":") &&
           csgIndexReadString(state, item.calleeKind) &&
           csgIndexReadLiteral(state, ",\"callee_text\":") &&
           csgIndexReadString(state, item.calleeText) &&
           csgIndexReadLiteral(state, ",\"column\":") &&
           csgIndexReadNatText(state, item.column) &&
           csgIndexReadLiteral(state, ",\"file\":") &&
           csgIndexReadString(state, item.file) &&
           csgIndexReadLiteral(state, ",\"id\":") &&
           csgIndexReadString(state, item.id) &&
           csgIndexReadLiteral(state, ",\"line\":") &&
           csgIndexReadNatText(state, item.line) &&
           csgIndexReadLiteral(state, ",\"owner\":") &&
           csgIndexReadString(state, item.owner) &&
           csgIndexReadLiteral(state, ",\"target_name\":") &&
           csgIndexReadString(state, item.targetName) &&
           csgIndexReadLiteral(state, ",\"target_ref_id\":") &&
           csgIndexReadString(state, item.targetRefId) &&
           csgIndexReadLiteral(state, "}")

@borrows
fn csgIndexReadArrayCloseOrComma(
        state: var csgCoreIndexReadState,
        done: var bool): bool =
    if state.pos >= state.text.len:
        csgIndexReadSetError(state, "csg_index_truncated")
        return false
    if state.text[state.pos] == ']':
        state.pos = state.pos + 1
        done = true
        return true
    if state.text[state.pos] != ',':
        csgIndexReadSetError(state, "csg_index_array_delimiter")
        return false
    state.pos = state.pos + 1
    return true

@borrows
fn csgIndexReadFiles(
        state: var csgCoreIndexReadState,
        items: var CsgCoreIndexFile[]): bool =
    if !csgIndexReadLiteral(state, "["):
        return false
    if state.pos < state.text.len && state.text[state.pos] == ']':
        state.pos = state.pos + 1
        return true
    var previous: str
    var done: bool
    while !done:
        var item: CsgCoreIndexFile
        if !csgIndexReadFile(state, item):
            return false
        if item.file.len == 0:
            csgIndexReadSetError(state, "csg_index_empty_key")
            return false
        if previous.len > 0:
            let order = csgIndexTextCompare(previous, item.file)
            if order == 0:
                csgIndexReadSetError(state, "csg_index_duplicate_key")
                return false
            if order > 0:
                csgIndexReadSetError(state, "csg_index_key_order")
                return false
        previous = strings.CloneStr(item.file)
        add(items, item)
        if !csgIndexReadArrayCloseOrComma(state, done):
            return false
    return true

@borrows
fn csgIndexReadSymbols(
        state: var csgCoreIndexReadState,
        items: var CsgCoreIndexSymbol[]): bool =
    if !csgIndexReadLiteral(state, "["):
        return false
    if state.pos < state.text.len && state.text[state.pos] == ']':
        state.pos = state.pos + 1
        return true
    var previous: str
    var done: bool
    while !done:
        var item: CsgCoreIndexSymbol
        if !csgIndexReadSymbol(state, item):
            return false
        if item.id.len == 0:
            csgIndexReadSetError(state, "csg_index_empty_key")
            return false
        if previous.len > 0:
            let order = csgIndexTextCompare(previous, item.id)
            if order == 0:
                csgIndexReadSetError(state, "csg_index_duplicate_key")
                return false
            if order > 0:
                csgIndexReadSetError(state, "csg_index_key_order")
                return false
        previous = strings.CloneStr(item.id)
        add(items, item)
        if !csgIndexReadArrayCloseOrComma(state, done):
            return false
    return true

@borrows
fn csgIndexReadFunctions(
        state: var csgCoreIndexReadState,
        items: var CsgCoreIndexFunction[]): bool =
    if !csgIndexReadLiteral(state, "["):
        return false
    if state.pos < state.text.len && state.text[state.pos] == ']':
        state.pos = state.pos + 1
        return true
    var previous: str
    var done: bool
    while !done:
        var item: CsgCoreIndexFunction
        if !csgIndexReadFunction(state, item):
            return false
        if item.id.len == 0:
            csgIndexReadSetError(state, "csg_index_empty_key")
            return false
        if previous.len > 0:
            let order = csgIndexTextCompare(previous, item.id)
            if order == 0:
                csgIndexReadSetError(state, "csg_index_duplicate_key")
                return false
            if order > 0:
                csgIndexReadSetError(state, "csg_index_key_order")
                return false
        previous = strings.CloneStr(item.id)
        add(items, item)
        if !csgIndexReadArrayCloseOrComma(state, done):
            return false
    return true

@borrows
fn csgIndexReadCalls(
        state: var csgCoreIndexReadState,
        items: var CsgCoreIndexCall[]): bool =
    if !csgIndexReadLiteral(state, "["):
        return false
    if state.pos < state.text.len && state.text[state.pos] == ']':
        state.pos = state.pos + 1
        return true
    var previous: str
    var done: bool
    while !done:
        var item: CsgCoreIndexCall
        if !csgIndexReadCall(state, item):
            return false
        if item.id.len == 0:
            csgIndexReadSetError(state, "csg_index_empty_key")
            return false
        if previous.len > 0:
            let order = csgIndexTextCompare(previous, item.id)
            if order == 0:
                csgIndexReadSetError(state, "csg_index_duplicate_key")
                return false
            if order > 0:
                csgIndexReadSetError(state, "csg_index_key_order")
                return false
        previous = strings.CloneStr(item.id)
        add(items, item)
        if !csgIndexReadArrayCloseOrComma(state, done):
            return false
    return true

@borrows
fn csgIndexFactsRootValid(root: str): bool =
    if root.len != 71:
        return false
    let prefix = "sha256:"
    for i in 0..<prefix.len:
        if root[i] != prefix[i]:
            return false
    for i in 7..<root.len:
        let ch = root[i]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn csgIndexFileRow(
        files: CsgCoreIndexFile[], key: str): int32 =
    var low: int32
    var high = files.len
    while low < high:
        let middle = low + (high - low) / 2
        let order = csgIndexTextCompare(files[middle].file, key)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < files.len && files[low].file == key:
        return low
    return -1

@borrows
fn csgIndexSymbolRow(
        symbols: CsgCoreIndexSymbol[], key: str): int32 =
    var low: int32
    var high = symbols.len
    while low < high:
        let middle = low + (high - low) / 2
        let order = csgIndexTextCompare(symbols[middle].id, key)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < symbols.len && symbols[low].id == key:
        return low
    return -1

@borrows
fn csgIndexFunctionRow(
        functions: CsgCoreIndexFunction[], key: str): int32 =
    var low: int32
    var high = functions.len
    while low < high:
        let middle = low + (high - low) / 2
        let order = csgIndexTextCompare(functions[middle].id, key)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < functions.len && functions[low].id == key:
        return low
    return -1

@borrows
fn csgIndexCallRow(
        calls: CsgCoreIndexCall[], key: str): int32 =
    var low: int32
    var high = calls.len
    while low < high:
        let middle = low + (high - low) / 2
        let order = csgIndexTextCompare(calls[middle].id, key)
        if order < 0:
            low = middle + 1
        else:
            high = middle
    if low < calls.len && calls[low].id == key:
        return low
    return -1

@borrows
fn csgIndexArtifactConsistent(
        artifact: CsgCoreIndexArtifact): bool =
    var symbolCounts: int32[]
    var functionCounts: int32[]
    var callCounts: int32[]
    var functionCallCounts: int32[]
    setLen(symbolCounts, artifact.files.len)
    setLen(functionCounts, artifact.files.len)
    setLen(callCounts, artifact.files.len)
    setLen(functionCallCounts, artifact.functions.len)
    for i in 0..<artifact.symbols.len:
        let row = csgIndexFileRow(
            artifact.files, artifact.symbols[i].file)
        if row < 0:
            return false
        symbolCounts[row] = symbolCounts[row] + 1
    for i in 0..<artifact.functions.len:
        let row = csgIndexFileRow(
            artifact.files, artifact.functions[i].file)
        if row < 0:
            return false
        functionCounts[row] = functionCounts[row] + 1
    for i in 0..<artifact.calls.len:
        let row = csgIndexFileRow(
            artifact.files, artifact.calls[i].file)
        if row < 0:
            return false
        callCounts[row] = callCounts[row] + 1
        let functionRow = csgIndexFunctionRow(
            artifact.functions, artifact.calls[i].owner)
        if functionRow < 0:
            return false
        functionCallCounts[functionRow] =
            functionCallCounts[functionRow] + 1
    for i in 0..<artifact.files.len:
        if artifact.files[i].symbolCount != symbolCounts[i] ||
           artifact.files[i].functionCount != functionCounts[i] ||
           artifact.files[i].callCount != callCounts[i]:
            return false
    for i in 0..<artifact.functions.len:
        if artifact.functions[i].callCount != functionCallCounts[i]:
            return false
    return true

@borrows
fn csgIndexLoadFail(error: str): CsgCoreIndexLoadResult =
    var out: CsgCoreIndexLoadResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgIndexBindingMismatch(
        actual: CsgCoreIndexBinding,
        expected: CsgCoreIndexBinding): str =
    if actual.standard != expected.standard:
        return "csg_index_standard_binding_mismatch"
    if !csgIndexProfilesEqual(
           actual.profiles, expected.profiles):
        return "csg_index_profiles_binding_mismatch"
    if actual.profileSetCid != expected.profileSetCid:
        return "csg_index_profile_set_cid_binding_mismatch"
    if actual.schemaNamespace != expected.schemaNamespace:
        return "csg_index_schema_namespace_binding_mismatch"
    if actual.schemaCid != expected.schemaCid:
        return "csg_index_schema_cid_binding_mismatch"
    if actual.factsRoot != expected.factsRoot:
        return "csg_index_facts_root_mismatch"
    if actual.dagRootCid != expected.dagRootCid:
        return "csg_index_dag_root_cid_mismatch"
    if actual.subgraphCid != expected.subgraphCid:
        return "csg_index_subgraph_cid_mismatch"
    if actual.factCount != expected.factCount:
        return "csg_index_fact_count_binding_mismatch"
    if actual.csgcDirectoryCid != expected.csgcDirectoryCid:
        return "csg_index_csgc_directory_cid_mismatch"
    if actual.csgcObjectCid != expected.csgcObjectCid:
        return "csg_index_csgc_object_cid_mismatch"
    if actual.csgcByteCount != expected.csgcByteCount:
        return "csg_index_csgc_byte_count_mismatch"
    if actual.indexPayloadCid != expected.indexPayloadCid:
        return "csg_index_payload_cid_binding_mismatch"
    return ""

@borrows
fn CsgCoreIndexLoadBound(
        raw: str,
        expected: CsgCoreIndexBinding): CsgCoreIndexLoadResult =
    if csgIndexBindingError(expected).len > 0:
        return csgIndexLoadFail(
            "csg_index_expected_binding_invalid")
    var state: csgCoreIndexReadState
    state.text = strings.CloneStr(raw)
    var artifact: CsgCoreIndexArtifact
    var complete: bool
    var callCount: int32
    var fileCount: int32
    var functionCount: int32
    var symbolCount: int32
    var schema: str
    var standard: str
    if !csgIndexReadLiteral(state, "{\"calls\":") ||
       !csgIndexReadCalls(state, artifact.calls) ||
       !csgIndexReadLiteral(state, ",\"complete\":") ||
       !csgIndexReadBool(state, complete) ||
       !csgIndexReadLiteral(state, ",\"counts\":{\"calls\":") ||
       !csgIndexReadNat32(state, callCount) ||
       !csgIndexReadLiteral(state, ",\"files\":") ||
       !csgIndexReadNat32(state, fileCount) ||
       !csgIndexReadLiteral(state, ",\"functions\":") ||
       !csgIndexReadNat32(state, functionCount) ||
       !csgIndexReadLiteral(state, ",\"symbols\":") ||
       !csgIndexReadNat32(state, symbolCount) ||
       !csgIndexReadLiteral(state, "},\"csgc_byte_count\":") ||
       !csgIndexReadNat32(state, artifact.binding.csgcByteCount) ||
       !csgIndexReadLiteral(state, ",\"csgc_directory_cid\":") ||
       !csgIndexReadString(state, artifact.binding.csgcDirectoryCid) ||
       !csgIndexReadLiteral(state, ",\"csgc_object_cid\":") ||
       !csgIndexReadString(state, artifact.binding.csgcObjectCid) ||
       !csgIndexReadLiteral(state, ",\"dag_root_cid\":") ||
       !csgIndexReadString(state, artifact.binding.dagRootCid) ||
       !csgIndexReadLiteral(state, ",\"fact_count\":") ||
       !csgIndexReadNat32(state, artifact.binding.factCount) ||
       !csgIndexReadLiteral(state, ",\"facts_root\":") ||
       !csgIndexReadString(state, artifact.binding.factsRoot) ||
       !csgIndexReadLiteral(state, ",\"files\":") ||
       !csgIndexReadFiles(state, artifact.files) ||
       !csgIndexReadLiteral(state, ",\"functions\":") ||
       !csgIndexReadFunctions(state, artifact.functions) ||
       !csgIndexReadLiteral(state, ",\"index_payload_cid\":") ||
       !csgIndexReadString(state, artifact.binding.indexPayloadCid) ||
       !csgIndexReadLiteral(state, ",\"profile_set_cid\":") ||
       !csgIndexReadString(state, artifact.binding.profileSetCid) ||
       !csgIndexReadLiteral(state, ",\"profiles\":") ||
       !csgIndexReadStringArray(state, artifact.binding.profiles) ||
       !csgIndexReadLiteral(state, ",\"schema\":") ||
       !csgIndexReadString(state, schema) ||
       !csgIndexReadLiteral(state, ",\"schema_cid\":") ||
       !csgIndexReadString(state, artifact.binding.schemaCid) ||
       !csgIndexReadLiteral(state, ",\"schema_namespace\":") ||
       !csgIndexReadString(state, artifact.binding.schemaNamespace) ||
       !csgIndexReadLiteral(state, ",\"standard\":") ||
       !csgIndexReadString(state, standard) ||
       !csgIndexReadLiteral(state, ",\"subgraph_cid\":") ||
       !csgIndexReadString(state, artifact.binding.subgraphCid) ||
       !csgIndexReadLiteral(state, ",\"symbols\":") ||
       !csgIndexReadSymbols(state, artifact.symbols) ||
       !csgIndexReadLiteral(state, "}"):
        return csgIndexLoadFail(state.error)
    if state.pos != state.text.len:
        return csgIndexLoadFail("csg_index_trailing_input")
    if schema != CsgCoreIndexSchema:
        return csgIndexLoadFail("csg_index_schema_mismatch")
    if standard != CsgCoreIndexStandard:
        return csgIndexLoadFail("csg_index_standard_mismatch")
    artifact.binding.standard = strings.CloneStr(standard)
    if !complete:
        return csgIndexLoadFail("csg_index_incomplete")
    artifact.complete = true
    if callCount != artifact.calls.len ||
       fileCount != artifact.files.len ||
       functionCount != artifact.functions.len ||
       symbolCount != artifact.symbols.len:
        return csgIndexLoadFail("csg_index_count_mismatch")
    let bindingError = csgIndexBindingError(artifact.binding)
    if bindingError.len > 0:
        return csgIndexLoadFail(bindingError)
    let mismatch =
        csgIndexBindingMismatch(
            artifact.binding, expected)
    if mismatch.len > 0:
        return csgIndexLoadFail(mismatch)
    if !csgIndexArtifactConsistent(artifact):
        return csgIndexLoadFail("csg_index_record_count_mismatch")
    if csgIndexPayloadCid(
           artifact.files,
           artifact.symbols,
           artifact.functions,
           artifact.calls) != artifact.binding.indexPayloadCid:
        return csgIndexLoadFail("csg_index_payload_cid_mismatch")
    var out: CsgCoreIndexLoadResult
    out.ok = true
    out.artifact = artifact
    return out

@borrows
fn CsgCoreIndexLoad(
        raw: str,
        expectedFactsRoot: str): CsgCoreIndexLoadResult =
    if !csgIndexFactsRootValid(expectedFactsRoot):
        return csgIndexLoadFail(
            "csg_index_expected_facts_root_invalid")
    return csgIndexLoadFail(
        "csg_index_full_binding_required")

@borrows
fn csgIndexQueryFail(error: str): CsgCoreIndexQueryResult =
    var out: CsgCoreIndexQueryResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreIndexQueryExact(
        artifact: var CsgCoreIndexArtifact,
        expectedFactsRoot: str,
        keyKind: int32,
        key: str): CsgCoreIndexQueryResult =
    if !csgIndexFactsRootValid(expectedFactsRoot):
        return csgIndexQueryFail(
            "csg_index_expected_facts_root_invalid")
    return csgIndexQueryFail(
        "csg_index_full_binding_required")

@borrows
fn CsgCoreIndexQueryExactBound(
        artifact: var CsgCoreIndexArtifact,
        expected: CsgCoreIndexBinding,
        keyKind: int32,
        key: str): CsgCoreIndexQueryResult =
    if !artifact.complete ||
       csgIndexBindingError(expected).len > 0 ||
       csgIndexBindingError(artifact.binding).len > 0 ||
       !csgIndexBindingEqual(
           artifact.binding, expected):
        return csgIndexQueryFail("csg_index_not_admitted")
    if key.len == 0:
        return csgIndexQueryFail("csg_index_query_key_empty")
    var row: int32 = -1
    if keyKind == CsgCoreIndexKeyFile:
        row = csgIndexFileRow(artifact.files, key)
    elif keyKind == CsgCoreIndexKeySymbol:
        row = csgIndexSymbolRow(artifact.symbols, key)
    elif keyKind == CsgCoreIndexKeyFunction:
        row = csgIndexFunctionRow(artifact.functions, key)
    elif keyKind == CsgCoreIndexKeyCall:
        row = csgIndexCallRow(artifact.calls, key)
    else:
        return csgIndexQueryFail("csg_index_query_kind_invalid")
    var out: CsgCoreIndexQueryResult
    out.ok = true
    out.found = row >= 0
    out.row = row
    return out
