import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_cargo
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_invalidation
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_identity
import cheng/core/csg_core/merkle_store_snapshot_reader
import cheng/core/csg_core/merkle_transaction_authority
import cheng/core/csg_core/merkle_transaction_operation
import cheng/core/csg_core/merkle_transaction_receipt
import cheng/core/csg_core/merkle_transaction_request
import cheng/core/csg_core/validator

const
    CsgTransactionDelete: int32 = 1
    CsgTransactionReplace: int32 = 2
    CsgTransactionInsert: int32 = 3
    CsgTransactionSchemaNamespace: str = "csg_core::v1"
    CsgTransactionMaxGeneration: int64 = 9223372036854775806

type
    CsgCoreMerkleTransactionDependency =
        providerSource: str
        providerFactKind: str
        selector: str

    CsgCoreMerkleTransactionReplacement =
        sourceId: str
        sourceCid: str
        facts: str[]
        dependencies: CsgCoreMerkleTransactionDependency[]
        requireDedicatedStore: bool
        requiredStoreStandard: str
        requiredStoreProfiles: str[]
        requiredStoreProfileSetCid: str
        requiredStoreSchemaNamespace: str
        requiredStoreSchemaCid: str

    CsgCoreMerkleTransactionCounters =
        dependencyObjectsDecoded: int32
        queryShardObjectsDecoded: int32
        nodeObjectsRead: int32
        nodeObjectsWritten: int32
        invalidatedPartitionDecodeCount: int32
        untouchedPartitionDecodeCount: int32
        untouchedMembershipDecodeCount: int32
        materialSourceCount: int32
        rebuiltPartitionCount: int32
        rebuiltMembershipCount: int32
        rebuiltDependencyConsumerShardCount: int32
        rebuiltDependencyProviderShardCount: int32
        rebuiltQueryShardCount: int32
        plannedDeleteCount: int32
        plannedReplaceCount: int32
        plannedInsertCount: int32
        storeObjectWriteCount: int32
        storeObjectReuseCount: int32
        publishAttemptCount: int32
        computedNodeCount: int64
        rebuiltNodeCount: int64
        discardedIntermediateNodeCount: int64
        reusedNodeCount: int64
        overlayLookupComparisonCount: int64
        overlayCloneCount: int64

    CsgCoreMerkleTransactionResult =
        ok: bool
        planReady: bool
        productionApplied: bool
        error: str
        blockedBy: str
        headCid: str
        manifestCid: str
        receiptCid: str
        requestCid: str
        planRoot: str
        csgcDirectoryCid: str
        factCount: int32
        reused: bool
        # Domain C current-HEAD lease identity (int32 row id + epoch).  The
        # lease is acquired before the expected-HEAD read in the plan phase
        # and released exactly once, at commit or at free.  Zero means no
        # lease is carried by this result.
        headLeaseId: int32
        headLeaseEpoch: int32
        invalidation: merkle_invalidation.CsgCoreMerkleInvalidationResult
        counters: CsgCoreMerkleTransactionCounters
        materialSources: str[]
        operationKinds: int32[]
        operationFactKeys: str[]
        prepared:
            merkle_transaction_authority.CsgCoreMerklePreparedTransaction

    csgTransactionSourceSnapshot =
        sourceId: str
        sourceCid: str
        facts: str[]

    csgTransactionFactOperation =
        kind: int32
        factKey: str

    csgTransactionApplyArtifacts =
        requestArtifact:
            merkle_transaction_request.CsgCoreMerkleTransactionRequestCidResult
        previousLocal: merkle_builder.CsgCoreMerkleBuilderLocalResult
        local: merkle_builder.CsgCoreMerkleBuilderLocalResult
        dependencyConsumerShards: merkle_artifacts.CsgCoreMerkleDependencyShardResult[]
        dependencyProviderShards: merkle_artifacts.CsgCoreMerkleDependencyShardResult[]
        queryShards: merkle_artifacts.CsgCoreMerkleQueryShardResult[]
        touchedProviderSources: str[]
        touchedQueryBuckets: str[]
        summary: merkle_artifacts.CsgCoreMerkleSummaryResult

    csgTransactionBaseArtifactMade =
        ok: bool
        artifact:
            merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput

@borrows
fn csgTransactionCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn csgTransactionTextCompare(
        left: str,
        right: str): int32 =
    let common =
        left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgTransactionTuple(value: str): str =
    return csgTransactionCat(
        csgTransactionCat(
            strings.IntToStr(value.len), ":"),
        value)

@borrows
fn csgTransactionFail(
        error: str):
        CsgCoreMerkleTransactionResult =
    var out: CsgCoreMerkleTransactionResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn csgTransactionManifestProductionEligible(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest):
        bool =
    return manifest.complete &&
        manifest.unsupportedCount == 0 &&
        manifest.tombstoneCount == 0

@borrows
fn csgTransactionManifestMatchesReplacementPolicies(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        error: var str): bool =
    for replacementIndex in 0..<replacements.len:
        let replacement = replacements[replacementIndex]
        if !replacement.requireDedicatedStore:
            continue
        if replacement.requiredStoreStandard !=
               validator.CsgCoreStandardIdentity() ||
           replacement.requiredStoreSchemaNamespace !=
               validator.CsgCoreSchemaNamespaceIdentity() ||
           replacement.requiredStoreProfileSetCid !=
               validator.CsgCoreProfileSetCid(
                   replacement.requiredStoreProfiles) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               replacement.requiredStoreSchemaCid):
            error =
                "merkle_transaction_replacement_store_policy_invalid"
            return false
        if manifest.standard !=
               replacement.requiredStoreStandard ||
           !validator.CsgCoreProfilesEqual(
               manifest.profiles,
               replacement.requiredStoreProfiles) ||
           manifest.profileSetCid !=
               replacement.requiredStoreProfileSetCid ||
           manifest.schemaCid !=
               replacement.requiredStoreSchemaCid:
            error =
                "merkle_transaction_replacement_store_policy_mismatch"
            return false
        if manifest.partitions.len == 0:
            error =
                "merkle_transaction_replacement_store_partition_missing"
            return false
        for partitionIndex in 0..<manifest.partitions.len:
            if manifest.partitions[partitionIndex].sourceId !=
                   replacement.sourceId:
                error =
                    "merkle_transaction_replacement_store_source_mismatch"
                return false
    error = ""
    return true

@borrows
fn csgTransactionContains(
        values: str[],
        wanted: str): bool =
    for i in 0..<values.len:
        if values[i] == wanted:
            return true
    return false

@borrows
fn csgTransactionCloneDependency(
        record:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        merkle_artifacts.CsgCoreMerkleDependencyRecord =
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord
    out.consumerSource =
        strings.CloneStr(record.consumerSource)
    out.providerSource =
        strings.CloneStr(record.providerSource)
    out.selector = strings.CloneStr(record.selector)
    out.providerSubgraphCid =
        strings.CloneStr(record.providerSubgraphCid)
    return out

@borrows
fn csgTransactionCloneQuery(
        record:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        merkle_artifacts.CsgCoreMerkleQueryIndexRecord =
    var out: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    out.indexKind = strings.CloneStr(record.indexKind)
    out.term = strings.CloneStr(record.term)
    out.factKey = strings.CloneStr(record.factKey)
    out.factHash = strings.CloneStr(record.factHash)
    out.leafCid = strings.CloneStr(record.leafCid)
    out.partitionId =
        strings.CloneStr(record.partitionId)
    out.sourceId = strings.CloneStr(record.sourceId)
    out.sourceCid = strings.CloneStr(record.sourceCid)
    return out

@borrows
fn csgTransactionDependencyCompare(
        left:
            merkle_artifacts.CsgCoreMerkleDependencyRecord,
        right:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        int32 =
    var order =
        csgTransactionTextCompare(
            left.consumerSource, right.consumerSource)
    if order != 0:
        return order
    order =
        csgTransactionTextCompare(
            left.providerSource, right.providerSource)
    if order != 0:
        return order
    return csgTransactionTextCompare(
        left.selector, right.selector)

@borrows
fn csgTransactionDependencyEqual(
        left:
            merkle_artifacts.CsgCoreMerkleDependencyRecord,
        right:
            merkle_artifacts.CsgCoreMerkleDependencyRecord):
        bool =
    return left.consumerSource == right.consumerSource &&
        left.providerSource == right.providerSource &&
        left.selector == right.selector &&
        left.providerSubgraphCid ==
            right.providerSubgraphCid

@borrows
fn csgTransactionSortDependencies(
        records:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        merkle_artifacts.CsgCoreMerkleDependencyRecord[] =
    var order: int32[]
    var scratch: int32[]
    for i in 0..<records.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgTransactionDependencyCompare(
                        records[order[left]],
                        records[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    for i in 0..<order.len:
        add(
            out,
            csgTransactionCloneDependency(
                records[order[i]]))
    return out

@borrows
fn csgTransactionDependenciesExact(
        left:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        right:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        bool =
    let sortedLeft = csgTransactionSortDependencies(left)
    let sortedRight = csgTransactionSortDependencies(right)
    if sortedLeft.len != sortedRight.len:
        return false
    for i in 0..<sortedLeft.len:
        if !csgTransactionDependencyEqual(
               sortedLeft[i], sortedRight[i]):
            return false
    return true

@borrows
fn csgTransactionQueryCompare(
        left:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        right:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        int32 =
    var order =
        csgTransactionTextCompare(
            left.indexKind, right.indexKind)
    if order != 0:
        return order
    order =
        csgTransactionTextCompare(left.term, right.term)
    if order != 0:
        return order
    order =
        csgTransactionTextCompare(
            left.factKey, right.factKey)
    if order != 0:
        return order
    order =
        csgTransactionTextCompare(
            left.partitionId, right.partitionId)
    if order != 0:
        return order
    return csgTransactionTextCompare(
        left.sourceId, right.sourceId)

@borrows
fn csgTransactionSortQueries(
        records:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]):
        merkle_artifacts.CsgCoreMerkleQueryIndexRecord[] =
    var order: int32[]
    var scratch: int32[]
    for i in 0..<records.len:
        add(order, i)
        add(scratch, 0)
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgTransactionQueryCompare(
                        records[order[left]],
                        records[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var out: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    for i in 0..<order.len:
        add(
            out,
            csgTransactionCloneQuery(
                records[order[i]]))
    return out

@borrows
fn csgTransactionQueryEqual(
        left:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord,
        right:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord):
        bool =
    return left.indexKind == right.indexKind &&
        left.term == right.term &&
        left.factKey == right.factKey &&
        left.factHash == right.factHash &&
        left.leafCid == right.leafCid &&
        left.partitionId == right.partitionId &&
        left.sourceId == right.sourceId &&
        left.sourceCid == right.sourceCid

@borrows
fn csgTransactionQueriesExact(
        left:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        right:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]):
        bool =
    let sortedLeft = csgTransactionSortQueries(left)
    let sortedRight = csgTransactionSortQueries(right)
    if sortedLeft.len != sortedRight.len:
        return false
    for i in 0..<sortedLeft.len:
        if !csgTransactionQueryEqual(
               sortedLeft[i], sortedRight[i]):
            return false
    return true

@borrows
fn csgTransactionSourceIndex(
        sources: csgTransactionSourceSnapshot[],
        sourceId: str): int32 =
    for i in 0..<sources.len:
        if sources[i].sourceId == sourceId:
            return i
    return -1

@borrows
fn csgTransactionReplacementIndex(
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        sourceId: str): int32 =
    for i in 0..<replacements.len:
        if replacements[i].sourceId == sourceId:
            return i
    return -1

@borrows
fn csgTransactionManifestSourceIds(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        sourceIds: var str[],
        error: var str): bool =
    var raw: str[]
    for i in 0..<manifest.partitions.len:
        add(
            raw,
            strings.CloneStr(
                manifest.partitions[i].sourceId))
    let sorted =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            raw)
    for i in 0..<sorted.len:
        if i == 0 || sorted[i] != sorted[i - 1]:
            add(sourceIds, strings.CloneStr(sorted[i]))
    if sourceIds.len == 0:
        error = "merkle_transaction_sources_empty"
        return false
    return true

@borrows
fn csgTransactionBuildShardedInvalidation(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        changedSources: str[],
        out: var
            merkle_invalidation.CsgCoreMerkleInvalidationResult,
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    var sourceIds: str[]
    if !csgTransactionManifestSourceIds(
           manifest, sourceIds, error):
        return false
    let initial =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            sourceIds, [], changedSources)
    if !initial.ok:
        error = csgTransactionCat(
            "merkle_transaction_invalidation ",
            initial.error)
        return false
    var queued: str[]
    for i in 0..<initial.invalidatedSources.len:
        add(
            queued,
            strings.CloneStr(initial.invalidatedSources[i]))
    var edges: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    var cursor: int32
    while cursor < queued.len:
        let providerSource = share(queued[cursor])
        cursor = cursor + 1
        var stagedErr10 = ""
        var shard = csgTransactionReadDependencyShard(
            planning,
            manifest,
            manifest.dependencyProviderShards,
            merkle_artifacts.CsgCoreMerkleDependencyProviderProjection(),
            providerSource,
            counters,
            stagedErr10)
        if stagedErr10.len > 0:
            error = stagedErr10
            return false
        for recordIndex in 0..<shard.records.len:
            var providerBound: bool
            for partitionIndex in 0..<manifest.partitions.len:
                if manifest.partitions[partitionIndex].sourceId ==
                       shard.records[recordIndex].providerSource &&
                   manifest.partitions[partitionIndex].factsRoot ==
                       shard.records[recordIndex].providerSubgraphCid:
                    providerBound = true
            if shard.records[recordIndex].providerSource != providerSource ||
               !csgTransactionContains(
                   sourceIds, shard.records[recordIndex].consumerSource) ||
               !providerBound:
                rawbytes.BytesFree(shard.bytes)
                error =
                    "merkle_transaction_invalidation_dependency_unbound"
                return false
            var edge: merkle_invalidation.CsgCoreMerkleDependencyEdge
            edge.consumerSource =
                strings.CloneStr(shard.records[recordIndex].consumerSource)
            edge.providerSource =
                strings.CloneStr(shard.records[recordIndex].providerSource)
            edge.selector =
                strings.CloneStr(shard.records[recordIndex].selector)
            edge.providerSubgraphCid =
                strings.CloneStr(
                    shard.records[recordIndex].providerSubgraphCid)
            add(edges, edge)
            if !csgTransactionContains(
                   queued, shard.records[recordIndex].consumerSource):
                add(
                    queued,
                    strings.CloneStr(
                        shard.records[recordIndex].consumerSource))
        rawbytes.BytesFree(shard.bytes)
    let built =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            sourceIds, edges, changedSources)
    if !built.ok ||
       built.invalidatedSources.len != queued.len:
        error = "merkle_transaction_invalidation_projection_invalid"
        return false
    for i in 0..<built.invalidatedSources.len:
        if !csgTransactionContains(
               queued, built.invalidatedSources[i]):
            error =
                "merkle_transaction_invalidation_projection_mismatch"
            return false
    out = built
    return true

@borrows
fn csgTransactionValidateReplacements(
        sourceIds: str[],
        invalidatedSources: str[],
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        error: var str): bool =
    if replacements.len != invalidatedSources.len:
        error =
            "merkle_transaction_replacement_count_mismatch"
        return false
    var replacementIds: str[]
    for i in 0..<replacements.len:
        let replacement = replacements[i]
        if replacement.sourceId.len == 0 ||
           replacement.facts.len == 0 ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(
               replacement.sourceCid):
            error =
                "merkle_transaction_replacement_invalid"
            return false
        if !csgTransactionContains(
               sourceIds, replacement.sourceId):
            error =
                "merkle_transaction_replacement_unknown"
            return false
        if !csgTransactionContains(
               invalidatedSources,
               replacement.sourceId):
            error =
                "merkle_transaction_replacement_not_invalidated"
            return false
        for dependencyIndex in
                0..<replacement.dependencies.len:
            let dependency =
                replacement.dependencies[
                    dependencyIndex]
            if dependency.providerSource.len == 0 ||
               dependency.providerFactKind.len == 0 ||
               dependency.selector.len == 0:
                error =
                    "merkle_transaction_replacement_dependency_invalid"
                return false
            if !csgTransactionContains(
                   sourceIds,
                   dependency.providerSource):
                error =
                    "merkle_transaction_replacement_dependency_unknown"
                return false
        add(
            replacementIds,
            strings.CloneStr(replacement.sourceId))
    let sorted =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            replacementIds)
    for i in 1..<sorted.len:
        if sorted[i - 1] == sorted[i]:
            error =
                "merkle_transaction_replacement_duplicate"
            return false
    for i in 0..<invalidatedSources.len:
        if sorted[i] != invalidatedSources[i]:
            error =
                "merkle_transaction_replacement_set_mismatch"
            return false
    return true

@borrows
fn csgTransactionReadInvalidatedSources(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        invalidatedSources: str[],
        snapshots: var csgTransactionSourceSnapshot[],
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    for sourceIndex in 0..<invalidatedSources.len:
        var snapshot: csgTransactionSourceSnapshot
        snapshot.sourceId =
            strings.CloneStr(
                invalidatedSources[sourceIndex])
        var found: int32
        for partitionIndex in
                0..<manifest.partitions.len:
            let record =
                manifest.partitions[partitionIndex]
            if record.sourceId != snapshot.sourceId:
                continue
            var object =
                merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadObject(
                    planning,
                    merkle_store.CsgCoreMerkleStorePartitionArtifactKind(),
                    record.factsCid)
            if !object.ok:
                error =
                    csgTransactionCat(
                        "merkle_transaction_partition_read ",
                        object.error)
                return false
            var decoded =
                merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                    object.bytes)
            rawbytes.BytesFree(object.bytes)
            counters.invalidatedPartitionDecodeCount =
                counters.invalidatedPartitionDecodeCount + 1
            if !decoded.ok ||
               decoded.cid != record.factsCid ||
               decoded.header.sourceId != record.sourceId ||
               decoded.header.sourceCid != record.sourceCid ||
               decoded.header.factKind != record.factKind ||
               decoded.factsRoot != record.factsRoot ||
               decoded.dagRootCid != record.dagRootCid ||
               decoded.factCount != record.factCount:
                rawbytes.BytesFree(decoded.bytes)
                error =
                    "merkle_transaction_partition_projection_mismatch"
                return false
            if found == 0:
                snapshot.sourceCid =
                    strings.CloneStr(record.sourceCid)
            elif snapshot.sourceCid != record.sourceCid:
                rawbytes.BytesFree(decoded.bytes)
                error =
                    "merkle_transaction_source_cid_conflict"
                return false
            for factIndex in 0..<decoded.facts.len:
                add(
                    snapshot.facts,
                    strings.CloneStr(
                        decoded.facts[factIndex]))
            found = found + 1
            rawbytes.BytesFree(decoded.bytes)
        if found == 0 || snapshot.facts.len == 0:
            error =
                "merkle_transaction_invalidated_source_missing"
            return false
        add(snapshots, snapshot)
    return true

@borrows
fn csgTransactionPartitionProjectionMatches(
        record: merkle_manifest.CsgCoreMerklePartitionRecord,
        partition:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult): bool =
    return partition.ok &&
        partition.cid == record.factsCid &&
        partition.header.sourceId == record.sourceId &&
        partition.header.sourceCid == record.sourceCid &&
        partition.header.factKind == record.factKind &&
        partition.factsRoot == record.factsRoot &&
        partition.dagRootCid == record.dagRootCid &&
        partition.factCount == record.factCount &&
        partition.facts.len == record.factCount

@borrows
fn csgTransactionLocalPartitionIndex(
        partitions:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult[],
        factsCid: str): int32 =
    for i in 0..<partitions.len:
        if partitions[i].cid == factsCid:
            return i
    return -1

@borrows
fn csgTransactionFinalCanonicalFacts(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        localPartitions:
            merkle_artifacts.CsgCoreMerklePartitionFactsResult[],
        facts: var str[],
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    var localUsed: bool[]
    setLen(localUsed, localPartitions.len)
    for partitionIndex in 0..<manifest.partitions.len:
        let record = manifest.partitions[partitionIndex]
        let localIndex =
            csgTransactionLocalPartitionIndex(
                localPartitions, record.factsCid)
        if localIndex >= 0:
            if localUsed[localIndex] ||
               !csgTransactionPartitionProjectionMatches(
                   record, localPartitions[localIndex]):
                error =
                    "merkle_transaction_local_partition_projection_mismatch"
                return false
            localUsed[localIndex] = true
            for factIndex in
                    0..<localPartitions[localIndex].facts.len:
                add(
                    facts,
                    strings.CloneStr(
                        localPartitions[localIndex].facts[factIndex]))
            continue
        var object =
            merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadObject(
                planning,
                merkle_store.CsgCoreMerkleStorePartitionArtifactKind(),
                record.factsCid)
        if !object.ok:
            error = csgTransactionCat(
                "merkle_transaction_csgc_partition_read ",
                object.error)
            return false
        var decoded =
            merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
                object.bytes)
        rawbytes.BytesFree(object.bytes)
        counters.untouchedPartitionDecodeCount =
            counters.untouchedPartitionDecodeCount + 1
        if !csgTransactionPartitionProjectionMatches(
               record, decoded):
            rawbytes.BytesFree(decoded.bytes)
            error =
                "merkle_transaction_csgc_partition_projection_mismatch"
            return false
        for factIndex in 0..<decoded.facts.len:
            add(
                facts,
                strings.CloneStr(decoded.facts[factIndex]))
        rawbytes.BytesFree(decoded.bytes)
    for i in 0..<localUsed.len:
        if !localUsed[i]:
            error =
                "merkle_transaction_csgc_local_partition_unbound"
            return false
    if facts.len != manifest.factCount:
        error = "merkle_transaction_csgc_fact_count_mismatch"
        return false
    return true

@borrows
fn csgTransactionCurrentCanonicalFacts(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        facts: var str[],
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    var noLocalPartitions: merkle_artifacts.CsgCoreMerklePartitionFactsResult[]
    return csgTransactionFinalCanonicalFacts(
        planning,
        manifest,
        noLocalPartitions,
        facts,
        counters,
        error)

@borrows
fn csgTransactionCloneNodeRecord(
        source: merkle_dag.CsgCoreMerkleNodeRecord):
        merkle_dag.CsgCoreMerkleNodeRecord =
    var out: merkle_dag.CsgCoreMerkleNodeRecord
    out.kind = source.kind
    out.count = source.count
    out.splitBit = source.splitBit
    out.hash = layout.FixedBytes32Copy(source.hash)
    out.key = strings.CloneStr(source.key)
    out.keyHash = layout.FixedBytes32Copy(source.keyHash)
    out.factHash = layout.FixedBytes32Copy(source.factHash)
    out.leftCount = source.leftCount
    out.leftHash = layout.FixedBytes32Copy(source.leftHash)
    out.rightCount = source.rightCount
    out.rightHash = layout.FixedBytes32Copy(source.rightHash)
    return out

@borrows
fn csgTransactionReadStoredReplayNode(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        expectedCid: str,
        expectedCount: int32,
        node: var merkle_dag.CsgCoreMerkleNodeRecord,
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    var object =
        merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadObject(
            planning,
            merkle_store.CsgCoreMerkleStoreNodeArtifactKind(),
            expectedCid)
    if !object.ok:
        if csgTransactionTextCompare(
               object.error,
               "merkle_store_snapshot_object_cid_mismatch") == 0:
            error = csgTransactionCat(
                "merkle_transaction_path_node_read ",
                strings.CloneStr(object.error))
        else:
            error = csgTransactionCat(
                csgTransactionCat(
                    "merkle_transaction_path_node_read ",
                    "merkle_store_snapshot_child_shape_invalid "),
                strings.CloneStr(object.error))
        return false
    var decoded =
        merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(object.bytes)
    rawbytes.BytesFree(object.bytes)
    if !decoded.ok || decoded.nodes.len != 1 ||
       decoded.nodeCount != 1 ||
       decoded.nodes[0].count != expectedCount ||
       merkle_dag.CsgCoreMerkleNodeRecordCid(decoded.nodes[0]) !=
           expectedCid:
        rawbytes.BytesFree(decoded.bytes)
        error = "merkle_transaction_path_node_shape_invalid"
        return false
    counters.nodeObjectsRead = counters.nodeObjectsRead + 1
    node = csgTransactionCloneNodeRecord(decoded.nodes[0])
    rawbytes.BytesFree(decoded.bytes)
    return true

@borrows
fn csgTransactionStoredReplayPathValid(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate,
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    let proof = candidate.proof
    let verified = merkle_dag.CsgCoreMerkleVerifyFact(
        proof, candidate.replay.beforeFactsRoot, candidate.beforeFact)
    if !verified.ok || !verified.exists ||
       proof.splitBits.len > 256:
        error = "merkle_transaction_path_proof_invalid"
        return false
    var currentCid = strings.CloneStr(proof.dagRootCid)
    var currentCount = proof.factCount
    for depth in 0..<proof.splitBits.len:
        let siblingCount = proof.siblingCounts[depth]
        if siblingCount <= 0 || siblingCount >= currentCount:
            error = "merkle_transaction_path_count_invalid"
            return false
        var branch: merkle_dag.CsgCoreMerkleNodeRecord
        if !csgTransactionReadStoredReplayNode(
               planning,
               currentCid,
               currentCount,
               branch,
               counters,
               error):
            return false
        let childCount = currentCount - siblingCount
        var childHash: layout.FixedBytes32
        if branch.kind != merkle_dag.CsgCoreMerkleBranchNodeKind() ||
           branch.splitBit != proof.splitBits[depth]:
            error = "merkle_transaction_path_branch_invalid"
            return false
        if proof.directions[depth] == 0:
            if branch.leftCount != childCount ||
               branch.rightCount != siblingCount ||
               !layout.FixedBytes32Equal(
                   branch.rightHash, proof.siblingHashes[depth]):
                error = "merkle_transaction_path_branch_invalid"
                return false
            childHash = layout.FixedBytes32Copy(branch.leftHash)
        elif proof.directions[depth] == 1:
            if branch.leftCount != siblingCount ||
               branch.rightCount != childCount ||
               !layout.FixedBytes32Equal(
                   branch.leftHash, proof.siblingHashes[depth]):
                error = "merkle_transaction_path_branch_invalid"
                return false
            childHash = layout.FixedBytes32Copy(branch.rightHash)
        else:
            error = "merkle_transaction_path_direction_invalid"
            return false
        let siblingCid = csgTransactionCat(
            "sha256:",
            layout.FixedBytes32Hex(proof.siblingHashes[depth]))
        var sibling: merkle_dag.CsgCoreMerkleNodeRecord
        if !csgTransactionReadStoredReplayNode(
               planning,
               siblingCid,
               siblingCount,
               sibling,
               counters,
               error):
            return false
        currentCid = csgTransactionCat(
            "sha256:", layout.FixedBytes32Hex(childHash))
        currentCount = childCount
    var leaf: merkle_dag.CsgCoreMerkleNodeRecord
    if currentCount != 1 ||
       !csgTransactionReadStoredReplayNode(
           planning,
           currentCid,
           currentCount,
           leaf,
           counters,
           error):
        return false
    if leaf.kind != merkle_dag.CsgCoreMerkleLeafNodeKind() ||
       leaf.key != proof.terminalKey ||
       !layout.FixedBytes32Equal(
           leaf.factHash, proof.terminalFactHash):
        error = "merkle_transaction_path_leaf_invalid"
        return false
    return true

@borrows
fn csgTransactionPlanIncrementalManifest(
        current: merkle_manifest.CsgCoreMerkleManifest,
        materialSources: str[],
        localManifestPartitions:
            merkle_manifest.CsgCoreMerklePartitionRecord[],
        candidate:
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate,
        manifest: var merkle_manifest.CsgCoreMerkleManifest,
        error: var str): bool =
    if !candidate.replay.ok || !candidate.proof.ok ||
       candidate.replacementCount != 1 ||
       candidate.replay.beforeFactsRoot != current.factsRoot ||
       candidate.replay.beforeDagRootCid != current.dagRootCid ||
       candidate.replay.beforeCount != current.factCount ||
       candidate.replay.beforeBinding.standard != current.standard ||
       candidate.replay.beforeBinding.schemaCid != current.schemaCid ||
       candidate.replay.beforeBinding.profileSetCid != current.profileSetCid ||
       candidate.replay.afterBinding.standard != current.standard ||
       candidate.replay.afterBinding.schemaCid != current.schemaCid ||
       candidate.replay.afterBinding.profileSetCid != current.profileSetCid ||
       !validator.CsgCoreProfilesEqual(
           candidate.replay.beforeBinding.profiles, current.profiles) ||
       !validator.CsgCoreProfilesEqual(
           candidate.replay.afterBinding.profiles, current.profiles):
        error = "merkle_transaction_incremental_binding_invalid"
        return false
    manifest.standard = strings.CloneStr(current.standard)
    manifest.profiles =
        validator.CsgCoreProfilesClone(
            candidate.replay.afterBinding.profiles)
    manifest.profileSetCid =
        strings.CloneStr(candidate.replay.afterBinding.profileSetCid)
    manifest.complete = current.complete
    manifest.schemaCid =
        strings.CloneStr(candidate.replay.afterBinding.schemaCid)
    manifest.unsupportedCount = current.unsupportedCount
    manifest.tombstoneCount = current.tombstoneCount
    manifest.runtimeRequirementCount = current.runtimeRequirementCount
    manifest.partitions = csgTransactionMergePartitions(
        current.partitions,
        materialSources,
        localManifestPartitions)
    var count: int64
    for i in 0..<manifest.partitions.len:
        count = count + int64(manifest.partitions[i].factCount)
        if count > int64(2147483647):
            error = "merkle_transaction_plan_fact_count_overflow"
            return false
    if int32(count) != candidate.replay.afterCount:
        error = "merkle_transaction_incremental_fact_count_mismatch"
        return false
    manifest.factCount = candidate.replay.afterCount
    manifest.factsRoot =
        strings.CloneStr(candidate.replay.afterFactsRoot)
    manifest.dagRootCid =
        strings.CloneStr(candidate.replay.afterDagRootCid)
    return true

@borrows
fn csgTransactionFactsEqual(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    let sortedLeft =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            left)
    let sortedRight =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            right)
    for i in 0..<sortedLeft.len:
        if sortedLeft[i] != sortedRight[i]:
            return false
    return true

@borrows
fn csgTransactionMaterialSources(
        snapshots: csgTransactionSourceSnapshot[],
        changedSources: str[],
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        materialSources: var str[],
        localSources: var
            merkle_builder.CsgCoreMerkleBuilderSource[],
        error: var str): bool =
    for i in 0..<snapshots.len:
        let replacementIndex =
            csgTransactionReplacementIndex(
                replacements, snapshots[i].sourceId)
        if replacementIndex < 0:
            error =
                "merkle_transaction_replacement_missing"
            return false
        let replacement =
            replacements[replacementIndex]
        /* An explicitly changed source is always material: every apply
           commits a fresh generation of its artifacts even when the
           replacement content is byte-identical to the committed one
           (the restart/no-op-content transaction still earns a new
           head).  Only dependency-invalidated sources may be skipped
           on content equality. */
        if !csgTransactionContains(
               changedSources, snapshots[i].sourceId) &&
           snapshots[i].sourceCid ==
               replacement.sourceCid &&
           csgTransactionFactsEqual(
               snapshots[i].facts,
               replacement.facts):
            continue
        add(
            materialSources,
            strings.CloneStr(snapshots[i].sourceId))
        var source: merkle_builder.CsgCoreMerkleBuilderSource
        source.sourceId =
            strings.CloneStr(replacement.sourceId)
        source.sourceCid =
            strings.CloneStr(replacement.sourceCid)
        source.factsProvenCanonical = true
        for factIndex in 0..<replacement.facts.len:
            add(
                source.facts,
                strings.CloneStr(
                    replacement.facts[factIndex]))
        add(localSources, source)
    return true

@borrows
fn csgTransactionFactKey(
        fact: str,
        error: var str): str =
    var keyError: str
    let key =
        merkle_dag.CsgCoreMerkleFactKey(
            fact, keyError)
    if keyError.len > 0:
        error =
            csgTransactionCat(
                "merkle_transaction_fact_key ",
                keyError)
        return ""
    return key

@borrows
fn csgTransactionRequestFactsCanonicalError(
        replacements:
            CsgCoreMerkleTransactionReplacement[]): str =
    for replacementIndex in 0..<replacements.len:
        let replacement = replacements[replacementIndex]
        for factIndex in 0..<replacement.facts.len:
            let fact = replacement.facts[factIndex]
            var canonicalError: str
            let canonical =
                merkle_dag.CsgCoreMerkleCanonicalFact(
                    fact, canonicalError)
            if canonicalError.len > 0:
                return "merkle_transaction_request_fact_canonicalization_failed"
            if canonical != fact:
                return "merkle_transaction_request_fact_noncanonical"
    return ""

@borrows
fn csgTransactionRequestIdentity(
        expectedHeadCid: str,
        changedSources: str[],
        replacements:
            CsgCoreMerkleTransactionReplacement[]):
        merkle_transaction_request.CsgCoreMerkleTransactionRequestCidResult =
    let canonicalError =
        csgTransactionRequestFactsCanonicalError(
            replacements)
    if canonicalError.len > 0:
        var failed: merkle_transaction_request.CsgCoreMerkleTransactionRequestCidResult
        failed.error = strings.CloneStr(canonicalError)
        return failed
    var identity: merkle_transaction_request.CsgCoreMerkleTransactionRequest
    identity.expectedBeforeHeadCid =
        strings.CloneStr(expectedHeadCid)
    for i in 0..<changedSources.len:
        add(
            identity.changedSources,
            strings.CloneStr(changedSources[i]))
    for replacementIndex in 0..<replacements.len:
        let replacement = replacements[replacementIndex]
        var requestReplacement: merkle_transaction_request.CsgCoreMerkleTransactionRequestReplacement
        requestReplacement.sourceId =
            strings.CloneStr(replacement.sourceId)
        requestReplacement.sourceCid =
            strings.CloneStr(replacement.sourceCid)
        for factIndex in 0..<replacement.facts.len:
            let fact = replacement.facts[factIndex]
            var keyError: str
            let factKey =
                csgTransactionFactKey(fact, keyError)
            var hashError: str
            let factHash =
                merkle_dag.CsgCoreMerkleFactHash(
                    fact, hashError)
            if keyError.len > 0 ||
               hashError.len > 0:
                var failed: merkle_transaction_request.CsgCoreMerkleTransactionRequestCidResult
                failed.error =
                    "merkle_transaction_request_fact_canonicalization_failed"
                return failed
            var requestFact: merkle_transaction_request.CsgCoreMerkleTransactionRequestFact
            requestFact.factKey = strings.CloneStr(factKey)
            requestFact.factCid =
                csgTransactionCat(
                    "sha256:",
                    layout.FixedBytes32Hex(factHash))
            add(requestReplacement.facts, requestFact)
        for dependencyIndex in
                0..<replacement.dependencies.len:
            let dependency =
                replacement.dependencies[dependencyIndex]
            var requestDependency: merkle_transaction_request.CsgCoreMerkleTransactionRequestDependency
            requestDependency.providerSource =
                strings.CloneStr(dependency.providerSource)
            requestDependency.providerFactKind =
                strings.CloneStr(dependency.providerFactKind)
            requestDependency.selector =
                strings.CloneStr(dependency.selector)
            add(
                requestReplacement.dependencies,
                requestDependency)
        add(identity.replacements, requestReplacement)
    return merkle_transaction_request.CsgCoreMerkleTransactionRequestCid(
        identity)

@borrows
fn csgTransactionFactIndex(
        facts: str[],
        factKey: str,
        error: var str): int32 =
    var found: int32 = -1
    for i in 0..<facts.len:
        var keyErr = ""
        let key =
            csgTransactionFactKey(facts[i], keyErr)
        if keyErr.len > 0:
            error = keyErr
            return -2
        if key == factKey:
            if found >= 0:
                error =
                    "merkle_transaction_fact_key_duplicate"
                return -2
            found = i
    return found

# [phaseC-w5] Key precomputation for one fact list: each fact's key is
# computed exactly once (the per-compilation fact memo in merkle_dag makes
# repeats cheap), so the membership scans below compare precomputed keys
# instead of re-canonicalizing the whole list per comparison.
@borrows
fn csgTransactionFactKeysOf(
        facts: str[],
        keys: var str[],
        error: var str): bool =
    for i in 0..<facts.len:
        var keyErr = ""
        let key =
            csgTransactionFactKey(facts[i], keyErr)
        if keyErr.len > 0:
            error = keyErr
            return false
        add(keys, key)
    return true

@borrows
fn csgTransactionFactIndexKeys(
        keys: str[],
        factKey: str,
        error: var str): int32 =
    var found: int32 = -1
    for i in 0..<keys.len:
        if keys[i] == factKey:
            if found >= 0:
                error =
                    "merkle_transaction_fact_key_duplicate"
                return -2
            found = i
    return found

@borrows
fn csgTransactionOperationIdentity(
        operation: csgTransactionFactOperation):
        str =
    return csgTransactionCat(
        csgTransactionCat(
            strings.IntToStr(operation.kind), "|"),
        csgTransactionTuple(operation.factKey))

@borrows
fn csgTransactionBuildOperations(
        snapshots: csgTransactionSourceSnapshot[],
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        materialSources: str[],
        operations: var csgTransactionFactOperation[],
        error: var str): bool =
    var unsorted: csgTransactionFactOperation[]
    for sourceIndex in 0..<materialSources.len:
        let snapshotIndex =
            csgTransactionSourceIndex(
                snapshots,
                materialSources[sourceIndex])
        let replacementIndex =
            csgTransactionReplacementIndex(
                replacements,
                materialSources[sourceIndex])
        if snapshotIndex < 0 || replacementIndex < 0:
            error =
                "merkle_transaction_material_source_missing"
            return false
        let oldFacts = snapshots[snapshotIndex].facts
        let newFacts =
            replacements[replacementIndex].facts
        # [phaseC-w5] Precompute both key lists once per source pair; the
        # membership scans below used to re-canonicalize every compared fact
        # (O(oldN*newN) full JSON AST builds per source).
        var oldKeys: str[]
        if !csgTransactionFactKeysOf(oldFacts, oldKeys, error):
            return false
        var newKeys: str[]
        if !csgTransactionFactKeysOf(newFacts, newKeys, error):
            return false
        for oldIndex in 0..<oldFacts.len:
            let key = oldKeys[oldIndex]
            let newIndex =
                csgTransactionFactIndexKeys(
                    newKeys, key, error)
            if error.len > 0:
                return false
            var operation: csgTransactionFactOperation
            if newIndex < 0:
                operation.kind = CsgTransactionDelete
            elif oldFacts[oldIndex] != newFacts[newIndex]:
                operation.kind = CsgTransactionReplace
            if operation.kind != 0:
                operation.factKey = strings.CloneStr(key)
                add(unsorted, operation)
        for newIndex in 0..<newFacts.len:
            let key = newKeys[newIndex]
            let oldIndex =
                csgTransactionFactIndexKeys(
                    oldKeys, key, error)
            if error.len > 0:
                return false
            if oldIndex < 0:
                var operation: csgTransactionFactOperation
                operation.kind = CsgTransactionInsert
                operation.factKey = strings.CloneStr(key)
                add(unsorted, operation)
    var identities: str[]
    for i in 0..<unsorted.len:
        add(
            identities,
            csgTransactionOperationIdentity(
                unsorted[i]))
    let sorted =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            identities)
    for i in 0..<sorted.len:
        if i > 0 && sorted[i] == sorted[i - 1]:
            error =
                "merkle_transaction_operation_duplicate"
            return false
        var found: int32 = -1
        for candidate in 0..<unsorted.len:
            if identities[candidate] == sorted[i]:
                found = candidate
        if found < 0:
            error =
                "merkle_transaction_operation_order_invalid"
            return false
        var ordered: csgTransactionFactOperation
        ordered.kind = unsorted[found].kind
        ordered.factKey =
            strings.CloneStr(unsorted[found].factKey)
        add(operations, ordered)
    return true

@borrows
fn csgTransactionRequireSingleReplace(
        operations: csgTransactionFactOperation[],
        error: var str): bool =
    if operations.len == 0:
        error =
            "merkle_transaction_no_state_change"
        return false
    if operations.len != 1 ||
       operations[0].kind != CsgTransactionReplace ||
       operations[0].factKey.len == 0:
        error =
            "merkle_transaction_single_replace_required"
        return false
    return true

fn csgTransactionFreeOperationArtifact(
        artifact: var
            merkle_transaction_operation.CsgCoreMerkleTransactionOperationCodecResult) =
    rawbytes.BytesFree(artifact.bytes)
    rawbytes.BytesFree(artifact.proofBytes)
    artifact =
        merkle_transaction_operation.CsgCoreMerkleTransactionOperationCodecResult()

fn csgTransactionFreeApplyArtifacts(
        artifacts: var csgTransactionApplyArtifacts) =
    merkle_transaction_request.CsgCoreMerkleTransactionRequestCidFree(
        artifacts.requestArtifact)
    merkle_builder.CsgCoreMerkleBuilderLocalFree(
        artifacts.previousLocal)
    merkle_builder.CsgCoreMerkleBuilderLocalFree(
        artifacts.local)
    for i in 0..<artifacts.dependencyConsumerShards.len:
        rawbytes.BytesFree(
            artifacts.dependencyConsumerShards[i].bytes)
    for i in 0..<artifacts.dependencyProviderShards.len:
        rawbytes.BytesFree(
            artifacts.dependencyProviderShards[i].bytes)
    for i in 0..<artifacts.queryShards.len:
        rawbytes.BytesFree(
            artifacts.queryShards[i].bytes)
    rawbytes.BytesFree(artifacts.summary.bytes)
    artifacts = csgTransactionApplyArtifacts()

fn csgTransactionFailApply(
        error: str,
        artifacts: var csgTransactionApplyArtifacts):
        CsgCoreMerkleTransactionResult =
    var out: CsgCoreMerkleTransactionResult
    out.error = error
    csgTransactionFreeApplyArtifacts(artifacts)
    return out

@borrows
fn csgTransactionReplacementFact(
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        materialSources: str[],
        factKey: str,
        error: var str): str =
    var found: str
    var foundCount: int32
    for sourceIndex in 0..<materialSources.len:
        let replacementIndex =
            csgTransactionReplacementIndex(
                replacements,
                materialSources[sourceIndex])
        if replacementIndex < 0:
            error =
                "merkle_transaction_replacement_fact_source_missing"
            return ""
        let facts = replacements[replacementIndex].facts
        for factIndex in 0..<facts.len:
            var keyErr = ""
            let key =
                csgTransactionFactKey(
                    facts[factIndex], keyErr)
            if keyErr.len > 0:
                error = keyErr
                return ""
            if key == factKey:
                found = strings.CloneStr(facts[factIndex])
                foundCount = foundCount + 1
    if foundCount != 1:
        error =
            "merkle_transaction_replacement_fact_cardinality_invalid"
        return ""
    return found

@borrows
fn csgTransactionPreviousFact(
        snapshots: csgTransactionSourceSnapshot[],
        materialSources: str[],
        factKey: str,
        error: var str): str =
    var found: str
    var foundCount: int32
    for sourceIndex in 0..<materialSources.len:
        let snapshotIndex =
            csgTransactionSourceIndex(
                snapshots,
                materialSources[sourceIndex])
        if snapshotIndex < 0:
            error =
                "merkle_transaction_previous_fact_source_missing"
            return ""
        let facts = snapshots[snapshotIndex].facts
        for factIndex in 0..<facts.len:
            var keyErr = ""
            let key =
                csgTransactionFactKey(
                    facts[factIndex], keyErr)
            if keyErr.len > 0:
                error = keyErr
                return ""
            if key == factKey:
                found = strings.CloneStr(facts[factIndex])
                foundCount = foundCount + 1
    if foundCount != 1:
        error =
            "merkle_transaction_previous_fact_cardinality_invalid"
        return ""
    return found

@borrows
fn csgTransactionClonePartition(
        partition:
            merkle_manifest.CsgCoreMerklePartitionRecord):
        merkle_manifest.CsgCoreMerklePartitionRecord =
    var out: merkle_manifest.CsgCoreMerklePartitionRecord
    out.sourceId = strings.CloneStr(partition.sourceId)
    out.sourceCid = strings.CloneStr(partition.sourceCid)
    out.factKind = strings.CloneStr(partition.factKind)
    out.factsCid = strings.CloneStr(partition.factsCid)
    out.factsRoot = strings.CloneStr(partition.factsRoot)
    out.dagRootCid =
        strings.CloneStr(partition.dagRootCid)
    out.membershipCid =
        strings.CloneStr(partition.membershipCid)
    out.factCount = partition.factCount
    return out

@borrows
fn csgTransactionPartitionCompare(
        left:
            merkle_manifest.CsgCoreMerklePartitionRecord,
        right:
            merkle_manifest.CsgCoreMerklePartitionRecord):
        int32 =
    let sourceOrder =
        csgTransactionTextCompare(
            left.sourceId, right.sourceId)
    if sourceOrder != 0:
        return sourceOrder
    return csgTransactionTextCompare(
        left.factKind, right.factKind)

@borrows
fn csgTransactionSortPartitions(
        partitions:
            merkle_manifest.CsgCoreMerklePartitionRecord[]):
        merkle_manifest.CsgCoreMerklePartitionRecord[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, partitions.len)
    setLen(scratch, partitions.len)
    for i in 0..<partitions.len:
        order[i] = i
    var width: int32 = 1
    while width < order.len:
        var start: int32
        while start < order.len:
            var middle = start + width
            if middle > order.len:
                middle = order.len
            var finish = middle + width
            if finish > order.len:
                finish = order.len
            var left = start
            var right = middle
            for writeAt in start..<finish:
                if left < middle &&
                   (right >= finish ||
                    csgTransactionPartitionCompare(
                        partitions[order[left]],
                        partitions[order[right]]) <= 0):
                    scratch[writeAt] = order[left]
                    left = left + 1
                else:
                    scratch[writeAt] = order[right]
                    right = right + 1
            start = finish
        for i in 0..<order.len:
            order[i] = scratch[i]
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    var out: merkle_manifest.CsgCoreMerklePartitionRecord[]
    for i in 0..<order.len:
        add(
            out,
            csgTransactionClonePartition(
                partitions[order[i]]))
    return out

@borrows
fn csgTransactionMergePartitions(
        previous:
            merkle_manifest.CsgCoreMerklePartitionRecord[],
        materialSources: str[],
        local:
            merkle_manifest.CsgCoreMerklePartitionRecord[]):
        merkle_manifest.CsgCoreMerklePartitionRecord[] =
    var out: merkle_manifest.CsgCoreMerklePartitionRecord[]
    for i in 0..<previous.len:
        if !csgTransactionContains(
               materialSources, previous[i].sourceId):
            add(
                out,
                csgTransactionClonePartition(previous[i]))
    for i in 0..<local.len:
        add(out, csgTransactionClonePartition(local[i]))
    return csgTransactionSortPartitions(out)

@borrows
fn csgTransactionPreviousLocalSources(
        snapshots: csgTransactionSourceSnapshot[],
        materialSources: str[],
        out: var merkle_builder.CsgCoreMerkleBuilderSource[],
        error: var str): bool =
    for i in 0..<materialSources.len:
        let snapshotAt =
            csgTransactionSourceIndex(
                snapshots, materialSources[i])
        if snapshotAt < 0:
            error =
                "merkle_transaction_previous_local_source_missing"
            return false
        var source: merkle_builder.CsgCoreMerkleBuilderSource
        source.sourceId =
            strings.CloneStr(snapshots[snapshotAt].sourceId)
        source.sourceCid =
            strings.CloneStr(snapshots[snapshotAt].sourceCid)
        source.factsProvenCanonical = true
        for factIndex in 0..<snapshots[snapshotAt].facts.len:
            add(
                source.facts,
                strings.CloneStr(
                    snapshots[snapshotAt].facts[factIndex]))
        add(out, source)
    return true

@borrows
fn csgTransactionCloneDescriptor(
        descriptor:
            merkle_manifest.CsgCoreMerkleShardDescriptor):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(descriptor.shardKey)
    out.cid = strings.CloneStr(descriptor.cid)
    out.root = strings.CloneStr(descriptor.root)
    out.entryCount = descriptor.entryCount
    return out

@borrows
fn csgTransactionCloneDescriptors(
        descriptors:
            merkle_manifest.CsgCoreMerkleShardDescriptor[]):
        merkle_manifest.CsgCoreMerkleShardDescriptor[] =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor[]
    for i in 0..<descriptors.len:
        add(out, csgTransactionCloneDescriptor(descriptors[i]))
    return out

@borrows
fn csgTransactionDependencyDescriptor(
        shard:
            merkle_artifacts.CsgCoreMerkleDependencyShardResult):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(shard.header.shardKey)
    out.cid = strings.CloneStr(shard.cid)
    out.root = strings.CloneStr(shard.shardRoot)
    out.entryCount = shard.entryCount
    return out

@borrows
fn csgTransactionQueryDescriptor(
        shard:
            merkle_artifacts.CsgCoreMerkleQueryShardResult):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(shard.header.bucket)
    out.cid = strings.CloneStr(shard.cid)
    out.root = strings.CloneStr(shard.shardRoot)
    out.entryCount = shard.entryCount
    return out

@borrows
fn csgTransactionReplaceDescriptor(
        descriptors: var
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        descriptor:
            merkle_manifest.CsgCoreMerkleShardDescriptor,
        error: var str): bool =
    let at =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            descriptors, descriptor.shardKey)
    if at < 0:
        error =
            "merkle_transaction_shard_descriptor_missing"
        return false
    descriptors[at] =
        csgTransactionCloneDescriptor(descriptor)
    return true

/* Sorted upsert for sparse query manifests: replace the descriptor
   for shardKey when present, otherwise insert it at its sorted
   position (the descriptor index is a binary search, so the list
   must stay ordered by shardKey). */
fn csgTransactionUpsertDescriptor(
        descriptors: var
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        descriptor:
            merkle_manifest.CsgCoreMerkleShardDescriptor) =
    let existing =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            descriptors, descriptor.shardKey)
    if existing >= 0:
        descriptors[existing] =
            csgTransactionCloneDescriptor(descriptor)
        return
    var at: int32
    while at < descriptors.len &&
          csgManifestTextCompareLocal(
              descriptors[at].shardKey,
              descriptor.shardKey) < 0:
        at = at + 1
    var tail: merkle_manifest.CsgCoreMerkleShardDescriptor[]
    add(tail, csgTransactionCloneDescriptor(descriptor))
    for i in at..<descriptors.len:
        add(
            tail,
            csgTransactionCloneDescriptor(descriptors[i]))
    setLen(descriptors, at)
    for i in 0..<tail.len:
        add(
            descriptors,
            csgTransactionCloneDescriptor(tail[i]))

@borrows
fn csgTransactionRemoveDescriptorAt(
        descriptors: var
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        shardKey: str) =
    let at =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            descriptors, shardKey)
    if at < 0:
        return
    var kept: merkle_manifest.CsgCoreMerkleShardDescriptor[]
    for i in 0..<descriptors.len:
        if i != at:
            add(
                kept,
                csgTransactionCloneDescriptor(descriptors[i]))
    setLen(descriptors, 0)
    for i in 0..<kept.len:
        add(
            descriptors,
            csgTransactionCloneDescriptor(kept[i]))

@borrows
fn csgManifestTextCompareLocal(left: str, right: str): int32 =
    let shared = left.len < right.len ? left.len : right.len
    for i in 0..<shared:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn csgTransactionProviderRoot(
        partitions:
            merkle_manifest.CsgCoreMerklePartitionRecord[],
        sourceId: str,
        factKind: str,
        error: var str): str =
    var root: str
    var found: int32
    for i in 0..<partitions.len:
        if partitions[i].sourceId == sourceId &&
           partitions[i].factKind == factKind:
            root = strings.CloneStr(partitions[i].factsRoot)
            found = found + 1
    if found != 1:
        error =
            "merkle_transaction_provider_partition_cardinality_invalid"
        return ""
    return root

@borrows
fn csgTransactionBuildConsumerDependencies(
        replacements:
            CsgCoreMerkleTransactionReplacement[],
        invalidatedSources: str[],
        partitions:
            merkle_manifest.CsgCoreMerklePartitionRecord[],
        error: var str):
        merkle_artifacts.CsgCoreMerkleDependencyRecord[] =
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    for sourceIndex in 0..<invalidatedSources.len:
        let replacementIndex =
            csgTransactionReplacementIndex(
                replacements,
                invalidatedSources[sourceIndex])
        if replacementIndex < 0:
            error =
                "merkle_transaction_dependency_replacement_missing"
            return []
        let replacement = replacements[replacementIndex]
        for dependencyIndex in
                0..<replacement.dependencies.len:
            let dependency =
                replacement.dependencies[dependencyIndex]
            var stagedErr9 = ""
            let providerRoot =
                csgTransactionProviderRoot(
                    partitions,
                    dependency.providerSource,
                    dependency.providerFactKind,
                    stagedErr9)
            if stagedErr9.len > 0:
                error = stagedErr9
                return []
            var record: merkle_artifacts.CsgCoreMerkleDependencyRecord
            record.consumerSource =
                strings.CloneStr(replacement.sourceId)
            record.providerSource =
                strings.CloneStr(
                    dependency.providerSource)
            record.selector =
                strings.CloneStr(dependency.selector)
            record.providerSubgraphCid =
                strings.CloneStr(providerRoot)
            add(out, record)
    return out

@borrows
fn csgTransactionReadDependencyShard(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        descriptors:
            merkle_manifest.CsgCoreMerkleShardDescriptor[],
        projection: str,
        shardKey: str,
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str):
        merkle_artifacts.CsgCoreMerkleDependencyShardResult =
    let descriptorAt =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            descriptors, shardKey)
    if descriptorAt < 0:
        error =
            "merkle_transaction_dependency_shard_descriptor_missing"
        return merkle_artifacts.CsgCoreMerkleDependencyShardResult()
    let descriptor = descriptors[descriptorAt]
    var object =
        merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadObject(
            planning,
            merkle_store.CsgCoreMerkleStoreDependencyArtifactKind(),
            descriptor.cid)
    if !object.ok:
        error =
            csgTransactionCat(
                "merkle_transaction_dependency_shard_read ",
                object.error)
        return merkle_artifacts.CsgCoreMerkleDependencyShardResult()
    var shard =
        merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
            object.bytes)
    rawbytes.BytesFree(object.bytes)
    counters.dependencyObjectsDecoded =
        counters.dependencyObjectsDecoded + 1
    if !shard.ok ||
       shard.cid != descriptor.cid ||
       shard.shardRoot != descriptor.root ||
       shard.entryCount != descriptor.entryCount ||
       shard.header.profileSetCid != manifest.profileSetCid ||
       shard.header.projection != projection ||
       shard.header.shardKey != shardKey:
        rawbytes.BytesFree(shard.bytes)
        error =
            "merkle_transaction_dependency_shard_projection_mismatch"
        return merkle_artifacts.CsgCoreMerkleDependencyShardResult()
    return shard

@borrows
fn csgTransactionReadQueryShard(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        bucket: str,
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str):
        merkle_artifacts.CsgCoreMerkleQueryShardResult =
    let descriptorAt =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            manifest.queryShards, bucket)
    if descriptorAt < 0:
        /* Sparse manifests omit empty buckets: an absent descriptor
           is the canonical empty shard for that bucket, not a
           missing-object error. */
        var emptyShard: merkle_artifacts.CsgCoreMerkleQueryShardResult
        emptyShard.ok = true
        emptyShard.header.profileSetCid =
            strings.CloneStr(manifest.profileSetCid)
        emptyShard.header.bucket = strings.CloneStr(bucket)
        return emptyShard
    let descriptor = manifest.queryShards[descriptorAt]
    var object =
        merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadObject(
            planning,
            merkle_store.CsgCoreMerkleStoreIndexArtifactKind(),
            descriptor.cid)
    if !object.ok:
        error =
            csgTransactionCat(
                "merkle_transaction_query_shard_read ",
                object.error)
        return merkle_artifacts.CsgCoreMerkleQueryShardResult()
    var shard =
        merkle_artifacts.CsgCoreMerkleQueryShardDecode(
            object.bytes)
    rawbytes.BytesFree(object.bytes)
    counters.queryShardObjectsDecoded =
        counters.queryShardObjectsDecoded + 1
    if !shard.ok ||
       shard.cid != descriptor.cid ||
       shard.shardRoot != descriptor.root ||
       shard.entryCount != descriptor.entryCount ||
       shard.header.profileSetCid != manifest.profileSetCid ||
       shard.header.bucket != bucket:
        rawbytes.BytesFree(shard.bytes)
        error =
            "merkle_transaction_query_shard_projection_mismatch"
        return merkle_artifacts.CsgCoreMerkleQueryShardResult()
    return shard

@borrows
fn csgTransactionTouchedProviderSources(
        previous:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        next:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[]):
        str[] =
    var values: str[]
    for i in 0..<previous.len:
        add(
            values,
            strings.CloneStr(previous[i].providerSource))
    for i in 0..<next.len:
        add(
            values,
            strings.CloneStr(next[i].providerSource))
    let sorted =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            values)
    var out: str[]
    for i in 0..<sorted.len:
        if i == 0 || sorted[i] != sorted[i - 1]:
            add(out, strings.CloneStr(sorted[i]))
    return out

@borrows
fn csgTransactionTouchedQueryBuckets(
        previous:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        next:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]):
        str[] =
    var values: str[]
    for i in 0..<previous.len:
        add(
            values,
            merkle_artifacts.CsgCoreMerkleQueryBucket(
                previous[i].indexKind,
                previous[i].term))
    for i in 0..<next.len:
        add(
            values,
            merkle_artifacts.CsgCoreMerkleQueryBucket(
                next[i].indexKind,
                next[i].term))
    let sorted =
        merkle_invalidation.CsgCoreMerkleInvalidationSorted(
            values)
    var out: str[]
    for i in 0..<sorted.len:
        if sorted[i].len == 0:
            var empty: str[]
            return empty
        if i == 0 || sorted[i] != sorted[i - 1]:
            add(out, strings.CloneStr(sorted[i]))
    return out

@borrows
fn csgTransactionReadConsumerDependencies(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        invalidatedSources: str[],
        out: var
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    for i in 0..<invalidatedSources.len:
        var stagedErr8 = ""
        var shard =
            csgTransactionReadDependencyShard(
                planning,
                manifest,
                manifest.dependencyConsumerShards,
                merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection(),
                invalidatedSources[i],
                counters,
                stagedErr8)
        if stagedErr8.len > 0:
            error = stagedErr8
            return false
        for recordIndex in 0..<shard.records.len:
            add(
                out,
                csgTransactionCloneDependency(
                    shard.records[recordIndex]))
        rawbytes.BytesFree(shard.bytes)
    return true

@borrows
fn csgTransactionRebuildDependencyShards(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        previous:
            merkle_manifest.CsgCoreMerkleManifest,
        next: var
            merkle_manifest.CsgCoreMerkleManifest,
        invalidatedSources: str[],
        previousDependencies:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        nextDependencies:
            merkle_artifacts.CsgCoreMerkleDependencyRecord[],
        artifacts: var csgTransactionApplyArtifacts,
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    next.dependencyConsumerShards =
        csgTransactionCloneDescriptors(
            previous.dependencyConsumerShards)
    next.dependencyProviderShards =
        csgTransactionCloneDescriptors(
            previous.dependencyProviderShards)
    for sourceIndex in 0..<invalidatedSources.len:
        var records: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
        for recordIndex in 0..<nextDependencies.len:
            if nextDependencies[recordIndex].consumerSource ==
               invalidatedSources[sourceIndex]:
                add(
                    records,
                    csgTransactionCloneDependency(
                        nextDependencies[recordIndex]))
        let sorted =
            csgTransactionSortDependencies(records)
        var header: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
        header.profileSetCid =
            strings.CloneStr(next.profileSetCid)
        header.projection =
            merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection()
        header.shardKey = strings.CloneStr(invalidatedSources[sourceIndex])
        var shard =
            merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                header, sorted)
        if !shard.ok:
            error =
                csgTransactionCat(
                    "merkle_transaction_consumer_shard_encode ",
                    shard.error)
            return false
        let descriptor =
            csgTransactionDependencyDescriptor(shard)
        if !csgTransactionReplaceDescriptor(
               next.dependencyConsumerShards,
               descriptor,
               error):
            rawbytes.BytesFree(shard.bytes)
            return false
        add(artifacts.dependencyConsumerShards, shard)

    let profileChanged =
        !validator.CsgCoreProfilesEqual(
            previous.profiles, next.profiles) ||
        previous.profileSetCid != next.profileSetCid
    if profileChanged:
        for descriptorIndex in
                0..<previous.dependencyConsumerShards.len:
            let sourceId =
                previous.dependencyConsumerShards[
                    descriptorIndex].shardKey
            if csgTransactionContains(
                   invalidatedSources, sourceId):
                continue
            var stagedErr7 = ""
            var previousShard =
                csgTransactionReadDependencyShard(
                    planning,
                    previous,
                    previous.dependencyConsumerShards,
                    merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection(),
                    sourceId,
                    counters,
                    stagedErr7)
            if stagedErr7.len > 0:
                error = stagedErr7
                return false
            var header: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
            header.profileSetCid =
                strings.CloneStr(next.profileSetCid)
            header.projection =
                merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection()
            header.shardKey = strings.CloneStr(sourceId)
            var rebound =
                merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                    header, previousShard.records)
            rawbytes.BytesFree(previousShard.bytes)
            if !rebound.ok:
                error =
                    "merkle_transaction_consumer_profile_rebind_failed"
                return false
            let descriptor =
                csgTransactionDependencyDescriptor(rebound)
            if !csgTransactionReplaceDescriptor(
                   next.dependencyConsumerShards,
                   descriptor,
                   error):
                rawbytes.BytesFree(rebound.bytes)
                return false
            add(artifacts.dependencyConsumerShards, rebound)

    artifacts.touchedProviderSources =
        csgTransactionTouchedProviderSources(
            previousDependencies,
            nextDependencies)
    for sourceIndex in
            0..<artifacts.touchedProviderSources.len:
        var stagedErr6 = ""
        var previousShard =
            csgTransactionReadDependencyShard(
                planning,
                previous,
                previous.dependencyProviderShards,
                merkle_artifacts.CsgCoreMerkleDependencyProviderProjection(),
                artifacts.touchedProviderSources[sourceIndex],
                counters,
                stagedErr6)
        if stagedErr6.len > 0:
            error = stagedErr6
            return false
        var removed: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
        var records: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
        for recordIndex in 0..<previousShard.records.len:
            if csgTransactionContains(
                   invalidatedSources,
                   previousShard.records[
                       recordIndex].consumerSource):
                add(
                    removed,
                    csgTransactionCloneDependency(
                        previousShard.records[recordIndex]))
            else:
                add(
                    records,
                    csgTransactionCloneDependency(
                        previousShard.records[recordIndex]))
        rawbytes.BytesFree(previousShard.bytes)
        var expectedRemoved: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
        for recordIndex in 0..<previousDependencies.len:
            if previousDependencies[recordIndex].providerSource ==
               artifacts.touchedProviderSources[sourceIndex]:
                add(
                    expectedRemoved,
                    csgTransactionCloneDependency(
                        previousDependencies[recordIndex]))
        if !csgTransactionDependenciesExact(
               removed, expectedRemoved):
            error =
                "merkle_transaction_provider_projection_old_edge_mismatch"
            return false
        for recordIndex in 0..<nextDependencies.len:
            if nextDependencies[recordIndex].providerSource ==
               artifacts.touchedProviderSources[sourceIndex]:
                add(
                    records,
                    csgTransactionCloneDependency(
                        nextDependencies[recordIndex]))
        let sorted =
            csgTransactionSortDependencies(records)
        var header: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
        header.profileSetCid =
            strings.CloneStr(next.profileSetCid)
        header.projection =
            merkle_artifacts.CsgCoreMerkleDependencyProviderProjection()
        header.shardKey =
            strings.CloneStr(artifacts.touchedProviderSources[sourceIndex])
        var shard =
            merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                header, sorted)
        if !shard.ok:
            error =
                csgTransactionCat(
                    "merkle_transaction_provider_shard_encode ",
                    shard.error)
            return false
        let descriptor =
            csgTransactionDependencyDescriptor(shard)
        if !csgTransactionReplaceDescriptor(
               next.dependencyProviderShards,
               descriptor,
               error):
            rawbytes.BytesFree(shard.bytes)
            return false
        add(artifacts.dependencyProviderShards, shard)
    if profileChanged:
        for descriptorIndex in
                0..<previous.dependencyProviderShards.len:
            let providerSource =
                previous.dependencyProviderShards[
                    descriptorIndex].shardKey
            if csgTransactionContains(
                   artifacts.touchedProviderSources,
                   providerSource):
                continue
            var stagedErr5 = ""
            var previousShard =
                csgTransactionReadDependencyShard(
                    planning,
                    previous,
                    previous.dependencyProviderShards,
                    merkle_artifacts.CsgCoreMerkleDependencyProviderProjection(),
                    providerSource,
                    counters,
                    stagedErr5)
            if stagedErr5.len > 0:
                error = stagedErr5
                return false
            var header: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
            header.profileSetCid =
                strings.CloneStr(next.profileSetCid)
            header.projection =
                merkle_artifacts.CsgCoreMerkleDependencyProviderProjection()
            header.shardKey = strings.CloneStr(providerSource)
            var rebound =
                merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                    header, previousShard.records)
            rawbytes.BytesFree(previousShard.bytes)
            if !rebound.ok:
                error =
                    "merkle_transaction_provider_profile_rebind_failed"
                return false
            let descriptor =
                csgTransactionDependencyDescriptor(rebound)
            if !csgTransactionReplaceDescriptor(
                   next.dependencyProviderShards,
                   descriptor,
                   error):
                rawbytes.BytesFree(rebound.bytes)
                return false
            add(artifacts.dependencyProviderShards, rebound)
    if previous.dependencyCount <
       previousDependencies.len:
        error =
            "merkle_transaction_dependency_count_underflow"
        return false
    next.dependencyCount =
        previous.dependencyCount -
        previousDependencies.len +
        nextDependencies.len
    next.dependencyConsumerRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
            next.dependencyConsumerShards)
    next.dependencyProviderRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyProviderShardKind(),
            next.dependencyProviderShards)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           next.dependencyConsumerRoot) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           next.dependencyProviderRoot):
        error =
            "merkle_transaction_dependency_descriptor_root_invalid"
        return false
    return true

@borrows
fn csgTransactionRebuildQueryShards(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        previous:
            merkle_manifest.CsgCoreMerkleManifest,
        next: var
            merkle_manifest.CsgCoreMerkleManifest,
        materialSources: str[],
        previousQueries:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        nextQueries:
            merkle_artifacts.CsgCoreMerkleQueryIndexRecord[],
        touchedQueryBuckets: var str[],
        queryShards: var
            merkle_artifacts.CsgCoreMerkleQueryShardResult[],
        counters: var CsgCoreMerkleTransactionCounters,
        error: var str): bool =
    next.queryShards =
        csgTransactionCloneDescriptors(previous.queryShards)
    touchedQueryBuckets =
        csgTransactionTouchedQueryBuckets(
            previousQueries, nextQueries)
    if (previousQueries.len > 0 ||
        nextQueries.len > 0) &&
       touchedQueryBuckets.len == 0:
        error =
            "merkle_transaction_query_bucket_derivation_failed"
        return false
    for bucketIndex in
            0..<touchedQueryBuckets.len:
        let bucket =
            touchedQueryBuckets[bucketIndex]
        var stagedErr4 = ""
        var previousShard =
            csgTransactionReadQueryShard(
                planning,
                previous,
                bucket,
                counters,
                stagedErr4)
        if stagedErr4.len > 0:
            error = stagedErr4
            return false
        var removed: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
        var records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
        for recordIndex in 0..<previousShard.records.len:
            if csgTransactionContains(
                   materialSources,
                   previousShard.records[recordIndex].sourceId):
                add(
                    removed,
                    csgTransactionCloneQuery(
                        previousShard.records[recordIndex]))
            else:
                add(
                    records,
                    csgTransactionCloneQuery(
                        previousShard.records[recordIndex]))
        rawbytes.BytesFree(previousShard.bytes)
        var expectedRemoved: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
        for recordIndex in 0..<previousQueries.len:
            if merkle_artifacts.CsgCoreMerkleQueryBucket(
                   previousQueries[recordIndex].indexKind,
                   previousQueries[recordIndex].term) == bucket:
                add(
                    expectedRemoved,
                    csgTransactionCloneQuery(
                        previousQueries[recordIndex]))
        if !csgTransactionQueriesExact(
               removed, expectedRemoved):
            error =
                "merkle_transaction_query_old_projection_mismatch"
            return false
        for recordIndex in 0..<nextQueries.len:
            if merkle_artifacts.CsgCoreMerkleQueryBucket(
                   nextQueries[recordIndex].indexKind,
                   nextQueries[recordIndex].term) == bucket:
                add(
                    records,
                    csgTransactionCloneQuery(
                        nextQueries[recordIndex]))
        let sorted = csgTransactionSortQueries(records)
        if sorted.len == 0:
            /* Sparse manifests: a bucket whose last record leaves
               drops its descriptor; no shard object is written. */
            csgTransactionRemoveDescriptorAt(
                next.queryShards, bucket)
            continue
        var header: merkle_artifacts.CsgCoreMerkleQueryShardHeader
        header.profileSetCid =
            strings.CloneStr(next.profileSetCid)
        header.bucket = strings.CloneStr(bucket)
        let shard =
            merkle_artifacts.CsgCoreMerkleQueryShardEncode(
                header, sorted)
        if !shard.ok:
            error =
                csgTransactionCat(
                    "merkle_transaction_query_shard_encode ",
                    shard.error)
            return false
        let descriptor =
            csgTransactionQueryDescriptor(shard)
        csgTransactionUpsertDescriptor(
            next.queryShards, descriptor)
        add(queryShards, shard)
    if !validator.CsgCoreProfilesEqual(
           previous.profiles, next.profiles) ||
       previous.profileSetCid != next.profileSetCid:
        for descriptorIndex in 0..<previous.queryShards.len:
            let bucket =
                previous.queryShards[descriptorIndex].shardKey
            if csgTransactionContains(
                   touchedQueryBuckets, bucket):
                continue
            var stagedErr3 = ""
            var previousShard =
                csgTransactionReadQueryShard(
                    planning,
                    previous,
                    bucket,
                    counters,
                    stagedErr3)
            if stagedErr3.len > 0:
                error = stagedErr3
                return false
            var header: merkle_artifacts.CsgCoreMerkleQueryShardHeader
            header.profileSetCid =
                strings.CloneStr(next.profileSetCid)
            header.bucket = strings.CloneStr(bucket)
            let rebound =
                merkle_artifacts.CsgCoreMerkleQueryShardEncode(
                    header, previousShard.records)
            rawbytes.BytesFree(previousShard.bytes)
            if !rebound.ok:
                error =
                    "merkle_transaction_query_profile_rebind_failed"
                return false
            let descriptor =
                csgTransactionQueryDescriptor(rebound)
            csgTransactionUpsertDescriptor(
                next.queryShards, descriptor)
            add(queryShards, rebound)
    if previous.queryIndexCount < previousQueries.len:
        error =
            "merkle_transaction_query_count_underflow"
        return false
    next.queryIndexCount =
        previous.queryIndexCount -
        previousQueries.len +
        nextQueries.len
    next.queryShardRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            next.queryShards)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           next.queryShardRoot):
        error =
            "merkle_transaction_query_descriptor_root_invalid"
        return false
    return true

@borrows
fn csgTransactionSummary(
        manifest:
            merkle_manifest.CsgCoreMerkleManifest,
        queryIndexCount: int32):
        merkle_artifacts.CsgCoreMerkleSummaryResult =
    var header: merkle_artifacts.CsgCoreMerkleSummaryHeader
    header.standard = strings.CloneStr(manifest.standard)
    header.profiles =
        validator.CsgCoreProfilesClone(
            manifest.profiles)
    header.profileSetCid =
        strings.CloneStr(manifest.profileSetCid)
    header.complete = manifest.complete
    header.schemaCid = strings.CloneStr(manifest.schemaCid)
    header.factsRoot = strings.CloneStr(manifest.factsRoot)
    header.dagRootCid =
        strings.CloneStr(manifest.dagRootCid)
    header.factCount = manifest.factCount
    header.nodeCount = manifest.nodeCount
    header.partitionRoot =
        strings.CloneStr(manifest.partitionRoot)
    header.partitionCount = manifest.partitions.len
    header.dependencyConsumerRoot =
        strings.CloneStr(
            manifest.dependencyConsumerRoot)
    header.dependencyProviderRoot =
        strings.CloneStr(
            manifest.dependencyProviderRoot)
    header.dependencyCount = manifest.dependencyCount
    header.dependencyConsumerShardCount =
        manifest.dependencyConsumerShards.len
    header.dependencyProviderShardCount =
        manifest.dependencyProviderShards.len
    header.queryShardRoot =
        strings.CloneStr(manifest.queryShardRoot)
    header.queryIndexCount = queryIndexCount
    header.queryShardCount = manifest.queryShards.len
    return merkle_artifacts.CsgCoreMerkleSummaryEncode(
        header)

@borrows
fn csgTransactionSemanticSkeleton(
        manifest: merkle_manifest.CsgCoreMerkleManifest):
        merkle_manifest.CsgCoreMerkleSemanticManifestSkeleton =
    var out: merkle_manifest.CsgCoreMerkleSemanticManifestSkeleton
    out.standard = strings.CloneStr(manifest.standard)
    out.profiles = validator.CsgCoreProfilesClone(manifest.profiles)
    out.profileSetCid = strings.CloneStr(manifest.profileSetCid)
    out.complete = manifest.complete
    out.schemaCid = strings.CloneStr(manifest.schemaCid)
    out.factsRoot = strings.CloneStr(manifest.factsRoot)
    out.dagRootCid = strings.CloneStr(manifest.dagRootCid)
    out.factCount = manifest.factCount
    out.nodeCount = manifest.nodeCount
    for i in 0..<manifest.partitions.len:
        add(
            out.partitions,
            merkle_manifest.CsgCoreMerklePartitionClone(
                manifest.partitions[i]))
    out.partitionRoot = strings.CloneStr(manifest.partitionRoot)
    out.dependencyConsumerShards =
        csgTransactionCloneDescriptors(
            manifest.dependencyConsumerShards)
    out.dependencyConsumerRoot =
        strings.CloneStr(manifest.dependencyConsumerRoot)
    out.dependencyProviderShards =
        csgTransactionCloneDescriptors(
            manifest.dependencyProviderShards)
    out.dependencyProviderRoot =
        strings.CloneStr(manifest.dependencyProviderRoot)
    out.dependencyCount = manifest.dependencyCount
    out.queryShards =
        csgTransactionCloneDescriptors(manifest.queryShards)
    out.queryShardRoot = strings.CloneStr(manifest.queryShardRoot)
    out.queryIndexCount = manifest.queryIndexCount
    out.summaryCid = strings.CloneStr(manifest.summaryCid)
    out.unsupportedCount = manifest.unsupportedCount
    out.tombstoneCount = manifest.tombstoneCount
    out.runtimeRequirementCount = manifest.runtimeRequirementCount
    return out

@borrows
fn csgTransactionCloneBytes(
        source: rawbytes.Bytes): rawbytes.Bytes =
    let byteCount = rawbytes.BytesLen(source)
    var out = rawbytes.BytesAlloc(byteCount)
    if rawbytes.BytesLen(out) != byteCount:
        rawbytes.BytesFree(out)
        return rawbytes.Bytes()
    rawbytes.BytesCopyInto(out, 0, source)
    return out

@borrows
fn csgTransactionMakeBaseArtifact(
        kind: int32,
        cid: str,
        bytes: rawbytes.Bytes):
        csgTransactionBaseArtifactMade =
    var out: csgTransactionBaseArtifactMade
    var cloned = csgTransactionCloneBytes(bytes)
    if rawbytes.BytesLen(cloned) != rawbytes.BytesLen(bytes) ||
       rawbytes.BytesLen(cloned) <= 0:
        rawbytes.BytesFree(cloned)
        return out
    var artifact: merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput
    artifact.kind = kind
    artifact.cid = strings.CloneStr(cid)
    artifact.bytes = cloned
    out.ok = true
    out.artifact = artifact
    return out

@borrows
fn csgTransactionReadBaseArtifact(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        kind: int32,
        cid: str):
        csgTransactionBaseArtifactMade =
    var out: csgTransactionBaseArtifactMade
    var read =
        merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotReadObject(
            planning, kind, cid)
    if !read.ok:
        rawbytes.BytesFree(read.bytes)
        return out
    var artifact: merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput
    artifact.kind = kind
    artifact.cid = strings.CloneStr(cid)
    artifact.bytes = read.bytes
    read.bytes = rawbytes.Bytes()
    out.ok = true
    out.artifact = artifact
    return out

fn csgTransactionFreeBaseArtifacts(
        artifacts: var
            merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput[]) =
    for i in 0..<artifacts.len:
        rawbytes.BytesFree(artifacts[i].bytes)
    artifacts = []

fn csgTransactionAdoptBaseArtifact(
        made: var csgTransactionBaseArtifactMade):
        merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput =
    var artifact: merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput
    artifact.kind = made.artifact.kind
    artifact.cid = strings.CloneStr(made.artifact.cid)
    artifact.bytes = rawbytes.BytesTake(made.artifact.bytes)
    made.ok = false
    made.artifact =
        merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput()
    return artifact

@borrows
fn csgTransactionBuildBaseArtifacts(
        planning:
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority,
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        built: csgTransactionApplyArtifacts,
        out: var
            merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput[],
        error: var str): bool =
    if built.local.partitions.len != built.local.memberships.len:
        error = "merkle_transaction_local_artifact_shape_invalid"
        return false
    for i in 0..<manifest.partitions.len:
        var factsFound: bool
        var membershipFound: bool
        for j in 0..<built.local.partitions.len:
            if built.local.partitions[j].cid ==
               manifest.partitions[i].factsCid:
                factsFound = true
                var factsMade = csgTransactionMakeBaseArtifact(
                    merkle_store.CsgCoreMerkleStorePartitionArtifactKind(),
                    manifest.partitions[i].factsCid,
                    built.local.partitions[j].bytes)
                if !factsMade.ok:
                    error = "merkle_transaction_partition_artifact_clone_failed"
                    return false
                add(out, csgTransactionAdoptBaseArtifact(factsMade))
            if built.local.memberships[j].cid ==
               manifest.partitions[i].membershipCid:
                membershipFound = true
                var membershipMade = csgTransactionMakeBaseArtifact(
                    merkle_store.CsgCoreMerkleStoreMembershipArtifactKind(),
                    manifest.partitions[i].membershipCid,
                    built.local.memberships[j].bytes)
                if !membershipMade.ok:
                    error = "merkle_transaction_membership_artifact_clone_failed"
                    return false
                add(out, csgTransactionAdoptBaseArtifact(membershipMade))
        if !factsFound:
            var factsRead = csgTransactionReadBaseArtifact(
                planning,
                merkle_store.CsgCoreMerkleStorePartitionArtifactKind(),
                manifest.partitions[i].factsCid)
            if !factsRead.ok:
                error = "merkle_transaction_partition_artifact_read_failed"
                return false
            add(out, csgTransactionAdoptBaseArtifact(factsRead))
        if !membershipFound:
            var membershipRead = csgTransactionReadBaseArtifact(
                planning,
                merkle_store.CsgCoreMerkleStoreMembershipArtifactKind(),
                manifest.partitions[i].membershipCid)
            if !membershipRead.ok:
                error = "merkle_transaction_membership_artifact_read_failed"
                return false
            add(out, csgTransactionAdoptBaseArtifact(membershipRead))
    for i in 0..<manifest.dependencyConsumerShards.len:
        let descriptor = manifest.dependencyConsumerShards[i]
        var found: bool
        for j in 0..<built.dependencyConsumerShards.len:
            if built.dependencyConsumerShards[j].cid == descriptor.cid:
                found = true
                var made = csgTransactionMakeBaseArtifact(
                    merkle_store.CsgCoreMerkleStoreDependencyArtifactKind(),
                    descriptor.cid,
                    built.dependencyConsumerShards[j].bytes)
                if !made.ok:
                    error = "merkle_transaction_dependency_artifact_clone_failed"
                    return false
                add(out, csgTransactionAdoptBaseArtifact(made))
        if !found:
            var stored = csgTransactionReadBaseArtifact(
                planning,
                merkle_store.CsgCoreMerkleStoreDependencyArtifactKind(),
                descriptor.cid)
            if !stored.ok:
                error = "merkle_transaction_dependency_artifact_read_failed"
                return false
            add(out, csgTransactionAdoptBaseArtifact(stored))
    for i in 0..<manifest.dependencyProviderShards.len:
        let descriptor = manifest.dependencyProviderShards[i]
        var found: bool
        for j in 0..<built.dependencyProviderShards.len:
            if built.dependencyProviderShards[j].cid == descriptor.cid:
                found = true
                var made = csgTransactionMakeBaseArtifact(
                    merkle_store.CsgCoreMerkleStoreDependencyArtifactKind(),
                    descriptor.cid,
                    built.dependencyProviderShards[j].bytes)
                if !made.ok:
                    error = "merkle_transaction_dependency_artifact_clone_failed"
                    return false
                add(out, csgTransactionAdoptBaseArtifact(made))
        if !found:
            var stored = csgTransactionReadBaseArtifact(
                planning,
                merkle_store.CsgCoreMerkleStoreDependencyArtifactKind(),
                descriptor.cid)
            if !stored.ok:
                error = "merkle_transaction_dependency_artifact_read_failed"
                return false
            add(out, csgTransactionAdoptBaseArtifact(stored))
    for i in 0..<manifest.queryShards.len:
        let descriptor = manifest.queryShards[i]
        var found: bool
        for j in 0..<built.queryShards.len:
            if built.queryShards[j].cid == descriptor.cid:
                found = true
                var made = csgTransactionMakeBaseArtifact(
                    merkle_store.CsgCoreMerkleStoreIndexArtifactKind(),
                    descriptor.cid,
                    built.queryShards[j].bytes)
                if !made.ok:
                    error = "merkle_transaction_query_artifact_clone_failed"
                    return false
                add(out, csgTransactionAdoptBaseArtifact(made))
        if !found:
            var stored = csgTransactionReadBaseArtifact(
                planning,
                merkle_store.CsgCoreMerkleStoreIndexArtifactKind(),
                descriptor.cid)
            if !stored.ok:
                error = "merkle_transaction_query_artifact_read_failed"
                return false
            add(out, csgTransactionAdoptBaseArtifact(stored))
    if !built.summary.ok || built.summary.cid != manifest.summaryCid:
        error = "merkle_transaction_summary_artifact_invalid"
        return false
    var summaryMade = csgTransactionMakeBaseArtifact(
        merkle_store.CsgCoreMerkleStoreSummaryArtifactKind(),
        manifest.summaryCid,
        built.summary.bytes)
    if !summaryMade.ok:
        error = "merkle_transaction_summary_artifact_invalid"
        return false
    add(out, csgTransactionAdoptBaseArtifact(summaryMade))
    return true

@borrows
fn CsgCoreMerkleTransactionPlanStore(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        changedSources: str[],
        replacements:
            CsgCoreMerkleTransactionReplacement[]):
        CsgCoreMerkleTransactionResult =
    return csgTransactionBuildPreparedStore(
        parentPath,
        storeName,
        expectedHeadCid,
        changedSources,
        replacements)
fn csgTransactionPoisonSealedIssue(
        issue:
            var merkle_admission.CsgCoreMerkleSealedBeforeIssueResult) =
    if !issue.ok || issue.live.ownerId <= 0:
        issue =
            merkle_admission.CsgCoreMerkleSealedBeforeIssueResult()
        return
    var live = issue.live
    issue.live = merkle_admission.CsgCoreMerkleSealedBeforeLiveToken()
    let terminal =
        merkle_admission.CsgCoreMerkleSealedBeforeLivePoison(live)
    if !terminal.ok || !terminal.terminal:
        panic("merkle transaction: sealed issue cleanup failed")
    issue = merkle_admission.CsgCoreMerkleSealedBeforeIssueResult()

fn csgTransactionClosePlanning(
        planning:
            var merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority) =
    if planning.ownerId <= 0:
        return
    let closeError =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityClose(
            planning)
    if closeError.len > 0:
        panic("merkle transaction: planning path cleanup failed")

fn csgTransactionPoisonSnapshot(
        snapshot:
            var merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority) =
    if snapshot.ownerId <= 0:
        return
    let poisonError =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPoison(
            snapshot)
    if poisonError.len > 0:
        panic("merkle transaction: before snapshot cleanup failed")

@borrows
fn csgTransactionBuildPreparedStore(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        changedSources: str[],
        replacements:
            CsgCoreMerkleTransactionReplacement[]):
        CsgCoreMerkleTransactionResult =
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           expectedHeadCid):
        return csgTransactionFail(
            "merkle_transaction_expected_head_invalid")
    var artifacts: csgTransactionApplyArtifacts
    artifacts.requestArtifact =
        csgTransactionRequestIdentity(
            expectedHeadCid,
            changedSources,
            replacements)
    if !artifacts.requestArtifact.ok:
        return csgTransactionFailApply(
            strings.CloneStr(artifacts.requestArtifact.error),
            artifacts)
    let requestCid =
        strings.CloneStr(artifacts.requestArtifact.requestCid)
    var planningAuthority: merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority
    var snapshotAuthority: merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority
    var headLease: merkle_store.CsgCoreMerkleStoreCurrentHeadLease
    defer:
        csgTransactionPoisonSnapshot(snapshotAuthority)
        csgTransactionClosePlanning(planningAuthority)
        if headLease.leaseId > 0:
            merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(
                headLease)
    # Publisher gate (domain C): take the exclusive current-HEAD lease before
    # the expected-HEAD read so no concurrent publisher can advance HEAD
    # between this read and the commit.  Acquire failure is HARD_RED; the
    # check is never skipped.  The captured head is NOT compared against
    # expectedHeadCid here: an idempotent retry of an already-published
    # request legitimately sees an advanced head and is answered by the
    # reused-request lookup below; the fence consistency check after the
    # snapshot read is the comparison point.
    var headLeaseError: str
    if !merkle_store.CsgCoreMerkleStoreAcquireCurrentHeadExclusiveLease(
           parentPath, storeName, headLease, headLeaseError):
        return csgTransactionFailApply(
            strings.CloneStr(headLeaseError), artifacts)
    var opened =
        merkle_store_identity.CsgCoreMerkleStoreAcquirePathAuthority(
            parentPath,
            storeName,
            merkle_store_identity.CsgCoreMerkleStoreExistingOnly)
    if !opened.ok:
        return csgTransactionFailApply(
            strings.CloneStr(opened.error), artifacts)
    var pathAuthority = opened.authority
    opened.authority =
        merkle_store_identity.CsgCoreMerkleStorePathAuthority()
    var planningMove =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityMoveToPlanning(
            pathAuthority)
    if !planningMove.ok:
        return csgTransactionFailApply(
            strings.CloneStr(planningMove.error), artifacts)
    planningAuthority = planningMove.authority
    planningMove.authority =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority()
    let planningIdentityReceipt = planningMove.identityReceipt
    var snapshotIssue =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIssueBeforeSnapshot(
            planningAuthority)
    if !snapshotIssue.ok:
        return csgTransactionFailApply(
            strings.CloneStr(snapshotIssue.error), artifacts)
    snapshotAuthority = snapshotIssue.authority
    snapshotIssue.authority =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
    var snapshotClaim =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotClaim(
            snapshotAuthority)
    if !snapshotClaim.ok:
        return csgTransactionFailApply(
            strings.CloneStr(snapshotClaim.error), artifacts)
    snapshotAuthority = snapshotClaim.authority
    snapshotClaim.authority =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
    let current =
        merkle_store_snapshot_reader.CsgCoreMerkleStoreSnapshotFindRequest(
        planningAuthority,
        snapshotAuthority,
        expectedHeadCid,
        requestCid)
    if !current.ok:
        return csgTransactionFailApply(
            csgTransactionCat(
                "merkle_transaction_head_read ",
                current.error),
            artifacts)
    var error: str
    if !csgTransactionManifestMatchesReplacementPolicies(
           current.manifest,
           replacements,
           error):
        return csgTransactionFailApply(error, artifacts)
    if current.found:
        var reused: CsgCoreMerkleTransactionResult
        reused.ok = true
        reused.planReady = true
        reused.productionApplied = true
        reused.reused = true
        reused.requestCid = strings.CloneStr(requestCid)
        reused.planRoot = strings.CloneStr(current.receipt.planRoot)
        reused.headCid = strings.CloneStr(current.head.headCid)
        reused.manifestCid = strings.CloneStr(current.head.manifestCid)
        reused.receiptCid = strings.CloneStr(current.head.receiptCid)
        reused.csgcDirectoryCid =
            strings.CloneStr(current.manifest.csgcDirectoryCid)
        reused.factCount = current.manifest.factCount
        for i in 0..<current.receipt.plannedOperationKinds.len:
            add(
                reused.operationKinds,
                current.receipt.plannedOperationKinds[i])
            add(
                reused.operationFactKeys,
                strings.CloneStr(
                    current.receipt.plannedOperationFactKeys[i]))
        csgTransactionFreeApplyArtifacts(artifacts)
        return reused
    if current.head.headCid != expectedHeadCid:
        return csgTransactionFailApply(
            "merkle_transaction_expected_head_mismatch",
            artifacts)
    # Lease fence consistency: the head captured under the exclusive anchor
    # at acquire time must equal the snapshot head.  A drift means HEAD
    # moved without holding this lease between the two reads.
    if !headLease.headPresent ||
       headLease.headCid != current.head.headCid ||
       headLease.headGeneration != current.head.generation:
        return csgTransactionFailApply(
            "HARD_RED:csg_store_head_lease_fence_mismatch",
            artifacts)
    if !csgTransactionManifestProductionEligible(current.manifest):
        return csgTransactionFailApply(
            "merkle_transaction_previous_manifest_not_production",
            artifacts)

    var out: CsgCoreMerkleTransactionResult
    out.requestCid = strings.CloneStr(requestCid)
    out.headCid = strings.CloneStr(current.head.headCid)
    out.manifestCid = strings.CloneStr(current.head.manifestCid)
    var sourceIds: str[]
    if !csgTransactionManifestSourceIds(
           current.manifest, sourceIds, error) ||
       !csgTransactionBuildShardedInvalidation(
           planningAuthority,
           current.manifest,
           changedSources,
           out.invalidation,
           out.counters,
           error) ||
       !csgTransactionValidateReplacements(
           sourceIds,
           out.invalidation.invalidatedSources,
           replacements,
           error):
        return csgTransactionFailApply(error, artifacts)
    var snapshots: csgTransactionSourceSnapshot[]
    if !csgTransactionReadInvalidatedSources(
           planningAuthority,
           current.manifest,
           out.invalidation.invalidatedSources,
           snapshots,
           out.counters,
           error):
        return csgTransactionFailApply(error, artifacts)
    var localSources: merkle_builder.CsgCoreMerkleBuilderSource[]
    if !csgTransactionMaterialSources(
           snapshots,
           out.invalidation.changedSources,
           replacements,
           out.materialSources,
           localSources,
           error):
        return csgTransactionFailApply(error, artifacts)
    out.counters.materialSourceCount = out.materialSources.len
    var operations: csgTransactionFactOperation[]
    if !csgTransactionBuildOperations(
           snapshots,
           replacements,
           out.materialSources,
           operations,
           error) ||
       !csgTransactionRequireSingleReplace(operations, error):
        return csgTransactionFailApply(error, artifacts)
    add(out.operationKinds, operations[0].kind)
    add(
        out.operationFactKeys,
        strings.CloneStr(operations[0].factKey))
    out.counters.plannedReplaceCount = 1

    if localSources.len > 0:
        artifacts.local =
            merkle_builder.CsgCoreMerkleBuilderBuildLocal(localSources)
        if !artifacts.local.ok:
            return csgTransactionFailApply(
                csgTransactionCat(
                    "merkle_transaction_local_build ",
                    artifacts.local.error),
                artifacts)
        var previousLocalSources: merkle_builder.CsgCoreMerkleBuilderSource[]
        if !csgTransactionPreviousLocalSources(
               snapshots,
               out.materialSources,
               previousLocalSources,
               error):
            return csgTransactionFailApply(error, artifacts)
        artifacts.previousLocal =
            merkle_builder.CsgCoreMerkleBuilderBuildLocal(
                previousLocalSources)
        if !artifacts.previousLocal.ok:
            return csgTransactionFailApply(
                csgTransactionCat(
                    "merkle_transaction_previous_local_build ",
                    artifacts.previousLocal.error),
                artifacts)
    out.counters.rebuiltPartitionCount = artifacts.local.partitions.len
    out.counters.rebuiltMembershipCount = artifacts.local.memberships.len

    var beforeCanonicalFacts: str[]
    if !csgTransactionCurrentCanonicalFacts(
           planningAuthority,
           current.manifest,
           beforeCanonicalFacts,
           out.counters,
           error):
        return csgTransactionFailApply(error, artifacts)
    let beforeFact = csgTransactionPreviousFact(
        snapshots,
        out.materialSources,
        operations[0].factKey,
        error)
    var stagedErr2 = ""
    let afterFact = csgTransactionReplacementFact(
        replacements,
        out.materialSources,
        operations[0].factKey,
        stagedErr2)
    if stagedErr2.len > 0:
        error = stagedErr2
        return csgTransactionFailApply(error, artifacts)
    var sealedIssue =
        merkle_admission.CsgCoreMerkleSealBeforeAuthority(
            beforeCanonicalFacts,
            afterFact,
            operations[0].factKey)
    if !sealedIssue.ok:
        return csgTransactionFailApply(
            strings.CloneStr(sealedIssue.error),
            artifacts)
    if sealedIssue.candidate.beforeFact != beforeFact ||
       sealedIssue.candidate.afterFact != afterFact ||
       sealedIssue.candidate.queryKey != operations[0].factKey:
        csgTransactionPoisonSealedIssue(sealedIssue)
        return csgTransactionFailApply(
            "merkle_transaction_sealed_candidate_mismatch",
            artifacts)
    if !csgTransactionStoredReplayPathValid(
           planningAuthority,
           sealedIssue.candidate,
           out.counters,
           error):
        csgTransactionPoisonSealedIssue(sealedIssue)
        return csgTransactionFailApply(error, artifacts)
    var persistedOperation =
        merkle_transaction_operation.CsgCoreMerkleTransactionOperationBuildSealedReplace(
            sealedIssue.candidate)
    if !persistedOperation.ok:
        let operationError = csgTransactionCat(
            "merkle_transaction_operation_sealed_invalid ",
            persistedOperation.error)
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(operationError, artifacts)
    let operationCid = strings.CloneStr(persistedOperation.cid)
    let proofCid =
        strings.CloneStr(persistedOperation.operation.proofCid)

    var manifest: merkle_manifest.CsgCoreMerkleManifest
    if !csgTransactionPlanIncrementalManifest(
           current.manifest,
           out.materialSources,
           artifacts.local.manifestPartitions,
           sealedIssue.candidate,
           manifest,
           error):
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(error, artifacts)
    manifest.nodeCount =
        merkle_manifest.CsgCoreMerkleExpectedNodeCount(
            manifest.factCount)
    if manifest.nodeCount < 0:
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(
            "merkle_transaction_fact_count_overflow",
            artifacts)
    manifest.partitionRoot =
        merkle_manifest.CsgCoreMerklePartitionRoot(
            manifest.partitions)

    var previousDependencies: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    if !csgTransactionReadConsumerDependencies(
           planningAuthority,
           current.manifest,
           out.invalidation.invalidatedSources,
           previousDependencies,
           out.counters,
           error):
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(error, artifacts)
    var stagedErr1 = ""
    let nextDependencies =
        csgTransactionBuildConsumerDependencies(
            replacements,
            out.invalidation.invalidatedSources,
            manifest.partitions,
            stagedErr1)
    if stagedErr1.len > 0 ||
       !csgTransactionRebuildDependencyShards(
           planningAuthority,
           current.manifest,
           manifest,
           out.invalidation.invalidatedSources,
           previousDependencies,
           nextDependencies,
           artifacts,
           out.counters,
           error) ||
       !csgTransactionRebuildQueryShards(
           planningAuthority,
           current.manifest,
           manifest,
           out.materialSources,
           artifacts.previousLocal.queryRecords,
           artifacts.local.queryRecords,
           artifacts.touchedQueryBuckets,
           artifacts.queryShards,
           out.counters,
           error):
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(error, artifacts)
    out.counters.rebuiltDependencyConsumerShardCount =
        artifacts.dependencyConsumerShards.len
    out.counters.rebuiltDependencyProviderShardCount =
        artifacts.dependencyProviderShards.len
    out.counters.rebuiltQueryShardCount = artifacts.queryShards.len
    artifacts.summary = csgTransactionSummary(
        manifest, manifest.queryIndexCount)
    if !artifacts.summary.ok:
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(
            strings.CloneStr(artifacts.summary.error),
            artifacts)
    manifest.summaryCid = strings.CloneStr(artifacts.summary.cid)

    var baseArtifacts: merkle_transaction_authority.CsgCoreMerkleTransactionArtifactInput[]
    if !csgTransactionBuildBaseArtifacts(
           planningAuthority,
           manifest,
           artifacts,
           baseArtifacts,
           error):
        csgTransactionFreeBaseArtifacts(baseArtifacts)
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(error, artifacts)
    let decodedRequest =
        merkle_transaction_request.CsgCoreMerkleTransactionRequestDecode(
            artifacts.requestArtifact.bytes)
    if !decodedRequest.ok ||
       decodedRequest.requestCid != requestCid:
        csgTransactionFreeBaseArtifacts(baseArtifacts)
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(
            "merkle_transaction_request_decode_mismatch",
            artifacts)
    let skeleton = csgTransactionSemanticSkeleton(manifest)
    let skeletonCid =
        merkle_manifest.CsgCoreMerkleSemanticManifestSkeletonCid(
            skeleton)
    let carrierCid =
        merkle_transaction_authority.CsgCoreMerkleTransactionSemanticCarrierCid(
            sealedIssue.candidate)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(skeletonCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(carrierCid):
        csgTransactionFreeBaseArtifacts(baseArtifacts)
        csgTransactionPoisonSealedIssue(sealedIssue)
        csgTransactionFreeOperationArtifact(persistedOperation)
        return csgTransactionFailApply(
            "merkle_transaction_semantic_identity_invalid",
            artifacts)

    var semanticInput: merkle_transaction_authority.CsgCoreMerkleTransactionSemanticInput
    semanticInput.operation =
        merkle_transaction_operation.CsgCoreMerkleTransactionOperationClone(
            persistedOperation.operation)
    semanticInput.operationCid = strings.CloneStr(operationCid)
    semanticInput.proofCid = strings.CloneStr(proofCid)
    semanticInput.request = decodedRequest.request
    semanticInput.baseArtifacts = baseArtifacts
    baseArtifacts = []
    semanticInput.skeleton = skeleton
    var semanticPlan: merkle_transaction_request.CsgCoreMerkleSemanticPlan
    semanticPlan.beforeStoreIdentity =
        strings.CloneStr(
            planningIdentityReceipt.beforeStoreIdentity)
    semanticPlan.sealedBeforeContentCid =
        strings.CloneStr(
            sealedIssue.candidate.sealedBeforeContentCid)
    semanticPlan.beforeHeadCid = strings.CloneStr(current.head.headCid)
    semanticPlan.beforeManifestCid =
        strings.CloneStr(current.head.manifestCid)
    semanticPlan.beforeGeneration = current.head.generation
    semanticPlan.requestCid = strings.CloneStr(requestCid)
    semanticPlan.invalidationPlanCid =
        strings.CloneStr(out.invalidation.invalidationRoot)
    semanticPlan.semanticManifestSkeletonCid =
        strings.CloneStr(skeletonCid)
    semanticPlan.operationCid = strings.CloneStr(operationCid)
    semanticPlan.proofCid = strings.CloneStr(proofCid)
    semanticPlan.semanticCarrierCid = strings.CloneStr(carrierCid)
    semanticPlan.formatId =
        strings.CloneStr(planningIdentityReceipt.formatId)
    let afterFactCount = sealedIssue.candidate.replay.afterCount
    let rebuiltNodeCount =
        sealedIssue.candidate.replay.rebuiltNodeCount
    let reusedNodeCount =
        sealedIssue.candidate.replay.reusedNodeCount
    var prepared =
        merkle_transaction_authority.CsgCoreMerkleTransactionPrepare(
            semanticInput,
            semanticPlan,
            planningAuthority,
            snapshotAuthority,
            sealedIssue)
    csgTransactionFreeBaseArtifacts(semanticInput.baseArtifacts)
    csgTransactionFreeOperationArtifact(persistedOperation)
    csgTransactionFreeApplyArtifacts(artifacts)
    if !prepared.ok:
        return csgTransactionFail(prepared.error)
    out.ok = true
    out.planReady = true
    out.planRoot = strings.CloneStr(prepared.semanticPlanRoot)
    out.factCount = afterFactCount
    out.counters.computedNodeCount = rebuiltNodeCount
    out.counters.rebuiltNodeCount = rebuiltNodeCount
    out.counters.reusedNodeCount = reusedNodeCount
    out.prepared = prepared.prepared
    prepared.prepared =
        merkle_transaction_authority.CsgCoreMerklePreparedTransaction()
    # The exclusive HEAD lease stays held across the plan -> commit span and
    # travels with the result as int32 identity; the local anchor reference
    # is dropped here so the defer above does not release it early.
    out.headLeaseId = headLease.leaseId
    out.headLeaseEpoch = headLease.epoch
    headLease = merkle_store.CsgCoreMerkleStoreCurrentHeadLease()
    return out

fn CsgCoreMerkleTransactionApplyPrepared(
        planned: CsgCoreMerkleTransactionResult):
        CsgCoreMerkleTransactionResult =
    var consumed = planned
    # Lease identity travels as plain int32 locals so the defer never
    # touches the managed result value that return paths consume.
    var pendingLeaseId = consumed.headLeaseId
    var pendingLeaseEpoch = consumed.headLeaseEpoch
    consumed.headLeaseId = 0
    consumed.headLeaseEpoch = 0
    defer:
        # Failure exits release the HEAD lease carried by the planned
        # result; the success path releases it explicitly right after the
        # commit and zeroes the locals, so this defer is a no-op on every
        # path that already released.
        if pendingLeaseId > 0:
            if !merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseReleaseById(
                   pendingLeaseId,
                   pendingLeaseEpoch):
                panic("merkle transaction: head lease release failed")
    if !consumed.ok || !consumed.planReady:
        return csgTransactionFail(
            "merkle_transaction_prepared_plan_invalid")
    if consumed.productionApplied:
        return consumed
    if !merkle_transaction_authority.CsgCoreMerklePreparedTransactionIsValid(
           consumed.prepared):
        return csgTransactionFail(
            "merkle_transaction_prepared_capability_invalid")
    var prepared = consumed.prepared
    consumed.prepared =
        merkle_transaction_authority.CsgCoreMerklePreparedTransaction()
    var prepublished =
        merkle_transaction_authority.CsgCoreMerkleTransactionPrepublishVerifyInMemory(
            prepared)
    if !prepublished.ok:
        return csgTransactionFail(prepublished.error)
    var session = prepublished.session
    prepublished.session =
        merkle_transaction_authority.CsgCoreMerklePrepublishSession()
    var complete: bool
    var finalArtifactCount: int32
    var finalObjectWriteCount: int32
    while !complete:
        let committed =
            merkle_transaction_authority.CsgCoreMerkleTransactionStoreNextArtifact(
                session)
        if !committed.ok:
            return csgTransactionFail(committed.error)
        complete = committed.complete
        finalArtifactCount = committed.artifactCount
        finalObjectWriteCount = committed.objectWriteCount
        if !committed.reused &&
           committed.artifactKind ==
               merkle_store.CsgCoreMerkleStoreNodeArtifactKind():
            consumed.counters.nodeObjectsWritten =
                consumed.counters.nodeObjectsWritten + 1
    if finalArtifactCount <= 0 || finalObjectWriteCount < 0 ||
       finalObjectWriteCount > finalArtifactCount:
        let terminalError =
            merkle_transaction_authority.CsgCoreMerklePrepublishSessionPoison(
                session)
        if terminalError.len > 0:
            panic("merkle transaction: completed session cleanup failed")
        return csgTransactionFail(
            "merkle_transaction_artifact_completion_invalid")
    let published =
        merkle_store.CsgCoreMerkleStoreCommitPreparedSession(session)
    if !published.ok ||
       published.finalManifestCid != prepublished.finalManifestCid ||
       published.transactionReceiptCid !=
           prepublished.transactionReceiptCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           published.headCid):
        if !published.ok:
            return csgTransactionFail(published.error)
        panic("merkle transaction: committed head receipt drift")
    # Commit done: the fence->commit window closes here; release the
    # exclusive HEAD lease before the result leaves this scope.
    if pendingLeaseId > 0:
        if !merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseReleaseById(
               pendingLeaseId,
               pendingLeaseEpoch):
            panic("merkle transaction: head lease release failed")
        pendingLeaseId = 0
        pendingLeaseEpoch = 0
    consumed.ok = true
    consumed.planReady = true
    consumed.productionApplied = true
    consumed.reused = false
    consumed.headCid = strings.CloneStr(published.headCid)
    consumed.manifestCid =
        strings.CloneStr(published.finalManifestCid)
    consumed.receiptCid =
        strings.CloneStr(published.transactionReceiptCid)
    consumed.counters.storeObjectWriteCount =
        finalObjectWriteCount
    consumed.counters.storeObjectReuseCount =
        finalArtifactCount - finalObjectWriteCount
    consumed.counters.publishAttemptCount = 1
    return consumed

fn CsgCoreMerkleTransactionFree(
        out: var CsgCoreMerkleTransactionResult) =
    if out.headLeaseId > 0:
        if !merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseReleaseById(
               out.headLeaseId,
               out.headLeaseEpoch):
            panic("merkle transaction: head lease cleanup failed")
        out.headLeaseId = 0
        out.headLeaseEpoch = 0
    if out.prepared.ownerId > 0:
        let terminalError =
            merkle_transaction_authority.CsgCoreMerklePreparedTransactionPoison(
                out.prepared)
        if terminalError.len > 0:
            panic("merkle transaction: prepared release failed")
    out = CsgCoreMerkleTransactionResult()
