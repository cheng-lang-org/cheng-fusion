import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/csgc_authority
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

const
    CsgCoreCsgcHistoricalAuthorityDomain: str =
        "csg_core.csgc.historical_generation_authority"
    CsgCoreCsgcHistoricalSchemaNamespace: str =
        "csg_core::v1"

type
    CsgCoreCsgcHistoricalFacts =
        canonicalLines: str[]
        standard: str
        profiles: str[]
        profileSetCid: str
        schemaNamespace: str
        schemaCid: str
        factsRoot: str
        factCount: int32
        csgcByteCount: int32
        csgcDirectoryCid: str
        csgcObjectCid: str

    csgCoreCsgcHistoricalAuthority =
        admitted: bool
        error: str
        authorityCid: str
        audit:
            merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult

    csgCoreCsgcHistoricalCandidate =
        ok: bool
        error: str
        recordIndex: int32
        matchingGenerationCount: int32

    csgCoreCsgcHistoricalPair =
        admitted: bool
        error: str
        authority: csgCoreCsgcHistoricalAuthority
        beforeFacts: CsgCoreCsgcHistoricalFacts
        afterFacts: CsgCoreCsgcHistoricalFacts

@borrows
fn csgcHistoricalAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn csgcHistoricalAppendText(
        out: var layout.ByteBuf,
        value: str) =
    csgcHistoricalAppendU32(out, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(out, value[i])

@borrows
fn csgcHistoricalProfilesEqual(
        left: str[],
        right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn csgcHistoricalRecordValid(
        record:
            merkle_store.CsgCoreMerkleHistoricalGenerationRecord,
        expectedGeneration: int64): bool =
    if record.generation != expectedGeneration ||
       record.standard != validator.CsgCoreStandardIdentity() ||
       record.profiles.len == 0 ||
       record.profiles[0] != "csg_core" ||
       record.profileSetCid !=
           validator.CsgCoreProfileSetCid(record.profiles) ||
       record.factCount <= 0 ||
       record.csgcByteCount < csgc.CsgCoreCsgcHeaderSize:
        return false
    return merkle_store_codec.CsgCoreMerkleStoreCidValid(
               record.headCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            record.manifestCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            record.profileSetCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            record.schemaCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            record.factsRoot) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            record.csgcDirectoryCid) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            record.csgcObjectCid)

@borrows
fn csgcHistoricalAuditValid(
        audit:
            merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult):
        bool =
    if !audit.ok || audit.error.len != 0 ||
       audit.verificationScope != "full_successor_history" ||
       !audit.fullHistoryVerified ||
       !audit.successorChainVerified ||
       !audit.receiptChainVerified ||
       !audit.manifestClosuresVerified ||
       audit.storeRoot.len == 0 ||
       audit.currentGeneration < int64(0) ||
       audit.generations.len == 0 ||
       audit.currentGeneration !=
           int64(audit.generations.len - 1) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           audit.currentHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           audit.currentManifestCid):
        return false
    for i in 0..<audit.generations.len:
        if !csgcHistoricalRecordValid(
               audit.generations[i], int64(i)):
            return false
        if i == 0:
            if audit.generations[i].previousHeadCid != "none" ||
               audit.generations[i].receiptCid != "none":
                return false
        else:
            if audit.generations[i].previousHeadCid !=
                   audit.generations[i - 1].headCid ||
               !merkle_store_codec.CsgCoreMerkleStoreCidValid(
                   audit.generations[i].receiptCid):
                return false
    let latest = audit.generations[audit.generations.len - 1]
    return latest.headCid == audit.currentHeadCid &&
        latest.manifestCid == audit.currentManifestCid

@borrows
fn csgcHistoricalAuthorityCid(
        audit:
            merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult):
        str =
    var payload = layout.ByteBufInit(1024)
    csgcHistoricalAppendText(payload, audit.verificationScope)
    csgcHistoricalAppendText(payload, audit.storeRoot)
    csgcHistoricalAppendText(
        payload,
        strings.Int64ToStr(audit.currentGeneration))
    csgcHistoricalAppendText(payload, audit.currentHeadCid)
    csgcHistoricalAppendText(payload, audit.currentManifestCid)
    csgcHistoricalAppendText(
        payload,
        strings.IntToStr(audit.generations.len))
    for i in 0..<audit.generations.len:
        let record = audit.generations[i]
        csgcHistoricalAppendText(
            payload, strings.Int64ToStr(record.generation))
        csgcHistoricalAppendText(payload, record.headCid)
        csgcHistoricalAppendText(payload, record.previousHeadCid)
        csgcHistoricalAppendText(payload, record.receiptCid)
        csgcHistoricalAppendText(payload, record.manifestCid)
        csgcHistoricalAppendText(payload, record.standard)
        csgcHistoricalAppendText(payload, record.profileSetCid)
        csgcHistoricalAppendText(payload, record.schemaCid)
        csgcHistoricalAppendText(payload, record.factsRoot)
        csgcHistoricalAppendText(
            payload, strings.IntToStr(record.factCount))
        csgcHistoricalAppendText(
            payload, strings.IntToStr(record.csgcByteCount))
        csgcHistoricalAppendText(payload, record.csgcDirectoryCid)
        csgcHistoricalAppendText(payload, record.csgcObjectCid)
        csgcHistoricalAppendText(
            payload, strings.IntToStr(record.profiles.len))
        for profileIndex in 0..<record.profiles.len:
            csgcHistoricalAppendText(
                payload, record.profiles[profileIndex])
    var bytes = layout.ByteBufToBytes(payload)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            CsgCoreCsgcHistoricalAuthorityDomain,
            bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

@borrows
fn csgcHistoricalAuthorityValid(
        authority: csgCoreCsgcHistoricalAuthority): bool =
    return authority.admitted && authority.error.len == 0 &&
        csgcHistoricalAuditValid(authority.audit) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            authority.authorityCid) &&
        csgcHistoricalAuthorityCid(authority.audit) ==
            authority.authorityCid

fn CsgCoreCsgcHistoricalAuthorityIssue():
        csgCoreCsgcHistoricalAuthority =
    let audit =
        csgc_authority.CsgCoreCsgcHistoricalStoreAudit()
    var out: csgCoreCsgcHistoricalAuthority
    if !csgcHistoricalAuditValid(audit):
        out.error = strings.CloneStr(audit.error)
        if out.error.len == 0:
            out.error =
                "csgc_historical_store_audit_not_admitted"
        return out
    out.audit = audit
    out.authorityCid = csgcHistoricalAuthorityCid(out.audit)
    out.admitted = true
    return out

@borrows
fn CsgCoreCsgcHistoricalAuthorityError(
        authority: csgCoreCsgcHistoricalAuthority): str =
    return strings.CloneStr(authority.error)

@borrows
fn CsgCoreCsgcHistoricalAuthorityIsValid(
        authority: csgCoreCsgcHistoricalAuthority): bool =
    return csgcHistoricalAuthorityValid(authority)

@borrows
fn csgcHistoricalRecordsEquivalent(
        left:
            merkle_store.CsgCoreMerkleHistoricalGenerationRecord,
        right:
            merkle_store.CsgCoreMerkleHistoricalGenerationRecord):
        bool =
    return left.manifestCid == right.manifestCid &&
        left.standard == right.standard &&
        csgcHistoricalProfilesEqual(left.profiles, right.profiles) &&
        left.profileSetCid == right.profileSetCid &&
        left.schemaCid == right.schemaCid &&
        left.factsRoot == right.factsRoot &&
        left.factCount == right.factCount &&
        left.csgcByteCount == right.csgcByteCount &&
        left.csgcDirectoryCid == right.csgcDirectoryCid &&
        left.csgcObjectCid == right.csgcObjectCid

@borrows
fn csgcHistoricalMatchCandidate(
        authority: csgCoreCsgcHistoricalAuthority,
        bytes: rawbytes.Bytes):
        csgCoreCsgcHistoricalCandidate =
    var out: csgCoreCsgcHistoricalCandidate
    if !csgcHistoricalAuthorityValid(authority):
        out.error = "csgc_historical_authority_not_admitted"
        return out
    let byteCount = rawbytes.BytesLen(bytes)
    if byteCount < csgc.CsgCoreCsgcHeaderSize:
        out.error = "csgc_historical_candidate_too_short"
        return out
    let objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            bytes)
    var selected: int32 = -1
    for i in 0..<authority.audit.generations.len:
        let record = authority.audit.generations[i]
        if record.csgcByteCount == byteCount &&
           record.csgcObjectCid == objectCid:
            if selected >= 0 &&
               !csgcHistoricalRecordsEquivalent(
                   authority.audit.generations[selected],
                   record):
                out.error =
                    "csgc_historical_candidate_non_equivalent_multiple_match"
                return out
            if selected < 0:
                selected = i
            out.matchingGenerationCount =
                out.matchingGenerationCount + 1
    if selected < 0:
        out.error =
            "csgc_historical_candidate_not_in_authoritative_history"
        return out
    out.recordIndex = selected
    out.ok = true
    return out

@borrows
fn csgcHistoricalFactsFail(
        error: str): CsgCoreCsgcHistoricalFacts =
    var out: CsgCoreCsgcHistoricalFacts
    return out

@borrows
fn csgcHistoricalFactsClone(
        facts: CsgCoreCsgcHistoricalFacts):
        CsgCoreCsgcHistoricalFacts =
    var out: CsgCoreCsgcHistoricalFacts
    for i in 0..<facts.canonicalLines.len:
        add(
            out.canonicalLines,
            strings.CloneStr(facts.canonicalLines[i]))
    out.standard = strings.CloneStr(facts.standard)
    out.profiles = validator.CsgCoreProfilesClone(facts.profiles)
    out.profileSetCid = strings.CloneStr(facts.profileSetCid)
    out.schemaNamespace = strings.CloneStr(facts.schemaNamespace)
    out.schemaCid = strings.CloneStr(facts.schemaCid)
    out.factsRoot = strings.CloneStr(facts.factsRoot)
    out.factCount = facts.factCount
    out.csgcByteCount = facts.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(facts.csgcDirectoryCid)
    out.csgcObjectCid = strings.CloneStr(facts.csgcObjectCid)
    return out

@borrows
fn csgcHistoricalDecodeCandidate(
        authority: csgCoreCsgcHistoricalAuthority,
        candidate: csgCoreCsgcHistoricalCandidate,
        bytes: rawbytes.Bytes,
        error: var str): CsgCoreCsgcHistoricalFacts =
    if !candidate.ok || candidate.recordIndex < 0 ||
       candidate.recordIndex >= authority.audit.generations.len:
        error = "csgc_historical_candidate_not_admitted"
        return csgcHistoricalFactsFail(error)
    let record = authority.audit.generations[candidate.recordIndex]
    let directory = csgc.CsgCoreCsgcClaimDirectory(bytes)
    if !directory.ok ||
       directory.factCount != record.factCount ||
       directory.directoryCid != record.csgcDirectoryCid:
        error = "csgc_historical_candidate_directory_mismatch"
        return csgcHistoricalFactsFail(error)
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok || decoded.factCount != record.factCount:
        error = strings.ConcatStr(
            "csgc_historical_candidate_decode_failed:",
            decoded.error)
        return csgcHistoricalFactsFail(error)
    let validation =
        validator.CsgCoreProductionAdmitFactLines(decoded.lines)
    if !validation.valid || !validation.complete ||
       validation.unsupportedCount != 0 ||
       validation.tombstoneCount != 0 ||
       validation.runtimeRequirementCount != 0:
        error =
            "csgc_historical_candidate_production_admission_failed"
        return csgcHistoricalFactsFail(error)
    let binding =
        validator.CsgCoreRootBindingFromCanonicalLines(
            decoded.lines)
    if !binding.ok ||
       validation.standard != record.standard ||
       validation.schemaNamespace !=
           CsgCoreCsgcHistoricalSchemaNamespace ||
       validation.profileSetCid != record.profileSetCid ||
       !csgcHistoricalProfilesEqual(
           validation.profiles, record.profiles) ||
       binding.standard != record.standard ||
       binding.schemaNamespace !=
           CsgCoreCsgcHistoricalSchemaNamespace ||
       binding.schemaCid != record.schemaCid ||
       binding.profileSetCid != record.profileSetCid ||
       !csgcHistoricalProfilesEqual(
           binding.profiles, record.profiles) ||
       validation.factsRoot != record.factsRoot ||
       validation.factCount != record.factCount:
        error =
            "csgc_historical_candidate_manifest_binding_mismatch"
        return csgcHistoricalFactsFail(error)
    var out: CsgCoreCsgcHistoricalFacts
    for i in 0..<decoded.lines.len:
        add(out.canonicalLines, strings.CloneStr(decoded.lines[i]))
    out.standard = strings.CloneStr(record.standard)
    out.profiles = validator.CsgCoreProfilesClone(record.profiles)
    out.profileSetCid = strings.CloneStr(record.profileSetCid)
    out.schemaNamespace =
        CsgCoreCsgcHistoricalSchemaNamespace
    out.schemaCid = strings.CloneStr(record.schemaCid)
    out.factsRoot = strings.CloneStr(record.factsRoot)
    out.factCount = record.factCount
    out.csgcByteCount = record.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(record.csgcDirectoryCid)
    out.csgcObjectCid = strings.CloneStr(record.csgcObjectCid)
    return out

@borrows
fn csgcHistoricalAuditSame(
        left:
            merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult,
        right:
            merkle_store.CsgCoreMerkleHistoricalAuthorityReadResult):
        bool =
    if !csgcHistoricalAuditValid(left) ||
       !csgcHistoricalAuditValid(right) ||
       left.storeRoot != right.storeRoot ||
       left.currentGeneration != right.currentGeneration ||
       left.currentHeadCid != right.currentHeadCid ||
       left.currentManifestCid != right.currentManifestCid ||
       left.generations.len != right.generations.len:
        return false
    for i in 0..<left.generations.len:
        let leftRecord = left.generations[i]
        let rightRecord = right.generations[i]
        if leftRecord.generation != rightRecord.generation ||
           leftRecord.headCid != rightRecord.headCid ||
           leftRecord.previousHeadCid !=
               rightRecord.previousHeadCid ||
           leftRecord.receiptCid != rightRecord.receiptCid ||
           !csgcHistoricalRecordsEquivalent(
               leftRecord, rightRecord):
            return false
    return true

@borrows
fn csgcHistoricalPairFail(
        error: str): csgCoreCsgcHistoricalPair =
    var out: csgCoreCsgcHistoricalPair
    out.error = strings.CloneStr(error)
    return out

@borrows
fn CsgCoreCsgcHistoricalAuthorizePair(
        authority: csgCoreCsgcHistoricalAuthority,
        beforeBytes: rawbytes.Bytes,
        afterBytes: rawbytes.Bytes):
        csgCoreCsgcHistoricalPair =
    if !csgcHistoricalAuthorityValid(authority):
        return csgcHistoricalPairFail(
            "csgc_historical_authority_not_admitted")
    # Full object CID and byte count authorize both candidates before either
    # header, directory or fact payload is decoded.
    let beforeCandidate =
        csgcHistoricalMatchCandidate(authority, beforeBytes)
    if !beforeCandidate.ok:
        return csgcHistoricalPairFail(beforeCandidate.error)
    let afterCandidate =
        csgcHistoricalMatchCandidate(authority, afterBytes)
    if !afterCandidate.ok:
        return csgcHistoricalPairFail(afterCandidate.error)
    var beforeError: str
    let beforeFacts =
        csgcHistoricalDecodeCandidate(
            authority,
            beforeCandidate,
            beforeBytes,
            beforeError)
    if beforeError.len > 0:
        return csgcHistoricalPairFail(beforeError)
    var afterError: str
    let afterFacts =
        csgcHistoricalDecodeCandidate(
            authority,
            afterCandidate,
            afterBytes,
            afterError)
    if afterError.len > 0:
        return csgcHistoricalPairFail(afterError)
    let finalAudit =
        csgc_authority.CsgCoreCsgcHistoricalStoreAudit()
    if !csgcHistoricalAuditSame(authority.audit, finalAudit):
        return csgcHistoricalPairFail(
            "csgc_historical_successor_chain_changed")
    var out: csgCoreCsgcHistoricalPair
    out.authority = share(authority)
    out.beforeFacts = beforeFacts
    out.afterFacts = afterFacts
    out.admitted = true
    return out

@borrows
fn CsgCoreCsgcHistoricalPairIsValid(
        pair: csgCoreCsgcHistoricalPair): bool =
    return pair.admitted && pair.error.len == 0 &&
        csgcHistoricalAuthorityValid(pair.authority) &&
        pair.beforeFacts.factCount > 0 &&
        pair.afterFacts.factCount > 0

@borrows
fn CsgCoreCsgcHistoricalPairError(
        pair: csgCoreCsgcHistoricalPair): str =
    return strings.CloneStr(pair.error)

@borrows
fn CsgCoreCsgcHistoricalPairBeforeFacts(
        pair: csgCoreCsgcHistoricalPair):
        CsgCoreCsgcHistoricalFacts =
    return csgcHistoricalFactsClone(pair.beforeFacts)

@borrows
fn CsgCoreCsgcHistoricalPairAfterFacts(
        pair: csgCoreCsgcHistoricalPair):
        CsgCoreCsgcHistoricalFacts =
    return csgcHistoricalFactsClone(pair.afterFacts)

@borrows
fn CsgCoreCsgcHistoricalPairFinalFence(
        pair: csgCoreCsgcHistoricalPair): bool =
    if !CsgCoreCsgcHistoricalPairIsValid(pair):
        return false
    let finalAudit =
        csgc_authority.CsgCoreCsgcHistoricalStoreAudit()
    return csgcHistoricalAuditSame(
        pair.authority.audit, finalAudit)
