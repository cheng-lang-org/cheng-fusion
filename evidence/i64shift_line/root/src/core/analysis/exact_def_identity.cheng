# exact_def_identity — ExactDef 批 3: identity schema 主审 + 投影权威
# (docs/cheng-exact-def-rewrite-design.md §4 批 3 / §5-3 / §6;
# 算法照 docs/cheng-exact-def-batch3-identity-spec.md 伪代码级规格移植,
# C 行号证据逐条锚定在注释中: 主审 cheng_cold.c:67588-70153)。
#
# 职责 (照规格 §0-§7):
#   1. 入口门/列门 (C 67592-67661); read-edge 总门调用 (C 67752-67758,
#      批 2 终校验同源, 经 freeze 出口); 块区间三判词 (C 67760-67852)。
#   2. 主审主循环 (C 67861-69554): 空组哨兵链 / has partial definition
#      tuple / op 层 type+storage 子句 / place 八臂分派 — 本批臂:
#      TEMPORARY 门序 (C 68427-68804) / STACK_LOCAL 绑定门+根门+source
#      chain 六臂 (C 68823-69053) / PARAM 臂+效应门 (C 69054-69106) /
#      BORROW_PROJECTION 主门 21 字段 (C 69107-69314) / GLOBAL 臂
#      (C 69315-69340) / SHARED_COPY 臂 (C 69341-69391)。
#      CFG_MERGE 臂 = 批 4 锚点 (不实现, panic 锚); MEMORY_VERSION
#      var-out 臂 = 批 5 锚点 (panic 锚)。批 4/5 锚点见分派处注释。
#   3. def↔slot 四字段一致 (C §2): op 层 type+storage 子句 (主循环内),
#      槽层倒排计数 + partial authority 门 + definition count 门
#      (C 69942-70152, 槽循环)。
#   4. mv_source_view_edge 臂的 Cheng 形态 (规格 §4, 设计 §5-3):
#      row_is_identity_view 的 Cheng 残余 = place∈{MEMORY_VERSION,
#      CFG_MERGE} 戳 (kind NOP 无载体); 支配子句由槽终校验
#      (cold_exact_identity_view_slot_terminal_valid 的 Cheng 版) 放电,
#      链门其余四类检查全保留, 判词维持 `source chain is broken`
#      同文本同字段序。
#   5. 投影权威 (规格 §5): 帧自有谓词单实现 (规格 §5.1 三消费点同源 —
#      parent_live 兜底①与批 5 walk/门 1/门 2 锚点共用, 禁止第二份
#      逐字拷贝); BORROW_PROJECTION 主门 (Cheng 投影 op 集 {FieldLoad,
#      IndexedLoad, CopyLocal, ResultProject}, 规格 §8); borrow
#      projection 同槽 tie 只消费批 1 derive/批 2 consume 事实 (op712
#      形回归见 smoke); parent_live 双车道 (借用→前向纪元 walker
#      本批自走, 与批 2 同支配缓存/按位或 join 纪律; PLAIN/MOVE→
#      is_live_before_op+三兜底)。
#   6. 审计段调用关系 (规格 §7): 与主审同函数顺序执行, 共享批 2
#      consumer summary (has invalid path consume / consume edge is
#      broken 经 freeze 出口同源调用, 不重复实现); term 循环三族与
#      call_arg 循环 = 批 5 锚点注释。
#
# Cheng 基板差异裁定 (规格 §8, 逐条在对应臂注释):
#   - 无 NOP/MEMORY_VERSION/CFG_MERGE/FIELD_REF/LOCAL_ADDR/PAYLOAD/
#    EXACT_PLAIN_SCOPE_END op → 依赖其载体的臂真空裁定写明注释;
#   - plain_memory_version_source_read 真空 (批 2 豁免位①已按
#     IndexedStore 写回重证, 见 exact_def_freeze 模块头);
#   - copy_kind 11 种 → Cheng 投影 op 集 / 绑定载体 CopyLocal /
#     常量根 LoadConst (C STR_LITERAL+常量物化 COPY 链的一次成型对应物,
#     设计 §5-5 同族裁定);
#   - plain_copy_tuple_valid 的 kind∈{OBJECT,ARRAY_I32} →
#     typeArenaTypeId 侧车列 + typeFact structural 联合;
#   - param expected_copy 二值 → 入口装载载体 LoadLocal 裸形 (Cheng
#     参数定义 op 直接定义入参槽, 无 raw ABI 载体槽 — 与批 2 read-edge
#     自边裁定同源; op_a==raw_slot 子句塌缩为 target==raw 槽);
#   - 判词文本逐字保留 C (含 cheng_cold: 前缀与字段序), 基板替换仅
#     %.*s 函数名 → controlFunctionRow int32 (批 1/2 先例)。
#
# 相位与组合 (规格 §0 调用关系): ExactDefIdentityPhaseValidateInto =
# 批 3 相位本体; ExactDefIdentityValidateInto = 组合入口 — 先批 2 相位
# (freeze.ExactDefFreezeValidateInto 原样), 后批 3 相位, phase 统一
# "freeze" (与批 2 组合点同铭文)。
#
# 身份纪律: 一切跨节点身份 int32 行 (op 行/槽行/TypeId/函数行),
# 零文本零名字键 (判词投影段除外 — 单行确定性强排投影)。

import std/strformat
import std/os
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/analysis/exact_def_merge as exactdefmerge
import cheng/core/lang/typed_expr_type_arena as typearena

@borrows
fn exactDefIdentityVerdictEmit(line: str) =
    os.WriteLine(os.Get_stderr(), line)
    os.C_fflush(os.Get_stderr())

# C die 语义 (容量哨兵族): stderr 单行确定 + 进程退出, 不返。
@borrows
fn exactDefIdentityDie(line: str) =
    os.WriteLine(os.Get_stderr(), line)
    os.C_fflush(os.Get_stderr())
    os.os_exit_bridge(2)

fn exactDefIdentityBoolInt(value: bool): int32 =
    if value:
        return 1
    return 0

@borrows
fn exactDefIdentityOpOperandOrInvalid(op: coreir.BodyOp,
                                      ordinal: int32): int32 =
    if ordinal < 0 || ordinal >= op.operands.len:
        return -1
    return op.operands[ordinal]

