# ---- 谓词 helper 层 ----

# typeFact 结构查询 (BodyIR 冻结投影; row 缺失 = -1)。
# 批 4 起单实现迁入 exact_def_freeze (merge 同源消费), 本 fn 为委托别名。
@borrows
fn exactDefIdentityTypeFactStructuralKind(bodyIR: coreir.BodyIR,
                                          typeId: int32): int32 =
    return freeze.ExactDefFreezeTypeFactStructuralKind(bodyIR, typeId)

# Alias/Apply 转发行单跳展开 (typeFact childTypeIds 链); Borrow 不解 —
# Borrow 即借用地址叶 (独立性判定用)。环/缺行 → -1。
@borrows
fn exactDefIdentityPhysicalTypeId(bodyIR: coreir.BodyIR,
                                  typeId: int32): int32 =
    return freeze.ExactDefFreezePhysicalTypeId(bodyIR, typeId)

# 槽层 expected storage (C cold_canonical_storage_obligation_for_body_slot
# 的冻结层替代): 与 derive 的 BodyIrExactDefStorageObligationForSlot 同
# 优先级 — 已绑 TypeId 槽的 nominal 义务以 derive 落戳为准 (recorded 即
# 规范义务; TypeArena layoutChild CSR 证据窗不在冻结 BodyIR 投影, 设计
# §7-1 遗留 — 上游不变式放电, 非重证; 与规格 §5-4/§5-5 同族裁定);
# 未绑槽走静态道 (str/标量/裸指针, 与 derive 静态道同构)。
@borrows
fn exactDefIdentityExpectedStorageForSlot(bodyIR: coreir.BodyIR,
                                          slot: int32): int32 =
    let local = bodyIR.localSlots[slot]
    if local.typeArenaTypeId >= 0:
        return bodyIR.exactDef.slotStorageKinds[slot]
    if local.typeKind == coreir.LocalStrTag:
        return exactdef.BodyIrExactDefStorageStrTag
    if local.typeKind == coreir.LocalI32Tag:
        if local.sizeBytes == 1 || local.sizeBytes == 4:
            return exactdef.BodyIrExactDefStoragePlainTag
        return exactdef.BodyIrExactDefStorageUnknownTag
    if local.typeKind == coreir.LocalI64Tag ||
       local.typeKind == coreir.LocalF64Tag ||
       local.typeKind == coreir.LocalPtrTag:
        if local.sizeBytes == 8:
            return exactdef.BodyIrExactDefStoragePlainTag
        return exactdef.BodyIrExactDefStorageUnknownTag
    return exactdef.BodyIrExactDefStorageUnknownTag

# 定长数组元素链独立性内折 (cold_plain_value_copy_is_independent 的
# ARRAY_I32 臂元素道): 元素必须无借用地址叶 (Borrow/RefObject/CString
# 即地址) 且折叠 PLAIN; 嵌套定长数组逐层递归 (禁摊平); Object 元素 =
# 字段证据缺位 (见外层的真空裁定) → false。批 4 起单实现迁入 freeze。
@borrows
fn exactDefIdentityFixedArrayElementIndependent(
        bodyIR: coreir.BodyIR,
        typeId: int32,
        depth: int32): bool =
    return freeze.ExactDefFreezeFixedArrayElementIndependent(
        bodyIR, typeId, depth)

# cold_plain_value_copy_is_independent (cold_parser.c:60240-60286) 的
# Cheng 版: OBJECT 非 ref+无 managed drop+无借用地址 / ARRAY_I32 同款。
# Cheng 基板 (规格 §8): OBJECT/ARRAY_I32 区分走 typeArenaTypeId 侧车列 +
# typeFact structural; PLAIN storage 折叠已由 derive 证明无 managed drop。
# Object 形: 字段布局 CSR 不在冻结 BodyIR 投影 (typeFact 无 layoutChild
# 列), 字段级独立性证据缺位 → 本批真空裁定 (恒不证; 批 6 锚点 — derive
# 接线时 evidence 窗在作用域, 独立性由上游车道落证)。FixedArray 形:
# 元素链逐层证 + auxValue/sizeBytes 双等。批 4 起单实现迁入 freeze。
@borrows
fn exactDefIdentityPlainValueCopyIndependent(bodyIR: coreir.BodyIR,
                                             slot: int32): bool =
    return freeze.ExactDefFreezePlainValueCopyIndependent(bodyIR, slot)

# 帧自有槽约定共享 helper (规格 §5.1 单实现; cold_parser.c:29757-29768 /
# cheng_cold.c:60798-60813 / cold_parser.c:82847-82860 三处同一约定):
# place∈{STACK_LOCAL,TEMPORARY} && own∈{MOVE,PLAIN} && origin==def_slot。
# 消费点: 本批 parent_live 兜底① (cheng_cold.c:60798-60813); 批 5 锚点
# — oxa walk 第三臂与门 1/门 2 帧自有豁免 (规格 §5.2) 同源调用本 helper,
# 禁止第二份逐字拷贝。
@borrows
fn ExactDefIdentityDefinitionRootsFrameOwnedSlot(
        bodyIR: coreir.BodyIR,
        definition: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len:
        return false
    let place = bodyIR.exactDef.opPlaceKinds[definition]
    if place != exactdef.BodyIrExactDefPlaceStackLocalTag &&
       place != exactdef.BodyIrExactDefPlaceTemporaryTag:
        return false
    let ownership = bodyIR.ops[definition].valueDefOwnership
    if ownership != coreir.OwnMove && ownership != coreir.OwnPlain:
        return false
    let slot = bodyIR.ops[definition].valueDefSlot
    return slot >= 0 &&
           bodyIR.exactDef.opOriginIds[definition] == slot

# 借用根冻结权威 (cold_borrow_result_root_valid 的 Cheng 基板裁定):
# C 重走借用链证 @borrow_result 根; Cheng 的链证明是 lowering 冻结的
# borrow-owner 权威列 (core_types BodyOp 注释: OwnBorrowShared 的不可变
# 精确寿命根) — 冻结列在界即根已证 (上游不变式放电, 与规格 §5-4 同族)。
@borrows
fn exactDefIdentityBorrowResultRootValid(bodyIR: coreir.BodyIR,
                                         source: int32): bool =
    # 批 5 起单实现迁入 freeze (ExactDefFreezeAuthorityBorrowResultRootValid,
    # 同上同款裁定) — 本 fn 为委托别名, 谓词零改动。
    return freeze.ExactDefFreezeAuthorityBorrowResultRootValid(
        bodyIR, source)

# cold_exact_plain_static_string_definition_valid (C 63981-64014) 的
# Cheng 版: STACK_LOCAL 形 (CFG_MERGE 形真空 — 无载体); C 的
# dst/b/c 读边 -1 子句在 Cheng 无对应读边列 → 真空 (readA 列是 a 读边,
# 不在其子句)。COLD_STR_SLOT_SIZE=24。
@borrows
fn exactDefIdentityPlainStaticStringDefinitionValid(
        bodyIR: coreir.BodyIR,
        definition: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[definition]
    let slot = op.valueDefSlot
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return false
    let local = bodyIR.localSlots[slot]
    if local.typeKind != coreir.LocalStrTag || local.sizeBytes != 24 ||
       bodyIR.exactDef.slotStorageKinds[slot] !=
           exactdef.BodyIrExactDefStorageStrTag:
        return false
    let exactType = bodyIR.exactDef.opExactTypeIds[definition]
    return op.target == slot && exactType >= 0 &&
           local.typeArenaTypeId == exactType &&
           bodyIR.exactDef.opProducerFunctionRows[definition] ==
               bodyIR.controlFunctionRow &&
           bodyIR.exactDef.opPlaceKinds[definition] ==
               exactdef.BodyIrExactDefPlaceStackLocalTag &&
           bodyIR.exactDef.opOriginIds[definition] == slot &&
           op.valueDefOwnership == coreir.OwnPlain

# cold_exact_plain_copy_tuple_valid (C 52241-52305) 的 Cheng 版。
# source_reaches (批 4 落地; C 52252-52259): 行序道 source<copy, 或
# CFG_MERGE place 源经真实支配路径到达 (loop-header merge 的不可变行
# 可晚于其支配的 body 行); MV place 在 Cheng 无落戳车道 → 真空。
# kind∈{OBJECT,ARRAY_I32} → 双槽 LocalAggregateTag + 同 typeArenaTypeId +
# typeFact structural∈{Object,FixedArray} (规格 §8); b==c==0 →
# operands.len==1。
@borrows
fn exactDefIdentityPlainCopyTupleValid(bodyIR: coreir.BodyIR,
                                       dom: freeze.ExactDefFreezeDominators,
                                       opBlockIds: int32[],
                                       source: int32,
                                       copy: int32): bool =
    if source < 0 || source >= bodyIR.ops.len ||
       copy < 0 || copy >= bodyIR.ops.len || source == copy:
        return false
    var sourceReachesCopy = source < copy
    if !sourceReachesCopy &&
       bodyIR.exactDef.opPlaceKinds[source] ==
           exactdef.BodyIrExactDefPlaceCfgMergeTag:
        sourceReachesCopy = freeze.ExactDefFreezeIdentityReaches(
            bodyIR, dom, opBlockIds, source, copy)
    if !sourceReachesCopy:
        return false
    let copyOp = bodyIR.ops[copy]
    if copyOp.kind != coreir.BodyOpCopyLocalTag:
        return false
    if freeze.ExactDefFreezeIdentityOpSourceDefRow(copyOp) != source:
        return false
    if bodyIR.exactDef.opPlaceKinds[copy] !=
           exactdef.BodyIrExactDefPlaceStackLocalTag ||
       copyOp.valueDefOwnership != coreir.OwnPlain:
        return false
    let sourceOwnership = bodyIR.ops[source].valueDefOwnership
    if sourceOwnership != coreir.OwnPlain &&
       sourceOwnership != coreir.OwnBorrowShared &&
       sourceOwnership != coreir.OwnBorrowUnique:
        return false
    let sourceSlot = bodyIR.ops[source].valueDefSlot
    let destination = copyOp.valueDefSlot
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len ||
       destination < 0 || destination >= bodyIR.localSlots.len ||
       sourceSlot == destination:
        return false
    if copyOp.operands.len != 1 || copyOp.operands[0] != sourceSlot ||
       copyOp.target != destination:
        return false
    let sourceLocal = bodyIR.localSlots[sourceSlot]
    let destLocal = bodyIR.localSlots[destination]
    if sourceLocal.typeKind != coreir.LocalAggregateTag ||
       destLocal.typeKind != coreir.LocalAggregateTag ||
       sourceLocal.typeArenaTypeId < 0 ||
       sourceLocal.typeArenaTypeId != destLocal.typeArenaTypeId:
        return false
    let structural = exactDefIdentityTypeFactStructuralKind(
        bodyIR, sourceLocal.typeArenaTypeId)
    if structural != Int32(typearena.TypedExprStructuralTypeObject) &&
       structural != Int32(typearena.TypedExprStructuralTypeFixedArray):
        return false
    if sourceLocal.sizeBytes != destLocal.sizeBytes:
        return false
    if bodyIR.exactDef.slotStorageKinds[sourceSlot] !=
           exactdef.BodyIrExactDefStoragePlainTag ||
       bodyIR.exactDef.slotStorageKinds[destination] !=
           exactdef.BodyIrExactDefStoragePlainTag:
        return false
    return bodyIR.exactDef.opExactTypeIds[source] >= 0 &&
           bodyIR.exactDef.opExactTypeIds[source] ==
               bodyIR.exactDef.opExactTypeIds[copy] &&
           bodyIR.exactDef.opProducerFunctionRows[source] ==
               bodyIR.exactDef.opProducerFunctionRows[copy] &&
           bodyIR.exactDef.opOriginIds[copy] == destination

# cold_exact_param_definition_edge_valid (C 62156-62237) 的 Cheng 版。
# 基板裁定 (规格 §8 + Cheng 单槽入参):
#   - expected_copy 二值 (COPY_I64/COPY_COMPOSITE) → 入口装载载体
#     LoadLocal 裸形 (operands.len==0): §8 的 CopyLocal 裁定以双槽 raw
#     ABI 载体为前提; Cheng 参数定义 op 直接定义入参槽 (与批 2
#     read-edge「参数定义 op 直接定义入参槽, 无 raw ABI 载体槽」裁定
#     同源), op_a==raw_slot 子句塌缩为 target==raw 槽 (def 槽即 raw 槽)。
#   - NOP var-param 标记递归臂 (C 62193-62199): 无 Cheng 载体 → 真空。
#   - physical_ref 八种 REF kind → LocalPtrTag | typeFact RefObject 联合;
#     raw==ARRAY_I32 → typeFact FixedArray; raw==OBJECT → typeFact Object。
#   - consume 子句的 NOP 标记析取无载体 → borrowed ⇒ consume==0。
@borrows
fn exactDefIdentityParamDefinitionEdgeValid(bodyIR: coreir.BodyIR,
                                            opRow: int32): bool =
    # 批 5 起单实现迁入 freeze (ExactDefFreezeAuthorityParamDefinitionEdgeValid,
    # 批 4 typeFact 四 helper 同款单实现归位裁定) — 本 fn 为委托别名,
    # 谓词零改动。
    return freeze.ExactDefFreezeAuthorityParamDefinitionEdgeValid(
        bodyIR, opRow)

# parent_param_root 判词字段谓词 (C 60952-61026 的 Cheng 版):
# CFG_MERGE+SHARED 双输入同根归约臂 (批 4 落地; C 60962-60986) —
# loop-header 的共享 ref-object 形参 cell merge 与 PARAM 行是同一
# mutation 根: 双输入 (结构 source + merge 第二输入回收) 借用根
# 冻结三列逐值相等且域 BodyOp 时归约到该根行; EntrySlot 域无 op 行
# 载体, 本臂不证 (严格方向)。PARAM 根臂: PARAM+SHARED+producer+
# param_edge_valid, 槽/TypeId 域 RefObject+8B+OBJECT storage; C 的
# canonical ObjectDef 恒等子句 (61019-61025) 在 Cheng 由 TypeArena
# 规范域权威放电 (artifact CID 绑定即规范行域, ObjectDef 行号域无
# 载体) — 注释锚定。仅服务 21 字段判词投影。
@borrows
fn exactDefIdentityBorrowedRefObjectParamMutationRootValid(
        bodyIR: coreir.BodyIR,
        definition: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len:
        return false
    if bodyIR.exactDef.opPlaceKinds[definition] ==
           exactdef.BodyIrExactDefPlaceCfgMergeTag &&
       bodyIR.ops[definition].valueDefOwnership ==
           coreir.OwnBorrowShared:
        let firstInput = freeze.ExactDefFreezeIdentityOpSourceDefRow(
            bodyIR.ops[definition])
        let secondInput =
            freeze.ExactDefFreezeMergeSecondInputRowForMerge(
                bodyIR, definition)
        if firstInput < 0 || firstInput >= bodyIR.ops.len ||
           secondInput < 0 || secondInput >= bodyIR.ops.len ||
           firstInput == secondInput:
            return false
        if !exactdefmerge.ExactDefMergeBorrowRootsIdenticalForIdentity(
               bodyIR.ops[firstInput], bodyIR.ops[secondInput]):
            return false
        if bodyIR.ops[firstInput].valueDefBorrowOwnerDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag:
            return false
        definition =
            bodyIR.ops[firstInput].valueDefBorrowOwnerDefinitionRow
    if bodyIR.exactDef.opPlaceKinds[definition] !=
           exactdef.BodyIrExactDefPlaceParamTag ||
       bodyIR.ops[definition].valueDefOwnership !=
           coreir.OwnBorrowShared ||
       bodyIR.exactDef.opProducerFunctionRows[definition] !=
           bodyIR.controlFunctionRow:
        return false
    if !exactDefIdentityParamDefinitionEdgeValid(bodyIR, definition):
        return false
    let slot = bodyIR.ops[definition].valueDefSlot
    let exactType = bodyIR.exactDef.opExactTypeIds[definition]
    if slot < 0 || slot >= bodyIR.localSlots.len || exactType < 0:
        return false
    let local = bodyIR.localSlots[slot]
    if local.typeArenaTypeId != exactType:
        return false
    if exactDefIdentityTypeFactStructuralKind(bodyIR, exactType) !=
           Int32(typearena.TypedExprStructuralTypeRefObject):
        return false
    if local.sizeBytes != 8:
        return false
    return bodyIR.exactDef.slotStorageKinds[slot] ==
               exactdef.BodyIrExactDefStorageObjectTag

# cold_exact_ownership_view_matches (C 67533-67542) 逐字。
fn exactDefIdentityOwnershipViewMatches(candidate: int32,
                                        ownership: int32): bool =
    if candidate == ownership:
        return true
    if ownership == Int32(coreir.OwnBorrowShared) ||
       ownership == Int32(coreir.OwnBorrowUnique):
        return candidate == Int32(coreir.OwnBorrowShared) ||
               candidate == Int32(coreir.OwnBorrowUnique)
    return false


# ---- 活性/liveness 车道 ----

# cold_exact_definition_is_live_before_op_uncached (C 55968-56043) 的
# Cheng 版: 同块半开区间快道 (names_candidate+consumes+owned_slot_overwrite
# 与批 2 谓词同源) + 全体 dataflow 点前查询 (sparse/first-consume 缓存
# 不移植 — 批 2 同裁定)。memo/facts 缓存无 (性能缓存, 语义不变)。
@borrows
fn exactDefIdentityIsLiveBeforeOp(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        definition: int32,
        consumer: int32): bool =
    # 批 5 起单实现迁入 freeze (ExactDefFreezeAuthorityIsLiveBeforeOp,
    # 同上同款裁定) — 本 fn 为委托别名, 谓词零改动。
    return freeze.ExactDefFreezeAuthorityIsLiveBeforeOp(
        bodyIR, dom, workspace, limits, definition, consumer)

# cold_exact_borrow_parent_live_before_projection (C 60362-60722) 的
# Cheng 版。与批 2 前向纪元 walker 同支配缓存/按位或 join 纪律, 状态机
# 是借用双值 (UNDEFINED/LIVE): definition 置 LIVE, 同槽他定义置
# UNDEFINED, 投影点须纯 LIVE。两条容量哨兵逐字 (C 60532/60579)。
@borrows
fn exactDefIdentityBorrowParentLiveBeforeProjection(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        definition: int32,
        projection: int32): bool =
    # 前置全字段 (C 60366-60403)。
    if definition < 0 || definition >= bodyIR.ops.len ||
       projection < 0 || projection >= bodyIR.ops.len:
        return false
    let projectionOp = bodyIR.ops[projection]
    if bodyIR.exactDef.opOriginIds[projection] != definition ||
       bodyIR.exactDef.opPlaceKinds[projection] !=
           exactdef.BodyIrExactDefPlaceBorrowProjectionTag:
        return false
    if projectionOp.valueDefOwnership != coreir.OwnBorrowShared &&
       projectionOp.valueDefOwnership != coreir.OwnBorrowUnique:
        return false
    if freeze.ExactDefFreezeIdentityOpSourceDefRow(projectionOp) != -1:
        return false
    let definitionOp = bodyIR.ops[definition]
    if definitionOp.valueDefOwnership != coreir.OwnBorrowShared &&
       definitionOp.valueDefOwnership != coreir.OwnBorrowUnique:
        return false
    # 槽证明 (C 60408-60469): exact_global_definition 的 Cheng 载体 =
    # GlobalLoad+GLOBAL (GLOBAL_ADDR 的 Cheng 对应物); recorded storage
    # 与派生双 UNKNOWN 才拒 — derive 对托管定义槽 UNKNOWN 即 panic,
    # 派生道在冻结层无证据窗, 双 UNKNOWN 析取塌缩为 recorded!=UNKNOWN
    # (上游不变式, 注释锚定)。
    let exactGlobalDefinition =
        definitionOp.kind == coreir.BodyOpGlobalLoadTag &&
        bodyIR.exactDef.opPlaceKinds[definition] ==
            exactdef.BodyIrExactDefPlaceGlobalTag
    let slot = definitionOp.valueDefSlot
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return false
    let operand = exactDefIdentityOpOperandOrInvalid(projectionOp, 0)
    if operand != slot:
        # var_projection_base_matches_parent 直等臂 (C 61041-61043);
        # FIELD_REF 两条跳臂 (C 61049-61103) 无 Cheng 载体 → 真空。
        return false
    let definitionType = bodyIR.exactDef.opExactTypeIds[definition]
    if (definitionType < 0 && !exactGlobalDefinition) ||
       bodyIR.exactDef.opProducerFunctionRows[definition] !=
           bodyIR.controlFunctionRow:
        return false
    let local = bodyIR.localSlots[slot]
    if local.typeArenaTypeId != definitionType && !exactGlobalDefinition:
        return false
    if bodyIR.exactDef.slotStorageKinds[slot] ==
           exactdef.BodyIrExactDefStorageUnknownTag &&
       !exactGlobalDefinition:
        return false
    # 同块半开区间 (C 60479-60491)。
    let projectionBlock = workspace.opBlockIds[projection]
    let definitionBlock = workspace.opBlockIds[definition]
    if definitionBlock >= 0 && definitionBlock == projectionBlock &&
       definition < projection:
        for op in definition + 1..<projection:
            if bodyIR.ops[op].valueDefSlot == slot &&
               bodyIR.exactDef.opPlaceKinds[op] !=
                   exactdef.BodyIrExactDefPlaceInvalidTag:
                return false
        return true
    # current 门 (C 60492-60506)。
    if !freeze.ExactDefFreezeIdentityIsCurrentAtConsumer(
           bodyIR, dom, workspace.opBlockIds, definition, projection):
        return false
    # 无块线性道 (C 60507-60520)。
    if bodyIR.blocks.len <= 0:
        var state = freeze.ExactDefFreezeStateUndefinedTag
        for op in 0..<projection:
            if op == definition:
                state = freeze.ExactDefFreezeStateLiveTag
            elif bodyIR.ops[op].valueDefSlot == slot &&
                 bodyIR.exactDef.opPlaceKinds[op] !=
                     exactdef.BodyIrExactDefPlaceInvalidTag:
                state = freeze.ExactDefFreezeStateUndefinedTag
        return state == freeze.ExactDefFreezeStateLiveTag
    if projectionBlock < 0 || projectionBlock >= bodyIR.blocks.len:
        return false
    # 逆 relevant 切片 (C 60560-60585); 块 0 不可达 = valid=false
    # (静默 — 本车道不发 query-unreachable 判词, 与 C 同)。
    if !dom.reachable[projectionBlock]:
        return false
    let blockCount = bodyIR.blocks.len
    var relevant: bool[]
    setLen(relevant, blockCount)
    var relevantQueue: int32[]
    setLen(relevantQueue, blockCount)
    var relevantHead: int32
    var relevantTail: int32 = 1
    relevant[projectionBlock] = true
    relevantQueue[0] = projectionBlock
    var valid = true
    while relevantHead < relevantTail && valid:
        let successor = relevantQueue[relevantHead]
        relevantHead = relevantHead + 1
        let edgeStart = dom.predOffsets[successor]
        let edgeEnd = dom.predOffsets[successor + 1]
        if edgeStart < 0 || edgeEnd < edgeStart ||
           edgeEnd > dom.edgeCount:
            valid = false
            break
        for edge in edgeStart..<edgeEnd:
            let predecessor = dom.predecessors[edge]
            if predecessor < 0 || predecessor >= blockCount ||
               relevant[predecessor]:
                continue
            if relevantTail >= blockCount:
                exactDefIdentityDie(
                    "borrow projection reverse queue overflow")
            relevant[predecessor] = true
            relevantQueue[relevantTail] = predecessor
            relevantTail = relevantTail + 1
    valid = valid && relevant[0]
    # 前向纪元 walker (C 60586-60701): 容量哨兵 3B+1 同阈值;
    # flow 溢出 = valid=false 静默 (C 60692-60694)。
    if blockCount > 715827882:
        exactDefIdentityDie("borrow projection work queue size overflow")
    var entryStates: int32[]
    setLen(entryStates, blockCount)
    var flowQueued: bool[]
    setLen(flowQueued, blockCount)
    var flowQueue: int32[]
    setLen(flowQueue, blockCount * 3 + 1)
    var querySeen = false
    var queryState: int32
    entryStates[0] = freeze.ExactDefFreezeStateUndefinedTag
    var flowHead: int32
    var flowTail: int32 = 1
    flowQueue[0] = 0
    flowQueued[0] = true
    while flowHead < flowTail && valid:
        let block = flowQueue[flowHead]
        flowHead = flowHead + 1
        flowQueued[block] = false
        if !relevant[block]:
            valid = false
            break
        var state = entryStates[block]
        if state == 0:
            valid = false
            break
        let start = bodyIR.blocks[block].opStart
        let count = bodyIR.blocks[block].opCount
        if start < 0 || count < 0 ||
           start > bodyIR.ops.len - count:
            valid = false
            break
        var stop = start + count
        if block == projectionBlock:
            if projection < start || projection >= stop:
                valid = false
                break
            stop = projection
        for op in start..<stop:
            if op == definition:
                state = freeze.ExactDefFreezeStateLiveTag
            elif bodyIR.ops[op].valueDefSlot == slot &&
                 bodyIR.exactDef.opPlaceKinds[op] !=
                     exactdef.BodyIrExactDefPlaceInvalidTag:
                state = freeze.ExactDefFreezeStateUndefinedTag
        if block == projectionBlock:
            queryState = queryState | state
            querySeen = true
            continue
        let termIndex = bodyIR.blocks[block].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        for edge in 0..<successorCount:
            let successor =
                bodyIR.successorBlockIds[successorStart + edge]
            if successor < 0 || successor >= blockCount:
                continue
            if !relevant[successor]:
                continue
            let joined = entryStates[successor] | state
            if joined != entryStates[successor]:
                entryStates[successor] = joined
                if !flowQueued[successor]:
                    if flowTail >= flowQueue.len:
                        valid = false
                        break
                    flowQueued[successor] = true
                    flowQueue[flowTail] = successor
                    flowTail = flowTail + 1
    return valid && querySeen &&
           queryState == freeze.ExactDefFreezeStateLiveTag

# cold_exact_projection_parent_live_before_op (C 60724-60832) 的 Cheng
# 版 — parent_live 双车道:
#   父借用 → 借用前向纪元 walker (上);
#   父 PLAIN/MOVE → is_live_before_op, 失则兜底① staging copy 槽约定
#     (帧自有共享 helper, oxa_cap 双证); 兜底② MV 行即槽头 — MV place
#     无 Cheng 载体 → 真空; 兜底③ CFG_MERGE 自根+头链爬升 (沿 source/
#     origin 严格下降 ≤64 跳) — 批 4 锚点, 真空 (注释)。
@borrows
fn exactDefIdentityProjectionParentLiveBeforeOp(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        definition: int32,
        projection: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len:
        return false
    let ownership = bodyIR.ops[definition].valueDefOwnership
    if ownership == coreir.OwnBorrowShared ||
       ownership == coreir.OwnBorrowUnique:
        return exactDefIdentityBorrowParentLiveBeforeProjection(
            bodyIR, dom, workspace, definition, projection)
    if ownership == coreir.OwnPlain || ownership == coreir.OwnMove:
        if exactDefIdentityIsLiveBeforeOp(
               bodyIR, dom, workspace, limits, definition, projection):
            return true
        let projectionBlock = workspace.opBlockIds[projection]
        if projectionBlock < 0:
            return false
        let oxaCap = freeze.ExactDefFreezeIdentityIsCurrentAtPredecessor(
            bodyIR, dom, workspace.opBlockIds, definition,
            projectionBlock, projection)
        if oxaCap &&
           ExactDefIdentityDefinitionRootsFrameOwnedSlot(
               bodyIR, definition):
            return true
        # 兜底② MV 行即槽头: MV place 无 Cheng 载体 → 真空 (批 5 锚)。
        # 兜底③ (批 4 落地; C 60834-60839 逐字): CFG_MERGE 自根 +
        # 头链爬升 — 槽头沿 source (无则 origin) 严格下降 ≤64 跳爬到
        # definition, 且支配当代性证明其在投影点为 current。
        let oxaSlot = bodyIR.ops[definition].valueDefSlot
        var oxaHead: int32 = -1
        if oxaSlot >= 0 && oxaSlot < bodyIR.localSlots.len:
            oxaHead = bodyIR.exactDef.slotOriginIds[oxaSlot]
        var oxaWalk = oxaHead
        var oxaHops: int32
        while oxaWalk != definition && oxaWalk >= 0 &&
              oxaWalk < bodyIR.ops.len && oxaHops < 64:
            var oxaNext = bodyIR.exactDef.opSourceDefOpRows[oxaWalk]
            if oxaNext < 0:
                oxaNext = bodyIR.exactDef.opOriginIds[oxaWalk]
            if oxaNext < 0 || oxaNext >= oxaWalk:
                break
            oxaWalk = oxaNext
            oxaHops = oxaHops + 1
        return bodyIR.exactDef.opPlaceKinds[definition] ==
                   exactdef.BodyIrExactDefPlaceCfgMergeTag &&
               bodyIR.exactDef.opOriginIds[definition] == definition &&
               oxaWalk == definition && oxaCap
    return false

# ---- 槽终校验 (规格 §4; cold_exact_identity_view_slot_terminal_valid
#      C 67557-67586 的 Cheng 版) ----
#
# 写者集 (Cheng writes_dst_slot schema): 凡物理写 operand_slot 的 op —
#   (a) def 写: valueDefSlot==operand_slot && own!=OwnInvalid
#       (LoadConst/LoadLocal/CopyLocal/Call/FieldLoad/IndexedLoad/
#        ResultProject/GlobalLoad/StoreLocal 等定义行的物理写即其定义);
#   (b) store 族写: kind∈{StoreLocal,CopyLocal,FieldStore,IndexedStore,
#       GlobalStore} && target==operand_slot (无论是否带 def 戳)。
# 逐写者: ①value-def 侧车在 (valueDefSlot>=0); ②place!=INVALID;
#   ③source exactType>=0 时 exactType 相等; ④ownViewMatches(own,
#   ownership)。全部写者过关后, 至少一个写者 reaches(op,consumer)。
@borrows
fn exactDefIdentityIdentityViewSlotTerminalValid(
        bodyIR: coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        opBlockIds: int32[],
        consumer: int32,
        operandSlot: int32,
        ownership: int32,
        exactTypeId: int32): bool =
    if consumer < 0 || consumer >= bodyIR.ops.len ||
       operandSlot < 0 || operandSlot >= bodyIR.localSlots.len:
        return false
    var dominating = false
    for op in 0..<bodyIR.ops.len:
        if op == consumer:
            continue
        let bodyOp = bodyIR.ops[op]
        # def 写: valueDefSlot==operand_slot (C 的 op_dst==operand_slot
        # && writes_dst_slot 对应物 — 定义行的物理写即其定义, 与 own
        # 值无关; own==INVALID 行由子句④ ownViewMatches 接住)。
        let defWrite = bodyOp.valueDefSlot == operandSlot
        var storeWrite = bodyOp.target == operandSlot &&
            (bodyOp.kind == coreir.BodyOpStoreLocalTag ||
             bodyOp.kind == coreir.BodyOpCopyLocalTag ||
             bodyOp.kind == coreir.BodyOpFieldStoreTag ||
             bodyOp.kind == coreir.BodyOpIndexedStoreTag ||
             bodyOp.kind == coreir.BodyOpGlobalStoreTag)
        if !defWrite && !storeWrite:
            continue
        if bodyOp.valueDefSlot < 0 ||
           bodyIR.exactDef.opPlaceKinds[op] ==
               exactdef.BodyIrExactDefPlaceInvalidTag:
            return false
        if exactTypeId >= 0 &&
           bodyIR.exactDef.opExactTypeIds[op] != exactTypeId:
            return false
        if !exactDefIdentityOwnershipViewMatches(
               Int32(bodyOp.valueDefOwnership), ownership):
            return false
        if freeze.ExactDefFreezeIdentityReaches(
               bodyIR, dom, opBlockIds, op, consumer):
            dominating = true
    return dominating

# ---- 分解/取字段形状 ----

# cold_exact_owned_object_field_projection_shape (C 52465-52546, 规格
# §6.4) 的 Cheng 版: PAYLOAD_LOAD → FieldLoad (operands=[base, field,
# offset, width]); b≤size-c → offset<=parent.size-width; child size==c →
# child.sizeBytes==width; child place/origin = 槽车道 (Cheng 侧车)。
@borrows
fn exactDefIdentityOwnedObjectFieldProjectionShape(
        bodyIR: coreir.BodyIR,
        opBlockIds: int32[],
        definition: int32,
        projection: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len ||
       projection <= definition || projection >= bodyIR.ops.len:
        return false
    let definitionOp = bodyIR.ops[definition]
    let sourceSlot = definitionOp.valueDefSlot
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        return false
    let sourceLocal = bodyIR.localSlots[sourceSlot]
    if sourceLocal.typeKind != coreir.LocalAggregateTag ||
       sourceLocal.sizeBytes <= 0 ||
       bodyIR.exactDef.slotStorageKinds[sourceSlot] !=
           exactdef.BodyIrExactDefStorageObjectTag:
        return false
    let definitionType = bodyIR.exactDef.opExactTypeIds[definition]
    if definitionType < 0 ||
       exactDefIdentityTypeFactStructuralKind(bodyIR, definitionType) !=
           Int32(typearena.TypedExprStructuralTypeObject):
        return false
    if bodyIR.exactDef.opPlaceKinds[definition] !=
           exactdef.BodyIrExactDefPlaceStackLocalTag ||
       definitionOp.valueDefOwnership != coreir.OwnMove:
        return false
    let consumePlusOne = definitionOp.valueDefConsumeOpIndexPlusOne
    let final = consumePlusOne - 1
    if consumePlusOne <= 0 || consumePlusOne > bodyIR.ops.len ||
       projection > final:
        return false
    let projectionOp = bodyIR.ops[projection]
    let child = projectionOp.target
    if child < 0 || child >= bodyIR.localSlots.len ||
       projectionOp.kind != coreir.BodyOpFieldLoadTag ||
       projectionOp.operands.len != 4:
        return false
    let fieldOffset = projectionOp.operands[2]
    let fieldWidth = projectionOp.operands[3]
    let childLocal = bodyIR.localSlots[child]
    if projectionOp.operands[0] != sourceSlot || fieldOffset < 0 ||
       fieldWidth <= 0 ||
       fieldOffset > sourceLocal.sizeBytes - fieldWidth ||
       childLocal.sizeBytes != fieldWidth:
        return false
    if bodyIR.exactDef.slotStorageKinds[child] ==
           exactdef.BodyIrExactDefStorageUnknownTag ||
       bodyIR.exactDef.slotStorageKinds[child] ==
           exactdef.BodyIrExactDefStoragePlainTag:
        return false
    if childLocal.typeArenaTypeId !=
           bodyIR.exactDef.opExactTypeIds[projection] ||
       bodyIR.exactDef.slotPlaceKinds[child] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       bodyIR.exactDef.slotOriginIds[child] != projection:
        return false
    if projectionOp.valueDefSlot != child ||
       bodyIR.exactDef.opExactTypeIds[projection] < 0 ||
       bodyIR.exactDef.opProducerFunctionRows[projection] !=
           bodyIR.controlFunctionRow ||
       bodyIR.exactDef.opPlaceKinds[projection] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       projectionOp.valueDefOwnership != coreir.OwnMove ||
       bodyIR.exactDef.opOriginIds[projection] != projection ||
       freeze.ExactDefFreezeIdentityOpSourceDefRow(projectionOp) !=
           definition:
        return false
    if projection != final:
        let finalOp = bodyIR.ops[final]
        let finalChild = finalOp.valueDefSlot
        if opBlockIds[final] != opBlockIds[projection] ||
           finalOp.kind != coreir.BodyOpFieldLoadTag ||
           finalOp.operands.len != 4 ||
           finalOp.operands[0] != sourceSlot ||
           freeze.ExactDefFreezeIdentityOpSourceDefRow(finalOp) !=
               definition ||
           finalChild < 0 || finalChild >= bodyIR.localSlots.len ||
           bodyIR.exactDef.slotPlaceKinds[finalChild] !=
               exactdef.BodyIrExactDefPlaceTemporaryTag ||
           finalOp.valueDefOwnership != coreir.OwnMove:
            return false
    return true

# cold_exact_owned_ref_object_field_projection_shape (C 52551-52620,
# 规格 §6.5) 的 Cheng 版: source_slot kind∈{PTR,OBJECT_REF,OPAQUE_REF}
# → LocalPtrTag + typeFact RefObject 联合; release_call = consume-1>
# projection 且 CALL_I32 且 source 列==definition 且 def_slot==-1 →
# Cheng drop-glue Call 行 (valueDefSlot<0); b+c 防溢出同式。
@borrows
fn exactDefIdentityOwnedRefObjectFieldProjectionShape(
        bodyIR: coreir.BodyIR,
        opBlockIds: int32[],
        definition: int32,
        projection: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len ||
       projection <= definition || projection >= bodyIR.ops.len:
        return false
    let definitionOp = bodyIR.ops[definition]
    let sourceSlot = definitionOp.valueDefSlot
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        return false
    let sourceLocal = bodyIR.localSlots[sourceSlot]
    if sourceLocal.typeKind != coreir.LocalPtrTag ||
       sourceLocal.sizeBytes != 8 ||
       bodyIR.exactDef.slotStorageKinds[sourceSlot] !=
           exactdef.BodyIrExactDefStorageObjectTag:
        return false
    let definitionType = bodyIR.exactDef.opExactTypeIds[definition]
    if definitionType < 0 ||
       exactDefIdentityTypeFactStructuralKind(bodyIR, definitionType) !=
           Int32(typearena.TypedExprStructuralTypeRefObject):
        return false
    if bodyIR.exactDef.opPlaceKinds[definition] !=
           exactdef.BodyIrExactDefPlaceStackLocalTag ||
       definitionOp.valueDefOwnership != coreir.OwnMove:
        return false
    let consumePlusOne = definitionOp.valueDefConsumeOpIndexPlusOne
    let releaseCall = consumePlusOne - 1
    if releaseCall <= projection || releaseCall >= bodyIR.ops.len:
        return false
    let releaseOp = bodyIR.ops[releaseCall]
    if releaseOp.kind != coreir.BodyOpCallTag ||
       freeze.ExactDefFreezeIdentityOpSourceDefRow(releaseOp) !=
           definition ||
       releaseOp.valueDefSlot >= 0:
        return false
    let projectionOp = bodyIR.ops[projection]
    let child = projectionOp.target
    if child < 0 || child >= bodyIR.localSlots.len ||
       projectionOp.kind != coreir.BodyOpFieldLoadTag ||
       projectionOp.operands.len != 4:
        return false
    let fieldOffset = projectionOp.operands[2]
    let fieldWidth = projectionOp.operands[3]
    let childLocal = bodyIR.localSlots[child]
    if projectionOp.operands[0] != sourceSlot || fieldOffset < 0 ||
       fieldWidth <= 0 ||
       fieldOffset > 2147483647 - fieldWidth ||
       fieldOffset > sourceLocal.sizeBytes - fieldWidth ||
       childLocal.sizeBytes != fieldWidth:
        return false
    if bodyIR.exactDef.slotStorageKinds[child] ==
           exactdef.BodyIrExactDefStorageUnknownTag ||
       bodyIR.exactDef.slotStorageKinds[child] ==
           exactdef.BodyIrExactDefStoragePlainTag:
        return false
    if childLocal.typeArenaTypeId !=
           bodyIR.exactDef.opExactTypeIds[projection] ||
       bodyIR.exactDef.slotPlaceKinds[child] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       bodyIR.exactDef.slotOriginIds[child] != projection:
        return false
    if projectionOp.valueDefSlot != child ||
       bodyIR.exactDef.opExactTypeIds[projection] < 0 ||
       bodyIR.exactDef.opProducerFunctionRows[projection] !=
           bodyIR.controlFunctionRow ||
       bodyIR.exactDef.opPlaceKinds[projection] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       projectionOp.valueDefOwnership != coreir.OwnMove ||
       bodyIR.exactDef.opOriginIds[projection] != projection ||
       freeze.ExactDefFreezeIdentityOpSourceDefRow(projectionOp) !=
           definition:
        return false
    return true

# cold_exact_owned_plain_field_take_valid (C 65848-65940) 的 Cheng 版:
# PAYLOAD_LOAD → FieldLoad; 父链 = readA 读边 (批 2 完成器列); C 的
# layout identity/generic scope 尾段 (65930+) 由 derive field-borrow
# 逐跳证明放电 (上游不变式, 注释锚定 — 投影 hop 已在落戳时逐跳核对)。
@borrows
fn exactDefIdentityOwnedPlainFieldTakeValid(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        projection: int32): bool =
    if projection < 0 || projection >= bodyIR.ops.len:
        return false
    let projectionOp = bodyIR.ops[projection]
    if projectionOp.kind != coreir.BodyOpFieldLoadTag ||
       freeze.ExactDefFreezeIdentityOpSourceDefRow(projectionOp) != -1:
        return false
    let parent = bodyIR.exactDef.opReadADefOpRows[projection]
    if parent < 0 || parent >= projection:
        return false
    let parentOp = bodyIR.ops[parent]
    let parentSlot = parentOp.valueDefSlot
    let childSlot = projectionOp.target
    if parentSlot < 0 || parentSlot >= bodyIR.localSlots.len ||
       childSlot < 0 || childSlot >= bodyIR.localSlots.len:
        return false
    let parentLocal = bodyIR.localSlots[parentSlot]
    let childLocal = bodyIR.localSlots[childSlot]
    if projectionOp.operands.len != 4 ||
       projectionOp.operands[0] != parentSlot:
        return false
    if parentLocal.typeKind != coreir.LocalAggregateTag:
        return false
    let parentStorage = bodyIR.exactDef.slotStorageKinds[parentSlot]
    if parentStorage != exactdef.BodyIrExactDefStorageObjectTag &&
       parentStorage != exactdef.BodyIrExactDefStoragePlainTag:
        return false
    if bodyIR.exactDef.opExactTypeIds[parent] < 0 ||
       bodyIR.exactDef.opProducerFunctionRows[parent] !=
           bodyIR.controlFunctionRow ||
       parentOp.valueDefOwnership != coreir.OwnMove:
        return false
    if !exactDefIdentityIsLiveBeforeOp(
           bodyIR, dom, workspace, limits, parent, projection):
        return false
    if projectionOp.valueDefSlot != childSlot ||
       bodyIR.exactDef.opExactTypeIds[projection] < 0 ||
       bodyIR.exactDef.opProducerFunctionRows[projection] !=
           bodyIR.controlFunctionRow ||
       bodyIR.exactDef.opPlaceKinds[projection] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       projectionOp.valueDefOwnership != coreir.OwnMove ||
       bodyIR.exactDef.opOriginIds[projection] != projection ||
       bodyIR.exactDef.slotPlaceKinds[childSlot] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       bodyIR.exactDef.slotOriginIds[childSlot] != projection ||
       childLocal.typeArenaTypeId !=
           bodyIR.exactDef.opExactTypeIds[projection] ||
       bodyIR.exactDef.slotStorageKinds[childSlot] !=
           exactdef.BodyIrExactDefStoragePlainTag:
        return false
    if exactDefIdentityPlainValueCopyIndependent(bodyIR, childSlot):
        return false
    let consume = projectionOp.valueDefConsumeOpIndexPlusOne - 1
    if consume < 0:
        for op in projection + 1..<bodyIR.ops.len:
            if freeze.ExactDefFreezeIdentityOpConsumesDefinition(
                   bodyIR, projection, op):
                return false
    else:
        if consume <= projection || consume >= bodyIR.ops.len:
            return false
        let summary = freeze.ExactDefFreezeIdentityConsumerSummaryBuild(
            bodyIR, projection)
        if summary.count != 1 || summary.first != consume ||
           summary.terminalCount != 0:
            return false
    return true


# ---- place 臂 (主审分派, C 68427-69391) ----

# TEMPORARY 臂 (C 68427-68804)。真空臂清单 (C op-kind 载体无 Cheng
# 对应行, 判词不移植, 注释锚定): ABI pointer static string value tuple
# (68428-68450) / opaque sequence take tuple+continue (68451-68469) /
# global scalar read value tuple (68470-68493) / scalar ref read value
# tuple (68494-68517) / address_bearing_plain_allocation (68539-68549,
# BYTES_ALLOC 无载体) / int32/str/opaque sequence literal tuple 三连
# (68760-68804, MAKE_SEQ_* 无载体)。
@borrows
fn exactDefIdentityTemporaryDefinitionValid(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        phase: str,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let storage = bodyIR.exactDef.slotStorageKinds[slot]
    let exactType = bodyIR.exactDef.opExactTypeIds[i]
    let origin = bodyIR.exactDef.opOriginIds[i]
    let source = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
    let consumePlusOne = op.valueDefConsumeOpIndexPlusOne
    let operand = exactDefIdentityOpOperandOrInvalid(op, 0)
    let borrowedTemporary = ownership == Int32(coreir.OwnBorrowShared) ||
        ownership == Int32(coreir.OwnBorrowUnique)
    # address_bearing_plain_value (C 68521-68526): PLAIN storage +
    # SLOT_OBJECT + 非独立; Cheng: LocalAggregateTag + Object structural。
    let addressBearingPlainValue =
        storage == exactdef.BodyIrExactDefStoragePlainTag &&
        bodyIR.localSlots[slot].typeKind == coreir.LocalAggregateTag &&
        exactDefIdentityTypeFactStructuralKind(
            bodyIR, bodyIR.localSlots[slot].typeArenaTypeId) ==
            Int32(typearena.TypedExprStructuralTypeObject) &&
        !exactDefIdentityPlainValueCopyIndependent(bodyIR, slot)
    # address_bearing_plain_call (C 68527-68538): callee OWNED 摘要的
    # Cheng 权威 = CallOp.resultOwnership (lowering 冻结的逐调用结果
    # 权威, 与 callee 摘要同证据类)。
    var addressBearingPlainCall = false
    if addressBearingPlainValue &&
       ownership == Int32(coreir.OwnMove) &&
       op.kind == coreir.BodyOpCallTag && op.operands.len == 1:
        let callRow = op.operands[0]
        if callRow >= 0 && callRow < bodyIR.callSequence.len:
            addressBearingPlainCall =
                bodyIR.callSequence[callRow].resultOwnership ==
                    coreir.OwnMove
    let addressBearingPlainFieldTake =
        exactDefIdentityOwnedPlainFieldTakeValid(
            bodyIR, dom, workspace, limits, i)
    var ownershipMatchesStorage =
        (storage == exactdef.BodyIrExactDefStoragePlainTag &&
         ownership == Int32(coreir.OwnPlain)) ||
        addressBearingPlainCall || addressBearingPlainFieldTake ||
        (storage != exactdef.BodyIrExactDefStoragePlainTag &&
         ownership == Int32(coreir.OwnMove)) ||
        (borrowedTemporary &&
         exactDefIdentityBorrowResultRootValid(bodyIR, i))
    # source 六通道 (C 68564-68683)。
    var producerConsume = false
    if source >= 0 && source < bodyIR.ops.len:
        let sourceOp = bodyIR.ops[source]
        producerConsume = freeze.ExactDefFreezeIdentityReaches(
            bodyIR, dom, workspace.opBlockIds, source, i) &&
            operand >= 0 && operand < bodyIR.localSlots.len &&
            sourceOp.valueDefSlot == operand &&
            bodyIR.exactDef.opExactTypeIds[source] == exactType &&
            bodyIR.exactDef.opProducerFunctionRows[source] ==
                bodyIR.controlFunctionRow &&
            (sourceOp.valueDefOwnership == coreir.OwnMove ||
             sourceOp.valueDefOwnership == coreir.OwnPlain) &&
            sourceOp.valueDefConsumeOpIndexPlusOne > 0
    let objectFieldDecomposition = source >= 0 &&
        exactDefIdentityOwnedObjectFieldProjectionShape(
            bodyIR, workspace.opBlockIds, source, i)
    var refObjectFieldDecomposition = false
    if !objectFieldDecomposition && source >= 0:
        refObjectFieldDecomposition =
            exactDefIdentityOwnedRefObjectFieldProjectionShape(
                bodyIR, workspace.opBlockIds, source, i) ||
            exactDefIdentityOwnedRefObjectDerefMaterializeShape(
                bodyIR, dom, workspace, limits, source, i)
    # borrowed_source_edge (C 68616-68640): kind∈{MAKE_COMPOSITE,
    # STR_SLICE,CALL_I32,CALL_COMPOSITE} → Cheng 统一 Call; source 三证
    # 的 Cheng 冻结权威 (借用根/owner 根/共享投影边, 见 helper 注释)。
    var borrowedSourceEdge = false
    if borrowedTemporary && op.kind == coreir.BodyOpCallTag &&
       source >= 0 && source < bodyIR.ops.len &&
       freeze.ExactDefFreezeIdentityReaches(
           bodyIR, dom, workspace.opBlockIds, source, i):
        borrowedSourceEdge =
            exactDefIdentityBorrowResultRootValid(bodyIR, source) ||
            exactDefIdentityBorrowOwnerRootValid(bodyIR, source) ||
            exactDefIdentitySharedProjectionEdgeValid(bodyIR, source)
    if borrowedSourceEdge:
        ownershipMatchesStorage = true
    # borrowed_plain_snapshot_temp (C 68646-68666): plain_copy_tuple_valid
    # 要求 place[copy]==STACK_LOCAL — 对 TEMPORARY 行恒假 (C 同形保持)。
    var borrowedPlainSnapshotTemp = false
    if source >= 0 && source < bodyIR.ops.len &&
       exactDefIdentityPlainCopyTupleValid(bodyIR, dom, workspace.opBlockIds, source, i):
        let sourceSlot = bodyIR.ops[source].valueDefSlot
        let sourcePlace = bodyIR.exactDef.opPlaceKinds[source]
        borrowedPlainSnapshotTemp =
            bodyIR.ops[source].valueDefOwnership ==
                coreir.OwnBorrowShared &&
            (sourcePlace ==
                 exactdef.BodyIrExactDefPlaceBorrowProjectionTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceSharedCopyTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceTemporaryTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceStackLocalTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceParamTag) &&
            sourceSlot >= 0 && sourceSlot < bodyIR.localSlots.len &&
            bodyIR.exactDef.slotStorageKinds[sourceSlot] ==
                exactdef.BodyIrExactDefStoragePlainTag &&
            exactDefIdentityBorrowResultRootValid(bodyIR, source)
    # plain_static_string_temp_snapshot (C 68672-68683):
    # COPY_COMPOSITE → CopyLocal。
    var plainStaticStringTempSnapshot = false
    if source >= 0 && source < bodyIR.ops.len &&
       op.kind == coreir.BodyOpCopyLocalTag &&
       ownership == Int32(coreir.OwnMove) && op.operands.len == 1 &&
       operand == bodyIR.ops[source].valueDefSlot &&
       bodyIR.exactDef.opExactTypeIds[source] == exactType:
        plainStaticStringTempSnapshot =
            exactDefIdentityPlainStaticStringDefinitionValid(
                bodyIR, source)
    # wall87b 通道⑦ (snapshot_read_edge, w86 提案): exit-return snapshot
    # call 的 source 边是 retain/clone 读依赖, 非 move-out — 与 wall81
    # freeze 侧豁免 (exactDefFreezeOpConsumesDefinition 的 snapshot-read
    # 臂, :581) 同一谓词同一身份列 (ExactDefFreezeCallSnapshotReadKind,
    # operands[0]=callSequence 行 managedStoreKind ∈ {SNAPSHOT_RETAIN,
    # CLONE}, 经 cleanup_cfg:758-761 runtime intrinsic authority 契约
    # 绑定该形状, 无启发式)。cleanup 物化契约: snapshot 时 source 未
    # 消费 (cleanup_cfg:11484 owned return source already consumed),
    # 物化后 source 由 drop unit 消费 (版本不结束), snapshot 结果由
    # 物化 RET term 终结消费 (cleanupCfgMaterializeExit: term 边 =
    # snapshot op 行) — source 边只是读依赖证据, 不产生消费。
    var snapshotReadEdge = false
    if op.kind == coreir.BodyOpCallTag && op.operands.len == 1:
        snapshotReadEdge = freeze.ExactDefFreezeCallSnapshotReadKind(
            bodyIR, i)
    # direct_call_result_matches_summary (C 68684-68722): callee 摘要
    # UNKNOWN → false 的 Cheng 权威 = CallOp.resultOwnership (冻结)。
    var directCallResultMatchesSummary = true
    if op.kind == coreir.BodyOpCallTag:
        var callValid = false
        if op.operands.len == 1:
            let callRow = op.operands[0]
            if callRow >= 0 && callRow < bodyIR.callSequence.len:
                let resultOwnership =
                    bodyIR.callSequence[callRow].resultOwnership
                callValid = resultOwnership != coreir.OwnInvalid &&
                    ((storage ==
                          exactdef.BodyIrExactDefStoragePlainTag &&
                      ownership == Int32(coreir.OwnPlain) &&
                      resultOwnership == coreir.OwnPlain) ||
                     (storage !=
                          exactdef.BodyIrExactDefStoragePlainTag &&
                      ownership == Int32(coreir.OwnMove) &&
                      resultOwnership == coreir.OwnMove) ||
                     (addressBearingPlainCall &&
                      resultOwnership == coreir.OwnMove) ||
                     (ownership == Int32(coreir.OwnBorrowShared) &&
                      resultOwnership == coreir.OwnBorrowShared))
        directCallResultMatchesSummary = callValid
    if !ownershipMatchesStorage || op.target != slot || origin != i ||
       (source != -1 && !producerConsume &&
        !objectFieldDecomposition && !refObjectFieldDecomposition &&
        !borrowedSourceEdge && !borrowedPlainSnapshotTemp &&
        !plainStaticStringTempSnapshot && !snapshotReadEdge) ||
       !directCallResultMatchesSummary || consumePlusOne < 0:
        var sourceSlot: int32 = -1
        var sourceConsume: int32 = -1
        var sourceType: int32 = -1
        if source >= 0 && source < i:
            sourceSlot = bodyIR.ops[source].valueDefSlot
            sourceConsume =
                bodyIR.ops[source].valueDefConsumeOpIndexPlusOne
            sourceType = bodyIR.exactDef.opExactTypeIds[source]
        exactDefIdentityVerdictEmit(
            exactDefIdentityTemporaryBrokenLine(
                phase, bodyIR.controlFunctionRow, i, source,
                exactDefIdentityBoolInt(producerConsume),
                exactDefIdentityBoolInt(objectFieldDecomposition),
                exactDefIdentityBoolInt(refObjectFieldDecomposition),
                exactDefIdentityBoolInt(borrowedSourceEdge),
                exactDefIdentityBoolInt(directCallResultMatchesSummary),
                operand, sourceSlot, sourceConsume, exactType,
                sourceType))
        return false
    return true

# 借用 owner 根 (cold_borrow_result_owner_root_valid 的 Cheng 冻结权威
# 裁定): owner 域 BodyOp 且 owner 行在界且是真实定义。
@borrows
fn exactDefIdentityBorrowOwnerRootValid(bodyIR: coreir.BodyIR,
                                        source: int32): bool =
    if source < 0 || source >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[source]
    if op.valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag:
        return false
    let owner = op.valueDefBorrowOwnerDefinitionRow
    return owner >= 0 && owner < bodyIR.ops.len &&
           bodyIR.ops[owner].valueDefSlot >= 0

# 共享投影边 (cold_exact_shared_projection_edge_valid 的 Cheng 冻结权威
# 裁定, cold_parser.c:20121-20223 的链重走由冻结 borrow-owner 列放电):
# source 是 BORROW_PROJECTION place 且借用根冻结权威在界。
@borrows
fn exactDefIdentitySharedProjectionEdgeValid(bodyIR: coreir.BodyIR,
                                             source: int32): bool =
    if source < 0 || source >= bodyIR.ops.len:
        return false
    if bodyIR.exactDef.opPlaceKinds[source] !=
           exactdef.BodyIrExactDefPlaceBorrowProjectionTag:
        return false
    return exactDefIdentityBorrowResultRootValid(bodyIR, source)

# 批 6 构造器 OBJECT_REF→OBJECT deref 物化形 (C :42095-42116 的
# PAYLOAD_LOAD 整值解引用+发布换装对应物; 规格 §7-3「构造器物化换
# 装必须保 def↔slot 一致」): ref 槽整值 deref 拷贝 (offset==0 且
# width==pointee 槽宽, 即整对象物化 — ref-object 分解道的整值特
# 例, TEMPORARY 臂 refObjectFieldDecomposition 标志位复用)。ref 源
# 权威 (PARAM/STACK_LOCAL/TEMPORARY + 借用或 owned + 定义前活性)
# 由批 3 既有车道分证; 解引用快照是 owned 值 (C 发布 MOVE 戳同),
# 不消费 ref 源 (借用读, source consume==0)。
@borrows
fn exactDefIdentityOwnedRefObjectDerefMaterializeShape(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        definition: int32,
        projection: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len ||
       projection <= definition || projection >= bodyIR.ops.len:
        return false
    let definitionOp = bodyIR.ops[definition]
    let sourceSlot = definitionOp.valueDefSlot
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        return false
    let definitionType = bodyIR.exactDef.opExactTypeIds[definition]
    if definitionType < 0 ||
       exactDefIdentityTypeFactStructuralKind(bodyIR, definitionType) !=
           Int32(typearena.TypedExprStructuralTypeRefObject):
        return false
    if bodyIR.exactDef.slotStorageKinds[sourceSlot] !=
           exactdef.BodyIrExactDefStorageObjectTag:
        return false
    let definitionPlace = bodyIR.exactDef.opPlaceKinds[definition]
    let definitionOwnership = Int32(definitionOp.valueDefOwnership)
    if (definitionPlace != exactdef.BodyIrExactDefPlaceParamTag &&
        definitionPlace != exactdef.BodyIrExactDefPlaceStackLocalTag &&
        definitionPlace != exactdef.BodyIrExactDefPlaceTemporaryTag) ||
       (definitionOwnership != Int32(coreir.OwnMove) &&
        definitionOwnership != Int32(coreir.OwnBorrowShared) &&
        definitionOwnership != Int32(coreir.OwnBorrowUnique)):
        return false
    if definitionOp.valueDefConsumeOpIndexPlusOne != 0:
        return false
    if !freeze.ExactDefFreezeIdentityReaches(
           bodyIR, dom, workspace.opBlockIds, definition, projection):
        return false
    if !exactDefIdentityIsLiveBeforeOp(
           bodyIR, dom, workspace, limits, definition, projection):
        return false
    let projectionOp = bodyIR.ops[projection]
    let child = projectionOp.target
    if child < 0 || child >= bodyIR.localSlots.len ||
       projectionOp.kind != coreir.BodyOpFieldLoadTag ||
       projectionOp.operands.len != 4:
        return false
    let childLocal = bodyIR.localSlots[child]
    # 整值 deref: offset==0 且 width==pointee 槽宽, 基槽即 ref 槽。
    if projectionOp.operands[0] != sourceSlot ||
       projectionOp.operands[2] != 0 ||
       projectionOp.operands[3] != childLocal.sizeBytes ||
       childLocal.sizeBytes <= 0:
        return false
    if bodyIR.exactDef.slotStorageKinds[child] !=
           exactdef.BodyIrExactDefStorageObjectTag:
        return false
    if childLocal.typeArenaTypeId !=
           bodyIR.exactDef.opExactTypeIds[projection] ||
       bodyIR.exactDef.slotPlaceKinds[child] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       bodyIR.exactDef.slotOriginIds[child] != projection:
        return false
    if projectionOp.valueDefSlot != child ||
       bodyIR.exactDef.opExactTypeIds[projection] < 0 ||
       bodyIR.exactDef.opProducerFunctionRows[projection] !=
           bodyIR.controlFunctionRow ||
       bodyIR.exactDef.opPlaceKinds[projection] !=
           exactdef.BodyIrExactDefPlaceTemporaryTag ||
       projectionOp.valueDefOwnership != coreir.OwnMove ||
       bodyIR.exactDef.opOriginIds[projection] != projection ||
       freeze.ExactDefFreezeIdentityOpSourceDefRow(projectionOp) !=
           definition:
        return false
    return true

# [wall125] 判词富化: STACK_LOCAL 绑定门 fail 即列该 op 行全列实况
# (BodyOp def 列 + exactDef sidecar 列 + 槽列 + 绑定载体三旗 + OpCall
# 的 callSequence 载体列; wall117c consume path 取数同款 — fail 路径
# 零频, 守卫零改动, 身份纪律 int32 列投影)。
@borrows
fn exactDefIdentityStackLocalBindFactsEmit(
        bodyIR: coreir.BodyIR,
        phase: str,
        i: int32,
        copyKind: bool,
        literalRoot: bool,
        plainUnmanagedCallRoot: bool,
        managedCallResultRoot: bool) =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let functionRow = bodyIR.controlFunctionRow
    var slotText: str
    if slot >= 0 && slot < bodyIR.localSlots.len:
        slotText = Fmt" slot_tk={Int32(bodyIR.localSlots[slot].typeKind)} slot_mg={Int32(bodyIR.localSlots[slot].managedStorageKind)} slot_tid={bodyIR.localSlots[slot].typeArenaTypeId}"
    var callText: str
    let callRow = exactDefIdentityOpOperandOrInvalid(op, 0)
    if op.kind == coreir.BodyOpCallTag && callRow >= 0 &&
       callRow < bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callRow]
        callText = Fmt" call={callRow} c_rs={call.resultSlot} c_rpk={Int32(call.resultPassKind)} c_ro={Int32(call.resultOwnership)} c_rex={call.resultExprNodeIndex} c_rvr={call.resultValueDefinitionRow} c_rbos={call.resultBorrowOwnerValueDefinitionRow} c_rbod={Int32(call.resultBorrowOwnerDefinitionDomain)} c_rbor={call.resultBorrowOwnerDefinitionRow} c_rok={call.resultDefinitionOriginKind} c_roi={call.resultDefinitionOriginId} c_msk={call.managedStoreKind} c_sdd={Int32(call.sourceDefinitionDomain)} c_sdr={call.sourceDefinitionRow} c_car={call.consumeActionRow}"
    exactDefIdentityVerdictEmit(
        Fmt"cheng_cold: exact stack local bind facts [{phase}] fn={functionRow} op={i} ops={bodyIR.ops.len} kind={op.kind} target={op.target} vds={slot} vdo={Int32(op.valueDefOwnership)} vsr={op.valueDefSemanticRow} vex={op.valueDefExprNodeIndex} vok={op.valueDefOriginKind} voi={op.valueDefOriginId} bos={op.valueDefBorrowOwnerSemanticRow} bod={Int32(op.valueDefBorrowOwnerDefinitionDomain)} bor={op.valueDefBorrowOwnerDefinitionRow} sdd={Int32(op.sourceDefinitionDomain)} sdr={op.sourceDefinitionRow} src={freeze.ExactDefFreezeIdentityOpSourceDefRow(op)} car={op.consumeActionRow} cp1={op.valueDefConsumeOpIndexPlusOne} a0={exactDefIdentityOpOperandOrInvalid(op, 0)} a1={exactDefIdentityOpOperandOrInvalid(op, 1)} a2={exactDefIdentityOpOperandOrInvalid(op, 2)} ed_place={bodyIR.exactDef.opPlaceKinds[i]} ed_origin={bodyIR.exactDef.opOriginIds[i]} ed_read={bodyIR.exactDef.opReadADefOpRows[i]} ed_producer={bodyIR.exactDef.opProducerFunctionRows[i]} slot_ssto={bodyIR.exactDef.slotStorageKinds[slot]} slot_splc={bodyIR.exactDef.slotPlaceKinds[slot]} slot_sorg={bodyIR.exactDef.slotOriginIds[slot]}{slotText} ck={copyKind} lr={literalRoot} puc={plainUnmanagedCallRoot} mcr={managedCallResultRoot}{callText}")

# STACK_LOCAL 臂 (C 68823-69053): 绑定门+根门+source chain 六臂。
# NOP 形 (68824-68878: aggregate borrow-result version / var-out) 无
# Cheng 载体 → 真空 (批 5 锚定 var-out 半)。
@borrows
fn exactDefIdentityStackLocalDefinitionValid(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        phase: str,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let storage = bodyIR.exactDef.slotStorageKinds[slot]
    let origin = bodyIR.exactDef.opOriginIds[i]
    let source = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
    let operand = exactDefIdentityOpOperandOrInvalid(op, 0)
    # 绑定门 (C 68895-68904): copy_kind = COPY_COMPOSITE/COPY_I64/
    # PAYLOAD_STORE → Cheng CopyLocal (PAYLOAD_STORE 臂的 FieldStore/
    # StoreLocal 同形绑定戳待批 6 核对 lowering 发戳点, 注释锚定);
    # literal_root = STR_LITERAL+source==-1 → Cheng LoadConst 常量根:
    # str 槽须过静态串校验 (C literal_root 同形); 非 str PLAIN 槽的
    # LoadConst 绑定 = C 常量物化+COPY 绑定链的 Cheng 一次成型对应物
    # (设计 §5-5 同族裁定 — Cheng 无 COPY 自空 scratch 的双行链,
    # derive 对 CopyLocal source 槽落 storage 戳使 C 根门空 scratch
    # 形在 Cheng 不可推导)。
    var literalRoot = false
    if source == -1 && op.kind == coreir.BodyOpLoadConstTag &&
       ownership == Int32(coreir.OwnPlain):
        if bodyIR.localSlots[slot].typeKind == coreir.LocalStrTag:
            literalRoot =
                exactDefIdentityPlainStaticStringDefinitionValid(
                    bodyIR, i)
        else:
            literalRoot = true
    let copyKind = op.kind == coreir.BodyOpCopyLocalTag
    # [wall110] 非托管 call-result 纯值定义 admit（绑定门第三形）。
    # STACK_LOCAL 绑定载体白名单原只有 CopyLocal 绑定戳与 literal_root
    # （LoadConst+OwnPlain）两形；发射器
    # PrimaryBodyIrBindUnmanagedCallResultDefinition 对非托管 call-result
    # 以 OwnPlain+TypedExpr 落 CallOp 载体纯值定义（body_ir_access 三
    # admit 实证的同一槽形），是第三形。admit 谓词与 body_ir_access
    # [wall108] admit op 段同形联立自证：op CallTag ∧ operands.len==1
    # （operands[0] 是 callSequence ordinal，非 slot 域，与 literalRoot
    # 同族豁免 operand 槽域检查与 root 门）∧ target==slot ∧
    # origin==slot ∧ OwnPlain+TypedExpr+originId==semanticRow>=0 ∧
    # exprNode>=0 ∧ 借主三列/源对/消费列全 sentinel ∧ 槽 Unmanaged+
    # tid>=0。任一列不符即不 admit，走原绑定门原判词 fail-closed；无
    # sentinel 豁免、无计数门放宽、derive 零写。禁止提取共享 helper
    # （body_ir_access [wall108r2] 警示同款）。
    var plainUnmanagedCallRoot = false
    if op.kind == coreir.BodyOpCallTag &&
       op.operands.len == 1 &&
       op.target == slot &&
       origin == slot &&
       ownership == Int32(coreir.OwnPlain) &&
       op.valueDefOriginKind == coreir.BodyDefinitionOriginTypedExprTag &&
       op.valueDefOriginId == op.valueDefSemanticRow &&
       op.valueDefOriginId >= 0 &&
       op.valueDefExprNodeIndex >= 0 &&
       op.valueDefBorrowOwnerSemanticRow == -1 &&
       op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainInvalidTag &&
       op.valueDefBorrowOwnerDefinitionRow == -1 &&
       op.sourceDefinitionDomain == coreir.BodyDefinitionDomainInvalidTag &&
       op.sourceDefinitionRow == -1 &&
       op.consumeActionRow == -1 &&
       slot >= 0 && slot < bodyIR.localSlots.len &&
       bodyIR.localSlots[slot].managedStorageKind ==
           coreir.BodyManagedStorageUnmanagedTag &&
       bodyIR.localSlots[slot].typeArenaTypeId >= 0:
        plainUnmanagedCallRoot = true
    # [wall125] 托管 call-result 绑定 admit（绑定门第四形）。发射器对
    # 托管 sret/stack-value 结果以 OwnMove+TypedExpr 落 CallOp 载体直
    # 接定义入 Managed 槽（cold_nested op5 实况: vok=TypedExpr ∧
    # voi==vsr>=0 ∧ vex>=0 ∧ 借主三列/源对全哨兵 ∧ ed_origin==slot ∧
    # 槽 Managed+tid>=0 ∧ callSequence 载体逐列镜像 c_rs==vds/
    # c_ro==vdo/c_rex==vex/c_rvr==vsr/借主三列镜像/c_rok==vok/
    # c_roi==voi/c 源对哨兵/c_car==-1 ∧ rpk∈{StackValue,SretResult}）
    # ——与 body_ir_access decode 主审对 OwnMove Call def 的
    # typedOwnedCallMirror 权威（:5322 区联立）同形联立自证，是
    # [wall110] plainUnmanagedCallRoot（OwnPlain+Unmanaged 槽）的托管
    # 对偶。def 行 consumeActionRow 列 decode 主审不约束（consume 义
    # 务归 consume-edge 审计），本 admit 同不约束。任一列不符即不
    # admit，走原绑定门原判词 fail-closed；无 sentinel 豁免、无计数门
    # 放宽、derive 零写。禁止提取共享 helper（[wall108r2] 警示同款）。
    var managedCallResultRoot = false
    if op.kind == coreir.BodyOpCallTag &&
       op.operands.len == 1 &&
       op.operands[0] >= 0 &&
       op.operands[0] < bodyIR.callSequence.len &&
       op.target == slot &&
       origin == slot &&
       ownership == Int32(coreir.OwnMove) &&
       op.valueDefOriginKind == coreir.BodyDefinitionOriginTypedExprTag &&
       op.valueDefOriginId == op.valueDefSemanticRow &&
       op.valueDefOriginId >= 0 &&
       op.valueDefExprNodeIndex >= 0 &&
       op.valueDefBorrowOwnerSemanticRow == -1 &&
       op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainInvalidTag &&
       op.valueDefBorrowOwnerDefinitionRow == -1 &&
       op.sourceDefinitionDomain == coreir.BodyDefinitionDomainInvalidTag &&
       op.sourceDefinitionRow == -1 &&
       slot >= 0 && slot < bodyIR.localSlots.len &&
       bodyIR.localSlots[slot].managedStorageKind ==
           coreir.BodyManagedStorageManagedTag &&
       bodyIR.localSlots[slot].typeArenaTypeId >= 0:
        let resultCall = bodyIR.callSequence[op.operands[0]]
        managedCallResultRoot =
            resultCall.resultSlot == op.valueDefSlot &&
            resultCall.resultOwnership == op.valueDefOwnership &&
            resultCall.resultExprNodeIndex == op.valueDefExprNodeIndex &&
            resultCall.resultValueDefinitionRow ==
                op.valueDefSemanticRow &&
            resultCall.resultBorrowOwnerValueDefinitionRow ==
                op.valueDefBorrowOwnerSemanticRow &&
            resultCall.resultBorrowOwnerDefinitionDomain ==
                op.valueDefBorrowOwnerDefinitionDomain &&
            resultCall.resultBorrowOwnerDefinitionRow ==
                op.valueDefBorrowOwnerDefinitionRow &&
            resultCall.resultDefinitionOriginKind ==
                op.valueDefOriginKind &&
            resultCall.resultDefinitionOriginId == op.valueDefOriginId &&
            resultCall.sourceDefinitionDomain ==
                coreir.BodyDefinitionDomainInvalidTag &&
            resultCall.sourceDefinitionRow == -1 &&
            resultCall.consumeActionRow == -1 &&
            (resultCall.resultPassKind ==
                 coreir.BodyCallPassStackValueTag ||
             resultCall.resultPassKind ==
                 coreir.BodyCallPassSretResultTag)
    if (!copyKind && !literalRoot && !plainUnmanagedCallRoot &&
            !managedCallResultRoot) ||
       op.target != slot || origin != slot ||
       (!(literalRoot || plainUnmanagedCallRoot || managedCallResultRoot) &&
        (operand < 0 || operand >= bodyIR.localSlots.len)):
        exactDefIdentityVerdictEmit(
            exactDefIdentityBindBrokenLine(phase, i))
        # [wall125] 判词富化: fail 路径取数, 守卫零改动。
        exactDefIdentityStackLocalBindFactsEmit(
            bodyIR, phase, i, copyKind, literalRoot,
            plainUnmanagedCallRoot, managedCallResultRoot)
        return false
    if source == -1:
        if !(literalRoot || plainUnmanagedCallRoot || managedCallResultRoot):
            if bodyIR.exactDef.slotPlaceKinds[operand] !=
                   exactdef.BodyIrExactDefPlaceInvalidTag ||
               bodyIR.exactDef.slotOriginIds[operand] != -1 ||
               bodyIR.exactDef.slotStorageKinds[operand] !=
                   exactdef.BodyIrExactDefStorageUnknownTag:
                exactDefIdentityVerdictEmit(
                    exactDefIdentityRootBrokenLine(phase, i))
                return false
        return true
    # 六臂 (C 68918-68992)。
    var sourceOwnership: int32
    if source >= 0 && source < bodyIR.ops.len:
        sourceOwnership = Int32(bodyIR.ops[source].valueDefOwnership)
    let moveEdge = ownership == Int32(coreir.OwnMove) &&
        (sourceOwnership == Int32(coreir.OwnMove) ||
         sourceOwnership == Int32(coreir.OwnPlain))
    let borrowEdge =
        (ownership == Int32(coreir.OwnBorrowShared) ||
         ownership == Int32(coreir.OwnBorrowUnique)) &&
        (sourceOwnership == Int32(coreir.OwnBorrowShared) ||
         sourceOwnership == Int32(coreir.OwnBorrowUnique))
    let plainStaticStringEdge =
        storage == exactdef.BodyIrExactDefStorageStrTag &&
        ownership == Int32(coreir.OwnPlain) &&
        exactDefIdentityPlainStaticStringDefinitionValid(bodyIR, i)
    # plain_copy_edge 第二析取的 neutral_staging (C 68947-68950,
    # cold_exact_borrow_result_neutral_staging_value_valid): 借用
    # staging 证书/var-out 车道属批 5, 本批真空 false (锚点注释)。
    let plainCopyEdge =
        exactDefIdentityPlainCopyTupleValid(bodyIR, dom, workspace.opBlockIds, source, i) &&
        exactDefIdentityPlainValueCopyIndependent(
            bodyIR, bodyIR.ops[source].valueDefSlot)
    var plainSharedCopyEdge = false
    if exactDefIdentityPlainCopyTupleValid(bodyIR, dom, workspace.opBlockIds, source, i) &&
       sourceOwnership == Int32(coreir.OwnPlain) &&
       bodyIR.exactDef.opPlaceKinds[source] ==
           exactdef.BodyIrExactDefPlaceSharedCopyTag:
        let sourceSlot = bodyIR.ops[source].valueDefSlot
        plainSharedCopyEdge =
            sourceSlot >= 0 && sourceSlot < bodyIR.localSlots.len &&
            bodyIR.exactDef.slotStorageKinds[sourceSlot] ==
                exactdef.BodyIrExactDefStoragePlainTag
    var borrowedPlainSnapshotEdge = false
    if exactDefIdentityPlainCopyTupleValid(bodyIR, dom, workspace.opBlockIds, source, i) &&
       sourceOwnership == Int32(coreir.OwnBorrowShared):
        let sourceSlot = bodyIR.ops[source].valueDefSlot
        let sourcePlace = bodyIR.exactDef.opPlaceKinds[source]
        borrowedPlainSnapshotEdge =
            sourceSlot >= 0 && sourceSlot < bodyIR.localSlots.len &&
            bodyIR.exactDef.slotStorageKinds[sourceSlot] ==
                exactdef.BodyIrExactDefStoragePlainTag &&
            (sourcePlace ==
                 exactdef.BodyIrExactDefPlaceBorrowProjectionTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceSharedCopyTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceTemporaryTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceStackLocalTag ||
             sourcePlace ==
                 exactdef.BodyIrExactDefPlaceParamTag) &&
            exactDefIdentityBorrowResultRootValid(bodyIR, source)
    # mv_source_view_edge 臂的 Cheng 形态 (规格 §4, 设计 §5-3):
    # row_is_identity_view 的 Cheng 残余 = place∈{MEMORY_VERSION,
    # CFG_MERGE} 戳 (kind NOP 无载体 → place 列即视图位); 只放电支配
    # 子句, 槽终校验放电之, 链门其余四类检查全保留。
    var mvSourceViewEdge = false
    if source >= 0 && source < bodyIR.ops.len:
        let sourcePlace = bodyIR.exactDef.opPlaceKinds[source]
        if (sourcePlace ==
                exactdef.BodyIrExactDefPlaceMemoryVersionTag ||
            sourcePlace ==
                exactdef.BodyIrExactDefPlaceCfgMergeTag) &&
           bodyIR.ops[source].valueDefSlot == operand:
            mvSourceViewEdge =
                exactDefIdentityIdentityViewSlotTerminalValid(
                    bodyIR, dom, workspace.opBlockIds, i, operand,
                    sourceOwnership,
                    bodyIR.exactDef.opExactTypeIds[source])
    if source < 0 || source >= bodyIR.ops.len ||
       (!mvSourceViewEdge &&
        !freeze.ExactDefFreezeIdentityReaches(
            bodyIR, dom, workspace.opBlockIds, source, i)) ||
       bodyIR.ops[source].valueDefSlot != operand ||
       bodyIR.exactDef.opPlaceKinds[source] ==
           exactdef.BodyIrExactDefPlaceInvalidTag ||
       (!moveEdge && !borrowEdge && !plainStaticStringEdge &&
        !plainCopyEdge && !borrowedPlainSnapshotEdge &&
        !plainSharedCopyEdge):
        var sourceSlot: int32 = -1
        var sourcePlace = exactdef.BodyIrExactDefPlaceInvalidTag
        if source >= 0 && source < bodyIR.ops.len:
            sourceSlot = bodyIR.ops[source].valueDefSlot
            sourcePlace = bodyIR.exactDef.opPlaceKinds[source]
        exactDefIdentityVerdictEmit(
            exactDefIdentitySourceChainBrokenLine(
                phase, bodyIR.controlFunctionRow, i, source, sourceSlot,
                operand, ownership, sourceOwnership, sourcePlace))
        # 链 dump (C 69040-69049): [max(0,source-12), i+2] ∩ [0,opCount)。
        var dumpStart: int32
        if source - 12 >= 0:
            dumpStart = source - 12
        var dumpRow = dumpStart
        while dumpRow < bodyIR.ops.len && dumpRow <= i + 2:
            let dumpOp = bodyIR.ops[dumpRow]
            exactDefIdentityVerdictEmit(
                exactDefIdentityChainDumpLine(
                    dumpRow, dumpOp.kind, dumpOp.target,
                    exactDefIdentityOpOperandOrInvalid(dumpOp, 0),
                    exactDefIdentityOpOperandOrInvalid(dumpOp, 1),
                    exactDefIdentityOpOperandOrInvalid(dumpOp, 2),
                    dumpOp.valueDefSlot,
                    Int32(dumpOp.valueDefOwnership),
                    bodyIR.exactDef.opPlaceKinds[dumpRow]))
            dumpRow = dumpRow + 1
        return false
    return true

# PARAM 臂 (C 69054-69106) + 效应门。
# 效应门的 Cheng 裁定 (C 69062-69106): parameter_is_var/borrows_args/
# param_exact_type_id 的 FnDef 证据在冻结 BodyIR 无载体; 入参所有权
# 在 entry 冻结时已按 lowering 事实核过 (BodyIRFreezeEntryDefinition
# OwnershipKinds 只接纳 lowering 投影), 冻结车道即效应权威:
# UNIQUE⇔var (可变借用), SHARED⇔!var&&borrows_args (函数级 @borrows —
# 有借用形参则全函数非 var 托管参 SHARED, 与 C 的函数级析取同构),
# MOVE/PLAIN⇔!var&&!borrows_args; PLAIN 另证 storage/canonical 双 PLAIN
# + type 双等 (C 69092-69100 同形)。
@borrows
fn exactDefIdentityParamDefinitionValid(bodyIR: coreir.BodyIR,
                                        phase: str,
                                        i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let origin = bodyIR.exactDef.opOriginIds[i]
    let exactType = bodyIR.exactDef.opExactTypeIds[i]
    if !exactDefIdentityParamDefinitionEdgeValid(bodyIR, i):
        exactDefIdentityVerdictEmit(
            exactDefIdentityParameterBrokenLine(phase, i))
        return false
    if bodyIR.controlFunctionRow < 0 || origin < 0:
        exactDefIdentityVerdictEmit(
            exactDefIdentityParameterEffectOwnerLine(phase, i))
        return false
    var entryOwnership: int32
    if bodyIR.entryDefinitionOwnershipSealed &&
       slot >= 0 && slot < bodyIR.entryDefinitionOwnershipKinds.len:
        entryOwnership = bodyIR.entryDefinitionOwnershipKinds[slot]
    let exactEffect = origin < bodyIR.entryParameterSlotIds.len &&
        ((ownership == Int32(coreir.OwnBorrowUnique) &&
          entryOwnership == Int32(coreir.OwnBorrowUnique)) ||
         (ownership == Int32(coreir.OwnBorrowShared) &&
          entryOwnership == Int32(coreir.OwnBorrowShared)) ||
         (ownership == Int32(coreir.OwnMove) &&
          entryOwnership == Int32(coreir.OwnMove)) ||
         (ownership == Int32(coreir.OwnPlain) &&
          entryOwnership == Int32(coreir.OwnPlain) &&
          bodyIR.exactDef.slotStorageKinds[slot] ==
              exactdef.BodyIrExactDefStoragePlainTag &&
          exactDefIdentityExpectedStorageForSlot(bodyIR, slot) ==
              exactdef.BodyIrExactDefStoragePlainTag &&
          bodyIR.localSlots[slot].typeArenaTypeId == exactType))
    if !exactEffect:
        exactDefIdentityVerdictEmit(
            exactDefIdentityParameterEffectMismatchLine(phase, i))
        return false
    return true

# 参数基座整值借视投影谓词 (wall27 提案; 消费 derive EntrySlotTag
# 借主臂的槽域 origin 拼写)。域列判别 + EntrySlot 终态根裁定
# (call_authority 同款: entryParameterSlotIds 在界即形参根, 否则
# 须全局地址槽) + 整值借视形核对 (derive 零跳臂同款形状: FieldLoad
# operands=[基座,目标,0,基座槽全宽]; TypeArena layout 证据窗不在
# 冻结投影, 借视同型以目标/基座槽 typeArenaTypeId 直等承载) +
# entry 冻结所有权互证 (借主形参 entry 所有权须 BORROW_SHARED ∨
# BORROW_UNIQUE — var 托管借视形参经 lowering 确定性冻结为唯一借,
# 共享借读单调弱于唯一借, 非 Borrow 根仍 fail-closed; 与借用行
# ownership/PARAM 臂/derive 相 2 同源双形态) 的合取; 每项
# 独立 fail-closed, 不合形返回 false 交回原主门与原判词。
@borrows
fn exactDefIdentityParamBorrowViewProjectionValid(
        bodyIR: coreir.BodyIR,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let ownerSlot = op.valueDefBorrowOwnerDefinitionRow
    if ownerSlot < 0 || ownerSlot >= bodyIR.localSlots.len:
        return false
    var paramRoot: int32
    for ordinal in 0..<bodyIR.entryParameterSlotIds.len:
        if bodyIR.entryParameterSlotIds[ordinal] == ownerSlot:
            paramRoot = 1
            break
    if paramRoot == 0:
        return bodyIR.localSlots[ownerSlot].placeKind ==
            coreir.BodyPlaceGlobalAddressTag
    # 基座直等: FieldLoad 首操作数即借主参数槽。
    if exactDefIdentityOpOperandOrInvalid(op, 0) != ownerSlot:
        return false
    if op.kind != coreir.BodyOpFieldLoadTag || op.operands.len != 4:
        return false
    if op.operands[1] != op.valueDefSlot ||
       op.target != op.valueDefSlot:
        return false
    if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len:
        return false
    if op.operands[2] != 0 ||
       op.operands[3] != bodyIR.localSlots[ownerSlot].sizeBytes:
        return false
    if bodyIR.localSlots[op.operands[1]].typeArenaTypeId !=
       bodyIR.localSlots[ownerSlot].typeArenaTypeId:
        return false
    if bodyIR.entryDefinitionOwnershipSealed &&
       ownerSlot < bodyIR.entryDefinitionOwnershipKinds.len:
        let entryOwnership =
            bodyIR.entryDefinitionOwnershipKinds[ownerSlot]
        # entry 所有权双形态放行: var 托管借视形参被确定性冻结为
        # BORROW_UNIQUE (共享借读单调弱于唯一借), 与 PARAM 臂/
        # derive 相 2 双形态对齐; 其余 (非 Borrow 根) fail-closed。
        if entryOwnership != Int32(coreir.OwnBorrowShared) &&
           entryOwnership != Int32(coreir.OwnBorrowUnique):
            return false
    return true

# [wall104r2] EntrySlot 槽域链式字段投影臂 (wall27 参数基座臂的同域
# 延伸, 非弱化): derive EntrySlotTag 臂把 opOriginIds 冻结为借主槽 id
# (槽域拼写), 借主体内无定义 op 行; 基座直接落在借主槽上的投影由
# wall27 直等臂放行, 基座落在「同借主根的前序投影结果槽」上的链式
# 形 (v6 fn=2 op=7: param0 → op6 结果槽 8 → 槽 9) 直等臂不覆盖 — 原
# 主门把槽域 origin 误读为 op 行, originInRange/parentSlot/parentLive
# 全按行域解释 = 类别错误, 不是有意义的守卫。本臂按槽域契约复核:
# ①终态根与直等臂同款 (entry 形参槽 ∨ 全局地址槽); ②entry 所有权
# 互证同款双形态; ③链上溯 = base 槽的 canonical 读边定义行
# (opReadADefOpRows, 批 2 read-edge 总门已证规范) 逐跳上行, 每跳
# 定义行必须是同借主根 (EntrySlot 域 ∧ 借主槽直等) 的 BorrowProjection
# FieldLoad 定义行 (derive field-borrow 臂已对其逐跳 layout 三元组
# 证明, 本臂结构复核), 严格行号递减灭环, 深度限 64 (与 freeze 物理
# 类型链同纪律)。任一环节不合 = false 交回原主门原判词; 直等形
# (base==借主槽) 归原臂管, 本臂不放行。
@borrows
fn exactDefIdentityEntrySlotChainedProjectionValid(
        bodyIR: coreir.BodyIR, i: int32): bool =
    let op = bodyIR.ops[i]
    let ownerSlot = op.valueDefBorrowOwnerDefinitionRow
    if ownerSlot < 0 || ownerSlot >= bodyIR.localSlots.len:
        return false
    var paramRoot: int32
    for ordinal in 0..<bodyIR.entryParameterSlotIds.len:
        if bodyIR.entryParameterSlotIds[ordinal] == ownerSlot:
            paramRoot = 1
            break
    if paramRoot == 0:
        return bodyIR.localSlots[ownerSlot].placeKind ==
            coreir.BodyPlaceGlobalAddressTag
    if bodyIR.entryDefinitionOwnershipSealed &&
       ownerSlot < bodyIR.entryDefinitionOwnershipKinds.len:
        let entryOwnership =
            bodyIR.entryDefinitionOwnershipKinds[ownerSlot]
        if entryOwnership != Int32(coreir.OwnBorrowShared) &&
           entryOwnership != Int32(coreir.OwnBorrowUnique):
            return false
    var cur = exactDefIdentityOpOperandOrInvalid(op, 0)
    if cur < 0 || cur >= bodyIR.localSlots.len || cur == ownerSlot:
        return false
    var row = i
    var hops: int32
    while hops < 64:
        if row < 0 || row >= bodyIR.exactDef.opReadADefOpRows.len:
            return false
        let definer = bodyIR.exactDef.opReadADefOpRows[row]
        if definer < 0 || definer >= row:
            return false
        let dop = bodyIR.ops[definer]
        if dop.kind != coreir.BodyOpFieldLoadTag ||
           dop.operands.len != 4 ||
           dop.valueDefSlot < 0 ||
           dop.operands[1] != dop.valueDefSlot ||
           dop.target != dop.valueDefSlot ||
           Int32(dop.valueDefOwnership) !=
               Int32(coreir.OwnBorrowShared) ||
           dop.valueDefBorrowOwnerDefinitionDomain !=
               coreir.BodyDefinitionDomainEntrySlotTag ||
           dop.valueDefBorrowOwnerDefinitionRow != ownerSlot ||
           bodyIR.exactDef.opPlaceKinds[definer] !=
               exactdef.BodyIrExactDefPlaceBorrowProjectionTag:
            return false
        row = definer
        cur = exactDefIdentityOpOperandOrInvalid(dop, 0)
        if cur < 0 || cur >= bodyIR.localSlots.len:
            return false
        if cur == ownerSlot:
            return true
        hops = hops + 1
    return false

# [wall124] owned entry 根整值借视直等臂 (wall27 参数基座臂的同域第
# 三臂, 纯增量非弱化): lowering 对 owned (Move/Plain) entry 形参同样
# 产整值借视直等投影 (cold_nested fn=0 op13: s14=borrow shared
# view(s0), operands=[0,14,0,24], eo0=2=OwnMove), wall27 直等臂与
# [wall104r2] 链式臂的 entry 所有权互证子句只接 Borrow 根, owned
# Move/Plain 根 fail-closed 双拒后落原主门; 原主门按 derive
# EntrySlotTag 槽域拼写契约把 origin (借主槽 id) 误读为 op 行 →
# parent_live=0 类别错误判词 (wall123 定性闭合)。形状子句与 wall27
# 直等臂逐字同款 (基座直等/FieldLoad 4 操作数/双直等/off==0/width==
# 借主槽全宽/TypeId 双等); entry 所有权互证改接 owned 双形态
# (Move/Plain, PARAM 臂同款映射, 冻结车道效应权威
# MOVE/PLAIN⇔!var&&!borrows_args); owned 根特有活性证据 = 借主槽
# 写者集扫描 (exactDefIdentityIdentityViewSlotTerminalValid 同款
# 写者集原语: def 写 = valueDefSlot==借主槽, store 族写 = store 族
# kind && target==借主槽) — 借主 entry 槽在体内零 def 写零 store 族
# 写即原值未重绑、贯穿全函数, 共享借视语义健全 (车头同输入 0/0
# pass 为语义参照; owned 形参原值未重绑时的共享借读不转移所有权)。
# Borrow 根仍归 wall27/链式臂, 全局地址根不放行, 非本形一律 false
# 交回原主门与原判词 (fail-closed; 现拒绝形才可达, 绿路径零触碰)。
@borrows
fn exactDefIdentityOwnedParamBorrowViewProjectionValid(
        bodyIR: coreir.BodyIR,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let ownerSlot = op.valueDefBorrowOwnerDefinitionRow
    if ownerSlot < 0 || ownerSlot >= bodyIR.localSlots.len:
        return false
    var paramRoot: int32
    for ordinal in 0..<bodyIR.entryParameterSlotIds.len:
        if bodyIR.entryParameterSlotIds[ordinal] == ownerSlot:
            paramRoot = 1
            break
    # 仅 entry 形参根 (owned-entry-root 臂域); 全局地址根归原臂族。
    if paramRoot == 0:
        return false
    # 形状子句: 与 wall27 直等臂逐字同款。
    if exactDefIdentityOpOperandOrInvalid(op, 0) != ownerSlot:
        return false
    if op.kind != coreir.BodyOpFieldLoadTag || op.operands.len != 4:
        return false
    if op.operands[1] != op.valueDefSlot ||
       op.target != op.valueDefSlot:
        return false
    if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len:
        return false
    if op.operands[2] != 0 ||
       op.operands[3] != bodyIR.localSlots[ownerSlot].sizeBytes:
        return false
    if bodyIR.localSlots[op.operands[1]].typeArenaTypeId !=
       bodyIR.localSlots[ownerSlot].typeArenaTypeId:
        return false
    # entry 所有权互证: owned 双形态; 冻结封印在册方可读 (较
    # wall27 的未封印跳过子句更严, fail-closed 方向)。
    if !bodyIR.entryDefinitionOwnershipSealed ||
       ownerSlot >= bodyIR.entryDefinitionOwnershipKinds.len:
        return false
    let entryOwnership =
        bodyIR.entryDefinitionOwnershipKinds[ownerSlot]
    if entryOwnership != Int32(coreir.OwnMove) &&
       entryOwnership != Int32(coreir.OwnPlain):
        return false
    # owned 根活性证据: 借主槽写者集扫描 (IdentityViewSlotTerminal
    # Valid 同款写者集原语) — 体内零 def 写零 store 族写即原值贯穿。
    for opRow in 0..<bodyIR.ops.len:
        let bodyOp = bodyIR.ops[opRow]
        if bodyOp.valueDefSlot == ownerSlot:
            return false
        if bodyOp.target == ownerSlot &&
           (bodyOp.kind == coreir.BodyOpStoreLocalTag ||
            bodyOp.kind == coreir.BodyOpCopyLocalTag ||
            bodyOp.kind == coreir.BodyOpFieldStoreTag ||
            bodyOp.kind == coreir.BodyOpIndexedStoreTag ||
            bodyOp.kind == coreir.BodyOpGlobalStoreTag):
            return false
    return true

# [wall146] BodyOp 借主域链式字段投影臂 ([wall104r2] EntrySlot 链式臂
# 的对称缺臂, 纯增量非弱化): 借主域=BodyOpTag 时 opOriginIds 按 op 行
# 解释, 原主门 baseMatchesParent 只接「origin 行 defSlot==op_a 直等」;
# 基座落在「同借主根的前序投影结果槽」上的链式形 (v6 fn=3 op=34:
# 借主 op4(n 定义, slot0) → op33 CopyLocal 借视投影结果槽 25 → op34
# FieldLoad 结果槽 26) 直等臂不覆盖。C 参照 var_projection_base_
# matches_parent 的跳臂被移植判「无 Cheng 载体 → 真空」, v6 实况证伪
# (Cheng 载体=CopyLocal/FieldLoad 借视投影链, wall127 同款真空误判)。
# 本臂按行域契约复核: ①根互证 opOriginIds==借主行 (主门 originInRange/
# originReaches/parentLive/parentOwnershipValid 已按该行全查, 本臂零
# 重复); ②链上溯 = base 槽 canonical 读边定义行 (opReadADefOpRows,
# [wall146] read-edge 容忍臂保证投影链可解析) 逐跳上行, 每跳定义行
# 必须是同借主根 (BorrowProjection place ∧ BorrowShared ∧ 借主域
# BodyOpTag ∧ 借主行直等 ∧ opOriginIds 直等) 的 CopyLocal/FieldLoad
# 投影 def (derive 直等形相等核对/field-borrow hop 已放电, 本臂结构
# 复核), 严格行号递减灭环, 深度限 64 (与 EntrySlot 链式臂同纪律)。
# 终态 = base 槽 == 借主行 valueDefSlot。任一环节不合 = false 交回
# 原主门原判词; 直等形归原臂管, 本臂不放行 (fail-closed)。
@borrows
fn exactDefIdentityBodyOpChainedProjectionValid(
        bodyIR: coreir.BodyIR, i: int32): bool =
    let op = bodyIR.ops[i]
    let ownerRow = op.valueDefBorrowOwnerDefinitionRow
    if op.valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag:
        return false
    if ownerRow < 0 || ownerRow >= bodyIR.ops.len:
        return false
    if bodyIR.exactDef.opOriginIds[i] != ownerRow:
        return false
    if ownerRow >= i:
        return false
    let rootSlot = bodyIR.ops[ownerRow].valueDefSlot
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
        return false
    var cur = exactDefIdentityOpOperandOrInvalid(op, 0)
    if cur < 0 || cur >= bodyIR.localSlots.len:
        return false
    var row = i
    var hops: int32
    while hops < 64:
        if cur == rootSlot:
            return true
        if row < 0 || row >= bodyIR.exactDef.opReadADefOpRows.len:
            return false
        let definer = bodyIR.exactDef.opReadADefOpRows[row]
        if definer < 0 || definer >= row:
            return false
        let dop = bodyIR.ops[definer]
        if dop.valueDefSlot < 0 ||
           Int32(dop.valueDefOwnership) !=
               Int32(coreir.OwnBorrowShared) ||
           dop.valueDefBorrowOwnerDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           dop.valueDefBorrowOwnerDefinitionRow != ownerRow ||
           bodyIR.exactDef.opOriginIds[definer] != ownerRow ||
           bodyIR.exactDef.opPlaceKinds[definer] !=
               exactdef.BodyIrExactDefPlaceBorrowProjectionTag:
            return false
        if dop.kind == coreir.BodyOpCopyLocalTag:
            if dop.operands.len != 1:
                return false
        elif dop.kind == coreir.BodyOpFieldLoadTag:
            if dop.operands.len != 4 ||
               dop.operands[1] != dop.valueDefSlot ||
               dop.target != dop.valueDefSlot:
                return false
        else:
            return false
        row = definer
        cur = exactDefIdentityOpOperandOrInvalid(dop, 0)
        if cur < 0 || cur >= bodyIR.localSlots.len:
            return false
        hops = hops + 1
    return false

# BORROW_PROJECTION 臂 (C 69107-69314): 前置候选 (ABI pointer
# projection 69108-69130 / ABI pointer ref-object 69131-69152 /
# direct_var_value_object_projection 69198-69242) 的 SLOT_OPAQUE/
# SLOT_PTR/PAYLOAD_LOAD/COPY_I64/TypeId 域商余载体在 Cheng 全无对应
# → 真空 (判词不移植, 注释锚定)。主门 (C 69244-69261)。
@borrows
fn exactDefIdentityBorrowProjectionDefinitionValid(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        phase: str,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let origin = bodyIR.exactDef.opOriginIds[i]
    let source = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
    let consumePlusOne = op.valueDefConsumeOpIndexPlusOne
    let operand = exactDefIdentityOpOperandOrInvalid(op, 0)
    # copy_kind 11 种 → Cheng 投影 op 集 {FieldLoad, IndexedLoad,
    # CopyLocal, ResultProject} (规格 §8); PTR_LOAD_I64/PAYLOAD_LOAD/
    # FIELD_REF/LOCAL_ADDR/SEQ_*/ARRAY_* 载体无对应行 → 注释。
    let copyKind = op.kind == coreir.BodyOpFieldLoadTag ||
        op.kind == coreir.BodyOpIndexedLoadTag ||
        op.kind == coreir.BodyOpCopyLocalTag ||
        op.kind == coreir.BodyOpResultProjectTag
    let originInRange = origin >= 0 && origin < bodyIR.ops.len
    let originReaches = originInRange &&
        freeze.ExactDefFreezeIdentityReaches(
            bodyIR, dom, workspace.opBlockIds, origin, i)
    # ownership_valid (C 69176-69182): BORROW_SHARED 直接承认 —
    # share 是 retain 非转移 (规格 §5.1 帧自有约定); BORROW_UNIQUE 须
    # cold_exact_unique_projection_root_valid — seal root 解析属批 5
    # (设计 §5-4 由上游不变式替代), 本批不证 → false (严格方向)。
    let ownershipValid = ownership == Int32(coreir.OwnBorrowShared)
    # sequence_object_projection_valid (C 69183-69188):
    # SEQ_OPAQUE_INDEX_DYNAMIC+SLOT_OBJECT 的对象投影 tuple 无 Cheng
    # 载体; IndexedLoad 投影的 TypeId/layout 一致性由 derive 落戳时
    # hard-fail 证明 (上游不变式放电) → 恒真。
    let sequenceObjectProjectionValid = true
    let parentLive = exactDefIdentityProjectionParentLiveBeforeOp(
        bodyIR, dom, workspace, limits, origin, i)
    var parentSlot: int32 = -1
    var parentOwnership: int32 = -1
    var parentType: int32 = -1
    if originInRange:
        parentSlot = bodyIR.ops[origin].valueDefSlot
        parentOwnership = Int32(bodyIR.ops[origin].valueDefOwnership)
        parentType = bodyIR.exactDef.opExactTypeIds[origin]
    # 基槽匹配: def_slot[origin]==op_a 直等臂 (C 61041-61043);
    # var_projection_base_matches_parent 的两条 FIELD_REF 跳臂
    # (C 61049-61103) 的 Cheng 载体 = CopyLocal/FieldLoad 借视投影链
    # 由 [wall146] BodyOp 借主域链式臂回收 (v6 实况证伪真空裁定)。
    let baseMatchesParent = originInRange &&
        (parentSlot == operand ||
         exactDefIdentityBodyOpChainedProjectionValid(bodyIR, i))
    let parentOwnershipValid = parentOwnership ==
            Int32(coreir.OwnPlain) ||
        parentOwnership == Int32(coreir.OwnMove) ||
        parentOwnership == Int32(coreir.OwnBorrowShared) ||
        parentOwnership == Int32(coreir.OwnBorrowUnique)
    # 参数基座整值借视投影臂 (wall27 提案): 借主域列 EntrySlotTag
    # 时 opOriginIds 是槽域拼写 (借主槽 id, derive EntrySlotTag 臂
    # 行/槽统一裁定), 不按 op 行解释 origin — 本臂先行, 终态根+
    # 借视形+所有权互证全过即放行; [wall104r2] 链式延伸: 基座落在
    # 同借主根前序投影结果槽上的链式形由槽域读边链上溯臂放行;
    # [wall124] owned 延伸: owned (Move/Plain) entry 根的整值借视
    # 直等形由写者集扫描臂放行 (Borrow 根双臂不接, 原主门按槽域
    # 拼写误读 op 行 = 类别错误); 非该域或形不合仍走下方原主门
    # (origin 行三查与原判词逐字保留, 守卫不弱化)。
    let paramBorrowViewProjection =
        ownershipValid && copyKind && op.target == slot &&
        source == -1 && consumePlusOne == 0 &&
        op.valueDefBorrowOwnerDefinitionDomain ==
            coreir.BodyDefinitionDomainEntrySlotTag &&
        (exactDefIdentityParamBorrowViewProjectionValid(bodyIR, i) ||
         exactDefIdentityEntrySlotChainedProjectionValid(bodyIR, i) ||
         exactDefIdentityOwnedParamBorrowViewProjectionValid(bodyIR,
             i))
    if paramBorrowViewProjection:
        return true
    if !copyKind || op.target != slot || source != -1 ||
       consumePlusOne != 0 || !ownershipValid || !originInRange ||
       !originReaches || !sequenceObjectProjectionValid || !parentLive ||
       !baseMatchesParent || !parentOwnershipValid:
        var parentSlotType: int32 = -1
        var parentStorage: int32 = -1
        var parentKind: int32 = -1
        var parentSize: int32 = -1
        if originInRange && parentSlot >= 0 &&
           parentSlot < bodyIR.localSlots.len:
            parentSlotType =
                bodyIR.localSlots[parentSlot].typeArenaTypeId
            parentStorage =
                bodyIR.exactDef.slotStorageKinds[parentSlot]
            parentKind = bodyIR.localSlots[parentSlot].typeKind
            parentSize = bodyIR.localSlots[parentSlot].sizeBytes
        var parentParamRoot: int32
        if originInRange &&
           exactDefIdentityBorrowedRefObjectParamMutationRootValid(
               bodyIR, origin):
            parentParamRoot = 1
        exactDefIdentityVerdictEmit(
            exactDefIdentityBorrowProjectionBrokenLine(
                phase, bodyIR.controlFunctionRow, i, slot, origin,
                ownership, op.kind, exactDefIdentityBoolInt(copyKind),
                exactDefIdentityBoolInt(op.target == slot), source,
                consumePlusOne,
                exactDefIdentityBoolInt(ownershipValid),
                exactDefIdentityBoolInt(originInRange),
                exactDefIdentityBoolInt(originReaches),
                exactDefIdentityBoolInt(sequenceObjectProjectionValid),
                exactDefIdentityBoolInt(parentLive), parentSlot,
                operand, parentOwnership, parentParamRoot, parentType,
                parentSlotType, parentStorage, parentKind, parentSize))
        return false
    return true

# GLOBAL 臂 (C 69315-69340): GLOBAL_ADDR 根的 Cheng 载体 = GlobalLoad;
# C 的 origin∈[0,global_count) 全局行域 → Cheng 全局地址槽行域
# (origin 槽 placeKind==BodyPlaceGlobalAddressTag, 其目标绑定权威在
# localAddressTarget* 列, core_types 结构不变式); a==origin 直等,
# b==c==0 → operands.len==1。注释 (C 69316-69321) 的 var-out 槽头
# 前进情形在 Cheng 无 MV 载体。
@borrows
fn exactDefIdentityGlobalDefinitionValid(bodyIR: coreir.BodyIR,
                                         phase: str,
                                         i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let origin = bodyIR.exactDef.opOriginIds[i]
    let source = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
    let consumePlusOne = op.valueDefConsumeOpIndexPlusOne
    if op.kind != coreir.BodyOpGlobalLoadTag || op.target != slot ||
       source != -1 || consumePlusOne != 0 ||
       ownership != Int32(coreir.OwnBorrowShared) || origin < 0 ||
       origin >= bodyIR.localSlots.len ||
       bodyIR.localSlots[origin].placeKind !=
           coreir.BodyPlaceGlobalAddressTag ||
       op.operands.len != 1 || op.operands[0] != origin:
        exactDefIdentityVerdictEmit(
            exactDefIdentityGlobalBrokenLine(
                phase, bodyIR.controlFunctionRow, i, origin, source,
                ownership, consumePlusOne))
        return false
    return true

# SHARED_COPY 臂 (C 69341-69391): COPY_COMPOSITE → CopyLocal。
@borrows
fn exactDefIdentitySharedCopyDefinitionValid(
        bodyIR: coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        opBlockIds: int32[],
        phase: str,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let origin = bodyIR.exactDef.opOriginIds[i]
    let source = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
    let operand = exactDefIdentityOpOperandOrInvalid(op, 0)
    let storage = bodyIR.exactDef.slotStorageKinds[slot]
    let originInRange = origin >= 0 && origin < bodyIR.ops.len
    let originReaches = originInRange &&
        freeze.ExactDefFreezeIdentityReaches(
            bodyIR, dom, opBlockIds, origin, i)
    var sourceOwnership: int32
    if originInRange:
        sourceOwnership = Int32(bodyIR.ops[origin].valueDefOwnership)
    let sourceOwned = sourceOwnership == Int32(coreir.OwnPlain) ||
        sourceOwnership == Int32(coreir.OwnMove)
    let sourceBorrow = sourceOwnership == Int32(coreir.OwnBorrowShared) ||
        sourceOwnership == Int32(coreir.OwnBorrowUnique)
    var expectedOwnership = Int32(coreir.OwnMove)
    if storage == exactdef.BodyIrExactDefStoragePlainTag:
        expectedOwnership = Int32(coreir.OwnPlain)
    if op.kind != coreir.BodyOpCopyLocalTag || op.target != slot ||
       ownership != expectedOwnership || source != -1 ||
       !originInRange || !originReaches || operand < 0 ||
       operand >= bodyIR.localSlots.len ||
       bodyIR.ops[origin].valueDefSlot != operand ||
       (!sourceOwned && !sourceBorrow):
        var originDefSlot: int32 = -2
        if originInRange:
            originDefSlot = bodyIR.ops[origin].valueDefSlot
        exactDefIdentityVerdictEmit(
            exactDefIdentitySharedCopyBrokenLine(
                phase, bodyIR.controlFunctionRow, i, slot, origin,
                sourceOwnership, op.target, operand, originDefSlot,
                exactDefIdentityBoolInt(originReaches), op.kind))
        return false
    return true

# [wall104] 字段投影借视形 hop 已证三元组冻结层复核 (wall90/wall100
# 同契约延伸, 非弱化): derive field-borrow 臂对 FieldLoad ∧
# BORROW_SHARED ∧ 借主域有效形以 destination 槽冻结 TypeId 逐跳证明,
# hop 精确三元组 (fieldTypeId,offset,width) ∈ owner layout children
# 或整值借视残形命中即配对绑定槽 TypeId canonical fact closure
# (wall100 配对绑定单点, 幂等)。TypeArena layoutChild 证据窗不在冻结
# BodyIR 投影 (批 3 裁定), 冻结层可核的已证残形 = ①derive hop 同序
# 形状子句逐字 (4 操作数/dst 双直等/base 在界/offset≥0/width∈(0,
# dst 全宽]/双 TypeId 已绑) ②槽 TypeId canonical fact row 在册且
# 物理 TypeId 可解析 (hop 命中 ⇔ 绑定; 缺行/断链 = 证据洞, 本 fn
# false → 相等子句原判词放电, fail-closed)。每项独立界内, 不合形
# 返回 false 交回原相等子句, 其余形状零触碰。
@borrows
fn exactDefIdentityFieldProjectionHopTripleValid(
        bodyIR: coreir.BodyIR, i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return false
    if op.kind != coreir.BodyOpFieldLoadTag || op.operands.len != 4 ||
       op.operands[1] != slot || op.target != slot:
        return false
    let baseSlot = op.operands[0]
    let fieldOffset = op.operands[2]
    let fieldWidth = op.operands[3]
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
       fieldOffset < 0 || fieldWidth <= 0 ||
       fieldWidth > bodyIR.localSlots[slot].sizeBytes:
        return false
    let slotTypeId = bodyIR.localSlots[slot].typeArenaTypeId
    let ownerTypeId = bodyIR.localSlots[baseSlot].typeArenaTypeId
    if slotTypeId < 0 || ownerTypeId < 0:
        return false
    if exactDefIdentityTypeFactStructuralKind(bodyIR, slotTypeId) < 0:
        return false
    if exactDefIdentityPhysicalTypeId(bodyIR, slotTypeId) < 0:
        return false
    return true

# ---- [wall117c] consume path 取数诊断 (判词富化, wall74/w80/w87/w91
#      先例同款; 守卫零改动): consume-edge 审计失败时对当前 body 逐块/
#      逐 op/逐 call/逐消费边列实况, freeze 域后续臂一次取全。
#      列含义: src_row=消费通道① source 列; arg(def,own)=通道② CSR
#      (own=MOVE 才消费); action_row=cleanup 物化消费行 (drop-glue/
#      快照/投影释放唯一发戳车道); term_kind 1=Return 2=Br。
#      消费边判定复用 freeze.ExactDefFreezeIdentityOpConsumesDefinition
#      单实现 (禁第二份逐字拷贝)。纯 stderr 投影, 零判定语义。
@borrows
fn exactDefIdentityConsumePathOperandsText(op: coreir.BodyOp): str =
    let operandA = exactDefIdentityOpOperandOrInvalid(op, 0)
    let operandB = exactDefIdentityOpOperandOrInvalid(op, 1)
    let operandC = exactDefIdentityOpOperandOrInvalid(op, 2)
    return Fmt"({operandA},{operandB},{operandC})"

@borrows
fn exactDefIdentityConsumePathFactsEmit(bodyIR: coreir.BodyIR,
                                        opBlockIds: int32[],
                                        phase: str) =
    let functionRow = bodyIR.controlFunctionRow
    exactDefIdentityVerdictEmit(
        Fmt"cheng_cold: exact consume path facts [{phase}] fn={functionRow} blocks={bodyIR.blocks.len} ops={bodyIR.ops.len} slots={bodyIR.localSlots.len} calls={bodyIR.callSequence.len}")
    for block in 0..<bodyIR.blocks.len:
        let termIndex = bodyIR.blocks[block].termIndex
        var termKind: int32 = -1
        var termTrue: int32 = -1
        var termFalse: int32 = -1
        if termIndex >= 0 && termIndex < bodyIR.terms.len:
            termKind = Int32(bodyIR.terms[termIndex].kind)
            termTrue = bodyIR.terms[termIndex].trueBlock
            termFalse = bodyIR.terms[termIndex].falseBlock
        exactDefIdentityVerdictEmit(
            Fmt"cheng_cold: exact consume path block fn={functionRow} block={block} op_start={bodyIR.blocks[block].opStart} op_count={bodyIR.blocks[block].opCount} term={termIndex} term_kind={termKind} term_true={termTrue} term_false={termFalse}")
    for opRow in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opRow]
        let sourceRow = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
        var opBlock: int32 = -1
        if opRow < opBlockIds.len:
            opBlock = opBlockIds[opRow]
        var callText: str
        if op.kind == coreir.BodyOpCallTag && op.operands.len == 1:
            let callRow = op.operands[0]
            if callRow >= 0 && callRow < bodyIR.callSequence.len:
                let managedStore =
                    bodyIR.callSequence[callRow].managedStoreKind
                let argStart = bodyIR.exactDef.callArgStarts[callRow]
                let argCount = bodyIR.exactDef.callArgCounts[callRow]
                callText = Fmt" cseq={callRow} managed_store={managedStore} args={argCount}"
                var argOrdinal: int32
                while argOrdinal < argCount:
                    let argRow = argStart + argOrdinal
                    var argDef: int32 = -1
                    var argOwn: int32 = -1
                    if argRow >= 0 &&
                       argRow < bodyIR.exactDef.argDefOpRows.len:
                        argDef = bodyIR.exactDef.argDefOpRows[argRow]
                        argOwn = bodyIR.exactDef.argOwnerships[argRow]
                    callText = Fmt"{callText} arg{argOrdinal}=def:{argDef} own:{argOwn}"
                    argOrdinal = argOrdinal + 1
        exactDefIdentityVerdictEmit(
            Fmt"cheng_cold: exact consume path op fn={functionRow} op={opRow} kind={op.kind} target={op.target} block={opBlock} place={bodyIR.exactDef.opPlaceKinds[opRow]} origin={bodyIR.exactDef.opOriginIds[opRow]} producer={bodyIR.exactDef.opProducerFunctionRows[opRow]} vds={op.valueDefSlot} vdo={Int32(op.valueDefOwnership)} consume={op.valueDefConsumeOpIndexPlusOne} src_row={sourceRow} action_row={op.consumeActionRow} operands={exactDefIdentityConsumePathOperandsText(op)}{callText}")
    for definition in 0..<bodyIR.ops.len:
        if bodyIR.ops[definition].valueDefSlot < 0:
            continue
        for consumer in 0..<bodyIR.ops.len:
            if !freeze.ExactDefFreezeIdentityOpConsumesDefinition(
                   bodyIR, definition, consumer):
                continue
            var consumerBlock: int32 = -1
            if consumer < opBlockIds.len:
                consumerBlock = opBlockIds[consumer]
            exactDefIdentityVerdictEmit(
                Fmt"cheng_cold: exact consume path edge fn={functionRow} def={definition} consumer={consumer} consumer_kind={bodyIR.ops[consumer].kind} consumer_block={consumerBlock}")

# ---- 主审 (C 67588-70153 同构) ----

# 批 3 相位本体。相位序 (C 67752-67852/67861-69554/69555-69760/
# 69942-70152): 入口门 → 列门 → 预检循环(真空) → 块区间 → read-edge
# 总门 → 主审主循环 → 审计段 → 槽循环。
# 基板序说明: C 是 read-edge 总门 → 块区间; Cheng 块区间先于 read-edge
# 总门 — Cheng 支配缓存/工作区构建对非法块区间 hard-fail (panic, 批 2
# 同构), 块区间判词必须先于工作区求值才可达; 对块区间合法的 body
# (一切生产 body) 判词序与 C 完全一致 (块区间门恒静默)。
fn ExactDefIdentityPhaseValidateInto(
        bodyIR: var coreir.BodyIR,
        limits: freeze.ExactDefFreezeLimits,
        phase: str): bool =
    if !bodyIR.exactDef.sealed:
        panic("exact def identity: validate requires sealed sidecar")
    # 入口门 (C 67592-67614): null body 无 Cheng 载体 (值类型) → 真空;
    # symbols/producer 越界/结果摘要 ∉{OWNED,BORROW_SHARED} 的 Cheng
    # 权威 = controlFunctionRow 在界 (结果摘要权威在 TypedExpr 冻结列,
    # 批 5 契约表锚点; producer 越界由批 2 组合点 panic 同守)。
    if bodyIR.controlFunctionRow < 0:
        exactDefIdentityVerdictEmit(
            exactDefIdentityResultSummaryMissingLine(phase))
        return false
    let opCount = bodyIR.ops.len
    let slotCount = bodyIR.localSlots.len
    # 列门 (C 67625-67661): op 族 12 列的 Cheng 对应 = 侧车六列 +
    # BodyOp.valueDef*/sourceDefinition* 结构列 (恒在); C 的 dst/b/c
    # read-edge 列在 Cheng 无存储载体 (批 1 schema 冻结 readA 一列);
    # term 族无侧车列 (BodyTerm.sourceDefinition* 结构列恒在) → 真空。
    if opCount > 0 &&
       (bodyIR.exactDef.opPlaceKinds.len != opCount ||
        bodyIR.exactDef.opExactTypeIds.len != opCount ||
        bodyIR.exactDef.opOriginIds.len != opCount ||
        bodyIR.exactDef.opProducerFunctionRows.len != opCount ||
        bodyIR.exactDef.opSourceDefOpRows.len != opCount ||
        bodyIR.exactDef.opReadADefOpRows.len != opCount):
        exactDefIdentityVerdictEmit(
            exactDefIdentityColumnsMissingLine(phase, "op"))
        return false
    if slotCount > 0 &&
       (bodyIR.exactDef.slotPlaceKinds.len != slotCount ||
        bodyIR.exactDef.slotOriginIds.len != slotCount ||
        bodyIR.exactDef.slotStorageKinds.len != slotCount):
        exactDefIdentityVerdictEmit(
            exactDefIdentityColumnsMissingLine(phase, "slot"))
        return false
    if bodyIR.exactDef.argDefOpRows.len > 0 &&
       (bodyIR.exactDef.argPlaceKinds.len !=
            bodyIR.exactDef.argDefOpRows.len ||
        bodyIR.exactDef.argOwnerships.len !=
            bodyIR.exactDef.argDefOpRows.len ||
        bodyIR.exactDef.argOriginIds.len !=
            bodyIR.exactDef.argDefOpRows.len):
        exactDefIdentityVerdictEmit(
            exactDefIdentityColumnsMissingLine(phase, "call_arg"))
        return false
    if !exactdef.BodyIrExactDefSidecarShapeValid(bodyIR):
        panic("exact def identity: sidecar shape invalid")
    # 预检循环 (C 67663-67750): global scalar store tuple / typed ABI
    # pointer store / TEXT_SET_INIT 非规范 operands / plain pointer
    # fixed-array FIELD_REF / fixed-array index reference — 五臂全部
    # C-op-kind (I32_REF_STORE/PTR_STORE_I64/TEXT_SET_INIT/FIELD_REF/
    # ARRAY_*_INDEX_REF) 载体无 Cheng 对应行 → 真空 (判词不移植)。
    # 块区间门 (C 67760-67852): ① block_count>0 而块 op 区间列缺 —
    # Cheng blocks[] 为 dense 结构列 (opStart/opCount 恒在) → 真空;
    # ②③④ 实查。
    var coveredByBlock: int32[]
    setLen(coveredByBlock, opCount)
    for opRow in 0..<opCount:
        coveredByBlock[opRow] = -1
    var covered: int32
    var blockRangesValid = true
    for block in 0..<bodyIR.blocks.len:
        let start = bodyIR.blocks[block].opStart
        let count = bodyIR.blocks[block].opCount
        if start < 0 || count < 0 ||
           start > opCount || count > opCount - start:
            exactDefIdentityVerdictEmit(
                exactDefIdentityBlockRangeOutsideLine(
                    phase, block, start, count, opCount))
            return false
        for opRow in start..<start + count:
            let prior = coveredByBlock[opRow]
            if prior >= 0:
                exactDefIdentityVerdictEmit(
                    exactDefIdentityBlockRangeOverlapLine(
                        phase, block, start, count, prior,
                        bodyIR.blocks[prior].opStart,
                        bodyIR.blocks[prior].opCount))
                return false
            coveredByBlock[opRow] = block
            covered = covered + 1
    if covered != opCount:
        let functionRow = bodyIR.controlFunctionRow
        exactDefIdentityVerdictEmit(
            exactDefIdentityBlockRangeCoverLine(
                phase, functionRow, covered, opCount))
        var block = 0
        while block < bodyIR.blocks.len && block < 32:
            exactDefIdentityVerdictEmit(
                exactDefIdentityBlockRangeDumpLine(
                    functionRow, block, bodyIR.blocks[block].opStart,
                    bodyIR.blocks[block].opCount,
                    bodyIR.blocks[block].termIndex))
            block = block + 1
        var reported: int32
        for opRow in 0..<opCount:
            if reported >= 16:
                break
            if coveredByBlock[opRow] < 0:
                let op = bodyIR.ops[opRow]
                exactDefIdentityVerdictEmit(
                    exactDefIdentityOrphanOpDumpLine(
                        functionRow, opRow, op.kind, op.target,
                        exactDefIdentityOpOperandOrInvalid(op, 0),
                        exactDefIdentityOpOperandOrInvalid(op, 1),
                        exactDefIdentityOpOperandOrInvalid(op, 2)))
                reported = reported + 1
        return false
    var dom = freeze.ExactDefFreezeDominatorsBuild(bodyIR)
    var workspace = freeze.ExactDefFreezeIdentityWorkspaceAcquire(bodyIR)
    # read-edge 总门 (C 67752-67758): 批 2 终校验同源调用。
    if !freeze.ExactDefFreezeIdentityReadEdgeTerminalValidate(
           bodyIR, dom, workspace):
        exactDefIdentityVerdictEmit(
            exactDefIdentityReadEdgesGateLine(phase))
        return false
    # 主审主循环 (C 67861-69554)。raw seq mutation owner (67862) 与
    # open-drop 义务/标记对 (67891-67940) 的 C op-kind 载体 (SEQ_*_
    # INDEX_STORE/COPY_*+c≠0) 无 Cheng 对应行 → 真空 (注释)。
    for i in 0..<opCount:
        let op = bodyIR.ops[i]
        let slot = op.valueDefSlot
        let exactType = bodyIR.exactDef.opExactTypeIds[i]
        let producer = bodyIR.exactDef.opProducerFunctionRows[i]
        let place = bodyIR.exactDef.opPlaceKinds[i]
        let ownership = Int32(op.valueDefOwnership)
        let origin = bodyIR.exactDef.opOriginIds[i]
        let consumePlusOne = op.valueDefConsumeOpIndexPlusOne
        let source = freeze.ExactDefFreezeIdentityOpSourceDefRow(op)
        # 空组哨兵形 (C 67941-67946) 七列全空。
        if slot == -1 && exactType == -1 && producer == -1 &&
           place == exactdef.BodyIrExactDefPlaceInvalidTag &&
           ownership == Int32(coreir.OwnInvalid) && origin == -1 &&
           consumePlusOne == 0:
            # cleanup 物化消费行 (drop-glue/快照/投影释放行) 的 Cheng
            # 同源证据 = consumeActionRow (CanonicalCleanupAction
            # int32 行, cleanup 物化唯一发戳车道); C 的 release/
            # mutation/managed-replace tuple 豁免链 (67965-67999)、
            # string release (68000-68004)、generic structural copy
            # (68005-68009) 的 op-kind/Symbols 载体全无 → 由在界
            # consumeActionRow 放电。
            if op.consumeActionRow >= 0:
                continue
            # C 豁免链真空臂 (载体无 Cheng 对应行, 判词不移植):
            # EXACT_PLAIN_SCOPE_END tuple (68010-68030) / scalar
            # field read source (68031-68035) / scalar borrow
            # projection root drift (68036-68055) / managed opaque
            # index 缺定义硬拒 (68056-68077) / opaque object append
            # (68078-68111) / PAYLOAD_STORE call-temporary 消费硬拒
            # (68173-68194) / global payload store tuple
            # (68195-68225)。
            if source == -1 && op.kind == coreir.BodyOpCopyLocalTag:
                var destinationStorage =
                    exactdef.BodyIrExactDefStorageUnknownTag
                if op.target >= 0 && op.target < slotCount:
                    destinationStorage =
                        bodyIR.exactDef.slotStorageKinds[op.target]
                var sourceStorage =
                    exactdef.BodyIrExactDefStorageUnknownTag
                var copySource: int32 = -1
                if op.operands.len >= 1:
                    copySource = op.operands[0]
                    if copySource >= 0 && copySource < slotCount:
                        sourceStorage =
                            bodyIR.exactDef.slotStorageKinds[copySource]
                let managedEither = destinationStorage ==
                        exactdef.BodyIrExactDefStorageStrTag ||
                    destinationStorage ==
                        exactdef.BodyIrExactDefStorageSequenceTag ||
                    destinationStorage ==
                        exactdef.BodyIrExactDefStorageObjectTag ||
                    sourceStorage ==
                        exactdef.BodyIrExactDefStorageStrTag ||
                    sourceStorage ==
                        exactdef.BodyIrExactDefStorageSequenceTag ||
                    sourceStorage ==
                        exactdef.BodyIrExactDefStorageObjectTag
                if managedEither:
                    exactDefIdentityVerdictEmit(
                        exactDefIdentityManagedCopySourceLine(
                            phase, bodyIR.controlFunctionRow, i,
                            op.kind, op.target, destinationStorage,
                            copySource, sourceStorage))
                    return false
            if source == -1:
                continue
            # consume-only 边校验 (C 68256-68278): managed_append
            # (SEQ_*_ADD) / managed_ref_store (STR_REF_STORE/
            # PAYLOAD_STORE) / managed_index_store (SEQ_OPAQUE_INDEX_
            # STORE) 载体真空; managed_drop 的 COPY_COMPOSITE 同形同
            # 构 → Cheng CopyLocal (双槽 typeKind/sizeBytes 双等)。
            var managedDrop = false
            if op.kind == coreir.BodyOpCopyLocalTag &&
               op.operands.len == 1 &&
               op.target >= 0 && op.target < slotCount &&
               op.operands[0] >= 0 && op.operands[0] < slotCount:
                managedDrop =
                    bodyIR.localSlots[op.target].typeKind ==
                        bodyIR.localSlots[op.operands[0]].typeKind &&
                    bodyIR.localSlots[op.target].sizeBytes ==
                        bodyIR.localSlots[op.operands[0]].sizeBytes
            var consumedSlot: int32 = -1
            if managedDrop:
                consumedSlot = op.operands[0]
            var sourceOwnershipValid = false
            if source >= 0 && source < opCount:
                let sourceOwn = bodyIR.ops[source].valueDefOwnership
                sourceOwnershipValid = sourceOwn == coreir.OwnMove ||
                    sourceOwn == coreir.OwnPlain
            if source < 0 || source >= opCount ||
               !freeze.ExactDefFreezeIdentityReaches(
                   bodyIR, dom, workspace.opBlockIds, source, i) ||
               !managedDrop || consumedSlot < 0 ||
               bodyIR.ops[source].valueDefSlot != consumedSlot ||
               !sourceOwnershipValid:
                exactDefIdentityVerdictEmit(
                    exactDefIdentityConsumeOnlyEdgeLine(
                        phase, bodyIR.controlFunctionRow, i))
                return false
            continue
        # has partial definition tuple (C 68340-68372): 触发析取逐字;
        # GLOBAL_ADDR → Cheng GlobalLoad 对应物 (注释锚定)。
        if slot < 0 || slot >= slotCount ||
           (exactType < 0 &&
            !(op.kind == coreir.BodyOpGlobalLoadTag &&
              place == exactdef.BodyIrExactDefPlaceGlobalTag)) ||
           producer < 0 ||
           producer != bodyIR.controlFunctionRow ||
           (ownership != Int32(coreir.OwnPlain) &&
            ownership != Int32(coreir.OwnMove) &&
            ownership != Int32(coreir.OwnBorrowShared) &&
            ownership != Int32(coreir.OwnBorrowUnique)) ||
           (place != exactdef.BodyIrExactDefPlaceTemporaryTag &&
            place != exactdef.BodyIrExactDefPlaceStackLocalTag &&
            place != exactdef.BodyIrExactDefPlaceParamTag &&
            place != exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
            place != exactdef.BodyIrExactDefPlaceGlobalTag &&
            place != exactdef.BodyIrExactDefPlaceCfgMergeTag &&
            place != exactdef.BodyIrExactDefPlaceSharedCopyTag &&
            place != exactdef.BodyIrExactDefPlaceMemoryVersionTag) ||
           origin < 0 || consumePlusOne < 0 ||
           consumePlusOne > opCount:
            exactDefIdentityVerdictEmit(
                exactDefIdentityPartialDefinitionTupleLine(
                    phase, bodyIR.controlFunctionRow, i, slot,
                    exactType, producer, bodyIR.controlFunctionRow,
                    place, ownership, origin, consumePlusOne, opCount,
                    op.kind, op.target,
                    exactDefIdentityOpOperandOrInvalid(op, 0),
                    exactDefIdentityOpOperandOrInvalid(op, 1),
                    exactDefIdentityOpOperandOrInvalid(op, 2)))
            return false
        # op 层 type+storage 子句 (C 68374-68426): storage 规范义务的
        # 冻结层权威 = recorded 列 (derive 落戳即规范义务; TypeArena
        # layoutChild 证据窗不在冻结投影, 上游不变式放电 — 与槽循环
        # expected 同源裁定); type_less_global_root 豁免的 Cheng 形
        # (GlobalLoad+GLOBAL+未证 TypeId+recorded UNKNOWN+槽静态道
        # UNKNOWN 未绑 nominal 聚合) 与批 1 derive 车道同构。
        let storage = bodyIR.exactDef.slotStorageKinds[slot]
        let typelessGlobalRoot =
            op.kind == coreir.BodyOpGlobalLoadTag &&
            place == exactdef.BodyIrExactDefPlaceGlobalTag &&
            exactType < 0 &&
            storage == exactdef.BodyIrExactDefStorageUnknownTag &&
            bodyIR.localSlots[slot].typeKind ==
                coreir.LocalAggregateTag &&
            bodyIR.localSlots[slot].typeArenaTypeId < 0
        # [wall104] def↔slot TypeId 相等子句的字段投影借视形豁免:
        # derive 侧已证该形 (BorrowProjection ∧ BORROW_SHARED ∧
        # FieldLoad ∧ 借主域有效) 的 def 行权威 exactType (借主行
        # transport 冻结) 与槽权威 typeArenaTypeId (字段自身 storage,
        # BodyIRBindLocalSlotTypeArenaProof) 相等按构造不成立
        # (wall90; v6 实况 20 vs 16, sz/al 双 8), 相等子句在该形恒拒
        # = 预存墙。豁免后改核 hop 已证三元组冻结残形 (derive hop 命
        # 中即配对绑定槽 TypeId canonical fact closure); 不合形/复核
        # 不过仍落原判词, 其余形状相等子句逐字保留 — 守卫覆盖面不变。
        let fieldProjectionBorrow =
            op.kind == coreir.BodyOpFieldLoadTag &&
            ownership == Int32(coreir.OwnBorrowShared) &&
            op.valueDefBorrowOwnerDefinitionDomain !=
                coreir.BodyDefinitionDomainInvalidTag &&
            place == exactdef.BodyIrExactDefPlaceBorrowProjectionTag
        if (storage == exactdef.BodyIrExactDefStorageUnknownTag &&
            !typelessGlobalRoot) ||
           (exactType >= 0 &&
            bodyIR.localSlots[slot].typeArenaTypeId != exactType &&
            !(fieldProjectionBorrow &&
              exactDefIdentityFieldProjectionHopTripleValid(
                  bodyIR, i))):
            exactDefIdentityVerdictEmit(
                exactdef.BodyIrExactDefSlotAuthorityMismatchLine(
                    phase, bodyIR.controlFunctionRow, i, slot,
                    bodyIR.localSlots[slot].typeKind,
                    bodyIR.localSlots[slot].sizeBytes,
                    bodyIR.localSlots[slot].name,
                    op.kind, op.target,
                    exactDefIdentityOpOperandOrInvalid(op, 0),
                    exactDefIdentityOpOperandOrInvalid(op, 1),
                    exactDefIdentityOpOperandOrInvalid(op, 2),
                    source, bodyIR.exactDef.opReadADefOpRows[i],
                    exactType,
                    bodyIR.localSlots[slot].typeArenaTypeId,
                    place, bodyIR.exactDef.slotPlaceKinds[slot],
                    origin, bodyIR.exactDef.slotOriginIds[slot],
                    storage, storage))
            return false
        # place 八臂分派 (C 68427-69392)。
        if place == exactdef.BodyIrExactDefPlaceTemporaryTag:
            if !exactDefIdentityTemporaryDefinitionValid(
                   bodyIR, dom, workspace, limits, phase, i):
                return false
        elif place == exactdef.BodyIrExactDefPlaceStackLocalTag:
            if !exactDefIdentityStackLocalDefinitionValid(
                   bodyIR, dom, workspace, limits, phase, i):
                return false
        elif place == exactdef.BodyIrExactDefPlaceParamTag:
            if !exactDefIdentityParamDefinitionValid(bodyIR, phase, i):
                return false
        elif place == exactdef.BodyIrExactDefPlaceBorrowProjectionTag:
            if !exactDefIdentityBorrowProjectionDefinitionValid(
                   bodyIR, dom, workspace, limits, phase, i):
                return false
        elif place == exactdef.BodyIrExactDefPlaceGlobalTag:
            if !exactDefIdentityGlobalDefinitionValid(bodyIR, phase, i):
                return false
        elif place == exactdef.BodyIrExactDefPlaceSharedCopyTag:
            if !exactDefIdentitySharedCopyDefinitionValid(
                   bodyIR, dom, workspace.opBlockIds, phase, i):
                return false
        elif place == exactdef.BodyIrExactDefPlaceMemoryVersionTag:
            # MEMORY_VERSION var-out 臂 (C 68805-68822) = 批 5 锚点
            # (cold_exact_schema_var_out_definition_valid; 判词
            # `call memory version is broken call formal carrier`
            # 属批 5 判词表, 不预审)。
            panic("exact def identity: MEMORY_VERSION definition arm is batch 5 scope")
        else:
            # CFG_MERGE 臂 (C 69392-69553) = 批 4 落地
            # (cold_exact_memory_version_cfg_merge_valid 的 NOP/MV 形
            # 载体在 Cheng 无对应行 → COPY_COMPOSITE 形全字段门;
            # 规格 §6.3 同一行两面: 批 4 管发射权威, 批 3 管 seal 后
            # 主审 — exact_def_merge 的 21 字段审计即本臂真实现)。
            if !exactdefmerge.ExactDefMergeCfgMergeDefinitionValid(
                   bodyIR, dom, workspace, limits, phase, i):
                return false
    # 审计段 (C 69555-69760, 规格 §7): 与主审同函数顺序执行, 共享批 2
    # consumer summary; `exact consumer summary is malformed` 真空
    # (批 2 build 恒成功); 两条 PLAIN 容忍臂的 EXACT_PLAIN_SCOPE_END/
    # 静态 str PLAIN storage 载体真空 (批 2 同裁定); term 循环三族
    # (void return tuple / borrowed return root / return definition,
    # C 69761-69923) = 批 5 锚点 (函数结果摘要/借用根权威); call_arg
    # 循环 (C 70154+) = 批 5 锚点。
    if !freeze.ExactDefFreezeIdentityConsumeEdgeAudit(
           bodyIR, dom, workspace, limits, phase):
        # [wall117c] 判词富化: 审计失败即列 consume path 全列实况
        # (守卫零改动; freeze 域后续臂取数用)。
        exactDefIdentityConsumePathFactsEmit(
            bodyIR, workspace.opBlockIds, phase)
        return false
    # 槽循环 (C 69942-70152): 倒排计数 + partial authority 门 + 计数门。
    var slotDefinitionCounts: int32[]
    setLen(slotDefinitionCounts, slotCount)
    for opRow in 0..<opCount:
        let defSlot = bodyIR.ops[opRow].valueDefSlot
        if defSlot < 0 || defSlot >= slotCount:
            continue
        # [wall104r3] 倒排计数过滤的 TypeId 相等子句同款豁免 (主循环
        # wall104 修法的槽层镜像): 字段投影借视形 def 行 TypeId =
        # 借主行权威, 槽 TypeId = 字段 storage 权威, 相等按构造不成立
        # (wall90 契约); 该形改核 hop 已证三元组冻结残形, 其余形状
        # 相等子句逐字保留 — 漂移行仍被跳过, 计数门覆盖面不变。
        let countFieldProjectionBorrow =
            bodyIR.ops[opRow].kind == coreir.BodyOpFieldLoadTag &&
            Int32(bodyIR.ops[opRow].valueDefOwnership) ==
                Int32(coreir.OwnBorrowShared) &&
            bodyIR.ops[opRow].valueDefBorrowOwnerDefinitionDomain !=
                coreir.BodyDefinitionDomainInvalidTag &&
            bodyIR.exactDef.opPlaceKinds[opRow] ==
                exactdef.BodyIrExactDefPlaceBorrowProjectionTag
        if (bodyIR.exactDef.opExactTypeIds[opRow] !=
               bodyIR.localSlots[defSlot].typeArenaTypeId &&
            !(countFieldProjectionBorrow &&
              exactDefIdentityFieldProjectionHopTripleValid(
                  bodyIR, opRow))) ||
           bodyIR.exactDef.opProducerFunctionRows[opRow] !=
               bodyIR.controlFunctionRow ||
           bodyIR.exactDef.opPlaceKinds[opRow] !=
               bodyIR.exactDef.slotPlaceKinds[defSlot] ||
           bodyIR.exactDef.opOriginIds[opRow] !=
               bodyIR.exactDef.slotOriginIds[defSlot]:
            continue
        if bodyIR.exactDef.slotPlaceKinds[defSlot] ==
               exactdef.BodyIrExactDefPlaceTemporaryTag &&
           bodyIR.exactDef.opOriginIds[opRow] != opRow:
            continue
        if slotDefinitionCounts[defSlot] == 2147483647:
            exactDefIdentityDie("exact slot definition count overflow")
        slotDefinitionCounts[defSlot] =
            slotDefinitionCounts[defSlot] + 1
    for slotRow in 0..<slotCount:
        # sentinel 豁免 (C 69967-70035) = 批 1 sentinel 单实现同源
        # (open_generic_param_placeholder 无 Cheng 载体 → 真空; C 的
        # `lacks mandatory aggregate/reference authority` 判词在
        # Cheng 基板真空 — 批 1 静态道即 C canonical_unmanaged 豁免,
        # 未绑 nominal 聚合按批 1 §5-2 真空裁定放行)。
        if exactdef.BodyIrExactDefSlotIsSentinel(bodyIR, slotRow):
            continue
        let exactType = bodyIR.localSlots[slotRow].typeArenaTypeId
        let place = bodyIR.exactDef.slotPlaceKinds[slotRow]
        let origin = bodyIR.exactDef.slotOriginIds[slotRow]
        let storage = bodyIR.exactDef.slotStorageKinds[slotRow]
        # [phaseB-enum-cold] 标量值载体槽 admit（kind 分裂桥接对齐,
        # C cheng_cold.c:58131 无条件臂收窄镜像）。C 冷链对
        # SLOT_I32/I64/F32/F64 值载体槽无条件 sentinel 豁免（不看绑定
        # 列）; Cheng 基板 BodyIrExactDefSlotIsSentinel 的绑定列前置
        # （tid>=0 ∨ mg 已分类 → 非 sentinel, 防 str/seq/object 托管
        # 载体误判的设计裁定）把「已绑 TypeArena proof 的非托管标量
        # 声明槽」踢出豁免域, 而该形在 lowering 侧无 def 戳通道
        # （wall105 定性: OwnPlain 无 TypedExpr value-def, derive 无
        # 从落戳）→ 槽循环 partial authority 必死（t_enum 与标量 let
        # 探针同判词实证, 判词序: pa_place/pa_origin/pa_stor_unknown
        # 三臂齐中）。本臂收窄镜像 C 已承认域: 标量 kind ∧ Unmanaged
        # ∧ 已绑 proof ∧ 侧车三列全 sentinel（未落戳, 非漂移）∧ 非
        # entry 形参 ∧ 全部写入 op 为直接值载入形且自身无 def 戳
        # （writers==0 孤儿槽与怪异写形不放行）。任一不符不进本臂,
        # 走原 partial authority 门 fail-closed。sentinel 谓词零改动、
        # derive 零写、计数门零放宽（continue 与 sentinel 同路, 计数
        # 门不触及）。
        var scalarCarrierAdmit =
            (bodyIR.localSlots[slotRow].typeKind ==
                 coreir.LocalI32Tag ||
             bodyIR.localSlots[slotRow].typeKind ==
                 coreir.LocalI64Tag ||
             bodyIR.localSlots[slotRow].typeKind ==
                 coreir.LocalF64Tag) &&
            bodyIR.localSlots[slotRow].managedStorageKind ==
                coreir.BodyManagedStorageUnmanagedTag &&
            exactType >= 0 &&
            place == exactdef.BodyIrExactDefPlaceInvalidTag &&
            origin == -1 &&
            storage == exactdef.BodyIrExactDefStorageUnknownTag
        if scalarCarrierAdmit:
            for paramSlotScan in 0..<bodyIR.entryParameterSlotIds.len:
                if bodyIR.entryParameterSlotIds[paramSlotScan] == slotRow:
                    scalarCarrierAdmit = false
                    break
        if scalarCarrierAdmit:
            var scalarWriterCount = 0
            for opRowScan in 0..<opCount:
                let opScan = bodyIR.ops[opRowScan]
                if opScan.target != slotRow:
                    continue
                if opScan.valueDefSlot >= 0 ||
                   (opScan.kind != coreir.BodyOpLoadConstTag &&
                    opScan.kind != coreir.BodyOpCopyLocalTag &&
                    opScan.kind != coreir.BodyOpLoadLocalTag &&
                    opScan.kind != coreir.BodyOpBinOpTag &&
                    opScan.kind != coreir.BodyOpCmpTag):
                    scalarCarrierAdmit = false
                    break
                scalarWriterCount = scalarWriterCount + 1
            if scalarWriterCount == 0:
                scalarCarrierAdmit = false
        if scalarCarrierAdmit:
            continue
        # [k5fix] 聚合值载体槽 admit（C cheng_cold.c:58326-58331 SLOT_VARIANT
        # 结构臂收窄镜像; .rebuild/k5_line/REPORT.md kind=5 钉位）。C 冷链
        # canonical-unmanaged 豁免域在标量无条件臂后紧跟 SLOT_VARIANT 臂:
        # 纯值聚合按结构核放行（variant_type 可解析 ∧ variant_count>0 ∧
        # slot_size==type_slot_size ∧ !managed_drop, 无任何写者检查）。
        # Cheng 移植镜像了标量臂与 sentinel 前置绑定列, 未镜像本臂 →
        # OwnPlain 非托管聚合绑定槽（var b = Box(v: 7), lowering 内联
        # FieldStore 构造无 TypedExpr value-def 通道, wall105 同根）被
        # sentinel 前置门踢出豁免域后在本槽循环 partial authority 三臂齐
        # 中 fail-closed, 拒的是 C 域内合法形。
        # C 结构核三守卫在 Cheng 的等价承担（逐条对照）:
        #   variant_type 可解析 → typeArenaTypeId>=0（BodyIRBindLocalSlot
        #   TypeArenaProof 的精确 int32 绑定证明; C 是文本名解析, Cheng
        #   身份纪律下 tid 即解析证明, 无文本形态可失败）;
        #   !managed_drop → managedStorageKind==Unmanaged（同一次 bind
        #   由 lowering 持 TypeArena 全量知识分类落列）;
        #   variant_count>0 ∧ slot_size==type_slot_size → 槽 kind=
        #   LocalAggregateTag ∧ 槽尺寸/对齐由同一 TypeArena 布局通道下放
        #   （构造侧 fail=8/9/11 形状门已证同源）。C 文本态可构造的
        #   「名字解析失败/空聚合/尺寸漂移」垃圾形在 Cheng tid 证明体系
        #   下不可构造, 故不设 typeFact 复核（typeFact 冻结投影是
        #   field-chain 稀疏车道, 非全 TypeArena 投影, 单跳 FieldLoad
        #   路径不落行 — k5fix 实证 tid=15 槽行缺失, 用作本臂证据会把
        #   C 域内合法形误拒; 第一版结构核即此教训）。
        # 本臂剩余条件皆为 C 已承认域的严格收窄: 侧车三列全 sentinel
        # （未落戳, 非漂移）∧ 非 entry 形参 ∧ 全部写入 op 自身无 def 戳
        # （写形不限、零写者允许 — C VARIANT 臂无写者检查; 携戳即漂移
        # fail-closed）∧ expected-storage 等式绑定（tid>=0 时义务=侧车
        # 列自等, 显式保留防漂移）。任一不符不进本臂, 走原 partial
        # authority 门 fail-closed。sentinel 谓词零改动、derive 零写、
        # 计数门零放宽（continue 与 sentinel 同路, 计数门不触及）。
        var aggregateCarrierAdmit =
            bodyIR.localSlots[slotRow].typeKind ==
                coreir.LocalAggregateTag &&
            bodyIR.localSlots[slotRow].managedStorageKind ==
                coreir.BodyManagedStorageUnmanagedTag &&
            exactType >= 0 &&
            place == exactdef.BodyIrExactDefPlaceInvalidTag &&
            origin == -1 &&
            storage == exactdef.BodyIrExactDefStorageUnknownTag &&
            storage == exactDefIdentityExpectedStorageForSlot(bodyIR, slotRow)
        if aggregateCarrierAdmit:
            for paramSlotScan in 0..<bodyIR.entryParameterSlotIds.len:
                if bodyIR.entryParameterSlotIds[paramSlotScan] == slotRow:
                    aggregateCarrierAdmit = false
                    break
        if aggregateCarrierAdmit:
            for opRowScan in 0..<opCount:
                let opScan = bodyIR.ops[opRowScan]
                if opScan.target != slotRow:
                    continue
                if opScan.valueDefSlot >= 0:
                    aggregateCarrierAdmit = false
                    break
        if aggregateCarrierAdmit:
            continue
        let expectedStorage =
            exactDefIdentityExpectedStorageForSlot(bodyIR, slotRow)
        # global_address_slot (C 70044-70050): 槽 kind∈{OBJECT_REF,
        # OPAQUE_REF,PTR,I64} → Cheng LocalPtrTag/LocalI64Tag 联合。
        let globalAddressSlot =
            place == exactdef.BodyIrExactDefPlaceGlobalTag &&
            (bodyIR.localSlots[slotRow].typeKind ==
                 coreir.LocalPtrTag ||
             bodyIR.localSlots[slotRow].typeKind ==
                 coreir.LocalI64Tag) &&
            exactType < 0
        # place 特化 origin 界 (C 70064-70090): GLOBAL 的
        # origin<global_count → 全局地址槽行域 (与 GLOBAL 臂同源);
        # MEMORY_VERSION 的 NOP+var-out+current 子句载体全无 →
        # 批 5 锚点, MV 槽戳恒非规范。
        # wall91 判词富化 (wall74/w80/w87 逐项先例): partial authority
        # 十二臂拆命名 let 逐项求值 (合取项逐字同, 仅短路求值改全项
        # 求值 — 全部子项为纯界内读, 布尔值零漂移) + sentinel 四值形 +
        # 槽上下文/触达证据 (writer/def/reader/arg 四通道计数) 一次入
        # 判词, 供下一墙定性取数。append-only 字段, 判词族/rc 零变化。
        let paType = exactType < 0 && !globalAddressSlot
        let paPlace =
            place != exactdef.BodyIrExactDefPlaceTemporaryTag &&
            place != exactdef.BodyIrExactDefPlaceStackLocalTag &&
            place != exactdef.BodyIrExactDefPlaceParamTag &&
            place != exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
            place != exactdef.BodyIrExactDefPlaceGlobalTag &&
            place != exactdef.BodyIrExactDefPlaceCfgMergeTag &&
            place != exactdef.BodyIrExactDefPlaceSharedCopyTag &&
            place != exactdef.BodyIrExactDefPlaceMemoryVersionTag
        let paOrigin = origin < 0
        let paStorUnknown =
            storage == exactdef.BodyIrExactDefStorageUnknownTag &&
            !globalAddressSlot
        let paStorMismatch = storage != expectedStorage
        let paStackLocal =
            place == exactdef.BodyIrExactDefPlaceStackLocalTag &&
            origin != slotRow
        let paParam =
            place == exactdef.BodyIrExactDefPlaceParamTag &&
            origin >= bodyIR.entryParameterSlotIds.len
        let paBorrowProj =
            place == exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
            origin >= opCount
        let paGlobal =
            place == exactdef.BodyIrExactDefPlaceGlobalTag &&
            (origin >= slotCount ||
             bodyIR.localSlots[origin].placeKind !=
                 coreir.BodyPlaceGlobalAddressTag)
        let paCfgMerge =
            place == exactdef.BodyIrExactDefPlaceCfgMergeTag &&
            origin >= opCount
        let paSharedCopy =
            place == exactdef.BodyIrExactDefPlaceSharedCopyTag &&
            origin >= opCount
        let paMemoryVersion =
            place == exactdef.BodyIrExactDefPlaceMemoryVersionTag
        let sentinelShape =
            exactType < 0 &&
            place == exactdef.BodyIrExactDefPlaceInvalidTag &&
            origin < 0 &&
            storage == exactdef.BodyIrExactDefStorageUnknownTag
        let partialAuthority =
            paType || paPlace || paOrigin || paStorUnknown ||
            paStorMismatch || paStackLocal || paParam || paBorrowProj ||
            paGlobal || paCfgMerge || paSharedCopy || paMemoryVersion
        if partialAuthority:
            var originKind: int32 = -1
            var originSlot: int32 = -1
            var originPlace: int32 = -1
            var originOwnership: int32 = -1
            var originOrigin: int32 = -1
            if origin >= 0 && origin < opCount:
                originKind = bodyIR.ops[origin].kind
                originSlot = bodyIR.ops[origin].valueDefSlot
                originPlace = bodyIR.exactDef.opPlaceKinds[origin]
                originOwnership =
                    Int32(bodyIR.ops[origin].valueDefOwnership)
                originOrigin = bodyIR.exactDef.opOriginIds[origin]
            # wall91 槽触达证据扫描 (仅失败路径): target 写 / valueDef
            # 定义 / operand 读 / call arg (含地址编码形) 四通道计数。
            var writerCount: int32
            var defCount: int32
            var readerCount: int32
            for opRowScan in 0..<opCount:
                let opScan = bodyIR.ops[opRowScan]
                if opScan.target == slotRow:
                    writerCount = writerCount + 1
                if opScan.valueDefSlot == slotRow:
                    defCount = defCount + 1
                else:
                    for operandScan in opScan.operands:
                        if operandScan == slotRow:
                            readerCount = readerCount + 1
            var argCount: int32
            for callScan in 0..<bodyIR.callSequence.len:
                for argScan in bodyIR.callSequence[callScan].argSlots:
                    if argScan == slotRow:
                        argCount = argCount + 1
                    elif coreir.CallArgSlotIsAddress(argScan):
                        if coreir.CallArgSlotAddressId(argScan) == slotRow:
                            argCount = argCount + 1
            exactDefIdentityVerdictEmit(
                exactDefIdentitySlotPartialAuthorityLine(
                    phase, bodyIR.controlFunctionRow,
                    bodyIR.controlFunctionRow, slotRow,
                    bodyIR.localSlots[slotRow].typeKind, exactType,
                    place, origin, storage, expectedStorage, originKind,
                    originSlot, originPlace, originOwnership,
                    originOrigin, 0,
                    bodyIR.localSlots[slotRow].name,
                    bodyIR.localSlots[slotRow].sizeBytes,
                    bodyIR.localSlots[slotRow].alignBytes,
                    Int32(bodyIR.localSlots[slotRow].managedStorageKind),
                    exactDefIdentityBoolInt(sentinelShape),
                    exactDefIdentityBoolInt(paType),
                    exactDefIdentityBoolInt(paPlace),
                    exactDefIdentityBoolInt(paOrigin),
                    exactDefIdentityBoolInt(paStorUnknown),
                    exactDefIdentityBoolInt(paStorMismatch),
                    exactDefIdentityBoolInt(paStackLocal),
                    exactDefIdentityBoolInt(paParam),
                    exactDefIdentityBoolInt(paBorrowProj),
                    exactDefIdentityBoolInt(paGlobal),
                    exactDefIdentityBoolInt(paCfgMerge),
                    exactDefIdentityBoolInt(paSharedCopy),
                    exactDefIdentityBoolInt(paMemoryVersion),
                    writerCount, defCount, readerCount, argCount))
            return false
        # 计数门 (C 70121-70146): STACK_LOCAL⇒≥1; raw_abi_parameter
        # (==0) 的 Cheng 塌缩 — C 的双槽 raw ABI 载体/exact local 区分
        # 在 Cheng 单槽入参不存在 (参数定义 op 直接定义入参槽, 批 2
        # read-edge 自边裁定同源); Cheng 的 PARAM 槽车道只能由
        # entryParameterSlotIds 行获得 (derive 相 2/参数臂双向强制),
        # 故 PARAM⇒count≤1 即覆盖 C 两形: 无 op 定义 (raw 形, entry
        # 车道独存) ==0, 唯一 op 定义 (exact 形) ==1; FnDef
        # param_exact_type/kind/size 全等子句由 entry 冻结核过 (上游
        # 不变式)。其余 place⇒==1 (C 同)。
        let definitionCount = slotDefinitionCounts[slotRow]
        var definitionCountValid = definitionCount == 1
        if place == exactdef.BodyIrExactDefPlaceStackLocalTag:
            definitionCountValid = definitionCount >= 1
        elif place == exactdef.BodyIrExactDefPlaceParamTag:
            definitionCountValid = definitionCount <= 1
        if !definitionCountValid:
            exactDefIdentityVerdictEmit(
                exactDefIdentitySlotDefinitionCountLine(
                    phase, slotRow, definitionCount))
            return false
    return true

# 组合入口 (设计 §3.3 + 规格 §0 调用关系): 批 2 相位 (reissue →
# read-edge 完成/终校验 die 链 → consume 审计 → use-after-consume,
# freeze.ExactDefFreezeValidateInto 原样) 之后, 批 4 merge 校验
# (规格 §6.2: 在批 2 walker 事实之后, 同一实现幂等重证, 批 3 主审
# 消费其产物), 再批 3 相位按 C 判词序 (read-edge 总门 → 块区间 →
# 主审 → 审计, 块区间基板序见上) 顺序执行; phase 统一 "freeze"
# (与批 2 组合点同铭文)。
fn ExactDefIdentityValidateInto(
        bodyIR: var coreir.BodyIR,
        limits: freeze.ExactDefFreezeLimits): bool =
    if !freeze.ExactDefFreezeValidateInto(bodyIR, limits):
        return false
    if !exactdefmerge.ExactDefMergeValidateInto(bodyIR, limits):
        return false
    return ExactDefIdentityPhaseValidateInto(bodyIR, limits, "freeze")

# ---- 夹具专用判词文本出口 (unit 文本断言; 与批 2 同例) ----

@borrows
fn ExactDefIdentityTestResultSummaryMissingLine(phase: str): str =
    return exactDefIdentityResultSummaryMissingLine(phase)

@borrows
fn ExactDefIdentityTestColumnsMissingLine(phase: str,
                                          family: str): str =
    return exactDefIdentityColumnsMissingLine(phase, family)

@borrows
fn ExactDefIdentityTestReadEdgesGateLine(phase: str): str =
    return exactDefIdentityReadEdgesGateLine(phase)

@borrows
fn ExactDefIdentityTestPartialDefinitionTupleLine(
        phase: str,
        functionRow: int32,
        opRow: int32,
        slot: int32,
        exactType: int32,
        producer: int32,
        bodyProducer: int32,
        place: int32,
        ownership: int32,
        origin: int32,
        consumePlusOne: int32,
        opCount: int32,
        kind: int32,
        dst: int32,
        a: int32,
        b: int32,
        c: int32): str =
    return exactDefIdentityPartialDefinitionTupleLine(
        phase, functionRow, opRow, slot, exactType, producer,
        bodyProducer, place, ownership, origin, consumePlusOne,
        opCount, kind, dst, a, b, c)

# ---- 批 5 同源出口 (exact_def_call_authority 的批 3 基元复用面) ----
#
# 批 5 需要的三个批 3 域谓词 (param 定义边 / 点前活性查询 / 借用根冻结
# 权威) 按批 4 typeFact 四 helper 同款裁定迁入 freeze 持单实现
# (ExactDefFreezeAuthorityParamDefinitionEdgeValid /
# ExactDefFreezeAuthorityIsLiveBeforeOp /
# ExactDefFreezeAuthorityBorrowResultRootValid); 本模块内同名私有 fn 全
# 为委托别名 (函数计数与批 4 基线一致)。帧自有槽约定 helper
# (ExactDefIdentityDefinitionRootsFrameOwnedSlot) 本即公开名 (批 3 起),
# 批 5 四处接线 (批 3 两处 + root publication + 墙3 walk) 同源直用。
