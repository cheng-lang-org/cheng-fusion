# canonical Ownership/Init/Drop IR
#
# This module is independent from production lowering. It is the executable
# contract for ownership state, structured-scope cleanup, defer effects, and
# type-driven drop planning. Every uncertain fact is represented in the finite
# lattice; no last-use or layout heuristic participates in correctness.

import std/seqs
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/strings

const
    OwnershipDropDefinitionDomainInvalid: int32 = 0
    OwnershipDropDefinitionDomainEntrySlot: int32 = 1
    OwnershipDropDefinitionDomainBodyOp: int32 = 2
    OwnershipDropDefinitionDomainManualConsumePostCall: int32 = 3

    ownershipStateUninitialized: int32 = 1
    ownershipStateInitialized: int32 = 2
    ownershipStatePartial: int32 = 4
    ownershipStateMoved: int32 = 8
    ownershipStateDropped: int32 = 16

    ownershipEscapeNone: int32 = 1
    ownershipEscapeReturn: int32 = 2
    ownershipEscapeGlobal: int32 = 4
    ownershipEscapeThread: int32 = 8

type
    OwnershipClass = enum
        OwnershipUnknown
        Owned
        RcBorrowedValue
        VarBorrow
        Unmanaged
        # A caller-owned `var T` parameter.  The function owns the exclusive
        # capability, never the referent, so cleanup only retires the local
        # capability state and must not emit drop/release actions.
        ExternalVarBorrow

    InitState = enum
        InitUnknown
        Uninitialized
        Initialized
        Moved
        Dropped
        PartiallyInitialized
        ConditionallyInitialized

    OwnershipDropEscapeKind = enum
        EscapeUnknown
        NoEscape
        ReturnEscape
        GlobalEscape
        ThreadEscape

    OwnershipDropReturnSnapshotKind = enum
        ReturnSnapshotUnknown
        ReturnSnapshotRetain
        ReturnSnapshotClone

    OwnershipDropOpKind = enum
        OwnershipDropOpUnknown
        OwnershipDropOpInitialize
        OwnershipDropOpInitializeField
        OwnershipDropOpRcBorrow
        OwnershipDropOpEndRcBorrow
        OwnershipDropOpVarBorrow
        OwnershipDropOpEndVarBorrow
        OwnershipDropOpUseRead
        OwnershipDropOpUseWrite
        OwnershipDropOpActivateDefer
        OwnershipDropOpMove
        OwnershipDropOpRetainedAssign
        OwnershipDropOpConsume
        OwnershipDropOpDrop
        OwnershipDropOpMoveOut
        OwnershipDropOpInitializeExisting
        OwnershipDropOpManualConsumeTransfer

    OwnershipDropEdgeKind = enum
        OwnershipDropEdgeUnknown
        OwnershipDropEdgeNormal
        OwnershipDropEdgeReturn
        OwnershipDropEdgeBreak
        OwnershipDropEdgeContinue
        OwnershipDropEdgeLoopBack

    OwnershipDropDeferEffectKind = enum
        DeferEffectUnknown
        DeferEffectNoOwnership
        DeferEffectDropPlace
        DeferEffectMovePlace
        DeferEffectUseRead
        DeferEffectUseWrite
        DeferEffectEndRcBorrow
        DeferEffectEndVarBorrow
        DeferEffectPanic

    OwnershipDropCleanupActionKind = enum
        CleanupActionUnknown
        CleanupActionDefer
        CleanupActionDropField
        CleanupActionDropPlace
        CleanupActionRetainValue
        CleanupActionStoreOwned
        CleanupActionStoreMove
        CleanupActionSnapshotRetainOwnedReturn
        CleanupActionSnapshotCloneOwnedReturn
        CleanupActionRetainRcBorrowedReturn
        CleanupActionReturnUnmanaged

    OwnershipDropConditionKind = enum
        DropConditionUnknown
        DropConditionAlways
        DropConditionPlaceInitialized
        DropConditionFieldInitialized
        DropConditionCapturedOldPlace
        DropConditionCapturedOldField
        DropConditionDeferActive

    OwnershipDropConditionFlagKind = enum
        ConditionFlagUnknown
        ConditionFlagPlaceInitialized
        ConditionFlagFieldInitialized
        ConditionFlagDeferActive

    OwnershipDropFlagOriginKind = enum
        FlagOriginUnknown
        FlagOriginOp
        FlagOriginEdge

    OwnershipDropDefinitionOriginKind = enum
        DefinitionOriginUnknown
        DefinitionOriginTypedExpr
        DefinitionOriginCanonicalSyntheticAction

    OwnershipDropType =
        typeId: int32
        name: str
        dropGlueId: int32
        returnSnapshotKind: OwnershipDropReturnSnapshotKind
        returnSnapshotGlueId: int32
        returnSnapshotGlueSymbol: str
        fieldTypeStart: int32
        fieldCount: int32

    OwnershipDropScope =
        scopeId: int32
        parentScopeId: int32

    OwnershipDropPlace =
        placeId: int32
        typeId: int32
        ownership: OwnershipClass
        scopeId: int32
        fieldStateStart: int32
        fieldCount: int32
        initialDefinitionDomain: int32
        initialDefinitionRow: int32 = -1

    OwnershipDropOp =
        kind: OwnershipDropOpKind
        placeId: int32
        otherPlaceId: int32
        projectionToken: int32
        fieldOrdinal: int32
        escapeKind: OwnershipDropEscapeKind
        definitionOriginKind: OwnershipDropDefinitionOriginKind
        definitionOriginId: int32 = -1
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        sourceOwnership: OwnershipClass
        definitionDomain: int32
        definitionRow: int32 = -1
        manualConsumeRow: int32 = -1
        manualTargetDefinitionDomain: int32
        manualTargetDefinitionRow: int32 = -1
        manualSourceDefinitionDomain: int32
        manualSourceDefinitionRow: int32 = -1

    OwnershipDropBlock =
        blockId: int32
        scopeId: int32
        opStart: int32
        opCount: int32

    OwnershipDropDeferEffect =
        deferId: int32
        scopeId: int32
        declarationOrdinal: int32
        kind: OwnershipDropDeferEffectKind
        placeId: int32
        otherPlaceId: int32

    OwnershipDropEdge =
        edgeId: int32
        fromBlockId: int32
        toBlockId: int32
        kind: OwnershipDropEdgeKind
        returnPlaceId: int32
        cleanupPlaceStart: int32
        cleanupPlaceCount: int32
        deferIdStart: int32
        deferIdCount: int32
        resultExprNodeIndex: int32 = -1
        resultValueDefinitionRow: int32 = -1
        resultOwnership: OwnershipClass
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1

    OwnershipDropFlowState =
        reached: bool
        placeStateMasks: int32[]
        # Exact OwnershipDropOp producer for a live value created by a
        # canonical managed store. -1 means no canonical store producer.
        placeManagedProducerOpIds: int32[]
        # Exact BodyIR reaching-definition coordinate.  Domain 0/-1 is the
        # legacy unknown state; manual-consume transfer never accepts it.
        placeDefinitionDomains: int32[]
        placeDefinitionRows: int32[]
        # External var targets may have multiple exact reaching definitions
        # at a CFG join.  Entry is one bit per place; manual-post rows use a
        # dense place×IR-op matrix keyed by the immutable manual row.
        placeEntryDefinitionReachable: bool[]
        placeManualPostDefinitionReachable: bool[]
        fieldStateMasks: int32[]
        borrowSourcePlaceIds: int32[]
        borrowProjectionTokens: int32[]
        escapeMasks: int32[]
        deferActiveMasks: int32[]

    OwnershipDropCleanupAction =
        # CleanupActionDefer is an ordering marker. Its ownership effect is
        # expanded by this IR into the following canonical actions/state
        # transition and must not be replayed a second time by an emitter.
        # For CleanupActionStoreOwned, actionId is the stable captured-old
        # token. Store captures the old value plus its place/field init flags;
        # following drop actions with the same non-zero actionId consume that
        # snapshot after store, never the newly stored target value.
        # CapturedOld conditions use that snapshot token in conditionFlagId;
        # all other non-Always conditions reference conditionFlags by flagId.
        # The two condition atoms are ANDed after applying each negation. This
        # makes whole-glue and field-glue branches explicitly mutually exclusive.
        edgeId: int32
        opIndex: int32
        kind: OwnershipDropCleanupActionKind
        actionId: int32
        placeId: int32
        otherPlaceId: int32
        fieldOrdinal: int32
        typeId: int32
        dropGlueId: int32
        returnSnapshotGlueId: int32
        returnSnapshotGlueSymbol: str
        conditionKind: OwnershipDropConditionKind
        conditionFlagId: int32
        conditionNegated: bool
        conditionOtherKind: OwnershipDropConditionKind
        conditionOtherFlagId: int32
        conditionOtherNegated: bool
        # A conditional defer is an independent runtime guard around the
        # ownership predicates above. Keeping it separate preserves the two
        # predicate slots needed by partial aggregate drop planning.
        guardDeferId: int32
        guardDeferNegated: bool
        # Exact immutable value-definition authority. TypedExpr rows always
        # carry their defining BodyIR op. Canonical synthetic rows use the
        # cleanup action row itself and never borrow a parser-row identity.
        definitionOriginKind: OwnershipDropDefinitionOriginKind
        definitionOriginId: int32 = -1
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        # BodyIR CFG projection fills this on StoreOwned and its captured-old
        # drop actions.  It is the unique reaching definition of the value
        # being overwritten, never the retained source definition above.
        capturedOldSourceDefinitionDomain: int32
        capturedOldSourceDefinitionRow: int32 = -1
        sourceOwnership: OwnershipClass
        consumeActionRow: int32 = -1

    OwnershipDropActionConditionProjection =
        primaryKind: OwnershipDropConditionKind
        primaryFlagId: int32
        primaryNegated: bool
        secondaryKind: OwnershipDropConditionKind
        secondaryFlagId: int32
        secondaryNegated: bool
        guardKind: OwnershipDropConditionKind
        guardFlagId: int32
        guardNegated: bool
        guardDeferId: int32
        conditionCount: int32

    OwnershipDropReturnSnapshotProjection =
        kind: OwnershipDropReturnSnapshotKind
        edgeId: int32
        actionOrdinal: int32
        sourcePlaceId: int32
        typeId: int32
        glueId: int32
        glueSymbol: str
        resultExprNodeIndex: int32 = -1
        resultValueDefinitionRow: int32 = -1
        resultOwnership: OwnershipClass
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1

    OwnershipDropConditionFlag =
        flagId: int32
        kind: OwnershipDropConditionFlagKind
        placeId: int32
        fieldOrdinal: int32
        deferId: int32
        initialValue: bool

    OwnershipDropFlagTransition =
        originKind: OwnershipDropFlagOriginKind
        originId: int32
        flagId: int32
        setValue: bool
        afterActions: bool

    OwnershipDropIr =
        types: OwnershipDropType[]
        typeFieldTypeIds: int32[]
        scopes: OwnershipDropScope[]
        places: OwnershipDropPlace[]
        placeFieldStateCount: int32
        blocks: OwnershipDropBlock[]
        ops: OwnershipDropOp[]
        deferEffects: OwnershipDropDeferEffect[]
        edges: OwnershipDropEdge[]
        cleanupPlaceIds: int32[]
        edgeDeferIds: int32[]
        entryBlockId: int32
        storageReleased: bool

    OwnershipDropAnalysis =
        blockInputs: OwnershipDropFlowState[]
        blockOutputs: OwnershipDropFlowState[]
        opActionStarts: int32[]
        opActionCounts: int32[]
        edgeActionStarts: int32[]
        edgeActionCounts: int32[]
        cleanupActions: OwnershipDropCleanupAction[]
        conditionFlags: OwnershipDropConditionFlag[]
        flagTransitions: OwnershipDropFlagTransition[]
        fixedPointSteps: int32
        converged: bool
        storageReleased: bool

    OwnershipDropStorageReleaseReceipt =
        releasedOwnedSoaColumnCount: int32
        releasedSequenceInstanceCount: int32
        sequenceAllocCount: int32
        sequenceFreeCount: int32
        sequenceLiveCount: int32
        releasedSequenceBytes: int64
        liveSequenceBytes: int64
        releasedManagedStringValueCount: int32
        releasedManagedStringBytes: int64
        managedStringOwnedReleaseCount: int32
        managedStringPhysicalFreeCount: int32
        managedStringLiveReferenceCount: int32
        storageReleased: bool

@borrows
fn ownershipDropFail(message: str) =
    panic(strings.CloneStr(message))

@abi_internal
@importc("cheng_str_drop_owned")
fn ownershipDropReleaseOwnedStringRaw(value: var str)

fn OwnershipDropFlowStateOwnedSoaColumnCount(): int32 =
    return 11

fn OwnershipDropIrOwnedSoaColumnCount(): int32 =
    return 10

fn ownershipDropAnalysisTopLevelOwnedSoaColumnCount(): int32 =
    return 9

fn OwnershipDropAnalysisOwnedSoaColumnCount(): int32 =
    # blockInputs/blockOutputs each own every FlowState SoA column.
    return ownershipDropAnalysisTopLevelOwnedSoaColumnCount() +
           2 * OwnershipDropFlowStateOwnedSoaColumnCount()

@borrows
fn ownershipDropReleaseCheckedAddInt32(
        total: var int32,
        value: int32,
        message: str) =
    if value < 0 || total < 0 || total > 2147483647 - value:
        ownershipDropFail(message)
    total = total + value

@borrows
fn ownershipDropReleaseCheckedAddInt64(
        total: var int64,
        value: int64,
        message: str) =
    if value < int64(0) ||
       total < int64(0) ||
       total > int64(9223372036854775807) - value:
        ownershipDropFail(message)
    total = total + value

@borrows
fn ownershipDropReleaseCheckedMulInt64(
        lhs: int64,
        rhs: int64,
        message: str): int64 =
    if lhs < int64(0) || rhs < int64(0):
        ownershipDropFail(message)
    if lhs != int64(0) &&
       rhs > int64(9223372036854775807) / lhs:
        ownershipDropFail(message)
    return lhs * rhs

fn ownershipDropReleaseReceiptEmpty(
        receipt: var OwnershipDropStorageReleaseReceipt): bool =
    return receipt.releasedOwnedSoaColumnCount == 0 &&
           receipt.releasedSequenceInstanceCount == 0 &&
           receipt.sequenceAllocCount == 0 &&
           receipt.sequenceFreeCount == 0 &&
           receipt.sequenceLiveCount == 0 &&
           receipt.releasedSequenceBytes == int64(0) &&
           receipt.liveSequenceBytes == int64(0) &&
           receipt.releasedManagedStringValueCount == 0 &&
           receipt.releasedManagedStringBytes == int64(0) &&
           receipt.managedStringOwnedReleaseCount == 0 &&
           receipt.managedStringPhysicalFreeCount == 0 &&
           receipt.managedStringLiveReferenceCount == 0 &&
           !receipt.storageReleased

fn OwnershipDropStorageReleaseReceiptClosed(
        receipt: var OwnershipDropStorageReleaseReceipt,
        expectedOwnedSoaColumnCount: int32): bool =
    return receipt.storageReleased &&
           receipt.releasedOwnedSoaColumnCount ==
               expectedOwnedSoaColumnCount &&
           receipt.releasedSequenceInstanceCount > 0 &&
           receipt.sequenceAllocCount == receipt.sequenceFreeCount &&
           receipt.sequenceLiveCount == 0 &&
           receipt.releasedSequenceBytes >= int64(0) &&
           receipt.liveSequenceBytes == int64(0) &&
           receipt.releasedManagedStringValueCount >= 0 &&
           receipt.releasedManagedStringBytes >= int64(0) &&
           receipt.managedStringPhysicalFreeCount <=
               receipt.managedStringOwnedReleaseCount &&
           receipt.managedStringLiveReferenceCount == 0

fn ownershipDropReleaseSequence(
        values: var T[],
        receipt: var OwnershipDropStorageReleaseReceipt) =
    if values.len < 0 ||
       values.cap < 0 ||
       values.len > values.cap ||
       (values.cap == 0 && values.buffer != nil) ||
       (values.cap > 0 &&
        (values.buffer == nil ||
         system.memRefCount(values.buffer) != 1)):
        ownershipDropFail(
            "ownership_drop_ir: release sequence storage invalid or shared")
    ownershipDropReleaseCheckedAddInt32(
        receipt.releasedSequenceInstanceCount,
        1,
        "ownership_drop_ir: released sequence instance count overflow")
    let retainedCapacity: int32 = values.cap
    let retainedBytes = ownershipDropReleaseCheckedMulInt64(
        int64(retainedCapacity),
        int64(sizeof(T)),
        "ownership_drop_ir: released sequence byte count overflow")
    if retainedCapacity > 0:
        ownershipDropReleaseCheckedAddInt32(
            receipt.sequenceAllocCount,
            1,
            "ownership_drop_ir: sequence alloc count overflow")
        ownershipDropReleaseCheckedAddInt32(
            receipt.sequenceLiveCount,
            1,
            "ownership_drop_ir: sequence live count overflow")
        ownershipDropReleaseCheckedAddInt64(
            receipt.releasedSequenceBytes,
            retainedBytes,
            "ownership_drop_ir: released sequence byte count overflow")
        ownershipDropReleaseCheckedAddInt64(
            receipt.liveSequenceBytes,
            retainedBytes,
            "ownership_drop_ir: live sequence byte count overflow")
    seqs.chengSeqFreeTyped(values)
    if values.len != 0 || values.cap != 0 || values.buffer != nil:
        ownershipDropFail(
            "ownership_drop_ir: sequence physical release incomplete")
    if retainedCapacity > 0:
        ownershipDropReleaseCheckedAddInt32(
            receipt.sequenceFreeCount,
            1,
            "ownership_drop_ir: sequence free count overflow")
        receipt.sequenceLiveCount = receipt.sequenceLiveCount - 1
        receipt.liveSequenceBytes =
            receipt.liveSequenceBytes - retainedBytes

fn ownershipDropReleaseManagedString(
        value: var str,
        receipt: var OwnershipDropStorageReleaseReceipt) =
    if value.flags != 0 && value.flags != 1:
        ownershipDropFail(
            "ownership_drop_ir: managed string ownership flag invalid")
    if len(value) > 0:
        if value.data == nil:
            ownershipDropFail(
                "ownership_drop_ir: managed string data missing")
        ownershipDropReleaseCheckedAddInt32(
            receipt.releasedManagedStringValueCount,
            1,
            "ownership_drop_ir: managed string value count overflow")
        ownershipDropReleaseCheckedAddInt64(
            receipt.releasedManagedStringBytes,
            int64(len(value)),
            "ownership_drop_ir: managed string byte count overflow")
    let releasesOwnedReference =
        value.flags == 1 && value.data != nil
    var physicallyFreesAllocation: bool
    if releasesOwnedReference:
        let referenceCount = system.memRefCount(value.data)
        if referenceCount <= 0:
            ownershipDropFail(
                "ownership_drop_ir: managed string reference count invalid")
        physicallyFreesAllocation = referenceCount == 1
        ownershipDropReleaseCheckedAddInt32(
            receipt.managedStringOwnedReleaseCount,
            1,
            "ownership_drop_ir: managed string release count overflow")
        ownershipDropReleaseCheckedAddInt32(
            receipt.managedStringLiveReferenceCount,
            1,
            "ownership_drop_ir: managed string live reference count overflow")
    ownershipDropReleaseOwnedStringRaw(value)
    if len(value) != 0 ||
       value.data != nil ||
       value.store_id != 0 ||
       value.flags != 0:
        ownershipDropFail(
            "ownership_drop_ir: managed string physical release incomplete")
    if releasesOwnedReference:
        if physicallyFreesAllocation:
            ownershipDropReleaseCheckedAddInt32(
                receipt.managedStringPhysicalFreeCount,
                1,
                "ownership_drop_ir: managed string physical free count overflow")
        receipt.managedStringLiveReferenceCount =
            receipt.managedStringLiveReferenceCount - 1

fn ownershipDropReleaseFlowStateInto(
        state: var OwnershipDropFlowState,
        receipt: var OwnershipDropStorageReleaseReceipt) =
    ownershipDropReleaseSequence(state.placeStateMasks, receipt)
    ownershipDropReleaseSequence(
        state.placeManagedProducerOpIds, receipt)
    ownershipDropReleaseSequence(
        state.placeDefinitionDomains, receipt)
    ownershipDropReleaseSequence(
        state.placeDefinitionRows, receipt)
    ownershipDropReleaseSequence(
        state.placeEntryDefinitionReachable, receipt)
    ownershipDropReleaseSequence(
        state.placeManualPostDefinitionReachable, receipt)
    ownershipDropReleaseSequence(state.fieldStateMasks, receipt)
    ownershipDropReleaseSequence(state.borrowSourcePlaceIds, receipt)
    ownershipDropReleaseSequence(state.borrowProjectionTokens, receipt)
    ownershipDropReleaseSequence(state.escapeMasks, receipt)
    ownershipDropReleaseSequence(state.deferActiveMasks, receipt)
    state.reached = false

fn ownershipDropResetFlowState(state: var OwnershipDropFlowState) =
    var receipt: OwnershipDropStorageReleaseReceipt
    ownershipDropReleaseFlowStateInto(state, receipt)
    receipt.releasedOwnedSoaColumnCount =
        OwnershipDropFlowStateOwnedSoaColumnCount()
    receipt.storageReleased = true
    if receipt.releasedSequenceInstanceCount !=
           OwnershipDropFlowStateOwnedSoaColumnCount() ||
       !OwnershipDropStorageReleaseReceiptClosed(
           receipt,
           OwnershipDropFlowStateOwnedSoaColumnCount()):
        ownershipDropFail(
            "ownership_drop_ir: flow state physical release incomplete")

fn ownershipDropReleaseFlowStateRow(
        states: var OwnershipDropFlowState[],
        index: int32,
        receipt: var OwnershipDropStorageReleaseReceipt) =
    if index < 0 || index >= states.len:
        ownershipDropFail(
            "ownership_drop_ir: flow release row out of range")
    ownershipDropReleaseFlowStateInto(states[index], receipt)

fn ownershipDropReleaseScratchSequence(values: var T[]) =
    var receipt: OwnershipDropStorageReleaseReceipt
    ownershipDropReleaseSequence(values, receipt)
    receipt.releasedOwnedSoaColumnCount = 1
    receipt.storageReleased = true
    if receipt.releasedSequenceInstanceCount != 1 ||
       !OwnershipDropStorageReleaseReceiptClosed(receipt, 1):
        ownershipDropFail(
            "ownership_drop_ir: scratch sequence physical release incomplete")

fn ownershipDropSequenceStorageReleased(values: var T[]): bool =
    return values.len == 0 &&
           values.cap == 0 &&
           values.buffer == nil

fn OwnershipDropIrStorageReleased(ir: var OwnershipDropIr): bool =
    return ir.storageReleased &&
           ownershipDropSequenceStorageReleased(ir.types) &&
           ownershipDropSequenceStorageReleased(ir.typeFieldTypeIds) &&
           ownershipDropSequenceStorageReleased(ir.scopes) &&
           ownershipDropSequenceStorageReleased(ir.places) &&
           ownershipDropSequenceStorageReleased(ir.blocks) &&
           ownershipDropSequenceStorageReleased(ir.ops) &&
           ownershipDropSequenceStorageReleased(ir.deferEffects) &&
           ownershipDropSequenceStorageReleased(ir.edges) &&
           ownershipDropSequenceStorageReleased(ir.cleanupPlaceIds) &&
           ownershipDropSequenceStorageReleased(ir.edgeDeferIds) &&
           ir.placeFieldStateCount == 0 &&
           ir.entryBlockId == -1

fn OwnershipDropAnalysisStorageReleased(
        analysis: var OwnershipDropAnalysis): bool =
    return analysis.storageReleased &&
           ownershipDropSequenceStorageReleased(analysis.blockInputs) &&
           ownershipDropSequenceStorageReleased(analysis.blockOutputs) &&
           ownershipDropSequenceStorageReleased(analysis.opActionStarts) &&
           ownershipDropSequenceStorageReleased(analysis.opActionCounts) &&
           ownershipDropSequenceStorageReleased(analysis.edgeActionStarts) &&
           ownershipDropSequenceStorageReleased(analysis.edgeActionCounts) &&
           ownershipDropSequenceStorageReleased(analysis.cleanupActions) &&
           ownershipDropSequenceStorageReleased(analysis.conditionFlags) &&
           ownershipDropSequenceStorageReleased(analysis.flagTransitions) &&
           analysis.fixedPointSteps == 0 &&
           !analysis.converged

fn OwnershipDropIrRelease(
        ir: var OwnershipDropIr,
        receipt: var OwnershipDropStorageReleaseReceipt) =
    if ir.storageReleased:
        ownershipDropFail("ownership_drop_ir: ir storage already released")
    if !ownershipDropReleaseReceiptEmpty(receipt):
        ownershipDropFail(
            "ownership_drop_ir: ir release receipt must be empty")
    for typeIndex in 0..<ir.types.len:
        ownershipDropReleaseManagedString(
            ir.types[typeIndex].name, receipt)
        ownershipDropReleaseManagedString(
            ir.types[typeIndex].returnSnapshotGlueSymbol, receipt)
    ownershipDropReleaseSequence(ir.types, receipt)
    ownershipDropReleaseSequence(ir.typeFieldTypeIds, receipt)
    ownershipDropReleaseSequence(ir.scopes, receipt)
    ownershipDropReleaseSequence(ir.places, receipt)
    ownershipDropReleaseSequence(ir.blocks, receipt)
    ownershipDropReleaseSequence(ir.ops, receipt)
    ownershipDropReleaseSequence(ir.deferEffects, receipt)
    ownershipDropReleaseSequence(ir.edges, receipt)
    ownershipDropReleaseSequence(ir.cleanupPlaceIds, receipt)
    ownershipDropReleaseSequence(ir.edgeDeferIds, receipt)
    var cleared: OwnershipDropIr
    cleared.entryBlockId = -1
    cleared.storageReleased = true
    ir = cleared
    receipt.releasedOwnedSoaColumnCount =
        OwnershipDropIrOwnedSoaColumnCount()
    receipt.storageReleased = OwnershipDropIrStorageReleased(ir)
    if receipt.releasedSequenceInstanceCount !=
           OwnershipDropIrOwnedSoaColumnCount() ||
       !OwnershipDropStorageReleaseReceiptClosed(
           receipt,
           OwnershipDropIrOwnedSoaColumnCount()):
        ownershipDropFail(
            "ownership_drop_ir: ir physical release receipt incomplete")

fn OwnershipDropAnalysisRelease(
        analysis: var OwnershipDropAnalysis,
        receipt: var OwnershipDropStorageReleaseReceipt) =
    if analysis.storageReleased:
        ownershipDropFail(
            "ownership_drop_ir: analysis storage already released")
    if !ownershipDropReleaseReceiptEmpty(receipt):
        ownershipDropFail(
            "ownership_drop_ir: analysis release receipt must be empty")
    var flowStateInstanceCount: int32
    ownershipDropReleaseCheckedAddInt32(
        flowStateInstanceCount,
        analysis.blockInputs.len,
        "ownership_drop_ir: analysis input flow count overflow")
    ownershipDropReleaseCheckedAddInt32(
        flowStateInstanceCount,
        analysis.blockOutputs.len,
        "ownership_drop_ir: analysis output flow count overflow")
    let nestedSequenceInstanceCount64 =
        ownershipDropReleaseCheckedMulInt64(
            int64(flowStateInstanceCount),
            int64(OwnershipDropFlowStateOwnedSoaColumnCount()),
            "ownership_drop_ir: nested sequence instance count overflow")
    if nestedSequenceInstanceCount64 > int64(2147483647):
        ownershipDropFail(
            "ownership_drop_ir: nested sequence instance count overflow")
    var expectedSequenceInstanceCount: int32 =
        ownershipDropAnalysisTopLevelOwnedSoaColumnCount()
    ownershipDropReleaseCheckedAddInt32(
        expectedSequenceInstanceCount,
        int32(nestedSequenceInstanceCount64),
        "ownership_drop_ir: analysis sequence instance count overflow")
    for blockIndex in 0..<analysis.blockInputs.len:
        ownershipDropReleaseFlowStateRow(
            analysis.blockInputs, blockIndex, receipt)
    for blockIndex in 0..<analysis.blockOutputs.len:
        ownershipDropReleaseFlowStateRow(
            analysis.blockOutputs, blockIndex, receipt)
    for actionIndex in 0..<analysis.cleanupActions.len:
        ownershipDropReleaseManagedString(
            analysis.cleanupActions[actionIndex].returnSnapshotGlueSymbol,
            receipt)
    ownershipDropReleaseSequence(analysis.blockInputs, receipt)
    ownershipDropReleaseSequence(analysis.blockOutputs, receipt)
    ownershipDropReleaseSequence(analysis.opActionStarts, receipt)
    ownershipDropReleaseSequence(analysis.opActionCounts, receipt)
    ownershipDropReleaseSequence(analysis.edgeActionStarts, receipt)
    ownershipDropReleaseSequence(analysis.edgeActionCounts, receipt)
    ownershipDropReleaseSequence(analysis.cleanupActions, receipt)
    ownershipDropReleaseSequence(analysis.conditionFlags, receipt)
    ownershipDropReleaseSequence(analysis.flagTransitions, receipt)
    var cleared: OwnershipDropAnalysis
    cleared.storageReleased = true
    analysis = cleared
    receipt.releasedOwnedSoaColumnCount =
        OwnershipDropAnalysisOwnedSoaColumnCount()
    receipt.storageReleased =
        OwnershipDropAnalysisStorageReleased(analysis)
    if receipt.releasedSequenceInstanceCount !=
           expectedSequenceInstanceCount ||
       !OwnershipDropStorageReleaseReceiptClosed(
           receipt,
           OwnershipDropAnalysisOwnedSoaColumnCount()):
        ownershipDropFail(
            "ownership_drop_ir: analysis physical release receipt incomplete")

fn ownershipDropMaskHas(mask: int32, bit: int32): bool =
    return (mask / bit) % 2 == 1

fn ownershipDropMaskUnion(lhs: int32, rhs: int32): int32 =
    var out = lhs
    if ownershipDropMaskHas(rhs, ownershipStateUninitialized) &&
       !ownershipDropMaskHas(out, ownershipStateUninitialized):
        out = out + ownershipStateUninitialized
    if ownershipDropMaskHas(rhs, ownershipStateInitialized) &&
       !ownershipDropMaskHas(out, ownershipStateInitialized):
        out = out + ownershipStateInitialized
    if ownershipDropMaskHas(rhs, ownershipStatePartial) &&
       !ownershipDropMaskHas(out, ownershipStatePartial):
        out = out + ownershipStatePartial
    if ownershipDropMaskHas(rhs, ownershipStateMoved) &&
       !ownershipDropMaskHas(out, ownershipStateMoved):
        out = out + ownershipStateMoved
    if ownershipDropMaskHas(rhs, ownershipStateDropped) &&
       !ownershipDropMaskHas(out, ownershipStateDropped):
        out = out + ownershipStateDropped
    return out

fn ownershipDropEscapeMaskUnion(lhs: int32, rhs: int32): int32 =
    var out = lhs
    if ownershipDropMaskHas(rhs, ownershipEscapeNone) &&
       !ownershipDropMaskHas(out, ownershipEscapeNone):
        out = out + ownershipEscapeNone
    if ownershipDropMaskHas(rhs, ownershipEscapeReturn) &&
       !ownershipDropMaskHas(out, ownershipEscapeReturn):
        out = out + ownershipEscapeReturn
    if ownershipDropMaskHas(rhs, ownershipEscapeGlobal) &&
       !ownershipDropMaskHas(out, ownershipEscapeGlobal):
        out = out + ownershipEscapeGlobal
    if ownershipDropMaskHas(rhs, ownershipEscapeThread) &&
       !ownershipDropMaskHas(out, ownershipEscapeThread):
        out = out + ownershipEscapeThread
    return out

fn ownershipDropMaskHasLive(mask: int32): bool =
    return ownershipDropMaskHas(mask, ownershipStateInitialized) ||
           ownershipDropMaskHas(mask, ownershipStatePartial)

fn ownershipDropMaskDefinitelyInitialized(mask: int32): bool =
    return mask == ownershipStateInitialized

fn ownershipDropOwnershipValid(value: OwnershipClass): bool =
    return value == Owned ||
           value == RcBorrowedValue ||
           value == VarBorrow ||
           value == Unmanaged ||
           value == ExternalVarBorrow

@borrows
fn ownershipDropDefinitionOriginKnown(
        value: OwnershipDropDefinitionOriginKind): bool =
    return value == DefinitionOriginTypedExpr ||
           value == DefinitionOriginCanonicalSyntheticAction

fn ownershipDropDefinitionCoordinateValid(
        domain: int32,
        row: int32): bool =
    return row >= 0 &&
           (domain == OwnershipDropDefinitionDomainEntrySlot ||
            domain == OwnershipDropDefinitionDomainBodyOp ||
            domain ==
                OwnershipDropDefinitionDomainManualConsumePostCall)

@borrows
fn ownershipDropValidateDefinitionAuthority(
        originKind: OwnershipDropDefinitionOriginKind,
        originId: int32,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32,
        sourceOwnership: OwnershipClass,
        allowSynthetic: bool) =
    if !ownershipDropDefinitionOriginKnown(originKind) || originId < 0 ||
       !ownershipDropOwnershipValid(sourceOwnership) ||
       sourceOwnership == Unmanaged:
        ownershipDropFail("ownership_drop_ir: value-definition authority invalid")
    if originKind == DefinitionOriginTypedExpr:
        if !ownershipDropDefinitionCoordinateValid(
               sourceDefinitionDomain,
               sourceDefinitionRow):
            ownershipDropFail(
                "ownership_drop_ir: source definition coordinate missing")
    elif !allowSynthetic ||
         sourceDefinitionDomain != 0 ||
         sourceDefinitionRow != -1:
        ownershipDropFail(
            "ownership_drop_ir: canonical synthetic authority malformed")

@borrows
fn ownershipDropEdgeKindKnown(value: OwnershipDropEdgeKind): bool =
    return value == OwnershipDropEdgeNormal ||
           value == OwnershipDropEdgeReturn ||
           value == OwnershipDropEdgeBreak ||
           value == OwnershipDropEdgeContinue ||
           value == OwnershipDropEdgeLoopBack

@borrows
fn ownershipDropReturnSnapshotKindKnown(
        value: OwnershipDropReturnSnapshotKind): bool =
    return value == ReturnSnapshotRetain ||
           value == ReturnSnapshotClone

fn ownershipDropTypeIndex(ir: var OwnershipDropIr, typeId: int32): int32 =
    if typeId <= 0 || typeId > ir.types.len:
        ownershipDropFail("ownership_drop_ir: unknown type id")
    let index = typeId - 1
    if ir.types[index].typeId != typeId:
        ownershipDropFail("ownership_drop_ir: type index corrupt")
    return index

fn ownershipDropScopeIndex(ir: var OwnershipDropIr, scopeId: int32): int32 =
    if scopeId < 0 || scopeId >= ir.scopes.len:
        ownershipDropFail("ownership_drop_ir: unknown scope id")
    if ir.scopes[scopeId].scopeId != scopeId:
        ownershipDropFail("ownership_drop_ir: scope index corrupt")
    return scopeId

fn ownershipDropPlaceIndex(ir: var OwnershipDropIr, placeId: int32): int32 =
    if placeId <= 0 || placeId > ir.places.len:
        ownershipDropFail("ownership_drop_ir: unknown place id")
    let index = placeId - 1
    if ir.places[index].placeId != placeId:
        ownershipDropFail("ownership_drop_ir: place index corrupt")
    return index

fn ownershipDropBlockIndex(ir: var OwnershipDropIr, blockId: int32): int32 =
    if blockId < 0 || blockId >= ir.blocks.len:
        ownershipDropFail("ownership_drop_ir: unknown block id")
    if ir.blocks[blockId].blockId != blockId:
        ownershipDropFail("ownership_drop_ir: block index corrupt")
    return blockId

fn ownershipDropDeferIndex(ir: var OwnershipDropIr, deferId: int32): int32 =
    if deferId <= 0 || deferId > ir.deferEffects.len:
        ownershipDropFail("ownership_drop_ir: unknown defer id")
    let index = deferId - 1
    if ir.deferEffects[index].deferId != deferId:
        ownershipDropFail("ownership_drop_ir: defer index corrupt")
    return index

fn ownershipDropStoreFlow(states: var OwnershipDropFlowState[],
                          index: int32,
                          value: var OwnershipDropFlowState) =
    if index < 0 || index >= states.len:
        ownershipDropFail(
            "ownership_drop_ir: flow store row out of range")
    ownershipDropCloneFlow(value, states[index])

fn OwnershipDropIrInit(ir: var OwnershipDropIr) =
    if ir.storageReleased ||
       !ownershipDropSequenceStorageReleased(ir.types) ||
       !ownershipDropSequenceStorageReleased(ir.typeFieldTypeIds) ||
       !ownershipDropSequenceStorageReleased(ir.scopes) ||
       !ownershipDropSequenceStorageReleased(ir.places) ||
       !ownershipDropSequenceStorageReleased(ir.blocks) ||
       !ownershipDropSequenceStorageReleased(ir.ops) ||
       !ownershipDropSequenceStorageReleased(ir.deferEffects) ||
       !ownershipDropSequenceStorageReleased(ir.edges) ||
       !ownershipDropSequenceStorageReleased(ir.cleanupPlaceIds) ||
       !ownershipDropSequenceStorageReleased(ir.edgeDeferIds) ||
       ir.placeFieldStateCount != 0:
        ownershipDropFail("ownership_drop_ir: init requires empty ir")
    ir.placeFieldStateCount = 0
    ir.entryBlockId = -1
    var root: OwnershipDropScope
    root.scopeId = 0
    root.parentScopeId = -1
    add(ir.scopes, root)

fn OwnershipDropRootScopeId(ir: var OwnershipDropIr): int32 =
    if ir.scopes.len <= 0 || ir.scopes[0].parentScopeId != -1:
        ownershipDropFail("ownership_drop_ir: missing root scope")
    return 0

fn OwnershipDropAddScope(ir: var OwnershipDropIr, parentScopeId: int32): int32 =
    ownershipDropScopeIndex(ir, parentScopeId)
    var row: OwnershipDropScope
    row.scopeId = ir.scopes.len
    row.parentScopeId = parentScopeId
    add(ir.scopes, row)
    return row.scopeId

@borrows
fn ownershipDropRequireUniqueTypeName(ir: var OwnershipDropIr,
                                      typeName: str) =
    if len(typeName) == 0:
        ownershipDropFail("ownership_drop_ir: empty type name")
    for i in 0..<ir.types.len:
        if ir.types[i].name == typeName:
            ownershipDropFail("ownership_drop_ir: duplicate type name")

fn OwnershipDropRegisterLeafType(ir: var OwnershipDropIr,
                                 typeName: str,
                                 dropGlueId: int32): int32 =
    ownershipDropRequireUniqueTypeName(ir, typeName)
    if dropGlueId < 0:
        ownershipDropFail("ownership_drop_ir: invalid drop glue id")
    var row: OwnershipDropType
    row.typeId = ir.types.len + 1
    row.name = typeName
    row.dropGlueId = dropGlueId
    row.fieldTypeStart = ir.typeFieldTypeIds.len
    row.fieldCount = 0
    let typeId = row.typeId
    add(ir.types, row)
    return typeId

fn OwnershipDropRegisterAggregateType(ir: var OwnershipDropIr,
                                      typeName: str,
                                      dropGlueId: int32,
                                      fieldTypeIds: var int32[]): int32 =
    ownershipDropRequireUniqueTypeName(ir, typeName)
    if dropGlueId < 0:
        ownershipDropFail("ownership_drop_ir: invalid aggregate drop glue")
    if fieldTypeIds.len <= 0:
        ownershipDropFail("ownership_drop_ir: aggregate requires fields")
    let fieldStart = ir.typeFieldTypeIds.len
    var hasManagedField: bool
    for i in 0..<fieldTypeIds.len:
        let fieldTypeIndex = ownershipDropTypeIndex(ir, fieldTypeIds[i])
        if ir.types[fieldTypeIndex].dropGlueId > 0:
            hasManagedField = true
        add(ir.typeFieldTypeIds, fieldTypeIds[i])
    if hasManagedField && dropGlueId <= 0:
        ownershipDropFail("ownership_drop_ir: managed aggregate lacks unique drop glue")
    var row: OwnershipDropType
    row.typeId = ir.types.len + 1
    row.name = typeName
    row.dropGlueId = dropGlueId
    row.fieldTypeStart = fieldStart
    row.fieldCount = fieldTypeIds.len
    let typeId = row.typeId
    add(ir.types, row)
    return typeId

fn OwnershipDropSetTypeReturnSnapshotPolicy(
        ir: var OwnershipDropIr,
        typeId: int32,
        kind: OwnershipDropReturnSnapshotKind,
        snapshotGlueId: int32,
        snapshotGlueSymbol: str) =
    let typeIndex = ownershipDropTypeIndex(ir, typeId)
    if !ownershipDropReturnSnapshotKindKnown(kind) ||
       snapshotGlueId <= 0 || len(snapshotGlueSymbol) == 0:
        ownershipDropFail("ownership_drop_ir: invalid return snapshot policy")
    if ir.types[typeIndex].returnSnapshotKind != ReturnSnapshotUnknown ||
       ir.types[typeIndex].returnSnapshotGlueId != 0 ||
       len(ir.types[typeIndex].returnSnapshotGlueSymbol) != 0:
        ownershipDropFail("ownership_drop_ir: duplicate return snapshot policy")
    for placeIndex in 0..<ir.places.len:
        if ir.places[placeIndex].typeId == typeId:
            ownershipDropFail("ownership_drop_ir: snapshot policy after place creation")
    ir.types[typeIndex].returnSnapshotKind = kind
    ir.types[typeIndex].returnSnapshotGlueId = snapshotGlueId
    ir.types[typeIndex].returnSnapshotGlueSymbol = snapshotGlueSymbol

fn OwnershipDropAddPlace(ir: var OwnershipDropIr,
                         typeId: int32,
                         ownership: OwnershipClass,
                         scopeId: int32): int32 =
    let typeIndex = ownershipDropTypeIndex(ir, typeId)
    ownershipDropScopeIndex(ir, scopeId)
    if !ownershipDropOwnershipValid(ownership):
        ownershipDropFail("ownership_drop_ir: unknown ownership class")
    let glueId = ir.types[typeIndex].dropGlueId
    if (ownership == Owned || ownership == RcBorrowedValue) && glueId <= 0:
        ownershipDropFail("ownership_drop_ir: RC-managed place lacks drop glue")
    if ownership == Unmanaged && glueId != 0:
        ownershipDropFail("ownership_drop_ir: unmanaged place has drop glue")
    var row: OwnershipDropPlace
    row.placeId = ir.places.len + 1
    row.typeId = typeId
    row.ownership = ownership
    row.scopeId = scopeId
    row.fieldStateStart = ir.placeFieldStateCount
    row.fieldCount = ir.types[typeIndex].fieldCount
    row.initialDefinitionDomain = 0
    row.initialDefinitionRow = -1
    ir.placeFieldStateCount = ir.placeFieldStateCount + row.fieldCount
    add(ir.places, row)
    return row.placeId

fn OwnershipDropBindEntryDefinition(
        ir: var OwnershipDropIr,
        placeId: int32,
        definitionDomain: int32,
        definitionRow: int32) =
    let placeIndex = ownershipDropPlaceIndex(ir, placeId)
    if ir.blocks.len != 0 || ir.ops.len != 0 ||
       definitionDomain !=
           OwnershipDropDefinitionDomainEntrySlot ||
       definitionRow < 0 ||
       ir.places[placeIndex].initialDefinitionDomain != 0 ||
       ir.places[placeIndex].initialDefinitionRow != -1:
        ownershipDropFail(
            "ownership_drop_ir: entry definition authority invalid")
    var place = ir.places[placeIndex]
    place.initialDefinitionDomain = definitionDomain
    place.initialDefinitionRow = definitionRow
    ir.places[placeIndex] = place

fn OwnershipDropAddBlock(ir: var OwnershipDropIr, scopeId: int32): int32 =
    ownershipDropScopeIndex(ir, scopeId)
    var row: OwnershipDropBlock
    row.blockId = ir.blocks.len
    row.scopeId = scopeId
    row.opStart = ir.ops.len
    row.opCount = 0
    add(ir.blocks, row)
    return row.blockId

fn OwnershipDropSetEntryBlock(ir: var OwnershipDropIr, blockId: int32) =
    ownershipDropBlockIndex(ir, blockId)
    if ir.entryBlockId >= 0:
        ownershipDropFail("ownership_drop_ir: duplicate entry block")
    ir.entryBlockId = blockId

fn ownershipDropAppendOp(ir: var OwnershipDropIr,
                         blockId: int32,
                         op: OwnershipDropOp): int32 =
    let blockIndex = ownershipDropBlockIndex(ir, blockId)
    if blockIndex != ir.blocks.len - 1:
        ownershipDropFail("ownership_drop_ir: block ops must be contiguous")
    var block = ir.blocks[blockIndex]
    if block.opStart + block.opCount != ir.ops.len:
        ownershipDropFail("ownership_drop_ir: block op range corrupt")
    let opIndex = ir.ops.len
    add(ir.ops, op)
    block.opCount = block.opCount + 1
    ir.blocks[blockIndex] = block
    return opIndex

fn ownershipDropNewOp(kind: OwnershipDropOpKind,
                      placeId: int32,
                      otherPlaceId: int32,
                      projectionToken: int32,
                      fieldOrdinal: int32,
                      escapeKind: OwnershipDropEscapeKind,
                      out: var OwnershipDropOp) =
    out.kind = kind
    out.placeId = placeId
    out.otherPlaceId = otherPlaceId
    out.projectionToken = projectionToken
    out.fieldOrdinal = fieldOrdinal
    out.escapeKind = escapeKind
    out.definitionOriginKind = DefinitionOriginUnknown
    out.definitionOriginId = -1
    out.sourceDefinitionDomain = 0
    out.sourceDefinitionRow = -1
    out.sourceOwnership = OwnershipUnknown
    out.definitionDomain = 0
    out.definitionRow = -1
    out.manualConsumeRow = -1
    out.manualTargetDefinitionDomain = 0
    out.manualTargetDefinitionRow = -1
    out.manualSourceDefinitionDomain = 0
    out.manualSourceDefinitionRow = -1

fn OwnershipDropBindOpDefinitionCoordinate(
        ir: var OwnershipDropIr,
        opIndex: int32,
        definitionDomain: int32,
        definitionRow: int32) =
    if opIndex < 0 || opIndex >= ir.ops.len ||
       definitionDomain !=
           OwnershipDropDefinitionDomainBodyOp ||
       definitionRow < 0 ||
       ir.ops[opIndex].definitionDomain != 0 ||
       ir.ops[opIndex].definitionRow != -1 ||
       (ir.ops[opIndex].kind != OwnershipDropOpInitialize &&
        ir.ops[opIndex].kind != OwnershipDropOpInitializeField &&
        ir.ops[opIndex].kind != OwnershipDropOpMove &&
        ir.ops[opIndex].kind != OwnershipDropOpRetainedAssign):
        ownershipDropFail(
            "ownership_drop_ir: op definition coordinate invalid")
    var op = ir.ops[opIndex]
    op.definitionDomain = definitionDomain
    op.definitionRow = definitionRow
    ir.ops[opIndex] = op

fn OwnershipDropBindOpDefinitionAuthority(
        ir: var OwnershipDropIr,
        opIndex: int32,
        originKind: OwnershipDropDefinitionOriginKind,
        originId: int32,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32,
        sourceOwnership: OwnershipClass) =
    if opIndex < 0 || opIndex >= ir.ops.len:
        ownershipDropFail("ownership_drop_ir: definition authority op out of range")
    let kind = ir.ops[opIndex].kind
    if kind != OwnershipDropOpInitialize &&
       kind != OwnershipDropOpInitializeField &&
       kind != OwnershipDropOpMove &&
       kind != OwnershipDropOpRetainedAssign:
        ownershipDropFail(
            "ownership_drop_ir: definition authority op kind unsupported")
    if ir.ops[opIndex].definitionOriginKind != DefinitionOriginUnknown ||
       ir.ops[opIndex].definitionOriginId != -1 ||
       ir.ops[opIndex].sourceDefinitionDomain != 0 ||
       ir.ops[opIndex].sourceDefinitionRow != -1 ||
       ir.ops[opIndex].sourceOwnership != OwnershipUnknown:
        ownershipDropFail("ownership_drop_ir: definition authority rebound")
    ownershipDropValidateDefinitionAuthority(originKind,
                                             originId,
                                             sourceDefinitionDomain,
                                             sourceDefinitionRow,
                                             sourceOwnership,
                                             false)
    if (kind == OwnershipDropOpInitialize ||
        kind == OwnershipDropOpInitializeField) &&
       (originKind != DefinitionOriginTypedExpr ||
        sourceOwnership != Owned):
        ownershipDropFail(
            "ownership_drop_ir: initialize definition authority invalid")
    if kind == OwnershipDropOpMove && sourceOwnership != Owned:
        ownershipDropFail("ownership_drop_ir: move source authority is not owned")
    if kind == OwnershipDropOpRetainedAssign &&
       sourceOwnership != Owned &&
       sourceOwnership != RcBorrowedValue:
        ownershipDropFail(
            "ownership_drop_ir: retained source authority invalid")
    var op = ir.ops[opIndex]
    op.definitionOriginKind = originKind
    op.definitionOriginId = originId
    op.sourceDefinitionDomain = sourceDefinitionDomain
    op.sourceDefinitionRow = sourceDefinitionRow
    op.sourceOwnership = sourceOwnership
    ir.ops[opIndex] = op

fn OwnershipDropAppendInitialize(ir: var OwnershipDropIr,
                                 blockId: int32,
                                 placeId: int32): int32 =
    ownershipDropPlaceIndex(ir, placeId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpInitialize, placeId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendInitializeExisting(ir: var OwnershipDropIr,
                                         blockId: int32,
                                         placeId: int32): int32 =
    let placeIndex = ownershipDropPlaceIndex(ir, placeId)
    if ir.places[placeIndex].ownership != Owned:
        ownershipDropFail(
            "ownership_drop_ir: existing initialization targets non-owner")
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpInitializeExisting,
                       placeId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendInitializeField(ir: var OwnershipDropIr,
                                      blockId: int32,
                                      placeId: int32,
                                      fieldOrdinal: int32): int32 =
    let placeIndex = ownershipDropPlaceIndex(ir, placeId)
    if fieldOrdinal < 0 || fieldOrdinal >= ir.places[placeIndex].fieldCount:
        ownershipDropFail("ownership_drop_ir: unknown field ordinal")
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpInitializeField,
                       placeId, -1, -1, fieldOrdinal, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendRcBorrow(ir: var OwnershipDropIr,
                               blockId: int32,
                               ownerPlaceId: int32,
                               borrowedPlaceId: int32): int32 =
    ownershipDropPlaceIndex(ir, ownerPlaceId)
    ownershipDropPlaceIndex(ir, borrowedPlaceId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpRcBorrow,
                       ownerPlaceId, borrowedPlaceId, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendEndRcBorrow(ir: var OwnershipDropIr,
                                  blockId: int32,
                                  borrowedPlaceId: int32): int32 =
    ownershipDropPlaceIndex(ir, borrowedPlaceId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpEndRcBorrow,
                       borrowedPlaceId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendVarBorrow(ir: var OwnershipDropIr,
                                blockId: int32,
                                ownerPlaceId: int32,
                                borrowedPlaceId: int32,
                                projectionToken: int32): int32 =
    ownershipDropPlaceIndex(ir, ownerPlaceId)
    ownershipDropPlaceIndex(ir, borrowedPlaceId)
    if projectionToken < 0:
        ownershipDropFail("ownership_drop_ir: invalid var-borrow projection token")
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpVarBorrow,
                       ownerPlaceId, borrowedPlaceId, projectionToken, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendEndVarBorrow(ir: var OwnershipDropIr,
                                   blockId: int32,
                                   borrowedPlaceId: int32): int32 =
    ownershipDropPlaceIndex(ir, borrowedPlaceId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpEndVarBorrow,
                       borrowedPlaceId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendUseRead(ir: var OwnershipDropIr,
                              blockId: int32,
                              placeId: int32): int32 =
    ownershipDropPlaceIndex(ir, placeId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpUseRead, placeId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendUseWrite(ir: var OwnershipDropIr,
                               blockId: int32,
                               placeId: int32): int32 =
    ownershipDropPlaceIndex(ir, placeId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpUseWrite, placeId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendActivateDefer(ir: var OwnershipDropIr,
                                    blockId: int32,
                                    deferId: int32): int32 =
    let deferIndex = ownershipDropDeferIndex(ir, deferId)
    let blockIndex = ownershipDropBlockIndex(ir, blockId)
    if ir.deferEffects[deferIndex].scopeId != ir.blocks[blockIndex].scopeId:
        ownershipDropFail("ownership_drop_ir: defer activated outside declaration scope")
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpActivateDefer,
                       deferId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendMove(ir: var OwnershipDropIr,
                           blockId: int32,
                           fromPlaceId: int32,
                           toPlaceId: int32): int32 =
    ownershipDropPlaceIndex(ir, fromPlaceId)
    ownershipDropPlaceIndex(ir, toPlaceId)
    if fromPlaceId == toPlaceId:
        ownershipDropFail("ownership_drop_ir: self move is invalid")
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpMove,
                       fromPlaceId, toPlaceId, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendRetainedAssign(ir: var OwnershipDropIr,
                                     blockId: int32,
                                     targetPlaceId: int32,
                                     sourcePlaceId: int32): int32 =
    ownershipDropPlaceIndex(ir, targetPlaceId)
    ownershipDropPlaceIndex(ir, sourcePlaceId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpRetainedAssign,
                       targetPlaceId, sourcePlaceId, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendManualConsumeTransfer(
        ir: var OwnershipDropIr,
        blockId: int32,
        targetPlaceId: int32,
        sourcePlaceId: int32,
        manualConsumeRow: int32,
        targetDefinitionDomain: int32,
        targetDefinitionRow: int32,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32,
        postDefinitionDomain: int32,
        postDefinitionRow: int32): int32 =
    let targetIndex = ownershipDropPlaceIndex(ir, targetPlaceId)
    let sourceIndex = ownershipDropPlaceIndex(ir, sourcePlaceId)
    if ir.places[targetIndex].ownership != ExternalVarBorrow:
        ownershipDropFail(
            "ownership_drop_ir: manual-consume local post definition unsupported")
    if targetPlaceId == sourcePlaceId ||
       manualConsumeRow < 0 ||
       (targetDefinitionDomain !=
            OwnershipDropDefinitionDomainEntrySlot &&
       targetDefinitionDomain !=
            OwnershipDropDefinitionDomainManualConsumePostCall) ||
       targetDefinitionRow < 0 ||
       sourceDefinitionDomain <
           OwnershipDropDefinitionDomainEntrySlot ||
       sourceDefinitionDomain >
           OwnershipDropDefinitionDomainBodyOp ||
       sourceDefinitionRow < 0 ||
       postDefinitionDomain !=
           OwnershipDropDefinitionDomainManualConsumePostCall ||
       postDefinitionRow != manualConsumeRow ||
       ir.places[sourceIndex].ownership != Owned ||
       ir.places[targetIndex].typeId !=
           ir.places[sourceIndex].typeId:
        ownershipDropFail(
            "ownership_drop_ir: manual-consume transfer authority invalid")
    var op: OwnershipDropOp
    ownershipDropNewOp(
        OwnershipDropOpManualConsumeTransfer,
        targetPlaceId,
        sourcePlaceId,
        -1,
        -1,
        NoEscape,
        op)
    op.definitionDomain = postDefinitionDomain
    op.definitionRow = postDefinitionRow
    op.manualConsumeRow = manualConsumeRow
    op.manualTargetDefinitionDomain =
        targetDefinitionDomain
    op.manualTargetDefinitionRow = targetDefinitionRow
    op.manualSourceDefinitionDomain =
        sourceDefinitionDomain
    op.manualSourceDefinitionRow = sourceDefinitionRow
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendConsume(ir: var OwnershipDropIr,
                              blockId: int32,
                              placeId: int32): int32 =
    ownershipDropPlaceIndex(ir, placeId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpConsume, placeId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendDrop(ir: var OwnershipDropIr,
                           blockId: int32,
                           placeId: int32): int32 =
    ownershipDropPlaceIndex(ir, placeId)
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpDrop, placeId, -1, -1, -1, NoEscape, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropAppendMoveOut(ir: var OwnershipDropIr,
                              blockId: int32,
                              placeId: int32,
                              escapeKind: OwnershipDropEscapeKind): int32 =
    ownershipDropPlaceIndex(ir, placeId)
    if escapeKind != ReturnEscape &&
       escapeKind != GlobalEscape &&
       escapeKind != ThreadEscape:
        ownershipDropFail("ownership_drop_ir: invalid move-out escape")
    var op: OwnershipDropOp
    ownershipDropNewOp(OwnershipDropOpMoveOut,
                       placeId, -1, -1, -1, escapeKind, op)
    return ownershipDropAppendOp(ir, blockId, op)

fn OwnershipDropRegisterDeferEffect(ir: var OwnershipDropIr,
                                    scopeId: int32,
                                    kind: OwnershipDropDeferEffectKind,
                                    placeId: int32,
                                    otherPlaceId: int32): int32 =
    ownershipDropScopeIndex(ir, scopeId)
    if kind == DeferEffectUnknown || kind == DeferEffectPanic:
        ownershipDropFail("ownership_drop_ir: defer effect unknown or may panic")
    if kind != DeferEffectNoOwnership:
        let placeIndex = ownershipDropPlaceIndex(ir, placeId)
        if !ownershipDropScopeIsAncestor(ir,
                                         ir.places[placeIndex].scopeId,
                                         scopeId):
            ownershipDropFail("ownership_drop_ir: defer captures inactive place")
    elif placeId >= 0 || otherPlaceId >= 0:
        ownershipDropFail("ownership_drop_ir: ownership-neutral defer has operands")
    if kind == DeferEffectMovePlace:
        let otherIndex = ownershipDropPlaceIndex(ir, otherPlaceId)
        if !ownershipDropScopeIsAncestor(ir,
                                         ir.places[otherIndex].scopeId,
                                         scopeId):
            ownershipDropFail("ownership_drop_ir: defer move target inactive")
        if placeId == otherPlaceId:
            ownershipDropFail("ownership_drop_ir: defer self move")
    elif otherPlaceId >= 0:
        ownershipDropFail("ownership_drop_ir: defer has unexpected second operand")
    var effect: OwnershipDropDeferEffect
    effect.deferId = ir.deferEffects.len + 1
    effect.scopeId = scopeId
    effect.declarationOrdinal = ir.deferEffects.len
    effect.kind = kind
    effect.placeId = placeId
    effect.otherPlaceId = otherPlaceId
    add(ir.deferEffects, effect)
    return effect.deferId

fn ownershipDropScopeIsAncestor(ir: var OwnershipDropIr,
                                ancestorScopeId: int32,
                                scopeId: int32): bool =
    ownershipDropScopeIndex(ir, ancestorScopeId)
    ownershipDropScopeIndex(ir, scopeId)
    var current = scopeId
    while current >= 0:
        if current == ancestorScopeId:
            return true
        current = ir.scopes[current].parentScopeId
    return false

fn ownershipDropCommonScope(ir: var OwnershipDropIr,
                            fromScopeId: int32,
                            toScopeId: int32): int32 =
    var current = fromScopeId
    while current >= 0:
        if ownershipDropScopeIsAncestor(ir, current, toScopeId):
            return current
        current = ir.scopes[current].parentScopeId
    ownershipDropFail("ownership_drop_ir: scopes lack common root")
    return -1

fn ownershipDropScopeExited(ir: var OwnershipDropIr,
                            placeScopeId: int32,
                            fromScopeId: int32,
                            stopScopeId: int32,
                            returnEdge: bool): bool =
    var current = fromScopeId
    while current >= 0:
        if !returnEdge && current == stopScopeId:
            return false
        if current == placeScopeId:
            return true
        current = ir.scopes[current].parentScopeId
    return false

@borrows
fn ownershipDropValidateCleanupInventory(ir: var OwnershipDropIr,
                                         edge: OwnershipDropEdge) =
    let fromScope = ir.blocks[edge.fromBlockId].scopeId
    let toScope = ir.blocks[edge.toBlockId].scopeId
    var stopScope = -1
    if edge.kind != OwnershipDropEdgeReturn:
        stopScope = ownershipDropCommonScope(ir, fromScope, toScope)
    var expectedCount: int32
    for placeIndex in 0..<ir.places.len:
        if ownershipDropScopeExited(ir,
                                    ir.places[placeIndex].scopeId,
                                    fromScope,
                                    stopScope,
                                    edge.kind == OwnershipDropEdgeReturn):
            if expectedCount >= edge.cleanupPlaceCount:
                ownershipDropFail("ownership_drop_ir: cleanup inventory omits place")
            let actual = ir.cleanupPlaceIds[edge.cleanupPlaceStart + expectedCount]
            if actual != ir.places[placeIndex].placeId:
                ownershipDropFail("ownership_drop_ir: cleanup inventory differs from scope")
            expectedCount = expectedCount + 1
    if expectedCount != edge.cleanupPlaceCount:
        ownershipDropFail("ownership_drop_ir: cleanup inventory has extra place")

@borrows
fn ownershipDropValidateDeferInventory(ir: var OwnershipDropIr,
                                       edge: OwnershipDropEdge) =
    let fromScope = ir.blocks[edge.fromBlockId].scopeId
    let toScope = ir.blocks[edge.toBlockId].scopeId
    var stopScope = -1
    if edge.kind != OwnershipDropEdgeReturn:
        stopScope = ownershipDropCommonScope(ir, fromScope, toScope)
    var expectedCount: int32
    var deferIndex = ir.deferEffects.len - 1
    while deferIndex >= 0:
        let effect = ir.deferEffects[deferIndex]
        if ownershipDropScopeExited(ir,
                                    effect.scopeId,
                                    fromScope,
                                    stopScope,
                                    edge.kind == OwnershipDropEdgeReturn):
            if expectedCount >= edge.deferIdCount:
                ownershipDropFail("ownership_drop_ir: defer inventory omits action")
            let actual = ir.edgeDeferIds[edge.deferIdStart + expectedCount]
            if actual != effect.deferId || effect.declarationOrdinal != deferIndex:
                ownershipDropFail("ownership_drop_ir: defer inventory order differs from scope")
            expectedCount = expectedCount + 1
        deferIndex = deferIndex - 1
    if expectedCount != edge.deferIdCount:
        ownershipDropFail("ownership_drop_ir: defer inventory has extra action")

fn OwnershipDropAddEdge(ir: var OwnershipDropIr,
                        fromBlockId: int32,
                        toBlockId: int32,
                        kind: OwnershipDropEdgeKind,
                        returnPlaceId: int32,
                        cleanupPlaceIds: var int32[],
                        deferIds: var int32[]): int32 =
    ownershipDropBlockIndex(ir, fromBlockId)
    ownershipDropBlockIndex(ir, toBlockId)
    if !ownershipDropEdgeKindKnown(kind):
        ownershipDropFail("ownership_drop_ir: unknown edge kind")
    if kind == OwnershipDropEdgeReturn:
        if returnPlaceId >= 0:
            let returnIndex = ownershipDropPlaceIndex(ir, returnPlaceId)
            if !ownershipDropScopeIsAncestor(ir,
                                             ir.places[returnIndex].scopeId,
                                             ir.blocks[fromBlockId].scopeId):
                ownershipDropFail("ownership_drop_ir: return place outside active scope")
    elif returnPlaceId >= 0:
        ownershipDropFail("ownership_drop_ir: return place on non-return edge")
    var cleanupSeen: bool[]
    for i in 0..<ir.places.len:
        add(cleanupSeen, false)
    let cleanupStart = ir.cleanupPlaceIds.len
    for i in 0..<cleanupPlaceIds.len:
        let placeIndex = ownershipDropPlaceIndex(ir, cleanupPlaceIds[i])
        if cleanupSeen[placeIndex]:
            ownershipDropFail("ownership_drop_ir: duplicate cleanup place")
        cleanupSeen[placeIndex] = true
        add(ir.cleanupPlaceIds, cleanupPlaceIds[i])
    var deferSeen: bool[]
    for i in 0..<ir.deferEffects.len:
        add(deferSeen, false)
    let deferStart = ir.edgeDeferIds.len
    for i in 0..<deferIds.len:
        let deferIndex = ownershipDropDeferIndex(ir, deferIds[i])
        if deferSeen[deferIndex]:
            ownershipDropFail("ownership_drop_ir: duplicate defer id")
        deferSeen[deferIndex] = true
        add(ir.edgeDeferIds, deferIds[i])
    var edge: OwnershipDropEdge
    edge.edgeId = ir.edges.len
    edge.fromBlockId = fromBlockId
    edge.toBlockId = toBlockId
    edge.kind = kind
    edge.returnPlaceId = returnPlaceId
    edge.cleanupPlaceStart = cleanupStart
    edge.cleanupPlaceCount = cleanupPlaceIds.len
    edge.deferIdStart = deferStart
    edge.deferIdCount = deferIds.len
    edge.resultExprNodeIndex = -1
    edge.resultValueDefinitionRow = -1
    edge.resultOwnership = OwnershipUnknown
    edge.sourceDefinitionDomain = 0
    edge.sourceDefinitionRow = -1
    ownershipDropValidateCleanupInventory(ir, edge)
    ownershipDropValidateDeferInventory(ir, edge)
    let edgeId = edge.edgeId
    add(ir.edges, edge)
    ownershipDropReleaseScratchSequence(cleanupSeen)
    ownershipDropReleaseScratchSequence(deferSeen)
    return edgeId

fn OwnershipDropBindReturnDefinitionAuthority(
        ir: var OwnershipDropIr,
        edgeId: int32,
        resultExprNodeIndex: int32,
        resultValueDefinitionRow: int32,
        resultOwnership: OwnershipClass,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32) =
    if edgeId < 0 || edgeId >= ir.edges.len:
        ownershipDropFail("ownership_drop_ir: return authority edge out of range")
    let edge = ir.edges[edgeId]
    if edge.kind != OwnershipDropEdgeReturn || edge.returnPlaceId < 0:
        ownershipDropFail("ownership_drop_ir: return authority edge invalid")
    let placeIndex = ownershipDropPlaceIndex(ir, edge.returnPlaceId)
    let placeOwnership = ir.places[placeIndex].ownership
    if (placeOwnership != Owned &&
        placeOwnership != RcBorrowedValue &&
        placeOwnership != Unmanaged) ||
       resultOwnership != placeOwnership ||
       resultExprNodeIndex < 0 ||
       resultValueDefinitionRow < 0 ||
       !ownershipDropDefinitionCoordinateValid(
           sourceDefinitionDomain,
           sourceDefinitionRow):
        ownershipDropFail("ownership_drop_ir: return authority invalid")
    if edge.resultExprNodeIndex != -1 ||
       edge.resultValueDefinitionRow != -1 ||
       edge.resultOwnership != OwnershipUnknown ||
       edge.sourceDefinitionDomain != 0 ||
       edge.sourceDefinitionRow != -1:
        ownershipDropFail("ownership_drop_ir: return authority rebound")
    var updated = edge
    updated.resultExprNodeIndex = resultExprNodeIndex
    updated.resultValueDefinitionRow = resultValueDefinitionRow
    updated.resultOwnership = resultOwnership
    updated.sourceDefinitionDomain = sourceDefinitionDomain
    updated.sourceDefinitionRow = sourceDefinitionRow
    ir.edges[edgeId] = updated

fn ownershipDropManualDefinitionMatrixLength(
        ir: var OwnershipDropIr): int32 =
    if ir.places.len > 0 &&
       ir.ops.len > 2147483647 / ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: manual definition matrix overflow")
    return ir.places.len * ir.ops.len

fn ownershipDropManualDefinitionMatrixIndex(
        ir: var OwnershipDropIr,
        placeIndex: int32,
        manualRow: int32): int32 =
    if placeIndex < 0 ||
       placeIndex >= ir.places.len ||
       manualRow < 0 ||
       manualRow >= ir.ops.len:
        ownershipDropFail(
            "ownership_drop_ir: manual definition matrix index invalid")
    return placeIndex * ir.ops.len + manualRow

fn ownershipDropClearDefinitionAlternatives(
        ir: var OwnershipDropIr,
        state: var OwnershipDropFlowState,
        placeIndex: int32) =
    state.placeEntryDefinitionReachable[placeIndex] = false
    let start = placeIndex * ir.ops.len
    for row in 0..<ir.ops.len:
        state.placeManualPostDefinitionReachable[start + row] =
            false

fn ownershipDropSetSingleDefinition(
        ir: var OwnershipDropIr,
        state: var OwnershipDropFlowState,
        placeIndex: int32,
        domain: int32,
        row: int32) =
    ownershipDropClearDefinitionAlternatives(
        ir, state, placeIndex)
    state.placeDefinitionDomains[placeIndex] = domain
    state.placeDefinitionRows[placeIndex] = row
    if ir.places[placeIndex].ownership != ExternalVarBorrow:
        return
    if domain == OwnershipDropDefinitionDomainEntrySlot:
        state.placeEntryDefinitionReachable[placeIndex] = true
        return
    if domain ==
           OwnershipDropDefinitionDomainManualConsumePostCall:
        let matrixIndex =
            ownershipDropManualDefinitionMatrixIndex(
                ir, placeIndex, row)
        state.placeManualPostDefinitionReachable[
            matrixIndex] = true
        return
    ownershipDropFail(
        "ownership_drop_ir: external target definition domain invalid")

fn ownershipDropManualPostTargetsPlace(
        ir: var OwnershipDropIr,
        manualRow: int32,
        placeId: int32): bool =
    var found: bool
    for opIndex in 0..<ir.ops.len:
        let op = ir.ops[opIndex]
        if op.kind ==
               OwnershipDropOpManualConsumeTransfer &&
           op.manualConsumeRow == manualRow:
            if found || op.placeId != placeId:
                return false
            found = true
    return found

fn ownershipDropExternalDefinitionSetValid(
        ir: var OwnershipDropIr,
        state: var OwnershipDropFlowState,
        placeIndex: int32): bool =
    let place = ir.places[placeIndex]
    if place.ownership != ExternalVarBorrow:
        return false
    var reachableCount: int32
    var singletonDomain: int32
    var singletonRow: int32 = -1
    if state.placeEntryDefinitionReachable[placeIndex]:
        if place.initialDefinitionDomain !=
               OwnershipDropDefinitionDomainEntrySlot ||
           place.initialDefinitionRow < 0:
            return false
        reachableCount = 1
        singletonDomain =
            OwnershipDropDefinitionDomainEntrySlot
        singletonRow = place.initialDefinitionRow
    let start = placeIndex * ir.ops.len
    for manualRow in 0..<ir.ops.len:
        if !state.placeManualPostDefinitionReachable[
               start + manualRow]:
            continue
        if !ownershipDropManualPostTargetsPlace(
               ir, manualRow, place.placeId):
            return false
        reachableCount = reachableCount + 1
        singletonDomain =
            OwnershipDropDefinitionDomainManualConsumePostCall
        singletonRow = manualRow
    if !ownershipDropMaskHasLive(
           state.placeStateMasks[placeIndex]):
        return reachableCount == 0 &&
               state.placeDefinitionDomains[placeIndex] == 0 &&
               state.placeDefinitionRows[placeIndex] == -1
    if reachableCount <= 0:
        return false
    if reachableCount == 1:
        return state.placeDefinitionDomains[placeIndex] ==
                   singletonDomain &&
               state.placeDefinitionRows[placeIndex] ==
                   singletonRow
    return state.placeDefinitionDomains[placeIndex] == 0 &&
           state.placeDefinitionRows[placeIndex] == -1

@borrows
fn ownershipDropManualTargetSetAccepted(
        ir: var OwnershipDropIr,
        state: var OwnershipDropFlowState,
        targetIndex: int32,
        op: OwnershipDropOp): bool =
    if !ownershipDropExternalDefinitionSetValid(
           ir, state, targetIndex):
        return false
    let target = ir.places[targetIndex]
    var exactTargetReachable: bool
    if state.placeEntryDefinitionReachable[targetIndex] &&
       op.manualTargetDefinitionDomain ==
           OwnershipDropDefinitionDomainEntrySlot &&
       op.manualTargetDefinitionRow ==
           target.initialDefinitionRow:
        exactTargetReachable = true
    let start = targetIndex * ir.ops.len
    for manualRow in 0..<ir.ops.len:
        if !state.placeManualPostDefinitionReachable[
               start + manualRow]:
            continue
        if !ownershipDropManualPostTargetsPlace(
               ir, manualRow, target.placeId):
            return false
        if op.manualTargetDefinitionDomain ==
               OwnershipDropDefinitionDomainManualConsumePostCall &&
           op.manualTargetDefinitionRow == manualRow:
            exactTargetReachable = true
    # The alternative bitset is the conditional-definition flag.  A CFG
    # join or loop header may carry entry plus one or more exact post-call
    # rows, but the transfer must still name one member of that finite set.
    # Physical op order and numeric row monotonicity are irrelevant.
    return exactTargetReachable

fn ownershipDropCloneFlow(source: var OwnershipDropFlowState,
                          out: var OwnershipDropFlowState) =
    ownershipDropResetFlowState(out)
    out.reached = source.reached
    for i in 0..<source.placeStateMasks.len:
        add(out.placeStateMasks, source.placeStateMasks[i])
        add(out.placeManagedProducerOpIds,
            source.placeManagedProducerOpIds[i])
        add(out.placeDefinitionDomains,
            source.placeDefinitionDomains[i])
        add(out.placeDefinitionRows,
            source.placeDefinitionRows[i])
        add(out.placeEntryDefinitionReachable,
            source.placeEntryDefinitionReachable[i])
        add(out.borrowSourcePlaceIds, source.borrowSourcePlaceIds[i])
        add(out.borrowProjectionTokens, source.borrowProjectionTokens[i])
        add(out.escapeMasks, source.escapeMasks[i])
    for i in 0..<source.fieldStateMasks.len:
        add(out.fieldStateMasks, source.fieldStateMasks[i])
    for i in 0..<source.deferActiveMasks.len:
        add(out.deferActiveMasks, source.deferActiveMasks[i])
    for i in 0..<source.placeManualPostDefinitionReachable.len:
        add(out.placeManualPostDefinitionReachable,
            source.placeManualPostDefinitionReachable[i])

fn ownershipDropNewEntryFlow(ir: var OwnershipDropIr,
                             out: var OwnershipDropFlowState) =
    ownershipDropResetFlowState(out)
    out.reached = true
    for i in 0..<ir.places.len:
        let initialized =
            ir.places[i].initialDefinitionDomain > 0
        add(out.placeStateMasks,
            if initialized:
                ownershipStateInitialized
            else:
                ownershipStateUninitialized)
        add(out.placeManagedProducerOpIds, -1)
        add(out.placeDefinitionDomains,
            ir.places[i].initialDefinitionDomain)
        add(out.placeDefinitionRows,
            ir.places[i].initialDefinitionRow)
        add(out.placeEntryDefinitionReachable,
            ir.places[i].ownership == ExternalVarBorrow &&
            ir.places[i].initialDefinitionDomain ==
                OwnershipDropDefinitionDomainEntrySlot)
        add(out.borrowSourcePlaceIds, -1)
        add(out.borrowProjectionTokens, -1)
        add(out.escapeMasks, ownershipEscapeNone)
    for placeIndex in 0..<ir.places.len:
        let fieldMask =
            if ir.places[placeIndex].initialDefinitionDomain > 0:
                ownershipStateInitialized
            else:
                ownershipStateUninitialized
        for _ in 0..<ir.places[placeIndex].fieldCount:
            add(out.fieldStateMasks, fieldMask)
    for i in 0..<ir.deferEffects.len:
        add(out.deferActiveMasks, ownershipStateUninitialized)
    let manualMatrixLength =
        ownershipDropManualDefinitionMatrixLength(ir)
    for _ in 0..<manualMatrixLength:
        add(out.placeManualPostDefinitionReachable, false)

@borrows
fn ownershipDropValidateFlowShape(ir: var OwnershipDropIr,
                                  state: var OwnershipDropFlowState) =
    if state.placeStateMasks.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: place-state flow column shape mismatch")
    if state.placeManagedProducerOpIds.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: managed-producer flow column shape mismatch")
    if state.placeDefinitionDomains.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: definition-domain flow column shape mismatch")
    if state.placeDefinitionRows.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: definition-row flow column shape mismatch")
    if state.placeEntryDefinitionReachable.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: entry-definition flow column shape mismatch")
    if state.placeManualPostDefinitionReachable.len !=
       ownershipDropManualDefinitionMatrixLength(ir):
        ownershipDropFail(
            "ownership_drop_ir: manual-post flow column shape mismatch")
    if state.borrowSourcePlaceIds.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: borrow-source flow column shape mismatch")
    if state.borrowProjectionTokens.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: borrow-projection flow column shape mismatch")
    if state.escapeMasks.len != ir.places.len:
        ownershipDropFail(
            "ownership_drop_ir: escape flow column shape mismatch")
    if state.fieldStateMasks.len != ir.placeFieldStateCount:
        ownershipDropFail(
            "ownership_drop_ir: field-state flow column shape mismatch")
    if state.deferActiveMasks.len != ir.deferEffects.len:
        ownershipDropFail(
            "ownership_drop_ir: defer-state flow column shape mismatch")
    for placeIndex in 0..<ir.places.len:
        let definitionDomain =
            state.placeDefinitionDomains[placeIndex]
        let definitionRow =
            state.placeDefinitionRows[placeIndex]
        if (definitionDomain == 0) != (definitionRow == -1) ||
           definitionDomain < 0 || definitionRow < -1 ||
           (!ownershipDropMaskHasLive(
                state.placeStateMasks[placeIndex]) &&
            (definitionDomain != 0 || definitionRow != -1)):
            ownershipDropFail(
                "ownership_drop_ir: reaching definition state invalid")
        if ir.places[placeIndex].ownership ==
               ExternalVarBorrow:
            if !ownershipDropExternalDefinitionSetValid(
                   ir, state, placeIndex):
                ownershipDropFail(
                    "ownership_drop_ir: external reaching definition set invalid")
        else:
            if state.placeEntryDefinitionReachable[
                   placeIndex]:
                ownershipDropFail(
                    "ownership_drop_ir: non-external entry alternative invalid")
            let manualStart = placeIndex * ir.ops.len
            for manualRow in 0..<ir.ops.len:
                if state.placeManualPostDefinitionReachable[
                       manualStart + manualRow]:
                    ownershipDropFail(
                        "ownership_drop_ir: non-external manual alternative invalid")
        let producerOpId =
            state.placeManagedProducerOpIds[placeIndex]
        if producerOpId >= 0:
            if producerOpId >= ir.ops.len:
                ownershipDropFail(
                    "ownership_drop_ir: managed producer row out of range")
            let producer = ir.ops[producerOpId]
            let producerMatchesPlace =
                (producer.kind == OwnershipDropOpInitialize &&
                 producer.placeId == ir.places[placeIndex].placeId) ||
                (producer.kind == OwnershipDropOpMove &&
                 producer.otherPlaceId ==
                     ir.places[placeIndex].placeId) ||
                (producer.kind == OwnershipDropOpRetainedAssign &&
                 producer.placeId == ir.places[placeIndex].placeId)
            if !ownershipDropMaskHasLive(
                   state.placeStateMasks[placeIndex]) ||
               ir.places[placeIndex].ownership != Owned ||
               !producerMatchesPlace:
                ownershipDropFail(
                    "ownership_drop_ir: managed producer flow authority invalid")

fn ownershipDropSetPlaceFields(ir: var OwnershipDropIr,
                               state: var OwnershipDropFlowState,
                               placeIndex: int32,
                               mask: int32) =
    let place = ir.places[placeIndex]
    for fieldOrdinal in 0..<place.fieldCount:
        state.fieldStateMasks[place.fieldStateStart + fieldOrdinal] = mask

fn ownershipDropRecomputeAggregateMask(ir: var OwnershipDropIr,
                                       state: var OwnershipDropFlowState,
                                       placeIndex: int32): int32 =
    let place = ir.places[placeIndex]
    if place.fieldCount <= 0:
        ownershipDropFail("ownership_drop_ir: aggregate mask requested for leaf")
    var allMayBeInitialized = true
    var allDefinitelyInitialized = true
    var anyMayBeInitialized: bool
    for fieldOrdinal in 0..<place.fieldCount:
        let mask = state.fieldStateMasks[place.fieldStateStart + fieldOrdinal]
        if ownershipDropMaskHasLive(mask):
            anyMayBeInitialized = true
        else:
            allMayBeInitialized = false
        if mask != ownershipStateInitialized:
            allDefinitelyInitialized = false
    if allDefinitelyInitialized:
        return ownershipStateInitialized
    var out: int32
    if allMayBeInitialized:
        out = ownershipStateInitialized
    if anyMayBeInitialized:
        out = ownershipDropMaskUnion(out, ownershipStatePartial)
    return out

fn ownershipDropHasPossibleBorrow(ir: var OwnershipDropIr,
                                  state: var OwnershipDropFlowState,
                                  ownerPlaceId: int32,
                                  includeRc: bool,
                                  includeVar: bool): bool =
    for viewIndex in 0..<ir.places.len:
        let ownership = ir.places[viewIndex].ownership
        let included = (includeRc && ownership == RcBorrowedValue) ||
                       (includeVar && ownership == VarBorrow)
        if included &&
           state.borrowSourcePlaceIds[viewIndex] == ownerPlaceId &&
           ownershipDropMaskHasLive(state.placeStateMasks[viewIndex]):
            return true
    return false

fn ownershipDropRequireNoPossibleBorrow(ir: var OwnershipDropIr,
                                        state: var OwnershipDropFlowState,
                                        ownerPlaceId: int32) =
    if ownershipDropHasPossibleBorrow(ir, state, ownerPlaceId, true, true):
        ownershipDropFail("ownership_drop_ir: owner operation while borrowed")

fn ownershipDropRequireDefiniteInitialized(state: var OwnershipDropFlowState,
                                           placeIndex: int32) =
    if !ownershipDropMaskDefinitelyInitialized(state.placeStateMasks[placeIndex]):
        ownershipDropFail("ownership_drop_ir: operation requires definitely initialized place")

fn ownershipDropInitialize(ir: var OwnershipDropIr,
                           state: var OwnershipDropFlowState,
                           placeIndex: int32,
                           opIndex: int32) =
    let place = ir.places[placeIndex]
    if place.ownership == RcBorrowedValue || place.ownership == VarBorrow:
        ownershipDropFail("ownership_drop_ir: borrow view requires borrow operation")
    if ownershipDropMaskHasLive(state.placeStateMasks[placeIndex]):
        ownershipDropFail("ownership_drop_ir: initialize overwrites possibly live place")
    ownershipDropRequireNoPossibleBorrow(ir, state, place.placeId)
    state.placeStateMasks[placeIndex] = ownershipStateInitialized
    state.placeManagedProducerOpIds[placeIndex] = -1
    if ir.ops[opIndex].definitionOriginKind != DefinitionOriginUnknown:
        state.placeManagedProducerOpIds[placeIndex] = opIndex
    ownershipDropSetSingleDefinition(
        ir,
        state,
        placeIndex,
        ir.ops[opIndex].definitionDomain,
        ir.ops[opIndex].definitionRow)
    ownershipDropSetPlaceFields(ir, state, placeIndex, ownershipStateInitialized)
    state.borrowSourcePlaceIds[placeIndex] = -1
    state.borrowProjectionTokens[placeIndex] = -1
    state.escapeMasks[placeIndex] = ownershipEscapeNone

fn ownershipDropRetainedAssign(ir: var OwnershipDropIr,
                               state: var OwnershipDropFlowState,
                               targetIndex: int32,
                               sourceIndex: int32,
                               opIndex: int32,
                               emitActions: bool,
                               actions: var OwnershipDropCleanupAction[]) =
    ownershipDropRequireDefiniteInitialized(state, sourceIndex)
    let target = ir.places[targetIndex]
    let source = ir.places[sourceIndex]
    if target.ownership != Owned ||
       (source.ownership != Owned && source.ownership != RcBorrowedValue):
        ownershipDropFail("ownership_drop_ir: retained assign ownership mismatch")
    if target.typeId != source.typeId:
        ownershipDropFail("ownership_drop_ir: retained assign type mismatch")
    if source.ownership == Owned &&
       ownershipDropHasPossibleBorrow(ir, state, source.placeId, false, true):
        ownershipDropFail("ownership_drop_ir: retained assign reads var-borrowed source")
    if ownershipDropHasPossibleBorrow(ir, state, target.placeId, false, true):
        ownershipDropFail("ownership_drop_ir: retained assign overwrites var-borrowed target")
    var aliasesOldTarget = sourceIndex == targetIndex
    if source.ownership == RcBorrowedValue &&
       state.borrowSourcePlaceIds[sourceIndex] == target.placeId:
        aliasesOldTarget = true
    if ownershipDropHasPossibleBorrow(ir, state, target.placeId, true, false) &&
       !aliasesOldTarget:
        ownershipDropFail("ownership_drop_ir: retained assign invalidates RC borrow")
    var capturedActionStart = -1
    if emitActions:
        let retainActionIndex = actions.len
        ownershipDropAppendAction(actions,
                                  -1,
                                  opIndex,
                                  CleanupActionRetainValue,
                                  0,
                                  source.placeId,
                                  target.placeId,
                                  -1,
                                  source.typeId,
                                  0,
                                  DropConditionAlways,
                                  -1,
                                  false,
                                  DropConditionAlways,
                                  -1,
                                  false)
        ownershipDropBindActionFromOp(actions,
                                      retainActionIndex,
                                      ir.ops[opIndex],
                                      false)
        let storeActionIndex = actions.len
        ownershipDropAppendAction(actions,
                                  -1,
                                  opIndex,
                                  CleanupActionStoreOwned,
                                  opIndex + 1,
                                  target.placeId,
                                  source.placeId,
                                  -1,
                                  target.typeId,
                                  0,
                                  DropConditionAlways,
                                  -1,
                                  false,
                                  DropConditionAlways,
                                  -1,
                                  false)
        ownershipDropBindActionFromOp(actions,
                                      storeActionIndex,
                                      ir.ops[opIndex],
                                      false)
        capturedActionStart = actions.len
    ownershipDropPlanAndApply(ir,
                              state,
                              targetIndex,
                              false,
                              aliasesOldTarget,
                              opIndex + 1,
                              -1,
                              opIndex,
                              emitActions,
                              actions)
    if emitActions:
        for actionIndex in capturedActionStart..<actions.len:
            ownershipDropBindCapturedActionAuthority(actions,
                                                     actionIndex,
                                                     Owned)
    state.placeStateMasks[targetIndex] = ownershipStateInitialized
    state.placeManagedProducerOpIds[targetIndex] = opIndex
    ownershipDropSetSingleDefinition(
        ir,
        state,
        targetIndex,
        ir.ops[opIndex].definitionDomain,
        ir.ops[opIndex].definitionRow)
    ownershipDropSetPlaceFields(ir, state, targetIndex, ownershipStateInitialized)
    state.escapeMasks[targetIndex] = ownershipEscapeNone

fn ownershipDropInitializeField(ir: var OwnershipDropIr,
                                state: var OwnershipDropFlowState,
                                placeIndex: int32,
                                fieldOrdinal: int32) =
    let place = ir.places[placeIndex]
    if place.ownership != Owned:
        ownershipDropFail("ownership_drop_ir: field initialization requires owned place")
    if fieldOrdinal < 0 || fieldOrdinal >= place.fieldCount:
        ownershipDropFail("ownership_drop_ir: field initialization out of range")
    ownershipDropRequireNoPossibleBorrow(ir, state, place.placeId)
    let fieldIndex = place.fieldStateStart + fieldOrdinal
    if ownershipDropMaskHasLive(state.fieldStateMasks[fieldIndex]):
        ownershipDropFail("ownership_drop_ir: field initialization overwrites live field")
    state.fieldStateMasks[fieldIndex] = ownershipStateInitialized
    state.placeStateMasks[placeIndex] =
        ownershipDropRecomputeAggregateMask(ir, state, placeIndex)
    state.placeManagedProducerOpIds[placeIndex] = -1
    state.escapeMasks[placeIndex] = ownershipEscapeNone

fn ownershipDropBeginRcBorrow(ir: var OwnershipDropIr,
                              state: var OwnershipDropFlowState,
                              ownerIndex: int32,
                              viewIndex: int32) =
    ownershipDropRequireDefiniteInitialized(state, ownerIndex)
    let owner = ir.places[ownerIndex]
    let view = ir.places[viewIndex]
    if owner.ownership != Owned || view.ownership != RcBorrowedValue:
        ownershipDropFail("ownership_drop_ir: invalid RC borrow ownership")
    if owner.typeId != view.typeId:
        ownershipDropFail("ownership_drop_ir: RC borrow type mismatch")
    if ownershipDropMaskHasLive(state.placeStateMasks[viewIndex]):
        ownershipDropFail("ownership_drop_ir: RC borrow view already live")
    if ownershipDropHasPossibleBorrow(ir, state, owner.placeId, false, true):
        ownershipDropFail("ownership_drop_ir: RC borrow aliases exclusive var borrow")
    state.placeStateMasks[viewIndex] = ownershipStateInitialized
    state.placeDefinitionDomains[viewIndex] = 0
    state.placeDefinitionRows[viewIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, viewIndex)
    ownershipDropSetPlaceFields(ir, state, viewIndex, ownershipStateInitialized)
    state.borrowSourcePlaceIds[viewIndex] = owner.placeId
    state.borrowProjectionTokens[viewIndex] = -1

fn ownershipDropBeginVarBorrow(ir: var OwnershipDropIr,
                               state: var OwnershipDropFlowState,
                               ownerIndex: int32,
                               viewIndex: int32,
                               projectionToken: int32) =
    ownershipDropRequireDefiniteInitialized(state, ownerIndex)
    let owner = ir.places[ownerIndex]
    let view = ir.places[viewIndex]
    if owner.ownership != Owned || view.ownership != VarBorrow:
        ownershipDropFail("ownership_drop_ir: invalid var borrow ownership")
    if projectionToken < 0:
        ownershipDropFail("ownership_drop_ir: invalid var borrow projection")
    if ownershipDropMaskHasLive(state.placeStateMasks[viewIndex]):
        ownershipDropFail("ownership_drop_ir: var borrow view already live")
    if ownershipDropHasPossibleBorrow(ir, state, owner.placeId, true, true):
        ownershipDropFail("ownership_drop_ir: var borrow is not exclusive")
    state.placeStateMasks[viewIndex] = ownershipStateInitialized
    state.placeDefinitionDomains[viewIndex] = 0
    state.placeDefinitionRows[viewIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, viewIndex)
    ownershipDropSetPlaceFields(ir, state, viewIndex, ownershipStateInitialized)
    state.borrowSourcePlaceIds[viewIndex] = owner.placeId
    state.borrowProjectionTokens[viewIndex] = projectionToken

fn ownershipDropEndBorrow(ir: var OwnershipDropIr,
                          state: var OwnershipDropFlowState,
                          viewIndex: int32,
                          expectedOwnership: OwnershipClass,
                          requireDefinite: bool) =
    if ir.places[viewIndex].ownership != expectedOwnership:
        ownershipDropFail("ownership_drop_ir: borrow end kind mismatch")
    let mask = state.placeStateMasks[viewIndex]
    if requireDefinite && !ownershipDropMaskDefinitelyInitialized(mask):
        ownershipDropFail("ownership_drop_ir: borrow end requires live view")
    if !requireDefinite && !ownershipDropMaskHasLive(mask):
        return
    if state.borrowSourcePlaceIds[viewIndex] <= 0:
        ownershipDropFail("ownership_drop_ir: borrow view lacks source")
    state.placeStateMasks[viewIndex] = ownershipStateDropped
    state.placeDefinitionDomains[viewIndex] = 0
    state.placeDefinitionRows[viewIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, viewIndex)
    ownershipDropSetPlaceFields(ir, state, viewIndex, ownershipStateDropped)
    state.borrowSourcePlaceIds[viewIndex] = -1
    state.borrowProjectionTokens[viewIndex] = -1

fn ownershipDropUsePlace(ir: var OwnershipDropIr,
                         state: var OwnershipDropFlowState,
                         placeIndex: int32,
                         writeAccess: bool) =
    ownershipDropRequireDefiniteInitialized(state, placeIndex)
    let place = ir.places[placeIndex]
    if place.ownership == Owned:
        if ownershipDropHasPossibleBorrow(ir, state, place.placeId, false, true):
            ownershipDropFail("ownership_drop_ir: owner access while var-borrowed")
        if writeAccess &&
           ownershipDropHasPossibleBorrow(ir, state, place.placeId, true, false):
            ownershipDropFail("ownership_drop_ir: owner write while RC-borrowed")
    elif place.ownership == RcBorrowedValue:
        if writeAccess:
            ownershipDropFail("ownership_drop_ir: RC borrowed value is read-only")
        let sourcePlaceId = state.borrowSourcePlaceIds[placeIndex]
        let sourceIndex = ownershipDropPlaceIndex(ir, sourcePlaceId)
        ownershipDropRequireDefiniteInitialized(state, sourceIndex)
    elif place.ownership == VarBorrow:
        let sourcePlaceId = state.borrowSourcePlaceIds[placeIndex]
        let sourceIndex = ownershipDropPlaceIndex(ir, sourcePlaceId)
        ownershipDropRequireDefiniteInitialized(state, sourceIndex)
    elif place.ownership == ExternalVarBorrow:
        # The exact entry/post definition coordinate is the capability
        # authority.  The referent is caller-owned and has no local owner row.
        if state.placeDefinitionDomains[placeIndex] <= 0 ||
           state.placeDefinitionRows[placeIndex] < 0:
            ownershipDropFail(
                "ownership_drop_ir: external var-borrow authority missing")
    elif place.ownership != Unmanaged:
        ownershipDropFail("ownership_drop_ir: access sees unknown ownership")

@borrows
fn ownershipDropConsume(ir: var OwnershipDropIr,
                        state: var OwnershipDropFlowState,
                        placeIndex: int32) =
    ownershipDropRequireDefiniteInitialized(state, placeIndex)
    let place = ir.places[placeIndex]
    if place.ownership != Owned:
        ownershipDropFail(
            "ownership_drop_ir: consume requires owned place")
    ownershipDropRequireNoPossibleBorrow(
        ir, state, place.placeId)
    # A semantic consume transfers ownership to the existing BodyIR operation.
    # It is a state transition, not a caller-side destructor action.
    state.placeStateMasks[placeIndex] = ownershipStateMoved
    state.placeManagedProducerOpIds[placeIndex] = -1
    state.placeDefinitionDomains[placeIndex] = 0
    state.placeDefinitionRows[placeIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, placeIndex)
    ownershipDropSetPlaceFields(
        ir, state, placeIndex, ownershipStateMoved)
    state.borrowSourcePlaceIds[placeIndex] = -1
    state.borrowProjectionTokens[placeIndex] = -1
    state.escapeMasks[placeIndex] = ownershipEscapeNone

fn ownershipDropActivateDefer(ir: var OwnershipDropIr,
                              state: var OwnershipDropFlowState,
                              deferId: int32) =
    let deferIndex = ownershipDropDeferIndex(ir, deferId)
    if ownershipDropMaskHasLive(state.deferActiveMasks[deferIndex]):
        ownershipDropFail("ownership_drop_ir: defer activated twice")
    state.deferActiveMasks[deferIndex] = ownershipStateInitialized

@borrows
fn ownershipDropMove(ir: var OwnershipDropIr,
                     state: var OwnershipDropFlowState,
                     fromIndex: int32,
                     toIndex: int32,
                     edgeId: int32,
                     opIndex: int32,
                     emitActions: bool,
                     actions: var OwnershipDropCleanupAction[]) =
    ownershipDropRequireDefiniteInitialized(state, fromIndex)
    let fromPlace = ir.places[fromIndex]
    let toPlace = ir.places[toIndex]
    if fromPlace.ownership != Owned || toPlace.ownership != Owned:
        ownershipDropFail("ownership_drop_ir: move requires owned places")
    if fromPlace.typeId != toPlace.typeId:
        ownershipDropFail("ownership_drop_ir: move type mismatch")
    ownershipDropRequireNoPossibleBorrow(ir, state, fromPlace.placeId)
    ownershipDropPlanAndApply(ir,
                              state,
                              toIndex,
                              false,
                              false,
                              0,
                              edgeId,
                              opIndex,
                              emitActions,
                              actions)
    if emitActions:
        let storeActionIndex = actions.len
        ownershipDropAppendAction(actions,
                                  edgeId,
                                  opIndex,
                                  CleanupActionStoreMove,
                                  0,
                                  toPlace.placeId,
                                  fromPlace.placeId,
                                  -1,
                                  toPlace.typeId,
                                  0,
                                  DropConditionAlways,
                                  -1,
                                  false,
                                  DropConditionAlways,
                                  -1,
                                  false)
        ownershipDropBindActionFromOp(actions,
                                      storeActionIndex,
                                      ir.ops[opIndex],
                                      true)
    state.placeStateMasks[toIndex] = ownershipStateInitialized
    state.placeManagedProducerOpIds[toIndex] = opIndex
    ownershipDropSetSingleDefinition(
        ir,
        state,
        toIndex,
        ir.ops[opIndex].definitionDomain,
        ir.ops[opIndex].definitionRow)
    for fieldOrdinal in 0..<fromPlace.fieldCount:
        state.fieldStateMasks[toPlace.fieldStateStart + fieldOrdinal] =
            state.fieldStateMasks[fromPlace.fieldStateStart + fieldOrdinal]
    state.placeStateMasks[fromIndex] = ownershipStateMoved
    state.placeManagedProducerOpIds[fromIndex] = -1
    state.placeDefinitionDomains[fromIndex] = 0
    state.placeDefinitionRows[fromIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, fromIndex)
    ownershipDropSetPlaceFields(ir, state, fromIndex, ownershipStateMoved)
    state.escapeMasks[fromIndex] = ownershipEscapeNone
    state.escapeMasks[toIndex] = ownershipEscapeNone

@borrows
fn ownershipDropEscapeBit(kind: OwnershipDropEscapeKind): int32 =
    if kind == ReturnEscape:
        return ownershipEscapeReturn
    if kind == GlobalEscape:
        return ownershipEscapeGlobal
    if kind == ThreadEscape:
        return ownershipEscapeThread
    ownershipDropFail("ownership_drop_ir: unknown escape kind")
    return 0

@borrows
fn ownershipDropMoveOut(ir: var OwnershipDropIr,
                        state: var OwnershipDropFlowState,
                        placeIndex: int32,
                        escapeKind: OwnershipDropEscapeKind) =
    ownershipDropRequireDefiniteInitialized(state, placeIndex)
    let place = ir.places[placeIndex]
    if place.ownership != Owned:
        ownershipDropFail("ownership_drop_ir: move-out requires owned place")
    ownershipDropRequireNoPossibleBorrow(ir, state, place.placeId)
    state.placeStateMasks[placeIndex] = ownershipStateMoved
    state.placeManagedProducerOpIds[placeIndex] = -1
    state.placeDefinitionDomains[placeIndex] = 0
    state.placeDefinitionRows[placeIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, placeIndex)
    ownershipDropSetPlaceFields(ir, state, placeIndex, ownershipStateMoved)
    state.escapeMasks[placeIndex] = ownershipDropEscapeBit(escapeKind)

@borrows
fn ownershipDropAppendAction(actions: var OwnershipDropCleanupAction[],
                             edgeId: int32,
                             opIndex: int32,
                             kind: OwnershipDropCleanupActionKind,
                             actionId: int32,
                             placeId: int32,
                             otherPlaceId: int32,
                             fieldOrdinal: int32,
                             typeId: int32,
                             dropGlueId: int32,
                             conditionKind: OwnershipDropConditionKind,
                             conditionFlagId: int32,
                             conditionNegated: bool,
                             conditionOtherKind: OwnershipDropConditionKind,
                             conditionOtherFlagId: int32,
                             conditionOtherNegated: bool) =
    var action: OwnershipDropCleanupAction
    action.edgeId = edgeId
    action.opIndex = opIndex
    action.kind = kind
    action.actionId = actionId
    action.placeId = placeId
    action.otherPlaceId = otherPlaceId
    action.fieldOrdinal = fieldOrdinal
    action.typeId = typeId
    action.dropGlueId = dropGlueId
    action.returnSnapshotGlueId = 0
    action.returnSnapshotGlueSymbol = ""
    action.conditionKind = conditionKind
    action.conditionFlagId = conditionFlagId
    action.conditionNegated = conditionNegated
    action.conditionOtherKind = conditionOtherKind
    action.conditionOtherFlagId = conditionOtherFlagId
    action.conditionOtherNegated = conditionOtherNegated
    action.guardDeferId = -1
    action.guardDeferNegated = false
    action.definitionOriginKind = DefinitionOriginUnknown
    action.definitionOriginId = -1
    action.sourceDefinitionDomain = 0
    action.sourceDefinitionRow = -1
    action.capturedOldSourceDefinitionDomain = 0
    action.capturedOldSourceDefinitionRow = -1
    action.sourceOwnership = OwnershipUnknown
    action.consumeActionRow = -1
    add(actions, action)

@borrows
fn ownershipDropBindActionFromOp(
        actions: var OwnershipDropCleanupAction[],
        actionIndex: int32,
        op: OwnershipDropOp,
        consumesSource: bool) =
    if actionIndex < 0 || actionIndex >= actions.len:
        ownershipDropFail("ownership_drop_ir: action authority row out of range")
    if op.definitionOriginKind == DefinitionOriginUnknown:
        if op.definitionOriginId != -1 ||
           op.sourceDefinitionDomain != 0 ||
           op.sourceDefinitionRow != -1 ||
           op.sourceOwnership != OwnershipUnknown:
            ownershipDropFail(
                "ownership_drop_ir: partial op definition authority")
        return
    ownershipDropValidateDefinitionAuthority(op.definitionOriginKind,
                                             op.definitionOriginId,
                                             op.sourceDefinitionDomain,
                                             op.sourceDefinitionRow,
                                             op.sourceOwnership,
                                             false)
    var action = actions[actionIndex]
    action.definitionOriginKind = op.definitionOriginKind
    action.definitionOriginId = op.definitionOriginId
    action.sourceDefinitionDomain = op.sourceDefinitionDomain
    action.sourceDefinitionRow = op.sourceDefinitionRow
    action.sourceOwnership = op.sourceOwnership
    if consumesSource:
        action.consumeActionRow = actionIndex
    actions[actionIndex] = action

fn ownershipDropBindCapturedActionAuthority(
        actions: var OwnershipDropCleanupAction[],
        actionIndex: int32,
        sourceOwnership: OwnershipClass) =
    if actionIndex < 0 || actionIndex >= actions.len ||
       sourceOwnership != Owned:
        ownershipDropFail("ownership_drop_ir: captured action authority invalid")
    var action = actions[actionIndex]
    action.definitionOriginKind = DefinitionOriginCanonicalSyntheticAction
    action.definitionOriginId = actionIndex
    action.sourceDefinitionDomain = 0
    action.sourceDefinitionRow = -1
    action.sourceOwnership = sourceOwnership
    action.consumeActionRow = actionIndex
    actions[actionIndex] = action

fn ownershipDropBindManagedProducerActionAuthority(
        ir: var OwnershipDropIr,
        actions: var OwnershipDropCleanupAction[],
        actionIndex: int32,
        producerOpId: int32) =
    if actionIndex < 0 || actionIndex >= actions.len ||
       producerOpId < 0 || producerOpId >= ir.ops.len:
        ownershipDropFail(
            "ownership_drop_ir: managed producer action authority invalid")
    var action = actions[actionIndex]
    if action.kind != CleanupActionDropPlace ||
       action.actionId != 0:
        ownershipDropFail(
            "ownership_drop_ir: managed producer requires whole-place drop")
    let producer = ir.ops[producerOpId]
    # [wall142] 候选产者权威列先算后写：TypedExpr 产者镜像 producer 行
    # 全列，Move/RetainedAssign 产者镜像 canonical store 动作行。写前
    # 与既有动作做消费唯一性互斥镜像（同 wall120 消费扫描四元组谓词），
    # 见下方 wall142 注记。
    var candidateOriginKind: OwnershipDropDefinitionOriginKind
    var candidateOriginId: int32
    var candidateDomain: int32
    var candidateRow: int32
    if producer.kind == OwnershipDropOpInitialize:
        ownershipDropValidateDefinitionAuthority(
            producer.definitionOriginKind,
            producer.definitionOriginId,
            producer.sourceDefinitionDomain,
            producer.sourceDefinitionRow,
            producer.sourceOwnership,
            false)
        candidateOriginKind = producer.definitionOriginKind
        candidateOriginId = producer.definitionOriginId
        candidateDomain = producer.sourceDefinitionDomain
        candidateRow = producer.sourceDefinitionRow
    elif producer.kind == OwnershipDropOpMove ||
         producer.kind == OwnershipDropOpRetainedAssign:
        var producerActionRow = -1
        for scanRow in 0..<actionIndex:
            let candidate = actions[scanRow]
            let expectedProducerAction =
                (producer.kind == OwnershipDropOpMove &&
                 candidate.kind == CleanupActionStoreMove) ||
                (producer.kind == OwnershipDropOpRetainedAssign &&
                 candidate.kind == CleanupActionRetainValue)
            if candidate.opIndex == producerOpId &&
               expectedProducerAction:
                if producerActionRow >= 0:
                    ownershipDropFail(
                        "ownership_drop_ir: managed producer action duplicated")
                producerActionRow = candidateRow
        if producerActionRow < 0:
            ownershipDropFail(
                "ownership_drop_ir: managed producer action missing")
        candidateOriginKind = DefinitionOriginCanonicalSyntheticAction
        candidateOriginId = producerActionRow
        candidateDomain = 0
        candidateRow = -1
    else:
        ownershipDropFail(
            "ownership_drop_ir: managed producer op kind invalid")
    # [wall142] 释放产者权威唯一主张镜像（wall120 消费唯一性扫描 +
    # cleanup_cfg [wall117b] 计划层互斥豁免的同域物化级对齐）：同一
    # 定义四元组 (originKind, originId, srcDomain, srcRow) 在动作表中
    # 至多一个动作以 consumeActionRow>=0 盖戳主张。在先主张已存在且
    # 两动作可同路径共存（ownershipDropActionsMayCoexecute，精确 CFG
    # 可达谓词，非边类启发）→ 真双消费，fail-closed；不可共存（典型
    # 形：同一托管局部在不同 return 边各得一次同产者 whole-place
    # drop，一条执行至多经过一条 return 边）→ 后续主张降级为无权威
    # plain 形（Unknown 全哨兵列，计划验证器 fall-through 臂既有合
    # 法形），物化层 releaseDefinitionOpId=-1 不盖消费戳、零 cond7，
    # drop glue 仍按计划条件完整发射。守卫零弱化：在先主张保持全
    # 权威可审计链，降级臂只发生于被互斥谓词证明不可共存之时。
    var priorClaimIndex = -1
    for priorIndex in 0..<actionIndex:
        let prior = actions[priorIndex]
        if prior.consumeActionRow >= 0 &&
           prior.definitionOriginKind == candidateOriginKind &&
           prior.definitionOriginId == candidateOriginId &&
           prior.sourceDefinitionDomain == candidateDomain &&
           prior.sourceDefinitionRow == candidateRow:
            priorClaimIndex = priorIndex
            break
    if priorClaimIndex >= 0:
        if ownershipDropActionsMayCoexecute(ir,
                                           actions[priorClaimIndex],
                                           action):
            ownershipDropFail(
                "ownership_drop_ir: release producer authority coexecutes")
        action.definitionOriginKind = DefinitionOriginUnknown
        action.definitionOriginId = -1
        action.sourceDefinitionDomain = 0
        action.sourceDefinitionRow = -1
        action.sourceOwnership = OwnershipUnknown
        action.consumeActionRow = -1
        actions[actionIndex] = action
        return
    action.definitionOriginKind = candidateOriginKind
    action.definitionOriginId = candidateOriginId
    action.sourceDefinitionDomain = candidateDomain
    action.sourceDefinitionRow = candidateRow
    action.sourceOwnership = Owned
    action.consumeActionRow = actionIndex
    actions[actionIndex] = action

fn OwnershipDropProjectCapturedOldDefinitionAuthority(
        action: var OwnershipDropCleanupAction,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32) =
    let capturedDrop =
        action.actionId > 0 &&
        (action.kind == CleanupActionDropPlace ||
         action.kind == CleanupActionDropField)
    if !ownershipDropDefinitionCoordinateValid(
           sourceDefinitionDomain,
           sourceDefinitionRow) ||
       (action.kind != CleanupActionStoreOwned && !capturedDrop) ||
       action.capturedOldSourceDefinitionDomain != 0 ||
       action.capturedOldSourceDefinitionRow != -1:
        ownershipDropFail(
            "ownership_drop_ir: captured-old definition projection invalid")
    action.capturedOldSourceDefinitionDomain =
        sourceDefinitionDomain
    action.capturedOldSourceDefinitionRow = sourceDefinitionRow

fn ownershipDropPlanAndApply(ir: var OwnershipDropIr,
                             state: var OwnershipDropFlowState,
                             placeIndex: int32,
                             requirePossibleLive: bool,
                             allowActiveRcAlias: bool,
                             valueActionId: int32,
                             edgeId: int32,
                             opIndex: int32,
                             emitActions: bool,
                             actions: var OwnershipDropCleanupAction[]) =
    let place = ir.places[placeIndex]
    let mask = state.placeStateMasks[placeIndex]
    let managedProducerOpId =
        state.placeManagedProducerOpIds[placeIndex]
    if !ownershipDropMaskHasLive(mask):
        if requirePossibleLive:
            ownershipDropFail("ownership_drop_ir: duplicate or invalid drop")
        return
    if place.ownership != Owned:
        ownershipDropFail("ownership_drop_ir: drop plan requires owned place")
    if ownershipDropHasPossibleBorrow(ir, state, place.placeId, false, true):
        ownershipDropFail("ownership_drop_ir: drop plan while var-borrowed")
    if !allowActiveRcAlias &&
       ownershipDropHasPossibleBorrow(ir, state, place.placeId, true, false):
        ownershipDropFail("ownership_drop_ir: drop plan while RC-borrowed")
    let typeIndex = ownershipDropTypeIndex(ir, place.typeId)
    let typeRow = ir.types[typeIndex]
    if typeRow.dropGlueId <= 0:
        ownershipDropFail("ownership_drop_ir: owned drop lacks glue")
    let fullPossible = ownershipDropMaskHas(mask, ownershipStateInitialized)
    let partialPossible = ownershipDropMaskHas(mask, ownershipStatePartial)
    if fullPossible:
        var conditionKind = DropConditionAlways
        var conditionFlagId = -1
        if mask != ownershipStateInitialized:
            if valueActionId > 0:
                conditionKind = DropConditionCapturedOldPlace
                conditionFlagId = valueActionId
            else:
                conditionKind = DropConditionPlaceInitialized
                conditionFlagId = ownershipDropPlaceFlagId(placeIndex)
        if emitActions:
            let dropActionIndex = actions.len
            ownershipDropAppendAction(actions,
                                      edgeId,
                                      opIndex,
                                      CleanupActionDropPlace,
                                      valueActionId,
                                      place.placeId,
                                      -1,
                                      -1,
                                      place.typeId,
                                      typeRow.dropGlueId,
                                      conditionKind,
                                      conditionFlagId,
                                      false,
                                      DropConditionAlways,
                                      -1,
                                      false)
            if managedProducerOpId >= 0 && valueActionId == 0:
                ownershipDropBindManagedProducerActionAuthority(
                    ir,
                    actions,
                    dropActionIndex,
                    managedProducerOpId)
    if place.fieldCount > 0 && partialPossible:
        if managedProducerOpId >= 0:
            ownershipDropFail(
                "ownership_drop_ir: managed producer field release authority missing")
        for reverseOffset in 0..<place.fieldCount:
            let fieldOrdinal = place.fieldCount - 1 - reverseOffset
            let fieldStateIndex = place.fieldStateStart + fieldOrdinal
            let fieldMask = state.fieldStateMasks[fieldStateIndex]
            if !ownershipDropMaskHasLive(fieldMask):
                continue
            let fieldTypeId = ir.typeFieldTypeIds[typeRow.fieldTypeStart + fieldOrdinal]
            let fieldTypeIndex = ownershipDropTypeIndex(ir, fieldTypeId)
            let fieldGlueId = ir.types[fieldTypeIndex].dropGlueId
            if fieldGlueId <= 0:
                continue
            var conditionKind = DropConditionAlways
            var conditionFlagId = -1
            if fieldMask != ownershipStateInitialized:
                if valueActionId > 0:
                    conditionKind = DropConditionCapturedOldField
                    conditionFlagId = valueActionId
                else:
                    conditionKind = DropConditionFieldInitialized
                    conditionFlagId = ownershipDropFieldFlagId(ir, fieldStateIndex)
            var conditionOtherKind = DropConditionAlways
            var conditionOtherFlagId = -1
            var conditionOtherNegated: bool
            if fullPossible:
                conditionOtherNegated = true
                if valueActionId > 0:
                    conditionOtherKind = DropConditionCapturedOldPlace
                    conditionOtherFlagId = valueActionId
                else:
                    conditionOtherKind = DropConditionPlaceInitialized
                    conditionOtherFlagId = ownershipDropPlaceFlagId(placeIndex)
            if emitActions:
                ownershipDropAppendAction(actions,
                                          edgeId,
                                          opIndex,
                                          CleanupActionDropField,
                                          valueActionId,
                                          place.placeId,
                                          -1,
                                          fieldOrdinal,
                                          fieldTypeId,
                                          fieldGlueId,
                                          conditionKind,
                                          conditionFlagId,
                                          false,
                                          conditionOtherKind,
                                          conditionOtherFlagId,
                                          conditionOtherNegated)
    state.placeStateMasks[placeIndex] = ownershipStateDropped
    state.placeManagedProducerOpIds[placeIndex] = -1
    state.placeDefinitionDomains[placeIndex] = 0
    state.placeDefinitionRows[placeIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, placeIndex)
    ownershipDropSetPlaceFields(ir, state, placeIndex, ownershipStateDropped)
    state.borrowSourcePlaceIds[placeIndex] = -1
    state.borrowProjectionTokens[placeIndex] = -1

@borrows
fn ownershipDropManualConsumeTransfer(
        ir: var OwnershipDropIr,
        state: var OwnershipDropFlowState,
        targetIndex: int32,
        sourceIndex: int32,
        op: OwnershipDropOp,
        actions: var OwnershipDropCleanupAction[]) =
    let actionCount = actions.len
    ownershipDropRequireDefiniteInitialized(state, targetIndex)
    ownershipDropRequireDefiniteInitialized(state, sourceIndex)
    let target = ir.places[targetIndex]
    let source = ir.places[sourceIndex]
    if targetIndex == sourceIndex ||
       source.ownership != Owned ||
       target.ownership != ExternalVarBorrow ||
       target.typeId != source.typeId ||
       !ownershipDropManualTargetSetAccepted(
           ir, state, targetIndex, op) ||
       state.placeDefinitionDomains[sourceIndex] !=
           op.manualSourceDefinitionDomain ||
       state.placeDefinitionRows[sourceIndex] !=
           op.manualSourceDefinitionRow:
        ownershipDropFail(
            "ownership_drop_ir: manual-consume reaching definition mismatch")
    if (op.manualTargetDefinitionDomain ==
            op.manualSourceDefinitionDomain &&
        op.manualTargetDefinitionRow ==
            op.manualSourceDefinitionRow) ||
       op.definitionDomain <= 0 || op.definitionRow < 0:
        ownershipDropFail(
            "ownership_drop_ir: manual-consume definition alias invalid")
    ownershipDropRequireNoPossibleBorrow(
        ir, state, source.placeId)
    state.placeStateMasks[sourceIndex] =
        ownershipStateMoved
    state.placeManagedProducerOpIds[sourceIndex] = -1
    state.placeDefinitionDomains[sourceIndex] = 0
    state.placeDefinitionRows[sourceIndex] = -1
    ownershipDropClearDefinitionAlternatives(
        ir, state, sourceIndex)
    ownershipDropSetPlaceFields(
        ir, state, sourceIndex, ownershipStateMoved)
    state.escapeMasks[sourceIndex] = ownershipEscapeNone

    # The callee performs the replacement.  Ownership IR records only the
    # atomic semantic state change: it emits no store/drop/retain action.
    state.placeStateMasks[targetIndex] =
        ownershipStateInitialized
    state.placeManagedProducerOpIds[targetIndex] = -1
    ownershipDropSetSingleDefinition(
        ir,
        state,
        targetIndex,
        op.definitionDomain,
        op.definitionRow)
    ownershipDropSetPlaceFields(
        ir, state, targetIndex, ownershipStateInitialized)
    state.borrowSourcePlaceIds[targetIndex] = -1
    state.borrowProjectionTokens[targetIndex] = -1
    state.escapeMasks[targetIndex] = ownershipEscapeNone
    if actions.len != actionCount:
        ownershipDropFail(
            "ownership_drop_ir: manual-consume emitted machine action")

@borrows
fn ownershipDropApplyOp(ir: var OwnershipDropIr,
                        state: var OwnershipDropFlowState,
                        op: OwnershipDropOp,
                        opIndex: int32,
                        emitActions: bool,
                        actions: var OwnershipDropCleanupAction[]) =
    if op.kind == OwnershipDropOpUnknown:
        ownershipDropFail("ownership_drop_ir: unknown operation")
    if op.kind == OwnershipDropOpActivateDefer:
        ownershipDropActivateDefer(ir, state, op.placeId)
        return
    let placeIndex = ownershipDropPlaceIndex(ir, op.placeId)
    if op.kind == OwnershipDropOpInitialize ||
       op.kind == OwnershipDropOpInitializeExisting:
        ownershipDropInitialize(ir, state, placeIndex, opIndex)
    elif op.kind == OwnershipDropOpInitializeField:
        ownershipDropInitializeField(ir, state, placeIndex, op.fieldOrdinal)
    elif op.kind == OwnershipDropOpRcBorrow:
        ownershipDropBeginRcBorrow(ir,
                                   state,
                                   placeIndex,
                                   ownershipDropPlaceIndex(ir, op.otherPlaceId))
    elif op.kind == OwnershipDropOpEndRcBorrow:
        ownershipDropEndBorrow(ir, state, placeIndex, RcBorrowedValue, true)
    elif op.kind == OwnershipDropOpVarBorrow:
        ownershipDropBeginVarBorrow(ir,
                                    state,
                                    placeIndex,
                                    ownershipDropPlaceIndex(ir, op.otherPlaceId),
                                    op.projectionToken)
    elif op.kind == OwnershipDropOpEndVarBorrow:
        ownershipDropEndBorrow(ir, state, placeIndex, VarBorrow, true)
    elif op.kind == OwnershipDropOpUseRead:
        ownershipDropUsePlace(ir, state, placeIndex, false)
    elif op.kind == OwnershipDropOpUseWrite:
        ownershipDropUsePlace(ir, state, placeIndex, true)
    elif op.kind == OwnershipDropOpMove:
        ownershipDropMove(ir,
                          state,
                          placeIndex,
                          ownershipDropPlaceIndex(ir, op.otherPlaceId),
                          -1,
                          opIndex,
                          emitActions,
                          actions)
    elif op.kind == OwnershipDropOpRetainedAssign:
        ownershipDropRetainedAssign(ir,
                                    state,
                                    placeIndex,
                                    ownershipDropPlaceIndex(ir, op.otherPlaceId),
                                    opIndex,
                                    emitActions,
                                    actions)
    elif op.kind == OwnershipDropOpManualConsumeTransfer:
        ownershipDropManualConsumeTransfer(
            ir,
            state,
            placeIndex,
            ownershipDropPlaceIndex(ir, op.otherPlaceId),
            op,
            actions)
    elif op.kind == OwnershipDropOpConsume:
        ownershipDropConsume(ir, state, placeIndex)
    elif op.kind == OwnershipDropOpDrop:
        ownershipDropPlanAndApply(ir,
                                  state,
                                  placeIndex,
                                  true,
                                  false,
                                  0,
                                  -1,
                                  opIndex,
                                  emitActions,
                                  actions)
    elif op.kind == OwnershipDropOpMoveOut:
        ownershipDropMoveOut(ir, state, placeIndex, op.escapeKind)
    else:
        ownershipDropFail("ownership_drop_ir: unsupported operation")

@borrows
fn ownershipDropApplyBlock(ir: var OwnershipDropIr,
                           blockId: int32,
                           input: var OwnershipDropFlowState,
                           out: var OwnershipDropFlowState,
                           emitActions: bool,
                           opActionStarts: var int32[],
                           opActionCounts: var int32[],
                           actions: var OwnershipDropCleanupAction[],
                           flagTransitions: var OwnershipDropFlagTransition[]) =
    ownershipDropValidateFlowShape(ir, input)
    ownershipDropCloneFlow(input, out)
    let block = ir.blocks[ownershipDropBlockIndex(ir, blockId)]
    if block.opStart < 0 ||
       block.opCount < 0 ||
       block.opStart + block.opCount > ir.ops.len:
        ownershipDropFail("ownership_drop_ir: block operation range invalid")
    for opIndex in block.opStart..<(block.opStart + block.opCount):
        let actionStart = actions.len
        var beforeOp: OwnershipDropFlowState
        if emitActions:
            ownershipDropCloneFlow(out, beforeOp)
        ownershipDropApplyOp(ir, out, ir.ops[opIndex], opIndex, emitActions, actions)
        if emitActions:
            opActionStarts[opIndex] = actionStart
            opActionCounts[opIndex] = actions.len - actionStart
            ownershipDropRecordFlagTransitions(ir,
                                               beforeOp,
                                               out,
                                               FlagOriginOp,
                                               opIndex,
                                               flagTransitions)
            ownershipDropResetFlowState(beforeOp)

fn ownershipDropFlowsEqual(ir: var OwnershipDropIr,
                           lhs: var OwnershipDropFlowState,
                           rhs: var OwnershipDropFlowState): bool =
    ownershipDropValidateFlowShape(ir, lhs)
    ownershipDropValidateFlowShape(ir, rhs)
    if lhs.reached != rhs.reached:
        return false
    for i in 0..<ir.places.len:
        if lhs.placeStateMasks[i] != rhs.placeStateMasks[i] ||
           lhs.placeManagedProducerOpIds[i] !=
               rhs.placeManagedProducerOpIds[i] ||
           lhs.placeDefinitionDomains[i] !=
               rhs.placeDefinitionDomains[i] ||
           lhs.placeDefinitionRows[i] !=
               rhs.placeDefinitionRows[i] ||
           lhs.placeEntryDefinitionReachable[i] !=
               rhs.placeEntryDefinitionReachable[i] ||
           lhs.borrowSourcePlaceIds[i] != rhs.borrowSourcePlaceIds[i] ||
           lhs.borrowProjectionTokens[i] != rhs.borrowProjectionTokens[i] ||
           lhs.escapeMasks[i] != rhs.escapeMasks[i]:
            return false
    for i in 0..<lhs.placeManualPostDefinitionReachable.len:
        if lhs.placeManualPostDefinitionReachable[i] !=
               rhs.placeManualPostDefinitionReachable[i]:
            return false
    for i in 0..<ir.placeFieldStateCount:
        if lhs.fieldStateMasks[i] != rhs.fieldStateMasks[i]:
            return false
    for i in 0..<ir.deferEffects.len:
        if lhs.deferActiveMasks[i] != rhs.deferActiveMasks[i]:
            return false
    return true

fn ownershipDropJoinBorrowSource(ir: var OwnershipDropIr,
                                 placeIndex: int32,
                                 targetMask: int32,
                                 targetSource: int32,
                                 incomingMask: int32,
                                 incomingSource: int32): int32 =
    let ownership = ir.places[placeIndex].ownership
    if ownership != RcBorrowedValue && ownership != VarBorrow:
        return -1
    let targetLive = ownershipDropMaskHasLive(targetMask)
    let incomingLive = ownershipDropMaskHasLive(incomingMask)
    if targetLive && incomingLive && targetSource != incomingSource:
        ownershipDropFail("ownership_drop_ir: borrow source differs at join")
    if targetLive:
        return targetSource
    if incomingLive:
        return incomingSource
    return -1

fn ownershipDropJoinProjection(ir: var OwnershipDropIr,
                               placeIndex: int32,
                               targetMask: int32,
                               targetToken: int32,
                               incomingMask: int32,
                               incomingToken: int32): int32 =
    if ir.places[placeIndex].ownership != VarBorrow:
        return -1
    let targetLive = ownershipDropMaskHasLive(targetMask)
    let incomingLive = ownershipDropMaskHasLive(incomingMask)
    if targetLive && incomingLive && targetToken != incomingToken:
        ownershipDropFail("ownership_drop_ir: var-borrow projection differs at join")
    if targetLive:
        return targetToken
    if incomingLive:
        return incomingToken
    return -1

fn ownershipDropJoinManagedProducer(
        targetMask: int32,
        targetProducerOpId: int32,
        incomingMask: int32,
        incomingProducerOpId: int32): int32 =
    let targetLive = ownershipDropMaskHasLive(targetMask)
    let incomingLive = ownershipDropMaskHasLive(incomingMask)
    if targetLive && incomingLive:
        if targetProducerOpId != incomingProducerOpId:
            ownershipDropFail(
                "ownership_drop_ir: managed producer differs at join")
        return targetProducerOpId
    if targetLive:
        return targetProducerOpId
    if incomingLive:
        return incomingProducerOpId
    return -1

fn ownershipDropJoinDefinitionCoordinate(
        targetMask: int32,
        targetDomain: int32,
        targetRow: int32,
        incomingMask: int32,
        incomingDomain: int32,
        incomingRow: int32,
        outDomain: var int32,
        outRow: var int32) =
    let targetLive = ownershipDropMaskHasLive(targetMask)
    let incomingLive = ownershipDropMaskHasLive(incomingMask)
    if targetLive && incomingLive:
        if targetDomain != incomingDomain ||
           targetRow != incomingRow:
            ownershipDropFail(
                "ownership_drop_ir: reaching definition differs at join")
        outDomain = targetDomain
        outRow = targetRow
        return
    if targetLive:
        outDomain = targetDomain
        outRow = targetRow
        return
    if incomingLive:
        outDomain = incomingDomain
        outRow = incomingRow
        return
    outDomain = 0
    outRow = -1

fn ownershipDropJoinExternalDefinitionSet(
        ir: var OwnershipDropIr,
        target: var OwnershipDropFlowState,
        incoming: var OwnershipDropFlowState,
        placeIndex: int32): bool =
    var changed: bool
    if incoming.placeEntryDefinitionReachable[placeIndex] &&
       !target.placeEntryDefinitionReachable[placeIndex]:
        target.placeEntryDefinitionReachable[placeIndex] = true
        changed = true
    let start = placeIndex * ir.ops.len
    for manualRow in 0..<ir.ops.len:
        let matrixIndex = start + manualRow
        if incoming.placeManualPostDefinitionReachable[
               matrixIndex] &&
           !target.placeManualPostDefinitionReachable[
               matrixIndex]:
            target.placeManualPostDefinitionReachable[
                matrixIndex] = true
            changed = true
    var count: int32
    var singletonDomain: int32
    var singletonRow: int32 = -1
    if target.placeEntryDefinitionReachable[placeIndex]:
        count = 1
        singletonDomain =
            OwnershipDropDefinitionDomainEntrySlot
        singletonRow =
            ir.places[placeIndex].initialDefinitionRow
    for manualRow in 0..<ir.ops.len:
        if target.placeManualPostDefinitionReachable[
               start + manualRow]:
            count = count + 1
            singletonDomain =
                OwnershipDropDefinitionDomainManualConsumePostCall
            singletonRow = manualRow
    var joinedDomain: int32
    var joinedRow: int32 = -1
    if count == 1:
        joinedDomain = singletonDomain
        joinedRow = singletonRow
    if target.placeDefinitionDomains[placeIndex] !=
           joinedDomain ||
       target.placeDefinitionRows[placeIndex] != joinedRow:
        target.placeDefinitionDomains[placeIndex] =
            joinedDomain
        target.placeDefinitionRows[placeIndex] = joinedRow
        changed = true
    return changed

fn ownershipDropJoinInto(ir: var OwnershipDropIr,
                         target: var OwnershipDropFlowState,
                         incoming: var OwnershipDropFlowState): bool =
    if !incoming.reached:
        ownershipDropFail("ownership_drop_ir: join from unreachable state")
    if !target.reached:
        ownershipDropCloneFlow(incoming, target)
        return true
    var changed: bool
    for i in 0..<ir.places.len:
        let oldMask = target.placeStateMasks[i]
        let incomingMask = incoming.placeStateMasks[i]
        let source = ownershipDropJoinBorrowSource(ir,
                                                   i,
                                                   oldMask,
                                                   target.borrowSourcePlaceIds[i],
                                                   incomingMask,
                                                   incoming.borrowSourcePlaceIds[i])
        let projection = ownershipDropJoinProjection(ir,
                                                     i,
                                                     oldMask,
                                                     target.borrowProjectionTokens[i],
                                                     incomingMask,
                                                     incoming.borrowProjectionTokens[i])
        let managedProducerOpId = ownershipDropJoinManagedProducer(
            oldMask,
            target.placeManagedProducerOpIds[i],
            incomingMask,
            incoming.placeManagedProducerOpIds[i])
        var definitionDomain: int32
        var definitionRow: int32 = -1
        if ir.places[i].ownership ==
               ExternalVarBorrow:
            if ownershipDropJoinExternalDefinitionSet(
                   ir, target, incoming, i):
                changed = true
            definitionDomain =
                target.placeDefinitionDomains[i]
            definitionRow =
                target.placeDefinitionRows[i]
        else:
            ownershipDropJoinDefinitionCoordinate(
                oldMask,
                target.placeDefinitionDomains[i],
                target.placeDefinitionRows[i],
                incomingMask,
                incoming.placeDefinitionDomains[i],
                incoming.placeDefinitionRows[i],
                definitionDomain,
                definitionRow)
        let joinedMask = ownershipDropMaskUnion(oldMask, incomingMask)
        let joinedEscape = ownershipDropEscapeMaskUnion(target.escapeMasks[i],
                                                        incoming.escapeMasks[i])
        if joinedMask != oldMask ||
           source != target.borrowSourcePlaceIds[i] ||
           projection != target.borrowProjectionTokens[i] ||
           managedProducerOpId !=
               target.placeManagedProducerOpIds[i] ||
           definitionDomain !=
               target.placeDefinitionDomains[i] ||
           definitionRow !=
               target.placeDefinitionRows[i] ||
           joinedEscape != target.escapeMasks[i]:
            changed = true
        target.placeStateMasks[i] = joinedMask
        target.borrowSourcePlaceIds[i] = source
        target.borrowProjectionTokens[i] = projection
        target.placeManagedProducerOpIds[i] = managedProducerOpId
        target.placeDefinitionDomains[i] = definitionDomain
        target.placeDefinitionRows[i] = definitionRow
        target.escapeMasks[i] = joinedEscape
    for i in 0..<ir.placeFieldStateCount:
        let joined = ownershipDropMaskUnion(target.fieldStateMasks[i],
                                            incoming.fieldStateMasks[i])
        if joined != target.fieldStateMasks[i]:
            changed = true
            target.fieldStateMasks[i] = joined
    for i in 0..<ir.deferEffects.len:
        let joined = ownershipDropMaskUnion(target.deferActiveMasks[i],
                                            incoming.deferActiveMasks[i])
        if joined != target.deferActiveMasks[i]:
            changed = true
            target.deferActiveMasks[i] = joined
    return changed

fn ownershipDropFlowIncludes(ir: var OwnershipDropIr,
                             latticeState: var OwnershipDropFlowState,
                             incoming: var OwnershipDropFlowState): bool =
    var joined: OwnershipDropFlowState
    ownershipDropCloneFlow(latticeState, joined)
    let included = !ownershipDropJoinInto(ir, joined, incoming)
    ownershipDropResetFlowState(joined)
    return included

fn ownershipDropPlaceFlagId(placeIndex: int32): int32 =
    return placeIndex + 1

fn ownershipDropFieldFlagId(ir: var OwnershipDropIr,
                            fieldStateIndex: int32): int32 =
    return ir.places.len + fieldStateIndex + 1

fn ownershipDropDeferFlagId(ir: var OwnershipDropIr,
                            deferIndex: int32): int32 =
    return ir.places.len + ir.placeFieldStateCount + deferIndex + 1

fn ownershipDropApplyDeferEffect(ir: var OwnershipDropIr,
                                 state: var OwnershipDropFlowState,
                                 edgeId: int32,
                                 deferId: int32,
                                 emitActions: bool,
                                 actions: var OwnershipDropCleanupAction[]) =
    let effect = ir.deferEffects[ownershipDropDeferIndex(ir, deferId)]
    if effect.kind == DeferEffectNoOwnership:
        return
    let placeIndex = ownershipDropPlaceIndex(ir, effect.placeId)
    if effect.kind == DeferEffectDropPlace:
        ownershipDropPlanAndApply(ir,
                                  state,
                                  placeIndex,
                                  true,
                                  false,
                                  0,
                                  edgeId,
                                  -1,
                                  emitActions,
                                  actions)
    elif effect.kind == DeferEffectMovePlace:
        ownershipDropMove(ir,
                          state,
                          placeIndex,
                          ownershipDropPlaceIndex(ir, effect.otherPlaceId),
                          edgeId,
                          -1,
                          emitActions,
                          actions)
    elif effect.kind == DeferEffectUseRead:
        ownershipDropUsePlace(ir, state, placeIndex, false)
    elif effect.kind == DeferEffectUseWrite:
        ownershipDropUsePlace(ir, state, placeIndex, true)
    elif effect.kind == DeferEffectEndRcBorrow:
        ownershipDropEndBorrow(ir, state, placeIndex, RcBorrowedValue, true)
    elif effect.kind == DeferEffectEndVarBorrow:
        ownershipDropEndBorrow(ir, state, placeIndex, VarBorrow, true)
    else:
        ownershipDropFail("ownership_drop_ir: unsupported defer effect")

fn ownershipDropApplyDefer(ir: var OwnershipDropIr,
                           state: var OwnershipDropFlowState,
                           edgeId: int32,
                           deferId: int32,
                           emitActions: bool,
                           actions: var OwnershipDropCleanupAction[]) =
    let deferIndex = ownershipDropDeferIndex(ir, deferId)
    let effect = ir.deferEffects[deferIndex]
    if effect.kind == DeferEffectUnknown || effect.kind == DeferEffectPanic:
        ownershipDropFail("ownership_drop_ir: defer effect unknown or may panic")
    let activeMask = state.deferActiveMasks[deferIndex]
    if !ownershipDropMaskHasLive(activeMask):
        return
    var conditionKind = DropConditionAlways
    var conditionFlagId = -1
    if activeMask != ownershipStateInitialized:
        conditionKind = DropConditionDeferActive
        conditionFlagId = ownershipDropDeferFlagId(ir, deferIndex)
    if emitActions:
        ownershipDropAppendAction(actions,
                                  edgeId,
                                  -1,
                                  CleanupActionDefer,
                                  deferId,
                                  -1,
                                  -1,
                                  -1,
                                  -1,
                                  0,
                                  conditionKind,
                                  conditionFlagId,
                                  false,
                                  DropConditionAlways,
                                  -1,
                                  false)
    if activeMask == ownershipStateInitialized:
        ownershipDropApplyDeferEffect(ir,
                                      state,
                                      edgeId,
                                      deferId,
                                      emitActions,
                                      actions)
        state.deferActiveMasks[deferIndex] = ownershipStateDropped
        return

    # The active bit is correlated with a runtime branch. Analyze both sides,
    # guard every ownership action with that bit, then join the finite states.
    var inactiveState: OwnershipDropFlowState
    ownershipDropCloneFlow(state, inactiveState)
    inactiveState.deferActiveMasks[deferIndex] = ownershipStateDropped
    var activeState: OwnershipDropFlowState
    ownershipDropCloneFlow(state, activeState)
    activeState.deferActiveMasks[deferIndex] = ownershipStateInitialized
    let guardedActionStart = actions.len
    ownershipDropApplyDeferEffect(ir,
                                  activeState,
                                  edgeId,
                                  deferId,
                                  emitActions,
                                  actions)
    activeState.deferActiveMasks[deferIndex] = ownershipStateDropped
    if emitActions:
        for actionIndex in guardedActionStart..<actions.len:
            actions[actionIndex].guardDeferId = deferId
    ownershipDropJoinInto(ir, inactiveState, activeState)
    ownershipDropCloneFlow(inactiveState, state)
    ownershipDropResetFlowState(inactiveState)
    ownershipDropResetFlowState(activeState)

fn ownershipDropCleanupPlace(ir: var OwnershipDropIr,
                             state: var OwnershipDropFlowState,
                             edgeId: int32,
                             placeIndex: int32,
                             emitActions: bool,
                             actions: var OwnershipDropCleanupAction[]) =
    let ownership = ir.places[placeIndex].ownership
    if ownership == Owned:
        ownershipDropPlanAndApply(ir,
                                  state,
                                  placeIndex,
                                  false,
                                  false,
                                  0,
                                  edgeId,
                                  -1,
                                  emitActions,
                                  actions)
    elif ownership == RcBorrowedValue:
        ownershipDropEndBorrow(ir, state, placeIndex, RcBorrowedValue, false)
    elif ownership == VarBorrow:
        ownershipDropEndBorrow(ir, state, placeIndex, VarBorrow, false)
    elif ownership == Unmanaged ||
         ownership == ExternalVarBorrow:
        if ownershipDropMaskHasLive(state.placeStateMasks[placeIndex]):
            state.placeStateMasks[placeIndex] = ownershipStateDropped
            state.placeDefinitionDomains[placeIndex] = 0
            state.placeDefinitionRows[placeIndex] = -1
            ownershipDropClearDefinitionAlternatives(
                ir, state, placeIndex)
            ownershipDropSetPlaceFields(ir, state, placeIndex, ownershipStateDropped)
    else:
        ownershipDropFail("ownership_drop_ir: cleanup sees unknown ownership")

fn ownershipDropApplyReturnPlace(ir: var OwnershipDropIr,
                                 state: var OwnershipDropFlowState,
                                 edgeId: int32,
                                 returnPlaceId: int32,
                                 emitActions: bool,
                                 actions: var OwnershipDropCleanupAction[]) =
    if returnPlaceId < 0:
        return
    let placeIndex = ownershipDropPlaceIndex(ir, returnPlaceId)
    ownershipDropRequireDefiniteInitialized(state, placeIndex)
    let place = ir.places[placeIndex]
    let returnEdge = ir.edges[edgeId]
    if place.ownership == Owned:
        if ownershipDropHasPossibleBorrow(ir,
                                          state,
                                          place.placeId,
                                          false,
                                          true):
            ownershipDropFail("ownership_drop_ir: return snapshot while var-borrowed")
        let typeRow = ir.types[ownershipDropTypeIndex(ir, place.typeId)]
        if !ownershipDropReturnSnapshotKindKnown(typeRow.returnSnapshotKind) ||
           typeRow.returnSnapshotGlueId <= 0:
            ownershipDropFail("ownership_drop_ir: owned return lacks snapshot policy")
        if returnEdge.resultOwnership != Owned:
            ownershipDropFail(
                "ownership_drop_ir: owned return definition authority missing")
        ownershipDropValidateDefinitionAuthority(
            DefinitionOriginTypedExpr,
            returnEdge.resultValueDefinitionRow,
            returnEdge.sourceDefinitionDomain,
            returnEdge.sourceDefinitionRow,
            returnEdge.resultOwnership,
            false)
        if emitActions:
            var snapshotActionKind = CleanupActionSnapshotRetainOwnedReturn
            if typeRow.returnSnapshotKind == ReturnSnapshotClone:
                snapshotActionKind = CleanupActionSnapshotCloneOwnedReturn
            let snapshotActionIndex = actions.len
            ownershipDropAppendAction(actions,
                                      edgeId,
                                      -1,
                                      snapshotActionKind,
                                      0,
                                      place.placeId,
                                      -1,
                                      -1,
                                      place.typeId,
                                      0,
                                      DropConditionAlways,
                                      -1,
                                      false,
                                      DropConditionAlways,
                                      -1,
                                      false)
            actions[snapshotActionIndex].returnSnapshotGlueId =
                typeRow.returnSnapshotGlueId
            actions[snapshotActionIndex].returnSnapshotGlueSymbol =
                typeRow.returnSnapshotGlueSymbol
            actions[snapshotActionIndex].definitionOriginKind =
                DefinitionOriginTypedExpr
            actions[snapshotActionIndex].definitionOriginId =
                returnEdge.resultValueDefinitionRow
            actions[snapshotActionIndex].sourceDefinitionDomain =
                returnEdge.sourceDefinitionDomain
            actions[snapshotActionIndex].sourceDefinitionRow =
                returnEdge.sourceDefinitionRow
            actions[snapshotActionIndex].sourceOwnership =
                returnEdge.resultOwnership
        # The hidden return snapshot owns an independent retain/clone. The
        # source binding remains initialized so deferred suites observe and
        # may mutate it before ordinary reverse-scope cleanup.
    elif place.ownership == RcBorrowedValue:
        let sourcePlaceId = state.borrowSourcePlaceIds[placeIndex]
        if sourcePlaceId <= 0:
            ownershipDropFail("ownership_drop_ir: RC borrowed return lacks owner")
        let sourceIndex = ownershipDropPlaceIndex(ir, sourcePlaceId)
        ownershipDropRequireDefiniteInitialized(state, sourceIndex)
        if ir.places[sourceIndex].ownership != Owned ||
           ir.places[sourceIndex].typeId != place.typeId:
            ownershipDropFail("ownership_drop_ir: RC borrowed return owner mismatch")
        if emitActions:
            let returnActionIndex = actions.len
            ownershipDropAppendAction(actions,
                                      edgeId,
                                      -1,
                                      CleanupActionRetainRcBorrowedReturn,
                                      0,
                                      place.placeId,
                                      -1,
                                      -1,
                                      place.typeId,
                                      0,
                                      DropConditionAlways,
                                      -1,
                                      false,
                                      DropConditionAlways,
                                      -1,
                                      false)
            actions[returnActionIndex].definitionOriginKind =
                DefinitionOriginTypedExpr
            actions[returnActionIndex].definitionOriginId =
                returnEdge.resultValueDefinitionRow
            actions[returnActionIndex].sourceDefinitionDomain =
                returnEdge.sourceDefinitionDomain
            actions[returnActionIndex].sourceDefinitionRow =
                returnEdge.sourceDefinitionRow
            actions[returnActionIndex].sourceOwnership =
                returnEdge.resultOwnership
        # Snapshot retains the value before cleanup. The source view remains
        # live until normal reverse-scope cleanup closes the borrow.
        state.escapeMasks[placeIndex] = ownershipEscapeReturn
    elif place.ownership == VarBorrow:
        ownershipDropFail("ownership_drop_ir: var borrow cannot escape by return")
    elif place.ownership == Unmanaged:
        if emitActions:
            let returnActionIndex = actions.len
            ownershipDropAppendAction(actions,
                                      edgeId,
                                      -1,
                                      CleanupActionReturnUnmanaged,
                                      0,
                                      place.placeId,
                                      -1,
                                      -1,
                                      place.typeId,
                                      0,
                                      DropConditionAlways,
                                      -1,
                                      false,
                                      DropConditionAlways,
                                      -1,
                                      false)
            actions[returnActionIndex].definitionOriginKind =
                DefinitionOriginTypedExpr
            actions[returnActionIndex].definitionOriginId =
                returnEdge.resultValueDefinitionRow
            actions[returnActionIndex].sourceDefinitionDomain =
                returnEdge.sourceDefinitionDomain
            actions[returnActionIndex].sourceDefinitionRow =
                returnEdge.sourceDefinitionRow
            actions[returnActionIndex].sourceOwnership =
                returnEdge.resultOwnership
        # Plain values are copied into the return snapshot. Keep the source
        # live so a deferred read observes the pre-cleanup binding, then let
        # the ordinary cleanup inventory retire it.
        state.escapeMasks[placeIndex] = ownershipEscapeReturn
    else:
        ownershipDropFail("ownership_drop_ir: return sees unknown ownership")

@borrows
fn ownershipDropValidateClosed(ir: var OwnershipDropIr,
                               state: var OwnershipDropFlowState,
                               context: str) =
    for placeIndex in 0..<ir.places.len:
        if ownershipDropMaskHasLive(state.placeStateMasks[placeIndex]):
            ownershipDropFail(context)
        if state.borrowSourcePlaceIds[placeIndex] != -1 ||
           state.borrowProjectionTokens[placeIndex] != -1:
            ownershipDropFail("ownership_drop_ir: terminal leaves borrow metadata")
    for ownerIndex in 0..<ir.places.len:
        if ownershipDropHasPossibleBorrow(ir,
                                          state,
                                          ir.places[ownerIndex].placeId,
                                          true,
                                          true):
            ownershipDropFail("ownership_drop_ir: terminal leaves active loan")
    for deferIndex in 0..<ir.deferEffects.len:
        if ownershipDropMaskHasLive(state.deferActiveMasks[deferIndex]):
            ownershipDropFail("ownership_drop_ir: terminal leaves active defer")

@borrows
fn ownershipDropApplyEdge(ir: var OwnershipDropIr,
                          edge: OwnershipDropEdge,
                          state: var OwnershipDropFlowState,
                          emitActions: bool,
                          actions: var OwnershipDropCleanupAction[]) =
    if !ownershipDropEdgeKindKnown(edge.kind):
        ownershipDropFail("ownership_drop_ir: edge has unknown kind")
    ownershipDropValidateCleanupInventory(ir, edge)
    ownershipDropValidateDeferInventory(ir, edge)
    # Return evaluation and ownership-aware snapshot happen before any defer.
    # Later cleanup may mutate or release the source binding without changing
    # the already captured result.
    if edge.kind == OwnershipDropEdgeReturn:
        ownershipDropApplyReturnPlace(ir,
                                      state,
                                      edge.edgeId,
                                      edge.returnPlaceId,
                                      emitActions,
                                      actions)
    var conditionalDropPlaceIds: int32[]
    var conditionalDropDeferIds: int32[]
    # edgeDeferIds is already the exact LIFO exit inventory.
    for deferOffset in 0..<edge.deferIdCount:
        let deferIndex = edge.deferIdStart + deferOffset
        let deferId = ir.edgeDeferIds[deferIndex]
        let effectIndex = ownershipDropDeferIndex(ir, deferId)
        let effect = ir.deferEffects[effectIndex]
        let activeMask = state.deferActiveMasks[effectIndex]
        if effect.kind == DeferEffectDropPlace &&
           ownershipDropMaskHasLive(activeMask) &&
           activeMask != ownershipStateInitialized:
            for existingIndex in 0..<conditionalDropPlaceIds.len:
                if conditionalDropPlaceIds[existingIndex] == effect.placeId:
                    ownershipDropFail(
                        "ownership_drop_ir: multiple conditional drops for place")
            add(conditionalDropPlaceIds, effect.placeId)
            add(conditionalDropDeferIds, deferId)
        ownershipDropApplyDefer(ir,
                                state,
                                edge.edgeId,
                                deferId,
                                emitActions,
                                actions)
    for reverseOffset in 0..<edge.cleanupPlaceCount:
        let cleanupIndex = edge.cleanupPlaceStart + edge.cleanupPlaceCount - 1 - reverseOffset
        let placeId = ir.cleanupPlaceIds[cleanupIndex]
        let cleanupActionStart = actions.len
        ownershipDropCleanupPlace(ir,
                                  state,
                                  edge.edgeId,
                                  ownershipDropPlaceIndex(ir, placeId),
                                  emitActions,
                                  actions)
        if emitActions:
            for correlationIndex in 0..<conditionalDropPlaceIds.len:
                if conditionalDropPlaceIds[correlationIndex] == placeId:
                    for actionIndex in cleanupActionStart..<actions.len:
                        if actions[actionIndex].guardDeferId != -1:
                            ownershipDropFail(
                                "ownership_drop_ir: cleanup guard already bound")
                        actions[actionIndex].guardDeferId =
                            conditionalDropDeferIds[correlationIndex]
                        actions[actionIndex].guardDeferNegated = true
    if edge.kind == OwnershipDropEdgeReturn:
        ownershipDropValidateClosed(ir,
                                    state,
                                    "ownership_drop_ir: return edge leaves live place")
    ownershipDropReleaseScratchSequence(conditionalDropPlaceIds)
    ownershipDropReleaseScratchSequence(conditionalDropDeferIds)

@borrows
fn ownershipDropValidateOpShape(ir: var OwnershipDropIr,
                                op: OwnershipDropOp) =
    if op.kind == OwnershipDropOpUnknown:
        ownershipDropFail("ownership_drop_ir: unknown operation in IR")
    let manualConsume =
        op.kind == OwnershipDropOpManualConsumeTransfer
    if !manualConsume &&
       (op.manualConsumeRow != -1 ||
        op.manualTargetDefinitionDomain != 0 ||
        op.manualTargetDefinitionRow != -1 ||
        op.manualSourceDefinitionDomain != 0 ||
        op.manualSourceDefinitionRow != -1):
        ownershipDropFail(
            "ownership_drop_ir: manual-consume authority on other op")
    if (op.definitionDomain == 0) !=
           (op.definitionRow == -1) ||
       op.definitionDomain < 0 || op.definitionRow < -1:
        ownershipDropFail(
            "ownership_drop_ir: op definition coordinate malformed")
    let requiresAuthority =
        op.kind == OwnershipDropOpInitialize ||
        op.kind == OwnershipDropOpInitializeField ||
        op.kind == OwnershipDropOpMove ||
        op.kind == OwnershipDropOpRetainedAssign
    if requiresAuthority:
        if op.definitionOriginKind == DefinitionOriginUnknown:
            if op.definitionOriginId != -1 ||
               op.sourceDefinitionDomain != 0 ||
               op.sourceDefinitionRow != -1 ||
               op.sourceOwnership != OwnershipUnknown:
                ownershipDropFail(
                    "ownership_drop_ir: partial value-definition authority")
        else:
            ownershipDropValidateDefinitionAuthority(
                op.definitionOriginKind,
                op.definitionOriginId,
                op.sourceDefinitionDomain,
                op.sourceDefinitionRow,
                op.sourceOwnership,
                false)
            if (op.kind == OwnershipDropOpInitialize ||
                op.kind == OwnershipDropOpInitializeField) &&
               (op.definitionOriginKind != DefinitionOriginTypedExpr ||
                op.sourceOwnership != Owned):
                ownershipDropFail(
                    "ownership_drop_ir: initialize authority shape invalid")
    elif op.definitionOriginKind != DefinitionOriginUnknown ||
         op.definitionOriginId != -1 ||
         op.sourceDefinitionDomain != 0 ||
         op.sourceDefinitionRow != -1 ||
         op.sourceOwnership != OwnershipUnknown:
        ownershipDropFail(
            "ownership_drop_ir: value-definition authority on unsupported op")
    if op.kind == OwnershipDropOpActivateDefer:
        ownershipDropDeferIndex(ir, op.placeId)
        if op.otherPlaceId != -1 ||
           op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed defer activation op")
        return
    let placeIndex = ownershipDropPlaceIndex(ir, op.placeId)
    if op.kind == OwnershipDropOpInitialize ||
       op.kind == OwnershipDropOpInitializeExisting:
        if op.otherPlaceId != -1 ||
           op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed initialize op")
        if op.kind == OwnershipDropOpInitializeExisting &&
           ir.places[placeIndex].ownership != Owned:
            ownershipDropFail(
                "ownership_drop_ir: existing initialization targets non-owner")
        if op.kind == OwnershipDropOpInitialize &&
           (ir.places[placeIndex].ownership == RcBorrowedValue ||
            ir.places[placeIndex].ownership == VarBorrow):
            ownershipDropFail("ownership_drop_ir: initialize op targets borrow view")
    elif op.kind == OwnershipDropOpInitializeField:
        if op.otherPlaceId != -1 ||
           op.projectionToken != -1 ||
           op.fieldOrdinal < 0 ||
           op.fieldOrdinal >= ir.places[placeIndex].fieldCount ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed initialize-field op")
        if ir.places[placeIndex].ownership != Owned:
            ownershipDropFail("ownership_drop_ir: field init op targets non-owner")
    elif op.kind == OwnershipDropOpRcBorrow:
        let otherIndex = ownershipDropPlaceIndex(ir, op.otherPlaceId)
        if op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed RC-borrow op")
        if ir.places[placeIndex].ownership != Owned ||
           ir.places[otherIndex].ownership != RcBorrowedValue ||
           ir.places[placeIndex].typeId != ir.places[otherIndex].typeId:
            ownershipDropFail("ownership_drop_ir: RC-borrow operand mismatch")
    elif op.kind == OwnershipDropOpEndRcBorrow ||
         op.kind == OwnershipDropOpEndVarBorrow ||
         op.kind == OwnershipDropOpUseRead ||
         op.kind == OwnershipDropOpUseWrite ||
         op.kind == OwnershipDropOpConsume ||
         op.kind == OwnershipDropOpDrop:
        if op.otherPlaceId != -1 ||
           op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed unary ownership op")
        if op.kind == OwnershipDropOpEndRcBorrow &&
           ir.places[placeIndex].ownership != RcBorrowedValue:
            ownershipDropFail("ownership_drop_ir: end-RC op targets wrong place")
        if op.kind == OwnershipDropOpEndVarBorrow &&
           ir.places[placeIndex].ownership != VarBorrow:
            ownershipDropFail("ownership_drop_ir: end-var op targets wrong place")
        if (op.kind == OwnershipDropOpConsume || op.kind == OwnershipDropOpDrop) &&
           ir.places[placeIndex].ownership != Owned:
            ownershipDropFail("ownership_drop_ir: drop op targets non-owner")
    elif op.kind == OwnershipDropOpVarBorrow:
        let otherIndex = ownershipDropPlaceIndex(ir, op.otherPlaceId)
        if op.projectionToken < 0 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed var-borrow op")
        if ir.places[placeIndex].ownership != Owned ||
           ir.places[otherIndex].ownership != VarBorrow:
            ownershipDropFail("ownership_drop_ir: var-borrow operand mismatch")
    elif op.kind == OwnershipDropOpMove ||
         op.kind == OwnershipDropOpRetainedAssign:
        let otherIndex = ownershipDropPlaceIndex(ir, op.otherPlaceId)
        if op.placeId == op.otherPlaceId && op.kind == OwnershipDropOpMove:
            ownershipDropFail("ownership_drop_ir: malformed self move op")
        if op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape:
            ownershipDropFail("ownership_drop_ir: malformed binary ownership op")
        if op.kind == OwnershipDropOpMove:
            if ir.places[placeIndex].ownership != Owned ||
               ir.places[otherIndex].ownership != Owned ||
               ir.places[placeIndex].typeId != ir.places[otherIndex].typeId:
                ownershipDropFail("ownership_drop_ir: move operand mismatch")
            if op.definitionOriginKind != DefinitionOriginUnknown &&
               op.sourceOwnership != ir.places[placeIndex].ownership:
                ownershipDropFail(
                    "ownership_drop_ir: move source authority owner mismatch")
        elif ir.places[placeIndex].ownership != Owned ||
             (ir.places[otherIndex].ownership != Owned &&
              ir.places[otherIndex].ownership != RcBorrowedValue) ||
             ir.places[placeIndex].typeId != ir.places[otherIndex].typeId:
            ownershipDropFail("ownership_drop_ir: retained-assign operand mismatch")
        elif op.definitionOriginKind != DefinitionOriginUnknown &&
             op.sourceOwnership != ir.places[otherIndex].ownership:
            ownershipDropFail(
                "ownership_drop_ir: retained source authority owner mismatch")
    elif op.kind == OwnershipDropOpManualConsumeTransfer:
        let otherIndex =
            ownershipDropPlaceIndex(ir, op.otherPlaceId)
        if op.placeId == op.otherPlaceId ||
           op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           op.escapeKind != NoEscape ||
           op.manualConsumeRow < 0 ||
           (op.manualTargetDefinitionDomain !=
                OwnershipDropDefinitionDomainEntrySlot &&
            op.manualTargetDefinitionDomain !=
                OwnershipDropDefinitionDomainManualConsumePostCall) ||
           op.manualTargetDefinitionRow < 0 ||
           op.manualSourceDefinitionDomain <
               OwnershipDropDefinitionDomainEntrySlot ||
           op.manualSourceDefinitionDomain >
               OwnershipDropDefinitionDomainBodyOp ||
           op.manualSourceDefinitionRow < 0 ||
           op.definitionDomain !=
               OwnershipDropDefinitionDomainManualConsumePostCall ||
           op.definitionRow != op.manualConsumeRow ||
           (op.manualTargetDefinitionDomain ==
                op.manualSourceDefinitionDomain &&
            op.manualTargetDefinitionRow ==
                op.manualSourceDefinitionRow) ||
           ir.places[otherIndex].ownership != Owned ||
           ir.places[placeIndex].ownership !=
               ExternalVarBorrow ||
           ir.places[placeIndex].typeId !=
               ir.places[otherIndex].typeId:
            ownershipDropFail(
                "ownership_drop_ir: malformed manual-consume transfer")
    elif op.kind == OwnershipDropOpMoveOut:
        if op.otherPlaceId != -1 ||
           op.projectionToken != -1 ||
           op.fieldOrdinal != -1 ||
           (op.escapeKind != ReturnEscape &&
            op.escapeKind != GlobalEscape &&
            op.escapeKind != ThreadEscape):
            ownershipDropFail("ownership_drop_ir: malformed move-out op")
        if ir.places[placeIndex].ownership != Owned:
            ownershipDropFail("ownership_drop_ir: move-out op targets non-owner")
    else:
        ownershipDropFail("ownership_drop_ir: unsupported operation in IR")

@borrows
fn ownershipDropValidateStructure(ir: var OwnershipDropIr) =
    if ir.scopes.len <= 0:
        ownershipDropFail("ownership_drop_ir: IR lacks root scope")
    for scopeIndex in 0..<ir.scopes.len:
        let scope = ir.scopes[scopeIndex]
        if scope.scopeId != scopeIndex:
            ownershipDropFail("ownership_drop_ir: malformed scope id")
        if scopeIndex == 0:
            if scope.parentScopeId != -1:
                ownershipDropFail("ownership_drop_ir: malformed root scope")
        elif scope.parentScopeId < 0 || scope.parentScopeId >= scopeIndex:
            ownershipDropFail("ownership_drop_ir: malformed scope parent")
    var expectedTypeFieldStart: int32
    for typeIndex in 0..<ir.types.len:
        let row = ir.types[typeIndex]
        if row.typeId != typeIndex + 1 ||
           len(row.name) == 0 ||
           row.dropGlueId < 0 ||
           row.returnSnapshotGlueId < 0 ||
           row.fieldTypeStart != expectedTypeFieldStart ||
           row.fieldCount < 0 ||
           row.fieldTypeStart + row.fieldCount > ir.typeFieldTypeIds.len:
            ownershipDropFail("ownership_drop_ir: malformed type row")
        if row.returnSnapshotKind == ReturnSnapshotUnknown:
            if row.returnSnapshotGlueId != 0 ||
               len(row.returnSnapshotGlueSymbol) != 0:
                ownershipDropFail("ownership_drop_ir: snapshot glue without policy")
        elif !ownershipDropReturnSnapshotKindKnown(row.returnSnapshotKind) ||
             row.returnSnapshotGlueId <= 0 ||
             len(row.returnSnapshotGlueSymbol) == 0:
            ownershipDropFail("ownership_drop_ir: malformed return snapshot policy")
        var hasManagedField: bool
        for fieldOrdinal in 0..<row.fieldCount:
            let fieldTypeId = ir.typeFieldTypeIds[row.fieldTypeStart + fieldOrdinal]
            if fieldTypeId <= 0 || fieldTypeId > ir.types.len:
                ownershipDropFail("ownership_drop_ir: malformed type field id")
            if ir.types[fieldTypeId - 1].dropGlueId > 0:
                hasManagedField = true
        if hasManagedField && row.dropGlueId <= 0:
            ownershipDropFail("ownership_drop_ir: managed aggregate lacks glue")
        expectedTypeFieldStart = row.fieldTypeStart + row.fieldCount
    if expectedTypeFieldStart != ir.typeFieldTypeIds.len:
        ownershipDropFail("ownership_drop_ir: orphan type field rows")
    var expectedPlaceFieldStart: int32
    for placeIndex in 0..<ir.places.len:
        let place = ir.places[placeIndex]
        if place.placeId != placeIndex + 1 ||
           !ownershipDropOwnershipValid(place.ownership) ||
           place.typeId <= 0 || place.typeId > ir.types.len ||
           place.scopeId < 0 || place.scopeId >= ir.scopes.len ||
           place.fieldStateStart != expectedPlaceFieldStart ||
           place.fieldCount != ir.types[place.typeId - 1].fieldCount ||
           (place.initialDefinitionDomain == 0) !=
               (place.initialDefinitionRow == -1) ||
           place.initialDefinitionDomain < 0 ||
           place.initialDefinitionRow < -1 ||
           (place.initialDefinitionDomain > 0 &&
            place.scopeId != 0) ||
           (place.ownership == ExternalVarBorrow &&
            place.initialDefinitionDomain <= 0):
            ownershipDropFail("ownership_drop_ir: malformed place row")
        let glueId = ir.types[place.typeId - 1].dropGlueId
        if (place.ownership == Owned || place.ownership == RcBorrowedValue) &&
           glueId <= 0:
            ownershipDropFail("ownership_drop_ir: managed place lacks glue")
        if place.ownership == Unmanaged && glueId != 0:
            ownershipDropFail("ownership_drop_ir: unmanaged place has glue")
        expectedPlaceFieldStart = place.fieldStateStart + place.fieldCount
    if expectedPlaceFieldStart != ir.placeFieldStateCount:
        ownershipDropFail("ownership_drop_ir: malformed place field count")
    var expectedOpStart: int32
    for blockIndex in 0..<ir.blocks.len:
        let block = ir.blocks[blockIndex]
        if block.blockId != blockIndex ||
           block.scopeId < 0 || block.scopeId >= ir.scopes.len ||
           block.opStart != expectedOpStart ||
           block.opCount < 0 ||
           block.opStart + block.opCount > ir.ops.len:
            ownershipDropFail("ownership_drop_ir: malformed block row")
        expectedOpStart = block.opStart + block.opCount
    if expectedOpStart != ir.ops.len:
        ownershipDropFail("ownership_drop_ir: orphan operation rows")
    for opIndex in 0..<ir.ops.len:
        ownershipDropValidateOpShape(ir, ir.ops[opIndex])
    for blockIndex in 0..<ir.blocks.len:
        let block = ir.blocks[blockIndex]
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            if ir.ops[opIndex].kind == OwnershipDropOpActivateDefer:
                let deferIndex = ownershipDropDeferIndex(ir, ir.ops[opIndex].placeId)
                if ir.deferEffects[deferIndex].scopeId != block.scopeId:
                    ownershipDropFail("ownership_drop_ir: defer activation scope mismatch")
    for deferIndex in 0..<ir.deferEffects.len:
        let effect = ir.deferEffects[deferIndex]
        if effect.deferId != deferIndex + 1 ||
           effect.declarationOrdinal != deferIndex ||
           effect.scopeId < 0 || effect.scopeId >= ir.scopes.len ||
           effect.kind == DeferEffectUnknown ||
           effect.kind == DeferEffectPanic:
            ownershipDropFail("ownership_drop_ir: malformed defer effect")
        if effect.kind == DeferEffectNoOwnership:
            if effect.placeId != -1 || effect.otherPlaceId != -1:
                ownershipDropFail("ownership_drop_ir: malformed neutral defer")
        else:
            let placeIndex = ownershipDropPlaceIndex(ir, effect.placeId)
            if !ownershipDropScopeIsAncestor(ir,
                                             ir.places[placeIndex].scopeId,
                                             effect.scopeId):
                ownershipDropFail("ownership_drop_ir: defer captures inactive place")
            if effect.kind == DeferEffectMovePlace:
                let otherIndex = ownershipDropPlaceIndex(ir, effect.otherPlaceId)
                if effect.placeId == effect.otherPlaceId ||
                   !ownershipDropScopeIsAncestor(ir,
                                                 ir.places[otherIndex].scopeId,
                                                 effect.scopeId):
                    ownershipDropFail("ownership_drop_ir: malformed defer move")
                if ir.places[placeIndex].ownership != Owned ||
                   ir.places[otherIndex].ownership != Owned ||
                   ir.places[placeIndex].typeId != ir.places[otherIndex].typeId:
                    ownershipDropFail("ownership_drop_ir: defer move operand mismatch")
            elif effect.otherPlaceId != -1:
                ownershipDropFail("ownership_drop_ir: malformed defer operand")
            if effect.kind == DeferEffectDropPlace &&
               ir.places[placeIndex].ownership != Owned:
                ownershipDropFail("ownership_drop_ir: defer drop targets non-owner")
            if effect.kind == DeferEffectEndRcBorrow &&
               ir.places[placeIndex].ownership != RcBorrowedValue:
                ownershipDropFail("ownership_drop_ir: defer end-RC target mismatch")
            if effect.kind == DeferEffectEndVarBorrow &&
               ir.places[placeIndex].ownership != VarBorrow:
                ownershipDropFail("ownership_drop_ir: defer end-var target mismatch")
    if ir.blocks.len <= 0 ||
       ir.entryBlockId < 0 || ir.entryBlockId >= ir.blocks.len:
        ownershipDropFail("ownership_drop_ir: malformed entry block")
    var expectedCleanupStart: int32
    var expectedDeferStart: int32
    for edgeIndex in 0..<ir.edges.len:
        let edge = ir.edges[edgeIndex]
        if !ownershipDropEdgeKindKnown(edge.kind):
            ownershipDropFail("ownership_drop_ir: unknown edge kind in IR")
        if edge.edgeId != edgeIndex ||
           edge.fromBlockId < 0 || edge.fromBlockId >= ir.blocks.len ||
           edge.toBlockId < 0 || edge.toBlockId >= ir.blocks.len ||
           edge.cleanupPlaceStart != expectedCleanupStart ||
           edge.cleanupPlaceCount < 0 ||
           edge.cleanupPlaceStart + edge.cleanupPlaceCount > ir.cleanupPlaceIds.len ||
           edge.deferIdStart != expectedDeferStart ||
           edge.deferIdCount < 0 ||
           edge.deferIdStart + edge.deferIdCount > ir.edgeDeferIds.len:
            ownershipDropFail("ownership_drop_ir: malformed edge row")
        if edge.kind == OwnershipDropEdgeReturn:
            if edge.returnPlaceId >= 0:
                let returnPlaceIndex =
                    ownershipDropPlaceIndex(ir, edge.returnPlaceId)
                let returnOwnership =
                    ir.places[returnPlaceIndex].ownership
                if returnOwnership == Owned:
                    if edge.resultOwnership != returnOwnership:
                        ownershipDropFail(
                            "ownership_drop_ir: owned return definition authority missing")
                    ownershipDropValidateDefinitionAuthority(
                        DefinitionOriginTypedExpr,
                        edge.resultValueDefinitionRow,
                        edge.sourceDefinitionDomain,
                        edge.sourceDefinitionRow,
                        edge.resultOwnership,
                        false)
                elif returnOwnership == RcBorrowedValue ||
                     returnOwnership == Unmanaged:
                    let authorityMissing =
                        edge.resultExprNodeIndex == -1 &&
                        edge.resultValueDefinitionRow == -1 &&
                        edge.resultOwnership == OwnershipUnknown &&
                        edge.sourceDefinitionDomain == 0 &&
                        edge.sourceDefinitionRow == -1
                    if !authorityMissing:
                        if edge.resultOwnership != returnOwnership ||
                           edge.resultExprNodeIndex < 0 ||
                           edge.resultValueDefinitionRow < 0 ||
                           !ownershipDropDefinitionCoordinateValid(
                               edge.sourceDefinitionDomain,
                               edge.sourceDefinitionRow):
                            ownershipDropFail(
                                "ownership_drop_ir: return definition authority mismatch")
                        if returnOwnership == RcBorrowedValue:
                            ownershipDropValidateDefinitionAuthority(
                                DefinitionOriginTypedExpr,
                                edge.resultValueDefinitionRow,
                                edge.sourceDefinitionDomain,
                                edge.sourceDefinitionRow,
                                edge.resultOwnership,
                                false)
                elif edge.resultExprNodeIndex != -1 ||
                     edge.resultValueDefinitionRow != -1 ||
                     edge.resultOwnership != OwnershipUnknown ||
                     edge.sourceDefinitionDomain != 0 ||
                     edge.sourceDefinitionRow != -1:
                    ownershipDropFail(
                        "ownership_drop_ir: authority on invalid return")
            elif edge.resultExprNodeIndex != -1 ||
                 edge.resultValueDefinitionRow != -1 ||
                 edge.resultOwnership != OwnershipUnknown ||
                 edge.sourceDefinitionDomain != 0 ||
                 edge.sourceDefinitionRow != -1:
                ownershipDropFail(
                    "ownership_drop_ir: void return carries authority")
        elif edge.returnPlaceId != -1:
            ownershipDropFail("ownership_drop_ir: malformed non-return edge")
        elif edge.resultExprNodeIndex != -1 ||
             edge.resultValueDefinitionRow != -1 ||
             edge.resultOwnership != OwnershipUnknown ||
             edge.sourceDefinitionDomain != 0 ||
             edge.sourceDefinitionRow != -1:
            ownershipDropFail(
                "ownership_drop_ir: non-return edge carries return authority")
        var cleanupSeen: bool[]
        for i in 0..<ir.places.len:
            add(cleanupSeen, false)
        for i in 0..<edge.cleanupPlaceCount:
            let placeIndex = ownershipDropPlaceIndex(ir,
                                                     ir.cleanupPlaceIds[edge.cleanupPlaceStart + i])
            if cleanupSeen[placeIndex]:
                ownershipDropFail("ownership_drop_ir: duplicate cleanup place in IR")
            cleanupSeen[placeIndex] = true
        var deferSeen: bool[]
        for i in 0..<ir.deferEffects.len:
            add(deferSeen, false)
        for i in 0..<edge.deferIdCount:
            let deferIndex = ownershipDropDeferIndex(ir,
                                                     ir.edgeDeferIds[edge.deferIdStart + i])
            if deferSeen[deferIndex]:
                ownershipDropFail("ownership_drop_ir: duplicate defer in IR")
            deferSeen[deferIndex] = true
        ownershipDropValidateCleanupInventory(ir, edge)
        ownershipDropValidateDeferInventory(ir, edge)
        if edge.toBlockId == ir.entryBlockId:
            ownershipDropFail("ownership_drop_ir: entry block has predecessor")
        ownershipDropReleaseScratchSequence(cleanupSeen)
        ownershipDropReleaseScratchSequence(deferSeen)
        expectedCleanupStart = edge.cleanupPlaceStart + edge.cleanupPlaceCount
        expectedDeferStart = edge.deferIdStart + edge.deferIdCount
    if expectedCleanupStart != ir.cleanupPlaceIds.len ||
       expectedDeferStart != ir.edgeDeferIds.len:
        ownershipDropFail("ownership_drop_ir: orphan edge inventory rows")

fn OwnershipDropFinalize(ir: var OwnershipDropIr) =
    ownershipDropValidateStructure(ir)

fn OwnershipDropRequireCanonicalDefinitionAuthority(
        ir: var OwnershipDropIr) =
    OwnershipDropFinalize(ir)
    for edgeIndex in 0..<ir.edges.len:
        let edge = ir.edges[edgeIndex]
        if edge.kind == OwnershipDropEdgeReturn &&
           edge.returnPlaceId >= 0:
            let placeIndex =
                ownershipDropPlaceIndex(ir, edge.returnPlaceId)
            if edge.resultExprNodeIndex < 0 ||
               edge.resultValueDefinitionRow < 0 ||
               !ownershipDropDefinitionCoordinateValid(
                   edge.sourceDefinitionDomain,
                   edge.sourceDefinitionRow) ||
               edge.resultOwnership !=
                   ir.places[placeIndex].ownership:
                ownershipDropFail(
                    "ownership_drop_ir: canonical return definition authority missing")
    for opIndex in 0..<ir.ops.len:
        let op = ir.ops[opIndex]
        var requiresAuthority =
            op.kind == OwnershipDropOpMove ||
            op.kind == OwnershipDropOpRetainedAssign
        if op.kind == OwnershipDropOpInitialize ||
           op.kind == OwnershipDropOpInitializeField:
            let placeIndex = ownershipDropPlaceIndex(ir, op.placeId)
            requiresAuthority =
                ir.places[placeIndex].ownership == Owned
        if requiresAuthority &&
           op.definitionOriginKind == DefinitionOriginUnknown:
            ownershipDropFail(
                "ownership_drop_ir: canonical managed definition authority missing")

fn ownershipDropAnalysisInit(ir: var OwnershipDropIr,
                             out: var OwnershipDropAnalysis) =
    if out.storageReleased ||
       !ownershipDropSequenceStorageReleased(out.blockInputs) ||
       !ownershipDropSequenceStorageReleased(out.blockOutputs) ||
       !ownershipDropSequenceStorageReleased(out.opActionStarts) ||
       !ownershipDropSequenceStorageReleased(out.opActionCounts) ||
       !ownershipDropSequenceStorageReleased(out.edgeActionStarts) ||
       !ownershipDropSequenceStorageReleased(out.edgeActionCounts) ||
       !ownershipDropSequenceStorageReleased(out.cleanupActions) ||
       !ownershipDropSequenceStorageReleased(out.conditionFlags) ||
       !ownershipDropSequenceStorageReleased(out.flagTransitions):
        ownershipDropFail(
            "ownership_drop_ir: analysis init requires empty output")
    out.fixedPointSteps = 0
    out.converged = false
    for i in 0..<ir.blocks.len:
        var input: OwnershipDropFlowState
        var output: OwnershipDropFlowState
        add(out.blockInputs, input)
        add(out.blockOutputs, output)
    for i in 0..<ir.ops.len:
        add(out.opActionStarts, -1)
        add(out.opActionCounts, 0)
    for i in 0..<ir.edges.len:
        add(out.edgeActionStarts, -1)
        add(out.edgeActionCounts, 0)
    for placeIndex in 0..<ir.places.len:
        var flag: OwnershipDropConditionFlag
        flag.flagId = ownershipDropPlaceFlagId(placeIndex)
        flag.kind = ConditionFlagPlaceInitialized
        flag.placeId = ir.places[placeIndex].placeId
        flag.fieldOrdinal = -1
        flag.deferId = -1
        flag.initialValue =
            ir.places[placeIndex].initialDefinitionDomain > 0
        add(out.conditionFlags, flag)
    for placeIndex in 0..<ir.places.len:
        let place = ir.places[placeIndex]
        for fieldOrdinal in 0..<place.fieldCount:
            let fieldStateIndex = place.fieldStateStart + fieldOrdinal
            var flag: OwnershipDropConditionFlag
            flag.flagId = ownershipDropFieldFlagId(ir, fieldStateIndex)
            flag.kind = ConditionFlagFieldInitialized
            flag.placeId = place.placeId
            flag.fieldOrdinal = fieldOrdinal
            flag.deferId = -1
            flag.initialValue =
                place.initialDefinitionDomain > 0
            add(out.conditionFlags, flag)
    for deferIndex in 0..<ir.deferEffects.len:
        var flag: OwnershipDropConditionFlag
        flag.flagId = ownershipDropDeferFlagId(ir, deferIndex)
        flag.kind = ConditionFlagDeferActive
        flag.placeId = -1
        flag.fieldOrdinal = -1
        flag.deferId = ir.deferEffects[deferIndex].deferId
        flag.initialValue = false
        add(out.conditionFlags, flag)

@borrows
fn ownershipDropAppendFlagTransition(transitions: var OwnershipDropFlagTransition[],
                                     originKind: OwnershipDropFlagOriginKind,
                                     originId: int32,
                                     flagId: int32,
                                     setValue: bool) =
    var transition: OwnershipDropFlagTransition
    transition.originKind = originKind
    transition.originId = originId
    transition.flagId = flagId
    transition.setValue = setValue
    transition.afterActions = true
    add(transitions, transition)

@borrows
fn ownershipDropRecordOneFlag(beforeMask: int32,
                              afterMask: int32,
                              originKind: OwnershipDropFlagOriginKind,
                              originId: int32,
                              flagId: int32,
                              transitions: var OwnershipDropFlagTransition[]) =
    let beforeSet = beforeMask == ownershipStateInitialized
    let afterSet = afterMask == ownershipStateInitialized
    let beforeMaySet = ownershipDropMaskHasLive(beforeMask)
    let afterMaySet = ownershipDropMaskHasLive(afterMask)
    if afterSet && !beforeSet:
        ownershipDropAppendFlagTransition(transitions,
                                          originKind,
                                          originId,
                                          flagId,
                                          true)
    elif !afterMaySet && beforeMaySet:
        ownershipDropAppendFlagTransition(transitions,
                                          originKind,
                                          originId,
                                          flagId,
                                          false)

@borrows
fn ownershipDropRecordFlagTransitions(ir: var OwnershipDropIr,
                                      before: var OwnershipDropFlowState,
                                      after: var OwnershipDropFlowState,
                                      originKind: OwnershipDropFlagOriginKind,
                                      originId: int32,
                                      transitions: var OwnershipDropFlagTransition[]) =
    for placeIndex in 0..<ir.places.len:
        ownershipDropRecordOneFlag(before.placeStateMasks[placeIndex],
                                   after.placeStateMasks[placeIndex],
                                   originKind,
                                   originId,
                                   ownershipDropPlaceFlagId(placeIndex),
                                   transitions)
    for fieldIndex in 0..<ir.placeFieldStateCount:
        ownershipDropRecordOneFlag(before.fieldStateMasks[fieldIndex],
                                   after.fieldStateMasks[fieldIndex],
                                   originKind,
                                   originId,
                                   ownershipDropFieldFlagId(ir, fieldIndex),
                                   transitions)
    for deferIndex in 0..<ir.deferEffects.len:
        ownershipDropRecordOneFlag(before.deferActiveMasks[deferIndex],
                                   after.deferActiveMasks[deferIndex],
                                   originKind,
                                   originId,
                                   ownershipDropDeferFlagId(ir, deferIndex),
                                   transitions)

@borrows
fn ownershipDropValidateActionCondition(ir: var OwnershipDropIr,
                                        analysis: var OwnershipDropAnalysis,
                                        action: OwnershipDropCleanupAction,
                                        kind: OwnershipDropConditionKind,
                                        flagId: int32,
                                        negated: bool) =
    if kind == DropConditionAlways:
        if flagId != -1 || negated:
            ownershipDropFail("ownership_drop_ir: malformed always condition")
        return
    if kind == DropConditionCapturedOldPlace ||
       kind == DropConditionCapturedOldField:
        if flagId <= 0 ||
           flagId != action.actionId ||
           action.opIndex < 0 ||
           (action.kind != CleanupActionDropPlace &&
            action.kind != CleanupActionDropField):
            ownershipDropFail("ownership_drop_ir: malformed captured-old condition")
        if kind == DropConditionCapturedOldField && action.fieldOrdinal < 0:
            ownershipDropFail("ownership_drop_ir: captured field condition lacks field")
        return
    if flagId <= 0 || flagId > analysis.conditionFlags.len:
        ownershipDropFail("ownership_drop_ir: action condition flag out of range")
    let flag = analysis.conditionFlags[flagId - 1]
    if flag.flagId != flagId:
        ownershipDropFail("ownership_drop_ir: action condition flag corrupt")
    if kind == DropConditionPlaceInitialized:
        if flag.kind != ConditionFlagPlaceInitialized ||
           flag.placeId != action.placeId:
            ownershipDropFail("ownership_drop_ir: action place condition mismatch")
    elif kind == DropConditionFieldInitialized:
        if flag.kind != ConditionFlagFieldInitialized ||
           flag.placeId != action.placeId ||
           flag.fieldOrdinal != action.fieldOrdinal:
            ownershipDropFail("ownership_drop_ir: action field condition mismatch")
    elif kind == DropConditionDeferActive:
        if flag.kind != ConditionFlagDeferActive ||
           flag.deferId != action.actionId:
            ownershipDropFail("ownership_drop_ir: action defer condition mismatch")
    else:
        ownershipDropFail("ownership_drop_ir: unknown action condition")

@borrows
fn ownershipDropActionsEqual(lhs: OwnershipDropCleanupAction,
                             rhs: OwnershipDropCleanupAction): bool =
    return lhs.edgeId == rhs.edgeId &&
           lhs.opIndex == rhs.opIndex &&
           lhs.kind == rhs.kind &&
           lhs.actionId == rhs.actionId &&
           lhs.placeId == rhs.placeId &&
           lhs.otherPlaceId == rhs.otherPlaceId &&
           lhs.fieldOrdinal == rhs.fieldOrdinal &&
           lhs.typeId == rhs.typeId &&
           lhs.dropGlueId == rhs.dropGlueId &&
           lhs.returnSnapshotGlueId == rhs.returnSnapshotGlueId &&
           lhs.returnSnapshotGlueSymbol == rhs.returnSnapshotGlueSymbol &&
           lhs.conditionKind == rhs.conditionKind &&
           lhs.conditionFlagId == rhs.conditionFlagId &&
           lhs.conditionNegated == rhs.conditionNegated &&
           lhs.conditionOtherKind == rhs.conditionOtherKind &&
           lhs.conditionOtherFlagId == rhs.conditionOtherFlagId &&
           lhs.conditionOtherNegated == rhs.conditionOtherNegated &&
           lhs.guardDeferId == rhs.guardDeferId &&
           lhs.guardDeferNegated == rhs.guardDeferNegated &&
           lhs.definitionOriginKind == rhs.definitionOriginKind &&
           lhs.definitionOriginId == rhs.definitionOriginId &&
           lhs.sourceDefinitionDomain ==
               rhs.sourceDefinitionDomain &&
           lhs.sourceDefinitionRow == rhs.sourceDefinitionRow &&
           lhs.capturedOldSourceDefinitionDomain ==
               rhs.capturedOldSourceDefinitionDomain &&
           lhs.capturedOldSourceDefinitionRow ==
               rhs.capturedOldSourceDefinitionRow &&
           lhs.sourceOwnership == rhs.sourceOwnership &&
           lhs.consumeActionRow == rhs.consumeActionRow

@borrows
fn ownershipDropValidatedGuardFlagId(
        ir: var OwnershipDropIr,
        analysis: var OwnershipDropAnalysis,
        action: OwnershipDropCleanupAction): int32 =
    if action.guardDeferId < 0:
        if action.guardDeferId != -1 || action.guardDeferNegated:
            ownershipDropFail("ownership_drop_ir: malformed defer guard id")
        return -1
    if action.kind == CleanupActionDefer || action.edgeId < 0 ||
       action.edgeId >= ir.edges.len:
        ownershipDropFail("ownership_drop_ir: malformed guarded action origin")
    let deferIndex = ownershipDropDeferIndex(ir, action.guardDeferId)
    let guardFlagId = ownershipDropDeferFlagId(ir, deferIndex)
    if guardFlagId <= 0 || guardFlagId > analysis.conditionFlags.len:
        ownershipDropFail("ownership_drop_ir: defer guard flag out of range")
    let guardFlag = analysis.conditionFlags[guardFlagId - 1]
    if guardFlag.flagId != guardFlagId ||
       guardFlag.kind != ConditionFlagDeferActive ||
       guardFlag.deferId != action.guardDeferId ||
       guardFlag.placeId != -1 || guardFlag.fieldOrdinal != -1:
        ownershipDropFail("ownership_drop_ir: defer guard flag identity mismatch")
    let edge = ir.edges[action.edgeId]
    var edgeOwnsDefer: bool
    for offset in 0..<edge.deferIdCount:
        if ir.edgeDeferIds[edge.deferIdStart + offset] == action.guardDeferId:
            edgeOwnsDefer = true
    if !edgeOwnsDefer:
        ownershipDropFail("ownership_drop_ir: guarded action defer absent from edge")
    if action.edgeId >= analysis.edgeActionStarts.len ||
       action.edgeId >= analysis.edgeActionCounts.len:
        ownershipDropFail("ownership_drop_ir: guarded action edge range absent")
    let actionStart = analysis.edgeActionStarts[action.edgeId]
    let actionCount = analysis.edgeActionCounts[action.edgeId]
    if actionStart < 0 || actionCount <= 0 ||
       actionStart + actionCount > analysis.cleanupActions.len:
        ownershipDropFail("ownership_drop_ir: guarded action edge range corrupt")
    var actionOrdinal = -1
    for ordinal in 0..<actionCount:
        if ownershipDropActionsEqual(analysis.cleanupActions[actionStart + ordinal],
                                     action):
            if actionOrdinal >= 0:
                ownershipDropFail("ownership_drop_ir: duplicate guarded action")
            actionOrdinal = ordinal
    if actionOrdinal < 0:
        ownershipDropFail("ownership_drop_ir: guarded action not in analysis")
    var markerFound: bool
    for ordinal in 0..<actionOrdinal:
        let previous = analysis.cleanupActions[actionStart + ordinal]
        if previous.kind == CleanupActionDefer &&
           previous.actionId == action.guardDeferId &&
           previous.conditionKind == DropConditionDeferActive &&
           previous.conditionFlagId == guardFlagId &&
           !previous.conditionNegated:
            markerFound = true
    if !markerFound:
        ownershipDropFail("ownership_drop_ir: guarded action lacks active defer marker")
    return guardFlagId

@borrows
fn OwnershipDropProjectActionCondition(
        ir: var OwnershipDropIr,
        analysis: var OwnershipDropAnalysis,
        action: OwnershipDropCleanupAction): OwnershipDropActionConditionProjection =
    ownershipDropValidateActionCondition(ir,
                                         analysis,
                                         action,
                                         action.conditionKind,
                                         action.conditionFlagId,
                                         action.conditionNegated)
    ownershipDropValidateActionCondition(ir,
                                         analysis,
                                         action,
                                         action.conditionOtherKind,
                                         action.conditionOtherFlagId,
                                         action.conditionOtherNegated)
    var out: OwnershipDropActionConditionProjection
    out.primaryKind = action.conditionKind
    out.primaryFlagId = action.conditionFlagId
    out.primaryNegated = action.conditionNegated
    out.secondaryKind = action.conditionOtherKind
    out.secondaryFlagId = action.conditionOtherFlagId
    out.secondaryNegated = action.conditionOtherNegated
    out.guardKind = DropConditionAlways
    out.guardFlagId = -1
    out.guardDeferId = -1
    out.conditionCount = 2
    let guardFlagId = ownershipDropValidatedGuardFlagId(ir, analysis, action)
    if guardFlagId >= 0:
        out.guardKind = DropConditionDeferActive
        out.guardFlagId = guardFlagId
        out.guardNegated = action.guardDeferNegated
        out.guardDeferId = action.guardDeferId
        out.conditionCount = 3
    return out

@borrows
fn OwnershipDropProjectReturnSnapshot(
        ir: var OwnershipDropIr,
        analysis: var OwnershipDropAnalysis,
        action: OwnershipDropCleanupAction): OwnershipDropReturnSnapshotProjection =
    if action.kind != CleanupActionSnapshotRetainOwnedReturn &&
       action.kind != CleanupActionSnapshotCloneOwnedReturn:
        ownershipDropFail("ownership_drop_ir: action is not an owned return snapshot")
    if action.edgeId < 0 || action.edgeId >= ir.edges.len ||
       action.opIndex != -1 || action.guardDeferId != -1:
        ownershipDropFail("ownership_drop_ir: malformed return snapshot origin")
    let edge = ir.edges[action.edgeId]
    if edge.kind != OwnershipDropEdgeReturn ||
       edge.returnPlaceId != action.placeId:
        ownershipDropFail("ownership_drop_ir: snapshot action return edge mismatch")
    ownershipDropValidateActionCondition(ir,
                                         analysis,
                                         action,
                                         action.conditionKind,
                                         action.conditionFlagId,
                                         action.conditionNegated)
    ownershipDropValidateActionCondition(ir,
                                         analysis,
                                         action,
                                         action.conditionOtherKind,
                                         action.conditionOtherFlagId,
                                         action.conditionOtherNegated)
    if action.conditionKind != DropConditionAlways ||
       action.conditionOtherKind != DropConditionAlways:
        ownershipDropFail("ownership_drop_ir: return snapshot is conditional")
    let placeIndex = ownershipDropPlaceIndex(ir, action.placeId)
    let typeRow = ir.types[ir.places[placeIndex].typeId - 1]
    var expectedActionKind = CleanupActionSnapshotRetainOwnedReturn
    if typeRow.returnSnapshotKind == ReturnSnapshotClone:
        expectedActionKind = CleanupActionSnapshotCloneOwnedReturn
    if ir.places[placeIndex].ownership != Owned ||
       action.kind != expectedActionKind ||
       action.typeId != ir.places[placeIndex].typeId ||
       action.otherPlaceId != -1 || action.fieldOrdinal != -1 ||
       action.dropGlueId != 0 ||
       action.returnSnapshotGlueId != typeRow.returnSnapshotGlueId ||
       action.returnSnapshotGlueId <= 0 ||
       action.returnSnapshotGlueSymbol != typeRow.returnSnapshotGlueSymbol ||
       len(action.returnSnapshotGlueSymbol) == 0:
        ownershipDropFail("ownership_drop_ir: malformed owned return snapshot")
    if action.definitionOriginKind != DefinitionOriginTypedExpr ||
       action.definitionOriginId != edge.resultValueDefinitionRow ||
       action.sourceDefinitionDomain != edge.sourceDefinitionDomain ||
       action.sourceDefinitionRow != edge.sourceDefinitionRow ||
       action.sourceOwnership != edge.resultOwnership ||
       action.sourceOwnership != Owned ||
       action.consumeActionRow != -1:
        ownershipDropFail(
            "ownership_drop_ir: return snapshot authority mismatch")
    if action.edgeId >= analysis.edgeActionStarts.len ||
       action.edgeId >= analysis.edgeActionCounts.len:
        ownershipDropFail("ownership_drop_ir: return snapshot analysis edge missing")
    let start = analysis.edgeActionStarts[action.edgeId]
    let count = analysis.edgeActionCounts[action.edgeId]
    if start < 0 || count <= 0 || start + count > analysis.cleanupActions.len:
        ownershipDropFail("ownership_drop_ir: return snapshot edge range missing")
    var foundOrdinal = -1
    for ordinal in 0..<count:
        if ownershipDropActionsEqual(analysis.cleanupActions[start + ordinal], action):
            if foundOrdinal >= 0:
                ownershipDropFail("ownership_drop_ir: duplicate return snapshot action")
            foundOrdinal = ordinal
    if foundOrdinal < 0:
        ownershipDropFail("ownership_drop_ir: return snapshot action not in analysis")
    var out: OwnershipDropReturnSnapshotProjection
    out.kind = typeRow.returnSnapshotKind
    out.edgeId = action.edgeId
    out.actionOrdinal = foundOrdinal
    out.sourcePlaceId = action.placeId
    out.typeId = action.typeId
    out.glueId = action.returnSnapshotGlueId
    let resultOwnership = action.sourceOwnership
    let sourceDefinitionDomain = action.sourceDefinitionDomain
    let sourceDefinitionRow = action.sourceDefinitionRow
    out.glueSymbol = action.returnSnapshotGlueSymbol
    out.resultExprNodeIndex = edge.resultExprNodeIndex
    out.resultValueDefinitionRow = edge.resultValueDefinitionRow
    out.resultOwnership = resultOwnership
    out.sourceDefinitionDomain = sourceDefinitionDomain
    out.sourceDefinitionRow = sourceDefinitionRow
    return out

@borrows
fn ownershipDropBlockForOp(
        ir: var OwnershipDropIr,
        opIndex: int32): int32 =
    if opIndex < 0 || opIndex >= ir.ops.len:
        return -1
    for blockIndex in 0..<ir.blocks.len:
        let block = ir.blocks[blockIndex]
        if opIndex >= block.opStart &&
           opIndex < block.opStart + block.opCount:
            return blockIndex
    return -1

@borrows
fn ownershipDropBlockReaches(
        ir: var OwnershipDropIr,
        fromBlockId: int32,
        toBlockId: int32): bool =
    if fromBlockId < 0 || fromBlockId >= ir.blocks.len ||
       toBlockId < 0 || toBlockId >= ir.blocks.len:
        return false
    if fromBlockId == toBlockId:
        return true
    var reached: bool[]
    var queue: int32[]
    for _ in 0..<ir.blocks.len:
        add(reached, false)
    reached[fromBlockId] = true
    add(queue, fromBlockId)
    var queueIndex: int32
    var found: bool
    while queueIndex < queue.len && !found:
        let blockId = queue[queueIndex]
        queueIndex = queueIndex + 1
        for edgeIndex in 0..<ir.edges.len:
            let edge = ir.edges[edgeIndex]
            # Return edges terminate execution; their toBlockId is only an
            # identity row and never a reachable continuation.
            if edge.fromBlockId != blockId ||
               edge.kind == OwnershipDropEdgeReturn ||
               reached[edge.toBlockId]:
                continue
            if edge.toBlockId == toBlockId:
                found = true
                break
            reached[edge.toBlockId] = true
            add(queue, edge.toBlockId)
    ownershipDropReleaseScratchSequence(reached)
    ownershipDropReleaseScratchSequence(queue)
    return found

@borrows
fn ownershipDropActionsMayCoexecute(
        ir: var OwnershipDropIr,
        first: OwnershipDropCleanupAction,
        second: OwnershipDropCleanupAction): bool =
    if first.edgeId >= 0 && second.edgeId >= 0 &&
       first.edgeId == second.edgeId:
        return true
    var firstAfterBlock = -1
    var secondBeforeBlock = -1
    if first.edgeId >= 0:
        if ir.edges[first.edgeId].kind != OwnershipDropEdgeReturn:
            firstAfterBlock = ir.edges[first.edgeId].toBlockId
    else:
        firstAfterBlock = ownershipDropBlockForOp(ir, first.opIndex)
    if second.edgeId >= 0:
        secondBeforeBlock = ir.edges[second.edgeId].fromBlockId
    else:
        secondBeforeBlock = ownershipDropBlockForOp(ir, second.opIndex)
    if firstAfterBlock >= 0 && secondBeforeBlock >= 0 &&
       ownershipDropBlockReaches(
           ir, firstAfterBlock, secondBeforeBlock):
        return true
    var secondAfterBlock = -1
    var firstBeforeBlock = -1
    if second.edgeId >= 0:
        if ir.edges[second.edgeId].kind != OwnershipDropEdgeReturn:
            secondAfterBlock = ir.edges[second.edgeId].toBlockId
    else:
        secondAfterBlock = ownershipDropBlockForOp(ir, second.opIndex)
    if first.edgeId >= 0:
        firstBeforeBlock = ir.edges[first.edgeId].fromBlockId
    else:
        firstBeforeBlock = ownershipDropBlockForOp(ir, first.opIndex)
    return secondAfterBlock >= 0 && firstBeforeBlock >= 0 &&
           ownershipDropBlockReaches(
               ir, secondAfterBlock, firstBeforeBlock)

@borrows
fn ownershipDropValidateAnalysisPlan(ir: var OwnershipDropIr,
                                     analysis: var OwnershipDropAnalysis) =
    let expectedFlagCount = ir.places.len +
                            ir.placeFieldStateCount +
                            ir.deferEffects.len
    if analysis.conditionFlags.len != expectedFlagCount:
        ownershipDropFail("ownership_drop_ir: condition flag plan size mismatch")
    for flagIndex in 0..<analysis.conditionFlags.len:
        let flag = analysis.conditionFlags[flagIndex]
        if flag.flagId != flagIndex + 1:
            ownershipDropFail("ownership_drop_ir: malformed condition flag descriptor")
        if flag.kind == ConditionFlagPlaceInitialized:
            let placeIndex =
                ownershipDropPlaceIndex(ir, flag.placeId)
            if flag.fieldOrdinal != -1 || flag.deferId != -1 ||
               flag.initialValue !=
                   (ir.places[
                        placeIndex].initialDefinitionDomain > 0):
                ownershipDropFail("ownership_drop_ir: malformed place flag")
        elif flag.kind == ConditionFlagFieldInitialized:
            let placeIndex = ownershipDropPlaceIndex(ir, flag.placeId)
            if flag.fieldOrdinal < 0 ||
               flag.fieldOrdinal >= ir.places[placeIndex].fieldCount ||
               flag.deferId != -1 ||
               flag.initialValue !=
                   (ir.places[
                        placeIndex].initialDefinitionDomain > 0):
                ownershipDropFail("ownership_drop_ir: malformed field flag")
        elif flag.kind == ConditionFlagDeferActive:
            ownershipDropDeferIndex(ir, flag.deferId)
            if flag.placeId != -1 ||
               flag.fieldOrdinal != -1 ||
               flag.initialValue:
                ownershipDropFail("ownership_drop_ir: malformed defer flag")
        else:
            ownershipDropFail("ownership_drop_ir: unknown condition flag kind")
    for actionIndex in 0..<analysis.cleanupActions.len:
        let action = analysis.cleanupActions[actionIndex]
        if action.kind == CleanupActionUnknown:
            ownershipDropFail("ownership_drop_ir: unknown cleanup action")
        if action.edgeId >= 0:
            if action.edgeId >= ir.edges.len:
                ownershipDropFail("ownership_drop_ir: action edge out of range")
        elif action.opIndex < 0:
            ownershipDropFail("ownership_drop_ir: action lacks origin")
        if action.opIndex >= ir.ops.len:
            ownershipDropFail("ownership_drop_ir: action op out of range")
        ownershipDropValidateActionCondition(ir,
                                             analysis,
                                             action,
                                             action.conditionKind,
                                             action.conditionFlagId,
                                             action.conditionNegated)
        ownershipDropValidateActionCondition(ir,
                                             analysis,
                                             action,
                                             action.conditionOtherKind,
                                             action.conditionOtherFlagId,
                                             action.conditionOtherNegated)
        let ownedSnapshotAction =
            action.kind == CleanupActionSnapshotRetainOwnedReturn ||
            action.kind == CleanupActionSnapshotCloneOwnedReturn
        if !ownedSnapshotAction &&
           (action.returnSnapshotGlueId != 0 ||
            len(action.returnSnapshotGlueSymbol) != 0):
            ownershipDropFail("ownership_drop_ir: snapshot glue on non-snapshot action")
        let _ = ownershipDropValidatedGuardFlagId(ir, analysis, action)
        if action.kind == CleanupActionDropPlace ||
           action.kind == CleanupActionDropField:
            let placeIndex = ownershipDropPlaceIndex(ir, action.placeId)
            if action.dropGlueId <= 0:
                ownershipDropFail("ownership_drop_ir: drop action lacks glue")
            if action.kind == CleanupActionDropPlace:
                if action.fieldOrdinal != -1 ||
                   action.typeId != ir.places[placeIndex].typeId ||
                   action.dropGlueId != ir.types[action.typeId - 1].dropGlueId:
                    ownershipDropFail("ownership_drop_ir: malformed whole drop action")
            else:
                if action.fieldOrdinal < 0 ||
                   action.fieldOrdinal >= ir.places[placeIndex].fieldCount:
                    ownershipDropFail("ownership_drop_ir: malformed field drop action")
                let placeType = ir.types[ir.places[placeIndex].typeId - 1]
                let fieldIndex = placeType.fieldTypeStart + action.fieldOrdinal
                let fieldTypeId = ir.typeFieldTypeIds[fieldIndex]
                if action.typeId != fieldTypeId ||
                   action.dropGlueId != ir.types[fieldTypeId - 1].dropGlueId:
                    ownershipDropFail("ownership_drop_ir: field drop glue mismatch")
        elif action.kind == CleanupActionDefer:
            ownershipDropDeferIndex(ir, action.actionId)
        elif action.kind == CleanupActionRetainValue ||
             action.kind == CleanupActionStoreOwned ||
             action.kind == CleanupActionStoreMove:
            let placeIndex = ownershipDropPlaceIndex(ir, action.placeId)
            let otherIndex = ownershipDropPlaceIndex(ir, action.otherPlaceId)
            if action.typeId != ir.places[placeIndex].typeId ||
               ir.places[placeIndex].typeId != ir.places[otherIndex].typeId:
                ownershipDropFail("ownership_drop_ir: store action type mismatch")
        elif ownedSnapshotAction:
            let placeIndex = ownershipDropPlaceIndex(ir, action.placeId)
            let typeRow = ir.types[ir.places[placeIndex].typeId - 1]
            var expectedKind = CleanupActionSnapshotRetainOwnedReturn
            if typeRow.returnSnapshotKind == ReturnSnapshotClone:
                expectedKind = CleanupActionSnapshotCloneOwnedReturn
            if ir.places[placeIndex].ownership != Owned ||
               action.kind != expectedKind ||
               action.typeId != ir.places[placeIndex].typeId ||
               action.otherPlaceId != -1 || action.fieldOrdinal != -1 ||
               action.dropGlueId != 0 ||
               action.returnSnapshotGlueId <= 0 ||
               action.returnSnapshotGlueId != typeRow.returnSnapshotGlueId ||
               action.returnSnapshotGlueSymbol !=
                   typeRow.returnSnapshotGlueSymbol:
                ownershipDropFail("ownership_drop_ir: malformed owned return snapshot")
        elif action.kind == CleanupActionRetainRcBorrowedReturn ||
             action.kind == CleanupActionReturnUnmanaged:
            let placeIndex = ownershipDropPlaceIndex(ir, action.placeId)
            var expectedOwnership = Unmanaged
            if action.kind == CleanupActionRetainRcBorrowedReturn:
                expectedOwnership = RcBorrowedValue
            if action.typeId != ir.places[placeIndex].typeId ||
               ir.places[placeIndex].ownership != expectedOwnership ||
               action.actionId != 0 || action.otherPlaceId != -1 ||
               action.fieldOrdinal != -1 || action.dropGlueId != 0 ||
               action.returnSnapshotGlueId != 0 ||
               len(action.returnSnapshotGlueSymbol) != 0:
                ownershipDropFail("ownership_drop_ir: return action type mismatch")
        else:
            ownershipDropFail("ownership_drop_ir: unsupported cleanup action")
        let captured =
            action.actionId > 0 &&
            (action.kind == CleanupActionDropPlace ||
             action.kind == CleanupActionDropField)
        let sourceAction =
            action.kind == CleanupActionRetainValue ||
            action.kind == CleanupActionStoreOwned ||
            action.kind == CleanupActionStoreMove
        let managedSyntheticProducerDrop =
            action.actionId == 0 &&
            action.kind == CleanupActionDropPlace &&
            action.definitionOriginKind ==
                DefinitionOriginCanonicalSyntheticAction
        let managedTypedProducerDrop =
            action.actionId == 0 &&
            action.kind == CleanupActionDropPlace &&
            action.definitionOriginKind == DefinitionOriginTypedExpr
        if captured:
            if action.definitionOriginKind !=
                   DefinitionOriginCanonicalSyntheticAction ||
               action.definitionOriginId != actionIndex ||
               action.sourceDefinitionDomain != 0 ||
               action.sourceDefinitionRow != -1 ||
               action.capturedOldSourceDefinitionDomain != 0 ||
               action.capturedOldSourceDefinitionRow != -1 ||
               action.sourceOwnership != Owned ||
               action.consumeActionRow != actionIndex:
                ownershipDropFail(
                    "ownership_drop_ir: captured-old authority mismatch")
            var foundStore: bool
            for previousIndex in 0..<actionIndex:
                let previous = analysis.cleanupActions[previousIndex]
                if previous.kind == CleanupActionStoreOwned &&
                   previous.opIndex == action.opIndex &&
                   previous.actionId == action.actionId:
                    foundStore = true
            if !foundStore:
                ownershipDropFail("ownership_drop_ir: captured-old drop precedes store")
        elif sourceAction:
            if action.opIndex < 0 || action.opIndex >= ir.ops.len:
                ownershipDropFail(
                    "ownership_drop_ir: source action lacks exact op")
            let op = ir.ops[action.opIndex]
            if action.capturedOldSourceDefinitionDomain != 0 ||
               action.capturedOldSourceDefinitionRow != -1:
                ownershipDropFail(
                    "ownership_drop_ir: unprojected source action captured-old authority")
            if action.definitionOriginKind == DefinitionOriginUnknown:
                if action.definitionOriginId != -1 ||
                   action.sourceDefinitionDomain != 0 ||
                   action.sourceDefinitionRow != -1 ||
                   action.sourceOwnership != OwnershipUnknown ||
                   action.consumeActionRow != -1 ||
                   op.definitionOriginKind != DefinitionOriginUnknown:
                    ownershipDropFail(
                        "ownership_drop_ir: partial source action authority")
            elif action.definitionOriginKind != op.definitionOriginKind ||
                 action.definitionOriginId != op.definitionOriginId ||
                 action.sourceDefinitionDomain !=
                     op.sourceDefinitionDomain ||
                 action.sourceDefinitionRow != op.sourceDefinitionRow ||
                 action.sourceOwnership != op.sourceOwnership:
                ownershipDropFail(
                    "ownership_drop_ir: source action authority mismatch")
            else:
                let consumesSource = action.kind == CleanupActionStoreMove
                if (consumesSource &&
                    action.consumeActionRow != actionIndex) ||
                   (!consumesSource && action.consumeActionRow != -1):
                    ownershipDropFail(
                        "ownership_drop_ir: source action consume row mismatch")
        elif managedSyntheticProducerDrop:
            var producerAction: OwnershipDropCleanupAction
            if action.definitionOriginId >= 0 &&
               action.definitionOriginId < actionIndex:
                producerAction =
                    analysis.cleanupActions[action.definitionOriginId]
            if action.definitionOriginId < 0 ||
               action.definitionOriginId >= actionIndex ||
               (producerAction.kind !=
                    CleanupActionStoreMove &&
                producerAction.kind !=
                    CleanupActionRetainValue) ||
               producerAction.opIndex < 0 ||
               producerAction.opIndex >= ir.ops.len ||
               ((producerAction.kind == CleanupActionStoreMove &&
                 producerAction.placeId != action.placeId) ||
                (producerAction.kind == CleanupActionRetainValue &&
                 (ir.ops[producerAction.opIndex].kind !=
                      OwnershipDropOpRetainedAssign ||
                  ir.ops[producerAction.opIndex].placeId !=
                      action.placeId))) ||
               action.sourceDefinitionDomain != 0 ||
               action.sourceDefinitionRow != -1 ||
               action.sourceOwnership != Owned ||
               action.consumeActionRow != actionIndex:
                ownershipDropFail(
                    "ownership_drop_ir: managed producer drop authority mismatch")
        elif managedTypedProducerDrop:
            if action.definitionOriginId < 0 ||
               !ownershipDropDefinitionCoordinateValid(
                   action.sourceDefinitionDomain,
                   action.sourceDefinitionRow) ||
               action.sourceOwnership != Owned ||
               action.consumeActionRow != actionIndex:
                ownershipDropFail(
                    "ownership_drop_ir: initialized producer drop authority mismatch")
        elif ownedSnapshotAction ||
             action.kind == CleanupActionRetainRcBorrowedReturn ||
             action.kind == CleanupActionReturnUnmanaged:
            let edge = ir.edges[action.edgeId]
            if action.capturedOldSourceDefinitionDomain != 0 ||
               action.capturedOldSourceDefinitionRow != -1:
                ownershipDropFail(
                    "ownership_drop_ir: return action carries captured-old authority")
            if action.definitionOriginKind == DefinitionOriginUnknown:
                if action.definitionOriginId != -1 ||
                   action.sourceDefinitionDomain != 0 ||
                   action.sourceDefinitionRow != -1 ||
                   action.sourceOwnership != OwnershipUnknown ||
                   action.consumeActionRow != -1 ||
                   edge.resultOwnership != OwnershipUnknown:
                    ownershipDropFail(
                        "ownership_drop_ir: partial return action authority")
            elif action.definitionOriginKind != DefinitionOriginTypedExpr ||
                 action.definitionOriginId !=
                     edge.resultValueDefinitionRow ||
                 action.sourceDefinitionDomain !=
                     edge.sourceDefinitionDomain ||
                 action.sourceDefinitionRow != edge.sourceDefinitionRow ||
                 action.sourceOwnership != edge.resultOwnership ||
                 action.consumeActionRow != -1:
                    ownershipDropFail(
                        "ownership_drop_ir: return action authority mismatch")
        elif action.definitionOriginKind != DefinitionOriginUnknown ||
             action.definitionOriginId != -1 ||
             action.sourceDefinitionDomain != 0 ||
             action.sourceDefinitionRow != -1 ||
             action.capturedOldSourceDefinitionDomain != 0 ||
             action.capturedOldSourceDefinitionRow != -1 ||
             action.sourceOwnership != OwnershipUnknown ||
             action.consumeActionRow != -1:
            ownershipDropFail(
                "ownership_drop_ir: authority on unsupported cleanup action")
        if action.consumeActionRow >= 0:
            if action.consumeActionRow != actionIndex:
                ownershipDropFail(
                    "ownership_drop_ir: consume action row identity mismatch")
            # A repeated identity is illegal exactly when both actions can
            # occur on one CFG path.  This covers op and edge domains, branch
            # convergence and loop backedges without treating an edge kind as
            # an exclusivity heuristic.  The flow lattice independently
            # rejects the second same-path consume at its transfer site.
            for previousIndex in 0..<actionIndex:
                let previous = analysis.cleanupActions[previousIndex]
                if previous.consumeActionRow >= 0 &&
                   previous.definitionOriginKind ==
                       action.definitionOriginKind &&
                   previous.definitionOriginId ==
                       action.definitionOriginId &&
                   previous.sourceDefinitionDomain ==
                       action.sourceDefinitionDomain &&
                   previous.sourceDefinitionRow ==
                       action.sourceDefinitionRow &&
                   ownershipDropActionsMayCoexecute(
                       ir, previous, action):
                    ownershipDropFail(
                        Fmt"ownership_drop_ir: value definition consumed twice prev_index={previousIndex} action_index={actionIndex} prev_kind={Int32(previous.kind)} act_kind={Int32(action.kind)} origin_kind={Int32(action.definitionOriginKind)} origin_id={action.definitionOriginId} domain={action.sourceDefinitionDomain} row={action.sourceDefinitionRow} prev_edge={previous.edgeId} act_edge={action.edgeId} prev_op={previous.opIndex} act_op={action.opIndex} prev_place={previous.placeId} act_place={action.placeId} prev_consume={previous.consumeActionRow} act_consume={action.consumeActionRow}")
    for opIndex in 0..<analysis.opActionCounts.len:
        let count = analysis.opActionCounts[opIndex]
        let start = analysis.opActionStarts[opIndex]
        if count < 0 ||
           (count == 0 && start != -1 && start > analysis.cleanupActions.len) ||
           (count > 0 &&
            (start < 0 || start + count > analysis.cleanupActions.len)):
            ownershipDropFail("ownership_drop_ir: malformed op action range")
        for ordinal in 0..<count:
            if analysis.cleanupActions[start + ordinal].opIndex != opIndex:
                ownershipDropFail("ownership_drop_ir: op action range origin mismatch")
        if count > 0 && ir.ops[opIndex].kind == OwnershipDropOpRetainedAssign:
            if count < 2 ||
               analysis.cleanupActions[start].kind != CleanupActionRetainValue ||
               analysis.cleanupActions[start + 1].kind != CleanupActionStoreOwned ||
               analysis.cleanupActions[start + 1].actionId != opIndex + 1:
                ownershipDropFail("ownership_drop_ir: retained-assign action order corrupt")
            for ordinal in 2..<count:
                let action = analysis.cleanupActions[start + ordinal]
                if (action.kind != CleanupActionDropPlace &&
                    action.kind != CleanupActionDropField) ||
                   action.actionId != opIndex + 1:
                    ownershipDropFail("ownership_drop_ir: retained old-drop order corrupt")
        if count > 0 && ir.ops[opIndex].kind == OwnershipDropOpMove:
            if analysis.cleanupActions[start + count - 1].kind != CleanupActionStoreMove:
                ownershipDropFail("ownership_drop_ir: move store is not final action")
            for ordinal in 0..<(count - 1):
                let action = analysis.cleanupActions[start + ordinal]
                if action.kind != CleanupActionDropPlace &&
                   action.kind != CleanupActionDropField:
                    ownershipDropFail("ownership_drop_ir: move old-drop order corrupt")
    for edgeIndex in 0..<analysis.edgeActionCounts.len:
        let count = analysis.edgeActionCounts[edgeIndex]
        let start = analysis.edgeActionStarts[edgeIndex]
        if count < 0 ||
           (count == 0 && start != -1 && start > analysis.cleanupActions.len) ||
           (count > 0 &&
            (start < 0 || start + count > analysis.cleanupActions.len)):
            ownershipDropFail("ownership_drop_ir: malformed edge action range")
        for ordinal in 0..<count:
            if analysis.cleanupActions[start + ordinal].edgeId != edgeIndex:
                ownershipDropFail("ownership_drop_ir: edge action range origin mismatch")
    for transitionIndex in 0..<analysis.flagTransitions.len:
        let transition = analysis.flagTransitions[transitionIndex]
        if transition.flagId <= 0 ||
           transition.flagId > analysis.conditionFlags.len ||
           !transition.afterActions:
            ownershipDropFail("ownership_drop_ir: malformed flag transition")
        if transition.originKind == FlagOriginOp:
            if transition.originId < 0 || transition.originId >= ir.ops.len:
                ownershipDropFail("ownership_drop_ir: flag transition op out of range")
        elif transition.originKind == FlagOriginEdge:
            if transition.originId < 0 || transition.originId >= ir.edges.len:
                ownershipDropFail("ownership_drop_ir: flag transition edge out of range")
        else:
            ownershipDropFail("ownership_drop_ir: unknown flag transition origin")

fn ownershipDropQueuePush(queue: var int32[],
                          queued: var bool[],
                          blockId: int32) =
    if !queued[blockId]:
        add(queue, blockId)
        queued[blockId] = true

fn OwnershipDropAnalyze(ir: var OwnershipDropIr,
                        out: var OwnershipDropAnalysis) =
    OwnershipDropFinalize(ir)
    ownershipDropAnalysisInit(ir, out)
    var entryState: OwnershipDropFlowState
    ownershipDropNewEntryFlow(ir, entryState)
    ownershipDropStoreFlow(out.blockInputs, ir.entryBlockId, entryState)
    ownershipDropResetFlowState(entryState)
    var queue: int32[]
    var queued: bool[]
    for i in 0..<ir.blocks.len:
        add(queued, false)
    ownershipDropQueuePush(queue, queued, ir.entryBlockId)
    var queueIndex: int32
    # Exact finite-lattice height: a place has five state bits, four escape
    # bits, and at most one monotonic fact each for borrow source, projection,
    # canonical managed producer, reaching-definition domain/row and the
    # manual-consume epoch. Fields have five state bits. Defer activation has
    # the uninitialized, initialized, and dropped states. Every requeue after
    # first reach consumes one of these increases; incompatible exact
    # definition/epoch facts hard-fail at the join instead of widening.
    let placeLatticeHeight: int32 = 15
    let fieldLatticeHeight: int32 = 5
    let deferLatticeHeight: int32 = 3
    let latticeHeight = ir.places.len * placeLatticeHeight +
                        ir.placeFieldStateCount * fieldLatticeHeight +
                        ir.deferEffects.len * deferLatticeHeight
    let maxSteps = (ir.blocks.len + 1) * (latticeHeight + 2)
    while queueIndex < queue.len:
        let blockId = queue[queueIndex]
        queueIndex = queueIndex + 1
        queued[blockId] = false
        out.fixedPointSteps = out.fixedPointSteps + 1
        if out.fixedPointSteps > maxSteps:
            ownershipDropFail("ownership_drop_ir: cfg fixed point did not converge")
        var inputState: OwnershipDropFlowState
        ownershipDropCloneFlow(out.blockInputs[blockId], inputState)
        if !inputState.reached:
            ownershipDropFail("ownership_drop_ir: queued block is unreachable")
        var outputState: OwnershipDropFlowState
        var noStarts: int32[]
        var noCounts: int32[]
        var noActions: OwnershipDropCleanupAction[]
        var noFlagTransitions: OwnershipDropFlagTransition[]
        ownershipDropApplyBlock(ir,
                                blockId,
                                inputState,
                                outputState,
                                false,
                                noStarts,
                                noCounts,
                                noActions,
                                noFlagTransitions)
        ownershipDropResetFlowState(inputState)
        if noActions.len != 0:
            ownershipDropFail(
                "ownership_drop_ir: analysis pass emitted scratch actions")
        ownershipDropReleaseScratchSequence(noStarts)
        ownershipDropReleaseScratchSequence(noCounts)
        ownershipDropReleaseScratchSequence(noActions)
        ownershipDropReleaseScratchSequence(noFlagTransitions)
        ownershipDropStoreFlow(out.blockOutputs, blockId, outputState)
        for edgeIndex in 0..<ir.edges.len:
            let edge = ir.edges[edgeIndex]
            if edge.fromBlockId != blockId:
                continue
            var incoming: OwnershipDropFlowState
            ownershipDropCloneFlow(outputState, incoming)
            var discarded: OwnershipDropCleanupAction[]
            ownershipDropApplyEdge(ir, edge, incoming, false, discarded)
            if discarded.len != 0:
                ownershipDropFail(
                    "ownership_drop_ir: edge analysis emitted scratch actions")
            ownershipDropReleaseScratchSequence(discarded)
            # A return edge, including postfix-? Err propagation, is terminal.
            # Its toBlockId is only a stable row reference and must never make
            # a continuation block reachable.
            if edge.kind == OwnershipDropEdgeReturn:
                ownershipDropResetFlowState(incoming)
                continue
            var target: OwnershipDropFlowState
            ownershipDropCloneFlow(out.blockInputs[edge.toBlockId], target)
            if ownershipDropJoinInto(ir, target, incoming):
                ownershipDropStoreFlow(out.blockInputs, edge.toBlockId, target)
                ownershipDropQueuePush(queue, queued, edge.toBlockId)
            ownershipDropResetFlowState(target)
            ownershipDropResetFlowState(incoming)
        ownershipDropResetFlowState(outputState)
    for blockId in 0..<ir.blocks.len:
        if !out.blockInputs[blockId].reached:
            continue
        var replayOutput: OwnershipDropFlowState
        ownershipDropApplyBlock(ir,
                                blockId,
                                out.blockInputs[blockId],
                                replayOutput,
                                true,
                                out.opActionStarts,
                                out.opActionCounts,
                                out.cleanupActions,
                                out.flagTransitions)
        if !ownershipDropFlowsEqual(ir, replayOutput, out.blockOutputs[blockId]):
            ownershipDropFail("ownership_drop_ir: block replay differs from fixed point")
        ownershipDropResetFlowState(replayOutput)
    for edgeIndex in 0..<ir.edges.len:
        let edge = ir.edges[edgeIndex]
        if !out.blockOutputs[edge.fromBlockId].reached:
            continue
        var edgeState: OwnershipDropFlowState
        ownershipDropCloneFlow(out.blockOutputs[edge.fromBlockId], edgeState)
        var beforeEdge: OwnershipDropFlowState
        ownershipDropCloneFlow(edgeState, beforeEdge)
        let actionStart = out.cleanupActions.len
        ownershipDropApplyEdge(ir, edge, edgeState, true, out.cleanupActions)
        out.edgeActionStarts[edge.edgeId] = actionStart
        out.edgeActionCounts[edge.edgeId] = out.cleanupActions.len - actionStart
        ownershipDropRecordFlagTransitions(ir,
                                           beforeEdge,
                                           edgeState,
                                           FlagOriginEdge,
                                           edge.edgeId,
                                           out.flagTransitions)
        if edge.kind == OwnershipDropEdgeReturn:
            ownershipDropResetFlowState(beforeEdge)
            ownershipDropResetFlowState(edgeState)
            continue
        if !ownershipDropFlowIncludes(ir, out.blockInputs[edge.toBlockId], edgeState):
            ownershipDropFail("ownership_drop_ir: edge replay exceeds fixed point")
        ownershipDropResetFlowState(beforeEdge)
        ownershipDropResetFlowState(edgeState)
    for blockId in 0..<ir.blocks.len:
        if !out.blockOutputs[blockId].reached:
            continue
        var outgoingCount: int32
        for edgeIndex in 0..<ir.edges.len:
            if ir.edges[edgeIndex].fromBlockId == blockId:
                outgoingCount = outgoingCount + 1
        if outgoingCount == 0:
            ownershipDropValidateClosed(ir,
                                        out.blockOutputs[blockId],
                                        "ownership_drop_ir: reachable terminal leaks place")
    ownershipDropValidateAnalysisPlan(ir, out)
    out.converged = true
    ownershipDropReleaseScratchSequence(queue)
    ownershipDropReleaseScratchSequence(queued)

fn OwnershipDropAnalyzeCanonical(
        ir: var OwnershipDropIr,
        out: var OwnershipDropAnalysis) =
    OwnershipDropRequireCanonicalDefinitionAuthority(ir)
    OwnershipDropAnalyze(ir, out)

fn ownershipDropMaskToInitState(mask: int32): InitState =
    if mask == ownershipStateUninitialized:
        return Uninitialized
    if mask == ownershipStateInitialized:
        return Initialized
    if mask == ownershipStateMoved:
        return Moved
    if mask == ownershipStateDropped:
        return Dropped
    if mask == ownershipStatePartial:
        return PartiallyInitialized
    if ownershipDropMaskHasLive(mask):
        return ConditionallyInitialized
    return Uninitialized

fn OwnershipDropAnalysisInputInitState(analysis: var OwnershipDropAnalysis,
                                       blockId: int32,
                                       placeId: int32): InitState =
    if blockId < 0 || blockId >= analysis.blockInputs.len ||
       placeId <= 0 || placeId > analysis.blockInputs[blockId].placeStateMasks.len:
        ownershipDropFail("ownership_drop_ir: analysis input out of range")
    return ownershipDropMaskToInitState(analysis.blockInputs[blockId].placeStateMasks[placeId - 1])

fn OwnershipDropAnalysisOutputInitState(analysis: var OwnershipDropAnalysis,
                                        blockId: int32,
                                        placeId: int32): InitState =
    if blockId < 0 || blockId >= analysis.blockOutputs.len ||
       placeId <= 0 || placeId > analysis.blockOutputs[blockId].placeStateMasks.len:
        ownershipDropFail("ownership_drop_ir: analysis output out of range")
    return ownershipDropMaskToInitState(analysis.blockOutputs[blockId].placeStateMasks[placeId - 1])

fn OwnershipDropAnalysisInputBorrowCount(ir: var OwnershipDropIr,
                                         analysis: var OwnershipDropAnalysis,
                                         blockId: int32,
                                         ownerPlaceId: int32): int32 =
    if blockId < 0 || blockId >= analysis.blockInputs.len:
        ownershipDropFail("ownership_drop_ir: analysis borrow block out of range")
    ownershipDropPlaceIndex(ir, ownerPlaceId)
    var count: int32
    for viewIndex in 0..<ir.places.len:
        if analysis.blockInputs[blockId].borrowSourcePlaceIds[viewIndex] == ownerPlaceId &&
           ownershipDropMaskHasLive(analysis.blockInputs[blockId].placeStateMasks[viewIndex]):
            count = count + 1
    return count

fn OwnershipDropAnalysisInputEscapeKind(analysis: var OwnershipDropAnalysis,
                                        blockId: int32,
                                        placeId: int32): OwnershipDropEscapeKind =
    if blockId < 0 || blockId >= analysis.blockInputs.len ||
       placeId <= 0 || placeId > analysis.blockInputs[blockId].escapeMasks.len:
        ownershipDropFail("ownership_drop_ir: analysis escape out of range")
    let mask = analysis.blockInputs[blockId].escapeMasks[placeId - 1]
    if mask == ownershipEscapeNone:
        return NoEscape
    if mask == ownershipEscapeReturn:
        return ReturnEscape
    if mask == ownershipEscapeGlobal:
        return GlobalEscape
    if mask == ownershipEscapeThread:
        return ThreadEscape
    return EscapeUnknown

fn OwnershipDropAnalysisEdgeActionCount(analysis: var OwnershipDropAnalysis,
                                        edgeId: int32): int32 =
    if edgeId < 0 || edgeId >= analysis.edgeActionCounts.len:
        ownershipDropFail("ownership_drop_ir: analysis edge out of range")
    return analysis.edgeActionCounts[edgeId]

@borrows
fn ownershipDropOwnedCleanupActionCopy(
        source: OwnershipDropCleanupAction): OwnershipDropCleanupAction =
    var out: OwnershipDropCleanupAction
    out.edgeId = source.edgeId
    out.opIndex = source.opIndex
    out.kind = source.kind
    out.actionId = source.actionId
    out.placeId = source.placeId
    out.otherPlaceId = source.otherPlaceId
    out.fieldOrdinal = source.fieldOrdinal
    out.typeId = source.typeId
    out.dropGlueId = source.dropGlueId
    out.returnSnapshotGlueId = source.returnSnapshotGlueId
    if len(source.returnSnapshotGlueSymbol) > 0:
        out.returnSnapshotGlueSymbol = NewStringCopy(
            source.returnSnapshotGlueSymbol.data,
            len(source.returnSnapshotGlueSymbol))
    out.conditionKind = source.conditionKind
    out.conditionFlagId = source.conditionFlagId
    out.conditionNegated = source.conditionNegated
    out.conditionOtherKind = source.conditionOtherKind
    out.conditionOtherFlagId = source.conditionOtherFlagId
    out.conditionOtherNegated = source.conditionOtherNegated
    out.guardDeferId = source.guardDeferId
    out.guardDeferNegated = source.guardDeferNegated
    out.definitionOriginKind = source.definitionOriginKind
    out.definitionOriginId = source.definitionOriginId
    out.sourceDefinitionDomain = source.sourceDefinitionDomain
    out.sourceDefinitionRow = source.sourceDefinitionRow
    out.capturedOldSourceDefinitionDomain =
        source.capturedOldSourceDefinitionDomain
    out.capturedOldSourceDefinitionRow =
        source.capturedOldSourceDefinitionRow
    out.sourceOwnership = source.sourceOwnership
    out.consumeActionRow = source.consumeActionRow
    return out

fn OwnershipDropAnalysisEdgeAction(analysis: var OwnershipDropAnalysis,
                                   edgeId: int32,
                                   actionOrdinal: int32): OwnershipDropCleanupAction =
    if edgeId < 0 || edgeId >= analysis.edgeActionCounts.len ||
       actionOrdinal < 0 || actionOrdinal >= analysis.edgeActionCounts[edgeId]:
        ownershipDropFail("ownership_drop_ir: analysis edge action out of range")
    return ownershipDropOwnedCleanupActionCopy(
        analysis.cleanupActions[
            analysis.edgeActionStarts[edgeId] + actionOrdinal])

fn OwnershipDropAnalysisOpActionCount(analysis: var OwnershipDropAnalysis,
                                      opIndex: int32): int32 =
    if opIndex < 0 || opIndex >= analysis.opActionCounts.len:
        ownershipDropFail("ownership_drop_ir: analysis op out of range")
    return analysis.opActionCounts[opIndex]

fn OwnershipDropAnalysisOpAction(analysis: var OwnershipDropAnalysis,
                                 opIndex: int32,
                                 actionOrdinal: int32): OwnershipDropCleanupAction =
    if opIndex < 0 || opIndex >= analysis.opActionCounts.len ||
       actionOrdinal < 0 || actionOrdinal >= analysis.opActionCounts[opIndex]:
        ownershipDropFail("ownership_drop_ir: analysis op action out of range")
    return ownershipDropOwnedCleanupActionCopy(
        analysis.cleanupActions[
            analysis.opActionStarts[opIndex] + actionOrdinal])

fn OwnershipDropAnalysisConditionFlagCount(analysis: var OwnershipDropAnalysis): int32 =
    return analysis.conditionFlags.len

fn OwnershipDropAnalysisConditionFlag(analysis: var OwnershipDropAnalysis,
                                      flagId: int32): OwnershipDropConditionFlag =
    if flagId <= 0 || flagId > analysis.conditionFlags.len:
        ownershipDropFail("ownership_drop_ir: condition flag out of range")
    let row = flagId - 1
    if analysis.conditionFlags[row].flagId != flagId:
        ownershipDropFail("ownership_drop_ir: condition flag index corrupt")
    var out: OwnershipDropConditionFlag
    out.flagId = analysis.conditionFlags[row].flagId
    out.kind = analysis.conditionFlags[row].kind
    out.placeId = analysis.conditionFlags[row].placeId
    out.fieldOrdinal = analysis.conditionFlags[row].fieldOrdinal
    out.deferId = analysis.conditionFlags[row].deferId
    out.initialValue = analysis.conditionFlags[row].initialValue
    return out

fn OwnershipDropAnalysisFlagTransitionCount(analysis: var OwnershipDropAnalysis): int32 =
    return analysis.flagTransitions.len

fn OwnershipDropAnalysisFlagTransition(analysis: var OwnershipDropAnalysis,
                                       transitionIndex: int32): OwnershipDropFlagTransition =
    if transitionIndex < 0 || transitionIndex >= analysis.flagTransitions.len:
        ownershipDropFail("ownership_drop_ir: flag transition out of range")
    var out: OwnershipDropFlagTransition
    out.originKind = analysis.flagTransitions[transitionIndex].originKind
    out.originId = analysis.flagTransitions[transitionIndex].originId
    out.flagId = analysis.flagTransitions[transitionIndex].flagId
    out.setValue = analysis.flagTransitions[transitionIndex].setValue
    out.afterActions = analysis.flagTransitions[transitionIndex].afterActions
    return out

# These digests are canonical content identities consumed by CleanupIntent.
# They do not authorize a cleanup placement or a production artifact.

const
    ownershipDropIrCidSchemaFieldCount: int32 = 12
    ownershipDropAnalysisCidSchemaFieldCount: int32 = 12
    ownershipDropTypeCidRowFieldCount: int32 = 8
    ownershipDropScopeCidRowFieldCount: int32 = 2
    ownershipDropPlaceCidRowFieldCount: int32 = 8
    ownershipDropBlockCidRowFieldCount: int32 = 4
    ownershipDropOpCidRowFieldCount: int32 = 18
    ownershipDropDeferCidRowFieldCount: int32 = 6
    ownershipDropEdgeCidRowFieldCount: int32 = 14
    ownershipDropFlowCidRowFieldCount: int32 = 12
    ownershipDropActionCidRowFieldCount: int32 = 27
    ownershipDropConditionFlagCidRowFieldCount: int32 = 6
    ownershipDropFlagTransitionCidRowFieldCount: int32 = 5

fn OwnershipDropIrCidSchemaFieldCount(): int32 =
    return ownershipDropIrCidSchemaFieldCount

fn OwnershipDropAnalysisCidSchemaFieldCount(): int32 =
    return ownershipDropAnalysisCidSchemaFieldCount

fn ownershipDropCidAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

fn ownershipDropCidAppendBool(
        buf: var layout.ByteBuf,
        value: bool) =
    layout.ByteBufAppendByte(buf, if value: 1 else: 0)

@borrows
fn ownershipDropCidAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    ownershipDropCidAppendI32(buf, len(value))
    for byteIndex in 0..<len(value):
        layout.ByteBufAppendByte(
            buf, int32(value[byteIndex]) & 255)

fn ownershipDropCidAppendFieldHeader(
        buf: var layout.ByteBuf,
        fieldTag: int32,
        rowCount: int32,
        rowFieldCount: int32) =
    if fieldTag <= 0 || rowCount < 0 || rowFieldCount <= 0:
        ownershipDropFail(
            "ownership_drop_ir: CID field header invalid")
    ownershipDropCidAppendI32(buf, fieldTag)
    ownershipDropCidAppendI32(buf, rowCount)
    ownershipDropCidAppendI32(buf, rowFieldCount)

fn ownershipDropCidAppendI32SequenceValue(
        buf: var layout.ByteBuf,
        values: var int32[]) =
    ownershipDropCidAppendI32(buf, values.len)
    for valueIndex in 0..<values.len:
        ownershipDropCidAppendI32(buf, values[valueIndex])

fn ownershipDropCidAppendBoolSequenceValue(
        buf: var layout.ByteBuf,
        values: var bool[]) =
    ownershipDropCidAppendI32(buf, values.len)
    for valueIndex in 0..<values.len:
        ownershipDropCidAppendBool(buf, values[valueIndex])

fn ownershipDropCidFinish(
        buf: var layout.ByteBuf): layout.FixedBytes32 =
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn ownershipDropRequireIrCidReady(ir: var OwnershipDropIr) =
    if ir.storageReleased:
        ownershipDropFail(
            "ownership_drop_ir: CID source IR storage released")
    ownershipDropValidateStructure(ir)
    OwnershipDropRequireCanonicalDefinitionAuthority(ir)

@borrows
fn ownershipDropRequireFlowShapeReady(
        ir: var OwnershipDropIr,
        state: var OwnershipDropFlowState) =
    # Analysis fills only reachable block rows; an unreachable row stays
    # exactly the zero state from analysis init (applyBlock, flowsEqual and
    # join all filter on reached, so no pass can write such a row).  Reachable
    # rows must carry the full place-major column shape; unreachable rows must
    # be untouched, not merely skipped.
    if !state.reached:
        if state.placeStateMasks.len != 0 ||
           state.placeManagedProducerOpIds.len != 0 ||
           state.placeDefinitionDomains.len != 0 ||
           state.placeDefinitionRows.len != 0 ||
           state.placeEntryDefinitionReachable.len != 0 ||
           state.placeManualPostDefinitionReachable.len != 0 ||
           state.fieldStateMasks.len != 0 ||
           state.borrowSourcePlaceIds.len != 0 ||
           state.borrowProjectionTokens.len != 0 ||
           state.escapeMasks.len != 0 ||
           state.deferActiveMasks.len != 0:
            ownershipDropFail(
                "ownership_drop_ir: unreachable flow state not empty")
        return
    ownershipDropValidateFlowShape(ir, state)

fn ownershipDropRequireAnalysisCidReady(
        ir: var OwnershipDropIr,
        analysis: var OwnershipDropAnalysis) =
    if analysis.storageReleased:
        ownershipDropFail(
            "ownership_drop_ir: CID source analysis storage released")
    if !analysis.converged:
        ownershipDropFail(
            "ownership_drop_ir: CID source analysis not converged")
    ownershipDropRequireIrCidReady(ir)
    if analysis.fixedPointSteps <= 0 ||
       analysis.blockInputs.len != ir.blocks.len ||
       analysis.blockOutputs.len != ir.blocks.len ||
       analysis.opActionStarts.len != ir.ops.len ||
       analysis.opActionCounts.len != ir.ops.len ||
       analysis.edgeActionStarts.len != ir.edges.len ||
       analysis.edgeActionCounts.len != ir.edges.len:
        ownershipDropFail(
            "ownership_drop_ir: CID analysis top-level shape invalid")
    for blockIndex in 0..<analysis.blockInputs.len:
        ownershipDropRequireFlowShapeReady(
            ir, analysis.blockInputs[blockIndex])
        ownershipDropRequireFlowShapeReady(
            ir, analysis.blockOutputs[blockIndex])
    ownershipDropValidateAnalysisPlan(ir, analysis)

fn OwnershipDropIrCanonicalCid(
        ir: var OwnershipDropIr): layout.FixedBytes32 =
    ownershipDropRequireIrCidReady(ir)
    var buf = layout.ByteBufInit(1024)
    ownershipDropCidAppendText(
        buf, "cheng.ownership_drop_ir.canonical.cid")
    ownershipDropCidAppendI32(
        buf, ownershipDropIrCidSchemaFieldCount)

    ownershipDropCidAppendFieldHeader(
        buf, 1, ir.types.len, ownershipDropTypeCidRowFieldCount)
    for rowIndex in 0..<ir.types.len:
        let row = ir.types[rowIndex]
        ownershipDropCidAppendI32(buf, row.typeId)
        ownershipDropCidAppendText(buf, row.name)
        ownershipDropCidAppendI32(buf, row.dropGlueId)
        ownershipDropCidAppendI32(
            buf, int32(row.returnSnapshotKind))
        ownershipDropCidAppendI32(buf, row.returnSnapshotGlueId)
        ownershipDropCidAppendText(
            buf, row.returnSnapshotGlueSymbol)
        ownershipDropCidAppendI32(buf, row.fieldTypeStart)
        ownershipDropCidAppendI32(buf, row.fieldCount)

    ownershipDropCidAppendFieldHeader(
        buf, 2, ir.typeFieldTypeIds.len, 1)
    for valueIndex in 0..<ir.typeFieldTypeIds.len:
        ownershipDropCidAppendI32(
            buf, ir.typeFieldTypeIds[valueIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 3, ir.scopes.len, ownershipDropScopeCidRowFieldCount)
    for rowIndex in 0..<ir.scopes.len:
        let row = ir.scopes[rowIndex]
        ownershipDropCidAppendI32(buf, row.scopeId)
        ownershipDropCidAppendI32(buf, row.parentScopeId)

    ownershipDropCidAppendFieldHeader(
        buf, 4, ir.places.len, ownershipDropPlaceCidRowFieldCount)
    for rowIndex in 0..<ir.places.len:
        let row = ir.places[rowIndex]
        ownershipDropCidAppendI32(buf, row.placeId)
        ownershipDropCidAppendI32(buf, row.typeId)
        ownershipDropCidAppendI32(buf, int32(row.ownership))
        ownershipDropCidAppendI32(buf, row.scopeId)
        ownershipDropCidAppendI32(buf, row.fieldStateStart)
        ownershipDropCidAppendI32(buf, row.fieldCount)
        ownershipDropCidAppendI32(
            buf, row.initialDefinitionDomain)
        ownershipDropCidAppendI32(buf, row.initialDefinitionRow)

    ownershipDropCidAppendFieldHeader(buf, 5, 1, 1)
    ownershipDropCidAppendI32(buf, ir.placeFieldStateCount)

    ownershipDropCidAppendFieldHeader(
        buf, 6, ir.blocks.len, ownershipDropBlockCidRowFieldCount)
    for rowIndex in 0..<ir.blocks.len:
        let row = ir.blocks[rowIndex]
        ownershipDropCidAppendI32(buf, row.blockId)
        ownershipDropCidAppendI32(buf, row.scopeId)
        ownershipDropCidAppendI32(buf, row.opStart)
        ownershipDropCidAppendI32(buf, row.opCount)

    ownershipDropCidAppendFieldHeader(
        buf, 7, ir.ops.len, ownershipDropOpCidRowFieldCount)
    for rowIndex in 0..<ir.ops.len:
        let row = ir.ops[rowIndex]
        ownershipDropCidAppendI32(buf, int32(row.kind))
        ownershipDropCidAppendI32(buf, row.placeId)
        ownershipDropCidAppendI32(buf, row.otherPlaceId)
        ownershipDropCidAppendI32(buf, row.projectionToken)
        ownershipDropCidAppendI32(buf, row.fieldOrdinal)
        ownershipDropCidAppendI32(buf, int32(row.escapeKind))
        ownershipDropCidAppendI32(
            buf, int32(row.definitionOriginKind))
        ownershipDropCidAppendI32(buf, row.definitionOriginId)
        ownershipDropCidAppendI32(
            buf, row.sourceDefinitionDomain)
        ownershipDropCidAppendI32(buf, row.sourceDefinitionRow)
        ownershipDropCidAppendI32(buf, int32(row.sourceOwnership))
        ownershipDropCidAppendI32(buf, row.definitionDomain)
        ownershipDropCidAppendI32(buf, row.definitionRow)
        ownershipDropCidAppendI32(buf, row.manualConsumeRow)
        ownershipDropCidAppendI32(
            buf, row.manualTargetDefinitionDomain)
        ownershipDropCidAppendI32(
            buf, row.manualTargetDefinitionRow)
        ownershipDropCidAppendI32(
            buf, row.manualSourceDefinitionDomain)
        ownershipDropCidAppendI32(
            buf, row.manualSourceDefinitionRow)

    ownershipDropCidAppendFieldHeader(
        buf, 8, ir.deferEffects.len,
        ownershipDropDeferCidRowFieldCount)
    for rowIndex in 0..<ir.deferEffects.len:
        let row = ir.deferEffects[rowIndex]
        ownershipDropCidAppendI32(buf, row.deferId)
        ownershipDropCidAppendI32(buf, row.scopeId)
        ownershipDropCidAppendI32(buf, row.declarationOrdinal)
        ownershipDropCidAppendI32(buf, int32(row.kind))
        ownershipDropCidAppendI32(buf, row.placeId)
        ownershipDropCidAppendI32(buf, row.otherPlaceId)

    ownershipDropCidAppendFieldHeader(
        buf, 9, ir.edges.len, ownershipDropEdgeCidRowFieldCount)
    for rowIndex in 0..<ir.edges.len:
        let row = ir.edges[rowIndex]
        ownershipDropCidAppendI32(buf, row.edgeId)
        ownershipDropCidAppendI32(buf, row.fromBlockId)
        ownershipDropCidAppendI32(buf, row.toBlockId)
        ownershipDropCidAppendI32(buf, int32(row.kind))
        ownershipDropCidAppendI32(buf, row.returnPlaceId)
        ownershipDropCidAppendI32(buf, row.cleanupPlaceStart)
        ownershipDropCidAppendI32(buf, row.cleanupPlaceCount)
        ownershipDropCidAppendI32(buf, row.deferIdStart)
        ownershipDropCidAppendI32(buf, row.deferIdCount)
        ownershipDropCidAppendI32(buf, row.resultExprNodeIndex)
        ownershipDropCidAppendI32(
            buf, row.resultValueDefinitionRow)
        ownershipDropCidAppendI32(buf, int32(row.resultOwnership))
        ownershipDropCidAppendI32(
            buf, row.sourceDefinitionDomain)
        ownershipDropCidAppendI32(buf, row.sourceDefinitionRow)

    ownershipDropCidAppendFieldHeader(
        buf, 10, ir.cleanupPlaceIds.len, 1)
    for valueIndex in 0..<ir.cleanupPlaceIds.len:
        ownershipDropCidAppendI32(
            buf, ir.cleanupPlaceIds[valueIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 11, ir.edgeDeferIds.len, 1)
    for valueIndex in 0..<ir.edgeDeferIds.len:
        ownershipDropCidAppendI32(buf, ir.edgeDeferIds[valueIndex])

    ownershipDropCidAppendFieldHeader(buf, 12, 1, 1)
    ownershipDropCidAppendI32(buf, ir.entryBlockId)
    return ownershipDropCidFinish(buf)

fn ownershipDropCidAppendFlowState(
        buf: var layout.ByteBuf,
        state: var OwnershipDropFlowState) =
    ownershipDropCidAppendBool(buf, state.reached)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.placeStateMasks)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.placeManagedProducerOpIds)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.placeDefinitionDomains)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.placeDefinitionRows)
    ownershipDropCidAppendBoolSequenceValue(
        buf, state.placeEntryDefinitionReachable)
    ownershipDropCidAppendBoolSequenceValue(
        buf, state.placeManualPostDefinitionReachable)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.fieldStateMasks)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.borrowSourcePlaceIds)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.borrowProjectionTokens)
    ownershipDropCidAppendI32SequenceValue(buf, state.escapeMasks)
    ownershipDropCidAppendI32SequenceValue(
        buf, state.deferActiveMasks)

fn OwnershipDropAnalysisCanonicalCid(
        ir: var OwnershipDropIr,
        analysis: var OwnershipDropAnalysis): layout.FixedBytes32 =
    ownershipDropRequireAnalysisCidReady(ir, analysis)
    let irCid = OwnershipDropIrCanonicalCid(ir)
    var buf = layout.ByteBufInit(2048)
    ownershipDropCidAppendText(
        buf, "cheng.ownership_drop_analysis.canonical.cid")
    ownershipDropCidAppendI32(
        buf, ownershipDropAnalysisCidSchemaFieldCount)

    ownershipDropCidAppendFieldHeader(buf, 1, 1, 1)
    layout.ByteBufAppendFixed32(buf, irCid)

    ownershipDropCidAppendFieldHeader(
        buf, 2, analysis.blockInputs.len,
        ownershipDropFlowCidRowFieldCount)
    for rowIndex in 0..<analysis.blockInputs.len:
        ownershipDropCidAppendFlowState(
            buf, analysis.blockInputs[rowIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 3, analysis.blockOutputs.len,
        ownershipDropFlowCidRowFieldCount)
    for rowIndex in 0..<analysis.blockOutputs.len:
        ownershipDropCidAppendFlowState(
            buf, analysis.blockOutputs[rowIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 4, analysis.opActionStarts.len, 1)
    for valueIndex in 0..<analysis.opActionStarts.len:
        ownershipDropCidAppendI32(
            buf, analysis.opActionStarts[valueIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 5, analysis.opActionCounts.len, 1)
    for valueIndex in 0..<analysis.opActionCounts.len:
        ownershipDropCidAppendI32(
            buf, analysis.opActionCounts[valueIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 6, analysis.edgeActionStarts.len, 1)
    for valueIndex in 0..<analysis.edgeActionStarts.len:
        ownershipDropCidAppendI32(
            buf, analysis.edgeActionStarts[valueIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 7, analysis.edgeActionCounts.len, 1)
    for valueIndex in 0..<analysis.edgeActionCounts.len:
        ownershipDropCidAppendI32(
            buf, analysis.edgeActionCounts[valueIndex])

    ownershipDropCidAppendFieldHeader(
        buf, 8, analysis.cleanupActions.len,
        ownershipDropActionCidRowFieldCount)
    for rowIndex in 0..<analysis.cleanupActions.len:
        let row = analysis.cleanupActions[rowIndex]
        ownershipDropCidAppendI32(buf, row.edgeId)
        ownershipDropCidAppendI32(buf, row.opIndex)
        ownershipDropCidAppendI32(buf, int32(row.kind))
        ownershipDropCidAppendI32(buf, row.actionId)
        ownershipDropCidAppendI32(buf, row.placeId)
        ownershipDropCidAppendI32(buf, row.otherPlaceId)
        ownershipDropCidAppendI32(buf, row.fieldOrdinal)
        ownershipDropCidAppendI32(buf, row.typeId)
        ownershipDropCidAppendI32(buf, row.dropGlueId)
        ownershipDropCidAppendI32(buf, row.returnSnapshotGlueId)
        ownershipDropCidAppendText(
            buf, row.returnSnapshotGlueSymbol)
        ownershipDropCidAppendI32(buf, int32(row.conditionKind))
        ownershipDropCidAppendI32(buf, row.conditionFlagId)
        ownershipDropCidAppendBool(buf, row.conditionNegated)
        ownershipDropCidAppendI32(
            buf, int32(row.conditionOtherKind))
        ownershipDropCidAppendI32(buf, row.conditionOtherFlagId)
        ownershipDropCidAppendBool(buf, row.conditionOtherNegated)
        ownershipDropCidAppendI32(buf, row.guardDeferId)
        ownershipDropCidAppendBool(buf, row.guardDeferNegated)
        ownershipDropCidAppendI32(
            buf, int32(row.definitionOriginKind))
        ownershipDropCidAppendI32(buf, row.definitionOriginId)
        ownershipDropCidAppendI32(
            buf, row.sourceDefinitionDomain)
        ownershipDropCidAppendI32(buf, row.sourceDefinitionRow)
        ownershipDropCidAppendI32(
            buf, row.capturedOldSourceDefinitionDomain)
        ownershipDropCidAppendI32(
            buf, row.capturedOldSourceDefinitionRow)
        ownershipDropCidAppendI32(buf, int32(row.sourceOwnership))
        ownershipDropCidAppendI32(buf, row.consumeActionRow)

    ownershipDropCidAppendFieldHeader(
        buf, 9, analysis.conditionFlags.len,
        ownershipDropConditionFlagCidRowFieldCount)
    for rowIndex in 0..<analysis.conditionFlags.len:
        let row = analysis.conditionFlags[rowIndex]
        ownershipDropCidAppendI32(buf, row.flagId)
        ownershipDropCidAppendI32(buf, int32(row.kind))
        ownershipDropCidAppendI32(buf, row.placeId)
        ownershipDropCidAppendI32(buf, row.fieldOrdinal)
        ownershipDropCidAppendI32(buf, row.deferId)
        ownershipDropCidAppendBool(buf, row.initialValue)

    ownershipDropCidAppendFieldHeader(
        buf, 10, analysis.flagTransitions.len,
        ownershipDropFlagTransitionCidRowFieldCount)
    for rowIndex in 0..<analysis.flagTransitions.len:
        let row = analysis.flagTransitions[rowIndex]
        ownershipDropCidAppendI32(buf, int32(row.originKind))
        ownershipDropCidAppendI32(buf, row.originId)
        ownershipDropCidAppendI32(buf, row.flagId)
        ownershipDropCidAppendBool(buf, row.setValue)
        ownershipDropCidAppendBool(buf, row.afterActions)

    ownershipDropCidAppendFieldHeader(buf, 11, 1, 1)
    ownershipDropCidAppendI32(buf, analysis.fixedPointSteps)
    ownershipDropCidAppendFieldHeader(buf, 12, 1, 1)
    ownershipDropCidAppendBool(buf, analysis.converged)
    return ownershipDropCidFinish(buf)
