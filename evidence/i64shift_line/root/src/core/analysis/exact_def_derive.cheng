# exact_def_derive — ExactDef 批 1: 规范推导器骨架
# (docs/cheng-exact-def-rewrite-design.md §3.2「推导取代发布」, 批 1 范围)。
#
# 单遍规范推导, 取代 C 冷链解析期 ~100 站点增量发布。输入仅限三类不可变证据:
#   (a) LoweringOwnershipTransportSoA 的 int32 投影列 (语义行窗 + origin +
#       exactTypeId; 批 2 接线点由 lowering 直传, 本模块不 import lowering —
#       结构上杜绝 lowering_plan → derive → lowering_plan 的 import 环);
#   (b) BodyOp.valueDef* 不可变权威列;
#   (c) BodyIR 结构列 (localSlots / entryParameterSlotIds /
#       entryDefinitionOwnership* / callSequence) + TypeArena 证据窗
#       (exactdef.BodyIrExactDefTypeArenaWindow, 十列不可变投影)。
#
# 臂覆盖 (批 1 骨架):
#   - 四 origin 定义臂: Parameter→PARAM / BindingInitializer→STACK_LOCAL /
#     CallResult→TEMPORARY / ManagedTemporary→TEMPORARY (origin kind 取自
#     transport 窗, 是 TypedExpr 冻结权威的 lowering 投影, 非后端猜测);
#   - borrow-view 臂: destination 仍 UNKNOWN 且 source 已证 authority 非
#     UNKNOWN → 同值落戳 (cold_parser.c borrow-view 泛化臂的 Cheng 版,
#     墙4 slot-authority 根修语义); 已分类 → 幂等核等, 漂移即判词;
#   - local-copy 臂: CopyLocal fresh 槽落 source 戳, opSourceDefOpRows 落
#     source 物理定义 op 行 (末定义工作列, 无文本无名字);
#   - field-borrow 臂: FieldLoad 逐跳核对 — 每跳核 owner 物理 TypeId 的
#     layoutChild CSR 中存在 (childTypeId==字段 TypeId ∧ offset∧width),
#     禁摊平 (设计 §5/AGENTS 字段与所有权逐层证明);
#   - storage 规范推导: cold_canonical_storage_obligation_for_body_slot 的
#     Cheng 版 — slot kind 静态道 + nominal 槽经 TypeArena 证据窗闭包证,
#     Object/Tuple/Optional 字段折叠 (任一非 PLAIN 字段→OBJECT, 全 PLAIN
#     →PLAIN, 零字段→PLAIN; UNKNOWN 传染), RefObject→OBJECT。
#   - call-arg CSR 臂 (批 2 扩): 每个 CALL op 的实参槽 → 当前物理定义
#     op 行 (lastDefOpBySlot 发射序末定义权威), ownership/place/origin
#     镜像定义车道; address 编码形 → BORROW_SHARED 借用载体, 非消费
#     (consume 谓词通道②的证据源, 见 exact_def_freeze)。
#
# hard-fail 纪律: managed 定义推不出精确戳 (storage UNKNOWN / TypeId 未绑 /
# transport 窗未覆盖 / hop 核对失败) = 立即 panic (单行确定文本, 无兜底);
# UNKNOWN 不通行。def↔slot 已落车道漂移 (place/origin/storage 不等) 走
# identity schema storage 子句判词 (stderr 单行 + 返回 false, 不走 panic 栈)。
#
# 批 4 锚点 (本批仅注释, 不实现): CFG merge 定义臂 + merge 双 UNKNOWN→
# PLAIN 条款 (cold_parser.c:64421-64423 镜像) 在 exact_def_merge.cheng 落地,
# 本文件的 storage/sentinel helper 为其公共输入。
#
# read-edge (opReadADefOpRows) 批 2 单遍完成+校验, 本批恒 -1。

import std/strformat
import std/os
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/analysis/exact_def_merge as exactdefmerge
import cheng/core/analysis/managed_lvalue_replace as managedreplace
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # texpr.TypedExprValueDefinitionOriginKind 值镜 (typed_expr.cheng:73-78;
    # transport.originKinds 是其 int32 投影)。本模块不 import typed_expr。
    bodyIrExactDefOriginParameter = 1
    bodyIrExactDefOriginBindingInitializer = 2
    bodyIrExactDefOriginCallResult = 3
    bodyIrExactDefOriginManagedTemporary = 4

@borrows
fn bodyIrExactDefVerdictEmit(line: str) =
    os.WriteLine(os.Get_stderr(), line)
    os.C_fflush(os.Get_stderr())

# ---- TypeArena 证据窗遍历 (逐跳证明, 禁摊平) ----

@borrows
fn bodyIrExactDefRequireTypeFact(window: exactdef.BodyIrExactDefTypeArenaWindow,
                                 typeId: int32) =
    if typeId < 0 || typeId >= window.structuralKinds.len ||
       window.structuralKinds[typeId] <=
           Int32(typearena.TypedExprStructuralTypeInvalid) ||
       window.sizeBytes[typeId] < 0 ||
       window.alignBytes[typeId] <= 0:
        panic(Fmt"exact def derive: TypeId fact missing type={typeId}")

# Alias/Borrow/Apply 转发行单跳展开, 到非转发 TypeId 终止;
# visited 路径检测, 环即 hard fail (同 CanonicalTypeChainPhysicalTypeId 裁定)。
@borrows
fn bodyIrExactDefPhysicalTypeId(window: exactdef.BodyIrExactDefTypeArenaWindow,
                                typeId: int32): int32 =
    var visited: bool[]
    setLen(visited, window.structuralKinds.len)
    var current = typeId
    while true:
        bodyIrExactDefRequireTypeFact(window, current)
        if visited[current]:
            panic(Fmt"exact def derive: TypeId forwarding cycle type={typeId}")
        visited[current] = true
        let kind = window.structuralKinds[current]
        if kind != Int32(typearena.TypedExprStructuralTypeAlias) &&
           kind != Int32(typearena.TypedExprStructuralTypeBorrow) &&
           kind != Int32(typearena.TypedExprStructuralTypeApply):
            return current
        let childTypeId = window.childTypeIds[current]
        if childTypeId < 0 ||
           childTypeId >= window.structuralKinds.len:
            panic(Fmt"exact def derive: forwarding child not unique type={current}")
        current = childTypeId

# nominal storage 折叠 (cold_exact_object_storage_obligation_readonly 的
# Cheng 版): 字段逐跳递归, UNKNOWN 传染; 路径 visited 检测类型环。
@borrows
fn bodyIrExactDefStorageObligationForTypeIdInner(
        window: exactdef.BodyIrExactDefTypeArenaWindow,
        typeId: int32,
        onPath: var bool[]): int32 =
    let physicalTypeId = bodyIrExactDefPhysicalTypeId(window, typeId)
    if onPath[physicalTypeId]:
        panic(Fmt"exact def derive: TypeId storage cycle type={typeId}")
    onPath[physicalTypeId] = true
    var result = exactdef.BodyIrExactDefStorageUnknownTag
    let kind = window.structuralKinds[physicalTypeId]
    if kind == Int32(typearena.TypedExprStructuralTypeScalar):
        let scalarKind = window.scalarKinds[physicalTypeId]
        if scalarKind == Int32(typearena.TypedExprStructuralScalarStr):
            result = exactdef.BodyIrExactDefStorageStrTag
        elif scalarKind >
                Int32(typearena.TypedExprStructuralScalarInvalid) &&
             scalarKind !=
                Int32(typearena.TypedExprStructuralScalarVoid):
            result = exactdef.BodyIrExactDefStoragePlainTag
    elif kind == Int32(typearena.TypedExprStructuralTypeRefObject):
        result = exactdef.BodyIrExactDefStorageObjectTag
    elif kind == Int32(typearena.TypedExprStructuralTypeFunction):
        result = exactdef.BodyIrExactDefStoragePlainTag
    elif kind == Int32(typearena.TypedExprStructuralTypeEnum):
        result = exactdef.BodyIrExactDefStoragePlainTag
    elif kind == Int32(typearena.TypedExprStructuralTypeSequence):
        if window.childTypeIds[physicalTypeId] >= 0:
            result = exactdef.BodyIrExactDefStorageSequenceTag
    elif kind == Int32(typearena.TypedExprStructuralTypeFixedArray):
        let elementTypeId = window.childTypeIds[physicalTypeId]
        if elementTypeId >= 0 &&
           window.fixedLengths[physicalTypeId] > 0:
            result = bodyIrExactDefStorageObligationForTypeIdInner(
                window, elementTypeId, onPath)
    elif kind == Int32(typearena.TypedExprStructuralTypeObject) ||
           kind == Int32(typearena.TypedExprStructuralTypeTuple) ||
           kind == Int32(typearena.TypedExprStructuralTypeOptional):
        let childStart = window.layoutChildStarts[physicalTypeId]
        let childCount = window.layoutChildCounts[physicalTypeId]
        if childStart < 0 || childCount < 0 ||
           childStart > window.layoutChildTypeIds.len - childCount:
            panic(Fmt"exact def derive: layout child CSR invalid type={physicalTypeId}")
        var sawManagedField = false
        var foldKnown = true
        for childOffset in 0..<childCount:
            let fieldTypeId =
                window.layoutChildTypeIds[childStart + childOffset]
            let fieldStorage =
                bodyIrExactDefStorageObligationForTypeIdInner(
                    window, fieldTypeId, onPath)
            if fieldStorage == exactdef.BodyIrExactDefStorageUnknownTag:
                foldKnown = false
                break
            if fieldStorage != exactdef.BodyIrExactDefStoragePlainTag:
                sawManagedField = true
        if foldKnown:
            if childCount == 0:
                result = exactdef.BodyIrExactDefStoragePlainTag
            elif sawManagedField:
                result = exactdef.BodyIrExactDefStorageObjectTag
            else:
                result = exactdef.BodyIrExactDefStoragePlainTag
    onPath[physicalTypeId] = false
    return result

@borrows
fn bodyIrExactDefStorageObligationForTypeId(
        window: exactdef.BodyIrExactDefTypeArenaWindow,
        typeId: int32): int32 =
    var onPath: bool[]
    setLen(onPath, window.structuralKinds.len)
    return bodyIrExactDefStorageObligationForTypeIdInner(
        window, typeId, onPath)

# cold_canonical_storage_obligation_for_body_slot 的 Cheng 版:
# slot kind 静态道 + nominal 槽经 TypeArena 证据窗闭包证, 逐层证明、禁摊平。
@borrows
fn BodyIrExactDefStorageObligationForSlot(
        bodyIR: coreir.BodyIR,
        window: exactdef.BodyIrExactDefTypeArenaWindow,
        slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        panic(Fmt"exact def derive: storage slot row invalid slot={slotId}")
    let slot = bodyIR.localSlots[slotId]
    if slot.typeArenaTypeId >= 0:
        let nominal =
            bodyIrExactDefStorageObligationForTypeId(
                window, slot.typeArenaTypeId)
        if nominal != exactdef.BodyIrExactDefStoragePlainTag:
            return nominal
        # PLAIN 须过静态宽度道 (C exact_scalar_width 臂): 宽度不符即 UNKNOWN。
        if slot.typeKind == coreir.LocalI32Tag:
            if slot.sizeBytes == 1 || slot.sizeBytes == 4:
                return exactdef.BodyIrExactDefStoragePlainTag
            return exactdef.BodyIrExactDefStorageUnknownTag
        if slot.typeKind == coreir.LocalI64Tag ||
           slot.typeKind == coreir.LocalF64Tag ||
           slot.typeKind == coreir.LocalPtrTag:
            if slot.sizeBytes == 8:
                return exactdef.BodyIrExactDefStoragePlainTag
            return exactdef.BodyIrExactDefStorageUnknownTag
        if slot.typeKind == coreir.LocalStrTag ||
           slot.typeKind == coreir.LocalAggregateTag:
            if slot.sizeBytes > 0:
                return exactdef.BodyIrExactDefStoragePlainTag
            return exactdef.BodyIrExactDefStorageUnknownTag
        return exactdef.BodyIrExactDefStorageUnknownTag
    # 未绑 TypeId 静态道 (C cold_exact_managed_storage_kind_for_slot_kind 对齐):
    # str/标量/裸指针静态分类; nominal 聚合未绑即 UNKNOWN。
    if slot.typeKind == coreir.LocalStrTag:
        return exactdef.BodyIrExactDefStorageStrTag
    if slot.typeKind == coreir.LocalI32Tag:
        if slot.sizeBytes == 1 || slot.sizeBytes == 4:
            return exactdef.BodyIrExactDefStoragePlainTag
        return exactdef.BodyIrExactDefStorageUnknownTag
    if slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalF64Tag ||
       slot.typeKind == coreir.LocalPtrTag:
        if slot.sizeBytes == 8:
            return exactdef.BodyIrExactDefStoragePlainTag
        return exactdef.BodyIrExactDefStorageUnknownTag
    return exactdef.BodyIrExactDefStorageUnknownTag

# ---- 判词 (identity schema storage 子句, C 文本逐字保留) ----

@borrows
fn bodyIrExactDefOpOperandOrInvalid(op: coreir.BodyOp,
                                    ordinal: int32): int32 =
    if ordinal < 0 || ordinal >= op.operands.len:
        return -1
    return op.operands[ordinal]

# def↔slot 四字段一致性 + storage 子句 (cheng_cold.c:68393-68401 同条件):
#   (defStorage==UNKNOWN 且非 typeless-global 根) 或 (defType>=0 且
#   slotType!=defType) 或 slotStorage!=defStorage → 判词 + false。
# typeless-global 根 (C 68386-68392): GLOBAL place ∧ 未证 TypeId ∧
# obligation UNKNOWN ∧ 静态道 UNKNOWN (未绑 nominal 聚合)。
@borrows
fn BodyIrExactDefSlotAuthorityStorageClauseCheck(
        bodyIR: coreir.BodyIR,
        window: exactdef.BodyIrExactDefTypeArenaWindow,
        opRow: int32): bool =
    if !bodyIR.exactDef.sealed:
        panic("exact def derive: storage clause check requires sealed sidecar")
    if opRow < 0 || opRow >= bodyIR.ops.len:
        panic(Fmt"exact def derive: storage clause op row invalid op={opRow}")
    let op = bodyIR.ops[opRow]
    let slotId = op.valueDefSlot
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        panic(Fmt"exact def derive: storage clause def slot invalid op={opRow}")
    let slot = bodyIR.localSlots[slotId]
    let defType = bodyIR.exactDef.opExactTypeIds[opRow]
    let slotType = slot.typeArenaTypeId
    let defPlace = bodyIR.exactDef.opPlaceKinds[opRow]
    let slotPlace = bodyIR.exactDef.slotPlaceKinds[slotId]
    let defOrigin = bodyIR.exactDef.opOriginIds[opRow]
    let slotOrigin = bodyIR.exactDef.slotOriginIds[slotId]
    let defStorage =
        BodyIrExactDefStorageObligationForSlot(bodyIR, window, slotId)
    let slotStorage = bodyIR.exactDef.slotStorageKinds[slotId]
    let typelessGlobalRoot =
        defPlace == exactdef.BodyIrExactDefPlaceGlobalTag &&
        defType < 0 &&
        defStorage == exactdef.BodyIrExactDefStorageUnknownTag &&
        slot.typeKind == coreir.LocalAggregateTag &&
        slotType < 0
    if (defStorage == exactdef.BodyIrExactDefStorageUnknownTag &&
        !typelessGlobalRoot) ||
       (defType >= 0 && slotType != defType) ||
       slotStorage != defStorage:
        bodyIrExactDefVerdictEmit(
            exactdef.BodyIrExactDefSlotAuthorityMismatchLine(
                "derive",
                bodyIR.controlFunctionRow,
                opRow,
                slotId,
                slot.typeKind,
                slot.sizeBytes,
                slot.name,
                op.kind,
                op.target,
                bodyIrExactDefOpOperandOrInvalid(op, 0),
                bodyIrExactDefOpOperandOrInvalid(op, 1),
                bodyIrExactDefOpOperandOrInvalid(op, 2),
                bodyIR.exactDef.opSourceDefOpRows[opRow],
                bodyIR.exactDef.opReadADefOpRows[opRow],
                defType,
                slotType,
                defPlace,
                slotPlace,
                defOrigin,
                slotOrigin,
                defStorage,
                slotStorage))
        return false
    return true

# ---- 规范推导单遍 ----

fn bodyIrExactDefLandSlotStorage(bodyIR: var coreir.BodyIR,
                                 slotId: int32,
                                 storage: int32,
                                 opRow: int32): bool =
    let current = bodyIR.exactDef.slotStorageKinds[slotId]
    if current == exactdef.BodyIrExactDefStorageUnknownTag:
        bodyIR.exactDef.slotStorageKinds[slotId] = storage
        return true
    if current == storage:
        return true
    let slot = bodyIR.localSlots[slotId]
    let op = bodyIR.ops[opRow]
    bodyIrExactDefVerdictEmit(
        exactdef.BodyIrExactDefSlotAuthorityMismatchLine(
            "derive",
            bodyIR.controlFunctionRow,
            opRow,
            slotId,
            slot.typeKind,
            slot.sizeBytes,
            slot.name,
            op.kind,
            op.target,
            bodyIrExactDefOpOperandOrInvalid(op, 0),
            bodyIrExactDefOpOperandOrInvalid(op, 1),
            bodyIrExactDefOpOperandOrInvalid(op, 2),
            bodyIR.exactDef.opSourceDefOpRows[opRow],
            bodyIR.exactDef.opReadADefOpRows[opRow],
            bodyIR.exactDef.opExactTypeIds[opRow],
            slot.typeArenaTypeId,
            bodyIR.exactDef.opPlaceKinds[opRow],
            bodyIR.exactDef.slotPlaceKinds[slotId],
            bodyIR.exactDef.opOriginIds[opRow],
            bodyIR.exactDef.slotOriginIds[slotId],
            storage,
            current))
    return false

fn bodyIrExactDefLandSlotIdentity(bodyIR: var coreir.BodyIR,
                                  slotId: int32,
                                  place: int32,
                                  origin: int32,
                                  storage: int32,
                                  opRow: int32): bool =
    let currentPlace = bodyIR.exactDef.slotPlaceKinds[slotId]
    let currentOrigin = bodyIR.exactDef.slotOriginIds[slotId]
    if currentPlace == exactdef.BodyIrExactDefPlaceInvalidTag &&
       currentOrigin == -1:
        bodyIR.exactDef.slotPlaceKinds[slotId] = place
        bodyIR.exactDef.slotOriginIds[slotId] = origin
    elif currentPlace != place || currentOrigin != origin:
        let slot = bodyIR.localSlots[slotId]
        let op = bodyIR.ops[opRow]
        bodyIrExactDefVerdictEmit(
            exactdef.BodyIrExactDefSlotAuthorityMismatchLine(
                "derive",
                bodyIR.controlFunctionRow,
                opRow,
                slotId,
                slot.typeKind,
                slot.sizeBytes,
                slot.name,
                op.kind,
                op.target,
                bodyIrExactDefOpOperandOrInvalid(op, 0),
                bodyIrExactDefOpOperandOrInvalid(op, 1),
                bodyIrExactDefOpOperandOrInvalid(op, 2),
                bodyIR.exactDef.opSourceDefOpRows[opRow],
                bodyIR.exactDef.opReadADefOpRows[opRow],
                bodyIR.exactDef.opExactTypeIds[opRow],
                slot.typeArenaTypeId,
                place,
                currentPlace,
                origin,
                currentOrigin,
                storage,
                bodyIR.exactDef.slotStorageKinds[slotId]))
        return false
    return bodyIrExactDefLandSlotStorage(
        bodyIR, slotId, storage, opRow)

# [wall100] hop 放行配对绑定 (wall98 修法甲): hop 命中 ⇔ destination 槽
# storage 权威坐实 (fieldTypeId = 槽冻结 TypeId, wall90 契约), 该 TypeId
# 的 canonical fact 义务由 hop 配对补上。wall98 定性: 托管槽 proof 绑定段
# (PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact, 7 调用点共享)
# 绑槽 proof 零 fact closure, 是唯一缺臂绑定面; 本绑定面在 derive 单点,
# primary/backend2 双管线共享 (两唯一 BodyIrExactDefDerive 调用点)。行值
# = TypeArena 证据窗六列+artifactCid 直传权威 (与 primary field chain/
# lowering/managed-replace 各绑定面同源), 走 ManagedLvalueReplaceProduction
# BindTypeClosure 既有先例 (单子链闭包: ownership production RefObject/
# Sequence 臂 child 在册审计所需); BodyIRBindCanonicalTypeFact 幂等 (既有
# 同值行→true), 已过程序的 fact 表与发射字节零变化。绑定失败 = 窗值不可
# bind = 证据洞, 判词如实 hard fail, 无兜底。
@borrows
fn bodyIrExactDefFieldHopBindFactClosure(
        bodyIR: var coreir.BodyIR,
        window: exactdef.BodyIrExactDefTypeArenaWindow,
        opRow: int32,
        defSlot: int32,
        fieldTypeId: int32) =
    if !managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
           bodyIR,
           window.artifactCid,
           fieldTypeId,
           window.structuralKinds,
           window.scalarKinds,
           window.childTypeIds,
           window.fixedLengths,
           window.sizeBytes,
           window.alignBytes):
        panic(Fmt"exact def derive: field hop fact closure bind invalid op={opRow} slot={defSlot} tid={fieldTypeId} fn={bodyIR.controlFunctionRow} fact_count={bodyIR.typeFactTypeIds.len}")

# FieldLoad 逐跳核对: owner 物理 TypeId 的 layoutChild CSR 中必须存在
# (childTypeId==字段 TypeId ∧ offset∧width) 一跳; 每跳只核一跳, 不摊平。
@borrows
fn bodyIrExactDefFieldHopValid(
        bodyIR: var coreir.BodyIR,
        window: exactdef.BodyIrExactDefTypeArenaWindow,
        opRow: int32,
        defSlot: int32,
        fieldTypeId: int32): bool =
    let op = bodyIR.ops[opRow]
    if op.operands.len != 4 || op.operands[1] != defSlot ||
       op.target != defSlot:
        return false
    let baseSlot = op.operands[0]
    let fieldOffset = op.operands[2]
    let fieldWidth = op.operands[3]
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
       fieldOffset < 0 || fieldWidth <= 0 ||
       fieldWidth > bodyIR.localSlots[defSlot].sizeBytes:
        return false
    let ownerTypeId = bodyIR.localSlots[baseSlot].typeArenaTypeId
    if ownerTypeId < 0:
        return false
    let physicalOwner =
        bodyIrExactDefPhysicalTypeId(window, ownerTypeId)
    # 整值借视形臂 (零跳): 地址基座 (entry param / global address) 上的
    # 托管借用物化按发布契约复用 FieldLoad 形状发整值载入 (primary
    # Materialize: operands=[base,dst,0,base 槽全宽])。该形按构造不是
    # 字段跳: offset==0 ∧ width==base 槽全宽 ∧ base 物理类型==字段物理
    # 类型 (借视同型) — layout children 要命中此形须字段类型==容器自身
    # 类型, 物理不可能, 故接纳它不摊平任何字段证明; 部分宽/跨型/非零
    # 偏移仍走下方逐跳核对 (原守卫逐字保留)。
    if fieldOffset == 0 &&
       fieldWidth == bodyIR.localSlots[baseSlot].sizeBytes &&
       physicalOwner ==
           bodyIrExactDefPhysicalTypeId(window, fieldTypeId):
        # [wall100] 整值借视残形命中: 同款配对绑定后再放行。
        bodyIrExactDefFieldHopBindFactClosure(
            bodyIR, window, opRow, defSlot, fieldTypeId)
        return true
    let childStart = window.layoutChildStarts[physicalOwner]
    let childCount = window.layoutChildCounts[physicalOwner]
    if childStart < 0 || childCount < 0 ||
       childStart > window.layoutChildTypeIds.len - childCount:
        return false
    for childOffset in 0..<childCount:
        let childRow = childStart + childOffset
        if window.layoutChildTypeIds[childRow] == fieldTypeId &&
           window.layoutChildOffsets[childRow] == fieldOffset &&
           window.layoutChildWidths[childRow] == fieldWidth:
            # [wall100] 精确三元组命中: 放行前为 destination 槽冻结
            # TypeId 配对绑定 canonical fact closure (修法甲单点)。
            bodyIrExactDefFieldHopBindFactClosure(
                bodyIR, window, opRow, defSlot, fieldTypeId)
            return true
    return false

# 单遍规范推导。返回 false = 判词已发 (stderr 单行), 侧车未 seal;
# 证据洞 (戳推不出) = panic hard fail, 无兜底。
@borrows
fn BodyIrExactDefDerive(
        bodyIR: var coreir.BodyIR,
        transportSourceValueDefinitionStart: int32,
        transportDefinitionRows: int32[],
        transportOriginKinds: int32[],
        transportExactTypeIds: int32[],
        window: exactdef.BodyIrExactDefTypeArenaWindow): bool =
    if !exactdef.BodyIrExactDefSidecarIsCanonicalEmpty(bodyIR.exactDef):
        panic("exact def derive: sidecar not canonical empty")
    if !exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window):
        panic("exact def derive: TypeArena evidence window invalid")
    if bodyIR.controlFunctionRow < 0:
        panic("exact def derive: producer function row missing")
    if !layout.FixedBytes32Equal(
           window.artifactCid, bodyIR.typeArenaArtifactCid):
        panic("exact def derive: TypeArena artifact domain mismatch")
    let transportCount = transportDefinitionRows.len
    if transportSourceValueDefinitionStart < 0 ||
       transportOriginKinds.len != transportCount ||
       transportExactTypeIds.len != transportCount:
        panic("exact def derive: ownership transport window invalid")
    for row in 0..<transportCount:
        if transportDefinitionRows[row] !=
               transportSourceValueDefinitionStart + row:
            panic("exact def derive: ownership transport CSR invalid")
    # 相 1: dense 列分配, 全 sentinel 初值。
    for opIndex in 0..<bodyIR.ops.len:
        add(bodyIR.exactDef.opPlaceKinds,
            exactdef.BodyIrExactDefPlaceInvalidTag)
        add(bodyIR.exactDef.opExactTypeIds, -1)
        add(bodyIR.exactDef.opOriginIds, -1)
        add(bodyIR.exactDef.opProducerFunctionRows, -1)
        add(bodyIR.exactDef.opSourceDefOpRows, -1)
        add(bodyIR.exactDef.opReadADefOpRows, -1)
    for slotIndex in 0..<bodyIR.localSlots.len:
        add(bodyIR.exactDef.slotPlaceKinds,
            exactdef.BodyIrExactDefPlaceInvalidTag)
        add(bodyIR.exactDef.slotOriginIds, -1)
        add(bodyIR.exactDef.slotStorageKinds,
            exactdef.BodyIrExactDefStorageUnknownTag)
    var argTotal: int32
    for callIndex in 0..<bodyIR.callSequence.len:
        add(bodyIR.exactDef.callArgStarts, argTotal)
        let argCount = bodyIR.callSequence[callIndex].argSlots.len
        add(bodyIR.exactDef.callArgCounts, argCount)
        argTotal = argTotal + argCount
    for argIndex in 0..<argTotal:
        add(bodyIR.exactDef.argDefOpRows, -1)
        add(bodyIR.exactDef.argPlaceKinds,
            exactdef.BodyIrExactDefPlaceInvalidTag)
        add(bodyIR.exactDef.argOwnerships, Int32(coreir.OwnInvalid))
        add(bodyIR.exactDef.argOriginIds, -1)
    # 相 2: entry 形参车道 (origin=形参序, place=PARAM)。
    if bodyIR.entryDefinitionOwnershipSealed:
        if bodyIR.entryDefinitionOwnershipKinds.len !=
               bodyIR.localSlots.len:
            panic("exact def derive: entry definition ownership shape invalid")
        for ordinal in 0..<bodyIR.entryParameterSlotIds.len:
            let slotId = bodyIR.entryParameterSlotIds[ordinal]
            if slotId < 0 || slotId >= bodyIR.localSlots.len:
                panic("exact def derive: entry parameter slot row invalid")
            let ownership = bodyIR.entryDefinitionOwnershipKinds[slotId]
            if ownership == Int32(coreir.OwnInvalid):
                continue
            if ownership != Int32(coreir.OwnPlain) &&
               ownership != Int32(coreir.OwnMove) &&
               ownership != Int32(coreir.OwnBorrowShared) &&
               ownership != Int32(coreir.OwnBorrowUnique):
                panic(Fmt"exact def derive: entry parameter ownership invalid slot={slotId}")
            let storage = BodyIrExactDefStorageObligationForSlot(
                bodyIR, window, slotId)
            if storage == exactdef.BodyIrExactDefStorageUnknownTag:
                panic(Fmt"exact def derive: entry parameter storage obligation unknown slot={slotId}")
            bodyIR.exactDef.slotPlaceKinds[slotId] =
                exactdef.BodyIrExactDefPlaceParamTag
            bodyIR.exactDef.slotOriginIds[slotId] = ordinal
            bodyIR.exactDef.slotStorageKinds[slotId] = storage
    # 相 3: op 单遍, 定义臂逐行落戳; lastDefOpBySlot 是 source 边的唯一
    # 物理证据 (无文本无名字)。
    var lastDefOpBySlot: int32[]
    for slotIndex in 0..<bodyIR.localSlots.len:
        add(lastDefOpBySlot, -1)
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        # 批 2 call-arg CSR 臂 (consume 谓词通道②的 Cheng 证据源):
        # 每个 CALL op 的实参槽 → 当前物理定义 op 行 (lastDefOpBySlot
        # 是 lowering 发射序的末定义权威, 与 local-copy 臂同证据类)。
        # address 编码形 = 借用载体, 非消费 (drop-glue 消费经通道①
        # source 边); ownership/place/origin 镜像定义的不可变车道。
        if op.kind == coreir.BodyOpCallTag && op.operands.len == 1:
            let callRow = op.operands[0]
            if callRow < 0 || callRow >= bodyIR.callSequence.len:
                panic(Fmt"exact def derive: call op ordinal invalid op={opIndex}")
            let argStart = bodyIR.exactDef.callArgStarts[callRow]
            let argCount = bodyIR.exactDef.callArgCounts[callRow]
            # [wall131] callee 形参 ownership 权威列（生产侧
            # PrimaryBodyIrFillCallArgFormalOwnerships 落列）。非空时长度
            # 必须与实参数精确相等；逐行仅在 BorrowUnique (var/借用形参)
            # 处以形参权威覆盖定义行 Move 镜像（var 形参语义 = 借用传入、
            # 调用后归还，Move 戳是伪消费根修点），其余行值与 len==0（未
            # 落列/importc/合成 call）保持既有行为逐字节不变，fail-closed。
            let formalOwns =
                bodyIR.callSequence[callRow].argFormalOwnerships
            if formalOwns.len != 0 && formalOwns.len != argCount:
                panic(Fmt"exact def derive: call arg formal ownership cardinality invalid op={opIndex}")
            for argOffset in 0..<argCount:
                let argRow = argStart + argOffset
                let encoded =
                    bodyIR.callSequence[callRow].argSlots[argOffset]
                if encoded < 0:
                    if coreir.CallArgSlotIsAddress(encoded):
                        bodyIR.exactDef.argOwnerships[argRow] =
                            Int32(coreir.OwnBorrowShared)
                    else:
                        bodyIR.exactDef.argOwnerships[argRow] =
                            Int32(coreir.OwnPlain)
                else:
                    let argSlot = encoded
                    if argSlot >= bodyIR.localSlots.len:
                        panic(Fmt"exact def derive: call arg slot invalid op={opIndex}")
                    let argDef = lastDefOpBySlot[argSlot]
                    if argDef >= 0:
                        bodyIR.exactDef.argDefOpRows[argRow] = argDef
                        if formalOwns.len == argCount &&
                           formalOwns[argOffset] ==
                               Int32(coreir.OwnBorrowUnique):
                            if os.GetEnv(
                                   "CHENG_PRIMARY_OBJECT_FAIL_TRACE") ==
                               "1":
                                let mirrorFormalVal = formalOwns[argOffset]
                                os.WriteLine(os.GetStderr(),
                                             Fmt"phase=exact_def_arg_formal_mirror op={opIndex} call={callRow} arg={argOffset} formal={mirrorFormalVal} def={argDef}")
                            bodyIR.exactDef.argOwnerships[argRow] =
                                Int32(coreir.OwnBorrowUnique)
                        else:
                            if formalOwns.len == argCount &&
                               os.GetEnv(
                                   "CHENG_PRIMARY_OBJECT_FAIL_TRACE") ==
                               "1":
                                let skipFormalVal = formalOwns[argOffset]
                                os.WriteLine(os.GetStderr(),
                                             Fmt"phase=exact_def_arg_formal_skip op={opIndex} call={callRow} arg={argOffset} formal={skipFormalVal} def={argDef}")
                            bodyIR.exactDef.argOwnerships[argRow] =
                                Int32(bodyIR.ops[argDef].valueDefOwnership)
                        bodyIR.exactDef.argPlaceKinds[argRow] =
                            bodyIR.exactDef.opPlaceKinds[argDef]
                        bodyIR.exactDef.argOriginIds[argRow] =
                            bodyIR.exactDef.opOriginIds[argDef]
                    else:
                        bodyIR.exactDef.argOwnerships[argRow] =
                            Int32(coreir.OwnPlain)
        if op.valueDefSlot < 0:
            # [wall105] 判词富化 (call-mirror 段缺失坐标显性化, fail-closed
            # 零放行): CALL op 写界内 target 槽 ∧ 自身无 valueDef 权威戳 ∧
            # 目标槽非 sentinel (BodyIrExactDefSlotIsSentinel 同源谓词: 已绑
            # TypeId 或 managed storage 非 Unknown — identity 槽循环对该槽
            # 必查 partial authority) ∧ 全 op 扫描 valueDefSlot==target 计数
            # 为 0 (identity 倒排计数同款入口列, 该槽必然 definition
            # count=0)。四条件合取 = 守卫必炸形状, 此处把 call-mirror 段
            # 产出实况 (call 行权威列全读 + 槽/storage 权威坐标) 一次入判词
            # 后 hard fail, 无兜底; 其余形状逐字走原 continue, 守卫覆盖面
            # 不变。定性 (v6 o11 实证): 非托管 call 结果在 TypedExpr 发布侧
            # 无 produced value-definition 权威行 (OwnPlain 没有 TypedExpr
            # value-def, AccessDecode 契约), lowering 通用发射臂因此无权威
            # 可落 (managedLocalDefinition 只覆盖托管形), derive 输入证据
            # (b) BodyOp.valueDef* 为不可变权威列 — 三层中 derive 层无契约
            # 内修法, 判词富化即本层全部合法动作。
            if op.kind == coreir.BodyOpCallTag &&
               op.operands.len == 1 &&
               op.target >= 0 && op.target < bodyIR.localSlots.len &&
               !exactdef.BodyIrExactDefSlotIsSentinel(bodyIR, op.target):
                var callDefCount: int32
                for defScan in 0..<bodyIR.ops.len:
                    if bodyIR.ops[defScan].valueDefSlot == op.target:
                        callDefCount = callDefCount + 1
                if callDefCount == 0:
                    let callRow = op.operands[0]
                    var callResultSlot = -1
                    var callResultOwn = -1
                    var callResultPass = -1
                    var callResultOriginKind = -1
                    var callResultVrow = -1
                    var callResultBod = -1
                    var callArgCount = -1
                    if callRow >= 0 && callRow < bodyIR.callSequence.len:
                        let callRowData = bodyIR.callSequence[callRow]
                        callResultSlot = callRowData.resultSlot
                        callResultOwn = Int32(callRowData.resultOwnership)
                        callResultPass = Int32(callRowData.resultPassKind)
                        callResultOriginKind =
                            Int32(callRowData.resultDefinitionOriginKind)
                        callResultVrow =
                            callRowData.resultValueDefinitionRow
                        callResultBod =
                            Int32(callRowData.resultBorrowOwnerDefinitionDomain)
                        callArgCount = callRowData.argSlots.len
                    panic(Fmt"exact def derive: call result definition authority missing op={opIndex} fn={bodyIR.controlFunctionRow} slot={op.target} slot_name={bodyIR.localSlots[op.target].name} slot_tk={bodyIR.localSlots[op.target].typeKind} slot_tid={bodyIR.localSlots[op.target].typeArenaTypeId} slot_sz={bodyIR.localSlots[op.target].sizeBytes} slot_mg={Int32(bodyIR.localSlots[op.target].managedStorageKind)} vds={op.valueDefSlot} vdo={Int32(op.valueDefOwnership)} vok={Int32(op.valueDefOriginKind)} vsr={op.valueDefSemanticRow} call_row={callRow} calls={bodyIR.callSequence.len} call_result_slot={callResultSlot} call_result_own={callResultOwn} call_result_pass={callResultPass} call_result_origin={callResultOriginKind} call_result_vrow={callResultVrow} call_result_bod={callResultBod} call_args={callArgCount} defs={callDefCount}")
            continue
        let defSlot = op.valueDefSlot
        if defSlot >= bodyIR.localSlots.len:
            panic(Fmt"exact def derive: def slot row invalid op={opIndex}")
        if op.valueDefOwnership != coreir.OwnPlain &&
           op.valueDefOwnership != coreir.OwnMove &&
           op.valueDefOwnership != coreir.OwnBorrowShared &&
           op.valueDefOwnership != coreir.OwnBorrowUnique:
            panic(Fmt"exact def derive: partial definition tuple op={opIndex}")
        if op.valueDefOriginKind != coreir.BodyDefinitionOriginTypedExprTag:
            panic(Fmt"exact def derive: definition origin authority missing op={opIndex}")
        let transportRow =
            op.valueDefSemanticRow - transportSourceValueDefinitionStart
        if transportRow < 0 || transportRow >= transportCount ||
           transportDefinitionRows[transportRow] !=
               op.valueDefSemanticRow:
            panic(Fmt"exact def derive: transport window miss op={opIndex} row={op.valueDefSemanticRow}")
        let originKind = transportOriginKinds[transportRow]
        let exactTypeId = transportExactTypeIds[transportRow]
        if exactTypeId < 0 ||
           exactTypeId >= window.structuralKinds.len:
            panic(Fmt"exact def derive: exact TypeId invalid op={opIndex}")
        let slotTid = bodyIR.localSlots[defSlot].typeArenaTypeId
        # [wall90] 契约对齐 (零弱化): def 行 TypeId 与 slot TypeId 相等核对
        # 只对「直定义形 ∧ 整值借视形」成立。字段投影借视形 (FieldLoad ∧
        # OwnBorrowShared ∧ 借主域非 Invalid) 的 def 行是沿投影链上溯的
        # 借主定义行 (primary ManagedSemanticValueDefinitionRowExact 契约,
        # identity BORROW_PROJECTION 主门按同列解释), destination 槽
        # TypeId 是字段自身 storage 权威 (BodyIRBindLocalSlotTypeArenaProof
        # 幂等绑定, 公共规范门落 destination storage 即读此列) — 两列各自
        # 忠实于两个不同权威, 相等在该形按构造不成立 (v6 op=1 实况:
        # exact_tid=20 var Node 借视 vs slot_tid=16 Box 句柄, sz/al 双 8)。
        # 该形改由 field-borrow 臂 hop 以 destination 槽冻结 TypeId 逐跳
        # 证明 (整值借视残形仍由 hop 整值臂放行, 真字段跳命中 layout
        # children (TypeId,offset,width) 精确三元组; slotTid 未绑/界外/
        # 伪造 = hop 失败或下方新 hard fail, 守卫覆盖面不变)。
        let fieldProjectionBorrow =
            op.valueDefOwnership == coreir.OwnBorrowShared &&
            op.valueDefBorrowOwnerDefinitionDomain !=
                coreir.BodyDefinitionDomainInvalidTag &&
            op.kind == coreir.BodyOpFieldLoadTag
        if slotTid != exactTypeId:
            # [wall90] 字段投影借视形放行: 该形 slot_tid(字段 storage 权威)
            # != exact_tid(借主行权威) 按构造成立, 由 hop 逐跳证明 (下方
            # field-borrow 臂); 其余形 (直定义 ∧ 整值借视) 相等核对逐字
            # 保留, 漂移即判词。
            if !fieldProjectionBorrow:
                # 判词富化 (wall90, wall85 双形态/wall87 六项先例): def/slot 两侧
                # TypeId 实况与各自权威坐标一次入判词 — exact 侧 =
                # transportExactTypeIds[transportRow] (TypedExpr 冻结权威的
                # lowering 投影, 语义行 row); slot 侧 = localSlots[defSlot].
                # typeArenaTypeId (lowering manual-consume 绑定列)。诊断读列
                # 全部界内 (580 行守卫已过 exactTypeId; 563 行守卫已过 defSlot;
                # window 各列 len 逐列复查), 诊断路径零新增越界面。
                let slotTk = bodyIR.localSlots[defSlot].typeKind
                let slotSz = bodyIR.localSlots[defSlot].sizeBytes
                let slotAl = bodyIR.localSlots[defSlot].alignBytes
                let opKind = Int32(op.kind)
                let defOwn = Int32(op.valueDefOwnership)
                let defBod = Int32(op.valueDefBorrowOwnerDefinitionDomain)
                let defBor = op.valueDefBorrowOwnerDefinitionRow
                let defBos = op.valueDefBorrowOwnerSemanticRow
                let defEni = op.valueDefExprNodeIndex
                var exactKind = -1
                var exactScalar = -1
                var exactSz = -1
                var exactAl = -1
                if exactTypeId < window.scalarKinds.len &&
                   exactTypeId < window.sizeBytes.len &&
                   exactTypeId < window.alignBytes.len:
                    exactKind = window.structuralKinds[exactTypeId]
                    exactScalar = window.scalarKinds[exactTypeId]
                    exactSz = window.sizeBytes[exactTypeId]
                    exactAl = window.alignBytes[exactTypeId]
                # [wall148] 判词富化（wall90/wall85/wall87 同文件先例）：函数行
                # + call 坐标（kind=Call 时按 operands[0] 解 callSequence 取
                # target/result_slot）+ slot 总数。诊断读列全部界内：opIndex
                # 为循环变量；defSlot 界内由 563 行守卫保证；callRow 界内显式
                # 守卫后才读列；localSlots[defSlot].name 既有判词已读。
                var diagCallTarget = ""
                var diagCallResultSlot = -1
                if op.kind == coreir.BodyOpCallTag && op.operands.len == 1:
                    let diagCallRow = op.operands[0]
                    if diagCallRow >= 0 &&
                       diagCallRow < bodyIR.callSequence.len:
                        diagCallTarget =
                            bodyIR.callSequence[diagCallRow].targetSymbol
                        diagCallResultSlot =
                            bodyIR.callSequence[diagCallRow].resultSlot
                panic(Fmt"exact def derive: def/slot TypeId drift op={opIndex} slot={defSlot} row={op.valueDefSemanticRow} transport_row={transportRow} origin_kind={originKind} op_kind={opKind} ownership={defOwn} bod={defBod} bor={defBor} bos={defBos} eni={defEni} exact_tid={exactTypeId}:kind={exactKind}:scalar={exactScalar}:sz={exactSz}:al={exactAl} slot_tid={slotTid}:tk={slotTk}:sz={slotSz}:al={slotAl} slot_name={bodyIR.localSlots[defSlot].name} fn_row={bodyIR.controlFunctionRow} diag_call_target={diagCallTarget} diag_call_result_slot={diagCallResultSlot} slots={bodyIR.localSlots.len}")
        if fieldProjectionBorrow &&
           (slotTid < 0 || slotTid >= window.structuralKinds.len):
            panic(Fmt"exact def derive: field projection slot TypeId invalid op={opIndex} slot={defSlot} slot_tid={slotTid}")
        var place = exactdef.BodyIrExactDefPlaceInvalidTag
        var origin: int32 = -1
        var sourceDefOpRow: int32 = -1
        if op.valueDefOwnership == coreir.OwnBorrowShared &&
           op.valueDefBorrowOwnerDefinitionDomain !=
               coreir.BodyDefinitionDomainInvalidTag:
            # borrow-view / field-borrow 臂。
            place = exactdef.BodyIrExactDefPlaceBorrowProjectionTag
            var ownerSlotId: int32
            if op.valueDefBorrowOwnerDefinitionDomain ==
                   coreir.BodyDefinitionDomainBodyOpTag:
                let ownerOp = op.valueDefBorrowOwnerDefinitionRow
                if ownerOp < 0 || ownerOp >= opIndex:
                    panic(Fmt"exact def derive: borrow owner op invalid op={opIndex}")
                ownerSlotId = bodyIR.ops[ownerOp].valueDefSlot
                origin = ownerOp
            elif op.valueDefBorrowOwnerDefinitionDomain ==
                     coreir.BodyDefinitionDomainEntrySlotTag:
                ownerSlotId = op.valueDefBorrowOwnerDefinitionRow
                if ownerSlotId < 0 ||
                   ownerSlotId >= bodyIR.localSlots.len:
                    panic(Fmt"exact def derive: borrow owner entry slot invalid op={opIndex}")
                # 参数借主投影 origin = EntrySlotTag row (借主槽 id,
                # 槽域拼写)。行/槽两域由 op 自身 valueDefBorrowOwner
                # DefinitionDomain 列判别 (BodyOpTag→op 行, EntrySlot
                # Tag→槽 id), 槽 id 不再冒充行号。借主形参是 entry
                # 车道根 (call_authority EntrySlot 终态裁定同款),
                # 体内无定义 op 行 (raw 形, entry 车道独存) 非证据
                # 洞; identity BORROW_PROJECTION 主门参数基座臂按同
                # 列解释槽域 origin 并核终态根+整值借视形+entry 所
                # 有权互证 (wall27 提案; wall25 hunk2 的锚行+hard
                # fail 由判别列统一裁定取代)。
                origin = ownerSlotId
            else:
                panic(Fmt"exact def derive: borrow owner domain invalid op={opIndex}")
            if ownerSlotId < 0 ||
               ownerSlotId >= bodyIR.localSlots.len:
                panic(Fmt"exact def derive: borrow owner slot invalid op={opIndex}")
            if op.kind == coreir.BodyOpFieldLoadTag:
                # field-borrow 臂: 逐跳核对; destination 落字段自身 storage,
                # 由公共规范门落 (C: field_slot 落字段权威, 非 owner 权威)。
                # [wall90] fieldTypeId 实参 = destination 槽冻结 TypeId
                # (字段 storage 权威, 与公共规范门同源, 零派生): 583 契约
                # 对齐的配对改动 — 整值借视残形 (dst 同型) 由 hop 整值臂
                # 放行, 真字段跳命中 layout children (TypeId,offset,width)
                # 精确三元组; 原传借主行类型会把「字段类型」错位成借主
                # 类型, hop 在该形按构造不命中 (v6 op=1 实测定性)。
                if !bodyIrExactDefFieldHopValid(
                       bodyIR, window, opIndex, defSlot, slotTid):
                    # [wall95] 判词富化 (wall90 双形态/wall85 先例): hop
                    # owner 行坐标 + children 表实况 + 期望三元组一次入判
                    # 词。诊断读列全部界内复查: defSlot/slotTid 已由 563/
                    # 636 行守卫过界, op operands 逐列判界, physical 解析
                    # 仅在 hop 同序前置全过 (shape>=8) 后执行, 零新增越
                    # 界面; shape 编码 = bodyIrExactDefFieldHopValid 早退
                    # 序 1:1 镜像 (1 arity/2 op1/3 target/4 base 界外/
                    # 5 offset/6 width/7 width>dst 全宽/8 owner tid 未绑/
                    # 9 children CSR 界/10 三元组未命中)。
                    var hopShape = 10
                    var hopBaseSlot = -1
                    var hopBaseTk = -1
                    var hopBaseSz = -1
                    var hopBaseTid = -1
                    var hopOffset = -1
                    var hopWidth = -1
                    if op.operands.len != 4:
                        hopShape = 1
                    elif op.operands[1] != defSlot:
                        hopShape = 2
                    elif op.target != defSlot:
                        hopShape = 3
                    else:
                        hopBaseSlot = op.operands[0]
                        hopOffset = op.operands[2]
                        hopWidth = op.operands[3]
                        if hopBaseSlot < 0 ||
                           hopBaseSlot >= bodyIR.localSlots.len:
                            hopShape = 4
                        elif hopOffset < 0:
                            hopShape = 5
                        elif hopWidth <= 0:
                            hopShape = 6
                        elif hopWidth >
                                bodyIR.localSlots[defSlot].sizeBytes:
                            hopShape = 7
                        else:
                            hopBaseTk =
                                bodyIR.localSlots[hopBaseSlot].typeKind
                            hopBaseSz =
                                bodyIR.localSlots[hopBaseSlot].sizeBytes
                            hopBaseTid =
                                bodyIR.localSlots[hopBaseSlot].typeArenaTypeId
                            if hopBaseTid < 0:
                                hopShape = 8
                    var hopPhysicalOwner = -1
                    var hopOwnerKind = -1
                    var hopOwnerSz = -1
                    var hopOwnerAl = -1
                    var hopChildStart = -1
                    var hopChildCount = -1
                    var hopFieldPhysical = -1
                    var hopResidualOff0 = 0
                    var hopResidualFull = 0
                    var hopResidualSamePhys = 0
                    var hopChildren = ""
                    if hopShape >= 8 && hopBaseTid >= 0 &&
                       hopBaseTid < window.structuralKinds.len:
                        hopPhysicalOwner = bodyIrExactDefPhysicalTypeId(
                            window, hopBaseTid)
                        hopOwnerKind =
                            window.structuralKinds[hopPhysicalOwner]
                        hopOwnerSz = window.sizeBytes[hopPhysicalOwner]
                        hopOwnerAl = window.alignBytes[hopPhysicalOwner]
                        hopChildStart =
                            window.layoutChildStarts[hopPhysicalOwner]
                        hopChildCount =
                            window.layoutChildCounts[hopPhysicalOwner]
                        hopFieldPhysical = bodyIrExactDefPhysicalTypeId(
                            window, slotTid)
                        if hopOffset == 0:
                            hopResidualOff0 = 1
                        if hopWidth == hopBaseSz:
                            hopResidualFull = 1
                        if hopPhysicalOwner == hopFieldPhysical:
                            hopResidualSamePhys = 1
                        if hopChildStart < 0 || hopChildCount < 0 ||
                           hopChildStart >
                               window.layoutChildTypeIds.len - hopChildCount:
                            hopShape = 9
                        else:
                            hopShape = 10
                            var dumped = 0
                            while dumped < hopChildCount && dumped < 8:
                                let hopChildRow = hopChildStart + dumped
                                hopChildren = Fmt"{hopChildren} {window.layoutChildTypeIds[hopChildRow]}@{window.layoutChildOffsets[hopChildRow]}:{window.layoutChildWidths[hopChildRow]}"
                                dumped = dumped + 1
                    panic(Fmt"exact def derive: field borrow hop invalid op={opIndex} slot={defSlot} fn={bodyIR.controlFunctionRow} shape={hopShape} expect_tid={slotTid} offset={hopOffset} width={hopWidth} dst_name={bodyIR.localSlots[defSlot].name} dst_tk={bodyIR.localSlots[defSlot].typeKind} dst_sz={bodyIR.localSlots[defSlot].sizeBytes} dst_al={bodyIR.localSlots[defSlot].alignBytes} base_slot={hopBaseSlot} base_tk={hopBaseTk} base_sz={hopBaseSz} owner_tid={hopBaseTid} physical={hopPhysicalOwner}:kind={hopOwnerKind}:sz={hopOwnerSz}:al={hopOwnerAl} field_physical={hopFieldPhysical} residual_off0={hopResidualOff0} residual_fullw={hopResidualFull} residual_same_phys={hopResidualSamePhys} children_start={hopChildStart} children_count={hopChildCount} children_csr_len={window.layoutChildTypeIds.len} children=[{hopChildren}]")
            else:
                # borrow-view 臂 (整值借视拷贝): destination 仍 UNKNOWN 且
                # source 已证 authority 非 UNKNOWN → 同值落戳; 已分类 →
                # 幂等核等, 漂移即判词 (cold_parser.c 泛化臂 Cheng 版)。
                var sourceStorage =
                    bodyIR.exactDef.slotStorageKinds[ownerSlotId]
                if sourceStorage == exactdef.BodyIrExactDefStorageUnknownTag:
                    sourceStorage = BodyIrExactDefStorageObligationForSlot(
                        bodyIR, window, ownerSlotId)
                    if sourceStorage ==
                           exactdef.BodyIrExactDefStorageUnknownTag:
                        panic(Fmt"exact def derive: borrow source storage obligation unknown op={opIndex} slot={ownerSlotId}")
                    if !bodyIrExactDefLandSlotStorage(
                           bodyIR, ownerSlotId, sourceStorage, opIndex):
                        return false
                if !bodyIrExactDefLandSlotStorage(
                       bodyIR, defSlot, sourceStorage, opIndex):
                    return false
        elif originKind == bodyIrExactDefOriginParameter:
            place = exactdef.BodyIrExactDefPlaceParamTag
            origin = -1
            for ordinal in 0..<bodyIR.entryParameterSlotIds.len:
                if bodyIR.entryParameterSlotIds[ordinal] == defSlot:
                    origin = ordinal
                    break
            if origin < 0:
                panic(Fmt"exact def derive: parameter definition slot not entry op={opIndex} slot={defSlot}")
        elif originKind == bodyIrExactDefOriginBindingInitializer:
            place = exactdef.BodyIrExactDefPlaceStackLocalTag
            origin = defSlot
            # local-copy 臂: fresh 槽落 source 戳 + source 物理定义边。
            if op.kind == coreir.BodyOpCopyLocalTag:
                if op.operands.len != 1:
                    panic(Fmt"exact def derive: local copy operands invalid op={opIndex}")
                let sourceSlot = op.operands[0]
                if sourceSlot < 0 ||
                   sourceSlot >= bodyIR.localSlots.len:
                    panic(Fmt"exact def derive: local copy source slot invalid op={opIndex}")
                var sourceStorage =
                    bodyIR.exactDef.slotStorageKinds[sourceSlot]
                if sourceStorage ==
                       exactdef.BodyIrExactDefStorageUnknownTag:
                    sourceStorage =
                        BodyIrExactDefStorageObligationForSlot(
                            bodyIR, window, sourceSlot)
                    if sourceStorage ==
                           exactdef.BodyIrExactDefStorageUnknownTag:
                        panic(Fmt"exact def derive: local copy source storage obligation unknown op={opIndex} slot={sourceSlot}")
                    if !bodyIrExactDefLandSlotStorage(
                           bodyIR, sourceSlot, sourceStorage, opIndex):
                        return false
                if !bodyIrExactDefLandSlotStorage(
                       bodyIR, defSlot, sourceStorage, opIndex):
                    return false
                sourceDefOpRow = lastDefOpBySlot[sourceSlot]
        elif originKind == bodyIrExactDefOriginCallResult ||
               originKind == bodyIrExactDefOriginManagedTemporary:
            place = exactdef.BodyIrExactDefPlaceTemporaryTag
            origin = opIndex
        else:
            panic(Fmt"exact def derive: definition origin kind unsupported op={opIndex} kind={originKind}")
        # 公共落戳: storage 规范门 + op/slot 车道。
        let storage = BodyIrExactDefStorageObligationForSlot(
            bodyIR, window, defSlot)
        if storage == exactdef.BodyIrExactDefStorageUnknownTag:
            panic(Fmt"exact def derive: managed definition storage obligation unknown op={opIndex} slot={defSlot}")
        bodyIR.exactDef.opPlaceKinds[opIndex] = place
        bodyIR.exactDef.opExactTypeIds[opIndex] = exactTypeId
        bodyIR.exactDef.opOriginIds[opIndex] = origin
        bodyIR.exactDef.opProducerFunctionRows[opIndex] =
            bodyIR.controlFunctionRow
        bodyIR.exactDef.opSourceDefOpRows[opIndex] = sourceDefOpRow
        if !bodyIrExactDefLandSlotIdentity(
               bodyIR, defSlot, place, origin, storage, opIndex):
            return false
        lastDefOpBySlot[defSlot] = opIndex
    # 相 4: return admission 臂 (批 6, C cold_finish_exact_function_return
    # :73811-73842 判词对应)。逐 RET term: return 槽 storage 非 UNKNOWN
    # 时, 其 parsed_result (C 的返回值当前定义) 的 Cheng 物理证据 = term
    # source 边 (BodyDefinitionDomainBodyOpTag) 或发射序末定义 (term 边
    # 缺时, C parsed 当前态的对应物) 必须持精确 valueDef 戳 — 同槽/四
    # 值 ownership/TypedExpr origin/exactTypeId 一致, 任一项不符 → 判词
    # + false。触发面基板裁定: C 的 PLAIN 升格臂 (:74040-74053) 在
    # Cheng 真空 — OwnPlain 没有 TypedExpr value-def (primary_object_
    # plan.cheng:26250 实证), PLAIN storage return 无戳载体可核; 故本
    # 臂只对托管 storage (STR/SEQUENCE/OBJECT) 与静态道 UNKNOWN 以外
    # 的 storage 门实发, PLAIN/UNKNOWN 直通 (C UNKNOWN 不触发同,
    # :74056)。type= 字段基板替换: C 打 return type 文本, Cheng 打槽名
    # 投影 (批 1 slot_name 先例, 确定性强排投影非身份键)。
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        if term.kind != coreir.BodyTermReturnTag:
            continue
        let returnSlot = term.resultSlot
        if returnSlot < 0:
            # void/nil/常量 RET (C 前段 return_block 已收)。
            continue
        if returnSlot >= bodyIR.localSlots.len:
            panic(Fmt"exact def derive: return slot row invalid term={termIndex}")
        let returnStorage = BodyIrExactDefStorageObligationForSlot(
            bodyIR, window, returnSlot)
        if returnStorage == exactdef.BodyIrExactDefStorageUnknownTag ||
           returnStorage == exactdef.BodyIrExactDefStoragePlainTag:
            continue
        var returnSourceDef = -1
        if term.sourceDefinitionDomain ==
               coreir.BodyDefinitionDomainBodyOpTag:
            returnSourceDef = term.sourceDefinitionRow
        if returnSourceDef < 0 || returnSourceDef >= bodyIR.ops.len:
            returnSourceDef = lastDefOpBySlot[returnSlot]
        var parsed: int32
        var parsedSlot: int32 = -1
        var parsedKind: int32 = -1
        var parsedDef: int32 = -1
        var parsedOwnership: int32 = -1
        var returnValid = false
        if returnSourceDef >= 0 && returnSourceDef < bodyIR.ops.len:
            parsed = 1
            let sourceOp = bodyIR.ops[returnSourceDef]
            parsedSlot = sourceOp.valueDefSlot
            parsedDef = returnSourceDef
            parsedOwnership = Int32(sourceOp.valueDefOwnership)
            if parsedSlot >= 0 && parsedSlot < bodyIR.localSlots.len:
                parsedKind = bodyIR.localSlots[parsedSlot].typeKind
            returnValid = parsedSlot == returnSlot &&
                sourceOp.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginTypedExprTag &&
                (sourceOp.valueDefOwnership == coreir.OwnPlain ||
                 sourceOp.valueDefOwnership == coreir.OwnMove ||
                 sourceOp.valueDefOwnership == coreir.OwnBorrowShared ||
                 sourceOp.valueDefOwnership == coreir.OwnBorrowUnique) &&
                bodyIR.exactDef.opExactTypeIds[returnSourceDef] ==
                    bodyIR.localSlots[returnSlot].typeArenaTypeId
        if !returnValid:
            bodyIrExactDefVerdictEmit(
                Fmt"cheng_cold: managed return body={bodyIR.controlFunctionRow} slot={returnSlot} kind={bodyIR.localSlots[returnSlot].typeKind} type={bodyIR.localSlots[returnSlot].name} parsed={parsed} parsed_slot={parsedSlot} parsed_kind={parsedKind} parsed_def={parsedDef} parsed_ownership={parsedOwnership}")
            # C 次行 die 文本逐字 (cold_parser.c:74086; die 语义在
            # derive 侧为判词+false, 批 1-5 verdict 通道同铭文)。
            bodyIrExactDefVerdictEmit(
                "managed function return lacks exact value definition")
            return false
    # 批 4 锚点落地: merge 定义臂 (规格 §4 九条空间不变量 seal 后
    # 物化 — join 块首连续 merge 定义区间的请求发现/计划/全门/落戳;
    # 本文件的 storage/sentinel helper 为其公共输入, 判词族 die 语义
    # 在 exact_def_merge 内承担)。seal 前执行, 戳随侧车一次落全。
    if !exactdefmerge.ExactDefMergeDeriveArmInto(bodyIR):
        return false
    exactdef.BodyIrExactDefSidecarSealInto(bodyIR)
    return true
