# phi input dominance 详情 fprintf (C 63789-63806 逐字) + die
# `managed phi input definition does not dominate edge`。
@borrows
fn exactDefMergePhiDominanceLine(bodyIR: coreir.BodyIR,
                                 sourceDef: int32,
                                 sourceBlock: int32,
                                 predecessor: int32,
                                 edgeBlock: int32,
                                 sourcePre: int32,
                                 sourcePost: int32,
