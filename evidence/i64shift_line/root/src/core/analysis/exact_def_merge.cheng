# ---- 基元: source 列 / 槽类型 / 戳读取 ----

@borrows
fn exactDefMergeOpSourceDefRow(op: coreir.BodyOp): int32 =
    return freeze.ExactDefFreezeIdentityOpSourceDefRow(op)

@borrows
fn exactDefMergeDefSlotOrInvalid(bodyIR: coreir.BodyIR,
                                 def: int32): int32 =
    if def < 0 || def >= bodyIR.ops.len:
        return -1
    return bodyIR.ops[def].valueDefSlot

@borrows
fn exactDefMergeSlotKindOrInvalid(bodyIR: coreir.BodyIR,
                                  slot: int32): int32 =
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return -1
    return bodyIR.localSlots[slot].typeKind

# ---- 全路径到达证明 (cold_cfg_predecessor_reaches_merge 63970-64050
#      的 Cheng 版, 规格 §2.4: 权威=「每条有限后继路径都到 merge」,
#      三态 DFS 记忆化; BR 单后继/CBR 双后继, 无 SWITCH/pending 边;
#      环、无 term 块、部分后继域均拒。批 4 所有 CFG 证明只用它,
#      不用块序或支配) ----

@borrows
fn exactDefMergeReachesMergeVisit(bodyIR: coreir.BodyIR,
                                  state: var int32[],
                                  stack: var int32[],
                                  head: int32,
                                  mergeBlock: int32): bool =
    var result = true
    while head >= 0 && result:
        let block = stack[head]
        head = head - 1
        if block == mergeBlock:
            continue
        if block < 0 || block >= bodyIR.blocks.len:
            result = false
            break
        if state[block] == 2:
            continue
        if state[block] == 1 || state[block] == 3:
            result = false
            break
        state[block] = 1
        let termIndex = bodyIR.blocks[block].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            state[block] = 3
            result = false
            break
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        if successorCount <= 0 || successorStart < 0 ||
           successorStart > bodyIR.successorBlockIds.len - successorCount:
            state[block] = 3
            result = false
            break
        var blocked = false
        for edge in 0..<successorCount:
            let successor = bodyIR.successorBlockIds[successorStart + edge]
            if successor == mergeBlock:
                continue
            if successor < 0 || successor >= bodyIR.blocks.len:
                blocked = true
                break
            if state[successor] == 2:
                continue
            if state[successor] == 1 || state[successor] == 3:
                blocked = true
                break
            head = head + 1
            stack[head] = successor
        if blocked:
            state[block] = 3
            result = false
            break
        state[block] = 2
    return result

# reaches_merge(predecessor, mergeBlock): 从 predecessor 起每条有限
# 后继路径都到 mergeBlock。state 记忆列由调用方按 mergeBlock 重置。
@borrows
fn exactDefMergeCfgPredecessorReachesMerge(
        bodyIR: coreir.BodyIR,
        state: var int32[],
        predecessor: int32,
        mergeBlock: int32): bool =
    if predecessor < 0 || predecessor >= bodyIR.blocks.len ||
       mergeBlock < 0 || mergeBlock >= bodyIR.blocks.len:
        return false
    if predecessor == mergeBlock:
        return true
    for block in 0..<bodyIR.blocks.len:
        state[block] = 0
    var stack: int32[]
    setLen(stack, bodyIR.blocks.len)
    stack[0] = predecessor
    return exactDefMergeReachesMergeVisit(
        bodyIR, state, stack, 0, mergeBlock)

# ---- BR 边链基元 (规格 §4 九条空间不变量的链式条款) ----

# 块的直接 BR 前驱 (term BR 且 true_block==本块) 计数与枚举。
@borrows
fn exactDefMergeJoinPreds(bodyIR: coreir.BodyIR,
                          joinBlock: int32,
                          preds: var int32[]) =
    for candidate in 0..<bodyIR.blocks.len:
        let termIndex = bodyIR.blocks[candidate].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let term = bodyIR.terms[termIndex]
        if term.kind == coreir.BodyTermBrTag &&
           term.trueBlock == joinBlock:
            add(preds, candidate)

# BR-only 后继单步: 块 term 是 BR 时返回 true_block, 否则 -1。
@borrows
fn exactDefMergeBrStep(bodyIR: coreir.BodyIR, block: int32): int32 =
    if block < 0 || block >= bodyIR.blocks.len:
        return -1
    let termIndex = bodyIR.blocks[block].termIndex
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        return -1
    let term = bodyIR.terms[termIndex]
    if term.kind != coreir.BodyTermBrTag:
        return -1
    return term.trueBlock

# BR-only 链从 fromBlock 到 joinBlock 是否可达 (链内全 BR)。
@borrows
fn exactDefMergeBrChainReaches(bodyIR: coreir.BodyIR,
                               fromBlock: int32,
                               joinBlock: int32): bool =
    var current = fromBlock
    var hops: int32
    while current != joinBlock && current >= 0 &&
          hops <= bodyIR.blocks.len:
        current = exactDefMergeBrStep(bodyIR, current)
        hops = hops + 1
    return current == joinBlock

# 边链链尾块 (op_c 对应块): 从 fromBlock 沿 BR-only 链走, 返回 BR 直接
# 指向 joinBlock 的那一块; 断链 -1 (规格 §6.1 op_c 回收)。
# 单实现在 exact_def_freeze (edge_merge 车同源), 本 fn 为委托别名。
@borrows
fn exactDefMergeChainTail(bodyIR: coreir.BodyIR,
                          fromBlock: int32,
                          joinBlock: int32): int32 =
    return freeze.ExactDefFreezeMergeBrChainTail(
        bodyIR, fromBlock, joinBlock)

# 唯一 BR 前驱 (被封边块的直接前驱, C 的 predecessor+predecessor_term
# 对应物): 恰一个 BR 前驱返回其行, 否则 -1。
@borrows
fn exactDefMergeSoleBrPredecessor(bodyIR: coreir.BodyIR,
                                  block: int32): int32 =
    var found: int32 = -1
    for candidate in 0..<bodyIR.blocks.len:
        let termIndex = bodyIR.blocks[candidate].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let term = bodyIR.terms[termIndex]
        if term.kind == coreir.BodyTermBrTag &&
           term.trueBlock == block:
            if found >= 0:
                return -1
            found = candidate
    return found

# ---- global shadow 同定义证明 (规格 §5 首红样例转绿条款 + §2.1
#      is_global 分支: origin 相等 + place GLOBAL + op GlobalLoad
#      (GLOBAL_ADDR 的 Cheng 对应物) + own BORROW_SHARED) ----

@borrows
fn exactDefMergeIsGlobalAddrShadow(bodyIR: coreir.BodyIR,
                                   def: int32): bool =
    if def < 0 || def >= bodyIR.ops.len:
        return false
    return bodyIR.ops[def].kind == coreir.BodyOpGlobalLoadTag &&
           bodyIR.exactDef.opPlaceKinds[def] ==
               exactdef.BodyIrExactDefPlaceGlobalTag &&
           bodyIR.ops[def].valueDefOwnership == coreir.OwnBorrowShared

@borrows
fn exactDefMergeSameGlobalShadow(bodyIR: coreir.BodyIR,
                                 firstDef: int32,
                                 secondDef: int32): bool =
    if firstDef == secondDef:
        return false
    if !exactDefMergeIsGlobalAddrShadow(bodyIR, firstDef) ||
       !exactDefMergeIsGlobalAddrShadow(bodyIR, secondDef):
        return false
    let firstOrigin = bodyIR.exactDef.opOriginIds[firstDef]
    return firstOrigin >= 0 &&
           firstOrigin == bodyIR.exactDef.opOriginIds[secondDef]

# ---- 点活性 lattice (规格 §7-4 blockEndStates 对应列; 值域: op 行 /
#      EntryDef(-4) / Consumed(-1) / Ambiguous(-2) / Unreached(-3)) ----

@borrows
fn exactDefMergeLatticeMergeState(bodyIR: coreir.BodyIR,
                                  current: var int32,
                                  incoming: int32) =
    if current == ExactDefMergeStateUnreached:
        current = incoming
        return
    if incoming == ExactDefMergeStateUnreached ||
       current == incoming:
        return
    if current >= 0 && incoming >= 0 &&
       exactDefMergeSameGlobalShadow(bodyIR, current, incoming):
        # is_global 同 GlobalDef 行通道 (规格 §2.1 86371-86445): 双
        # GLOBAL_ADDR remat 同 origin 证同定义, 汇合不收 Ambiguous
        # (首红样例形态在 lattice 层的转绿对应物)。
        if incoming < current:
            current = incoming
        return
    current = ExactDefMergeStateAmbiguous

fn exactDefMergeLatticeBuild(bodyIR: var coreir.BodyIR,
                             workspace: var ExactDefMergeWorkspace) =
    let blockCount = bodyIR.blocks.len
    let slotCount = bodyIR.localSlots.len
    setLen(workspace.opBlockIds, bodyIR.ops.len)
    for op in 0..<bodyIR.ops.len:
        workspace.opBlockIds[op] = -1
    for block in 0..<blockCount:
        let start = bodyIR.blocks[block].opStart
        let count = bodyIR.blocks[block].opCount
        if start < 0 || count < 0 || start > bodyIR.ops.len - count:
            panic("exact def merge: block op range invalid")
        for op in start..<start + count:
            if workspace.opBlockIds[op] >= 0:
                panic("exact def merge: op block partition drift")
            workspace.opBlockIds[op] = block
    for op in 0..<bodyIR.ops.len:
        if workspace.opBlockIds[op] < 0:
            panic("exact def merge: op block partition drift")
    setLen(workspace.blockReached, blockCount)
    setLen(workspace.blockEndStates, blockCount * slotCount)
    for row in 0..<blockCount * slotCount:
        workspace.blockEndStates[row] = ExactDefMergeStateUnreached
    if blockCount <= 0:
        return
    # 前向可达 (CSR 后继)。
    var reachQueue: int32[]
    setLen(reachQueue, blockCount)
    var reachHead: int32
    var reachTail: int32 = 1
    workspace.blockReached[0] = true
    reachQueue[0] = 0
    while reachHead < reachTail:
        let block = reachQueue[reachHead]
        reachHead = reachHead + 1
        let termIndex = bodyIR.blocks[block].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        if successorCount <= 0:
            continue
        for edge in 0..<successorCount:
            let successor =
                bodyIR.successorBlockIds[successorStart + edge]
            if successor < 0 || successor >= blockCount ||
               workspace.blockReached[successor]:
                continue
            workspace.blockReached[successor] = true
            reachQueue[reachTail] = successor
            reachTail = reachTail + 1
    # 块 0 入态: entry ownership 权威 → EntryDef, 否则 Consumed
    # (bodyIrAccessCfgIncomingState 同构, 规格 §7-4 blockEndStates 行)。
    var states: int32[]
    setLen(states, slotCount)
    for slot in 0..<slotCount:
        var entry = ExactDefMergeStateConsumed
        if bodyIR.entryDefinitionOwnershipSealed &&
           slot < bodyIR.entryDefinitionOwnershipKinds.len &&
           bodyIR.entryDefinitionOwnershipKinds[slot] !=
               Int32(coreir.OwnInvalid):
            entry = ExactDefMergeStateEntryDef
        workspace.blockEndStates[slot] = entry
    # 块 0 自身 gen (末定义覆盖) 先行落一次。
    if slotCount > 0:
        let opStart0 = bodyIR.blocks[0].opStart
        let opCount0 = bodyIR.blocks[0].opCount
        for op in opStart0..<opStart0 + opCount0:
            let defSlot = bodyIR.ops[op].valueDefSlot
            if defSlot >= 0 && defSlot < slotCount &&
               bodyIR.ops[op].valueDefOwnership != coreir.OwnInvalid:
                workspace.blockEndStates[defSlot] = op
    # 前驱 CSR 一次成型 (后继列的倒排)。
    var predOffsets: int32[]
    setLen(predOffsets, blockCount + 1)
    for block in 0..<blockCount:
        let termIndex = bodyIR.blocks[block].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        for edge in 0..<successorCount:
            let successor =
                bodyIR.successorBlockIds[successorStart + edge]
            if successor >= 0 && successor < blockCount:
                predOffsets[successor + 1] = predOffsets[successor + 1] + 1
    for block in 0..<blockCount:
        predOffsets[block + 1] = predOffsets[block + 1] + predOffsets[block]
    var predecessors: int32[]
    setLen(predecessors, predOffsets[blockCount])
    var predCursor: int32[]
    setLen(predCursor, blockCount)
    for block in 0..<blockCount:
        let termIndex = bodyIR.blocks[block].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        for edge in 0..<successorCount:
            let successor =
                bodyIR.successorBlockIds[successorStart + edge]
            if successor >= 0 && successor < blockCount:
                predecessors[predOffsets[successor] + predCursor[successor]] = block
                predCursor[successor] = predCursor[successor] + 1
    # 不动点工作列表: 入态=前驱出态汇合, 块内末定义 (gen) 覆盖;
    # global shadow 通道在 mergeState 内。容量 5B+1 (批 2 同阈值纪律)。
    var workQueue: int32[]
    setLen(workQueue, blockCount * 5 + 1)
    var workQueued: bool[]
    setLen(workQueued, blockCount)
    var head: int32
    var tail: int32
    for block in 1..<blockCount:
        if workspace.blockReached[block]:
            workQueue[tail] = block
            tail = tail + 1
            workQueued[block] = true
    while head < tail:
        let block = workQueue[head]
        head = head + 1
        workQueued[block] = false
        let predStart = predOffsets[block]
        let predEnd = predOffsets[block + 1]
        if predEnd <= predStart:
            continue
        for slot in 0..<slotCount:
            states[slot] = ExactDefMergeStateUnreached
        for edge in predStart..<predEnd:
            let predecessor = predecessors[edge]
            let predRowStart = predecessor * slotCount
            for slot in 0..<slotCount:
                exactDefMergeLatticeMergeState(
                    bodyIR, states[slot],
                    workspace.blockEndStates[predRowStart + slot])
        var changed = false
        let rowStart = block * slotCount
        let opStart = bodyIR.blocks[block].opStart
        let opCount = bodyIR.blocks[block].opCount
        for slot in 0..<slotCount:
            var value = states[slot]
            for op in opStart..<opStart + opCount:
                if bodyIR.ops[op].valueDefSlot == slot &&
                   bodyIR.ops[op].valueDefOwnership !=
                       coreir.OwnInvalid:
                    value = op
            if workspace.blockEndStates[rowStart + slot] != value:
                workspace.blockEndStates[rowStart + slot] = value
                changed = true
        if changed:
            let termIndex = bodyIR.blocks[block].termIndex
            if termIndex >= 0 && termIndex < bodyIR.terms.len:
                let successorStart =
                    bodyIR.termSuccessorStarts[termIndex]
                let successorCount =
                    bodyIR.termSuccessorCounts[termIndex]
                for edge in 0..<successorCount:
                    let successor =
                        bodyIR.successorBlockIds[successorStart + edge]
                    if successor > 0 && successor < blockCount &&
                       !workQueued[successor]:
                        if tail >= workQueue.len:
                            exactDefMergeDie(
                                "exact definition work queue size overflow")
                        workQueued[successor] = true
                        workQueue[tail] = successor
                        tail = tail + 1

# 块入态 (双前驱 blockEndStates 汇合, 规格 §4 请求身份对应位)。
@borrows
fn exactDefMergeBlockEntryState(bodyIR: coreir.BodyIR,
                                workspace: ExactDefMergeWorkspace,
                                block: int32,
                                slot: int32): int32 =
    let slotCount = bodyIR.localSlots.len
    var state = ExactDefMergeStateUnreached
    for predecessor in 0..<bodyIR.blocks.len:
        if predecessor == block:
            continue
        let termIndex = bodyIR.blocks[predecessor].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            continue
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        var isPred = false
        for edge in 0..<successorCount:
            if bodyIR.successorBlockIds[successorStart + edge] == block:
                isPred = true
                break
        if !isPred:
            continue
        exactDefMergeLatticeMergeState(
            bodyIR, state,
            workspace.blockEndStates[predecessor * slotCount + slot])
    return state

# ---- ref 值 normalize 双臂 (规格 §1.2 64229-64254; Cheng 基板:
#      C 的 SLOT_*_REF kind 集在 Cheng typeKind 域无对应, ref↔value 配对
#      走 typeFact: ref 臂 = 物理 type structural RefObject, 其 childTypeId
#      链 == value 臂物理 type; 其余 ref 形 (str/seq ref) 在 Cheng 无
#      structural 载体 → 不证 (严格方向)) ----

@borrows
fn exactDefMergeSlotIsManagedRef(bodyIR: coreir.BodyIR,
                                 slot: int32): bool =
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return false
    let typeId = bodyIR.localSlots[slot].typeArenaTypeId
    if typeId < 0:
        return false
    return freeze.ExactDefFreezeTypeFactStructuralKind(bodyIR, typeId) ==
               Int32(typearena.TypedExprStructuralTypeRefObject)

# cold_parser_exact_managed_ref_value_type_matches 的 Cheng 版:
# ref 槽物理 type 的 child == value 槽物理 type (逐跳证明, 禁摊平)。
@borrows
fn exactDefMergeRefValueTypeMatches(bodyIR: coreir.BodyIR,
                                    refSlot: int32,
                                    valueSlot: int32): bool =
    if refSlot < 0 || refSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    let refType = bodyIR.localSlots[refSlot].typeArenaTypeId
    let valueType = bodyIR.localSlots[valueSlot].typeArenaTypeId
    if refType < 0 || valueType < 0:
        return false
    let refPhysical = freeze.ExactDefFreezePhysicalTypeId(bodyIR, refType)
    let valuePhysical =
        freeze.ExactDefFreezePhysicalTypeId(bodyIR, valueType)
    if refPhysical < 0 || valuePhysical < 0:
        return false
    let refRow = coreir.BodyIRCanonicalTypeFactRow(bodyIR, refPhysical)
    if refRow < 0:
        return false
    if bodyIR.typeFactStructuralKinds[refRow] !=
           Int32(typearena.TypedExprStructuralTypeRefObject):
        return false
    return bodyIR.typeFactChildTypeIds[refRow] == valuePhysical

# ---- transfer ownership (规格 §1.3, C 63613-63669 逐条;
#      独立 PLAIN 拷贝且源非借用 → PLAIN; MOVE→MOVE; BU→preserve?BU:BS;
#      BS→preserve?die:BS; PLAIN 非独立且 kind 非 Object → die, 否则
#      independent?PLAIN:MOVE) ----

@borrows
fn exactDefMergeTransferOwnership(bodyIR: coreir.BodyIR,
                                  sourceDef: int32,
                                  sourceOwnership: int32,
                                  preserveUniqueBorrow: bool): int32 =
    if sourceDef < 0 || sourceDef >= bodyIR.ops.len:
        exactDefMergeDie(
            "managed phi transfer ownership lacks exact source identity")
    let sourceSlot = bodyIR.ops[sourceDef].valueDefSlot
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        exactDefMergeDie("managed phi transfer source slot is invalid")
    let storage = bodyIR.exactDef.slotStorageKinds[sourceSlot]
    if storage == exactdef.BodyIrExactDefStorageUnknownTag:
        exactDefMergeDie(
            "managed phi transfer storage authority is unknown")
    var independentPlainCopy = false
    if storage == exactdef.BodyIrExactDefStoragePlainTag:
        independentPlainCopy =
            freeze.ExactDefFreezePlainValueCopyIndependent(
                bodyIR, sourceSlot)
    # 借用源豁免 (C 63634-63645): preserve/shared 计划要求借用输入;
    # 混合 merge 经 SHARED_COPY lift 道, 不在此臂。
    if independentPlainCopy &&
       sourceOwnership != Int32(coreir.OwnBorrowShared) &&
       sourceOwnership != Int32(coreir.OwnBorrowUnique):
        return Int32(coreir.OwnPlain)
    if sourceOwnership == Int32(coreir.OwnMove):
        return Int32(coreir.OwnMove)
    if sourceOwnership == Int32(coreir.OwnBorrowUnique):
        if preserveUniqueBorrow:
            return Int32(coreir.OwnBorrowUnique)
        return Int32(coreir.OwnBorrowShared)
    if sourceOwnership == Int32(coreir.OwnBorrowShared):
        if preserveUniqueBorrow:
            exactDefMergeDie(
                "managed phi unique transfer source is shared")
        return Int32(coreir.OwnBorrowShared)
    if sourceOwnership != Int32(coreir.OwnPlain):
        exactDefMergeDie(
            "managed phi transfer source ownership is invalid")
    if storage == exactdef.BodyIrExactDefStoragePlainTag &&
       !independentPlainCopy &&
       freeze.ExactDefFreezeTypeFactStructuralKind(
           bodyIR, bodyIR.localSlots[sourceSlot].typeArenaTypeId) !=
           Int32(typearena.TypedExprStructuralTypeObject):
        exactDefMergeDie(
            "managed phi plain transfer source kind is invalid")
    if independentPlainCopy:
        return Int32(coreir.OwnPlain)
    return Int32(coreir.OwnMove)

# ---- phi_global_root (C 63558-63611 逐条; 借用 def 链 — 边 spill
#      拷贝与 CFG merge — 最终落到同一 PLACE_GLOBAL GlobalLoad 时返回
#      其 origin (GlobalDef 行), 任一输入非 global 根 → -1;
#      工作栈 ≤64 同阈值) ----

@borrows
fn exactDefMergePhiGlobalRoot(bodyIR: coreir.BodyIR,
                              def: int32): int32 =
    if def < 0 || def >= bodyIR.ops.len:
        return -1
    var stack: int32[]
    setLen(stack, 64)
    var count: int32
    var root: int32 = -1
    stack[0] = def
    count = 1
    while count > 0:
        count = count - 1
        let current = stack[count]
        if current < 0 || current >= bodyIR.ops.len:
            return -1
        let ownership = bodyIR.ops[current].valueDefOwnership
        if ownership != coreir.OwnBorrowShared &&
           ownership != coreir.OwnBorrowUnique:
            return -1
        if bodyIR.ops[current].kind == coreir.BodyOpGlobalLoadTag &&
           bodyIR.exactDef.opPlaceKinds[current] ==
               exactdef.BodyIrExactDefPlaceGlobalTag:
            let candidate = bodyIR.exactDef.opOriginIds[current]
            if candidate < 0:
                return -1
            if root < 0:
                root = candidate
            elif root != candidate:
                return -1
            continue
        if bodyIR.exactDef.opPlaceKinds[current] ==
               exactdef.BodyIrExactDefPlaceCfgMergeTag:
            let first = exactDefMergeOpSourceDefRow(bodyIR.ops[current])
            let second =
                freeze.ExactDefFreezeMergeSecondInputRowForMerge(
                    bodyIR, current)
            if first < 0 || second < 0 || count + 2 > 64:
                return -1
            stack[count] = first
            count = count + 1
            stack[count] = second
            count = count + 1
            continue
        if bodyIR.ops[current].kind == coreir.BodyOpCopyLocalTag &&
           bodyIR.exactDef.opPlaceKinds[current] ==
               exactdef.BodyIrExactDefPlaceStackLocalTag:
            let source = exactDefMergeOpSourceDefRow(bodyIR.ops[current])
            if source < 0 || count + 1 > 64:
                return -1
            stack[count] = source
            count = count + 1
            continue
        return -1
    return root

# ---- merge 候选行形状 (规格 §4 空间不变量 1/2/3 的结构面) ----

# staging 槽的定义行集 (恰两条边拷贝是 merge 形的必要条件)。
@borrows
fn exactDefMergeStagingDefs(bodyIR: coreir.BodyIR,
                            staging: int32,
                            defs: var int32[]) =
    for op in 0..<bodyIR.ops.len:
        if bodyIR.ops[op].valueDefSlot == staging &&
           bodyIR.ops[op].valueDefOwnership != coreir.OwnInvalid:
            add(defs, op)

# 候选判定: join 块内一行是 merge 定义候选 = CopyLocal 单源 + dst
# 在界 + staging 槽在界 + staging 恰两条定义 (双输入), 双输入都是
# CopyLocal 且各自边块 BR-only 链到 join、两块不同。input copy 块
# 末行不变量在批内校验 (判词 `edge staging failed` 的落点)。
@borrows
fn exactDefMergeRowCandidateShape(bodyIR: coreir.BodyIR,
                                  workspace: ExactDefMergeWorkspace,
                                  joinBlock: int32,
                                  opRow: int32): bool =
    let op = bodyIR.ops[opRow]
    if op.kind != coreir.BodyOpCopyLocalTag || op.operands.len != 1:
        return false
    let destination = op.valueDefSlot
    if destination < 0 || destination >= bodyIR.localSlots.len ||
       op.target != destination:
        return false
    let staging = op.operands[0]
    if staging < 0 || staging >= bodyIR.localSlots.len:
        return false
    var defs: int32[]
    exactDefMergeStagingDefs(bodyIR, staging, defs)
    if defs.len != 2:
        return false
    for index in 0..<2:
        let input = defs[index]
        let inputOp = bodyIR.ops[input]
        if inputOp.kind != coreir.BodyOpCopyLocalTag ||
           inputOp.operands.len != 1:
            return false
        let inputBlock = workspace.opBlockIds[input]
        if inputBlock < 0:
            return false
        if !exactDefMergeBrChainReaches(bodyIR, inputBlock, joinBlock):
            return false
    return workspace.opBlockIds[defs[0]] !=
               workspace.opBlockIds[defs[1]]

# ---- 原始臂定义回收 (规格 §1.2 请求 first/second_def 的 Cheng 来源:
#      输入拷贝的结构 source 是臂定义本身 (普通形) 或边内替代
#      (remat/normalize/lift); 替代形沿其权威列回到臂定义) ----

@borrows
fn exactDefMergeOriginalDefForInput(
        bodyIR: coreir.BodyIR,
        workspace: ExactDefMergeWorkspace,
        originalPred: int32,
        inputSourceDef: int32): int32 =
    if inputSourceDef < 0 || inputSourceDef >= bodyIR.ops.len ||
       originalPred < 0 || originalPred >= bodyIR.blocks.len:
        return inputSourceDef
    let sourceBlock = workspace.opBlockIds[inputSourceDef]
    if sourceBlock < 0 || sourceBlock == originalPred:
        return inputSourceDef
    # 源块是否在原始前驱的 BR-only 出链上 (原始前驱 → ... → 源块)。
    var onChain = false
    var cursor = exactDefMergeBrStep(bodyIR, originalPred)
    var hops: int32
    while cursor >= 0 && hops <= bodyIR.blocks.len:
        if cursor == sourceBlock:
            onChain = true
            break
        cursor = exactDefMergeBrStep(bodyIR, cursor)
        hops = hops + 1
    if !onChain:
        return inputSourceDef
    # remat 形 (规格 §1.3 63568-63648): GlobalLoad+GLOBAL → 原始臂定义
    # 是原始前驱末端同 global 影子的定义 (origin 相等)。
    if bodyIR.ops[inputSourceDef].kind == coreir.BodyOpGlobalLoadTag &&
       bodyIR.exactDef.opPlaceKinds[inputSourceDef] ==
           exactdef.BodyIrExactDefPlaceGlobalTag:
        let slotCount = bodyIR.localSlots.len
        for slot in 0..<slotCount:
            let candidate =
                workspace.blockEndStates[
                    originalPred * slotCount + slot]
            if candidate >= 0 &&
               exactDefMergeSameGlobalShadow(
                   bodyIR, candidate, inputSourceDef):
                return candidate
        return inputSourceDef
    # lift 形 (规格 §1.3 63675-63702): SHARED_COPY retain 行 → 其
    # origin 即借用源定义 (C 63186-63189 同列); normalize+lift 链时
    # origin 是值借用, 再沿其 borrow owner 回到原始 ref 定义。
    if bodyIR.exactDef.opPlaceKinds[inputSourceDef] ==
           exactdef.BodyIrExactDefPlaceSharedCopyTag:
        let origin = bodyIR.exactDef.opOriginIds[inputSourceDef]
        if origin >= 0 && origin < bodyIR.ops.len:
            let originOp = bodyIR.ops[origin]
            if originOp.valueDefOwnership == coreir.OwnBorrowShared &&
               originOp.valueDefBorrowOwnerDefinitionDomain ==
                   coreir.BodyDefinitionDomainBodyOpTag:
                let owner = originOp.valueDefBorrowOwnerDefinitionRow
                if owner >= 0 && owner < bodyIR.ops.len &&
                   exactDefMergeSlotIsManagedRef(
                       bodyIR, bodyIR.ops[owner].valueDefSlot):
                    return owner
            return origin
        return inputSourceDef
    # normalize 形 (规格 §1.3 63649-63674): 值借用源 → 其 borrow owner
    # 即原始 ref 定义 (冻结三列, 规格 §3)。
    if bodyIR.ops[inputSourceDef].valueDefOwnership ==
           coreir.OwnBorrowShared &&
       bodyIR.ops[inputSourceDef].valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        let owner =
            bodyIR.ops[inputSourceDef].valueDefBorrowOwnerDefinitionRow
        if owner >= 0 && owner < bodyIR.ops.len:
            return owner
    return inputSourceDef

# 原始前驱回收: 从输入边块沿唯一 BR 前驱回走, 穿过本 join 全部边块
# (其末行是本 join 某 staging 槽输入拷贝的块), 首个非边块即原始前驱。
@borrows
fn exactDefMergeOriginalPredecessor(
        bodyIR: coreir.BodyIR,
        stagingSlots: int32[],
        inputBlock: int32): int32 =
    var current = inputBlock
    var hops: int32
    while hops <= bodyIR.blocks.len:
        let predecessor = exactDefMergeSoleBrPredecessor(bodyIR, current)
        if predecessor < 0:
            return -1
        let opStart = bodyIR.blocks[predecessor].opStart
        let opCount = bodyIR.blocks[predecessor].opCount
        var isEdgeBlock = false
        if opCount > 0:
            let lastOp = bodyIR.ops[opStart + opCount - 1]
            if lastOp.kind == coreir.BodyOpCopyLocalTag:
                for index in 0..<stagingSlots.len:
                    if lastOp.valueDefSlot == stagingSlots[index]:
                        isEdgeBlock = true
                        break
        if !isEdgeBlock:
            return predecessor
        current = predecessor
        hops = hops + 1
    return -1

# borrow 根相等 (规格 §3: 冻结 valueDefBorrowOwner 三列逐值相等,
# 不重走; 仅 BU 臂取根, C 64366-64378 同条件)。
@borrows
fn exactDefMergeBorrowOwnerRootValid(op: coreir.BodyOp): bool =
    if op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        return op.valueDefBorrowOwnerDefinitionRow >= 0
    if op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        return op.valueDefBorrowOwnerDefinitionRow >= 0
    return false

@borrows
fn exactDefMergeBorrowRootsIdentical(firstOp: coreir.BodyOp,
                                     secondOp: coreir.BodyOp): bool =
    if !exactDefMergeBorrowOwnerRootValid(firstOp) ||
       !exactDefMergeBorrowOwnerRootValid(secondOp):
        return false
    return firstOp.valueDefBorrowOwnerSemanticRow ==
               secondOp.valueDefBorrowOwnerSemanticRow &&
           firstOp.valueDefBorrowOwnerDefinitionDomain ==
               secondOp.valueDefBorrowOwnerDefinitionDomain &&
           firstOp.valueDefBorrowOwnerDefinitionRow ==
               secondOp.valueDefBorrowOwnerDefinitionRow

# ---- 逐输入边校验 (规格 §1.3 phi input 全门; 返回最终 edge ownership,
#      失败按族 die) ----

@borrows
fn exactDefMergeEdgeInputValidate(
        bodyIR: coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: ExactDefMergeWorkspace,
        mergeRow: int32,
        input: int32,
        inputBlock: int32,
        originalPred: int32,
        originalDef: int32,
        staging: int32,
        normalizeRefValue: bool,
        liftBorrowed: bool,
        preserveUniqueBorrow: bool,
        mergeOwnership: int32): int32 =
    let inputOp = bodyIR.ops[input]
    let sourceDef = exactDefMergeOpSourceDefRow(inputOp)
    let originalOwnership = Int32(bodyIR.ops[originalDef].valueDefOwnership)
    let originalSlot = bodyIR.ops[originalDef].valueDefSlot
    let originalBorrowed =
        originalOwnership == Int32(coreir.OwnBorrowShared) ||
        originalOwnership == Int32(coreir.OwnBorrowUnique)
    # normalize 复检 (C 63725-63735): ref 臂借用且 ref↔value 类型按规则
    # 匹配时, 边上退化为值借用。
    let exactRefValueNormalization =
        normalizeRefValue && originalBorrowed &&
        exactDefMergeRefValueTypeMatches(bodyIR, originalSlot, staging)
    # 门 3 (C 63733-63750): 源槽越界 / (非 normalize 时 kind/size 不等) /
    # exact_type<0 / producer 不符 / own 非四值 / lift 而源非借用 /
    # preserve 而 (lift || own!=BU) → incompatible。
    let sourceSlot = exactDefMergeDefSlotOrInvalid(bodyIR, sourceDef)
    var tupleValid = sourceDef >= 0 && sourceDef < input &&
        sourceSlot >= 0 && sourceSlot < bodyIR.localSlots.len
    if tupleValid && (!normalizeRefValue || !exactRefValueNormalization):
        tupleValid = bodyIR.localSlots[sourceSlot].typeKind ==
                bodyIR.localSlots[staging].typeKind &&
            bodyIR.localSlots[sourceSlot].sizeBytes ==
                bodyIR.localSlots[staging].sizeBytes
    if tupleValid:
        tupleValid =
            bodyIR.exactDef.opExactTypeIds[sourceDef] >= 0 &&
            bodyIR.exactDef.opProducerFunctionRows[sourceDef] ==
                bodyIR.controlFunctionRow
    if tupleValid:
        let sourceOwnership =
            Int32(bodyIR.ops[sourceDef].valueDefOwnership)
        tupleValid =
            (sourceOwnership == Int32(coreir.OwnMove) ||
             sourceOwnership == Int32(coreir.OwnPlain) ||
             sourceOwnership == Int32(coreir.OwnBorrowShared) ||
             sourceOwnership == Int32(coreir.OwnBorrowUnique)) &&
            (!liftBorrowed || originalBorrowed) &&
            (!preserveUniqueBorrow ||
             (!liftBorrowed &&
              originalOwnership == Int32(coreir.OwnBorrowUnique)))
    if !tupleValid:
        exactDefMergeDie("managed phi input definition is incompatible")
    # 物理源精确 (C 63908-63913): 源定义行定义的就是拷贝的源槽。
    if bodyIR.ops[sourceDef].valueDefSlot != inputOp.operands[0]:
        exactDefMergeDie(
            "managed phi input physical source is not exact")
    var edgeOwnership: int32
    if normalizeRefValue:
        # normalize 臂 (C 63846-63871): 输入源必须是值借用 — 借用、
        # kind==staging kind、exact type==staging 头戳、own==BS, 且其
        # borrow owner 即原始 ref 定义 (冻结三列, 规格 §3)。
        let sourceOp = bodyIR.ops[sourceDef]
        let sourceOwnership = Int32(sourceOp.valueDefOwnership)
        let normalizeIdentityValid =
            sourceOwnership == Int32(coreir.OwnBorrowShared) &&
            bodyIR.localSlots[sourceSlot].typeKind ==
                bodyIR.localSlots[staging].typeKind &&
            bodyIR.localSlots[sourceSlot].typeArenaTypeId ==
                bodyIR.localSlots[staging].typeArenaTypeId &&
            bodyIR.exactDef.opExactTypeIds[sourceDef] ==
                bodyIR.localSlots[staging].typeArenaTypeId
        if !normalizeIdentityValid:
            exactDefMergeDie(
                "managed phi ref/value normalization identity drifted")
        if sourceOp.valueDefBorrowOwnerDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           sourceOp.valueDefBorrowOwnerDefinitionRow != originalDef:
            exactDefMergeDie(
                "managed phi ref/value normalization source is invalid")
        edgeOwnership = Int32(coreir.OwnBorrowShared)
    elif liftBorrowed:
        # lift 臂 (C 63872-63899): 输入源是边上的 retain 拷贝
        # (SHARED_COPY place), 提升拷贝 move 进 merge; PLAIN 提升无
        # ORC, own=PLAIN; retain 行的 origin 即被提升的借用源
        # (lift-only: 原始臂定义; normalize+lift: 值借用, owner 即
        # 原始 ref 定义)。全字段核对在登记表 (规格 §1.4 lift 表门)。
        let sourceOwnership = Int32(bodyIR.ops[sourceDef].valueDefOwnership)
        if bodyIR.exactDef.opPlaceKinds[sourceDef] !=
               exactdef.BodyIrExactDefPlaceSharedCopyTag ||
           (sourceOwnership != Int32(coreir.OwnMove) &&
            sourceOwnership != Int32(coreir.OwnPlain)):
            exactDefMergeDie(
                "managed phi input definition is incompatible")
        let sharedOrigin = bodyIR.exactDef.opOriginIds[sourceDef]
        var liftOriginValid = sharedOrigin == originalDef
        if !liftOriginValid && sharedOrigin >= 0 &&
           sharedOrigin < bodyIR.ops.len:
            let sharedOriginOp = bodyIR.ops[sharedOrigin]
            liftOriginValid =
                sharedOriginOp.valueDefOwnership ==
                    coreir.OwnBorrowShared &&
                sharedOriginOp.valueDefBorrowOwnerDefinitionDomain ==
                    coreir.BodyDefinitionDomainBodyOpTag &&
                sharedOriginOp.valueDefBorrowOwnerDefinitionRow ==
                    originalDef
        if !liftOriginValid:
            exactDefMergeDie(
                "managed phi input definition is incompatible")
        edgeOwnership = sourceOwnership
    else:
        # global remat / dominance (C 63759-63844): 对原始臂定义判定 —
        # GlobalLoad+GLOBAL → 边上 remat (输入源必须是 remat 行,
        # origin 相同且戳镜像源定义); 否则对被封原始前驱查支配,
        # 不支配则退 phi_global_root, 再不成 → 详情 fprintf + die;
        # global 根非支配源同样要求边内 remat 行 (C 的最终形必含之)。
        if bodyIR.ops[originalDef].kind == coreir.BodyOpGlobalLoadTag &&
           bodyIR.exactDef.opPlaceKinds[originalDef] ==
               exactdef.BodyIrExactDefPlaceGlobalTag:
            let rematOrigin = bodyIR.exactDef.opOriginIds[originalDef]
            if rematOrigin < 0 ||
               !exactDefMergeIsGlobalAddrShadow(bodyIR, sourceDef) ||
               bodyIR.exactDef.opOriginIds[sourceDef] != rematOrigin:
                exactDefMergeDie(
                    "managed phi input global rematerialization is invalid")
            if Int32(bodyIR.ops[sourceDef].valueDefOwnership) !=
                   originalOwnership ||
               bodyIR.exactDef.opExactTypeIds[sourceDef] !=
                   bodyIR.exactDef.opExactTypeIds[originalDef]:
                exactDefMergeDie(
                    "managed phi input definition is incompatible")
        elif !freeze.ExactDefFreezeMergeOpDominatesPredecessor(
                bodyIR, dom, workspace.opBlockIds, originalDef,
                originalPred):
            let globalRoot = exactDefMergePhiGlobalRoot(
                bodyIR, originalDef)
            let sourceBlock = workspace.opBlockIds[sourceDef]
            if globalRoot < 0 ||
               !exactDefMergeIsGlobalAddrShadow(bodyIR, sourceDef) ||
               bodyIR.exactDef.opOriginIds[sourceDef] != globalRoot:
                let originalBlock = workspace.opBlockIds[originalDef]
                var sourcePre: int32 = -1
                var sourcePost: int32 = -1
                var predPre: int32 = -1
                var predPost: int32 = -1
                if originalBlock >= 0:
                    sourcePre = dom.preorder[originalBlock]
                    sourcePost = dom.postorder[originalBlock]
                if originalPred >= 0 &&
                   originalPred < bodyIR.blocks.len:
                    predPre = dom.preorder[originalPred]
                    predPost = dom.postorder[originalPred]
                exactDefMergeVerdictEmit(
                    exactDefMergePhiDominanceLine(
                        bodyIR, originalDef, originalBlock,
                        originalPred, inputBlock, sourcePre, sourcePost,
                        predPre, predPost))
                exactDefMergeDie(
                    "managed phi input definition does not dominate edge")
        edgeOwnership = exactDefMergeTransferOwnership(
            bodyIR, originalDef, originalOwnership, preserveUniqueBorrow)
    # merge_ownership==PLAIN 时双输入 own 强制 PLAIN (C 64518-64529)。
    if mergeOwnership == Int32(coreir.OwnPlain):
        edgeOwnership = Int32(coreir.OwnPlain)
    return edgeOwnership

# ---- borrowed 登记表 (规格 §1.4; 单遍重推导, 判词逐字) ----

fn exactDefMergeBorrowedLiftAppend(workspace: var ExactDefMergeWorkspace,
                                   inputCopy: int32,
                                   borrowedSourceDef: int32,
                                   sharedOwnerDef: int32,
                                   inputBlock: int32,
                                   inputTerm: int32,
                                   phiMergeDef: int32) =
    if workspace.borrowedLiftPhiMergeDefs.len == 2147483647:
        exactDefMergeDie("borrowed phi lift capacity overflow")
    add(workspace.borrowedLiftInputOps, inputCopy)
    add(workspace.borrowedLiftSourceDefs, borrowedSourceDef)
    add(workspace.borrowedLiftSharedOwners, sharedOwnerDef)
    add(workspace.borrowedLiftInputBlocks, inputBlock)
    add(workspace.borrowedLiftInputTerms, inputTerm)
    add(workspace.borrowedLiftPhiMergeDefs, phiMergeDef)

# borrowed phi lift 全字段门 (C 63143-63346; 返回 false 时调用方按形态
# 选判词: 分支形 → mismatch fprintf + `borrowed phi lift ownership is
# invalid`; loop 提升事件 → `loop borrowed merge promotion state is
# invalid` (C 88107, 无 fprintf))。
@borrows
fn exactDefMergeBorrowedPhiLiftGate(
        bodyIR: coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: ExactDefMergeWorkspace,
        reachState: var int32[],
        borrowedSourceDef: int32,
        sharedOwnerDef: int32,
        inputCopy: int32,
        inputBlock: int32,
        inputTerm: int32,
        phiMergeDef: int32,
        phiBlock: int32): bool =
    if borrowedSourceDef < 0 ||
       borrowedSourceDef >= bodyIR.ops.len ||
       sharedOwnerDef < 0 || sharedOwnerDef >= bodyIR.ops.len ||
       inputCopy < 0 || inputCopy >= bodyIR.ops.len ||
       inputBlock < 0 || inputBlock >= bodyIR.blocks.len ||
       inputTerm < 0 || inputTerm >= bodyIR.terms.len ||
       phiMergeDef < 0 || phiMergeDef >= bodyIR.ops.len:
        return false
    let sourceOwnership =
        Int32(bodyIR.ops[borrowedSourceDef].valueDefOwnership)
    let sharedOwnership =
        Int32(bodyIR.ops[sharedOwnerDef].valueDefOwnership)
    let sharedConsume =
        bodyIR.ops[sharedOwnerDef].valueDefConsumeOpIndexPlusOne
    let inputOwnership = Int32(bodyIR.ops[inputCopy].valueDefOwnership)
    let exactManagedLiftShape = sharedOwnership == Int32(coreir.OwnMove) &&
        sharedConsume == inputCopy + 1 &&
        inputOwnership == Int32(coreir.OwnMove)
    let exactPlainLiftShape = sharedOwnership == Int32(coreir.OwnPlain) &&
        sharedConsume == 0 && inputOwnership == Int32(coreir.OwnPlain)
    if (sourceOwnership != Int32(coreir.OwnBorrowShared) &&
        sourceOwnership != Int32(coreir.OwnBorrowUnique)):
        return false
    if !freeze.ExactDefFreezeIdentityReaches(
           bodyIR, dom, workspace.opBlockIds, sharedOwnerDef, inputCopy):
        return false
    if bodyIR.exactDef.opPlaceKinds[sharedOwnerDef] !=
           exactdef.BodyIrExactDefPlaceSharedCopyTag ||
       bodyIR.exactDef.opOriginIds[sharedOwnerDef] !=
           borrowedSourceDef:
        return false
    if !exactManagedLiftShape && !exactPlainLiftShape:
        return false
    if bodyIR.exactDef.opPlaceKinds[inputCopy] !=
           exactdef.BodyIrExactDefPlaceStackLocalTag ||
       exactDefMergeOpSourceDefRow(bodyIR.ops[inputCopy]) !=
           sharedOwnerDef:
        return false
    if workspace.opBlockIds[inputCopy] != inputBlock:
        return false
    if bodyIR.blocks[inputBlock].termIndex != inputTerm ||
       bodyIR.terms[inputTerm].kind != coreir.BodyTermBrTag:
        return false
    if bodyIR.blocks[inputBlock].opStart +
           bodyIR.blocks[inputBlock].opCount != inputCopy + 1:
        return false
    if phiBlock < 0 ||
       bodyIR.exactDef.opPlaceKinds[phiMergeDef] !=
           exactdef.BodyIrExactDefPlaceCfgMergeTag:
        return false
    let phiSource = exactDefMergeOpSourceDefRow(bodyIR.ops[phiMergeDef])
    let phiSecond =
        freeze.ExactDefFreezeMergeSecondInputRowForMerge(
            bodyIR, phiMergeDef)
    if phiSource != inputCopy && phiSecond != inputCopy:
        return false
    if !exactDefMergeCfgPredecessorReachesMerge(
           bodyIR, reachState, inputBlock, phiBlock):
        return false
    if bodyIR.exactDef.opExactTypeIds[inputCopy] !=
           bodyIR.exactDef.opExactTypeIds[borrowedSourceDef] ||
       bodyIR.exactDef.opExactTypeIds[phiMergeDef] !=
           bodyIR.exactDef.opExactTypeIds[inputCopy]:
        return false
    return bodyIR.exactDef.opProducerFunctionRows[inputCopy] ==
               bodyIR.controlFunctionRow &&
           bodyIR.exactDef.opProducerFunctionRows[phiMergeDef] ==
               bodyIR.controlFunctionRow

# borrowed merge inputs 六列对追加 (C 63453-63547 守卫+成双 append;
# 与夹具出口同实现 — 单实现纪律)。守卫为对级: 重复 phi 行 / 非原子
# (奇数行) / 溢出, 然后成双落六列。
fn exactDefMergeBorrowedMergeAppendPair(
        workspace: var ExactDefMergeWorkspace,
        firstInput: int32,
        firstSource: int32,
        firstInputBlock: int32,
        firstPredecessor: int32,
        firstPredecessorTerm: int32,
        secondInput: int32,
        secondSource: int32,
        secondInputBlock: int32,
        secondPredecessor: int32,
        secondPredecessorTerm: int32,
        phiMergeDef: int32) =
    for row in 0..<workspace.borrowedMergePhiMergeDefs.len:
        if workspace.borrowedMergePhiMergeDefs[row] == phiMergeDef:
            exactDefMergeDie("borrowed merge pair was recorded twice")
    if (workspace.borrowedMergePhiMergeDefs.len & 1) != 0:
        exactDefMergeDie("borrowed merge pair table is not atomic")
    if workspace.borrowedMergePhiMergeDefs.len > 2147483645:
        exactDefMergeDie("borrowed merge pair count overflow")
    add(workspace.borrowedMergeInputOps, firstInput)
    add(workspace.borrowedMergeSourceDefs, firstSource)
    add(workspace.borrowedMergeInputBlocks, firstInputBlock)
    add(workspace.borrowedMergeInputPredecessors, firstPredecessor)
    add(workspace.borrowedMergeInputTerms, firstPredecessorTerm)
    add(workspace.borrowedMergePhiMergeDefs, phiMergeDef)
    add(workspace.borrowedMergeInputOps, secondInput)
    add(workspace.borrowedMergeSourceDefs, secondSource)
    add(workspace.borrowedMergeInputBlocks, secondInputBlock)
    add(workspace.borrowedMergeInputPredecessors, secondPredecessor)
    add(workspace.borrowedMergeInputTerms, secondPredecessorTerm)
    add(workspace.borrowedMergePhiMergeDefs, phiMergeDef)

# borrowed merge inputs 全字段门 (C 63348-63451)。
@borrows
fn exactDefMergeBorrowedMergeInputsGate(
        bodyIR: coreir.BodyIR,
        workspace: ExactDefMergeWorkspace,
        reachState: var int32[],
        firstInput: int32,
        firstSource: int32,
        firstInputBlock: int32,
        firstPredecessor: int32,
        firstPredecessorTerm: int32,
        secondInput: int32,
        secondSource: int32,
        secondInputBlock: int32,
        secondPredecessor: int32,
        secondPredecessorTerm: int32,
        phiMergeDef: int32,
        phiBlock: int32): int32 =
    # 返回 0=通过; 1=pair identity 失败; 2=pair ownership 失败;
    # 3=unique 根不同。
    if phiMergeDef < 0 || phiMergeDef >= bodyIR.ops.len ||
       firstInput == secondInput ||
       firstInputBlock == secondInputBlock ||
       firstPredecessor == secondPredecessor ||
       bodyIR.exactDef.opPlaceKinds[phiMergeDef] !=
           exactdef.BodyIrExactDefPlaceCfgMergeTag:
        return 1
    let phiOwnership = Int32(bodyIR.ops[phiMergeDef].valueDefOwnership)
    if phiOwnership != Int32(coreir.OwnBorrowShared) &&
       phiOwnership != Int32(coreir.OwnBorrowUnique):
        return 1
    if exactDefMergeOpSourceDefRow(bodyIR.ops[phiMergeDef]) !=
           firstInput ||
       freeze.ExactDefFreezeMergeSecondInputRowForMerge(
           bodyIR, phiMergeDef) != secondInput:
        return 1
    if phiBlock < 0:
        return 2
    for edge in 0..<2:
        var input = firstInput
        var source = firstSource
        var inputBlock = firstInputBlock
        var predecessor = firstPredecessor
        var predecessorTerm = firstPredecessorTerm
        if edge == 1:
            input = secondInput
            source = secondSource
            inputBlock = secondInputBlock
            predecessor = secondPredecessor
            predecessorTerm = secondPredecessorTerm
        if input < 0 || input >= bodyIR.ops.len ||
           source < 0 || source >= bodyIR.ops.len ||
           inputBlock < 0 || inputBlock >= bodyIR.blocks.len ||
           predecessor < 0 || predecessor >= bodyIR.blocks.len ||
           predecessorTerm < 0 || predecessorTerm >= bodyIR.terms.len:
            return 2
        let sourceOwnership =
            Int32(bodyIR.ops[source].valueDefOwnership)
        let inputOwnership =
            Int32(bodyIR.ops[input].valueDefOwnership)
        if (sourceOwnership != Int32(coreir.OwnBorrowShared) &&
            sourceOwnership != Int32(coreir.OwnBorrowUnique)) ||
           bodyIR.exactDef.opPlaceKinds[input] !=
               exactdef.BodyIrExactDefPlaceStackLocalTag ||
           (inputOwnership != Int32(coreir.OwnBorrowShared) &&
            inputOwnership != Int32(coreir.OwnBorrowUnique)):
            return 2
        if exactDefMergeOpSourceDefRow(bodyIR.ops[input]) != source ||
           workspace.opBlockIds[input] != inputBlock:
            return 2
        if bodyIR.blocks[inputBlock].opStart +
               bodyIR.blocks[inputBlock].opCount != input + 1:
            return 2
        if bodyIR.blocks[predecessor].termIndex != predecessorTerm ||
           bodyIR.terms[predecessorTerm].kind !=
               coreir.BodyTermBrTag ||
           bodyIR.terms[predecessorTerm].trueBlock != inputBlock:
            return 2
        if !exactDefMergeCfgPredecessorReachesMerge(
               bodyIR, reachState, inputBlock, phiBlock):
            return 2
        if bodyIR.exactDef.opExactTypeIds[input] !=
               bodyIR.exactDef.opExactTypeIds[source] ||
           bodyIR.exactDef.opExactTypeIds[phiMergeDef] !=
               bodyIR.exactDef.opExactTypeIds[input]:
            return 2
        if bodyIR.exactDef.opProducerFunctionRows[input] !=
               bodyIR.controlFunctionRow ||
           bodyIR.exactDef.opProducerFunctionRows[phiMergeDef] !=
               bodyIR.controlFunctionRow:
            return 2
    if phiOwnership == Int32(coreir.OwnBorrowUnique):
        let firstSourceOp = bodyIR.ops[firstSource]
        let secondSourceOp = bodyIR.ops[secondSource]
        if Int32(firstSourceOp.valueDefOwnership) !=
               Int32(coreir.OwnBorrowUnique) ||
           Int32(secondSourceOp.valueDefOwnership) !=
               Int32(coreir.OwnBorrowUnique) ||
           !exactDefMergeBorrowRootsIdentical(
               firstSourceOp, secondSourceOp):
            return 3
    return 0

# ---- merge batch 主体 (cold_merge_exact_local_defs_batch 的 Cheng
#      空间孪生; 时序约束→空间不变量, 规格 §4) ----

# storage 门 (C 64612-64641): recorded 侧车列为权威; 双 UNKNOWN→
# PLAIN (cold_parser.c:64421-64423 镜像: 纯数据 POD local 全路径
# UNKNOWN, 定义仅供身份追踪, 按 PLAIN 收); 拒绝 → 7 字段 fprintf
# (请求原值 first/second_slot) + die。与夹具出口同实现 (单实现纪律)。
@borrows
fn exactDefMergePlanStorageGate(bodyIR: coreir.BodyIR,
                                firstSlot: int32,
                                secondSlot: int32,
                                canonicalSlot: int32,
                                localName: str,
                                localKind: int32): int32 =
    var storage = bodyIR.exactDef.slotStorageKinds[canonicalSlot]
    let secondStorage = bodyIR.exactDef.slotStorageKinds[secondSlot]
    if storage == exactdef.BodyIrExactDefStorageUnknownTag &&
       secondStorage == exactdef.BodyIrExactDefStorageUnknownTag:
        storage = exactdef.BodyIrExactDefStoragePlainTag
    if storage == exactdef.BodyIrExactDefStorageUnknownTag ||
       (storage != exactdef.BodyIrExactDefStoragePlainTag &&
        secondStorage != storage) ||
       (storage == exactdef.BodyIrExactDefStoragePlainTag &&
        secondStorage != exactdef.BodyIrExactDefStoragePlainTag &&
        secondStorage != exactdef.BodyIrExactDefStorageUnknownTag):
        exactDefMergeVerdictEmit(
            exactDefMergeStorageLine(
                bodyIR, localName, firstSlot, secondSlot,
                storage, secondStorage, localKind))
        exactDefMergeDie(
            "managed CFG merge batch storage identities differ")
    return storage

@borrows
fn exactDefMergeJoinBatchInto(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var ExactDefMergeWorkspace,
        joinBlock: int32,
        mergeRows: int32[],
        stagingSlots: int32[],
        firstPred: int32,
        secondPred: int32) =
    # 状态门 (C 64377-64383): parser/null 合取无 Cheng 载体 (值类型);
    # 前驱越界/双前驱相等 → state invalid。open join 门真空 (模块头)。
    if firstPred < 0 || firstPred >= bodyIR.blocks.len ||
       secondPred < 0 || secondPred >= bodyIR.blocks.len ||
       firstPred == secondPred:
        exactDefMergeDie("managed CFG merge batch state is invalid")
    let requestCount = mergeRows.len
    var reachState: int32[]
    setLen(reachState, bodyIR.blocks.len)
    let slotCount = bodyIR.localSlots.len
    for i in 0..<requestCount:
        let mergeRow = mergeRows[i]
        let mergeOp = bodyIR.ops[mergeRow]
        let destination = mergeOp.valueDefSlot
        let staging = mergeOp.operands[0]
        # ---- 请求回收 (双输入/边块/原始前驱/原始定义) ----
        var stagingDefs: int32[]
        exactDefMergeStagingDefs(bodyIR, staging, stagingDefs)
        let firstInput = exactDefMergeOpSourceDefRow(mergeOp)
        var secondInput: int32 = -1
        for index in 0..<stagingDefs.len:
            if stagingDefs[index] != firstInput:
                secondInput = stagingDefs[index]
        var edgeValid = stagingDefs.len == 2 &&
            firstInput >= 0 && secondInput >= 0
        var firstInputBlock: int32 = -1
        var secondInputBlock: int32 = -1
        var firstSidePred: int32 = -1
        var secondSidePred: int32 = -1
        var firstInputPredecessor: int32 = -1
        var secondInputPredecessor: int32 = -1
        var firstInputPredecessorTerm: int32 = -1
        var secondInputPredecessorTerm: int32 = -1
        var firstOriginalPred: int32 = -1
        var secondOriginalPred: int32 = -1
        if edgeValid:
            firstInputBlock = workspace.opBlockIds[firstInput]
            secondInputBlock = workspace.opBlockIds[secondInput]
            if firstInputBlock < 0 || secondInputBlock < 0 ||
               firstInputBlock == secondInputBlock:
                edgeValid = false
        if edgeValid:
            # input copy 块末行 (空间不变量 2)。
            if bodyIR.blocks[firstInputBlock].opStart +
                   bodyIR.blocks[firstInputBlock].opCount !=
                   firstInput + 1 ||
               bodyIR.blocks[secondInputBlock].opStart +
                   bodyIR.blocks[secondInputBlock].opCount !=
                   secondInput + 1:
                edgeValid = false
            # 边块 term BR + 链尾==join 直接前驱 (空间不变量 3/4)。
            firstSidePred = exactDefMergeChainTail(
                bodyIR, firstInputBlock, joinBlock)
            secondSidePred = exactDefMergeChainTail(
                bodyIR, secondInputBlock, joinBlock)
            if (firstSidePred != firstPred ||
                secondSidePred != secondPred) &&
               (firstSidePred != secondPred ||
                secondSidePred != firstPred):
                edgeValid = false
            if firstSidePred < 0 || secondSidePred < 0:
                edgeValid = false
            # 被封边块的直接前驱+term (C input_predecessor(+_term))。
            firstInputPredecessor = exactDefMergeSoleBrPredecessor(
                bodyIR, firstInputBlock)
            secondInputPredecessor = exactDefMergeSoleBrPredecessor(
                bodyIR, secondInputBlock)
            if firstInputPredecessor < 0 ||
               secondInputPredecessor < 0:
                edgeValid = false
        if edgeValid:
            firstInputPredecessorTerm =
                bodyIR.blocks[firstInputPredecessor].termIndex
            secondInputPredecessorTerm =
                bodyIR.blocks[secondInputPredecessor].termIndex
            if firstInputPredecessorTerm < 0 ||
               firstInputPredecessorTerm >= bodyIR.terms.len ||
               bodyIR.terms[firstInputPredecessorTerm].kind !=
                   coreir.BodyTermBrTag ||
               bodyIR.terms[firstInputPredecessorTerm].trueBlock !=
                   firstInputBlock ||
               secondInputPredecessorTerm < 0 ||
               secondInputPredecessorTerm >= bodyIR.terms.len ||
               bodyIR.terms[secondInputPredecessorTerm].kind !=
                   coreir.BodyTermBrTag ||
               bodyIR.terms[secondInputPredecessorTerm].trueBlock !=
                   secondInputBlock:
                edgeValid = false
            # 原始前驱 (请求间链式推进的链首前块, 规格 §1.2 64530-64531
            # 的空间对应物)。
            firstOriginalPred = exactDefMergeOriginalPredecessor(
                bodyIR, stagingSlots, firstInputBlock)
            secondOriginalPred = exactDefMergeOriginalPredecessor(
                bodyIR, stagingSlots, secondInputBlock)
            if firstOriginalPred < 0 || secondOriginalPred < 0 ||
               firstOriginalPred == secondOriginalPred:
                edgeValid = false
        if !edgeValid:
            exactDefMergeDie(
                "managed CFG merge batch edge staging failed")
        let firstInputSourceDef =
            exactDefMergeOpSourceDefRow(bodyIR.ops[firstInput])
        let secondInputSourceDef =
            exactDefMergeOpSourceDefRow(bodyIR.ops[secondInput])
        let firstDef = exactDefMergeOriginalDefForInput(
            bodyIR, workspace, firstOriginalPred, firstInputSourceDef)
        let secondDef = exactDefMergeOriginalDefForInput(
            bodyIR, workspace, secondOriginalPred, secondInputSourceDef)
        # is_global 同 GlobalDef 行通道 (规格 §2.1/§5): 证同定义,
        # 不收 merge 请求 — 本行不作 merge 处理 (普通车道校验余下
        # 各行; C 在该通道同样不产生 merge 行)。
        if exactDefMergeSameGlobalShadow(bodyIR, firstDef, secondDef):
            continue
        # ---- 逐字段取值 (C 64402-64425) ----
        let firstSlot = exactDefMergeDefSlotOrInvalid(bodyIR, firstDef)
        let secondSlot = exactDefMergeDefSlotOrInvalid(bodyIR, secondDef)
        let firstKind = exactDefMergeSlotKindOrInvalid(bodyIR, firstSlot)
        let secondKind = exactDefMergeSlotKindOrInvalid(bodyIR, secondSlot)
        var firstType: int32 = -1
        var secondType: int32 = -1
        if firstDef >= 0 && firstDef < bodyIR.ops.len:
            firstType = bodyIR.exactDef.opExactTypeIds[firstDef]
        if secondDef >= 0 && secondDef < bodyIR.ops.len:
            secondType = bodyIR.exactDef.opExactTypeIds[secondDef]
        var localName: str
        if destination >= 0 && destination < slotCount:
            localName = bodyIR.localSlots[destination].name
        # ref 值 normalize 双臂 (C 64426-64451 的 Cheng typeFact 形)。
        let normalizeFirstRefValue =
            exactDefMergeSlotIsManagedRef(bodyIR, firstSlot) &&
            exactDefMergeRefValueTypeMatches(
                bodyIR, firstSlot, secondSlot)
        let normalizeSecondRefValue =
            exactDefMergeSlotIsManagedRef(bodyIR, secondSlot) &&
            exactDefMergeRefValueTypeMatches(
                bodyIR, secondSlot, firstSlot)
        # 固定数组全局无独立 TypeId (C cold_exact_managed_type_id 返 -1;
        # locals_add_global_shadow 的 fixed_array_global 旁路与 indexed-store
        # sentinel 均照样发布 PLACE_GLOBAL/BORROW_SHARED/origin=global_index
        # 定义)。同一 GlobalDef 行的双臂定义仍是一个精确借用 phi:
        # place GLOBAL + origin 相等 + kind 相等 + GlobalLoad 生产者 +
        # 双 BORROW_SHARED 证明 TypeId 对有类型全局证明的那一身份。
        # 其余形状 (-1/有类型混合、不同 origin、非 GLOBAL place、
        # ownership 不对称) 仍被族门拒绝。
        let globalTypeLessBorrowPhi =
            firstType < 0 && secondType < 0 &&
            firstKind == secondKind &&
            bodyIR.ops[firstDef].kind ==
                coreir.BodyOpGlobalLoadTag &&
            bodyIR.ops[secondDef].kind ==
                coreir.BodyOpGlobalLoadTag &&
            bodyIR.exactDef.opPlaceKinds[firstDef] ==
                exactdef.BodyIrExactDefPlaceGlobalTag &&
            bodyIR.exactDef.opPlaceKinds[secondDef] ==
                exactdef.BodyIrExactDefPlaceGlobalTag &&
            bodyIR.exactDef.opOriginIds[firstDef] >= 0 &&
            bodyIR.exactDef.opOriginIds[firstDef] ==
                bodyIR.exactDef.opOriginIds[secondDef] &&
            bodyIR.ops[firstDef].valueDefOwnership ==
                coreir.OwnBorrowShared &&
            bodyIR.ops[secondDef].valueDefOwnership ==
                coreir.OwnBorrowShared
        let exactTypeFamilyMatches = globalTypeLessBorrowPhi ||
            (firstType >= 0 &&
             (firstType == secondType || normalizeFirstRefValue ||
              normalizeSecondRefValue))
        # destination_override 空间回收 (规格 §4 末行):
        # dst==first_slot → entry_slot (loop), dst==second_slot → 非
        # C 形 (destination 门处拒), 否则 -1 (branch/conditional)。
        var destinationOverride: int32 = -1
        if destination >= 0 && destination == firstSlot:
            destinationOverride = destination
        # loop 前置门 (C 89369-89402, 规格 §2.2): 双 owned/双借用/混合
        # + exact_type 相等 + kind/size 相等。
        if destinationOverride >= 0:
            var loopFirstOwn: int32 = -1
            var loopSecondOwn: int32 = -1
            if firstDef >= 0 && firstDef < bodyIR.ops.len:
                loopFirstOwn =
                    Int32(bodyIR.ops[firstDef].valueDefOwnership)
            if secondDef >= 0 && secondDef < bodyIR.ops.len:
                loopSecondOwn =
                    Int32(bodyIR.ops[secondDef].valueDefOwnership)
            let loopFirstOwned =
                loopFirstOwn == Int32(coreir.OwnMove) ||
                loopFirstOwn == Int32(coreir.OwnPlain)
            let loopSecondOwned =
                loopSecondOwn == Int32(coreir.OwnMove) ||
                loopSecondOwn == Int32(coreir.OwnPlain)
            let loopFirstBorrowed =
                loopFirstOwn == Int32(coreir.OwnBorrowShared) ||
                loopFirstOwn == Int32(coreir.OwnBorrowUnique)
            let loopSecondBorrowed =
                loopSecondOwn == Int32(coreir.OwnBorrowShared) ||
                loopSecondOwn == Int32(coreir.OwnBorrowUnique)
            let loopCompatible =
                (loopFirstOwned && loopSecondOwned) ||
                (loopFirstBorrowed && loopSecondBorrowed) ||
                (loopFirstOwned && loopSecondBorrowed) ||
                (loopFirstBorrowed && loopSecondOwned)
            if !loopCompatible || firstType != secondType ||
               firstKind != secondKind || firstSlot < 0 ||
               secondSlot < 0 ||
               bodyIR.localSlots[firstSlot].sizeBytes !=
                   bodyIR.localSlots[secondSlot].sizeBytes:
                exactDefMergeDie(
                    "managed loop phi input definitions are incompatible")
        # ---- definition mismatch 门 (C 64457-64540, 13 合取 +
        #      21 字段判词实打印 29 值) ----
        let firstTerm = bodyIR.blocks[firstInputBlock].termIndex
        let secondTerm = bodyIR.blocks[secondInputBlock].termIndex
        let firstReaches = exactDefMergeCfgPredecessorReachesMerge(
            bodyIR, reachState, firstInputBlock, joinBlock)
        let secondReaches = exactDefMergeCfgPredecessorReachesMerge(
            bodyIR, reachState, secondInputBlock, joinBlock)
        var firstProducer: int32 = -1
        var secondProducer: int32 = -1
        if firstDef >= 0 && firstDef < bodyIR.ops.len:
            firstProducer =
                bodyIR.exactDef.opProducerFunctionRows[firstDef]
        if secondDef >= 0 && secondDef < bodyIR.ops.len:
            secondProducer =
                bodyIR.exactDef.opProducerFunctionRows[secondDef]
        var firstTermKind: int32 = -1
        var secondTermKind: int32 = -1
        if firstTerm >= 0 && firstTerm < bodyIR.terms.len:
            firstTermKind = bodyIR.terms[firstTerm].kind
        if secondTerm >= 0 && secondTerm < bodyIR.terms.len:
            secondTermKind = bodyIR.terms[secondTerm].kind
        if destination < 0 || destination >= slotCount ||
           firstDef < 0 || firstDef >= bodyIR.ops.len ||
           secondDef < 0 || secondDef >= bodyIR.ops.len ||
           firstDef == secondDef ||
           firstTerm < 0 || secondTerm < 0 ||
           firstTermKind != coreir.BodyTermBrTag ||
           secondTermKind != coreir.BodyTermBrTag ||
           !firstReaches || !secondReaches ||
           firstSlot < 0 || secondSlot < 0 ||
           !exactTypeFamilyMatches ||
           firstProducer != bodyIR.controlFunctionRow ||
           secondProducer != bodyIR.controlFunctionRow:
            exactDefMergeVerdictEmit(
                exactDefMergeMismatchLine(
                    bodyIR, i, requestCount, localName,
                    firstDef, secondDef, firstInputBlock,
                    secondInputBlock, joinBlock, firstTerm, secondTerm,
                    exactDefMergeBoolInt(firstReaches),
                    exactDefMergeBoolInt(secondReaches)))
            exactDefMergeDie(
                "managed CFG merge batch definitions are invalid")
        # ---- ownership 四值门 (C 64541-64557) ----
        let firstOwnership = Int32(bodyIR.ops[firstDef].valueDefOwnership)
        let secondOwnership =
            Int32(bodyIR.ops[secondDef].valueDefOwnership)
        let firstValidOwnership =
            firstOwnership == Int32(coreir.OwnMove) ||
            firstOwnership == Int32(coreir.OwnPlain) ||
            firstOwnership == Int32(coreir.OwnBorrowShared) ||
            firstOwnership == Int32(coreir.OwnBorrowUnique)
        let secondValidOwnership =
            secondOwnership == Int32(coreir.OwnMove) ||
            secondOwnership == Int32(coreir.OwnPlain) ||
            secondOwnership == Int32(coreir.OwnBorrowShared) ||
            secondOwnership == Int32(coreir.OwnBorrowUnique)
        if !firstValidOwnership || !secondValidOwnership:
            exactDefMergeDie(
                "managed CFG merge batch ownership is invalid")
        # ---- 借用合并权威 (C 64559-64593; 根=冻结三列, 规格 §3) ----
        let firstBorrowed =
            firstOwnership == Int32(coreir.OwnBorrowShared) ||
            firstOwnership == Int32(coreir.OwnBorrowUnique)
        let secondBorrowed =
            secondOwnership == Int32(coreir.OwnBorrowShared) ||
            secondOwnership == Int32(coreir.OwnBorrowUnique)
        let borrowMerge = firstBorrowed && secondBorrowed
        let preserveUniqueBorrow = borrowMerge &&
            !normalizeFirstRefValue && !normalizeSecondRefValue &&
            firstOwnership == Int32(coreir.OwnBorrowUnique) &&
            secondOwnership == Int32(coreir.OwnBorrowUnique) &&
            exactDefMergeBorrowRootsIdentical(
                bodyIR.ops[firstDef], bodyIR.ops[secondDef])
        var mergeOwnership: int32
        if borrowMerge:
            if preserveUniqueBorrow:
                mergeOwnership = Int32(coreir.OwnBorrowUnique)
            else:
                mergeOwnership = Int32(coreir.OwnBorrowShared)
        else:
            mergeOwnership = Int32(coreir.OwnMove)
        var liftFirstBorrowed = !borrowMerge && firstBorrowed
        var liftSecondBorrowed = !borrowMerge && secondBorrowed
        # ---- canonical 槽与源槽门 (C 64594-64611) ----
        var canonicalSlot = firstSlot
        if normalizeFirstRefValue:
            canonicalSlot = secondSlot
        let canonicalKind = bodyIR.localSlots[canonicalSlot].typeKind
        let localKind = bodyIR.localSlots[destination].typeKind
        if firstSlot < 0 || firstSlot >= slotCount ||
           secondSlot < 0 || secondSlot >= slotCount ||
           canonicalKind != localKind ||
           (!normalizeFirstRefValue && !normalizeSecondRefValue &&
            (firstKind != localKind || secondKind != localKind ||
             bodyIR.localSlots[firstSlot].sizeBytes !=
                 bodyIR.localSlots[secondSlot].sizeBytes)):
            exactDefMergeDie(
                "managed CFG merge batch source slots differ")
        # staging 槽与 canonical 同形 (C 64662-64671 载体槽雕刻的空间
        # 对应: kind/size/头戳同 canonical, 头戳绝不从输入行取)。
        if bodyIR.localSlots[staging].typeKind != canonicalKind ||
           bodyIR.localSlots[staging].sizeBytes !=
               bodyIR.localSlots[canonicalSlot].sizeBytes ||
           bodyIR.localSlots[staging].typeArenaTypeId !=
               bodyIR.localSlots[canonicalSlot].typeArenaTypeId:
            exactDefMergeDie(
                "managed CFG merge batch source slots differ")
        # ---- storage 门含双 UNKNOWN→PLAIN (C 64612-64641) ----
        let storage = exactDefMergePlanStorageGate(
            bodyIR, firstSlot, secondSlot, canonicalSlot, localName,
            localKind)
        let secondStorage = bodyIR.exactDef.slotStorageKinds[secondSlot]
        # ---- independent_plain_merge 降级 (C 64642-64661) ----
        let independentPlainMerge = !borrowMerge &&
            !normalizeFirstRefValue && !normalizeSecondRefValue &&
            storage == exactdef.BodyIrExactDefStoragePlainTag &&
            freeze.ExactDefFreezePlainValueCopyIndependent(
                bodyIR, firstSlot) &&
            freeze.ExactDefFreezePlainValueCopyIndependent(
                bodyIR, secondSlot)
        if independentPlainMerge:
            # 只有结构独立 PLAIN 值可丢弃线性边 epoch; 带地址 PLAIN
            # 聚合仍须一次精确 MOVE。
            mergeOwnership = Int32(coreir.OwnPlain)
            liftFirstBorrowed = false
            liftSecondBorrowed = false
        # ---- staging 载体槽戳 (C 64672-64686: place=STACK_LOCAL,
        #      origin=自身, storage 与 merge destination 后记的 plan
        #      storage 一致) ----
        let stagingStorage = bodyIR.exactDef.slotStorageKinds[staging]
        if stagingStorage != exactdef.BodyIrExactDefStorageUnknownTag &&
           stagingStorage != storage:
            exactDefMergeVerdictEmit(
                exactDefMergeStorageLine(
                    bodyIR, localName, canonicalSlot, staging,
                    storage, stagingStorage, canonicalKind))
            exactDefMergeDie(
                "managed CFG merge batch storage identities differ")
        bodyIR.exactDef.slotPlaceKinds[staging] =
            exactdef.BodyIrExactDefPlaceStackLocalTag
        bodyIR.exactDef.slotOriginIds[staging] = staging
        bodyIR.exactDef.slotStorageKinds[staging] = storage
        # ---- plan ownership drift 门 (C 64750-64771; 输入 recorded
        #      own 族与 plan 族必须一致) ----
        let planIsOwned =
            mergeOwnership == Int32(coreir.OwnMove) ||
            mergeOwnership == Int32(coreir.OwnPlain)
        let firstRecordedOwned =
            bodyIR.ops[firstInput].valueDefOwnership == coreir.OwnMove ||
            bodyIR.ops[firstInput].valueDefOwnership == coreir.OwnPlain
        let secondRecordedOwned =
            bodyIR.ops[secondInput].valueDefOwnership == coreir.OwnMove ||
            bodyIR.ops[secondInput].valueDefOwnership == coreir.OwnPlain
        if planIsOwned != firstRecordedOwned ||
           planIsOwned != secondRecordedOwned:
            exactDefMergeDie(
                "managed CFG merge batch plan ownership drifted")
        # ---- 逐输入边校验 + edge ownership (规格 §1.3 全门) ----
        let firstEdgeOwnership = exactDefMergeEdgeInputValidate(
            bodyIR, dom, workspace, mergeRow, firstInput,
            firstInputBlock, firstOriginalPred, firstDef, staging,
            normalizeFirstRefValue, liftFirstBorrowed,
            preserveUniqueBorrow, mergeOwnership)
        let secondEdgeOwnership = exactDefMergeEdgeInputValidate(
            bodyIR, dom, workspace, mergeRow, secondInput,
            secondInputBlock, secondOriginalPred, secondDef, staging,
            normalizeSecondRefValue, liftSecondBorrowed,
            preserveUniqueBorrow, mergeOwnership)
        # 输入 own 戳权威: 与 edge ownership 一致 (C 63721 发戳;
        # PLAIN merge 双输入强制 PLAIN 已在边校验内折)。
        if Int32(bodyIR.ops[firstInput].valueDefOwnership) !=
               firstEdgeOwnership ||
           Int32(bodyIR.ops[secondInput].valueDefOwnership) !=
               secondEdgeOwnership:
            exactDefMergeDie(
                "managed phi input definition is incompatible")
        # 源 consume 代表戳 (C 63727-63731): edge_ownership==MOVE 且
        # 源 consume 未占 → 记本拷贝为代表消费者 (标量行只记一个
        # 代表, 严格校验证互斥边 — 已占者保留, 互斥道在批 2/审计)。
        for edge in 0..<2:
            var edgeOwn = firstEdgeOwnership
            var input = firstInput
            var originalDef = firstDef
            if edge == 1:
                edgeOwn = secondEdgeOwnership
                input = secondInput
                originalDef = secondDef
            if edgeOwn == Int32(coreir.OwnMove):
                let originalOp = bodyIR.ops[originalDef]
                if originalOp.valueDefConsumeOpIndexPlusOne == 0:
                    bodyIR.ops[originalDef].
                        valueDefConsumeOpIndexPlusOne = input + 1
        # ---- destination 校验 (C 64773-64809) ----
        if destination == secondSlot:
            exactDefMergeDie(
                "managed CFG merge batch destination is invalid")
        if destinationOverride >= 0:
            # override 槽 (loop entry_slot) kind/size 与 canonical 头
            # 一致 (C 64791-64796)。
            if destination >= slotCount ||
               bodyIR.localSlots[destination].typeKind !=
                   canonicalKind ||
               bodyIR.localSlots[destination].sizeBytes !=
                   bodyIR.localSlots[staging].sizeBytes:
                exactDefMergeDie(
                    "managed CFG merge batch destination is invalid")
        else:
            # 新雕槽继承 canonical 头戳 (C 64783-64790 的空间对应:
            # derive/绑定车道已证 type, 这里核 size 同 staging)。
            if bodyIR.localSlots[destination].sizeBytes !=
                   bodyIR.localSlots[staging].sizeBytes:
                exactDefMergeDie(
                    "managed CFG merge batch destination is invalid")
        if bodyIR.exactDef.slotStorageKinds[destination] !=
               exactdef.BodyIrExactDefStorageUnknownTag &&
           bodyIR.exactDef.slotStorageKinds[destination] != storage:
            exactDefMergeVerdictEmit(
                exactDefMergeStorageLine(
                    bodyIR, localName, canonicalSlot, destination,
                    storage,
                    bodyIR.exactDef.slotStorageKinds[destination],
                    localKind))
            exactDefMergeDie(
                "managed CFG merge batch storage identities differ")
        # ---- merge 行戳 (C 64810-64829) ----
        let preMergeOwnership =
            Int32(bodyIR.ops[mergeRow].valueDefOwnership)
        if preMergeOwnership != mergeOwnership:
            exactDefMergeDie(
                "managed CFG merge batch plan ownership drifted")
        bodyIR.exactDef.opExactTypeIds[mergeRow] =
            bodyIR.localSlots[staging].typeArenaTypeId
        bodyIR.exactDef.opProducerFunctionRows[mergeRow] =
            bodyIR.controlFunctionRow
        bodyIR.exactDef.opPlaceKinds[mergeRow] =
            exactdef.BodyIrExactDefPlaceCfgMergeTag
        bodyIR.exactDef.opOriginIds[mergeRow] = mergeRow
        bodyIR.exactDef.opSourceDefOpRows[mergeRow] = firstInput
        # ---- 物理源自环校验 (C 64830-64858) ----
        let stagingSlot = staging
        let existingReadA = bodyIR.exactDef.opReadADefOpRows[mergeRow]
        let selfEdgeValid = freeze.ExactDefFreezeMergeReadSourceEdgeValid(
            bodyIR, dom, workspace.opBlockIds, mergeRow, stagingSlot,
            mergeRow)
        if (existingReadA != -1 && existingReadA != mergeRow) ||
           !selfEdgeValid:
            var firstExactType: int32 = -1
            var secondExactType: int32 = -1
            if firstInput >= 0 && firstInput < bodyIR.ops.len:
                firstExactType =
                    bodyIR.exactDef.opExactTypeIds[firstInput]
            if secondInput >= 0 && secondInput < bodyIR.ops.len:
                secondExactType =
                    bodyIR.exactDef.opExactTypeIds[secondInput]
            exactDefMergeVerdictEmit(
                exactDefMergeSdbgLine(
                    mergeRow, existingReadA,
                    exactDefMergeBoolInt(selfEdgeValid), firstInput,
                    secondInput, firstExactType, secondExactType,
                    bodyIR.exactDef.opExactTypeIds[mergeRow]))
            exactDefMergeDie(
                "managed CFG merge physical source set is invalid")
        bodyIR.exactDef.opReadADefOpRows[mergeRow] = mergeRow
        # ---- consume 标记 (C 64859-64872) ----
        for edge in 0..<2:
            var input = firstInput
            var inputOwnership = firstEdgeOwnership
            if edge == 1:
                input = secondInput
                inputOwnership = secondEdgeOwnership
            if inputOwnership == Int32(coreir.OwnMove) ||
               inputOwnership == Int32(coreir.OwnPlain):
                let recorded =
                    bodyIR.ops[input].valueDefConsumeOpIndexPlusOne
                if recorded != 0 && recorded != mergeRow + 1:
                    exactDefMergeDie(
                        "managed CFG merge batch edge staging failed")
                bodyIR.ops[input].valueDefConsumeOpIndexPlusOne =
                    mergeRow + 1
        # ---- 槽头戳 (C 64873-64881: 槽头 canonical, 绝不从输入行
        #      回写) ----
        bodyIR.exactDef.slotPlaceKinds[destination] =
            exactdef.BodyIrExactDefPlaceCfgMergeTag
        bodyIR.exactDef.slotOriginIds[destination] = mergeRow
        bodyIR.exactDef.slotStorageKinds[destination] = storage
        # eager unique cell view (C 64886-64889): Cheng 无 cell-view
        # 载体 → 真空 (模块头锚定)。
        # ---- borrowed phi lift 登记 (C 64890-64919 → 63143-63346) ----
        let phiBlock = workspace.opBlockIds[mergeRow]
        for edge in 0..<2:
            var lift = liftFirstBorrowed
            var input = firstInput
            var inputBlock = firstInputBlock
            var inputPredecessorTerm = firstInputPredecessorTerm
            var borrowedSourceDef = firstDef
            if edge == 1:
                lift = liftSecondBorrowed
                input = secondInput
                inputBlock = secondInputBlock
                inputPredecessorTerm = secondInputPredecessorTerm
                borrowedSourceDef = secondDef
            if !lift:
                continue
            let sharedOwnerDef =
                exactDefMergeOpSourceDefRow(bodyIR.ops[input])
            let identityValid = sharedOwnerDef >= 0 &&
                sharedOwnerDef < bodyIR.ops.len &&
                borrowedSourceDef >= 0 &&
                borrowedSourceDef < bodyIR.ops.len &&
                input >= 0 && input < bodyIR.ops.len &&
                inputBlock >= 0 && inputBlock < bodyIR.blocks.len &&
                inputPredecessorTerm >= 0 &&
                inputPredecessorTerm < bodyIR.terms.len &&
                mergeRow >= 0 && mergeRow < bodyIR.ops.len
            if !identityValid:
                exactDefMergeDie(
                    "borrowed phi lift identity is invalid")
            # recorded source 的 origin 即被提升借用源 (C 64894-64899
            # 同列: borrowed_source_def = origin[shared])。
            borrowedSourceDef =
                bodyIR.exactDef.opOriginIds[sharedOwnerDef]
            if borrowedSourceDef < 0 ||
               borrowedSourceDef >= bodyIR.ops.len:
                exactDefMergeDie(
                    "borrowed phi lift identity is invalid")
            let liftGateValid = exactDefMergeBorrowedPhiLiftGate(
                bodyIR, dom, workspace, reachState, borrowedSourceDef,
                sharedOwnerDef, input, inputBlock,
                bodyIR.blocks[inputBlock].termIndex, mergeRow, phiBlock)
            if !liftGateValid:
                if destinationOverride >= 0 && edge == 0:
                    # loop 借用→owned 提升事件 (C 89452-89476 →
                    # 88083-88200, 判词 88107; 事件序 88132 单遍
                    # 重推导下真空, 模块头锚定)。
                    exactDefMergeDie(
                        "loop borrowed merge promotion state is invalid")
                var sharedPlace: int32 = -9
                var sharedOwnership: int32 = -9
                var sharedOrigin: int32 = -9
                var sharedConsume: int32 = -9
                if sharedOwnerDef >= 0 &&
                   sharedOwnerDef < bodyIR.ops.len:
                    sharedPlace =
                        bodyIR.exactDef.opPlaceKinds[sharedOwnerDef]
                    sharedOwnership = Int32(
                        bodyIR.ops[sharedOwnerDef].valueDefOwnership)
                    sharedOrigin =
                        bodyIR.exactDef.opOriginIds[sharedOwnerDef]
                    let sharedOwnerOp = bodyIR.ops[sharedOwnerDef]
                    sharedConsume =
                        sharedOwnerOp.valueDefConsumeOpIndexPlusOne
                var termTarget: int32 = -9
                if inputPredecessorTerm >= 0 &&
                   inputPredecessorTerm < bodyIR.terms.len:
                    termTarget =
                        bodyIR.terms[inputPredecessorTerm].trueBlock
                let borrowedSourceOp = bodyIR.ops[borrowedSourceDef]
                exactDefMergeVerdictEmit(
                    exactDefMergeBorrowedPhiLiftMismatchLine(
                        bodyIR, borrowedSourceDef,
                        Int32(borrowedSourceOp.valueDefOwnership),
                        sharedOwnerDef, sharedPlace, sharedOwnership,
                        sharedOrigin, sharedConsume, input,
                        bodyIR.exactDef.opPlaceKinds[input],
                        Int32(bodyIR.ops[input].valueDefOwnership),
                        exactDefMergeOpSourceDefRow(bodyIR.ops[input]),
                        inputBlock, workspace.opBlockIds[input],
                        bodyIR.blocks[inputBlock].termIndex,
                        bodyIR.blocks[inputBlock].termIndex,
                        bodyIR.terms[
                            bodyIR.blocks[inputBlock].termIndex].kind,
                        termTarget,
                        bodyIR.blocks[inputBlock].opStart +
                            bodyIR.blocks[inputBlock].opCount,
                        mergeRow, phiBlock,
                        bodyIR.exactDef.opPlaceKinds[mergeRow],
                        exactDefMergeOpSourceDefRow(
                            bodyIR.ops[mergeRow]),
                        freeze.ExactDefFreezeMergeSecondInputRowForMerge(
                            bodyIR, mergeRow),
                        exactDefMergeBoolInt(
                            exactDefMergeCfgPredecessorReachesMerge(
                                bodyIR, reachState, inputBlock,
                                phiBlock)),
                        bodyIR.exactDef.opExactTypeIds[
                            borrowedSourceDef],
                        bodyIR.exactDef.opExactTypeIds[input],
                        bodyIR.exactDef.opExactTypeIds[mergeRow],
                        bodyIR.exactDef.opProducerFunctionRows[input],
                        bodyIR.exactDef.opProducerFunctionRows[
                            mergeRow]))
                exactDefMergeDie(
                    "borrowed phi lift ownership is invalid")
            exactDefMergeBorrowedLiftAppend(
                workspace, input, borrowedSourceDef, sharedOwnerDef,
                inputBlock, bodyIR.blocks[inputBlock].termIndex,
                mergeRow)
        # ---- borrowed merge inputs 登记 (C 64920-64943 →
        #      63348-63549; 用输入拷贝的 recorded source 而非原
        #      pre-edge def, 注释 64727-64730 同源) ----
        if mergeOwnership == Int32(coreir.OwnBorrowShared) ||
           mergeOwnership == Int32(coreir.OwnBorrowUnique):
            ExactDefMergeRegisterBorrowedMergeInputs(
                bodyIR, dom, workspace, reachState, firstInput,
                exactDefMergeOpSourceDefRow(bodyIR.ops[firstInput]),
                firstInputBlock, firstInputPredecessor,
                firstInputPredecessorTerm, secondInput,
                exactDefMergeOpSourceDefRow(bodyIR.ops[secondInput]),
                secondInputBlock, secondInputPredecessor,
                secondInputPredecessorTerm, mergeRow, phiBlock)
    # 出口回写最终双前驱 (C 64945-64948): Cheng 校验器只读, 真空。

# borrowed merge inputs 登记 (C 64920-64943 调用形): 全字段门 +
# 判词映射 + 成双六列追加。公共出口 — 批处理臂与夹具同实现驱动
# (单实现纪律)。
@borrows
fn ExactDefMergeRegisterBorrowedMergeInputs(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var ExactDefMergeWorkspace,
        reachState: var int32[],
        firstInput: int32,
        firstSource: int32,
        firstInputBlock: int32,
        firstPredecessor: int32,
        firstPredecessorTerm: int32,
        secondInput: int32,
        secondSource: int32,
        secondInputBlock: int32,
        secondPredecessor: int32,
        secondPredecessorTerm: int32,
        phiMergeDef: int32,
        phiBlock: int32) =
    let pairGate = exactDefMergeBorrowedMergeInputsGate(
        bodyIR, workspace, reachState, firstInput, firstSource,
        firstInputBlock, firstPredecessor, firstPredecessorTerm,
        secondInput, secondSource, secondInputBlock, secondPredecessor,
        secondPredecessorTerm, phiMergeDef, phiBlock)
    if pairGate == 1:
        exactDefMergeDie("borrowed merge pair identity is invalid")
    if pairGate == 2:
        exactDefMergeDie("borrowed merge pair ownership is invalid")
    if pairGate == 3:
        exactDefMergeDie(
            "unique borrowed merge roots are not identical")
    exactDefMergeBorrowedMergeAppendPair(
        workspace, firstInput, firstSource, firstInputBlock,
        firstPredecessor, firstPredecessorTerm, secondInput,
        secondSource, secondInputBlock, secondPredecessor,
        secondPredecessorTerm, phiMergeDef)

# ---- 臂驱动: join 扫描 + 区间连续性门 + 请求批 ----

fn exactDefMergeArmRun(bodyIR: var coreir.BodyIR) =
    if !bodyIR.controlFlowSealed || bodyIR.blocks.len <= 0:
        return
    var workspace: ExactDefMergeWorkspace
    # 预扫 (无候选 → 零请求直通; lattice/dom 只在 merge 形体上构建)。
    setLen(workspace.opBlockIds, bodyIR.ops.len)
    for op in 0..<bodyIR.ops.len:
        workspace.opBlockIds[op] = -1
    for block in 0..<bodyIR.blocks.len:
        let start = bodyIR.blocks[block].opStart
        let count = bodyIR.blocks[block].opCount
        if start < 0 || count < 0 || start > bodyIR.ops.len - count:
            panic("exact def merge: block op range invalid")
        for op in start..<start + count:
            if workspace.opBlockIds[op] >= 0:
                panic("exact def merge: op block partition drift")
            workspace.opBlockIds[op] = block
    for op in 0..<bodyIR.ops.len:
        if workspace.opBlockIds[op] < 0:
            panic("exact def merge: op block partition drift")
    var sawCandidate = false
    for block in 0..<bodyIR.blocks.len:
        let start = bodyIR.blocks[block].opStart
        let count = bodyIR.blocks[block].opCount
        for opRow in start..<start + count:
            if exactDefMergeRowCandidateShape(
                   bodyIR, workspace, block, opRow):
                sawCandidate = true
                break
        if sawCandidate:
            break
    if !sawCandidate:
        return
    exactDefMergeLatticeBuild(bodyIR, workspace)
    var dom = freeze.ExactDefFreezeDominatorsBuild(bodyIR)
    for joinBlock in 0..<bodyIR.blocks.len:
        let start = bodyIR.blocks[joinBlock].opStart
        let count = bodyIR.blocks[joinBlock].opCount
        var mergeRows: int32[]
        for opRow in start..<start + count:
            if exactDefMergeRowCandidateShape(
                   bodyIR, workspace, joinBlock, opRow):
                add(mergeRows, opRow)
        if mergeRows.len == 0:
            continue
        # 区间连续 (空间不变量 1: merge 定义集中居块首, 不被普通 op
        # 穿插; C 64170-64173 排序注释的空间对应 — 全部 edge actions
        # 先于任何 merge 定义行)。
        var contiguous = true
        for index in 0..<mergeRows.len:
            if mergeRows[index] != start + index:
                contiguous = false
                break
        if !contiguous:
            exactDefMergeDie(
                "managed CFG merge batch edge staging failed")
        # staging 槽逐请求独立 (C 64662 每请求雕刻载体槽)。
        var stagingSlots: int32[]
        for index in 0..<mergeRows.len:
            let staging =
                bodyIR.ops[mergeRows[index]].operands[0]
            for prior in 0..<stagingSlots.len:
                if stagingSlots[prior] == staging:
                    exactDefMergeDie(
                        "managed CFG merge batch edge staging failed")
            add(stagingSlots, staging)
        # 双前驱 (直接 BR 前驱恰二; C 状态门合取的空间对应)。
        var preds: int32[]
        exactDefMergeJoinPreds(bodyIR, joinBlock, preds)
        if preds.len != 2:
            exactDefMergeDie(
                "managed CFG merge batch state is invalid")
        exactDefMergeJoinBatchInto(
            bodyIR, dom, workspace, joinBlock, mergeRows, stagingSlots,
            preds[0], preds[1])

# ---- 公共入口 ----

# derive 定义臂钩子 (批 1 锚点: 挂进 BodyIrExactDefDerive 主体,
# seal 前空间物化)。返回 false 不会出现 — 全族判词走 die;
# 签名与 derive 的 bool 车道对齐以备未来 verdict 车道扩展。
fn ExactDefMergeDeriveArmInto(bodyIR: var coreir.BodyIR): bool =
    if bodyIR.exactDef.sealed:
        panic("exact def merge: derive arm requires unsealed sidecar")
    exactDefMergeArmRun(bodyIR)
    return true

# freeze 组合序入口 (规格 §6.2: merge 校验在批 2 walker 事实之后,
# 批 3 主审消费其产物): cleanup 物化/批 2 read-edge 完成后同一实现
# 幂等重证 (支配依赖子句在此时点为终态)。
fn ExactDefMergeValidateInto(
        bodyIR: var coreir.BodyIR,
        limits: freeze.ExactDefFreezeLimits): bool =
    if !bodyIR.exactDef.sealed:
        panic("exact def merge: validate requires sealed sidecar")
    if !exactdef.BodyIrExactDefSidecarShapeValid(bodyIR):
        panic("exact def merge: validate sidecar shape invalid")
    exactDefMergeArmRun(bodyIR)
    return true

# ---- 批 3 主审 CFG_MERGE 臂 (规格 §6.3 同一行两面; C 69392-69553
#      全字段门 + 21 字段判词; identity 分派处的真实现) ----

# conditional drop reaches predecessor (C 51862-51884 的 Cheng 版):
# 记录消费者是对立前驱上的 consume-only drop (cleanup drop-glue 行,
# consumeActionRow 在界 + 通道① source 边) 且其块支配对立前驱。
@borrows
fn exactDefMergeConditionalDropReachesPredecessor(
        bodyIR: coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        opBlockIds: int32[],
        definition: int32,
        consumePlusOne: int32,
        predecessor: int32): bool =
    if consumePlusOne <= 0 || consumePlusOne > bodyIR.ops.len ||
       predecessor < 0 || predecessor >= bodyIR.blocks.len:
        return false
    let dropOp = consumePlusOne - 1
    if bodyIR.ops[dropOp].consumeActionRow < 0 ||
       !freeze.ExactDefFreezeIdentityOpConsumesDefinition(
           bodyIR, definition, dropOp):
        return false
    let dropBlock = opBlockIds[dropOp]
    if dropBlock < 0:
        return false
    return freeze.ExactDefFreezeMergeBlockDominates(
        dom, dropBlock, predecessor)

@borrows
fn ExactDefMergeCfgMergeDefinitionValid(
        bodyIR: var coreir.BodyIR,
        dom: freeze.ExactDefFreezeDominators,
        workspace: var freeze.ExactDefFreezeWorkspace,
        limits: freeze.ExactDefFreezeLimits,
        phase: str,
        i: int32): bool =
    let op = bodyIR.ops[i]
    let slot = op.valueDefSlot
    let ownership = Int32(op.valueDefOwnership)
    let origin = bodyIR.exactDef.opOriginIds[i]
    let consumePlusOne = op.valueDefConsumeOpIndexPlusOne
    let source = exactDefMergeOpSourceDefRow(op)
    let second =
        freeze.ExactDefFreezeMergeSecondInputRowForMerge(bodyIR, i)
    let mergeBlock = workspace.opBlockIds[i]
    let staging = exactDefMergeOpOperandOrInvalid(op, 0)
    var storage = exactdef.BodyIrExactDefStorageUnknownTag
    if slot >= 0 && slot < bodyIR.localSlots.len:
        storage = bodyIR.exactDef.slotStorageKinds[slot]
    # 双前驱计数 (C 69446-69457: join 块内 term BR 且 true==merge
    # 的块); first_pred=first 侧链尾 (op_c 回收), second_pred=另一。
    var predecessorCount: int32
    var firstPred: int32 = -1
    var secondPred: int32 = -1
    if mergeBlock >= 0:
        if source >= 0 && source < i &&
           workspace.opBlockIds[source] >= 0:
            firstPred = exactDefMergeChainTail(
                bodyIR, workspace.opBlockIds[source], mergeBlock)
        for candidate in 0..<bodyIR.blocks.len:
            let termIndex = bodyIR.blocks[candidate].termIndex
            if termIndex < 0 || termIndex >= bodyIR.terms.len:
                continue
            let term = bodyIR.terms[termIndex]
            if term.kind != coreir.BodyTermBrTag ||
               term.trueBlock != mergeBlock:
                continue
            predecessorCount = predecessorCount + 1
            if candidate != firstPred:
                secondPred = candidate
    var firstOwnership = Int32(coreir.OwnInvalid)
    if source >= 0 && source < i:
        firstOwnership = Int32(bodyIR.ops[source].valueDefOwnership)
    var secondOwnership = Int32(coreir.OwnInvalid)
    if second >= 0 && second < i:
        secondOwnership = Int32(bodyIR.ops[second].valueDefOwnership)
    let firstBorrow =
        firstOwnership == Int32(coreir.OwnBorrowShared) ||
        firstOwnership == Int32(coreir.OwnBorrowUnique)
    let secondBorrow =
        secondOwnership == Int32(coreir.OwnBorrowShared) ||
        secondOwnership == Int32(coreir.OwnBorrowUnique)
    let firstOwned = firstOwnership == Int32(coreir.OwnMove) ||
        firstOwnership == Int32(coreir.OwnPlain)
    let secondOwned = secondOwnership == Int32(coreir.OwnMove) ||
        secondOwnership == Int32(coreir.OwnPlain)
    let moveMerge = firstOwned && secondOwned
    let borrowMerge = firstBorrow && secondBorrow
    # unique_borrow_merge (C 69480-69483 →  borrowed merge 权威):
    # 双 BU 输入且其 recorded source 的借用根冻结三列逐值相等
    # (规格 §3, 与登记表 unique 检查同列)。
    var uniqueBorrowMerge = false
    if borrowMerge &&
       firstOwnership == Int32(coreir.OwnBorrowUnique) &&
       secondOwnership == Int32(coreir.OwnBorrowUnique):
        let firstSourceDef =
            exactDefMergeOpSourceDefRow(bodyIR.ops[source])
        let secondSourceDef =
            exactDefMergeOpSourceDefRow(bodyIR.ops[second])
        if firstSourceDef >= 0 && firstSourceDef < bodyIR.ops.len &&
           secondSourceDef >= 0 && secondSourceDef < bodyIR.ops.len:
            uniqueBorrowMerge = exactDefMergeBorrowRootsIdentical(
                bodyIR.ops[firstSourceDef], bodyIR.ops[secondSourceDef])
    var expected: int32
    if firstOwnership == Int32(coreir.OwnPlain) &&
       secondOwnership == Int32(coreir.OwnPlain) &&
       storage == exactdef.BodyIrExactDefStoragePlainTag:
        expected = Int32(coreir.OwnPlain)
    elif moveMerge:
        expected = Int32(coreir.OwnMove)
    elif uniqueBorrowMerge:
        expected = Int32(coreir.OwnBorrowUnique)
    else:
        expected = Int32(coreir.OwnBorrowShared)
    var firstConsume: int32
    if source >= 0 && source < i:
        firstConsume = bodyIR.ops[source].valueDefConsumeOpIndexPlusOne
    var secondConsume: int32
    if second >= 0 && second < i:
        secondConsume = bodyIR.ops[second].valueDefConsumeOpIndexPlusOne
    # consume 容忍三车道 (C 69503-69524): ==i+1 / conditional drop 到
    # 对立前驱 / 互斥消费者对; 借用输入须 consume==0。
    var firstConsumeValid = firstConsume == 0
    var secondConsumeValid = secondConsume == 0
    if firstOwned:
        firstConsumeValid = firstConsume == i + 1 ||
            exactDefMergeConditionalDropReachesPredecessor(
                bodyIR, dom, workspace.opBlockIds, source,
                firstConsume, secondPred) ||
            (firstConsume > 0 &&
             freeze.ExactDefFreezeMergeMutuallyExclusiveConsumerPairValid(
                 bodyIR, dom, workspace, limits, source, i,
                 firstConsume - 1))
    if secondOwned:
        secondConsumeValid = secondConsume == i + 1 ||
            exactDefMergeConditionalDropReachesPredecessor(
                bodyIR, dom, workspace.opBlockIds, second,
                secondConsume, firstPred) ||
            (secondConsume > 0 &&
             freeze.ExactDefFreezeMergeMutuallyExclusiveConsumerPairValid(
                 bodyIR, dom, workspace, limits, second, i,
                 secondConsume - 1))
    var firstCurrent = false
    if source >= 0 && source < i && firstPred >= 0:
        firstCurrent =
            freeze.ExactDefFreezeIdentityIsCurrentAtPredecessor(
                bodyIR, dom, workspace.opBlockIds, source, firstPred, i)
    var secondCurrent = false
    if second >= 0 && second < i && secondPred >= 0:
        secondCurrent =
            freeze.ExactDefFreezeIdentityIsCurrentAtPredecessor(
                bodyIR, dom, workspace.opBlockIds, second, secondPred, i)
    var sourceSlot: int32 = -1
    var secondSlot: int32 = -1
    if source >= 0 && source < bodyIR.ops.len:
        sourceSlot = bodyIR.ops[source].valueDefSlot
    if second >= 0 && second < bodyIR.ops.len:
        secondSlot = bodyIR.ops[second].valueDefSlot
    let sourceBlock = workspace.opBlockIds[source]
    let secondBlock = workspace.opBlockIds[second]
    if op.kind != coreir.BodyOpCopyLocalTag ||
       op.target != slot ||
       origin != i || source < 0 || source >= i ||
       second < 0 || second >= i || second == source ||
       mergeBlock < 0 || predecessorCount != 2 ||
       firstPred < 0 || firstPred >= bodyIR.blocks.len ||
       secondPred < 0 ||
       consumePlusOne < 0 ||
       staging < 0 || staging >= bodyIR.localSlots.len ||
       sourceSlot != staging || secondSlot != staging ||
       (!moveMerge && !borrowMerge) ||
       ownership != expected ||
       !firstCurrent || !secondCurrent ||
       !firstConsumeValid || !secondConsumeValid:
        exactDefMergeVerdictEmit(
            exactDefMergeCfgMergeBrokenLine(
                phase, bodyIR.controlFunctionRow, i, mergeBlock,
                predecessorCount, firstPred, secondPred, source,
                sourceBlock, second, secondBlock, staging, sourceSlot,
                secondSlot, firstConsume, secondConsume,
                exactDefMergeBoolInt(firstCurrent),
                exactDefMergeBoolInt(secondCurrent),
                exactDefMergeBoolInt(firstConsumeValid),
                exactDefMergeBoolInt(secondConsumeValid),
                ownership, expected))
        return false
    return true

# ---- 夹具专用出口 (与批 2/批 3 同例: 判词文本断言与登记表守卫
#      直接驱动; 零逻辑新增) ----

@borrows
fn ExactDefMergeTestMismatchLine(bodyIR: coreir.BodyIR,
                                 requestIndex: int32,
                                 requestCount: int32,
                                 localName: str,
                                 firstDef: int32,
                                 secondDef: int32,
                                 currentFirst: int32,
                                 currentSecond: int32,
                                 mergeBlock: int32,
                                 firstTerm: int32,
                                 secondTerm: int32,
                                 firstReaches: int32,
                                 secondReaches: int32): str =
    return exactDefMergeMismatchLine(
        bodyIR, requestIndex, requestCount, localName, firstDef,
        secondDef, currentFirst, currentSecond, mergeBlock, firstTerm,
        secondTerm, firstReaches, secondReaches)

@borrows
fn ExactDefMergeTestCfgMergeBrokenLine(phase: str,
                                       functionRow: int32,
                                       opRow: int32,
                                       mergeBlock: int32,
                                       predecessorCount: int32,
                                       firstPred: int32,
                                       secondPred: int32,
                                       source: int32,
                                       sourceBlock: int32,
                                       second: int32,
                                       secondBlock: int32,
                                       operand: int32,
                                       sourceSlot: int32,
                                       secondSlot: int32,
                                       firstConsume: int32,
                                       secondConsume: int32,
                                       firstCurrent: int32,
                                       secondCurrent: int32,
                                       firstConsumeValid: int32,
                                       secondConsumeValid: int32,
                                       ownership: int32,
                                       expected: int32): str =
    return exactDefMergeCfgMergeBrokenLine(
        phase, functionRow, opRow, mergeBlock, predecessorCount,
        firstPred, secondPred, source, sourceBlock, second, secondBlock,
        operand, sourceSlot, secondSlot, firstConsume, secondConsume,
        firstCurrent, secondCurrent, firstConsumeValid,
        secondConsumeValid, ownership, expected)

fn ExactDefMergeTestBorrowedMergeAppend(
        workspace: var ExactDefMergeWorkspace,
        firstInput: int32,
        firstSource: int32,
        firstInputBlock: int32,
        firstPredecessor: int32,
        firstPredecessorTerm: int32,
        secondInput: int32,
        secondSource: int32,
        secondInputBlock: int32,
        secondPredecessor: int32,
        secondPredecessorTerm: int32,
        phiMergeDef: int32) =
    exactDefMergeBorrowedMergeAppendPair(
        workspace, firstInput, firstSource, firstInputBlock,
        firstPredecessor, firstPredecessorTerm, secondInput,
        secondSource, secondInputBlock, secondPredecessor,
        secondPredecessorTerm, phiMergeDef)

# storage 门直驱 (夹具双 UNKNOWN→PLAIN 腿; 与批门同实现)。
@borrows
fn ExactDefMergeTestPlanStorageGate(bodyIR: coreir.BodyIR,
                                    firstSlot: int32,
                                    secondSlot: int32,
                                    canonicalSlot: int32,
                                    localName: str,
                                    localKind: int32): int32 =
    return exactDefMergePlanStorageGate(
        bodyIR, firstSlot, secondSlot, canonicalSlot, localName,
        localKind)

# join 块入态查询 (夹具 global shadow 腿: 重建 lattice 后读 join 点
# 双前驱 blockEndStates 汇合值; is_global 同 GlobalDef 行通道的
# 可执行证明面 — Ambiguous ⇒ 请求, 同定义 ⇒ 不收)。
fn ExactDefMergeTestJoinEntryStateForFixture(
        bodyIR: var coreir.BodyIR,
        joinBlock: int32,
        slot: int32): int32 =
    if !bodyIR.controlFlowSealed || bodyIR.blocks.len <= 0 ||
       joinBlock < 0 || joinBlock >= bodyIR.blocks.len ||
       slot < 0 || slot >= bodyIR.localSlots.len:
        return ExactDefMergeStateUnreached
    var workspace: ExactDefMergeWorkspace
    exactDefMergeLatticeBuild(bodyIR, workspace)
    return exactDefMergeBlockEntryState(
        bodyIR, workspace, joinBlock, slot)

type ExactDefMergeTestWorkspace = ExactDefMergeWorkspace

# borrow 根相等 (冻结三列逐值相等; identity param_root CFG_MERGE
# 归约臂同源调用 — 单实现, 禁止第二份逐字拷贝)。
@borrows
fn ExactDefMergeBorrowRootsIdenticalForIdentity(
        firstOp: coreir.BodyOp,
        secondOp: coreir.BodyOp): bool =
    return exactDefMergeBorrowRootsIdentical(firstOp, secondOp)
