# exact_def_merge — ExactDef 批 4: CFG merge batch + 借用合并权威
# (docs/cheng-exact-def-rewrite-design.md §4 批 4 / §5 / §7-4;
# 算法照 docs/cheng-exact-def-batch4-merge-spec.md 全条款移植,
# C 行号证据逐条锚定在注释中: cold_merge_exact_local_defs_batch
# cold_parser.c:64371-64950, cold_insert_exact_phi_input_copy_on_sealed_edge
# 63671-63950, borrowed 登记表 63143-63549, reaches_merge 63970-64050,
# 批 3 主审 CFG_MERGE 臂 cheng_cold.c:69392-69553)。
#
# 职责 (规格 §1-§6):
#   1. merge 请求发现 (seal 后空间形态, 规格 §4/§6.4): join 块双前驱
#      blockEndStates 对应位 (domain,row) 定义不同 → merge 请求; C 的
#      open join 门 (64188-64192) 由「join 块首连续 merge 定义区间」
#      空间不变量整体替代 (无解析期 open 块, 规格 §4 头)。
#      global shadow 同 GlobalDef 行通道 (规格 §2.1 is_global 分支/§5
#      首红样例): 双 GLOBAL_ADDR remat 同 origin (place GLOBAL + op
#      GlobalLoad + own BORROW_SHARED + origin 相等) → 证同定义, 不收
#      merge 请求 (首红样例形态转绿); exactly_one_unavailable 独立链
#      = 单臂不到 join, 不收请求 (注释锚定); 混合 owned+borrowed 的
#      lift 标记 (规格 §1.2 64390-64393)。
#   2. merge 定义 derive 臂 (发射权威): join 块首连续 merge 定义区间
#      物化 — 规格 §4 九条空间不变量逐条 (区间连续 / input copy 块末行
#      / 边链链尾==merge 行 op_c 对应块 / 双前驱 BR+全路径到达 / merge
#      三输入+自环 read-edge / edge actions 物理居前 / destination 与
#      源槽门 / storage 门含双 UNKNOWN→PLAIN / ownership 四值门+
#      plan-drift); ref normalize 双臂 / preserve_unique_borrow (borrow
#      根相等=冻结 valueDefBorrowOwner 三列逐值相等, 规格 §3) /
#      independent_plain_merge 降级 / transfer ownership (规格 §1.3) /
#      loop destination_override=entry_slot vs branch -1。
#   3. 借用登记: borrowed merge inputs 六列对表 + borrowed phi lift 六
#      列表 (规格 §1.4, 判词族逐字); loop 借用→owned 提升事件 (规格
#      §2.2 89452-89476, `loop borrowed merge promotion state is
#      invalid` 实检; `borrowed merge event order is invalid` 单遍重推
#      导下真空锚定)。
#   4. 判词族全 10 条 (规格 §1.5) + 附属提交核对判词逐字; 21 字段
#      mismatch 实打印 29 值以规格 §1.2 清单为准。
#   5. 与批 3 主审的接口 (规格 §6.3 同一行两面): merge 行受批 3 主审
#      CFG_MERGE 臂 21 字段 `managed CFG merge definition is broken`
#      校验 — ExactDefMergeCfgMergeDefinitionValid 即批 3 panic 锚的
#      真实现 (批 4 管发射权威, 批 3 管 seal 后主审)。
#
# Cheng 基板差异裁定 (规格 §6, 逐条在对应处注释):
#   - merge 定义是物理 CopyLocal 行 + 侧车戳 (place=CFG_MERGE/own/
#     destination), ManagedDefinitionIndex 派生 ordinal 由行空间天然
#     承载; C 的 op_b/op_c 两列 (第二输入+第一前驱块) 在 Cheng BodyOp
#     无列 — 由空间不变量回收: 第二输入=staging 槽双尾拷贝中非结构
#     source 者 (批 2 通道③同实现), op_c=first 侧边链链尾块 (join 的
#     直接 first 前驱)。
#   - 状态门 `managed CFG merge batch state is invalid` 的 parser/null
#     合取无 Cheng 载体 (值类型), 前驱越界/双前驱相等合取保留;
#     open join 门真空 (规格 §6.4-4); plans calloc OOM die 无 Cheng
#     载体 (arena panic 覆盖, 批 2 同裁定)。
#   - 派生根求值 (C cold_exact_var_owner_root_definition 沿 source/
#     origin 游走) 不移植 — borrow 根相等=冻结 valueDefBorrowOwner
#     {SemanticRow,DefinitionDomain,DefinitionRow} 三列逐值相等
#     (规格 §3 裁定, 与批 3 投影权威同吃这三列)。
#   - 判词文本逐字保留 C (含 cheng_cold: 前缀与字段序); 基板替换仅
#     两处 (批 1-3 先例): %.*s 函数名 → controlFunctionRow int32;
#     local 名 → merge destination 槽 LocalSlot.name (确定性强排投影,
#     非身份键)。探针残留 (([smgw])/([prd])/([ev0])/([ev1])/[ev]/
#     CHENG_COLD_DISABLE_PHI_REMAT 环境开关) 不移植 (规格 §0/§6.6)。
#   - storage 读 recorded 侧车列 (derive 落戳即规范义务, 批 3 §2 同
#     源裁定); 双 UNKNOWN→PLAIN 条款保留 (cold_parser.c:64421-64423
#     镜像, 规格 §1.2 storage 门)。
#   - C 的 `managed CFG merge batch lacks an open join block` /
#     `managed conditional merge definition was not committed` /
#     `managed multi-line if merge definition was not committed` /
#     `managed loop phi close state is invalid` /
#     `managed loop phi requires one open natural backedge` /
#     `managed loop local identity query is invalid` /
#     `managed loop global shadow lacks exact identity` — 解析期 open
#     块/提交核对载体在 Cheng 无对应物, 真空锚定 (本注释即判词保真
#     锚点, 任何未来产生对应上游形态即被对应门接住)。
#   - cold_eager_unique_var_param_cell_view (64689-64692): Cheng 无
#     cell-view 载体 (批 3 同族真空裁定), BU merge 戳即全部权威。
#
# 身份纪律: 一切跨节点身份 int32 行 (op 行/槽行/块行/TypeId/函数行),
# 零文本零名字键 (判词投影段除外 — 单行确定性强排投影)。

import std/strformat
import std/os
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/lang/typed_expr_type_arena as typearena

const
    # 点活性 lattice 状态值 (body_ir_access.cheng:187-189 逐值对齐;
    # merge 域语义: join 点双前驱当前定义不同的汇合标记即请求触发,
    # 规格 §6.4-4)。
    ExactDefMergeStateUnreached = -3
    ExactDefMergeStateAmbiguous = -2
    ExactDefMergeStateConsumed = -1
    # entry 域定义 (entry ownership 权威, 无 op 行) 的 lattice 值。
    ExactDefMergeStateEntryDef = -4

type
    # merge 请求 (ColdExactLocalMergeRequest 的 Cheng 空间形,
    # cold_parser.c:64338-64347)。local 指针合取由 destination 槽行
    # 承载; first/second_def 为两臂当前定义 op 行; destination_override
    # 空间回收: dst==first_slot → entry_slot (loop), 否则 -1 (branch)。
    ExactDefMergeRequest =
        mergeRow: int32
        destination: int32
        firstDef: int32
        secondDef: int32
        destinationOverride: int32
        firstInputDef: int32
        secondInputDef: int32
        preserveUniqueBorrow: bool

    # merge 计划 (ColdExactLocalMergePlan 的 Cheng 空间形,
    # cold_parser.c:64349-64365)。input_predecessor(+term) 为原始前驱
    # (被封边块) 行; first/secondSidePred 为两侧边链链尾块 (op_c 回收)。
    ExactDefMergePlan =
        sourceSlot: int32
        destination: int32
        storage: int32
        mergeOwnership: int32
        firstInputBlock: int32
        secondInputBlock: int32
        firstInputPredecessor: int32
        secondInputPredecessor: int32
        firstInputPredecessorTerm: int32
        secondInputPredecessorTerm: int32
        liftFirstBorrowed: bool
        liftSecondBorrowed: bool
        normalizeFirstRefValue: bool
        normalizeSecondRefValue: bool
        preserveUniqueBorrow: bool
        firstSidePred: int32
        secondSidePred: int32

    # 单遍工作区 (规格 §7-4 六列精确列供数 + lattice/DFS 列)。
    ExactDefMergeWorkspace =
        opBlockIds: int32[]
        blockEndStates: int32[]        # blockCount*slotCount lattice
        blockReached: bool[]
        joinPredCount: int32[]         # 每块直接 BR 前驱计数
        # borrowed 登记表 (C 六列对的 Cheng 重推导形; 单遍消费)。
        borrowedLiftInputOps: int32[]
        borrowedLiftSourceDefs: int32[]
        borrowedLiftSharedOwners: int32[]
        borrowedLiftInputBlocks: int32[]
        borrowedLiftInputTerms: int32[]
        borrowedLiftPhiMergeDefs: int32[]
        borrowedMergeInputOps: int32[]
        borrowedMergeSourceDefs: int32[]
        borrowedMergeInputBlocks: int32[]
        borrowedMergeInputPredecessors: int32[]
        borrowedMergeInputTerms: int32[]
        borrowedMergePhiMergeDefs: int32[]

# ---- verdict / die 基座 (批 2 同铭文) ----

@borrows
fn exactDefMergeVerdictEmit(line: str) =
    os.WriteLine(os.Get_stderr(), line)
    os.C_fflush(os.Get_stderr())

# C die 语义 (merge 族全 10 条 + phi-input/借用登记/loop 族):
# stderr 单行确定 + 进程退出, 不返。
@borrows
fn exactDefMergeDie(line: str) =
    os.WriteLine(os.Get_stderr(), line)
    os.C_fflush(os.Get_stderr())
    os.os_exit_bridge(2)

fn exactDefMergeBoolInt(value: bool): int32 =
    if value:
        return 1
    return 0

@borrows
fn exactDefMergeOpOperandOrInvalid(op: coreir.BodyOp,
                                   ordinal: int32): int32 =
    if ordinal < 0 || ordinal >= op.operands.len:
        return -1
    return op.operands[ordinal]

# ---- 判词文本构建器 (C 文本逐字保留, 含 cheng_cold: 前缀与字段序;
#      基板替换: %.*s 函数名 → controlFunctionRow int32, local 名 →
#      destination 槽 LocalSlot.name, 见模块头) ----

# 21 字段 mismatch (实打印 29 值, 规格 §1.2 清单; C 64277-64337)。
#  guarded deref 镜像: def 越界 → 派生列 -1, slot 越界 → kind -1。
@borrows
fn exactDefMergeMismatchLine(bodyIR: coreir.BodyIR,
                             requestIndex: int32,
                             requestCount: int32,
                             localName: str,
                             firstDef: int32,
                             secondDef: int32,
                             currentFirst: int32,
                             currentSecond: int32,
                             mergeBlock: int32,
                             firstTerm: int32,
                             secondTerm: int32,
                             firstReaches: int32,
                             secondReaches: int32): str =
    var firstSlot: int32 = -1
    var secondSlot: int32 = -1
    var firstKind: int32 = -1
    var secondKind: int32 = -1
    var firstType: int32 = -1
    var secondType: int32 = -1
    var firstPlace: int32 = -1
    var secondPlace: int32 = -1
    var firstOwnership: int32 = -1
    var secondOwnership: int32 = -1
    var firstOrigin: int32 = -1
    var secondOrigin: int32 = -1
    var firstOpKind: int32 = -1
    var secondOpKind: int32 = -1
    var firstFn: int32 = -1
    var secondFn: int32 = -1
    if firstDef >= 0 && firstDef < bodyIR.ops.len:
        firstSlot = bodyIR.ops[firstDef].valueDefSlot
        firstType = bodyIR.exactDef.opExactTypeIds[firstDef]
        firstPlace = bodyIR.exactDef.opPlaceKinds[firstDef]
        firstOwnership = Int32(bodyIR.ops[firstDef].valueDefOwnership)
        firstOrigin = bodyIR.exactDef.opOriginIds[firstDef]
        firstOpKind = bodyIR.ops[firstDef].kind
        firstFn = bodyIR.exactDef.opProducerFunctionRows[firstDef]
        if firstSlot >= 0 && firstSlot < bodyIR.localSlots.len:
            firstKind = bodyIR.localSlots[firstSlot].typeKind
        else:
            firstKind = -1
    if secondDef >= 0 && secondDef < bodyIR.ops.len:
        secondSlot = bodyIR.ops[secondDef].valueDefSlot
        secondType = bodyIR.exactDef.opExactTypeIds[secondDef]
        secondPlace = bodyIR.exactDef.opPlaceKinds[secondDef]
        secondOwnership = Int32(bodyIR.ops[secondDef].valueDefOwnership)
        secondOrigin = bodyIR.exactDef.opOriginIds[secondDef]
        secondOpKind = bodyIR.ops[secondDef].kind
        secondFn = bodyIR.exactDef.opProducerFunctionRows[secondDef]
        if secondSlot >= 0 && secondSlot < bodyIR.localSlots.len:
            secondKind = bodyIR.localSlots[secondSlot].typeKind
        else:
            secondKind = -1
    return Fmt"cheng_cold: managed CFG merge batch definition mismatch body={bodyIR.controlFunctionRow} request={requestIndex}/{requestCount} local={localName} first_def={firstDef} second_def={secondDef} first_pred={currentFirst} second_pred={currentSecond} merge_block={mergeBlock} first_term={firstTerm} second_term={secondTerm} first_reaches={firstReaches} second_reaches={secondReaches} first_slot={firstSlot} second_slot={secondSlot} first_kind={firstKind} second_kind={secondKind} first_type={firstType} second_type={secondType} first_place={firstPlace} second_place={secondPlace} first_ownership={firstOwnership} second_ownership={secondOwnership} first_origin={firstOrigin} second_origin={secondOrigin} first_op_kind={firstOpKind} second_op_kind={secondOpKind} first_fn={firstFn} second_fn={secondFn} body_fn={bodyIR.controlFunctionRow}"

# storage 门前导 fprintf (C 64630-64638) + die `managed CFG merge batch
# storage identities differ`。
@borrows
fn exactDefMergeStorageLine(bodyIR: coreir.BodyIR,
                            localName: str,
                            firstSlot: int32,
                            secondSlot: int32,
                            firstStorage: int32,
                            secondStorage: int32,
                            kind: int32): str =
    return Fmt"cheng_cold: merge batch storage fn={bodyIR.controlFunctionRow} local={localName} first_slot={firstSlot} second_slot={secondSlot} first_storage={firstStorage} second_storage={secondStorage} kind={kind}"

# 物理源自环前导 ([sdbg]) fprintf (C 64836-64853, 属诊断格式一部分,
# 规格 §1.5-10) + die `managed CFG merge physical source set is invalid`。
@borrows
fn exactDefMergeSdbgLine(mergeDef: int32,
                         pre: int32,
                         edge: int32,
                         firstInput: int32,
                         secondInput: int32,
                         firstExactType: int32,
                         secondExactType: int32,
                         mergeExactType: int32): str =
    return Fmt"([sdbg]) md={mergeDef} pre={pre} edge={edge} f={firstInput} s={secondInput} fet={firstExactType} set={secondExactType} met={mergeExactType}"

# 批 3 主审 CFG_MERGE 臂 21 字段判词 (cheng_cold.c:69551 逐字,
# 规格 §6.3; identity schema 行前缀同批 3 各臂)。
@borrows
fn exactDefMergeCfgMergeBrokenLine(phase: str,
                                   functionRow: int32,
                                   opRow: int32,
                                   mergeBlock: int32,
                                   predecessorCount: int32,
                                   firstPred: int32,
                                   secondPred: int32,
                                   source: int32,
                                   sourceBlock: int32,
                                   second: int32,
                                   secondBlock: int32,
                                   operand: int32,
                                   sourceSlot: int32,
                                   secondSlot: int32,
                                   firstConsume: int32,
                                   secondConsume: int32,
                                   firstCurrent: int32,
                                   secondCurrent: int32,
                                   firstConsumeValid: int32,
                                   secondConsumeValid: int32,
                                   ownership: int32,
                                   expected: int32): str =
    return Fmt"cheng_cold: exact identity schema [{phase}] fn={functionRow} op row={opRow} managed CFG merge definition is broken merge_block={mergeBlock} predecessor_count={predecessorCount} first_pred={firstPred} second_pred={secondPred} source={source} source_block={sourceBlock} second={second} second_block={secondBlock} operand={operand} source_slot={sourceSlot} second_slot={secondSlot} first_consume={firstConsume} second_consume={secondConsume} first_current={firstCurrent} second_current={secondCurrent} first_consume_valid={firstConsumeValid} second_consume_valid={secondConsumeValid} ownership={ownership} expected={expected}"

