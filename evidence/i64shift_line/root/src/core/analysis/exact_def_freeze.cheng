# ---- 批 5 同源出口 (exact_def_call_authority 的批 3 基元复用面) ----
#
# 批 5 (var-out 分类器 + 调用权威三族 + seal root 校验 + 程序契约) 需要的
# 三个批 3 域谓词 (param 定义边 / 点前活性查询 / 借用根冻结权威) 按批 4
# typeFact 四 helper 同款裁定迁入本模块持单实现 (identity 留委托别名,
# 调用方经本出口同源复用 — 结构上不可能出现第二份逐字实现; 规格
# docs/cheng-exact-def-batch5-authority-spec.md §6 「全部批 3 单实现复
# 用, 禁止重实现」)。迁入背景: 批 5 首版在 identity 加同名出口段时死
# 点行号漂移 (其后定案真源为 body_ir_exact_def 的契约函数, identity
# 实证在死点后; 迁移保留 — 单实现归位与批 4 typeFact 先例一致, 零漂
# 移口径下对死点前模块新增函数一律禁止)。实现逐字自 identity.cheng
# 迁入 (谓词本体零改动)。
# 调用方纪律: 与批 2 验证器同 — sealed 侧车 + 已建支配缓存/工作区。

# param 定义边谓词 (自 identity.cheng exactDefIdentityParamDefinitionEdgeValid
# 逐字迁入; C 69054-69106 参数臂的边子句)。
@borrows
fn ExactDefFreezeAuthorityParamDefinitionEdgeValid(
        bodyIR: coreir.BodyIR,
        opRow: int32): bool =
    if opRow < 0 || opRow >= bodyIR.ops.len:
        return false
    if bodyIR.exactDef.opPlaceKinds[opRow] !=
           exactdef.BodyIrExactDefPlaceParamTag:
        return false
    let origin = bodyIR.exactDef.opOriginIds[opRow]
    if origin < 0 || origin >= bodyIR.entryParameterSlotIds.len:
        return false
    let rawSlot = bodyIR.entryParameterSlotIds[origin]
    if rawSlot < 0 || rawSlot >= bodyIR.localSlots.len:
        return false
    let op = bodyIR.ops[opRow]
    if op.valueDefSlot != rawSlot || op.target != rawSlot:
        return false
    let ownership = op.valueDefOwnership
    let uniqueBorrow = ownership == coreir.OwnBorrowUnique
    let sharedBorrow = ownership == coreir.OwnBorrowShared
    let borrowed = uniqueBorrow || sharedBorrow
    let local = bodyIR.localSlots[rawSlot]
    var physicalRef = local.typeKind == coreir.LocalPtrTag
    if !physicalRef && local.typeArenaTypeId >= 0:
        physicalRef = ExactDefFreezeTypeFactStructuralKind(
            bodyIR, local.typeArenaTypeId) ==
            Int32(typearena.TypedExprStructuralTypeRefObject)
    var rawIsArray = false
    var rawIsObject = false
    if local.typeArenaTypeId >= 0:
        let structural = ExactDefFreezeTypeFactStructuralKind(
            bodyIR, local.typeArenaTypeId)
        rawIsArray = structural ==
            Int32(typearena.TypedExprStructuralTypeFixedArray)
        rawIsObject = structural ==
            Int32(typearena.TypedExprStructuralTypeObject)
    if op.kind != coreir.BodyOpLoadLocalTag || op.operands.len != 0:
        return false
    if exactDefFreezeOpSourceDefRow(op) != -1:
        return false
    let ownershipValid =
        (!borrowed &&
         (ownership == coreir.OwnMove ||
          ownership == coreir.OwnPlain)) ||
        (borrowed && uniqueBorrow &&
         (physicalRef || rawIsArray || rawIsObject)) ||
        (borrowed && sharedBorrow && !physicalRef)
    if !ownershipValid:
        return false
    return !borrowed || op.valueDefConsumeOpIndexPlusOne == 0

# 点前活性查询 (自 identity.cheng exactDefIdentityIsLiveBeforeOp 逐字迁入;
# C 55968-56043 同块快道+全体 dataflow)。
@borrows
fn ExactDefFreezeAuthorityIsLiveBeforeOp(
        bodyIR: var coreir.BodyIR,
        dom: ExactDefFreezeDominators,
        workspace: var ExactDefFreezeWorkspace,
        limits: ExactDefFreezeLimits,
        definition: int32,
        consumer: int32): bool =
    if definition < 0 || definition >= bodyIR.ops.len ||
       consumer < 0 || consumer >= bodyIR.ops.len ||
       definition == consumer:
        return false
    let block = workspace.opBlockIds[consumer]
    let definitionBlock = workspace.opBlockIds[definition]
    if block >= 0 && definitionBlock == block && definition < consumer:
        for op in definition + 1..<consumer:
            if (exactDefFreezeOpNamesDefinitionCandidate(
                    bodyIR, definition, op) &&
                exactDefFreezeOpConsumesDefinition(
                    bodyIR, definition, op)) ||
               exactDefFreezeOwnedSlotOverwriteConsumes(
                   bodyIR, definition, op):
                return false
        return true
    if block < 0:
        return false
    var exitState: int32
    return exactDefFreezeConsumptionDataflowFrom(
        bodyIR, dom, workspace, limits, definition, 0,
        bodyIR.blocks.len, ExactDefFreezeStateUndefinedTag,
        block, consumer, exitState) &&
        exitState == ExactDefFreezeStateLiveTag

# 借用根冻结权威 (自 identity.cheng exactDefIdentityBorrowResultRootValid
# 逐字迁入; cold_borrow_result_root_valid 的 Cheng 基板裁定 — 冻结
# borrow-owner 列在界即根已证, 上游不变式放电)。
@borrows
fn ExactDefFreezeAuthorityBorrowResultRootValid(
        bodyIR: coreir.BodyIR,
        source: int32): bool =
    if source < 0 || source >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[source]
    if op.valueDefOwnership != coreir.OwnBorrowShared &&
       op.valueDefOwnership != coreir.OwnBorrowUnique:
        return false
    if op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        return op.valueDefBorrowOwnerDefinitionRow >= 0 &&
               op.valueDefBorrowOwnerDefinitionRow < bodyIR.ops.len
    if op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        return op.valueDefBorrowOwnerDefinitionRow >= 0 &&
               op.valueDefBorrowOwnerDefinitionRow <
                   bodyIR.localSlots.len
    return false
