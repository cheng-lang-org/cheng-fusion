import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout
import cheng/std/rawbytes
import cheng/std/crypto/hash256

# Canonical production receipt for replacing an initialized managed lvalue.
#
# The physical operation is one exact managed-store CallOp.  Its semantic
# managedStoreKind pins the runtime protocol that captures the old record,
# validates/retains the new record when required, releases the old owner, and
# only then publishes the new record.  Linker text is never an identity: the
# call is bound by function-table row plus semantic CID.
#
# Target identities and projection paths are immutable int32 rows in the
# current BodyIR/TypedExpr domains.  The receipt is stored as SoA/CSR and sealed
# before admission.  Raw managed GlobalStore/FieldStore/IndexedStore operations
# are rejected; self-alias is represented only as an exact no-op row.

const ManagedLvalueTargetGlobal: int32 = 1
const ManagedLvalueTargetField: int32 = 2
const ManagedLvalueTargetIndexed: int32 = 3

const ManagedLvaluePathField: int32 = 1
const ManagedLvaluePathIndexed: int32 = 2

const ManagedLvalueReplaceMove: int32 = 1
const ManagedLvalueReplaceBorrowLift: int32 = 2
const ManagedLvalueReplaceSelfAliasNoOp: int32 = 3
const ManagedLvalueReplaceAddressAbiSizeBytes: int32 = 8
const ManagedLvalueReplaceStorePreflightStr: int32 = 1
const ManagedLvalueReplaceStorePreflightPlainSequence: int32 = 2
const ManagedLvalueReplaceStorePreflightAggregate: int32 = 3

# Frozen binary drop-glue schema consumed by the unique aggregate managed
# replace intrinsic.  Tags describe physical value layout, never source text.
const ManagedDropGlueSchemaMagic: int32 = 1129139282
const ManagedDropGlueSchemaVersion: int32 = 1
const ManagedDropGlueNodePlain: int32 = 1
const ManagedDropGlueNodeStr: int32 = 2
const ManagedDropGlueNodeSequence: int32 = 3
const ManagedDropGlueNodeAggregate: int32 = 4
const ManagedDropGlueNodeFixedArray: int32 = 5
const ManagedDropGlueNodeOptional: int32 = 6
const ManagedDropGlueNodeEnum: int32 = 7
const ManagedDropGlueNodeAlias: int32 = 8
const ManagedDropGlueNodeRefObject: int32 = 9

type
    ManagedLvalueReplacePlan =
        prepared: bool
        sealed: bool
        functionRow: int32 = -1
        typeArenaArtifactCid: layout.FixedBytes32
        targetKinds: int32[]
        replaceModes: int32[]
        targetLvalueRows: int32[]
        sourceLvalueRows: int32[]
        targetRootStorageRows: int32[]
        targetRootDefinitionDomains: int32[]
        targetRootDefinitionRows: int32[]
        targetSlotIds: int32[]
        targetTypeIds: int32[]
        sourceDefinitionDomains: int32[]
        sourceDefinitionRows: int32[]
        sourceSlotIds: int32[]
        sourceSemanticRows: int32[]
        replaceOpIds: int32[]
        consumeActionRows: int32[]
        runtimeFunctionRows: int32[]
        runtimeSemanticCids: layout.FixedBytes32[]
        pathStarts: int32[]
        pathCounts: int32[]
        pathKinds: int32[]
        pathParentDefinitionDomains: int32[]
        pathParentDefinitionRows: int32[]
        pathMemberRows: int32[]
        pathResultTypeIds: int32[]
        pathByteOffsets: int32[]
        pathByteWidths: int32[]
        sealedFingerprint: int64

    ManagedLvalueReplaceProductionAction =
        valid: bool
        targetKind: int32
        replaceMode: int32
        targetLvalueRow: int32 = -1
        sourceLvalueRow: int32 = -1
        targetRootStorageRow: int32 = -1
        targetSlotId: int32 = -1
        targetTypeId: int32 = -1
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        sourceSlotId: int32 = -1
        sourceSemanticRow: int32 = -1
        replaceOpId: int32 = -1
        consumeActionRow: int32 = -1
        runtimeFunctionRow: int32 = -1
        runtimeSemanticCid: layout.FixedBytes32
        sourceArgPassKind: int32 = -1

    ManagedLvalueReplaceDropGlueDescriptor =
        valid: bool
        rootTypeId: int32 = -1
        managedLeafCount: int32
        bytes: str
        digest: layout.FixedBytes32

    ManagedLvalueReplaceAdmissionReport =
        valid: bool
        replaceCount: int32
        moveCount: int32
        borrowLiftCount: int32
        selfAliasNoOpCount: int32
        sourceConsumeCount: int32
        oldCaptureBeforeNewCount: int32
        oldDropReleaseCount: int32
        rawManagedStoreCount: int32
        fingerprint: int64

fn managedLvalueReplaceFail(message: str) =
    panic(message)

fn managedLvalueReplaceFingerprintMix(
        seed: int64,
        value: int32): int64 =
    return (seed * int64(65599) + int64(value) +
            int64(2147483647) + int64(1)) %
           int64(2147483647)

@borrows
fn managedLvalueReplaceFingerprintCid(
        seed: int64,
        value: layout.FixedBytes32): int64 =
    var out = seed
    for byteIndex in 0..<layout.FixedBytes32Size:
        out = managedLvalueReplaceFingerprintMix(
            out, int32(value.data[byteIndex]))
    return out

@borrows
fn managedLvalueReplaceFingerprintI32s(
        seed: int64,
        values: int32[]): int64 =
    var out = managedLvalueReplaceFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        out = managedLvalueReplaceFingerprintMix(
            out, values[valueIndex])
    return out

@borrows
fn managedLvalueReplaceFingerprintCids(
        seed: int64,
        values: layout.FixedBytes32[]): int64 =
    var out = managedLvalueReplaceFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        out = managedLvalueReplaceFingerprintCid(
            out, layout.FixedBytes32Copy(values[valueIndex]))
    return out

@borrows
fn managedLvalueReplaceCidIsZero(
        value: layout.FixedBytes32): bool =
    for byteIndex in 0..<layout.FixedBytes32Size:
        if value.data[byteIndex] != 0:
            return false
    return true

fn managedLvalueReplaceCidAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn managedLvalueReplaceCidAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    managedLvalueReplaceCidAppendI32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(
            buf, Int32(value[index]) & 255)

@borrows
fn ManagedLvalueReplaceRuntimeSemanticCid(
        typeArenaArtifactCid: layout.FixedBytes32,
        typeArenaTypeId: int32,
        managedStoreKind: int32,
        valueSizeBytes: int32,
        valueAlignBytes: int32,
        targetArgPassKind: int32,
        targetArgAbiSizeBytes: int32,
        sourceArgPassKind: int32,
        sourceArgAbiSizeBytes: int32): layout.FixedBytes32 =
    if !coreir.BodyIRTypeArenaArtifactCidValid(
           typeArenaArtifactCid) ||
       typeArenaTypeId < 0 ||
       !managedLvalueReplaceManagedStoreKind(managedStoreKind) ||
       valueSizeBytes <= 0 || valueAlignBytes <= 0 ||
       (targetArgPassKind !=
            coreir.BodyCallPassGlobalAddressTag &&
        targetArgPassKind !=
            coreir.BodyCallPassBorrowAddressTag) ||
       (sourceArgPassKind !=
            coreir.BodyCallPassGlobalAddressTag &&
        sourceArgPassKind !=
            coreir.BodyCallPassParamAddressTag &&
        sourceArgPassKind !=
            coreir.BodyCallPassBorrowAddressTag) ||
       targetArgAbiSizeBytes !=
           ManagedLvalueReplaceAddressAbiSizeBytes ||
       sourceArgAbiSizeBytes !=
           ManagedLvalueReplaceAddressAbiSizeBytes:
        managedLvalueReplaceFail(
            "managed lvalue replace: runtime semantic tuple invalid")
    var buf = layout.ByteBufInit(192)
    managedLvalueReplaceCidAppendText(
        buf,
        "cheng.body_ir.managed_lvalue_replace.runtime.exact_type.current")
    layout.ByteBufAppendFixed32(buf, typeArenaArtifactCid)
    managedLvalueReplaceCidAppendI32(buf, typeArenaTypeId)
    managedLvalueReplaceCidAppendI32(buf, managedStoreKind)
    managedLvalueReplaceCidAppendI32(buf, valueSizeBytes)
    managedLvalueReplaceCidAppendI32(buf, valueAlignBytes)
    managedLvalueReplaceCidAppendI32(buf, targetArgPassKind)
    managedLvalueReplaceCidAppendI32(buf, targetArgAbiSizeBytes)
    managedLvalueReplaceCidAppendI32(buf, sourceArgPassKind)
    managedLvalueReplaceCidAppendI32(buf, sourceArgAbiSizeBytes)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn ManagedLvalueReplaceAggregateRuntimeSemanticCid(
        typeArenaArtifactCid: layout.FixedBytes32,
        typeArenaTypeId: int32,
        managedStoreKind: int32,
        valueSizeBytes: int32,
        valueAlignBytes: int32,
        sourceArgPassKind: int32,
        descriptorDigest: layout.FixedBytes32,
        descriptorLength: int32,
        replaceMode: int32): layout.FixedBytes32 =
    if (managedStoreKind != coreir.ManagedStoreAggregateRetainTag &&
        managedStoreKind != coreir.ManagedStoreAggregateMoveTag) ||
       descriptorLength <= 0 ||
       !coreir.BodyIRTypeArenaArtifactCidValid(descriptorDigest) ||
       (replaceMode != ManagedLvalueReplaceMove &&
        replaceMode != ManagedLvalueReplaceBorrowLift) ||
       (managedStoreKind == coreir.ManagedStoreAggregateMoveTag &&
        replaceMode != ManagedLvalueReplaceMove) ||
       (managedStoreKind == coreir.ManagedStoreAggregateRetainTag &&
        replaceMode != ManagedLvalueReplaceBorrowLift):
        managedLvalueReplaceFail(
            "managed lvalue replace: aggregate runtime tuple invalid")
    let baseCid = ManagedLvalueReplaceRuntimeSemanticCid(
        typeArenaArtifactCid,
        typeArenaTypeId,
        managedStoreKind,
        valueSizeBytes,
        valueAlignBytes,
        coreir.BodyCallPassBorrowAddressTag,
        ManagedLvalueReplaceAddressAbiSizeBytes,
        sourceArgPassKind,
        ManagedLvalueReplaceAddressAbiSizeBytes)
    var buf = layout.ByteBufInit(128)
    managedLvalueReplaceCidAppendText(
        buf,
        "cheng.body_ir.managed_lvalue_replace.aggregate_runtime")
    layout.ByteBufAppendFixed32(buf, baseCid)
    layout.ByteBufAppendFixed32(buf, descriptorDigest)
    managedLvalueReplaceCidAppendI32(buf, descriptorLength)
    managedLvalueReplaceCidAppendI32(buf, replaceMode)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn ManagedLvalueReplaceRuntimeLinkerSymbol(
        managedStoreKind: int32): str =
    if managedStoreKind == coreir.ManagedStoreStrRetainTag:
        return "cheng_str_store_managed"
    if managedStoreKind == coreir.ManagedStoreStrMoveTag:
        return "cheng_str_move_store_managed"
    if managedStoreKind == coreir.ManagedStoreSeqRetainTag:
        return "cheng_seq_store_plain_managed"
    if managedStoreKind == coreir.ManagedStoreSeqMoveTag:
        return "cheng_seq_move_store_plain_managed"
    if managedStoreKind == coreir.ManagedStoreAggregateRetainTag ||
       managedStoreKind == coreir.ManagedStoreAggregateMoveTag:
        return "cheng_aggregate_store_managed"
    managedLvalueReplaceFail(
        "managed lvalue replace: runtime linker kind invalid")
    return ""

@borrows
fn managedLvalueReplacePlanFingerprint(
        plan: var ManagedLvalueReplacePlan): int64 =
    var out = managedLvalueReplaceFingerprintMix(
        int64(41), plan.functionRow)
    out = managedLvalueReplaceFingerprintCid(
        out, plan.typeArenaArtifactCid)
    out = managedLvalueReplaceFingerprintI32s(out, plan.targetKinds)
    out = managedLvalueReplaceFingerprintI32s(out, plan.replaceModes)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.targetLvalueRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.sourceLvalueRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.targetRootStorageRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.targetRootDefinitionDomains)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.targetRootDefinitionRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.targetSlotIds)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.targetTypeIds)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.sourceDefinitionDomains)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.sourceDefinitionRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.sourceSlotIds)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.sourceSemanticRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.replaceOpIds)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.consumeActionRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.runtimeFunctionRows)
    out = managedLvalueReplaceFingerprintCids(
        out, plan.runtimeSemanticCids)
    out = managedLvalueReplaceFingerprintI32s(out, plan.pathStarts)
    out = managedLvalueReplaceFingerprintI32s(out, plan.pathCounts)
    out = managedLvalueReplaceFingerprintI32s(out, plan.pathKinds)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.pathParentDefinitionDomains)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.pathParentDefinitionRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.pathMemberRows)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.pathResultTypeIds)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.pathByteOffsets)
    out = managedLvalueReplaceFingerprintI32s(
        out, plan.pathByteWidths)
    return out

@borrows
fn ManagedLvalueReplacePlanPrepare(
        plan: var ManagedLvalueReplacePlan,
        functionRow: int32,
        typeArenaArtifactCid: layout.FixedBytes32) =
    if plan.prepared || plan.sealed ||
       functionRow < 0 ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           typeArenaArtifactCid):
        managedLvalueReplaceFail(
            "managed lvalue replace: prepare authority invalid")
    plan.prepared = true
    plan.functionRow = functionRow
    plan.typeArenaArtifactCid = typeArenaArtifactCid

fn managedLvalueReplaceRequirePathColumns(
        pathKinds: var int32[],
        pathParentDefinitionDomains: var int32[],
        pathParentDefinitionRows: var int32[],
        pathMemberRows: var int32[],
        pathResultTypeIds: var int32[],
        pathByteOffsets: var int32[],
        pathByteWidths: var int32[]) =
    let count = pathKinds.len
    if pathParentDefinitionDomains.len != count ||
       pathParentDefinitionRows.len != count ||
       pathMemberRows.len != count ||
       pathResultTypeIds.len != count ||
       pathByteOffsets.len != count ||
       pathByteWidths.len != count:
        managedLvalueReplaceFail(
            "managed lvalue replace: path SoA columns drift")
    for pathIndex in 0..<count:
        if (pathKinds[pathIndex] != ManagedLvaluePathField &&
            pathKinds[pathIndex] != ManagedLvaluePathIndexed) ||
           pathParentDefinitionDomains[pathIndex] !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           pathParentDefinitionRows[pathIndex] < 0 ||
           pathMemberRows[pathIndex] < 0 ||
           pathResultTypeIds[pathIndex] < 0 ||
           pathByteOffsets[pathIndex] < 0 ||
           pathByteWidths[pathIndex] <= 0:
            managedLvalueReplaceFail(
                "managed lvalue replace: exact path tuple invalid")

@borrows
fn ManagedLvalueReplacePlanAppendExact(
        plan: var ManagedLvalueReplacePlan,
        targetKind: int32,
        replaceMode: int32,
        targetLvalueRow: int32,
        sourceLvalueRow: int32,
        targetRootStorageRow: int32,
        targetRootDefinitionDomain: int32,
        targetRootDefinitionRow: int32,
        targetSlotId: int32,
        targetTypeId: int32,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32,
        sourceSlotId: int32,
        sourceSemanticRow: int32,
        replaceOpId: int32,
        consumeActionRow: int32,
        runtimeFunctionRow: int32,
        runtimeSemanticCid: layout.FixedBytes32,
        pathKinds: var int32[],
        pathParentDefinitionDomains: var int32[],
        pathParentDefinitionRows: var int32[],
        pathMemberRows: var int32[],
        pathResultTypeIds: var int32[],
        pathByteOffsets: var int32[],
        pathByteWidths: var int32[]): int32 =
    if !plan.prepared || plan.sealed ||
       targetLvalueRow < 0 ||
       sourceLvalueRow < 0 ||
       targetSlotId < 0 ||
       targetTypeId < 0 ||
       sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       sourceDefinitionRow < 0 ||
       sourceSlotId < 0 ||
       sourceSemanticRow < 0:
        managedLvalueReplaceFail(
            "managed lvalue replace: immutable tuple missing")
    managedLvalueReplaceRequirePathColumns(
        pathKinds,
        pathParentDefinitionDomains,
        pathParentDefinitionRows,
        pathMemberRows,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths)
    if targetKind == ManagedLvalueTargetGlobal:
        if targetRootStorageRow < 0 ||
           targetRootDefinitionDomain !=
               coreir.BodyDefinitionDomainInvalidTag ||
           targetRootDefinitionRow != -1 ||
           pathKinds.len != 0:
            managedLvalueReplaceFail(
                "managed lvalue replace: global identity invalid")
    elif targetKind == ManagedLvalueTargetField ||
         targetKind == ManagedLvalueTargetIndexed:
        if targetRootStorageRow != -1 ||
           targetRootDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           targetRootDefinitionRow < 0 ||
           pathKinds.len <= 0 ||
           pathParentDefinitionDomains[0] !=
               targetRootDefinitionDomain ||
           pathParentDefinitionRows[0] !=
               targetRootDefinitionRow:
            managedLvalueReplaceFail(
                "managed lvalue replace: projection root invalid")
        let terminalPathKind = pathKinds[pathKinds.len - 1]
        if (targetKind == ManagedLvalueTargetField &&
            terminalPathKind != ManagedLvaluePathField) ||
           (targetKind == ManagedLvalueTargetIndexed &&
            terminalPathKind != ManagedLvaluePathIndexed):
            managedLvalueReplaceFail(
                "managed lvalue replace: terminal path identity invalid")
    else:
        managedLvalueReplaceFail(
            "managed lvalue replace: target kind invalid")

    if replaceMode == ManagedLvalueReplaceSelfAliasNoOp:
        if sourceLvalueRow != targetLvalueRow ||
           sourceSlotId != targetSlotId ||
           replaceOpId != -1 ||
           consumeActionRow != -1 ||
           runtimeFunctionRow != -1 ||
           !managedLvalueReplaceCidIsZero(runtimeSemanticCid):
            managedLvalueReplaceFail(
                "managed lvalue replace: self alias is not exact no-op")
    elif replaceMode == ManagedLvalueReplaceMove:
        if replaceOpId < 0 || consumeActionRow < 0 ||
           consumeActionRow != replaceOpId ||
           runtimeFunctionRow != -1 ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               runtimeSemanticCid) ||
           sourceLvalueRow == targetLvalueRow ||
           sourceSlotId == targetSlotId:
            managedLvalueReplaceFail(
                "managed lvalue replace: replace authority invalid")
    elif replaceMode == ManagedLvalueReplaceBorrowLift:
        if replaceOpId < 0 || consumeActionRow != -1 ||
           runtimeFunctionRow != -1 ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               runtimeSemanticCid) ||
           sourceLvalueRow == targetLvalueRow ||
           sourceSlotId == targetSlotId:
            managedLvalueReplaceFail(
                "managed lvalue replace: borrow authority invalid")
    else:
        managedLvalueReplaceFail(
            "managed lvalue replace: mode invalid")

    let row = plan.targetKinds.len
    add(plan.targetKinds, targetKind)
    add(plan.replaceModes, replaceMode)
    add(plan.targetLvalueRows, targetLvalueRow)
    add(plan.sourceLvalueRows, sourceLvalueRow)
    add(plan.targetRootStorageRows, targetRootStorageRow)
    add(plan.targetRootDefinitionDomains,
        targetRootDefinitionDomain)
    add(plan.targetRootDefinitionRows, targetRootDefinitionRow)
    add(plan.targetSlotIds, targetSlotId)
    add(plan.targetTypeIds, targetTypeId)
    add(plan.sourceDefinitionDomains, sourceDefinitionDomain)
    add(plan.sourceDefinitionRows, sourceDefinitionRow)
    add(plan.sourceSlotIds, sourceSlotId)
    add(plan.sourceSemanticRows, sourceSemanticRow)
    add(plan.replaceOpIds, replaceOpId)
    add(plan.consumeActionRows, consumeActionRow)
    add(plan.runtimeFunctionRows, runtimeFunctionRow)
    add(plan.runtimeSemanticCids, layout.FixedBytes32Copy(runtimeSemanticCid))
    add(plan.pathStarts, plan.pathKinds.len)
    add(plan.pathCounts, pathKinds.len)
    for pathIndex in 0..<pathKinds.len:
        add(plan.pathKinds, pathKinds[pathIndex])
        add(plan.pathParentDefinitionDomains,
            pathParentDefinitionDomains[pathIndex])
        add(plan.pathParentDefinitionRows,
            pathParentDefinitionRows[pathIndex])
        add(plan.pathMemberRows, pathMemberRows[pathIndex])
        add(plan.pathResultTypeIds, pathResultTypeIds[pathIndex])
        add(plan.pathByteOffsets, pathByteOffsets[pathIndex])
        add(plan.pathByteWidths, pathByteWidths[pathIndex])
    return row

fn ManagedLvalueReplacePlanSeal(
        plan: var ManagedLvalueReplacePlan) =
    if !plan.prepared || plan.sealed ||
       plan.targetKinds.len <= 0 ||
       !managedLvalueReplacePlanColumnsValid(plan) ||
       !managedLvalueReplacePathCsrValid(plan):
        managedLvalueReplaceFail(
            "managed lvalue replace: seal state invalid")
    plan.sealedFingerprint =
        managedLvalueReplacePlanFingerprint(plan)
    plan.sealed = true

fn managedLvalueReplacePlanColumnsValid(
        plan: var ManagedLvalueReplacePlan): bool =
    let count = plan.targetKinds.len
    return count > 0 &&
           plan.replaceModes.len == count &&
           plan.targetLvalueRows.len == count &&
           plan.sourceLvalueRows.len == count &&
           plan.targetRootStorageRows.len == count &&
           plan.targetRootDefinitionDomains.len == count &&
           plan.targetRootDefinitionRows.len == count &&
           plan.targetSlotIds.len == count &&
           plan.targetTypeIds.len == count &&
           plan.sourceDefinitionDomains.len == count &&
           plan.sourceDefinitionRows.len == count &&
           plan.sourceSlotIds.len == count &&
           plan.sourceSemanticRows.len == count &&
           plan.replaceOpIds.len == count &&
           plan.consumeActionRows.len == count &&
           plan.runtimeFunctionRows.len == count &&
           plan.runtimeSemanticCids.len == count &&
           plan.pathStarts.len == count &&
           plan.pathCounts.len == count &&
           plan.pathKinds.len ==
               plan.pathParentDefinitionDomains.len &&
           plan.pathKinds.len ==
               plan.pathParentDefinitionRows.len &&
           plan.pathKinds.len == plan.pathMemberRows.len &&
           plan.pathKinds.len == plan.pathResultTypeIds.len &&
           plan.pathKinds.len == plan.pathByteOffsets.len &&
           plan.pathKinds.len == plan.pathByteWidths.len

fn managedLvalueReplacePathCsrValid(
        plan: var ManagedLvalueReplacePlan): bool =
    var cursor: int32
    for row in 0..<plan.pathStarts.len:
        if plan.pathStarts[row] != cursor ||
           plan.pathCounts[row] < 0 ||
           plan.pathCounts[row] >
               plan.pathKinds.len - cursor:
            return false
        cursor = cursor + plan.pathCounts[row]
    return cursor == plan.pathKinds.len

@borrows
fn managedLvalueReplaceDecodedArgSlot(
        bodyIR: var coreir.BodyIR,
        call: coreir.CallOp,
        argIndex: int32): int32 =
    if argIndex < 0 || argIndex >= call.argSlots.len ||
       argIndex >= call.argPassKinds.len:
        return -1
    let encoded = call.argSlots[argIndex]
    let passKind = call.argPassKinds[argIndex]
    var slot = encoded
    if passKind == coreir.BodyCallPassParamAddressTag ||
       passKind == coreir.BodyCallPassBorrowAddressTag ||
       passKind == coreir.BodyCallPassByAddressAggregateTag:
        if !coreir.CallArgSlotIsAddress(encoded):
            return -1
        slot = coreir.CallArgSlotAddressId(encoded)
    elif passKind != coreir.BodyCallPassStackValueTag &&
         passKind != coreir.BodyCallPassGlobalAddressTag:
        return -1
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return -1
    return slot

fn managedLvalueReplaceManagedStoreKind(
        kind: int32): bool =
    return kind == coreir.ManagedStoreStrRetainTag ||
           kind == coreir.ManagedStoreStrMoveTag ||
           kind == coreir.ManagedStoreSeqRetainTag ||
           kind == coreir.ManagedStoreSeqMoveTag ||
           kind == coreir.ManagedStoreAggregateRetainTag ||
           kind == coreir.ManagedStoreAggregateMoveTag

fn managedLvalueReplaceLegacyManagedStoreKind(
        kind: int32): bool =
    return kind == coreir.ManagedStoreStrRetainTag ||
           kind == coreir.ManagedStoreStrMoveTag ||
           kind == coreir.ManagedStoreSeqRetainTag ||
           kind == coreir.ManagedStoreSeqMoveTag

fn managedLvalueReplaceMoveStoreKind(
        kind: int32): bool =
    return kind == coreir.ManagedStoreStrMoveTag ||
           kind == coreir.ManagedStoreSeqMoveTag ||
           kind == coreir.ManagedStoreAggregateMoveTag

@borrows
fn managedLvalueReplaceRetainStoreKind(
        kind: int32): bool =
    return kind == coreir.ManagedStoreStrRetainTag ||
           kind == coreir.ManagedStoreSeqRetainTag ||
           kind == coreir.ManagedStoreAggregateRetainTag

@borrows
fn managedLvalueReplaceTypeContainsManagedExact(
        bodyIR: var coreir.BodyIR,
        typeId: int32,
        depth: int32,
        knownOut: var bool): bool =
    knownOut = false
    if depth > 64:
        return false
    let row = coreir.BodyIRCanonicalTypeFactRow(bodyIR, typeId)
    if row < 0:
        return false
    let structuralKind = bodyIR.typeFactStructuralKinds[row]
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeScalar):
        knownOut = true
        return bodyIR.typeFactScalarKinds[row] ==
               Int32(typearena.TypedExprStructuralScalarStr)
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeBorrow):
        knownOut = true
        return false
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeSequence):
        knownOut = true
        return true
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFixedArray) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeOptional) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeAlias):
        let childTypeId = bodyIR.typeFactChildTypeIds[row]
        if childTypeId < 0:
            return false
        return managedLvalueReplaceTypeContainsManagedExact(
            bodyIR, childTypeId, depth + 1, knownOut)
    return false

@borrows
fn managedLvalueReplaceProductionTypeContainsManagedExact(
        typeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        childTypeIds: int32[],
        fixedLengths: int32[],
        sizeBytes: int32[],
        alignBytes: int32[],
        depth: int32,
        knownOut: var bool): bool =
    knownOut = false
    if depth > 64 ||
       typeId < 0 ||
       typeId >= structuralKinds.len ||
       typeId >= scalarKinds.len ||
       typeId >= childTypeIds.len ||
       typeId >= fixedLengths.len ||
       typeId >= sizeBytes.len ||
       typeId >= alignBytes.len ||
       structuralKinds[typeId] <= 0 ||
       scalarKinds[typeId] < 0 ||
       childTypeIds[typeId] < -1 ||
       fixedLengths[typeId] < 0 ||
       sizeBytes[typeId] < 0 ||
       alignBytes[typeId] <= 0:
        return false
    let structuralKind = structuralKinds[typeId]
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeScalar):
        knownOut = true
        return scalarKinds[typeId] ==
               Int32(typearena.TypedExprStructuralScalarStr)
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeBorrow):
        knownOut = true
        return false
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeSequence):
        knownOut = true
        return true
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFixedArray) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeOptional) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeAlias):
        let childTypeId = childTypeIds[typeId]
        if childTypeId < 0:
            return false
        return managedLvalueReplaceProductionTypeContainsManagedExact(
            childTypeId,
            structuralKinds,
            scalarKinds,
            childTypeIds,
            fixedLengths,
            sizeBytes,
            alignBytes,
            depth + 1,
            knownOut)
    return false

fn managedLvalueReplaceDropGlueAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    managedLvalueReplaceCidAppendI32(buf, value)

@borrows
fn managedLvalueReplaceDropGlueColumnsValid(
        structuralKinds: int32[],
        scalarKinds: int32[],
        layoutChildStarts: int32[],
        layoutChildCounts: int32[],
        layoutChildTypeIds: int32[],
        layoutChildIdentityKinds: int32[],
        layoutChildMemberRows: int32[],
        layoutChildSelectorOrdinals: int32[],
        layoutChildOffsets: int32[],
        layoutChildWidths: int32[],
        fixedLengths: int32[],
        variantCounts: int32[],
        sizeBytes: int32[],
        alignBytes: int32[]): bool =
    let typeCount = structuralKinds.len
    if typeCount <= 0 ||
       scalarKinds.len != typeCount ||
       layoutChildStarts.len != typeCount ||
       layoutChildCounts.len != typeCount ||
       fixedLengths.len != typeCount ||
       variantCounts.len != typeCount ||
       sizeBytes.len != typeCount ||
       alignBytes.len != typeCount ||
       layoutChildTypeIds.len != layoutChildIdentityKinds.len ||
       layoutChildTypeIds.len != layoutChildMemberRows.len ||
       layoutChildTypeIds.len != layoutChildSelectorOrdinals.len ||
       layoutChildTypeIds.len != layoutChildOffsets.len ||
       layoutChildTypeIds.len != layoutChildWidths.len:
        return false
    for typeId in 0..<typeCount:
        # RefObject 行 8/8 句柄、字段行居 pointee 偏移空间：行尺寸
        # containment 仅约束非 ref 行 (lowering_plan/snapshot schema 同款)。
        let childStart = layoutChildStarts[typeId]
        let childCount = layoutChildCounts[typeId]
        if structuralKinds[typeId] <= 0 ||
           scalarKinds[typeId] < 0 ||
           fixedLengths[typeId] < 0 ||
           variantCounts[typeId] < 0 ||
           sizeBytes[typeId] < 0 ||
           alignBytes[typeId] <= 0 ||
           childStart < 0 || childCount < 0 ||
           childStart > layoutChildTypeIds.len - childCount:
            return false
        for childOffset in 0..<childCount:
            let childRow = childStart + childOffset
            let childTypeId = layoutChildTypeIds[childRow]
            let identityKind = layoutChildIdentityKinds[childRow]
            let memberRow = layoutChildMemberRows[childRow]
            let selectorOrdinal = layoutChildSelectorOrdinals[childRow]
            let byteOffset = layoutChildOffsets[childRow]
            let byteWidth = layoutChildWidths[childRow]
            if childTypeId < 0 || childTypeId >= typeCount ||
               (identityKind != 1 && identityKind != 2) ||
               memberRow < 0 || selectorOrdinal < 0 ||
               byteOffset < 0 || byteWidth <= 0 ||
               (structuralKinds[typeId] !=
                    Int32(typearena.TypedExprStructuralTypeRefObject) &&
                byteOffset > sizeBytes[typeId] - byteWidth) ||
               byteWidth != sizeBytes[childTypeId]:
                return false
    return true

fn managedLvalueReplaceDropGlueNodeTag(
        structuralKind: int32,
        scalarKind: int32): int32 =
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeScalar):
        if scalarKind ==
               Int32(typearena.TypedExprStructuralScalarStr):
            return ManagedDropGlueNodeStr
        return ManagedDropGlueNodePlain
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeSequence):
        return ManagedDropGlueNodeSequence
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeTuple) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeObject):
        return ManagedDropGlueNodeAggregate
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFixedArray):
        return ManagedDropGlueNodeFixedArray
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeOptional):
        return ManagedDropGlueNodeOptional
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeEnum):
        return ManagedDropGlueNodeEnum
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeAlias) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeApply):
        return ManagedDropGlueNodeAlias
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeRefObject):
        return ManagedDropGlueNodeRefObject
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeBorrow) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFunction):
        return ManagedDropGlueNodePlain
    return 0

@borrows
fn managedLvalueReplaceDropGlueTypeContainsManaged(
        typeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        layoutChildStarts: int32[],
        layoutChildCounts: int32[],
        layoutChildTypeIds: int32[],
        states: var int32[],
        containsManagedByType: var bool[],
        known: var bool): bool =
    known = false
    if typeId < 0 || typeId >= structuralKinds.len:
        return false
    if states[typeId] == 2:
        known = true
        return containsManagedByType[typeId]
    if states[typeId] == 1:
        return false
    let nodeTag = managedLvalueReplaceDropGlueNodeTag(
        structuralKinds[typeId], scalarKinds[typeId])
    if nodeTag == 0:
        return false
    states[typeId] = 1
    if nodeTag == ManagedDropGlueNodeStr ||
       nodeTag == ManagedDropGlueNodeRefObject:
        containsManagedByType[typeId] = true
        states[typeId] = 2
        known = true
        return true
    let childStart = layoutChildStarts[typeId]
    let childCount = layoutChildCounts[typeId]
    if nodeTag == ManagedDropGlueNodeSequence:
        if childCount != 1:
            states[typeId] = 0
            return false
        var elementKnown: bool
        let _ = managedLvalueReplaceDropGlueTypeContainsManaged(
            layoutChildTypeIds[childStart],
            structuralKinds,
            scalarKinds,
            layoutChildStarts,
            layoutChildCounts,
            layoutChildTypeIds,
            states,
            containsManagedByType,
            elementKnown)
        if !elementKnown:
            states[typeId] = 0
            return false
        containsManagedByType[typeId] = true
        states[typeId] = 2
        known = true
        return true
    var containsManaged: bool
    for childOffset in 0..<childCount:
        var childKnown: bool
        if managedLvalueReplaceDropGlueTypeContainsManaged(
               layoutChildTypeIds[childStart + childOffset],
               structuralKinds,
               scalarKinds,
               layoutChildStarts,
               layoutChildCounts,
               layoutChildTypeIds,
               states,
               containsManagedByType,
               childKnown):
            containsManaged = true
        if !childKnown:
            states[typeId] = 0
            return false
    containsManagedByType[typeId] = containsManaged
    states[typeId] = 2
    known = true
    return containsManaged

@borrows
fn managedLvalueReplaceDropGlueAppendNode(
        buf: var layout.ByteBuf,
        typeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        layoutChildStarts: int32[],
        layoutChildCounts: int32[],
        layoutChildTypeIds: int32[],
        layoutChildIdentityKinds: int32[],
        layoutChildMemberRows: int32[],
        layoutChildSelectorOrdinals: int32[],
        layoutChildOffsets: int32[],
        layoutChildWidths: int32[],
        fixedLengths: int32[],
        variantCounts: int32[],
        sizeBytes: int32[],
        alignBytes: int32[],
        containsManagedByType: bool[],
        active: var bool[],
        managedLeafCount: var int32): bool =
    if typeId < 0 || typeId >= structuralKinds.len ||
       active[typeId] || sizeBytes[typeId] <= 0:
        return false
    let nodeTag = managedLvalueReplaceDropGlueNodeTag(
        structuralKinds[typeId], scalarKinds[typeId])
    if nodeTag == 0:
        return false
    let childStart = layoutChildStarts[typeId]
    let childCount = layoutChildCounts[typeId]
    if (nodeTag == ManagedDropGlueNodeSequence ||
        nodeTag == ManagedDropGlueNodeFixedArray ||
        nodeTag == ManagedDropGlueNodeOptional ||
        nodeTag == ManagedDropGlueNodeAlias) && childCount != 1:
        return false
    if (nodeTag == ManagedDropGlueNodePlain ||
        nodeTag == ManagedDropGlueNodeStr ||
        nodeTag == ManagedDropGlueNodeRefObject) && childCount != 0:
        return false
    if nodeTag == ManagedDropGlueNodeStr ||
       nodeTag == ManagedDropGlueNodeSequence ||
       nodeTag == ManagedDropGlueNodeRefObject:
        managedLeafCount = managedLeafCount + 1
    managedLvalueReplaceDropGlueAppendI32(buf, nodeTag)
    managedLvalueReplaceDropGlueAppendI32(buf, typeId)
    managedLvalueReplaceDropGlueAppendI32(buf, sizeBytes[typeId])
    managedLvalueReplaceDropGlueAppendI32(buf, alignBytes[typeId])
    managedLvalueReplaceDropGlueAppendI32(buf, scalarKinds[typeId])
    var repetitionOrVariantCount = fixedLengths[typeId]
    if nodeTag == ManagedDropGlueNodeEnum:
        repetitionOrVariantCount = variantCounts[typeId]
        if repetitionOrVariantCount <= 0:
            return false
    managedLvalueReplaceDropGlueAppendI32(
        buf, repetitionOrVariantCount)
    managedLvalueReplaceDropGlueAppendI32(buf, childCount)
    managedLvalueReplaceDropGlueAppendI32(
        buf, containsManagedByType[typeId] ? 1 : 0)
    active[typeId] = true
    for childOffset in 0..<childCount:
        let childRow = childStart + childOffset
        managedLvalueReplaceDropGlueAppendI32(
            buf, layoutChildIdentityKinds[childRow])
        managedLvalueReplaceDropGlueAppendI32(
            buf, layoutChildMemberRows[childRow])
        managedLvalueReplaceDropGlueAppendI32(
            buf, layoutChildSelectorOrdinals[childRow])
        managedLvalueReplaceDropGlueAppendI32(
            buf, layoutChildOffsets[childRow])
        managedLvalueReplaceDropGlueAppendI32(
            buf, layoutChildWidths[childRow])
        if !managedLvalueReplaceDropGlueAppendNode(
               buf,
               layoutChildTypeIds[childRow],
               structuralKinds,
               scalarKinds,
               layoutChildStarts,
               layoutChildCounts,
               layoutChildTypeIds,
               layoutChildIdentityKinds,
               layoutChildMemberRows,
               layoutChildSelectorOrdinals,
               layoutChildOffsets,
               layoutChildWidths,
               fixedLengths,
               variantCounts,
               sizeBytes,
               alignBytes,
               containsManagedByType,
               active,
               managedLeafCount):
            active[typeId] = false
            return false
    active[typeId] = false
    return true

@borrows
fn ManagedLvalueReplaceBuildDropGlueDescriptorExact(
        typeArenaArtifactCid: layout.FixedBytes32,
        rootTypeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        layoutChildStarts: int32[],
        layoutChildCounts: int32[],
        layoutChildTypeIds: int32[],
        layoutChildIdentityKinds: int32[],
        layoutChildMemberRows: int32[],
        layoutChildSelectorOrdinals: int32[],
        layoutChildOffsets: int32[],
        layoutChildWidths: int32[],
        fixedLengths: int32[],
        variantCounts: int32[],
        sizeBytes: int32[],
        alignBytes: int32[]): ManagedLvalueReplaceDropGlueDescriptor =
    var out: ManagedLvalueReplaceDropGlueDescriptor
    if !coreir.BodyIRTypeArenaArtifactCidValid(
           typeArenaArtifactCid) ||
       !managedLvalueReplaceDropGlueColumnsValid(
           structuralKinds,
           scalarKinds,
           layoutChildStarts,
           layoutChildCounts,
           layoutChildTypeIds,
           layoutChildIdentityKinds,
           layoutChildMemberRows,
           layoutChildSelectorOrdinals,
           layoutChildOffsets,
           layoutChildWidths,
           fixedLengths,
           variantCounts,
           sizeBytes,
           alignBytes) ||
       rootTypeId < 0 || rootTypeId >= structuralKinds.len:
        return out
    var buf = layout.ByteBufInit(512)
    managedLvalueReplaceDropGlueAppendI32(
        buf, ManagedDropGlueSchemaMagic)
    managedLvalueReplaceDropGlueAppendI32(
        buf, ManagedDropGlueSchemaVersion)
    layout.ByteBufAppendFixed32(buf, typeArenaArtifactCid)
    managedLvalueReplaceDropGlueAppendI32(buf, rootTypeId)
    var active: bool[]
    setLen(active, structuralKinds.len)
    var containsStates: int32[]
    var containsManagedByType: bool[]
    setLen(containsStates, structuralKinds.len)
    setLen(containsManagedByType, structuralKinds.len)
    var containsKnown: bool
    let _ = managedLvalueReplaceDropGlueTypeContainsManaged(
        rootTypeId,
        structuralKinds,
        scalarKinds,
        layoutChildStarts,
        layoutChildCounts,
        layoutChildTypeIds,
        containsStates,
        containsManagedByType,
        containsKnown)
    if !containsKnown:
        layout.ByteBufFree(buf)
        return out
    if !managedLvalueReplaceDropGlueAppendNode(
           buf,
           rootTypeId,
           structuralKinds,
           scalarKinds,
           layoutChildStarts,
           layoutChildCounts,
           layoutChildTypeIds,
           layoutChildIdentityKinds,
           layoutChildMemberRows,
           layoutChildSelectorOrdinals,
           layoutChildOffsets,
           layoutChildWidths,
           fixedLengths,
           variantCounts,
           sizeBytes,
           alignBytes,
           containsManagedByType,
           active,
           out.managedLeafCount):
        layout.ByteBufFree(buf)
        return out
    var descriptorBytes = layout.ByteBufToBytes(buf)
    out.digest =
        hash256.Sha256Fixed(layout.ByteSpanFromBytes(descriptorBytes))
    out.bytes = rawbytes.BytesToString(descriptorBytes)
    rawbytes.BytesFree(descriptorBytes)
    out.rootTypeId = rootTypeId
    out.valid = out.bytes.len > 0 && out.managedLeafCount > 0
    layout.ByteBufFree(buf)
    return out

# Read-only admission runs before a managed destination acquires any TypeArena
# proof.  The current lowering receipt carries one child TypeId per type row,
# so it can prove `str` and sequences whose element closure is exactly plain.
# Managed sequence elements require element drop-glue authority; aggregate
# values require member TypeId/offset/drop-glue CSR.  Neither receipt exists in
# BodyIR today, therefore those paths must fail before the first mutation.
@borrows
fn ManagedLvalueReplaceProductionPreflightStoreTypeExact(
        typeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        childTypeIds: int32[],
        fixedLengths: int32[],
        sizeBytes: int32[],
        alignBytes: int32[]): int32 =
    let typeCount = structuralKinds.len
    if typeCount <= 0 ||
       typeCount != scalarKinds.len ||
       typeCount != childTypeIds.len ||
       typeCount != fixedLengths.len ||
       typeCount != sizeBytes.len ||
       typeCount != alignBytes.len ||
       typeId < 0 || typeId >= typeCount ||
       structuralKinds[typeId] <= 0 ||
       scalarKinds[typeId] < 0 ||
       childTypeIds[typeId] < -1 ||
       fixedLengths[typeId] < 0 ||
       sizeBytes[typeId] <= 0 ||
       alignBytes[typeId] <= 0:
        managedLvalueReplaceFail(
            "managed lvalue replace: store TypeArena closure invalid")
    let structuralKind = structuralKinds[typeId]
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeScalar) &&
       scalarKinds[typeId] ==
           Int32(typearena.TypedExprStructuralScalarStr) &&
       childTypeIds[typeId] == -1:
        return ManagedLvalueReplaceStorePreflightStr
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeSequence):
        let childTypeId = childTypeIds[typeId]
        var childKnown: bool
        let childManaged =
            managedLvalueReplaceProductionTypeContainsManagedExact(
                childTypeId,
                structuralKinds,
                scalarKinds,
                childTypeIds,
                fixedLengths,
                sizeBytes,
                alignBytes,
                0,
                childKnown)
        if childTypeId < 0 || !childKnown:
            managedLvalueReplaceFail(
                "managed lvalue replace: sequence element layout/drop-glue authority missing")
        if childManaged:
            managedLvalueReplaceFail(
                "managed lvalue replace: managed sequence element drop-glue authority missing")
        return ManagedLvalueReplaceStorePreflightPlainSequence
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFixedArray) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeTuple) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeObject) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeEnum) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeAlias) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeOptional):
        managedLvalueReplaceFail(
            "managed lvalue replace: aggregate member layout/drop-glue authority missing")
    managedLvalueReplaceFail(
        "managed lvalue replace: managed store TypeId kind unsupported")
    return 0

@borrows
fn managedLvalueReplaceProductionBindTypeClosureInner(
        bodyIR: var coreir.BodyIR,
        typeArenaArtifactCid: layout.FixedBytes32,
        typeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        childTypeIds: int32[],
        fixedLengths: int32[],
        sizeBytes: int32[],
        alignBytes: int32[],
        depth: int32): bool =
    if depth > 64 ||
       typeId < 0 ||
       typeId >= structuralKinds.len ||
       typeId >= scalarKinds.len ||
       typeId >= childTypeIds.len ||
       typeId >= fixedLengths.len ||
       typeId >= sizeBytes.len ||
       typeId >= alignBytes.len:
        return false
    let childTypeId = childTypeIds[typeId]
    if childTypeId >= 0 &&
       !managedLvalueReplaceProductionBindTypeClosureInner(
           bodyIR,
           typeArenaArtifactCid,
           childTypeId,
           structuralKinds,
           scalarKinds,
           childTypeIds,
           fixedLengths,
           sizeBytes,
           alignBytes,
           depth + 1):
        return false
    return coreir.BodyIRBindCanonicalTypeFact(
        bodyIR,
        typeArenaArtifactCid,
        typeId,
        structuralKinds[typeId],
        scalarKinds[typeId],
        childTypeId,
        fixedLengths[typeId],
        sizeBytes[typeId],
        alignBytes[typeId])

@borrows
fn ManagedLvalueReplaceProductionBindTypeClosure(
        bodyIR: var coreir.BodyIR,
        typeArenaArtifactCid: layout.FixedBytes32,
        typeId: int32,
        structuralKinds: int32[],
        scalarKinds: int32[],
        childTypeIds: int32[],
        fixedLengths: int32[],
        sizeBytes: int32[],
        alignBytes: int32[]): bool =
    if !coreir.BodyIRTypeArenaArtifactCidValid(
           typeArenaArtifactCid) ||
       (coreir.BodyIRTypeArenaArtifactCidValid(
            bodyIR.typeArenaArtifactCid) &&
        !layout.FixedBytes32Equal(
            bodyIR.typeArenaArtifactCid,
            typeArenaArtifactCid)):
        return false
    return managedLvalueReplaceProductionBindTypeClosureInner(
        bodyIR,
        typeArenaArtifactCid,
        typeId,
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        0)

@borrows
fn managedLvalueReplaceStoreKindForTypeExact(
        bodyIR: var coreir.BodyIR,
        typeId: int32,
        ownership: coreir.OwnershipKind): int32 =
    let row = coreir.BodyIRCanonicalTypeFactRow(bodyIR, typeId)
    if row < 0:
        managedLvalueReplaceFail(
            "managed lvalue replace: canonical TypeId fact missing")
    let structuralKind = bodyIR.typeFactStructuralKinds[row]
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeScalar) &&
       bodyIR.typeFactScalarKinds[row] ==
           Int32(typearena.TypedExprStructuralScalarStr):
        if ownership == coreir.OwnMove:
            return coreir.ManagedStoreStrMoveTag
        if ownership == coreir.OwnBorrowShared:
            return coreir.ManagedStoreStrRetainTag
        managedLvalueReplaceFail(
            "managed lvalue replace: string ownership invalid")
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeSequence):
        let childTypeId = bodyIR.typeFactChildTypeIds[row]
        var childKnown: bool
        let childManaged =
            managedLvalueReplaceTypeContainsManagedExact(
                bodyIR, childTypeId, 0, childKnown)
        if childTypeId < 0 || !childKnown:
            managedLvalueReplaceFail(
                "managed lvalue replace: sequence element layout/drop-glue authority missing")
        if childManaged:
            managedLvalueReplaceFail(
                "managed lvalue replace: managed sequence element drop-glue authority missing")
        if ownership == coreir.OwnMove:
            return coreir.ManagedStoreSeqMoveTag
        if ownership == coreir.OwnBorrowShared:
            return coreir.ManagedStoreSeqRetainTag
        managedLvalueReplaceFail(
            "managed lvalue replace: sequence ownership invalid")
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFixedArray) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeTuple) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeObject) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeEnum) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeAlias) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeOptional):
        managedLvalueReplaceFail(
            "managed lvalue replace: aggregate member layout/drop-glue authority missing")
    managedLvalueReplaceFail(
        "managed lvalue replace: managed store TypeId kind unsupported")
    return coreir.ManagedStoreNoneTag

@borrows
fn managedLvalueReplaceFindSourceDefinitionExact(
        bodyIR: var coreir.BodyIR,
        sourceSlotId: int32,
        sourceSemanticRow: int32): int32 =
    var definitionOpId: int32 = -1
    var definitionCount: int32
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.valueDefSlot == sourceSlotId &&
           op.valueDefSemanticRow == sourceSemanticRow &&
           op.valueDefOwnership != coreir.OwnInvalid:
            definitionCount = definitionCount + 1
            definitionOpId = opIndex
    if definitionCount != 1:
        managedLvalueReplaceFail(
            "managed lvalue replace: exact source definition is not unique")
    return definitionOpId

@borrows
fn managedLvalueReplaceSourceArgPassKindExact(
        source: coreir.LocalSlot): int32 =
    if source.placeKind == coreir.BodyPlaceGlobalAddressTag:
        return coreir.BodyCallPassGlobalAddressTag
    if source.placeKind == coreir.BodyPlaceBorrowAddressTag:
        return coreir.BodyCallPassBorrowAddressTag
    if source.placeKind == coreir.BodyPlaceStackValueTag ||
       source.placeKind == coreir.BodyPlaceParamAddressTag:
        return coreir.BodyCallPassParamAddressTag
    managedLvalueReplaceFail(
        "managed lvalue replace: source place proof invalid")
    return -1

@borrows
fn ManagedLvalueReplaceProductionBuildGlobalAction(
        bodyIR: var coreir.BodyIR,
        targetSlotId: int32,
        sourceSlotId: int32,
        sourceSemanticRow: int32): ManagedLvalueReplaceProductionAction =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       !coreir.BodyIRCanonicalTypeFactShapeValid(bodyIR) ||
       targetSlotId < 0 ||
       targetSlotId >= bodyIR.localSlots.len ||
       sourceSlotId < 0 ||
       sourceSlotId >= bodyIR.localSlots.len ||
       sourceSemanticRow < 0:
        managedLvalueReplaceFail(
            "managed lvalue replace: production action ingress invalid")
    let target = bodyIR.localSlots[targetSlotId]
    let source = bodyIR.localSlots[sourceSlotId]
    if target.placeKind !=
           coreir.BodyPlaceGlobalAddressTag ||
       target.typeArenaTypeId < 0 ||
       target.typeArenaTypeId != source.typeArenaTypeId ||
       target.managedStorageKind !=
           coreir.BodyManagedStorageManagedTag ||
       source.managedStorageKind !=
           coreir.BodyManagedStorageManagedTag ||
       target.typeKind != source.typeKind ||
       target.sizeBytes != source.sizeBytes ||
       target.alignBytes != source.alignBytes:
        managedLvalueReplaceFail(
            "managed lvalue replace: production target/source proof drift")
    let targetTypeFactRow =
        coreir.BodyIRCanonicalTypeFactRow(
            bodyIR, target.typeArenaTypeId)
    if targetTypeFactRow < 0 ||
       bodyIR.typeFactSizeBytes[targetTypeFactRow] !=
           target.sizeBytes ||
       bodyIR.typeFactAlignBytes[targetTypeFactRow] !=
           target.alignBytes:
        managedLvalueReplaceFail(
            "managed lvalue replace: production type layout proof drift")
    let sourceDefinitionRow =
        managedLvalueReplaceFindSourceDefinitionExact(
            bodyIR, sourceSlotId, sourceSemanticRow)
    let definition = bodyIR.ops[sourceDefinitionRow]
    if definition.valueDefSemanticRow != sourceSemanticRow ||
       definition.valueDefOriginKind !=
           coreir.BodyDefinitionOriginTypedExprTag ||
       definition.valueDefOriginId !=
           definition.valueDefSemanticRow ||
       definition.valueDefConsumeOpIndexPlusOne != 0 ||
       definition.consumeActionRow != -1:
        managedLvalueReplaceFail(
            "managed lvalue replace: source definition authority invalid")
    let managedStoreKind =
        managedLvalueReplaceStoreKindForTypeExact(
            bodyIR,
            source.typeArenaTypeId,
            definition.valueDefOwnership)
    var out: ManagedLvalueReplaceProductionAction
    out.valid = true
    out.targetKind = ManagedLvalueTargetGlobal
    out.replaceMode = ManagedLvalueReplaceBorrowLift
    if managedLvalueReplaceMoveStoreKind(managedStoreKind):
        out.replaceMode = ManagedLvalueReplaceMove
        out.consumeActionRow =
            bodyIR.ops.len
    out.targetLvalueRow = targetSlotId
    out.sourceLvalueRow = sourceSlotId
    out.targetRootStorageRow = targetSlotId
    out.targetSlotId = targetSlotId
    out.targetTypeId = target.typeArenaTypeId
    out.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    out.sourceDefinitionRow = sourceDefinitionRow
    out.sourceSlotId = sourceSlotId
    out.sourceSemanticRow = definition.valueDefSemanticRow
    out.replaceOpId = bodyIR.ops.len
    out.runtimeFunctionRow = -1
    out.sourceArgPassKind =
        managedLvalueReplaceSourceArgPassKindExact(source)
    out.runtimeSemanticCid =
        ManagedLvalueReplaceRuntimeSemanticCid(
            bodyIR.typeArenaArtifactCid,
            target.typeArenaTypeId,
            managedStoreKind,
            target.sizeBytes,
            target.alignBytes,
            coreir.BodyCallPassGlobalAddressTag,
            ManagedLvalueReplaceAddressAbiSizeBytes,
            out.sourceArgPassKind,
            ManagedLvalueReplaceAddressAbiSizeBytes)
    return out

@borrows
fn ManagedLvalueReplaceProductionAppendGlobal(
        bodyIR: var coreir.BodyIR,
        action: ManagedLvalueReplaceProductionAction,
        callOrdinal: var int32): bool =
    if !action.valid ||
       action.targetKind != ManagedLvalueTargetGlobal ||
       action.replaceOpId != bodyIR.ops.len ||
       action.targetRootStorageRow != action.targetSlotId ||
       action.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       action.sourceDefinitionRow < 0 ||
       action.sourceDefinitionRow >= bodyIR.ops.len ||
       action.runtimeFunctionRow != -1 ||
       callOrdinal != bodyIR.callSequence.len ||
       callOrdinal != bodyIR.callTargetDomainKinds.len ||
       callOrdinal != bodyIR.callTargetRows.len ||
       callOrdinal != bodyIR.callTargetInterfaceCids.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: production append state drift")
    let definition =
        bodyIR.ops[action.sourceDefinitionRow]
    if action.targetSlotId < 0 ||
       action.targetSlotId >= bodyIR.localSlots.len ||
       action.sourceSlotId < 0 ||
       action.sourceSlotId >= bodyIR.localSlots.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: production slot identity drift")
    let target = bodyIR.localSlots[action.targetSlotId]
    let source = bodyIR.localSlots[action.sourceSlotId]
    let sourceArgPassKind =
        managedLvalueReplaceSourceArgPassKindExact(source)
    let managedStoreKind =
        managedLvalueReplaceStoreKindForTypeExact(
            bodyIR,
            action.targetTypeId,
            definition.valueDefOwnership)
    let moveStore =
        managedLvalueReplaceMoveStoreKind(managedStoreKind)
    if definition.valueDefSlot != action.sourceSlotId ||
       definition.valueDefSemanticRow != action.sourceSemanticRow ||
       target.typeArenaTypeId != action.targetTypeId ||
       source.typeArenaTypeId != action.targetTypeId ||
       target.sizeBytes != source.sizeBytes ||
       target.alignBytes != source.alignBytes ||
       action.sourceArgPassKind != sourceArgPassKind ||
       definition.valueDefConsumeOpIndexPlusOne != 0 ||
       definition.consumeActionRow != -1 ||
       (moveStore &&
        (action.replaceMode != ManagedLvalueReplaceMove ||
         action.consumeActionRow != action.replaceOpId)) ||
       (!moveStore &&
        (action.replaceMode != ManagedLvalueReplaceBorrowLift ||
         action.consumeActionRow != -1)):
        managedLvalueReplaceFail(
            "managed lvalue replace: production definition preflight invalid")
    if !layout.FixedBytes32Equal(
           action.runtimeSemanticCid,
           ManagedLvalueReplaceRuntimeSemanticCid(
               bodyIR.typeArenaArtifactCid,
               action.targetTypeId,
               managedStoreKind,
               target.sizeBytes,
               target.alignBytes,
               coreir.BodyCallPassGlobalAddressTag,
               ManagedLvalueReplaceAddressAbiSizeBytes,
               sourceArgPassKind,
               ManagedLvalueReplaceAddressAbiSizeBytes)):
        managedLvalueReplaceFail(
            "managed lvalue replace: runtime semantic CID drift")
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol =
        ManagedLvalueReplaceRuntimeLinkerSymbol(
            managedStoreKind)
    call.targetIsImportc = true
    call.managedStoreKind = managedStoreKind
    add(call.argSlots, action.targetSlotId)
    add(call.argPassKinds,
        coreir.BodyCallPassGlobalAddressTag)
    add(call.argAbiSizes,
        ManagedLvalueReplaceAddressAbiSizeBytes)
    if action.sourceArgPassKind ==
           coreir.BodyCallPassGlobalAddressTag:
        add(call.argSlots, action.sourceSlotId)
    else:
        add(call.argSlots,
            coreir.CallArgSlotAddress(action.sourceSlotId))
    add(call.argPassKinds, action.sourceArgPassKind)
    add(call.argAbiSizes,
        ManagedLvalueReplaceAddressAbiSizeBytes)
    call.sourceDefinitionRow =
        action.sourceDefinitionRow
    call.sourceDefinitionDomain =
        action.sourceDefinitionDomain
    call.consumeActionRow = action.consumeActionRow
    add(bodyIR.callSequence, call)
    coreir.BodyIRControlFlowBindCallTarget(
        bodyIR,
        callOrdinal,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
        managedStoreKind,
        action.runtimeSemanticCid)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    add(op.operands, callOrdinal)
    op.sourceDefinitionRow =
        action.sourceDefinitionRow
    op.sourceDefinitionDomain =
        action.sourceDefinitionDomain
    op.consumeActionRow = action.consumeActionRow
    let replaceOpId = coreir.BodyIRAppendOp(bodyIR, op)
    if replaceOpId != action.replaceOpId:
        managedLvalueReplaceFail(
            "managed lvalue replace: replace op identity drift")
    callOrdinal = callOrdinal + 1
    return true

# wall35: intrinsic source-consume 的消费动作权威（managed-replace 生产道的
# ingress 姊妹道）。primary 发射的运行时 intrinsic call（如 Fmt 插值 piece
# join 的 cheng_seq_str_add）收编一个托管 OwnMove 值定义时，body_ir_access
# DecodeCallOrdinal else 臂只承认 explicitSourceConsumer 且
# consumeActionRow >= 0 的 ingress 拼写；该 action 行域与 managed-replace
# move 道的 replaceOpId 戳同源（消费 op 自身行，cleanup_cfg 搬移期按同域
# re-stamp）。本函数按 LoweringBindManagedCallResultDefinition /
# PrimaryBodyIrBindManagedBridgeResultDefinition 的 exact mirror 拼写逐列
# 证明源定义，绑 def 的 valueDefConsumeOpIndexPlusOne 消费边到即将追加的
# 消费 op 行，并返回该 action 行；任何一列不符即 hard fail（fail-closed，
# 绝不静默放行借视/清理动作/已消费定义）。
@borrows
fn ManagedLvalueReplaceProductionBindIntrinsicSourceConsume(
        bodyIR: var coreir.BodyIR,
        sourceSlot: int32,
        sourceDefinitionRow: int32): int32 =
    if sourceSlot < 0 ||
       sourceSlot >= bodyIR.localSlots.len ||
       sourceDefinitionRow < 0 ||
       sourceDefinitionRow >= bodyIR.ops.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: intrinsic consume coordinate invalid")
    let source = bodyIR.localSlots[sourceSlot]
    if source.managedStorageKind !=
           coreir.BodyManagedStorageManagedTag:
        managedLvalueReplaceFail(
            "managed lvalue replace: intrinsic consume source slot not managed")
    var definition = bodyIR.ops[sourceDefinitionRow]
    if definition.valueDefSlot != sourceSlot ||
       definition.valueDefOwnership != coreir.OwnMove ||
       definition.valueDefOriginKind !=
           coreir.BodyDefinitionOriginTypedExprTag ||
       definition.valueDefExprNodeIndex < 0 ||
       definition.valueDefSemanticRow < 0 ||
       definition.valueDefOriginId !=
           definition.valueDefSemanticRow ||
       definition.valueDefConsumeOpIndexPlusOne != 0 ||
       definition.consumeActionRow != -1 ||
       definition.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       definition.sourceDefinitionRow != -1:
        managedLvalueReplaceFail(
            "managed lvalue replace: intrinsic consume source definition authority invalid")
    let consumeActionRow = bodyIR.ops.len
    definition.valueDefConsumeOpIndexPlusOne = consumeActionRow + 1
    bodyIR.ops[sourceDefinitionRow] = definition
    return consumeActionRow

fn managedLvalueReplaceTypeMatchesStoreKind(
        typeKind: int32,
        storeKind: int32): bool =
    if typeKind == coreir.LocalStrTag:
        return storeKind == coreir.ManagedStoreStrRetainTag ||
               storeKind == coreir.ManagedStoreStrMoveTag
    if typeKind == coreir.LocalAggregateTag:
        return storeKind == coreir.ManagedStoreSeqRetainTag ||
               storeKind == coreir.ManagedStoreSeqMoveTag
    return false

@borrows
fn managedLvalueReplaceRawManagedStore(
        bodyIR: var coreir.BodyIR,
        op: coreir.BodyOp): bool =
    var valueSlot = -1
    var targetSlot = -1
    if op.kind == coreir.BodyOpGlobalStoreTag:
        if op.operands.len == 1:
            targetSlot = op.operands[0]
            valueSlot = op.target
    elif op.kind == coreir.BodyOpFieldStoreTag ||
         op.kind == coreir.BodyOpIndexedStoreTag:
        if op.operands.len >= 2:
            targetSlot = op.operands[0]
            valueSlot = op.operands[1]
    else:
        return false
    if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len &&
       bodyIR.localSlots[valueSlot].managedStorageKind ==
           coreir.BodyManagedStorageManagedTag:
        return true
    return targetSlot >= 0 &&
           targetSlot < bodyIR.localSlots.len &&
           op.kind == coreir.BodyOpGlobalStoreTag &&
           bodyIR.localSlots[targetSlot].managedStorageKind ==
               coreir.BodyManagedStorageManagedTag

fn managedLvalueReplaceOpReachesSlot(
        access: var bodyaccess.BodyIrAccessTable,
        opIndex: int32,
        slotId: int32): bool =
    if opIndex < 0 ||
       opIndex >= access.opFactStarts.len ||
       opIndex >= access.opFactCounts.len:
        return false
    let start = access.opFactStarts[opIndex]
    let count = access.opFactCounts[opIndex]
    if start < 0 || count < 0 ||
       start > access.facts.len - count:
        return false
    for offset in 0..<count:
        let fact = access.facts[start + offset]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.slotIndex == slotId:
            return true
    return false

fn managedLvalueReplaceOpReachesDefinition(
        access: var bodyaccess.BodyIrAccessTable,
        opIndex: int32,
        definitionDomain: int32,
        definitionRow: int32,
        slotId: int32,
        requireConsume: bool): bool =
    if opIndex < 0 ||
       opIndex >= access.opFactStarts.len ||
       opIndex >= access.opFactCounts.len:
        return false
    let start = access.opFactStarts[opIndex]
    let count = access.opFactCounts[opIndex]
    if start < 0 || count < 0 ||
       start > access.facts.len - count:
        return false
    for offset in 0..<count:
        let fact = access.facts[start + offset]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.slotIndex == slotId &&
           fact.definitionDomain == definitionDomain &&
           fact.definitionRow == definitionRow &&
           (!requireConsume || fact.consumesDefinition):
            return true
    return false

@borrows
fn managedLvalueReplaceValidatePath(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable,
        plan: var ManagedLvalueReplacePlan,
        row: int32,
        consumerOp: int32) =
    let start = plan.pathStarts[row]
    let count = plan.pathCounts[row]
    if start < 0 || count < 0 ||
       start > plan.pathKinds.len - count:
        managedLvalueReplaceFail(
            "managed lvalue replace: path CSR invalid")
    let targetKind = plan.targetKinds[row]
    if targetKind == ManagedLvalueTargetGlobal:
        if count != 0:
            managedLvalueReplaceFail(
                "managed lvalue replace: global path is not empty")
        return
    if count <= 0:
        managedLvalueReplaceFail(
            "managed lvalue replace: projection path missing")
    if plan.targetRootStorageRows[row] != -1 ||
       plan.targetRootDefinitionDomains[row] !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       plan.targetRootDefinitionRows[row] < 0 ||
       plan.pathParentDefinitionDomains[start] !=
           plan.targetRootDefinitionDomains[row] ||
       plan.pathParentDefinitionRows[start] !=
           plan.targetRootDefinitionRows[row]:
        managedLvalueReplaceFail(
            "managed lvalue replace: projection root authority drift")
    for pathOffset in 0..<count:
        let pathIndex = start + pathOffset
        let parentDefinitionDomain =
            plan.pathParentDefinitionDomains[pathIndex]
        let parentDefinition =
            plan.pathParentDefinitionRows[pathIndex]
        if parentDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           parentDefinition < 0 ||
           parentDefinition >= bodyIR.ops.len:
            managedLvalueReplaceFail(
                "managed lvalue replace: path parent definition invalid")
        let parentSlot =
            bodyIR.ops[parentDefinition].valueDefSlot
        if parentSlot < 0 ||
           parentSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[parentSlot].typeArenaTypeId < 0 ||
           plan.pathMemberRows[pathIndex] < 0 ||
           plan.pathResultTypeIds[pathIndex] < 0 ||
           plan.pathByteOffsets[pathIndex] < 0 ||
           plan.pathByteWidths[pathIndex] <= 0:
            managedLvalueReplaceFail(
                "managed lvalue replace: path tuple authority invalid")
        if bodyIR.ops[parentDefinition].valueDefOriginKind ==
               coreir.BodyDefinitionOriginUnknownTag ||
           bodyIR.ops[parentDefinition].valueDefOriginId < 0:
            managedLvalueReplaceFail(
                "managed lvalue replace: path parent authority missing")
        if plan.pathKinds[pathIndex] == ManagedLvaluePathField &&
           plan.pathByteOffsets[pathIndex] >
               bodyIR.localSlots[parentSlot].sizeBytes -
                   plan.pathByteWidths[pathIndex]:
            managedLvalueReplaceFail(
                "managed lvalue replace: field layout range invalid")
        if pathOffset > 0:
            let previousParentDefinitionDomain =
                plan.pathParentDefinitionDomains[pathIndex - 1]
            let previousParentDefinition =
                plan.pathParentDefinitionRows[pathIndex - 1]
            let previousParentSlot =
                bodyIR.ops[previousParentDefinition].valueDefSlot
            if previousParentDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               bodyIR.localSlots[parentSlot].placeKind !=
                   coreir.BodyPlaceBorrowAddressTag ||
               bodyIR.localSlots[parentSlot].auxValue !=
                   previousParentSlot ||
               bodyIR.localSlots[parentSlot].typeArenaTypeId !=
                   plan.pathResultTypeIds[pathIndex - 1]:
                managedLvalueReplaceFail(
                    "managed lvalue replace: path edge authority drift")
        if pathOffset + 1 < count:
            let nextParentDomain =
                plan.pathParentDefinitionDomains[pathIndex + 1]
            let nextParent =
                plan.pathParentDefinitionRows[pathIndex + 1]
            if nextParentDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               nextParent < 0 ||
               nextParent >= bodyIR.ops.len:
                managedLvalueReplaceFail(
                    "managed lvalue replace: path child definition invalid")
            let nextParentSlot =
                bodyIR.ops[nextParent].valueDefSlot
            if nextParentSlot < 0 ||
               nextParentSlot >= bodyIR.localSlots.len:
                managedLvalueReplaceFail(
                    "managed lvalue replace: path child slot invalid")
            if bodyIR.localSlots[nextParentSlot].typeArenaTypeId !=
                   plan.pathResultTypeIds[pathIndex]:
                managedLvalueReplaceFail(
                    "managed lvalue replace: path child TypeId drift")
            if !managedLvalueReplaceOpReachesDefinition(
                   access,
                   nextParent,
                   parentDefinitionDomain,
                   parentDefinition,
                   parentSlot,
                   false):
                managedLvalueReplaceFail(
                    "managed lvalue replace: path child definition does not reach")
    let terminal = start + count - 1
    if plan.pathResultTypeIds[terminal] !=
           plan.targetTypeIds[row]:
        managedLvalueReplaceFail(
            "managed lvalue replace: terminal TypeId drift")
    var expectedTerminal = ManagedLvaluePathIndexed
    if targetKind == ManagedLvalueTargetField:
        expectedTerminal = ManagedLvaluePathField
    if plan.pathKinds[terminal] != expectedTerminal:
        managedLvalueReplaceFail(
            "managed lvalue replace: terminal projection kind drift")
    if plan.pathParentDefinitionDomains[terminal] !=
           coreir.BodyDefinitionDomainBodyOpTag:
        managedLvalueReplaceFail(
            "managed lvalue replace: terminal definition domain drift")
    let terminalParent =
        plan.pathParentDefinitionRows[terminal]
    let terminalParentSlot =
        bodyIR.ops[terminalParent].valueDefSlot
    let targetSlot = plan.targetSlotIds[row]
    if bodyIR.localSlots[targetSlot].placeKind !=
           coreir.BodyPlaceBorrowAddressTag ||
       bodyIR.localSlots[targetSlot].auxValue !=
           terminalParentSlot:
        managedLvalueReplaceFail(
            "managed lvalue replace: target address parent drift")
    if consumerOp >= 0 &&
       !managedLvalueReplaceOpReachesSlot(
           access, consumerOp, targetSlot):
        managedLvalueReplaceFail(
            "managed lvalue replace: target address does not reach consumer")

@borrows
fn managedLvalueReplaceValidateRow(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable,
        plan: var ManagedLvalueReplacePlan,
        row: int32,
        report: var ManagedLvalueReplaceAdmissionReport) =
    let targetSlot = plan.targetSlotIds[row]
    let sourceSlot = plan.sourceSlotIds[row]
    let sourceDefinitionDomain =
        plan.sourceDefinitionDomains[row]
    let sourceDefinition = plan.sourceDefinitionRows[row]
    let mode = plan.replaceModes[row]
    let targetKind = plan.targetKinds[row]
    if (targetKind != ManagedLvalueTargetGlobal &&
        targetKind != ManagedLvalueTargetField &&
        targetKind != ManagedLvalueTargetIndexed) ||
       (mode != ManagedLvalueReplaceMove &&
        mode != ManagedLvalueReplaceBorrowLift &&
        mode != ManagedLvalueReplaceSelfAliasNoOp) ||
       plan.targetLvalueRows[row] < 0 ||
       plan.sourceLvalueRows[row] < 0 ||
       targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       sourceSlot < 0 ||
       sourceSlot >= bodyIR.localSlots.len ||
       sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       sourceDefinition < 0 ||
       sourceDefinition >= bodyIR.ops.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: row identity out of range")
    let target = bodyIR.localSlots[targetSlot]
    let source = bodyIR.localSlots[sourceSlot]
    let definition = bodyIR.ops[sourceDefinition]
    let targetTypeFactRow =
        coreir.BodyIRCanonicalTypeFactRow(
            bodyIR, plan.targetTypeIds[row])
    if target.typeArenaTypeId != plan.targetTypeIds[row] ||
       source.typeArenaTypeId != plan.targetTypeIds[row] ||
       targetTypeFactRow < 0 ||
       bodyIR.typeFactSizeBytes[targetTypeFactRow] !=
           target.sizeBytes ||
       bodyIR.typeFactAlignBytes[targetTypeFactRow] !=
           target.alignBytes ||
       target.managedStorageKind !=
           coreir.BodyManagedStorageManagedTag ||
       source.managedStorageKind !=
           coreir.BodyManagedStorageManagedTag ||
       target.typeKind != source.typeKind ||
       target.sizeBytes != source.sizeBytes ||
       target.alignBytes != source.alignBytes ||
       definition.valueDefSlot != sourceSlot ||
       definition.valueDefSemanticRow !=
           plan.sourceSemanticRows[row] ||
       definition.valueDefOriginKind ==
           coreir.BodyDefinitionOriginUnknownTag ||
       definition.valueDefOriginId !=
           plan.sourceSemanticRows[row]:
        managedLvalueReplaceFail(
            "managed lvalue replace: exact source/target TypeId tuple drift")
    var consumer = plan.replaceOpIds[row]
    if mode == ManagedLvalueReplaceSelfAliasNoOp:
        consumer = bodyIR.ops.len
    managedLvalueReplaceValidatePath(
        bodyIR, access, plan, row, consumer)
    if plan.targetKinds[row] == ManagedLvalueTargetGlobal:
        if target.placeKind !=
               coreir.BodyPlaceGlobalAddressTag ||
           plan.targetRootStorageRows[row] != targetSlot ||
           plan.targetRootDefinitionDomains[row] !=
               coreir.BodyDefinitionDomainInvalidTag ||
           plan.targetRootDefinitionRows[row] != -1:
            managedLvalueReplaceFail(
                "managed lvalue replace: global root drift")

    if mode == ManagedLvalueReplaceSelfAliasNoOp:
        if plan.sourceLvalueRows[row] !=
               plan.targetLvalueRows[row] ||
           sourceSlot != targetSlot ||
           plan.replaceOpIds[row] != -1 ||
           plan.consumeActionRows[row] != -1 ||
           definition.valueDefConsumeOpIndexPlusOne != 0:
            managedLvalueReplaceFail(
                "managed lvalue replace: self alias mutated storage")
        report.selfAliasNoOpCount =
            report.selfAliasNoOpCount + 1
        return

    let replaceOpId = plan.replaceOpIds[row]
    if replaceOpId < 0 ||
       replaceOpId >= bodyIR.ops.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: replace op invalid")
    if !managedLvalueReplaceOpReachesDefinition(
           access,
           replaceOpId,
           sourceDefinitionDomain,
           sourceDefinition,
           sourceSlot,
           mode == ManagedLvalueReplaceMove):
        managedLvalueReplaceFail(
            "managed lvalue replace: source definition does not reach replace")
    let replaceOp = bodyIR.ops[replaceOpId]
    if replaceOp.kind != coreir.BodyOpCallTag ||
       replaceOp.target != -1 ||
       replaceOp.valueDefSlot != -1 ||
       replaceOp.valueDefSemanticRow != -1 ||
       replaceOp.valueDefOwnership != coreir.OwnInvalid ||
       replaceOp.valueDefOriginKind !=
           coreir.BodyDefinitionOriginUnknownTag ||
       replaceOp.valueDefOriginId != -1 ||
       replaceOp.operands.len != 1 ||
       replaceOp.operands[0] < 0 ||
       replaceOp.operands[0] >= bodyIR.callSequence.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: atomic CallOp missing")
    let callOrdinal = replaceOp.operands[0]
    let call = bodyIR.callSequence[callOrdinal]
    if call.argSlots.len != 2 ||
       call.argPassKinds.len != 2 ||
       call.argAbiSizes.len != 2 ||
       call.argAbiSizes[0] !=
           ManagedLvalueReplaceAddressAbiSizeBytes ||
       call.argAbiSizes[1] !=
           ManagedLvalueReplaceAddressAbiSizeBytes ||
       call.resultSlot != -1 ||
       call.resultOwnership != coreir.OwnInvalid ||
       call.resultExprNodeIndex != -1 ||
       call.resultValueDefinitionRow != -1 ||
       call.resultDefinitionOriginKind !=
           coreir.BodyDefinitionOriginUnknownTag ||
       call.resultDefinitionOriginId != -1 ||
       !managedLvalueReplaceManagedStoreKind(
           call.managedStoreKind) ||
       !managedLvalueReplaceTypeMatchesStoreKind(
           target.typeKind, call.managedStoreKind) ||
       managedLvalueReplaceDecodedArgSlot(
           bodyIR, call, 0) != targetSlot ||
       managedLvalueReplaceDecodedArgSlot(
           bodyIR, call, 1) != sourceSlot:
        managedLvalueReplaceFail(
            "managed lvalue replace: atomic call shape drift")
    if plan.targetKinds[row] == ManagedLvalueTargetGlobal:
        if call.argPassKinds[0] !=
               coreir.BodyCallPassGlobalAddressTag:
            managedLvalueReplaceFail(
                "managed lvalue replace: global address pass drift")
    elif call.argPassKinds[0] !=
             coreir.BodyCallPassBorrowAddressTag:
        managedLvalueReplaceFail(
            "managed lvalue replace: projection address pass drift")
    let expectedSourcePassKind =
        managedLvalueReplaceSourceArgPassKindExact(source)
    if call.argPassKinds[1] != expectedSourcePassKind:
        managedLvalueReplaceFail(
            "managed lvalue replace: source address pass drift")
    if callOrdinal >= bodyIR.callTargetDomainKinds.len ||
       callOrdinal >= bodyIR.callTargetRows.len ||
       callOrdinal >= bodyIR.callTargetInterfaceCids.len ||
       bodyIR.callTargetDomainKinds[callOrdinal] !=
           coreir.BodyCallTargetDomainRuntimeIntrinsicTag ||
       bodyIR.callTargetRows[callOrdinal] !=
           coreir.BodyIRRuntimeIntrinsicCanonicalRow(
               bodyIR,
               plan.runtimeSemanticCids[row]) ||
       plan.runtimeFunctionRows[row] != -1 ||
       !layout.FixedBytes32Equal(
           bodyIR.callTargetInterfaceCids[callOrdinal],
           plan.runtimeSemanticCids[row]) ||
       !layout.FixedBytes32Equal(
           plan.runtimeSemanticCids[row],
           ManagedLvalueReplaceRuntimeSemanticCid(
               bodyIR.typeArenaArtifactCid,
               plan.targetTypeIds[row],
               call.managedStoreKind,
               target.sizeBytes,
               target.alignBytes,
               call.argPassKinds[0],
               call.argAbiSizes[0],
               call.argPassKinds[1],
               call.argAbiSizes[1])):
        managedLvalueReplaceFail(
            "managed lvalue replace: runtime semantic identity drift")
    if mode == ManagedLvalueReplaceMove:
        if definition.valueDefOwnership != coreir.OwnMove ||
           plan.consumeActionRows[row] != replaceOpId ||
           definition.valueDefConsumeOpIndexPlusOne != 0 ||
           definition.consumeActionRow != -1 ||
           replaceOp.sourceDefinitionDomain !=
               sourceDefinitionDomain ||
           replaceOp.sourceDefinitionRow != sourceDefinition ||
           replaceOp.consumeActionRow !=
               plan.consumeActionRows[row] ||
           call.sourceDefinitionDomain !=
               sourceDefinitionDomain ||
           call.sourceDefinitionRow != sourceDefinition ||
           call.consumeActionRow !=
               plan.consumeActionRows[row] ||
           !managedLvalueReplaceMoveStoreKind(
               call.managedStoreKind):
            managedLvalueReplaceFail(
                "managed lvalue replace: move consume tuple drift")
        report.moveCount = report.moveCount + 1
        report.sourceConsumeCount =
            report.sourceConsumeCount + 1
    elif mode == ManagedLvalueReplaceBorrowLift:
        if definition.valueDefOwnership !=
               coreir.OwnBorrowShared ||
           definition.valueDefConsumeOpIndexPlusOne != 0 ||
           definition.consumeActionRow != -1 ||
           replaceOp.sourceDefinitionDomain !=
               sourceDefinitionDomain ||
           replaceOp.sourceDefinitionRow != sourceDefinition ||
           replaceOp.consumeActionRow != -1 ||
           call.sourceDefinitionDomain !=
               sourceDefinitionDomain ||
           call.sourceDefinitionRow != sourceDefinition ||
           call.consumeActionRow != -1 ||
           !managedLvalueReplaceRetainStoreKind(
               call.managedStoreKind):
            managedLvalueReplaceFail(
                "managed lvalue replace: borrow lift tuple drift")
        report.borrowLiftCount =
            report.borrowLiftCount + 1
    else:
        managedLvalueReplaceFail(
            "managed lvalue replace: row mode drift")
    report.replaceCount = report.replaceCount + 1
    report.oldCaptureBeforeNewCount =
        report.oldCaptureBeforeNewCount + 1
    report.oldDropReleaseCount =
        report.oldDropReleaseCount + 1

@borrows
fn ManagedLvalueReplaceAdmit(
        bodyIR: var coreir.BodyIR,
        plan: var ManagedLvalueReplacePlan): ManagedLvalueReplaceAdmissionReport =
    var access = bodyaccess.BodyIrAccessDecode(bodyIR)
    return ManagedLvalueReplaceAdmitWithAccess(
        bodyIR, access, plan)

@borrows
fn ManagedLvalueReplaceAdmitWithAccess(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable,
        plan: var ManagedLvalueReplacePlan): ManagedLvalueReplaceAdmissionReport =
    var report: ManagedLvalueReplaceAdmissionReport
    if !bodyaccess.BodyIrAccessTableIsValid(access):
        managedLvalueReplaceFail(
            Fmt"managed lvalue replace: BodyIR access invalid code={access.errorCode} site={access.errorSiteKind}:{access.errorSiteIndex} detail={access.errorDetail}")
    if !plan.prepared || !plan.sealed ||
       !managedLvalueReplacePlanColumnsValid(plan) ||
       !managedLvalueReplacePathCsrValid(plan) ||
       plan.sealedFingerprint !=
           managedLvalueReplacePlanFingerprint(plan):
        managedLvalueReplaceFail(
            "managed lvalue replace: sealed receipt mutated")
    if !bodyIR.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.controlFunctionRow != plan.functionRow ||
       !layout.FixedBytes32Equal(
           bodyIR.typeArenaArtifactCid,
           plan.typeArenaArtifactCid):
        managedLvalueReplaceFail(
            "managed lvalue replace: frozen BodyIR identity drift")
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if managedLvalueReplaceRawManagedStore(bodyIR, op):
            report.rawManagedStoreCount =
                report.rawManagedStoreCount + 1
        if op.kind != coreir.BodyOpCallTag ||
           op.operands.len != 1 ||
           op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.callSequence.len ||
           !managedLvalueReplaceLegacyManagedStoreKind(
               bodyIR.callSequence[
                   op.operands[0]].managedStoreKind):
            continue
        var receiptCount: int32
        for row in 0..<plan.replaceOpIds.len:
            if plan.replaceOpIds[row] == opIndex:
                receiptCount = receiptCount + 1
        if receiptCount != 1:
            managedLvalueReplaceFail(
                "managed lvalue replace: managed call receipt is not unique")
    if report.rawManagedStoreCount != 0:
        managedLvalueReplaceFail(
            "managed lvalue replace: raw managed store rejected")
    for row in 0..<plan.targetKinds.len:
        managedLvalueReplaceValidateRow(
            bodyIR, access, plan, row, report)
    report.valid = true
    report.fingerprint = plan.sealedFingerprint
    return report

@borrows
fn managedLvalueReplaceSidecarDefinitionExact(
        bodyIR: var coreir.BodyIR,
        definitionDomain: int32,
        definitionRow: int32,
        expectedSlot: int32,
        expectedSemanticRow: int32,
        expectedOwnership: coreir.OwnershipKind): bool =
    if expectedSlot < 0 ||
       expectedSlot >= bodyIR.localSlots.len ||
       expectedSemanticRow < 0:
        return false
    if definitionDomain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        return definitionRow == expectedSlot &&
               definitionRow >= 0 &&
               definitionRow <
                   bodyIR.entryDefinitionOwnershipKinds.len &&
               definitionRow <
                   bodyIR.entryDefinitionSemanticRows.len &&
               bodyIR.entryDefinitionOwnershipKinds[definitionRow] ==
                   int32(expectedOwnership) &&
               bodyIR.entryDefinitionSemanticRows[definitionRow] ==
                   expectedSemanticRow
    if definitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       definitionRow < 0 ||
       definitionRow >= bodyIR.ops.len:
        return false
    let definition = bodyIR.ops[definitionRow]
    return definition.valueDefSlot == expectedSlot &&
           definition.valueDefSemanticRow == expectedSemanticRow &&
           definition.valueDefOwnership == expectedOwnership &&
           definition.valueDefOriginKind !=
               coreir.BodyDefinitionOriginUnknownTag &&
           definition.valueDefOriginId >= 0

@borrows
fn managedLvalueReplaceSidecarSourceFactExact(
        access: var bodyaccess.BodyIrAccessTable,
        opIndex: int32,
        definitionDomain: int32,
        definitionRow: int32,
        sourceSlot: int32,
        consumesDefinition: bool): bool =
    if opIndex < 0 ||
       opIndex >= access.opFactStarts.len ||
       opIndex >= access.opFactCounts.len:
        return false
    let start = access.opFactStarts[opIndex]
    let count = access.opFactCounts[opIndex]
    if start < 0 || count < 0 ||
       start > access.facts.len - count:
        return false
    var matchCount: int32
    for offset in 0..<count:
        let fact = access.facts[start + offset]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.slotIndex == sourceSlot &&
           fact.definitionDomain == definitionDomain &&
           fact.definitionRow == definitionRow &&
           fact.consumesDefinition == consumesDefinition:
            matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn managedLvalueReplaceSidecarTargetFactExact(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable,
        opIndex: int32,
        targetSlot: int32): bool =
    if opIndex < 0 ||
       opIndex >= access.opFactStarts.len ||
       opIndex >= access.opFactCounts.len:
        return false
    let start = access.opFactStarts[opIndex]
    let count = access.opFactCounts[opIndex]
    if start < 0 || count < 0 ||
       start > access.facts.len - count:
        return false
    var matchCount: int32
    for offset in 0..<count:
        let fact = access.facts[start + offset]
        if fact.kind == bodyaccess.BodyIrAccessFactAddress &&
           fact.slotIndex == targetSlot &&
           bodyaccess.BodyIrAccessAddressFactIsValid(
               bodyIR, fact):
            matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn managedLvalueReplaceSidecarConstArgExact(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable,
        opIndex: int32,
        call: coreir.CallOp,
        argOrdinal: int32,
        expectedValue: int32): bool =
    let _ = access
    if opIndex < 0 || opIndex >= bodyIR.ops.len ||
       argOrdinal < 0 || argOrdinal >= call.argSlots.len ||
       argOrdinal >= call.argPassKinds.len ||
       call.argPassKinds[argOrdinal] !=
           coreir.BodyCallPassStackValueTag:
        return false
    let expectedSlot = call.argSlots[argOrdinal]
    if expectedSlot < 0 || expectedSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[expectedSlot].typeKind !=
           coreir.LocalI32Tag:
        return false
    let receiptRow = call.managedReplaceReceiptRow
    if receiptRow < 0 ||
       receiptRow >=
           bodyIR.managedLvalueReplace.targetAddressDefinitionRows.len:
        return false
    let addressDefinitionRow =
        bodyIR.managedLvalueReplace.targetAddressDefinitionRows[
            receiptRow]
    let definitionRow = addressDefinitionRow - (6 - argOrdinal)
    if definitionRow < 0 || definitionRow >= addressDefinitionRow ||
       addressDefinitionRow >= opIndex:
        return false
    let definition = bodyIR.ops[definitionRow]
    return definition.kind == coreir.BodyOpLoadConstTag &&
           definition.target == expectedSlot &&
           definition.operands.len == 2 &&
           definition.operands[0] == coreir.LocalI32Tag &&
           definition.operands[1] == expectedValue

@borrows
fn managedLvalueReplaceProductionAdmitSidecarExact(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable):
        ManagedLvalueReplaceAdmissionReport =
    var report: ManagedLvalueReplaceAdmissionReport
    if coreir.BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
           bodyIR.managedLvalueReplace):
        report.valid = true
        return report
    if !coreir.BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR) ||
       !bodyIR.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.managedLvalueReplace.functionRow !=
           bodyIR.controlFunctionRow ||
       !layout.FixedBytes32Equal(
           bodyIR.managedLvalueReplace.typeArenaArtifactCid,
           bodyIR.typeArenaArtifactCid):
        managedLvalueReplaceFail(
            "managed lvalue replace: aggregate sidecar is not frozen")
    var aggregateCallCount: int32
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind != coreir.BodyOpCallTag ||
           op.operands.len != 1 ||
           op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.callSequence.len:
            continue
        let call = bodyIR.callSequence[op.operands[0]]
        if call.managedStoreKind ==
               coreir.ManagedStoreAggregateRetainTag ||
           call.managedStoreKind ==
               coreir.ManagedStoreAggregateMoveTag:
            aggregateCallCount = aggregateCallCount + 1
    if aggregateCallCount !=
           bodyIR.managedLvalueReplace.callOrdinals.len:
        managedLvalueReplaceFail(
            "managed lvalue replace: aggregate call receipt count drift")
    for row in 0..<bodyIR.managedLvalueReplace.callOrdinals.len:
        let callOrdinal =
            bodyIR.managedLvalueReplace.callOrdinals[row]
        let replaceOpRow =
            bodyIR.managedLvalueReplace.replaceOpRows[row]
        let targetSlot =
            bodyIR.managedLvalueReplace.targetAddressSlotIds[row]
        let sourceSlot =
            bodyIR.managedLvalueReplace.sourceSlotIds[row]
        let sourceDefinitionDomain =
            bodyIR.managedLvalueReplace.sourceDefinitionDomains[row]
        let sourceDefinitionRow =
            bodyIR.managedLvalueReplace.sourceDefinitionRows[row]
        let sourceSemanticRow =
            bodyIR.managedLvalueReplace.sourceSemanticRows[row]
        let mode = bodyIR.managedLvalueReplace.replaceModes[row]
        let call = bodyIR.callSequence[callOrdinal]
        let replaceOp = bodyIR.ops[replaceOpRow]
        let descriptorRow =
            bodyIR.managedLvalueReplace.dropGlueDescriptorRows[row]
        var expectedSourceOwnership = coreir.OwnBorrowShared
        var expectedStoreKind =
            coreir.ManagedStoreAggregateRetainTag
        var expectedConsume = false
        if mode == ManagedLvalueReplaceMove:
            expectedSourceOwnership = coreir.OwnMove
            expectedStoreKind =
                coreir.ManagedStoreAggregateMoveTag
            expectedConsume = true
        elif mode != ManagedLvalueReplaceBorrowLift:
            managedLvalueReplaceFail(
                "managed lvalue replace: aggregate mode drift")
        if !managedLvalueReplaceSidecarConstArgExact(
               bodyIR, access, replaceOpRow, call, 3,
               len(bodyIR.managedLvalueReplace.descriptorPayloads[
                   descriptorRow])):
            managedLvalueReplaceFail(
                "managed lvalue replace: descriptor length value-def drift")
        if !managedLvalueReplaceSidecarConstArgExact(
               bodyIR, access, replaceOpRow, call, 4,
               bodyIR.managedLvalueReplace.targetTypeIds[row]):
            managedLvalueReplaceFail(
                "managed lvalue replace: descriptor root value-def drift")
        if !managedLvalueReplaceSidecarConstArgExact(
               bodyIR, access, replaceOpRow, call, 5, mode):
            managedLvalueReplaceFail(
                "managed lvalue replace: descriptor mode value-def drift")
        if replaceOp.kind != coreir.BodyOpCallTag ||
           replaceOp.operands.len != 1 ||
           replaceOp.operands[0] != callOrdinal ||
           replaceOp.sourceDefinitionDomain !=
               sourceDefinitionDomain ||
           replaceOp.sourceDefinitionRow != sourceDefinitionRow ||
           replaceOp.consumeActionRow !=
               bodyIR.managedLvalueReplace.consumeActionRows[row] ||
           call.managedStoreKind != expectedStoreKind ||
           call.managedReplaceReceiptRow != row ||
           call.managedDropGlueDescriptorRow !=
               bodyIR.managedLvalueReplace.dropGlueDescriptorRows[row] ||
           descriptorRow < 0 ||
           descriptorRow >=
               bodyIR.managedLvalueReplace.descriptorPayloads.len ||
           call.argSlots.len != 6 ||
           call.argPassKinds.len != 6 ||
           call.argAbiSizes.len != 6 ||
           call.argPassKinds[0] !=
               coreir.BodyCallPassBorrowAddressTag ||
           call.argAbiSizes[0] !=
               ManagedLvalueReplaceAddressAbiSizeBytes ||
           call.argAbiSizes[1] !=
               ManagedLvalueReplaceAddressAbiSizeBytes ||
           call.argPassKinds[2] !=
               coreir.BodyCallPassStackValueTag ||
           call.argAbiSizes[2] !=
               ManagedLvalueReplaceAddressAbiSizeBytes ||
           !coreir.CallArgSlotIsCString(call.argSlots[2]) ||
           coreir.CallArgSlotCStringId(call.argSlots[2]) < 0 ||
           coreir.CallArgSlotCStringId(call.argSlots[2]) >=
               bodyIR.cstringLiterals.len ||
           bodyIR.cstringLiterals[
               coreir.CallArgSlotCStringId(call.argSlots[2])].text !=
               bodyIR.managedLvalueReplace.descriptorPayloads[
                   descriptorRow] ||
           managedLvalueReplaceDecodedArgSlot(
               bodyIR, call, 0) != targetSlot ||
           managedLvalueReplaceDecodedArgSlot(
               bodyIR, call, 1) != sourceSlot ||
           call.sourceDefinitionDomain !=
               sourceDefinitionDomain ||
           call.sourceDefinitionRow != sourceDefinitionRow ||
           call.consumeActionRow !=
               bodyIR.managedLvalueReplace.consumeActionRows[row] ||
           callOrdinal >= bodyIR.callTargetDomainKinds.len ||
           bodyIR.callTargetDomainKinds[callOrdinal] !=
               coreir.BodyCallTargetDomainRuntimeIntrinsicTag ||
           !layout.FixedBytes32Equal(
               bodyIR.callTargetInterfaceCids[callOrdinal],
               bodyIR.managedLvalueReplace.runtimeSemanticCids[row]) ||
           bodyIR.localSlots[targetSlot].typeArenaTypeId !=
               bodyIR.managedLvalueReplace.targetTypeIds[row] ||
           bodyIR.localSlots[targetSlot].typeKind !=
               coreir.LocalPtrTag ||
           bodyIR.localSlots[targetSlot].placeKind !=
               coreir.BodyPlaceBorrowAddressTag ||
           bodyIR.localSlots[targetSlot].managedStorageKind !=
               coreir.BodyManagedStorageManagedTag ||
           bodyIR.localSlots[sourceSlot].typeArenaTypeId !=
               bodyIR.managedLvalueReplace.targetTypeIds[row] ||
           bodyIR.localSlots[sourceSlot].managedStorageKind !=
               coreir.BodyManagedStorageManagedTag ||
           !managedLvalueReplaceSidecarDefinitionExact(
               bodyIR,
               sourceDefinitionDomain,
               sourceDefinitionRow,
               sourceSlot,
               sourceSemanticRow,
               expectedSourceOwnership) ||
           !managedLvalueReplaceSidecarSourceFactExact(
               access,
               replaceOpRow,
               sourceDefinitionDomain,
               sourceDefinitionRow,
               sourceSlot,
               expectedConsume) ||
           !managedLvalueReplaceSidecarTargetFactExact(
               bodyIR, access, replaceOpRow, targetSlot) ||
           !managedLvalueReplaceSidecarConstArgExact(
               bodyIR,
               access,
               replaceOpRow,
               call,
               3,
               len(bodyIR.managedLvalueReplace.descriptorPayloads[
                   descriptorRow])) ||
           !managedLvalueReplaceSidecarConstArgExact(
               bodyIR,
               access,
               replaceOpRow,
               call,
               4,
               bodyIR.managedLvalueReplace.targetTypeIds[row]) ||
           !managedLvalueReplaceSidecarConstArgExact(
               bodyIR,
               access,
               replaceOpRow,
               call,
               5,
               mode):
            managedLvalueReplaceFail(
                "managed lvalue replace: aggregate action receipt drift")
        if mode == ManagedLvalueReplaceMove:
            report.moveCount = report.moveCount + 1
            report.sourceConsumeCount =
                report.sourceConsumeCount + 1
        else:
            report.borrowLiftCount =
                report.borrowLiftCount + 1
        report.replaceCount = report.replaceCount + 1
        report.oldCaptureBeforeNewCount =
            report.oldCaptureBeforeNewCount + 1
        report.oldDropReleaseCount =
            report.oldDropReleaseCount + 1
    report.valid = true
    report.fingerprint = managedLvalueReplaceFingerprintCid(
        int64(41), bodyIR.managedLvalueReplace.rootCid)
    return report

@borrows
fn ManagedLvalueReplaceProductionVerify(
        bodyIR: var coreir.BodyIR): ManagedLvalueReplaceAdmissionReport =
    var access = bodyaccess.BodyIrAccessDecode(bodyIR)
    return ManagedLvalueReplaceProductionVerifyWithAccess(
        bodyIR, access)

@borrows
fn ManagedLvalueReplaceProductionVerifyWithAccess(
        bodyIR: var coreir.BodyIR,
        access: var bodyaccess.BodyIrAccessTable):
        ManagedLvalueReplaceAdmissionReport =
    if !bodyaccess.BodyIrAccessTableIsValid(access):
        managedLvalueReplaceFail(
            Fmt"managed lvalue replace: production BodyIR access invalid code={access.errorCode} site={access.errorSiteKind}:{access.errorSiteIndex} detail={access.errorDetail}")
    var managedCallCount: int32
    var legacyManagedCallCount: int32
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if managedLvalueReplaceRawManagedStore(bodyIR, op):
            managedLvalueReplaceFail(
                "managed lvalue replace: raw managed store rejected")
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1 &&
           op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.callSequence.len &&
           managedLvalueReplaceManagedStoreKind(
               bodyIR.callSequence[
                   op.operands[0]].managedStoreKind):
            managedCallCount = managedCallCount + 1
            if managedLvalueReplaceLegacyManagedStoreKind(
                   bodyIR.callSequence[
                       op.operands[0]].managedStoreKind):
                legacyManagedCallCount =
                    legacyManagedCallCount + 1
    if managedCallCount == 0:
        var empty: ManagedLvalueReplaceAdmissionReport
        empty.valid = true
        return empty
    if !bodyIR.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.controlFunctionRow < 0 ||
       !coreir.BodyIRCanonicalTypeFactShapeValid(bodyIR):
        managedLvalueReplaceFail(
            "managed lvalue replace: production BodyIR is not frozen")

    var sidecarReport =
        managedLvalueReplaceProductionAdmitSidecarExact(
            bodyIR, access)
    if legacyManagedCallCount == 0:
        return sidecarReport

    var plan: ManagedLvalueReplacePlan
    ManagedLvalueReplacePlanPrepare(
        plan,
        bodyIR.controlFunctionRow,
        bodyIR.typeArenaArtifactCid)
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind != coreir.BodyOpCallTag ||
           op.operands.len != 1 ||
           op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.callSequence.len:
            continue
        let callOrdinal = op.operands[0]
        let call = bodyIR.callSequence[callOrdinal]
        if !managedLvalueReplaceLegacyManagedStoreKind(
               call.managedStoreKind):
            continue
        if callOrdinal >=
               bodyIR.callTargetDomainKinds.len ||
           callOrdinal >= bodyIR.callTargetRows.len ||
           callOrdinal >=
               bodyIR.callTargetInterfaceCids.len ||
           bodyIR.callTargetDomainKinds[callOrdinal] !=
               coreir.BodyCallTargetDomainRuntimeIntrinsicTag ||
           bodyIR.callTargetRows[callOrdinal] !=
               coreir.BodyIRRuntimeIntrinsicCanonicalRow(
                   bodyIR,
                   bodyIR.callTargetInterfaceCids[callOrdinal]) ||
           call.argPassKinds.len != 2 ||
           call.argPassKinds[0] !=
               coreir.BodyCallPassGlobalAddressTag:
            managedLvalueReplaceFail(
                "managed lvalue replace: projection receipt missing")
        let targetSlot =
            managedLvalueReplaceDecodedArgSlot(
                bodyIR, call, 0)
        let sourceSlot =
            managedLvalueReplaceDecodedArgSlot(
                bodyIR, call, 1)
        let sourceDefinitionDomain =
            call.sourceDefinitionDomain
        let sourceDefinition = call.sourceDefinitionRow
        if targetSlot < 0 ||
           sourceSlot < 0 ||
           sourceDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           sourceDefinition < 0 ||
           sourceDefinition >= bodyIR.ops.len:
            managedLvalueReplaceFail(
                "managed lvalue replace: production identity missing")
        let definition = bodyIR.ops[sourceDefinition]
        var replaceMode =
            ManagedLvalueReplaceBorrowLift
        if managedLvalueReplaceMoveStoreKind(
               call.managedStoreKind):
            replaceMode = ManagedLvalueReplaceMove
        var pathKinds: int32[]
        var pathParentDefinitionDomains: int32[]
        var pathParentDefinitionRows: int32[]
        var pathMemberRows: int32[]
        var pathResultTypeIds: int32[]
        var pathByteOffsets: int32[]
        var pathByteWidths: int32[]
        let _ = ManagedLvalueReplacePlanAppendExact(
            plan,
            ManagedLvalueTargetGlobal,
            replaceMode,
            targetSlot,
            sourceSlot,
            targetSlot,
            coreir.BodyDefinitionDomainInvalidTag,
            -1,
            targetSlot,
            bodyIR.localSlots[targetSlot].typeArenaTypeId,
            sourceDefinitionDomain,
            sourceDefinition,
            sourceSlot,
            definition.valueDefSemanticRow,
            opIndex,
            call.consumeActionRow,
            -1,
            layout.FixedBytes32Copy(bodyIR.callTargetInterfaceCids[callOrdinal]),
            pathKinds,
            pathParentDefinitionDomains,
            pathParentDefinitionRows,
            pathMemberRows,
            pathResultTypeIds,
            pathByteOffsets,
            pathByteWidths)
    ManagedLvalueReplacePlanSeal(plan)
    var report = ManagedLvalueReplaceAdmitWithAccess(
        bodyIR, access, plan)
    report.replaceCount =
        report.replaceCount + sidecarReport.replaceCount
    report.moveCount = report.moveCount + sidecarReport.moveCount
    report.borrowLiftCount =
        report.borrowLiftCount + sidecarReport.borrowLiftCount
    report.sourceConsumeCount =
        report.sourceConsumeCount + sidecarReport.sourceConsumeCount
    report.oldCaptureBeforeNewCount =
        report.oldCaptureBeforeNewCount +
        sidecarReport.oldCaptureBeforeNewCount
    report.oldDropReleaseCount =
        report.oldDropReleaseCount +
        sidecarReport.oldDropReleaseCount
    if !coreir.BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
           bodyIR.managedLvalueReplace):
        report.fingerprint = managedLvalueReplaceFingerprintCid(
            report.fingerprint,
            bodyIR.managedLvalueReplace.rootCid)
    return report
