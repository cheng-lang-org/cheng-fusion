fn CleanupPlanCanonicalFingerprintSchemaFieldCount(): int32 =
    return 307

fn CleanupPlanOwnershipActionFingerprintSchemaFieldCount(): int32 =
    return 42

fn CleanupPlanLimitsCanonicalFingerprintSchemaFieldCount(): int32 =
    return 34

fn cleanupCfgFingerprintLimits(seed: int64,
                               limits: CleanupPlanLimits): int64 =
    var out = seed
    var columnCount: int32
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxSourceBlockCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxLocalSlotCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxScopeCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxDeferCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxExitCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxExitDeferRefCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentOpCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentOperandCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentCallCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentCallArgCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentBlockCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentTermCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentTermOperandCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxFragmentCStringCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxStringPayloadBytes)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedOpCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedOperandCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedCallCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedCallArgCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedBlockCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedTermCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedTermOperandCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxMaterializedCStringCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipGuardProjectionCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipPlaceBindingCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipFieldBindingCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipDropGlueBindingCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipConditionFlagBindingCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipActionCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipActionFlagRefCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipFieldProjectionStepCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipFlagTransitionCount)
    cleanupCfgFingerprintI32Field(out, columnCount, limits.maxOwnershipOpTransitionSiteCount)
    if columnCount != CleanupPlanLimitsCanonicalFingerprintSchemaFieldCount():
        cleanupCfgFail("cleanup_cfg: limits fingerprint schema drift")
    return out

fn cleanupCfgFingerprintArena(seed: int64,
                              arena: phase.PhaseArena): int64 =
    var out = seed
    var columnCount: int32
    cleanupCfgFingerprintI64Field(out, columnCount, arena.capacity)
    cleanupCfgFingerprintI64Field(out, columnCount, arena.used)
    cleanupCfgFingerprintI64Field(out, columnCount, arena.peakUsed)
    cleanupCfgFingerprintI32Field(out, columnCount, arena.resetCount)
    cleanupCfgFingerprintI32Field(out, columnCount, arena.spillCount)
    if columnCount != 5:
        cleanupCfgFail("cleanup_cfg: arena fingerprint schema drift")
    return out

fn CleanupPlanOwnershipActionFingerprint(plan: var CleanupPlan): int64 =
    var out = int64(146959810)
    var columnCount: int32
    cleanupCfgFingerprintActionKindSequenceField(
        out, columnCount, plan.ownershipActionKinds)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionEdgeIds)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionOpIds)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionOrdinals)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionIds)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionCleanupDeferIds)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionTargetSlots)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionSourceSlots)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionDropGlueBindingIndices)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionRetainGlueBindingIndices)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionCapturedOldSlots)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionPlaceIds)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionFieldOrdinals)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionFieldProjectionBindingIndices)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionTypeIds)
    cleanupCfgFingerprintTextSequenceField(
        out, columnCount, plan.ownershipActionLayoutCids)
    cleanupCfgFingerprintDefinitionOriginKindSequenceField(
        out, columnCount, plan.ownershipActionDefinitionOriginKinds)
    cleanupCfgFingerprintI32SequenceField(
