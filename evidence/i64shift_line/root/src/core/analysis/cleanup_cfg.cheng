        plan.typeLayoutProviderCid, receipt)
    cleanupCfgReleaseTypeLayoutProvider(
        plan.typeLayoutProviderCid,
        receipt.typeLayoutProviderAllocationCount,
        receipt.typeLayoutProviderReleaseCount,
        receipt.typeLayoutProviderPhysicalFreeCount,
        receipt.typeLayoutProviderLiveReferenceCount)
    phase.PhaseArenaDestroy(plan.arena)
    if receipt.releasedSequenceFieldCount !=
           CleanupPlanOwnedSequenceFieldCount() ||
       receipt.releasedPhysicalBufferCount <= 0 ||
       receipt.releasedPhysicalBytes <= int64(0) ||
       plan.arena.capacity != int64(0) ||
       plan.arena.used != int64(0) ||
       plan.arena.peakUsed != int64(0) ||
       plan.arena.resetCount != 0 ||
       plan.arena.spillCount != 0 ||
       len(plan.typeLayoutProviderCid) != 0:
        cleanupCfgFail(Fmt"cleanup_cfg: physical release receipt incomplete seq={receipt.releasedSequenceFieldCount}/{CleanupPlanOwnedSequenceFieldCount()} bufs={receipt.releasedPhysicalBufferCount} bytes={receipt.releasedPhysicalBytes} arena_cap={plan.arena.capacity} arena_used={plan.arena.used} arena_peak={plan.arena.peakUsed} arena_resets={plan.arena.resetCount} arena_spills={plan.arena.spillCount} tlp_len={len(plan.typeLayoutProviderCid)}")
    var cleared: CleanupPlan
    cleared.released = true
    plan = cleared
    receipt.storageReleased = plan.released &&
                              !plan.prepared &&
                              plan.arena.capacity == int64(0)
    if !CleanupPlanReleaseReceiptClosed(receipt):
        cleanupCfgFail("cleanup_cfg: physical release did not close")

@borrows
fn cleanupCfgExitHasRuntimeUnits(
        plan: var CleanupPlan,
        exitId: int32): bool =
    if exitId < 0 || exitId >= plan.exitOriginalSourceBlockIds.len:
        return false
    return plan.exitDeferCounts[exitId] > 0 ||
           plan.exitReturnSnapshotKinds[exitId] !=
               CleanupReturnSnapshotNone ||
           (plan.exitUsesOwnershipActions[exitId] &&
            (plan.exitOwnershipActionCounts[exitId] > 0 ||
             plan.exitOwnershipFlagTransitionCounts[exitId] > 0))

@borrows
fn cleanupCfgNoOwnershipAuthorityCid(
        sourceControlCid: layout.FixedBytes32,
        domain: str,
        parentCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    cleanupCfgCidAppendText(buf, domain)
    layout.ByteBufAppendFixed32(buf, sourceControlCid)
    layout.ByteBufAppendFixed32(buf, parentCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn cleanupCfgResolveIntentOwnershipAuthority(
        plan: var CleanupPlan,
        sourceControlCid: layout.FixedBytes32,
        ownershipIrCidOut: var layout.FixedBytes32,
        ownershipAnalysisCidOut: var layout.FixedBytes32) =
    let ownershipRequired =
        plan.ownershipActionKinds.len > 0 ||
        plan.ownershipFlagTransitionOriginKinds.len > 0 ||
        plan.ownershipOpTransitionSiteStarts.len > 0
    if plan.ownershipAuthorityBound:
        if !coreir.BodyIRTypeArenaArtifactCidValid(
               plan.ownershipIrCid) ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               plan.ownershipAnalysisCid):
            cleanupCfgFail(
                "cleanup_cfg: bound ownership authority invalid")
        ownershipIrCidOut = layout.FixedBytes32Copy(
            plan.ownershipIrCid)
        ownershipAnalysisCidOut = layout.FixedBytes32Copy(
            plan.ownershipAnalysisCid)
        return
    if ownershipRequired:
        cleanupCfgFail(
            "cleanup_cfg: ownership semantics lack canonical authority")
    var zeroCid: layout.FixedBytes32
    ownershipIrCidOut = cleanupCfgNoOwnershipAuthorityCid(
        sourceControlCid,
        "cheng.cleanup_cfg.no_ownership_ir",
        zeroCid)
    ownershipAnalysisCidOut = cleanupCfgNoOwnershipAuthorityCid(
        sourceControlCid,
        "cheng.cleanup_cfg.no_ownership_analysis",
        ownershipIrCidOut)
    if !coreir.BodyIRTypeArenaArtifactCidValid(ownershipIrCidOut) ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           ownershipAnalysisCidOut) ||
       layout.FixedBytes32Equal(
           ownershipIrCidOut, ownershipAnalysisCidOut):
        cleanupCfgFail(
            "cleanup_cfg: empty ownership authority invalid")

@borrows
fn cleanupCfgSnapshotInterfaceCid(
        bodyIR: coreir.BodyIR,
        sourceSlotId: int32,
        projectionPolicy: int32): layout.FixedBytes32 =
    let typeArenaTypeId =
        bodyIR.localSlots[sourceSlotId].typeArenaTypeId
    # [wall139] c2 腿精确镜像放行：无 proof 纯标量槽（typeId=-1 ∧
    # storage=Unknown ∧ {I32,I64,F64}）由共享谓词
    # BodyIRCleanupIntentSnapshotSourceNoProofAdmitted 判定——该域是
    # decode 权威 BodyIRLocalSlotTypeArenaProofValid 明文首类合法域
    # （freeze schema 对 def-less 槽 expected_storage=0 同证），cleanup
    # intent 域滞后未镜像；与 core_types append 判据逐字同源单点谓词，
    # 禁两域拼写漂移。接口 CID 域分离：proof 域编 typeId，无 proof 域
    # 编 "plain_no_proof" 域文 + typeKind（确定性精确，互不碰撞）。
    let wall139NoProofAdmitted =
        coreir.BodyIRCleanupIntentSnapshotSourceNoProofAdmitted(
            bodyIR.localSlots[sourceSlotId])
    if !coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.typeArenaArtifactCid) ||
           (typeArenaTypeId < 0 && !wall139NoProofAdmitted) ||
           !coreir.BodyIRCleanupProjectionPolicyValid(projectionPolicy):
        # [wall139] 判词富化（wall136 失败臂增列同域先例，仅失败臂取数，
        # 守卫三联判逐字保留）：定位三联判死腿（c1=cid 域 / c2=快照源槽
        # typeId / c3=投影策略）与全槽 proof 形态（k=typeKind t=typeId
        # s=managedStorage），供「无 proof 合法形 vs 生产漏绑定」零烤机分型。
        var diagC1 = 0
        if !coreir.BodyIRTypeArenaArtifactCidValid(
                bodyIR.typeArenaArtifactCid):
            diagC1 = 1
        var diagC2 = 0
        if typeArenaTypeId < 0:
            diagC2 = 1
        var diagC3 = 0
        if !coreir.BodyIRCleanupProjectionPolicyValid(projectionPolicy):
            diagC3 = 1
        var diagSlotsText = ""
        for diagSlot in 0..<bodyIR.localSlots.len:
            if diagSlot > 0:
                diagSlotsText = Fmt"{diagSlotsText}|"
            diagSlotsText = Fmt"{diagSlotsText}{diagSlot}:k{int32(bodyIR.localSlots[diagSlot].typeKind)}t{bodyIR.localSlots[diagSlot].typeArenaTypeId}s{int32(bodyIR.localSlots[diagSlot].managedStorageKind)}"
        cleanupCfgFail(
            Fmt"cleanup_cfg: snapshot interface source invalid fn={bodyIR.controlFunctionRow} c1={diagC1} c2={diagC2} c3={diagC3} np={wall139NoProofAdmitted} cid={layout.FixedBytes32Hex(bodyIR.typeArenaArtifactCid)} typeId={typeArenaTypeId} policy={projectionPolicy} facts={bodyIR.typeFactTypeIds.len} locals={bodyIR.localSlots.len} slots=[{diagSlotsText}]")
    var buf = layout.ByteBufInit(96)
    cleanupCfgCidAppendText(
        buf, "cheng.cleanup_cfg.snapshot_interface")
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    if wall139NoProofAdmitted:
        cleanupCfgCidAppendText(buf, "plain_no_proof")
        cleanupCfgCidAppendI32(
            buf, int32(bodyIR.localSlots[sourceSlotId].typeKind))
    else:
        cleanupCfgCidAppendI32(buf, typeArenaTypeId)
    cleanupCfgCidAppendI32(buf, projectionPolicy)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn cleanupCfgBindLatestIntentUnit(
        bodyIR: var coreir.BodyIR,
        unitRow: int32) =
    let authorityCid =
        coreir.BodyIRCleanupIntentUnitAuthorityCandidateCid(
            bodyIR, unitRow)
    coreir.BodyIRCleanupIntentBindUnitAuthorityCid(
        bodyIR, unitRow, authorityCid)

fn cleanupCfgIntentConditionKind(
        negated: bool): int32 =
    if negated:
        return coreir.BodyCondLocalZeroTag
    return coreir.BodyCondLocalNonZeroTag

fn cleanupCfgAppendIntentGuardSnapshotSlots(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownerDomain: int32,
        ownerRow: int32,
        actionStart: int32,
        actionCount: int32,
        sourceSlots: var int32[],
        semanticRows: var int32[]): int32 =
    if sourceSlots.len != semanticRows.len:
        cleanupCfgFail(
            "cleanup_cfg: guard snapshot intent columns drift")
    if sourceSlots.len <= 0:
        return -1
    let unitRow = coreir.BodyIRCleanupIntentAppendUnit(
        bodyIR,
        ownerDomain,
        ownerRow,
        coreir.BodyCleanupUnitGuardSnapshotTag,
        coreir.BodyCleanupSemanticGuardSnapshotTag,
        actionStart,
        actionCount)
    for sourceRow in 0..<sourceSlots.len:
        let sourceSlot = sourceSlots[sourceRow]
        if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
            cleanupCfgFail(
                "cleanup_cfg: guard snapshot source invalid")
        let typeArenaTypeId =
            bodyIR.localSlots[sourceSlot].typeArenaTypeId
        let interfaceCid = cleanupCfgSnapshotInterfaceCid(
            bodyIR,
            sourceSlot,
            coreir.BodyCleanupProjectionSnapshotTag)
        coreir.BodyIRCleanupIntentAppendSnapshotSource(
            bodyIR,
            unitRow,
            sourceSlot,
            coreir.BodyCleanupProjectionSnapshotTag,
            semanticRows[sourceRow],
            typeArenaTypeId,
            interfaceCid)
    cleanupCfgBindLatestIntentUnit(bodyIR, unitRow)
    return unitRow

fn cleanupCfgAppendIntentGuardSnapshot(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownerDomain: int32,
        ownerRow: int32,
        actionStart: int32,
        actionCount: int32): int32 =
    var sourceSlots: int32[]
    var semanticRows: int32[]
    for actionOffset in 0..<actionCount:
        let actionRow = actionStart + actionOffset
        for atomOrdinal in 0..<3:
            var kind = plan.ownershipActionPrimaryKinds[actionRow]
            var sourceSlot =
                plan.ownershipActionPrimaryFlagSlots[actionRow]
            if atomOrdinal == 1:
                kind = plan.ownershipActionSecondaryKinds[actionRow]
                sourceSlot =
                    plan.ownershipActionSecondaryFlagSlots[actionRow]
            elif atomOrdinal == 2:
                kind = plan.ownershipActionGuardKinds[actionRow]
                sourceSlot =
                    plan.ownershipActionGuardFlagSlots[actionRow]
            if kind == odir.DropConditionAlways:
                continue
            var found = false
            for priorRow in 0..<sourceSlots.len:
                if sourceSlots[priorRow] == sourceSlot:
                    found = true
            if !found:
                add(sourceSlots, sourceSlot)
                add(semanticRows, actionRow)
    return cleanupCfgAppendIntentGuardSnapshotSlots(
        plan,
        bodyIR,
        ownerDomain,
        ownerRow,
        actionStart,
        actionCount,
        sourceSlots,
        semanticRows)

fn cleanupCfgAppendIntentReturnSnapshot(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        exitId: int32,
        intentExitRow: int32): int32 =
    if plan.exitReturnSnapshotKinds[exitId] ==
           CleanupReturnSnapshotNone:
        return -1
    let sourceSlot = plan.exitReturnSourceSlots[exitId]
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        cleanupCfgFail(
            "cleanup_cfg: return snapshot intent source invalid")
    var semanticRow = exitId
    if plan.exitUsesOwnershipActions[exitId]:
        let actionStart = plan.exitOwnershipActionStarts[exitId]
        if actionStart < 0 ||
           actionStart >= plan.ownershipActionKinds.len:
            # [wall136] 判词富化（wall133 st=103 slot 明细同域先例，仅失败
            # 臂取数，守卫零弱化）：公开失败 exit 的 action CSR 全列与 plan
            # 全 exit CSR 投影，供「声明真/填充缺」缺口定性零烤机定位。
            var diagExitsText = ""
            for diagExit in 0..<plan.exitOriginalSourceBlockIds.len:
                if diagExit > 0:
                    diagExitsText = Fmt"{diagExitsText}|"
                diagExitsText = Fmt"{diagExitsText}e{diagExit}k{int32(plan.exitKinds[diagExit])}s{int32(plan.exitReturnSnapshotKinds[diagExit])}a{plan.exitOwnershipActionStarts[diagExit]}c{plan.exitOwnershipActionCounts[diagExit]}"
            # [wall136] 二级取数：qualifying def 全列（production :1467 同
            # 判据副本）、place 绑定数、op-site 动作总量——判定「place 未
            # 注册」vs「动作落 op-site」两族死因。
            var diagQualText = ""
            var diagQualCount = 0
            for diagOp in 0..<bodyIR.ops.len:
                # manual-consume 判据内联（:294 函数为拷贝参，var 结构实参
                # 不可解析；逐字同判据，仅失败臂取数）。
                var diagManual = false
                for diagManualRow in
                        0..<bodyIR.manualConsume.sourceDefinitionRows.len:
                    if bodyIR.manualConsume.sourceDefinitionDomains[
                           diagManualRow] ==
                           coreir.BodyDefinitionDomainBodyOpTag &&
                       bodyIR.manualConsume.sourceDefinitionRows[
                           diagManualRow] == diagOp:
                        diagManual = true
                if bodyIR.ops[diagOp].valueDefOwnership ==
                       coreir.OwnMove &&
                   bodyIR.ops[diagOp].valueDefConsumeOpIndexPlusOne == 0 &&
                   !diagManual:
                    diagQualCount = diagQualCount + 1
                    if diagQualCount <= 8:
                        let diagQualSlot = bodyIR.ops[diagOp].valueDefSlot
                        var diagQualKind = -1
                        var diagQualStorage = -1
                        if diagQualSlot >= 0 &&
                           diagQualSlot < bodyIR.localSlots.len:
                            diagQualKind = int32(
                                bodyIR.localSlots[diagQualSlot].typeKind)
                            diagQualStorage = int32(
                                bodyIR.localSlots[
                                    diagQualSlot].managedStorageKind)
                        diagQualText = Fmt"{diagQualText}o{diagOp}s{diagQualSlot}k{diagQualKind}st{diagQualStorage} "
            var diagSiteActionTotal = 0
            for diagSite in 0..<plan.ownershipOpTransitionSiteStarts.len:
                let diagSiteOwnStart =
                    plan.ownershipOpTransitionSiteStarts[diagSite]
                let diagSiteOwnCount =
                    plan.ownershipOpTransitionSiteCounts[diagSite]
                for diagSiteOpRow in diagSiteOwnStart..<
                        diagSiteOwnStart + diagSiteOwnCount:
                    diagSiteActionTotal = diagSiteActionTotal +
                        plan.ownershipOpActionCounts[diagSiteOpRow]
            cleanupCfgFail(
                Fmt"cleanup_cfg: return snapshot action authority missing fn={bodyIR.controlFunctionRow} exit={exitId} start={actionStart} count={plan.exitOwnershipActionCounts[exitId]} actions={plan.ownershipActionKinds.len} snap={int32(plan.exitReturnSnapshotKinds[exitId])} src={plan.exitReturnSourceSlots[exitId]} snapSlot={plan.exitReturnSnapshotSlots[exitId]} edge={plan.exitOwnershipEdgeIds[exitId]} retEdge={plan.exitReturnOwnershipEdgeIds[exitId]} trStart={plan.exitOwnershipFlagTransitionStarts[exitId]} trCount={plan.exitOwnershipFlagTransitionCounts[exitId]} exits={plan.exitOriginalSourceBlockIds.len} csr=[{diagExitsText}] places={plan.ownershipPlaceBindingPlaceIds.len} sites={plan.ownershipOpTransitionSiteStarts.len} siteActions={diagSiteActionTotal} qual={diagQualCount} [{diagQualText}]")
        semanticRow = actionStart
    let unitRow = coreir.BodyIRCleanupIntentAppendUnit(
        bodyIR,
        coreir.BodyCleanupUnitOwnerExitTag,
        intentExitRow,
        coreir.BodyCleanupUnitReturnSnapshotTag,
        coreir.BodyCleanupSemanticReturnSnapshotTag,
        semanticRow,
        1)
    let typeArenaTypeId =
        bodyIR.localSlots[sourceSlot].typeArenaTypeId
    let interfaceCid = cleanupCfgSnapshotInterfaceCid(
        bodyIR,
        sourceSlot,
        coreir.BodyCleanupProjectionSnapshotTag)
    coreir.BodyIRCleanupIntentAppendSnapshotSource(
        bodyIR,
        unitRow,
        sourceSlot,
        coreir.BodyCleanupProjectionSnapshotTag,
        semanticRow,
        typeArenaTypeId,
        interfaceCid)
    cleanupCfgBindLatestIntentUnit(bodyIR, unitRow)
    return unitRow

fn cleanupCfgAppendIntentDeferUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        intentExitRow: int32,
        deferId: int32,
        actionRow: int32): int32 =
    let unitRow = coreir.BodyIRCleanupIntentAppendUnit(
        bodyIR,
        coreir.BodyCleanupUnitOwnerExitTag,
        intentExitRow,
        coreir.BodyCleanupUnitDeferTag,
        coreir.BodyCleanupSemanticDeferTag,
        deferId,
        1)
    var conditionSlot = plan.deferActiveFlagSlots[deferId]
    var conditionKind = coreir.BodyCondLocalNonZeroTag
    if actionRow >= 0:
        if actionRow >= plan.ownershipActionKinds.len ||
           plan.ownershipActionKinds[actionRow] !=
               odir.CleanupActionDefer:
            cleanupCfgFail(
                "cleanup_cfg: ownership defer condition invalid")
        if plan.ownershipActionPrimaryKinds[actionRow] !=
               odir.DropConditionAlways:
            conditionSlot =
                plan.ownershipActionPrimaryFlagSlots[actionRow]
            conditionKind = cleanupCfgIntentConditionKind(
                plan.ownershipActionPrimaryNegated[actionRow])
    coreir.BodyIRCleanupIntentAppendCondition(
        bodyIR,
        unitRow,
        conditionKind,
        conditionSlot,
        deferId,
        0)
    if actionRow < 0:
        coreir.BodyIRCleanupIntentAppendClear(
            bodyIR,
            unitRow,
            coreir.BodyCleanupClearLocalZeroTag,
            plan.deferActiveFlagSlots[deferId],
            deferId,
            0)
    cleanupCfgBindLatestIntentUnit(bodyIR, unitRow)
    return unitRow

fn cleanupCfgAppendIntentOwnershipActionUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownerDomain: int32,
        ownerRow: int32,
        actionRow: int32): int32 =
    let unitRow = coreir.BodyIRCleanupIntentAppendUnit(
        bodyIR,
        ownerDomain,
        ownerRow,
        coreir.BodyCleanupUnitOwnershipActionTag,
        coreir.BodyCleanupSemanticOwnershipActionTag,
        actionRow,
        1)
    for atomOrdinal in 0..<3:
        var kind = plan.ownershipActionPrimaryKinds[actionRow]
        var sourceSlot =
            plan.ownershipActionPrimaryFlagSlots[actionRow]
        var negated =
            plan.ownershipActionPrimaryNegated[actionRow]
        if atomOrdinal == 1:
            kind = plan.ownershipActionSecondaryKinds[actionRow]
            sourceSlot =
                plan.ownershipActionSecondaryFlagSlots[actionRow]
            negated =
                plan.ownershipActionSecondaryNegated[actionRow]
        elif atomOrdinal == 2:
            kind = plan.ownershipActionGuardKinds[actionRow]
            sourceSlot =
                plan.ownershipActionGuardFlagSlots[actionRow]
            negated = plan.ownershipActionGuardNegated[actionRow]
        if kind != odir.DropConditionAlways:
            coreir.BodyIRCleanupIntentAppendCondition(
                bodyIR,
                unitRow,
                cleanupCfgIntentConditionKind(negated),
                sourceSlot,
                actionRow,
                atomOrdinal)
    let clearStart =
        plan.ownershipActionClearFlagStarts[actionRow]
    let clearCount =
        plan.ownershipActionClearFlagCounts[actionRow]
    for clearOffset in 0..<clearCount:
        coreir.BodyIRCleanupIntentAppendClear(
            bodyIR,
            unitRow,
            coreir.BodyCleanupClearLocalZeroTag,
            plan.ownershipActionClearFlagSlots[
                clearStart + clearOffset],
            actionRow,
            clearOffset)
    cleanupCfgBindLatestIntentUnit(bodyIR, unitRow)
    return unitRow

fn cleanupCfgAppendIntentTransitionUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownerDomain: int32,
        ownerRow: int32,
        transitionStart: int32,
        transitionCount: int32): int32 =
    if transitionCount <= 0:
        return -1
    let unitRow = coreir.BodyIRCleanupIntentAppendUnit(
        bodyIR,
        ownerDomain,
        ownerRow,
        coreir.BodyCleanupUnitTransitionTag,
        coreir.BodyCleanupSemanticOwnershipTransitionTag,
        transitionStart,
        transitionCount)
    for offset in 0..<transitionCount:
        let transitionRow = transitionStart + offset
        if !plan.ownershipFlagTransitionSetValues[transitionRow]:
            coreir.BodyIRCleanupIntentAppendClear(
                bodyIR,
                unitRow,
                coreir.BodyCleanupClearLocalZeroTag,
                plan.ownershipFlagTransitionFlagSlots[transitionRow],
                transitionRow,
                offset)
    cleanupCfgBindLatestIntentUnit(bodyIR, unitRow)
    return unitRow

fn cleanupCfgAppendIntentExitUnits(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        exitId: int32,
        intentExitRow: int32) =
    let _ = cleanupCfgAppendIntentReturnSnapshot(
        plan, bodyIR, exitId, intentExitRow)
    if plan.exitUsesOwnershipActions[exitId]:
        let actionStart = plan.exitOwnershipActionStarts[exitId]
        let actionCount = plan.exitOwnershipActionCounts[exitId]
        let _ = cleanupCfgAppendIntentGuardSnapshot(
            plan,
            bodyIR,
            coreir.BodyCleanupUnitOwnerExitTag,
            intentExitRow,
            actionStart,
            actionCount)
        for offset in 0..<actionCount:
            let actionRow = actionStart + offset
            let kind = plan.ownershipActionKinds[actionRow]
            if kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
               kind == odir.CleanupActionSnapshotCloneOwnedReturn ||
               kind == odir.CleanupActionReturnUnmanaged:
                continue
            if kind == odir.CleanupActionDefer:
                let _ = cleanupCfgAppendIntentDeferUnit(
                    plan,
                    bodyIR,
                    intentExitRow,
                    plan.ownershipActionCleanupDeferIds[actionRow],
                    actionRow)
            else:
                let _ = cleanupCfgAppendIntentOwnershipActionUnit(
                    plan,
                    bodyIR,
                    coreir.BodyCleanupUnitOwnerExitTag,
                    intentExitRow,
                    actionRow)
        let _ = cleanupCfgAppendIntentTransitionUnit(
            plan,
            bodyIR,
            coreir.BodyCleanupUnitOwnerExitTag,
            intentExitRow,
            plan.exitOwnershipFlagTransitionStarts[exitId],
            plan.exitOwnershipFlagTransitionCounts[exitId])
    else:
        let deferStart = plan.exitDeferStarts[exitId]
        for offset in 0..<plan.exitDeferCounts[exitId]:
            let _ = cleanupCfgAppendIntentDeferUnit(
                plan,
                bodyIR,
                intentExitRow,
                plan.exitDeferIds[deferStart + offset],
                -1)

fn cleanupCfgAppendIntentOpSiteUnits(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        siteIndex: int32,
        intentSiteRow: int32) =
    let opRowStart =
        plan.ownershipOpTransitionSiteStarts[siteIndex]
    let opRowCount =
        plan.ownershipOpTransitionSiteCounts[siteIndex]
    var actionStart: int32 = -1
    var actionCount: int32
    var transitionStart: int32 = -1
    var transitionCount: int32
    for opOffset in 0..<opRowCount:
        let opRow = opRowStart + opOffset
        let currentActionStart =
            plan.ownershipOpActionStarts[opRow]
        let currentActionCount =
            plan.ownershipOpActionCounts[opRow]
        if currentActionCount > 0:
            if actionStart < 0:
                actionStart = currentActionStart
            elif currentActionStart != actionStart + actionCount:
                cleanupCfgFail(
                    "cleanup_cfg: intent op-site action range drift")
            actionCount = actionCount + currentActionCount
        let currentTransitionStart =
            plan.ownershipOpTransitionStarts[opRow]
        let currentTransitionCount =
            plan.ownershipOpTransitionCounts[opRow]
        if currentTransitionCount > 0:
            if transitionStart < 0:
                transitionStart = currentTransitionStart
            elif currentTransitionStart !=
                   transitionStart + transitionCount:
                cleanupCfgFail(
                    "cleanup_cfg: intent op-site transition range drift")
            transitionCount = transitionCount +
                currentTransitionCount
    let snapshotStart =
        plan.ownershipOpSiteSnapshotStarts[siteIndex]
    let snapshotCount =
        plan.ownershipOpSiteSnapshotCounts[siteIndex]
    if snapshotStart < 0 || snapshotCount < 0 ||
       snapshotStart + snapshotCount >
           plan.ownershipOpSiteSnapshotSourceSlots.len:
        cleanupCfgFail(
            "cleanup_cfg: intent op-site snapshot CSR invalid")
    if snapshotCount > 0:
        var snapshotSourceSlots: int32[]
        var snapshotSemanticRows: int32[]
        for snapshotOffset in 0..<snapshotCount:
            add(snapshotSourceSlots,
                plan.ownershipOpSiteSnapshotSourceSlots[
                    snapshotStart + snapshotOffset])
            add(snapshotSemanticRows,
                plan.ownershipOpSiteSnapshotSemanticRows[
                    snapshotStart + snapshotOffset])
        let _ = cleanupCfgAppendIntentGuardSnapshotSlots(
            plan,
            bodyIR,
            coreir.BodyCleanupUnitOwnerOpSiteTag,
            intentSiteRow,
            actionStart,
            actionCount,
            snapshotSourceSlots,
            snapshotSemanticRows)
    for actionOffset in 0..<actionCount:
        let actionRow = actionStart + actionOffset
        let _ = cleanupCfgAppendIntentOwnershipActionUnit(
            plan,
            bodyIR,
            coreir.BodyCleanupUnitOwnerOpSiteTag,
            intentSiteRow,
            actionRow)
    if transitionCount > 0:
        let _ = cleanupCfgAppendIntentTransitionUnit(
            plan,
            bodyIR,
            coreir.BodyCleanupUnitOwnerOpSiteTag,
            intentSiteRow,
            transitionStart,
            transitionCount)

fn cleanupCfgBuildAndSealIntent(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scheduleDraft: var cleanupScheduleDraft) =
    let sourceControlCid =
        coreir.BodyIRCleanupSourceControlCid(bodyIR)
    if !coreir.BodyIRTypeArenaArtifactCidValid(sourceControlCid):
        # wall57 判词富化：逐项公开前置谓词诊断（守卫零弱化，仅失败臂取数）。
        # sealed/cf/pd/ed/lb/mc/mr/ef/proj = BodyIRCleanupSourceControlCid
        # 零值返回的九个前置条件；proj=cleanupSourceProjectionCid 非零审。
        let diagSealed = if bodyIR.controlFlowSealed: 1 else: 0
        let diagControlFlow =
            if coreir.BodyIRControlFlowShapeValid(bodyIR): 1 else: 0
        let diagProofDomain =
            if coreir.BodyIRTypeArenaProofDomainValid(bodyIR): 1 else: 0
        let diagEntryOwnership =
            if coreir.BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
                1
            else:
                0
        let diagLocalBinding =
            if coreir.BodyIRLocalBindingValueDefinitionRowsShapeValid(
                   bodyIR):
                1
            else:
                0
        let diagManualConsume =
            if coreir.BodyIRManualConsumeSidecarShapeValid(bodyIR):
                1
            else:
                0
        let diagManagedReplace =
            if coreir.BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR):
                1
            else:
                0
        let diagExternFfi =
            if coreir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(
                   bodyIR):
                1
            else:
                0
        let diagProjection =
            if coreir.BodyIRTypeArenaArtifactCidValid(
                   bodyIR.cleanupSourceProjectionCid):
                1
            else:
                0
        # wall62 判词富化：投影后审计层失败分支定位（core_types 只读复刻，
        # 仅失败臂取数）。st=失败分支（101..105=referenced facts 细分，
        # 20/30/40/50/60=slot/block/term/cstring/defer），off=首违行号。
        var diagAuditOffender: int32
        let diagAuditStage =
            coreir.BodyIRCleanupSourceControlFailureStage(
                bodyIR, diagAuditOffender)
        # [wall133] st=103 slot 明细富化（wall57/62 判词富化同域先例，仅失败
        # 臂取数，守卫零弱化）：公开 offender slot 的精确类型身份与在册
        # typeFact 全列，供 typeFact 闭合缺口定性零烤机定位。
        var diagSlotText = "-"
        if diagAuditStage == 103 && diagAuditOffender >= 0 &&
           diagAuditOffender < bodyIR.localSlots.len:
            let diagSlot = bodyIR.localSlots[diagAuditOffender]
            diagSlotText = Fmt"id={diagSlot.id} typeId={diagSlot.typeArenaTypeId} kind={diagSlot.typeKind} storage={diagSlot.managedStorageKind} size={diagSlot.sizeBytes} align={diagSlot.alignBytes}"
        var diagFactIdsText = ""
        for factRow in 0..<bodyIR.typeFactTypeIds.len:
            if factRow > 0:
                diagFactIdsText = Fmt"{diagFactIdsText},"
            diagFactIdsText = Fmt"{diagFactIdsText}{bodyIR.typeFactTypeIds[factRow]}"
        cleanupCfgFail(
            Fmt"cleanup_cfg: cleanup source control cid invalid sealed={diagSealed} cf={diagControlFlow} pd={diagProofDomain} ed={diagEntryOwnership} lb={diagLocalBinding} mc={diagManualConsume} mr={diagManagedReplace} ef={diagExternFfi} proj={diagProjection} st={diagAuditStage} off={diagAuditOffender} slots={bodyIR.localSlots.len} facts={bodyIR.typeFactTypeIds.len} fn={bodyIR.controlFunctionRow} slot=[{diagSlotText}] factIds=[{diagFactIdsText}]")
    var ownershipIrCid: layout.FixedBytes32
    var ownershipAnalysisCid: layout.FixedBytes32
    cleanupCfgResolveIntentOwnershipAuthority(
        plan,
        sourceControlCid,
        ownershipIrCid,
        ownershipAnalysisCid)
    var activeExitCount: int32
    for exitId in 0..<plan.exitOriginalSourceBlockIds.len:
        if cleanupCfgExitHasRuntimeUnits(plan, exitId):
            activeExitCount = activeExitCount + 1
    if activeExitCount == 0 &&
       plan.ownershipOpTransitionSiteStarts.len == 0:
        return
    coreir.BodyIRCleanupIntentBegin(
        bodyIR,
        sourceControlCid,
        ownershipIrCid,
        ownershipAnalysisCid)
    for sourceEdgeKey in 0..<plan.exitIdBySourceEdge.len:
        let exitId = plan.exitIdBySourceEdge[sourceEdgeKey]
        if exitId < 0 ||
           !cleanupCfgExitHasRuntimeUnits(plan, exitId):
            continue
        let intentExitRow = coreir.BodyIRCleanupIntentAppendExit(
            bodyIR,
            plan.exitOriginalSourceBlockIds[exitId],
            plan.exitSuccessorOrdinals[exitId],
            plan.exitOwnershipEdgeIds[exitId])
        add(scheduleDraft.exitPlanIds, exitId)
        let selectedStart =
            bodyIR.cleanupIntent.selectedDeferStarts[intentExitRow]
        let selectedCount =
            bodyIR.cleanupIntent.selectedDeferCounts[intentExitRow]
        let plannedStart = plan.exitDeferStarts[exitId]
        let plannedCount = plan.exitDeferCounts[exitId]
        if selectedCount != plannedCount:
            cleanupCfgFail(
                "cleanup_cfg: intent defer selection count drift")
        for offset in 0..<selectedCount:
            if bodyIR.cleanupIntent.selectedDeferIds[
                   selectedStart + offset] !=
               plan.exitDeferIds[plannedStart + offset]:
                cleanupCfgFail(
                    "cleanup_cfg: intent defer selection identity drift")
        cleanupCfgAppendIntentExitUnits(
            plan, bodyIR, exitId, intentExitRow)
    for siteIndex in 0..<plan.ownershipOpTransitionSiteStarts.len:
        let ownershipStart =
            plan.ownershipOpTransitionSiteStarts[siteIndex]
        let ownershipCount =
            plan.ownershipOpTransitionSiteCounts[siteIndex]
        var ownershipOpRows: int32[]
        for offset in 0..<ownershipCount:
            add(ownershipOpRows,
                plan.ownershipOpTransitionOwnershipOpIds[
                    ownershipStart + offset])
        let intentSiteRow = coreir.BodyIRCleanupIntentAppendOpSite(
            bodyIR,
            plan.ownershipOpTransitionBodyBlockIds[siteIndex],
            plan.ownershipOpTransitionAfterOpOrdinals[siteIndex],
            ownershipOpRows)
        cleanupCfgAppendIntentOpSiteUnits(
            plan, bodyIR, siteIndex, intentSiteRow)
    let rootCid = coreir.BodyIRCleanupIntentCandidateRootCid(bodyIR)
    coreir.BodyIRCleanupIntentBindRootCid(bodyIR, rootCid)
    coreir.BodyIRCleanupIntentSeal(bodyIR, rootCid)

@borrows
fn cleanupCfgScheduleDraftShapeValid(
        bodyIR: coreir.BodyIR,
        draft: cleanupScheduleDraft): bool =
    let unitCount = draft.unitOpStarts.len
    let exitCount = draft.exitPlanIds.len
    let siteCount =
        bodyIR.cleanupIntent.siteOriginalBlockIds.len
    return unitCount == bodyIR.cleanupIntent.unitKinds.len &&
           draft.unitLocalStarts.len == unitCount &&
           draft.unitLocalCounts.len == unitCount &&
           draft.unitOpCounts.len == unitCount &&
           draft.unitCallStarts.len == unitCount &&
           draft.unitCallCounts.len == unitCount &&
           draft.unitBlockStarts.len == unitCount &&
           draft.unitBlockCounts.len == unitCount &&
           draft.unitTermStarts.len == unitCount &&
           draft.unitTermCounts.len == unitCount &&
           draft.unitProjectedStarts.len == unitCount &&
           draft.unitProjectedCounts.len == unitCount &&
           exitCount == bodyIR.cleanupIntent.sourceBlockIds.len &&
           draft.exitPhysicalSourceBlockIds.len == exitCount &&
           draft.exitSourceTermRows.len == exitCount &&
           draft.exitSourceSuccessorOrdinals.len == exitCount &&
           draft.exitFinalContinuationBlockIds.len == exitCount &&
           draft.exitFinalEdgeKinds.len == exitCount &&
           draft.sitePhysicalSourceBlockIds.len == siteCount &&
           draft.siteSourceTermRows.len == siteCount &&
           draft.siteSourceSuccessorOrdinals.len == siteCount &&
           draft.siteFinalContinuationBlockIds.len == siteCount &&
           draft.siteFinalEdgeKinds.len == siteCount

fn cleanupCfgBuildAndSealSchedule(
        bodyIR: var coreir.BodyIR,
        draft: var cleanupScheduleDraft) =
    if coreir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
           bodyIR.cleanupIntent):
        if draft.unitOpStarts.len != 0 ||
           draft.exitPlanIds.len != 0 ||
           draft.sitePhysicalSourceBlockIds.len != 0:
            cleanupCfgFail(
                "cleanup_cfg: empty intent carries physical schedule")
        return
    if !cleanupCfgScheduleDraftShapeValid(bodyIR, draft):
        cleanupCfgFail(
            "cleanup_cfg: cleanup schedule draft shape invalid")
    coreir.BodyIRCleanupScheduleBegin(bodyIR)
    for exitRow in 0..<draft.exitPlanIds.len:
        let ownerIndex = coreir.BodyIRCleanupScheduleAppendOwner(
            bodyIR,
            draft.exitPhysicalSourceBlockIds[exitRow],
            draft.exitSourceTermRows[exitRow],
            draft.exitSourceSuccessorOrdinals[exitRow],
            draft.exitFinalContinuationBlockIds[exitRow],
            draft.exitFinalEdgeKinds[exitRow])
        if ownerIndex != exitRow:
            cleanupCfgFail(
                "cleanup_cfg: exit schedule owner order drift")
    for siteRow in 0..<draft.sitePhysicalSourceBlockIds.len:
        let ownerIndex = coreir.BodyIRCleanupScheduleAppendOwner(
            bodyIR,
            draft.sitePhysicalSourceBlockIds[siteRow],
            draft.siteSourceTermRows[siteRow],
            draft.siteSourceSuccessorOrdinals[siteRow],
            draft.siteFinalContinuationBlockIds[siteRow],
            draft.siteFinalEdgeKinds[siteRow])
        if ownerIndex != draft.exitPlanIds.len + siteRow:
            cleanupCfgFail(
                "cleanup_cfg: op-site schedule owner order drift")
    var projectedCursor: int32
    for unitRow in 0..<draft.unitOpStarts.len:
        if draft.unitProjectedStarts[unitRow] != projectedCursor ||
           draft.unitProjectedCounts[unitRow] < 0 ||
           draft.unitProjectedCounts[unitRow] >
               draft.projectedSnapshotSlotIds.len - projectedCursor:
            cleanupCfgFail(
                "cleanup_cfg: schedule projection CSR invalid")
        var projectedSlots: int32[]
        for offset in 0..<draft.unitProjectedCounts[unitRow]:
            add(projectedSlots,
                draft.projectedSnapshotSlotIds[
                    projectedCursor + offset])
        let appendedUnit = coreir.BodyIRCleanupScheduleAppendUnit(
            bodyIR,
            draft.unitLocalStarts[unitRow],
            draft.unitLocalCounts[unitRow],
            draft.unitOpStarts[unitRow],
            draft.unitOpCounts[unitRow],
            draft.unitCallStarts[unitRow],
            draft.unitCallCounts[unitRow],
            draft.unitBlockStarts[unitRow],
            draft.unitBlockCounts[unitRow],
            draft.unitTermStarts[unitRow],
            draft.unitTermCounts[unitRow],
            projectedSlots)
        if appendedUnit != unitRow:
            cleanupCfgFail(
                "cleanup_cfg: schedule unit order drift")
        projectedCursor = projectedCursor +
            draft.unitProjectedCounts[unitRow]
    if projectedCursor != draft.projectedSnapshotSlotIds.len:
        cleanupCfgFail(
            "cleanup_cfg: schedule projection CSR truncated")
    for unitRow in 0..<draft.unitOpStarts.len:
        coreir.BodyIRCleanupScheduleAppendExpectedEffectsForUnit(
            bodyIR, unitRow)
    for unitRow in 0..<draft.unitOpStarts.len:
        let payloadCid =
            coreir.BodyIRCleanupScheduleUnitPayloadCandidateCid(
                bodyIR, unitRow)
        let placementCid =
            coreir.BodyIRCleanupScheduleUnitPlacementCandidateCid(
                bodyIR, unitRow)
        coreir.BodyIRCleanupScheduleBindUnitCids(
            bodyIR, unitRow, payloadCid, placementCid)
    let rootCid =
        coreir.BodyIRCleanupScheduleCandidateRootCid(bodyIR)
    coreir.BodyIRCleanupScheduleBindRootCid(bodyIR, rootCid)
    coreir.BodyIRCleanupScheduleSeal(bodyIR, rootCid)

fn cleanupCfgBuildAndSealReplay(bodyIR: var coreir.BodyIR) =
    var deferUnitCount: int32
    for unitRow in 0..<bodyIR.cleanupIntent.unitKinds.len:
        if bodyIR.cleanupIntent.unitKinds[unitRow] ==
               coreir.BodyCleanupUnitDeferTag:
            deferUnitCount = deferUnitCount + 1
    if deferUnitCount <= 0:
        if !coreir.BodyIRDeferReplaySidecarShapeValid(bodyIR):
            cleanupCfgFail(
                "cleanup_cfg: canonical empty replay invalid")
        return
    coreir.BodyIRDeferReplayBegin(bodyIR)
    for unitRow in 0..<bodyIR.cleanupIntent.unitKinds.len:
        if bodyIR.cleanupIntent.unitKinds[unitRow] ==
               coreir.BodyCleanupUnitDeferTag:
            let _ = coreir.BodyIRDeferReplayAppendMap(
                bodyIR, unitRow)
    let rootCid =
        coreir.BodyIRDeferReplayCandidateRootCid(bodyIR)
    coreir.BodyIRDeferReplayBindRootCid(bodyIR, rootCid)
    coreir.BodyIRDeferReplaySeal(bodyIR, rootCid)

# [wall129] draft 块号列 remap：canonical 块数组序重建后，scheduleDraft
# 持有的物理块号列（unit 范围与 exit/op-site owner 锚）逐列平移到新数
# 组序。schedule 全列与 CID 由 BuildAndSealSchedule 在本函数之后生成，
# 天然出生于 canonical 布局；越界旧 id 一律 fail-closed。
fn cleanupCfgRemapBlockIdForCanonicalOrder(
        oldBlockId: int32,
        newIndexOfOld: var int32[],
        blockCount: int32): int32 =
    if oldBlockId < 0 || oldBlockId >= blockCount:
        cleanupCfgFail(
            Fmt"cleanup_cfg: canonical block order remap out of range block={oldBlockId} blocks={blockCount}")
    return newIndexOfOld[oldBlockId]

fn cleanupCfgRemapScheduleDraftBlocksForCanonicalOrder(
        scheduleDraft: var cleanupScheduleDraft,
        newIndexOfOld: var int32[],
        blockCount: int32) =
    for rowIndex in 0..<scheduleDraft.unitBlockStarts.len:
        let oldBlockId = scheduleDraft.unitBlockStarts[rowIndex]
        scheduleDraft.unitBlockStarts[rowIndex] =
            cleanupCfgRemapBlockIdForCanonicalOrder(
                oldBlockId, newIndexOfOld, blockCount)
    for rowIndex in 0..<scheduleDraft.exitPhysicalSourceBlockIds.len:
        let oldBlockId =
            scheduleDraft.exitPhysicalSourceBlockIds[rowIndex]
        scheduleDraft.exitPhysicalSourceBlockIds[rowIndex] =
            cleanupCfgRemapBlockIdForCanonicalOrder(
                oldBlockId, newIndexOfOld, blockCount)
    for rowIndex in 0..<scheduleDraft.exitFinalContinuationBlockIds.len:
        let oldBlockId =
            scheduleDraft.exitFinalContinuationBlockIds[rowIndex]
        scheduleDraft.exitFinalContinuationBlockIds[rowIndex] =
            cleanupCfgRemapBlockIdForCanonicalOrder(
                oldBlockId, newIndexOfOld, blockCount)
    for rowIndex in 0..<scheduleDraft.sitePhysicalSourceBlockIds.len:
        let oldBlockId =
            scheduleDraft.sitePhysicalSourceBlockIds[rowIndex]
        scheduleDraft.sitePhysicalSourceBlockIds[rowIndex] =
            cleanupCfgRemapBlockIdForCanonicalOrder(
                oldBlockId, newIndexOfOld, blockCount)
    for rowIndex in 0..<scheduleDraft.siteFinalContinuationBlockIds.len:
        let oldBlockId =
            scheduleDraft.siteFinalContinuationBlockIds[rowIndex]
        scheduleDraft.siteFinalContinuationBlockIds[rowIndex] =
            cleanupCfgRemapBlockIdForCanonicalOrder(
                oldBlockId, newIndexOfOld, blockCount)

# [wall129] canonical CFG 块数组序维护（w126b 移交定性闭环）。分群体
# shape（if/else 后继块在场）下，物化的 continuation/unit 块只追加不重
# 排，blocks 数组序≠op 流分区序（cold_nested 实证 b1.opStart=8≠期望 3），
# 下游 BodyIrCfgAnalyze 以 BodyIrCfgErrorBlockRange(=4) fail-closed。
# 修法：物化全部物理追加完成后、schedule 封印（BuildAndSealSchedule）
# 之前，按 (opStart, 旧数组序) 稳定排序重建 blocks 数组——数组序=op 分
# 区序，opStart/opCount/term 行零改动——并全量 remap 全部块号耦合列：
# terms true/falseBlock 与 successorBlockIds CSR（经 exact term replace
# 通道逐 term 重绑）、blockScopeIds（同序平移）、deferActivationSite
# BlockIds、scheduleDraft 块号列。cleanupIntent/plan 的 original 坐标
# 系列钉在 sourceControlCid/originalBlockCount 冻结的物化前布局上，禁
# 止平移；immutable control identity 只含 scope/defer 键，块号零参与，
# 本函数天然保恒。收尾按 BodyIrCfg BlockRange 门同判据自证（id==index、
# 无缝全覆盖分区、term 唯一属主、successor 界内），违例 fail-closed。
fn cleanupCfgCanonicalizeBlockOpArrayOrder(
        bodyIR: var coreir.BodyIR,
        scheduleDraft: var cleanupScheduleDraft) =
    let blockCount = bodyIR.blocks.len
    var order: int32[]
    for blockIndex in 0..<blockCount:
        add(order, blockIndex)
    for position in 1..<blockCount:
        var cursor = position
        while cursor > 0:
            let previousIndex = order[cursor - 1]
            let currentIndex = order[cursor]
            let previousStart = bodyIR.blocks[previousIndex].opStart
            let currentStart = bodyIR.blocks[currentIndex].opStart
            if previousStart <= currentStart:
                break
            order[cursor] = previousIndex
            order[cursor - 1] = currentIndex
            cursor = cursor - 1
    var permuted: bool
    for position in 0..<blockCount:
        if order[position] != position:
            permuted = true
    var newIndexOfOld: int32[]
    if permuted:
        for oldIndex in 0..<blockCount:
            add(newIndexOfOld, -1)
        for position in 0..<blockCount:
            newIndexOfOld[order[position]] = position
        var canonicalBlocks: coreir.BodyBlock[]
        for position in 0..<blockCount:
            let source = bodyIR.blocks[order[position]]
            var block: coreir.BodyBlock
            block.id = position
            block.opStart = source.opStart
            block.opCount = source.opCount
            block.termIndex = source.termIndex
            add(canonicalBlocks, block)
        bodyIR.blocks = canonicalBlocks
        var canonicalScopes: int32[]
        for position in 0..<blockCount:
            add(canonicalScopes,
                bodyIR.blockScopeIds[order[position]])
        bodyIR.blockScopeIds = canonicalScopes
        for termIndex in 0..<bodyIR.terms.len:
            let successorStart = bodyIR.termSuccessorStarts[termIndex]
            let successorCount = bodyIR.termSuccessorCounts[termIndex]
            if successorStart < 0 || successorCount < 0 ||
               successorCount > 2 ||
               successorStart + successorCount >
                   bodyIR.successorBlockIds.len:
                cleanupCfgFail(
                    Fmt"cleanup_cfg: canonical block order term CSR invalid term={termIndex} start={successorStart} count={successorCount}")
            var term = cleanupCfgReadBodyTermValue(bodyIR, termIndex)
            if term.trueBlock >= 0:
                term.trueBlock =
                    cleanupCfgRemapBlockIdForCanonicalOrder(
                        term.trueBlock, newIndexOfOld, blockCount)
            if term.falseBlock >= 0:
                term.falseBlock =
                    cleanupCfgRemapBlockIdForCanonicalOrder(
                        term.falseBlock, newIndexOfOld, blockCount)
            var successor0 = -1
            var edgeKind0 = coreir.BodyControlEdgeUnknown
            var successor1 = -1
            var edgeKind1 = coreir.BodyControlEdgeUnknown
            if successorCount >= 1:
                let oldSuccessor0 =
                    bodyIR.successorBlockIds[successorStart]
                successor0 =
                    cleanupCfgRemapBlockIdForCanonicalOrder(
                        oldSuccessor0, newIndexOfOld, blockCount)
                edgeKind0 = bodyIR.successorEdgeKinds[successorStart]
            if successorCount == 2:
                let oldSuccessor1 =
                    bodyIR.successorBlockIds[successorStart + 1]
                successor1 =
                    cleanupCfgRemapBlockIdForCanonicalOrder(
                        oldSuccessor1, newIndexOfOld, blockCount)
                edgeKind1 = bodyIR.successorEdgeKinds[
                    successorStart + 1]
            cleanupCfgReplaceTermExact(
                bodyIR,
                termIndex,
                term,
                successorCount,
                successor0,
                edgeKind0,
                successor1,
                edgeKind1)
        for siteIndex in 0..<bodyIR.deferActivationSiteBlockIds.len:
            let oldSiteBlockId =
                bodyIR.deferActivationSiteBlockIds[siteIndex]
            bodyIR.deferActivationSiteBlockIds[siteIndex] =
                cleanupCfgRemapBlockIdForCanonicalOrder(
                    oldSiteBlockId, newIndexOfOld, blockCount)
        cleanupCfgRemapScheduleDraftBlocksForCanonicalOrder(
            scheduleDraft, newIndexOfOld, blockCount)
        coreir.BodyIRClearFrameLayoutCache(bodyIR)
    var expectedOpStart: int32
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.id != blockIndex:
            cleanupCfgFail(
                Fmt"cleanup_cfg: canonical block order id drift block={blockIndex} id={block.id} blocks={bodyIR.blocks.len}")
        if block.opStart != expectedOpStart || block.opCount < 0 ||
           block.opStart + block.opCount > bodyIR.ops.len:
            cleanupCfgFail(
                Fmt"cleanup_cfg: canonical block order partition drift block={blockIndex} opStart={block.opStart} expected={expectedOpStart} opCount={block.opCount} ops={bodyIR.ops.len} blocks={bodyIR.blocks.len}")
        expectedOpStart = expectedOpStart + block.opCount
    if expectedOpStart != bodyIR.ops.len:
        cleanupCfgFail(
            Fmt"cleanup_cfg: canonical block order partition truncated end={expectedOpStart} ops={bodyIR.ops.len} blocks={bodyIR.blocks.len}")
    var termOwnerBlocks: int32[]
    for termIndex in 0..<bodyIR.terms.len:
        add(termOwnerBlocks, -1)
    for blockIndex in 0..<bodyIR.blocks.len:
        let termIndex = bodyIR.blocks[blockIndex].termIndex
        if termIndex < 0 || termIndex >= bodyIR.terms.len ||
           termOwnerBlocks[termIndex] >= 0:
            cleanupCfgFail(
                Fmt"cleanup_cfg: canonical block order term owner drift block={blockIndex} term={termIndex} owner={termOwnerBlocks[termIndex]} terms={bodyIR.terms.len}")
        termOwnerBlocks[termIndex] = blockIndex
    for termIndex in 0..<bodyIR.terms.len:
        if termOwnerBlocks[termIndex] < 0:
            cleanupCfgFail(
                Fmt"cleanup_cfg: canonical block order term unowned term={termIndex} terms={bodyIR.terms.len}")
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        if successorStart < 0 || successorCount < 0 ||
           successorStart + successorCount >
               bodyIR.successorBlockIds.len:
            cleanupCfgFail(
                Fmt"cleanup_cfg: canonical block order successor CSR drift term={termIndex} start={successorStart} count={successorCount} rows={bodyIR.successorBlockIds.len}")
        for ordinal in 0..<successorCount:
            let target = bodyIR.successorBlockIds[
                successorStart + ordinal]
            if target < 0 || target >= bodyIR.blocks.len:
                cleanupCfgFail(
                    Fmt"cleanup_cfg: canonical block order successor target drift term={termIndex} target={target} blocks={bodyIR.blocks.len}")

fn cleanupCfgStageMaterialize(bodyIR: var coreir.BodyIR,
                              plan: var CleanupPlan): CleanupMaterializeReport =
    cleanupCfgValidateBody(plan, bodyIR)
    let originalSourceIdentityFingerprintBefore =
        cleanupCfgOriginalSourceIdentityFingerprint(plan)
    let controlFunctionRowBefore = bodyIR.controlFunctionRow
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR):
        cleanupCfgFail("cleanup_cfg: source debug provenance shape invalid")
    if !coreir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR):
        cleanupCfgFail(
            "cleanup_cfg: source ffi capability sidecar shape invalid")
    if !coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
           bodyIR.deferReplay) ||
       coreir.BodyIRDeferReplaySidecarHasPhysicalStorage(
           bodyIR.deferReplay):
        cleanupCfgFail(
            "cleanup_cfg: source defer replay authority must be empty")
    let immutableControlIdentityBefore =
        cleanupCfgImmutableControlIdentityCid(bodyIR)
    if bodyIR.debugProvenanceRequired &&
       !coreir.BodyIRDebugProvenanceSetSynthetic(
           bodyIR,
           coreir.BodyDebugSyntheticCleanup):
        cleanupCfgFail("cleanup_cfg: cleanup debug provenance unavailable")
    var report: CleanupMaterializeReport
    report.ownershipActionFingerprintBefore =
        CleanupPlanOwnershipActionFingerprint(plan)
    report.scopeCount = plan.scopeParentIds.len
    report.deferCount = plan.deferDeclarationScopeIds.len
    report.exitCount = plan.exitOriginalSourceBlockIds.len
    report.exitDeferRefCount = plan.exitDeferIds.len
    report.fragmentCount = plan.fragmentOpStarts.len
    report.lcaParentStepCount = plan.lcaParentStepCount
    report.exitedScopeVisitCount = plan.exitedScopeVisitCount
    report.selectedDeferVisitCount = plan.selectedDeferVisitCount
    report.ownershipGuardProjectionCount =
        plan.ownershipGuardCleanupDeferIds.len
    report.ownershipFieldProjectionCount =
        plan.ownershipFieldBindingProjectionSlots.len
    report.ownershipFlagTransitionCount =
        plan.ownershipFlagTransitionOriginKinds.len
    report.ownershipOpTransitionSiteCount =
        plan.ownershipOpTransitionSiteStarts.len
    for deferId in 0..<plan.deferOwnershipDeferIds.len:
        if plan.deferOwnershipDeferIds[deferId] >= 0 &&
           plan.deferOwnershipGuardProjectionCounts[deferId] > 0:
            report.ownershipGuardedDeferUnitCount = cleanupCfgCheckedReportAdd(
                report.ownershipGuardedDeferUnitCount,
                plan.deferSelectedExitCounts[deferId])
    report.plannedMaterializedLocalCount =
        plan.plannedMaterializedLocalCount
    report.plannedMaterializedOpCount = plan.plannedMaterializedOpCount
    report.plannedMaterializedOperandCount = plan.plannedMaterializedOperandCount
    report.plannedMaterializedCallCount = plan.plannedMaterializedCallCount
    report.plannedMaterializedCallArgCount = plan.plannedMaterializedCallArgCount
    report.plannedMaterializedBlockCount = plan.plannedMaterializedBlockCount
    report.plannedMaterializedTermCount = plan.plannedMaterializedTermCount
    report.plannedMaterializedTermOperandCount =
        plan.plannedMaterializedTermOperandCount
    let arenaReport = phase.PhaseArenaReport(plan.arena)
    report.arenaCapacityBytes = arenaReport.capacityBytes
    report.arenaPeakBytes = arenaReport.peakBytes
    coreir.BodyIRControlFlowOpenExactMutation(bodyIR)
    cleanupCfgInsertFlagInitializers(plan, bodyIR, report)
    for fragmentId in 0..<plan.fragmentOpStarts.len:
        cleanupCfgEnsureFragmentCStrings(
            plan, bodyIR, fragmentId, report)
    coreir.BodyIRControlFlowSeal(bodyIR)
    if !layout.FixedBytes32Equal(
           immutableControlIdentityBefore,
           cleanupCfgImmutableControlIdentityCid(bodyIR)):
        cleanupCfgFail(
            "cleanup_cfg: initializer mutated immutable control identity")
    var scheduleDraft: cleanupScheduleDraft
    cleanupCfgBuildAndSealIntent(plan, bodyIR, scheduleDraft)
    coreir.BodyIRControlFlowOpenExactMutation(bodyIR)
    cleanupCfgPrepareOwnershipOpSites(
        plan, bodyIR, report, scheduleDraft)
    cleanupCfgValidateOriginalSourceIndex(plan, false)
    if cleanupCfgOriginalSourceIdentityFingerprint(plan) !=
       originalSourceIdentityFingerprintBefore:
        cleanupCfgFail(
            "cleanup_cfg: original source identity mutated")
    var materializedExitCount: int32
    for sourceEdgeKey in 0..<plan.exitIdBySourceEdge.len:
        let exitId = plan.exitIdBySourceEdge[sourceEdgeKey]
        if exitId < 0:
            continue
        if exitId >= plan.exitOriginalSourceBlockIds.len:
            cleanupCfgFail(
                "cleanup_cfg: canonical exit materialization row invalid")
        let canonicalSourceEdgeKey = cleanupCfgCheckedAdd(
            cleanupCfgCheckedMul(
                plan.exitOriginalSourceBlockIds[exitId],
                2,
                "cleanup_cfg: canonical source edge key overflow"),
            plan.exitSuccessorOrdinals[exitId],
            "cleanup_cfg: canonical source edge key overflow")
        if canonicalSourceEdgeKey != sourceEdgeKey:
            cleanupCfgFail(
                "cleanup_cfg: canonical exit materialization index drift")
        cleanupCfgMaterializeExit(
            plan, bodyIR, exitId, report, scheduleDraft)
        materializedExitCount = cleanupCfgCheckedAdd(
            materializedExitCount,
            1,
            "cleanup_cfg: materialized exit count overflow")
    if materializedExitCount != plan.exitOriginalSourceBlockIds.len:
        cleanupCfgFail(
            "cleanup_cfg: canonical exit materialization count drift")
    cleanupCfgMaterializePreparedOwnershipOpSites(
        plan, bodyIR, report, scheduleDraft)
    # [wall129] canonical 块数组序重建（见函数头注释）：物化追加全部完
    # 成、schedule 封印之前，把 blocks 数组序归位为 op 流分区序并全量
    # remap 块号耦合列，随后的 schedule seal 与 final decode 均出生于
    # canonical 布局（w126b 移交墙 BodyIrCfgErrorBlockRange 的域内修法）。
    cleanupCfgCanonicalizeBlockOpArrayOrder(bodyIR, scheduleDraft)
    coreir.BodyIRControlFlowSeal(bodyIR)
    cleanupCfgBuildAndSealSchedule(bodyIR, scheduleDraft)
    cleanupCfgBuildAndSealReplay(bodyIR)
    # [wall122] exactDef 侧车追加行同步收尾。物化是行系变更（ops/
    # localSlots/callSequence 平移+追加）的作者；exactDef 侧车是同一行系
    # 坐标类的后产车道（wall83 平移 helper 已在物化内完成 op 车道平移，
    # 本收尾补齐追加行扩列+refreeze）。final decode（ApplyOwned 窗口内、
    # 挂接点 SyncAppended 之前）的 BodyIrAccessDecode 入口联立门在
    # sealed 态强制 exactDef 车道与 ops/localSlots/callSequence 计数恒等；
    # wall83「ShapeValid 窗口内挂起」既定契约只覆盖 plan-build 窗口，
    # 物化收尾行系已终态，此处恢复恒等是契约完成而非挂起破坏。
    # SyncAppended 幂等：挂接点（primary_object_plan / backend2_pipeline
    # ApplyOwned 返回侧）二次调用时行系未再变，扩列循环零次，refreeze
    # 同内容同 CID。追加 def 行的 storage 证据门（wall94）fail-closed
    # 原样生效：证据洞 panic 暴露，零静默零弱化。
    if !exactdeffreeze.ExactDefFreezeSidecarSyncAppended(bodyIR):
        cleanupCfgFail(
            "cleanup_cfg: exact def sidecar appended sync failed")
    if bodyIR.controlFunctionRow != controlFunctionRowBefore ||
       !layout.FixedBytes32Equal(
           immutableControlIdentityBefore,
           cleanupCfgImmutableControlIdentityCid(bodyIR)):
        cleanupCfgFail(
            "cleanup_cfg: immutable control identity drift")
    if !bodyIR.externFfiHandleCapabilities.sealed &&
       bodyIR.externFfiHandleCapabilities.callOrdinals.len > 0:
        coreir.BodyIRExternFfiHandleCapabilitySeal(bodyIR)
    report.ownershipActionFingerprintAfter =
        CleanupPlanOwnershipActionFingerprint(plan)
    if report.ownershipActionFingerprintAfter !=
       report.ownershipActionFingerprintBefore:
        cleanupCfgFail("cleanup_cfg: materialization mutated ownership actions")
    if report.materializedLocalCount !=
           plan.plannedMaterializedLocalCount ||
       report.materializedOpCount != plan.plannedMaterializedOpCount ||
       report.materializedOperandCount != plan.plannedMaterializedOperandCount ||
       report.materializedCallCount != plan.plannedMaterializedCallCount ||
       report.materializedCallArgCount != plan.plannedMaterializedCallArgCount ||
       report.materializedBlockCount != plan.plannedMaterializedBlockCount ||
       report.materializedTermCount != plan.plannedMaterializedTermCount ||
       report.materializedTermOperandCount != plan.plannedMaterializedTermOperandCount:
        cleanupCfgFail(Fmt"cleanup_cfg: materialized complexity ledger drift local={report.materializedLocalCount}/{plan.plannedMaterializedLocalCount} op={report.materializedOpCount}/{plan.plannedMaterializedOpCount} operand={report.materializedOperandCount}/{plan.plannedMaterializedOperandCount} call={report.materializedCallCount}/{plan.plannedMaterializedCallCount} call_arg={report.materializedCallArgCount}/{plan.plannedMaterializedCallArgCount} block={report.materializedBlockCount}/{plan.plannedMaterializedBlockCount} term={report.materializedTermCount}/{plan.plannedMaterializedTermCount} term_operand={report.materializedTermOperandCount}/{plan.plannedMaterializedTermOperandCount}")
    if report.materializedCStringCount > plan.limits.maxMaterializedCStringCount:
        cleanupCfgFail("cleanup_cfg: materialized cstring bound exceeded")
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR):
        cleanupCfgFail("cleanup_cfg: materialized debug provenance shape invalid")
    let bodyReport = coreir.BodyIRDodSoAContractCheck(bodyIR)
    if !bodyReport.ok:
        cleanupCfgFail(Fmt"cleanup_cfg: materialized BodyIR contract failed sub={bodyReport.firstInvalidRefOwner} value={bodyReport.firstInvalidRefValue} limit={bodyReport.firstInvalidRefLimit} invalid_refs={bodyReport.invalidRefCount} pointer_keys={bodyReport.pointerKeyCount} ops={bodyReport.opCount} op_operands={bodyReport.opOperandCount} locals={bodyReport.localCount} blocks={bodyReport.blockCount} terms={bodyReport.termCount} term_operands={bodyReport.termOperandCount} cstrings={bodyReport.cstringCount} calls={bodyReport.callCount}")
    report.typeLayoutResolveVisitCount = plan.typeLayoutResolveVisitCount
    report.bindingLookupVisitCount = plan.bindingLookupVisitCount
    report.transitionIndexVisitCount = plan.transitionIndexVisitCount
    report.transitionRangeVisitCount = plan.transitionRangeVisitCount
    report.fieldDedupVisitCount = plan.fieldDedupVisitCount
    report.physicalIntervalVisitCount = plan.physicalIntervalVisitCount
    report.independentStackSeedVisitCount =
        plan.independentStackSeedVisitCount
    report.capturedStackAllocationCount = plan.capturedStackAllocationCount
    report.mutationCandidateLogicalBytes =
        plan.mutationCandidatePeakBytes
    report.mutationOwnerMoveCount = plan.mutationOwnerMoveCount
    plan.materialized = true
    report.liveBytesBeforeRelease = CleanupPlanStructuredLiveBytes(plan)
    var releaseReceipt: CleanupPlanReleaseReceipt
    CleanupPlanRelease(plan, releaseReceipt)
    report.liveBytesAfterRelease = CleanupPlanStructuredLiveBytes(plan)
    report.releasedSequenceFieldCount =
        releaseReceipt.releasedSequenceFieldCount
    report.releasedPhysicalBufferCount =
        releaseReceipt.releasedPhysicalBufferCount
    report.releasedPhysicalBytes =
        releaseReceipt.releasedPhysicalBytes
    report.releasedManagedStringValueCount =
        releaseReceipt.releasedManagedStringValueCount
    report.releasedManagedStringBytes =
        releaseReceipt.releasedManagedStringBytes
    report.typeLayoutProviderAllocationCount =
        releaseReceipt.typeLayoutProviderAllocationCount
    report.typeLayoutProviderReleaseCount =
        releaseReceipt.typeLayoutProviderReleaseCount
    report.typeLayoutProviderPhysicalFreeCount =
        releaseReceipt.typeLayoutProviderPhysicalFreeCount
    report.typeLayoutProviderLiveReferenceCount =
        releaseReceipt.typeLayoutProviderLiveReferenceCount
    report.releaseStorageVerified =
        CleanupPlanReleaseReceiptClosed(releaseReceipt)
    report.released = plan.released &&
                      report.liveBytesAfterRelease == int64(0) &&
                      report.releaseStorageVerified
    if !report.released:
        cleanupCfgFail("cleanup_cfg: planner metadata release failed")
    return report

fn CleanupPlanMaterialize(bodyIR: var coreir.BodyIR,
                          plan: var CleanupPlan): CleanupMaterializeReport =
    var delta: CleanupMutationDelta
    var bodyCandidate: coreir.BodyIR
    var planCandidate: CleanupPlan
    cleanupCfgBeginBodyPlanMutation(bodyIR,
                                    plan,
                                    bodyCandidate,
                                    planCandidate,
                                    delta)
    delta.report = cleanupCfgStageMaterialize(bodyCandidate,
                                              planCandidate)
    cleanupCfgSealBodyPlanMutation(bodyCandidate, planCandidate, delta)
    delta.report.mutationCandidateLogicalBytes =
        delta.candidateLogicalBytes
    cleanupCfgCommitBodyPlanMutation(bodyIR,
                                     plan,
                                     bodyCandidate,
                                     planCandidate,
                                     delta)
    return delta.report

fn CleanupPlanExitDeferCount(plan: var CleanupPlan, exitId: int32): int32 =
    cleanupCfgRequireBuilding(plan)
    if exitId < 0 || exitId >= plan.exitDeferCounts.len:
        cleanupCfgFail("cleanup_cfg: exit id out of range")
    return plan.exitDeferCounts[exitId]

fn CleanupPlanExitKind(plan: var CleanupPlan,
                       exitId: int32): odir.OwnershipDropEdgeKind =
    cleanupCfgRequireBuilding(plan)
    if exitId < 0 || exitId >= plan.exitKinds.len:
        cleanupCfgFail("cleanup_cfg: exit id out of range")
    return plan.exitKinds[exitId]

fn CleanupPlanExitDeferId(plan: var CleanupPlan,
                          exitId: int32,
                          ordinal: int32): int32 =
    let count = CleanupPlanExitDeferCount(plan, exitId)
    if ordinal < 0 || ordinal >= count:
        cleanupCfgFail("cleanup_cfg: exit defer ordinal out of range")
    return plan.exitDeferIds[plan.exitDeferStarts[exitId] + ordinal]
