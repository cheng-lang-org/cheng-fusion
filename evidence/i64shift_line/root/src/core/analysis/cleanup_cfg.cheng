    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultSlots)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultPassKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultOwnershipKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultExprNodeIndexes)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultValueDefinitionRows)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultBorrowOwnerValueDefinitionRows)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultBorrowOwnerDefinitionDomains)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultBorrowOwnerDefinitionRows)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultDefinitionOriginKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callResultDefinitionOriginIds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callSourceDefinitionDomains)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callSourceDefinitionRows)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.callSemanticCallExprNodeIndexes)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callConsumeActionRows)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callManagedStoreKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callRelocWordOffsets)
    cleanupCfgFingerprintBoolSequenceField(out, columnCount, plan.callTargetIsImportcs)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callInlineF64FromIntKinds)
    cleanupCfgFingerprintBoolSequenceField(out, columnCount, plan.callWholeCallF64FromIntRescues)
    cleanupCfgFingerprintBoolSequenceField(out, columnCount, plan.callInlineF64FromIntUnsigneds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgStarts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgCounts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgAbiStarts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgAbiCounts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgSlots)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgPassKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.callArgAbiSizes)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.blockOpStarts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.blockOpCounts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.blockTermIndices)
    cleanupCfgFingerprintBoolSequenceField(out, columnCount, plan.blockIsFragmentExit)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termConditionKinds)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termResultSlots)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termSourceDefinitionDomains)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termSourceDefinitionRows)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termLhsSlots)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termRhsSlots)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termTrueBlocks)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termFalseBlocks)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termOperandStarts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termOperandCounts)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.termOperands)
    cleanupCfgFingerprintTextSequenceField(out, columnCount, plan.cstringTexts)
    cleanupCfgFingerprintTextSequenceField(out, columnCount, plan.cstringDataLabels)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.materializedCStringIds)
    cleanupCfgFingerprintBoolSequenceField(out, columnCount, plan.scratchTermSeen)
    cleanupCfgFingerprintI32SequenceField(out, columnCount, plan.scratchCStringMap)
    if columnCount != CleanupPlanCanonicalFingerprintSchemaFieldCount():
        cleanupCfgFail("cleanup_cfg: plan fingerprint schema drift")
    return out

fn CleanupPlanOpBindingFingerprint(plan: var CleanupPlan): int64 =
    return CleanupPlanCanonicalFingerprint(plan)

fn CleanupPlanOwnedSequenceFieldCount(): int32 =
    # wall79: 权威计数 = CleanupPlan 结构体切片字段数 = CleanupPlanRelease
    # 释放调用数（已逐名核对 270=270，无重复无遗漏）。旧值 264 系 6 个
    # 序列字段（ownershipOpSite/opValueDefBorrowOwner/callResultBorrowOwner
    # 等）入表后未同步 bump 的 stale 镜像，致每次 plan 物理释放必死
    # `physical release receipt incomplete`。镜像修正，守卫判据零改动。
    return 270

@borrows
fn cleanupCfgRecordSequenceRelease(
        values: T[],
        receipt: var CleanupPlanReleaseReceipt) =
    if values.len < 0 || values.cap < 0 || values.len > values.cap ||
       (values.cap == 0 && values.buffer != nil) ||
       (values.cap > 0 &&
        (values.buffer == nil ||
         system.memRefCount(values.buffer) != 1)):
        cleanupCfgFail(
            "cleanup_cfg: release sequence storage is invalid or shared")
    receipt.releasedSequenceFieldCount = cleanupCfgCheckedAdd(
        receipt.releasedSequenceFieldCount,
        1,
        "cleanup_cfg: released sequence field count overflow")
    if values.cap > 0:
        receipt.releasedPhysicalBufferCount = cleanupCfgCheckedAdd(
            receipt.releasedPhysicalBufferCount,
            1,
            "cleanup_cfg: released physical buffer count overflow")
        receipt.releasedPhysicalBytes = cleanupCfgCheckedAdd64(
            receipt.releasedPhysicalBytes,
            cleanupCfgCheckedMul64(
                int64(values.cap),
                int64(sizeof(T)),
                "cleanup_cfg: released sequence byte count overflow"),
            "cleanup_cfg: released physical byte count overflow")

@borrows
fn cleanupCfgReleaseRows(
        values: T[],
        receipt: var CleanupPlanReleaseReceipt) =
    cleanupCfgRecordSequenceRelease(values, receipt)

@borrows
fn cleanupCfgRecordManagedStringRelease(
        value: str,
        receipt: var CleanupPlanReleaseReceipt) =
    if len(value) <= 0:
        return
    receipt.releasedManagedStringValueCount = cleanupCfgCheckedAdd(
        receipt.releasedManagedStringValueCount,
        1,
        "cleanup_cfg: released managed string count overflow")
    receipt.releasedManagedStringBytes = cleanupCfgCheckedAdd64(
        receipt.releasedManagedStringBytes,
        int64(len(value)),
        "cleanup_cfg: released managed string byte count overflow")

@borrows
fn cleanupCfgReleaseTextRows(
        values: str[],
        receipt: var CleanupPlanReleaseReceipt) =
    cleanupCfgRecordSequenceRelease(values, receipt)
    for valueIndex in 0..<values.len:
        cleanupCfgRecordManagedStringRelease(values[valueIndex], receipt)

fn cleanupCfgReleaseTypeLayoutProvider(
        value: var str,
        allocationCount: var int32,
        releaseCount: var int32,
        physicalFreeCount: var int32,
        liveReferenceCount: var int32) =
    if value.flags != 0 && value.flags != 1:
        cleanupCfgFail(
            "cleanup_cfg: type layout provider ownership flag invalid")
    if len(value) == 0:
        if value.store_id != 0 ||
           value.flags != 0:
            cleanupCfgFail(
                "cleanup_cfg: empty type layout provider is not borrowed")
        cleanupCfgReleaseOwnedStringRaw(value)
        if value.data != nil || value.store_id != 0 || value.flags != 0:
            cleanupCfgFail(
                "cleanup_cfg: empty type layout provider canonicalization failed")
        return
    let releasesOwnedReference = value.flags == 1
    if !releasesOwnedReference || value.data == nil:
        cleanupCfgFail(
            "cleanup_cfg: type layout provider must be owned")
    let referenceCount = system.memRefCount(value.data)
    if referenceCount <= 0:
        cleanupCfgFail(
            "cleanup_cfg: type layout provider reference count invalid")
    let physicallyFreesAllocation = referenceCount == 1
    if !physicallyFreesAllocation:
        cleanupCfgFail(
            "cleanup_cfg: type layout provider must be uniquely owned")
    if releasesOwnedReference:
        allocationCount = cleanupCfgCheckedAdd(
            allocationCount,
            1,
            "cleanup_cfg: type layout provider allocation count overflow")
        releaseCount = cleanupCfgCheckedAdd(
            releaseCount,
            1,
            "cleanup_cfg: type layout provider release count overflow")
        liveReferenceCount = cleanupCfgCheckedAdd(
            liveReferenceCount,
            1,
            "cleanup_cfg: type layout provider live count overflow")
    cleanupCfgReleaseOwnedStringRaw(value)
    if len(value) != 0 ||
       value.data != nil ||
       value.store_id != 0 ||
       value.flags != 0:
        cleanupCfgFail(
            "cleanup_cfg: type layout provider physical release incomplete")
    if releasesOwnedReference:
        if physicallyFreesAllocation:
            physicalFreeCount =
                cleanupCfgCheckedAdd(
                    physicalFreeCount,
                    1,
                    "cleanup_cfg: type layout provider free count overflow")
        liveReferenceCount = liveReferenceCount - 1

@borrows
fn CleanupPlanReleaseReceiptClosed(
        receipt: CleanupPlanReleaseReceipt): bool =
    return receipt.storageReleased &&
           receipt.releasedSequenceFieldCount ==
               CleanupPlanOwnedSequenceFieldCount() &&
           receipt.releasedPhysicalBufferCount > 0 &&
           receipt.releasedPhysicalBytes > int64(0) &&
           receipt.releasedManagedStringValueCount >= 0 &&
           receipt.releasedManagedStringBytes >= int64(0) &&
           receipt.typeLayoutProviderAllocationCount >= 0 &&
           receipt.typeLayoutProviderAllocationCount <= 1 &&
           receipt.typeLayoutProviderReleaseCount ==
               receipt.typeLayoutProviderAllocationCount &&
           receipt.typeLayoutProviderPhysicalFreeCount ==
               receipt.typeLayoutProviderAllocationCount &&
           receipt.typeLayoutProviderLiveReferenceCount == 0

fn CleanupPlanRelease(
        plan: var CleanupPlan,
        receipt: var CleanupPlanReleaseReceipt) =
    if !plan.prepared || plan.released:
        cleanupCfgFail("cleanup_cfg: release requires live planner")
    if receipt.releasedSequenceFieldCount != 0 ||
       receipt.releasedPhysicalBufferCount != 0 ||
       receipt.releasedPhysicalBytes != int64(0) ||
       receipt.releasedManagedStringValueCount != 0 ||
       receipt.releasedManagedStringBytes != int64(0) ||
       receipt.typeLayoutProviderAllocationCount != 0 ||
       receipt.typeLayoutProviderReleaseCount != 0 ||
       receipt.typeLayoutProviderPhysicalFreeCount != 0 ||
       receipt.typeLayoutProviderLiveReferenceCount != 0 ||
       receipt.storageReleased:
        cleanupCfgFail("cleanup_cfg: release receipt must be empty")
    cleanupCfgReleaseTextRows(plan.typeLayoutCids, receipt)
    plan.typeLayoutCids = []
    cleanupCfgReleaseRows(plan.typeLayoutTypeArenaTypeIds, receipt)
    plan.typeLayoutTypeArenaTypeIds = []
    cleanupCfgReleaseRows(plan.typeLayoutKinds, receipt)
    plan.typeLayoutKinds = []
    cleanupCfgReleaseRows(plan.typeLayoutSizeBytes, receipt)
    plan.typeLayoutSizeBytes = []
    cleanupCfgReleaseRows(plan.typeLayoutAlignBytes, receipt)
    plan.typeLayoutAlignBytes = []
