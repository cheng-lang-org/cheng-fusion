# Function-local defer cleanup planner. The planner owns bounded SoA metadata
# only; Materialize lowers it into ordinary BodyIR and releases every sidecar.

type
    CleanupReturnSnapshotKind = enum
        CleanupReturnSnapshotNone
        CleanupReturnSnapshotUnmanagedCopy
