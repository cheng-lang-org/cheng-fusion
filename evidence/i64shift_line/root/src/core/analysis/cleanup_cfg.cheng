fn cleanupCfgStagePlanPrepare(plan: var CleanupPlan,
                              limits: CleanupPlanLimits,
                              entryBlockId: int32) =
    if plan.prepared || plan.released:
        cleanupCfgFail("cleanup_cfg: prepare requires fresh planner")
    cleanupCfgRequireLimits(limits)
    if entryBlockId != 0:
        cleanupCfgFail("cleanup_cfg: BodyIR entry block must be zero")
    plan.limits = limits
    plan.entryBlockId = entryBlockId
    plan.arena = phase.PhaseArenaInit(cleanupCfgLimitsCapacityBytes(limits))
    let reservation = phase.PhaseArenaReserve(plan.arena, plan.arena.capacity, int64(1))
    if !phase.PhaseArenaBlockIsValid(reservation):
        cleanupCfgFail("cleanup_cfg: planner arena reservation failed")
    cleanupCfgReservePlan(plan)
    for _ in 0..limits.maxOwnershipPlaceBindingCount:
        add(plan.ownershipPlaceBindingIndexByPlaceId, -1)
    for _ in 0..limits.maxOwnershipDropGlueBindingCount:
        add(plan.ownershipDropGlueBindingIndexByGlueId, -1)
        add(plan.ownershipRetainGlueBindingIndexByTypeId, -1)
    for _ in 0..limits.maxOwnershipConditionFlagBindingCount:
        add(plan.ownershipConditionLocalByFlagId, -1)
    for _ in 0..<limits.maxLocalSlotCount:
        add(plan.ownershipConditionFlagIdByLocalSlot, -1)
    for blockId in 0..<limits.maxSourceBlockCount:
        add(plan.exitIdBySourceEdge, -1)
        add(plan.exitIdBySourceEdge, -1)
    add(plan.scopeParentIds, -1)
    add(plan.scopeDepths, 0)
    add(plan.scopeDeferHeads, -1)
    add(plan.scopeLastLexicalOrdinals, -1)
    plan.prepared = true

fn CleanupPlanPrepare(plan: var CleanupPlan,
                      limits: CleanupPlanLimits,
                      entryBlockId: int32) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStagePlanPrepare(planCandidate, limits, entryBlockId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn cleanupCfgRequireBuilding(plan: var CleanupPlan) =
    if !plan.prepared || plan.materialized || plan.released:
        cleanupCfgFail("cleanup_cfg: planner is not in build state")

fn cleanupCfgRequireRegistrationOpen(plan: var CleanupPlan) =
    cleanupCfgRequireBuilding(plan)
    if plan.registrationsSealed:
        cleanupCfgFail("cleanup_cfg: registrations sealed by first exit")

fn cleanupCfgBindOwnershipAuthority(
        plan: var CleanupPlan,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis) =
    let irCid = odir.OwnershipDropIrCanonicalCid(ownershipIr)
    let analysisCid = odir.OwnershipDropAnalysisCanonicalCid(
        ownershipIr, ownershipAnalysis)
    if !coreir.BodyIRTypeArenaArtifactCidValid(irCid) ||
       !coreir.BodyIRTypeArenaArtifactCidValid(analysisCid):
        cleanupCfgFail("cleanup_cfg: ownership authority cid invalid")
    if plan.ownershipAuthorityBound:
        if !layout.FixedBytes32Equal(plan.ownershipIrCid, irCid) ||
           !layout.FixedBytes32Equal(
               plan.ownershipAnalysisCid, analysisCid):
            cleanupCfgFail(
                "cleanup_cfg: ownership authority source changed")
        return
    plan.ownershipAuthorityBound = true
    plan.ownershipIrCid = layout.FixedBytes32Copy(irCid)
    plan.ownershipAnalysisCid = layout.FixedBytes32Copy(analysisCid)

fn cleanupCfgStageBindTypeLayoutIndex(
        plan: var CleanupPlan,
        index: var CleanupTypeLayoutIndex) =
    cleanupCfgRequireRegistrationOpen(plan)
    if plan.typeLayoutBound || !index.prepared || !index.sealed ||
       len(index.providerCid) == 0 || index.typeLayoutCids.len <= 0 ||
       index.typeLayoutCids.len > plan.limits.maxOwnershipPlaceBindingCount ||
       index.physicalFieldTypeIds.len >
           plan.limits.maxOwnershipFieldProjectionStepCount ||
       index.projectionOwnerTypeIds.len >
           plan.limits.maxOwnershipFieldBindingCount ||
       index.projectionPathOrdinals.len >
           plan.limits.maxOwnershipFieldProjectionStepCount:
        cleanupCfgFail("cleanup_cfg: type layout provider unsupported")
    var nextStringPayloadBytes = cleanupCfgCheckedAdd(
        plan.stringPayloadBytes,
        len(index.providerCid),
        "cleanup_cfg: type layout provider cid byte overflow")
    for layoutCidIndex in 0..<index.typeLayoutCids.len:
        let layoutCid = index.typeLayoutCids[layoutCidIndex]
        nextStringPayloadBytes = cleanupCfgCheckedAdd(
            nextStringPayloadBytes,
            len(layoutCid),
            "cleanup_cfg: type layout cid byte overflow")
    if nextStringPayloadBytes > plan.limits.maxStringPayloadBytes:
        cleanupCfgFail("cleanup_cfg: type layout cid arena exhausted")
    plan.typeLayoutProviderCid =
        cleanupCfgOwnedTextCopy(index.providerCid)
    for typeRow in 0..<index.typeLayoutCids.len:
        add(plan.typeLayoutCids, strings.CloneStr(index.typeLayoutCids[typeRow]))
        add(plan.typeLayoutTypeArenaTypeIds,
            index.typeArenaTypeIds[typeRow])
        add(plan.typeLayoutKinds, index.typeKinds[typeRow])
        add(plan.typeLayoutSizeBytes, index.typeSizeBytes[typeRow])
        add(plan.typeLayoutAlignBytes, index.typeAlignBytes[typeRow])
        add(plan.typeLayoutPhysicalFieldStarts,
            index.typePhysicalFieldStarts[typeRow])
        add(plan.typeLayoutPhysicalFieldCounts,
            index.typePhysicalFieldCounts[typeRow])
        add(plan.typeLayoutProjectionStarts,
            index.typeProjectionStarts[typeRow])
        add(plan.typeLayoutProjectionCounts,
            index.typeProjectionCounts[typeRow])
    for fieldRow in 0..<index.physicalFieldTypeIds.len:
        add(plan.typeLayoutPhysicalFieldOwnerTypeIds,
            index.physicalFieldOwnerTypeIds[fieldRow])
        add(plan.typeLayoutPhysicalFieldOrdinals,
            index.physicalFieldOrdinals[fieldRow])
        add(plan.typeLayoutPhysicalFieldTypeIds,
            index.physicalFieldTypeIds[fieldRow])
        add(plan.typeLayoutPhysicalFieldByteOffsets,
            index.physicalFieldByteOffsets[fieldRow])
    for projectionRow in 0..<index.projectionOwnerTypeIds.len:
        add(plan.typeLayoutProjectionOwnerTypeIds,
            index.projectionOwnerTypeIds[projectionRow])
        add(plan.typeLayoutProjectionFieldOrdinals,
            index.projectionFieldOrdinals[projectionRow])
        add(plan.typeLayoutProjectionPathStarts, index.projectionPathStarts[projectionRow])
        add(plan.typeLayoutProjectionPathCounts, index.projectionPathCounts[projectionRow])
    for pathIndex in 0..<index.projectionPathOrdinals.len:
        let pathOrdinal = index.projectionPathOrdinals[pathIndex]
        add(plan.typeLayoutProjectionPathOrdinals, pathOrdinal)
    plan.stringPayloadBytes = nextStringPayloadBytes
    plan.typeLayoutBound = true

fn CleanupPlanBindTypeLayoutIndex(plan: var CleanupPlan,
                                  index: var CleanupTypeLayoutIndex) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindTypeLayoutIndex(planCandidate, index)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn cleanupCfgPlanTypeLayoutRow(plan: var CleanupPlan,
                               ownershipTypeId: int32): int32 =
    if !plan.typeLayoutBound || ownershipTypeId <= 0 ||
       ownershipTypeId > plan.typeLayoutCids.len:
        cleanupCfgFail("cleanup_cfg: ownership type layout missing")
    let row = ownershipTypeId - 1
    if len(plan.typeLayoutCids[row]) == 0:
        cleanupCfgFail("cleanup_cfg: ownership type layout missing")
    return row

fn cleanupCfgPlanPhysicalFieldRow(plan: var CleanupPlan,
                                  ownershipTypeId: int32,
                                  fieldOrdinal: int32): int32 =
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    let fieldCount = plan.typeLayoutPhysicalFieldCounts[typeRow]
    if fieldOrdinal < 0 || fieldOrdinal >= fieldCount:
        cleanupCfgFail("cleanup_cfg: type layout physical field missing")
    return cleanupCfgCheckedAdd(
        plan.typeLayoutPhysicalFieldStarts[typeRow],
        fieldOrdinal,
        "cleanup_cfg: type layout physical field row overflow")

fn cleanupCfgPlanProjectionRow(plan: var CleanupPlan,
                               ownershipTypeId: int32,
                               fieldOrdinal: int32): int32 =
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    let projectionCount = plan.typeLayoutProjectionCounts[typeRow]
    if fieldOrdinal < 0 || fieldOrdinal >= projectionCount:
        cleanupCfgFail("cleanup_cfg: ownership field layout unsupported")
    let row = cleanupCfgCheckedAdd(
        plan.typeLayoutProjectionStarts[typeRow],
        fieldOrdinal,
        "cleanup_cfg: type layout projection row overflow")
    if row < 0 || row >= plan.typeLayoutProjectionOwnerTypeIds.len ||
       plan.typeLayoutProjectionOwnerTypeIds[row] != ownershipTypeId ||
       plan.typeLayoutProjectionFieldOrdinals[row] != fieldOrdinal:
        cleanupCfgFail("cleanup_cfg: type layout projection CSR drift")
    return row

fn cleanupCfgStageBindLocalSchema(plan: var CleanupPlan,
                                  bodyIR: var coreir.BodyIR) =
    cleanupCfgRequireRegistrationOpen(plan)
    if plan.localSchemaBound:
        cleanupCfgFail("cleanup_cfg: local schema already bound")
    if bodyIR.localSlots.len > plan.limits.maxLocalSlotCount:
        cleanupCfgFail("cleanup_cfg: local schema exceeds bound")
    if !coreir.BodyIRTypeArenaProofDomainValid(bodyIR):
        cleanupCfgFail("cleanup_cfg: TypeArena proof domain invalid")
    var independentStackHighWater: int32
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        if slot.id != localIndex:
            cleanupCfgFail("cleanup_cfg: local schema id mismatch")
        if !coreir.BodyIRLocalSlotTypeArenaProofValid(slot):
            cleanupCfgFail("cleanup_cfg: local semantic type proof invalid")
        if slot.placeKind == coreir.BodyPlaceStackValueTag:
            if slot.stackOffset < 0:
                # 参数槽入口序数编码（wall44 契约补全）。StackValue 槽的负
                # stackOffset 是 BodyIRBindEntryParameterSlot /
                # BodyIREntryParameterSlotsShapeValid 权威契约的 canonical
                # 编码（core_types.cheng：stackOffset == -1-ordinal；本文件
                # entry-slot 域同样强制 stackOffset < 0），不是帧字节偏移：
                # 布局生产者（PrimaryBodyIrNextLocalStackOffset /
                # PrimaryBodyIrReflowLocalStackOffsets）以同一 IsParam
                # (skip stackOffset<0) 谓词把参数槽排除在独立栈区外。本阶段
                # 沿用同一谓词：参数槽仍受 schema 审（size/align 必须健康），
                # 但不参与对齐审、不贡献独立栈字节高水位；非参数 StackValue
                # 槽 schema 全列不变。plan 域独立栈高水位全域 0 基自洽
                # （bind/validate/refresh 互检同基），不沿用生产者域区基 16。
                if slot.sizeBytes <= 0 || slot.alignBytes <= 0:
                    cleanupCfgFail(
                        "cleanup_cfg: local stack schema invalid")
            else:
                if slot.sizeBytes <= 0 || slot.alignBytes <= 0 ||
                   slot.stackOffset % slot.alignBytes != 0:
                    cleanupCfgFail(
                        "cleanup_cfg: local stack schema invalid")
                let slotEnd = cleanupCfgCheckedAdd(
                    slot.stackOffset,
                    slot.sizeBytes,
                    "cleanup_cfg: local stack high-water overflow")
                if slotEnd > independentStackHighWater:
                    independentStackHighWater = slotEnd
        plan.independentStackSeedVisitCount = cleanupCfgCheckedAdd(
            plan.independentStackSeedVisitCount,
            1,
            "cleanup_cfg: stack high-water seed visit overflow")
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        add(plan.localTypeKinds, slot.typeKind)
        add(plan.localTypeArenaTypeIds, slot.typeArenaTypeId)
        add(plan.localManagedStorageKinds, slot.managedStorageKind)
        add(plan.localPlaceKinds, slot.placeKind)
        add(plan.localSizeBytes, slot.sizeBytes)
        add(plan.localAlignBytes, slot.alignBytes)
    plan.typeArenaArtifactCid = bodyIR.typeArenaArtifactCid
    plan.independentStackHighWater = independentStackHighWater
    plan.independentStackHighWaterReady = true
    plan.localSchemaBound = true

fn CleanupPlanBindLocalSchema(plan: var CleanupPlan,
                              bodyIR: var coreir.BodyIR) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindLocalSchema(planCandidate, bodyIR)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn cleanupCfgRequireLocalSchema(plan: var CleanupPlan,
                                bodyIR: var coreir.BodyIR) =
    if !plan.localSchemaBound ||
       !layout.FixedBytes32Equal(
           bodyIR.typeArenaArtifactCid, plan.typeArenaArtifactCid) ||
       bodyIR.localSlots.len != plan.localTypeKinds.len ||
       bodyIR.localSlots.len != plan.localTypeArenaTypeIds.len ||
       bodyIR.localSlots.len != plan.localManagedStorageKinds.len:
        cleanupCfgFail("cleanup_cfg: BodyIR local schema count drift")
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        if slot.id != localIndex ||
           slot.typeKind != plan.localTypeKinds[localIndex] ||
           slot.typeArenaTypeId != plan.localTypeArenaTypeIds[localIndex] ||
           slot.managedStorageKind !=
               plan.localManagedStorageKinds[localIndex] ||
           slot.placeKind != plan.localPlaceKinds[localIndex] ||
           slot.sizeBytes != plan.localSizeBytes[localIndex] ||
           slot.alignBytes != plan.localAlignBytes[localIndex]:
            cleanupCfgFail("cleanup_cfg: BodyIR local schema drift")

fn cleanupCfgAlignStackOffset(value: int32, alignment: int32): int32 =
    if value < 0 || alignment <= 0:
        cleanupCfgFail("cleanup_cfg: stack alignment input invalid")
    let remainder = value % alignment
    if remainder == 0:
        return value
    return cleanupCfgCheckedAdd(
        value,
        cleanupCfgCheckedSub(
            alignment,
            remainder,
            "cleanup_cfg: stack alignment underflow"),
        "cleanup_cfg: stack alignment overflow")

fn cleanupCfgAllocateCapturedStackOffset(plan: var CleanupPlan,
                                         sizeBytes: int32,
                                         alignBytes: int32): int32 =
    if !plan.independentStackHighWaterReady || sizeBytes <= 0 ||
       alignBytes <= 0:
        cleanupCfgFail("cleanup_cfg: captured stack allocator unavailable")
    let out = cleanupCfgAlignStackOffset(plan.independentStackHighWater,
                                         alignBytes)
    plan.independentStackHighWater = cleanupCfgCheckedAdd(
        out,
        sizeBytes,
        "cleanup_cfg: captured stack high-water overflow")
    plan.capturedStackAllocationCount = cleanupCfgCheckedAdd(
        plan.capturedStackAllocationCount,
        1,
        "cleanup_cfg: captured stack allocation count overflow")
    return out

fn cleanupCfgRequireScope(plan: var CleanupPlan, scopeId: int32) =
    if scopeId < 0 || scopeId >= plan.scopeParentIds.len:
        cleanupCfgFail("cleanup_cfg: unknown scope id")

fn CleanupPlanRootScopeId(plan: var CleanupPlan): int32 =
    cleanupCfgRequireBuilding(plan)
    if plan.scopeParentIds.len <= 0 || plan.scopeParentIds[0] != -1:
        cleanupCfgFail("cleanup_cfg: root scope missing")
    return 0

fn cleanupCfgStageAddScope(plan: var CleanupPlan,
                           parentScopeId: int32): int32 =
    cleanupCfgRequireRegistrationOpen(plan)
    cleanupCfgRequireScope(plan, parentScopeId)
    if plan.scopeParentIds.len >= plan.limits.maxScopeCount:
        cleanupCfgFail("cleanup_cfg: scope arena exhausted")
    let scopeId = plan.scopeParentIds.len
    add(plan.scopeParentIds, parentScopeId)
    add(plan.scopeDepths,
        cleanupCfgCheckedAdd(plan.scopeDepths[parentScopeId],
                             1,
                             "cleanup_cfg: scope depth overflow"))
    add(plan.scopeDeferHeads, -1)
    add(plan.scopeLastLexicalOrdinals, -1)
    return scopeId

fn CleanupPlanAddScope(plan: var CleanupPlan, parentScopeId: int32): int32 =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    delta.resultId = cleanupCfgStageAddScope(planCandidate,
                                             parentScopeId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)
    return delta.resultId

fn cleanupCfgScopeIsAncestor(plan: var CleanupPlan,
                             ancestorScopeId: int32,
                             scopeId: int32): bool =
    cleanupCfgRequireScope(plan, ancestorScopeId)
    cleanupCfgRequireScope(plan, scopeId)
    var current = scopeId
    while current >= 0:
        if current == ancestorScopeId:
            return true
        current = plan.scopeParentIds[current]
    return false

fn cleanupCfgFragmentShape(plan: var CleanupPlan,
                           fragment: var coreir.BodyIR): CleanupFragmentShape =
    var shape: CleanupFragmentShape
    if !plan.localSchemaBound:
        cleanupCfgFail("cleanup_cfg: bind local schema before fragments")
    cleanupCfgRequireLocalSchema(plan, fragment)
    if !coreir.BodyIRManualConsumeSidecarIsCanonicalEmpty(
           fragment.manualConsume) ||
       coreir.BodyIRManualConsumeSidecarHasPhysicalStorage(
           fragment.manualConsume):
        cleanupCfgFail(
            "cleanup_cfg: fragment manual consume sidecar unsupported")
    if !coreir.BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(
           fragment.externFfiHandleCapabilities):
        cleanupCfgFail(
            "cleanup_cfg: fragment FFI handle capability sidecar unsupported")
    if !coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
           fragment.deferReplay) ||
       coreir.BodyIRDeferReplaySidecarHasPhysicalStorage(
           fragment.deferReplay):
        cleanupCfgFail(
            "cleanup_cfg: fragment defer replay sidecar unsupported")
    if fragment.blocks.len <= 0 ||
       !fragment.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(fragment) ||
       fragment.controlScopeParentIds.len != 1 ||
       fragment.controlScopeParentIds[0] != -1 ||
       fragment.deferDeclarationScopeIds.len != 0 ||
       fragment.deferActivationSiteBlockIds.len != 0 ||
       fragment.deferActivationRows.len != 0:
        cleanupCfgFail(
            "cleanup_cfg: cleanup fragment control profile invalid")
    for blockId in 0..<fragment.blockScopeIds.len:
        if fragment.blockScopeIds[blockId] != 0:
            cleanupCfgFail(
                "cleanup_cfg: cleanup fragment scope must be root")
    if fragment.callTargetDomainKinds.len !=
           fragment.callSequence.len ||
       fragment.callTargetRows.len != fragment.callSequence.len ||
       fragment.callTargetInterfaceCids.len !=
           fragment.callSequence.len:
        cleanupCfgFail(
            "cleanup_cfg: fragment call target authority missing")
    for callIndex in 0..<fragment.callSequence.len:
        if !coreir.BodyIRCallTargetIdentityValid(
               fragment.callTargetDomainKinds[callIndex],
               fragment.callTargetRows[callIndex]) ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               fragment.callTargetInterfaceCids[callIndex]):
            cleanupCfgFail(
                "cleanup_cfg: fragment call target authority invalid")
    for edgeIndex in 0..<fragment.successorEdgeKinds.len:
        if fragment.successorEdgeKinds[edgeIndex] !=
               coreir.BodyControlEdgeNormal:
            cleanupCfgFail(
                "cleanup_cfg: fragment edge must be exact normal control")
    if plan.fragmentOpStarts.len >= plan.limits.maxFragmentCount ||
       cleanupCfgCheckedAdd(plan.opKinds.len,
                            fragment.ops.len,
                            "cleanup_cfg: fragment op count overflow") >
           plan.limits.maxFragmentOpCount ||
       cleanupCfgCheckedAdd(plan.callTargetSymbols.len,
                            fragment.callSequence.len,
                            "cleanup_cfg: fragment call count overflow") >
           plan.limits.maxFragmentCallCount ||
       cleanupCfgCheckedAdd(plan.blockOpStarts.len,
                            fragment.blocks.len,
                            "cleanup_cfg: fragment block count overflow") >
           plan.limits.maxFragmentBlockCount ||
       cleanupCfgCheckedAdd(plan.termKinds.len,
                            fragment.terms.len,
                            "cleanup_cfg: fragment term count overflow") >
           plan.limits.maxFragmentTermCount ||
       cleanupCfgCheckedAdd(plan.cstringTexts.len,
                            fragment.cstringLiterals.len,
                            "cleanup_cfg: fragment cstring count overflow") >
           plan.limits.maxFragmentCStringCount:
        cleanupCfgFail("cleanup_cfg: fragment row arena exhausted")
    for opIndex in 0..<fragment.ops.len:
        shape.operandCount = cleanupCfgCheckedAdd(
            shape.operandCount,
            fragment.ops[opIndex].operands.len,
            "cleanup_cfg: fragment operand count overflow")
    if cleanupCfgCheckedAdd(plan.opOperands.len,
                            shape.operandCount,
                            "cleanup_cfg: fragment operand count overflow") >
       plan.limits.maxFragmentOperandCount:
        cleanupCfgFail("cleanup_cfg: fragment operand arena exhausted")
    for callIndex in 0..<fragment.callSequence.len:
        let call = fragment.callSequence[callIndex]
        if call.argSlots.len != call.argPassKinds.len ||
           (call.argAbiSizes.len != 0 && call.argAbiSizes.len != call.argSlots.len):
            cleanupCfgFail("cleanup_cfg: malformed fragment call columns")
        shape.callArgCount = cleanupCfgCheckedAdd(
            shape.callArgCount,
            call.argSlots.len,
            "cleanup_cfg: fragment call arg count overflow")
        shape.callAbiCount = cleanupCfgCheckedAdd(
            shape.callAbiCount,
            call.argAbiSizes.len,
            "cleanup_cfg: fragment call ABI count overflow")
    if cleanupCfgCheckedAdd(plan.callArgSlots.len,
                            shape.callArgCount,
                            "cleanup_cfg: fragment call arg count overflow") >
           plan.limits.maxFragmentCallArgCount ||
       cleanupCfgCheckedAdd(plan.callArgAbiSizes.len,
                            shape.callAbiCount,
                            "cleanup_cfg: fragment call ABI count overflow") >
           plan.limits.maxFragmentCallArgCount:
        cleanupCfgFail("cleanup_cfg: fragment call-arg arena exhausted")
    for termIndex in 0..<fragment.terms.len:
        shape.termOperandCount = cleanupCfgCheckedAdd(
            shape.termOperandCount,
            fragment.terms[termIndex].operands.len,
            "cleanup_cfg: fragment term operand count overflow")
    if cleanupCfgCheckedAdd(plan.termOperands.len,
                            shape.termOperandCount,
                            "cleanup_cfg: fragment term operand count overflow") >
       plan.limits.maxFragmentTermOperandCount:
        cleanupCfgFail("cleanup_cfg: fragment term-operand arena exhausted")

    setLen(plan.scratchTermSeen, 0)
    for termIndex in 0..<fragment.terms.len:
        add(plan.scratchTermSeen, false)
    var expectedOpStart: int32
    var exitCount: int32
    for blockIndex in 0..<fragment.blocks.len:
        let block = fragment.blocks[blockIndex]
        if block.id != blockIndex || block.opStart != expectedOpStart ||
           block.opCount < 0 ||
           cleanupCfgCheckedAdd(block.opStart,
                                block.opCount,
                                "cleanup_cfg: fragment block op range overflow") >
               fragment.ops.len ||
           block.termIndex < 0 || block.termIndex >= fragment.terms.len ||
           plan.scratchTermSeen[block.termIndex]:
            cleanupCfgFail("cleanup_cfg: malformed fragment block partition")
        plan.scratchTermSeen[block.termIndex] = true
        expectedOpStart = cleanupCfgCheckedAdd(
            block.opStart,
            block.opCount,
            "cleanup_cfg: fragment block op range overflow")
        let term = fragment.terms[block.termIndex]
        if term.kind == coreir.BodyTermReturnTag:
            if term.resultSlot != -1 || term.operands.len != 0:
                cleanupCfgFail("cleanup_cfg: defer fragment cannot transfer control")
            exitCount = cleanupCfgCheckedAdd(
                exitCount,
                1,
                "cleanup_cfg: fragment exit count overflow")
        elif term.kind == coreir.BodyTermBrTag:
            if term.trueBlock < 0 || term.trueBlock >= fragment.blocks.len ||
               term.operands.len != 0 ||
               term.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainInvalidTag ||
               term.sourceDefinitionRow != -1:
                cleanupCfgFail("cleanup_cfg: fragment branch target out of range")
        elif term.kind == coreir.BodyTermCbrTag:
            if term.trueBlock < 0 || term.trueBlock >= fragment.blocks.len ||
               term.falseBlock < 0 || term.falseBlock >= fragment.blocks.len ||
               term.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainInvalidTag ||
               term.sourceDefinitionRow != -1:
                cleanupCfgFail("cleanup_cfg: fragment conditional target out of range")
            let localZeroTest =
                term.conditionKind ==
                    coreir.BodyCondLocalNonZeroTag ||
                term.conditionKind ==
                    coreir.BodyCondLocalZeroTag
            if localZeroTest &&
               (term.lhsSlot < 0 || term.rhsSlot >= 0 ||
                term.operands.len != 0):
                cleanupCfgFail(
                    "cleanup_cfg: fragment local condition authority duplicated")
        else:
            cleanupCfgFail("cleanup_cfg: fragment term kind unsupported")
    if expectedOpStart != fragment.ops.len || exitCount <= 0:
        cleanupCfgFail("cleanup_cfg: fragment lacks structured fallthrough exit")
    for termIndex in 0..<plan.scratchTermSeen.len:
        if !plan.scratchTermSeen[termIndex]:
            cleanupCfgFail("cleanup_cfg: fragment has orphan term")
    return shape

fn cleanupCfgStageCaptureFragment(plan: var CleanupPlan,
                                  fragment: var coreir.BodyIR): int32 =
    cleanupCfgRequireRegistrationOpen(plan)
    let shape = cleanupCfgFragmentShape(plan, fragment)
    var checkedDefinitionDomain: int32
    var checkedDefinitionRow: int32
    for opIndex in 0..<fragment.ops.len:
        let op = fragment.ops[opIndex]
        if op.valueDefConsumeOpIndexPlusOne < 0 ||
           op.valueDefConsumeOpIndexPlusOne > fragment.ops.len:
            cleanupCfgFail(
                "cleanup_cfg: fragment BodyOp consume row out of range")
        let selfManagedStoreKind =
            cleanupCfgManagedLvalueReplaceKindForOp(
                fragment, opIndex)
        var relocatedConsumeActionRow: int32 = -1
        if cleanupCfgManagedLvalueReplaceMoveKind(
               selfManagedStoreKind):
            relocatedConsumeActionRow = opIndex
            let callIndex = op.operands[0]
            let moveCall = fragment.callSequence[callIndex]
            if moveCall.consumeActionRow != opIndex ||
               moveCall.sourceDefinitionDomain !=
                   op.sourceDefinitionDomain ||
               moveCall.sourceDefinitionRow !=
                   op.sourceDefinitionRow:
                cleanupCfgFail(
                    "cleanup_cfg: fragment move CallOp/BodyOp authority drift")
        elif cleanupCfgManagedLvalueReplaceRetainKind(
                 selfManagedStoreKind) &&
             op.consumeActionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: fragment retained BodyOp carries consume row")
        if op.valueDefConsumeOpIndexPlusOne > 0:
            let consumeOpIndex =
                op.valueDefConsumeOpIndexPlusOne - 1
            let consumeManagedStoreKind =
                cleanupCfgManagedLvalueReplaceKindForOp(
                    fragment, consumeOpIndex)
            if cleanupCfgManagedLvalueReplaceMoveKind(
                   consumeManagedStoreKind):
                if relocatedConsumeActionRow >= 0 &&
                   relocatedConsumeActionRow != consumeOpIndex:
                    cleanupCfgFail(
                        "cleanup_cfg: fragment BodyOp consume roles conflict")
                relocatedConsumeActionRow = consumeOpIndex
            elif cleanupCfgManagedLvalueReplaceRetainKind(
                     consumeManagedStoreKind):
                cleanupCfgFail(
                    "cleanup_cfg: fragment retained source cannot be consumed")
        if relocatedConsumeActionRow >= 0 &&
           op.consumeActionRow != relocatedConsumeActionRow:
            cleanupCfgFail(
                "cleanup_cfg: fragment BodyOp consume row out of range")
        cleanupCfgRelocateDefinitionCoordinate(
            fragment,
            op.sourceDefinitionDomain,
            op.sourceDefinitionRow,
            0,
            fragment.ops.len,
            checkedDefinitionDomain,
            checkedDefinitionRow)
        cleanupCfgRelocateDefinitionCoordinate(
            fragment,
            op.valueDefBorrowOwnerDefinitionDomain,
            op.valueDefBorrowOwnerDefinitionRow,
            0,
            fragment.ops.len,
            checkedDefinitionDomain,
            checkedDefinitionRow)
    for callIndex in 0..<fragment.callSequence.len:
        let call = fragment.callSequence[callIndex]
        let managedReplaceMove =
            cleanupCfgManagedLvalueReplaceMoveKind(
                call.managedStoreKind)
        let managedReplaceRetain =
            cleanupCfgManagedLvalueReplaceRetainKind(
                call.managedStoreKind)
        if managedReplaceMove &&
           (call.consumeActionRow < 0 ||
            call.consumeActionRow >= fragment.ops.len):
            cleanupCfgFail(
                "cleanup_cfg: fragment CallOp consume row out of range")
        if managedReplaceMove:
            let consumingOp = fragment.ops[call.consumeActionRow]
            if consumingOp.kind != coreir.BodyOpCallTag ||
               consumingOp.operands.len != 1 ||
               consumingOp.operands[0] != callIndex ||
               consumingOp.consumeActionRow != call.consumeActionRow ||
               consumingOp.sourceDefinitionDomain !=
                   call.sourceDefinitionDomain ||
               consumingOp.sourceDefinitionRow !=
                   call.sourceDefinitionRow ||
               call.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               call.sourceDefinitionRow < 0 ||
               call.sourceDefinitionRow >= fragment.ops.len:
                cleanupCfgFail(
                    "cleanup_cfg: fragment move CallOp/BodyOp authority drift")
            let sourceDefinition =
                fragment.ops[call.sourceDefinitionRow]
            if sourceDefinition.valueDefConsumeOpIndexPlusOne !=
                   call.consumeActionRow + 1 ||
               sourceDefinition.consumeActionRow !=
                   call.consumeActionRow:
                cleanupCfgFail(
                    "cleanup_cfg: fragment move source definition authority drift")
        if managedReplaceRetain && call.consumeActionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: fragment retained CallOp carries consume row")
        cleanupCfgRelocateDefinitionCoordinate(
            fragment,
            call.sourceDefinitionDomain,
            call.sourceDefinitionRow,
            0,
            fragment.ops.len,
            checkedDefinitionDomain,
            checkedDefinitionRow)
        cleanupCfgRelocateDefinitionCoordinate(
            fragment,
            call.resultBorrowOwnerDefinitionDomain,
            call.resultBorrowOwnerDefinitionRow,
            0,
            fragment.ops.len,
            checkedDefinitionDomain,
            checkedDefinitionRow)
    for termIndex in 0..<fragment.terms.len:
        cleanupCfgRelocateDefinitionCoordinate(
            fragment,
            fragment.terms[termIndex].sourceDefinitionDomain,
            fragment.terms[termIndex].sourceDefinitionRow,
            0,
            fragment.ops.len,
            checkedDefinitionDomain,
            checkedDefinitionRow)
    var nextStringPayloadBytes = plan.stringPayloadBytes
    for callIndex in 0..<fragment.callSequence.len:
        let call = fragment.callSequence[callIndex]
        nextStringPayloadBytes = cleanupCfgCheckedAdd(
            nextStringPayloadBytes,
            cleanupCfgCheckedAdd(
                len(call.targetSymbol),
                len(call.targetSourcePath),
                "cleanup_cfg: fragment string byte overflow"),
            "cleanup_cfg: fragment string byte overflow")
    for literalIndex in 0..<fragment.cstringLiterals.len:
        let literal = fragment.cstringLiterals[literalIndex]
        if literal.id != literalIndex:
            cleanupCfgFail("cleanup_cfg: fragment cstring id mismatch")
        nextStringPayloadBytes = cleanupCfgCheckedAdd(
            nextStringPayloadBytes,
            cleanupCfgCheckedAdd(len(literal.text),
                                 len(literal.dataLabel),
                                 "cleanup_cfg: fragment string byte overflow"),
            "cleanup_cfg: fragment string byte overflow")
    if nextStringPayloadBytes > plan.limits.maxStringPayloadBytes:
        cleanupCfgFail("cleanup_cfg: fragment string arena exhausted")
    let fragmentId = plan.fragmentOpStarts.len
    add(plan.fragmentOpStarts, plan.opKinds.len)
    add(plan.fragmentOpCounts, fragment.ops.len)
    add(plan.fragmentOperandStarts, plan.opOperands.len)
    add(plan.fragmentOperandCounts, shape.operandCount)
    add(plan.fragmentCallStarts, plan.callTargetSymbols.len)
    add(plan.fragmentCallCounts, fragment.callSequence.len)
    add(plan.fragmentCallArgStarts, plan.callArgSlots.len)
    add(plan.fragmentCallArgCounts, shape.callArgCount)
    add(plan.fragmentCallArgAbiStarts, plan.callArgAbiSizes.len)
    add(plan.fragmentCallArgAbiCounts, shape.callAbiCount)
    add(plan.fragmentBlockStarts, plan.blockOpStarts.len)
    add(plan.fragmentBlockCounts, fragment.blocks.len)
    add(plan.fragmentTermStarts, plan.termKinds.len)
    add(plan.fragmentTermCounts, fragment.terms.len)
    add(plan.fragmentTermOperandStarts, plan.termOperands.len)
    add(plan.fragmentTermOperandCounts, shape.termOperandCount)
    add(plan.fragmentCStringStarts, plan.cstringTexts.len)
    add(plan.fragmentCStringCounts, fragment.cstringLiterals.len)
    add(plan.fragmentEntryBlockOrdinals, 0)

    for opIndex in 0..<fragment.ops.len:
        let op = fragment.ops[opIndex]
        add(plan.opKinds, op.kind)
        add(plan.opTargets, op.target)
        add(plan.opOperandStarts, plan.opOperands.len)
        add(plan.opOperandCounts, op.operands.len)
        add(plan.opValueDefSlots, op.valueDefSlot)
        add(plan.opValueDefExprNodeIndexes, op.valueDefExprNodeIndex)
        add(plan.opValueDefSemanticRows, op.valueDefSemanticRow)
        add(plan.opValueDefOwnershipKinds, int32(op.valueDefOwnership))
        add(plan.opValueDefBorrowOwnerSemanticRows,
            op.valueDefBorrowOwnerSemanticRow)
        add(plan.opValueDefBorrowOwnerDefinitionDomains,
            op.valueDefBorrowOwnerDefinitionDomain)
        add(plan.opValueDefBorrowOwnerDefinitionRows,
            op.valueDefBorrowOwnerDefinitionRow)
        add(plan.opValueDefConsumeOpIndexPlusOnes,
            op.valueDefConsumeOpIndexPlusOne)
        add(plan.opValueDefOriginKinds, op.valueDefOriginKind)
        add(plan.opValueDefOriginIds, op.valueDefOriginId)
        add(plan.opSourceDefinitionDomains,
            op.sourceDefinitionDomain)
        add(plan.opSourceDefinitionRows, op.sourceDefinitionRow)
        add(plan.opConsumeActionRows, op.consumeActionRow)
        for operandIndex in 0..<op.operands.len:
            add(plan.opOperands, op.operands[operandIndex])
    for callIndex in 0..<fragment.callSequence.len:
        let call = fragment.callSequence[callIndex]
        add(plan.callTargetSymbols, share(call.targetSymbol))
        add(plan.callTargetSourcePaths, share(call.targetSourcePath))
        add(plan.callTargetDomainKinds,
            fragment.callTargetDomainKinds[callIndex])
        add(plan.callTargetRows,
            fragment.callTargetRows[callIndex])
        add(plan.callTargetInterfaceCids,
            layout.FixedBytes32Copy(
                fragment.callTargetInterfaceCids[callIndex]))
        add(plan.callResultSlots, call.resultSlot)
        add(plan.callResultPassKinds, call.resultPassKind)
        add(plan.callResultOwnershipKinds, int32(call.resultOwnership))
        add(plan.callResultExprNodeIndexes, call.resultExprNodeIndex)
        add(plan.callResultValueDefinitionRows,
            call.resultValueDefinitionRow)
        add(plan.callResultBorrowOwnerValueDefinitionRows,
            call.resultBorrowOwnerValueDefinitionRow)
        add(plan.callResultBorrowOwnerDefinitionDomains,
            call.resultBorrowOwnerDefinitionDomain)
        add(plan.callResultBorrowOwnerDefinitionRows,
            call.resultBorrowOwnerDefinitionRow)
        add(plan.callResultDefinitionOriginKinds,
            call.resultDefinitionOriginKind)
        add(plan.callResultDefinitionOriginIds,
            call.resultDefinitionOriginId)
        add(plan.callSourceDefinitionDomains,
            call.sourceDefinitionDomain)
        add(plan.callSourceDefinitionRows, call.sourceDefinitionRow)
        add(plan.callSemanticCallExprNodeIndexes,
            call.semanticCallExprNodeIndex)
        add(plan.callConsumeActionRows, call.consumeActionRow)
        add(plan.callManagedStoreKinds, call.managedStoreKind)
        add(plan.callRelocWordOffsets, call.relocWordOffset)
        add(plan.callTargetIsImportcs, call.targetIsImportc)
        add(plan.callInlineF64FromIntKinds, call.inlineF64FromIntKind)
        add(plan.callWholeCallF64FromIntRescues, call.wholeCallF64FromIntRescue)
        add(plan.callInlineF64FromIntUnsigneds, call.inlineF64FromIntUnsigned)
        add(plan.callArgStarts, plan.callArgSlots.len)
        add(plan.callArgCounts, call.argSlots.len)
        for argIndex in 0..<call.argSlots.len:
            add(plan.callArgSlots, call.argSlots[argIndex])
            add(plan.callArgPassKinds, call.argPassKinds[argIndex])
        add(plan.callArgAbiStarts, plan.callArgAbiSizes.len)
        add(plan.callArgAbiCounts, call.argAbiSizes.len)
        for argIndex in 0..<call.argAbiSizes.len:
            add(plan.callArgAbiSizes, call.argAbiSizes[argIndex])
    for blockIndex in 0..<fragment.blocks.len:
        let block = fragment.blocks[blockIndex]
        add(plan.blockOpStarts, block.opStart)
        add(plan.blockOpCounts, block.opCount)
        add(plan.blockTermIndices, block.termIndex)
        add(plan.blockIsFragmentExit,
            fragment.terms[block.termIndex].kind == coreir.BodyTermReturnTag)
    for termIndex in 0..<fragment.terms.len:
        let term = fragment.terms[termIndex]
        add(plan.termKinds, term.kind)
        add(plan.termConditionKinds, term.conditionKind)
        add(plan.termResultSlots, term.resultSlot)
        add(plan.termSourceDefinitionDomains,
            term.sourceDefinitionDomain)
        add(plan.termSourceDefinitionRows, term.sourceDefinitionRow)
        add(plan.termLhsSlots, term.lhsSlot)
        add(plan.termRhsSlots, term.rhsSlot)
        add(plan.termTrueBlocks, term.trueBlock)
        add(plan.termFalseBlocks, term.falseBlock)
        add(plan.termOperandStarts, plan.termOperands.len)
        add(plan.termOperandCounts, term.operands.len)
        for operandIndex in 0..<term.operands.len:
            add(plan.termOperands, term.operands[operandIndex])
    for literalIndex in 0..<fragment.cstringLiterals.len:
        let literal = fragment.cstringLiterals[literalIndex]
        add(plan.cstringTexts, share(literal.text))
        add(plan.cstringDataLabels, share(literal.dataLabel))
        add(plan.materializedCStringIds, -1)
    plan.stringPayloadBytes = nextStringPayloadBytes
    return fragmentId

fn CleanupPlanCaptureFragment(plan: var CleanupPlan,
                              fragment: var coreir.BodyIR): int32 =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    delta.resultId = cleanupCfgStageCaptureFragment(planCandidate,
                                                     fragment)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)
    return delta.resultId

fn cleanupCfgStageRegisterDefer(plan: var CleanupPlan,
                                declarationScopeId: int32,
                                suiteScopeId: int32,
                                lexicalOrdinal: int32,
                                activeFlagSlot: int32,
                                fragmentId: int32): int32 =
    cleanupCfgRequireRegistrationOpen(plan)
    cleanupCfgRequireScope(plan, declarationScopeId)
    cleanupCfgRequireScope(plan, suiteScopeId)
    if !cleanupCfgScopeIsAncestor(plan, declarationScopeId, suiteScopeId) ||
       declarationScopeId == suiteScopeId:
        cleanupCfgFail("cleanup_cfg: defer suite is not a child scope")
    if fragmentId < 0 || fragmentId >= plan.fragmentOpStarts.len:
        cleanupCfgFail("cleanup_cfg: defer fragment id out of range")
    if lexicalOrdinal < 0 ||
       lexicalOrdinal <= plan.scopeLastLexicalOrdinals[declarationScopeId]:
        cleanupCfgFail("cleanup_cfg: defer registration is not lexical order")
    if !plan.localSchemaBound ||
       activeFlagSlot < 0 || activeFlagSlot >= plan.localTypeKinds.len ||
       plan.localTypeKinds[activeFlagSlot] != coreir.LocalI32Tag:
        cleanupCfgFail("cleanup_cfg: defer active flag is not an i32 local")
    for deferId in 0..<plan.deferActiveFlagSlots.len:
        if plan.deferActiveFlagSlots[deferId] == activeFlagSlot:
            cleanupCfgFail("cleanup_cfg: defer active flag reused")
    if plan.deferDeclarationScopeIds.len >= plan.limits.maxDeferCount:
        cleanupCfgFail("cleanup_cfg: defer arena exhausted")
    let deferId = plan.deferDeclarationScopeIds.len
    add(plan.deferDeclarationScopeIds, declarationScopeId)
    add(plan.deferSuiteScopeIds, suiteScopeId)
    add(plan.deferLexicalOrdinals, lexicalOrdinal)
    add(plan.deferActiveFlagSlots, activeFlagSlot)
    add(plan.deferFragmentIds, fragmentId)
    add(plan.deferPreviousInScope, plan.scopeDeferHeads[declarationScopeId])
    add(plan.deferOwnershipDeferIds, -1)
    add(plan.deferOwnershipGuardProjectionCounts, 0)
    add(plan.deferSelectedExitCounts, 0)
    plan.scopeDeferHeads[declarationScopeId] = deferId
    plan.scopeLastLexicalOrdinals[declarationScopeId] = lexicalOrdinal
    return deferId

fn CleanupPlanRegisterDefer(plan: var CleanupPlan,
                            declarationScopeId: int32,
                            suiteScopeId: int32,
                            lexicalOrdinal: int32,
                            activeFlagSlot: int32,
                            fragmentId: int32): int32 =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    delta.resultId = cleanupCfgStageRegisterDefer(planCandidate,
                                                  declarationScopeId,
                                                  suiteScopeId,
                                                  lexicalOrdinal,
                                                  activeFlagSlot,
                                                  fragmentId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)
    return delta.resultId

fn cleanupCfgStageBindOwnershipDefer(plan: var CleanupPlan,
                                     deferId: int32,
                                     ownershipDeferId: int32) =
    cleanupCfgRequireRegistrationOpen(plan)
    if deferId < 0 || deferId >= plan.deferOwnershipDeferIds.len ||
       ownershipDeferId <= 0:
        cleanupCfgFail("cleanup_cfg: invalid ownership defer binding")
    if plan.deferOwnershipDeferIds[deferId] >= 0:
        cleanupCfgFail("cleanup_cfg: duplicate ownership defer binding")
    for existingDeferId in 0..<plan.deferOwnershipDeferIds.len:
        if plan.deferOwnershipDeferIds[existingDeferId] == ownershipDeferId:
            cleanupCfgFail("cleanup_cfg: ownership defer identity reused")
    plan.deferOwnershipDeferIds[deferId] = ownershipDeferId

fn CleanupPlanBindOwnershipDefer(plan: var CleanupPlan,
                                 deferId: int32,
                                 ownershipDeferId: int32) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindOwnershipDefer(planCandidate,
                                      deferId,
                                      ownershipDeferId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

@borrows
fn cleanupCfgBodyIrScopeIsAncestor(bodyIR: coreir.BodyIR,
                                   ancestorScopeId: int32,
                                   scopeId: int32): bool =
    if ancestorScopeId < 0 ||
       ancestorScopeId >= bodyIR.controlScopeParentIds.len ||
       scopeId < 0 ||
       scopeId >= bodyIR.controlScopeParentIds.len:
        cleanupCfgFail("cleanup_cfg: defer identity scope invalid")
    var current = scopeId
    while current >= 0:
        if current == ancestorScopeId:
            return true
        current = bodyIR.controlScopeParentIds[current]
    return false

@borrows
fn CleanupPlanVerifyBodyIrDeferExitIdentityBoundary(
        bodyIR: coreir.BodyIR,
        ownershipIR: var odir.OwnershipDropIr,
        ownershipEdgeId: int32,
        fromScopeId: int32,
        toScopeId: int32,
        isReturn: bool): int32 =
    if !bodyIR.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyIR) ||
       ownershipEdgeId < 0 ||
       ownershipEdgeId >= ownershipIR.edges.len ||
       fromScopeId < 0 ||
       fromScopeId >= bodyIR.controlScopeParentIds.len ||
       (!isReturn &&
        (toScopeId < 0 ||
         toScopeId >= bodyIR.controlScopeParentIds.len)) ||
       ownershipIR.deferEffects.len !=
           bodyIR.deferDeclarationScopeIds.len:
        cleanupCfgFail("cleanup_cfg: defer identity boundary invalid")
    let edge = ownershipIR.edges[ownershipEdgeId]
    if edge.edgeId != ownershipEdgeId ||
       edge.fromBlockId < 0 ||
       edge.fromBlockId >= ownershipIR.blocks.len ||
       ownershipIR.blocks[edge.fromBlockId].scopeId != fromScopeId ||
       edge.deferIdStart < 0 ||
       edge.deferIdStart > ownershipIR.edgeDeferIds.len ||
       edge.deferIdCount < 0 ||
       edge.deferIdCount >
           ownershipIR.edgeDeferIds.len - edge.deferIdStart ||
       (isReturn &&
        edge.kind != odir.OwnershipDropEdgeReturn) ||
       (!isReturn &&
        (edge.kind == odir.OwnershipDropEdgeReturn ||
         edge.toBlockId < 0 ||
         edge.toBlockId >= ownershipIR.blocks.len ||
         ownershipIR.blocks[edge.toBlockId].scopeId !=
             toScopeId)):
        cleanupCfgFail("cleanup_cfg: defer edge identity drift")
    var stopScopeId = -1
    if !isReturn:
        var commonCursor = fromScopeId
        while commonCursor >= 0 && stopScopeId < 0:
            if cleanupCfgBodyIrScopeIsAncestor(
                   bodyIR, commonCursor, toScopeId):
                stopScopeId = commonCursor
            commonCursor =
                bodyIR.controlScopeParentIds[commonCursor]
        if stopScopeId < 0:
            cleanupCfgFail(
                "cleanup_cfg: defer edge scopes lack common root")
    var expectedCount: int32
    var deferIndex =
        bodyIR.deferDeclarationScopeIds.len - 1
    while deferIndex >= 0:
        let effect = ownershipIR.deferEffects[deferIndex]
        if effect.deferId != deferIndex + 1 ||
           effect.declarationOrdinal != deferIndex ||
           effect.scopeId !=
               bodyIR.deferDeclarationScopeIds[deferIndex] ||
           effect.kind != odir.DeferEffectNoOwnership ||
           effect.placeId != -1 ||
           effect.otherPlaceId != -1:
            cleanupCfgFail(
                "cleanup_cfg: defer declaration identity drift")
        var exitsScope: bool
        var exitCursor = fromScopeId
        while exitCursor >= 0:
            if !isReturn && exitCursor == stopScopeId:
                break
            if exitCursor == effect.scopeId:
                exitsScope = true
                break
            exitCursor =
                bodyIR.controlScopeParentIds[exitCursor]
        if exitsScope:
            if expectedCount >= edge.deferIdCount ||
               ownershipIR.edgeDeferIds[
                   edge.deferIdStart + expectedCount] !=
                       effect.deferId:
                cleanupCfgFail(
                    "cleanup_cfg: defer exit LIFO identity drift")
            expectedCount = expectedCount + 1
        deferIndex = deferIndex - 1
    if expectedCount != edge.deferIdCount:
        cleanupCfgFail(
            "cleanup_cfg: defer exit inventory cardinality drift")
    return expectedCount

# [wall121] 判词富化：managed local 准入门失败时把调用域（site）与 slot
# 全列实况（kind/managedStorage/place/size/align/typeArenaTypeId）带进判
# 词，ref 句柄 local（LocalPtrTag 族）缺臂的定性不再靠外部推断。原文前缀
# 保持 grep 连续。
#
# [wall121] ref 句柄臂（契约对齐零弱化）：LocalPtrTag 槽是 BodyIR 证明
# 链在册的 8/8 指针句柄托管存储（BodyIRLocalSlotTypeArenaProof 精确
# TypeId + managedStorageKind==ManagedTag 双证，v6 实测 slot=0 kind=4
# mg=2 sz/al=8/8 tid=17），wall47 已立其为句柄权威、wall118 已给
# cheng_ref_drop_owned/cheng_ref_retain_owned drop/retain 胶权威。生产端
# 对每个未消费 OwnMove 定义无条件 AddPlace（ownership_body_ir_production
# 值定义扫描不分 kind），ref 句柄定义因此合法到达本门——缺臂是端口缺
# 项非设计排除，补臂不放宽任何既有 admit 真子集。
fn cleanupCfgRequireManagedLocal(plan: var CleanupPlan,
                                 siteTag: int32,
                                 localSlot: int32) =
    if !plan.localSchemaBound || localSlot < 0 ||
       localSlot >= plan.localTypeKinds.len ||
       localSlot >= plan.localTypeArenaTypeIds.len ||
       localSlot >= plan.localManagedStorageKinds.len ||
       localSlot >= plan.localPlaceKinds.len ||
       localSlot >= plan.localSizeBytes.len ||
       localSlot >= plan.localAlignBytes.len:
        cleanupCfgFail(Fmt"cleanup_cfg: ownership binding requires managed local site={siteTag} slot={localSlot} slots={plan.localTypeKinds.len}")
    if (plan.localTypeKinds[localSlot] != coreir.LocalStrTag &&
        plan.localTypeKinds[localSlot] != coreir.LocalAggregateTag &&
        plan.localTypeKinds[localSlot] != coreir.LocalPtrTag) ||
       plan.localManagedStorageKinds[localSlot] !=
           coreir.BodyManagedStorageManagedTag ||
       plan.localTypeArenaTypeIds[localSlot] < 0:
        cleanupCfgFail(Fmt"cleanup_cfg: ownership binding requires managed local site={siteTag} slot={localSlot} kind={plan.localTypeKinds[localSlot]} managedStorage={plan.localManagedStorageKinds[localSlot]} place={plan.localPlaceKinds[localSlot]} size={plan.localSizeBytes[localSlot]} align={plan.localAlignBytes[localSlot]} typeArenaTypeId={plan.localTypeArenaTypeIds[localSlot]} slots={plan.localTypeKinds.len}")

fn cleanupCfgStageBindOwnershipPlace(plan: var CleanupPlan,
                                     ownershipPlaceId: int32,
                                     localSlot: int32,
                                     ownershipTypeId: int32) =
    cleanupCfgRequireRegistrationOpen(plan)
    cleanupCfgRequireManagedLocal(plan, 1, localSlot)
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    let slotKind = plan.localTypeKinds[localSlot]
    let rowKind = plan.typeLayoutKinds[typeRow]
    if ownershipPlaceId <= 0 ||
       ownershipPlaceId != plan.ownershipPlaceBindingPlaceIds.len + 1 ||
       ownershipPlaceId >= plan.ownershipPlaceBindingIndexByPlaceId.len ||
       slotKind != rowKind ||
       plan.localTypeArenaTypeIds[localSlot] !=
           plan.typeLayoutTypeArenaTypeIds[typeRow] ||
       plan.localSizeBytes[localSlot] != plan.typeLayoutSizeBytes[typeRow] ||
       plan.localAlignBytes[localSlot] != plan.typeLayoutAlignBytes[typeRow]:
        cleanupCfgFail(Fmt"cleanup_cfg: ownership place id invalid place={ownershipPlaceId} places={plan.ownershipPlaceBindingPlaceIds.len} slot={localSlot} typeId={ownershipTypeId} typeRow={typeRow} slotKind={slotKind} rowKind={rowKind} slotArenaType={plan.localTypeArenaTypeIds[localSlot]} rowArenaType={plan.typeLayoutTypeArenaTypeIds[typeRow]} slotSize={plan.localSizeBytes[localSlot]} rowSize={plan.typeLayoutSizeBytes[typeRow]} slotAlign={plan.localAlignBytes[localSlot]} rowAlign={plan.typeLayoutAlignBytes[typeRow]}")
    if plan.ownershipPlaceBindingIndexByPlaceId[ownershipPlaceId] >= 0:
        cleanupCfgFail("cleanup_cfg: duplicate ownership place binding")
    if plan.ownershipPlaceBindingPlaceIds.len >=
       plan.limits.maxOwnershipPlaceBindingCount:
        cleanupCfgFail("cleanup_cfg: ownership place binding arena exhausted")
    let fieldCount = plan.typeLayoutProjectionCounts[typeRow]
    let fieldIndexRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipFieldProjectionStepCount,
        plan.ownershipFieldBindingIndexByPlaceField.len,
        "cleanup_cfg: ownership field dense-index capacity underflow")
    if fieldCount > fieldIndexRemaining:
        cleanupCfgFail("cleanup_cfg: ownership field dense-index arena exhausted")
    let bindingIndex = plan.ownershipPlaceBindingPlaceIds.len
    let fieldStart = plan.ownershipFieldBindingIndexByPlaceField.len
    add(plan.ownershipPlaceBindingPlaceIds, ownershipPlaceId)
    add(plan.ownershipPlaceBindingLocalSlots, localSlot)
    add(plan.ownershipPlaceBindingTypeIds, ownershipTypeId)
    add(plan.ownershipPlaceBindingLayoutCids, strings.CloneStr(plan.typeLayoutCids[typeRow]))
    add(plan.ownershipPlaceFieldIndexStarts, fieldStart)
    add(plan.ownershipPlaceFieldIndexCounts, fieldCount)
    for _ in 0..<fieldCount:
        add(plan.ownershipFieldBindingIndexByPlaceField, -1)
    plan.ownershipPlaceBindingIndexByPlaceId[ownershipPlaceId] = bindingIndex

fn CleanupPlanBindOwnershipPlace(plan: var CleanupPlan,
                                 ownershipPlaceId: int32,
                                 localSlot: int32,
                                 ownershipTypeId: int32) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindOwnershipPlace(planCandidate,
                                      ownershipPlaceId,
                                      localSlot,
                                      ownershipTypeId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn cleanupCfgPlanMutationCapacityBytes(plan: var CleanupPlan): int64 =
    if !plan.prepared || plan.released:
        return int64(0)
    return cleanupCfgLimitsCapacityBytes(plan.limits)

fn cleanupCfgBeginPlanMutation(plan: var CleanupPlan,
                               planCandidate: var CleanupPlan,
                               delta: var CleanupMutationDelta) =
    if delta.hasPlan || delta.hasBody || delta.planOwnerMoved ||
       delta.bodyOwnerMoved || delta.validated:
        cleanupCfgFail("cleanup_cfg: mutation delta already active")
    planCandidate = plan
    var cleared: CleanupPlan
    plan = cleared
    delta.hasPlan = true
    delta.planOwnerMoved = true
    delta.baselinePlanCapacityBytes =
        cleanupCfgPlanMutationCapacityBytes(planCandidate)
    delta.baselineIndependentStackHighWater =
        planCandidate.independentStackHighWater
    delta.baselineIndependentStackHighWaterReady =
        planCandidate.independentStackHighWaterReady
    delta.baselineCapturedStackAllocationCount =
        planCandidate.capturedStackAllocationCount
    delta.baselineTypeLayoutResolveVisitCount =
        planCandidate.typeLayoutResolveVisitCount
    delta.baselineBindingLookupVisitCount =
        planCandidate.bindingLookupVisitCount
    delta.baselineTransitionIndexVisitCount =
        planCandidate.transitionIndexVisitCount
    delta.baselineTransitionRangeVisitCount =
        planCandidate.transitionRangeVisitCount
    delta.baselineFieldDedupVisitCount =
        planCandidate.fieldDedupVisitCount
    delta.baselineTransitionIndexBound =
        planCandidate.ownershipTransitionIndexBound
    delta.baselineTransitionIndexOpCount =
        planCandidate.ownershipTransitionIndexOpCount
    delta.baselineTransitionIndexEdgeCount =
        planCandidate.ownershipTransitionIndexEdgeCount
    delta.baselineTransitionIndexFlagCount =
        planCandidate.ownershipTransitionIndexFlagCount
    delta.baselineTransitionIndexTransitionCount =
        planCandidate.ownershipTransitionIndexTransitionCount
    delta.baselineTransitionOpStartsLen =
        planCandidate.ownershipTransitionOpStarts.len
    delta.baselineTransitionOpCountsLen =
        planCandidate.ownershipTransitionOpCounts.len
    delta.baselineTransitionEdgeStartsLen =
        planCandidate.ownershipTransitionEdgeStarts.len
    delta.baselineTransitionEdgeCountsLen =
        planCandidate.ownershipTransitionEdgeCounts.len
    delta.baselineTransitionRowsLen =
        planCandidate.ownershipTransitionRows.len

fn cleanupCfgBeginBodyPlanMutation(bodyIR: var coreir.BodyIR,
                                   plan: var CleanupPlan,
                                   bodyCandidate: var coreir.BodyIR,
                                   planCandidate: var CleanupPlan,
                                   delta: var CleanupMutationDelta) =
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    bodyCandidate = bodyIR
    # wall69: 原写法 bodyIR = coreir.BodyIRNew() 经 sret→memcpy→drop(temp) 物化,
    # 与上一行 move 源失效 drop 叠加, 对同一批托管字段多减一次 rc——ops 候选
    # 缓冲在 stage 开始前即被提前释放, 后续 NewStringCopy 分配复用清零即
    # 「initialized producer definition drift」全零行 (cold_nested UAF 实证)。
    # 原地构造是纯覆盖 store, 无 rc 操作, move 语义完整保留。
    coreir.BodyIRInitNewInPlace(bodyIR)
    delta.hasBody = true
    delta.bodyOwnerMoved = true

fn cleanupCfgSealPlanMutation(
        planCandidate: var CleanupPlan,
        delta: var CleanupMutationDelta) =
    if !delta.hasPlan || delta.hasBody || !delta.planOwnerMoved ||
       delta.bodyOwnerMoved || delta.validated:
        cleanupCfgFail("cleanup_cfg: plan mutation seal contract")
    let currentPlanBytes = cleanupCfgPlanMutationCapacityBytes(
        planCandidate)
    delta.candidateLogicalBytes = currentPlanBytes
    if delta.baselinePlanCapacityBytes > delta.candidateLogicalBytes:
        delta.candidateLogicalBytes = delta.baselinePlanCapacityBytes
    if planCandidate.prepared && !planCandidate.released &&
       delta.candidateLogicalBytes >
       planCandidate.mutationCandidatePeakBytes:
        planCandidate.mutationCandidatePeakBytes =
            delta.candidateLogicalBytes
    planCandidate.mutationOwnerMoveCount = cleanupCfgCheckedAdd(
        planCandidate.mutationOwnerMoveCount,
        1,
        "cleanup_cfg: mutation owner move count overflow")
    delta.validated = true

fn cleanupCfgSealBodyPlanMutation(
        bodyCandidate: var coreir.BodyIR,
        planCandidate: var CleanupPlan,
        delta: var CleanupMutationDelta) =
    if !delta.hasPlan || !delta.hasBody || !delta.planOwnerMoved ||
       !delta.bodyOwnerMoved || delta.validated:
        cleanupCfgFail("cleanup_cfg: body-plan mutation seal contract")
    if !bodyCandidate.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyCandidate):
        cleanupCfgFail(
            "cleanup_cfg: body-plan mutation control flow not sealed")
    let currentPlanBytes = cleanupCfgPlanMutationCapacityBytes(
        planCandidate)
    var planBytes = currentPlanBytes
    if delta.baselinePlanCapacityBytes > planBytes:
        planBytes = delta.baselinePlanCapacityBytes
    delta.candidateLogicalBytes = cleanupCfgCheckedAdd64(
        planBytes,
        coreir.BodyIRFlatSoAReserveCapacityBytes(bodyCandidate),
        "cleanup_cfg: mutation candidate logical byte overflow")
    if planCandidate.prepared && !planCandidate.released &&
       delta.candidateLogicalBytes >
       planCandidate.mutationCandidatePeakBytes:
        planCandidate.mutationCandidatePeakBytes =
            delta.candidateLogicalBytes
    if planCandidate.prepared && !planCandidate.released:
        planCandidate.mutationOwnerMoveCount = cleanupCfgCheckedAdd(
            planCandidate.mutationOwnerMoveCount,
            1,
            "cleanup_cfg: mutation owner move count overflow")
    else:
        delta.report.mutationOwnerMoveCount = cleanupCfgCheckedAdd(
            delta.report.mutationOwnerMoveCount,
            1,
            "cleanup_cfg: mutation owner move count overflow")
    delta.validated = true

fn cleanupCfgRollbackBodyPlanMutation(bodyIR: var coreir.BodyIR,
                                      plan: var CleanupPlan,
                                      bodyCandidate: coreir.BodyIR,
                                      planCandidate: CleanupPlan,
                                      delta: var CleanupMutationDelta) =
    if delta.validated || !delta.hasBody || !delta.hasPlan ||
       !delta.bodyOwnerMoved || !delta.planOwnerMoved:
        cleanupCfgFail("cleanup_cfg: body-plan rollback contract")
    # Rejected transaction segment: restore the two owners only.
    bodyIR = bodyCandidate
    plan = planCandidate

fn cleanupCfgRestorePreflightMutation(
        plan: var CleanupPlan,
        delta: var CleanupMutationDelta) =
    plan.independentStackHighWater =
        delta.baselineIndependentStackHighWater
    plan.independentStackHighWaterReady =
        delta.baselineIndependentStackHighWaterReady
    plan.capturedStackAllocationCount =
        delta.baselineCapturedStackAllocationCount
    plan.typeLayoutResolveVisitCount =
        delta.baselineTypeLayoutResolveVisitCount
    plan.bindingLookupVisitCount =
        delta.baselineBindingLookupVisitCount
    plan.transitionIndexVisitCount =
        delta.baselineTransitionIndexVisitCount
    plan.transitionRangeVisitCount =
        delta.baselineTransitionRangeVisitCount
    plan.fieldDedupVisitCount = delta.baselineFieldDedupVisitCount
    plan.ownershipTransitionIndexBound =
        delta.baselineTransitionIndexBound
    plan.ownershipTransitionIndexOpCount =
        delta.baselineTransitionIndexOpCount
    plan.ownershipTransitionIndexEdgeCount =
        delta.baselineTransitionIndexEdgeCount
    plan.ownershipTransitionIndexFlagCount =
        delta.baselineTransitionIndexFlagCount
    plan.ownershipTransitionIndexTransitionCount =
        delta.baselineTransitionIndexTransitionCount
    setLen(plan.ownershipTransitionOpStarts,
           delta.baselineTransitionOpStartsLen)
    setLen(plan.ownershipTransitionOpCounts,
           delta.baselineTransitionOpCountsLen)
    setLen(plan.ownershipTransitionEdgeStarts,
           delta.baselineTransitionEdgeStartsLen)
    setLen(plan.ownershipTransitionEdgeCounts,
           delta.baselineTransitionEdgeCountsLen)
    setLen(plan.ownershipTransitionRows,
           delta.baselineTransitionRowsLen)

fn cleanupCfgCommitBodyPlanMutation(bodyIR: var coreir.BodyIR,
                                    plan: var CleanupPlan,
                                    bodyCandidate: coreir.BodyIR,
                                    planCandidate: CleanupPlan,
                                    delta: var CleanupMutationDelta) =
    if !delta.validated || !delta.hasBody || !delta.hasPlan ||
       !delta.bodyOwnerMoved || !delta.planOwnerMoved:
        cleanupCfgFail("cleanup_cfg: unvalidated body-plan commit")
    # Validated commit segment: owner moves only.
    bodyIR = bodyCandidate
    plan = planCandidate

fn cleanupCfgCommitPlanMutation(plan: var CleanupPlan,
                                planCandidate: CleanupPlan,
                                delta: var CleanupMutationDelta) =
    if !delta.validated || !delta.hasPlan || delta.hasBody ||
       !delta.planOwnerMoved || delta.bodyOwnerMoved:
        cleanupCfgFail("cleanup_cfg: unvalidated plan commit")
    # Validated commit segment: owner move only.
    plan = planCandidate

fn cleanupCfgStageOwnershipFieldProjection(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipPlaceId: int32,
        fieldOrdinal: int32): int32 =
    cleanupCfgRequireRegistrationOpen(plan)
    if ownershipPlaceId <= 0 ||
       ownershipPlaceId >= plan.ownershipPlaceBindingIndexByPlaceId.len:
        cleanupCfgFail("cleanup_cfg: ownership field id invalid")
    let placeBinding = plan.ownershipPlaceBindingIndexByPlaceId[
        ownershipPlaceId]
    if placeBinding < 0 ||
       placeBinding >= plan.ownershipPlaceBindingPlaceIds.len:
        cleanupCfgFail("cleanup_cfg: ownership place binding missing")
    let aggregateBaseSlot =
        plan.ownershipPlaceBindingLocalSlots[placeBinding]
    let ownershipTypeId = plan.ownershipPlaceBindingTypeIds[placeBinding]
    let ownerTypeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    let projectionRow = cleanupCfgPlanProjectionRow(plan,
                                                     ownershipTypeId,
                                                     fieldOrdinal)
    let stepStart = plan.typeLayoutProjectionPathStarts[projectionRow]
    let stepCount = plan.typeLayoutProjectionPathCounts[projectionRow]
    let fieldDomainStart = plan.ownershipPlaceFieldIndexStarts[placeBinding]
    let fieldDomainCount = plan.ownershipPlaceFieldIndexCounts[placeBinding]
    if fieldOrdinal < 0 || fieldOrdinal >= fieldDomainCount ||
       aggregateBaseSlot < 0 ||
       aggregateBaseSlot >= plan.localTypeKinds.len ||
       aggregateBaseSlot >= bodyIR.localSlots.len || stepStart < 0 ||
       stepCount <= 0 ||
       cleanupCfgCheckedAdd(
           stepStart,
           stepCount,
           "cleanup_cfg: ownership field path range overflow") >
           plan.typeLayoutProjectionPathOrdinals.len:
        cleanupCfgFail("cleanup_cfg: ownership field projection shape invalid")
    let denseFieldRow = cleanupCfgCheckedAdd(
        fieldDomainStart,
        fieldOrdinal,
        "cleanup_cfg: ownership field dense-index overflow")
    if denseFieldRow < 0 ||
       denseFieldRow >= plan.ownershipFieldBindingIndexByPlaceField.len ||
       plan.ownershipFieldBindingIndexByPlaceField[denseFieldRow] >= 0:
        cleanupCfgFail("cleanup_cfg: duplicate ownership field binding")
    let base = bodyIR.localSlots[aggregateBaseSlot]
    if plan.localTypeKinds[aggregateBaseSlot] != coreir.LocalAggregateTag ||
       base.typeKind != coreir.LocalAggregateTag ||
       base.placeKind != coreir.BodyPlaceStackValueTag ||
       base.stackOffset < 0 || base.sizeBytes <= 0 ||
       base.sizeBytes != plan.typeLayoutSizeBytes[ownerTypeRow] ||
       base.alignBytes != plan.typeLayoutAlignBytes[ownerTypeRow]:
        cleanupCfgFail("cleanup_cfg: ownership field base layout invalid")
    if plan.ownershipFieldBindingPlaceIds.len >=
       plan.limits.maxOwnershipFieldBindingCount:
        cleanupCfgFail("cleanup_cfg: ownership field binding arena exhausted")
    let stepRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipFieldProjectionStepCount,
        plan.ownershipFieldProjectionOrdinals.len,
        "cleanup_cfg: ownership field projection capacity underflow")
    if stepCount > stepRemaining:
        cleanupCfgFail("cleanup_cfg: ownership field projection arena exhausted")
    if bodyIR.localSlots.len >= plan.limits.maxLocalSlotCount:
        cleanupCfgFail("cleanup_cfg: ownership field projection local exhausted")
    var currentTypeId = ownershipTypeId
    var currentContainerSize = base.sizeBytes
    var cumulativeOffset: int32
    for stepIndex in 0..<stepCount:
        let pathRow = cleanupCfgCheckedAdd(
            stepStart,
            stepIndex,
            "cleanup_cfg: ownership field path row overflow")
        let pathOrdinal =
            plan.typeLayoutProjectionPathOrdinals[pathRow]
        let physicalFieldRow = cleanupCfgPlanPhysicalFieldRow(
            plan,
            currentTypeId,
            pathOrdinal)
        let childTypeId =
            plan.typeLayoutPhysicalFieldTypeIds[physicalFieldRow]
        let childTypeRow = cleanupCfgPlanTypeLayoutRow(plan, childTypeId)
        let byteOffset =
            plan.typeLayoutPhysicalFieldByteOffsets[physicalFieldRow]
        let fieldSize = plan.typeLayoutSizeBytes[childTypeRow]
        let fieldAlign = plan.typeLayoutAlignBytes[childTypeRow]
        let fieldKind = plan.typeLayoutKinds[childTypeRow]
        if plan.typeLayoutPhysicalFieldOwnerTypeIds[physicalFieldRow] !=
               currentTypeId ||
           plan.typeLayoutPhysicalFieldOrdinals[physicalFieldRow] !=
               pathOrdinal || fieldSize > currentContainerSize ||
           byteOffset > cleanupCfgCheckedSub(
               currentContainerSize,
               fieldSize,
               "cleanup_cfg: ownership field layout underflow"):
            cleanupCfgFail("cleanup_cfg: ownership field projection layout invalid")
        if cleanupCfgCheckedAdd(
               stepIndex,
               1,
               "cleanup_cfg: ownership field step overflow") < stepCount &&
           fieldKind != coreir.LocalAggregateTag:
            cleanupCfgFail("cleanup_cfg: ownership field projection path crosses scalar")
        cumulativeOffset = cleanupCfgCheckedAdd(
            cumulativeOffset,
            byteOffset,
            "cleanup_cfg: ownership field projection offset overflow")
        if cumulativeOffset > cleanupCfgCheckedSub(
               base.sizeBytes,
               fieldSize,
               "cleanup_cfg: ownership field base layout underflow"):
            cleanupCfgFail("cleanup_cfg: ownership field projection escapes base")
        currentContainerSize = fieldSize
        currentTypeId = childTypeId
        plan.typeLayoutResolveVisitCount = cleanupCfgCheckedAdd(
            plan.typeLayoutResolveVisitCount,
            1,
            "cleanup_cfg: type layout visit counter overflow")

    let projectionStackOffset = cleanupCfgCheckedAdd(
        base.stackOffset,
        cumulativeOffset,
        "cleanup_cfg: ownership field projection stack offset overflow")

    let projectionSlot = bodyIR.localSlots.len
    let leafTypeRow = cleanupCfgPlanTypeLayoutRow(plan, currentTypeId)
    var projection: coreir.LocalSlot
    projection.id = projectionSlot
    projection.name = Fmt"#cleanup_field_projection#{ownershipPlaceId}#{fieldOrdinal}"
    projection.typeKind = plan.typeLayoutKinds[leafTypeRow]
    projection.placeKind = coreir.BodyPlaceBorrowAddressTag
    projection.stackOffset = projectionStackOffset
    projection.sizeBytes = plan.typeLayoutSizeBytes[leafTypeRow]
    projection.alignBytes = plan.typeLayoutAlignBytes[leafTypeRow]
    projection.auxValue = aggregateBaseSlot
    projection.ownership = coreir.OwnPlain
    projection.aliasClass = coreir.AliasUnknown
    projection.escapeKind = coreir.EscapeNone
    projection.noAlias = false
    projection.typeArenaTypeId =
        plan.typeLayoutTypeArenaTypeIds[leafTypeRow]
    projection.managedStorageKind =
        coreir.BodyManagedStorageManagedTag

    let bindingStepStart = plan.ownershipFieldProjectionOrdinals.len
    let bindingIndex = plan.ownershipFieldBindingPlaceIds.len
    add(plan.ownershipFieldBindingPlaceIds, ownershipPlaceId)
    add(plan.ownershipFieldBindingOrdinals, fieldOrdinal)
    add(plan.ownershipFieldBindingBaseSlots, aggregateBaseSlot)
    add(plan.ownershipFieldBindingProjectionSlots, projectionSlot)
    add(plan.ownershipFieldBindingStepStarts, bindingStepStart)
    add(plan.ownershipFieldBindingStepCounts, stepCount)
    add(plan.ownershipFieldBindingCapturedActionIds, 0)
    add(plan.ownershipFieldBindingOwnerTypeIds, ownershipTypeId)
    add(plan.ownershipFieldBindingOwnerLayoutCids, strings.CloneStr(plan.typeLayoutCids[ownerTypeRow]))
    add(plan.ownershipFieldBindingLeafTypeIds, currentTypeId)
    add(plan.ownershipFieldBindingLeafLayoutCids, strings.CloneStr(plan.typeLayoutCids[leafTypeRow]))
    currentTypeId = ownershipTypeId
    currentContainerSize = base.sizeBytes
    for stepIndex in 0..<stepCount:
        let pathRow = cleanupCfgCheckedAdd(
            stepStart,
            stepIndex,
            "cleanup_cfg: ownership field path row overflow")
        let pathOrdinal =
            plan.typeLayoutProjectionPathOrdinals[pathRow]
        let physicalFieldRow = cleanupCfgPlanPhysicalFieldRow(
            plan,
            currentTypeId,
            pathOrdinal)
        let childTypeId =
            plan.typeLayoutPhysicalFieldTypeIds[physicalFieldRow]
        let childTypeRow = cleanupCfgPlanTypeLayoutRow(plan, childTypeId)
        add(plan.ownershipFieldProjectionOrdinals, pathOrdinal)
        add(plan.ownershipFieldProjectionByteOffsets,
            plan.typeLayoutPhysicalFieldByteOffsets[physicalFieldRow])
        add(plan.ownershipFieldProjectionContainerSizes,
            currentContainerSize)
        add(plan.ownershipFieldProjectionTypeKinds,
            plan.typeLayoutKinds[childTypeRow])
        add(plan.ownershipFieldProjectionSizeBytes,
            plan.typeLayoutSizeBytes[childTypeRow])
        add(plan.ownershipFieldProjectionAlignBytes,
            plan.typeLayoutAlignBytes[childTypeRow])
        add(plan.ownershipFieldProjectionTypeIds, childTypeId)
        add(plan.ownershipFieldProjectionLayoutCids, strings.CloneStr(plan.typeLayoutCids[childTypeRow]))
        currentTypeId = childTypeId
        currentContainerSize = plan.typeLayoutSizeBytes[childTypeRow]
    let projectionTypeKind = projection.typeKind
    let projectionTypeArenaTypeId = projection.typeArenaTypeId
    let projectionManagedStorageKind = projection.managedStorageKind
    let projectionPlaceKind = projection.placeKind
    let projectionSizeBytes = projection.sizeBytes
    let projectionAlignBytes = projection.alignBytes
    add(bodyIR.localSlots, projection)
    coreir.BodyIREntryDefinitionOwnershipAppendSyntheticSlot(
        bodyIR, projectionSlot)
    add(plan.localTypeKinds, projectionTypeKind)
    add(plan.localTypeArenaTypeIds, projectionTypeArenaTypeId)
    add(plan.localManagedStorageKinds, projectionManagedStorageKind)
    add(plan.localPlaceKinds, projectionPlaceKind)
    add(plan.localSizeBytes, projectionSizeBytes)
    add(plan.localAlignBytes, projectionAlignBytes)
    plan.ownershipFieldBindingIndexByPlaceField[denseFieldRow] =
        bindingIndex
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return projectionSlot

fn CleanupPlanBindOwnershipFieldProjection(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipPlaceId: int32,
        fieldOrdinal: int32): int32 =
    var delta: CleanupMutationDelta
    var bodyCandidate: coreir.BodyIR
    var planCandidate: CleanupPlan
    cleanupCfgBeginBodyPlanMutation(bodyIR,
                                    plan,
                                    bodyCandidate,
                                    planCandidate,
                                    delta)
    delta.resultId = cleanupCfgStageOwnershipFieldProjection(
        planCandidate,
        bodyCandidate,
        ownershipPlaceId,
        fieldOrdinal)
    cleanupCfgRequireLocalSchema(planCandidate, bodyCandidate)
    cleanupCfgValidateFieldProjectionContracts(planCandidate,
                                                bodyCandidate)
    cleanupCfgValidatePhysicalStackIntervals(bodyCandidate,
                                             planCandidate)
    cleanupCfgSealBodyPlanMutation(bodyCandidate, planCandidate, delta)
    cleanupCfgCommitBodyPlanMutation(bodyIR,
                                     plan,
                                     bodyCandidate,
                                     planCandidate,
                                     delta)
    return delta.resultId

fn cleanupCfgStageBindOwnershipDropGlue(
        plan: var CleanupPlan,
        dropGlueId: int32,
        ownershipTypeId: int32,
        dropGlueSymbol: str) =
    cleanupCfgRequireRegistrationOpen(plan)
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    if dropGlueId <= 0 ||
       dropGlueId >= plan.ownershipDropGlueBindingIndexByGlueId.len ||
       len(dropGlueSymbol) == 0:
        cleanupCfgFail("cleanup_cfg: ownership drop glue binding invalid")
    if plan.ownershipDropGlueBindingIndexByGlueId[dropGlueId] >= 0:
        cleanupCfgFail("cleanup_cfg: duplicate ownership drop glue binding")
    if plan.ownershipDropGlueBindingGlueIds.len >=
       plan.limits.maxOwnershipDropGlueBindingCount:
        cleanupCfgFail("cleanup_cfg: ownership drop glue arena exhausted")
    let nextStringPayloadBytes = cleanupCfgCheckedAdd(
        plan.stringPayloadBytes,
        len(dropGlueSymbol),
        "cleanup_cfg: ownership drop glue string byte overflow")
    if nextStringPayloadBytes > plan.limits.maxStringPayloadBytes:
        cleanupCfgFail("cleanup_cfg: ownership drop glue string arena exhausted")
    let bindingIndex = plan.ownershipDropGlueBindingGlueIds.len
    add(plan.ownershipDropGlueBindingGlueIds, dropGlueId)
    add(plan.ownershipDropGlueBindingSymbols, dropGlueSymbol)
    add(plan.ownershipDropGlueBindingTypeIds, ownershipTypeId)
    add(plan.ownershipDropGlueBindingLayoutCids, strings.CloneStr(plan.typeLayoutCids[typeRow]))
    plan.ownershipDropGlueBindingIndexByGlueId[dropGlueId] = bindingIndex
    plan.stringPayloadBytes = nextStringPayloadBytes

fn CleanupPlanBindOwnershipDropGlue(plan: var CleanupPlan,
                                    dropGlueId: int32,
                                    ownershipTypeId: int32,
                                    dropGlueSymbol: str) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindOwnershipDropGlue(planCandidate,
                                         dropGlueId,
                                         ownershipTypeId,
                                         dropGlueSymbol)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn cleanupCfgStageBindOwnershipRetainGlue(
        plan: var CleanupPlan,
        ownershipTypeId: int32,
        retainGlueSymbol: str) =
    cleanupCfgRequireRegistrationOpen(plan)
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    if ownershipTypeId <= 0 ||
       ownershipTypeId >= plan.ownershipRetainGlueBindingIndexByTypeId.len ||
       len(retainGlueSymbol) == 0:
        cleanupCfgFail("cleanup_cfg: ownership retain glue binding invalid")
    if plan.ownershipRetainGlueBindingIndexByTypeId[ownershipTypeId] >= 0:
        cleanupCfgFail("cleanup_cfg: duplicate ownership retain glue binding")
    if plan.ownershipRetainGlueBindingTypeIds.len >=
       plan.limits.maxOwnershipDropGlueBindingCount:
        cleanupCfgFail("cleanup_cfg: ownership retain glue arena exhausted")
    let nextStringPayloadBytes = cleanupCfgCheckedAdd(
        plan.stringPayloadBytes,
        len(retainGlueSymbol),
        "cleanup_cfg: ownership retain glue string byte overflow")
    if nextStringPayloadBytes > plan.limits.maxStringPayloadBytes:
        cleanupCfgFail("cleanup_cfg: ownership retain glue string arena exhausted")
    let bindingIndex = plan.ownershipRetainGlueBindingTypeIds.len
    add(plan.ownershipRetainGlueBindingTypeIds, ownershipTypeId)
    add(plan.ownershipRetainGlueBindingSymbols, retainGlueSymbol)
    add(plan.ownershipRetainGlueBindingLayoutCids, strings.CloneStr(plan.typeLayoutCids[typeRow]))
    plan.ownershipRetainGlueBindingIndexByTypeId[ownershipTypeId] =
        bindingIndex
    plan.stringPayloadBytes = nextStringPayloadBytes

fn CleanupPlanBindOwnershipRetainGlue(plan: var CleanupPlan,
                                      ownershipTypeId: int32,
                                      retainGlueSymbol: str) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindOwnershipRetainGlue(planCandidate,
                                           ownershipTypeId,
                                           retainGlueSymbol)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn cleanupCfgStageBindOwnershipConditionFlag(
        plan: var CleanupPlan,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipFlagId: int32,
        localSlot: int32) =
    cleanupCfgRequireRegistrationOpen(plan)
    if ownershipFlagId <= 0 || !plan.localSchemaBound || localSlot < 0 ||
       localSlot >= plan.localTypeKinds.len ||
       plan.localTypeKinds[localSlot] != coreir.LocalI32Tag ||
       ownershipFlagId >= plan.ownershipConditionLocalByFlagId.len:
        cleanupCfgFail("cleanup_cfg: ownership condition flag binding invalid")
    let flag = odir.OwnershipDropAnalysisConditionFlag(ownershipAnalysis,
                                                        ownershipFlagId)
    if flag.kind == odir.ConditionFlagDeferActive:
        cleanupCfgFail("cleanup_cfg: defer flag must use ownership defer binding")
    for deferId in 0..<plan.deferActiveFlagSlots.len:
        if plan.deferActiveFlagSlots[deferId] == localSlot:
            cleanupCfgFail("cleanup_cfg: ownership condition flag aliases defer flag")
    if plan.ownershipConditionLocalByFlagId[ownershipFlagId] >= 0:
        cleanupCfgFail("cleanup_cfg: duplicate ownership condition flag binding")
    if plan.ownershipConditionFlagIdByLocalSlot[localSlot] >= 0:
        cleanupCfgFail("cleanup_cfg: ownership condition flag local reused")
    if plan.ownershipConditionFlagBindingFlagIds.len >=
       plan.limits.maxOwnershipConditionFlagBindingCount:
        cleanupCfgFail("cleanup_cfg: ownership condition flag arena exhausted")
    add(plan.ownershipConditionFlagBindingFlagIds, ownershipFlagId)
    add(plan.ownershipConditionFlagBindingLocalSlots, localSlot)
    add(plan.ownershipConditionFlagBindingInitialValues, flag.initialValue)
    plan.ownershipConditionLocalByFlagId[ownershipFlagId] = localSlot
    plan.ownershipConditionFlagIdByLocalSlot[localSlot] = ownershipFlagId

fn CleanupPlanBindOwnershipConditionFlag(
        plan: var CleanupPlan,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipFlagId: int32,
        localSlot: int32) =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    cleanupCfgStageBindOwnershipConditionFlag(planCandidate,
                                              ownershipAnalysis,
                                              ownershipFlagId,
                                              localSlot)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)

fn CleanupPlanActivationOp(plan: var CleanupPlan,
                           deferId: int32): coreir.BodyOp =
    cleanupCfgRequireBuilding(plan)
    if deferId < 0 || deferId >= plan.deferActiveFlagSlots.len:
        cleanupCfgFail("cleanup_cfg: activation defer id out of range")
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpLoadConstTag
    op.target = plan.deferActiveFlagSlots[deferId]
    add(op.operands, coreir.LocalI32Tag)
    add(op.operands, 1)
    return op

fn cleanupCfgExitKindKnown(kind: odir.OwnershipDropEdgeKind): bool =
    return kind == odir.OwnershipDropEdgeNormal ||
           kind == odir.OwnershipDropEdgeReturn ||
           kind == odir.OwnershipDropEdgeBreak ||
           kind == odir.OwnershipDropEdgeContinue ||
           kind == odir.OwnershipDropEdgeLoopBack

fn cleanupCfgCommonScopePreflight(plan: var CleanupPlan,
                                  fromScopeId: int32,
                                  toScopeId: int32,
                                  parentStepCountOut: var int32): int32 =
    cleanupCfgRequireScope(plan, fromScopeId)
    cleanupCfgRequireScope(plan, toScopeId)
    var lhs = fromScopeId
    var rhs = toScopeId
    while plan.scopeDepths[lhs] > plan.scopeDepths[rhs]:
        lhs = plan.scopeParentIds[lhs]
        parentStepCountOut = cleanupCfgCheckedAdd(
            parentStepCountOut,
            1,
            "cleanup_cfg: scope preflight counter overflow")
    while plan.scopeDepths[rhs] > plan.scopeDepths[lhs]:
        rhs = plan.scopeParentIds[rhs]
        parentStepCountOut = cleanupCfgCheckedAdd(
            parentStepCountOut,
            1,
            "cleanup_cfg: scope preflight counter overflow")
    while lhs != rhs:
        lhs = plan.scopeParentIds[lhs]
        rhs = plan.scopeParentIds[rhs]
        parentStepCountOut = cleanupCfgCheckedAdd(
            parentStepCountOut,
            2,
            "cleanup_cfg: scope preflight counter overflow")
    return lhs

fn cleanupCfgAccumulateSelectedDeferDelta(
        plan: var CleanupPlan,
        deferId: int32,
        preflight: var cleanupExitPreflight) =
    for selectedIndex in 0..<preflight.selectedDeferIds.len:
        let selectedId = preflight.selectedDeferIds[selectedIndex]
        if selectedId == deferId:
            cleanupCfgFail("cleanup_cfg: selected defer appears twice")
    add(preflight.selectedDeferIds, deferId)
    add(preflight.selectedDeferNextCounts,
        cleanupCfgCheckedAdd(
            plan.deferSelectedExitCounts[deferId],
            1,
            "cleanup_cfg: selected defer exit count overflow"))
    let fragmentId = plan.deferFragmentIds[deferId]
    let opDelta = cleanupCfgCheckedAdd(plan.fragmentOpCounts[fragmentId],
                                       1,
                                       "cleanup_cfg: defer op delta overflow")
    preflight.materializedOpDelta = cleanupCfgCheckedAdd(
        preflight.materializedOpDelta,
        opDelta,
        "cleanup_cfg: defer op preflight overflow")
    let operandDelta = cleanupCfgCheckedAdd(
        plan.fragmentOperandCounts[fragmentId],
        2,
        "cleanup_cfg: defer operand delta overflow")
    preflight.materializedOperandDelta = cleanupCfgCheckedAdd(
        preflight.materializedOperandDelta,
        operandDelta,
        "cleanup_cfg: defer operand preflight overflow")
    preflight.materializedCallDelta = cleanupCfgCheckedAdd(
        preflight.materializedCallDelta,
        plan.fragmentCallCounts[fragmentId],
        "cleanup_cfg: defer call preflight overflow")
    let callArgDelta = cleanupCfgCheckedAdd(
        plan.fragmentCallArgCounts[fragmentId],
        plan.fragmentCallArgAbiCounts[fragmentId],
        "cleanup_cfg: defer call arg delta overflow")
    preflight.materializedCallArgDelta = cleanupCfgCheckedAdd(
        preflight.materializedCallArgDelta,
        callArgDelta,
        "cleanup_cfg: defer call arg preflight overflow")
    let blockDelta = cleanupCfgCheckedAdd(plan.fragmentBlockCounts[fragmentId],
                                          2,
                                          "cleanup_cfg: defer block delta overflow")
    preflight.materializedBlockDelta = cleanupCfgCheckedAdd(
        preflight.materializedBlockDelta,
        blockDelta,
        "cleanup_cfg: defer block preflight overflow")
    preflight.materializedTermDelta = cleanupCfgCheckedAdd(
        preflight.materializedTermDelta,
        blockDelta,
        "cleanup_cfg: defer term preflight overflow")
    preflight.materializedTermOperandDelta = cleanupCfgCheckedAdd(
        preflight.materializedTermOperandDelta,
        plan.fragmentTermOperandCounts[fragmentId],
        "cleanup_cfg: defer term operand preflight overflow")

fn cleanupCfgRequireMaterializedPreflight(
        plan: var CleanupPlan,
        preflight: var cleanupExitPreflight) =
    let sourceLocalCount = cleanupCfgCheckedAdd(
        plan.localTypeKinds.len,
        preflight.sourcePreparationLocalDelta,
        "cleanup_cfg: source preparation local preflight overflow")
    let plannedLocalCount = cleanupCfgCheckedAdd(
        plan.plannedMaterializedLocalCount,
        preflight.materializedLocalDelta,
        "cleanup_cfg: materialized local preflight overflow")
    let totalLocalCount = cleanupCfgCheckedAdd(
        sourceLocalCount,
        plannedLocalCount,
        "cleanup_cfg: total local preflight overflow")
    let opBase = cleanupCfgCheckedAdd(
        plan.plannedMaterializedOpCount,
        preflight.initializerOpDelta,
        "cleanup_cfg: materialized op preflight overflow")
    let opCount = cleanupCfgCheckedAdd(
        opBase,
        preflight.materializedOpDelta,
        "cleanup_cfg: materialized op preflight overflow")
    let operandBase = cleanupCfgCheckedAdd(
        plan.plannedMaterializedOperandCount,
        preflight.initializerOperandDelta,
        "cleanup_cfg: materialized operand preflight overflow")
    let operandCount = cleanupCfgCheckedAdd(
        operandBase,
        preflight.materializedOperandDelta,
        "cleanup_cfg: materialized operand preflight overflow")
    let callCount = cleanupCfgCheckedAdd(
        plan.plannedMaterializedCallCount,
        preflight.materializedCallDelta,
        "cleanup_cfg: materialized call preflight overflow")
    let callArgCount = cleanupCfgCheckedAdd(
        plan.plannedMaterializedCallArgCount,
        preflight.materializedCallArgDelta,
        "cleanup_cfg: materialized call arg preflight overflow")
    let blockCount = cleanupCfgCheckedAdd(
        plan.plannedMaterializedBlockCount,
        preflight.materializedBlockDelta,
        "cleanup_cfg: materialized block preflight overflow")
    let termCount = cleanupCfgCheckedAdd(
        plan.plannedMaterializedTermCount,
        preflight.materializedTermDelta,
        "cleanup_cfg: materialized term preflight overflow")
    let termOperandCount = cleanupCfgCheckedAdd(
        plan.plannedMaterializedTermOperandCount,
        preflight.materializedTermOperandDelta,
        "cleanup_cfg: materialized term operand preflight overflow")
    if totalLocalCount > plan.limits.maxLocalSlotCount ||
       opCount > plan.limits.maxMaterializedOpCount ||
       operandCount > plan.limits.maxMaterializedOperandCount ||
       callCount > plan.limits.maxMaterializedCallCount ||
       callArgCount > plan.limits.maxMaterializedCallArgCount ||
       blockCount > plan.limits.maxMaterializedBlockCount ||
       termCount > plan.limits.maxMaterializedTermCount ||
       termOperandCount > plan.limits.maxMaterializedTermOperandCount ||
       plan.cstringTexts.len > plan.limits.maxMaterializedCStringCount:
        cleanupCfgFail("cleanup_cfg: materialized CFG arena exhausted")
    preflight.nextPlannedMaterializedLocalCount = plannedLocalCount
    preflight.nextPlannedMaterializedOpCount = opCount
    preflight.nextPlannedMaterializedOperandCount = operandCount
    preflight.nextPlannedMaterializedCallCount = callCount
    preflight.nextPlannedMaterializedCallArgCount = callArgCount
    preflight.nextPlannedMaterializedBlockCount = blockCount
    preflight.nextPlannedMaterializedTermCount = termCount
    preflight.nextPlannedMaterializedTermOperandCount = termOperandCount
    if preflight.isExitCommit:
        if preflight.selectedDeferIds.len !=
           preflight.selectedDeferNextCounts.len:
            cleanupCfgFail("cleanup_cfg: selected defer preflight columns drift")
        preflight.exitId = plan.exitOriginalSourceBlockIds.len
        let nextExitCount = cleanupCfgCheckedAdd(
            preflight.exitId,
            1,
            "cleanup_cfg: exit count overflow")
        if nextExitCount > plan.limits.maxExitCount:
            cleanupCfgFail("cleanup_cfg: exit arena exhausted")
        preflight.deferStart = plan.exitDeferIds.len
        preflight.deferCount = preflight.selectedDeferIds.len
        let nextDeferCount = cleanupCfgCheckedAdd(
            preflight.deferStart,
            preflight.deferCount,
            "cleanup_cfg: exit defer CSR overflow")
        if nextDeferCount > plan.limits.maxExitDeferRefCount:
            cleanupCfgFail("cleanup_cfg: exit defer CSR exhausted")
        preflight.nextLcaParentStepCount = cleanupCfgCheckedAdd(
            plan.lcaParentStepCount,
            preflight.lcaParentStepCount,
            "cleanup_cfg: LCA report counter overflow")
        preflight.nextExitedScopeVisitCount = cleanupCfgCheckedAdd(
            plan.exitedScopeVisitCount,
            preflight.exitedScopeVisitCount,
            "cleanup_cfg: exited scope report counter overflow")
        preflight.nextSelectedDeferVisitCount = cleanupCfgCheckedAdd(
            plan.selectedDeferVisitCount,
            preflight.deferCount,
            "cleanup_cfg: selected defer report counter overflow")

fn cleanupCfgRequireMaterializedBounds(plan: var CleanupPlan) =
    var noDelta: cleanupExitPreflight
    cleanupCfgRequireMaterializedPreflight(plan, noDelta)

fn cleanupCfgEmptyReturnSnapshotBinding(): cleanupReturnSnapshotBinding =
    var out: cleanupReturnSnapshotBinding
    out.kind = CleanupReturnSnapshotNone
    out.sourceSlot = -1
    out.snapshotSlot = -1
    out.glueId = 0
    out.glueSymbol = ""
    out.ownershipEdgeId = -1
    out.ownershipActionOrdinal = -1
    out.ownershipPlaceId = -1
    out.ownershipTypeId = -1
    out.ownershipLayoutCid = ""
    out.resultExprNodeIndex = -1
    out.resultValueDefinitionRow = -1
    out.resultOwnership = odir.OwnershipUnknown
    out.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    out.sourceDefinitionRow = -1
    return out

fn cleanupCfgDefinitionCoordinateValid(
        domain: int32,
        row: int32): bool =
    return row >= 0 &&
           (domain == coreir.BodyDefinitionDomainEntrySlotTag ||
            domain == coreir.BodyDefinitionDomainBodyOpTag ||
            domain ==
                coreir.BodyDefinitionDomainManualConsumePostCallTag)

@borrows
fn cleanupCfgRelocateDefinitionCoordinate(
        bodyIR: var coreir.BodyIR,
        domain: int32,
        row: int32,
        bodyOpBase: int32,
        localBodyOpCount: int32,
        outDomain: var int32,
        outRow: var int32) =
    outDomain = coreir.BodyDefinitionDomainInvalidTag
    outRow = -1
    if domain == coreir.BodyDefinitionDomainInvalidTag:
        if row != -1:
            cleanupCfgFail(
                "cleanup_cfg: invalid definition domain carries row")
        return
    if row < 0:
        cleanupCfgFail("cleanup_cfg: definition coordinate row missing")
    if domain == coreir.BodyDefinitionDomainBodyOpTag:
        if bodyOpBase < 0 || localBodyOpCount < 0 ||
           row >= localBodyOpCount:
            cleanupCfgFail(
                "cleanup_cfg: BodyOp definition coordinate out of range")
        outDomain = domain
        outRow = cleanupCfgCheckedAdd(
            bodyOpBase,
            row,
            "cleanup_cfg: BodyOp definition relocation overflow")
        return
    if domain == coreir.BodyDefinitionDomainEntrySlotTag:
        if row >= bodyIR.localSlots.len ||
           bodyIR.localSlots[row].id != row ||
           bodyIR.localSlots[row].stackOffset >= 0 ||
           !bodyIR.entryDefinitionOwnershipSealed ||
           row >= bodyIR.entryDefinitionOwnershipKinds.len ||
           bodyIR.entryDefinitionOwnershipKinds[row] <
               int32(coreir.OwnPlain) ||
           bodyIR.entryDefinitionOwnershipKinds[row] >
               int32(coreir.OwnBorrowUnique):
            cleanupCfgFail(
                "cleanup_cfg: entry-slot definition mapping invalid")
        outDomain = domain
        outRow = row
        return
    if domain ==
           coreir.BodyDefinitionDomainManualConsumePostCallTag:
        if row >= bodyIR.manualConsume.postDefinitionRows.len ||
           row >= bodyIR.manualConsume.postDefinitionDomains.len ||
           bodyIR.manualConsume.postDefinitionDomains[row] != domain ||
           bodyIR.manualConsume.postDefinitionRows[row] != row:
            cleanupCfgFail(
                "cleanup_cfg: manual-post definition mapping invalid")
        outDomain = domain
        outRow = row
        return
    cleanupCfgFail("cleanup_cfg: unknown definition coordinate domain")

fn cleanupCfgSnapshotKindOwned(kind: CleanupReturnSnapshotKind): bool =
    return kind == CleanupReturnSnapshotOwnedRetain ||
           kind == CleanupReturnSnapshotOwnedClone

# wall64：plan 内绝对 BodyOp 定义坐标（原始坐标系，指纹门保护）在
# insertFlagInitializers 之后消费时的唯一合法读法——按记录基址平移并
# 以原始 ops.len 复核越界（fail-closed）；base=0 时恒等（与未插入
# 初始化器的历史行为逐字节一致）。
fn cleanupCfgRelocatePlanDefinitionCoordinate(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        domain: int32,
        row: int32,
        outDomain: var int32,
        outRow: var int32) =
    if plan.initializerRelocationOpBase == 0:
        outDomain = domain
        outRow = row
        return
    cleanupCfgRelocateDefinitionCoordinate(
        bodyIR,
        domain,
        row,
        plan.initializerRelocationOpBase,
        plan.initializerRelocationOpCount,
        outDomain,
        outRow)

fn cleanupCfgRequireSnapshotLocalSchema(plan: var CleanupPlan,
                                        sourceSlot: int32,
                                        snapshotSlot: int32) =
    if sourceSlot < 0 || sourceSlot >= plan.localTypeKinds.len ||
       snapshotSlot < 0 || snapshotSlot >= plan.localTypeKinds.len ||
       sourceSlot == snapshotSlot:
        cleanupCfgFail("cleanup_cfg: return snapshot slot invalid")
    if plan.localTypeKinds[sourceSlot] != plan.localTypeKinds[snapshotSlot] ||
       plan.localPlaceKinds[sourceSlot] != plan.localPlaceKinds[snapshotSlot] ||
       plan.localSizeBytes[sourceSlot] != plan.localSizeBytes[snapshotSlot] ||
       plan.localAlignBytes[sourceSlot] != plan.localAlignBytes[snapshotSlot]:
        cleanupCfgFail("cleanup_cfg: return snapshot local schema mismatch")
    for deferId in 0..<plan.deferActiveFlagSlots.len:
        if plan.deferActiveFlagSlots[deferId] == snapshotSlot:
            cleanupCfgFail("cleanup_cfg: return snapshot aliases defer flag")

@borrows
fn cleanupCfgRequireSnapshotBindingValues(
        plan: var CleanupPlan,
        kind: CleanupReturnSnapshotKind,
        sourceSlot: int32,
        snapshotSlot: int32,
        glueId: int32,
        glueSymbol: str,
        ownershipEdgeId: int32,
        ownershipActionOrdinal: int32,
        ownershipPlaceId: int32,
        ownershipTypeId: int32,
        ownershipLayoutCid: str,
        resultExprNodeIndex: int32,
        resultValueDefinitionRow: int32,
        resultOwnership: odir.OwnershipClass,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32) =
    if kind == CleanupReturnSnapshotNone:
        if sourceSlot != -1 || snapshotSlot != -1 ||
           glueId != 0 || len(glueSymbol) != 0 ||
           ownershipEdgeId != -1 ||
           ownershipActionOrdinal != -1 ||
           ownershipPlaceId != -1 || ownershipTypeId != -1 ||
           len(ownershipLayoutCid) != 0 ||
           resultExprNodeIndex != -1 ||
           resultValueDefinitionRow != -1 ||
           resultOwnership != odir.OwnershipUnknown ||
           sourceDefinitionDomain !=
               coreir.BodyDefinitionDomainInvalidTag ||
           sourceDefinitionRow != -1:
            cleanupCfgFail("cleanup_cfg: malformed void return snapshot binding")
        return
    cleanupCfgRequireSnapshotLocalSchema(plan, sourceSlot, snapshotSlot)
    let localKind = plan.localTypeKinds[sourceSlot]
    if kind == CleanupReturnSnapshotUnmanagedCopy:
        let scalarCopy = localKind == coreir.LocalI32Tag ||
                         localKind == coreir.LocalI64Tag ||
                         localKind == coreir.LocalF64Tag
        let exactAggregateCopy =
            ownershipEdgeId >= 0 &&
            localKind == coreir.LocalAggregateTag
        if !scalarCopy && !exactAggregateCopy:
            cleanupCfgFail(
                "cleanup_cfg: unmanaged return snapshot storage invalid")
        if glueId != 0 || len(glueSymbol) != 0:
            cleanupCfgFail("cleanup_cfg: unmanaged return carries glue")
        if ownershipEdgeId < 0:
            if ownershipEdgeId != -1 ||
               ownershipActionOrdinal != -1 ||
               ownershipPlaceId != -1 ||
               ownershipTypeId != -1 ||
               len(ownershipLayoutCid) != 0 ||
               resultExprNodeIndex != -1 ||
               resultValueDefinitionRow != -1 ||
               resultOwnership != odir.OwnershipUnknown ||
               sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainInvalidTag ||
               sourceDefinitionRow != -1:
                cleanupCfgFail(
                    "cleanup_cfg: unmanaged return authority is partial")
            return
        if ownershipActionOrdinal != 0 ||
           ownershipPlaceId <= 0 ||
           ownershipTypeId <= 0 ||
           len(ownershipLayoutCid) == 0 ||
           resultExprNodeIndex < 0 ||
           resultValueDefinitionRow < 0 ||
           resultOwnership != odir.Unmanaged ||
           !cleanupCfgDefinitionCoordinateValid(
               sourceDefinitionDomain,
               sourceDefinitionRow):
            cleanupCfgFail(
                "cleanup_cfg: ownership unmanaged return authority incomplete")
        let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
        if ownershipLayoutCid != plan.typeLayoutCids[typeRow]:
            cleanupCfgFail(
                "cleanup_cfg: unmanaged return snapshot layout mismatch")
        return
    if !cleanupCfgSnapshotKindOwned(kind):
        cleanupCfgFail("cleanup_cfg: unknown return snapshot kind")
    if localKind != coreir.LocalStrTag &&
       localKind != coreir.LocalAggregateTag:
        cleanupCfgFail("cleanup_cfg: owned return snapshot is not managed local")
    if glueId <= 0 || len(glueSymbol) == 0 ||
       ownershipEdgeId < 0 || ownershipActionOrdinal < 0 ||
       ownershipPlaceId <= 0 || ownershipTypeId <= 0 ||
       len(ownershipLayoutCid) == 0 ||
       resultExprNodeIndex < 0 ||
       resultValueDefinitionRow < 0 ||
       resultOwnership != odir.Owned ||
       !cleanupCfgDefinitionCoordinateValid(
           sourceDefinitionDomain,
           sourceDefinitionRow):
        cleanupCfgFail("cleanup_cfg: owned return snapshot action incomplete")
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, ownershipTypeId)
    if ownershipLayoutCid != plan.typeLayoutCids[typeRow]:
        cleanupCfgFail("cleanup_cfg: owned return snapshot layout mismatch")

@borrows
fn cleanupCfgRequireSnapshotBinding(
        plan: var CleanupPlan,
        binding: cleanupReturnSnapshotBinding) =
    cleanupCfgRequireSnapshotBindingValues(
        plan,
        binding.kind,
        binding.sourceSlot,
        binding.snapshotSlot,
        binding.glueId,
        binding.glueSymbol,
        binding.ownershipEdgeId,
        binding.ownershipActionOrdinal,
        binding.ownershipPlaceId,
        binding.ownershipTypeId,
        binding.ownershipLayoutCid,
        binding.resultExprNodeIndex,
        binding.resultValueDefinitionRow,
        binding.resultOwnership,
        binding.sourceDefinitionDomain,
        binding.sourceDefinitionRow)

fn cleanupCfgRequireExitSnapshotBinding(
        plan: var CleanupPlan,
        exitId: int32) =
    if exitId < 0 || exitId >= plan.exitReturnSnapshotKinds.len:
        cleanupCfgFail("cleanup_cfg: exit snapshot row out of range")
    cleanupCfgRequireSnapshotBindingValues(
        plan,
        plan.exitReturnSnapshotKinds[exitId],
        plan.exitReturnSourceSlots[exitId],
        plan.exitReturnSnapshotSlots[exitId],
        plan.exitReturnSnapshotGlueIds[exitId],
        plan.exitReturnSnapshotGlueSymbols[exitId],
        plan.exitReturnOwnershipEdgeIds[exitId],
        plan.exitReturnOwnershipActionOrdinals[exitId],
        plan.exitReturnOwnershipPlaceIds[exitId],
        plan.exitReturnOwnershipTypeIds[exitId],
        plan.exitReturnOwnershipLayoutCids[exitId],
        plan.exitReturnExprNodeIndexes[exitId],
        plan.exitReturnValueDefinitionRows[exitId],
        plan.exitReturnOwnershipKinds[exitId],
        plan.exitReturnSourceDefinitionDomains[exitId],
        plan.exitReturnSourceDefinitionRows[exitId])

fn cleanupCfgOriginalSourceEdgeKey(
        sourceBlockId: int32,
        successorOrdinal: int32): int32 =
    if successorOrdinal < 0 || successorOrdinal > 1:
        cleanupCfgFail("cleanup_cfg: source edge ordinal invalid")
    return cleanupCfgCheckedAdd(
        cleanupCfgCheckedMul(
            sourceBlockId,
            2,
            "cleanup_cfg: source edge key overflow"),
        successorOrdinal,
        "cleanup_cfg: source edge key overflow")

fn cleanupCfgValidateOriginalSourceIndex(
        plan: var CleanupPlan,
        requireUnsplittedPhysicalIdentity: bool) =
    let exitCount = plan.exitOriginalSourceBlockIds.len
    if plan.exitPhysicalSourceBlockIds.len != exitCount ||
       plan.exitSuccessorOrdinals.len != exitCount:
        cleanupCfgFail("cleanup_cfg: exit source identity columns drift")
    let expectedIndexCount = cleanupCfgCheckedMul(
        plan.limits.maxSourceBlockCount,
        2,
        "cleanup_cfg: source edge index size overflow")
    if plan.exitIdBySourceEdge.len != expectedIndexCount:
        cleanupCfgFail("cleanup_cfg: source edge index size drift")
    for exitId in 0..<exitCount:
        let originalSourceBlockId =
            plan.exitOriginalSourceBlockIds[exitId]
        if originalSourceBlockId < 0 ||
           originalSourceBlockId >= plan.limits.maxSourceBlockCount:
            cleanupCfgFail(
                "cleanup_cfg: original source block identity invalid")
        let sourceEdgeKey = cleanupCfgOriginalSourceEdgeKey(
            originalSourceBlockId,
            plan.exitSuccessorOrdinals[exitId])
        if plan.exitIdBySourceEdge[sourceEdgeKey] != exitId:
            cleanupCfgFail(
                "cleanup_cfg: original source edge index drift")
        if requireUnsplittedPhysicalIdentity &&
           plan.exitPhysicalSourceBlockIds[exitId] !=
               originalSourceBlockId:
            cleanupCfgFail(
                "cleanup_cfg: physical source identity unsynchronized")
    var indexedExitCount: int32
    for sourceEdgeKey in 0..<plan.exitIdBySourceEdge.len:
        let exitId = plan.exitIdBySourceEdge[sourceEdgeKey]
        if exitId < 0:
            continue
        if exitId >= exitCount ||
           cleanupCfgOriginalSourceEdgeKey(
               plan.exitOriginalSourceBlockIds[exitId],
               plan.exitSuccessorOrdinals[exitId]) != sourceEdgeKey:
            cleanupCfgFail(
                "cleanup_cfg: original source edge index drift")
        indexedExitCount = cleanupCfgCheckedAdd(
            indexedExitCount,
            1,
            "cleanup_cfg: source edge index count overflow")
    if indexedExitCount != exitCount:
        cleanupCfgFail("cleanup_cfg: source edge index count drift")

@borrows
fn cleanupCfgPreflightExitBound(
        plan: var CleanupPlan,
        fromBlockId: int32,
        successorOrdinal: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32,
        snapshot: cleanupReturnSnapshotBinding): cleanupExitPreflight =
    cleanupCfgRequireBuilding(plan)
    var out: cleanupExitPreflight
    out.isExitCommit = true
    if !plan.localSchemaBound:
        cleanupCfgFail("cleanup_cfg: local schema not bound")
    if !cleanupCfgExitKindKnown(kind):
        cleanupCfgFail("cleanup_cfg: unknown exit kind")
    cleanupCfgRequireScope(plan, fromScopeId)
    if fromBlockId < 0 || fromBlockId >= plan.limits.maxSourceBlockCount:
        cleanupCfgFail("cleanup_cfg: exit source block out of range")
    if successorOrdinal < 0 || successorOrdinal > 1:
        cleanupCfgFail("cleanup_cfg: successor ordinal out of range")
    out.sourceEdgeKey = cleanupCfgOriginalSourceEdgeKey(
        fromBlockId, successorOrdinal)
    if plan.exitIdBySourceEdge[out.sourceEdgeKey] >= 0:
        cleanupCfgFail("cleanup_cfg: source edge registered twice")
    cleanupCfgRequireSnapshotBinding(plan, snapshot)
    if kind == odir.OwnershipDropEdgeReturn:
        if successorOrdinal != 0 || toScopeId != -1 || targetBlockId != -1:
            cleanupCfgFail("cleanup_cfg: malformed return exit")
    else:
        cleanupCfgRequireScope(plan, toScopeId)
        if targetBlockId < 0 || targetBlockId >= plan.limits.maxSourceBlockCount ||
           snapshot.kind != CleanupReturnSnapshotNone:
            cleanupCfgFail("cleanup_cfg: malformed non-return exit")
    out.nextStringPayloadBytes = cleanupCfgCheckedAdd(
        plan.stringPayloadBytes,
        len(snapshot.glueSymbol),
        "cleanup_cfg: return snapshot string byte overflow")
    if out.nextStringPayloadBytes > plan.limits.maxStringPayloadBytes:
        cleanupCfgFail("cleanup_cfg: return snapshot string arena exhausted")

    if !plan.registrationsSealed:
        out.initializerOpDelta = cleanupCfgCheckedAdd(
            plan.deferActiveFlagSlots.len,
            plan.ownershipConditionFlagBindingFlagIds.len,
            "cleanup_cfg: initializer count overflow")
        out.initializerOperandDelta = cleanupCfgCheckedMul(
            out.initializerOpDelta,
            2,
            "cleanup_cfg: initializer operand count overflow")
    out.stopScopeId = -1
    if kind != odir.OwnershipDropEdgeReturn:
        out.stopScopeId = cleanupCfgCommonScopePreflight(
            plan,
            fromScopeId,
            toScopeId,
            out.lcaParentStepCount)
    var currentScope = fromScopeId
    while currentScope != out.stopScopeId:
        out.exitedScopeVisitCount = cleanupCfgCheckedAdd(
            out.exitedScopeVisitCount,
            1,
            "cleanup_cfg: exited scope counter overflow")
        var deferId = plan.scopeDeferHeads[currentScope]
        while deferId >= 0:
            cleanupCfgAccumulateSelectedDeferDelta(plan, deferId, out)
            deferId = plan.deferPreviousInScope[deferId]
        currentScope = plan.scopeParentIds[currentScope]
    if snapshot.kind == CleanupReturnSnapshotUnmanagedCopy:
        out.materializedOpDelta = cleanupCfgCheckedAdd(
            out.materializedOpDelta, 1,
            "cleanup_cfg: snapshot op delta overflow")
        out.materializedOperandDelta = cleanupCfgCheckedAdd(
            out.materializedOperandDelta, 1,
            "cleanup_cfg: snapshot operand delta overflow")
        out.materializedBlockDelta = cleanupCfgCheckedAdd(
            out.materializedBlockDelta, 1,
            "cleanup_cfg: snapshot block delta overflow")
        out.materializedTermDelta = cleanupCfgCheckedAdd(
            out.materializedTermDelta, 1,
            "cleanup_cfg: snapshot term delta overflow")
    elif cleanupCfgSnapshotKindOwned(snapshot.kind):
        out.materializedOpDelta = cleanupCfgCheckedAdd(
            out.materializedOpDelta, 1,
            "cleanup_cfg: snapshot op delta overflow")
        out.materializedOperandDelta = cleanupCfgCheckedAdd(
            out.materializedOperandDelta, 1,
            "cleanup_cfg: snapshot operand delta overflow")
        out.materializedCallDelta = cleanupCfgCheckedAdd(
            out.materializedCallDelta, 1,
            "cleanup_cfg: snapshot call delta overflow")
        out.materializedCallArgDelta = cleanupCfgCheckedAdd(
            out.materializedCallArgDelta, 2,
            "cleanup_cfg: snapshot call arg delta overflow")
        out.materializedBlockDelta = cleanupCfgCheckedAdd(
            out.materializedBlockDelta, 1,
            "cleanup_cfg: snapshot block delta overflow")
        out.materializedTermDelta = cleanupCfgCheckedAdd(
            out.materializedTermDelta, 1,
            "cleanup_cfg: snapshot term delta overflow")
    if kind == odir.OwnershipDropEdgeReturn &&
       (out.selectedDeferIds.len > 0 ||
        snapshot.kind != CleanupReturnSnapshotNone):
        out.materializedBlockDelta = cleanupCfgCheckedAdd(
            out.materializedBlockDelta, 1,
            "cleanup_cfg: return block delta overflow")
        out.materializedTermDelta = cleanupCfgCheckedAdd(
            out.materializedTermDelta, 1,
            "cleanup_cfg: return term delta overflow")
    return out

@borrows
fn cleanupCfgStageExitBound(
        plan: var CleanupPlan,
        fromBlockId: int32,
        successorOrdinal: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32,
        snapshot: cleanupReturnSnapshotBinding,
        preflight: cleanupExitPreflight): int32 =
    if !plan.registrationsSealed:
        plan.registrationsSealed = true
    plan.plannedMaterializedLocalCount =
        preflight.nextPlannedMaterializedLocalCount
    plan.plannedMaterializedOpCount =
        preflight.nextPlannedMaterializedOpCount
    plan.plannedMaterializedOperandCount =
        preflight.nextPlannedMaterializedOperandCount
    plan.plannedMaterializedCallCount =
        preflight.nextPlannedMaterializedCallCount
    plan.plannedMaterializedCallArgCount =
        preflight.nextPlannedMaterializedCallArgCount
    plan.plannedMaterializedBlockCount =
        preflight.nextPlannedMaterializedBlockCount
    plan.plannedMaterializedTermCount =
        preflight.nextPlannedMaterializedTermCount
    plan.plannedMaterializedTermOperandCount =
        preflight.nextPlannedMaterializedTermOperandCount
    plan.lcaParentStepCount = preflight.nextLcaParentStepCount
    plan.exitedScopeVisitCount = preflight.nextExitedScopeVisitCount
    plan.selectedDeferVisitCount = preflight.nextSelectedDeferVisitCount
    for selectedIndex in 0..<preflight.selectedDeferIds.len:
        let deferId = preflight.selectedDeferIds[selectedIndex]
        add(plan.exitDeferIds, deferId)
        plan.deferSelectedExitCounts[deferId] =
            preflight.selectedDeferNextCounts[selectedIndex]
    let exitId = preflight.exitId
    add(plan.exitOriginalSourceBlockIds, fromBlockId)
    add(plan.exitPhysicalSourceBlockIds, fromBlockId)
    add(plan.exitSuccessorOrdinals, successorOrdinal)
    add(plan.exitFromScopeIds, fromScopeId)
    add(plan.exitToScopeIds, toScopeId)
    add(plan.exitKinds, kind)
    add(plan.exitTargetBlockIds, targetBlockId)
    add(plan.exitReturnSourceSlots, snapshot.sourceSlot)
    add(plan.exitReturnSnapshotSlots, snapshot.snapshotSlot)
    add(plan.exitReturnSnapshotKinds, snapshot.kind)
    add(plan.exitReturnSnapshotGlueIds, snapshot.glueId)
    add(plan.exitReturnSnapshotGlueSymbols, strings.CloneStr(snapshot.glueSymbol))
    add(plan.exitReturnOwnershipEdgeIds, snapshot.ownershipEdgeId)
    add(plan.exitReturnOwnershipActionOrdinals,
        snapshot.ownershipActionOrdinal)
    add(plan.exitReturnOwnershipPlaceIds, snapshot.ownershipPlaceId)
    add(plan.exitReturnOwnershipTypeIds, snapshot.ownershipTypeId)
    add(plan.exitReturnOwnershipLayoutCids, share(snapshot.ownershipLayoutCid))
    add(plan.exitReturnExprNodeIndexes, snapshot.resultExprNodeIndex)
    add(plan.exitReturnValueDefinitionRows,
        snapshot.resultValueDefinitionRow)
    add(plan.exitReturnOwnershipKinds, snapshot.resultOwnership)
    add(plan.exitReturnSourceDefinitionDomains,
        snapshot.sourceDefinitionDomain)
    add(plan.exitReturnSourceDefinitionRows, snapshot.sourceDefinitionRow)
    add(plan.exitOwnershipEdgeIds, -1)
    add(plan.exitUsesOwnershipActions, false)
    add(plan.exitOwnershipActionStarts, -1)
    add(plan.exitOwnershipActionCounts, 0)
    add(plan.exitOwnershipFlagTransitionStarts, -1)
    add(plan.exitOwnershipFlagTransitionCounts, 0)
    add(plan.exitDeferStarts, preflight.deferStart)
    add(plan.exitDeferCounts, preflight.deferCount)
    plan.stringPayloadBytes = preflight.nextStringPayloadBytes
    plan.exitIdBySourceEdge[preflight.sourceEdgeKey] = exitId
    return exitId

fn cleanupCfgStageQueueUnmanagedExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        successorOrdinal: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32): int32 =
    if kind == odir.OwnershipDropEdgeReturn:
        cleanupCfgFail("cleanup_cfg: unmanaged return requires snapshot contract")
    let snapshot = cleanupCfgEmptyReturnSnapshotBinding()
    var preflight = cleanupCfgPreflightExitBound(plan,
                                                  fromBlockId,
                                                  successorOrdinal,
                                                  fromScopeId,
                                                  toScopeId,
                                                  kind,
                                                  targetBlockId,
                                                  snapshot)
    cleanupCfgRequireMaterializedPreflight(plan, preflight)
    return cleanupCfgStageExitBound(plan,
                                     fromBlockId,
                                     successorOrdinal,
                                     fromScopeId,
                                     toScopeId,
                                     kind,
                                     targetBlockId,
                                     snapshot,
                                     preflight)

fn CleanupPlanQueueUnmanagedExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        successorOrdinal: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32): int32 =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    delta.resultId = cleanupCfgStageQueueUnmanagedExit(
        planCandidate,
        fromBlockId,
        successorOrdinal,
        fromScopeId,
        toScopeId,
        kind,
        targetBlockId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)
    return delta.resultId

fn cleanupCfgStageQueueUnmanagedReturnExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        fromScopeId: int32,
        sourceSlot: int32,
        snapshotSlot: int32): int32 =
    var snapshot = cleanupCfgEmptyReturnSnapshotBinding()
    snapshot.kind = CleanupReturnSnapshotUnmanagedCopy
    snapshot.sourceSlot = sourceSlot
    snapshot.snapshotSlot = snapshotSlot
    var preflight = cleanupCfgPreflightExitBound(
        plan,
        fromBlockId,
        0,
        fromScopeId,
        -1,
        odir.OwnershipDropEdgeReturn,
        -1,
        snapshot)
    cleanupCfgRequireMaterializedPreflight(plan, preflight)
    return cleanupCfgStageExitBound(plan,
                                     fromBlockId,
                                     0,
                                     fromScopeId,
                                     -1,
                                     odir.OwnershipDropEdgeReturn,
                                     -1,
                                     snapshot,
                                     preflight)

fn CleanupPlanQueueUnmanagedReturnExit(plan: var CleanupPlan,
                                       fromBlockId: int32,
                                       fromScopeId: int32,
                                       sourceSlot: int32,
                                       snapshotSlot: int32): int32 =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    delta.resultId = cleanupCfgStageQueueUnmanagedReturnExit(
        planCandidate,
        fromBlockId,
        fromScopeId,
        sourceSlot,
        snapshotSlot)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)
    return delta.resultId

fn cleanupCfgOwnershipPlaceBindingIndex(plan: var CleanupPlan,
                                        ownershipPlaceId: int32): int32 =
    if ownershipPlaceId <= 0 ||
       ownershipPlaceId >= plan.ownershipPlaceBindingIndexByPlaceId.len:
        cleanupCfgFail("cleanup_cfg: ownership place binding missing")
    let bindingIndex =
        plan.ownershipPlaceBindingIndexByPlaceId[ownershipPlaceId]
    if bindingIndex < 0 ||
       bindingIndex >= plan.ownershipPlaceBindingLocalSlots.len:
        cleanupCfgFail("cleanup_cfg: ownership place binding missing")
    plan.bindingLookupVisitCount = cleanupCfgCheckedAdd(
        plan.bindingLookupVisitCount,
        1,
        "cleanup_cfg: binding visit counter overflow")
    return bindingIndex

fn cleanupCfgOwnershipPlaceSlot(plan: var CleanupPlan,
                                ownershipPlaceId: int32): int32 =
    let bindingIndex = cleanupCfgOwnershipPlaceBindingIndex(
        plan,
        ownershipPlaceId)
    return plan.ownershipPlaceBindingLocalSlots[bindingIndex]

@borrows
fn cleanupCfgRequireActionTypeContract(plan: var CleanupPlan,
                                       actionTypeId: int32,
                                       boundTypeId: int32,
                                       boundLayoutCid: str,
                                       context: str) =
    let typeRow = cleanupCfgPlanTypeLayoutRow(plan, actionTypeId)
    if actionTypeId != boundTypeId || len(boundLayoutCid) == 0 ||
       boundLayoutCid != plan.typeLayoutCids[typeRow]:
        cleanupCfgFail(context)

fn cleanupCfgOwnershipFieldSlot(plan: var CleanupPlan,
                                ownershipPlaceId: int32,
                                fieldOrdinal: int32): int32 =
    let bindingIndex = cleanupCfgOwnershipFieldBindingIndex(
        plan,
        ownershipPlaceId,
        fieldOrdinal)
    return plan.ownershipFieldBindingProjectionSlots[bindingIndex]

fn cleanupCfgOwnershipFieldBindingIndex(plan: var CleanupPlan,
                                        ownershipPlaceId: int32,
                                        fieldOrdinal: int32): int32 =
    if ownershipPlaceId <= 0 ||
       ownershipPlaceId >= plan.ownershipPlaceBindingIndexByPlaceId.len:
        cleanupCfgFail("cleanup_cfg: ownership field binding missing")
    let placeBinding =
        plan.ownershipPlaceBindingIndexByPlaceId[ownershipPlaceId]
    if placeBinding < 0 ||
       placeBinding >= plan.ownershipPlaceFieldIndexStarts.len ||
       fieldOrdinal < 0 ||
       fieldOrdinal >= plan.ownershipPlaceFieldIndexCounts[placeBinding]:
        cleanupCfgFail("cleanup_cfg: ownership field binding missing")
    let denseRow = cleanupCfgCheckedAdd(
        plan.ownershipPlaceFieldIndexStarts[placeBinding],
        fieldOrdinal,
        "cleanup_cfg: ownership field dense-index overflow")
    let bindingIndex =
        plan.ownershipFieldBindingIndexByPlaceField[denseRow]
    if bindingIndex < 0 ||
       bindingIndex >= plan.ownershipFieldBindingPlaceIds.len:
        cleanupCfgFail("cleanup_cfg: ownership field binding missing")
    plan.bindingLookupVisitCount = cleanupCfgCheckedAdd(
        plan.bindingLookupVisitCount,
        1,
        "cleanup_cfg: binding visit counter overflow")
    return bindingIndex

fn cleanupCfgOwnershipDropGlueBinding(plan: var CleanupPlan,
                                      dropGlueId: int32): int32 =
    if dropGlueId <= 0 ||
       dropGlueId >= plan.ownershipDropGlueBindingIndexByGlueId.len:
        cleanupCfgFail("cleanup_cfg: ownership drop glue binding missing")
    let bindingIndex = plan.ownershipDropGlueBindingIndexByGlueId[dropGlueId]
    if bindingIndex < 0 ||
       bindingIndex >= plan.ownershipDropGlueBindingGlueIds.len:
        cleanupCfgFail("cleanup_cfg: ownership drop glue binding missing")
    plan.bindingLookupVisitCount = cleanupCfgCheckedAdd(
        plan.bindingLookupVisitCount,
        1,
        "cleanup_cfg: binding visit counter overflow")
    return bindingIndex

fn cleanupCfgOwnershipRetainGlueBinding(plan: var CleanupPlan,
                                        ownershipTypeId: int32): int32 =
    if ownershipTypeId <= 0 ||
       ownershipTypeId >= plan.ownershipRetainGlueBindingIndexByTypeId.len:
        cleanupCfgFail("cleanup_cfg: ownership retain glue binding missing")
    let bindingIndex =
        plan.ownershipRetainGlueBindingIndexByTypeId[ownershipTypeId]
    if bindingIndex < 0 ||
       bindingIndex >= plan.ownershipRetainGlueBindingTypeIds.len:
        cleanupCfgFail("cleanup_cfg: ownership retain glue binding missing")
    plan.bindingLookupVisitCount = cleanupCfgCheckedAdd(
        plan.bindingLookupVisitCount,
        1,
        "cleanup_cfg: binding visit counter overflow")
    return bindingIndex

fn cleanupCfgOwnershipConditionSlot(plan: var CleanupPlan,
                                    ownershipFlagId: int32): int32 =
    let slot = cleanupCfgOwnershipConditionSlotIfBound(plan, ownershipFlagId)
    if slot < 0:
        cleanupCfgFail("cleanup_cfg: ownership condition flag binding missing")
    return slot

fn cleanupCfgOwnershipConditionSlotIfBound(plan: var CleanupPlan,
                                           ownershipFlagId: int32): int32 =
    if ownershipFlagId <= 0 ||
       ownershipFlagId >= plan.ownershipConditionLocalByFlagId.len:
        return -1
    plan.bindingLookupVisitCount = cleanupCfgCheckedAdd(
        plan.bindingLookupVisitCount,
        1,
        "cleanup_cfg: binding visit counter overflow")
    return plan.ownershipConditionLocalByFlagId[ownershipFlagId]

fn cleanupCfgOwnershipFlagSlot(
        plan: var CleanupPlan,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipFlagId: int32): int32 =
    let flag = odir.OwnershipDropAnalysisConditionFlag(ownershipAnalysis,
                                                        ownershipFlagId)
    if flag.kind == odir.ConditionFlagPlaceInitialized ||
       flag.kind == odir.ConditionFlagFieldInitialized:
        return cleanupCfgOwnershipConditionSlot(plan, ownershipFlagId)
    if flag.kind == odir.ConditionFlagDeferActive:
        for cleanupDeferId in 0..<plan.deferOwnershipDeferIds.len:
            if plan.deferOwnershipDeferIds[cleanupDeferId] == flag.deferId:
                let slot = plan.deferActiveFlagSlots[cleanupDeferId]
                let explicitSlot = cleanupCfgOwnershipConditionSlotIfBound(
                    plan,
                    ownershipFlagId)
                if explicitSlot >= 0 && explicitSlot != slot:
                    cleanupCfgFail("cleanup_cfg: defer flag identity mismatch")
                return slot
        cleanupCfgFail("cleanup_cfg: ownership defer flag binding missing")
    cleanupCfgFail("cleanup_cfg: ownership flag kind unsupported")
    return -1

fn cleanupCfgFlagTransitionMatches(
        transition: odir.OwnershipDropFlagTransition,
        originKind: odir.OwnershipDropFlagOriginKind,
        originId: int32): bool =
    return transition.originKind == originKind &&
           transition.originId == originId

fn cleanupCfgEnsureOwnershipTransitionIndex(
        plan: var CleanupPlan,
        ownershipAnalysis: var odir.OwnershipDropAnalysis) =
    let opCount = ownershipAnalysis.opActionCounts.len
    let edgeCount = ownershipAnalysis.edgeActionCounts.len
    let flagCount = odir.OwnershipDropAnalysisConditionFlagCount(
        ownershipAnalysis)
    let transitionCount = odir.OwnershipDropAnalysisFlagTransitionCount(
        ownershipAnalysis)
    if plan.ownershipTransitionIndexBound:
        if plan.ownershipTransitionIndexOpCount != opCount ||
           plan.ownershipTransitionIndexEdgeCount != edgeCount ||
           plan.ownershipTransitionIndexFlagCount != flagCount ||
           plan.ownershipTransitionIndexTransitionCount != transitionCount:
            cleanupCfgFail("cleanup_cfg: ownership transition index source drift")
        return
    if !ownershipAnalysis.converged ||
       opCount > plan.limits.maxOwnershipOpTransitionSiteCount ||
       edgeCount > plan.limits.maxExitCount ||
       transitionCount > plan.limits.maxOwnershipFlagTransitionCount:
        cleanupCfgFail("cleanup_cfg: ownership transition index unsupported")
    var opCounts: int32[]
    var edgeCounts: int32[]
    for _ in 0..<opCount:
        add(opCounts, 0)
    for _ in 0..<edgeCount:
        add(edgeCounts, 0)
    for transitionIndex in 0..<transitionCount:
        let transition = odir.OwnershipDropAnalysisFlagTransition(
            ownershipAnalysis,
            transitionIndex)
        if !transition.afterActions || transition.flagId <= 0 ||
           transition.flagId > flagCount:
            cleanupCfgFail("cleanup_cfg: ownership transition index row invalid")
        if transition.originKind == odir.FlagOriginOp:
            if transition.originId < 0 || transition.originId >= opCount:
                cleanupCfgFail("cleanup_cfg: ownership op transition origin invalid")
            opCounts[transition.originId] = cleanupCfgCheckedAdd(
                opCounts[transition.originId],
                1,
                "cleanup_cfg: ownership op transition count overflow")
        elif transition.originKind == odir.FlagOriginEdge:
            if transition.originId < 0 || transition.originId >= edgeCount:
                cleanupCfgFail("cleanup_cfg: ownership edge transition origin invalid")
            edgeCounts[transition.originId] = cleanupCfgCheckedAdd(
                edgeCounts[transition.originId],
                1,
                "cleanup_cfg: ownership edge transition count overflow")
        else:
            cleanupCfgFail("cleanup_cfg: ownership transition origin unsupported")
        plan.transitionIndexVisitCount = cleanupCfgCheckedAdd(
            plan.transitionIndexVisitCount,
            1,
            "cleanup_cfg: transition index visit counter overflow")
    var opStarts: int32[]
    var edgeStarts: int32[]
    var cursor: int32
    for countIndex in 0..<opCounts.len:
        let count = opCounts[countIndex]
        add(opStarts, cursor)
        cursor = cleanupCfgCheckedAdd(
            cursor,
            count,
            "cleanup_cfg: ownership transition CSR overflow")
    for countIndex in 0..<edgeCounts.len:
        let count = edgeCounts[countIndex]
        add(edgeStarts, cursor)
        cursor = cleanupCfgCheckedAdd(
            cursor,
            count,
            "cleanup_cfg: ownership transition CSR overflow")
    if cursor != transitionCount:
        cleanupCfgFail("cleanup_cfg: ownership transition CSR count drift")
    var rows: int32[]
    for _ in 0..<transitionCount:
        add(rows, -1)
    var opCursors: int32[]
    var edgeCursors: int32[]
    for cursorIndex in 0..<opStarts.len:
        add(opCursors, opStarts[cursorIndex])
    for cursorIndex in 0..<edgeStarts.len:
        add(edgeCursors, edgeStarts[cursorIndex])
    for transitionIndex in 0..<transitionCount:
        let transition = odir.OwnershipDropAnalysisFlagTransition(
            ownershipAnalysis,
            transitionIndex)
        var destination: int32
        if transition.originKind == odir.FlagOriginOp:
            destination = opCursors[transition.originId]
            opCursors[transition.originId] = cleanupCfgCheckedAdd(
                destination,
                1,
                "cleanup_cfg: ownership op transition cursor overflow")
        else:
            destination = edgeCursors[transition.originId]
            edgeCursors[transition.originId] = cleanupCfgCheckedAdd(
                destination,
                1,
                "cleanup_cfg: ownership edge transition cursor overflow")
        if destination < 0 || destination >= rows.len ||
           rows[destination] != -1:
            cleanupCfgFail("cleanup_cfg: ownership transition CSR destination drift")
        rows[destination] = transitionIndex
        plan.transitionIndexVisitCount = cleanupCfgCheckedAdd(
            plan.transitionIndexVisitCount,
            1,
            "cleanup_cfg: transition index visit counter overflow")
    var lastOriginByFlag: int32[]
    for _ in 0..flagCount:
        add(lastOriginByFlag, -1)
    var originSerial: int32
    for originId in 0..<opCount:
        for offset in 0..<opCounts[originId]:
            let transition = odir.OwnershipDropAnalysisFlagTransition(
                ownershipAnalysis,
                rows[opStarts[originId] + offset])
            if lastOriginByFlag[transition.flagId] == originSerial:
                cleanupCfgFail("cleanup_cfg: duplicate ownership flag transition")
            lastOriginByFlag[transition.flagId] = originSerial
        originSerial = cleanupCfgCheckedAdd(
            originSerial,
            1,
            "cleanup_cfg: transition origin serial overflow")
    for originId in 0..<edgeCount:
        for offset in 0..<edgeCounts[originId]:
            let transition = odir.OwnershipDropAnalysisFlagTransition(
                ownershipAnalysis,
                rows[edgeStarts[originId] + offset])
            if lastOriginByFlag[transition.flagId] == originSerial:
                cleanupCfgFail("cleanup_cfg: duplicate ownership flag transition")
            lastOriginByFlag[transition.flagId] = originSerial
        originSerial = cleanupCfgCheckedAdd(
            originSerial,
            1,
            "cleanup_cfg: transition origin serial overflow")
    for valueIndex in 0..<opStarts.len:
        let value = opStarts[valueIndex]
        add(plan.ownershipTransitionOpStarts, value)
    for valueIndex in 0..<opCounts.len:
        let value = opCounts[valueIndex]
        add(plan.ownershipTransitionOpCounts, value)
    for valueIndex in 0..<edgeStarts.len:
        let value = edgeStarts[valueIndex]
        add(plan.ownershipTransitionEdgeStarts, value)
    for valueIndex in 0..<edgeCounts.len:
        let value = edgeCounts[valueIndex]
        add(plan.ownershipTransitionEdgeCounts, value)
    for valueIndex in 0..<rows.len:
        let value = rows[valueIndex]
        add(plan.ownershipTransitionRows, value)
    plan.ownershipTransitionIndexOpCount = opCount
    plan.ownershipTransitionIndexEdgeCount = edgeCount
    plan.ownershipTransitionIndexFlagCount = flagCount
    plan.ownershipTransitionIndexTransitionCount = transitionCount
    plan.ownershipTransitionIndexBound = true

fn cleanupCfgPreflightFlagTransitions(
        plan: var CleanupPlan,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        originKind: odir.OwnershipDropFlagOriginKind,
        originId: int32): cleanupFlagTransitionPreflight =
    var out: cleanupFlagTransitionPreflight
    cleanupCfgEnsureOwnershipTransitionIndex(plan, ownershipAnalysis)
    var start: int32
    var count: int32
    if originKind == odir.FlagOriginOp:
        if originId < 0 || originId >= plan.ownershipTransitionOpStarts.len:
            cleanupCfgFail("cleanup_cfg: ownership op transition range invalid")
        start = plan.ownershipTransitionOpStarts[originId]
        count = plan.ownershipTransitionOpCounts[originId]
    elif originKind == odir.FlagOriginEdge:
        if originId < 0 || originId >= plan.ownershipTransitionEdgeStarts.len:
            cleanupCfgFail("cleanup_cfg: ownership edge transition range invalid")
        start = plan.ownershipTransitionEdgeStarts[originId]
        count = plan.ownershipTransitionEdgeCounts[originId]
    else:
        cleanupCfgFail("cleanup_cfg: ownership transition origin unsupported")
    for offset in 0..<count:
        let csrRow = cleanupCfgCheckedAdd(
            start,
            offset,
            "cleanup_cfg: ownership transition CSR row overflow")
        if csrRow < 0 || csrRow >= plan.ownershipTransitionRows.len:
            cleanupCfgFail("cleanup_cfg: ownership transition CSR row invalid")
        let transitionIndex = plan.ownershipTransitionRows[csrRow]
        let transition = odir.OwnershipDropAnalysisFlagTransition(
            ownershipAnalysis,
            transitionIndex)
        if !cleanupCfgFlagTransitionMatches(transition,
                                            originKind,
                                            originId):
            cleanupCfgFail("cleanup_cfg: ownership transition CSR identity drift")
        let flagSlot = cleanupCfgOwnershipFlagSlot(plan,
                                                    ownershipAnalysis,
                                                    transition.flagId)
        add(out.originKinds, transition.originKind)
        add(out.originIds, transition.originId)
        add(out.flagIds, transition.flagId)
        add(out.flagSlots, flagSlot)
        add(out.setValues, transition.setValue)
        plan.transitionRangeVisitCount = cleanupCfgCheckedAdd(
            plan.transitionRangeVisitCount,
            1,
            "cleanup_cfg: transition range visit counter overflow")
    let remaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipFlagTransitionCount,
        plan.ownershipFlagTransitionOriginKinds.len,
        "cleanup_cfg: ownership flag transition capacity underflow")
    if out.originKinds.len > remaining:
        cleanupCfgFail("cleanup_cfg: ownership flag transition arena exhausted")
    return out

@borrows
fn cleanupCfgStageFlagTransitions(
        plan: var CleanupPlan,
        preflight: cleanupFlagTransitionPreflight): int32 =
    let start = plan.ownershipFlagTransitionOriginKinds.len
    for row in 0..<preflight.originKinds.len:
        add(plan.ownershipFlagTransitionOriginKinds,
            preflight.originKinds[row])
        add(plan.ownershipFlagTransitionOriginIds, preflight.originIds[row])
        add(plan.ownershipFlagTransitionFlagIds, preflight.flagIds[row])
        add(plan.ownershipFlagTransitionFlagSlots, preflight.flagSlots[row])
        add(plan.ownershipFlagTransitionSetValues, preflight.setValues[row])
    return start

@borrows
fn cleanupCfgOwnershipOpConditionSupported(
        action: odir.OwnershipDropCleanupAction,
        kind: odir.OwnershipDropConditionKind,
        flagId: int32): bool =
    if kind == odir.DropConditionAlways:
        return flagId == -1
    if kind == odir.DropConditionPlaceInitialized ||
       kind == odir.DropConditionFieldInitialized:
        return flagId > 0
    if kind == odir.DropConditionCapturedOldPlace ||
       kind == odir.DropConditionCapturedOldField:
        return action.actionId > 0 && flagId == action.actionId
    return false

@borrows
fn cleanupCfgOwnershipOpActionSurfaceSupported(
        action: odir.OwnershipDropCleanupAction,
        ownershipOpId: int32): bool =
    let kindSupported =
        action.kind == odir.CleanupActionRetainValue ||
        action.kind == odir.CleanupActionStoreOwned ||
        action.kind == odir.CleanupActionDropPlace ||
        action.kind == odir.CleanupActionDropField ||
        action.kind == odir.CleanupActionStoreMove
    let captured =
        action.actionId > 0 &&
        (action.kind == odir.CleanupActionDropPlace ||
         action.kind == odir.CleanupActionDropField)
    let sourceAction =
        action.kind == odir.CleanupActionRetainValue ||
        action.kind == odir.CleanupActionStoreOwned ||
        action.kind == odir.CleanupActionStoreMove
    let managedTypedProducerDrop =
        action.actionId == 0 &&
        action.kind == odir.CleanupActionDropPlace &&
        action.definitionOriginKind == odir.DefinitionOriginTypedExpr
    let managedSyntheticProducerDrop =
        action.actionId == 0 &&
        action.kind == odir.CleanupActionDropPlace &&
        action.definitionOriginKind ==
            odir.DefinitionOriginCanonicalSyntheticAction
    let authoritySupported =
        (captured &&
         action.definitionOriginKind ==
             odir.DefinitionOriginCanonicalSyntheticAction &&
         action.definitionOriginId >= 0 &&
         action.sourceDefinitionDomain == 0 &&
         action.sourceDefinitionRow == -1 &&
         action.sourceOwnership == odir.Owned &&
         action.consumeActionRow >= 0) ||
        (sourceAction &&
         action.definitionOriginKind == odir.DefinitionOriginTypedExpr &&
         action.definitionOriginId >= 0 &&
         cleanupCfgDefinitionCoordinateValid(
             action.sourceDefinitionDomain,
             action.sourceDefinitionRow) &&
         (action.sourceOwnership == odir.Owned ||
          action.sourceOwnership == odir.RcBorrowedValue) &&
         ((action.kind == odir.CleanupActionStoreMove &&
           action.consumeActionRow >= 0) ||
          (action.kind != odir.CleanupActionStoreMove &&
           action.consumeActionRow == -1))) ||
        (managedTypedProducerDrop &&
         action.definitionOriginId >= 0 &&
         cleanupCfgDefinitionCoordinateValid(
             action.sourceDefinitionDomain,
             action.sourceDefinitionRow) &&
         action.sourceOwnership == odir.Owned &&
         action.consumeActionRow >= 0) ||
        (managedSyntheticProducerDrop &&
         action.definitionOriginId >= 0 &&
         action.sourceDefinitionDomain == 0 &&
         action.sourceDefinitionRow == -1 &&
         action.sourceOwnership == odir.Owned &&
         action.consumeActionRow >= 0) ||
        (!captured && !sourceAction &&
         !managedTypedProducerDrop &&
         !managedSyntheticProducerDrop &&
         action.definitionOriginKind == odir.DefinitionOriginUnknown &&
         action.definitionOriginId == -1 &&
         action.sourceDefinitionDomain == 0 &&
         action.sourceDefinitionRow == -1 &&
         action.sourceOwnership == odir.OwnershipUnknown &&
         action.consumeActionRow == -1)
    return kindSupported && authoritySupported &&
           action.capturedOldSourceDefinitionDomain == 0 &&
           action.capturedOldSourceDefinitionRow == -1 &&
           action.edgeId == -1 &&
           action.opIndex == ownershipOpId &&
           action.guardDeferId == -1 &&
           action.returnSnapshotGlueId == 0 &&
           len(action.returnSnapshotGlueSymbol) == 0 &&
           cleanupCfgOwnershipOpConditionSupported(
               action, action.conditionKind, action.conditionFlagId) &&
           cleanupCfgOwnershipOpConditionSupported(
               action,
               action.conditionOtherKind,
               action.conditionOtherFlagId) &&
           (action.conditionKind != odir.DropConditionAlways ||
            !action.conditionNegated) &&
           (action.conditionOtherKind != odir.DropConditionAlways ||
            !action.conditionOtherNegated)

fn cleanupCfgRequireMatchingManagedSchemas(plan: var CleanupPlan,
                                           targetSlot: int32,
                                           sourceSlot: int32,
                                           allowSameSlot: bool) =
    cleanupCfgRequireManagedLocal(plan, 2, targetSlot)
    cleanupCfgRequireManagedLocal(plan, 3, sourceSlot)
    if (!allowSameSlot && targetSlot == sourceSlot) ||
       plan.localTypeKinds[targetSlot] != plan.localTypeKinds[sourceSlot] ||
       plan.localPlaceKinds[targetSlot] !=
           coreir.BodyPlaceStackValueTag ||
       plan.localPlaceKinds[sourceSlot] !=
           coreir.BodyPlaceStackValueTag ||
       plan.localSizeBytes[targetSlot] != plan.localSizeBytes[sourceSlot] ||
       plan.localAlignBytes[targetSlot] != plan.localAlignBytes[sourceSlot]:
        cleanupCfgFail("cleanup_cfg: ownership store local schema mismatch")

@borrows
fn cleanupCfgAccumulateOwnershipOpActionBudget(
        action: cleanupOwnershipActionPreflight,
        preflight: var cleanupExitPreflight) =
    var opCount: int32
    var operandCount: int32
    var callCount: int32
    var callArgCount: int32
    var blockCount: int32 = 1
    var termCount: int32 = 1
    var termOperandCount: int32
    if action.kind == odir.CleanupActionRetainValue:
        opCount = 1
        operandCount = 1
        callCount = 1
        callArgCount = 2
    elif action.kind == odir.CleanupActionStoreOwned:
        opCount = 2
        operandCount = 2
    elif action.kind == odir.CleanupActionStoreMove:
        opCount = 1
        operandCount = 1
    elif action.kind == odir.CleanupActionDropPlace ||
         action.kind == odir.CleanupActionDropField:
        opCount = cleanupCfgCheckedAdd(
            1,
            action.clearFlagSlots.len,
            "cleanup_cfg: ownership op clear count overflow")
        operandCount = cleanupCfgCheckedAdd(
            1,
            cleanupCfgCheckedMul(
                action.clearFlagSlots.len,
                2,
                "cleanup_cfg: ownership op clear operand overflow"),
            "cleanup_cfg: ownership op operand count overflow")
        callCount = 1
        callArgCount = 2
        if action.kind == odir.CleanupActionDropField &&
           action.capturedOldSlot >= 0:
            opCount = cleanupCfgCheckedAdd(
                opCount, 1,
                "cleanup_cfg: captured field move op overflow")
            operandCount = cleanupCfgCheckedAdd(
                operandCount, 1,
                "cleanup_cfg: captured field move operand overflow")
        if action.primaryKind != odir.DropConditionAlways:
            blockCount = cleanupCfgCheckedAdd(
                blockCount, 1,
                "cleanup_cfg: ownership op condition block overflow")
            termCount = cleanupCfgCheckedAdd(
                termCount, 1,
                "cleanup_cfg: ownership op condition term overflow")
        if action.secondaryKind != odir.DropConditionAlways:
            blockCount = cleanupCfgCheckedAdd(
                blockCount, 1,
                "cleanup_cfg: ownership op condition block overflow")
            termCount = cleanupCfgCheckedAdd(
                termCount, 1,
                "cleanup_cfg: ownership op condition term overflow")
    else:
        cleanupCfgFail("cleanup_cfg: ownership op action budget unsupported")
    preflight.materializedOpDelta = cleanupCfgCheckedAdd(
        preflight.materializedOpDelta,
        opCount,
        "cleanup_cfg: ownership op action count overflow")
    preflight.materializedOperandDelta = cleanupCfgCheckedAdd(
        preflight.materializedOperandDelta,
        operandCount,
        "cleanup_cfg: ownership op action operand overflow")
    preflight.materializedCallDelta = cleanupCfgCheckedAdd(
        preflight.materializedCallDelta,
        callCount,
        "cleanup_cfg: ownership op action call overflow")
    preflight.materializedCallArgDelta = cleanupCfgCheckedAdd(
        preflight.materializedCallArgDelta,
        callArgCount,
        "cleanup_cfg: ownership op action call arg overflow")
    preflight.materializedBlockDelta = cleanupCfgCheckedAdd(
        preflight.materializedBlockDelta,
        blockCount,
        "cleanup_cfg: ownership op action block overflow")
    preflight.materializedTermDelta = cleanupCfgCheckedAdd(
        preflight.materializedTermDelta,
        termCount,
        "cleanup_cfg: ownership op action term overflow")
    preflight.materializedTermOperandDelta = cleanupCfgCheckedAdd(
        preflight.materializedTermOperandDelta,
        termOperandCount,
        "cleanup_cfg: ownership op action term operand overflow")

# 判重用 int32 开放寻址集合：slots 存 key+1（0=空），容量恒为 2 的幂，
# & mask 取位代替取模。key 为 snapshot flag slot（调用点前序校验保证非负，
# 且物理上界远小于 INT32_MAX，key+1 无溢出）。返回 true=首次插入，false=重复。
# 替代 0..<slots.len 线性查重：O(n²) → O(1) 期望。
fn cleanupCfgInt32SeenCapacityFor(count: int32): int32 =
    var cap: int32 = 1
    while cap < count * 2:
        cap = cap * 2
    return cap

fn cleanupCfgInt32SeenInsert(slots: var int32[], key: int32): bool =
    let mask = slots.len - 1
    var probe = key & mask
    var scanned: int32
    while scanned < slots.len:
        let storedPlus1 = slots[probe]
        if storedPlus1 == 0:
            slots[probe] = key + 1
            return true
        if storedPlus1 == key + 1:
            return false
        probe = probe + 1
        if probe >= slots.len:
            probe = 0
        scanned = scanned + 1
    cleanupCfgFail("cleanup_cfg: int32 seen set table full")

fn cleanupCfgOwnershipSnapshotSlotCount(
        actions: var cleanupOwnershipActionPreflight[]): int32 =
    var slots: int32[]
    setLen(slots, cleanupCfgInt32SeenCapacityFor(actions.len * 3))
    for actionIndex in 0..<actions.len:
        let action = actions[actionIndex]
        var candidates: int32[]
        if action.primaryKind != odir.DropConditionAlways:
            add(candidates, action.primaryFlagSlot)
        if action.secondaryKind != odir.DropConditionAlways:
            add(candidates, action.secondaryFlagSlot)
        if action.guardKind != odir.DropConditionAlways:
            add(candidates, action.guardFlagSlot)
        for candidateIndex in 0..<candidates.len:
            let candidate = candidates[candidateIndex]
            if candidate < 0:
                cleanupCfgFail("cleanup_cfg: ownership snapshot flag missing")
            let _ = cleanupCfgInt32SeenInsert(slots, candidate)
    var count: int32
    for slotIndex in 0..<slots.len:
        if slots[slotIndex] != 0:
            count = count + 1
    return count

fn cleanupCfgAccumulateOwnershipOpSiteSnapshotBudget(
        actions: var cleanupOwnershipActionPreflight[],
        plan: var CleanupPlan,
        siteIndex: int32,
        preflight: var cleanupExitPreflight) =
    var existingStart: int32
    var existingCount: int32
    if siteIndex >= 0:
        if siteIndex >= plan.ownershipOpSiteSnapshotStarts.len ||
           siteIndex >= plan.ownershipOpSiteSnapshotCounts.len:
            cleanupCfgFail(
                "cleanup_cfg: ownership op snapshot site row missing")
        existingStart = plan.ownershipOpSiteSnapshotStarts[siteIndex]
        existingCount = plan.ownershipOpSiteSnapshotCounts[siteIndex]
        if existingStart < 0 || existingCount < 0 ||
           existingStart + existingCount !=
               plan.ownershipOpSiteSnapshotSourceSlots.len:
            cleanupCfgFail(
                "cleanup_cfg: ownership op snapshot CSR is not appendable")
    elif plan.ownershipOpSiteSnapshotSourceSlots.len != 0 &&
         plan.ownershipOpSiteSnapshotStarts.len == 0:
        cleanupCfgFail(
            "cleanup_cfg: ownership op snapshot CSR lacks site rows")
    # existing ∪ 新候选统一走开放寻址判重（原 existing/newSlots 双线性扫
    # O(A×E + A×S) → O(1) 期望）；insert 返回 true 即首次出现，按 actions 原
    # 顺序追加，newSlots 顺序与原实现一致。
    var seen: int32[]
    setLen(seen,
           cleanupCfgInt32SeenCapacityFor(
               existingCount + actions.len * 3))
    for offset in 0..<existingCount:
        let _ = cleanupCfgInt32SeenInsert(
            seen,
            plan.ownershipOpSiteSnapshotSourceSlots[existingStart + offset])
    var newSlots: int32[]
    for actionIndex in 0..<actions.len:
        let action = actions[actionIndex]
        var candidates: int32[]
        if action.primaryKind != odir.DropConditionAlways:
            add(candidates, action.primaryFlagSlot)
        if action.secondaryKind != odir.DropConditionAlways:
            add(candidates, action.secondaryFlagSlot)
        if action.guardKind != odir.DropConditionAlways:
            add(candidates, action.guardFlagSlot)
        for candidateIndex in 0..<candidates.len:
            let candidate = candidates[candidateIndex]
            if candidate < 0:
                cleanupCfgFail(
                    "cleanup_cfg: ownership op snapshot flag missing")
            if cleanupCfgInt32SeenInsert(seen, candidate):
                add(newSlots, candidate)
    if newSlots.len <= 0:
        return
    let snapshotRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipActionFlagRefCount,
        plan.ownershipOpSiteSnapshotSourceSlots.len,
        "cleanup_cfg: ownership op snapshot row capacity underflow")
    if newSlots.len > snapshotRemaining:
        cleanupCfgFail(
            "cleanup_cfg: ownership op snapshot row arena exhausted")
    preflight.materializedLocalDelta = cleanupCfgCheckedAdd(
        preflight.materializedLocalDelta,
        newSlots.len,
        "cleanup_cfg: ownership op snapshot local overflow")
    preflight.materializedOpDelta = cleanupCfgCheckedAdd(
        preflight.materializedOpDelta,
        newSlots.len,
        "cleanup_cfg: ownership op snapshot op overflow")
    preflight.materializedOperandDelta = cleanupCfgCheckedAdd(
        preflight.materializedOperandDelta,
        newSlots.len,
        "cleanup_cfg: ownership op snapshot operand overflow")
    if existingCount <= 0:
        preflight.materializedBlockDelta = cleanupCfgCheckedAdd(
            preflight.materializedBlockDelta,
            1,
            "cleanup_cfg: ownership op snapshot block overflow")
        preflight.materializedTermDelta = cleanupCfgCheckedAdd(
            preflight.materializedTermDelta,
            1,
            "cleanup_cfg: ownership op snapshot term overflow")

fn cleanupCfgAccumulateOwnershipSnapshotBudget(
        actions: var cleanupOwnershipActionPreflight[],
        plan: var CleanupPlan,
        preflight: var cleanupExitPreflight) =
    let snapshotCount = cleanupCfgOwnershipSnapshotSlotCount(actions)
    if snapshotCount <= 0:
        return
    let localRemaining = cleanupCfgCheckedSub(
        plan.limits.maxLocalSlotCount,
        plan.localTypeKinds.len,
        "cleanup_cfg: ownership snapshot local capacity underflow")
    if snapshotCount > localRemaining:
        cleanupCfgFail("cleanup_cfg: ownership snapshot local arena exhausted")
    preflight.materializedLocalDelta = cleanupCfgCheckedAdd(
        preflight.materializedLocalDelta,
        snapshotCount,
        "cleanup_cfg: ownership snapshot local overflow")
    preflight.materializedOpDelta = cleanupCfgCheckedAdd(
        preflight.materializedOpDelta,
        snapshotCount,
        "cleanup_cfg: ownership snapshot op overflow")
    preflight.materializedOperandDelta = cleanupCfgCheckedAdd(
        preflight.materializedOperandDelta,
        snapshotCount,
        "cleanup_cfg: ownership snapshot operand overflow")
    preflight.materializedBlockDelta = cleanupCfgCheckedAdd(
        preflight.materializedBlockDelta,
        1,
        "cleanup_cfg: ownership snapshot block overflow")
    preflight.materializedTermDelta = cleanupCfgCheckedAdd(
        preflight.materializedTermDelta,
        1,
        "cleanup_cfg: ownership snapshot term overflow")

fn cleanupCfgBodyTermReachesBlock(bodyIR: var coreir.BodyIR,
                                  fromBlockId: int32,
                                  toBlockId: int32): bool =
    if fromBlockId < 0 || fromBlockId >= bodyIR.blocks.len ||
       toBlockId < 0 || toBlockId >= bodyIR.blocks.len:
        cleanupCfgFail("cleanup_cfg: reaching-definition block out of range")
    let block = bodyIR.blocks[fromBlockId]
    if block.id != fromBlockId || block.termIndex < 0 ||
       block.termIndex >= bodyIR.terms.len:
        cleanupCfgFail("cleanup_cfg: reaching-definition block malformed")
    let term = bodyIR.terms[block.termIndex]
    if term.kind == coreir.BodyTermReturnTag:
        return false
    if term.kind == coreir.BodyTermBrTag:
        if term.trueBlock < 0 || term.trueBlock >= bodyIR.blocks.len:
            cleanupCfgFail(
                "cleanup_cfg: reaching-definition branch target invalid")
        return term.trueBlock == toBlockId
    if term.kind == coreir.BodyTermCbrTag:
        if term.trueBlock < 0 || term.trueBlock >= bodyIR.blocks.len ||
           term.falseBlock < 0 || term.falseBlock >= bodyIR.blocks.len:
            cleanupCfgFail(
                "cleanup_cfg: reaching-definition condition target invalid")
        return term.trueBlock == toBlockId ||
               term.falseBlock == toBlockId
    cleanupCfgFail("cleanup_cfg: reaching-definition terminator unsupported")
    return false

fn cleanupCfgValidateManagedDefinitionRow(bodyIR: var coreir.BodyIR,
                                          opIndex: int32) =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        cleanupCfgFail("cleanup_cfg: managed definition row out of range")
    let op = bodyIR.ops[opIndex]
    # [wall112] 非托管 call-result 纯值定义 admit。本函数及其调用面的托管
    # def 权威审按 OwnMove/OwnBorrowShared 转移语义构建；发射器
    # PrimaryBodyIrBindUnmanagedCallResultDefinition 对非托管 call-result
    # 以 OwnPlain+TypedExpr 落 CallOp 载体纯值定义（body_ir_access
    # [wall108r3] 与 exact_def_identity [wall110] admit 实证的同一槽形），
    # 无所有权转移无 cleanup 义务，本函数剩余审不适用，提前放行。admit
    # 联立逐列强于本函数原 identity/TypedExpr authority 各检（slot 范围/
    # semanticRow>=0/originId>=0/exprNode>=0/originId==semanticRow/源对
    # Invalid 全为 admit 真子集）。任一列不符即走原门原判词 fail-closed；
    # 无 sentinel 豁免、无计数门放宽、derive 零写。禁止提取共享 helper
    # （body_ir_access [wall108r2] 警示同款；与
    # CleanupBodyIrManagedAuthorityFinalStrictValidate 终审循环站点
    # [wall112] admit 互为锚定）。
    if op.kind == coreir.BodyOpCallTag &&
       op.operands.len == 1 &&
       op.target == op.valueDefSlot &&
       op.valueDefOwnership == coreir.OwnPlain &&
       op.valueDefOriginKind ==
           coreir.BodyDefinitionOriginTypedExprTag &&
       op.valueDefOriginId == op.valueDefSemanticRow &&
       op.valueDefOriginId >= 0 &&
       op.valueDefExprNodeIndex >= 0 &&
       op.valueDefBorrowOwnerSemanticRow == -1 &&
       op.valueDefBorrowOwnerDefinitionDomain ==
           coreir.BodyDefinitionDomainInvalidTag &&
       op.valueDefBorrowOwnerDefinitionRow == -1 &&
       op.sourceDefinitionDomain ==
           coreir.BodyDefinitionDomainInvalidTag &&
       op.sourceDefinitionRow == -1 &&
       op.consumeActionRow == -1 &&
       op.valueDefSlot >= 0 &&
       op.valueDefSlot < bodyIR.localSlots.len &&
       bodyIR.localSlots[op.valueDefSlot].managedStorageKind ==
           coreir.BodyManagedStorageUnmanagedTag &&
       bodyIR.localSlots[op.valueDefSlot].typeArenaTypeId >= 0:
        return
    if op.valueDefOwnership != coreir.OwnMove &&
       op.valueDefOwnership != coreir.OwnBorrowShared:
        cleanupCfgFail("cleanup_cfg: managed definition ownership invalid")
    if op.valueDefSlot < 0 || op.valueDefSlot >= bodyIR.localSlots.len ||
       op.valueDefSemanticRow < 0 ||
       op.valueDefOriginId < 0:
        cleanupCfgFail("cleanup_cfg: managed definition identity invalid")
    if op.valueDefOriginKind ==
           coreir.BodyDefinitionOriginTypedExprTag:
        if op.valueDefExprNodeIndex < 0 ||
           op.valueDefOriginId != op.valueDefSemanticRow ||
           op.sourceDefinitionDomain !=
               coreir.BodyDefinitionDomainInvalidTag ||
           op.sourceDefinitionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: TypedExpr managed definition authority invalid")
    elif op.valueDefOriginKind ==
             coreir.BodyDefinitionOriginCanonicalCleanupActionTag:
        if op.sourceDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           op.sourceDefinitionRow < 0 ||
           op.sourceDefinitionRow >= bodyIR.ops.len ||
           op.valueDefSemanticRow !=
               bodyIR.ops[
                   op.sourceDefinitionRow].valueDefSemanticRow:
            cleanupCfgFail(
                "cleanup_cfg: cleanup managed definition authority invalid")
    else:
        cleanupCfgFail("cleanup_cfg: managed definition origin invalid")

fn cleanupCfgAccessOpReachesDefinition(
        access: var bodyaccess.BodyIrAccessTable,
        opIndex: int32,
        definitionDomain: int32,
        definitionRow: int32,
        requireConsume: bool): bool =
    if !bodyaccess.BodyIrAccessTableIsValid(access) ||
       opIndex < 0 ||
       opIndex >= access.opFactStarts.len:
        return false
    let start = access.opFactStarts[opIndex]
    let count = access.opFactCounts[opIndex]
    for factOffset in 0..<count:
        let fact = access.facts[start + factOffset]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.definitionDomain == definitionDomain &&
           fact.definitionRow == definitionRow &&
           (!requireConsume || fact.consumesDefinition):
            return true
    return false

fn cleanupCfgAccessTermReachesDefinition(
        access: var bodyaccess.BodyIrAccessTable,
        termIndex: int32,
        definitionDomain: int32,
        definitionRow: int32): bool =
    if !bodyaccess.BodyIrAccessTableIsValid(access) ||
       termIndex < 0 ||
       termIndex >= access.termFactStarts.len:
        return false
    let start = access.termFactStarts[termIndex]
    let count = access.termFactCounts[termIndex]
    for factOffset in 0..<count:
        let fact = access.facts[start + factOffset]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.definitionDomain == definitionDomain &&
           fact.definitionRow == definitionRow:
            return true
    return false

fn cleanupCfgRequireExactManagedSlot(bodyIR: var coreir.BodyIR,
                                     slotId: int32) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        cleanupCfgFail("cleanup_cfg: managed value slot out of range")
    let slot = bodyIR.localSlots[slotId]
    if slot.typeArenaTypeId < 0 ||
       slot.managedStorageKind !=
           coreir.BodyManagedStorageManagedTag ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.typeArenaArtifactCid):
        cleanupCfgFail(
            "cleanup_cfg: managed value exact TypeArena proof missing")

fn cleanupCfgReturnTermOwnerBlock(bodyIR: var coreir.BodyIR,
                                  termIndex: int32): int32 =
    var ownerBlockId: int32 = -1
    for blockId in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockId]
        if block.id != blockId || block.opStart < 0 ||
           block.opCount < 0 ||
           cleanupCfgCheckedAdd(
               block.opStart,
               block.opCount,
               "cleanup_cfg: managed return block op range overflow") >
               bodyIR.ops.len ||
           block.termIndex < 0 ||
           block.termIndex >= bodyIR.terms.len:
            cleanupCfgFail(
                "cleanup_cfg: managed return block partition invalid")
        if block.termIndex == termIndex:
            if ownerBlockId >= 0:
                cleanupCfgFail(
                    "cleanup_cfg: managed return term has multiple blocks")
            ownerBlockId = blockId
    if ownerBlockId < 0:
        cleanupCfgFail("cleanup_cfg: managed return term has no block")
    return ownerBlockId

fn CleanupBodyIrManagedAuthorityFinalStrictValidate(
        bodyIR: var coreir.BodyIR) =
    if !coreir.BodyIRTypeArenaProofDomainValid(bodyIR):
        cleanupCfgFail("cleanup_cfg: managed authority TypeArena domain invalid")
    var access = bodyaccess.BodyIrAccessDecode(bodyIR)
    if !bodyaccess.BodyIrAccessTableIsValid(access):
        cleanupCfgFail(
            "cleanup_cfg: canonical BodyIR access authority invalid")
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.valueDefOwnership == coreir.OwnInvalid:
            if op.valueDefSlot != -1 ||
               op.valueDefExprNodeIndex != -1 ||
               op.valueDefSemanticRow != -1 ||
               op.valueDefConsumeOpIndexPlusOne != 0 ||
               op.valueDefOriginKind !=
                   coreir.BodyDefinitionOriginUnknownTag ||
               op.valueDefOriginId != -1:
                cleanupCfgFail(
                    "cleanup_cfg: partial managed BodyOp definition authority")
            if op.consumeActionRow < 0:
                if op.sourceDefinitionDomain !=
                       coreir.BodyDefinitionDomainInvalidTag ||
                   op.sourceDefinitionRow != -1:
                    cleanupCfgFail(
                        "cleanup_cfg: unconsumed BodyOp carries definition source")
            elif !cleanupCfgDefinitionCoordinateValid(
                     op.sourceDefinitionDomain,
                     op.sourceDefinitionRow):
                cleanupCfgFail(
                    "cleanup_cfg: consuming BodyOp definition source missing")
            continue
        # [wall112] 终审循环站点 admit（与 cleanupCfgValidateManagedDefinitionRow
        # 内 [wall112] admit 逐列同形；禁提取共享 helper，[wall108r2] 警示
        # 同款）。后续 cleanupCfgRequireExactManagedSlot 与 consume authority
        # 审按 OwnMove/OwnBorrowShared 托管槽转移语义构建（exact slot 门
        # 要求 ManagedTag 存储），对 Unmanaged 槽纯值 def 不适用。任一列
        # 不符即走原门原判词 fail-closed。
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1 &&
           op.target == op.valueDefSlot &&
           op.valueDefOwnership == coreir.OwnPlain &&
           op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           op.valueDefOriginId == op.valueDefSemanticRow &&
           op.valueDefOriginId >= 0 &&
           op.valueDefExprNodeIndex >= 0 &&
           op.valueDefBorrowOwnerSemanticRow == -1 &&
           op.valueDefBorrowOwnerDefinitionDomain ==
               coreir.BodyDefinitionDomainInvalidTag &&
           op.valueDefBorrowOwnerDefinitionRow == -1 &&
           op.sourceDefinitionDomain ==
               coreir.BodyDefinitionDomainInvalidTag &&
           op.sourceDefinitionRow == -1 &&
           op.consumeActionRow == -1 &&
           op.valueDefSlot >= 0 &&
           op.valueDefSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[op.valueDefSlot].managedStorageKind ==
               coreir.BodyManagedStorageUnmanagedTag &&
           bodyIR.localSlots[op.valueDefSlot].typeArenaTypeId >= 0:
            continue
        cleanupCfgValidateManagedDefinitionRow(bodyIR, opIndex)
        cleanupCfgRequireExactManagedSlot(bodyIR, op.valueDefSlot)
        # wall95 判词富化：consume authority 三臂逐项取数（守卫零弱化，
        # diag 臂为纯读布尔，与原联判逐字同构，仅失败臂取数）。
        let diagConsumeOutOfRange =
            op.valueDefConsumeOpIndexPlusOne < 0 ||
            op.valueDefConsumeOpIndexPlusOne > bodyIR.ops.len
        let diagConsumeAgreementDrift =
            (op.valueDefConsumeOpIndexPlusOne == 0) !=
            (op.consumeActionRow == -1)
        if diagConsumeOutOfRange || diagConsumeAgreementDrift:
            var diagConsumeOpKind: int32 = -1
            var diagConsumeOpTarget: int32 = -1
            var diagConsumeOpCar: int32 = -2
            # wall95 ingress intrinsic 消费对臂：wall35 生产拼写
            # （ManagedLvalueReplaceProductionBindIntrinsicSourceConsume +
            # PrimaryBodyIrAppendSeqStrAdd）逐列镜像——源 def 的
            # consumeActionRow 恒为 -1（消费权威在 call/op 对列上），
            # 消费 op ManagedStoreNone、target=-1、源定义对同指源 def、
            # action 行=消费 op 自身行。任一列不符即原判词放行，
            # 非 ingress 形零放行增量。
            var diagIngestValid: bool
            var diagIngestCallOrdinal: int32 = -1
            var diagIngestC1: bool
            var diagIngestC2: bool
            var diagIngestC3: bool
            var diagIngestC4: bool
            var diagIngestC5: bool
            var diagIngestC6: bool
            var diagIngestC7: bool
            var diagIngestC8: bool
            if op.consumeActionRow == -1 &&
               op.valueDefConsumeOpIndexPlusOne > 0 &&
               op.valueDefConsumeOpIndexPlusOne <= bodyIR.ops.len:
                let diagIngestConsumer =
                    bodyIR.ops[op.valueDefConsumeOpIndexPlusOne - 1]
                diagConsumeOpKind = int32(diagIngestConsumer.kind)
                diagConsumeOpTarget = diagIngestConsumer.target
                diagConsumeOpCar = diagIngestConsumer.consumeActionRow
                diagIngestC1 = diagIngestConsumer.kind !=
                    coreir.BodyOpCallTag
                diagIngestC2 = diagIngestConsumer.operands.len != 1
                diagIngestC3 = diagIngestConsumer.operands.len == 1 &&
                    (diagIngestConsumer.operands[0] < 0 ||
                     diagIngestConsumer.operands[0] >=
                         bodyIR.callSequence.len)
                if !diagIngestC1 && !diagIngestC2 && !diagIngestC3:
                    diagIngestCallOrdinal = diagIngestConsumer.operands[0]
                    let diagIngestCall =
                        bodyIR.callSequence[diagIngestCallOrdinal]
                    diagIngestC4 = diagIngestConsumer.target != -1
                    diagIngestC5 =
                        diagIngestConsumer.sourceDefinitionDomain !=
                            coreir.BodyDefinitionDomainBodyOpTag ||
                        diagIngestConsumer.sourceDefinitionRow != opIndex
                    diagIngestC6 =
                        diagIngestConsumer.consumeActionRow !=
                            op.valueDefConsumeOpIndexPlusOne - 1
                    diagIngestC7 =
                        diagIngestCall.managedStoreKind !=
                            coreir.ManagedStoreNoneTag ||
                        diagIngestCall.sourceDefinitionDomain !=
                            coreir.BodyDefinitionDomainBodyOpTag ||
                        diagIngestCall.sourceDefinitionRow != opIndex ||
                        diagIngestCall.consumeActionRow !=
                            op.valueDefConsumeOpIndexPlusOne - 1
                    diagIngestC8 =
                        op.sourceDefinitionDomain !=
                            coreir.BodyDefinitionDomainInvalidTag ||
                        op.sourceDefinitionRow != -1 ||
                        op.valueDefOriginKind !=
                            coreir.BodyDefinitionOriginTypedExprTag ||
                        op.valueDefOwnership != coreir.OwnMove ||
                        op.valueDefOriginId !=
                            op.valueDefSemanticRow
                    diagIngestValid = !diagIngestC4 && !diagIngestC5 &&
                                      !diagIngestC6 && !diagIngestC7 &&
                                      !diagIngestC8
            if diagConsumeOutOfRange ||
               (diagConsumeAgreementDrift && !diagIngestValid):
                cleanupCfgFail(
                    Fmt"cleanup_cfg: managed BodyOp consume authority invalid fn={bodyIR.controlFunctionRow} op={opIndex} opkind={int32(op.kind)} target={op.target} ops={bodyIR.ops.len} cop={op.valueDefConsumeOpIndexPlusOne} car={op.consumeActionRow} own={int32(op.valueDefOwnership)} slot={op.valueDefSlot} okind={int32(op.valueDefOriginKind)} oid={op.valueDefOriginId} eni={op.valueDefExprNodeIndex} semrow={op.valueDefSemanticRow} dom={op.sourceDefinitionDomain} srow={op.sourceDefinitionRow} range={diagConsumeOutOfRange} drift={diagConsumeAgreementDrift} c_opkind={diagConsumeOpKind} c_target={diagConsumeOpTarget} c_car={diagConsumeOpCar} i_valid={diagIngestValid} i_ord={diagIngestCallOrdinal} i_c1={diagIngestC1} i_c2={diagIngestC2} i_c3={diagIngestC3} i_c4={diagIngestC4} i_c5={diagIngestC5} i_c6={diagIngestC6} i_c7={diagIngestC7} i_c8={diagIngestC8}")
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
           !cleanupCfgAccessOpReachesDefinition(
               access,
               opIndex,
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow,
               false):
            cleanupCfgFail(
                "cleanup_cfg: cleanup definition does not reach BodyOp")
        if op.valueDefConsumeOpIndexPlusOne > 0 &&
           !cleanupCfgAccessOpReachesDefinition(
               access,
               op.valueDefConsumeOpIndexPlusOne - 1,
               coreir.BodyDefinitionDomainBodyOpTag,
               opIndex,
               true):
            # wall95-B 判词富化：消费位 reach 臂取数（守卫零弱化）。
            cleanupCfgFail(
                Fmt"cleanup_cfg: consume site does not reach managed definition fn={bodyIR.controlFunctionRow} op={opIndex} cop={op.valueDefConsumeOpIndexPlusOne} consume_op={op.valueDefConsumeOpIndexPlusOne - 1} def_dom={coreir.BodyDefinitionDomainBodyOpTag} def_row={opIndex} ops={bodyIR.ops.len} op_car={op.consumeActionRow} okind={int32(op.valueDefOriginKind)}")

    for callIndex in 0..<bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callIndex]
        if call.resultOwnership == coreir.OwnInvalid:
            if call.resultExprNodeIndex != -1 ||
               call.resultValueDefinitionRow != -1 ||
               call.resultDefinitionOriginKind !=
                   coreir.BodyDefinitionOriginUnknownTag ||
               call.resultDefinitionOriginId != -1:
                cleanupCfgFail(
                    "cleanup_cfg: partial managed CallOp result authority")
            if call.consumeActionRow < 0:
                if call.sourceDefinitionDomain !=
                       coreir.BodyDefinitionDomainInvalidTag ||
                   call.sourceDefinitionRow != -1:
                    cleanupCfgFail(
                        "cleanup_cfg: unconsumed CallOp carries definition source")
            elif !cleanupCfgDefinitionCoordinateValid(
                     call.sourceDefinitionDomain,
                     call.sourceDefinitionRow):
                cleanupCfgFail(
                    "cleanup_cfg: consuming CallOp definition source missing")
            if call.consumeActionRow >= 0:
                var consumingBodyOpCount: int32
                for opIndex in 0..<bodyIR.ops.len:
                    let consumingOp = bodyIR.ops[opIndex]
                    if consumingOp.kind == coreir.BodyOpCallTag &&
                       consumingOp.operands.len == 1 &&
                       consumingOp.operands[0] == callIndex:
                        if consumingOp.sourceDefinitionDomain !=
                               call.sourceDefinitionDomain ||
                           consumingOp.sourceDefinitionRow !=
                               call.sourceDefinitionRow ||
                           consumingOp.consumeActionRow !=
                               call.consumeActionRow:
                            cleanupCfgFail(
                                "cleanup_cfg: consuming CallOp/BodyOp authority drift")
                        consumingBodyOpCount = cleanupCfgCheckedAdd(
                            consumingBodyOpCount,
                            1,
                            "cleanup_cfg: consuming CallOp body op overflow")
                if consumingBodyOpCount != 1:
                    cleanupCfgFail(
                        "cleanup_cfg: consuming CallOp body op missing")
            continue
        if call.resultOwnership != coreir.OwnMove &&
           call.resultOwnership != coreir.OwnBorrowShared:
            cleanupCfgFail(
                "cleanup_cfg: managed CallOp result ownership invalid")
        cleanupCfgRequireExactManagedSlot(bodyIR, call.resultSlot)
        if call.resultPassKind ==
               coreir.BodyCallPassForwardEntrySretTag ||
           call.resultExprNodeIndex < 0 ||
           call.resultValueDefinitionRow < 0:
            cleanupCfgFail(
                "cleanup_cfg: managed CallOp result authority invalid")
        if call.resultDefinitionOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag:
            if call.resultDefinitionOriginId !=
                   call.resultValueDefinitionRow ||
               call.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainInvalidTag ||
               call.sourceDefinitionRow != -1:
                cleanupCfgFail(
                    "cleanup_cfg: TypedExpr CallOp result authority invalid")
        elif call.resultDefinitionOriginKind ==
                 coreir.BodyDefinitionOriginCanonicalCleanupActionTag:
            if call.resultDefinitionOriginId < 0 ||
               call.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               call.sourceDefinitionRow < 0 ||
               call.sourceDefinitionRow >= bodyIR.ops.len ||
               call.resultValueDefinitionRow !=
                   bodyIR.ops[
                       call.sourceDefinitionRow].valueDefSemanticRow:
                cleanupCfgFail(
                    "cleanup_cfg: cleanup CallOp result authority invalid")
        else:
            cleanupCfgFail(
                "cleanup_cfg: managed CallOp result origin invalid")
        var matchedDefinitionOp: int32 = -1
        for opIndex in 0..<bodyIR.ops.len:
            let op = bodyIR.ops[opIndex]
            if op.kind == coreir.BodyOpCallTag &&
               op.operands.len == 1 &&
               op.operands[0] == callIndex:
                # wall95-B 判词富化：配对漂移联判逐列取数（守卫零弱化，
                # diag 臂为纯读布尔，与原联判逐字同构，仅失败臂取数）。
                let diagPairDup = matchedDefinitionOp >= 0
                let diagPairTarget = op.target != call.resultSlot
                let diagPairSlot = op.valueDefSlot != call.resultSlot
                let diagPairEni =
                    op.valueDefExprNodeIndex != call.resultExprNodeIndex
                let diagPairSemrow =
                    op.valueDefSemanticRow != call.resultValueDefinitionRow
                let diagPairOwn =
                    op.valueDefOwnership != call.resultOwnership
                let diagPairOkind =
                    op.valueDefOriginKind != call.resultDefinitionOriginKind
                let diagPairOid =
                    op.valueDefOriginId != call.resultDefinitionOriginId
                let diagPairDom =
                    op.sourceDefinitionDomain != call.sourceDefinitionDomain
                let diagPairSrow =
                    op.sourceDefinitionRow != call.sourceDefinitionRow
                # wall95-B 契约对齐：car 列按 decode owned-call-mirror
                # 生产不变量对齐（body_ir_access:4952 对 TypedExpr call
                # def 无条件钉 call.consumeActionRow==-1，def 侧消费账
                # （cop/car）归 def op 独有并由上方 per-op 臂全量审）；
                # 故配对 car 列仅在 call 侧携动作行且与 op 侧不一致时
                # 判漂移（managed-replace 对两侧同 action 行仍要求相等）。
                let diagPairCar =
                    (op.consumeActionRow != call.consumeActionRow) &&
                    call.consumeActionRow != -1
                if diagPairDup || diagPairTarget || diagPairSlot ||
                   diagPairEni || diagPairSemrow || diagPairOwn ||
                   diagPairOkind || diagPairOid || diagPairDom ||
                   diagPairSrow || diagPairCar:
                    cleanupCfgFail(
                        Fmt"cleanup_cfg: managed CallOp/BodyOp authority drift call={callIndex} op={opIndex} dup={diagPairDup} c_target={diagPairTarget} c_slot={diagPairSlot} c_eni={diagPairEni} c_semrow={diagPairSemrow} c_own={diagPairOwn} c_okind={diagPairOkind} c_oid={diagPairOid} c_dom={diagPairDom} c_srow={diagPairSrow} c_car={diagPairCar} op_car={op.consumeActionRow} call_car={call.consumeActionRow} call_own={int32(call.resultOwnership)} call_result={call.resultSlot} ops={bodyIR.ops.len}")
                matchedDefinitionOp = opIndex
        if matchedDefinitionOp < 0:
            cleanupCfgFail(
                "cleanup_cfg: managed CallOp definition BodyOp missing")
        if call.resultDefinitionOriginKind ==
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
           !cleanupCfgAccessOpReachesDefinition(
               access,
               matchedDefinitionOp,
               call.sourceDefinitionDomain,
               call.sourceDefinitionRow,
               false):
            cleanupCfgFail(
                "cleanup_cfg: cleanup CallOp source definition does not reach call")

    var returnReachingBuilt: bool
    var returnReached: bool[]
    var returnDefinitions: int32[]
    var returnMayBeUninitialized: bool[]
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        if term.kind != coreir.BodyTermReturnTag:
            continue
        if term.resultSlot < 0 ||
           term.resultSlot >= bodyIR.localSlots.len:
            continue
        let slot = bodyIR.localSlots[term.resultSlot]
        if slot.managedStorageKind !=
               coreir.BodyManagedStorageManagedTag:
            continue
        cleanupCfgRequireExactManagedSlot(bodyIR, term.resultSlot)
        if term.sourceDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           term.sourceDefinitionRow < 0 ||
           term.sourceDefinitionRow >= bodyIR.ops.len:
            cleanupCfgFail(
                "cleanup_cfg: managed return source definition missing")
        let definition = bodyIR.ops[term.sourceDefinitionRow]
        if definition.valueDefSlot != term.resultSlot ||
           definition.valueDefOwnership != coreir.OwnMove ||
           definition.valueDefOriginKind ==
               coreir.BodyDefinitionOriginUnknownTag:
            cleanupCfgFail(
                "cleanup_cfg: managed return requires owned value definition")
        if definition.valueDefConsumeOpIndexPlusOne != 0 ||
           definition.consumeActionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: managed return source definition already consumed")
        if !cleanupCfgAccessTermReachesDefinition(
               access,
               termIndex,
               term.sourceDefinitionDomain,
               term.sourceDefinitionRow):
            cleanupCfgFail(
                "cleanup_cfg: managed return definition does not reach term")
        if !returnReachingBuilt:
            cleanupCfgBuildReachingDefinitionBlockEnds(
                bodyIR,
                returnReached,
                returnDefinitions,
                returnMayBeUninitialized)
            returnReachingBuilt = true
        let returnBlockId =
            cleanupCfgReturnTermOwnerBlock(bodyIR, termIndex)
        if !returnReached[returnBlockId]:
            cleanupCfgFail(
                "cleanup_cfg: managed return block is unreachable")
        let returnStateIndex = cleanupCfgCheckedAdd(
            cleanupCfgCheckedMul(
                returnBlockId,
                bodyIR.localSlots.len,
                "cleanup_cfg: managed return state row overflow"),
            term.resultSlot,
            "cleanup_cfg: managed return state index overflow")
        let reachingDefinitionOpId =
            returnDefinitions[returnStateIndex]
        if reachingDefinitionOpId == -2:
            cleanupCfgFail(
                "cleanup_cfg: managed reaching definitions are ambiguous")
        if reachingDefinitionOpId < 0 ||
           returnMayBeUninitialized[returnStateIndex]:
            cleanupCfgFail(
                "cleanup_cfg: managed initialized reaching definition is missing")
        if reachingDefinitionOpId != term.sourceDefinitionRow:
            cleanupCfgFail(
                "cleanup_cfg: managed return reaching definition drift")

fn cleanupCfgTransferReachingDefinitions(
        bodyIR: var coreir.BodyIR,
        blockId: int32,
        inclusiveOpOrdinal: int32,
        stateStart: int32,
        definitions: var int32[],
        mayBeUninitialized: var bool[]) =
    if blockId < 0 || blockId >= bodyIR.blocks.len ||
       stateStart < 0 ||
       cleanupCfgCheckedAdd(
           stateStart,
           bodyIR.localSlots.len,
           "cleanup_cfg: reaching-definition transfer state overflow") >
           definitions.len ||
       definitions.len != mayBeUninitialized.len:
        cleanupCfgFail("cleanup_cfg: reaching-definition transfer shape invalid")
    let block = bodyIR.blocks[blockId]
    if block.id != blockId || block.opStart < 0 || block.opCount < 0 ||
       cleanupCfgCheckedAdd(
           block.opStart,
           block.opCount,
           "cleanup_cfg: reaching-definition op range overflow") >
           bodyIR.ops.len ||
       inclusiveOpOrdinal < -1 ||
       inclusiveOpOrdinal >= block.opCount:
        cleanupCfgFail("cleanup_cfg: reaching-definition op range invalid")
    if inclusiveOpOrdinal < 0:
        return
    for ordinal in 0..inclusiveOpOrdinal:
        let opIndex = cleanupCfgCheckedAdd(
            block.opStart,
            ordinal,
            "cleanup_cfg: reaching-definition op row overflow")
        let op = bodyIR.ops[opIndex]
        if op.valueDefOwnership == coreir.OwnInvalid:
            continue
        cleanupCfgValidateManagedDefinitionRow(bodyIR, opIndex)
        let stateIndex = cleanupCfgCheckedAdd(
            stateStart,
            op.valueDefSlot,
            "cleanup_cfg: reaching-definition transfer slot overflow")
        definitions[stateIndex] = opIndex
        mayBeUninitialized[stateIndex] = false

fn cleanupCfgMergeReachingDefinitionState(
        currentDefinition: var int32,
        currentMayBeUninitialized: var bool,
        incomingDefinition: int32,
        incomingMayBeUninitialized: bool,
        hasCurrent: bool) =
    if !hasCurrent:
        currentDefinition = incomingDefinition
        currentMayBeUninitialized = incomingMayBeUninitialized
        return
    if currentDefinition == -2 || incomingDefinition == -2:
        currentDefinition = -2
    elif incomingDefinition >= 0:
        if currentDefinition == -1:
            currentDefinition = incomingDefinition
        elif currentDefinition != incomingDefinition:
            currentDefinition = -2
    currentMayBeUninitialized =
        currentMayBeUninitialized || incomingMayBeUninitialized

fn cleanupCfgDefinitionBlock(bodyIR: var coreir.BodyIR,
                             definitionOpId: int32): int32 =
    var foundBlock = -1
    for blockId in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockId]
        if definitionOpId >= block.opStart &&
           definitionOpId <
               cleanupCfgCheckedAdd(
                   block.opStart,
                   block.opCount,
                   "cleanup_cfg: definition block range overflow"):
            if foundBlock >= 0:
                cleanupCfgFail(
                    "cleanup_cfg: managed definition belongs to multiple blocks")
            foundBlock = blockId
    if foundBlock < 0:
        cleanupCfgFail("cleanup_cfg: managed definition has no block")
    return foundBlock

fn cleanupCfgBlockIsCyclic(bodyIR: var coreir.BodyIR,
                           blockId: int32): bool =
    if blockId < 0 || blockId >= bodyIR.blocks.len:
        cleanupCfgFail("cleanup_cfg: cycle probe block out of range")
    var visited: bool[]
    for _ in 0..<bodyIR.blocks.len:
        add(visited, false)
    var queue: int32[]
    for successorId in 0..<bodyIR.blocks.len:
        if cleanupCfgBodyTermReachesBlock(bodyIR, blockId, successorId):
            if successorId == blockId:
                return true
            visited[successorId] = true
            add(queue, successorId)
    var cursor: int32
    while cursor < queue.len:
        let current = queue[cursor]
        cursor = cleanupCfgCheckedAdd(
            cursor,
            1,
            "cleanup_cfg: cycle probe cursor overflow")
        for successorId in 0..<bodyIR.blocks.len:
            if !cleanupCfgBodyTermReachesBlock(
                    bodyIR, current, successorId):
                continue
            if successorId == blockId:
                return true
            if !visited[successorId]:
                visited[successorId] = true
                add(queue, successorId)
    return false

fn cleanupCfgBuildReachingDefinitionBlockEnds(
        bodyIR: var coreir.BodyIR,
        reached: var bool[],
        definitions: var int32[],
        mayBeUninitialized: var bool[]) =
    let blockCount = bodyIR.blocks.len
    let localCount = bodyIR.localSlots.len
    if blockCount <= 0 || localCount <= 0 ||
       reached.len != 0 || definitions.len != 0 ||
       mayBeUninitialized.len != 0:
        cleanupCfgFail(
            "cleanup_cfg: reaching-definition build input invalid")
    let stateCount = cleanupCfgCheckedMul(
        blockCount,
        localCount,
        "cleanup_cfg: reaching-definition state overflow")
    var nextReached: bool[]
    var nextDefinitions: int32[]
    var nextMayBeUninitialized: bool[]
    for _ in 0..<blockCount:
        add(reached, false)
        add(nextReached, false)
    for _ in 0..<stateCount:
        add(definitions, -1)
        add(mayBeUninitialized, false)
        add(nextDefinitions, -1)
        add(nextMayBeUninitialized, false)
    let stepLimit = cleanupCfgCheckedAdd(
        cleanupCfgCheckedMul(
            blockCount,
            4,
            "cleanup_cfg: reaching-definition step limit overflow"),
        4,
        "cleanup_cfg: reaching-definition step limit overflow")
    var stepCount: int32
    var changed = true
    while changed:
        changed = false
        stepCount = cleanupCfgCheckedAdd(
            stepCount,
            1,
            "cleanup_cfg: reaching-definition step overflow")
        if stepCount > stepLimit:
            cleanupCfgFail(
                "cleanup_cfg: reaching-definition fixed point did not converge")
        for blockId in 0..<blockCount:
            nextReached[blockId] = false
            let rowStart = cleanupCfgCheckedMul(
                blockId,
                localCount,
                "cleanup_cfg: reaching-definition row overflow")
            for slot in 0..<localCount:
                nextDefinitions[rowStart + slot] = -1
                nextMayBeUninitialized[rowStart + slot] = false
            var hasIncoming = blockId == 0
            if hasIncoming:
                nextReached[blockId] = true
                for slot in 0..<localCount:
                    nextMayBeUninitialized[rowStart + slot] = true
            for predecessorId in 0..<blockCount:
                if !reached[predecessorId] ||
                   !cleanupCfgBodyTermReachesBlock(
                       bodyIR, predecessorId, blockId):
                    continue
                let predecessorStart = cleanupCfgCheckedMul(
                    predecessorId,
                    localCount,
                    "cleanup_cfg: reaching-definition predecessor row overflow")
                for slot in 0..<localCount:
                    var currentDefinition =
                        nextDefinitions[rowStart + slot]
                    var currentMayBeUninitialized =
                        nextMayBeUninitialized[rowStart + slot]
                    cleanupCfgMergeReachingDefinitionState(
                        currentDefinition,
                        currentMayBeUninitialized,
                        definitions[predecessorStart + slot],
                        mayBeUninitialized[predecessorStart + slot],
                        hasIncoming)
                    nextDefinitions[rowStart + slot] =
                        currentDefinition
                    nextMayBeUninitialized[rowStart + slot] =
                        currentMayBeUninitialized
                hasIncoming = true
                nextReached[blockId] = true
            if nextReached[blockId]:
                cleanupCfgTransferReachingDefinitions(
                    bodyIR,
                    blockId,
                    bodyIR.blocks[blockId].opCount - 1,
                    rowStart,
                    nextDefinitions,
                    nextMayBeUninitialized)
        for blockId in 0..<blockCount:
            if reached[blockId] != nextReached[blockId]:
                changed = true
            reached[blockId] = nextReached[blockId]
        for stateIndex in 0..<stateCount:
            if definitions[stateIndex] != nextDefinitions[stateIndex] ||
               mayBeUninitialized[stateIndex] !=
                   nextMayBeUninitialized[stateIndex]:
                changed = true
            definitions[stateIndex] = nextDefinitions[stateIndex]
            mayBeUninitialized[stateIndex] =
                nextMayBeUninitialized[stateIndex]

fn cleanupCfgResolveExactLiveOwnedDefinition(
        bodyIR: var coreir.BodyIR,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32,
        targetSlot: int32,
        rejectRecurrentDefinition: bool,
        mayBeUninitializedOut: var bool): int32 =
    let blockCount = bodyIR.blocks.len
    let localCount = bodyIR.localSlots.len
    if blockCount <= 0 || localCount <= 0 ||
       bodyBlockId < 0 || bodyBlockId >= blockCount ||
       targetSlot < 0 || targetSlot >= localCount:
        cleanupCfgFail(
            "cleanup_cfg: managed reaching-definition query invalid")
    var reached: bool[]
    var definitions: int32[]
    var mayBeUninitialized: bool[]
    cleanupCfgBuildReachingDefinitionBlockEnds(
        bodyIR, reached, definitions, mayBeUninitialized)
    if !reached[bodyBlockId]:
        cleanupCfgFail(
            "cleanup_cfg: managed reaching-definition site is unreachable")
    var siteDefinitions: int32[]
    var siteMayBeUninitialized: bool[]
    var hasIncoming = bodyBlockId == 0
    for _ in 0..<localCount:
        add(siteDefinitions, -1)
        add(siteMayBeUninitialized, hasIncoming)
    for predecessorId in 0..<blockCount:
        if !reached[predecessorId] ||
           !cleanupCfgBodyTermReachesBlock(
               bodyIR, predecessorId, bodyBlockId):
            continue
        let predecessorStart = cleanupCfgCheckedMul(
            predecessorId,
            localCount,
            "cleanup_cfg: reaching-definition site predecessor overflow")
        for slot in 0..<localCount:
            var currentDefinition = siteDefinitions[slot]
            var currentMayBeUninitialized =
                siteMayBeUninitialized[slot]
            cleanupCfgMergeReachingDefinitionState(
                currentDefinition,
                currentMayBeUninitialized,
                definitions[predecessorStart + slot],
                mayBeUninitialized[predecessorStart + slot],
                hasIncoming)
            siteDefinitions[slot] = currentDefinition
            siteMayBeUninitialized[slot] =
                currentMayBeUninitialized
        hasIncoming = true
    if !hasIncoming:
        cleanupCfgFail(
            "cleanup_cfg: managed reaching-definition site lacks incoming edge")
    cleanupCfgTransferReachingDefinitions(
        bodyIR,
        bodyBlockId,
        afterBodyOpOrdinal,
        0,
        siteDefinitions,
        siteMayBeUninitialized)
    let definitionOpId = siteDefinitions[targetSlot]
    if definitionOpId < 0:
        if definitionOpId == -2:
            cleanupCfgFail(
                "cleanup_cfg: managed reaching definitions are ambiguous")
        cleanupCfgFail(
            "cleanup_cfg: managed initialized reaching definition is missing")
    cleanupCfgValidateManagedDefinitionRow(bodyIR, definitionOpId)
    let definition = bodyIR.ops[definitionOpId]
    if definition.valueDefSlot != targetSlot ||
       definition.valueDefOwnership != coreir.OwnMove ||
       definition.valueDefConsumeOpIndexPlusOne != 0 ||
       definition.consumeActionRow != -1:
        cleanupCfgFail(
            "cleanup_cfg: managed reaching definition is not live owned value")
    let definitionBlock = cleanupCfgDefinitionBlock(bodyIR, definitionOpId)
    if rejectRecurrentDefinition &&
       cleanupCfgBlockIsCyclic(bodyIR, definitionBlock):
        cleanupCfgFail(
            "cleanup_cfg: captured-old definition is recurrent in a loop")
    mayBeUninitializedOut = siteMayBeUninitialized[targetSlot]
    return definitionOpId

fn cleanupCfgCollectOwnershipOpActionBindings(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipOpId: int32,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32,
        actionsOut: var cleanupOwnershipActionPreflight[],
        preflightOut: var cleanupExitPreflight): bool =
    let actionCount = odir.OwnershipDropAnalysisOpActionCount(
        ownershipAnalysis,
        ownershipOpId)
    var retainedSequence: bool
    var retainedActionId = -1
    var capturedOldSlot = -1
    var capturedOldStackOffset = -1
    var capturedOldSourceDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    var capturedOldSourceDefinitionRow = -1
    var capturedOldMayBeUninitialized: bool
    var capturedFieldCount: int32
    var capturedProjectionStepCount: int32
    var capturedFieldVisited: bool[]
    for _ in 0..<plan.ownershipFieldBindingPlaceIds.len:
        add(capturedFieldVisited, false)
    var retainAction: odir.OwnershipDropCleanupAction
    if actionCount > 0:
        retainAction = odir.OwnershipDropAnalysisOpAction(
            ownershipAnalysis,
            ownershipOpId,
            0)
        retainedSequence = retainAction.kind == odir.CleanupActionRetainValue
    # Classify the complete action surface before touching counters, CSR state,
    # high-water state, locals, or projection ledgers. A recoverable false is
    # therefore fingerprint-preserving without a semantic rollback journal.
    for ordinal in 0..<actionCount:
        let action = odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                        ownershipOpId,
                                                        ordinal)
        if !cleanupCfgOwnershipOpActionSurfaceSupported(action,
                                                        ownershipOpId):
            return false
    if retainedSequence:
        if actionCount < 2:
            cleanupCfgFail("cleanup_cfg: retained assign action sequence truncated")
        let storeAction = odir.OwnershipDropAnalysisOpAction(
            ownershipAnalysis,
            ownershipOpId,
            1)
        retainedActionId = cleanupCfgCheckedAdd(
            ownershipOpId,
            1,
            "cleanup_cfg: retained assign action id overflow")
        if retainAction.actionId != 0 ||
           storeAction.kind != odir.CleanupActionStoreOwned ||
           storeAction.actionId != retainedActionId ||
           retainAction.placeId != storeAction.otherPlaceId ||
           retainAction.otherPlaceId != storeAction.placeId ||
           retainAction.typeId != storeAction.typeId:
            cleanupCfgFail("cleanup_cfg: retained assign action sequence corrupt")
        let targetSlot = cleanupCfgOwnershipPlaceSlot(
            plan,
            storeAction.placeId)
        let sourceSlot = cleanupCfgOwnershipPlaceSlot(
            plan,
            storeAction.otherPlaceId)
        cleanupCfgRequireMatchingManagedSchemas(plan,
                                               targetSlot,
                                               sourceSlot,
                                               true)
        capturedOldSourceDefinitionRow =
            cleanupCfgResolveExactLiveOwnedDefinition(
                bodyIR,
                bodyBlockId,
                afterBodyOpOrdinal,
                targetSlot,
                true,
                capturedOldMayBeUninitialized)
        capturedOldSourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        capturedOldSlot = bodyIR.localSlots.len
        capturedOldStackOffset = cleanupCfgAllocateCapturedStackOffset(
            plan,
            plan.localSizeBytes[targetSlot],
            plan.localAlignBytes[targetSlot])

    for ordinal in 0..<actionCount:
        var action = odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                        ownershipOpId,
                                                        ordinal)
        let capturedDrop =
            retainedSequence &&
            ordinal >= 2 &&
            action.actionId == retainedActionId &&
            (action.kind == odir.CleanupActionDropPlace ||
             action.kind == odir.CleanupActionDropField)
        if action.kind == odir.CleanupActionStoreOwned || capturedDrop:
            odir.OwnershipDropProjectCapturedOldDefinitionAuthority(
                action,
                capturedOldSourceDefinitionDomain,
                capturedOldSourceDefinitionRow)
        var out: cleanupOwnershipActionPreflight
        out.kind = action.kind
        out.actionId = action.actionId
        out.edgeId = -1
        out.opId = ownershipOpId
        out.ordinal = ordinal
        out.cleanupDeferId = -1
        out.targetSlot = -1
        out.sourceSlot = -1
        out.dropGlueBindingIndex = -1
        out.retainGlueBindingIndex = -1
        out.capturedOldSlot = -1
        out.capturedOldStackOffset = -1
        out.capturedFieldSourceBindingIndex = -1
        out.capturedFieldOwnerStackOffset = -1
        out.fieldProjectionBindingIndex = -1
        out.ownershipPlaceId = action.placeId
        out.fieldOrdinal = action.fieldOrdinal
        out.ownershipTypeId = -1
        out.ownershipLayoutCid = ""
        out.definitionOriginKind = action.definitionOriginKind
        out.definitionOriginId = action.definitionOriginId
        out.sourceDefinitionDomain =
            action.sourceDefinitionDomain
        out.sourceDefinitionRow = action.sourceDefinitionRow
        out.capturedOldSourceDefinitionDomain =
            action.capturedOldSourceDefinitionDomain
        out.capturedOldSourceDefinitionRow =
            action.capturedOldSourceDefinitionRow
        out.sourceOwnership = action.sourceOwnership
        out.consumeActionRow = action.consumeActionRow
        out.guardCleanupDeferId = -1
        out.guardOwnershipDeferId = -1
        out.primaryKind = action.conditionKind
        out.primaryFlagId = action.conditionFlagId
        out.primaryFlagSlot = cleanupCfgOwnershipConditionLocal(
            plan,
            ownershipAnalysis,
            action,
            action.conditionKind,
            action.conditionFlagId,
            -1)
        out.primaryNegated = action.conditionNegated
        out.secondaryKind = action.conditionOtherKind
        out.secondaryFlagId = action.conditionOtherFlagId
        out.secondaryFlagSlot = cleanupCfgOwnershipConditionLocal(
            plan,
            ownershipAnalysis,
            action,
            action.conditionOtherKind,
            action.conditionOtherFlagId,
            -1)
        out.secondaryNegated = action.conditionOtherNegated
        out.guardKind = odir.DropConditionAlways
        out.guardFlagId = -1
        out.guardFlagSlot = -1
        if action.kind == odir.CleanupActionRetainValue:
            if !retainedSequence || ordinal != 0 || action.actionId != 0 ||
               action.placeId <= 0 || action.otherPlaceId <= 0 ||
               action.fieldOrdinal != -1 || action.typeId <= 0 ||
               action.dropGlueId != 0 ||
               action.conditionKind != odir.DropConditionAlways ||
               action.conditionOtherKind != odir.DropConditionAlways:
                cleanupCfgFail("cleanup_cfg: retained value action malformed")
            out.targetSlot = cleanupCfgOwnershipPlaceSlot(plan,
                                                           action.placeId)
            out.sourceSlot = cleanupCfgOwnershipPlaceSlot(plan,
                                                           action.otherPlaceId)
            cleanupCfgRequireMatchingManagedSchemas(plan,
                                                   out.targetSlot,
                                                   out.sourceSlot,
                                                   true)
            out.retainGlueBindingIndex =
                cleanupCfgOwnershipRetainGlueBinding(plan, action.typeId)
            let sourceBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                action.placeId)
            let targetBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                action.otherPlaceId)
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipPlaceBindingTypeIds[sourceBinding],
                plan.ownershipPlaceBindingLayoutCids[sourceBinding],
                "cleanup_cfg: retain source type layout mismatch")
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipPlaceBindingTypeIds[targetBinding],
                plan.ownershipPlaceBindingLayoutCids[targetBinding],
                "cleanup_cfg: retain target type layout mismatch")
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipRetainGlueBindingTypeIds[out.retainGlueBindingIndex],
                plan.ownershipRetainGlueBindingLayoutCids[out.retainGlueBindingIndex],
                "cleanup_cfg: retain glue type layout mismatch")
            out.ownershipTypeId = action.typeId
            out.ownershipLayoutCid =
                cleanupCfgOwnedTextCopy(
                    plan.ownershipPlaceBindingLayoutCids[sourceBinding])
        elif action.kind == odir.CleanupActionStoreOwned:
            if !retainedSequence || ordinal != 1 ||
               action.actionId != retainedActionId ||
               action.placeId <= 0 || action.otherPlaceId <= 0 ||
               action.fieldOrdinal != -1 || action.typeId <= 0 ||
               action.dropGlueId != 0 ||
               action.conditionKind != odir.DropConditionAlways ||
               action.conditionOtherKind != odir.DropConditionAlways:
                cleanupCfgFail("cleanup_cfg: store-owned action malformed")
            out.targetSlot = cleanupCfgOwnershipPlaceSlot(plan,
                                                           action.placeId)
            out.sourceSlot = cleanupCfgOwnershipPlaceSlot(plan,
                                                           action.otherPlaceId)
            cleanupCfgRequireMatchingManagedSchemas(plan,
                                                   out.targetSlot,
                                                   out.sourceSlot,
                                                   true)
            out.capturedOldSlot = capturedOldSlot
            out.capturedOldStackOffset = capturedOldStackOffset
            let targetBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                action.placeId)
            let sourceBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                action.otherPlaceId)
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipPlaceBindingTypeIds[targetBinding],
                plan.ownershipPlaceBindingLayoutCids[targetBinding],
                "cleanup_cfg: store-owned target type layout mismatch")
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipPlaceBindingTypeIds[sourceBinding],
                plan.ownershipPlaceBindingLayoutCids[sourceBinding],
                "cleanup_cfg: store-owned source type layout mismatch")
            out.ownershipTypeId = action.typeId
            out.ownershipLayoutCid =
                cleanupCfgOwnedTextCopy(
                    plan.ownershipPlaceBindingLayoutCids[targetBinding])
        elif action.kind == odir.CleanupActionDropPlace ||
             action.kind == odir.CleanupActionDropField:
            if action.placeId <= 0 || action.otherPlaceId != -1 ||
               action.typeId <= 0 || action.dropGlueId <= 0:
                cleanupCfgFail("cleanup_cfg: ownership op drop action malformed")
            out.dropGlueBindingIndex = cleanupCfgOwnershipDropGlueBinding(
                plan,
                action.dropGlueId)
            var targetTypeId: int32
            var targetLayoutCid: str
            if action.kind == odir.CleanupActionDropPlace:
                let placeBinding = cleanupCfgOwnershipPlaceBindingIndex(
                    plan,
                    action.placeId)
                targetTypeId = plan.ownershipPlaceBindingTypeIds[placeBinding]
                targetLayoutCid =
                    plan.ownershipPlaceBindingLayoutCids[placeBinding]
            else:
                let fieldBinding = cleanupCfgOwnershipFieldBindingIndex(
                    plan,
                    action.placeId,
                    action.fieldOrdinal)
                targetTypeId =
                    plan.ownershipFieldBindingLeafTypeIds[fieldBinding]
                targetLayoutCid =
                    plan.ownershipFieldBindingLeafLayoutCids[fieldBinding]
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                targetTypeId,
                targetLayoutCid,
                "cleanup_cfg: drop target type layout mismatch")
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipDropGlueBindingTypeIds[out.dropGlueBindingIndex],
                plan.ownershipDropGlueBindingLayoutCids[out.dropGlueBindingIndex],
                "cleanup_cfg: drop glue type layout mismatch")
            out.ownershipTypeId = action.typeId
            out.ownershipLayoutCid =
                cleanupCfgOwnedTextCopy(targetLayoutCid)
            if retainedSequence:
                if ordinal < 2 || action.actionId != retainedActionId:
                    cleanupCfgFail("cleanup_cfg: retained old-drop identity mismatch")
                out.capturedOldSlot = capturedOldSlot
                if action.kind == odir.CleanupActionDropPlace:
                    if action.fieldOrdinal != -1:
                        cleanupCfgFail("cleanup_cfg: captured whole-drop field invalid")
                    out.targetSlot = capturedOldSlot
                else:
                    if action.fieldOrdinal < 0:
                        cleanupCfgFail("cleanup_cfg: captured field-drop ordinal invalid")
                    let sourceProjectionBindingIndex =
                        cleanupCfgOwnershipFieldBindingIndex(
                            plan,
                            action.placeId,
                            action.fieldOrdinal)
                    if capturedFieldVisited[sourceProjectionBindingIndex]:
                        cleanupCfgFail("cleanup_cfg: captured field projection reused")
                    capturedFieldVisited[sourceProjectionBindingIndex] = true
                    plan.fieldDedupVisitCount = cleanupCfgCheckedAdd(
                        plan.fieldDedupVisitCount,
                        1,
                        "cleanup_cfg: field dedup visit counter overflow")
                    out.capturedFieldSourceBindingIndex =
                        sourceProjectionBindingIndex
                    out.fieldProjectionBindingIndex = cleanupCfgCheckedAdd(
                        plan.ownershipFieldBindingPlaceIds.len,
                        capturedFieldCount,
                        "cleanup_cfg: captured projection binding overflow")
                    let capturedProjectionSlot = cleanupCfgCheckedAdd(
                        cleanupCfgCheckedAdd(
                            capturedOldSlot,
                            1,
                            "cleanup_cfg: captured projection slot overflow"),
                        cleanupCfgCheckedMul(
                            capturedFieldCount,
                            2,
                            "cleanup_cfg: captured projection slot overflow"),
                        "cleanup_cfg: captured projection slot overflow")
                    out.targetSlot = cleanupCfgCheckedAdd(
                        capturedProjectionSlot,
                        1,
                        "cleanup_cfg: captured field owner slot overflow")
                    let sourceProjectionSlot =
                        plan.ownershipFieldBindingProjectionSlots[
                            sourceProjectionBindingIndex]
                    out.capturedFieldOwnerStackOffset =
                        cleanupCfgAllocateCapturedStackOffset(
                            plan,
                            plan.localSizeBytes[sourceProjectionSlot],
                            plan.localAlignBytes[sourceProjectionSlot])
                    capturedFieldCount = cleanupCfgCheckedAdd(
                        capturedFieldCount,
                        1,
                        "cleanup_cfg: captured projection count overflow")
                    capturedProjectionStepCount = cleanupCfgCheckedAdd(
                        capturedProjectionStepCount,
                        plan.ownershipFieldBindingStepCounts[
                            sourceProjectionBindingIndex],
                        "cleanup_cfg: captured projection step overflow")
            else:
                if action.actionId != 0:
                    cleanupCfgFail("cleanup_cfg: uncaptured op drop has action id")
                if action.kind == odir.CleanupActionDropPlace:
                    if action.fieldOrdinal != -1:
                        cleanupCfgFail("cleanup_cfg: whole-drop field invalid")
                    out.targetSlot = cleanupCfgOwnershipPlaceSlot(
                        plan,
                        action.placeId)
                else:
                    if action.fieldOrdinal < 0:
                        cleanupCfgFail("cleanup_cfg: field-drop ordinal invalid")
                    out.fieldProjectionBindingIndex =
                        cleanupCfgOwnershipFieldBindingIndex(
                            plan,
                            action.placeId,
                            action.fieldOrdinal)
                    let projectionBindingIndex =
                        out.fieldProjectionBindingIndex
                    out.targetSlot =
                        plan.ownershipFieldBindingProjectionSlots[projectionBindingIndex]
        elif action.kind == odir.CleanupActionStoreMove:
            if retainedSequence || action.actionId != 0 ||
               action.placeId <= 0 || action.otherPlaceId <= 0 ||
               action.fieldOrdinal != -1 || action.typeId <= 0 ||
               action.dropGlueId != 0 ||
               action.conditionKind != odir.DropConditionAlways ||
               action.conditionOtherKind != odir.DropConditionAlways:
                cleanupCfgFail("cleanup_cfg: store-move action malformed")
            out.targetSlot = cleanupCfgOwnershipPlaceSlot(plan,
                                                           action.placeId)
            out.sourceSlot = cleanupCfgOwnershipPlaceSlot(plan,
                                                           action.otherPlaceId)
            cleanupCfgRequireMatchingManagedSchemas(plan,
                                                   out.targetSlot,
                                                   out.sourceSlot,
                                                   false)
            let targetBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                action.placeId)
            let sourceBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                action.otherPlaceId)
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipPlaceBindingTypeIds[targetBinding],
                plan.ownershipPlaceBindingLayoutCids[targetBinding],
                "cleanup_cfg: store-move target type layout mismatch")
            cleanupCfgRequireActionTypeContract(
                plan,
                action.typeId,
                plan.ownershipPlaceBindingTypeIds[sourceBinding],
                plan.ownershipPlaceBindingLayoutCids[sourceBinding],
                "cleanup_cfg: store-move source type layout mismatch")
            out.ownershipTypeId = action.typeId
            out.ownershipLayoutCid =
                cleanupCfgOwnedTextCopy(
                    plan.ownershipPlaceBindingLayoutCids[targetBinding])
        else:
            cleanupCfgFail("cleanup_cfg: ownership action preclassification drift")
        if action.kind == odir.CleanupActionDropPlace ||
           action.kind == odir.CleanupActionDropField:
            var preservesPlaceState = action.actionId > 0
            for laterOrdinal in (ordinal + 1)..<actionCount:
                let later = odir.OwnershipDropAnalysisOpAction(
                    ownershipAnalysis,
                    ownershipOpId,
                    laterOrdinal)
                if (later.kind == odir.CleanupActionStoreOwned ||
                    later.kind == odir.CleanupActionStoreMove) &&
                   later.placeId == action.placeId:
                    preservesPlaceState = true
            if !preservesPlaceState:
                let conditionFlagCount =
                    odir.OwnershipDropAnalysisConditionFlagCount(
                        ownershipAnalysis)
                for flagId in 1..conditionFlagCount:
                    let flag = odir.OwnershipDropAnalysisConditionFlag(
                        ownershipAnalysis,
                        flagId)
                    let clearsWholePlace =
                        action.kind == odir.CleanupActionDropPlace &&
                        flag.placeId == action.placeId &&
                        (flag.kind ==
                             odir.ConditionFlagPlaceInitialized ||
                         flag.kind ==
                             odir.ConditionFlagFieldInitialized)
                    let clearsOneField =
                        action.kind == odir.CleanupActionDropField &&
                        flag.placeId == action.placeId &&
                        ((flag.kind ==
                              odir.ConditionFlagPlaceInitialized &&
                          flag.fieldOrdinal == -1) ||
                         (flag.kind ==
                              odir.ConditionFlagFieldInitialized &&
                          flag.fieldOrdinal == action.fieldOrdinal))
                    if clearsWholePlace || clearsOneField:
                        add(out.clearFlagSlots,
                            cleanupCfgOwnershipFlagSlot(
                                plan,
                                ownershipAnalysis,
                                flagId))
                if out.clearFlagSlots.len <= 0:
                    cleanupCfgFail(
                        "cleanup_cfg: ownership op drop lacks clear flags")
        cleanupCfgAccumulateOwnershipOpActionBudget(out, preflightOut)
        add(actionsOut, out)
    if retainedSequence && capturedOldMayBeUninitialized:
        var guardedCapturedDrop: bool
        for actionIndex in 0..<actionsOut.len:
            let action = actionsOut[actionIndex]
            if action.capturedOldSourceDefinitionDomain ==
                   capturedOldSourceDefinitionDomain &&
               action.capturedOldSourceDefinitionRow ==
                   capturedOldSourceDefinitionRow &&
               (action.kind == odir.CleanupActionDropPlace ||
                action.kind == odir.CleanupActionDropField) &&
               (action.primaryKind ==
                    odir.DropConditionCapturedOldPlace ||
                action.primaryKind ==
                    odir.DropConditionCapturedOldField ||
                action.secondaryKind ==
                    odir.DropConditionCapturedOldPlace ||
                action.secondaryKind ==
                    odir.DropConditionCapturedOldField):
                guardedCapturedDrop = true
        if !guardedCapturedDrop:
            cleanupCfgFail(
                "cleanup_cfg: partial-init captured-old definition lacks exact guard")

    if retainedSequence:
        let requiredLocalCount = cleanupCfgCheckedAdd(
            1,
            cleanupCfgCheckedMul(
                capturedFieldCount,
                2,
                "cleanup_cfg: captured field local count overflow"),
            "cleanup_cfg: captured-old local count overflow")
        preflightOut.sourcePreparationLocalDelta = requiredLocalCount
        let localRemaining = cleanupCfgCheckedSub(
            plan.limits.maxLocalSlotCount,
            bodyIR.localSlots.len,
            "cleanup_cfg: captured-old local capacity underflow")
        if requiredLocalCount > localRemaining:
            cleanupCfgFail("cleanup_cfg: captured-old local arena exhausted")
        let fieldRemaining = cleanupCfgCheckedSub(
            plan.limits.maxOwnershipFieldBindingCount,
            plan.ownershipFieldBindingPlaceIds.len,
            "cleanup_cfg: captured field binding capacity underflow")
        if capturedFieldCount > fieldRemaining:
            cleanupCfgFail("cleanup_cfg: captured field binding arena exhausted")
        let stepRemaining = cleanupCfgCheckedSub(
            plan.limits.maxOwnershipFieldProjectionStepCount,
            plan.ownershipFieldProjectionOrdinals.len,
            "cleanup_cfg: captured projection capacity underflow")
        if capturedProjectionStepCount > stepRemaining:
            cleanupCfgFail("cleanup_cfg: captured projection arena exhausted")
    return true

fn cleanupCfgPreflightOwnershipOpSite(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipOpId: int32,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32,
        actionsOut: var cleanupOwnershipActionPreflight[],
        transitionPreflightOut: var cleanupFlagTransitionPreflight,
        preflightOut: var cleanupExitPreflight): bool =
    cleanupCfgRequireRegistrationOpen(plan)
    if !ownershipAnalysis.converged || ownershipOpId < 0 ||
       ownershipOpId >= ownershipAnalysis.opActionCounts.len ||
       bodyBlockId < 0 || bodyBlockId >= bodyIR.blocks.len ||
       bodyIR.blocks[bodyBlockId].id != bodyBlockId ||
       afterBodyOpOrdinal < 0 ||
       afterBodyOpOrdinal >= bodyIR.blocks[bodyBlockId].opCount:
        cleanupCfgFail("cleanup_cfg: ownership op transition site invalid")
    for opRow in 0..<plan.ownershipOpTransitionOwnershipOpIds.len:
        if plan.ownershipOpTransitionOwnershipOpIds[opRow] == ownershipOpId:
            cleanupCfgFail("cleanup_cfg: ownership op transition registered twice")
    if plan.ownershipOpTransitionOwnershipOpIds.len >=
       plan.limits.maxOwnershipOpTransitionSiteCount:
        cleanupCfgFail("cleanup_cfg: ownership op transition row arena exhausted")
    var existingSite = -1
    for siteIndex in 0..<plan.ownershipOpTransitionBodyBlockIds.len:
        if plan.ownershipOpTransitionBodyBlockIds[siteIndex] == bodyBlockId &&
           plan.ownershipOpTransitionAfterOpOrdinals[siteIndex] ==
               afterBodyOpOrdinal:
            existingSite = siteIndex
    if existingSite < 0 &&
       plan.ownershipOpTransitionBodyBlockIds.len >=
           plan.limits.maxOwnershipOpTransitionSiteCount:
        cleanupCfgFail("cleanup_cfg: ownership op transition site arena exhausted")
    if existingSite >= 0 &&
       (existingSite !=
            plan.ownershipOpTransitionBodyBlockIds.len - 1 ||
        plan.ownershipOpTransitionSiteStarts[existingSite] +
            plan.ownershipOpTransitionSiteCounts[existingSite] !=
                plan.ownershipOpTransitionOwnershipOpIds.len):
        cleanupCfgFail(
            "cleanup_cfg: ownership op transition site CSR is not appendable")
    if !cleanupCfgCollectOwnershipOpActionBindings(
            plan,
            bodyIR,
            ownershipAnalysis,
            ownershipOpId,
            bodyBlockId,
            afterBodyOpOrdinal,
            actionsOut,
            preflightOut):
        return false
    let actionRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipActionCount,
        plan.ownershipActionKinds.len,
        "cleanup_cfg: ownership action capacity underflow")
    if actionsOut.len > actionRemaining:
        cleanupCfgFail("cleanup_cfg: ownership action arena exhausted")
    var clearFlagCount: int32
    for actionIndex in 0..<actionsOut.len:
        clearFlagCount = cleanupCfgCheckedAdd(
            clearFlagCount,
            actionsOut[actionIndex].clearFlagSlots.len,
            "cleanup_cfg: ownership op clear flag count overflow")
    let clearFlagRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipActionFlagRefCount,
        plan.ownershipActionClearFlagSlots.len,
        "cleanup_cfg: ownership clear flag capacity underflow")
    if clearFlagCount > clearFlagRemaining:
        cleanupCfgFail("cleanup_cfg: ownership clear flag arena exhausted")
    cleanupCfgAccumulateOwnershipOpSiteSnapshotBudget(actionsOut,
                                                      plan,
                                                      existingSite,
                                                      preflightOut)
    transitionPreflightOut = cleanupCfgPreflightFlagTransitions(
        plan,
        ownershipAnalysis,
        odir.FlagOriginOp,
        ownershipOpId)
    let transitionCount = transitionPreflightOut.originKinds.len
    if actionsOut.len <= 0 && transitionCount <= 0:
        cleanupCfgFail("cleanup_cfg: ownership op has no runtime effect")
    preflightOut.materializedOpDelta = cleanupCfgCheckedAdd(
        preflightOut.materializedOpDelta,
        transitionCount,
        "cleanup_cfg: ownership op materialized count overflow")
    preflightOut.materializedOperandDelta = cleanupCfgCheckedAdd(
        preflightOut.materializedOperandDelta,
        cleanupCfgCheckedMul(transitionCount,
                             2,
                             "cleanup_cfg: ownership transition operand overflow"),
        "cleanup_cfg: ownership op operand count overflow")
    var siteHasTransitions: bool
    if existingSite >= 0:
        let siteStart =
            plan.ownershipOpTransitionSiteStarts[existingSite]
        let siteCount =
            plan.ownershipOpTransitionSiteCounts[existingSite]
        for siteOffset in 0..<siteCount:
            if plan.ownershipOpTransitionCounts[
                   siteStart + siteOffset] > 0:
                siteHasTransitions = true
    if transitionCount > 0 && !siteHasTransitions:
        preflightOut.materializedBlockDelta = cleanupCfgCheckedAdd(
            preflightOut.materializedBlockDelta,
            1,
            "cleanup_cfg: ownership transition block overflow")
        preflightOut.materializedTermDelta = cleanupCfgCheckedAdd(
            preflightOut.materializedTermDelta,
            1,
            "cleanup_cfg: ownership transition term overflow")
    if existingSite < 0:
        preflightOut.materializedBlockDelta = cleanupCfgCheckedAdd(
            preflightOut.materializedBlockDelta,
            1,
            "cleanup_cfg: ownership op continuation block overflow")
        preflightOut.materializedTermDelta = cleanupCfgCheckedAdd(
            preflightOut.materializedTermDelta,
            1,
            "cleanup_cfg: ownership op bridge term overflow")
    cleanupCfgRequireMaterializedPreflight(plan, preflightOut)
    return true

fn CleanupPlanPreflightOwnershipOpSite(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipOpId: int32,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32): bool =
    var delta: CleanupMutationDelta
    var bodyCandidate: coreir.BodyIR
    var planCandidate: CleanupPlan
    cleanupCfgBeginBodyPlanMutation(bodyIR,
                                    plan,
                                    bodyCandidate,
                                    planCandidate,
                                    delta)
    var actions: cleanupOwnershipActionPreflight[]
    var transitionPreflight: cleanupFlagTransitionPreflight
    var preflight: cleanupExitPreflight
    let supported = cleanupCfgPreflightOwnershipOpSite(
        planCandidate,
        bodyCandidate,
        ownershipAnalysis,
        ownershipOpId,
        bodyBlockId,
        afterBodyOpOrdinal,
        actions,
        transitionPreflight,
        preflight)
    cleanupCfgRestorePreflightMutation(planCandidate, delta)
    cleanupCfgRollbackBodyPlanMutation(bodyIR,
                                       plan,
                                       bodyCandidate,
                                       planCandidate,
                                       delta)
    return supported

@borrows
fn cleanupCfgAppendCapturedFieldProjection(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        action: cleanupOwnershipActionPreflight): int32 =
    let sourceBinding = action.capturedFieldSourceBindingIndex
    let capturedBaseSlot = action.capturedOldSlot
    if sourceBinding < 0 ||
       sourceBinding >= plan.ownershipFieldBindingPlaceIds.len ||
       capturedBaseSlot < 0 || capturedBaseSlot >= bodyIR.localSlots.len:
        cleanupCfgFail("cleanup_cfg: captured field projection preflight drift")
    let sourceProjectionSlot =
        plan.ownershipFieldBindingProjectionSlots[sourceBinding]
    let sourceProjection = bodyIR.localSlots[sourceProjectionSlot]
    let capturedBase = bodyIR.localSlots[capturedBaseSlot]
    let relativeOffset = cleanupCfgFieldBindingRelativeOffset(
        plan,
        sourceBinding,
        capturedBase.sizeBytes)
    let projectionSlot = bodyIR.localSlots.len
    if projectionSlot != action.targetSlot - 1 ||
       plan.ownershipFieldBindingPlaceIds.len !=
           action.fieldProjectionBindingIndex:
        cleanupCfgFail("cleanup_cfg: captured field projection slot drift")
    var projection: coreir.LocalSlot
    projection.id = projectionSlot
    projection.name = Fmt"#cleanup_captured_field#{action.actionId}#{plan.ownershipFieldBindingOrdinals[sourceBinding]}"
    projection.typeKind = sourceProjection.typeKind
    projection.placeKind = coreir.BodyPlaceBorrowAddressTag
    projection.stackOffset = cleanupCfgCheckedAdd(
        capturedBase.stackOffset,
        relativeOffset,
        "cleanup_cfg: captured projection stack offset overflow")
    projection.sizeBytes = sourceProjection.sizeBytes
    projection.alignBytes = sourceProjection.alignBytes
    projection.auxValue = capturedBaseSlot
    projection.ownership = coreir.OwnPlain
    projection.aliasClass = coreir.AliasUnknown
    projection.escapeKind = coreir.EscapeNone
    projection.noAlias = false
    projection.typeArenaTypeId = sourceProjection.typeArenaTypeId
    projection.managedStorageKind = sourceProjection.managedStorageKind
    let stepStart = plan.ownershipFieldProjectionOrdinals.len
    let sourceStepStart = plan.ownershipFieldBindingStepStarts[sourceBinding]
    let stepCount = plan.ownershipFieldBindingStepCounts[sourceBinding]
    add(plan.ownershipFieldBindingPlaceIds,
        plan.ownershipFieldBindingPlaceIds[sourceBinding])
    add(plan.ownershipFieldBindingOrdinals,
        plan.ownershipFieldBindingOrdinals[sourceBinding])
    add(plan.ownershipFieldBindingBaseSlots, capturedBaseSlot)
    add(plan.ownershipFieldBindingProjectionSlots, projectionSlot)
    add(plan.ownershipFieldBindingStepStarts, stepStart)
    add(plan.ownershipFieldBindingStepCounts, stepCount)
    add(plan.ownershipFieldBindingCapturedActionIds, action.actionId)
    add(plan.ownershipFieldBindingOwnerTypeIds,
        plan.ownershipFieldBindingOwnerTypeIds[sourceBinding])
    add(plan.ownershipFieldBindingOwnerLayoutCids,
        strings.CloneStr(plan.ownershipFieldBindingOwnerLayoutCids[sourceBinding]))
    add(plan.ownershipFieldBindingLeafTypeIds,
        plan.ownershipFieldBindingLeafTypeIds[sourceBinding])
    add(plan.ownershipFieldBindingLeafLayoutCids,
        strings.CloneStr(plan.ownershipFieldBindingLeafLayoutCids[sourceBinding]))
    for stepOffset in 0..<stepCount:
        let row = cleanupCfgCheckedAdd(
            sourceStepStart,
            stepOffset,
            "cleanup_cfg: captured projection source row overflow")
        add(plan.ownershipFieldProjectionOrdinals,
            plan.ownershipFieldProjectionOrdinals[row])
        add(plan.ownershipFieldProjectionByteOffsets,
            plan.ownershipFieldProjectionByteOffsets[row])
        add(plan.ownershipFieldProjectionContainerSizes,
            plan.ownershipFieldProjectionContainerSizes[row])
        add(plan.ownershipFieldProjectionTypeKinds,
            plan.ownershipFieldProjectionTypeKinds[row])
        add(plan.ownershipFieldProjectionSizeBytes,
            plan.ownershipFieldProjectionSizeBytes[row])
        add(plan.ownershipFieldProjectionAlignBytes,
            plan.ownershipFieldProjectionAlignBytes[row])
        add(plan.ownershipFieldProjectionTypeIds,
            plan.ownershipFieldProjectionTypeIds[row])
        add(plan.ownershipFieldProjectionLayoutCids,
            strings.CloneStr(plan.ownershipFieldProjectionLayoutCids[row]))
    let projectionTypeKind = projection.typeKind
    let projectionTypeArenaTypeId = projection.typeArenaTypeId
    let projectionManagedStorageKind = projection.managedStorageKind
    let projectionPlaceKind = projection.placeKind
    let projectionSizeBytes = projection.sizeBytes
    let projectionAlignBytes = projection.alignBytes
    add(bodyIR.localSlots, projection)
    coreir.BodyIREntryDefinitionOwnershipAppendSyntheticSlot(
        bodyIR, projectionSlot)
    add(plan.localTypeKinds, projectionTypeKind)
    add(plan.localTypeArenaTypeIds, projectionTypeArenaTypeId)
    add(plan.localManagedStorageKinds, projectionManagedStorageKind)
    add(plan.localPlaceKinds, projectionPlaceKind)
    add(plan.localSizeBytes, projectionSizeBytes)
    add(plan.localAlignBytes, projectionAlignBytes)
    return projectionSlot

@borrows
fn cleanupCfgAppendCapturedFieldOwner(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        action: cleanupOwnershipActionPreflight,
        projectionSlot: int32): int32 =
    if projectionSlot < 0 || projectionSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots.len != action.targetSlot ||
       action.capturedFieldOwnerStackOffset < 0:
        cleanupCfgFail("cleanup_cfg: captured field owner preflight drift")
    let projection = bodyIR.localSlots[projectionSlot]
    var owner: coreir.LocalSlot
    owner.id = action.targetSlot
    owner.name =
        Fmt"#cleanup_captured_field_owner#{action.actionId}#{action.fieldOrdinal}"
    owner.typeKind = projection.typeKind
    owner.stackOffset = action.capturedFieldOwnerStackOffset
    owner.sizeBytes = projection.sizeBytes
    owner.alignBytes = projection.alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(owner)
    owner.typeArenaTypeId = projection.typeArenaTypeId
    owner.managedStorageKind = projection.managedStorageKind
    let ownerId = owner.id
    let ownerTypeKind = owner.typeKind
    let ownerTypeArenaTypeId = owner.typeArenaTypeId
    let ownerManagedStorageKind = owner.managedStorageKind
    let ownerPlaceKind = owner.placeKind
    let ownerSizeBytes = owner.sizeBytes
    let ownerAlignBytes = owner.alignBytes
    add(bodyIR.localSlots, owner)
    coreir.BodyIREntryDefinitionOwnershipAppendSyntheticSlot(
        bodyIR, ownerId)
    add(plan.localTypeKinds, ownerTypeKind)
    add(plan.localTypeArenaTypeIds, ownerTypeArenaTypeId)
    add(plan.localManagedStorageKinds, ownerManagedStorageKind)
    add(plan.localPlaceKinds, ownerPlaceKind)
    add(plan.localSizeBytes, ownerSizeBytes)
    add(plan.localAlignBytes, ownerAlignBytes)
    return ownerId

fn cleanupCfgStageCapturedOldLocals(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        actions: var cleanupOwnershipActionPreflight[]) =
    var storeActionIndex = -1
    for actionIndex in 0..<actions.len:
        if actions[actionIndex].kind == odir.CleanupActionStoreOwned:
            if storeActionIndex >= 0:
                cleanupCfgFail("cleanup_cfg: multiple store-owned actions per op")
            storeActionIndex = actionIndex
    if storeActionIndex < 0:
        for actionIndex in 0..<actions.len:
            let action = actions[actionIndex]
            if action.capturedOldSlot >= 0 ||
               action.fieldProjectionBindingIndex >= 0:
                cleanupCfgFail("cleanup_cfg: captured-old action lacks store")
        return
    let store = actions[storeActionIndex]
    if bodyIR.localSlots.len != store.capturedOldSlot:
        cleanupCfgFail("cleanup_cfg: captured-old slot id drift")
    let target = bodyIR.localSlots[store.targetSlot]
    var captured: coreir.LocalSlot
    captured.id = store.capturedOldSlot
    captured.name = Fmt"#cleanup_captured_old#{store.actionId}"
    captured.typeKind = target.typeKind
    captured.stackOffset = store.capturedOldStackOffset
    captured.sizeBytes = target.sizeBytes
    captured.alignBytes = target.alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(captured)
    captured.typeArenaTypeId = target.typeArenaTypeId
    captured.managedStorageKind = target.managedStorageKind
    let capturedTypeKind = captured.typeKind
    let capturedTypeArenaTypeId = captured.typeArenaTypeId
    let capturedManagedStorageKind = captured.managedStorageKind
    let capturedPlaceKind = captured.placeKind
    let capturedSizeBytes = captured.sizeBytes
    let capturedAlignBytes = captured.alignBytes
    let capturedSlotId = captured.id
    add(bodyIR.localSlots, captured)
    coreir.BodyIREntryDefinitionOwnershipAppendSyntheticSlot(
        bodyIR, capturedSlotId)
    add(plan.localTypeKinds, capturedTypeKind)
    add(plan.localTypeArenaTypeIds, capturedTypeArenaTypeId)
    add(plan.localManagedStorageKinds, capturedManagedStorageKind)
    add(plan.localPlaceKinds, capturedPlaceKind)
    add(plan.localSizeBytes, capturedSizeBytes)
    add(plan.localAlignBytes, capturedAlignBytes)
    for actionIndex in 0..<actions.len:
        let action = actions[actionIndex]
        if action.fieldProjectionBindingIndex >= 0:
            let projectionSlot =
                cleanupCfgAppendCapturedFieldProjection(plan,
                                                        bodyIR,
                                                        action)
            let _ = cleanupCfgAppendCapturedFieldOwner(plan,
                                                       bodyIR,
                                                       action,
                                                       projectionSlot)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)

fn cleanupCfgStageOwnershipOpSiteSnapshots(
        plan: var CleanupPlan,
        siteIndex: int32,
        actionStart: int32,
        actions: var cleanupOwnershipActionPreflight[]) =
    if siteIndex < 0 ||
       siteIndex >= plan.ownershipOpSiteSnapshotStarts.len ||
       siteIndex >= plan.ownershipOpSiteSnapshotCounts.len:
        cleanupCfgFail(
            "cleanup_cfg: ownership op snapshot site row invalid")
    let snapshotStart =
        plan.ownershipOpSiteSnapshotStarts[siteIndex]
    if snapshotStart < 0 ||
       snapshotStart + plan.ownershipOpSiteSnapshotCounts[siteIndex] !=
           plan.ownershipOpSiteSnapshotSourceSlots.len ||
       plan.ownershipOpSiteSnapshotSourceSlots.len !=
           plan.ownershipOpSiteSnapshotSemanticRows.len:
        cleanupCfgFail(
            "cleanup_cfg: ownership op snapshot CSR append drift")
    for actionIndex in 0..<actions.len:
        let action = actions[actionIndex]
        var candidates: int32[]
        if action.primaryKind != odir.DropConditionAlways:
            add(candidates, action.primaryFlagSlot)
        if action.secondaryKind != odir.DropConditionAlways:
            add(candidates, action.secondaryFlagSlot)
        if action.guardKind != odir.DropConditionAlways:
            add(candidates, action.guardFlagSlot)
        for candidateIndex in 0..<candidates.len:
            let candidate = candidates[candidateIndex]
            if candidate < 0:
                cleanupCfgFail(
                    "cleanup_cfg: ownership op snapshot flag missing")
            var found: bool
            for slotOffset in
                    0..<plan.ownershipOpSiteSnapshotCounts[siteIndex]:
                if plan.ownershipOpSiteSnapshotSourceSlots[
                       snapshotStart + slotOffset] == candidate:
                    found = true
            if !found:
                if plan.ownershipOpSiteSnapshotSourceSlots.len >=
                   plan.limits.maxOwnershipActionFlagRefCount:
                    cleanupCfgFail(
                        "cleanup_cfg: ownership op snapshot row arena exhausted")
                add(plan.ownershipOpSiteSnapshotSourceSlots,
                    candidate)
                add(plan.ownershipOpSiteSnapshotSemanticRows,
                    cleanupCfgCheckedAdd(
                        actionStart,
                        actionIndex,
                        "cleanup_cfg: ownership op snapshot semantic row overflow"))
                plan.ownershipOpSiteSnapshotCounts[siteIndex] =
                    cleanupCfgCheckedAdd(
                        plan.ownershipOpSiteSnapshotCounts[siteIndex],
                        1,
                        "cleanup_cfg: ownership op snapshot site count overflow")

fn cleanupCfgStageOwnershipOpTransitions(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipOpId: int32,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32): bool =
    var actions: cleanupOwnershipActionPreflight[]
    var transitionPreflight: cleanupFlagTransitionPreflight
    var preflight: cleanupExitPreflight
    if !cleanupCfgPreflightOwnershipOpSite(plan,
                                           bodyIR,
                                           ownershipAnalysis,
                                           ownershipOpId,
                                           bodyBlockId,
                                           afterBodyOpOrdinal,
                                           actions,
                                           transitionPreflight,
                                           preflight):
        return false
    cleanupCfgStageCapturedOldLocals(plan, bodyIR, actions)
    let actionStart = plan.ownershipActionKinds.len
    for actionIndex in 0..<actions.len:
        let action = actions[actionIndex]
        cleanupCfgStageOwnershipAction(plan, action)
    let transitionStart = cleanupCfgStageFlagTransitions(
        plan,
        transitionPreflight)
    let transitionCount = transitionPreflight.originKinds.len
    var siteIndex = -1
    for candidateSite in
            0..<plan.ownershipOpTransitionBodyBlockIds.len:
        if plan.ownershipOpTransitionBodyBlockIds[candidateSite] ==
               bodyBlockId &&
           plan.ownershipOpTransitionAfterOpOrdinals[candidateSite] ==
               afterBodyOpOrdinal:
            siteIndex = candidateSite
    if siteIndex < 0:
        if plan.ownershipOpTransitionBodyBlockIds.len > 0:
            let priorSite =
                plan.ownershipOpTransitionBodyBlockIds.len - 1
            let priorBlock =
                plan.ownershipOpTransitionBodyBlockIds[priorSite]
            let priorOrdinal =
                plan.ownershipOpTransitionAfterOpOrdinals[priorSite]
            if bodyBlockId < priorBlock ||
               (bodyBlockId == priorBlock &&
                afterBodyOpOrdinal <= priorOrdinal):
                cleanupCfgFail(
                    "cleanup_cfg: ownership op site registration order invalid")
        siteIndex = plan.ownershipOpTransitionBodyBlockIds.len
        add(plan.ownershipOpTransitionBodyBlockIds, bodyBlockId)
        add(plan.ownershipOpTransitionAfterOpOrdinals,
            afterBodyOpOrdinal)
        add(plan.ownershipOpTransitionSiteStarts,
            plan.ownershipOpTransitionOwnershipOpIds.len)
        add(plan.ownershipOpTransitionSiteCounts, 0)
        add(plan.ownershipOpSiteSnapshotStarts,
            plan.ownershipOpSiteSnapshotSourceSlots.len)
        add(plan.ownershipOpSiteSnapshotCounts, 0)
    elif siteIndex !=
             plan.ownershipOpTransitionBodyBlockIds.len - 1 ||
         plan.ownershipOpTransitionSiteStarts[siteIndex] +
             plan.ownershipOpTransitionSiteCounts[siteIndex] !=
                 plan.ownershipOpTransitionOwnershipOpIds.len:
        cleanupCfgFail(
            "cleanup_cfg: ownership op transition site CSR append drift")
    cleanupCfgStageOwnershipOpSiteSnapshots(plan,
                                            siteIndex,
                                            actionStart,
                                            actions)
    for priorRow in 0..<
            plan.ownershipOpTransitionOwnershipOpIds.len:
        if plan.ownershipOpTransitionOwnershipOpIds[priorRow] ==
               ownershipOpId:
            cleanupCfgFail(
                "cleanup_cfg: ownership op identity duplicated")
    if plan.ownershipOpTransitionSiteCounts[siteIndex] > 0:
        let priorRow =
            plan.ownershipOpTransitionOwnershipOpIds.len - 1
        if priorRow < 0 ||
           plan.ownershipOpTransitionOwnershipOpIds[priorRow] >=
               ownershipOpId:
            cleanupCfgFail(
                "cleanup_cfg: ownership op registration order invalid")
    add(plan.ownershipOpTransitionOwnershipOpIds, ownershipOpId)
    add(plan.ownershipOpActionStarts, actionStart)
    add(plan.ownershipOpActionCounts, actions.len)
    add(plan.ownershipOpTransitionStarts, transitionStart)
    add(plan.ownershipOpTransitionCounts, transitionCount)
    plan.ownershipOpTransitionSiteCounts[siteIndex] =
        cleanupCfgCheckedAdd(
            plan.ownershipOpTransitionSiteCounts[siteIndex],
            1,
            "cleanup_cfg: ownership op transition site count overflow")
    plan.plannedMaterializedLocalCount =
        preflight.nextPlannedMaterializedLocalCount
    plan.plannedMaterializedOpCount =
        preflight.nextPlannedMaterializedOpCount
    plan.plannedMaterializedOperandCount =
        preflight.nextPlannedMaterializedOperandCount
    plan.plannedMaterializedCallCount =
        preflight.nextPlannedMaterializedCallCount
    plan.plannedMaterializedCallArgCount =
        preflight.nextPlannedMaterializedCallArgCount
    plan.plannedMaterializedBlockCount =
        preflight.nextPlannedMaterializedBlockCount
    plan.plannedMaterializedTermCount =
        preflight.nextPlannedMaterializedTermCount
    plan.plannedMaterializedTermOperandCount =
        preflight.nextPlannedMaterializedTermOperandCount
    return true

fn CleanupPlanTryBindOwnershipOpTransitions(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipOpId: int32,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32): bool =
    var delta: CleanupMutationDelta
    var bodyCandidate: coreir.BodyIR
    var planCandidate: CleanupPlan
    cleanupCfgBeginBodyPlanMutation(bodyIR,
                                    plan,
                                    bodyCandidate,
                                    planCandidate,
                                    delta)
    if !cleanupCfgStageOwnershipOpTransitions(planCandidate,
                                               bodyCandidate,
                                               ownershipAnalysis,
                                               ownershipOpId,
                                               bodyBlockId,
                                               afterBodyOpOrdinal):
        cleanupCfgRestorePreflightMutation(planCandidate, delta)
        cleanupCfgRollbackBodyPlanMutation(bodyIR,
                                           plan,
                                           bodyCandidate,
                                           planCandidate,
                                           delta)
        return false
    cleanupCfgRequireLocalSchema(planCandidate, bodyCandidate)
    cleanupCfgValidateFieldProjectionContracts(planCandidate,
                                                bodyCandidate)
    cleanupCfgValidatePhysicalStackIntervals(bodyCandidate,
                                             planCandidate)
    cleanupCfgSealBodyPlanMutation(bodyCandidate, planCandidate, delta)
    cleanupCfgCommitBodyPlanMutation(bodyIR,
                                     plan,
                                     bodyCandidate,
                                     planCandidate,
                                     delta)
    return true

fn CleanupPlanBindOwnershipOpTransitions(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipOpId: int32,
        bodyBlockId: int32,
        afterBodyOpOrdinal: int32) =
    if !CleanupPlanTryBindOwnershipOpTransitions(plan,
                                                  bodyIR,
                                                  ownershipAnalysis,
                                                  ownershipOpId,
                                                  bodyBlockId,
                                                  afterBodyOpOrdinal):
        let actionCount = odir.OwnershipDropAnalysisOpActionCount(
            ownershipAnalysis,
            ownershipOpId)
        let actionStart = ownershipAnalysis.opActionStarts[ownershipOpId]
        for ordinal in 0..<actionCount:
            let action = odir.OwnershipDropAnalysisOpAction(
                ownershipAnalysis,
                ownershipOpId,
                ordinal)
            if !cleanupCfgOwnershipOpActionSurfaceSupported(action,
                                                            ownershipOpId):
                cleanupCfgFail(
                    Fmt"cleanup_cfg: ownership op action unsupported kind={int32(action.kind)} site={bodyBlockId}:{afterBodyOpOrdinal} op={ownershipOpId} action_row={actionStart + ordinal} action_id={action.actionId} place={action.placeId} other_place={action.otherPlaceId} type={action.typeId} drop_glue={action.dropGlueId} edge={action.edgeId} origin_op={action.opIndex} guard_defer={action.guardDeferId} snapshot_glue={action.returnSnapshotGlueId} primary={int32(action.conditionKind)}:{action.conditionFlagId}:{action.conditionNegated} secondary={int32(action.conditionOtherKind)}:{action.conditionOtherFlagId}:{action.conditionOtherNegated}")
        cleanupCfgFail(
            Fmt"cleanup_cfg: ownership op lowering drift site={bodyBlockId}:{afterBodyOpOrdinal} op={ownershipOpId}")

fn cleanupCfgOwnershipCleanupDeferId(plan: var CleanupPlan,
                                     ownershipDeferId: int32): int32 =
    for deferId in 0..<plan.deferOwnershipDeferIds.len:
        if plan.deferOwnershipDeferIds[deferId] == ownershipDeferId:
            return deferId
    cleanupCfgFail("cleanup_cfg: ownership defer binding missing")
    return -1

@borrows
fn cleanupCfgOwnershipConditionLocal(
        plan: var CleanupPlan,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        action: odir.OwnershipDropCleanupAction,
        kind: odir.OwnershipDropConditionKind,
        flagId: int32,
        guardDeferId: int32): int32 =
    if kind == odir.DropConditionAlways:
        if flagId != -1:
            cleanupCfgFail("cleanup_cfg: malformed ownership always condition")
        return -1
    if kind == odir.DropConditionPlaceInitialized ||
       kind == odir.DropConditionFieldInitialized:
        return cleanupCfgOwnershipConditionSlot(plan, flagId)
    if kind == odir.DropConditionDeferActive:
        var ownershipDeferId = guardDeferId
        if ownershipDeferId < 0 && action.kind == odir.CleanupActionDefer:
            ownershipDeferId = action.actionId
        if ownershipDeferId <= 0:
            cleanupCfgFail("cleanup_cfg: defer-active condition lacks defer identity")
        let cleanupDeferId = cleanupCfgOwnershipCleanupDeferId(plan,
                                                               ownershipDeferId)
        let activeSlot = plan.deferActiveFlagSlots[cleanupDeferId]
        let explicitSlot = cleanupCfgOwnershipConditionSlotIfBound(plan, flagId)
        if explicitSlot >= 0 && explicitSlot != activeSlot:
            cleanupCfgFail("cleanup_cfg: defer-active condition slot mismatch")
        return activeSlot
    if kind == odir.DropConditionCapturedOldPlace ||
       kind == odir.DropConditionCapturedOldField:
        if action.actionId <= 0 || flagId != action.actionId:
            cleanupCfgFail("cleanup_cfg: captured-old action identity mismatch")
        let conditionFlagCount =
            odir.OwnershipDropAnalysisConditionFlagCount(ownershipAnalysis)
        for ownershipFlagId in 1..conditionFlagCount:
            let flag = odir.OwnershipDropAnalysisConditionFlag(
                ownershipAnalysis,
                ownershipFlagId)
            if kind == odir.DropConditionCapturedOldPlace &&
               flag.kind == odir.ConditionFlagPlaceInitialized &&
               flag.placeId == action.placeId && flag.fieldOrdinal == -1:
                return cleanupCfgOwnershipFlagSlot(plan,
                                                   ownershipAnalysis,
                                                   ownershipFlagId)
            if kind == odir.DropConditionCapturedOldField &&
               flag.kind == odir.ConditionFlagFieldInitialized &&
               flag.placeId == action.placeId &&
               flag.fieldOrdinal == action.fieldOrdinal:
                return cleanupCfgOwnershipFlagSlot(plan,
                                                   ownershipAnalysis,
                                                   ownershipFlagId)
        cleanupCfgFail("cleanup_cfg: captured-old condition flag missing")
    cleanupCfgFail("cleanup_cfg: ownership action condition lowering unsupported")
    return -1

fn cleanupCfgManagedProducerActionRow(
        plan: var CleanupPlan,
        producerOwnershipOpId: int32,
        producerActionKind: odir.OwnershipDropCleanupActionKind): int32 =
    if producerOwnershipOpId < 0:
        cleanupCfgFail(
            "cleanup_cfg: managed producer ownership op missing")
    if producerActionKind != odir.CleanupActionStoreMove &&
       producerActionKind != odir.CleanupActionRetainValue:
        cleanupCfgFail(
            "cleanup_cfg: managed producer action kind missing")
    var out = -1
    for actionRow in 0..<plan.ownershipActionKinds.len:
        if plan.ownershipActionOpIds[actionRow] ==
               producerOwnershipOpId &&
           plan.ownershipActionKinds[actionRow] ==
               producerActionKind:
            if out >= 0:
                cleanupCfgFail(
                    "cleanup_cfg: managed producer action duplicated")
            out = actionRow
    if out < 0:
        cleanupCfgFail(
            "cleanup_cfg: managed producer action not staged")
    return out

@borrows
fn cleanupCfgPreflightOwnershipAction(
        plan: var CleanupPlan,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        action: odir.OwnershipDropCleanupAction,
        ordinal: int32,
        priorActions: var cleanupOwnershipActionPreflight[],
        preflight: var cleanupExitPreflight): cleanupOwnershipActionPreflight =
    var out: cleanupOwnershipActionPreflight
    out.kind = action.kind
    out.actionId = action.actionId
    out.edgeId = action.edgeId
    out.opId = -1
    out.ordinal = ordinal
    out.cleanupDeferId = -1
    out.targetSlot = -1
    out.sourceSlot = -1
    out.dropGlueBindingIndex = -1
    out.retainGlueBindingIndex = -1
    out.capturedOldSlot = -1
    out.capturedOldStackOffset = -1
    out.capturedFieldSourceBindingIndex = -1
    out.capturedFieldOwnerStackOffset = -1
    out.fieldProjectionBindingIndex = -1
    out.ownershipPlaceId = action.placeId
    out.fieldOrdinal = action.fieldOrdinal
    out.ownershipTypeId = -1
    out.ownershipLayoutCid = ""
    out.definitionOriginKind = action.definitionOriginKind
    out.definitionOriginId = action.definitionOriginId
    out.sourceDefinitionDomain =
        action.sourceDefinitionDomain
    out.sourceDefinitionRow = action.sourceDefinitionRow
    out.capturedOldSourceDefinitionDomain =
        action.capturedOldSourceDefinitionDomain
    out.capturedOldSourceDefinitionRow =
        action.capturedOldSourceDefinitionRow
    out.sourceOwnership = action.sourceOwnership
    out.consumeActionRow = action.consumeActionRow
    out.guardCleanupDeferId = -1
    out.guardOwnershipDeferId = -1
    let managedSyntheticProducerDrop =
        action.actionId == 0 &&
        action.kind == odir.CleanupActionDropPlace &&
        action.definitionOriginKind ==
            odir.DefinitionOriginCanonicalSyntheticAction
    let managedTypedProducerDrop =
        action.actionId == 0 &&
        action.kind == odir.CleanupActionDropPlace &&
        action.definitionOriginKind == odir.DefinitionOriginTypedExpr
    if managedSyntheticProducerDrop:
        if action.sourceDefinitionDomain != 0 ||
           action.sourceDefinitionRow != -1 ||
           action.sourceOwnership != odir.Owned ||
           action.consumeActionRow < 0 ||
           action.definitionOriginId < 0 ||
           action.definitionOriginId >=
               ownershipAnalysis.cleanupActions.len:
            cleanupCfgFail(
                "cleanup_cfg: managed producer drop authority invalid")
        let producerAction =
            ownershipAnalysis.cleanupActions[action.definitionOriginId]
        if producerAction.kind != odir.CleanupActionStoreMove &&
           producerAction.kind != odir.CleanupActionRetainValue:
            cleanupCfgFail(
                "cleanup_cfg: managed producer action kind invalid")
        out.definitionOriginId = cleanupCfgManagedProducerActionRow(
            plan,
            producerAction.opIndex,
            producerAction.kind)
        out.consumeActionRow = cleanupCfgCheckedAdd(
            plan.ownershipActionKinds.len,
            priorActions.len,
            "cleanup_cfg: managed producer consume row overflow")
    elif managedTypedProducerDrop:
        if action.definitionOriginId < 0 ||
           !cleanupCfgDefinitionCoordinateValid(
               action.sourceDefinitionDomain,
               action.sourceDefinitionRow) ||
           action.sourceOwnership != odir.Owned ||
           action.consumeActionRow < 0:
            cleanupCfgFail(
                "cleanup_cfg: initialized producer drop authority invalid")
        out.consumeActionRow = cleanupCfgCheckedAdd(
            plan.ownershipActionKinds.len,
            priorActions.len,
            "cleanup_cfg: initialized producer consume row overflow")
    let projection = odir.OwnershipDropProjectActionCondition(ownershipIr,
                                                               ownershipAnalysis,
                                                               action)
    if action.kind == odir.CleanupActionDefer:
        out.cleanupDeferId = cleanupCfgOwnershipCleanupDeferId(
            plan,
            action.actionId)
        if projection.secondaryKind != odir.DropConditionAlways ||
           projection.guardKind != odir.DropConditionAlways ||
           (projection.primaryKind != odir.DropConditionAlways &&
            projection.primaryKind != odir.DropConditionDeferActive):
            cleanupCfgFail("cleanup_cfg: defer marker condition unsupported")
    elif action.kind == odir.CleanupActionDropPlace:
        out.targetSlot = cleanupCfgOwnershipPlaceSlot(plan, action.placeId)
        out.dropGlueBindingIndex = cleanupCfgOwnershipDropGlueBinding(
            plan,
            action.dropGlueId)
        let placeBinding = cleanupCfgOwnershipPlaceBindingIndex(
            plan,
            action.placeId)
        cleanupCfgRequireActionTypeContract(
            plan,
            action.typeId,
            plan.ownershipPlaceBindingTypeIds[placeBinding],
            plan.ownershipPlaceBindingLayoutCids[placeBinding],
            "cleanup_cfg: edge drop-place type layout mismatch")
        cleanupCfgRequireActionTypeContract(
            plan,
            action.typeId,
            plan.ownershipDropGlueBindingTypeIds[
                out.dropGlueBindingIndex],
            plan.ownershipDropGlueBindingLayoutCids[
                out.dropGlueBindingIndex],
            "cleanup_cfg: edge drop glue type layout mismatch")
        out.ownershipTypeId = action.typeId
        out.ownershipLayoutCid =
            cleanupCfgOwnedTextCopy(
                plan.ownershipPlaceBindingLayoutCids[placeBinding])
    elif action.kind == odir.CleanupActionDropField:
        out.fieldProjectionBindingIndex =
            cleanupCfgOwnershipFieldBindingIndex(plan,
                                                 action.placeId,
                                                 action.fieldOrdinal)
        out.targetSlot = plan.ownershipFieldBindingProjectionSlots[
            out.fieldProjectionBindingIndex]
        out.dropGlueBindingIndex = cleanupCfgOwnershipDropGlueBinding(
            plan,
            action.dropGlueId)
        let fieldBinding = cleanupCfgOwnershipFieldBindingIndex(
            plan,
            action.placeId,
            action.fieldOrdinal)
        cleanupCfgRequireActionTypeContract(
            plan,
            action.typeId,
            plan.ownershipFieldBindingLeafTypeIds[fieldBinding],
            plan.ownershipFieldBindingLeafLayoutCids[fieldBinding],
            "cleanup_cfg: edge drop-field type layout mismatch")
        cleanupCfgRequireActionTypeContract(
            plan,
            action.typeId,
            plan.ownershipDropGlueBindingTypeIds[
                out.dropGlueBindingIndex],
            plan.ownershipDropGlueBindingLayoutCids[
                out.dropGlueBindingIndex],
            "cleanup_cfg: edge drop glue type layout mismatch")
        out.ownershipTypeId = action.typeId
        out.ownershipLayoutCid =
            cleanupCfgOwnedTextCopy(
                plan.ownershipFieldBindingLeafLayoutCids[fieldBinding])
    elif action.kind != odir.CleanupActionSnapshotRetainOwnedReturn &&
         action.kind != odir.CleanupActionSnapshotCloneOwnedReturn &&
         action.kind != odir.CleanupActionReturnUnmanaged:
        cleanupCfgFail("cleanup_cfg: ownership edge action lowering unsupported")
    else:
        let placeBinding = cleanupCfgOwnershipPlaceBindingIndex(
            plan,
            action.placeId)
        cleanupCfgRequireActionTypeContract(
            plan,
            action.typeId,
            plan.ownershipPlaceBindingTypeIds[placeBinding],
            plan.ownershipPlaceBindingLayoutCids[placeBinding],
            "cleanup_cfg: snapshot action type layout mismatch")
        out.ownershipTypeId = action.typeId
        out.ownershipLayoutCid =
            cleanupCfgOwnedTextCopy(
                plan.ownershipPlaceBindingLayoutCids[placeBinding])
    out.primaryKind = projection.primaryKind
    out.primaryFlagId = projection.primaryFlagId
    out.primaryFlagSlot = cleanupCfgOwnershipConditionLocal(
        plan,
        ownershipAnalysis,
        action,
        projection.primaryKind,
        projection.primaryFlagId,
        action.guardDeferId)
    out.primaryNegated = projection.primaryNegated
    out.secondaryKind = projection.secondaryKind
    out.secondaryFlagId = projection.secondaryFlagId
    out.secondaryFlagSlot = cleanupCfgOwnershipConditionLocal(
        plan,
        ownershipAnalysis,
        action,
        projection.secondaryKind,
        projection.secondaryFlagId,
        action.guardDeferId)
    out.secondaryNegated = projection.secondaryNegated
    out.guardKind = projection.guardKind
    out.guardFlagId = projection.guardFlagId
    out.guardFlagSlot = cleanupCfgOwnershipConditionLocal(
        plan,
        ownershipAnalysis,
        action,
        projection.guardKind,
        projection.guardFlagId,
        projection.guardDeferId)
    out.guardNegated = projection.guardNegated
    if action.guardDeferId > 0:
        out.hasGuardProjection = true
        out.guardOwnershipDeferId = action.guardDeferId
        out.guardCleanupDeferId = cleanupCfgOwnershipCleanupDeferId(
            plan,
            action.guardDeferId)
        var priorProjectionCount: int32
        for priorIndex in 0..<priorActions.len:
            let prior = priorActions[priorIndex]
            if prior.hasGuardProjection &&
               prior.guardCleanupDeferId == out.guardCleanupDeferId:
                priorProjectionCount = cleanupCfgCheckedAdd(
                    priorProjectionCount,
                    1,
                    "cleanup_cfg: ownership guard projection overflow")
        let projectionDelta = cleanupCfgCheckedAdd(
            priorProjectionCount,
            1,
            "cleanup_cfg: ownership guard projection overflow")
        out.guardProjectionNextCount = cleanupCfgCheckedAdd(
            plan.deferOwnershipGuardProjectionCounts[
                out.guardCleanupDeferId],
            projectionDelta,
            "cleanup_cfg: ownership guard projection overflow")
    if action.kind == odir.CleanupActionDropPlace ||
       action.kind == odir.CleanupActionDropField:
        let conditionFlagCount =
            odir.OwnershipDropAnalysisConditionFlagCount(ownershipAnalysis)
        for flagId in 1..conditionFlagCount:
            let flag = odir.OwnershipDropAnalysisConditionFlag(
                ownershipAnalysis,
                flagId)
            let clearsWholePlace =
                action.kind == odir.CleanupActionDropPlace &&
                flag.placeId == action.placeId &&
                (flag.kind == odir.ConditionFlagPlaceInitialized ||
                 flag.kind == odir.ConditionFlagFieldInitialized)
            let clearsOneField =
                action.kind == odir.CleanupActionDropField &&
                flag.placeId == action.placeId &&
                ((flag.kind == odir.ConditionFlagPlaceInitialized &&
                  flag.fieldOrdinal == -1) ||
                 (flag.kind == odir.ConditionFlagFieldInitialized &&
                  flag.fieldOrdinal == action.fieldOrdinal))
            if clearsWholePlace || clearsOneField:
                add(out.clearFlagSlots,
                    cleanupCfgOwnershipFlagSlot(plan,
                                                ownershipAnalysis,
                                                flagId))
        if out.clearFlagSlots.len <= 0:
            cleanupCfgFail("cleanup_cfg: drop action lacks exact clear flags")
        let clearRemaining = cleanupCfgCheckedSub(
            plan.limits.maxOwnershipActionFlagRefCount,
            plan.ownershipActionClearFlagSlots.len,
            "cleanup_cfg: ownership clear flag capacity underflow")
        if out.clearFlagSlots.len > clearRemaining:
            cleanupCfgFail("cleanup_cfg: ownership clear flag arena exhausted")
        var conditionCount: int32
        if projection.primaryKind != odir.DropConditionAlways:
            conditionCount = cleanupCfgCheckedAdd(
                conditionCount, 1,
                "cleanup_cfg: ownership condition count overflow")
        if projection.secondaryKind != odir.DropConditionAlways:
            conditionCount = cleanupCfgCheckedAdd(
                conditionCount, 1,
                "cleanup_cfg: ownership condition count overflow")
        if projection.guardKind != odir.DropConditionAlways:
            conditionCount = cleanupCfgCheckedAdd(
                conditionCount, 1,
                "cleanup_cfg: ownership condition count overflow")
        preflight.materializedOpDelta = cleanupCfgCheckedAdd(
            preflight.materializedOpDelta,
            cleanupCfgCheckedAdd(
                1,
                out.clearFlagSlots.len,
                "cleanup_cfg: ownership action clear op overflow"),
            "cleanup_cfg: ownership action op overflow")
        preflight.materializedOperandDelta = cleanupCfgCheckedAdd(
            preflight.materializedOperandDelta,
            cleanupCfgCheckedAdd(
                1,
                cleanupCfgCheckedMul(
                    out.clearFlagSlots.len,
                    2,
                    "cleanup_cfg: ownership action clear operand overflow"),
                "cleanup_cfg: ownership action operand delta overflow"),
            "cleanup_cfg: ownership action operand overflow")
        preflight.materializedCallDelta = cleanupCfgCheckedAdd(
            preflight.materializedCallDelta, 1,
            "cleanup_cfg: ownership action call overflow")
        preflight.materializedCallArgDelta = cleanupCfgCheckedAdd(
            preflight.materializedCallArgDelta, 2,
            "cleanup_cfg: ownership action call arg overflow")
        let unitCount = cleanupCfgCheckedAdd(
            conditionCount, 1,
            "cleanup_cfg: ownership action unit overflow")
        preflight.materializedBlockDelta = cleanupCfgCheckedAdd(
            preflight.materializedBlockDelta, unitCount,
            "cleanup_cfg: ownership action block overflow")
        preflight.materializedTermDelta = cleanupCfgCheckedAdd(
            preflight.materializedTermDelta, unitCount,
            "cleanup_cfg: ownership action term overflow")
    return out

@borrows
fn cleanupCfgStageOwnershipAction(
        plan: var CleanupPlan,
        action: cleanupOwnershipActionPreflight) =
    let actionRow = plan.ownershipActionKinds.len
    let clearStart = plan.ownershipActionClearFlagSlots.len
    add(plan.ownershipActionKinds, action.kind)
    add(plan.ownershipActionEdgeIds, action.edgeId)
    add(plan.ownershipActionOpIds, action.opId)
    add(plan.ownershipActionOrdinals, action.ordinal)
    add(plan.ownershipActionIds, action.actionId)
    add(plan.ownershipActionCleanupDeferIds, action.cleanupDeferId)
    add(plan.ownershipActionTargetSlots, action.targetSlot)
    add(plan.ownershipActionSourceSlots, action.sourceSlot)
    add(plan.ownershipActionDropGlueBindingIndices,
        action.dropGlueBindingIndex)
    add(plan.ownershipActionRetainGlueBindingIndices,
        action.retainGlueBindingIndex)
    add(plan.ownershipActionCapturedOldSlots, action.capturedOldSlot)
    add(plan.ownershipActionPlaceIds, action.ownershipPlaceId)
    add(plan.ownershipActionFieldOrdinals, action.fieldOrdinal)
    add(plan.ownershipActionFieldProjectionBindingIndices,
        action.fieldProjectionBindingIndex)
    add(plan.ownershipActionTypeIds, action.ownershipTypeId)
    add(plan.ownershipActionLayoutCids, share(action.ownershipLayoutCid))
    add(plan.ownershipActionDefinitionOriginKinds,
        action.definitionOriginKind)
    add(plan.ownershipActionDefinitionOriginIds, action.definitionOriginId)
    add(plan.ownershipActionSourceDefinitionDomains,
        action.sourceDefinitionDomain)
    add(plan.ownershipActionSourceDefinitionRows, action.sourceDefinitionRow)
    add(plan.ownershipActionCapturedOldSourceDefinitionDomains,
        action.capturedOldSourceDefinitionDomain)
    add(plan.ownershipActionCapturedOldSourceDefinitionRows,
        action.capturedOldSourceDefinitionRow)
    add(plan.ownershipActionSourceOwnershipKinds, action.sourceOwnership)
    add(plan.ownershipActionConsumeActionRows, action.consumeActionRow)
    add(plan.ownershipActionPrimaryKinds, action.primaryKind)
    add(plan.ownershipActionPrimaryFlagIds, action.primaryFlagId)
    add(plan.ownershipActionPrimaryFlagSlots, action.primaryFlagSlot)
    add(plan.ownershipActionPrimaryNegated, action.primaryNegated)
    add(plan.ownershipActionSecondaryKinds, action.secondaryKind)
    add(plan.ownershipActionSecondaryFlagIds, action.secondaryFlagId)
    add(plan.ownershipActionSecondaryFlagSlots, action.secondaryFlagSlot)
    add(plan.ownershipActionSecondaryNegated, action.secondaryNegated)
    add(plan.ownershipActionGuardKinds, action.guardKind)
    add(plan.ownershipActionGuardFlagIds, action.guardFlagId)
    add(plan.ownershipActionGuardFlagSlots, action.guardFlagSlot)
    add(plan.ownershipActionGuardNegated, action.guardNegated)
    add(plan.ownershipActionGuardCleanupDeferIds,
        action.guardCleanupDeferId)
    add(plan.ownershipActionGuardAuditSeen, false)
    add(plan.ownershipActionDeferClearAfterBody,
        action.deferClearAfterBody)
    add(plan.ownershipActionClearFlagStarts, clearStart)
    add(plan.ownershipActionClearFlagCounts, action.clearFlagSlots.len)
    for clearIndex in 0..<action.clearFlagSlots.len:
        add(plan.ownershipActionClearFlagSlots,
            action.clearFlagSlots[clearIndex])

    if action.hasGuardProjection:
        add(plan.ownershipGuardCleanupDeferIds,
            action.guardCleanupDeferId)
        add(plan.ownershipGuardDeferIds, action.guardOwnershipDeferId)
        add(plan.ownershipGuardConditionFlagIds, action.guardFlagId)
        add(plan.ownershipGuardActiveFlagSlots, action.guardFlagSlot)
        add(plan.ownershipGuardActionRows, actionRow)
        plan.deferOwnershipGuardProjectionCounts[
            action.guardCleanupDeferId] = action.guardProjectionNextCount

fn cleanupCfgBuildOwnershipSnapshot(
        plan: var CleanupPlan,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32,
        sourceSlot: int32,
        snapshotSlot: int32): cleanupReturnSnapshotBinding =
    let edge = ownershipIr.edges[ownershipEdgeId]
    var snapshot = cleanupCfgEmptyReturnSnapshotBinding()
    if edge.kind != odir.OwnershipDropEdgeReturn:
        if sourceSlot != -1 || snapshotSlot != -1:
            cleanupCfgFail("cleanup_cfg: non-return ownership edge carries snapshot")
        return snapshot
    if edge.returnPlaceId < 0:
        # A function may own managed locals while returning an unmanaged
        # scalar.  The return value still has to be copied before canonical
        # cleanup rewrites the edge, while the ownership edge remains the
        # authority for the drop actions.  No synthetic ownership identity is
        # invented for that scalar snapshot.
        if sourceSlot >= 0 || snapshotSlot >= 0:
            snapshot.kind = CleanupReturnSnapshotUnmanagedCopy
            snapshot.sourceSlot = sourceSlot
            snapshot.snapshotSlot = snapshotSlot
            cleanupCfgRequireSnapshotBinding(plan, snapshot)
        return snapshot
    let actionCount = odir.OwnershipDropAnalysisEdgeActionCount(
        ownershipAnalysis,
        ownershipEdgeId)
    if actionCount <= 0:
        cleanupCfgFail("cleanup_cfg: return snapshot action missing")
    let sourceBinding = cleanupCfgOwnershipPlaceSlot(plan,
                                                     edge.returnPlaceId)
    if sourceBinding != sourceSlot:
        cleanupCfgFail("cleanup_cfg: return source ownership place mismatch")
    let snapshotAction = odir.OwnershipDropAnalysisEdgeAction(
        ownershipAnalysis,
        ownershipEdgeId,
        0)
    let ownedSnapshot =
        snapshotAction.kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
        snapshotAction.kind == odir.CleanupActionSnapshotCloneOwnedReturn
    if !ownedSnapshot &&
       snapshotAction.kind != odir.CleanupActionReturnUnmanaged:
        cleanupCfgFail("cleanup_cfg: ownership return action lowering unsupported")
    if snapshotAction.kind == odir.CleanupActionReturnUnmanaged:
        if snapshotAction.edgeId != ownershipEdgeId ||
           snapshotAction.placeId != edge.returnPlaceId ||
           snapshotAction.typeId <= 0 ||
           snapshotAction.definitionOriginKind !=
               odir.DefinitionOriginTypedExpr ||
           snapshotAction.definitionOriginId !=
               edge.resultValueDefinitionRow ||
           snapshotAction.sourceDefinitionDomain !=
               edge.sourceDefinitionDomain ||
           snapshotAction.sourceDefinitionRow != edge.sourceDefinitionRow ||
           snapshotAction.sourceOwnership != odir.Unmanaged ||
           edge.resultOwnership != odir.Unmanaged:
            cleanupCfgFail(
                "cleanup_cfg: unmanaged return action authority mismatch")
        snapshot.kind = CleanupReturnSnapshotUnmanagedCopy
        snapshot.sourceSlot = sourceSlot
        snapshot.snapshotSlot = snapshotSlot
        snapshot.ownershipEdgeId = ownershipEdgeId
        snapshot.ownershipActionOrdinal = 0
        snapshot.ownershipPlaceId = snapshotAction.placeId
        snapshot.ownershipTypeId = snapshotAction.typeId
        snapshot.resultExprNodeIndex = edge.resultExprNodeIndex
        snapshot.resultValueDefinitionRow =
            edge.resultValueDefinitionRow
        snapshot.resultOwnership = edge.resultOwnership
        snapshot.sourceDefinitionDomain =
            edge.sourceDefinitionDomain
        snapshot.sourceDefinitionRow = edge.sourceDefinitionRow
        let placeBinding = cleanupCfgOwnershipPlaceBindingIndex(
            plan,
            snapshotAction.placeId)
        cleanupCfgRequireActionTypeContract(
            plan,
            snapshotAction.typeId,
            plan.ownershipPlaceBindingTypeIds[placeBinding],
            plan.ownershipPlaceBindingLayoutCids[placeBinding],
            "cleanup_cfg: unmanaged return type layout mismatch")
        snapshot.ownershipLayoutCid =
            cleanupCfgOwnedTextCopy(
                plan.ownershipPlaceBindingLayoutCids[placeBinding])
    else:
        let projection = odir.OwnershipDropProjectReturnSnapshot(
            ownershipIr,
            ownershipAnalysis,
            snapshotAction)
        if projection.kind == odir.ReturnSnapshotRetain:
            snapshot.kind = CleanupReturnSnapshotOwnedRetain
        elif projection.kind == odir.ReturnSnapshotClone:
            snapshot.kind = CleanupReturnSnapshotOwnedClone
        else:
            cleanupCfgFail(
                "cleanup_cfg: ownership snapshot projection kind unknown")
        snapshot.sourceSlot = sourceSlot
        snapshot.snapshotSlot = snapshotSlot
        snapshot.glueId = projection.glueId
        snapshot.glueSymbol = projection.glueSymbol
        snapshot.ownershipEdgeId = projection.edgeId
        snapshot.ownershipActionOrdinal = projection.actionOrdinal
        snapshot.ownershipPlaceId = projection.sourcePlaceId
        snapshot.ownershipTypeId = projection.typeId
        snapshot.resultExprNodeIndex = projection.resultExprNodeIndex
        snapshot.resultValueDefinitionRow =
            projection.resultValueDefinitionRow
        snapshot.resultOwnership = projection.resultOwnership
        snapshot.sourceDefinitionDomain =
            projection.sourceDefinitionDomain
        snapshot.sourceDefinitionRow = projection.sourceDefinitionRow
        let placeBinding = cleanupCfgOwnershipPlaceBindingIndex(
            plan,
            projection.sourcePlaceId)
        cleanupCfgRequireActionTypeContract(
            plan,
            projection.typeId,
            plan.ownershipPlaceBindingTypeIds[placeBinding],
            plan.ownershipPlaceBindingLayoutCids[placeBinding],
            "cleanup_cfg: return snapshot type layout mismatch")
        snapshot.ownershipLayoutCid =
            cleanupCfgOwnedTextCopy(
                plan.ownershipPlaceBindingLayoutCids[placeBinding])
    cleanupCfgRequireSnapshotBinding(plan, snapshot)
    return snapshot

fn cleanupCfgOwnershipDeferClearedOnEdge(
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32,
        ownershipDeferId: int32): bool =
    var deferFlagId = -1
    for flagIndex in 0..<ownershipAnalysis.conditionFlags.len:
        let flag = ownershipAnalysis.conditionFlags[flagIndex]
        if flag.kind == odir.ConditionFlagDeferActive &&
           flag.deferId == ownershipDeferId:
            if deferFlagId >= 0:
                cleanupCfgFail("cleanup_cfg: duplicate ownership defer flag")
            deferFlagId = flag.flagId
    if deferFlagId <= 0:
        cleanupCfgFail("cleanup_cfg: ownership defer flag missing")
    let transitionCount = odir.OwnershipDropAnalysisFlagTransitionCount(
        ownershipAnalysis)
    for transitionIndex in 0..<transitionCount:
        let transition = odir.OwnershipDropAnalysisFlagTransition(
            ownershipAnalysis,
            transitionIndex)
        if transition.originKind == odir.FlagOriginEdge &&
           transition.originId == ownershipEdgeId &&
           transition.flagId == deferFlagId && !transition.setValue:
            return true
    return false

fn cleanupCfgPreflightOwnershipEdgeContract(
        plan: var CleanupPlan,
        fromBlockId: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32) =
    if !ownershipAnalysis.converged || ownershipEdgeId < 0 ||
       ownershipEdgeId >= ownershipIr.edges.len ||
       ownershipEdgeId >= ownershipAnalysis.edgeActionCounts.len:
        cleanupCfgFail("cleanup_cfg: ownership edge analysis invalid")
    let edge = ownershipIr.edges[ownershipEdgeId]
    if edge.edgeId != ownershipEdgeId || edge.kind != kind ||
       edge.fromBlockId != fromBlockId || edge.fromBlockId < 0 ||
       edge.fromBlockId >= ownershipIr.blocks.len ||
       ownershipIr.blocks[edge.fromBlockId].scopeId != fromScopeId:
        cleanupCfgFail("cleanup_cfg: ownership edge source contract mismatch")
    if kind == odir.OwnershipDropEdgeReturn:
        if toScopeId != -1 || targetBlockId != -1:
            cleanupCfgFail("cleanup_cfg: ownership return target contract mismatch")
    else:
        if edge.toBlockId != targetBlockId || edge.toBlockId < 0 ||
           edge.toBlockId >= ownershipIr.blocks.len ||
           ownershipIr.blocks[edge.toBlockId].scopeId != toScopeId:
            cleanupCfgFail("cleanup_cfg: ownership edge target contract mismatch")

@borrows
fn cleanupCfgStageEdgeTransitions(
        plan: var CleanupPlan,
        exitId: int32,
        transitions: cleanupFlagTransitionPreflight) =
    let start = cleanupCfgStageFlagTransitions(plan, transitions)
    plan.exitOwnershipFlagTransitionStarts[exitId] = start
    plan.exitOwnershipFlagTransitionCounts[exitId] =
        transitions.originKinds.len

fn cleanupCfgStageQueueOwnershipExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        successorOrdinal: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32,
        returnSourceSlot: int32,
        returnSnapshotSlot: int32,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32): int32 =
    cleanupCfgRequireBuilding(plan)
    cleanupCfgBindOwnershipAuthority(
        plan, ownershipIr, ownershipAnalysis)
    cleanupCfgPreflightOwnershipEdgeContract(plan,
                                              fromBlockId,
                                              fromScopeId,
                                              toScopeId,
                                              kind,
                                              targetBlockId,
                                              ownershipIr,
                                              ownershipAnalysis,
                                              ownershipEdgeId)
    let snapshot = cleanupCfgBuildOwnershipSnapshot(plan,
                                                     ownershipIr,
                                                     ownershipAnalysis,
                                                     ownershipEdgeId,
                                                     returnSourceSlot,
                                                     returnSnapshotSlot)
    var totalPreflight = cleanupCfgPreflightExitBound(plan,
                                                      fromBlockId,
                                                      successorOrdinal,
                                                      fromScopeId,
                                                      toScopeId,
                                                      kind,
                                                      targetBlockId,
                                                      snapshot)
    let actionCount = odir.OwnershipDropAnalysisEdgeActionCount(
        ownershipAnalysis,
        ownershipEdgeId)
    let actionRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipActionCount,
        plan.ownershipActionKinds.len,
        "cleanup_cfg: ownership action capacity underflow")
    if actionCount > actionRemaining:
        cleanupCfgFail("cleanup_cfg: ownership action arena exhausted")
    var markerCount: int32
    var guardProjectionCount: int32
    var runtimeActionCount: int32
    var clearFlagCount: int32
    var actionPreflights: cleanupOwnershipActionPreflight[]
    for ordinal in 0..<actionCount:
        let action = odir.OwnershipDropAnalysisEdgeAction(ownershipAnalysis,
                                                          ownershipEdgeId,
                                                          ordinal)
        let actionPreflight = cleanupCfgPreflightOwnershipAction(
            plan,
            ownershipIr,
            ownershipAnalysis,
            action,
            ordinal,
            actionPreflights,
            totalPreflight)
        let actionClearFlagCount =
            actionPreflight.clearFlagSlots.len
        let actionHasGuardProjection =
            actionPreflight.hasGuardProjection
        add(actionPreflights, actionPreflight)
        clearFlagCount = cleanupCfgCheckedAdd(
            clearFlagCount,
            actionClearFlagCount,
            "cleanup_cfg: ownership edge clear flag count overflow")
        if actionHasGuardProjection:
            guardProjectionCount = cleanupCfgCheckedAdd(
                guardProjectionCount,
                1,
                "cleanup_cfg: ownership guard projection overflow")
        if action.kind == odir.CleanupActionDefer:
            let cleanupDeferId = cleanupCfgOwnershipCleanupDeferId(
                plan,
                action.actionId)
            if markerCount >= totalPreflight.selectedDeferIds.len ||
               totalPreflight.selectedDeferIds[markerCount] != cleanupDeferId:
                cleanupCfgFail("cleanup_cfg: ownership defer order differs from CFG")
            if !cleanupCfgOwnershipDeferClearedOnEdge(ownershipAnalysis,
                                                       ownershipEdgeId,
                                                       action.actionId):
                cleanupCfgFail("cleanup_cfg: ownership defer edge clear missing")
            markerCount = cleanupCfgCheckedAdd(
                markerCount, 1,
                "cleanup_cfg: ownership defer marker overflow")
        elif action.kind == odir.CleanupActionDropPlace ||
             action.kind == odir.CleanupActionDropField:
            runtimeActionCount = cleanupCfgCheckedAdd(
                runtimeActionCount, 1,
                "cleanup_cfg: ownership runtime action overflow")
        elif action.kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
             action.kind == odir.CleanupActionSnapshotCloneOwnedReturn:
            if ordinal != snapshot.ownershipActionOrdinal || ordinal != 0 ||
               action.edgeId != snapshot.ownershipEdgeId ||
               action.placeId != snapshot.ownershipPlaceId ||
               action.typeId != snapshot.ownershipTypeId ||
               action.returnSnapshotGlueId != snapshot.glueId ||
               action.returnSnapshotGlueSymbol != snapshot.glueSymbol:
                cleanupCfgFail("cleanup_cfg: owned snapshot action identity mismatch")
        elif action.kind == odir.CleanupActionReturnUnmanaged:
            if snapshot.kind != CleanupReturnSnapshotUnmanagedCopy ||
               ordinal != snapshot.ownershipActionOrdinal || ordinal != 0 ||
               action.edgeId != snapshot.ownershipEdgeId ||
               action.placeId != snapshot.ownershipPlaceId ||
               action.typeId != snapshot.ownershipTypeId ||
               action.definitionOriginId !=
                   snapshot.resultValueDefinitionRow ||
               action.sourceDefinitionDomain !=
                   snapshot.sourceDefinitionDomain ||
               action.sourceDefinitionRow !=
                   snapshot.sourceDefinitionRow ||
               action.sourceOwnership != snapshot.resultOwnership:
                cleanupCfgFail(
                    "cleanup_cfg: unmanaged snapshot action identity mismatch")
    if markerCount != totalPreflight.selectedDeferIds.len:
        cleanupCfgFail("cleanup_cfg: ownership edge omits selected defer")
    let clearFlagRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipActionFlagRefCount,
        plan.ownershipActionClearFlagSlots.len,
        "cleanup_cfg: ownership clear flag capacity underflow")
    if clearFlagCount > clearFlagRemaining:
        cleanupCfgFail("cleanup_cfg: ownership clear flag arena exhausted")
    cleanupCfgAccumulateOwnershipSnapshotBudget(actionPreflights,
                                                plan,
                                                totalPreflight)
    for selectedIndex in 0..<totalPreflight.selectedDeferIds.len:
        let selectedDeferId =
            totalPreflight.selectedDeferIds[selectedIndex]
        if plan.deferOwnershipDeferIds[selectedDeferId] <= 0:
            cleanupCfgFail("cleanup_cfg: ownership exit contains unmanaged defer")
    let guardProjectionRemaining = cleanupCfgCheckedSub(
        plan.limits.maxOwnershipGuardProjectionCount,
        plan.ownershipGuardCleanupDeferIds.len,
        "cleanup_cfg: ownership guard projection capacity underflow")
    if guardProjectionCount > guardProjectionRemaining:
        cleanupCfgFail("cleanup_cfg: ownership guard projection arena exhausted")
    let transitionPreflight = cleanupCfgPreflightFlagTransitions(
        plan,
        ownershipAnalysis,
        odir.FlagOriginEdge,
        ownershipEdgeId)
    let transitionCount = transitionPreflight.originKinds.len
    totalPreflight.materializedOpDelta = cleanupCfgCheckedAdd(
        cleanupCfgCheckedSub(totalPreflight.materializedOpDelta,
                             totalPreflight.selectedDeferIds.len,
                             "cleanup_cfg: ownership defer op ledger underflow"),
        transitionCount,
        "cleanup_cfg: ownership edge op delta overflow")
    let removedDeferOperands = cleanupCfgCheckedMul(
        totalPreflight.selectedDeferIds.len,
        2,
        "cleanup_cfg: ownership defer operand removal overflow")
    let transitionOperands = cleanupCfgCheckedMul(
        transitionCount,
        2,
        "cleanup_cfg: ownership edge transition operand overflow")
    totalPreflight.materializedOperandDelta = cleanupCfgCheckedAdd(
        cleanupCfgCheckedSub(totalPreflight.materializedOperandDelta,
                             removedDeferOperands,
                             "cleanup_cfg: ownership defer operand ledger underflow"),
        transitionOperands,
        "cleanup_cfg: ownership edge operand delta overflow")
    if transitionCount > 0:
        totalPreflight.materializedBlockDelta = cleanupCfgCheckedAdd(
            totalPreflight.materializedBlockDelta, 1,
            "cleanup_cfg: ownership transition block overflow")
        totalPreflight.materializedTermDelta = cleanupCfgCheckedAdd(
            totalPreflight.materializedTermDelta, 1,
            "cleanup_cfg: ownership transition term overflow")
    if kind == odir.OwnershipDropEdgeReturn &&
       totalPreflight.selectedDeferIds.len == 0 &&
       snapshot.kind == CleanupReturnSnapshotNone &&
       (runtimeActionCount > 0 || transitionCount > 0):
        totalPreflight.materializedBlockDelta = cleanupCfgCheckedAdd(
            totalPreflight.materializedBlockDelta, 1,
            "cleanup_cfg: ownership return block overflow")
        totalPreflight.materializedTermDelta = cleanupCfgCheckedAdd(
            totalPreflight.materializedTermDelta, 1,
            "cleanup_cfg: ownership return term overflow")
    cleanupCfgRequireMaterializedPreflight(plan, totalPreflight)

    let exitId = cleanupCfgStageExitBound(plan,
                                            fromBlockId,
                                            successorOrdinal,
                                            fromScopeId,
                                            toScopeId,
                                            kind,
                                            targetBlockId,
                                            snapshot,
                                            totalPreflight)
    let actionStart = plan.ownershipActionKinds.len
    for actionIndex in 0..<actionPreflights.len:
        let actionPreflight = actionPreflights[actionIndex]
        cleanupCfgStageOwnershipAction(plan, actionPreflight)
    plan.exitUsesOwnershipActions[exitId] = true
    plan.exitOwnershipEdgeIds[exitId] = ownershipEdgeId
    plan.exitOwnershipActionStarts[exitId] = actionStart
    plan.exitOwnershipActionCounts[exitId] = actionCount
    cleanupCfgStageEdgeTransitions(plan,
                                    exitId,
                                    transitionPreflight)
    return exitId

fn CleanupPlanQueueOwnershipExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        successorOrdinal: int32,
        fromScopeId: int32,
        toScopeId: int32,
        kind: odir.OwnershipDropEdgeKind,
        targetBlockId: int32,
        returnSourceSlot: int32,
        returnSnapshotSlot: int32,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32): int32 =
    var delta: CleanupMutationDelta
    var planCandidate: CleanupPlan
    cleanupCfgBeginPlanMutation(plan, planCandidate, delta)
    delta.resultId = cleanupCfgStageQueueOwnershipExit(
        planCandidate,
        fromBlockId,
        successorOrdinal,
        fromScopeId,
        toScopeId,
        kind,
        targetBlockId,
        returnSourceSlot,
        returnSnapshotSlot,
        ownershipIr,
        ownershipAnalysis,
        ownershipEdgeId)
    cleanupCfgSealPlanMutation(planCandidate, delta)
    cleanupCfgCommitPlanMutation(plan, planCandidate, delta)
    return delta.resultId

fn CleanupPlanQueueOwnershipReturnExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        fromScopeId: int32,
        sourceSlot: int32,
        snapshotSlot: int32,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32): int32 =
    return CleanupPlanQueueOwnershipExit(plan,
                                         fromBlockId,
                                         0,
                                         fromScopeId,
                                         -1,
                                         odir.OwnershipDropEdgeReturn,
                                         -1,
                                         sourceSlot,
                                         snapshotSlot,
                                         ownershipIr,
                                         ownershipAnalysis,
                                         ownershipEdgeId)

fn CleanupPlanQueueOwnedReturnExit(
        plan: var CleanupPlan,
        fromBlockId: int32,
        fromScopeId: int32,
        sourceSlot: int32,
        snapshotSlot: int32,
        ownershipIr: var odir.OwnershipDropIr,
        ownershipAnalysis: var odir.OwnershipDropAnalysis,
        ownershipEdgeId: int32): int32 =
    if ownershipEdgeId < 0 || ownershipEdgeId >= ownershipIr.edges.len ||
       ownershipIr.edges[ownershipEdgeId].returnPlaceId < 0:
        cleanupCfgFail("cleanup_cfg: owned return edge lacks value")
    return CleanupPlanQueueOwnershipReturnExit(plan,
                                               fromBlockId,
                                               fromScopeId,
                                               sourceSlot,
                                               snapshotSlot,
                                               ownershipIr,
                                               ownershipAnalysis,
                                               ownershipEdgeId)

fn cleanupCfgRequireSnapshotBeforeCleanup(plan: var CleanupPlan,
                                          bodyIR: var coreir.BodyIR,
                                          exitId: int32) =
    cleanupCfgRequireExitSnapshotBinding(plan, exitId)
    let snapshotKind = plan.exitReturnSnapshotKinds[exitId]
    let snapshotSlot = plan.exitReturnSnapshotSlots[exitId]
    if snapshotKind == CleanupReturnSnapshotNone:
        return
    let deferStart = plan.exitDeferStarts[exitId]
    let deferCount = plan.exitDeferCounts[exitId]
    for offset in 0..<deferCount:
        let deferId = plan.exitDeferIds[deferStart + offset]
        let fragmentId = plan.deferFragmentIds[deferId]
        let opStart = plan.fragmentOpStarts[fragmentId]
        let opCount = plan.fragmentOpCounts[fragmentId]
        for opOffset in 0..<opCount:
            if plan.opTargets[opStart + opOffset] == snapshotSlot:
                cleanupCfgFail("cleanup_cfg: cleanup overwrites return snapshot")
        let callStart = plan.fragmentCallStarts[fragmentId]
        let callCount = plan.fragmentCallCounts[fragmentId]
        for callOffset in 0..<callCount:
            let callRow = callStart + callOffset
            if plan.callResultSlots[callRow] == snapshotSlot:
                cleanupCfgFail("cleanup_cfg: cleanup call overwrites return snapshot")
            let argStart = plan.callArgStarts[callRow]
            let argCount = plan.callArgCounts[callRow]
            for argOffset in 0..<argCount:
                let argRow = argStart + argOffset
                let argSlot = plan.callArgSlots[argRow]
                let passKind = plan.callArgPassKinds[argRow]
                var referencedSlot = argSlot
                if passKind == coreir.BodyCallPassParamAddressTag ||
                   passKind == coreir.BodyCallPassBorrowAddressTag ||
                   passKind == coreir.BodyCallPassByAddressAggregateTag:
                    if !coreir.CallArgSlotIsAddress(argSlot):
                        cleanupCfgFail("cleanup_cfg: cleanup call address malformed")
                    referencedSlot = coreir.CallArgSlotAddressId(argSlot)
                if referencedSlot == snapshotSlot:
                    cleanupCfgFail("cleanup_cfg: cleanup observes hidden return snapshot")

fn cleanupCfgValidateOwnershipCondition(
        plan: var CleanupPlan,
        kind: odir.OwnershipDropConditionKind,
        flagId: int32,
        localSlot: int32) =
    if kind == odir.DropConditionAlways:
        if flagId != -1 || localSlot != -1:
            cleanupCfgFail("cleanup_cfg: malformed materialized always condition")
        return
    if kind != odir.DropConditionPlaceInitialized &&
       kind != odir.DropConditionFieldInitialized &&
       kind != odir.DropConditionDeferActive &&
       kind != odir.DropConditionCapturedOldPlace &&
       kind != odir.DropConditionCapturedOldField:
        cleanupCfgFail("cleanup_cfg: unsupported materialized ownership condition")
    if flagId <= 0 || localSlot < 0 ||
       localSlot >= plan.localTypeKinds.len ||
       plan.localTypeKinds[localSlot] != coreir.LocalI32Tag:
        cleanupCfgFail("cleanup_cfg: ownership condition local schema mismatch")

fn cleanupCfgValidateTypeLayoutSnapshot(plan: var CleanupPlan) =
    let typeCount = plan.typeLayoutCids.len
    if !plan.typeLayoutBound:
        if len(plan.typeLayoutProviderCid) != 0 || typeCount != 0 ||
           plan.typeLayoutTypeArenaTypeIds.len != 0 ||
           plan.ownershipPlaceBindingPlaceIds.len != 0 ||
           plan.ownershipActionKinds.len != 0:
            cleanupCfgFail("cleanup_cfg: unbound type layout carries ownership rows")
        return
    if len(plan.typeLayoutProviderCid) == 0 || typeCount <= 0 ||
       plan.typeLayoutTypeArenaTypeIds.len != typeCount ||
       plan.typeLayoutKinds.len != typeCount ||
       plan.typeLayoutSizeBytes.len != typeCount ||
       plan.typeLayoutAlignBytes.len != typeCount ||
       plan.typeLayoutPhysicalFieldStarts.len != typeCount ||
       plan.typeLayoutPhysicalFieldCounts.len != typeCount ||
       plan.typeLayoutProjectionStarts.len != typeCount ||
       plan.typeLayoutProjectionCounts.len != typeCount ||
       plan.typeLayoutPhysicalFieldOwnerTypeIds.len !=
           plan.typeLayoutPhysicalFieldTypeIds.len ||
       plan.typeLayoutPhysicalFieldOrdinals.len !=
           plan.typeLayoutPhysicalFieldTypeIds.len ||
       plan.typeLayoutPhysicalFieldByteOffsets.len !=
           plan.typeLayoutPhysicalFieldTypeIds.len ||
       plan.typeLayoutProjectionOwnerTypeIds.len !=
           plan.typeLayoutProjectionFieldOrdinals.len ||
       plan.typeLayoutProjectionOwnerTypeIds.len !=
           plan.typeLayoutProjectionPathStarts.len ||
       plan.typeLayoutProjectionOwnerTypeIds.len !=
           plan.typeLayoutProjectionPathCounts.len:
        cleanupCfgFail("cleanup_cfg: type layout snapshot columns drift")
    var expectedPhysicalStart: int32
    var expectedProjectionStart: int32
    for typeRow in 0..<typeCount:
        if len(plan.typeLayoutCids[typeRow]) == 0 ||
           plan.typeLayoutTypeArenaTypeIds[typeRow] < 0 ||
           plan.typeLayoutSizeBytes[typeRow] <= 0 ||
           plan.typeLayoutAlignBytes[typeRow] <= 0 ||
           plan.typeLayoutPhysicalFieldStarts[typeRow] !=
               expectedPhysicalStart:
            cleanupCfgFail("cleanup_cfg: type layout snapshot type row invalid")
        expectedPhysicalStart = cleanupCfgCheckedAdd(
            expectedPhysicalStart,
            plan.typeLayoutPhysicalFieldCounts[typeRow],
            "cleanup_cfg: type layout snapshot physical range overflow")
        let projectionCount = plan.typeLayoutProjectionCounts[typeRow]
        if projectionCount == 0:
            if plan.typeLayoutProjectionStarts[typeRow] != -1:
                cleanupCfgFail("cleanup_cfg: empty type projection snapshot drift")
        else:
            if plan.typeLayoutProjectionStarts[typeRow] !=
               expectedProjectionStart:
                cleanupCfgFail("cleanup_cfg: type projection snapshot CSR drift")
            expectedProjectionStart = cleanupCfgCheckedAdd(
                expectedProjectionStart,
                projectionCount,
                "cleanup_cfg: type projection snapshot range overflow")
    if expectedPhysicalStart != plan.typeLayoutPhysicalFieldTypeIds.len ||
       expectedProjectionStart !=
           plan.typeLayoutProjectionOwnerTypeIds.len:
        cleanupCfgFail("cleanup_cfg: type layout snapshot CSR rows drift")
    var expectedPathStart: int32
    for projectionRow in 0..<plan.typeLayoutProjectionOwnerTypeIds.len:
        if plan.typeLayoutProjectionPathStarts[projectionRow] !=
               expectedPathStart ||
           plan.typeLayoutProjectionPathCounts[projectionRow] <= 0:
            cleanupCfgFail("cleanup_cfg: type layout snapshot path drift")
        expectedPathStart = cleanupCfgCheckedAdd(
            expectedPathStart,
            plan.typeLayoutProjectionPathCounts[projectionRow],
            "cleanup_cfg: type layout snapshot path overflow")
    if expectedPathStart != plan.typeLayoutProjectionPathOrdinals.len:
        cleanupCfgFail("cleanup_cfg: type layout snapshot path rows drift")

# [wall117b] return 边权威（plan 域内反查，零新列）：ownership 动作只在
# exit 入队时落 plan（cleanupCfgStageQueueOwnershipExit 同点写 exitKinds
# 与 exitOwnershipEdgeIds），据此把动作的 ownership 边映射回终态性。未命
# 中或同边混 kind 一律按非 return 处理（fail-closed，对留扫描内）。与
# wall120 ownership_drop_ir 消费唯一性扫描的 return 边判定同权威：队列时
# exitKinds 即取自该 ownership 边的 kind（wall121 前既有契约）。
fn cleanupCfgOwnershipActionEdgeIsReturn(plan: var CleanupPlan,
                                         ownershipEdgeId: int32): bool =
    var sawReturn: bool
    var sawNonReturn: bool
    for exitId in 0..<plan.exitKinds.len:
        if plan.exitUsesOwnershipActions[exitId] &&
           plan.exitOwnershipEdgeIds[exitId] == ownershipEdgeId:
            if plan.exitKinds[exitId] == odir.OwnershipDropEdgeReturn:
                sawReturn = true
            else:
                sawNonReturn = true
    return sawReturn && !sawNonReturn

fn cleanupCfgValidateOwnershipActionColumns(plan: var CleanupPlan) =
    if plan.ownershipPlaceBindingPlaceIds.len !=
           plan.ownershipPlaceBindingLocalSlots.len ||
       plan.ownershipPlaceBindingPlaceIds.len !=
           plan.ownershipPlaceBindingTypeIds.len ||
       plan.ownershipPlaceBindingPlaceIds.len !=
           plan.ownershipPlaceBindingLayoutCids.len ||
       plan.ownershipPlaceBindingPlaceIds.len !=
           plan.ownershipPlaceFieldIndexStarts.len ||
       plan.ownershipPlaceBindingPlaceIds.len !=
           plan.ownershipPlaceFieldIndexCounts.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingOrdinals.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingBaseSlots.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingProjectionSlots.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingStepStarts.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingStepCounts.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingCapturedActionIds.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingOwnerTypeIds.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingOwnerLayoutCids.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingLeafTypeIds.len ||
       plan.ownershipFieldBindingPlaceIds.len !=
           plan.ownershipFieldBindingLeafLayoutCids.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionByteOffsets.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionContainerSizes.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionTypeKinds.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionSizeBytes.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionAlignBytes.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionTypeIds.len ||
       plan.ownershipFieldProjectionOrdinals.len !=
           plan.ownershipFieldProjectionLayoutCids.len ||
       plan.ownershipDropGlueBindingGlueIds.len !=
           plan.ownershipDropGlueBindingSymbols.len ||
       plan.ownershipDropGlueBindingGlueIds.len !=
           plan.ownershipDropGlueBindingTypeIds.len ||
       plan.ownershipDropGlueBindingGlueIds.len !=
           plan.ownershipDropGlueBindingLayoutCids.len ||
       plan.ownershipRetainGlueBindingTypeIds.len !=
           plan.ownershipRetainGlueBindingSymbols.len ||
       plan.ownershipRetainGlueBindingTypeIds.len !=
           plan.ownershipRetainGlueBindingLayoutCids.len ||
       plan.ownershipConditionFlagBindingFlagIds.len !=
           plan.ownershipConditionFlagBindingLocalSlots.len ||
       plan.ownershipConditionFlagBindingFlagIds.len !=
           plan.ownershipConditionFlagBindingInitialValues.len:
        cleanupCfgFail("cleanup_cfg: ownership binding SoA columns drift")
    var expectedFieldDomainStart: int32
    for placeBinding in 0..<plan.ownershipPlaceBindingPlaceIds.len:
        let placeId = plan.ownershipPlaceBindingPlaceIds[placeBinding]
        let typeId = plan.ownershipPlaceBindingTypeIds[placeBinding]
        let typeRow = cleanupCfgPlanTypeLayoutRow(plan, typeId)
        let localSlot = plan.ownershipPlaceBindingLocalSlots[placeBinding]
        let fieldCount = plan.ownershipPlaceFieldIndexCounts[placeBinding]
        let auditSlotKind =
            if localSlot >= 0 && localSlot < plan.localTypeKinds.len:
                plan.localTypeKinds[localSlot]
            else:
                -1
        let auditRowKind = plan.typeLayoutKinds[typeRow]
        if placeId != placeBinding + 1 ||
           placeId >= plan.ownershipPlaceBindingIndexByPlaceId.len ||
           plan.ownershipPlaceBindingIndexByPlaceId[placeId] != placeBinding ||
           localSlot < 0 || localSlot >= plan.localTypeKinds.len ||
           auditSlotKind != auditRowKind ||
           plan.localSizeBytes[localSlot] !=
               plan.typeLayoutSizeBytes[typeRow] ||
           plan.localAlignBytes[localSlot] !=
               plan.typeLayoutAlignBytes[typeRow] ||
           plan.ownershipPlaceBindingLayoutCids[placeBinding] !=
               plan.typeLayoutCids[typeRow] ||
           plan.ownershipPlaceFieldIndexStarts[placeBinding] !=
               expectedFieldDomainStart ||
           fieldCount != plan.typeLayoutProjectionCounts[typeRow]:
            cleanupCfgFail("cleanup_cfg: ownership place dense-index drift")
        expectedFieldDomainStart = cleanupCfgCheckedAdd(
            expectedFieldDomainStart,
            fieldCount,
            "cleanup_cfg: ownership field dense-index range overflow")
    if expectedFieldDomainStart !=
       plan.ownershipFieldBindingIndexByPlaceField.len:
        cleanupCfgFail("cleanup_cfg: ownership field dense-index rows drift")
    for fieldBinding in 0..<plan.ownershipFieldBindingPlaceIds.len:
        let placeId = plan.ownershipFieldBindingPlaceIds[fieldBinding]
        let fieldOrdinal = plan.ownershipFieldBindingOrdinals[fieldBinding]
        let capturedActionId =
            plan.ownershipFieldBindingCapturedActionIds[fieldBinding]
        if capturedActionId == 0:
            if placeId <= 0 ||
               placeId >= plan.ownershipPlaceBindingIndexByPlaceId.len:
                cleanupCfgFail("cleanup_cfg: ownership field dense-index owner drift")
            let placeBinding =
                plan.ownershipPlaceBindingIndexByPlaceId[placeId]
            if placeBinding < 0 || fieldOrdinal < 0 ||
               fieldOrdinal >=
                   plan.ownershipPlaceFieldIndexCounts[placeBinding]:
                cleanupCfgFail("cleanup_cfg: ownership field dense-index identity drift")
            let denseRow = cleanupCfgCheckedAdd(
                plan.ownershipPlaceFieldIndexStarts[placeBinding],
                fieldOrdinal,
                "cleanup_cfg: ownership field dense-index row overflow")
            if plan.ownershipFieldBindingIndexByPlaceField[denseRow] !=
               fieldBinding:
                cleanupCfgFail("cleanup_cfg: ownership field dense-index binding drift")
        elif capturedActionId <= 0:
            cleanupCfgFail("cleanup_cfg: captured field action identity invalid")
    for glueIndex in 0..<plan.ownershipDropGlueBindingGlueIds.len:
        let glueId = plan.ownershipDropGlueBindingGlueIds[glueIndex]
        let typeId = plan.ownershipDropGlueBindingTypeIds[glueIndex]
        let typeRow = cleanupCfgPlanTypeLayoutRow(plan, typeId)
        if glueId <= 0 ||
           glueId >= plan.ownershipDropGlueBindingIndexByGlueId.len ||
           plan.ownershipDropGlueBindingIndexByGlueId[glueId] != glueIndex ||
           plan.ownershipDropGlueBindingLayoutCids[glueIndex] !=
               plan.typeLayoutCids[typeRow]:
            cleanupCfgFail("cleanup_cfg: drop glue dense-index drift")
    for retainIndex in 0..<plan.ownershipRetainGlueBindingTypeIds.len:
        let typeId = plan.ownershipRetainGlueBindingTypeIds[retainIndex]
        let typeRow = cleanupCfgPlanTypeLayoutRow(plan, typeId)
        if typeId <= 0 ||
           typeId >= plan.ownershipRetainGlueBindingIndexByTypeId.len ||
           plan.ownershipRetainGlueBindingIndexByTypeId[typeId] !=
               retainIndex ||
           plan.ownershipRetainGlueBindingLayoutCids[retainIndex] !=
               plan.typeLayoutCids[typeRow]:
            cleanupCfgFail("cleanup_cfg: retain glue dense-index drift")
    for flagBinding in 0..<plan.ownershipConditionFlagBindingFlagIds.len:
        let flagId =
            plan.ownershipConditionFlagBindingFlagIds[flagBinding]
        let localSlot =
            plan.ownershipConditionFlagBindingLocalSlots[flagBinding]
        if flagId <= 0 || flagId >= plan.ownershipConditionLocalByFlagId.len ||
           localSlot < 0 ||
           localSlot >= plan.ownershipConditionFlagIdByLocalSlot.len ||
           plan.ownershipConditionLocalByFlagId[flagId] != localSlot ||
           plan.ownershipConditionFlagIdByLocalSlot[localSlot] != flagId:
            cleanupCfgFail("cleanup_cfg: condition flag dense-index drift")
    let actionCount = plan.ownershipActionKinds.len
    if plan.ownershipActionEdgeIds.len != actionCount ||
       plan.ownershipActionOpIds.len != actionCount ||
       plan.ownershipActionOrdinals.len != actionCount ||
       plan.ownershipActionIds.len != actionCount ||
       plan.ownershipActionCleanupDeferIds.len != actionCount ||
       plan.ownershipActionTargetSlots.len != actionCount ||
       plan.ownershipActionSourceSlots.len != actionCount ||
       plan.ownershipActionDropGlueBindingIndices.len != actionCount ||
       plan.ownershipActionRetainGlueBindingIndices.len != actionCount ||
       plan.ownershipActionCapturedOldSlots.len != actionCount ||
       plan.ownershipActionPlaceIds.len != actionCount ||
       plan.ownershipActionFieldOrdinals.len != actionCount ||
       plan.ownershipActionFieldProjectionBindingIndices.len != actionCount ||
       plan.ownershipActionTypeIds.len != actionCount ||
       plan.ownershipActionLayoutCids.len != actionCount ||
       plan.ownershipActionDefinitionOriginKinds.len != actionCount ||
       plan.ownershipActionDefinitionOriginIds.len != actionCount ||
       plan.ownershipActionSourceDefinitionDomains.len != actionCount ||
       plan.ownershipActionSourceDefinitionRows.len != actionCount ||
       plan.ownershipActionCapturedOldSourceDefinitionDomains.len !=
           actionCount ||
       plan.ownershipActionCapturedOldSourceDefinitionRows.len !=
           actionCount ||
       plan.ownershipActionSourceOwnershipKinds.len != actionCount ||
       plan.ownershipActionConsumeActionRows.len != actionCount ||
       plan.ownershipActionPrimaryKinds.len != actionCount ||
       plan.ownershipActionPrimaryFlagIds.len != actionCount ||
       plan.ownershipActionPrimaryFlagSlots.len != actionCount ||
       plan.ownershipActionPrimaryNegated.len != actionCount ||
       plan.ownershipActionSecondaryKinds.len != actionCount ||
       plan.ownershipActionSecondaryFlagIds.len != actionCount ||
       plan.ownershipActionSecondaryFlagSlots.len != actionCount ||
       plan.ownershipActionSecondaryNegated.len != actionCount ||
       plan.ownershipActionGuardKinds.len != actionCount ||
       plan.ownershipActionGuardFlagIds.len != actionCount ||
       plan.ownershipActionGuardFlagSlots.len != actionCount ||
       plan.ownershipActionGuardNegated.len != actionCount ||
       plan.ownershipActionGuardCleanupDeferIds.len != actionCount ||
       plan.ownershipActionGuardAuditSeen.len != actionCount ||
       plan.ownershipActionDeferClearAfterBody.len != actionCount ||
       plan.ownershipActionClearFlagStarts.len != actionCount ||
       plan.ownershipActionClearFlagCounts.len != actionCount:
        cleanupCfgFail("cleanup_cfg: ownership action SoA columns drift")
    for actionRow in 0..<actionCount:
        cleanupCfgValidateOwnershipCondition(
            plan,
            plan.ownershipActionPrimaryKinds[actionRow],
            plan.ownershipActionPrimaryFlagIds[actionRow],
            plan.ownershipActionPrimaryFlagSlots[actionRow])
        cleanupCfgValidateOwnershipCondition(
            plan,
            plan.ownershipActionSecondaryKinds[actionRow],
            plan.ownershipActionSecondaryFlagIds[actionRow],
            plan.ownershipActionSecondaryFlagSlots[actionRow])
        cleanupCfgValidateOwnershipCondition(
            plan,
            plan.ownershipActionGuardKinds[actionRow],
            plan.ownershipActionGuardFlagIds[actionRow],
            plan.ownershipActionGuardFlagSlots[actionRow])
        let clearStart = plan.ownershipActionClearFlagStarts[actionRow]
        let clearCount = plan.ownershipActionClearFlagCounts[actionRow]
        if clearStart < 0 || clearCount < 0 ||
           cleanupCfgCheckedAdd(
               clearStart,
               clearCount,
               "cleanup_cfg: ownership action clear range overflow") >
               plan.ownershipActionClearFlagSlots.len:
            cleanupCfgFail("cleanup_cfg: ownership action clear range corrupt")
        for clearOffset in 0..<clearCount:
            let clearRow = cleanupCfgCheckedAdd(
                clearStart,
                clearOffset,
                "cleanup_cfg: ownership clear row overflow")
            let clearSlot =
                plan.ownershipActionClearFlagSlots[clearRow]
            if clearSlot < 0 || clearSlot >= plan.localTypeKinds.len ||
               plan.localTypeKinds[clearSlot] != coreir.LocalI32Tag:
                cleanupCfgFail("cleanup_cfg: ownership clear flag schema mismatch")
        let kind = plan.ownershipActionKinds[actionRow]
        let actionId = plan.ownershipActionIds[actionRow]
        let edgeId = plan.ownershipActionEdgeIds[actionRow]
        let opId = plan.ownershipActionOpIds[actionRow]
        let actionTypeId = plan.ownershipActionTypeIds[actionRow]
        let actionLayoutCid = plan.ownershipActionLayoutCids[actionRow]
        let definitionOriginKind =
            plan.ownershipActionDefinitionOriginKinds[actionRow]
        let definitionOriginId =
            plan.ownershipActionDefinitionOriginIds[actionRow]
        let sourceDefinitionDomain =
            plan.ownershipActionSourceDefinitionDomains[actionRow]
        let sourceDefinitionRow =
            plan.ownershipActionSourceDefinitionRows[actionRow]
        let capturedOldSourceDefinitionDomain =
            plan.ownershipActionCapturedOldSourceDefinitionDomains[
                actionRow]
        let capturedOldSourceDefinitionRow =
            plan.ownershipActionCapturedOldSourceDefinitionRows[actionRow]
        let sourceOwnership =
            plan.ownershipActionSourceOwnershipKinds[actionRow]
        let consumeActionRow =
            plan.ownershipActionConsumeActionRows[actionRow]
        let capturedAuthority =
            actionId > 0 &&
            (kind == odir.CleanupActionDropPlace ||
             kind == odir.CleanupActionDropField)
        let sourceAuthority =
            kind == odir.CleanupActionRetainValue ||
            kind == odir.CleanupActionStoreOwned ||
            kind == odir.CleanupActionStoreMove ||
            kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
            kind == odir.CleanupActionSnapshotCloneOwnedReturn ||
            kind == odir.CleanupActionReturnUnmanaged
        let managedSyntheticProducerDropAuthority =
            actionId == 0 &&
            kind == odir.CleanupActionDropPlace &&
            definitionOriginKind ==
                odir.DefinitionOriginCanonicalSyntheticAction
        let managedTypedProducerDropAuthority =
            actionId == 0 &&
            kind == odir.CleanupActionDropPlace &&
            definitionOriginKind == odir.DefinitionOriginTypedExpr
        let projectedCapturedOld =
            kind == odir.CleanupActionStoreOwned ||
            capturedAuthority
        if projectedCapturedOld:
            if !cleanupCfgDefinitionCoordinateValid(
                   capturedOldSourceDefinitionDomain,
                   capturedOldSourceDefinitionRow):
                cleanupCfgFail(
                    "cleanup_cfg: captured-old definition authority missing")
        elif capturedOldSourceDefinitionDomain != 0 ||
             capturedOldSourceDefinitionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: captured-old definition authority misplaced")
        if capturedAuthority:
            if definitionOriginKind !=
                   odir.DefinitionOriginCanonicalSyntheticAction ||
               definitionOriginId < 0 ||
               sourceDefinitionDomain != 0 ||
               sourceDefinitionRow != -1 ||
               sourceOwnership != odir.Owned || consumeActionRow < 0:
                cleanupCfgFail(
                    "cleanup_cfg: captured action authority invalid")
        elif sourceAuthority:
            var sourceOwnershipValid =
                sourceOwnership == odir.Owned ||
                sourceOwnership == odir.RcBorrowedValue
            if kind == odir.CleanupActionReturnUnmanaged:
                sourceOwnershipValid = sourceOwnership == odir.Unmanaged
            if definitionOriginKind != odir.DefinitionOriginTypedExpr ||
               definitionOriginId < 0 ||
               !cleanupCfgDefinitionCoordinateValid(
                   sourceDefinitionDomain,
                   sourceDefinitionRow) ||
               !sourceOwnershipValid:
                cleanupCfgFail(
                    "cleanup_cfg: source action authority invalid")
            if (kind == odir.CleanupActionStoreMove &&
                consumeActionRow < 0) ||
               (kind != odir.CleanupActionStoreMove &&
                consumeActionRow != -1):
                cleanupCfgFail(
                    "cleanup_cfg: source action consume authority invalid")
        elif managedSyntheticProducerDropAuthority:
            var producerTargetMatches: bool
            if definitionOriginId >= 0 &&
               definitionOriginId < actionCount:
                let producerKind =
                    plan.ownershipActionKinds[definitionOriginId]
                if producerKind == odir.CleanupActionStoreMove:
                    producerTargetMatches =
                        plan.ownershipActionTargetSlots[
                            definitionOriginId] ==
                        plan.ownershipActionTargetSlots[actionRow]
                elif producerKind == odir.CleanupActionRetainValue:
                    let candidateStart = definitionOriginId + 1
                    for candidateRow in candidateStart..<actionRow:
                        if plan.ownershipActionKinds[candidateRow] ==
                               odir.CleanupActionStoreOwned &&
                           plan.ownershipActionOpIds[candidateRow] ==
                               plan.ownershipActionOpIds[
                                   definitionOriginId] &&
                           plan.ownershipActionTargetSlots[candidateRow] ==
                               plan.ownershipActionTargetSlots[actionRow]:
                            if producerTargetMatches:
                                cleanupCfgFail(
                                    "cleanup_cfg: retained producer target duplicated")
                            producerTargetMatches = true
            if definitionOriginId < 0 ||
               definitionOriginId >= actionCount ||
               (plan.ownershipActionKinds[definitionOriginId] !=
                    odir.CleanupActionStoreMove &&
                plan.ownershipActionKinds[definitionOriginId] !=
                    odir.CleanupActionRetainValue) ||
               plan.ownershipActionOpIds[definitionOriginId] < 0 ||
               !producerTargetMatches ||
               sourceDefinitionDomain != 0 ||
               sourceDefinitionRow != -1 ||
               sourceOwnership != odir.Owned ||
               consumeActionRow != actionRow:
                cleanupCfgFail(
                    "cleanup_cfg: managed producer drop authority invalid")
        elif managedTypedProducerDropAuthority:
            if definitionOriginId < 0 ||
               !cleanupCfgDefinitionCoordinateValid(
                   sourceDefinitionDomain,
                   sourceDefinitionRow) ||
               sourceOwnership != odir.Owned ||
               consumeActionRow != actionRow:
                cleanupCfgFail(
                    "cleanup_cfg: initialized producer drop authority invalid")
        elif definitionOriginKind != odir.DefinitionOriginUnknown ||
             definitionOriginId != -1 ||
             sourceDefinitionDomain != 0 ||
             sourceDefinitionRow != -1 ||
             sourceOwnership != odir.OwnershipUnknown ||
             consumeActionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: unsupported action carries authority")
        if consumeActionRow >= 0:
            # [wall117b] 同 return 边互斥跳过（wall120 ownership_drop_ir
            # 消费唯一性扫描的同域对齐，零弱化）：cleanup 动作按 exit 边从
            # 共享 pre-edge 态重发，一条执行至多经过一条 return 边，故不同
            # return 边对同一定义的消费互斥合法。同边重发、op 域动作
            # （edgeId<0）与任何含非 return 边的对仍留在扫描内；同路径跨顺
            # 序边的双消费仍由流格拒绝（消费型 drop 重置 place 产者与定义
            # 事实，join 不相容即炸）。
            let actionTerminalReturn =
                edgeId >= 0 &&
                    cleanupCfgOwnershipActionEdgeIsReturn(plan, edgeId)
            for previousRow in 0..<actionRow:
                let previousEdgeId =
                    plan.ownershipActionEdgeIds[previousRow]
                let previousTerminalReturn =
                    previousEdgeId >= 0 &&
                        cleanupCfgOwnershipActionEdgeIsReturn(
                            plan,
                            previousEdgeId)
                if plan.ownershipActionConsumeActionRows[previousRow] >= 0 &&
                   !(actionTerminalReturn &&
                     previousTerminalReturn &&
                     edgeId != previousEdgeId) &&
                   plan.ownershipActionDefinitionOriginKinds[previousRow] ==
                       definitionOriginKind &&
                   plan.ownershipActionDefinitionOriginIds[previousRow] ==
                       definitionOriginId &&
                   plan.ownershipActionSourceDefinitionDomains[
                       previousRow] ==
                       sourceDefinitionDomain &&
                   plan.ownershipActionSourceDefinitionRows[previousRow] ==
                       sourceDefinitionRow:
                    cleanupCfgFail(
                        Fmt"cleanup_cfg: value definition consumed twice prev_index={previousRow} action_index={actionRow} prev_kind={Int32(plan.ownershipActionKinds[previousRow])} act_kind={Int32(kind)} origin_kind={Int32(definitionOriginKind)} origin_id={definitionOriginId} domain={sourceDefinitionDomain} row={sourceDefinitionRow} prev_edge={plan.ownershipActionEdgeIds[previousRow]} act_edge={edgeId} prev_op={plan.ownershipActionOpIds[previousRow]} act_op={opId} prev_place={plan.ownershipActionPlaceIds[previousRow]} act_place={plan.ownershipActionPlaceIds[actionRow]} prev_consume={plan.ownershipActionConsumeActionRows[previousRow]} act_consume={consumeActionRow}")
        if (edgeId >= 0) == (opId >= 0) ||
           plan.ownershipActionGuardAuditSeen[actionRow]:
            cleanupCfgFail("cleanup_cfg: ownership action origin corrupt")
        if kind == odir.CleanupActionDefer:
            if actionTypeId != -1 || len(actionLayoutCid) != 0:
                cleanupCfgFail("cleanup_cfg: defer action carries type layout")
        else:
            let actionTypeRow = cleanupCfgPlanTypeLayoutRow(plan,
                                                            actionTypeId)
            if actionLayoutCid != plan.typeLayoutCids[actionTypeRow]:
                cleanupCfgFail("cleanup_cfg: ownership action type layout drift")
        let actionPlaceId = plan.ownershipActionPlaceIds[actionRow]
        let actionFieldOrdinal =
            plan.ownershipActionFieldOrdinals[actionRow]
        let actionFieldBinding =
            plan.ownershipActionFieldProjectionBindingIndices[actionRow]
        if kind == odir.CleanupActionDropField:
            if actionFieldBinding < 0 ||
               actionFieldBinding >=
                   plan.ownershipFieldBindingPlaceIds.len ||
               plan.ownershipFieldBindingPlaceIds[actionFieldBinding] !=
                   actionPlaceId ||
               plan.ownershipFieldBindingOrdinals[actionFieldBinding] !=
                   actionFieldOrdinal ||
               plan.ownershipFieldBindingLeafTypeIds[actionFieldBinding] !=
                   actionTypeId ||
               plan.ownershipFieldBindingLeafLayoutCids[actionFieldBinding] !=
                   actionLayoutCid:
                cleanupCfgFail("cleanup_cfg: field action projection type layout drift")
        elif kind == odir.CleanupActionDefer:
            if actionPlaceId != -1 || actionFieldOrdinal != -1 ||
               actionFieldBinding != -1:
                cleanupCfgFail("cleanup_cfg: defer action carries place binding")
        else:
            let placeBinding = cleanupCfgOwnershipPlaceBindingIndex(
                plan,
                actionPlaceId)
            if actionFieldOrdinal != -1 || actionFieldBinding != -1 ||
               plan.ownershipPlaceBindingTypeIds[placeBinding] !=
                   actionTypeId ||
               plan.ownershipPlaceBindingLayoutCids[placeBinding] !=
                   actionLayoutCid:
                cleanupCfgFail("cleanup_cfg: action place type layout drift")
        if kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
           kind == odir.CleanupActionSnapshotCloneOwnedReturn ||
           kind == odir.CleanupActionReturnUnmanaged:
            if opId != -1 ||
               plan.ownershipActionCleanupDeferIds[actionRow] != -1 ||
               plan.ownershipActionTargetSlots[actionRow] != -1 ||
               plan.ownershipActionSourceSlots[actionRow] != -1 ||
               plan.ownershipActionDropGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionRetainGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionCapturedOldSlots[actionRow] != -1 ||
               clearCount != 0:
                cleanupCfgFail(
                    "cleanup_cfg: malformed materialized snapshot action")
        elif kind == odir.CleanupActionDefer:
            let deferId = plan.ownershipActionCleanupDeferIds[actionRow]
            if opId != -1 || deferId < 0 ||
               deferId >= plan.deferActiveFlagSlots.len ||
               plan.ownershipActionTargetSlots[actionRow] != -1 ||
               plan.ownershipActionSourceSlots[actionRow] != -1 ||
               plan.ownershipActionDropGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionRetainGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionCapturedOldSlots[actionRow] != -1 ||
               clearCount != 0 ||
               plan.ownershipActionDeferClearAfterBody[actionRow]:
                cleanupCfgFail("cleanup_cfg: malformed materialized defer action")
        elif kind == odir.CleanupActionDropPlace ||
             kind == odir.CleanupActionDropField:
            let targetSlot = plan.ownershipActionTargetSlots[actionRow]
            let glueIndex = plan.ownershipActionDropGlueBindingIndices[actionRow]
            # [wall121] 物化 drop 目标 ref 句柄臂：与本文件
            # cleanupCfgRequireManagedLocal 同一契约域（wall118 胶权威
            # cheng_ref_drop_owned 的消费点），LocalPtrTag 证明链在册托管
            # 句柄槽原样准入，检测面零弱化。
            if targetSlot < 0 || targetSlot >= plan.localTypeKinds.len ||
               (plan.localTypeKinds[targetSlot] != coreir.LocalStrTag &&
                plan.localTypeKinds[targetSlot] != coreir.LocalAggregateTag &&
                plan.localTypeKinds[targetSlot] != coreir.LocalPtrTag) ||
               plan.localManagedStorageKinds[targetSlot] !=
                   coreir.BodyManagedStorageManagedTag ||
               plan.localTypeArenaTypeIds[targetSlot] < 0 ||
               glueIndex < 0 ||
               glueIndex >= plan.ownershipDropGlueBindingSymbols.len ||
               plan.ownershipActionSourceSlots[actionRow] != -1 ||
               plan.ownershipActionCleanupDeferIds[actionRow] != -1 ||
               plan.ownershipActionRetainGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionDeferClearAfterBody[actionRow] ||
               (edgeId >= 0 && clearCount <= 0):
                cleanupCfgFail("cleanup_cfg: malformed materialized drop action")
            if plan.ownershipDropGlueBindingTypeIds[glueIndex] !=
                   actionTypeId ||
               plan.ownershipDropGlueBindingLayoutCids[glueIndex] !=
                   actionLayoutCid:
                cleanupCfgFail("cleanup_cfg: drop action glue type layout drift")
            let capturedSlot =
                plan.ownershipActionCapturedOldSlots[actionRow]
            if actionId == 0:
                if capturedSlot != -1:
                    cleanupCfgFail("cleanup_cfg: uncaptured drop carries snapshot")
            else:
                if opId < 0 || capturedSlot < 0 ||
                   capturedSlot >= plan.localTypeKinds.len ||
                   plan.localPlaceKinds[capturedSlot] !=
                       coreir.BodyPlaceStackValueTag:
                    cleanupCfgFail(
                        "cleanup_cfg: captured drop snapshot binding invalid")
                if kind == odir.CleanupActionDropPlace:
                    if targetSlot != capturedSlot:
                        cleanupCfgFail(
                            "cleanup_cfg: captured place drop target drift")
                else:
                    let projectionSlot =
                        plan.ownershipFieldBindingProjectionSlots[
                            actionFieldBinding]
                    if targetSlot == capturedSlot ||
                       plan.localPlaceKinds[targetSlot] !=
                           coreir.BodyPlaceStackValueTag ||
                       projectionSlot < 0 ||
                       projectionSlot >= plan.localTypeKinds.len ||
                       projectionSlot == targetSlot ||
                       projectionSlot == capturedSlot ||
                       plan.localPlaceKinds[projectionSlot] !=
                           coreir.BodyPlaceBorrowAddressTag:
                        cleanupCfgFail(
                            "cleanup_cfg: captured field drop owner drift")
        elif kind == odir.CleanupActionRetainValue:
            let targetSlot = plan.ownershipActionTargetSlots[actionRow]
            let sourceSlot = plan.ownershipActionSourceSlots[actionRow]
            let retainIndex =
                plan.ownershipActionRetainGlueBindingIndices[actionRow]
            if edgeId != -1 || opId < 0 || actionId != 0 ||
               targetSlot < 0 || sourceSlot < 0 ||
               targetSlot >= plan.localTypeKinds.len ||
               sourceSlot >= plan.localTypeKinds.len ||
               plan.localTypeKinds[targetSlot] !=
                   plan.localTypeKinds[sourceSlot] ||
               plan.localPlaceKinds[targetSlot] !=
                   coreir.BodyPlaceStackValueTag ||
               plan.localPlaceKinds[sourceSlot] !=
                   coreir.BodyPlaceStackValueTag ||
               plan.localSizeBytes[targetSlot] !=
                   plan.localSizeBytes[sourceSlot] ||
               plan.localAlignBytes[targetSlot] !=
                   plan.localAlignBytes[sourceSlot] ||
               retainIndex < 0 ||
               retainIndex >= plan.ownershipRetainGlueBindingSymbols.len ||
               plan.ownershipActionDropGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionCapturedOldSlots[actionRow] != -1 ||
               plan.ownershipActionCleanupDeferIds[actionRow] != -1 ||
               plan.ownershipActionPrimaryKinds[actionRow] !=
                   odir.DropConditionAlways ||
               plan.ownershipActionSecondaryKinds[actionRow] !=
                   odir.DropConditionAlways ||
               clearCount != 0:
                cleanupCfgFail("cleanup_cfg: malformed materialized retain action")
            if plan.ownershipRetainGlueBindingTypeIds[retainIndex] !=
                   actionTypeId ||
               plan.ownershipRetainGlueBindingLayoutCids[retainIndex] !=
                   actionLayoutCid:
                cleanupCfgFail("cleanup_cfg: retain action glue type layout drift")
        elif kind == odir.CleanupActionStoreOwned:
            let targetSlot = plan.ownershipActionTargetSlots[actionRow]
            let sourceSlot = plan.ownershipActionSourceSlots[actionRow]
            let capturedSlot =
                plan.ownershipActionCapturedOldSlots[actionRow]
            if edgeId != -1 || opId < 0 ||
               actionId != cleanupCfgCheckedAdd(
                   opId,
                   1,
                   "cleanup_cfg: retained action id overflow") ||
               targetSlot < 0 || sourceSlot < 0 || capturedSlot < 0 ||
               targetSlot >= plan.localTypeKinds.len ||
               sourceSlot >= plan.localTypeKinds.len ||
               capturedSlot >= plan.localTypeKinds.len ||
               capturedSlot == targetSlot || capturedSlot == sourceSlot ||
               plan.localTypeKinds[targetSlot] !=
                   plan.localTypeKinds[sourceSlot] ||
               plan.localTypeKinds[targetSlot] !=
                   plan.localTypeKinds[capturedSlot] ||
               plan.localSizeBytes[targetSlot] !=
                   plan.localSizeBytes[sourceSlot] ||
               plan.localSizeBytes[targetSlot] !=
                   plan.localSizeBytes[capturedSlot] ||
               plan.localAlignBytes[targetSlot] !=
                   plan.localAlignBytes[sourceSlot] ||
               plan.localAlignBytes[targetSlot] !=
                   plan.localAlignBytes[capturedSlot] ||
               plan.localPlaceKinds[targetSlot] !=
                   coreir.BodyPlaceStackValueTag ||
               plan.localPlaceKinds[sourceSlot] !=
                   coreir.BodyPlaceStackValueTag ||
               plan.localPlaceKinds[capturedSlot] !=
                   coreir.BodyPlaceStackValueTag ||
               plan.ownershipActionDropGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionRetainGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionCleanupDeferIds[actionRow] != -1 ||
               plan.ownershipActionPrimaryKinds[actionRow] !=
                   odir.DropConditionAlways ||
               plan.ownershipActionSecondaryKinds[actionRow] !=
                   odir.DropConditionAlways ||
               clearCount != 0:
                cleanupCfgFail("cleanup_cfg: malformed materialized store-owned action")
        elif kind == odir.CleanupActionStoreMove:
            let targetSlot = plan.ownershipActionTargetSlots[actionRow]
            let sourceSlot = plan.ownershipActionSourceSlots[actionRow]
            if edgeId != -1 || opId < 0 || targetSlot < 0 ||
               sourceSlot < 0 || targetSlot == sourceSlot ||
               targetSlot >= plan.localTypeKinds.len ||
               sourceSlot >= plan.localTypeKinds.len ||
               plan.localTypeKinds[targetSlot] !=
                   plan.localTypeKinds[sourceSlot] ||
               plan.localSizeBytes[targetSlot] !=
                   plan.localSizeBytes[sourceSlot] ||
               plan.localAlignBytes[targetSlot] !=
                   plan.localAlignBytes[sourceSlot] ||
               plan.ownershipActionCleanupDeferIds[actionRow] != -1 ||
               plan.ownershipActionDropGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionRetainGlueBindingIndices[actionRow] != -1 ||
               plan.ownershipActionCapturedOldSlots[actionRow] != -1 ||
               actionId != 0 ||
               plan.ownershipActionPrimaryKinds[actionRow] !=
                   odir.DropConditionAlways ||
               plan.ownershipActionSecondaryKinds[actionRow] !=
                   odir.DropConditionAlways ||
               clearCount != 0:
                cleanupCfgFail("cleanup_cfg: malformed materialized move action")
        else:
            cleanupCfgFail("cleanup_cfg: unsupported action reached materializer")
        if opId >= 0 &&
           (plan.ownershipActionGuardKinds[actionRow] !=
                odir.DropConditionAlways ||
            plan.ownershipActionGuardCleanupDeferIds[actionRow] != -1):
            cleanupCfgFail("cleanup_cfg: ownership op action guard unsupported")
        if (plan.ownershipActionPrimaryKinds[actionRow] ==
                odir.DropConditionCapturedOldPlace ||
            plan.ownershipActionPrimaryKinds[actionRow] ==
                odir.DropConditionCapturedOldField) &&
           plan.ownershipActionPrimaryFlagIds[actionRow] != actionId:
            cleanupCfgFail("cleanup_cfg: captured primary action id drift")
        if (plan.ownershipActionSecondaryKinds[actionRow] ==
                odir.DropConditionCapturedOldPlace ||
            plan.ownershipActionSecondaryKinds[actionRow] ==
                odir.DropConditionCapturedOldField) &&
           plan.ownershipActionSecondaryFlagIds[actionRow] != actionId:
            cleanupCfgFail("cleanup_cfg: captured secondary action id drift")
        let guardDeferId =
            plan.ownershipActionGuardCleanupDeferIds[actionRow]
        if plan.ownershipActionGuardKinds[actionRow] ==
               odir.DropConditionDeferActive:
            if guardDeferId < 0 ||
               guardDeferId >= plan.deferActiveFlagSlots.len ||
               plan.ownershipActionGuardFlagSlots[actionRow] !=
                   plan.deferActiveFlagSlots[guardDeferId]:
                cleanupCfgFail("cleanup_cfg: ownership action guard slot drift")
        elif guardDeferId != -1:
            cleanupCfgFail("cleanup_cfg: ownership action guard identity drift")

    let opSiteCount = plan.ownershipOpTransitionOwnershipOpIds.len
    if plan.ownershipOpActionStarts.len != opSiteCount ||
       plan.ownershipOpActionCounts.len != opSiteCount:
        cleanupCfgFail("cleanup_cfg: ownership op action site columns drift")
    var expectedActionStart: int32
    for siteIndex in 0..<opSiteCount:
        let start = plan.ownershipOpActionStarts[siteIndex]
        let count = plan.ownershipOpActionCounts[siteIndex]
        let ownershipOpId =
            plan.ownershipOpTransitionOwnershipOpIds[siteIndex]
        if start != expectedActionStart || count < 0 ||
           cleanupCfgCheckedAdd(
               start,
               count,
               "cleanup_cfg: ownership op action range overflow") >
               actionCount:
            cleanupCfgFail("cleanup_cfg: ownership op action range corrupt")
        var retainedSequence: bool
        var retainedActionId = -1
        var retainedStoreRow = -1
        if count > 0 &&
           plan.ownershipActionKinds[start] ==
               odir.CleanupActionRetainValue:
            retainedSequence = true
            retainedActionId = cleanupCfgCheckedAdd(
                ownershipOpId,
                1,
                "cleanup_cfg: retained action id overflow")
            retainedStoreRow = cleanupCfgCheckedAdd(
                start,
                1,
                "cleanup_cfg: retained store row overflow")
            if count < 2 || plan.ownershipActionIds[start] != 0 ||
               plan.ownershipActionKinds[retainedStoreRow] !=
                   odir.CleanupActionStoreOwned ||
               plan.ownershipActionIds[retainedStoreRow] != retainedActionId:
                cleanupCfgFail("cleanup_cfg: retained action order drift")
        for ordinal in 0..<count:
            let row = cleanupCfgCheckedAdd(
                start,
                ordinal,
                "cleanup_cfg: ownership op action row overflow")
            if plan.ownershipActionOpIds[row] != ownershipOpId ||
               plan.ownershipActionEdgeIds[row] != -1 ||
               plan.ownershipActionOrdinals[row] != ordinal:
                cleanupCfgFail("cleanup_cfg: ownership op action identity drift")
            let kind = plan.ownershipActionKinds[row]
            if retainedSequence:
                let retainedCapturedOldSlot =
                    plan.ownershipActionCapturedOldSlots[retainedStoreRow]
                if ordinal == 0:
                    if kind != odir.CleanupActionRetainValue:
                        cleanupCfgFail("cleanup_cfg: retained action order drift")
                elif ordinal == 1:
                    if kind != odir.CleanupActionStoreOwned:
                        cleanupCfgFail("cleanup_cfg: retained action order drift")
                elif (kind != odir.CleanupActionDropPlace &&
                     kind != odir.CleanupActionDropField) ||
                     plan.ownershipActionIds[row] != retainedActionId ||
                     plan.ownershipActionCapturedOldSlots[row] !=
                         retainedCapturedOldSlot ||
                     plan.ownershipActionCapturedOldSourceDefinitionRows[row] !=
                         plan.ownershipActionCapturedOldSourceDefinitionRows[
                             retainedStoreRow]:
                    cleanupCfgFail("cleanup_cfg: retained old-drop order drift")
            elif kind == odir.CleanupActionStoreMove:
                if ordinal != cleanupCfgCheckedSub(
                                  count,
                                  1,
                                  "cleanup_cfg: ownership move ordinal underflow"):
                    cleanupCfgFail("cleanup_cfg: ownership move store order drift")
            elif kind != odir.CleanupActionDropPlace &&
                 kind != odir.CleanupActionDropField:
                cleanupCfgFail("cleanup_cfg: ownership op action kind drift")
        expectedActionStart = cleanupCfgCheckedAdd(
            start,
            count,
            "cleanup_cfg: ownership action range overflow")
    for exitId in 0..<plan.exitOriginalSourceBlockIds.len:
        if plan.exitUsesOwnershipActions[exitId]:
            let start = plan.exitOwnershipActionStarts[exitId]
            let count = plan.exitOwnershipActionCounts[exitId]
            let ownershipEdgeId = plan.exitOwnershipEdgeIds[exitId]
            if start != expectedActionStart || count < 0 ||
               cleanupCfgCheckedAdd(
                   start,
                   count,
                   "cleanup_cfg: ownership exit action range overflow") >
                   actionCount || ownershipEdgeId < 0:
                cleanupCfgFail("cleanup_cfg: ownership exit action range corrupt")
            for ordinal in 0..<count:
                let row = cleanupCfgCheckedAdd(
                    start,
                    ordinal,
                    "cleanup_cfg: ownership exit action row overflow")
                if plan.ownershipActionEdgeIds[row] != ownershipEdgeId ||
                   plan.ownershipActionOpIds[row] != -1 ||
                   plan.ownershipActionOrdinals[row] != ordinal:
                    cleanupCfgFail("cleanup_cfg: ownership exit action identity drift")
                if plan.exitReturnSnapshotSlots[exitId] >= 0 &&
                   plan.ownershipActionTargetSlots[row] ==
                       plan.exitReturnSnapshotSlots[exitId]:
                    cleanupCfgFail("cleanup_cfg: ownership cleanup targets hidden snapshot")
            let snapshotKind = plan.exitReturnSnapshotKinds[exitId]
            if cleanupCfgSnapshotKindOwned(snapshotKind):
                if count <= 0 ||
                   plan.ownershipActionOrdinals[start] !=
                       plan.exitReturnOwnershipActionOrdinals[exitId] ||
                   plan.ownershipActionEdgeIds[start] !=
                       plan.exitReturnOwnershipEdgeIds[exitId] ||
                   ((snapshotKind == CleanupReturnSnapshotOwnedRetain &&
                     plan.ownershipActionKinds[start] !=
                         odir.CleanupActionSnapshotRetainOwnedReturn) ||
                    (snapshotKind == CleanupReturnSnapshotOwnedClone &&
                     plan.ownershipActionKinds[start] !=
                         odir.CleanupActionSnapshotCloneOwnedReturn)):
                    cleanupCfgFail("cleanup_cfg: owned snapshot action CSR mismatch")
            elif snapshotKind == CleanupReturnSnapshotUnmanagedCopy &&
                 plan.exitReturnOwnershipEdgeIds[exitId] >= 0:
                if count <= 0 ||
                   plan.ownershipActionOrdinals[start] !=
                       plan.exitReturnOwnershipActionOrdinals[exitId] ||
                   plan.ownershipActionEdgeIds[start] !=
                       plan.exitReturnOwnershipEdgeIds[exitId] ||
                   plan.ownershipActionKinds[start] !=
                       odir.CleanupActionReturnUnmanaged:
                    cleanupCfgFail(
                        "cleanup_cfg: unmanaged snapshot action CSR mismatch")
            else:
                for ordinal in 0..<count:
                    let row = cleanupCfgCheckedAdd(
                        start,
                        ordinal,
                        "cleanup_cfg: ownership exit action row overflow")
                    let kind = plan.ownershipActionKinds[row]
                    if kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
                       kind == odir.CleanupActionSnapshotCloneOwnedReturn ||
                       kind == odir.CleanupActionReturnUnmanaged:
                        cleanupCfgFail("cleanup_cfg: void exit carries snapshot action")
            expectedActionStart = cleanupCfgCheckedAdd(
                start,
                count,
                "cleanup_cfg: ownership action range overflow")
        elif plan.exitOwnershipActionStarts[exitId] != -1 ||
             plan.exitOwnershipActionCounts[exitId] != 0 ||
             plan.exitOwnershipEdgeIds[exitId] != -1:
            cleanupCfgFail("cleanup_cfg: generic exit carries ownership actions")
    if expectedActionStart != actionCount:
        cleanupCfgFail("cleanup_cfg: ownership action row left unconsumed")

fn cleanupCfgValidateFieldProjectionContracts(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR) =
    var expectedStepStart: int32
    for bindingIndex in 0..<plan.ownershipFieldBindingPlaceIds.len:
        let baseSlot = plan.ownershipFieldBindingBaseSlots[bindingIndex]
        let projectionSlot =
            plan.ownershipFieldBindingProjectionSlots[bindingIndex]
        let stepStart = plan.ownershipFieldBindingStepStarts[bindingIndex]
        let stepCount = plan.ownershipFieldBindingStepCounts[bindingIndex]
        let ownerTypeId =
            plan.ownershipFieldBindingOwnerTypeIds[bindingIndex]
        let ownerTypeRow = cleanupCfgPlanTypeLayoutRow(plan, ownerTypeId)
        if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
           projectionSlot < 0 || projectionSlot >= bodyIR.localSlots.len ||
           projectionSlot == baseSlot || stepStart != expectedStepStart ||
           stepCount <= 0 ||
           cleanupCfgCheckedAdd(
               stepStart,
               stepCount,
               "cleanup_cfg: ownership field step range overflow") >
               plan.ownershipFieldProjectionOrdinals.len:
            cleanupCfgFail("cleanup_cfg: ownership field projection range corrupt")
        let base = bodyIR.localSlots[baseSlot]
        let projection = bodyIR.localSlots[projectionSlot]
        if base.typeKind != coreir.LocalAggregateTag ||
           base.placeKind != coreir.BodyPlaceStackValueTag ||
           base.stackOffset < 0 || base.sizeBytes <= 0 ||
           base.typeKind != plan.typeLayoutKinds[ownerTypeRow] ||
           base.sizeBytes != plan.typeLayoutSizeBytes[ownerTypeRow] ||
           base.alignBytes != plan.typeLayoutAlignBytes[ownerTypeRow] ||
           plan.ownershipFieldBindingOwnerLayoutCids[bindingIndex] !=
               plan.typeLayoutCids[ownerTypeRow] ||
           projection.placeKind != coreir.BodyPlaceBorrowAddressTag ||
           projection.auxValue != baseSlot || projection.noAlias ||
           projection.aliasClass != coreir.AliasUnknown ||
           projection.ownership != coreir.OwnPlain ||
           projection.escapeKind != coreir.EscapeNone:
            cleanupCfgFail("cleanup_cfg: ownership field projection alias contract invalid")
        var cumulativeOffset: int32
        var containerSize = base.sizeBytes
        var currentTypeId = ownerTypeId
        for stepOffset in 0..<stepCount:
            let row = cleanupCfgCheckedAdd(
                stepStart,
                stepOffset,
                "cleanup_cfg: ownership field step row overflow")
            let byteOffset = plan.ownershipFieldProjectionByteOffsets[row]
            let fieldSize = plan.ownershipFieldProjectionSizeBytes[row]
            let fieldAlign = plan.ownershipFieldProjectionAlignBytes[row]
            let fieldKind = plan.ownershipFieldProjectionTypeKinds[row]
            let fieldTypeId = plan.ownershipFieldProjectionTypeIds[row]
            let fieldTypeRow = cleanupCfgPlanTypeLayoutRow(plan, fieldTypeId)
            let physicalFieldRow = cleanupCfgPlanPhysicalFieldRow(
                plan,
                currentTypeId,
                plan.ownershipFieldProjectionOrdinals[row])
            if plan.ownershipFieldProjectionContainerSizes[row] !=
                   containerSize ||
               plan.ownershipFieldProjectionOrdinals[row] < 0 ||
               byteOffset < 0 || fieldSize <= 0 || fieldAlign <= 0 ||
               fieldSize > containerSize ||
               byteOffset > cleanupCfgCheckedSub(
                   containerSize,
                   fieldSize,
                   "cleanup_cfg: ownership field layout underflow") ||
               byteOffset % fieldAlign != 0 ||
               plan.typeLayoutPhysicalFieldTypeIds[physicalFieldRow] !=
                   fieldTypeId ||
               plan.typeLayoutPhysicalFieldByteOffsets[physicalFieldRow] !=
                   byteOffset ||
               plan.typeLayoutKinds[fieldTypeRow] != fieldKind ||
               plan.typeLayoutSizeBytes[fieldTypeRow] != fieldSize ||
               plan.typeLayoutAlignBytes[fieldTypeRow] != fieldAlign ||
               plan.ownershipFieldProjectionLayoutCids[row] !=
                   plan.typeLayoutCids[fieldTypeRow] ||
               (fieldKind != coreir.LocalStrTag &&
                fieldKind != coreir.LocalAggregateTag) ||
               (cleanupCfgCheckedAdd(
                    stepOffset,
                    1,
                    "cleanup_cfg: ownership field step overflow") <
                    stepCount &&
                fieldKind != coreir.LocalAggregateTag):
                cleanupCfgFail("cleanup_cfg: ownership field projection layout drift")
            cumulativeOffset = cleanupCfgCheckedAdd(
                cumulativeOffset,
                byteOffset,
                "cleanup_cfg: ownership field projection offset overflow")
            if cumulativeOffset > cleanupCfgCheckedSub(
                   base.sizeBytes,
                   fieldSize,
                   "cleanup_cfg: ownership field base layout underflow"):
                cleanupCfgFail("cleanup_cfg: ownership field projection escapes base")
            containerSize = fieldSize
            currentTypeId = fieldTypeId
        let lastRow = cleanupCfgCheckedAdd(
            stepStart,
            cleanupCfgCheckedSub(
                stepCount,
                1,
                "cleanup_cfg: ownership field last row underflow"),
            "cleanup_cfg: ownership field last row overflow")
        let expectedProjectionOffset = cleanupCfgCheckedAdd(
            base.stackOffset,
            cumulativeOffset,
            "cleanup_cfg: ownership field stack offset overflow")
        if projection.stackOffset != expectedProjectionOffset ||
           projection.typeKind !=
               plan.ownershipFieldProjectionTypeKinds[lastRow] ||
           projection.sizeBytes !=
               plan.ownershipFieldProjectionSizeBytes[lastRow] ||
           projection.alignBytes !=
               plan.ownershipFieldProjectionAlignBytes[lastRow] ||
           plan.ownershipFieldBindingLeafTypeIds[bindingIndex] !=
               plan.ownershipFieldProjectionTypeIds[lastRow] ||
           plan.ownershipFieldBindingLeafLayoutCids[bindingIndex] !=
               plan.ownershipFieldProjectionLayoutCids[lastRow] ||
           projection.stackOffset < base.stackOffset ||
           cleanupCfgCheckedSub(
               projection.stackOffset,
               base.stackOffset,
               "cleanup_cfg: ownership field stack offset underflow") >
               cleanupCfgCheckedSub(
                   base.sizeBytes,
                   projection.sizeBytes,
                   "cleanup_cfg: ownership field size underflow"):
            cleanupCfgFail("cleanup_cfg: ownership field projection physical range drift")
        # BorrowAddress is a non-owning owner-relative view. Canonical reflow
        # skips it, then refreshes this absolute cache from the owner + path.
        expectedStepStart = cleanupCfgCheckedAdd(
            stepStart,
            stepCount,
            "cleanup_cfg: ownership field step range overflow")
    if expectedStepStart != plan.ownershipFieldProjectionOrdinals.len:
        cleanupCfgFail("cleanup_cfg: ownership field projection row unconsumed")

fn cleanupCfgFieldBindingRelativeOffset(plan: var CleanupPlan,
                                        bindingIndex: int32,
                                        baseSizeBytes: int32): int32 =
    if bindingIndex < 0 ||
       bindingIndex >= plan.ownershipFieldBindingStepStarts.len ||
       baseSizeBytes <= 0:
        cleanupCfgFail("cleanup_cfg: ownership field binding range invalid")
    let stepStart = plan.ownershipFieldBindingStepStarts[bindingIndex]
    let stepCount = plan.ownershipFieldBindingStepCounts[bindingIndex]
    if stepStart < 0 || stepCount <= 0 ||
       cleanupCfgCheckedAdd(
           stepStart,
           stepCount,
           "cleanup_cfg: ownership field step range overflow") >
           plan.ownershipFieldProjectionByteOffsets.len:
        cleanupCfgFail("cleanup_cfg: ownership field binding range corrupt")
    var cumulativeOffset: int32
    var containerSize = baseSizeBytes
    for stepOffset in 0..<stepCount:
        let row = cleanupCfgCheckedAdd(
            stepStart,
            stepOffset,
            "cleanup_cfg: ownership field step row overflow")
        let byteOffset = plan.ownershipFieldProjectionByteOffsets[row]
        let fieldSize = plan.ownershipFieldProjectionSizeBytes[row]
        let fieldAlign = plan.ownershipFieldProjectionAlignBytes[row]
        let fieldKind = plan.ownershipFieldProjectionTypeKinds[row]
        if plan.ownershipFieldProjectionContainerSizes[row] != containerSize ||
           plan.ownershipFieldProjectionOrdinals[row] < 0 ||
           byteOffset < 0 || fieldSize <= 0 || fieldAlign <= 0 ||
           fieldSize > containerSize ||
           byteOffset > cleanupCfgCheckedSub(
               containerSize,
               fieldSize,
               "cleanup_cfg: ownership field layout underflow") ||
           byteOffset % fieldAlign != 0 ||
           (fieldKind != coreir.LocalStrTag &&
            fieldKind != coreir.LocalAggregateTag) ||
           (cleanupCfgCheckedAdd(
                stepOffset,
                1,
                "cleanup_cfg: ownership field step overflow") <
                stepCount && fieldKind != coreir.LocalAggregateTag):
            cleanupCfgFail("cleanup_cfg: ownership field projection layout drift")
        cumulativeOffset = cleanupCfgCheckedAdd(
            cumulativeOffset,
            byteOffset,
            "cleanup_cfg: ownership field projection offset overflow")
        if cumulativeOffset > cleanupCfgCheckedSub(
               baseSizeBytes,
               fieldSize,
               "cleanup_cfg: ownership field base layout underflow"):
            cleanupCfgFail("cleanup_cfg: ownership field projection escapes base")
        containerSize = fieldSize
    return cumulativeOffset

fn cleanupCfgValidatePhysicalStackIntervals(bodyIR: var coreir.BodyIR,
                                             plan: var CleanupPlan) =
    var projectionBindingCounts: int32[]
    for _ in 0..<bodyIR.localSlots.len:
        add(projectionBindingCounts, 0)
    for bindingIndex in 0..<plan.ownershipFieldBindingProjectionSlots.len:
        let projectionSlot =
            plan.ownershipFieldBindingProjectionSlots[bindingIndex]
        if projectionSlot < 0 || projectionSlot >= bodyIR.localSlots.len:
            cleanupCfgFail("cleanup_cfg: BorrowAddress binding range invalid")
        projectionBindingCounts[projectionSlot] = cleanupCfgCheckedAdd(
            projectionBindingCounts[projectionSlot],
            1,
            "cleanup_cfg: BorrowAddress binding count overflow")
    var actualIndependentHighWater: int32
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        plan.physicalIntervalVisitCount = cleanupCfgCheckedAdd(
            plan.physicalIntervalVisitCount,
            1,
            "cleanup_cfg: physical interval visit counter overflow")
        if slot.placeKind == coreir.BodyPlaceStackValueTag:
            if slot.stackOffset < 0:
                # 参数槽（wall44 同型）：负 offset 是入口序数编码（见
                # cleanupCfgStageBindLocalSchema 同注释），仍审 size/align，
                # 但不属于独立栈区：不参与区间审与 actual 高水位
                # （与 bind 侧排除对称，drift 校验同基）。
                if slot.sizeBytes <= 0 || slot.alignBytes <= 0:
                    cleanupCfgFail(
                        "cleanup_cfg: independent stack interval invalid")
            else:
                if slot.sizeBytes <= 0 || slot.alignBytes <= 0 ||
                   slot.stackOffset % slot.alignBytes != 0:
                    cleanupCfgFail(
                        "cleanup_cfg: independent stack interval invalid")
                let slotEnd = cleanupCfgCheckedAdd(
                    slot.stackOffset,
                    slot.sizeBytes,
                    "cleanup_cfg: independent stack interval overflow")
                if slotEnd > actualIndependentHighWater:
                    actualIndependentHighWater = slotEnd
        elif slot.placeKind == coreir.BodyPlaceBorrowAddressTag:
            if projectionBindingCounts[localIndex] != 1 ||
               slot.auxValue < 0 || slot.auxValue >= bodyIR.localSlots.len ||
               slot.auxValue == localIndex:
                cleanupCfgFail("cleanup_cfg: BorrowAddress owner binding invalid")
            let owner = bodyIR.localSlots[slot.auxValue]
            if owner.placeKind != coreir.BodyPlaceStackValueTag ||
               owner.stackOffset < 0 || owner.sizeBytes <= 0 ||
               slot.stackOffset < owner.stackOffset || slot.sizeBytes <= 0 ||
               slot.alignBytes <= 0 ||
               slot.stackOffset % slot.alignBytes != 0:
                cleanupCfgFail("cleanup_cfg: BorrowAddress physical view invalid")
            let projectionEnd = cleanupCfgCheckedAdd(
                slot.stackOffset,
                slot.sizeBytes,
                "cleanup_cfg: BorrowAddress interval overflow")
            let ownerEnd = cleanupCfgCheckedAdd(
                owner.stackOffset,
                owner.sizeBytes,
                "cleanup_cfg: BorrowAddress owner interval overflow")
            if projectionEnd > ownerEnd:
                cleanupCfgFail("cleanup_cfg: BorrowAddress escapes owner interval")
        elif projectionBindingCounts[localIndex] != 0:
            cleanupCfgFail("cleanup_cfg: projection binding is not BorrowAddress")
    # 独立栈区间完备重叠审（wall44）。旧「槽序即偏移序」相邻序审是布局
    # 单遍化时代的判据；布局生产者（primary_object_plan
    # PrimaryBodyIrReflowLocalStackOffsets）已两遍化——scalar（<=8B）块先、
    # wide 块后，cleanup 尾部捕获槽再自高水位单调追加，独立区偏移序与槽序
    # 合法交错（cold_nested fmt 族 scalar/wide 交错即被旧判据误杀：
    # local=4 offset=16 after previous_start=88）。改为区间级两两相交审，
    # 对生产者任意 canonical 形态零假设，且强于旧相邻审（非相邻重叠也查）。
    var independentIntervalSlotIds: int32[]
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        if slot.placeKind == coreir.BodyPlaceStackValueTag &&
           slot.stackOffset >= 0:
            add(independentIntervalSlotIds, localIndex)
    for rowIndex in 0..<independentIntervalSlotIds.len:
        let left = bodyIR.localSlots[independentIntervalSlotIds[rowIndex]]
        let leftEnd = cleanupCfgCheckedAdd(
            left.stackOffset,
            left.sizeBytes,
            "cleanup_cfg: independent stack interval overflow")
        for colIndex in (rowIndex + 1)..<independentIntervalSlotIds.len:
            let right =
                bodyIR.localSlots[independentIntervalSlotIds[colIndex]]
            let rightEnd = cleanupCfgCheckedAdd(
                right.stackOffset,
                right.sizeBytes,
                "cleanup_cfg: independent stack interval overflow")
            if right.stackOffset < leftEnd &&
               rightEnd > left.stackOffset:
                cleanupCfgFail(
                    Fmt"cleanup_cfg: independent stack intervals overlap left_local={independentIntervalSlotIds[rowIndex]} right_local={independentIntervalSlotIds[colIndex]} left_offset={left.stackOffset} right_offset={right.stackOffset}")
    if !plan.independentStackHighWaterReady ||
       actualIndependentHighWater != plan.independentStackHighWater:
        cleanupCfgFail("cleanup_cfg: independent stack high-water drift")

fn cleanupCfgBuildPhysicalLayoutCandidate(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        reflowIndependentSlots: bool,
        firstStackOffset: int32): PhysicalLayoutCandidate =
    cleanupCfgRequireBuilding(plan)
    cleanupCfgRequireLocalSchema(plan, bodyIR)
    if firstStackOffset < 0:
        cleanupCfgFail("cleanup_cfg: physical reflow base invalid")
    var out: PhysicalLayoutCandidate
    var cursor = firstStackOffset
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        var candidateOffset = slot.stackOffset
        if reflowIndependentSlots &&
           slot.placeKind == coreir.BodyPlaceStackValueTag:
            if slot.sizeBytes <= 0 || slot.alignBytes <= 0:
                cleanupCfgFail("cleanup_cfg: physical reflow slot schema invalid")
            cursor = cleanupCfgAlignStackOffset(cursor, slot.alignBytes)
            candidateOffset = cursor
            cursor = cleanupCfgCheckedAdd(
                cursor,
                slot.sizeBytes,
                "cleanup_cfg: physical reflow frame overflow")
        elif !reflowIndependentSlots &&
             slot.placeKind == coreir.BodyPlaceStackValueTag:
            if slot.stackOffset < 0 || slot.sizeBytes <= 0 ||
               slot.alignBytes <= 0:
                cleanupCfgFail("cleanup_cfg: physical refresh slot schema invalid")
            let slotEnd = cleanupCfgCheckedAdd(
                slot.stackOffset,
                slot.sizeBytes,
                "cleanup_cfg: physical refresh frame overflow")
            if slotEnd > cursor:
                cursor = slotEnd
        add(out.localStackOffsets, candidateOffset)
    for bindingIndex in 0..<plan.ownershipFieldBindingBaseSlots.len:
        let baseSlot = plan.ownershipFieldBindingBaseSlots[bindingIndex]
        let projectionSlot =
            plan.ownershipFieldBindingProjectionSlots[bindingIndex]
        if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
           projectionSlot < 0 || projectionSlot >= bodyIR.localSlots.len:
            cleanupCfgFail("cleanup_cfg: BorrowAddress refresh range invalid")
        let base = bodyIR.localSlots[baseSlot]
        if base.placeKind != coreir.BodyPlaceStackValueTag ||
           bodyIR.localSlots[projectionSlot].placeKind !=
               coreir.BodyPlaceBorrowAddressTag ||
           bodyIR.localSlots[projectionSlot].auxValue != baseSlot:
            cleanupCfgFail("cleanup_cfg: BorrowAddress refresh owner drift")
        let relativeOffset = cleanupCfgFieldBindingRelativeOffset(
            plan,
            bindingIndex,
            base.sizeBytes)
        add(out.projectionRelativeOffsets, relativeOffset)
        out.localStackOffsets[projectionSlot] = cleanupCfgCheckedAdd(
            out.localStackOffsets[baseSlot],
            relativeOffset,
            "cleanup_cfg: BorrowAddress refresh offset overflow")
        out.projectionVisitCount = cleanupCfgCheckedAdd(
            out.projectionVisitCount,
            1,
            "cleanup_cfg: physical projection visit counter overflow")
    out.frameEnd = cursor
    out.validated = true
    return out

@borrows
fn cleanupCfgApplyPhysicalLayoutCandidate(
        bodyIR: var coreir.BodyIR,
        candidate: PhysicalLayoutCandidate) =
    for localIndex in 0..<bodyIR.localSlots.len:
        bodyIR.localSlots[localIndex].stackOffset =
            candidate.localStackOffsets[localIndex]

fn cleanupCfgStageRefreshBorrowAddressViews(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR) =
    let candidate = cleanupCfgBuildPhysicalLayoutCandidate(plan,
                                                            bodyIR,
                                                            false,
                                                            0)
    cleanupCfgApplyPhysicalLayoutCandidate(bodyIR, candidate)
    plan.independentStackHighWater = candidate.frameEnd
    plan.independentStackHighWaterReady = true
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    cleanupCfgValidateFieldProjectionContracts(plan, bodyIR)
    cleanupCfgValidatePhysicalStackIntervals(bodyIR, plan)

fn CleanupPlanRefreshBorrowAddressViewsAfterReflow(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR) =
    var delta: CleanupMutationDelta
    var bodyCandidate: coreir.BodyIR
    var planCandidate: CleanupPlan
    cleanupCfgBeginBodyPlanMutation(bodyIR,
                                    plan,
                                    bodyCandidate,
                                    planCandidate,
                                    delta)
    cleanupCfgStageRefreshBorrowAddressViews(planCandidate,
                                             bodyCandidate)
    cleanupCfgSealBodyPlanMutation(bodyCandidate, planCandidate, delta)
    cleanupCfgCommitBodyPlanMutation(bodyIR,
                                     plan,
                                     bodyCandidate,
                                     planCandidate,
                                     delta)

fn CleanupPlanReflowPhysicalStackLayout(plan: var CleanupPlan,
                                        bodyIR: var coreir.BodyIR,
                                        firstStackOffset: int32): int32 =
    var delta: CleanupMutationDelta
    var bodyCandidate: coreir.BodyIR
    var planCandidate: CleanupPlan
    cleanupCfgBeginBodyPlanMutation(bodyIR,
                                    plan,
                                    bodyCandidate,
                                    planCandidate,
                                    delta)
    var physicalLayout = cleanupCfgBuildPhysicalLayoutCandidate(
        planCandidate,
        bodyCandidate,
        true,
        firstStackOffset)
    cleanupCfgApplyPhysicalLayoutCandidate(bodyCandidate,
                                           physicalLayout)
    planCandidate.independentStackHighWater =
        physicalLayout.frameEnd
    planCandidate.independentStackHighWaterReady = true
    coreir.BodyIRClearFrameLayoutCache(bodyCandidate)
    cleanupCfgValidateFieldProjectionContracts(planCandidate,
                                                bodyCandidate)
    cleanupCfgValidatePhysicalStackIntervals(bodyCandidate,
                                             planCandidate)
    cleanupCfgSealBodyPlanMutation(bodyCandidate, planCandidate, delta)
    cleanupCfgCommitBodyPlanMutation(bodyIR,
                                     plan,
                                     bodyCandidate,
                                     planCandidate,
                                     delta)
    return physicalLayout.frameEnd

fn cleanupCfgOwnershipActionReferencesSnapshotSlot(
        plan: var CleanupPlan,
        actionRow: int32,
        slot: int32): bool =
    if actionRow < 0 || actionRow >= plan.ownershipActionKinds.len:
        cleanupCfgFail(
            "cleanup_cfg: ownership snapshot semantic row invalid")
    return (plan.ownershipActionPrimaryKinds[actionRow] !=
                odir.DropConditionAlways &&
            plan.ownershipActionPrimaryFlagSlots[actionRow] == slot) ||
           (plan.ownershipActionSecondaryKinds[actionRow] !=
                odir.DropConditionAlways &&
            plan.ownershipActionSecondaryFlagSlots[actionRow] == slot) ||
           (plan.ownershipActionGuardKinds[actionRow] !=
                odir.DropConditionAlways &&
            plan.ownershipActionGuardFlagSlots[actionRow] == slot)

fn cleanupCfgValidateOwnershipFlagTransitions(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR) =
    let transitionCount = plan.ownershipFlagTransitionOriginKinds.len
    if plan.ownershipFlagTransitionOriginIds.len != transitionCount ||
       plan.ownershipFlagTransitionFlagIds.len != transitionCount ||
       plan.ownershipFlagTransitionFlagSlots.len != transitionCount ||
       plan.ownershipFlagTransitionSetValues.len != transitionCount:
        cleanupCfgFail("cleanup_cfg: ownership flag transition columns drift")
    let opRowCount = plan.ownershipOpTransitionOwnershipOpIds.len
    let siteCount = plan.ownershipOpTransitionBodyBlockIds.len
    if plan.ownershipOpTransitionAfterOpOrdinals.len != siteCount ||
       plan.ownershipOpTransitionSiteStarts.len != siteCount ||
       plan.ownershipOpTransitionSiteCounts.len != siteCount ||
       plan.ownershipOpSiteSnapshotStarts.len != siteCount ||
       plan.ownershipOpSiteSnapshotCounts.len != siteCount ||
       plan.ownershipOpSiteSnapshotSourceSlots.len !=
           plan.ownershipOpSiteSnapshotSemanticRows.len ||
       plan.ownershipOpActionStarts.len != opRowCount ||
       plan.ownershipOpActionCounts.len != opRowCount ||
       plan.ownershipOpTransitionStarts.len != opRowCount ||
       plan.ownershipOpTransitionCounts.len != opRowCount:
        cleanupCfgFail("cleanup_cfg: ownership op transition columns drift")
    var seen: bool[]
    for _ in 0..<transitionCount:
        add(seen, false)
    var expectedOpRowStart: int32
    var expectedSnapshotStart: int32
    for siteIndex in 0..<siteCount:
        let blockId = plan.ownershipOpTransitionBodyBlockIds[siteIndex]
        let opRowStart =
            plan.ownershipOpTransitionSiteStarts[siteIndex]
        let opRowCountAtSite =
            plan.ownershipOpTransitionSiteCounts[siteIndex]
        if blockId < 0 || blockId >= bodyIR.blocks.len ||
           opRowStart != expectedOpRowStart ||
           opRowCountAtSite <= 0 ||
           opRowStart + opRowCountAtSite > opRowCount ||
           plan.ownershipOpTransitionAfterOpOrdinals[siteIndex] < 0 ||
           plan.ownershipOpTransitionAfterOpOrdinals[siteIndex] >=
               bodyIR.blocks[blockId].opCount:
            cleanupCfgFail("cleanup_cfg: ownership op transition range corrupt")
        let snapshotStart =
            plan.ownershipOpSiteSnapshotStarts[siteIndex]
        let snapshotCount =
            plan.ownershipOpSiteSnapshotCounts[siteIndex]
        if snapshotStart != expectedSnapshotStart ||
           snapshotCount < 0 ||
           snapshotStart + snapshotCount >
               plan.ownershipOpSiteSnapshotSourceSlots.len:
            cleanupCfgFail(
                "cleanup_cfg: ownership op snapshot range corrupt")
        for snapshotOffset in 0..<snapshotCount:
            let snapshotRow = snapshotStart + snapshotOffset
            let sourceSlot =
                plan.ownershipOpSiteSnapshotSourceSlots[snapshotRow]
            let semanticRow =
                plan.ownershipOpSiteSnapshotSemanticRows[snapshotRow]
            if sourceSlot < 0 ||
               sourceSlot >= plan.localTypeKinds.len ||
               plan.localTypeKinds[sourceSlot] != coreir.LocalI32Tag:
                cleanupCfgFail(
                    "cleanup_cfg: ownership op snapshot source invalid")
            for priorOffset in 0..<snapshotOffset:
                if plan.ownershipOpSiteSnapshotSourceSlots[
                       snapshotStart + priorOffset] == sourceSlot:
                    cleanupCfgFail(
                        "cleanup_cfg: ownership op snapshot source duplicated")
            var firstSemanticRow: int32 = -1
            for semanticOpOffset in 0..<opRowCountAtSite:
                let semanticOpRow = opRowStart + semanticOpOffset
                let semanticActionStart =
                    plan.ownershipOpActionStarts[semanticOpRow]
                let semanticActionCount =
                    plan.ownershipOpActionCounts[semanticOpRow]
                for semanticActionOffset in 0..<semanticActionCount:
                    let candidateSemanticRow =
                        semanticActionStart + semanticActionOffset
                    if firstSemanticRow < 0 &&
                       cleanupCfgOwnershipActionReferencesSnapshotSlot(
                           plan,
                           candidateSemanticRow,
                           sourceSlot):
                        firstSemanticRow = candidateSemanticRow
            if semanticRow != firstSemanticRow:
                cleanupCfgFail(
                    "cleanup_cfg: ownership op snapshot semantic identity drift")
        expectedSnapshotStart = snapshotStart + snapshotCount
        for opOffset in 0..<opRowCountAtSite:
            let opRow = opRowStart + opOffset
            let start = plan.ownershipOpTransitionStarts[opRow]
            let count = plan.ownershipOpTransitionCounts[opRow]
            if count < 0 || start < 0 ||
               start + count > transitionCount ||
               (count == 0 &&
                plan.ownershipOpActionCounts[opRow] <= 0):
                cleanupCfgFail(
                    "cleanup_cfg: ownership op row has no runtime effect")
            for offset in 0..<count:
                let row = start + offset
                if seen[row] ||
                   plan.ownershipFlagTransitionOriginKinds[row] !=
                       odir.FlagOriginOp ||
                   plan.ownershipFlagTransitionOriginIds[row] !=
                       plan.ownershipOpTransitionOwnershipOpIds[opRow]:
                    cleanupCfgFail(
                        "cleanup_cfg: ownership op transition identity drift")
                seen[row] = true
        expectedOpRowStart = opRowStart + opRowCountAtSite
    if expectedOpRowStart != opRowCount:
        cleanupCfgFail("cleanup_cfg: orphan ownership op transition row")
    if expectedSnapshotStart !=
       plan.ownershipOpSiteSnapshotSourceSlots.len:
        cleanupCfgFail("cleanup_cfg: orphan ownership op snapshot row")
    for exitId in 0..<plan.exitOriginalSourceBlockIds.len:
        let start = plan.exitOwnershipFlagTransitionStarts[exitId]
        let count = plan.exitOwnershipFlagTransitionCounts[exitId]
        if plan.exitUsesOwnershipActions[exitId]:
            if start < 0 || count < 0 || start + count > transitionCount:
                cleanupCfgFail("cleanup_cfg: ownership edge transition range corrupt")
            for offset in 0..<count:
                let row = start + offset
                if seen[row] ||
                   plan.ownershipFlagTransitionOriginKinds[row] !=
                       odir.FlagOriginEdge ||
                   plan.ownershipFlagTransitionOriginIds[row] !=
                       plan.exitOwnershipEdgeIds[exitId]:
                    cleanupCfgFail("cleanup_cfg: ownership edge transition identity drift")
                seen[row] = true
        elif start != -1 || count != 0:
            cleanupCfgFail("cleanup_cfg: unmanaged exit carries ownership transition")
    for row in 0..<transitionCount:
        let slot = plan.ownershipFlagTransitionFlagSlots[row]
        if !seen[row] || plan.ownershipFlagTransitionFlagIds[row] <= 0 ||
           slot < 0 || slot >= plan.localTypeKinds.len ||
           plan.localTypeKinds[slot] != coreir.LocalI32Tag:
            cleanupCfgFail("cleanup_cfg: ownership flag transition row invalid")

fn cleanupCfgValidateBody(plan: var CleanupPlan,
                          bodyIR: var coreir.BodyIR) =
    cleanupCfgRequireBuilding(plan)
    if !plan.registrationsSealed ||
       plan.exitOriginalSourceBlockIds.len <= 0 ||
       !bodyIR.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyIR):
        cleanupCfgFail("cleanup_cfg: materialize requires at least one exit")
    if plan.scopeParentIds.len !=
           bodyIR.controlScopeParentIds.len:
        cleanupCfgFail("cleanup_cfg: plan/body scope count drift")
    for scopeId in 0..<plan.scopeParentIds.len:
        if plan.scopeParentIds[scopeId] !=
               bodyIR.controlScopeParentIds[scopeId]:
            cleanupCfgFail("cleanup_cfg: plan/body scope identity drift")
    let deferCount = plan.deferDeclarationScopeIds.len
    if bodyIR.deferDeclarationScopeIds.len != deferCount ||
       plan.deferSuiteScopeIds.len != deferCount ||
       plan.deferLexicalOrdinals.len != deferCount:
        cleanupCfgFail("cleanup_cfg: plan/body defer count drift")
    for deferId in 0..<deferCount:
        if plan.deferDeclarationScopeIds[deferId] !=
               bodyIR.deferDeclarationScopeIds[deferId] ||
           plan.deferSuiteScopeIds[deferId] !=
               bodyIR.deferSuiteScopeIds[deferId] ||
           plan.deferLexicalOrdinals[deferId] !=
               bodyIR.deferLexicalOrdinals[deferId]:
            cleanupCfgFail("cleanup_cfg: plan/body defer identity drift")
    let fragmentOpCount = plan.opKinds.len
    if plan.opTargets.len != fragmentOpCount ||
       plan.opOperandStarts.len != fragmentOpCount ||
       plan.opOperandCounts.len != fragmentOpCount ||
       plan.opValueDefSlots.len != fragmentOpCount ||
       plan.opValueDefExprNodeIndexes.len != fragmentOpCount ||
       plan.opValueDefSemanticRows.len != fragmentOpCount ||
       plan.opValueDefOwnershipKinds.len != fragmentOpCount ||
       plan.opValueDefBorrowOwnerSemanticRows.len != fragmentOpCount ||
       plan.opValueDefBorrowOwnerDefinitionDomains.len != fragmentOpCount ||
       plan.opValueDefBorrowOwnerDefinitionRows.len != fragmentOpCount ||
       plan.opValueDefConsumeOpIndexPlusOnes.len != fragmentOpCount ||
       plan.opValueDefOriginKinds.len != fragmentOpCount ||
       plan.opValueDefOriginIds.len != fragmentOpCount ||
       plan.opSourceDefinitionDomains.len != fragmentOpCount ||
       plan.opSourceDefinitionRows.len != fragmentOpCount ||
       plan.opConsumeActionRows.len != fragmentOpCount:
        cleanupCfgFail("cleanup_cfg: fragment BodyOp SoA columns drift")
    let fragmentCallCount = plan.callTargetSymbols.len
    if plan.callTargetSourcePaths.len != fragmentCallCount ||
       plan.callTargetDomainKinds.len != fragmentCallCount ||
       plan.callTargetRows.len != fragmentCallCount ||
       plan.callTargetInterfaceCids.len != fragmentCallCount ||
       plan.callResultSlots.len != fragmentCallCount ||
       plan.callResultPassKinds.len != fragmentCallCount ||
       plan.callResultOwnershipKinds.len != fragmentCallCount ||
       plan.callResultExprNodeIndexes.len != fragmentCallCount ||
       plan.callResultValueDefinitionRows.len != fragmentCallCount ||
       plan.callResultBorrowOwnerValueDefinitionRows.len != fragmentCallCount ||
       plan.callResultBorrowOwnerDefinitionDomains.len != fragmentCallCount ||
       plan.callResultBorrowOwnerDefinitionRows.len != fragmentCallCount ||
       plan.callResultDefinitionOriginKinds.len != fragmentCallCount ||
       plan.callResultDefinitionOriginIds.len != fragmentCallCount ||
       plan.callSourceDefinitionDomains.len != fragmentCallCount ||
       plan.callSourceDefinitionRows.len != fragmentCallCount ||
       plan.callSemanticCallExprNodeIndexes.len != fragmentCallCount ||
       plan.callConsumeActionRows.len != fragmentCallCount ||
       plan.callManagedStoreKinds.len != fragmentCallCount ||
       plan.callRelocWordOffsets.len != fragmentCallCount ||
       plan.callTargetIsImportcs.len != fragmentCallCount ||
       plan.callInlineF64FromIntKinds.len != fragmentCallCount ||
       plan.callWholeCallF64FromIntRescues.len != fragmentCallCount ||
       plan.callInlineF64FromIntUnsigneds.len != fragmentCallCount ||
       plan.callArgStarts.len != fragmentCallCount ||
       plan.callArgCounts.len != fragmentCallCount ||
       plan.callArgAbiStarts.len != fragmentCallCount ||
       plan.callArgAbiCounts.len != fragmentCallCount:
        cleanupCfgFail("cleanup_cfg: fragment CallOp SoA columns drift")
    if plan.callArgSlots.len != plan.callArgPassKinds.len:
        cleanupCfgFail(
            "cleanup_cfg: fragment CallOp argument columns drift")
    var callArgCursor: int32
    var callAbiCursor: int32
    for callRow in 0..<fragmentCallCount:
        let argStart = plan.callArgStarts[callRow]
        let argCount = plan.callArgCounts[callRow]
        let abiStart = plan.callArgAbiStarts[callRow]
        let abiCount = plan.callArgAbiCounts[callRow]
        if !coreir.BodyIRCallTargetIdentityValid(
               plan.callTargetDomainKinds[callRow],
               plan.callTargetRows[callRow]) ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               plan.callTargetInterfaceCids[callRow]) ||
           argStart != callArgCursor || argStart < 0 ||
           argCount < 0 || argStart > plan.callArgSlots.len ||
           argCount > plan.callArgSlots.len - argStart ||
           abiStart != callAbiCursor || abiStart < 0 ||
           abiCount < 0 || abiStart > plan.callArgAbiSizes.len ||
           abiCount > plan.callArgAbiSizes.len - abiStart ||
           (abiCount != 0 && abiCount != argCount):
            cleanupCfgFail(
                "cleanup_cfg: fragment CallOp target authority invalid")
        callArgCursor = argStart + argCount
        callAbiCursor = abiStart + abiCount
    if callArgCursor != plan.callArgSlots.len ||
       callAbiCursor != plan.callArgAbiSizes.len:
        cleanupCfgFail(
            "cleanup_cfg: fragment CallOp argument CSR incomplete")
    let fragmentTermCount = plan.termKinds.len
    if plan.termConditionKinds.len != fragmentTermCount ||
       plan.termResultSlots.len != fragmentTermCount ||
       plan.termSourceDefinitionDomains.len != fragmentTermCount ||
       plan.termSourceDefinitionRows.len != fragmentTermCount ||
       plan.termLhsSlots.len != fragmentTermCount ||
       plan.termRhsSlots.len != fragmentTermCount ||
       plan.termTrueBlocks.len != fragmentTermCount ||
       plan.termFalseBlocks.len != fragmentTermCount ||
       plan.termOperandStarts.len != fragmentTermCount ||
       plan.termOperandCounts.len != fragmentTermCount:
        cleanupCfgFail("cleanup_cfg: fragment BodyTerm SoA columns drift")
    let exitCount = plan.exitOriginalSourceBlockIds.len
    if plan.exitPhysicalSourceBlockIds.len != exitCount ||
       plan.exitSuccessorOrdinals.len != exitCount ||
       plan.exitFromScopeIds.len != exitCount ||
       plan.exitToScopeIds.len != exitCount ||
       plan.exitKinds.len != exitCount ||
       plan.exitTargetBlockIds.len != exitCount ||
       plan.exitReturnSourceSlots.len != exitCount ||
       plan.exitReturnSnapshotSlots.len != exitCount ||
       plan.exitReturnSnapshotKinds.len != exitCount ||
       plan.exitReturnSnapshotGlueIds.len != exitCount ||
       plan.exitReturnSnapshotGlueSymbols.len != exitCount ||
       plan.exitReturnOwnershipEdgeIds.len != exitCount ||
       plan.exitReturnOwnershipActionOrdinals.len != exitCount ||
       plan.exitReturnOwnershipPlaceIds.len != exitCount ||
       plan.exitReturnOwnershipTypeIds.len != exitCount ||
       plan.exitReturnOwnershipLayoutCids.len != exitCount ||
       plan.exitReturnExprNodeIndexes.len != exitCount ||
       plan.exitReturnValueDefinitionRows.len != exitCount ||
       plan.exitReturnOwnershipKinds.len != exitCount ||
       plan.exitReturnSourceDefinitionDomains.len != exitCount ||
       plan.exitReturnSourceDefinitionRows.len != exitCount ||
       plan.exitOwnershipEdgeIds.len != exitCount ||
       plan.exitUsesOwnershipActions.len != exitCount ||
       plan.exitOwnershipActionStarts.len != exitCount ||
       plan.exitOwnershipActionCounts.len != exitCount ||
       plan.exitOwnershipFlagTransitionStarts.len != exitCount ||
       plan.exitOwnershipFlagTransitionCounts.len != exitCount ||
       plan.exitDeferStarts.len != exitCount ||
       plan.exitDeferCounts.len != exitCount:
        cleanupCfgFail("cleanup_cfg: exit snapshot SoA columns drift")
    cleanupCfgValidateOriginalSourceIndex(plan, true)
    cleanupCfgRequireLocalSchema(plan, bodyIR)
    cleanupCfgValidateTypeLayoutSnapshot(plan)
    cleanupCfgValidateFieldProjectionContracts(plan, bodyIR)
    cleanupCfgValidatePhysicalStackIntervals(bodyIR, plan)
    cleanupCfgValidateOwnershipActionColumns(plan)
    for actionRow in 0..<plan.ownershipActionKinds.len:
        let capturedSlot = plan.ownershipActionCapturedOldSlots[actionRow]
        let targetSlot = plan.ownershipActionTargetSlots[actionRow]
        let kind = plan.ownershipActionKinds[actionRow]
        let capturedOldSourceDefinitionDomain =
            plan.ownershipActionCapturedOldSourceDefinitionDomains[actionRow]
        let capturedOldSourceDefinitionRow =
            plan.ownershipActionCapturedOldSourceDefinitionRows[actionRow]
        if capturedOldSourceDefinitionRow >= 0:
            if capturedOldSourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag:
                cleanupCfgFail(
                    "cleanup_cfg: captured-old definition domain invalid")
            cleanupCfgValidateManagedDefinitionRow(
                bodyIR,
                capturedOldSourceDefinitionRow)
            if bodyIR.ops[capturedOldSourceDefinitionRow].valueDefSlot !=
                   cleanupCfgOwnershipPlaceSlot(
                       plan,
                       plan.ownershipActionPlaceIds[actionRow]):
                cleanupCfgFail(
                    "cleanup_cfg: captured-old definition place drift")
        elif capturedOldSourceDefinitionDomain !=
                 coreir.BodyDefinitionDomainInvalidTag:
            cleanupCfgFail(
                "cleanup_cfg: empty captured-old definition domain invalid")
        if capturedSlot >= 0 && kind == odir.CleanupActionDropPlace &&
           targetSlot != capturedSlot:
            cleanupCfgFail("cleanup_cfg: captured place drop owner drift")
        if capturedSlot >= 0 && kind == odir.CleanupActionDropField:
            let bindingIndex =
                plan.ownershipActionFieldProjectionBindingIndices[actionRow]
            let projectionSlot =
                plan.ownershipFieldBindingProjectionSlots[bindingIndex]
            if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[targetSlot].placeKind !=
                   coreir.BodyPlaceStackValueTag ||
               projectionSlot < 0 ||
               projectionSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[projectionSlot].placeKind !=
                   coreir.BodyPlaceBorrowAddressTag ||
               bodyIR.localSlots[projectionSlot].auxValue != capturedSlot:
                cleanupCfgFail(
                    "cleanup_cfg: captured field projection owner drift")
    if plan.ownershipGuardCleanupDeferIds.len != plan.ownershipGuardDeferIds.len ||
       plan.ownershipGuardCleanupDeferIds.len !=
           plan.ownershipGuardConditionFlagIds.len ||
       plan.ownershipGuardCleanupDeferIds.len !=
           plan.ownershipGuardActiveFlagSlots.len:
        cleanupCfgFail("cleanup_cfg: ownership guard projection columns drift")
    if plan.ownershipGuardCleanupDeferIds.len !=
       plan.ownershipGuardActionRows.len:
        cleanupCfgFail("cleanup_cfg: ownership guard action rows drift")
    var projectedGuardCount: int32
    for deferId in 0..<plan.deferOwnershipDeferIds.len:
        if plan.deferOwnershipGuardProjectionCounts[deferId] < 0:
            cleanupCfgFail("cleanup_cfg: negative ownership guard count")
        projectedGuardCount = cleanupCfgCheckedAdd(
            projectedGuardCount,
            plan.deferOwnershipGuardProjectionCounts[deferId],
            "cleanup_cfg: ownership guard audit count overflow")
        if plan.deferOwnershipDeferIds[deferId] >= 0:
            if plan.deferSelectedExitCounts[deferId] <= 0:
                cleanupCfgFail("cleanup_cfg: ownership defer has no CFG unit")
        elif plan.deferOwnershipGuardProjectionCounts[deferId] != 0:
            cleanupCfgFail("cleanup_cfg: ownership guard lacks defer binding")
    if projectedGuardCount != plan.ownershipGuardCleanupDeferIds.len:
        cleanupCfgFail("cleanup_cfg: ownership guard count ledger drift")
    var guardAuditSeen: bool[]
    for _ in 0..<plan.ownershipActionKinds.len:
        add(guardAuditSeen, false)
    for projectionIndex in 0..<plan.ownershipGuardCleanupDeferIds.len:
        let deferId = plan.ownershipGuardCleanupDeferIds[projectionIndex]
        let actionRow = plan.ownershipGuardActionRows[projectionIndex]
        if deferId < 0 || deferId >= plan.deferOwnershipDeferIds.len ||
           actionRow < 0 || actionRow >= plan.ownershipActionKinds.len ||
           guardAuditSeen[actionRow] ||
           plan.ownershipGuardDeferIds[projectionIndex] !=
               plan.deferOwnershipDeferIds[deferId] ||
           plan.ownershipGuardConditionFlagIds[projectionIndex] <= 0 ||
           plan.ownershipGuardActiveFlagSlots[projectionIndex] !=
               plan.deferActiveFlagSlots[deferId] ||
           plan.ownershipActionGuardCleanupDeferIds[actionRow] != deferId ||
           plan.ownershipActionGuardFlagIds[actionRow] !=
               plan.ownershipGuardConditionFlagIds[projectionIndex] ||
           plan.ownershipActionGuardFlagSlots[actionRow] !=
               plan.ownershipGuardActiveFlagSlots[projectionIndex]:
            cleanupCfgFail("cleanup_cfg: ownership guard materialization drift")
        guardAuditSeen[actionRow] = true
    for actionRow in 0..<plan.ownershipActionKinds.len:
        if (plan.ownershipActionGuardCleanupDeferIds[actionRow] >= 0) !=
           guardAuditSeen[actionRow]:
            cleanupCfgFail("cleanup_cfg: guarded action lacks exact audit row")
    if bodyIR.blocks.len <= plan.entryBlockId ||
       bodyIR.blocks[plan.entryBlockId].id != plan.entryBlockId ||
       bodyIR.blocks[plan.entryBlockId].opStart != 0:
        cleanupCfgFail("cleanup_cfg: malformed BodyIR entry block")
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.id != blockIndex || block.opStart < 0 || block.opCount < 0 ||
           cleanupCfgCheckedAdd(
               block.opStart,
               block.opCount,
               "cleanup_cfg: source BodyIR block range overflow") >
               bodyIR.ops.len ||
           block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
            cleanupCfgFail("cleanup_cfg: malformed source BodyIR block")
    cleanupCfgValidateOwnershipFlagTransitions(plan, bodyIR)
    for exitId in 0..<plan.exitOriginalSourceBlockIds.len:
        let sourceBlock = plan.exitOriginalSourceBlockIds[exitId]
        if sourceBlock < 0 || sourceBlock >= bodyIR.blocks.len:
            cleanupCfgFail("cleanup_cfg: source BodyIR block missing")
        let sourceScopeId = plan.exitFromScopeIds[exitId]
        if sourceScopeId < 0 ||
           sourceScopeId >= bodyIR.controlScopeParentIds.len ||
           bodyIR.blockScopeIds[sourceBlock] != sourceScopeId:
            cleanupCfgFail("cleanup_cfg: source BodyIR scope mismatch")
        let sourceTermIndex = bodyIR.blocks[sourceBlock].termIndex
        let sourceTerm = bodyIR.terms[sourceTermIndex]
        let successorStart =
            bodyIR.termSuccessorStarts[sourceTermIndex]
        let successorCount =
            bodyIR.termSuccessorCounts[sourceTermIndex]
        let successorOrdinal = plan.exitSuccessorOrdinals[exitId]
        if plan.exitKinds[exitId] == odir.OwnershipDropEdgeReturn:
            if sourceTerm.kind != coreir.BodyTermReturnTag ||
               successorOrdinal != 0 || successorCount != 0 ||
               plan.exitToScopeIds[exitId] != -1 ||
               plan.exitTargetBlockIds[exitId] != -1:
                cleanupCfgFail("cleanup_cfg: return exit does not bind return term")
            if sourceTerm.resultSlot != plan.exitReturnSourceSlots[exitId] ||
               sourceTerm.sourceDefinitionDomain !=
                   plan.exitReturnSourceDefinitionDomains[exitId] ||
               sourceTerm.sourceDefinitionRow !=
                   plan.exitReturnSourceDefinitionRows[exitId]:
                cleanupCfgFail("cleanup_cfg: return source slot mismatch")
        else:
            let targetBlock = plan.exitTargetBlockIds[exitId]
            let targetScopeId = plan.exitToScopeIds[exitId]
            if targetBlock < 0 || targetBlock >= bodyIR.blocks.len ||
               targetScopeId < 0 ||
               targetScopeId >= bodyIR.controlScopeParentIds.len ||
               bodyIR.blockScopeIds[targetBlock] != targetScopeId:
                cleanupCfgFail("cleanup_cfg: target BodyIR block missing")
            if (sourceTerm.kind == coreir.BodyTermBrTag &&
                successorCount != 1) ||
               (sourceTerm.kind == coreir.BodyTermCbrTag &&
                successorCount != 2) ||
               (sourceTerm.kind != coreir.BodyTermBrTag &&
                sourceTerm.kind != coreir.BodyTermCbrTag):
                cleanupCfgFail("cleanup_cfg: non-return exit term unsupported")
            if successorOrdinal < 0 ||
               successorOrdinal >= successorCount:
                cleanupCfgFail("cleanup_cfg: exit successor ordinal mismatch")
            let successorRow = successorStart + successorOrdinal
            if bodyIR.successorBlockIds[successorRow] != targetBlock ||
               bodyIR.successorEdgeKinds[successorRow] !=
                   cleanupCfgExitControlEdgeKind(
                       plan.exitKinds[exitId]):
                cleanupCfgFail("cleanup_cfg: exit successor identity mismatch")
        cleanupCfgRequireSnapshotBeforeCleanup(plan, bodyIR, exitId)
    cleanupCfgRequireMaterializedBounds(plan)

@borrows
fn cleanupCfgManagedLvalueReplaceKindForOp(
        bodyIR: coreir.BodyIR,
        opIndex: int32): int32 =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return coreir.ManagedStoreNoneTag
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpCallTag ||
       op.operands.len != 1 ||
       op.operands[0] < 0 ||
       op.operands[0] >= bodyIR.callSequence.len:
        return coreir.ManagedStoreNoneTag
    let kind = bodyIR.callSequence[op.operands[0]].managedStoreKind
    if kind == coreir.ManagedStoreStrRetainTag ||
       kind == coreir.ManagedStoreStrMoveTag ||
       kind == coreir.ManagedStoreSeqRetainTag ||
       kind == coreir.ManagedStoreSeqMoveTag:
        return kind
    return coreir.ManagedStoreNoneTag

fn cleanupCfgManagedLvalueReplaceMoveKind(kind: int32): bool =
    return kind == coreir.ManagedStoreStrMoveTag ||
           kind == coreir.ManagedStoreSeqMoveTag

fn cleanupCfgManagedLvalueReplaceRetainKind(kind: int32): bool =
    return kind == coreir.ManagedStoreStrRetainTag ||
           kind == coreir.ManagedStoreSeqRetainTag

@borrows
fn cleanupCfgManagedLvalueReplaceOpForCallExact(
        bodyIR: coreir.BodyIR,
        callIndex: int32): int32 =
    var out: int32 = -1
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1 &&
           op.operands[0] == callIndex:
            if out >= 0:
                cleanupCfgFail(
                    "cleanup_cfg: managed replace call has multiple ops")
            out = opIndex
    if out < 0:
        cleanupCfgFail(
            "cleanup_cfg: managed replace call op missing")
    return out

# wall83: derive（ApplyOwned 前，primary_object_plan/backend2 两挂接点）按
# 当时物理行号给 exactDef 侧车落戳并 seal；上方 in-place 行平移把原始 ops
# 行右移 initializerCount（头部 [0,initializerCount) 随后由 flag initializer
# 覆盖）后，侧车 op 车道若不随行平移，行位置与列身份整体错位（cold_nested
# 实证：identity 主审 op row=4 partial definition tuple —— ops 行 4 是右移
# 后的原始行 0（LoadConst，valueDefSlot=-1/OwnInvalid），sidecar 行 4 是
# derive 落给原始行 4 的 TEMPORARY 戳，exactType/producer/place 三列非
# sentinel 使七列空组哨兵跳过失效）。本 helper 是行平移的原子收尾；
# reanchor 责任在重定位事件点——本函数已平移 ops 源/借主/consume/action/
# call/term/manualConsume/ffi/block 全部行系坐标，exactDef 侧车是同一行系
# 坐标类的后产车道（wall64 写平移契约时它尚不存在）；ApplyOwned 返回侧的
# ExactDefFreezeSidecarSyncAppended 是 append-only 契约（"sidecar
# append-only violated" panic），且平移信息（initializerCount 与追加行数
# 之别）只存在于本事件点，消费侧无法重建。
#
# 逐车道坐标系（exact_def_derive 唯一落戳点 + SyncAppended 同源镜像）：
# - 六条 op 车道全部随行平移 + 头部 sentinel（derive 相 1 同值）；
# - opSourceDefOpRows 全列行号系（derive 唯一非 -1 臂 = local-copy 的
#   lastDefOpBySlot 物理行）→ 非 -1 值 +initializerCount；
# - opOriginIds 按 place 判别：TEMPORARY=自 op 行（+initializerCount）；
#   BORROW_PROJECTION 按 op 自身 valueDefBorrowOwnerDefinitionDomain 两域
#   判别（BodyOpTag→借主 op 行 +initializerCount；EntrySlotTag→槽 id
#   不动）；PARAM=形参序、STACK_LOCAL=defSlot 槽 id（不动）；
#   GLOBAL/CFG_MERGE/SHARED_COPY/MEMORY_VERSION derive 真空无从落戳；
# - slotOriginIds：derive 落点 first-land-wins 且同槽全部 land 必须
#   place+origin 全等（drift 即 verdict），槽 origin 是否行号系由其唯一定
#   落点 place 决定——正序扫平移后定义行（valueDefSlot>=0，与 derive 相 3
#   同触发条件），末扫赢；
# - arg 车道：argDefOpRows=derive 相 3 lastDefOpBySlot 行号系（+I）；
#   argOriginIds/argPlaceKinds 在 derive 是定义行 op 车道的同刻镜像
#   （:553-556）——argDefOpRows 平移后从已修正 op 车道精确重读 origin
#   镜像，全 place 形态覆盖（TEMPORARY 自行、BORROW_PROJECTION 两域）；
# - opReadADefOpRows derive 恒 -1（read-edge 批 2 在 freeze 校验期完成，
#   晚于本窗），仅随行平移。
# 不在此处 refreeze CID：ApplyOwned 窗口内 plan-build 已向 localSlots 追加
# 槽而侧车 slot 车道未扩（SyncAppended 在窗口尾统一扩列+refreeze，
# ShapeValid 全程挂起是既定契约），BodyIrExactDefSidecarRefreezeCidInto
# 的 ShapeValid 门在本窗必死；exactDefCid 消费点（backend2 codec/校验
# 边界）全部晚于 SyncAppended 收尾 refreeze，列内容平移被自然覆盖。
# 守卫零改动：identity/freeze/merge/call_authority 判据面零触碰。
fn cleanupCfgRelocateExactDefSidecarOpLanes(
        bodyIR: var coreir.BodyIR,
        initializerCount: int32) =
    let defLaneCount = bodyIR.exactDef.opPlaceKinds.len
    if defLaneCount <= 0:
        # derive 时 ops 为空 ⇒ canonical-empty 侧车，无戳可平移；全部
        # 物理行由 SyncAppended 追加臂统一落戳（与未平移历史行为一致）。
        return
    if bodyIR.exactDef.opExactTypeIds.len != defLaneCount ||
       bodyIR.exactDef.opOriginIds.len != defLaneCount ||
       bodyIR.exactDef.opProducerFunctionRows.len != defLaneCount ||
       bodyIR.exactDef.opSourceDefOpRows.len != defLaneCount ||
       bodyIR.exactDef.opReadADefOpRows.len != defLaneCount:
        cleanupCfgFail("cleanup_cfg: exact def sidecar op lane shape drift")
    if defLaneCount + initializerCount > bodyIR.ops.len:
        cleanupCfgFail("cleanup_cfg: exact def sidecar relocation overflow")
    setLen(bodyIR.exactDef.opPlaceKinds, defLaneCount + initializerCount)
    setLen(bodyIR.exactDef.opExactTypeIds, defLaneCount + initializerCount)
    setLen(bodyIR.exactDef.opOriginIds, defLaneCount + initializerCount)
    setLen(bodyIR.exactDef.opProducerFunctionRows,
        defLaneCount + initializerCount)
    setLen(bodyIR.exactDef.opSourceDefOpRows,
        defLaneCount + initializerCount)
    setLen(bodyIR.exactDef.opReadADefOpRows,
        defLaneCount + initializerCount)
    var relocateRow = defLaneCount - 1
    while relocateRow >= 0:
        let target = relocateRow + initializerCount
        bodyIR.exactDef.opPlaceKinds[target] =
            bodyIR.exactDef.opPlaceKinds[relocateRow]
        bodyIR.exactDef.opExactTypeIds[target] =
            bodyIR.exactDef.opExactTypeIds[relocateRow]
        bodyIR.exactDef.opOriginIds[target] =
            bodyIR.exactDef.opOriginIds[relocateRow]
        bodyIR.exactDef.opProducerFunctionRows[target] =
            bodyIR.exactDef.opProducerFunctionRows[relocateRow]
        bodyIR.exactDef.opSourceDefOpRows[target] =
            bodyIR.exactDef.opSourceDefOpRows[relocateRow]
        bodyIR.exactDef.opReadADefOpRows[target] =
            bodyIR.exactDef.opReadADefOpRows[relocateRow]
        relocateRow = relocateRow - 1
    var headRow = 0
    while headRow < initializerCount:
        bodyIR.exactDef.opPlaceKinds[headRow] =
            exactdef.BodyIrExactDefPlaceInvalidTag
        bodyIR.exactDef.opExactTypeIds[headRow] = -1
        bodyIR.exactDef.opOriginIds[headRow] = -1
        bodyIR.exactDef.opProducerFunctionRows[headRow] = -1
        bodyIR.exactDef.opSourceDefOpRows[headRow] = -1
        bodyIR.exactDef.opReadADefOpRows[headRow] = -1
        headRow = headRow + 1
    var fixedRow = initializerCount
    while fixedRow < defLaneCount + initializerCount:
        if bodyIR.exactDef.opSourceDefOpRows[fixedRow] >= 0:
            bodyIR.exactDef.opSourceDefOpRows[fixedRow] =
                bodyIR.exactDef.opSourceDefOpRows[fixedRow] +
                initializerCount
        let place = bodyIR.exactDef.opPlaceKinds[fixedRow]
        if place == exactdef.BodyIrExactDefPlaceTemporaryTag:
            bodyIR.exactDef.opOriginIds[fixedRow] =
                bodyIR.exactDef.opOriginIds[fixedRow] + initializerCount
        elif place == exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
             bodyIR.ops[fixedRow].valueDefBorrowOwnerDefinitionDomain ==
                 coreir.BodyDefinitionDomainBodyOpTag:
            bodyIR.exactDef.opOriginIds[fixedRow] =
                bodyIR.exactDef.opOriginIds[fixedRow] + initializerCount
        fixedRow = fixedRow + 1
    var slotOriginIsOpRow: bool[]
    setLen(slotOriginIsOpRow, bodyIR.exactDef.slotOriginIds.len)
    var scanRow = initializerCount
    while scanRow < defLaneCount + initializerCount:
        let defSlot = bodyIR.ops[scanRow].valueDefSlot
        if defSlot >= 0 && defSlot < bodyIR.exactDef.slotOriginIds.len:
            let place = bodyIR.exactDef.opPlaceKinds[scanRow]
            slotOriginIsOpRow[defSlot] =
                place == exactdef.BodyIrExactDefPlaceTemporaryTag ||
                (place == exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
                 bodyIR.ops[scanRow].valueDefBorrowOwnerDefinitionDomain ==
                     coreir.BodyDefinitionDomainBodyOpTag)
        scanRow = scanRow + 1
    var slotRow = 0
    while slotRow < bodyIR.exactDef.slotOriginIds.len:
        if slotOriginIsOpRow[slotRow] &&
           bodyIR.exactDef.slotOriginIds[slotRow] >= 0:
            bodyIR.exactDef.slotOriginIds[slotRow] =
                bodyIR.exactDef.slotOriginIds[slotRow] + initializerCount
        slotRow = slotRow + 1
    for argRow in 0..<bodyIR.exactDef.argDefOpRows.len:
        if bodyIR.exactDef.argDefOpRows[argRow] >= 0:
            bodyIR.exactDef.argDefOpRows[argRow] =
                bodyIR.exactDef.argDefOpRows[argRow] + initializerCount
            bodyIR.exactDef.argOriginIds[argRow] =
                bodyIR.exactDef.opOriginIds[
                    bodyIR.exactDef.argDefOpRows[argRow]]

fn cleanupCfgInsertFlagInitializers(plan: var CleanupPlan,
                                    bodyIR: var coreir.BodyIR,
                                    report: var CleanupMaterializeReport) =
    let initializerCount = cleanupCfgCheckedAdd(
        plan.deferActiveFlagSlots.len,
        plan.ownershipConditionFlagBindingFlagIds.len,
        "cleanup_cfg: initializer count overflow")
    if initializerCount <= 0:
        return
    # wall64：记录平移基址与原始 ops.len，供 plan 内原始坐标系的绝对
    # BodyOp 行在材料化消费点按 cleanupCfgRelocatePlanDefinitionCoordinate
    # 平移（plan 行本身受 original-source identity 指纹门保护，禁止就地改）。
    plan.initializerRelocationOpBase = initializerCount
    plan.initializerRelocationOpCount = bodyIR.ops.len
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR):
        cleanupCfgFail("cleanup_cfg: source debug provenance shape invalid")
    if bodyIR.manualConsume.sealed &&
       !coreir.BodyIRManualConsumeSidecarShapeValid(bodyIR):
        cleanupCfgFail(
            "cleanup_cfg: manual-consume sidecar invalid before relocation")
    let ffiHandleCapabilityWasSealed =
        bodyIR.externFfiHandleCapabilities.sealed
    if ffiHandleCapabilityWasSealed:
        bodyIR.externFfiHandleCapabilities.sealed = false
        var emptyFfiHandleCapabilityRoot: layout.FixedBytes32
        bodyIR.externFfiHandleCapabilities.rootCid =
            emptyFfiHandleCapabilityRoot
    var relocatedDomain: int32
    var relocatedRow: int32
    for opIndex in 0..<bodyIR.ops.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.ops[opIndex].sourceDefinitionDomain,
            bodyIR.ops[opIndex].sourceDefinitionRow,
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.ops[opIndex].valueDefBorrowOwnerDefinitionDomain,
            bodyIR.ops[opIndex].valueDefBorrowOwnerDefinitionRow,
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
    for callIndex in 0..<bodyIR.callSequence.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.callSequence[callIndex].sourceDefinitionDomain,
            bodyIR.callSequence[callIndex].sourceDefinitionRow,
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.callSequence[callIndex].
                resultBorrowOwnerDefinitionDomain,
            bodyIR.callSequence[callIndex].
                resultBorrowOwnerDefinitionRow,
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
    for termIndex in 0..<bodyIR.terms.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.terms[termIndex].sourceDefinitionDomain,
            bodyIR.terms[termIndex].sourceDefinitionRow,
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
    for exitId in 0..<plan.exitReturnSourceDefinitionRows.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            plan.exitReturnSourceDefinitionDomains[exitId],
            plan.exitReturnSourceDefinitionRows[exitId],
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
    for actionRow in 0..<plan.ownershipActionKinds.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            plan.ownershipActionSourceDefinitionDomains[actionRow],
            plan.ownershipActionSourceDefinitionRows[actionRow],
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            plan.ownershipActionCapturedOldSourceDefinitionDomains[actionRow],
            plan.ownershipActionCapturedOldSourceDefinitionRows[actionRow],
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
    for manualRow in 0..<bodyIR.manualConsume.callOrdinals.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.manualConsume.targetDefinitionDomains[manualRow],
            bodyIR.manualConsume.targetDefinitionRows[manualRow],
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.manualConsume.sourceDefinitionDomains[manualRow],
            bodyIR.manualConsume.sourceDefinitionRows[manualRow],
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.manualConsume.postDefinitionDomains[manualRow],
            bodyIR.manualConsume.postDefinitionRows[manualRow],
            initializerCount,
            bodyIR.ops.len,
            relocatedDomain,
            relocatedRow)
    let manualConsumeWasSealed = bodyIR.manualConsume.sealed
    if manualConsumeWasSealed:
        bodyIR.manualConsume.sealed = false
        var emptyManualConsumeRoot: layout.FixedBytes32
        bodyIR.manualConsume.rootCid = emptyManualConsumeRoot
    # wall71：候选 ops 原地尾部平移。此前为「局部 newOps seq 拷贝填充 +
    # bodyIR.ops = newOps 整列赋值」形态：move 赋值后局部 seq 的函数尾
    # 残留 drop 对同一候选缓冲多减一次 rc（wall67/wall69 实证候选缓冲在
    # stage 窗口内被提前释放进入 freelist，随后任意托管分配复用清零尾行
    # ——initialized producer definition drift 全零行；w71 r1/r2 诊断轮
    # checkpoint 轨迹钉死清零发生在 A 点读取与 consumed 守卫之间的托管
    # 分配处，armed release watch 全程不命中：复用者是分配而非释放）。
    # 原地形态下候选缓冲即 bodyIR.ops 本体，无独立局部托管寿命，形态性
    # 消除该多减点；行内容/身份平移契约与 wall64 reloc 读法逐字节不变
    # （setLen 增长保留旧元素、尾部零填后由搬移与 initializer 显式写满）。
    let originalOpCount = bodyIR.ops.len
    let outputOpCapacity = cleanupCfgCheckedAdd(
        originalOpCount,
        initializerCount,
        "cleanup_cfg: initializer output count overflow")
    setLen(bodyIR.ops, outputOpCapacity)
    if bodyIR.debugProvenanceRequired:
        setLen(bodyIR.debugOpIdsByOpIndex, outputOpCapacity)
        setLen(bodyIR.debugSyntheticKindsByOpIndex, outputOpCapacity)
    var relocateOpIndex = cleanupCfgCheckedSub(
        originalOpCount,
        1,
        "cleanup_cfg: original BodyOp count underflow")
    while relocateOpIndex >= 0:
        let outputOpIndex = cleanupCfgCheckedAdd(
            initializerCount,
            relocateOpIndex,
            "cleanup_cfg: initializer row overflow")
        var op = bodyIR.ops[relocateOpIndex]
        let managedReplaceKind =
            cleanupCfgManagedLvalueReplaceKindForOp(bodyIR, relocateOpIndex)
        if cleanupCfgManagedLvalueReplaceMoveKind(managedReplaceKind):
            if op.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               op.sourceDefinitionRow < 0 ||
               op.consumeActionRow != relocateOpIndex:
                cleanupCfgFail(
                    "cleanup_cfg: managed replace op action identity invalid")
            op.consumeActionRow = outputOpIndex
        elif cleanupCfgManagedLvalueReplaceRetainKind(managedReplaceKind):
            if op.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               op.sourceDefinitionRow < 0 ||
               op.consumeActionRow != -1:
                cleanupCfgFail(
                    "cleanup_cfg: managed retain op action identity invalid")
        elif managedReplaceKind == coreir.ManagedStoreNoneTag &&
             op.kind == coreir.BodyOpCallTag &&
             op.operands.len == 1 &&
             op.operands[0] >= 0 &&
             op.operands[0] < bodyIR.callSequence.len &&
             op.sourceDefinitionDomain ==
                 coreir.BodyDefinitionDomainBodyOpTag &&
             op.sourceDefinitionRow >= 0 &&
             op.sourceDefinitionRow < originalOpCount &&
             op.consumeActionRow == relocateOpIndex:
            # wall95：ingress intrinsic 消费对（wall35 生产拼写
            # ManagedLvalueReplaceProductionBindIntrinsicSourceConsume：
            # action 行=消费 op 自身行，消费 op 紧随 bind 追加）的
            # op/call consumeActionRow 列同为 op 行域坐标，行平移必须
            # 与源 def 的 cop 边（下方统一随迁）同步随迁，否则消费对
            # 跨坐标系漂移。逐列镜像生产拼写（ManagedStoreNone +
            # call/op 源定义对同指 + 源 def TypedExpr OwnMove cop 边
            # 恰指本消费 op、未收动作行），非 ingress 形零触碰。
            var ingressCallRelocated =
                bodyIR.callSequence[op.operands[0]]
            let ingressDefinition = bodyIR.ops[op.sourceDefinitionRow]
            if ingressCallRelocated.managedStoreKind ==
                   coreir.ManagedStoreNoneTag &&
               ingressCallRelocated.sourceDefinitionDomain ==
                   coreir.BodyDefinitionDomainBodyOpTag &&
               ingressCallRelocated.sourceDefinitionRow ==
                   op.sourceDefinitionRow &&
               ingressCallRelocated.consumeActionRow == relocateOpIndex &&
               ingressDefinition.valueDefOriginKind ==
                   coreir.BodyDefinitionOriginTypedExprTag &&
               ingressDefinition.valueDefOwnership == coreir.OwnMove &&
               ingressDefinition.valueDefConsumeOpIndexPlusOne ==
                   relocateOpIndex + 1 &&
               ingressDefinition.consumeActionRow == -1:
                ingressCallRelocated.consumeActionRow = outputOpIndex
                op.consumeActionRow = outputOpIndex
            bodyIR.callSequence[op.operands[0]] = ingressCallRelocated
        if op.valueDefConsumeOpIndexPlusOne != 0:
            let consumeOpIndex =
                cleanupCfgCheckedSub(
                    op.valueDefConsumeOpIndexPlusOne,
                    1,
                    "cleanup_cfg: managed value consume op identity underflow")
            let typedDefinition =
                op.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginTypedExprTag &&
                op.valueDefExprNodeIndex >= 0 &&
                op.valueDefSemanticRow >= 0 &&
                op.valueDefOriginId == op.valueDefSemanticRow &&
                op.sourceDefinitionDomain ==
                    coreir.BodyDefinitionDomainInvalidTag &&
                op.sourceDefinitionRow == -1
            let cleanupDefinition =
                op.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                op.valueDefOriginId >= 0 &&
                op.sourceDefinitionDomain ==
                    coreir.BodyDefinitionDomainBodyOpTag &&
                op.sourceDefinitionRow >= 0 &&
                op.sourceDefinitionRow < originalOpCount
            if op.valueDefOwnership == coreir.OwnInvalid ||
               op.valueDefSlot < 0 ||
               op.valueDefSlot != op.target ||
               (!typedDefinition && !cleanupDefinition) ||
               op.valueDefConsumeOpIndexPlusOne > originalOpCount:
                cleanupCfgFail(
                    "cleanup_cfg: managed value consume op identity invalid")
            let consumeManagedReplaceKind =
                cleanupCfgManagedLvalueReplaceKindForOp(
                    bodyIR, consumeOpIndex)
            if cleanupCfgManagedLvalueReplaceMoveKind(
                    consumeManagedReplaceKind):
                if op.consumeActionRow != consumeOpIndex:
                    cleanupCfgFail(
                        "cleanup_cfg: managed source action identity invalid")
                op.consumeActionRow = cleanupCfgCheckedAdd(
                    op.consumeActionRow,
                    initializerCount,
                    "cleanup_cfg: managed source action identity overflow")
            elif cleanupCfgManagedLvalueReplaceRetainKind(
                    consumeManagedReplaceKind):
                cleanupCfgFail(
                    "cleanup_cfg: retained managed source cannot be consumed")
            op.valueDefConsumeOpIndexPlusOne = cleanupCfgCheckedAdd(
                op.valueDefConsumeOpIndexPlusOne,
                initializerCount,
                "cleanup_cfg: managed value consume op identity overflow")
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            op.sourceDefinitionDomain,
            op.sourceDefinitionRow,
            initializerCount,
            originalOpCount,
            op.sourceDefinitionDomain,
            op.sourceDefinitionRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            op.valueDefBorrowOwnerDefinitionDomain,
            op.valueDefBorrowOwnerDefinitionRow,
            initializerCount,
            originalOpCount,
            op.valueDefBorrowOwnerDefinitionDomain,
            op.valueDefBorrowOwnerDefinitionRow)
        bodyIR.ops[outputOpIndex] = op
        if bodyIR.debugProvenanceRequired:
            bodyIR.debugOpIdsByOpIndex[outputOpIndex] =
                bodyIR.debugOpIdsByOpIndex[relocateOpIndex]
            # wall83 r3：synthetic 镜像写必须与 opIds 镜像写同守卫。wall71
            # 原地改写时把本行留在守卫外（HEAD 旧形态两支都在
            # debugProvenanceRequired 内）：debug 关闭时两 debug 车道恒空
            # （setLen 在 10137 守卫内），任何 initializerCount>0 且
            # debugProvenanceRequired=false 的函数进入行平移循环即在空
            # 车道上越界读写（当前树态实证 brk#0x2：index=30<len=0，
            # lldb 断点证明本循环先于 exactDef 侧车平移执行）。恢复守卫
            # 对称，debug=true 路径逐字节不变。
            bodyIR.debugSyntheticKindsByOpIndex[outputOpIndex] =
                bodyIR.debugSyntheticKindsByOpIndex[relocateOpIndex]
        relocateOpIndex = relocateOpIndex - 1
    # wall83: 行平移的原子收尾 —— exactDef 侧车 op/slot/arg 车道随行
    # 平移 + 行号系坐标修正（derive 在 ApplyOwned 前按旧行号落戳；
    # 责任与逐车道坐标系判别见 helper 注释）。
    cleanupCfgRelocateExactDefSidecarOpLanes(bodyIR, initializerCount)
    if bodyIR.debugProvenanceRequired:
        for initializerIndex in 0..<initializerCount:
            bodyIR.debugOpIdsByOpIndex[initializerIndex] = -1
            bodyIR.debugSyntheticKindsByOpIndex[initializerIndex] =
                coreir.BodyDebugSyntheticCleanup
    for deferId in 0..<plan.deferActiveFlagSlots.len:
        var op: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(op)
        op.kind = coreir.BodyOpLoadConstTag
        op.target = plan.deferActiveFlagSlots[deferId]
        add(op.operands, coreir.LocalI32Tag)
        add(op.operands, 0)
        bodyIR.ops[deferId] = op
    for bindingIndex in 0..<plan.ownershipConditionFlagBindingFlagIds.len:
        var op: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(op)
        op.kind = coreir.BodyOpLoadConstTag
        op.target = plan.ownershipConditionFlagBindingLocalSlots[bindingIndex]
        add(op.operands, coreir.LocalI32Tag)
        var initialValue: int32
        if plan.ownershipConditionFlagBindingInitialValues[bindingIndex]:
            initialValue = 1
        add(op.operands, initialValue)
        let initializerIndex = cleanupCfgCheckedAdd(
            plan.deferActiveFlagSlots.len,
            bindingIndex,
            "cleanup_cfg: initializer row overflow")
        bodyIR.ops[initializerIndex] = op
    let originalBodyOpCount = originalOpCount
    for callIndex in 0..<bodyIR.callSequence.len:
        var call = bodyIR.callSequence[callIndex]
        let managedReplaceMove =
            cleanupCfgManagedLvalueReplaceMoveKind(call.managedStoreKind)
        let managedReplaceRetain =
            cleanupCfgManagedLvalueReplaceRetainKind(
                call.managedStoreKind)
        var managedReplaceOpIndex: int32 = -1
        if managedReplaceMove || managedReplaceRetain:
            managedReplaceOpIndex =
                cleanupCfgManagedLvalueReplaceOpForCallExact(
                    bodyIR, callIndex)
        if managedReplaceMove:
            if call.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               call.sourceDefinitionRow < 0 ||
               call.consumeActionRow < 0:
                cleanupCfgFail(
                    "cleanup_cfg: managed replace call action identity invalid")
            call.consumeActionRow = cleanupCfgCheckedAdd(
                call.consumeActionRow,
                initializerCount,
                "cleanup_cfg: managed replace call action identity overflow")
        elif managedReplaceRetain:
            if call.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               call.sourceDefinitionRow < 0 ||
               call.consumeActionRow != -1:
                cleanupCfgFail(
                    "cleanup_cfg: managed retain call action identity invalid")
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            call.sourceDefinitionDomain,
            call.sourceDefinitionRow,
            initializerCount,
            originalBodyOpCount,
            call.sourceDefinitionDomain,
            call.sourceDefinitionRow)
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            call.resultBorrowOwnerDefinitionDomain,
            call.resultBorrowOwnerDefinitionRow,
            initializerCount,
            originalBodyOpCount,
            call.resultBorrowOwnerDefinitionDomain,
            call.resultBorrowOwnerDefinitionRow)
        if managedReplaceOpIndex >= 0:
            let managedReplaceOp =
                bodyIR.ops[managedReplaceOpIndex]
            if managedReplaceOp.sourceDefinitionDomain !=
                   call.sourceDefinitionDomain ||
               managedReplaceOp.sourceDefinitionRow !=
                   call.sourceDefinitionRow ||
               managedReplaceOp.consumeActionRow !=
                   call.consumeActionRow:
                cleanupCfgFail(
                    "cleanup_cfg: managed replace call/op authority drift")
        bodyIR.callSequence[callIndex] = call
    if ffiHandleCapabilityWasSealed:
        for callRow in 0..<
                bodyIR.externFfiHandleCapabilities.callBodyOpRows.len:
            bodyIR.externFfiHandleCapabilities.callBodyOpRows[callRow] =
                cleanupCfgCheckedAdd(
                    bodyIR.externFfiHandleCapabilities.
                        callBodyOpRows[callRow],
                    initializerCount,
                    "cleanup_cfg: ffi call BodyOp row overflow")
    for termIndex in 0..<bodyIR.terms.len:
        var term = bodyIR.terms[termIndex]
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            term.sourceDefinitionDomain,
            term.sourceDefinitionRow,
            initializerCount,
            cleanupCfgCheckedSub(
                bodyIR.ops.len,
                initializerCount,
                "cleanup_cfg: original BodyOp count underflow"),
            term.sourceDefinitionDomain,
            term.sourceDefinitionRow)
        bodyIR.terms[termIndex] = term
    let originalBodyOpCountManualConsume = cleanupCfgCheckedSub(
        bodyIR.ops.len,
        initializerCount,
        "cleanup_cfg: original BodyOp count underflow")
    for manualRow in 0..<bodyIR.manualConsume.callOrdinals.len:
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.manualConsume.targetDefinitionDomains[manualRow],
            bodyIR.manualConsume.targetDefinitionRows[manualRow],
            initializerCount,
            originalBodyOpCountManualConsume,
            relocatedDomain,
            relocatedRow)
        bodyIR.manualConsume.targetDefinitionDomains[manualRow] =
            relocatedDomain
        bodyIR.manualConsume.targetDefinitionRows[manualRow] =
            relocatedRow
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.manualConsume.sourceDefinitionDomains[manualRow],
            bodyIR.manualConsume.sourceDefinitionRows[manualRow],
            initializerCount,
            originalBodyOpCountManualConsume,
            relocatedDomain,
            relocatedRow)
        bodyIR.manualConsume.sourceDefinitionDomains[manualRow] =
            relocatedDomain
        bodyIR.manualConsume.sourceDefinitionRows[manualRow] =
            relocatedRow
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            bodyIR.manualConsume.postDefinitionDomains[manualRow],
            bodyIR.manualConsume.postDefinitionRows[manualRow],
            initializerCount,
            originalBodyOpCountManualConsume,
            relocatedDomain,
            relocatedRow)
        bodyIR.manualConsume.postDefinitionDomains[manualRow] =
            relocatedDomain
        bodyIR.manualConsume.postDefinitionRows[manualRow] =
            relocatedRow
    if manualConsumeWasSealed:
        coreir.BodyIRManualConsumeSeal(bodyIR)
    for blockIndex in 0..<bodyIR.blocks.len:
        if blockIndex == plan.entryBlockId:
            bodyIR.blocks[blockIndex].opCount =
                cleanupCfgCheckedAdd(
                    bodyIR.blocks[blockIndex].opCount,
                    initializerCount,
                    "cleanup_cfg: initializer block count overflow")
        else:
            bodyIR.blocks[blockIndex].opStart =
                cleanupCfgCheckedAdd(
                    bodyIR.blocks[blockIndex].opStart,
                    initializerCount,
                    "cleanup_cfg: initializer block start overflow")
    for siteId in 0..<bodyIR.deferActivationSiteBlockIds.len:
        if bodyIR.deferActivationSiteBlockIds[siteId] ==
               plan.entryBlockId:
            bodyIR.deferActivationSiteAfterOpOrdinals[siteId] =
                cleanupCfgCheckedAdd(
                    bodyIR.deferActivationSiteAfterOpOrdinals[siteId],
                    initializerCount,
                    "cleanup_cfg: activation site ordinal overflow")
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount,
        initializerCount)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount,
        cleanupCfgCheckedMul(
            initializerCount,
            2,
            "cleanup_cfg: initializer operand report overflow"))

fn cleanupCfgAppendOwnershipSimpleCallUnit(
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        symbol: str,
        runtimeActionKind: int32,
        typeArenaTypeId: int32,
        targetSlot: int32,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32,
        actionRow: int32,
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    out.entryBlockId = bodyIR.blocks.len
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    call.targetIsImportc = false
    if sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       sourceDefinitionRow < 0 ||
       sourceDefinitionRow >= bodyIR.ops.len:
        cleanupCfgFail(
            "cleanup_cfg: ownership call definition coordinate invalid")
    call.sourceDefinitionDomain = sourceDefinitionDomain
    call.sourceDefinitionRow = sourceDefinitionRow
    call.consumeActionRow = actionRow
    call.managedStoreKind = coreir.ManagedStoreCleanupRetainTag
    add(call.argSlots, coreir.CallArgSlotAddress(targetSlot))
    add(call.argPassKinds, coreir.BodyCallPassByAddressAggregateTag)
    add(call.argAbiSizes, 8)
    let runtimeTargetCid =
        cleanupCfgRuntimeIntrinsicInterfaceCid(
            bodyIR,
            call,
            runtimeActionKind,
            typeArenaTypeId)
    let callOrdinal = cleanupCfgAppendCallWithTarget(
        bodyIR,
        call,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
        0,
        runtimeTargetCid)
    let opStart = bodyIR.ops.len
    var callOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = -1
    callOp.sourceDefinitionDomain = sourceDefinitionDomain
    callOp.sourceDefinitionRow = sourceDefinitionRow
    callOp.consumeActionRow = actionRow
    add(callOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, callOp)
    var tail: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(tail)
    tail.kind = coreir.BodyTermBrTag
    tail.trueBlock = -1
    let tailIndex = cleanupCfgAppendTermExact(
        bodyIR, tail, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let blockId = cleanupCfgAppendBlockExact(
        bodyIR, opStart, 1, tailIndex, scopeId)
    if blockId != out.entryBlockId:
        cleanupCfgFail("cleanup_cfg: ownership call unit block drift")
    cleanupCfgOwnershipPatchAdd(bodyIR, out, tailIndex, 0)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount, 1)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount, 1)
    report.materializedCallCount = cleanupCfgCheckedReportAdd(
        report.materializedCallCount, 1)
    report.materializedCallArgCount = cleanupCfgCheckedReportAdd(
        report.materializedCallArgCount, 2)
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount, 1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount, 1)
    return out

fn cleanupCfgAppendOwnershipCopyUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        actionRow: int32,
        firstSourceSlot: int32,
        firstTargetSlot: int32,
        secondSourceSlot: int32,
        secondTargetSlot: int32,
        copyCount: int32,
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    if copyCount != 1 && copyCount != 2:
        cleanupCfgFail("cleanup_cfg: ownership copy unit count invalid")
    if actionRow < 0 ||
       actionRow >= plan.ownershipActionKinds.len:
        cleanupCfgFail("cleanup_cfg: managed copy action row invalid")
    # wall64：action 源行同为原始坐标系，消费时按插入基址平移。
    var sourceDefinitionDomain: int32
    var sourceDefinitionRow: int32
    cleanupCfgRelocatePlanDefinitionCoordinate(
        plan,
        bodyIR,
        plan.ownershipActionSourceDefinitionDomains[actionRow],
        plan.ownershipActionSourceDefinitionRows[actionRow],
        sourceDefinitionDomain,
        sourceDefinitionRow)
    var retainedSourceDefinitionDomain = sourceDefinitionDomain
    var retainedSourceDefinitionRow = sourceDefinitionRow
    var retainedSourceSlot = secondSourceSlot
    var consumeActionRow =
        plan.ownershipActionConsumeActionRows[actionRow]
    if copyCount == 1:
        if plan.ownershipActionKinds[actionRow] !=
               odir.CleanupActionStoreMove:
            cleanupCfgFail("cleanup_cfg: managed move action authority invalid")
    else:
        if plan.ownershipActionKinds[actionRow] !=
               odir.CleanupActionStoreOwned ||
           plan.ownershipActionCapturedOldSourceDefinitionRows[actionRow] < 0:
            cleanupCfgFail(
                "cleanup_cfg: retained store captured-old authority invalid")
        cleanupCfgRelocatePlanDefinitionCoordinate(
            plan,
            bodyIR,
            plan.ownershipActionCapturedOldSourceDefinitionDomains[actionRow],
            plan.ownershipActionCapturedOldSourceDefinitionRows[actionRow],
            sourceDefinitionDomain,
            sourceDefinitionRow)
        consumeActionRow = actionRow
    if sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       sourceDefinitionRow < 0 ||
       sourceDefinitionRow >= bodyIR.ops.len ||
       consumeActionRow < 0:
        cleanupCfgFail("cleanup_cfg: managed move source authority missing")
    var sourceDefinition = bodyIR.ops[sourceDefinitionRow]
    if sourceDefinition.valueDefOwnership != coreir.OwnMove ||
       sourceDefinition.valueDefSemanticRow < 0 ||
       sourceDefinition.valueDefSlot != firstSourceSlot ||
       sourceDefinition.valueDefOriginKind ==
           coreir.BodyDefinitionOriginUnknownTag ||
       sourceDefinition.valueDefOriginId < 0 ||
       sourceDefinition.valueDefConsumeOpIndexPlusOne != 0 ||
       sourceDefinition.consumeActionRow != -1:
        cleanupCfgFail("cleanup_cfg: managed move source value-def invalid")
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    out.entryBlockId = bodyIR.blocks.len
    let opStart = bodyIR.ops.len
    sourceDefinition.valueDefConsumeOpIndexPlusOne =
        cleanupCfgCheckedAdd(
            opStart,
            1,
            "cleanup_cfg: managed move consume op overflow")
    sourceDefinition.consumeActionRow = consumeActionRow
    let sourceDefinitionSemanticRow =
        sourceDefinition.valueDefSemanticRow
    bodyIR.ops[sourceDefinitionRow] = sourceDefinition
    var first: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(first)
    first.kind = coreir.BodyOpCopyLocalTag
    first.target = firstTargetSlot
    first.valueDefSlot = firstTargetSlot
    first.valueDefExprNodeIndex = -1
    first.valueDefSemanticRow =
        sourceDefinitionSemanticRow
    first.valueDefOwnership = coreir.OwnMove
    first.valueDefOriginKind =
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag
    first.valueDefOriginId = consumeActionRow
    first.sourceDefinitionDomain = sourceDefinitionDomain
    first.sourceDefinitionRow = sourceDefinitionRow
    add(first.operands, firstSourceSlot)
    out.managedDefinitionOpId = coreir.BodyIRAppendOp(bodyIR, first)
    if copyCount == 2:
        let sameSlotRetainedReplace =
            firstSourceSlot == secondSourceSlot &&
            secondSourceSlot == secondTargetSlot
        if sameSlotRetainedReplace:
            retainedSourceDefinitionDomain =
                coreir.BodyDefinitionDomainBodyOpTag
            retainedSourceDefinitionRow =
                out.managedDefinitionOpId
            retainedSourceSlot = firstTargetSlot
        let retainedDefinitionActionRow =
            cleanupCfgCheckedSub(
                actionRow,
                1,
                "cleanup_cfg: retained definition action row underflow")
        if retainedSourceDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           retainedSourceDefinitionRow < 0 ||
           retainedSourceDefinitionRow >= bodyIR.ops.len ||
           plan.ownershipActionKinds[retainedDefinitionActionRow] !=
               odir.CleanupActionRetainValue ||
           plan.ownershipActionOpIds[retainedDefinitionActionRow] !=
               plan.ownershipActionOpIds[actionRow] ||
           plan.ownershipActionDefinitionOriginKinds[actionRow] !=
               odir.DefinitionOriginTypedExpr ||
           plan.ownershipActionDefinitionOriginIds[actionRow] < 0:
            cleanupCfgFail(
                "cleanup_cfg: retained definition source authority missing")
        let retainedSourceDefinition =
            bodyIR.ops[retainedSourceDefinitionRow]
        if retainedSourceDefinition.valueDefOwnership != coreir.OwnMove &&
           retainedSourceDefinition.valueDefOwnership !=
               coreir.OwnBorrowShared:
            cleanupCfgFail(
                "cleanup_cfg: retained definition source ownership invalid")
        if retainedSourceDefinition.valueDefSemanticRow < 0 ||
           retainedSourceDefinition.valueDefSlot != retainedSourceSlot ||
           retainedSourceDefinition.valueDefOriginKind ==
               coreir.BodyDefinitionOriginUnknownTag:
            cleanupCfgFail(
                "cleanup_cfg: retained definition source identity invalid")
        var second: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(second)
        second.kind = coreir.BodyOpCopyLocalTag
        second.target = secondTargetSlot
        second.valueDefSlot = secondTargetSlot
        second.valueDefExprNodeIndex =
            plan.ownershipActionDefinitionOriginIds[actionRow]
        second.valueDefSemanticRow =
            retainedSourceDefinition.valueDefSemanticRow
        second.valueDefOwnership = coreir.OwnMove
        second.valueDefOriginKind =
            coreir.BodyDefinitionOriginCanonicalCleanupActionTag
        second.valueDefOriginId = retainedDefinitionActionRow
        second.sourceDefinitionDomain = retainedSourceDefinitionDomain
        second.sourceDefinitionRow = retainedSourceDefinitionRow
        add(second.operands, retainedSourceSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, second)
    var tail: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(tail)
    tail.kind = coreir.BodyTermBrTag
    tail.trueBlock = -1
    let tailIndex = cleanupCfgAppendTermExact(
        bodyIR, tail, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let blockId = cleanupCfgAppendBlockExact(
        bodyIR, opStart, copyCount, tailIndex, scopeId)
    if blockId != out.entryBlockId:
        cleanupCfgFail("cleanup_cfg: ownership copy unit block drift")
    cleanupCfgOwnershipPatchAdd(bodyIR, out, tailIndex, 0)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount, copyCount)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount, copyCount)
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount, 1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount, 1)
    return out

fn cleanupCfgAppendOwnershipOpTransitionUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        transitionStart: int32,
        transitionCount: int32,
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    if transitionCount <= 0:
        return out
    out.entryBlockId = bodyIR.blocks.len
    let opStart = bodyIR.ops.len
    for offset in 0..<transitionCount:
        let row = cleanupCfgCheckedAdd(
            transitionStart,
            offset,
            "cleanup_cfg: ownership op transition row overflow")
        var transitionOp: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(transitionOp)
        transitionOp.kind = coreir.BodyOpLoadConstTag
        transitionOp.target = plan.ownershipFlagTransitionFlagSlots[row]
        add(transitionOp.operands, coreir.LocalI32Tag)
        var value: int32
        if plan.ownershipFlagTransitionSetValues[row]:
            value = 1
        add(transitionOp.operands, value)
        let _ = coreir.BodyIRAppendOp(bodyIR, transitionOp)
    var tail: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(tail)
    tail.kind = coreir.BodyTermBrTag
    tail.trueBlock = -1
    let tailIndex = cleanupCfgAppendTermExact(
        bodyIR, tail, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let blockId = cleanupCfgAppendBlockExact(
        bodyIR, opStart, transitionCount, tailIndex, scopeId)
    if blockId != out.entryBlockId:
        cleanupCfgFail("cleanup_cfg: ownership op transition block drift")
    cleanupCfgOwnershipPatchAdd(bodyIR, out, tailIndex, 0)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount, transitionCount)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount,
        cleanupCfgCheckedMul(
            transitionCount,
            2,
            "cleanup_cfg: ownership op transition operand overflow"))
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount, 1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount, 1)
    return out

fn cleanupCfgMaterializeOwnershipOpActionUnits(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        opRow: int32,
        snapshotLiveSlots: var int32[],
        snapshotSlots: var int32[],
        firstBlockIdOut: var int32,
        tailPatchOut: var cleanupOwnershipUnitPatch,
        report: var CleanupMaterializeReport,
        scheduleDraft: var cleanupScheduleDraft) =
    firstBlockIdOut = -1
    tailPatchOut = cleanupCfgEmptyOwnershipUnitPatch()
    let actionStart = plan.ownershipOpActionStarts[opRow]
    let actionCount = plan.ownershipOpActionCounts[opRow]
    var capturedDefinitionOpId = -1
    var capturedDefinitionSourceDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    var capturedDefinitionSourceDefinitionRow = -1
    var capturedDefinitionReleased: bool
    var capturedDefinitionProjected: bool
    for offset in 0..<actionCount:
        let actionRow = cleanupCfgCheckedAdd(
            actionStart,
            offset,
            "cleanup_cfg: ownership op action row overflow")
        let kind = plan.ownershipActionKinds[actionRow]
        var unit = cleanupCfgEmptyOwnershipUnitPatch()
        let unitLocalStart = bodyIR.localSlots.len
        let unitOpStart = bodyIR.ops.len
        let unitCallStart = bodyIR.callSequence.len
        let unitBlockStart = bodyIR.blocks.len
        let unitTermStart = bodyIR.terms.len
        if kind == odir.CleanupActionRetainValue:
            let retainIndex =
                plan.ownershipActionRetainGlueBindingIndices[actionRow]
            let retainSymbol =
                plan.ownershipRetainGlueBindingSymbols[retainIndex]
            let retainTypeId =
                plan.ownershipRetainGlueBindingTypeIds[retainIndex]
            let retainTypeRow =
                cleanupCfgPlanTypeLayoutRow(plan, retainTypeId)
            let retainTypeArenaTypeId =
                plan.typeLayoutTypeArenaTypeIds[retainTypeRow]
            # wall64：retain 单元写入新 call op 的源定义坐标是物理
            # BodyOp 行，须按插入基址平移（plan 列保持原始系供互比）。
            var retainSourceDefinitionDomain: int32
            var retainSourceDefinitionRow: int32
            cleanupCfgRelocatePlanDefinitionCoordinate(
                plan,
                bodyIR,
                plan.ownershipActionSourceDefinitionDomains[actionRow],
                plan.ownershipActionSourceDefinitionRows[actionRow],
                retainSourceDefinitionDomain,
                retainSourceDefinitionRow)
            unit = cleanupCfgAppendOwnershipSimpleCallUnit(
                bodyIR,
                scopeId,
                strings.CloneStr(retainSymbol),
                CleanupRuntimeIntrinsicOwnershipRetainTag,
                retainTypeArenaTypeId,
                plan.ownershipActionTargetSlots[actionRow],
                retainSourceDefinitionDomain,
                retainSourceDefinitionRow,
                actionRow,
                report)
        elif kind == odir.CleanupActionStoreOwned:
            unit = cleanupCfgAppendOwnershipCopyUnit(
                plan,
                bodyIR,
                scopeId,
                actionRow,
                plan.ownershipActionTargetSlots[actionRow],
                plan.ownershipActionCapturedOldSlots[actionRow],
                plan.ownershipActionSourceSlots[actionRow],
                plan.ownershipActionTargetSlots[actionRow],
                2,
                report)
            if capturedDefinitionOpId >= 0 ||
               unit.managedDefinitionOpId < 0:
                cleanupCfgFail(
                    "cleanup_cfg: captured-old definition materialized twice")
            capturedDefinitionOpId = unit.managedDefinitionOpId
            capturedDefinitionSourceDefinitionDomain =
                plan.ownershipActionCapturedOldSourceDefinitionDomains[
                    actionRow]
            capturedDefinitionSourceDefinitionRow =
                plan.ownershipActionCapturedOldSourceDefinitionRows[
                    actionRow]
        elif kind == odir.CleanupActionStoreMove:
            unit = cleanupCfgAppendOwnershipCopyUnit(
                plan,
                bodyIR,
                scopeId,
                actionRow,
                plan.ownershipActionSourceSlots[actionRow],
                plan.ownershipActionTargetSlots[actionRow],
                -1,
                -1,
                1,
                report)
        elif kind == odir.CleanupActionDropPlace ||
             kind == odir.CleanupActionDropField:
            var releaseDefinitionOpId = -1
            if plan.ownershipActionCapturedOldSourceDefinitionRows[
                   actionRow] >= 0:
                if capturedDefinitionOpId < 0 ||
                   plan.ownershipActionCapturedOldSourceDefinitionRows[
                       actionRow] !=
                       capturedDefinitionSourceDefinitionRow ||
                   plan.ownershipActionCapturedOldSourceDefinitionDomains[
                       actionRow] !=
                       capturedDefinitionSourceDefinitionDomain:
                    cleanupCfgFail(
                        "cleanup_cfg: captured-old release edge mismatch")
                releaseDefinitionOpId = capturedDefinitionOpId
                if kind == odir.CleanupActionDropPlace:
                    if capturedDefinitionReleased:
                        cleanupCfgFail(
                            "cleanup_cfg: captured-old whole release duplicated")
                    capturedDefinitionReleased = true
                else:
                    capturedDefinitionProjected = true
            elif (plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                      odir.DefinitionOriginCanonicalSyntheticAction ||
                  plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                      odir.DefinitionOriginTypedExpr) &&
                 plan.ownershipActionIds[actionRow] == 0:
                releaseDefinitionOpId =
                    cleanupCfgMaterializedManagedDefinitionOp(
                        plan,
                        bodyIR,
                        actionRow)
            unit = cleanupCfgAppendOwnershipDropUnit(plan,
                                                      bodyIR,
                                                      scopeId,
                                                      actionRow,
                                                      releaseDefinitionOpId,
                                                      snapshotLiveSlots,
                                                      snapshotSlots,
                                                      report)
        else:
            cleanupCfgFail("cleanup_cfg: ownership op unit kind unsupported")
        if unit.entryBlockId >= 0:
            var noProjectedSlots: int32[]
            cleanupCfgRecordScheduleUnit(
                scheduleDraft,
                bodyIR,
                unitLocalStart,
                unitOpStart,
                unitCallStart,
                unitBlockStart,
                unitTermStart,
                noProjectedSlots)
        cleanupCfgChainOwnershipUnit(bodyIR,
                                     firstBlockIdOut,
                                     tailPatchOut,
                                     unit)
        report.ownershipOpActionCount = cleanupCfgCheckedReportAdd(
            report.ownershipOpActionCount, 1)
    if capturedDefinitionOpId >= 0 &&
       !capturedDefinitionReleased &&
       !capturedDefinitionProjected:
        cleanupCfgFail(
            "cleanup_cfg: captured-old definition lacks release action")

fn cleanupCfgMaterializeOwnershipOpSiteUnits(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        siteIndex: int32,
        firstBlockIdOut: var int32,
        tailPatchOut: var cleanupOwnershipUnitPatch,
        report: var CleanupMaterializeReport,
        scheduleDraft: var cleanupScheduleDraft) =
    firstBlockIdOut = -1
    tailPatchOut = cleanupCfgEmptyOwnershipUnitPatch()
    if siteIndex < 0 ||
       siteIndex >= plan.ownershipOpTransitionSiteStarts.len:
        cleanupCfgFail("cleanup_cfg: ownership op site row invalid")
    let opRowStart =
        plan.ownershipOpTransitionSiteStarts[siteIndex]
    let opRowCount =
        plan.ownershipOpTransitionSiteCounts[siteIndex]
    if opRowStart < 0 || opRowCount <= 0 ||
       opRowStart + opRowCount >
           plan.ownershipOpTransitionOwnershipOpIds.len:
        cleanupCfgFail("cleanup_cfg: ownership op site CSR invalid")
    var actionStart: int32 = -1
    var actionCount: int32
    var transitionStart: int32 = -1
    var transitionCount: int32
    for opOffset in 0..<opRowCount:
        let opRow = opRowStart + opOffset
        let currentActionStart =
            plan.ownershipOpActionStarts[opRow]
        let currentActionCount =
            plan.ownershipOpActionCounts[opRow]
        if currentActionCount > 0:
            if actionStart < 0:
                actionStart = currentActionStart
            elif currentActionStart != actionStart + actionCount:
                cleanupCfgFail(
                    "cleanup_cfg: op-site action range is not contiguous")
            actionCount = actionCount + currentActionCount
        let currentTransitionStart =
            plan.ownershipOpTransitionStarts[opRow]
        let currentTransitionCount =
            plan.ownershipOpTransitionCounts[opRow]
        if currentTransitionCount > 0:
            if transitionStart < 0:
                transitionStart = currentTransitionStart
            elif currentTransitionStart !=
                   transitionStart + transitionCount:
                cleanupCfgFail(
                    "cleanup_cfg: op-site transition range is not contiguous")
            transitionCount = transitionCount +
                currentTransitionCount
    var snapshotLiveSlots: int32[]
    var snapshotSlots: int32[]
    let snapshotSourceStart =
        plan.ownershipOpSiteSnapshotStarts[siteIndex]
    let snapshotSourceCount =
        plan.ownershipOpSiteSnapshotCounts[siteIndex]
    if snapshotSourceStart < 0 || snapshotSourceCount < 0 ||
       snapshotSourceStart + snapshotSourceCount >
           plan.ownershipOpSiteSnapshotSourceSlots.len:
        cleanupCfgFail(
            "cleanup_cfg: ownership op materialization snapshot CSR invalid")
    if snapshotSourceCount > 0:
        var plannedSnapshotLiveSlots: int32[]
        for snapshotOffset in 0..<snapshotSourceCount:
            add(plannedSnapshotLiveSlots,
                plan.ownershipOpSiteSnapshotSourceSlots[
                    snapshotSourceStart + snapshotOffset])
        let snapshotLocalStart = bodyIR.localSlots.len
        let snapshotOpStart = bodyIR.ops.len
        let snapshotCallStart = bodyIR.callSequence.len
        let snapshotBlockStart = bodyIR.blocks.len
        let snapshotTermStart = bodyIR.terms.len
        let snapshotUnit = cleanupCfgAppendOwnershipSnapshotSlotsUnit(
            plan,
            bodyIR,
            scopeId,
            plan.ownershipOpSiteSnapshotSemanticRows[
                snapshotSourceStart],
            plannedSnapshotLiveSlots,
            snapshotLiveSlots,
            snapshotSlots,
            report)
        if snapshotUnit.entryBlockId >= 0:
            cleanupCfgRecordScheduleUnit(
                scheduleDraft,
                bodyIR,
                snapshotLocalStart,
                snapshotOpStart,
                snapshotCallStart,
                snapshotBlockStart,
                snapshotTermStart,
                snapshotSlots)
            cleanupCfgChainOwnershipUnit(
                bodyIR,
                firstBlockIdOut,
                tailPatchOut,
                snapshotUnit)
    for opOffset in 0..<opRowCount:
        var opFirstBlockId = -1
        var opTailPatch = cleanupCfgEmptyOwnershipUnitPatch()
        cleanupCfgMaterializeOwnershipOpActionUnits(
            plan,
            bodyIR,
            scopeId,
            opRowStart + opOffset,
            snapshotLiveSlots,
            snapshotSlots,
            opFirstBlockId,
            opTailPatch,
            report,
            scheduleDraft)
        if opFirstBlockId < 0:
            continue
        if firstBlockIdOut < 0:
            firstBlockIdOut = opFirstBlockId
        if tailPatchOut.entryBlockId >= 0:
            cleanupCfgPatchOwnershipUnit(bodyIR,
                                         tailPatchOut,
                                         opFirstBlockId,
                                         coreir.BodyControlEdgeNormal)
        tailPatchOut = opTailPatch
    if transitionCount > 0:
        let unitLocalStart = bodyIR.localSlots.len
        let unitOpStart = bodyIR.ops.len
        let unitCallStart = bodyIR.callSequence.len
        let unitBlockStart = bodyIR.blocks.len
        let unitTermStart = bodyIR.terms.len
        let transitionUnit =
            cleanupCfgAppendOwnershipOpTransitionUnit(
                plan,
                bodyIR,
                scopeId,
                transitionStart,
                transitionCount,
                report)
        var noProjectedSlots: int32[]
        cleanupCfgRecordScheduleUnit(
            scheduleDraft,
            bodyIR,
            unitLocalStart,
            unitOpStart,
            unitCallStart,
            unitBlockStart,
            unitTermStart,
            noProjectedSlots)
        cleanupCfgChainOwnershipUnit(
            bodyIR,
            firstBlockIdOut,
            tailPatchOut,
            transitionUnit)
    if firstBlockIdOut < 0 || tailPatchOut.entryBlockId < 0:
        cleanupCfgFail(
            "cleanup_cfg: ownership op site has no materialized unit")

fn cleanupCfgPrepareOwnershipOpSites(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        report: var CleanupMaterializeReport,
        scheduleDraft: var cleanupScheduleDraft) =
    let siteCount = plan.ownershipOpTransitionSiteStarts.len
    if siteCount <= 0:
        return
    let originalOpCount = bodyIR.ops.len
    let originalBlockCount = bodyIR.blocks.len
    var originalBlockStarts: int32[]
    var originalBlockCounts: int32[]
    var originalBlockTerms: int32[]
    var blockOriginalIds: int32[]
    var physicalSourceByOriginalBlock: int32[]
    for blockIndex in 0..<originalBlockCount:
        add(originalBlockStarts, bodyIR.blocks[blockIndex].opStart)
        add(originalBlockCounts, bodyIR.blocks[blockIndex].opCount)
        add(originalBlockTerms, bodyIR.blocks[blockIndex].termIndex)
        add(blockOriginalIds, blockIndex)
        add(physicalSourceByOriginalBlock, blockIndex)
    var activationOriginalBlockIds: int32[]
    var activationOriginalAfterOpOrdinals: int32[]
    for siteId in 0..<bodyIR.deferActivationSiteBlockIds.len:
        add(activationOriginalBlockIds,
            bodyIR.deferActivationSiteBlockIds[siteId])
        add(activationOriginalAfterOpOrdinals,
            bodyIR.deferActivationSiteAfterOpOrdinals[siteId])
    var siteByOp: int32[]
    for _ in 0..<originalOpCount:
        add(siteByOp, -1)
    for siteIndex in 0..<siteCount:
        let blockId = plan.ownershipOpTransitionBodyBlockIds[siteIndex]
        if blockId < 0 || blockId >= originalBlockCount:
            cleanupCfgFail("cleanup_cfg: ownership op source block drift")
        let opIndex = cleanupCfgCheckedAdd(
            originalBlockStarts[blockId],
            plan.ownershipOpTransitionAfterOpOrdinals[siteIndex],
            "cleanup_cfg: ownership op site row overflow")
        if opIndex < 0 || opIndex >= originalOpCount ||
           siteByOp[opIndex] >= 0:
            cleanupCfgFail("cleanup_cfg: ownership op materialization site drift")
        siteByOp[opIndex] = siteIndex

    for blockIndex in 0..<originalBlockCount:
        let originalStart = originalBlockStarts[blockIndex]
        let originalEnd = cleanupCfgCheckedAdd(
            originalStart,
            originalBlockCounts[blockIndex],
            "cleanup_cfg: ownership op source block end overflow")
        var segmentBlockId = blockIndex
        var splitCount: int32
        for opIndex in originalStart..<originalEnd:
            let siteIndex = siteByOp[opIndex]
            if siteIndex < 0:
                continue
            # [wall129] 块尾 split（w126b 移交墙的域内修法，r1 实烤证伪
            # 「事后重排」路线：cleanup sealed 契约 CoverageValid 的块扫描
            # （位置≥originalBlockCount 必须是 unit 成员或 owner 锚）与 CFG
            # 数组序=op 分区门联立后，中块 split 的 continuation（持有前段
            # op 行）恒迫使非锚 original 块落入扫描区，任何重排无解）。改
            # 为 split 点=块尾：prefix 的 opStart/opCount 零改动（零 op 迁
            # 移、零行系变化），continuation 为空载体仅携带原 term、opStart
            # 取 ops.len（cleanupCfgAppendReturnBlock 同款空块先例，保证追
            # 加区按 (opStart,旧序) 稳定排序后无缝全覆盖分区），unit 链插
            # 在块尾与 term 之间。ownership transition unit 只写合成 flag
            # 槽（原 op 零引用）、块内无出口边，块尾放置与中块放置在块粒
            # 度数据流上恒等且先于全部后继 flag 读点（支配性不变）。
            var bridge: coreir.BodyTerm
            coreir.BodyIRApplyBodyTermDefaultProof(bridge)
            bridge.kind = coreir.BodyTermBrTag
            bridge.trueBlock = -1
            let bridgeTermIndex = cleanupCfgAppendTermExact(
                bodyIR, bridge, 1, -1,
                coreir.BodyControlEdgeNormal,
                -1, coreir.BodyControlEdgeUnknown)
            bodyIR.blocks[segmentBlockId].termIndex = bridgeTermIndex
            report.materializedTermCount = cleanupCfgCheckedReportAdd(
                report.materializedTermCount, 1)
            let continuationStart = bodyIR.ops.len
            let continuationCount: int32
            while blockOriginalIds.len < bodyIR.blocks.len:
                add(blockOriginalIds, -1)
            let continuationBlockId = cleanupCfgAppendBlockExact(
                bodyIR,
                continuationStart,
                continuationCount,
                originalBlockTerms[blockIndex],
                bodyIR.blockScopeIds[blockIndex])
            if continuationBlockId != blockOriginalIds.len:
                cleanupCfgFail(
                    "cleanup_cfg: continuation block origin row drift")
            add(blockOriginalIds, blockIndex)
            report.materializedBlockCount = cleanupCfgCheckedReportAdd(
                report.materializedBlockCount, 1)
            if siteIndex !=
                   scheduleDraft.sitePhysicalSourceBlockIds.len:
                cleanupCfgFail(
                    "cleanup_cfg: ownership op site order drift")
            add(scheduleDraft.sitePhysicalSourceBlockIds,
                segmentBlockId)
            add(scheduleDraft.siteSourceTermRows,
                bridgeTermIndex)
            add(scheduleDraft.siteSourceSuccessorOrdinals, 0)
            add(scheduleDraft.siteFinalContinuationBlockIds,
                continuationBlockId)
            add(scheduleDraft.siteFinalEdgeKinds,
                coreir.BodyControlEdgeNormal)
            segmentBlockId = continuationBlockId
            splitCount = cleanupCfgCheckedAdd(
                splitCount,
                1,
                "cleanup_cfg: ownership source split count overflow")
        if splitCount > 0:
            for exitId in 0..<plan.exitOriginalSourceBlockIds.len:
                if plan.exitOriginalSourceBlockIds[exitId] == blockIndex:
                    if plan.exitPhysicalSourceBlockIds[exitId] != blockIndex:
                        cleanupCfgFail(
                            "cleanup_cfg: physical source identity drift before split")
                    plan.exitPhysicalSourceBlockIds[exitId] = segmentBlockId
        physicalSourceByOriginalBlock[blockIndex] = segmentBlockId
    for exitId in 0..<plan.exitOriginalSourceBlockIds.len:
        let originalSourceBlockId =
            plan.exitOriginalSourceBlockIds[exitId]
        if originalSourceBlockId < 0 ||
           originalSourceBlockId >= physicalSourceByOriginalBlock.len ||
           plan.exitPhysicalSourceBlockIds[exitId] !=
               physicalSourceByOriginalBlock[originalSourceBlockId]:
            cleanupCfgFail(
                "cleanup_cfg: physical source identity unsynchronized")
    while blockOriginalIds.len < bodyIR.blocks.len:
        add(blockOriginalIds, -1)
    for siteId in 0..<activationOriginalBlockIds.len:
        let originalBlockId = activationOriginalBlockIds[siteId]
        let originalAfterOpOrdinal =
            activationOriginalAfterOpOrdinals[siteId]
        if originalBlockId < 0 ||
           originalBlockId >= originalBlockCount ||
           originalAfterOpOrdinal < 0 ||
           originalAfterOpOrdinal >
               originalBlockCounts[originalBlockId]:
            cleanupCfgFail(
                "cleanup_cfg: activation site source boundary invalid")
        let absoluteBoundary = cleanupCfgCheckedAdd(
            originalBlockStarts[originalBlockId],
            originalAfterOpOrdinal,
            "cleanup_cfg: activation site boundary overflow")
        var mappedBlockId = -1
        var mappedAfterOpOrdinal = -1
        for candidateBlockId in 0..<blockOriginalIds.len:
            if blockOriginalIds[candidateBlockId] != originalBlockId:
                continue
            let candidateStart = bodyIR.blocks[candidateBlockId].opStart
            let candidateCount = bodyIR.blocks[candidateBlockId].opCount
            let candidateEnd = cleanupCfgCheckedAdd(
                candidateStart,
                candidateCount,
                "cleanup_cfg: activation segment end overflow")
            let atInitialBoundary =
                originalAfterOpOrdinal == 0 &&
                candidateStart ==
                    originalBlockStarts[originalBlockId]
            let insideSegment =
                absoluteBoundary > candidateStart &&
                absoluteBoundary <= candidateEnd
            if atInitialBoundary || insideSegment:
                if mappedBlockId >= 0:
                    cleanupCfgFail(
                        "cleanup_cfg: activation site boundary ambiguous")
                mappedBlockId = candidateBlockId
                mappedAfterOpOrdinal = cleanupCfgCheckedSub(
                    absoluteBoundary,
                    candidateStart,
                    "cleanup_cfg: activation site ordinal underflow")
        if mappedBlockId < 0:
            cleanupCfgFail(
                "cleanup_cfg: activation site boundary not materialized")
        bodyIR.deferActivationSiteBlockIds[siteId] = mappedBlockId
        bodyIR.deferActivationSiteAfterOpOrdinals[siteId] =
            mappedAfterOpOrdinal
    coreir.BodyIRClearFrameLayoutCache(bodyIR)

fn cleanupCfgMaterializePreparedOwnershipOpSites(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        report: var CleanupMaterializeReport,
        scheduleDraft: var cleanupScheduleDraft) =
    let siteCount = plan.ownershipOpTransitionSiteStarts.len
    if scheduleDraft.sitePhysicalSourceBlockIds.len != siteCount ||
       scheduleDraft.siteSourceTermRows.len != siteCount ||
       scheduleDraft.siteSourceSuccessorOrdinals.len != siteCount ||
       scheduleDraft.siteFinalContinuationBlockIds.len != siteCount ||
       scheduleDraft.siteFinalEdgeKinds.len != siteCount:
        cleanupCfgFail(
            "cleanup_cfg: prepared ownership op site shape invalid")
    for siteIndex in 0..<siteCount:
        let sourceBlockId =
            scheduleDraft.sitePhysicalSourceBlockIds[siteIndex]
        let sourceTermRow =
            scheduleDraft.siteSourceTermRows[siteIndex]
        let finalContinuationBlockId =
            scheduleDraft.siteFinalContinuationBlockIds[siteIndex]
        if sourceBlockId < 0 || sourceBlockId >= bodyIR.blocks.len ||
           bodyIR.blocks[sourceBlockId].termIndex != sourceTermRow ||
           finalContinuationBlockId < 0 ||
           finalContinuationBlockId >= bodyIR.blocks.len:
            cleanupCfgFail(
                "cleanup_cfg: prepared ownership op site anchor invalid")
        var firstRuntimeBlock = -1
        var tailPatch = cleanupCfgEmptyOwnershipUnitPatch()
        cleanupCfgMaterializeOwnershipOpSiteUnits(
            plan,
            bodyIR,
            bodyIR.blockScopeIds[sourceBlockId],
            siteIndex,
            firstRuntimeBlock,
            tailPatch,
            report,
            scheduleDraft)
        if firstRuntimeBlock < 0 || tailPatch.entryBlockId < 0:
            cleanupCfgFail(
                "cleanup_cfg: ownership op site has no unit")
        var bridgeReplacement: coreir.BodyTerm
        coreir.BodyIRApplyBodyTermDefaultProof(bridgeReplacement)
        bridgeReplacement.kind = coreir.BodyTermBrTag
        bridgeReplacement.trueBlock = firstRuntimeBlock
        cleanupCfgReplaceTermExact(
            bodyIR,
            sourceTermRow,
            bridgeReplacement,
            1,
            firstRuntimeBlock,
            coreir.BodyControlEdgeNormal,
            -1,
            coreir.BodyControlEdgeUnknown)
        cleanupCfgPatchOwnershipUnit(
            bodyIR,
            tailPatch,
            finalContinuationBlockId,
            coreir.BodyControlEdgeNormal)

fn cleanupCfgRewriteSourceEdge(bodyIR: var coreir.BodyIR,
                               blockId: int32,
                               successorOrdinal: int32,
                               targetBlockId: int32) =
    let termIndex = bodyIR.blocks[blockId].termIndex
    var term = cleanupCfgReadBodyTermValue(bodyIR, termIndex)
    var successorCount: int32
    var successor0: int32 = -1
    var successor1: int32 = -1
    var edgeKind0 = coreir.BodyControlEdgeUnknown
    var edgeKind1 = coreir.BodyControlEdgeUnknown
    if term.kind == coreir.BodyTermReturnTag:
        if successorOrdinal != 0:
            cleanupCfgFail("cleanup_cfg: return successor ordinal invalid")
        var branch: coreir.BodyTerm
        coreir.BodyIRApplyBodyTermDefaultProof(branch)
        branch.kind = coreir.BodyTermBrTag
        branch.trueBlock = targetBlockId
        term = branch
        successorCount = 1
        successor0 = targetBlockId
        edgeKind0 = coreir.BodyControlEdgeNormal
    elif term.kind == coreir.BodyTermBrTag:
        if successorOrdinal != 0:
            cleanupCfgFail("cleanup_cfg: branch successor ordinal invalid")
        term.trueBlock = targetBlockId
        successorCount = 1
        successor0 = targetBlockId
        edgeKind0 = coreir.BodyControlEdgeNormal
    elif term.kind == coreir.BodyTermCbrTag:
        let originalEdgeKind0 =
            cleanupCfgControlTermEdgeKind(bodyIR, termIndex, 0)
        let originalEdgeKind1 =
            cleanupCfgControlTermEdgeKind(bodyIR, termIndex, 1)
        if successorOrdinal == 0:
            term.trueBlock = targetBlockId
            edgeKind0 = coreir.BodyControlEdgeNormal
            edgeKind1 = originalEdgeKind1
        elif successorOrdinal == 1:
            term.falseBlock = targetBlockId
            edgeKind0 = originalEdgeKind0
            edgeKind1 = coreir.BodyControlEdgeNormal
        else:
            cleanupCfgFail("cleanup_cfg: conditional successor ordinal invalid")
        successorCount = 2
        successor0 = term.trueBlock
        successor1 = term.falseBlock
    else:
        cleanupCfgFail("cleanup_cfg: source edge term unsupported")
    cleanupCfgReplaceTermExact(
        bodyIR,
        termIndex,
        term,
        successorCount,
        successor0,
        edgeKind0,
        successor1,
        edgeKind1)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)

fn cleanupCfgAppendReturnBlock(bodyIR: var coreir.BodyIR,
                               scopeId: int32,
                               snapshotSlot: int32,
                               sourceDefinitionDomain: int32,
                               sourceDefinitionRow: int32,
                               report: var CleanupMaterializeReport): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = snapshotSlot
    term.sourceDefinitionDomain = sourceDefinitionDomain
    term.sourceDefinitionRow = sourceDefinitionRow
    let termIndex = cleanupCfgAppendTermExact(
        bodyIR, term, 0, -1, coreir.BodyControlEdgeUnknown,
        -1, coreir.BodyControlEdgeUnknown)
    let blockId = cleanupCfgAppendBlockExact(
        bodyIR, bodyIR.ops.len, 0, termIndex, scopeId)
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    return blockId

fn cleanupCfgAppendReturnSnapshotBlock(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        exitId: int32,
        snapshotTermIndexOut: var int32,
        report: var CleanupMaterializeReport): int32 =
    cleanupCfgRequireExitSnapshotBinding(plan, exitId)
    let snapshotKind = plan.exitReturnSnapshotKinds[exitId]
    let sourceSlot = plan.exitReturnSourceSlots[exitId]
    let snapshotSlot = plan.exitReturnSnapshotSlots[exitId]
    # wall64：plan 行是原始坐标系（指纹门保护），材料化消费必须按插入
    # 基址平移到物理坐标系——此前裸读平移前的行是本墙死点（r1 判词
    # 实证 ops[30] 为无 value-def 身份的错位行）。
    var sourceDefinitionDomain: int32
    var sourceDefinitionRow: int32
    cleanupCfgRelocatePlanDefinitionCoordinate(
        plan,
        bodyIR,
        plan.exitReturnSourceDefinitionDomains[exitId],
        plan.exitReturnSourceDefinitionRows[exitId],
        sourceDefinitionDomain,
        sourceDefinitionRow)
    let resultExprNodeIndex =
        plan.exitReturnExprNodeIndexes[exitId]
    let resultValueDefinitionRow =
        plan.exitReturnValueDefinitionRows[exitId]
    if snapshotKind == CleanupReturnSnapshotNone:
        cleanupCfgFail("cleanup_cfg: missing structured return snapshot")
    let opStart = bodyIR.ops.len
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.target = snapshotSlot
    if snapshotKind == CleanupReturnSnapshotUnmanagedCopy:
        op.kind = coreir.BodyOpCopyLocalTag
        add(op.operands, sourceSlot)
    else:
        let actionRow = plan.exitOwnershipActionStarts[exitId]
        if actionRow < 0 ||
           actionRow >= plan.ownershipActionKinds.len ||
           sourceDefinitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           sourceDefinitionRow < 0 ||
           sourceDefinitionRow >= bodyIR.ops.len:
            cleanupCfgFail(
                "cleanup_cfg: owned return source value-def authority invalid")
        # wall71：此处必须用 let。托管 struct 元素的 var 读出是 move 语义
        # （探针 zz_probe_w71 实证：var 读出后源行整行置默认，let 读出源行
        # 保留）——var 读出会把行 31（owned return 源定义 op）就地清空，
        # D 后验按 value-def 身份读同一行即 initialized producer
        # definition drift 全零行；A 点纯读消费，let 逐字保源。
        let sourceDefinition =
            bodyIR.ops[sourceDefinitionRow]
        # wall64 判词富化：owned return value-def 11 路联判逐项取数（守卫
        # 零弱化，各路纯读无副作用，c1..c11 与原联判逐字同构，仅失败臂取数）。
        let diagOwnedSourceMismatch1 =
            sourceDefinition.valueDefOwnership != coreir.OwnMove
        let diagOwnedSourceMismatch2 =
            sourceDefinition.valueDefSemanticRow < 0
        let diagOwnedSourceMismatch3 =
            sourceDefinition.valueDefSlot != sourceSlot
        let diagOwnedSourceMismatch4 =
            sourceDefinition.valueDefOriginKind ==
                coreir.BodyDefinitionOriginUnknownTag
        let diagOwnedSourceMismatch5 =
            sourceDefinition.valueDefOriginId < 0
        let diagOwnedSourceMismatch6 = resultExprNodeIndex < 0
        let diagOwnedSourceMismatch7 = resultValueDefinitionRow < 0
        let diagOwnedSourceMismatch8 =
            sourceDefinition.valueDefExprNodeIndex != resultExprNodeIndex
        let diagOwnedSourceMismatch9 =
            sourceDefinition.valueDefSemanticRow !=
                resultValueDefinitionRow
        let diagOwnedSourceMismatch10 =
            sourceDefinition.valueDefOriginId != resultValueDefinitionRow
        let diagOwnedSourceMismatch11 =
            plan.exitReturnOwnershipKinds[exitId] != odir.Owned
        if diagOwnedSourceMismatch1 || diagOwnedSourceMismatch2 ||
           diagOwnedSourceMismatch3 || diagOwnedSourceMismatch4 ||
           diagOwnedSourceMismatch5 || diagOwnedSourceMismatch6 ||
           diagOwnedSourceMismatch7 || diagOwnedSourceMismatch8 ||
           diagOwnedSourceMismatch9 || diagOwnedSourceMismatch10 ||
           diagOwnedSourceMismatch11:
            cleanupCfgFail(
                Fmt"cleanup_cfg: owned return source value-def mismatch exit={exitId} snap={int32(snapshotKind)} dom={sourceDefinitionDomain} oprow={sourceDefinitionRow} src={sourceSlot} snap_slot={snapshotSlot} own={int32(sourceDefinition.valueDefOwnership)} semrow={sourceDefinition.valueDefSemanticRow} slot={sourceDefinition.valueDefSlot} okind={int32(sourceDefinition.valueDefOriginKind)} oid={sourceDefinition.valueDefOriginId} eni={sourceDefinition.valueDefExprNodeIndex} plan_eni={resultExprNodeIndex} plan_vdr={resultValueDefinitionRow} plan_own={int32(plan.exitReturnOwnershipKinds[exitId])} cop={sourceDefinition.valueDefConsumeOpIndexPlusOne} car={sourceDefinition.consumeActionRow} actions={plan.ownershipActionKinds.len} c1={diagOwnedSourceMismatch1} c2={diagOwnedSourceMismatch2} c3={diagOwnedSourceMismatch3} c4={diagOwnedSourceMismatch4} c5={diagOwnedSourceMismatch5} c6={diagOwnedSourceMismatch6} c7={diagOwnedSourceMismatch7} c8={diagOwnedSourceMismatch8} c9={diagOwnedSourceMismatch9} c10={diagOwnedSourceMismatch10} c11={diagOwnedSourceMismatch11}")
        if sourceDefinition.valueDefConsumeOpIndexPlusOne != 0 ||
           sourceDefinition.consumeActionRow != -1:
            cleanupCfgFail(
                "cleanup_cfg: owned return source already consumed")
        var call: coreir.CallOp
        coreir.BodyIRApplyCallOpDefaultProof(call)
        call.targetSymbol = cleanupCfgOwnedTextCopy(
            plan.exitReturnSnapshotGlueSymbols[exitId])
        call.resultSlot = snapshotSlot
        call.resultPassKind = coreir.BodyCallPassSretResultTag
        call.resultOwnership = coreir.OwnMove
        call.resultExprNodeIndex = resultExprNodeIndex
        call.resultValueDefinitionRow =
            resultValueDefinitionRow
        call.resultDefinitionOriginKind =
            coreir.BodyDefinitionOriginCanonicalCleanupActionTag
        call.resultDefinitionOriginId = actionRow
        call.sourceDefinitionDomain = sourceDefinitionDomain
        call.sourceDefinitionRow = sourceDefinitionRow
        if snapshotKind == CleanupReturnSnapshotOwnedRetain:
            call.managedStoreKind =
                coreir.ManagedStoreSnapshotRetainTag
        else:
            call.managedStoreKind =
                coreir.ManagedStoreSnapshotCloneTag
        call.relocWordOffset = -1
        call.targetIsImportc = false
        add(call.argSlots, coreir.CallArgSlotAddress(sourceSlot))
        add(call.argPassKinds, coreir.BodyCallPassByAddressAggregateTag)
        add(call.argAbiSizes, 8)
        let runtimeActionKind =
            if snapshotKind == CleanupReturnSnapshotOwnedRetain:
                CleanupRuntimeIntrinsicSnapshotRetainTag
            else:
                CleanupRuntimeIntrinsicSnapshotCloneTag
        let snapshotTypeRow =
            cleanupCfgPlanTypeLayoutRow(
                plan,
                plan.exitReturnOwnershipTypeIds[exitId])
        let snapshotTypeArenaTypeId =
            plan.typeLayoutTypeArenaTypeIds[snapshotTypeRow]
        let runtimeTargetCid =
            cleanupCfgRuntimeIntrinsicInterfaceCid(
                bodyIR,
                call,
                runtimeActionKind,
                snapshotTypeArenaTypeId)
        let callOrdinal = cleanupCfgAppendCallWithTarget(
            bodyIR,
            call,
            coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
            0,
            runtimeTargetCid)
        op.kind = coreir.BodyOpCallTag
        op.valueDefSlot = snapshotSlot
        op.valueDefExprNodeIndex = resultExprNodeIndex
        op.valueDefSemanticRow =
            resultValueDefinitionRow
        op.valueDefOwnership = coreir.OwnMove
        op.valueDefOriginKind =
            coreir.BodyDefinitionOriginCanonicalCleanupActionTag
        op.valueDefOriginId = actionRow
        op.sourceDefinitionDomain = sourceDefinitionDomain
        op.sourceDefinitionRow = sourceDefinitionRow
        add(op.operands, callOrdinal)
        report.materializedCallCount = cleanupCfgCheckedReportAdd(
            report.materializedCallCount,
            1)
        report.materializedCallArgCount = cleanupCfgCheckedReportAdd(
            report.materializedCallArgCount,
            2)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    var next: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(next)
    next.kind = coreir.BodyTermBrTag
    next.trueBlock = -1
    snapshotTermIndexOut = cleanupCfgAppendTermExact(
        bodyIR, next, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let blockId = cleanupCfgAppendBlockExact(
        bodyIR, opStart, 1, snapshotTermIndexOut, scopeId)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount,
        1)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount,
        1)
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return blockId

fn cleanupCfgEnsureFragmentCStrings(plan: var CleanupPlan,
                                    bodyIR: var coreir.BodyIR,
                                    fragmentId: int32,
                                    report: var CleanupMaterializeReport) =
    setLen(plan.scratchCStringMap, 0)
    let start = plan.fragmentCStringStarts[fragmentId]
    let count = plan.fragmentCStringCounts[fragmentId]
    for offset in 0..<count:
        let row = cleanupCfgCheckedAdd(
            start,
            offset,
            "cleanup_cfg: fragment cstring row overflow")
        var outputId = plan.materializedCStringIds[row]
        if outputId < 0:
            outputId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                         plan.cstringTexts[row],
                                                         plan.cstringDataLabels[row])
            plan.materializedCStringIds[row] = outputId
            report.materializedCStringCount = cleanupCfgCheckedReportAdd(
                report.materializedCStringCount,
                1)
        add(plan.scratchCStringMap, outputId)

fn cleanupCfgRemapCStringArg(plan: var CleanupPlan,
                             argSlot: int32): int32 =
    if !coreir.CallArgSlotIsCString(argSlot):
        return argSlot
    let localId = coreir.CallArgSlotCStringId(argSlot)
    if localId < 0 || localId >= plan.scratchCStringMap.len:
        cleanupCfgFail("cleanup_cfg: fragment call cstring out of range")
    return coreir.CallArgSlotCString(plan.scratchCStringMap[localId])

@borrows
fn cleanupCfgFragmentManagedStoreKindForOp(
        plan: var CleanupPlan,
        fragmentId: int32,
        opRow: int32): int32 =
    let opStart = plan.fragmentOpStarts[fragmentId]
    let opCount = plan.fragmentOpCounts[fragmentId]
    let opEnd = cleanupCfgCheckedAdd(
        opStart,
        opCount,
        "cleanup_cfg: fragment managed-store op range overflow")
    if opRow < opStart || opRow >= opEnd:
        cleanupCfgFail(
            "cleanup_cfg: fragment managed-store op row out of range")
    if plan.opKinds[opRow] != coreir.BodyOpCallTag:
        return coreir.ManagedStoreNoneTag
    let operandStart = plan.opOperandStarts[opRow]
    if plan.opOperandCounts[opRow] != 1 ||
       operandStart < 0 || operandStart >= plan.opOperands.len:
        cleanupCfgFail(
            "cleanup_cfg: fragment managed-store call operand invalid")
    let localCallOrdinal = plan.opOperands[operandStart]
    let callCount = plan.fragmentCallCounts[fragmentId]
    if localCallOrdinal < 0 || localCallOrdinal >= callCount:
        cleanupCfgFail(
            "cleanup_cfg: fragment managed-store call row out of range")
    let callRow = cleanupCfgCheckedAdd(
        plan.fragmentCallStarts[fragmentId],
        localCallOrdinal,
        "cleanup_cfg: fragment managed-store call row overflow")
    return plan.callManagedStoreKinds[callRow]

fn cleanupCfgAppendFragmentCalls(plan: var CleanupPlan,
                                 bodyIR: var coreir.BodyIR,
                                 fragmentId: int32,
                                 outputOpBase: int32,
                                 report: var CleanupMaterializeReport): int32 =
    let outputCallBase = bodyIR.callSequence.len
    let start = plan.fragmentCallStarts[fragmentId]
    let count = plan.fragmentCallCounts[fragmentId]
    for offset in 0..<count:
        let row = cleanupCfgCheckedAdd(
            start,
            offset,
            "cleanup_cfg: fragment call row overflow")
        var call: coreir.CallOp
        coreir.BodyIRApplyCallOpDefaultProof(call)
        call.targetSymbol = plan.callTargetSymbols[row]
        call.targetSourcePath = plan.callTargetSourcePaths[row]
        call.resultSlot = plan.callResultSlots[row]
        call.resultPassKind = plan.callResultPassKinds[row]
        call.resultOwnership = plan.callResultOwnershipKinds[row]
        call.resultExprNodeIndex = plan.callResultExprNodeIndexes[row]
        call.resultValueDefinitionRow =
            plan.callResultValueDefinitionRows[row]
        call.resultBorrowOwnerValueDefinitionRow =
            plan.callResultBorrowOwnerValueDefinitionRows[row]
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            plan.callResultBorrowOwnerDefinitionDomains[row],
            plan.callResultBorrowOwnerDefinitionRows[row],
            outputOpBase,
            plan.fragmentOpCounts[fragmentId],
            call.resultBorrowOwnerDefinitionDomain,
            call.resultBorrowOwnerDefinitionRow)
        call.resultDefinitionOriginKind =
            plan.callResultDefinitionOriginKinds[row]
        call.resultDefinitionOriginId =
            plan.callResultDefinitionOriginIds[row]
        let localSourceDefinitionDomain =
            plan.callSourceDefinitionDomains[row]
        let localSourceDefinitionRow =
            plan.callSourceDefinitionRows[row]
        cleanupCfgRelocateDefinitionCoordinate(
            bodyIR,
            localSourceDefinitionDomain,
            localSourceDefinitionRow,
            outputOpBase,
            plan.fragmentOpCounts[fragmentId],
            call.sourceDefinitionDomain,
            call.sourceDefinitionRow)
        call.semanticCallExprNodeIndex =
            plan.callSemanticCallExprNodeIndexes[row]
        call.managedStoreKind = plan.callManagedStoreKinds[row]
        let localConsumeActionRow = plan.callConsumeActionRows[row]
        call.consumeActionRow = localConsumeActionRow
        if cleanupCfgManagedLvalueReplaceMoveKind(
               call.managedStoreKind):
            if localConsumeActionRow < 0 ||
               localConsumeActionRow >=
                   plan.fragmentOpCounts[fragmentId]:
                cleanupCfgFail(
                    "cleanup_cfg: fragment CallOp consume row out of range")
            call.consumeActionRow = cleanupCfgCheckedAdd(
                outputOpBase,
                localConsumeActionRow,
                "cleanup_cfg: fragment CallOp consume row overflow")
        call.relocWordOffset = plan.callRelocWordOffsets[row]
        call.targetIsImportc = plan.callTargetIsImportcs[row]
        call.inlineF64FromIntKind = plan.callInlineF64FromIntKinds[row]
        call.wholeCallF64FromIntRescue = plan.callWholeCallF64FromIntRescues[row]
        call.inlineF64FromIntUnsigned = plan.callInlineF64FromIntUnsigneds[row]
        let argStart = plan.callArgStarts[row]
        let argCount = plan.callArgCounts[row]
        for argOffset in 0..<argCount:
            let argRow = cleanupCfgCheckedAdd(
                argStart,
                argOffset,
                "cleanup_cfg: fragment call arg row overflow")
            add(call.argSlots,
                cleanupCfgRemapCStringArg(
                    plan,
                    plan.callArgSlots[argRow]))
            add(call.argPassKinds, plan.callArgPassKinds[argRow])
        let abiStart = plan.callArgAbiStarts[row]
        let abiCount = plan.callArgAbiCounts[row]
        for abiOffset in 0..<abiCount:
            let abiRow = cleanupCfgCheckedAdd(
                abiStart,
                abiOffset,
                "cleanup_cfg: fragment call ABI row overflow")
            add(call.argAbiSizes, plan.callArgAbiSizes[abiRow])
        let appendedCallOrdinal = cleanupCfgAppendCallWithTarget(
            bodyIR,
            call,
            plan.callTargetDomainKinds[row],
            plan.callTargetRows[row],
            plan.callTargetInterfaceCids[row])
        if appendedCallOrdinal != outputCallBase + offset:
            cleanupCfgFail(
                "cleanup_cfg: fragment call ordinal drift")
        report.materializedCallCount = cleanupCfgCheckedReportAdd(
            report.materializedCallCount,
            1)
        report.materializedCallArgCount = cleanupCfgCheckedReportAdd(
            report.materializedCallArgCount,
            cleanupCfgCheckedAdd(
                argCount,
                abiCount,
                "cleanup_cfg: fragment call arg report overflow"))
    return outputCallBase

fn cleanupCfgFragmentOp(plan: var CleanupPlan,
                        bodyIR: var coreir.BodyIR,
                        fragmentId: int32,
                        opRow: int32,
                        localCallBase: int32,
                        outputOpBase: int32): coreir.BodyOp =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = plan.opKinds[opRow]
    op.target = plan.opTargets[opRow]
    op.valueDefSlot = plan.opValueDefSlots[opRow]
    op.valueDefExprNodeIndex = plan.opValueDefExprNodeIndexes[opRow]
    op.valueDefSemanticRow = plan.opValueDefSemanticRows[opRow]
    op.valueDefOwnership = plan.opValueDefOwnershipKinds[opRow]
    op.valueDefBorrowOwnerSemanticRow =
        plan.opValueDefBorrowOwnerSemanticRows[opRow]
    cleanupCfgRelocateDefinitionCoordinate(
        bodyIR,
        plan.opValueDefBorrowOwnerDefinitionDomains[opRow],
        plan.opValueDefBorrowOwnerDefinitionRows[opRow],
        outputOpBase,
        plan.fragmentOpCounts[fragmentId],
        op.valueDefBorrowOwnerDefinitionDomain,
        op.valueDefBorrowOwnerDefinitionRow)
    op.valueDefOriginKind = plan.opValueDefOriginKinds[opRow]
    op.valueDefOriginId = plan.opValueDefOriginIds[opRow]
    cleanupCfgRelocateDefinitionCoordinate(
        bodyIR,
        plan.opSourceDefinitionDomains[opRow],
        plan.opSourceDefinitionRows[opRow],
        outputOpBase,
        plan.fragmentOpCounts[fragmentId],
        op.sourceDefinitionDomain,
        op.sourceDefinitionRow)
    let localConsumeActionRow = plan.opConsumeActionRows[opRow]
    let localConsumePlusOne =
        plan.opValueDefConsumeOpIndexPlusOnes[opRow]
    var relocatedConsumeActionRow: int32 = -1
    if cleanupCfgManagedLvalueReplaceMoveKind(
           cleanupCfgFragmentManagedStoreKindForOp(
               plan, fragmentId, opRow)):
        relocatedConsumeActionRow =
            opRow - plan.fragmentOpStarts[fragmentId]
    if localConsumePlusOne > 0:
        let consumeOpRow = cleanupCfgCheckedAdd(
            plan.fragmentOpStarts[fragmentId],
            localConsumePlusOne - 1,
            "cleanup_cfg: fragment consume op row overflow")
        if cleanupCfgManagedLvalueReplaceMoveKind(
               cleanupCfgFragmentManagedStoreKindForOp(
                   plan, fragmentId, consumeOpRow)):
            let localConsumeOpRow = localConsumePlusOne - 1
            if relocatedConsumeActionRow >= 0 &&
               relocatedConsumeActionRow != localConsumeOpRow:
                cleanupCfgFail(
                    "cleanup_cfg: fragment BodyOp consume roles conflict")
            relocatedConsumeActionRow = localConsumeOpRow
    op.consumeActionRow = localConsumeActionRow
    if relocatedConsumeActionRow >= 0:
        if localConsumeActionRow != relocatedConsumeActionRow:
            cleanupCfgFail(
                "cleanup_cfg: fragment BodyOp consume row out of range")
        op.consumeActionRow = cleanupCfgCheckedAdd(
            outputOpBase,
            localConsumeActionRow,
            "cleanup_cfg: fragment BodyOp consume row overflow")
    if localConsumePlusOne > 0:
        op.valueDefConsumeOpIndexPlusOne = outputOpBase + localConsumePlusOne
    let operandStart = plan.opOperandStarts[opRow]
    let operandCount = plan.opOperandCounts[opRow]
    for operandOffset in 0..<operandCount:
        let operandRow = cleanupCfgCheckedAdd(
            operandStart,
            operandOffset,
            "cleanup_cfg: fragment op operand row overflow")
        var operand = plan.opOperands[operandRow]
        if op.kind == coreir.BodyOpCallTag && operandOffset == 0:
            operand = cleanupCfgCheckedAdd(
                localCallBase,
                operand,
                "cleanup_cfg: fragment call ordinal overflow")
        elif op.kind == coreir.BodyOpResultPanicGuardTag && operandOffset == 1:
            operand = cleanupCfgCheckedAdd(
                localCallBase,
                operand,
                "cleanup_cfg: fragment guard call ordinal overflow")
        elif op.kind == coreir.BodyOpStrEqLiteralTag && operandOffset == 1:
            if operand < 0 || operand >= plan.scratchCStringMap.len:
                cleanupCfgFail("cleanup_cfg: fragment op cstring out of range")
            operand = plan.scratchCStringMap[operand]
        add(op.operands, operand)
    return op

fn cleanupCfgFragmentTerm(plan: var CleanupPlan,
                          bodyIR: var coreir.BodyIR,
                          fragmentId: int32,
                          termRow: int32,
                          outputOpBase: int32,
                          fragmentBlockBase: int32,
                          clearBlockId: int32,
                          isExit: bool): coreir.BodyTerm =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    if isExit:
        term.kind = coreir.BodyTermBrTag
        term.trueBlock = clearBlockId
        return term
    term.kind = plan.termKinds[termRow]
    term.conditionKind = plan.termConditionKinds[termRow]
    term.resultSlot = plan.termResultSlots[termRow]
    cleanupCfgRelocateDefinitionCoordinate(
        bodyIR,
        plan.termSourceDefinitionDomains[termRow],
        plan.termSourceDefinitionRows[termRow],
        outputOpBase,
        plan.fragmentOpCounts[fragmentId],
        term.sourceDefinitionDomain,
        term.sourceDefinitionRow)
    term.lhsSlot = plan.termLhsSlots[termRow]
    term.rhsSlot = plan.termRhsSlots[termRow]
    if term.kind == coreir.BodyTermBrTag:
        term.trueBlock = cleanupCfgCheckedAdd(
            fragmentBlockBase,
            plan.termTrueBlocks[termRow],
            "cleanup_cfg: fragment branch block overflow")
    elif term.kind == coreir.BodyTermCbrTag:
        term.trueBlock = cleanupCfgCheckedAdd(
            fragmentBlockBase,
            plan.termTrueBlocks[termRow],
            "cleanup_cfg: fragment branch block overflow")
        term.falseBlock = cleanupCfgCheckedAdd(
            fragmentBlockBase,
            plan.termFalseBlocks[termRow],
            "cleanup_cfg: fragment branch block overflow")
    else:
        cleanupCfgFail("cleanup_cfg: return marker not classified as fragment exit")
    let operandStart = plan.termOperandStarts[termRow]
    let operandCount = plan.termOperandCounts[termRow]
    for operandOffset in 0..<operandCount:
        let operandRow = cleanupCfgCheckedAdd(
            operandStart,
            operandOffset,
            "cleanup_cfg: fragment term operand row overflow")
        add(term.operands, plan.termOperands[operandRow])
    return term

fn cleanupCfgAppendDeferUnit(plan: var CleanupPlan,
                             bodyIR: var coreir.BodyIR,
                             deferId: int32,
                             clearActiveFlag: bool,
                             conditionSlotOverride: int32,
                             conditionTermIndexOut: var int32,
                             clearTermIndexOut: var int32,
                             report: var CleanupMaterializeReport): int32 =
    let fragmentId = plan.deferFragmentIds[deferId]
    cleanupCfgEnsureFragmentCStrings(plan, bodyIR, fragmentId, report)
    let outputOpBase = bodyIR.ops.len
    let outputCallBase = cleanupCfgAppendFragmentCalls(plan,
                                                       bodyIR,
                                                       fragmentId,
                                                       outputOpBase,
                                                       report)
    let conditionBlockId = bodyIR.blocks.len
    let fragmentBlockBase = cleanupCfgCheckedAdd(
        conditionBlockId,
        1,
        "cleanup_cfg: defer fragment block base overflow")
    let fragmentBlockCount = plan.fragmentBlockCounts[fragmentId]
    let clearBlockId = cleanupCfgCheckedAdd(
        fragmentBlockBase,
        fragmentBlockCount,
        "cleanup_cfg: defer clear block id overflow")
    var condition: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(condition)
    condition.kind = coreir.BodyTermCbrTag
    condition.conditionKind = coreir.BodyCondLocalNonZeroTag
    var conditionSlot = plan.deferActiveFlagSlots[deferId]
    if conditionSlotOverride >= 0:
        conditionSlot = conditionSlotOverride
    condition.lhsSlot = conditionSlot
    condition.trueBlock = cleanupCfgCheckedAdd(
        fragmentBlockBase,
        plan.fragmentEntryBlockOrdinals[fragmentId],
        "cleanup_cfg: defer entry block id overflow")
    condition.falseBlock = -1
    let conditionTrueBlock = condition.trueBlock
    conditionTermIndexOut = cleanupCfgAppendTermExact(
        bodyIR, condition, 2,
        conditionTrueBlock, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeNormal)
    let appendedConditionBlock = cleanupCfgAppendBlockExact(
        bodyIR,
        bodyIR.ops.len,
        0,
        conditionTermIndexOut,
        plan.deferDeclarationScopeIds[deferId])
    if appendedConditionBlock != conditionBlockId:
        cleanupCfgFail("cleanup_cfg: condition block id drift")
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    let opStart = plan.fragmentOpStarts[fragmentId]
    let opCount = plan.fragmentOpCounts[fragmentId]
    for opOffset in 0..<opCount:
        let op = cleanupCfgFragmentOp(
            plan,
            bodyIR,
            fragmentId,
            cleanupCfgCheckedAdd(
                opStart,
                opOffset,
                "cleanup_cfg: fragment op row overflow"),
            outputCallBase,
            outputOpBase)
        let appendedOperandCount = op.operands.len
        let _ = coreir.BodyIRAppendOp(bodyIR, op)
        report.materializedOpCount = cleanupCfgCheckedReportAdd(
            report.materializedOpCount,
            1)
        report.materializedOperandCount = cleanupCfgCheckedReportAdd(
            report.materializedOperandCount,
            appendedOperandCount)
    let blockStart = plan.fragmentBlockStarts[fragmentId]
    let termStart = plan.fragmentTermStarts[fragmentId]
    # A materialized replay is dispatch CFG in the declaration scope.  The
    # suite scope remains the immutable action definition hashed by BodyIR.
    for blockOffset in 0..<fragmentBlockCount:
        let blockRow = cleanupCfgCheckedAdd(
            blockStart,
            blockOffset,
            "cleanup_cfg: fragment block row overflow")
        let localTermIndex = plan.blockTermIndices[blockRow]
        let termRow = cleanupCfgCheckedAdd(
            termStart,
            localTermIndex,
            "cleanup_cfg: fragment term row overflow")
        let term = cleanupCfgFragmentTerm(plan,
                                          bodyIR,
                                          fragmentId,
                                          termRow,
                                          outputOpBase,
                                          fragmentBlockBase,
                                          clearBlockId,
                                          plan.blockIsFragmentExit[blockRow])
        let appendedTermOperandCount = term.operands.len
        let successor0 = term.trueBlock
        var successorCount: int32 = 1
        var successor1: int32 = -1
        if term.kind == coreir.BodyTermCbrTag:
            successorCount = 2
            successor1 = term.falseBlock
        let termIndex = cleanupCfgAppendTermExact(
            bodyIR, term, successorCount,
            successor0, coreir.BodyControlEdgeNormal,
            successor1, coreir.BodyControlEdgeNormal)
        let blockId = cleanupCfgAppendBlockExact(
            bodyIR,
            cleanupCfgCheckedAdd(
                outputOpBase,
                plan.blockOpStarts[blockRow],
                "cleanup_cfg: fragment output op row overflow"),
            plan.blockOpCounts[blockRow],
            termIndex,
            plan.deferDeclarationScopeIds[deferId])
        if blockId != cleanupCfgCheckedAdd(
                          fragmentBlockBase,
                          blockOffset,
                          "cleanup_cfg: fragment output block id overflow"):
            cleanupCfgFail("cleanup_cfg: fragment block id drift")
        report.materializedBlockCount = cleanupCfgCheckedReportAdd(
            report.materializedBlockCount,
            1)
        report.materializedTermCount = cleanupCfgCheckedReportAdd(
            report.materializedTermCount,
            1)
        report.materializedTermOperandCount = cleanupCfgCheckedReportAdd(
            report.materializedTermOperandCount,
            appendedTermOperandCount)

    let clearOpStart = bodyIR.ops.len
    var clearOpCount: int32
    if clearActiveFlag:
        var clearOp: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(clearOp)
        clearOp.kind = coreir.BodyOpLoadConstTag
        clearOp.target = plan.deferActiveFlagSlots[deferId]
        add(clearOp.operands, coreir.LocalI32Tag)
        add(clearOp.operands, 0)
        let _ = coreir.BodyIRAppendOp(bodyIR, clearOp)
        clearOpCount = 1
        report.materializedOpCount = cleanupCfgCheckedReportAdd(
            report.materializedOpCount,
            1)
        report.materializedOperandCount = cleanupCfgCheckedReportAdd(
            report.materializedOperandCount,
            2)
    var clearTerm: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(clearTerm)
    clearTerm.kind = coreir.BodyTermBrTag
    clearTerm.trueBlock = -1
    clearTermIndexOut = cleanupCfgAppendTermExact(
        bodyIR, clearTerm, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let appendedClearBlock = cleanupCfgAppendBlockExact(
        bodyIR,
        clearOpStart,
        clearOpCount,
        clearTermIndexOut,
        plan.deferDeclarationScopeIds[deferId])
    if appendedClearBlock != clearBlockId:
        cleanupCfgFail("cleanup_cfg: clear block id drift")
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return conditionBlockId

fn cleanupCfgPatchUnitContinuation(bodyIR: var coreir.BodyIR,
                                   conditionTermIndex: int32,
                                   clearTermIndex: int32,
                                   targetBlockId: int32,
                                   edgeKind: int32) =
    if conditionTermIndex < 0 ||
       conditionTermIndex >= bodyIR.termSuccessorStarts.len ||
       clearTermIndex < 0 ||
       clearTermIndex >= bodyIR.termSuccessorStarts.len ||
       bodyIR.termSuccessorCounts[conditionTermIndex] != 2 ||
       bodyIR.termSuccessorCounts[clearTermIndex] != 1:
        cleanupCfgFail("cleanup_cfg: defer continuation CSR shape drift")
    let conditionSuccessorStart =
        bodyIR.termSuccessorStarts[conditionTermIndex]
    let clearSuccessorStart =
        bodyIR.termSuccessorStarts[clearTermIndex]
    var condition = cleanupCfgReadBodyTermValue(bodyIR, conditionTermIndex)
    var clear = cleanupCfgReadBodyTermValue(bodyIR, clearTermIndex)
    if condition.kind != coreir.BodyTermCbrTag ||
       condition.falseBlock != -1 ||
       clear.kind != coreir.BodyTermBrTag ||
       clear.trueBlock != -1 ||
       conditionSuccessorStart < 0 ||
       conditionSuccessorStart > bodyIR.successorBlockIds.len - 2 ||
       clearSuccessorStart < 0 ||
       clearSuccessorStart > bodyIR.successorBlockIds.len - 1 ||
       bodyIR.successorBlockIds[conditionSuccessorStart] !=
           condition.trueBlock ||
       bodyIR.successorBlockIds[conditionSuccessorStart + 1] != -1 ||
       bodyIR.successorBlockIds[clearSuccessorStart] != -1:
        cleanupCfgFail("cleanup_cfg: defer continuation already patched")
    let conditionTrueEdgeKind =
        cleanupCfgControlTermEdgeKind(
            bodyIR, conditionTermIndex, 0)
    let conditionTrueBlock = condition.trueBlock
    condition.falseBlock = targetBlockId
    clear.trueBlock = targetBlockId
    cleanupCfgReplaceTermExact(
        bodyIR, conditionTermIndex, condition, 2,
        conditionTrueBlock, conditionTrueEdgeKind,
        targetBlockId, edgeKind)
    cleanupCfgReplaceTermExact(
        bodyIR, clearTermIndex, clear, 1,
        targetBlockId, edgeKind,
        -1, coreir.BodyControlEdgeUnknown)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)

fn cleanupCfgEmptyOwnershipUnitPatch(): cleanupOwnershipUnitPatch =
    var out: cleanupOwnershipUnitPatch
    out.entryBlockId = -1
    out.managedDefinitionOpId = -1
    out.continuationTerm0 = -1
    out.continuationTerm1 = -1
    out.continuationTerm2 = -1
    out.continuationTerm3 = -1
    out.continuationSuccessorOrdinal0 = -1
    out.continuationSuccessorOrdinal1 = -1
    out.continuationSuccessorOrdinal2 = -1
    out.continuationSuccessorOrdinal3 = -1
    return out

fn cleanupCfgRecordScheduleUnit(
        draft: var cleanupScheduleDraft,
        bodyIR: var coreir.BodyIR,
        localStart: int32,
        opStart: int32,
        callStart: int32,
        blockStart: int32,
        termStart: int32,
        projectedSnapshotSlotIds: var int32[]) =
    if localStart < 0 || localStart > bodyIR.localSlots.len ||
       opStart < 0 || opStart > bodyIR.ops.len ||
       callStart < 0 || callStart > bodyIR.callSequence.len ||
       blockStart < 0 || blockStart >= bodyIR.blocks.len ||
       termStart < 0 || termStart >= bodyIR.terms.len:
        cleanupCfgFail(
            "cleanup_cfg: cleanup schedule unit range invalid")
    add(draft.unitLocalStarts, localStart)
    add(draft.unitLocalCounts, bodyIR.localSlots.len - localStart)
    add(draft.unitOpStarts, opStart)
    add(draft.unitOpCounts, bodyIR.ops.len - opStart)
    add(draft.unitCallStarts, callStart)
    add(draft.unitCallCounts, bodyIR.callSequence.len - callStart)
    add(draft.unitBlockStarts, blockStart)
    add(draft.unitBlockCounts, bodyIR.blocks.len - blockStart)
    add(draft.unitTermStarts, termStart)
    add(draft.unitTermCounts, bodyIR.terms.len - termStart)
    add(draft.unitProjectedStarts,
        draft.projectedSnapshotSlotIds.len)
    add(draft.unitProjectedCounts,
        projectedSnapshotSlotIds.len)
    for offset in 0..<projectedSnapshotSlotIds.len:
        add(draft.projectedSnapshotSlotIds,
            projectedSnapshotSlotIds[offset])

fn cleanupCfgOwnershipPatchAdd(
        bodyIR: var coreir.BodyIR,
        patch: var cleanupOwnershipUnitPatch,
        termIndex: int32,
        successorOrdinal: int32) =
    if termIndex < 0 || termIndex >= bodyIR.terms.len ||
       termIndex >= bodyIR.termSuccessorStarts.len ||
       termIndex >= bodyIR.termSuccessorCounts.len ||
       patch.continuationCount >= 4:
        cleanupCfgFail("cleanup_cfg: ownership unit continuation capacity")
    let successorStart = bodyIR.termSuccessorStarts[termIndex]
    let successorCount = bodyIR.termSuccessorCounts[termIndex]
    let term = bodyIR.terms[termIndex]
    if successorOrdinal < 0 || successorOrdinal >= successorCount ||
       successorStart < 0 ||
       successorCount > bodyIR.successorBlockIds.len - successorStart ||
       bodyIR.successorBlockIds[successorStart + successorOrdinal] != -1 ||
       !cleanupCfgControlEdgeKindValid(
           bodyIR.successorEdgeKinds[
               successorStart + successorOrdinal]) ||
       (term.kind == coreir.BodyTermBrTag &&
        (successorOrdinal != 0 || term.trueBlock != -1)) ||
       (term.kind == coreir.BodyTermCbrTag &&
        (successorOrdinal != 1 || term.falseBlock != -1)) ||
       (term.kind != coreir.BodyTermBrTag &&
        term.kind != coreir.BodyTermCbrTag):
        cleanupCfgFail(
            "cleanup_cfg: ownership continuation coordinate invalid")
    for ordinal in 0..<patch.continuationCount:
        if cleanupCfgOwnershipPatchTerm(patch, ordinal) == termIndex &&
           cleanupCfgOwnershipPatchSuccessorOrdinal(
               patch, ordinal) == successorOrdinal:
            cleanupCfgFail(
                "cleanup_cfg: ownership continuation coordinate duplicated")
    if patch.continuationCount == 0:
        patch.continuationTerm0 = termIndex
        patch.continuationSuccessorOrdinal0 = successorOrdinal
    elif patch.continuationCount == 1:
        patch.continuationTerm1 = termIndex
        patch.continuationSuccessorOrdinal1 = successorOrdinal
    elif patch.continuationCount == 2:
        patch.continuationTerm2 = termIndex
        patch.continuationSuccessorOrdinal2 = successorOrdinal
    else:
        patch.continuationTerm3 = termIndex
        patch.continuationSuccessorOrdinal3 = successorOrdinal
    patch.continuationCount = cleanupCfgCheckedAdd(
        patch.continuationCount,
        1,
        "cleanup_cfg: ownership continuation count overflow")

@borrows
fn cleanupCfgOwnershipPatchTerm(patch: cleanupOwnershipUnitPatch,
                                ordinal: int32): int32 =
    if ordinal == 0:
        return patch.continuationTerm0
    if ordinal == 1:
        return patch.continuationTerm1
    if ordinal == 2:
        return patch.continuationTerm2
    if ordinal == 3:
        return patch.continuationTerm3
    cleanupCfgFail("cleanup_cfg: ownership continuation ordinal")
    return -1

@borrows
fn cleanupCfgOwnershipPatchSuccessorOrdinal(
        patch: cleanupOwnershipUnitPatch,
        ordinal: int32): int32 =
    if ordinal == 0:
        return patch.continuationSuccessorOrdinal0
    if ordinal == 1:
        return patch.continuationSuccessorOrdinal1
    if ordinal == 2:
        return patch.continuationSuccessorOrdinal2
    if ordinal == 3:
        return patch.continuationSuccessorOrdinal3
    cleanupCfgFail("cleanup_cfg: ownership successor ordinal")
    return -1

@borrows
fn cleanupCfgPatchOwnershipUnit(bodyIR: var coreir.BodyIR,
                                patch: cleanupOwnershipUnitPatch,
                                targetBlockId: int32,
                                edgeKind: int32) =
    if patch.entryBlockId < 0 || patch.continuationCount <= 0 ||
       targetBlockId < 0 ||
       !cleanupCfgControlEdgeKindValid(edgeKind) ||
       edgeKind == coreir.BodyControlEdgeReturn:
        cleanupCfgFail("cleanup_cfg: malformed ownership unit patch")
    for ordinal in 0..<patch.continuationCount:
        let termIndex = cleanupCfgOwnershipPatchTerm(patch, ordinal)
        let successorOrdinal =
            cleanupCfgOwnershipPatchSuccessorOrdinal(patch, ordinal)
        if termIndex < 0 || termIndex >= bodyIR.terms.len:
            cleanupCfgFail("cleanup_cfg: ownership continuation term range")
        let successorStart = bodyIR.termSuccessorStarts[termIndex]
        let successorCount = bodyIR.termSuccessorCounts[termIndex]
        if successorOrdinal < 0 ||
           successorOrdinal >= successorCount ||
           successorStart < 0 ||
           successorCount >
               bodyIR.successorBlockIds.len - successorStart ||
           bodyIR.successorBlockIds[
               successorStart + successorOrdinal] != -1:
            cleanupCfgFail(
                "cleanup_cfg: ownership continuation CSR drift")
        var term = cleanupCfgReadBodyTermValue(bodyIR, termIndex)
        let kind = term.kind
        if kind == coreir.BodyTermBrTag:
            if successorCount != 1 || successorOrdinal != 0 ||
               term.trueBlock != -1:
                cleanupCfgFail("cleanup_cfg: ownership branch already patched")
            term.trueBlock = targetBlockId
            cleanupCfgReplaceTermExact(
                bodyIR, termIndex, term, 1,
                targetBlockId, edgeKind,
                -1, coreir.BodyControlEdgeUnknown)
        elif kind == coreir.BodyTermCbrTag:
            if successorCount != 2 || successorOrdinal != 1 ||
               term.falseBlock != -1:
                cleanupCfgFail("cleanup_cfg: ownership condition already patched")
            let trueEdgeKind =
                cleanupCfgControlTermEdgeKind(bodyIR, termIndex, 0)
            let trueBlock = term.trueBlock
            term.falseBlock = targetBlockId
            cleanupCfgReplaceTermExact(
                bodyIR, termIndex, term, 2,
                trueBlock, trueEdgeKind,
                targetBlockId, edgeKind)
        else:
            cleanupCfgFail("cleanup_cfg: ownership continuation term kind")
    coreir.BodyIRClearFrameLayoutCache(bodyIR)

fn cleanupCfgOwnershipConditionCount(plan: var CleanupPlan,
                                     actionRow: int32): int32 =
    var out: int32
    if plan.ownershipActionPrimaryKinds[actionRow] !=
       odir.DropConditionAlways:
        out = cleanupCfgCheckedAdd(
            out, 1,
            "cleanup_cfg: ownership condition count overflow")
    if plan.ownershipActionSecondaryKinds[actionRow] !=
       odir.DropConditionAlways:
        out = cleanupCfgCheckedAdd(
            out, 1,
            "cleanup_cfg: ownership condition count overflow")
    if plan.ownershipActionGuardKinds[actionRow] !=
       odir.DropConditionAlways:
        out = cleanupCfgCheckedAdd(
            out, 1,
            "cleanup_cfg: ownership condition count overflow")
    return out

fn cleanupCfgMaterializedManagedDefinitionOp(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        actionRow: int32): int32 =
    if actionRow < 0 ||
       actionRow >= plan.ownershipActionKinds.len ||
       plan.ownershipActionKinds[actionRow] !=
           odir.CleanupActionDropPlace ||
       plan.ownershipActionIds[actionRow] != 0 ||
       plan.ownershipActionConsumeActionRows[actionRow] != actionRow:
        cleanupCfgFail(
            "cleanup_cfg: managed definition consumer authority invalid")
    if plan.ownershipActionDefinitionOriginKinds[actionRow] ==
           odir.DefinitionOriginTypedExpr:
        # wall64：物理索引前按插入基址平移 plan 原始坐标（指纹门保护，
        # plan 列禁止就地改写）。
        var definitionDomain: int32
        var definitionOpId: int32
        cleanupCfgRelocatePlanDefinitionCoordinate(
            plan,
            bodyIR,
            plan.ownershipActionSourceDefinitionDomains[actionRow],
            plan.ownershipActionSourceDefinitionRows[actionRow],
            definitionDomain,
            definitionOpId)
        if definitionDomain !=
               coreir.BodyDefinitionDomainBodyOpTag ||
           definitionOpId < 0 ||
           definitionOpId >= bodyIR.ops.len:
            cleanupCfgFail(
                "cleanup_cfg: initialized producer definition coordinate drift")
        let definition = bodyIR.ops[definitionOpId]
        # wall64-r3 判词富化：身份三项逐项取数 + 全 ops 表同身份扫描（仅
        # 失败臂取数；扫描为纯读）。match_row=首个 valueDefSlot==plan target
        # 且 originKind==TypedExpr 的物理行（无则 -1）；用于区分「plan 行
        # 指错 op」与「op 身份被改写」两类根因。
        var diagMatchRow: int32 = -1
        var diagMatchCount: int32
        for opIndex in 0..<bodyIR.ops.len:
            let scanOp = bodyIR.ops[opIndex]
            if scanOp.valueDefOriginKind ==
                   coreir.BodyDefinitionOriginTypedExprTag &&
               scanOp.valueDefSlot ==
                   plan.ownershipActionTargetSlots[actionRow]:
                if diagMatchCount == 0:
                    diagMatchRow = opIndex
                diagMatchCount = cleanupCfgCheckedAdd(
                    diagMatchCount,
                    1,
                    "cleanup_cfg: producer scan count overflow")
        let diagKindDrift =
            definition.valueDefOriginKind !=
                coreir.BodyDefinitionOriginTypedExprTag
        let diagOriginDrift =
            definition.valueDefOriginId !=
                plan.ownershipActionDefinitionOriginIds[actionRow]
        let diagSlotDrift =
            definition.valueDefSlot !=
                plan.ownershipActionTargetSlots[actionRow]
        if diagKindDrift || diagOriginDrift || diagSlotDrift:
            cleanupCfgFail(
                Fmt"cleanup_cfg: initialized producer definition drift action={actionRow} opid={definitionOpId} base={plan.initializerRelocationOpBase} rawrow={plan.ownershipActionSourceDefinitionRows[actionRow]} okind={int32(definition.valueDefOriginKind)} oid={definition.valueDefOriginId} slot={definition.valueDefSlot} opkind={int32(definition.kind)} optarget={definition.target} plan_origin={plan.ownershipActionDefinitionOriginIds[actionRow]} plan_target={plan.ownershipActionTargetSlots[actionRow]} match_row={diagMatchRow} match_count={diagMatchCount} ops={bodyIR.ops.len} kind_drift={diagKindDrift} origin_drift={diagOriginDrift} slot_drift={diagSlotDrift}")
        cleanupCfgValidateManagedDefinitionRow(bodyIR, definitionOpId)
        return definitionOpId
    if plan.ownershipActionDefinitionOriginKinds[actionRow] !=
           odir.DefinitionOriginCanonicalSyntheticAction ||
       plan.ownershipActionSourceDefinitionDomains[actionRow] !=
           coreir.BodyDefinitionDomainInvalidTag ||
       plan.ownershipActionSourceDefinitionRows[actionRow] != -1:
        cleanupCfgFail(
            "cleanup_cfg: synthetic managed definition authority invalid")
    let producerActionRow =
        plan.ownershipActionDefinitionOriginIds[actionRow]
    if producerActionRow < 0 ||
       producerActionRow >= actionRow ||
       (plan.ownershipActionKinds[producerActionRow] !=
            odir.CleanupActionStoreMove &&
        plan.ownershipActionKinds[producerActionRow] !=
            odir.CleanupActionRetainValue):
        cleanupCfgFail(
            "cleanup_cfg: managed definition producer authority invalid")
    let targetSlot = plan.ownershipActionTargetSlots[actionRow]
    var definitionOpId = -1
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
           op.valueDefOriginId == producerActionRow:
            if definitionOpId >= 0 ||
               op.valueDefOwnership != coreir.OwnMove ||
               op.valueDefSlot != targetSlot ||
               op.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               op.sourceDefinitionRow < 0:
                cleanupCfgFail(
                    "cleanup_cfg: managed definition producer duplicated")
            definitionOpId = opIndex
    if definitionOpId < 0:
        cleanupCfgFail(
            "cleanup_cfg: managed definition producer not materialized")
    return definitionOpId

fn cleanupCfgAppendOwnershipDropUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        actionRow: int32,
        capturedDefinitionOpId: int32,
        snapshotLiveSlots: var int32[],
        snapshotSlots: var int32[],
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    let conditionCount = cleanupCfgOwnershipConditionCount(plan, actionRow)
    let firstBlockId = bodyIR.blocks.len
    let callBlockId = cleanupCfgCheckedAdd(
        firstBlockId,
        conditionCount,
        "cleanup_cfg: ownership call block id overflow")
    out.entryBlockId = firstBlockId
    var emittedConditionCount: int32
    for atomOrdinal in 0..<3:
        var kind = plan.ownershipActionPrimaryKinds[actionRow]
        var localSlot = cleanupCfgOwnershipSnapshotSlot(
            snapshotLiveSlots,
            snapshotSlots,
            plan.ownershipActionPrimaryFlagSlots[actionRow])
        var negated = plan.ownershipActionPrimaryNegated[actionRow]
        if atomOrdinal == 1:
            kind = plan.ownershipActionSecondaryKinds[actionRow]
            localSlot = cleanupCfgOwnershipSnapshotSlot(
                snapshotLiveSlots,
                snapshotSlots,
                plan.ownershipActionSecondaryFlagSlots[actionRow])
            negated = plan.ownershipActionSecondaryNegated[actionRow]
        elif atomOrdinal == 2:
            kind = plan.ownershipActionGuardKinds[actionRow]
            localSlot = cleanupCfgOwnershipSnapshotSlot(
                snapshotLiveSlots,
                snapshotSlots,
                plan.ownershipActionGuardFlagSlots[actionRow])
            negated = plan.ownershipActionGuardNegated[actionRow]
        if kind != odir.DropConditionAlways:
            var condition: coreir.BodyTerm
            coreir.BodyIRApplyBodyTermDefaultProof(condition)
            condition.kind = coreir.BodyTermCbrTag
            condition.conditionKind = coreir.BodyCondLocalNonZeroTag
            if negated:
                condition.conditionKind = coreir.BodyCondLocalZeroTag
            condition.lhsSlot = localSlot
            condition.trueBlock = cleanupCfgCheckedAdd(
                cleanupCfgCheckedAdd(
                    firstBlockId,
                    emittedConditionCount,
                    "cleanup_cfg: ownership condition block id overflow"),
                1,
                "cleanup_cfg: ownership condition block id overflow")
            condition.falseBlock = -1
            let conditionTrueBlock = condition.trueBlock
            let termIndex = cleanupCfgAppendTermExact(
                bodyIR, condition, 2,
                conditionTrueBlock, coreir.BodyControlEdgeNormal,
                -1, coreir.BodyControlEdgeNormal)
            let blockId = cleanupCfgAppendBlockExact(
                bodyIR, bodyIR.ops.len, 0, termIndex, scopeId)
            if blockId != cleanupCfgCheckedAdd(
                              firstBlockId,
                              emittedConditionCount,
                              "cleanup_cfg: ownership condition block id overflow"):
                cleanupCfgFail("cleanup_cfg: ownership condition block drift")
            cleanupCfgOwnershipPatchAdd(bodyIR, out, termIndex, 1)
            emittedConditionCount = cleanupCfgCheckedAdd(
                emittedConditionCount,
                1,
                "cleanup_cfg: ownership emitted condition overflow")
            report.materializedBlockCount = cleanupCfgCheckedReportAdd(
                report.materializedBlockCount,
                1)
            report.materializedTermCount = cleanupCfgCheckedReportAdd(
                report.materializedTermCount,
                1)
    if emittedConditionCount != conditionCount:
        cleanupCfgFail("cleanup_cfg: ownership condition count drift")

    let glueIndex = plan.ownershipActionDropGlueBindingIndices[actionRow]
    let targetSlot = plan.ownershipActionTargetSlots[actionRow]
    let opStart = bodyIR.ops.len
    var releaseDefinitionOpId = capturedDefinitionOpId
    var capturedProjectionOpCount: int32
    if capturedDefinitionOpId >= 0:
        let capturedOldRelease =
            plan.ownershipActionIds[actionRow] > 0
        let managedProducerRelease =
            plan.ownershipActionIds[actionRow] == 0 &&
            (plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                 odir.DefinitionOriginCanonicalSyntheticAction ||
             plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                 odir.DefinitionOriginTypedExpr) &&
            plan.ownershipActionConsumeActionRows[actionRow] ==
                actionRow
        let capturedFieldRelease =
            capturedOldRelease &&
            plan.ownershipActionKinds[actionRow] ==
                odir.CleanupActionDropField
        if (plan.ownershipActionKinds[actionRow] !=
                odir.CleanupActionDropPlace &&
            !capturedFieldRelease) ||
           (!capturedOldRelease && !managedProducerRelease) ||
           capturedDefinitionOpId >= bodyIR.ops.len:
            cleanupCfgFail(
                "cleanup_cfg: captured-old release definition invalid")
        var capturedDefinition = bodyIR.ops[capturedDefinitionOpId]
        var capturedTargetExact =
            capturedDefinition.valueDefSlot == targetSlot
        var capturedProjectionSourceSlot = -1
        if capturedFieldRelease:
            let fieldBinding =
                plan.ownershipActionFieldProjectionBindingIndices[
                    actionRow]
            if fieldBinding < 0 ||
               fieldBinding >=
                   plan.ownershipFieldBindingProjectionSlots.len:
                cleanupCfgFail(
                    "cleanup_cfg: captured field binding invalid")
            capturedProjectionSourceSlot =
                plan.ownershipFieldBindingProjectionSlots[fieldBinding]
            if capturedProjectionSourceSlot < 0 ||
               capturedProjectionSourceSlot >= bodyIR.localSlots.len:
                cleanupCfgFail(
                    "cleanup_cfg: captured field projection invalid")
            let projection =
                bodyIR.localSlots[capturedProjectionSourceSlot]
            capturedTargetExact =
                projection.placeKind ==
                    coreir.BodyPlaceBorrowAddressTag &&
                projection.auxValue ==
                    capturedDefinition.valueDefSlot &&
                targetSlot >= 0 &&
                targetSlot < bodyIR.localSlots.len &&
                bodyIR.localSlots[targetSlot].placeKind ==
                    coreir.BodyPlaceStackValueTag
        if capturedDefinition.valueDefOwnership != coreir.OwnMove ||
           capturedDefinition.valueDefSemanticRow < 0 ||
           !capturedTargetExact ||
           (capturedOldRelease &&
            capturedDefinition.valueDefOriginKind !=
                coreir.BodyDefinitionOriginCanonicalCleanupActionTag) ||
           (managedProducerRelease &&
            plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                odir.DefinitionOriginCanonicalSyntheticAction &&
            capturedDefinition.valueDefOriginKind !=
                coreir.BodyDefinitionOriginCanonicalCleanupActionTag) ||
           (managedProducerRelease &&
            plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                odir.DefinitionOriginTypedExpr &&
            (capturedDefinition.valueDefOriginKind !=
                 coreir.BodyDefinitionOriginTypedExprTag ||
             capturedDefinition.valueDefOriginId !=
                 plan.ownershipActionDefinitionOriginIds[actionRow])) ||
           (managedProducerRelease &&
            plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                odir.DefinitionOriginCanonicalSyntheticAction &&
            capturedDefinition.valueDefOriginId !=
                plan.ownershipActionDefinitionOriginIds[actionRow]) ||
           (!capturedFieldRelease &&
            (capturedDefinition.valueDefConsumeOpIndexPlusOne != 0 ||
             capturedDefinition.consumeActionRow != -1)):
            # [wall141] 判词富化（wall139 同法）：失败臂逐项取数纯读投影，
            # 区分 ownership/semanticRow/targetExact/origin/consume 五族
            # 根因；零语义变化，七个子条件可由原始值离线推导。
            cleanupCfgFail(
                Fmt"cleanup_cfg: captured-old release authority mismatch action={actionRow} kind={int32(plan.ownershipActionKinds[actionRow])} ids={plan.ownershipActionIds[actionRow]} cor={plan.ownershipActionConsumeActionRows[actionRow]} pok={int32(plan.ownershipActionDefinitionOriginKinds[actionRow])} poid={plan.ownershipActionDefinitionOriginIds[actionRow]} opid={capturedDefinitionOpId} ops={bodyIR.ops.len} d_own={int32(capturedDefinition.valueDefOwnership)} d_srow={capturedDefinition.valueDefSemanticRow} d_slot={capturedDefinition.valueDefSlot} tgt={targetSlot} d_ok={int32(capturedDefinition.valueDefOriginKind)} d_oid={capturedDefinition.valueDefOriginId} d_cons={capturedDefinition.valueDefConsumeOpIndexPlusOne} d_car={capturedDefinition.consumeActionRow} tx={capturedTargetExact} oldr={capturedOldRelease} mpr={managedProducerRelease} fldr={capturedFieldRelease}")
        if capturedFieldRelease:
            let projectionOpIndex = bodyIR.ops.len
            var projectionOp: coreir.BodyOp
            coreir.BodyIRApplyBodyOpDefaultProof(projectionOp)
            projectionOp.kind = coreir.BodyOpCopyLocalTag
            projectionOp.target = targetSlot
            projectionOp.valueDefSlot = targetSlot
            projectionOp.valueDefExprNodeIndex = -1
            projectionOp.valueDefSemanticRow =
                capturedDefinition.valueDefSemanticRow
            projectionOp.valueDefOwnership = coreir.OwnMove
            projectionOp.valueDefOriginKind =
                coreir.BodyDefinitionOriginCanonicalCleanupActionTag
            projectionOp.valueDefOriginId = actionRow
            projectionOp.sourceDefinitionDomain =
                coreir.BodyDefinitionDomainBodyOpTag
            projectionOp.sourceDefinitionRow =
                capturedDefinitionOpId
            add(projectionOp.operands, capturedProjectionSourceSlot)
            releaseDefinitionOpId =
                coreir.BodyIRAppendOp(bodyIR, projectionOp)
            if releaseDefinitionOpId != projectionOpIndex:
                cleanupCfgFail(
                    "cleanup_cfg: captured field definition row drift")
            if capturedDefinition.valueDefConsumeOpIndexPlusOne == 0:
                capturedDefinition.valueDefConsumeOpIndexPlusOne =
                    cleanupCfgCheckedAdd(
                        projectionOpIndex,
                        1,
                        "cleanup_cfg: captured field consume op overflow")
                # The field action is consumed exactly once by the released
                # child definition.  The captured parent is a structural
                # projection source, not a second action consumer.
                capturedDefinition.consumeActionRow = -1
            capturedProjectionOpCount = 1
        # wall79: `var capturedDefinition = bodyIR.ops[row]` 是托管 struct
        # move-out 读（wall76 判词同族语义）：读出即源行整行置默认。原回写
        # 只在 capturedFieldRelease 分支内，DropPlace captured-old 与
        # managed-producer release 路径读-改后不回写，源行保持 kind=0，
        # 终审计 BodyIRDodSoAContractCheck 死 ops[i].kind value=0；随后
        # releaseDefinition 读-改-写还会把零行+consume 戳盖回真实定义行。
        # 契约镜像：move-out 窗口闭合前必须原样回写（与 sourceDefinition
        # :10425/:10446、releaseDefinition :12525/:12532 同一读-改-写契约），
        # 守卫与 authority 判据零改动。
        bodyIR.ops[capturedDefinitionOpId] = capturedDefinition
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = plan.ownershipDropGlueBindingSymbols[glueIndex]
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    call.targetIsImportc = false
    if releaseDefinitionOpId >= 0:
        call.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        call.sourceDefinitionRow = releaseDefinitionOpId
        call.consumeActionRow = actionRow
    add(call.argSlots, coreir.CallArgSlotAddress(targetSlot))
    add(call.argPassKinds, coreir.BodyCallPassByAddressAggregateTag)
    add(call.argAbiSizes, 8)
    let dropTypeRow =
        cleanupCfgPlanTypeLayoutRow(
            plan,
            plan.ownershipDropGlueBindingTypeIds[glueIndex])
    let dropTypeArenaTypeId =
        plan.typeLayoutTypeArenaTypeIds[dropTypeRow]
    let runtimeTargetCid =
        cleanupCfgRuntimeIntrinsicInterfaceCid(
            bodyIR,
            call,
            CleanupRuntimeIntrinsicOwnershipDropTag,
            dropTypeArenaTypeId)
    let callOrdinal = cleanupCfgAppendCallWithTarget(
        bodyIR,
        call,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
        0,
        runtimeTargetCid)
    var callOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = -1
    if releaseDefinitionOpId >= 0:
        callOp.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        callOp.sourceDefinitionRow = releaseDefinitionOpId
        callOp.consumeActionRow = actionRow
    add(callOp.operands, callOrdinal)
    let callOpIndex = coreir.BodyIRAppendOp(bodyIR, callOp)
    if releaseDefinitionOpId >= 0:
        var releaseDefinition = bodyIR.ops[releaseDefinitionOpId]
        releaseDefinition.valueDefConsumeOpIndexPlusOne =
            cleanupCfgCheckedAdd(
                callOpIndex,
                1,
                "cleanup_cfg: captured-old release op overflow")
        releaseDefinition.consumeActionRow = actionRow
        bodyIR.ops[releaseDefinitionOpId] = releaseDefinition
    let clearStart = plan.ownershipActionClearFlagStarts[actionRow]
    let clearCount = plan.ownershipActionClearFlagCounts[actionRow]
    for clearOffset in 0..<clearCount:
        var clearOp: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(clearOp)
        clearOp.kind = coreir.BodyOpLoadConstTag
        let clearRow = cleanupCfgCheckedAdd(
            clearStart,
            clearOffset,
            "cleanup_cfg: ownership clear flag row overflow")
        clearOp.target =
            plan.ownershipActionClearFlagSlots[clearRow]
        add(clearOp.operands, coreir.LocalI32Tag)
        add(clearOp.operands, 0)
        let _ = coreir.BodyIRAppendOp(bodyIR, clearOp)
    var tail: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(tail)
    tail.kind = coreir.BodyTermBrTag
    tail.trueBlock = -1
    let tailIndex = cleanupCfgAppendTermExact(
        bodyIR, tail, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let appendedCallBlock = cleanupCfgAppendBlockExact(
        bodyIR,
        opStart,
        cleanupCfgCheckedAdd(
            cleanupCfgCheckedAdd(
                1,
                capturedProjectionOpCount,
                "cleanup_cfg: ownership projection block op overflow"),
            clearCount,
            "cleanup_cfg: ownership drop op count overflow"),
        tailIndex,
        scopeId)
    if appendedCallBlock != callBlockId:
        cleanupCfgFail("cleanup_cfg: ownership drop block drift")
    cleanupCfgOwnershipPatchAdd(bodyIR, out, tailIndex, 0)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount,
        cleanupCfgCheckedAdd(
            cleanupCfgCheckedAdd(
                1,
                capturedProjectionOpCount,
                "cleanup_cfg: ownership drop projection op report overflow"),
            clearCount,
            "cleanup_cfg: ownership drop op report overflow"))
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount,
        cleanupCfgCheckedAdd(
            cleanupCfgCheckedAdd(
                1,
                capturedProjectionOpCount,
                "cleanup_cfg: ownership projection operand report overflow"),
            cleanupCfgCheckedMul(
                clearCount,
                2,
                "cleanup_cfg: ownership clear operand report overflow"),
            "cleanup_cfg: ownership drop operand report overflow"))
    report.materializedCallCount = cleanupCfgCheckedReportAdd(
        report.materializedCallCount,
        1)
    report.materializedCallArgCount = cleanupCfgCheckedReportAdd(
        report.materializedCallArgCount,
        2)
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return out

fn cleanupCfgAppendOwnershipDeferUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        actionRow: int32,
        snapshotLiveSlots: var int32[],
        snapshotSlots: var int32[],
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var conditionTermIndex: int32
    var clearTermIndex: int32
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    out.entryBlockId = cleanupCfgAppendDeferUnit(
        plan,
        bodyIR,
        plan.ownershipActionCleanupDeferIds[actionRow],
        false,
        cleanupCfgOwnershipSnapshotSlot(
            snapshotLiveSlots,
            snapshotSlots,
            plan.ownershipActionPrimaryFlagSlots[actionRow]),
        conditionTermIndex,
        clearTermIndex,
        report)
    cleanupCfgOwnershipPatchAdd(
        bodyIR, out, conditionTermIndex, 1)
    cleanupCfgOwnershipPatchAdd(
        bodyIR, out, clearTermIndex, 0)
    return out

fn cleanupCfgAppendOwnershipFlagTransitionUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        exitId: int32,
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    let transitionStart = plan.exitOwnershipFlagTransitionStarts[exitId]
    let transitionCount = plan.exitOwnershipFlagTransitionCounts[exitId]
    if transitionCount <= 0:
        return out
    out.entryBlockId = bodyIR.blocks.len
    let opStart = bodyIR.ops.len
    for offset in 0..<transitionCount:
        let row = cleanupCfgCheckedAdd(
            transitionStart,
            offset,
            "cleanup_cfg: ownership transition row overflow")
        var transitionOp: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(transitionOp)
        transitionOp.kind = coreir.BodyOpLoadConstTag
        transitionOp.target = plan.ownershipFlagTransitionFlagSlots[row]
        add(transitionOp.operands, coreir.LocalI32Tag)
        var value: int32
        if plan.ownershipFlagTransitionSetValues[row]:
            value = 1
        add(transitionOp.operands, value)
        let _ = coreir.BodyIRAppendOp(bodyIR, transitionOp)
    var tail: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(tail)
    tail.kind = coreir.BodyTermBrTag
    tail.trueBlock = -1
    let tailIndex = cleanupCfgAppendTermExact(
        bodyIR, tail, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    let blockId = cleanupCfgAppendBlockExact(
        bodyIR, opStart, transitionCount, tailIndex, scopeId)
    if blockId != out.entryBlockId:
        cleanupCfgFail("cleanup_cfg: ownership transition block drift")
    cleanupCfgOwnershipPatchAdd(bodyIR, out, tailIndex, 0)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount,
        transitionCount)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount,
        cleanupCfgCheckedMul(
            transitionCount,
            2,
            "cleanup_cfg: ownership transition operand report overflow"))
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return out

fn cleanupCfgChainOwnershipUnit(
        bodyIR: var coreir.BodyIR,
        firstBlockId: var int32,
        previous: var cleanupOwnershipUnitPatch,
        next: cleanupOwnershipUnitPatch) =
    if next.entryBlockId < 0:
        return
    if firstBlockId < 0:
        firstBlockId = next.entryBlockId
    if previous.entryBlockId >= 0:
        cleanupCfgPatchOwnershipUnit(
            bodyIR,
            previous,
            next.entryBlockId,
            coreir.BodyControlEdgeNormal)
    previous = next

fn cleanupCfgAppendOwnershipSnapshotSlotsUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        snapshotIdentityRow: int32,
        liveSlots: var int32[],
        liveSlotsOut: var int32[],
        snapshotSlotsOut: var int32[],
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var out = cleanupCfgEmptyOwnershipUnitPatch()
    if liveSlots.len <= 0:
        return out
    if bodyIR.localSlots.len + liveSlots.len >
       plan.limits.maxLocalSlotCount:
        cleanupCfgFail("cleanup_cfg: ownership snapshot local arena exhausted")
    let opStart = bodyIR.ops.len
    for liveIndex in 0..<liveSlots.len:
        let liveSlot = liveSlots[liveIndex]
        if liveSlot < 0 || liveSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[liveSlot].typeKind != coreir.LocalI32Tag:
            cleanupCfgFail("cleanup_cfg: ownership snapshot live flag invalid")
        var snapshot: coreir.LocalSlot
        snapshot.id = bodyIR.localSlots.len
        snapshot.name =
            Fmt"#ownership_guard_snapshot#{snapshotIdentityRow}#{liveSlot}"
        let source = bodyIR.localSlots[liveSlot]
        snapshot.typeKind = source.typeKind
        snapshot.stackOffset =
            cleanupCfgAllocateCapturedStackOffset(plan, 4, 4)
        snapshot.sizeBytes = 4
        snapshot.alignBytes = 4
        coreir.BodyIRApplyLocalSlotDefaultProof(snapshot)
        let snapshotId = snapshot.id
        add(bodyIR.localSlots, snapshot)
        if !coreir.BodyIRBindLocalSlotTypeArenaProof(
               bodyIR,
               snapshotId,
               bodyIR.typeArenaArtifactCid,
               source.typeArenaTypeId,
               source.managedStorageKind):
            cleanupCfgFail(
                "cleanup_cfg: ownership snapshot type proof bind failed")
        let boundSnapshot = bodyIR.localSlots[snapshotId]
        coreir.BodyIREntryDefinitionOwnershipAppendSyntheticSlot(
            bodyIR, snapshotId)
        add(plan.localTypeKinds, boundSnapshot.typeKind)
        add(plan.localTypeArenaTypeIds,
            boundSnapshot.typeArenaTypeId)
        add(plan.localManagedStorageKinds,
            boundSnapshot.managedStorageKind)
        add(plan.localPlaceKinds, boundSnapshot.placeKind)
        add(plan.localSizeBytes, boundSnapshot.sizeBytes)
        add(plan.localAlignBytes, boundSnapshot.alignBytes)
        add(snapshotSlotsOut, snapshotId)
        report.materializedLocalCount = cleanupCfgCheckedReportAdd(
            report.materializedLocalCount,
            1)
        var copy: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(copy)
        copy.kind = coreir.BodyOpCopyLocalTag
        copy.target = snapshotId
        add(copy.operands, liveSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, copy)
    for liveIndex in 0..<liveSlots.len:
        add(liveSlotsOut, liveSlots[liveIndex])
    var tail: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(tail)
    tail.kind = coreir.BodyTermBrTag
    tail.trueBlock = -1
    let tailIndex = cleanupCfgAppendTermExact(
        bodyIR, tail, 1, -1, coreir.BodyControlEdgeNormal,
        -1, coreir.BodyControlEdgeUnknown)
    out.entryBlockId = cleanupCfgAppendBlockExact(
        bodyIR, opStart, liveSlots.len, tailIndex, scopeId)
    cleanupCfgOwnershipPatchAdd(bodyIR, out, tailIndex, 0)
    report.materializedOpCount = cleanupCfgCheckedReportAdd(
        report.materializedOpCount,
        liveSlots.len)
    report.materializedOperandCount = cleanupCfgCheckedReportAdd(
        report.materializedOperandCount,
        liveSlots.len)
    report.materializedBlockCount = cleanupCfgCheckedReportAdd(
        report.materializedBlockCount,
        1)
    report.materializedTermCount = cleanupCfgCheckedReportAdd(
        report.materializedTermCount,
        1)
    return out

fn cleanupCfgAppendOwnershipSnapshotUnit(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        actionStart: int32,
        actionCount: int32,
        liveSlotsOut: var int32[],
        snapshotSlotsOut: var int32[],
        report: var CleanupMaterializeReport): cleanupOwnershipUnitPatch =
    var liveSlots: int32[]
    for actionOffset in 0..<actionCount:
        let actionRow = cleanupCfgCheckedAdd(
            actionStart,
            actionOffset,
            "cleanup_cfg: ownership snapshot action row overflow")
        for atomOrdinal in 0..<3:
            var kind = plan.ownershipActionPrimaryKinds[actionRow]
            var sourceSlot =
                plan.ownershipActionPrimaryFlagSlots[actionRow]
            if atomOrdinal == 1:
                kind = plan.ownershipActionSecondaryKinds[actionRow]
                sourceSlot =
                    plan.ownershipActionSecondaryFlagSlots[actionRow]
            elif atomOrdinal == 2:
                kind = plan.ownershipActionGuardKinds[actionRow]
                sourceSlot =
                    plan.ownershipActionGuardFlagSlots[actionRow]
            if kind == odir.DropConditionAlways:
                continue
            var found: bool
            for slotIndex in 0..<liveSlots.len:
                if liveSlots[slotIndex] == sourceSlot:
                    found = true
            if !found:
                add(liveSlots, sourceSlot)
    return cleanupCfgAppendOwnershipSnapshotSlotsUnit(
        plan,
        bodyIR,
        scopeId,
        actionStart,
        liveSlots,
        liveSlotsOut,
        snapshotSlotsOut,
        report)

fn cleanupCfgOwnershipSnapshotSlot(liveSlots: var int32[],
                                   snapshotSlots: var int32[],
                                   originalSlot: int32): int32 =
    if originalSlot < 0:
        return originalSlot
    if liveSlots.len != snapshotSlots.len:
        cleanupCfgFail("cleanup_cfg: ownership snapshot projection drift")
    for slotIndex in 0..<liveSlots.len:
        if liveSlots[slotIndex] == originalSlot:
            return snapshotSlots[slotIndex]
    cleanupCfgFail("cleanup_cfg: ownership snapshot projection missing")
    return -1

fn cleanupCfgMaterializeOwnershipActions(
        plan: var CleanupPlan,
        bodyIR: var coreir.BodyIR,
        scopeId: int32,
        exitId: int32,
        firstBlockIdOut: var int32,
        tailPatchOut: var cleanupOwnershipUnitPatch,
        report: var CleanupMaterializeReport,
        scheduleDraft: var cleanupScheduleDraft) =
    firstBlockIdOut = -1
    tailPatchOut = cleanupCfgEmptyOwnershipUnitPatch()
    let start = plan.exitOwnershipActionStarts[exitId]
    let count = plan.exitOwnershipActionCounts[exitId]
    var snapshotLiveSlots: int32[]
    var snapshotSlots: int32[]
    let snapshotLocalStart = bodyIR.localSlots.len
    let snapshotOpStart = bodyIR.ops.len
    let snapshotCallStart = bodyIR.callSequence.len
    let snapshotBlockStart = bodyIR.blocks.len
    let snapshotTermStart = bodyIR.terms.len
    let snapshotUnit = cleanupCfgAppendOwnershipSnapshotUnit(plan,
                                                              bodyIR,
                                                              scopeId,
                                                              start,
                                                              count,
                                                              snapshotLiveSlots,
                                                              snapshotSlots,
                                                              report)
    if snapshotUnit.entryBlockId >= 0:
        cleanupCfgRecordScheduleUnit(
            scheduleDraft,
            bodyIR,
            snapshotLocalStart,
            snapshotOpStart,
            snapshotCallStart,
            snapshotBlockStart,
            snapshotTermStart,
            snapshotSlots)
    cleanupCfgChainOwnershipUnit(bodyIR,
                                 firstBlockIdOut,
                                 tailPatchOut,
                                 snapshotUnit)
    var selectedDeferOrdinal: int32
    for offset in 0..<count:
        let actionRow = cleanupCfgCheckedAdd(
            start,
            offset,
            "cleanup_cfg: ownership action row overflow")
        let kind = plan.ownershipActionKinds[actionRow]
        var unit = cleanupCfgEmptyOwnershipUnitPatch()
        let unitLocalStart = bodyIR.localSlots.len
        let unitOpStart = bodyIR.ops.len
        let unitCallStart = bodyIR.callSequence.len
        let unitBlockStart = bodyIR.blocks.len
        let unitTermStart = bodyIR.terms.len
        if kind == odir.CleanupActionSnapshotRetainOwnedReturn ||
           kind == odir.CleanupActionSnapshotCloneOwnedReturn ||
           kind == odir.CleanupActionReturnUnmanaged:
            if offset != 0:
                cleanupCfgFail("cleanup_cfg: snapshot action is not first")
        elif kind == odir.CleanupActionDefer:
            unit = cleanupCfgAppendOwnershipDeferUnit(plan,
                                                       bodyIR,
                                                       actionRow,
                                                       snapshotLiveSlots,
                                                       snapshotSlots,
                                                       report)
            selectedDeferOrdinal = cleanupCfgCheckedAdd(
                selectedDeferOrdinal,
                1,
                "cleanup_cfg: ownership defer ordinal overflow")
        elif kind == odir.CleanupActionDropPlace ||
             kind == odir.CleanupActionDropField:
            var releaseDefinitionOpId = -1
            if plan.ownershipActionIds[actionRow] == 0 &&
               (plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                    odir.DefinitionOriginCanonicalSyntheticAction ||
                plan.ownershipActionDefinitionOriginKinds[actionRow] ==
                    odir.DefinitionOriginTypedExpr):
                releaseDefinitionOpId =
                    cleanupCfgMaterializedManagedDefinitionOp(
                        plan,
                        bodyIR,
                        actionRow)
            unit = cleanupCfgAppendOwnershipDropUnit(plan,
                                                      bodyIR,
                                                      scopeId,
                                                      actionRow,
                                                      releaseDefinitionOpId,
                                                      snapshotLiveSlots,
                                                      snapshotSlots,
                                                      report)
        else:
            cleanupCfgFail("cleanup_cfg: ownership action materialization unsupported")
        if unit.entryBlockId >= 0:
            var noProjectedSlots: int32[]
            cleanupCfgRecordScheduleUnit(
                scheduleDraft,
                bodyIR,
                unitLocalStart,
                unitOpStart,
                unitCallStart,
                unitBlockStart,
                unitTermStart,
                noProjectedSlots)
        cleanupCfgChainOwnershipUnit(bodyIR,
                                     firstBlockIdOut,
                                     tailPatchOut,
                                     unit)
    if selectedDeferOrdinal != plan.exitDeferCounts[exitId]:
        cleanupCfgFail(
            "cleanup_cfg: ownership defer replay count drift")
    let transitionLocalStart = bodyIR.localSlots.len
    let transitionOpStart = bodyIR.ops.len
    let transitionCallStart = bodyIR.callSequence.len
    let transitionBlockStart = bodyIR.blocks.len
    let transitionTermStart = bodyIR.terms.len
    let transitionUnit = cleanupCfgAppendOwnershipFlagTransitionUnit(plan,
                                                                      bodyIR,
                                                                      scopeId,
                                                                      exitId,
                                                                      report)
    if transitionUnit.entryBlockId >= 0:
        var noProjectedSlots: int32[]
        cleanupCfgRecordScheduleUnit(
            scheduleDraft,
            bodyIR,
            transitionLocalStart,
            transitionOpStart,
            transitionCallStart,
            transitionBlockStart,
            transitionTermStart,
            noProjectedSlots)
    cleanupCfgChainOwnershipUnit(bodyIR,
                                 firstBlockIdOut,
                                 tailPatchOut,
                                 transitionUnit)

fn cleanupCfgMaterializeExit(plan: var CleanupPlan,
                             bodyIR: var coreir.BodyIR,
                             exitId: int32,
                             report: var CleanupMaterializeReport,
                             scheduleDraft: var cleanupScheduleDraft) =
    let deferStart = plan.exitDeferStarts[exitId]
    let deferCount = plan.exitDeferCounts[exitId]
    let sourceBlockId = plan.exitPhysicalSourceBlockIds[exitId]
    let successorOrdinal = plan.exitSuccessorOrdinals[exitId]
    let returnExit = plan.exitKinds[exitId] == odir.OwnershipDropEdgeReturn
    let sourceScopeId = plan.exitFromScopeIds[exitId]
    if sourceBlockId < 0 || sourceBlockId >= bodyIR.blocks.len ||
       sourceScopeId < 0 ||
       sourceScopeId >= bodyIR.controlScopeParentIds.len ||
       bodyIR.blockScopeIds[sourceBlockId] != sourceScopeId:
        cleanupCfgFail("cleanup_cfg: materialized exit scope drift")
    let snapshotKind = plan.exitReturnSnapshotKinds[exitId]
    let snapshotSlot = plan.exitReturnSnapshotSlots[exitId]
    let usesOwnershipActions = plan.exitUsesOwnershipActions[exitId]
    let ownershipActionCount = plan.exitOwnershipActionCounts[exitId]
    let ownershipTransitionCount =
        plan.exitOwnershipFlagTransitionCounts[exitId]
    if deferCount <= 0 && snapshotKind == CleanupReturnSnapshotNone &&
       (!usesOwnershipActions ||
        (ownershipActionCount <= 0 && ownershipTransitionCount <= 0)):
        return

    var snapshotBlock = -1
    var snapshotTermIndex = -1
    if returnExit && snapshotKind != CleanupReturnSnapshotNone:
        let unitLocalStart = bodyIR.localSlots.len
        let unitOpStart = bodyIR.ops.len
        let unitCallStart = bodyIR.callSequence.len
        let unitBlockStart = bodyIR.blocks.len
        let unitTermStart = bodyIR.terms.len
        snapshotBlock = cleanupCfgAppendReturnSnapshotBlock(plan,
                                                            bodyIR,
                                                            sourceScopeId,
                                                            exitId,
                                                            snapshotTermIndex,
                                                            report)
        var projectedSlots: int32[]
        add(projectedSlots, snapshotSlot)
        cleanupCfgRecordScheduleUnit(
            scheduleDraft,
            bodyIR,
            unitLocalStart,
            unitOpStart,
            unitCallStart,
            unitBlockStart,
            unitTermStart,
            projectedSlots)
    var firstRuntimeBlock = -1
    var ownershipTail = cleanupCfgEmptyOwnershipUnitPatch()
    var previousConditionTerm = -1
    var previousClearTerm = -1
    if usesOwnershipActions:
        cleanupCfgMaterializeOwnershipActions(plan,
                                              bodyIR,
                                              sourceScopeId,
                                              exitId,
                                              firstRuntimeBlock,
                                              ownershipTail,
                                              report,
                                              scheduleDraft)
    else:
        for offset in 0..<deferCount:
            let deferRow = cleanupCfgCheckedAdd(
                deferStart,
                offset,
                "cleanup_cfg: exit defer row overflow")
            let deferId = plan.exitDeferIds[deferRow]
            var conditionTermIndex: int32
            var clearTermIndex: int32
            let unitLocalStart = bodyIR.localSlots.len
            let unitOpStart = bodyIR.ops.len
            let unitCallStart = bodyIR.callSequence.len
            let unitBlockStart = bodyIR.blocks.len
            let unitTermStart = bodyIR.terms.len
            let conditionBlock = cleanupCfgAppendDeferUnit(plan,
                                                           bodyIR,
                                                           deferId,
                                                           true,
                                                           -1,
                                                           conditionTermIndex,
                                                           clearTermIndex,
                                                           report)
            var noProjectedSlots: int32[]
            cleanupCfgRecordScheduleUnit(
                scheduleDraft,
                bodyIR,
                unitLocalStart,
                unitOpStart,
                unitCallStart,
                unitBlockStart,
                unitTermStart,
                noProjectedSlots)
            if firstRuntimeBlock < 0:
                firstRuntimeBlock = conditionBlock
            if previousConditionTerm >= 0:
                cleanupCfgPatchUnitContinuation(bodyIR,
                                                previousConditionTerm,
                                                previousClearTerm,
                                                conditionBlock,
                                                coreir.BodyControlEdgeNormal)
            previousConditionTerm = conditionTermIndex
            previousClearTerm = clearTermIndex
    var finalTarget = plan.exitTargetBlockIds[exitId]
    if returnExit:
        var returnSourceDefinitionDomain =
            coreir.BodyDefinitionDomainInvalidTag
        var returnSourceDefinitionRow: int32 = -1
        if cleanupCfgSnapshotKindOwned(snapshotKind):
            if snapshotBlock < 0 ||
               snapshotBlock >= bodyIR.blocks.len:
                cleanupCfgFail(
                    "cleanup_cfg: owned return snapshot block missing")
            returnSourceDefinitionDomain =
                coreir.BodyDefinitionDomainBodyOpTag
            returnSourceDefinitionRow =
                bodyIR.blocks[snapshotBlock].opStart
        finalTarget = cleanupCfgAppendReturnBlock(bodyIR,
                                                  sourceScopeId,
                                                  snapshotSlot,
                                                  returnSourceDefinitionDomain,
                                                  returnSourceDefinitionRow,
                                                  report)
    var finalContinuationEdgeKind =
        cleanupCfgExitControlEdgeKind(plan.exitKinds[exitId])
    if returnExit:
        finalContinuationEdgeKind = coreir.BodyControlEdgeNormal
    if usesOwnershipActions && ownershipTail.entryBlockId >= 0:
        cleanupCfgPatchOwnershipUnit(
            bodyIR,
            ownershipTail,
            finalTarget,
            finalContinuationEdgeKind)
    elif !usesOwnershipActions && deferCount > 0:
        cleanupCfgPatchUnitContinuation(bodyIR,
                                        previousConditionTerm,
                                        previousClearTerm,
                                        finalTarget,
                                        finalContinuationEdgeKind)
    if firstRuntimeBlock < 0:
        firstRuntimeBlock = finalTarget
    if snapshotBlock >= 0:
        var snapshotTerm =
            cleanupCfgReadBodyTermValue(bodyIR, snapshotTermIndex)
        snapshotTerm.trueBlock = firstRuntimeBlock
        cleanupCfgReplaceTermExact(
            bodyIR,
            snapshotTermIndex,
            snapshotTerm,
            1,
            firstRuntimeBlock,
            coreir.BodyControlEdgeNormal,
            -1,
            coreir.BodyControlEdgeUnknown)
        coreir.BodyIRClearFrameLayoutCache(bodyIR)
        firstRuntimeBlock = snapshotBlock
    cleanupCfgRewriteSourceEdge(bodyIR,
                                sourceBlockId,
                                successorOrdinal,
                                firstRuntimeBlock)
    add(scheduleDraft.exitPhysicalSourceBlockIds,
        sourceBlockId)
    add(scheduleDraft.exitSourceTermRows,
        bodyIR.blocks[sourceBlockId].termIndex)
    add(scheduleDraft.exitSourceSuccessorOrdinals,
        successorOrdinal)
    add(scheduleDraft.exitFinalContinuationBlockIds,
        finalTarget)
    add(scheduleDraft.exitFinalEdgeKinds,
        finalContinuationEdgeKind)

fn CleanupPlanStructuredLiveBytes(plan: var CleanupPlan): int64 =
    if !plan.prepared || plan.released:
        return int64(0)
    return cleanupCfgLimitsCapacityBytes(plan.limits)

fn cleanupCfgFingerprintMix(seed: int64, value: int32): int64 =
    return (seed * int64(65599) + int64(value) +
            int64(2147483647) + int64(1)) %
           int64(2147483647)

fn cleanupCfgFingerprintBool(seed: int64, value: bool): int64 =
    if value:
        return cleanupCfgFingerprintMix(seed, 1)
    return cleanupCfgFingerprintMix(seed, 0)

@borrows
fn cleanupCfgFingerprintText(seed: int64, value: str): int64 =
    var out = cleanupCfgFingerprintMix(seed, len(value))
    for index in 0..<len(value):
        out = cleanupCfgFingerprintMix(out, int32(value[index]))
    return out

fn cleanupCfgFingerprintInt64(seed: int64, value: int64): int64 =
    cleanupCfgRequireNonNegative64(
        value,
        "cleanup_cfg: canonical fingerprint negative int64")
    var out = seed
    var remaining = value
    for _ in 0..<3:
        out = cleanupCfgFingerprintMix(
            out,
            int32(remaining % int64(2147483647)))
        remaining = remaining / int64(2147483647)
    return out

fn cleanupCfgFingerprintColumnCount(columnCount: var int32) =
    columnCount = cleanupCfgCheckedAdd(
        columnCount,
        1,
        "cleanup_cfg: canonical fingerprint column overflow")

fn cleanupCfgFingerprintI32Field(out: var int64,
                                 columnCount: var int32,
                                 value: int32) =
    cleanupCfgFingerprintColumnCount(columnCount)
    out = cleanupCfgFingerprintMix(out, value)

fn cleanupCfgFingerprintBoolField(out: var int64,
                                  columnCount: var int32,
                                  value: bool) =
    cleanupCfgFingerprintColumnCount(columnCount)
    out = cleanupCfgFingerprintBool(out, value)

@borrows
fn cleanupCfgFingerprintTextField(out: var int64,
                                  columnCount: var int32,
                                  value: str) =
    cleanupCfgFingerprintColumnCount(columnCount)
    out = cleanupCfgFingerprintText(out, value)

fn cleanupCfgFingerprintI64Field(out: var int64,
                                 columnCount: var int32,
                                 value: int64) =
    cleanupCfgFingerprintColumnCount(columnCount)
    out = cleanupCfgFingerprintInt64(out, value)

fn cleanupCfgFingerprintFixedBytes32Field(
        out: var int64,
        columnCount: var int32,
        value: layout.FixedBytes32) =
    cleanupCfgFingerprintColumnCount(columnCount)
    for index in 0..<32:
        out = cleanupCfgFingerprintMix(
            out, int32(value.data[index]))

fn cleanupCfgFingerprintFixedBytes32Sequence(
        seed: int64,
        values: var layout.FixedBytes32[]): int64 =
    var out = cleanupCfgFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        for byteIndex in 0..<32:
            out = cleanupCfgFingerprintMix(
                out, int32(values[valueIndex].data[byteIndex]))
    return out

