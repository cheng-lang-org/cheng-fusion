@borrows
fn cleanupCfgFail(message: str) =
    panic(strings.CloneStr(message))

const
    CleanupRuntimeIntrinsicOwnershipRetainTag = 1
    CleanupRuntimeIntrinsicSnapshotRetainTag = 2
    CleanupRuntimeIntrinsicSnapshotCloneTag = 3
    CleanupRuntimeIntrinsicOwnershipDropTag = 4

fn cleanupCfgCidAppendI32(buf: var layout.ByteBuf,
                          value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn cleanupCfgCidAppendText(buf: var layout.ByteBuf,
                           value: str) =
    cleanupCfgCidAppendI32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(
            buf, int32(value[index]) & 255)

@borrows
fn cleanupCfgCidAppendI32Rows(buf: var layout.ByteBuf,
                              rows: int32[]) =
    cleanupCfgCidAppendI32(buf, rows.len)
    for row in 0..<rows.len:
        cleanupCfgCidAppendI32(buf, rows[row])

@borrows
fn cleanupCfgImmutableControlIdentityCid(
        bodyIR: coreir.BodyIR): layout.FixedBytes32 =
    if !bodyIR.controlFlowSealed ||
       !coreir.BodyIRControlFlowShapeValid(bodyIR):
        cleanupCfgFail(
            "cleanup_cfg: immutable control identity source invalid")
    var buf = layout.ByteBufInit(512)
    cleanupCfgCidAppendText(
        buf, "cheng.cleanup_cfg.immutable_control_identity.current")
    cleanupCfgCidAppendI32(buf, bodyIR.controlFunctionRow)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.controlScopeParentIds)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferDeclarationScopeIds)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferSuiteScopeIds)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferLexicalOrdinals)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferFunctionRows)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferStatementRows)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferActivationSiteStarts)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferActivationSiteCounts)
    cleanupCfgCidAppendI32Rows(
        buf, bodyIR.deferActivationRows)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn cleanupCfgRuntimeIntrinsicInterfaceCid(
        bodyIR: coreir.BodyIR,
        call: coreir.CallOp,
        actionKind: int32,
        typeArenaTypeId: int32): layout.FixedBytes32 =
    var expectedManagedStoreKind = coreir.ManagedStoreNoneTag
    var expectsResult: bool
    if actionKind == CleanupRuntimeIntrinsicOwnershipRetainTag:
        expectedManagedStoreKind = coreir.ManagedStoreCleanupRetainTag
    elif actionKind == CleanupRuntimeIntrinsicSnapshotRetainTag:
        expectedManagedStoreKind = coreir.ManagedStoreSnapshotRetainTag
        expectsResult = true
    elif actionKind == CleanupRuntimeIntrinsicSnapshotCloneTag:
        expectedManagedStoreKind = coreir.ManagedStoreSnapshotCloneTag
        expectsResult = true
    if actionKind < CleanupRuntimeIntrinsicOwnershipRetainTag ||
       actionKind > CleanupRuntimeIntrinsicOwnershipDropTag ||
       typeArenaTypeId < 0 ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.typeArenaArtifactCid) ||
       call.managedStoreKind != expectedManagedStoreKind ||
       call.argSlots.len != 1 || call.argPassKinds.len != 1 ||
       call.argAbiSizes.len != 1 || call.argAbiSizes[0] <= 0 ||
       call.argPassKinds[0] !=
           coreir.BodyCallPassByAddressAggregateTag ||
       !coreir.CallArgSlotIsAddress(call.argSlots[0]):
        cleanupCfgFail(
            "cleanup_cfg: runtime intrinsic authority invalid")
    let argumentSlot = coreir.CallArgSlotAddressId(call.argSlots[0])
    if argumentSlot < 0 || argumentSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[argumentSlot].typeArenaTypeId !=
           typeArenaTypeId:
        cleanupCfgFail(
            "cleanup_cfg: runtime intrinsic argument type invalid")
    var resultTypeId: int32 = -1
    if expectsResult:
        if call.resultSlot < 0 ||
           call.resultSlot >= bodyIR.localSlots.len ||
           call.resultPassKind != coreir.BodyCallPassSretResultTag ||
           call.resultOwnership != coreir.OwnMove ||
           bodyIR.localSlots[call.resultSlot].typeArenaTypeId !=
               typeArenaTypeId:
            cleanupCfgFail(
                "cleanup_cfg: runtime intrinsic result type invalid")
        resultTypeId =
            bodyIR.localSlots[call.resultSlot].typeArenaTypeId
    elif call.resultSlot != -1 ||
         call.resultPassKind != coreir.BodyCallPassStackValueTag ||
         call.resultOwnership != coreir.OwnInvalid:
        cleanupCfgFail(
            "cleanup_cfg: runtime intrinsic void result invalid")
    var buf = layout.ByteBufInit(192)
    cleanupCfgCidAppendText(
        buf, "cheng.body_ir.runtime_intrinsic.interface.current")
    cleanupCfgCidAppendI32(buf, actionKind)
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    cleanupCfgCidAppendI32(buf, typeArenaTypeId)
    cleanupCfgCidAppendI32(buf, call.managedStoreKind)
    cleanupCfgCidAppendI32(buf, call.resultPassKind)
    cleanupCfgCidAppendI32(buf, int32(call.resultOwnership))
    cleanupCfgCidAppendI32(buf, resultTypeId)
    cleanupCfgCidAppendI32(buf, 1)
    cleanupCfgCidAppendI32(buf, typeArenaTypeId)
    cleanupCfgCidAppendI32(buf, call.argPassKinds[0])
    cleanupCfgCidAppendI32(buf, call.argAbiSizes[0])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn cleanupCfgAppendCallWithTarget(
        bodyIR: var coreir.BodyIR,
        call: var coreir.CallOp,
        targetDomainKind: int32,
        targetRow: int32,
        targetInterfaceCid: layout.FixedBytes32): int32 =
    let callOrdinal = bodyIR.callSequence.len
    if bodyIR.controlFlowSealed ||
       bodyIR.callTargetDomainKinds.len != callOrdinal ||
       bodyIR.callTargetRows.len != callOrdinal ||
       bodyIR.callTargetInterfaceCids.len != callOrdinal ||
       !coreir.BodyIRCallTargetIdentityValid(
           targetDomainKind, targetRow) ||
       !coreir.BodyIRTypeArenaArtifactCidValid(targetInterfaceCid):
        cleanupCfgFail(
            "cleanup_cfg: atomic call target append invalid")
    add(bodyIR.callSequence, share(call))
    let targetInterfaceCidCopy =
        layout.FixedBytes32Copy(targetInterfaceCid)
    coreir.BodyIRControlFlowBindCallTarget(
        bodyIR,
        callOrdinal,
        targetDomainKind,
        targetRow,
        targetInterfaceCidCopy)
    return callOrdinal

@borrows
fn cleanupCfgControlEdgeKindValid(kind: int32): bool =
    return kind >= coreir.BodyControlEdgeNormal &&
           kind <= coreir.BodyControlEdgeLoopBack

fn cleanupCfgAppendTermExact(
        bodyIR: var coreir.BodyIR,
        term: coreir.BodyTerm,
        successorCount: int32,
        successor0: int32,
        edgeKind0: int32,
        successor1: int32,
        edgeKind1: int32): int32 =
    if successorCount < 0 || successorCount > 2 ||
       (successorCount == 0 &&
        term.kind != coreir.BodyTermReturnTag) ||
       (successorCount == 1 &&
        (term.kind != coreir.BodyTermBrTag ||
         term.trueBlock != successor0 ||
         !cleanupCfgControlEdgeKindValid(edgeKind0) ||
         edgeKind0 == coreir.BodyControlEdgeReturn)) ||
       (successorCount == 2 &&
        (term.kind != coreir.BodyTermCbrTag ||
         term.trueBlock != successor0 ||
         term.falseBlock != successor1 ||
         !cleanupCfgControlEdgeKindValid(edgeKind0) ||
         !cleanupCfgControlEdgeKindValid(edgeKind1) ||
         edgeKind0 == coreir.BodyControlEdgeReturn ||
         edgeKind1 == coreir.BodyControlEdgeReturn)):
        cleanupCfgFail("cleanup_cfg: exact term append contract invalid")
    let termIndex = coreir.BodyIRAppendTerm(bodyIR, term)
    var successorBlockIds: int32[]
    var edgeKinds: int32[]
    if successorCount >= 1:
        add(successorBlockIds, successor0)
        add(edgeKinds, edgeKind0)
    if successorCount == 2:
        add(successorBlockIds, successor1)
        add(edgeKinds, edgeKind1)
    coreir.BodyIRControlFlowBindTermSuccessors(
        bodyIR, termIndex, successorBlockIds, edgeKinds)
    return termIndex

fn cleanupCfgAppendBlockExact(
        bodyIR: var coreir.BodyIR,
        opStart: int32,
        opCount: int32,
        termIndex: int32,
        scopeId: int32): int32 =
    if scopeId < 0 ||
       scopeId >= bodyIR.controlScopeParentIds.len:
        cleanupCfgFail("cleanup_cfg: exact block scope invalid")
    let blockId = coreir.BodyIRAppendBlock(
        bodyIR, opStart, opCount, termIndex)
    coreir.BodyIRControlFlowBindBlockScope(
        bodyIR, blockId, scopeId)
    return blockId

@borrows
fn cleanupCfgControlTermEdgeKind(
        bodyIR: coreir.BodyIR,
        termIndex: int32,
        successorOrdinal: int32): int32 =
    if termIndex < 0 || termIndex >= bodyIR.terms.len ||
       termIndex >= bodyIR.termSuccessorStarts.len ||
       termIndex >= bodyIR.termSuccessorCounts.len:
        cleanupCfgFail("cleanup_cfg: exact term edge row invalid")
    let start = bodyIR.termSuccessorStarts[termIndex]
    let count = bodyIR.termSuccessorCounts[termIndex]
    if start < 0 || count < 0 ||
       count > bodyIR.successorEdgeKinds.len - start ||
       successorOrdinal < 0 || successorOrdinal >= count:
        cleanupCfgFail("cleanup_cfg: exact term edge ordinal invalid")
    return bodyIR.successorEdgeKinds[start + successorOrdinal]

# wall76: 托管 struct 行的 `var x = bodyIR.terms[i]` 是 move-out 读——
# 读出后源行整行置默认（wall71 A 点同族语义）。Exact replace 系列在
# 写回前对全表做联判，被 move-out 清零的目标行会被读成 invalid term
# （`body ir control flow: exact term source CSR invalid`）。本 helper
# 只做字段级标量读（let 语义，不清源行），构造等价副本。
@borrows
fn cleanupCfgReadBodyTermValue(bodyIR: var coreir.BodyIR,
                               termIndex: int32): coreir.BodyTerm =
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        cleanupCfgFail("cleanup_cfg: exact term read row invalid")
    var out: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(out)
    out.kind = bodyIR.terms[termIndex].kind
    out.conditionKind = bodyIR.terms[termIndex].conditionKind
    out.resultSlot = bodyIR.terms[termIndex].resultSlot
    out.sourceDefinitionDomain =
        bodyIR.terms[termIndex].sourceDefinitionDomain
    out.sourceDefinitionRow = bodyIR.terms[termIndex].sourceDefinitionRow
    out.lhsSlot = bodyIR.terms[termIndex].lhsSlot
    out.rhsSlot = bodyIR.terms[termIndex].rhsSlot
    out.trueBlock = bodyIR.terms[termIndex].trueBlock
    out.falseBlock = bodyIR.terms[termIndex].falseBlock
    for operandIndex in 0..<bodyIR.terms[termIndex].operands.len:
        add(out.operands, bodyIR.terms[termIndex].operands[operandIndex])
    return out

fn cleanupCfgReplaceTermExact(
        bodyIR: var coreir.BodyIR,
        termIndex: int32,
        term: coreir.BodyTerm,
        successorCount: int32,
        successor0: int32,
        edgeKind0: int32,
        successor1: int32,
        edgeKind1: int32) =
    var successorBlockIds: int32[]
    var edgeKinds: int32[]
    if successorCount >= 1:
        add(successorBlockIds, successor0)
        add(edgeKinds, edgeKind0)
    if successorCount == 2:
        add(successorBlockIds, successor1)
        add(edgeKinds, edgeKind1)
    if successorCount < 0 || successorCount > 2:
        cleanupCfgFail("cleanup_cfg: exact term replacement count invalid")
    coreir.BodyIRControlFlowReplaceTermExact(
        bodyIR, termIndex, term, successorBlockIds, edgeKinds)

@borrows
fn cleanupCfgExitControlEdgeKind(
        kind: odir.OwnershipDropEdgeKind): int32 =
    if kind == odir.OwnershipDropEdgeNormal:
        return coreir.BodyControlEdgeNormal
    if kind == odir.OwnershipDropEdgeReturn:
        return coreir.BodyControlEdgeReturn
    if kind == odir.OwnershipDropEdgeBreak:
        return coreir.BodyControlEdgeBreak
    if kind == odir.OwnershipDropEdgeContinue:
        return coreir.BodyControlEdgeContinue
    if kind == odir.OwnershipDropEdgeLoopBack:
        return coreir.BodyControlEdgeLoopBack
    cleanupCfgFail("cleanup_cfg: exact exit edge kind invalid")
    return coreir.BodyControlEdgeUnknown

@abi_internal
@importc("cheng_str_drop_owned")
fn cleanupCfgReleaseOwnedStringRaw(value: var str)

@borrows
fn cleanupCfgOwnedTextCopy(source: str): str =
    if len(source) == 0:
        return ""
    return NewStringCopy(source.data, len(source))

@borrows
fn cleanupCfgRequireNonNegative(value: int32, message: str) =
    if value < 0:
        cleanupCfgFail(message)

@borrows
fn cleanupCfgCheckedAdd(left: int32,
                        right: int32,
                        message: str): int32 =
    cleanupCfgRequireNonNegative(left, message)
    cleanupCfgRequireNonNegative(right, message)
    let value = int64(left) + int64(right)
    if value > int64(2147483647):
        cleanupCfgFail(message)
    return int32(value)

@borrows
fn cleanupCfgCheckedMul(left: int32,
                        right: int32,
                        message: str): int32 =
    cleanupCfgRequireNonNegative(left, message)
    cleanupCfgRequireNonNegative(right, message)
    let value = int64(left) * int64(right)
    if value > int64(2147483647):
        cleanupCfgFail(message)
    return int32(value)

fn cleanupCfgCheckedReportAdd(current: int32, delta: int32): int32 =
    return cleanupCfgCheckedAdd(
        current,
        delta,
        "cleanup_cfg: materialize report counter overflow")

@borrows
fn cleanupCfgCheckedSub(left: int32,
                        right: int32,
                        message: str): int32 =
    cleanupCfgRequireNonNegative(left, message)
    cleanupCfgRequireNonNegative(right, message)
    if right > left:
        cleanupCfgFail(message)
    return left - right

@borrows
fn cleanupCfgRequireNonNegative64(value: int64, message: str) =
    if value < int64(0):
        cleanupCfgFail(message)

@borrows
fn cleanupCfgCheckedAdd64(left: int64,
                          right: int64,
                          message: str): int64 =
    cleanupCfgRequireNonNegative64(left, message)
    cleanupCfgRequireNonNegative64(right, message)
    if left > int64(9223372036854775807) - right:
        cleanupCfgFail(message)
    return left + right

@borrows
fn cleanupCfgCheckedMul64(left: int64,
                          right: int64,
                          message: str): int64 =
    cleanupCfgRequireNonNegative64(left, message)
    cleanupCfgRequireNonNegative64(right, message)
    if left != int64(0) &&
       right > int64(9223372036854775807) / left:
        cleanupCfgFail(message)
    return left * right

fn cleanupCfgLimitBytes(count: int32, elementBytes: int64): int64 =
    cleanupCfgRequireNonNegative(count, "cleanup_cfg: negative limit")
    return cleanupCfgCheckedMul64(int64(count),
                                  elementBytes,
                                  "cleanup_cfg: limit byte overflow")

fn cleanupCfgAccumulateLimitBytes(total: var int64,
                                  count: int32,
                                  elementBytes: int64) =
    total = cleanupCfgCheckedAdd64(
        total,
        cleanupCfgLimitBytes(count, elementBytes),
        "cleanup_cfg: planner capacity byte overflow")

fn cleanupCfgLimitsCapacityBytes(limits: CleanupPlanLimits): int64 =
    var out: int64
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipPlaceBindingCount, int64(48))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipPlaceBindingCount, int64(4))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipFieldProjectionStepCount, int64(40))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipFieldBindingCount, int64(28))
    cleanupCfgAccumulateLimitBytes(out, limits.maxLocalSlotCount, int64(24))
    cleanupCfgAccumulateLimitBytes(out, limits.maxScopeCount, int64(16))
    cleanupCfgAccumulateLimitBytes(out, limits.maxDeferCount, int64(36))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipGuardProjectionCount, int64(20))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipPlaceBindingCount, int64(36))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipFieldBindingCount, int64(52))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipFieldProjectionStepCount, int64(36))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipDropGlueBindingCount, int64(48))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipDropGlueBindingCount, int64(40))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipConditionFlagBindingCount, int64(17))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipActionCount, int64(161))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipActionFlagRefCount, int64(4))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipFlagTransitionCount, int64(17))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipOpTransitionSiteCount, int64(36))
    cleanupCfgAccumulateLimitBytes(
        out, limits.maxOwnershipFlagTransitionCount, int64(4))
    cleanupCfgAccumulateLimitBytes(out, limits.maxExitCount, int64(121))
    cleanupCfgAccumulateLimitBytes(out, limits.maxExitDeferRefCount, int64(4))
    cleanupCfgAccumulateLimitBytes(out, limits.maxSourceBlockCount, int64(8))
    cleanupCfgAccumulateLimitBytes(out, limits.maxFragmentCount, int64(76))
    cleanupCfgAccumulateLimitBytes(out, limits.maxFragmentOpCount, int64(36))
    cleanupCfgAccumulateLimitBytes(out,
                                   limits.maxFragmentOperandCount,
                                   int64(4))
    cleanupCfgAccumulateLimitBytes(out, limits.maxFragmentCallCount, int64(124))
    cleanupCfgAccumulateLimitBytes(out,
                                   limits.maxFragmentCallArgCount,
                                   int64(12))
    cleanupCfgAccumulateLimitBytes(out, limits.maxFragmentBlockCount, int64(13))
    cleanupCfgAccumulateLimitBytes(out, limits.maxFragmentTermCount, int64(45))
    cleanupCfgAccumulateLimitBytes(out,
                                   limits.maxFragmentTermOperandCount,
                                   int64(4))
    cleanupCfgAccumulateLimitBytes(out, limits.maxFragmentCStringCount, int64(56))
    out = cleanupCfgCheckedAdd64(out,
                                 int64(limits.maxStringPayloadBytes),
                                 "cleanup_cfg: planner capacity byte overflow")
    return out

fn cleanupCfgRequireLimits(limits: CleanupPlanLimits) =
    cleanupCfgRequireNonNegative(limits.maxSourceBlockCount, "cleanup_cfg: source block limit")
    cleanupCfgRequireNonNegative(limits.maxLocalSlotCount, "cleanup_cfg: local limit")
    cleanupCfgRequireNonNegative(limits.maxScopeCount, "cleanup_cfg: scope limit")
    cleanupCfgRequireNonNegative(limits.maxDeferCount, "cleanup_cfg: defer limit")
    cleanupCfgRequireNonNegative(limits.maxExitCount, "cleanup_cfg: exit limit")
    cleanupCfgRequireNonNegative(limits.maxExitDeferRefCount, "cleanup_cfg: exit defer limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentCount, "cleanup_cfg: fragment limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentOpCount, "cleanup_cfg: fragment op limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentOperandCount, "cleanup_cfg: operand limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentCallCount, "cleanup_cfg: call limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentCallArgCount, "cleanup_cfg: call arg limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentBlockCount, "cleanup_cfg: block limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentTermCount, "cleanup_cfg: term limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentTermOperandCount, "cleanup_cfg: term operand limit")
    cleanupCfgRequireNonNegative(limits.maxFragmentCStringCount, "cleanup_cfg: cstring limit")
    cleanupCfgRequireNonNegative(limits.maxStringPayloadBytes, "cleanup_cfg: string byte limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedOpCount, "cleanup_cfg: materialized op limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedOperandCount, "cleanup_cfg: materialized operand limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedCallCount, "cleanup_cfg: materialized call limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedCallArgCount, "cleanup_cfg: materialized call arg limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedBlockCount, "cleanup_cfg: materialized block limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedTermCount, "cleanup_cfg: materialized term limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedTermOperandCount, "cleanup_cfg: materialized term operand limit")
    cleanupCfgRequireNonNegative(limits.maxMaterializedCStringCount, "cleanup_cfg: materialized cstring limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipGuardProjectionCount,
                                 "cleanup_cfg: ownership guard projection limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipPlaceBindingCount,
                                 "cleanup_cfg: ownership place binding limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipFieldBindingCount,
                                 "cleanup_cfg: ownership field binding limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipDropGlueBindingCount,
                                 "cleanup_cfg: ownership drop glue binding limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipConditionFlagBindingCount,
                                 "cleanup_cfg: ownership condition flag binding limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipActionCount,
                                 "cleanup_cfg: ownership action limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipActionFlagRefCount,
                                 "cleanup_cfg: ownership action flag-ref limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipFieldProjectionStepCount,
                                 "cleanup_cfg: ownership field projection limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipFlagTransitionCount,
                                 "cleanup_cfg: ownership flag transition limit")
    cleanupCfgRequireNonNegative(limits.maxOwnershipOpTransitionSiteCount,
                                 "cleanup_cfg: ownership op transition site limit")
    if limits.maxScopeCount <= 0 || limits.maxSourceBlockCount <= 0:
        cleanupCfgFail("cleanup_cfg: function limits require root scope and entry block")
    if limits.maxSourceBlockCount > 1073741823:
        cleanupCfgFail("cleanup_cfg: source edge index capacity overflow")

fn cleanupCfgReserveRows(rows: var T[], capacity: int32) =
    setLen(rows, capacity)
    setLen(rows, 0)

fn cleanupCfgStageTypeLayoutIndexPrepare(
        index: var CleanupTypeLayoutIndex,
        providerCid: str,
        maxTypeCount: int32,
        maxPhysicalFieldCount: int32,
        maxProjectionCount: int32,
        maxProjectionStepCount: int32) =
    if index.prepared || index.sealed || len(providerCid) == 0 ||
       maxTypeCount <= 0 || maxPhysicalFieldCount < 0 ||
       maxProjectionCount < 0 || maxProjectionStepCount < 0:
        cleanupCfgFail("cleanup_cfg: type layout index prepare invalid")
    index.providerCid = providerCid
    index.maxTypeCount = maxTypeCount
    index.maxPhysicalFieldCount = maxPhysicalFieldCount
    index.maxProjectionCount = maxProjectionCount
    index.maxProjectionStepCount = maxProjectionStepCount
    cleanupCfgReserveRows(index.typeLayoutCids, maxTypeCount)
    cleanupCfgReserveRows(index.typeArenaTypeIds, maxTypeCount)
    cleanupCfgReserveRows(index.typeKinds, maxTypeCount)
    cleanupCfgReserveRows(index.typeSizeBytes, maxTypeCount)
    cleanupCfgReserveRows(index.typeAlignBytes, maxTypeCount)
    cleanupCfgReserveRows(index.typePhysicalFieldStarts, maxTypeCount)
    cleanupCfgReserveRows(index.typePhysicalFieldCounts, maxTypeCount)
    cleanupCfgReserveRows(index.physicalFieldOwnerTypeIds,
                          maxPhysicalFieldCount)
    cleanupCfgReserveRows(index.physicalFieldOrdinals,
                          maxPhysicalFieldCount)
    cleanupCfgReserveRows(index.physicalFieldTypeIds,
                          maxPhysicalFieldCount)
    cleanupCfgReserveRows(index.physicalFieldByteOffsets,
                          maxPhysicalFieldCount)
    cleanupCfgReserveRows(index.typeProjectionStarts, maxTypeCount)
    cleanupCfgReserveRows(index.typeProjectionCounts, maxTypeCount)
    cleanupCfgReserveRows(index.projectionOwnerTypeIds, maxProjectionCount)
    cleanupCfgReserveRows(index.projectionFieldOrdinals, maxProjectionCount)
    cleanupCfgReserveRows(index.projectionPathStarts, maxProjectionCount)
    cleanupCfgReserveRows(index.projectionPathCounts, maxProjectionCount)
    cleanupCfgReserveRows(index.projectionPathOrdinals,
                          maxProjectionStepCount)
    index.prepared = true

fn cleanupCfgReleaseTypeLayoutIndexStorage(
        index: var CleanupTypeLayoutIndex) =
    seqs.freeSeqStrRelease(index.typeLayoutCids)
    seqs.freeSeq(index.typeArenaTypeIds)
    seqs.freeSeq(index.typeKinds)
    seqs.freeSeq(index.typeSizeBytes)
    seqs.freeSeq(index.typeAlignBytes)
    seqs.freeSeq(index.typePhysicalFieldStarts)
    seqs.freeSeq(index.typePhysicalFieldCounts)
    seqs.freeSeq(index.physicalFieldOwnerTypeIds)
    seqs.freeSeq(index.physicalFieldOrdinals)
    seqs.freeSeq(index.physicalFieldTypeIds)
    seqs.freeSeq(index.physicalFieldByteOffsets)
    seqs.freeSeq(index.typeProjectionStarts)
    seqs.freeSeq(index.typeProjectionCounts)
    seqs.freeSeq(index.projectionOwnerTypeIds)
    seqs.freeSeq(index.projectionFieldOrdinals)
    seqs.freeSeq(index.projectionPathStarts)
    seqs.freeSeq(index.projectionPathCounts)
    seqs.freeSeq(index.projectionPathOrdinals)

fn cleanupCfgCommitTypeLayoutIndexMutation(
        index: var CleanupTypeLayoutIndex,
        candidate: CleanupTypeLayoutIndex) =
    cleanupCfgReleaseTypeLayoutIndexStorage(index)
    index = candidate

fn cleanupCfgCloneI32Rows(source: var int32[], out: var int32[]) =
    out = []
    for rowIndex in 0..<source.len:
        add(out, source[rowIndex])

@borrows
fn cleanupCfgCloneTextRows(source: str[], out: var str[]) =
    out = []
    for rowIndex in 0..<source.len:
        add(out, strings.CloneStr(source[rowIndex]))

fn cleanupCfgBeginTypeLayoutIndexMutation(
        index: var CleanupTypeLayoutIndex,
        candidate: var CleanupTypeLayoutIndex) =
    candidate.prepared = index.prepared
    candidate.sealed = index.sealed
    candidate.providerCid = strings.CloneStr(index.providerCid)
    candidate.maxTypeCount = index.maxTypeCount
    candidate.maxPhysicalFieldCount = index.maxPhysicalFieldCount
    candidate.maxProjectionCount = index.maxProjectionCount
    candidate.maxProjectionStepCount = index.maxProjectionStepCount
    cleanupCfgCloneTextRows(index.typeLayoutCids, candidate.typeLayoutCids)
    cleanupCfgCloneI32Rows(index.typeArenaTypeIds,
                           candidate.typeArenaTypeIds)
    cleanupCfgCloneI32Rows(index.typeKinds, candidate.typeKinds)
    cleanupCfgCloneI32Rows(index.typeSizeBytes, candidate.typeSizeBytes)
    cleanupCfgCloneI32Rows(index.typeAlignBytes, candidate.typeAlignBytes)
    cleanupCfgCloneI32Rows(index.typePhysicalFieldStarts,
                           candidate.typePhysicalFieldStarts)
    cleanupCfgCloneI32Rows(index.typePhysicalFieldCounts,
                           candidate.typePhysicalFieldCounts)
    cleanupCfgCloneI32Rows(index.physicalFieldOwnerTypeIds,
                           candidate.physicalFieldOwnerTypeIds)
    cleanupCfgCloneI32Rows(index.physicalFieldOrdinals,
                           candidate.physicalFieldOrdinals)
    cleanupCfgCloneI32Rows(index.physicalFieldTypeIds,
                           candidate.physicalFieldTypeIds)
    cleanupCfgCloneI32Rows(index.physicalFieldByteOffsets,
                           candidate.physicalFieldByteOffsets)
    cleanupCfgCloneI32Rows(index.typeProjectionStarts,
                           candidate.typeProjectionStarts)
    cleanupCfgCloneI32Rows(index.typeProjectionCounts,
                           candidate.typeProjectionCounts)
    cleanupCfgCloneI32Rows(index.projectionOwnerTypeIds,
                           candidate.projectionOwnerTypeIds)
    cleanupCfgCloneI32Rows(index.projectionFieldOrdinals,
                           candidate.projectionFieldOrdinals)
    cleanupCfgCloneI32Rows(index.projectionPathStarts,
                           candidate.projectionPathStarts)
    cleanupCfgCloneI32Rows(index.projectionPathCounts,
                           candidate.projectionPathCounts)
    cleanupCfgCloneI32Rows(index.projectionPathOrdinals,
                           candidate.projectionPathOrdinals)

fn CleanupTypeLayoutIndexPrepare(index: var CleanupTypeLayoutIndex,
                                 providerCid: str,
                                 maxTypeCount: int32,
                                 maxPhysicalFieldCount: int32,
                                 maxProjectionCount: int32,
                                 maxProjectionStepCount: int32) =
    var candidate: CleanupTypeLayoutIndex
    cleanupCfgBeginTypeLayoutIndexMutation(index, candidate)
    cleanupCfgStageTypeLayoutIndexPrepare(candidate,
                                          providerCid,
                                          maxTypeCount,
                                          maxPhysicalFieldCount,
                                          maxProjectionCount,
                                          maxProjectionStepCount)
    cleanupCfgCommitTypeLayoutIndexMutation(index, candidate)

fn cleanupCfgRequireTypeLayoutIndexOpen(index: var CleanupTypeLayoutIndex) =
    if !index.prepared || index.sealed:
        cleanupCfgFail("cleanup_cfg: type layout index is not open")

fn cleanupCfgTypeLayoutIndexTypeRow(index: var CleanupTypeLayoutIndex,
                                    ownershipTypeId: int32): int32 =
    if ownershipTypeId <= 0 || ownershipTypeId > index.typeLayoutCids.len:
        cleanupCfgFail("cleanup_cfg: ownership type layout missing")
    let row = ownershipTypeId - 1
    if len(index.typeLayoutCids[row]) == 0:
        cleanupCfgFail("cleanup_cfg: ownership type layout missing")
    return row

fn cleanupCfgTypeLayoutIndexPhysicalFieldRow(
        index: var CleanupTypeLayoutIndex,
        ownershipTypeId: int32,
        fieldOrdinal: int32): int32 =
    let typeRow = cleanupCfgTypeLayoutIndexTypeRow(index, ownershipTypeId)
    let count = index.typePhysicalFieldCounts[typeRow]
    if fieldOrdinal < 0 || fieldOrdinal >= count:
        cleanupCfgFail("cleanup_cfg: type layout physical field missing")
    return cleanupCfgCheckedAdd(
        index.typePhysicalFieldStarts[typeRow],
        fieldOrdinal,
        "cleanup_cfg: type layout physical field row overflow")

fn cleanupCfgStageTypeLayoutIndexRegisterType(
        index: var CleanupTypeLayoutIndex,
        ownershipTypeId: int32,
        typeArenaTypeId: int32,
        layoutCid: str,
        typeKind: int32,
        sizeBytes: int32,
        alignBytes: int32,
        physicalFieldTypeIds: var int32[],
        physicalFieldByteOffsets: var int32[]) =
    cleanupCfgRequireTypeLayoutIndexOpen(index)
    # [wall133] ref 句柄臂（契约对齐零弱化）：ownership_body_ir_production
    # 准入白名单（LocalStrTag/LocalPtrTag/LocalAggregateTag，wall118 glue +
    # wall121 Verify 臂同文件先例）已把 ref 句柄槽（8B LocalPtrTag 载体，
    # layout 与 TypeArena 互证后）送进注册循环，本臂 kind 集合是漏同步的
    # 唯一下游。补 LocalPtrTag 与 wall121 逐列对齐；Ptr 槽无物理字段行，
    # (physicalFieldTypeIds.len > 0 && typeKind != Aggregate) 守卫原样兜住。
    # 其余非法 kind 仍 fail-closed（判词富化仅显性化，不改变 panic 语义）。
    if ownershipTypeId != index.typeLayoutCids.len + 1 ||
       typeArenaTypeId < 0 ||
       len(layoutCid) == 0 || sizeBytes <= 0 || alignBytes <= 0 ||
       sizeBytes % alignBytes != 0 ||
       physicalFieldTypeIds.len != physicalFieldByteOffsets.len ||
       (typeKind != coreir.LocalStrTag &&
        typeKind != coreir.LocalAggregateTag &&
        typeKind != coreir.LocalPtrTag) ||
       (physicalFieldTypeIds.len > 0 &&
        typeKind != coreir.LocalAggregateTag):
        cleanupCfgFail(Fmt"cleanup_cfg: type layout row invalid ownershipTypeId={ownershipTypeId} typeArenaTypeId={typeArenaTypeId} typeKind={typeKind} sizeBytes={sizeBytes} alignBytes={alignBytes} fieldCount={physicalFieldTypeIds.len} registered={index.typeLayoutCids.len}")
    if index.typeLayoutCids.len >= index.maxTypeCount:
        cleanupCfgFail("cleanup_cfg: type layout type arena exhausted")
    let fieldRemaining = cleanupCfgCheckedSub(
        index.maxPhysicalFieldCount,
        index.physicalFieldTypeIds.len,
        "cleanup_cfg: type layout physical field capacity underflow")
    if physicalFieldTypeIds.len > fieldRemaining:
        cleanupCfgFail("cleanup_cfg: type layout physical field arena exhausted")
    for fieldOrdinal in 0..<physicalFieldTypeIds.len:
        let childTypeId = physicalFieldTypeIds[fieldOrdinal]
        let childRow = cleanupCfgTypeLayoutIndexTypeRow(index, childTypeId)
        let byteOffset = physicalFieldByteOffsets[fieldOrdinal]
        let childSize = index.typeSizeBytes[childRow]
        let childAlign = index.typeAlignBytes[childRow]
        if byteOffset < 0 || byteOffset % childAlign != 0 ||
           byteOffset > cleanupCfgCheckedSub(
               sizeBytes,
               childSize,
               "cleanup_cfg: type layout field size underflow"):
            cleanupCfgFail("cleanup_cfg: type layout physical field invalid")
    let fieldStart = index.physicalFieldTypeIds.len
    add(index.typeLayoutCids, layoutCid)
    add(index.typeArenaTypeIds, typeArenaTypeId)
    add(index.typeKinds, typeKind)
    add(index.typeSizeBytes, sizeBytes)
    add(index.typeAlignBytes, alignBytes)
    add(index.typePhysicalFieldStarts, fieldStart)
    add(index.typePhysicalFieldCounts, physicalFieldTypeIds.len)
    add(index.typeProjectionStarts, -1)
    add(index.typeProjectionCounts, 0)
    for fieldOrdinal in 0..<physicalFieldTypeIds.len:
        add(index.physicalFieldOwnerTypeIds, ownershipTypeId)
        add(index.physicalFieldOrdinals, fieldOrdinal)
        add(index.physicalFieldTypeIds,
            physicalFieldTypeIds[fieldOrdinal])
        add(index.physicalFieldByteOffsets,
            physicalFieldByteOffsets[fieldOrdinal])

fn CleanupTypeLayoutIndexRegisterType(
        index: var CleanupTypeLayoutIndex,
        ownershipTypeId: int32,
        typeArenaTypeId: int32,
        layoutCid: str,
        typeKind: int32,
        sizeBytes: int32,
        alignBytes: int32,
        physicalFieldTypeIds: var int32[],
        physicalFieldByteOffsets: var int32[]) =
    var candidate: CleanupTypeLayoutIndex
    cleanupCfgBeginTypeLayoutIndexMutation(index, candidate)
    cleanupCfgStageTypeLayoutIndexRegisterType(candidate,
                                               ownershipTypeId,
                                               typeArenaTypeId,
                                               layoutCid,
                                               typeKind,
                                               sizeBytes,
                                               alignBytes,
                                               physicalFieldTypeIds,
                                               physicalFieldByteOffsets)
    cleanupCfgCommitTypeLayoutIndexMutation(index, candidate)

fn cleanupCfgStageTypeLayoutIndexRegisterProjection(
        index: var CleanupTypeLayoutIndex,
        ownershipTypeId: int32,
        fieldOrdinal: int32,
        pathOrdinals: var int32[]) =
    cleanupCfgRequireTypeLayoutIndexOpen(index)
    let ownerRow = cleanupCfgTypeLayoutIndexTypeRow(index, ownershipTypeId)
    if index.typeKinds[ownerRow] != coreir.LocalAggregateTag ||
       fieldOrdinal != index.typeProjectionCounts[ownerRow] ||
       pathOrdinals.len <= 0:
        cleanupCfgFail("cleanup_cfg: type layout projection identity invalid")
    let projectionRemaining = cleanupCfgCheckedSub(
        index.maxProjectionCount,
        index.projectionOwnerTypeIds.len,
        "cleanup_cfg: type layout projection capacity underflow")
    let stepRemaining = cleanupCfgCheckedSub(
        index.maxProjectionStepCount,
        index.projectionPathOrdinals.len,
        "cleanup_cfg: type layout projection step capacity underflow")
    if projectionRemaining <= 0 || pathOrdinals.len > stepRemaining:
        cleanupCfgFail("cleanup_cfg: type layout projection arena exhausted")
    var currentTypeId = ownershipTypeId
    for stepIndex in 0..<pathOrdinals.len:
        let stepOrdinal = pathOrdinals[stepIndex]
        let fieldRow = cleanupCfgTypeLayoutIndexPhysicalFieldRow(
            index,
            currentTypeId,
            stepOrdinal)
        currentTypeId = index.physicalFieldTypeIds[fieldRow]
    let leafRow = cleanupCfgTypeLayoutIndexTypeRow(index, currentTypeId)
    if index.typeKinds[leafRow] != coreir.LocalStrTag &&
       index.typeKinds[leafRow] != coreir.LocalAggregateTag:
        cleanupCfgFail("cleanup_cfg: type layout projection leaf unmanaged")
    let projectionRow = index.projectionOwnerTypeIds.len
    if index.typeProjectionStarts[ownerRow] < 0:
        index.typeProjectionStarts[ownerRow] = projectionRow
    elif index.typeProjectionStarts[ownerRow] +
         index.typeProjectionCounts[ownerRow] != projectionRow:
        cleanupCfgFail("cleanup_cfg: type layout projections are not canonical")
    add(index.projectionOwnerTypeIds, ownershipTypeId)
    add(index.projectionFieldOrdinals, fieldOrdinal)
    add(index.projectionPathStarts, index.projectionPathOrdinals.len)
    add(index.projectionPathCounts, pathOrdinals.len)
    for pathIndex in 0..<pathOrdinals.len:
        let pathOrdinal = pathOrdinals[pathIndex]
        add(index.projectionPathOrdinals, pathOrdinal)
    index.typeProjectionCounts[ownerRow] = cleanupCfgCheckedAdd(
        index.typeProjectionCounts[ownerRow],
        1,
        "cleanup_cfg: type layout projection count overflow")

fn CleanupTypeLayoutIndexRegisterProjection(
        index: var CleanupTypeLayoutIndex,
        ownershipTypeId: int32,
        fieldOrdinal: int32,
        pathOrdinals: var int32[]) =
    var candidate: CleanupTypeLayoutIndex
    cleanupCfgBeginTypeLayoutIndexMutation(index, candidate)
    cleanupCfgStageTypeLayoutIndexRegisterProjection(candidate,
                                                     ownershipTypeId,
                                                     fieldOrdinal,
                                                     pathOrdinals)
    cleanupCfgCommitTypeLayoutIndexMutation(index, candidate)

fn cleanupCfgStageTypeLayoutIndexSeal(index: var CleanupTypeLayoutIndex) =
    cleanupCfgRequireTypeLayoutIndexOpen(index)
    if index.typeLayoutCids.len <= 0 ||
       index.typeArenaTypeIds.len != index.typeLayoutCids.len ||
       index.typeKinds.len != index.typeLayoutCids.len ||
       index.typeSizeBytes.len != index.typeLayoutCids.len ||
       index.typeAlignBytes.len != index.typeLayoutCids.len ||
       index.typePhysicalFieldStarts.len != index.typeLayoutCids.len ||
       index.typePhysicalFieldCounts.len != index.typeLayoutCids.len ||
       index.typeProjectionStarts.len != index.typeLayoutCids.len ||
       index.typeProjectionCounts.len != index.typeLayoutCids.len ||
       index.physicalFieldOwnerTypeIds.len !=
           index.physicalFieldTypeIds.len ||
       index.physicalFieldOrdinals.len != index.physicalFieldTypeIds.len ||
       index.physicalFieldByteOffsets.len !=
           index.physicalFieldTypeIds.len ||
       index.projectionOwnerTypeIds.len !=
           index.projectionFieldOrdinals.len ||
       index.projectionOwnerTypeIds.len != index.projectionPathStarts.len ||
       index.projectionOwnerTypeIds.len != index.projectionPathCounts.len:
        cleanupCfgFail("cleanup_cfg: type layout index columns drift")
    var expectedPhysicalStart: int32
    var expectedProjectionStart: int32
    for typeRow in 0..<index.typeLayoutCids.len:
        if index.typePhysicalFieldStarts[typeRow] != expectedPhysicalStart:
            cleanupCfgFail("cleanup_cfg: type layout physical CSR drift")
        expectedPhysicalStart = cleanupCfgCheckedAdd(
            expectedPhysicalStart,
            index.typePhysicalFieldCounts[typeRow],
            "cleanup_cfg: type layout physical CSR overflow")
        let projectionCount = index.typeProjectionCounts[typeRow]
        let projectionStart = index.typeProjectionStarts[typeRow]
        if projectionCount == 0:
            if projectionStart != -1:
                cleanupCfgFail("cleanup_cfg: empty type projection CSR drift")
        else:
            if projectionStart != expectedProjectionStart:
                cleanupCfgFail("cleanup_cfg: type projection CSR drift")
            expectedProjectionStart = cleanupCfgCheckedAdd(
                expectedProjectionStart,
                projectionCount,
                "cleanup_cfg: type projection CSR overflow")
    if expectedPhysicalStart != index.physicalFieldTypeIds.len ||
       expectedProjectionStart != index.projectionOwnerTypeIds.len:
        cleanupCfgFail("cleanup_cfg: type layout CSR rows unconsumed")
    var expectedPathStart: int32
    for projectionRow in 0..<index.projectionOwnerTypeIds.len:
        if index.projectionPathStarts[projectionRow] != expectedPathStart ||
           index.projectionPathCounts[projectionRow] <= 0:
            cleanupCfgFail("cleanup_cfg: type layout projection path drift")
        expectedPathStart = cleanupCfgCheckedAdd(
            expectedPathStart,
            index.projectionPathCounts[projectionRow],
            "cleanup_cfg: type layout projection path overflow")
    if expectedPathStart != index.projectionPathOrdinals.len:
        cleanupCfgFail("cleanup_cfg: type layout path rows unconsumed")
    index.sealed = true

fn CleanupTypeLayoutIndexSeal(index: var CleanupTypeLayoutIndex) =
    var candidate: CleanupTypeLayoutIndex
    cleanupCfgBeginTypeLayoutIndexMutation(index, candidate)
    cleanupCfgStageTypeLayoutIndexSeal(candidate)
    cleanupCfgCommitTypeLayoutIndexMutation(index, candidate)

