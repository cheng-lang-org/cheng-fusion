    cleanupCfgFingerprintBoolSequenceField(
        out, columnCount, plan.ownershipActionGuardAuditSeen)
    cleanupCfgFingerprintBoolSequenceField(
        out, columnCount, plan.ownershipActionDeferClearAfterBody)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionClearFlagStarts)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionClearFlagCounts)
    cleanupCfgFingerprintI32SequenceField(
        out, columnCount, plan.ownershipActionClearFlagSlots)
    if columnCount !=
       CleanupPlanOwnershipActionFingerprintSchemaFieldCount():
        cleanupCfgFail("cleanup_cfg: ownership action fingerprint schema drift")
    return out

fn cleanupCfgOriginalSourceIdentityFingerprint(
        plan: var CleanupPlan): int64 =
    var out = int64(146959810)
    out = cleanupCfgFingerprintI32Sequence(
        out, plan.exitOriginalSourceBlockIds)
    out = cleanupCfgFingerprintI32Sequence(
        out, plan.exitSuccessorOrdinals)
    out = cleanupCfgFingerprintI32Sequence(
        out, plan.exitIdBySourceEdge)
    return out

fn CleanupPlanCanonicalFingerprint(plan: var CleanupPlan): int64 =
    var out = int64(146959810)
    var columnCount: int32
    cleanupCfgFingerprintColumnCount(columnCount)
    out = cleanupCfgFingerprintLimits(out, plan.limits)
    cleanupCfgFingerprintColumnCount(columnCount)
    out = cleanupCfgFingerprintArena(out, plan.arena)
    cleanupCfgFingerprintBoolField(out, columnCount, plan.prepared)
    cleanupCfgFingerprintBoolField(out, columnCount, plan.registrationsSealed)
    cleanupCfgFingerprintBoolField(out, columnCount, plan.localSchemaBound)
    cleanupCfgFingerprintBoolField(out, columnCount, plan.materialized)
