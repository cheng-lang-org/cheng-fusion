                                    values: var int32[]): int64 =
    var out = cleanupCfgFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        out = cleanupCfgFingerprintMix(out, value)
    return out

