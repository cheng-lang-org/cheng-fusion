import std/result
import std/rawbytes
import std/strings
import std/strutils as strutil
import std/crypto/sha256
import cheng/oracle/oracle_types
import cheng/core/csg_asset/oracle_asset as asset
import cheng/core/csg_core/json_canonical as canonical

const
    HyperliquidAllMidsSourceKind = "hyperliquid_all_mids"
    HyperliquidAllMidsSourceUri = "https://api.hyperliquid.xyz/info"
    HyperliquidAllMidsRequestBody = "{\"type\":\"allMids\"}"
    HyperliquidMidSourceFactKind = "csg_dialect::oracle_asset::hyperliquid_mid_source"

type
    HyperliquidMidSourceFact =
        id: str
        sourceKind: str
        sourceUri: str
        requestBodyHash: str
        rawResponseHash: str
        coin: str
        assetId: int32
        quoteId: int32
        pairId: int32
        priceE8: int64
        observedAtMs: int64
        roundId: int64
        factRoot: str

@borrows
fn hlCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn hlCat3(a: str, b: str, c: str): str =
    return hlCat(hlCat(a, b), c)

@borrows
fn hlCat4(a: str, b: str, c: str, d: str): str =
    return hlCat(hlCat3(a, b, c), d)

fn hlI32(value: int32): str =
    return strings.IntToStr(value)

fn hlI64(value: int64): str =
    return strings.Int64ToStr(value)

@borrows
fn hlCanonicalFactLine(raw: str): str =
    # Whole-fact-line canonical form (see assetCanonicalFactLine in
    # oracle_asset.cheng): authoritative canonicalizer output — keys
    # byte-order sorted, numbers canonical, plain values untouched.
    let roundTrip = canonical.CsgCoreJsonCanonicalize(raw)
    if !roundTrip.ok:
        panic(strings.CloneStr(roundTrip.error))
    return strings.CloneStr(roundTrip.value)

@borrows
fn hlHash(text: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(text))
    return hlCat("sha256:", rawbytes.BytesToHex(digest))

fn hlDigitValue(ch: char): int64 =
    if ch < '0' || ch > '9':
        return int64(-1)
    return int64(Int32(ch) - Int32('0'))

@borrows
fn HyperliquidParseDecimalE8(priceText: str): Result[int64] =
    if priceText.len <= 0:
        return Err[int64]("hyperliquid source: empty price")
    var whole: int64
    var frac: int64
    var fracDigits: int32
    var seenDigit: bool
    var seenDot: bool
    for i in 0..<priceText.len:
        let ch = priceText[i]
        if ch == '.':
            if seenDot:
                return Err[int64]("hyperliquid source: repeated decimal point")
            seenDot = true
            continue
        let digit = hlDigitValue(ch)
        if digit < int64(0):
            return Err[int64]("hyperliquid source: invalid price character")
        seenDigit = true
        if seenDot:
            if fracDigits >= 8:
                return Err[int64]("hyperliquid source: price has more than 8 decimals")
            frac = (frac * int64(10)) + digit
            fracDigits = fracDigits + 1
        else:
            whole = (whole * int64(10)) + digit
    if !seenDigit:
        return Err[int64]("hyperliquid source: no price digits")
    while fracDigits < 8:
        frac = frac * int64(10)
        fracDigits = fracDigits + 1
    let out = (whole * int64(100000000)) + frac
    if out <= int64(0):
        return Err[int64]("hyperliquid source: price must be positive")
    return Ok[int64](out)

@borrows
fn HyperliquidAllMidsPriceFromResponse(rawResponse: str,
                                       coin: str,
                                       assetId: oracle_types.OracleAssetId,
                                       quoteId: oracle_types.OracleQuoteId,
                                       observedAtMs: int64): Result[HyperliquidMidSourceFact] =
    if rawResponse.len <= 0:
        return Err[HyperliquidMidSourceFact]("hyperliquid source: empty response")
    if coin.len <= 0:
        return Err[HyperliquidMidSourceFact]("hyperliquid source: empty coin")
    if observedAtMs < int64(0):
        return Err[HyperliquidMidSourceFact]("hyperliquid source: bad observed time")
    let pairRes = oracle_types.OraclePairIdFromAssetQuote(assetId, quoteId)
    if IsErr(pairRes):
        return Err[HyperliquidMidSourceFact](Error(pairRes))
    let field = csgField(rawResponse, coin)
    if !field.ok:
        return Err[HyperliquidMidSourceFact](field.err.msg)
    let priceRes = HyperliquidParseDecimalE8(field.value)
    if IsErr(priceRes):
        return Err[HyperliquidMidSourceFact](Error(priceRes))

    var out: HyperliquidMidSourceFact
    out.sourceKind = HyperliquidAllMidsSourceKind
    out.sourceUri = HyperliquidAllMidsSourceUri
    out.requestBodyHash = hlHash(HyperliquidAllMidsRequestBody)
    out.rawResponseHash = hlHash(rawResponse)
    out.coin = coin
    out.assetId = assetId
    out.quoteId = quoteId
    out.pairId = Value(pairRes)
    out.priceE8 = Value(priceRes)
    out.observedAtMs = observedAtMs
    out.roundId = oracle_types.OracleRoundIdFromObservedAtMs(observedAtMs)
    out.id = hlCat4("hyperliquid_mid_", coin, "_round_", hlI64(out.roundId))
    out.factRoot = HyperliquidMidSourceFactRoot(share(out))
    return Ok[HyperliquidMidSourceFact](out)

@borrows
fn csgField(rawResponse: str, coin: str): Result[str] =
    let marker = hlCat3("\"", coin, "\":")
    var markerPos: int32 = -1
    let limit = rawResponse.len - marker.len
    var i: int32
    while i <= limit:
        var matched = true
        for j in 0..<marker.len:
            if rawResponse[i + j] != marker[j]:
                matched = false
                break
        if matched:
            markerPos = i
            break
        i = i + 1
    if markerPos < 0:
        return Err[str]("hyperliquid source: coin missing from allMids response")
    var valuePos = markerPos + marker.len
    while valuePos < rawResponse.len &&
        (rawResponse[valuePos] == ' ' || rawResponse[valuePos] == '\n' ||
         rawResponse[valuePos] == '\r' || rawResponse[valuePos] == '\t'):
        valuePos = valuePos + 1
    if valuePos >= rawResponse.len || rawResponse[valuePos] != '"':
        return Err[str]("hyperliquid source: mid price must be a JSON string")
    valuePos = valuePos + 1
    let start = valuePos
    while valuePos < rawResponse.len && rawResponse[valuePos] != '"':
        if rawResponse[valuePos] == '\\':
            return Err[str]("hyperliquid source: escaped price string unsupported")
        valuePos = valuePos + 1
    if valuePos >= rawResponse.len:
        return Err[str]("hyperliquid source: unterminated price string")
    return Ok[str](strings.CloneStr(strings.SliceBytes(rawResponse, start, valuePos - start)))

fn HyperliquidApplyMidToCompletePrices(source: HyperliquidMidSourceFact,
                                       basePricesE8: int64[]): Result[int64[]] =
    if basePricesE8.len != oracle_types.OraclePairCount:
        return Err[int64[]]("hyperliquid source: complete price vector required")
    let pairRes = oracle_types.OraclePairIdFromAssetQuote(source.assetId, source.quoteId)
    if IsErr(pairRes):
        return Err[int64[]](Error(pairRes))
    if Value(pairRes) != source.pairId:
        return Err[int64[]]("hyperliquid source: pair id mismatch")
    if source.priceE8 <= int64(0):
        return Err[int64[]]("hyperliquid source: non-positive parsed price")
    var out: int64[]
    for i in 0..<basePricesE8.len:
        if basePricesE8[i] <= int64(0):
            return Err[int64[]]("hyperliquid source: base vector has non-positive price")
        add(out, basePricesE8[i])
    out[oracle_types.OraclePairIndex(source.pairId)] = source.priceE8
    return Ok[int64[]](out)

fn HyperliquidMidSourceFactPreimage(fact: HyperliquidMidSourceFact): str =
    return strutil.Join([
        "schema=csg_dialect::oracle_asset::v1",
        "\nkind=hyperliquid_mid_source",
        "\nid=", strings.CloneStr(fact.id),
        "\nsourceKind=", strings.CloneStr(fact.sourceKind),
        "\nsourceUri=", strings.CloneStr(fact.sourceUri),
        "\nrequestBodyHash=", strings.CloneStr(fact.requestBodyHash),
        "\nrawResponseHash=", strings.CloneStr(fact.rawResponseHash),
        "\ncoin=", strings.CloneStr(fact.coin),
        "\nassetId=", hlI32(fact.assetId),
        "\nquoteId=", hlI32(fact.quoteId),
        "\npairId=", hlI32(fact.pairId),
        "\npriceE8=", hlI64(fact.priceE8)
    ], "")

fn HyperliquidMidSourceFactRoot(fact: HyperliquidMidSourceFact): str =
    return asset.AssetSha256(hlCat(hlCat(hlCat(HyperliquidMidSourceFactPreimage(fact),
                                               "\nobservedAtMs="),
                                    hlI64(fact.observedAtMs)),
                            hlCat("\nroundId=", hlI64(fact.roundId))))

fn HyperliquidMidSourceFactJson(fact: HyperliquidMidSourceFact): str =
    var out = hlCat4("{\"kind\":\"", HyperliquidMidSourceFactKind, "\",", "")
    out = hlCat(out, hlCat4("\"id\":\"", strings.CloneStr(fact.id), "\",", ""))
    out = hlCat(out, hlCat4("\"sourceKind\":\"", strings.CloneStr(fact.sourceKind), "\",", ""))
    out = hlCat(out, hlCat4("\"sourceUri\":\"", strings.CloneStr(fact.sourceUri), "\",", ""))
    out = hlCat(out, hlCat4("\"requestBodyHash\":\"", strings.CloneStr(fact.requestBodyHash), "\",", ""))
    out = hlCat(out, hlCat4("\"rawResponseHash\":\"", strings.CloneStr(fact.rawResponseHash), "\",", ""))
    out = hlCat(out, hlCat4("\"coin\":\"", strings.CloneStr(fact.coin), "\",", ""))
    out = hlCat(out, hlCat3("\"assetId\":", hlI32(fact.assetId), ","))
    out = hlCat(out, hlCat3("\"quoteId\":", hlI32(fact.quoteId), ","))
    out = hlCat(out, hlCat3("\"pairId\":", hlI32(fact.pairId), ","))
    out = hlCat(out, hlCat3("\"priceE8\":", hlI64(fact.priceE8), ","))
    out = hlCat(out, hlCat3("\"observedAtMs\":", hlI64(fact.observedAtMs), ","))
    out = hlCat(out, hlCat3("\"roundId\":", hlI64(fact.roundId), ","))
    out = hlCat(out, hlCat4("\"factRoot\":\"", fact.factRoot, "\"", "}"))
    return hlCanonicalFactLine(out)
