fn CsgAssetFactsDebugLines(observation: OracleAssetObservation,
                           cert: UnimakerProductCertificate,
                           candidate: VexaAssetCandidate): str[] =
    var lines: str[]
    add(lines, "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"oracle-asset\",\"unimaker-product\",\"vexa\"]}")
    add(lines, OracleAssetObservationFactJson(observation))
    add(lines, UnimakerProductCertificateFactJson(cert))
    add(lines, VexaAssetCandidateFactJson(candidate))
    return lines

fn CsgAssetClosedLoopFactsDebugLines(observation: OracleAssetObservation,
                                     cert: UnimakerProductCertificate,
                                     candidate: VexaAssetCandidate,
                                     plan: VexaDeterministicPlan,
                                     receipt: VexaExecutionReceipt,
                                     cell: VexaRecoverableCell): str[] =
    var lines: str[]
    add(lines, "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"oracle-asset\",\"unimaker-product\",\"vexa\",\"vexa-plan\",\"execution-receipt\",\"recoverable-cell\"]}")
    add(lines, OracleAssetObservationFactJson(observation))
    add(lines, UnimakerProductCertificateFactJson(cert))
    add(lines, VexaAssetCandidateFactJson(candidate))
    add(lines, VexaDeterministicPlanFactJson(plan))
    add(lines, VexaExecutionReceiptFactJson(receipt))
    add(lines, VexaRecoverableCellFactJson(cell))
    return lines

fn CsgAssetFinanceClosedLoopFactsDebugLines(sourceFactLine: str,
                                           observation: OracleAssetObservation,
                                           candidate: VexaAssetCandidate,
                                           plan: VexaDeterministicPlan,
                                           receipt: VexaExecutionReceipt,
                                           cell: VexaRecoverableCell): str[] =
    var lines: str[]
    add(lines, "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"oracle-asset\",\"external-source-proof\",\"vexa\",\"vexa-plan\",\"execution-receipt\",\"recoverable-cell\"]}")
    add(lines, sourceFactLine)
    add(lines, OracleAssetObservationFactJson(observation))
    add(lines, VexaAssetCandidateFactJson(candidate))
    add(lines, VexaDeterministicPlanFactJson(plan))
    add(lines, VexaExecutionReceiptFactJson(receipt))
    add(lines, VexaRecoverableCellFactJson(cell))
    return lines

fn csgAssetCsgcCargoFail(error: str): CsgAssetCsgcCargo =
    var out: CsgAssetCsgcCargo
    out.error = error
    return out

fn csgAssetAdmissionError(
        admission: csg.CsgCoreValidationResult): str =
    var reason = "csg asset: production admission failed"
    if admission.errors.len > 0:
        reason = assetCat3(reason, " ", admission.errors[0])
    return reason

fn CsgAssetProductionAdmitFactLines(
        lines: str[]): csg.CsgCoreValidationResult =
    return csg.CsgCoreProductionAdmitFactLines(lines)

fn CsgAssetAdmitAndEncodeCsgc(
        lines: str[]): CsgAssetCsgcCargo =
    let admission =
        CsgAssetProductionAdmitFactLines(lines)
    if !admission.valid || !admission.complete:
        return csgAssetCsgcCargoFail(
            csgAssetAdmissionError(admission))
    if admission.factsRoot.len == 0:
        return csgAssetCsgcCargoFail(
            "csg asset: admitted facts root is missing")
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return csgAssetCsgcCargoFail(
            assetCat(
                "csg asset: CSGC encode failed ",
                encoded.error))
    if encoded.factCount != admission.factCount:
        rawbytes.BytesFree(encoded.bytes)
        return csgAssetCsgcCargoFail(
            "csg asset: admitted and encoded fact counts differ")
    var out: CsgAssetCsgcCargo
    out.ok = true
    out.factsRoot =
        strings.CloneStr(admission.factsRoot)
    out.bytes = encoded.bytes
    out.headerSize = encoded.headerSize
    out.flags = encoded.flags
    out.factCount = encoded.factCount
    out.dictionaryCount = encoded.dictionaryCount
    return out

fn CsgAssetFactsRoot(lines: str[]): str =
    let admission =
        CsgAssetProductionAdmitFactLines(lines)
    if !admission.valid || !admission.complete:
        return ""
    return strings.CloneStr(admission.factsRoot)

fn CsgAssetEncodeCsgc(lines: str[]): csgc.CsgCoreCsgcBytesResult =
    let cargo = CsgAssetAdmitAndEncodeCsgc(lines)
    var out: csgc.CsgCoreCsgcBytesResult
    if !cargo.ok:
        out.error = strings.CloneStr(cargo.error)
        return out
    out.ok = true
    out.bytes = cargo.bytes
    out.headerSize = cargo.headerSize
    out.flags = cargo.flags
    out.factCount = cargo.factCount
    out.dictionaryCount = cargo.dictionaryCount
    return out
