import std/result
import std/rawbytes
import std/crypto/sha256
import std/strings
import std/strutils as strutil
import std/crypto/ecnist
import cheng/std/bytes_layout as layout
import cheng/std/crypto/fixed256
import cheng/oracle/oracle_types
import cheng/oracle/oracle_plane
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as canonical

const
    OracleAssetDialectProfile = "csg_dialect::oracle_asset"
    OracleAssetDialectVersion = "csg_dialect::oracle_asset::v1"
    UnimakerProductDialectProfile = "csg_dialect::unimaker_product"
    UnimakerProductDialectVersion = "csg_dialect::unimaker_product::v1"
    VexaDialectProfile = "csg_dialect::vexa"
    VexaDialectVersion = "csg_dialect::vexa::v1"

    AssetKindProduct = "product"
    AssetKindFinance = "finance"
    AssetKindCompute = "compute"
    AssetKindMedia = "media"

    AssetTrustUnverified = "unverified"
    AssetTrustAttested = "attested"
    AssetTrustCollateralized = "collateralized"
    AssetTrustObserved = "observed"
    AssetTrustVerified = "verified"

type
    OracleAssetObservation =
        id: str
        sourceKind: str
        sourceUri: str
        subjectId: str
        valueHash: str
        observedAtMs: int64
        ttlMs: int64
        reporterCount: int32
        quorum: int32
        appHash: str
        receiptHash: str

    UnimakerProductSourceClaim =
        id: str
        productId: str
        sourceId: str
        sellerId: str
        titleHash: str
        licenseHash: str
        mediaAssetCid: str
        priceE8: int64
        inventory: int64
        observedAtMs: int64
        ttlMs: int64
        oracleReceiptHash: str
        signerHash: str
        authorized: bool

    UnimakerProductSignedSourceClaim =
        claim: UnimakerProductSourceClaim
        signerPubKey: layout.FixedBytes65
        signature: layout.FixedBytes64

    UnimakerProductCertificate =
        id: str
        productId: str
        complete: bool
        trustLevel: str
        productRoot: str
        oracleReceiptHash: str
        mediaAssetCid: str
        priceE8: int64
        inventory: int64
        validUntilMs: int64
        receiptHash: str

    VexaAssetCandidate =
        id: str
        assetKind: str
        sourceProfile: str
        subjectId: str
        trustLevel: str
        factRoot: str
        collateralHash: str
        capabilityHash: str
        riskHash: str
        eligibleForPlan: bool
        reason: str

    VexaDeterministicPlan =
        id: str
        complete: bool
        assetId: str
        assetFactRoot: str
        actionKind: str
        preconditionHash: str
        capabilityHash: str
        riskHash: str
        createdAtMs: int64
        validUntilMs: int64
        planRoot: str
        proofHash: str

    VexaExecutionReceipt =
        id: str
        planRoot: str
        executorId: str
        executionStateHash: str
        outputStateHash: str
        executedAtMs: int64
        status: str
        receiptHash: str

    VexaRecoverableCell =
        id: str
        factsRoot: str
        planRoot: str
        receiptHash: str
        stateRoot: str
        resumeTokenHash: str
        recoveryRoot: str
        complete: bool

    CsgAssetCsgcCargo =
        ok: bool
        factsRoot: str
        bytes: rawbytes.Bytes
        headerSize: int32
        flags: int32
        factCount: int32
        dictionaryCount: int32
        error: str

@borrows
fn assetCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn assetCat3(a: str, b: str, c: str): str =
    return assetCat(assetCat(a, b), c)

fn assetCat4(a: str, b: str, c: str, d: str): str =
    return assetCat(assetCat3(a, b, c), d)

fn assetBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn assetI32(value: int32): str =
    return strings.IntToStr(value)

fn assetI64(value: int64): str =
    return strings.Int64ToStr(value)

@borrows
fn assetCanonicalFactLine(raw: str): str =
    # Whole-fact-line canonical form, produced by the authoritative
    # canonicalizer itself: keys are byte-order sorted and every number
    # token is rewritten to its canonical form (1000 -> 1e3; values
    # whose plain form is canonical stay byte-identical).  Replay
    # admission proves per-line canonicality, so the emitted fact line
    # must already be canonical.  (UniMaker innovation emitter
    # precedent: innovation_csg.cheng innovationCanonical.)
    let roundTrip = canonical.CsgCoreJsonCanonicalize(raw)
    if !roundTrip.ok:
        panic(strings.CloneStr(roundTrip.error))
    return strings.CloneStr(roundTrip.value)

@borrows
fn assetLine(key: str, value: str): str =
    return assetCat3(key, "=", value)

@borrows
fn assetAddLine(lines: var str[], key: str, value: str) =
    add(lines, assetLine(key, value))

fn assetJoin(lines: str[]): str =
    return strutil.Join(lines, "\n")

fn AssetSha256(preimage: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(preimage))
    return assetCat("sha256:", rawbytes.BytesToHex(digest))

@borrows
fn AssetHashLooksValid(hashText: str): bool =
    if hashText.len <= 7:
        return false
    return strings.HasPrefix(hashText, "sha256:")

@borrows
fn assetRequireHash(hashText: str, label: str): Result[bool] =
    if !AssetHashLooksValid(hashText):
        var out: Result[bool]
        out.ok = false
        out.err.code = 1
        out.err.msg = assetCat("csg asset: invalid hash field ", label)
        return out
    var out: Result[bool]
    out.ok = true
    out.value = true
    return out

@borrows
fn assetRequireNonEmpty(value: str, label: str): Result[bool] =
    if value.len == 0:
        var out: Result[bool]
        out.ok = false
        out.err.code = 1
        out.err.msg = assetCat("csg asset: empty field ", label)
        return out
    var out: Result[bool]
    out.ok = true
    out.value = true
    return out

fn assetCertErr(message: str): Result[UnimakerProductCertificate] =
    var out: Result[UnimakerProductCertificate]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn assetCertOk(value: UnimakerProductCertificate): Result[UnimakerProductCertificate] =
    var out: Result[UnimakerProductCertificate]
    out.ok = true
    out.value = value
    return out

fn assetCandidateErr(message: str): Result[VexaAssetCandidate] =
    var out: Result[VexaAssetCandidate]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn assetCandidateOk(value: VexaAssetCandidate): Result[VexaAssetCandidate] =
    var out: Result[VexaAssetCandidate]
    out.ok = true
    out.value = value
    return out

fn assetPlanErr(message: str): Result[VexaDeterministicPlan] =
    var out: Result[VexaDeterministicPlan]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn assetPlanOk(value: VexaDeterministicPlan): Result[VexaDeterministicPlan] =
    var out: Result[VexaDeterministicPlan]
    out.ok = true
    out.value = value
    return out

fn assetExecutionErr(message: str): Result[VexaExecutionReceipt] =
    var out: Result[VexaExecutionReceipt]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn assetExecutionOk(value: VexaExecutionReceipt): Result[VexaExecutionReceipt] =
    var out: Result[VexaExecutionReceipt]
    out.ok = true
    out.value = value
    return out

fn assetCellErr(message: str): Result[VexaRecoverableCell] =
    var out: Result[VexaRecoverableCell]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn assetCellOk(value: VexaRecoverableCell): Result[VexaRecoverableCell] =
    var out: Result[VexaRecoverableCell]
    out.ok = true
    out.value = value
    return out

fn AssetTrustLevelKnown(trustLevel: str): bool =
    if trustLevel == AssetTrustUnverified:
        return true
    if trustLevel == AssetTrustAttested:
        return true
    if trustLevel == AssetTrustCollateralized:
        return true
    if trustLevel == AssetTrustObserved:
        return true
    if trustLevel == AssetTrustVerified:
        return true
    return false

fn VexaTrustEligibleForPlan(trustLevel: str): bool =
    if trustLevel == AssetTrustCollateralized:
        return true
    if trustLevel == AssetTrustObserved:
        return true
    if trustLevel == AssetTrustVerified:
        return true
    return false

fn OracleAssetObservationExpired(observation: OracleAssetObservation, nowMs: int64): bool =
    if observation.ttlMs <= int64(0):
        return true
    return nowMs > observation.observedAtMs + observation.ttlMs

fn OracleAssetObservationValidate(observation: OracleAssetObservation, nowMs: int64): Result[bool] =
    if observation.reporterCount <= 0:
        var out: Result[bool]
        out.ok = false
        out.err.code = 1
        out.err.msg = "csg asset: oracle observation reporter count must be positive"
        return out
    if observation.quorum <= 0 || observation.quorum > observation.reporterCount:
        var out: Result[bool]
        out.ok = false
        out.err.code = 1
        out.err.msg = "csg asset: oracle observation quorum invalid"
        return out
    if OracleAssetObservationExpired(observation, nowMs):
        var out: Result[bool]
        out.ok = false
        out.err.code = 1
        out.err.msg = "csg asset: oracle observation expired"
        return out
    let sourceKindOk = assetRequireNonEmpty(observation.sourceKind, "sourceKind")
    if !sourceKindOk.ok:
        return sourceKindOk
    let sourceOk = assetRequireNonEmpty(observation.sourceUri, "sourceUri")
    if !sourceOk.ok:
        return sourceOk
    let subjectOk = assetRequireNonEmpty(observation.subjectId, "subjectId")
    if !subjectOk.ok:
        return subjectOk
    let valueOk = assetRequireHash(observation.valueHash, "valueHash")
    if !valueOk.ok:
        return valueOk
    let appOk = assetRequireHash(observation.appHash, "appHash")
    if !appOk.ok:
        return appOk
    let receiptOk = assetRequireHash(observation.receiptHash, "receiptHash")
    if !receiptOk.ok:
        return receiptOk
    var out: Result[bool]
    out.ok = true
    out.value = true
    return out

fn UnimakerProductClaimExpired(claim: UnimakerProductSourceClaim, nowMs: int64): bool =
    if claim.ttlMs <= int64(0):
        return true
    return nowMs > claim.observedAtMs + claim.ttlMs

fn OracleAssetObservationPreimage(observation: OracleAssetObservation): str =
    var lines: str[]
    assetAddLine(lines, "schema", OracleAssetDialectVersion)
    assetAddLine(lines, "kind", "observation")
    assetAddLine(lines, "id", observation.id)
    assetAddLine(lines, "sourceKind", observation.sourceKind)
    assetAddLine(lines, "sourceUri", observation.sourceUri)
    assetAddLine(lines, "subjectId", observation.subjectId)
    assetAddLine(lines, "valueHash", observation.valueHash)
    assetAddLine(lines, "observedAtMs", assetI64(observation.observedAtMs))
    assetAddLine(lines, "ttlMs", assetI64(observation.ttlMs))
    assetAddLine(lines, "reporterCount", assetI32(observation.reporterCount))
    assetAddLine(lines, "quorum", assetI32(observation.quorum))
    assetAddLine(lines, "appHash", observation.appHash)
    assetAddLine(lines, "receiptHash", observation.receiptHash)
    return assetJoin(lines)

fn OracleAssetObservationHash(observation: OracleAssetObservation): str =
    return AssetSha256(OracleAssetObservationPreimage(observation))

fn OracleAssetPriceSubjectId(assetId: oracle_types.OracleAssetId,
                             quoteId: oracle_types.OracleQuoteId): str =
    let pairRes = oracle_types.OraclePairIdFromAssetQuote(assetId, quoteId)
    if IsErr(pairRes):
        return ""
    return assetCat3("oracle_price_pair_", assetI32(Value(pairRes)), "")

fn OracleAssetLatestPriceValueHash(query: oracle_types.OracleLatestQueryResult): str =
    var lines: str[]
    assetAddLine(lines, "schema", OracleAssetDialectVersion)
    assetAddLine(lines, "kind", "latest_price_value")
    assetAddLine(lines, "pairId", assetI32(query.pairId))
    assetAddLine(lines, "roundId", assetI64(query.roundId))
    assetAddLine(lines, "priceE8", assetI64(query.priceE8))
    assetAddLine(lines, "height", assetI64(query.height))
    assetAddLine(lines, "appHash", assetCat("sha256:", layout.FixedBytes32Hex(query.appHash)))
    return AssetSha256(assetJoin(lines))

fn assetSortI64(values: var int64[]) =
    for i in 1..<values.len:
        let key = values[i]
        var j = i - 1
        while j >= 0 && values[j] > key:
            values[j + 1] = values[j]
            j = j - 1
        values[j + 1] = key

fn OracleAssetQuorumPriceAppHash(committeeSetId: int32,
                                 pairId: oracle_types.OraclePairId,
                                 roundId: int64,
                                 medianPriceE8: int64,
                                 reporterSeen: bool[oracle_types.OracleCommitteeMax],
                                 reporterBatchCids: layout.FixedBytes32[oracle_types.OracleCommitteeMax]): str =
    var lines: str[]
    assetAddLine(lines, "schema", OracleAssetDialectVersion)
    assetAddLine(lines, "kind", "quorum_price_app")
    assetAddLine(lines, "committeeSetId", assetI32(committeeSetId))
    assetAddLine(lines, "pairId", assetI32(pairId))
    assetAddLine(lines, "roundId", assetI64(roundId))
    assetAddLine(lines, "medianPriceE8", assetI64(medianPriceE8))
    for i in 0..<oracle_types.OracleCommitteeMax:
        if reporterSeen[i]:
            assetAddLine(lines,
                         assetCat("reporter", assetI32(i + 1)),
                         layout.FixedBytes32Hex(reporterBatchCids[i]))
    return AssetSha256(assetJoin(lines))

fn OracleAssetQuorumPriceValueHash(pairId: oracle_types.OraclePairId,
                                   roundId: int64,
                                   medianPriceE8: int64,
                                   appHash: str): str =
    var lines: str[]
    assetAddLine(lines, "schema", OracleAssetDialectVersion)
    assetAddLine(lines, "kind", "quorum_price_value")
    assetAddLine(lines, "pairId", assetI32(pairId))
    assetAddLine(lines, "roundId", assetI64(roundId))
    assetAddLine(lines, "medianPriceE8", assetI64(medianPriceE8))
    assetAddLine(lines, "appHash", appHash)
    return AssetSha256(assetJoin(lines))

fn OracleAssetSignedBatchVerifyAgainstCommittee(batch: var oracle_plane.OracleSignedBatch,
                                                committee: var oracle_types.OracleCommitteeConfig): Result[bool] =
    if committee.committeeSetId != batch.committeeSetId:
        return Err[bool]("csg asset: signed oracle wrong committee set")
    if batch.reporterSlot <= 0 || batch.reporterSlot > committee.reporterCount:
        return Err[bool]("csg asset: signed oracle reporter outside committee")
    let reporterIndex = batch.reporterSlot - 1
    var pubKey: layout.FixedBytes65
    for i in 0..<layout.FixedBytes65Size:
        pubKey.data[i] = committee.reporterPubKeys[reporterIndex].data[i]
    let pubBytes = layout.FixedBytes65ToBytes(pubKey)
    return oracle_plane.OracleSignedBatchVerify(batch, pubBytes)

fn OracleAssetSignedBatchVerifyAgainstPubKeys(batch: var oracle_plane.OracleSignedBatch,
                                              committeeSetId: int32,
                                              reporterPubKeys: layout.FixedBytes65[]): Result[bool] =
    if committeeSetId != batch.committeeSetId:
        return Err[bool]("csg asset: signed oracle wrong committee set")
    if batch.reporterSlot <= 0 || batch.reporterSlot > reporterPubKeys.len:
        return Err[bool]("csg asset: signed oracle reporter outside pubkey set")
    let pubKey = reporterPubKeys[batch.reporterSlot - 1]
    let pubBytes = layout.FixedBytes65ToBytes(pubKey)
    return oracle_plane.OracleSignedBatchVerify(batch, pubBytes)

fn OracleAssetObservationFromSignedPriceBatchesWithPubKeys(batches: oracle_plane.OracleSignedBatch[],
                                                           committeeSetId: int32,
                                                           quorum: int32,
                                                           reporterPubKeys: layout.FixedBytes65[],
                                                           assetId: oracle_types.OracleAssetId,
                                                           quoteId: oracle_types.OracleQuoteId,
                                                           sourceUri: str,
                                                           ttlMs: int64): Result[OracleAssetObservation] =
    if committeeSetId <= 0:
        return Err[OracleAssetObservation]("csg asset: signed oracle invalid committee set")
    if quorum <= 0 || quorum > reporterPubKeys.len:
        return Err[OracleAssetObservation]("csg asset: signed oracle invalid quorum")
    if batches.len < quorum:
        return Err[OracleAssetObservation]("csg asset: signed oracle batch quorum missing")
    if ttlMs <= int64(0):
        return Err[OracleAssetObservation]("csg asset: invalid oracle observation ttl")
    if sourceUri.len <= 0:
        return Err[OracleAssetObservation]("csg asset: empty signed oracle source uri")
    let pairRes = oracle_types.OraclePairIdFromAssetQuote(assetId, quoteId)
    if IsErr(pairRes):
        return Err[OracleAssetObservation](Error(pairRes))
    let pairId = Value(pairRes)
    let pairIndex = oracle_types.OraclePairIndex(pairId)
    let subjectId = OracleAssetPriceSubjectId(assetId, quoteId)
    if subjectId.len <= 0:
        return Err[OracleAssetObservation]("csg asset: empty signed oracle subject")

    var reporterSeen: bool[oracle_types.OracleCommitteeMax]
    var reporterBatchCids: layout.FixedBytes32[oracle_types.OracleCommitteeMax]
    var prices: int64[]
    var roundId = int64(-1)
    var observedMinAtMs = int64(-1)
    var observedMaxAtMs = int64(-1)
    var acceptedCount: int32

    for i in 0..<batches.len:
        var batch = batches[i]
        let verifyRes = OracleAssetSignedBatchVerifyAgainstPubKeys(batch, committeeSetId, reporterPubKeys)
        if IsErr(verifyRes):
            return Err[OracleAssetObservation](Error(verifyRes))
        if batch.pricesE8.len != oracle_types.OraclePairCount:
            return Err[OracleAssetObservation]("csg asset: signed oracle bad pair count")
        if roundId < int64(0):
            roundId = batch.roundId
            observedMinAtMs = batch.observedAtMs
            observedMaxAtMs = batch.observedAtMs
        else:
            if batch.roundId != roundId:
                return Err[OracleAssetObservation]("csg asset: signed oracle mixed rounds")
            if batch.observedAtMs < observedMinAtMs:
                observedMinAtMs = batch.observedAtMs
            if batch.observedAtMs > observedMaxAtMs:
                observedMaxAtMs = batch.observedAtMs
        let reporterIndex = batch.reporterSlot - 1
        if reporterIndex < 0 || reporterIndex >= oracle_types.OracleCommitteeMax:
            return Err[OracleAssetObservation]("csg asset: signed oracle reporter outside committee")
        if reporterSeen[reporterIndex]:
            return Err[OracleAssetObservation]("csg asset: signed oracle duplicate reporter")
        reporterSeen[reporterIndex] = true
        reporterBatchCids[reporterIndex] = batch.batchCid
        add(prices, batch.pricesE8[pairIndex])
        acceptedCount = acceptedCount + 1

    if acceptedCount < quorum:
        return Err[OracleAssetObservation]("csg asset: signed oracle quorum not reached")
    assetSortI64(prices)
    let medianPrice = prices[prices.len / 2]
    let appHash = OracleAssetQuorumPriceAppHash(committeeSetId,
                                                pairId,
                                                roundId,
                                                medianPrice,
                                                reporterSeen,
                                                reporterBatchCids)

    var out: OracleAssetObservation
    out.id = assetCat3("obs_", subjectId, assetCat("_round_", assetI64(roundId)))
    out.sourceKind = "oracle_signed_price_quorum"
    out.sourceUri = sourceUri
    out.subjectId = subjectId
    out.valueHash = OracleAssetQuorumPriceValueHash(pairId, roundId, medianPrice, appHash)
    out.observedAtMs = observedMaxAtMs
    out.ttlMs = ttlMs
    out.reporterCount = acceptedCount
    out.quorum = quorum
    out.appHash = appHash
    out.receiptHash = AssetSha256(OracleAssetObservationPreimage(out))
    return Ok[OracleAssetObservation](out)

fn OracleAssetObservationFromSignedPriceBatches(batches: oracle_plane.OracleSignedBatch[],
                                                committee: oracle_types.OracleCommitteeConfig,
                                                assetId: oracle_types.OracleAssetId,
                                                quoteId: oracle_types.OracleQuoteId,
                                                sourceUri: str,
                                                ttlMs: int64): Result[OracleAssetObservation] =
    var reporterPubKeys: layout.FixedBytes65[]
    for reporterIndex in 0..<committee.reporterCount:
        var pubKey: layout.FixedBytes65
        for i in 0..<layout.FixedBytes65Size:
            pubKey.data[i] = committee.reporterPubKeys[reporterIndex].data[i]
        add(reporterPubKeys, pubKey)
    return OracleAssetObservationFromSignedPriceBatchesWithPubKeys(batches,
                                                                   committee.committeeSetId,
                                                                   committee.quorum,
                                                                   reporterPubKeys,
                                                                   assetId,
                                                                   quoteId,
                                                                   sourceUri,
                                                                   ttlMs)

fn OracleAssetObservationFromLatestPrice(query: oracle_types.OracleLatestQueryResult,
                                         assetId: oracle_types.OracleAssetId,
                                         quoteId: oracle_types.OracleQuoteId,
                                         sourceUri: str,
                                         ttlMs: int64): Result[OracleAssetObservation] =
    if query.code != 0:
        return Err[OracleAssetObservation]("csg asset: latest oracle query not ok")
    if !query.available || query.stale:
        return Err[OracleAssetObservation]("csg asset: latest oracle query unavailable")
    if ttlMs <= int64(0):
        return Err[OracleAssetObservation]("csg asset: invalid oracle observation ttl")
    let pairRes = oracle_types.OraclePairIdFromAssetQuote(assetId, quoteId)
    if IsErr(pairRes):
        return Err[OracleAssetObservation](Error(pairRes))
    if query.pairId != Value(pairRes):
        return Err[OracleAssetObservation]("csg asset: latest oracle pair mismatch")
    let subjectId = OracleAssetPriceSubjectId(assetId, quoteId)
    if subjectId.len <= 0:
        return Err[OracleAssetObservation]("csg asset: empty latest oracle subject")
    if sourceUri.len <= 0:
        return Err[OracleAssetObservation]("csg asset: empty latest oracle source uri")
    if query.reporterCount <= 0:
        return Err[OracleAssetObservation]("csg asset: latest oracle reporter count invalid")

    var out: OracleAssetObservation
    out.id = assetCat3("obs_", subjectId, assetCat("_round_", assetI64(query.roundId)))
    out.sourceKind = "oracle_bft_latest_price"
    out.sourceUri = sourceUri
    out.subjectId = subjectId
    out.valueHash = OracleAssetLatestPriceValueHash(query)
    out.observedAtMs = oracle_types.OracleRoundEndMs(query.roundId)
    out.ttlMs = ttlMs
    out.reporterCount = query.reporterCount
    out.quorum = query.reporterCount
    out.appHash = assetCat("sha256:", layout.FixedBytes32Hex(query.appHash))
    out.receiptHash = AssetSha256(OracleAssetObservationPreimage(out))
    return Ok[OracleAssetObservation](out)

fn UnimakerProductClaimPreimage(claim: UnimakerProductSourceClaim): str =
    var lines: str[]
    assetAddLine(lines, "schema", UnimakerProductDialectVersion)
    assetAddLine(lines, "kind", "source_claim")
    assetAddLine(lines, "id", claim.id)
    assetAddLine(lines, "productId", claim.productId)
    assetAddLine(lines, "sourceId", claim.sourceId)
    assetAddLine(lines, "sellerId", claim.sellerId)
    assetAddLine(lines, "titleHash", claim.titleHash)
    assetAddLine(lines, "licenseHash", claim.licenseHash)
    assetAddLine(lines, "mediaAssetCid", claim.mediaAssetCid)
    assetAddLine(lines, "priceE8", assetI64(claim.priceE8))
    assetAddLine(lines, "inventory", assetI64(claim.inventory))
    assetAddLine(lines, "observedAtMs", assetI64(claim.observedAtMs))
    assetAddLine(lines, "ttlMs", assetI64(claim.ttlMs))
    assetAddLine(lines, "oracleReceiptHash", claim.oracleReceiptHash)
    assetAddLine(lines, "signerHash", claim.signerHash)
    assetAddLine(lines, "authorized", assetBool(claim.authorized))
    return assetJoin(lines)

fn UnimakerProductClaimHash(claim: UnimakerProductSourceClaim): str =
    return AssetSha256(UnimakerProductClaimPreimage(claim))

fn UnimakerProductSignerHash(signerPubKey: layout.FixedBytes65): str =
    return AssetSha256(assetCat("p256-uncompressed:", layout.FixedBytes65Hex(signerPubKey)))

fn UnimakerProductSignedClaimSignablePreimage(claim: UnimakerProductSourceClaim): str =
    var lines: str[]
    assetAddLine(lines, "schema", UnimakerProductDialectVersion)
    assetAddLine(lines, "kind", "signed_source_claim")
    assetAddLine(lines, "claimRoot", UnimakerProductClaimHash(claim))
    assetAddLine(lines, "id", claim.id)
    assetAddLine(lines, "productId", claim.productId)
    assetAddLine(lines, "sourceId", claim.sourceId)
    assetAddLine(lines, "sellerId", claim.sellerId)
    assetAddLine(lines, "signerHash", claim.signerHash)
    return assetJoin(lines)

fn UnimakerProductSignedClaimSignableBytes(claim: UnimakerProductSourceClaim): rawbytes.Bytes =
    let preimage = UnimakerProductSignedClaimSignablePreimage(claim)
    let view = rawbytes.BytesFromString(preimage)
    return rawbytes.BytesSlice(view, 0, rawbytes.BytesLen(view))

@borrows
fn UnimakerProductSignedSourceClaimVerify(signedClaim: UnimakerProductSignedSourceClaim): Result[bool] =
    if !fixed256.P256Signature64Valid(signedClaim.signature):
        return Err[bool]("csg asset: product signer signature invalid")
    let expectedSignerHash = UnimakerProductSignerHash(signedClaim.signerPubKey)
    if signedClaim.claim.signerHash != expectedSignerHash:
        return Err[bool]("csg asset: product signer hash does not match public key")
    let pubBytes = layout.FixedBytes65ToBytes(signedClaim.signerPubKey)
    let msg = UnimakerProductSignedClaimSignableBytes(signedClaim.claim)
    let sigBytes = layout.FixedBytes64ToBytes(signedClaim.signature)
    if !ecnist.ecdsaVerifyTrustedBytes(pubBytes, msg, sigBytes):
        return Err[bool]("csg asset: product claim signature verification failed")
    return Ok[bool](true)

fn UnimakerProductSignedSourceClaimVerifyTrusted(signedClaim: UnimakerProductSignedSourceClaim,
                                                 trustedSignerHash: str): Result[bool] =
    let trustedOk = assetRequireHash(trustedSignerHash, "trustedSignerHash")
    if !trustedOk.ok:
        return Err[bool](trustedOk.err.msg)
    let verifyRes = UnimakerProductSignedSourceClaimVerify(signedClaim)
    if IsErr(verifyRes):
        return verifyRes
    if signedClaim.claim.signerHash != trustedSignerHash:
        return Err[bool]("csg asset: product signer is not trusted for publish request")
    return Ok[bool](true)

fn UnimakerProductSignedSourceClaimMake(claim: UnimakerProductSourceClaim,
                                        signerPrivate: fixed256.Scalar256,
                                        signerPubKey: layout.FixedBytes65): Result[UnimakerProductSignedSourceClaim] =
    var boundClaim = claim
    boundClaim.signerHash = UnimakerProductSignerHash(signerPubKey)
    let signable = UnimakerProductSignedClaimSignableBytes(boundClaim)
    let sigRes = fixed256.P256SignMessageFixed64(signerPrivate, signable)
    if IsErr(sigRes):
        return Err[UnimakerProductSignedSourceClaim](Error(sigRes))
    var out: UnimakerProductSignedSourceClaim
    out.claim = boundClaim
    out.signerPubKey = signerPubKey
    out.signature = Value(sigRes)
    let verifyRes = UnimakerProductSignedSourceClaimVerify(out)
    if IsErr(verifyRes):
        return Err[UnimakerProductSignedSourceClaim](Error(verifyRes))
    return Ok[UnimakerProductSignedSourceClaim](out)

@borrows
fn UnimakerProductObservationValueHash(claim: UnimakerProductSourceClaim): str =
    return UnimakerProductClaimHash(claim)

fn UnimakerProductCertificatePreimage(cert: UnimakerProductCertificate): str =
    var lines: str[]
    assetAddLine(lines, "schema", UnimakerProductDialectVersion)
    assetAddLine(lines, "kind", "certificate")
    assetAddLine(lines, "id", cert.id)
    assetAddLine(lines, "productId", cert.productId)
    assetAddLine(lines, "complete", assetBool(cert.complete))
    assetAddLine(lines, "trustLevel", cert.trustLevel)
    assetAddLine(lines, "productRoot", cert.productRoot)
    assetAddLine(lines, "oracleReceiptHash", cert.oracleReceiptHash)
    assetAddLine(lines, "mediaAssetCid", cert.mediaAssetCid)
    assetAddLine(lines, "priceE8", assetI64(cert.priceE8))
    assetAddLine(lines, "inventory", assetI64(cert.inventory))
    assetAddLine(lines, "validUntilMs", assetI64(cert.validUntilMs))
    return assetJoin(lines)

fn UnimakerProductCertificateHash(cert: UnimakerProductCertificate): str =
    return AssetSha256(UnimakerProductCertificatePreimage(cert))

fn UnimakerCompileProductCertificate(claim: UnimakerProductSourceClaim,
                                     nowMs: int64): Result[UnimakerProductCertificate] =
    if !claim.authorized:
        return assetCertErr("csg asset: product source not authorized")
    if claim.priceE8 <= int64(0):
        return assetCertErr("csg asset: product price must be positive")
    if claim.inventory <= int64(0):
        return assetCertErr("csg asset: product inventory must be positive")
    if UnimakerProductClaimExpired(claim, nowMs):
        return assetCertErr("csg asset: product claim expired")
    let productIdOk = assetRequireNonEmpty(claim.productId, "productId")
    if !productIdOk.ok:
        return assetCertErr(productIdOk.err.msg)
    let sourceIdOk = assetRequireNonEmpty(claim.sourceId, "sourceId")
    if !sourceIdOk.ok:
        return assetCertErr(sourceIdOk.err.msg)
    let sellerIdOk = assetRequireNonEmpty(claim.sellerId, "sellerId")
    if !sellerIdOk.ok:
        return assetCertErr(sellerIdOk.err.msg)
    let mediaOk = assetRequireNonEmpty(claim.mediaAssetCid, "mediaAssetCid")
    if !mediaOk.ok:
        return assetCertErr(mediaOk.err.msg)
    let titleOk = assetRequireHash(claim.titleHash, "titleHash")
    if !titleOk.ok:
        return assetCertErr(titleOk.err.msg)
    let licenseOk = assetRequireHash(claim.licenseHash, "licenseHash")
    if !licenseOk.ok:
        return assetCertErr(licenseOk.err.msg)
    let oracleOk = assetRequireHash(claim.oracleReceiptHash, "oracleReceiptHash")
    if !oracleOk.ok:
        return assetCertErr(oracleOk.err.msg)
    let signerOk = assetRequireHash(claim.signerHash, "signerHash")
    if !signerOk.ok:
        return assetCertErr(signerOk.err.msg)

    var cert: UnimakerProductCertificate
    cert.id = assetCat("cert_", claim.productId)
    cert.productId = claim.productId
    cert.complete = true
    cert.trustLevel = AssetTrustVerified
    cert.productRoot = UnimakerProductClaimHash(claim)
    cert.oracleReceiptHash = claim.oracleReceiptHash
    cert.mediaAssetCid = claim.mediaAssetCid
    cert.priceE8 = claim.priceE8
    cert.inventory = claim.inventory
    cert.validUntilMs = claim.observedAtMs + claim.ttlMs
    cert.receiptHash = UnimakerProductCertificateHash(cert)
    return assetCertOk(cert)

fn UnimakerCompileProductCertificateFromObservation(claim: UnimakerProductSourceClaim,
                                                    observation: OracleAssetObservation,
                                                    nowMs: int64): Result[UnimakerProductCertificate] =
    let observationOk = OracleAssetObservationValidate(observation, nowMs)
    if !observationOk.ok:
        return assetCertErr(observationOk.err.msg)
    if claim.sourceId != observation.id:
        return assetCertErr("csg asset: product claim source does not match oracle observation")
    if claim.productId != observation.subjectId:
        return assetCertErr("csg asset: product id does not match oracle subject")
    if claim.oracleReceiptHash != observation.receiptHash:
        return assetCertErr("csg asset: product oracle receipt does not match observation")
    if observation.valueHash != UnimakerProductObservationValueHash(claim):
        return assetCertErr("csg asset: product claim hash does not match oracle observation")
    return UnimakerCompileProductCertificate(claim, nowMs)

fn UnimakerCompileProductCertificateFromSignedObservation(signedClaim: UnimakerProductSignedSourceClaim,
                                                          trustedSignerHash: str,
                                                          observation: OracleAssetObservation,
                                                          nowMs: int64): Result[UnimakerProductCertificate] =
    let verifyRes = UnimakerProductSignedSourceClaimVerifyTrusted(signedClaim, trustedSignerHash)
    if IsErr(verifyRes):
        return assetCertErr(Error(verifyRes))
    return UnimakerCompileProductCertificateFromObservation(signedClaim.claim, observation, nowMs)

fn VexaAssetFromProductCertificate(cert: UnimakerProductCertificate): Result[VexaAssetCandidate] =
    if !cert.complete:
        return assetCandidateErr("csg asset: incomplete product certificate")
    if !AssetTrustLevelKnown(cert.trustLevel):
        return assetCandidateErr("csg asset: unknown trust level")
    let productRootOk = assetRequireHash(cert.productRoot, "productRoot")
    if !productRootOk.ok:
        return assetCandidateErr(productRootOk.err.msg)
    let receiptOk = assetRequireHash(cert.receiptHash, "receiptHash")
    if !receiptOk.ok:
        return assetCandidateErr(receiptOk.err.msg)
    var candidate: VexaAssetCandidate
    candidate.id = assetCat("vexa_asset_", cert.productId)
    candidate.assetKind = AssetKindProduct
    candidate.sourceProfile = UnimakerProductDialectProfile
    candidate.subjectId = cert.productId
    candidate.trustLevel = cert.trustLevel
    candidate.factRoot = cert.receiptHash
    candidate.collateralHash = cert.oracleReceiptHash
    candidate.capabilityHash = AssetSha256(assetCat("unimaker.publish:", cert.productId))
    candidate.riskHash = AssetSha256(assetCat("risk.product.price.inventory:", assetCat(assetI64(cert.priceE8), assetI64(cert.inventory))))
    candidate.eligibleForPlan = VexaTrustEligibleForPlan(cert.trustLevel)
    if candidate.eligibleForPlan:
        candidate.reason = "trusted_asset_ready"
    else:
        candidate.reason = "trust_level_not_eligible"
    return assetCandidateOk(candidate)

fn VexaAssetFromOracleObservation(observation: OracleAssetObservation,
                                  nowMs: int64): Result[VexaAssetCandidate] =
    let observationOk = OracleAssetObservationValidate(observation, nowMs)
    if !observationOk.ok:
        return assetCandidateErr(observationOk.err.msg)
    var candidate: VexaAssetCandidate
    candidate.id = assetCat("vexa_asset_", observation.subjectId)
    candidate.assetKind = AssetKindFinance
    candidate.sourceProfile = OracleAssetDialectProfile
    candidate.subjectId = observation.subjectId
    candidate.trustLevel = AssetTrustObserved
    candidate.factRoot = observation.receiptHash
    candidate.collateralHash = observation.appHash
    candidate.capabilityHash = AssetSha256(assetCat("vexa.finance.price_oracle:", observation.subjectId))
    candidate.riskHash = AssetSha256(assetCat(assetCat(assetCat("risk.finance.oracle:",
                                                                 observation.sourceKind),
                                                      ":"),
                                             assetCat(assetI32(observation.quorum),
                                                      assetI32(observation.reporterCount))))
    candidate.eligibleForPlan = VexaTrustEligibleForPlan(candidate.trustLevel)
    if candidate.eligibleForPlan:
        candidate.reason = "observed_finance_asset_ready"
    else:
        candidate.reason = "trust_level_not_eligible"
    return assetCandidateOk(candidate)

fn VexaDeterministicPlanPreimage(plan: VexaDeterministicPlan): str =
    var lines: str[]
    assetAddLine(lines, "schema", VexaDialectVersion)
    assetAddLine(lines, "kind", "deterministic_plan")
    assetAddLine(lines, "id", plan.id)
    assetAddLine(lines, "complete", assetBool(plan.complete))
    assetAddLine(lines, "assetId", plan.assetId)
    assetAddLine(lines, "assetFactRoot", plan.assetFactRoot)
    assetAddLine(lines, "actionKind", plan.actionKind)
    assetAddLine(lines, "preconditionHash", plan.preconditionHash)
    assetAddLine(lines, "capabilityHash", plan.capabilityHash)
    assetAddLine(lines, "riskHash", plan.riskHash)
    assetAddLine(lines, "createdAtMs", assetI64(plan.createdAtMs))
    assetAddLine(lines, "validUntilMs", assetI64(plan.validUntilMs))
    return assetJoin(lines)

fn VexaDeterministicPlanRoot(plan: VexaDeterministicPlan): str =
    return AssetSha256(VexaDeterministicPlanPreimage(plan))

fn VexaDeterministicPlanProofHash(plan: VexaDeterministicPlan): str =
    return AssetSha256(assetCat("proof:", VexaDeterministicPlanRoot(plan)))

fn VexaCompileDeterministicPlan(candidate: VexaAssetCandidate,
                                factsRoot: str,
                                actionKind: str,
                                preconditionHash: str,
                                createdAtMs: int64,
                                validUntilMs: int64): Result[VexaDeterministicPlan] =
    if !candidate.eligibleForPlan:
        return assetPlanErr("csg asset: Vexa asset not eligible for deterministic plan")
    if validUntilMs <= createdAtMs:
        return assetPlanErr("csg asset: Vexa plan validUntil must be after createdAt")
    if actionKind.len == 0:
        return assetPlanErr("csg asset: missing Vexa plan action kind")
    let factsRootOk = assetRequireHash(factsRoot, "factsRoot")
    if !factsRootOk.ok:
        return assetPlanErr(factsRootOk.err.msg)
    let candidateRootOk = assetRequireHash(candidate.factRoot, "candidate.factRoot")
    if !candidateRootOk.ok:
        return assetPlanErr(candidateRootOk.err.msg)
    let preconditionOk = assetRequireHash(preconditionHash, "preconditionHash")
    if !preconditionOk.ok:
        return assetPlanErr(preconditionOk.err.msg)
    let capabilityOk = assetRequireHash(candidate.capabilityHash, "candidate.capabilityHash")
    if !capabilityOk.ok:
        return assetPlanErr(capabilityOk.err.msg)
    let riskOk = assetRequireHash(candidate.riskHash, "candidate.riskHash")
    if !riskOk.ok:
        return assetPlanErr(riskOk.err.msg)
    var plan: VexaDeterministicPlan
    plan.id = assetCat("vexa_plan_", candidate.subjectId)
    plan.complete = true
    plan.assetId = candidate.id
    plan.assetFactRoot = factsRoot
    plan.actionKind = actionKind
    plan.preconditionHash = preconditionHash
    plan.capabilityHash = candidate.capabilityHash
    plan.riskHash = candidate.riskHash
    plan.createdAtMs = createdAtMs
    plan.validUntilMs = validUntilMs
    plan.planRoot = VexaDeterministicPlanRoot(plan)
    plan.proofHash = VexaDeterministicPlanProofHash(plan)
    return assetPlanOk(plan)

fn VexaExecutionReceiptPreimage(receipt: VexaExecutionReceipt): str =
    var lines: str[]
    assetAddLine(lines, "schema", VexaDialectVersion)
    assetAddLine(lines, "kind", "execution_receipt")
    assetAddLine(lines, "id", receipt.id)
    assetAddLine(lines, "planRoot", receipt.planRoot)
    assetAddLine(lines, "executorId", receipt.executorId)
    assetAddLine(lines, "executionStateHash", receipt.executionStateHash)
    assetAddLine(lines, "outputStateHash", receipt.outputStateHash)
    assetAddLine(lines, "executedAtMs", assetI64(receipt.executedAtMs))
    assetAddLine(lines, "status", receipt.status)
    return assetJoin(lines)

fn VexaExecutionReceiptHash(receipt: VexaExecutionReceipt): str =
    return AssetSha256(VexaExecutionReceiptPreimage(receipt))

fn VexaCommitExecutionReceipt(plan: VexaDeterministicPlan,
                              executorId: str,
                              executionStateHash: str,
                              outputStateHash: str,
                              executedAtMs: int64,
                              status: str): Result[VexaExecutionReceipt] =
    if !plan.complete:
        return assetExecutionErr("csg asset: incomplete Vexa plan")
    if plan.planRoot != VexaDeterministicPlanRoot(plan):
        return assetExecutionErr("csg asset: Vexa plan root mismatch")
    if plan.proofHash != VexaDeterministicPlanProofHash(plan):
        return assetExecutionErr("csg asset: Vexa plan proof mismatch")
    if executedAtMs < plan.createdAtMs || executedAtMs > plan.validUntilMs:
        return assetExecutionErr("csg asset: Vexa execution outside plan validity")
    if executorId.len == 0:
        return assetExecutionErr("csg asset: missing Vexa executor id")
    if status != "committed":
        return assetExecutionErr("csg asset: unsupported Vexa execution status")
    let executionOk = assetRequireHash(executionStateHash, "executionStateHash")
    if !executionOk.ok:
        return assetExecutionErr(executionOk.err.msg)
    let outputOk = assetRequireHash(outputStateHash, "outputStateHash")
    if !outputOk.ok:
        return assetExecutionErr(outputOk.err.msg)
    var receipt: VexaExecutionReceipt
    receipt.id = assetCat("exec_", plan.id)
    receipt.planRoot = plan.planRoot
    receipt.executorId = executorId
    receipt.executionStateHash = executionStateHash
    receipt.outputStateHash = outputStateHash
    receipt.executedAtMs = executedAtMs
    receipt.status = status
    receipt.receiptHash = VexaExecutionReceiptHash(receipt)
    return assetExecutionOk(receipt)

fn VexaRecoverableCellPreimage(cell: VexaRecoverableCell): str =
    var lines: str[]
    assetAddLine(lines, "schema", VexaDialectVersion)
    assetAddLine(lines, "kind", "recoverable_cell")
    assetAddLine(lines, "id", cell.id)
    assetAddLine(lines, "factsRoot", cell.factsRoot)
    assetAddLine(lines, "planRoot", cell.planRoot)
    assetAddLine(lines, "receiptHash", cell.receiptHash)
    assetAddLine(lines, "stateRoot", cell.stateRoot)
    assetAddLine(lines, "resumeTokenHash", cell.resumeTokenHash)
    assetAddLine(lines, "complete", assetBool(cell.complete))
    return assetJoin(lines)

fn VexaRecoverableCellRoot(cell: VexaRecoverableCell): str =
    return AssetSha256(VexaRecoverableCellPreimage(cell))

fn VexaBuildRecoverableCell(factsRoot: str,
                            plan: VexaDeterministicPlan,
                            receipt: VexaExecutionReceipt,
                            resumeTokenHash: str): Result[VexaRecoverableCell] =
    if !plan.complete:
        return assetCellErr("csg asset: incomplete Vexa plan cannot form Cell")
    if plan.planRoot != receipt.planRoot:
        return assetCellErr("csg asset: receipt plan root mismatch")
    if receipt.receiptHash != VexaExecutionReceiptHash(receipt):
        return assetCellErr("csg asset: execution receipt hash mismatch")
    let factsOk = assetRequireHash(factsRoot, "factsRoot")
    if !factsOk.ok:
        return assetCellErr(factsOk.err.msg)
    let resumeOk = assetRequireHash(resumeTokenHash, "resumeTokenHash")
    if !resumeOk.ok:
        return assetCellErr(resumeOk.err.msg)
    var cell: VexaRecoverableCell
    cell.id = assetCat("cell_", plan.id)
    cell.factsRoot = factsRoot
    cell.planRoot = plan.planRoot
    cell.receiptHash = receipt.receiptHash
    cell.stateRoot = receipt.outputStateHash
    cell.resumeTokenHash = resumeTokenHash
    cell.complete = true
    cell.recoveryRoot = VexaRecoverableCellRoot(cell)
    return assetCellOk(cell)

fn OracleAssetObservationFactJson(observation: OracleAssetObservation): str =
    var out = "{\"kind\":\"csg_dialect::oracle_asset::observation\""
    out = assetCat(out, assetCat4(",\"id\":\"", observation.id, "\",", ""))
    out = assetCat(out, assetCat4("\"sourceKind\":\"", observation.sourceKind, "\",", ""))
    out = assetCat(out, assetCat4("\"sourceUri\":\"", observation.sourceUri, "\",", ""))
    out = assetCat(out, assetCat4("\"subjectId\":\"", observation.subjectId, "\",", ""))
    out = assetCat(out, assetCat4("\"valueHash\":\"", observation.valueHash, "\",", ""))
    out = assetCat(out, assetCat3("\"observedAtMs\":", assetI64(observation.observedAtMs), ","))
    out = assetCat(out, assetCat3("\"ttlMs\":", assetI64(observation.ttlMs), ","))
    out = assetCat(out, assetCat3("\"reporterCount\":", assetI32(observation.reporterCount), ","))
    out = assetCat(out, assetCat3("\"quorum\":", assetI32(observation.quorum), ","))
    out = assetCat(out, assetCat4("\"appHash\":\"", observation.appHash, "\",", ""))
    out = assetCat(out, assetCat4("\"receiptHash\":\"", observation.receiptHash, "\"", "}"))
    return assetCanonicalFactLine(out)

