import std/cmdline
import std/os
import std/result
import std/strings
import cheng/codex/std/process
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/validator as csg

type
    MigRun =
        ok: bool
        exitCode: int32
        stdout: str
        stderr: str

    MigAbiTest =
        name: str
        functionName: str
        args: int32[]
        expect: int32

    MigExportedFunction =
        name: str
        paramCount: int32

    MigPaths =
        outDir: str
        factsDir: str
        reportsDir: str
        generatedDir: str
        binDir: str
        facts: str
        factsSecond: str
        frontendReport: str
        frontendReportSecond: str
        lowerReport: str
        lowerCompileReport: str
        proveCompileReport: str
        chengReport: str
        equivalenceReceipt: str
        chengExe: str
        chengObj: str
        pureLowerExe: str
        pureProveExe: str
        originalExe: str
        abiRunnerSource: str
        abiProveTests: str
        originalAbiRunner: str
        chengAbiRunner: str
        pyOriginalRunnerSource: str
        pyChengRunnerSource: str
        pyFunctionProveTests: str

    MigConfig =
        language: str
        target: str
        hostTarget: str
        toolRoot: str
        outDir: str
        tests: str
        reportOut: str
        original: str
        compileCommands: str
        pythonRoot: str
        pythonVersion: str
        entry: str

    MigState =
        complete: bool
        admissionBound: bool
        failedStep: str
        reason: str
        factsRoot: str
        profiles: str[]
        profileSetCid: str
        closedWorldKind: str
        closedSubset: str
        closedReturnRaw: str
        originalRunner: str
        chengRunner: str
        frontendComplete: bool
        lowerComplete: bool
        equivalenceComplete: bool
        commandText: str
        stdoutTail: str
        stderrTail: str

fn migCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn migAppend(out: var str, piece: str) =
    out = migCat(out, piece)

fn migOwn(raw: str): str =
    return strings.ConcatStr("", raw)

fn migPath(a: str, b: str): str =
    return os.JoinPath(a, b)

fn migTail(text: str): str =
    if text.len <= 4000:
        return text
    return strings.SliceBytes(text, text.len - 4000, 4000)

fn migJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            migAppend(out, "\\\\")
        elif ch == '"':
            migAppend(out, "\\\"")
        elif ch == '\n':
            migAppend(out, "\\n")
        elif ch == '\r':
            migAppend(out, "\\r")
        elif ch == '\t':
            migAppend(out, "\\t")
        else:
            migAppend(out, strings.CharToStr(ch))
    migAppend(out, "\"")
    return out

fn migJsonBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn migProfilesJson(profiles: var str[]): str =
    var out: str = "["
    for i in 0..<profiles.len:
        if i > 0:
            migAppend(out, ",")
        migAppend(out, migJsonQuote(profiles[i]))
    migAppend(out, "]")
    return out

fn migRunShellText(argv: str[]): str =
    var out: str
    for i in 0..<argv.len:
        if i > 0:
            migAppend(out, " ")
        migAppend(out, argv[i])
    return out

fn migRunCommand(argv: str[], cwd: str): MigRun =
    var out: MigRun
    if argv.len <= 0:
        out.stderr = "empty command"
        return out
    var args: str[]
    for i in 1..<argv.len:
        add(args, strings.CloneStr(argv[i]))
    let handle = process.ProcessSpawnRaw(argv[0], args, cwd, [])
    if !handle.ok:
        out.stderr = handle.error
        return out
    if handle.stdinFd >= 0:
        process.ProcessCloseFd(handle.stdinFd)
    out.stdout = process.ProcessReadFdBlocking(handle.stdoutFd, 5000)
    out.stderr = process.ProcessReadFdBlocking(handle.stderrFd, 5000)
    out.exitCode = process.ProcessWait(handle.pid)
    if handle.stdoutFd >= 0:
        process.ProcessCloseFd(handle.stdoutFd)
    if handle.stderrFd >= 0:
        process.ProcessCloseFd(handle.stderrFd)
    out.ok = out.exitCode == 0
    return out

fn migFail(state: var MigState, step: str, reason: str) =
    state.complete = false
    state.failedStep = step
    state.reason = reason

fn migRunStep(state: var MigState, step: str, argv: str[], cwd: str): bool =
    state.commandText = migRunShellText(argv)
    let run = migRunCommand(argv, cwd)
    state.stdoutTail = migTail(run.stdout)
    state.stderrTail = migTail(run.stderr)
    if !run.ok:
        migFail(state, step, migCat(step, " failed"))
        return false
    return true

fn migIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

fn migSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && migIsWs(text[i]):
        i = i + 1
    return i

fn migTrimRaw(text: str): str =
    var start = migSkipWs(text, 0)
    if start >= text.len:
        return ""
    var finish = text.len
    while finish > start && migIsWs(text[finish - 1]):
        finish = finish - 1
    return strings.SliceBytes(text, start, finish - start)

fn migIsAlpha(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')

fn migIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn migIsIdentStart(ch: char): bool =
    return migIsAlpha(ch) || ch == '_'

fn migIsIdentChar(ch: char): bool =
    return migIsIdentStart(ch) || migIsDigit(ch)

fn migValidIdentifier(name: str): bool =
    if name.len == 0:
        return false
    if !migIsIdentStart(name[0]):
        return false
    for i in 1..<name.len:
        if !migIsIdentChar(name[i]):
            return false
    return true

fn migParseInt32Raw(rawText: str, out: var int32): bool =
    let raw = migTrimRaw(rawText)
    if raw.len == 0:
        return false
    var i: int32
    var sign: int64 = int64(1)
    if raw[0] == '-':
        sign = int64(-1)
        i = 1
    elif raw[0] == '+':
        i = 1
    if i >= raw.len:
        return false
    var value: int64
    while i < raw.len:
        let ch = raw[i]
        if !migIsDigit(ch):
            return false
        value = value * int64(10) + int64(int32(ch) - int32('0'))
        if value > int64(2147483648):
            return false
        i = i + 1
    let signed = value * sign
    if signed < int64(-2147483648) || signed > int64(2147483647):
        return false
    out = int32(signed)
    return true

fn migSkipJsonString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

fn migSkipJsonValue(text: str, start: int32): int32 =
    var i = migSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = migSkipJsonString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = migSkipJsonString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn migJsonDecodeString(text: str, quotePos: int32, afterQuote: int32, out: var str): bool =
    out = ""
    if quotePos < 0 || afterQuote <= quotePos || afterQuote > text.len || text[quotePos] != '"':
        return false
    let closeQuote = afterQuote - 1
    var i = quotePos + 1
    while i < closeQuote:
        let ch = text[i]
        if ch == '\\':
            i = i + 1
            if i >= closeQuote:
                return false
            let esc = text[i]
            if esc == '"' || esc == '\\' || esc == '/':
                migAppend(out, strings.CharToStr(esc))
            elif esc == 'n':
                migAppend(out, "\n")
            elif esc == 'r':
                migAppend(out, "\r")
            elif esc == 't':
                migAppend(out, "\t")
            else:
                return false
        else:
            migAppend(out, strings.CharToStr(ch))
        i = i + 1
    return true

fn migTopRaw(text: str, key: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(text, key)
    if !got.found:
        return false
    out = got.value
    return true

fn migTopString(text: str, key: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(text, key)
    if !got.found:
        return false
    out = got.value
    return true

fn migTopBool(text: str, key: str): bool =
    var raw: str
    if !migTopRaw(text, key, raw):
        return false
    return migTrimRaw(raw) == "true"

fn migParseBoolRawStrict(rawText: str, key: str, out: var bool, error: var str): bool =
    let raw = migTrimRaw(rawText)
    if raw == "true":
        out = true
        return true
    if raw == "false":
        out = false
        return true
    error = migCat("manifest field must be boolean: ", key)
    return false

fn migTopRawOrEmpty(text: str, key: str): str =
    var raw: str
    if migTopRaw(text, key, raw):
        return raw
    return ""

fn migFirstObjectFromArray(rawArray: str, out: var str): bool =
    let raw = migTrimRaw(rawArray)
    var i = migSkipWs(raw, 0)
    if i >= raw.len || raw[i] != '[':
        return false
    i = migSkipWs(raw, i + 1)
    if i >= raw.len || raw[i] != '{':
        return false
    let endPos = migSkipJsonValue(raw, i)
    if endPos <= i:
        return false
    out = strings.SliceBytes(raw, i, endPos - i)
    var next = migSkipWs(raw, endPos)
    if next < raw.len && raw[next] == ',':
        return false
    return true

fn migObjectsFromArray(rawArray: str): str[] =
    var out: str[]
    let raw = migTrimRaw(rawArray)
    var i = migSkipWs(raw, 0)
    if i >= raw.len || raw[i] != '[':
        return out
    i = i + 1
    while i < raw.len:
        i = migSkipWs(raw, i)
        if i >= raw.len || raw[i] == ']':
            return out
        if raw[i] != '{':
            return out
        let endPos = migSkipJsonValue(raw, i)
        if endPos <= i:
            return out
        add(out, strings.SliceBytes(raw, i, endPos - i))
        i = migSkipWs(raw, endPos)
        if i < raw.len && raw[i] == ',':
            i = i + 1
    return out

fn migParseStringArray(rawArray: str, out: var str[], error: var str): bool =
    out = []
    let raw = migTrimRaw(rawArray)
    var pos = migSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        error = "expected JSON string array"
        return false
    pos = pos + 1
    while true:
        pos = migSkipWs(raw, pos)
        if pos >= raw.len:
            error = "unterminated JSON string array"
            return false
        if raw[pos] == ']':
            return true
        if raw[pos] != '"':
            error = "expected string in JSON array"
            return false
        let endPos = migSkipJsonString(raw, pos)
        if endPos < 0:
            error = "malformed JSON string array"
            return false
        var value: str
        if !migJsonDecodeString(raw, pos, endPos, value):
            error = "malformed JSON string array value"
            return false
        add(out, value)
        pos = migSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            continue
        if pos < raw.len && raw[pos] == ']':
            return true
        error = "malformed JSON string array separator"
        return false
    return false

fn migParseInt32Array(rawArray: str, out: var int32[], error: var str): bool =
    out = []
    let raw = migTrimRaw(rawArray)
    var pos = migSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        error = "abiTests args must be an int32 array"
        return false
    pos = pos + 1
    while true:
        pos = migSkipWs(raw, pos)
        if pos >= raw.len:
            error = "unterminated abiTests args array"
            return false
        if raw[pos] == ']':
            return true
        let endPos = migSkipJsonValue(raw, pos)
        if endPos <= pos:
            error = "malformed abiTests args value"
            return false
        var value: int32
        if !migParseInt32Raw(strings.SliceBytes(raw, pos, endPos - pos), value):
            error = "abiTests args values must be int32"
            return false
        add(out, value)
        if out.len > 8:
            error = "abiTests supports at most eight int32 args"
            return false
        pos = migSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            continue
        if pos < raw.len && raw[pos] == ']':
            return true
        error = "malformed abiTests args separator"
        return false
    return false

fn migParseAbiTest(rawCase: str, index: int32, out: var MigAbiTest, error: var str): bool =
    var functionName: str
    if !migTopString(rawCase, "function", functionName):
        error = "abiTests item requires function"
        return false
    if !migValidIdentifier(functionName):
        error = "abiTests function must be a C identifier"
        return false
    out.functionName = functionName
    var name: str
    if migTopString(rawCase, "name", name):
        out.name = name
    else:
        out.name = migCat("abi-", strings.IntToStr(index))
    var rawArgs: str
    if !migTopRaw(rawCase, "args", rawArgs):
        error = "abiTests item requires args"
        return false
    if !migParseInt32Array(rawArgs, out.args, error):
        return false
    var rawExpect: str
    if !migTopRaw(rawCase, "expect", rawExpect):
        error = "abiTests item requires expect"
        return false
    if !migParseInt32Raw(rawExpect, out.expect):
        error = "abiTests expect must be int32"
        return false
    return true

fn migParseAbiTestsManifest(path: str, tests: var MigAbiTest[], error: var str): bool =
    tests = []
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        error = "failed to read tests manifest"
        return false
    let text = result.Value(readResult)
    var networkRaw: str
    if migTopRaw(text, "network", networkRaw):
        var network: bool
        if !migParseBoolRawStrict(networkRaw, "network", network, error):
            return false
        if network:
            error = "network side effects are not closed for C library ABI migration"
            return false
    var processRaw: str
    if migTopRaw(text, "process", processRaw):
        var childProcess: bool
        if !migParseBoolRawStrict(processRaw, "process", childProcess, error):
            return false
        if childProcess:
            error = "child process side effects are not closed for C library ABI migration"
            return false
    var rawAbiTests: str
    if !migTopRaw(text, "abiTests", rawAbiTests):
        error = "C library migration requires abiTests"
        return false
    let objects = migObjectsFromArray(rawAbiTests)
    if objects.len == 0:
        error = "abiTests must be a non-empty array"
        return false
    for i in 0..<objects.len:
        var item: MigAbiTest
        if !migParseAbiTest(objects[i], i, item, error):
            return false
        add(tests, item)
    return true

fn migParsePythonFunctionTestsManifest(path: str, tests: var MigAbiTest[], error: var str): bool =
    tests = []
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        error = "failed to read tests manifest"
        return false
    let text = result.Value(readResult)
    var networkRaw: str
    if migTopRaw(text, "network", networkRaw):
        var network: bool
        if !migParseBoolRawStrict(networkRaw, "network", network, error):
            return false
        if network:
            error = "network side effects are not closed for Python library migration"
            return false
    var processRaw: str
    if migTopRaw(text, "process", processRaw):
        var childProcess: bool
        if !migParseBoolRawStrict(processRaw, "process", childProcess, error):
            return false
        if childProcess:
            error = "child process side effects are not closed for Python library migration"
            return false
    var rawFunctionTests: str
    if !migTopRaw(text, "functionTests", rawFunctionTests):
        error = "Python library migration requires functionTests"
        return false
    let objects = migObjectsFromArray(rawFunctionTests)
    if objects.len == 0:
        error = "functionTests must be a non-empty array"
        return false
    for i in 0..<objects.len:
        var item: MigAbiTest
        if !migParseAbiTest(objects[i], i, item, error):
            return false
        add(tests, item)
    return true

fn migParseCompileCommandSource(path: str, sourceOut: var str, cwdOut: var str): bool =
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        return false
    var first: str
    if !migFirstObjectFromArray(result.Value(readResult), first):
        return false
    var directory: str
    var fileName: str
    if !migTopString(first, "file", fileName):
        return false
    if !migTopString(first, "directory", directory):
        directory = os.ParentDir(path)
    cwdOut = directory
    if fileName.len > 0 && (fileName[0] == '/' || fileName[0] == '\\'):
        sourceOut = fileName
    else:
        sourceOut = migPath(directory, fileName)
    return sourceOut.len > 0

fn migCompileCommandObjectSource(obj: str, compileCommandsPath: str, sourceOut: var str): bool =
    var directory: str
    var fileName: str
    if !migTopString(obj, "file", fileName):
        return false
    if !migTopString(obj, "directory", directory):
        directory = os.ParentDir(compileCommandsPath)
    if fileName.len > 0 && (fileName[0] == '/' || fileName[0] == '\\'):
        sourceOut = fileName
    else:
        sourceOut = migPath(directory, fileName)
    return sourceOut.len > 0

fn migParseCompileCommandSources(path: str, sourcesOut: var str[]): bool =
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        return false
    let objects = migObjectsFromArray(result.Value(readResult))
    if objects.len == 0:
        return false
    for i in 0..<objects.len:
        var source: str
        if !migCompileCommandObjectSource(objects[i], path, source):
            return false
        add(sourcesOut, source)
    return sourcesOut.len > 0

fn migFindExportedFunction(functions: var MigExportedFunction[], name: str): int32 =
    for i in 0..<functions.len:
        if functions[i].name == name:
            return i
    return -1

fn migCollectExportedFunctions(factsPath: str, functions: var MigExportedFunction[], error: var str): bool =
    functions = []
    var readResult: Result[str] = os.ReadFileResult(factsPath)
    if result.IsErr(readResult):
        error = "failed to read CSG facts for ABI exports"
        return false
    let lines = jsonl.CsgCoreJsonlSplitLines(result.Value(readResult))
    for i in 0..<lines.len:
        var kind: str
        if !migTopString(lines[i], "kind", kind):
            continue
        if kind != "csg.function":
            continue
        if !migTopBool(lines[i], "abiExport"):
            continue
        var name: str
        var rawParams: str
        if !migTopString(lines[i], "name", name) || !migTopRaw(lines[i], "parameters", rawParams):
            error = "csg.function ABI export missing name or parameters"
            return false
        if !migValidIdentifier(name):
            error = "csg.function ABI export name is not a C identifier"
            return false
        var item: MigExportedFunction
        item.name = name
        item.paramCount = migObjectsFromArray(rawParams).len
        add(functions, item)
    if functions.len == 0:
        error = "C library facts contain no ABI-exported functions"
        return false
    return true

fn migCollectLibraryFunctions(factsPath: str, functions: var MigExportedFunction[], error: var str): bool =
    functions = []
    var readResult: Result[str] = os.ReadFileResult(factsPath)
    if result.IsErr(readResult):
        error = "failed to read CSG facts for library functions"
        return false
    let lines = jsonl.CsgCoreJsonlSplitLines(result.Value(readResult))
    for i in 0..<lines.len:
        var kind: str
        if !migTopString(lines[i], "kind", kind):
            continue
        if kind != "csg.function":
            continue
        var name: str
        var rawParams: str
        if !migTopString(lines[i], "name", name) || !migTopRaw(lines[i], "parameters", rawParams):
            error = "csg.function missing name or parameters"
            return false
        if name == "main":
            continue
        if !migValidIdentifier(name):
            error = "library function name is not a closed identifier"
            return false
        var item: MigExportedFunction
        item.name = name
        item.paramCount = migObjectsFromArray(rawParams).len
        add(functions, item)
    if functions.len == 0:
        error = "library facts contain no callable functions"
        return false
    return true

fn migCollectEntryRootFunctionNames(reportPath: str, roots: var str[], error: var str): bool =
    roots = []
    var readResult: Result[str] = os.ReadFileResult(reportPath)
    if result.IsErr(readResult):
        error = "failed to read frontend report for entry roots"
        return false
    var rawRoots: str
    if !migTopRaw(result.Value(readResult), "entryRoots", rawRoots):
        error = "frontend report missing entryRoots"
        return false
    var values: str[]
    if !migParseStringArray(rawRoots, values, error):
        return false
    for i in 0..<values.len:
        if !strings.HasPrefix(values[i], "function:"):
            error = "entryRoots supports only function roots"
            return false
        let name = strings.SliceBytes(values[i], 9, values[i].len - 9)
        if !migValidIdentifier(name):
            error = "entryRoot function name is not closed"
            return false
        add(roots, name)
    if roots.len == 0:
        error = "library frontend report has no entry roots"
        return false
    return true

fn migNameInList(names: var str[], name: str): bool =
    for i in 0..<names.len:
        if names[i] == name:
            return true
    return false


fn migValidateAbiTestsAgainstExports(tests: var MigAbiTest[], functions: var MigExportedFunction[], error: var str): bool =
    for i in 0..<tests.len:
        let idx = migFindExportedFunction(functions, tests[i].functionName)
        if idx < 0:
            error = migCat("abiTests references non-exported function: ", tests[i].functionName)
            return false
        if tests[i].args.len != functions[idx].paramCount:
            error = migCat("abiTests arg count does not match exported function: ", tests[i].functionName)
            return false
    return true

fn migValidatePythonFunctionTests(tests: var MigAbiTest[], functions: var MigExportedFunction[], entryRoots: var str[], error: var str): bool =
    for i in 0..<tests.len:
        if !migNameInList(entryRoots, tests[i].functionName):
            error = migCat("functionTests references non-entry function: ", tests[i].functionName)
            return false
        let idx = migFindExportedFunction(functions, tests[i].functionName)
        if idx < 0:
            error = migCat("functionTests references unknown function: ", tests[i].functionName)
            return false
        if tests[i].args.len != functions[idx].paramCount:
            error = migCat("functionTests arg count does not match function: ", tests[i].functionName)
            return false
    return true

fn migPythonEntryPath(root: str, entry: str): str =
    var rel: str
    for i in 0..<entry.len:
        if entry[i] == '.':
            migAppend(rel, "/")
        else:
            migAppend(rel, strings.CharToStr(entry[i]))
    let filePath = migPath(root, migCat(rel, ".py"))
    if os.FileExists(filePath):
        return filePath
    let initPath = migPath(migPath(root, rel), "__init__.py")
    if os.FileExists(initPath):
        return initPath
    return ""

fn migCompareFiles(a: str, b: str): bool =
    var left: Result[str] = os.ReadFileResult(a)
    if result.IsErr(left):
        return false
    var right: Result[str] = os.ReadFileResult(b)
    if result.IsErr(right):
        return false
    return result.Value(left) == result.Value(right)

fn migWriteFileVerified(path: str, text: str, step: str, state: var MigState): bool =
    os.WriteFile(path, text)
    var readBack: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readBack):
        migFail(state, step, migCat("failed to read back written artifact: ", path))
        return false
    if result.Value(readBack) != text:
        migFail(state, step, migCat("written artifact bytes did not roundtrip: ", path))
        return false
    return true

fn migValidateFacts(path: str, state: var MigState): bool =
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        return false
    let lines = jsonl.CsgCoreJsonlSplitLines(result.Value(readResult))
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            lines)
    if !validation.valid || !validation.complete:
        return false
    if validation.standard !=
           csg.CsgCoreStandardIdentity() ||
       validation.factsRoot != state.factsRoot ||
       validation.profileSetCid != state.profileSetCid ||
       !csg.CsgCoreProfilesEqual(
           validation.profiles, state.profiles):
        migFail(
            state,
            "validate",
            "frontend report identity does not match canonical admission")
        return false
    state.admissionBound = true
    state.factsRoot =
        strings.CloneStr(validation.factsRoot)
    state.profiles =
        csg.CsgCoreProfilesClone(validation.profiles)
    state.profileSetCid =
        strings.CloneStr(validation.profileSetCid)
    return true

fn migCompileCheng(toolRoot: str, entry: str, target: str, outExe: str, report: str, state: var MigState): bool =
    var args: str[] = [
        migPath(migPath(toolRoot, "artifacts"), "backend_driver/cheng"),
        "system-link-exec",
        migCat("--root:", toolRoot),
        migCat("--in:", entry),
        "--emit:exe",
        migCat("--target:", target),
        "--runtime-provider-bundle:codex-app-server",
        migCat("--out:", outExe),
        migCat("--report-out:", report)
    ]
    if !migRunStep(state, "compile-cheng", args, toolRoot):
        return false
    state.chengRunner = outExe
    return true

fn migCompileChengObject(toolRoot: str, entry: str, target: str, outObj: str, report: str, state: var MigState): bool =
    var args: str[] = [
        migPath(migPath(toolRoot, "artifacts"), "backend_driver/cheng"),
        "system-link-exec",
        migCat("--root:", toolRoot),
        migCat("--in:", entry),
        "--emit:obj",
        migCat("--target:", target),
        migCat("--out:", outObj),
        migCat("--report-out:", report)
    ]
    return migRunStep(state, "compile-cheng-object", args, toolRoot)

fn migCompilePureLower(toolRoot: str, hostTarget: str, outExe: str, report: str, state: var MigState): bool =
    var args: str[] = [
        migPath(migPath(toolRoot, "artifacts"), "backend_driver/cheng"),
        "system-link-exec",
        migCat("--root:", toolRoot),
        migCat("--in:", migPath(toolRoot, "src/core/csg_migration/cheng_csg_lower.cheng")),
        "--emit:exe",
        migCat("--target:", hostTarget),
        migCat("--out:", outExe),
        migCat("--report-out:", report)
    ]
    return migRunStep(state, "compile-pure-lower", args, toolRoot)

fn migCompilePureProve(toolRoot: str, hostTarget: str, outExe: str, report: str, state: var MigState): bool =
    var args: str[] = [
        migPath(migPath(toolRoot, "artifacts"), "backend_driver/cheng"),
        "system-link-exec",
        migCat("--root:", toolRoot),
        migCat("--in:", migPath(toolRoot, "src/core/csg_migration/cheng_csg_prove.cheng")),
        "--emit:exe",
        migCat("--target:", hostTarget),
        "--runtime-provider-bundle:codex-app-server",
        migCat("--out:", outExe),
        migCat("--report-out:", report)
    ]
    return migRunStep(state, "compile-pure-prove", args, toolRoot)

fn migCompileOriginalC(cfg: MigConfig, paths: MigPaths, state: var MigState): bool =
    var sources: str[]
    if !migParseCompileCommandSources(cfg.compileCommands, sources):
        migFail(state, "compile-original-c", "failed to parse compile_commands.json")
        return false
    var args: str[] = [
        "clang",
        migCat("--target=", cfg.target),
        "-std=c11"
    ]
    for i in 0..<sources.len:
        add(args, strings.CloneStr(sources[i]))
    add(args, "-o")
    add(args, strings.CloneStr(paths.originalExe))
    if !migRunStep(state, "compile-original-c", args, cfg.toolRoot):
        return false
    state.originalRunner = paths.originalExe
    return true

fn migAppendCParamDecl(out: var str, count: int32) =
    for i in 0..<count:
        if i > 0:
            migAppend(out, ", ")
        migAppend(out, "int a")
        migAppend(out, strings.IntToStr(i))

fn migAppendCArgList(out: var str, args: int32[]) =
    for i in 0..<args.len:
        if i > 0:
            migAppend(out, ", ")
        migAppend(out, strings.IntToStr(args[i]))

fn migAbiRunnerSource(functions: var MigExportedFunction[], tests: var MigAbiTest[]): str =
    var out: str = "#include <stdio.h>\n"
    for i in 0..<functions.len:
        migAppend(out, "extern int ")
        migAppend(out, functions[i].name)
        migAppend(out, "(")
        migAppendCParamDecl(out, functions[i].paramCount)
        migAppend(out, ");\n")
    migAppend(out, "int main(void) {\n")
    for i in 0..<tests.len:
        migAppend(out, "  int got")
        migAppend(out, strings.IntToStr(i))
        migAppend(out, " = ")
        migAppend(out, tests[i].functionName)
        migAppend(out, "(")
        migAppendCArgList(out, tests[i].args)
        migAppend(out, ");\n")
        migAppend(out, "  if (got")
        migAppend(out, strings.IntToStr(i))
        migAppend(out, " != ")
        migAppend(out, strings.IntToStr(tests[i].expect))
        migAppend(out, ") { puts(\"abi-fail\"); return 1; }\n")
    migAppend(out, "  puts(\"abi-ok\");\n")
    migAppend(out, "  return 0;\n")
    migAppend(out, "}\n")
    return out

fn migWriteAbiProveTests(path: str) =
    os.WriteFile(path, "{\"network\":false,\"process\":false,\"tests\":[{\"name\":\"c-library-abi\",\"args\":[],\"stdin\":\"\",\"files\":{}}]}\n")

fn migWritePythonFunctionProveTests(path: str) =
    os.WriteFile(path, "{\"network\":false,\"process\":false,\"tests\":[{\"name\":\"python-library-functions\",\"args\":[],\"stdin\":\"\",\"files\":{}}]}\n")

fn migPythonOriginalRunnerSource(cfg: MigConfig, tests: var MigAbiTest[]): str =
    var out: str = "import importlib\nimport sys\n"
    migAppend(out, "sys.path.insert(0, ")
    migAppend(out, migJsonQuote(cfg.pythonRoot))
    migAppend(out, ")\n")
    migAppend(out, "m = importlib.import_module(")
    migAppend(out, migJsonQuote(cfg.entry))
    migAppend(out, ")\n")
    for i in 0..<tests.len:
        migAppend(out, "got")
        migAppend(out, strings.IntToStr(i))
        migAppend(out, " = m.")
        migAppend(out, tests[i].functionName)
        migAppend(out, "(")
        migAppendCArgList(out, tests[i].args)
        migAppend(out, ")\n")
        migAppend(out, "if got")
        migAppend(out, strings.IntToStr(i))
        migAppend(out, " != ")
        migAppend(out, strings.IntToStr(tests[i].expect))
        migAppend(out, ":\n    print(\"py-lib-fail\")\n    raise SystemExit(1)\n")
    migAppend(out, "print(\"py-lib-ok\")\n")
    return out

fn migPythonChengRunnerSource(generatedSource: str, tests: var MigAbiTest[]): str =
    var out: str = "import std/os as os\n\n"
    migAppend(out, generatedSource)
    if !strings.HasSuffix(out, "\n\n"):
        migAppend(out, "\n")
    migAppend(out, "fn main(): int32 =\n")
    for i in 0..<tests.len:
        migAppend(out, "    let got")
        migAppend(out, strings.IntToStr(i))
        migAppend(out, ": int32 = ")
        migAppend(out, tests[i].functionName)
        migAppend(out, "(")
        migAppendCArgList(out, tests[i].args)
        migAppend(out, ")\n")
        migAppend(out, "    if got")
        migAppend(out, strings.IntToStr(i))
        migAppend(out, " != ")
        migAppend(out, strings.IntToStr(tests[i].expect))
        migAppend(out, ":\n")
        migAppend(out, "        os.WriteLine(os.Get_stdout(), ")
        migAppend(out, migJsonQuote(migCat("py-lib-fail:", tests[i].name)))
        migAppend(out, ")\n")
        migAppend(out, "        return 1\n")
    migAppend(out, "    os.WriteLine(os.Get_stdout(), \"py-lib-ok\")\n")
    migAppend(out, "    return 0\n")
    return out

fn migLinkOriginalCAbiRunner(cfg: MigConfig, paths: MigPaths, state: var MigState): bool =
    var sources: str[]
    if !migParseCompileCommandSources(cfg.compileCommands, sources):
        migFail(state, "link-original-c-abi", "failed to parse compile_commands.json")
        return false
    var args: str[] = [
        "clang",
        migCat("--target=", cfg.target),
        "-std=c11",
        paths.abiRunnerSource
    ]
    for i in 0..<sources.len:
        add(args, sources[i])
    add(args, "-o")
    add(args, strings.CloneStr(paths.originalAbiRunner))
    if !migRunStep(state, "link-original-c-abi", args, cfg.toolRoot):
        return false
    state.originalRunner = paths.originalAbiRunner
    return true

fn migLinkChengAbiRunner(cfg: MigConfig, paths: MigPaths, state: var MigState): bool =
    var args: str[] = [
        "clang",
        migCat("--target=", cfg.target),
        "-std=c11",
        paths.abiRunnerSource,
        paths.chengObj,
        "-o",
        paths.chengAbiRunner
    ]
    if !migRunStep(state, "link-cheng-c-abi", args, cfg.toolRoot):
        return false
    state.chengRunner = paths.chengAbiRunner
    return true

fn migRunAbiSelfCheck(runner: str, step: str, paths: MigPaths, state: var MigState): bool =
    var args: str[] = [runner]
    return migRunStep(state, step, args, paths.outDir)

fn migPrepareCLibraryAbi(cfg: MigConfig, paths: MigPaths, state: var MigState): bool =
    var tests: MigAbiTest[]
    var functions: MigExportedFunction[]
    var error: str
    if !migParseAbiTestsManifest(cfg.tests, tests, error):
        migFail(state, "load-abi-tests", error)
        return false
    if !migCollectExportedFunctions(paths.facts, functions, error):
        migFail(state, "load-abi-exports", error)
        return false
    if !migValidateAbiTestsAgainstExports(tests, functions, error):
        migFail(state, "validate-abi-tests", error)
        return false
    os.WriteFile(paths.abiRunnerSource, migAbiRunnerSource(functions, tests))
    migWriteAbiProveTests(paths.abiProveTests)
    if !migCompileChengObject(cfg.toolRoot, migPath(paths.generatedDir, "main.cheng"), cfg.target, paths.chengObj, paths.chengReport, state):
        return false
    if !migLinkOriginalCAbiRunner(cfg, paths, state):
        return false
    if !migLinkChengAbiRunner(cfg, paths, state):
        return false
    if !migRunAbiSelfCheck(paths.originalAbiRunner, "run-original-c-abi", paths, state):
        return false
    if !migRunAbiSelfCheck(paths.chengAbiRunner, "run-cheng-c-abi", paths, state):
        return false
    return true

fn migRunPythonOriginalSelfCheck(paths: MigPaths, state: var MigState): bool =
    var args: str[] = ["python3", paths.pyOriginalRunnerSource]
    return migRunStep(state, "run-original-python-library", args, paths.outDir)

fn migPreparePythonLibrary(cfg: MigConfig, paths: MigPaths, state: var MigState): bool =
    var tests: MigAbiTest[]
    var functions: MigExportedFunction[]
    var entryRoots: str[]
    var error: str
    if !migParsePythonFunctionTestsManifest(cfg.tests, tests, error):
        migFail(state, "load-python-function-tests", error)
        return false
    if !migCollectLibraryFunctions(paths.facts, functions, error):
        migFail(state, "load-python-library-functions", error)
        return false
    if !migCollectEntryRootFunctionNames(paths.frontendReport, entryRoots, error):
        migFail(state, "load-python-entry-roots", error)
        return false
    if !migValidatePythonFunctionTests(tests, functions, entryRoots, error):
        migFail(state, "validate-python-function-tests", error)
        return false
    var generatedRead: Result[str] = os.ReadFileResult(migPath(paths.generatedDir, "main.cheng"))
    if result.IsErr(generatedRead):
        migFail(state, "generate-python-library-runner", "failed to read generated Cheng library source")
        return false
    if !migWriteFileVerified(paths.pyOriginalRunnerSource, migPythonOriginalRunnerSource(cfg, tests), "generate-python-original-runner", state):
        return false
    if !migWriteFileVerified(paths.pyChengRunnerSource, migPythonChengRunnerSource(result.Value(generatedRead), tests), "generate-python-cheng-runner", state):
        return false
    migWritePythonFunctionProveTests(paths.pyFunctionProveTests)
    if !migCompileCheng(cfg.toolRoot, paths.pyChengRunnerSource, cfg.target, paths.chengExe, paths.chengReport, state):
        return false
    state.originalRunner = migCat("python3 ", paths.pyOriginalRunnerSource)
    if !migRunPythonOriginalSelfCheck(paths, state):
        return false
    if !migRunAbiSelfCheck(paths.chengExe, "run-cheng-python-library", paths, state):
        return false
    return true

fn migBuildPaths(outDir: str): MigPaths =
    var p: MigPaths
    p.outDir = outDir
    p.factsDir = migPath(outDir, "facts")
    p.reportsDir = migPath(outDir, "reports")
    p.generatedDir = migPath(outDir, "generated")
    p.binDir = migPath(outDir, "bin")
    p.facts = migPath(p.factsDir, "main.csgcore")
    p.factsSecond = migPath(p.factsDir, "main.second.csgcore")
    p.frontendReport = migPath(p.reportsDir, "frontend.report.json")
    p.frontendReportSecond = migPath(p.reportsDir, "frontend.second.report.json")
    p.lowerReport = migPath(p.reportsDir, "lower.report.json")
    p.lowerCompileReport = migPath(p.reportsDir, "pure-lower.compile.report.txt")
    p.proveCompileReport = migPath(p.reportsDir, "pure-prove.compile.report.txt")
    p.chengReport = migPath(p.reportsDir, "cheng-main.report")
    p.equivalenceReceipt = migPath(outDir, "equivalence.receipt.json")
    p.chengExe = migPath(p.binDir, "cheng-main")
    p.chengObj = migPath(p.binDir, "cheng-main.o")
    p.pureLowerExe = migPath(p.binDir, "cheng-csg-lower-pure")
    p.pureProveExe = migPath(p.binDir, "cheng-csg-prove-pure")
    p.originalExe = migPath(p.binDir, "original-main")
    p.abiRunnerSource = migPath(p.binDir, "c-library-abi-runner.c")
    p.abiProveTests = migPath(p.reportsDir, "c-library-abi-prove-tests.json")
    p.originalAbiRunner = migPath(p.binDir, "original-c-abi-runner")
    p.chengAbiRunner = migPath(p.binDir, "cheng-c-abi-runner")
    p.pyOriginalRunnerSource = migPath(p.binDir, "python-library-original-runner")
    p.pyChengRunnerSource = migPath(p.binDir, "python-library-cheng-runner.cheng")
    p.pyFunctionProveTests = migPath(p.reportsDir, "python-library-function-prove-tests.json")
    return p

fn migMkdirPaths(p: MigPaths) =
    os.MkdirAll(p.factsDir, 493)
    os.MkdirAll(p.reportsDir, 493)
    os.MkdirAll(p.generatedDir, 493)
    os.MkdirAll(p.binDir, 493)

fn migEmitFacts(cfg: MigConfig, paths: MigPaths, second: bool, state: var MigState): bool =
    var outPath = paths.facts
    var reportPath = paths.frontendReport
    var step = "emit-facts"
    if second:
        outPath = paths.factsSecond
        reportPath = paths.frontendReportSecond
        step = "emit-facts-determinism"
    if cfg.language == "c":
        var args: str[] = [
            migPath(cfg.toolRoot, "tools/c-csg"),
            "emit",
            "--compile-commands",
            cfg.compileCommands,
            "--target",
            cfg.target,
            "--out",
            outPath,
            "--report-out",
            reportPath
        ]
        return migRunStep(state, step, args, cfg.toolRoot)
    var pyArgs: str[] = [
        migPath(cfg.toolRoot, "tools/py-csg"),
        "emit",
        "--root",
        cfg.pythonRoot,
        "--python-version",
        cfg.pythonVersion,
        "--entry",
        cfg.entry,
        "--out",
        outPath,
        "--report-out",
        reportPath
    ]
    return migRunStep(state, step, pyArgs, cfg.toolRoot)

fn migLoadFrontendState(path: str, state: var MigState): bool =
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        migFail(state, "emit-facts", "failed to read frontend report")
        return false
    let text = result.Value(readResult)
    var standard: str
    if !migTopString(text, "standard", standard) ||
       standard != csg.CsgCoreStandardIdentity():
        migFail(
            state,
            "emit-facts",
            "frontend report standard identity mismatch")
        return false
    var legacyRoot: str
    if migTopRaw(text, "factsRoot", legacyRoot):
        migFail(
            state,
            "emit-facts",
            "frontend report contains legacy factsRoot")
        return false
    var completeRaw: str
    var completeError: str
    if !migTopRaw(text, "complete", completeRaw) ||
       !migParseBoolRawStrict(
           completeRaw,
           "complete",
           state.frontendComplete,
           completeError):
        migFail(
            state,
            "emit-facts",
            "frontend report complete field is invalid")
        return false
    var value: str
    if !migTopString(text, "facts_root", state.factsRoot) ||
       !migTopString(
           text,
           "profile_set_cid",
           state.profileSetCid):
        migFail(
            state,
            "emit-facts",
            "frontend report admission identity is missing")
        return false
    var profilesRaw: str
    var profilesError: str
    if !migTopRaw(text, "profiles", profilesRaw) ||
       !migParseStringArray(
           profilesRaw,
           state.profiles,
           profilesError):
        migFail(
            state,
            "emit-facts",
            "frontend report profiles are invalid")
        return false
    if migTopString(text, "closedSubset", value):
        state.closedSubset = value
    if migTopString(text, "closedWorldKind", value):
        state.closedWorldKind = value
    state.closedReturnRaw = migTopRawOrEmpty(text, "closedReturn")
    if !state.frontendComplete:
        if state.factsRoot.len > 0 ||
           state.profiles.len > 0 ||
           state.profileSetCid.len > 0:
            migFail(
                state,
                "emit-facts",
                "incomplete frontend report carries unverified admission identity")
            return false
        migFail(state, "emit-facts", "frontend reported incomplete CSG facts")
        return false
    if state.factsRoot.len == 0 ||
       state.profiles.len == 0 ||
       state.profileSetCid.len == 0:
        migFail(
            state,
            "emit-facts",
            "complete frontend report lacks admission binding")
        return false
    return true

fn migRunLower(paths: MigPaths, state: var MigState): bool =
    var args: str[] = [
        paths.pureLowerExe,
        "lower",
        "--in",
        paths.facts,
        "--emit",
        "cheng-source",
        "--out-dir",
        paths.generatedDir,
        "--report-out",
        paths.lowerReport
    ]
    return migRunStep(state, "lower", args, paths.outDir)

fn migRunProve(paths: MigPaths, testsPath: str, state: var MigState): bool =
    var chengRunner = state.chengRunner
    if chengRunner.len == 0:
        chengRunner = paths.chengExe
    var args: str[] = [
        paths.pureProveExe,
        "prove",
        "--facts",
        paths.facts,
        "--original",
        state.originalRunner,
        "--cheng",
        chengRunner,
        "--tests",
        testsPath,
        "--out",
        paths.equivalenceReceipt
    ]
    return migRunStep(state, "prove", args, paths.outDir)

fn migLoadComplete(path: str, key: str, state: var MigState): bool =
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        migFail(state, key, migCat("failed to read ", key))
        return false
    let text = result.Value(readResult)
    var completeRaw: str
    var complete: bool
    var completeError: str
    if !migTopRaw(text, "complete", completeRaw) ||
       !migParseBoolRawStrict(
           completeRaw,
           "complete",
           complete,
           completeError) ||
       !complete:
        migFail(state, key, migCat(key, " report is incomplete"))
        return false
    if !state.admissionBound:
        migFail(state, key, "canonical admission binding is unavailable")
        return false
    var standard: str
    var factsRoot: str
    var profileSetCid: str
    var legacyRoot: str
    var profilesRaw: str
    var profiles: str[]
    var profilesError: str
    if !migTopString(text, "standard", standard) ||
       standard != csg.CsgCoreStandardIdentity() ||
       migTopRaw(text, "factsRoot", legacyRoot) ||
       !migTopString(text, "facts_root", factsRoot) ||
       !migTopString(text, "profile_set_cid", profileSetCid) ||
       !migTopRaw(text, "profiles", profilesRaw) ||
       !migParseStringArray(
           profilesRaw, profiles, profilesError) ||
       factsRoot != state.factsRoot ||
       profileSetCid != state.profileSetCid ||
       !csg.CsgCoreProfilesEqual(profiles, state.profiles):
        migFail(
            state,
            key,
            migCat(key, " report admission identity mismatch"))
        return false
    return true

fn migReceiptJson(cfg: MigConfig, paths: MigPaths, state: MigState): str =
    var out: str = "{"
    migAppend(out, "\"schema\":\"cheng-csg.migration.receipt\"")
    migAppend(out, ",\"standard\":")
    migAppend(out, migJsonQuote(csg.CsgCoreStandardIdentity()))
    migAppend(out, ",\"profiles\":")
    if state.admissionBound:
        migAppend(out, migProfilesJson(state.profiles))
    else:
        migAppend(out, "[]")
    migAppend(out, ",\"profile_set_cid\":")
    if state.admissionBound:
        migAppend(out, migJsonQuote(state.profileSetCid))
    else:
        migAppend(out, "\"\"")
    migAppend(out, ",\"facts_root\":")
    if state.admissionBound:
        migAppend(out, migJsonQuote(state.factsRoot))
    else:
        migAppend(out, "\"\"")
    migAppend(out, ",\"language\":")
    migAppend(out, migJsonQuote(cfg.language))
    migAppend(out, ",\"target\":")
    migAppend(out, migJsonQuote(cfg.target))
    migAppend(out, ",\"toolImplementation\":\"pure-cheng\"")
    migAppend(out, ",\"migrationImplementation\":\"pure-cheng\"")
    migAppend(out, ",\"pureChengToolchainComplete\":false")
    migAppend(out, ",\"completionScope\":\"closed-subset-migration-only\"")
    migAppend(out, ",\"fullProjectTranspilationComplete\":false")
    migAppend(out, ",\"toolchainGaps\":[\"C extraction still depends on external Clang oracle\",\"Python extraction still depends on fixed CPython oracle\",\"full C/Python project semantics are not complete; this migration command is a closed subset\"]")
    migAppend(out, ",\"complete\":")
    migAppend(out, migJsonBool(state.complete))
    if state.failedStep.len > 0:
        migAppend(out, ",\"failedStep\":")
        migAppend(out, migJsonQuote(state.failedStep))
    if state.reason.len > 0:
        migAppend(out, ",\"reason\":")
        migAppend(out, migJsonQuote(state.reason))
    if state.commandText.len > 0:
        migAppend(out, ",\"commandText\":")
        migAppend(out, migJsonQuote(state.commandText))
    if state.stdoutTail.len > 0:
        migAppend(out, ",\"stdoutTail\":")
        migAppend(out, migJsonQuote(state.stdoutTail))
    if state.stderrTail.len > 0:
        migAppend(out, ",\"stderrTail\":")
        migAppend(out, migJsonQuote(state.stderrTail))
    if state.closedSubset.len > 0:
        migAppend(out, ",\"closedSubset\":")
        migAppend(out, migJsonQuote(state.closedSubset))
    if state.closedWorldKind.len > 0:
        migAppend(out, ",\"closedWorldKind\":")
        migAppend(out, migJsonQuote(state.closedWorldKind))
    if state.closedReturnRaw.len > 0:
        migAppend(out, ",\"closedReturn\":")
        migAppend(out, state.closedReturnRaw)
    migAppend(out, ",\"artifacts\":{")
    migAppend(out, "\"outDir\":")
    migAppend(out, migJsonQuote(paths.outDir))
    migAppend(out, ",\"facts\":")
    migAppend(out, migJsonQuote(paths.facts))
    migAppend(out, ",\"frontendReport\":")
    migAppend(out, migJsonQuote(paths.frontendReport))
    migAppend(out, ",\"generatedSource\":")
    migAppend(out, migJsonQuote(migPath(paths.generatedDir, "main.cheng")))
    migAppend(out, ",\"lowerReport\":")
    migAppend(out, migJsonQuote(paths.lowerReport))
    migAppend(out, ",\"pureLowerExecutable\":")
    migAppend(out, migJsonQuote(paths.pureLowerExe))
    migAppend(out, ",\"pureProveExecutable\":")
    migAppend(out, migJsonQuote(paths.pureProveExe))
    migAppend(out, ",\"chengExecutable\":")
    migAppend(out, migJsonQuote(paths.chengExe))
    migAppend(out, ",\"chengObject\":")
    migAppend(out, migJsonQuote(paths.chengObj))
    migAppend(out, ",\"abiRunnerSource\":")
    migAppend(out, migJsonQuote(paths.abiRunnerSource))
    migAppend(out, ",\"abiProveTests\":")
    migAppend(out, migJsonQuote(paths.abiProveTests))
    migAppend(out, ",\"abiOriginalRunner\":")
    migAppend(out, migJsonQuote(paths.originalAbiRunner))
    migAppend(out, ",\"abiChengRunner\":")
    migAppend(out, migJsonQuote(paths.chengAbiRunner))
    migAppend(out, ",\"pythonOriginalRunnerSource\":")
    migAppend(out, migJsonQuote(paths.pyOriginalRunnerSource))
    migAppend(out, ",\"pythonChengRunnerSource\":")
    migAppend(out, migJsonQuote(paths.pyChengRunnerSource))
    migAppend(out, ",\"pythonFunctionProveTests\":")
    migAppend(out, migJsonQuote(paths.pyFunctionProveTests))
    migAppend(out, ",\"equivalenceReceipt\":")
    migAppend(out, migJsonQuote(paths.equivalenceReceipt))
    if state.originalRunner.len > 0:
        migAppend(out, ",\"originalRunner\":")
        migAppend(out, migJsonQuote(state.originalRunner))
    if state.chengRunner.len > 0:
        migAppend(out, ",\"chengRunner\":")
        migAppend(out, migJsonQuote(state.chengRunner))
    migAppend(out, "}")
    var frontendText: Result[str] = os.ReadFileResult(paths.frontendReport)
    if !result.IsErr(frontendText):
        migAppend(out, ",\"frontendReport\":")
        migAppend(out, result.Value(frontendText))
    if state.complete:
        var lowerText: Result[str] = os.ReadFileResult(paths.lowerReport)
        if !result.IsErr(lowerText):
            migAppend(out, ",\"lowerReport\":")
            migAppend(out, result.Value(lowerText))
        var eqText: Result[str] = os.ReadFileResult(paths.equivalenceReceipt)
        if !result.IsErr(eqText):
            migAppend(out, ",\"equivalenceReceipt\":")
            migAppend(out, result.Value(eqText))
    migAppend(out, "}")
    return out

fn migWriteReceipt(cfg: MigConfig, paths: MigPaths, state: MigState) =
    os.WriteFile(cfg.reportOut, migReceiptJson(cfg, paths, state))

fn migRun(cfg: MigConfig): int32 =
    var state: MigState
    let paths = migBuildPaths(cfg.outDir)
    if cfg.toolRoot.len == 0 || cfg.hostTarget.len == 0:
        migFail(state, "parse-arguments", "migrate requires --tool-root and --host-target")
        migWriteReceipt(cfg, paths, state)
        return 2
    if cfg.language != "c" && cfg.language != "python":
        migFail(state, "parse-arguments", "migrate requires --language c or python")
        migWriteReceipt(cfg, paths, state)
        return 2
    if cfg.target.len == 0 || cfg.outDir.len == 0 || cfg.tests.len == 0 || cfg.reportOut.len == 0:
        migFail(state, "parse-arguments", "missing required migrate arguments")
        migWriteReceipt(cfg, paths, state)
        return 2
    if !os.FileExists(cfg.tests):
        migFail(state, "load-tests", "missing tests manifest")
        migWriteReceipt(cfg, paths, state)
        return 1
    if cfg.language == "c":
        if cfg.compileCommands.len == 0:
            migFail(state, "parse-arguments", "C migration requires --compile-commands")
            migWriteReceipt(cfg, paths, state)
            return 2
    else:
        if cfg.pythonRoot.len == 0 || cfg.pythonVersion.len == 0 || cfg.entry.len == 0:
            migFail(state, "parse-arguments", "Python migration requires --root, --python-version, and --entry")
            migWriteReceipt(cfg, paths, state)
            return 2
        let pyEntry = migPythonEntryPath(cfg.pythonRoot, cfg.entry)
        if pyEntry.len == 0:
            migFail(state, "resolve-python-entry", "missing Python entry module")
            migWriteReceipt(cfg, paths, state)
            return 1
        if cfg.original.len > 0:
            state.originalRunner = cfg.original
        else:
            state.originalRunner = migCat("python3 ", pyEntry)
    migMkdirPaths(paths)
    if !migEmitFacts(cfg, paths, false, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migEmitFacts(cfg, paths, true, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migCompareFiles(paths.facts, paths.factsSecond):
        migFail(state, "deterministic-facts", "facts are not byte-identical")
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migCompareFiles(paths.frontendReport, paths.frontendReportSecond):
        migFail(state, "deterministic-report", "frontend reports are not byte-identical")
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migLoadFrontendState(paths.frontendReport, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migValidateFacts(paths.facts, state):
        if state.reason.len == 0:
            migFail(
                state,
                "validate",
                "CSG facts are incomplete or invalid")
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migCompilePureLower(cfg.toolRoot, cfg.hostTarget, paths.pureLowerExe, paths.lowerCompileReport, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migCompilePureProve(cfg.toolRoot, cfg.hostTarget, paths.pureProveExe, paths.proveCompileReport, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    if !migRunLower(paths, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    var proveTests = cfg.tests
    let cLibrary = cfg.language == "c" && strings.HasSuffix(state.closedWorldKind, "library")
    let pythonLibrary = cfg.language == "python" && strings.HasSuffix(state.closedWorldKind, "library")
    if cLibrary:
        if cfg.original.len > 0:
            migFail(state, "parse-arguments", "C library ABI migration compiles runners from compile_commands; --original is executable-only")
            migWriteReceipt(cfg, paths, state)
            return 2
        if !migPrepareCLibraryAbi(cfg, paths, state):
            migWriteReceipt(cfg, paths, state)
            return 1
        proveTests = paths.abiProveTests
    elif pythonLibrary:
        if cfg.original.len > 0:
            migFail(state, "parse-arguments", "Python library migration compiles its CPython oracle runner; --original is executable-only")
            migWriteReceipt(cfg, paths, state)
            return 2
        if !migPreparePythonLibrary(cfg, paths, state):
            migWriteReceipt(cfg, paths, state)
            return 1
        proveTests = paths.pyFunctionProveTests
    else:
        if !migCompileCheng(cfg.toolRoot, migPath(paths.generatedDir, "main.cheng"), cfg.target, paths.chengExe, paths.chengReport, state):
            migWriteReceipt(cfg, paths, state)
            return 1
        if cfg.language == "c":
            if cfg.original.len > 0:
                state.originalRunner = cfg.original
            else:
                if !migCompileOriginalC(cfg, paths, state):
                    migWriteReceipt(cfg, paths, state)
                    return 1
    if !migRunProve(paths, proveTests, state):
        migWriteReceipt(cfg, paths, state)
        return 1
    state.lowerComplete = migLoadComplete(paths.lowerReport, "lower", state)
    state.equivalenceComplete = migLoadComplete(paths.equivalenceReceipt, "prove", state)
    state.complete =
        state.admissionBound &&
        state.frontendComplete &&
        state.lowerComplete &&
        state.equivalenceComplete
    if !state.complete && state.reason.len == 0:
        state.reason = "migration substep reported incomplete"
    migWriteReceipt(cfg, paths, state)
    if state.complete:
        return 0
    return 1

fn migUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: cheng_csg_migrate migrate --tool-root <root> --host-target <triple> --language c|python --target <triple> --out-dir <dir> --tests <manifest> --report-out <receipt>")
    return 2

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return migUsage()
    if cmdline.ParamStr(1) != "migrate":
        return migUsage()
    var cfg: MigConfig
    cfg.toolRoot = migOwn(cmdline.ReadFlagOrDefault("--tool-root", ""))
    cfg.hostTarget = migOwn(cmdline.ReadFlagOrDefault("--host-target", ""))
    cfg.language = migOwn(cmdline.ReadFlagOrDefault("--language", ""))
    cfg.target = migOwn(cmdline.ReadFlagOrDefault("--target", ""))
    cfg.outDir = migOwn(cmdline.ReadFlagOrDefault("--out-dir", ""))
    cfg.tests = migOwn(cmdline.ReadFlagOrDefault("--tests", ""))
    cfg.reportOut = migOwn(cmdline.ReadFlagOrDefault("--report-out", ""))
    cfg.original = migOwn(cmdline.ReadFlagOrDefault("--original", ""))
    cfg.compileCommands = migOwn(cmdline.ReadFlagOrDefault("--compile-commands", ""))
    cfg.pythonRoot = migOwn(cmdline.ReadFlagOrDefault("--root", ""))
    cfg.pythonVersion = migOwn(cmdline.ReadFlagOrDefault("--python-version", ""))
    cfg.entry = migOwn(cmdline.ReadFlagOrDefault("--entry", ""))
    return migRun(cfg)
