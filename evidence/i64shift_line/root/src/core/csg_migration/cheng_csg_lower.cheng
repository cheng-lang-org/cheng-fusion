import std/cmdline
import std/os
import std/result
import std/strings
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/validator as csg

type
    LowerFunction =
        id: str
        name: str
        abiExport: bool
        hasReturn: bool
        returnExpr: str
        returnValue: int32

    LowerParam =
        functionId: str
        name: str
        order: int32

    LowerGlobal =
        name: str
        initialValue: int32

    LowerStatement =
        functionId: str
        kind: str
        order: int32
        name: str
        expr: str
        text: str

    LowerModel =
        ok: bool
        error: str
        source: str
        hasMain: bool
        mainReturn: int32
        functionCount: int32
        globalCount: int32
        factsRoot: str
        profiles: str[]
        profileSetCid: str

@borrows
fn lowerCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn lowerAppend(out: var str, piece: str) =
    out = lowerCat(out, piece)

@borrows
fn lowerOwn(raw: str): str =
    return strings.ConcatStr("", raw)

@borrows
fn lowerFail(message: str): LowerModel =
    var out: LowerModel
    out.error = message
    return out

@borrows
fn lowerOk(source: str, hasMain: bool, mainReturn: int32, functionCount: int32, globalCount: int32): LowerModel =
    var out: LowerModel
    out.ok = true
    out.source = source
    out.hasMain = hasMain
    out.mainReturn = mainReturn
    out.functionCount = functionCount
    out.globalCount = globalCount
    return out

fn lowerIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn lowerSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && lowerIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn lowerTrimRaw(text: str): str =
    var start: int32 = lowerSkipWs(text, 0)
    if start >= text.len:
        return ""
    var finish: int32 = text.len
    while finish > start && lowerIsWs(text[finish - 1]):
        finish = finish - 1
    return strings.SliceBytes(text, start, finish - start)

@borrows
fn lowerSkipJsonString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

@borrows
fn lowerSkipJsonValue(text: str, start: int32): int32 =
    var i: int32 = lowerSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = lowerSkipJsonString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = lowerSkipJsonString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn lowerIsAlpha(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')

fn lowerIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn lowerIsIdentStart(ch: char): bool =
    return lowerIsAlpha(ch) || ch == '_'

fn lowerIsIdentChar(ch: char): bool =
    return lowerIsIdentStart(ch) || lowerIsDigit(ch)

@borrows
fn lowerValidIdentifier(name: str): bool =
    if name.len == 0:
        return false
    if !lowerIsIdentStart(name[0]):
        return false
    for i in 1..<name.len:
        if !lowerIsIdentChar(name[i]):
            return false
    return true

@borrows
fn lowerStringLess(a: str, b: str): bool =
    let n: int32 = if a.len < b.len: a.len else: b.len
    for i in 0..<n:
        if a[i] < b[i]:
            return true
        if a[i] > b[i]:
            return false
    return a.len < b.len

@borrows
fn lowerFunctionNameLess(aName: str, bName: str): bool =
    if aName == "main" && bName != "main":
        return false
    if aName != "main" && bName == "main":
        return true
    return lowerStringLess(aName, bName)

fn lowerAddFunctionSorted(functions: var LowerFunction[], fnFact: LowerFunction) =
    add(functions, fnFact)
    var i: int32 = functions.len - 1
    while i > 0 && lowerFunctionNameLess(functions[i].name, functions[i - 1].name):
        let tmp: LowerFunction = functions[i - 1]
        functions[i - 1] = functions[i]
        functions[i] = tmp
        i = i - 1

@borrows
fn lowerFindFunctionById(functions: var LowerFunction[], id: str): int32 =
    for i in 0..<functions.len:
        if functions[i].id == id:
            return i
    return -1

@borrows
fn lowerFindFunctionByName(functions: var LowerFunction[], name: str): int32 =
    for i in 0..<functions.len:
        if functions[i].name == name:
            return i
    return -1

@borrows
fn lowerFindGlobalByName(globals: var LowerGlobal[], name: str): int32 =
    for i in 0..<globals.len:
        if globals[i].name == name:
            return i
    return -1

@borrows
fn lowerGlobalNameExists(globals: var LowerGlobal[], name: str): bool =
    return lowerFindGlobalByName(globals, name) >= 0

@borrows
fn lowerParamAt(params: var LowerParam[], functionId: str, order: int32, out: var LowerParam): bool =
    var found: bool
    for i in 0..<params.len:
        if params[i].functionId == functionId && params[i].order == order:
            if found:
                return false
            out = params[i]
            found = true
    return found

@borrows
fn lowerParamCount(params: var LowerParam[], functionId: str): int32 =
    var count: int32
    for i in 0..<params.len:
        if params[i].functionId == functionId:
            count = count + 1
    return count

@borrows
fn lowerParamNameExists(params: var LowerParam[], functionId: str, name: str): bool =
    for i in 0..<params.len:
        if params[i].functionId == functionId && params[i].name == name:
            return true
    return false

@borrows
fn lowerStatementAt(statements: var LowerStatement[], functionId: str, order: int32, out: var LowerStatement): bool =
    var found: bool
    for i in 0..<statements.len:
        if statements[i].functionId == functionId && statements[i].order == order:
            if found:
                return false
            out = statements[i]
            found = true
    return found

@borrows
fn lowerStatementCount(statements: var LowerStatement[], functionId: str): int32 =
    var count: int32
    for i in 0..<statements.len:
        if statements[i].functionId == functionId:
            count = count + 1
    return count

@borrows
fn lowerNamesContain(names: var str[], name: str): bool =
    for i in 0..<names.len:
        if names[i] == name:
            return true
    return false

@borrows
fn lowerAddUniqueName(names: var str[], name: str): bool =
    if !lowerValidIdentifier(name):
        return false
    if lowerNamesContain(names, name):
        return false
    add(names, strings.CloneStr(name))
    return true

@borrows
fn lowerTopString(line: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(line, name)
    if !got.found:
        return false
    out = got.value
    return true

@borrows
fn lowerTopRaw(line: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(line, name)
    if !got.found:
        return false
    out = got.value
    return true

@borrows
fn lowerTopBool(line: str, name: str): bool =
    var raw: str
    if !lowerTopRaw(line, name, raw):
        return false
    return lowerTrimRaw(raw) == "true"

@borrows
fn lowerParseInt32Raw(rawText: str, out: var int32): bool =
    let raw = lowerTrimRaw(rawText)
    if raw.len == 0:
        return false
    var i: int32
    var sign: int64 = int64(1)
    if raw[0] == '-':
        sign = int64(-1)
        i = 1
    elif raw[0] == '+':
        i = 1
    if i >= raw.len:
        return false
    var value: int64
    while i < raw.len:
        let ch = raw[i]
        if !lowerIsDigit(ch):
            return false
        value = value * int64(10) + int64(int32(ch) - int32('0'))
        if value > int64(2147483648):
            return false
        i = i + 1
    let signed = value * sign
    if signed < int64(-2147483648) || signed > int64(2147483647):
        return false
    out = int32(signed)
    return true

@borrows
fn lowerTopInt32(line: str, name: str, out: var int32): bool =
    var raw: str
    if !lowerTopRaw(line, name, raw):
        return false
    return lowerParseInt32Raw(raw, out)

@borrows
fn lowerLineKind(line: str): str =
    var kind: str
    if !lowerTopString(line, "kind", kind):
        return ""
    return kind

@borrows
fn lowerJsonStringNameEquals(text: str, quotePos: int32, afterQuote: int32, expected: str): bool =
    let size = afterQuote - quotePos - 2
    if size != expected.len:
        return false
    for i in 0..<size:
        if text[quotePos + 1 + i] != expected[i]:
            return false
    return true

@borrows
fn lowerJsonSimpleStringValue(text: str, quotePos: int32, afterQuote: int32, out: var str): bool =
    let closeQuote = afterQuote - 1
    for i in quotePos + 1..<closeQuote:
        if text[i] == '\\':
            return false
    out = lowerOwn(strings.SliceBytes(text, quotePos + 1, closeQuote - quotePos - 1))
    return true

@borrows
fn lowerObjectStringFieldInRange(text: str, objStart: int32, objEnd: int32, key: str, out: var str): bool =
    var i: int32 = objStart
    if i >= objEnd || text[i] != '{':
        return false
    i = i + 1
    while i < objEnd:
        i = lowerSkipWs(text, i)
        if i >= objEnd || text[i] == '}':
            return false
        if text[i] == ',':
            i = i + 1
            continue
        if text[i] != '"':
            return false
        let keyEnd = lowerSkipJsonString(text, i)
        if keyEnd < 0 || keyEnd > objEnd:
            return false
        let matched = lowerJsonStringNameEquals(text, i, keyEnd, key)
        var valueStart = lowerSkipWs(text, keyEnd)
        if valueStart >= objEnd || text[valueStart] != ':':
            return false
        valueStart = lowerSkipWs(text, valueStart + 1)
        if matched:
            if valueStart >= objEnd || text[valueStart] != '"':
                return false
            let valueEnd = lowerSkipJsonString(text, valueStart)
            if valueEnd < 0 || valueEnd > objEnd:
                return false
            return lowerJsonSimpleStringValue(text, valueStart, valueEnd, out)
        i = lowerSkipJsonValue(text, valueStart)
    return false

@borrows
fn lowerParseDeclaredParams(functionId: str, rawParams: str, declaredParams: var LowerParam[], error: var str): bool =
    let raw = lowerTrimRaw(rawParams)
    if raw.len < 2 || raw[0] != '[':
        error = "csg.function parameters must be an array"
        return false
    var pos: int32 = 1
    var order: int32
    while true:
        pos = lowerSkipWs(raw, pos)
        if pos >= raw.len:
            error = "unterminated csg.function parameters array"
            return false
        if raw[pos] == ']':
            return true
        if raw[pos] != '{':
            error = "csg.function parameter must be an object"
            return false
        let endPos = lowerSkipJsonValue(raw, pos)
        if endPos <= pos || endPos > raw.len:
            error = "malformed csg.function parameter object"
            return false
        var name: str
        var typ: str
        if !lowerObjectStringFieldInRange(raw, pos, endPos, "name", name) || !lowerObjectStringFieldInRange(raw, pos, endPos, "type", typ):
            error = "csg.function parameter requires name/type"
            return false
        if typ != "i32" || !lowerValidIdentifier(name):
            error = "lower supports only i32 parameters with Cheng identifiers"
            return false
        if lowerParamNameExists(declaredParams, functionId, name):
            error = "csg.function parameter name must be unique"
            return false
        var param: LowerParam
        param.functionId = functionId
        param.name = name
        param.order = order
        add(declaredParams, param)
        order = order + 1
        pos = lowerSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            continue
        if pos < raw.len && raw[pos] == ']':
            return true
        error = "malformed csg.function parameters separator"
        return false
    return false

@borrows
fn lowerParseFunctionFact(line: str, functions: var LowerFunction[], declaredParams: var LowerParam[], error: var str): bool =
    var id: str
    var name: str
    var returnType: str
    var rawParams: str
    if !lowerTopString(line, "id", id) || !lowerTopString(line, "name", name) || !lowerTopString(line, "returnType", returnType) || !lowerTopRaw(line, "parameters", rawParams):
        error = "csg.function requires id/name/returnType/parameters"
        return false
    if !lowerValidIdentifier(name):
        error = "csg.function name must be a Cheng identifier"
        return false
    if returnType != "i32":
        error = "lower supports only i32 functions"
        return false
    if lowerFindFunctionById(functions, id) >= 0 || lowerFindFunctionByName(functions, name) >= 0:
        error = "duplicate csg.function id or name"
        return false
    if !lowerParseDeclaredParams(id, rawParams, declaredParams, error):
        return false
    if name == "main" && lowerParamCount(declaredParams, id) != 0:
        error = "main must not take parameters"
        return false
    var fnFact: LowerFunction
    fnFact.id = id
    fnFact.name = name
    fnFact.abiExport = lowerTopBool(line, "abiExport")
    lowerAddFunctionSorted(functions, fnFact)
    return true

@borrows
fn lowerParseFunctions(lines: str[], functions: var LowerFunction[], declaredParams: var LowerParam[], error: var str): bool =
    for i in 0..<lines.len:
        if lines[i].len == 0:
            continue
        if lowerLineKind(lines[i]) == "csg.function":
            if !lowerParseFunctionFact(lines[i], functions, declaredParams, error):
                return false
    if functions.len == 0:
        error = "lower requires at least one csg.function"
        return false
    return true

@borrows
fn lowerParseGlobalFact(line: str, functions: var LowerFunction[], globals: var LowerGlobal[], error: var str): bool =
    var name: str
    var initialValue: int32
    if !lowerTopString(line, "name", name) || !lowerTopInt32(line, "initialValue", initialValue):
        error = "global_i32 requires name/initialValue"
        return false
    if !lowerValidIdentifier(name):
        error = "global_i32 name must be a Cheng identifier"
        return false
    if lowerFindFunctionByName(functions, name) >= 0:
        error = "global_i32 name must not duplicate a function"
        return false
    if lowerGlobalNameExists(globals, name):
        error = "global_i32 name must be unique"
        return false
    var global: LowerGlobal
    global.name = name
    global.initialValue = initialValue
    add(globals, global)
    return true

@borrows
fn lowerParseGlobals(lines: str[], functions: var LowerFunction[], globals: var LowerGlobal[], error: var str): bool =
    for i in 0..<lines.len:
        if lines[i].len == 0:
            continue
        if lowerLineKind(lines[i]) == "csg_dialect::native::global_i32":
            if !lowerParseGlobalFact(lines[i], functions, globals, error):
                return false
    return true

@borrows
fn lowerAddParamFact(functions: var LowerFunction[], params: var LowerParam[], line: str, error: var str): bool =
    var functionId: str
    var name: str
    var order: int32
    if !lowerTopString(line, "function", functionId) || !lowerTopString(line, "name", name) || !lowerTopInt32(line, "order", order):
        error = "param_i32 requires function/name/order"
        return false
    if order < 0 || !lowerValidIdentifier(name):
        error = "param_i32 order/name not closed"
        return false
    if lowerFindFunctionById(functions, functionId) < 0:
        error = "param_i32 fact must reference a known csg.function"
        return false
    var existing: LowerParam
    if lowerParamAt(params, functionId, order, existing):
        error = "param_i32 order must be unique"
        return false
    if lowerParamNameExists(params, functionId, name):
        error = "param_i32 name must be unique"
        return false
    var param: LowerParam
    param.functionId = functionId
    param.name = name
    param.order = order
    add(params, param)
    return true

@borrows
fn lowerAddStatementFact(functions: var LowerFunction[], globals: var LowerGlobal[], statements: var LowerStatement[], line: str, kind: str, error: var str): bool =
    var functionId: str
    var order: int32
    if !lowerTopString(line, "function", functionId) || !lowerTopInt32(line, "order", order):
        error = "statement fact requires function/order"
        return false
    if order < 0:
        error = "statement order must be non-negative"
        return false
    if lowerFindFunctionById(functions, functionId) < 0:
        error = "statement fact must reference a known csg.function"
        return false
    var duplicate: LowerStatement
    if lowerStatementAt(statements, functionId, order, duplicate):
        error = "statement order must be unique per function"
        return false
    var stmt: LowerStatement
    stmt.functionId = functionId
    stmt.kind = kind
    stmt.order = order
    if kind == "csg_dialect::native::stdout_line":
        if !lowerTopString(line, "text", stmt.text):
            error = "stdout_line text must be a string"
            return false
    elif kind == "csg_dialect::native::local_i32":
        var value: int32
        if !lowerTopString(line, "name", stmt.name) || !lowerTopString(line, "expr", stmt.expr) || !lowerTopInt32(line, "value", value):
            error = "local_i32 requires name/expr/value"
            return false
        if !lowerValidIdentifier(stmt.name) || stmt.expr.len == 0:
            error = "local_i32 name/expr not closed"
            return false
    elif kind == "csg_dialect::native::store_global_i32":
        var value: int32
        if !lowerTopString(line, "name", stmt.name) || !lowerTopString(line, "expr", stmt.expr) || !lowerTopInt32(line, "value", value):
            error = "store_global_i32 requires name/expr/value"
            return false
        if !lowerValidIdentifier(stmt.name) || stmt.expr.len == 0:
            error = "store_global_i32 name/expr not closed"
            return false
        if !lowerGlobalNameExists(globals, stmt.name):
            error = "store_global_i32 must reference a known global_i32"
            return false
    else:
        error = "unknown lowered statement kind"
        return false
    add(statements, stmt)
    return true

@borrows
fn lowerAddReturnFact(functions: var LowerFunction[], line: str, error: var str): bool =
    var functionId: str
    var termKind: str
    var value: int32
    if !lowerTopString(line, "function", functionId) || !lowerTopString(line, "termKind", termKind):
        error = "csg.term requires function/termKind"
        return false
    if termKind != "return":
        return true
    if !lowerTopInt32(line, "value", value):
        error = "return term must carry integer value"
        return false
    let idx = lowerFindFunctionById(functions, functionId)
    if idx < 0:
        error = "return term must reference a known csg.function"
        return false
    if functions[idx].hasReturn:
        error = "lower supports exactly one return term per function"
        return false
    var valueExpr: str
    if !lowerTopString(line, "valueExpr", valueExpr):
        valueExpr = strings.IntToStr(value)
    functions[idx].hasReturn = true
    functions[idx].returnValue = value
    functions[idx].returnExpr = valueExpr
    return true

@borrows
fn lowerParseBodyFacts(lines: str[], functions: var LowerFunction[], globals: var LowerGlobal[], params: var LowerParam[], statements: var LowerStatement[], error: var str): bool =
    for i in 0..<lines.len:
        if lines[i].len == 0:
            continue
        let kind = lowerLineKind(lines[i])
        if kind == "csg_dialect::native::param_i32":
            if !lowerAddParamFact(functions, params, lines[i], error):
                return false
        elif kind == "csg_dialect::native::stdout_line" || kind == "csg_dialect::native::local_i32" || kind == "csg_dialect::native::store_global_i32":
            if !lowerAddStatementFact(functions, globals, statements, lines[i], kind, error):
                return false
        elif kind == "csg.term":
            if !lowerAddReturnFact(functions, lines[i], error):
                return false
    return true

@borrows
fn lowerParamsMatchDeclared(declaredParams: var LowerParam[], params: var LowerParam[], functionId: str): bool =
    let declaredCount = lowerParamCount(declaredParams, functionId)
    if declaredCount != lowerParamCount(params, functionId):
        return false
    for i in 0..<declaredCount:
        var declared: LowerParam
        var param: LowerParam
        if !lowerParamAt(declaredParams, functionId, i, declared):
            return false
        if !lowerParamAt(params, functionId, i, param):
            return false
        if declared.name != param.name:
            return false
    return true

fn lowerValidateFunctionShape(functions: var LowerFunction[], globals: var LowerGlobal[], declaredParams: var LowerParam[], params: var LowerParam[], statements: var LowerStatement[], error: var str): bool =
    for i in 0..<functions.len:
        if !lowerParamsMatchDeclared(declaredParams, params, functions[i].id):
            error = "csg.function parameters must exactly match csg_dialect::native::param_i32 facts"
            return false
        let paramCount = lowerParamCount(params, functions[i].id)
        for paramIndex in 0..<paramCount:
            var param: LowerParam
            if !lowerParamAt(params, functions[i].id, paramIndex, param):
                error = "param_i32 order must be contiguous"
                return false
            if lowerGlobalNameExists(globals, param.name):
                error = "param_i32 name must not duplicate a global_i32"
                return false
        if !functions[i].hasReturn:
            error = lowerCat("missing return term for ", functions[i].id)
            return false
        let stmtCount = lowerStatementCount(statements, functions[i].id)
        for order in 0..<stmtCount:
            var stmt: LowerStatement
            if !lowerStatementAt(statements, functions[i].id, order, stmt):
                error = "statement order must be contiguous"
                return false
    return true

fn lowerExprCharAllowed(ch: char): bool =
    if lowerIsIdentChar(ch):
        return true
    return ch == ' ' || ch == '(' || ch == ')' || ch == '+' || ch == '-' || ch == '*' || ch == ','

@borrows
fn lowerSafeExpr(expr: str, names: var str[], error: var str): bool =
    if expr.len == 0:
        error = "empty Cheng i32 expression"
        return false
    var i: int32
    while i < expr.len:
        let ch = expr[i]
        if !lowerExprCharAllowed(ch):
            error = "Cheng i32 expression contains unsupported characters"
            return false
        if lowerIsIdentStart(ch):
            let start = i
            i = i + 1
            while i < expr.len && lowerIsIdentChar(expr[i]):
                i = i + 1
            let token = strings.SliceBytes(expr, start, i - start)
            if !lowerNamesContain(names, token):
                error = lowerCat("Cheng i32 expression references unknown name: ", token)
                return false
            continue
        i = i + 1
    return true

@borrows
fn lowerChengStringLiteral(value: str, out: var str, error: var str): bool =
    out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        let code = int32(ch)
        if ch == '\\':
            lowerAppend(out, "\\\\")
        elif ch == '"':
            lowerAppend(out, "\\\"")
        elif ch == '\n':
            lowerAppend(out, "\\n")
        elif ch == '\r':
            lowerAppend(out, "\\r")
        elif ch == '\t':
            lowerAppend(out, "\\t")
        elif code < 32 || code > 126:
            error = "lower supports stdout text with printable ASCII plus newline/carriage-return/tab only"
            return false
        else:
            lowerAppend(out, strings.CharToStr(ch))
    lowerAppend(out, "\"")
    return true

@borrows
fn lowerFunctionParamSource(params: var LowerParam[], functionId: str): str =
    var out: str
    let count = lowerParamCount(params, functionId)
    for i in 0..<count:
        var param: LowerParam
        if !lowerParamAt(params, functionId, i, param):
            return ""
        if i > 0:
            lowerAppend(out, ", ")
        lowerAppend(out, param.name)
        lowerAppend(out, ": int32")
    return out

fn lowerFunctionNames(functions: var LowerFunction[]): str[] =
    var out: str[]
    for i in 0..<functions.len:
        add(out, strings.CloneStr(functions[i].name))
    return out

fn lowerSortGlobalsByName(globals: var LowerGlobal[]) =
    for i in 1..<globals.len:
        var pos: int32 = i
        while pos > 0 && lowerStringLess(globals[pos].name, globals[pos - 1].name):
            let tmp = globals[pos - 1]
            globals[pos - 1] = globals[pos]
            globals[pos] = tmp
            pos = pos - 1

fn lowerAppendGlobalsSource(body: var str, globals: var LowerGlobal[]) =
    if globals.len == 0:
        return
    lowerSortGlobalsByName(globals)
    if body.len > 0 && !strings.HasSuffix(body, "\n\n"):
        lowerAppend(body, "\n")
    for i in 0..<globals.len:
        lowerAppend(body, "var ")
        lowerAppend(body, globals[i].name)
        lowerAppend(body, ": int32 = ")
        lowerAppend(body, strings.IntToStr(globals[i].initialValue))
        lowerAppend(body, "\n")
    lowerAppend(body, "\n")

fn lowerAppendFunctionSource(body: var str, functions: var LowerFunction[], globals: var LowerGlobal[], params: var LowerParam[], statements: var LowerStatement[], idx: int32, error: var str): bool =
    var names = lowerFunctionNames(functions)
    for i in 0..<globals.len:
        if !lowerAddUniqueName(names, globals[i].name):
            error = "global_i32 name must be unique"
            return false
    let paramCount = lowerParamCount(params, functions[idx].id)
    for i in 0..<paramCount:
        var param: LowerParam
        if !lowerParamAt(params, functions[idx].id, i, param):
            error = "param_i32 order must be contiguous"
            return false
        if !lowerAddUniqueName(names, param.name):
            error = "parameter name must be unique"
            return false
    if body.len > 0 && !strings.HasSuffix(body, "\n\n"):
        lowerAppend(body, "\n")
    if functions[idx].abiExport && functions[idx].name != "main":
        lowerAppend(body, "@exportc(")
        lowerAppend(body, lowerJsonQuote(functions[idx].name))
        lowerAppend(body, ")\n")
    lowerAppend(body, "fn ")
    lowerAppend(body, functions[idx].name)
    lowerAppend(body, "(")
    lowerAppend(body, lowerFunctionParamSource(params, functions[idx].id))
    lowerAppend(body, "): int32 =\n")
    let stmtCount = lowerStatementCount(statements, functions[idx].id)
    for order in 0..<stmtCount:
        var stmt: LowerStatement
        if !lowerStatementAt(statements, functions[idx].id, order, stmt):
            error = "statement order must be contiguous"
            return false
        if stmt.kind == "csg_dialect::native::stdout_line":
            var lit: str
            if !lowerChengStringLiteral(stmt.text, lit, error):
                return false
            lowerAppend(body, "    os.WriteLine(os.Get_stdout(), ")
            lowerAppend(body, lit)
            lowerAppend(body, ")\n")
        elif stmt.kind == "csg_dialect::native::local_i32":
            if lowerNamesContain(names, stmt.name):
                error = "local_i32 name must not duplicate a global, parameter, function, or prior local"
                return false
            if !lowerSafeExpr(stmt.expr, names, error):
                return false
            add(names, strings.CloneStr(stmt.name))
            lowerAppend(body, "    let ")
            lowerAppend(body, stmt.name)
            lowerAppend(body, ": int32 = ")
            lowerAppend(body, stmt.expr)
            lowerAppend(body, "\n")
        elif stmt.kind == "csg_dialect::native::store_global_i32":
            if lowerFindGlobalByName(globals, stmt.name) < 0:
                error = "store_global_i32 must reference a known global_i32"
                return false
            if !lowerSafeExpr(stmt.expr, names, error):
                return false
            lowerAppend(body, "    ")
            lowerAppend(body, stmt.name)
            lowerAppend(body, " = ")
            lowerAppend(body, stmt.expr)
            lowerAppend(body, "\n")
        else:
            error = "unknown lowered statement kind"
            return false
    if !lowerSafeExpr(functions[idx].returnExpr, names, error):
        return false
    lowerAppend(body, "    return ")
    lowerAppend(body, functions[idx].returnExpr)
    lowerAppend(body, "\n\n")
    return true

fn lowerBuildSource(functions: var LowerFunction[], globals: var LowerGlobal[], params: var LowerParam[], statements: var LowerStatement[], error: var str): LowerModel =
    var usesStdout: bool
    for i in 0..<statements.len:
        if statements[i].kind == "csg_dialect::native::stdout_line":
            usesStdout = true
    var body: str
    if usesStdout:
        body = "import std/os as os\n\n"
    lowerAppendGlobalsSource(body, globals)
    var mainReturn: int32 = -1
    var hasMain: bool
    for i in 0..<functions.len:
        if functions[i].name == "main":
            if functions[i].returnValue < 0 || functions[i].returnValue > 255:
                return lowerFail("main return value must be in exit range 0..255")
            hasMain = true
            mainReturn = functions[i].returnValue
        if !lowerAppendFunctionSource(body, functions, globals, params, statements, i, error):
            return lowerFail(error)
    return lowerOk(body, hasMain, mainReturn, functions.len, globals.len)

fn lowerFromLines(lines: str[]): LowerModel =
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            lines)
    if !validation.valid:
        return lowerFail("input CSG facts failed strict validation")
    if !validation.complete:
        return lowerFail("input CSG facts are not complete")
    var functions: LowerFunction[]
    var globals: LowerGlobal[]
    var declaredParams: LowerParam[]
    var params: LowerParam[]
    var statements: LowerStatement[]
    var error: str
    if !lowerParseFunctions(lines, functions, declaredParams, error):
        return lowerFail(error)
    if !lowerParseGlobals(lines, functions, globals, error):
        return lowerFail(error)
    if !lowerParseBodyFacts(lines, functions, globals, params, statements, error):
        return lowerFail(error)
    if !lowerValidateFunctionShape(functions, globals, declaredParams, params, statements, error):
        return lowerFail(error)
    var lowered =
        lowerBuildSource(
            functions, globals, params, statements, error)
    if !lowered.ok:
        return lowered
    lowered.factsRoot =
        strings.CloneStr(validation.factsRoot)
    lowered.profiles =
        csg.CsgCoreProfilesClone(validation.profiles)
    lowered.profileSetCid =
        strings.CloneStr(validation.profileSetCid)
    return lowered

@borrows
fn lowerJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            lowerAppend(out, "\\\\")
        elif ch == '"':
            lowerAppend(out, "\\\"")
        elif ch == '\n':
            lowerAppend(out, "\\n")
        elif ch == '\r':
            lowerAppend(out, "\\r")
        elif ch == '\t':
            lowerAppend(out, "\\t")
        else:
            lowerAppend(out, strings.CharToStr(ch))
    lowerAppend(out, "\"")
    return out

fn lowerJsonBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn lowerProfilesJson(profiles: var str[]): str =
    var out: str = "["
    for i in 0..<profiles.len:
        if i > 0:
            lowerAppend(out, ",")
        lowerAppend(out, lowerJsonQuote(profiles[i]))
    lowerAppend(out, "]")
    return out

@borrows
fn lowerReportJson(
        complete: bool,
        reason: str,
        mainPath: str,
        hasMain: bool,
        mainReturn: int32,
        functionCount: int32,
        globalCount: int32,
        factsRoot: str,
        profiles: var str[],
        profileSetCid: str): str =
    let isComplete =
        complete &&
        factsRoot.len > 0 &&
        profiles.len > 0 &&
        profileSetCid.len > 0
    var out: str = "{"
    lowerAppend(out, "\"schema\":\"cheng-csg.lower.report\"")
    lowerAppend(out, ",\"standard\":")
    lowerAppend(out, lowerJsonQuote(csg.CsgCoreStandardIdentity()))
    lowerAppend(out, ",\"profiles\":")
    if isComplete:
        lowerAppend(out, lowerProfilesJson(profiles))
    else:
        lowerAppend(out, "[]")
    lowerAppend(out, ",\"profile_set_cid\":")
    if isComplete:
        lowerAppend(out, lowerJsonQuote(profileSetCid))
    else:
        lowerAppend(out, "\"\"")
    lowerAppend(out, ",\"facts_root\":")
    if isComplete:
        lowerAppend(out, lowerJsonQuote(factsRoot))
    else:
        lowerAppend(out, "\"\"")
    lowerAppend(out, ",\"toolImplementation\":\"pure-cheng\"")
    lowerAppend(out, ",\"generatorImplementation\":\"pure-cheng\"")
    lowerAppend(out, ",\"pureChengGenerator\":true")
    lowerAppend(out, ",\"completionScope\":\"closed-subset-cheng-source-only\"")
    lowerAppend(out, ",\"fullProjectTranspilationComplete\":false")
    lowerAppend(out, ",\"complete\":")
    lowerAppend(out, lowerJsonBool(isComplete))
    if isComplete:
        lowerAppend(out, ",\"emit\":\"cheng-source\"")
        lowerAppend(out, ",\"files\":[")
        lowerAppend(out, lowerJsonQuote(mainPath))
        lowerAppend(out, "]")
        lowerAppend(out, ",\"entry\":")
        lowerAppend(out, lowerJsonQuote(mainPath))
        if hasMain:
            if globalCount > 0:
                lowerAppend(out, ",\"closedSubset\":\"function-graph-static-global-i32-stdout-return-i32.v1\"")
            else:
                lowerAppend(out, ",\"closedSubset\":\"function-graph-local-stdout-return-i32.v1\"")
            lowerAppend(out, ",\"closedReturn\":")
            lowerAppend(out, strings.IntToStr(mainReturn))
        else:
            if globalCount > 0:
                lowerAppend(out, ",\"closedSubset\":\"function-graph-static-global-i32-return-i32-library.v1\"")
            else:
                lowerAppend(out, ",\"closedSubset\":\"function-graph-local-return-i32-library.v1\"")
            lowerAppend(out, ",\"closedReturn\":null")
        lowerAppend(out, ",\"closedFunctionCount\":")
        lowerAppend(out, strings.IntToStr(functionCount))
        lowerAppend(out, ",\"closedGlobalCount\":")
        lowerAppend(out, strings.IntToStr(globalCount))
    else:
        lowerAppend(out, ",\"reason\":")
        lowerAppend(out, lowerJsonQuote(reason))
    lowerAppend(out, "}")
    return out

@borrows
fn lowerFailureReport(reason: str): str =
    var profiles: str[]
    return lowerReportJson(
        false, reason, "", false, -1, 0, 0,
        "", profiles, "")

fn lowerUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: cheng_csg_lower lower --in <facts> --emit cheng-source --out-dir <dir> --report-out <report>")
    return 2

fn LowerRunPaths(inputPath: str, emit: str, outDir: str, reportOut: str): int32 =
    if inputPath.len == 0 || emit.len == 0 || outDir.len == 0 || reportOut.len == 0:
        return lowerUsage()
    if emit != "cheng-source":
        os.WriteFile(
            reportOut,
            lowerFailureReport(
                "only --emit cheng-source is supported"))
        os.WriteLine(os.Get_stderr(), "error: only --emit cheng-source is supported")
        return 2
    var readResult: Result[str] = os.ReadFileResult(inputPath)
    if result.IsErr(readResult):
        os.WriteFile(
            reportOut,
            lowerFailureReport("failed to read input facts"))
        os.WriteLine(os.Get_stderr(), "error: failed to read input facts")
        return 1
    let lines = jsonl.CsgCoreJsonlSplitLines(result.Value(readResult))
    var lowered = lowerFromLines(lines)
    if !lowered.ok:
        os.WriteFile(
            reportOut,
            lowerFailureReport(lowered.error))
        os.WriteLine(os.Get_stderr(), lowerCat("error: ", lowered.error))
        return 1
    os.MkdirAll(outDir, 493)
    let mainPath = os.JoinPath(outDir, "main.cheng")
    os.WriteFile(mainPath, lowered.source)
    os.WriteFile(
        reportOut,
        lowerReportJson(
            true,
            "",
            mainPath,
            lowered.hasMain,
            lowered.mainReturn,
            lowered.functionCount,
            lowered.globalCount,
            lowered.factsRoot,
            lowered.profiles,
            lowered.profileSetCid))
    return 0

fn lowerRun(): int32 =
    return LowerRunPaths(lowerOwn(cmdline.ReadFlagOrDefault("--in", "")),
                         lowerOwn(cmdline.ReadFlagOrDefault("--emit", "")),
                         lowerOwn(cmdline.ReadFlagOrDefault("--out-dir", "")),
                         lowerOwn(cmdline.ReadFlagOrDefault("--report-out", "")))

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return lowerUsage()
    let command = cmdline.ParamStr(1)
    if command != "lower":
        return lowerUsage()
    return lowerRun()
