import std/cmdline
import std/os
import std/strings
import cheng/codex/std/process

type
    CliRun =
        ok: bool
        exitCode: int32
        stdout: str
        stderr: str

fn cliCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn cliPath(a: str, b: str): str =
    return os.JoinPath(a, b)

fn cliRun(argv: str[], cwd: str): CliRun =
    var out: CliRun
    if argv.len <= 0:
        out.stderr = "empty command"
        return out
    var args: str[]
    for i in 1..<argv.len:
        add(args, strings.CloneStr(argv[i]))
    let handle = process.ProcessSpawnRaw(argv[0], args, cwd, [])
    if !handle.ok:
        out.stderr = handle.error
        return out
    if handle.stdinFd >= 0:
        process.ProcessCloseFd(handle.stdinFd)
    out.stdout = process.ProcessReadFdBlocking(handle.stdoutFd, 30000)
    out.stderr = process.ProcessReadFdBlocking(handle.stderrFd, 30000)
    out.exitCode = process.ProcessWait(handle.pid)
    if handle.stdoutFd >= 0:
        process.ProcessCloseFd(handle.stdoutFd)
    if handle.stderrFd >= 0:
        process.ProcessCloseFd(handle.stderrFd)
    out.ok = out.exitCode == 0
    return out

fn cliAppendForwarded(out: var str[]) =
    let count = cmdline.ParamCount()
    var i: int32 = 2
    while i <= count:
        add(out, cmdline.ParamStr(i))
        i = i + 1

fn cliCompile(toolRoot: str, source: str, target: str, outExe: str, report: str, providerBundle: bool): bool =
    let parent = os.ParentDir(outExe)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    let reportParent = os.ParentDir(report)
    if reportParent.len > 0:
        os.MkdirAll(reportParent, 493)
    var args: str[] = [
        cliPath(cliPath(toolRoot, "artifacts"), "backend_driver/cheng"),
        "system-link-exec",
        cliCat("--root:", toolRoot),
        cliCat("--in:", source),
        "--emit:exe",
        cliCat("--target:", target)
    ]
    if providerBundle:
        add(args, "--runtime-provider-bundle:codex-app-server")
    add(args, cliCat("--out:", outExe))
    add(args, cliCat("--report-out:", report))
    let run = cliRun(args, toolRoot)
    if !run.ok:
        if run.stderr.len > 0:
            os.WriteLine(os.Get_stderr(), run.stderr)
        return false
    return true

fn cliRunLower(toolRoot: str, hostTarget: str): int32 =
    let outDir = cmdline.ReadFlagOrDefault("--out-dir", "")
    let target = cmdline.ReadFlagOrDefault("--target", hostTarget)
    let pureDir = cliPath(cliPath(cliPath(outDir, ".cheng-csg"), "pure-lower"), target)
    let exe = cliPath(pureDir, "cheng-csg-lower-pure")
    let report = cliPath(pureDir, "compile.report.txt")
    if !cliCompile(toolRoot, cliPath(toolRoot, "src/core/csg_migration/cheng_csg_lower.cheng"), target, exe, report, false):
        return 1
    var forwarded: str[] = [exe, "lower"]
    cliAppendForwarded(forwarded)
    let run = cliRun(forwarded, outDir)
    if run.stderr.len > 0:
        os.WriteLine(os.Get_stderr(), run.stderr)
    if run.stdout.len > 0:
        os.WriteLine(os.Get_stdout(), run.stdout)
    return run.exitCode

fn cliRunProve(toolRoot: str, hostTarget: str): int32 =
    let outPath = cmdline.ReadFlagOrDefault("--out", "")
    let target = cmdline.ReadFlagOrDefault("--target", hostTarget)
    let parent = os.ParentDir(outPath)
    let pureDir = cliPath(cliPath(cliPath(parent, ".cheng-csg"), "pure-prove"), target)
    let exe = cliPath(pureDir, "cheng-csg-prove-pure")
    let report = cliPath(pureDir, "compile.report.txt")
    if !cliCompile(toolRoot, cliPath(toolRoot, "src/core/csg_migration/cheng_csg_prove.cheng"), target, exe, report, true):
        return 1
    var forwarded: str[] = [exe, "prove"]
    cliAppendForwarded(forwarded)
    let run = cliRun(forwarded, parent)
    if run.stderr.len > 0:
        os.WriteLine(os.Get_stderr(), run.stderr)
    if run.stdout.len > 0:
        os.WriteLine(os.Get_stdout(), run.stdout)
    return run.exitCode

fn cliRunMigrate(toolRoot: str, hostTarget: str): int32 =
    let outDir = cmdline.ReadFlagOrDefault("--out-dir", "")
    let binDir = cliPath(outDir, "bin")
    let exe = cliPath(binDir, "cheng-csg-migrate-pure")
    let report = cliPath(cliPath(outDir, "reports"), "pure-migrate.compile.report.txt")
    if !cliCompile(toolRoot, cliPath(toolRoot, "src/core/csg_migration/cheng_csg_migrate.cheng"), hostTarget, exe, report, true):
        return 1
    var forwarded: str[] = [exe, "migrate"]
    cliAppendForwarded(forwarded)
    let run = cliRun(forwarded, toolRoot)
    if run.stderr.len > 0:
        os.WriteLine(os.Get_stderr(), run.stderr)
    if run.stdout.len > 0:
        os.WriteLine(os.Get_stdout(), run.stdout)
    return run.exitCode

fn cliUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: cheng-csg lower|prove|migrate ...")
    return 2

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return cliUsage()
    let toolRoot = cmdline.ReadFlagOrDefault("--tool-root", os.GetCurrentDir())
    let hostTarget = cmdline.ReadFlagOrDefault("--host-target", "")
    if hostTarget.len == 0:
        os.WriteLine(os.Get_stderr(), "error: cheng-csg requires --host-target")
        return 2
    let command = cmdline.ParamStr(1)
    if command == "lower":
        return cliRunLower(toolRoot, hostTarget)
    if command == "prove":
        return cliRunProve(toolRoot, hostTarget)
    if command == "migrate":
        return cliRunMigrate(toolRoot, hostTarget)
    return cliUsage()
