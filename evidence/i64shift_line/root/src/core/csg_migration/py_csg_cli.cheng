import std/cmdline
import std/os
import std/result
import std/strings
import cheng/codex/std/process
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/validator as csg

type
    PyToolRun =
        ok: bool
        exitCode: int32
        stdout: str
        stderr: str
        commandText: str

    PyToolConfig =
        toolRoot: str
        hostTarget: str
        root: str
        pythonVersion: str
        entry: str
        outPath: str
        reportOut: str

fn pyToolCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn pyToolAppend(out: var str, piece: str) =
    out = pyToolCat(out, piece)

fn pyToolPath(a: str, b: str): str =
    return os.JoinPath(a, b)

fn pyToolOwn(raw: str): str =
    return strings.ConcatStr("", raw)

fn pyToolJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            pyToolAppend(out, "\\\\")
        elif ch == '"':
            pyToolAppend(out, "\\\"")
        elif ch == '\n':
            pyToolAppend(out, "\\n")
        elif ch == '\r':
            pyToolAppend(out, "\\r")
        elif ch == '\t':
            pyToolAppend(out, "\\t")
        else:
            pyToolAppend(out, strings.CharToStr(ch))
    pyToolAppend(out, "\"")
    return out

fn pyToolTail(text: str): str =
    if text.len <= 4000:
        return text
    return strings.SliceBytes(text, text.len - 4000, 4000)

fn pyToolShellText(command: str, args: str[]): str =
    var out: str = command
    for i in 0..<args.len:
        pyToolAppend(out, " ")
        pyToolAppend(out, args[i])
    return out

fn pyToolRun(command: str, args: str[], cwd: str): PyToolRun =
    var out: PyToolRun
    out.commandText = pyToolShellText(command, args)
    let handle = process.ProcessSpawnRaw(command, args, cwd, [])
    if !handle.ok:
        out.stderr = handle.error
        return out
    if handle.stdinFd >= 0:
        process.ProcessCloseFd(handle.stdinFd)
    out.stdout = process.ProcessReadFdBlocking(handle.stdoutFd, 30000)
    out.stderr = process.ProcessReadFdBlocking(handle.stderrFd, 30000)
    out.exitCode = process.ProcessWait(handle.pid)
    if handle.stdoutFd >= 0:
        process.ProcessCloseFd(handle.stdoutFd)
    if handle.stderrFd >= 0:
        process.ProcessCloseFd(handle.stderrFd)
    out.ok = out.exitCode == 0
    return out

fn pyToolTopString(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn pyToolFailureReport(reason: str, failedStep: str, run: PyToolRun): str =
    var out: str = "{"
    pyToolAppend(out, "\"schema\":\"csg-core.report\"")
    pyToolAppend(out, ",\"standard\":")
    pyToolAppend(
        out,
        pyToolJsonQuote(csg.CsgCoreStandardIdentity()))
    pyToolAppend(out, ",\"profiles\":[]")
    pyToolAppend(out, ",\"profile_set_cid\":\"\"")
    pyToolAppend(out, ",\"facts_root\":\"\"")
    pyToolAppend(out, ",\"dialect\":\"csg_dialect::python\"")
    pyToolAppend(out, ",\"toolImplementation\":\"pure-cheng-py-csg-cli\"")
    pyToolAppend(out, ",\"reportControllerImplementation\":\"pure-cheng\"")
    pyToolAppend(out, ",\"extractorImplementation\":\"pure-cheng-cpython-oracle-json\"")
    pyToolAppend(out, ",\"extractorOracle\":\"cpython-ast-symtable-bytecode-json\"")
    pyToolAppend(out, ",\"pureChengToolchainComplete\":false")
    pyToolAppend(out, ",\"fullProjectTranspilationComplete\":false")
    pyToolAppend(out, ",\"complete\":false")
    pyToolAppend(out, ",\"failedStep\":")
    pyToolAppend(out, pyToolJsonQuote(failedStep))
    pyToolAppend(out, ",\"reason\":")
    pyToolAppend(out, pyToolJsonQuote(reason))
    pyToolAppend(out, ",\"counts\":{\"factCount\":0,\"unsupported\":0,\"runtimeRequirements\":0,\"externalSymbols\":0}")
    pyToolAppend(out, ",\"unsupported\":[]")
    pyToolAppend(out, ",\"runtimeRequirements\":[]")
    pyToolAppend(out, ",\"externalSymbols\":[]")
    pyToolAppend(out, ",\"entryRoots\":[]")
    if run.commandText.len > 0:
        pyToolAppend(out, ",\"commandText\":")
        pyToolAppend(out, pyToolJsonQuote(run.commandText))
    if run.stdout.len > 0:
        pyToolAppend(out, ",\"stdoutTail\":")
        pyToolAppend(out, pyToolJsonQuote(pyToolTail(run.stdout)))
    if run.stderr.len > 0:
        pyToolAppend(out, ",\"stderrTail\":")
        pyToolAppend(out, pyToolJsonQuote(pyToolTail(run.stderr)))
    pyToolAppend(out, "}\n")
    return out

fn pyToolWriteFailure(reportOut: str, reason: str, failedStep: str, run: PyToolRun) =
    if reportOut.len == 0:
        return
    let parent = os.ParentDir(reportOut)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    os.WriteFile(reportOut, pyToolFailureReport(reason, failedStep, run))

fn pyToolCompileEmitter(cfg: PyToolConfig, pureExe: str, compileReport: str, failedRun: var PyToolRun): bool =
    let parent = os.ParentDir(pureExe)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    var args: str[] = [
        "system-link-exec",
        pyToolCat("--root:", cfg.toolRoot),
        pyToolCat("--in:", pyToolPath(cfg.toolRoot, "src/core/csg_migration/py_csg_ast_emit.cheng")),
        "--emit:exe",
        pyToolCat("--target:", cfg.hostTarget),
        pyToolCat("--out:", pureExe),
        pyToolCat("--report-out:", compileReport)
    ]
    let run = pyToolRun(pyToolPath(pyToolPath(cfg.toolRoot, "artifacts"), "backend_driver/cheng"), args, cfg.toolRoot)
    if !run.ok:
        failedRun = run
        return false
    return true

fn pyToolRunOracle(cfg: PyToolConfig, oracleOut: str, failedRun: var PyToolRun): bool =
    var args: str[] = [
        pyToolPath(cfg.toolRoot, "tools/py-csg-oracle"),
        "oracle",
        "--root",
        cfg.root,
        "--python-version",
        cfg.pythonVersion,
        "--entry",
        cfg.entry,
        "--out",
        oracleOut
    ]
    let run = pyToolRun("python3", args, cfg.toolRoot)
    if !run.ok:
        failedRun = run
        return false
    return true

fn pyToolRunEmitter(args: str[], cfg: PyToolConfig, failedRun: var PyToolRun): bool =
    var forwarded: str[]
    for i in 1..<args.len:
        add(forwarded, strings.CloneStr(args[i]))
    let run = pyToolRun(args[0], forwarded, cfg.toolRoot)
    if !run.ok:
        failedRun = run
        return false
    return true

fn pyToolEmit(cfg: PyToolConfig): int32 =
    if cfg.root.len == 0 || cfg.pythonVersion.len == 0 || cfg.entry.len == 0 || cfg.outPath.len == 0 || cfg.reportOut.len == 0:
        var emptyRun: PyToolRun
        pyToolWriteFailure(cfg.reportOut, "py-csg emit requires --root, --python-version, --entry, --out and --report-out", "parse-arguments", emptyRun)
        os.WriteLine(os.Get_stderr(), "error: py-csg emit missing required arguments")
        return 2
    let reportParent = os.ParentDir(cfg.reportOut)
    let pureDir = pyToolPath(pyToolPath(pyToolPath(reportParent, ".py-csg"), "pure-emit"), cfg.hostTarget)
    let pureExe = pyToolPath(pureDir, "py-csg-oracle-emit-pure")
    let compileReport = pyToolPath(pureDir, "compile.report.txt")
    let oracleOut = pyToolPath(pureDir, "cpython.oracle.json")
    var failedRun: PyToolRun
    if !pyToolCompileEmitter(cfg, pureExe, compileReport, failedRun):
        pyToolWriteFailure(cfg.reportOut, "failed to compile pure Python oracle emitter", "compile-pure-py-csg-emit", failedRun)
        os.WriteLine(os.Get_stderr(), "error: failed to compile pure Python oracle emitter")
        return 1
    if !pyToolRunOracle(cfg, oracleOut, failedRun):
        pyToolWriteFailure(cfg.reportOut, "CPython oracle failed", "cpython-oracle", failedRun)
        os.WriteLine(os.Get_stderr(), "error: CPython oracle failed")
        return 1
    var oracleRead: Result[str] = os.ReadFileResult(oracleOut)
    if result.IsErr(oracleRead):
        pyToolWriteFailure(cfg.reportOut, "failed to read CPython oracle JSON", "cpython-oracle", failedRun)
        os.WriteLine(os.Get_stderr(), "error: failed to read CPython oracle JSON")
        return 1
    var source: str
    var displayPath: str
    let oracleText = result.Value(oracleRead)
    if !pyToolTopString(oracleText, "source", source) || !pyToolTopString(oracleText, "displayPath", displayPath):
        pyToolWriteFailure(cfg.reportOut, "CPython oracle JSON missing source/displayPath", "cpython-oracle", failedRun)
        os.WriteLine(os.Get_stderr(), "error: CPython oracle JSON missing source/displayPath")
        return 1
    var args: str[] = [
        pureExe,
        "emit",
        "--oracle-json",
        oracleOut,
        "--root",
        cfg.root,
        "--source",
        source,
        "--display-path",
        displayPath,
        "--entry",
        cfg.entry,
        "--python-version",
        cfg.pythonVersion,
        "--out",
        cfg.outPath,
        "--report-out",
        cfg.reportOut,
        "--tool-implementation",
        "pure-cheng-py-csg-cli"
    ]
    if !pyToolRunEmitter(args, cfg, failedRun):
        if !os.FileExists(cfg.reportOut):
            pyToolWriteFailure(cfg.reportOut, "pure Python oracle emitter failed", "pure-py-csg-oracle-emit", failedRun)
        os.WriteLine(os.Get_stderr(), "error: pure Python oracle emitter failed")
        return 1
    return 0

fn pyToolUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: py-csg emit --root <pkg-root> --python-version <x.y> --entry <module> --out out.csgcore --report-out report.json")
    return 2

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return pyToolUsage()
    if cmdline.ParamStr(1) != "emit":
        return pyToolUsage()
    var cfg: PyToolConfig
    cfg.toolRoot = pyToolOwn(cmdline.ReadFlagOrDefault("--tool-root", ""))
    cfg.hostTarget = pyToolOwn(cmdline.ReadFlagOrDefault("--host-target", ""))
    if cfg.toolRoot.len == 0:
        cfg.toolRoot = os.GetCurrentDir()
    if cfg.hostTarget.len == 0:
        os.WriteLine(os.Get_stderr(), "error: py-csg requires --host-target")
        return 2
    cfg.root = pyToolOwn(cmdline.ReadFlagOrDefault("--root", ""))
    cfg.pythonVersion = pyToolOwn(cmdline.ReadFlagOrDefault("--python-version", ""))
    cfg.entry = pyToolOwn(cmdline.ReadFlagOrDefault("--entry", ""))
    cfg.outPath = pyToolOwn(cmdline.ReadFlagOrDefault("--out", ""))
    cfg.reportOut = pyToolOwn(cmdline.ReadFlagOrDefault("--report-out", ""))
    return pyToolEmit(cfg)
