import std/cmdline
import std/os
import std/result
import std/strings
import cheng/codex/std/process
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/validator as csg

type
    CToolRun =
        ok: bool
        exitCode: int32
        stdout: str
        stderr: str
        commandText: str

    CToolEntry =
        directory: str
        file: str
        source: str
        displayPath: str
        arguments: str[]

    CToolConfig =
        toolRoot: str
        hostTarget: str
        compileCommands: str
        target: str
        outPath: str
        reportOut: str

fn cToolCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn cToolAppend(out: var str, piece: str) =
    out = cToolCat(out, piece)

fn cToolPath(a: str, b: str): str =
    return os.JoinPath(a, b)

fn cToolOwn(raw: str): str =
    return strings.ConcatStr("", raw)

fn cToolJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            cToolAppend(out, "\\\\")
        elif ch == '"':
            cToolAppend(out, "\\\"")
        elif ch == '\n':
            cToolAppend(out, "\\n")
        elif ch == '\r':
            cToolAppend(out, "\\r")
        elif ch == '\t':
            cToolAppend(out, "\\t")
        else:
            cToolAppend(out, strings.CharToStr(ch))
    cToolAppend(out, "\"")
    return out

fn cToolIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

fn cToolSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && cToolIsWs(text[i]):
        i = i + 1
    return i

fn cToolTrimRaw(text: str): str =
    var start: int32 = cToolSkipWs(text, 0)
    if start >= text.len:
        return ""
    var finish: int32 = text.len
    while finish > start && cToolIsWs(text[finish - 1]):
        finish = finish - 1
    return strings.SliceBytes(text, start, finish - start)

fn cToolSkipJsonString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

fn cToolSkipJsonValue(text: str, start: int32): int32 =
    var i: int32 = cToolSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = cToolSkipJsonString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = cToolSkipJsonString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn cToolTopRaw(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn cToolTopString(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn cToolArrayObjects(rawArray: str): str[] =
    var out: str[]
    let raw = cToolTrimRaw(rawArray)
    if raw.len < 2 || raw[0] != '[':
        return out
    var pos: int32 = 1
    while pos < raw.len:
        pos = cToolSkipWs(raw, pos)
        if pos >= raw.len || raw[pos] == ']':
            return out
        let endPos = cToolSkipJsonValue(raw, pos)
        if endPos <= pos || endPos > raw.len:
            return out
        if raw[pos] == '{':
            add(out, strings.SliceBytes(raw, pos, endPos - pos))
        pos = cToolSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
    return out

fn cToolArrayStrings(rawArray: str): str[] =
    var out: str[]
    let raw = cToolTrimRaw(rawArray)
    if raw.len < 2 || raw[0] != '[':
        return out
    var pos: int32 = 1
    while pos < raw.len:
        pos = cToolSkipWs(raw, pos)
        if pos >= raw.len || raw[pos] == ']':
            return out
        if raw[pos] != '"':
            return out
        let endPos = cToolSkipJsonString(raw, pos)
        if endPos <= pos || endPos > raw.len:
            return out
        let wrapped = cToolCat("{\"v\":", cToolCat(strings.SliceBytes(raw, pos, endPos - pos), "}"))
        var decoded: str
        if cToolTopString(wrapped, "v", decoded):
            add(out, decoded)
        pos = cToolSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
    return out

fn cToolTail(text: str): str =
    if text.len <= 4000:
        return text
    return strings.SliceBytes(text, text.len - 4000, 4000)

fn cToolShellText(command: str, args: str[]): str =
    var out: str = command
    for i in 0..<args.len:
        cToolAppend(out, " ")
        cToolAppend(out, args[i])
    return out

fn cToolRun(command: str, args: str[], cwd: str): CToolRun =
    var out: CToolRun
    out.commandText = cToolShellText(command, args)
    let handle = process.ProcessSpawnRaw(command, args, cwd, [])
    if !handle.ok:
        out.stderr = handle.error
        return out
    if handle.stdinFd >= 0:
        process.ProcessCloseFd(handle.stdinFd)
    out.stdout = process.ProcessReadFdBlocking(handle.stdoutFd, 30000)
    out.stderr = process.ProcessReadFdBlocking(handle.stderrFd, 30000)
    out.exitCode = process.ProcessWait(handle.pid)
    if handle.stdoutFd >= 0:
        process.ProcessCloseFd(handle.stdoutFd)
    if handle.stderrFd >= 0:
        process.ProcessCloseFd(handle.stderrFd)
    out.ok = out.exitCode == 0
    return out

fn cToolFailureReport(reason: str, failedStep: str, run: CToolRun): str =
    var out: str = "{"
    cToolAppend(out, "\"schema\":\"csg-core.report\"")
    cToolAppend(out, ",\"standard\":")
    cToolAppend(
        out,
        cToolJsonQuote(csg.CsgCoreStandardIdentity()))
    cToolAppend(out, ",\"profiles\":[]")
    cToolAppend(out, ",\"profile_set_cid\":\"\"")
    cToolAppend(out, ",\"facts_root\":\"\"")
    cToolAppend(out, ",\"dialect\":\"csg_dialect::c\"")
    cToolAppend(out, ",\"toolImplementation\":\"pure-cheng-c-csg-cli\"")
    cToolAppend(out, ",\"reportControllerImplementation\":\"pure-cheng\"")
    cToolAppend(out, ",\"extractorImplementation\":\"pure-cheng-clang-ast-json\"")
    cToolAppend(out, ",\"extractorOracle\":\"clang-ast-dump-json\"")
    cToolAppend(out, ",\"pureChengToolchainComplete\":false")
    cToolAppend(out, ",\"fullProjectTranspilationComplete\":false")
    cToolAppend(out, ",\"complete\":false")
    cToolAppend(out, ",\"failedStep\":")
    cToolAppend(out, cToolJsonQuote(failedStep))
    cToolAppend(out, ",\"reason\":")
    cToolAppend(out, cToolJsonQuote(reason))
    cToolAppend(out, ",\"counts\":{\"factCount\":0,\"unsupported\":0,\"runtimeRequirements\":0,\"externalSymbols\":0}")
    cToolAppend(out, ",\"unsupported\":[]")
    cToolAppend(out, ",\"runtimeRequirements\":[]")
    cToolAppend(out, ",\"externalSymbols\":[]")
    cToolAppend(out, ",\"entryRoots\":[]")
    if run.commandText.len > 0:
        cToolAppend(out, ",\"commandText\":")
        cToolAppend(out, cToolJsonQuote(run.commandText))
    if run.stdout.len > 0:
        cToolAppend(out, ",\"stdoutTail\":")
        cToolAppend(out, cToolJsonQuote(cToolTail(run.stdout)))
    if run.stderr.len > 0:
        cToolAppend(out, ",\"stderrTail\":")
        cToolAppend(out, cToolJsonQuote(cToolTail(run.stderr)))
    cToolAppend(out, "}\n")
    return out

fn cToolWriteFailure(reportOut: str, reason: str, failedStep: str, run: CToolRun) =
    if reportOut.len == 0:
        return
    let parent = os.ParentDir(reportOut)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    os.WriteFile(reportOut, cToolFailureReport(reason, failedStep, run))

fn cToolRelDisplay(root: str, path: str): str =
    let rel = os.RelativePath(path, root)
    if rel.len > 0:
        return rel
    return path

fn cToolSourcePath(directory: str, file: str): str =
    if os.IsAbsolute(file):
        return file
    return os.JoinPath(directory, file)

fn cToolParseCompileCommands(path: str, entries: var CToolEntry[], err: var str): bool =
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        err = "missing compile_commands.json"
        return false
    let root = os.ParentDir(path)
    let objects = cToolArrayObjects(result.Value(readResult))
    if objects.len == 0:
        err = "compile_commands.json must be a non-empty array"
        return false
    for i in 0..<objects.len:
        var entry: CToolEntry
        if !cToolTopString(objects[i], "file", entry.file):
            err = "compile command entry missing file"
            return false
        if !cToolTopString(objects[i], "directory", entry.directory):
            entry.directory = root
        var argsRaw: str
        if !cToolTopRaw(objects[i], "arguments", argsRaw):
            err = "compile command entry requires arguments array"
            return false
        entry.arguments = cToolArrayStrings(argsRaw)
        if entry.arguments.len == 0:
            err = "compile command arguments must be non-empty"
            return false
        entry.source = cToolSourcePath(entry.directory, entry.file)
        entry.displayPath = cToolRelDisplay(root, entry.source)
        if !os.FileExists(entry.source):
            err = cToolCat("compile command source missing: ", entry.source)
            return false
        add(entries, entry)
    return true

fn cToolStringLess(a: str, b: str): bool =
    let n: int32 = if a.len < b.len: a.len else: b.len
    for i in 0..<n:
        if a[i] < b[i]:
            return true
        if a[i] > b[i]:
            return false
    return a.len < b.len

fn cToolSortEntries(entries: var CToolEntry[]) =
    for i in 0..<entries.len:
        var best = i
        for j in i + 1..<entries.len:
            if cToolStringLess(entries[j].displayPath, entries[best].displayPath):
                best = j
        if best != i:
            let tmp = entries[i]
            entries[i] = entries[best]
            entries[best] = tmp

@borrows
fn cToolSameSourceArg(arg: str, entry: CToolEntry): bool =
    if arg == entry.source || arg == entry.file || arg == entry.displayPath:
        return true
    let joined = os.JoinPath(entry.directory, arg)
    return joined == entry.source

@borrows
fn cToolStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn cToolSanitizedFlags(entry: CToolEntry): str[] =
    var out: str[]
    var i: int32 = 1
    while i < entry.arguments.len:
        let arg = entry.arguments[i]
        if arg == "-c" || arg == "-S" || arg == "-E" || arg == "-M" || arg == "-MM" || arg == "-MD" || arg == "-MMD" || arg == "-MP":
            i = i + 1
        elif arg == "-o" || arg == "-MF" || arg == "-MT" || arg == "-MQ" || arg == "-target":
            i = i + 2
        elif cToolStartsWith(arg, "-o") && arg != "-ObjC":
            i = i + 1
        elif cToolStartsWith(arg, "--target="):
            i = i + 1
        elif cToolSameSourceArg(arg, entry):
            i = i + 1
        else:
            add(out, arg)
            i = i + 1
    return out

fn cToolClangAst(entry: CToolEntry, target: str, astOut: str, astText: var str, err: var str, failedRun: var CToolRun): bool =
    if astOut.len == 0:
        err = "internal error: clang AST output path is empty"
        return false
    var args: str[] = [
        "-Xclang",
        "-ast-dump=json",
        "-fsyntax-only",
        cToolCat("--target=", target)
    ]
    let flags = cToolSanitizedFlags(entry)
    for i in 0..<flags.len:
        add(args, flags[i])
    add(args, entry.source)
    var shellCommand: str = "clang"
    for i in 0..<args.len:
        cToolAppend(shellCommand, " ")
        cToolAppend(shellCommand, os.QuoteShell(args[i]))
    cToolAppend(shellCommand, " > ")
    cToolAppend(shellCommand, os.QuoteShell(astOut))
    var shArgs: str[] = ["-c", shellCommand]
    let run = cToolRun("/bin/sh", shArgs, entry.directory)
    if !run.ok:
        failedRun = run
        err = cToolCat("clang rejected ", entry.source)
        return false
    astText = run.stdout
    var readAst: Result[str] = os.ReadFileResult(astOut)
    if result.IsErr(readAst):
        err = "failed to read clang AST JSON"
        return false
    astText = result.Value(readAst)
    return true

fn cToolCompileEmitter(cfg: CToolConfig, pureExe: str, compileReport: str, failedRun: var CToolRun): bool =
    let parent = os.ParentDir(pureExe)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    var args: str[] = [
        "system-link-exec",
        cToolCat("--root:", cfg.toolRoot),
        cToolCat("--in:", cToolPath(cfg.toolRoot, "src/core/csg_migration/c_csg_ast_emit.cheng")),
        "--emit:exe",
        cToolCat("--target:", cfg.hostTarget),
        cToolCat("--out:", pureExe),
        cToolCat("--report-out:", compileReport)
    ]
    let run = cToolRun(cToolPath(cToolPath(cfg.toolRoot, "artifacts"), "backend_driver/cheng"), args, cfg.toolRoot)
    if !run.ok:
        failedRun = run
        return false
    return true

fn cToolProjectOracle(entries: var CToolEntry[], target: str, astTexts: var str[]): str =
    var out: str = "{\"schema\":\"c-csg-clang-oracle.v1\",\"target\":"
    cToolAppend(out, cToolJsonQuote(target))
    cToolAppend(out, ",\"translationUnits\":[")
    for i in 0..<entries.len:
        if i > 0:
            cToolAppend(out, ",")
        cToolAppend(out, "{\"astJson\":")
        cToolAppend(out, astTexts[i])
        cToolAppend(out, ",\"displayPath\":")
        cToolAppend(out, cToolJsonQuote(entries[i].displayPath))
        cToolAppend(out, ",\"index\":")
        cToolAppend(out, strings.IntToStr(i))
        cToolAppend(out, ",\"source\":")
        cToolAppend(out, cToolJsonQuote(entries[i].source))
        cToolAppend(out, "}")
    cToolAppend(out, "]}\n")
    return out

fn cToolRunEmitter(args: var str[], cfg: CToolConfig, failedRun: var CToolRun): bool =
    var forwarded: str[]
    for i in 1..<args.len:
        add(forwarded, strings.CloneStr(args[i]))
    let run = cToolRun(args[0], forwarded, cfg.toolRoot)
    if !run.ok:
        failedRun = run
        return false
    return true

fn cToolEmit(cfg: CToolConfig): int32 =
    if cfg.compileCommands.len == 0 || cfg.target.len == 0 || cfg.outPath.len == 0 || cfg.reportOut.len == 0:
        var emptyRun: CToolRun
        cToolWriteFailure(cfg.reportOut, "c-csg emit requires --compile-commands, --target, --out and --report-out", "parse-arguments", emptyRun)
        os.WriteLine(os.Get_stderr(), "error: c-csg emit missing required arguments")
        return 2
    let reportParent = os.ParentDir(cfg.reportOut)
    let pureDir = cToolPath(cToolPath(cToolPath(reportParent, ".c-csg"), "pure-emit"), cfg.hostTarget)
    let pureExe = cToolPath(pureDir, "c-csg-ast-emit-pure")
    let compileReport = cToolPath(pureDir, "compile.report.txt")
    var failedRun: CToolRun
    if !cToolCompileEmitter(cfg, pureExe, compileReport, failedRun):
        cToolWriteFailure(cfg.reportOut, "failed to compile pure C AST emitter", "compile-pure-c-csg-emit", failedRun)
        os.WriteLine(os.Get_stderr(), "error: failed to compile pure C AST emitter")
        return 1
    var entries: CToolEntry[]
    var parseErr: str
    if !cToolParseCompileCommands(cfg.compileCommands, entries, parseErr):
        cToolWriteFailure(cfg.reportOut, parseErr, "compile-commands", failedRun)
        os.WriteLine(os.Get_stderr(), cToolCat("error: ", parseErr))
        return 1
    cToolSortEntries(entries)
    if entries.len == 1:
        let astOut = cToolPath(pureDir, "clang.ast.json")
        var astText: str
        var clangErr: str
        if !cToolClangAst(entries[0], cfg.target, astOut, astText, clangErr, failedRun):
            cToolWriteFailure(cfg.reportOut, clangErr, "clang-ast", failedRun)
            os.WriteLine(os.Get_stderr(), cToolCat("error: ", clangErr))
            return 1
        var args: str[] = [
            pureExe,
            "emit",
            "--clang-ast-json",
            astOut,
            "--source",
            entries[0].source,
            "--display-path",
            entries[0].displayPath,
            "--target",
            cfg.target,
            "--out",
            cfg.outPath,
            "--report-out",
            cfg.reportOut,
            "--tool-implementation",
            "pure-cheng-c-csg-cli"
        ]
        if !cToolRunEmitter(args, cfg, failedRun):
            if !os.FileExists(cfg.reportOut):
                cToolWriteFailure(cfg.reportOut, "pure C AST emitter failed", "pure-c-csg-ast-emit", failedRun)
            os.WriteLine(os.Get_stderr(), "error: pure C AST emitter failed")
            return 1
        return 0
    var astTexts: str[]
    for i in 0..<entries.len:
        var astText: str
        var clangErr: str
        let astOut = cToolPath(pureDir, cToolCat(cToolCat("clang.", strings.IntToStr(i)), ".ast.json"))
        if !cToolClangAst(entries[i], cfg.target, astOut, astText, clangErr, failedRun):
            cToolWriteFailure(cfg.reportOut, clangErr, "clang-ast", failedRun)
            os.WriteLine(os.Get_stderr(), cToolCat("error: ", clangErr))
            return 1
        add(astTexts, astText)
    let oracleOut = cToolPath(pureDir, "clang.project.oracle.json")
    os.WriteFile(oracleOut, cToolProjectOracle(entries, cfg.target, astTexts))
    var projectArgs: str[] = [
        pureExe,
        "emit",
        "--oracle-json",
        oracleOut,
        "--target",
        cfg.target,
        "--out",
        cfg.outPath,
        "--report-out",
        cfg.reportOut,
        "--tool-implementation",
        "pure-cheng-c-csg-cli"
    ]
    if !cToolRunEmitter(projectArgs, cfg, failedRun):
        if !os.FileExists(cfg.reportOut):
            cToolWriteFailure(cfg.reportOut, "pure C AST emitter failed", "pure-c-csg-ast-emit", failedRun)
        os.WriteLine(os.Get_stderr(), "error: pure C AST emitter failed")
        return 1
    return 0

fn cToolUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: c-csg emit --compile-commands compile_commands.json --target <triple> --out out.csgcore --report-out report.json")
    return 2

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return cToolUsage()
    if cmdline.ParamStr(1) != "emit":
        return cToolUsage()
    var cfg: CToolConfig
    cfg.toolRoot = cToolOwn(cmdline.ReadFlagOrDefault("--tool-root", ""))
    cfg.hostTarget = cToolOwn(cmdline.ReadFlagOrDefault("--host-target", ""))
    if cfg.toolRoot.len == 0:
        cfg.toolRoot = os.GetCurrentDir()
    if cfg.hostTarget.len == 0:
        os.WriteLine(os.Get_stderr(), "error: c-csg requires --host-target")
        return 2
    cfg.compileCommands = cToolOwn(cmdline.ReadFlagOrDefault("--compile-commands", ""))
    cfg.target = cToolOwn(cmdline.ReadFlagOrDefault("--target", ""))
    cfg.outPath = cToolOwn(cmdline.ReadFlagOrDefault("--out", ""))
    cfg.reportOut = cToolOwn(cmdline.ReadFlagOrDefault("--report-out", ""))
    return cToolEmit(cfg)
