import std/cmdline
import std/os
import std/result
import std/strings
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/validator as csg

const
    PyInt32Max: int64 = int64(2147483647)
    PyInt32MinAbs: int64 = int64(2147483648)

type
    PyEmitConfig =
        oracleIn: str
        root: str
        entry: str
        source: str
        displayPath: str
        pythonVersion: str
        outPath: str
        reportOut: str
        toolImplementation: str

    PyLocal =
        name: str
        value: int32

    PyGlobal =
        name: str
        initialValue: int32
        value: int32

    PyClosedStatement =
        kind: str
        name: str
        expr: str
        text: str
        value: int32

    PyFunction =
        moduleName: str
        name: str
        raw: str
        args: str[]
        body: str[]
        signatureClosed: bool

    PyModuleInfo =
        moduleName: str
        body: str[]

    PyExprResult =
        ok: bool
        error: str
        expr: str
        value: int32

    PyDeclResult =
        ok: bool
        error: str
        statement: PyClosedStatement

    PyClosedFunction =
        ok: bool
        error: str
        moduleName: str
        name: str
        parameters: str[]
        statements: PyClosedStatement[]
        returnExpr: str
        returnValue: int32

    PyBuildResult =
        facts: str[]
        complete: bool
        unsupportedCodes: str[]
        closedReturnSet: bool
        closedReturn: int32
        closedStatements: PyClosedStatement[]
        closedFunctions: PyClosedFunction[]
        globals: PyGlobal[]
        entryRootFunctions: str[]
        moduleCount: int32

@borrows
fn pyCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn pyAppend(out: var str, piece: str) =
    out = pyCat(out, piece)

fn pyOwn(raw: str): str =
    return strings.ConcatStr("", raw)

fn pyJsonBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn pyJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            pyAppend(out, "\\\\")
        elif ch == '"':
            pyAppend(out, "\\\"")
        elif ch == '\n':
            pyAppend(out, "\\n")
        elif ch == '\r':
            pyAppend(out, "\\r")
        elif ch == '\t':
            pyAppend(out, "\\t")
        else:
            pyAppend(out, strings.CharToStr(ch))
    pyAppend(out, "\"")
    return out

fn pyIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn pySkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && pyIsWs(text[i]):
        i = i + 1
    return i

fn pyTrimRaw(text: str): str =
    var start: int32 = pySkipWs(text, 0)
    if start >= text.len:
        return ""
    var finish: int32 = text.len
    while finish > start && pyIsWs(text[finish - 1]):
        finish = finish - 1
    return strings.SliceBytes(text, start, finish - start)

@borrows
fn pySkipJsonString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

@borrows
fn pySkipJsonValue(text: str, start: int32): int32 =
    var i: int32 = pySkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = pySkipJsonString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = pySkipJsonString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn pyTopString(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn pyTopRaw(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn pyTopBool(raw: str, name: str): bool =
    var value: str
    if !pyTopRaw(raw, name, value):
        return false
    return pyTrimRaw(value) == "true"

fn pyDigitValueAt(text: str, index: int32): int32 =
    let digit = strings.SliceBytes(text, index, 1)
    if digit == "0":
        return 0
    if digit == "1":
        return 1
    if digit == "2":
        return 2
    if digit == "3":
        return 3
    if digit == "4":
        return 4
    if digit == "5":
        return 5
    if digit == "6":
        return 6
    if digit == "7":
        return 7
    if digit == "8":
        return 8
    if digit == "9":
        return 9
    return -1

fn pyParseInt32Raw(rawText: str, out: var int32): bool =
    let raw = pyTrimRaw(rawText)
    if raw.len == 0:
        return false
    if raw == "0":
        out = 0
        return true
    if raw == "1":
        out = 1
        return true
    if raw == "2":
        out = 2
        return true
    if raw == "3":
        out = 3
        return true
    if raw == "4":
        out = 4
        return true
    if raw == "5":
        out = 5
        return true
    if raw == "6":
        out = 6
        return true
    if raw == "7":
        out = 7
        return true
    if raw == "8":
        out = 8
        return true
    if raw == "9":
        out = 9
        return true
    var i: int32
    var sign: int64 = int64(1)
    var limit: int64 = PyInt32Max
    if raw[0] == '-':
        sign = int64(-1)
        limit = PyInt32MinAbs
        i = 1
    elif raw[0] == '+':
        i = 1
    if i >= raw.len:
        return false
    var value: int64
    while i < raw.len:
        let digit = pyDigitValueAt(raw, i)
        if digit < 0:
            return false
        value = value * int64(10) + int64(digit)
        if value > limit:
            return false
        i = i + 1
    let signed = value * sign
    if signed < int64(-2147483648) || signed > int64(2147483647):
        return false
    out = int32(signed)
    return true

fn pyTopInt32(raw: str, name: str, out: var int32): bool =
    var rawValue: str
    if !pyTopRaw(raw, name, rawValue):
        return false
    return pyParseInt32Raw(rawValue, out)

fn pyStringLess(a: str, b: str): bool =
    let n: int32 = if a.len < b.len: a.len else: b.len
    for i in 0..<n:
        if a[i] < b[i]:
            return true
        if a[i] > b[i]:
            return false
    return a.len < b.len

fn pyIsAlpha(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')

fn pyIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn pyIsIdentStart(ch: char): bool =
    return pyIsAlpha(ch) || ch == '_'

fn pyIsIdentChar(ch: char): bool =
    return pyIsIdentStart(ch) || pyIsDigit(ch)

fn pyValidIdentifier(name: str): bool =
    if name.len == 0:
        return false
    if !pyIsIdentStart(name[0]):
        return false
    for i in 1..<name.len:
        if !pyIsIdentChar(name[i]):
            return false
    return true

fn pySafeIdChar(ch: char): bool =
    return pyIsAlpha(ch) || pyIsDigit(ch) || ch == '_' || ch == '.' || ch == ':' || ch == '-'

fn pySafeId(text: str): str =
    var raw: str
    var inGap: bool
    for i in 0..<text.len:
        if pySafeIdChar(text[i]):
            pyAppend(raw, strings.CharToStr(text[i]))
            inGap = false
        elif !inGap:
            pyAppend(raw, "_")
            inGap = true
    var start: int32
    while start < raw.len && raw[start] == '_':
        start = start + 1
    var finish: int32 = raw.len
    while finish > start && raw[finish - 1] == '_':
        finish = finish - 1
    if finish <= start:
        return "root"
    return strings.SliceBytes(raw, start, finish - start)

fn pyArrayObjects(rawArray: str): str[] =
    var out: str[]
    let raw = pyTrimRaw(rawArray)
    if raw.len < 2 || raw[0] != '[':
        return out
    var pos: int32 = 1
    while pos < raw.len:
        pos = pySkipWs(raw, pos)
        if pos >= raw.len || raw[pos] == ']':
            return out
        let endPos = pySkipJsonValue(raw, pos)
        if endPos <= pos || endPos > raw.len:
            return out
        if raw[pos] == '{':
            add(out, strings.SliceBytes(raw, pos, endPos - pos))
        pos = pySkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
    return out

fn pyArrayStrings(rawArray: str): str[] =
    var out: str[]
    let raw = pyTrimRaw(rawArray)
    if raw.len < 2 || raw[0] != '[':
        return out
    var pos: int32 = 1
    while pos < raw.len:
        pos = pySkipWs(raw, pos)
        if pos >= raw.len || raw[pos] == ']':
            return out
        if raw[pos] != '"':
            return out
        let endPos = pySkipJsonString(raw, pos)
        if endPos <= pos || endPos > raw.len:
            return out
        let decoded = field.CsgCoreJsonTopStringField(pyCat("{\"v\":", pyCat(strings.SliceBytes(raw, pos, endPos - pos), "}")), "v")
        if decoded.found:
            add(out, decoded.value)
        pos = pySkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
    return out

fn pyRawArrayLength(rawArray: str): int32 =
    let objects = pyArrayObjects(rawArray)
    if objects.len > 0:
        return objects.len
    let strings = pyArrayStrings(rawArray)
    if strings.len > 0:
        return strings.len
    let raw = pyTrimRaw(rawArray)
    if raw == "[]":
        return 0
    return -1

fn pyExprFail(code: str): PyExprResult =
    var out: PyExprResult
    out.error = code
    return out

fn pyDeclFail(code: str): PyDeclResult =
    var out: PyDeclResult
    out.error = code
    return out

fn pyFunctionFail(code: str): PyClosedFunction =
    var out: PyClosedFunction
    out.error = code
    return out

fn pyAddUnsupported(out: var str[], code: str) =
    if code.len == 0:
        return
    for i in 0..<out.len:
        if out[i] == code:
            return
    add(out, code)
    var pos: int32 = out.len - 1
    while pos > 0 && pyStringLess(out[pos], out[pos - 1]):
        let tmp = out[pos - 1]
        out[pos - 1] = out[pos]
        out[pos] = tmp
        pos = pos - 1

fn pyFindFunction(functions: var PyFunction[], name: str): int32 =
    for i in 0..<functions.len:
        if functions[i].name == name:
            return i
    return -1

fn pyStackContains(stack: var str[], name: str): bool =
    for i in 0..<stack.len:
        if stack[i] == name:
            return true
    return false

fn pyFindLocal(locals: var PyLocal[], name: str, out: var int32): bool =
    for i in 0..<locals.len:
        if locals[i].name == name:
            out = locals[i].value
            return true
    return false

fn pyFindGlobal(globals: var PyGlobal[], name: str, out: var int32): bool =
    for i in 0..<globals.len:
        if globals[i].name == name:
            out = globals[i].value
            return true
    return false

fn pyFindGlobalIndex(globals: var PyGlobal[], name: str): int32 =
    for i in 0..<globals.len:
        if globals[i].name == name:
            return i
    return -1

fn pyGlobalNameExists(globals: var PyGlobal[], name: str): bool =
    var unused: int32
    return pyFindGlobal(globals, name, unused)

fn pySetLocal(locals: var PyLocal[], name: str, value: int32): bool =
    for i in 0..<locals.len:
        if locals[i].name == name:
            return false
    var local: PyLocal
    local.name = name
    local.value = value
    add(locals, local)
    return true

fn pySetGlobalValue(globals: var PyGlobal[], name: str, value: int32): bool =
    for i in 0..<globals.len:
        if globals[i].name == name:
            globals[i].value = value
            return true
    return false

fn pyCloneGlobals(globals: var PyGlobal[]): PyGlobal[] =
    var out: PyGlobal[]
    for i in 0..<globals.len:
        var item: PyGlobal
        item.name = globals[i].name
        item.initialValue = globals[i].initialValue
        item.value = globals[i].initialValue
        add(out, item)
    return out

fn pyFunctionFromRaw(raw: str, out: var PyFunction, error: var str): bool =
    var name: str
    if !pyTopString(raw, "name", name) || !pyValidIdentifier(name) || name == "main":
        error = "python.frontend.helper_name_not_closed"
        return false
    var argsRaw: str
    var bodyRaw: str
    if !pyTopRaw(raw, "args", argsRaw) || !pyTopRaw(raw, "body", bodyRaw):
        error = "python.frontend.helper_signature_not_closed"
        return false
    let args = pyArrayStrings(argsRaw)
    if args.len > 8 || pyRawArrayLength(argsRaw) != args.len:
        error = "python.frontend.helper_arity_not_closed"
        return false
    for i in 0..<args.len:
        if !pyValidIdentifier(args[i]):
            error = "python.frontend.helper_param_not_closed"
            return false
        for j in 0..<i:
            if args[j] == args[i]:
                error = "python.frontend.helper_param_not_closed"
                return false
    if !pyTopBool(raw, "signatureClosed"):
        error = "python.frontend.helper_signature_not_closed"
        return false
    var moduleName: str
    if !pyTopString(raw, "module", moduleName):
        moduleName = ""
    out.moduleName = moduleName
    out.name = name
    out.raw = raw
    out.args = args
    out.body = pyArrayObjects(bodyRaw)
    out.signatureClosed = true
    return true

fn pyInt32Op(left: int32, op: str, right: int32, out: var int32): bool =
    var value: int64
    if op == "+":
        value = int64(left) + int64(right)
    elif op == "-":
        value = int64(left) - int64(right)
    elif op == "*":
        value = int64(left) * int64(right)
    else:
        return false
    if value < int64(-2147483648) || value > int64(2147483647):
        return false
    out = int32(value)
    return true

fn pyBinOpText(op: str, out: var str): bool =
    if op == "Add":
        out = "+"
        return true
    if op == "Sub":
        out = "-"
        return true
    if op == "Mult":
        out = "*"
        return true
    return false

fn pyExprContainsCall(raw: str): bool =
    var kind: str
    if !pyTopString(raw, "kind", kind):
        return false
    if kind == "Call":
        return true
    if kind == "BinOp":
        var leftRaw: str
        var rightRaw: str
        if !pyTopRaw(raw, "left", leftRaw) || !pyTopRaw(raw, "right", rightRaw):
            return false
        return pyExprContainsCall(leftRaw) || pyExprContainsCall(rightRaw)
    if kind == "UnaryOp":
        var operandRaw: str
        if !pyTopRaw(raw, "operand", operandRaw):
            return false
        return pyExprContainsCall(operandRaw)
    return false

fn pyExpr(raw: str,
          locals: var PyLocal[],
          globals: var PyGlobal[],
          functions: var PyFunction[],
          stack: var str[]): PyExprResult =
    var kind: str
    if !pyTopString(raw, "kind", kind):
        return pyExprFail("python.frontend.expression_not_closed")
    if kind == "Constant":
        var valueKind: str
        if !pyTopString(raw, "valueKind", valueKind) || valueKind != "int":
            return pyExprFail("python.frontend.expression_not_closed")
        var value: int32
        if !pyTopInt32(raw, "intValue", value):
            return pyExprFail("python.frontend.int32_overflow_not_closed")
        var out: PyExprResult
        out.ok = true
        out.expr = strings.IntToStr(value)
        out.value = value
        return out
    if kind == "Name":
        var name: str
        if !pyTopString(raw, "id", name):
            return pyExprFail("python.frontend.only_local_or_global_i32_names_are_closed")
        var value: int32
        if !pyValidIdentifier(name):
            return pyExprFail("python.frontend.only_local_or_global_i32_names_are_closed")
        if !pyFindLocal(locals, name, value) && !pyFindGlobal(globals, name, value):
            return pyExprFail("python.frontend.only_local_or_global_i32_names_are_closed")
        var out: PyExprResult
        out.ok = true
        out.expr = name
        out.value = value
        return out
    if kind == "Call":
        var funcRaw: str
        var argsRaw: str
        var keywordsRaw: str
        if !pyTopRaw(raw, "func", funcRaw) || !pyTopRaw(raw, "args", argsRaw):
            return pyExprFail("python.frontend.only_closed_helper_calls_are_closed")
        if pyTopRaw(raw, "keywords", keywordsRaw) && pyRawArrayLength(keywordsRaw) != 0:
            return pyExprFail("python.frontend.helper_call_keywords_not_closed")
        var funcKind: str
        var name: str
        if !pyTopString(funcRaw, "kind", funcKind) || funcKind != "Name" || !pyTopString(funcRaw, "id", name):
            return pyExprFail("python.frontend.only_closed_helper_calls_are_closed")
        if pyFindFunction(functions, name) < 0:
            return pyExprFail("python.frontend.only_closed_helper_calls_are_closed")
        let argNodes = pyArrayObjects(argsRaw)
        var args: int32[]
        var argExprs: str[]
        for i in 0..<argNodes.len:
            let arg = pyExpr(argNodes[i], locals, globals, functions, stack)
            if !arg.ok:
                return pyExprFail(arg.error)
            add(args, arg.value)
            add(argExprs, arg.expr)
        let called = pyEvalFunction(name, args, globals, functions, stack)
        if !called.ok:
            return pyExprFail(called.error)
        var callText: str = name
        pyAppend(callText, "(")
        for i in 0..<argExprs.len:
            if i > 0:
                pyAppend(callText, ", ")
            pyAppend(callText, argExprs[i])
        pyAppend(callText, ")")
        var out: PyExprResult
        out.ok = true
        out.expr = callText
        out.value = called.returnValue
        return out
    if kind == "BinOp":
        var op: str
        var leftRaw: str
        var rightRaw: str
        if !pyTopString(raw, "op", op) || !pyTopRaw(raw, "left", leftRaw) || !pyTopRaw(raw, "right", rightRaw):
            return pyExprFail("python.frontend.expression_not_closed")
        var opText: str
        if !pyBinOpText(op, opText):
            return pyExprFail("python.frontend.only_add_sub_mul_i32_are_closed")
        let left = pyExpr(leftRaw, locals, globals, functions, stack)
        if !left.ok:
            return pyExprFail(left.error)
        let right = pyExpr(rightRaw, locals, globals, functions, stack)
        if !right.ok:
            return pyExprFail(right.error)
        var value: int32
        if !pyInt32Op(left.value, opText, right.value, value):
            return pyExprFail("python.frontend.int32_overflow_not_closed")
        var out: PyExprResult
        out.ok = true
        out.value = value
        pyAppend(out.expr, "(")
        pyAppend(out.expr, left.expr)
        pyAppend(out.expr, " ")
        pyAppend(out.expr, opText)
        pyAppend(out.expr, " ")
        pyAppend(out.expr, right.expr)
        pyAppend(out.expr, ")")
        return out
    if kind == "UnaryOp":
        var op: str
        var operandRaw: str
        if !pyTopString(raw, "op", op) || op != "USub" || !pyTopRaw(raw, "operand", operandRaw):
            return pyExprFail("python.frontend.expression_not_closed")
        let inner = pyExpr(operandRaw, locals, globals, functions, stack)
        if !inner.ok:
            return pyExprFail(inner.error)
        var value: int32
        if !pyInt32Op(0, "-", inner.value, value):
            return pyExprFail("python.frontend.int32_overflow_not_closed")
        var out: PyExprResult
        out.ok = true
        out.value = value
        pyAppend(out.expr, "(0 - ")
        pyAppend(out.expr, inner.expr)
        pyAppend(out.expr, ")")
        return out
    return pyExprFail("python.frontend.expression_not_closed")

fn pyAssignmentStmt(raw: str,
                    locals: var PyLocal[],
                    globals: var PyGlobal[],
                    globalNames: var str[],
                    functions: var PyFunction[],
                    stack: var str[]): PyDeclResult =
    var kind: str
    if !pyTopString(raw, "kind", kind) || kind != "Assign":
        return pyDeclFail("python.frontend.only_single_name_assignment_is_closed")
    var targetsRaw: str
    var valueRaw: str
    if !pyTopRaw(raw, "targets", targetsRaw) || !pyTopRaw(raw, "value", valueRaw):
        return pyDeclFail("python.frontend.only_single_name_assignment_is_closed")
    let targets = pyArrayObjects(targetsRaw)
    if targets.len != 1:
        return pyDeclFail("python.frontend.only_single_name_assignment_is_closed")
    var targetKind: str
    var name: str
    if !pyTopString(targets[0], "kind", targetKind) || targetKind != "Name" || !pyTopString(targets[0], "id", name):
        return pyDeclFail("python.frontend.only_single_name_assignment_is_closed")
    if !pyValidIdentifier(name):
        return pyDeclFail("python.frontend.local_name_not_closed")
    let expr = pyExpr(valueRaw, locals, globals, functions, stack)
    if !expr.ok:
        return pyDeclFail(expr.error)
    if pyNameListContains(globalNames, name):
        if !pySetGlobalValue(globals, name, expr.value):
            return pyDeclFail("python.frontend.global_decl_not_closed")
        var stmt: PyClosedStatement
        stmt.kind = "store_global_i32"
        stmt.name = name
        stmt.expr = expr.expr
        stmt.value = expr.value
        var out: PyDeclResult
        out.ok = true
        out.statement = stmt
        return out
    if pyGlobalNameExists(globals, name):
        return pyDeclFail("python.frontend.local_global_shadow_not_closed")
    if !pySetLocal(locals, name, expr.value):
        return pyDeclFail("python.frontend.local_name_not_closed")
    var stmt: PyClosedStatement
    stmt.kind = "local_i32"
    stmt.name = name
    stmt.expr = expr.expr
    stmt.value = expr.value
    var out: PyDeclResult
    out.ok = true
    out.statement = stmt
    return out

fn pyAugAssignmentStmt(raw: str,
                       locals: var PyLocal[],
                       globals: var PyGlobal[],
                       globalNames: var str[],
                       functions: var PyFunction[],
                       stack: var str[]): PyDeclResult =
    var kind: str
    if !pyTopString(raw, "kind", kind) || kind != "AugAssign":
        return pyDeclFail("python.frontend.only_global_i32_augassign_is_closed")
    var targetRaw: str
    var op: str
    var valueRaw: str
    if !pyTopRaw(raw, "target", targetRaw) || !pyTopString(raw, "op", op) || !pyTopRaw(raw, "value", valueRaw):
        return pyDeclFail("python.frontend.only_global_i32_augassign_is_closed")
    var targetKind: str
    var name: str
    if !pyTopString(targetRaw, "kind", targetKind) || targetKind != "Name" || !pyTopString(targetRaw, "id", name):
        return pyDeclFail("python.frontend.only_global_i32_augassign_is_closed")
    if !pyValidIdentifier(name):
        return pyDeclFail("python.frontend.local_name_not_closed")
    if !pyNameListContains(globalNames, name):
        if pyGlobalNameExists(globals, name):
            return pyDeclFail("python.frontend.local_global_shadow_not_closed")
        return pyDeclFail("python.frontend.only_global_i32_augassign_is_closed")
    var oldValue: int32
    if !pyFindGlobal(globals, name, oldValue):
        return pyDeclFail("python.frontend.global_decl_not_closed")
    var localValue: int32
    if pyFindLocal(locals, name, localValue):
        return pyDeclFail("python.frontend.local_global_shadow_not_closed")
    var opText: str
    if !pyBinOpText(op, opText):
        return pyDeclFail("python.frontend.only_add_sub_mul_i32_are_closed")
    if pyExprContainsCall(valueRaw):
        return pyDeclFail("python.frontend.augassign_rhs_call_not_closed")
    let rhs = pyExpr(valueRaw, locals, globals, functions, stack)
    if !rhs.ok:
        return pyDeclFail(rhs.error)
    var newValue: int32
    if !pyInt32Op(oldValue, opText, rhs.value, newValue):
        return pyDeclFail("python.frontend.int32_overflow_not_closed")
    if !pySetGlobalValue(globals, name, newValue):
        return pyDeclFail("python.frontend.global_decl_not_closed")
    var stmt: PyClosedStatement
    stmt.kind = "store_global_i32"
    stmt.name = name
    pyAppend(stmt.expr, "(")
    pyAppend(stmt.expr, name)
    pyAppend(stmt.expr, " ")
    pyAppend(stmt.expr, opText)
    pyAppend(stmt.expr, " ")
    pyAppend(stmt.expr, rhs.expr)
    pyAppend(stmt.expr, ")")
    stmt.value = newValue
    var out: PyDeclResult
    out.ok = true
    out.statement = stmt
    return out

fn pyPrintLine(raw: str, out: var str): bool =
    var kind: str
    if !pyTopString(raw, "kind", kind) || kind != "Expr":
        return false
    var valueRaw: str
    if !pyTopRaw(raw, "value", valueRaw):
        return false
    var valueKind: str
    if !pyTopString(valueRaw, "kind", valueKind) || valueKind != "Call":
        return false
    var funcRaw: str
    var argsRaw: str
    var keywordsRaw: str
    if !pyTopRaw(valueRaw, "func", funcRaw) || !pyTopRaw(valueRaw, "args", argsRaw):
        return false
    if pyTopRaw(valueRaw, "keywords", keywordsRaw) && pyRawArrayLength(keywordsRaw) != 0:
        return false
    var funcKind: str
    var funcName: str
    if !pyTopString(funcRaw, "kind", funcKind) || funcKind != "Name" || !pyTopString(funcRaw, "id", funcName) || funcName != "print":
        return false
    let args = pyArrayObjects(argsRaw)
    if args.len != 1:
        return false
    var argKind: str
    var valueKindText: str
    var text: str
    if !pyTopString(args[0], "kind", argKind) || argKind != "Constant":
        return false
    if !pyTopString(args[0], "valueKind", valueKindText) || valueKindText != "str":
        return false
    if !pyTopString(args[0], "stringValue", text):
        return false
    out = text
    return true

fn pySystemExitExpr(raw: str,
                    locals: var PyLocal[],
                    globals: var PyGlobal[],
                    functions: var PyFunction[],
                    outExpr: var str,
                    outValue: var int32): bool =
    var kind: str
    if !pyTopString(raw, "kind", kind) || kind != "Raise":
        return false
    var excRaw: str
    if !pyTopRaw(raw, "exc", excRaw):
        return false
    var excKind: str
    if !pyTopString(excRaw, "kind", excKind) || excKind != "Call":
        return false
    var funcRaw: str
    var argsRaw: str
    var keywordsRaw: str
    if !pyTopRaw(excRaw, "func", funcRaw) || !pyTopRaw(excRaw, "args", argsRaw):
        return false
    if pyTopRaw(excRaw, "keywords", keywordsRaw) && pyRawArrayLength(keywordsRaw) != 0:
        return false
    var funcKind: str
    var funcName: str
    if !pyTopString(funcRaw, "kind", funcKind) || funcKind != "Name" || !pyTopString(funcRaw, "id", funcName) || funcName != "SystemExit":
        return false
    let args = pyArrayObjects(argsRaw)
    if args.len != 1:
        return false
    var stack: str[]
    let expr = pyExpr(args[0], locals, globals, functions, stack)
    if !expr.ok || expr.value < 0 || expr.value > 255:
        return false
    outExpr = expr.expr
    outValue = expr.value
    return true

fn pyCollectFunctionGlobalNames(body: var str[], globals: var PyGlobal[], names: var str[], error: var str): bool =
    names = []
    for i in 0..<body.len:
        var kind: str
        if !pyTopString(body[i], "kind", kind):
            error = "python.frontend.global_decl_not_closed"
            return false
        if kind != "Global":
            continue
        var namesRaw: str
        if !pyTopRaw(body[i], "names", namesRaw):
            error = "python.frontend.global_decl_not_closed"
            return false
        let declared = pyArrayStrings(namesRaw)
        if declared.len == 0 || pyRawArrayLength(namesRaw) != declared.len:
            error = "python.frontend.global_decl_not_closed"
            return false
        for j in 0..<declared.len:
            if !pyValidIdentifier(declared[j]) || !pyGlobalNameExists(globals, declared[j]):
                error = "python.frontend.global_decl_not_closed"
                return false
            if !pyNameListContains(names, declared[j]):
                add(names, declared[j])
    return true

fn pyEvalFunction(name: str,
                  argValues: var int32[],
                  globals: var PyGlobal[],
                  functions: var PyFunction[],
                  stack: var str[]): PyClosedFunction =
    if pyStackContains(stack, name):
        return pyFunctionFail("python.frontend.recursive_function_graph_not_closed")
    let fnIndex = pyFindFunction(functions, name)
    if fnIndex < 0:
        return pyFunctionFail("python.frontend.function_not_found")
    let fnInfo = functions[fnIndex]
    if fnInfo.args.len != argValues.len:
        return pyFunctionFail("python.frontend.function_call_arity_not_closed")
    var locals: PyLocal[]
    for i in 0..<fnInfo.args.len:
        if pyGlobalNameExists(globals, fnInfo.args[i]):
            return pyFunctionFail("python.frontend.param_global_shadow_not_closed")
        if !pySetLocal(locals, fnInfo.args[i], argValues[i]):
            return pyFunctionFail("python.frontend.helper_param_not_closed")
    if fnInfo.body.len == 0:
        return pyFunctionFail("python.frontend.helper_must_return_i32_expression")
    var globalNames: str[]
    var globalError: str
    if !pyCollectFunctionGlobalNames(fnInfo.body, globals, globalNames, globalError):
        return pyFunctionFail(globalError)
    add(stack, name)
    var statements: PyClosedStatement[]
    for i in 0..<fnInfo.body.len - 1:
        var stmtKind: str
        pyTopString(fnInfo.body[i], "kind", stmtKind)
        if stmtKind == "Global":
            continue
        var decl: PyDeclResult
        if stmtKind == "AugAssign":
            decl = pyAugAssignmentStmt(fnInfo.body[i], locals, globals, globalNames, functions, stack)
        else:
            decl = pyAssignmentStmt(fnInfo.body[i], locals, globals, globalNames, functions, stack)
        if !decl.ok:
            setLen(stack, stack.len - 1)
            if decl.error != "python.frontend.only_single_name_assignment_is_closed":
                return pyFunctionFail(decl.error)
            return pyFunctionFail("python.frontend.helper_must_be_pure_int_return")
        add(statements, decl.statement)
    var returnKind: str
    if !pyTopString(fnInfo.body[fnInfo.body.len - 1], "kind", returnKind) || returnKind != "Return":
        setLen(stack, stack.len - 1)
        return pyFunctionFail("python.frontend.helper_must_return_i32_expression")
    var returnValueRaw: str
    if !pyTopRaw(fnInfo.body[fnInfo.body.len - 1], "value", returnValueRaw):
        setLen(stack, stack.len - 1)
        return pyFunctionFail("python.frontend.helper_must_return_i32_expression")
    let ret = pyExpr(returnValueRaw, locals, globals, functions, stack)
    if !ret.ok:
        setLen(stack, stack.len - 1)
        return pyFunctionFail(ret.error)
    setLen(stack, stack.len - 1)
    var out: PyClosedFunction
    out.ok = true
    out.moduleName = fnInfo.moduleName
    out.name = name
    out.parameters = fnInfo.args
    out.statements = statements
    out.returnExpr = ret.expr
    out.returnValue = ret.value
    return out

fn pyClosedFunctionLess(a: PyClosedFunction, b: PyClosedFunction): bool =
    if a.name == "main" && b.name != "main":
        return false
    if a.name != "main" && b.name == "main":
        return true
    return pyStringLess(a.name, b.name)

fn pySortClosedForFacts(functions: var PyClosedFunction[]) =
    for i in 1..<functions.len:
        var pos: int32 = i
        while pos > 0 && pyClosedFunctionLess(functions[pos], functions[pos - 1]):
            let tmp = functions[pos - 1]
            functions[pos - 1] = functions[pos]
            functions[pos] = tmp
            pos = pos - 1

fn pySortGlobalsByName(globals: var PyGlobal[]) =
    for i in 1..<globals.len:
        var pos: int32 = i
        while pos > 0 && pyStringLess(globals[pos].name, globals[pos - 1].name):
            let tmp = globals[pos - 1]
            globals[pos - 1] = globals[pos]
            globals[pos] = tmp
            pos = pos - 1

fn pySortFunctionsByName(functions: var PyFunction[]) =
    for i in 1..<functions.len:
        var pos: int32 = i
        while pos > 0 && pyStringLess(functions[pos].name, functions[pos - 1].name):
            let tmp = functions[pos - 1]
            functions[pos - 1] = functions[pos]
            functions[pos] = tmp
            pos = pos - 1

fn pyJsonStringArray(values: var str[]): str =
    var out: str = "["
    for i in 0..<values.len:
        if i > 0:
            pyAppend(out, ",")
        pyAppend(out, pyJsonQuote(values[i]))
    pyAppend(out, "]")
    return out

fn pyParamsJson(params: var str[]): str =
    var out: str = "["
    for i in 0..<params.len:
        if i > 0:
            pyAppend(out, ",")
        pyAppend(out, "{\"name\":")
        pyAppend(out, pyJsonQuote(params[i]))
        pyAppend(out, ",\"type\":\"i32\"}")
    pyAppend(out, "]")
    return out

fn pyUnsupportedFact(code: str, message: str): str =
    var out: str = "{\"code\":"
    pyAppend(out, pyJsonQuote(code))
    pyAppend(out, ",\"id\":")
    pyAppend(out, pyJsonQuote(pyCat("unsupported:python:", pySafeId(code))))
    pyAppend(out, ",\"kind\":\"csg.unsupported\",\"message\":")
    pyAppend(out, pyJsonQuote(message))
    pyAppend(out, "}")
    return out

fn pyAppendGlobalFacts(facts: var str[], globals: var PyGlobal[]) =
    pySortGlobalsByName(globals)
    for i in 0..<globals.len:
        let name = globals[i].name
        add(facts, pyCat(pyCat("{\"id\":", pyJsonQuote(pyCat("symbol:", name))), pyCat(pyCat(",\"kind\":\"csg.symbol\",\"name\":", pyJsonQuote(name)), ",\"symbolKind\":\"global\"}")))
        var line: str = "{\"id\":"
        pyAppend(line, pyJsonQuote(pyCat("global:", name)))
        pyAppend(line, ",\"kind\":\"csg_dialect::native::global_i32\",\"name\":")
        pyAppend(line, pyJsonQuote(name))
        pyAppend(line, ",\"initialValue\":")
        pyAppend(line, strings.IntToStr(globals[i].initialValue))
        pyAppend(line, ",\"storage\":\"module\"}")
        add(facts, line)

fn pyAppendClosedFunctionFacts(facts: var str[], closedFunctions: var PyClosedFunction[]) =
    pySortClosedForFacts(closedFunctions)
    for i in 0..<closedFunctions.len:
        let item = closedFunctions[i]
        let name = item.name
        let functionId = pyCat("function:", name)
        add(facts, pyCat(pyCat("{\"id\":", pyJsonQuote(pyCat("symbol:", name))), pyCat(pyCat(",\"kind\":\"csg.symbol\",\"name\":", pyJsonQuote(name)), ",\"symbolKind\":\"function\"}")))
        var fnLine: str = "{\"id\":"
        pyAppend(fnLine, pyJsonQuote(functionId))
        pyAppend(fnLine, ",\"kind\":\"csg.function\",\"name\":")
        pyAppend(fnLine, pyJsonQuote(name))
        pyAppend(fnLine, ",\"parameters\":")
        pyAppend(fnLine, pyParamsJson(item.parameters))
        pyAppend(fnLine, ",\"returnType\":\"i32\",\"symbol\":")
        pyAppend(fnLine, pyJsonQuote(pyCat("symbol:", name)))
        pyAppend(fnLine, "}")
        add(facts, fnLine)
        var blockLine: str = "{\"blockKind\":\"entry\",\"function\":"
        pyAppend(blockLine, pyJsonQuote(functionId))
        pyAppend(blockLine, ",\"id\":")
        pyAppend(blockLine, pyJsonQuote(pyCat(pyCat("block:", name), ":entry")))
        pyAppend(blockLine, ",\"kind\":\"csg.block\"}")
        add(facts, blockLine)
        for paramIndex in 0..<item.parameters.len:
            var paramLine: str = "{\"function\":"
            pyAppend(paramLine, pyJsonQuote(functionId))
            pyAppend(paramLine, ",\"id\":")
            pyAppend(paramLine, pyJsonQuote(pyCat(pyCat(pyCat(pyCat("param:", name), ":"), strings.IntToStr(paramIndex)), pyCat(":", item.parameters[paramIndex]))))
            pyAppend(paramLine, ",\"kind\":\"csg_dialect::native::param_i32\",\"name\":")
            pyAppend(paramLine, pyJsonQuote(item.parameters[paramIndex]))
            pyAppend(paramLine, ",\"order\":")
            pyAppend(paramLine, strings.IntToStr(paramIndex))
            pyAppend(paramLine, "}")
            add(facts, paramLine)
        for stmtIndex in 0..<item.statements.len:
            let stmt = item.statements[stmtIndex]
            if stmt.kind == "stdout_line":
                var line: str = "{\"function\":"
                pyAppend(line, pyJsonQuote(functionId))
                pyAppend(line, ",\"id\":")
                pyAppend(line, pyJsonQuote(pyCat(pyCat(pyCat("stmt:", name), pyCat(":", strings.IntToStr(stmtIndex))), ":stdout")))
                pyAppend(line, ",\"kind\":\"csg_dialect::native::stdout_line\",\"order\":")
                pyAppend(line, strings.IntToStr(stmtIndex))
                pyAppend(line, ",\"text\":")
                pyAppend(line, pyJsonQuote(stmt.text))
                pyAppend(line, "}")
                add(facts, line)
            elif stmt.kind == "local_i32":
                var line: str = "{\"expr\":"
                pyAppend(line, pyJsonQuote(stmt.expr))
                pyAppend(line, ",\"function\":")
                pyAppend(line, pyJsonQuote(functionId))
                pyAppend(line, ",\"id\":")
                pyAppend(line, pyJsonQuote(pyCat(pyCat(pyCat(pyCat("stmt:", name), pyCat(":", strings.IntToStr(stmtIndex))), ":local:"), stmt.name)))
                pyAppend(line, ",\"kind\":\"csg_dialect::native::local_i32\",\"name\":")
                pyAppend(line, pyJsonQuote(stmt.name))
                pyAppend(line, ",\"order\":")
                pyAppend(line, strings.IntToStr(stmtIndex))
                pyAppend(line, ",\"value\":")
                pyAppend(line, strings.IntToStr(stmt.value))
                pyAppend(line, "}")
                add(facts, line)
            elif stmt.kind == "store_global_i32":
                var line: str = "{\"expr\":"
                pyAppend(line, pyJsonQuote(stmt.expr))
                pyAppend(line, ",\"function\":")
                pyAppend(line, pyJsonQuote(functionId))
                pyAppend(line, ",\"id\":")
                pyAppend(line, pyJsonQuote(pyCat(pyCat(pyCat(pyCat("stmt:", name), pyCat(":", strings.IntToStr(stmtIndex))), ":store_global:"), stmt.name)))
                pyAppend(line, ",\"kind\":\"csg_dialect::native::store_global_i32\",\"name\":")
                pyAppend(line, pyJsonQuote(stmt.name))
                pyAppend(line, ",\"order\":")
                pyAppend(line, strings.IntToStr(stmtIndex))
                pyAppend(line, ",\"value\":")
                pyAppend(line, strings.IntToStr(stmt.value))
                pyAppend(line, "}")
                add(facts, line)
        var termLine: str = "{\"block\":"
        pyAppend(termLine, pyJsonQuote(pyCat(pyCat("block:", name), ":entry")))
        pyAppend(termLine, ",\"function\":")
        pyAppend(termLine, pyJsonQuote(functionId))
        pyAppend(termLine, ",\"id\":")
        pyAppend(termLine, pyJsonQuote(pyCat(pyCat("term:", name), ":return")))
        pyAppend(termLine, ",\"kind\":\"csg.term\",\"termKind\":\"return\",\"value\":")
        pyAppend(termLine, strings.IntToStr(item.returnValue))
        pyAppend(termLine, ",\"valueExpr\":")
        pyAppend(termLine, pyJsonQuote(item.returnExpr))
        pyAppend(termLine, "}")
        add(facts, termLine)

fn pyCanonicalJsonIntText(value: int32): str =
    # JSON canonical integer form for raw numeric fact fields, produced by
    # the authoritative canonicalizer itself (1000 -> 1e3 because the
    # scientific form is strictly shorter; plain stays byte-identical).
    # python::module.symbolCount is an int-checked validator field and
    # replay admission proves per-line canonicality, so the emitted text
    # must already be canonical.
    let roundTrip = canonical.CsgCoreJsonCanonicalize(
        strings.IntToStr(value))
    if !roundTrip.ok:
        panic(strings.CloneStr(roundTrip.error))
    return strings.CloneStr(roundTrip.value)

fn pyAppendPythonModuleFacts(facts: var str[], moduleName: str, displayPath: str, sourceText: str, bytecodeRaw: str, symbolCount: int32, pythonVersion: str) =
    let moduleId = pyCat("module:python:", pySafeId(moduleName))
    var moduleLine: str = "{\"id\":"
    pyAppend(moduleLine, pyJsonQuote(moduleId))
    pyAppend(moduleLine, ",\"kind\":\"csg.module\",\"path\":")
    pyAppend(moduleLine, pyJsonQuote(displayPath))
    pyAppend(moduleLine, ",\"sha256\":")
    pyAppend(moduleLine, pyJsonQuote(pyCat("sha256:", strings.Sha256(sourceText))))
    pyAppend(moduleLine, "}")
    add(facts, moduleLine)
    var pyModuleLine: str = "{\"bytecode\":"
    pyAppend(pyModuleLine, bytecodeRaw)
    pyAppend(pyModuleLine, ",\"entry\":")
    pyAppend(pyModuleLine, pyJsonQuote(moduleName))
    pyAppend(pyModuleLine, ",\"id\":")
    pyAppend(pyModuleLine, pyJsonQuote(pyCat("python-dialect:module:", pySafeId(moduleName))))
    pyAppend(pyModuleLine, ",\"kind\":\"csg_dialect::python::module\",\"module\":")
    pyAppend(pyModuleLine, pyJsonQuote(moduleId))
    pyAppend(pyModuleLine, ",\"pythonVersion\":")
    pyAppend(pyModuleLine, pyJsonQuote(pythonVersion))
    pyAppend(pyModuleLine, ",\"symbolCount\":")
    pyAppend(pyModuleLine, pyCanonicalJsonIntText(symbolCount))
    pyAppend(pyModuleLine, "}")
    add(facts, pyModuleLine)

fn pyImportFromSupported(raw: str, functions: var PyFunction[]): bool =
    var kind: str
    if !pyTopString(raw, "kind", kind) || kind != "ImportFrom":
        return false
    var level: int32
    if !pyTopInt32(raw, "level", level) || level != 0:
        return false
    var moduleName: str
    if !pyTopString(raw, "module", moduleName) || moduleName.len == 0:
        return false
    var namesRaw: str
    if !pyTopRaw(raw, "names", namesRaw):
        return false
    let names = pyArrayStrings(namesRaw)
    if names.len == 0 || pyRawArrayLength(namesRaw) != names.len:
        return false
    for i in 0..<names.len:
        if pyFindFunction(functions, names[i]) < 0:
            return false
    return true

fn pyModuleBodyImportOnly(moduleBody: str[], functions: var PyFunction[]): bool =
    for i in 0..<moduleBody.len:
        var kind: str
        if !pyTopString(moduleBody[i], "kind", kind) || kind != "ImportFrom":
            return false
        if !pyImportFromSupported(moduleBody[i], functions):
            return false
    return true

fn pyModuleBodyLibrarySupported(moduleBody: str[], functions: var PyFunction[]): bool =
    for i in 0..<moduleBody.len:
        var kind: str
        if !pyTopString(moduleBody[i], "kind", kind):
            return false
        if kind == "ImportFrom":
            if !pyImportFromSupported(moduleBody[i], functions):
                return false
        elif kind != "Assign":
            return false
    return true

fn pyAllModuleBodiesLibrarySupported(modules: var PyModuleInfo[], functions: var PyFunction[]): bool =
    for i in 0..<modules.len:
        if !pyModuleBodyLibrarySupported(modules[i].body, functions):
            return false
    return true

fn pyHasNonEntryModuleBody(modules: var PyModuleInfo[], entryModule: str): bool =
    for i in 0..<modules.len:
        if modules[i].moduleName != entryModule && modules[i].body.len > 0:
            return true
    return false

fn pyNameListContains(names: var str[], name: str): bool =
    for i in 0..<names.len:
        if names[i] == name:
            return true
    return false

fn pyAddEntryRootName(names: var str[], name: str): bool =
    if !pyValidIdentifier(name):
        return false
    if pyNameListContains(names, name):
        return true
    add(names, name)
    var pos: int32 = names.len - 1
    while pos > 0 && pyStringLess(names[pos], names[pos - 1]):
        let tmp = names[pos - 1]
        names[pos - 1] = names[pos]
        names[pos] = tmp
        pos = pos - 1
    return true

fn pyBuildLibraryEntryRoots(entryModule: str,
                            moduleBody: str[],
                            functions: var PyFunction[],
                            roots: var str[],
                            error: var str): bool =
    roots = []
    for i in 0..<functions.len:
        if functions[i].moduleName == entryModule || functions[i].moduleName.len == 0:
            if !pyAddEntryRootName(roots, functions[i].name):
                error = "python.frontend.library_entry_root_not_closed"
                return false
    for i in 0..<moduleBody.len:
        var kind: str
        if !pyTopString(moduleBody[i], "kind", kind):
            error = "python.frontend.library_module_body_not_closed"
            return false
        if kind == "Assign":
            continue
        if kind != "ImportFrom" || !pyImportFromSupported(moduleBody[i], functions):
            error = "python.frontend.import_not_closed"
            return false
        var namesRaw: str
        if !pyTopRaw(moduleBody[i], "names", namesRaw):
            error = "python.frontend.import_not_closed"
            return false
        let names = pyArrayStrings(namesRaw)
        for j in 0..<names.len:
            if !pyAddEntryRootName(roots, names[j]):
                error = "python.frontend.library_entry_root_not_closed"
                return false
    if roots.len == 0:
        error = "python.frontend.library_requires_entry_function"
        return false
    return true

fn pyModuleGlobalAssignment(raw: str,
                            globals: var PyGlobal[],
                            functions: var PyFunction[],
                            error: var str): bool =
    var kind: str
    if !pyTopString(raw, "kind", kind) || kind != "Assign":
        error = "python.frontend.module_global_not_closed"
        return false
    var targetsRaw: str
    var valueRaw: str
    if !pyTopRaw(raw, "targets", targetsRaw) || !pyTopRaw(raw, "value", valueRaw):
        error = "python.frontend.module_global_not_closed"
        return false
    let targets = pyArrayObjects(targetsRaw)
    if targets.len != 1:
        error = "python.frontend.module_global_not_closed"
        return false
    var targetKind: str
    var name: str
    if !pyTopString(targets[0], "kind", targetKind) || targetKind != "Name" || !pyTopString(targets[0], "id", name):
        error = "python.frontend.module_global_not_closed"
        return false
    if !pyValidIdentifier(name) || pyFindFunction(functions, name) >= 0 || pyGlobalNameExists(globals, name):
        error = "python.frontend.module_global_name_not_closed"
        return false
    var locals: PyLocal[]
    var noFunctions: PyFunction[]
    var stack: str[]
    let expr = pyExpr(valueRaw, locals, globals, noFunctions, stack)
    if !expr.ok:
        error = expr.error
        return false
    var global: PyGlobal
    global.name = name
    global.initialValue = expr.value
    global.value = expr.value
    add(globals, global)
    return true

fn pyCollectLibraryGlobals(moduleBody: str[],
                           functions: var PyFunction[],
                           globals: var PyGlobal[],
                           error: var str): bool =
    for i in 0..<moduleBody.len:
        var kind: str
        if !pyTopString(moduleBody[i], "kind", kind):
            error = "python.frontend.library_module_body_not_closed"
            return false
        if kind == "Assign":
            if !pyModuleGlobalAssignment(moduleBody[i], globals, functions, error):
                return false
        elif kind == "ImportFrom":
            if !pyImportFromSupported(moduleBody[i], functions):
                error = "python.frontend.import_not_closed"
                return false
        else:
            error = "python.frontend.library_module_body_not_closed"
            return false
    return true

fn pyCollectAllLibraryGlobals(modules: var PyModuleInfo[],
                              functions: var PyFunction[],
                              globals: var PyGlobal[],
                              error: var str): bool =
    globals = []
    for i in 0..<modules.len:
        if !pyCollectLibraryGlobals(modules[i].body, functions, globals, error):
            return false
    return true

fn pyBuildFacts(oracle: str, sourceText: str, cfg: PyEmitConfig): PyBuildResult =
    var out: PyBuildResult
    add(out.facts, "{\"features\":[\"core-facts\",\"runtime-closure\",\"csg_dialect::python\"],\"id\":\"csg.core.schema:python\",\"kind\":\"csg.core.schema\",\"language\":\"python\",\"schema\":\"csg_core\"}")
    var semanticOk: bool = true
    var entryModule: str
    if !pyTopString(oracle, "entryModule", entryModule):
        entryModule = cfg.entry
    var modulesRaw: str
    var moduleInfos: PyModuleInfo[]
    if pyTopRaw(oracle, "modules", modulesRaw):
        let modules = pyArrayObjects(modulesRaw)
        out.moduleCount = modules.len
        if modules.len == 0:
            pyAddUnsupported(out.unsupportedCodes, "python.frontend.ast_oracle_not_closed")
            semanticOk = false
        for i in 0..<modules.len:
            var moduleName: str
            var moduleSource: str
            var moduleDisplayPath: str
            if !pyTopString(modules[i], "module", moduleName) || !pyTopString(modules[i], "source", moduleSource) || !pyTopString(modules[i], "displayPath", moduleDisplayPath):
                pyAddUnsupported(out.unsupportedCodes, "python.frontend.ast_oracle_not_closed")
                semanticOk = false
                break
            var moduleSourceText: str
            if moduleSource == cfg.source:
                moduleSourceText = sourceText
            else:
                var moduleRead: Result[str] = os.ReadFileResult(moduleSource)
                if result.IsErr(moduleRead):
                    pyAddUnsupported(out.unsupportedCodes, "python.frontend.ast_oracle_not_closed")
                    semanticOk = false
                    break
                moduleSourceText = result.Value(moduleRead)
            var moduleBytecodeRaw: str
            if !pyTopRaw(modules[i], "bytecode", moduleBytecodeRaw):
                moduleBytecodeRaw = "[]"
            var moduleSymbolCount: int32
            pyTopInt32(modules[i], "symbolCount", moduleSymbolCount)
            pyAppendPythonModuleFacts(out.facts, moduleName, moduleDisplayPath, moduleSourceText, moduleBytecodeRaw, moduleSymbolCount, cfg.pythonVersion)
            var moduleBodyForInfoRaw: str
            var info: PyModuleInfo
            info.moduleName = moduleName
            if pyTopRaw(modules[i], "moduleBody", moduleBodyForInfoRaw):
                info.body = pyArrayObjects(moduleBodyForInfoRaw)
            add(moduleInfos, info)
    else:
        out.moduleCount = 1
        var bytecodeRaw: str
        if !pyTopRaw(oracle, "bytecode", bytecodeRaw):
            bytecodeRaw = "[]"
        var symbolCount: int32
        pyTopInt32(oracle, "symbolCount", symbolCount)
        pyAppendPythonModuleFacts(out.facts, cfg.entry, cfg.displayPath, sourceText, bytecodeRaw, symbolCount, cfg.pythonVersion)

    var binaryRaw: str
    if pyTopRaw(oracle, "binaryExtensions", binaryRaw):
        let binary = pyArrayStrings(binaryRaw)
        for i in 0..<binary.len:
            let code = "python.frontend.binary_extension_not_translatable"
            pyAddUnsupported(out.unsupportedCodes, code)
    var extraRaw: str
    if pyTopRaw(oracle, "extraPythonModules", extraRaw):
        let extra = pyArrayStrings(extraRaw)
        extra

    var functionsRaw: str
    var moduleBodyRaw: str
    if !pyTopRaw(oracle, "functions", functionsRaw) || !pyTopRaw(oracle, "moduleBody", moduleBodyRaw):
        pyAddUnsupported(out.unsupportedCodes, "python.frontend.ast_oracle_not_closed")
        semanticOk = false
    let fnNodes = pyArrayObjects(functionsRaw)
    var functions: PyFunction[]
    for i in 0..<fnNodes.len:
        var fnInfo: PyFunction
        var fnError: str
        if !pyFunctionFromRaw(fnNodes[i], fnInfo, fnError):
            pyAddUnsupported(out.unsupportedCodes, fnError)
            semanticOk = false
        elif pyFindFunction(functions, fnInfo.name) >= 0:
            pyAddUnsupported(out.unsupportedCodes, "python.frontend.helper_name_not_closed")
            semanticOk = false
        else:
            add(functions, fnInfo)

    let moduleBody = pyArrayObjects(moduleBodyRaw)
    if moduleInfos.len == 0:
        var entryInfo: PyModuleInfo
        entryInfo.moduleName = entryModule
        entryInfo.body = moduleBody
        add(moduleInfos, entryInfo)
    var libraryMode: bool
    var globals: PyGlobal[]
    if semanticOk:
        if moduleBody.len == 0:
            if functions.len == 0:
                pyAddUnsupported(out.unsupportedCodes, "python.frontend.empty_module_not_closed")
                semanticOk = false
            else:
                libraryMode = true
        elif pyModuleBodyLibrarySupported(moduleBody, functions) && pyAllModuleBodiesLibrarySupported(moduleInfos, functions):
            libraryMode = true
        elif moduleBody.len > 0:
            var lastKind: str
            if !pyTopString(moduleBody[moduleBody.len - 1], "kind", lastKind) || lastKind != "Raise":
                pyAddUnsupported(out.unsupportedCodes, "python.frontend.closed_module_must_end_with_system_exit")
                semanticOk = false
    if semanticOk && !libraryMode && pyHasNonEntryModuleBody(moduleInfos, entryModule):
        pyAddUnsupported(out.unsupportedCodes, "python.frontend.multi_module_project_not_closed")
        semanticOk = false
    if semanticOk && libraryMode:
        var globalsError: str
        if !pyCollectAllLibraryGlobals(moduleInfos, functions, globals, globalsError):
            pyAddUnsupported(out.unsupportedCodes, globalsError)
            semanticOk = false
    if semanticOk && libraryMode:
        var rootError: str
        if !pyBuildLibraryEntryRoots(entryModule, moduleBody, functions, out.entryRootFunctions, rootError):
            pyAddUnsupported(out.unsupportedCodes, rootError)
            semanticOk = false
    if semanticOk:
        var sortedFunctions = functions
        pySortFunctionsByName(sortedFunctions)
        for i in 0..<sortedFunctions.len:
            var args: int32[]
            for _ in 0..<sortedFunctions[i].args.len:
                add(args, 0)
            var stack: str[]
            var evalGlobals = pyCloneGlobals(globals)
            let closed = pyEvalFunction(sortedFunctions[i].name, args, evalGlobals, functions, stack)
            if !closed.ok:
                pyAddUnsupported(out.unsupportedCodes, closed.error)
                semanticOk = false
                break
            add(out.closedFunctions, closed)
    if semanticOk && !libraryMode:
        var locals: PyLocal[]
        var emptyGlobals: PyGlobal[]
        var emptyGlobalNames: str[]
        var statements: PyClosedStatement[]
        for i in 0..<moduleBody.len - 1:
            var kind: str
            pyTopString(moduleBody[i], "kind", kind)
            if kind == "Assign":
                var stack: str[]
                let decl = pyAssignmentStmt(moduleBody[i], locals, emptyGlobals, emptyGlobalNames, functions, stack)
                if !decl.ok:
                    pyAddUnsupported(out.unsupportedCodes, decl.error)
                    semanticOk = false
                    break
                add(statements, decl.statement)
            elif kind == "ImportFrom":
                if !pyImportFromSupported(moduleBody[i], functions):
                    pyAddUnsupported(out.unsupportedCodes, "python.frontend.import_not_closed")
                    semanticOk = false
                    break
            else:
                var line: str
                if !pyPrintLine(moduleBody[i], line):
                    pyAddUnsupported(out.unsupportedCodes, "python.frontend.only_assignment_or_print_before_system_exit_is_closed")
                    semanticOk = false
                    break
                var stmt: PyClosedStatement
                stmt.kind = "stdout_line"
                stmt.text = line
                add(statements, stmt)
        if semanticOk:
            var exitExpr: str
            var exitValue: int32
            if !pySystemExitExpr(moduleBody[moduleBody.len - 1], locals, emptyGlobals, functions, exitExpr, exitValue):
                pyAddUnsupported(out.unsupportedCodes, "python.frontend.entry_must_raise_system_exit_i32_expression")
                semanticOk = false
            else:
                var mainFn: PyClosedFunction
                mainFn.ok = true
                mainFn.name = "main"
                mainFn.statements = statements
                mainFn.returnExpr = exitExpr
                mainFn.returnValue = exitValue
                add(out.closedFunctions, mainFn)
                out.closedReturnSet = true
                out.closedReturn = exitValue
                out.closedStatements = statements
    if out.unsupportedCodes.len == 0:
        out.globals = globals
        pyAppendGlobalFacts(out.facts, out.globals)
        pyAppendClosedFunctionFacts(out.facts, out.closedFunctions)
        out.complete = true
    else:
        for i in 0..<out.unsupportedCodes.len:
            add(out.facts, pyUnsupportedFact(out.unsupportedCodes[i], pyCat("Python semantic not closed: ", out.unsupportedCodes[i])))
    return out

fn pyFactsText(lines: var str[]): str =
    var out: str
    for i in 0..<lines.len:
        if lines[i].len > 0:
            pyAppend(out, lines[i])
            pyAppend(out, "\n")
    return out

fn pyRawArray(items: var str[]): str =
    var out: str = "["
    for i in 0..<items.len:
        if i > 0:
            pyAppend(out, ",")
        pyAppend(out, items[i])
    pyAppend(out, "]")
    return out

fn pyUnsupportedFactsArray(facts: var str[]): str =
    var unsupported: str[]
    for i in 0..<facts.len:
        var kind: str
        if pyTopString(facts[i], "kind", kind) && kind == "csg.unsupported":
            add(unsupported, strings.CloneStr(facts[i]))
    return pyRawArray(unsupported)

fn pyStatementsJson(statements: var PyClosedStatement[]): str =
    var out: str = "["
    for i in 0..<statements.len:
        if i > 0:
            pyAppend(out, ",")
        if statements[i].kind == "stdout_line":
            pyAppend(out, "{\"kind\":\"stdout_line\",\"text\":")
            pyAppend(out, pyJsonQuote(statements[i].text))
            pyAppend(out, "}")
        elif statements[i].kind == "local_i32":
            pyAppend(out, "{\"expr\":")
            pyAppend(out, pyJsonQuote(statements[i].expr))
            pyAppend(out, ",\"kind\":\"local_i32\",\"name\":")
            pyAppend(out, pyJsonQuote(statements[i].name))
            pyAppend(out, ",\"value\":")
            pyAppend(out, strings.IntToStr(statements[i].value))
            pyAppend(out, "}")
        else:
            pyAppend(out, "{\"expr\":")
            pyAppend(out, pyJsonQuote(statements[i].expr))
            pyAppend(out, ",\"kind\":\"store_global_i32\",\"name\":")
            pyAppend(out, pyJsonQuote(statements[i].name))
            pyAppend(out, ",\"value\":")
            pyAppend(out, strings.IntToStr(statements[i].value))
            pyAppend(out, "}")
    pyAppend(out, "]")
    return out

fn pyClosedFunctionsJson(functions: var PyClosedFunction[]): str =
    var out: str = "["
    for i in 0..<functions.len:
        if i > 0:
            pyAppend(out, ",")
        pyAppend(out, "{\"name\":")
        pyAppend(out, pyJsonQuote(functions[i].name))
        pyAppend(out, ",\"parameters\":")
        pyAppend(out, pyJsonStringArray(functions[i].parameters))
        pyAppend(out, ",\"returnExpr\":")
        pyAppend(out, pyJsonQuote(functions[i].returnExpr))
        pyAppend(out, ",\"returnValue\":")
        pyAppend(out, strings.IntToStr(functions[i].returnValue))
        pyAppend(out, ",\"statements\":")
        pyAppend(out, pyStatementsJson(functions[i].statements))
        pyAppend(out, "}")
    pyAppend(out, "]")
    return out

fn pyGlobalsJson(globals: var PyGlobal[]): str =
    var out: str = "["
    for i in 0..<globals.len:
        if i > 0:
            pyAppend(out, ",")
        pyAppend(out, "{\"name\":")
        pyAppend(out, pyJsonQuote(globals[i].name))
        pyAppend(out, ",\"initialValue\":")
        pyAppend(out, strings.IntToStr(globals[i].initialValue))
        pyAppend(out, "}")
    pyAppend(out, "]")
    return out

fn pyEntryRootsJson(build: var PyBuildResult): str =
    var out: str = "["
    if build.closedReturnSet:
        pyAppend(out, "\"function:main\"")
        pyAppend(out, "]")
        return out
    var emitted: int32
    for i in 0..<build.entryRootFunctions.len:
        if emitted > 0:
            pyAppend(out, ",")
        pyAppend(out, pyJsonQuote(pyCat("function:", build.entryRootFunctions[i])))
        emitted = emitted + 1
    pyAppend(out, "]")
    return out

fn pyClosedWorldKind(build: var PyBuildResult): str =
    if build.closedReturnSet:
        return "single-entry-script-executable"
    if build.moduleCount > 1:
        return "multi-module-library"
    return "single-entry-module-library"

fn pyReportJson(
        build: var PyBuildResult,
        reason: str,
        cfg: PyEmitConfig,
        admittedComplete: bool,
        admittedFactsRoot: str,
        admittedProfiles: var str[],
        admittedProfileSetCid: str): str =
    let isComplete =
        build.complete &&
        build.unsupportedCodes.len == 0 &&
        admittedComplete &&
        admittedFactsRoot.len > 0 &&
        admittedProfiles.len > 0 &&
        admittedProfileSetCid.len > 0
    var factsRoot: str
    if isComplete:
        factsRoot = strings.CloneStr(admittedFactsRoot)
    let unsupportedJson = pyUnsupportedFactsArray(build.facts)
    var tool: str = cfg.toolImplementation
    if tool.len == 0:
        tool = "pure-cheng-py-csg-cli"
    var out: str = "{"
    pyAppend(out, "\"schema\":\"csg-core.report\"")
    pyAppend(out, ",\"standard\":")
    pyAppend(out, pyJsonQuote(csg.CsgCoreStandardIdentity()))
    pyAppend(out, ",\"profiles\":")
    if isComplete:
        pyAppend(out, pyJsonStringArray(admittedProfiles))
    else:
        pyAppend(out, "[]")
    pyAppend(out, ",\"profile_set_cid\":")
    if isComplete:
        pyAppend(out, pyJsonQuote(admittedProfileSetCid))
    else:
        pyAppend(out, "\"\"")
    pyAppend(out, ",\"dialect\":\"csg_dialect::python\"")
    pyAppend(out, ",\"toolImplementation\":")
    pyAppend(out, pyJsonQuote(tool))
    pyAppend(out, ",\"reportControllerImplementation\":\"pure-cheng\"")
    pyAppend(out, ",\"extractorImplementation\":\"pure-cheng-cpython-oracle-json\"")
    pyAppend(out, ",\"extractorOracle\":\"cpython-ast-symtable-bytecode-json\"")
    pyAppend(out, ",\"pureChengToolchainComplete\":false")
    pyAppend(out, ",\"fullProjectTranspilationComplete\":false")
    if tool == "python-cpython-oracle-launcher":
        pyAppend(out, ",\"toolchainGaps\":[\"legacy py-csg launcher invokes CPython oracle through Python\",\"full Python project semantics are not complete\"]")
    else:
        pyAppend(out, ",\"toolchainGaps\":[\"Python extraction still depends on fixed CPython oracle\",\"full Python project semantics are not complete\"]")
    pyAppend(out, ",\"complete\":")
    pyAppend(out, pyJsonBool(isComplete))
    pyAppend(out, ",\"facts_root\":")
    pyAppend(out, pyJsonQuote(factsRoot))
    pyAppend(out, ",\"counts\":{\"factCount\":")
    pyAppend(out, strings.IntToStr(build.facts.len))
    pyAppend(out, ",\"unsupported\":")
    pyAppend(out, strings.IntToStr(build.unsupportedCodes.len))
    pyAppend(out, ",\"globals\":")
    pyAppend(out, strings.IntToStr(build.globals.len))
    pyAppend(out, ",\"runtimeRequirements\":0,\"externalSymbols\":0}")
    pyAppend(out, ",\"unsupported\":")
    pyAppend(out, unsupportedJson)
    pyAppend(out, ",\"runtimeRequirements\":[]")
    pyAppend(out, ",\"externalSymbols\":[]")
    if isComplete:
        pyAppend(out, ",\"entryRoots\":")
        pyAppend(out, pyEntryRootsJson(build))
    else:
        pyAppend(out, ",\"entryRoots\":[]")
    pyAppend(out, ",\"closedWorldKind\":")
    pyAppend(out, pyJsonQuote(pyClosedWorldKind(build)))
    pyAppend(out, ",\"completionScope\":\"closed-subset-only\"")
    pyAppend(out, ",\"pythonVersion\":")
    pyAppend(out, pyJsonQuote(cfg.pythonVersion))
    if isComplete:
        if build.closedReturnSet:
            pyAppend(out, ",\"closedSubset\":\"python.function-graph-local-arith-print-system-exit.v1\"")
        elif build.globals.len > 0:
            pyAppend(out, ",\"closedSubset\":\"python.function-graph-module-global-i32-arith-return-library.v1\"")
        else:
            pyAppend(out, ",\"closedSubset\":\"python.function-graph-local-arith-return-library.v1\"")
    else:
        pyAppend(out, ",\"closedSubset\":\"\"")
    pyAppend(out, ",\"closedReturn\":")
    if build.closedReturnSet:
        pyAppend(out, strings.IntToStr(build.closedReturn))
    else:
        pyAppend(out, "null")
    pyAppend(out, ",\"closedStatements\":")
    pyAppend(out, pyStatementsJson(build.closedStatements))
    pyAppend(out, ",\"closedFunctions\":")
    pyAppend(out, pyClosedFunctionsJson(build.closedFunctions))
    pyAppend(out, ",\"closedGlobals\":")
    pyAppend(out, pyGlobalsJson(build.globals))
    pyAppend(out, ",\"unsupportedCodes\":")
    pyAppend(out, pyJsonStringArray(build.unsupportedCodes))
    if reason.len > 0:
        pyAppend(out, ",\"reason\":")
        pyAppend(out, pyJsonQuote(reason))
    pyAppend(out, "}\n")
    return out

fn pyEmptyFailureReport(reason: str): str =
    var build: PyBuildResult
    var cfg: PyEmitConfig
    var profiles: str[]
    return pyReportJson(
        build, reason, cfg, false, "", profiles, "")

fn pyWriteText(path: str, text: str) =
    let parent = os.ParentDir(path)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    os.WriteFile(path, text)

fn pyValidateConfig(cfg: PyEmitConfig): str =
    if cfg.oracleIn.len == 0 || cfg.source.len == 0 || cfg.displayPath.len == 0 || cfg.entry.len == 0:
        return "py-csg pure oracle emitter requires --oracle-json, --source, --display-path and --entry"
    if cfg.pythonVersion.len == 0 || cfg.outPath.len == 0 || cfg.reportOut.len == 0:
        return "py-csg pure oracle emitter requires --python-version, --out and --report-out"
    return ""

fn pyRun(cfg: PyEmitConfig): int32 =
    let configError = pyValidateConfig(cfg)
    if configError.len > 0:
        if cfg.reportOut.len > 0:
            pyWriteText(cfg.reportOut, pyEmptyFailureReport(configError))
        os.WriteLine(os.Get_stderr(), pyCat("error: ", configError))
        return 2
    var oracleRead: Result[str] = os.ReadFileResult(cfg.oracleIn)
    if result.IsErr(oracleRead):
        pyWriteText(cfg.reportOut, pyEmptyFailureReport("failed to read CPython oracle JSON"))
        os.WriteLine(os.Get_stderr(), "error: failed to read CPython oracle JSON")
        return 1
    var sourceRead: Result[str] = os.ReadFileResult(cfg.source)
    if result.IsErr(sourceRead):
        pyWriteText(cfg.reportOut, pyEmptyFailureReport("failed to read Python source"))
        os.WriteLine(os.Get_stderr(), "error: failed to read Python source")
        return 1
    let oracle = result.Value(oracleRead)
    let sourceText = result.Value(sourceRead)
    var build = pyBuildFacts(oracle, sourceText, cfg)
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            build.facts)
    var reason: str
    if !validation.valid || !validation.complete:
        build.complete = false
        reason = "generated Python facts failed csg_core validation"
    pyWriteText(cfg.outPath, pyFactsText(build.facts))
    pyWriteText(
        cfg.reportOut,
        pyReportJson(
            build,
            reason,
            cfg,
            validation.valid && validation.complete,
            validation.factsRoot,
            validation.profiles,
            validation.profileSetCid))
    if validation.valid && validation.complete:
        return 0
    return 1

fn pyUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: py_csg_ast_emit emit --oracle-json <oracle.json> --source <main.py> --display-path <path> --entry <module> --python-version <x.y> --out out.csgcore --report-out report.json")
    return 2

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return pyUsage()
    if cmdline.ParamStr(1) != "emit":
        return pyUsage()
    var cfg: PyEmitConfig
    cfg.oracleIn = pyOwn(cmdline.ReadFlagOrDefault("--oracle-json", ""))
    cfg.root = pyOwn(cmdline.ReadFlagOrDefault("--root", ""))
    cfg.entry = pyOwn(cmdline.ReadFlagOrDefault("--entry", ""))
    cfg.source = pyOwn(cmdline.ReadFlagOrDefault("--source", ""))
    cfg.displayPath = pyOwn(cmdline.ReadFlagOrDefault("--display-path", ""))
    cfg.pythonVersion = pyOwn(cmdline.ReadFlagOrDefault("--python-version", ""))
    cfg.outPath = pyOwn(cmdline.ReadFlagOrDefault("--out", ""))
    cfg.reportOut = pyOwn(cmdline.ReadFlagOrDefault("--report-out", ""))
    cfg.toolImplementation = pyOwn(cmdline.ReadFlagOrDefault("--tool-implementation", ""))
    return pyRun(cfg)
