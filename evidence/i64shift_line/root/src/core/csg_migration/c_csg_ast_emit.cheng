import std/cmdline
import std/os
import std/result
import std/strings
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/validator as csg

const
    CInt32Max: int64 = int64(2147483647)
    CInt32MinAbs: int64 = int64(2147483648)

type
    CEmitConfig =
        astJsonIn: str
        oracleJsonIn: str
        source: str
        displayPath: str
        target: str
        outPath: str
        reportOut: str
        structuralUnsupported: str
        toolImplementation: str

    CLocal =
        name: str
        value: int32

    CGlobal =
        name: str
        initialValue: int32
        value: int32

    CClosedStatement =
        kind: str
        name: str
        expr: str
        text: str
        value: int32

    CFunction =
        name: str
        qualType: str
        storageClass: str
        raw: str
        params: str[]
        body: str[]

    CExprResult =
        ok: bool
        error: str
        expr: str
        value: int32

    CDeclResult =
        ok: bool
        error: str
        statement: CClosedStatement

    CClosedFunction =
        ok: bool
        error: str
        name: str
        exported: bool
        parameters: str[]
        statements: CClosedStatement[]
        returnExpr: str
        returnValue: int32

    CBuildResult =
        facts: str[]
        complete: bool
        unsupportedCodes: str[]
        closedWorldKind: str
        closedReturnSet: bool
        closedReturn: int32
        closedStatements: CClosedStatement[]
        closedFunctions: CClosedFunction[]
        globals: CGlobal[]

@borrows
fn cAstCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn cAstAppend(out: var str, piece: str) =
    out = cAstCat(out, piece)

fn cAstOwn(raw: str): str =
    return strings.ConcatStr("", raw)

fn cAstJsonBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn cAstJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            cAstAppend(out, "\\\\")
        elif ch == '"':
            cAstAppend(out, "\\\"")
        elif ch == '\n':
            cAstAppend(out, "\\n")
        elif ch == '\r':
            cAstAppend(out, "\\r")
        elif ch == '\t':
            cAstAppend(out, "\\t")
        else:
            cAstAppend(out, strings.CharToStr(ch))
    cAstAppend(out, "\"")
    return out

fn cAstIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn cAstSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && cAstIsWs(text[i]):
        i = i + 1
    return i

fn cAstTrimRaw(text: str): str =
    var start: int32 = cAstSkipWs(text, 0)
    if start >= text.len:
        return ""
    var finish: int32 = text.len
    while finish > start && cAstIsWs(text[finish - 1]):
        finish = finish - 1
    return strings.SliceBytes(text, start, finish - start)

@borrows
fn cAstSkipJsonString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

@borrows
fn cAstSkipJsonValue(text: str, start: int32): int32 =
    var i: int32 = cAstSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = cAstSkipJsonString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = cAstSkipJsonString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn cAstStringLess(a: str, b: str): bool =
    let n: int32 = if a.len < b.len: a.len else: b.len
    for i in 0..<n:
        if a[i] < b[i]:
            return true
        if a[i] > b[i]:
            return false
    return a.len < b.len

fn cAstIsAlpha(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')

fn cAstIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn cAstDigitValueAt(text: str, index: int32): int32 =
    let digit = strings.SliceBytes(text, index, 1)
    if digit == "0":
        return 0
    if digit == "1":
        return 1
    if digit == "2":
        return 2
    if digit == "3":
        return 3
    if digit == "4":
        return 4
    if digit == "5":
        return 5
    if digit == "6":
        return 6
    if digit == "7":
        return 7
    if digit == "8":
        return 8
    if digit == "9":
        return 9
    return -1

fn cAstIsIdentStart(ch: char): bool =
    return cAstIsAlpha(ch) || ch == '_'

fn cAstIsIdentChar(ch: char): bool =
    return cAstIsIdentStart(ch) || cAstIsDigit(ch)

fn cAstValidIdentifier(name: str): bool =
    if name.len == 0:
        return false
    if !cAstIsIdentStart(name[0]):
        return false
    for i in 1..<name.len:
        if !cAstIsIdentChar(name[i]):
            return false
    return true

fn cAstSafeIdChar(ch: char): bool =
    return cAstIsAlpha(ch) || cAstIsDigit(ch) || ch == '_' || ch == '.' || ch == ':' || ch == '-'

fn cAstSafeId(text: str): str =
    var raw: str
    var inGap: bool
    for i in 0..<text.len:
        if cAstSafeIdChar(text[i]):
            cAstAppend(raw, strings.CharToStr(text[i]))
            inGap = false
        elif !inGap:
            cAstAppend(raw, "_")
            inGap = true
    var start: int32
    while start < raw.len && raw[start] == '_':
        start = start + 1
    var finish: int32 = raw.len
    while finish > start && raw[finish - 1] == '_':
        finish = finish - 1
    if finish <= start:
        return "root"
    return strings.SliceBytes(raw, start, finish - start)

fn cAstTmpAliasPath(path: str): str =
    if strings.HasPrefix(path, "/tmp/"):
        return cAstCat("/private", path)
    if strings.HasPrefix(path, "/private/tmp/"):
        return strings.SliceBytes(path, 8, path.len - 8)
    return ""

fn cAstSamePath(a: str, b: str): bool =
    if a == b:
        return true
    let aliasA = cAstTmpAliasPath(a)
    if aliasA.len > 0 && aliasA == b:
        return true
    let aliasB = cAstTmpAliasPath(b)
    return aliasB.len > 0 && aliasB == a

fn cAstTopString(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn cAstTopRaw(raw: str, name: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(raw, name)
    if !got.found:
        return false
    out = got.value
    return true

fn cAstParseInt32Raw(rawText: str, out: var int32): bool =
    let raw = cAstTrimRaw(rawText)
    if raw.len == 0:
        return false
    if raw == "0":
        out = 0
        return true
    if raw == "1":
        out = 1
        return true
    if raw == "2":
        out = 2
        return true
    if raw == "3":
        out = 3
        return true
    if raw == "4":
        out = 4
        return true
    if raw == "5":
        out = 5
        return true
    if raw == "6":
        out = 6
        return true
    if raw == "7":
        out = 7
        return true
    if raw == "8":
        out = 8
        return true
    if raw == "9":
        out = 9
        return true
    var i: int32
    var sign: int64 = int64(1)
    var limit: int64 = CInt32Max
    if raw[0] == '-':
        sign = int64(-1)
        limit = CInt32MinAbs
        i = 1
    elif raw[0] == '+':
        i = 1
    if i >= raw.len:
        return false
    var value: int64
    while i < raw.len:
        let digit = cAstDigitValueAt(raw, i)
        if digit < 0:
            return false
        value = value * int64(10) + int64(digit)
        if value > limit:
            return false
        i = i + 1
    let signed = value * sign
    if signed < int64(-2147483648) || signed > int64(2147483647):
        return false
    out = int32(signed)
    return true

fn cAstTopInt32(raw: str, name: str, out: var int32): bool =
    var rawValue: str
    if !cAstTopRaw(raw, name, rawValue):
        return false
    return cAstParseInt32Raw(rawValue, out)

fn cAstNodeKind(raw: str): str =
    var kind: str
    if cAstTopString(raw, "kind", kind):
        return kind
    return ""

fn cAstQualType(raw: str): str =
    var typeRaw: str
    if !cAstTopRaw(raw, "type", typeRaw):
        return ""
    var qualType: str
    if cAstTopString(typeRaw, "qualType", qualType):
        return qualType
    return ""

fn cAstArrayObjects(rawArray: str): str[] =
    var out: str[]
    let raw = cAstTrimRaw(rawArray)
    if raw.len < 2 || raw[0] != '[':
        return out
    var pos: int32 = 1
    while pos < raw.len:
        pos = cAstSkipWs(raw, pos)
        if pos >= raw.len || raw[pos] == ']':
            return out
        let endPos = cAstSkipJsonValue(raw, pos)
        if endPos <= pos || endPos > raw.len:
            return out
        if raw[pos] == '{':
            add(out, strings.SliceBytes(raw, pos, endPos - pos))
        pos = cAstSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
    return out

fn cAstChildren(raw: str): str[] =
    var innerRaw: str
    if !cAstTopRaw(raw, "inner", innerRaw):
        var empty: str[]
        return empty
    return cAstArrayObjects(innerRaw)

fn cAstObjectsWithKind(raw: str, expectedKind: str): str[] =
    var out: str[]
    var i: int32
    while i < raw.len:
        if raw[i] == '"':
            let endString = cAstSkipJsonString(raw, i)
            if endString < 0:
                return out
            i = endString
        elif raw[i] == '{':
            let endObject = cAstSkipJsonValue(raw, i)
            if endObject <= i || endObject > raw.len:
                return out
            let objectRaw = strings.SliceBytes(raw, i, endObject - i)
            if cAstNodeKind(objectRaw) == expectedKind:
                add(out, objectRaw)
            i = i + 1
        else:
            i = i + 1
    return out

fn cAstSingleChild(raw: str, out: var str): bool =
    let children = cAstChildren(raw)
    if children.len != 1:
        return false
    out = children[0]
    return true

fn cAstUnwrapImplicit(raw: str): str =
    var current: str = cAstOwn(raw)
    var keepGoing: bool = true
    while keepGoing && cAstNodeKind(current) == "ImplicitCastExpr":
        var child: str
        if cAstSingleChild(current, child):
            current = child
        else:
            keepGoing = false
    return current

fn cAstHasRawField(raw: str, name: str): bool =
    var unused: str
    return cAstTopRaw(raw, name, unused)

fn cAstNodeInSource(raw: str, sourcePath: str, sourceSize: int32): bool =
    var locRaw: str
    if !cAstTopRaw(raw, "loc", locRaw):
        return false
    var fileName: str
    if cAstTopString(locRaw, "file", fileName) && fileName.len > 0:
        return cAstSamePath(fileName, sourcePath)
    if cAstHasRawField(locRaw, "includedFrom"):
        return false
    var offset: int32
    if cAstTopInt32(locRaw, "offset", offset):
        sourceSize
        return offset >= 0
    if cAstHasRawField(locRaw, "offset"):
        sourceSize
        return true
    return false

fn cAstFunctionHasCompound(raw: str): bool =
    let children = cAstChildren(raw)
    for i in 0..<children.len:
        if cAstNodeKind(children[i]) == "CompoundStmt":
            return true
    return false

fn cAstFunctionBody(raw: str): str[] =
    let children = cAstChildren(raw)
    for i in 0..<children.len:
        if cAstNodeKind(children[i]) == "CompoundStmt":
            return cAstChildren(children[i])
    var empty: str[]
    return empty

fn cAstParamNames(raw: str, out: var str[], error: var str): bool =
    let children = cAstChildren(raw)
    for i in 0..<children.len:
        if cAstNodeKind(children[i]) != "ParmVarDecl":
            continue
        var name: str
        if !cAstTopString(children[i], "name", name) || !cAstValidIdentifier(name):
            error = "c.frontend.function_param_not_closed"
            return false
        for j in 0..<out.len:
            if out[j] == name:
                error = "c.frontend.function_param_not_closed"
                return false
        if cAstQualType(children[i]) != "int":
            error = "c.frontend.only_int_params_are_closed"
            return false
        add(out, name)
    return true

fn cAstMakeFunction(raw: str, out: var CFunction, error: var str): bool =
    var name: str
    if !cAstTopString(raw, "name", name):
        error = "c.frontend.function_name_not_closed"
        return false
    out.name = name
    out.qualType = cAstQualType(raw)
    out.raw = raw
    out.body = cAstFunctionBody(raw)
    var storage: str
    if cAstTopString(raw, "storageClass", storage):
        out.storageClass = storage
    if !cAstParamNames(raw, out.params, error):
        return false
    return true

fn cAstMakeGlobal(raw: str, out: var CGlobal, error: var str): bool =
    var name: str
    if !cAstTopString(raw, "name", name) || !cAstValidIdentifier(name):
        error = "c.frontend.global_name_not_closed"
        return false
    if cAstQualType(raw) != "int":
        error = "c.frontend.only_static_int_globals_are_closed"
        return false
    var storage: str
    if !cAstTopString(raw, "storageClass", storage) || storage != "static":
        error = "c.frontend.global_must_be_static_internal"
        return false
    var initial: int32
    let init = cAstChildren(raw)
    if init.len == 1:
        if !cAstIntegerLiteral(init[0], initial):
            error = "c.frontend.global_initializer_must_be_int32_constant"
            return false
    elif init.len != 0:
        error = "c.frontend.global_initializer_must_be_int32_constant"
        return false
    out.name = name
    out.initialValue = initial
    out.value = initial
    return true

fn cAstAddUnsupported(out: var str[], code: str) =
    if code.len == 0:
        return
    for i in 0..<out.len:
        if out[i] == code:
            return
    add(out, code)
    var pos: int32 = out.len - 1
    while pos > 0 && cAstStringLess(out[pos], out[pos - 1]):
        let tmp = out[pos - 1]
        out[pos - 1] = out[pos]
        out[pos] = tmp
        pos = pos - 1

fn cAstFindFunction(functions: var CFunction[], name: str): int32 =
    for i in 0..<functions.len:
        if functions[i].name == name:
            return i
    return -1

fn cAstStackContains(stack: var str[], name: str): bool =
    for i in 0..<stack.len:
        if stack[i] == name:
            return true
    return false

fn cAstFindLocal(locals: var CLocal[], name: str, out: var int32): bool =
    for i in 0..<locals.len:
        if locals[i].name == name:
            out = locals[i].value
            return true
    return false

fn cAstFindGlobal(globals: var CGlobal[], name: str, out: var int32): bool =
    for i in 0..<globals.len:
        if globals[i].name == name:
            out = globals[i].value
            return true
    return false

fn cAstFindGlobalIndex(globals: var CGlobal[], name: str): int32 =
    for i in 0..<globals.len:
        if globals[i].name == name:
            return i
    return -1

fn cAstGlobalNameExists(globals: var CGlobal[], name: str): bool =
    var unused: int32
    return cAstFindGlobal(globals, name, unused)

fn cAstSetLocal(locals: var CLocal[], name: str, value: int32): bool =
    for i in 0..<locals.len:
        if locals[i].name == name:
            return false
    var local: CLocal
    local.name = name
    local.value = value
    add(locals, local)
    return true

fn cAstSetGlobalValue(globals: var CGlobal[], name: str, value: int32): bool =
    for i in 0..<globals.len:
        if globals[i].name == name:
            globals[i].value = value
            return true
    return false

fn cAstCloneGlobals(globals: var CGlobal[]): CGlobal[] =
    var out: CGlobal[]
    for i in 0..<globals.len:
        var item: CGlobal
        item.name = globals[i].name
        item.initialValue = globals[i].initialValue
        item.value = globals[i].initialValue
        add(out, item)
    return out

fn cAstExprFail(code: str): CExprResult =
    var out: CExprResult
    out.error = code
    return out

fn cAstDeclFail(code: str): CDeclResult =
    var out: CDeclResult
    out.error = code
    return out

fn cAstFunctionFail(code: str): CClosedFunction =
    var out: CClosedFunction
    out.error = code
    return out

fn cAstInt32Op(left: int32, op: str, right: int32, out: var int32): bool =
    var value: int64
    if op == "+":
        value = int64(left) + int64(right)
    elif op == "-":
        value = int64(left) - int64(right)
    elif op == "*":
        value = int64(left) * int64(right)
    else:
        return false
    if value < int64(-2147483648) || value > int64(2147483647):
        return false
    out = int32(value)
    return true

fn cAstCompoundOpText(op: str, out: var str): bool =
    if op == "+=":
        out = "+"
        return true
    if op == "-=":
        out = "-"
        return true
    if op == "*=":
        out = "*"
        return true
    return false

fn cAstExprContainsCall(raw: str): bool =
    let expr = cAstUnwrapImplicit(raw)
    let kind = cAstNodeKind(expr)
    if kind == "CallExpr":
        return true
    if kind == "BinaryOperator":
        let children = cAstChildren(expr)
        for i in 0..<children.len:
            if cAstExprContainsCall(children[i]):
                return true
        return false
    return false

fn cAstIntegerLiteral(raw: str, out: var int32): bool =
    let expr = cAstUnwrapImplicit(raw)
    if cAstNodeKind(expr) != "IntegerLiteral":
        return false
    var valueText: str
    if cAstTopString(expr, "value", valueText):
        let decoded = cAstTrimRaw(valueText)
        if decoded.len >= 2 && decoded[0] == '"' && decoded[decoded.len - 1] == '"':
            return cAstParseInt32Raw(strings.SliceBytes(decoded, 1, decoded.len - 2), out)
        return cAstParseInt32Raw(decoded, out)
    var rawValue: str
    if !cAstTopRaw(expr, "value", rawValue):
        return false
    let trimmed = cAstTrimRaw(rawValue)
    if trimmed.len >= 2 && trimmed[0] == '"' && trimmed[trimmed.len - 1] == '"':
        return cAstParseInt32Raw(strings.SliceBytes(trimmed, 1, trimmed.len - 2), out)
    return cAstParseInt32Raw(trimmed, out)

fn cAstDeclRefName(raw: str, out: var str): bool =
    let expr = cAstUnwrapImplicit(raw)
    if cAstNodeKind(expr) != "DeclRefExpr":
        return false
    var refRaw: str
    if !cAstTopRaw(expr, "referencedDecl", refRaw):
        return false
    return cAstTopString(refRaw, "name", out)

fn cAstCallName(raw: str): str =
    if cAstNodeKind(raw) != "CallExpr":
        return ""
    let children = cAstChildren(raw)
    if children.len == 0:
        return ""
    var name: str
    if cAstDeclRefName(children[0], name):
        return name
    return ""

fn cAstStringLiteral(raw: str, out: var str): bool =
    let expr = cAstUnwrapImplicit(raw)
    if cAstNodeKind(expr) != "StringLiteral":
        return false
    var rawValue: str
    if !cAstTopString(expr, "value", rawValue):
        return false
    if rawValue.len < 2 || rawValue[0] != '"' || rawValue[rawValue.len - 1] != '"':
        return false
    var text: str
    for i in 1..<rawValue.len - 1:
        if rawValue[i] == '\\' || rawValue[i] == '\0':
            return false
        cAstAppend(text, strings.CharToStr(rawValue[i]))
    out = text
    return true

fn cAstPutsLine(raw: str, out: var str): bool =
    if cAstNodeKind(raw) != "CallExpr" || cAstCallName(raw) != "puts":
        return false
    let children = cAstChildren(raw)
    if children.len != 2:
        return false
    return cAstStringLiteral(children[1], out)

fn cAstExpr(raw: str,
            locals: var CLocal[],
            globals: var CGlobal[],
            functions: var CFunction[],
            stack: var str[]): CExprResult =
    let expr = cAstUnwrapImplicit(raw)
    let kind = cAstNodeKind(expr)
    if kind == "IntegerLiteral":
        var value: int32
        if !cAstIntegerLiteral(expr, value):
            return cAstExprFail("c.frontend.integer_literal_not_closed")
        var out: CExprResult
        out.ok = true
        out.value = value
        out.expr = strings.IntToStr(value)
        return out
    if kind == "DeclRefExpr":
        var name: str
        if !cAstDeclRefName(expr, name):
            return cAstExprFail("c.frontend.only_local_i32_decl_refs_are_closed")
        var value: int32
        if !cAstValidIdentifier(name):
            return cAstExprFail("c.frontend.only_local_i32_decl_refs_are_closed")
        if !cAstFindLocal(locals, name, value) && !cAstFindGlobal(globals, name, value):
            return cAstExprFail("c.frontend.only_local_or_static_global_i32_decl_refs_are_closed")
        var out: CExprResult
        out.ok = true
        out.expr = name
        out.value = value
        return out
    if kind == "CallExpr":
        let name = cAstCallName(expr)
        if name == "main" || cAstFindFunction(functions, name) < 0:
            return cAstExprFail("c.frontend.only_closed_helper_calls_are_closed")
        let children = cAstChildren(expr)
        var args: int32[]
        var argExprs: str[]
        for i in 1..<children.len:
            let argResult = cAstExpr(children[i], locals, globals, functions, stack)
            if !argResult.ok:
                return cAstExprFail(argResult.error)
            add(args, argResult.value)
            add(argExprs, argResult.expr)
        let called = cAstEvalFunction(name, args, globals, functions, stack)
        if !called.ok:
            return cAstExprFail(called.error)
        var callText: str = name
        cAstAppend(callText, "(")
        for i in 0..<argExprs.len:
            if i > 0:
                cAstAppend(callText, ", ")
            cAstAppend(callText, argExprs[i])
        cAstAppend(callText, ")")
        var out: CExprResult
        out.ok = true
        out.expr = callText
        out.value = called.returnValue
        return out
    if kind == "BinaryOperator":
        var op: str
        if !cAstTopString(expr, "opcode", op) || (op != "+" && op != "-" && op != "*"):
            return cAstExprFail("c.frontend.only_add_sub_mul_i32_are_closed")
        let children = cAstChildren(expr)
        if children.len != 2:
            return cAstExprFail("c.frontend.malformed_binary_operator")
        let left = cAstExpr(children[0], locals, globals, functions, stack)
        if !left.ok:
            return cAstExprFail(left.error)
        let right = cAstExpr(children[1], locals, globals, functions, stack)
        if !right.ok:
            return cAstExprFail(right.error)
        var value: int32
        if !cAstInt32Op(left.value, op, right.value, value):
            return cAstExprFail("c.frontend.int32_overflow_not_closed")
        var out: CExprResult
        out.ok = true
        out.value = value
        cAstAppend(out.expr, "(")
        cAstAppend(out.expr, left.expr)
        cAstAppend(out.expr, " ")
        cAstAppend(out.expr, op)
        cAstAppend(out.expr, " ")
        cAstAppend(out.expr, right.expr)
        cAstAppend(out.expr, ")")
        return out
    return cAstExprFail("c.frontend.expression_not_closed")

fn cAstDeclStmt(raw: str,
                locals: var CLocal[],
                globals: var CGlobal[],
                functions: var CFunction[],
                stack: var str[]): CDeclResult =
    if cAstNodeKind(raw) != "DeclStmt":
        return cAstDeclFail("c.frontend.statement_not_decl")
    let children = cAstChildren(raw)
    if children.len != 1 || cAstNodeKind(children[0]) != "VarDecl":
        return cAstDeclFail("c.frontend.only_single_var_decl_statement_is_closed")
    let decl = children[0]
    var name: str
    if !cAstTopString(decl, "name", name) || !cAstValidIdentifier(name):
        return cAstDeclFail("c.frontend.local_name_not_closed")
    if cAstGlobalNameExists(globals, name):
        return cAstDeclFail("c.frontend.local_global_shadow_not_closed")
    if cAstQualType(decl) != "int":
        return cAstDeclFail("c.frontend.only_int_local_decl_is_closed")
    let init = cAstChildren(decl)
    if init.len != 1:
        return cAstDeclFail("c.frontend.local_decl_requires_initializer")
    let exprResult = cAstExpr(init[0], locals, globals, functions, stack)
    if !exprResult.ok:
        return cAstDeclFail(exprResult.error)
    if !cAstSetLocal(locals, name, exprResult.value):
        return cAstDeclFail("c.frontend.local_name_not_closed")
    var stmt: CClosedStatement
    stmt.kind = "local_i32"
    stmt.name = name
    stmt.expr = exprResult.expr
    stmt.value = exprResult.value
    var out: CDeclResult
    out.ok = true
    out.statement = stmt
    return out

fn cAstAssignStmt(raw: str,
                  locals: var CLocal[],
                  globals: var CGlobal[],
                  functions: var CFunction[],
                  stack: var str[]): CDeclResult =
    if cAstNodeKind(raw) != "BinaryOperator":
        return cAstDeclFail("c.frontend.statement_not_assignment")
    var op: str
    if !cAstTopString(raw, "opcode", op) || op != "=":
        return cAstDeclFail("c.frontend.only_static_global_i32_assignment_is_closed")
    let children = cAstChildren(raw)
    if children.len != 2:
        return cAstDeclFail("c.frontend.malformed_assignment")
    var name: str
    if !cAstDeclRefName(children[0], name) || !cAstValidIdentifier(name):
        return cAstDeclFail("c.frontend.only_static_global_i32_assignment_is_closed")
    var oldValue: int32
    if !cAstFindGlobal(globals, name, oldValue):
        return cAstDeclFail("c.frontend.only_static_global_i32_assignment_is_closed")
    var localValue: int32
    if cAstFindLocal(locals, name, localValue):
        return cAstDeclFail("c.frontend.local_global_shadow_not_closed")
    let exprResult = cAstExpr(children[1], locals, globals, functions, stack)
    if !exprResult.ok:
        return cAstDeclFail(exprResult.error)
    if !cAstSetGlobalValue(globals, name, exprResult.value):
        return cAstDeclFail("c.frontend.only_static_global_i32_assignment_is_closed")
    var stmt: CClosedStatement
    stmt.kind = "store_global_i32"
    stmt.name = name
    stmt.expr = exprResult.expr
    stmt.value = exprResult.value
    var out: CDeclResult
    out.ok = true
    out.statement = stmt
    return out

fn cAstCompoundAssignStmt(raw: str,
                          locals: var CLocal[],
                          globals: var CGlobal[],
                          functions: var CFunction[],
                          stack: var str[]): CDeclResult =
    if cAstNodeKind(raw) != "CompoundAssignOperator":
        return cAstDeclFail("c.frontend.statement_not_compound_assignment")
    var op: str
    if !cAstTopString(raw, "opcode", op):
        return cAstDeclFail("c.frontend.only_static_global_i32_compound_assignment_is_closed")
    var opText: str
    if !cAstCompoundOpText(op, opText):
        return cAstDeclFail("c.frontend.only_add_sub_mul_i32_are_closed")
    let children = cAstChildren(raw)
    if children.len != 2:
        return cAstDeclFail("c.frontend.malformed_compound_assignment")
    var name: str
    if !cAstDeclRefName(children[0], name) || !cAstValidIdentifier(name):
        return cAstDeclFail("c.frontend.only_static_global_i32_compound_assignment_is_closed")
    var oldValue: int32
    if !cAstFindGlobal(globals, name, oldValue):
        return cAstDeclFail("c.frontend.only_static_global_i32_compound_assignment_is_closed")
    var localValue: int32
    if cAstFindLocal(locals, name, localValue):
        return cAstDeclFail("c.frontend.local_global_shadow_not_closed")
    if cAstExprContainsCall(children[1]):
        return cAstDeclFail("c.frontend.compound_assignment_rhs_call_not_closed")
    let rhs = cAstExpr(children[1], locals, globals, functions, stack)
    if !rhs.ok:
        return cAstDeclFail(rhs.error)
    var newValue: int32
    if !cAstInt32Op(oldValue, opText, rhs.value, newValue):
        return cAstDeclFail("c.frontend.int32_overflow_not_closed")
    if !cAstSetGlobalValue(globals, name, newValue):
        return cAstDeclFail("c.frontend.only_static_global_i32_compound_assignment_is_closed")
    var stmt: CClosedStatement
    stmt.kind = "store_global_i32"
    stmt.name = name
    cAstAppend(stmt.expr, "(")
    cAstAppend(stmt.expr, name)
    cAstAppend(stmt.expr, " ")
    cAstAppend(stmt.expr, opText)
    cAstAppend(stmt.expr, " ")
    cAstAppend(stmt.expr, rhs.expr)
    cAstAppend(stmt.expr, ")")
    stmt.value = newValue
    var out: CDeclResult
    out.ok = true
    out.statement = stmt
    return out

fn cAstEvalFunction(name: str,
                    argValues: var int32[],
                    globals: var CGlobal[],
                    functions: var CFunction[],
                    stack: var str[]): CClosedFunction =
    if cAstStackContains(stack, name):
        return cAstFunctionFail("c.frontend.recursive_function_graph_not_closed")
    let fnIndex = cAstFindFunction(functions, name)
    if fnIndex < 0:
        return cAstFunctionFail("c.frontend.function_not_found")
    let fnInfo = functions[fnIndex]
    if fnInfo.params.len != argValues.len:
        return cAstFunctionFail("c.frontend.function_call_arity_not_closed")
    var locals: CLocal[]
    for i in 0..<fnInfo.params.len:
        if cAstGlobalNameExists(globals, fnInfo.params[i]):
            return cAstFunctionFail("c.frontend.param_global_shadow_not_closed")
        if !cAstSetLocal(locals, fnInfo.params[i], argValues[i]):
            return cAstFunctionFail("c.frontend.function_param_not_closed")
    let body = fnInfo.body
    if body.len == 0 || cAstNodeKind(body[body.len - 1]) != "ReturnStmt":
        return cAstFunctionFail("c.frontend.closed_body_must_end_with_return")
    add(stack, name)
    var statements: CClosedStatement[]
    for i in 0..<body.len - 1:
        if cAstNodeKind(body[i]) == "DeclStmt":
            let decl = cAstDeclStmt(body[i], locals, globals, functions, stack)
            if !decl.ok:
                setLen(stack, stack.len - 1)
                return cAstFunctionFail(decl.error)
            add(statements, decl.statement)
        elif cAstNodeKind(body[i]) == "BinaryOperator":
            let assigned = cAstAssignStmt(body[i], locals, globals, functions, stack)
            if !assigned.ok:
                setLen(stack, stack.len - 1)
                return cAstFunctionFail(assigned.error)
            add(statements, assigned.statement)
        elif cAstNodeKind(body[i]) == "CompoundAssignOperator":
            let assigned = cAstCompoundAssignStmt(body[i], locals, globals, functions, stack)
            if !assigned.ok:
                setLen(stack, stack.len - 1)
                return cAstFunctionFail(assigned.error)
            add(statements, assigned.statement)
        elif name == "main":
            var line: str
            if !cAstPutsLine(body[i], line):
                setLen(stack, stack.len - 1)
                return cAstFunctionFail("c.frontend.only_int_decl_global_store_or_puts_before_return_is_closed")
            var stdoutStmt: CClosedStatement
            stdoutStmt.kind = "stdout_line"
            stdoutStmt.text = line
            add(statements, stdoutStmt)
        else:
            setLen(stack, stack.len - 1)
            return cAstFunctionFail("c.frontend.helper_must_be_closed_int_return")
    let returnChildren = cAstChildren(body[body.len - 1])
    if returnChildren.len != 1:
        setLen(stack, stack.len - 1)
        return cAstFunctionFail("c.frontend.return_value_must_be_i32_expression")
    let ret = cAstExpr(returnChildren[0], locals, globals, functions, stack)
    if !ret.ok:
        setLen(stack, stack.len - 1)
        return cAstFunctionFail(ret.error)
    setLen(stack, stack.len - 1)
    var out: CClosedFunction
    out.ok = true
    out.name = name
    out.exported = fnInfo.storageClass != "static" || name == "main"
    out.parameters = fnInfo.params
    out.statements = statements
    out.returnExpr = ret.expr
    out.returnValue = ret.value
    return out

fn cAstValidateFunctions(functions: var CFunction[], globals: var CGlobal[], unsupported: var str[], allowExternalHelpers: bool, allowLibrary: bool) =
    let hasMain = cAstFindFunction(functions, "main") >= 0
    if !hasMain && !allowLibrary:
        cAstAddUnsupported(unsupported, "c.frontend.entry_function_must_be_main")
    var exportedCount: int32
    for i in 0..<functions.len:
        let fnInfo = functions[i]
        if !cAstValidIdentifier(fnInfo.name):
            cAstAddUnsupported(unsupported, "c.frontend.function_name_not_closed")
            continue
        if cAstGlobalNameExists(globals, fnInfo.name):
            cAstAddUnsupported(unsupported, "c.frontend.global_function_name_conflict")
            continue
        if fnInfo.name == "main":
            if (fnInfo.qualType != "int (void)" && fnInfo.qualType != "int ()") || fnInfo.params.len != 0:
                cAstAddUnsupported(unsupported, "c.frontend.main_signature_must_be_int_void")
        elif !strings.HasPrefix(fnInfo.qualType, "int (") || fnInfo.params.len > 8:
            cAstAddUnsupported(unsupported, "c.frontend.helper_signature_must_be_int_function")
        elif !hasMain && fnInfo.storageClass != "static":
            exportedCount = exportedCount + 1
        elif hasMain && !allowExternalHelpers && fnInfo.storageClass != "static":
            cAstAddUnsupported(unsupported, "c.frontend.helper_must_be_static_internal")
    if !hasMain && allowLibrary && exportedCount <= 0:
        cAstAddUnsupported(unsupported, "c.frontend.library_requires_exported_function")

fn cAstClosedFunctionLess(a: CClosedFunction, b: CClosedFunction): bool =
    if a.name == "main" && b.name != "main":
        return false
    if a.name != "main" && b.name == "main":
        return true
    return cAstStringLess(a.name, b.name)

fn cAstSortClosedForFacts(functions: var CClosedFunction[]) =
    for i in 1..<functions.len:
        var pos: int32 = i
        while pos > 0 && cAstClosedFunctionLess(functions[pos], functions[pos - 1]):
            let tmp = functions[pos - 1]
            functions[pos - 1] = functions[pos]
            functions[pos] = tmp
            pos = pos - 1

fn cAstSortFunctionsByName(functions: var CFunction[]) =
    for i in 1..<functions.len:
        var pos: int32 = i
        while pos > 0 && cAstStringLess(functions[pos].name, functions[pos - 1].name):
            let tmp = functions[pos - 1]
            functions[pos - 1] = functions[pos]
            functions[pos] = tmp
            pos = pos - 1

fn cAstSortGlobalsByName(globals: var CGlobal[]) =
    for i in 1..<globals.len:
        var pos: int32 = i
        while pos > 0 && cAstStringLess(globals[pos].name, globals[pos - 1].name):
            let tmp = globals[pos - 1]
            globals[pos - 1] = globals[pos]
            globals[pos] = tmp
            pos = pos - 1

fn cAstJsonStringArray(values: var str[]): str =
    var out: str = "["
    for i in 0..<values.len:
        if i > 0:
            cAstAppend(out, ",")
        cAstAppend(out, cAstJsonQuote(values[i]))
    cAstAppend(out, "]")
    return out

fn cAstParamsJson(params: var str[]): str =
    var out: str = "["
    for i in 0..<params.len:
        if i > 0:
            cAstAppend(out, ",")
        cAstAppend(out, "{\"name\":")
        cAstAppend(out, cAstJsonQuote(params[i]))
        cAstAppend(out, ",\"type\":\"i32\"}")
    cAstAppend(out, "]")
    return out

fn cAstUnsupportedFact(code: str): str =
    var out: str = "{\"code\":"
    cAstAppend(out, cAstJsonQuote(code))
    cAstAppend(out, ",\"id\":")
    cAstAppend(out, cAstJsonQuote(cAstCat("unsupported:c:", cAstSafeId(code))))
    cAstAppend(out, ",\"kind\":\"csg.unsupported\",\"message\":")
    cAstAppend(out, cAstJsonQuote(cAstCat("C semantic not closed: ", code)))
    cAstAppend(out, "}")
    return out

fn cAstAppendGlobalFacts(facts: var str[], globals: var CGlobal[]) =
    cAstSortGlobalsByName(globals)
    for i in 0..<globals.len:
        let name = globals[i].name
        add(facts, cAstCat(cAstCat("{\"id\":", cAstJsonQuote(cAstCat("symbol:", name))), cAstCat(cAstCat(",\"kind\":\"csg.symbol\",\"name\":", cAstJsonQuote(name)), ",\"symbolKind\":\"global\"}")))
        var line: str = "{\"id\":"
        cAstAppend(line, cAstJsonQuote(cAstCat("global:", name)))
        cAstAppend(line, ",\"kind\":\"csg_dialect::native::global_i32\",\"name\":")
        cAstAppend(line, cAstJsonQuote(name))
        cAstAppend(line, ",\"initialValue\":")
        cAstAppend(line, strings.IntToStr(globals[i].initialValue))
        cAstAppend(line, ",\"storage\":\"static\"}")
        add(facts, line)

fn cAstAppendClosedFunctionFacts(facts: var str[], closedFunctions: var CClosedFunction[]) =
    cAstSortClosedForFacts(closedFunctions)
    for i in 0..<closedFunctions.len:
        let item = closedFunctions[i]
        let name = item.name
        let functionId = cAstCat("function:", name)
        add(facts, cAstCat(cAstCat("{\"id\":", cAstJsonQuote(cAstCat("symbol:", name))), cAstCat(cAstCat(",\"kind\":\"csg.symbol\",\"name\":", cAstJsonQuote(name)), ",\"symbolKind\":\"function\"}")))
        var fnLine: str = "{\"id\":"
        cAstAppend(fnLine, cAstJsonQuote(functionId))
        cAstAppend(fnLine, ",\"kind\":\"csg.function\",\"name\":")
        cAstAppend(fnLine, cAstJsonQuote(name))
        cAstAppend(fnLine, ",\"parameters\":")
        cAstAppend(fnLine, cAstParamsJson(item.parameters))
        cAstAppend(fnLine, ",\"returnType\":\"i32\",\"symbol\":")
        cAstAppend(fnLine, cAstJsonQuote(cAstCat("symbol:", name)))
        cAstAppend(fnLine, ",\"abiExport\":")
        cAstAppend(fnLine, cAstJsonBool(item.exported))
        cAstAppend(fnLine, "}")
        add(facts, fnLine)
        var blockLine: str = "{\"blockKind\":\"entry\",\"function\":"
        cAstAppend(blockLine, cAstJsonQuote(functionId))
        cAstAppend(blockLine, ",\"id\":")
        cAstAppend(blockLine, cAstJsonQuote(cAstCat(cAstCat("block:", name), ":entry")))
        cAstAppend(blockLine, ",\"kind\":\"csg.block\"}")
        add(facts, blockLine)
        for paramIndex in 0..<item.parameters.len:
            var paramLine: str = "{\"function\":"
            cAstAppend(paramLine, cAstJsonQuote(functionId))
            cAstAppend(paramLine, ",\"id\":")
            cAstAppend(paramLine, cAstJsonQuote(cAstCat(cAstCat(cAstCat(cAstCat("param:", name), ":"), strings.IntToStr(paramIndex)), cAstCat(":", item.parameters[paramIndex]))))
            cAstAppend(paramLine, ",\"kind\":\"csg_dialect::native::param_i32\",\"name\":")
            cAstAppend(paramLine, cAstJsonQuote(item.parameters[paramIndex]))
            cAstAppend(paramLine, ",\"order\":")
            cAstAppend(paramLine, strings.IntToStr(paramIndex))
            cAstAppend(paramLine, "}")
            add(facts, paramLine)
        for stmtIndex in 0..<item.statements.len:
            let stmt = item.statements[stmtIndex]
            if stmt.kind == "stdout_line":
                var line: str = "{\"function\":"
                cAstAppend(line, cAstJsonQuote(functionId))
                cAstAppend(line, ",\"id\":")
                cAstAppend(line, cAstJsonQuote(cAstCat(cAstCat(cAstCat("stmt:", name), cAstCat(":", strings.IntToStr(stmtIndex))), ":stdout")))
                cAstAppend(line, ",\"kind\":\"csg_dialect::native::stdout_line\",\"order\":")
                cAstAppend(line, strings.IntToStr(stmtIndex))
                cAstAppend(line, ",\"text\":")
                cAstAppend(line, cAstJsonQuote(stmt.text))
                cAstAppend(line, "}")
                add(facts, line)
            elif stmt.kind == "local_i32":
                var line: str = "{\"expr\":"
                cAstAppend(line, cAstJsonQuote(stmt.expr))
                cAstAppend(line, ",\"function\":")
                cAstAppend(line, cAstJsonQuote(functionId))
                cAstAppend(line, ",\"id\":")
                cAstAppend(line, cAstJsonQuote(cAstCat(cAstCat(cAstCat(cAstCat("stmt:", name), cAstCat(":", strings.IntToStr(stmtIndex))), ":local:"), stmt.name)))
                cAstAppend(line, ",\"kind\":\"csg_dialect::native::local_i32\",\"name\":")
                cAstAppend(line, cAstJsonQuote(stmt.name))
                cAstAppend(line, ",\"order\":")
                cAstAppend(line, strings.IntToStr(stmtIndex))
                cAstAppend(line, ",\"value\":")
                cAstAppend(line, strings.IntToStr(stmt.value))
                cAstAppend(line, "}")
                add(facts, line)
            elif stmt.kind == "store_global_i32":
                var line: str = "{\"expr\":"
                cAstAppend(line, cAstJsonQuote(stmt.expr))
                cAstAppend(line, ",\"function\":")
                cAstAppend(line, cAstJsonQuote(functionId))
                cAstAppend(line, ",\"id\":")
                cAstAppend(line, cAstJsonQuote(cAstCat(cAstCat(cAstCat(cAstCat("stmt:", name), cAstCat(":", strings.IntToStr(stmtIndex))), ":store_global:"), stmt.name)))
                cAstAppend(line, ",\"kind\":\"csg_dialect::native::store_global_i32\",\"name\":")
                cAstAppend(line, cAstJsonQuote(stmt.name))
                cAstAppend(line, ",\"order\":")
                cAstAppend(line, strings.IntToStr(stmtIndex))
                cAstAppend(line, ",\"value\":")
                cAstAppend(line, strings.IntToStr(stmt.value))
                cAstAppend(line, "}")
                add(facts, line)
        var termLine: str = "{\"block\":"
        cAstAppend(termLine, cAstJsonQuote(cAstCat(cAstCat("block:", name), ":entry")))
        cAstAppend(termLine, ",\"function\":")
        cAstAppend(termLine, cAstJsonQuote(functionId))
        cAstAppend(termLine, ",\"id\":")
        cAstAppend(termLine, cAstJsonQuote(cAstCat(cAstCat("term:", name), ":return")))
        cAstAppend(termLine, ",\"kind\":\"csg.term\",\"termKind\":\"return\",\"value\":")
        cAstAppend(termLine, strings.IntToStr(item.returnValue))
        cAstAppend(termLine, ",\"valueExpr\":")
        cAstAppend(termLine, cAstJsonQuote(item.returnExpr))
        cAstAppend(termLine, "}")
        add(facts, termLine)

fn cAstCanonicalJsonIntText(value: int32): str =
    # JSON canonical integer form for raw numeric fact fields, produced by
    # the authoritative canonicalizer itself (1000 -> 1e3 because the
    # scientific form is strictly shorter; plain stays byte-identical).
    # translation_unit.functionCount is an int-checked validator field and
    # replay admission proves per-line canonicality, so the emitted text
    # must already be canonical.
    let roundTrip = canonical.CsgCoreJsonCanonicalize(
        strings.IntToStr(value))
    if !roundTrip.ok:
        panic(strings.CloneStr(roundTrip.error))
    return strings.CloneStr(roundTrip.value)

fn cAstBuildFacts(astRoot: str, sourceText: str, cfg: CEmitConfig): CBuildResult =
    var out: CBuildResult
    out.closedWorldKind = "single-translation-unit-executable"
    add(out.facts, "{\"features\":[\"core-facts\",\"runtime-closure\",\"csg_dialect::c\"],\"id\":\"csg.core.schema:c\",\"kind\":\"csg.core.schema\",\"language\":\"c\",\"schema\":\"csg_core\"}")
    let moduleId = cAstCat("module:c:", cAstSafeId(cfg.displayPath))
    var moduleLine: str = "{\"id\":"
    cAstAppend(moduleLine, cAstJsonQuote(moduleId))
    cAstAppend(moduleLine, ",\"kind\":\"csg.module\",\"path\":")
    cAstAppend(moduleLine, cAstJsonQuote(cfg.displayPath))
    cAstAppend(moduleLine, ",\"sha256\":")
    cAstAppend(moduleLine, cAstJsonQuote(cAstCat("sha256:", strings.Sha256(sourceText))))
    cAstAppend(moduleLine, "}")
    add(out.facts, moduleLine)

    var topInnerRaw: str
    if !cAstTopRaw(astRoot, "inner", topInnerRaw):
        cAstAddUnsupported(out.unsupportedCodes, "c.frontend.ast_inner_missing")
    let topDecls = cAstArrayObjects(topInnerRaw)
    var functions: CFunction[]
    var globals: CGlobal[]
    for i in 0..<topDecls.len:
        if !cAstNodeInSource(topDecls[i], cfg.source, sourceText.len):
            continue
        let kind = cAstNodeKind(topDecls[i])
        if kind == "FunctionDecl":
            continue
        elif kind == "VarDecl":
            var global: CGlobal
            var globalError: str
            if !cAstMakeGlobal(topDecls[i], global, globalError):
                cAstAddUnsupported(out.unsupportedCodes, globalError)
            elif cAstFindGlobalIndex(globals, global.name) >= 0:
                cAstAddUnsupported(out.unsupportedCodes, "c.frontend.duplicate_or_invalid_global_name")
            else:
                add(globals, global)
        else:
            cAstAddUnsupported(out.unsupportedCodes, "c.frontend.top_level_declaration_not_closed")
    let functionDecls = cAstObjectsWithKind(astRoot, "FunctionDecl")
    for i in 0..<functionDecls.len:
        if !cAstNodeInSource(functionDecls[i], cfg.source, sourceText.len) || !cAstFunctionHasCompound(functionDecls[i]):
            continue
        var fnInfo: CFunction
        var fnError: str
        if !cAstMakeFunction(functionDecls[i], fnInfo, fnError):
            cAstAddUnsupported(out.unsupportedCodes, fnError)
        elif cAstFindFunction(functions, fnInfo.name) >= 0:
            cAstAddUnsupported(out.unsupportedCodes, "c.frontend.duplicate_or_invalid_function_name")
        else:
            add(functions, fnInfo)
    if cfg.structuralUnsupported.len > 0:
        cAstAddUnsupported(out.unsupportedCodes, cfg.structuralUnsupported)
    let hasMain = cAstFindFunction(functions, "main") >= 0
    if !hasMain:
        out.closedWorldKind = "single-translation-unit-library"
    var tuLine: str = "{\"functionCount\":"
    cAstAppend(tuLine, cAstCanonicalJsonIntText(functions.len))
    cAstAppend(tuLine, ",\"id\":")
    cAstAppend(tuLine, cAstJsonQuote(cAstCat("c-dialect:translation-unit:", cAstSafeId(cfg.displayPath))))
    cAstAppend(tuLine, ",\"kind\":\"csg_dialect::c::translation_unit\",\"module\":")
    cAstAppend(tuLine, cAstJsonQuote(moduleId))
    cAstAppend(tuLine, ",\"path\":")
    cAstAppend(tuLine, cAstJsonQuote(cfg.displayPath))
    cAstAppend(tuLine, ",\"target\":")
    cAstAppend(tuLine, cAstJsonQuote(cfg.target))
    cAstAppend(tuLine, "}")
    add(out.facts, tuLine)
    for i in 0..<functions.len:
        var line: str = "{\"id\":"
        cAstAppend(line, cAstJsonQuote(cAstCat("c-dialect:function:", cAstSafeId(functions[i].name))))
        cAstAppend(line, ",\"kind\":\"csg_dialect::c::function\",\"module\":")
        cAstAppend(line, cAstJsonQuote(moduleId))
        cAstAppend(line, ",\"name\":")
        cAstAppend(line, cAstJsonQuote(functions[i].name))
        cAstAppend(line, ",\"qualType\":")
        cAstAppend(line, cAstJsonQuote(functions[i].qualType))
        cAstAppend(line, "}")
        add(out.facts, line)
    if out.unsupportedCodes.len == 0:
        cAstValidateFunctions(functions, globals, out.unsupportedCodes, false, true)
    if out.unsupportedCodes.len == 0:
        var sortedFunctions = functions
        cAstSortFunctionsByName(sortedFunctions)
        for i in 0..<sortedFunctions.len:
            var args: int32[]
            if sortedFunctions[i].name != "main":
                for _ in 0..<sortedFunctions[i].params.len:
                    add(args, 0)
            var stack: str[]
            var evalGlobals = cAstCloneGlobals(globals)
            let closed = cAstEvalFunction(sortedFunctions[i].name, args, evalGlobals, functions, stack)
            if !closed.ok:
                cAstAddUnsupported(out.unsupportedCodes, closed.error)
                break
            add(out.closedFunctions, closed)
        if out.unsupportedCodes.len == 0:
            var foundMain: bool
            for i in 0..<out.closedFunctions.len:
                if out.closedFunctions[i].name == "main":
                    foundMain = true
                    out.closedReturnSet = true
                    out.closedReturn = out.closedFunctions[i].returnValue
                    out.closedStatements = out.closedFunctions[i].statements
            if !foundMain && hasMain:
                cAstAddUnsupported(out.unsupportedCodes, "c.frontend.entry_function_must_be_main")
            elif foundMain && (out.closedReturn < 0 || out.closedReturn > 255):
                cAstAddUnsupported(out.unsupportedCodes, "c.frontend.exit_status_must_be_0_255")
    if out.unsupportedCodes.len == 0:
        out.globals = globals
        cAstAppendGlobalFacts(out.facts, out.globals)
        cAstAppendClosedFunctionFacts(out.facts, out.closedFunctions)
        out.complete = true
    else:
        for i in 0..<out.unsupportedCodes.len:
            add(out.facts, cAstUnsupportedFact(out.unsupportedCodes[i]))
    return out

fn cAstAppendUnitFacts(astRoot: str,
                       sourceText: str,
                       sourcePath: str,
                       displayPath: str,
                       target: str,
                       functions: var CFunction[],
                       globals: var CGlobal[],
                       facts: var str[],
                       unsupported: var str[]) =
    let moduleId = cAstCat("module:c:", cAstSafeId(displayPath))
    var moduleLine: str = "{\"id\":"
    cAstAppend(moduleLine, cAstJsonQuote(moduleId))
    cAstAppend(moduleLine, ",\"kind\":\"csg.module\",\"path\":")
    cAstAppend(moduleLine, cAstJsonQuote(displayPath))
    cAstAppend(moduleLine, ",\"sha256\":")
    cAstAppend(moduleLine, cAstJsonQuote(cAstCat("sha256:", strings.Sha256(sourceText))))
    cAstAppend(moduleLine, "}")
    add(facts, moduleLine)

    var topInnerRaw: str
    if !cAstTopRaw(astRoot, "inner", topInnerRaw):
        cAstAddUnsupported(unsupported, "c.frontend.ast_inner_missing")
    let topDecls = cAstArrayObjects(topInnerRaw)
    for i in 0..<topDecls.len:
        if !cAstNodeInSource(topDecls[i], sourcePath, sourceText.len):
            continue
        let kind = cAstNodeKind(topDecls[i])
        if kind == "FunctionDecl":
            continue
        elif kind == "VarDecl":
            var global: CGlobal
            var globalError: str
            if !cAstMakeGlobal(topDecls[i], global, globalError):
                cAstAddUnsupported(unsupported, globalError)
            elif cAstFindGlobalIndex(globals, global.name) >= 0:
                cAstAddUnsupported(unsupported, "c.frontend.duplicate_or_invalid_global_name")
            else:
                add(globals, global)
        else:
            cAstAddUnsupported(unsupported, "c.frontend.top_level_declaration_not_closed")
    let beforeCount = functions.len
    let functionDecls = cAstObjectsWithKind(astRoot, "FunctionDecl")
    for i in 0..<functionDecls.len:
        if !cAstNodeInSource(functionDecls[i], sourcePath, sourceText.len) || !cAstFunctionHasCompound(functionDecls[i]):
            continue
        var fnInfo: CFunction
        var fnError: str
        if !cAstMakeFunction(functionDecls[i], fnInfo, fnError):
            cAstAddUnsupported(unsupported, fnError)
        elif cAstFindFunction(functions, fnInfo.name) >= 0:
            cAstAddUnsupported(unsupported, "c.frontend.duplicate_or_invalid_function_name")
        else:
            add(functions, fnInfo)
    var tuLine: str = "{\"functionCount\":"
    cAstAppend(tuLine, cAstCanonicalJsonIntText(functions.len - beforeCount))
    cAstAppend(tuLine, ",\"id\":")
    cAstAppend(tuLine, cAstJsonQuote(cAstCat("c-dialect:translation-unit:", cAstSafeId(displayPath))))
    cAstAppend(tuLine, ",\"kind\":\"csg_dialect::c::translation_unit\",\"module\":")
    cAstAppend(tuLine, cAstJsonQuote(moduleId))
    cAstAppend(tuLine, ",\"path\":")
    cAstAppend(tuLine, cAstJsonQuote(displayPath))
    cAstAppend(tuLine, ",\"target\":")
    cAstAppend(tuLine, cAstJsonQuote(target))
    cAstAppend(tuLine, "}")
    add(facts, tuLine)
    for i in beforeCount..<functions.len:
        var line: str = "{\"id\":"
        cAstAppend(line, cAstJsonQuote(cAstCat("c-dialect:function:", cAstSafeId(functions[i].name))))
        cAstAppend(line, ",\"kind\":\"csg_dialect::c::function\",\"module\":")
        cAstAppend(line, cAstJsonQuote(moduleId))
        cAstAppend(line, ",\"name\":")
        cAstAppend(line, cAstJsonQuote(functions[i].name))
        cAstAppend(line, ",\"qualType\":")
        cAstAppend(line, cAstJsonQuote(functions[i].qualType))
        cAstAppend(line, "}")
        add(facts, line)

fn cAstEvaluateCollectedFunctions(functions: var CFunction[], globals: var CGlobal[], allowExternalHelpers: bool, allowLibrary: bool, out: var CBuildResult) =
    let hasMain = cAstFindFunction(functions, "main") >= 0
    if out.unsupportedCodes.len == 0:
        cAstValidateFunctions(functions, globals, out.unsupportedCodes, allowExternalHelpers, allowLibrary)
    if out.unsupportedCodes.len == 0:
        var sortedFunctions = functions
        cAstSortFunctionsByName(sortedFunctions)
        for i in 0..<sortedFunctions.len:
            var args: int32[]
            if sortedFunctions[i].name != "main":
                for _ in 0..<sortedFunctions[i].params.len:
                    add(args, 0)
            var stack: str[]
            var evalGlobals = cAstCloneGlobals(globals)
            let closed = cAstEvalFunction(sortedFunctions[i].name, args, evalGlobals, functions, stack)
            if !closed.ok:
                cAstAddUnsupported(out.unsupportedCodes, closed.error)
                break
            add(out.closedFunctions, closed)
        if out.unsupportedCodes.len == 0:
            var foundMain: bool
            for i in 0..<out.closedFunctions.len:
                if out.closedFunctions[i].name == "main":
                    foundMain = true
                    out.closedReturnSet = true
                    out.closedReturn = out.closedFunctions[i].returnValue
                    out.closedStatements = out.closedFunctions[i].statements
            if !foundMain && hasMain:
                cAstAddUnsupported(out.unsupportedCodes, "c.frontend.entry_function_must_be_main")
            elif foundMain && (out.closedReturn < 0 || out.closedReturn > 255):
                cAstAddUnsupported(out.unsupportedCodes, "c.frontend.exit_status_must_be_0_255")

fn cAstBuildProjectFacts(oracle: str, cfg: CEmitConfig): CBuildResult =
    var out: CBuildResult
    out.closedWorldKind = "multi-translation-unit-executable"
    add(out.facts, "{\"features\":[\"core-facts\",\"runtime-closure\",\"csg_dialect::c\"],\"id\":\"csg.core.schema:c\",\"kind\":\"csg.core.schema\",\"language\":\"c\",\"schema\":\"csg_core\"}")
    var unitsRaw: str
    if !cAstTopRaw(oracle, "translationUnits", unitsRaw):
        cAstAddUnsupported(out.unsupportedCodes, "c.frontend.project_oracle_not_closed")
    let units = cAstArrayObjects(unitsRaw)
    if units.len == 0:
        cAstAddUnsupported(out.unsupportedCodes, "c.frontend.project_oracle_not_closed")
    if units.len == 1:
        out.closedWorldKind = "single-translation-unit-executable"
    var functions: CFunction[]
    var globals: CGlobal[]
    for i in 0..<units.len:
        var sourcePath: str
        var displayPath: str
        var astRoot: str
        if !cAstTopString(units[i], "source", sourcePath) || !cAstTopString(units[i], "displayPath", displayPath) || !cAstTopRaw(units[i], "astJson", astRoot):
            cAstAddUnsupported(out.unsupportedCodes, "c.frontend.project_oracle_not_closed")
            continue
        var sourceRead: Result[str] = os.ReadFileResult(sourcePath)
        if result.IsErr(sourceRead):
            cAstAddUnsupported(out.unsupportedCodes, "c.frontend.project_source_missing")
            continue
        let sourceText = result.Value(sourceRead)
        cAstAppendUnitFacts(astRoot, sourceText, sourcePath, displayPath, cfg.target, functions, globals, out.facts, out.unsupportedCodes)
    if cAstFindFunction(functions, "main") < 0:
        if units.len == 1:
            out.closedWorldKind = "single-translation-unit-library"
        else:
            out.closedWorldKind = "multi-translation-unit-library"
    cAstEvaluateCollectedFunctions(functions, globals, units.len > 1, true, out)
    if out.unsupportedCodes.len == 0:
        out.globals = globals
        cAstAppendGlobalFacts(out.facts, out.globals)
        cAstAppendClosedFunctionFacts(out.facts, out.closedFunctions)
        out.complete = true
    else:
        for i in 0..<out.unsupportedCodes.len:
            add(out.facts, cAstUnsupportedFact(out.unsupportedCodes[i]))
    return out

fn cAstFactsText(lines: var str[]): str =
    var out: str
    for i in 0..<lines.len:
        if lines[i].len > 0:
            cAstAppend(out, lines[i])
            cAstAppend(out, "\n")
    return out

fn cAstRawArray(items: var str[]): str =
    var out: str = "["
    for i in 0..<items.len:
        if i > 0:
            cAstAppend(out, ",")
        cAstAppend(out, items[i])
    cAstAppend(out, "]")
    return out

fn cAstUnsupportedFactsArray(facts: var str[]): str =
    var unsupported: str[]
    for i in 0..<facts.len:
        if cAstNodeKind(facts[i]) == "csg.unsupported":
            add(unsupported, strings.CloneStr(facts[i]))
    return cAstRawArray(unsupported)

fn cAstStatementsJson(statements: var CClosedStatement[]): str =
    var out: str = "["
    for i in 0..<statements.len:
        if i > 0:
            cAstAppend(out, ",")
        if statements[i].kind == "stdout_line":
            cAstAppend(out, "{\"kind\":\"stdout_line\",\"text\":")
            cAstAppend(out, cAstJsonQuote(statements[i].text))
            cAstAppend(out, "}")
        elif statements[i].kind == "local_i32":
            cAstAppend(out, "{\"expr\":")
            cAstAppend(out, cAstJsonQuote(statements[i].expr))
            cAstAppend(out, ",\"kind\":\"local_i32\",\"name\":")
            cAstAppend(out, cAstJsonQuote(statements[i].name))
            cAstAppend(out, ",\"value\":")
            cAstAppend(out, strings.IntToStr(statements[i].value))
            cAstAppend(out, "}")
        else:
            cAstAppend(out, "{\"expr\":")
            cAstAppend(out, cAstJsonQuote(statements[i].expr))
            cAstAppend(out, ",\"kind\":\"store_global_i32\",\"name\":")
            cAstAppend(out, cAstJsonQuote(statements[i].name))
            cAstAppend(out, ",\"value\":")
            cAstAppend(out, strings.IntToStr(statements[i].value))
            cAstAppend(out, "}")
    cAstAppend(out, "]")
    return out

fn cAstClosedFunctionsJson(functions: var CClosedFunction[]): str =
    var out: str = "["
    for i in 0..<functions.len:
        if i > 0:
            cAstAppend(out, ",")
        cAstAppend(out, "{\"name\":")
        cAstAppend(out, cAstJsonQuote(functions[i].name))
        cAstAppend(out, ",\"exported\":")
        cAstAppend(out, cAstJsonBool(functions[i].exported))
        cAstAppend(out, ",\"parameters\":")
        cAstAppend(out, cAstJsonStringArray(functions[i].parameters))
        cAstAppend(out, ",\"returnExpr\":")
        cAstAppend(out, cAstJsonQuote(functions[i].returnExpr))
        cAstAppend(out, ",\"returnValue\":")
        cAstAppend(out, strings.IntToStr(functions[i].returnValue))
        cAstAppend(out, ",\"statements\":")
        cAstAppend(out, cAstStatementsJson(functions[i].statements))
        cAstAppend(out, "}")
    cAstAppend(out, "]")
    return out

fn cAstGlobalsJson(globals: var CGlobal[]): str =
    var out: str = "["
    for i in 0..<globals.len:
        if i > 0:
            cAstAppend(out, ",")
        cAstAppend(out, "{\"name\":")
        cAstAppend(out, cAstJsonQuote(globals[i].name))
        cAstAppend(out, ",\"initialValue\":")
        cAstAppend(out, strings.IntToStr(globals[i].initialValue))
        cAstAppend(out, "}")
    cAstAppend(out, "]")
    return out

fn cAstEntryRootsJson(functions: var CClosedFunction[], worldKind: str): str =
    if !strings.HasSuffix(worldKind, "library"):
        return "[\"function:main\"]"
    var out: str = "["
    var first: bool = true
    for i in 0..<functions.len:
        if !functions[i].exported:
            continue
        if !first:
            cAstAppend(out, ",")
        first = false
        cAstAppend(out, cAstJsonQuote(cAstCat("function:", functions[i].name)))
    cAstAppend(out, "]")
    return out

fn cAstClosedSubsetName(worldKind: str, complete: bool, hasGlobals: bool): str =
    if !complete:
        return ""
    if strings.HasSuffix(worldKind, "library"):
        if hasGlobals:
            return "c.int-function-graph-static-global-i32-arith-return-library.v1"
        return "c.int-function-graph-local-arith-return-library.v1"
    if hasGlobals:
        return "c.int-function-graph-static-global-i32-arith-puts-return.v1"
    return "c.int-function-graph-local-arith-puts-return.v1"

fn cAstReportJson(
        build: var CBuildResult,
        reason: str,
        target: str,
        toolImplementation: str,
        admittedComplete: bool,
        admittedFactsRoot: str,
        admittedProfiles: var str[],
        admittedProfileSetCid: str): str =
    let isComplete =
        build.complete &&
        build.unsupportedCodes.len == 0 &&
        admittedComplete &&
        admittedFactsRoot.len > 0 &&
        admittedProfiles.len > 0 &&
        admittedProfileSetCid.len > 0
    var factsRoot: str
    if isComplete:
        factsRoot = strings.CloneStr(admittedFactsRoot)
    let unsupportedJson = cAstUnsupportedFactsArray(build.facts)
    var tool: str = toolImplementation
    if tool.len == 0:
        tool = "pure-cheng-c-csg-cli"
    var out: str = "{"
    cAstAppend(out, "\"schema\":\"csg-core.report\"")
    cAstAppend(out, ",\"standard\":")
    cAstAppend(out, cAstJsonQuote(csg.CsgCoreStandardIdentity()))
    cAstAppend(out, ",\"profiles\":")
    if isComplete:
        cAstAppend(out, cAstJsonStringArray(admittedProfiles))
    else:
        cAstAppend(out, "[]")
    cAstAppend(out, ",\"profile_set_cid\":")
    if isComplete:
        cAstAppend(out, cAstJsonQuote(admittedProfileSetCid))
    else:
        cAstAppend(out, "\"\"")
    cAstAppend(out, ",\"dialect\":\"csg_dialect::c\"")
    cAstAppend(out, ",\"toolImplementation\":")
    cAstAppend(out, cAstJsonQuote(tool))
    cAstAppend(out, ",\"reportControllerImplementation\":\"pure-cheng\"")
    cAstAppend(out, ",\"extractorImplementation\":\"pure-cheng-clang-ast-json\"")
    cAstAppend(out, ",\"extractorOracle\":\"clang-ast-dump-json\"")
    cAstAppend(out, ",\"pureChengToolchainComplete\":false")
    cAstAppend(out, ",\"fullProjectTranspilationComplete\":false")
    if tool == "python-clang-launcher":
        cAstAppend(out, ",\"toolchainGaps\":[\"legacy c-csg launcher invokes Clang through Python\",\"full C/Python project semantics are not complete\"]")
    else:
        cAstAppend(out, ",\"toolchainGaps\":[\"C extraction still depends on external Clang oracle\",\"full C/Python project semantics are not complete\"]")
    cAstAppend(out, ",\"complete\":")
    cAstAppend(out, cAstJsonBool(isComplete))
    cAstAppend(out, ",\"facts_root\":")
    cAstAppend(out, cAstJsonQuote(factsRoot))
    cAstAppend(out, ",\"counts\":{\"factCount\":")
    cAstAppend(out, strings.IntToStr(build.facts.len))
    cAstAppend(out, ",\"unsupported\":")
    cAstAppend(out, strings.IntToStr(build.unsupportedCodes.len))
    cAstAppend(out, ",\"globals\":")
    cAstAppend(out, strings.IntToStr(build.globals.len))
    cAstAppend(out, ",\"runtimeRequirements\":0,\"externalSymbols\":0}")
    cAstAppend(out, ",\"unsupported\":")
    cAstAppend(out, unsupportedJson)
    cAstAppend(out, ",\"runtimeRequirements\":[]")
    cAstAppend(out, ",\"externalSymbols\":[]")
    if isComplete:
        cAstAppend(out, ",\"entryRoots\":")
        cAstAppend(out, cAstEntryRootsJson(build.closedFunctions, build.closedWorldKind))
    else:
        cAstAppend(out, ",\"entryRoots\":[]")
    cAstAppend(out, ",\"closedWorldKind\":")
    cAstAppend(out, cAstJsonQuote(build.closedWorldKind))
    cAstAppend(out, ",\"completionScope\":\"closed-subset-only\"")
    cAstAppend(out, ",\"target\":")
    cAstAppend(out, cAstJsonQuote(target))
    cAstAppend(out, ",\"closedSubset\":")
    cAstAppend(out, cAstJsonQuote(cAstClosedSubsetName(build.closedWorldKind, isComplete, build.globals.len > 0)))
    cAstAppend(out, ",\"closedReturn\":")
    if build.closedReturnSet:
        cAstAppend(out, strings.IntToStr(build.closedReturn))
    else:
        cAstAppend(out, "null")
    cAstAppend(out, ",\"closedStatements\":")
    cAstAppend(out, cAstStatementsJson(build.closedStatements))
    cAstAppend(out, ",\"closedFunctions\":")
    cAstAppend(out, cAstClosedFunctionsJson(build.closedFunctions))
    cAstAppend(out, ",\"closedGlobals\":")
    cAstAppend(out, cAstGlobalsJson(build.globals))
    cAstAppend(out, ",\"unsupportedCodes\":")
    cAstAppend(out, cAstJsonStringArray(build.unsupportedCodes))
    if reason.len > 0:
        cAstAppend(out, ",\"reason\":")
        cAstAppend(out, cAstJsonQuote(reason))
    cAstAppend(out, "}\n")
    return out

fn cAstEmptyFailureReport(reason: str): str =
    var build: CBuildResult
    var profiles: str[]
    build.closedWorldKind = "unknown"
    return cAstReportJson(
        build, reason, "", "", false, "", profiles, "")

fn cAstWriteText(path: str, text: str) =
    let parent = os.ParentDir(path)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    os.WriteFile(path, text)

fn cAstValidateConfig(cfg: CEmitConfig): str =
    if cfg.oracleJsonIn.len > 0:
        if cfg.target.len == 0:
            return "c-csg pure AST emitter requires --target"
        if cfg.outPath.len == 0 || cfg.reportOut.len == 0:
            return "c-csg pure AST emitter requires --out and --report-out"
        return ""
    if cfg.astJsonIn.len == 0 || cfg.source.len == 0 || cfg.displayPath.len == 0 || cfg.target.len == 0:
        return "c-csg pure AST emitter requires --clang-ast-json or --oracle-json, plus --source, --display-path and --target for single AST mode"
    if cfg.outPath.len == 0 || cfg.reportOut.len == 0:
        return "c-csg pure AST emitter requires --out and --report-out"
    return ""

fn cAstRun(cfg: CEmitConfig): int32 =
    let configError = cAstValidateConfig(cfg)
    if configError.len > 0:
        if cfg.reportOut.len > 0:
            cAstWriteText(cfg.reportOut, cAstEmptyFailureReport(configError))
        os.WriteLine(os.Get_stderr(), cAstCat("error: ", configError))
        return 2
    if cfg.oracleJsonIn.len > 0:
        var oracleRead: Result[str] = os.ReadFileResult(cfg.oracleJsonIn)
        if result.IsErr(oracleRead):
            cAstWriteText(cfg.reportOut, cAstEmptyFailureReport("failed to read C oracle JSON"))
            os.WriteLine(os.Get_stderr(), "error: failed to read C oracle JSON")
            return 1
        var projectBuild = cAstBuildProjectFacts(result.Value(oracleRead), cfg)
        let projectValidation =
            csg.CsgCoreProductionAdmitFactLines(
                projectBuild.facts)
        var projectReason: str
        if !projectValidation.valid || !projectValidation.complete:
            projectBuild.complete = false
            projectReason = "generated C project facts failed csg_core validation"
        cAstWriteText(cfg.outPath, cAstFactsText(projectBuild.facts))
        cAstWriteText(
            cfg.reportOut,
            cAstReportJson(
                projectBuild,
                projectReason,
                cfg.target,
                cfg.toolImplementation,
                projectValidation.valid &&
                    projectValidation.complete,
                projectValidation.factsRoot,
                projectValidation.profiles,
                projectValidation.profileSetCid))
        if projectValidation.valid && projectValidation.complete:
            return 0
        return 1
    var astRead: Result[str] = os.ReadFileResult(cfg.astJsonIn)
    if result.IsErr(astRead):
        cAstWriteText(cfg.reportOut, cAstEmptyFailureReport("failed to read clang AST JSON"))
        os.WriteLine(os.Get_stderr(), "error: failed to read clang AST JSON")
        return 1
    var sourceRead: Result[str] = os.ReadFileResult(cfg.source)
    if result.IsErr(sourceRead):
        cAstWriteText(cfg.reportOut, cAstEmptyFailureReport("failed to read C source"))
        os.WriteLine(os.Get_stderr(), "error: failed to read C source")
        return 1
    let astRoot = result.Value(astRead)
    let sourceText = result.Value(sourceRead)
    var build = cAstBuildFacts(astRoot, sourceText, cfg)
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            build.facts)
    var reason: str
    if !validation.valid || !validation.complete:
        build.complete = false
        reason = "generated C facts failed csg_core validation"
    cAstWriteText(cfg.outPath, cAstFactsText(build.facts))
    cAstWriteText(
        cfg.reportOut,
        cAstReportJson(
            build,
            reason,
            cfg.target,
            cfg.toolImplementation,
            validation.valid && validation.complete,
            validation.factsRoot,
            validation.profiles,
            validation.profileSetCid))
    if validation.valid && validation.complete:
        return 0
    return 1

fn cAstUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: c_csg_ast_emit emit (--oracle-json <oracle.json> | --clang-ast-json <ast.json> --source <source.c> --display-path <path>) --target <triple> --out out.csgcore --report-out report.json")
    return 2

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return cAstUsage()
    if cmdline.ParamStr(1) != "emit":
        return cAstUsage()
    var cfg: CEmitConfig
    cfg.astJsonIn = cAstOwn(cmdline.ReadFlagOrDefault("--clang-ast-json", ""))
    cfg.oracleJsonIn = cAstOwn(cmdline.ReadFlagOrDefault("--oracle-json", ""))
    cfg.source = cAstOwn(cmdline.ReadFlagOrDefault("--source", ""))
    cfg.displayPath = cAstOwn(cmdline.ReadFlagOrDefault("--display-path", ""))
    cfg.target = cAstOwn(cmdline.ReadFlagOrDefault("--target", ""))
    cfg.outPath = cAstOwn(cmdline.ReadFlagOrDefault("--out", ""))
    cfg.reportOut = cAstOwn(cmdline.ReadFlagOrDefault("--report-out", ""))
    cfg.structuralUnsupported = cAstOwn(cmdline.ReadFlagOrDefault("--structural-unsupported", ""))
    cfg.toolImplementation = cAstOwn(cmdline.ReadFlagOrDefault("--tool-implementation", ""))
    return cAstRun(cfg)
