import std/cmdline
import std/os
import std/result
import std/strings
import cheng/codex/std/process
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/validator as csg

type
    ProveCase =
        name: str
        args: str[]
        env: str[]
        filePaths: str[]
        fileContents: str[]

    ProveRun =
        ok: bool
        exitCode: int32
        stdout: str
        stderr: str
        tree: str
        error: str

    ProveCaseResult =
        name: str
        same: bool
        original: ProveRun
        cheng: ProveRun

    ProvePlan =
        ok: bool
        error: str
        cases: ProveCase[]

fn proveCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn proveAppend(out: var str, piece: str) =
    out = proveCat(out, piece)

fn proveOwn(raw: str): str =
    return strings.ConcatStr("", raw)

fn proveIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

fn proveSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && proveIsWs(text[i]):
        i = i + 1
    return i

fn proveTrimRaw(text: str): str =
    var start: int32 = proveSkipWs(text, 0)
    if start >= text.len:
        return ""
    var finish: int32 = text.len
    while finish > start && proveIsWs(text[finish - 1]):
        finish = finish - 1
    return strings.SliceBytes(text, start, finish - start)

fn proveSkipJsonString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

fn proveSkipJsonValue(text: str, start: int32): int32 =
    var i: int32 = proveSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let endPos = proveSkipJsonString(text, i)
        if endPos < 0:
            return text.len
        return endPos
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = proveSkipJsonString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn proveJsonDecodeString(text: str, quotePos: int32, afterQuote: int32, out: var str, error: var str): bool =
    out = ""
    if quotePos < 0 || afterQuote <= quotePos || afterQuote > text.len || text[quotePos] != '"':
        error = "expected JSON string"
        return false
    let closeQuote = afterQuote - 1
    var i: int32 = quotePos + 1
    while i < closeQuote:
        let ch = text[i]
        if ch == '\\':
            i = i + 1
            if i >= closeQuote:
                error = "unterminated JSON string escape"
                return false
            let esc = text[i]
            if esc == '"' || esc == '\\' || esc == '/':
                proveAppend(out, strings.CharToStr(esc))
            elif esc == 'n':
                proveAppend(out, "\n")
            elif esc == 'r':
                proveAppend(out, "\r")
            elif esc == 't':
                proveAppend(out, "\t")
            else:
                error = "unsupported JSON string escape"
                return false
        else:
            proveAppend(out, strings.CharToStr(ch))
        i = i + 1
    return true

fn proveJsonStringNameEquals(text: str, quotePos: int32, afterQuote: int32, expected: str): bool =
    let size = afterQuote - quotePos - 2
    if size != expected.len:
        return false
    for i in 0..<size:
        if text[quotePos + 1 + i] != expected[i]:
            return false
    return true

fn proveObjectRawField(rawObject: str, key: str, out: var str): bool =
    let raw = proveTrimRaw(rawObject)
    var i: int32
    if raw.len < 2 || raw[0] != '{':
        return false
    i = 1
    while i < raw.len:
        i = proveSkipWs(raw, i)
        if i >= raw.len || raw[i] == '}':
            return false
        if raw[i] == ',':
            i = i + 1
            continue
        if raw[i] != '"':
            return false
        let keyEnd = proveSkipJsonString(raw, i)
        if keyEnd < 0:
            return false
        let matched = proveJsonStringNameEquals(raw, i, keyEnd, key)
        var valueStart = proveSkipWs(raw, keyEnd)
        if valueStart >= raw.len || raw[valueStart] != ':':
            return false
        valueStart = proveSkipWs(raw, valueStart + 1)
        let valueEnd = proveSkipJsonValue(raw, valueStart)
        if valueEnd <= valueStart:
            return false
        if matched:
            out = proveOwn(strings.SliceBytes(raw, valueStart, valueEnd - valueStart))
            return true
        i = valueEnd
    return false

fn proveObjectStringField(rawObject: str, key: str, out: var str, error: var str): bool =
    var rawValue: str
    if !proveObjectRawField(rawObject, key, rawValue):
        return false
    let raw = proveTrimRaw(rawValue)
    if raw.len < 2 || raw[0] != '"':
        error = proveCat("expected string field: ", key)
        return false
    let valueEnd = proveSkipJsonString(raw, 0)
    if valueEnd != raw.len:
        error = proveCat("malformed string field: ", key)
        return false
    return proveJsonDecodeString(raw, 0, valueEnd, out, error)

fn proveTopRaw(text: str, key: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(text, key)
    if !got.found:
        return false
    out = got.value
    return true

fn proveParseBoolField(text: str, key: str, error: var str): bool =
    var raw: str
    if !proveTopRaw(text, key, raw):
        return false
    let value = proveTrimRaw(raw)
    if value == "false":
        return false
    if value == "true":
        return true
    error = proveCat("manifest field must be boolean: ", key)
    return false

fn proveParseStringArray(rawArray: str, out: var str[], error: var str): bool =
    let raw = proveTrimRaw(rawArray)
    out = []
    if raw.len < 2 || raw[0] != '[':
        error = "expected JSON string array"
        return false
    var pos: int32 = 1
    while true:
        pos = proveSkipWs(raw, pos)
        if pos >= raw.len:
            error = "unterminated JSON string array"
            return false
        if raw[pos] == ']':
            return true
        if raw[pos] != '"':
            error = "expected string in JSON array"
            return false
        let endPos = proveSkipJsonString(raw, pos)
        if endPos < 0:
            error = "malformed string in JSON array"
            return false
        var value: str
        if !proveJsonDecodeString(raw, pos, endPos, value, error):
            return false
        add(out, value)
        pos = proveSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            continue
        if pos < raw.len && raw[pos] == ']':
            return true
        error = "malformed JSON array separator"
        return false
    return false

fn provePathSafe(path: str): bool =
    if path.len == 0:
        return false
    if path[0] == '/' || path[0] == '\\':
        return false
    if path == "..":
        return false
    if strings.HasPrefix(path, "../") || strings.HasSuffix(path, "/..") || strings.StrContains(path, "/../"):
        return false
    if strings.StrContains(path, "\\"):
        return false
    return true

fn proveParseStringMap(rawObject: str, keys: var str[], values: var str[], error: var str): bool =
    let raw = proveTrimRaw(rawObject)
    keys = []
    values = []
    if raw.len < 2 || raw[0] != '{':
        error = "expected JSON object"
        return false
    var pos: int32 = 1
    while true:
        pos = proveSkipWs(raw, pos)
        if pos >= raw.len:
            error = "unterminated JSON object"
            return false
        if raw[pos] == '}':
            return true
        if raw[pos] != '"':
            error = "expected string key in JSON object"
            return false
        let keyEnd = proveSkipJsonString(raw, pos)
        if keyEnd < 0:
            error = "malformed JSON object key"
            return false
        var key: str
        if !proveJsonDecodeString(raw, pos, keyEnd, key, error):
            return false
        pos = proveSkipWs(raw, keyEnd)
        if pos >= raw.len || raw[pos] != ':':
            error = "expected JSON object colon"
            return false
        pos = proveSkipWs(raw, pos + 1)
        if pos >= raw.len || raw[pos] != '"':
            error = "prove manifest object values must be strings"
            return false
        let valueEnd = proveSkipJsonString(raw, pos)
        if valueEnd < 0:
            error = "malformed JSON object string value"
            return false
        var value: str
        if !proveJsonDecodeString(raw, pos, valueEnd, value, error):
            return false
        add(keys, key)
        add(values, value)
        pos = proveSkipWs(raw, valueEnd)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            continue
        if pos < raw.len && raw[pos] == '}':
            return true
        error = "malformed JSON object separator"
        return false
    return false

fn proveParseCase(rawCase: str, index: int32, out: var ProveCase, error: var str): bool =
    var name: str
    if !proveObjectStringField(rawCase, "name", name, error):
        name = proveCat("test-", strings.IntToStr(index))
    out.name = name
    var rawArgs: str
    if proveObjectRawField(rawCase, "args", rawArgs):
        if !proveParseStringArray(rawArgs, out.args, error):
            return false
    else:
        out.args = []
    var stdinText: str
    if proveObjectStringField(rawCase, "stdin", stdinText, error):
        if stdinText.len != 0:
            error = "pure Cheng prove closed subset does not support stdin yet"
            return false
    var rawEnv: str
    if proveObjectRawField(rawCase, "env", rawEnv):
        var envKeys: str[]
        var envValues: str[]
        if !proveParseStringMap(rawEnv, envKeys, envValues, error):
            return false
        out.env = []
        for i in 0..<envKeys.len:
            if strings.StrContains(envKeys[i], "="):
                error = "environment key must not contain ="
                return false
            add(out.env, proveCat(proveCat(envKeys[i], "="), envValues[i]))
    else:
        out.env = []
    var rawFiles: str
    if proveObjectRawField(rawCase, "files", rawFiles):
        if !proveParseStringMap(rawFiles, out.filePaths, out.fileContents, error):
            return false
        for i in 0..<out.filePaths.len:
            if !provePathSafe(out.filePaths[i]):
                error = "test file path must be relative and traversal-free"
                return false
    else:
        out.filePaths = []
        out.fileContents = []
    return true

fn proveParseTests(rawTests: str, cases: var ProveCase[], error: var str): bool =
    let raw = proveTrimRaw(rawTests)
    cases = []
    if raw.len < 2 || raw[0] != '[':
        error = "tests manifest must contain an array"
        return false
    var pos: int32 = 1
    var index: int32
    while true:
        pos = proveSkipWs(raw, pos)
        if pos >= raw.len:
            error = "unterminated tests array"
            return false
        if raw[pos] == ']':
            if cases.len == 0:
                error = "tests manifest must contain a non-empty tests array"
                return false
            return true
        if raw[pos] != '{':
            error = "test case must be an object"
            return false
        let endPos = proveSkipJsonValue(raw, pos)
        if endPos <= pos || endPos > raw.len:
            error = "malformed test case object"
            return false
        let rawCase = strings.SliceBytes(raw, pos, endPos - pos)
        var item: ProveCase
        if !proveParseCase(rawCase, index, item, error):
            return false
        add(cases, item)
        index = index + 1
        pos = proveSkipWs(raw, endPos)
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            continue
        if pos < raw.len && raw[pos] == ']':
            return true
        error = "malformed tests array separator"
        return false
    return false

fn proveLoadPlan(path: str): ProvePlan =
    var out: ProvePlan
    var readResult: Result[str] = os.ReadFileResult(path)
    if result.IsErr(readResult):
        out.error = "failed to read tests manifest"
        return out
    let text = result.Value(readResult)
    var error: str
    let network = proveParseBoolField(text, "network", error)
    if error.len > 0:
        out.error = error
        return out
    if network:
        out.error = "network side effects are not closed"
        return out
    let childProcess = proveParseBoolField(text, "process", error)
    if error.len > 0:
        out.error = error
        return out
    if childProcess:
        out.error = "child process side effects are not closed"
        return out
    var rawTests: str
    if !proveTopRaw(text, "tests", rawTests):
        out.error = "tests manifest must contain tests"
        return out
    if !proveParseTests(rawTests, out.cases, error):
        out.error = error
        return out
    out.ok = true
    return out

fn proveSplitRunner(runner: str, command: var str, args: var str[], error: var str): bool =
    command = ""
    args = []
    var current: str
    for i in 0..runner.len:
        var endHit: bool
        if i == runner.len:
            endHit = true
        elif runner[i] == ' ' || runner[i] == '\t':
            endHit = true
        if endHit:
            if current.len > 0:
                if command.len == 0:
                    command = current
                else:
                    add(args, current)
                current = ""
        else:
            let ch = runner[i]
            if ch == '\'' || ch == '"' || ch == '\\':
                error = "pure Cheng prove runner parser supports unquoted argv only"
                return false
            proveAppend(current, strings.CharToStr(ch))
    if command.len == 0:
        error = "empty runner command"
        return false
    return true

fn proveAppendCaseArgs(base: str[], extra: str[]): str[] =
    var out: str[]
    for i in 0..<base.len:
        add(out, strings.CloneStr(base[i]))
    for i in 0..<extra.len:
        add(out, strings.CloneStr(extra[i]))
    return out

fn proveSpawnCapture(command: str, args: str[], cwd: str, env: str[]): ProveRun =
    var out: ProveRun
    let handle = process.ProcessSpawnRaw(command, args, cwd, env)
    if !handle.ok:
        out.error = handle.error
        return out
    if handle.stdinFd >= 0:
        process.ProcessCloseFd(handle.stdinFd)
    out.stdout = process.ProcessReadFdBlocking(handle.stdoutFd, 2000)
    out.stderr = process.ProcessReadFdBlocking(handle.stderrFd, 2000)
    let exitCode = process.ProcessWait(handle.pid)
    if handle.stdoutFd >= 0:
        process.ProcessCloseFd(handle.stdoutFd)
    if handle.stderrFd >= 0:
        process.ProcessCloseFd(handle.stderrFd)
    out.exitCode = exitCode
    out.ok = out.error.len == 0
    return out

fn proveMaterializeFiles(root: str, paths: str[], contents: str[], error: var str): bool =
    if paths.len != contents.len:
        error = "file manifest path/content length mismatch"
        return false
    for i in 0..<paths.len:
        if !provePathSafe(paths[i]):
            error = "test file path must be relative and traversal-free"
            return false
        let target = os.JoinPath(root, paths[i])
        if target.len == 0:
            error = "failed to build test file path"
            return false
        let parent = os.ParentDir(target)
        if parent.len > 0:
            os.MkdirAll(parent, 493)
        var writeRes: Result[bool] = os.WriteFileResult(target, contents[i])
        if result.IsErr(writeRes):
            error = "failed to write test file"
            return false
    return true

@borrows
fn proveStringLess(a: str, b: str): bool =
    let n: int32 = if a.len < b.len: a.len else: b.len
    for i in 0..<n:
        if a[i] < b[i]:
            return true
        if a[i] > b[i]:
            return false
    return a.len < b.len

fn proveSortStrings(items: var str[]) =
    for i in 1..<items.len:
        let value = items[i]
        var j = i
        while j > 0 && proveStringLess(value, items[j - 1]):
            items[j] = items[j - 1]
            j = j - 1
        items[j] = value

fn proveTree(root: str, error: var str): str =
    var files = os.WalkDirRec(root)
    proveSortStrings(files)
    var out: str
    for i in 0..<files.len:
        let rel = os.RelativePath(files[i], root)
        var contentResult: Result[str] = os.ReadFileResult(files[i])
        if result.IsErr(contentResult):
            error = "failed to read side-effect file"
            return ""
        proveAppend(out, strings.IntToStr(rel.len))
        proveAppend(out, ":")
        proveAppend(out, rel)
        proveAppend(out, "=")
        let content = result.Value(contentResult)
        proveAppend(out, strings.IntToStr(content.len))
        proveAppend(out, ":")
        proveAppend(out, content)
        proveAppend(out, "\n")
    return out

fn proveRunCase(runner: str, item: ProveCase, cwd: str): ProveRun =
    var out: ProveRun
    var error: str
    if !proveMaterializeFiles(cwd, item.filePaths, item.fileContents, error):
        out.error = error
        return out
    var command: str
    var runnerArgs: str[]
    if !proveSplitRunner(runner, command, runnerArgs, error):
        out.error = error
        return out
    let args = proveAppendCaseArgs(runnerArgs, item.args)
    out = proveSpawnCapture(command, args, cwd, item.env)
    var treeError: str
    out.tree = proveTree(cwd, treeError)
    if treeError.len > 0:
        out.ok = false
        out.error = treeError
    return out

fn proveRunSame(a: ProveRun, b: ProveRun): bool =
    return a.exitCode == b.exitCode && a.stdout == b.stdout && a.stderr == b.stderr && a.tree == b.tree && a.ok == b.ok

fn proveJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            proveAppend(out, "\\\\")
        elif ch == '"':
            proveAppend(out, "\\\"")
        elif ch == '\n':
            proveAppend(out, "\\n")
        elif ch == '\r':
            proveAppend(out, "\\r")
        elif ch == '\t':
            proveAppend(out, "\\t")
        else:
            proveAppend(out, strings.CharToStr(ch))
    proveAppend(out, "\"")
    return out

fn proveJsonBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn proveProfilesJson(profiles: var str[]): str =
    var out: str = "["
    for i in 0..<profiles.len:
        if i > 0:
            proveAppend(out, ",")
        proveAppend(out, proveJsonQuote(profiles[i]))
    proveAppend(out, "]")
    return out

fn proveRunJson(run: ProveRun): str =
    var out: str = "{"
    proveAppend(out, "\"ok\":")
    proveAppend(out, proveJsonBool(run.ok))
    proveAppend(out, ",\"exit\":")
    proveAppend(out, strings.IntToStr(run.exitCode))
    proveAppend(out, ",\"stdout\":")
    proveAppend(out, proveJsonQuote(run.stdout))
    proveAppend(out, ",\"stderr\":")
    proveAppend(out, proveJsonQuote(run.stderr))
    proveAppend(out, ",\"tree\":")
    proveAppend(out, proveJsonQuote(run.tree))
    if run.error.len > 0:
        proveAppend(out, ",\"error\":")
        proveAppend(out, proveJsonQuote(run.error))
    proveAppend(out, "}")
    return out

fn proveReportJson(
        complete: bool,
        reason: str,
        cases: ProveCaseResult[],
        admission: var csg.CsgCoreValidationResult): str =
    let identityBound =
        admission.valid &&
        admission.complete &&
        admission.standard == csg.CsgCoreStandardIdentity() &&
        admission.profiles.len > 0 &&
        admission.profileSetCid.len > 0 &&
        admission.factsRoot.len > 0
    let reportComplete = complete && identityBound
    var out: str = "{"
    proveAppend(out, "\"schema\":\"cheng-csg.equivalence.receipt\"")
    proveAppend(out, ",\"standard\":")
    proveAppend(out, proveJsonQuote(csg.CsgCoreStandardIdentity()))
    proveAppend(out, ",\"profiles\":")
    if identityBound:
        proveAppend(out, proveProfilesJson(admission.profiles))
    else:
        proveAppend(out, "[]")
    proveAppend(out, ",\"profile_set_cid\":")
    if identityBound:
        proveAppend(out, proveJsonQuote(admission.profileSetCid))
    else:
        proveAppend(out, "\"\"")
    proveAppend(out, ",\"facts_root\":")
    if identityBound:
        proveAppend(out, proveJsonQuote(admission.factsRoot))
    else:
        proveAppend(out, "\"\"")
    proveAppend(out, ",\"toolImplementation\":\"pure-cheng\"")
    proveAppend(out, ",\"proofImplementation\":\"pure-cheng\"")
    proveAppend(out, ",\"completionScope\":\"closed-subset-process-stdout-stderr-exit-filetree.v1\"")
    proveAppend(out, ",\"fullProjectTranspilationComplete\":false")
    proveAppend(out, ",\"complete\":")
    proveAppend(out, proveJsonBool(reportComplete))
    if reason.len > 0:
        proveAppend(out, ",\"reason\":")
        proveAppend(out, proveJsonQuote(reason))
    proveAppend(out, ",\"caseCount\":")
    proveAppend(out, strings.IntToStr(cases.len))
    proveAppend(out, ",\"cases\":[")
    for i in 0..<cases.len:
        if i > 0:
            proveAppend(out, ",")
        proveAppend(out, "{")
        proveAppend(out, "\"name\":")
        proveAppend(out, proveJsonQuote(cases[i].name))
        proveAppend(out, ",\"same\":")
        proveAppend(out, proveJsonBool(cases[i].same))
        proveAppend(out, ",\"original\":")
        proveAppend(out, proveRunJson(cases[i].original))
        proveAppend(out, ",\"cheng\":")
        proveAppend(out, proveRunJson(cases[i].cheng))
        proveAppend(out, "}")
    proveAppend(out, "]}")
    return out

fn proveUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: cheng_csg_prove prove --facts <facts> --original <runner> --cheng <runner> --tests <manifest> --out <receipt>")
    return 2

fn proveRun(): int32 =
    let factsPath = proveOwn(cmdline.ReadFlagOrDefault("--facts", ""))
    let original = proveOwn(cmdline.ReadFlagOrDefault("--original", ""))
    let cheng = proveOwn(cmdline.ReadFlagOrDefault("--cheng", ""))
    let tests = proveOwn(cmdline.ReadFlagOrDefault("--tests", ""))
    let outPath = proveOwn(cmdline.ReadFlagOrDefault("--out", ""))
    if factsPath.len == 0 || original.len == 0 || cheng.len == 0 || tests.len == 0 || outPath.len == 0:
        return proveUsage()
    var admission: csg.CsgCoreValidationResult
    var factsRead: Result[str] = os.ReadFileResult(factsPath)
    if result.IsErr(factsRead):
        os.WriteFile(
            outPath,
            proveReportJson(
                false,
                "failed to read canonical facts",
                [],
                admission))
        os.WriteLine(os.Get_stderr(), "error: failed to read canonical facts")
        return 1
    admission =
        csg.CsgCoreProductionAdmitFactLines(
            jsonl.CsgCoreJsonlSplitLines(
                result.Value(factsRead)))
    if !admission.valid || !admission.complete:
        var rejected: csg.CsgCoreValidationResult
        os.WriteFile(
            outPath,
            proveReportJson(
                false,
                "facts failed canonical production admission",
                [],
                rejected))
        os.WriteLine(os.Get_stderr(), "error: facts failed canonical production admission")
        return 1
    let plan = proveLoadPlan(tests)
    var results: ProveCaseResult[]
    if !plan.ok:
        os.WriteFile(
            outPath,
            proveReportJson(
                false, plan.error, results, admission))
        os.WriteLine(os.Get_stderr(), proveCat("error: ", plan.error))
        return 1
    let workRoot = proveCat(outPath, ".work")
    if os.DirExists(workRoot):
        os.WriteFile(
            outPath,
            proveReportJson(
                false,
                "prove work directory already exists",
                results,
                admission))
        os.WriteLine(os.Get_stderr(), "error: prove work directory already exists")
        return 1
    os.MkdirAll(workRoot, 493)
    var allSame: bool = true
    for i in 0..<plan.cases.len:
        let originalCwd = os.JoinPath(workRoot, proveCat("original-", strings.IntToStr(i)))
        let chengCwd = os.JoinPath(workRoot, proveCat("cheng-", strings.IntToStr(i)))
        os.MkdirAll(originalCwd, 493)
        os.MkdirAll(chengCwd, 493)
        var item: ProveCaseResult
        item.name = plan.cases[i].name
        item.original = proveRunCase(original, plan.cases[i], originalCwd)
        item.cheng = proveRunCase(cheng, plan.cases[i], chengCwd)
        item.same = proveRunSame(item.original, item.cheng)
        if !item.same:
            allSame = false
        add(results, item)
    os.WriteFile(
        outPath,
        proveReportJson(allSame, "", results, admission))
    if !allSame:
        return 1
    return 0

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return proveUsage()
    let command = cmdline.ParamStr(1)
    if command != "prove":
        return proveUsage()
    return proveRun()
