import std/cmdline
import std/os
import std/result
import std/strings
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/validator as csg

type
    EmitConfig =
        language: str
        factsIn: str
        bootstrapReportIn: str
        reportOut: str

@borrows
fn emitCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn emitAppend(out: var str, piece: str) =
    out = emitCat(out, piece)

fn emitOwn(raw: str): str =
    return strings.ConcatStr("", raw)

@borrows
fn emitJsonQuote(value: str): str =
    var out: str = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '\\':
            emitAppend(out, "\\\\")
        elif ch == '"':
            emitAppend(out, "\\\"")
        elif ch == '\n':
            emitAppend(out, "\\n")
        elif ch == '\r':
            emitAppend(out, "\\r")
        elif ch == '\t':
            emitAppend(out, "\\t")
        else:
            emitAppend(out, strings.CharToStr(ch))
    emitAppend(out, "\"")
    return out

@borrows
fn emitTopRaw(text: str, key: str, out: var str): bool =
    let got = field.CsgCoreJsonTopRawField(text, key)
    if !got.found:
        return false
    out = got.value
    return true

@borrows
fn emitTopString(text: str, key: str, out: var str): bool =
    let got = field.CsgCoreJsonTopStringField(text, key)
    if !got.found:
        return false
    out = got.value
    return true

@borrows
fn emitAppendRawField(out: var str, key: str, rawValue: str) =
    emitAppend(out, ",")
    emitAppend(out, emitJsonQuote(key))
    emitAppend(out, ":")
    emitAppend(out, rawValue)

@borrows
fn emitAppendStringField(out: var str, key: str, value: str) =
    emitAppendRawField(out, key, emitJsonQuote(value))

@borrows
fn emitAppendOptionalRawField(out: var str, rawReport: str, key: str) =
    var rawValue: str
    if emitTopRaw(rawReport, key, rawValue):
        emitAppendRawField(out, key, rawValue)

@borrows
fn emitAppendRequiredRawField(out: var str, rawReport: str, key: str) =
    var rawValue: str
    if emitTopRaw(rawReport, key, rawValue):
        emitAppendRawField(out, key, rawValue)

fn emitProfilesJson(profiles: var str[]): str =
    var out: str = "["
    for i in 0..<profiles.len:
        if i > 0:
            emitAppend(out, ",")
        emitAppend(out, emitJsonQuote(profiles[i]))
    emitAppend(out, "]")
    return out

@borrows
fn emitExtractorImplementation(language: str): str =
    if language == "c":
        return "legacy-clang-ast-report-wrapper"
    return "legacy-cpython-oracle-report-wrapper"

@borrows
fn emitDialect(language: str): str =
    if language == "c":
        return "csg_dialect::c"
    return "csg_dialect::python"

@borrows
fn emitBootstrapReportValid(
        rawReport: str,
        admission: var csg.CsgCoreValidationResult): bool =
    if !admission.valid ||
       !admission.complete ||
       admission.standard != csg.CsgCoreStandardIdentity() ||
       admission.profiles.len == 0 ||
       admission.profileSetCid.len == 0 ||
       admission.factsRoot.len == 0:
        return false
    var standard: str
    if !emitTopString(rawReport, "standard", standard) ||
       standard != admission.standard:
        return false
    var rawValue: str
    if !emitTopRaw(rawReport, "complete", rawValue) ||
       rawValue != "true":
        return false
    if emitTopRaw(rawReport, "factsRoot", rawValue):
        return false
    var value: str
    if !emitTopString(rawReport, "facts_root", value) ||
       value != admission.factsRoot:
        return false
    if !emitTopString(
           rawReport,
           "profile_set_cid",
           value) ||
       value != admission.profileSetCid:
        return false
    if !emitTopRaw(rawReport, "profiles", rawValue) ||
       rawValue != emitProfilesJson(admission.profiles):
        return false
    for key in [
        "counts",
        "unsupported",
        "runtimeRequirements",
        "externalSymbols",
        "entryRoots"
    ]:
        if !emitTopRaw(rawReport, key, rawValue):
            return false
    return true

@borrows
fn emitAppendCommonIdentity(
        out: var str,
        cfg: EmitConfig,
        admission: var csg.CsgCoreValidationResult,
        admitted: bool) =
    emitAppend(out, "\"schema\":\"csg-core.report\"")
    emitAppendStringField(
        out,
        "standard",
        csg.CsgCoreStandardIdentity())
    if admitted:
        emitAppendRawField(
            out,
            "profiles",
            emitProfilesJson(admission.profiles))
        emitAppendStringField(
            out,
            "profile_set_cid",
            admission.profileSetCid)
        emitAppendStringField(
            out,
            "facts_root",
            admission.factsRoot)
    else:
        emitAppendRawField(out, "profiles", "[]")
        emitAppendStringField(out, "profile_set_cid", "")
        emitAppendStringField(out, "facts_root", "")
    emitAppendStringField(out, "dialect", emitDialect(cfg.language))
    emitAppendStringField(out, "toolImplementation", "python-bootstrap-dispatch")
    emitAppendStringField(out, "reportControllerImplementation", "pure-cheng")
    emitAppendStringField(out, "extractorImplementation", emitExtractorImplementation(cfg.language))
    emitAppendStringField(out, "extractorOracle", "python-bootstrap")
    emitAppendRawField(out, "pureChengToolchainComplete", "false")
    emitAppendRawField(out, "fullProjectTranspilationComplete", "false")
    if cfg.language == "c":
        emitAppendRawField(out, "toolchainGaps", "[\"legacy c report normalization path only; default c-csg facts are emitted by pure Cheng AST emitter\",\"full C project semantics are not complete\"]")
    else:
        emitAppendRawField(out, "toolchainGaps", "[\"legacy python report normalization path only; default py-csg facts are emitted by pure Cheng CPython oracle emitter\",\"full Python project semantics are not complete\"]")

@borrows
fn emitReportFromBootstrap(
        cfg: EmitConfig,
        rawReport: str,
        admission: var csg.CsgCoreValidationResult): str =
    var out: str = "{"
    emitAppendCommonIdentity(out, cfg, admission, true)
    emitAppendRawField(out, "complete", "true")
    emitAppendRequiredRawField(out, rawReport, "counts")
    emitAppendRequiredRawField(out, rawReport, "unsupported")
    emitAppendRequiredRawField(out, rawReport, "runtimeRequirements")
    emitAppendRequiredRawField(out, rawReport, "externalSymbols")
    emitAppendRequiredRawField(out, rawReport, "entryRoots")
    emitAppendOptionalRawField(out, rawReport, "closedWorldKind")
    emitAppendOptionalRawField(out, rawReport, "completionScope")
    emitAppendOptionalRawField(out, rawReport, "target")
    emitAppendOptionalRawField(out, rawReport, "pythonVersion")
    emitAppendOptionalRawField(out, rawReport, "closedSubset")
    emitAppendOptionalRawField(out, rawReport, "closedReturn")
    emitAppendOptionalRawField(out, rawReport, "closedStatements")
    emitAppendOptionalRawField(out, rawReport, "closedFunctions")
    emitAppendOptionalRawField(out, rawReport, "unsupportedCodes")
    emitAppend(out, "}\n")
    return out

fn emitFailureReport(cfg: EmitConfig, reason: str): str =
    var admission: csg.CsgCoreValidationResult
    var out: str = "{"
    emitAppendCommonIdentity(out, cfg, admission, false)
    emitAppendRawField(out, "complete", "false")
    emitAppendStringField(out, "failedStep", "report-controller")
    emitAppendStringField(out, "reason", reason)
    emitAppendRawField(out, "counts", "{\"factCount\":0,\"unsupported\":0,\"runtimeRequirements\":0,\"externalSymbols\":0}")
    emitAppendRawField(out, "unsupported", "[]")
    emitAppendRawField(out, "runtimeRequirements", "[]")
    emitAppendRawField(out, "externalSymbols", "[]")
    emitAppendRawField(out, "entryRoots", "[]")
    emitAppend(out, "}\n")
    return out

fn emitWriteReport(path: str, text: str) =
    let parent = os.ParentDir(path)
    if parent.len > 0:
        os.MkdirAll(parent, 493)
    os.WriteFile(path, text)

fn emitValidateConfig(cfg: EmitConfig): str =
    if cfg.language != "c" && cfg.language != "python":
        return "emit report controller requires --language c or python"
    if cfg.factsIn.len == 0 ||
       cfg.bootstrapReportIn.len == 0 ||
       cfg.reportOut.len == 0:
        return "emit report controller requires --facts-in, --bootstrap-report-in and --report-out"
    return ""

fn emitRun(cfg: EmitConfig): int32 =
    let configError = emitValidateConfig(cfg)
    if configError.len > 0:
        if cfg.reportOut.len > 0:
            emitWriteReport(cfg.reportOut, emitFailureReport(cfg, configError))
        os.WriteLine(os.Get_stderr(), emitCat("error: ", configError))
        return 2
    var readResult: Result[str] = os.ReadFileResult(cfg.bootstrapReportIn)
    if result.IsErr(readResult):
        emitWriteReport(cfg.reportOut, emitFailureReport(cfg, "extractor bootstrap report missing"))
        os.WriteLine(os.Get_stderr(), "error: extractor bootstrap report missing")
        return 1
    var factsRead: Result[str] = os.ReadFileResult(cfg.factsIn)
    if result.IsErr(factsRead):
        emitWriteReport(
            cfg.reportOut,
            emitFailureReport(cfg, "canonical facts missing"))
        os.WriteLine(os.Get_stderr(), "error: canonical facts missing")
        return 1
    var admission =
        csg.CsgCoreProductionAdmitFactLines(
            jsonl.CsgCoreJsonlSplitLines(
                result.Value(factsRead)))
    let rawReport = result.Value(readResult)
    if !emitBootstrapReportValid(rawReport, admission):
        emitWriteReport(cfg.reportOut, emitFailureReport(cfg, "extractor bootstrap report malformed"))
        os.WriteLine(os.Get_stderr(), "error: extractor bootstrap report malformed")
        return 1
    emitWriteReport(
        cfg.reportOut,
        emitReportFromBootstrap(cfg, rawReport, admission))
    return 0

fn emitUsage(): int32 =
    os.WriteLine(os.Get_stderr(), "usage: lang_csg_emit emit --language c|python --facts-in <facts> --bootstrap-report-in <report> --report-out <report>")
    return 2

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        return emitUsage()
    if cmdline.ParamStr(1) != "emit":
        return emitUsage()
    var cfg: EmitConfig
    cfg.language = emitOwn(cmdline.ReadFlagOrDefault("--language", ""))
    cfg.factsIn = emitOwn(cmdline.ReadFlagOrDefault("--facts-in", ""))
    cfg.bootstrapReportIn = emitOwn(cmdline.ReadFlagOrDefault("--bootstrap-report-in", ""))
    cfg.reportOut = emitOwn(cmdline.ReadFlagOrDefault("--report-out", ""))
    return emitRun(cfg)
