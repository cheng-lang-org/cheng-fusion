import std/result
import std/rawbytes
import std/strings
import std/strformat
import cheng/core/tooling/path as chengpath
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/riscv64_encode as rvenc

const
    ELFCLASS32 = uint64(1)
    ELFDATA2LSB = uint64(1)
    EV_CURRENT = uint64(1)
    EM_RISCV = uint64(243)
    ET_REL = uint64(1)

    SHT_NULL = int32(0)
    SHT_PROGBITS = int32(1)
    SHT_SYMTAB = int32(2)
    SHT_STRTAB = int32(3)
    SHT_RELA = int32(4)

    SHF_WRITE = int32(0x1)
    SHF_ALLOC = int32(0x2)
    SHF_EXECINSTR = int32(0x4)

    STB_LOCAL = uint64(0)
    STB_GLOBAL = uint64(1)
    STT_NOTYPE = uint64(0)
    STT_OBJECT = uint64(1)
    STT_FUNC = uint64(2)

    R_RISCV_32 = uint64(1)
    R_RISCV_CALL = uint64(18)
    R_RISCV_PCREL_HI20 = uint64(23)
    R_RISCV_PCREL_LO12_I = uint64(24)

    ELF32_HDR_SIZE = 52
    ELF32_SHDR_SIZE = 40
    ELF32_SYM_SIZE = 16
    ELF32_RELA_SIZE = 12

type
    ElfRv32WriterResult =
        objectPath: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32

fn elf32Align(value: int32, align: int32): int32 =
    if align <= 1:
        return value
    let mask = align - 1
    return (value + mask) & (0 - align)

@borrows
fn elf32WriteCString(buf: var obuf.ObjectBuffer,
                     text: str) =
    var i: int32
    while i < len(text):
        obuf.ObjectBufferWriteU8(buf, int32(text[i]) & 255)
        i = i + 1
    obuf.ObjectBufferWriteU8(buf, 0)

fn elf32WriteShdr(buf: var obuf.ObjectBuffer,
                  nameOff: int32,
                  shType: int32,
                  flags: int32,
                  shOffset: int32,
                  shSize: int32,
                  link: int32,
                  info: int32,
                  addralign: int32,
                  entsize: int32) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(shType))
    obuf.ObjectBufferWriteU32LE(buf, uint64(flags))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU32LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU32LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(link))
    obuf.ObjectBufferWriteU32LE(buf, uint64(info))
    obuf.ObjectBufferWriteU32LE(buf, uint64(addralign))
    obuf.ObjectBufferWriteU32LE(buf, uint64(entsize))

fn elf32RiscvRelocType(kind: orel.ObjectRelocKind): Result[int64] =
    if kind == orel.ObjectRelocAbs64:
        return Err[int64](" elf riscv32 object writer: abs64 is not RV32")
    if kind == orel.ObjectRelocAbs32:
        return Ok[int64](int64(R_RISCV_32))
    if kind == orel.ObjectRelocRiscvCall:
        return Ok[int64](int64(R_RISCV_CALL))
    if kind == orel.ObjectRelocBranch26:
        return Err[int64](
            " elf riscv32 object writer: aarch64 branch26 is not a RISC-V call")
    if kind == orel.ObjectRelocPage21:
        return Ok[int64](int64(R_RISCV_PCREL_HI20))
    if kind == orel.ObjectRelocPageOff12:
        return Ok[int64](int64(R_RISCV_PCREL_LO12_I))
    return Err[int64](" elf riscv32 object writer: unsupported relocation kind")

fn elf32WriteSym(buf: var obuf.ObjectBuffer,
                 nameOff: int32,
                 info: uint64,
                 shndx: int32,
                 value: int32,
                 size: int32) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(value))
    obuf.ObjectBufferWriteU32LE(buf, uint64(size))
    obuf.ObjectBufferWriteU8(buf, int32(info & uint64(255)))
    obuf.ObjectBufferWriteU8(buf, int32((info >> 8) & uint64(255)))
    obuf.ObjectBufferWriteU16LE(buf, uint64(shndx))

fn elf32WriteRela(buf: var obuf.ObjectBuffer,
                  offset: int32,
                  info: uint32,
                  addend: int32) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(offset))
    obuf.ObjectBufferWriteU32LE(buf, uint64(info))
    obuf.ObjectBufferWriteU32LE(buf, uint64(addend))

fn ElfRv32Esp32S31ElfFlags(): uint32 =
    return rvenc.RvIsaEsp32S31ElfFlags()

fn ElfRv32IntegerElfFlags(): uint32 =
    return uint32(0)

@borrows
fn ElfRv32TextObjectBytes(text: rawbytes.Bytes,
                             symbols: osym.ObjectSymbolTable,
                             relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    var emptyData = rawbytes.EmptyBytes()
    return elfRv32Build(text, emptyData, symbols, relocs, ElfRv32Esp32S31ElfFlags())

@borrows
fn ElfRv32TextDataObjectBytes(text: rawbytes.Bytes,
                                 data: rawbytes.Bytes,
                                 symbols: osym.ObjectSymbolTable,
                                 relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    return elfRv32Build(text, data, symbols, relocs, ElfRv32Esp32S31ElfFlags())

@borrows
fn ElfRv32IntegerTextObjectBytes(text: rawbytes.Bytes,
                                    symbols: osym.ObjectSymbolTable,
                                    relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    var emptyData = rawbytes.EmptyBytes()
    return elfRv32Build(
        text, emptyData, symbols, relocs, ElfRv32IntegerElfFlags())

@borrows
fn ElfRv32IntegerTextDataObjectBytes(text: rawbytes.Bytes,
                                        data: rawbytes.Bytes,
                                        symbols: osym.ObjectSymbolTable,
                                        relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    return elfRv32Build(
        text, data, symbols, relocs, ElfRv32IntegerElfFlags())

@borrows
fn elfRv32Build(text: rawbytes.Bytes,
                   data: rawbytes.Bytes,
                   symbols: osym.ObjectSymbolTable,
                   relocs: orel.ObjectRelocTable,
                   eFlags: uint32): Result[rawbytes.Bytes] =
    let relocCount = orel.ObjectRelocsCount(relocs)
    let symbolCount = osym.ObjectSymbolsCount(symbols)
    if symbolCount <= 0:
        return Err[rawbytes.Bytes](" elf riscv32 object writer: missing symbols")

    let textSize = rawbytes.BytesLen(text)
    let dataSize = rawbytes.BytesLen(data)
    let hasData = dataSize > 0

    let textShndx = int32(1)
    var nextShndx = int32(2)
    var dataShndx = int32(0)
    if hasData:
        dataShndx = nextShndx
        nextShndx = nextShndx + 1
    if relocCount > 0:
        nextShndx = nextShndx + 1
    let symtabShndx = nextShndx
    let strtabShndx = nextShndx + 1
    let shstrtabShndx = nextShndx + 2
    let shnum = nextShndx + 3

    var strtab = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(strtab)
    obuf.ObjectBufferWriteU8(strtab, 0)
    var symNameOffs: int32[]
    for i in 0..<symbolCount:
        add(symNameOffs, obuf.ObjectBufferOffset(strtab))
        elf32WriteCString(strtab, osym.ObjectSymbolsNameAt(symbols, i))

    # Keep the ELF local-prefix contract without changing stable object
    # symbol identity. Relocations use the exact source-index mapping below.
    var symbolOrder: int32[]
    var symbolElfIndexes: int32[]
    for i in 0..<symbolCount:
        add(symbolElfIndexes, -1)
    for i in 0..<symbolCount:
        if !osym.ObjectSymbolsAt(symbols, i).global:
            add(symbolOrder, i)
    let localSymbolCount = symbolOrder.len
    for i in 0..<symbolCount:
        if osym.ObjectSymbolsAt(symbols, i).global:
            add(symbolOrder, i)
    if symbolOrder.len != symbolCount:
        return Err[rawbytes.Bytes](
            " elf riscv32 object writer: symbol order incomplete")
    for elfRow in 0..<symbolCount:
        symbolElfIndexes[symbolOrder[elfRow]] = elfRow + 1

    var shstrtab = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(shstrtab)
    obuf.ObjectBufferWriteU8(shstrtab, 0)
    var shNameOffs: int32[]
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    obuf.ObjectBufferWriteU8(shstrtab, 0)
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elf32WriteCString(shstrtab, ".text")
    if hasData:
        add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
        elf32WriteCString(shstrtab, ".data")
    if relocCount > 0:
        add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
        elf32WriteCString(shstrtab, ".rela.text")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elf32WriteCString(shstrtab, ".symtab")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elf32WriteCString(shstrtab, ".strtab")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elf32WriteCString(shstrtab, ".shstrtab")

    let shdrBytes = shnum * ELF32_SHDR_SIZE
    let textOff = ELF32_HDR_SIZE + shdrBytes
    let dataOff = elf32Align(textOff + textSize, 4)
    let relaOff = elf32Align(dataOff + dataSize, 4)
    let symOff = elf32Align(relaOff + relocCount * ELF32_RELA_SIZE, 4)
    let strOff = symOff + (symbolCount + 1) * ELF32_SYM_SIZE
    let shstrOff = strOff + obuf.ObjectBufferLen(strtab)

    var out = obuf.ObjectBufferInit(shstrOff + obuf.ObjectBufferLen(shstrtab) + 32)
    defer:
        obuf.ObjectBufferRelease(out)

    obuf.ObjectBufferWriteU8(out, int32(0x7F))
    obuf.ObjectBufferWriteU8(out, int32(69))
    obuf.ObjectBufferWriteU8(out, int32(76))
    obuf.ObjectBufferWriteU8(out, int32(70))
    obuf.ObjectBufferWriteU8(out, int32(ELFCLASS32))
    obuf.ObjectBufferWriteU8(out, int32(ELFDATA2LSB))
    obuf.ObjectBufferWriteU8(out, int32(EV_CURRENT))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU16LE(out, ET_REL)
    obuf.ObjectBufferWriteU16LE(out, EM_RISCV)
    obuf.ObjectBufferWriteU32LE(out, EV_CURRENT)
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(ELF32_HDR_SIZE))
    obuf.ObjectBufferWriteU32LE(out, uint64(eFlags))
    obuf.ObjectBufferWriteU16LE(out, uint64(ELF32_HDR_SIZE))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(ELF32_SHDR_SIZE))
    obuf.ObjectBufferWriteU16LE(out, uint64(shnum))
    obuf.ObjectBufferWriteU16LE(out, uint64(shstrtabShndx))

    elf32WriteShdr(out, shNameOffs[0], int32(SHT_NULL), int32(0),
                   int32(0), int32(0), int32(0), int32(0), int32(0), int32(0))
    elf32WriteShdr(out, shNameOffs[1], int32(SHT_PROGBITS), int32(SHF_ALLOC | SHF_EXECINSTR),
                   textOff, textSize, int32(0), int32(0), int32(4), int32(0))
    var nextNameIdx = int32(2)
    if hasData:
        elf32WriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_PROGBITS), int32(SHF_ALLOC | SHF_WRITE),
                       dataOff, dataSize, int32(0), int32(0), int32(4), int32(0))
        nextNameIdx = nextNameIdx + 1
    if relocCount > 0:
        elf32WriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_RELA), int32(0),
                       relaOff, relocCount * ELF32_RELA_SIZE,
                       int32(symtabShndx), textShndx, int32(4), int32(ELF32_RELA_SIZE))
        nextNameIdx = nextNameIdx + 1
    elf32WriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_SYMTAB), int32(0),
                   symOff, (symbolCount + 1) * ELF32_SYM_SIZE,
                   int32(strtabShndx), localSymbolCount + 1,
                   int32(4), int32(ELF32_SYM_SIZE))
    nextNameIdx = nextNameIdx + 1
    elf32WriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_STRTAB), int32(0),
                   strOff, obuf.ObjectBufferLen(strtab),
                   int32(0), int32(0), int32(1), int32(0))
    nextNameIdx = nextNameIdx + 1
    elf32WriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_STRTAB), int32(0),
                   shstrOff, obuf.ObjectBufferLen(shstrtab),
                   int32(0), int32(0), int32(1), int32(0))

    obuf.ObjectBufferWriteBytes(out, text)
    if hasData:
        obuf.ObjectBufferAlign(out, int32(4), 0)
        obuf.ObjectBufferWriteBytes(out, data)
    if relocCount > 0:
        obuf.ObjectBufferAlign(out, int32(4), 0)
        for i in 0..<relocCount:
            let reloc = orel.ObjectRelocsAt(relocs, i)
            if reloc.symbolIndex < 0 || reloc.symbolIndex >= symbolCount:
                return Err[rawbytes.Bytes](
                    " elf riscv32 object writer: relocation symbol missing")
            let typeRes = elf32RiscvRelocType(reloc.kind)
            if !typeRes.ok:
                return Err[rawbytes.Bytes](typeRes.err.msg)
            let rType = uint32(typeRes.value)
            let mappedSymbol = symbolElfIndexes[reloc.symbolIndex]
            if mappedSymbol <= 0:
                return Err[rawbytes.Bytes](
                    " elf riscv32 object writer: relocation symbol map missing")
            let rSym = uint32(mappedSymbol)
            let info = (rSym << 8) | rType
            elf32WriteRela(out, int32(reloc.offset), info, int32(reloc.addend))

    obuf.ObjectBufferAlign(out, int32(4), 0)
    elf32WriteSym(out, int32(0), uint64(0), int32(0), int32(0), int32(0))
    for elfRow in 0..<symbolCount:
        let sourceIndex = symbolOrder[elfRow]
        let sym = osym.ObjectSymbolsAt(symbols, sourceIndex)
        var bind = STB_LOCAL
        var stType = STT_NOTYPE
        var shndx = int32(0)
        if !sym.undefined:
            stType = STT_FUNC
            if hasData && sym.sectionIndex == 1:
                shndx = dataShndx
                stType = STT_OBJECT
            else:
                shndx = textShndx
        if sym.global:
            bind = STB_GLOBAL
        let info = (bind << 4) | stType
        elf32WriteSym(
            out, symNameOffs[sourceIndex], info,
            shndx, int32(sym.offset), int32(sym.size))

    obuf.ObjectBufferWriteBuffer(out, strtab)
    obuf.ObjectBufferWriteBuffer(out, shstrtab)
    return Ok[rawbytes.Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn elfRv32WriteResult(rootDir: str,
                         outputPath: str,
                         text: rawbytes.Bytes,
                         data: rawbytes.Bytes,
                         symbols: osym.ObjectSymbolTable,
                         relocs: orel.ObjectRelocTable,
                         eFlags: uint32): Result[ElfRv32WriterResult] =
    let dataSize = rawbytes.BytesLen(data)
    var bytesRes: Result[rawbytes.Bytes]
    if dataSize > 0:
        bytesRes = elfRv32Build(text, data, symbols, relocs, eFlags)
    else:
        var emptyData = rawbytes.EmptyBytes()
        bytesRes = elfRv32Build(text, emptyData, symbols, relocs, eFlags)
    if !bytesRes.ok:
        return Err[ElfRv32WriterResult](bytesRes.err.msg)
    var bytes = bytesRes.value
    defer:
        rawbytes.BytesFree(bytes)
    let payload = rawbytes.BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[ElfRv32WriterResult](Fmt" elf riscv32 object writer: failed to write object: {outputPath}")
    var out: ElfRv32WriterResult
    out.objectPath = outputPath
    out.bytesWritten = rawbytes.BytesLen(bytes)
    out.symbolCount = osym.ObjectSymbolsCount(symbols)
    out.relocCount = orel.ObjectRelocsCount(relocs)
    return Ok[ElfRv32WriterResult](out)

@borrows
fn ElfRv32TextObjectWrite(rootDir: str,
                             outputPath: str,
                             text: rawbytes.Bytes,
                             symbols: osym.ObjectSymbolTable,
                             relocs: orel.ObjectRelocTable): Result[ElfRv32WriterResult] =
    var emptyData = rawbytes.EmptyBytes()
    return elfRv32WriteResult(
        rootDir, outputPath, text, emptyData, symbols, relocs,
        ElfRv32Esp32S31ElfFlags())

@borrows
fn ElfRv32TextDataObjectWrite(rootDir: str,
                                 outputPath: str,
                                 text: rawbytes.Bytes,
                                 data: rawbytes.Bytes,
                                 symbols: osym.ObjectSymbolTable,
                                 relocs: orel.ObjectRelocTable): Result[ElfRv32WriterResult] =
    return elfRv32WriteResult(
        rootDir, outputPath, text, data, symbols, relocs,
        ElfRv32Esp32S31ElfFlags())

@borrows
fn ElfRv32IntegerTextDataObjectWrite(
        rootDir: str,
        outputPath: str,
        text: rawbytes.Bytes,
        data: rawbytes.Bytes,
        symbols: osym.ObjectSymbolTable,
        relocs: orel.ObjectRelocTable): Result[ElfRv32WriterResult] =
    return elfRv32WriteResult(
        rootDir, outputPath, text, data, symbols, relocs,
        ElfRv32IntegerElfFlags())
