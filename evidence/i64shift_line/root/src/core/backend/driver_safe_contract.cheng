import std/strings
import std/strutils as strutil
import std/seqs
import std/system
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/target_matrix as tmat
import cheng/core/lang/parser
import cheng/core/runtime/arena as arenamod

type
    DriverSafeContractResult =
        enabled: bool
        sourceCount: int32
        publicPointerViolations: int32
        trustedAbiViolations: int32
        noAllocViolations: int32
        interruptViolations: int32
        mmioViolations: int32
        dmaViolations: int32
        firstError: str

    DriverSafeAnnotationIndex =
        routineStartLines: int32[]
        routineStartColumns: int32[]
        routineEndLines: int32[]
        routineEndColumns: int32[]
        routineTrustedAbi: bool[]
        routineNoAlloc: bool[]
        routineInterrupt: bool[]
        driverSafeProfile: bool

    DriverSafeAnnotationIndexReleaseReceipt =
        allocatedBufferCount: int32
        physicalFreeCount: int64
        liveBufferCount: int32
        retainedBytesBefore: int64
        retainedBytesAfter: int64
        storageReleased: bool

@borrows
fn DriverSafeContractLineHas(line: str, needle: str): bool =
    return strutil.Contains(line, needle)

@borrows
fn DriverSafeContractLineTopLevel(lineRaw: str): bool =
    if Len(lineRaw) <= 0:
        return false
    if lineRaw[0] == ' ' || lineRaw[0] == '\t':
        return false
    return true

@borrows
fn DriverSafeContractStartsDecl(line: str): bool =
    if strutil.StartsWith(line, "fn "):
        return true
    if strutil.StartsWith(line, "type "):
        return true
    if strutil.StartsWith(line, "var "):
        return true
    if strutil.StartsWith(line, "let "):
        return true
    if strutil.StartsWith(line, "const "):
        return true
    return false

@borrows
fn DriverSafeContractLineAnnotation(line: str): bool =
    return strutil.StartsWith(line, "@")

fn DriverSafeAnnotationIndexRelease(
        annotations: var DriverSafeAnnotationIndex) =
    seqs.freeSeq(annotations.routineStartLines)
    seqs.freeSeq(annotations.routineStartColumns)
    seqs.freeSeq(annotations.routineEndLines)
    seqs.freeSeq(annotations.routineEndColumns)
    seqs.freeSeq(annotations.routineTrustedAbi)
    seqs.freeSeq(annotations.routineNoAlloc)
    seqs.freeSeq(annotations.routineInterrupt)
    annotations = DriverSafeAnnotationIndex()

@borrows
fn DriverSafeAnnotationIndexStorageReleased(
        annotations: DriverSafeAnnotationIndex): bool =
    return annotations.routineStartLines.cap == 0 &&
           annotations.routineStartColumns.cap == 0 &&
           annotations.routineEndLines.cap == 0 &&
           annotations.routineEndColumns.cap == 0 &&
           annotations.routineTrustedAbi.cap == 0 &&
           annotations.routineNoAlloc.cap == 0 &&
           annotations.routineInterrupt.cap == 0 &&
           !annotations.driverSafeProfile

@borrows
fn DriverSafeAnnotationIndexPhysicalBufferCount(
        annotations: DriverSafeAnnotationIndex): int32 =
    var count: int32
    if annotations.routineStartLines.cap > 0:
        count = count + 1
    if annotations.routineStartColumns.cap > 0:
        count = count + 1
    if annotations.routineEndLines.cap > 0:
        count = count + 1
    if annotations.routineEndColumns.cap > 0:
        count = count + 1
    if annotations.routineTrustedAbi.cap > 0:
        count = count + 1
    if annotations.routineNoAlloc.cap > 0:
        count = count + 1
    if annotations.routineInterrupt.cap > 0:
        count = count + 1
    return count

@borrows
fn DriverSafeAnnotationIndexRetainedBytes(
        annotations: DriverSafeAnnotationIndex): int64 =
    return int64(annotations.routineStartLines.cap) *
               int64(sizeof(int32)) +
           int64(annotations.routineStartColumns.cap) *
               int64(sizeof(int32)) +
           int64(annotations.routineEndLines.cap) *
               int64(sizeof(int32)) +
           int64(annotations.routineEndColumns.cap) *
               int64(sizeof(int32)) +
           int64(annotations.routineTrustedAbi.cap) *
               int64(sizeof(bool)) +
           int64(annotations.routineNoAlloc.cap) *
               int64(sizeof(bool)) +
           int64(annotations.routineInterrupt.cap) *
               int64(sizeof(bool))

fn DriverSafeAnnotationIndexReleaseInto(
        annotations: var DriverSafeAnnotationIndex,
        receipt: var DriverSafeAnnotationIndexReleaseReceipt) =
    receipt.allocatedBufferCount =
        DriverSafeAnnotationIndexPhysicalBufferCount(annotations)
    receipt.retainedBytesBefore =
        DriverSafeAnnotationIndexRetainedBytes(annotations)
    let freeBefore = system.memFreeCount()
    DriverSafeAnnotationIndexRelease(annotations)
    receipt.physicalFreeCount = system.memFreeCount() - freeBefore
    receipt.liveBufferCount =
        DriverSafeAnnotationIndexPhysicalBufferCount(annotations)
    receipt.retainedBytesAfter =
        DriverSafeAnnotationIndexRetainedBytes(annotations)
    receipt.storageReleased =
        DriverSafeAnnotationIndexStorageReleased(annotations)
    if receipt.physicalFreeCount <
           int64(receipt.allocatedBufferCount) ||
       receipt.liveBufferCount != 0 ||
       receipt.retainedBytesAfter != int64(0) ||
       !receipt.storageReleased:
        panic("driver_safe annotation: index release receipt invalid")

fn DriverSafeNormalizedFunctionDeclsRelease(
        decls: var parser.NormalizedFunctionDecl[]) =
    for row in 0..<decls.len:
        decls[row].name = ""
        decls[row].explicitExportName = ""
        decls[row].surfaceKeyword = ""
        decls[row].ffiOutPtrArgs = ""
        decls[row].ffiOwnedResultFree = ""
    seqs.freeSeq(decls)

@borrows
fn DriverSafeContractBuildAnnotationIndexInto(
        text: str,
        out: var DriverSafeAnnotationIndex,
        err: var str): bool =
    DriverSafeAnnotationIndexRelease(out)
    var tree: parser.ParserValueExprTree
    if !parser.ParserValueExprReadTreeFromText(text, tree, err):
        parser.ParserValueExprTreeRelease(tree)
        DriverSafeAnnotationIndexRelease(out)
        return false
    if !parser.ParserValueExprTreeAnnotationsStrictValidateInto(tree, err):
        parser.ParserValueExprTreeRelease(tree)
        DriverSafeAnnotationIndexRelease(out)
        return false
    for row in 0..<tree.annotationCount:
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationNameTokenIndexes, row)
        let name = parser.ParserValueExprTokenText(tree, nameToken)
        if !parser.ParserNormalizedAnnotationRegisteredName(name):
            parser.ParserValueExprTreeRelease(tree)
            DriverSafeAnnotationIndexRelease(out)
            err = Fmt"driver_safe annotation: unregistered @{name}"
            return false
        if name == "profile":
            var profileName: str
            if !parser.ParserNormalizedAnnotationExactStringRootInto(
                   tree, row, profileName):
                parser.ParserValueExprTreeRelease(tree)
                DriverSafeAnnotationIndexRelease(out)
                err = "driver_safe annotation: invalid @profile"
                return false
            if profileName == "driver_safe":
                out.driverSafeProfile = true
    parser.ParserValueExprTreeRelease(tree)
    var decls: parser.NormalizedFunctionDecl[]
    if !parser.ParserReadNormalizedFunctionDecls(text, decls, err):
        DriverSafeNormalizedFunctionDeclsRelease(decls)
        DriverSafeAnnotationIndexRelease(out)
        return false
    var sourceLines = strutil.Split(text, '\n')
    for row in 0..<decls.len:
        let previousStartLine =
            row > 0 ? decls[row - 1].lineIndex : int32(0)
        if decls[row].lineIndex <= 0 ||
           decls[row].lineIndex <= previousStartLine ||
           decls[row].lineIndex > sourceLines.len ||
           decls[row].signatureStartColumn < 0 ||
           decls[row].signatureEndLineIndex < decls[row].lineIndex ||
           decls[row].signatureEndLineIndex > sourceLines.len ||
           decls[row].signatureStartColumn >=
               sourceLines[decls[row].lineIndex - 1].len ||
           decls[row].signatureEndColumn <= 0:
            seqs.freeSeqStrRelease(sourceLines)
            DriverSafeNormalizedFunctionDeclsRelease(decls)
            DriverSafeAnnotationIndexRelease(out)
            err = "driver_safe annotation: routine identity invalid"
            return false
        if decls[row].signatureEndColumn >
           sourceLines[decls[row].signatureEndLineIndex - 1].len:
            seqs.freeSeqStrRelease(sourceLines)
            DriverSafeNormalizedFunctionDeclsRelease(decls)
            DriverSafeAnnotationIndexRelease(out)
            err = "driver_safe annotation: routine span invalid"
            return false
        add(out.routineStartLines, decls[row].lineIndex)
        add(out.routineStartColumns, decls[row].signatureStartColumn)
        add(out.routineEndLines, decls[row].signatureEndLineIndex)
        add(out.routineEndColumns, decls[row].signatureEndColumn)
        add(out.routineTrustedAbi, decls[row].trustedAbi)
        add(out.routineNoAlloc, decls[row].noAlloc)
        add(out.routineInterrupt, decls[row].interruptHandler)
    seqs.freeSeqStrRelease(sourceLines)
    DriverSafeNormalizedFunctionDeclsRelease(decls)
    err = ""
    return true

@borrows
fn DriverSafeContractPointerSurface(line: str): bool =
    if DriverSafeContractLineHas(line, ": ptr"):
        return true
    if DriverSafeContractLineHas(line, " ptr"):
        return true
    if DriverSafeContractLineHas(line, "ptr["):
        return true
    if DriverSafeContractLineHas(line, "void*"):
        return true
    if DriverSafeContractLineHas(line, ": ref "):
        return true
    if DriverSafeContractLineHas(line, "= ref"):
        return true
    return false

@borrows
fn DriverSafeContractTrustedConstruct(line: str): bool =
    if DriverSafeContractLineHas(line, "TrustedPhysAddr("):
        return true
    if DriverSafeContractLineHas(line, "TrustedVirtAddr("):
        return true
    if DriverSafeContractLineHas(line, "TrustedMmioReg"):
        return true
    return false

@borrows
fn DriverSafeContractAllocationUse(line: str): bool =
    if DriverSafeContractLineHas(line, "new("):
        return true
    if DriverSafeContractLineHas(line, " add("):
        return true
    if DriverSafeContractLineHas(line, "\tadd("):
        return true
    if DriverSafeContractLineHas(line, "Fmt\""):
        return true
    if DriverSafeContractLineHas(line, "Fmt\"\"\""):
        return true
    if DriverSafeContractLineHas(line, "ConcatStr("):
        return true
    if DriverSafeContractLineHas(line, "Join("):
        return true
    return false

@borrows
fn DriverSafeContractBlockingUse(line: str): bool =
    if DriverSafeContractLineHas(line, "Mutex"):
        return true
    if DriverSafeContractLineHas(line, "RwLock"):
        return true
    if DriverSafeContractLineHas(line, "thread."):
        return true
    if DriverSafeContractLineHas(line, ".Read"):
        return true
    if DriverSafeContractLineHas(line, ".Write"):
        return true
    if DriverSafeContractLineHas(line, "Exec"):
        return true
    if DriverSafeContractLineHas(line, "Sleep"):
        return true
    if DriverSafeContractLineHas(line, "Yield"):
        return true
    return false

@borrows
fn DriverSafeContractMmioMisuse(line: str): bool =
    if DriverSafeContractLineHas(line, "MmioReg["):
        if DriverSafeContractLineHas(line, "str") ||
           DriverSafeContractLineHas(line, "float") ||
           DriverSafeContractLineHas(line, "bool"):
            return true
    if DriverSafeContractLineHas(line, ".raw") &&
       (DriverSafeContractLineHas(line, "PhysAddr") ||
        DriverSafeContractLineHas(line, "VirtAddr") ||
        DriverSafeContractLineHas(line, "MmioReg")):
        return true
    return false

@borrows
fn DriverSafeContractDmaMisuse(line: str): bool =
    if DriverSafeContractLineHas(line, "DmaBufferDevice") &&
       DriverSafeContractLineHas(line, ".payload"):
        return true
    if DriverSafeContractLineHas(line, "DmaDeviceRead("):
        return true
    if DriverSafeContractLineHas(line, "DmaDeviceWrite("):
        return true
    return false

fn DriverSafeContractSetFirstError(result: var DriverSafeContractResult, msg: str) =
    if Len(result.firstError) <= 0:
        result.firstError = msg

@borrows
fn DriverSafeContractAppendLine(out: var str, line: str) =
    if Len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{line}"

@borrows
fn DriverSafeContractScanSource(path: str,
                                text: str,
                                annotations: DriverSafeAnnotationIndex,
                                result: var DriverSafeContractResult) =
    if Len(text) <= 0:
        return
    var lines = strutil.Split(text, '\n')
    var inTrustedAbi = false
    var inNoAlloc = false
    var inInterrupt = false
    var routineCursor: int32
    var activeRoutineRow: int32 = -1
    for i in 0..<lines.len:
        let lineRaw = strings.CloneStr(lines[i])
        let line = strutil.Strip(lineRaw)
        if Len(line) > 0:
            let lineNumber = i + 1
            var routineRow: int32 = -1
            if routineCursor < annotations.routineStartLines.len:
                let nextRoutineLine =
                    annotations.routineStartLines[routineCursor]
                if nextRoutineLine < lineNumber:
                    panic("driver_safe annotation: routine cursor skipped")
                if nextRoutineLine == lineNumber:
                    routineRow = routineCursor
                    routineCursor = routineCursor + 1
            let startsDecl =
                DriverSafeContractLineTopLevel(lineRaw) &&
                (DriverSafeContractStartsDecl(line) || routineRow >= 0)
            if startsDecl:
                inTrustedAbi = false
                inInterrupt = false
                inNoAlloc = false
                if routineRow >= 0:
                    activeRoutineRow = routineRow
                    inTrustedAbi = annotations.routineTrustedAbi[routineRow]
                    inInterrupt = annotations.routineInterrupt[routineRow]
                    inNoAlloc = inInterrupt ||
                        annotations.routineNoAlloc[routineRow]
                else:
                    activeRoutineRow = -1
            if !DriverSafeContractLineAnnotation(line) || routineRow >= 0:
                if activeRoutineRow >= 0 &&
                   lineNumber >=
                       annotations.routineStartLines[activeRoutineRow] &&
                   lineNumber <=
                       annotations.routineEndLines[activeRoutineRow] &&
                   !inTrustedAbi:
                    var signatureStart: int32
                    var signatureEnd = lineRaw.len
                    if lineNumber ==
                       annotations.routineStartLines[activeRoutineRow]:
                        signatureStart =
                            annotations.routineStartColumns[activeRoutineRow]
                    if lineNumber ==
                       annotations.routineEndLines[activeRoutineRow]:
                        signatureEnd =
                            annotations.routineEndColumns[activeRoutineRow]
                    if signatureStart < 0 ||
                       signatureEnd < signatureStart ||
                       signatureEnd > lineRaw.len:
                        panic("driver_safe annotation: signature span invalid")
                    let signatureLine = strings.SliceBytes(
                        lineRaw,
                        signatureStart,
                        signatureEnd - signatureStart)
                    if DriverSafeContractPointerSurface(signatureLine):
                        result.publicPointerViolations =
                            result.publicPointerViolations + 1
                        DriverSafeContractSetFirstError(result, Fmt"driver_safe public raw pointer surface: {path}:{strings.IntToStr(i + 1)}")
                if DriverSafeContractTrustedConstruct(line) && !inTrustedAbi:
                    result.trustedAbiViolations = result.trustedAbiViolations + 1
                    DriverSafeContractSetFirstError(result, Fmt"driver_safe address construction outside @trusted_abi: {path}:{strings.IntToStr(i + 1)}")
                if inNoAlloc && DriverSafeContractAllocationUse(line):
                    result.noAllocViolations = result.noAllocViolations + 1
                    DriverSafeContractSetFirstError(result, Fmt"driver_safe @no_alloc allocation use: {path}:{strings.IntToStr(i + 1)}")
                if inInterrupt &&
                   (DriverSafeContractAllocationUse(line) || DriverSafeContractBlockingUse(line)):
                    result.interruptViolations = result.interruptViolations + 1
                    DriverSafeContractSetFirstError(result, Fmt"driver_safe @interrupt_handler unsafe use: {path}:{strings.IntToStr(i + 1)}")
                if DriverSafeContractMmioMisuse(line):
                    result.mmioViolations = result.mmioViolations + 1
                    DriverSafeContractSetFirstError(result, Fmt"driver_safe mmio misuse: {path}:{strings.IntToStr(i + 1)}")
                if DriverSafeContractDmaMisuse(line):
                    result.dmaViolations = result.dmaViolations + 1
                    DriverSafeContractSetFirstError(result, Fmt"driver_safe dma misuse: {path}:{strings.IntToStr(i + 1)}")
    if routineCursor != annotations.routineStartLines.len:
        panic("driver_safe annotation: routine cursor incomplete")
    seqs.freeSeqStrRelease(lines)

@borrows
fn DriverSafeContractDetectProfile(
        plan: slplan.SystemLinkPlanStub,
        annotations: DriverSafeAnnotationIndex): bool =
    if tmat.TargetIsRv64Bare(plan.targetTriple):
        return true
    return annotations.driverSafeProfile

@borrows
fn DriverSafeContractCheckEntry(rootDir: str,
                                plan: slplan.SystemLinkPlanStub,
                                entrySourcePath: str,
                                entrySourceText: str,
                                result: var DriverSafeContractResult): bool =
    rootDir
    var annotations: DriverSafeAnnotationIndex
    var releaseReceipt: DriverSafeAnnotationIndexReleaseReceipt
    var annotationErr: str
    if !DriverSafeContractBuildAnnotationIndexInto(
           strings.CloneStr(entrySourceText), annotations, annotationErr):
        DriverSafeContractSetFirstError(
            result, strings.CloneStr(annotationErr))
        DriverSafeAnnotationIndexReleaseInto(
            annotations, releaseReceipt)
        return false
    result.enabled = DriverSafeContractDetectProfile(plan, annotations)
    result.sourceCount = plan.sourceClosurePaths.len
    if !result.enabled:
        DriverSafeAnnotationIndexReleaseInto(
            annotations, releaseReceipt)
        return true
    DriverSafeContractScanSource(
        strings.CloneStr(entrySourcePath),
        strings.CloneStr(entrySourceText),
        annotations, result)
    let ok = DriverSafeContractResultOk(result)
    DriverSafeAnnotationIndexReleaseInto(
        annotations, releaseReceipt)
    return ok

@borrows
fn DriverSafeContractResultOk(result: DriverSafeContractResult): bool =
    if result.publicPointerViolations > 0:
        return false
    if result.trustedAbiViolations > 0:
        return false
    if result.noAllocViolations > 0:
        return false
    if result.interruptViolations > 0:
        return false
    if result.mmioViolations > 0:
        return false
    if result.dmaViolations > 0:
        return false
    return true

@borrows
fn DriverSafeContractAppendReport(out: var str,
                                  result: DriverSafeContractResult) =
    var enabledText = "0"
    if result.enabled:
        enabledText = "1"
    var noAllocVerified = "0"
    if result.enabled && result.noAllocViolations == 0:
        noAllocVerified = "1"
    var interruptVerified = "0"
    if result.enabled && result.interruptViolations == 0:
        interruptVerified = "1"
    DriverSafeContractAppendLine(out, Fmt"driver_safe_profile={enabledText}")
    DriverSafeContractAppendLine(out, Fmt"driver_safe_source_count={strings.IntToStr(result.sourceCount)}")
    DriverSafeContractAppendLine(out, Fmt"public_pointer_violations={strings.IntToStr(result.publicPointerViolations)}")
    DriverSafeContractAppendLine(out, Fmt"trusted_abi_violations={strings.IntToStr(result.trustedAbiViolations)}")
    DriverSafeContractAppendLine(out, Fmt"no_alloc_violations={strings.IntToStr(result.noAllocViolations)}")
    DriverSafeContractAppendLine(out, Fmt"interrupt_violations={strings.IntToStr(result.interruptViolations)}")
    DriverSafeContractAppendLine(out, Fmt"mmio_violations={strings.IntToStr(result.mmioViolations)}")
    DriverSafeContractAppendLine(out, Fmt"dma_violations={strings.IntToStr(result.dmaViolations)}")
    DriverSafeContractAppendLine(out, Fmt"no_alloc_verified={noAllocVerified}")
    DriverSafeContractAppendLine(out, Fmt"interrupt_safe_verified={interruptVerified}")
    if Len(result.firstError) > 0:
        DriverSafeContractAppendLine(out, Fmt"driver_safe_error={result.firstError}")

@borrows
fn DriverSafeContractAppendPlanReport(out: var str,
                                      rootDir: str,
                                      plan: slplan.SystemLinkPlanStub) =
    rootDir
    var result: DriverSafeContractResult
    result.enabled = tmat.TargetIsRv64Bare(plan.targetTriple)
    result.sourceCount = plan.sourceClosurePaths.len
    DriverSafeContractAppendReport(out, result)
