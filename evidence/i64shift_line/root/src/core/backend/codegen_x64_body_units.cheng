# codegen_x64_body_units.cheng —— B4 x86_64 body 布局/尺寸单元直调门面
#
# 形态裁定（B2/B3 先例：kernel-b2-20260825/evidence/language_probes/PROBES_B2.md、
# kernel-b3-20260825/B3_REPORT.md §2）：
#   - primary_object_plan 消费的 10 支 x86_64 body 布局/尺寸入口（契约要素 3
#     十一支签名中的十支布局/尺寸族；X64BodyFillWords 仍仅 tests 消费，留给
#     B6 的 A64BodyFillWords 接缝）参数/返回面含托管复合 coreir.BodyIR
#     （值参九支 + var 形参一支 X64BodyPrepareStackLayout）与含 str 字段的
#     coreir.CallOp——PROBES_B2 实测值传托管过 fn 槽在返回/释放期全线崩，
#     B1 fn 槽注册表形态不适用，依 B2 裁定走「直调表键到模块入口」；
#   - 本门面每槽一行直调转发：零间接调用、零托管过槽，字节路径与原 kernel
#     直调逐字节相同；
#   - 消费点（primary_object_plan 簇 B 7 函数）15 处调用全部位于既有
#     x86_64 gate 臂内（gate 属簇 D 策略分派面，B7 收口对象，本批不动）：
#     调用侧既有 gate 即派发键，本族仅 x86_64 单元供给，不设冗余 unitKey
#     参数（kernel-b3 B3_REPORT.md §2 单供给族同裁定）。aarch64 同族入口
#     待 B6 搬出后在同型门面/本门面扩展，届时由 gate 层查单元表派发。
#
# 归属：shared-format（跨单元安装聚合门面；先例=codegen_writer_units B2 /
# codegen_encoder_event_units B3 / coff_object_linker 的链接期 arch 钩子）。
# 契约签名冻结见 codegen_contract.cheng 要素 3（x86_64_body_emit.cheng
# :2438/:3077/:2889/:2938/:3041/:1555/:1483/:1492/:1496/:3113 行号清单）。
import cheng/core/ir/core_types as coreir
import cheng/core/backend/x86_64_body_emit as x64body

@borrows
fn CodegenX64BodyPrepareStackLayout(bodyIR: var coreir.BodyIR): bool =
    return x64body.X64BodyPrepareStackLayout(bodyIR)

@borrows
fn CodegenX64BodyIrWordCount(bodyIR: coreir.BodyIR): int32 =
    return x64body.X64BodyIrWordCount(bodyIR)

@borrows
fn CodegenX64BodyOpSizeAt(bodyIR: coreir.BodyIR, opIndex: int32): int32 =
    return x64body.X64BodyOpSizeAt(bodyIR, opIndex)

@borrows
fn CodegenX64BodyTermSize(bodyIR: coreir.BodyIR, termIndex: int32): int32 =
    return x64body.X64BodyTermSize(bodyIR, termIndex)

@borrows
fn CodegenX64BodyPrologueByteCount(bodyIR: coreir.BodyIR): int32 =
    return x64body.X64BodyPrologueByteCount(bodyIR)

@borrows
fn CodegenX64BodyCallArgWordCount(bodyIR: coreir.BodyIR, argSlot: int32, passKind: int32): int32 =
    return x64body.X64BodyCallArgWordCount(bodyIR, argSlot, passKind)

@borrows
fn CodegenX64BodyCallRegArgCount(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    return x64body.X64BodyCallRegArgCount(bodyIR, call)

@borrows
fn CodegenX64BodyCallStackArgCount(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    return x64body.X64BodyCallStackArgCount(bodyIR, call)

@borrows
fn CodegenX64BodyCallStackArgBytes(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    return x64body.X64BodyCallStackArgBytes(bodyIR, call)

@borrows
fn CodegenX64BodyRelocWordOffset(bodyIR: coreir.BodyIR, callOrdinal: int32): int32 =
    return x64body.X64BodyRelocWordOffset(bodyIR, callOrdinal)
