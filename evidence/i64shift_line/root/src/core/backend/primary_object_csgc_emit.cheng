import std/rawbytes
import cheng/core/backend/direct_object_emit as direct
import cheng/core/backend/primary_object_csgc_cargo as cargo
import cheng/core/backend/primary_object_plan as pobj

@borrows
fn primaryObjectCsgcEmitReplayBindingValid(
        plan: pobj.PrimaryObjectPlan,
        planCargo: cargo.PrimaryObjectCsgcCargo,
        replay: cargo.PrimaryObjectCsgcReplay): bool =
    return planCargo.factsRoot == planCargo.planRoot &&
        replay.factsRoot == planCargo.factsRoot &&
        replay.subgraphCid == planCargo.subgraphCid &&
        replay.planRoot == planCargo.planRoot &&
        replay.factCount == planCargo.factCount &&
        replay.targetTriple == plan.targetTriple &&
        replay.objectFormat == plan.objectFormat &&
        replay.actualBackendKind == plan.actualBackendKind &&
        replay.entrySymbol == plan.entrySymbol &&
        replay.entryFunctionSymbol == plan.entryFunctionSymbol &&
        replay.symbolCount == planCargo.symbolCount &&
        replay.relocationCount == planCargo.relocationCount

@borrows
fn PrimaryObjectCsgcEmitPlanObjectInto(
        rootDir: str,
        plan: var pobj.PrimaryObjectPlan,
        out: var direct.DirectObjectEmitResult,
        outErr: var str): bool =
    out = direct.DirectObjectEmitResult()
    outErr = ""
    var planCargo = cargo.PrimaryObjectCsgcCargoBuild(plan)
    defer:
        cargo.PrimaryObjectCsgcCargoRelease(planCargo)
    if !planCargo.ok:
        outErr = planCargo.error
        return false
    var replay = cargo.PrimaryObjectCsgcCargoReplay(
        planCargo.bytes,
        planCargo.proofBytes,
        planCargo.factsRoot,
        planCargo.targetTriple,
        planCargo.objectFormat)
    defer:
        cargo.PrimaryObjectCsgcReplayRelease(replay)
    if !replay.ok:
        outErr = replay.error
        return false
    if !primaryObjectCsgcEmitReplayBindingValid(
           plan, planCargo, replay):
        outErr = "primary object CSGC emit: replay binding mismatch"
        return false
    return direct.DirectObjectEmitCommitReplayedObjectInto(
        rootDir,
        plan,
        replay.objectBytes,
        replay.objectSha256,
        replay.objectByteCount,
        replay.symbolCount,
        replay.relocationCount,
        out,
        outErr)

@borrows
fn PrimaryObjectCsgcEmitPlanObjectBytesInto(
        plan: var pobj.PrimaryObjectPlan,
        outBytes: var rawbytes.Bytes,
        outObjectSha256: var str,
        outObjectByteCount: var int32,
        outSymbolCount: var int32,
        outRelocationCount: var int32,
        outFactsRoot: var str,
        outErr: var str): bool =
    outBytes = rawbytes.EmptyBytes()
    outObjectSha256 = ""
    outObjectByteCount = 0
    outSymbolCount = 0
    outRelocationCount = 0
    outFactsRoot = ""
    outErr = ""
    let validRes = direct.DirectObjectEmitValidatePlanObject(plan)
    if !validRes.ok:
        outErr = validRes.err.msg
        return false
    var planCargo = cargo.PrimaryObjectCsgcCargoBuild(plan)
    defer:
        cargo.PrimaryObjectCsgcCargoRelease(planCargo)
    if !planCargo.ok:
        outErr = planCargo.error
        return false
    var replay = cargo.PrimaryObjectCsgcCargoReplay(
        planCargo.bytes,
        planCargo.proofBytes,
        planCargo.factsRoot,
        planCargo.targetTriple,
        planCargo.objectFormat)
    defer:
        cargo.PrimaryObjectCsgcReplayRelease(replay)
    if !replay.ok:
        outErr = replay.error
        return false
    if !primaryObjectCsgcEmitReplayBindingValid(
           plan, planCargo, replay):
        outErr = "primary object CSGC emit: replay binding mismatch"
        return false
    if replay.objectByteCount <= 0 ||
       replay.objectByteCount != rawbytes.BytesLen(replay.objectBytes) ||
       replay.objectSha256 == "" || replay.symbolCount <= 0 ||
       replay.relocationCount < 0:
        outErr = "primary object CSGC emit: replay receipt invalid"
        return false
    if !pobj.PrimaryObjectPlanSevenStageReceiptObserveObjectBytes(
           plan, replay.objectBytes):
        outErr =
            "primary object CSGC emit: seven-stage object observation failed"
        return false
    outObjectSha256 = replay.objectSha256
    outObjectByteCount = replay.objectByteCount
    outSymbolCount = replay.symbolCount
    outRelocationCount = replay.relocationCount
    outFactsRoot = replay.factsRoot
    outBytes = rawbytes.BytesTake(replay.objectBytes)
    return true
