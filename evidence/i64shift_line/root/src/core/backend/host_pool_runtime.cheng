# host_pool_runtime — fork/pipe/waitpid 宿主原语（#75(c) / backend2 slice-11 共享）。
# 平台物理实现与 @importc 声明已收口到 provider 单元
# cheng/core/runtime/host_pool_provider；本模块只保留内核侧无指针值合同。

import std/rawbytes
import cheng/core/runtime/host_pool_provider

fn HostPoolPipe(fds: var int32[2]): int32 =
    fds[0] = -1
    fds[1] = -1
    let result = HostPoolProviderPipe()
    if result.rc != 0:
        return result.rc
    fds[0] = result.fd0
    fds[1] = result.fd1
    return 0

fn HostPoolFork(): int32 =
    return HostPoolProviderFork()

fn HostPoolWaitpid(
        pid: int32,
        status: var int32,
        options: int32): int32 =
    let result = HostPoolProviderWaitpid(pid, options)
    status = result.status
    return result.rc

fn HostPoolReadBytes(
        fd: int32,
        bytes: var rawbytes.Bytes,
        offset: int32,
        count: int32): int64 =
    return HostPoolProviderReadBytes(fd, bytes, offset, count)

fn HostPoolWriteBytes(
        fd: int32,
        bytes: var rawbytes.Bytes,
        offset: int32,
        count: int32): int64 =
    return HostPoolProviderWriteBytes(fd, bytes, offset, count)

fn HostPoolClose(fd: int32): int32 =
    return HostPoolProviderClose(fd)

fn HostPoolSignal(pid: int64, signalCode: int32): int32 =
    return HostPoolProviderSignal(pid, signalCode)

fn HostPoolExitImmediate(code: int32) =
    HostPoolProviderExitImmediate(code)
