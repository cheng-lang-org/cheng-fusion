import std/strings
import std/strutils as strutil

type
    # Immutable DOD projection of the canonical regalloc/object plan. The
    # producer is PrimaryObjectPlanDebugEmissionEvidenceInto; consumers never
    # retain a PrimaryObjectPlan or infer identity from symbol text.
    DebugEmissionPlanEvidence =
        backendKind: str
        symbolNames: str[]
        functionWordOffsets: int32[]
        functionWordCounts: int32[]
        frozenSnapshotPayloads: str[]
        emissionLedgerPayloads: str[]
        bodyIrSha256s: str[]
        symbolByteStarts: int32[]
        symbolByteLengths: int32[]
        symbolBytesSha256s: str[]
        planSha256s: str[]
        actionSemanticRootSha256s: str[]
        actionBindingRootSha256s: str[]
        machineFragmentRootSha256s: str[]
        abiIngressRootSha256s: str[]
        debugProvenanceBound: bool[]
        debugFunctionIds: int32[]
        debugProvenanceSha256s: str[]
        debugMachineFragmentRootSha256s: str[]
        debugFragmentStarts: int32[]
        debugFragmentCounts: int32[]
        fragmentFunctionIndexes: int32[]
        fragmentDebugOpIds: int32[]
        fragmentSyntheticKinds: int32[]
        fragmentSiteKinds: int32[]
        fragmentSiteIndexes: int32[]
        fragmentMachineOwnerKinds: int32[]
        fragmentMachineOwnerOrdinals: int32[]
        fragmentActionConsumerOrdinals: int32[]
        fragmentTextByteStarts: int32[]
        fragmentByteLengths: int32[]
        fragmentBytesSha256s: str[]

@borrows
fn DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
        evidence: DebugEmissionPlanEvidence,
        functionIndex: int32): str =
    let functionCount = evidence.symbolNames.len
    let fragmentCount = evidence.fragmentDebugOpIds.len
    if functionIndex < 0 || functionIndex >= functionCount ||
       evidence.debugProvenanceBound.len != functionCount ||
       evidence.debugFunctionIds.len != functionCount ||
       evidence.debugProvenanceSha256s.len != functionCount ||
       evidence.debugMachineFragmentRootSha256s.len != functionCount ||
       evidence.debugFragmentStarts.len != functionCount ||
       evidence.debugFragmentCounts.len != functionCount ||
       evidence.bodyIrSha256s.len != functionCount ||
       evidence.machineFragmentRootSha256s.len != functionCount ||
       evidence.fragmentFunctionIndexes.len != fragmentCount ||
       evidence.fragmentSyntheticKinds.len != fragmentCount ||
       evidence.fragmentSiteKinds.len != fragmentCount ||
       evidence.fragmentSiteIndexes.len != fragmentCount ||
       evidence.fragmentMachineOwnerKinds.len != fragmentCount ||
       evidence.fragmentMachineOwnerOrdinals.len != fragmentCount ||
       evidence.fragmentActionConsumerOrdinals.len != fragmentCount ||
       evidence.fragmentTextByteStarts.len != fragmentCount ||
       evidence.fragmentByteLengths.len != fragmentCount ||
       evidence.fragmentBytesSha256s.len != fragmentCount ||
       !evidence.debugProvenanceBound[functionIndex] ||
       evidence.debugFunctionIds[functionIndex] < 0 ||
       evidence.symbolNames[functionIndex].len <= 0 ||
       evidence.bodyIrSha256s[functionIndex].len != 64 ||
       evidence.debugProvenanceSha256s[functionIndex].len != 64 ||
       evidence.machineFragmentRootSha256s[functionIndex].len != 64:
        return ""
    let rowStart = evidence.debugFragmentStarts[functionIndex]
    let rowCount = evidence.debugFragmentCounts[functionIndex]
    if rowStart < 0 || rowCount <= 0 ||
       rowStart > fragmentCount - rowCount:
        return ""
    var parts: str[]
    add(parts, "cheng.regalloc.debug_machine_fragments\n")
    add(parts, strings.ConcatStr("", evidence.symbolNames[functionIndex]))
    add(parts, "\n")
    add(parts, strings.IntToStr(
        evidence.debugFunctionIds[functionIndex]))
    add(parts, "\n")
    add(parts, strings.ConcatStr("", evidence.bodyIrSha256s[functionIndex]))
    add(parts, "\n")
    add(parts,
        strings.ConcatStr("", evidence.debugProvenanceSha256s[functionIndex]))
    add(parts, "\n")
    add(parts,
        strings.ConcatStr("", evidence.machineFragmentRootSha256s[functionIndex]))
    add(parts, "\n")
    add(parts, strings.IntToStr(rowCount))
    add(parts, "\n")
    for rowOffset in 0..<rowCount:
        let rowIndex = rowStart + rowOffset
        if evidence.fragmentFunctionIndexes[rowIndex] != functionIndex ||
           evidence.fragmentByteLengths[rowIndex] <= 0 ||
           evidence.fragmentBytesSha256s[rowIndex].len != 64:
            return ""
        add(parts, strings.IntToStr(
            evidence.fragmentDebugOpIds[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentSyntheticKinds[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentSiteKinds[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentSiteIndexes[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentMachineOwnerKinds[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentMachineOwnerOrdinals[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentActionConsumerOrdinals[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentTextByteStarts[rowIndex]))
        add(parts, ";")
        add(parts, strings.IntToStr(
            evidence.fragmentByteLengths[rowIndex]))
        add(parts, ";")
        add(parts,
            strings.ConcatStr("", evidence.fragmentBytesSha256s[rowIndex]))
        add(parts, "\n")
    return strings.Sha256(strutil.Join(parts, ""))
