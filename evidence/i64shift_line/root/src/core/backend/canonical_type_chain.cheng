import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod
import cheng/std/bytes_layout as layout

# Canonical backend type traversal.  TypeId is the only identity: source paths,
# names and rendered type text are deliberately absent from this API.
@borrows
fn CanonicalTypeChainRequireDomain(
        lowering: lower.LoweringPlanStub) =
    let count = lowering.typeArenaStructuralKinds.len
    if count <= 0 ||
       lowering.typeArenaScalarKinds.len != count ||
       lowering.typeArenaChildTypeIds.len != count ||
       lowering.typeArenaFixedLengths.len != count ||
       lowering.typeArenaSizeBytes.len != count ||
       lowering.typeArenaAlignBytes.len != count ||
       lowering.typeArenaLayoutPresent.len != count ||
       layout.FixedBytes32Equal(
           lowering.typeArenaArtifactCid, layout.FixedBytes32()):
        panic("canonical type chain: frozen fact domain missing")

@borrows
fn CanonicalTypeChainRequireType(
        lowering: lower.LoweringPlanStub,
        typeId: int32) =
    CanonicalTypeChainRequireDomain(lowering)
    if typeId < 0 ||
       typeId >= lowering.typeArenaStructuralKinds.len ||
       lowering.typeArenaStructuralKinds[typeId] <=
           Int32(typearena.TypedExprStructuralTypeInvalid) ||
       lowering.typeArenaLayoutPresent[typeId] != 1 ||
       lowering.typeArenaSizeBytes[typeId] < 0 ||
       lowering.typeArenaAlignBytes[typeId] <= 0:
        panic("canonical type chain: TypeId fact missing")

# Alias/Borrow are unary physical forwarding rows. Apply has at least a
# declaration child plus one generic argument in TypeArena; the single
# projected child is always that first declaration child. The projection stores
# -1 when the producer cannot prove the required source cardinality.
# Traversal terminates only at a non-forwarding TypeId and is bounded solely by
# the finite TypeId domain; there is no arbitrary depth cap.
@borrows
fn CanonicalTypeChainPhysicalTypeId(
        lowering: lower.LoweringPlanStub,
        typeId: int32): int32 =
    CanonicalTypeChainRequireType(lowering, typeId)
    var visited: bool[]
    setLen(visited, lowering.typeArenaStructuralKinds.len)
    var current = typeId
    while true:
        CanonicalTypeChainRequireType(lowering, current)
        if visited[current]:
            panic("canonical type chain: TypeId cycle")
        visited[current] = true
        let kind = lowering.typeArenaStructuralKinds[current]
        if kind != Int32(typearena.TypedExprStructuralTypeAlias) &&
           kind != Int32(typearena.TypedExprStructuralTypeBorrow) &&
           kind != Int32(typearena.TypedExprStructuralTypeApply):
            return current
        let childTypeId = lowering.typeArenaChildTypeIds[current]
        if childTypeId < 0 ||
           childTypeId >= lowering.typeArenaStructuralKinds.len:
            panic("canonical type chain: forwarding child is not unique")
        current = childTypeId

@borrows
fn CanonicalTypeChainSequenceElementTypeId(
        lowering: lower.LoweringPlanStub,
        sequenceTypeId: int32,
        allowFixedArray: bool): int32 =
    let physicalTypeId =
        CanonicalTypeChainPhysicalTypeId(lowering, sequenceTypeId)
    let kind = lowering.typeArenaStructuralKinds[physicalTypeId]
    if kind != Int32(typearena.TypedExprStructuralTypeSequence) &&
       (!allowFixedArray ||
        kind != Int32(typearena.TypedExprStructuralTypeFixedArray)):
        panic("canonical type chain: sequence root kind invalid")
    if kind == Int32(typearena.TypedExprStructuralTypeFixedArray) &&
       lowering.typeArenaFixedLengths[physicalTypeId] <= 0:
        panic("canonical type chain: fixed-array length missing")
    let childTypeId = lowering.typeArenaChildTypeIds[physicalTypeId]
    CanonicalTypeChainRequireType(lowering, childTypeId)
    return childTypeId

# Returns the terminal enum TypeId, or -1 for a complete non-enum type.  Invalid
# facts, cycles and non-unique forwarding edges crash in the shared traversal.
@borrows
fn CanonicalTypeChainEnumTypeId(
        lowering: lower.LoweringPlanStub,
        typeId: int32): int32 =
    let physicalTypeId =
        CanonicalTypeChainPhysicalTypeId(lowering, typeId)
    if lowering.typeArenaStructuralKinds[physicalTypeId] ==
           Int32(typearena.TypedExprStructuralTypeEnum):
        return physicalTypeId
    return -1

@borrows
fn CanonicalTypeChainLocalKind(
        lowering: lower.LoweringPlanStub,
        typeId: int32): int32 =
    let physicalTypeId =
        CanonicalTypeChainPhysicalTypeId(lowering, typeId)
    let kind = lowering.typeArenaStructuralKinds[physicalTypeId]
    if kind == Int32(typearena.TypedExprStructuralTypeEnum):
        return coreir.LocalI32Tag
    if kind == Int32(typearena.TypedExprStructuralTypeRefObject) ||
       kind == Int32(typearena.TypedExprStructuralTypeFunction):
        return coreir.LocalPtrTag
    if kind == Int32(typearena.TypedExprStructuralTypeSequence) ||
       kind == Int32(typearena.TypedExprStructuralTypeFixedArray) ||
       kind == Int32(typearena.TypedExprStructuralTypeTuple) ||
       kind == Int32(typearena.TypedExprStructuralTypeObject) ||
       kind == Int32(typearena.TypedExprStructuralTypeOptional):
        return coreir.LocalAggregateTag
    if kind != Int32(typearena.TypedExprStructuralTypeScalar):
        panic("canonical type chain: terminal local kind unsupported")
    let scalarKind = lowering.typeArenaScalarKinds[physicalTypeId]
    if scalarKind ==
           Int32(typearena.TypedExprStructuralScalarStr):
        return coreir.LocalStrTag
    if scalarKind ==
           Int32(typearena.TypedExprStructuralScalarCString):
        return coreir.LocalPtrTag
    if scalarKind ==
           Int32(typearena.TypedExprStructuralScalarInt64) ||
       scalarKind ==
           Int32(typearena.TypedExprStructuralScalarUInt64):
        return coreir.LocalI64Tag
    if scalarKind ==
           Int32(typearena.TypedExprStructuralScalarFloat64):
        return coreir.LocalF64Tag
    if scalarKind <=
           Int32(typearena.TypedExprStructuralScalarInvalid) ||
       scalarKind ==
           Int32(typearena.TypedExprStructuralScalarVoid):
        panic("canonical type chain: scalar local kind missing")
    return coreir.LocalI32Tag

# Validate one frozen FieldGet edge and return its exact owner/result TypeIds
# and layout.  Declaration coordinates and layout rows are producer identities;
# no field name, owner name or source-path lookup participates.
@borrows
fn CanonicalTypeChainFieldHop(
        lowering: lower.LoweringPlanStub,
        fieldNodeIndex: int32,
        ownerTypeIdOut: var int32,
        fieldTypeIdOut: var int32,
        fieldOffsetOut: var int32,
        fieldSizeOut: var int32,
        fieldAlignOut: var int32) =
    ownerTypeIdOut = -1
    fieldTypeIdOut = -1
    fieldOffsetOut = -1
    fieldSizeOut = 0
    fieldAlignOut = 0
    let nodeCount = lowering.typedIr.nodes2_nodeIndexs.len
    if fieldNodeIndex < 0 || fieldNodeIndex >= nodeCount ||
       lowering.typedIr.nodes2_opKinds[fieldNodeIndex] !=
           texpr.TypedExprIrOpFieldGet ||
       !lowering.typedIr.nodeAuthorityTypeArenaBound ||
       !layout.FixedBytes32Equal(
           lowering.typedIr.nodeAuthorityTypeArenaArtifactCid,
           lowering.typeArenaArtifactCid) ||
       lowering.typedIr.nodes2_operand0NodeIndexs.len != nodeCount ||
       lowering.typedIr.nodes2_exactTypeArenaIds.len != nodeCount ||
       lowering.typedIr.nodes2_fieldOffsetBytes.len != nodeCount ||
       lowering.typedIr.nodes2_fieldSizeBytes.len != nodeCount ||
       lowering.typedIr.nodes2_fieldAlignBytes.len != nodeCount ||
       lowering.typedIr.nodes2_fieldProducerSourceIndexes.len != nodeCount ||
       lowering.typedIr.nodes2_fieldOwnerDeclarationSourceLocalRows.len != nodeCount ||
       lowering.typedIr.nodes2_fieldDeclarationSourceLocalRows.len != nodeCount ||
       lowering.typedIr.nodes2_fieldOrdinals.len != nodeCount ||
       lowering.typedIr.nodes2_fieldBuiltinKinds.len != nodeCount:
        panic("canonical type chain: frozen field authority missing")
    let baseNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand0NodeIndexs,
        fieldNodeIndex)
    if baseNodeIndex < 0 || baseNodeIndex >= fieldNodeIndex:
        panic("canonical type chain: field owner node invalid")
    let baseTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        baseNodeIndex)
    let fieldTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        fieldNodeIndex)
    let ownerTypeId =
        CanonicalTypeChainPhysicalTypeId(lowering, baseTypeId)
    CanonicalTypeChainRequireType(lowering, fieldTypeId)
    let fieldOffset = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldOffsetBytes,
        fieldNodeIndex)
    let fieldSize = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldSizeBytes,
        fieldNodeIndex)
    let fieldAlign = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldAlignBytes,
        fieldNodeIndex)
    let producerSourceIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldProducerSourceIndexes,
        fieldNodeIndex)
    let ownerDeclarationRow = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldOwnerDeclarationSourceLocalRows,
        fieldNodeIndex)
    let fieldDeclarationRow = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldDeclarationSourceLocalRows,
        fieldNodeIndex)
    let fieldOrdinal = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldOrdinals,
        fieldNodeIndex)
    let builtinKind = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_fieldBuiltinKinds,
        fieldNodeIndex)
    if fieldOffset < 0 || fieldSize <= 0 || fieldAlign <= 0 ||
       producerSourceIndex < 0 || fieldOrdinal < 0 ||
       fieldOffset % fieldAlign != 0:
        panic("canonical type chain: field layout invalid")
    var ownerLayoutRow: int32 = -1
    var fieldLayoutRow: int32 = -1
    if builtinKind == Int32(texpr.TypedExprLayoutBuiltinNone):
        if producerSourceIndex + 1 >=
               lowering.typedIr.exactLayoutIndexSourceStarts.len:
            panic("canonical type chain: field producer source invalid")
        let sourceStart =
            lowering.typedIr.exactLayoutIndexSourceStarts[producerSourceIndex]
        let sourceStop =
            lowering.typedIr.exactLayoutIndexSourceStarts[
                producerSourceIndex + 1]
        if sourceStart < 0 || sourceStop < sourceStart ||
           ownerDeclarationRow < 0 ||
           ownerDeclarationRow >= sourceStop - sourceStart ||
           fieldDeclarationRow < 0 ||
           fieldDeclarationRow >= sourceStop - sourceStart:
            panic("canonical type chain: field declaration coordinate invalid")
        let ownerIndex = sourceStart + ownerDeclarationRow
        let fieldIndex = sourceStart + fieldDeclarationRow
        if ownerIndex >= lowering.typedIr.exactLayoutTypeDeclarationRows.len ||
           ownerIndex >=
               lowering.typedIr.exactLayoutDeclarationTypeArenaIds.len ||
           fieldIndex >= lowering.typedIr.exactLayoutFieldDeclarationRows.len ||
           fieldIndex >=
               lowering.typedIr.exactLayoutDeclarationTypeArenaIds.len ||
           lowering.typedIr.exactLayoutDeclarationTypeArenaIds[ownerIndex] !=
               ownerTypeId ||
           lowering.typedIr.exactLayoutDeclarationTypeArenaIds[fieldIndex] !=
               fieldTypeId:
            panic("canonical type chain: field declaration TypeId drift")
        ownerLayoutRow =
            lowering.typedIr.exactLayoutTypeDeclarationRows[ownerIndex]
        fieldLayoutRow =
            lowering.typedIr.exactLayoutFieldDeclarationRows[fieldIndex]
    else:
        if builtinKind < Int32(texpr.TypedExprLayoutBuiltinSequence) ||
           builtinKind > Int32(texpr.TypedExprLayoutBuiltinOptional):
            panic("canonical type chain: field builtin kind invalid")
        let ownerIndex = producerSourceIndex * 4 + builtinKind
        let fieldIndex =
            producerSourceIndex * 16 + builtinKind * 4 + fieldOrdinal
        if ownerIndex < 0 ||
           ownerIndex >= lowering.typedIr.exactLayoutTypeBuiltinRows.len ||
           fieldIndex < 0 ||
           fieldIndex >= lowering.typedIr.exactLayoutFieldBuiltinRows.len:
            panic("canonical type chain: builtin field coordinate invalid")
        ownerLayoutRow =
            lowering.typedIr.exactLayoutTypeBuiltinRows[ownerIndex]
        fieldLayoutRow =
            lowering.typedIr.exactLayoutFieldBuiltinRows[fieldIndex]
    if ownerLayoutRow < 0 ||
       ownerLayoutRow >= lowering.typedIr.typeLayoutSizeBytes.len ||
       fieldLayoutRow < 0 ||
       fieldLayoutRow >= lowering.typedIr.typeFieldOffsetBytes.len ||
       fieldLayoutRow >= lowering.typedIr.typeFieldSizeBytes.len ||
       fieldLayoutRow >= lowering.typedIr.typeFieldAlignBytes.len ||
       lowering.typedIr.typeFieldOffsetBytes[fieldLayoutRow] != fieldOffset ||
       lowering.typedIr.typeFieldSizeBytes[fieldLayoutRow] != fieldSize ||
       lowering.typedIr.typeFieldAlignBytes[fieldLayoutRow] != fieldAlign ||
       Int64(fieldOffset) + Int64(fieldSize) >
           Int64(lowering.typedIr.typeLayoutSizeBytes[ownerLayoutRow]):
        panic("canonical type chain: field layout row drift")
    ownerTypeIdOut = ownerTypeId
    fieldTypeIdOut = fieldTypeId
    fieldOffsetOut = fieldOffset
    fieldSizeOut = fieldSize
    fieldAlignOut = fieldAlign
