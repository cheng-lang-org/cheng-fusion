@borrows
fn DirectObjectEmitX64WriteFunction(plan: pobj.PrimaryObjectPlan,
                                    functionIndex: int32,
                                    out: var obuf.ObjectBuffer) =
    if DirectObjectEmitX64FunctionHasBodyIR(plan, functionIndex):
        let startWord = plan.functionWordOffsets[functionIndex]
        let wordCount = plan.functionWordCounts[functionIndex]
        for wi in 0..<wordCount:
            let wordIndex = startWord + wi
            if wordIndex < 0 || wordIndex >= plan.instructionWords.len:
                return
            let word = plan.instructionWords[wordIndex]
            obuf.ObjectBufferWriteU8(out, word & 255)
            obuf.ObjectBufferWriteU8(out, (word >> 8) & 255)
            obuf.ObjectBufferWriteU8(out, (word >> 16) & 255)
            obuf.ObjectBufferWriteU8(out, (word >> 24) & 255)
        return
    let bodyKind = plan.functionBodyKinds[functionIndex]
    if DirectObjectEmitX64TinyEntryBridgePlan(plan) && functionIndex == 0:
        DirectObjectEmitX64WriteReturnZero(out)
        return
    if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, functionIndex):
        DirectObjectEmitX64WriteEntryBridge(out)
        return
    if bodyKind == texpr.BodyKindRuntimeSetCmdLine:
        DirectObjectEmitX64WriteRuntimeSetCmdLine(out)
        return
    if bodyKind == texpr.BodyKindRuntimeParamCount:
        DirectObjectEmitX64WriteRuntimeParamCount(out)
        return
    if bodyKind == texpr.BodyKindRuntimeParamStrCopyBridge:
        DirectObjectEmitX64WriteRuntimeParamStrCopy(out)
        return
    if bodyKind == texpr.BodyKindStrLenFastI32:
        DirectObjectEmitX64WriteStrLenFast(out)
        return
    var constValue: int32
    if DirectObjectEmitWasmFunctionReturnI32Const(plan, functionIndex, constValue):
        if constValue == 0:
            DirectObjectEmitX64WriteReturnZero(out)
        else:
            DirectObjectEmitX64WriteReturnI32Const(out, constValue)
        return
    if functionIndex < plan.functionBodyIRs.len:
        var binOpKind: int32
        var lhsParam: int32
        var rhsParam: int32
        if DirectObjectEmitX64BodyIRSingleI32BinOpReturn(plan.functionBodyIRs[functionIndex],
                                                         binOpKind,
                                                         lhsParam,
                                                         rhsParam):
            DirectObjectEmitX64WriteI32BinOpReturn(out, binOpKind, lhsParam, rhsParam)
            return
    var callThenTarget = ""
    var callThenValue: int32
    if DirectObjectEmitX64BodyIRSingleNoargCallThenI32Const(plan,
                                                            functionIndex,
                                                            callThenTarget,
                                                            callThenValue):
        DirectObjectEmitX64WriteCallThenReturnI32Const(out, callThenValue)
        return
    var cstringCallTarget = ""
    var cstringLiteralLabel = ""
    if DirectObjectEmitX64BodyIRSingleCStringCallReturnResult(plan,
                                                              functionIndex,
                                                              cstringCallTarget,
                                                              cstringLiteralLabel):
        DirectObjectEmitX64WriteCStringCallReturnResult(out, plan.targetTriple)
        return
    var ltZeroTarget = ""
    var ltZeroValue: int32
    var geZeroValue: int32
    if DirectObjectEmitX64BodyIRCallLtZeroSelectReturn(plan,
                                                       functionIndex,
                                                       ltZeroTarget,
                                                       ltZeroValue,
                                                       geZeroValue):
        DirectObjectEmitX64WriteCallLtZeroSelectReturn(out, ltZeroValue, geZeroValue)
        return
    var callTarget = ""
    var callArgCount: int32
    if DirectObjectEmitWasmFunctionSingleCallTarget(plan, functionIndex, callTarget, callArgCount):
        DirectObjectEmitX64WriteJmpPlaceholder(out)
        return
    if bodyKind == texpr.BodyKindReturnVoid:
        DirectObjectEmitX64WriteRet(out)
        return
    if bodyKind == texpr.BodyKindReturnF64MulArgs:
        obuf.ObjectBufferWriteU8(out, int32(0xf2))
        obuf.ObjectBufferWriteU8(out, int32(0x0f))
        obuf.ObjectBufferWriteU8(out, int32(0x59))
        obuf.ObjectBufferWriteU8(out, int32(0xc1))
        DirectObjectEmitX64WriteRet(out)
        return
    if bodyKind == texpr.BodyKindReturnF64Arg0:
        DirectObjectEmitX64WriteRet(out)
        return
    if bodyKind == texpr.BodyKindReturnF64FromI32Arg0:
        obuf.ObjectBufferWriteU8(out, int32(0xf2))
        obuf.ObjectBufferWriteU8(out, int32(0x0f))
        obuf.ObjectBufferWriteU8(out, int32(0x2a))
        obuf.ObjectBufferWriteU8(out, int32(0xc7))
        DirectObjectEmitX64WriteRet(out)
        return
    if bodyKind == texpr.BodyKindReturnF64FromI64Arg0:
        obuf.ObjectBufferWriteU8(out, int32(0xf2))
        obuf.ObjectBufferWriteU8(out, int32(0x48))
        obuf.ObjectBufferWriteU8(out, int32(0x0f))
        obuf.ObjectBufferWriteU8(out, int32(0x2a))
        obuf.ObjectBufferWriteU8(out, int32(0xc7))
        DirectObjectEmitX64WriteRet(out)
        return
    if bodyKind == texpr.BodyKindReturnI64Arg0:
        obuf.ObjectBufferWriteU8(out, int32(0x48))
        obuf.ObjectBufferWriteU8(out, int32(0x89))
        obuf.ObjectBufferWriteU8(out, int32(0xf8))
        DirectObjectEmitX64WriteRet(out)
        return
    if bodyKind == texpr.BodyKindReturnI64FromI32Arg0:
        obuf.ObjectBufferWriteU8(out, int32(0x48))
        obuf.ObjectBufferWriteU8(out, int32(0x63))
        obuf.ObjectBufferWriteU8(out, int32(0xc7))
        DirectObjectEmitX64WriteRet(out)
        return
    if texpr.TypedExprIsReturnCallBodyKind(bodyKind):
        DirectObjectEmitX64WriteJmpPlaceholder(out)
        return

@borrows
fn DirectObjectEmitX64PlanText(plan: pobj.PrimaryObjectPlan): Bytes =
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    var text = obuf.ObjectBufferInit(plan.instructionWords.len * 4 + 128)
    for i in 0..<functionCount:
        let expectedStart = plan.functionWordOffsets[i] * 4
        while obuf.ObjectBufferOffset(text) < expectedStart:
            obuf.ObjectBufferWriteU8(text, int32(0x90))
        DirectObjectEmitX64WriteFunction(plan, i, text)
        let declaredEnd = expectedStart + plan.functionWordCounts[i] * 4
        while obuf.ObjectBufferOffset(text) < declaredEnd:
            obuf.ObjectBufferWriteU8(text, int32(0x90))
    return obuf.ObjectBufferTakeBytes(text)

@borrows
fn DirectObjectEmitX64PlanTextInto(plan: pobj.PrimaryObjectPlan,
                                   out: var Bytes) =
    var text = DirectObjectEmitX64PlanText(plan)
    out = text

@borrows
fn DirectObjectEmitX64FunctionSymbolSize(plan: pobj.PrimaryObjectPlan,
                                         functionIndex: int32): int64 =
    let declaredSize = plan.functionWordCounts[functionIndex] * 4
    let payloadSize = DirectObjectEmitX64FunctionPayloadSize(plan, functionIndex)
    if payloadSize > declaredSize:
        return int64(payloadSize)
    return int64(declaredSize)

@borrows
fn DirectObjectEmitX64CanonicalTextProofReason(
        plan: pobj.PrimaryObjectPlan,
        text: var Bytes): str =
    let planReason = DirectObjectEmitX64CanonicalPlanReason(plan)
    if len(planReason) > 0:
        return planReason
    if rawbytes.BytesLen(text) != plan.instructionWords.len * 4:
        return " direct object emit: x86_64 canonical text byte count mismatch"
    let textSpan = layout.ByteSpanFromBytes(text)
    for functionIndex in 0..<plan.symbolNames.len:
        let byteStart =
            plan.regallocFunctionSymbolByteStarts[functionIndex]
        let byteLength =
            plan.regallocFunctionSymbolByteLengths[functionIndex]
        if byteStart < 0 || byteLength <= 0 ||
           byteStart > rawbytes.BytesLen(text) - byteLength:
            return " direct object emit: x86_64 canonical text slice mismatch"
        let functionSpan =
            layout.ByteSpanSlice(textSpan, byteStart, byteLength)
        let actualSha256 =
            layout.FixedBytes32Hex(hash256.Sha256Fixed(functionSpan))
        if actualSha256 !=
               plan.regallocFunctionSymbolBytesSha256s[functionIndex]:
            return " direct object emit: x86_64 canonical text receipt mismatch"
    return ""

@borrows
fn DirectObjectEmitPlanText(plan: pobj.PrimaryObjectPlan): Bytes =
    var text = obuf.ObjectBufferInit(plan.instructionWords.len * 4 + 16)
    for i in 0..<plan.instructionWords.len:
        let word = plan.instructionWords[i]
        obuf.ObjectBufferWriteU8(text, word & 255)
        obuf.ObjectBufferWriteU8(text, (word >> 8) & 255)
        obuf.ObjectBufferWriteU8(text, (word >> 16) & 255)
        obuf.ObjectBufferWriteU8(text, (word >> 24) & 255)
    var out = obuf.ObjectBufferTakeBytes(text)
    if DirectObjectEmitX64Triple(plan.targetTriple):
        let reason =
            DirectObjectEmitX64CanonicalTextProofReason(plan, out)
        if len(reason) > 0:
            system.Assert(false, reason)
    return out

@borrows
fn DirectObjectEmitPlanTextInto(plan: pobj.PrimaryObjectPlan,
                                out: var Bytes) =
    var text = obuf.ObjectBufferInit(plan.instructionWords.len * 4 + 16)
    for i in 0..<plan.instructionWords.len:
        let word = plan.instructionWords[i]
        obuf.ObjectBufferWriteU8(text, word & 255)
        obuf.ObjectBufferWriteU8(text, (word >> 8) & 255)
        obuf.ObjectBufferWriteU8(text, (word >> 16) & 255)
        obuf.ObjectBufferWriteU8(text, (word >> 24) & 255)
    out = obuf.ObjectBufferTakeBytes(text)
    if DirectObjectEmitX64Triple(plan.targetTriple):
        let reason =
            DirectObjectEmitX64CanonicalTextProofReason(plan, out)
        if len(reason) > 0:
            system.Assert(false, reason)

@borrows
fn DirectObjectEmitPlanDataByteCount(plan: pobj.PrimaryObjectPlan,
                                      functionLimit: int32): int32 =
    if plan.dataPayloadRawByteCounts.len > plan.dataLabels.len:
        panic("direct_object_emit_data_raw_count_shape_invalid")
    var total: int32
    var rawByteCount: int32
    for i in 0..<plan.dataLabels.len:
        var payloadSize: int32
        var rawPayloadSize: int32
        if i < plan.dataPayloadRawByteCounts.len:
            rawPayloadSize = plan.dataPayloadRawByteCounts[i]
            if rawPayloadSize < 0:
                panic("direct_object_emit_data_raw_count_invalid")
        if rawPayloadSize > 0:
            payloadSize = rawPayloadSize
            if rawByteCount > 2147483647 - rawPayloadSize:
                panic("direct_object_emit_data_raw_count_overflow")
            rawByteCount = rawByteCount + rawPayloadSize
        else:
            var payloadText = ""
            if i < plan.dataPayloadTexts.len:
                payloadText = plan.dataPayloadTexts[i]
            let aligned = DirectObjectEmitAlign(
                total, DirectObjectEmitPayloadAlign(payloadText))
            if aligned < total:
                panic("direct_object_emit_data_alignment_overflow")
            total = aligned
            payloadSize = DirectObjectEmitPayloadByteCount(payloadText)
        if payloadSize < 0 || total > 2147483647 - payloadSize:
            panic("direct_object_emit_data_size_overflow")
        total = total + payloadSize
    if rawByteCount != plan.dataPayloadRawBytes.len:
        panic("direct_object_emit_data_raw_bytes_shape_invalid")
    var globalLabels: str[]
    var globalPayloads: str[]
    globalLabels = []
    globalPayloads = []
    DirectObjectEmitAppendGlobalData(plan, functionLimit, globalLabels, globalPayloads)
    for i in 0..<globalLabels.len:
        var globalPayloadText = ""
        if i < globalPayloads.len:
            globalPayloadText = globalPayloads[i]
        let aligned = DirectObjectEmitAlign(
            total, DirectObjectEmitPayloadAlign(globalPayloadText))
        let payloadSize = DirectObjectEmitPayloadByteCount(globalPayloadText)
        if aligned < total || payloadSize < 0 ||
           aligned > 2147483647 - payloadSize:
            panic("direct_object_emit_global_data_size_overflow")
        total = aligned + payloadSize
    return total

@borrows
fn directObjectEmitPlanDataBuildIntoBuffer(
        plan: pobj.PrimaryObjectPlan,
        functionLimit: int32,
        expectedByteCount: int32,
        data: var obuf.ObjectBuffer) =
    var rawOffset: int32
    for i in 0..<plan.dataLabels.len:
        var rawPayloadSize: int32
        if i < plan.dataPayloadRawByteCounts.len:
            rawPayloadSize = plan.dataPayloadRawByteCounts[i]
        if rawPayloadSize > 0:
            if rawOffset < 0 || rawPayloadSize < 0 ||
               rawOffset > plan.dataPayloadRawBytes.len - rawPayloadSize:
                panic("direct_object_emit_data_raw_slice_invalid")
            let count = rawPayloadSize
            for bi in 0..<count:
                let ri = rawOffset + bi
                obuf.ObjectBufferWriteU8(
                    data, plan.dataPayloadRawBytes[ri])
            rawOffset = rawOffset + count
        else:
            var payloadText = ""
            if i < plan.dataPayloadTexts.len:
                payloadText = plan.dataPayloadTexts[i]
            obuf.ObjectBufferAlign(data, DirectObjectEmitPayloadAlign(payloadText), 0)
            if chengpath.TextStartsWith(payloadText, "cstring:"):
                DirectObjectEmitWriteCStringPayload(data, payloadText)
            elif chengpath.TextStartsWith(payloadText, "hex:"):
                DirectObjectEmitWriteHexPayload(data, payloadText)
            else:
                let count = DirectObjectEmitPayloadByteCount(payloadText)
                obuf.ObjectBufferWriteZeros(data, count)
    var globalLabels: str[]
    var globalPayloads: str[]
    globalLabels = []
    globalPayloads = []
    DirectObjectEmitAppendGlobalData(plan, functionLimit, globalLabels, globalPayloads)
    for i in 0..<globalLabels.len:
        var globalPayloadText = ""
        if i < globalPayloads.len:
            globalPayloadText = globalPayloads[i]
        obuf.ObjectBufferAlign(data, DirectObjectEmitPayloadAlign(globalPayloadText), 0)
        let count = DirectObjectEmitPayloadByteCount(globalPayloadText)
        obuf.ObjectBufferWriteZeros(data, count)
    if rawOffset != plan.dataPayloadRawBytes.len ||
       obuf.ObjectBufferLen(data) != expectedByteCount:
        panic("direct_object_emit_data_materialization_drift")

@borrows
fn DirectObjectEmitPlanData(plan: pobj.PrimaryObjectPlan,
                             functionLimit: int32): Bytes =
    let expectedByteCount =
        DirectObjectEmitPlanDataByteCount(plan, functionLimit)
    var data = obuf.ObjectBufferInit(expectedByteCount)
    directObjectEmitPlanDataBuildIntoBuffer(
        plan, functionLimit, expectedByteCount, data)
    return obuf.ObjectBufferTakeBytes(data)

@borrows
fn DirectObjectEmitPlanDataInto(plan: pobj.PrimaryObjectPlan,
                                functionLimit: int32,
                                out: var Bytes) =
    let expectedByteCount =
        DirectObjectEmitPlanDataByteCount(plan, functionLimit)
    var data = obuf.ObjectBufferInit(expectedByteCount)
    directObjectEmitPlanDataBuildIntoBuffer(
        plan, functionLimit, expectedByteCount, data)
    out = obuf.ObjectBufferTakeBytes(data)

@borrows
fn DirectObjectEmitPlanSymbols(plan: pobj.PrimaryObjectPlan): osym.ObjectSymbolTable =
    return DirectObjectEmitPlanSymbolsForTarget(plan, plan.targetTriple)

@borrows
fn DirectObjectEmitSymbolIsGlobal(plan: pobj.PrimaryObjectPlan, symbolName: str): bool =
    if plan.symbolVisibility != "internal" || plan.exportRootSymbols.len <= 0:
        return true
    for i in 0..<plan.exportRootSymbols.len:
        if plan.exportRootSymbols[i] == symbolName:
            return true
    return false

@borrows
fn DirectObjectEmitPlanSymbolsForTarget(plan: pobj.PrimaryObjectPlan,
                                        targetTriple: str): osym.ObjectSymbolTable =
    var symbols = osym.ObjectSymbolsInit()
    let canonicalX64 =
        DirectObjectEmitX64Triple(targetTriple) ||
        DirectObjectEmitX64Triple(plan.targetTriple)
    if canonicalX64:
        var canonicalReason =
            " direct object emit: x86_64 canonical target mismatch"
        if targetTriple == plan.targetTriple:
            canonicalReason =
                DirectObjectEmitX64CanonicalPlanReason(plan)
        if len(canonicalReason) > 0:
            system.Assert(false, canonicalReason)
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    let bridgeIndex = DirectObjectEmitEntryBridgeIndex(plan)
    let entryMainSymbol = DirectObjectEmitTargetSymbolName(targetTriple, "main")
    if bridgeIndex >= 0 && bridgeIndex < functionCount:
        let bridgeOffset = int64(plan.functionWordOffsets[bridgeIndex] * 4)
        let bridgeSize = int64(plan.functionWordCounts[bridgeIndex] * 4)
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  strings.CloneStr(entryMainSymbol),
                                                                  0,
                                                                  bridgeOffset,
                                                                  bridgeSize,
                                                                  true),
                                     "direct object emit: add plan entry bridge main symbol")
    for i in 0..<functionCount:
        let offset = int64(plan.functionWordOffsets[i] * 4)
        let size = int64(plan.functionWordCounts[i] * 4)
        let symbolName = DirectObjectEmitPlanSymbolNameAtForTarget(plan, targetTriple, i)
        if Len(symbolName) <= 0:
            continue
        if bridgeIndex >= 0 && i != bridgeIndex && symbolName == entryMainSymbol:
            continue
        let symbolGlobal = DirectObjectEmitSymbolIsGlobal(plan, symbolName)
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  symbolName,
                                                                  0,
                                                                  offset,
                                                                  size,
                                                                  symbolGlobal),
                                     "direct object emit: add plan function symbol")
        if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, i):
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                      strings.CloneStr(entryMainSymbol),
                                                                      0,
                                                                      offset,
                                                                      size,
                                                                      true),
                                         "direct object emit: add plan entry main symbol")
    var dataOffset: int32
    var dataAddr = DirectObjectEmitDataSectionAddr(plan)
    if plan.targetTriple == "x86_64-pc-windows-msvc":
        # COFF symbol values are section-relative; no image-layout base.
        dataAddr = 0
    for i in 0..<plan.dataLabels.len:
        var payloadSize: int32
        if i < plan.dataPayloadRawByteCounts.len && plan.dataPayloadRawByteCounts[i] > 0:
            payloadSize = plan.dataPayloadRawByteCounts[i]
        else:
            var payloadText = ""
            if i < plan.dataPayloadTexts.len:
                payloadText = plan.dataPayloadTexts[i]
                payloadSize = DirectObjectEmitPayloadByteCount(payloadText)
            dataOffset = DirectObjectEmitAlign(dataOffset, DirectObjectEmitPayloadAlign(payloadText))
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  plan.dataLabels[i],
                                                                  1,
                                                                  int64(dataAddr + dataOffset),
                                                                  int64(payloadSize),
                                                                  false),
                                     "direct object emit: add plan data symbol")
        dataOffset = dataOffset + payloadSize
    var globalLabels: str[]
    var globalPayloads: str[]
    globalLabels = []
    globalPayloads = []
    DirectObjectEmitAppendGlobalData(plan, functionCount, globalLabels, globalPayloads)
    for i in 0..<globalLabels.len:
        var payloadSize2: int32
        var payloadText2 = ""
        if i < globalPayloads.len:
            payloadText2 = globalPayloads[i]
            payloadSize2 = DirectObjectEmitPayloadByteCount(payloadText2)
        dataOffset = DirectObjectEmitAlign(dataOffset, DirectObjectEmitPayloadAlign(payloadText2))
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  globalLabels[i],
                                                                  1,
                                                                  int64(dataAddr + dataOffset),
                                                                  int64(payloadSize2),
                                                                  false),
                                     "direct object emit: add plan global data symbol")
        dataOffset = dataOffset + payloadSize2
    for i in 0..<functionCount:
        if canonicalX64:
            continue
        if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, i):
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeSetCmdLineSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry argv symbol")
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeLineMapSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry line-map symbol")
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeTargetSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry target symbol")
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeProfileFlushSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry profile symbol")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamStrCopyBridge:
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitTargetSymbolName(plan.targetTriple, "strlen"),
                                                                        true),
                                         "direct object emit: add runtime strlen symbol")
    for i in 0..<plan.relocTargetSymbols.len:
        # Skip targets already present (defined function/data symbol or a
        # previously added undefined row): AddUndefined rejects a defined
        # name with -1 (e.g. the source-entry symbol, which the bridge also
        # calls). Mirrors the linkerless writer's defined-check.
        if Len(plan.relocTargetSymbols[i]) > 0 &&
           osym.ObjectSymbolsFind(symbols, plan.relocTargetSymbols[i]) < 0:
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        plan.relocTargetSymbols[i],
                                                                        true),
                                         "direct object emit: add plan undefined symbol")
    for i in 0..<plan.dataRelocTargetSymbols.len:
        # [wall137] Skip targets already present (defined data label or a
        # previously added undefined row): AddUndefined rejects a defined
        # name with -1. Mirrors the sibling relocTargetSymbols guard.
        if Len(plan.dataRelocTargetSymbols[i]) > 0 &&
           osym.ObjectSymbolsFind(symbols, plan.dataRelocTargetSymbols[i]) < 0:
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(
                                             symbols,
                                             strings.CloneStr(plan.dataRelocTargetSymbols[i]),
                                             true),
                                         "direct object emit: add plan undefined data symbol")
    return symbols

@borrows
fn DirectObjectEmitPlanSymbolsInto(plan: pobj.PrimaryObjectPlan,
                                   targetTriple: str,
                                   symbols: var osym.ObjectSymbolTable) =
    osym.ObjectSymbolsReset(symbols)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_symbols_into_enter")
    let canonicalX64 =
        DirectObjectEmitX64Triple(targetTriple) ||
        DirectObjectEmitX64Triple(plan.targetTriple)
    if canonicalX64:
        var canonicalReason =
            " direct object emit: x86_64 canonical target mismatch"
        if targetTriple == plan.targetTriple:
            canonicalReason =
                DirectObjectEmitX64CanonicalPlanReason(plan)
        if len(canonicalReason) > 0:
            system.Assert(false, canonicalReason)
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    let realFunctionLimit = DirectObjectEmitRealFunctionLimit(plan)
    let entryFunctionIndex = DirectObjectEmitEntryFunctionIndex(plan, realFunctionLimit)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=direct_symbols_function_count value={functionCount}")
    for i in 0..<functionCount:
        let offset = int64(plan.functionWordOffsets[i] * 4)
        let size = int64(plan.functionWordCounts[i] * 4)
        let symbolName = DirectObjectEmitPlanSymbolNameAtForTarget(plan, targetTriple, i)
        if Len(symbolName) <= 0:
            continue
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  strings.CloneStr(symbolName),
                                                                  0,
                                                                  offset,
                                                                  size,
                                                                  DirectObjectEmitSymbolIsGlobal(plan, symbolName)),
                                     "direct object emit: add plan function symbol")
        if plan.targetTriple == "x86_64-pc-windows-msvc" &&
           i == entryFunctionIndex &&
           symbolName != "main":
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                      "main",
                                                                      0,
                                                                      offset,
                                                                      size,
                                                                      true),
                                         "direct object emit: add windows standalone main symbol")
        if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, i):
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                      DirectObjectEmitTargetSymbolName(targetTriple, "main"),
                                                                      0,
                                                                      offset,
                                                                      size,
                                                                      true),
                                         "direct object emit: add plan entry main symbol")
    var dataOffset: int32
    var dataAddr = DirectObjectEmitDataSectionAddr(plan)
    if plan.targetTriple == "x86_64-pc-windows-msvc":
        # COFF symbol values are section-relative; no image-layout base.
        dataAddr = 0
    for i in 0..<plan.dataLabels.len:
        var payloadSize: int32
        if i < plan.dataPayloadRawByteCounts.len && plan.dataPayloadRawByteCounts[i] > 0:
            payloadSize = plan.dataPayloadRawByteCounts[i]
        else:
            var payloadText = ""
            if i < plan.dataPayloadTexts.len:
                payloadText = plan.dataPayloadTexts[i]
                payloadSize = DirectObjectEmitPayloadByteCount(payloadText)
            dataOffset = DirectObjectEmitAlign(dataOffset, DirectObjectEmitPayloadAlign(payloadText))
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  strings.CloneStr(plan.dataLabels[i]),
                                                                  1,
                                                                  int64(dataAddr + dataOffset),
                                                                  int64(payloadSize),
                                                                  false),
                                     "direct object emit: add plan data symbol")
        dataOffset = dataOffset + payloadSize
    var globalLabels: str[]
    var globalPayloads: str[]
    globalLabels = []
    globalPayloads = []
    DirectObjectEmitAppendGlobalData(plan, functionCount, globalLabels, globalPayloads)
    for i in 0..<globalLabels.len:
        var payloadSize2: int32
        var payloadText2 = ""
        if i < globalPayloads.len:
            payloadText2 = globalPayloads[i]
            payloadSize2 = DirectObjectEmitPayloadByteCount(payloadText2)
        dataOffset = DirectObjectEmitAlign(dataOffset, DirectObjectEmitPayloadAlign(payloadText2))
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  strings.CloneStr(globalLabels[i]),
                                                                  1,
                                                                  int64(dataAddr + dataOffset),
                                                                  int64(payloadSize2),
                                                                  false),
                                     "direct object emit: add plan global data symbol")
        dataOffset = dataOffset + payloadSize2
    for i in 0..<functionCount:
        if canonicalX64:
            continue
        if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, i):
            if plan.targetTriple == "x86_64-pc-windows-msvc":
                continue
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeSetCmdLineSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry argv symbol")
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeLineMapSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry line-map symbol")
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeTargetSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry target symbol")
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitEntryBridgeProfileFlushSymbol(plan),
                                                                        true),
                                         "direct object emit: add entry profile symbol")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamStrCopyBridge:
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        DirectObjectEmitTargetSymbolName(plan.targetTriple, "strlen"),
                                                                        true),
                                         "direct object emit: add runtime strlen symbol")
    for i in 0..<plan.relocTargetSymbols.len:
        # Same defined-symbol guard as the sibling loop above: AddUndefined
        # rejects names already defined in the table with -1.
        if Len(plan.relocTargetSymbols[i]) > 0 &&
           osym.ObjectSymbolsFind(symbols, plan.relocTargetSymbols[i]) < 0:
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                        strings.CloneStr(plan.relocTargetSymbols[i]),
                                                                        true),
                                         "direct object emit: add plan undefined symbol")
    for i in 0..<plan.dataRelocTargetSymbols.len:
        # [wall137] Same defined-symbol guard as the sibling loop above:
        # AddUndefined rejects names already defined in the table (local data
        # labels) with -1; a pure undefined duplicate stays idempotent.
        if Len(plan.dataRelocTargetSymbols[i]) > 0 &&
           osym.ObjectSymbolsFind(symbols, plan.dataRelocTargetSymbols[i]) < 0:
            DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(
                                             symbols,
                                             strings.CloneStr(plan.dataRelocTargetSymbols[i]),
                                             true),
                                         "direct object emit: add plan undefined data symbol")
    if Len(plan.entryFunctionSymbol) > 0 &&
       (entryFunctionIndex < 0 ||
        osym.ObjectSymbolsFind(symbols, plan.entryFunctionSymbol) < 0):
        system.Assert(false,
            "direct object emit: structured entry symbol publication missing")

@borrows
fn DirectObjectEmitAddBranchReloc(relocs: var orel.ObjectRelocTable,
                                   symbols: var osym.ObjectSymbolTable,
                                   byteOffset: int64,
                                   targetSymbol: str) =
    let targetIndex = osym.ObjectSymbolsFind(symbols, targetSymbol)
    if targetIndex < 0:
        system.Assert(false,
            "direct object emit: branch relocation symbol missing")
        return
    DirectObjectEmitRequireIndex(orel.ObjectRelocsAdd(relocs,
                                                      0,
                                                      byteOffset,
                                                      targetIndex,
                                                      orel.ObjectRelocBranch26,
                                                      int64(0),
                                                      true),
                                 "direct object emit: add branch reloc")

@borrows
fn DirectObjectEmitAddTargetCallReloc(targetTriple: str,
                                      relocs: var orel.ObjectRelocTable,
                                      symbols: var osym.ObjectSymbolTable,
                                      byteOffset: int64,
                                      targetSymbol: str) =
    if !tmat.TargetIsRiscvCodegen(targetTriple):
        DirectObjectEmitAddBranchReloc(
            relocs, symbols, byteOffset, targetSymbol)
        return
    let targetIndex = osym.ObjectSymbolsFind(symbols, targetSymbol)
    if targetIndex < 0:
        system.Assert(false,
            "direct object emit: RISC-V call relocation symbol missing")
        return
    DirectObjectEmitRequireIndex(orel.ObjectRelocsAdd(relocs,
                                                      0,
                                                      byteOffset,
                                                      targetIndex,
                                                      orel.ObjectRelocRiscvCall,
                                                      int64(0),
                                                      true),
                                 "direct object emit: add RISC-V call reloc")

@borrows
fn DirectObjectEmitAddPageRelocPair(relocs: var orel.ObjectRelocTable,
                                     symbols: var osym.ObjectSymbolTable,
                                     byteOffset: int64,
                                     targetSymbol: str,
                                     label: str) =
    let targetIndex = osym.ObjectSymbolsFind(symbols, targetSymbol)
    if targetIndex < 0:
        system.Assert(false, label)
        return
    DirectObjectEmitRequireIndex(orel.ObjectRelocsAdd(relocs,
                                                      0,
                                                      byteOffset,
                                                      targetIndex,
                                                      orel.ObjectRelocPage21,
                                                      int64(0),
                                                      true),
                                 label)
    DirectObjectEmitRequireIndex(orel.ObjectRelocsAdd(relocs,
                                                      0,
                                                      byteOffset + int64(4),
                                                      targetIndex,
                                                      orel.ObjectRelocPageOff12,
                                                      int64(0),
                                                      false),
                                 label)

@borrows
fn DirectObjectEmitRuntimeDataLabelForOrdinal(plan: pobj.PrimaryObjectPlan,
                                               ordinal: int32): str =
    if ordinal == 0:
        return DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argc")
    if ordinal == 1:
        return DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argv")
    return ""

@borrows
fn DirectObjectEmitAddPcRel32Reloc(relocs: var orel.ObjectRelocTable,
                                    symbols: var osym.ObjectSymbolTable,
                                    byteOffset: int64,
                                    targetSymbol: str) =
    let targetIndex = osym.ObjectSymbolsFind(symbols, targetSymbol)
    if targetIndex < 0:
        system.Assert(false, Fmt" direct object emit: add pc-rel32 reloc: missing symbol {targetSymbol}")
        return
    DirectObjectEmitRequireIndex(orel.ObjectRelocsAdd(relocs,
                                                      0,
                                                      byteOffset,
                                                      targetIndex,
                                                      orel.ObjectRelocPcRel32,
                                                      int64(0),
                                                      true),
                                 "direct object emit: add pc-rel32 reloc")

@borrows
fn DirectObjectEmitX64CanonicalPlanRelocsInto(
        plan: pobj.PrimaryObjectPlan,
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable) =
    relocs.items = []
    let canonicalReason =
        DirectObjectEmitX64CanonicalPlanReason(plan)
    if len(canonicalReason) > 0:
        system.Assert(false, canonicalReason)
        return
    for relocIndex in 0..<plan.relocWordOffsets.len:
        let targetSymbol = plan.relocTargetSymbols[relocIndex]
        let targetIndex =
            osym.ObjectSymbolsFind(symbols, targetSymbol)
        if targetIndex < 0:
            system.Assert(
                false,
                " direct object emit: x86_64 canonical call relocation symbol missing")
            return
        DirectObjectEmitRequireIndex(
            orel.ObjectRelocsAdd(
                relocs,
                0,
                int64(plan.relocWordOffsets[relocIndex]),
                targetIndex,
                orel.ObjectRelocBranch26,
                int64(0),
                true),
            "direct object emit: add x86_64 canonical call relocation")
    for relocIndex in 0..<plan.dataRelocWordOffsets.len:
        let targetSymbol =
            plan.dataRelocTargetSymbols[relocIndex]
        let targetIndex =
            osym.ObjectSymbolsFind(symbols, targetSymbol)
        if targetIndex < 0:
            system.Assert(
                false,
                " direct object emit: x86_64 canonical data relocation symbol missing")
            return
        DirectObjectEmitRequireIndex(
            orel.ObjectRelocsAdd(
                relocs,
                0,
                int64(plan.dataRelocWordOffsets[relocIndex]),
                targetIndex,
                orel.ObjectRelocPcRel32,
                int64(0),
                true),
            "direct object emit: add x86_64 canonical data relocation")

# x86_64 BodyIR functions: segment-b makes relocWordOffsets/dataRelocWordOffsets
# hold ABSOLUTE BYTE offsets for x86 (functions stay word-aligned so the byte
# base = functionWordOffsets[fi]*4). Find the owning function in the byte domain
# and emit the byte offset directly (no ×4).
@borrows
fn DirectObjectEmitX64PlanBodyIRRelocsInto(plan: pobj.PrimaryObjectPlan,
                                           symbols: var osym.ObjectSymbolTable,
                                           relocs: var orel.ObjectRelocTable) =
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    var fi = 0
    for relocIndex in 0..<plan.relocTargetSymbols.len:
        if relocIndex >= plan.relocWordOffsets.len:
            continue
        let relocByteOffset = plan.relocWordOffsets[relocIndex]
        while fi < functionCount &&
              relocByteOffset >= (plan.functionWordOffsets[fi] + plan.functionWordCounts[fi]) * 4:
            fi = fi + 1
        if fi >= functionCount:
            continue
        if relocByteOffset < plan.functionWordOffsets[fi] * 4:
            continue
        if !DirectObjectEmitX64FunctionHasBodyIR(plan, fi):
            continue
        DirectObjectEmitAddBranchReloc(relocs,
                                       symbols,
                                       int64(relocByteOffset),
                                       plan.relocTargetSymbols[relocIndex])
    var dfi = 0
    for relocIndex2 in 0..<plan.dataRelocTargetSymbols.len:
        if relocIndex2 >= plan.dataRelocWordOffsets.len:
            continue
        let dataRelocByteOffset = plan.dataRelocWordOffsets[relocIndex2]
        while dfi < functionCount &&
              dataRelocByteOffset >= (plan.functionWordOffsets[dfi] + plan.functionWordCounts[dfi]) * 4:
            dfi = dfi + 1
        if dfi >= functionCount:
            continue
        if dataRelocByteOffset < plan.functionWordOffsets[dfi] * 4:
            continue
        if !DirectObjectEmitX64FunctionHasBodyIR(plan, dfi):
            continue
        DirectObjectEmitAddPcRel32Reloc(relocs,
                                        symbols,
                                        int64(dataRelocByteOffset),
                                        plan.dataRelocTargetSymbols[relocIndex2])

@borrows
fn DirectObjectEmitX64PlanRelocsInto(plan: pobj.PrimaryObjectPlan,
                                     symbols: var osym.ObjectSymbolTable,
                                     relocs: var orel.ObjectRelocTable) =
    relocs.items = []
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    DirectObjectEmitX64PlanBodyIRRelocsInto(plan, symbols, relocs)
    for i in 0..<functionCount:
        if DirectObjectEmitX64FunctionHasBodyIR(plan, i):
            continue
        let baseByteOffset = plan.functionWordOffsets[i] * 4
        if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, i):
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 14),
                                           DirectObjectEmitEntryBridgeSetCmdLineSymbol(plan))
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 27),
                                           DirectObjectEmitEntryBridgeLineMapSymbol(plan))
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 41),
                                           DirectObjectEmitEntryBridgeTargetSymbol(plan))
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 58),
                                           DirectObjectEmitEntryBridgeProfileFlushSymbol(plan))
            continue
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeSetCmdLine:
            DirectObjectEmitAddPcRel32Reloc(relocs,
                                            symbols,
                                            int64(baseByteOffset + 3),
                                            DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argc"))
            DirectObjectEmitAddPcRel32Reloc(relocs,
                                            symbols,
                                            int64(baseByteOffset + 12),
                                            DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argv"))
            continue
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamCount:
            DirectObjectEmitAddPcRel32Reloc(relocs,
                                            symbols,
                                            int64(baseByteOffset + 3),
                                            DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argc"))
            continue
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamStrCopyBridge:
            DirectObjectEmitAddPcRel32Reloc(relocs,
                                            symbols,
                                            int64(baseByteOffset + 11),
                                            DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argc"))
            DirectObjectEmitAddPcRel32Reloc(relocs,
                                            symbols,
                                            int64(baseByteOffset + 36),
                                            DirectObjectEmitDataLabelByTail(plan, "__cheng_saved_argv"))
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 73),
                                           DirectObjectEmitTargetSymbolName(plan.targetTriple, "strlen"))
            continue
        var callThenTarget = ""
        var callThenValue: int32
        if DirectObjectEmitX64BodyIRSingleNoargCallThenI32Const(plan,
                                                                i,
                                                                callThenTarget,
                                                                callThenValue):
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 5),
                                           callThenTarget)
            continue
        var cstringCallTarget = ""
        var cstringLiteralLabel = ""
        if DirectObjectEmitX64BodyIRSingleCStringCallReturnResult(plan,
                                                                  i,
                                                                  cstringCallTarget,
                                                                  cstringLiteralLabel):
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 3),
                                           cstringLiteralLabel)
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 12),
                                           cstringCallTarget)
            continue
        var ltZeroTarget = ""
        var ltZeroValue: int32
        var geZeroValue: int32
        if DirectObjectEmitX64BodyIRCallLtZeroSelectReturn(plan,
                                                           i,
                                                           ltZeroTarget,
                                                           ltZeroValue,
                                                           geZeroValue):
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 5),
                                           ltZeroTarget)
            continue
        var callTarget = ""
        var callArgCount: int32
        if DirectObjectEmitWasmFunctionSingleCallTarget(plan, i, callTarget, callArgCount):
            DirectObjectEmitAddBranchReloc(relocs,
                                           symbols,
                                           int64(baseByteOffset + 1),
                                           callTarget)
            continue
        if i < plan.functionBodyKinds.len &&
           texpr.TypedExprIsReturnCallBodyKind(plan.functionBodyKinds[i]) &&
           i < plan.itemIds.len:
            let targetSymbol = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[i], 0)
            if Len(targetSymbol) > 0:
                DirectObjectEmitAddBranchReloc(relocs,
                                               symbols,
                                               int64(baseByteOffset + 1),
                                               targetSymbol)

@borrows
fn DirectObjectEmitPlanRelocs(plan: pobj.PrimaryObjectPlan,
                               symbols: var osym.ObjectSymbolTable): orel.ObjectRelocTable =
    if DirectObjectEmitX64Triple(plan.targetTriple):
        var x64Relocs = orel.ObjectRelocsInit()
        DirectObjectEmitX64CanonicalPlanRelocsInto(
            plan, symbols, x64Relocs)
        return x64Relocs
    var relocs = orel.ObjectRelocsInit()
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    for relocIndex in 0..<plan.relocTargetSymbols.len:
        if relocIndex >= plan.relocWordOffsets.len:
            continue
        DirectObjectEmitAddTargetCallReloc(
            plan.targetTriple,
            relocs,
            symbols,
            int64(plan.relocWordOffsets[relocIndex] * 4),
            plan.relocTargetSymbols[relocIndex])
    for relocIndex2 in 0..<plan.dataRelocTargetSymbols.len:
        if relocIndex2 >= plan.dataRelocWordOffsets.len:
            continue
        DirectObjectEmitAddPageRelocPair(relocs,
                                         symbols,
                                         int64(plan.dataRelocWordOffsets[relocIndex2] * 4),
                                         plan.dataRelocTargetSymbols[relocIndex2],
                                         "direct object emit: add plan data page reloc")
    for i in 0..<functionCount:
        let functionByteOffset = int64(plan.functionWordOffsets[i] * 4)
        let cstringCallCount = DirectObjectEmitCstringLiteralCallCount(plan, i)
        for callOrdinal in 0..<cstringCallCount:
            let literalSymbol = DirectObjectEmitDataLabelExact(plan,
                                                               DirectObjectEmitCStringLiteralDataLabel(DirectObjectEmitPlanSymbolNameAt(plan, i),
                                                                                                       callOrdinal))
            let callByteOffset = functionByteOffset + int64((2 + callOrdinal * 3) * 4)
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             callByteOffset,
                                             literalSymbol,
                                             "direct object emit: add plan cstring page reloc")
        if plan.functionBodyKinds[i] == texpr.BodyKindReturnStrLiteral:
            let returnLiteralLabel = strutil.Join([DirectObjectEmitPlanSymbolNameAt(plan, i), "__cheng_return_str_literal"], "")
            let literalSymbol = DirectObjectEmitDataLabelExact(plan,
                                                               returnLiteralLabel)
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(8),
                                             literalSymbol,
                                             "direct object emit: add plan return str literal page reloc")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeSetCmdLine:
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset,
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 0),
                                             "direct object emit: add plan argc page reloc")
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(12),
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 1),
                                             "direct object emit: add plan argv page reloc")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamCount:
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset,
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 0),
                                             "direct object emit: add plan param-count argc page reloc")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamStrCopyBridge:
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(12),
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 0),
                                             "direct object emit: add plan param-str argc page reloc")
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(40),
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 1),
                                             "direct object emit: add plan param-str argv page reloc")
    return relocs

@borrows
fn DirectObjectEmitPlanRelocsInto(plan: pobj.PrimaryObjectPlan,
                                  symbols: var osym.ObjectSymbolTable,
                                  relocs: var orel.ObjectRelocTable) =
    relocs.items = []
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_relocs_into_enter")
    if DirectObjectEmitX64Triple(plan.targetTriple):
        DirectObjectEmitX64CanonicalPlanRelocsInto(
            plan, symbols, relocs)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_relocs_x64_done")
        return
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    for relocIndex in 0..<plan.relocTargetSymbols.len:
        if relocIndex >= plan.relocWordOffsets.len:
            continue
        DirectObjectEmitAddTargetCallReloc(
            plan.targetTriple,
            relocs,
            symbols,
            int64(plan.relocWordOffsets[relocIndex] * 4),
            plan.relocTargetSymbols[relocIndex])
    for relocIndex2 in 0..<plan.dataRelocTargetSymbols.len:
        if relocIndex2 >= plan.dataRelocWordOffsets.len:
            continue
        DirectObjectEmitAddPageRelocPair(relocs,
                                         symbols,
                                         int64(plan.dataRelocWordOffsets[relocIndex2] * 4),
                                         plan.dataRelocTargetSymbols[relocIndex2],
                                         "direct object emit: add plan data page reloc")
    for i in 0..<functionCount:
        let functionByteOffset = int64(plan.functionWordOffsets[i] * 4)
        let cstringCallCount = DirectObjectEmitCstringLiteralCallCount(plan, i)
        for callOrdinal in 0..<cstringCallCount:
            let literalSymbol = DirectObjectEmitDataLabelExact(plan,
                                                               DirectObjectEmitCStringLiteralDataLabel(DirectObjectEmitPlanSymbolNameAt(plan, i),
                                                                                                       callOrdinal))
            let callByteOffset = functionByteOffset + int64((2 + callOrdinal * 3) * 4)
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             callByteOffset,
                                             literalSymbol,
                                             "direct object emit: add plan cstring page reloc")
        if plan.functionBodyKinds[i] == texpr.BodyKindReturnStrLiteral:
            let returnLiteralLabel = strutil.Join([DirectObjectEmitPlanSymbolNameAt(plan, i), "__cheng_return_str_literal"], "")
            let literalSymbol = DirectObjectEmitDataLabelExact(plan,
                                                               returnLiteralLabel)
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(8),
                                             literalSymbol,
                                             "direct object emit: add plan return str literal page reloc")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeSetCmdLine:
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset,
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 0),
                                             "direct object emit: add plan argc page reloc")
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(12),
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 1),
                                             "direct object emit: add plan argv page reloc")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamCount:
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset,
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 0),
                                             "direct object emit: add plan param-count argc page reloc")
        if i < plan.functionBodyKinds.len &&
           plan.functionBodyKinds[i] == texpr.BodyKindRuntimeParamStrCopyBridge:
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(12),
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 0),
                                             "direct object emit: add plan param-str argc page reloc")
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(40),
                                             DirectObjectEmitRuntimeDataLabelForOrdinal(plan, 1),
                                             "direct object emit: add plan param-str argv page reloc")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_relocs_into_done")

@borrows
fn DirectObjectEmitReturnZeroObject(rootDir: str,
                                     outputPath: str,
                                     symbolNames: str[]): Result[DirectObjectEmitResult] =
    if symbolNames.len <= 0:
        return Err[DirectObjectEmitResult](" direct object emit: missing symbols")
    var text = DirectObjectEmitReturnZeroText(symbolNames)
    defer:
        rawbytes.BytesFree(text)
    let symbols = DirectObjectEmitReturnZeroSymbols(symbolNames)
    var relocs = orel.ObjectRelocsInit()
    let writeRes = macho_object_writer.MachOTextObjectWrite(rootDir,
                                              outputPath,
                                              text,
                                              symbols,
                                              relocs)
    if !writeRes.ok:
        let ownedErrMsg13 = strings.CloneStr(writeRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg13)
    let write = writeRes.value
    var out: DirectObjectEmitResult
    out.objectPath = write.objectPath
    out.outputKind = DirectObjectEmitOutputKindObject()
    out.bytesWritten = write.bytesWritten
    out.symbolCount = write.symbolCount
    out.relocCount = write.relocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    return Ok[DirectObjectEmitResult](out)

@borrows
fn DirectObjectEmitPlanObject(rootDir: str,
                              plan: pobj.PrimaryObjectPlan): Result[DirectObjectEmitResult] =
    var out: DirectObjectEmitResult
    var err: str
    if !DirectObjectEmitPlanObjectInto(rootDir, plan, out, err):
        return Err[DirectObjectEmitResult](err)
    return Ok[DirectObjectEmitResult](out)

@borrows
fn DirectObjectEmitPlanObjectBytesInto(
        plan: pobj.PrimaryObjectPlan,
        text: var Bytes,
        data: var Bytes,
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable,
        outBytes: var Bytes,
        outRelocCount: var int32,
        outErr: var str): bool =
    outErr = ""
    outRelocCount = orel.ObjectRelocsCount(relocs)
    var debug: debugsections.DirectObjectDebugSections
    var debugErr: str
    if !DirectObjectEmitBuildDebugSectionsInto(
           plan, symbols, debug, debugErr):
        outErr = debugErr
        return false
    defer:
        if debug.valid:
            debugsections.DirectObjectDebugSectionsRelease(debug)
    if debug.valid && plan.objectFormat != "macho":
        outErr =
            " direct object emit: ELF/COFF debug sections not implemented"
        return false
    var bytesRes: Result[Bytes]
    if plan.objectFormat == "macho":
        if debug.valid:
            bytesRes = macho_object_writer.MachOTextDataDebugObjectBytes(
                text, data, symbols, relocs, debug)
        else:
            bytesRes = macho_object_writer.MachOTextDataObjectBytes(
                text, data, symbols, relocs)
    elif plan.objectFormat == "elf" &&
         contract.CodegenElfTextDataWriterUnit(plan.targetTriple) ==
             contract.CodegenUnitX64:
        bytesRes = wunits.CodegenWriterUnitTextDataObjectBytes(
            contract.CodegenUnitX64, text, data, symbols, relocs)
    elif plan.objectFormat == "elf" &&
         (plan.targetTriple == "aarch64-unknown-linux-gnu" ||
          plan.targetTriple == "arm64-unknown-linux-gnu" ||
          plan.targetTriple == "aarch64-linux-android" ||
          plan.targetTriple == "aarch64-linux-ohos" ||
          plan.targetTriple == "aarch64-unknown-linux-ohos"):
        bytesRes = elf_object_writer.ElfTextDataObjectBytes(
            text, data, symbols, relocs)
    elif plan.objectFormat == "coff":
        bytesRes = coff_object_writer.CoffTextDataObjectBytes(
            text, data, symbols, relocs)
    else:
        outErr = Fmt" direct object emit: unsupported target object format target={plan.targetTriple} format={plan.objectFormat}"
        return false
    if !bytesRes.ok:
        outErr = strings.CloneStr(bytesRes.err.msg)
        return false
    outBytes = rawbytes.BytesTake(bytesRes.value)
    if debug.valid:
        outRelocCount = outRelocCount + debug.relocations.len
        var parsed: machodebugevidence.MachODebugSectionEvidence
        var parseErr: str
        if !machodebugevidence.MachODebugSectionEvidenceBuildInto(
               outBytes, debug, symbols, parsed, parseErr):
            rawbytes.BytesFree(outBytes)
            outErr = parseErr
            return false
    return true

@borrows
fn DirectObjectEmitCommitReplayedObjectInto(
        rootDir: str,
        plan: pobj.PrimaryObjectPlan,
        objectBytes: Bytes,
        expectedObjectSha256: str,
        expectedObjectByteCount: int32,
        symbolCount: int32,
        relocCount: int32,
        out: var DirectObjectEmitResult,
        outErr: var str): bool =
    out = DirectObjectEmitResult()
    outErr = ""
    let validRes = DirectObjectEmitValidatePlanObject(plan)
    if !validRes.ok:
        outErr = validRes.err.msg
        return false
    let objectByteCount = rawbytes.BytesLen(objectBytes)
    if objectByteCount <= 0 ||
       expectedObjectByteCount != objectByteCount ||
       symbolCount <= 0 || relocCount < 0:
        outErr = " direct object emit: replay receipt invalid"
        return false
    let actualObjectSha256 =
        strings.ConcatStr(
            "sha256:",
            layout.FixedBytes32Hex(
                hash256.Sha256Fixed(
                    layout.ByteSpanFromBytes(objectBytes))))
    if actualObjectSha256 != expectedObjectSha256:
        outErr = " direct object emit: replay object hash mismatch"
        return false
    # The seven-stage receipt observes the admitted replay bytes before their
    # only production write.
    if !pobj.PrimaryObjectPlanSevenStageReceiptObserveObjectBytes(
           plan, objectBytes):
        outErr =
            " direct object emit: seven-stage object observation failed"
        return false
    var objectPath = strings.CloneStr(plan.outputPath)
    if ssr.SevenStageReceiptActive() &&
       plan.actualBackendKind == "backend2":
        objectPath = ssr.SevenStageReceiptLaneObjectPath(
            ssr.SevenStageReceiptLaneBackend2)
        if objectPath == "":
            outErr =
                " direct object emit: backend2 transaction object path missing"
            return false
    if !DirectObjectEmitPublishObjectBytes(rootDir, objectPath, objectBytes):
        outErr = Fmt" direct object emit: atomic publish failed for object: {objectPath}"
        return false
    out.objectPath = objectPath
    out.outputKind = DirectObjectEmitOutputKindObject()
    out.bytesWritten = objectByteCount
    out.symbolCount = symbolCount
    out.relocCount = relocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    var sealErr: str
    if !DirectObjectEmitSealObjectIdentityInto(
           rootDir, plan,
           expectedObjectSha256, expectedObjectByteCount,
           out, sealErr):
        outErr = sealErr
        return false
    return true

@borrows
fn DirectObjectEmitPlanObjectInto(rootDir: str,
                                  plan: pobj.PrimaryObjectPlan,
                                  out: var DirectObjectEmitResult,
                                  outErr: var str): bool =
    outErr = ""
    let validRes = DirectObjectEmitValidatePlanObject(plan)
    if !validRes.ok:
        outErr = validRes.err.msg
        return false
    var text = DirectObjectEmitPlanText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data = DirectObjectEmitPlanData(
        plan, plan.functionBodyKinds.len)
    defer:
        rawbytes.BytesFree(data)
    var symbols: osym.ObjectSymbolTable
    DirectObjectEmitPlanSymbolsInto(plan, plan.targetTriple, symbols)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_symbols")
    var relocs: orel.ObjectRelocTable
    DirectObjectEmitPlanRelocsInto(plan, symbols, relocs)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_relocs")
    var objectBytes: Bytes
    var objectRelocCount: int32
    if !DirectObjectEmitPlanObjectBytesInto(
           plan, text, data, symbols, relocs,
           objectBytes, objectRelocCount, outErr):
        return false
    defer:
        rawbytes.BytesFree(objectBytes)
    # The receipt sees the exact final container buffer produced by the
    # production writer, including headers, sections, relocations and symbols.
    # Observation happens before the only write of these bytes.
    if !pobj.PrimaryObjectPlanSevenStageReceiptObserveObjectBytes(
           plan, objectBytes):
        outErr =
            " direct object emit: seven-stage object observation failed"
        return false
    var objectPath = plan.outputPath
    if ssr.SevenStageReceiptActive() &&
       plan.actualBackendKind == "backend2":
        objectPath = ssr.SevenStageReceiptLaneObjectPath(
            ssr.SevenStageReceiptLaneBackend2)
        if objectPath == "":
            outErr =
                " direct object emit: backend2 transaction object path missing"
            return false
    let expectedObjectSha256 = strings.ConcatStr(
        "sha256:",
        layout.FixedBytes32Hex(
            hash256.Sha256Fixed(
                layout.ByteSpanFromBytes(objectBytes))))
    if !DirectObjectEmitPublishObjectBytes(rootDir, objectPath, objectBytes):
        outErr = Fmt" direct object emit: atomic publish failed for object: {objectPath}"
        return false
    out.objectPath = objectPath
    out.outputKind = DirectObjectEmitOutputKindObject()
    out.bytesWritten = rawbytes.BytesLen(objectBytes)
    out.symbolCount = osym.ObjectSymbolsCount(symbols)
    out.relocCount = objectRelocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    var sealErr: str
    if !DirectObjectEmitSealObjectIdentityInto(
           rootDir, plan,
           expectedObjectSha256, rawbytes.BytesLen(objectBytes),
           out, sealErr):
        outErr = sealErr
        return false
    return true

@borrows
fn DirectObjectEmitPlanObjectPathInto(rootDir: str,
                                      plan: pobj.PrimaryObjectPlan,
                                      outObjectPath: var str,
                                      outErr: var str): bool =
    if ssr.SevenStageReceiptActive():
        var observedResult: DirectObjectEmitResult
        if !DirectObjectEmitPlanObjectInto(
               rootDir, plan, observedResult, outErr):
            return false
        outObjectPath = observedResult.objectPath
        return true
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_into_enter")
    if !DirectObjectEmitValidatePlanObjectInto(plan, outErr):
        return false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_validate")
    var text: Bytes
    DirectObjectEmitPlanTextInto(plan, text)
    defer:
        rawbytes.BytesFree(text)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_text")
    var data: Bytes
    DirectObjectEmitPlanDataInto(plan, plan.functionBodyKinds.len, data)
    defer:
        rawbytes.BytesFree(data)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_data")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_before_symbols_var")
    var symbols: osym.ObjectSymbolTable
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_symbols_var")
    DirectObjectEmitPlanSymbolsInto(plan, plan.targetTriple, symbols)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_symbols")
    var relocs: orel.ObjectRelocTable
    DirectObjectEmitPlanRelocsInto(plan, symbols, relocs)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_relocs")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_before_write")
    let ownedFormat = strings.CloneStr(plan.objectFormat)
    if !DirectObjectEmitWriteObjectPathForFormatInto(rootDir,
                                                     plan,
                                                     ownedFormat,
                                                     text,
                                                     data,
                                                     symbols,
                                                     relocs,
                                                     outObjectPath,
                                                     outErr):
        return false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=direct_path_after_write")
    return true

@borrows
fn DirectObjectEmitPlanObjectForTarget(rootDir: str,
                                       plan: pobj.PrimaryObjectPlan,
                                       targetTriple: str,
                                       objectFormat: str): Result[DirectObjectEmitResult] =
    let validRes = DirectObjectEmitValidatePlanObjectForTarget(plan, targetTriple, objectFormat)
    if !validRes.ok:
        let ownedErrMsg14 = strings.CloneStr(validRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg14)
    var text = DirectObjectEmitPlanText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data = DirectObjectEmitPlanData(
        plan, plan.functionBodyKinds.len)
    defer:
        rawbytes.BytesFree(data)
    var symbols = DirectObjectEmitPlanSymbolsForTarget(plan, targetTriple)
    var relocs = DirectObjectEmitPlanRelocs(plan, symbols)
    var write: DirectObjectEmitResult
    var writeErr: str
    if !DirectObjectEmitWriteObjectForFormat(rootDir, plan, objectFormat, text, data, symbols, relocs, write, writeErr):
        return Err[DirectObjectEmitResult](writeErr)
    return Ok[DirectObjectEmitResult](write)

@borrows
fn DirectObjectEmitStandaloneMain(rootDir: str,
                                   plan: pobj.PrimaryObjectPlan): Result[DirectObjectEmitResult] =
    let validRes = DirectObjectEmitValidateStandaloneMain(plan)
    if !validRes.ok:
        let ownedMsg = strings.CloneStr(validRes.err.msg)
        return Err[DirectObjectEmitResult](ownedMsg)
    return DirectObjectEmitWriteStandaloneMain(rootDir, plan)

@borrows
fn DirectObjectEmitStandaloneMainForTarget(rootDir: str,
                                           plan: pobj.PrimaryObjectPlan,
                                           targetTriple: str,
                                           objectFormat: str): Result[DirectObjectEmitResult] =
    let _ = targetTriple
    let _ = objectFormat
    return DirectObjectEmitStandaloneMain(rootDir, plan)

@borrows
fn DirectObjectEmitLinkerlessExecutable(rootDir: str,
                                         plan: pobj.PrimaryObjectPlan,
                                         outputPath: str): Result[DirectObjectEmitResult] =
    if !(plan.targetTriple == "arm64-apple-darwin" && plan.objectFormat == "macho"):
        return Err[DirectObjectEmitResult](Fmt" direct object emit: linkerless executable unsupported target: {plan.targetTriple}")
    if Len(outputPath) <= 0:
        return Err[DirectObjectEmitResult](" direct object emit: linkerless executable missing output path")
    let validRes = DirectObjectEmitValidateStandaloneExecutable(plan)
    if !validRes.ok:
        let ownedErrMsg15 = strings.CloneStr(validRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg15)
    var text = DirectObjectEmitStandaloneText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data = DirectObjectEmitPlanData(
        plan, DirectObjectEmitRealFunctionLimit(plan))
    defer:
        rawbytes.BytesFree(data)
    let entryTextOffset = DirectObjectEmitStandaloneEntryTextOffset(plan)
    if entryTextOffset < 0:
        return Err[DirectObjectEmitResult](" direct object emit: linkerless executable missing entry offset")
    let dataSize = BytesLen(data)
    var writeRes: Result[macho_object_writer.MachOObjectWriterResult]
    if dataSize > 0:
        writeRes = macho_object_writer.MachOTextDataExecutableWrite(rootDir, outputPath, text, data, entryTextOffset)
    else:
        writeRes = macho_object_writer.MachOTextExecutableWrite(rootDir, outputPath, text, entryTextOffset)
    if !writeRes.ok:
        let ownedErrMsg16 = strings.CloneStr(writeRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg16)
    let write = writeRes.value
    var out: DirectObjectEmitResult
    out.objectPath = write.objectPath
    out.outputKind = DirectObjectEmitOutputKindExecutable()
    out.bytesWritten = write.bytesWritten
    out.symbolCount = 0
    out.relocCount = 0
    out.linkerlessImage = 1
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    return Ok[DirectObjectEmitResult](out)
