    obuf.ObjectBufferWriteU8(out, int32(0x8b))
    obuf.ObjectBufferWriteU8(out, int32(0x3f))
    DirectObjectEmitX64WriteCallPlaceholder(out)
    obuf.ObjectBufferWriteU8(out, int32(0x8b))
    obuf.ObjectBufferWriteU8(out, int32(0x44))
    obuf.ObjectBufferWriteU8(out, int32(0x24))
    obuf.ObjectBufferWriteU8(out, int32(0x10))
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xc4))
    obuf.ObjectBufferWriteU8(out, int32(0x18))
    DirectObjectEmitX64WriteRet(out)

fn DirectObjectEmitX64WriteLeaRaxRip(out: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x8d))
    obuf.ObjectBufferWriteU8(out, int32(0x05))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))

# cheng_runtime_set_cmd_line(argc: edi, argv: rsi): 20 bytes.
fn DirectObjectEmitX64WriteRuntimeSetCmdLine(out: var obuf.ObjectBuffer) =
    DirectObjectEmitX64WriteLeaRaxRip(out)
    obuf.ObjectBufferWriteU8(out, int32(0x89))
    obuf.ObjectBufferWriteU8(out, int32(0x38))
    DirectObjectEmitX64WriteLeaRaxRip(out)
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x89))
    obuf.ObjectBufferWriteU8(out, int32(0x30))
    DirectObjectEmitX64WriteRet(out)

# cheng_runtime_param_count(): full argc in eax (matches cold / dispatch_min).
fn DirectObjectEmitX64WriteRuntimeParamCount(out: var obuf.ObjectBuffer) =
    DirectObjectEmitX64WriteLeaRaxRip(out)
    obuf.ObjectBufferWriteU8(out, int32(0x8b))
    obuf.ObjectBufferWriteU8(out, int32(0x00))
    DirectObjectEmitX64WriteRet(out)

