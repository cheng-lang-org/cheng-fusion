type
    DirectObjectEmitResult =
        objectPath: str
        outputKind: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32
        linkerlessImage: int32
        systemLink: int32
        directObjectLayoutMs: int64
        directObjectEmitMs: int64
        # Writer attestation for the debug emission receipt: sha256 of the
        # exact object bytes and the __text/.text section file offset parsed
        # from those bytes.  Sealed by DirectObjectEmitSealObjectIdentityInto
        # whenever the plan publishes debug emission evidence; the receipt
        # validator recomputes both from the same bytes.
        objectCid: layout.FixedBytes32
        textSectionFileOffset: int32

fn DirectObjectEmitOutputKindObject(): str =
    return "object"

fn DirectObjectEmitOutputKindExecutable(): str =
    return "executable"

fn DirectObjectEmitZeroMs(): int64 =
    return int64(0)

@borrows
fn DirectObjectEmitPublishObjectBytes(rootDir: str,
                                      objectPath: str,
                                      data: rawbytes.Bytes): bool =
    if objectPath.len <= 0 || data.len <= 0 || data.data == nil:
        return false
    let path = chengpath.PathAbsolute(rootDir, objectPath)
    if path.len <= 0:
        return false
    var owned = rawbytes.BytesAlloc(data.len)
    if owned.data == nil || owned.len != data.len:
        rawbytes.BytesFree(owned)
        return false
    rawmem_support.RawmemCopy(owned.data, data.data, data.len)
    let ok = LinkerCoreWriteRawBytesAtomic(path, owned)
    rawbytes.BytesFree(owned)
    return ok

fn DirectObjectEmitStatementReturnModeI32Const(): int32 =
    return 1

@borrows
fn DirectObjectEmitTargetSymbolName(targetTriple: str,
                                    raw: str): str =
    if raw == "std/system::assert":
        return DirectObjectEmitTargetSymbolNameResolved(targetTriple, "assert")
    if raw == "std/system::Assert":
        return DirectObjectEmitTargetSymbolNameResolved(targetTriple, "Assert")
    return DirectObjectEmitTargetSymbolNameResolved(targetTriple, raw)

@borrows
fn DirectObjectEmitTargetSymbolNameResolved(targetTriple: str,
                                            symbolRaw: str): str =
    if targetTriple == "arm64-apple-darwin" ||
       targetTriple == "aarch64-apple-ios" ||
       targetTriple == "arm64-apple-ios":
        if len(symbolRaw) >= 2 && symbolRaw[0] == 'L' && symbolRaw[1] == '_':
            return strings.CloneStr(symbolRaw)
        return Fmt"_{symbolRaw}"
    return strings.CloneStr(symbolRaw)

@borrows
fn DirectObjectEmitTargetObjectSupported(targetTriple: str,
                                          objectFormat: str): bool =
    if targetTriple == "arm64-apple-darwin" && objectFormat == "macho":
        return true
    if targetTriple == "aarch64-unknown-linux-gnu" && objectFormat == "elf":
        return true
    if targetTriple == "arm64-unknown-linux-gnu" && objectFormat == "elf":
        return true
    if targetTriple == "aarch64-linux-android" && objectFormat == "elf":
        return true
    if targetTriple == "aarch64-linux-ohos" && objectFormat == "elf":
        return true
    if targetTriple == "aarch64-unknown-linux-ohos" && objectFormat == "elf":
        return true
    if targetTriple == "x86_64-unknown-linux-gnu" && objectFormat == "elf":
        return true
    if targetTriple == "x86_64-pc-windows-msvc" && objectFormat == "coff":
        return true
    if tmat.TargetIsRiscvCodegen(targetTriple) && objectFormat == "elf":
        return true
    return false

# Seal the writer-attested object identity columns after the object file is
# on disk: re-read the exact bytes, hash them, and parse the text section
# file offset through the same evidence builder the debug emission receipt
# validator uses, so writer and validator agree by construction.  Plans
# without published debug emission evidence have no receipt consumer and
# are left unsealed.
@borrows
fn DirectObjectEmitSealObjectIdentityInto(rootDir: str,
                                          plan: pobj.PrimaryObjectPlan,
                                          expectedObjectSha256: str,
                                          expectedObjectByteCount: int32,
                                          out: var DirectObjectEmitResult,
                                          err: var str): bool =
    err = ""
    var planEvidence: debugevidence.DebugEmissionPlanEvidence
    var evidenceErr: str
    if !pobj.PrimaryObjectPlanDebugEmissionEvidenceInto(
            plan, planEvidence, evidenceErr):
        return true
    let objectAbs = chengpath.PathAbsolute(rootDir, out.objectPath)
    var objectBuffer = bytes.ReadFileBytes(objectAbs)
    defer:
        bytes.FreeByteBuffer(objectBuffer)
    if objectBuffer.data == nil || objectBuffer.len <= 0:
        err = " direct object emit: seal object read failed"
        return false
    var objectBytes = rawbytes.BytesAlloc(objectBuffer.len)
    defer:
        rawbytes.BytesFree(objectBytes)
    if objectBytes.data == nil:
        err = " direct object emit: seal object allocation failed"
        return false
    rawmem_support.RawmemCopy(
        objectBytes.data, objectBuffer.data, objectBuffer.len)
    var evidence: objectevidence.DebugRelocatableObjectEvidence
    if !objectevidence.DebugRelocatableObjectEvidenceBuildInto(
            objectBytes,
            planEvidence.symbolNames,
            planEvidence.symbolByteStarts,
            planEvidence.symbolByteLengths,
            evidence,
            err):
        return false
    out.objectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(objectBytes))
    out.textSectionFileOffset = evidence.textSectionFileOffset
    if expectedObjectSha256 != "":
        let actualObjectSha256 = strings.ConcatStr(
            "sha256:",
            layout.FixedBytes32Hex(out.objectCid))
        if actualObjectSha256 != expectedObjectSha256 ||
           out.bytesWritten != expectedObjectByteCount:
            err = " direct object emit: seal object identity mismatch"
            return false
    return true

@borrows
fn DirectObjectEmitBuildDebugSectionsInto(
        plan: pobj.PrimaryObjectPlan,
        symbols: var osym.ObjectSymbolTable,
        out: var debugsections.DirectObjectDebugSections,
        err: var str): bool =
    out = debugsections.DirectObjectDebugSections()
    err = ""
    if !plan.debugSectionPlanConsumed:
        return true
    if plan.debugSectionPlanReceipt.backendKind != plan.actualBackendKind:
        err = " direct object emit: debug receipt backend split"
        return false
    if !debugsections.DirectObjectDebugSectionsBuildInto(
           plan.debugSectionPlanReceipt, symbols, out, err):
        debugsections.DirectObjectDebugSectionsRelease(out)
        return false
    if !debugsections.DirectObjectDebugSectionsStrictValidateInto(
           plan.debugSectionPlanReceipt, symbols, out, err):
        debugsections.DirectObjectDebugSectionsRelease(out)
        return false
    return true

@borrows
fn DirectObjectEmitWriteObjectTextOnly(rootDir: str,
                                        plan: pobj.PrimaryObjectPlan,
                                        text: Bytes,
                                        symbols: osym.ObjectSymbolTable,
                                        relocs: orel.ObjectRelocTable): Result[DirectObjectEmitResult] =
    var debug: debugsections.DirectObjectDebugSections
    var debugErr: str
    if !DirectObjectEmitBuildDebugSectionsInto(
           plan, symbols, debug, debugErr):
        return Err[DirectObjectEmitResult](debugErr)
    defer:
        if debug.valid:
            debugsections.DirectObjectDebugSectionsRelease(debug)
    if debug.valid && plan.objectFormat != "macho":
        return Err[DirectObjectEmitResult](
            " direct object emit: ELF/COFF debug sections not implemented")
    if plan.objectFormat == "elf":
        if contract.CodegenElfTextDataWriterUnit(plan.targetTriple) ==
           contract.CodegenUnitX64:
            let elfRes = wunits.CodegenWriterUnitTextObjectWrite(
                    contract.CodegenUnitX64,
                    rootDir,
                    plan.outputPath,
                    text,
                    symbols,
                    relocs)
            if !elfRes.ok:
                let ownedErrMsg1 = strings.CloneStr(elfRes.err.msg)
                return Err[DirectObjectEmitResult](ownedErrMsg1)
            var elfOut: DirectObjectEmitResult
            elfOut.objectPath = elfRes.value.objectPath
            elfOut.outputKind = DirectObjectEmitOutputKindObject()
            elfOut.bytesWritten = elfRes.value.bytesWritten
            elfOut.symbolCount = elfRes.value.symbolCount
            elfOut.relocCount = elfRes.value.relocCount
            elfOut.linkerlessImage = 0
            elfOut.systemLink = 0
            elfOut.directObjectEmitMs = DirectObjectEmitZeroMs()
            var elfSealErr: str
            if !DirectObjectEmitSealObjectIdentityInto(
                    rootDir, plan, "", int32(-1), elfOut, elfSealErr):
                return Err[DirectObjectEmitResult](elfSealErr)
            return Ok[DirectObjectEmitResult](elfOut)
        if plan.targetTriple == "aarch64-unknown-linux-gnu" ||
           plan.targetTriple == "arm64-unknown-linux-gnu" ||
           plan.targetTriple == "aarch64-linux-android" ||
           plan.targetTriple == "aarch64-linux-ohos" ||
           plan.targetTriple == "aarch64-unknown-linux-ohos":
            let elfRes = elf_object_writer.ElfTextObjectWrite(rootDir,
                                                              plan.outputPath,
                                                              text,
                                                              symbols,
                                                              relocs)
            if !elfRes.ok:
                let ownedErrMsg2 = strings.CloneStr(elfRes.err.msg)
                return Err[DirectObjectEmitResult](ownedErrMsg2)
            var elfOut: DirectObjectEmitResult
            elfOut.objectPath = elfRes.value.objectPath
            elfOut.outputKind = DirectObjectEmitOutputKindObject()
            elfOut.bytesWritten = elfRes.value.bytesWritten
            elfOut.symbolCount = elfRes.value.symbolCount
            elfOut.relocCount = elfRes.value.relocCount
            elfOut.linkerlessImage = 0
            elfOut.systemLink = 0
            elfOut.directObjectEmitMs = DirectObjectEmitZeroMs()
            var elfSealErr: str
            if !DirectObjectEmitSealObjectIdentityInto(
                    rootDir, plan, "", int32(-1), elfOut, elfSealErr):
                return Err[DirectObjectEmitResult](elfSealErr)
            return Ok[DirectObjectEmitResult](elfOut)
        # S4-D: ELF writer 契约查表未命中 → 规范报文 codegen_plugin_missing=<triple>
        var missingUnits: str[]
        return Err[DirectObjectEmitResult](
            contract.CodegenPluginMissingError(plan.targetTriple, missingUnits))
    if plan.objectFormat == "coff":
        let coffRes = coff_object_writer.CoffTextObjectWrite(rootDir,
                                                             plan.outputPath,
                                                             text,
                                                             symbols,
                                                             relocs)
        if !coffRes.ok:
            let ownedErrMsg3 = strings.CloneStr(coffRes.err.msg)
            return Err[DirectObjectEmitResult](ownedErrMsg3)
        var coffOut: DirectObjectEmitResult
        coffOut.objectPath = coffRes.value.objectPath
        coffOut.outputKind = DirectObjectEmitOutputKindObject()
        coffOut.bytesWritten = coffRes.value.bytesWritten
        coffOut.symbolCount = coffRes.value.symbolCount
        coffOut.relocCount = coffRes.value.relocCount
        coffOut.linkerlessImage = 0
        coffOut.systemLink = 0
        coffOut.directObjectEmitMs = DirectObjectEmitZeroMs()
        var coffSealErr: str
        if !DirectObjectEmitSealObjectIdentityInto(
                rootDir, plan, "", int32(-1), coffOut, coffSealErr):
            return Err[DirectObjectEmitResult](coffSealErr)
        return Ok[DirectObjectEmitResult](coffOut)
    var writeRes: Result[macho_object_writer.MachOObjectWriterResult]
    if debug.valid:
        writeRes = macho_object_writer.MachOTextDataDebugObjectWrite(
            rootDir, plan.outputPath, text, rawbytes.EmptyBytes(),
            symbols, relocs, debug)
    else:
        writeRes = macho_object_writer.MachOTextObjectWrite(
            rootDir, plan.outputPath, text, symbols, relocs)
    if !writeRes.ok:
        let ownedErrMsg4 = strings.CloneStr(writeRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg4)
    var out: DirectObjectEmitResult
    out.objectPath = writeRes.value.objectPath
    out.outputKind = DirectObjectEmitOutputKindObject()
    out.bytesWritten = writeRes.value.bytesWritten
    out.symbolCount = writeRes.value.symbolCount
    out.relocCount = writeRes.value.relocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    var sealErr: str
    if !DirectObjectEmitSealObjectIdentityInto(rootDir, plan, "", int32(-1), out, sealErr):
        return Err[DirectObjectEmitResult](sealErr)
    return Ok[DirectObjectEmitResult](out)

@borrows
fn DirectObjectEmitFillObjectResultInto(
        objectPath: str,
        bytesWritten: int32,
        symbolCount: int32,
        relocCount: int32,
        out: var DirectObjectEmitResult) =
    out.objectPath = strings.CloneStr(objectPath)
    out.outputKind = DirectObjectEmitOutputKindObject()
    out.bytesWritten = bytesWritten
    out.symbolCount = symbolCount
    out.relocCount = relocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()

@borrows
fn DirectObjectEmitWriteObjectForFormat(rootDir: str,
                                         plan: pobj.PrimaryObjectPlan,
                                         objectFormat: str,
                                         text: var Bytes,
                                         data: var Bytes,
                                          symbols: var osym.ObjectSymbolTable,
                                          relocs: var orel.ObjectRelocTable,
                                          out: var DirectObjectEmitResult,
                                          err: var str): bool =
    out = DirectObjectEmitResult()
    err = ""
    let ownedRoot = strings.CloneStr(rootDir)
    let ownedPath = strings.CloneStr(plan.outputPath)
    var debug: debugsections.DirectObjectDebugSections
    if !DirectObjectEmitBuildDebugSectionsInto(
           plan, symbols, debug, err):
        return false
    defer:
        if debug.valid:
            debugsections.DirectObjectDebugSectionsRelease(debug)
    if debug.valid && objectFormat != "macho":
        err = " direct object emit: ELF/COFF debug sections not implemented"
        return false
    if objectFormat == "elf":
        let tripleOwned = strings.CloneStr(plan.targetTriple)
        let writerUnit = contract.CodegenElfTextDataWriterUnit(tripleOwned)
        if writerUnit != contract.CodegenUnitInvalid:
            let elfRes = wunits.CodegenWriterUnitTextDataObjectWrite(
                    writerUnit, ownedRoot, ownedPath, text, data, symbols, relocs)
            if !elfRes.ok:
                err = elfRes.err.msg
                return false
            let ownedElfPath = strings.CloneStr(elfRes.value.objectPath)
            DirectObjectEmitFillObjectResultInto(
                ownedElfPath,
                elfRes.value.bytesWritten,
                elfRes.value.symbolCount,
                elfRes.value.relocCount,
                out)
            return DirectObjectEmitSealObjectIdentityInto(rootDir, plan, "", int32(-1), out, err)
        if plan.targetTriple == "aarch64-unknown-linux-gnu" ||
           plan.targetTriple == "arm64-unknown-linux-gnu" ||
           plan.targetTriple == "aarch64-linux-android" ||
           plan.targetTriple == "aarch64-linux-ohos" ||
           plan.targetTriple == "aarch64-unknown-linux-ohos":
            let elfRes = elf_object_writer.ElfTextDataObjectWrite(ownedRoot,
                                                                  ownedPath,
                                                                  text,
                                                                  data,
                                                                  symbols,
                                                                  relocs)
            if !elfRes.ok:
                err = elfRes.err.msg
                return false
            let ownedElfAarchPath = strings.CloneStr(elfRes.value.objectPath)
            DirectObjectEmitFillObjectResultInto(
                ownedElfAarchPath,
                elfRes.value.bytesWritten,
                elfRes.value.symbolCount,
                elfRes.value.relocCount,
                out)
            return DirectObjectEmitSealObjectIdentityInto(rootDir, plan, "", int32(-1), out, err)
        # S4-D: ELF writer 契约查表未命中 → 规范报文 codegen_plugin_missing=<triple>
        var missingUnits: str[]
        err = contract.CodegenPluginMissingError(plan.targetTriple, missingUnits)
        return false
    if objectFormat == "coff":
        let coffRes = coff_object_writer.CoffTextDataObjectWrite(ownedRoot,
                                                                 ownedPath,
                                                                 text,
                                                                 data,
                                                                 symbols,
                                                                 relocs)
        if !coffRes.ok:
            err = coffRes.err.msg
            return false
        let ownedCoffPath = strings.CloneStr(coffRes.value.objectPath)
        DirectObjectEmitFillObjectResultInto(
            ownedCoffPath,
            coffRes.value.bytesWritten,
            coffRes.value.symbolCount,
            coffRes.value.relocCount,
            out)
        return DirectObjectEmitSealObjectIdentityInto(rootDir, plan, "", int32(-1), out, err)
    if debug.valid:
        let debugWriteRes = macho_object_writer.MachOTextDataDebugObjectWrite(
            ownedRoot, ownedPath, text, data, symbols, relocs, debug)
        if !debugWriteRes.ok:
            err = debugWriteRes.err.msg
            return false
        let ownedDebugPath = strings.CloneStr(debugWriteRes.value.objectPath)
        DirectObjectEmitFillObjectResultInto(
            ownedDebugPath,
            debugWriteRes.value.bytesWritten,
            debugWriteRes.value.symbolCount,
            debugWriteRes.value.relocCount,
            out)
        return DirectObjectEmitSealObjectIdentityInto(rootDir, plan, "", int32(-1), out, err)
    let writeRes = macho_object_writer.MachOTextDataObjectWrite(
        ownedRoot, ownedPath, text, data, symbols, relocs)
    if !writeRes.ok:
        err = writeRes.err.msg
        return false
    let ownedMachoPath = strings.CloneStr(writeRes.value.objectPath)
    DirectObjectEmitFillObjectResultInto(
        ownedMachoPath,
        writeRes.value.bytesWritten,
        writeRes.value.symbolCount,
        writeRes.value.relocCount,
        out)
    return DirectObjectEmitSealObjectIdentityInto(rootDir, plan, "", int32(-1), out, err)

@borrows
fn DirectObjectEmitWriteObjectPathForFormatInto(rootDir: str,
                                                plan: pobj.PrimaryObjectPlan,
                                                objectFormat: str,
                                                text: var Bytes,
                                                data: var Bytes,
                                                symbols: var osym.ObjectSymbolTable,
                                                relocs: var orel.ObjectRelocTable,
                                                outObjectPath: var str,
                                                outErr: var str): bool =
    outObjectPath = ""
    outErr = ""
    let ownedRoot = strings.CloneStr(rootDir)
    let ownedPath = strings.CloneStr(plan.outputPath)
    if plan.debugSectionPlanConsumed:
        var debugWrite: DirectObjectEmitResult
        if !DirectObjectEmitWriteObjectForFormat(
            rootDir, plan, objectFormat, text, data, symbols, relocs,
            debugWrite, outErr):
            return false
        outObjectPath = strings.CloneStr(debugWrite.objectPath)
        return true
    if objectFormat == "elf":
        let tripleOwned = strings.CloneStr(plan.targetTriple)
        let writerUnit = contract.CodegenElfTextDataWriterUnit(tripleOwned)
        if writerUnit != contract.CodegenUnitInvalid:
            let elfRes = wunits.CodegenWriterUnitTextDataObjectWrite(
                    writerUnit, ownedRoot, ownedPath, text, data, symbols, relocs)
            if !elfRes.ok:
                outErr = elfRes.err.msg
                return false
            outObjectPath = elfRes.value.objectPath
            return true
        if plan.targetTriple == "aarch64-unknown-linux-gnu" ||
           plan.targetTriple == "arm64-unknown-linux-gnu" ||
           plan.targetTriple == "aarch64-linux-android" ||
           plan.targetTriple == "aarch64-linux-ohos" ||
           plan.targetTriple == "aarch64-unknown-linux-ohos":
            let elfRes = elf_object_writer.ElfTextDataObjectWrite(ownedRoot,
                                                                  ownedPath,
                                                                  text,
                                                                  data,
                                                                  symbols,
                                                                  relocs)
            if !elfRes.ok:
                outErr = elfRes.err.msg
                return false
            outObjectPath = elfRes.value.objectPath
            return true
        # S4-D: ELF writer 契约查表未命中 → 规范报文 codegen_plugin_missing=<triple>
        var missingUnits: str[]
        outErr = contract.CodegenPluginMissingError(plan.targetTriple, missingUnits)
        return false
    if objectFormat == "coff":
        return coff_object_writer.CoffTextDataObjectWritePathInto(ownedRoot,
                                                                  ownedPath,
                                                                  text,
                                                                  data,
                                                                  symbols,
                                                                  relocs,
                                                                  outObjectPath,
                                                                  outErr)
    var writeOut: DirectObjectEmitResult
    if !DirectObjectEmitWriteObjectForFormat(rootDir,
                                             plan,
                                             objectFormat,
                                             text,
                                             data,
                                             symbols,
                                             relocs,
                                             writeOut,
                                             outErr):
        return false
    outObjectPath = strings.CloneStr(writeOut.objectPath)
    return true

@borrows
fn DirectObjectEmitRequireIndex(index: int32, label: str) =
    if index < 0:
        system.Assert(false, strings.CloneStr(label))

@borrows
fn DirectObjectEmitInstructionWordsMaterialized(
        plan: pobj.PrimaryObjectPlan): bool =
    if plan.instructionWords.len <= 0:
        return false
    if DirectObjectEmitX64TargetFor(plan.targetTriple, plan.objectFormat):
        return true
    for i in 0..<plan.instructionWords.len:
        if plan.instructionWords[i] == 0:
            return false
    return true

@borrows
fn DirectObjectEmitInstructionWordsMissingReason(
        plan: pobj.PrimaryObjectPlan): str =
    if plan.instructionWords.len <= 0:
        return " direct object emit: missing instruction words: empty"
    for i in 0..<plan.instructionWords.len:
        if plan.instructionWords[i] == 0:
            var funcName = "?"
            var bodyKind = "?"
            var wordRel = i
            for fi in 0..<plan.functionWordOffsets.len:
                if fi >= plan.functionWordCounts.len:
                    continue
                let off = plan.functionWordOffsets[fi]
                let cnt = plan.functionWordCounts[fi]
                if cnt <= 0:
                    continue
                if i >= off && i < off + cnt:
                    if fi < plan.symbolNames.len:
                        funcName = plan.symbolNames[fi]
                    if fi < plan.functionBodyKinds.len:
                        bodyKind = plan.functionBodyKinds[fi]
                    wordRel = i - off
                    break
            return Fmt" direct object emit: missing instruction words: zero-word index={strings.IntToStr(i)} func={funcName} bodyKind={bodyKind} wordRel={strings.IntToStr(wordRel)}"
    return " direct object emit: missing instruction words"

@borrows
fn DirectObjectEmitIsReturnI32ConstBodyKind(bodyKind: str): bool =
    return chengpath.TextStartsWith(bodyKind, texpr.BodyKindReturnI32ConstPrefix)

@borrows
fn DirectObjectEmitIsLetCallNoargReturnI32ConstBodyKind(bodyKind: str): bool =
    return chengpath.TextStartsWith(bodyKind, texpr.BodyKindLetCallNoargReturnI32ConstPrefix)

@borrows
fn DirectObjectEmitExpectedWordsForPlanFunction(plan: pobj.PrimaryObjectPlan,
                                                 functionIndex: int32): int32 =
    if functionIndex < 0 || functionIndex >= plan.functionBodyKinds.len:
        return 0
    if functionIndex >= plan.functionWordCounts.len:
        return 0
    return plan.functionWordCounts[functionIndex]

@borrows
fn DirectObjectEmitBodyIRTermReturnI32Const(bodyIR: coreir.BodyIR,
                                             outValue: var int32): bool =
    if bodyIR.callSequence.len != 0:
        return false
    if bodyIR.blocks.len != 1:
        return false
    let block = bodyIR.blocks[0]
    if block.opCount != bodyIR.ops.len:
        return false
    if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
        return false
    let term = bodyIR.terms[block.termIndex]
    if term.kind != coreir.BodyTermReturnTag:
        return false
    if bodyIR.ops.len == 0:
        if term.resultSlot >= 0:
            return false
        if term.operands.len < 2:
            return false
        if term.operands[0] != DirectObjectEmitStatementReturnModeI32Const():
            return false
        outValue = term.operands[1]
        return true
    if bodyIR.ops.len != 1:
        return false
    if block.opStart != 0:
        return false
    let op = bodyIR.ops[0]
    if op.kind != coreir.BodyOpLoadConstTag:
        return false
    if op.operands.len < 2 ||
       op.operands[0] != coreir.LocalI32Tag:
        return false
    if op.target < 0 ||
       op.target >= bodyIR.localSlots.len ||
       bodyIR.localSlots[op.target].typeKind != coreir.LocalI32Tag:
        return false
    if term.resultSlot != op.target:
        return false
    if term.operands.len < 1 ||
       term.operands[0] != coreir.LocalI32Tag:
        return false
    outValue = op.operands[1]
    return true

@borrows
fn DirectObjectEmitBodyIRParamIndexForX64(bodyIR: coreir.BodyIR,
                                           slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return -1
    let slot = bodyIR.localSlots[slotIndex]
    if slot.typeKind != coreir.LocalI32Tag:
        return -1
    if slot.stackOffset >= 0:
        return -1
    let paramIndex = int32(0) - int32(1) - slot.stackOffset
    if paramIndex < 0 || paramIndex > 3:
        return -1
    return paramIndex

@borrows
fn DirectObjectEmitBodyIRAllTermsReturn(bodyIR: coreir.BodyIR): bool =
    if bodyIR.terms.len <= 0:
        return false
    for i in 0..<bodyIR.terms.len:
        if bodyIR.terms[i].kind != coreir.BodyTermReturnTag:
            return false
    return true

@borrows
fn DirectObjectEmitBodyIRHasReturnSlotI32(bodyIR: coreir.BodyIR,
                                           slotIndex: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    if bodyIR.localSlots[slotIndex].typeKind != coreir.LocalI32Tag:
        return false
    for i in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[i]
        if term.kind != coreir.BodyTermReturnTag:
            continue
        if term.resultSlot != slotIndex:
            continue
        return true
    return false

@borrows
fn DirectObjectEmitWasmBodyIRSingleCallReturnI32(plan: pobj.PrimaryObjectPlan,
                                                  functionIndex: int32,
                                                  outTarget: var str,
                                                  outArgCount: var int32): bool =
    outTarget = ""
    outArgCount = 0
    if functionIndex < 0 ||
       functionIndex >= plan.functionBodyIRs.len ||
       functionIndex >= plan.itemIds.len:
        return false
    let bodyIR = plan.functionBodyIRs[functionIndex]
    if bodyIR.callSequence.len != 1:
        return false
    if bodyIR.ops.len != 1 || bodyIR.blocks.len != 1:
        return false
    let block = bodyIR.blocks[0]
    if block.opStart != 0 || block.opCount != 1:
        return false
    if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
        return false
    let op = bodyIR.ops[0]
    if op.kind != coreir.BodyOpCallTag:
        return false
    if op.operands.len < 1 || op.operands[0] != 0:
        return false
    let call = bodyIR.callSequence[0]
    if op.target != call.resultSlot:
        return false
    if call.resultSlot < 0 ||
       call.resultSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[call.resultSlot].typeKind != coreir.LocalI32Tag:
        return false
    let term = bodyIR.terms[block.termIndex]
    if term.kind != coreir.BodyTermReturnTag:
        return false
    if term.resultSlot != call.resultSlot:
        return false
    if term.operands.len < 1 || term.operands[0] != coreir.LocalI32Tag:
        return false
    for argIndex in 0..<call.argSlots.len:
        let argSlot = call.argSlots[argIndex]
        if argSlot != argIndex ||
           argSlot < 0 ||
           argSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[argSlot].typeKind != coreir.LocalI32Tag:
            return false
    outArgCount = call.argSlots.len
    outTarget = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
    return Len(outTarget) > 0

@borrows
fn DirectObjectEmitX64BodyIRSingleI32BinOpReturn(bodyIR: coreir.BodyIR,
                                                  outOpKind: var int32,
                                                  outLhsParam: var int32,
                                                  outRhsParam: var int32): bool =
    outOpKind = int32(0)
    outLhsParam = int32(-1)
    outRhsParam = int32(-1)
    if bodyIR.callSequence.len != 0:
        return false
    if bodyIR.blocks.len < 1 || bodyIR.ops.len != 1:
        return false
    let block = bodyIR.blocks[0]
    if block.opStart != 0 || block.opCount != 1:
        return false
    if !DirectObjectEmitBodyIRAllTermsReturn(bodyIR):
        return false
    let op = bodyIR.ops[0]
    if op.kind != coreir.BodyOpBinOpTag:
        return false
    if op.operands.len < 4:
        return false
    if op.operands[0] != coreir.LocalI32Tag:
        return false
    if !DirectObjectEmitBodyIRHasReturnSlotI32(bodyIR, op.target):
        return false
    let opKind = op.operands[1]
    if opKind != int32(texpr.TypedExprIrOpI32Add) &&
       opKind != int32(texpr.TypedExprIrOpI32Sub) &&
       opKind != int32(texpr.TypedExprIrOpI32Mul) &&
       opKind != int32(texpr.TypedExprIrOpI32Asr):
        return false
    let lhsParam = DirectObjectEmitBodyIRParamIndexForX64(bodyIR, op.operands[2])
    let rhsParam = DirectObjectEmitBodyIRParamIndexForX64(bodyIR, op.operands[3])
    if lhsParam < 0 || rhsParam < 0:
        return false
    outOpKind = opKind
    outLhsParam = lhsParam
    outRhsParam = rhsParam
    return true

@borrows
fn DirectObjectEmitX64BodyIRSingleNoargCallThenI32Const(plan: pobj.PrimaryObjectPlan,
                                                         functionIndex: int32,
                                                         outTarget: var str,
                                                         outValue: var int32): bool =
    outTarget = ""
    outValue = int32(0)
    if functionIndex < 0 ||
       functionIndex >= plan.functionBodyIRs.len ||
       functionIndex >= plan.itemIds.len:
        return false
    let bodyIR = plan.functionBodyIRs[functionIndex]
    if bodyIR.callSequence.len != 1:
        return false
    if bodyIR.ops.len != 1 || bodyIR.blocks.len < 1:
        return false
    let block = bodyIR.blocks[0]
    if block.opStart != 0 || block.opCount != 1:
        return false
    if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
        return false
    let op = bodyIR.ops[0]
    if op.kind != coreir.BodyOpCallTag:
        return false
    if op.operands.len < 1 || op.operands[0] != 0:
        return false
    let call = bodyIR.callSequence[0]
    if call.argSlots.len != 0:
        return false
    if op.target != call.resultSlot:
        return false
    let term = bodyIR.terms[block.termIndex]
    if term.kind != coreir.BodyTermReturnTag:
        return false
    if term.resultSlot >= 0:
        return false
    if term.operands.len < 2:
        return false
    if term.operands[0] != DirectObjectEmitStatementReturnModeI32Const():
        return false
    let target = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
    if Len(target) <= 0:
        return false
    outTarget = target
    outValue = term.operands[1]
    return true

@borrows
fn DirectObjectEmitX64BodyIRSingleCStringCallReturnResult(plan: pobj.PrimaryObjectPlan,
                                                          functionIndex: int32,
                                                          outTarget: var str,
                                                          outLiteralLabel: var str): bool =
    # Matches: fn f(): i32 = return callee("literal")  (cstring literal arg,
    # call result propagated as return value in eax).
    outTarget = ""
    outLiteralLabel = ""
    if functionIndex < 0 ||
       functionIndex >= plan.functionBodyIRs.len ||
       functionIndex >= plan.itemIds.len:
        return false
    let bodyIR = plan.functionBodyIRs[functionIndex]
    if bodyIR.callSequence.len != 1:
        return false
    if bodyIR.ops.len != 1 || bodyIR.blocks.len != 1:
        return false
    let block = bodyIR.blocks[0]
    if block.opStart != 0 || block.opCount != 1:
        return false
    if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
        return false
    let op = bodyIR.ops[0]
    if op.kind != coreir.BodyOpCallTag:
        return false
    if op.operands.len < 1 || op.operands[0] != 0:
        return false
    let call = bodyIR.callSequence[0]
    if call.argSlots.len != 1:
        return false
    if !coreir.CallArgSlotIsCString(call.argSlots[0]):
        return false
    let literalId = coreir.CallArgSlotCStringId(call.argSlots[0])
    if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
        return false
    if op.target != call.resultSlot:
        return false
    let term = bodyIR.terms[block.termIndex]
    if term.kind != coreir.BodyTermReturnTag:
        return false
    if term.resultSlot != call.resultSlot:
        return false
    let target = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
    if Len(target) <= 0:
        return false
    let literalLabel = DirectObjectEmitDataLabelExact(plan,
                                                      DirectObjectEmitCStringLiteralDataLabel(DirectObjectEmitPlanSymbolNameAt(plan, functionIndex),
                                                                                              literalId))
    if Len(literalLabel) <= 0:
        return false
    outTarget = target
    outLiteralLabel = literalLabel
    return true

@borrows
fn DirectObjectEmitX64BodyIRCallLtZeroSelectReturn(plan: pobj.PrimaryObjectPlan,
                                                   functionIndex: int32,
                                                   outTarget: var str,
                                                   outLtValue: var int32,
                                                   outGeValue: var int32): bool =
    # Matches: fn main(): i32 = if callee() < 0: return c1 / return c2
    # (noarg call, signed-less-than-zero branch, two i32-const returns).
    outTarget = ""
    outLtValue = int32(0)
    outGeValue = int32(0)
    if functionIndex < 0 ||
       functionIndex >= plan.functionBodyIRs.len ||
       functionIndex >= plan.itemIds.len:
        return false
    let bodyIR = plan.functionBodyIRs[functionIndex]
    if bodyIR.callSequence.len != 1:
        return false
    if bodyIR.ops.len != 2 || bodyIR.blocks.len != 3:
        return false
    let entryBlock = bodyIR.blocks[0]
    if entryBlock.opStart != 0 || entryBlock.opCount != 2:
        return false
    if entryBlock.termIndex < 0 || entryBlock.termIndex >= bodyIR.terms.len:
        return false
    let op = bodyIR.ops[0]
    if op.kind != coreir.BodyOpCallTag:
        return false
    if op.operands.len < 1 || op.operands[0] != 0:
        return false
    let call = bodyIR.callSequence[0]
    if call.argSlots.len != 0:
        return false
    let zeroOp = bodyIR.ops[1]
    if zeroOp.kind != coreir.BodyOpLoadConstTag:
        return false
    if zeroOp.operands.len < 2 ||
       zeroOp.operands[0] != coreir.LocalI32Tag ||
       zeroOp.operands[1] != 0:
        return false
    let cbr = bodyIR.terms[entryBlock.termIndex]
    if cbr.kind != coreir.BodyTermCbrTag:
        return false
    if cbr.conditionKind != coreir.BodyCondI32LtTag:
        return false
    if cbr.lhsSlot != call.resultSlot:
        return false
    if cbr.rhsSlot != zeroOp.target:
        return false
    # Layout invariant of the if-return builder: true branch is block 1,
    # fall-through (cond false) is block 2; both are i32-const returns.
    if cbr.trueBlock != 1:
        return false
    var ltValue: int32
    if !DirectObjectEmitX64BlockReturnsI32Const(bodyIR, 1, ltValue):
        return false
    var geValue: int32
    if !DirectObjectEmitX64BlockReturnsI32Const(bodyIR, 2, geValue):
        return false
    let target = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
    if Len(target) <= 0:
        return false
    outTarget = target
    outLtValue = ltValue
    outGeValue = geValue
    return true

@borrows
fn DirectObjectEmitX64BlockReturnsI32Const(bodyIR: coreir.BodyIR,
                                           blockIndex: int32,
                                           outValue: var int32): bool =
    outValue = int32(0)
    if blockIndex < 0 || blockIndex >= bodyIR.blocks.len:
        return false
    let block = bodyIR.blocks[blockIndex]
    if block.opCount != 0:
        return false
    if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
        return false
    let term = bodyIR.terms[block.termIndex]
    if term.kind != coreir.BodyTermReturnTag:
        return false
    if term.resultSlot >= 0:
        return false
    if term.operands.len < 2:
        return false
    if term.operands[0] != DirectObjectEmitStatementReturnModeI32Const():
        return false
    outValue = term.operands[1]
    return true

@borrows
fn DirectObjectEmitX64BodyIRDetail(bodyIR: coreir.BodyIR): str =
    var out = Fmt" bodyIR.ops={strings.IntToStr(bodyIR.ops.len)} terms={strings.IntToStr(bodyIR.terms.len)} blocks={strings.IntToStr(bodyIR.blocks.len)} calls={strings.IntToStr(bodyIR.callSequence.len)} slots={strings.IntToStr(bodyIR.localSlots.len)}"
    for oi in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[oi]
        out = out + Fmt" op{oi}.kind={strings.IntToStr(op.kind)} op{oi}.target={strings.IntToStr(op.target)}"
        for ooi in 0..<op.operands.len:
            out = out + Fmt" op{oi}.o{ooi}={strings.IntToStr(op.operands[ooi])}"
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        out = out + Fmt" block{bi}.opStart={strings.IntToStr(block.opStart)} block{bi}.opCount={strings.IntToStr(block.opCount)} block{bi}.term={strings.IntToStr(block.termIndex)}"
    for ti in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[ti]
        out = out + Fmt" term{ti}.kind={strings.IntToStr(term.kind)} term{ti}.cond={strings.IntToStr(term.conditionKind)} term{ti}.result={strings.IntToStr(term.resultSlot)} term{ti}.lhs={strings.IntToStr(term.lhsSlot)} term{ti}.rhs={strings.IntToStr(term.rhsSlot)} term{ti}.t={strings.IntToStr(term.trueBlock)} term{ti}.f={strings.IntToStr(term.falseBlock)}"
        for toi in 0..<term.operands.len:
            out = out + Fmt" term{ti}.o{toi}={strings.IntToStr(term.operands[toi])}"
    for sli in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[sli]
        out = out + Fmt" slot{sli}.type={strings.IntToStr(slot.typeKind)} slot{sli}.offset={strings.IntToStr(slot.stackOffset)}"
    return out

@borrows
fn DirectObjectEmitWasmTargetSupported(plan: pobj.PrimaryObjectPlan): bool =
    return plan.targetTriple == "wasm32-unknown-unknown" && plan.objectFormat == "wasm"

fn DirectObjectEmitWasmWriteUleb(buf: var obuf.ObjectBuffer,
                                  valueRaw: int32) =
    var value = valueRaw
    if value < 0:
        value = 0
    while true:
        var byteValue = value & 127
        value = value >> 7
        if value != 0:
            byteValue = byteValue | 128
            obuf.ObjectBufferWriteU8(buf, byteValue)
        else:
            obuf.ObjectBufferWriteU8(buf, byteValue)
            break

fn DirectObjectEmitWasmWriteSlebI32(buf: var obuf.ObjectBuffer,
                                     valueRaw: int32) =
    var value = valueRaw
    while true:
        var byteValue = value & 127
        value = value >> 7
        let signSet = (byteValue & 64) != 0
        let done = (value == 0 && !signSet) || (value == -1 && signSet)
        if !done:
            byteValue = byteValue | 128
        obuf.ObjectBufferWriteU8(buf, byteValue)
        if done:
            break

fn DirectObjectEmitWasmWriteName(buf: var obuf.ObjectBuffer,
                                  name: str) =
    DirectObjectEmitWasmWriteUleb(buf, Len(name))
    for i in 0..<Len(name):
        obuf.ObjectBufferWriteU8(buf, int32(name[i]) & 255)

fn DirectObjectEmitWasmWriteSection(out: var obuf.ObjectBuffer,
                                     sectionId: int32,
                                     payload: obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, sectionId)
    DirectObjectEmitWasmWriteUleb(out, obuf.ObjectBufferLen(payload))
    obuf.ObjectBufferWriteBuffer(out, payload)

@borrows
fn DirectObjectEmitWasmStringIndex(items: str[],
                                    value: str): int32 =
    for i in 0..<items.len:
        if items[i] == value:
            return i
    return -1

@borrows
fn DirectObjectEmitWasmRealFunctionIndex(plan: pobj.PrimaryObjectPlan,
                                          functionLimit: int32,
                                          symbolName: str): int32 =
    if Len(symbolName) <= 0:
        return -1
    for i in 0..<functionLimit:
        if DirectObjectEmitPlanSymbolNameAt(plan, i) == symbolName:
            return i
    return -1

@borrows
fn DirectObjectEmitWasmCollectImportSymbols(plan: pobj.PrimaryObjectPlan,
                                             functionLimit: int32): str[] =
    var imports: str[]
    for functionIndex in 0..<functionLimit:
        if functionIndex >= plan.itemIds.len:
            continue
        let itemId = plan.itemIds[functionIndex]
        for relocIndex in 0..<plan.relocSourceItemIds.len:
            if plan.relocSourceItemIds[relocIndex] != itemId:
                continue
            let targetSymbol = plan.relocTargetSymbols[relocIndex]
            if Len(targetSymbol) <= 0:
                continue
            if DirectObjectEmitWasmRealFunctionIndex(plan, functionLimit, targetSymbol) >= 0:
                continue
            if DirectObjectEmitWasmStringIndex(imports, targetSymbol) < 0:
                add(imports, targetSymbol)
    return imports

@borrows
fn DirectObjectEmitWasmFunctionIndex(plan: pobj.PrimaryObjectPlan,
                                      functionLimit: int32,
                                      importSymbols: str[],
                                      targetSymbol: str): int32 =
    let importIndex = DirectObjectEmitWasmStringIndex(importSymbols, targetSymbol)
    if importIndex >= 0:
        return importIndex
    let functionIndex = DirectObjectEmitWasmRealFunctionIndex(plan, functionLimit, targetSymbol)
    if functionIndex >= 0:
        return importSymbols.len + functionIndex
    return -1

fn DirectObjectEmitWasmBodyIRI32ArgCount(bodyIR: coreir.BodyIR): int32 =
    var maxParam = int32(-1)
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        if slot.typeKind != coreir.LocalI32Tag:
            return -1
        if slot.stackOffset < 0:
            let paramIndex = int32(0) - int32(1) - slot.stackOffset
            if paramIndex != slotIndex:
                return -1
            if paramIndex > maxParam:
                maxParam = paramIndex
    let argCount = maxParam + 1
    for paramIndex in 0..<argCount:
        if paramIndex < 0 || paramIndex >= bodyIR.localSlots.len:
            return -1
        if bodyIR.localSlots[paramIndex].stackOffset != int32(0) - int32(1) - paramIndex:
            return -1
    return argCount

fn DirectObjectEmitWasmBodyIRSlotI32(bodyIR: coreir.BodyIR,
                                      slotIndex: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    return bodyIR.localSlots[slotIndex].typeKind == coreir.LocalI32Tag

fn DirectObjectEmitWasmEmitLocalGet(body: var obuf.ObjectBuffer,
                                     slotIndex: int32) =
    obuf.ObjectBufferWriteU8(body, 32)
    DirectObjectEmitWasmWriteUleb(body, slotIndex)

fn DirectObjectEmitWasmEmitLocalSet(body: var obuf.ObjectBuffer,
                                     slotIndex: int32) =
    obuf.ObjectBufferWriteU8(body, 33)
    DirectObjectEmitWasmWriteUleb(body, slotIndex)

fn DirectObjectEmitWasmEmitI32Const(body: var obuf.ObjectBuffer,
                                     value: int32) =
    obuf.ObjectBufferWriteU8(body, 65)
    DirectObjectEmitWasmWriteSlebI32(body, value)

fn DirectObjectEmitWasmI32BinOpOpcode(opKind: int32): int32 =
    if opKind == int32(texpr.TypedExprIrOpI32Add):
        return 106
    if opKind == int32(texpr.TypedExprIrOpI32Sub):
        return 107
    if opKind == int32(texpr.TypedExprIrOpI32Mul):
        return 108
    if opKind == int32(texpr.TypedExprIrOpI32Sdiv):
        return 109
    if opKind == int32(texpr.TypedExprIrOpI32Udiv):
        return 110
    if opKind == int32(texpr.TypedExprIrOpI32Mod):
        return 111
    if opKind == int32(texpr.TypedExprIrOpI32Umod):
        return 112
    if opKind == int32(texpr.TypedExprIrOpI32BitAnd):
        return 113
    if opKind == int32(texpr.TypedExprIrOpI32BitOr):
        return 114
    if opKind == int32(texpr.TypedExprIrOpI32BitXor):
        return 115
    if opKind == int32(texpr.TypedExprIrOpI32Lsl):
        return 116
    if opKind == int32(texpr.TypedExprIrOpI32Asr):
        return 117
    if opKind == int32(texpr.TypedExprIrOpI32Lsr):
        return 118
    return -1

fn DirectObjectEmitWasmI32CmpOpcode(conditionKind: int32): int32 =
    if conditionKind == coreir.BodyCondI32EqTag:
        return 70
    if conditionKind == coreir.BodyCondI32NeTag:
        return 71
    if conditionKind == coreir.BodyCondI32LtTag:
        return 72
    if conditionKind == coreir.BodyCondU32LtTag:
        return 73
    if conditionKind == coreir.BodyCondI32GtTag:
        return 74
    if conditionKind == coreir.BodyCondU32GtTag:
        return 75
    if conditionKind == coreir.BodyCondI32LeTag:
        return 76
    if conditionKind == coreir.BodyCondU32LeTag:
        return 77
    if conditionKind == coreir.BodyCondI32GeTag:
        return 78
    if conditionKind == coreir.BodyCondU32GeTag:
        return 79
    return -1

fn DirectObjectEmitWasmEmitI32Condition(body: var obuf.ObjectBuffer,
                                         bodyIR: coreir.BodyIR,
                                         conditionKind: int32,
                                         lhsSlot: int32,
                                         rhsSlot: int32): bool =
    if conditionKind == coreir.BodyCondLocalNonZeroTag:
        if !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, lhsSlot):
            return false
        DirectObjectEmitWasmEmitLocalGet(body, lhsSlot)
        DirectObjectEmitWasmEmitI32Const(body, 0)
        obuf.ObjectBufferWriteU8(body, 71)
        return true
    if conditionKind == coreir.BodyCondLocalZeroTag:
        if !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, lhsSlot):
            return false
        DirectObjectEmitWasmEmitLocalGet(body, lhsSlot)
        DirectObjectEmitWasmEmitI32Const(body, 0)
        obuf.ObjectBufferWriteU8(body, 70)
        return true
    let opcode = DirectObjectEmitWasmI32CmpOpcode(conditionKind)
    if opcode < 0:
        return false
    if !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, lhsSlot) ||
       !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, rhsSlot):
        return false
    DirectObjectEmitWasmEmitLocalGet(body, lhsSlot)
    DirectObjectEmitWasmEmitLocalGet(body, rhsSlot)
    obuf.ObjectBufferWriteU8(body, opcode)
    return true

@borrows
fn DirectObjectEmitWasmBodyIRCallTargetSymbol(plan: pobj.PrimaryObjectPlan,
                                               functionIndex: int32,
                                               bodyIR: coreir.BodyIR,
                                               callOrdinal: int32): str =
    if functionIndex >= 0 &&
       functionIndex < plan.itemIds.len:
        let relocTarget = DirectObjectEmitRelocTargetForItemOrdinal(plan,
                                                                    plan.itemIds[functionIndex],
                                                                    callOrdinal)
        if Len(relocTarget) > 0:
            return relocTarget
    if callOrdinal >= 0 && callOrdinal < bodyIR.callSequence.len:
        return strings.CloneStr(
            bodyIR.callSequence[callOrdinal].targetSymbol)
    return ""

@borrows
fn DirectObjectEmitWasmEmitBodyIROp(plan: pobj.PrimaryObjectPlan,
                                     functionLimit: int32,
                                     importSymbols: str[],
                                     functionIndex: int32,
                                     bodyIR: coreir.BodyIR,
                                     op: coreir.BodyOp,
                                     body: var obuf.ObjectBuffer): bool =
    if op.kind == coreir.BodyOpLoadConstTag:
        if op.operands.len < 2 ||
           op.operands[0] != coreir.LocalI32Tag ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.target):
            return false
        DirectObjectEmitWasmEmitI32Const(body, op.operands[1])
        DirectObjectEmitWasmEmitLocalSet(body, op.target)
        return true
    if op.kind == coreir.BodyOpCopyLocalTag ||
       op.kind == coreir.BodyOpStoreLocalTag ||
       op.kind == coreir.BodyOpLoadLocalTag:
        if op.operands.len < 1 ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.operands[0]) ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.target):
            return false
        DirectObjectEmitWasmEmitLocalGet(body, op.operands[0])
        DirectObjectEmitWasmEmitLocalSet(body, op.target)
        return true
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len < 4 ||
           op.operands[0] != coreir.LocalI32Tag ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.target) ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.operands[2]) ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.operands[3]):
            return false
        let opKind = op.operands[1]
        if opKind == int32(texpr.TypedExprIrOpI32Madd):
            if op.operands.len < 5 ||
               !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.operands[4]):
                return false
            DirectObjectEmitWasmEmitLocalGet(body, op.operands[2])
            DirectObjectEmitWasmEmitLocalGet(body, op.operands[3])
            obuf.ObjectBufferWriteU8(body, 108)
            DirectObjectEmitWasmEmitLocalGet(body, op.operands[4])
            obuf.ObjectBufferWriteU8(body, 106)
            DirectObjectEmitWasmEmitLocalSet(body, op.target)
            return true
        let opcode = DirectObjectEmitWasmI32BinOpOpcode(opKind)
        if opcode < 0:
            return false
        DirectObjectEmitWasmEmitLocalGet(body, op.operands[2])
        DirectObjectEmitWasmEmitLocalGet(body, op.operands[3])
        obuf.ObjectBufferWriteU8(body, opcode)
        DirectObjectEmitWasmEmitLocalSet(body, op.target)
        return true
    if op.kind == coreir.BodyOpCmpTag:
        if op.operands.len < 3 ||
           !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, op.target):
            return false
        if !DirectObjectEmitWasmEmitI32Condition(body,
                                                 bodyIR,
                                                 op.operands[0],
                                                 op.operands[1],
                                                 op.operands[2]):
            return false
        DirectObjectEmitWasmEmitLocalSet(body, op.target)
        return true
    if op.kind == coreir.BodyOpCallTag:
        if functionIndex < 0 ||
           functionIndex >= plan.itemIds.len ||
           op.operands.len < 1:
            return false
        let callOrdinal = op.operands[0]
        if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
            return false
        let call = bodyIR.callSequence[callOrdinal]
        for argIndex in 0..<call.argSlots.len:
            let argSlot = call.argSlots[argIndex]
            if !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, argSlot):
                return false
            DirectObjectEmitWasmEmitLocalGet(body, argSlot)
        let targetSymbol = DirectObjectEmitWasmBodyIRCallTargetSymbol(plan,
                                                                      functionIndex,
                                                                      bodyIR,
                                                                      callOrdinal)
        let targetIndex = DirectObjectEmitWasmFunctionIndex(plan,
                                                           functionLimit,
                                                           importSymbols,
                                                           targetSymbol)
        if targetIndex < 0:
            return false
        obuf.ObjectBufferWriteU8(body, 16)
        DirectObjectEmitWasmWriteUleb(body, targetIndex)
        if call.resultSlot >= 0:
            if call.resultSlot != op.target ||
               !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, call.resultSlot):
                return false
            DirectObjectEmitWasmEmitLocalSet(body, call.resultSlot)
        return true
    return false

fn DirectObjectEmitWasmEmitBodyIRTerm(bodyIR: coreir.BodyIR,
                                       term: coreir.BodyTerm,
                                       pcSlot: int32,
                                       body: var obuf.ObjectBuffer): bool =
    if term.kind == coreir.BodyTermReturnTag:
        if term.resultSlot >= 0:
            if !DirectObjectEmitWasmBodyIRSlotI32(bodyIR, term.resultSlot):
                return false
            DirectObjectEmitWasmEmitLocalGet(body, term.resultSlot)
        elif term.operands.len >= 2 &&
             term.operands[0] == DirectObjectEmitStatementReturnModeI32Const():
            DirectObjectEmitWasmEmitI32Const(body, term.operands[1])
        else:
            return false
        obuf.ObjectBufferWriteU8(body, 15)
        return true
    if term.kind == coreir.BodyTermBrTag:
        if term.trueBlock < 0 || term.trueBlock >= bodyIR.blocks.len:
            return false
        DirectObjectEmitWasmEmitI32Const(body, term.trueBlock)
        DirectObjectEmitWasmEmitLocalSet(body, pcSlot)
        obuf.ObjectBufferWriteU8(body, 12)
        DirectObjectEmitWasmWriteUleb(body, 1)
        return true
    if term.kind == coreir.BodyTermCbrTag:
        if term.trueBlock < 0 || term.trueBlock >= bodyIR.blocks.len ||
           term.falseBlock < 0 || term.falseBlock >= bodyIR.blocks.len:
            return false
        DirectObjectEmitWasmEmitI32Const(body, term.trueBlock)
        DirectObjectEmitWasmEmitI32Const(body, term.falseBlock)
        if !DirectObjectEmitWasmEmitI32Condition(body,
                                                 bodyIR,
                                                 term.conditionKind,
                                                 term.lhsSlot,
                                                 term.rhsSlot):
            return false
        obuf.ObjectBufferWriteU8(body, 27)
        DirectObjectEmitWasmEmitLocalSet(body, pcSlot)
        obuf.ObjectBufferWriteU8(body, 12)
        DirectObjectEmitWasmWriteUleb(body, 1)
        return true
    return false

@borrows
fn DirectObjectEmitWasmBodyIRGenericI32Bytes(plan: pobj.PrimaryObjectPlan,
                                              functionLimit: int32,
                                              importSymbols: str[],
                                              functionIndex: int32): Result[Bytes] =
    if functionIndex < 0 ||
       functionIndex >= plan.functionBodyIRs.len:
        return Err[Bytes](" direct wasm emit: missing BodyIR")
    let bodyIR = plan.functionBodyIRs[functionIndex]
    if bodyIR.blocks.len <= 0:
        return Err[Bytes](" direct wasm emit: empty BodyIR")
    let argCount = DirectObjectEmitWasmBodyIRI32ArgCount(bodyIR)
    if argCount < 0:
        return Err[Bytes](" direct wasm emit: unsupported BodyIR ABI")
    let pcSlot = bodyIR.localSlots.len
    var body = obuf.ObjectBufferInit(64)
    defer:
        obuf.ObjectBufferRelease(body)
    let extraLocalCount = bodyIR.localSlots.len - argCount + 1
    DirectObjectEmitWasmWriteUleb(body, 1)
    DirectObjectEmitWasmWriteUleb(body, extraLocalCount)
    obuf.ObjectBufferWriteU8(body, 127)

    obuf.ObjectBufferWriteU8(body, 2)
    obuf.ObjectBufferWriteU8(body, 64)
    obuf.ObjectBufferWriteU8(body, 3)
    obuf.ObjectBufferWriteU8(body, 64)
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.opStart < 0 ||
           block.opCount < 0 ||
           block.opStart + block.opCount > bodyIR.ops.len ||
           block.termIndex < 0 ||
           block.termIndex >= bodyIR.terms.len:
            return Err[Bytes](" direct wasm emit: malformed BodyIR block")
        DirectObjectEmitWasmEmitLocalGet(body, pcSlot)
        DirectObjectEmitWasmEmitI32Const(body, blockIndex)
        obuf.ObjectBufferWriteU8(body, 70)
        obuf.ObjectBufferWriteU8(body, 4)
        obuf.ObjectBufferWriteU8(body, 64)
        for relOpIndex in 0..<block.opCount:
            let opIndex = block.opStart + relOpIndex
            if !DirectObjectEmitWasmEmitBodyIROp(plan,
                                                 functionLimit,
                                                 importSymbols,
                                                 functionIndex,
                                                 bodyIR,
                                                 bodyIR.ops[opIndex],
                                                 body):
                return Err[Bytes](" direct wasm emit: unsupported BodyIR op")
        if !DirectObjectEmitWasmEmitBodyIRTerm(bodyIR,
                                               bodyIR.terms[block.termIndex],
                                               pcSlot,
                                               body):
            return Err[Bytes](" direct wasm emit: unsupported BodyIR term")
        obuf.ObjectBufferWriteU8(body, 11)
    obuf.ObjectBufferWriteU8(body, 0)
    obuf.ObjectBufferWriteU8(body, 11)
    obuf.ObjectBufferWriteU8(body, 11)
    DirectObjectEmitWasmEmitI32Const(body, 0)
    obuf.ObjectBufferWriteU8(body, 11)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(body))

@borrows
fn DirectObjectEmitWasmFunctionReturnI32Const(plan: pobj.PrimaryObjectPlan,
                                               functionIndex: int32,
                                               outValue: var int32): bool =
    if functionIndex < 0 || functionIndex >= plan.functionBodyKinds.len:
        return false
    if functionIndex < plan.functionStatementCallCounts.len &&
       plan.functionStatementCallCounts[functionIndex] != 0:
        return false
    if functionIndex < plan.functionBodyIRs.len &&
       plan.functionBodyIRs[functionIndex].callSequence.len != 0:
        return false
    let bodyKind = plan.functionBodyKinds[functionIndex]
    if functionIndex < plan.functionBodyIRs.len &&
       DirectObjectEmitBodyIRTermReturnI32Const(plan.functionBodyIRs[functionIndex], outValue):
        return true
    if bodyKind == texpr.BodyKindStatementSequence &&
       functionIndex < plan.functionStatementReturnModes.len &&
       functionIndex < plan.functionStatementReturnI32Values.len &&
       plan.functionStatementReturnModes[functionIndex] == DirectObjectEmitStatementReturnModeI32Const():
        outValue = plan.functionStatementReturnI32Values[functionIndex]
        return true
    return false

@borrows
fn DirectObjectEmitWasmFunctionSingleCallTarget(plan: pobj.PrimaryObjectPlan,
                                                 functionIndex: int32,
                                                 outTarget: var str,
                                                 outArgCount: var int32): bool =
    outTarget = ""
    outArgCount = 0
    if functionIndex < 0 ||
       functionIndex >= plan.functionBodyKinds.len ||
       functionIndex >= plan.itemIds.len:
        return false
    var callCount: int32
    if functionIndex < plan.functionStatementCallCounts.len:
        callCount = plan.functionStatementCallCounts[functionIndex]
    if functionIndex < plan.functionBodyIRs.len &&
       plan.functionBodyIRs[functionIndex].callSequence.len > 0:
        if DirectObjectEmitWasmBodyIRSingleCallReturnI32(plan,
                                                         functionIndex,
                                                         outTarget,
                                                         outArgCount):
            return true
        let bodyIR = plan.functionBodyIRs[functionIndex]
        if !pobj.PrimaryBodyIrIsCallSequenceReturnInt32(bodyIR):
            return false
        if bodyIR.callSequence.len != 1:
            return false
        let call = bodyIR.callSequence[0]
        for argIndex in 0..<call.argSlots.len:
            let argSlot = call.argSlots[argIndex]
            if argSlot != argIndex ||
               argSlot < 0 ||
               argSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[argSlot].typeKind != coreir.LocalI32Tag:
                return false
        outArgCount = call.argSlots.len
        outTarget = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
        return Len(outTarget) > 0
    let bodyKind = plan.functionBodyKinds[functionIndex]
    var noargCallResult = bodyKind == texpr.BodyKindReturnCallNoargPassthrough
    if !noargCallResult:
        return false
    if callCount > 1:
        return false
    outTarget = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
    return Len(outTarget) > 0

@borrows
fn DirectObjectEmitWasmFunctionSingleNoargCallTarget(plan: pobj.PrimaryObjectPlan,
                                                      functionIndex: int32,
                                                      outTarget: var str): bool =
    var argCount: int32
    if !DirectObjectEmitWasmFunctionSingleCallTarget(plan, functionIndex, outTarget, argCount):
        return false
    return argCount == 0

@borrows
fn DirectObjectEmitWasmFunctionArgCount(plan: pobj.PrimaryObjectPlan,
                                         functionIndex: int32): int32 =
    var targetSymbol = ""
    var argCount: int32
    if DirectObjectEmitWasmFunctionSingleCallTarget(plan, functionIndex, targetSymbol, argCount):
        return argCount
    if functionIndex >= 0 && functionIndex < plan.functionBodyIRs.len:
        let bodyArgCount = DirectObjectEmitWasmBodyIRI32ArgCount(plan.functionBodyIRs[functionIndex])
        if bodyArgCount >= 0:
            return bodyArgCount
    return 0

@borrows
fn DirectObjectEmitWasmFunctionSupported(plan: pobj.PrimaryObjectPlan,
                                          functionLimit: int32,
                                          importSymbols: str[],
                                          functionIndex: int32): bool =
    var returnValue: int32
    if DirectObjectEmitWasmFunctionReturnI32Const(plan, functionIndex, returnValue):
        return true
    var targetSymbol = ""
    var argCount: int32
    if DirectObjectEmitWasmFunctionSingleCallTarget(plan, functionIndex, targetSymbol, argCount):
        return DirectObjectEmitWasmFunctionIndex(plan, functionLimit, importSymbols, targetSymbol) >= 0
    let genericRes = DirectObjectEmitWasmBodyIRGenericI32Bytes(plan,
                                                              functionLimit,
                                                              importSymbols,
                                                              functionIndex)
    if genericRes.ok:
        var genericBytes = genericRes.value
        rawbytes.BytesFree(genericBytes)
        return true
    return false

fn DirectObjectEmitWasmWriteHeader(out: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, 0)
    obuf.ObjectBufferWriteU8(out, int32('a'))
    obuf.ObjectBufferWriteU8(out, int32('s'))
    obuf.ObjectBufferWriteU8(out, int32('m'))
    obuf.ObjectBufferWriteU8(out, 1)
    obuf.ObjectBufferWriteU8(out, 0)
    obuf.ObjectBufferWriteU8(out, 0)
    obuf.ObjectBufferWriteU8(out, 0)

@borrows
fn DirectObjectEmitWasmFunctionBodyBytes(plan: pobj.PrimaryObjectPlan,
                                          functionLimit: int32,
                                          importSymbols: str[],
                                          functionIndex: int32): Result[Bytes] =
    var body = obuf.ObjectBufferInit(16)
    defer:
        obuf.ObjectBufferRelease(body)
    DirectObjectEmitWasmWriteUleb(body, 0)
    var returnValue: int32
    if DirectObjectEmitWasmFunctionReturnI32Const(plan, functionIndex, returnValue):
        obuf.ObjectBufferWriteU8(body, 65)
        DirectObjectEmitWasmWriteSlebI32(body, returnValue)
        obuf.ObjectBufferWriteU8(body, 11)
        return Ok[Bytes](obuf.ObjectBufferTakeBytes(body))
    var targetSymbol = ""
    var argCount: int32
    if DirectObjectEmitWasmFunctionSingleCallTarget(plan, functionIndex, targetSymbol, argCount):
        let targetIndex = DirectObjectEmitWasmFunctionIndex(plan, functionLimit, importSymbols, targetSymbol)
        if targetIndex < 0:
            return Err[Bytes](" direct wasm emit: missing call target")
        for argIndex in 0..<argCount:
            obuf.ObjectBufferWriteU8(body, 32)
            DirectObjectEmitWasmWriteUleb(body, argIndex)
        obuf.ObjectBufferWriteU8(body, 16)
        DirectObjectEmitWasmWriteUleb(body, targetIndex)
        obuf.ObjectBufferWriteU8(body, 11)
        return Ok[Bytes](obuf.ObjectBufferTakeBytes(body))
    let genericRes = DirectObjectEmitWasmBodyIRGenericI32Bytes(plan,
                                                              functionLimit,
                                                              importSymbols,
                                                              functionIndex)
    if genericRes.ok:
        return genericRes
    return Err[Bytes](" direct wasm emit: unsupported wasm function body")

@borrows
fn DirectObjectEmitWasmImportArgCount(plan: pobj.PrimaryObjectPlan,
                                       functionLimit: int32,
                                       importSymbol: str): int32 =
    for functionIndex in 0..<functionLimit:
        if functionIndex >= plan.itemIds.len ||
           functionIndex >= plan.functionBodyIRs.len:
            continue
        let bodyIR = plan.functionBodyIRs[functionIndex]
        if bodyIR.callSequence.len != 1:
            continue
        let targetSymbol = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[functionIndex], 0)
        if targetSymbol == importSymbol:
            return bodyIR.callSequence[0].argSlots.len
    return 0

fn DirectObjectEmitWasmWriteI32ToI32Type(out: var obuf.ObjectBuffer,
                                          argCount: int32) =
    obuf.ObjectBufferWriteU8(out, 96)
    DirectObjectEmitWasmWriteUleb(out, argCount)
    for _ in 0..<argCount:
        obuf.ObjectBufferWriteU8(out, 127)
    DirectObjectEmitWasmWriteUleb(out, 1)
    obuf.ObjectBufferWriteU8(out, 127)

@borrows
fn DirectObjectEmitWasmPlanModuleBytes(plan: pobj.PrimaryObjectPlan,
                                        functionLimit: int32,
                                        entryIndex: int32,
                                        importSymbols: str[]): Result[Bytes] =
    var out = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(out)
    DirectObjectEmitWasmWriteHeader(out)

    var typeSection = obuf.ObjectBufferInit(64)
    defer:
        obuf.ObjectBufferRelease(typeSection)
    DirectObjectEmitWasmWriteUleb(typeSection, importSymbols.len + functionLimit)
    for i in 0..<importSymbols.len:
        DirectObjectEmitWasmWriteI32ToI32Type(typeSection,
                                              DirectObjectEmitWasmImportArgCount(plan,
                                                                                 functionLimit,
                                                                                 importSymbols[i]))
    for functionIndex in 0..<functionLimit:
        DirectObjectEmitWasmWriteI32ToI32Type(typeSection,
                                              DirectObjectEmitWasmFunctionArgCount(plan, functionIndex))
    DirectObjectEmitWasmWriteSection(out, 1, typeSection)

    if importSymbols.len > 0:
        var importSection = obuf.ObjectBufferInit(64)
        DirectObjectEmitWasmWriteUleb(importSection, importSymbols.len)
        for i in 0..<importSymbols.len:
            DirectObjectEmitWasmWriteName(importSection, "env")
            DirectObjectEmitWasmWriteName(importSection, importSymbols[i])
            obuf.ObjectBufferWriteU8(importSection, 0)
            DirectObjectEmitWasmWriteUleb(importSection, i)
        DirectObjectEmitWasmWriteSection(out, 2, importSection)
        obuf.ObjectBufferRelease(importSection)

    var functionSection = obuf.ObjectBufferInit(16)
    defer:
        obuf.ObjectBufferRelease(functionSection)
    DirectObjectEmitWasmWriteUleb(functionSection, functionLimit)
    for functionIndex in 0..<functionLimit:
        DirectObjectEmitWasmWriteUleb(functionSection, importSymbols.len + functionIndex)
    DirectObjectEmitWasmWriteSection(out, 3, functionSection)

    var exportSection = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(exportSection)
    DirectObjectEmitWasmWriteUleb(exportSection, functionLimit)
    for functionIndex in 0..<functionLimit:
        DirectObjectEmitWasmWriteName(exportSection, DirectObjectEmitPlanSymbolNameAt(plan, functionIndex))
        obuf.ObjectBufferWriteU8(exportSection, 0)
        DirectObjectEmitWasmWriteUleb(exportSection, importSymbols.len + functionIndex)
    DirectObjectEmitWasmWriteSection(out, 7, exportSection)

    var codeSection = obuf.ObjectBufferInit(64)
    defer:
        obuf.ObjectBufferRelease(codeSection)
    DirectObjectEmitWasmWriteUleb(codeSection, functionLimit)
    for functionIndex in 0..<functionLimit:
        let bodyRes = DirectObjectEmitWasmFunctionBodyBytes(plan,
                                                            functionLimit,
                                                            importSymbols,
                                                            functionIndex)
        if !bodyRes.ok:
            let ownedErrMsg5 = strings.CloneStr(bodyRes.err.msg)
            return Err[Bytes](ownedErrMsg5)
        var bodyBytes = bodyRes.value
        DirectObjectEmitWasmWriteUleb(codeSection, BytesLen(bodyBytes))
        obuf.ObjectBufferWriteBytes(codeSection, bodyBytes)
        rawbytes.BytesFree(bodyBytes)
    DirectObjectEmitWasmWriteSection(out, 10, codeSection)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(out))

fn DirectObjectEmitAlign(value: int32,
                         align: int32): int32 =
    if align <= 1:
        return value
    let remainder = value % align
    if remainder == 0:
        return value
    let delta = align - remainder
    return value + delta

@borrows
fn DirectObjectEmitTextByteSize(plan: pobj.PrimaryObjectPlan): int32 =
    return plan.instructionWords.len * 4

@borrows
fn DirectObjectEmitDataSectionAddr(plan: pobj.PrimaryObjectPlan): int32 =
    return DirectObjectEmitAlign(DirectObjectEmitTextByteSize(plan), 8)

@borrows
fn DirectObjectEmitParsePositiveI32(text: str): int32 =
    var value: int32
    for i in 0..<Len(text):
        let ch = text[i]
        if ch < '0' || ch > '9':
            return value
        value = value * 10 + int32(ch) - int32('0')
    return value

@borrows
fn DirectObjectEmitPayloadByteCount(payloadText: str): int32 =
    let zeroPrefix = "zero:"
    if chengpath.TextStartsWith(payloadText, zeroPrefix):
        let raw = strings.SliceBytes(payloadText, Len(zeroPrefix), Len(payloadText) - Len(zeroPrefix))
        return DirectObjectEmitParsePositiveI32(raw)
    let hexPrefix = "hex:"
    if chengpath.TextStartsWith(payloadText, hexPrefix):
        let raw = strings.SliceBytes(payloadText, Len(hexPrefix), Len(payloadText) - Len(hexPrefix))
        return Len(raw) / 2
    let cstringPrefix = "cstring:"
    if chengpath.TextStartsWith(payloadText, cstringPrefix):
        let raw = strings.SliceBytes(payloadText, Len(cstringPrefix), Len(payloadText) - Len(cstringPrefix))
        var count: int32 = 1
        var escaped = false
        for i in 0..<Len(raw):
            if escaped:
                escaped = false
                count = count + 1
            elif raw[i] == char(92):
                escaped = true
            else:
                count = count + 1
        if escaped:
            count = count + 1
        return count
    return 0

@borrows
fn DirectObjectEmitPayloadAlign(payloadText: str): int32 =
    let zeroPrefix = "zero:"
    if chengpath.TextStartsWith(payloadText, zeroPrefix):
        let raw = strings.SliceBytes(payloadText, Len(zeroPrefix), Len(payloadText) - Len(zeroPrefix))
        let count = DirectObjectEmitParsePositiveI32(raw)
        if count >= 8:
            return 8
        if count >= 4:
            return 4
    let hexPrefix = "hex:"
    if chengpath.TextStartsWith(payloadText, hexPrefix):
        let raw = strings.SliceBytes(payloadText, Len(hexPrefix), Len(payloadText) - Len(hexPrefix))
        let count = Len(raw) / 2
        if count >= 8:
            return 8
        if count >= 4:
            return 4
    return 1

@borrows
fn DirectObjectEmitCStringPayloadByte(raw: str,
                                       index: int32): int32 =
    if index < 0 || index >= Len(raw):
        return 0
    let ch = raw[index]
    if ch == 'n':
        return 10
    if ch == 'r':
        return 13
    if ch == 't':
        return 9
    if ch == '0':
        return 0
    return int32(ch)

@borrows
fn DirectObjectEmitWriteCStringPayload(data: var obuf.ObjectBuffer,
                                        payloadText: str) =
    let prefix = "cstring:"
    if !chengpath.TextStartsWith(payloadText, prefix):
        return
    let raw = strings.SliceBytes(payloadText, Len(prefix), Len(payloadText) - Len(prefix))
    var escaped = false
    for i in 0..<Len(raw):
        if escaped:
            obuf.ObjectBufferWriteU8(data, DirectObjectEmitCStringPayloadByte(raw, i))
            escaped = false
        elif raw[i] == char(92):
            escaped = true
        else:
            obuf.ObjectBufferWriteU8(data, int32(raw[i]))
    if escaped:
        obuf.ObjectBufferWriteU8(data, int32(char(92)))
    obuf.ObjectBufferWriteU8(data, 0)

fn DirectObjectEmitHexDigitValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return 10 + int32(ch) - int32('a')
    if ch >= 'A' && ch <= 'F':
        return 10 + int32(ch) - int32('A')
    return 0

# Write the literal bytes of a `hex:<even-length hex string>` payload (an
# initialized global's data slot). Each hex pair is one byte, written in source
# order (the producer already encoded little-endian where required).
@borrows
fn DirectObjectEmitWriteHexPayload(data: var obuf.ObjectBuffer,
                                    payloadText: str) =
    let prefix = "hex:"
    if !chengpath.TextStartsWith(payloadText, prefix):
        return
    let raw = strings.SliceBytes(payloadText, Len(prefix), Len(payloadText) - Len(prefix))
    var i: int32
    while i + 1 < Len(raw):
        let hi = DirectObjectEmitHexDigitValue(raw[i])
        let lo = DirectObjectEmitHexDigitValue(raw[i + 1])
        obuf.ObjectBufferWriteU8(data, (hi << 4) | lo)
        i = i + 2

@borrows
fn DirectObjectEmitCStringLiteralDataLabel(functionSymbol: str,
                                           callOrdinal: int32): str =
    return strutil.Join([share(functionSymbol), "__cheng_cstring_", IntToStr(callOrdinal)], "")

@borrows
fn DirectObjectEmitCstringLiteralCallCount(plan: pobj.PrimaryObjectPlan,
                                            functionIndex: int32): int32 =
    return 0

@borrows
fn DirectObjectEmitDataLabelByTail(plan: pobj.PrimaryObjectPlan,
                                    tail: str): str =
    for i in 0..<plan.dataLabels.len:
        let label = plan.dataLabels[i]
        if Len(label) < Len(tail):
            continue
        let start = Len(label) - Len(tail)
        var matches = true
        for j in 0..<Len(tail):
            if label[start + j] != tail[j]:
                matches = false
                break
        if matches:
            return strings.CloneStr(label)
    return ""

@borrows
fn DirectObjectEmitDataLabelExact(plan: pobj.PrimaryObjectPlan,
                                   label: str): str =
    for i in 0..<plan.dataLabels.len:
        if plan.dataLabels[i] == label:
            return strings.CloneStr(plan.dataLabels[i])
    return ""

fn DirectObjectEmitGlobalOpKind(kind: int32): bool =
    if kind == coreir.BodyOpGlobalLoadTag:
        return true
    if kind == coreir.BodyOpGlobalStoreTag:
        return true
    return false

@borrows
fn DirectObjectEmitGlobalDataLabel(plan: pobj.PrimaryObjectPlan,
                                    bodyIR: coreir.BodyIR,
                                    slotIndex: int32): str =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return ""
    let label = pobj.PrimaryGlobalDataLabel(plan.targetTriple,
                                            bodyIR.localSlots[slotIndex].name)
    return label

@borrows
fn DirectObjectEmitGlobalPayloadText(bodyIR: coreir.BodyIR,
                                      slotIndex: int32): str =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        system.Assert(false, "direct object emit: invalid global slot")
        return ""
    if bodyIR.localSlots[slotIndex].sizeBytes > 0:
        return Fmt"zero:{bodyIR.localSlots[slotIndex].sizeBytes}"
    system.Assert(false, "direct object emit: invalid global slot size")
    return ""

@borrows
fn DirectObjectEmitAppendGlobalData(plan: pobj.PrimaryObjectPlan,
                                     functionLimit: int32,
                                     labels: var str[],
                                     payloads: var str[]) =
    for functionIndex in 0..<functionLimit:
        if functionIndex >= plan.functionBodyIRs.len:
            continue
        let bodyIR = plan.functionBodyIRs[functionIndex]
        for opIndex in 0..<bodyIR.ops.len:
            let op = bodyIR.ops[opIndex]
            if !DirectObjectEmitGlobalOpKind(op.kind) ||
               op.operands.len <= 0:
                continue
            let label = DirectObjectEmitGlobalDataLabel(plan, bodyIR, op.operands[0])
            if label == "":
                continue
            if DirectObjectEmitDataLabelExact(plan, label) != "":
                continue
            if DirectObjectEmitWasmStringIndex(labels, label) >= 0:
                continue
            let payloadText = DirectObjectEmitGlobalPayloadText(bodyIR, op.operands[0])
            if payloadText == "":
                system.Assert(false, "direct object emit: missing global payload")
                continue
            add(labels, label)
            add(payloads, payloadText)

@borrows
fn DirectObjectEmitFunctionLooksEntryBridgeWords(plan: pobj.PrimaryObjectPlan,
                                                   functionIndex: int32): bool =
    if Len(plan.entryFunctionSymbol) <= 0:
        return false
    if functionIndex < 0 ||
       functionIndex >= plan.symbolRoles.len ||
       plan.symbolRoles[functionIndex] !=
           pobj.PrimaryObjectSymbolRoleSyntheticEntryBridge:
        return false
    if functionIndex >= plan.functionWordOffsets.len:
        return false
    if functionIndex >= plan.functionWordCounts.len:
        return false
    if plan.functionWordCounts[functionIndex] != texpr.BodyKindEntryBridgeWordCount:
        return false
    let wordOffset = plan.functionWordOffsets[functionIndex]
    if wordOffset + 16 >= plan.instructionWords.len:
        return false
    if plan.instructionWords[wordOffset] != -788495361:
        return false
    if plan.instructionWords[wordOffset + 3] != -1811939328:
        return false
    if plan.instructionWords[wordOffset + 6] != -1811939328:
        return false
    if plan.instructionWords[wordOffset + 8] != -1811939328:
        return false
    if plan.instructionWords[wordOffset + 12] != -1811939328:
        return false
    if plan.instructionWords[wordOffset + 16] != -698416192:
        return false
    return true

@borrows
fn DirectObjectEmitInstructionWord(plan: pobj.PrimaryObjectPlan,
                                    wordOffset: int32): int32 =
    if wordOffset < 0 || wordOffset >= plan.instructionWords.len:
        return 0
    return plan.instructionWords[wordOffset]

@borrows
fn DirectObjectEmitIsCstringAddressPair(plan: pobj.PrimaryObjectPlan,
                                         wordOffset: int32): bool =
    if DirectObjectEmitInstructionWord(plan, wordOffset) != -1879048192:
        return false
    if DirectObjectEmitInstructionWord(plan, wordOffset + 1) != -1862270976:
        return false
    return true

@borrows
fn DirectObjectEmitIsRuntimeDataAddressPair(plan: pobj.PrimaryObjectPlan,
                                             wordOffset: int32): bool =
    if DirectObjectEmitInstructionWord(plan, wordOffset) != -1879048176:
        return false
    if DirectObjectEmitInstructionWord(plan, wordOffset + 1) != -1862270448:
        return false
    return true

@borrows
fn DirectObjectEmitRelocTargetForItem(plan: pobj.PrimaryObjectPlan,
                                       itemId: int32): str =
    for i in 0..<plan.relocSourceItemIds.len:
        if plan.relocSourceItemIds[i] == itemId:
            return strings.CloneStr(plan.relocTargetSymbols[i])
    return ""

@borrows
fn DirectObjectEmitRelocTargetForItemOrdinal(plan: pobj.PrimaryObjectPlan,
                                              itemId: int32,
                                              ordinal: int32): str =
    var seen: int32
    for i in 0..<plan.relocSourceItemIds.len:
        if plan.relocSourceItemIds[i] != itemId:
            continue
        if seen == ordinal:
            return strings.CloneStr(plan.relocTargetSymbols[i])
        seen = seen + 1
    return ""

@borrows
fn DirectObjectEmitEntryBridgeSetCmdLineSymbol(plan: pobj.PrimaryObjectPlan): str =
    return DirectObjectEmitTargetSymbolName(plan.targetTriple, "__cheng_setCmdLine")

@borrows
fn DirectObjectEmitEntryBridgeLineMapSymbol(plan: pobj.PrimaryObjectPlan): str =
    return DirectObjectEmitTargetSymbolName(plan.targetTriple, "cheng_native_register_line_map_from_argv0")

@borrows
fn DirectObjectEmitEntryBridgeProfileFlushSymbol(plan: pobj.PrimaryObjectPlan): str =
    return DirectObjectEmitTargetSymbolName(plan.targetTriple, "cheng_debug_profile_flush_from_argv0")

@borrows
fn DirectObjectEmitEntryBridgeTargetSymbol(plan: pobj.PrimaryObjectPlan): str =
    let entryIndex = DirectObjectEmitEntryFunctionIndex(
        plan, DirectObjectEmitRealFunctionLimit(plan))
    if entryIndex >= 0:
        return DirectObjectEmitPlanSymbolNameAt(plan, entryIndex)
    return ""

@borrows
fn DirectObjectEmitPlanFunctionCount(
        plan: pobj.PrimaryObjectPlan): int32 =
    var count = plan.functionWordOffsets.len
    if plan.functionWordCounts.len < count:
        count = plan.functionWordCounts.len
    return count

@borrows
fn DirectObjectEmitPlanSymbolNameAt(plan: pobj.PrimaryObjectPlan,
                                    index: int32): str =
    return DirectObjectEmitPlanSymbolNameAtForTarget(
        plan, plan.targetTriple, index)

@borrows
fn DirectObjectEmitPlanSymbolNameAtForTarget(plan: pobj.PrimaryObjectPlan,
                                             targetTriple: str,
                                             index: int32): str =
    if index >= 0 && index < plan.symbolNames.len:
        return strings.CloneStr(plan.symbolNames[index])
    system.Assert(false,
        "direct object emit: exact symbol identity row out of range")
    return ""

@borrows
fn DirectObjectEmitEntryBridgeIndex(plan: pobj.PrimaryObjectPlan): int32 =
    for i in 0..<plan.symbolRoles.len:
        if plan.symbolRoles[i] ==
           pobj.PrimaryObjectSymbolRoleSyntheticEntryBridge:
            return i
    return -1

@borrows
fn DirectObjectEmitRealFunctionLimit(plan: pobj.PrimaryObjectPlan): int32 =
    let bridgeIndex = DirectObjectEmitEntryBridgeIndex(plan)
    if bridgeIndex >= 0:
        return bridgeIndex
    return DirectObjectEmitPlanFunctionCount(plan)

@borrows
fn DirectObjectEmitEntryFunctionIndex(plan: pobj.PrimaryObjectPlan,
                                       functionLimit: int32): int32 =
    if Len(plan.entryFunctionSymbol) <= 0:
        return -1
    var entryIndex: int32 = -1
    for i in 0..<functionLimit:
        if i >= plan.symbolRoles.len ||
           plan.symbolRoles[i] != pobj.PrimaryObjectSymbolRoleSourceEntry:
            continue
        if entryIndex >= 0:
            system.Assert(false,
                "direct object emit: duplicate structured source entry")
        entryIndex = i
    if entryIndex < 0:
        system.Assert(false,
            "direct object emit: structured source entry missing")
    if DirectObjectEmitPlanSymbolNameAt(plan, entryIndex) !=
           plan.entryFunctionSymbol:
        system.Assert(false,
            "direct object emit: structured source entry payload drift")
    return entryIndex

@borrows
fn DirectObjectEmitSymbolInRealFunctions(plan: pobj.PrimaryObjectPlan,
                                          functionLimit: int32,
                                          symbolName: str): bool =
    if Len(symbolName) <= 0:
        return false
    for i in 0..<functionLimit:
        if DirectObjectEmitPlanSymbolNameAt(plan, i) == symbolName:
            return true
    return false

@borrows
fn DirectObjectEmitStandaloneNeedsMainWrapper(plan: pobj.PrimaryObjectPlan): bool =
    return false

@borrows
fn DirectObjectEmitStandaloneEntryBodyKind(plan: pobj.PrimaryObjectPlan,
                                           functionLimit: int32): str =
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if entryIndex >= 0:
        return strings.CloneStr(plan.functionBodyKinds[entryIndex])
    return ""

@borrows
fn DirectObjectEmitStandaloneWrapperByteSize(plan: pobj.PrimaryObjectPlan,
                                             functionLimit: int32): int64 =
    if !DirectObjectEmitStandaloneNeedsMainWrapper(plan):
        return int64(0)
    let entryBodyKind = DirectObjectEmitStandaloneEntryBodyKind(plan, functionLimit)
    if entryBodyKind == texpr.BodyKindReturnZeroI32 ||
       DirectObjectEmitIsReturnI32ConstBodyKind(entryBodyKind) ||
       entryBodyKind == texpr.BodyKindMainF64MulCheckExit ||
       DirectObjectEmitIsLetCallNoargReturnI32ConstBodyKind(entryBodyKind) ||
       entryBodyKind == texpr.BodyKindResultRequestDispatch ||
       entryBodyKind == texpr.BodyKindStatementSequence:
        return int64(4)
    return int64(0)

@borrows
fn DirectObjectEmitStandaloneTextByteSize(plan: pobj.PrimaryObjectPlan): int32 =
    return DirectObjectEmitTextByteSize(plan)

@borrows
fn DirectObjectEmitStandaloneDataSectionAddr(plan: pobj.PrimaryObjectPlan): int32 =
    return DirectObjectEmitDataSectionAddr(plan)

@borrows
fn DirectObjectEmitCanStandaloneMain(plan: pobj.PrimaryObjectPlan): bool =
    if !(plan.targetTriple == "arm64-apple-darwin" && plan.objectFormat == "macho"):
        return false
    if !DirectObjectEmitInstructionWordsMaterialized(plan):
        return false
    if Len(plan.outputPath) <= 0:
        return false
    if plan.missingReasons.len > 0:
        return false
    if plan.functionBodyKinds.len <= 0:
        return false
    if plan.functionBodyKinds.len != plan.functionWordCounts.len:
        return false
    if plan.symbolNames.len != plan.functionBodyKinds.len ||
       plan.symbolNames.len != plan.functionWordCounts.len ||
       plan.symbolNames.len != plan.functionWordOffsets.len ||
       plan.symbolNames.len != plan.itemIds.len:
        return false
    if plan.relocTargetSymbols.len != plan.relocSourceItemIds.len ||
       plan.relocTargetSymbols.len != plan.relocWordOffsets.len:
        return false
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    if functionLimit <= 0:
        return false
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if entryIndex < 0:
        return false
    let entryBodyKind = plan.functionBodyKinds[entryIndex]
    if entryBodyKind != texpr.BodyKindReturnVoid &&
       entryBodyKind != texpr.BodyKindReturnZeroI32 &&
       !DirectObjectEmitIsReturnI32ConstBodyKind(entryBodyKind) &&
       !DirectObjectEmitIsLetCallNoargReturnI32ConstBodyKind(entryBodyKind) &&
       entryBodyKind != texpr.BodyKindResultRequestDispatch &&
       entryBodyKind != texpr.BodyKindStatementSequence &&
       entryBodyKind != texpr.BodyKindMainF64MulCheckExit:
        return false
    if DirectObjectEmitStandaloneNeedsMainWrapper(plan):
        let wrapperSize = DirectObjectEmitStandaloneWrapperByteSize(plan, functionLimit)
        if wrapperSize <= int64(0):
            return false
    for i in 0..<plan.functionBodyKinds.len:
        let bodyKind = plan.functionBodyKinds[i]
        if i >= functionLimit:
            if bodyKind != texpr.BodyKindEntryBridge:
                return false
            if i != plan.functionBodyKinds.len - 1:
                return false
            if plan.functionWordCounts[i] != texpr.BodyKindEntryBridgeWordCount:
                return false
            continue
        let symbolName = DirectObjectEmitPlanSymbolNameAt(plan, i)
        if Len(symbolName) <= 0:
            return false
        let expectedWords = DirectObjectEmitExpectedWordsForPlanFunction(plan, i)
        if expectedWords <= 0 ||
           bodyKind == texpr.BodyKindEntryBridge:
            return false
        if plan.functionWordCounts[i] != expectedWords:
            return false
        if i == 0:
            if plan.functionWordOffsets[i] != 0:
                return false
        elif i > 0:
            let previousIndex = i - 1
            let expectedOffset = plan.functionWordOffsets[previousIndex] + plan.functionWordCounts[previousIndex]
            if plan.functionWordOffsets[i] != expectedOffset:
                return false
        var requiredStatementCallCount: int32
        if i < plan.functionStatementCallCounts.len:
            requiredStatementCallCount = plan.functionStatementCallCounts[i]
        let cstringCallCount = DirectObjectEmitCstringLiteralCallCount(plan, i)
        if cstringCallCount > 0:
            continue
        if bodyKind == texpr.BodyKindStatementSequence ||
           texpr.TypedExprIsCallRelocBodyKind(bodyKind) ||
           DirectObjectEmitIsLetCallNoargReturnI32ConstBodyKind(bodyKind):
            if requiredStatementCallCount <= 0:
                requiredStatementCallCount = 1
            for callOrdinal in 0..<requiredStatementCallCount:
                let targetSymbol = DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[i], callOrdinal)
                if !DirectObjectEmitSymbolInRealFunctions(plan, functionLimit, targetSymbol):
                    return false
    return true

@borrows
fn DirectObjectEmitValidateWasmMainModule(plan: pobj.PrimaryObjectPlan,
                                           outputPath: str): Result[bool] =
    if !DirectObjectEmitWasmTargetSupported(plan):
        return Err[bool](" direct wasm emit: unsupported target")
    if Len(outputPath) <= 0:
        return Err[bool](" direct wasm emit: missing output path")
    if plan.missingReasons.len > 0:
        return Err[bool](" direct wasm emit: primary object plan has missing reasons")
    if plan.symbolNames.len != plan.functionBodyKinds.len ||
       plan.symbolNames.len != plan.functionWordCounts.len ||
       plan.symbolNames.len != plan.functionWordOffsets.len ||
       plan.symbolNames.len != plan.itemIds.len:
        return Err[bool](" direct wasm emit: malformed primary object plan")
    if plan.relocTargetSymbols.len != plan.relocSourceItemIds.len ||
       plan.relocTargetSymbols.len != plan.relocWordOffsets.len:
        return Err[bool](" direct wasm emit: malformed relocation plan")
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    if functionLimit <= 0:
        return Err[bool](" direct wasm emit: empty function plan")
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if entryIndex < 0:
        return Err[bool](" direct wasm emit: missing entry function")
    for i in functionLimit..<plan.functionBodyKinds.len:
        if plan.functionBodyKinds[i] != texpr.BodyKindEntryBridge:
            return Err[bool](" direct wasm emit: unsupported trailing function")
    let importSymbols = DirectObjectEmitWasmCollectImportSymbols(plan, functionLimit)
    for functionIndex in 0..<functionLimit:
        if Len(plan.symbolNames[functionIndex]) <= 0:
            return Err[bool](" direct wasm emit: missing function symbol")
        if !DirectObjectEmitWasmFunctionSupported(plan, functionLimit, importSymbols, functionIndex):
            var bodyDetail = ""
            if functionIndex >= 0 && functionIndex < plan.functionBodyIRs.len:
                bodyDetail = DirectObjectEmitX64BodyIRDetail(plan.functionBodyIRs[functionIndex])
            var bodyKind = ""
            if functionIndex >= 0 && functionIndex < plan.functionBodyKinds.len:
                bodyKind = plan.functionBodyKinds[functionIndex]
            return Err[bool](Fmt" direct wasm emit: unsupported function symbol={plan.symbolNames[functionIndex]} body_kind={bodyKind} body_ir_count={strings.IntToStr(plan.functionBodyIRs.len)}{bodyDetail}")
    return Ok[bool](true)

@borrows
fn DirectObjectEmitCanWasmMainModule(plan: pobj.PrimaryObjectPlan,
                                      outputPath: str): bool =
    let res = DirectObjectEmitValidateWasmMainModule(plan, outputPath)
    return res.ok

@borrows
fn DirectObjectEmitWasmMainModule(rootDir: str,
                                   plan: pobj.PrimaryObjectPlan,
                                   outputPath: str): Result[DirectObjectEmitResult] =
    let validRes = DirectObjectEmitValidateWasmMainModule(plan, outputPath)
    if !validRes.ok:
        let ownedErrMsg6 = strings.CloneStr(validRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg6)
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    let importSymbols = DirectObjectEmitWasmCollectImportSymbols(plan, functionLimit)
    let bytesRes = DirectObjectEmitWasmPlanModuleBytes(plan,
                                                       functionLimit,
                                                       entryIndex,
                                                       importSymbols)
    if !bytesRes.ok:
        let ownedErrMsg7 = strings.CloneStr(bytesRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg7)
    var bytes = bytesRes.value
    defer:
        rawbytes.BytesFree(bytes)
    if !DirectObjectEmitPublishObjectBytes(rootDir, outputPath, bytes):
        return Err[DirectObjectEmitResult](Fmt" direct wasm emit: atomic publish failed for wasm module: {outputPath}")
    var out: DirectObjectEmitResult
    out.objectPath = outputPath
    out.outputKind = "wasm_module"
    out.bytesWritten = BytesLen(bytes)
    out.symbolCount = functionLimit + importSymbols.len
    out.relocCount = 0
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    return Ok[DirectObjectEmitResult](out)

@borrows
fn DirectObjectEmitStandaloneText(plan: pobj.PrimaryObjectPlan): Bytes =
    return DirectObjectEmitPlanText(plan)

@borrows
fn DirectObjectEmitStandaloneSymbols(plan: pobj.PrimaryObjectPlan): osym.ObjectSymbolTable =
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    var symbols = osym.ObjectSymbolsInit()
    let bridgeIndex = DirectObjectEmitEntryBridgeIndex(plan)
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if bridgeIndex >= 0 && bridgeIndex < plan.functionWordOffsets.len:
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  "_main",
                                                                  0,
                                                                  int64(plan.functionWordOffsets[bridgeIndex] * 4),
                                                                  int64(plan.functionWordCounts[bridgeIndex] * 4),
                                                                  true),
                                     "direct object emit: add entry bridge _main symbol")
    elif entryIndex >= 0 && plan.entryFunctionSymbol != "_main":
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  "_main",
                                                                  0,
                                                                  int64(plan.functionWordOffsets[entryIndex] * 4),
                                                                  int64(plan.functionWordCounts[entryIndex] * 4),
                                                                  true),
                                     "direct object emit: add _main symbol")
    for i in 0..<functionLimit:
        let offset = int64(plan.functionWordOffsets[i] * 4)
        let size = int64(plan.functionWordCounts[i] * 4)
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  DirectObjectEmitPlanSymbolNameAt(plan, i),
                                                                  0,
                                                                  offset,
                                                                  size,
                                                                  true),
                                     "direct object emit: add function symbol")
    var dataOffset: int32
    let dataAddr = DirectObjectEmitStandaloneDataSectionAddr(plan)
    for i in 0..<plan.dataLabels.len:
        var payloadSize: int32
        if i < plan.dataPayloadRawByteCounts.len && plan.dataPayloadRawByteCounts[i] > 0:
            payloadSize = plan.dataPayloadRawByteCounts[i]
        else:
            var payloadText = ""
            if i < plan.dataPayloadTexts.len:
                payloadText = plan.dataPayloadTexts[i]
                payloadSize = DirectObjectEmitPayloadByteCount(payloadText)
            dataOffset = DirectObjectEmitAlign(dataOffset, DirectObjectEmitPayloadAlign(payloadText))
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                    strings.CloneStr(plan.dataLabels[i]),
                                                                  1,
                                                                  int64(dataAddr + dataOffset),
                                                                  int64(payloadSize),
                                                                  false),
                                     "direct object emit: add data symbol")
        dataOffset = dataOffset + payloadSize
    var globalLabels: str[]
    var globalPayloads: str[]
    globalLabels = []
    globalPayloads = []
    DirectObjectEmitAppendGlobalData(plan, functionLimit, globalLabels, globalPayloads)
    for i in 0..<globalLabels.len:
        var payloadSize2: int32
        var payloadText2 = ""
        if i < globalPayloads.len:
            payloadText2 = globalPayloads[i]
            payloadSize2 = DirectObjectEmitPayloadByteCount(payloadText2)
        dataOffset = DirectObjectEmitAlign(dataOffset, DirectObjectEmitPayloadAlign(payloadText2))
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                    strings.CloneStr(globalLabels[i]),
                                                                  1,
                                                                  int64(dataAddr + dataOffset),
                                                                  int64(payloadSize2),
                                                                  false),
                                     "direct object emit: add standalone global data symbol")
        dataOffset = dataOffset + payloadSize2
    for i in 0..<plan.relocTargetSymbols.len:
        if Len(plan.relocTargetSymbols[i]) <= 0:
            continue
        if DirectObjectEmitSymbolInRealFunctions(plan, functionLimit, plan.relocTargetSymbols[i]):
            continue
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddUndefined(symbols,
                                                                          strings.CloneStr(plan.relocTargetSymbols[i]),
                                                                    true),
                                     "direct object emit: add undefined symbol")
    return symbols

@borrows
fn DirectObjectEmitStandaloneRelocs(plan: pobj.PrimaryObjectPlan,
                                     symbols: var osym.ObjectSymbolTable): orel.ObjectRelocTable =
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    var relocs = orel.ObjectRelocsInit()
    for relocIndex in 0..<plan.relocTargetSymbols.len:
        if relocIndex >= plan.relocSourceItemIds.len || relocIndex >= plan.relocWordOffsets.len:
            continue
        var sourceInStandalone = false
        for i in 0..<functionLimit:
            if plan.itemIds[i] == plan.relocSourceItemIds[relocIndex]:
                sourceInStandalone = true
                break
        if !sourceInStandalone:
            continue
        DirectObjectEmitAddTargetCallReloc(
            plan.targetTriple,
            relocs,
            symbols,
            int64(plan.relocWordOffsets[relocIndex] * 4),
            plan.relocTargetSymbols[relocIndex])
    for relocIndex2 in 0..<plan.dataRelocTargetSymbols.len:
        if relocIndex2 >= plan.dataRelocSourceItemIds.len ||
           relocIndex2 >= plan.dataRelocWordOffsets.len:
            continue
        var sourceInStandalone2 = false
        for i2 in 0..<functionLimit:
            if plan.itemIds[i2] == plan.dataRelocSourceItemIds[relocIndex2]:
                sourceInStandalone2 = true
                break
        if !sourceInStandalone2:
            continue
        DirectObjectEmitAddPageRelocPair(relocs,
                                         symbols,
                                         int64(plan.dataRelocWordOffsets[relocIndex2] * 4),
                                         plan.dataRelocTargetSymbols[relocIndex2],
                                         "direct object emit: add standalone data page reloc")
    for i in 0..<functionLimit:
        let functionByteOffset = int64(plan.functionWordOffsets[i] * 4)
        let cstringCallCount = DirectObjectEmitCstringLiteralCallCount(plan, i)
        for callOrdinal in 0..<cstringCallCount:
            let literalSymbol = DirectObjectEmitDataLabelExact(plan,
                                                               DirectObjectEmitCStringLiteralDataLabel(DirectObjectEmitPlanSymbolNameAt(plan, i),
                                                                                                       callOrdinal))
            let callByteOffset = functionByteOffset + int64((2 + callOrdinal * 3) * 4)
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             callByteOffset,
                                             literalSymbol,
                                             "direct object emit: add cstring page reloc")
        if i < plan.functionBodyKinds.len && plan.functionBodyKinds[i] == texpr.BodyKindReturnStrLiteral:
            let returnLiteralLabel = strutil.Join([DirectObjectEmitPlanSymbolNameAt(plan, i), "__cheng_return_str_literal"], "")
            let literalSymbol = DirectObjectEmitDataLabelExact(plan,
                                                               returnLiteralLabel)
            DirectObjectEmitAddPageRelocPair(relocs,
                                             symbols,
                                             functionByteOffset + int64(8),
                                             literalSymbol,
                                             "direct object emit: add return str literal page reloc")
    return relocs

@borrows
fn DirectObjectEmitStandaloneEntryTextOffset(plan: pobj.PrimaryObjectPlan): int32 =
    let bridgeIndex = DirectObjectEmitEntryBridgeIndex(plan)
    if bridgeIndex >= 0 && bridgeIndex < plan.functionWordOffsets.len:
        return plan.functionWordOffsets[bridgeIndex] * 4
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if entryIndex < 0 || entryIndex >= plan.functionWordOffsets.len:
        return -1
    return plan.functionWordOffsets[entryIndex] * 4

@borrows
fn DirectObjectEmitValidateStandaloneExecutable(plan: pobj.PrimaryObjectPlan): Result[bool] =
    let validRes = DirectObjectEmitValidateStandaloneMain(plan)
    if !validRes.ok:
        let ownedErrMsg8 = strings.CloneStr(validRes.err.msg)
        return Err[bool](ownedErrMsg8)
    let entryTextOffset = DirectObjectEmitStandaloneEntryTextOffset(plan)
    if entryTextOffset < 0:
        return Err[bool](" direct object emit: executable missing entry offset")
    return Ok[bool](true)

@borrows
fn DirectObjectEmitStandaloneExecutable(rootDir: str,
                                         plan: pobj.PrimaryObjectPlan,
                                         outputPath: str): Result[DirectObjectEmitResult] =
    let validRes = DirectObjectEmitValidateStandaloneExecutable(plan)
    if !validRes.ok:
        let ownedErrMsg9 = strings.CloneStr(validRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg9)
    if Len(outputPath) <= 0:
        return Err[DirectObjectEmitResult](" direct object emit: executable missing output path")
    var text = DirectObjectEmitStandaloneText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data = DirectObjectEmitPlanData(
        plan, DirectObjectEmitRealFunctionLimit(plan))
    defer:
        rawbytes.BytesFree(data)
    let entryTextOffset = DirectObjectEmitStandaloneEntryTextOffset(plan)
    let dataSize = BytesLen(data)
    var writeRes: Result[macho_object_writer.MachOObjectWriterResult]
    if dataSize > 0:
        writeRes = macho_object_writer.MachOTextDataExecutableWrite(rootDir, outputPath, text, data, entryTextOffset)
    else:
        writeRes = macho_object_writer.MachOTextExecutableWrite(rootDir, outputPath, text, entryTextOffset)
    if !writeRes.ok:
        let ownedErrMsg10 = strings.CloneStr(writeRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg10)
    let write = writeRes.value
    var out: DirectObjectEmitResult
    out.objectPath = write.objectPath
    out.outputKind = DirectObjectEmitOutputKindExecutable()
    out.bytesWritten = write.bytesWritten
    out.symbolCount = write.symbolCount
    out.relocCount = write.relocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    return Ok[DirectObjectEmitResult](out)

@borrows
fn DirectObjectEmitStandaloneExecutableWithData(rootDir: str,
                                                  plan: pobj.PrimaryObjectPlan,
                                                  outputPath: str): Result[DirectObjectEmitResult] =
    let validRes = DirectObjectEmitValidateStandaloneExecutable(plan)
    if !validRes.ok:
        let ownedErrMsg11 = strings.CloneStr(validRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg11)
    if Len(outputPath) <= 0:
        return Err[DirectObjectEmitResult](" direct object emit: executable missing output path")
    var text = DirectObjectEmitStandaloneText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data = DirectObjectEmitPlanData(
        plan, DirectObjectEmitRealFunctionLimit(plan))
    defer:
        rawbytes.BytesFree(data)
    let entryTextOffset = DirectObjectEmitStandaloneEntryTextOffset(plan)
    let writeRes = macho_object_writer.MachOTextDataExecutableWrite(rootDir, outputPath, text, data, entryTextOffset)
    if !writeRes.ok:
        let ownedErrMsg12 = strings.CloneStr(writeRes.err.msg)
        return Err[DirectObjectEmitResult](ownedErrMsg12)
    let write = writeRes.value
    var out: DirectObjectEmitResult
    out.objectPath = write.objectPath
    out.outputKind = DirectObjectEmitOutputKindExecutable()
    out.bytesWritten = write.bytesWritten
    out.symbolCount = write.symbolCount
    out.relocCount = write.relocCount
    out.linkerlessImage = 0
    out.systemLink = 0
    out.directObjectLayoutMs = DirectObjectEmitZeroMs()
    out.directObjectEmitMs = DirectObjectEmitZeroMs()
    return Ok[DirectObjectEmitResult](out)

@borrows
fn DirectObjectEmitWriteStandaloneMain(rootDir: str,
                                        plan: pobj.PrimaryObjectPlan): Result[DirectObjectEmitResult] =
    var text = DirectObjectEmitStandaloneText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data = DirectObjectEmitPlanData(
        plan, DirectObjectEmitRealFunctionLimit(plan))
    defer:
        rawbytes.BytesFree(data)
    var symbols = DirectObjectEmitStandaloneSymbols(plan)
    var relocs = DirectObjectEmitStandaloneRelocs(plan, symbols)
    var write: DirectObjectEmitResult
    var writeErr: str
    let ownedFormat = strings.CloneStr(plan.objectFormat)
    if !DirectObjectEmitWriteObjectForFormat(rootDir,
                                             plan,
                                             ownedFormat,
                                             text,
                                             data,
                                             symbols,
                                             relocs,
                                             write,
                                             writeErr):
        return Err[DirectObjectEmitResult](writeErr)
    return Ok[DirectObjectEmitResult](write)

@borrows
fn DirectObjectEmitValidateStandaloneShape(plan: pobj.PrimaryObjectPlan): Result[bool] =
    if DirectObjectEmitCanStandaloneMain(plan):
        return Ok[bool](true)
    if !(plan.targetTriple == "arm64-apple-darwin" && plan.objectFormat == "macho"):
        return Err[bool](Fmt" direct object emit: unsupported target: {plan.targetTriple}")
    if !DirectObjectEmitInstructionWordsMaterialized(plan):
        return Err[bool](DirectObjectEmitInstructionWordsMissingReason(plan))
    if Len(plan.outputPath) <= 0:
        return Err[bool](" direct object emit: missing output path")
    if plan.missingReasons.len > 0:
        let missingReasonsText = strutil.Join(plan.missingReasons, "; ")
        return Err[bool](Fmt" direct object emit: plan has missing reasons: {missingReasonsText}")
    if plan.functionBodyKinds.len <= 0:
        return Err[bool](" direct object emit: missing function body kind")
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if entryIndex < 0:
        return Err[bool](" direct object emit: standalone missing entry function")
    let entryBodyKind = plan.functionBodyKinds[entryIndex]
    if entryBodyKind != texpr.BodyKindReturnVoid &&
       entryBodyKind != texpr.BodyKindReturnZeroI32 &&
       !DirectObjectEmitIsReturnI32ConstBodyKind(entryBodyKind) &&
       !DirectObjectEmitIsLetCallNoargReturnI32ConstBodyKind(entryBodyKind) &&
       entryBodyKind != texpr.BodyKindResultRequestDispatch &&
       entryBodyKind != texpr.BodyKindStatementSequence &&
       entryBodyKind != texpr.BodyKindMainF64MulCheckExit:
        return Err[bool](" direct object emit: standalone entry must be direct-provider-free")
    for i in 0..<functionLimit:
        let bodyKind = plan.functionBodyKinds[i]
        var expectedWords: int32
        if i >= 0 && i < plan.functionWordCounts.len:
            expectedWords = plan.functionWordCounts[i]
        if expectedWords <= 0 ||
           bodyKind == texpr.BodyKindEntryBridge:
            return Err[bool](" direct object emit: standalone unsupported body kind")
    return Err[bool](" direct object emit: standalone object requires unsupported codegen")

@borrows
fn DirectObjectEmitValidateStandaloneMain(plan: pobj.PrimaryObjectPlan): Result[bool] =
    let shapeRes = DirectObjectEmitValidateStandaloneShape(plan)
    if !shapeRes.ok:
        return shapeRes
    return Ok[bool](true)

@borrows
fn DirectObjectEmitCanPlanObject(plan: pobj.PrimaryObjectPlan): bool =
    if !DirectObjectEmitTargetObjectSupported(plan.targetTriple, plan.objectFormat):
        return false
    if Len(plan.outputPath) <= 0:
        return false
    if plan.missingReasons.len > 0:
        return false
    if DirectObjectEmitX64Triple(plan.targetTriple) &&
       len(DirectObjectEmitX64CanonicalPlanReason(plan)) > 0:
        return false
    return true

@borrows
fn DirectObjectEmitCanWindowsReturnZeroObject(plan: pobj.PrimaryObjectPlan): bool =
    if plan.targetTriple != "x86_64-pc-windows-msvc" || plan.objectFormat != "coff":
        return false
    if Len(plan.outputPath) <= 0:
        return false
    if plan.missingReasons.len > 0:
        return false
    let functionLimit = DirectObjectEmitRealFunctionLimit(plan)
    if functionLimit != 1:
        return false
    let entryIndex = DirectObjectEmitEntryFunctionIndex(plan, functionLimit)
    if entryIndex != 0:
        return false
    if entryIndex >= plan.functionBodyKinds.len:
        return false
    return plan.functionBodyKinds[entryIndex] == texpr.BodyKindReturnZeroI32

@borrows
fn DirectObjectEmitCanPlanObjectForFormat(plan: pobj.PrimaryObjectPlan,
                                          objectFormat: str): bool =
    if !DirectObjectEmitTargetObjectSupported(plan.targetTriple, objectFormat):
        return false
    if Len(plan.outputPath) <= 0:
        return false
    if plan.missingReasons.len > 0:
        return false
    if DirectObjectEmitX64Triple(plan.targetTriple) &&
       (objectFormat != plan.objectFormat ||
        len(DirectObjectEmitX64CanonicalPlanReason(plan)) > 0):
        return false
    return true

@borrows
fn DirectObjectEmitCanReturnZeroObject(plan: pobj.PrimaryObjectPlan): bool =
    if !DirectObjectEmitCanPlanObject(plan):
        return false
    for i in 0..<plan.functionBodyKinds.len:
        if plan.functionBodyKinds[i] != texpr.BodyKindReturnZeroI32:
            return false
    return true

@borrows
fn DirectObjectEmitValidatePlanObject(
        plan: pobj.PrimaryObjectPlan): Result[bool] =
    return DirectObjectEmitValidatePlanObjectForTarget(plan, plan.targetTriple, plan.objectFormat)

@borrows
fn DirectObjectEmitValidatePlanObjectInto(plan: pobj.PrimaryObjectPlan,
                                          outErr: var str): bool =
    outErr = ""
    if !pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(
           plan, outErr):
        return false
    if DirectObjectEmitTargetObjectSupported(plan.targetTriple, plan.objectFormat) &&
       Len(plan.outputPath) > 0 &&
       plan.missingReasons.len <= 0:
        if plan.functionWordCounts.len <= 0:
            outErr = " direct object emit: missing function word-count table"
            return false
        if plan.functionWordOffsets.len <= 0:
            outErr = " direct object emit: missing function word-offset table"
            return false
        let functionCount = DirectObjectEmitPlanFunctionCount(plan)
        if functionCount <= 0:
            outErr = " direct object emit: missing function word tables"
            return false
        if !DirectObjectEmitInstructionWordsMaterialized(plan):
            outErr = DirectObjectEmitInstructionWordsMissingReason(plan)
            return false
        var requiredWords: int32
        for i in 0..<functionCount:
            let endWord = plan.functionWordOffsets[i] + plan.functionWordCounts[i]
            if endWord > requiredWords:
                requiredWords = endWord
        if requiredWords > plan.instructionWords.len:
            outErr = " direct object emit: instruction word count mismatch"
            return false
        if DirectObjectEmitX64Triple(plan.targetTriple):
            let canonicalReason =
                DirectObjectEmitX64CanonicalPlanReason(plan)
            if Len(canonicalReason) > 0:
                outErr = canonicalReason
                return false
        return true
    if !DirectObjectEmitTargetObjectSupported(plan.targetTriple, plan.objectFormat):
        outErr = Fmt" direct object emit: unsupported target: {plan.targetTriple}"
        return false
    if Len(plan.outputPath) <= 0:
        outErr = " direct object emit: missing output path"
        return false
    if plan.missingReasons.len > 0:
        let missingReasonsText = strutil.Join(plan.missingReasons, "; ")
        outErr = Fmt" direct object emit: plan has missing reasons: {missingReasonsText}"
        return false
    if DirectObjectEmitPlanFunctionCount(plan) <= 0:
        outErr = " direct object emit: missing function word tables"
        return false
    outErr = " direct object emit: object requires unsupported codegen"
    return false

@borrows
fn DirectObjectEmitValidatePlanObjectForTarget(
        plan: pobj.PrimaryObjectPlan,
        targetTriple: str,
        objectFormat: str): Result[bool] =
    var identityErr: str
    if !pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(
           plan, identityErr):
        return Err[bool](identityErr)
    if DirectObjectEmitTargetObjectSupported(targetTriple, objectFormat) &&
       Len(plan.outputPath) > 0 &&
       plan.missingReasons.len <= 0:
        if plan.functionWordCounts.len <= 0:
            return Err[bool](" direct object emit: missing function word-count table")
        if plan.functionWordOffsets.len <= 0:
            return Err[bool](" direct object emit: missing function word-offset table")
        let functionCount = DirectObjectEmitPlanFunctionCount(plan)
        if functionCount <= 0:
            return Err[bool](" direct object emit: missing function word tables")
        if !DirectObjectEmitInstructionWordsMaterialized(plan):
            return Err[bool](DirectObjectEmitInstructionWordsMissingReason(plan))
        var requiredWords: int32
        for i in 0..<functionCount:
            let endWord = plan.functionWordOffsets[i] + plan.functionWordCounts[i]
            if endWord > requiredWords:
                requiredWords = endWord
        if requiredWords > plan.instructionWords.len:
            return Err[bool](" direct object emit: instruction word count mismatch")
        if DirectObjectEmitX64Triple(targetTriple) ||
           DirectObjectEmitX64Triple(plan.targetTriple):
            if targetTriple != plan.targetTriple ||
               objectFormat != plan.objectFormat:
                return Err[bool](
                    " direct object emit: x86_64 canonical target mismatch")
            let canonicalReason =
                DirectObjectEmitX64CanonicalPlanReason(plan)
            if Len(canonicalReason) > 0:
                return Err[bool](canonicalReason)
        return Ok[bool](true)
    if !DirectObjectEmitTargetObjectSupported(targetTriple, objectFormat):
        return Err[bool](Fmt" direct object emit: unsupported target: {targetTriple}")
    if Len(plan.outputPath) <= 0:
        return Err[bool](" direct object emit: missing output path")
    if plan.missingReasons.len > 0:
        let missingReasonsText = strutil.Join(plan.missingReasons, "; ")
        return Err[bool](Fmt" direct object emit: plan has missing reasons: {missingReasonsText}")
    if DirectObjectEmitPlanFunctionCount(plan) <= 0:
        return Err[bool](" direct object emit: missing function word tables")
    return Err[bool](" direct object emit: object requires unsupported codegen")

fn DirectObjectEmitReturnZeroText(symbolNames: str[]): Bytes =
    var text = obuf.ObjectBufferInit(symbolNames.len * 8 + 16)
    for _ in 0..<symbolNames.len:
        obuf.ObjectBufferWriteU32LE(text, uint64(0x52800000))
        obuf.ObjectBufferWriteU32LE(text, uint64(0xd65f03c0))
    return obuf.ObjectBufferTakeBytes(text)

fn DirectObjectEmitReturnZeroSymbols(symbolNames: str[]): osym.ObjectSymbolTable =
    var symbols = osym.ObjectSymbolsInit()
    var offset: int64
    for i in 0..<symbolNames.len:
        DirectObjectEmitRequireIndex(osym.ObjectSymbolsAddDefined(symbols,
                                                                  symbolNames[i],
                                                                  0,
                                                                  offset,
                                                                  int64(8),
                                                                  true),
                                     "direct object emit: add return-zero symbol")
        offset = offset + int64(8)
    return symbols

@borrows
fn DirectObjectEmitX64TargetFor(targetTriple: str,
                                objectFormat: str): bool =
    if targetTriple == "x86_64-unknown-linux-gnu" && objectFormat == "elf":
        return true
    if targetTriple == "x86_64-pc-windows-msvc" && objectFormat == "coff":
        return true
    return false

@borrows
fn DirectObjectEmitX64Triple(targetTriple: str): bool =
    return targetTriple == "x86_64-unknown-linux-gnu" ||
           targetTriple == "x86_64-pc-windows-msvc"

@borrows
fn DirectObjectEmitX64Target(plan: pobj.PrimaryObjectPlan): bool =
    return DirectObjectEmitX64TargetFor(plan.targetTriple, plan.objectFormat)

@borrows
fn DirectObjectEmitSha256HexValid(value: str): bool =
    if len(value) != 64:
        return false
    for i in 0..<len(value):
        let ch = value[i]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn DirectObjectEmitX64PackedInstructionByte(
        plan: pobj.PrimaryObjectPlan,
        byteOffset: int32): int32 =
    if byteOffset < 0 || byteOffset >= plan.instructionWords.len * 4:
        return -1
    let word = plan.instructionWords[byteOffset / 4]
    let shift = (byteOffset % 4) * 8
    return (word >> shift) & 255

@borrows
fn DirectObjectEmitX64RelocOwnerFunctionIndex(
        plan: pobj.PrimaryObjectPlan,
        itemId: int32,
        byteOffset: int32): int32 =
    var owner: int32 = -1
    for i in 0..<plan.itemIds.len:
        if plan.itemIds[i] != itemId:
            continue
        if owner >= 0 ||
           i >= plan.functionWordOffsets.len ||
           i >= plan.functionWordCounts.len:
            return -1
        let byteStart = plan.functionWordOffsets[i] * 4
        let byteEnd =
            (plan.functionWordOffsets[i] +
             plan.functionWordCounts[i]) * 4
        if byteOffset < byteStart || byteOffset > byteEnd - 4:
            return -1
        owner = i
    return owner

@borrows
fn DirectObjectEmitX64CanonicalRelocShapeReason(
        plan: pobj.PrimaryObjectPlan): str =
    if plan.relocSourceItemIds.len != plan.relocWordOffsets.len ||
       plan.relocTargetSymbols.len != plan.relocWordOffsets.len ||
       plan.dataRelocSourceItemIds.len !=
           plan.dataRelocWordOffsets.len ||
       plan.dataRelocTargetSymbols.len !=
           plan.dataRelocWordOffsets.len:
        return " direct object emit: x86_64 canonical relocation SoA shape mismatch"
    for relocIndex in 0..<plan.relocWordOffsets.len:
        let byteOffset = plan.relocWordOffsets[relocIndex]
        if len(plan.relocTargetSymbols[relocIndex]) <= 0 ||
           DirectObjectEmitX64RelocOwnerFunctionIndex(
               plan,
               plan.relocSourceItemIds[relocIndex],
               byteOffset) < 0 ||
           byteOffset <= 0 ||
           DirectObjectEmitX64PackedInstructionByte(
               plan, byteOffset - 1) != 232:
            return " direct object emit: x86_64 canonical call relocation identity mismatch"
        for immediateByte in 0..<4:
            if DirectObjectEmitX64PackedInstructionByte(
                   plan, byteOffset + immediateByte) != 0:
                return " direct object emit: x86_64 canonical call relocation payload mismatch"
        for priorIndex in 0..<relocIndex:
            if plan.relocWordOffsets[priorIndex] == byteOffset:
                return " direct object emit: x86_64 canonical call relocation duplicate"
    for relocIndex in 0..<plan.dataRelocWordOffsets.len:
        let byteOffset = plan.dataRelocWordOffsets[relocIndex]
        if len(plan.dataRelocTargetSymbols[relocIndex]) <= 0 ||
           DirectObjectEmitX64RelocOwnerFunctionIndex(
               plan,
               plan.dataRelocSourceItemIds[relocIndex],
               byteOffset) < 0:
            return " direct object emit: x86_64 canonical data relocation identity mismatch"
        for immediateByte in 0..<4:
            if DirectObjectEmitX64PackedInstructionByte(
                   plan, byteOffset + immediateByte) != 0:
                return " direct object emit: x86_64 canonical data relocation payload mismatch"
        for priorIndex in 0..<relocIndex:
            if plan.dataRelocWordOffsets[priorIndex] == byteOffset:
                return " direct object emit: x86_64 canonical data relocation duplicate"
        for callRelocIndex in 0..<plan.relocWordOffsets.len:
            if plan.relocWordOffsets[callRelocIndex] == byteOffset:
                return " direct object emit: x86_64 canonical relocation offset collision"
    return ""

@borrows
fn DirectObjectEmitX64CanonicalPlanReason(
        plan: pobj.PrimaryObjectPlan): str =
    if plan.targetTriple !=
           regart.RegallocProductionTargetX64Linux ||
       plan.objectFormat != "elf":
        return " direct object emit: x86_64 non-canonical target is forbidden"
    if (plan.actualBackendKind != "primary" &&
        plan.actualBackendKind != "backend2") ||
       plan.streamedBuildAborted:
        return " direct object emit: x86_64 canonical regalloc production state missing"
    if plan.actualBackendKind == "primary" &&
       !plan.streamedEmitFirst:
        return " direct object emit: x86_64 primary canonical emission state missing"
    let count = plan.symbolNames.len
    if count <= 0 ||
       plan.itemIds.len != count ||
       plan.functionWordOffsets.len != count ||
       plan.functionWordCounts.len != count ||
       plan.functionBodyKinds.len != count ||
       plan.functionIrIndexes.len != count ||
       plan.regallocFrozenSnapshotSinglePayloads.len != count ||
       plan.regallocEmissionLedgerSinglePayloads.len != count ||
       plan.regallocFunctionSymbols.len != count ||
       plan.regallocFunctionIrIndexes.len != count ||
       plan.regallocFunctionKinds.len != count ||
       plan.regallocFunctionBodyIrSha256s.len != count ||
       plan.regallocFunctionSymbolByteStarts.len != count ||
       plan.regallocFunctionSymbolByteLengths.len != count ||
       plan.regallocFunctionSymbolBytesSha256s.len != count ||
       plan.regallocFunctionPlanSha256s.len != count ||
       plan.regallocFunctionActionSemanticRootSha256s.len != count ||
       plan.regallocFunctionActionLedgerRootSha256s.len != count ||
       plan.regallocFunctionMachineFragmentRootSha256s.len != count ||
       plan.regallocFunctionAbiIngressRootSha256s.len != count ||
       plan.regallocFunctionActionCounts.len != count:
        return " direct object emit: x86_64 canonical regalloc evidence shape mismatch"
    if plan.actualBackendKind == "backend2" &&
       (plan.bodyIrLifecycleFunctionCount != count ||
        !plan.bodyIrLifecycleAllClosed):
        return " direct object emit: x86_64 backend2 canonical lifecycle evidence mismatch"
    var functionIndex =
        regart.RegallocProductionFunctionIndexInit(count)
    var expectedWordOffset: int32
    for i in 0..<count:
        if plan.functionWordOffsets[i] != expectedWordOffset ||
           plan.functionWordCounts[i] <= 0 ||
           plan.regallocFunctionSymbols[i] != plan.symbolNames[i] ||
           plan.regallocFunctionIrIndexes[i] !=
               plan.functionIrIndexes[i] ||
           !regart.RegallocProductionFunctionIdentityValid(
               plan.regallocFunctionIrIndexes[i],
               plan.regallocFunctionKinds[i]) ||
           (plan.regallocFunctionKinds[i] ==
                regart.RegallocProductionFunctionKindEntryBridge) !=
               (plan.functionBodyKinds[i] ==
                    texpr.BodyKindEntryBridge) ||
           plan.regallocFunctionSymbolByteStarts[i] !=
               plan.functionWordOffsets[i] * 4 ||
           plan.regallocFunctionSymbolByteLengths[i] !=
               plan.functionWordCounts[i] * 4 ||
           len(plan.regallocFrozenSnapshotSinglePayloads[i]) <= 0 ||
           len(plan.regallocEmissionLedgerSinglePayloads[i]) <= 0 ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionBodyIrSha256s[i]) ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionSymbolBytesSha256s[i]) ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionPlanSha256s[i]) ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionActionSemanticRootSha256s[i]) ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionActionLedgerRootSha256s[i]) ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionMachineFragmentRootSha256s[i]) ||
           !DirectObjectEmitSha256HexValid(
               plan.regallocFunctionAbiIngressRootSha256s[i]) ||
           plan.regallocFunctionActionCounts[i] < 0:
            return " direct object emit: x86_64 canonical function evidence mismatch"
        if regart.RegallocProductionFunctionIndexAppend(
               functionIndex,
               plan.regallocFunctionIrIndexes[i],
               plan.regallocFunctionKinds[i],
               plan.regallocFunctionSymbols[i]) !=
               regart.RegallocProductionFunctionIndexAppendOk:
            return " direct object emit: x86_64 canonical function identity duplicate"
        expectedWordOffset =
            expectedWordOffset + plan.functionWordCounts[i]
    if expectedWordOffset != plan.instructionWords.len:
        return " direct object emit: x86_64 canonical instruction coverage mismatch"
    return DirectObjectEmitX64CanonicalRelocShapeReason(plan)

@borrows
fn DirectObjectEmitX64TinyEntryBridgePlan(plan: pobj.PrimaryObjectPlan): bool =
    if !DirectObjectEmitX64Target(plan):
        return false
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    if functionCount != 2:
        return false
    return DirectObjectEmitFunctionLooksEntryBridgeWords(plan, 1)

@borrows
fn DirectObjectEmitX64FunctionHasBodyIR(plan: pobj.PrimaryObjectPlan,
                                        functionIndex: int32): bool =
    if functionIndex < 0 || functionIndex >= plan.functionBodyIRs.len:
        return false
    if plan.functionBodyIRs[functionIndex].ops.len > 0:
        return true
    return plan.functionBodyIRs[functionIndex].terms.len > 0

fn DirectObjectEmitX64CStringCallPayloadSize(): int32 =
    # lea(7) + sub rsp(4) + call(5) + add rsp(4) + ret(1)
    return 21

fn DirectObjectEmitX64CallLtZeroSelectPayloadSize(geValue: int32): int32 =
    # sub rsp(4) + call(5) + add rsp(4) + test(2) + jns(2) + mov(5) + ret(1)
    # + final return: xor+ret(3) when zero, mov imm32+ret(6) otherwise.
    if geValue == 0:
        return 26
    return 29

@borrows
fn DirectObjectEmitX64FunctionPayloadSize(plan: pobj.PrimaryObjectPlan,
                                          functionIndex: int32): int32 =
    if functionIndex < 0 || functionIndex >= plan.functionBodyKinds.len:
        return 0
    if DirectObjectEmitX64FunctionHasBodyIR(plan, functionIndex):
        if functionIndex < plan.functionWordCounts.len &&
           plan.functionWordCounts[functionIndex] > 0:
            return plan.functionWordCounts[functionIndex] * 4
        return 0
    let bodyKind = plan.functionBodyKinds[functionIndex]
    if DirectObjectEmitX64TinyEntryBridgePlan(plan) && functionIndex == 0:
        return 3
    if DirectObjectEmitFunctionLooksEntryBridgeWords(plan, functionIndex):
        return 71
    var constValue: int32
    if DirectObjectEmitWasmFunctionReturnI32Const(plan, functionIndex, constValue):
        if constValue == 0:
            return 3
        return 6
    if functionIndex < plan.functionBodyIRs.len:
        var binOpKind: int32
        var lhsParam: int32
        var rhsParam: int32
        if DirectObjectEmitX64BodyIRSingleI32BinOpReturn(plan.functionBodyIRs[functionIndex],
                                                         binOpKind,
                                                         lhsParam,
                                                         rhsParam):
            if binOpKind == int32(texpr.TypedExprIrOpI32Mul):
                return 6
            if binOpKind == int32(texpr.TypedExprIrOpI32Asr):
                return 7
            return 5
    var callThenTarget = ""
    var callThenValue: int32
    if DirectObjectEmitX64BodyIRSingleNoargCallThenI32Const(plan,
                                                            functionIndex,
                                                            callThenTarget,
                                                            callThenValue):
        return 19
    var cstringCallTarget = ""
    var cstringLiteralLabel = ""
    if DirectObjectEmitX64BodyIRSingleCStringCallReturnResult(plan,
                                                              functionIndex,
                                                              cstringCallTarget,
                                                              cstringLiteralLabel):
        return DirectObjectEmitX64CStringCallPayloadSize()
    var ltZeroTarget = ""
    var ltZeroValue: int32
    var geZeroValue: int32
    if DirectObjectEmitX64BodyIRCallLtZeroSelectReturn(plan,
                                                       functionIndex,
                                                       ltZeroTarget,
                                                       ltZeroValue,
                                                       geZeroValue):
        return DirectObjectEmitX64CallLtZeroSelectPayloadSize(geZeroValue)
    var callTarget = ""
    var callArgCount: int32
    if DirectObjectEmitWasmFunctionSingleCallTarget(plan, functionIndex, callTarget, callArgCount):
        return 5
    if bodyKind == texpr.BodyKindReturnVoid:
        return 1
    if bodyKind == texpr.BodyKindReturnF64MulArgs:
        return 5
    if bodyKind == texpr.BodyKindReturnF64Arg0:
        return 1
    if bodyKind == texpr.BodyKindReturnF64FromI32Arg0:
        return 5
    if bodyKind == texpr.BodyKindReturnF64FromI64Arg0:
        return 6
    if bodyKind == texpr.BodyKindReturnI64Arg0:
        return 4
    if bodyKind == texpr.BodyKindReturnI64FromI32Arg0:
        return 4
    if texpr.TypedExprIsReturnCallBodyKind(bodyKind):
        return 5
    if bodyKind == texpr.BodyKindRuntimeSetCmdLine:
        return 20
    if bodyKind == texpr.BodyKindRuntimeParamCount:
        return 18
    if bodyKind == texpr.BodyKindRuntimeParamStrCopyBridge:
        return 135
    if bodyKind == texpr.BodyKindStrLenFastI32:
        return 18
    return 0

@borrows
fn DirectObjectEmitX64CanPlanText(plan: pobj.PrimaryObjectPlan): bool =
    return DirectObjectEmitX64CanPlanTextForTarget(plan, plan.targetTriple, plan.objectFormat)

@borrows
fn DirectObjectEmitX64CanPlanTextForTarget(plan: pobj.PrimaryObjectPlan,
                                           targetTriple: str,
                                           objectFormat: str): bool =
    if !DirectObjectEmitX64TargetFor(targetTriple, objectFormat):
        return false
    if !DirectObjectEmitX64Target(plan):
        return false
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    if functionCount <= 0:
        return false
    for i in 0..<functionCount:
        if i >= plan.functionWordOffsets.len || i >= plan.functionWordCounts.len:
            return false
        let payloadSize = DirectObjectEmitX64FunctionPayloadSize(plan, i)
        if payloadSize <= 0:
            return false
        let declaredSize = plan.functionWordCounts[i] * 4
        if payloadSize > declaredSize && i + 1 < functionCount:
            return false
        if texpr.TypedExprIsReturnCallBodyKind(plan.functionBodyKinds[i]):
            if i >= plan.itemIds.len:
                return false
            if Len(DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[i], 0)) <= 0:
                return false
    return true

@borrows
fn DirectObjectEmitX64PlanTextUnsupportedReason(plan: pobj.PrimaryObjectPlan): str =
    return DirectObjectEmitX64PlanTextUnsupportedReasonForTarget(plan, plan.targetTriple, plan.objectFormat)

@borrows
fn DirectObjectEmitX64PlanTextUnsupportedReasonForTarget(plan: pobj.PrimaryObjectPlan,
                                                         targetTriple: str,
                                                         objectFormat: str): str =
    if !DirectObjectEmitX64TargetFor(targetTriple, objectFormat):
        return ""
    if !DirectObjectEmitX64Target(plan):
        return Fmt" direct object emit: x86_64 Linux plan target mismatch: plan_target={plan.targetTriple} plan_format={plan.objectFormat}"
    let functionCount = DirectObjectEmitPlanFunctionCount(plan)
    if functionCount <= 0:
        return " direct object emit: x86_64 Linux requires x64 text emitter: missing function table"
    for i in 0..<functionCount:
        if i >= plan.functionWordOffsets.len || i >= plan.functionWordCounts.len:
            return Fmt" direct object emit: x86_64 Linux requires x64 text emitter: missing word table index={strings.IntToStr(i)}"
        let payloadSize = DirectObjectEmitX64FunctionPayloadSize(plan, i)
        if payloadSize <= 0:
            var bodyKind = "?"
            if i < plan.functionBodyKinds.len:
                bodyKind = plan.functionBodyKinds[i]
            var detail = ""
            if i < plan.functionBodyIRs.len:
                detail = DirectObjectEmitX64BodyIRDetail(plan.functionBodyIRs[i])
            var reason = Fmt" direct object emit: x86_64 Linux requires x64 text emitter: unsupported body kind index={strings.IntToStr(i)} bodyKind={bodyKind}"
            reason = reason + detail
            return reason
        let declaredSize = plan.functionWordCounts[i] * 4
        if payloadSize > declaredSize && i + 1 < functionCount:
            return Fmt" direct object emit: x86_64 Linux requires x64 text emitter: payload exceeds reserved words index={strings.IntToStr(i)} payload_bytes={strings.IntToStr(payloadSize)} declared_bytes={strings.IntToStr(declaredSize)}"
        if i < plan.functionBodyKinds.len &&
           texpr.TypedExprIsReturnCallBodyKind(plan.functionBodyKinds[i]):
            if i >= plan.itemIds.len:
                return Fmt" direct object emit: x86_64 Linux requires x64 text emitter: missing item id index={strings.IntToStr(i)}"
            if Len(DirectObjectEmitRelocTargetForItemOrdinal(plan, plan.itemIds[i], 0)) <= 0:
                return Fmt" direct object emit: x86_64 Linux requires x64 text emitter: missing call relocation target index={strings.IntToStr(i)}"
    return ""

fn DirectObjectEmitX64WriteRet(out: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, int32(0xc3))

fn DirectObjectEmitX64WriteReturnZero(out: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, int32(0x31))
    obuf.ObjectBufferWriteU8(out, int32(0xc0))
    DirectObjectEmitX64WriteRet(out)

fn DirectObjectEmitX64WriteReturnI32Const(out: var obuf.ObjectBuffer,
                                          value: int32) =
    obuf.ObjectBufferWriteU8(out, int32(0xb8))
    obuf.ObjectBufferWriteU32LE(out, uint64(value))
    DirectObjectEmitX64WriteRet(out)

fn DirectObjectEmitX64WriteCallPlaceholder(out: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, int32(0xe8))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))

fn DirectObjectEmitX64WriteJmpPlaceholder(out: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU8(out, int32(0xe9))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))

fn DirectObjectEmitX64ParamRegCode(paramIndex: int32): int32 =
    if paramIndex == 0:
        return int32(7)
    if paramIndex == 1:
        return int32(6)
    if paramIndex == 2:
        return int32(2)
    if paramIndex == 3:
        return int32(1)
    return int32(-1)

fn DirectObjectEmitX64WriteMovEaxParam(out: var obuf.ObjectBuffer,
                                        paramIndex: int32) =
    let reg = DirectObjectEmitX64ParamRegCode(paramIndex)
    obuf.ObjectBufferWriteU8(out, int32(0x89))
    obuf.ObjectBufferWriteU8(out, int32(0xc0) | (reg << 3))

fn DirectObjectEmitX64WriteMovEcxParam(out: var obuf.ObjectBuffer,
                                        paramIndex: int32) =
    let reg = DirectObjectEmitX64ParamRegCode(paramIndex)
    obuf.ObjectBufferWriteU8(out, int32(0x89))
    obuf.ObjectBufferWriteU8(out, int32(0xc1) | (reg << 3))

fn DirectObjectEmitX64WriteEaxRegOp(out: var obuf.ObjectBuffer,
                                     opcode: int32,
                                     paramIndex: int32) =
    let reg = DirectObjectEmitX64ParamRegCode(paramIndex)
    obuf.ObjectBufferWriteU8(out, opcode)
    obuf.ObjectBufferWriteU8(out, int32(0xc0) | (reg << 3))

fn DirectObjectEmitX64WriteI32BinOpReturn(out: var obuf.ObjectBuffer,
                                           opKind: int32,
                                           lhsParam: int32,
                                           rhsParam: int32) =
    DirectObjectEmitX64WriteMovEaxParam(out, lhsParam)
    if opKind == int32(texpr.TypedExprIrOpI32Add):
        DirectObjectEmitX64WriteEaxRegOp(out, int32(0x01), rhsParam)
        DirectObjectEmitX64WriteRet(out)
        return
    if opKind == int32(texpr.TypedExprIrOpI32Sub):
        DirectObjectEmitX64WriteEaxRegOp(out, int32(0x29), rhsParam)
        DirectObjectEmitX64WriteRet(out)
        return
    if opKind == int32(texpr.TypedExprIrOpI32Mul):
        obuf.ObjectBufferWriteU8(out, int32(0x0f))
        obuf.ObjectBufferWriteU8(out, int32(0xaf))
        obuf.ObjectBufferWriteU8(out, int32(0xc0) | DirectObjectEmitX64ParamRegCode(rhsParam))
        DirectObjectEmitX64WriteRet(out)
        return
    if opKind == int32(texpr.TypedExprIrOpI32Asr):
        DirectObjectEmitX64WriteMovEcxParam(out, rhsParam)
        obuf.ObjectBufferWriteU8(out, int32(0xd3))
        obuf.ObjectBufferWriteU8(out, int32(0xf8))
        DirectObjectEmitX64WriteRet(out)
        return
    DirectObjectEmitX64WriteRet(out)

fn DirectObjectEmitX64WriteCallThenReturnI32Const(out: var obuf.ObjectBuffer,
                                                  value: int32) =
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xec))
    obuf.ObjectBufferWriteU8(out, int32(0x08))
    DirectObjectEmitX64WriteCallPlaceholder(out)
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xc4))
    obuf.ObjectBufferWriteU8(out, int32(0x08))
    if value == 0:
        DirectObjectEmitX64WriteReturnZero(out)
    else:
        DirectObjectEmitX64WriteReturnI32Const(out, value)

fn DirectObjectEmitX64WriteCStringCallReturnResult(out: var obuf.ObjectBuffer,
                                                   targetTriple: str) =
    # lea <argreg>, [rip+disp32] ; literal REL32 reloc at +3
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x8d))
    if targetTriple == "x86_64-pc-windows-msvc":
        obuf.ObjectBufferWriteU8(out, int32(0x0d))
    else:
        obuf.ObjectBufferWriteU8(out, int32(0x3d))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    # sub rsp, 0x28 (win64 shadow space + 16-byte call alignment)
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xec))
    obuf.ObjectBufferWriteU8(out, int32(0x28))
    # call rel32 ; callee REL32 reloc at +12
    DirectObjectEmitX64WriteCallPlaceholder(out)
    # add rsp, 0x28
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xc4))
    obuf.ObjectBufferWriteU8(out, int32(0x28))
    DirectObjectEmitX64WriteRet(out)

fn DirectObjectEmitX64WriteCallLtZeroSelectReturn(out: var obuf.ObjectBuffer,
                                                  ltValue: int32,
                                                  geValue: int32) =
    # sub rsp, 0x28
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xec))
    obuf.ObjectBufferWriteU8(out, int32(0x28))
    # call rel32 ; callee REL32 reloc at +5
    DirectObjectEmitX64WriteCallPlaceholder(out)
    # add rsp, 0x28
    obuf.ObjectBufferWriteU8(out, int32(0x48))
    obuf.ObjectBufferWriteU8(out, int32(0x83))
    obuf.ObjectBufferWriteU8(out, int32(0xc4))
    obuf.ObjectBufferWriteU8(out, int32(0x28))
    # test eax, eax
    obuf.ObjectBufferWriteU8(out, int32(0x85))
    obuf.ObjectBufferWriteU8(out, int32(0xc0))
    # jns +6 (skip "mov eax, ltValue; ret")
    obuf.ObjectBufferWriteU8(out, int32(0x79))
    obuf.ObjectBufferWriteU8(out, int32(0x06))
    # mov eax, ltValue
    obuf.ObjectBufferWriteU8(out, int32(0xb8))
    obuf.ObjectBufferWriteU32LE(out, uint64(ltValue))
    DirectObjectEmitX64WriteRet(out)
    if geValue == 0:
        DirectObjectEmitX64WriteReturnZero(out)
    else:
        DirectObjectEmitX64WriteReturnI32Const(out, geValue)

