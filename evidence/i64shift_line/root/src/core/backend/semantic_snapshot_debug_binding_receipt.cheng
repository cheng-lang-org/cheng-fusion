import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend/debug_facts as debugfacts

type
    # Immutable bridge identity produced only after a pinned semantic snapshot
    # has been bound to the exact TypedExpr/DebugFact lowering owner.
    SemanticSnapshotDebugBindingReceipt =
        sourceVersion: int64
        snapshotIndex: int32
        payloadIndex: int32
        predecessorReceiptCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        declarationIdentityCid: layout.FixedBytes32
        compilerFactProjectionCid: layout.FixedBytes32
        debugFactProjectionCid: layout.FixedBytes32
        loweringBridgeRootCid: layout.FixedBytes32
        typedFunctionCount: int32
        typedNodeCount: int32
        receiptCid: layout.FixedBytes32

    SemanticSnapshotDebugObjectIdentity =
        sourceVersion: int64
        packageId: str
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        debugProjectionCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        declarationIdentityCid: layout.FixedBytes32

fn semanticSnapshotDebugBindingAppendI32(
        buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn semanticSnapshotDebugBindingAppendI64(
        buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn semanticSnapshotDebugBindingAppendText(
        buf: var layout.ByteBuf, value: str) =
    semanticSnapshotDebugBindingAppendI32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn SemanticSnapshotDebugBindingReceiptCid(
        receipt: SemanticSnapshotDebugBindingReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(640)
    semanticSnapshotDebugBindingAppendText(
        buf, "cheng.semantic_snapshot.debug_binding")
    semanticSnapshotDebugBindingAppendI64(buf, receipt.sourceVersion)
    semanticSnapshotDebugBindingAppendI32(buf, receipt.snapshotIndex)
    semanticSnapshotDebugBindingAppendI32(buf, receipt.payloadIndex)
    layout.ByteBufAppendFixed32(buf, receipt.predecessorReceiptCid)
    layout.ByteBufAppendFixed32(buf, receipt.bindingReceiptCid)
    layout.ByteBufAppendFixed32(buf, receipt.semanticSnapshotCid)
    layout.ByteBufAppendFixed32(buf, receipt.worldHeadCid)
    layout.ByteBufAppendFixed32(buf, receipt.compilerCid)
    layout.ByteBufAppendFixed32(buf, receipt.sourceBundleCid)
    layout.ByteBufAppendFixed32(buf, receipt.csgRootCid)
    layout.ByteBufAppendFixed32(buf, receipt.validationReceiptCid)
    layout.ByteBufAppendFixed32(buf, receipt.declarationTableCid)
    layout.ByteBufAppendFixed32(buf, receipt.declarationIdentityCid)
    layout.ByteBufAppendFixed32(buf, receipt.compilerFactProjectionCid)
    layout.ByteBufAppendFixed32(buf, receipt.debugFactProjectionCid)
    layout.ByteBufAppendFixed32(buf, receipt.loweringBridgeRootCid)
    semanticSnapshotDebugBindingAppendI32(
        buf, receipt.typedFunctionCount)
    semanticSnapshotDebugBindingAppendI32(buf, receipt.typedNodeCount)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotDebugBindingCidObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn SemanticSnapshotDebugBindingReceiptValidateFactsInto(
        receipt: SemanticSnapshotDebugBindingReceipt,
        facts: debugfacts.DebugFactBundle,
        err: var str): bool =
    err = ""
    if !debugfacts.DebugFactBundleStrictValidateInto(facts, err):
        return false
    if receipt.sourceVersion <= 0 || receipt.snapshotIndex < 0 ||
       receipt.payloadIndex < 0 || receipt.typedFunctionCount < 0 ||
       receipt.typedNodeCount < 0 ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.predecessorReceiptCid) ||
       !semanticSnapshotDebugBindingCidObserved(receipt.bindingReceiptCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.semanticSnapshotCid) ||
       !semanticSnapshotDebugBindingCidObserved(receipt.worldHeadCid) ||
       !semanticSnapshotDebugBindingCidObserved(receipt.compilerCid) ||
       !semanticSnapshotDebugBindingCidObserved(receipt.sourceBundleCid) ||
       !semanticSnapshotDebugBindingCidObserved(receipt.csgRootCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.validationReceiptCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.declarationTableCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.declarationIdentityCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.compilerFactProjectionCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.debugFactProjectionCid) ||
       !semanticSnapshotDebugBindingCidObserved(
           receipt.loweringBridgeRootCid) ||
       !semanticSnapshotDebugBindingCidObserved(receipt.receiptCid):
        err = " semantic snapshot debug binding receipt: invalid shape"
        return false
    if receipt.sourceVersion != facts.sourceVersion ||
       receipt.typedFunctionCount != facts.functionCount ||
       receipt.typedNodeCount != facts.typedNodeCount ||
       !layout.FixedBytes32Equal(receipt.predecessorReceiptCid,
                                 facts.predecessorReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.bindingReceiptCid,
                                 facts.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.semanticSnapshotCid,
                                 facts.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(receipt.worldHeadCid,
                                 facts.worldHeadCid) ||
       !layout.FixedBytes32Equal(receipt.compilerCid,
                                 facts.compilerCid) ||
       !layout.FixedBytes32Equal(receipt.sourceBundleCid,
                                 facts.sourceBundleCid) ||
       !layout.FixedBytes32Equal(receipt.csgRootCid, facts.csgRootCid) ||
       !layout.FixedBytes32Equal(receipt.validationReceiptCid,
                                 facts.validationReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.declarationTableCid,
                                 facts.declarationTableCid) ||
       !layout.FixedBytes32Equal(receipt.declarationIdentityCid,
                                 facts.declarationIdentityCid) ||
       !layout.FixedBytes32Equal(receipt.debugFactProjectionCid,
                                 facts.projectionCid) ||
       !layout.FixedBytes32Equal(
           receipt.receiptCid,
           SemanticSnapshotDebugBindingReceiptCid(receipt)):
        err = " semantic snapshot debug binding receipt: facts mismatch"
        return false
    return true

@borrows
fn SemanticSnapshotDebugBindingReceiptValidateObjectIdentityInto(
        receipt: SemanticSnapshotDebugBindingReceipt,
        facts: debugfacts.DebugFactBundle,
        objectIdentity: SemanticSnapshotDebugObjectIdentity,
        err: var str): bool =
    if !SemanticSnapshotDebugBindingReceiptValidateFactsInto(
           receipt, facts, err):
        return false
    if objectIdentity.sourceVersion != receipt.sourceVersion ||
       objectIdentity.packageId != facts.packageId ||
       !layout.FixedBytes32Equal(
           objectIdentity.bindingReceiptCid,
           receipt.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.semanticSnapshotCid,
           receipt.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.worldHeadCid, receipt.worldHeadCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.compilerCid, receipt.compilerCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.sourceBundleCid, receipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.csgRootCid, receipt.csgRootCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.validationReceiptCid,
           receipt.validationReceiptCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.debugProjectionCid,
           receipt.debugFactProjectionCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.declarationTableCid,
           receipt.declarationTableCid) ||
       !layout.FixedBytes32Equal(
           objectIdentity.declarationIdentityCid,
           receipt.declarationIdentityCid):
        err = " semantic snapshot debug binding receipt: object snapshot mismatch"
        return false
    err = ""
    return true

@borrows
fn SemanticSnapshotDebugBindingReceiptEqual(
        left: SemanticSnapshotDebugBindingReceipt,
        right: SemanticSnapshotDebugBindingReceipt): bool =
    return left.sourceVersion == right.sourceVersion &&
           left.snapshotIndex == right.snapshotIndex &&
           left.payloadIndex == right.payloadIndex &&
           left.typedFunctionCount == right.typedFunctionCount &&
           left.typedNodeCount == right.typedNodeCount &&
           layout.FixedBytes32Equal(left.predecessorReceiptCid,
                                    right.predecessorReceiptCid) &&
           layout.FixedBytes32Equal(left.bindingReceiptCid,
                                    right.bindingReceiptCid) &&
           layout.FixedBytes32Equal(left.semanticSnapshotCid,
                                    right.semanticSnapshotCid) &&
           layout.FixedBytes32Equal(left.worldHeadCid,
                                    right.worldHeadCid) &&
           layout.FixedBytes32Equal(left.compilerCid,
                                    right.compilerCid) &&
           layout.FixedBytes32Equal(left.sourceBundleCid,
                                    right.sourceBundleCid) &&
           layout.FixedBytes32Equal(left.csgRootCid,
                                    right.csgRootCid) &&
           layout.FixedBytes32Equal(left.validationReceiptCid,
                                    right.validationReceiptCid) &&
           layout.FixedBytes32Equal(left.declarationTableCid,
                                    right.declarationTableCid) &&
           layout.FixedBytes32Equal(left.declarationIdentityCid,
                                    right.declarationIdentityCid) &&
           layout.FixedBytes32Equal(left.compilerFactProjectionCid,
                                    right.compilerFactProjectionCid) &&
           layout.FixedBytes32Equal(left.debugFactProjectionCid,
                                    right.debugFactProjectionCid) &&
           layout.FixedBytes32Equal(left.loweringBridgeRootCid,
                                    right.loweringBridgeRootCid) &&
           layout.FixedBytes32Equal(left.receiptCid, right.receiptCid)
