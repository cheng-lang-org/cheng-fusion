import std/bytes
import std/fs
import std/hashmaps
import std/os
import std/rawbytes
import std/rawmem_support
import std/result
import std/strformat
import std/strings
import std/times
import std/crypto/sha256
import std/thread
import cheng/core/backend/linker_shared_core
import cheng/core/runtime/macho_stat_provider

const
    MachoMagic64: uint32 = 0xfeedfacf
    MachoCpuTypeA64: uint32 = 0x0100000c
    MachoFileTypeObject: uint32 = 1
    MachoFileTypeExecute: uint32 = 2
    MachoLoadSegment64: uint32 = 0x19
    MachoLoadSymtab: uint32 = 0x2
    MachoLoadDysymtab: uint32 = 0xb
    MachoLoadDyldInfo: uint32 = 0x80000022
    MachoLoadDylinker: uint32 = 0x0e
    MachoLoadDylib: uint32 = 0x0c
    MachoLoadUuid: uint32 = 0x1b
    MachoLoadBuildVersion: uint32 = 0x32
    MachoLoadFunctionStarts: uint32 = 0x26
    MachoLoadDataInCode: uint32 = 0x29
    MachoLoadNote: uint32 = 0x31
    MachoLoadCodeSignature: uint32 = 0x1d
    MachoLoadMain: uint32 = 0x80000028
    MachoNTypeUndef: int32 = 0
    MachoNTypeExt: int32 = 1
    MachoNTypeSect: int32 = 14
    MachoNStabMask: int32 = 224
    MachoRelocBranch26: int32 = 2
    MachoRelocPage21: int32 = 3
    MachoRelocPageOff12: int32 = 4
    MachoExecPageSize: int32 = 16384
    MachoCodeSignaturePageSize: int32 = 4096
    MachoCodeSignaturePageSizeLog2: int32 = 12
    MachoCodeSignatureHashSize: int32 = 32
    MachoTextBase: uint64 = uint64(0x100000000)
    MachoCodeOff: int32 = 4096
    MachoProviderCommitmentSize: int32 = 120
    # [l1] v4: evidence/proof digests no longer cover filesystem path
    # text; identity = input content + layout (see evidence digest).
    MachoProviderCommitmentVersion: uint32 = 4
    MachoProviderCommitmentSha256: uint32 = 1
    MachoProviderCommitmentContentSetOffset: int32 = 24
    MachoProviderCommitmentEvidenceOffset: int32 = 56
    MachoProviderCommitmentProofOffset: int32 = 88
    MachoProviderNoteOwner: str = "cheng.provider"
    MachoProviderBindingSchema: str = "cheng.provider.binding"
    MachoProviderBindingStorage: str = "LC_NOTE:cheng.provider"
    MachoProviderEvidenceSchema: str = "cheng.provider.evidence"
    MachoProviderProgramInventorySchema: str = "cheng.provider.program-inventory"
    MachoProviderProofSchema: str = "cheng.provider.proof"
    MachoProviderRelocationSchema: str = "cheng.provider.relocation"
    MachoProviderMaxInt64: int64 = 9223372036854775807

type
    MachoProviderSymbol = ref object
        name: str
        nType: int32
        nSect: int32
        nDesc: int32
        value: uint64

    MachoProviderReloc = ref object
        address: int32
        symbolIndex: int32
        pcrel: int32
        length: int32
        externReloc: int32
        kind: int32

    MachoProviderObject = ref object
        path: str
        data: bytes.ByteBuffer
        image: uint8[]
        imageFileOffset: int32
        imageByteCount: int32
        wordCount: int32
        baseWord: int32
        dataSectAddr: uint64
        dataFileOff: int32
        dataByteCount: int32
        dataBaseWord: int32
        symbols: MachoProviderSymbol[]
        relocs: MachoProviderReloc[]

    MachoProviderLinkRequest =
        programObjectPaths: str[]
        programCanonicalPaths: str[]
        programExpectedContentSha256: str[]
        providerObjectPaths: str[]
        providerCanonicalPaths: str[]
        providerExpectedContentSha256: str[]
        outputPath: str
        targetTriple: str

    MachoProviderEvidence =
        providerIndex: int32
        inputCanonicalPath: str
        inputContentSha256: str
        inputSize: int64
        definedRoots: str[]
        relocationResolvedRoots: str[]
        textFileOffset: int64
        textSize: int64
        textPostRelocationSha256: str
        dataFileOffset: int64
        dataSize: int64
        dataPostRelocationSha256: str

    MachoProviderProgramInputEvidence =
        programIndex: int32
        inputCanonicalPath: str
        inputContentSha256: str
        inputSize: int64

    MachoProviderRelocationEvidence =
        relocationIndex: int32
        originObjectKind: str
        originObjectIndex: int32
        originCanonicalPath: str
        originContentSha256: str
        originSectionIdentity: str
        relocationOrdinal: int32
        relocationType: int32
        relocationAddress: int64
        relocationPcrel: int32
        relocationLength: int32
        relocationExtern: int32
        targetRootKind: str
        targetObjectKind: str
        targetObjectIndex: int32
        targetDylibOrdinal: int32
        targetSymbol: str
        finalPatchFileOffset: int64
        patchedByteWidth: int64
        patchedValueContract: str
        patchedBytesHex: str
        patchedBytesSha256: str

    MachoProviderSegmentEvidence =
        segmentName: str
        fileOffset: int64
        fileSize: int64
        vmAddress: uint64
        vmSize: uint64
        postRelocationSha256: str

    MachoProviderDynamicImportEvidence =
        importIndex: int32
        dylibOrdinal: int32
        dylibPath: str
        symbol: str
        nlistIndex: int32
        nlistFileOffset: int64
        nlistEntrySha256: str
        bindRecordOrdinal: int32
        bindRecordFileOffset: int64
        bindRecordSize: int64
        bindRecordSha256: str
        stubFileOffset: int64
        stubSize: int64
        stubPostRelocationSha256: str
        gotFileOffset: int64
        gotSize: int64
        gotValueContract: str
        gotInitialSha256: str

    MachoProviderLinkReceipt =
        outputPath: str
        outputCanonicalPath: str
        outputFileSha256: str
        outputFileDevice: str
        outputFileInode: str
        outputFileSize: str
        outputFileMtimeSec: str
        outputFileMtimeNsec: str
        outputFileCtimeSec: str
        outputFileCtimeNsec: str
        targetTriple: str
        programObjectCount: int32
        providerObjectCount: int32
        providerObjectContentSha256: str
        providerEvidenceSchema: str
        providerEvidenceSha256: str
        providerEvidence: MachoProviderEvidence[]
        programInputSchema: str
        programInputs: MachoProviderProgramInputEvidence[]
        providerProofSchema: str
        providerProofSha256: str
        providerRelocationSchema: str
        providerRelocations: MachoProviderRelocationEvidence[]
        textSegmentEvidence: MachoProviderSegmentEvidence
        dataSegmentEvidence: MachoProviderSegmentEvidence
        dynamicImports: MachoProviderDynamicImportEvidence[]
        staticUnresolvedCount: int32
        providerObjectBindingSchema: str
        providerObjectBindingStorage: str
        providerObjectBindingSigned: bool
        providerObjectBindingMatchesReadBytes: bool
        providerObjectBindingVerified: bool
        providerCommitmentFileOffset: int32
        providerCommitmentByteCount: int32
        codeDirectoryCodeLimit: int32

    MachoProviderFileSnapshot =
        canonicalPath: str
        device: str
        inode: str
        size: str
        mtimeSec: str
        mtimeNsec: str
        ctimeSec: str
        ctimeNsec: str

    MachoProviderResolvedTarget =
        rootKind: str
        objectGlobalIndex: int32 = -1
        dylibOrdinal: int32
        symbol: str
        byteOffset: int32

fn machoTraceEnabled(): bool =
    return os.GetEnv("CHENG_MACHO_PROVIDER_LINK_TRACE") == "1"

@borrows
fn machoTrace(stage: str) =
    if machoTraceEnabled():
        os.WriteLine(os.Get_stderr(), Fmt"macho_provider_linker_trace {stage}")

@borrows
fn machoTraceMs(stage: str, startNs: int64) =
    if machoTraceEnabled():
        let elapsed = (times.MonotimeNs() - startNs) / int64(1000000)
        os.WriteLine(os.Get_stderr(), Fmt"macho_provider_linker_trace {stage}_ms={strings.Int64ToStr(elapsed)}")

fn machoParallelLinkEnabled(): bool =
    return os.GetEnv("CHENG_NATIVE_LINK_PARALLEL") == "1"

fn machoParallelWorkerCount(): int32 =
    let n = thread.Parallelism()
    if n <= 1:
        return 1
    return n

@borrows
fn machoProviderLoadUnsignedLe(raw: rawbytes.Bytes,
                               offset: int32,
                               width: int32): uint64 =
    var out: uint64
    for i in 0..<width:
        out = out | (uint64(rawbytes.BytesGet(raw, offset + i) & 255) << uint64(i * 8))
    return out

@borrows
fn machoProviderSha256TextValid(value: str): bool =
    if len(value) != MachoCodeSignatureHashSize * 2:
        return false
    for i in 0..<len(value):
        let c = value[i]
        if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')):
            return false
    return true

@borrows
fn machoProviderFileSnapshotStat(path: str,
                                 out: var MachoProviderFileSnapshot): bool =
    let canonicalRes = fs.Realpath(path)
    if !canonicalRes.ok:
        return false
    out.canonicalPath = canonicalRes.value
    var statBytes = rawbytes.BytesAlloc(144)
    if rawbytes.BytesLen(statBytes) != 144:
        rawbytes.BytesFree(statBytes)
        return false
    let rc = MachoStatProviderInto(out.canonicalPath, statBytes)
    if rc != 0:
        rawbytes.BytesFree(statBytes)
        return false
    let mode = machoProviderLoadUnsignedLe(statBytes, 4, 2)
    if (mode & uint64(61440)) != uint64(32768):
        rawbytes.BytesFree(statBytes)
        return false
    out.device = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 0, 4))
    out.inode = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 8, 8))
    out.mtimeSec = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 48, 8))
    out.mtimeNsec = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 56, 8))
    out.ctimeSec = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 64, 8))
    out.ctimeNsec = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 72, 8))
    out.size = strings.Uint64ToStr(machoProviderLoadUnsignedLe(statBytes, 96, 8))
    rawbytes.BytesFree(statBytes)
    return true

@borrows
fn machoProviderFileSnapshotIdentityEqual(a: MachoProviderFileSnapshot,
                                          b: MachoProviderFileSnapshot): bool =
    return a.canonicalPath == b.canonicalPath &&
           a.device == b.device &&
           a.inode == b.inode &&
           a.size == b.size &&
           a.mtimeSec == b.mtimeSec &&
           a.mtimeNsec == b.mtimeNsec &&
           a.ctimeSec == b.ctimeSec &&
           a.ctimeNsec == b.ctimeNsec

@borrows
fn machoProviderHashByteBuffer(buf: bytes.ByteBuffer): str =
    if buf.data == nil || buf.len < 0:
        return ""
    let view = rawbytes.BytesView(buf.data, buf.len)
    var digest = sha256.Sha256Digest(view)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return ""
    let out = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return out

@borrows
fn machoProviderRemoveOutput(path: str): bool =
    if len(path) <= 0:
        return false
    if os.FileExists(path) && !os.RemoveFile(path):
        return false
    return !os.FileExists(path)

fn machoBufU8(out: var uint8[], value: uint8) =
    let idx = out.len
    setLen(out, idx + 1)
    out[idx] = value

fn machoBufU32(out: var uint8[], value: uint32) =
    let idx = out.len
    setLen(out, idx + 4)
    for i in 0..<4:
        out[idx + i] = uint8((value >> uint32(i * 8)) & uint32(0xff))

@borrows
fn machoBufStr0(out: var uint8[], text: str) =
    for i in 0..<len(text):
        machoBufU8(out, uint8(int32(text[i]) & 255))
    machoBufU8(out, uint8(0))

fn machoBufUleb(out: var uint8[], value0: uint64) =
    var value = value0
    while true:
        var b = uint8(value & uint64(0x7f))
        value = value >> 7
        if value != uint64(0):
            b = b | uint8(0x80)
        machoBufU8(out, b)
        if value == uint64(0):
            break

fn machoAlignI32(value: int32, align: int32): int32 =
    if align <= 1:
        return value
    let rem = value % align
    if rem == 0:
        return value
    return value + (align - rem)

fn machoProviderCheckedI32Add(a: int32,
                              b: int32,
                              out: var int32): bool =
    if a < 0 || b < 0 || b > 2147483647 - a:
        return false
    out = a + b
    return true

fn machoProviderCheckedI32Mul(a: int32,
                              b: int32,
                              out: var int32): bool =
    if a < 0 || b < 0:
        return false
    if a != 0 && b > 2147483647 / a:
        return false
    out = a * b
    return true

fn machoProviderCheckedI32Align(value: int32,
                                align: int32,
                                out: var int32): bool =
    if value < 0 || align <= 0:
        return false
    let rem = value % align
    if rem == 0:
        out = value
        return true
    return machoProviderCheckedI32Add(value, align - rem, out)

fn machoTextBase(): uint64 =
    return uint64(1) << 32

@borrows
fn machoU32(buf: bytes.ByteBuffer, off: int32): uint32 =
    let b0 = uint32(bytes.BufByteAt(buf, off) & 255)
    let b1 = uint32(bytes.BufByteAt(buf, off + 1) & 255)
    let b2 = uint32(bytes.BufByteAt(buf, off + 2) & 255)
    let b3 = uint32(bytes.BufByteAt(buf, off + 3) & 255)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

@borrows
fn machoU16(buf: bytes.ByteBuffer, off: int32): int32 =
    let b0 = bytes.BufByteAt(buf, off) & 255
    let b1 = bytes.BufByteAt(buf, off + 1) & 255
    return b0 | (b1 << 8)

@borrows
fn machoReadI32LE(buf: bytes.ByteBuffer, off: int32): int32 =
    return int32(machoU32(buf, off))

@borrows
fn machoU64(buf: bytes.ByteBuffer, off: int32): uint64 =
    let lo = uint64(machoU32(buf, off))
    let hi = uint64(machoU32(buf, off + 4))
    return lo | (hi << 32)

@borrows
fn machoMagic64Matches(buf: bytes.ByteBuffer): bool =
    var ok = true
    if bytes.BufByteAt(buf, 0) != 207:
        ok = false
    if bytes.BufByteAt(buf, 1) != 250:
        ok = false
    if bytes.BufByteAt(buf, 2) != 237:
        ok = false
    if bytes.BufByteAt(buf, 3) != 254:
        ok = false
    return ok

@borrows
fn machoReadBytes(buf: bytes.ByteBuffer, off: uint64, size: uint64): uint8[] =
    var out: uint8[]
    if off > uint64(buf.len) || size > uint64(buf.len) - off:
        return out
    for i in 0..<size:
        machoBufU8(out, uint8(bytes.BufByteAt(buf, int32(off + i)) & 255))
    return out

@borrows
fn machoByteBufLen(buf: bytes.ByteBuffer): int32 =
    return buf.len

@borrows
fn machoStrArrayLen(arr: str[]): int32 =
    return arr.len

@borrows
fn machoUint8ArrayLen(arr: uint8[]): int32 =
    return arr.len

@borrows
fn machoReadCString(buf: bytes.ByteBuffer, off: uint64, maxSize: uint64): str =
    if maxSize == uint64(0) || off >= uint64(machoByteBufLen(buf)):
        return ""
    var n: uint64
    for i in 0..<maxSize:
        if off + i >= uint64(machoByteBufLen(buf)):
            n = i
            break
        if bytes.BufByteAt(buf, int32(off + i)) == 0:
            n = i
            break
    if n == uint64(0):
        return ""
    var raw: uint8[]
    setLen(raw, int(n + uint64(1)))
    for i in 0..<n:
        raw[int(i)] = uint8(bytes.BufByteAt(buf, int32(off + i)) & 255)
    return __cheng_str_from_bytes(raw, raw.len - 1)

@borrows
fn machoReadFixedAscii(buf: bytes.ByteBuffer, off: uint64, width: int32): str =
    var n: int32
    for i in 0..<width:
        if off + uint64(i) >= uint64(buf.len):
            n = i
            break
        if bytes.BufByteAt(buf, int32(off + uint64(i))) == 0:
            n = i
            break
    if n <= 0:
        return ""
    return machoReadCString(buf, off, uint64(n + 1))

fn machoPutU32At(out: var uint8[], off: int32, value: uint32) =
    for i in 0..<4:
        out[off + i] = uint8((value >> uint32(i * 8)) & uint32(0xff))

fn machoPutU64At(out: var uint8[], off: int32, value: uint64) =
    for i in 0..<8:
        out[off + i] = uint8((value >> uint64(i * 8)) & uint64(0xff))

@borrows
fn machoCopyAt(out: var uint8[], off: int32, data: uint8[]) =
    for i in 0..<data.len:
        out[off + i] = data[i]

@borrows
fn machoCopyStringAt(out: var uint8[], off: int32, text: str) =
    for i in 0..<len(text):
        out[off + i] = uint8(int32(text[i]) & 255)

@borrows
fn machoPaddedAsciiAt(out: var uint8[], off: int32, text: str, width: int32) =
    for i in 0..<width:
        if i < len(text):
            out[off + i] = uint8(int32(text[i]) & 255)
        else:
            out[off + i] = uint8(0)

fn machoReadObjectError(out: MachoProviderObject,
                        message: str): Result[MachoProviderObject] =
    if out != nil:
        var data = out.data
        out.data = bytes.NewByteBuffer(0)
        bytes.FreeByteBuffer(data)
    return Err[MachoProviderObject](message)

@borrows
fn machoReadObject(path: str): Result[MachoProviderObject] =
    machoTrace(Fmt"read_object_begin path={path}")
    var out = new(MachoProviderObject)
    out.path = share(path)
    out.data = bytes.ReadFileBytes(path)
    if out.data.data == nil || out.data.len < 32:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: failed to read object: {path}")
    let gotMagic = machoU32(out.data, 0)
    let gotMagicByte0 = bytes.BufByteAt(out.data, 0)
    let gotMagicByte1 = bytes.BufByteAt(out.data, 1)
    let gotMagicByte2 = bytes.BufByteAt(out.data, 2)
    let gotMagicByte3 = bytes.BufByteAt(out.data, 3)
    let gotCpuType = machoReadI32LE(out.data, 4)
    let gotFileType = machoReadI32LE(out.data, 12)
    var headerOk = true
    if !machoMagic64Matches(out.data):
        headerOk = false
    if gotCpuType != 16777228:
        headerOk = false
    if gotFileType != 1:
        headerOk = false
    if !headerOk:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: expected arm64 Mach-O object: {path} got_magic={gotMagic} got_magic_bytes={gotMagicByte0},{gotMagicByte1},{gotMagicByte2},{gotMagicByte3} got_cputype={gotCpuType} got_filetype={gotFileType}")
    let ncmds = int32(machoU32(out.data, 16))
    let sizeofcmds = int32(machoU32(out.data, 20))
    if ncmds <= 0 || sizeofcmds <= 0 || sizeofcmds > out.data.len - 32:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: invalid load commands: {path}")
    var symoff: int32
    var nsyms: int32
    var stroff: int32
    var strsize: int32
    var parsedRelocs: MachoProviderReloc[]
    var parsedSymbols: MachoProviderSymbol[]
    var textSectionCount: int32
    var dataSectionCount: int32
    var symtabCount: int32
    var cmdPos: int32
    for _ in 0..<ncmds:
        let cmdOff = 32 + cmdPos
        if cmdPos < 0 || cmdPos > sizeofcmds ||
           sizeofcmds - cmdPos < 8 || cmdOff > out.data.len - 8:
            return machoReadObjectError(out,
                                        Fmt"macho_provider_linker: truncated load command: {path}")
        let cmd = machoReadI32LE(out.data, cmdOff)
        let cmdsize = machoReadI32LE(out.data, cmdOff + 4)
        if cmdsize < 8 || cmdPos > sizeofcmds ||
           cmdsize > sizeofcmds - cmdPos:
            return machoReadObjectError(out,
                                        Fmt"macho_provider_linker: invalid load command size: {path}")
        if cmd == 25:
            if cmdsize < 72:
                return machoReadObjectError(out,
                                            Fmt"macho_provider_linker: invalid segment command: {path}")
            # Per-section parse: __text carries code + all relocations, __data
            # carries mutable globals routed to the RW __DATA segment. Debug
            # sections are dropped. Relocations outside __text are rejected.
            let nsects = machoReadI32LE(out.data, cmdOff + 64)
            if nsects < 0 || nsects > (cmdsize - 72) / 80 ||
               cmdsize != 72 + nsects * 80:
                return machoReadObjectError(out,
                                            Fmt"macho_provider_linker: invalid section table: {path}")
            for si in 0..<nsects:
                let secOff = cmdOff + 72 + si * 80
                if secOff > cmdOff + cmdsize - 80:
                    return machoReadObjectError(out,
                                                Fmt"macho_provider_linker: invalid section range: {path}")
                let sectName = machoReadFixedAscii(out.data, uint64(secOff), 16)
                let sectionSegmentName = machoReadFixedAscii(out.data,
                                                             uint64(secOff + 16),
                                                             16)
                let sectAddr = machoU64(out.data, secOff + 32)
                let sectSize = machoU64(out.data, secOff + 40)
                let sectFileOffRaw = machoU32(out.data, secOff + 48)
                let reloffRaw = machoU32(out.data, secOff + 56)
                let nreloc = machoReadI32LE(out.data, secOff + 60)
                if sectFileOffRaw > uint32(2147483647) ||
                   reloffRaw > uint32(2147483647):
                    return machoReadObjectError(out,
                                                Fmt"macho_provider_linker: section offset too large: {path}")
                let sectFileOff = int32(sectFileOffRaw)
                let reloff = int32(reloffRaw)
                if uint64(sectFileOff) > uint64(out.data.len) ||
                   sectSize > uint64(out.data.len) - uint64(sectFileOff):
                    return machoReadObjectError(out,
                                                Fmt"macho_provider_linker: invalid section range: {path}")
                if sectName == "__text":
                    textSectionCount = textSectionCount + 1
                    if textSectionCount != 1 ||
                       sectionSegmentName != "__TEXT" ||
                       sectAddr != uint64(0):
                        return machoReadObjectError(out,
                                                    Fmt"macho_provider_linker: invalid unique __TEXT,__text section: {path}")
                    out.imageFileOffset = sectFileOff
                    out.imageByteCount = int32(sectSize)
                    out.wordCount = int32((sectSize + uint64(3)) / uint64(4))
                    if nreloc < 0 || reloff < 0 || reloff > out.data.len ||
                       nreloc > (out.data.len - reloff) / 8:
                        return machoReadObjectError(out,
                                                    Fmt"macho_provider_linker: relocation table out of range: {path}")
                    for ri in 0..<nreloc:
                        let roff = reloff + ri * 8
                        let r = new(MachoProviderReloc)
                        r.address = int32(machoU32(out.data, roff))
                        let word = machoU32(out.data, roff + 4)
                        r.symbolIndex = int32(word & uint32(0x00ffffff))
                        r.pcrel = int32((word >> 24) & uint32(1))
                        r.length = int32((word >> 25) & uint32(3))
                        r.externReloc = int32((word >> 27) & uint32(1))
                        r.kind = int32((word >> 28) & uint32(0xf))
                        add(parsedRelocs, r)
                elif sectName == "__data":
                    dataSectionCount = dataSectionCount + 1
                    if dataSectionCount != 1 ||
                       sectionSegmentName != "__DATA" || nreloc != 0:
                        return machoReadObjectError(out,
                                                    Fmt"macho_provider_linker: invalid unique __DATA,__data section: {path}")
                    out.dataSectAddr = sectAddr
                    out.dataFileOff = sectFileOff
                    out.dataByteCount = int32(sectSize)
                else:
                    if nreloc != 0:
                        return machoReadObjectError(out,
                                                    Fmt"macho_provider_linker: relocations in unsupported section {sectName}: {path}")
        elif cmd == 2:
            if cmdsize != 24:
                return machoReadObjectError(out,
                                            Fmt"macho_provider_linker: invalid symbol table command: {path}")
            symtabCount = symtabCount + 1
            if symtabCount != 1:
                return machoReadObjectError(out,
                                            Fmt"macho_provider_linker: duplicate symbol table command: {path}")
            symoff = machoReadI32LE(out.data, cmdOff + 8)
            nsyms = machoReadI32LE(out.data, cmdOff + 12)
            stroff = machoReadI32LE(out.data, cmdOff + 16)
            strsize = machoReadI32LE(out.data, cmdOff + 20)
        cmdPos = cmdPos + cmdsize
    if cmdPos != sizeofcmds:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: load command size mismatch: {path}")
    if textSectionCount != 1 || out.wordCount <= 0 || out.imageByteCount <= 0:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: missing segment image: {path}")
    if symtabCount != 1 || symoff <= 0 || nsyms <= 0 ||
       stroff <= 0 || strsize <= 0:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: missing symbol table: {path}")
    if symoff < 0 || nsyms < 0 || stroff < 0 || strsize < 0 ||
       symoff > out.data.len || nsyms > (out.data.len - symoff) / 16 ||
       stroff > out.data.len || strsize > out.data.len - stroff:
        return machoReadObjectError(out,
                                    Fmt"macho_provider_linker: symbol/string table out of range: {path}")
    for i in 0..<nsyms:
        let off = symoff + i * 16
        let s = new(MachoProviderSymbol)
        let strx = machoU32(out.data, off)
        if strx >= uint32(strsize):
            return machoReadObjectError(out,
                                        Fmt"macho_provider_linker: symbol string index out of range: {path}")
        s.name = machoReadCString(out.data, uint64(stroff) + uint64(strx), uint64(strsize) - uint64(strx))
        s.nType = bytes.BufByteAt(out.data, off + 4) & 255
        s.nSect = bytes.BufByteAt(out.data, off + 5) & 255
        s.nDesc = machoU16(out.data, off + 6)
        s.value = machoU64(out.data, off + 8)
        add(parsedSymbols, s)
    out.relocs = parsedRelocs
    out.symbols = parsedSymbols
    machoTrace(Fmt"read_object_done words={out.wordCount} image_bytes={out.imageByteCount} symbols={out.symbols.len} relocs={out.relocs.len}")
    return Ok[MachoProviderObject](out)

@borrows
fn machoSymbolDefined(sym: MachoProviderSymbol): bool =
    if sym == nil:
        return false
    return (sym.nType & MachoNStabMask) == 0 &&
           (sym.nType & MachoNTypeSect) == MachoNTypeSect &&
           sym.nSect != 0

@borrows
fn machoStripLeadingUnderscore(name: str): str =
    if len(name) > 1 && name[0] == '_':
        var out: uint8[]
        setLen(out, int(len(name)))
        for i in 1..<len(name):
            out[int(i - 1)] = uint8(int32(name[i]) & 255)
        return __cheng_str_from_bytes(out, len(name) - 1)
    return strings.CloneStr(name)

@borrows
fn machoNameMatches(candidate: str, wanted: str): bool =
    if candidate == wanted:
        return true
    if len(wanted) > 0 && wanted[0] != '_':
        return candidate == Fmt"_{wanted}"
    return false

@borrows
fn machoSymbolLinkedByteOff(obj: MachoProviderObject, sym: MachoProviderSymbol, outByteOff: var int32): bool =
    if obj.dataByteCount > 0 && sym.value >= obj.dataSectAddr &&
       sym.value < obj.dataSectAddr + uint64(obj.dataByteCount):
        outByteOff = obj.dataBaseWord * 4 + int32(sym.value - obj.dataSectAddr)
        return true
    if sym.value % uint64(4) != uint64(0):
        return false
    if sym.value / uint64(4) < uint64(obj.wordCount):
        outByteOff = obj.baseWord * 4 + int32(sym.value)
        return true
    return false

@borrows
fn machoFindDefinedByteOff(obj: MachoProviderObject, name: str, outByteOff: var int32): bool =
    for i in 0..<obj.symbols.len:
        let sym = obj.symbols[i]
        if !machoSymbolDefined(sym):
            continue
        if !machoNameMatches(sym.name, name):
            continue
        return machoSymbolLinkedByteOff(obj, sym, outByteOff)
    return false

@borrows
fn machoFindLinkedDefinedByteOff(objs: MachoProviderObject[], name: str, outByteOff: var int32): bool =
    return machoCountLinkedDefinedByteOff(objs, name, -1, outByteOff) == 1

@borrows
fn machoCountLinkedDefinedByteOff(objs: MachoProviderObject[], name: str, excludeObjectIndex: int32, outByteOff: var int32): int32 =
    var found = 0
    var byteOff: int32
    for i in 0..<objs.len:
        if i == excludeObjectIndex:
            continue
        var local: int32
        if machoFindDefinedByteOff(objs[i], name, local):
            byteOff = local
            found = found + 1
    if found == 1:
        outByteOff = byteOff
    return found

@borrows
fn machoDarwinImportDylibOrdinal(raw: str): int32 =
    let name = machoStripLeadingUnderscore(raw)
    if name == "objc_autoreleasePoolPop" ||
       name == "objc_autoreleasePoolPush" ||
       name == "objc_getClass" ||
       name == "objc_msgSend" ||
       name == "sel_registerName":
        return 2
    if name == "MTLCreateSystemDefaultDevice":
        return 3
    if name == "CFRelease":
        return 4
    if name == "CMBlockBufferCreateWithMemoryBlock" ||
       name == "CMSampleBufferCreateReady" ||
       name == "CMVideoFormatDescriptionCreateFromH264ParameterSets":
        return 5
    if name == "CVBufferRetain" ||
       name == "CVMetalTextureCacheCreate" ||
       name == "CVMetalTextureCacheCreateTextureFromImage" ||
       name == "CVMetalTextureGetTexture" ||
       name == "CVPixelBufferGetHeight" ||
       name == "CVPixelBufferGetPixelFormatType" ||
       name == "CVPixelBufferGetWidth":
        return 6
    if name == "VTDecompressionSessionCreate" ||
       name == "VTDecompressionSessionDecodeFrame" ||
       name == "VTDecompressionSessionFinishDelayedFrames" ||
       name == "VTDecompressionSessionInvalidate" ||
       name == "VTDecompressionSessionWaitForAsynchronousFrames" ||
       name == "VTIsHardwareDecodeSupported":
        return 7
    if name == "AudioConverterNew" ||
       name == "AudioConverterFillComplexBuffer" ||
       name == "AudioConverterDispose":
        return 8
    let symbols = [
        "CC_SHA1", "CC_SHA256", "OSAtomicAdd32Barrier", "OSAtomicCompareAndSwap32Barrier",
        "_dyld_get_image_vmaddr_slide", "_exit", "__error", "__fcntl", "__ioctl", "__ulock_wait", "__ulock_wake",
        "access", "accept", "arc4random_buf", "bind", "calloc", "chdir", "chmod", "clock_gettime", "close",
        "closedir", "connect", "creat", "dispatch_release", "dispatch_semaphore_create",
        "dispatch_semaphore_signal", "dispatch_semaphore_wait", "dlclose", "dlopen", "dlsym",
        "dup2", "execvp", "exit", "fcntl", "fdopen",
        "fclose", "fchmod", "fflush", "fgetc", "ferror", "fgets", "flock", "fopen", "fork", "fread",
        "forkpty", "free", "fseek", "fseeko", "fstat", "fstatat", "fsync", "ftell", "ftello", "fwrite", "getchar", "getcwd", "getentropy",
        "geteuid", "getenv", "gethostbyname2", "getpagesize", "getpeername", "getpgid", "getpid", "getpwuid_r", "getrusage",
        "getsockname", "getsockopt", "gettimeofday", "grantpt", "inet_ntop", "inet_pton",
        "ioctl", "isatty", "kill", "listen", "lseek", "lstat", "malloc", "memcmp", "memcpy", "memset", "mkdir", "mkdirat", "mkstemp", "mmap", "munmap", "open",
        "opendir", "os_unfair_lock_assert_not_owner", "os_unfair_lock_assert_owner",
        "os_unfair_lock_lock", "os_unfair_lock_unlock", "pclose", "pipe", "poll", "popen", "posix_openpt", "pread", "proc_listpids",
        "proc_pidfdinfo", "proc_pid_rusage", "proc_pidinfo", "pthread_attr_destroy", "pthread_attr_init", "pthread_attr_setstacksize", "pthread_create", "pthread_detach", "pthread_getspecific", "pthread_join", "pthread_key_create", "pthread_self", "pthread_setspecific", "ptsname",
        "puts",
        "read", "readdir", "readlink", "realloc", "realpath", "recv", "recvfrom", "recvmsg", "remove", "rename",
        "rewinddir", "rmdir", "sched_yield", "send", "sendmsg", "sendto", "setenv",
        "setpgid", "setsid", "setsockopt", "shutdown", "sigaction", "signal", "socket", "socketpair", "stat",
        "statfs", "strcmp", "strerror", "strlen", "sysconf", "sysctlbyname", "system", "time", "truncate", "uname", "unlink", "unlinkat", "unlockpt",
        "usleep", "waitpid", "write"
    ]
    for i in 0..<symbols.len:
        if name == symbols[i]:
            return 1
    return 0

@borrows
fn machoDarwinImportAllowed(raw: str): bool =
    return machoDarwinImportDylibOrdinal(raw) > 0

@borrows
fn machoImportIndex(imports: str[], name: str): int32 =
    for i in 0..<imports.len:
        if imports[i] == name:
            return i
    return -1

@borrows
fn machoAddImport(imports: var str[], name: str): int32 =
    let existing = machoImportIndex(imports, name)
    if existing >= 0:
        return existing
    add(imports, share(name))
    return imports.len - 1

@borrows
fn machoReadU32Image(image: uint8[], byteOff: int32): uint32 =
    let b0 = uint32(image[byteOff])
    let b1 = uint32(image[byteOff + 1])
    let b2 = uint32(image[byteOff + 2])
    let b3 = uint32(image[byteOff + 3])
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn machoPatchU32Image(image: var uint8[], byteOff: int32, value: uint32) =
    for i in 0..<4:
        image[byteOff + i] = uint8((value >> uint32(i * 8)) & uint32(0xff))

fn machoApplyReloc(image: var uint8[], addressSpaceBytes: int32, wordPos: int32, targetByteOff: int32, kind: int32, codeVmaddr: uint64): Result[bool] =
    let byteOff = wordPos * 4
    if byteOff < 0 || byteOff + 4 > image.len || targetByteOff < 0 || targetByteOff >= addressSpaceBytes:
        return Err[bool]("macho_provider_linker: relocation target out of range")
    let insn = machoReadU32Image(image, byteOff)
    if kind == MachoRelocBranch26:
        let branchOp = insn & uint32(0xfc000000)
        if branchOp != uint32(0x14000000) && branchOp != uint32(0x94000000):
            return Err[bool](Fmt"macho_provider_linker: branch26 relocation does not target b/bl instruction at byte_off={byteOff}")
        if targetByteOff >= image.len:
            return Err[bool]("macho_provider_linker: branch26 target is not executable text")
        let deltaBytes = targetByteOff - byteOff
        if deltaBytes % 4 != 0:
            return Err[bool]("macho_provider_linker: branch26 target not instruction aligned")
        let delta = deltaBytes / 4
        if delta < -(1 << 25) || delta >= (1 << 25):
            return Err[bool]("macho_provider_linker: branch26 target out of range")
        let patched = (insn & uint32(0xfc000000)) | (uint32(delta) & uint32(0x03ffffff))
        machoPatchU32Image(image, byteOff, patched)
        return Ok[bool](true)
    if kind == MachoRelocPage21:
        let srcAddr = codeVmaddr + uint64(byteOff)
        let tgtAddr = codeVmaddr + uint64(targetByteOff)
        # 页差守卫必须走 int32 比较：本驱动由种子编译器自举烤制，其 int64
        # 负界比较误发（第十墙触发形，repro: src/tests/_k_launchsprint/
        # page21_repro.cheng 实证 delta=147 被判 < -(1<<20)）。linker 全程
        # int32 字寻址（image < 2^31 字节），页号 < 2^21，int32 页算术与
        # int64 语义严格等价。
        let srcPage = int32(srcAddr >> 12)
        let tgtPage = int32(tgtAddr >> 12)
        let pageDelta = tgtPage - srcPage
        if pageDelta < -(1 << 20) || pageDelta >= (1 << 20):
            return Err[bool]("macho_provider_linker: page21 target out of range")
        let imm21 = uint32(pageDelta) & uint32(0x1fffff)
        let patched = (insn & uint32(0x9f00001f)) | ((imm21 & uint32(3)) << 29) | ((imm21 >> 2) << 5)
        machoPatchU32Image(image, byteOff, patched)
        return Ok[bool](true)
    if kind == MachoRelocPageOff12:
        let tgtAddr = codeVmaddr + uint64(targetByteOff)
        let pageOff = uint32(tgtAddr & uint64(0xfff))
        let patched = (insn & uint32(0xffc003ff)) | ((pageOff & uint32(0xfff)) << 10)
        machoPatchU32Image(image, byteOff, patched)
        return Ok[bool](true)
    return Err[bool](Fmt"macho_provider_linker: unsupported relocation kind: {kind}")

fn machoComputeRelocValue(image: uint8[], addressSpaceBytes: int32, wordPos: int32, targetByteOff: int32, kind: int32, codeVmaddr: uint64, outValue: var uint32): Result[bool] =
    let byteOff = wordPos * 4
    if byteOff < 0 || byteOff + 4 > image.len || targetByteOff < 0 || targetByteOff >= addressSpaceBytes:
        return Err[bool]("macho_provider_linker: relocation target out of range")
    let insn = machoReadU32Image(image, byteOff)
    if kind == MachoRelocBranch26:
        let branchOp = insn & uint32(0xfc000000)
        if branchOp != uint32(0x14000000) && branchOp != uint32(0x94000000):
            return Err[bool](Fmt"macho_provider_linker: branch26 relocation does not target b/bl instruction at byte_off={byteOff}")
        if targetByteOff >= image.len:
            return Err[bool]("macho_provider_linker: branch26 target is not executable text")
        let deltaBytes = targetByteOff - byteOff
        if deltaBytes % 4 != 0:
            return Err[bool]("macho_provider_linker: branch26 target not instruction aligned")
        let delta = deltaBytes / 4
        if delta < -(1 << 25) || delta >= (1 << 25):
            return Err[bool]("macho_provider_linker: branch26 target out of range")
        let patchedBranch = (insn & uint32(0xfc000000)) | (uint32(delta) & uint32(0x03ffffff))
        outValue = patchedBranch
        return Ok[bool](true)
    if kind == MachoRelocPage21:
        let srcAddr = codeVmaddr + uint64(byteOff)
        let tgtAddr = codeVmaddr + uint64(targetByteOff)
        # 同 machoApplyReloc Page21：int32 页算术绕开种子自举 int64 比较误发。
        let srcPage = int32(srcAddr >> 12)
        let tgtPage = int32(tgtAddr >> 12)
        let pageDelta = tgtPage - srcPage
        if pageDelta < -(1 << 20) || pageDelta >= (1 << 20):
            return Err[bool]("macho_provider_linker: page21 target out of range")
        let imm21 = uint32(pageDelta) & uint32(0x1fffff)
        let patchedPage = (insn & uint32(0x9f00001f)) | ((imm21 & uint32(3)) << 29) | ((imm21 >> 2) << 5)
        outValue = patchedPage
        return Ok[bool](true)
    if kind == MachoRelocPageOff12:
        let tgtAddr = codeVmaddr + uint64(targetByteOff)
        let pageOff = uint32(tgtAddr & uint64(0xfff))
        let patchedOff = (insn & uint32(0xffc003ff)) | ((pageOff & uint32(0xfff)) << 10)
        outValue = patchedOff
        return Ok[bool](true)
    return Err[bool](Fmt"macho_provider_linker: unsupported relocation kind: {kind}")

fn machoA64Adrp(reg: uint32, pc: uint64, target: uint64): uint32 =
    let pageDelta = int64(target >> 12) - int64(pc >> 12)
    let imm21 = uint32(pageDelta) & uint32(0x1fffff)
    return uint32(0x90000000) | ((imm21 & uint32(3)) << 29) | ((imm21 >> 2) << 5) | (reg & uint32(31))

fn machoA64LdrX(rt: uint32, rn: uint32, byteOff: uint32): uint32 =
    return uint32(0xf9400000) | (((byteOff >> 3) & uint32(0xfff)) << 10) | ((rn & uint32(31)) << 5) | (rt & uint32(31))

@borrows
fn machoBuildBindRecord(symbol: str,
                        dataSegmentIndex: int32,
                        gotOffset: int32): uint8[] =
    var out: uint8[]
    let ordinal = machoDarwinImportDylibOrdinal(symbol)
    if ordinal <= 0 || dataSegmentIndex < 0 || dataSegmentIndex >= 16 ||
       gotOffset < 0:
        return out
    if ordinal < 16:
        machoBufU8(out, uint8(0x10 | ordinal))
    else:
        machoBufU8(out, uint8(0x20))
        machoBufUleb(out, uint64(ordinal))
    machoBufU8(out, uint8(0x40))
    machoBufStr0(out, symbol)
    machoBufU8(out, uint8(0x50 | 1))
    machoBufU8(out, uint8(0x70 | dataSegmentIndex))
    machoBufUleb(out, uint64(gotOffset))
    machoBufU8(out, uint8(0x90))
    return out

@borrows
fn machoBuildBindInfo(imports: str[], dataSegmentIndex: int32, gotBaseOff: int32): uint8[] =
    var out: uint8[]
    for i in 0..<imports.len:
        let record = machoBuildBindRecord(imports[i],
                                          dataSegmentIndex,
                                          gotBaseOff + i * 8)
        for bi in 0..<record.len:
            machoBufU8(out, record[bi])
    machoBufU8(out, uint8(0))
    return out

@borrows
fn machoWriteSegment(out: var uint8[], pos: var int32, name: str, vmaddr: uint64, vmsize: uint64, fileoff: uint64, filesize: uint64, maxprot: int32, initprot: int32, nsects: int32) =
    machoPutU32At(out, pos, MachoLoadSegment64)
    machoPutU32At(out, pos + 4, uint32(72 + nsects * 80))
    machoPaddedAsciiAt(out, pos + 8, name, 16)
    machoPutU64At(out, pos + 24, vmaddr)
    machoPutU64At(out, pos + 32, vmsize)
    machoPutU64At(out, pos + 40, fileoff)
    machoPutU64At(out, pos + 48, filesize)
    machoPutU32At(out, pos + 56, uint32(maxprot))
    machoPutU32At(out, pos + 60, uint32(initprot))
    machoPutU32At(out, pos + 64, uint32(nsects))
    pos = pos + 72

@borrows
fn machoWriteSection(out: var uint8[], pos: var int32, sect: str, seg: str, addr: uint64, size: uint64, offset: int32, align: int32, flags: uint32, reserved1: int32, reserved2: int32) =
    machoPaddedAsciiAt(out, pos, sect, 16)
    machoPaddedAsciiAt(out, pos + 16, seg, 16)
    machoPutU64At(out, pos + 32, addr)
    machoPutU64At(out, pos + 40, size)
    machoPutU32At(out, pos + 48, uint32(offset))
    machoPutU32At(out, pos + 52, uint32(align))
    machoPutU32At(out, pos + 64, flags)
    machoPutU32At(out, pos + 68, uint32(reserved1))
    machoPutU32At(out, pos + 72, uint32(reserved2))
    pos = pos + 80

fn machoRawPutU32At(out: var rawbytes.Bytes, off: int32, value: uint32) =
    for i in 0..<4:
        rawbytes.BytesSet(out, off + i, int32((value >> uint32(i * 8)) & uint32(0xff)))

@borrows
fn machoRawGetU32At(input: rawbytes.Bytes, off: int32): uint32 =
    var value: uint32
    for i in 0..<4:
        value = value |
            (uint32(rawbytes.BytesGet(input, off + i) & 255) <<
             uint32(i * 8))
    return value

fn machoRawPutU64At(out: var rawbytes.Bytes, off: int32, value: uint64) =
    for i in 0..<8:
        rawbytes.BytesSet(out, off + i, int32((value >> uint64(i * 8)) & uint64(0xff)))

fn machoRawPutU32BEAt(out: var rawbytes.Bytes, off: int32, value: uint32) =
    rawbytes.BytesSet(out, off, int32((value >> uint32(24)) & uint32(0xff)))
    rawbytes.BytesSet(out, off + 1, int32((value >> uint32(16)) & uint32(0xff)))
    rawbytes.BytesSet(out, off + 2, int32((value >> uint32(8)) & uint32(0xff)))
    rawbytes.BytesSet(out, off + 3, int32(value & uint32(0xff)))

@borrows
fn machoRawCopyStringAt(out: var rawbytes.Bytes, off: int32, text: str) =
    for i in 0..<len(text):
        rawbytes.BytesSet(out, off + i, int32(text[i]) & 255)

@borrows
fn machoRawCopyString0At(out: var rawbytes.Bytes, off: int32, text: str) =
    for i in 0..<len(text):
        rawbytes.BytesSet(out, off + i, int32(text[i]) & 255)
    rawbytes.BytesSet(out, off + len(text), 0)

@borrows
fn machoRawPaddedAsciiAt(out: var rawbytes.Bytes, off: int32, text: str, width: int32) =
    for i in 0..<width:
        if i < len(text):
            rawbytes.BytesSet(out, off + i, int32(text[i]) & 255)
        else:
            rawbytes.BytesSet(out, off + i, 0)

@borrows
fn machoRawCopySeqAt(out: var rawbytes.Bytes, off: int32, data: uint8[]) =
    for i in 0..<data.len:
        rawbytes.BytesSet(out, off + i, int32(data[i]) & 255)

@borrows
fn machoRawCopyBytesAt(out: var rawbytes.Bytes, off: int32, data: rawbytes.Bytes) =
    for i in 0..<rawbytes.BytesLen(data):
        rawbytes.BytesSet(out, off + i, rawbytes.BytesGet(data, i) & 255)

@borrows
fn machoHexNibble(c: char): int32 =
    if c >= '0' && c <= '9':
        return Int32(c) - Int32('0')
    if c >= 'a' && c <= 'f':
        return Int32(c) - Int32('a') + 10
    if c >= 'A' && c <= 'F':
        return Int32(c) - Int32('A') + 10
    return -1

@borrows
fn machoCopyBytesInto(out: var rawbytes.Bytes, data: rawbytes.Bytes): bool =
    let n = rawbytes.BytesLen(data)
    if n <= 0 || n != rawbytes.BytesLen(out):
        return false
    for i in 0..<n:
        rawbytes.BytesSet(out, i, rawbytes.BytesGet(data, i) & 255)
    return true

@borrows
fn machoFillBytesFromHex(text: str, out: var rawbytes.Bytes): bool =
    let n = rawbytes.BytesLen(out)
    if n <= 0 || len(text) != n * 2:
        return false
    var i: int32
    while i < n:
        let hi = machoHexNibble(text[i * 2])
        let lo = machoHexNibble(text[i * 2 + 1])
        if hi < 0 || lo < 0:
            return false
        rawbytes.BytesSet(out, i, (hi << 4) | lo)
        i = i + 1
    return true

@borrows
fn machoProviderContentSetDigest(providerObjects: MachoProviderObject[]): Result[str] =
    let domain = "cheng.provider.content-set\x00"
    let itemSize = 4 + 8 + MachoCodeSignatureHashSize
    if providerObjects.len <= 0:
        return Err[str]("macho_provider_linker: provider content-set must not be empty")
    if providerObjects.len > (2147483647 - len(domain) - 4) / itemSize:
        return Err[str]("macho_provider_linker: provider content-set size overflow")
    let canonicalSize = len(domain) + 4 + providerObjects.len * itemSize
    var canonical = rawbytes.BytesAlloc(canonicalSize)
    if rawbytes.BytesLen(canonical) != canonicalSize:
        rawbytes.BytesFree(canonical)
        return Err[str]("macho_provider_linker: provider commitment allocation failed")
    machoRawCopyStringAt(canonical, 0, domain)
    machoRawPutU32At(canonical, len(domain), uint32(providerObjects.len))
    var pos = len(domain) + 4
    for i in 0..<providerObjects.len:
        let obj = providerObjects[i]
        if obj == nil || obj.data.data == nil || obj.data.len <= 0:
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: provider bytes unavailable at link order {i}")
        machoRawPutU32At(canonical, pos, uint32(i))
        machoRawPutU64At(canonical, pos + 4, uint64(obj.data.len))
        let exactObjectBytes = rawbytes.BytesView(obj.data.data, obj.data.len)
        var objectDigest = sha256.Sha256Digest(exactObjectBytes)
        if rawbytes.BytesLen(objectDigest) != MachoCodeSignatureHashSize:
            rawbytes.BytesFree(objectDigest)
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: provider sha256 failed at link order {i}")
        machoRawCopyBytesAt(canonical, pos + 12, objectDigest)
        rawbytes.BytesFree(objectDigest)
        pos = pos + itemSize
    var digest = sha256.Sha256Digest(canonical)
    rawbytes.BytesFree(canonical)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return Err[str]("macho_provider_linker: provider content-set sha256 failed")
    let digestText = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return Ok[str](digestText)

@borrows
fn machoProviderObjectIndex(objs: MachoProviderObject[],
                            target: MachoProviderObject): int32 =
    for i in 0..<objs.len:
        if objs[i] == target:
            return i
    return -1

@borrows
fn machoProviderFindDefinedRoot(obj: MachoProviderObject,
                                name: str,
                                outRootName: var str,
                                outByteOffset: var int32): bool =
    for i in 0..<obj.symbols.len:
        let sym = obj.symbols[i]
        var byteOff: int32
        if machoSymbolDefined(sym) && machoNameMatches(sym.name, name) &&
           machoSymbolLinkedByteOff(obj, sym, byteOff):
            outRootName = share(sym.name)
            outByteOffset = byteOff
            return true
    return false

@borrows
fn machoProviderCountDefinedObjectIndex(objs: MachoProviderObject[],
                                        name: str,
                                        excludeObjectIndex: int32,
                                        outObjectIndex: var int32,
                                        outRootName: var str,
                                        outByteOffset: var int32): int32 =
    var count: int32
    for oi in 0..<objs.len:
        if oi == excludeObjectIndex:
            continue
        var rootName: str
        var byteOffset: int32
        if machoProviderFindDefinedRoot(objs[oi], name, rootName, byteOffset):
            outObjectIndex = oi
            outRootName = rootName
            outByteOffset = byteOffset
            count = count + 1
    return count

@borrows
fn machoProviderResolveTarget(objs: MachoProviderObject[],
                              imports: str[],
                              origin: MachoProviderObject,
                              sym: MachoProviderSymbol,
                              stubBaseWord: int32): Result[MachoProviderResolvedTarget] =
    var out: MachoProviderResolvedTarget
    if sym == nil || len(sym.name) <= 0:
        return Err[MachoProviderResolvedTarget]("macho_provider_linker: relocation references unnamed symbol")
    if machoSymbolDefined(sym):
        let objectIndex = machoProviderObjectIndex(objs, origin)
        var byteOff: int32
        if objectIndex < 0 || !machoSymbolLinkedByteOff(origin, sym, byteOff):
            return Err[MachoProviderResolvedTarget]("macho_provider_linker: defined relocation target invalid")
        out.rootKind = "object"
        out.objectGlobalIndex = objectIndex
        out.dylibOrdinal = -1
        out.symbol = share(sym.name)
        out.byteOffset = byteOff
        return Ok[MachoProviderResolvedTarget](out)
    var definedObjectIndex: int32
    var definedRootName: str
    var definedByteOffset: int32
    # [wall138] undefined 符号不得由「引用者自己的定义」满足（单对象内
    # defined+undefined 同名是自指矛盾面，链接语义要求它走外部解析——
    # dylib 或其他对象）。否则 provider 内 @importc("puts") 引用会被
    # provider 自己的 @exportc("puts") 定义吞掉，链接成
    # puts_export→cheng_puts_export→puts_export 死循环（cold_nested
    # echo 实证栈溢出 SIGSEGV；ordinary 无主对象 puts 引用时同符号
    # 却绑 dylib stub，解析随引用者漂移）。排除 origin 后：唯一外部
    # 定义照旧绑定，origin 自定义不再参与计数，落 dylib import 臂。
    let originObjectIndex = machoProviderObjectIndex(objs, origin)
    let definedCount = machoProviderCountDefinedObjectIndex(objs,
                                                             sym.name,
                                                             originObjectIndex,
                                                             definedObjectIndex,
                                                             definedRootName,
                                                             definedByteOffset)
    if definedCount == 1:
        out.rootKind = "object"
        out.objectGlobalIndex = definedObjectIndex
        out.dylibOrdinal = -1
        out.symbol = definedRootName
        out.byteOffset = definedByteOffset
        return Ok[MachoProviderResolvedTarget](out)
    if definedCount > 1:
        return Err[MachoProviderResolvedTarget](Fmt"macho_provider_linker: duplicate symbol: {machoStripLeadingUnderscore(sym.name)}")
    let importIndex = machoImportIndex(imports, sym.name)
    if importIndex < 0:
        return Err[MachoProviderResolvedTarget](Fmt"macho_provider_linker: import missing after scan: {sym.name}")
    let ordinal = machoDarwinImportDylibOrdinal(sym.name)
    if ordinal <= 0:
        return Err[MachoProviderResolvedTarget](Fmt"macho_provider_linker: unsupported dynamic import: {sym.name}")
    out.rootKind = "dynamic_import"
    out.objectGlobalIndex = -1
    out.dylibOrdinal = ordinal
    out.symbol = share(imports[importIndex])
    out.byteOffset = stubBaseWord * 4 + importIndex * 12
    return Ok[MachoProviderResolvedTarget](out)

@borrows
fn machoProviderResolvedRoot(objs: MachoProviderObject[],
                             imports: str[],
                             origin: MachoProviderObject,
                             sym: MachoProviderSymbol,
                             stubBaseWord: int32): str =
    let targetRes = machoProviderResolveTarget(objs,
                                               imports,
                                               origin,
                                               sym,
                                               stubBaseWord)
    if !targetRes.ok:
        return ""
    let target = targetRes.value
    if target.rootKind == "object":
        return Fmt"object:{target.objectGlobalIndex}:{target.symbol}"
    return Fmt"dylib:{target.dylibOrdinal}:{target.symbol}"

fn machoProviderRangeWithin(offset: int64,
                            size: int64,
                            limit: int64): bool =
    if offset < int64(0) || size < int64(0) || limit < int64(0) ||
       offset > limit:
        return false
    return size <= limit - offset

@borrows
fn machoProviderHashSeqRange(data: uint8[],
                             offset: int64,
                             size: int64): str =
    if !machoProviderRangeWithin(offset, size, int64(data.len)):
        return ""
    let offset32 = int32(offset)
    let size32 = int32(size)
    var exact = rawbytes.BytesAlloc(size32)
    if rawbytes.BytesLen(exact) != size32:
        rawbytes.BytesFree(exact)
        return ""
    for i in 0..<size32:
        rawbytes.BytesSet(exact, i, int32(data[offset32 + i]) & 255)
    var digest = sha256.Sha256Digest(exact)
    rawbytes.BytesFree(exact)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return ""
    let out = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return out

@borrows
fn machoProviderHexSeqRange(data: uint8[],
                            offset: int64,
                            size: int64): str =
    if !machoProviderRangeWithin(offset, size, int64(data.len)):
        return ""
    let offset32 = int32(offset)
    let size32 = int32(size)
    var exact = rawbytes.BytesAlloc(size32)
    if rawbytes.BytesLen(exact) != size32:
        rawbytes.BytesFree(exact)
        return ""
    for i in 0..<size32:
        rawbytes.BytesSet(exact, i, int32(data[offset32 + i]) & 255)
    let out = rawbytes.BytesToHex(exact)
    rawbytes.BytesFree(exact)
    return out

@borrows
fn machoProviderHashRawRange(data: rawbytes.Bytes,
                             offset: int64,
                             size: int64): str =
    if !machoProviderRangeWithin(offset,
                                 size,
                                 int64(rawbytes.BytesLen(data))):
        return ""
    let exact = rawbytes.BytesSliceView(data, int32(offset), int32(size))
    var digest = sha256.Sha256Digest(exact)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return ""
    let out = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return out

@borrows
fn machoProviderValidateInputObjects(objects: MachoProviderObject[],
                                     canonicalPaths: str[],
                                     expectedContentSha256: str[],
                                     label: str): Result[bool] =
    if canonicalPaths.len != objects.len ||
       expectedContentSha256.len != objects.len:
        return Err[bool](Fmt"macho_provider_linker: {label} input identity cardinality mismatch")
    for i in 0..<objects.len:
        let obj = objects[i]
        if obj == nil || len(canonicalPaths[i]) <= 0 ||
           !machoProviderSha256TextValid(expectedContentSha256[i]):
            return Err[bool](Fmt"macho_provider_linker: invalid {label} input identity index={i}")
        let canonicalRes = fs.Realpath(canonicalPaths[i])
        if !canonicalRes.ok || canonicalRes.value != canonicalPaths[i]:
            return Err[bool](Fmt"macho_provider_linker: {label} input path is not canonical index={i}")
        let loadedSha256 = machoProviderHashByteBuffer(obj.data)
        var canonicalBytes = bytes.ReadFileBytes(canonicalPaths[i])
        let canonicalSha256 = machoProviderHashByteBuffer(canonicalBytes)
        let canonicalSize = canonicalBytes.len
        bytes.FreeByteBuffer(canonicalBytes)
        if loadedSha256 != expectedContentSha256[i] ||
           canonicalSha256 != expectedContentSha256[i] ||
           canonicalSize != obj.data.len:
            return Err[bool](Fmt"macho_provider_linker: {label} input bytes changed index={i}")
    return Ok[bool](true)

@borrows
fn machoProviderCanonicalPathsUnique(canonicalPaths: str[]): bool =
    var seen: hashmaps.HashMapStrInt = hashmaps.HashMapStrIntInit(1024)
    for i in 0..<canonicalPaths.len:
        var exists = false
        let _existingIndex = hashmaps.HashMapStrIntGetMutEx(
            seen,
            canonicalPaths[i],
            exists)
        if exists:
            return false
        hashmaps.HashMapStrIntPut(seen, share(canonicalPaths[i]), i + 1)
    return true

@borrows
fn machoProviderBuildProgramInventory(objects: MachoProviderObject[],
                                      canonicalPaths: str[],
                                      expectedContentSha256: str[]): Result[MachoProviderProgramInputEvidence[]] =
    if canonicalPaths.len != objects.len ||
       expectedContentSha256.len != objects.len:
        return Err[MachoProviderProgramInputEvidence[]]("macho_provider_linker: program inventory cardinality mismatch")
    if !machoProviderCanonicalPathsUnique(canonicalPaths):
        return Err[MachoProviderProgramInputEvidence[]]("macho_provider_linker: duplicate program inventory canonical path")
    var out: MachoProviderProgramInputEvidence[]
    for i in 0..<objects.len:
        let obj = objects[i]
        if obj == nil || obj.data.len <= 0 || len(canonicalPaths[i]) <= 0 ||
           !machoProviderSha256TextValid(expectedContentSha256[i]) ||
           machoProviderHashByteBuffer(obj.data) != expectedContentSha256[i]:
            return Err[MachoProviderProgramInputEvidence[]](Fmt"macho_provider_linker: invalid program inventory index={i}")
        var item: MachoProviderProgramInputEvidence
        item.programIndex = i
        item.inputCanonicalPath = canonicalPaths[i]
        item.inputContentSha256 = expectedContentSha256[i]
        item.inputSize = int64(obj.data.len)
        add(out, item)
    return Ok[MachoProviderProgramInputEvidence[]](out)

@borrows
fn machoProviderRelocationEncodingValid(reloc: MachoProviderReloc): bool =
    if reloc == nil || reloc.length != 2 || reloc.externReloc != 1:
        return false
    if reloc.kind == MachoRelocBranch26 || reloc.kind == MachoRelocPage21:
        return reloc.pcrel == 1
    if reloc.kind == MachoRelocPageOff12:
        return reloc.pcrel == 0
    return false

fn machoProviderRelocationValueContract(kind: int32): str =
    if kind == MachoRelocBranch26:
        return "arm64_branch26_instruction_le_u32"
    if kind == MachoRelocPage21:
        return "arm64_page21_instruction_le_u32"
    if kind == MachoRelocPageOff12:
        return "arm64_pageoff12_instruction_le_u32"
    return ""

@borrows
fn machoProviderBuildRelocationEvidence(objs: MachoProviderObject[],
                                        imports: str[],
                                        stubBaseWord: int32,
                                        programObjectCount: int32,
                                        canonicalPaths: str[],
                                        expectedContentSha256: str[],
                                        image: uint8[]): Result[MachoProviderRelocationEvidence[]] =
    if programObjectCount < 0 || programObjectCount > objs.len ||
       canonicalPaths.len != objs.len ||
       expectedContentSha256.len != objs.len:
        return Err[MachoProviderRelocationEvidence[]]("macho_provider_linker: relocation evidence input cardinality mismatch")
    var out: MachoProviderRelocationEvidence[]
    for oi in 0..<objs.len:
        let obj = objs[oi]
        for ri in 0..<obj.relocs.len:
            let reloc = obj.relocs[ri]
            if !machoProviderRelocationEncodingValid(reloc) ||
               reloc.symbolIndex < 0 || reloc.symbolIndex >= obj.symbols.len:
                return Err[MachoProviderRelocationEvidence[]](Fmt"macho_provider_linker: unsupported relocation evidence encoding object={oi} reloc={ri}")
            let targetRes = machoProviderResolveTarget(objs,
                                                       imports,
                                                       obj,
                                                       obj.symbols[reloc.symbolIndex],
                                                       stubBaseWord)
            if !targetRes.ok:
                return Err[MachoProviderRelocationEvidence[]](strings.CloneStr(targetRes.err.msg))
            let target = targetRes.value
            let patchOffsetInImage = int64(obj.baseWord) * int64(4) +
                                     int64(reloc.address)
            if !machoProviderRangeWithin(patchOffsetInImage,
                                         int64(4),
                                         int64(image.len)):
                return Err[MachoProviderRelocationEvidence[]](Fmt"macho_provider_linker: relocation evidence patch range invalid object={oi} reloc={ri}")
            var item: MachoProviderRelocationEvidence
            item.relocationIndex = out.len
            if oi < programObjectCount:
                item.originObjectKind = "program"
                item.originObjectIndex = oi
            else:
                item.originObjectKind = "provider"
                item.originObjectIndex = oi - programObjectCount
            item.originCanonicalPath = strings.CloneStr(canonicalPaths[oi])
            item.originContentSha256 = strings.CloneStr(expectedContentSha256[oi])
            item.originSectionIdentity = "__TEXT,__text"
            item.relocationOrdinal = ri
            item.relocationType = reloc.kind
            item.relocationAddress = int64(reloc.address)
            item.relocationPcrel = reloc.pcrel
            item.relocationLength = reloc.length
            item.relocationExtern = reloc.externReloc
            item.targetRootKind = target.rootKind
            item.targetObjectIndex = -1
            item.targetDylibOrdinal = target.dylibOrdinal
            if target.rootKind == "object":
                if target.objectGlobalIndex < programObjectCount:
                    item.targetObjectKind = "program"
                    item.targetObjectIndex = target.objectGlobalIndex
                else:
                    item.targetObjectKind = "provider"
                    item.targetObjectIndex = target.objectGlobalIndex - programObjectCount
            item.targetSymbol = strings.CloneStr(target.symbol)
            item.finalPatchFileOffset = int64(MachoCodeOff) + patchOffsetInImage
            item.patchedByteWidth = int64(4)
            item.patchedValueContract = machoProviderRelocationValueContract(reloc.kind)
            item.patchedBytesHex = machoProviderHexSeqRange(image,
                                                            patchOffsetInImage,
                                                            int64(4))
            item.patchedBytesSha256 = machoProviderHashSeqRange(image,
                                                                patchOffsetInImage,
                                                                int64(4))
            if len(item.patchedValueContract) <= 0 ||
               len(item.patchedBytesHex) != 8 ||
               !machoProviderSha256TextValid(item.patchedBytesSha256):
                return Err[MachoProviderRelocationEvidence[]](Fmt"macho_provider_linker: relocation evidence patch hash failed object={oi} reloc={ri}")
            add(out, item)
    return Ok[MachoProviderRelocationEvidence[]](out)

@borrows
fn machoProviderBuildEvidence(objs: MachoProviderObject[],
                              providerObjects: MachoProviderObject[],
                              imports: str[],
                              stubBaseWord: int32,
                              canonicalPaths: str[],
                              expectedContentSha256: str[],
                              image: uint8[],
                              dataRegion: uint8[],
                              textFileSize: int32,
                              dataRegionStartWord: int32): Result[MachoProviderEvidence[]] =
    if providerObjects.len <= 0:
        return Err[MachoProviderEvidence[]]("macho_provider_linker: provider evidence must not be empty")
    if canonicalPaths.len != providerObjects.len ||
       expectedContentSha256.len != providerObjects.len:
        return Err[MachoProviderEvidence[]]("macho_provider_linker: provider evidence cardinality mismatch")
    var out: MachoProviderEvidence[]
    for i in 0..<providerObjects.len:
        let obj = providerObjects[i]
        let contentSha256 = machoProviderHashByteBuffer(obj.data)
        let canonicalRes = fs.Realpath(canonicalPaths[i])
        if !canonicalRes.ok || canonicalRes.value != canonicalPaths[i]:
            return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence path is not canonical index={i}")
        var canonicalBytes = bytes.ReadFileBytes(canonicalPaths[i])
        let canonicalSha256 = machoProviderHashByteBuffer(canonicalBytes)
        let canonicalSize = canonicalBytes.len
        bytes.FreeByteBuffer(canonicalBytes)
        if !machoProviderSha256TextValid(contentSha256) ||
           contentSha256 != expectedContentSha256[i] ||
           canonicalSha256 != contentSha256 || canonicalSize != obj.data.len ||
           len(canonicalPaths[i]) <= 0:
            return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence input mismatch index={i}")
        var evidence: MachoProviderEvidence
        evidence.providerIndex = i
        evidence.inputCanonicalPath = share(canonicalPaths[i])
        evidence.inputContentSha256 = contentSha256
        evidence.inputSize = int64(obj.data.len)
        for si in 0..<obj.symbols.len:
            let sym = obj.symbols[si]
            if machoSymbolDefined(sym) && len(sym.name) > 0:
                add(evidence.definedRoots, share(sym.name))
        for ri in 0..<obj.relocs.len:
            let reloc = obj.relocs[ri]
            if reloc.symbolIndex < 0 || reloc.symbolIndex >= obj.symbols.len:
                return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence relocation symbol out of range index={i} reloc={ri}")
            let resolvedRoot = machoProviderResolvedRoot(objs,
                                                          imports,
                                                          obj,
                                                          obj.symbols[reloc.symbolIndex],
                                                          stubBaseWord)
            if len(resolvedRoot) <= 0:
                return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence unresolved root index={i} reloc={ri}")
            add(evidence.relocationResolvedRoots, strings.CloneStr(resolvedRoot))
        let textOffsetInImage = int64(obj.baseWord) * int64(4)
        let textSize = int64(obj.imageByteCount)
        if !machoProviderRangeWithin(textOffsetInImage,
                                     textSize,
                                     int64(image.len)):
            return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence text range invalid index={i}")
        evidence.textFileOffset = int64(MachoCodeOff) + textOffsetInImage
        evidence.textSize = textSize
        evidence.textPostRelocationSha256 = machoProviderHashSeqRange(image,
                                                                       textOffsetInImage,
                                                                       textSize)
        if !machoProviderSha256TextValid(evidence.textPostRelocationSha256):
            return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence text hash failed index={i}")
        if obj.dataByteCount > 0:
            let dataOffsetInRegion = (int64(obj.dataBaseWord) -
                                      int64(dataRegionStartWord)) * int64(4)
            let dataSize = int64(obj.dataByteCount)
            if !machoProviderRangeWithin(dataOffsetInRegion,
                                         dataSize,
                                         int64(dataRegion.len)):
                return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence data range invalid index={i}")
            evidence.dataFileOffset = int64(textFileSize) + dataOffsetInRegion
            evidence.dataSize = dataSize
            evidence.dataPostRelocationSha256 = machoProviderHashSeqRange(dataRegion,
                                                                           dataOffsetInRegion,
                                                                           dataSize)
        else:
            evidence.dataFileOffset = int64(-1)
            evidence.dataPostRelocationSha256 = machoProviderHashSeqRange(dataRegion,
                                                                           int64(0),
                                                                           int64(0))
        if !machoProviderSha256TextValid(evidence.dataPostRelocationSha256):
            return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence data hash failed index={i}")
        if evidence.relocationResolvedRoots.len != obj.relocs.len:
            return Err[MachoProviderEvidence[]](Fmt"macho_provider_linker: provider evidence relocation cardinality mismatch index={i}")
        add(out, evidence)
    return Ok[MachoProviderEvidence[]](out)

@borrows
fn machoProviderEvidenceNumericValid(item: MachoProviderEvidence): bool =
    if item.inputSize <= int64(0) || item.inputSize > int64(2147483647) ||
       item.textFileOffset < int64(0) ||
       item.textFileOffset > int64(2147483647) || item.textSize <= int64(0) ||
       item.textSize > int64(2147483647) || item.dataSize < int64(0) ||
       item.dataSize > int64(2147483647):
        return false
    if item.dataSize == int64(0):
        return item.dataFileOffset == int64(-1)
    return item.dataFileOffset >= int64(0) &&
           item.dataFileOffset <= int64(2147483647)

fn machoProviderCheckedAddSize(total: var int64,
                               delta: int64): bool =
    if delta < int64(0) || total < int64(0) ||
       total > MachoProviderMaxInt64 - delta:
        return false
    total = total + delta
    return true

@borrows
fn machoProviderEvidenceCanonicalSize(evidence: MachoProviderEvidence[]): int64 =
    var total = int64(len(MachoProviderEvidenceSchema)) + int64(1) + int64(4)
    for i in 0..<evidence.len:
        let item = evidence[i]
        # [l1] v4 digest coverage: providerIndex + inputSize + input
        # sha256 + root-count prefix; path text is not part of it.
        let itemPrefixSize = int64(4) + int64(8) + int64(32) + int64(4)
        if !machoProviderCheckedAddSize(total, itemPrefixSize):
            return int64(-1)
        for ri in 0..<item.definedRoots.len:
            let rootSize = int64(4) + int64(len(item.definedRoots[ri]))
            if !machoProviderCheckedAddSize(total, rootSize):
                return int64(-1)
        if !machoProviderCheckedAddSize(total, int64(4)):
            return int64(-1)
        for ri in 0..<item.relocationResolvedRoots.len:
            let rootSize = int64(4) +
                           int64(len(item.relocationResolvedRoots[ri]))
            if !machoProviderCheckedAddSize(total, rootSize):
                return int64(-1)
        if !machoProviderCheckedAddSize(total,
                                        int64(8 + 8 + 32 + 8 + 8 + 32)):
            return int64(-1)
    return total

@borrows
fn machoProviderEvidenceDigest(evidence: MachoProviderEvidence[]): Result[str] =
    if evidence.len <= 0:
        return Err[str]("macho_provider_linker: provider evidence must not be empty")
    let canonicalSize64 = machoProviderEvidenceCanonicalSize(evidence)
    if canonicalSize64 <= int64(0) || canonicalSize64 > int64(2147483647):
        return Err[str]("macho_provider_linker: provider evidence canonical size overflow")
    let canonicalSize = int32(canonicalSize64)
    var canonical = rawbytes.BytesAlloc(canonicalSize)
    if rawbytes.BytesLen(canonical) != canonicalSize:
        rawbytes.BytesFree(canonical)
        return Err[str]("macho_provider_linker: provider evidence allocation failed")
    var pos: int32
    machoRawCopyStringAt(canonical, pos, MachoProviderEvidenceSchema)
    pos = pos + len(MachoProviderEvidenceSchema)
    rawbytes.BytesSet(canonical, pos, 0)
    pos = pos + 1
    machoRawPutU32At(canonical, pos, uint32(evidence.len))
    pos = pos + 4
    for i in 0..<evidence.len:
        let item = evidence[i]
        if item.providerIndex != i ||
           !machoProviderEvidenceNumericValid(item) ||
           !machoProviderSha256TextValid(item.inputContentSha256) ||
           !machoProviderSha256TextValid(item.textPostRelocationSha256) ||
           !machoProviderSha256TextValid(item.dataPostRelocationSha256):
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: invalid provider evidence index={i}")
        machoRawPutU32At(canonical, pos, uint32(item.providerIndex))
        pos = pos + 4
        # [l1] v4: input canonical path stays receipt/report-only; the
        # digest binds content (size+sha) and linked layout, which is
        # independent of where the input object file was placed.
        machoRawPutU64At(canonical, pos, uint64(item.inputSize))
        pos = pos + 8
        var inputDigest = rawbytes.BytesFromHex(item.inputContentSha256)
        if rawbytes.BytesLen(inputDigest) != MachoCodeSignatureHashSize:
            rawbytes.BytesFree(inputDigest)
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: invalid provider input hash index={i}")
        machoRawCopyBytesAt(canonical, pos, inputDigest)
        rawbytes.BytesFree(inputDigest)
        pos = pos + MachoCodeSignatureHashSize
        machoRawPutU32At(canonical, pos, uint32(item.definedRoots.len))
        pos = pos + 4
        for ri in 0..<item.definedRoots.len:
            let root = item.definedRoots[ri]
            machoRawPutU32At(canonical, pos, uint32(len(root)))
            pos = pos + 4
            machoRawCopyStringAt(canonical, pos, root)
            pos = pos + len(root)
        machoRawPutU32At(canonical, pos, uint32(item.relocationResolvedRoots.len))
        pos = pos + 4
        for ri in 0..<item.relocationResolvedRoots.len:
            let root = item.relocationResolvedRoots[ri]
            machoRawPutU32At(canonical, pos, uint32(len(root)))
            pos = pos + 4
            machoRawCopyStringAt(canonical, pos, root)
            pos = pos + len(root)
        machoRawPutU64At(canonical, pos, uint64(item.textFileOffset + int64(1)))
        machoRawPutU64At(canonical, pos + 8, uint64(item.textSize))
        var textDigest = rawbytes.BytesFromHex(item.textPostRelocationSha256)
        if rawbytes.BytesLen(textDigest) != MachoCodeSignatureHashSize:
            rawbytes.BytesFree(textDigest)
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: invalid provider text hash index={i}")
        machoRawCopyBytesAt(canonical, pos + 16, textDigest)
        rawbytes.BytesFree(textDigest)
        pos = pos + 16 + MachoCodeSignatureHashSize
        machoRawPutU64At(canonical, pos, uint64(item.dataFileOffset + int64(1)))
        machoRawPutU64At(canonical, pos + 8, uint64(item.dataSize))
        var dataDigest = rawbytes.BytesFromHex(item.dataPostRelocationSha256)
        if rawbytes.BytesLen(dataDigest) != MachoCodeSignatureHashSize:
            rawbytes.BytesFree(dataDigest)
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: invalid provider data hash index={i}")
        machoRawCopyBytesAt(canonical, pos + 16, dataDigest)
        rawbytes.BytesFree(dataDigest)
        pos = pos + 16 + MachoCodeSignatureHashSize
    if pos != canonicalSize:
        rawbytes.BytesFree(canonical)
        return Err[str]("macho_provider_linker: provider evidence canonical size mismatch")
    var digest = sha256.Sha256Digest(canonical)
    rawbytes.BytesFree(canonical)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return Err[str]("macho_provider_linker: provider evidence sha256 failed")
    let digestText = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return Ok[str](digestText)

@borrows
fn machoProviderContentSetDigestFromEvidence(evidence: MachoProviderEvidence[]): Result[str] =
    let domain = "cheng.provider.content-set\x00"
    let itemSize = 4 + 8 + MachoCodeSignatureHashSize
    if evidence.len <= 0:
        return Err[str]("macho_provider_linker: provider evidence content-set must not be empty")
    if evidence.len > (2147483647 - len(domain) - 4) / itemSize:
        return Err[str]("macho_provider_linker: provider evidence content-set size overflow")
    let canonicalSize = len(domain) + 4 + evidence.len * itemSize
    var canonical = rawbytes.BytesAlloc(canonicalSize)
    if rawbytes.BytesLen(canonical) != canonicalSize:
        rawbytes.BytesFree(canonical)
        return Err[str]("macho_provider_linker: provider evidence content-set allocation failed")
    machoRawCopyStringAt(canonical, 0, domain)
    machoRawPutU32At(canonical, len(domain), uint32(evidence.len))
    var pos = len(domain) + 4
    for i in 0..<evidence.len:
        let item = evidence[i]
        if item.providerIndex != i || item.inputSize <= int64(0) ||
           !machoProviderSha256TextValid(item.inputContentSha256):
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: invalid provider evidence content-set index={i}")
        machoRawPutU32At(canonical, pos, uint32(i))
        machoRawPutU64At(canonical, pos + 4, uint64(item.inputSize))
        var objectDigest = rawbytes.BytesFromHex(item.inputContentSha256)
        if rawbytes.BytesLen(objectDigest) != MachoCodeSignatureHashSize:
            rawbytes.BytesFree(objectDigest)
            rawbytes.BytesFree(canonical)
            return Err[str](Fmt"macho_provider_linker: invalid provider evidence object hash index={i}")
        machoRawCopyBytesAt(canonical, pos + 12, objectDigest)
        rawbytes.BytesFree(objectDigest)
        pos = pos + itemSize
    var digest = sha256.Sha256Digest(canonical)
    rawbytes.BytesFree(canonical)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return Err[str]("macho_provider_linker: provider evidence content-set sha256 failed")
    let digestText = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return Ok[str](digestText)

@borrows
fn machoProviderEvidenceReportTextHex(value: str): str =
    var raw = rawbytes.BytesAlloc(len(value))
    defer:
        rawbytes.BytesFree(raw)
    if rawbytes.BytesLen(raw) != len(value):
        return ""
    for i in 0..<len(value):
        rawbytes.BytesSet(raw, i, int32(value[i]) & 255)
    return rawbytes.BytesToHex(raw)

@borrows
fn MachoProviderEvidenceReportLines(receipt: MachoProviderLinkReceipt): Result[str[]] =
    if receipt.providerEvidenceSchema != MachoProviderEvidenceSchema ||
       receipt.providerObjectCount <= 0 ||
       receipt.providerEvidence.len != receipt.providerObjectCount ||
       !machoProviderSha256TextValid(receipt.providerEvidenceSha256) ||
       !machoProviderSha256TextValid(receipt.providerObjectContentSha256):
        return Err[str[]]("macho_provider_linker: invalid provider evidence report receipt")
    let evidenceDigestRes = machoProviderEvidenceDigest(receipt.providerEvidence)
    if !evidenceDigestRes.ok:
        return Err[str[]](strings.CloneStr(evidenceDigestRes.err.msg))
    if evidenceDigestRes.value != receipt.providerEvidenceSha256:
        return Err[str[]]("macho_provider_linker: provider evidence report digest mismatch")
    let contentDigestRes = machoProviderContentSetDigestFromEvidence(receipt.providerEvidence)
    if !contentDigestRes.ok:
        return Err[str[]](strings.CloneStr(contentDigestRes.err.msg))
    if contentDigestRes.value != receipt.providerObjectContentSha256:
        return Err[str[]]("macho_provider_linker: provider evidence report content-set mismatch")
    var lines: str[]
    add(lines, Fmt"provider_evidence_schema={receipt.providerEvidenceSchema}")
    add(lines, Fmt"provider_evidence_sha256={receipt.providerEvidenceSha256}")
    add(lines, Fmt"provider_evidence_count={receipt.providerEvidence.len}")
    for i in 0..<receipt.providerEvidence.len:
        let evidence = receipt.providerEvidence[i]
        let prefix = Fmt"provider_evidence_{i}"
        add(lines, Fmt"{prefix}_index={evidence.providerIndex}")
        add(lines, Fmt"{prefix}_input_canonical_path_hex={machoProviderEvidenceReportTextHex(evidence.inputCanonicalPath)}")
        add(lines, Fmt"{prefix}_input_content_sha256={evidence.inputContentSha256}")
        add(lines, Fmt"{prefix}_input_size={strings.Int64ToStr(evidence.inputSize)}")
        add(lines, Fmt"{prefix}_defined_root_count={evidence.definedRoots.len}")
        for rootIndex in 0..<evidence.definedRoots.len:
            add(lines, Fmt"{prefix}_defined_root_{rootIndex}_hex={machoProviderEvidenceReportTextHex(evidence.definedRoots[rootIndex])}")
        add(lines, Fmt"{prefix}_relocation_resolved_root_count={evidence.relocationResolvedRoots.len}")
        for rootIndex in 0..<evidence.relocationResolvedRoots.len:
            add(lines, Fmt"{prefix}_relocation_resolved_root_{rootIndex}_hex={machoProviderEvidenceReportTextHex(evidence.relocationResolvedRoots[rootIndex])}")
        add(lines, Fmt"{prefix}_text_file_offset={strings.Int64ToStr(evidence.textFileOffset)}")
        add(lines, Fmt"{prefix}_text_size={strings.Int64ToStr(evidence.textSize)}")
        add(lines, Fmt"{prefix}_text_post_relocation_sha256={evidence.textPostRelocationSha256}")
        add(lines, Fmt"{prefix}_data_file_offset={strings.Int64ToStr(evidence.dataFileOffset)}")
        add(lines, Fmt"{prefix}_data_size={strings.Int64ToStr(evidence.dataSize)}")
        add(lines, Fmt"{prefix}_data_post_relocation_sha256={evidence.dataPostRelocationSha256}")
    return Ok[str[]](lines)

@borrows
fn MachoProviderEvidenceReportLinesMatch(actualLines: str[],
                                         receipt: MachoProviderLinkReceipt): bool =
    let expectedRes = MachoProviderEvidenceReportLines(receipt)
    if !expectedRes.ok:
        return false
    let expectedLines = expectedRes.value
    if actualLines.len != expectedLines.len:
        return false
    for i in 0..<expectedLines.len:
        if actualLines[i] != expectedLines[i]:
            return false
    return true

@borrows
fn machoProviderHexTextValid(value: str,
                             byteCount: int32): bool =
    if byteCount < 0 || len(value) != byteCount * 2:
        return false
    for i in 0..<len(value):
        let c = value[i]
        if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')):
            return false
    return true

@borrows
fn machoProviderProofAddSegmentLines(lines: var str[],
                                     prefix: str,
                                     segment: MachoProviderSegmentEvidence) =
    add(lines, Fmt"{prefix}_name_hex={machoProviderEvidenceReportTextHex(segment.segmentName)}")
    add(lines, Fmt"{prefix}_file_offset={strings.Int64ToStr(segment.fileOffset)}")
    add(lines, Fmt"{prefix}_file_size={strings.Int64ToStr(segment.fileSize)}")
    add(lines, Fmt"{prefix}_vm_address={strings.Uint64ToStr(segment.vmAddress)}")
    add(lines, Fmt"{prefix}_vm_size={strings.Uint64ToStr(segment.vmSize)}")
    add(lines, Fmt"{prefix}_post_relocation_sha256={segment.postRelocationSha256}")

@borrows
fn machoProviderProofMaterialLines(programObjectCount: int32,
                                   providerObjectCount: int32,
                                   providerEvidenceSha256: str,
                                   programInputs: MachoProviderProgramInputEvidence[],
                                   providerEvidence: MachoProviderEvidence[],
                                   relocations: MachoProviderRelocationEvidence[],
                                   textSegment: MachoProviderSegmentEvidence,
                                   dataSegment: MachoProviderSegmentEvidence,
                                   imports: MachoProviderDynamicImportEvidence[],
                                   staticUnresolvedCount: int32): Result[str[]] =
    if programObjectCount < 0 || providerObjectCount <= 0 ||
       !machoProviderSha256TextValid(providerEvidenceSha256) ||
       programInputs.len != programObjectCount ||
       providerEvidence.len != providerObjectCount ||
       staticUnresolvedCount != 0 ||
       textSegment.segmentName != "__TEXT" ||
       textSegment.fileOffset != int64(0) || textSegment.fileSize <= int64(0) ||
       textSegment.fileSize > int64(2147483647) ||
       textSegment.vmAddress != machoTextBase() ||
       textSegment.vmSize != uint64(textSegment.fileSize) ||
       !machoProviderSha256TextValid(textSegment.postRelocationSha256) ||
       dataSegment.segmentName != "__DATA" ||
       !machoProviderSha256TextValid(dataSegment.postRelocationSha256):
        return Err[str[]]("macho_provider_linker: invalid provider proof header")
    if dataSegment.fileSize == int64(0):
        if dataSegment.fileOffset != int64(-1) ||
           dataSegment.vmAddress != uint64(0) || dataSegment.vmSize != uint64(0):
            return Err[str[]]("macho_provider_linker: invalid empty __DATA proof")
    else:
        if dataSegment.fileOffset < int64(0) ||
           dataSegment.fileOffset > int64(2147483647) ||
           dataSegment.fileSize > int64(2147483647) ||
           dataSegment.vmAddress == uint64(0) ||
           dataSegment.vmSize != uint64(dataSegment.fileSize):
            return Err[str[]]("macho_provider_linker: invalid __DATA proof")
    let objectCount64 = int64(programObjectCount) + int64(providerObjectCount)
    if objectCount64 > int64(2147483647):
        return Err[str[]]("macho_provider_linker: provider proof object count overflow")
    let objectCount = int32(objectCount64)
    var nextRelocationOrdinal: int32[]
    setLen(nextRelocationOrdinal, objectCount)
    var importReferenceCounts: int32[]
    setLen(importReferenceCounts, imports.len)
    var programPathIndex: hashmaps.HashMapStrInt =
        hashmaps.HashMapStrIntInit(1024)
    var importIndexBySymbol: hashmaps.HashMapStrInt =
        hashmaps.HashMapStrIntInit(1024)
    var lines: str[]
    add(lines, Fmt"provider_proof_schema={MachoProviderProofSchema}")
    add(lines, Fmt"provider_proof_provider_evidence_sha256={providerEvidenceSha256}")
    add(lines, Fmt"provider_proof_program_object_count={programObjectCount}")
    add(lines, Fmt"provider_proof_provider_object_count={providerObjectCount}")
    add(lines, Fmt"provider_proof_static_unresolved_count={staticUnresolvedCount}")
    add(lines, Fmt"provider_proof_program_inventory_schema={MachoProviderProgramInventorySchema}")
    add(lines, Fmt"provider_proof_program_inventory_count={programInputs.len}")
    for i in 0..<programInputs.len:
        let item = programInputs[i]
        if item.programIndex != i || len(item.inputCanonicalPath) <= 0 ||
           !machoProviderSha256TextValid(item.inputContentSha256) ||
           item.inputSize <= int64(0) || item.inputSize > int64(2147483647):
            return Err[str[]](Fmt"macho_provider_linker: invalid program inventory proof index={i}")
        var pathExists = false
        let _existingPathIndex = hashmaps.HashMapStrIntGetMutEx(
            programPathIndex,
            item.inputCanonicalPath,
            pathExists)
        if pathExists:
            return Err[str[]](Fmt"macho_provider_linker: duplicate program inventory proof path index={i}")
        hashmaps.HashMapStrIntPut(programPathIndex,
                                  share(item.inputCanonicalPath),
                                  i + 1)
        let prefix = Fmt"provider_proof_program_inventory_{i}"
        add(lines, Fmt"{prefix}_index={item.programIndex}")
        # [l1] v4: canonical path excluded from proof digest; content
        # sha256 + size are the binding identity.
        add(lines, Fmt"{prefix}_content_sha256={item.inputContentSha256}")
        add(lines, Fmt"{prefix}_size={strings.Int64ToStr(item.inputSize)}")
    for i in 0..<providerEvidence.len:
        let item = providerEvidence[i]
        if item.providerIndex != i || len(item.inputCanonicalPath) <= 0 ||
           !machoProviderSha256TextValid(item.inputContentSha256) ||
           item.inputSize <= int64(0) || item.inputSize > int64(2147483647):
            return Err[str[]](Fmt"macho_provider_linker: invalid provider inventory proof index={i}")
    machoProviderProofAddSegmentLines(lines,
                                      "provider_proof_text_segment",
                                      textSegment)
    machoProviderProofAddSegmentLines(lines,
                                      "provider_proof_data_segment",
                                      dataSegment)
    add(lines, Fmt"provider_proof_dynamic_import_count={imports.len}")
    for i in 0..<imports.len:
        let item = imports[i]
        if item.importIndex != i || item.dylibOrdinal <= 0 ||
           item.dylibOrdinal != machoDarwinImportDylibOrdinal(item.symbol) ||
           item.dylibPath != machoProviderDylibPathForOrdinal(item.dylibOrdinal) ||
           len(item.symbol) <= 0 ||
           item.nlistIndex != i || item.nlistFileOffset < int64(0) ||
           item.nlistFileOffset > int64(2147483647) ||
           !machoProviderSha256TextValid(item.nlistEntrySha256) ||
           item.bindRecordOrdinal != i || item.bindRecordFileOffset < int64(0) ||
           item.bindRecordFileOffset > int64(2147483647) ||
           item.bindRecordSize <= int64(0) ||
           !machoProviderSha256TextValid(item.bindRecordSha256) ||
           item.stubFileOffset < int64(0) || item.stubSize != int64(12) ||
           item.stubFileOffset > int64(2147483647) ||
           !machoProviderSha256TextValid(item.stubPostRelocationSha256) ||
           item.gotFileOffset < int64(0) || item.gotSize != int64(8) ||
           item.gotFileOffset > int64(2147483647) ||
           item.gotValueContract != "dyld_bind_pointer_zero_in_file" ||
           !machoProviderSha256TextValid(item.gotInitialSha256):
            return Err[str[]](Fmt"macho_provider_linker: invalid dynamic import proof index={i}")
        var importExists = false
        let _existingImportIndex = hashmaps.HashMapStrIntGetMutEx(
            importIndexBySymbol,
            item.symbol,
            importExists)
        if importExists:
            return Err[str[]](Fmt"macho_provider_linker: duplicate dynamic import proof index={i}")
        hashmaps.HashMapStrIntPut(importIndexBySymbol,
                                  share(item.symbol),
                                  i + 1)
        let prefix = Fmt"provider_proof_dynamic_import_{i}"
        add(lines, Fmt"{prefix}_index={item.importIndex}")
        add(lines, Fmt"{prefix}_dylib_ordinal={item.dylibOrdinal}")
        add(lines, Fmt"{prefix}_dylib_path_hex={machoProviderEvidenceReportTextHex(item.dylibPath)}")
        add(lines, Fmt"{prefix}_symbol_hex={machoProviderEvidenceReportTextHex(item.symbol)}")
        add(lines, Fmt"{prefix}_nlist_index={item.nlistIndex}")
        add(lines, Fmt"{prefix}_nlist_file_offset={strings.Int64ToStr(item.nlistFileOffset)}")
        add(lines, Fmt"{prefix}_nlist_entry_sha256={item.nlistEntrySha256}")
        add(lines, Fmt"{prefix}_bind_record_ordinal={item.bindRecordOrdinal}")
        add(lines, Fmt"{prefix}_bind_record_file_offset={strings.Int64ToStr(item.bindRecordFileOffset)}")
        add(lines, Fmt"{prefix}_bind_record_size={strings.Int64ToStr(item.bindRecordSize)}")
        add(lines, Fmt"{prefix}_bind_record_sha256={item.bindRecordSha256}")
        add(lines, Fmt"{prefix}_stub_file_offset={strings.Int64ToStr(item.stubFileOffset)}")
        add(lines, Fmt"{prefix}_stub_size={strings.Int64ToStr(item.stubSize)}")
        add(lines, Fmt"{prefix}_stub_post_relocation_sha256={item.stubPostRelocationSha256}")
        add(lines, Fmt"{prefix}_got_file_offset={strings.Int64ToStr(item.gotFileOffset)}")
        add(lines, Fmt"{prefix}_got_size={strings.Int64ToStr(item.gotSize)}")
        add(lines, Fmt"{prefix}_got_value_contract={item.gotValueContract}")
        add(lines, Fmt"{prefix}_got_initial_sha256={item.gotInitialSha256}")
    add(lines, Fmt"provider_proof_relocation_schema={MachoProviderRelocationSchema}")
    add(lines, Fmt"provider_proof_relocation_count={relocations.len}")
    var lastOriginGlobalIndex: int32 = -1
    for i in 0..<relocations.len:
        let item = relocations[i]
        var originGlobalIndex: int32 = -1
        if item.originObjectKind == "program" &&
           item.originObjectIndex >= 0 &&
           item.originObjectIndex < programObjectCount:
            originGlobalIndex = item.originObjectIndex
        elif item.originObjectKind == "provider" &&
             item.originObjectIndex >= 0 &&
             item.originObjectIndex < providerObjectCount:
            originGlobalIndex = programObjectCount + item.originObjectIndex
        if item.relocationIndex != i || originGlobalIndex < 0 ||
           originGlobalIndex < lastOriginGlobalIndex ||
           item.relocationOrdinal != nextRelocationOrdinal[originGlobalIndex] ||
           len(item.originCanonicalPath) <= 0 ||
           !machoProviderSha256TextValid(item.originContentSha256) ||
           item.originSectionIdentity != "__TEXT,__text" ||
           item.relocationAddress < int64(0) ||
           item.relocationAddress > int64(2147483647) ||
           item.relocationLength != 2 || item.relocationExtern != 1 ||
           len(machoProviderRelocationValueContract(item.relocationType)) <= 0 ||
           item.patchedValueContract != machoProviderRelocationValueContract(item.relocationType) ||
           item.finalPatchFileOffset < int64(MachoCodeOff) ||
           item.finalPatchFileOffset > int64(2147483647) ||
           item.patchedByteWidth != int64(4) ||
           !machoProviderHexTextValid(item.patchedBytesHex, 4) ||
           !machoProviderSha256TextValid(item.patchedBytesSha256):
            return Err[str[]](Fmt"macho_provider_linker: invalid relocation proof index={i}")
        if (item.relocationType == MachoRelocBranch26 ||
            item.relocationType == MachoRelocPage21) && item.relocationPcrel != 1:
            return Err[str[]](Fmt"macho_provider_linker: invalid pcrel relocation proof index={i}")
        if item.relocationType == MachoRelocPageOff12 && item.relocationPcrel != 0:
            return Err[str[]](Fmt"macho_provider_linker: invalid pageoff relocation proof index={i}")
        if item.originObjectKind == "program":
            let originInput = programInputs[item.originObjectIndex]
            if item.originCanonicalPath != originInput.inputCanonicalPath ||
               item.originContentSha256 != originInput.inputContentSha256:
                return Err[str[]](Fmt"macho_provider_linker: relocation program inventory mismatch index={i}")
        else:
            let originInput = providerEvidence[item.originObjectIndex]
            if item.originCanonicalPath != originInput.inputCanonicalPath ||
               item.originContentSha256 != originInput.inputContentSha256:
                return Err[str[]](Fmt"macho_provider_linker: relocation provider inventory mismatch index={i}")
        nextRelocationOrdinal[originGlobalIndex] =
            nextRelocationOrdinal[originGlobalIndex] + 1
        lastOriginGlobalIndex = originGlobalIndex
        if item.targetRootKind == "object":
            if item.targetDylibOrdinal != -1 || len(item.targetSymbol) <= 0 ||
               !((item.targetObjectKind == "program" &&
                  item.targetObjectIndex >= 0 &&
                  item.targetObjectIndex < programObjectCount) ||
                 (item.targetObjectKind == "provider" &&
                  item.targetObjectIndex >= 0 &&
                  item.targetObjectIndex < providerObjectCount)):
                return Err[str[]](Fmt"macho_provider_linker: invalid object relocation target proof index={i}")
        elif item.targetRootKind == "dynamic_import":
            if len(item.targetObjectKind) != 0 || item.targetObjectIndex != -1 ||
               item.targetDylibOrdinal <= 0:
                return Err[str[]](Fmt"macho_provider_linker: invalid import relocation target proof index={i}")
            var importFound = false
            let importIndexPlusOne = hashmaps.HashMapStrIntGetMutEx(
                importIndexBySymbol,
                item.targetSymbol,
                importFound)
            if !importFound || importIndexPlusOne <= 0 ||
               importIndexPlusOne > imports.len:
                return Err[str[]](Fmt"macho_provider_linker: relocation import missing from proof index={i}")
            let importIndex = importIndexPlusOne - 1
            if imports[importIndex].dylibOrdinal != item.targetDylibOrdinal:
                return Err[str[]](Fmt"macho_provider_linker: relocation import ordinal mismatch index={i}")
            importReferenceCounts[importIndex] = importReferenceCounts[importIndex] + 1
        else:
            return Err[str[]](Fmt"macho_provider_linker: invalid relocation target kind index={i}")
        let prefix = Fmt"provider_proof_relocation_{i}"
        add(lines, Fmt"{prefix}_index={item.relocationIndex}")
        add(lines, Fmt"{prefix}_origin_object_kind={item.originObjectKind}")
        add(lines, Fmt"{prefix}_origin_object_index={item.originObjectIndex}")
        # [l1] v4: origin canonical path excluded from proof digest.
        add(lines, Fmt"{prefix}_origin_content_sha256={item.originContentSha256}")
        add(lines, Fmt"{prefix}_origin_section_identity_hex={machoProviderEvidenceReportTextHex(item.originSectionIdentity)}")
        add(lines, Fmt"{prefix}_ordinal={item.relocationOrdinal}")
        add(lines, Fmt"{prefix}_type={item.relocationType}")
        add(lines, Fmt"{prefix}_address={strings.Int64ToStr(item.relocationAddress)}")
        add(lines, Fmt"{prefix}_pcrel={item.relocationPcrel}")
        add(lines, Fmt"{prefix}_length={item.relocationLength}")
        add(lines, Fmt"{prefix}_extern={item.relocationExtern}")
        add(lines, Fmt"{prefix}_target_root_kind={item.targetRootKind}")
        add(lines, Fmt"{prefix}_target_object_kind={item.targetObjectKind}")
        add(lines, Fmt"{prefix}_target_object_index={item.targetObjectIndex}")
        add(lines, Fmt"{prefix}_target_dylib_ordinal={item.targetDylibOrdinal}")
        add(lines, Fmt"{prefix}_target_symbol_hex={machoProviderEvidenceReportTextHex(item.targetSymbol)}")
        add(lines, Fmt"{prefix}_final_patch_file_offset={strings.Int64ToStr(item.finalPatchFileOffset)}")
        add(lines, Fmt"{prefix}_patched_byte_width={strings.Int64ToStr(item.patchedByteWidth)}")
        add(lines, Fmt"{prefix}_patched_value_contract={item.patchedValueContract}")
        add(lines, Fmt"{prefix}_patched_bytes_hex={item.patchedBytesHex}")
        add(lines, Fmt"{prefix}_patched_bytes_sha256={item.patchedBytesSha256}")
    for i in 0..<imports.len:
        if importReferenceCounts[i] <= 0:
            return Err[str[]](Fmt"macho_provider_linker: unreferenced dynamic import proof index={i}")
    return Ok[str[]](lines)

@borrows
fn machoProviderProofDigest(programObjectCount: int32,
                            providerObjectCount: int32,
                            providerEvidenceSha256: str,
                            programInputs: MachoProviderProgramInputEvidence[],
                            providerEvidence: MachoProviderEvidence[],
                            relocations: MachoProviderRelocationEvidence[],
                            textSegment: MachoProviderSegmentEvidence,
                            dataSegment: MachoProviderSegmentEvidence,
                            imports: MachoProviderDynamicImportEvidence[],
                            staticUnresolvedCount: int32): Result[str] =
    let linesRes = machoProviderProofMaterialLines(programObjectCount,
                                                   providerObjectCount,
                                                   providerEvidenceSha256,
                                                   programInputs,
                                                   providerEvidence,
                                                   relocations,
                                                   textSegment,
                                                   dataSegment,
                                                   imports,
                                                   staticUnresolvedCount)
    if !linesRes.ok:
        return Err[str](strings.CloneStr(linesRes.err.msg))
    let lines = Value(linesRes)
    let domain = "cheng.provider.proof\x00"
    var canonicalSize64 = int64(len(domain))
    for i in 0..<lines.len:
        let addend = int64(len(lines[i])) + int64(1)
        if addend < int64(0) || canonicalSize64 < int64(0) ||
           canonicalSize64 > MachoProviderMaxInt64 - addend:
            return Err[str]("macho_provider_linker: provider proof canonical size overflow")
        canonicalSize64 = canonicalSize64 + addend
    if canonicalSize64 <= int64(0) || canonicalSize64 > int64(2147483647):
        return Err[str]("macho_provider_linker: provider proof canonical size overflow")
    let canonicalSize = int32(canonicalSize64)
    var canonical = rawbytes.BytesAlloc(canonicalSize)
    if rawbytes.BytesLen(canonical) != canonicalSize:
        rawbytes.BytesFree(canonical)
        return Err[str]("macho_provider_linker: provider proof allocation failed")
    var pos: int32
    for di in 0..<len(domain):
        rawbytes.BytesSet(canonical, pos + di, int32(domain[di]) & 255)
    pos = pos + len(domain)
    for i in 0..<lines.len:
        let line = lines[i]
        for li in 0..<len(line):
            rawbytes.BytesSet(canonical, pos + li, int32(line[li]) & 255)
        pos = pos + len(line)
        rawbytes.BytesSet(canonical, pos, 10)
        pos = pos + 1
    if pos != canonicalSize:
        rawbytes.BytesFree(canonical)
        return Err[str]("macho_provider_linker: provider proof canonical size mismatch")
    var digest = sha256.Sha256Digest(canonical)
    rawbytes.BytesFree(canonical)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return Err[str]("macho_provider_linker: provider proof sha256 failed")
    let digestText = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return Ok[str](digestText)

@borrows
fn MachoProviderProofReportLines(receipt: MachoProviderLinkReceipt): Result[str[]] =
    if receipt.providerProofSchema != MachoProviderProofSchema ||
       receipt.providerRelocationSchema != MachoProviderRelocationSchema ||
       receipt.programInputSchema != MachoProviderProgramInventorySchema ||
       !machoProviderSha256TextValid(receipt.providerProofSha256):
        return Err[str[]]("macho_provider_linker: invalid provider proof report receipt")
    let materialRes = machoProviderProofMaterialLines(receipt.programObjectCount,
                                                      receipt.providerObjectCount,
                                                      receipt.providerEvidenceSha256,
                                                      receipt.programInputs,
                                                      receipt.providerEvidence,
                                                      receipt.providerRelocations,
                                                      receipt.textSegmentEvidence,
                                                      receipt.dataSegmentEvidence,
                                                      receipt.dynamicImports,
                                                      receipt.staticUnresolvedCount)
    if !materialRes.ok:
        return Err[str[]](strings.CloneStr(materialRes.err.msg))
    let digestRes = machoProviderProofDigest(receipt.programObjectCount,
                                             receipt.providerObjectCount,
                                             receipt.providerEvidenceSha256,
                                             receipt.programInputs,
                                             receipt.providerEvidence,
                                             receipt.providerRelocations,
                                             receipt.textSegmentEvidence,
                                             receipt.dataSegmentEvidence,
                                             receipt.dynamicImports,
                                             receipt.staticUnresolvedCount)
    if !digestRes.ok:
        return Err[str[]](strings.CloneStr(digestRes.err.msg))
    if digestRes.value != receipt.providerProofSha256:
        return Err[str[]]("macho_provider_linker: provider proof report digest mismatch")
    let material = materialRes.value
    var lines: str[]
    for i in 0..<material.len:
        add(lines, strings.CloneStr(material[i]))
        if i == 0:
            add(lines, Fmt"provider_proof_sha256={receipt.providerProofSha256}")
    return Ok[str[]](lines)

@borrows
fn MachoProviderProofReportLinesMatch(actualLines: str[],
                                      receipt: MachoProviderLinkReceipt): bool =
    let expectedRes = MachoProviderProofReportLines(receipt)
    if !expectedRes.ok:
        return false
    let expected = expectedRes.value
    if actualLines.len != expected.len:
        return false
    for i in 0..<expected.len:
        if actualLines[i] != expected[i]:
            return false
    return true

@borrows
fn machoBuildProviderCommitment(out: var rawbytes.Bytes,
                                providerCount: int32,
                                contentSetDigest: rawbytes.Bytes,
                                evidenceDigest: rawbytes.Bytes,
                                proofDigest: rawbytes.Bytes): Result[bool] =
    if providerCount <= 0 ||
       rawbytes.BytesLen(out) != MachoProviderCommitmentSize ||
       rawbytes.BytesLen(contentSetDigest) != MachoCodeSignatureHashSize ||
       rawbytes.BytesLen(evidenceDigest) != MachoCodeSignatureHashSize ||
       rawbytes.BytesLen(proofDigest) != MachoCodeSignatureHashSize:
        return Err[bool]("macho_provider_linker: invalid provider commitment input")
    machoRawCopyStringAt(out, 0, "CHENGPVC")
    machoRawPutU32At(out, 8, MachoProviderCommitmentVersion)
    machoRawPutU32At(out, 12, MachoProviderCommitmentSha256)
    machoRawPutU32At(out, 16, uint32(MachoProviderCommitmentSize))
    machoRawPutU32At(out, 20, uint32(providerCount))
    machoRawCopyBytesAt(out,
                        MachoProviderCommitmentContentSetOffset,
                        contentSetDigest)
    machoRawCopyBytesAt(out,
                        MachoProviderCommitmentEvidenceOffset,
                        evidenceDigest)
    machoRawCopyBytesAt(out,
                        MachoProviderCommitmentProofOffset,
                        proofDigest)
    return Ok[bool](true)

@borrows
fn machoByteBufferU32BE(buf: bytes.ByteBuffer, off: int32): uint32 =
    let b0 = uint32(bytes.BufByteAt(buf, off) & 255)
    let b1 = uint32(bytes.BufByteAt(buf, off + 1) & 255)
    let b2 = uint32(bytes.BufByteAt(buf, off + 2) & 255)
    let b3 = uint32(bytes.BufByteAt(buf, off + 3) & 255)
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

@borrows
fn machoByteBufferRangeEqualsRaw(buf: bytes.ByteBuffer,
                                 off: int32,
                                 expected: rawbytes.Bytes): bool =
    let expectedLen = rawbytes.BytesLen(expected)
    if off < 0 || expectedLen < 0 ||
       uint64(off) + uint64(expectedLen) > uint64(buf.len):
        return false
    for i in 0..<expectedLen:
        if bytes.BufByteAt(buf, off + i) != rawbytes.BytesGet(expected, i):
            return false
    return true

@borrows
fn machoByteBufferRangeHex(buf: bytes.ByteBuffer,
                           off: int32,
                           size: int32): str =
    if off < 0 || size < 0 || off > buf.len || size > buf.len - off:
        return ""
    var exact = rawbytes.BytesAlloc(size)
    if rawbytes.BytesLen(exact) != size:
        rawbytes.BytesFree(exact)
        return ""
    for i in 0..<size:
        rawbytes.BytesSet(exact, i, bytes.BufByteAt(buf, off + i) & 255)
    let out = rawbytes.BytesToHex(exact)
    rawbytes.BytesFree(exact)
    return out

@borrows
fn machoByteBufferRangeSha256(buf: bytes.ByteBuffer,
                              off: int32,
                              size: int32): str =
    if off < 0 || size < 0 || off > buf.len || size > buf.len - off:
        return ""
    let all = rawbytes.BytesView(buf.data, buf.len)
    let exact = rawbytes.BytesSliceView(all, off, size)
    var digest = sha256.Sha256Digest(exact)
    if rawbytes.BytesLen(digest) != MachoCodeSignatureHashSize:
        rawbytes.BytesFree(digest)
        return ""
    let out = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return out

@borrows
fn machoByteBufferRangeEqualsSeq(buf: bytes.ByteBuffer,
                                 off: int32,
                                 expected: uint8[]): bool =
    if off < 0 || off > buf.len || expected.len > buf.len - off:
        return false
    for i in 0..<expected.len:
        if bytes.BufByteAt(buf, off + i) != int32(expected[i]):
            return false
    return true

@borrows
fn machoByteBufferFixedAsciiEquals(buf: bytes.ByteBuffer,
                                    off: int32,
                                    width: int32,
                                    expected: str): bool =
    if off < 0 || width < 0 || len(expected) > width ||
       uint64(off) + uint64(width) > uint64(buf.len):
        return false
    for i in 0..<width:
        var expectedByte: int32
        if i < len(expected):
            expectedByte = int32(expected[i]) & 255
        if bytes.BufByteAt(buf, off + i) != expectedByte:
            return false
    return true

@borrows
fn machoRawWriteSegment(out: var rawbytes.Bytes, pos: var int32, name: str, vmaddr: uint64, vmsize: uint64, fileoff: uint64, filesize: uint64, maxprot: int32, initprot: int32, nsects: int32) =
    machoRawPutU32At(out, pos, uint32(25))
    machoRawPutU32At(out, pos + 4, uint32(72 + nsects * 80))
    machoRawPaddedAsciiAt(out, pos + 8, name, 16)
    machoRawPutU64At(out, pos + 24, vmaddr)
    machoRawPutU64At(out, pos + 32, vmsize)
    machoRawPutU64At(out, pos + 40, fileoff)
    machoRawPutU64At(out, pos + 48, filesize)
    machoRawPutU32At(out, pos + 56, uint32(maxprot))
    machoRawPutU32At(out, pos + 60, uint32(initprot))
    machoRawPutU32At(out, pos + 64, uint32(nsects))
    pos = pos + 72

@borrows
fn machoRawWriteSection(out: var rawbytes.Bytes, pos: var int32, sect: str, seg: str, addr: uint64, size: uint64, offset: int32, align: int32, flags: uint32, reserved1: int32, reserved2: int32) =
    machoRawPaddedAsciiAt(out, pos, sect, 16)
    machoRawPaddedAsciiAt(out, pos + 16, seg, 16)
    machoRawPutU64At(out, pos + 32, addr)
    machoRawPutU64At(out, pos + 40, size)
    machoRawPutU32At(out, pos + 48, uint32(offset))
    machoRawPutU32At(out, pos + 52, uint32(align))
    machoRawPutU32At(out, pos + 64, flags)
    machoRawPutU32At(out, pos + 68, uint32(reserved1))
    machoRawPutU32At(out, pos + 72, uint32(reserved2))
    pos = pos + 80

fn machoProviderDylibPathForOrdinal(ordinal: int32): str =
    if ordinal == 1:
        return "/usr/lib/libSystem.B.dylib"
    if ordinal == 2:
        return "/usr/lib/libobjc.A.dylib"
    if ordinal == 3:
        return "/System/Library/Frameworks/Metal.framework/Metal"
    if ordinal == 4:
        return "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation"
    if ordinal == 5:
        return "/System/Library/Frameworks/CoreMedia.framework/CoreMedia"
    if ordinal == 6:
        return "/System/Library/Frameworks/CoreVideo.framework/CoreVideo"
    if ordinal == 7:
        return "/System/Library/Frameworks/VideoToolbox.framework/VideoToolbox"
    if ordinal == 8:
        return "/System/Library/Frameworks/AudioToolbox.framework/AudioToolbox"
    return ""

@borrows
fn machoProviderImportDylibCount(imports: str[]): int32 =
    var count: int32 = 1
    for i in 0..<imports.len:
        let ordinal = machoDarwinImportDylibOrdinal(imports[i])
        if ordinal > count:
            count = ordinal
    return count

@borrows
fn machoRawWriteDylibCommand(out: var rawbytes.Bytes, pos: var int32, path: str) =
    let cmdSize = machoAlignI32(24 + len(path) + 1, 8)
    for i in 0..<cmdSize:
        rawbytes.BytesSet(out, pos + i, 0)
    machoRawPutU32At(out, pos, MachoLoadDylib)
    machoRawPutU32At(out, pos + 4, uint32(cmdSize))
    machoRawPutU32At(out, pos + 8, uint32(24))
    machoRawPutU32At(out, pos + 12, uint32(2))
    machoRawPutU32At(out, pos + 16, uint32(0x10000))
    machoRawPutU32At(out, pos + 20, uint32(0x10000))
    machoRawCopyString0At(out, pos + 24, path)
    pos = pos + cmdSize

fn machoWriteEmbeddedAdhocSignature(out: var rawbytes.Bytes,
                                    codeLimit: int32,
                                    sigOff: int32,
                                    sigSize: int32): Result[bool] =
    let ident = "cheng.provider-linker"
    if codeLimit <= 0 || sigOff < codeLimit || sigSize <= 0 || sigOff + sigSize > rawbytes.BytesLen(out):
        return Err[bool]("macho_provider_linker: invalid embedded signature range")
    let codeSlots = (codeLimit + MachoCodeSignaturePageSize - 1) / MachoCodeSignaturePageSize
    let cdOff = 20
    let cdIdentOff = 44
    let cdHashOff = machoAlignI32(cdIdentOff + len(ident) + 1, 4)
    let cdLen = cdHashOff + codeSlots * MachoCodeSignatureHashSize
    if 20 + cdLen != sigSize:
        return Err[bool]("macho_provider_linker: embedded signature size mismatch")
    for i in 0..<sigSize:
        rawbytes.BytesSet(out, sigOff + i, 0)
    machoRawPutU32BEAt(out, sigOff, uint32(0xfade0cc0))
    machoRawPutU32BEAt(out, sigOff + 4, uint32(sigSize))
    machoRawPutU32BEAt(out, sigOff + 8, uint32(1))
    machoRawPutU32BEAt(out, sigOff + 12, uint32(0))
    machoRawPutU32BEAt(out, sigOff + 16, uint32(cdOff))

    let cdBase = sigOff + cdOff
    machoRawPutU32BEAt(out, cdBase, uint32(0xfade0c02))
    machoRawPutU32BEAt(out, cdBase + 4, uint32(cdLen))
    machoRawPutU32BEAt(out, cdBase + 8, uint32(0x00020001))
    machoRawPutU32BEAt(out, cdBase + 12, uint32(0x00000002))
    machoRawPutU32BEAt(out, cdBase + 16, uint32(cdHashOff))
    machoRawPutU32BEAt(out, cdBase + 20, uint32(cdIdentOff))
    machoRawPutU32BEAt(out, cdBase + 24, uint32(0))
    machoRawPutU32BEAt(out, cdBase + 28, uint32(codeSlots))
    machoRawPutU32BEAt(out, cdBase + 32, uint32(codeLimit))
    rawbytes.BytesSet(out, cdBase + 36, MachoCodeSignatureHashSize)
    rawbytes.BytesSet(out, cdBase + 37, 2)
    rawbytes.BytesSet(out, cdBase + 38, 0)
    rawbytes.BytesSet(out, cdBase + 39, MachoCodeSignaturePageSizeLog2)
    machoRawPutU32BEAt(out, cdBase + 40, uint32(0))
    machoRawCopyString0At(out, cdBase + cdIdentOff, ident)

    for slot in 0..<codeSlots:
        let pageOff = slot * MachoCodeSignaturePageSize
        var pageLen = codeLimit - pageOff
        if pageLen > MachoCodeSignaturePageSize:
            pageLen = MachoCodeSignaturePageSize
        if pageLen < 0:
            pageLen = 0
        let page = rawbytes.BytesSliceView(out, pageOff, pageLen)
        var digest = sha256.Sha256Digest(page)
        machoRawCopyBytesAt(out, cdBase + cdHashOff + slot * MachoCodeSignatureHashSize, digest)
        rawbytes.BytesFree(digest)
    return Ok[bool](true)

@borrows
fn machoCloneStrSeq(src: str[]): str[] =
    var out: str[]
    for i in 0..<src.len:
        add(out, strings.CloneStr(src[i]))
    return out

@borrows
fn machoCloneProviderEvidence(src: MachoProviderEvidence): MachoProviderEvidence =
    var out: MachoProviderEvidence
    out.providerIndex = src.providerIndex
    out.inputCanonicalPath = strings.CloneStr(src.inputCanonicalPath)
    out.inputContentSha256 = strings.CloneStr(src.inputContentSha256)
    out.inputSize = src.inputSize
    out.definedRoots = machoCloneStrSeq(src.definedRoots)
    out.relocationResolvedRoots = machoCloneStrSeq(src.relocationResolvedRoots)
    out.textFileOffset = src.textFileOffset
    out.textSize = src.textSize
    out.textPostRelocationSha256 = strings.CloneStr(src.textPostRelocationSha256)
    out.dataFileOffset = src.dataFileOffset
    out.dataSize = src.dataSize
    out.dataPostRelocationSha256 = strings.CloneStr(src.dataPostRelocationSha256)
    return out

@borrows
fn machoCloneProgramInputEvidence(src: MachoProviderProgramInputEvidence): MachoProviderProgramInputEvidence =
    var out: MachoProviderProgramInputEvidence
    out.programIndex = src.programIndex
    out.inputCanonicalPath = strings.CloneStr(src.inputCanonicalPath)
    out.inputContentSha256 = strings.CloneStr(src.inputContentSha256)
    out.inputSize = src.inputSize
    return out

@borrows
fn machoCloneRelocationEvidence(src: MachoProviderRelocationEvidence): MachoProviderRelocationEvidence =
    var out: MachoProviderRelocationEvidence
    out.relocationIndex = src.relocationIndex
    out.originObjectKind = strings.CloneStr(src.originObjectKind)
    out.originObjectIndex = src.originObjectIndex
    out.originCanonicalPath = strings.CloneStr(src.originCanonicalPath)
    out.originContentSha256 = strings.CloneStr(src.originContentSha256)
    out.originSectionIdentity = strings.CloneStr(src.originSectionIdentity)
    out.relocationOrdinal = src.relocationOrdinal
    out.relocationType = src.relocationType
    out.relocationAddress = src.relocationAddress
    out.relocationPcrel = src.relocationPcrel
    out.relocationLength = src.relocationLength
    out.relocationExtern = src.relocationExtern
    out.targetRootKind = strings.CloneStr(src.targetRootKind)
    out.targetObjectKind = strings.CloneStr(src.targetObjectKind)
    out.targetObjectIndex = src.targetObjectIndex
    out.targetDylibOrdinal = src.targetDylibOrdinal
    out.targetSymbol = strings.CloneStr(src.targetSymbol)
    out.finalPatchFileOffset = src.finalPatchFileOffset
    out.patchedByteWidth = src.patchedByteWidth
    out.patchedValueContract = strings.CloneStr(src.patchedValueContract)
    out.patchedBytesHex = strings.CloneStr(src.patchedBytesHex)
    out.patchedBytesSha256 = strings.CloneStr(src.patchedBytesSha256)
    return out

@borrows
fn machoCloneDynamicImportEvidence(src: MachoProviderDynamicImportEvidence): MachoProviderDynamicImportEvidence =
    var out: MachoProviderDynamicImportEvidence
    out.importIndex = src.importIndex
    out.dylibOrdinal = src.dylibOrdinal
    out.dylibPath = strings.CloneStr(src.dylibPath)
    out.symbol = strings.CloneStr(src.symbol)
    out.nlistIndex = src.nlistIndex
    out.nlistFileOffset = src.nlistFileOffset
    out.nlistEntrySha256 = strings.CloneStr(src.nlistEntrySha256)
    out.bindRecordOrdinal = src.bindRecordOrdinal
    out.bindRecordFileOffset = src.bindRecordFileOffset
    out.bindRecordSize = src.bindRecordSize
    out.bindRecordSha256 = strings.CloneStr(src.bindRecordSha256)
    out.stubFileOffset = src.stubFileOffset
    out.stubSize = src.stubSize
    out.stubPostRelocationSha256 = strings.CloneStr(src.stubPostRelocationSha256)
    out.gotFileOffset = src.gotFileOffset
    out.gotSize = src.gotSize
    out.gotValueContract = strings.CloneStr(src.gotValueContract)
    out.gotInitialSha256 = strings.CloneStr(src.gotInitialSha256)
    return out

@borrows
fn machoVerifyProviderBindingRaw(outputPath: str,
                                 targetTriple: str,
                                 programObjectCount: int32,
                                 providerObjectCount: int32,
                                 expectedContentSetDigest: rawbytes.Bytes,
                                 expectedEvidence: MachoProviderEvidence[],
                                 expectedProgramInputs: MachoProviderProgramInputEvidence[],
                                 expectedRelocations: MachoProviderRelocationEvidence[],
                                 expectedTextSegment: MachoProviderSegmentEvidence,
                                 expectedDataSegment: MachoProviderSegmentEvidence,
                                 expectedImports: MachoProviderDynamicImportEvidence[],
                                 expectedStaticUnresolvedCount: int32,
                                 requireEvidence: bool): Result[MachoProviderLinkReceipt] =
    if targetTriple != "arm64-apple-darwin" ||
       programObjectCount < 0 || providerObjectCount <= 0 ||
       (requireEvidence && expectedEvidence.len != providerObjectCount) ||
       (requireEvidence && expectedProgramInputs.len != programObjectCount) ||
       (requireEvidence && expectedStaticUnresolvedCount != 0) ||
       rawbytes.BytesLen(expectedContentSetDigest) != MachoCodeSignatureHashSize:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid expected provider receipt")
    var fileSnapshotBefore: MachoProviderFileSnapshot
    if !machoProviderFileSnapshotStat(outputPath, fileSnapshotBefore):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final executable identity unavailable")
    var fileBytes = bytes.ReadFileBytes(fileSnapshotBefore.canonicalPath)
    defer:
        bytes.FreeByteBuffer(fileBytes)
    if fileBytes.data == nil || fileBytes.len < 32 || !machoMagic64Matches(fileBytes):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final executable readback failed")
    if uint32(machoReadI32LE(fileBytes, 4)) != MachoCpuTypeA64 ||
       machoReadI32LE(fileBytes, 8) != 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final artifact is not arm64 Mach-O")
    if machoReadI32LE(fileBytes, 12) != int32(MachoFileTypeExecute):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final artifact is not executable Mach-O")
    let ncmds = machoReadI32LE(fileBytes, 16)
    let sizeofcmds = machoReadI32LE(fileBytes, 20)
    if ncmds <= 0 || sizeofcmds <= 0 || ncmds > sizeofcmds / 8 ||
       uint64(32) + uint64(sizeofcmds) > uint64(fileBytes.len):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid final load-command table")
    let commandTableEnd = 32 + sizeofcmds

    var noteCount: int32
    var providerNoteCount: int32
    var noteOffset: int32 = -1
    var noteSize: int32
    var codeSignatureCount: int32
    var codeSignatureOffset: int32 = -1
    var codeSignatureSize: int32
    var linkeditCount: int32
    var linkeditOffset: int32 = -1
    var linkeditSize: int32
    var textSegmentCount: int32
    var textSegmentFileOffset: int64 = -1
    var textSegmentFileSize: int64
    var textSegmentVmAddress: uint64
    var textSegmentVmSize: uint64
    var dataSegmentCount: int32
    var dataSegmentFileOffset: int64 = -1
    var dataSegmentFileSize: int64
    var dataSegmentVmAddress: uint64
    var dataSegmentVmSize: uint64
    var textSectionCount: int32
    var textSectionFileOffset: int64 = -1
    var textSectionFileSize: int64
    var stubsSectionCount: int32
    var stubsSectionFileOffset: int64 = -1
    var stubsSectionFileSize: int64
    var gotSectionCount: int32
    var gotSectionFileOffset: int64 = -1
    var gotSectionFileSize: int64
    var dyldInfoCount: int32
    var bindOffset: int32 = -1
    var bindSize: int32
    var symtabCount: int32
    var symOffset: int32 = -1
    var symbolCount: int32
    var stringOffset: int32 = -1
    var stringSize: int32
    var dylibPaths: str[]
    var cmdPos: int32 = 32
    for _ in 0..<ncmds:
        if uint64(cmdPos) + uint64(8) > uint64(commandTableEnd):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: truncated final load command")
        let cmd = uint32(machoReadI32LE(fileBytes, cmdPos))
        let cmdSize = machoReadI32LE(fileBytes, cmdPos + 4)
        if cmdSize < 8 ||
           uint64(cmdPos) + uint64(cmdSize) > uint64(commandTableEnd):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid final load command size")
        if cmd == MachoLoadSegment64:
            if cmdSize < 72:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid final segment command")
            let sectionCount = machoReadI32LE(fileBytes, cmdPos + 64)
            if sectionCount < 0 || sectionCount > (cmdSize - 72) / 80 ||
               cmdSize != 72 + sectionCount * 80:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid final segment section table")
            let segmentVmAddress = machoU64(fileBytes, cmdPos + 24)
            let segmentVmSize = machoU64(fileBytes, cmdPos + 32)
            let segmentFileOffset = machoU64(fileBytes, cmdPos + 40)
            let segmentFileSize = machoU64(fileBytes, cmdPos + 48)
            if machoByteBufferFixedAsciiEquals(fileBytes, cmdPos + 8, 16, "__TEXT"):
                textSegmentCount = textSegmentCount + 1
                if segmentFileOffset > uint64(MachoProviderMaxInt64) ||
                   segmentFileSize > uint64(MachoProviderMaxInt64):
                    return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __TEXT range too large")
                textSegmentFileOffset = int64(segmentFileOffset)
                textSegmentFileSize = int64(segmentFileSize)
                textSegmentVmAddress = segmentVmAddress
                textSegmentVmSize = segmentVmSize
                for sectionIndex in 0..<sectionCount:
                    let sectionOffset = cmdPos + 72 + sectionIndex * 80
                    let sectionSize = machoU64(fileBytes, sectionOffset + 40)
                    let sectionFileOffset = uint64(machoU32(fileBytes,
                                                           sectionOffset + 48))
                    if sectionSize > uint64(MachoProviderMaxInt64):
                        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __TEXT section too large")
                    if machoByteBufferFixedAsciiEquals(fileBytes,
                                                       sectionOffset,
                                                       16,
                                                       "__text"):
                        textSectionCount = textSectionCount + 1
                        textSectionFileOffset = int64(sectionFileOffset)
                        textSectionFileSize = int64(sectionSize)
                    elif machoByteBufferFixedAsciiEquals(fileBytes,
                                                         sectionOffset,
                                                         16,
                                                         "__stubs"):
                        stubsSectionCount = stubsSectionCount + 1
                        stubsSectionFileOffset = int64(sectionFileOffset)
                        stubsSectionFileSize = int64(sectionSize)
            elif machoByteBufferFixedAsciiEquals(fileBytes, cmdPos + 8, 16, "__DATA"):
                dataSegmentCount = dataSegmentCount + 1
                if segmentFileOffset > uint64(MachoProviderMaxInt64) ||
                   segmentFileSize > uint64(MachoProviderMaxInt64):
                    return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __DATA range too large")
                dataSegmentFileOffset = int64(segmentFileOffset)
                dataSegmentFileSize = int64(segmentFileSize)
                dataSegmentVmAddress = segmentVmAddress
                dataSegmentVmSize = segmentVmSize
                for sectionIndex in 0..<sectionCount:
                    let sectionOffset = cmdPos + 72 + sectionIndex * 80
                    let sectionSize = machoU64(fileBytes, sectionOffset + 40)
                    let sectionFileOffset = uint64(machoU32(fileBytes,
                                                           sectionOffset + 48))
                    if sectionSize > uint64(MachoProviderMaxInt64):
                        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __DATA section too large")
                    if machoByteBufferFixedAsciiEquals(fileBytes,
                                                       sectionOffset,
                                                       16,
                                                       "__got"):
                        gotSectionCount = gotSectionCount + 1
                        gotSectionFileOffset = int64(sectionFileOffset)
                        gotSectionFileSize = int64(sectionSize)
            elif machoByteBufferFixedAsciiEquals(fileBytes,
                                                 cmdPos + 8,
                                                 16,
                                                 "__LINKEDIT"):
                linkeditCount = linkeditCount + 1
                let fileOffset64 = segmentFileOffset
                let fileSize64 = segmentFileSize
                if fileOffset64 > uint64(2147483647) || fileSize64 > uint64(2147483647):
                    return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __LINKEDIT range too large")
                linkeditOffset = int32(fileOffset64)
                linkeditSize = int32(fileSize64)
                if machoReadI32LE(fileBytes, cmdPos + 56) != 1 ||
                   machoReadI32LE(fileBytes, cmdPos + 60) != 1 ||
                   machoReadI32LE(fileBytes, cmdPos + 64) != 0:
                    return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __LINKEDIT protection contract mismatch")
        elif cmd == MachoLoadDyldInfo:
            if cmdSize != 48:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid LC_DYLD_INFO_ONLY size")
            dyldInfoCount = dyldInfoCount + 1
            bindOffset = machoReadI32LE(fileBytes, cmdPos + 16)
            bindSize = machoReadI32LE(fileBytes, cmdPos + 20)
        elif cmd == MachoLoadSymtab:
            if cmdSize != 24:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid LC_SYMTAB size")
            symtabCount = symtabCount + 1
            symOffset = machoReadI32LE(fileBytes, cmdPos + 8)
            symbolCount = machoReadI32LE(fileBytes, cmdPos + 12)
            stringOffset = machoReadI32LE(fileBytes, cmdPos + 16)
            stringSize = machoReadI32LE(fileBytes, cmdPos + 20)
        elif cmd == MachoLoadDylib:
            if cmdSize < 25:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid LC_LOAD_DYLIB size")
            let pathOffset = machoReadI32LE(fileBytes, cmdPos + 8)
            if pathOffset < 24 || pathOffset >= cmdSize:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid LC_LOAD_DYLIB path")
            let dylibPath = machoReadCString(fileBytes,
                                             uint64(cmdPos + pathOffset),
                                             uint64(cmdSize - pathOffset))
            if len(dylibPath) <= 0:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: empty LC_LOAD_DYLIB path")
            add(dylibPaths, dylibPath)
        elif cmd == MachoLoadNote:
            if cmdSize != 40:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid provider LC_NOTE size")
            noteCount = noteCount + 1
            if machoByteBufferFixedAsciiEquals(fileBytes,
                                                cmdPos + 8,
                                                16,
                                                MachoProviderNoteOwner):
                providerNoteCount = providerNoteCount + 1
                let noteOffset64 = machoU64(fileBytes, cmdPos + 24)
                let noteSize64 = machoU64(fileBytes, cmdPos + 32)
                if noteOffset64 > uint64(2147483647) || noteSize64 > uint64(2147483647):
                    return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider LC_NOTE range too large")
                noteOffset = int32(noteOffset64)
                noteSize = int32(noteSize64)
        elif cmd == MachoLoadCodeSignature:
            if cmdSize != 16:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid LC_CODE_SIGNATURE size")
            codeSignatureCount = codeSignatureCount + 1
            codeSignatureOffset = machoReadI32LE(fileBytes, cmdPos + 8)
            codeSignatureSize = machoReadI32LE(fileBytes, cmdPos + 12)
        cmdPos = cmdPos + cmdSize
    if cmdPos != commandTableEnd:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final load-command size mismatch")
    if textSegmentCount != 1 || textSectionCount != 1 ||
       stubsSectionCount > 1 || gotSectionCount > 1 ||
       dataSegmentCount > 1 || linkeditCount != 1 ||
       noteCount != 1 || providerNoteCount != 1 || codeSignatureCount != 1 ||
       dyldInfoCount != 1 || symtabCount != 1:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider binding requires unique __LINKEDIT, LC_NOTE and LC_CODE_SIGNATURE")
    if !machoProviderRangeWithin(textSegmentFileOffset,
                                 textSegmentFileSize,
                                 int64(fileBytes.len)) ||
       !machoProviderRangeWithin(textSectionFileOffset,
                                 textSectionFileSize,
                                 int64(fileBytes.len)) ||
       textSectionFileOffset < textSegmentFileOffset ||
       textSectionFileSize > textSegmentFileOffset + textSegmentFileSize -
                             textSectionFileOffset ||
       (stubsSectionCount == 1 &&
        (!machoProviderRangeWithin(stubsSectionFileOffset,
                                   stubsSectionFileSize,
                                   int64(fileBytes.len)) ||
         stubsSectionFileOffset < textSegmentFileOffset ||
         stubsSectionFileSize > textSegmentFileOffset + textSegmentFileSize -
                                stubsSectionFileOffset)) ||
       (dataSegmentCount == 1 &&
        !machoProviderRangeWithin(dataSegmentFileOffset,
                                  dataSegmentFileSize,
                                  int64(fileBytes.len))) ||
       (gotSectionCount == 1 &&
        (!machoProviderRangeWithin(gotSectionFileOffset,
                                   gotSectionFileSize,
                                   int64(fileBytes.len)) ||
         dataSegmentCount != 1 ||
         gotSectionFileOffset < dataSegmentFileOffset ||
         gotSectionFileSize > dataSegmentFileOffset + dataSegmentFileSize -
                              gotSectionFileOffset)):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final segment range invalid")
    if bindOffset < 0 || bindSize <= 0 || bindOffset > fileBytes.len ||
       bindSize > fileBytes.len - bindOffset ||
       symOffset < 0 || symbolCount < 0 || stringOffset < 0 || stringSize <= 0 ||
       symOffset > fileBytes.len || symbolCount > (fileBytes.len - symOffset) / 16 ||
       stringOffset > fileBytes.len || stringSize > fileBytes.len - stringOffset:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final dynamic metadata range invalid")
    if linkeditOffset < 0 || linkeditSize <= 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __LINKEDIT range invalid")
    let linkeditEnd = uint64(linkeditOffset) + uint64(linkeditSize)
    if linkeditEnd != uint64(fileBytes.len):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __LINKEDIT range invalid")
    if noteOffset < linkeditOffset || noteSize != MachoProviderCommitmentSize ||
       uint64(noteOffset) + uint64(noteSize) > linkeditEnd:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider commitment is outside __LINKEDIT")
    if codeSignatureOffset < linkeditOffset || codeSignatureSize <= 0 ||
       uint64(codeSignatureOffset) + uint64(codeSignatureSize) > linkeditEnd ||
       uint64(codeSignatureOffset) + uint64(codeSignatureSize) != uint64(fileBytes.len):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: code signature is outside __LINKEDIT")
    if uint64(noteOffset) + uint64(noteSize) > uint64(codeSignatureOffset):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider commitment is not covered by CodeDirectory")

    let sigBase = codeSignatureOffset
    if codeSignatureSize < 20 || machoByteBufferU32BE(fileBytes, sigBase) != uint32(0xfade0cc0):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid embedded signature superblob")
    let superBlobSizeRaw = machoByteBufferU32BE(fileBytes, sigBase + 4)
    let superBlobCountRaw = machoByteBufferU32BE(fileBytes, sigBase + 8)
    if superBlobSizeRaw != uint32(codeSignatureSize) || superBlobCountRaw != uint32(1):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid embedded signature index")
    if machoByteBufferU32BE(fileBytes, sigBase + 12) != uint32(0):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: embedded signature lacks primary CodeDirectory")
    let codeDirectoryRelativeRaw = machoByteBufferU32BE(fileBytes, sigBase + 16)
    if codeDirectoryRelativeRaw != uint32(20):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid embedded CodeDirectory offset")
    let codeDirectoryBase = sigBase + 20
    if uint64(codeDirectoryBase) + uint64(44) >
       uint64(sigBase) + uint64(codeSignatureSize) ||
       machoByteBufferU32BE(fileBytes, codeDirectoryBase) != uint32(0xfade0c02):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid embedded CodeDirectory")
    let codeDirectorySizeRaw = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 4)
    let codeDirectoryVersion = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 8)
    let codeDirectoryFlags = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 12)
    let hashOffsetRaw = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 16)
    let identifierOffsetRaw = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 20)
    let specialSlotsRaw = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 24)
    let codeSlotsRaw = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 28)
    let codeLimitRaw = machoByteBufferU32BE(fileBytes, codeDirectoryBase + 32)
    let hashSize = bytes.BufByteAt(fileBytes, codeDirectoryBase + 36)
    let hashType = bytes.BufByteAt(fileBytes, codeDirectoryBase + 37)
    let platform = bytes.BufByteAt(fileBytes, codeDirectoryBase + 38)
    let pageSizeLog2 = bytes.BufByteAt(fileBytes, codeDirectoryBase + 39)
    let expectedCodeSlots64 = (uint64(codeSignatureOffset) +
                               uint64(MachoCodeSignaturePageSize - 1)) /
                              uint64(MachoCodeSignaturePageSize)
    let expectedHashOffset = machoAlignI32(44 + len("cheng.provider-linker") + 1, 4)
    if codeDirectorySizeRaw < uint32(44) ||
       uint64(codeDirectoryBase) + uint64(codeDirectorySizeRaw) !=
       uint64(sigBase) + uint64(codeSignatureSize) ||
       codeDirectoryVersion != uint32(0x00020001) ||
       codeDirectoryFlags != uint32(0x00000002) || specialSlotsRaw != uint32(0) ||
       codeLimitRaw != uint32(codeSignatureOffset) ||
       uint64(codeSlotsRaw) != expectedCodeSlots64 ||
       hashSize != MachoCodeSignatureHashSize || hashType != 2 ||
       platform != 0 || pageSizeLog2 != MachoCodeSignaturePageSizeLog2 ||
       identifierOffsetRaw != uint32(44) ||
       hashOffsetRaw != uint32(expectedHashOffset) ||
       uint64(hashOffsetRaw) +
       uint64(codeSlotsRaw) * uint64(MachoCodeSignatureHashSize) !=
       uint64(codeDirectorySizeRaw) ||
       machoByteBufferU32BE(fileBytes, codeDirectoryBase + 40) != uint32(0):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: CodeDirectory contract mismatch")
    if !machoByteBufferFixedAsciiEquals(fileBytes,
                                        codeDirectoryBase + 44,
                                        expectedHashOffset - 44,
                                        "cheng.provider-linker"):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: CodeDirectory identifier mismatch")
    let codeDirectorySize = int32(codeDirectorySizeRaw)
    let hashOffset = int32(hashOffsetRaw)
    let codeSlots = int32(codeSlotsRaw)
    let codeLimit = int32(codeLimitRaw)
    for slot in 0..<codeSlots:
        let pageOffset = slot * MachoCodeSignaturePageSize
        var pageSize = codeLimit - pageOffset
        if pageSize > MachoCodeSignaturePageSize:
            pageSize = MachoCodeSignaturePageSize
        if pageSize <= 0:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid CodeDirectory page range")
        let pageView = rawbytes.BytesView(fileBytes.data, fileBytes.len)
        let exactPage = rawbytes.BytesSliceView(pageView, pageOffset, pageSize)
        var pageDigest = sha256.Sha256Digest(exactPage)
        let digestOffset = codeDirectoryBase + hashOffset + slot * MachoCodeSignatureHashSize
        let pageMatches = machoByteBufferRangeEqualsRaw(fileBytes, digestOffset, pageDigest)
        rawbytes.BytesFree(pageDigest)
        if !pageMatches:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: CodeDirectory page hash mismatch")

    if !machoByteBufferFixedAsciiEquals(fileBytes, noteOffset, 8, "CHENGPVC") ||
       uint32(machoReadI32LE(fileBytes, noteOffset + 8)) != MachoProviderCommitmentVersion ||
       uint32(machoReadI32LE(fileBytes, noteOffset + 12)) != MachoProviderCommitmentSha256 ||
       machoReadI32LE(fileBytes, noteOffset + 16) != MachoProviderCommitmentSize ||
       machoReadI32LE(fileBytes, noteOffset + 20) != providerObjectCount ||
       !machoByteBufferRangeEqualsRaw(
           fileBytes,
           noteOffset + MachoProviderCommitmentContentSetOffset,
           expectedContentSetDigest):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider commitment readback mismatch")
    var evidenceDigestText = machoByteBufferRangeHex(fileBytes,
                                                      noteOffset + MachoProviderCommitmentEvidenceOffset,
                                                      MachoCodeSignatureHashSize)
    var proofDigestText = machoByteBufferRangeHex(fileBytes,
                                                  noteOffset + MachoProviderCommitmentProofOffset,
                                                  MachoCodeSignatureHashSize)
    if !machoProviderSha256TextValid(evidenceDigestText):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence digest readback failed")
    if !machoProviderSha256TextValid(proofDigestText):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider proof digest readback failed")
    if requireEvidence:
        let contentFromEvidenceRes = machoProviderContentSetDigestFromEvidence(expectedEvidence)
        if !contentFromEvidenceRes.ok:
            return Err[MachoProviderLinkReceipt](strings.CloneStr(contentFromEvidenceRes.err.msg))
        if contentFromEvidenceRes.value != rawbytes.BytesToHex(expectedContentSetDigest):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence content-set mismatch")
        let evidenceDigestRes = machoProviderEvidenceDigest(expectedEvidence)
        if !evidenceDigestRes.ok:
            return Err[MachoProviderLinkReceipt](strings.CloneStr(evidenceDigestRes.err.msg))
        if evidenceDigestRes.value != evidenceDigestText:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence commitment mismatch")
        for i in 0..<expectedEvidence.len:
            let item = expectedEvidence[i]
            if item.providerIndex != i ||
               !machoProviderRangeWithin(item.textFileOffset,
                                         item.textSize,
                                         int64(codeLimit)) ||
               item.textSize == int64(0):
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider text evidence range invalid index={i}")
            let textHash = machoByteBufferRangeSha256(fileBytes,
                                                      int32(item.textFileOffset),
                                                      int32(item.textSize))
            if textHash != item.textPostRelocationSha256:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider text evidence hash mismatch index={i}")
            if item.dataSize == int64(0):
                if item.dataFileOffset != int64(-1):
                    return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider empty data evidence range invalid index={i}")
            else:
                if !machoProviderRangeWithin(item.dataFileOffset,
                                             item.dataSize,
                                             int64(codeLimit)):
                    return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider data evidence range invalid index={i}")
                let dataHash = machoByteBufferRangeSha256(fileBytes,
                                                          int32(item.dataFileOffset),
                                                          int32(item.dataSize))
                if dataHash != item.dataPostRelocationSha256:
                    return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider data evidence hash mismatch index={i}")

        if expectedTextSegment.segmentName != "__TEXT" ||
           expectedTextSegment.fileOffset != textSegmentFileOffset ||
           expectedTextSegment.fileSize != textSegmentFileSize ||
           expectedTextSegment.vmAddress != textSegmentVmAddress ||
           expectedTextSegment.vmSize != textSegmentVmSize ||
           machoByteBufferRangeSha256(fileBytes,
                                      int32(textSegmentFileOffset),
                                      int32(textSegmentFileSize)) !=
               expectedTextSegment.postRelocationSha256:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __TEXT proof mismatch")
        if expectedDataSegment.fileSize == int64(0):
            if dataSegmentCount != 0 || expectedDataSegment.segmentName != "__DATA" ||
               expectedDataSegment.fileOffset != int64(-1) ||
               expectedDataSegment.vmAddress != uint64(0) ||
               expectedDataSegment.vmSize != uint64(0) ||
               machoByteBufferRangeSha256(fileBytes, 0, 0) !=
                   expectedDataSegment.postRelocationSha256:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: final empty __DATA proof mismatch")
        else:
            if dataSegmentCount != 1 || expectedDataSegment.segmentName != "__DATA" ||
               expectedDataSegment.fileOffset != dataSegmentFileOffset ||
               expectedDataSegment.fileSize != dataSegmentFileSize ||
               expectedDataSegment.vmAddress != dataSegmentVmAddress ||
               expectedDataSegment.vmSize != dataSegmentVmSize ||
               machoByteBufferRangeSha256(fileBytes,
                                          int32(dataSegmentFileOffset),
                                          int32(dataSegmentFileSize)) !=
                   expectedDataSegment.postRelocationSha256:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: final __DATA proof mismatch")
        let proofDigestRes = machoProviderProofDigest(programObjectCount,
                                                      providerObjectCount,
                                                      evidenceDigestText,
                                                      expectedProgramInputs,
                                                      expectedEvidence,
                                                      expectedRelocations,
                                                      expectedTextSegment,
                                                      expectedDataSegment,
                                                      expectedImports,
                                                      expectedStaticUnresolvedCount)
        if !proofDigestRes.ok:
            return Err[MachoProviderLinkReceipt](strings.CloneStr(proofDigestRes.err.msg))
        if proofDigestRes.value != proofDigestText:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider proof commitment mismatch")
        for i in 0..<expectedRelocations.len:
            let item = expectedRelocations[i]
            if !machoProviderRangeWithin(item.finalPatchFileOffset,
                                         item.patchedByteWidth,
                                         int64(codeLimit)) ||
               item.finalPatchFileOffset < textSectionFileOffset ||
               item.patchedByteWidth >
                   textSectionFileOffset + textSectionFileSize -
                   item.finalPatchFileOffset:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: relocation readback range mismatch index={i}")
            let patchOffset = int32(item.finalPatchFileOffset)
            let patchWidth = int32(item.patchedByteWidth)
            if machoByteBufferRangeHex(fileBytes, patchOffset, patchWidth) !=
                   item.patchedBytesHex ||
               machoByteBufferRangeSha256(fileBytes, patchOffset, patchWidth) !=
                   item.patchedBytesSha256:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: relocation patch readback mismatch index={i}")
        if expectedImports.len != symbolCount || dylibPaths.len <= 0:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: dynamic import proof cardinality mismatch")
        if expectedImports.len == 0:
            if stubsSectionCount != 0 || gotSectionCount != 0:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: unexpected empty import sections")
        else:
            if stubsSectionCount != 1 || gotSectionCount != 1 ||
               stubsSectionFileSize != int64(expectedImports.len) * int64(12) ||
               gotSectionFileSize != int64(expectedImports.len) * int64(8):
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: dynamic import section proof mismatch")
        var expectedBindRecordOffset = bindOffset
        for i in 0..<expectedImports.len:
            let item = expectedImports[i]
            let expectedBindRecord = machoBuildBindRecord(
                item.symbol,
                2,
                int32(item.gotFileOffset - dataSegmentFileOffset))
            if item.dylibOrdinal <= 0 || item.dylibOrdinal > dylibPaths.len ||
               dylibPaths[item.dylibOrdinal - 1] != item.dylibPath ||
               item.nlistIndex != i ||
               item.nlistFileOffset != int64(symOffset) + int64(i) * int64(16) ||
               item.bindRecordOrdinal != i ||
               item.bindRecordFileOffset != int64(expectedBindRecordOffset) ||
               item.bindRecordSize != int64(expectedBindRecord.len) ||
               item.stubFileOffset != stubsSectionFileOffset + int64(i) * int64(12) ||
               item.stubSize != int64(12) ||
               item.gotFileOffset != gotSectionFileOffset + int64(i) * int64(8) ||
               item.gotSize != int64(8):
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic import layout proof mismatch index={i}")
            if machoByteBufferRangeSha256(fileBytes,
                                          int32(item.nlistFileOffset),
                                          16) != item.nlistEntrySha256 ||
               !machoByteBufferRangeEqualsSeq(fileBytes,
                                              expectedBindRecordOffset,
                                              expectedBindRecord) ||
               machoByteBufferRangeSha256(fileBytes,
                                          expectedBindRecordOffset,
                                          expectedBindRecord.len) !=
                   item.bindRecordSha256 ||
               machoByteBufferRangeSha256(fileBytes,
                                          int32(item.stubFileOffset),
                                          int32(item.stubSize)) !=
                   item.stubPostRelocationSha256 ||
               machoByteBufferRangeSha256(fileBytes,
                                          int32(item.gotFileOffset),
                                          int32(item.gotSize)) !=
                   item.gotInitialSha256:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic import byte proof mismatch index={i}")
            let stubVmAddress = textSegmentVmAddress + uint64(item.stubFileOffset)
            let gotVmAddress = dataSegmentVmAddress +
                               uint64(item.gotFileOffset - dataSegmentFileOffset)
            if uint32(machoReadI32LE(fileBytes,
                                       int32(item.stubFileOffset))) !=
                   machoA64Adrp(uint32(16), stubVmAddress, gotVmAddress) ||
               uint32(machoReadI32LE(fileBytes,
                                       int32(item.stubFileOffset) + 4)) !=
                   machoA64LdrX(uint32(16),
                                uint32(16),
                                uint32(gotVmAddress & uint64(0xfff))) ||
               uint32(machoReadI32LE(fileBytes,
                                       int32(item.stubFileOffset) + 8)) !=
                   uint32(0xd61f0200):
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic import stub contract mismatch index={i}")
            for gotByte in 0..<int32(item.gotSize):
                if bytes.BufByteAt(fileBytes,
                                   int32(item.gotFileOffset +
                                         int64(gotByte))) != 0:
                    return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic import GOT contract mismatch index={i}")
            let nlistOffset = symOffset + i * 16
            let stringIndex = machoReadI32LE(fileBytes, nlistOffset)
            if stringIndex <= 0 || stringIndex >= stringSize ||
               bytes.BufByteAt(fileBytes, nlistOffset + 4) !=
                   (MachoNTypeUndef | MachoNTypeExt) ||
               bytes.BufByteAt(fileBytes, nlistOffset + 5) != 0 ||
               machoU16(fileBytes, nlistOffset + 6) != item.dylibOrdinal * 256 ||
               machoU64(fileBytes, nlistOffset + 8) != uint64(0) ||
               machoReadCString(fileBytes,
                                uint64(stringOffset + stringIndex),
                                uint64(stringSize - stringIndex)) != item.symbol:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic import nlist proof mismatch index={i}")
            expectedBindRecordOffset = expectedBindRecordOffset +
                                       expectedBindRecord.len
        var expectedImportSymbols: str[]
        for i in 0..<expectedImports.len:
            add(expectedImportSymbols, strings.CloneStr(expectedImports[i].symbol))
        var expectedGotBaseOffset: int32
        if expectedImports.len > 0:
            expectedGotBaseOffset = int32(expectedImports[0].gotFileOffset -
                                          dataSegmentFileOffset)
        let expectedBindInfo = machoBuildBindInfo(expectedImportSymbols,
                                                  2,
                                                  expectedGotBaseOffset)
        if bindSize != expectedBindInfo.len ||
           !machoByteBufferRangeEqualsSeq(fileBytes, bindOffset, expectedBindInfo):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: dynamic bind proof mismatch")

    var fileSnapshotAfter: MachoProviderFileSnapshot
    if !machoProviderFileSnapshotStat(fileSnapshotBefore.canonicalPath,
                                      fileSnapshotAfter) ||
       !machoProviderFileSnapshotIdentityEqual(fileSnapshotBefore,
                                               fileSnapshotAfter) ||
       fileSnapshotAfter.size != strings.IntToStr(fileBytes.len):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final executable changed during verification")
    let outputFileSha256 = machoProviderHashByteBuffer(fileBytes)
    if !machoProviderSha256TextValid(outputFileSha256):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final executable sha256 failed")

    var receipt: MachoProviderLinkReceipt
    receipt.outputPath = strings.CloneStr(fileSnapshotAfter.canonicalPath)
    receipt.outputCanonicalPath = strings.CloneStr(fileSnapshotAfter.canonicalPath)
    receipt.outputFileSha256 = outputFileSha256
    receipt.outputFileDevice = fileSnapshotAfter.device
    receipt.outputFileInode = fileSnapshotAfter.inode
    receipt.outputFileSize = fileSnapshotAfter.size
    receipt.outputFileMtimeSec = fileSnapshotAfter.mtimeSec
    receipt.outputFileMtimeNsec = fileSnapshotAfter.mtimeNsec
    receipt.outputFileCtimeSec = fileSnapshotAfter.ctimeSec
    receipt.outputFileCtimeNsec = fileSnapshotAfter.ctimeNsec
    receipt.targetTriple = targetTriple
    receipt.programObjectCount = programObjectCount
    receipt.providerObjectCount = providerObjectCount
    receipt.providerObjectContentSha256 = rawbytes.BytesToHex(expectedContentSetDigest)
    receipt.providerEvidenceSchema = MachoProviderEvidenceSchema
    receipt.providerEvidenceSha256 = evidenceDigestText
    var ownedEvidence: MachoProviderEvidence[]
    for ei in 0..<expectedEvidence.len:
        add(ownedEvidence, machoCloneProviderEvidence(expectedEvidence[ei]))
    receipt.providerEvidence = ownedEvidence
    receipt.programInputSchema = MachoProviderProgramInventorySchema
    var ownedProgramInputs: MachoProviderProgramInputEvidence[]
    for pi in 0..<expectedProgramInputs.len:
        add(ownedProgramInputs, machoCloneProgramInputEvidence(expectedProgramInputs[pi]))
    receipt.programInputs = ownedProgramInputs
    receipt.providerProofSchema = MachoProviderProofSchema
    receipt.providerProofSha256 = proofDigestText
    receipt.providerRelocationSchema = MachoProviderRelocationSchema
    var ownedRelocations: MachoProviderRelocationEvidence[]
    for ri in 0..<expectedRelocations.len:
        add(ownedRelocations, machoCloneRelocationEvidence(expectedRelocations[ri]))
    receipt.providerRelocations = ownedRelocations
    receipt.textSegmentEvidence = expectedTextSegment
    receipt.dataSegmentEvidence = expectedDataSegment
    var ownedImports: MachoProviderDynamicImportEvidence[]
    for di in 0..<expectedImports.len:
        add(ownedImports, machoCloneDynamicImportEvidence(expectedImports[di]))
    receipt.dynamicImports = ownedImports
    receipt.staticUnresolvedCount = expectedStaticUnresolvedCount
    receipt.providerObjectBindingSchema = MachoProviderBindingSchema
    receipt.providerObjectBindingStorage = MachoProviderBindingStorage
    receipt.providerObjectBindingSigned = true
    receipt.providerObjectBindingMatchesReadBytes = true
    receipt.providerObjectBindingVerified = true
    receipt.providerCommitmentFileOffset = noteOffset
    receipt.providerCommitmentByteCount = noteSize
    receipt.codeDirectoryCodeLimit = codeLimit
    return Ok[MachoProviderLinkReceipt](receipt)

@borrows
fn MachoProviderVerifyExecutableBinding(outputPath: str,
                                        expectedProviderCount: int32,
                                        expectedContentSetSha256: str): Result[MachoProviderLinkReceipt] =
    if expectedProviderCount <= 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: expected provider count must be positive")
    if len(expectedContentSetSha256) != 64:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: expected provider hash must be sha256 hex")
    var expectedDigest = rawbytes.BytesFromHex(expectedContentSetSha256)
    defer:
        rawbytes.BytesFree(expectedDigest)
    if rawbytes.BytesLen(expectedDigest) != MachoCodeSignatureHashSize:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: expected provider hash is invalid")
    var emptySegment: MachoProviderSegmentEvidence
    return machoVerifyProviderBindingRaw(outputPath,
                                         "arm64-apple-darwin",
                                         0,
                                         expectedProviderCount,
                                         expectedDigest,
                                         [],
                                         [],
                                         [],
                                         emptySegment,
                                         emptySegment,
                                         [],
                                         0,
                                         false)

@borrows
fn MachoProviderRevalidateLinkReceipt(receipt: MachoProviderLinkReceipt): Result[MachoProviderLinkReceipt] =
    if receipt.outputPath != receipt.outputCanonicalPath ||
       receipt.targetTriple != "arm64-apple-darwin" ||
       receipt.programObjectCount < 0 || receipt.providerObjectCount <= 0 ||
       receipt.providerObjectBindingSchema != MachoProviderBindingSchema ||
       receipt.providerObjectBindingStorage != MachoProviderBindingStorage ||
       !receipt.providerObjectBindingSigned ||
       !receipt.providerObjectBindingMatchesReadBytes ||
       !receipt.providerObjectBindingVerified ||
       !machoProviderSha256TextValid(receipt.outputFileSha256) ||
       receipt.providerEvidenceSchema != MachoProviderEvidenceSchema ||
       !machoProviderSha256TextValid(receipt.providerEvidenceSha256) ||
       receipt.providerEvidence.len != receipt.providerObjectCount ||
       receipt.programInputSchema != MachoProviderProgramInventorySchema ||
       receipt.programInputs.len != receipt.programObjectCount ||
       receipt.providerProofSchema != MachoProviderProofSchema ||
       !machoProviderSha256TextValid(receipt.providerProofSha256) ||
       receipt.providerRelocationSchema != MachoProviderRelocationSchema ||
       receipt.staticUnresolvedCount != 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: invalid certified receipt identity")
    var expectedDigest = rawbytes.BytesFromHex(receipt.providerObjectContentSha256)
    defer:
        rawbytes.BytesFree(expectedDigest)
    if rawbytes.BytesLen(expectedDigest) != MachoCodeSignatureHashSize:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: certified receipt content hash is invalid")
    let verifyRes = machoVerifyProviderBindingRaw(receipt.outputCanonicalPath,
                                                  receipt.targetTriple,
                                                  receipt.programObjectCount,
                                                  receipt.providerObjectCount,
                                                  expectedDigest,
                                                  receipt.providerEvidence,
                                                  receipt.programInputs,
                                                  receipt.providerRelocations,
                                                  receipt.textSegmentEvidence,
                                                  receipt.dataSegmentEvidence,
                                                  receipt.dynamicImports,
                                                  receipt.staticUnresolvedCount,
                                                  true)
    if !verifyRes.ok:
        return verifyRes
    let current = verifyRes.value
    if current.outputPath != receipt.outputPath ||
       current.outputCanonicalPath != receipt.outputCanonicalPath ||
       current.outputFileSha256 != receipt.outputFileSha256 ||
       current.outputFileDevice != receipt.outputFileDevice ||
       current.outputFileInode != receipt.outputFileInode ||
       current.outputFileSize != receipt.outputFileSize ||
       current.outputFileMtimeSec != receipt.outputFileMtimeSec ||
       current.outputFileMtimeNsec != receipt.outputFileMtimeNsec ||
       current.outputFileCtimeSec != receipt.outputFileCtimeSec ||
       current.outputFileCtimeNsec != receipt.outputFileCtimeNsec ||
       current.targetTriple != receipt.targetTriple ||
       current.programObjectCount != receipt.programObjectCount ||
       current.providerObjectCount != receipt.providerObjectCount ||
       current.providerObjectContentSha256 != receipt.providerObjectContentSha256 ||
       current.providerEvidenceSchema != receipt.providerEvidenceSchema ||
       current.providerEvidenceSha256 != receipt.providerEvidenceSha256 ||
       current.programInputSchema != receipt.programInputSchema ||
       current.providerProofSchema != receipt.providerProofSchema ||
       current.providerProofSha256 != receipt.providerProofSha256 ||
       current.providerRelocationSchema != receipt.providerRelocationSchema ||
       current.staticUnresolvedCount != receipt.staticUnresolvedCount ||
       current.providerObjectBindingSchema != receipt.providerObjectBindingSchema ||
       current.providerObjectBindingStorage != receipt.providerObjectBindingStorage ||
       current.providerCommitmentFileOffset != receipt.providerCommitmentFileOffset ||
       current.providerCommitmentByteCount != receipt.providerCommitmentByteCount ||
       current.codeDirectoryCodeLimit != receipt.codeDirectoryCodeLimit:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: certified receipt no longer matches final output")
    return verifyRes

@borrows
fn machoWriteProviderExe(outputPath: str,
                         targetTriple: str,
                         programObjectCount: int32,
                         providerObjectCount: int32,
                         providerContentSetDigest: rawbytes.Bytes,
                         providerEvidenceDigest: rawbytes.Bytes,
                         providerEvidence: MachoProviderEvidence[],
                         programInputs: MachoProviderProgramInputEvidence[],
                         providerRelocations: MachoProviderRelocationEvidence[],
                         staticUnresolvedCount: int32,
                         code: var uint8[],
                         codeWords: int32,
                         imports: str[],
                         entryByteOff: int32,
                         dataRegion: uint8[]): Result[MachoProviderLinkReceipt] =
    if programObjectCount <= 0 || providerObjectCount <= 0 ||
       providerEvidence.len != providerObjectCount ||
       programInputs.len != programObjectCount:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: certified provider executable requires non-empty inputs")
    var codeSize: int32
    var stubSize: int32
    var gotSize: int32
    var textContentSize: int32
    var textFileSize: int32
    var gotOff: int32
    var dataContentSize: int32
    if !machoProviderCheckedI32Mul(codeWords, 4, codeSize) ||
       !machoProviderCheckedI32Mul(imports.len, 12, stubSize) ||
       !machoProviderCheckedI32Mul(imports.len, 8, gotSize) ||
       !machoProviderCheckedI32Add(MachoCodeOff, codeSize, textContentSize) ||
       !machoProviderCheckedI32Add(textContentSize, stubSize, textContentSize) ||
       !machoProviderCheckedI32Align(textContentSize,
                                     MachoExecPageSize,
                                     textFileSize) ||
       !machoProviderCheckedI32Align(dataRegion.len, 8, gotOff) ||
       !machoProviderCheckedI32Add(gotOff, gotSize, dataContentSize) ||
       code.len != codeSize + stubSize:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: executable layout size overflow")
    let dylibCount = machoProviderImportDylibCount(imports)
    var dataFileSize: int32
    if dataContentSize > 0 &&
       !machoProviderCheckedI32Align(dataContentSize,
                                     MachoExecPageSize,
                                     dataFileSize):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: data layout size overflow")
    let textBase = machoTextBase()
    let dataAddr = textBase + uint64(textFileSize)
    var linkeditFileoff: int32
    if !machoProviderCheckedI32Add(textFileSize,
                                  dataFileSize,
                                  linkeditFileoff):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: linkedit offset overflow")
    let linkeditAddr = dataAddr + uint64(dataFileSize)
    let codeVmaddr = textBase + uint64(MachoCodeOff)
    for i in 0..<imports.len:
        let ptrAddr = dataAddr + uint64(gotOff + i * 8)
        let stubAddr = codeVmaddr + uint64(codeSize + i * 12)
        let byteOff = codeSize + i * 12
        machoPatchU32Image(code, byteOff, machoA64Adrp(uint32(16), stubAddr, ptrAddr))
        machoPatchU32Image(code, byteOff + 4, machoA64LdrX(uint32(16), uint32(16), uint32(ptrAddr & uint64(0xfff))))
        machoPatchU32Image(code, byteOff + 8, uint32(0xd61f0200))
    let bindInfo = machoBuildBindInfo(imports, 2, gotOff)
    let bindOff = linkeditFileoff
    let bindSize = bindInfo.len
    var cur: int32
    var layoutCursor: int32
    if !machoProviderCheckedI32Add(bindOff, bindSize, layoutCursor) ||
       !machoProviderCheckedI32Align(layoutCursor, 8, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: bind layout size overflow")
    let symoff = cur
    let nsyms = imports.len
    var tableSize: int32
    if !machoProviderCheckedI32Mul(nsyms, 16, tableSize) ||
       !machoProviderCheckedI32Add(cur, tableSize, cur) ||
       !machoProviderCheckedI32Align(cur, 4, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: symbol table size overflow")
    let indirectsymoff = cur
    var nindirect: int32
    if !machoProviderCheckedI32Mul(imports.len, 2, nindirect) ||
       !machoProviderCheckedI32Mul(nindirect, 4, tableSize) ||
       !machoProviderCheckedI32Add(cur, tableSize, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: indirect symbol table size overflow")
    let stroff = cur
    var strsize = 1
    for i in 0..<imports.len:
        if !machoProviderCheckedI32Add(strsize, len(imports[i]), strsize) ||
           !machoProviderCheckedI32Add(strsize, 1, strsize):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: string table size overflow")
    if strsize < 2:
        strsize = 2
    if !machoProviderCheckedI32Add(cur, strsize, cur) ||
       !machoProviderCheckedI32Align(cur, 4, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: string table layout overflow")
    let functionStartsOff = cur
    let functionStartsSize = 1
    if !machoProviderCheckedI32Add(cur, functionStartsSize, cur) ||
       !machoProviderCheckedI32Align(cur, 4, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: function-start layout overflow")
    let dataInCodeOff = cur
    let dataInCodeSize = 0
    if !machoProviderCheckedI32Align(cur, 16, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: commitment alignment overflow")
    let providerCommitmentOff = cur
    if !machoProviderCheckedI32Add(cur,
                                  MachoProviderCommitmentSize,
                                  cur) ||
       !machoProviderCheckedI32Align(cur, 16, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: commitment layout overflow")
    let codeSignatureOff = cur
    if !machoProviderCheckedI32Add(codeSignatureOff,
                                  MachoCodeSignaturePageSize - 1,
                                  layoutCursor):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: signature slot count overflow")
    let codeSignatureSlots = layoutCursor / MachoCodeSignaturePageSize
    let codeSignatureIdentOff = 44
    let codeSignatureHashOff = machoAlignI32(codeSignatureIdentOff + len("cheng.provider-linker") + 1, 4)
    if !machoProviderCheckedI32Mul(codeSignatureSlots,
                                  MachoCodeSignatureHashSize,
                                  tableSize) ||
       !machoProviderCheckedI32Add(codeSignatureHashOff,
                                  tableSize,
                                  tableSize):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: CodeDirectory size overflow")
    let codeSignatureCodeDirectoryLen = tableSize
    var codeSignatureSize: int32
    if !machoProviderCheckedI32Add(20,
                                  codeSignatureCodeDirectoryLen,
                                  codeSignatureSize) ||
       !machoProviderCheckedI32Add(cur, codeSignatureSize, cur):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: signature layout overflow")
    let linkeditSize = cur - linkeditFileoff
    let totalSize = cur
    var out = rawbytes.BytesAlloc(totalSize)
    machoTrace(Fmt"write_exe_alloc total_size={totalSize} text_file_size={textFileSize} linkedit_fileoff={linkeditFileoff}")
    if out.data == nil || out.len != totalSize:
        rawbytes.BytesFree(out)
        return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: output allocation failed: {outputPath}")
    defer:
        rawbytes.BytesFree(out)
    machoTrace(Fmt"write_exe_alloc_done bytes={out.len}")
    rawbytes.BytesSet(out, 0, 207)
    rawbytes.BytesSet(out, 1, 250)
    rawbytes.BytesSet(out, 2, 237)
    rawbytes.BytesSet(out, 3, 254)
    rawbytes.BytesSet(out, 4, 12)
    rawbytes.BytesSet(out, 5, 0)
    rawbytes.BytesSet(out, 6, 0)
    rawbytes.BytesSet(out, 7, 1)
    machoRawPutU32At(out, 8, uint32(0))
    machoRawPutU32At(out, 12, MachoFileTypeExecute)
    machoRawPutU32At(out, 24, uint32(0x00200085))
    var pos = 32
    machoRawWriteSegment(out, pos, "__PAGEZERO", uint64(0), textBase, uint64(0), uint64(0), 0, 0, 0)
    var textSections = 1
    if imports.len > 0:
        textSections = 2
    machoRawWriteSegment(out, pos, "__TEXT", textBase, uint64(textFileSize), uint64(0), uint64(textFileSize), 5, 5, textSections)
    machoRawWriteSection(out, pos, "__text", "__TEXT", codeVmaddr, uint64(codeSize), MachoCodeOff, 2, uint32(0x80000400), 0, 0)
    if imports.len > 0:
        machoRawWriteSection(out, pos, "__stubs", "__TEXT", codeVmaddr + uint64(codeSize), uint64(stubSize), MachoCodeOff + codeSize, 2, uint32(0x80000408), 0, 12)
    if dataContentSize > 0:
        var dataSections = 0
        if dataRegion.len > 0:
            dataSections = dataSections + 1
        if gotSize > 0:
            dataSections = dataSections + 1
        machoRawWriteSegment(out, pos, "__DATA", dataAddr, uint64(dataFileSize), uint64(textFileSize), uint64(dataFileSize), 3, 3, dataSections)
        if dataRegion.len > 0:
            machoRawWriteSection(out, pos, "__data", "__DATA", dataAddr, uint64(dataRegion.len), textFileSize, 3, uint32(0), 0, 0)
        if gotSize > 0:
            machoRawWriteSection(out, pos, "__got", "__DATA", dataAddr + uint64(gotOff), uint64(gotSize), textFileSize + gotOff, 3, uint32(6), imports.len, 0)
    machoRawWriteSegment(out, pos, "__LINKEDIT", linkeditAddr, uint64(linkeditSize), uint64(linkeditFileoff), uint64(linkeditSize), 1, 1, 0)
    machoRawPutU32At(out, pos, uint32(0x80000022))
    machoRawPutU32At(out, pos + 4, uint32(48))
    machoRawPutU32At(out, pos + 16, uint32(bindOff))
    machoRawPutU32At(out, pos + 20, uint32(bindSize))
    pos = pos + 48
    machoRawPutU32At(out, pos, uint32(14))
    machoRawPutU32At(out, pos + 4, uint32(32))
    machoRawPutU32At(out, pos + 8, uint32(12))
    machoRawCopyStringAt(out, pos + 12, "/usr/lib/dyld")
    pos = pos + 32
    for dylibOrdinal in 1..dylibCount:
        let dylibPath = machoProviderDylibPathForOrdinal(dylibOrdinal)
        if len(dylibPath) <= 0:
            return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: unsupported dylib ordinal: {dylibOrdinal}")
        machoRawWriteDylibCommand(out, pos, dylibPath)
    machoRawPutU32At(out, pos, uint32(2))
    machoRawPutU32At(out, pos + 4, uint32(24))
    machoRawPutU32At(out, pos + 8, uint32(symoff))
    machoRawPutU32At(out, pos + 12, uint32(nsyms))
    machoRawPutU32At(out, pos + 16, uint32(stroff))
    machoRawPutU32At(out, pos + 20, uint32(strsize))
    pos = pos + 24
    machoRawPutU32At(out, pos, uint32(11))
    machoRawPutU32At(out, pos + 4, uint32(80))
    machoRawPutU32At(out, pos + 24, uint32(0))
    machoRawPutU32At(out, pos + 28, uint32(nsyms))
    machoRawPutU32At(out, pos + 56, uint32(indirectsymoff))
    machoRawPutU32At(out, pos + 60, uint32(nindirect))
    pos = pos + 80
    machoRawPutU32At(out, pos, uint32(27))
    machoRawPutU32At(out, pos + 4, uint32(24))
    for i in 0..<16:
        rawbytes.BytesSet(out, pos + 8 + i, 208 + i)
    pos = pos + 24
    machoRawPutU32At(out, pos, uint32(50))
    machoRawPutU32At(out, pos + 4, uint32(24))
    machoRawPutU32At(out, pos + 8, uint32(1))
    machoRawPutU32At(out, pos + 12, uint32(0x000e0000))
    machoRawPutU32At(out, pos + 16, uint32(0x000e0000))
    pos = pos + 24
    machoRawPutU32At(out, pos, uint32(38))
    machoRawPutU32At(out, pos + 4, uint32(16))
    machoRawPutU32At(out, pos + 8, uint32(functionStartsOff))
    machoRawPutU32At(out, pos + 12, uint32(functionStartsSize))
    pos = pos + 16
    machoRawPutU32At(out, pos, uint32(41))
    machoRawPutU32At(out, pos + 4, uint32(16))
    machoRawPutU32At(out, pos + 8, uint32(dataInCodeOff))
    machoRawPutU32At(out, pos + 12, uint32(dataInCodeSize))
    pos = pos + 16
    machoRawPutU32At(out, pos, uint32(0x80000028))
    machoRawPutU32At(out, pos + 4, uint32(24))
    machoRawPutU32At(out, pos + 8, uint32(MachoCodeOff + entryByteOff))
    pos = pos + 24
    machoRawPutU32At(out, pos, MachoLoadNote)
    machoRawPutU32At(out, pos + 4, uint32(40))
    machoRawPaddedAsciiAt(out, pos + 8, MachoProviderNoteOwner, 16)
    machoRawPutU64At(out, pos + 24, uint64(providerCommitmentOff))
    machoRawPutU64At(out, pos + 32, uint64(MachoProviderCommitmentSize))
    pos = pos + 40
    machoRawPutU32At(out, pos, uint32(29))
    machoRawPutU32At(out, pos + 4, uint32(16))
    machoRawPutU32At(out, pos + 8, uint32(codeSignatureOff))
    machoRawPutU32At(out, pos + 12, uint32(codeSignatureSize))
    pos = pos + 16
    var ncmds = 14 + dylibCount
    if dataContentSize > 0:
        ncmds = ncmds + 1
    machoRawPutU32At(out, 16, uint32(ncmds))
    machoRawPutU32At(out, 20, uint32(pos - 32))
    if pos > MachoCodeOff:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: load commands exceed code offset")
    let copyStartNs = times.MonotimeNs()
    machoRawCopySeqAt(out, MachoCodeOff, code)
    if dataRegion.len > 0:
        machoRawCopySeqAt(out, textFileSize, dataRegion)
    machoRawCopySeqAt(out, bindOff, bindInfo)
    rawbytes.BytesSet(out, functionStartsOff, 0)
    machoTraceMs("write_exe_copy", copyStartNs)
    var strPos = stroff + 1
    for i in 0..<imports.len:
        let symPos = symoff + i * 16
        machoRawPutU32At(out, symPos, uint32(strPos - stroff))
        rawbytes.BytesSet(out, symPos + 4, MachoNTypeUndef | MachoNTypeExt)
        rawbytes.BytesSet(out, symPos + 6, 0)
        rawbytes.BytesSet(out,
                          symPos + 7,
                          machoDarwinImportDylibOrdinal(imports[i]))
        machoRawCopyStringAt(out, strPos, imports[i])
        strPos = strPos + len(imports[i]) + 1
    for i in 0..<imports.len:
        machoRawPutU32At(out, indirectsymoff + i * 4, uint32(i))
        machoRawPutU32At(out, indirectsymoff + (imports.len + i) * 4, uint32(i))
    var textSegmentEvidence: MachoProviderSegmentEvidence
    textSegmentEvidence.segmentName = "__TEXT"
    textSegmentEvidence.fileOffset = int64(0)
    textSegmentEvidence.fileSize = int64(textFileSize)
    textSegmentEvidence.vmAddress = textBase
    textSegmentEvidence.vmSize = uint64(textFileSize)
    textSegmentEvidence.postRelocationSha256 = machoProviderHashRawRange(out,
                                                                        int64(0),
                                                                        int64(textFileSize))
    var dataSegmentEvidence: MachoProviderSegmentEvidence
    dataSegmentEvidence.segmentName = "__DATA"
    if dataFileSize > 0:
        dataSegmentEvidence.fileOffset = int64(textFileSize)
        dataSegmentEvidence.fileSize = int64(dataFileSize)
        dataSegmentEvidence.vmAddress = dataAddr
        dataSegmentEvidence.vmSize = uint64(dataFileSize)
        dataSegmentEvidence.postRelocationSha256 = machoProviderHashRawRange(out,
                                                                            int64(textFileSize),
                                                                            int64(dataFileSize))
    else:
        dataSegmentEvidence.fileOffset = int64(-1)
        dataSegmentEvidence.postRelocationSha256 = machoProviderHashRawRange(out,
                                                                            int64(0),
                                                                            int64(0))
    if !machoProviderSha256TextValid(textSegmentEvidence.postRelocationSha256) ||
       !machoProviderSha256TextValid(dataSegmentEvidence.postRelocationSha256):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: final segment proof hash failed")
    var dynamicImports: MachoProviderDynamicImportEvidence[]
    var bindRecordCursor = bindOff
    for i in 0..<imports.len:
        let ordinal = machoDarwinImportDylibOrdinal(imports[i])
        let dylibPath = machoProviderDylibPathForOrdinal(ordinal)
        if ordinal <= 0 || len(dylibPath) <= 0:
            return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: invalid dynamic import proof index={i}")
        var importEvidence: MachoProviderDynamicImportEvidence
        importEvidence.importIndex = i
        importEvidence.dylibOrdinal = ordinal
        importEvidence.dylibPath = dylibPath
        importEvidence.symbol = imports[i]
        importEvidence.nlistIndex = i
        importEvidence.nlistFileOffset = int64(symoff) + int64(i) * int64(16)
        importEvidence.nlistEntrySha256 = machoProviderHashRawRange(
            out,
            importEvidence.nlistFileOffset,
            int64(16))
        let bindRecord = machoBuildBindRecord(imports[i],
                                              2,
                                              gotOff + i * 8)
        if bindRecord.len <= 0:
            return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic bind record build failed index={i}")
        importEvidence.bindRecordOrdinal = i
        importEvidence.bindRecordFileOffset = int64(bindRecordCursor)
        importEvidence.bindRecordSize = int64(bindRecord.len)
        importEvidence.bindRecordSha256 = machoProviderHashRawRange(
            out,
            importEvidence.bindRecordFileOffset,
            importEvidence.bindRecordSize)
        bindRecordCursor = bindRecordCursor + bindRecord.len
        importEvidence.stubFileOffset = int64(MachoCodeOff) +
                                        int64(codeSize) + int64(i) * int64(12)
        importEvidence.stubSize = int64(12)
        importEvidence.stubPostRelocationSha256 = machoProviderHashRawRange(
            out,
            importEvidence.stubFileOffset,
            importEvidence.stubSize)
        importEvidence.gotFileOffset = int64(textFileSize) +
                                       int64(gotOff) + int64(i) * int64(8)
        importEvidence.gotSize = int64(8)
        importEvidence.gotValueContract = "dyld_bind_pointer_zero_in_file"
        importEvidence.gotInitialSha256 = machoProviderHashRawRange(
            out,
            importEvidence.gotFileOffset,
            importEvidence.gotSize)
        if !machoProviderSha256TextValid(importEvidence.nlistEntrySha256) ||
           !machoProviderSha256TextValid(importEvidence.bindRecordSha256) ||
           !machoProviderSha256TextValid(importEvidence.stubPostRelocationSha256) ||
           !machoProviderSha256TextValid(importEvidence.gotInitialSha256):
            return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: dynamic import byte proof hash failed index={i}")
        add(dynamicImports, importEvidence)
    if bindRecordCursor + 1 != bindOff + bindSize:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: dynamic bind record cardinality mismatch")
    var contentSetCopy = rawbytes.BytesAlloc(MachoCodeSignatureHashSize)
    defer:
        rawbytes.BytesFree(contentSetCopy)
    var evidenceCopy = rawbytes.BytesAlloc(MachoCodeSignatureHashSize)
    defer:
        rawbytes.BytesFree(evidenceCopy)
    if !machoCopyBytesInto(contentSetCopy, providerContentSetDigest) ||
       !machoCopyBytesInto(evidenceCopy, providerEvidenceDigest):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider digest bytes unavailable")
    let evidenceDigestText = rawbytes.BytesToHex(evidenceCopy)
    let proofDigestRes = machoProviderProofDigest(programObjectCount,
                                                  providerObjectCount,
                                                  evidenceDigestText,
                                                  programInputs,
                                                  providerEvidence,
                                                  providerRelocations,
                                                  textSegmentEvidence,
                                                  dataSegmentEvidence,
                                                  dynamicImports,
                                                  staticUnresolvedCount)
    if !proofDigestRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider proof digest failed")
    var providerProofDigest = rawbytes.BytesAlloc(MachoCodeSignatureHashSize)
    defer:
        rawbytes.BytesFree(providerProofDigest)
    if !machoFillBytesFromHex(strings.CloneStr(proofDigestRes.value),
                              providerProofDigest):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider proof digest hex is invalid")
    var providerCommitment = rawbytes.BytesAlloc(MachoProviderCommitmentSize)
    defer:
        rawbytes.BytesFree(providerCommitment)
    let commitmentRes = machoBuildProviderCommitment(providerCommitment,
                                                      providerObjectCount,
                                                      contentSetCopy,
                                                      evidenceCopy,
                                                      providerProofDigest)
    if !commitmentRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider commitment build failed")
    machoRawCopyBytesAt(out, providerCommitmentOff, providerCommitment)
    let signStartNs = times.MonotimeNs()
    let signatureRes = machoWriteEmbeddedAdhocSignature(out, codeSignatureOff, codeSignatureOff, codeSignatureSize)
    machoTraceMs("write_exe_sign", signStartNs)
    if !signatureRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: embedded signature write failed")
    let fileStartNs = times.MonotimeNs()
    if !LinkerCoreWriteRawBytesAtomic(outputPath, out):
        let _ = os.RemoveFile(outputPath)
        return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: failed to write output: {outputPath}")
    machoTraceMs("write_exe_file", fileStartNs)
    let chmodRes = fs.Chmod(outputPath, 493)
    if !chmodRes.ok:
        let _ = os.RemoveFile(outputPath)
        return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: chmod executable failed: {outputPath}")
    let verifyRes = machoVerifyProviderBindingRaw(outputPath,
                                                  targetTriple,
                                                  programObjectCount,
                                                  providerObjectCount,
                                                  contentSetCopy,
                                                  providerEvidence,
                                                  programInputs,
                                                  providerRelocations,
                                                  textSegmentEvidence,
                                                  dataSegmentEvidence,
                                                  dynamicImports,
                                                  staticUnresolvedCount,
                                                  true)
    if !verifyRes.ok:
        let _ = os.RemoveFile(outputPath)
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider binding verification failed")
    return verifyRes

fn machoReleaseObjectBuffersDeferred(objs: var MachoProviderObject[]) =
    for i in 0..<objs.len:
        if objs[i] != nil:
            bytes.FreeByteBuffer(objs[i].data)

@borrows
fn MachoProviderComputeContentSetSha256(providerObjectPaths: str[]): Result[str] =
    if providerObjectPaths.len <= 0:
        return Err[str]("macho_provider_linker: provider content-set must not be empty")
    var providerObjects: MachoProviderObject[]
    defer:
        machoReleaseObjectBuffersDeferred(providerObjects)
    for i in 0..<providerObjectPaths.len:
        let objRes = machoReadObject(providerObjectPaths[i])
        if !objRes.ok:
            return Err[str](objRes.err.msg)
        add(providerObjects, objRes.value)
    let digestRes = machoProviderContentSetDigest(providerObjects)
    if !digestRes.ok:
        return Err[str](strings.CloneStr(digestRes.err.msg))
    return Ok[str](strings.CloneStr(digestRes.value))

@borrows
fn MachoProviderLinkExeCertified(request: MachoProviderLinkRequest): Result[MachoProviderLinkReceipt] =
    let linkTotalStartNs = times.MonotimeNs()
    machoTrace(Fmt"link_begin program_inputs={request.programObjectPaths.len} provider_inputs={request.providerObjectPaths.len} output={request.outputPath}")
    if len(request.outputPath) <= 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: missing output path")
    if !machoProviderRemoveOutput(request.outputPath):
        return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: failed to remove prior output: {request.outputPath}")
    if request.targetTriple != "arm64-apple-darwin":
        return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: unsupported target: {request.targetTriple}")
    if request.programObjectPaths.len <= 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: missing program input objects")
    if request.providerObjectPaths.len <= 0:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: certified provider link requires provider input objects")
    if (request.programCanonicalPaths.len != 0 &&
        request.programCanonicalPaths.len != request.programObjectPaths.len) ||
       (request.programExpectedContentSha256.len != 0 &&
        request.programExpectedContentSha256.len != request.programObjectPaths.len) ||
       request.programCanonicalPaths.len != request.programExpectedContentSha256.len:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: program evidence request cardinality mismatch")
    if (request.providerCanonicalPaths.len != 0 &&
        request.providerCanonicalPaths.len != request.providerObjectPaths.len) ||
       (request.providerExpectedContentSha256.len != 0 &&
        request.providerExpectedContentSha256.len != request.providerObjectPaths.len) ||
       request.providerCanonicalPaths.len != request.providerExpectedContentSha256.len:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence request cardinality mismatch")
    var objs: MachoProviderObject[]
    var programObjects: MachoProviderObject[]
    var providerObjects: MachoProviderObject[]
    defer:
        machoReleaseObjectBuffersDeferred(objs)
    var totalWords: int32
    for i in 0..<request.programObjectPaths.len:
        let objRes = machoReadObject(request.programObjectPaths[i])
        if !objRes.ok:
            return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: program object read failed index={i}")
        let obj = objRes.value
        obj.baseWord = totalWords
        var nextTotalWords: int32
        if !machoProviderCheckedI32Add(totalWords,
                                      obj.wordCount,
                                      nextTotalWords):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: program image size overflow")
        totalWords = nextTotalWords
        add(programObjects, share(obj))
        add(objs, share(obj))
        machoTrace(Fmt"link_program_object_added index={i} base_word={obj.baseWord} words={obj.wordCount}")
    for i in 0..<request.providerObjectPaths.len:
        let objRes = machoReadObject(request.providerObjectPaths[i])
        if !objRes.ok:
            return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider object read failed index={i}")
        let obj = objRes.value
        obj.baseWord = totalWords
        var nextTotalWords: int32
        if !machoProviderCheckedI32Add(totalWords,
                                      obj.wordCount,
                                      nextTotalWords):
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider image size overflow")
        totalWords = nextTotalWords
        add(providerObjects, share(obj))
        add(objs, share(obj))
        machoTrace(Fmt"link_provider_object_added index={i} base_word={obj.baseWord} words={obj.wordCount}")
    var programCanonicalPaths = machoCloneStrSeq(request.programCanonicalPaths)
    var programExpectedContentSha256 = machoCloneStrSeq(request.programExpectedContentSha256)
    if programCanonicalPaths.len == 0:
        for i in 0..<programObjects.len:
            let canonicalRes = fs.Realpath(request.programObjectPaths[i])
            if !canonicalRes.ok:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: program canonical path unavailable index={i}")
            add(programCanonicalPaths, share(canonicalRes.value))
            let objectSha256 = machoProviderHashByteBuffer(programObjects[i].data)
            if !machoProviderSha256TextValid(objectSha256):
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: program content hash unavailable index={i}")
            add(programExpectedContentSha256, objectSha256)
    var providerCanonicalPaths = machoCloneStrSeq(request.providerCanonicalPaths)
    var providerExpectedContentSha256 = machoCloneStrSeq(request.providerExpectedContentSha256)
    if providerCanonicalPaths.len == 0:
        for i in 0..<providerObjects.len:
            let canonicalRes = fs.Realpath(request.providerObjectPaths[i])
            if !canonicalRes.ok:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider canonical path unavailable index={i}")
            add(providerCanonicalPaths, share(canonicalRes.value))
            let objectSha256 = machoProviderHashByteBuffer(providerObjects[i].data)
            if !machoProviderSha256TextValid(objectSha256):
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: provider content hash unavailable index={i}")
            add(providerExpectedContentSha256, objectSha256)
    let programIdentityRes = machoProviderValidateInputObjects(programObjects,
                                                               programCanonicalPaths,
                                                               programExpectedContentSha256,
                                                               "program")
    if !programIdentityRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: program identity validation failed")
    let programInventoryRes = machoProviderBuildProgramInventory(
        programObjects,
        programCanonicalPaths,
        programExpectedContentSha256)
    if !programInventoryRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: program inventory build failed")
    let programInputs = programInventoryRes.value
    let providerIdentityRes = machoProviderValidateInputObjects(providerObjects,
                                                                providerCanonicalPaths,
                                                                providerExpectedContentSha256,
                                                                "provider")
    if !providerIdentityRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider identity validation failed")
    var allCanonicalPaths: str[]
    var allExpectedContentSha256: str[]
    for i in 0..<programCanonicalPaths.len:
        add(allCanonicalPaths, share(programCanonicalPaths[i]))
        add(allExpectedContentSha256, share(programExpectedContentSha256[i]))
    for i in 0..<providerCanonicalPaths.len:
        add(allCanonicalPaths, share(providerCanonicalPaths[i]))
        add(allExpectedContentSha256, share(providerExpectedContentSha256[i]))
    let contentSetRes = machoProviderContentSetDigest(providerObjects)
    if !contentSetRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider content-set digest failed")
    var providerContentSetDigest = rawbytes.BytesAlloc(MachoCodeSignatureHashSize)
    defer:
        rawbytes.BytesFree(providerContentSetDigest)
    if !machoFillBytesFromHex(strings.CloneStr(contentSetRes.value),
                              providerContentSetDigest):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider content-set digest hex is invalid")
    var imports: str[]
    var unresolved = ""
    var totalRelocCount: int32
    for oi in 0..<objs.len:
        let objForCount = objs[oi]
        if objForCount.relocs.len > 2147483647 - totalRelocCount:
            return Err[MachoProviderLinkReceipt]("macho_provider_linker: relocation count overflow")
        totalRelocCount = totalRelocCount + objForCount.relocs.len
    var staticUnresolvedCount: int32
    machoTrace(Fmt"scan_relocs_begin total_relocs={totalRelocCount}")
    let scanStartNs = times.MonotimeNs()
    for oi in 0..<objs.len:
        let obj = objs[oi]
        machoTrace(Fmt"scan_object index={oi} relocs={obj.relocs.len} symbols={obj.symbols.len}")
        for ri in 0..<obj.relocs.len:
            let reloc = obj.relocs[ri]
            machoTrace(Fmt"scan_reloc object={oi} reloc={ri} symbol_index={reloc.symbolIndex}")
            if reloc.symbolIndex < 0 || reloc.symbolIndex >= obj.symbols.len:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: relocation symbol out of range")
            if !machoProviderRelocationEncodingValid(reloc):
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: unsupported relocation encoding object={oi} reloc={ri}")
            let sym = obj.symbols[reloc.symbolIndex]
            if machoSymbolDefined(sym):
                continue
            var targetByteOff: int32
            # [wall138] scan 阶段与 ResolveTarget 同一排除契约：跳过引用者
            # 自身的定义，否则 provider 内 undefined("puts") 在 scan 侧被
            # 自家定义吞掉不入 imports，解析侧排除后又查不到 import 而报
            # "import missing after scan"（r3 失败臂实证）。两阶段必须对
            # 同一 reloc 给出同一判定。
            let definedCount = machoCountLinkedDefinedByteOff(objs, sym.name, oi, targetByteOff)
            if definedCount == 1:
                continue
            if definedCount > 1:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: duplicate symbol: {machoStripLeadingUnderscore(sym.name)}")
            if machoDarwinImportAllowed(sym.name):
                let _idx = machoAddImport(imports, sym.name)
                continue
            if len(sym.name) == 0:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: relocation references unnamed symbol: object={oi} reloc={ri}")
            if staticUnresolvedCount == 0:
                unresolved = machoStripLeadingUnderscore(sym.name)
            if staticUnresolvedCount == 2147483647:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: unresolved symbol count overflow")
            staticUnresolvedCount = staticUnresolvedCount + 1
    machoTraceMs("scan_relocs", scanStartNs)
    if staticUnresolvedCount != 0:
        return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: unresolved symbols count={staticUnresolvedCount} first={unresolved}")
    var importWords: int32
    var linkedWords: int32
    var linkedBytes: int32
    var textContentSize: int32
    var textFileSize: int32
    if !machoProviderCheckedI32Mul(imports.len, 3, importWords) ||
       !machoProviderCheckedI32Add(totalWords, importWords, linkedWords) ||
       !machoProviderCheckedI32Mul(linkedWords, 4, linkedBytes) ||
       !machoProviderCheckedI32Add(MachoCodeOff,
                                   linkedBytes,
                                   textContentSize) ||
       !machoProviderCheckedI32Align(textContentSize,
                                     MachoExecPageSize,
                                     textFileSize):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: linked image size overflow")
    # Mutable object data lives in a RW __DATA region that starts at the page
    # boundary right after __TEXT; word indices continue across the boundary so
    # relocation math stays uniform (vmaddr = codeVmaddr + word * 4).
    let dataRegionStartWord = (textFileSize - MachoCodeOff) / 4
    var dataCursorWord = dataRegionStartWord
    for oi in 0..<objs.len:
        let dataObj = objs[oi]
        if dataObj.dataByteCount > 0:
            dataObj.dataBaseWord = dataCursorWord
            let dataWords64 = ((int64(dataObj.dataByteCount) + int64(7)) /
                               int64(8)) * int64(2)
            if dataWords64 > int64(2147483647):
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: data object size overflow")
            var nextDataCursorWord: int32
            if !machoProviderCheckedI32Add(dataCursorWord,
                                          int32(dataWords64),
                                          nextDataCursorWord):
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: data region size overflow")
            dataCursorWord = nextDataCursorWord
    let dataRegionWords = dataCursorWord - dataRegionStartWord
    var addressSpaceBytes: int32
    var dataRegionBytes: int32
    if !machoProviderCheckedI32Mul(dataCursorWord, 4, addressSpaceBytes) ||
       !machoProviderCheckedI32Mul(dataRegionWords, 4, dataRegionBytes):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: address space size overflow")
    machoTrace(Fmt"image_alloc_begin linked_words={linkedWords} imports={machoStrArrayLen(imports)} data_words={dataRegionWords}")
    var image: uint8[]
    setLen(image, linkedBytes)
    var dataRegion: uint8[]
    setLen(dataRegion, dataRegionBytes)
    machoTrace(Fmt"image_alloc_done bytes={machoUint8ArrayLen(image)}")
    let copyImgStartNs = times.MonotimeNs()
    for oi in 0..<objs.len:
        let copyObj = objs[oi]
        let copyDest = copyObj.baseWord * 4
        machoTrace(Fmt"copy_object_image index={oi} dest={copyDest} bytes={copyObj.imageByteCount} data_bytes={copyObj.dataByteCount}")
        for imageByteIndex in 0..<copyObj.imageByteCount:
            image[copyDest + imageByteIndex] = uint8(bytes.BufByteAt(copyObj.data, copyObj.imageFileOffset + imageByteIndex) & 255)
        if copyObj.dataByteCount > 0:
            let dataDest = (copyObj.dataBaseWord - dataRegionStartWord) * 4
            for dataByteIndex in 0..<copyObj.dataByteCount:
                dataRegion[dataDest + dataByteIndex] = uint8(bytes.BufByteAt(copyObj.data, copyObj.dataFileOff + dataByteIndex) & 255)
    machoTraceMs("copy_image", copyImgStartNs)
    let codeVmaddr = machoTextBase() + uint64(MachoCodeOff)
    let stubBaseWord = totalWords
    machoTrace("patch_relocs_begin")
    let patchStartNs = times.MonotimeNs()
    for oi in 0..<objs.len:
        let obj = objs[oi]
        for ri in 0..<obj.relocs.len:
            let reloc = obj.relocs[ri]
            machoTrace(Fmt"patch_reloc object={oi} reloc={ri} address={reloc.address} kind={reloc.kind} symbol_index={reloc.symbolIndex}")
            if reloc.address < 0 || reloc.address % 4 != 0 || reloc.address / 4 >= obj.wordCount:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: relocation address out of range")
            let sym = obj.symbols[reloc.symbolIndex]
            let targetRes = machoProviderResolveTarget(objs,
                                                       imports,
                                                       obj,
                                                       sym,
                                                       stubBaseWord)
            if !targetRes.ok:
                return Err[MachoProviderLinkReceipt]("macho_provider_linker: relocation target resolve failed")
            let targetByteOff = targetRes.value.byteOffset
            let wordPos = obj.baseWord + reloc.address / 4
            machoTrace(Fmt"patch_target object={oi} reloc={ri} name={machoStripLeadingUnderscore(sym.name)} target_byte_off={targetByteOff} word_pos={wordPos} addr_space={addressSpaceBytes} image_len={machoUint8ArrayLen(image)} kind={reloc.kind}")
            let patchRes = machoApplyReloc(image, addressSpaceBytes, wordPos, targetByteOff, reloc.kind, codeVmaddr)
            if !patchRes.ok:
                return Err[MachoProviderLinkReceipt](Fmt"macho_provider_linker: relocation patch failed object={oi} reloc={ri} kind={reloc.kind} word_pos={wordPos} target={targetByteOff} image_len={machoUint8ArrayLen(image)} addr_space={addressSpaceBytes} inner={patchRes.err.msg}")
    machoTraceMs("patch_relocs", patchStartNs)
    let evidenceRes = machoProviderBuildEvidence(objs,
                                                 providerObjects,
                                                 imports,
                                                 stubBaseWord,
                                                 providerCanonicalPaths,
                                                 providerExpectedContentSha256,
                                                 image,
                                                 dataRegion,
                                                 textFileSize,
                                                 dataRegionStartWord)
    if !evidenceRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence build failed")
    let providerEvidence = evidenceRes.value
    let evidenceDigestRes = machoProviderEvidenceDigest(providerEvidence)
    if !evidenceDigestRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence digest failed")
    var providerEvidenceDigest = rawbytes.BytesAlloc(MachoCodeSignatureHashSize)
    defer:
        rawbytes.BytesFree(providerEvidenceDigest)
    if !machoFillBytesFromHex(strings.CloneStr(evidenceDigestRes.value),
                              providerEvidenceDigest):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider evidence digest hex is invalid")
    let relocationEvidenceRes = machoProviderBuildRelocationEvidence(
        objs,
        imports,
        stubBaseWord,
        request.programObjectPaths.len,
        allCanonicalPaths,
        allExpectedContentSha256,
        image)
    if !relocationEvidenceRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: relocation evidence build failed")
    let providerRelocations = relocationEvidenceRes.value
    if providerRelocations.len != totalRelocCount:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: relocation proof cardinality mismatch")
    let finalProgramIdentityRes = machoProviderValidateInputObjects(
        programObjects,
        programCanonicalPaths,
        programExpectedContentSha256,
        "program pre-sign")
    if !finalProgramIdentityRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: program pre-sign identity failed")
    let finalProviderIdentityRes = machoProviderValidateInputObjects(
        providerObjects,
        providerCanonicalPaths,
        providerExpectedContentSha256,
        "provider pre-sign")
    if !finalProviderIdentityRes.ok:
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: provider pre-sign identity failed")
    var entryByteOff: int32
    if !machoFindLinkedDefinedByteOff(objs, "_main", entryByteOff):
        return Err[MachoProviderLinkReceipt]("macho_provider_linker: entry symbol _main not found or not unique")
    machoTrace(Fmt"write_exe_begin entry_byte_off={entryByteOff}")
    let writeStartNs = times.MonotimeNs()
    let writeRes = machoWriteProviderExe(request.outputPath,
                                         request.targetTriple,
                                         request.programObjectPaths.len,
                                         request.providerObjectPaths.len,
                                         providerContentSetDigest,
                                         providerEvidenceDigest,
                                         providerEvidence,
                                         programInputs,
                                         providerRelocations,
                                         staticUnresolvedCount,
                                         image,
                                         totalWords,
                                         imports,
                                         entryByteOff,
                                         dataRegion)
    machoTraceMs("write_exe", writeStartNs)
    machoTraceMs("link_total", linkTotalStartNs)
    if !writeRes.ok:
        let _ = os.RemoveFile(request.outputPath)
    return writeRes
