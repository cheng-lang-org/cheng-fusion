import std/result
import std/os
import std/os_host_process as hostos
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath
import cheng/core/backend/native_link_plan as nplan
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/codegen_writer_units as wunits
import cheng/core/backend/codegen_linker_units as lunits
import cheng/core/backend/elf_object_linker
import cheng/core/backend/macho_provider_linker
import std/strutils as strutil

@borrows
fn NativeLinkExecTargetSupported(targetTriple: str): bool =
    if targetTriple == "arm64-apple-darwin":
        return true
    if targetTriple == "aarch64-unknown-linux-gnu":
        return true
    if targetTriple == "arm64-unknown-linux-gnu":
        return true
    if targetTriple == "aarch64-linux-android":
        return true
    if targetTriple == "aarch64-linux-ohos":
        return true
    if targetTriple == "aarch64-unknown-linux-ohos":
        return true
    if targetTriple == "riscv64-unknown-linux-gnu":
        return true
    if targetTriple == "aarch64-pc-windows-msvc":
        return true
    if targetTriple == "arm64-pc-windows-msvc":
        return true
    if targetTriple == "x86_64-pc-windows-msvc":
        return true
    return false

@borrows
fn NativeLinkExecIsSelfLinker(targetTriple: str, linkerFlavor: str): bool =
    if linkerFlavor == "macho_arm64_provider_internal":
        return true
    if linkerFlavor == "elf_aarch64_nolibc_internal":
        return true
    if linkerFlavor == "elf_x86_64_internal":
        return true
    if linkerFlavor == "elf_riscv64_builtin":
        return true
    if linkerFlavor == "coff_pe_builtin":
        if targetTriple == "aarch64-pc-windows-msvc":
            return true
        if targetTriple == "arm64-pc-windows-msvc":
            return true
        if targetTriple == "x86_64-pc-windows-msvc":
            return true
    return false

@borrows
fn NativeLinkExecOutputModeText(plan: nplan.NativeLinkPlanStub): Result[str] =
    if plan.emitKind == creq.EmitExe:
        if plan.outputKind == nplan.NativeOutputExecutable:
            return Ok[str]("executable")
    if plan.emitKind == creq.EmitShared:
        if plan.outputKind == nplan.NativeOutputArtifact:
            return Ok[str]("shared")
    if plan.emitKind == creq.EmitObj:
        return Err[str](" native link exec: unsupported emit kind: obj")
    return Err[str](" native link exec: unsupported output kind")

@borrows
fn NativeLinkExecValidatePlan(plan: nplan.NativeLinkPlanStub): Result[str] =
    let targetTriple = plan.targetTriple
    if !NativeLinkExecTargetSupported(targetTriple):
        return Err[str](strutil.Join([" native link exec: unsupported target: ", share(targetTriple)], ""))
    if plan.outputPath.len == 0:
        return Err[str](" native link exec: missing output path")
    if plan.linkInputPaths.len == 0:
        return Err[str](" native link exec: missing link input paths")
    if plan.objectFormat.len == 0:
        return Err[str](" native link exec: missing object format")
    if plan.objectFormat == "unknown":
        return Err[str](" native link exec: missing object format")
    if plan.objectFormat == "wasm":
        return Err[str](" native link exec: wasm does not use native linker")
    if plan.linkerProgram.len == 0:
        return Err[str](" native link exec: missing linker program")
    let outputModeRes = NativeLinkExecOutputModeText(plan)
    if !outputModeRes.ok:
        let errMsg = outputModeRes.err.msg
        return Err[str](errMsg)
    let outputMode = outputModeRes.value
    return Ok[str](outputMode)

@borrows
fn NativeLinkExecValidateInputFiles(plan: nplan.NativeLinkPlanStub): Result[bool] =
    for i in 0..<plan.linkInputPaths.len:
        let inputPath = plan.linkInputPaths[i]
        if !chengpath.PathFileExists(inputPath):
            return Err[bool](strutil.Join([" native link exec: missing input file: ", share(inputPath)], ""))
    return Ok[bool](true)

@borrows
fn NativeLinkExecMachoRequest(plan: nplan.NativeLinkPlanStub): Result[macho_provider_linker.MachoProviderLinkRequest] =
    var programObjectPaths: str[]
    for pathIndex in 0..<plan.programObjectPaths.len:
        let programObjectPath = plan.programObjectPaths[pathIndex]
        add(programObjectPaths, share(programObjectPath))
    if programObjectPaths.len <= 0:
        if len(plan.primaryObjectPath) > 0:
            let primaryObjectPath = plan.primaryObjectPath
            add(programObjectPaths, share(primaryObjectPath))
        if len(plan.browserBridgeObjectPath) > 0:
            let browserBridgeObjectPath = plan.browserBridgeObjectPath
            add(programObjectPaths, share(browserBridgeObjectPath))
    if programObjectPaths.len <= 0:
        return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec: Mach-O program object partition missing")
    let expectedInputCount = programObjectPaths.len + plan.providerObjectPaths.len
    if expectedInputCount != plan.linkInputPaths.len:
        return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec: Mach-O structured input partition count mismatch")
    for i in 0..<programObjectPaths.len:
        if plan.linkInputPaths[i] != programObjectPaths[i]:
            return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec: Mach-O program input order mismatch")
    for i in 0..<plan.providerObjectPaths.len:
        if plan.linkInputPaths[programObjectPaths.len + i] != plan.providerObjectPaths[i]:
            return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec: Mach-O provider input order mismatch")
    var request: macho_provider_linker.MachoProviderLinkRequest
    request.programObjectPaths = programObjectPaths
    for pathIndex in 0..<plan.providerObjectPaths.len:
        let providerObjectPath = plan.providerObjectPaths[pathIndex]
        add(request.providerObjectPaths, share(providerObjectPath))
    let outputPath = plan.outputPath
    let targetTriple = plan.targetTriple
    request.outputPath = share(outputPath)
    request.targetTriple = share(targetTriple)
    return Ok[macho_provider_linker.MachoProviderLinkRequest](request)

@borrows
fn NativeLinkExecProviderReceiptText(receipt: macho_provider_linker.MachoProviderLinkReceipt): str =
    let contentSha256 = receipt.providerObjectContentSha256
    let bindingSchema = receipt.providerObjectBindingSchema
    let bindingStorage = receipt.providerObjectBindingStorage
    return strutil.Join([
        "provider_object_content_sha256=", share(contentSha256), "\n",
        "provider_object_binding_schema=", share(bindingSchema), "\n",
        "provider_object_binding_storage=", share(bindingStorage), "\n",
        "provider_object_binding_signed=1\n",
        "provider_object_binding_matches_read_bytes=1\n",
        "provider_object_binding_status=proved\n"
    ], "")

@borrows
fn NativeLinkExecAndroidClangCandidate(ndkHome: str,
                                       hostName: str,
                                       apiLevel: str): str =
    return strutil.Join([share(ndkHome),
                         "/toolchains/llvm/prebuilt/",
                         share(hostName),
                         "/bin/aarch64-linux-android",
                         share(apiLevel),
                         "-clang"], "")

fn NativeLinkExecAndroidClang(): str =
    let configured = strutil.Strip(os.GetEnv("ANDROID_AARCH64_CLANG"))
    if len(configured) > 0:
        return configured
    var effectiveNdkHome = strutil.Strip(os.GetEnv("ANDROID_NDK_HOME"))
    if len(effectiveNdkHome) <= 0:
        effectiveNdkHome = strutil.Strip(os.GetEnv("NDK_HOME"))
    if len(effectiveNdkHome) <= 0:
        var effectiveSdkHome = strutil.Strip(os.GetEnv("ANDROID_HOME"))
        if len(effectiveSdkHome) <= 0:
            effectiveSdkHome = strutil.Strip(os.GetEnv("ANDROID_SDK_ROOT"))
        if len(effectiveSdkHome) > 0:
            let api35 = NativeLinkExecAndroidClangCandidate(strutil.Join([effectiveSdkHome, "/ndk/29.0.13599879"], ""), "darwin-x86_64", "35")
            if chengpath.PathFileExists(api35):
                return api35
            let api21 = NativeLinkExecAndroidClangCandidate(strutil.Join([effectiveSdkHome, "/ndk/26.3.11579264"], ""), "darwin-x86_64", "21")
            if chengpath.PathFileExists(api21):
                return api21
            let api21Arm = NativeLinkExecAndroidClangCandidate(strutil.Join([effectiveSdkHome, "/ndk/26.3.11579264"], ""), "darwin-arm64", "21")
            if chengpath.PathFileExists(api21Arm):
                return api21Arm
    if len(effectiveNdkHome) > 0:
        let api21DarwinX64 = NativeLinkExecAndroidClangCandidate(effectiveNdkHome, "darwin-x86_64", "21")
        if chengpath.PathFileExists(api21DarwinX64):
            return api21DarwinX64
        let api21DarwinA64 = NativeLinkExecAndroidClangCandidate(effectiveNdkHome, "darwin-arm64", "21")
        if chengpath.PathFileExists(api21DarwinA64):
            return api21DarwinA64
        let api21LinuxX64 = NativeLinkExecAndroidClangCandidate(effectiveNdkHome, "linux-x86_64", "21")
        if chengpath.PathFileExists(api21LinuxX64):
            return api21LinuxX64
    return ""

fn NativeLinkExecOhosClang(): str =
    let configured = strutil.Strip(os.GetEnv("OHOS_AARCH64_CLANG"))
    if len(configured) > 0 && chengpath.PathFileExists(configured):
        return configured
    return ""

@borrows
fn NativeLinkExecProgram(plan: nplan.NativeLinkPlanStub): Result[str] =
    let linkerProgram = plan.linkerProgram
    let program = strutil.Strip(linkerProgram)
    let targetTriple = plan.targetTriple
    if targetTriple == "aarch64-linux-android":
        if program != "" &&
           program != "cc" &&
           program != "android_aarch64_clang":
            return Ok[str](program)
        let clang = NativeLinkExecAndroidClang()
        if len(clang) <= 0:
            return Err[str](" native link exec: missing Android AArch64 clang")
        return Ok[str](clang)
    if targetTriple == "aarch64-linux-ohos" ||
       targetTriple == "aarch64-unknown-linux-ohos":
        if program != "" &&
           program != "cc" &&
           program != "ohos_aarch64_clang":
            return Ok[str](program)
        let clang = NativeLinkExecOhosClang()
        if len(clang) <= 0:
            return Err[str](" native link exec: missing OHOS AArch64 clang")
        return Ok[str](clang)
    if len(program) <= 0:
        return Err[str](" native link exec: missing linker program")
    return Ok[str](program)

@borrows
fn NativeLinkExecArgv(plan: nplan.NativeLinkPlanStub): Result[str[]] =
    let outputModeRes = NativeLinkExecValidatePlan(plan)
    if !outputModeRes.ok:
        let errMsg = outputModeRes.err.msg
        return Err[str[]](errMsg)
    let outputPath = plan.outputPath
    let targetTriple = plan.targetTriple
    let outputMode = outputModeRes.value
    var argv: str[]
    if targetTriple == "x86_64-pc-windows-msvc":
        for i in 0..<plan.linkInputPaths.len:
            let inputPath = plan.linkInputPaths[i]
            add(argv, share(inputPath))
        add(argv, "-o")
        add(argv, share(outputPath))
        add(argv, "-lws2_32")
        add(argv, "-lpsapi")
        add(argv, "-lbcrypt")
        add(argv, "-lncrypt")
        add(argv, "-ladvapi32")
        return Ok[str[]](argv)
    if targetTriple == "aarch64-linux-android" ||
       targetTriple == "aarch64-linux-ohos" ||
       targetTriple == "aarch64-unknown-linux-ohos":
        if outputMode != "shared":
            return Err[str[]](strutil.Join([" native link exec: unsupported mobile output mode: ", share(outputMode)], ""))
        add(argv, "-shared")
        add(argv, "-fPIC")
        for i in 0..<plan.linkInputPaths.len:
            let inputPath = plan.linkInputPaths[i]
            add(argv, share(inputPath))
        add(argv, "-Wl,--no-undefined")
        add(argv, strutil.Join(["-Wl,-soname,", share(outputPath)], ""))
        add(argv, "-ldl")
        add(argv, "-lm")
        add(argv, "-o")
        add(argv, share(outputPath))
        return Ok[str[]](argv)
    if plan.objectFormat == "elf":
        if outputMode == "shared":
            add(argv, "-shared")
            add(argv, "-fPIC")
        for i in 0..<plan.linkInputPaths.len:
            let inputPath = plan.linkInputPaths[i]
            add(argv, share(inputPath))
        add(argv, "-o")
        add(argv, share(outputPath))
        return Ok[str[]](argv)
    if outputMode == "shared":
        add(argv, "-dynamiclib")
    add(argv, "-arch")
    add(argv, "arm64")
    for i in 0..<plan.linkInputPaths.len:
        let inputPath = plan.linkInputPaths[i]
        add(argv, share(inputPath))
    add(argv, "-o")
    add(argv, share(outputPath))
    return Ok[str[]](argv)

@borrows
fn NativeLinkExecCommandText(plan: nplan.NativeLinkPlanStub): Result[str] =
    let argvRes = NativeLinkExecArgv(plan)
    if !argvRes.ok:
        let errMsg = argvRes.err.msg
        return Err[str](errMsg)
    let programRes = NativeLinkExecProgram(plan)
    if !programRes.ok:
        let errMsg = programRes.err.msg
        return Err[str](errMsg)
    let program = programRes.value
    let argv = argvRes.value
    return Ok[str](hostos.OsHostProcessCommandText(program, argv, []))

@borrows
fn NativeLinkExecRunSelfLinker(rootDir: str,
                                label: str,
                                plan: nplan.NativeLinkPlanStub,
                                logPath: str): hostops.LoggedRun =
    let linkerFlavor = plan.linkerFlavor
    let linkerProgram = plan.linkerProgram
    let outputPath = plan.outputPath
    let targetTriple = plan.targetTriple
    let linkInputPaths = plan.linkInputPaths
    if linkerFlavor == "macho_arm64_provider_internal":
        let requestRes = NativeLinkExecMachoRequest(plan)
        if !requestRes.ok:
            let errMsg = requestRes.err.msg
            let outputText = strutil.Join([share(errMsg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let request = requestRes.value
        let linkRes = macho_provider_linker.MachoProviderLinkExeCertified(share(request))
        if !linkRes.ok:
            let errMsg = linkRes.err.msg
            let outputText = strutil.Join([share(errMsg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let receipt = linkRes.value
        let outputText = strutil.Join([
            share(outputPath), " OK\n",
            "native_linker_program=", share(linkerProgram), "\n",
            "native_linker_flavor=", share(linkerFlavor), "\n",
            "system_link_exec_scope=selfhost_direct\n",
            "linkerless_image=1\n",
            "provider_link_mode=internal\n",
            NativeLinkExecProviderReceiptText(receipt),
            "unresolved_symbol_count=0\n",
            "first_unresolved_symbol=\n"
        ], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 0, outputText)
    elif linkerFlavor == "elf_x86_64_internal":
        let linkRes = elf_object_linker.ElfLinkExeX64(linkInputPaths, outputPath, targetTriple)
        if !linkRes.ok:
            let errMsg = linkRes.err.msg
            let outputText = strutil.Join([share(errMsg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let outputText = strutil.Join([share(outputPath), " OK\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 0, outputText)
    elif linkerFlavor == "elf_aarch64_nolibc_internal":
        let linkRes = elf_object_linker.ElfLinkExeA64(linkInputPaths, outputPath, targetTriple)
        if !linkRes.ok:
            let errMsg = linkRes.err.msg
            let outputText = strutil.Join([share(errMsg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let outputText = strutil.Join([share(outputPath), " OK\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 0, outputText)
    elif linkerFlavor == "coff_pe_builtin":
        let linkRes = lunits.CodegenLinkerUnitLinkExeBuiltin(
            contract.CodegenLinkerUnitA64Coff, linkInputPaths, outputPath, targetTriple)
        if !linkRes.ok:
            let errMsg = linkRes.err.msg
            let outputText = strutil.Join([share(errMsg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let outputText = strutil.Join([share(outputPath), " OK\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 0, outputText)
    elif linkerFlavor == "elf_riscv64_builtin":
        let linkRes = wunits.CodegenWriterUnitLinkExeBuiltin(
            contract.CodegenUnitRv64, linkInputPaths, outputPath, targetTriple)
        if !linkRes.ok:
            let errMsg = linkRes.err.msg
            let outputText = strutil.Join([share(errMsg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let outputText = strutil.Join([share(outputPath), " OK\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 0, outputText)
    else:
        let outputText = strutil.Join([" native link exec: unknown self-linker flavor: ", share(linkerFlavor), "\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 2, outputText)

@borrows
fn NativeLinkExecRunSystemLinker(rootDir: str,
                                  label: str,
                                  plan: nplan.NativeLinkPlanStub,
                                  logPath: str): hostops.LoggedRun =
    let linkerProgram = plan.linkerProgram
    let targetTriple = plan.targetTriple
    let argvRes = NativeLinkExecArgv(plan)
    if !argvRes.ok:
        let errMsg = argvRes.err.msg
        let outputText = strutil.Join([share(errMsg), "\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 2, outputText)
    let programRes = NativeLinkExecProgram(plan)
    if !programRes.ok:
        let errMsg = programRes.err.msg
        let outputText = strutil.Join([share(errMsg), "\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 2, outputText)
    let inputRes = NativeLinkExecValidateInputFiles(plan)
    if !inputRes.ok:
        let errMsg = inputRes.err.msg
        let outputText = strutil.Join([share(errMsg), "\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 2, outputText)
    let argv = argvRes.value
    let program = programRes.value
    if targetTriple == "x86_64-pc-windows-msvc":
        let explicitCc = strutil.Strip(os.GetEnv("CHENG_WINDOWS_CC"))
        if len(explicitCc) > 0:
            return hostops.RunFileLogged(rootDir,
                                         label,
                                         explicitCc,
                                         argv,
                                         [],
                                         rootDir,
                                         0,
                                         logPath)
    return hostops.RunProgramLogged(rootDir,
                                     label,
                                     program,
                                     argv,
                                     [],
                                     rootDir,
                                     0,
                                     logPath)

@borrows
fn NativeLinkExecRunLogged(rootDir: str,
                            label: str,
                            plan: nplan.NativeLinkPlanStub,
                            logPath: str): hostops.LoggedRun =
    let targetTriple = plan.targetTriple
    let linkerFlavor = plan.linkerFlavor
    if NativeLinkExecIsSelfLinker(targetTriple, linkerFlavor):
        return NativeLinkExecRunSelfLinker(rootDir, label, plan, logPath)
    return NativeLinkExecRunSystemLinker(rootDir, label, plan, logPath)
