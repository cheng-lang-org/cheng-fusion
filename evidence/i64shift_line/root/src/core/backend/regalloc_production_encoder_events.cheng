import cheng/core/backend/riscv64_encode as rv
import cheng/core/backend/codegen_contract as contract
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/result
import std/seqs as seqs

const
    RegallocProductionEncoderEventAuipc = 1
    RegallocProductionEncoderEventJalr = 2
    RegallocProductionEncoderEventAddi = 3
    RegallocProductionEncoderEventLui = 4
    RegallocProductionEncoderEventLw = 5
    RegallocProductionEncoderEventSw = 6
    RegallocProductionEncoderEventLd = 7
    RegallocProductionEncoderEventSd = 8
    RegallocProductionEncoderEventAdd = 9
    RegallocProductionEncoderEventAddw = 10
    RegallocProductionEncoderEventSub = 11
    RegallocProductionEncoderEventSubw = 12
    RegallocProductionEncoderEventXor = 13
    RegallocProductionEncoderEventSltiu = 14
    RegallocProductionEncoderEventSltu = 15
    RegallocProductionEncoderEventSlt = 16
    RegallocProductionEncoderEventXori = 17
    RegallocProductionEncoderEventJal = 18
    RegallocProductionEncoderEventBeq = 19
    RegallocProductionEncoderEventBne = 20
    RegallocProductionEncoderEventBlt = 21
    RegallocProductionEncoderEventBge = 22
    RegallocProductionEncoderEventBltu = 23
    RegallocProductionEncoderEventBgeu = 24

@borrows
fn RegallocProductionEncoderEventTableCanonicalEmpty(
        table: var contract.RegallocProductionEncoderEventTable): bool =
    return table.encoderSourceRow == -1 && table.encoderXlen == 0 &&
           layout.FixedBytes32Equal(
               table.encoderSourceCid, layout.FixedBytes32()) &&
           table.kinds.len == 0 && table.kinds.cap == 0 &&
           table.operandCounts.len == 0 &&
           table.operandCounts.cap == 0 &&
           table.operand0s.len == 0 && table.operand0s.cap == 0 &&
           table.operand1s.len == 0 && table.operand1s.cap == 0 &&
           table.operand2s.len == 0 && table.operand2s.cap == 0 &&
           table.operand3s.len == 0 && table.operand3s.cap == 0 &&
           table.encodedWords.len == 0 && table.encodedWords.cap == 0 &&
           layout.FixedBytes32Equal(
               table.orderedRoot, layout.FixedBytes32()) &&
           table.reservedRowCount == 0 && table.retainedBytes == int64(0)

@borrows
fn regallocProductionEncoderEventBuilderRetainedBytes(
        wordRows: var int32[],
        kinds: var int32[],
        operandCounts: var int32[],
        operand0s: var int64[],
        operand1s: var int64[],
        operand2s: var int64[],
        operand3s: var int64[],
        encodedWords: var int32[]): int64 =
    return (int64(wordRows.cap) + int64(kinds.cap) +
            int64(operandCounts.cap) + int64(encodedWords.cap)) * int64(4) +
           (int64(operand0s.cap) + int64(operand1s.cap) +
            int64(operand2s.cap) + int64(operand3s.cap)) * int64(8)

@borrows
fn regallocProductionEncoderEventTableRetainedBytes(
        kinds: var int32[],
        operandCounts: var int32[],
        operand0s: var int64[],
        operand1s: var int64[],
        operand2s: var int64[],
        operand3s: var int64[],
        encodedWords: var int32[]): int64 =
    return (int64(kinds.cap) + int64(operandCounts.cap) +
            int64(encodedWords.cap)) * int64(4) +
           (int64(operand0s.cap) + int64(operand1s.cap) +
            int64(operand2s.cap) + int64(operand3s.cap)) * int64(8)

@borrows
fn RegallocProductionEncoderEventBuilderCanonicalEmpty(
        builder: var contract.RegallocProductionEncoderEventBuilder): bool =
    return builder.encoderXlen == 0 &&
           builder.wordRows.len == 0 && builder.wordRows.cap == 0 &&
           builder.kinds.len == 0 && builder.kinds.cap == 0 &&
           builder.operandCounts.len == 0 &&
           builder.operandCounts.cap == 0 &&
           builder.operand0s.len == 0 && builder.operand0s.cap == 0 &&
           builder.operand1s.len == 0 && builder.operand1s.cap == 0 &&
           builder.operand2s.len == 0 && builder.operand2s.cap == 0 &&
           builder.operand3s.len == 0 && builder.operand3s.cap == 0 &&
           builder.encodedWords.len == 0 &&
           builder.encodedWords.cap == 0 &&
           builder.reservedRowCount == 0 &&
           builder.retainedBytes == int64(0) &&
           builder.arenaGeneration == 0

@borrows
fn regallocProductionEncoderEventBuilderShapeValid(
        builder: var contract.RegallocProductionEncoderEventBuilder): bool =
    let count = builder.wordRows.len
    if count == 0 && builder.reservedRowCount == 0:
        return RegallocProductionEncoderEventBuilderCanonicalEmpty(builder)
    return rv.RvIsaXlenOk(builder.encoderXlen) &&
           builder.kinds.len == count &&
           builder.operandCounts.len == count &&
           builder.operand0s.len == count &&
           builder.operand1s.len == count &&
           builder.operand2s.len == count &&
           builder.operand3s.len == count &&
           builder.encodedWords.len == count &&
           builder.reservedRowCount >= count &&
           builder.wordRows.cap >= builder.reservedRowCount &&
           builder.kinds.cap >= builder.reservedRowCount &&
           builder.operandCounts.cap >= builder.reservedRowCount &&
           builder.operand0s.cap >= builder.reservedRowCount &&
           builder.operand1s.cap >= builder.reservedRowCount &&
           builder.operand2s.cap >= builder.reservedRowCount &&
           builder.operand3s.cap >= builder.reservedRowCount &&
           builder.encodedWords.cap >= builder.reservedRowCount &&
           builder.retainedBytes ==
               regallocProductionEncoderEventBuilderRetainedBytes(
                   builder.wordRows, builder.kinds,
                   builder.operandCounts, builder.operand0s,
                   builder.operand1s, builder.operand2s,
                   builder.operand3s, builder.encodedWords) &&
           builder.arenaGeneration > 0

@borrows
fn regallocProductionEncoderEventShapeValid(
        table: var contract.RegallocProductionEncoderEventTable): bool =
    let count = table.kinds.len
    let retainedBytes =
        regallocProductionEncoderEventTableRetainedBytes(
            table.kinds, table.operandCounts,
            table.operand0s, table.operand1s, table.operand2s,
            table.operand3s, table.encodedWords)
    return table.encoderSourceRow >= 0 &&
           !layout.FixedBytes32Equal(
               table.encoderSourceCid, layout.FixedBytes32()) &&
           rv.RvIsaXlenOk(table.encoderXlen) &&
           table.kinds.len == count &&
           table.operandCounts.len == count &&
           table.operand0s.len == count &&
           table.operand1s.len == count &&
           table.operand2s.len == count &&
           table.operand3s.len == count &&
           table.encodedWords.len == count &&
           table.kinds.cap >= count &&
           table.operandCounts.cap >= count &&
           table.operand0s.cap >= count &&
           table.operand1s.cap >= count &&
           table.operand2s.cap >= count &&
           table.operand3s.cap >= count &&
           table.encodedWords.cap >= count &&
           table.reservedRowCount >= count &&
           table.kinds.cap >= table.reservedRowCount &&
           table.operandCounts.cap >= table.reservedRowCount &&
           table.operand0s.cap >= table.reservedRowCount &&
           table.operand1s.cap >= table.reservedRowCount &&
           table.operand2s.cap >= table.reservedRowCount &&
           table.operand3s.cap >= table.reservedRowCount &&
           table.encodedWords.cap >= table.reservedRowCount &&
           table.retainedBytes == retainedBytes

@borrows
fn RegallocProductionEncoderEventBuilderCount(
        builder: var contract.RegallocProductionEncoderEventBuilder): int32 =
    if !regallocProductionEncoderEventBuilderShapeValid(builder):
        return -1
    return builder.wordRows.len

fn RegallocProductionEncoderEventBuilderRelease(
        builder: var contract.RegallocProductionEncoderEventBuilder) =
    builder.wordRows = []
    builder.kinds = []
    builder.operandCounts = []
    builder.operand0s = []
    builder.operand1s = []
    builder.operand2s = []
    builder.operand3s = []
    builder.encodedWords = []
    builder = contract.RegallocProductionEncoderEventBuilder()

fn regallocProductionEncoderEventBuilderGrow(
        builder: var contract.RegallocProductionEncoderEventBuilder): bool =
    let count = builder.wordRows.len
    if count < 0 || count >= 33554429 ||
       (count > 0 &&
        !regallocProductionEncoderEventBuilderShapeValid(builder)):
        return false
    var capacity: int32 = 8
    if builder.reservedRowCount > 0:
        if builder.reservedRowCount > 16777214:
            capacity = 33554429
        else:
            capacity = builder.reservedRowCount * 2
    if capacity <= count:
        return false
    var grown: contract.RegallocProductionEncoderEventBuilder
    grown.encoderXlen = builder.encoderXlen
    setLen(grown.wordRows, capacity)
    setLen(grown.kinds, capacity)
    setLen(grown.operandCounts, capacity)
    setLen(grown.operand0s, capacity)
    setLen(grown.operand1s, capacity)
    setLen(grown.operand2s, capacity)
    setLen(grown.operand3s, capacity)
    setLen(grown.encodedWords, capacity)
    setLen(grown.wordRows, count)
    setLen(grown.kinds, count)
    setLen(grown.operandCounts, count)
    setLen(grown.operand0s, count)
    setLen(grown.operand1s, count)
    setLen(grown.operand2s, count)
    setLen(grown.operand3s, count)
    setLen(grown.encodedWords, count)
    for row in 0..<count:
        grown.wordRows[row] = builder.wordRows[row]
        grown.kinds[row] = builder.kinds[row]
        grown.operandCounts[row] = builder.operandCounts[row]
        grown.operand0s[row] = builder.operand0s[row]
        grown.operand1s[row] = builder.operand1s[row]
        grown.operand2s[row] = builder.operand2s[row]
        grown.operand3s[row] = builder.operand3s[row]
        grown.encodedWords[row] = builder.encodedWords[row]
    grown.reservedRowCount = capacity
    grown.retainedBytes =
        regallocProductionEncoderEventBuilderRetainedBytes(
            grown.wordRows, grown.kinds, grown.operandCounts,
            grown.operand0s, grown.operand1s, grown.operand2s,
            grown.operand3s, grown.encodedWords)
    grown.arenaGeneration = builder.arenaGeneration + 1
    builder = grown
    grown = contract.RegallocProductionEncoderEventBuilder()
    return true

fn RegallocProductionEncoderEventBuilderAppend(
        builder: var contract.RegallocProductionEncoderEventBuilder,
        eventKind: int32,
        xlen: int32,
        operandCount: int32,
        operand0: int64,
        operand1: int64,
        operand2: int64,
        operand3: int64,
        encoded: Result[uint32],
        encodedWord: var int32): bool =
    if !encoded.ok || !rv.RvIsaXlenOk(xlen) ||
       RegallocProductionEncoderEventBuilderCount(builder) < 0 ||
       eventKind < RegallocProductionEncoderEventAuipc ||
       eventKind > RegallocProductionEncoderEventBgeu ||
       operandCount < 2 || operandCount > 3 ||
       (operandCount < 3 && operand2 != int64(-1)) ||
       operand3 != int64(-1):
        return false
    let count = builder.wordRows.len
    if count > 0 && builder.encoderXlen != xlen:
        return false
    let wide = int64(encoded.value)
    if wide > int64(2147483647):
        encodedWord = int32(wide - int64(4294967296))
    else:
        encodedWord = int32(wide)
    if count == 0:
        builder.encoderXlen = xlen
    if count == builder.reservedRowCount &&
       !regallocProductionEncoderEventBuilderGrow(builder):
        RegallocProductionEncoderEventBuilderRelease(builder)
        return false
    add(builder.wordRows, -1)
    add(builder.kinds, eventKind)
    add(builder.operandCounts, operandCount)
    add(builder.operand0s, operand0)
    add(builder.operand1s, operand1)
    add(builder.operand2s, operand2)
    add(builder.operand3s, operand3)
    add(builder.encodedWords, encodedWord)
    builder.retainedBytes =
        regallocProductionEncoderEventBuilderRetainedBytes(
            builder.wordRows, builder.kinds, builder.operandCounts,
            builder.operand0s, builder.operand1s, builder.operand2s,
            builder.operand3s, builder.encodedWords)
    return regallocProductionEncoderEventBuilderShapeValid(builder)

fn RegallocProductionEncoderEventBuilderBindRange(
        builder: var contract.RegallocProductionEncoderEventBuilder,
        eventStart: int32,
        eventCount: int32,
        wordStart: int32): bool =
    let count = RegallocProductionEncoderEventBuilderCount(builder)
    if eventStart < 0 || eventCount < 0 || wordStart < 0 ||
       count < 0 || eventStart > count - eventCount ||
       wordStart > 2147483647 - eventCount:
        return false
    for offset in 0..<eventCount:
        let row = eventStart + offset
        if builder.wordRows[row] != -1:
            return false
        builder.wordRows[row] = wordStart + offset
    return true

fn RegallocProductionEncoderEventBuilderBindLast(
        builder: var contract.RegallocProductionEncoderEventBuilder,
        wordRow: int32): bool =
    let count = RegallocProductionEncoderEventBuilderCount(builder)
    if count <= 0 || wordRow < 0:
        return false
    if builder.wordRows[count - 1] != -1:
        return false
    builder.wordRows[count - 1] = wordRow
    return true

fn regallocProductionEncoderEventI32(value: int64, out: var int32): bool =
    if value < int64(-2147483648) || value > int64(2147483647):
        return false
    out = int32(value)
    return true

@borrows
fn regallocProductionEncoderEventReplayRow(
        table: var contract.RegallocProductionEncoderEventTable,
        row: int32,
        replayedWord: var int32): bool =
    if !regallocProductionEncoderEventShapeValid(table) ||
       row < 0 || row >= table.kinds.len:
        return false
    let kind = table.kinds[row]
    let operandCount = table.operandCounts[row]
    let expectsTwo = kind == RegallocProductionEncoderEventAuipc ||
                     kind == RegallocProductionEncoderEventLui ||
                     kind == RegallocProductionEncoderEventJal
    if operandCount < 2 || operandCount > 3 ||
       (expectsTwo && operandCount != 2) ||
       (!expectsTwo && operandCount != 3) ||
       (operandCount == 2 && table.operand2s[row] != int64(-1)) ||
       table.operand3s[row] != int64(-1):
        return false
    var operand0: int32
    var operand1: int32
    var operand2: int32
    if !regallocProductionEncoderEventI32(table.operand0s[row], operand0) ||
       !regallocProductionEncoderEventI32(table.operand1s[row], operand1) ||
       (table.operandCounts[row] == 3 &&
        !regallocProductionEncoderEventI32(
            table.operand2s[row], operand2)):
        return false
    var replayed: Result[uint32]
    let xlen = table.encoderXlen
    if kind == RegallocProductionEncoderEventAuipc:
        replayed = rv.RvEncAuipcForXlen(xlen, operand0, operand1)
    elif kind == RegallocProductionEncoderEventJalr:
        replayed = rv.RvEncJalrForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventAddi:
        replayed = rv.RvEncAddiForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventLui:
        replayed = rv.RvEncLuiForXlen(xlen, operand0, operand1)
    elif kind == RegallocProductionEncoderEventLw:
        replayed = rv.RvEncLwForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSw:
        replayed = rv.RvEncSwForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventLd:
        replayed = rv.RvEncLdForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSd:
        replayed = rv.RvEncSdForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventAdd:
        replayed = rv.RvEncAddForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventAddw:
        replayed = rv.RvEncAddwForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSub:
        replayed = rv.RvEncSubForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSubw:
        replayed = rv.RvEncSubwForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventXor:
        replayed = rv.RvEncXorForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSltiu:
        replayed = rv.RvEncSltiuForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSltu:
        replayed = rv.RvEncSltuForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventSlt:
        replayed = rv.RvEncSltForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventXori:
        replayed = rv.RvEncXoriForXlen(xlen, operand0, operand1, operand2)
    elif kind == RegallocProductionEncoderEventJal:
        replayed = rv.RvEncJalForXlen(
            xlen, operand0, table.operand1s[row])
    elif kind == RegallocProductionEncoderEventBeq:
        replayed = rv.RvEncBeqForXlen(
            xlen, operand0, operand1, table.operand2s[row])
    elif kind == RegallocProductionEncoderEventBne:
        replayed = rv.RvEncBneForXlen(
            xlen, operand0, operand1, table.operand2s[row])
    elif kind == RegallocProductionEncoderEventBlt:
        replayed = rv.RvEncBltForXlen(
            xlen, operand0, operand1, table.operand2s[row])
    elif kind == RegallocProductionEncoderEventBge:
        replayed = rv.RvEncBgeForXlen(
            xlen, operand0, operand1, table.operand2s[row])
    elif kind == RegallocProductionEncoderEventBltu:
        replayed = rv.RvEncBltuForXlen(
            xlen, operand0, operand1, table.operand2s[row])
    elif kind == RegallocProductionEncoderEventBgeu:
        replayed = rv.RvEncBgeuForXlen(
            xlen, operand0, operand1, table.operand2s[row])
    else:
        return false
    if !replayed.ok:
        return false
    let wide = int64(replayed.value)
    if wide > int64(2147483647):
        replayedWord = int32(wide - int64(4294967296))
    else:
        replayedWord = int32(wide)
    return replayedWord == table.encodedWords[row]

fn regallocProductionEncoderEventAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

fn regallocProductionEncoderEventAppendI64(
        buf: var layout.ByteBuf,
        value: int64) =
    let raw = uint64(value)
    for shift in 0..<8:
        layout.ByteBufAppendByte(
            buf, int32((raw >> uint64(shift * 8)) & uint64(255)))

@borrows
fn RegallocProductionEncoderEventRoot(
        table: var contract.RegallocProductionEncoderEventTable): layout.FixedBytes32 =
    if !regallocProductionEncoderEventShapeValid(table) ||
       table.kinds.len <= 0 || table.kinds.len > 33554429:
        return layout.FixedBytes32()
    var preimage = layout.ByteBufInit(128 + table.kinds.len * 48)
    let domain = "cheng.regalloc.production.encoder.events.v2"
    regallocProductionEncoderEventAppendI32(preimage, len(domain))
    for index in 0..<len(domain):
        layout.ByteBufAppendByte(preimage, int32(domain[index]))
    regallocProductionEncoderEventAppendI32(
        preimage, table.encoderSourceRow)
    layout.ByteBufAppendFixed32(preimage, table.encoderSourceCid)
    regallocProductionEncoderEventAppendI32(preimage, table.encoderXlen)
    regallocProductionEncoderEventAppendI32(preimage, table.kinds.len)
    regallocProductionEncoderEventAppendI32(
        preimage, table.reservedRowCount)
    regallocProductionEncoderEventAppendI64(
        preimage, table.retainedBytes)
    for row in 0..<table.kinds.len:
        var replayedWord: int32
        if !regallocProductionEncoderEventReplayRow(
               table, row, replayedWord):
            layout.ByteBufFree(preimage)
            return layout.FixedBytes32()
        # Event row identity is the implicit int32 SoA index. It remains part
        # of the ordered root without retaining a redundant O(N) column.
        regallocProductionEncoderEventAppendI32(preimage, row)
        regallocProductionEncoderEventAppendI32(preimage, table.kinds[row])
        regallocProductionEncoderEventAppendI32(
            preimage, table.operandCounts[row])
        regallocProductionEncoderEventAppendI64(preimage, table.operand0s[row])
        regallocProductionEncoderEventAppendI64(preimage, table.operand1s[row])
        regallocProductionEncoderEventAppendI64(preimage, table.operand2s[row])
        regallocProductionEncoderEventAppendI64(preimage, table.operand3s[row])
        regallocProductionEncoderEventAppendI32(
            preimage, table.encodedWords[row])
    let digest = hash256.Sha256Fixed(layout.ByteBufView(preimage))
    layout.ByteBufFree(preimage)
    return digest

fn RegallocProductionEncoderEventBuildExact(
        builder: var contract.RegallocProductionEncoderEventBuilder,
        encoderSourceRow: int32,
        encoderSourceCid: layout.FixedBytes32,
        xlen: int32,
        functionWords: var int32[],
        table: var contract.RegallocProductionEncoderEventTable): bool =
    let count = RegallocProductionEncoderEventBuilderCount(builder)
    if !RegallocProductionEncoderEventTableCanonicalEmpty(table) ||
       count <= 0 || count != functionWords.len ||
       count > 33554429 || encoderSourceRow < 0 ||
       !rv.RvIsaXlenOk(xlen) || builder.encoderXlen != xlen ||
       layout.FixedBytes32Equal(
           encoderSourceCid, layout.FixedBytes32()):
        RegallocProductionEncoderEventBuilderRelease(builder)
        RegallocProductionEncoderEventRelease(table)
        return false
    # wordRows is a permutation of the final function word identity. Sort all
    # physical columns together in place. A duplicate target is detected when
    # it reaches an already fixed row, so no occupied side table is needed.
    for row in 0..<count:
        while builder.wordRows[row] != row:
            let target = builder.wordRows[row]
            if target < 0 || target >= count ||
               builder.wordRows[target] == target:
                RegallocProductionEncoderEventBuilderRelease(builder)
                RegallocProductionEncoderEventRelease(table)
                return false
            let swapRow = builder.wordRows[target]
            builder.wordRows[target] = builder.wordRows[row]
            builder.wordRows[row] = swapRow
            let swapKind = builder.kinds[target]
            builder.kinds[target] = builder.kinds[row]
            builder.kinds[row] = swapKind
            let swapOperandCount = builder.operandCounts[target]
            builder.operandCounts[target] = builder.operandCounts[row]
            builder.operandCounts[row] = swapOperandCount
            let swapOperand0 = builder.operand0s[target]
            builder.operand0s[target] = builder.operand0s[row]
            builder.operand0s[row] = swapOperand0
            let swapOperand1 = builder.operand1s[target]
            builder.operand1s[target] = builder.operand1s[row]
            builder.operand1s[row] = swapOperand1
            let swapOperand2 = builder.operand2s[target]
            builder.operand2s[target] = builder.operand2s[row]
            builder.operand2s[row] = swapOperand2
            let swapOperand3 = builder.operand3s[target]
            builder.operand3s[target] = builder.operand3s[row]
            builder.operand3s[row] = swapOperand3
            let swapWord = builder.encodedWords[target]
            builder.encodedWords[target] = builder.encodedWords[row]
            builder.encodedWords[row] = swapWord
    for row in 0..<count:
        if builder.wordRows[row] != row ||
           builder.encodedWords[row] != functionWords[row]:
            RegallocProductionEncoderEventBuilderRelease(builder)
            RegallocProductionEncoderEventRelease(table)
            return false
    table.encoderSourceRow = encoderSourceRow
    table.encoderSourceCid = layout.FixedBytes32Copy(encoderSourceCid)
    table.encoderXlen = xlen
    table.reservedRowCount = builder.reservedRowCount
    # wordRows is transient permutation scratch only. The final event-row
    # identity is the SoA index, so physically release this eighth builder
    # column before moving the seven retained columns.
    seqs.chengSeqFreeTyped(builder.wordRows)
    table.kinds = builder.kinds
    builder.kinds = []
    table.operandCounts = builder.operandCounts
    builder.operandCounts = []
    table.operand0s = builder.operand0s
    builder.operand0s = []
    table.operand1s = builder.operand1s
    builder.operand1s = []
    table.operand2s = builder.operand2s
    builder.operand2s = []
    table.operand3s = builder.operand3s
    builder.operand3s = []
    table.encodedWords = builder.encodedWords
    builder.encodedWords = []
    table.retainedBytes =
        regallocProductionEncoderEventTableRetainedBytes(
            table.kinds, table.operandCounts,
            table.operand0s, table.operand1s,
            table.operand2s, table.operand3s,
            table.encodedWords)
    builder = contract.RegallocProductionEncoderEventBuilder()
    let root = RegallocProductionEncoderEventRoot(table)
    if layout.FixedBytes32Equal(root, layout.FixedBytes32()):
        RegallocProductionEncoderEventRelease(table)
        return false
    table.orderedRoot = root
    return RegallocProductionEncoderEventBuilderCanonicalEmpty(builder) &&
           regallocProductionEncoderEventShapeValid(table)

@borrows
fn RegallocProductionEncoderEventStrictValidate(
        table: var contract.RegallocProductionEncoderEventTable): bool =
    return !layout.FixedBytes32Equal(
               table.orderedRoot, layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               table.orderedRoot,
