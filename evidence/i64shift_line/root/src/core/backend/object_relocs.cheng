type
    ObjectRelocKind = enum
        ObjectRelocAbs32
        ObjectRelocAbs64
        ObjectRelocBranch26
        ObjectRelocPage21
        ObjectRelocPageOff12
        ObjectRelocPcRel32
        ObjectRelocJump26
        ObjectRelocRiscvCall

    ObjectReloc =
        sectionIndex: int32
        offset: int64
        symbolIndex: int32
        kind: ObjectRelocKind
        addend: int64
        pcRelative: bool

    ObjectRelocTable =
        items: ObjectReloc[]

fn ObjectRelocsInit(): ObjectRelocTable =
    var out: ObjectRelocTable
    return out

@borrows
fn ObjectRelocsCount(table: ObjectRelocTable): int32 =
    return table.items.len

@borrows
fn ObjectRelocsAt(table: ObjectRelocTable,
                  index: int32): ObjectReloc =
    let current = table.items[index]
    return ObjectReloc(sectionIndex: current.sectionIndex,
                       offset: current.offset,
                       symbolIndex: current.symbolIndex,
                       kind: current.kind,
                       addend: current.addend,
                       pcRelative: current.pcRelative)

fn ObjectRelocKindCode(kind: ObjectRelocKind): int32 =
    if kind == ObjectRelocAbs32:
        return 0
    if kind == ObjectRelocAbs64:
        return 1
    if kind == ObjectRelocBranch26:
        return 2
    if kind == ObjectRelocPage21:
        return 3
    if kind == ObjectRelocPageOff12:
        return 4
    if kind == ObjectRelocPcRel32:
        return 5
    if kind == ObjectRelocJump26:
        return 6
    if kind == ObjectRelocRiscvCall:
        return 7
    return -1

fn ObjectRelocsAdd(table: var ObjectRelocTable,
                    sectionIndex: int32,
                    offset: int64,
                    symbolIndex: int32,
                    kind: ObjectRelocKind,
                    addend: int64,
                    pcRelative: bool): int32 =
    add(table.items, ObjectReloc(sectionIndex: sectionIndex,
                                 offset: offset,
                                 symbolIndex: symbolIndex,
                                 kind: kind,
                                 addend: addend,
                                 pcRelative: pcRelative))
    return table.items.len - 1

@borrows
fn ObjectRelocsCountForSection(table: ObjectRelocTable,
                              sectionIndex: int32): int32 =
    var out = 0
    for i in 0..<table.items.len:
        if table.items[i].sectionIndex == sectionIndex:
            out = out + 1
    return out
