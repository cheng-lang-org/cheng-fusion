        report,
        plan.regallocFunctionSretExclusionCounts.len,
        plan.regallocFunctionSretExclusionCounts.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.regallocFunctionAddressEscapeMemoryActionCounts.len,
        plan.regallocFunctionAddressEscapeMemoryActionCounts.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.regallocFunctionOutgoingStackArgActionCounts.len,
        plan.regallocFunctionOutgoingStackArgActionCounts.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordString(
        report, plan.streamedBuildAbortReason)
    primaryObjectPlanRetainedRecordString(
        report, plan.wordFillSchedule)
    primaryObjectPlanRetainedRecordString(
        report, plan.wordFillMergeOrder)
    primaryObjectPlanRetainedRecordString(
        report, plan.typedIrChengMemHeaderRcFieldType)
    primaryObjectPlanRetainedRecordError(report, plan.error)
    primaryObjectPlanRetainedRecordSequence(
        report, plan.errors.len, plan.errors.cap,
        sizeof(PrimaryObjectError))
    for errorIndex in 0..<plan.errors.len:
        primaryObjectPlanRetainedRecordError(
            report, plan.errors[errorIndex])
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.missingReasons)
    primaryObjectPlanRetainedRecordString(
        report, plan.pipelineStage)
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.exportRootSymbols)
    primaryObjectPlanRetainedRecordString(
        report, plan.symbolVisibility)
    if report.physicalBufferCount < 0 ||
       report.retainedBytes < int64(0):
        panic("primary object plan: retained storage overflow")
    return report

fn PrimaryObjectPlanRetainedBufferCount(
        plan: var PrimaryObjectPlan): int32 =
    return PrimaryObjectPlanRetainedStorage(
        plan).physicalBufferCount

fn PrimaryObjectPlanRetainedBytes(
        plan: var PrimaryObjectPlan): int64 =
    return PrimaryObjectPlanRetainedStorage(plan).retainedBytes

fn primaryObjectPlanReleaseAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn primaryObjectPlanReleaseAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    primaryObjectPlanReleaseAppendU32BE(buf, value.len)
    for textIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[textIndex])

fn primaryObjectPlanReleaseAppendU32Field(
        buf: var layout.ByteBuf,
        value: int64) =
    primaryObjectPlanReleaseAppendU32BE(buf, 4)
    primaryObjectPlanReleaseAppendU32BE(buf, value)

fn primaryObjectPlanReleaseAppendI64Field(
        buf: var layout.ByteBuf,
        value: int64) =
    primaryObjectPlanReleaseAppendU32BE(buf, 8)
    primaryObjectPlanReleaseAppendU32BE(buf, value >> 32)
    primaryObjectPlanReleaseAppendU32BE(buf, value)

@borrows
fn primaryObjectPlanReleaseAppendFixed32(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    primaryObjectPlanReleaseAppendU32BE(buf, 32)
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn primaryObjectPlanReleaseAppendTexts(
        buf: var layout.ByteBuf,
        values: str[]) =
    primaryObjectPlanReleaseAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        primaryObjectPlanReleaseAppendText(buf, values[valueIndex])

@borrows
fn primaryObjectPlanReleaseAppendInt32s(
        buf: var layout.ByteBuf,
        values: int32[]) =
    primaryObjectPlanReleaseAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        primaryObjectPlanReleaseAppendU32Field(
            buf, values[valueIndex])

@borrows
fn primaryObjectPlanReleaseAppendFixed32s(
        buf: var layout.ByteBuf,
        values: layout.FixedBytes32[]) =
    primaryObjectPlanReleaseAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        primaryObjectPlanReleaseAppendFixed32(
            buf, values[valueIndex])

@borrows
fn primaryObjectPlanReleaseAppendError(
        buf: var layout.ByteBuf,
        error: PrimaryObjectError) =
    primaryObjectPlanReleaseAppendText(buf, error.functionName)
    primaryObjectPlanReleaseAppendText(
        buf, error.functionSourcePath)
    primaryObjectPlanReleaseAppendText(buf, error.bodyKind)
    primaryObjectPlanReleaseAppendText(buf, error.typedIrKind)
    primaryObjectPlanReleaseAppendText(buf, error.callTarget)
    primaryObjectPlanReleaseAppendText(
        buf, error.callTargetSourcePath)
    primaryObjectPlanReleaseAppendText(buf, error.statementTrace)
    primaryObjectPlanReleaseAppendText(buf, error.paramTrace)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.lastCallTarget)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.lastCallTargetSourcePath)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.firstZeroTargetSlotName)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.firstZeroBaseSlotName)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.firstZeroValueSlotName)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.firstZeroSlotDiag)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.firstZeroCallTarget)
    primaryObjectPlanReleaseAppendText(
        buf, error.bodyIrDetail.firstZeroCallDiag)

fn primaryObjectPlanReleaseOwnerToken(
        plan: var PrimaryObjectPlan,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(4096)
    primaryObjectPlanReleaseAppendText(
        buf, "cheng.compiler.primary_object_plan.owner_release")
    primaryObjectPlanReleaseAppendU32Field(
        buf, PrimaryObjectPlanOwnedStorageColumnCount)
    primaryObjectPlanReleaseAppendU32Field(
        buf, releasedBufferCount)
    primaryObjectPlanReleaseAppendI64Field(buf, releasedBytes)
    primaryObjectPlanReleaseAppendText(buf, plan.targetTriple)
    primaryObjectPlanReleaseAppendText(
        buf, plan.actualPipelineStage)
    primaryObjectPlanReleaseAppendText(
        buf, plan.actualBackendKind)
    primaryObjectPlanReleaseAppendText(buf, plan.objectFormat)
    primaryObjectPlanReleaseAppendText(buf, plan.outputPath)
    primaryObjectPlanReleaseAppendText(buf, plan.entryPath)
    primaryObjectPlanReleaseAppendText(buf, plan.entrySymbol)
    primaryObjectPlanReleaseAppendText(
        buf, plan.entryFunctionSymbol)
    primaryObjectPlanReleaseAppendTexts(buf, plan.symbolNames)
    primaryObjectPlanReleaseAppendInt32s(
        buf, plan.symbolTypedFunctionIndexes)
    primaryObjectPlanReleaseAppendInt32s(
        buf, plan.symbolNameIds)
    primaryObjectPlanReleaseAppendInt32s(
        buf, plan.symbolRoles)
    primaryObjectPlanReleaseAppendFixed32s(
        buf, plan.symbolInterfaceCids)
    primaryObjectPlanReleaseAppendFixed32(
        buf, plan.symbolNameInternPoolDomainCid)
    primaryObjectPlanReleaseAppendFixed32(
        buf, plan.symbolLoweringIdentityReceiptCid)
    primaryObjectPlanReleaseAppendFixed32(
        buf, plan.symbolIdentityReceiptCid)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.functionBodyKinds)
    primaryObjectPlanReleaseAppendTexts(buf, plan.dataLabels)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.dataPayloadTexts)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.relocTargetSymbols)
    primaryObjectPlanReleaseAppendInt32s(
        buf, plan.relocTargetDomainKinds)
    primaryObjectPlanReleaseAppendInt32s(
        buf, plan.relocTargetRows)
    primaryObjectPlanReleaseAppendFixed32s(
        buf, plan.relocTargetInterfaceCids)
    primaryObjectPlanReleaseAppendFixed32(
        buf, plan.relocCallTargetIdentityReceiptCid)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.dataRelocTargetSymbols)
    primaryObjectPlanReleaseAppendText(
        buf, plan.bodyIREGraphReason)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFrozenSnapshotSinglePayloads)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocEmissionLedgerSinglePayloads)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionSymbols)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionBodyIrSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionSymbolBytesSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionPlanSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionActionSemanticRootSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionActionLedgerRootSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionMachineFragmentRootSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionAbiIngressRootSha256s)
    primaryObjectPlanReleaseAppendU32Field(
        buf, plan.regallocDeferActionCids.len)
    for deferRow in 0..<plan.regallocDeferActionCids.len:
        primaryObjectPlanReleaseAppendU32Field(
            buf, plan.regallocDeferFunctionRows[deferRow])
        primaryObjectPlanReleaseAppendU32Field(
            buf, plan.regallocDeferStatementRows[deferRow])
        primaryObjectPlanReleaseAppendFixed32(
            buf, plan.regallocDeferActionCids[deferRow])
        primaryObjectPlanReleaseAppendFixed32(
            buf, plan.regallocDeferFragmentCids[deferRow])
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocFunctionDebugProvenanceSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf,
        plan.regallocFunctionDebugMachineFragmentRootSha256s)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.regallocDebugFragmentBytesSha256s)
    primaryObjectPlanReleaseAppendFixed32(
        buf, plan.semanticDebugBindingReceipt.receiptCid)
    primaryObjectPlanReleaseAppendText(
        buf, plan.debugSectionPlanReceipt.backendKind)
    primaryObjectPlanReleaseAppendText(
        buf, plan.debugSectionPlanReceipt.packageId)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.debugSectionPlanReceipt.sourceModulePaths)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.debugSectionPlanReceipt.functionNames)
    for functionIndex in 0..<
            plan.debugSectionPlanReceipt.functions.len:
        primaryObjectPlanReleaseAppendText(
            buf,
            plan.debugSectionPlanReceipt.functions[
                functionIndex].functionSymbolName)
        primaryObjectPlanReleaseAppendText(
            buf,
            plan.debugSectionPlanReceipt.functions[
                functionIndex].plannedSymbolBytesSha256)
        primaryObjectPlanReleaseAppendText(
            buf,
            plan.debugSectionPlanReceipt.functions[
                functionIndex].machineFragmentRootSha256)
        primaryObjectPlanReleaseAppendText(
            buf,
            plan.debugSectionPlanReceipt.functions[
                functionIndex].abiIngressRootSha256)
    for rowIndex in 0..<plan.debugSectionPlanReceipt.rows.len:
        primaryObjectPlanReleaseAppendText(
            buf,
            plan.debugSectionPlanReceipt.rows[
                rowIndex].plannedBytesSha256)
    primaryObjectPlanReleaseAppendFixed32(
        buf, plan.debugSectionPlanReceipt.receiptCid)
    primaryObjectPlanReleaseAppendText(
        buf, plan.streamedBuildAbortReason)
    primaryObjectPlanReleaseAppendText(
        buf, plan.wordFillSchedule)
    primaryObjectPlanReleaseAppendText(
        buf, plan.wordFillMergeOrder)
    primaryObjectPlanReleaseAppendText(
        buf, plan.typedIrChengMemHeaderRcFieldType)
    primaryObjectPlanReleaseAppendError(buf, plan.error)
    primaryObjectPlanReleaseAppendU32Field(buf, plan.errors.len)
    for errorIndex in 0..<plan.errors.len:
        primaryObjectPlanReleaseAppendError(
            buf, plan.errors[errorIndex])
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.missingReasons)
    primaryObjectPlanReleaseAppendText(buf, plan.pipelineStage)
    primaryObjectPlanReleaseAppendTexts(
        buf, plan.exportRootSymbols)
    primaryObjectPlanReleaseAppendText(
        buf, plan.symbolVisibility)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn primaryObjectPlanReleaseError(
        error: var PrimaryObjectError) =
    error.functionName = ""
    error.functionSourcePath = ""
    error.bodyKind = ""
    error.typedIrKind = ""
    error.callTarget = ""
    error.callTargetSourcePath = ""
    error.statementTrace = ""
    error.paramTrace = ""
    error.bodyIrDetail.lastCallTarget = ""
    error.bodyIrDetail.lastCallTargetSourcePath = ""
    error.bodyIrDetail.firstZeroTargetSlotName = ""
    error.bodyIrDetail.firstZeroBaseSlotName = ""
    error.bodyIrDetail.firstZeroValueSlotName = ""
    error.bodyIrDetail.firstZeroSlotDiag = ""
    error.bodyIrDetail.firstZeroCallTarget = ""
    error.bodyIrDetail.firstZeroCallDiag = ""

fn primaryObjectPlanReleaseFunctionIndex(
        index: var regart.RegallocProductionFunctionIndex) =
    seqs.chengSeqFreeTyped(index.normalFunctionIrIndexes)
    seqs.chengSeqFreeTyped(
        index.normalFunctionIrIndexOccupied)
    hashmaps.HashMapStrIntClear(index.symbols.map)
    seqs.freeSeqStrRelease(index.symbols.map.keys)
    seqs.chengSeqFreeTyped(index.symbols.map.vals)
    seqs.chengSeqFreeTyped(index.symbols.map.hashes)
    seqs.chengSeqFreeTyped(index.symbols.map.states)
    index.symbols.map.mask = uint64(0)
    index.symbols.map.used = 0

fn primaryObjectPlanReleaseDebugSectionPlan(
        receipt: var debugsectionplan.DebugSectionPlanReceipt) =
    receipt.backendKind = ""
    receipt.packageId = ""
    seqs.chengSeqFreeTyped(receipt.sourceIds)
    seqs.freeSeqStrRelease(receipt.sourceModulePaths)
    seqs.chengSeqFreeTyped(receipt.sourceDocumentCids)
    seqs.freeSeqStrRelease(receipt.functionNames)
    for functionIndex in 0..<receipt.functions.len:
        receipt.functions[functionIndex].functionSymbolName = ""
        receipt.functions[
            functionIndex].plannedSymbolBytesSha256 = ""
        receipt.functions[functionIndex].bodyIrSha256 = ""
        receipt.functions[functionIndex].frozenPlanSha256 = ""
        receipt.functions[functionIndex].regallocPlanSha256 = ""
        receipt.functions[
            functionIndex].emissionLedgerSha256 = ""
        receipt.functions[
            functionIndex].actionSemanticRootSha256 = ""
        receipt.functions[
            functionIndex].actionBindingRootSha256 = ""
        receipt.functions[
            functionIndex].machineFragmentRootSha256 = ""
        receipt.functions[functionIndex].abiIngressRootSha256 = ""
        receipt.functions[
            functionIndex].debugProvenanceSha256 = ""
        receipt.functions[
            functionIndex].debugMachineFragmentRootSha256 = ""
    seqs.chengSeqFreeTyped(receipt.functions)
    for rowIndex in 0..<receipt.rows.len:
        receipt.rows[rowIndex].plannedBytesSha256 = ""
    seqs.chengSeqFreeTyped(receipt.rows)

fn primaryObjectPlanReleaseOwnedStorage(
        plan: var PrimaryObjectPlan) =
    plan.targetTriple = ""
    plan.actualPipelineStage = ""
    plan.actualBackendKind = ""
    plan.objectFormat = ""
    plan.outputPath = ""
    plan.entryPath = ""
    plan.entrySymbol = ""
    plan.entryFunctionSymbol = ""
    seqs.chengSeqFreeTyped(plan.itemIds)
    seqs.freeSeqStrRelease(plan.symbolNames)
    seqs.chengSeqFreeTyped(
        plan.symbolTypedFunctionIndexes)
    seqs.chengSeqFreeTyped(plan.symbolNameIds)
    seqs.chengSeqFreeTyped(plan.symbolRoles)
    seqs.chengSeqFreeTyped(plan.symbolInterfaceCids)
    plan.symbolNameInternPoolDomainCid = layout.FixedBytes32()
    plan.symbolLoweringIdentityReceiptCid = layout.FixedBytes32()
    plan.symbolIdentityReceiptCid = layout.FixedBytes32()
    seqs.chengSeqFreeTyped(plan.functionWordOffsets)
    seqs.chengSeqFreeTyped(plan.functionWordCounts)
    seqs.freeSeqStrRelease(plan.functionBodyKinds)
    seqs.chengSeqFreeTyped(plan.functionStatementReturnModes)
    seqs.chengSeqFreeTyped(
        plan.functionStatementReturnI32Values)
    seqs.chengSeqFreeTyped(plan.functionStatementCallCounts)
    seqs.chengSeqFreeTyped(plan.functionIrIndexes)
    let _ =
        bodylifecycle.BodyIrPayloadReleaseSequence(
            plan.functionBodyIRs)
    seqs.chengSeqFreeTyped(plan.instructionWords)
    seqs.freeSeqStrRelease(plan.dataLabels)
    seqs.freeSeqStrRelease(plan.dataPayloadTexts)
    seqs.chengSeqFreeTyped(plan.dataPayloadRawBytes)
    seqs.chengSeqFreeTyped(plan.dataPayloadRawByteCounts)
    seqs.chengSeqFreeTyped(plan.relocSourceItemIds)
    seqs.chengSeqFreeTyped(plan.relocWordOffsets)
    seqs.freeSeqStrRelease(plan.relocTargetSymbols)
    seqs.chengSeqFreeTyped(plan.relocTargetDomainKinds)
    seqs.chengSeqFreeTyped(plan.relocTargetRows)
    seqs.chengSeqFreeTyped(plan.relocTargetInterfaceCids)
    plan.relocCallTargetIdentityReceiptCid = layout.FixedBytes32()
    seqs.chengSeqFreeTyped(plan.dataRelocSourceItemIds)
    seqs.chengSeqFreeTyped(plan.dataRelocWordOffsets)
    seqs.freeSeqStrRelease(plan.dataRelocTargetSymbols)
    plan.bodyIREGraphReason = ""
    seqs.freeSeqStrRelease(
        plan.regallocFrozenSnapshotSinglePayloads)
    seqs.freeSeqStrRelease(
        plan.regallocEmissionLedgerSinglePayloads)
    seqs.freeSeqStrRelease(plan.regallocFunctionSymbols)
    seqs.chengSeqFreeTyped(plan.regallocFunctionIrIndexes)
    seqs.chengSeqFreeTyped(plan.regallocFunctionKinds)
    primaryObjectPlanReleaseFunctionIndex(
        plan.regallocFunctionIndex)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionBodyIrSha256s)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionSymbolByteStarts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionSymbolByteLengths)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionSymbolBytesSha256s)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionPlanSha256s)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionActionSemanticRootSha256s)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionActionLedgerRootSha256s)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionMachineFragmentRootSha256s)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionAbiIngressRootSha256s)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionDeferReceiptStarts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionDeferReceiptCounts)
    seqs.chengSeqFreeTyped(plan.regallocDeferFunctionRows)
    seqs.chengSeqFreeTyped(plan.regallocDeferStatementRows)
    seqs.chengSeqFreeTyped(plan.regallocDeferActionCids)
    seqs.chengSeqFreeTyped(plan.regallocDeferFragmentCids)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionDebugProvenanceBound)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionDebugFunctionIds)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionDebugProvenanceSha256s)
    seqs.freeSeqStrRelease(
        plan.regallocFunctionDebugMachineFragmentRootSha256s)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionDebugFragmentStarts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionDebugFragmentCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentFunctionIndexes)
    seqs.chengSeqFreeTyped(plan.regallocDebugFragmentOpIds)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentSyntheticKinds)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentSiteKinds)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentSiteIndexes)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentMachineOwnerKinds)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentMachineOwnerOrdinals)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentActionConsumerOrdinals)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentTextByteStarts)
    seqs.chengSeqFreeTyped(
        plan.regallocDebugFragmentByteLengths)
    seqs.freeSeqStrRelease(
        plan.regallocDebugFragmentBytesSha256s)
    primaryObjectPlanReleaseDebugSectionPlan(
        plan.debugSectionPlanReceipt)
    seqs.chengSeqFreeTyped(plan.regallocFunctionActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionExactCalleeMasks)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionRegisterAssignmentCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionSpillActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionReloadActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionCallClobberActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionEdgeParallelCopyActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionParallelCopyCycleBreakActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionCriticalEdgeActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionSretExclusionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionAddressEscapeMemoryActionCounts)
    seqs.chengSeqFreeTyped(
        plan.regallocFunctionOutgoingStackArgActionCounts)
    plan.streamedBuildAbortReason = ""
    plan.wordFillSchedule = ""
    plan.wordFillMergeOrder = ""
    plan.typedIrChengMemHeaderRcFieldType = ""
    primaryObjectPlanReleaseError(plan.error)
    for errorIndex in 0..<plan.errors.len:
        primaryObjectPlanReleaseError(plan.errors[errorIndex])
    seqs.chengSeqFreeTyped(plan.errors)
    seqs.freeSeqStrRelease(plan.missingReasons)
    plan.pipelineStage = ""
    seqs.freeSeqStrRelease(plan.exportRootSymbols)
    plan.symbolVisibility = ""

fn PrimaryObjectPlanStorageReleased(
        plan: var PrimaryObjectPlan): bool =
    let retained = PrimaryObjectPlanRetainedStorage(plan)
    return retained.physicalBufferCount == 0 &&
           retained.retainedBytes == int64(0)

fn PrimaryObjectPlanReleaseWithReceipt(
        plan: var PrimaryObjectPlan,
        receipt: var PrimaryObjectPlanReleaseReceipt) =
    if plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.terminalReleaseOwnerToken,
           layout.FixedBytes32()) ||
       plan.terminalReleasedOwnedStorageColumnCount != 0 ||
       plan.terminalReleasedBufferCount != 0 ||
       plan.terminalReleasedBytes != int64(0):
        panic("primary object plan: duplicate or corrupt terminal release")
    let retained = PrimaryObjectPlanRetainedStorage(plan)
    let ownerToken =
        primaryObjectPlanReleaseOwnerToken(
            plan,
            retained.physicalBufferCount,
            retained.retainedBytes)
    if layout.FixedBytes32Equal(
           ownerToken, layout.FixedBytes32()) ||
       retained.physicalBufferCount < 0 ||
       retained.retainedBytes < int64(0):
        panic("primary object plan: invalid terminal release preimage")
    primaryObjectPlanReleaseOwnedStorage(plan)
    plan.terminalReleaseOwnerToken = ownerToken
    plan.terminalReleasedOwnedStorageColumnCount =
        PrimaryObjectPlanOwnedStorageColumnCount
    plan.terminalReleasedBufferCount =
        retained.physicalBufferCount
    plan.terminalReleasedBytes = retained.retainedBytes
    plan.terminalStorageReleased =
        PrimaryObjectPlanStorageReleased(plan)
    receipt.ownerToken = ownerToken
    receipt.releasedOwnedStorageColumnCount =
        PrimaryObjectPlanOwnedStorageColumnCount
    receipt.releasedBufferCount = retained.physicalBufferCount
    receipt.releasedBytes = retained.retainedBytes
    receipt.storageReleased = plan.terminalStorageReleased
    if !receipt.storageReleased ||
       PrimaryObjectPlanRetainedBufferCount(plan) != 0 ||
       PrimaryObjectPlanRetainedBytes(plan) != int64(0):
        panic("primary object plan: terminal storage release incomplete")

fn PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
        plan: var PrimaryObjectPlan,
        receipt: var PrimaryObjectPlanReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !receipt.storageReleased ||
       receipt.releasedOwnedStorageColumnCount !=
           PrimaryObjectPlanOwnedStorageColumnCount ||
       receipt.releasedOwnedStorageColumnCount !=
           plan.terminalReleasedOwnedStorageColumnCount ||
       receipt.releasedBufferCount !=
           plan.terminalReleasedBufferCount ||
       receipt.releasedBytes !=
           plan.terminalReleasedBytes ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken,
           plan.terminalReleaseOwnerToken) ||
       !PrimaryObjectPlanStorageReleased(plan) ||
       PrimaryObjectPlanRetainedBufferCount(plan) != 0 ||
       PrimaryObjectPlanRetainedBytes(plan) != int64(0):
        err = "primary object plan: terminal release receipt mismatch"
        return false
    plan.terminalReleaseReceiptConsumed = true
    return true

fn PrimaryObjectPlanTerminalReleaseReceiptInto(
        plan: var PrimaryObjectPlan,
        receipt: var PrimaryObjectPlanReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.terminalStorageReleased ||
       !plan.terminalReleaseReceiptConsumed ||
       plan.terminalReleasedOwnedStorageColumnCount !=
           PrimaryObjectPlanOwnedStorageColumnCount ||
       plan.terminalReleasedBufferCount < 0 ||
       plan.terminalReleasedBytes < int64(0) ||
       layout.FixedBytes32Equal(
           plan.terminalReleaseOwnerToken,
           layout.FixedBytes32()) ||
       !PrimaryObjectPlanStorageReleased(plan):
        err = "primary object plan: terminal release evidence unavailable"
        return false
    receipt.ownerToken = plan.terminalReleaseOwnerToken
    receipt.releasedOwnedStorageColumnCount =
        plan.terminalReleasedOwnedStorageColumnCount
    receipt.releasedBufferCount =
        plan.terminalReleasedBufferCount
    receipt.releasedBytes = plan.terminalReleasedBytes
    receipt.storageReleased = plan.terminalStorageReleased
    return true

fn PrimaryObjectPlanReleasePostEmitBodyIR(plan: var PrimaryObjectPlan) =
    let _ =
        bodylifecycle.BodyIrPayloadReleaseSequence(
            plan.functionBodyIRs)

fn PrimaryObjectPlanReleasePostReportPayload(plan: var PrimaryObjectPlan) =
    var receipt: PrimaryObjectPlanReleaseReceipt
    PrimaryObjectPlanReleaseWithReceipt(plan, receipt)
    var err: str
    if !PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           plan, receipt, err):
        panic(err)

fn PrimaryObjectPlanBodyIrEGraphReport(plan: PrimaryObjectPlan): str =
    var out = ""
    PrimaryObjectPlanAppendLine(out, "primary_object_body_ir_egraph_function_count", strings.IntToStr(plan.bodyIREGraphFunctionCount))
