        phaseArenaPeakBytes: int64
        phaseArenaSpillCount: int32
        eGraphApplied: bool
        eGraphSkipped: bool
        eGraphHardFail: bool
        eGraphBlockCount: int32
        eGraphCandidateBlockCount: int32
        eGraphChangedBlockCount: int32
        eGraphSkippedBlockCount: int32
        eGraphUnsafeOpCount: int32
        eGraphClassCount: int32
        eGraphRoundCount: int32
        eGraphRuleHitCount: int32
        eGraphExtractedCount: int32
        eGraphOpDelta: int32
        eGraphMs: int32
        eGraphReason: str

    PrimaryObjectStreamEmitSnapshot =
        functionLayoutValid: bool
        functionWordOffset: int32
        functionWordCount: int32
        totalWordCount: int32
        instructionWordCount: int32
        relocCount: int32
        dataRelocCount: int32
        bodyIRDodSoAFunctionCount: int32
        bodyIRDodSoAOpCount: int32
        bodyIRDodSoATermCount: int32
        bodyIRDodSoAOpOperandCount: int32
        bodyIRDodSoATermOperandCount: int32
        backpatchFunctionBase: int32
        backpatchCallRelocCount: int32
        backpatchDataRelocCount: int32
        regallocEvidenceCount: int32
