            # 聚合实参解析成功即降为 ErrorInfo 聚合；否则落回 call_special_head。
            var probeErrInfoBlockOffset: int32
            var probeErrInfoBlockSize: int32
            if PrimaryBodyIrResultErrInfoSourceSlot(bodyIR, slotNames, lowering.typedIr, nodeIndex) >= 0 &&
