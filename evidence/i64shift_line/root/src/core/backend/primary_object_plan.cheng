                                               slotNames,
                                               lowering.typedIr,
                                               share(typedFn),
                                               irFunction,
                                               npSrc,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                               Value(probeSeqLenArgSurfRes),
                                               probeSeqLenRootSlot,
